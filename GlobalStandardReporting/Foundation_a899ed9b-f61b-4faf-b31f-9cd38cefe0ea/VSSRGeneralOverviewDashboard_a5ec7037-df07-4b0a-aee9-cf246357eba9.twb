      <column caption='Time Weighted Total SS Percantage ' datatype='real' name='[Average Total SS Percantage (copy)_222435651891642368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([mss_ss_count])/SUM([mss_total_count]))*0.21&#10;+&#10;(SUM([commercial_ss_count])/SUM([commercial_total_count]))*0.58&#10;+&#10;(SUM([operational_ss_count])/SUM([operational_total_count]))*0.21' />
      </column>
      <column caption='Usage Metric' datatype='real' name='[Calculation_222435651902496769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Average Total SS Percentage&apos; then [Calculation_84020329801437193]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weighted Average Total SS Percentage&apos; then [Calculation_84020329769791488]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Time Weighted Total SS Percantage &apos; THEN [Average Total SS Percantage (copy)_222435651891642368]&#10;END' />
      </column>
      <column caption='Last updated' datatype='string' name='[Calculation_73746495579852801]' role='dimension' type='nominal'>
