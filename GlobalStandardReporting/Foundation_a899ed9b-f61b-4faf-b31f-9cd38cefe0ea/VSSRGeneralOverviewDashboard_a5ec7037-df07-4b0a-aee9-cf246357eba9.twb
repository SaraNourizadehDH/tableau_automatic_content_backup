        <objects>
          <object caption='Custom SQL Query' id='_C177467386B744F4AF199A2826FA17C3'>
            <properties context=''>
              <relation connection='bigquery.07m5bmi1ttvfgh10rgkji1o6rbzq' name='Custom SQL Query' type='text'>with mss_weekly as (
SELECT  
week_start as date,
&quot;weekly&quot; as period,
&quot;mss&quot; as plugin,
&quot;?&quot; as main_product,
change_type as change_type,
global_entity_id,
country_name,
brand_name,
sum(total_count) as total_count,
sum(ss_count) as ss_count
FROM `fulfillment-dwh-production.cl_vendor.vp_vssr_product_daily_rl`
group by 1,2,3,4,5,6,7,8
),

mss_monthly as (
SELECT  
date_trunc(date,month) as date,
&quot;monthly&quot; as period,
&quot;mss&quot; as plugin,
&quot;?&quot; as main_product,
change_type as change_type,
global_entity_id,
country_name,
brand_name,
sum(total_count) as total_count,
sum(ss_count) as ss_count
FROM `fulfillment-dwh-production.cl_vendor.vp_vssr_product_daily_rl`
group by 1,2,3,4,5,6,7,8
),

ot_weekly as (
  
  select 
  created_at as date,
  &quot;weekly&quot; as period,
 &quot;operational&quot; as plugin,
   main_product,
  &quot;update&quot; as change_type,
  global_entity_id,
  country_name,
  brand_name,
  sum(total_request_count) as total_count,
  sum(vendor_request_count_high_band) as ss_count
  from `fulfillment-dwh-production.cl_vendor.vssr_opening_time_datasource`
  where date_granularity = &apos;weekly&apos;
  group by 1,2,3,4,5,6,7,8
),

ot_monthly as (
  select 
  created_at as date,
  &quot;monthly&quot; as period,
 &quot;operational&quot; as plugin,
   main_product,
  &quot;update&quot; as change_type,
  global_entity_id,
  country_name,
  brand_name,
  sum(total_request_count) as total_count,
  sum(vendor_request_count_high_band) as ss_count
  from `fulfillment-dwh-production.cl_vendor.vssr_opening_time_datasource`
  where date_granularity = &apos;monthly&apos;
  group by 1,2,3,4,5,6,7,8
),


operational_weekly as (
  select 
  created_at as date,
  &quot;weekly&quot; as period,
  &quot;operational&quot; as plugin,
  main_product,
  &quot;update&quot; as change_type,
  global_entity_id,
  country_name,
  brand_name,
  sum(total_request_count) as total_count,
  sum(vendor_request_count) as ss_count
  from `fulfillment-dwh-production.cl_vendor.vssr_operational_datasource`
  where date_granularity = &apos;weekly&apos;
  group by 1,2,3,4,5,6,7,8
),

operational_monthly as (
  select 
  created_at as date,
  &quot;monthly&quot; as period,
  &quot;operational&quot; as plugin,
  main_product,
  &quot;update&quot; as change_type,
  global_entity_id,
  country_name,
  brand_name,
  sum(total_request_count) as total_count,
  sum(vendor_request_count) as ss_count
  from `fulfillment-dwh-production.cl_vendor.vssr_operational_datasource`
  where date_granularity = &apos;monthly&apos;
  group by 1,2,3,4,5,6,7,8
),


commercial_weekly as (
  
  select 
  created_at as date,
  &quot;weekly&quot; as period,
  &quot;commercial&quot; as plugin,
  main_product,
  change_type,
  global_entity_id,
  country_name,
  brand_name,
  sum(total_request_count) as total_count,
  sum(vendor_request_count) as ss_count
  FROM `fulfillment-dwh-production.cl_vendor.vssr_commercial_datasource`
  where date_granularity = &apos;weekly&apos;
  group by 1,2,3,4,5,6,7,8
),

commercial_monthly as (
  
  select 
  created_at as date,
  &quot;monthly&quot; as period,
  &quot;commercial&quot; as plugin,
  main_product,
  change_type,
  global_entity_id,
  country_name,
  brand_name,
  sum(total_request_count) as total_count,
  sum(vendor_request_count) as ss_count
  FROM `fulfillment-dwh-production.cl_vendor.vssr_commercial_datasource`
  where date_granularity = &apos;monthly&apos;
  group by 1,2,3,4,5,6,7,8
),

vssr_overview as (
select * from mss_weekly
UNION ALL
select * from mss_monthly
UNION ALL
select * from ot_weekly
UNION ALL
select * from ot_monthly
UNION ALL
select * from operational_weekly
UNION ALL
select * from operational_monthly
UNION ALL
SELECT * FROM commercial_weekly
UNION ALL
SELECT * FROM commercial_monthly
order by date desc
)
select 
date,
period,
global_entity_id,
plugin,
main_product,
change_type,
country_name,
brand_name,
--sum(total_count) as total_count,
--sum(ss_count) as ss_count,
--COALESCE(sum(ss_count)/sum(total_count),0) as total_percentage,
COALESCE(sum(case when plugin = &apos;mss&apos; then ss_count end),0) as mss_ss_count,
COALESCE(sum(case when plugin = &apos;mss&apos; then total_count end),0) as mss_total_count,
COALESCE(sum(case when plugin = &apos;operational&apos; then ss_count end),0) as operational_ss_count,
COALESCE(sum(case when plugin = &apos;operational&apos; then total_count end),0) as operational_total_count,
COALESCE(sum(case when plugin = &apos;commercial&apos; then ss_count end),0) as commercial_ss_count,
COALESCE(sum(case when plugin = &apos;commercial&apos; then total_count end),0) as commercial_total_count,
--COALESCE(sum(case when plugin = &apos;mss&apos; then ss_count end) / sum(case when plugin = &apos;mss&apos; then total_count end),0) as mss_ss_percentage,
--COALESCE(sum(case when plugin = &apos;operational&apos; then ss_count end) / sum(case when plugin = &apos;operational&apos; then total_count end),0) as operational_ss_percentage,
--COALESCE(sum(case when plugin = &apos;commercial&apos; then ss_count end) / sum(case when plugin = &apos;commercial&apos; then total_count end),0) as commercial_ss_percentage,
/*(
COALESCE(sum(case when plugin = &apos;mss&apos; then ss_count end) / sum(case when plugin = &apos;mss&apos; then total_count end),0)
+ 
COALESCE(sum(case when plugin = &apos;operational&apos; then ss_count end) / sum(case when plugin = &apos;operational&apos; then total_count end),0)
+
COALESCE(sum(case when plugin = &apos;commercial&apos; then ss_count end) / sum(case when plugin = &apos;commercial&apos; then total_count end),0)
)
/3 
as overal_ss_percantage
*/
from vssr_overview
group by 1,2,3,4,5,6,7,8</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
