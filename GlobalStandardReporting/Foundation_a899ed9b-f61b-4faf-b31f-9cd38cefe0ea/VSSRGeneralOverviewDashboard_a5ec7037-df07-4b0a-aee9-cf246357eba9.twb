      <column caption='Text' datatype='string' name='[Calculation_73746495592263682]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Click Here to Reach VSSR Project Summary Documentation&apos;' />
      </column>
      <column caption='Weighted Average Total SS Percentage' datatype='real' name='[Calculation_84020329769791488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([mss_ss_count])+SUM([commercial_ss_count])+SUM([operational_ss_count]))&#10;/&#10;(SUM([mss_total_count])+SUM([commercial_total_count])+SUM([operational_total_count]))' />
      </column>
      <column caption='custom_mss_ss_percantage' datatype='real' name='[Calculation_84020329782358017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([mss_ss_count])/SUM([mss_total_count])' />
      </column>
      <column caption='custom_commercial_ss_percentage' datatype='real' name='[Calculation_84020329797390339]' role='measure' type='quantitative'>
