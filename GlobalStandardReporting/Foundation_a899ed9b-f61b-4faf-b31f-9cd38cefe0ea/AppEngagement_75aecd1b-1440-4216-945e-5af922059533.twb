            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhub-sales-revenue' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='rl_sales_revenue' server-oauth='' username='dilys.ong@foodpanda.com' workgroup-auth-mode='prompt' />
