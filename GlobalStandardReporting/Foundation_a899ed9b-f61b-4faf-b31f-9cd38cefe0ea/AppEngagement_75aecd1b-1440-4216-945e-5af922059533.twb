      <column caption='% Push Clickthrough (Android Only)' datatype='real' name='[% Disabled Devices (copy)_4563061250208174083]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [device_platform] = &apos;ANDROID&apos; THEN [tapped_notifications] END)/SUM(IF [device_platform] = &apos;ANDROID&apos; THEN [displayed_notifications] END)' />
