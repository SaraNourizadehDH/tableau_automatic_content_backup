        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0k0qc0i0ure5f41ckw1871ly0sqk' name='Custom SQL Query' type='text'><![CDATA[WITH 
entity AS (
    SELECT 
        management_entity
        ,segment
        ,global_entity_id
        ,brand
        ,country_name
    FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities`
)
,sessions AS (
    SELECT 
    fielddate
    ,user_id
    ,session_id
    ,info.global_entity_id
    ,COUNT(*) ct
    FROM dhh-ncr-live.dbt_sales_revenue_report.vp_sessions
    LEFT JOIN UNNEST(vendors_info) info
    WHERE fielddate >>= '2023-03-20'
    AND fielddate >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),QUARTER),INTERVAL 5 QUARTER)
    AND fielddate <<= CURRENT_DATE()
    AND user_id IS NOT NULL
    AND device_platform IN ('IOS','ANDROID')
    GROUP BY 1,2,3,4
)
,events AS (
  SELECT 
  fielddate
  ,user_id
  ,user_pseudo_id
  ,device_platform
  ,device_category
  ,event_name
  ,session_id
  ,COUNT(*) hits
  FROM dhh-ncr-live.dbt_sales_revenue_report.vp_events
  WHERE fielddate >>= '2023-03-20'
  AND fielddate >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),QUARTER),INTERVAL 5 QUARTER)
  AND fielddate <<= CURRENT_DATE()
  AND user_id IS NOT NULL
  AND device_platform IN ('IOS','ANDROID')
  AND event_name IN ('pushnotification_enabled','pushnotification_disabled','pushnotification_tap','pushnotification_display')
  GROUP BY 1,2,3,4,5,6,7
)
,raw AS (
    SELECT 
    events.fielddate
    ,sessions.global_entity_id
    ,events.user_id
    ,events.user_pseudo_id
    ,events.device_platform
    ,events.event_name
    ,events.session_id
    ,events.hits
    FROM events 
    JOIN sessions 
    ON events.session_id = sessions.session_id
    AND events.fielddate = sessions.fielddate
) 
,daily AS (
    SELECT 
    'day' time_granularity
    ,FORMAT_DATE('%Y-%m-%d',raw.fielddate) time_period
    ,raw.global_entity_id
    ,device_platform
    ,MAX(fielddate) max_date
    ,COUNT(CASE WHEN event_name IN ('pushnotification_enabled','pushnotification_disabled') THEN user_pseudo_id END) devices
    ,COUNT(CASE WHEN event_name IN ('pushnotification_enabled') THEN user_pseudo_id END) enabled_devices
    ,COUNT(CASE WHEN event_name iN ('pushnotification_disabled') THEN user_pseudo_id END) disabled_devices
    ,SUM(CASE WHEN event_name IN ('pushnotification_display') THEN hits END) displayed_notifications
    ,SUM(CASE WHEN event_name IN ('pushnotification_tap') THEN hits END) tapped_notifications
    ,COUNT(CASE WHEN event_name IN ('pushnotification_display') THEN user_pseudo_id END) displayed_devices
    ,COUNT(CASE WHEN event_name iN ('pushnotification_tap') THEN user_pseudo_id END) tapped_devices
    FROM raw 
    WHERE raw.fielddate >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),QUARTER),INTERVAL 5 QUARTER) 
    GROUP BY 1,2,3,4
)
,weekly AS (
    SELECT 
    'week' time_granularity
    ,FORMAT_DATE('%Y-W%W',DATE_TRUNC(raw.fielddate,WEEK(MONDAY))) time_period
    ,global_entity_id
    ,device_platform
    ,MAX(fielddate) max_date
    ,COUNT(CASE WHEN event_name IN ('pushnotification_enabled','pushnotification_disabled') THEN user_pseudo_id END) devices
    ,COUNT(CASE WHEN event_name IN ('pushnotification_enabled') THEN user_pseudo_id END) enabled_devices
    ,COUNT(CASE WHEN event_name iN ('pushnotification_disabled') THEN user_pseudo_id END) disabled_devices
    ,COUNT(CASE WHEN event_name IN ('pushnotification_display') THEN session_id END) displayed_notifications
    ,COUNT(CASE WHEN event_name IN ('pushnotification_tap') THEN session_id END) tapped_notifications
    ,COUNT(CASE WHEN event_name IN ('pushnotification_display') THEN user_pseudo_id END) displayed_devices
    ,COUNT(CASE WHEN event_name iN ('pushnotification_tap') THEN user_pseudo_id END) tapped_devices
    FROM raw 
    WHERE raw.fielddate >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),WEEK(MONDAY)),INTERVAL 5 WEEK) 
    GROUP BY 1,2,3,4
)
,monthly AS (
    SELECT 
    'month' time_granularity
    ,FORMAT_DATE('%Y-%m',DATE_TRUNC(raw.fielddate,MONTH)) time_period
    ,global_entity_id
    ,device_platform
    ,MAX(fielddate) max_date
    ,COUNT(CASE WHEN event_name IN ('pushnotification_enabled','pushnotification_disabled') THEN user_pseudo_id END) devices
    ,COUNT(CASE WHEN event_name IN ('pushnotification_enabled') THEN user_pseudo_id END) enabled_devices
    ,COUNT(CASE WHEN event_name iN ('pushnotification_disabled') THEN user_pseudo_id END) disabled_devices
    ,COUNT(CASE WHEN event_name IN ('pushnotification_display') THEN session_id END) displayed_notifications
    ,COUNT(CASE WHEN event_name IN ('pushnotification_tap') THEN session_id END) tapped_notifications
    ,COUNT(CASE WHEN event_name IN ('pushnotification_display') THEN user_pseudo_id END) displayed_devices
    ,COUNT(CASE WHEN event_name iN ('pushnotification_tap') THEN user_pseudo_id END) tapped_devices
    FROM raw 
    WHERE fielddate >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),MONTH),INTERVAL 5 MONTH) 
    GROUP BY 1,2,3,4
)
,quarterly AS (
    SELECT 
    'quarter' time_granularity
    ,FORMAT_DATE('%Y-Q%Q',DATE_TRUNC(fielddate,QUARTER)) time_period
    ,global_entity_id
    ,device_platform
    ,MAX(fielddate) max_date
    ,COUNT(CASE WHEN event_name IN ('pushnotification_enabled','pushnotification_disabled') THEN user_pseudo_id END) devices
    ,COUNT(CASE WHEN event_name IN ('pushnotification_enabled') THEN user_pseudo_id END) enabled_devices
    ,COUNT(CASE WHEN event_name iN ('pushnotification_disabled') THEN user_pseudo_id END) disabled_devices
    ,COUNT(CASE WHEN event_name IN ('pushnotification_display') THEN session_id END) displayed_notifications
    ,COUNT(CASE WHEN event_name IN ('pushnotification_tap') THEN session_id END) tapped_notifications
    ,COUNT(CASE WHEN event_name IN ('pushnotification_display') THEN user_pseudo_id END) displayed_devices
    ,COUNT(CASE WHEN event_name iN ('pushnotification_tap') THEN user_pseudo_id END) tapped_devices
    FROM raw 
    WHERE fielddate >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),QUARTER),INTERVAL 5 QUARTER) 
    GROUP BY 1,2,3,4
)


SELECT 
agg.time_granularity
,agg.time_period
,agg.max_date
,entity.management_entity
,entity.segment
,entity.global_entity_id
,entity.brand
,entity.country_name
,agg.device_platform
,agg.devices
,agg.enabled_devices
,agg.disabled_devices
,agg.displayed_notifications
,agg.tapped_notifications
,agg.displayed_devices
,agg.tapped_devices
FROM (
    SELECT * FROM daily
    UNION ALL 
    SELECT * FROM weekly 
    UNION ALL 
    SELECT * FROM monthly 
    UNION ALL
    SELECT * FROM quarterly
) agg 
JOIN entity 
ON agg.global_entity_id = entity.global_entity_id]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
