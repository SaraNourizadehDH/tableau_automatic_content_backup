    <datasource caption='vpm_mss_changes' inline='true' name='federated.093cle01ekez3s11f3cy90kjqgm4' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.129it0x1wvse0q1agmg461myjp18'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhub-sales-revenue' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='curated_data_shared_govops' server-oauth='' username='dilys.ong@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[Custom SQL Query].[global_entity_id]' />
              <expression op='[tableau_gsr_entitlements_global_entity_id].[global_entity_id]' />
            </expression>
          </clause>
          <relation connection='bigquery.129it0x1wvse0q1agmg461myjp18' name='Custom SQL Query' type='text'><![CDATA[WITH entity AS (
    SELECT 
    management_entity
    ,segment
    ,global_entity_id
    ,country_name
    ,brand
    FROM fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities
)
, msschanges AS (
    SELECT
    created_at
    ,FORMAT_DATE('%Y-%m-%d',created_at) day_period
    ,FORMAT_DATE('%Y-W%W',DATE_TRUNC(created_at,WEEK)) week_period
    ,FORMAT_DATE('%Y-%m',DATE_TRUNC(created_at,MONTH)) month_period
    ,FORMAT_DATE('%Y-Q%Q',DATE_TRUNC(created_at,QUARTER)) quarter_period
    ,DENSE_RANK() OVER (ORDER BY FORMAT_DATE('%Y-W%W',DATE_TRUNC(created_at,WEEK)) DESC) week_period_rank
    ,DENSE_RANK() OVER (ORDER BY FORMAT_DATE('%Y-%m',DATE_TRUNC(created_at,MONTH)) DESC) month_period_rank
    ,DENSE_RANK() OVER (ORDER BY FORMAT_DATE('%Y-Q%Q',DATE_TRUNC(created_at,QUARTER)) DESC) quarter_period_rank
    ,MAX(CASE WHEN COALESCE(JSON_VALUE(meta_data,'$.source'),'website') != 'website' THEN 1 ELSE 0 END) OVER (PARTITION BY global_entity_id, type_of_change, FORMAT_DATE('%Y-%m-%d',created_at)) app_applicable
    ,mss_id
    ,global_entity_id
    ,type_of_change
    ,mapped_type_of_change
    ,master_type_of_change
    ,vendor_id
    ,COALESCE(JSON_VALUE(meta_data,'$.source'),'website') source -- assumption is that if null then all will be from website due to historical data
    ,status
    FROM fulfillment-dwh-production.rl_sales_revenue.mss_changes
    WHERE global_entity_id IN ('FP_PH','TB_AE')
    AND created_at >>= '2022-01-01'
    AND status != 'invalid'
) 
,mss_weekly AS (
    SELECT 
    global_entity_id
    -- ,source_type
    ,'week' time_period
    ,week_period period
    ,day_period
    ,week_period_rank period_rank
    ,type_of_change
    ,app_applicable
    ,COUNT(DISTINCT mss_id) total_changes
    ,COUNT(DISTINCT CASE WHEN source = 'website' THEN mss_id END) website_changes
    ,COUNT(DISTINCT CASE WHEN source != 'website' THEN mss_id END) app_changes
    ,COUNT(DISTINCT CASE WHEN app_applicable = 1 THEN mss_id END) total_app_applicable_changes
    FROM msschanges
    WHERE week_period_rank<<=6
    GROUP BY 1,2,3,4,5,6,7
)
,mss_monthly AS (
    SELECT 
    global_entity_id
    -- ,source_type
    ,'month' time_period
    ,month_period period
    ,day_period
    ,month_period_rank period_rank
    ,type_of_change
    ,app_applicable
    ,COUNT(DISTINCT mss_id) total_changes
    ,COUNT(DISTINCT CASE WHEN source = 'website' THEN mss_id END) website_changes
    ,COUNT(DISTINCT CASE WHEN source != 'website' THEN mss_id END) app_changes
    ,COUNT(DISTINCT CASE WHEN app_applicable = 1 THEN mss_id END) total_app_applicable_changes
    FROM msschanges
    WHERE month_period_rank<<=6
    GROUP BY 1,2,3,4,5,6,7
)
,mss_quarterly AS (
    SELECT 
    global_entity_id
    -- ,source_type
    ,'quarter' time_period
    ,quarter_period period
    ,day_period
    ,quarter_period_rank period_rank
    ,type_of_change
    ,app_applicable
    ,COUNT(DISTINCT mss_id) total_changes
    ,COUNT(DISTINCT CASE WHEN source = 'website' THEN mss_id END) website_changes
    ,COUNT(DISTINCT CASE WHEN source != 'website' THEN mss_id END) app_changes
    ,COUNT(DISTINCT CASE WHEN app_applicable = 1 THEN mss_id END) total_app_applicable_changes
    FROM msschanges
    WHERE quarter_period_rank<<=6
    GROUP BY 1,2,3,4,5,6,7
)

SELECT 
entity.management_entity
,entity.segment
,entity.global_entity_id
,entity.brand
,entity.country_name
,time_period
,period
,period_rank
,day_period
,app_applicable
,MAX(day_period) OVER () max_day_period
,type_of_change
,total_changes
,website_changes
,app_changes
,total_app_applicable_changes
FROM (
    SELECT * FROM mss_weekly UNION ALL 
    SELECT * FROM mss_monthly UNION ALL 
    SELECT * FROM mss_quarterly 
) mss 
LEFT JOIN entity
ON entity.global_entity_id = mss.global_entity_id]]></relation>
