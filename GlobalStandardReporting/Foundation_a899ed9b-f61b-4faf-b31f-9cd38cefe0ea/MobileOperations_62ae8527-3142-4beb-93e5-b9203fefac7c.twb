      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_5543090379114BF5A15E0690ACB6D665'>
            <properties context=''>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Custom SQL Query].[global_entity_id]' />
                    <expression op='[tableau_gsr_entitlements_global_entity_id].[global_entity_id]' />
                  </expression>
                </clause>
                <relation connection='bigquery.0vw8e691brii4p1134p6d0m3u7sk' name='Custom SQL Query' type='text'><![CDATA[WITH entity AS (
    SELECT 
    management_entity
    ,segment
    ,global_entity_id
    ,country_name
    ,brand
    FROM fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities
), 
vp_raw AS (    
    SELECT 
    ga_export_name
    ,session_date
    ,session_id
    ,user_id
    ,device.device_category
    ,hit.event_info.event_category
    ,MAX(CASE WHEN cd.index=3 THEN REGEXP_REPLACE(cd.value,'\\[|\\]','') END) shop_id
    ,MAX(CASE WHEN cd.index=3 THEN SPLIT(REGEXP_REPLACE(cd.value,'\\[|\\]',''),';')[OFFSET(0)] END) global_entity_id
    ,MAX(CASE WHEN REGEXP_CONTAINS(hit.event_info.event_category,'(mss|menu-management|menu_self_service)') THEN 1 ELSE 0 END) mss_flag
    FROM fulfillment-dwh-production.cl_sales_revenue.vp_ga_sessions sessions
    LEFT JOIN UNNEST(hits) hit
    LEFT JOIN UNNEST(hit.custom_dimensions) cd
    -- WHERE session_date >>= DATE_ADD(DATE_TRUNC(CURRENT_DATE(),MONTH),INTERVAL -6 MONTH)
    WHERE session_date >>= '2022-01-01'
    AND hit.event_info.event_category NOT IN ('login','reset_password','push_notification','auth-refresh-authentication')
    -- AND hit.event_info.event_action IS NOT NULL 
    -- AND hit.event_info.event_category LIKE '%mss'
    GROUP BY 1,2,3,4,5,6
    HAVING global_entity_id IS NOT NULL
    AND REGEXP_CONTAINS(global_entity_id, '(FP_PH|TB_AE)') 
) 
, vp_user AS (
    SELECT 
    global_entity_id
    ,user_id
    ,session_date
    ,device_category
    ,COUNT(DISTINCT session_id) sessions
    ,COUNT(DISTINCT CASE WHEN ga_export_name = 'Android' THEN session_id END) android_app_sessions
    ,COUNT(DISTINCT CASE WHEN ga_export_name = 'Web' THEN session_id END) web_sessions
    ,COUNT(DISTINCT CASE WHEN mss_flag=1 THEN session_id END) mss_sessions
    ,COUNT(DISTINCT CASE WHEN ga_export_name = 'Android' AND mss_flag=1 THEN session_id END) mss_android_app_sessions
    ,COUNT(DISTINCT CASE WHEN ga_export_name = 'Web' AND mss_flag=1 THEN session_id END) mss_web_sessions
    FROM vp_raw 
    GROUP BY 1,2,3,4
)
, vp_base AS (
    SELECT 
    global_entity_id
    ,FORMAT_DATE('%Y-%m-%d',session_date) day_period
    ,FORMAT_DATE('%Y-W%W',DATE_TRUNC(session_date,WEEK)) week_period
    ,FORMAT_DATE('%Y-%m',DATE_TRUNC(session_date,MONTH)) month_period
    ,FORMAT_DATE('%Y-Q%Q',DATE_TRUNC(session_date,QUARTER)) quarter_period
    ,DENSE_RANK() OVER (ORDER BY FORMAT_DATE('%Y-W%W',DATE_TRUNC(session_date,WEEK)) DESC) week_period_rank
    ,DENSE_RANK() OVER (ORDER BY FORMAT_DATE('%Y-%m',DATE_TRUNC(session_date,MONTH)) DESC) month_period_rank
    ,DENSE_RANK() OVER (ORDER BY FORMAT_DATE('%Y-Q%Q',DATE_TRUNC(session_date,QUARTER)) DESC) quarter_period_rank
    ,user_id
    ,device_category
    ,sessions
    ,android_app_sessions
    ,web_sessions
    ,mss_sessions
    ,mss_android_app_sessions
    ,mss_web_sessions
    FROM vp_user
)
-- adding session date for daily avg, in case next time want to remove can just comment out
,vp_weekly AS (
    SELECT 
    global_entity_id
    ,'week' time_period
    ,week_period period
    ,week_period_rank period_rank
    ,device
    ,day_period
    --,MAX(day_period) day_period
    ,SUM(sessions) sessions
    ,SUM(android_app_sessions) android_app_sessions
    ,SUM(web_sessions) web_sessions
    ,SUM(mss_sessions) mss_sessions
    ,SUM(mss_android_app_sessions) mss_android_app_sessions
    ,SUM(mss_web_sessions) mss_web_sessions
    ,COUNT(DISTINCT CASE WHEN sessions>>0 THEN user_id END) users
    ,COUNT(DISTINCT CASE WHEN android_app_sessions>>0 THEN user_id END) android_app_users
    ,COUNT(DISTINCT CASE WHEN web_sessions>>0 THEN user_id END) web_users
    ,COUNT(DISTINCT CASE WHEN mss_sessions>>0 THEN user_id END) mss_users
    ,COUNT(DISTINCT CASE WHEN mss_android_app_sessions>>0 THEN user_id END) mss_android_app_users
    ,COUNT(DISTINCT CASE WHEN mss_web_sessions>>0 THEN user_id END) mss_web_users
    FROM vp_base 
    LEFT JOIN UNNEST(ARRAY['ALL',device_category]) device
    WHERE week_period_rank<<=6
    GROUP BY 1,2,3,4,5,6
)
,vp_monthly AS (
    SELECT 
    global_entity_id
    ,'month' time_period
    ,month_period period
    ,month_period_rank period_rank
    ,device
    ,day_period
    --,MAX(day_period) day_period
    ,SUM(sessions) sessions
    ,SUM(android_app_sessions) android_app_sessions
    ,SUM(web_sessions) web_sessions
    ,SUM(mss_sessions) mss_sessions
    ,SUM(mss_android_app_sessions) mss_android_app_sessions
    ,SUM(mss_web_sessions) mss_web_sessions
    ,COUNT(DISTINCT CASE WHEN sessions>>0 THEN user_id END) users
    ,COUNT(DISTINCT CASE WHEN android_app_sessions>>0 THEN user_id END) android_app_users
    ,COUNT(DISTINCT CASE WHEN web_sessions>>0 THEN user_id END) web_users
    ,COUNT(DISTINCT CASE WHEN mss_sessions>>0 THEN user_id END) mss_users
    ,COUNT(DISTINCT CASE WHEN mss_android_app_sessions>>0 THEN user_id END) mss_android_app_users
    ,COUNT(DISTINCT CASE WHEN mss_web_sessions>>0 THEN user_id END) mss_web_users
    FROM vp_base 
    LEFT JOIN UNNEST(ARRAY['ALL',device_category]) device
    WHERE month_period_rank<<=6
    GROUP BY 1,2,3,4,5,6
)
,vp_quarterly AS (
    SELECT 
    global_entity_id
    ,'quarter' time_period
    ,quarter_period period
    ,quarter_period_rank period_rank
    ,device
    ,day_period
    --,MAX(day_period) day_period
    ,SUM(sessions) sessions
    ,SUM(android_app_sessions) android_app_sessions
    ,SUM(web_sessions) web_sessions
    ,SUM(mss_sessions) mss_sessions
    ,SUM(mss_android_app_sessions) mss_android_app_sessions
    ,SUM(mss_web_sessions) mss_web_sessions
    ,COUNT(DISTINCT CASE WHEN sessions>>0 THEN user_id END) users
    ,COUNT(DISTINCT CASE WHEN android_app_sessions>>0 THEN user_id END) android_app_users
    ,COUNT(DISTINCT CASE WHEN web_sessions>>0 THEN user_id END) web_users
    ,COUNT(DISTINCT CASE WHEN mss_sessions>>0 THEN user_id END) mss_users
    ,COUNT(DISTINCT CASE WHEN mss_android_app_sessions>>0 THEN user_id END) mss_android_app_users
    ,COUNT(DISTINCT CASE WHEN mss_web_sessions>>0 THEN user_id END) mss_web_users
    FROM vp_base 
    LEFT JOIN UNNEST(ARRAY['ALL',device_category]) device
    WHERE quarter_period_rank<<=6
    GROUP BY 1,2,3,4,5,6
)

SELECT 
entity.management_entity
,entity.segment
,entity.global_entity_id
,entity.brand
,entity.country_name
,time_period
,period
,period_rank
,device
,day_period
,MAX(day_period) OVER () max_day_period
,sessions
,android_app_sessions
,web_sessions
,mss_sessions
,mss_android_app_sessions
,mss_web_sessions
,users
,android_app_users
,web_users
,mss_users
,mss_android_app_users
,mss_web_users
,(mss_android_app_users+mss_web_users)-mss_users multi_platform_mss_users
,(mss_users)-mss_android_app_users web_only_mss_users
,(mss_users)-mss_web_users android_app_only_mss_users
FROM (
    SELECT * FROM vp_weekly UNION ALL 
    SELECT * FROM vp_monthly UNION ALL 
    SELECT * FROM vp_quarterly 
) mss 
LEFT JOIN entity
ON entity.global_entity_id = mss.global_entity_id]]></relation>
                <relation connection='bigquery.0vw8e691brii4p1134p6d0m3u7sk' name='tableau_gsr_entitlements_global_entity_id' table='[fulfillment-dwh-production.curated_data_shared_govops].[tableau_gsr_entitlements_global_entity_id]' type='table' />
              </relation>
            </properties>
            <properties context='extract'>
              <relation join='inner' type='join'>
