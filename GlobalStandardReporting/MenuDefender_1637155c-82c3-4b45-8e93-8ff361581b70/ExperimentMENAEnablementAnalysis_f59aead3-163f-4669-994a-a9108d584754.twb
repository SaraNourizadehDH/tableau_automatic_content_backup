    <worksheet name='Vendors View Conversions %'>
      <table>
        <view>
          <datasources>
            <datasource caption='menu_defender_enablement_mena+ (Multiple Connections)' name='federated.169ucxr086r7n01fzn9460gleg6p' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.169ucxr086r7n01fzn9460gleg6p'>
            <column caption='Post Enablement' datatype='boolean' name='[Calculation_333196057085640704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [created_date_local] &gt;= DATE(&apos;2022-06-22&apos;) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Date' datatype='datetime' name='[Calculation_402368532249964545]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN DATETRUNC(&apos;day&apos;, [created_date_local])&#10;WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;, [created_date_local], &apos;Monday&apos;)&#10;END' />
            </column>
            <column caption='Vendors, Confirmation Clicked' datatype='integer' name='[Calculation_402368532250648578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [eos_menu_reminder_confirmation_clicked] = 1 THEN [vendor_code] END)' />
            </column>
            <column caption='Display Conversion % of Displays  + Not Shown' datatype='real' name='[Calculation_402368532254150665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Vendors, Dismissed (copy)_402368532251250692] / [Vendors, Not Shown (copy)_402368532253421576]' />
            </column>
            <column caption='Dismiss Conversion % of Displays' datatype='real' name='[Confirmation % (copy)_402368532266082315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Vendors, Confirmation Clicked (copy)_402368532250947587] / [Vendors, Dismissed (copy)_402368532251250692]' />
            </column>
            <column caption='Go To Menu Conversion % of Displays' datatype='real' name='[Dismissed % (copy)_402368532266164236]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Vendors, Not Shown (copy)_402368532251459590] / [Vendors, Dismissed (copy)_402368532251250692]' />
            </column>
            <column caption='Confirmation Conversion % of Displays' datatype='real' name='[Display % (copy)_402368532265943050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_402368532250648578] / [Vendors, Dismissed (copy)_402368532251250692]' />
            </column>
            <column caption='Vendors, Dismissed' datatype='integer' name='[Vendors, Confirmation Clicked (copy)_402368532250947587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [eos_menu_reminder_dismissed] = 1 THEN [vendor_code] END)' />
            </column>
            <column caption='Vendors, Displayed' datatype='integer' name='[Vendors, Dismissed (copy)_402368532251250692]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [eos_menu_reminder_displayed] = 1 THEN [vendor_code] END)' />
            </column>
            <column caption='Vendors, Go To Menu Screen' datatype='integer' name='[Vendors, Not Shown (copy)_402368532251459590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [eos_menu_reminder_go_to_menu_screen] = 1 THEN [vendor_code] END)' />
            </column>
            <column caption='Vendors, Displayed + Not Shown' datatype='integer' name='[Vendors, Not Shown (copy)_402368532253421576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [eos_menu_reminder_not_shown] = 1 OR [eos_menu_reminder_displayed] = 1 THEN [vendor_code] END)' />
            </column>
            <column caption='Created Date Local' datatype='date' name='[created_date_local]' role='dimension' type='ordinal' />
            <column caption='Entity Id' datatype='string' name='[entity_id]' role='dimension' type='nominal' />
