    <worksheet name='EOS Hours Item Unavailable Vendor Fail Rates (Pre Enablement)'>
      <table>
        <view>
          <datasources>
            <datasource caption='menu_defender_enablement_mena+ (Multiple Connections)' name='federated.169ucxr086r7n01fzn9460gleg6p' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.169ucxr086r7n01fzn9460gleg6p'>
            <column caption='Date' datatype='datetime' name='[Calculation_402368532249964545]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN DATETRUNC(&apos;day&apos;, [created_date_local])&#10;WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;, [created_date_local], &apos;Monday&apos;)&#10;END' />
            </column>
            <column caption='Pre Enablement' datatype='boolean' name='[Post Enablement (copy)_333196057086603265]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [created_date_local] &lt; DATE(&apos;2022-06-22&apos;) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Item Unavailable Vendor Fail Rate (Last Five Hours)' datatype='real' name='[Vendor Fail Rate (Last Five Hours) (copy)_402368532338913325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([five_hours_before_end_item_unavailable_vendor_failed_orders]) / SUM([five_hours_before_end_orders])' />
            </column>
            <column caption='Item Unavailable Vendor Fail Rate (Last Four Hours)' datatype='real' name='[Vendor Fail Rate (Last Four Hours) (copy)_402368532338913326]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([four_hours_before_end_item_unavailable_vendor_failed_orders]) / SUM([four_hours_before_end_orders])' />
            </column>
            <column caption='Item Unavailable Vendor Fail Rate (Last Half Hour)' datatype='real' name='[Vendor Fail Rate (Last Half Hour) (copy)_402368532338913327]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([half_hour_before_end_item_unavailable_vendor_failed_orders]) / SUM([half_hour_before_end_orders])' />
            </column>
            <column caption='Item Unavailable Vendor Fail Rate (Last One Hour)' datatype='real' name='[Vendor Fail Rate (Last One Hour) (copy)_402368532338913328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([one_hour_before_end_item_unavailable_vendor_failed_orders]) / SUM([one_hour_before_end_orders])' />
            </column>
            <column caption='Item Unavailable Vendor Fail Rate (Last Six Hours)' datatype='real' name='[Vendor Fail Rate (Last Six Hours) (copy)_402368532338913329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([six_hours_before_end_item_unavailable_vendor_failed_orders]) / SUM([six_hours_before_end_orders])' />
