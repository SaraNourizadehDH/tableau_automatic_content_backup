    <worksheet name='EOS Hours Vendor Fail Rates (Post Enablement)'>
      <table>
        <view>
          <datasources>
            <datasource caption='menu_defender_enablement_mena+ (Multiple Connections)' name='federated.169ucxr086r7n01fzn9460gleg6p' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Menu Defender Screen' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Displayed&quot;'>
              <calculation class='tableau' formula='&quot;Displayed&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.169ucxr086r7n01fzn9460gleg6p'>
            <column caption='Screen Type' datatype='integer' name='[Calculation_170996101677420544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Not Shown&quot; THEN [eos_menu_reminder_not_shown]&#10;WHEN &quot;Displayed&quot; THEN [eos_menu_reminder_displayed]&#10;WHEN &quot;Confirmed&quot; THEN [eos_menu_reminder_confirmation_clicked]&#10;WHEN &quot;Dismissed&quot; THEN [eos_menu_reminder_dismissed]&#10;WHEN &quot;Go To Menu&quot; THEN [eos_menu_reminder_go_to_menu_screen]&#10;END' />
            </column>
            <column caption='Screen Shown' datatype='boolean' name='[Calculation_170996101677506561]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_170996101677420544] = 1 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Post Enablement' datatype='boolean' name='[Calculation_333196057085640704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [created_date_local] &gt;= DATE(&apos;2022-06-22&apos;) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Date' datatype='datetime' name='[Calculation_402368532249964545]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN DATETRUNC(&apos;day&apos;, [created_date_local])&#10;WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;, [created_date_local], &apos;Monday&apos;)&#10;END' />
            </column>
            <column caption='Vendor Fail Rate (Last Five Hours)' datatype='real' name='[Fail Rate (Last Five Hours) (copy)_402368532329967658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([five_hours_before_end_vendor_failed_orders]) / SUM([five_hours_before_end_orders])' />
            </column>
            <column caption='Vendor Fail Rate (Last Four Hours)' datatype='real' name='[Fail Rate (Last Four Hours) (copy)_402368532329967655]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([four_hours_before_end_vendor_failed_orders]) / SUM([four_hours_before_end_orders])' />
            </column>
            <column caption='Vendor Fail Rate (Last Half Hour)' datatype='real' name='[Fail Rate (Last Half Hour) (copy)_402368532329967657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([half_hour_before_end_vendor_failed_orders]) / SUM([half_hour_before_end_orders])' />
            </column>
            <column caption='Vendor Fail Rate (Last One Hour)' datatype='real' name='[Fail Rate (Last One Hour) (copy)_402368532329967660]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([one_hour_before_end_vendor_failed_orders]) / SUM([one_hour_before_end_orders])' />
            </column>
            <column caption='Vendor Fail Rate (Last Six Hours)' datatype='real' name='[Fail Rate (Last Six Hours) (copy)_402368532329967654]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([six_hours_before_end_vendor_failed_orders]) / SUM([six_hours_before_end_orders])' />
            </column>
            <column caption='Vendor Fail Rate (Last Three Hours)' datatype='real' name='[Fail Rate (Last Three Hours) (copy)_402368532329967656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([three_hours_before_end_vendor_failed_orders]) / SUM([three_hours_before_end_orders])' />
            </column>
            <column caption='Vendor Fail Rate (Last Two Hours)' datatype='real' name='[Fail Rate (Last Two Hours) (copy)_402368532329967659]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([two_hours_before_end_vendor_failed_orders]) / SUM([two_hours_before_end_orders])' />
            </column>
            <column caption='Vendor Fail Rate (Until Last Six Hours)' datatype='real' name='[Fail Rate (Until Last Six Hours) (copy)_402368532329758757]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([till_six_hours_before_end_vendor_failed_orders]) / SUM([till_six_hours_before_end_orders])' />
            </column>
