    <worksheet name='Item Unavailable Vendor Fail Rates (Post Enablement)'>
      <table>
        <view>
          <datasources>
            <datasource caption='menu_defender_enablement_apac_experiments+ (Multiple Connections)' name='federated.1v68g3q1ht1ip319fgohj0lfswvu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Menu Defender Screen' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Schedule Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Full&quot;'>
              <calculation class='tableau' formula='&quot;Full&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1v68g3q1ht1ip319fgohj0lfswvu'>
            <column caption='Screen Type' datatype='integer' name='[Calculation_170996101677420544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;All&quot; THEN 1&#10;WHEN &quot;Displayed&quot; THEN [eos_menu_reminder_displayed]&#10;WHEN &quot;Confirmed&quot; THEN [eos_menu_reminder_confirmation_clicked]&#10;WHEN &quot;Dismissed&quot; THEN [eos_menu_reminder_dismissed]&#10;WHEN &quot;Go To Menu&quot; THEN [eos_menu_reminder_go_to_menu_screen]&#10;END' />
            </column>
            <column caption='Screen Shown' datatype='boolean' name='[Calculation_170996101677506561]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_170996101677420544] = 1 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Post Enablement' datatype='boolean' name='[Calculation_333196057085640704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [created_date_local] &gt;= DATE(&apos;2022-07-12&apos;) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Date' datatype='datetime' name='[Calculation_402368532249964545]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN DATETRUNC(&apos;day&apos;, [created_date_local])&#10;WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;, [created_date_local], &apos;Monday&apos;)&#10;END' />
            </column>
            <column caption='Experiment Group' datatype='string' name='[Calculation_756182582300512260]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [created_date_local] &gt;= DATE(&apos;2022-07-12&apos;) THEN [experiment_group] END' />
              <aliases>
                <alias key='%null%' value='Untested' />
              </aliases>
            </column>
            <column caption='Orders (P)' datatype='integer' name='[Calculation_756182582312615941]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;Full&quot; THEN SUM([orders])&#10;WHEN &quot;Last Hour&quot; THEN SUM([one_hour_before_end_orders])&#10;END' />
            </column>
            <column caption='Vendor Fail Rate' datatype='real' name='[Calculation_756182582313607178]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Failed Orders (P) (copy)_756182582312914951]/[Calculation_756182582312615941]' />
            </column>
            <column caption='Vendor Failed Orders (P)' datatype='integer' name='[Failed Orders (P) (copy)_756182582312914951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;Full&quot; THEN SUM([vendor_failed_orders])&#10;WHEN &quot;Last Hour&quot; THEN SUM([one_hour_before_end_vendor_failed_orders])&#10;END' />
            </column>
            <column caption='Item Unavailable Vendor Fail Rate' datatype='real' name='[Vendor Fail Rate (copy)_756182582313754635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Vendor Failed Orders (P) (copy)_756182582312992776]/[Calculation_756182582312615941]' />
            </column>
            <column caption='Item Unavailable Vendor Failed Orders (P)' datatype='integer' name='[Vendor Failed Orders (P) (copy)_756182582312992776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;Full&quot; THEN SUM([item_unavailable_vendor_failed_orders])&#10;WHEN &quot;Last Hour&quot; THEN SUM([one_hour_before_end_item_unavailable_vendor_failed_orders])&#10;END' />
            </column>
            <column caption='Created Date Local' datatype='date' name='[created_date_local]' role='dimension' type='ordinal' />
            <column caption='Entity Id' datatype='string' name='[entity_id]' role='dimension' type='nominal' />
            <column caption='Eos Menu Reminder Confirmation Clicked' datatype='integer' name='[eos_menu_reminder_confirmation_clicked]' role='measure' type='quantitative' />
            <column caption='Eos Menu Reminder Dismissed' datatype='integer' name='[eos_menu_reminder_dismissed]' role='measure' type='quantitative' />
            <column caption='Eos Menu Reminder Displayed' datatype='integer' name='[eos_menu_reminder_displayed]' role='measure' type='quantitative' />
            <column caption='Eos Menu Reminder Go To Menu Screen' datatype='integer' name='[eos_menu_reminder_go_to_menu_screen]' role='measure' type='quantitative' />
