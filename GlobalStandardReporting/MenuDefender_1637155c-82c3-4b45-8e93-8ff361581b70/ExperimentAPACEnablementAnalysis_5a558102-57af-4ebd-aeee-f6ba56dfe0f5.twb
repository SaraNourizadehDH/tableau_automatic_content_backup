            <column caption='Confirmed Products' datatype='string' name='[Calculation_402368532288036886]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [eos_menu_reminder_confirmation_clicked_products] = 0 THEN &quot;0 Products&quot;&#10;ELSEIF [eos_menu_reminder_confirmation_clicked_products] = 1 THEN &quot;1 Product&quot;&#10;ELSEIF [eos_menu_reminder_confirmation_clicked_products] = 2 THEN &quot;2 Products&quot;&#10;ELSEIF [eos_menu_reminder_confirmation_clicked_products] = 3 THEN &quot;3 Products&quot;&#10;ELSEIF [eos_menu_reminder_confirmation_clicked_products] = 4 THEN &quot;4 Products&quot;&#10;ELSEIF [eos_menu_reminder_confirmation_clicked_products] = 5 THEN &quot;5 Products&quot;&#10;ELSEIF [eos_menu_reminder_confirmation_clicked_products] &gt;= 6 AND [eos_menu_reminder_confirmation_clicked_products] &lt;= 10 THEN &quot;6-10 Products&quot;&#10;ELSEIF [eos_menu_reminder_confirmation_clicked_products] &gt;= 11 AND [eos_menu_reminder_confirmation_clicked_products] &lt;= 100 THEN &quot;11-100 Products&quot;&#10;ELSEIF [eos_menu_reminder_confirmation_clicked_products] &gt;= 101 THEN &quot;100+ Products&quot;&#10;END' />
            </column>
            <column caption='Dismiss Conversion % of Displays' datatype='real' name='[Confirmation % (copy)_402368532266082315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Vendors, Confirmation Clicked (copy)_402368532250947587] / [Vendors, Dismissed (copy)_402368532251250692]' />
