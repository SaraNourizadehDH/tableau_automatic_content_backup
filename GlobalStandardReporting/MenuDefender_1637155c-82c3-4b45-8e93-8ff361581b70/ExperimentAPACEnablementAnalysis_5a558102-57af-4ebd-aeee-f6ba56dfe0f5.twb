      <aliases enabled='yes' />
      <column caption='Screen Type' datatype='integer' name='[Calculation_170996101677420544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;All&quot; THEN 1&#10;WHEN &quot;Displayed&quot; THEN [eos_menu_reminder_displayed]&#10;WHEN &quot;Confirmed&quot; THEN [eos_menu_reminder_confirmation_clicked]&#10;WHEN &quot;Dismissed&quot; THEN [eos_menu_reminder_dismissed]&#10;WHEN &quot;Go To Menu&quot; THEN [eos_menu_reminder_go_to_menu_screen]&#10;END' />
      </column>
      <column caption='Screen Shown' datatype='boolean' name='[Calculation_170996101677506561]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_170996101677420544] = 1 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Post Enablement' datatype='boolean' name='[Calculation_333196057085640704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [created_date_local] &gt;= DATE(&apos;2022-07-12&apos;) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Date' datatype='datetime' name='[Calculation_402368532249964545]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN DATETRUNC(&apos;day&apos;, [created_date_local])&#10;WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;, [created_date_local], &apos;Monday&apos;)&#10;END' />
      </column>
      <column caption='Vendors, Confirmation Clicked' datatype='integer' name='[Calculation_402368532250648578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [eos_menu_reminder_confirmation_clicked] = 1 THEN [vendor_code] END)' />
      </column>
      <column caption='Display Conversion % of Displays  + Not Shown' datatype='real' name='[Calculation_402368532254150665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Vendors, Dismissed (copy)_402368532251250692] / [Vendors, Not Shown (copy)_402368532253421576]' />
      </column>
      <column caption='Confirmed Products' datatype='string' name='[Calculation_402368532288036886]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [eos_menu_reminder_confirmation_clicked_products] = 0 THEN &quot;0 Products&quot;&#10;ELSEIF [eos_menu_reminder_confirmation_clicked_products] = 1 THEN &quot;1 Product&quot;&#10;ELSEIF [eos_menu_reminder_confirmation_clicked_products] = 2 THEN &quot;2 Products&quot;&#10;ELSEIF [eos_menu_reminder_confirmation_clicked_products] = 3 THEN &quot;3 Products&quot;&#10;ELSEIF [eos_menu_reminder_confirmation_clicked_products] = 4 THEN &quot;4 Products&quot;&#10;ELSEIF [eos_menu_reminder_confirmation_clicked_products] = 5 THEN &quot;5 Products&quot;&#10;ELSEIF [eos_menu_reminder_confirmation_clicked_products] &gt;= 6 AND [eos_menu_reminder_confirmation_clicked_products] &lt;= 10 THEN &quot;6-10 Products&quot;&#10;ELSEIF [eos_menu_reminder_confirmation_clicked_products] &gt;= 11 AND [eos_menu_reminder_confirmation_clicked_products] &lt;= 100 THEN &quot;11-100 Products&quot;&#10;ELSEIF [eos_menu_reminder_confirmation_clicked_products] &gt;= 101 THEN &quot;100+ Products&quot;&#10;END' />
      </column>
      <column caption='Experiment Group' datatype='string' name='[Calculation_756182582300512260]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [created_date_local] &gt;= DATE(&apos;2022-07-12&apos;) THEN [experiment_group] END' />
        <aliases>
          <alias key='%null%' value='Untested' />
        </aliases>
      </column>
      <column caption='Orders (P)' datatype='integer' name='[Calculation_756182582312615941]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;Full&quot; THEN SUM([orders])&#10;WHEN &quot;Last Hour&quot; THEN SUM([one_hour_before_end_orders])&#10;END' />
      </column>
      <column caption='Successful Orders' datatype='integer' name='[Calculation_756182582313099273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_756182582312615941] - [Orders (P) (copy)_756182582312796166]' />
      </column>
      <column caption='Vendor Fail Rate' datatype='real' name='[Calculation_756182582313607178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Failed Orders (P) (copy)_756182582312914951]/[Calculation_756182582312615941]' />
      </column>
      <column caption='Dismiss Conversion % of Displays' datatype='real' name='[Confirmation % (copy)_402368532266082315]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Vendors, Confirmation Clicked (copy)_402368532250947587] / [Vendors, Dismissed (copy)_402368532251250692]' />
      </column>
      <column caption='Confirmed Products, Vendor Fail Rate' datatype='real' name='[Confirmed Product Fail Rate (copy)_402368532276568078]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([eos_menu_reminder_confirmation_clicked_vendor_failed_orders]) / SUM([eos_menu_reminder_confirmation_clicked_orders])' />
      </column>
      <column caption='Dismissed Products' datatype='string' name='[Confirmed Products (copy)_402368532290396184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [eos_menu_reminder_dismissed_products] = 0 THEN &quot;0 Products&quot;&#10;ELSEIF [eos_menu_reminder_dismissed_products] = 1 THEN &quot;1 Product&quot;&#10;ELSEIF [eos_menu_reminder_dismissed_products] = 2 THEN &quot;2 Products&quot;&#10;ELSEIF [eos_menu_reminder_dismissed_products] = 3 THEN &quot;3 Products&quot;&#10;ELSEIF [eos_menu_reminder_dismissed_products] = 4 THEN &quot;4 Products&quot;&#10;ELSEIF [eos_menu_reminder_dismissed_products] = 5 THEN &quot;5 Products&quot;&#10;ELSEIF [eos_menu_reminder_dismissed_products] &gt;= 6 AND [eos_menu_reminder_dismissed_products] &lt;= 10 THEN &quot;6-10 Products&quot;&#10;ELSEIF [eos_menu_reminder_dismissed_products] &gt;= 11 AND [eos_menu_reminder_dismissed_products] &lt;= 100 THEN &quot;11-100 Products&quot;&#10;ELSEIF [eos_menu_reminder_dismissed_products] &gt;= 101 THEN &quot;100+ Products&quot;&#10;END' />
      </column>
      <column caption='Dismissed Products, Item Unavailable Vendor Fail Rate' datatype='real' name='[Confirmed Products, Item Unavailable Vendor Fail Rate (copy)_402368532277727250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([eos_menu_reminder_dismissed_item_unavailable_vendor_failed_orders]) / SUM([eos_menu_reminder_dismissed_orders])' />
      </column>
      <column caption='Confirmed Products, Item Unavailable Vendor Fail Rate' datatype='real' name='[Confirmed Products, Vendor Fail Rate (copy)_402368532276682767]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([eos_menu_reminder_confirmation_clicked_item_unavailable_vendor_failed_orders]) / SUM([eos_menu_reminder_confirmation_clicked_orders])' />
      </column>
      <column caption='Dismissed Products, Vendor Fail Rate' datatype='real' name='[Confirmed Products, Vendor Fail Rate (copy)_402368532277727249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([eos_menu_reminder_dismissed_vendor_failed_orders]) / SUM([eos_menu_reminder_dismissed_orders])' />
      </column>
      <column caption='Go To Menu Conversion % of Displays' datatype='real' name='[Dismissed % (copy)_402368532266164236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Vendors, Not Shown (copy)_402368532251459590] / [Vendors, Dismissed (copy)_402368532251250692]' />
      </column>
      <column caption='Displayed Products' datatype='string' name='[Dismissed Products (copy)_402368532291997722]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [eos_menu_reminder_displayed_products] = 0 THEN &quot;0 Products&quot;&#10;ELSEIF [eos_menu_reminder_displayed_products] = 1 THEN &quot;1 Product&quot;&#10;ELSEIF [eos_menu_reminder_displayed_products] = 2 THEN &quot;2 Products&quot;&#10;ELSEIF [eos_menu_reminder_displayed_products] = 3 THEN &quot;3 Products&quot;&#10;ELSEIF [eos_menu_reminder_displayed_products] = 4 THEN &quot;4 Products&quot;&#10;ELSEIF [eos_menu_reminder_displayed_products] = 5 THEN &quot;5 Products&quot;&#10;ELSEIF [eos_menu_reminder_displayed_products] &gt;= 6 AND [eos_menu_reminder_displayed_products] &lt;= 10 THEN &quot;6-10 Products&quot;&#10;ELSEIF [eos_menu_reminder_displayed_products] &gt;= 11 AND [eos_menu_reminder_displayed_products] &lt;= 100 THEN &quot;11-100 Products&quot;&#10;ELSEIF [eos_menu_reminder_displayed_products] &gt;= 101 THEN &quot;100+ Products&quot;&#10;END' />
      </column>
      <column caption='Displayed Products, Item Unavailable Vendor Fail Rate' datatype='real' name='[Dismissed Products, Item Unavailable Vendor Fail Rate (copy)_402368532278927380]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([eos_menu_reminder_displayed_item_unavailable_vendor_failed_orders]) / SUM([eos_menu_reminder_displayed_orders])' />
      </column>
      <column caption='Displayed Products, Vendor Fail Rate' datatype='real' name='[Dismissed Products, Vendor Fail Rate (copy)_402368532278927381]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([eos_menu_reminder_displayed_vendor_failed_orders]) / SUM([eos_menu_reminder_displayed_orders])' />
      </column>
      <column caption='Confirmation Conversion % of Displays' datatype='real' name='[Display % (copy)_402368532265943050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_402368532250648578] / [Vendors, Dismissed (copy)_402368532251250692]' />
      </column>
      <column caption='Vendor Failed Orders (P)' datatype='integer' name='[Failed Orders (P) (copy)_756182582312914951]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;Full&quot; THEN SUM([vendor_failed_orders])&#10;WHEN &quot;Last Hour&quot; THEN SUM([one_hour_before_end_vendor_failed_orders])&#10;END' />
      </column>
      <column caption='Failed Orders (P)' datatype='integer' name='[Orders (P) (copy)_756182582312796166]' role='measure' type='quantitative'>
