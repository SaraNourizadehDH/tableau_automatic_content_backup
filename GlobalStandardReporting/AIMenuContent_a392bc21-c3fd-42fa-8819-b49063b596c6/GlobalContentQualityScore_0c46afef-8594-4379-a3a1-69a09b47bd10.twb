            <column alias='Brand Name' caption='Column by (food)' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;brand_name&quot;'>
              <calculation class='tableau' formula='&quot;brand_name&quot;' />
              <aliases>
                <alias key='&quot;brand_name&quot;' value='Brand Name' />
                <alias key='&quot;country_name&quot;' value='Country Name' />
                <alias key='&quot;gid&quot;' value='Global Entity Id' />
