      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1r0koqy0r90g0q1cmac1j0llpruu].[ctd:order_id:qk]&quot;' value='# Orders' />
        </aliases>
      </column>
      <column caption='Bar_Filler' datatype='integer' name='[Calculation_1469862346758934528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Retention_KPI' datatype='real' name='[Calculation_1469862346775105542]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;Customers&apos; THEN COUNTD([perseus_client_id])&#13;&#10;    WHEN &apos;% Retained&apos; THEN COUNTD([perseus_client_id]) / TOTAL(COUNTD([perseus_client_id]))&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column aggregation='Sum' caption='Variant Rank' datatype='integer' name='[Calculation_1469862346780229640]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [variant] &#13;&#10;WHEN &apos;Control&apos; THEN 0&#13;&#10;WHEN &apos;Original&apos; THEN 9999&#13;&#10;WHEN NULL THEN 1000000&#13;&#10;ELSE INT(RIGHT([variant], 1))&#13;&#10;END' />
      </column>
      <column caption='Days_for_Nth_Order_KPI' datatype='real' name='[Calculation_1469862346785574930]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Retention_KPI_Param (copy)_1469862346783834125]&#13;&#10;    WHEN &apos;Absolute&apos; THEN AVG([days_since_first_order])&#13;&#10;    WHEN &apos;% Delta (Var-Control)&apos; THEN (ZN(AVG([days_since_first_order])) - LOOKUP(ZN(AVG([days_since_first_order])))) / ABS(LOOKUP(ZN(AVG([days_since_first_order]))))&#13;&#10;    WHEN &apos;# Orders&apos; THEN COUNTD([order_id])&#13;&#10;END'>
          <table-calc level-address='[federated.1r0koqy0r90g0q1cmac1j0llpruu].[variant]' ordering-type='Field' tc-options='Fixed'>
            <order field='[federated.1r0koqy0r90g0q1cmac1j0llpruu].[variant]' />
            <order field='[federated.1r0koqy0r90g0q1cmac1j0llpruu].[Calculation_1469862346780229640]' />
            <address>
              <value>&quot;Control&quot;</value>
            </address>
          </table-calc>
        </calculation>
      </column>
      <column caption='Cust_0_Days_Since_First_Order' datatype='integer' name='[Calculation_1647191582128209947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Cw Year First Order, Entity Id, Region and 2 more (Combined)]: COUNTD(IF [days_since_first_order] &lt; [Parameters].[Parameter 2] THEN [perseus_client_id] END)}' />
      </column>
      <column caption='% Cust Retained' datatype='real' name='[Calculation_1647191582129041436]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([perseus_client_id])/SUM([Calculation_1647191582128209947])' />
      </column>
      <column caption='% Cust Retained P.P Delta' datatype='real' name='[Calculation_1647191582130614303]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_1647191582129041436]) - LOOKUP(ZN([Calculation_1647191582129041436]))'>
          <table-calc level-address='[federated.1r0koqy0r90g0q1cmac1j0llpruu].[variant]' ordering-type='Field' tc-options='Fixed'>
            <order field='[federated.1r0koqy0r90g0q1cmac1j0llpruu].[variant]' />
            <order field='[federated.1r0koqy0r90g0q1cmac1j0llpruu].[Calculation_1469862346780229640]' />
            <address>
              <value>&quot;Control&quot;</value>
            </address>
          </table-calc>
        </calculation>
      </column>
      <column caption='Order_Rank_Buckets' datatype='string' name='[Calculation_707909585037082625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_rank] = 1 THEN &apos;1st Order&apos;&#13;&#10;ELSEIF [order_rank] &gt; 1 THEN &apos;After 1st Order&apos;&#13;&#10;END' />
      </column>
      <column caption='Orders' datatype='real' name='[Calculation_799951902429941772]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Total&apos; THEN&#13;&#10;    CASE [Parameters].[Parameter 3]&#13;&#10;        WHEN &apos;Absolute&apos; THEN COUNTD([order_id])&#13;&#10;        WHEN &apos;% Delta (Var-Control)&apos; THEN (ZN(COUNTD([order_id])) - LOOKUP(ZN(COUNTD([order_id])))) / ABS(LOOKUP(ZN(COUNTD([order_id]))))&#13;&#10;    END&#13;&#10;ELSE &#13;&#10;    CASE [Parameters].[Parameter 3]&#13;&#10;        WHEN &apos;Absolute&apos; THEN COUNTD([order_id])&#13;&#10;        WHEN &apos;% Delta (Var-Control)&apos; THEN (ZN(COUNTD([order_id])) - LOOKUP(ZN(COUNTD([order_id])))) / ABS(LOOKUP(ZN(COUNTD([order_id]))))&#13;&#10;    END&#13;&#10;END'>
          <table-calc level-address='[federated.1r0koqy0r90g0q1cmac1j0llpruu].[variant]' ordering-type='Field' tc-options='Fixed'>
