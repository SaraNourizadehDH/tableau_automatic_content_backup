        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Total&apos; THEN&#13;&#10;    CASE [Parameters].[Parameter 3]&#13;&#10;        WHEN &apos;Absolute&apos; THEN SUM([revenue_local])&#13;&#10;        WHEN &apos;% Delta (Var-Control)&apos; THEN (ZN(SUM([revenue_local])) - LOOKUP(ZN(SUM([revenue_local])))) / ABS(LOOKUP(ZN(SUM([revenue_local]))))&#13;&#10;    END&#13;&#10;ELSE &#13;&#10;    CASE [Parameters].[Parameter 3]&#13;&#10;        WHEN &apos;Absolute&apos; THEN SUM([revenue_local]) / COUNTD([order_id])&#13;&#10;        WHEN &apos;% Delta (Var-Control)&apos; THEN (ZN(SUM([revenue_local]) / COUNTD([order_id])) - LOOKUP(ZN(SUM([revenue_local]) / COUNTD([order_id])))) / ABS(LOOKUP(ZN(SUM([revenue_local]) / COUNTD([order_id]))))&#13;&#10;    END&#13;&#10;END'>
          <table-calc level-address='[federated.1r0koqy0r90g0q1cmac1j0llpruu].[variant]' ordering-type='Field' tc-options='Fixed'>
