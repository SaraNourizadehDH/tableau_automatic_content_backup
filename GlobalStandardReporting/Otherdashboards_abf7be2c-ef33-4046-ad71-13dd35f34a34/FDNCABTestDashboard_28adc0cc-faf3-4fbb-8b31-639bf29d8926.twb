  <worksheets>
    <worksheet name='Business KPIs'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;&#10;</run>
            <run bold='true' fontcolor='#ff0000' fontsize='10' italic='true'>Note 1: </run>
            <run fontcolor='#ff0000' fontsize='10' italic='true'>An order is identified as a FDNC order if dps_customer_tag = &apos;New&apos; </run>
            <run bold='true' fontcolor='#ff0000' fontsize='10' italic='true'>**AND**</run>
            <run fontcolor='#ff0000' fontsize='10' italic='true'> order_rank during the test period = 1</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#ff0000' fontsize='10' italic='true'>Note 2:</run>
            <run fontcolor='#ff0000' fontsize='10' italic='true'> The difference between this dashboard and the </run>
            <run bold='true' fontcolor='#ff0000' fontsize='10' italic='true'>DPS AB test dashboard </run>
            <run fontcolor='#ff0000' fontsize='10' italic='true'>is that the </run>
            <run bold='true' fontcolor='#ff0000' fontsize='10' italic='true'>former </run>
            <run fontcolor='#ff0000' fontsize='10' italic='true'>does </run>
            <run bold='true' fontcolor='#ff0000' fontsize='10' italic='true'>not </run>
            <run fontcolor='#ff0000' fontsize='10' italic='true'>simply filter for orders where dps_customer_tag = &apos;New&apos;. It includes </run>
            <run bold='true' fontcolor='#ff0000' fontsize='10' italic='true'>all free delivery AND subsequent orders from customers who were recognized as new on their first order</run>
            <run fontcolor='#ff0000' fontsize='10' italic='true'>. We do this so that we can track their </run>
            <run bold='true' fontcolor='#ff0000' fontsize='10' italic='true'>retention </run>
            <run fontcolor='#ff0000' fontsize='10' italic='true'>and </run>
            <run bold='true' fontcolor='#ff0000' fontsize='10' italic='true'>return frequency. </run>
            <run fontcolor='#ff0000' fontsize='10' italic='true'>Also, this dashboard considers </run>
            <run bold='true' fontcolor='#ff0000' fontsize='10' italic='true'>successfully completed orders ONLY</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='new_cust_dataset' name='federated.1r0koqy0r90g0q1cmac1j0llpruu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Business_KPIs_Param' datatype='string' datatype-customized='true' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Absolute&quot;'>
              <calculation class='tableau' formula='&quot;Absolute&quot;' />
            </column>
            <column caption='Total/Per Order' datatype='string' datatype-customized='true' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total&quot;'>
              <calculation class='tableau' formula='&quot;Total&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1r0koqy0r90g0q1cmac1j0llpruu'>
            <column aggregation='Sum' caption='Variant Rank' datatype='integer' name='[Calculation_1469862346780229640]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [variant] &#13;&#10;WHEN &apos;Control&apos; THEN 0&#13;&#10;WHEN &apos;Original&apos; THEN 9999&#13;&#10;WHEN NULL THEN 1000000&#13;&#10;ELSE INT(RIGHT([variant], 1))&#13;&#10;END' />
            </column>
            <column caption='Order_Rank_Buckets' datatype='string' name='[Calculation_707909585037082625]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [order_rank] = 1 THEN &apos;1st Order&apos;&#13;&#10;ELSEIF [order_rank] &gt; 1 THEN &apos;After 1st Order&apos;&#13;&#10;END' />
            </column>
            <column caption='Orders' datatype='real' name='[Calculation_799951902429941772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Total&apos; THEN&#13;&#10;    CASE [Parameters].[Parameter 3]&#13;&#10;        WHEN &apos;Absolute&apos; THEN COUNTD([order_id])&#13;&#10;        WHEN &apos;% Delta (Var-Control)&apos; THEN (ZN(COUNTD([order_id])) - LOOKUP(ZN(COUNTD([order_id])))) / ABS(LOOKUP(ZN(COUNTD([order_id]))))&#13;&#10;    END&#13;&#10;ELSE &#13;&#10;    CASE [Parameters].[Parameter 3]&#13;&#10;        WHEN &apos;Absolute&apos; THEN COUNTD([order_id])&#13;&#10;        WHEN &apos;% Delta (Var-Control)&apos; THEN (ZN(COUNTD([order_id])) - LOOKUP(ZN(COUNTD([order_id])))) / ABS(LOOKUP(ZN(COUNTD([order_id]))))&#13;&#10;    END&#13;&#10;END'>
                <table-calc level-address='[federated.1r0koqy0r90g0q1cmac1j0llpruu].[variant]' ordering-type='Field' tc-options='Fixed'>
                  <order field='[federated.1r0koqy0r90g0q1cmac1j0llpruu].[variant]' />
                  <order field='[federated.1r0koqy0r90g0q1cmac1j0llpruu].[Calculation_1469862346780229640]' />
                  <address>
                    <value>&quot;Control&quot;</value>
                  </address>
                </table-calc>
              </calculation>
            </column>
            <column caption='Var | Scheme ID' datatype='string' name='[Calculation_799951902472114201]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[variant] + &apos; | &apos; + STR([scheme_id])' />
            </column>
            <column caption='Revenue' datatype='real' name='[Commission (copy)_799951902432735251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Total&apos; THEN&#13;&#10;    CASE [Parameters].[Parameter 3]&#13;&#10;        WHEN &apos;Absolute&apos; THEN SUM([revenue_local])&#13;&#10;        WHEN &apos;% Delta (Var-Control)&apos; THEN (ZN(SUM([revenue_local])) - LOOKUP(ZN(SUM([revenue_local])))) / ABS(LOOKUP(ZN(SUM([revenue_local]))))&#13;&#10;    END&#13;&#10;ELSE &#13;&#10;    CASE [Parameters].[Parameter 3]&#13;&#10;        WHEN &apos;Absolute&apos; THEN SUM([revenue_local]) / COUNTD([order_id])&#13;&#10;        WHEN &apos;% Delta (Var-Control)&apos; THEN (ZN(SUM([revenue_local]) / COUNTD([order_id])) - LOOKUP(ZN(SUM([revenue_local]) / COUNTD([order_id])))) / ABS(LOOKUP(ZN(SUM([revenue_local]) / COUNTD([order_id]))))&#13;&#10;    END&#13;&#10;END'>
                <table-calc level-address='[federated.1r0koqy0r90g0q1cmac1j0llpruu].[variant]' ordering-type='Field' tc-options='Fixed'>
                  <order field='[federated.1r0koqy0r90g0q1cmac1j0llpruu].[variant]' />
                  <order field='[federated.1r0koqy0r90g0q1cmac1j0llpruu].[Calculation_1469862346780229640]' />
                  <address>
                    <value>&quot;Control&quot;</value>
                  </address>
                </table-calc>
              </calculation>
            </column>
            <column caption='GFV' datatype='real' name='[DF (copy)_799951902431490063]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Total&apos; THEN&#13;&#10;    CASE [Parameters].[Parameter 3]&#13;&#10;        WHEN &apos;Absolute&apos; THEN SUM([gfv_local])&#13;&#10;        WHEN &apos;% Delta (Var-Control)&apos; THEN (ZN(SUM([gfv_local])) - LOOKUP(ZN(SUM([gfv_local])))) / ABS(LOOKUP(ZN(SUM([gfv_local]))))&#13;&#10;    END&#13;&#10;ELSE &#13;&#10;    CASE [Parameters].[Parameter 3]&#13;&#10;        WHEN &apos;Absolute&apos; THEN SUM([gfv_local]) / COUNTD([order_id])&#13;&#10;        WHEN &apos;% Delta (Var-Control)&apos; THEN (ZN(SUM([gfv_local]) / COUNTD([order_id])) - LOOKUP(ZN(SUM([gfv_local]) / COUNTD([order_id])))) / ABS(LOOKUP(ZN(SUM([gfv_local]) / COUNTD([order_id]))))&#13;&#10;    END&#13;&#10;END'>
                <table-calc level-address='[federated.1r0koqy0r90g0q1cmac1j0llpruu].[variant]' ordering-type='Field' tc-options='Fixed'>
                  <order field='[federated.1r0koqy0r90g0q1cmac1j0llpruu].[variant]' />
                  <order field='[federated.1r0koqy0r90g0q1cmac1j0llpruu].[Calculation_1469862346780229640]' />
                  <address>
