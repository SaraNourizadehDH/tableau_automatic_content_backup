    <datasource caption='Vendors setup' inline='true' name='federated.16c7nfx1w9e4fd10s4f541qoo6zr (copy)' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0u0jyry0vf6zy91bwok790m4itr2 (copy)'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='logistics-data-staging-flat' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='10' bq-large-fetch-rows='' bq-project-fetch-rows='2000' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='DataHub production' schema='cl' server-oauth='' username='fatima.rodriguez@deliveryhero.com' workgroup-auth-mode='prompt' />
