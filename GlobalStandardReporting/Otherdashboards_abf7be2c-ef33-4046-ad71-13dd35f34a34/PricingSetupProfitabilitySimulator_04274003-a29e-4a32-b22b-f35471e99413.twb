            <column caption='Profitability' datatype='string' name='[Calculation_1488158251167662090]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Exp. Profit (copy)_2389441124107923499]&gt;=0 THEN &apos;Positive&apos; ELSE &apos;Negative&apos; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Avg Commission' datatype='real' default-format='C1033%' name='[Calculation_2214645163229540369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_commission_amount])/SUM([orders])*(1+[Parameters].[% Tier 7 (copy)])' />
            </column>
            <column caption='DF' datatype='real' default-format='C1033%' name='[Calculation_2214645163262603287]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Automatic&apos; THEN SUM([total_df_revenue])&#13;&#10;ELSE&#13;&#10;    ZN(IF [Calculation_257268165678080039] = 1 THEN SUM([orders])*[Parameters].[% Tier 1 (copy)_671880815140675584] END) +&#13;&#10;    ZN(IF [Calculation_257268165678080039] = 2 THEN SUM([orders])*[Parameters].[$ Tier 1 (copy 2)_671880815140880387] END) +&#13;&#10;    ZN(IF [Calculation_257268165678080039] = 3 THEN SUM([orders])*[Parameters].[$ Tier 1 (copy 2) (copy)_671880815140900868] END) +&#13;&#10;    ZN(IF [Calculation_257268165678080039] = 4 THEN SUM([orders])*[Parameters].[$ Tier 1 (copy 3)_671880815140900871] END) +&#13;&#10;    ZN(IF [Calculation_257268165678080039] = 5 THEN SUM([orders])*[Parameters].[$ Tier 1 (copy)_671880815140864001] END) +&#13;&#10;    ZN(IF [Calculation_257268165678080039] = 6 THEN SUM([orders])*[Parameters].[$ Tier 1 (copy) (copy 2)_671880815140900870] END) +&#13;&#10;    ZN(IF [Calculation_257268165678080039] = 7 THEN SUM([orders])*[Parameters].[$ Tier 1 (copy) (copy)_671880815140880386] END) +&#13;&#10;    ZN(IF [Calculation_257268165678080039] = 8 THEN SUM([orders])*[Parameters].[$ Tier 1 (copy) (copy) (copy)_671880815140900869] END) +&#13;&#10;    ZN(IF [Calculation_257268165678080039] = 9 THEN SUM([orders])*[Parameters].[$ Tier 1 (copy) (copy) (copy) (copy)_671880815140917256] END)&#13;&#10;END / SUM([orders]) * (1-[Parameters].[% Commission (copy)_2389441124965949487])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='CPO' datatype='real' default-format='C1033%' name='[Calculation_2389441123882520579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM((ZN([total_delivery_costs]))&#13;&#10;*(1-[Parameters].[% VAT (copy)_1269733668567851008])*(1+[Parameters].[% Commission (copy)_2389441124094758953]))/SUM([orders])' />
            </column>
            <column caption='Travel time' datatype='real' default-format='*nn\&apos;ss\&quot;' name='[Calculation_2460091335139860484]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_982910654516989965]*[orders])/SUM([orders])/60/60/24' />
            </column>
            <column caption='Distance' datatype='real' default-format='n#,##0,.00K&quot;m&quot;;-#,##0,.00K&quot;m&quot;' name='[Calculation_2460091335157096456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([linear_distance]*[orders])/SUM([orders])' />
            </column>
            <column caption='Dimension' datatype='real' name='[Calculation_2460091335208255520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Linear Distance&apos; THEN [linear_distance]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Travel Time&apos; THEN [Calculation_982910654516989965]&#13;&#10;END' />
            </column>
            <column caption='Tier TT' datatype='integer' name='[Calculation_257268165678080039]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation1] &lt;= [Parameters].[formula Parameter] THEN 1&#13;&#10;ELSEIF [Calculation1] &lt;= [Parameters].[% Tier 1 (copy)_332984935647199258] THEN 2&#13;&#10;ELSEIF [Calculation1] &lt;= [Parameters].[% Tier 1 (copy) (copy)_332984935647207451] THEN 3&#13;&#10;ELSEIF [Calculation1] &lt;= [Parameters].[% Tier 1 (copy) (copy) (copy)_332984935647215644] THEN 4&#13;&#10;ELSEIF [Calculation1] &lt;= [Parameters].[% Tier 1 (copy) (copy) (copy) (copy)_332984935647223837] THEN 5&#13;&#10;ELSEIF [Calculation1] &lt;= [Parameters].[% Tier 5 (copy)_332984935647637534] THEN 6&#13;&#10;ELSEIF [Calculation1] &lt;= [Parameters].[% Tier 4 (copy)_332984935647719456] THEN 7&#13;&#10;ELSEIF [Calculation1] &lt;= [Parameters].[% Tier 5 (copy)_332984935647719455] THEN 8&#13;&#10;ELSEIF [Calculation1] &lt;= [Parameters].[% Tier 6 (copy)_332984935647719457] THEN 9&#13;&#10;END'>
