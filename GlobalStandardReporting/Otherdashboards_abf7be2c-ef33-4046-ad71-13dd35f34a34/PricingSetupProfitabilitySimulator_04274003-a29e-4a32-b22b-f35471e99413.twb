            <column caption='Share of orders' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM([orders])) / TOTAL(SUM([orders]))'>
