        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0u0jyry0vf6zy91bwok790m4itr2 (copy)' name='Custom_SQL_Query' type='text'><![CDATA[with

zone_data as (
  select
    p.entity_id,
    co.country_code,
    ci.name city_name,
    ci.id city_id,
    zo.name zone_name,
    zo.id zone_id,
  from `fulfillment-dwh-production.curated_data_shared.countries` co
  left join unnest(co.platforms) p
  left join unnest(co.cities) ci
  left join unnest(ci.zones) zo),

payments as (
  select
    p.country_code,
    p.order_id,
    p.delivery_id,
    sum(p.delivery_costs) delivery_costs,
  from `fulfillment-dwh-production.curated_data_shared.utr_timings` p
  where p.created_date between current_date() - 17 and current_date
  group by 1,2,3),

orders as (
    select
      o.global_entity_id,
      o.vendor_id,
      o.value.delivery_fee_local delivery_fee,
      o.value.gbv_local order_value,
      o.value.commission_local commission_amount,
      o.value.commission_base_local commissionable_value,
      o.order_id
    from
      `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o
    where is_sent and
      date(o.placed_at_local) between current_date() - 15 and current_date - 1),

deliveries as (
  select
    o.country_code,
    o.entity.id entity_id,
    o.zone_id,
    vendor.vendor_code,
    o.platform_order_code,
    o.created_date,
    max(case
      when st_distance(d.pickup, vendor.location) <<= 200
       and st_distance(d.dropoff, o.customer.location) <<= 800
      then st_distance(o.vendor.location, o.customer.location)
    end) distance,
    sum(p.delivery_costs) delivery_costs
  from `fulfillment-dwh-production.cl.orders` o
  left join unnest (deliveries) d
  left join payments p on o.country_code = p.country_code and o.order_id = p.order_id and d.id = p.delivery_id
  where o.order_status = 'completed'
    and o.created_date between current_date() - 15 and current_date - 1
    and d.delivery_status = 'completed'
  group by 1,2,3,4,5,6)

select
  z.* except (entity_id),
  v.vertical_type,
  ceiling(d.distance/10)*10 as linear_distance,
  cast(regexp_replace(f.formula, '[^0-9.]', '') as float64) as formula,
  o.delivery_fee,
  sum(o.order_value) total_food_value,
  sum(o.commissionable_value) total_commissionable_value,
  sum(o.commission_amount) total_commission_amount,
  sum(o.delivery_fee) total_df_revenue,
  sum(d.delivery_costs) total_delivery_costs,
  count(distinct d.platform_order_code) as orders,
  current_date() - 15 min_period,
  current_date - 1 max_period
from deliveries d
left join zone_data z on d.country_code = z.country_code and d.entity_id = z.entity_id and d.zone_id = z.zone_id
left join `fulfillment-dwh-production.curated_data_shared.vendors_v2` v on d.vendor_code = v.vendor_code and d.entity_id = v.entity_id
left join orders o on d.entity_id = o.global_entity_id and d.vendor_code = o.vendor_id and d.platform_order_code = o.order_id
left join `fulfillment-dwh-production.dl.dynamic_pricing_travel_time_formula` f on d.country_code = f.country_code
group by 1,2,3,4,5,6,7,8,9]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0u0jyry0vf6zy91bwok790m4itr2 (copy)' name='Custom_SQL_Query' type='text'><![CDATA[with

zone_data as (
  select
    p.entity_id,
    co.country_code,
    ci.name city_name,
    ci.id city_id,
    zo.name zone_name,
    zo.id zone_id,
  from `fulfillment-dwh-production.curated_data_shared.countries` co
  left join unnest(co.platforms) p
  left join unnest(co.cities) ci
  left join unnest(ci.zones) zo),

payments as (
  select
    p.country_code,
    p.order_id,
    p.delivery_id,
    sum(p.delivery_costs) delivery_costs,
  from `fulfillment-dwh-production.curated_data_shared.utr_timings` p
  where p.created_date between current_date() - 17 and current_date
  group by 1,2,3),

orders as (
    select
      o.global_entity_id,
      o.vendor_id,
      o.value.delivery_fee_local delivery_fee,
      o.value.gbv_local order_value,
      o.value.commission_local commission_amount,
      o.value.commission_base_local commissionable_value,
      o.order_id
    from
      `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o
    where is_sent and
      date(o.placed_at_local) between current_date() - 15 and current_date - 1),

deliveries as (
  select
    o.country_code,
    o.entity.id entity_id,
    o.zone_id,
    vendor.vendor_code,
    o.platform_order_code,
    o.created_date,
    max(case
      when st_distance(d.pickup, vendor.location) <<= 200
       and st_distance(d.dropoff, o.customer.location) <<= 800
      then st_distance(o.vendor.location, o.customer.location)
    end) distance,
    sum(p.delivery_costs) delivery_costs
  from `fulfillment-dwh-production.cl.orders` o
  left join unnest (deliveries) d
  left join payments p on o.country_code = p.country_code and o.order_id = p.order_id and d.id = p.delivery_id
  where o.order_status = 'completed'
    and o.created_date between current_date() - 15 and current_date - 1
    and d.delivery_status = 'completed'
  group by 1,2,3,4,5,6)

select
  z.* except (entity_id),
  v.vertical_type,
  ceiling(d.distance/10)*10 as linear_distance,
  cast(regexp_replace(f.formula, '[^0-9.]', '') as float64) as formula,
  o.delivery_fee,
  sum(o.order_value) total_food_value,
  sum(o.commissionable_value) total_commissionable_value,
  sum(o.commission_amount) total_commission_amount,
  sum(o.delivery_fee) total_df_revenue,
  sum(d.delivery_costs) total_delivery_costs,
  count(distinct d.platform_order_code) as orders,
  current_date() - 15 min_period,
  current_date - 1 max_period
from deliveries d
left join zone_data z on d.country_code = z.country_code and d.entity_id = z.entity_id and d.zone_id = z.zone_id
left join `fulfillment-dwh-production.curated_data_shared.vendors_v2` v on d.vendor_code = v.vendor_code and d.entity_id = v.entity_id
left join orders o on d.entity_id = o.global_entity_id and d.vendor_code = o.vendor_id and d.platform_order_code = o.order_id
left join `fulfillment-dwh-production.dl.dynamic_pricing_travel_time_formula` f on d.country_code = f.country_code
group by 1,2,3,4,5,6,7,8,9]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
