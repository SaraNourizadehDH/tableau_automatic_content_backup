            <column caption='Exp. Profit' datatype='real' default-format='C1033%' name='[Avg DF (copy)_2389441123888443416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2460091335183253530]+[Calculation_2214645163229540369]-[Calculation_2389441123882520579]' />
