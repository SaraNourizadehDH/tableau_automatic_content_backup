              <calculation class='tableau' formula='IF&#13;&#10;[Parameters].[Parameter 1] = &apos;Automatic&apos; THEN SUM([total_df_revenue])/SUM([orders])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Manual&apos;&#13;&#10;THEN AVG(&#13;&#10;    ZN([Parameters].[% Tier 1 (copy)_671880815140675584]*([Parameters].[formula Parameter]))+&#13;&#10;    ZN([Parameters].[$ Tier 1 (copy 2)_671880815140880387]*([Parameters].[% Tier 1 (copy)_332984935647199258]-[Parameters].[formula Parameter]))+&#13;&#10;    ZN([Parameters].[$ Tier 1 (copy 2) (copy)_671880815140900868]*([Parameters].[% Tier 1 (copy) (copy)_332984935647207451]-[Parameters].[% Tier 1 (copy)_332984935647199258]))+&#13;&#10;    ZN([Parameters].[$ Tier 1 (copy 3)_671880815140900871]*([Parameters].[% Tier 1 (copy) (copy) (copy)_332984935647215644]-[Parameters].[% Tier 1 (copy) (copy)_332984935647207451]))+&#13;&#10;    ZN([Parameters].[$ Tier 1 (copy)_671880815140864001]*([Parameters].[% Tier 1 (copy) (copy) (copy) (copy)_332984935647223837]-[Parameters].[% Tier 1 (copy) (copy) (copy)_332984935647215644]))+&#13;&#10;    ZN([Parameters].[$ Tier 1 (copy) (copy 2)_671880815140900870]*([Parameters].[% Tier 5 (copy)_332984935647637534]-[Parameters].[% Tier 1 (copy) (copy) (copy) (copy)_332984935647223837]))+&#13;&#10;    ZN([Parameters].[$ Tier 1 (copy) (copy)_671880815140880386]*([Parameters].[% Tier 4 (copy)_332984935647719456]-[Parameters].[% Tier 5 (copy)_332984935647637534]))+&#13;&#10;    ZN([Parameters].[$ Tier 1 (copy) (copy) (copy)_671880815140900869]*([Parameters].[% Tier 5 (copy)_332984935647719455]-[Parameters].[% Tier 4 (copy)_332984935647719456]))+&#13;&#10;    ZN([Parameters].[$ Tier 1 (copy) (copy) (copy) (copy)_671880815140917256]*([Parameters].[% Tier 6 (copy)_332984935647719457]-[Parameters].[% Tier 5 (copy)_332984935647719455])))&#13;&#10;END * (1 - [Parameters].[% Commission (copy)_2389441124965949487])' />
            </column>
            <column caption='AFV' datatype='real' default-format='C1033%' name='[Delivery fees (copy)_2460091335157874699]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([total_commissionable_value])*IF [Parameters].[Parameter 1] = &apos;Current setup&apos; THEN 1 END,SUM([total_food_value]))&#13;&#10;*(1+[Parameters].[% CPO adjustment (copy)_2389441124096073770])/SUM([orders])' />
