          <datasource-dependencies datasource='federated.16c7nfx1w9e4fd10s4f541qoo6zr (copy)'>
            <column caption='Formula' datatype='real' name='[Calculation_1481402853555965962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[formula]/1000*60' />
            </column>
            <column caption='Avg Commission' datatype='real' default-format='C1033%' name='[Calculation_2214645163229540369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_commission_amount])/SUM([orders])*(1+[Parameters].[% Tier 7 (copy)])' />
            </column>
            <column caption='CPO' datatype='real' default-format='C1033%' name='[Calculation_2389441123882520579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM((ZN([total_delivery_costs]))&#13;&#10;*(1-[Parameters].[% VAT (copy)_1269733668567851008])*(1+[Parameters].[% Commission (copy)_2389441124094758953]))/SUM([orders])' />
            </column>
            <column caption='Travel time' datatype='real' default-format='*nn\&apos;ss\&quot;' name='[Calculation_2460091335139860484]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_982910654516989965]*[orders])/SUM([orders])/60/60/24' />
            </column>
            <column caption='Distance' datatype='real' default-format='n#,##0,.00K&quot;m&quot;;-#,##0,.00K&quot;m&quot;' name='[Calculation_2460091335157096456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([linear_distance]*[orders])/SUM([orders])' />
            </column>
            <column caption='Curr. % of AFV ' datatype='real' default-format='p0.0%' name='[Calculation_2460091335158067213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Lin. distance (copy)_2460091335157727242]/[Delivery fees (copy)_2460091335157874699]' />
            </column>
            <column caption='Travel time (sec)' datatype='real' name='[Calculation_982910654516989965]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[linear_distance]*[Calculation_1481402853555965962]' />
            </column>
            <column caption='AFV' datatype='real' default-format='C1033%' name='[Delivery fees (copy)_2460091335157874699]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([total_commissionable_value])*IF [Parameters].[Parameter 1] = &apos;Current setup&apos; THEN 1 END,SUM([total_food_value]))&#13;&#10;*(1+[Parameters].[% CPO adjustment (copy)_2389441124096073770])/SUM([orders])' />
            </column>
            <column caption='Curr. Profit' datatype='real' default-format='C1033%' name='[Exp. Profit (copy)_692709968092909601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Lin. distance (copy)_2460091335157727242]+[Calculation_2214645163229540369]-[Calculation_2389441123882520579]' />
            </column>
            <column caption='Current ADF' datatype='real' default-format='C1033%' name='[Lin. distance (copy)_2460091335157727242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_df_revenue])/SUM([orders]) * (1-[Parameters].[% Commission (copy)_2389441124965949487])' />
