      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Prio Fee Revenue' id='_8BE81DC4B68C4422AFA6A7EE9206D032'>
            <properties context=''>
              <relation connection='bigquery.1eyx7vq077llrp1am644w05zpb98' name='Custom SQL Query' type='text'><![CDATA[WITH total_orders AS (
  SELECT
    o.entity.id AS entity_id,
    DATE_TRUNC(o.created_date, ISOWEEK) week,
    zone.zone_name,
    COUNT(DISTINCT CASE WHEN is_user_plus = 1 AND tags IN ('PRIORITIZE_DELIVERY') and o.entity_id in ('PY_AR', 'PY_CL', 'PY_PE', 'PY_EC') THEN order_code else null END) AS subs_prio_orders,
    COUNT(DISTINCT case when is_user_plus = 1 and o.entity_id in ('PY_AR', 'PY_CL', 'PY_PE', 'PY_EC') THEN order_code else null END) as total_subs_orders,
    COUNT(DISTINCT CASE WHEN is_user_plus = 0 AND tags IN ('PRIORITIZE_DELIVERY') THEN order_code END) AS normal_prio_orders,
    COUNT(DISTINCT case when is_user_plus = 0 THEN order_code END) as total_normal_orders,
    COUNT(DISTINCT case when is_user_plus = 1 THEN user.id END) as total_subs_users,
    COUNT(DISTINCT case when is_user_plus = 0 THEN user.id END) as total_normal_users,
    COUNT(DISTINCT order_code) AS total_orders
  FROM `fulfillment-dwh-production.cl.orders_v2` o, UNNEST(rider.tags) AS tags
  LEFT JOIN `peya-bi-tools-pro.il_logistics.fact_logistic_orders` l ON o.order_code = l.platform_order_code
  LEFT JOIN  `peya-bi-tools-pro.il_core.fact_orders` fo ON LOWER(l.country_code) = LOWER(fo.country.country_code) AND CAST(fo.order_id AS STRING) = l.platform_order_code
  WHERE o.entity.id IN ('PY_AR', 'PY_BO', 'PY_HN', 'PY_NI', 'AP_PA', 'PY_CR', 'PY_PY', 'PY_SV', 'PY_CL', 'PY_PE', 'PY_EC')
    AND o.created_date >>= DATE_TRUNC('2023-01-01', ISOWEEK)
    AND o.created_date << DATE_TRUNC(CURRENT_DATE(), ISOWEEK)
    AND fo.registered_date >>= DATE_TRUNC('2023-01-01', ISOWEEK)
    AND fo.registered_date << DATE_TRUNC(CURRENT_DATE(), ISOWEEK)
    AND fo.order_status = 'CONFIRMED'
    AND fo.delivery_type = 'Own Delivery'
    and fo.pickup = false
  GROUP BY 1, 2, 3
),
prio_orders AS (
  SELECT
    o.entity.id AS entity_id,
    zone.zone_name,
    DATE_TRUNC(o.created_date, ISOWEEK) week,
    SUM(CASE
        WHEN o.entity.id = 'PY_AR' AND o.created_date BETWEEN "2023-01-01" AND "2023-07-24" THEN 60 / d.fx_rate_eur
        WHEN o.entity.id = 'PY_AR' AND o.created_date BETWEEN "2023-07-24" AND "2023-10-23" THEN 99 / d.fx_rate_eur
        WHEN o.entity.id = 'PY_AR' AND o.created_date >> "2023-10-23" THEN 149 / d.fx_rate_eur
        WHEN o.entity.id = 'PY_BO' THEN 4 / d.fx_rate_eur
        when o.entity.id = 'PY_HN' then 10/ d.fx_rate_eur
        when o.entity.id = 'PY_NI' then 12/ d.fx_rate_eur
        when o.entity.id = 'AP_PA' then 0.25/ d.fx_rate_eur
        when o.entity.id = 'PY_CR' then 200/ d.fx_rate_eur
        when o.entity.id = 'PY_PY' then 3000/d.fx_rate_eur
        when o.entity.id = 'PY_SV' then 0.25/d.fx_rate_eur
        when o.entity.id = 'PY_CL' then 290/d.fx_rate_eur
        when o.entity.id = 'PY_PE' then 1/d.fx_rate_eur
        when o.entity.id = 'PY_EC' then 0.30/d.fx_rate_eur
        when o.entity.id = 'PY_UY' then 49/d.fx_rate_eur
        ELSE 0
      END) AS prio_fee_eur,
    COUNT(*) AS prio_orders
  FROM `fulfillment-dwh-production.cl.orders_v2` o, UNNEST(rider.tags) AS tags
  LEFT JOIN `peya-bi-tools-pro.il_logistics.fact_logistic_orders` l ON o.order_code = l.platform_order_code
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata.global_entities` e ON e.global_entity_id = o.entity.id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` d ON d.currency_code = e.currency_iso_code AND d.fx_rate_date = l.created_date
  LEFT JOIN `peya-bi-tools-pro.il_core.fact_orders` fo ON LOWER(l.country_code) = LOWER(fo.country.country_code) AND CAST(fo.order_id AS STRING) = l.platform_order_code
  WHERE o.created_date >>= DATE_TRUNC('2023-01-01', ISOWEEK)
    AND o.created_date << DATE_TRUNC(CURRENT_DATE(), ISOWEEK)
    AND fo.registered_date >>= DATE_TRUNC('2023-01-01', ISOWEEK)
    AND fo.registered_date << DATE_TRUNC(CURRENT_DATE(), ISOWEEK)
    AND tags IN ('PRIORITIZE_DELIVERY')
    AND fo.order_status = 'CONFIRMED'
    AND is_user_plus = 0
    AND fo.delivery_type = 'Own Delivery'
    and fo.pickup = false
  GROUP BY 1, 2, 3
  ORDER BY 1,2 ASC, 2 DESC),

dps_orders AS (
with prio as (
SELECT
  entity_id,
   case when components.priority_fee_id IS NOT NULL then zone_name else null end as zone_name
  , date_trunc(created_date, isoweek) week
  , components.priority_fee_id IS NOT NULL AS has_dps_pf_component
  , COALESCE(priority_fee_eur,0) != 0 AS has_backend_pf
  , count(*) as orders
  , count(case when components.priority_fee_id IS NOT NULL and has_subscription is true then platform_order_code else null end) as subs_prio_orders
  , count(case when components.priority_fee_id IS NOT NULL and has_subscription is false then platform_order_code else null end) as normal_prio_orders
  , sum(priority_fee_eur) as prio_fee_eur
  , sum(dps_priority_fee_eur) as dps_prio_fee_eur
FROM `fulfillment-dwh-production.cl.dps_sessions_mapped_to_orders_perseus` 
WHERE created_date >>= date_trunc('2023-01-01', isoweek)
  AND created_date << date_trunc(CURRENT_DATE(), isoweek)
  AND is_sent
  AND region is not null
  AND is_own_delivery
  and priority_fee_local is not null
GROUP By 1,2,3,4,5
ORDER by 1 asc, 2 desc)

 SELECT
o.entity_id
, p.zone_name
, date_trunc(created_date, isoweek) week
, prio_fee_eur
, p.orders as prio_orders
, p.subs_prio_orders as subs_prio_orders
, p.normal_prio_orders
, count(distinct case when has_subscription is true then platform_order_code end) as total_subs_orders
, count(distinct case when has_subscription is true then customer_account_id end) as total_subs_users
, count(distinct case when has_subscription is false then platform_order_code end) as total_normal_orders
, count(distinct case when has_subscription is false then customer_account_id end) as total_normal_users
, count(distinct platform_order_code) as orders
FROM `fulfillment-dwh-production.cl.dps_sessions_mapped_to_orders_perseus` o
LEFT join prio p on o.entity_id = p.entity_id and date_trunc(o.created_date, isoweek) = p.week and o.zone_name = p.zone_name
WHERE created_date >>= date_trunc('2023-01-01', isoweek)
  AND created_date << date_trunc(CURRENT_DATE(), isoweek)
  AND is_sent
  AND region is not null
  AND has_dps_pf_component is true
  and has_backend_pf is true
  and p.zone_name is not null
GROUP by 1,2,3,4,5,6,7
ORDER by 1 asc, 2 desc
)
 SELECT
  t.entity_id,
  t.zone_name,
  t.week,
  t.subs_prio_orders,
  t.total_subs_orders,
  t.total_subs_users,
  t.normal_prio_orders,
  t.total_normal_orders,
  t.total_normal_users,
  t.total_orders,
  p.prio_fee_eur,
  p.prio_orders,
FROM total_orders t
LEFT JOIN prio_orders p ON t.week = p.week AND t.entity_id = p.entity_id and p.zone_name = t.zone_name
where prio_orders is not null
UNION ALL

SELECT
  d.entity_id,
  d.zone_name,
  d.week,
  d.subs_prio_orders,
  d.total_subs_orders,
  d.total_subs_users,
  d.normal_prio_orders,
  d.total_normal_orders,
  d.total_normal_users,
  d.orders as total_orders,  -- Agregamos columnas con valor 0 para total_orders y prio_orders
  d.prio_fee_eur prio_fee_eur,
  d.prio_orders prio_orders
FROM dps_orders d
ORDER BY entity_id ASC, week DESC]]></relation>
            </properties>
            <properties context='extract'>
