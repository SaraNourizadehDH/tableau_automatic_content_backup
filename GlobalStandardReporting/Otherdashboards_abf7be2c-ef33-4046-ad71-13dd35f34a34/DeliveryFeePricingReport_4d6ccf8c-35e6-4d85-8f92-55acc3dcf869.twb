      <table>
        <view>
          <datasources>
            <datasource caption='delivery_fee_pricing_and_setup (rl)' name='federated.0sljow91oi7rmc10afb1w0khojso' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='# Orders Lower Threshold' datatype='integer' name='[% Orders Relevant (copy)]' param-domain-type='any' role='measure' type='quantitative' value='100'>
              <calculation class='tableau' formula='100' />
            </column>
            <column caption='DF Upper Threshold' datatype='real' name='[Outlier Exclusion Threshold (copy)]' param-domain-type='range' role='measure' type='quantitative' value='100000000.0'>
              <calculation class='tableau' formula='100000000.0' />
            </column>
            <column caption='Selector' datatype='string' name='[Parameter 1 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;City&quot;'>
              <calculation class='tableau' formula='&quot;City&quot;' />
            </column>
            <column caption='% Orders Lower Threshold' datatype='real' name='[Parameter 1 2]' param-domain-type='any' role='measure' type='quantitative' value='2.'>
              <calculation class='tableau' formula='2.' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0sljow91oi7rmc10afb1w0khojso'>
            <column caption='Orders Total' datatype='integer' name='[Calculation_1286622118865899520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [entity_display_name], [city], [vertical_type], [date], [df_lc],   [is_stacked], [is_own_delivery] : SUM([orders]) }' />
            </column>
            <column caption='Delivery Type DF Orders Source' datatype='integer' name='[Calculation_303711523124109315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED  [entity_display_name],  [df_lc]: SUM([Calculation_1286622118865899520])}' />
            </column>
            <column caption='DF % of Orders' datatype='real' default-format='p0.00%' name='[Calculation_377176493866102784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_303711523124109315]/[Calculation_377176493869686786]&#10;//SUM([Orders Total])/TOTAL(SUM([Orders Total]))' />
            </column>
            <column caption='Delivery Type Orders Source' datatype='integer' name='[Calculation_377176493869686786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [entity_display_name] : SUM([Calculation_1286622118865899520])}' />
            </column>
            <column caption='Detail grouped' datatype='string' name='[Calculation_904660589759197201]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Set 1] THEN [Calculation_908038289195266059] ELSE &apos;Other&apos; END' />
            </column>
            <column caption='Detail' datatype='string' name='[Calculation_908038289195266059]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(IF [Parameters].[Parameter 1 1] = &apos;City&apos; THEN [city]&#13;&#10;ELSEIF [Parameters].[Parameter 1 1] = &apos;Brand&apos; THEN [company_name]&#13;&#10;ELSEIF [Parameters].[Parameter 1 1] = &apos;Entity&apos; THEN [entity_display_name]&#13;&#10;&#13;&#10;END,20)' />
            </column>
            <column caption='Delivery Fee' datatype='boolean' name='[Calculation_951104000344477719]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[delivery_fee_lc]=0' />
              <aliases>
                <alias key='false' value='Paid' />
                <alias key='true' value='Free' />
              </aliases>
            </column>
            <column caption='DF Type Breakdown' datatype='real' datatype-customized='true' name='[DF Type (copy 2)]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [DF Type (copy)] = &apos;Free&apos; THEN 0&#13;&#10;ELSEIF [DF Type (copy)] = &apos;Other&apos; THEN -1&#13;&#10;ELSE [df_lc]&#13;&#10;END' />
              <aliases>
                <alias key='-1.0' value='Other' />
              </aliases>
            </column>
            <column caption='DF Type' datatype='string' datatype-customized='true' name='[DF Type (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [df_lc] = 0 THEN &quot;Free&quot;&#13;&#10;ELSEIF [Calculation_377176493866102784] &lt;  [Parameters].[Parameter 1 2]/100&#13;&#10;    OR [Calculation_303711523124109315] &lt; [Parameters].[% Orders Relevant (copy)]&#13;&#10;    OR [df_lc] &gt; [Parameters].[Outlier Exclusion Threshold (copy)]&#13;&#10;    THEN &quot;Other&quot;&#13;&#10;ELSE  &quot;Main Del. Fees&quot;&#13;&#10;END' />
            </column>
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Company Name' datatype='string' name='[company_name]' role='dimension' type='nominal' />
            <column caption='Currency' datatype='string' name='[currency]' role='dimension' type='nominal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
