            </column>
            <column caption='DF Type Breakdown' datatype='real' datatype-customized='true' name='[DF Type (copy 2)]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [DF Type (copy)] = &apos;Free&apos; THEN 0&#13;&#10;ELSEIF [DF Type (copy)] = &apos;Other&apos; THEN -1&#13;&#10;ELSE [df_lc]&#13;&#10;END' />
              <aliases>
                <alias key='-1.0' value='Other' />
              </aliases>
            </column>
            <column caption='DF Type' datatype='string' datatype-customized='true' name='[DF Type (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [df_lc] = 0 THEN &quot;Free&quot;&#13;&#10;ELSEIF [Calculation_377176493866102784] &lt;  [Parameters].[Parameter 1 2]/100&#13;&#10;    OR [Calculation_303711523124109315] &lt; [Parameters].[% Orders Relevant (copy)]&#13;&#10;    OR [df_lc] &gt; [Parameters].[Outlier Exclusion Threshold (copy)]&#13;&#10;    THEN &quot;Other&quot;&#13;&#10;ELSE  &quot;Main Del. Fees&quot;&#13;&#10;END' />
