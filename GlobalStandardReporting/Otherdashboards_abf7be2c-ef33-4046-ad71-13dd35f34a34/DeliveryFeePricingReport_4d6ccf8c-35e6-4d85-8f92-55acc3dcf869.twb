    <dashboard name='Delivery Fee Share Local'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/DeliveryFeePricingReport_16329117470230/DeliveryFeeShareLocal?rev=' id='DeliveryFeeShareLocal' path='/t/GlobalStandardReporting/workbooks/DeliveryFeePricingReport_16329117470230' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='parameter-ctrl'>
          <format attr='background-color' value='#ffffff' />
        </style-rule>
      </style>
      <size maxheight='1600' maxwidth='1400' minheight='1600' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='delivery_fee_pricing_and_setup (rl)' name='federated.0sljow91oi7rmc10afb1w0khojso' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='# Orders Lower Threshold' datatype='integer' name='[% Orders Relevant (copy)]' param-domain-type='any' role='measure' type='quantitative' value='100'>
          <calculation class='tableau' formula='100' />
        </column>
        <column caption='DF Upper Threshold' datatype='real' name='[Outlier Exclusion Threshold (copy)]' param-domain-type='range' role='measure' type='quantitative' value='100000000.0'>
          <calculation class='tableau' formula='100000000.0' />
        </column>
        <column caption='% Orders Lower Threshold' datatype='real' name='[Parameter 1 2]' param-domain-type='any' role='measure' type='quantitative' value='2.'>
          <calculation class='tableau' formula='2.' />
        </column>
        <column caption='Toggle DF' datatype='string' name='[Toggle (copy)_4624985728018698242]' param-domain-type='list' role='measure' type='nominal' value='&quot;Split by DF (\% DF)&quot;'>
          <calculation class='tableau' formula='&quot;Split by DF (% DF)&quot;' />
          <members>
            <member value='&quot;Split by DF (\% DF)&quot;' />
            <member value='&quot;Split by DF (Total Amount)&quot;' />
          </members>
        </column>
        <column caption='Toggle Orders' datatype='string' name='[User Filter Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Split by DF (\% Orders)&quot;'>
          <calculation class='tableau' formula='&quot;Split by DF (% Orders)&quot;' />
          <members>
            <member value='&quot;Split by DF (\% Orders)&quot;' />
            <member value='&quot;Split by DF (\# Orders)&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0sljow91oi7rmc10afb1w0khojso'>
        <column caption='Weekday' datatype='string' name='[Calculation_1181631960118931463]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE datename(&quot;weekday&quot;, [date]) WHEN IN (&quot;Saturday&quot;,&quot;Sunday&quot;) THEN &quot;Weekend&quot; ELSE &quot;Weekday&quot; END' />
        </column>
        <column caption='DF Type' datatype='string' datatype-customized='true' name='[DF Type (copy)]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [df_lc] = 0 THEN &quot;Free&quot;&#13;&#10;ELSEIF [Calculation_377176493866102784] &lt;  [Parameters].[Parameter 1 2]/100&#13;&#10;    OR [Calculation_303711523124109315] &lt; [Parameters].[% Orders Relevant (copy)]&#13;&#10;    OR [df_lc] &gt; [Parameters].[Outlier Exclusion Threshold (copy)]&#13;&#10;    THEN &quot;Other&quot;&#13;&#10;ELSE  &quot;Main Del. Fees&quot;&#13;&#10;END' />
        </column>
        <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
        <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
        <column caption='Entity Display Name' datatype='string' name='[entity_display_name]' role='dimension' type='nominal' />
        <column caption='Is Own Delivery' datatype='boolean' name='[is_own_delivery]' role='dimension' type='nominal' />
        <column-instance column='[Calculation_1181631960118931463]' derivation='None' name='[none:Calculation_1181631960118931463:nk]' pivot='key' type='nominal' />
        <column-instance column='[DF Type (copy)]' derivation='None' name='[none:DF Type (copy):nk]' pivot='key' type='nominal' />
        <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
