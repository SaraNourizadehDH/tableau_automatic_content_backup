      <aliases enabled='yes' />
      <column caption='Avg Paid Delivery Fee Lc' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg Paid Delivery Fee (copia)_1094656194064338947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total DH Revenue (copia)_1094656194064162818])/SUM([Calculation_1286622118865899520])' />
      </column>
      <column caption='Weekday' datatype='string' name='[Calculation_1181631960118931463]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE datename(&quot;weekday&quot;, [date]) WHEN IN (&quot;Saturday&quot;,&quot;Sunday&quot;) THEN &quot;Weekend&quot; ELSE &quot;Weekday&quot; END' />
      </column>
      <column caption='Orders Total' datatype='integer' name='[Calculation_1286622118865899520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED  [entity_display_name], [city], [vertical_type], [date], [df_lc],   [is_stacked], [is_own_delivery] : SUM([orders]) }' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1417508005327134720]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Delivery Type DF Orders Source' datatype='integer' name='[Calculation_303711523124109315]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED  [entity_display_name],  [df_lc]: SUM([Calculation_1286622118865899520])}' />
      </column>
      <column caption='DF % of Orders' datatype='real' default-format='p0.00%' name='[Calculation_377176493866102784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_303711523124109315]/[Calculation_377176493869686786]&#10;//SUM([Orders Total])/TOTAL(SUM([Orders Total]))' />
      </column>
      <column caption='Delivery Type Orders Source' datatype='integer' name='[Calculation_377176493869686786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [entity_display_name] : SUM([Calculation_1286622118865899520])}' />
      </column>
      <column caption='Select Chart' datatype='string' name='[Calculation_4624985727996796928]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[User Filter Parameter]' />
      </column>
      <column caption='Select Chart DF' datatype='string' name='[Calculation_4624985728018944003]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Toggle (copy)_4624985728018698242]' />
      </column>
      <column caption='Select Chart Weekly' datatype='string' name='[Calculation_4624985728028393477]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Toggle Orders (copy)_4624985728027971588]' />
      </column>
      <column caption='Detail grouped' datatype='string' name='[Calculation_904660589759197201]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Set 1] THEN [Calculation_908038289195266059] ELSE &apos;Other&apos; END' />
      </column>
      <column caption='Detail' datatype='string' name='[Calculation_908038289195266059]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(IF [Parameters].[Parameter 1 1] = &apos;City&apos; THEN [city]&#13;&#10;ELSEIF [Parameters].[Parameter 1 1] = &apos;Brand&apos; THEN [company_name]&#13;&#10;ELSEIF [Parameters].[Parameter 1 1] = &apos;Entity&apos; THEN [entity_display_name]&#13;&#10;&#13;&#10;END,20)' />
      </column>
      <column caption='Orders/day' datatype='real' name='[Calculation_908038289201053709]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1286622118865899520])/COUNTD([date])' />
      </column>
      <column caption='Delivery Fee' datatype='boolean' name='[Calculation_951104000344477719]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[delivery_fee_lc]=0' />
        <aliases>
          <alias key='false' value='Paid' />
          <alias key='true' value='Free' />
        </aliases>
      </column>
      <column caption='Main Partner' datatype='boolean' name='[Calculation_951104000377921573]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[company_name]&lt;&gt;&apos;-Other&apos;' />
        <aliases>
          <alias key='false' value='No' />
          <alias key='true' value='Yes' />
        </aliases>
      </column>
      <column caption='DF Type Breakdown' datatype='real' datatype-customized='true' name='[DF Type (copy 2)]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [DF Type (copy)] = &apos;Free&apos; THEN 0&#13;&#10;ELSEIF [DF Type (copy)] = &apos;Other&apos; THEN -1&#13;&#10;ELSE [df_lc]&#13;&#10;END' />
        <aliases>
          <alias key='-1.0' value='Other' />
        </aliases>
      </column>
      <column caption='DF Type Graph' datatype='string' datatype-customized='true' name='[DF Type (copy 3)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [df_lc] = 0 THEN &quot;Free&quot;&#13;&#10;ELSEIF [Calculation_377176493866102784] &lt;  [Parameters].[Parameter 1 2]/100&#10;    OR [Calculation_1286622118865899520] &lt; [Parameters].[% Orders Relevant (copy)]&#10;    THEN &quot;Other&quot;&#13;&#10;ELSE  &quot;Main Del. Fees&quot;&#13;&#10;END' />
      </column>
      <column caption='DF Type' datatype='string' datatype-customized='true' name='[DF Type (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [df_lc] = 0 THEN &quot;Free&quot;&#13;&#10;ELSEIF [Calculation_377176493866102784] &lt;  [Parameters].[Parameter 1 2]/100&#13;&#10;    OR [Calculation_303711523124109315] &lt; [Parameters].[% Orders Relevant (copy)]&#13;&#10;    OR [df_lc] &gt; [Parameters].[Outlier Exclusion Threshold (copy)]&#13;&#10;    THEN &quot;Other&quot;&#13;&#10;ELSE  &quot;Main Del. Fees&quot;&#13;&#10;END' />
      </column>
      <column caption='First Day of the Week' datatype='datetime' name='[Date (copy)]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [date])' />
      </column>
      <column caption='Select Chart Daily' datatype='string' name='[Select Chart Weekly (copy)_4624985728044298247]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Toggle Weekly (copy)_4624985728043470854]' />
      </column>
      <column caption='Total DF Revenue Lc' datatype='real' name='[Total DH Revenue (copia)_1094656194064162818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [entity_display_name], [city], [vertical_type], [date], [df_lc], [is_stacked], [is_own_delivery] : SUM([df_lc]*[orders]) }' />
      </column>
