            <column caption='KPI Type' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Absolute&quot;'>
              <calculation class='tableau' formula='&quot;Absolute&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0j4f1vy1nta6ez12sdetp0kfpmjo].[scheme_id]' caption='Scheme ID_Off_Param' datatype='real' default-format='n0;-0' name='[Scheme ID_On (copy)_8726005755281117184]' param-domain-type='list' role='measure' type='quantitative' value='2997.0'>
              <calculation class='tableau' formula='2997.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0j4f1vy1nta6ez12sdetp0kfpmjo'>
            <column caption='Orders' datatype='real' default-format='N' name='[Calculation_3441594542277439489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Total&apos; THEN&#13;&#10;    CASE [Parameters].[Parameter 4]&#13;&#10;        WHEN &apos;Absolute&apos; THEN ROUND(COUNTD([order_id]), 0)&#13;&#10;        WHEN &apos;% Delta (On-Off)&apos; THEN ROUND((ZN(COUNTD([order_id])) - LOOKUP(ZN(COUNTD([order_id])))) / ABS(LOOKUP(ZN(COUNTD([order_id])))), 4)&#13;&#10;    END&#13;&#10;ELSE NULL&#13;&#10;END'>
                <table-calc level-address='[federated.0j4f1vy1nta6ez12sdetp0kfpmjo].[Calculation_8726005755282120705]' ordering-type='Field' tc-options='Fixed'>
                  <order field='[federated.0j4f1vy1nta6ez12sdetp0kfpmjo].[Calculation_8726005755282120705]' />
                  <order field='[federated.0j4f1vy1nta6ez12sdetp0kfpmjo].[scheme_id]' />
                  <order field='[federated.0j4f1vy1nta6ez12sdetp0kfpmjo].[Calculation_8726005755311808514]' />
                  <address>
                    <value>&quot;Off Day&quot;</value>
                  </address>
                </table-calc>
              </calculation>
            </column>
            <column caption='On/Off Day' datatype='string' name='[Calculation_8726005755282120705]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [scheme_id]&#13;&#10;    WHEN [Parameters].[Parameter 3] THEN &apos;On Day&apos;&#13;&#10;    WHEN [Parameters].[Scheme ID_On (copy)_8726005755281117184] THEN &apos;Off Day&apos;&#13;&#10;    ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='On/Off Rank' datatype='integer' name='[Calculation_8726005755311808514]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Calculation_8726005755282120705] &#13;&#10;    WHEN &apos;Off Day&apos; THEN 0&#13;&#10;    WHEN &apos;On Day&apos; THEN 1&#13;&#10;END' />
            </column>
            <column caption='JF' datatype='real' default-format='N' name='[Commission (copy)_8726005755320594445]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Total&apos; THEN&#13;&#10;    CASE [Parameters].[Parameter 4]&#13;&#10;        WHEN &apos;Absolute&apos; THEN ROUND(SUM([joker_vendor_fee_local]), 2)&#13;&#10;        WHEN &apos;% Delta (On-Off)&apos; THEN ROUND((ZN(SUM([joker_vendor_fee_local])) - LOOKUP(ZN(SUM([joker_vendor_fee_local])))) / ABS(LOOKUP(ZN(SUM([joker_vendor_fee_local])))), 4)&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    CASE [Parameters].[Parameter 4]&#13;&#10;        WHEN &apos;Absolute&apos; THEN ROUND(SUM([joker_vendor_fee_local]) / COUNTD([order_id]), 2)&#13;&#10;        WHEN &apos;% Delta (On-Off)&apos; THEN ROUND((ZN(SUM([joker_vendor_fee_local]) / COUNTD([order_id])) - LOOKUP(ZN(SUM([joker_vendor_fee_local]) / COUNTD([order_id])))) / ABS(LOOKUP(ZN(SUM([joker_vendor_fee_local]) / COUNTD([order_id])))), 4)&#13;&#10;    END&#13;&#10;END'>
                <table-calc level-address='[federated.0j4f1vy1nta6ez12sdetp0kfpmjo].[Calculation_8726005755282120705]' ordering-type='Field' tc-options='Fixed'>
                  <order field='[federated.0j4f1vy1nta6ez12sdetp0kfpmjo].[Calculation_8726005755282120705]' />
                  <order field='[federated.0j4f1vy1nta6ez12sdetp0kfpmjo].[scheme_id]' />
                  <order field='[federated.0j4f1vy1nta6ez12sdetp0kfpmjo].[Calculation_8726005755311808514]' />
                  <address>
                    <value>&quot;Off Day&quot;</value>
                  </address>
                </table-calc>
              </calculation>
            </column>
