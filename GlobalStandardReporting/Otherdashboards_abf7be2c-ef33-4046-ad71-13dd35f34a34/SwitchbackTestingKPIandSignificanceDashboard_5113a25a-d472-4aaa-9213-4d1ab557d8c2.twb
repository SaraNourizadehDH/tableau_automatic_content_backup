                  <zone h='5738' id='20' mode='compact' param='[Parameters].[Scheme ID_On (copy)_8726005755281117184]' type-v2='paramctrl' w='25032' x='24967' y='13129'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
