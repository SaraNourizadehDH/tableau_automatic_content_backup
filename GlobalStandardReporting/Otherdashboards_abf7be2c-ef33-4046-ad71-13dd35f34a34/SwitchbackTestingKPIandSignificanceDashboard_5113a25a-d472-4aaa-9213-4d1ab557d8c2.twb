        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Total&apos; THEN&#13;&#10;    CASE [Parameters].[Parameter 4]&#13;&#10;        WHEN &apos;Absolute&apos; THEN ROUND(SUM([service_fee_local]), 2)&#13;&#10;        WHEN &apos;% Delta (On-Off)&apos; THEN ROUND((ZN(SUM([service_fee_local])) - LOOKUP(ZN(SUM([service_fee_local])))) / ABS(LOOKUP(ZN(SUM([service_fee_local])))), 4)&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    CASE [Parameters].[Parameter 4]&#13;&#10;        WHEN &apos;Absolute&apos; THEN ROUND(SUM([service_fee_local]) / COUNTD([order_id]), 2)&#13;&#10;        WHEN &apos;% Delta (On-Off)&apos; THEN ROUND((ZN(SUM([service_fee_local]) / COUNTD([order_id])) - LOOKUP(ZN(SUM([service_fee_local]) / COUNTD([order_id])))) / ABS(LOOKUP(ZN(SUM([service_fee_local]) / COUNTD([order_id])))), 4)&#13;&#10;    END&#13;&#10;END'>
