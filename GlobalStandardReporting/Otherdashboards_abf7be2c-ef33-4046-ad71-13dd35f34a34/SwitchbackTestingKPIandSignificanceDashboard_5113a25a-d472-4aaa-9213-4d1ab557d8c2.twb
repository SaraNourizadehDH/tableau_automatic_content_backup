      <column caption='Orders' datatype='real' default-format='N' name='[Calculation_3441594542277439489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Total&apos; THEN&#13;&#10;    CASE [Parameters].[Parameter 4]&#13;&#10;        WHEN &apos;Absolute&apos; THEN ROUND(COUNTD([order_id]), 0)&#13;&#10;        WHEN &apos;% Delta (On-Off)&apos; THEN ROUND((ZN(COUNTD([order_id])) - LOOKUP(ZN(COUNTD([order_id])))) / ABS(LOOKUP(ZN(COUNTD([order_id])))), 4)&#13;&#10;    END&#13;&#10;ELSE NULL&#13;&#10;END'>
          <table-calc level-address='[federated.0j4f1vy1nta6ez12sdetp0kfpmjo].[Calculation_8726005755282120705]' ordering-type='Field' tc-options='Fixed'>
