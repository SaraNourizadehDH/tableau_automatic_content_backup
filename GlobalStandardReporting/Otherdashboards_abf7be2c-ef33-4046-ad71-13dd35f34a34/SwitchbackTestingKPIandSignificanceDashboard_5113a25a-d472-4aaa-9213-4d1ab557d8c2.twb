            <address>
              <value>&quot;Off Day&quot;</value>
            </address>
          </table-calc>
        </calculation>
      </column>
      <column caption='KPI_top' datatype='real' name='[Calculation_3441594542287667204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;Total&apos;&#13;&#10;THEN &#13;&#10;    IF [Parameters].[Parameter 1] IN (&apos;mean_delay&apos;, &apos;delivery_distance_m&apos;, &apos;delivery_time_min&apos;) THEN NULL&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;order_count&apos; THEN COUNTD([order_id])&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;delivery_fee&apos; THEN SUM([actual_df_paid_by_customer])&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;GFV&apos; THEN SUM(gfv_local)&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;GMV&apos; THEN SUM(gmv_local)&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;commission&apos; THEN SUM([commission_local])&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;joker_fee&apos; THEN SUM([joker_vendor_fee_local])&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;small_order_fee&apos; THEN SUM([sof_local])&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;service_fee&apos; THEN SUM([service_fee_local])&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;revenue&apos; THEN SUM([revenue_local])&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;gross_profit&apos; THEN SUM([gross_profit_local])&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;delivery_costs&apos; THEN SUM([delivery_costs_local])&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    IF [Parameters].[Parameter 1] = &apos;mean_delay&apos; THEN AVG([dps_mean_delay])&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;delivery_distance_m&apos; THEN AVG([delivery_distance_m])&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;delivery_time_min&apos; THEN AVG([actual_DT])&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;order_count&apos; THEN NULL&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;delivery_fee&apos; THEN SUM([actual_df_paid_by_customer]) / COUNTD([order_id])&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;GFV&apos; THEN SUM(gfv_local) / COUNTD([order_id])&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;GMV&apos; THEN SUM(gmv_local) / COUNTD([order_id])&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;commission&apos; THEN SUM([commission_local]) / COUNTD([order_id])&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;joker_fee&apos; THEN SUM([joker_vendor_fee_local]) / COUNTD([order_id])&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;small_order_fee&apos; THEN SUM([sof_local]) / COUNTD([order_id])&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;service_fee&apos; THEN SUM([service_fee_local]) / COUNTD([order_id])&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;revenue&apos; THEN SUM([revenue_local]) / COUNTD([order_id])&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;gross_profit&apos; THEN SUM([gross_profit_local]) / COUNTD([order_id])&#13;&#10;        ELSEIF [Parameters].[Parameter 1] = &apos;delivery_costs&apos; THEN SUM([delivery_costs_local]) / COUNTD([order_id])&#13;&#10;    END&#13;&#10;END' />
      </column>
