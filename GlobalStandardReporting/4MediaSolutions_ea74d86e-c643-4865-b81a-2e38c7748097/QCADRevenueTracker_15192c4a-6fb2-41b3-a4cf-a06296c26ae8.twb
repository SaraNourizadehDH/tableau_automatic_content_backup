      <column caption='NMR as % of GMV' datatype='real' name='[Product Ad revenue % of NMR  (copy)_33565906183888902]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_3134223893230931994])/SUM([NMR Revenue (copy)_3134223893251256350]))' />
      </column>
      <column caption='Banner Revenue' datatype='real' name='[Product Ads Revenue (copy)_33565906175733761]' role='measure' type='quantitative'>
