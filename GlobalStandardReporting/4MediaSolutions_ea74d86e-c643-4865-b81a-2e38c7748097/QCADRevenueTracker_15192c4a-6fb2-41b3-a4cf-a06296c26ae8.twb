      </column>
      <column caption='Unique Advertisers' datatype='real' name='[Advertisers Asset (copy)_3134223892244725769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [Calculation_3134223892194480133]: MAX([Calculation_3134223892244070408])}' />
      </column>
      <column caption='Asset (copy)' datatype='string' name='[Asset (copy)_3134223893330944055]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[asset]' />
      </column>
      <column caption='Asset Type (copy)' datatype='string' name='[Asset Type (copy)_3134223893331468344]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[asset_type]' />
      </column>
      <column caption='Monetization Revenue' datatype='real' name='[Banner Revenue (copy)_33565906176139266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [asset_type] = &quot;DIP&quot; THEN [ad_revenue_eur] ELSE 0 END' />
      </column>
      <column caption='Monetisation_calendar_year' datatype='real' name='[Calculation_212302521696686080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED year([stamp_date]) : SUM([Banner Revenue (copy)_33565906176139266])}' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_3134223892194480133]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN &apos;year&apos; THEN STR(DATEPART(&apos;year&apos;, [stamp_date]))&#10; WHEN &apos;quarter&apos; THEN &apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;, [stamp_date])) + &apos; &apos; + STR(DATEPART(&apos;year&apos;, [stamp_date]))&#10;  WHEN &apos;month&apos; THEN DATENAME(&apos;month&apos;, [stamp_date]) + &apos; &apos; + STR(DATEPART(&apos;year&apos;, [stamp_date]))&#10;WHEN &apos;week&apos; THEN &apos;W&apos; + STR(DATEPART(&apos;week&apos;, [stamp_date])) + &apos; &apos; + STR(DATEPART(&apos;year&apos;, [stamp_date]))&#10;WHEN &apos;day&apos; THEN STR([stamp_date])&#10;END' />
      </column>
      <column caption='Asset Advertisers' datatype='real' name='[Calculation_3134223892210638854]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;year&quot; THEN [advertisers_year]&#10;WHEN &quot;quarter&quot; THEN [advertisers_quarter]&#10;WHEN &quot;month&quot; THEN [advertisers_month]&#10;WHEN &quot;week&quot; THEN [advertisers_week]&#10;WHEN &quot;day&quot; THEN [advertisers_daily]&#10;end' />
      </column>
      <column caption='Advertisers Asset' datatype='real' name='[Calculation_3134223892213895175]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id],[Calculation_3134223892194480133], [business_vertical],[asset]:AVG([Calculation_3134223892210638854])}' />
      </column>
      <column caption='Advertisers Unique' datatype='real' name='[Calculation_3134223892244070408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;year&quot; THEN [unique_advertisers_year]&#10;WHEN &quot;quarter&quot; THEN [unique_advertisers_quarter]&#10;WHEN &quot;month&quot; THEN [unique_advertisers_month]&#10;WHEN &quot;week&quot; THEN [unique_advertisers_week]&#10;WHEN &quot;day&quot; THEN [unique_advertisers_daily]&#10;end' />
      </column>
      <column caption='Latest Advertiser count' datatype='real' name='[Calculation_3134223892256661514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;month&apos;, [stamp_date], {MAX([stamp_date])}) = 1 THEN [Advertisers Asset (copy)_3134223892244725769] END' />
      </column>
      <column caption='Latest Complete month' datatype='date' name='[Calculation_3134223892259274763]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;month&apos;, [stamp_date], {[Calculation_3134223892275716114]}) = 1 THEN [stamp_date] END' />
      </column>
      <column caption='Max order date' datatype='date' name='[Calculation_3134223893223145492]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([stamp_date])}' />
      </column>
      <column caption='Last closed Month' datatype='date' name='[Calculation_3134223893223718933]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date(dateadd(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;,[Calculation_3134223893223145492])))' />
      </column>
      <column caption='NMR Revenue' datatype='real' name='[Calculation_3134223893230931994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],DATEPART(&apos;month&apos;,[stamp_date]) :MAX([nmr_revenue_eur])}' />
      </column>
      <column caption='NMR' datatype='real' name='[Calculation_3134223893238415389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_3134223892194480133] : AVG([Calculation_3134223893230931994])}' />
      </column>
      <column aggregation='Sum' caption='Max Month' datatype='integer' name='[Calculation_3134223893262520353]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;month&apos;,[Calculation_3134223893223145492])' />
      </column>
      <column caption='Product Ads Revenue' datatype='real' name='[Calculation_33565906174267392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [asset_type] = &quot;Product Ads&quot; THEN [ad_revenue_eur] ELSE 0 END' />
      </column>
      <column caption='CPC Ad revenue' datatype='real' name='[Calculation_33565906211741704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IF  CONTAINS([asset], &quot;CPC&quot;) THEN [ad_revenue_eur] else null end)' />
      </column>
      <column caption='CPC % of NMR' datatype='real' name='[Calculation_33565906228117513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_33565906211741704])/SUM([Calculation_3134223893230931994])' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_7033989327207665674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEPART(&apos;month&apos;, [stamp_date]) = DATEPART(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) AND DATEPART(&apos;year&apos;, [stamp_date]) = DATEPART(&apos;year&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN [Advertisers Asset (copy)_3134223892244725769] END' />
      </column>
      <column caption='Calculation2' datatype='boolean' name='[Calculation_7033989327208017931]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF (YEAR([stamp_date]) = YEAR(TODAY()) AND MONTH([stamp_date]) = MONTH(TODAY()) - 1) OR &#10;   (MONTH(TODAY()) = 1 AND YEAR([stamp_date]) = YEAR(TODAY()) - 1 AND MONTH([stamp_date]) = 12) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Calculation3' datatype='real' name='[Calculation_7033989327208337420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_7033989327208017931] THEN [Calculation_3134223892213895175] END' />
      </column>
      <column caption='q1' datatype='string' name='[Calculation_7033989327225872398]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME([Parameters].[Parameter 1],  [Stamp Date (Months)])' />
      </column>
      <column caption='Q2' datatype='real' name='[Calculation_7033989327226261519]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_7033989327225872398],[global_entity_id]: MAX([Advertisers Asset (copy)_3134223892244725769]) }' />
      </column>
      <column caption='Calculation4' datatype='real' name='[Calculation_7033989327227867152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [Calculation_3134223892194480133]: MAX([Calculation_3134223892244070408])}' />
      </column>
      <column caption='Retail Revenue' datatype='real' name='[NMR Revenue (copy)_3134223893251256350]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],DATEPART(&apos;month&apos;,[stamp_date]) :MAX([retail_revenue_eur])}' />
