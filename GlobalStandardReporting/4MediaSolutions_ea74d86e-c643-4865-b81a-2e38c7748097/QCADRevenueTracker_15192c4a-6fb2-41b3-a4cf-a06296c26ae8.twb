      <column datatype='date' name='[Stamp Date (Months)]' role='dimension' type='quantitative' user:agg-type='Month-Trunc' user:base-field='stamp_date' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [stamp_date]))' />
