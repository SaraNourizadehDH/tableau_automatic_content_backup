    <dashboard name='Glossary'>
      <repository-location derived-from='http://ip-172-31-0-134:8278/t/GlobalStandardReporting/workbooks/CommercialPerformanceDashboard/Glossary?rev=' id='Glossary' path='/t/GlobalStandardReporting/workbooks/CommercialPerformanceDashboard' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1000' maxwidth='1366' minheight='1000' minwidth='1366' preset-index='0' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98400' id='1' type-v2='text' w='98828' x='586' y='800'>
            <formatted-text>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>KPI Definitions</run>
              <run>Æ&#10;</run>
              <run fontsize='11'>(All metrics involving currency are in EUR)</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Total Orders: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Total orders placed</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>GPV: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Gross Purchase Value, which is Gross value of the products sold without considering vouchers or DF, but including VAT</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Qty delivered: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Total quantity of items delivered in successful orders</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Orders per day per store: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Total orders per store that were placed per day in the time frame selected</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Customers per Dmart: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Total unique customers per Dmart in the time frame selected</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>*Customer Frequency: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Total Orders/Total Customers in the time frame selected. For Frequency, the minimum time period selected should be a month</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>CVR (Dmart homepage to Transaction): </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Conversion rate i.e total number of sessions with transactions/total number of sessions</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>After Order NPS: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Net Promoter Score -- ((Number of Promoters) - (Number of Detractors))/Total number of responses</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>ABV: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Average Basket Value</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Items per basket: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Number of items in a basket/order (on an average)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Average price per item: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Average value paid for an item by a customer</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Avg Listed SKUs: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Average number of listed SKUs (only mature warehouses are considered)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>% of Convenience DMarts: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>% of Dmarts out of total Dmarts which have listed SKUs between 3000 and 5999 (only mature warehouses are considered)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>% of Supermarket DMarts: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>% of Dmarts out of total Dmarts which have more than or equal to 6000 listed SKUs (only mature warehouses are considered)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Availability: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Total time a SKU is present for the customer to order/Total time a store is open</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>UltraFresh GPV contribution: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>GPV contribution by UltraFresh categories - Produce, Ready to Consume and Meat/Seafood</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Fresh GPV contribution: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>GPV contribution by Fresh categories - Dairy / Chilled / Eggs, Bread / Bakery and Frozen</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Promo GPV contribution: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>GPV value from items with item price discount</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Content Score: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Average of aggregated completeness and quality metrics score</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>DF per order: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Delivery fee revenue / total orders</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Nominal DF: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Delivery fee revenue / total orders with delivery fee</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>% of orders with FDF (Free Delivery Fee): </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>% of total orders in which no delivery fee was charged</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>DF per order/ABV: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Delivery Fee per order/ Average Basket Value</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>DF per order/ Food DF per order: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Avg delivery fee in QCommerce / Avg food delivery fee (restaurant side)</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Front Margin: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Sales (Total price paid per item excluding VAT) + Supplier funding - COGS (Cost of Goods Sold)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Front Margin %: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Front Margin as % of Sales (Total price paid per item excluding VAT)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Promo Funding %: </run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Supplier promotion funding % -- Supplier Funding / Markdown*</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Markdown- Item price discount (before supplier funding) x Qty sold</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='90' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='98400' id='89' param='vert' type-v2='layout-flow' w='98828' x='586' y='800'>
                <zone forceUpdate='true' h='98400' id='1' type-v2='text' w='98828' x='586' y='800'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>KPI Definitions</run>
                    <run>Æ&#10;</run>
                    <run fontsize='11'>(All metrics involving currency are in EUR)</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Total Orders: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Total orders placed</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>GPV: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Gross Purchase Value, which is Gross value of the products sold without considering vouchers or DF, but including VAT</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Qty delivered: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Total quantity of items delivered in successful orders</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Orders per day per store: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Total orders per store that were placed per day in the time frame selected</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Customers per Dmart: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Total unique customers per Dmart in the time frame selected</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>*Customer Frequency: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Total Orders/Total Customers in the time frame selected. For Frequency, the minimum time period selected should be a month</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>CVR (Dmart homepage to Transaction): </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Conversion rate i.e total number of sessions with transactions/total number of sessions</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>After Order NPS: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Net Promoter Score -- ((Number of Promoters) - (Number of Detractors))/Total number of responses</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>ABV: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Average Basket Value</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Items per basket: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Number of items in a basket/order (on an average)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Average price per item: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Average value paid for an item by a customer</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Avg Listed SKUs: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Average number of listed SKUs (only mature warehouses are considered)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>% of Convenience DMarts: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>% of Dmarts out of total Dmarts which have listed SKUs between 3000 and 5999 (only mature warehouses are considered)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>% of Supermarket DMarts: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>% of Dmarts out of total Dmarts which have more than or equal to 6000 listed SKUs (only mature warehouses are considered)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Availability: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Total time a SKU is present for the customer to order/Total time a store is open</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>UltraFresh GPV contribution: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>GPV contribution by UltraFresh categories - Produce, Ready to Consume and Meat/Seafood</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Fresh GPV contribution: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>GPV contribution by Fresh categories - Dairy / Chilled / Eggs, Bread / Bakery and Frozen</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Promo GPV contribution: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>GPV value from items with item price discount</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Content Score: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Average of aggregated completeness and quality metrics score</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>DF per order: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Delivery fee revenue / total orders</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Nominal DF: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Delivery fee revenue / total orders with delivery fee</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>% of orders with FDF (Free Delivery Fee): </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>% of total orders in which no delivery fee was charged</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>DF per order/ABV: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Delivery Fee per order/ Average Basket Value</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>DF per order/ Food DF per order: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Avg delivery fee in QCommerce / Avg food delivery fee (restaurant side)</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Front Margin: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Sales (Total price paid per item excluding VAT) + Supplier funding - COGS (Cost of Goods Sold)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Front Margin %: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Front Margin as % of Sales (Total price paid per item excluding VAT)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='11'>Promo Funding %: </run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Supplier promotion funding % -- Supplier Funding / Markdown*</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='11'>Markdown- Item price discount (before supplier funding) x Qty sold</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{CA43BE81-101D-4F3B-9287-52D2A336FC8C}' />
    </dashboard>
