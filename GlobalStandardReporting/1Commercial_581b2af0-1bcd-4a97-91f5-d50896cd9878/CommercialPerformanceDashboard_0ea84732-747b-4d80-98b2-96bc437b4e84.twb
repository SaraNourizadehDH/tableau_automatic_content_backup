    <worksheet name='Timeseries Comparison'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_commercial_performance_dashboard' name='federated.0lwsv7w06sjdwb1g3oqo50rvp44w' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0lwsv7w06sjdwb1g3oqo50rvp44w'>
            <column caption='Calculation2' datatype='string' name='[Calculation_3446379615191810058]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Region&apos; then [region]&#10;ELSE&#10;[common_name]&#10;END' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_3722577003726245888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dmart_transactions])/SUM([dmart_sessions])' />
            </column>
            <column caption='Customers per Dmart' datatype='real' name='[Calculation_4222054348819439620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_customers])/[Calculation_4923349253592809477]' />
            </column>
            <column caption='Customer Frequency*' datatype='real' name='[Calculation_4653696160399388672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_orders_monthly])/SUM([total_customers_monthly])' />
            </column>
            <column caption='Avg number of warehouses' datatype='real' name='[Calculation_4923349253592809477]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_warehouses])/COUNTD([order_date])' />
            </column>
            <column caption='Orders per day per store' datatype='real' name='[Calculation_4923349253684215817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_orders])/COUNTD([order_date]))/[Calculation_4923349253592809477]' />
            </column>
            <column caption='After Order NPS' datatype='real' name='[Calculation_4923349253757902859]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([nps_promoters])-SUM([nps_detractors]))/SUM([nps_responses]))*100' />
            </column>
            <column caption='Management Entity_new' datatype='string' name='[Calculation_680113980050227200]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  ([management_entity] = &apos;DH Austria&apos; OR &#10;    [management_entity] = &apos;DH CEE&apos; OR &#10;    [management_entity] = &apos;DH Nordics&apos;)&#10;THEN &apos;Europe&apos;&#10;ELSE&#10;[management_entity]&#10;END' />
            </column>
            <column caption='Common Name' datatype='string' name='[common_name]' role='dimension' type='nominal' />
            <column caption='Dmart Sessions' datatype='integer' name='[dmart_sessions]' role='measure' type='quantitative' />
            <column caption='Dmart Transactions' datatype='integer' name='[dmart_transactions]' role='measure' type='quantitative' />
            <column caption='Gbv Gross Of Vat' datatype='real' name='[gbv_gross_of_vat]' role='measure' type='quantitative' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[order_date]' derivation='Month' name='[mn:order_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_3446379615191810058]' derivation='None' name='[none:Calculation_3446379615191810058:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_680113980050227200]' derivation='None' name='[none:Calculation_680113980050227200:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column caption='Nps Detractors' datatype='real' datatype-customized='true' name='[nps_detractors]' role='measure' type='quantitative' />
            <column caption='Nps Promoters' datatype='real' datatype-customized='true' name='[nps_promoters]' role='measure' type='quantitative' />
            <column caption='Nps Responses' datatype='real' datatype-customized='true' name='[nps_responses]' role='measure' type='quantitative' />
            <column caption='Order Date' datatype='date' name='[order_date]' role='dimension' type='ordinal' />
