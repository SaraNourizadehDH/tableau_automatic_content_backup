      <aliases enabled='yes' />
      <column caption='% of Supermarket DMarts' datatype='real' name='[% of Dmarts with &gt;4000 SKUs (copy)_4589519930976272388]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_wh_with_6k])/SUM([total_warehouses])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0lwsv7w06sjdwb1g3oqo50rvp44w].[sum:gbv_gross_of_vat:qk]&quot;' value='Gross Purchase Value (GPV)' />
          <alias key='&quot;[federated.0lwsv7w06sjdwb1g3oqo50rvp44w].[sum:gbv_net_of_vat:qk]&quot;' value='GPV' />
          <alias key='&quot;[federated.0lwsv7w06sjdwb1g3oqo50rvp44w].[sum:total_item_level_discount:qk]&quot;' value='Promo GPV contribution' />
          <alias key='&quot;[federated.0lwsv7w06sjdwb1g3oqo50rvp44w].[sum:total_qty_delivered:qk]&quot;' value='Total Units Delivered' />
          <alias key='&quot;[federated.0lwsv7w06sjdwb1g3oqo50rvp44w].[usr:Calculation_3446379615107948545:qk]&quot;' value='Avg Listed SKUs per country' />
          <alias key='&quot;[federated.0lwsv7w06sjdwb1g3oqo50rvp44w].[usr:Calculation_3446379615231397899:qk]&quot;' value='Avg Listed SKUs' />
          <alias key='&quot;[federated.0lwsv7w06sjdwb1g3oqo50rvp44w].[usr:Calculation_3722577003726585857:qk]&quot;' value='Avg Listed SKUs per Entity' />
        </aliases>
      </column>
      <column caption='Avg Listed SKUs_Entity' datatype='real' name='[Calculation_3446379615107948545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([avg_listed_skus_entity])' />
      </column>
      <column caption='Avg Listed SKUs_region' datatype='real' name='[Calculation_3446379615108063234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([avg_listed_skus_region])' />
      </column>
      <column caption='Text' datatype='string' name='[Calculation_3446379615160098819]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot; &quot;' />
      </column>
      <column caption='Calculation1' datatype='string' name='[Calculation_3446379615161257988]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;KPI Definitions&#10;(All metrics involving currency are in EUR)&#10;&#10;&#10;&#10;Total Orders: Total orders placed&#10;&#10;GPV: Gross Purchase Value, which is Gross value of the products sold without considering vouchers or DF, but including VAT&#10;&#10;Qty delivered: Total quantity of items delivered in successful orders&#10;&#10;Orders per day per store: Total orders per store that were placed per day in the time frame selected&#10;&#10;Customers per Dmart: Total unique customers per Dmart in the time frame selected&#10;&#10;*Customer Frequency: Total Orders/Total Customers in the time frame selected. For Frequency, the minimum time period selected should be a month&#10;&#10;CVR (Dmart homepage to Transaction): Conversion rate i.e total number of sessions with transactions/total number of sessions&#10;&#10;After Order NPS: Net Promoter Score -- ((Number of Promoters) - (Number of Detractors))/Total number of responses&#10;&#10;ABV: Average Basket Value&#10;&#10;Items per basket: Number of items in a basket/order (on an average)&#10;&#10;Average price per item: Average value paid for an item by a customer&#10;&#10;Avg Listed SKUs: Average number of listed SKUs&#10;&#10;% of Dmarts with &gt;4000 listed SKUs: % of Dmarts out of total Dmarts which have more than or equal to 4000 listed SKUs&#10;&#10;% of Dmarts with &gt;6000 listed SKUs: % of Dmarts out of total Dmarts which have more than or equal to 6000 listed SKUs&#10;&#10;Availability: Total time a SKU is present for the customer to order/Total time a store is open&#10;&#10;UltraFresh GPV contribution: GPV contribution by UltraFresh categories - Produce, Ready to Consume and Meat/Seafood&#10;&#10;Fresh GPV contribution: GPV contribution by Fresh categories - Dairy / Chilled / Eggs, Bread / Bakery and Frozen&#10;&#10;Promo GPV contribution: GPV value from items with item price discount&#10;&#10;Content Score: Average of aggregated completeness and quality metrics score&#10;&#10;DF per order: Delivery fee revenue / total orders placed&#10;&#10;Nominal DF per order: Delivery fee revenue / total orders with delivery fee&#10;&#10;% of orders with FDF (Free Delivery Fee): % of total orders in which no delivery fee was charged&#10;&#10;DF per order/ABV: Delivery Fee per order/ Average Basket Value&#10;&#10;DF per order/ Food DF per order: Avg delivery fee in QCommerce / Avg food delivery fee (restaurant side)&#10;&#10;Front Margin: Sales (Total price paid per item including VAT) + Supplier funding - COGS (Cost of Goods Sold)&#10;&#10;Promo Funding %: Supplier promotion funding % -- Supplier Funding / Markdown*&#10;Markdown- Item price discount (before supplier funding) x Qty sold&#10;&#10;&#10;&quot;' />
      </column>
      <column caption='Calculation3' datatype='boolean' name='[Calculation_3446379615170662406]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[common_name] = [Parameters].[Parameter 1] OR [Parameters].[Parameter 1] = &quot;(All)&quot;' />
      </column>
      <column caption='Calculation4' datatype='real' name='[Calculation_3446379615170932743]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &quot;(All)&quot; then AVG([avg_listed_skus_region])&#10;ELSE&#10;AVG([avg_listed_skus_entity])&#10;END' />
      </column>
      <column caption='Calculation2' datatype='string' name='[Calculation_3446379615191810058]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Region&apos; then [region]&#10;ELSE&#10;[common_name]&#10;END' />
      </column>
      <column caption='Avg Listed SKUs_param' datatype='real' name='[Calculation_3446379615231397899]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Region&apos; then AVG([avg_listed_skus_region])&#10;ELSE&#10;AVG([avg_listed_skus_entity])&#10;END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_3567695390575980544]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] =  USERNAME()' />
      </column>
      <column caption='CVR' datatype='real' name='[Calculation_3722577003726245888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_transactions])/SUM([dmart_sessions])' />
      </column>
      <column caption='Avg Listed SKUs_MgmtEntity' datatype='real' name='[Calculation_3722577003726585857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([avg_listed_skus_mgmt])' />
      </column>
      <column caption='Supplier Funding %' datatype='real' name='[Calculation_3722577003729547266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([total_supplier_funding_eur])/SUM([markdown]))' />
      </column>
      <column caption='Avg Listed SKU' datatype='real' name='[Calculation_385057801983668224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_listed_skus_entity])/sum([warehouse_count])' />
      </column>
      <column caption='Content Score Management Entity' datatype='real' name='[Calculation_385057801984573441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([agg_content_score_mgmt])' />
      </column>
      <column caption='Content Score Country ' datatype='real' name='[Calculation_385057801985449986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([agg_content_score_country])' />
      </column>
      <column caption='Content Score Param' datatype='real' name='[Calculation_385057801985794051]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Region&apos; then [Content Score Country  (copy)_385057801985986564]&#13;&#10;ELSE&#13;&#10;[Calculation_385057801985449986]&#13;&#10;END' />
      </column>
      <column caption='ABV' datatype='real' name='[Calculation_4222054348818391041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gbv_gross_of_vat])/SUM([total_orders])' />
      </column>
      <column caption='Items per Basket' datatype='real' name='[Calculation_4222054348818554882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qty_delivered])/SUM([total_orders])' />
      </column>
      <column caption='Avg price per Item' datatype='real' name='[Calculation_4222054348818714627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gbv_gross_of_vat])/SUM([qty_delivered])' />
      </column>
      <column caption='Customers per Dmart' datatype='real' name='[Calculation_4222054348819439620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_customers])/[Calculation_4923349253592809477]' />
      </column>
      <column caption='DF per order' datatype='real' name='[Calculation_4222054348842369030]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_fee])/SUM([total_orders])' />
      </column>
      <column caption='% of orders with FDF' datatype='real' name='[Calculation_4222054348842524679]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([w_fdf_orders])/SUM([total_orders])' />
      </column>
      <column caption='DF per order/ABV' datatype='real' name='[Calculation_4222054348843204616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4222054348842369030]/[Calculation_4222054348818391041]' />
      </column>
      <column caption='Food DF per order' datatype='real' name='[Calculation_4222054348843913225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([food_delivery_fee])/SUM([food_orders])' />
      </column>
      <column caption='DF per order/ Food DF per order' datatype='real' name='[Calculation_4222054348844072970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4222054348842369030]/[Calculation_4222054348843913225]' />
      </column>
      <column caption='Front Margin' datatype='real' name='[Calculation_4222054348844752907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gbv_net_of_vat]) + SUM([total_supplier_funding_eur])-SUM([cogs])' />
      </column>
      <column caption='% of Convenience DMarts' datatype='real' name='[Calculation_4589519930973958147]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_wh_with_3k])/SUM([total_warehouses])' />
      </column>
      <column caption='Availability' datatype='real' name='[Calculation_4589519930976428037]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([available_instances])/SUM([total_instances])' />
      </column>
      <column caption='Ultrafresh GPV contribution' datatype='real' name='[Calculation_4589519930979512326]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ultrafresh_gbv_gross_of_vat])/SUM([gbv_gross_of_vat])' />
      </column>
      <column caption='Fresh GPV contribution' datatype='real' name='[Calculation_4589519930979692551]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fresh_gbv_gross_of_vat])/SUM([gbv_gross_of_vat])' />
      </column>
      <column caption='Customer Frequency*' datatype='real' name='[Calculation_4653696160399388672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_orders_monthly])/SUM([total_customers_monthly])' />
      </column>
      <column caption='Avg number of warehouses' datatype='real' name='[Calculation_4923349253592809477]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_warehouses])/COUNTD([order_date])' />
      </column>
      <column caption='Front margin as % of GPV' datatype='real' name='[Calculation_4923349253597609991]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4222054348844752907]/SUM([gbv_net_of_vat])' />
      </column>
      <column caption='Promo GPV Contribution %' datatype='real' name='[Calculation_4923349253656739848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([promo_gpv_contribution])/SUM([gbv_gross_of_vat])' />
      </column>
      <column caption='Orders per day per store' datatype='real' name='[Calculation_4923349253684215817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([total_orders])/COUNTD([order_date]))/[Calculation_4923349253592809477]' />
      </column>
      <column caption='After Order NPS' datatype='real' name='[Calculation_4923349253757902859]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM([nps_promoters])-SUM([nps_detractors]))/SUM([nps_responses]))*100' />
      </column>
      <column caption='Content Score' datatype='real' name='[Calculation_6382163689306484736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([agg_content_score])' />
      </column>
      <column caption='Management Entity_new' datatype='string' name='[Calculation_680113980050227200]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  ([management_entity] = &apos;DH Austria&apos; OR &#10;    [management_entity] = &apos;DH CEE&apos; OR &#10;    [management_entity] = &apos;DH Nordics&apos;)&#10;THEN &apos;Europe&apos;&#10;ELSE&#10;[management_entity]&#10;END' />
      </column>
      <column caption='Nominal DF' datatype='real' name='[Calculation_680113980140716033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_fee])/SUM([w_df_orders])' />
      </column>
      <column caption='Content Score Region' datatype='real' name='[Content Score Country  (copy)_385057801985986564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([agg_content_score_region])' />
      </column>
