      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:grocery_outlet_type:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;Convenience Store&quot;</bucket>
            </map>
            <map to='#59a14f'>
              <bucket>&quot;Small Grocery Store&quot;</bucket>
            </map>
            <map to='#76b7b2'>
              <bucket>&quot;Online Shopping&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;Hypermarket / Supermarket&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;Fresh Market&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
