      <column caption='max_app_del_time_adjusted' datatype='string' name='[Calculation_1920151931495145472]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [max_appropriate_delivery_time]&#10;    WHEN &apos;1 hour&apos; THEN &apos;60 minutes&apos;&#10;    WHEN &apos;1h10&apos; THEN &apos;70 minutes&apos;&#10;    WHEN &apos;1h20&apos; THEN &apos;80 minutes&apos;&#10;    WHEN &apos;1h30&apos; THEN &apos;90 minutes&apos;&#10;    WHEN &apos;1h40&apos; THEN &apos;100 minutes&apos;&#10;    WHEN &apos;1h50&apos; THEN &apos;110 minutes&apos;&#10;    ELSE [max_appropriate_delivery_time]&#10;END' />
