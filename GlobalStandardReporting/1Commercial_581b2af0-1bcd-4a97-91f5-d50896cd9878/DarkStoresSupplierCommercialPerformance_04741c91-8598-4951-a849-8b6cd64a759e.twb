      <aliases enabled='yes' />
      <column caption='Basket penetration' datatype='real' name='[Basket penetration old (copy)_3829748573254909967]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_orders])/(SUM([Total_Items_lod (copy)_3829748573252780045]))' />
      </column>
      <column caption='Date' datatype='date' default-format='*YYYY-MM-DD' name='[Calculation_3829748570854371330]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1], [date], &apos;monday&apos;))' />
      </column>
      <column caption='Est. Gross Margin' datatype='real' name='[Calculation_3829748570882674691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([amt_gmv_eur]-[amt_cogs_eur])/SUM([amt_gmv_eur])' />
      </column>
      <column caption='Shrinkage % of COGS' datatype='real' name='[Calculation_3829748571121598470]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([shrinkage_amt_eur])/SUM([amt_cogs_eur])' />
      </column>
      <column caption='Total_Items_lod' datatype='real' name='[Calculation_3829748571161243659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],[Calculation_3829748570854371330]: SUM([total_items])}' />
      </column>
      <column caption='Sell rate' datatype='real' name='[Calculation_3829748573248040972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_items])/SUM([Calculation_3829748571161243659])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_631348438168981504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Total_orders_lod ' datatype='integer' name='[Total_Items_lod (copy)_3829748573252780045]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],[Calculation_3829748570854371330]: SUM([total_orders])}' />
