      <column caption='Customer errors' datatype='string' name='[Calculation_2206130548223262720]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// A customer should not see more than six product recommendations&#10;IF &#10; { FIXED [external_id] : COUNT([product_name]) } &lt;&gt; 6 &#10;THEN &#10;[external_id] &#10;END' />
      </column>
      <column caption='Customer_product_timestamp' datatype='string' name='[Calculation_2206130548226220033]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//This calculation is to check if the same product is being recommended to a single customer more than once for the same time stamp&#10;&#10;IF&#10;{ FIXED [external_id],[product_name],[load_timestamp]: COUNT([product_name])}&gt;1&#10;THEN&#10;[external_id]&#10;END' />
