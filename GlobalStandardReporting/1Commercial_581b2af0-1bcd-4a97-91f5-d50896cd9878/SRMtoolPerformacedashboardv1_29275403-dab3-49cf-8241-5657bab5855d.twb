              <calculation class='tableau' formula='1-([accepted_without_commercial_terms]/[accepted_trading_agreements])' />
            </column>
            <column caption='%_trading_contracts_over_accepted_trading_opportunity' datatype='real' name='[Calculation_1376131186033143813]' role='measure' type='quantitative'>
