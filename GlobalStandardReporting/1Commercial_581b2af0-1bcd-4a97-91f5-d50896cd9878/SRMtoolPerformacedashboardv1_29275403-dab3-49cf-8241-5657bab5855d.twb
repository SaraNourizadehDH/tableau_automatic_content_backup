      </column>
      <column caption='Days since Last Modified' datatype='string' name='[Calculation_1376131186075553800]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(STR(DATEDIFF(&apos;day&apos;,[last_modified_date],TODAY())),&quot;Not Using Yet&quot;)' />
      </column>
      <column caption='Parameter_calc' datatype='integer' name='[Calculation_1376131186103128073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;prospect_accounts&apos; THEN [prospect_accounts]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;active_accounts&apos; THEN [active_accounts]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;inactive_accounts&apos; THEN [inactive_accounts]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;total_accounts&apos; THEN [total_accounts]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;total_suppliers_sup&apos; THEN [total_suppliers_sup]&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;acc_with_opportunity&apos; THEN [acc_with_opportunity]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;acc_with_contract&apos; THEN [acc_with_contract]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;accepted_trading_agreements&apos; THEN [accepted_trading_agreements]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;accepted_without_commercial_terms&apos; THEN [accepted_without_commercial_terms]&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;contractual_trading_opportunity&apos; THEN [contractual_trading_opportunity]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;nmr_trading_opportunities&apos; THEN [nmr_trading_opportunities]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;active_contracts&apos; THEN [active_contracts]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;inactive_contracts&apos; THEN [inactive_contracts]&#13;&#10;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;terminated_contracts&apos; THEN [terminated_contracts]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;draft_contracts&apos; THEN [draft_contracts]&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='accounts_delta%' datatype='real' name='[Calculation_1376131187448811530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([total_accounts_dl]-[initial_accounts])/[initial_accounts]' />
      </column>
      <column caption='Trading_Agreements_delta%' datatype='real' name='[Calculation_1376131187449147403]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([trading_agreements_dl] - [initial_trading_agreements])/[initial_trading_agreements]' />
      </column>
      <column caption='blank' datatype='string' name='[Calculation_1376131187477164044]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;&apos;' />
      </column>
