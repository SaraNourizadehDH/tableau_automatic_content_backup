    <worksheet name='Metric definition'>
      <table>
        <view>
          <datasources>
            <datasource caption='compensation_impact_experiment (rl)' name='federated.17yth810bgpil111fqo5a0a178pn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Measure Name' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Choose Metric&quot;'>
              <calculation class='tableau' formula='&quot;Choose Metric&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.17yth810bgpil111fqo5a0a178pn'>
            <column caption='Measure Name Desc' datatype='string' name='[Calculation_596234387493089280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Choose Metric&apos; THEN &apos;&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;# Actual Incremental Orders (8w)&apos; THEN &apos; (Cumulative Orders per Customer Test - Cumulative Orders per Customer Control) * Cohort Customers Test&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;# Forecasted Incremental Orders (44w)&apos; THEN &apos; Slope of Incremental Cumulative Orders * # Customers Test * 44&apos; + &apos;&#10;&apos; + &apos;Slope is calculated as difference between test and control at week 7 and week 5, divided by 2.&apos; + &apos;&#10;&apos; + &apos;44 is remainder of a year (56 weeks) minus 8 weeks of observation period.&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ Avg. Incremental GMV per Customer&apos; THEN &apos; (€ GMV Test / # Customers Test) - (€ GMV Control / # Customers Control)&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ Profit (Actuals)&apos; THEN &apos; € Avg. Incremental GMV per Customer * % Target Profit * # Customers Test&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ Profit (+ Forecast)&apos; THEN &apos; € Profit (Actuals) + # Forecasted Incremental Orders (44w) * Avg. Customer Order Value Test * Cohort Customers Test&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ Cost (Actuals)&apos; THEN &apos; Cost of redeemed compensation vouchers - (# Deflected Contacts Cost * Cost per Contact)&apos; +  &apos;&#10;&apos; + &apos;Deflection - estimation of how many contacts were avoided thanks to automated compensation; data is based on contact rate of control group.&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ Cost (+ Forecast)&apos; THEN &apos; Forecasted redemption costs + Forecasted deflection costs&apos; + &apos;&#10;&apos; + &apos;Redemption costs = Forecasted Test Orders * Issue rate * Redemption rate * Avg. comp value&apos; + &apos; &#10;&apos; +  &apos;Deflection costs = Forecasted Test Orders * Issue rate * (1-Automation Rate) * Comp contact rate * Cost per Contact&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ GMV (Actuals)&apos; THEN &apos; € Avg. Incremental GMV per Customer * # Cohort Customers Test&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ GMV (+ Forecast)&apos; THEN &apos; GMV (Actuals) + (Slope of Avg. Incremental GMV per Customer * # Customers Test * 44)&apos; + &apos;&#10;&apos; + &apos;Slope is calculated as difference between test and control GMV at week 7 and week 5, divided by 2.&apos; + &apos;&#10;&apos; + &apos;44 is remainder of a year (56 weeks) minus 8 weeks of observation period.&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Profit ROI&apos; THEN &apos; (€ Profit (+ Forecast) / € Costs (+ Forecast)) - 1&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;GMV ROI&apos; THEN &apos; (€ GMV (+ Forecast) / € Cost (+ Forecast)) - 1&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Result Relevance&apos; THEN &apos;Relevance is based on p-value from statistical test calculated on Cumulative Orders per Customer for both control and test group.&apos; + &apos;&#10;&apos; + &apos;If less than 0.05 then result is significant and difference in cumulative orders between the groups can be attributed to compensation.&apos;&#10;END' />
            </column>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[has_completed_observation_period]' role='dimension' type='nominal' />
            <column caption='Management Entity Group' datatype='string' name='[management_entity_group]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_596234387493089280]' derivation='None' name='[none:Calculation_596234387493089280:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[has_completed_observation_period]' derivation='None' name='[none:has_completed_observation_period:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity_group]' derivation='None' name='[none:management_entity_group:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <slices>
            <column>[federated.17yth810bgpil111fqo5a0a178pn].[none:global_entity_id:nk]</column>
            <column>[federated.17yth810bgpil111fqo5a0a178pn].[none:has_completed_observation_period:nk]</column>
            <column>[federated.17yth810bgpil111fqo5a0a178pn].[none:management_entity_group:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='header'>
            <format attr='width' field='[federated.17yth810bgpil111fqo5a0a178pn].[none:Calculation_596234387493089280:nk]' value='1380' />
            <format attr='border-width' data-class='total' value='0' />
            <format attr='border-style' data-class='total' value='none' />
            <format attr='border-width' data-class='subtotal' value='0' />
            <format attr='border-style' data-class='subtotal' value='none' />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-family' field='[federated.17yth810bgpil111fqo5a0a178pn].[none:Calculation_596234387493089280:nk]' value='Tableau Book' />
            <format attr='font-weight' field='[federated.17yth810bgpil111fqo5a0a178pn].[none:Calculation_596234387493089280:nk]' value='normal' />
          </style-rule>
          <style-rule element='pane'>
            <format attr='border-width' data-class='subtotal' value='0' />
            <format attr='border-style' data-class='subtotal' value='none' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='rows' value='false' />
          </style-rule>
          <style-rule element='table-div'>
            <format attr='stroke-size' scope='cols' value='0' />
            <format attr='stroke-size' scope='rows' value='0' />
            <format attr='line-visibility' scope='rows' value='off' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <mark-sizing mark-sizing-setting='marks-scaling-off' />
            <style>
              <style-rule element='mark'>
                <format attr='size' value='0.0099999997764825821' />
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-labels-show' value='false' />
                <format attr='mark-color' value='#ffffff' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.17yth810bgpil111fqo5a0a178pn].[none:Calculation_596234387493089280:nk]</rows>
        <cols />
      </table>
      <simple-id uuid='{08050706-20C1-474C-A19C-66255B895776}' />
    </worksheet>
    <worksheet name='ROI Components'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' italic='true'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='compensation_impact_experiment (rl)' name='federated.17yth810bgpil111fqo5a0a178pn' />
            <datasource caption='p-values (Order frequency p-values)' name='federated.0vzij7009bx5ui16t8d881bu1q34' />
            <datasource caption='cost_extrapolation_quarter' name='federated.02jw3b31iz2b6l1elf1yp06vukh3' />
          </datasources>
          <datasource-dependencies datasource='federated.02jw3b31iz2b6l1elf1yp06vukh3'>
            <column caption='€ Costs (+ Forecast)' datatype='real' name='[Calculation_596234387920470021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([total_redeemed_costs_with_extrapolation],0)' />
            </column>
            <column caption='Observation Redeemed Costs' datatype='real' name='[observation_redeemed_costs]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_596234387920470021]' derivation='Sum' name='[sum:Calculation_596234387920470021:qk]' pivot='key' type='quantitative' />
            <column-instance column='[observation_redeemed_costs]' derivation='Sum' name='[sum:observation_redeemed_costs:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_redeemed_costs_with_extrapolation]' derivation='Sum' name='[sum:total_redeemed_costs_with_extrapolation:qk]' pivot='key' type='quantitative' />
            <column caption='Total Redeemed Costs With Extrapolation' datatype='real' name='[total_redeemed_costs_with_extrapolation]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vzij7009bx5ui16t8d881bu1q34'>
            <column caption='Are results relevant?' datatype='boolean' name='[Calculation_509540143636279298]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [geid p-value] &lt; 0.05 THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='p-value' datatype='real' name='[geid p-value]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.17yth810bgpil111fqo5a0a178pn'>
            <column caption='# Forecasted GMV (44w) ' datatype='real' name='[# Forecasted Incremental Orders (44w) (copy)_529735972464226314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#10;([Cumulative Orders per Customer Difference Slope (copy)_529735972462563337]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;) &lt; 0&#10;THEN 0&#10;ELSE &#10;([Cumulative Orders per Customer Difference Slope (copy)_529735972462563337]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;)&#10;END' />
            </column>
            <column caption='# Cumulative Orders per Customer Checkpoint 2 Control' datatype='real' name='[# Order Frequency Checkpoint 1 Control (copy)_6631761597603303424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(If [Calculation_4562287192687501313] = &apos;control&apos; THEN [count_cumulative_orders_checkpoint_2] ELSE 0 END)&#10;/ SUM([Cohort Customers Test (copy)_3877247465256128516])' />
            </column>
            <column caption='# Cumulative Orders per Customer Checkpoint 2 Test' datatype='real' name='[# Order Frequency Checkpoint 1 Test (copy)_6631761597603311617]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(If [Calculation_4562287192687501313] = &apos;test&apos; THEN [count_cumulative_orders_checkpoint_2] ELSE 0 END)&#10;/ SUM([Cohort Customers (copy)_3877247465256046595])' />
            </column>
            <column caption='# Cumulative Orders per Customer Checkpoint 1 Test' datatype='real' name='[# Reorders Checkpoint 1 (copy)_3877247465283809293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(If [Calculation_4562287192687501313] = &apos;test&apos; THEN [count_cumulative_orders_checkpoint_1] ELSE 0 END)&#10;/ SUM([Cohort Customers (copy)_3877247465256046595])' />
            </column>
            <column caption='# Cumulative Orders per Customer Checkpoint 1 Control' datatype='real' name='[# Reorders Checkpoint 1 Test (copy)_3877247465283911694]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(If [Calculation_4562287192687501313] = &apos;control&apos; THEN [count_cumulative_orders_checkpoint_1] ELSE 0 END)&#10;/ SUM([Cohort Customers Test (copy)_3877247465256128516])' />
            </column>
            <column caption='€ Avg. Incremental GMV per Customer' datatype='real' name='[Avg. Incremental GMV (copy)_6631761599105007642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([€ GMV Observation Period (copy)_3877247465320390685]) / SUM([Cohort Customers (copy)_3877247465256046595]))&#10;- (SUM([€ GMV Observation Period Test (copy)_3877247465320497182]) / SUM([Cohort Customers Test (copy)_3877247465256128516]))' />
            </column>
            <column caption='# Reorders Observation Period Test' datatype='integer' name='[Calculation_3877247465255759873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_4562287192687501313] = &apos;test&apos; THEN [count_observation_period_cumulative_orders] ELSE 0 END' />
            </column>
            <column caption='# Cumulative Orders per Customer Test' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3877247465256202245]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3877247465255759873]) / SUM([Cohort Customers (copy)_3877247465256046595])' />
            </column>
            <column caption='# Actual Incremental Orders (8w)' datatype='real' name='[Calculation_3877247465256402951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_3877247465256202245] - [Order Frequency Test (copy)_3877247465256284166])&#10;* SUM([Cohort Customers (copy)_3877247465256046595])' />
            </column>
            <column caption='Checkpoint Difference Y2' datatype='real' name='[Calculation_3877247465290498066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Order Frequency Checkpoint 1 Test (copy)_6631761597603311617] - [# Order Frequency Checkpoint 1 Control (copy)_6631761597603303424]' />
            </column>
            <column caption='Cumulative Orders per Customer Difference Slope' datatype='real' name='[Calculation_3877247465291264020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_3877247465290498066] - [Checkpoint Difference Y2 (copy)_3877247465290649619]) / 2' />
            </column>
            <column caption='# Forecasted Incremental Orders (44w)' datatype='real' name='[Calculation_3877247465292410901]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#10;([Calculation_3877247465291264020]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;) &lt; 0&#10;THEN 0&#10;ELSE &#10;([Calculation_3877247465291264020]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;)&#10;END' />
            </column>
            <column caption='Customer Group (variant)' datatype='string' name='[Calculation_4562287192687501313]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF variant = &apos;A&apos; then &apos;test&apos;&#10;ELSEIF variant = &apos;B&apos; then &apos;control&apos;&#10;END' />
            </column>
            <column caption='GMV per customer Checkpoint 1 Control' datatype='real' name='[Calculation_529735972460728323]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(If [Calculation_4562287192687501313] = &apos;control&apos; THEN [sum_gmv_eur_incl_voucher_checkpoint_1] ELSE 0 END)&#10;/ SUM([Cohort Customers Test (copy)_3877247465256128516])' />
            </column>
            <column caption='Relevant &amp; Uplift' datatype='string' name='[Calculation_597571398341709825]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([federated.0vzij7009bx5ui16t8d881bu1q34].[Calculation_509540143636279298]) &#13;&#10;AND [Is Profit ROI positive (copy)_3633701256827301892] = TRUE THEN &apos;✅&apos; ELSE &apos;❌&apos; END' />
            </column>
            <column caption='GMV Checkpoint Difference Y1' datatype='real' name='[Checkpoint Difference Y1 (copy)_529735972462333959]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV per customer Checkpoint 1 Control (copy)_529735972460843012] - [Calculation_529735972460728323]' />
            </column>
            <column caption='Checkpoint Difference Y1' datatype='real' name='[Checkpoint Difference Y2 (copy)_3877247465290649619]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Reorders Checkpoint 1 (copy)_3877247465283809293] - [# Reorders Checkpoint 1 Test (copy)_3877247465283911694]' />
            </column>
            <column caption='Delta Cumulative Orders per Customer' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Checkpoints Delta OF (slope) (copy)_3633701256826572803]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3877247465256202245]-[Order Frequency Test (copy)_3877247465256284166]' />
            </column>
            <column caption='# Cohort Customers Test' datatype='integer' name='[Cohort Customers (copy)_3877247465256046595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_4562287192687501313] = &apos;test&apos; THEN [cohort_customers] ELSE 0 END' />
            </column>
            <column caption='# Cohort Customers Control' datatype='integer' name='[Cohort Customers Test (copy)_3877247465256128516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_4562287192687501313] = &apos;control&apos; THEN [cohort_customers] ELSE 0 END' />
            </column>
            <column caption='GMV per Customer Difference Slope' datatype='real' name='[Cumulative Orders per Customer Difference Slope (copy)_529735972462563337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([GMV Checkpoint Difference Y1 (copy)_529735972462485512] - [Checkpoint Difference Y1 (copy)_529735972462333959]) / 2' />
            </column>
            <column caption='GMV Checkpoint Difference Y2' datatype='real' name='[GMV Checkpoint Difference Y1 (copy)_529735972462485512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GMV per customer Checkpoint 1 Test (copy)_529735972462264326] - [GMV per customer Checkpoint 1 Control (copy)_529735972462202885]' />
            </column>
            <column caption='GMV ROI' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[GMV ROI (incl. Cost Extrapol., no deflection ) (copy)_529735972847210515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([€ Profit (incl. Extrapol.) (copy)_529735972448997376]&#10;/&#10;(&#10;SUM([federated.02jw3b31iz2b6l1elf1yp06vukh3].[total_redeemed_costs_with_extrapolation])&#10;)&#10;) - 1&#10;&#10;//SUM(([€ GMV Observation Period Test] - [€ GMV Observation Period Control])) &#10;// / SUM([compensation_cohort_analysis (rl_gcc_service)].[Count Redeemed Compensation Orders]) -1' />
            </column>
            <column caption='GMV per customer Checkpoint 1 Test' datatype='real' name='[GMV per customer Checkpoint 1 Control (copy)_529735972460843012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(If [Calculation_4562287192687501313] = &apos;test&apos; THEN [sum_gmv_eur_incl_voucher_checkpoint_1] ELSE 0 END)&#10;/ SUM([Cohort Customers (copy)_3877247465256046595])' />
            </column>
            <column caption='GMV per customer Checkpoint 2 Control' datatype='real' name='[GMV per customer Checkpoint 1 Control (copy)_529735972462202885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(If [Calculation_4562287192687501313] = &apos;control&apos; THEN [sum_gmv_eur_incl_voucher_checkpoint_2] ELSE 0 END)&#10;/ SUM([Cohort Customers Test (copy)_3877247465256128516])' />
            </column>
            <column caption='GMV per customer Checkpoint 2 Test' datatype='real' name='[GMV per customer Checkpoint 1 Test (copy)_529735972462264326]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(If [Calculation_4562287192687501313] = &apos;test&apos; THEN [sum_gmv_eur_incl_voucher_checkpoint_2] ELSE 0 END)&#10;/ SUM([Cohort Customers (copy)_3877247465256046595])' />
            </column>
            <column caption='Is Uplift Cumulative Orders per Customers positive' datatype='boolean' name='[Is Profit ROI positive (copy)_3633701256827301892]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Checkpoints Delta OF (slope) (copy)_3633701256826572803] &gt; 0 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='# Cumulative Orders per Customer Control' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Order Frequency Test (copy)_3877247465256284166]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Reorders Observation Period Test (copy)_3877247465255972866]) / SUM([Cohort Customers Test (copy)_3877247465256128516])' />
            </column>
            <column caption='# Reorders Observation Period Control' datatype='integer' name='[Reorders Observation Period Test (copy)_3877247465255972866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_4562287192687501313] = &apos;control&apos; THEN [count_observation_period_cumulative_orders] ELSE 0 END' />
            </column>
            <column caption='# Customers' datatype='integer' name='[cohort_customers]' role='measure' type='quantitative' />
            <column datatype='real' name='[count_cumulative_orders_checkpoint_1]' role='measure' type='quantitative' />
            <column datatype='real' name='[count_cumulative_orders_checkpoint_2]' role='measure' type='quantitative' />
            <column datatype='integer' name='[count_observation_period_cumulative_orders]' role='measure' type='quantitative' />
            <column caption='Customer Cohort' datatype='string' name='[customer_cohort]' role='dimension' type='nominal' />
