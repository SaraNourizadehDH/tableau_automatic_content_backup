            <remote-type>5</remote-type>
            <local-name>[sum_gmv_eur_incl_voucher_checkpoint_2]</local-name>
            <parent-name>[ab_compensation_impact_experiment_py_py]</parent-name>
            <remote-alias>sum_gmv_eur_incl_voucher_checkpoint_2</remote-alias>
            <local-type>real</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
            <cast-to-local-type>true</cast-to-local-type>
          </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
      <column caption='# Actual Incremental Orders (8w) GEID' datatype='real' name='[# Actual Incremental Orders (8w) (copy)_6631761597670416394]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED  [global_entity_id], [quarter] :&#10;([Calculation_3877247465256202245] - [Order Frequency Test (copy)_3877247465256284166])&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;}' />
      </column>
      <column caption='# Cumulative Orders per Customer Checkpoint 2' datatype='real' name='[# Cumulative Orders per Customer Checkpoint 1 (copy)_596234387502649346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_cumulative_orders_checkpoint_2])&#10;/ SUM([cohort_customers])' />
      </column>
      <column caption='# Cumulative Orders per Customer Checkpoint 1' datatype='real' name='[# Cumulative Orders per Customer Checkpoint 1 Test (copy)_596234387502551041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_cumulative_orders_checkpoint_1])&#10;/ SUM([cohort_customers])' />
      </column>
      <column caption='# Forecasted GMV (44w) ' datatype='real' name='[# Forecasted Incremental Orders (44w) (copy)_529735972464226314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF&#10;([Cumulative Orders per Customer Difference Slope (copy)_529735972462563337]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;) &lt; 0&#10;THEN 0&#10;ELSE &#10;([Cumulative Orders per Customer Difference Slope (copy)_529735972462563337]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;)&#10;END' />
      </column>
      <column caption='# Forecasted Incremental Orders (44w) GEID' datatype='real' name='[# Forecasted Incremental Orders (44w) (copy)_6631761597670592523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [quarter] :&#10;&#10;IF&#10;([Calculation_3877247465291264020]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;) &lt; 0&#10;THEN 0&#10;ELSE &#10;([Calculation_3877247465291264020]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;)&#10;END&#10;}' />
      </column>
      <column caption='# Cumulative Orders per Customer Checkpoint 2 Control' datatype='real' name='[# Order Frequency Checkpoint 1 Control (copy)_6631761597603303424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(If [Calculation_4562287192687501313] = &apos;control&apos; THEN [count_cumulative_orders_checkpoint_2] ELSE 0 END)&#10;/ SUM([Cohort Customers Test (copy)_3877247465256128516])' />
      </column>
      <column caption='# Cumulative Orders per Customer Checkpoint 2 Test' datatype='real' name='[# Order Frequency Checkpoint 1 Test (copy)_6631761597603311617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(If [Calculation_4562287192687501313] = &apos;test&apos; THEN [count_cumulative_orders_checkpoint_2] ELSE 0 END)&#10;/ SUM([Cohort Customers (copy)_3877247465256046595])' />
      </column>
      <column caption='# Reference Period Orders (1)' datatype='integer' name='[# Reference Period Orders (copy)_3133168370754293760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='# Cumulative Orders per Customer Checkpoint 1 Test' datatype='real' name='[# Reorders Checkpoint 1 (copy)_3877247465283809293]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(If [Calculation_4562287192687501313] = &apos;test&apos; THEN [count_cumulative_orders_checkpoint_1] ELSE 0 END)&#10;/ SUM([Cohort Customers (copy)_3877247465256046595])' />
      </column>
      <column caption='# Cumulative Orders per Customer Checkpoint 1 Control' datatype='real' name='[# Reorders Checkpoint 1 Test (copy)_3877247465283911694]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(If [Calculation_4562287192687501313] = &apos;control&apos; THEN [count_cumulative_orders_checkpoint_1] ELSE 0 END)&#10;/ SUM([Cohort Customers Test (copy)_3877247465256128516])' />
      </column>
      <column caption='# Reorders Checkpoint 2 Test' datatype='real' name='[# Reorders Checkpoint 2 (copy)_3877247465284001807]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(If [Calculation_4562287192687501313] = &apos;test&apos; THEN [count_cumulative_orders_checkpoint_2] ELSE 0 END)&#10;/ SUM([Cohort Customers (copy)_3877247465256046595])' />
      </column>
      <column caption='# Reorders Checkpoint 2 Control' datatype='real' name='[# Reorders Checkpoint 2 Test (copy)_3877247465284091920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(If [Calculation_4562287192687501313] = &apos;control&apos; THEN [count_cumulative_orders_checkpoint_2] ELSE 0 END)&#10;/ SUM([Cohort Customers Test (copy)_3877247465256128516])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0vzij7009bx5ui16t8d881bu1q34].[sum:geid p-value:qk]&quot;' value='p-value' />
          <alias key='&quot;[federated.17yth810bgpil111fqo5a0a178pn].[sum:\# Actual Incremental Orders (8w) (copy)_6631761597670416394:qk]&quot;' value='# Actual Incremental Orders (8w) ' />
          <alias key='&quot;[federated.17yth810bgpil111fqo5a0a178pn].[sum:\# Forecasted Incremental Orders (44w) (copy)_6631761597670592523:qk]&quot;' value='# Forecasted Incremental Orders (44w) ' />
          <alias key='&quot;[federated.17yth810bgpil111fqo5a0a178pn].[sum:sum_redeemed_comp_eur_observation_period:qk]&quot;' value='€ Cost (Observation Period)' />
          <alias key='&quot;[federated.17yth810bgpil111fqo5a0a178pn].[sum:sum_redeemed_comp_incl_deflection_eur_observation_period:qk]&quot;' value='€ Cost (Actuals) ' />
          <alias key='&quot;[federated.17yth810bgpil111fqo5a0a178pn].[usr:€ Avg. Order Value Test (copy)_529735972500033551:qk]&quot;' value='€ Avg. Order Value Test' />
          <alias key='&quot;[federated.17yth810bgpil111fqo5a0a178pn].[usr:Δ Avg. Order Value (copy)_529735972500377617:qk]&quot;' value='Δ Avg. Order Value' />
          <alias key='&quot;[federated.1ec0tdb0xuk2c813l8kwl03i71i0].[min:actuals_aov_l2m:qk]&quot;' value='€ Actuals AOV L2M' />
        </aliases>
      </column>
      <column caption='GMV ROI (incl. Profit Extrapol. only)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Add. GMV ROI (Marketing) (copy)_529735972452429826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[€ Profit (incl. Extrapol.) (copy)_529735972448997376]&#10;/SUM([sum_redeemed_comp_eur_observation_period])&#10;&#10;&#10;//SUM(([€ GMV Observation Period Test] - [€ GMV Observation Period Control])) &#10;// / SUM([compensation_cohort_analysis (rl_gcc_service)].[Count Redeemed Compensation Orders]) -1' />
      </column>
      <column caption='Avg. GMV per Customer Control' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Avg. GMV per Customer Test (copy)_3633701256832733193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([€ GMV Observation Period Test (copy)_3877247465320497182]) / SUM([Cohort Customers Test (copy)_3877247465256128516]))' />
      </column>
      <column caption='€ Avg. Incremental GMV per Customer' datatype='real' name='[Avg. Incremental GMV (copy)_6631761599105007642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([€ GMV Observation Period (copy)_3877247465320390685]) / SUM([Cohort Customers (copy)_3877247465256046595]))&#10;- (SUM([€ GMV Observation Period Test (copy)_3877247465320497182]) / SUM([Cohort Customers Test (copy)_3877247465256128516]))' />
      </column>
      <column caption='Avg. GMV per Customer Test' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Avg. Incremental GMV per Customer (copy)_3633701256832581640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([€ GMV Observation Period (copy)_3877247465320390685]) / SUM([Cohort Customers (copy)_3877247465256046595]))' />
      </column>
      <column caption='Δ Cumulative Orders Per Customer' datatype='real' name='[Calculation_289989660725477376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3877247465256202245] /&#10;[Order Frequency Test (copy)_3877247465256284166] - 1' />
      </column>
      <column caption='# Reorders Observation Period Test' datatype='integer' name='[Calculation_3877247465255759873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4562287192687501313] = &apos;test&apos; THEN [count_observation_period_cumulative_orders] ELSE 0 END' />
      </column>
      <column caption='# Cumulative Orders per Customer Test' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3877247465256202245]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3877247465255759873]) / SUM([Cohort Customers (copy)_3877247465256046595])' />
      </column>
      <column caption='# Actual Incremental Orders (8w)' datatype='real' name='[Calculation_3877247465256402951]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_3877247465256202245] - [Order Frequency Test (copy)_3877247465256284166])&#10;* SUM([Cohort Customers (copy)_3877247465256046595])' />
      </column>
      <column caption='Reorder Rate' datatype='real' name='[Calculation_3877247465257484298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reorder_customers]) / SUM([cohort_customers])' />
      </column>
      <column caption='€ GMV per Customer' datatype='real' name='[Calculation_3877247465257738251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_gmv_eur_incl_voucher_observation_period])/ SUM([cohort_customers])' />
      </column>
      <column caption='€ Avg. Order Value' datatype='real' name='[Calculation_3877247465257971724]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_gmv_eur_incl_voucher_observation_period]) / SUM([count_observation_period_cumulative_orders])' />
      </column>
      <column caption='Checkpoint Difference Y2' datatype='real' name='[Calculation_3877247465290498066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[# Order Frequency Checkpoint 1 Test (copy)_6631761597603311617] - [# Order Frequency Checkpoint 1 Control (copy)_6631761597603303424]' />
      </column>
      <column caption='Cumulative Orders per Customer Difference Slope' datatype='real' name='[Calculation_3877247465291264020]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_3877247465290498066] - [Checkpoint Difference Y2 (copy)_3877247465290649619]) / 2' />
      </column>
      <column caption='# Forecasted Incremental Orders (44w)' datatype='real' name='[Calculation_3877247465292410901]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF&#10;([Calculation_3877247465291264020]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;) &lt; 0&#10;THEN 0&#10;ELSE &#10;([Calculation_3877247465291264020]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;)&#10;END' />
      </column>
      <column caption='# Actual Test Orders (8w)' datatype='real' name='[Calculation_3877247465293217814]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3877247465256202245] * SUM([Cohort Customers (copy)_3877247465256046595])' />
      </column>
      <column caption='# Forecasted Test Orders (44w)' datatype='real' name='[Calculation_3877247465314074648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Order Frequency Difference Slope (copy)_3877247465313918999] * SUM([Cohort Customers (copy)_3877247465256046595]) * 44' />
      </column>
      <column caption='Delta Avg. GMV per Customer' datatype='real' default-format='c#,##0.0&quot; €&quot;;-#,##0.0&quot; €&quot;' name='[Calculation_3877247465320603679]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Avg. Incremental GMV per Customer (copy)_3633701256832581640]&#10;- [Avg. GMV per Customer Test (copy)_3633701256832733193]' />
      </column>
      <column caption='GMV ROI (Actuals)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3877247465320845344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[€ Profit (Actuals) (copy)_529735972449361921]&#10;/SUM([sum_redeemed_comp_eur_observation_period])&#10;&#10;&#10;//SUM(([€ GMV Observation Period Test] - [€ GMV Observation Period Control])) &#10;// / SUM([compensation_cohort_analysis (rl_gcc_service)].[Count Redeemed Compensation Orders]) -1' />
      </column>
      <column caption='Is Profit ROI positive' datatype='boolean' name='[Calculation_3877247465322987553]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Profit ROI (copy)_6631761597682597905] &gt; 0 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Customer Group (variant)' datatype='string' name='[Calculation_4562287192687501313]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF variant = &apos;A&apos; then &apos;test&apos;&#10;ELSEIF variant = &apos;B&apos; then &apos;control&apos;&#10;END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_525373095218610184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='GMV per customer Checkpoint 1 Control' datatype='real' name='[Calculation_529735972460728323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(If [Calculation_4562287192687501313] = &apos;control&apos; THEN [sum_gmv_eur_incl_voucher_checkpoint_1] ELSE 0 END)&#10;/ SUM([Cohort Customers Test (copy)_3877247465256128516])' />
      </column>
      <column caption='Forecasted orders * AOV' datatype='real' name='[Calculation_529735972464525325]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([# Forecasted Incremental Orders (44w) (copy)_6631761597670592523]) * [€ Avg. Order Value (copy)_6631761599114432543]' />
      </column>
      <column caption='Measure Name Desc' datatype='string' name='[Calculation_596234387493089280]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Choose Metric&apos; THEN &apos;&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;# Actual Incremental Orders (8w)&apos; THEN &apos; (Cumulative Orders per Customer Test - Cumulative Orders per Customer Control) * Cohort Customers Test&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;# Forecasted Incremental Orders (44w)&apos; THEN &apos; Slope of Incremental Cumulative Orders * # Customers Test * 44&apos; + &apos;&#10;&apos; + &apos;Slope is calculated as difference between test and control at week 7 and week 5, divided by 2.&apos; + &apos;&#10;&apos; + &apos;44 is remainder of a year (56 weeks) minus 8 weeks of observation period.&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ Avg. Incremental GMV per Customer&apos; THEN &apos; (€ GMV Test / # Customers Test) - (€ GMV Control / # Customers Control)&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ Profit (Actuals)&apos; THEN &apos; € Avg. Incremental GMV per Customer * % Target Profit * # Customers Test&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ Profit (+ Forecast)&apos; THEN &apos; € Profit (Actuals) + # Forecasted Incremental Orders (44w) * Avg. Customer Order Value Test * Cohort Customers Test&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ Cost (Actuals)&apos; THEN &apos; Cost of redeemed compensation vouchers - (# Deflected Contacts Cost * Cost per Contact)&apos; +  &apos;&#10;&apos; + &apos;Deflection - estimation of how many contacts were avoided thanks to automated compensation; data is based on contact rate of control group.&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ Cost (+ Forecast)&apos; THEN &apos; Forecasted redemption costs + Forecasted deflection costs&apos; + &apos;&#10;&apos; + &apos;Redemption costs = Forecasted Test Orders * Issue rate * Redemption rate * Avg. comp value&apos; + &apos; &#10;&apos; +  &apos;Deflection costs = Forecasted Test Orders * Issue rate * (1-Automation Rate) * Comp contact rate * Cost per Contact&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ GMV (Actuals)&apos; THEN &apos; € Avg. Incremental GMV per Customer * # Cohort Customers Test&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ GMV (+ Forecast)&apos; THEN &apos; GMV (Actuals) + (Slope of Avg. Incremental GMV per Customer * # Customers Test * 44)&apos; + &apos;&#10;&apos; + &apos;Slope is calculated as difference between test and control GMV at week 7 and week 5, divided by 2.&apos; + &apos;&#10;&apos; + &apos;44 is remainder of a year (56 weeks) minus 8 weeks of observation period.&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Profit ROI&apos; THEN &apos; (€ Profit (+ Forecast) / € Costs (+ Forecast)) - 1&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;GMV ROI&apos; THEN &apos; (€ GMV (+ Forecast) / € Cost (+ Forecast)) - 1&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Result Relevance&apos; THEN &apos;Relevance is based on p-value from statistical test calculated on Cumulative Orders per Customer for both control and test group.&apos; + &apos;&#10;&apos; + &apos;If less than 0.05 then result is significant and difference in cumulative orders between the groups can be attributed to compensation.&apos;&#10;END' />
      </column>
      <column caption='Is finished quarter?' datatype='boolean' name='[Calculation_596234389024452616]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [quarter] &lt; STR(YEAR(TODAY())) + &apos;-&apos; + STR(QUARTER(TODAY()))&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column aggregation='Sum' caption='Lightbulb' datatype='integer' name='[Calculation_596234389292191754]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Relevant &amp; Uplift' datatype='string' name='[Calculation_597571398341709825]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ATTR([federated.0vzij7009bx5ui16t8d881bu1q34].[Calculation_509540143636279298]) &#13;&#10;AND [Is Profit ROI positive (copy)_3633701256827301892] = TRUE THEN &apos;✅&apos; ELSE &apos;❌&apos; END' />
      </column>
      <column caption='Are results relevant?' datatype='string' name='[Calculation_597571398350688262]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ATTR([federated.0vzij7009bx5ui16t8d881bu1q34].[Calculation_509540143636279298]) THEN &apos;✅&apos; ELSE &apos;❌&apos; END' />
      </column>
      <column caption='Uplift' datatype='string' name='[Calculation_597571398350913543]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Is Profit ROI positive (copy)_3633701256827301892] = TRUE THEN &apos;✅&apos; ELSE &apos;❌&apos; END' />
      </column>
      <column caption='€  Target Profit (GPO) GEID' datatype='real' default-format='C1031%' name='[Calculation_6631761597666242567]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6631761597666430984] * [€ Avg. Order Value (copy)_6631761597665697798]' />
      </column>
      <column caption='% Target Profit' datatype='real' name='[Calculation_6631761597666430984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;  WHEN &apos;5%&apos;&#10;    THEN 0.05&#10;  WHEN &apos;6%&apos;&#10;    THEN 0.06&#10;  WHEN &apos;7%&apos;&#10;    THEN 0.07&#10;  WHEN &apos;8%&apos;&#10;    THEN 0.08&#10;  WHEN &apos;9%&apos;&#10;    THEN 0.09&#10;  WHEN &apos;10%&apos;&#10;    THEN 0.1&#10;&#10;END' />
      </column>
      <column caption='€ Profit (+ Forecast)' datatype='real' name='[Calculation_6631761597667368969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Incremental Orders Target Profit (copy)_6631761599112548382]&#10;&#10;&#10;+ IFNULL([Calculation_3877247465292410901],0) * [€ Avg. Order Value Test (copy)_529735972500033551] * [Calculation_6631761597666430984]' />
      </column>
      <column caption='€ Incremental Profit per Customer' datatype='real' default-format='C1031%' name='[Calculation_6631761599096475672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Avg. Incremental GMV (copy)_6631761599105007642]&#10; * [Calculation_6631761597666430984]' />
      </column>
      <column caption='temp incremental profit' datatype='real' name='[Calculation_6631761599100039193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IFNULL([# Actual Incremental Orders (8w) (copy)_6631761597670416394], 0))  * [Calculation_6631761597666242567]' />
      </column>
      <column caption='GMV Checkpoint Difference Y1' datatype='real' name='[Checkpoint Difference Y1 (copy)_529735972462333959]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GMV per customer Checkpoint 1 Control (copy)_529735972460843012] - [Calculation_529735972460728323]' />
      </column>
      <column caption='Checkpoint Difference Y1' datatype='real' name='[Checkpoint Difference Y2 (copy)_3877247465290649619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[# Reorders Checkpoint 1 (copy)_3877247465283809293] - [# Reorders Checkpoint 1 Test (copy)_3877247465283911694]' />
      </column>
      <column caption='Delta Cumulative Orders per Customer' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Checkpoints Delta OF (slope) (copy)_3633701256826572803]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3877247465256202245]-[Order Frequency Test (copy)_3877247465256284166]' />
      </column>
      <column caption='# Cohort Customers Test' datatype='integer' name='[Cohort Customers (copy)_3877247465256046595]' role='measure' type='quantitative'>
