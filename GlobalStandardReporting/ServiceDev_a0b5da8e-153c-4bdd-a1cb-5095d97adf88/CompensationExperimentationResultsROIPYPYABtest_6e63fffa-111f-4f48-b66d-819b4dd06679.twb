      <column caption='Cumulative KPI' datatype='string' name='[Cohort KPI (copy)_658370006830690307]' param-domain-type='list' role='measure' type='nominal' value='&quot;Avg. Orders per Customer&quot;'>
        <calculation class='tableau' formula='&quot;Avg. Orders per Customer&quot;' />
        <members>
          <member value='&quot;\# Reorders&quot;' />
          <member value='&quot;\# Seamless Orders&quot;' />
          <member value='&quot;\# Compensated Orders&quot;' />
          <member value='&quot;Avg. Orders per Customer&quot;' />
        </members>
      </column>
      <column caption='Cohort KPI' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Avg. Orders per Customer&quot;'>
        <calculation class='tableau' formula='&quot;Avg. Orders per Customer&quot;' />
        <members>
          <member value='&quot;\# Orders&quot;' />
          <member value='&quot;\# Customers with Orders&quot;' />
          <member value='&quot;Avg. Orders per Customer&quot;' />
          <member value='&quot;Avg. Order Value&quot;' />
          <member value='&quot;\% Seamless Orders&quot;' />
          <member value='&quot;\% Compensated Orders&quot;' />
          <member value='&quot;\# Compensated Orders&quot;' />
          <member value='&quot;\% Redemptions&quot;' />
        </members>
      </column>
      <column caption='Top N segments' datatype='integer' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='3'>
        <calculation class='tableau' formula='3' />
        <range max='12' min='1' />
      </column>
      <column caption='Target Profit' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;7\%&quot;'>
        <calculation class='tableau' formula='&quot;7%&quot;' />
        <members>
          <member value='&quot;4\%&quot;' />
          <member value='&quot;5\%&quot;' />
          <member value='&quot;6\%&quot;' />
          <member value='&quot;7\%&quot;' />
          <member value='&quot;8\%&quot;' />
          <member value='&quot;9\%&quot;' />
          <member value='&quot;10\%&quot;' />
        </members>
      </column>
      <column caption='Measure Name' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Choose Metric&quot;'>
        <calculation class='tableau' formula='&quot;Choose Metric&quot;' />
