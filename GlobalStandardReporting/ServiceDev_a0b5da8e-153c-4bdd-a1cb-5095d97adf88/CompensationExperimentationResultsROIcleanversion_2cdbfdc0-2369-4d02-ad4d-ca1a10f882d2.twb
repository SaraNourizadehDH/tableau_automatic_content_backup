      <column caption='# Cumulative Orders per Customer Checkpoint 2' datatype='real' name='[# Cumulative Orders per Customer Checkpoint 1 (copy)_596234387502649346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_cumulative_orders_checkpoint_2])&#10;/ SUM([cohort_customers])' />
      </column>
      <column caption='# Cumulative Orders per Customer Checkpoint 1' datatype='real' name='[# Cumulative Orders per Customer Checkpoint 1 Test (copy)_596234387502551041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_cumulative_orders_checkpoint_1])&#10;/ SUM([cohort_customers])' />
      </column>
      <column caption='# Forecasted GMV (44w) ' datatype='real' name='[# Forecasted Incremental Orders (44w) (copy)_529735972464226314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF&#10;([Cumulative Orders per Customer Difference Slope (copy)_529735972462563337]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;) &lt; 0&#10;THEN 0&#10;ELSE &#10;([Cumulative Orders per Customer Difference Slope (copy)_529735972462563337]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;)&#10;END' />
      </column>
      <column caption='# Forecasted Incremental Orders (44w) GEID' datatype='real' name='[# Forecasted Incremental Orders (44w) (copy)_6631761597670592523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [quarter] :&#10;&#10;IF&#10;([Calculation_3877247465291264020]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;) &lt; 0&#10;THEN 0&#10;ELSE &#10;([Calculation_3877247465291264020]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;)&#10;END&#10;}' />
      </column>
      <column caption='# Cumulative Orders per Customer Checkpoint 2 Control' datatype='real' name='[# Order Frequency Checkpoint 1 Control (copy)_6631761597603303424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(If [customer_group] = &apos;control&apos; THEN [count_cumulative_orders_checkpoint_2] ELSE 0 END)&#10;/ SUM([Cohort Customers Test (copy)_3877247465256128516])' />
      </column>
      <column caption='# Cumulative Orders per Customer Checkpoint 2 Test' datatype='real' name='[# Order Frequency Checkpoint 1 Test (copy)_6631761597603311617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(If [customer_group] = &apos;test&apos; THEN [count_cumulative_orders_checkpoint_2] ELSE 0 END)&#10;/ SUM([Cohort Customers (copy)_3877247465256046595])' />
      </column>
