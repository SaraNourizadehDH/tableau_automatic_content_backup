              <calculation class='tableau' formula='SUM(IF [customer_group] = &apos;test&apos; THEN [sum_customer_avg_order_value] END) / &#10;SUM(IF [customer_group] = &apos;test&apos; THEN [Cohort Customers (copy)_3877247465256046595] END)' />
