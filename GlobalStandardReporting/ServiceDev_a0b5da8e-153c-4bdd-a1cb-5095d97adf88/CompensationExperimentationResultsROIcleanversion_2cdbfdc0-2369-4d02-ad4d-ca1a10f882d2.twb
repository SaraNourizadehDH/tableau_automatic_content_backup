    <worksheet name='Metric definition'>
      <table>
        <view>
          <datasources>
            <datasource caption='compensation_impact_experiment (rl_gcc_service)' name='federated.17yth810bgpil111fqo5a0a178pn' />
            <datasource caption='compensation_cohort_analysis (rl_gcc_service)' name='federated.1pnqs9m1x802n111p06yr06100jr' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Measure Name' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Choose Metric&quot;'>
              <calculation class='tableau' formula='&quot;Choose Metric&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.17yth810bgpil111fqo5a0a178pn'>
            <column caption='Measure Name Desc' datatype='string' name='[Calculation_596234387493089280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Choose Metric&apos; THEN &apos;&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;# Actual Incremental Orders (8w)&apos; THEN &apos; (Cumulative Orders per Customer Test - Cumulative Orders per Customer Control) * Cohort Customers Test&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;# Forecasted Incremental Orders (44w)&apos; THEN &apos; Slope of Incremental Cumulative Orders * Cohort Customers Test * 44&apos; + &apos;&#10;&apos; + &apos;Slope is calculated as difference between test and control at week 7 and week 5, divided by 2.&apos; + &apos;&#10;&apos; + &apos;44 is remainder of a year (56 weeks) minus 8 weeks of observation period.&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ Avg. Incremental GMV per Customer&apos; THEN &apos; (€ GMV Test / Cohort Customers Test) - (€ GMV Control / Cohort Customers Control)&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ Profit (Actuals)&apos; THEN &apos; € Avg. Incremental GMV per Customer * % Target Profit * Cohort Customers Test&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ Profit (+ Forecast)&apos; THEN &apos; € Profit (Actuals) + # Forecasted Incremental Orders (44w) * Avg. Customer Order Value Test * Cohort Customers Test&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ Cost (Actuals)&apos; THEN &apos; Cost of redeemed compensation vouchers - (# Deflected Contacts Cost * Cost per Contact)&apos; +  &apos;&#10;&apos; + &apos;Deflection - estimation of how many contacts were avoided thanks to automated compensation; data is based on contact rate of control group.&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ Cost (+ Forecast)&apos; THEN &apos; Forecasted redemption costs + Forecasted deflection costs&apos; + &apos;&#10;&apos; + &apos;Redemption costs = Forecasted Test Orders * Issue rate * Redemption rate * Avg. comp value&apos; + &apos; &#10;&apos; +  &apos;Deflection costs = Forecasted Test Orders * Issue rate * (1-Automation Rate) * Comp contact rate * Cost per Contact&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ GMV (Actuals)&apos; THEN &apos; € Avg. Incremental GMV per Customer * # Cohort Customers Test&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;€ GMV (+ Forecast)&apos; THEN &apos; GMV (Actuals) + (Slope of Avg. Incremental GMV per Customer * Cohort Customers Test * 44)&apos; + &apos;&#10;&apos; + &apos;Slope is calculated as difference between test and control GMV at week 7 and week 5, divided by 2.&apos; + &apos;&#10;&apos; + &apos;44 is remainder of a year (56 weeks) minus 8 weeks of observation period.&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Profit ROI&apos; THEN &apos; (€ Profit (+ Forecast) / € Costs (+ Forecast)) - 1&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;GMV ROI&apos; THEN &apos; € GMV (+ Forecast) / € Cost (+ Forecast)&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;p-value&apos; THEN &apos; Ttest statistic calculated on Cumulative Orders per Customer for both control and test group.&apos; + &apos;&#10;&apos; + &apos;If less than 0.05 then result is significant and can be attributed to different treatments of the groups.&apos;&#10;END' />
            </column>
            <column caption='Is finished quarter?' datatype='boolean' name='[Calculation_596234389024452616]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [quarter] &lt; STR(YEAR(TODAY())) + &apos;-&apos; + STR(QUARTER(TODAY()))&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Customer Group' datatype='string' name='[customer_group]' role='dimension' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[has_completed_observation_period]' role='dimension' type='nominal' />
            <column caption='Management Entity Group' datatype='string' name='[management_entity_group]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_596234387493089280]' derivation='None' name='[none:Calculation_596234387493089280:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_596234389024452616]' derivation='None' name='[none:Calculation_596234389024452616:nk]' pivot='key' type='nominal' />
            <column-instance column='[customer_group]' derivation='None' name='[none:customer_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[has_completed_observation_period]' derivation='None' name='[none:has_completed_observation_period:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity_group]' derivation='None' name='[none:management_entity_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[policy]' derivation='None' name='[none:policy:nk]' pivot='key' type='nominal' />
            <column-instance column='[quarter]' derivation='None' name='[none:quarter:nk]' pivot='key' type='nominal' />
            <column-instance column='[treatment]' derivation='None' name='[none:treatment:nk]' pivot='key' type='nominal' />
            <column-instance column='[variant]' derivation='None' name='[none:variant:nk]' pivot='key' type='nominal' />
            <column caption='Policy' datatype='string' name='[policy]' role='dimension' type='nominal' />
