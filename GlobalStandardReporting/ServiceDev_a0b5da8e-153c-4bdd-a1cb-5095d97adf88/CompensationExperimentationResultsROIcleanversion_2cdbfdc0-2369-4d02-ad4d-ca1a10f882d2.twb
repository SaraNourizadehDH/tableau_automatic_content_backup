        <calculation class='tableau' formula='SUM(If [customer_group] = &apos;test&apos; THEN [count_cumulative_orders_checkpoint_1] ELSE 0 END)&#10;/ SUM([Cohort Customers (copy)_3877247465256046595])' />
      </column>
      <column caption='# Cumulative Orders per Customer Checkpoint 1 Control' datatype='real' name='[# Reorders Checkpoint 1 Test (copy)_3877247465283911694]' role='measure' type='quantitative'>
