      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0vzij7009bx5ui16t8d881bu1q34].[sum:geid p-value:qk]&quot;' value='p-value' />
          <alias key='&quot;[federated.17yth810bgpil111fqo5a0a178pn].[sum:\# Actual Incremental Orders (8w) (copy)_6631761597670416394:qk]&quot;' value='# Actual Incremental Orders (8w) ' />
          <alias key='&quot;[federated.17yth810bgpil111fqo5a0a178pn].[sum:\# Forecasted Incremental Orders (44w) (copy)_6631761597670592523:qk]&quot;' value='# Forecasted Incremental Orders (44w) ' />
          <alias key='&quot;[federated.17yth810bgpil111fqo5a0a178pn].[sum:sum_redeemed_comp_eur_observation_period:qk]&quot;' value='€ Cost (Observation Period)' />
          <alias key='&quot;[federated.17yth810bgpil111fqo5a0a178pn].[sum:sum_redeemed_comp_incl_deflection_eur_observation_period:qk]&quot;' value='€ Cost (Actuals) ' />
          <alias key='&quot;[federated.17yth810bgpil111fqo5a0a178pn].[usr:€ Avg. Order Value Test (copy)_529735972500033551:qk]&quot;' value='€ Avg. Order Value Test' />
          <alias key='&quot;[federated.17yth810bgpil111fqo5a0a178pn].[usr:Δ Avg. Order Value (copy)_529735972500377617:qk]&quot;' value='Δ Avg. Order Value' />
          <alias key='&quot;[federated.1ec0tdb0xuk2c813l8kwl03i71i0].[min:actuals_aov_l2m:qk]&quot;' value='€ Actuals AOV L2M' />
        </aliases>
