            <column caption='Count Customers' datatype='integer' name='[count_customers]' role='measure' type='quantitative' />
            <column caption='Count Redeemed Compensation Orders' datatype='integer' name='[count_redeemed_compensation_orders]' role='measure' type='quantitative' />
