      <aliases enabled='yes' />
      <column caption='% Redemptions' datatype='real' name='[% Seamless Orders (copy) (copy)_3892658213230592002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_redeemed_compensation_orders]) / SUM([count_compensated_orders]) * 100' />
      </column>
      <column caption='% Compensated Orders' datatype='real' name='[% Seamless Orders (copy)_3892658213230583809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_compensated_orders]) / SUM([Calculation_2250885042458046464]) * 100' />
      </column>
      <column caption='All Orders' datatype='integer' name='[Calculation_2250885042458046464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[count_reference_orders] + [count_reorders]' />
      </column>
      <column caption='Cohort KPI' datatype='real' name='[Calculation_2250885042458337281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;# Orders&apos; THEN SUM([Calculation_2250885042458046464])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;# Customers with Orders&apos; THEN SUM([count_customers])&#10;// ELSEIF [Parameters].[Cohort KPI] = &apos;Order Frequency&apos; THEN [Order Frequency to Date]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Avg. Order Value&apos;  THEN [Calculation_3892658213230350336]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% Seamless Orders&apos; THEN [Calculation_2250885042458853378]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% Compensated Orders&apos; THEN [% Seamless Orders (copy)_3892658213230583809]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;# Compensated Orders&apos; THEN SUM([count_compensated_orders])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% Redemptions&apos; THEN [% Seamless Orders (copy) (copy)_3892658213230592002]&#10;END' />
      </column>
      <column caption='% Seamless Orders' datatype='real' name='[Calculation_2250885042458853378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_seamless_orders]) / SUM([Calculation_2250885042458046464]) * 100' />
      </column>
      <column caption='Avg. Order Value' datatype='real' name='[Calculation_3892658213230350336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sum_gmv_eur]) / sum([Calculation_2250885042458046464])' />
      </column>
