  <worksheets>
    <worksheet name='Retention Crosstab'>
      <repository-location id='RetentionCrosstab' path='/t/GlobalStandardReporting/workbooks/30-dayRetentionbyOrderExperience' revision='' site='GlobalStandardReporting' />
      <layout-options>
        <caption>
          <formatted-text>
            <run fontname='Tableau Bold' fontsize='10'>% of orders with each type of experience that placed a future order within the next 30d.</run>
            <run>Æ&#10;</run>
            <run bold='true' italic='true'>Note</run>
            <run>:&#10;</run>
            <run italic='true'>a. A customer could be included multiple times within each month, and within each category within the month, depending on how many times they had that experience.</run>
            <run>Æ&#10;</run>
            <run italic='true'>b. Cancellations after 20 mins</run>
            <run>Æ&#10;</run>
            <run italic='true'>c. Delays &gt; 30 minutes</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='simple_retention_kpi (sandbox_ankur)' name='federated.06p48wl16qe2u31dmvt6f1ks2agy' />
          </datasources>
          <datasource-dependencies datasource='federated.06p48wl16qe2u31dmvt6f1ks2agy'>
            <column caption='Retention Rate' datatype='real' default-format='p0.0%' name='[Calculation_1710664200273399808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([retention_30d_orders]) / SUM([orders])' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Kpi Order Experience' datatype='string' name='[kpi_order_experience]' role='dimension' type='nominal' />
            <column caption='Management Entity Group' datatype='string' name='[management_entity_group]' role='dimension' type='nominal' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[kpi_order_experience]' derivation='None' name='[none:kpi_order_experience:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity_group]' derivation='None' name='[none:management_entity_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[month]' derivation='None' name='[none:month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[month]' derivation='None' name='[none:month:qk]' pivot='key' type='quantitative' />
            <column caption='Orders' datatype='integer' name='[orders]' role='measure' type='quantitative' />
