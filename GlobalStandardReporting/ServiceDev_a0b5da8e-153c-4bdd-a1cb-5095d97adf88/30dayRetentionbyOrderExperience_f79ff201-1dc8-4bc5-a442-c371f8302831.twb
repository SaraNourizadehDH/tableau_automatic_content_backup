      <column caption='LOD exclusions' datatype='boolean' name='[Calculation_1963428729587572737]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [management_entity_group], [country_name], [month] :&#10;    COUNTD(IF STARTSWITH([kpi_order_experience], &apos;Cancelled&apos;) THEN [kpi_order_experience] END)&#10;} = 2&#10;&#10;OR &#10;&#10;{ FIXED [management_entity_group], [country_name], [month] :&#10;    COUNTD(IF STARTSWITH([kpi_order_experience], &apos;Not On-time&apos;) THEN [kpi_order_experience] END)&#10;} = 2' />
