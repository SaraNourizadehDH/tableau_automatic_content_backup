            <column-instance column='[values_count_b]' derivation='Avg' name='[avg:values_count_b:qk]' pivot='key' type='quantitative' />
            <column caption='Experiment' datatype='string' name='[experiment]' role='dimension' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Group A' datatype='string' name='[group_a]' role='dimension' type='nominal' />
            <column caption='Group B' datatype='string' name='[group_b]' role='dimension' type='nominal' />
