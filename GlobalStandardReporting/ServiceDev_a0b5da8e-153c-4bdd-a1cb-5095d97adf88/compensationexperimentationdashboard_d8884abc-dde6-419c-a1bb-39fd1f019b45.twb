      <column caption='Difference Cumulative Orders B from A' datatype='real' default-format='p0%' name='[# Cumulative Orders Filtered Group B (copy)_711287298107424771]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(SUM(ZN([# Cumulative Orders (copy)_776308016669933569])) - SUM(ZN([# Cumulative Orders Filtered (copy)_711287298107015170])))/&#13;&#10;SUM([# Cumulative Orders (copy)_776308016669933569])' />
