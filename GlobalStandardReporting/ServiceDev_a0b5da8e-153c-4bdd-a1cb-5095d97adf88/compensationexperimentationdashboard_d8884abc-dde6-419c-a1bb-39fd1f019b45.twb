        <view>
          <datasources>
            <datasource caption='AB_testing_compensation' name='federated.01eyawl1c98a0v17hvkh70qeue7o' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Alpha' datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='0.05'>
              <calculation class='tableau' formula='0.05' />
              <range granularity='0.01' max='0.1' min='0.01' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.01eyawl1c98a0v17hvkh70qeue7o'>
            <column caption='Final P Value' datatype='real' name='[Calculation_1126533277014171648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[p_value]' />
            </column>
            <column caption='Significance Bottom Line' datatype='string' name='[Calculation_3751287402078126081]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF&#10;  (&#10;     (&#10;        [Calculation_1126533277014171648] &lt;= [Parameters].[Parameter 1]&#10;        AND&#10;        [anova_p_value] &lt;= [Parameters].[Parameter 1]&#10;     )&#10;      OR &#10;     (&#10;        [Calculation_1126533277014171648] &lt;= [Parameters].[Parameter 1]&#10;        AND&#10;        ISNULL([anova_p_value])&#10;     )&#10;  )&#10;THEN &quot;Statistically Significant&quot;&#10;ELSE &quot;Statistically Insignificant&quot;&#10;END' />
            </column>
            <column caption='Mean Delta %' datatype='real' name='[Calculation_917467696420880385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [group_a] &lt;&gt; [group_b] THEN 100*([mean_b]-[mean_a])/ABS([mean_a]) END' />
            </column>
            <column caption='Anova P Value' datatype='real' name='[anova_p_value]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_917467696420880385]' derivation='Avg' name='[avg:Calculation_917467696420880385:qk]' pivot='key' type='quantitative' />
            <column-instance column='[mean_a]' derivation='Avg' name='[avg:mean_a:qk]' pivot='key' type='quantitative' />
            <column-instance column='[mean_b]' derivation='Avg' name='[avg:mean_b:qk]' pivot='key' type='quantitative' />
