      <column caption='max_p_value' datatype='real' name='[Calculation_1362057445311889409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [corrected_p_value]&gt; [anova_p_value] THEN [corrected_p_value]&#13;&#10;ELSE [anova_p_value]&#13;&#10;END' />
      </column>
      <column caption='has_two_variants' datatype='boolean' name='[Calculation_1362057445312065538]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1362057445307449344] = 2 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Alpha Tooltip' datatype='string' name='[Calculation_265712398065946625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Alpha is the upper threshold of P-Value, above which the result is considered insignificant&quot;' />
      </column>
      <column caption='Avg Order Value' datatype='real' name='[Calculation_356628828440616960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_gmv_eur_incl_voucher_observation_period])/[Calculation_979814423483441152]' />
      </column>
      <column caption='Cohort date' datatype='date' name='[Calculation_367043401533747200]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(STR(INT(LEFT([customer_cohort], 4))) + &apos;-01-01&apos;) + ((INT(RIGHT([customer_cohort], 2))&#13;&#10; - 1) * 7)' />
      </column>
      <column caption='Significance Bottom Line' datatype='string' name='[Calculation_3751287402078126081]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF&#10;  (&#10;     (&#10;        [Calculation_1126533277014171648] &lt;= [Parameters].[Parameter 1]&#10;        AND&#10;        [anova_p_value] &lt;= [Parameters].[Parameter 1]&#10;     )&#10;      OR &#10;     (&#10;        [Calculation_1126533277014171648] &lt;= [Parameters].[Parameter 1]&#10;        AND&#10;        ISNULL([anova_p_value])&#10;     )&#10;  )&#10;THEN &quot;Statistically Significant&quot;&#10;ELSE &quot;Statistically Insignificant&quot;&#10;END' />
      </column>
      <column caption='Mean A Exists' datatype='boolean' name='[Calculation_796503826246000643]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([mean_a]) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Mean Delta %' datatype='real' name='[Calculation_917467696420880385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [group_a] &lt;&gt; [group_b] THEN 100*([mean_b]-[mean_a])/ABS([mean_a]) END' />
