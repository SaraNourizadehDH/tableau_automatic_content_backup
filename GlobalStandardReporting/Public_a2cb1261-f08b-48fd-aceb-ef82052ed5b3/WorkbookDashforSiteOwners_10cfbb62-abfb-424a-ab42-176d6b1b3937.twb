      <aliases enabled='yes' />
      <column caption='Workbook (Project)' datatype='string' name='[Calculation_112871508666691584]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[workbook_name] + &quot; (&quot; + [project_name] + &quot;)&quot;' />
      </column>
      <column caption='Num Projects' datatype='integer' name='[Calculation_2827345786300850178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([project_name])' />
      </column>
      <column caption='Report Updated' datatype='datetime' name='[Calculation_3367003685497888768]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX(report_updated_at_utc)' />
      </column>
      <column caption='% Failed Extracts' datatype='real' name='[Calculation_3680214953920262144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([num_jobs_failed])/sum([num_jobs])' />
      </column>
      <column caption='My Content' datatype='boolean' name='[Calculation_52495149194907648]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [workbook_owner_email]' />
      </column>
      <column caption='Server Load (s) per Pageview' datatype='real' name='[Calculation_6138758150009729024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_6836675375120752644]) * 7 * 60 / SUM([total_loads])' />
      </column>
      <column caption='Workbook Score' datatype='real' name='[Calculation_6836675375065501696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([num_views]-1) * 1)&#10;+ IF ISNULL([num_datasources]) THEN 50 ELSE (([num_datasources]-1) * 1) END&#10;+ ([workbook_size (copy)_6836675375068786689] / 5)&#10;+ (IFNULL([Total Extract Time 7d (m) (copy)_6836675376033095686], 0) * 10)&#10;+ (IFNULL([Total Subscription Time 7d (m) (copy)_6836675376033198087], 0) * 10)&#10;+ (IFNULL([median_elapsed_time_sec], 0))&#10;+ (IFNULL([Total Load Time 7d (s) (copy)_6836675375119286275], 0) * 10)&#10;+ (IFNULL([Total Filter Time 7d (m) (copy)_6836675376032768005], 0) * 10)' />
      </column>
      <column caption='Importance' datatype='string' name='[Calculation_6836675375070097410]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [distinct_users] &gt;= 201 THEN &quot;1. Extreme&quot;&#10;ELSEIF [distinct_users] &gt;= 51 THEN &quot;2. Very High&quot;&#10;ELSEIF [distinct_users] &gt;= 21 THEN &quot;3. High&quot;&#10;ELSEIF [distinct_users] &gt;= 6 THEN &quot;4. Medium&quot;&#10;ELSEIF [distinct_users] &gt;= 0 THEN &quot;5. Low&quot;&#10;ELSEIF ISNULL([distinct_users_30d]) THEN &quot;7. Zero&quot;&#10;ELSE &quot;6. Very Low&quot;&#10;END' />
      </column>
      <column caption='Total Server Load 1d (m)' datatype='real' name='[Calculation_6836675375120752644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Total Load Time 7d (s) (copy)_6836675375119286275], 0)&#10;+ IFNULL([Total Filter Time 7d (m) (copy)_6836675376032768005], 0)&#10;+ IFNULL([Total Extract Time 7d (m) (copy)_6836675376033095686], 0) &#10;+ IFNULL([Total Subscription Time 7d (m) (copy)_6836675376033198087], 0)' />
      </column>
      <column caption='Num. Workbooks' datatype='integer' name='[Calculation_6836675376084611081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Site: Project' datatype='string' name='[Calculation_6836675376141549578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[site_name] + &quot;: &quot; + [project_name]' />
      </column>
      <column caption='Total VizQL Load 1d (m)' datatype='real' name='[Calculation_6836675376142598155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Total Load Time 7d (s) (copy)_6836675375119286275], 0) + IFNULL([Total Filter Time 7d (m) (copy)_6836675376032768005], 0)' />
      </column>
      <column caption='VizQL Score' datatype='real' name='[Calculation_6836675376418742284]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_6836675376142598155]) / SUM(([total_loads] + IFNULL([total_filters], 0))/ 700)' />
      </column>
      <column caption='Owner ' datatype='string' name='[Owner (copy)_6836675376422760461]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[workbook_owner]' />
      </column>
      <column caption='Total Extract Time 1d (m)' datatype='real' name='[Total Extract Time 7d (m) (copy)_6836675376033095686]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[sum_extract_time] / 7' />
      </column>
      <column caption='Total Filter Time 1d (m)' datatype='real' name='[Total Filter Time 7d (m) (copy)_6836675376032768005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[sum_filter_time_sec] / 60 / 7' />
      </column>
      <column caption='Total Load Time 1d (m)' datatype='real' name='[Total Load Time 7d (s) (copy)_6836675375119286275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[sum_elapsed_time_sec] / 60 / 7' />
      </column>
      <column caption='Total Subscription Time 1d (m)' datatype='real' name='[Total Subscription Time 7d (m) (copy)_6836675376033198087]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[sum_subscription_time] / 7' />
      </column>
