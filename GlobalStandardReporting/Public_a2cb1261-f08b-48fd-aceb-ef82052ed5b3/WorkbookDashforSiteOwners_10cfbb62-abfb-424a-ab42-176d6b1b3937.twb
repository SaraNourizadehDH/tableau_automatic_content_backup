      <aliases enabled='yes' />
      <column caption='Data Export % Load' datatype='real' name='[Calculation_1346646702707556352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [action] = &quot;Data Export&quot; THEN [sum_elapsed_time_sec] END)&#10;/&#10;SUM([sum_elapsed_time_sec])' />
      </column>
      <column caption='Workbook CT' datatype='boolean' name='[Calculation_1836202075928104961]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4589308796876582917] &gt;= [Parameters].[Parameter 1]&#10;THEN TRUE ELSE FALSE&#10;END' />
      </column>
      <column caption='View Count' datatype='integer' name='[Calculation_1836202075938373634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([view_name])' />
      </column>
      <column caption='Row Count' datatype='real' name='[Calculation_1836202075967782915]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(WINDOW_SUM(AVG(1)))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg. Elapsed Time (s)' datatype='real' name='[Calculation_4589308794740207616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_elapsed_time_sec]) / SUM([count_requests])' />
      </column>
      <column caption='Total Data Exports' datatype='integer' name='[Calculation_4589308796783517698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [action] = &quot;Data Export&quot; THEN [count_requests] ELSE NULL END' />
      </column>
      <column caption='Project: Workbook: View' datatype='string' name='[Calculation_4589308796876054532]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[site_name] + &quot;: &quot; + [project_name] + &quot;: &quot; + [workbook_name] + &quot;: &quot; + [view_name]' />
      </column>
      <column caption='Avg. Load Time (s)' datatype='real' name='[Calculation_4589308796876582917]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_elapsed_time_sec]) / SUM([count_requests])' />
      </column>
      <column caption='Data Export % Requests' datatype='real' name='[Data Export % Load (copy)_1346646702708445185]' role='measure' type='quantitative'>
