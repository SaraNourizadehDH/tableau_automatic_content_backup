              </zone>
              <zone fixed-size='242' h='10000' id='7' is-fixed='true' is-scaled='1' param='Image/DH_Fintech_Full_RGB.png' type-v2='bitmap' w='17857' x='81572' y='800'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
