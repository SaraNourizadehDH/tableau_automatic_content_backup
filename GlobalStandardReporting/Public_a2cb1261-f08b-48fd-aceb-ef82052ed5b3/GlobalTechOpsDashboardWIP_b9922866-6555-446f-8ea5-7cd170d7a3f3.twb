      <column caption='is Highlight Period Selected' datatype='boolean' name='[Calculation_138696862754549762]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//DATETRUNC([Show date as],[Highlight Period])=DATETRUNC([Show date as],[Date.Month])&#10;//removed above to add start/end date picker&#10;[Parameters].[Parameter 6] &lt;= DATE([date])&#10;AND&#10;[Parameters].[Parameter 7] &gt;= DATE([date])' />
      </column>
      <column caption='Tech Cost / Orders' datatype='real' default-format='c#,##0.0000&quot; €&quot;;-#,##0.0000&quot; €&quot;' name='[Calculation_138696862786531370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_cost_eur])/SUM([federated.1bfs7rw1yn2t9n19pl5dx1xrqcme].[order_cnt])' />
      </column>
      <column caption='Date.Month' datatype='datetime' name='[Calculation_138696862791381035]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[date])' />
      </column>
      <column caption='Tech Costs.selecMonth' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Calculation_138696862792658989]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_138696862754549762],[total_cost_eur],Null)' />
      </column>
      <column caption='Tech Costs.diff' datatype='real' default-format='*↗ 0.0%;↘ -0.0%' name='[Calculation_138696862792818735]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_138696862792658989])/SUM([Tech Costs.selecMonth (copy)_138696862792753198])-1' />
      </column>
      <column caption='Tech Cost / Orders.diff' datatype='real' default-format='*↗ 0.0%;↘ -0.0%' name='[Calculation_138696862795272243]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Tech Cost / Orders (copy)_138696862794813488]/[Tech Cost / Orders.selectMonth (copy)_138696862795067442])-1' />
      </column>
      <column caption='Fintech Tribe.main-filter' datatype='boolean' name='[Calculation_182677260892385280]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF( [Parameters].[Parameter 4]=&apos;all&apos;,TRUE,&#10;(CASE [Parameters].[Parameter 4]&#10;WHEN &apos;pay&apos;      THEN &apos;Payments&apos;&#10;WHEN &apos;wal&apos;      THEN &apos;Wallet&apos;&#10;WHEN &apos;risk&apos;     THEN &apos;Risk&apos;&#10;WHEN &apos;found&apos;     THEN &apos;Foundation&apos;&#10;END) = [Calculation_3578461794011967488] )' />
      </column>
      <column caption='Cloud Costs breakdown' datatype='string' hidden='true' name='[Calculation_273453000721653760]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;provider&apos; THEN [cloud_provider]&#10;    WHEN &apos;cost_center&apos; THEN [Cost Center Name (group)]&#10;    WHEN &apos;squad&apos; THEN [dh_squad]&#10;    WHEN &apos;tribe&apos; THEN [dh_tribe]&#10;    WHEN &apos;region&apos; THEN [service]&#10;ELSE &apos;Total&apos;&#10;END' />
      </column>
      <column caption='Date.Timeframe' datatype='string' datatype-customized='true' hidden='true' name='[Calculation_273453000763768833]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;day&apos; THEN STR([date])&#10;WHEN &apos;week&apos; THEN STR(YEAR([date]))+&apos; W&apos;+ STR(WEEK([date]))&#10;WHEN &apos;month&apos; THEN LEFT(DATENAME(&apos;month&apos;, [date]),3) + &apos; &apos; + STR(YEAR([date]))&#10;WHEN &apos;quarter&apos; THEN STR(YEAR([date]))+&apos; Q&apos;+STR(QUARTER([date])) &#10;WHEN &apos;year&apos; THEN STR(YEAR([date]))&#10;ELSE NULL END' />
      </column>
      <column caption='Date.MAX' datatype='date' name='[Calculation_273453000766267396]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX([date])}' />
      </column>
      <column caption='Date.MAX-30' datatype='datetime' datatype-customized='true' name='[Calculation_273453000766369797]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX(DATEADD(&apos;day&apos;,-30,[date]))}' />
      </column>
      <column caption='Fintech Tribe.v2' datatype='string' name='[Calculation_3578461794011967488]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([dh_tribe]), &apos;payment&apos;)       THEN &apos;Payments&apos;&#10;ELSEIF CONTAINS(LOWER([dh_tribe]), &apos;wallet&apos;)&#10;    OR CONTAINS(LOWER([dh_tribe]), &apos;financial-services&apos;) &#10;    OR STARTSWITH(LOWER([dh_tribe]), &apos;fs&apos;)     &#10;        THEN &apos;Wallet&apos;&#10;ELSEIF CONTAINS(LOWER([dh_tribe]), &apos;risk&apos;)&#10;    OR CONTAINS(LOWER([dh_tribe]), &apos;fraud&apos;)&#10;         THEN &apos;Risk&apos;&#10;ELSEIF CONTAINS(LOWER([dh_tribe]), &apos;foundation&apos;) &#10;    OR LOWER([dh_tribe]) = &apos;security&apos;   THEN &apos;Foundation&apos;&#10;ELSEIF LOWER([dh_tribe])= &apos;data&apos; THEN &apos;Data&apos;&#10;ELSE &apos;Other&apos;&#10;END' />
      </column>
      <column caption='is_period_filtered' datatype='boolean' name='[Calculation_4483826016802291714]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3] &lt;= DATE([date])&#10;AND&#10;[Parameters].[Cloud Costs.Start (copy)_273453000766210051] &gt;= DATE([date])' />
      </column>
      <column caption='Date_dynamic' datatype='date' datatype-customized='true' name='[Calculation_509891929141489666]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 5],[date]))' />
      </column>
      <column caption='Highlight.reference' datatype='date' datatype-customized='true' name='[Calculation_509891929142587395]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 5],[Parameters].[Start Date.Month Parameter]))' />
      </column>
      <column caption='Highlight.period.label' datatype='string' name='[Calculation_509891929148559365]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;month&apos; THEN&#10;LEFT(DATENAME(&apos;month&apos;,[Parameters].[Start Date.Month Parameter]),3) +&apos; &apos;+ DATENAME(&apos;year&apos;,[Parameters].[Start Date.Month Parameter])&#10;ELSE&#10;&apos;Q&apos;+DATENAME(&apos;quarter&apos;,[Parameters].[Start Date.Month Parameter]) +&apos;-&apos;+ DATENAME(&apos;year&apos;,[Parameters].[Start Date.Month Parameter])&#10;END' />
      </column>
      <column caption='Squad label' datatype='string' name='[Calculation_656329281519779840]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;all&apos; THEN [Calculation_656329281520119809]&#10;ELSE [dh_squad]&#10;END' />
      </column>
      <column caption='Fintech Tribe and Squad' datatype='string' name='[Calculation_656329281520119809]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;(&apos;+[Calculation_3578461794011967488]+&apos;) &apos;+[dh_squad]' />
      </column>
      <column datatype='string' name='[Cost Center Name (group)]' role='dimension' type='nominal'>
