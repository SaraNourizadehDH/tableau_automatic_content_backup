    <worksheet name='jira.ratio'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#d65f41'>■ Resolved</run>
            <run fontcolor='#32a8a3'>Æ </run>
            <run>x ■ Created</run>
            <run fontcolor='#dead37'>Æ </run>
            <run fontcolor='#555555'>tickets ratio</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='jira_tickets_scaffolded (Multiple Connections)' name='federated.0ru41091yu6e5g1h32l0n1tftstf' />
            <datasource caption='jira_tickets (rl_fintech)' name='federated.0ueyzyw1q025on126d23o0w62cek' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='All' caption='Fintech Tribe selector' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;all&quot;'>
              <calculation class='tableau' formula='&quot;all&quot;' />
              <aliases>
                <alias key='&quot;all&quot;' value='All' />
                <alias key='&quot;pay&quot;' value='Payments' />
                <alias key='&quot;risk&quot;' value='Risk' />
                <alias key='&quot;wal&quot;' value='Wallet' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ru41091yu6e5g1h32l0n1tftstf'>
            <column caption='Fintech Tribe.main-filter' datatype='boolean' name='[Calculation_182677260892385280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF( [Parameters].[Parameter 4]=&apos;all&apos;,TRUE,&#10;(CASE [Parameters].[Parameter 4]&#10;WHEN &apos;pay&apos;      THEN &apos;Fintech / Payments&apos;&#10;WHEN &apos;wal&apos;      THEN &apos;Fintech / Wallet&apos;&#10;WHEN &apos;risk&apos;     THEN &apos;Fintech / Risk&apos;&#10;WHEN &apos;found&apos;     THEN &apos;Fintech / Foundation&apos;&#10;END) = [project_category_name] )' />
            </column>
            <column caption='Tickets.Created' datatype='integer' name='[Calculation_6526771395475959824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;//IF DATETRUNC(&apos;month&apos;, [Created At]) = DATETRUNC(&apos;month&apos;, [Scaffold Date])&#10;IF DATETRUNC(&apos;month&apos;, [created_at]) = DATETRUNC(&apos;month&apos;, [scaffold_date])&#10;THEN [ticket_id]&#10;END&#10;)' />
            </column>
            <column caption='Tickets.Ratio' datatype='real' default-format='p0.0%' name='[Calculation_6526771395478016020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Tickets.Created (copy)_6526771395476090897]/[Calculation_6526771395475959824]' />
            </column>
            <column caption='Tickets.Done' datatype='integer' name='[Tickets.Created (copy)_6526771395476090897]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;//IF DATETRUNC(&apos;month&apos;, [Done At]) = DATETRUNC(&apos;month&apos;, [Scaffold Date])&#10;IF DATETRUNC(&apos;month&apos;, [done_at]) = DATETRUNC(&apos;month&apos;, [scaffold_date])&#10;THEN [ticket_id]&#10;END&#10;)' />
            </column>
            <column caption='Created At' datatype='date' datatype-customized='true' name='[created_at]' role='dimension' type='ordinal' />
            <column caption='Done At' datatype='date' datatype-customized='true' name='[done_at]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_182677260892385280]' derivation='None' name='[none:Calculation_182677260892385280:nk]' pivot='key' type='nominal' />
            <column-instance column='[project_category_name]' derivation='None' name='[none:project_category_name:nk]' pivot='key' type='nominal' />
