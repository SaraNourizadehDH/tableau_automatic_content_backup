      <column caption='Cycle Time Hours.diff' datatype='real' default-format='*↗ 0.0%;↘ -0.0%' name='[Code Review Hours.diff (copy)_1652609990204071946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Code Review Hours.selectedPeriod (copy)_1652609990203731975])/AVG([Cycle Time Hous.selectedPeriod (copy)_1652609990203817992])-1' />
