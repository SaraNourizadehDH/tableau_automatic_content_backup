        <exclude-sheet name='main.Incidents.loss' />
        <exclude-sheet name='main.Incidents.retention%.line' />
        <exclude-sheet name='main.Incidents.cfr.line' />
        <exclude-sheet name='main.Incidents.line' />
        <exclude-sheet name='main.Incidents.Financial.line' />
        <exclude-sheet name='main.Incidents.Financial' />
        <exclude-sheet name='main.Incidents.count' />
        <exclude-sheet name='main.Incidents.mttm.line' />
        <exclude-sheet name='main.Incidents.cfr' />
        <exclude-sheet name='main.Incidents.mttm' />
        <exclude-sheet name='main.Incidents.mttd' />
        <exclude-sheet name='main.Incidents.acknowledge' />
      </source>
      <link caption='PostMortem URL' expression='&lt;[postmortem_url]&gt;' />
    </action>
    <action caption='OpsGenie Period Filter' name='[Action2_04E7B038663E433298F64AAF8FA68E72]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Alerting Insights' type='sheet' worksheet='alerts.trends' />
      <link caption='OpsGenie Period Filter' delimiter=',' escape='\' expression='tsl:Alerting%20Insights?%5Bfederated.0ofxk4q1qjdj6f1e8tl181sc3b78%5D.%5BCalculation_1951254926679523329%5D~s0=&lt;[federated.0ofxk4q1qjdj6f1e8tl181sc3b78].[Calculation_1951254926679523329]~na&gt;' include-null='true' multi-select='true' url-escape='true' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='alerts.trends' />
        <param name='single-select' value='' />
        <param name='target' value='Alerting Insights' />
      </command>
    </action>
    <action caption='Go to alert in Grafana' name='[Action3_00740AFF9AFD41F6AAE4FF9577AC4D44]'>
      <source dashboard='Alerting Insights' type='sheet' worksheet='alerts.ranking' />
      <link caption='Go to alert in Grafana' expression='https://deliveryhero.grafana.net/alerting/list?search=&lt;[alertname]&gt;' />
    </action>
    <datasources>
      <datasource caption='tech_ops_incidents_mock_v2 (rl_fintech)' name='federated.06mchdb0x5mg2619ftxbk0q7r2hp' />
