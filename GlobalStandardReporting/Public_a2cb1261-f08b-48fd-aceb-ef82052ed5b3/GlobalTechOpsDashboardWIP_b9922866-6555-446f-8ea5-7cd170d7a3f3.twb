          <datasource-dependencies datasource='Parameters'>
            <column alias='Month' caption='Show trends' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
