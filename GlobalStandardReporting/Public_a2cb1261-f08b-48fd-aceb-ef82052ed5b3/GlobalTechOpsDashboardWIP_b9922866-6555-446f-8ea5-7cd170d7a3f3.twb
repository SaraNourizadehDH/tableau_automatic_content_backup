            </column>
            <column caption='Fintech Tribe' datatype='string' name='[Calculation_138696862771896344]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STARTSWITH([squad],&apos;Payment&apos;) THEN &apos;Payments&apos;&#10;ELSEIF STARTSWITH([squad],&apos;Wallet&apos;) THEN &apos;Wallet&apos;&#10;ELSEIF STARTSWITH([squad],&apos;Risk&apos;) THEN &apos;Risk&apos;&#10;ELSEIF ISNULL([squad]) AND CONTAINS(LOWER([cause]),&apos;third party&apos;) THEN &apos;Payments&apos;&#10;ELSE &apos;Other&apos;&#10;END' />
            </column>
            <column caption='is_failure_cause' datatype='boolean' name='[Calculation_2845782410158936065]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='REPLACE( LOWER( [cause] ),&apos; &apos;,&apos;&apos; ) &#10;IN (&#10;    &apos;rolloutmistake&apos;, &#10;    &apos;humanerror&apos;, &#10;    &apos;featurebug&apos;, &#10;    &apos;misconfiguration&apos;, &#10;    &apos;migration&apos;, &#10;    &apos;softwareupdates&apos;&#10;)' />
            </column>
            <column caption='CFR' datatype='real' default-format='p0.00%' name='[Calculation_2845782410165309448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_2845782410158936065],1,0))/SUM([federated.0kplv1v0wr9l2a132pm4o1qh4vrn].[deployment_counts])' />
            </column>
