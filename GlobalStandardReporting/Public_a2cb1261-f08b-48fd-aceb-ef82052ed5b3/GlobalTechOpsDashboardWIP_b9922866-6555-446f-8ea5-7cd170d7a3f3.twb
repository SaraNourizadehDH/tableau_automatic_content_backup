    <worksheet name='main.Incidents.cfr'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Change Failure Rate&#10;</run>
            <run fontcolor='#555555' fontname='Tableau Book' fontsize='9'>Only on Tribe level</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tech_ops_incidents_mock_v2 (rl_fintech)' name='federated.06mchdb0x5mg2619ftxbk0q7r2hp' />
            <datasource caption='fintech_deployments (rl_fintech)' name='federated.0kplv1v0wr9l2a132pm4o1qh4vrn' />
            <datasource caption='tech_ops_orders_mock (rl_fintech)' name='federated.1bfs7rw1yn2t9n19pl5dx1xrqcme' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='All' caption='Fintech Tribe selector' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;all&quot;'>
              <calculation class='tableau' formula='&quot;all&quot;' />
              <aliases>
                <alias key='&quot;all&quot;' value='All' />
                <alias key='&quot;pay&quot;' value='Payments' />
                <alias key='&quot;risk&quot;' value='Risk' />
                <alias key='&quot;wal&quot;' value='Wallet' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1bfs7rw1yn2t9n19pl5dx1xrqcme].[_yesterday (copy)_590745647978397697]' caption='Main.Start Date' datatype='date' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1bfs7rw1yn2t9n19pl5dx1xrqcme].[Calculation_590745647978233856]' caption='Main.End Date' datatype='date' name='[Parameter 7]' param-domain-type='any' role='measure' type='quantitative' value='#2025-08-21#'>
              <calculation class='tableau' formula='#2025-08-21#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06mchdb0x5mg2619ftxbk0q7r2hp'>
            <column caption='CFR.previous Month' datatype='real' default-format='p0.00%' name='[CFR.selected Month (copy)_2845782410164060166]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Incidents.CFR.selected Month (copy)_2845782410161340420])/SUM([federated.0kplv1v0wr9l2a132pm4o1qh4vrn].[Deployment Counts.selected Period (copy)_1439463056654057478])' />
            </column>
            <column caption='is Selected Period' datatype='boolean' name='[Calculation_138696862754549762]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATETRUNC([Show date as], [Highlight Period])=DATETRUNC([Show date as], [Start Date.Month])&#10;&#10;[Parameters].[Parameter 6] &lt;= DATE([occurrence_time])&#10;AND&#10;[Parameters].[Parameter 7] &gt;= DATE([occurrence_time])' />
            </column>
            <column caption='Fintech Tribe' datatype='string' name='[Calculation_138696862771896344]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STARTSWITH([squad],&apos;Payment&apos;) THEN &apos;Payments&apos;&#10;ELSEIF STARTSWITH([squad],&apos;Wallet&apos;) THEN &apos;Wallet&apos;&#10;ELSEIF STARTSWITH([squad],&apos;Risk&apos;) THEN &apos;Risk&apos;&#10;ELSEIF ISNULL([squad]) AND CONTAINS(LOWER([cause]),&apos;third party&apos;) THEN &apos;Payments&apos;&#10;ELSE &apos;Other&apos;&#10;END' />
            </column>
            <column caption='is_failure_cause' datatype='boolean' name='[Calculation_2845782410158936065]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='REPLACE( LOWER( [cause] ),&apos; &apos;,&apos;&apos; ) &#10;IN (&#10;    &apos;rolloutmistake&apos;, &#10;    &apos;humanerror&apos;, &#10;    &apos;featurebug&apos;, &#10;    &apos;misconfiguration&apos;, &#10;    &apos;migration&apos;, &#10;    &apos;softwareupdates&apos;&#10;)' />
            </column>
            <column caption='CFR.selected Month' datatype='real' default-format='p0.00%' name='[Calculation_2845782410163892229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([Incidents.selected Month (copy)_2845782410161258499])/SUM([federated.0kplv1v0wr9l2a132pm4o1qh4vrn].[Calculation_1439463056653832197]))' />
            </column>
            <column caption='CFR.diff' datatype='real' default-format='*↗ 0.0%;↘ -0.0%' name='[Calculation_2845782410164432903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2845782410163892229]/[CFR.selected Month (copy)_2845782410164060166]-1' />
            </column>
            <column caption='Incidents.CFR.previousMonth' datatype='integer' name='[Incidents.CFR.selected Month (copy)_2845782410161340420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([is Start Date Month (copy)_138696862756007939] AND [Calculation_2845782410158936065],1,0)' />
            </column>
            <column caption='Incidents.CFR.selected Month' datatype='integer' name='[Incidents.selected Month (copy)_2845782410161258499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_138696862754549762] AND [Calculation_2845782410158936065],1,0)' />
            </column>
            <column caption='Platform/Vertical' datatype='string' name='[Platform (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[platform]' default='&quot;Other&quot;' new-bin='true'>
                <bin default-name='false' value='&quot;Consumer&quot;'>
                  <value>&quot;Consumer&quot;</value>
                  <value>&quot;Consumer - CIMT&quot;</value>
                  <value>&quot;Consumer - Discovery&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Fintech&quot;'>
                  <value>&quot;fintech&quot;</value>
                  <value>&quot;Fintech&quot;</value>
                  <value>&quot;FinTech&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;Platform&quot;'>
                  <value>&quot;Platform&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Affected Regions' datatype='string' name='[affected_regions]' role='dimension' type='nominal' />
            <column caption='Cause' datatype='string' name='[cause]' role='dimension' type='nominal' />
            <column caption='Component' datatype='string' name='[component]' role='dimension' type='nominal' />
            <column caption='is Selected Period.Previous' datatype='boolean' name='[is Start Date Month (copy)_138696862756007939]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATEADD([Show date as],-1,DATETRUNC([Show date as],[Highlight Period]))&#10;//    =DATETRUNC([Show date as],[Start Date.Month])&#10;DATEADD(&apos;day&apos;,-DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 6], [Parameters].[Parameter 7])-1,[Parameters].[Parameter 6])&#10;&lt;= DATE([occurrence_time])&#10;AND&#10;DATEADD(&apos;day&apos;,-DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 6], [Parameters].[Parameter 7])-1,[Parameters].[Parameter 7]) &gt;= DATE([occurrence_time])' />
            </column>
            <column-instance column='[Calculation_138696862771896344]' derivation='None' name='[none:Calculation_138696862771896344:nk]' pivot='key' type='nominal' />
            <column-instance column='[affected_regions]' derivation='None' name='[none:affected_regions:nk]' pivot='key' type='nominal' />
            <column-instance column='[cause]' derivation='None' name='[none:cause:nk]' pivot='key' type='nominal' />
            <column-instance column='[component]' derivation='None' name='[none:component:nk]' pivot='key' type='nominal' />
            <column-instance column='[occurrence_time]' derivation='None' name='[none:occurrence_time:qk]' pivot='key' type='quantitative' />
            <column-instance column='[severity]' derivation='None' name='[none:severity:nk]' pivot='key' type='nominal' />
            <column-instance column='[source]' derivation='None' name='[none:source:nk]' pivot='key' type='nominal' />
            <column-instance column='[squad]' derivation='None' name='[none:squad:nk]' pivot='key' type='nominal' />
            <column-instance column='[tribe]' derivation='None' name='[none:tribe:nk]' pivot='key' type='nominal' />
            <column caption='Occurrence Time' datatype='datetime' name='[occurrence_time]' role='dimension' type='ordinal' />
            <column caption='Platform' datatype='string' name='[platform]' role='dimension' type='nominal' />
            <column caption='Severity' datatype='string' name='[severity]' role='dimension' type='nominal' />
            <column caption='Source' datatype='string' name='[source]' role='dimension' type='nominal' />
            <column caption='Squad' datatype='string' name='[squad]' role='dimension' type='nominal' />
            <column-instance column='[Incidents.selected Month (copy)_2845782410161258499]' derivation='Sum' name='[sum:Incidents.selected Month (copy)_2845782410161258499:qk]' pivot='key' type='quantitative' />
            <column caption='Tribe' datatype='string' name='[tribe]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2845782410163892229]' derivation='User' name='[usr:Calculation_2845782410163892229:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2845782410164432903]' derivation='User' name='[usr:Calculation_2845782410164432903:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0kplv1v0wr9l2a132pm4o1qh4vrn'>
            <column caption='is Highlight Period Selected' datatype='boolean' name='[Calculation_138696862754549762]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATETRUNC([Show date as],[Highlight Period])=DATETRUNC([Show date as],[Date.Month])&#10;//removed above to add start/end date picker&#10;[Parameters].[Parameter 6] &lt;= DATE([deployment_day])&#10;AND&#10;[Parameters].[Parameter 7] &gt;= DATE([deployment_day])' />
            </column>
            <column caption='Deployment Counts.selected Period' datatype='integer' name='[Calculation_1439463056653832197]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_138696862754549762],[deployment_counts],0)' />
            </column>
            <column caption='Fintech Tribe.main-filter' datatype='boolean' name='[Calculation_182677260892385280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF( [Parameters].[Parameter 4]=&apos;all&apos;,TRUE,&#10;CONTAINS(LOWER([tribe]),&#10;    CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;pay&apos;      THEN &apos;payment&apos;&#10;    WHEN &apos;wal&apos;      THEN &apos;wallet&apos;&#10;    WHEN &apos;risk&apos;     THEN &apos;risk&apos;&#10;    END)&#10;)' />
            </column>
            <column caption='Deployment Counts.previous Period' datatype='integer' name='[Deployment Counts.selected Period (copy)_1439463056654057478]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([is Start Date Month (copy)_138696862756007939],[deployment_counts],0)' />
            </column>
            <column caption='Deployment Counts' datatype='integer' name='[deployment_counts]' role='measure' type='quantitative' />
            <column caption='Deployment Day' datatype='date' name='[deployment_day]' role='dimension' type='ordinal' />
            <column caption='is Highlight Period Previous' datatype='boolean' name='[is Start Date Month (copy)_138696862756007939]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATEADD([Show date as],-1,DATETRUNC([Show date as],[Highlight Period]))&#10;//    =DATETRUNC([Show date as],[Date.Month])&#10;// removed above to add start/end date picker&#10;DATEADD(&apos;day&apos;,-DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 6], [Parameters].[Parameter 7])-1,[Parameters].[Parameter 6])&#10;&lt;= DATE([deployment_day])&#10;AND&#10;DATEADD(&apos;day&apos;,-DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 6], [Parameters].[Parameter 7])-1,[Parameters].[Parameter 7]) &gt;= DATE([deployment_day])' />
            </column>
            <column-instance column='[Calculation_1439463056653832197]' derivation='Sum' name='[sum:Calculation_1439463056653832197:qk]' pivot='key' type='quantitative' />
            <column caption='Tribe' datatype='string' name='[tribe]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1bfs7rw1yn2t9n19pl5dx1xrqcme'>
            <column caption='_yesterday' datatype='datetime' name='[Calculation_590745647978233856]' role='dimension' type='ordinal'>
