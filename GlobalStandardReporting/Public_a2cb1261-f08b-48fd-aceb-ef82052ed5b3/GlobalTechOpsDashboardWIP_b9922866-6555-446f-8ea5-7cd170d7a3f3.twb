            <column caption='Component' datatype='string' name='[component]' role='dimension' type='nominal' />
            <column caption='is Selected Period.Previous' datatype='boolean' name='[is Start Date Month (copy)_138696862756007939]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATEADD([Show date as],-1,DATETRUNC([Show date as],[Highlight Period]))&#10;//    =DATETRUNC([Show date as],[Start Date.Month])&#10;DATEADD(&apos;day&apos;,-DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 6], [Parameters].[Parameter 7])-1,[Parameters].[Parameter 6])&#10;&lt;= DATE([occurrence_time])&#10;AND&#10;DATEADD(&apos;day&apos;,-DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 6], [Parameters].[Parameter 7])-1,[Parameters].[Parameter 7]) &gt;= DATE([occurrence_time])' />
            </column>
