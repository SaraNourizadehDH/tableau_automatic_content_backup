            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06mchdb0x5mg2619ftxbk0q7r2hp'>
            <column caption='Start Date.Month' datatype='datetime' name='[Calculation_138696862753914880]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[occurrence_time])' />
            </column>
            <column caption='Fintech Tribe' datatype='string' name='[Calculation_138696862771896344]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STARTSWITH([squad],&apos;Payment&apos;) THEN &apos;Payments&apos;&#10;ELSEIF STARTSWITH([squad],&apos;Wallet&apos;) THEN &apos;Wallet&apos;&#10;ELSEIF STARTSWITH([squad],&apos;Risk&apos;) THEN &apos;Risk&apos;&#10;ELSEIF ISNULL([squad]) AND CONTAINS(LOWER([cause]),&apos;third party&apos;) THEN &apos;Payments&apos;&#10;ELSE &apos;Other&apos;&#10;END' />
            </column>
            <column caption='Date_dynamic' datatype='date' datatype-customized='true' default-format='*mmm yyyy' name='[Calculation_509891929141489666]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 5],[occurrence_time]))' />
            </column>
            <column caption='Is duration valid' datatype='boolean' name='[Calculation_5912030049670115328]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[occurrence_time]&lt;=[closure_time]&#10;AND [detection_time]&lt;=[closure_time]&#10;AND [occurrence_time]&lt;=[detection_time]' />
            </column>
            <column caption='incidents' datatype='integer' name='[Calculation_828451244466069519]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([incident_id])' />
            </column>
            <column caption='Duration Close' datatype='integer' name='[Duration Acknowledge (copy)_51650696387252230]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='datediff(&apos;minute&apos;,[mitigation_time],[closure_time])' />
            </column>
            <column caption='MTTC over incidents' datatype='real' name='[MTTA over incidents (copy)_51650696387149829]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Duration Acknowledge (copy)_51650696387252230])/[Calculation_828451244466069519]' />
            </column>
            <column caption='Platform/Vertical' datatype='string' name='[Platform (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[platform]' default='&quot;Other&quot;' new-bin='true'>
                <bin default-name='false' value='&quot;Consumer&quot;'>
                  <value>&quot;Consumer&quot;</value>
                  <value>&quot;Consumer - CIMT&quot;</value>
                  <value>&quot;Consumer - Discovery&quot;</value>
