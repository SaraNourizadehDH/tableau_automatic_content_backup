          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0kplv1v0wr9l2a132pm4o1qh4vrn'>
            <column caption='is Business Day?' datatype='boolean' name='[Calculation_1439463056641843200]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;weekday&apos;,[deployment_day]) &lt;&gt; 1 AND DATEPART(&apos;weekday&apos;,[deployment_day]) &lt;&gt; 7' />
            </column>
            <column caption='Tribe Headcount.LOD MAX' datatype='integer' name='[Calculation_1439463056642265089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [tribe] : MAX([tribe_headcount])}' />
