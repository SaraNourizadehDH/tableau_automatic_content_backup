      <column caption='Created At.Timeframe' datatype='string' name='[Calculation_1951254926679523329]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Show trends (copy)_1951254926680412163]&#10;WHEN &apos;day&apos; THEN STR(DATE([created_at]))&#10;WHEN &apos;week&apos; THEN STR(YEAR([created_at]))+&apos; W&apos;+ STR(WEEK([created_at]))&#10;WHEN &apos;month&apos; THEN LEFT(DATENAME(&apos;month&apos;, [created_at]),3) + &apos; &apos; + STR(YEAR([created_at]))&#10;WHEN &apos;quarter&apos; THEN STR(YEAR([created_at]))+&apos; Q&apos;+STR(QUARTER([created_at])) &#10;//WHEN &apos;year&apos; THEN STR(YEAR([Created At]))&#10;ELSE NULL END' />
      </column>
      <column caption='Created At.MIN/MAX.label' datatype='string' name='[Calculation_1951254926692450310]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(DATE(MIN([created_at]))) + &quot; to &quot; + STR(DATE(MAX([created_at])))' />
      </column>
      <column caption='Business Hours CET' datatype='string' name='[Calculation_6950180147061764096]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// If between April and October, adjust for Daylight Savings Time&#10;IF DATEPART(&apos;month&apos;,[created_at] ) &gt;= 4 AND DATEPART(&apos;month&apos;,[created_at] ) &lt;= 10&#10;THEN IIF(&#10;    (DATEPART(&apos;hour&apos;, [created_at])&gt;=10 AND DATEPART(&apos;hour&apos;, [created_at])&lt;=20)&#10;    AND (DATEPART(&apos;weekday&apos;, [created_at])&gt;=2 AND DATEPART(&apos;weekday&apos;, [created_at])&lt;=6)&#10;    ,&apos;Business Hours&apos;,&apos;Outside Business Hours&apos;)&#10;ELSE IIF(&#10;    (DATEPART(&apos;hour&apos;, [created_at])&gt;=9 AND DATEPART(&apos;hour&apos;, [created_at])&lt;=19)&#10;    AND (DATEPART(&apos;weekday&apos;, [created_at])&gt;=2 AND DATEPART(&apos;weekday&apos;, [created_at])&lt;=6)&#10;    ,&apos;Business Hours&apos;,&apos;Outside Business Hours&apos;)&#10;&#10;/*THEN DATEADD(&apos;hour&apos;,2,[Created At])&#10;ELSE DATEADD(&apos;hour&apos;,1,[Created At])*/&#10;END' />
      </column>
