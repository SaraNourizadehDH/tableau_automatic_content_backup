            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1bfs7rw1yn2t9n19pl5dx1xrqcme'>
            <column caption='Order Date.Month' datatype='datetime' name='[Calculation_138696862767185942]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[order_date])' />
            </column>
            <column caption='Date_dynamic' datatype='date' datatype-customized='true' name='[Calculation_509891929141489666]' role='dimension' type='ordinal'>
