                <alias key='&quot;day&quot;' value='Day' />
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;quarter&quot;' value='Quarter' />
                <alias key='&quot;week&quot;' value='Week' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1bfs7rw1yn2t9n19pl5dx1xrqcme].[_yesterday (copy)_590745647978397697]' caption='Main.Start Date' datatype='date' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1bfs7rw1yn2t9n19pl5dx1xrqcme].[Calculation_590745647978233856]' caption='Main.End Date' datatype='date' name='[Parameter 7]' param-domain-type='any' role='measure' type='quantitative' value='#2025-08-21#'>
