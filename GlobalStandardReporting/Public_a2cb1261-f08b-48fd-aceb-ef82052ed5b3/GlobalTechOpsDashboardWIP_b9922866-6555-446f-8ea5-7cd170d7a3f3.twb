              <calculation class='tableau' formula='IF CONTAINS(LOWER([dh_tribe]), &apos;payment&apos;)       THEN &apos;Payments&apos;&#10;ELSEIF CONTAINS(LOWER([dh_tribe]), &apos;wallet&apos;)&#10;    OR CONTAINS(LOWER([dh_tribe]), &apos;financial-services&apos;) &#10;    OR STARTSWITH(LOWER([dh_tribe]), &apos;fs&apos;)     &#10;        THEN &apos;Wallet&apos;&#10;ELSEIF CONTAINS(LOWER([dh_tribe]), &apos;risk&apos;)&#10;    OR CONTAINS(LOWER([dh_tribe]), &apos;fraud&apos;)&#10;         THEN &apos;Risk&apos;&#10;ELSEIF CONTAINS(LOWER([dh_tribe]), &apos;foundation&apos;) &#10;    OR LOWER([dh_tribe]) = &apos;security&apos;   THEN &apos;Foundation&apos;&#10;ELSEIF LOWER([dh_tribe])= &apos;data&apos; THEN &apos;Data&apos;&#10;ELSE &apos;Other&apos;&#10;END' />
            </column>
