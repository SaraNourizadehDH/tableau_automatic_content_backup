      <column caption='Fintech Tribe.main filter' datatype='boolean' name='[Calculation_6526771395373125632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF( [Parameters].[Parameter 4]=&apos;all&apos;,TRUE,&#10;(CASE [Parameters].[Parameter 4]&#10;WHEN &apos;pay&apos;      THEN &apos;Payment&apos;&#10;WHEN &apos;wal&apos;      THEN &apos;Wallet&apos;&#10;WHEN &apos;risk&apos;     THEN &apos;Fraud&apos;&#10;WHEN &apos;found&apos;     THEN &apos;Other&apos;&#10;END) = [tribe] )' />
