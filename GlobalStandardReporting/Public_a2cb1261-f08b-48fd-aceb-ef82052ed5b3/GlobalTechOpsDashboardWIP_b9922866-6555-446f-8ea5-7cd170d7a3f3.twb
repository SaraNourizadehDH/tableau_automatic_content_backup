  <actions>
    <action caption='PostMortem URL' name='[Action1_78A0AD0797FE4234BB57A8330333F10C]'>
      <activation type='on-select' />
      <source datasource='federated.06mchdb0x5mg2619ftxbk0q7r2hp' type='datasource'>
        <exclude-sheet name='main.Incidents.retention%' />
        <exclude-sheet name='main.Incidents.mttr.line' />
