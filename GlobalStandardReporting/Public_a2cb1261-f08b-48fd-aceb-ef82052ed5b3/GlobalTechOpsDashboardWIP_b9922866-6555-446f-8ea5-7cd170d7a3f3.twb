    <worksheet name='main.Incidents.mttm'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Time to Mitigate (TTM)&#10;</run>
            <run fontcolor='#555555' fontname='Tableau Book' fontsize='9'>avg. in minutes</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tech_ops_incidents_mock_v2 (rl_fintech)' name='federated.06mchdb0x5mg2619ftxbk0q7r2hp' />
            <datasource caption='tech_ops_orders_mock (rl_fintech)' name='federated.1bfs7rw1yn2t9n19pl5dx1xrqcme' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1bfs7rw1yn2t9n19pl5dx1xrqcme].[_yesterday (copy)_590745647978397697]' caption='Main.Start Date' datatype='date' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1bfs7rw1yn2t9n19pl5dx1xrqcme].[Calculation_590745647978233856]' caption='Main.End Date' datatype='date' name='[Parameter 7]' param-domain-type='any' role='measure' type='quantitative' value='#2025-08-21#'>
              <calculation class='tableau' formula='#2025-08-21#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06mchdb0x5mg2619ftxbk0q7r2hp'>
            <column caption='is Selected Period' datatype='boolean' name='[Calculation_138696862754549762]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATETRUNC([Show date as], [Highlight Period])=DATETRUNC([Show date as], [Start Date.Month])&#10;&#10;[Parameters].[Parameter 6] &lt;= DATE([occurrence_time])&#10;AND&#10;[Parameters].[Parameter 7] &gt;= DATE([occurrence_time])' />
            </column>
            <column caption='Incidents.selected Month' datatype='integer' name='[Calculation_138696862756286468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_138696862754549762],1,0)' />
            </column>
            <column caption='Fintech Tribe' datatype='string' name='[Calculation_138696862771896344]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF STARTSWITH([squad],&apos;Payment&apos;) THEN &apos;Payments&apos;&#10;ELSEIF STARTSWITH([squad],&apos;Wallet&apos;) THEN &apos;Wallet&apos;&#10;ELSEIF STARTSWITH([squad],&apos;Risk&apos;) THEN &apos;Risk&apos;&#10;ELSEIF ISNULL([squad]) AND CONTAINS(LOWER([cause]),&apos;third party&apos;) THEN &apos;Payments&apos;&#10;ELSE &apos;Other&apos;&#10;END' />
            </column>
            <column caption='Is duration valid' datatype='boolean' name='[Calculation_5912030049670115328]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[occurrence_time]&lt;=[closure_time]&#10;AND [detection_time]&lt;=[closure_time]&#10;AND [occurrence_time]&lt;=[detection_time]' />
            </column>
            <column caption='Duration.mitigation.prevMonth' datatype='integer' name='[Duration.mitigation.selectMonth (copy)_138696862776352798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([is Start Date Month (copy)_138696862756007939], datediff(&apos;minute&apos;,[graduation_time],[mitigation_time]), Null)' />
            </column>
            <column caption='Incidents.previous Month' datatype='integer' name='[Incidents.selected Month (copy)_138696862756954117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([is Start Date Month (copy)_138696862756007939],1,0)' />
            </column>
            <column caption='MTTM.diff' datatype='real' default-format='*↗ 0.0%;↘ -0.0%' name='[MTTD.diff (copy)_138696862780055588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[MTTD.selecMonth (copy)_138696862779863074]/[MTTM.selecMonth (copy)_138696862779961379]-1' />
            </column>
            <column caption='MTTM.selecMonth' datatype='real' default-format='n#,##0;-#,##0' name='[MTTD.selecMonth (copy)_138696862779863074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Mitigation detection (copy)_138696862776188957])/SUM([Calculation_138696862756286468])' />
            </column>
            <column caption='MTTM.prevMonth' datatype='real' default-format='n#,##0;-#,##0' name='[MTTM.selecMonth (copy)_138696862779961379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Duration.mitigation.selectMonth (copy)_138696862776352798])/SUM([Incidents.selected Month (copy)_138696862756954117])' />
            </column>
            <column caption='Duration.mitigation.selectMonth' datatype='integer' name='[Mitigation detection (copy)_138696862776188957]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_138696862754549762], datediff(&apos;minute&apos;,[graduation_time],[mitigation_time]), Null)' />
            </column>
            <column caption='Platform/Vertical' datatype='string' name='[Platform (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[platform]' default='&quot;Other&quot;' new-bin='true'>
                <bin default-name='false' value='&quot;Consumer&quot;'>
                  <value>&quot;Consumer&quot;</value>
                  <value>&quot;Consumer - CIMT&quot;</value>
                  <value>&quot;Consumer - Discovery&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Fintech&quot;'>
                  <value>&quot;fintech&quot;</value>
                  <value>&quot;Fintech&quot;</value>
                  <value>&quot;FinTech&quot;</value>
                </bin>
                <bin default-name='true' value='&quot;Platform&quot;'>
                  <value>&quot;Platform&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Affected Regions' datatype='string' name='[affected_regions]' role='dimension' type='nominal' />
            <column caption='Cause' datatype='string' name='[cause]' role='dimension' type='nominal' />
            <column caption='Closure Time' datatype='datetime' name='[closure_time]' role='dimension' type='ordinal' />
            <column caption='Component' datatype='string' name='[component]' role='dimension' type='nominal' />
            <column caption='Detection Time' datatype='datetime' name='[detection_time]' role='dimension' type='ordinal' />
            <column caption='Graduation Time' datatype='datetime' name='[graduation_time]' role='dimension' type='ordinal' />
            <column caption='is Selected Period.Previous' datatype='boolean' name='[is Start Date Month (copy)_138696862756007939]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATEADD([Show date as],-1,DATETRUNC([Show date as],[Highlight Period]))&#10;//    =DATETRUNC([Show date as],[Start Date.Month])&#10;DATEADD(&apos;day&apos;,-DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 6], [Parameters].[Parameter 7])-1,[Parameters].[Parameter 6])&#10;&lt;= DATE([occurrence_time])&#10;AND&#10;DATEADD(&apos;day&apos;,-DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 6], [Parameters].[Parameter 7])-1,[Parameters].[Parameter 7]) &gt;= DATE([occurrence_time])' />
            </column>
            <column caption='Mitigation Time' datatype='datetime' name='[mitigation_time]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_138696862771896344]' derivation='None' name='[none:Calculation_138696862771896344:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5912030049670115328]' derivation='None' name='[none:Calculation_5912030049670115328:nk]' pivot='key' type='nominal' />
