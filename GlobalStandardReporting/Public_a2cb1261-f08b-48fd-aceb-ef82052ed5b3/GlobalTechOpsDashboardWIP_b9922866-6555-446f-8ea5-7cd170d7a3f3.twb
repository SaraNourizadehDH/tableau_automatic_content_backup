    <worksheet name='main.pr-merged.kpi'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Pull Requests Merged</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fintech_pull_requests (rl_fintech)' name='federated.0xoxz2v0wji0v312hyzcm0z2xyhg' />
            <datasource caption='tech_ops_orders_mock (rl_fintech)' name='federated.1bfs7rw1yn2t9n19pl5dx1xrqcme' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='All' caption='Fintech Tribe selector' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;all&quot;'>
              <calculation class='tableau' formula='&quot;all&quot;' />
              <aliases>
                <alias key='&quot;all&quot;' value='All' />
                <alias key='&quot;pay&quot;' value='Payments' />
                <alias key='&quot;risk&quot;' value='Risk' />
                <alias key='&quot;wal&quot;' value='Wallet' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1bfs7rw1yn2t9n19pl5dx1xrqcme].[_yesterday (copy)_590745647978397697]' caption='Main.Start Date' datatype='date' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1bfs7rw1yn2t9n19pl5dx1xrqcme].[Calculation_590745647978233856]' caption='Main.End Date' datatype='date' name='[Parameter 7]' param-domain-type='any' role='measure' type='quantitative' value='#2025-08-21#'>
              <calculation class='tableau' formula='#2025-08-21#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0xoxz2v0wji0v312hyzcm0z2xyhg'>
            <column caption='is Highlight Period Selected' datatype='boolean' name='[Calculation_138696862754549762]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATETRUNC([Show date as],[Highlight Period])=DATETRUNC([Show date as],[Date.Month])&#10;//removed above to add start/end date picker&#10;[Parameters].[Parameter 6] &lt;= DATE([merge_date])&#10;AND&#10;[Parameters].[Parameter 7] &gt;= DATE([merge_date])' />
            </column>
            <column caption='Tribe.edit' datatype='string' name='[Calculation_1652609990199627776]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IIF([Domain]=&apos;Fraud&apos;,&apos;Risk&apos;,[Tribe])&#10;IF LOWER([domain])=&apos;wallet&apos; THEN &apos;wallet&apos;&#10;ELSEIF CONTAINS(LOWER([domain]),&apos;payment&apos;) THEN &apos;payments&apos;&#10;ELSEIF LOWER([domain])=&apos;fraud&apos; THEN &apos;risk&apos;&#10;ELSE &apos;other&apos;&#10;END' />
            </column>
            <column caption='PR.Count.diff' datatype='real' default-format='*↗ 0.0%;↘ -0.0%' name='[Calculation_1652609990207692811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[PR.Count (copy)_1652609990202740741]/[PR.Count.selectedPeriod (copy)_1652609990202892294]-1' />
            </column>
            <column caption='Fintech Tribe.main-filter' datatype='boolean' name='[Calculation_182677260892385280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF( [Parameters].[Parameter 4]=&apos;all&apos;,TRUE,&#10;(CASE [Parameters].[Parameter 4]&#10;WHEN &apos;pay&apos;      THEN &apos;payments&apos;&#10;WHEN &apos;wal&apos;      THEN &apos;wallet&apos;&#10;WHEN &apos;risk&apos;     THEN &apos;risk&apos;&#10;END) = LOWER([Calculation_1652609990199627776]) )' />
            </column>
            <column caption='PR.Count.selectedPeriod' datatype='integer' name='[PR.Count (copy)_1652609990202740741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IIF([Calculation_138696862754549762], [pr_id],NULL))' />
            </column>
            <column caption='PR.Count.prevPeriod' datatype='integer' name='[PR.Count.selectedPeriod (copy)_1652609990202892294]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IIF([is Start Date Month (copy)_138696862756007939], [pr_id],NULL))' />
            </column>
            <column caption='Domain' datatype='string' name='[domain]' role='dimension' type='nominal' />
            <column caption='is Highlight Period Previous' datatype='boolean' name='[is Start Date Month (copy)_138696862756007939]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATEADD([Show date as],-1,DATETRUNC([Show date as],[Highlight Period]))&#10;//    =DATETRUNC([Show date as],[Date.Month])&#10;// removed above to add start/end date picker&#10;DATEADD(&apos;day&apos;,-DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 6], [Parameters].[Parameter 7])-1,[Parameters].[Parameter 6])&#10;&lt;= DATE([merge_date])&#10;AND&#10;DATEADD(&apos;day&apos;,-DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 6], [Parameters].[Parameter 7])-1,[Parameters].[Parameter 7]) &gt;= DATE([merge_date])' />
            </column>
            <column caption='Merge Date' datatype='date' name='[merge_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_182677260892385280]' derivation='None' name='[none:Calculation_182677260892385280:nk]' pivot='key' type='nominal' />
            <column-instance column='[repository_name]' derivation='None' name='[none:repository_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[squad]' derivation='None' name='[none:squad:nk]' pivot='key' type='nominal' />
            <column caption='Pr Id' datatype='string' name='[pr_id]' role='dimension' type='nominal' />
            <column caption='Repository Name' datatype='string' name='[repository_name]' role='dimension' type='nominal' />
            <column caption='Squad' datatype='string' name='[squad]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1652609990207692811]' derivation='User' name='[usr:Calculation_1652609990207692811:qk]' pivot='key' type='quantitative' />
            <column-instance column='[PR.Count (copy)_1652609990202740741]' derivation='User' name='[usr:PR.Count (copy)_1652609990202740741:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1bfs7rw1yn2t9n19pl5dx1xrqcme'>
            <column caption='_yesterday' datatype='datetime' name='[Calculation_590745647978233856]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;, -1, TODAY())' />
            </column>
            <column caption='_first of last month' datatype='datetime' name='[_yesterday (copy)_590745647978397697]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;, DATEADD(&apos;day&apos;, -1, TODAY()) ))' />
            </column>
          </datasource-dependencies>
          <slices>
            <column>[federated.0xoxz2v0wji0v312hyzcm0z2xyhg].[none:squad:nk]</column>
            <column>[federated.0xoxz2v0wji0v312hyzcm0z2xyhg].[none:repository_name:nk]</column>
            <column>[federated.0xoxz2v0wji0v312hyzcm0z2xyhg].[none:Calculation_182677260892385280:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
