              <calculation class='tableau' formula='//DATETRUNC([Show date as],[Highlight Period])=DATETRUNC([Show date as],[Date.Month])&#10;//removed above to add start/end date picker&#10;[Parameters].[Parameter 6] &lt;= DATE([merge_date])&#10;AND&#10;[Parameters].[Parameter 7] &gt;= DATE([merge_date])' />
            </column>
            <column caption='Tribe.edit' datatype='string' name='[Calculation_1652609990199627776]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IIF([Domain]=&apos;Fraud&apos;,&apos;Risk&apos;,[Tribe])&#10;IF LOWER([domain])=&apos;wallet&apos; THEN &apos;wallet&apos;&#10;ELSEIF CONTAINS(LOWER([domain]),&apos;payment&apos;) THEN &apos;payments&apos;&#10;ELSEIF LOWER([domain])=&apos;fraud&apos; THEN &apos;risk&apos;&#10;ELSE &apos;other&apos;&#10;END' />
            </column>
            <column caption='Fintech Tribe.main-filter' datatype='boolean' name='[Calculation_182677260892385280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF( [Parameters].[Parameter 4]=&apos;all&apos;,TRUE,&#10;(CASE [Parameters].[Parameter 4]&#10;WHEN &apos;pay&apos;      THEN &apos;payments&apos;&#10;WHEN &apos;wal&apos;      THEN &apos;wallet&apos;&#10;WHEN &apos;risk&apos;     THEN &apos;risk&apos;&#10;END) = LOWER([Calculation_1652609990199627776]) )' />
            </column>
            <column caption='Cycle Time Hours.diff' datatype='real' default-format='*↗ 0.0%;↘ -0.0%' name='[Code Review Hours.diff (copy)_1652609990204071946]' role='measure' type='quantitative'>
