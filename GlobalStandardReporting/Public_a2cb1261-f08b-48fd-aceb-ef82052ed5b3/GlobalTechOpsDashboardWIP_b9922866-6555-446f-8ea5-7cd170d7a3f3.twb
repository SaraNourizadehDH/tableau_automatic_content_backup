              <calculation class='tableau' formula='//DATETRUNC([Show date as], [Highlight Period])=DATETRUNC([Show date as], [Start Date.Month])&#10;&#10;[Parameters].[Parameter 6] &lt;= DATE([occurrence_time])&#10;AND&#10;[Parameters].[Parameter 7] &gt;= DATE([occurrence_time])' />
