            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.06mchdb0x5mg2619ftxbk0q7r2hp].[Calculation_138696862753914880]' caption='Highlight Period' datatype='datetime' default-format='*(\Qq) mmm yyyy' name='[Start Date.Month Parameter]' param-domain-type='list' role='measure' type='quantitative' value='#2019-01-01 00:00:00#'>
              <calculation class='tableau' formula='#2019-01-01 00:00:00#' />
