          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='All' caption='Fintech Tribe selector' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;all&quot;'>
              <calculation class='tableau' formula='&quot;all&quot;' />
              <aliases>
                <alias key='&quot;all&quot;' value='All' />
                <alias key='&quot;pay&quot;' value='Payments' />
                <alias key='&quot;risk&quot;' value='Risk' />
                <alias key='&quot;wal&quot;' value='Wallet' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1bfs7rw1yn2t9n19pl5dx1xrqcme].[_yesterday (copy)_590745647978397697]' caption='Main.Start Date' datatype='date' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='#2025-07-01#'>
              <calculation class='tableau' formula='#2025-07-01#' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.1bfs7rw1yn2t9n19pl5dx1xrqcme].[Calculation_590745647978233856]' caption='Main.End Date' datatype='date' name='[Parameter 7]' param-domain-type='any' role='measure' type='quantitative' value='#2025-08-21#'>
              <calculation class='tableau' formula='#2025-08-21#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ru41091yu6e5g1h32l0n1tftstf'>
            <column caption='is Month Selected' datatype='boolean' name='[Calculation_138696862754549762]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//DATETRUNC([Show date as],[Highlight Period])=DATETRUNC([Show date as],[Date])&#10;//removed above to add custom date picker&#10;[Parameters].[Parameter 6] &lt;= DATE([scaffold_date])&#10;AND&#10;[Parameters].[Parameter 7] &gt;= DATE([scaffold_date])' />
            </column>
            <column caption='Fintech Tribe.main-filter' datatype='boolean' name='[Calculation_182677260892385280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF( [Parameters].[Parameter 4]=&apos;all&apos;,TRUE,&#10;(CASE [Parameters].[Parameter 4]&#10;WHEN &apos;pay&apos;      THEN &apos;Fintech / Payments&apos;&#10;WHEN &apos;wal&apos;      THEN &apos;Fintech / Wallet&apos;&#10;WHEN &apos;risk&apos;     THEN &apos;Fintech / Risk&apos;&#10;WHEN &apos;found&apos;     THEN &apos;Fintech / Foundation&apos;&#10;END) = [project_category_name] )' />
            </column>
            <column caption='Tickets.Created.selectedMonth' datatype='integer' name='[Tickets.Created (copy)_183451320597995521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;IF &#10;    ([Parameters].[Parameter 6] &lt;= DATE([created_at])&#10;    AND&#10;    [Parameters].[Parameter 7] &gt;= DATE([created_at]))&#10; AND [Calculation_138696862754549762]&#10;THEN [ticket_id]&#10;END&#10;)' />
            </column>
            <column caption='Tickets.Done.selectedMonth' datatype='integer' name='[Tickets.Done (copy)_183451320597860352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;IF &#10;    ([Parameters].[Parameter 6] &lt;= DATE([done_at])&#10;    AND&#10;    [Parameters].[Parameter 7] &gt;= DATE([done_at]))&#10; AND [Calculation_138696862754549762]&#10;THEN [ticket_id] ELSE NULL&#10;END&#10;)' />
            </column>
            <column caption='Tickets.Ratio.selectedMonth' datatype='real' default-format='p0.0%' name='[Tickets.Ratio (copy)_183451320598302724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Tickets.Done (copy)_183451320597860352]/[Tickets.Created (copy)_183451320597995521]' />
            </column>
            <column caption='Created At' datatype='date' datatype-customized='true' name='[created_at]' role='dimension' type='ordinal' />
            <column caption='Done At' datatype='date' datatype-customized='true' name='[done_at]' role='dimension' type='ordinal' />
