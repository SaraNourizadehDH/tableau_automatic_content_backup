      <aliases enabled='yes' />
      <column caption='Active Tickets.selectedMonth' datatype='integer' name='[Active Tickets (copy)_781656022359515141]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD(IIF(&#10;/*&#10;[Scaffold Date]&lt; IFNULL([Done At], TODAY() ) AND [is Month Selected],&#10;[Ticket Id],Null&#10;*/&#10;[Parameters].[Parameter 7]&lt;= IFNULL([done_at], TODAY() ),&#10;[ticket_id],Null&#10;&#10;))' />
      </column>
      <column caption='Active Tickets LOD' datatype='integer' name='[Active Tickets (copy)_929782240915427333]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//{FIXED [Project Category Name], [Ticket Type] : &#10;COUNTD(&#10;IIF(&#10;//DATETRUNC(&apos;month&apos;,[Date])&gt;= DATETRUNC(&apos;month&apos;,[Created At]) &#10;//AND&#10;DATETRUNC(&apos;day&apos;,[scaffold_date])&lt; DATETRUNC(&apos;day&apos;,IFNULL([done_at], TODAY() )),&#10;[ticket_id],Null&#10;)&#10;)&#10;//}' />
      </column>
      <column caption='Active Tickets per Engineer.previousMonth' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Active Tickets per Engineer.selectedMonth (copy)_929782240911896578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Active Tickets.selectedMonth (copy)_781656022359650310]/MAX([tribe_headcount])' />
      </column>
      <column caption='Active Tickets per Eng.diff' datatype='real' default-format='*↗ 0.0%;↘ -0.0%' name='[Active Tickets.diff (copy)_929782240911998979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_929782240911196160]/[Active Tickets per Engineer.selectedMonth (copy)_929782240911896578])-1' />
      </column>
      <column caption='Active Tickets.prevMonth' datatype='integer' name='[Active Tickets.selectedMonth (copy)_781656022359650310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF(&#10;//DATETRUNC(&apos;month&apos;,[Date])&gt;= DATETRUNC(&apos;month&apos;,[Created At]) &#10;//AND&#10;([scaffold_date])&lt; IFNULL([done_at], TODAY() ) AND [is Start Date Month (copy)_138696862756007939],&#10;[ticket_id],Null&#10;))' />
      </column>
      <column caption='is Month Selected.created' datatype='boolean' name='[Calculation_138696862754549762 1]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Start Date.Month Parameter]=DATETRUNC(&apos;month&apos;,[created_at 2])' />
      </column>
      <column caption='is Month Selected' datatype='boolean' name='[Calculation_138696862754549762]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//DATETRUNC([Show date as],[Highlight Period])=DATETRUNC([Show date as],[Date])&#10;//removed above to add custom date picker&#10;[Parameters].[Parameter 6] &lt;= DATE([scaffold_date])&#10;AND&#10;[Parameters].[Parameter 7] &gt;= DATE([scaffold_date])' />
      </column>
      <column caption='Tickets Done LOD' datatype='integer' name='[Calculation_138696863393792055]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#10;IF DATETRUNC(&apos;month&apos;, [created_at 1]) = DATETRUNC(&apos;month&apos;, [done_at 1])&#10;    AND [status_category_current] = &apos;Done&apos;&#10;THEN { FIXED DATETRUNC(&apos;month&apos;, [started_at 1]),&#10;    [project_category_name]&#10;    ,[project_key]&#10;    ,[status_category_current]&#10;    ,[ticket_type]: COUNTD([ticket_id 1]) }&#10;END&#10;)' />
      </column>
      <column caption='created_at.Month' datatype='datetime' name='[Calculation_138696863488929851]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[created_at 1])' />
      </column>
      <column caption='Ticket Count.created.diff' datatype='real' default-format='*↗ 0.0%;↘ -0.0%' name='[Calculation_138696863490158654]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Ticket Count (copy)_138696863489364028]/[Ticket Count.selecMonth (copy)_138696863489814589]-1' />
      </column>
      <column caption='Fintech Tribe.main-filter' datatype='boolean' name='[Calculation_182677260892385280]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF( [Parameters].[Parameter 4]=&apos;all&apos;,TRUE,&#10;(CASE [Parameters].[Parameter 4]&#10;WHEN &apos;pay&apos;      THEN &apos;Fintech / Payments&apos;&#10;WHEN &apos;wal&apos;      THEN &apos;Fintech / Wallet&apos;&#10;WHEN &apos;risk&apos;     THEN &apos;Fintech / Risk&apos;&#10;WHEN &apos;found&apos;     THEN &apos;Fintech / Foundation&apos;&#10;END) = [project_category_name] )' />
      </column>
      <column caption='Tickets.Ratio.diff' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_183451320598511622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Tickets.Ratio (copy)_183451320598302724]-[Tickets.Ratio.selectedMonth (copy)_183451320598384645])*100' />
      </column>
      <column caption='Active Tickets' datatype='integer' name='[Calculation_2894547927904112640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF(&#10;//DATETRUNC(&apos;month&apos;,[Date])&gt;= DATETRUNC(&apos;month&apos;,[Created At]) &#10;//AND&#10;DATETRUNC(&apos;day&apos;,[scaffold_date])&lt; DATETRUNC(&apos;day&apos;,IFNULL([done_at], TODAY() )),&#10;[ticket_id],Null&#10;))' />
      </column>
      <column caption='Ticket Age (days)' datatype='integer' name='[Calculation_2894547927907938307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[created_at], IFNULL([done_at], TODAY()))' />
      </column>
      <column caption='Ticket Age.AVG' datatype='real' name='[Calculation_2894547927908225028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2894547927907938307])/SUM([Calculation_2894547927904112640])' />
      </column>
      <column caption='Ticket Count' datatype='integer' name='[Calculation_2958513177687826432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([jira_tickets_2E0362BD0F8D4E7A988AA7A859E8906C])' />
