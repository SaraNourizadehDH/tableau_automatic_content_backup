              <calculation class='tableau' formula='//DATEADD([Show date as],-1,DATETRUNC([Show date as],[Highlight Period]))&#10;//    =DATETRUNC([Show date as],[done_at])&#10;DATEADD(&apos;day&apos;,-DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 6], [Parameters].[Parameter 7])-1,[Parameters].[Parameter 6])&#10;&lt;= DATE([done_at])&#10;AND&#10;DATEADD(&apos;day&apos;,-DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 6], [Parameters].[Parameter 7])-1,[Parameters].[Parameter 7]) &gt;= DATE([done_at])' />
