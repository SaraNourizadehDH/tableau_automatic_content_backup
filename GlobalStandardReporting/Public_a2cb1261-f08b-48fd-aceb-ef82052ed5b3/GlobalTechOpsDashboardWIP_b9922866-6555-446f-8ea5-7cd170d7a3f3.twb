    <worksheet name='alerts.weekday'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Alerts per weekday and business hours (between 8 am - 6 pm)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tech_ops_alerts_mock (rl_fintech)' name='federated.0ofxk4q1qjdj6f1e8tl181sc3b78' />
          </datasources>
          <datasource-dependencies datasource='federated.0ofxk4q1qjdj6f1e8tl181sc3b78'>
            <column caption='Alerts.Count' datatype='integer' name='[Calculation_1951254926675849216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([alert_id])' />
            </column>
            <column caption='Business Hours CET' datatype='string' name='[Calculation_6950180147061764096]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// If between April and October, adjust for Daylight Savings Time&#10;IF DATEPART(&apos;month&apos;,[created_at] ) &gt;= 4 AND DATEPART(&apos;month&apos;,[created_at] ) &lt;= 10&#10;THEN IIF(&#10;    (DATEPART(&apos;hour&apos;, [created_at])&gt;=10 AND DATEPART(&apos;hour&apos;, [created_at])&lt;=20)&#10;    AND (DATEPART(&apos;weekday&apos;, [created_at])&gt;=2 AND DATEPART(&apos;weekday&apos;, [created_at])&lt;=6)&#10;    ,&apos;Business Hours&apos;,&apos;Outside Business Hours&apos;)&#10;ELSE IIF(&#10;    (DATEPART(&apos;hour&apos;, [created_at])&gt;=9 AND DATEPART(&apos;hour&apos;, [created_at])&lt;=19)&#10;    AND (DATEPART(&apos;weekday&apos;, [created_at])&gt;=2 AND DATEPART(&apos;weekday&apos;, [created_at])&lt;=6)&#10;    ,&apos;Business Hours&apos;,&apos;Outside Business Hours&apos;)&#10;&#10;/*THEN DATEADD(&apos;hour&apos;,2,[Created At])&#10;ELSE DATEADD(&apos;hour&apos;,1,[Created At])*/&#10;END' />
            </column>
            <column caption='Alert Id' datatype='string' name='[alert_id]' role='dimension' type='nominal' />
            <column caption='Created At' datatype='datetime' name='[created_at]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_6950180147061764096]' derivation='None' name='[none:Calculation_6950180147061764096:nk]' pivot='key' type='nominal' />
            <column-instance column='[created_at]' derivation='None' name='[none:created_at:qk]' pivot='key' type='quantitative' />
            <column-instance column='[owner]' derivation='None' name='[none:owner:nk]' pivot='key' type='nominal' />
            <column-instance column='[platform]' derivation='None' name='[none:platform:nk]' pivot='key' type='nominal' />
            <column-instance column='[responder_team_name]' derivation='None' name='[none:responder_team_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[squad]' derivation='None' name='[none:squad:nk]' pivot='key' type='nominal' />
            <column-instance column='[tribe]' derivation='None' name='[none:tribe:nk]' pivot='key' type='nominal' />
            <column caption='Owner' datatype='string' name='[owner]' role='dimension' type='nominal' />
