            <column-instance column='[Calculation_1439463056642265089]' derivation='Sum' name='[sum:Calculation_1439463056642265089:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1439463056653832197]' derivation='Sum' name='[sum:Calculation_1439463056653832197:qk]' pivot='key' type='quantitative' />
            <column caption='Tribe' datatype='string' name='[tribe]' role='dimension' type='nominal' />
