            </column>
            <column caption='Business Days Count.from Parameter' datatype='integer' name='[Calculation_1439463056645197827]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,&#10;// start date adjusted to first business date if weekend&#10;(IF DATEPART(&apos;weekday&apos;,[Parameters].[Parameter 6])=7 THEN DATEADD(&apos;day&apos;, 2, [Parameters].[Parameter 6])&#10;ELSEIF DATEPART(&apos;weekday&apos;,[Parameters].[Parameter 6])=1 THEN DATEADD(&apos;day&apos;, 1, [Parameters].[Parameter 6])&#10;ELSE [Parameters].[Parameter 6] END),&#10;// end date trimmed to last business day if weekend&#10;(IF DATEPART(&apos;weekday&apos;,[Parameters].[Parameter 7])=7 THEN DATEADD(&apos;day&apos;, -1, [Parameters].[Parameter 7])&#10;ELSEIF DATEPART(&apos;weekday&apos;,[Parameters].[Parameter 7])=1 THEN DATEADD(&apos;day&apos;, -2, [Parameters].[Parameter 7])&#10;ELSE [Parameters].[Parameter 7] END)&#10;)-(&#10;&#10;// subtracts the weekend days&#10;DATEDIFF(&apos;week&apos;,&#10;// start date adjusted to first business date if weekend&#10;(IF DATEPART(&apos;weekday&apos;,[Parameters].[Parameter 6])=7 THEN DATEADD(&apos;day&apos;, 2, [Parameters].[Parameter 6])&#10;ELSEIF DATEPART(&apos;weekday&apos;,[Parameters].[Parameter 6])=1 THEN DATEADD(&apos;day&apos;, 1, [Parameters].[Parameter 6])&#10;ELSE [Parameters].[Parameter 6] END),&#10;// end date trimmed to last business day if weekend&#10;(IF DATEPART(&apos;weekday&apos;,[Parameters].[Parameter 7])=7 THEN DATEADD(&apos;day&apos;, -1, [Parameters].[Parameter 7])&#10;ELSEIF DATEPART(&apos;weekday&apos;,[Parameters].[Parameter 7])=1 THEN DATEADD(&apos;day&apos;, -2, [Parameters].[Parameter 7])&#10;ELSE [Parameters].[Parameter 7] END)&#10;)*2)&#10;+1' />
            </column>
            <column caption='Deployment per Eng KPI.selected Period' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1439463056652308484]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1439463056653832197])/SUM([Calculation_1439463056642265089])/[Calculation_1439463056645197827]' />
            </column>
            <column caption='Deployment Counts.selected Period' datatype='integer' name='[Calculation_1439463056653832197]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_138696862754549762],[deployment_counts],0)' />
            </column>
            <column caption='Fintech Tribe.main-filter' datatype='boolean' name='[Calculation_182677260892385280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF( [Parameters].[Parameter 4]=&apos;all&apos;,TRUE,&#10;CONTAINS(LOWER([tribe]),&#10;    CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;pay&apos;      THEN &apos;payment&apos;&#10;    WHEN &apos;wal&apos;      THEN &apos;wallet&apos;&#10;    WHEN &apos;risk&apos;     THEN &apos;risk&apos;&#10;    END)&#10;)' />
            </column>
