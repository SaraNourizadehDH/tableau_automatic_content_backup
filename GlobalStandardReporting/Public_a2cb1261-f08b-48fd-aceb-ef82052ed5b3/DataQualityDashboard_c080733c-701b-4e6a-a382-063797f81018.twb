          <datasource-dependencies datasource='table_overview (cl_govops)  (local copy)'>
            <column caption='WoW DQ' datatype='real' name='[Calculation_2591188280809029633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_4055984062122708999]) - LOOKUP(ZN([Calculation_4055984062122708999]), -1)) / ABS(LOOKUP(ZN([Calculation_4055984062122708999]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Overall Data Quality score' datatype='real' name='[Calculation_4055984062122708999]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([data_quality_score]* [data_quality_num_checks])&#10;/SUM([data_quality_num_checks]))*100' />
            </column>
            <column caption='LAST' datatype='boolean' name='[Calculation_4055984062123114507]' role='measure' type='nominal'>
