      <column caption='Latest date' datatype='boolean' name='[Calculation_1853372030742917121]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATE([check_last_run_at_utc]) = {FIXED : MAX(DATE([check_last_run_at_utc]))}' />
      </column>
      <column caption='Number of Check Types' datatype='integer' name='[Calculation_1853372030746243075]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;     WHEN &apos;Completeness&apos;&#10;     THEN SUM(IF [metric_type] = &apos;completeness&apos; THEN 1 ELSE NULL END)&#10;     WHEN &apos;Correctness&apos;&#10;     THEN SUM(IF [metric_type] = &apos;correctness&apos; THEN 1 ELSE NULL END)&#10;     WHEN &apos;Uniqueness&apos;&#10;     THEN SUM(IF [metric_type] = &apos;uniqueness&apos; THEN 1 ELSE NULL END)&#10;     WHEN &apos;Validity&apos;&#10;     THEN SUM(IF [metric_type] = &apos;validity&apos; THEN 1 ELSE NULL END)&#10;     WHEN &apos;Global Quality Monitoring&apos;&#10;     THEN SUM(IF [metric_source] = &apos;global quality monitoring&apos; THEN 1 ELSE NULL END)&#10;     ELSE SUM(IF [metric_source] = &apos;great expectations&apos; THEN 1 ELSE NULL END)&#10;END' />
      </column>
      <column caption='Is success?' datatype='integer' name='[Calculation_2179460779074342912]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF (SUM([total_rows]) = SUM([total_rows_passed]))&#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Report Updated' datatype='datetime' name='[Calculation_3105231990026952704]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([report_updated_at_utc])' />
      </column>
      <column caption='Git' datatype='string' name='[Calculation_3259761730302054400]' role='dimension' type='nominal'>
