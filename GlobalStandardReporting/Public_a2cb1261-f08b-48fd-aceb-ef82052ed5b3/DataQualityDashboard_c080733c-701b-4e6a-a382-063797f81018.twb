            <column caption='Filter Date' datatype='boolean' name='[Calculation_1579567246460465153]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[report_date] = {FIXED : MAX([report_date])}' />
            </column>
            <column caption='% Column Descriptions' datatype='real' default-format='p0.00%' name='[Calculation_4055984062121730049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] &#10;     WHEN &apos;cl&apos;&#10;     THEN SUM(IF [datahub_layer] = &apos;cl&apos; THEN [num_columns_with_descriptions] ELSE NULL END)/SUM(IF [datahub_layer] = &apos;cl&apos; THEN [num_columns] ELSE NULL END)&#10;     WHEN &apos;curated_data_shared&apos;&#10;     THEN SUM(IF [datahub_layer] = &apos;curated_data_shared&apos; THEN [num_columns_with_descriptions] ELSE NULL END)/SUM(IF [datahub_layer] = &apos;curated_data_shared&apos; THEN [num_columns] ELSE NULL END)&#10;     WHEN &apos;dl&apos;&#10;     THEN SUM(IF [datahub_layer] = &apos;dl&apos; THEN [num_columns_with_descriptions] ELSE NULL END)/SUM(IF [datahub_layer] = &apos;dl&apos; THEN [num_columns] ELSE NULL END)&#10;     WHEN &apos;raw&apos;&#10;     THEN SUM(IF [datahub_layer] = &apos;raw&apos; THEN [num_columns_with_descriptions] ELSE NULL END)/SUM(IF [datahub_layer] = &apos;raw&apos; THEN [num_columns] ELSE NULL END)&#10;     ELSE SUM(IF [datahub_layer] = &apos;rl&apos; THEN [num_columns_with_descriptions] ELSE NULL END)/SUM(IF [datahub_layer] = &apos;rl&apos; THEN [num_columns] ELSE NULL END)&#10;END' />
            </column>
            <column caption='% Table Descriptions' datatype='real' name='[Calculation_4055984062121844738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] &#10;     WHEN &apos;cl&apos;&#10;     THEN SUM(IF [datahub_layer] = &apos;cl&apos; AND [has_table_description] = TRUE THEN 1 ELSE NULL END)/SUM(IF [datahub_layer] = &apos;cl&apos; THEN 1 ELSE NULL END)&#10;     WHEN &apos;curated_data_shared&apos;&#10;     THEN SUM(IF [datahub_layer] = &apos;curated_data_shared&apos; AND [has_table_description] = TRUE THEN 1 ELSE NULL END)/SUM(IF [datahub_layer] = &apos;curated_data_shared&apos; THEN 1 ELSE NULL END)&#10;     WHEN &apos;dl&apos;&#10;     THEN SUM(IF [datahub_layer] = &apos;dl&apos; AND [has_table_description] = TRUE THEN 1 ELSE NULL END)/SUM(IF [datahub_layer] = &apos;dl&apos; THEN 1 ELSE NULL END)&#10;     WHEN &apos;raw&apos;&#10;     THEN SUM(IF [datahub_layer] = &apos;raw&apos; AND [has_table_description] = TRUE THEN 1 ELSE NULL END)/SUM(IF [datahub_layer] = &apos;raw&apos; THEN 1 ELSE NULL END)&#10;     ELSE SUM(IF [datahub_layer] = &apos;rl&apos; AND [has_table_description] = TRUE THEN 1 ELSE NULL END)/SUM(IF [datahub_layer] = &apos;rl&apos; THEN 1 ELSE NULL END)&#10;END' />
            </column>
