          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Check Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Global Quality Monitoring&quot;'>
              <calculation class='tableau' formula='&quot;Global Quality Monitoring&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='table_overview (cl_govops)  (local copy)'>
            <column caption='Comparison KPI' datatype='real' name='[Calculation_4055984062121525248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;     WHEN &apos;Completeness&apos;&#10;     THEN [Calculation_4055984062122016771]&#10;     WHEN &apos;Correctness&apos;&#10;     THEN [Calculation_4055984062122151940]&#10;     WHEN &apos;Uniqueness&apos;&#10;     THEN [Calculation_4055984062124912665]&#10;     WHEN &apos;Validity&apos;&#10;     THEN [Calculation_4055984062124834840]&#10;     WHEN &apos;Global Quality Monitoring&apos;&#10;     THEN [Calculation_4055984062122913801]&#10;     ELSE [Calculation_4055984062122864648]&#10;END' />
            </column>
            <column caption='Comp' datatype='real' name='[Calculation_4055984062122016771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([completeness_score]* [completeness_num_checks])&#10;/SUM([completeness_num_checks]))*100' />
            </column>
            <column caption='Corr' datatype='real' name='[Calculation_4055984062122151940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([correctness_score]* [correctness_num_checks])&#10;/SUM([correctness_num_checks]))*100' />
            </column>
            <column caption='Overall Data Quality score' datatype='real' name='[Calculation_4055984062122708999]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([data_quality_score]* [data_quality_num_checks])&#10;/SUM([data_quality_num_checks]))*100' />
            </column>
            <column caption='GE Score' datatype='real' name='[Calculation_4055984062122864648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([great_expectations_score]* [great_expectations_num_checks])&#10;/SUM([great_expectations_num_checks]))*100' />
            </column>
            <column caption='GQM Score' datatype='real' name='[Calculation_4055984062122913801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([global_quality_monitoring_score]* [global_quality_monitoring_num_checks])&#10;/SUM([global_quality_monitoring_num_checks]))*100' />
            </column>
            <column caption='Val' datatype='real' name='[Calculation_4055984062124834840]' role='measure' type='quantitative'>
