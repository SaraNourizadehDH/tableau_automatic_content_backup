              <calculation class='tableau' formula='IF SUM([Metric: Avg. Category Sessions, Summary (copy)_6336846160847155202]) &gt;= 1000000000 THEN &quot;B&quot;&#10;ELSEIF SUM([Metric: Avg. Category Sessions, Summary (copy)_6336846160847155202]) &gt;= 1000000 THEN &quot;M&quot;&#10;ELSEIF SUM([Metric: Avg. Category Sessions, Summary (copy)_6336846160847155202]) &gt;= 1000 THEN &quot;k&quot;&#10;ELSE &quot;&quot;&#10;END' />
            </column>
            <column caption='Metric: Avg. PDP Sessions, Summary' datatype='real' name='[Metric: Avg. Category Sessions, Summary (copy)_6336846160847155202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED: SUM({INCLUDE [brand],[country],[global_entity_id],[platform],[partition_date]: MAX([nr_pdp_s])})/COUNTD([Calculation_4321274220019838976])}' />
            </column>
            <column caption='Rounding: Sessions, PDP' datatype='real' name='[Rounding: Sessions, Category (copy)_6336846160847269891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Metric: Avg. Category Sessions, Summary (copy)_6336846160847155202]) &gt;= 1000000000 THEN ROUND(SUM([Metric: Avg. Category Sessions, Summary (copy)_6336846160847155202]) / 1000000000,1)&#10;ELSEIF SUM([Metric: Avg. Category Sessions, Summary (copy)_6336846160847155202])  &gt;= 1000000 THEN ROUND(SUM([Metric: Avg. Category Sessions, Summary (copy)_6336846160847155202]) / 1000000,1)&#10;ELSEIF SUM([Metric: Avg. Category Sessions, Summary (copy)_6336846160847155202]) &gt;= 1000 THEN ROUND(SUM([Metric: Avg. Category Sessions, Summary (copy)_6336846160847155202]) / 1000,1)&#10;ELSE ROUND(SUM([Metric: Avg. Category Sessions, Summary (copy)_6336846160847155202]), 0)&#10;END' />
            </column>
