            <column caption='Metric: Category, ATR' datatype='real' name='[Metric: CTR per Category (copy)_4321274220390608920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([nr_atc_s])/SUM([nr_cat_visit_s])) * [Metric: Category CTR (copy)_4321274220388642839]' />
            </column>
            <column caption='Metric: Category, CTR' datatype='real' name='[Metric: Category CTR (copy)_4321274220388642839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Sessions: Daily (copy)_4321274220383862803]/[Summary: Sessions (copy)_5421982116838203392]' />
            </column>
            <column caption='Metric: Category, Conversion' datatype='real' name='[Metric: Category, CTR (copy)_4321274220391383065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([nr_atc_n_trx_s])/SUM([nr_atc_s])) * [Metric: CTR per Category (copy)_4321274220390608920] * [Metric: Category CTR (copy)_4321274220388642839]' />
            </column>
            <column caption='Summary: Sessions, Category' datatype='real' name='[Sessions: Daily (copy)_4321274220383862803]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({INCLUDE [brand],[country],[global_entity_id],[platform],[partition_date]: MEDIAN([nr_cat_sessions])})/COUNTD([Calculation_4321274220019838976])' />
            </column>
            <column caption='Summary: Sessions, Overview' datatype='real' name='[Summary: Sessions (copy)_5421982116838203392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN({FIXED: SUM({INCLUDE [brand],[country],[global_entity_id],[platform],[partition_date]: MEDIAN([nr_dm_sessions])})/COUNTD([Calculation_4321274220019838976])})' />
            </column>
