      <aliases enabled='yes' />
      <column caption='Period' datatype='string' name='[Calculation_4321274220019838976]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Day&apos; THEN &#10;    STR(DATEPART(&apos;year&apos;, [partition_date])) + STR(&apos;-&apos;) + STR(DATEPART(&apos;month&apos;, [partition_date])) + STR(&apos;-&apos;) + STR(DATEPART(&apos;day&apos;, [partition_date]))&#10;&#9;&#10;WHEN &apos;Week&apos; THEN &#10;&#9;STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;iso-week&apos;,[partition_date]))) + STR(&quot;-W&quot;) &#10;&#9;+ STR(DATEPART(&apos;iso-week&apos;,[partition_date]))&#10;&#10;WHEN &apos;Month&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date])) &#10;&#9;+ STR(&quot;-&quot;) &#10;&#9;+ IF DATEPART(&apos;month&apos;, [partition_date]) &lt; 10 THEN STR(&quot;0&quot;) ELSE STR(&quot;&quot;) END&#10;&#9;+ STR(DATEPART(&apos;month&apos;, [partition_date]))&#10;&#10;WHEN &apos;Quarter&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date])) + STR(&quot;-Q&quot;) + STR(DATEPART(&apos;quarter&apos;, [partition_date]))&#10;WHEN &apos;Year&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date]))&#10;END' />
      </column>
      <column caption='Top N vs. Others' datatype='string' name='[Calculation_4321274220021506050]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [category_name Set] THEN [category_name] ELSE &apos;Other&apos; END' />
      </column>
      <column caption='Top 10' datatype='boolean' name='[Calculation_4321274220023033859]' role='measure' type='nominal'>
        <calculation class='tableau' formula='index()&lt;=10'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='STR: Category Visits, Sessions' datatype='integer' name='[Calculation_4321274220025208836]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM([nr_cat_visit_s])' />
      </column>
      <column caption='Filter: Partial Period' datatype='boolean' name='[Calculation_4321274220026925061]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;,[partition_date]) = DATETRUNC(&apos;day&apos;,[partition_date])&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[partition_date]) &lt; {FIXED : MAX(DATETRUNC(&apos;month&apos;,[partition_date]))}&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;iso-week&apos;,[partition_date]) &gt; {FIXED : MIN(DATETRUNC(&apos;iso-week&apos;, [partition_date]))} AND DATETRUNC(&apos;iso-week&apos;,[partition_date]) &lt; {FIXED : MAX(DATETRUNC(&apos;iso-week&apos;, [partition_date]))} &#10;END' />
      </column>
      <column caption='Summary: Sessions' datatype='real' name='[Calculation_4321274220031500295]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({INCLUDE [brand],[country],[global_entity_id],[platform],[partition_date]: MEDIAN([nr_dm_sessions])})/COUNTD([Calculation_4321274220019838976])' />
      </column>
      <column caption='Rounding: Sessions' datatype='real' name='[Calculation_4321274220340256776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_4321274220031500295] &gt;= 1000000000 THEN ROUND([Calculation_4321274220031500295] / 1000000000, 1)&#10;ELSEIF [Calculation_4321274220031500295] &gt;= 1000000 THEN ROUND([Calculation_4321274220031500295] / 1000000, 1)&#10;ELSEIF [Calculation_4321274220031500295] &gt;= 1000 THEN ROUND([Calculation_4321274220031500295] / 1000, 1)&#10;ELSE ROUND([Calculation_4321274220031500295], 0)&#10;END' />
      </column>
      <column caption='Custom Formatting: Sessions' datatype='string' name='[Calculation_4321274220340604937]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4321274220031500295] &gt;= 1000000000 THEN &quot;B&quot;&#10;ELSEIF [Calculation_4321274220031500295] &gt;= 1000000 THEN &quot;M&quot;&#10;ELSEIF [Calculation_4321274220031500295] &gt;= 1000 THEN &quot;k&quot;&#10;ELSE &quot;&quot;&#10;END' />
      </column>
      <column caption='Filter: Category Name' datatype='boolean' name='[Calculation_4321274220355395595]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Curated Category Names] = [Parameters].[Parameter 3]' />
      </column>
      <column caption='Aggregation Level, Labels' datatype='string' name='[Calculation_4321274220377591821]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Day&apos; THEN &apos;Dai&apos;&#10;ELSE [Parameters].[Parameter 1]&#10;END' />
      </column>
      <column caption='Metric: CTR, Summary - Category' datatype='real' name='[Calculation_4321274220380295184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Metric: Avg. Category Sessions (copy)_5567786155499479043])/[Summary: Sessions (copy)_5421982116838203392]' />
      </column>
      <column caption='Legend: Category Colours' datatype='string' name='[Calculation_5663487647600742400]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Curated Category Names] = [Parameters].[Parameter 3] THEN &apos;Colour&apos;&#10;ELSE &apos;Other&apos;&#10;END' />
      </column>
      <column caption='Colour: Category Names' datatype='string' datatype-customized='true' name='[Calculation_5663487647604617218]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [Curated Category Names] = [Parameters].[Parameter 3] Then &quot;Red&quot; END' />
      </column>
