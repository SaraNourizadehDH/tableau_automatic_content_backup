      <table>
        <view>
          <datasources>
            <datasource caption='Assortment' name='federated.189vvuf0hjohza1b4vz270ylelc6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Aggregation Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
            <column caption='Select Category' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Beverages&quot;'>
              <calculation class='tableau' formula='&quot;Beverages&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.189vvuf0hjohza1b4vz270ylelc6'>
            <column caption='Period' datatype='string' name='[Calculation_4321274220019838976]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Day&apos; THEN &#10;    STR(DATEPART(&apos;year&apos;, [partition_date])) + STR(&apos;-&apos;) + STR(DATEPART(&apos;month&apos;, [partition_date])) + STR(&apos;-&apos;) + STR(DATEPART(&apos;day&apos;, [partition_date]))&#10;&#9;&#10;WHEN &apos;Week&apos; THEN &#10;&#9;STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;iso-week&apos;,[partition_date]))) + STR(&quot;-W&quot;) &#10;&#9;+ STR(DATEPART(&apos;iso-week&apos;,[partition_date]))&#10;&#10;WHEN &apos;Month&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date])) &#10;&#9;+ STR(&quot;-&quot;) &#10;&#9;+ IF DATEPART(&apos;month&apos;, [partition_date]) &lt; 10 THEN STR(&quot;0&quot;) ELSE STR(&quot;&quot;) END&#10;&#9;+ STR(DATEPART(&apos;month&apos;, [partition_date]))&#10;&#10;WHEN &apos;Quarter&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date])) + STR(&quot;-Q&quot;) + STR(DATEPART(&apos;quarter&apos;, [partition_date]))&#10;WHEN &apos;Year&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date]))&#10;END' />
            </column>
            <column caption='Filter: Partial Period' datatype='boolean' name='[Calculation_4321274220026925061]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;,[partition_date]) = DATETRUNC(&apos;day&apos;,[partition_date])&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[partition_date]) &lt; {FIXED : MAX(DATETRUNC(&apos;month&apos;,[partition_date]))}&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;iso-week&apos;,[partition_date]) &gt; {FIXED : MIN(DATETRUNC(&apos;iso-week&apos;, [partition_date]))} AND DATETRUNC(&apos;iso-week&apos;,[partition_date]) &lt; {FIXED : MAX(DATETRUNC(&apos;iso-week&apos;, [partition_date]))} &#10;END' />
            </column>
            <column caption='Filter: Category Name' datatype='boolean' name='[Calculation_4321274220355395595]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Curated Category Names] = [Parameters].[Parameter 3]' />
            </column>
            <column caption='Aggregation Level, Labels' datatype='string' name='[Calculation_4321274220377591821]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Day&apos; THEN &apos;Dai&apos;&#10;ELSE [Parameters].[Parameter 1]&#10;END' />
