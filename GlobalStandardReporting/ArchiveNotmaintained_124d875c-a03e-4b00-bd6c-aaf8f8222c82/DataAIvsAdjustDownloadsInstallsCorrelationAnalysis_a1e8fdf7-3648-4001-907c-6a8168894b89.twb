    <worksheet name='correlation_strength_by_entity'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Correlation by </run>
            <run bold='true'>Entity</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dataai_adjust_correlated (adhoc_analysis)' name='federated.0z54mo507iyd6p11pvnqc1krcj2x' />
          </datasources>
          <datasource-dependencies datasource='federated.0z54mo507iyd6p11pvnqc1krcj2x'>
            <column caption='Correlation Strength (Total / Paid)' datatype='string' name='[Calculation_1790532737206292480]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([corr_1_total_vs_total] &gt;= 0.21 AND [corr_1_total_vs_total] &lt;= .6) OR ([corr_2_total_vs_paid] &gt;= 0.21 AND [corr_2_total_vs_paid] &lt;= .6) THEN &quot;medium&quot;&#10;ELSEIF ([corr_1_total_vs_total] &gt;= 0.61 AND [corr_1_total_vs_total] &lt;= .8) OR ([corr_2_total_vs_paid] &gt;= 0.61 AND [corr_2_total_vs_paid] &lt;= .8) THEN &quot;strong&quot;&#10;ELSEIF [corr_1_total_vs_total] &gt;= 0.81 OR [corr_2_total_vs_paid] &gt;= 0.81 THEN &quot;very strong&quot;&#10;ELSE &quot;low&quot;&#10;END' />
              <aliases>
                <alias key='&quot;low&quot;' value='low correlation (&lt;= 0.2)' />
                <alias key='&quot;medium&quot;' value='medium correlation (0.21 - 0.6)' />
                <alias key='&quot;strong&quot;' value='strong correlation (&gt;= 0.61 - 0.8)' />
                <alias key='&quot;very strong&quot;' value='very strong correlation (&gt;= 0.81)' />
              </aliases>
            </column>
            <column caption='Recommendation' datatype='string' name='[Calculation_1790532737212440578]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1790532737206292480] = &apos;low&apos; THEN &apos;Exclude from dashboards and tables&apos;&#10;ELSEIF ([Calculation_1790532737206292480] = &apos;medium&apos; OR [Calculation_1790532737206292480] = &apos;strong&apos; OR [Calculation_1790532737206292480] = &apos;very strong&apos;) AND [Calculation_4301008051724480512] &lt;= -0.05 THEN &apos;Display data.ai Total Downloads w/ disclaimer in dashboards or exclude&apos;&#10;ELSEIF ([Calculation_1790532737206292480] = &apos;medium&apos; OR [Calculation_1790532737206292480] = &apos;strong&apos; OR [Calculation_1790532737206292480] = &apos;very strong&apos;) AND [Calculation_4301008051724480512] &gt; -0.05 THEN &apos;Display data.ai Total Downloads in dashboards&apos;&#10;ELSE &apos;unknown&apos;&#10;END' />
            </column>
            <column caption='Decision KPI (total vs Paid)' datatype='real' default-format='p0.0%' name='[Calculation_4301008051724480512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[corr_1_total_vs_total]-[corr_2_total_vs_paid]' />
            </column>
            <column-instance column='[Calculation_4301008051724480512]' derivation='Attribute' name='[attr:Calculation_4301008051724480512:ok]' pivot='key' type='ordinal' />
            <column-instance column='[corr_1_total_vs_total]' derivation='Attribute' name='[attr:corr_1_total_vs_total:ok]' pivot='key' type='ordinal' />
            <column-instance column='[corr_2_total_vs_paid]' derivation='Attribute' name='[attr:corr_2_total_vs_paid:ok]' pivot='key' type='ordinal' />
            <column caption='Correlation 1 Total Vs Total' datatype='real' default-format='p0.0%' name='[corr_1_total_vs_total]' role='measure' type='quantitative' />
            <column caption='Correlation 2 Total Vs Paid' datatype='real' default-format='p0.0%' name='[corr_2_total_vs_paid]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1790532737206292480]' derivation='None' name='[none:Calculation_1790532737206292480:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1790532737212440578]' derivation='None' name='[none:Calculation_1790532737212440578:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
            <column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4301008051724480512]' derivation='Sum' name='[sum:Calculation_4301008051724480512:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <computed-sort column='[federated.0z54mo507iyd6p11pvnqc1krcj2x].[none:Calculation_1790532737212440578:nk]' direction='ASC' using='[federated.0z54mo507iyd6p11pvnqc1krcj2x].[sum:Calculation_4301008051724480512:qk]' />
          <filter class='categorical' column='[federated.0z54mo507iyd6p11pvnqc1krcj2x].[none:segment:nk]'>
            <groupfilter function='member' level='[none:segment:nk]' member='&quot;America&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <_.fcp.SingleValuePerNestSorting.true...single-value-per-nest-shelf-sorts>
