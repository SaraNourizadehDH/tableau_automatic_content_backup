      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dataai_adjust_correlated (adhoc_analysis)' name='federated.0z54mo507iyd6p11pvnqc1krcj2x' />
          </datasources>
          <datasource-dependencies datasource='federated.0z54mo507iyd6p11pvnqc1krcj2x'>
            <column caption='Decision KPI (total vs Paid)' datatype='real' default-format='p0.0%' name='[Calculation_4301008051724480512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[corr_1_total_vs_total]-[corr_2_total_vs_paid]' />
            </column>
            <column caption='Is Hypothesis 1 (total vs paid)' datatype='boolean' name='[Calculation_4301008051724726273]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_4301008051724480512]&lt;-0.1 THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='# of Countries with Correlation of Adj-Paid bigger than Adj-Total' datatype='integer' name='[Calculation_4301008051727527940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;IF [Calculation_4301008051724726273]&#10;THEN [global_entity_id]&#10;END)' />
            </column>
