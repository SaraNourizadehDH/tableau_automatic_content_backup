      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0z54mo507iyd6p11pvnqc1krcj2x]&quot;' value='# of Countries' />
        </aliases>
      </column>
      <column caption='Correlation Strength (Total / Paid)' datatype='string' name='[Calculation_1790532737206292480]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([corr_1_total_vs_total] &gt;= 0.21 AND [corr_1_total_vs_total] &lt;= .6) OR ([corr_2_total_vs_paid] &gt;= 0.21 AND [corr_2_total_vs_paid] &lt;= .6) THEN &quot;medium&quot;&#10;ELSEIF ([corr_1_total_vs_total] &gt;= 0.61 AND [corr_1_total_vs_total] &lt;= .8) OR ([corr_2_total_vs_paid] &gt;= 0.61 AND [corr_2_total_vs_paid] &lt;= .8) THEN &quot;strong&quot;&#10;ELSEIF [corr_1_total_vs_total] &gt;= 0.81 OR [corr_2_total_vs_paid] &gt;= 0.81 THEN &quot;very strong&quot;&#10;ELSE &quot;low&quot;&#10;END' />
        <aliases>
          <alias key='&quot;low&quot;' value='low correlation (&lt;= 0.2)' />
          <alias key='&quot;medium&quot;' value='medium correlation (0.21 - 0.6)' />
          <alias key='&quot;strong&quot;' value='strong correlation (&gt;= 0.61 - 0.8)' />
          <alias key='&quot;very strong&quot;' value='very strong correlation (&gt;= 0.81)' />
        </aliases>
      </column>
      <column caption='Recommendation' datatype='string' name='[Calculation_1790532737212440578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1790532737206292480] = &apos;low&apos; THEN &apos;Exclude from dashboards and tables&apos;&#10;ELSEIF ([Calculation_1790532737206292480] = &apos;medium&apos; OR [Calculation_1790532737206292480] = &apos;strong&apos; OR [Calculation_1790532737206292480] = &apos;very strong&apos;) AND [Calculation_4301008051724480512] &lt;= -0.05 THEN &apos;Display data.ai Total Downloads w/ disclaimer in dashboards or exclude&apos;&#10;ELSEIF ([Calculation_1790532737206292480] = &apos;medium&apos; OR [Calculation_1790532737206292480] = &apos;strong&apos; OR [Calculation_1790532737206292480] = &apos;very strong&apos;) AND [Calculation_4301008051724480512] &gt; -0.05 THEN &apos;Display data.ai Total Downloads in dashboards&apos;&#10;ELSE &apos;unknown&apos;&#10;END' />
      </column>
      <column caption='decision_rank' datatype='string' name='[Calculation_1790532737220399108]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(MAX([Calculation_1790532737206292480])) + &quot;-&quot; +&#10;STR(RANK_DENSE(MAX([Calculation_4301008051724480512]), &apos;asc&apos;))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Decision KPI (total vs Paid)' datatype='real' default-format='p0.0%' name='[Calculation_4301008051724480512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[corr_1_total_vs_total]-[corr_2_total_vs_paid]' />
      </column>
      <column caption='Is Hypothesis 1 (total vs paid)' datatype='boolean' name='[Calculation_4301008051724726273]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4301008051724480512]&lt;-0.1 THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='# of Countries with Correlation of Adj-Paid bigger than Adj-Total' datatype='integer' name='[Calculation_4301008051727527940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [Calculation_4301008051724726273]&#10;THEN [global_entity_id]&#10;END)' />
      </column>
      <column caption='# of Countries' datatype='integer' name='[Calculation_5283777949526757376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([global_entity_id])' />
      </column>
      <column caption='Decision KPI 2(total vs android)' datatype='real' default-format='p0.0%' name='[Decision KPI (total vs Paid) (copy)_4301922860183814145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[corr_1_total_vs_total]-[corr_4_total_vs_android]' />
      </column>
      <column caption='Decision KPI 1 (total vs unPaid)' datatype='real' default-format='p0.0%' name='[Decision KPI (total vs Paid) (copy)_4301922860218171406]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[corr_1_total_vs_total]-[corr_3_total_vs_unpaid]' />
      </column>
      <column caption='Decision KPI 2a(total vs android-paid)' datatype='real' default-format='p0.0%' name='[Decision KPI 2(total vs android) (copy)_4301922860184059906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[corr_1_total_vs_total]-[corr_4b_android_vs_android_paid]' />
      </column>
      <column caption='Decision KPI 3a(total vs ios-paid)' datatype='real' default-format='p0.0%' name='[Decision KPI 3(total vs android-paid) (copy)_4301922860184244227]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[corr_1_total_vs_total]-[corr_5b_ios_vs_ios_paid]' />
      </column>
      <column caption='Decision KPI 3(total vs ios)' datatype='real' default-format='p0.0%' name='[Decision KPI 4(total vs ios-paid) (copy)_4301922860184608773]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[corr_1_total_vs_total]-[corr_5_total_vs_ios]' />
      </column>
      <column caption='Is Hypothesis 2 (total vs android)' datatype='boolean' name='[Is Hypothesis 1 (copy)_4301922860184416260]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Decision KPI (total vs Paid) (copy)_4301922860183814145]&lt;-0.1 THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Is Hypothesis 1 Rec 3' datatype='boolean' name='[Is Hypothesis 1 (total vs paid) (copy)_4301922860212822028]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4301008051724480512]&lt;-0.1 THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Is Hypothesis 2a (total vs android-paid)' datatype='boolean' name='[Is Hypothesis 2 (total vs android) (copy)_4301922860184768518]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Decision KPI 2(total vs android) (copy)_4301922860184059906]&lt;-0.1 THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Is Hypothesis 3 (total vs ios)' datatype='boolean' name='[Is Hypothesis 2a (total vs android-paid) (copy)_4301922860184866823]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Decision KPI 4(total vs ios-paid) (copy)_4301922860184608773]&lt;-0.1 THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
