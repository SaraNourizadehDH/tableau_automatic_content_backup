        <calculation class='tableau' formula='IF [Decision KPI 3(total vs android-paid) (copy)_4301922860184244227]&lt;-0.1 THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Recommendation (egemen)' datatype='string' name='[Recommendation (copy)_4301922860177006592]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4301008051724480512]&lt; -0.5 THEN &apos;Exclude from dashboards and tables&apos;&#10;ELSEIF  [Calculation_4301008051724480512] &lt;= -0.1 THEN &apos;Display data.ai Total Downloads w/ disclaimer in dashboards or exclude&apos;&#10;ELSEIF  ISNULL([Calculation_4301008051724480512] ) THEN &apos;N/A&apos;&#10;ELSE &apos;Display data.ai Total Downloads in dashboards&apos;&#10;&#10;END' />
      </column>
      <column caption='Recommendation 3' datatype='string' name='[Recommendation (egemen) (copy)_4301922860207140873]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT( MAX(MAX([corr_1_total_vs_total], [corr_2_total_vs_paid]), [corr_3_total_vs_unpaid])&gt;0.2) &#10;        THEN &apos;Exclude data.ai downloads, Too low correlation with Totals&apos;&#10;&#10;ELSEIF [Calculation_4301008051724480512] &lt;= -0.05  THEN &apos;Attention, data.ai downloads higher correlation with Paid than Totals&apos;&#10;ELSEIF [Decision KPI (total vs Paid) (copy)_4301922860218171406] &lt;= -0.05  THEN &apos;Attention, data.ai downloads higher correlation with UnPaid than Totals&apos;&#10;&#10;&#10;ELSE &apos;Display, data.ai downloads are confident&apos;&#10;END' />
      </column>
      <column caption='Recommendation 3.1' datatype='string' name='[Recommendation 3 (copy)_4301922860252143631]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT( MAX(MAX([corr_1_total_vs_total], [corr_2_total_vs_paid]), [corr_3_total_vs_unpaid])&gt;0.3) &#10;        THEN &apos;Exclude data.ai downloads, Too low correlation with Totals&apos;&#10;&#10;ELSEIF [Calculation_4301008051724480512] &lt;= -0.1  THEN &apos;Attention, data.ai downloads higher correlation with Paid than Totals&apos;&#10;ELSEIF [Decision KPI (total vs Paid) (copy)_4301922860218171406] &lt;= -0.1  THEN &apos;Attention, data.ai downloads higher correlation with UnPaid than Totals&apos;&#10;&#10;&#10;ELSE &apos;Display, data.ai downloads are confident&apos;&#10;END' />
