    <worksheet name='entity_recommendations 3.1 (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Recommendations</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dataai_adjust_correlated (adhoc_analysis)' name='federated.0z54mo507iyd6p11pvnqc1krcj2x' />
          </datasources>
          <datasource-dependencies datasource='federated.0z54mo507iyd6p11pvnqc1krcj2x'>
            <column caption='Decision KPI (total vs Paid)' datatype='real' default-format='p0.0%' name='[Calculation_4301008051724480512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[corr_1_total_vs_total]-[corr_2_total_vs_paid]' />
            </column>
            <column caption='Decision KPI 1 (total vs unPaid)' datatype='real' default-format='p0.0%' name='[Decision KPI (total vs Paid) (copy)_4301922860218171406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[corr_1_total_vs_total]-[corr_3_total_vs_unpaid]' />
            </column>
            <column caption='Recommendation 3.1' datatype='string' name='[Recommendation 3 (copy)_4301922860252143631]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT( MAX(MAX([corr_1_total_vs_total], [corr_2_total_vs_paid]), [corr_3_total_vs_unpaid])&gt;0.3) &#10;        THEN &apos;Exclude data.ai downloads, Too low correlation with Totals&apos;&#10;&#10;ELSEIF [Calculation_4301008051724480512] &lt;= -0.1  THEN &apos;Attention, data.ai downloads higher correlation with Paid than Totals&apos;&#10;ELSEIF [Decision KPI (total vs Paid) (copy)_4301922860218171406] &lt;= -0.1  THEN &apos;Attention, data.ai downloads higher correlation with UnPaid than Totals&apos;&#10;&#10;&#10;ELSE &apos;Display, data.ai downloads are confident&apos;&#10;END' />
            </column>
            <column-instance column='[Recommendation 3 (copy)_4301922860252143631]' derivation='Count' name='[cnt:Recommendation 3 (copy)_4301922860252143631:qk]' pivot='key' type='quantitative' />
            <column caption='Correlation 1 Total Vs Total' datatype='real' default-format='p0.0%' name='[corr_1_total_vs_total]' role='measure' type='quantitative' />
            <column caption='Correlation 2 Total Vs Paid' datatype='real' default-format='p0.0%' name='[corr_2_total_vs_paid]' role='measure' type='quantitative' />
            <column caption='Correlation 3 Total Vs Unpaid' datatype='real' default-format='p0.0%' name='[corr_3_total_vs_unpaid]' role='measure' type='quantitative' />
            <column-instance column='[Recommendation 3 (copy)_4301922860252143631]' derivation='None' name='[none:Recommendation 3 (copy)_4301922860252143631:nk]' pivot='key' type='nominal' />
            <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
            <column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <manual-sort column='[federated.0z54mo507iyd6p11pvnqc1krcj2x].[none:Recommendation 3 (copy)_4301922860252143631:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Exclude data.ai downloads, Too low correlation with Totals&quot;</bucket>
              <bucket>&quot;Attention, data.ai downloads higher correlation with Paid than Totals&quot;</bucket>
              <bucket>&quot;Display, data.ai downloads are confident&quot;</bucket>
            </dictionary>
          </manual-sort>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='width' value='46' />
            <format attr='font-weight' value='bold' />
            <format attr='height' field='[federated.0z54mo507iyd6p11pvnqc1krcj2x].[cnt:Recommendation 3 (copy)_4301922860252143631:qk]' value='36' />
            <format attr='width' field='[federated.0z54mo507iyd6p11pvnqc1krcj2x].[:Measure Names]' value='66' />
          </style-rule>
          <style-rule element='header'>
            <format attr='width' field='[federated.0z54mo507iyd6p11pvnqc1krcj2x].[none:segment:nk]' value='68' />
            <format attr='width' field='[federated.0z54mo507iyd6p11pvnqc1krcj2x].[cnt:Recommendation 3 (copy)_4301922860252143631:qk]' value='280' />
            <format attr='width' field='[federated.0z54mo507iyd6p11pvnqc1krcj2x].[none:Recommendation 3 (copy)_4301922860252143631:nk]' value='340' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='cols' value='false' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Square' />
            <mark-sizing mark-sizing-setting='marks-scaling-off' />
            <encodings>
              <color column='[federated.0z54mo507iyd6p11pvnqc1krcj2x].[none:Recommendation 3 (copy)_4301922860252143631:nk]' />
              <text column='[federated.0z54mo507iyd6p11pvnqc1krcj2x].[cnt:Recommendation 3 (copy)_4301922860252143631:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
