  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Methodology and Conclusion'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/DataAIvsAdjustDownloadsInstallsCorrelationAnalysis/ReadMe?rev=' id='ReadMe' path='/t/GlobalStandardReporting/workbooks/DataAIvsAdjustDownloadsInstallsCorrelationAnalysis' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='500' maxwidth='900' minheight='500' minwidth='900' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='96800' id='3' type-v2='text' w='98222' x='889' y='1600'>
            <formatted-text>
              <run fontcolor='#000000' fontsize='12'>This dashboard shows the correlations between </run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Data-Ai estimation downloads and Adjust verified installs</run>
              <run fontcolor='#000000' fontsize='12'>.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>[Hypothesis 1]:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>The analysis is conducted to understand if Data-Ai total estimations are capturing either paid or unpaid part more than total.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>[Process]:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>In order to make a decision: </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>1-) All breakdowns with total numbers from both Data.Ai and Adjust has gathered (Can be accessed from Raw Data)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>2-)The correlations between these breakdowns with Data.Ai Total downloads has been observed in last 52 weeks [Correlations Table]</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>3-)Countries which have more correlation between Data.Ai Total downloads and Adjust Paid/Unpaid installs have been flagged.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>4-)Countries which don&apos;t have enough correllation either with Total/Paid/Unpaid parts have been flagged as &quot;not confident&quot;</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>Conclusion:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>- There are</run>
              <run bold='true' fontcolor='#cf0004' fontsize='12'> 6</run>
              <run fontcolor='#000000' fontsize='12'> countries which don&apos;t have any correlation with any of the breakdowns.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>- There are </run>
              <run bold='true' fontcolor='#f28e2b' fontsize='12'>12 </run>
              <run fontcolor='#000000' fontsize='12'>countries which have more correlation with Paid adjust numbers rather than Totals.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='12'>- And there are </run>
              <run bold='true' fontcolor='#59a14f' fontsize='12'>26</run>
              <run fontcolor='#000000' fontsize='12'> countries which the data.ai numbers show a trustable confidence with total adjust numbers.</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='50' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='49' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone forceUpdate='true' h='96800' id='3' type-v2='text' w='98222' x='889' y='1600'>
                  <formatted-text>
                    <run fontcolor='#000000' fontsize='12'>This dashboard shows the correlations between </run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Data-Ai estimation downloads and Adjust verified installs</run>
                    <run fontcolor='#000000' fontsize='12'>.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>[Hypothesis 1]:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>The analysis is conducted to understand if Data-Ai total estimations are capturing either paid or unpaid part more than total.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>[Process]:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>In order to make a decision: </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>1-) All breakdowns with total numbers from both Data.Ai and Adjust has gathered (Can be accessed from Raw Data)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>2-)The correlations between these breakdowns with Data.Ai Total downloads has been observed in last 52 weeks [Correlations Table]</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>3-)Countries which have more correlation between Data.Ai Total downloads and Adjust Paid/Unpaid installs have been flagged.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>4-)Countries which don&apos;t have enough correllation either with Total/Paid/Unpaid parts have been flagged as &quot;not confident&quot;</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Conclusion:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>- There are</run>
                    <run bold='true' fontcolor='#cf0004' fontsize='12'> 6</run>
                    <run fontcolor='#000000' fontsize='12'> countries which don&apos;t have any correlation with any of the breakdowns.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>- There are </run>
                    <run bold='true' fontcolor='#f28e2b' fontsize='12'>12 </run>
                    <run fontcolor='#000000' fontsize='12'>countries which have more correlation with Paid adjust numbers rather than Totals.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>- And there are </run>
                    <run bold='true' fontcolor='#59a14f' fontsize='12'>26</run>
                    <run fontcolor='#000000' fontsize='12'> countries which the data.ai numbers show a trustable confidence with total adjust numbers.</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{548E7C07-2DCC-49FD-9C7E-653B3DF60342}' />
    </dashboard>
