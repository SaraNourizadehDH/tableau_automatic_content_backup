      <column caption='full_period' datatype='boolean' name='[Calculation_407857241992077312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [period_granularity]&#10;when &apos;week&apos; then DATEDIFF(&apos;week&apos;,[fielddate],TODAY(),&apos;Monday&apos;)&gt;=1&#10;when &apos;month&apos; then DATEDIFF(&apos;month&apos;,[fielddate],TODAY(),&apos;Monday&apos;)&gt;=1&#10;when &apos;quarter&apos; then DATEDIFF(&apos;quarter&apos;,[fielddate],TODAY(),&apos;Monday&apos;)&gt;=1&#10;when &apos;day&apos; then TRUE&#10;else FALSE &#10;end' />
