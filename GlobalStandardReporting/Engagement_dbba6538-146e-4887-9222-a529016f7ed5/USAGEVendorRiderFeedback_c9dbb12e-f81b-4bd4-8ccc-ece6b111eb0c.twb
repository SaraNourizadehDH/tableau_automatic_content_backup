      <aliases enabled='yes' />
      <column caption='% of Total Vendors with Feedback' datatype='real' name='[% of Total Orders with Feedback (copy)_6560900232278249481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Orders (copy)_6560900232257753092]/SUM({ EXCLUDE [rider_review_emotion], [rider_review_topic_translated]: [Total Orders (copy)_6560900232257753092]})' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_1413074761834586112]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date_local]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date_local]))+&quot;-W&quot;+STR(ISOWEEK([created_date_local]))&#10;WHEN &quot;Monthly&quot; THEN STR(YEAR([created_date_local]))+&quot;-M&quot;+STR(MONTH([created_date_local]))&#10;END' />
      </column>
      <column caption='_user_entitlement' datatype='boolean' name='[Calculation_4029314359018389504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Total Contacts' datatype='integer' name='[Calculation_4029314359021948929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ FIXED [entity_id], [created_date_local]: MIN([contacts_per_entity])})' />
      </column>
      <column caption='% Related Contacts' datatype='real' name='[Calculation_4029314359022268419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Contacts (copy)_4029314359022178306]/[Calculation_4029314359021948929]' />
      </column>
      <column caption='Total Events' datatype='integer' name='[Calculation_6560900232234946560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ FIXED [entity_id], [vendor_code], [order_code]: MIN([events])})' />
      </column>
      <column caption='Total Orders with Feedback' datatype='integer' name='[Calculation_6560900232257691651]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_code])' />
      </column>
      <column caption='RANK' datatype='integer' name='[Calculation_6560900232274104326]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='RANK([Calculation_6560900232257691651])'>
          <table-calc ordering-field='[federated.1jst7hh0y50jbi18zwwdj18z2hue].[rider_review_topic_translated]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='% of Total Orders with Feedback' datatype='real' name='[Calculation_6560900232275550215]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6560900232257691651]/SUM({ EXCLUDE [rider_review_emotion], [rider_review_topic_translated]: [Calculation_6560900232257691651]})' />
      </column>
      <column caption='Total Related Contacts' datatype='integer' name='[Total Contacts (copy)_4029314359022178306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ FIXED [entity_id], [created_date_local]: MIN([related_contacts_per_entity])})' />
      </column>
      <column caption='Total Vendors with Feedback' datatype='integer' name='[Total Orders (copy)_6560900232257753092]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_code])' />
      </column>
      <column caption='Total Orders with Feedback per Entity' datatype='integer' name='[Total Orders with Feedback (copy)_6560900232266788869]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ FIXED [entity_id], [created_date_local]: COUNTD([order_code])})' />
      </column>
