      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_C177467386B744F4AF199A2826FA17C3'>
            <properties context=''>
              <relation connection='bigquery.07m5bmi1ttvfgh10rgkji1o6rbzq' name='Custom SQL Query' type='text'>with mss_weekly as (
SELECT  
week_start as date,
&quot;weekly&quot; as period,
&quot;mss&quot; as plugin,
&quot;?&quot; as main_product,
change_type as change_type,
global_entity_id,
country_name,
brand_name,
sum(total_count) as total_count,
sum(ss_count) as ss_count
FROM `fulfillment-dwh-production.cl_vendor.vp_vssr_product_daily_rl_exclude_pos`
where vertical_parent = &apos;Food&apos;
AND change_type NOT LIKE &apos;%Availability%&apos;
AND week &gt;&gt;= &apos;2023-W50&apos;
group by 1,2,3,4,5,6,7,8
),

mss_monthly as (
SELECT  
date_trunc(date,month) as date,
&quot;monthly&quot; as period,
&quot;mss&quot; as plugin,
&quot;?&quot; as main_product,
change_type as change_type,
global_entity_id,
country_name,
brand_name,
sum(total_count) as total_count,
sum(ss_count) as ss_count
FROM `fulfillment-dwh-production.cl_vendor.vp_vssr_product_daily_rl_exclude_pos`
where vertical_parent = &apos;Food&apos;
AND change_type NOT LIKE &apos;%Availability%&apos;
AND week &gt;&gt;= &apos;2023-W50&apos;
group by 1,2,3,4,5,6,7,8
),

ot_weekly as (
  
  select 
  created_at as date,
  &quot;weekly&quot; as period,
 &quot;operational&quot; as plugin,
   main_product,
  &quot;update&quot; as change_type,
  global_entity_id,
  country_name,
  brand_name,
  sum(total_request_count) as total_count,
  sum(vendor_request_count_high_band) as ss_count
  from `fulfillment-dwh-production.cl_vendor.vssr_opening_time_datasource`
  where date_granularity = &apos;weekly&apos;
  group by 1,2,3,4,5,6,7,8
),

ot_monthly as (
  select 
  created_at as date,
  &quot;monthly&quot; as period,
 &quot;operational&quot; as plugin,
   main_product,
  &quot;update&quot; as change_type,
  global_entity_id,
  country_name,
  brand_name,
  sum(total_request_count) as total_count,
  sum(vendor_request_count_high_band) as ss_count
  from `fulfillment-dwh-production.cl_vendor.vssr_opening_time_datasource`
  where date_granularity = &apos;monthly&apos;
  group by 1,2,3,4,5,6,7,8
),


operational_weekly as (
  select 
  created_at as date,
  &quot;weekly&quot; as period,
  &quot;operational&quot; as plugin,
  main_product,
  &quot;update&quot; as change_type,
  global_entity_id,
  country_name,
  brand_name,
  sum(total_request_count) as total_count,
  sum(vendor_request_count) as ss_count
  from `fulfillment-dwh-production.cl_vendor.vssr_operational_datasource`
  where date_granularity = &apos;weekly&apos;
  group by 1,2,3,4,5,6,7,8
),

operational_monthly as (
  select 
  created_at as date,
  &quot;monthly&quot; as period,
  &quot;operational&quot; as plugin,
  main_product,
  &quot;update&quot; as change_type,
  global_entity_id,
  country_name,
  brand_name,
  sum(total_request_count) as total_count,
  sum(vendor_request_count) as ss_count
  from `fulfillment-dwh-production.cl_vendor.vssr_operational_datasource`
  where date_granularity = &apos;monthly&apos;

  group by 1,2,3,4,5,6,7,8
),


commercial_weekly as (
  
  select 
  created_at as date,
  &quot;weekly&quot; as period,
  &quot;commercial&quot; as plugin,
  main_product,
  change_type,
  global_entity_id,
  country_name,
  brand_name,
  sum(total_request_count) as total_count,
  sum(vendor_request_count) as ss_count
  FROM `fulfillment-dwh-production.cl_vendor.vssr_commercial_datasource`
  where date_granularity = &apos;weekly&apos;
  group by 1,2,3,4,5,6,7,8
),

commercial_monthly as (
  
  select 
  created_at as date,
  &quot;monthly&quot; as period,
  &quot;commercial&quot; as plugin,
  main_product,
  change_type,
  global_entity_id,
  country_name,
  brand_name,
  sum(total_request_count) as total_count,
  sum(vendor_request_count) as ss_count
  FROM `fulfillment-dwh-production.cl_vendor.vssr_commercial_datasource`
  where date_granularity = &apos;monthly&apos;
  group by 1,2,3,4,5,6,7,8
),

vssr_overview as (
select * from mss_weekly
UNION ALL
select * from mss_monthly
UNION ALL
select * from ot_weekly
UNION ALL
select * from ot_monthly
UNION ALL
select * from operational_weekly
UNION ALL
select * from operational_monthly
UNION ALL
SELECT * FROM commercial_weekly
UNION ALL
SELECT * FROM commercial_monthly
order by date desc
),
final_total as (
select 
date,
period,
global_entity_id,
plugin,
main_product,
change_type,
country_name,
brand_name,
COALESCE(sum(case when plugin = &apos;mss&apos; then ss_count end),0) as mss_ss_count,
COALESCE(sum(case when plugin = &apos;mss&apos; then total_count end),0) as mss_total_count,
COALESCE(sum(case when plugin = &apos;operational&apos; then ss_count end),0) as operational_ss_count,
COALESCE(sum(case when plugin = &apos;operational&apos; then total_count end),0) as operational_total_count,
COALESCE(sum(case when plugin = &apos;commercial&apos; then ss_count end),0) as commercial_ss_count,
COALESCE(sum(case when plugin = &apos;commercial&apos; then total_count end),0) as commercial_total_count,
from vssr_overview
group by 1,2,3,4,5,6,7,8
)

select
date,
period,
global_entity_id,
plugin,
main_product,
change_type,
country_name,
brand_name,
mss_ss_count,
mss_total_count,
operational_ss_count,
operational_total_count,
commercial_ss_count,
commercial_total_count,
lag(mss_ss_count) over (partition by period,global_entity_id,plugin,main_product,change_type,country_name,brand_name order by date) as prv_mss_ss_count,
lag(mss_total_count) over (partition by period,global_entity_id,plugin,main_product,change_type,country_name,brand_name order by date) as prv_mss_total_count,
lag(operational_ss_count) over (partition by period,global_entity_id,plugin,main_product,change_type,country_name,brand_name order by date) as prv_operational_ss_count,
lag(operational_total_count) over (partition by period,global_entity_id,plugin,main_product,change_type,country_name,brand_name order by date) as prv_operational_total_count,
lag(commercial_ss_count) over (partition by period,global_entity_id,plugin,main_product,change_type,country_name,brand_name order by date) as prv_commercial_ss_count,
lag(commercial_total_count) over (partition by period,global_entity_id,plugin,main_product,change_type,country_name,brand_name order by date) as prv_commercial_total_count,
from final_total</relation>
            </properties>
