        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Average Total SS Percentage&apos; then [Calculation_84020329801437193]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weighted Average Total SS Percentage&apos; then [Calculation_84020329769791488]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Time Weighted Total SS Percantage &apos; THEN [Average Total SS Percantage (copy)_222435651891642368]&#10;END' />
