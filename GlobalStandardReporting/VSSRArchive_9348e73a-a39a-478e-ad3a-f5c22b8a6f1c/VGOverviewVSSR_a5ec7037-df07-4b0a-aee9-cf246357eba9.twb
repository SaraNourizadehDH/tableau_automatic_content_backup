      <column caption='Time Weighted Total SS Percantage ' datatype='real' default-format='p0.00%' name='[Average Total SS Percantage (copy)_222435651891642368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([mss_ss_count])/SUM([mss_total_count]))*0.21&#10;+&#10;(SUM([commercial_ss_count])/SUM([commercial_total_count]))*0.58&#10;+&#10;(SUM([operational_ss_count])/SUM([operational_total_count]))*0.21' />
      </column>
      <column caption='Prv Average Total SS Percantage' datatype='real' default-format='p0.00%' name='[Average Total SS Percantage (copy)_6844908541759475712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;SUM([prv_mss_ss_count])/SUM([prv_mss_total_count])&#10;+&#10;SUM([prv_commercial_ss_count])/SUM([prv_commercial_total_count])&#10;+&#10;SUM([prv_operational_ss_count])/SUM([prv_operational_total_count])&#10;)/3' />
      </column>
      <column caption='Diff% Average Total SS Percantage' datatype='real' name='[Average Total SS Percantage (copy)_6844908541770137607]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;(&#10;SUM([mss_ss_count])/SUM([mss_total_count])&#10;+&#10;SUM([commercial_ss_count])/SUM([commercial_total_count])&#10;+&#10;SUM([operational_ss_count])/SUM([operational_total_count])&#10;)/3&#10;)&#10;/&#10;(&#10;(&#10;SUM([prv_mss_ss_count])/SUM([prv_mss_total_count])&#10;+&#10;SUM([prv_commercial_ss_count])/SUM([prv_commercial_total_count])&#10;+&#10;SUM([prv_operational_ss_count])/SUM([prv_operational_total_count])&#10;)/3&#10;)&#10;-1' />
      </column>
