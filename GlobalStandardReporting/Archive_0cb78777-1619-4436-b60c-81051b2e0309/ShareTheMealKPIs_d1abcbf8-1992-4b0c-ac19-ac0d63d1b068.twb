              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;  WHEN &apos;Daily&apos; THEN [Calculation_737464470290112513]&#13;&#10;  WHEN &apos;Weekly&apos; THEN [Calculation_737464470290489347]&#13;&#10;  WHEN &apos;Monthly&apos; THEN [Calculation_737464470290325506]&#13;&#10;END' />
