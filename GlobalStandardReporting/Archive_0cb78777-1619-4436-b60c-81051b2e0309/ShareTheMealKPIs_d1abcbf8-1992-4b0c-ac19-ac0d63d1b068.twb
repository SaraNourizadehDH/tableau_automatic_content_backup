    <dashboard name='Info'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/ShareTheMealKPIs_16662019321850/Info?rev=' id='Info' path='/t/GlobalStandardReporting/workbooks/ShareTheMealKPIs_16662019321850' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98000' id='3' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='15'>Purpose:</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='15'> Track Share the Meal Donation Metrics</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='15'>Filters:</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='15'>There are 4 filters that you can use: </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='15'>Date:</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='15'> Users can choose a specific period days,weeks,months or yearly</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='15'>Date Level Selector:  </run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='15'>Users can choose to have aggregated metrics Daily, Weekly or Monthly</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='15'>Subsidiary: </run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='15'>Users can choose a specific enity</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='15'>Status: </run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='15'>This allows users to filter on Created / Completed / Failed donations.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='15'>Metrics:</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='15'>#No of Donations : </run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='15'>Total number of share the meal donations for a chosen period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontname='Segoe UI' fontsize='15'>Donation GMV (</run>
              <run bold='true' fontcolor='#222222' fontname='Segoe UI' fontsize='15'>€</run>
              <run bold='true' fontcolor='#333333' fontname='Segoe UI' fontsize='15'>): </run>
              <run fontcolor='#333333' fontname='Segoe UI' fontsize='15'>Total GMV donated in Euros </run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='15'>for a chosen period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontname='Segoe UI' fontsize='15'>Unique Donors : </run>
              <run fontcolor='#333333' fontname='Segoe UI' fontsize='15'>No. of unique donors daily/weekly/monthly (only successful donations)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontname='Segoe UI' fontsize='15'>Avg. Ung Donors: </run>
              <run fontcolor='#333333' fontname='Segoe UI' fontsize='15'>Avg. no. of unique donors daily/weekly/monthly (only successful donations)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontname='Segoe UI' fontsize='15'>Avg. Donation per Donor : </run>
              <run fontcolor='#333333' fontname='Segoe UI' fontsize='15'>Avg. donation amount donated by unique donors on daily/weekly/monthly basis (only successful donations)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontname='Segoe UI' fontsize='15'>Avg. Donation per Txn</run>
              <run fontcolor='#333333' fontname='Segoe UI' fontsize='15'> : Avg. donation amount donated per txn on daily/weekly/monthly basis (only successful donations)</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
