    <worksheet name='Overview 30-day rolling GMV'>
      <table>
        <view>
          <datasources>
            <datasource caption='alfred_wallet_incremental_gmv_overview (rl_fintech)' name='federated.0y3g4hb1rmbco5108vgmh16r20t2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Euro' caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;eur&quot;'>
              <calculation class='tableau' formula='&quot;eur&quot;' />
              <aliases>
                <alias key='&quot;eur&quot;' value='Euro' />
                <alias key='&quot;lc&quot;' value='Local Currency' />
              </aliases>
            </column>
            <column alias='30-day Rolling' caption='Date Level' datatype='real' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='1.'>
              <calculation class='tableau' formula='1.' />
              <aliases>
                <alias key='1.' value='30-day Rolling' />
                <alias key='2.' value='Monthly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0y3g4hb1rmbco5108vgmh16r20t2'>
            <column caption='30-day rolling N Customers selected date' datatype='integer' name='[30-day rolling GMV latest (copy 2)_1877578832944971782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [start_date] = [Calculation_1877578832941342723] THEN [n_customers] ELSE NULL END' />
            </column>
            <column caption='30-day rolling AVG GMV per customer selected date' datatype='real' name='[30-day rolling GMV latest (copy)_1877578832944558085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1877578832941461508])/SUM([30-day rolling GMV latest (copy 2)_1877578832944971782])' />
            </column>
            <column caption='30-day rolling GMV previous date' datatype='real' name='[30-day rolling GMV selected date (copy)_1877578832947908616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [start_date] = [Calculation_1877578832941342723] - 1 THEN [incremental_gmv_eur] ELSE NULL END' />
            </column>
            <column caption='Incremental Gmv' datatype='real' name='[Calculation_166351719109120000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN 1 THEN&#10;            CASE [Parameters].[Parameter 1] &#10;                WHEN &apos;eur&apos; THEN [incremental_gmv_eur]&#10;                WHEN &apos;lc&apos; THEN [incremental_gmv_lc] &#10;            END&#10;    WHEN 2 THEN&#10;        CASE DAY([start_date]) &#10;            WHEN 1 THEN &#10;                CASE [Parameters].[Parameter 1] &#10;                    WHEN &apos;eur&apos; THEN [incremental_gmv_eur]&#10;                    WHEN &apos;lc&apos; THEN [incremental_gmv_lc] &#10;                END&#10;            ELSE NULL &#10;        END&#10;END' />
            </column>
            <column caption='Average Incremental Spend' datatype='real' name='[Calculation_166351719124996098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_166351719109120000])/SUM([n_customers])' />
            </column>
            <column caption='Max Start Date' datatype='date' name='[Calculation_1877578832941342723]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([start_date])}' />
            </column>
            <column caption='30-day rolling GMV selected date' datatype='real' name='[Calculation_1877578832941461508]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [start_date] = [Calculation_1877578832941342723] THEN [incremental_gmv_eur] ELSE NULL END' />
            </column>
            <column caption='30-day rolling GMV % diff' datatype='real' name='[Calculation_1877578832948035593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1877578832941461508])/SUM([30-day rolling GMV selected date (copy)_1877578832947908616]) - 1' />
            </column>
            <column caption='Impact Month Filter' datatype='date' datatype-customized='true' name='[Calculation_4939885893325922304]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;yyyy-MM-dd&quot;, STR([start_date]) ))' />
            </column>
            <column caption='Max Start Date - End' datatype='date' name='[Max Start Date (copy)_1877578832946061319]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([start_date])} + 30' />
            </column>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
