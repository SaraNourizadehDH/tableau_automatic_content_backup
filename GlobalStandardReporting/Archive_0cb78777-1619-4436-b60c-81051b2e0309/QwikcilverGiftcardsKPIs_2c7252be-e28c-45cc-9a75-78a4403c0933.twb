      <aliases enabled='yes' />
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1050183194841915392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
      </column>
      <column caption='day' datatype='string' name='[Calculation_1050183194865152001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(Day([date]))+&apos; &apos;+LEFT(DATENAME(&apos;month&apos;,[date]),3) +&apos; &apos;+RIGHT(DATENAME(&apos;year&apos;,[date]),2)' />
      </column>
      <column caption='week' datatype='string' name='[Calculation_1050183194865324034]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;week&apos;+&apos; &apos;+STR(DATEPART(&apos;week&apos;,[date])) +&apos; &apos;+STR(YEAR([date]))' />
      </column>
      <column caption='month' datatype='string' name='[Calculation_1050183194865451011]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[date]),3)+&apos; &apos;+STR(YEAR([date]))' />
      </column>
      <column caption='quarter' datatype='string' name='[Calculation_1050183194865569796]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='(&quot;Q&quot; + str(DATEPART(&apos;quarter&apos;, [date])) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [date])))' />
      </column>
      <column caption='year' datatype='string' name='[Calculation_1050183194865709061]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(DATEPART(&apos;year&apos;, [date]))' />
      </column>
      <column caption='Date Level' datatype='string' name='[Calculation_1050183194865819654]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Daily&apos; THEN [Calculation_1050183194865152001]&#10;    WHEN &apos;Weekly&apos; THEN [Calculation_1050183194865324034]&#10;    WHEN &apos;Monthly&apos; THEN [Calculation_1050183194865451011]&#10;    WHEN &apos;Quarterly&apos; THEN [Calculation_1050183194865569796]&#10;    WHEN &apos;Yearly&apos; THEN [Calculation_1050183194865709061]&#10;END' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_3783305182880411649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [Parameters].[Parameter 4] = &apos;Euro&apos; then [gmv_eur] ELSE [gmv_lc] END' />
      </column>
      <column caption='Non GC GMV' datatype='real' name='[Calculation_3783305182882738180]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4] &#10;WHEN &apos;Euro&apos; THEN SUM([Calculation_3783305182883692549]) &#10;WHEN &apos;LC&apos; THEN SUM([Non GC GMV Eur (copy)_3783305182883815430])&#10;END' />
      </column>
      <column caption='Non GC GMV Eur' datatype='real' name='[Calculation_3783305182883692549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([gmv_eur])-ZN([gc_gmv_eur])' />
      </column>
      <column caption='GC GMV %' datatype='real' name='[Calculation_3783305182889717771]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GMV (copy)_3783305182880870402]/sum([Calculation_3783305182880411649])' />
      </column>
      <column caption='GC AOV' datatype='real' name='[Calculation_3783305182893547533]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3783305182880411649]/[orders]' />
      </column>
      <column caption='GC Customers' datatype='real' name='[Calculation_3783305182894481422]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Daily&apos; THEN avg([daily_customers]) &#10;    WHEN &apos;Weekly&apos; THEN avg([weekly_customers])&#10;    WHEN &apos;Monthly&apos; THEN avg([monthly_customers])&#10;    WHEN &apos;Quarterly&apos; THEN avg([quarterly_customers])&#10;    WHEN &apos;Yearly&apos; THEN avg([yearly_customers])&#10;END' />
      </column>
      <column caption='GC AOF' datatype='real' name='[Calculation_3783305182894641167]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders])/[Calculation_3783305182894481422]' />
      </column>
      <column caption='Non GC GMV %' datatype='real' name='[GC GMV % (copy)_3783305182890151948]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3783305182882738180]/sum([Calculation_3783305182880411649])' />
      </column>
