      <aliases enabled='yes' />
      <column caption='GC Amount' datatype='real' name='[Balance Amount (copy)_2866541186327277574]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 4]&#10;when &apos;Euro&apos; then [gc_amount_eur]&#10;when &apos;LC&apos; then [gc_amount_lc]&#10;END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1050183194841915392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
      </column>
      <column caption='expiry day' datatype='string' name='[Calculation_1050183194865152001 1]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(Day([end_date_local]))+&apos; &apos;+LEFT(DATENAME(&apos;month&apos;,[end_date_local]),3) +&apos; &apos;+RIGHT(DATENAME(&apos;year&apos;,[end_date_local]),2)' />
      </column>
      <column caption='day' datatype='string' name='[Calculation_1050183194865152001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(Day([start_date_local]))+&apos; &apos;+LEFT(DATENAME(&apos;month&apos;,[start_date_local]),3) +&apos; &apos;+RIGHT(DATENAME(&apos;year&apos;,[start_date_local]),2)' />
      </column>
      <column caption='expiry week' datatype='string' name='[Calculation_1050183194865324034 1]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;week&apos;+&apos; &apos;+STR(DATEPART(&apos;week&apos;,[end_date_local])) +&apos; &apos;+STR(YEAR([end_date_local]))' />
      </column>
      <column caption='week' datatype='string' name='[Calculation_1050183194865324034]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;week&apos;+&apos; &apos;+STR(DATEPART(&apos;week&apos;,[start_date_local])) +&apos; &apos;+STR(YEAR([start_date_local]))' />
      </column>
      <column caption='expiry month' datatype='string' name='[Calculation_1050183194865451011 1]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[end_date_local]),3)+&apos; &apos;+STR(YEAR([end_date_local]))' />
      </column>
