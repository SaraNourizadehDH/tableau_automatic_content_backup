            </column>
            <column caption='GC Customers' datatype='real' name='[Calculation_3783305182894481422]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Daily&apos; THEN avg([daily_customers]) &#10;    WHEN &apos;Weekly&apos; THEN avg([weekly_customers])&#10;    WHEN &apos;Monthly&apos; THEN avg([monthly_customers])&#10;    WHEN &apos;Quarterly&apos; THEN avg([quarterly_customers])&#10;    WHEN &apos;Yearly&apos; THEN avg([yearly_customers])&#10;END' />
            </column>
            <column caption='GC AOF' datatype='real' name='[Calculation_3783305182894641167]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders])/[Calculation_3783305182894481422]' />
            </column>
