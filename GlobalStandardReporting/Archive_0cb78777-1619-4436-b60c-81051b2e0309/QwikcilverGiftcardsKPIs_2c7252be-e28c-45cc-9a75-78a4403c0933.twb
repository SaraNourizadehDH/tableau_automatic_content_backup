    <worksheet name='Expiry Distribution'>
      <table>
        <view>
          <datasources>
            <datasource caption='gc_card_portfolio+ (curated_data_shared_govops)' name='federated.1bgyddu082xjmw15vro241r8x726' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Level Selector' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
              <aliases>
                <alias key='&quot;LC&quot;' value='Local Currency' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1bgyddu082xjmw15vro241r8x726'>
            <column caption='expiry day' datatype='string' name='[Calculation_1050183194865152001 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(Day([end_date_local]))+&apos; &apos;+LEFT(DATENAME(&apos;month&apos;,[end_date_local]),3) +&apos; &apos;+RIGHT(DATENAME(&apos;year&apos;,[end_date_local]),2)' />
            </column>
            <column caption='expiry week' datatype='string' name='[Calculation_1050183194865324034 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;week&apos;+&apos; &apos;+STR(DATEPART(&apos;week&apos;,[end_date_local])) +&apos; &apos;+STR(YEAR([end_date_local]))' />
            </column>
            <column caption='expiry month' datatype='string' name='[Calculation_1050183194865451011 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[end_date_local]),3)+&apos; &apos;+STR(YEAR([end_date_local]))' />
            </column>
            <column caption='expiry quarter' datatype='string' name='[Calculation_1050183194865569796 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(&quot;Q&quot; + str(DATEPART(&apos;quarter&apos;, [end_date_local])) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [end_date_local])))' />
            </column>
            <column caption='expiry year' datatype='string' name='[Calculation_1050183194865709061 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(DATEPART(&apos;year&apos;, [end_date_local]))' />
            </column>
            <column caption='Avg. Balance per GC' datatype='real' name='[Calculation_2866541186318716930]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[balance_amount_lc]/[gc_w_balance]' />
            </column>
            <column caption='Balance Amount' datatype='real' name='[Calculation_2866541186326388740]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 4]&#10;when &apos;Euro&apos; then [balance_amount_eur]&#10;when &apos;LC&apos; then [balance_amount_lc]&#10;END' />
            </column>
            <column caption='Date Level - Expiry Date' datatype='string' name='[Date Level - Issue Date (copy)_2866541186316591105]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Daily&apos; THEN [Calculation_1050183194865152001 1]&#10;    WHEN &apos;Weekly&apos; THEN [Calculation_1050183194865324034 1]&#10;    WHEN &apos;Monthly&apos; THEN [Calculation_1050183194865451011 1]&#10;    WHEN &apos;Quarterly&apos; THEN [Calculation_1050183194865569796 1]&#10;    WHEN &apos;Yearly&apos; THEN [Calculation_1050183194865709061 1]&#10;END' />
            </column>
            <column datatype='real' name='[balance_amount_eur]' role='measure' type='quantitative' />
            <column caption='Balance Amount Lc' datatype='real' name='[balance_amount_lc]' role='measure' type='quantitative' />
            <column caption='End Date Local' datatype='date' name='[end_date_local]' role='dimension' type='ordinal' />
            <column caption='Gc W Balance' datatype='integer' name='[gc_w_balance]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[end_date_local]' derivation='Min' name='[min:end_date_local:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Date Level - Issue Date (copy)_2866541186316591105]' derivation='None' name='[none:Date Level - Issue Date (copy)_2866541186316591105:nk]' pivot='key' type='nominal' />
            <column-instance column='[end_date_local]' derivation='None' name='[none:end_date_local:ok]' pivot='key' type='ordinal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
