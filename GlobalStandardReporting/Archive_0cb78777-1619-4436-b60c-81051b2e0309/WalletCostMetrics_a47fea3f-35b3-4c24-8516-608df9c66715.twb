  <dashboards>
    <dashboard name='Info'>
      <repository-location derived-from='http://ip-172-31-0-134:8463/t/GlobalStandardReporting/workbooks/WalletCostMetrics/Info?rev=' id='Info' path='/t/GlobalStandardReporting/workbooks/WalletCostMetrics' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#f5f5f5' />
        </style-rule>
      </style>
      <size maxheight='800' maxwidth='1350' minheight='800' minwidth='1350' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98000' id='3' type-v2='text' w='98814' x='593' y='1000'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='12'>Purpose:</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='12'> Track the monthly Wallet Cost Metrics</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='12'>Filters:</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='12'>There are 2 filters that you can use: </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='12'>Date:</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='12'> Users can choose a specific month</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='12'>Subsidiary: </run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='12'>Users can choose a specific enity</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='12'>Metrics:</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='12'>The model  focus on a model that compares the weighted cost of Funds in against the funds out GMV.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='12'>Wallet CPO </run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='12'>= (Cost of Topups + Cost of Topups)  / Purchase GMV</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='12'>Wallet FLCPO </run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='12'>= (Cost of Topups + Cost of Marketing Cashbacks + Cost of Topups) / Purchase GMV (Funds out)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='12'>Funds In:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='12'>- Top ups -&gt; Calculate cost of top ups using the cost metrics sheet provided by the payments teams</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='12'>- Refund to wallet</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='12'>- Marketing Topups</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='12'>Funds Out:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='12'>- Purchases</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='12'>- Refund to source </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='12'>- Expired Marketing Topups</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f5f5f5' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
