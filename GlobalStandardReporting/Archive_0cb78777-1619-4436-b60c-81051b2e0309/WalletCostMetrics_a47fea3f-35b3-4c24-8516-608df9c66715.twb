      <aliases enabled='yes' />
      <column caption='Topup CPO' datatype='real' default-format='p0.00%' name='[CPO (copy)_2542000547362480135]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(([topups_acquiring_variable_fee_cost]+[topups_acquiring_fixed_fee_cost]+[topups_gateway_fee_cost]))/SUM([purchase_amt_eur])' />
      </column>
      <column caption='Cost Metrics' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_199565790466662401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[topups_gateway_fee_cost Parameter] = 1 THEN [Calculation_2307039308052463616]&#10;ELSEIF [Parameters].[topups_gateway_fee_cost Parameter] = 2 THEN [Cost (copy)_2307039308052643841]&#10;ELSEIF [Parameters].[topups_gateway_fee_cost Parameter] = 3 THEN IFNULL(ROUND([Cost (copy)_2307039308089425922]*100,1),0)&#10;ELSEIF [Parameters].[topups_gateway_fee_cost Parameter] = 4 THEN IFNULL(ROUND([Full Cost (copy)_2307039308089614339]*100,1),0)&#10;END' />
      </column>
      <column caption='op_variation_topup' datatype='real' name='[Calculation_199565790478274564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(max([topup_amt_eur])) - LOOKUP(ZN(max([topup_amt_eur])), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='sufix' datatype='string' name='[Calculation_199565790483144712]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[topups_gateway_fee_cost Parameter]&#10;  WHEN 1 THEN &apos;€&apos;&#10;  WHEN 2 THEN &apos;€&apos;&#10;  WHEN 3 THEN &apos;%&apos;&#10;  WHEN 4 THEN &apos;%&apos;&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='wallet cost eur' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Calculation_2307039308052463616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Cost (copy)_199565790464090112] + [Topup Cost (copy)_199565790469574658]' />
      </column>
      <column caption='Segementation' datatype='string' name='[Calculation_2542000547359318020]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Selector (copy)]&#10;            WHEN 1 THEN [global_entity_id]&#10;            WHEN 2 THEN &apos;All Countries&apos;&#10;END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_3358700172395409408]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
      </column>
      <column caption='Topup Cost eur' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Cost (copy)_199565790464090112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([topups_acquiring_variable_fee_cost]+[topups_acquiring_fixed_fee_cost]+[topups_gateway_fee_cost])' />
      </column>
      <column caption='wallet Full Cost eur' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Cost (copy)_2307039308052643841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Cost (copy)_199565790464090112]+[Topup Cost (copy)_199565790469574658]+ SUM([mktn_topup_amt_eur])' />
      </column>
      <column caption='CPO' datatype='real' default-format='p0.00%' name='[Cost (copy)_2307039308089425922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Cost (copy)_199565790464090112]+[Topup Cost (copy)_199565790469574658])/SUM([purchase_amt_eur])' />
      </column>
      <column caption='FLCPO' datatype='real' default-format='p0.00%' name='[Full Cost (copy)_2307039308089614339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Cost (copy)_199565790464090112]+[Topup Cost (copy)_199565790469574658]+SUM([mktn_topup_amt_eur]))/SUM([purchase_amt_eur])' />
      </column>
      <column caption='Change to wallet Cost eur' datatype='integer' name='[Refund Cost (copy)_199565790469791747]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Mktn CPO' datatype='real' default-format='p0.00%' name='[Topup CPO (copy) (copy)_2542000547363516426]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([mktn_topup_amt_eur])/SUM([purchase_amt_eur])' />
      </column>
      <column caption='Refund CPO' datatype='real' default-format='p0.00%' name='[Topup CPO (copy)_2542000547363504137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Topup Cost (copy)_199565790469574658]/SUM([refund_to_wallet_amt_eur])' />
      </column>
      <column caption='Refund Cost eur' datatype='real' name='[Topup Cost (copy)_199565790469574658]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([refunds_acquiring_fixed_fee_cost]+[refunds_acquiring_variable_fee_cost]+[refunds_gateway_fee_cost])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='wallet_cost_inflow_outflow' datatype='table' name='[__tableau_internal_object_id__].[wallet_cost_inflow_outflow_9BA872C8BC294CD38B082ADECDF1A640]' role='measure' type='quantitative' />
