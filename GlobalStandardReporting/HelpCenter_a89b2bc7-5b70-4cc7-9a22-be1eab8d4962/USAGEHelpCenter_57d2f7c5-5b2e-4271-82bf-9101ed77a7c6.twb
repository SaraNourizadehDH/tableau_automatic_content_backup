      <column caption='Split Funnel Metric' datatype='real' name='[Calculation_2616169215499612164]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN((IF [triggered_event_type] = &apos;PREVIOUS&apos; THEN -1 ELSE 1 END))&#10;*&#10;CASE [Parameters].[Parameter 2]&#10;WHEN &quot;# Events&quot; THEN SUM([total_events])&#10;WHEN &quot;Avg. # Vendors&quot; THEN AVG([Calculation_2942820926054813696])&#10;END' />
