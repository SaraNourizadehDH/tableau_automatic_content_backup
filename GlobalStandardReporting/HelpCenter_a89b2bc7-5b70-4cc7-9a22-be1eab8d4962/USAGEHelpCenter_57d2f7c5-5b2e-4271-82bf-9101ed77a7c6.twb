      <column caption='Cohort Size' datatype='integer' name='[Calculation_2646357408896933892]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [period]:&#10;    SUM(&#10;        { FIXED [region], [entity_id], [vendor_grade], [vertical_food], [client_name], [transmission_type], [pos_integration_type], [is_zombie_vendor], [is_new_vendor], [is_dormant_vendor], [is_inoperative_vendor], [is_unengaged_vendor], [date_type], [created_date], [triggered_event_type], [Calculation_3050485104764043264]:&#10;            SUM(IF [period] = 0 THEN [vendors] ELSE 0 END)&#10;        }&#10;    )&#10;}' />
      </column>
      <column caption='_user_entitlement' datatype='boolean' name='[Calculation_2817353455166263298]' role='dimension' type='nominal'>
