    <worksheet name='Self Onboarding Data'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>VENDOR SELF ONBOARDING COHORT PERFORMANCE</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ssu_self_onboarding_vendor_performance (sales_reports)' name='federated.1ainlb10sn42jq1gy6ioi1quvkdm' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Onboarding Granularity' datatype='string' name='[Parameter 12]' param-domain-type='list' role='measure' type='nominal' value='&quot;Global&quot;'>
              <calculation class='tableau' formula='&quot;Global&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ainlb10sn42jq1gy6ioi1quvkdm'>
            <column caption='Photo Completion %' datatype='real' name='[Calculation_5563775156204064768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([upload_photos_completed])/sum([started_onboarding])' />
            </column>
            <column caption='Upload Docuements Completion %' datatype='real' name='[Calculation_5563775156204302337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_5563775156221935621])/sum([Calculation_5563775156224319494])' />
            </column>
            <column caption='Menu completion %' datatype='real' name='[Calculation_5563775156204457986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([menu_completed])/sum([started_onboarding])' />
            </column>
            <column caption='opening times completion %' datatype='real' name='[Calculation_5563775156204621827]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([opening_times_completed])/sum([started_onboarding])' />
            </column>
            <column caption='finished onboarding %' datatype='real' name='[Calculation_5563775156204748804]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([finished_onboarding])/sum([started_onboarding])' />
            </column>
            <column caption='Upload docs update' datatype='integer' name='[Calculation_5563775156221935621]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [flow__c]  IN (&apos;V3&apos;, &apos;V4&apos;)&#10;then [upload_documents_completed]&#10;end' />
            </column>
            <column caption='Started Onboarding V3V4' datatype='integer' name='[Calculation_5563775156224319494]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if flow__c in (&apos;V3&apos;, &apos;V4&apos;)&#10;then [started_onboarding]&#10;end' />
            </column>
            <column caption='View' datatype='string' name='[Calculation_5563775156225847303]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 12] = &quot;Brand&quot;&#10;then [brand]&#10;ELSEIF  [Parameters].[Parameter 12] = &quot;Entity&quot; then [global_entity_id]&#10;else &quot;Global&quot;&#10;END' />
            </column>
            <column caption='Offer discount %' datatype='real' name='[Calculation_76279749106593792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offer_discount_completed])/sum([started_onboarding])' />
            </column>
