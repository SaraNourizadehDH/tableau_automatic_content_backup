      <repository-location id='MDSdetail' path='/t/GlobalStandardReporting/workbooks/VendorSelfOnboarding' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='ssu_mds_performance_rollup (sales_reports)' name='federated.1tg5e0f1eytbwc19r4zkv0hr64lk' />
          </datasources>
          <datasource-dependencies datasource='federated.1tg5e0f1eytbwc19r4zkv0hr64lk'>
            <column caption='avg_tiems_mds_import_vendor' datatype='real' name='[Calculation_117515817616920576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_items_generated]) / sum([total_mds_vendor_activations])' />
            </column>
            <column caption='per_dld_out_of_generated_items' datatype='real' name='[Calculation_117515817619804161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_MDS_DLD_generated])/sum([total_items_generated])' />
            </column>
            <column caption='per_mds_prices_total' datatype='real' name='[Calculation_117515817620525058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_prices_MDS_generated]) / sum([total_items_generated])' />
            </column>
            <column caption='total_items_markup_perc' datatype='real' name='[Calculation_117515817621409795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_MDS_marked_up_items])/sum([total_items_generated])' />
            </column>
            <column caption='Markup_price_perc' datatype='real' name='[Calculation_117515817624936452]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum( [current_price_of_marked_up_items]-[original_price_of_marked_up_items])/sum([original_price_of_marked_up_items])' />
            </column>
            <column caption='markdown_perc' datatype='real' name='[Calculation_117515817642786824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([current_price_of_marked_down_items]-[original_price_of_marked_down_items])/sum([original_price_of_marked_down_items])' />
            </column>
            <column caption='d0_avg_items_per_vendor' datatype='real' name='[Calculation_117515817643528201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_items_d0_activation])/sum([total_vendors_do_menu_data])' />
            </column>
            <column caption='d0_activation_perc' datatype='real' name='[Calculation_117515817645117450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_descriptions_d0_activation])/sum([total_items_d0_activation])' />
