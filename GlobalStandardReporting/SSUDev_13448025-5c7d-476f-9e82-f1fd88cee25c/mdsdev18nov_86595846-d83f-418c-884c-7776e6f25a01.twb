      <column datatype='real' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_117515817642438662]) - LOOKUP(ZN([Calculation_117515817642438662]), -1)'>
          <table-calc ordering-type='Columns' />
