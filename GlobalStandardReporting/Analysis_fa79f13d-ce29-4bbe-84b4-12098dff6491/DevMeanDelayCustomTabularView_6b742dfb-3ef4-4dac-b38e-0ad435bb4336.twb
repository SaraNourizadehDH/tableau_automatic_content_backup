      <column caption='Avg FLGPO' datatype='real' hidden='true' name='[Calculation_68116996808220684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([flgpo_eur])/SUM([total_orders])' />
      </column>
      <column caption='Fail Rate' datatype='real' hidden='true' name='[Calculation_68116996810571789]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([total_orders])-SUM([completed_orders]))/SUM([total_orders])' />
      </column>
      <column caption='Reorder Rate 14 Days' datatype='real' hidden='true' name='[Calculation_68116996810768398]' role='measure' type='quantitative'>
