            <column alias='Mean Delay' caption='Choose Saturation Dimension' datatype='real' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='1.'>
              <calculation class='tableau' formula='1.' />
              <aliases>
                <alias key='1.' value='Mean Delay' />
