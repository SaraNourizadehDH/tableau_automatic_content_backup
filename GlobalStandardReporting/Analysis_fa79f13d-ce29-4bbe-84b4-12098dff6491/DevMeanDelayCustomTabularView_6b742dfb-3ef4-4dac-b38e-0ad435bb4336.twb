    <worksheet name='Profit Components Total new source'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Profit Components Total</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Total Profit Components' name='federated.13dd8tx1i5ddxw178p9kz1bhyndn (copy 2)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Total Orders' caption='Choose Metric 1' datatype='real' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2.'>
              <calculation class='tableau' formula='2.' />
              <aliases>
                <alias key='1.' value='% Has Next Order' />
                <alias key='2.' value='Total Orders' />
                <alias key='3.' value='% Late Orders' />
                <alias key='4.' value='% Orders with Session/Contact' />
                <alias key='5.' value='% Orders with &gt;=45min DT' />
                <alias key='6.' value='% Seamless' />
                <alias key='7.' value='Avg Days to Next Order' />
                <alias key='8.' value='Fail Rate' />
                <alias key='9.' value='Reorder Rate 7 Days' />
                <alias key='10.' value='Reorder Rate 14 Days' />
                <alias key='11.' value='Reorder Rate 30 Days' />
                <alias key='12.' value='FLGPO' />
                <alias key='13.' value='Avg Delivery Fee Eur' />
                <alias key='14.' value='Avg Incentives Eur' />
                <alias key='15.' value='CPO Eur' />
                <alias key='16.' value='Avg Revenue Eur' />
                <alias key='17.' value='Avg Take In Eur' />
                <alias key='18.' value='Avg Service Fee Eur' />
                <alias key='19.' value='Avg Priority Fee Eur' />
                <alias key='20.' value='Avg Commission Eur' />
                <alias key='21.' value='Avg Compensation Eur' />
                <alias key='22.' value='Avg Refund Eur' />
                <alias key='23.' value='Avg Delivery Cost + Compensation + Refund' />
                <alias key='24.' value='Avg Surge Fee Eur' />
                <alias key='25.' value='Avg Wastage Cost Eur' />
                <alias key='26.' value='% Stacking' />
                <alias key='27.' value='Avg MOV Fee Eur' />
                <alias key='28.' value='Avg TT Fee Eur' />
              </aliases>
            </column>
            <column alias='Mean Delay' caption='Choose Saturation Dimension' datatype='real' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='1.'>
              <calculation class='tableau' formula='1.' />
              <aliases>
                <alias key='1.' value='Mean Delay' />
                <alias key='2.' value='Mean Delay Buckets' />
                <alias key='4.' value='Staffing Affection' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13dd8tx1i5ddxw178p9kz1bhyndn (copy 2)'>
            <column caption='Choose Saturation Dimension' datatype='string' name='[Calculation_1172765545307553793]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;when 1 then (&#10;if [mean_delay]&lt; 0 then str(&quot; &quot;) + str([mean_delay]) &#10;else str([mean_delay])&#10;end)&#10;&#10;when 2 then str([Calculation_3306416236483526657])&#10;//when 3 then str([live_utr])&#10;when 4 then str([staffing_affection_min])&#10;end' />
            </column>
            <column caption='Mean Delay Buckets' datatype='string' name='[Calculation_3306416236483526657]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [mean_delay]  &lt; 0 then &apos;1. &lt; 0&apos;&#10;elseif [mean_delay] &lt; 5 then &apos;2. &lt; 5&apos;&#10;elseif [mean_delay] &lt; 10 then &apos;3. &lt; 10&apos;&#10;elseif [mean_delay] &lt; 15 then &apos;4. &lt; 15&apos;&#10;elseif [mean_delay] &lt; 20 then &apos;5. &lt; 20&apos;&#10;elseif [mean_delay] &lt; 25 then &apos;6. &lt; 25&apos;&#10;elseif [mean_delay] &lt; 30 then &apos;7. &lt; 30&apos;&#10;elseif [mean_delay] &gt;= 30 then &apos;8. &gt;= 30&apos;&#10;end' />
            </column>
            <column caption='Is Stacked' datatype='boolean' name='[Calculation_4074842928906293248]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [stacked_deliveries] &gt; &apos;0&apos; THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Stacked Orders' datatype='integer' hidden='true' name='[Calculation_4074842928907014145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Calculation_4074842928906293248] when true then [total_orders] END' />
            </column>
            <column caption='% Stacking' datatype='real' hidden='true' name='[Calculation_4074842928907218946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_4074842928907014145])/sum([total_orders])' />
            </column>
            <column caption='- SUM([Order Cost Eur])' datatype='real' name='[Calculation_4074842928968626184]' role='measure' type='quantitative' user:unnamed='Profit Components Total new source'>
              <calculation class='tableau' formula='- SUM([order_cost_eur])' />
            </column>
            <column caption='- SUM([Incentives Eur])' datatype='real' name='[Calculation_4074842928968777737]' role='measure' type='quantitative' user:unnamed='Profit Components Total new source'>
              <calculation class='tableau' formula='- SUM([incentives_eur])' />
            </column>
            <column caption='- SUM([Wastage Cost Eur])' datatype='real' name='[Calculation_4074842928968957962]' role='measure' type='quantitative' user:unnamed='Profit Components Total new source'>
              <calculation class='tableau' formula='- SUM([wastage_cost])' />
            </column>
            <column caption='% Has Next Order' datatype='real' hidden='true' name='[Calculation_68116996805365766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([has_next_order])/SUM([total_orders])' />
            </column>
            <column caption='% Late Orders' datatype='real' hidden='true' name='[Calculation_68116996806189063]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(is_order_not_on_time)/SUM([total_orders])' />
            </column>
            <column caption='% Orders with Session/Contact' datatype='real' hidden='true' name='[Calculation_68116996806524936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([is_session_contact])/sum([total_orders])' />
            </column>
            <column caption='% Orders with &gt;= 45 min DT' datatype='real' hidden='true' name='[Calculation_68116996806725641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([is_45_min_dt])/SUM([total_orders])' />
            </column>
            <column caption='% Seamless Orders' datatype='real' hidden='true' name='[Calculation_68116996806901770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([seamless_orders])/SUM([total_orders])' />
            </column>
            <column caption='Avg Days to Next Order' datatype='real' hidden='true' name='[Calculation_68116996807839755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([days_to_next_order])/sum([has_next_order])' />
            </column>
            <column caption='Avg FLGPO' datatype='real' hidden='true' name='[Calculation_68116996808220684]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgpo_eur])/SUM([total_orders])' />
            </column>
            <column caption='Fail Rate' datatype='real' hidden='true' name='[Calculation_68116996810571789]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_orders])-SUM([completed_orders]))/SUM([total_orders])' />
            </column>
            <column caption='Reorder Rate 14 Days' datatype='real' hidden='true' name='[Calculation_68116996810768398]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([reorder_freq_14_days])/sum([total_orders])' />
            </column>
            <column caption='Metric 1' datatype='real' name='[Calculation_68116996813197331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;when 1 then  100*[Calculation_68116996805365766]&#10;when 2 then SUM([total_orders])&#10;when 3 then 100*[Calculation_68116996806189063]&#10;when 4 then 100*[Calculation_68116996806524936]&#10;when 5 then 100*[Calculation_68116996806725641]&#10;when 6 then 100*[Calculation_68116996806901770]&#10;when 7 then [Calculation_68116996807839755]&#10;when 8 then 100*[Calculation_68116996810571789]&#10;when 9 then 100*[Reorder Frequency 14 Days (copy)_68116996810883087]&#10;when 10 then 100*[Calculation_68116996810768398]&#10;when 11 then 100*[Reorder Frequency 7 Days (copy)_68116996811022352]&#10;when 12 then [Calculation_68116996808220684]&#10;when 13 then SUM([delivery_fee_eur])/SUM([total_orders])&#10;WHEN 14 THEN SUM([incentives_eur])/SUM([total_orders])&#10;WHEN 15 THEN SUM([order_cost_eur])/SUM([total_orders])&#10;WHEN 16 THEN SUM([revenue_eur])/SUM([total_orders])&#10;WHEN 17 THEN SUM([take_in_eur])/SUM([total_orders])&#10;when 18 then SUM([service_fee_eur])/SUM([total_orders])&#10;WHEN 19 THEN SUM([priority_fee_eur])/SUM([total_orders])&#10;WHEN 20 THEN SUM([commission_eur])/SUM([total_orders])&#10;WHEN 21 THEN SUM([compensation_value_eur])/SUM([total_orders])&#10;WHEN 22 THEN SUM([refund_value_eur])/SUM([total_orders])&#10;WHEN 23 THEN SUM([refund_value_eur]+[compensation_value_eur]+[order_cost_eur])/SUM([total_orders])&#10;WHEN 24 THEN SUM([surge_fee_eur])/SUM([total_orders])&#10;WHEN 25 THEN SUM([wastage_cost])/SUM([total_orders])&#10;when 26 then [Calculation_4074842928907218946]&#10;END' />
            </column>
            <column caption='Reorder Rate 7 Days' datatype='real' hidden='true' name='[Reorder Frequency 14 Days (copy)_68116996810883087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([reorder_freq_7_days])/sum([total_orders])' />
            </column>
            <column caption='Reorder Rate 30 Days' datatype='real' hidden='true' name='[Reorder Frequency 7 Days (copy)_68116996811022352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([reorder_freq_30_days])/sum([total_orders])' />
            </column>
