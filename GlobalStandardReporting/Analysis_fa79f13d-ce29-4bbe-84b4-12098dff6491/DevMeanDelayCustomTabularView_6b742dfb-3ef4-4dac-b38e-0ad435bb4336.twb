            <column caption='Suffix' datatype='string' name='[Calculation_68116997080739863]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;when 1 then  &apos;%&apos;&#10;when 2 then &apos;&apos;&#10;when 3 then &apos;%&apos;&#10;when 4 then &apos;%&apos;&#10;when 5 then &apos;%&apos;&#10;when 6 then &apos;%&apos;&#10;when 7 then &apos;&apos;&#10;when 8 then &apos;%&apos;&#10;when 9 then &apos;%&apos;&#10;when 10 then &apos;%&apos;&#10;when 11 then &apos;%&apos;&#10;when 12 then &apos;&apos;&#10;&#10;END' />
            </column>
            <column caption='Dimension 2' datatype='string' name='[Dimension 1 (copy)_68116996814880790]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Dimension 1 (copy)_68116996812931090]&#10;when 1 then  STR([mean_delay])&#10;when 2 then [region]&#10;when 3 then [entity_id]&#10;when 4 then STR([city_id])&#10;when 5 then [choice_bucket]&#10;when 6 then [customer_type]&#10;when 7 then str([is_seamless])&#10;when 8 then [zone_size]&#10;when 9 then [stacked_deliveries]&#10;when 10 then STR([Calculation_4074842928906293248])&#10;when 11 then &apos;&apos;&#10;&#10;END' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Metric 1 (copy)_68116996814364693]' role='dimension' type='nominal'>
