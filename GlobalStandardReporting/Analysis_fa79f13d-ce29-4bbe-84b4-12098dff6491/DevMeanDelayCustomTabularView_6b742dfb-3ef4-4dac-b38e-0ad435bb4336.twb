    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Profit Components'>
      <repository-location derived-from='http://ip-172-31-0-209:8751/t/GlobalStandardReporting/workbooks/DevMeanDelayCustomTabularView/ProfitComponents?rev=' id='ProfitComponents' path='/t/GlobalStandardReporting/workbooks/DevMeanDelayCustomTabularView' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='parameter-ctrl'>
          <format attr='background-color' value='#f5f5f5' />
        </style-rule>
      </style>
      <size maxheight='1200' maxwidth='1200' minheight='1200' minwidth='1200' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Total Profit Components' name='federated.13dd8tx1i5ddxw178p9kz1bhyndn (copy 2)' />
        <datasource caption='Avg Profit Components' name='federated.13dd8tx1i5ddxw178p9kz1bhyndn (copy)' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column alias='Total Orders' caption='Choose Metric 1' datatype='real' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2.'>
          <calculation class='tableau' formula='2.' />
          <aliases>
            <alias key='1.' value='% Has Next Order' />
            <alias key='2.' value='Total Orders' />
            <alias key='3.' value='% Late Orders' />
