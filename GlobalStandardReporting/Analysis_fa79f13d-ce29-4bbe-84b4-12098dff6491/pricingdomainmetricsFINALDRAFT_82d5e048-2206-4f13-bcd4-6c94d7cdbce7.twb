      <column caption='VF Subscriber Discount &gt; 0 BOOL' datatype='integer' datatype-customized='true' name='[Calculation_114067797251706880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(IF SUM([vf_subscriber_discount]) &gt; 0 THEN TRUE ELSE FALSE END)' />
      </column>
      <column caption='VF Subscriber discount share &gt; 0 BOOL' datatype='integer' datatype-customized='true' name='[Calculation_114067797251936258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(IF [Calculation_54113622665592835] &gt; 0 THEN TRUE ELSE FALSE END)' />
      </column>
      <column caption='Date level average spent on incentives' datatype='real' name='[Calculation_1157284424498003970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_spent_on_incentives]) / [Calculation_1157284424758255627]' />
      </column>
      <column caption='Date level average spent on HVA-s' datatype='real' name='[Calculation_1157284424499040259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1664713431330885635]) / [Calculation_1157284424758255627]' />
      </column>
      <column caption='Date level average percentage spent on HVA-s' datatype='real' name='[Calculation_1157284424731914244]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1157284424499040259] / [Calculation_1157284424498003970]' />
      </column>
      <column caption='Share spent on HVA-s' datatype='real' name='[Calculation_1157284424741978117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//IF SUM([Total Spent On Incentives]) = 0 THEN 0 ELSE &#10;//SUM([Spent on HVA-s]) / SUM([Total Spent On Incentives]) END&#10;IF SUM([marketing_discount] - [vf_total_discount]) = 0 THEN 0 ELSE &#10;SUM([Calculation_1664713431330885635]) / SUM([marketing_discount] - [vf_total_discount]) END' />
      </column>
      <column caption='Date Level Switchable' datatype='datetime' name='[Calculation_1157284424747704326]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 1], [Calculation_1157284424769855504])&#10;&#10;// previoius version&#10;/*DATE(&#10;CASE [Date Level]&#10;WHEN &apos;Day&apos; THEN [Date]&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;, [Date], &apos;sunday&apos;)&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;, [Date])&#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [Date])&#10;WHEN &apos;Year&apos; THEN DATETRUNC(&apos;year&apos;, [Date])&#10;END&#10;)*/' />
      </column>
      <column caption='Date Level Counter' datatype='real' name='[Calculation_1157284424758255627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;year&apos; THEN 1&#10;ELSE&#10;    DATEDIFF([Parameters].[Parameter 1], &#10;        MIN(DATETRUNC([Parameters].[Parameter 1], [Calculation_1157284424769855504])), &#10;        MAX(DATETRUNC([Parameters].[Parameter 1], [Calculation_1157284424769855504]))&#10;    ) + DATEDIFF(&apos;day&apos;, DATETRUNC([Parameters].[Parameter 1], TODAY()), TODAY()) / DAY(DATEADD([Parameters].[Parameter 1], 1, DATETRUNC([Parameters].[Parameter 1], TODAY())))&#10;END' />
      </column>
      <column caption='Years' datatype='datetime' name='[Calculation_1157284424767418382]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;year&apos;, [created_date_local])' />
      </column>
      <column caption='Date in Year' datatype='date' name='[Calculation_1157284424769855504]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;year&apos;, [created_date_local]) = [Parameters].[Years Parameter] THEN [created_date_local] &#10;END' />
      </column>
      <column caption='End of Last Complete Time Interval' datatype='datetime' name='[Calculation_1157284424772612113]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;// No adjustment needed for days&#10;WHEN &apos;day&apos; THEN DATETRUNC(&apos;day&apos;, TODAY())&#10;WHEN &apos;week&apos; THEN DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY()))&#10;WHEN &apos;month&apos; THEN DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, TODAY()))&#10;WHEN &apos;quarter&apos; THEN DATEADD(&apos;quarter&apos;, -1, DATETRUNC(&apos;quarter&apos;, TODAY()))&#10;// No adjustment needed for years&#10;WHEN &apos;year&apos; THEN DATETRUNC(&apos;year&apos;, TODAY())&#10;END' />
      </column>
      <column caption='18 month time interval' datatype='date' name='[Calculation_1157284424837697567]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;month&apos;, DATETRUNC(&apos;month&apos;, [created_date_local]), TODAY()) &lt;= 18 THEN [created_date_local] &#10;END' />
      </column>
      <column caption='% Final Delivery Fee Not Dps' datatype='real' name='[Calculation_1290562833035808768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([final_delivery_fee_not_dps]) / SUM([total_orders])' />
      </column>
      <column caption='Fdnc Discount negative' datatype='real' name='[Calculation_1290562833053220865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[fdnc_discount] * -1' />
      </column>
