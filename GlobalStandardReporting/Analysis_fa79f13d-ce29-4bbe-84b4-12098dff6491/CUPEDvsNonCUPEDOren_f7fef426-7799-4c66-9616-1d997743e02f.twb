      <aliases enabled='yes' />
      <column caption='Games-Howell P-Value Change' datatype='string' name='[ANOVA Change (copy)_1836694643922096132]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF&#10;[cuped_p_value] &lt;= 0.05 AND [no_cuped_p_value] &gt; 0.05 THEN &apos;Insignificant -&gt; Significant&apos;&#10;ELSEIF [cuped_p_value] &gt; 0.05 AND [no_cuped_p_value] &lt;= 0.05 THEN &apos;Significant -&gt; Inignificant&apos;&#10;ELSEIF [cuped_p_value] &gt; 0.05 AND [no_cuped_p_value] &gt; 0.05 THEN &apos;Both Insignificant&apos;&#10;ELSEIF [cuped_p_value] &lt;= 0.05 AND [no_cuped_p_value] &lt;= 0.05 THEN &apos;Both Significant&apos;&#10;END' />
      </column>
      <column caption='ANOVA Change' datatype='string' name='[Calculation_1836694643920789507]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF&#10;[cuped_anova_p_value] &lt;= 0.05 AND [no_cuped_anova_p_value] &gt; 0.05 THEN &apos;Insignificant -&gt; Significant&apos;&#10;ELSEIF [cuped_anova_p_value] &gt; 0.05 AND [no_cuped_anova_p_value] &lt;= 0.05 THEN &apos;Significant -&gt; Inignificant&apos;&#10;ELSEIF [cuped_anova_p_value] &gt; 0.05 AND [no_cuped_anova_p_value] &gt; 0.05 THEN &apos;Both Insignificant&apos;&#10;ELSEIF [cuped_anova_p_value] &lt;= 0.05 AND [no_cuped_anova_p_value] &lt;= 0.05 THEN &apos;Both Significant&apos;&#10;END' />
      </column>
      <column aggregation='None' datatype='integer' name='[Cuped Anova Minus Non Cuped Anova (bin)]' role='dimension' type='quantitative'>
