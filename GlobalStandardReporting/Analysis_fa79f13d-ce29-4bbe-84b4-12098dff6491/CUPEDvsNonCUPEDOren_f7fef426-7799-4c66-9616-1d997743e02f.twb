              <calculation class='tableau' formula='IF&#10;[cuped_anova_p_value] &lt;= 0.05 AND [no_cuped_anova_p_value] &gt; 0.05 THEN &apos;Insignificant -&gt; Significant&apos;&#10;ELSEIF [cuped_anova_p_value] &gt; 0.05 AND [no_cuped_anova_p_value] &lt;= 0.05 THEN &apos;Significant -&gt; Inignificant&apos;&#10;ELSEIF [cuped_anova_p_value] &gt; 0.05 AND [no_cuped_anova_p_value] &gt; 0.05 THEN &apos;Both Insignificant&apos;&#10;ELSEIF [cuped_anova_p_value] &lt;= 0.05 AND [no_cuped_anova_p_value] &lt;= 0.05 THEN &apos;Both Significant&apos;&#10;END' />
