    <calculation class='tableau' formula='{ FIXED [country],[sub_channel],[region],[network],[os_name], [campaign_name] : SUM(&\#10;              IF abs(DATEDIFF(&apos;day&apos;, [date],{ FIXED : MAX([date])})) &lt;= 6&\#10;              THEN [total_cost]&\#10;              ELSE 0&\#10;              END&\#10;          )}' />
