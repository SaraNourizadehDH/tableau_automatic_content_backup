  <column aggregation='Sum' caption='Last 7 days Projected NCs (fixed)' datatype='real' default-type='quantitative' hidden='true' name='[Last 7 days Projected NCs (copia)_1588785560661921794]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='SUM({FIXED[country],[sub_channel],[region],[network],[os_name],[campaign_name]:SUM&\#10;&\#10;        (IF DATETRUNC(&apos;day&apos;,date) &gt;= DATETRUNC(&apos;day&apos;,DATEADD(&apos;day&apos;, -6,TODAY())) &\#10;&\#10;        THEN [projected_nc_net]&\#10;&\#10;        ELSE 0&\#10;&\#10;        END &\#10;)})' />
