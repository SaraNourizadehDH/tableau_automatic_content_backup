    <calculation class='tableau' formula='SUM(&\#10;&\#10;              IF abs(DATEDIFF(&apos;day&apos;, [date],{ FIXED : MAX([date])})) &lt;= 6&\#10;&\#10;              THEN [total_cost]&\#10;&\#10;              ELSE 0&\#10;&\#10;              END&\#10;&\#10;          )' />
