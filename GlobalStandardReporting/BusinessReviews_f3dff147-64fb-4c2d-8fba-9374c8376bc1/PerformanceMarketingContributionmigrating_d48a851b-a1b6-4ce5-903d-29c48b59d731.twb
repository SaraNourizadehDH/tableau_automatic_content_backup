  <column aggregation='User' caption='Completed Week Cost' datatype='real' default-type='quantitative' hidden='true' name='[Calculation_1495969175549190164]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='if WINDOW_MAX(max(DATEPART(&apos;weekday&apos;,[date])))= 7 then RUNNING_SUM(sum([total_cost])) end'>
      <table-calc ordering-type='Rows' />
    </calculation>
  </column>
  <column aggregation='Count' caption='Year-Month of Date' datatype='string' default-type='nominal' name='[Calculation_1723471336005791749]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
