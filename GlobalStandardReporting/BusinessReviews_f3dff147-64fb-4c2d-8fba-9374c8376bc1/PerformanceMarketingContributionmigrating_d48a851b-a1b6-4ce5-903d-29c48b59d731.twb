      <aliases enabled='yes' />
      <column caption='NC Target MTD' datatype='real' hidden='true' name='[Budget MTD (copy)_1372260938087079938]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MONTH([Date]) = MONTH(TODAY()-1) and YEAR([Date]) = YEAR(TODAY()) Then [NC Target] else 0 end' />
      </column>
      <column caption='Year-Month of Date' datatype='string' hidden='true' name='[Calculation_1723471336005791749]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([Date])) + &quot;-&quot; + RIGHT(&quot;0&quot;+STR(MONTH([Date])),2)' />
      </column>
      <column caption='Actual Month?' datatype='boolean' hidden='true' name='[Calculation_5354287408973410310]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if datetrunc(&apos;month&apos;,[Date]) = datetrunc(&apos;month&apos;,TODAY()-1) then true else false end' />
      </column>
      <column caption='Last day of the data' datatype='integer' hidden='true' name='[Calculation_5354287409287569422]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='day(MAX([Date]))' />
      </column>
      <column caption='Days Current Month' datatype='integer' hidden='true' name='[Calculation_5354287409315336221]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,today()))))' />
      </column>
      <column caption='Remaining Days of the Month' datatype='real' hidden='true' name='[Calculation_5354287409315414046]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEADD(&apos;month&apos;,1, DATETRUNC(&apos;month&apos;,TODAY()) ) -TODAY()' />
      </column>
      <column caption='Contribution Perfomance NCs' datatype='real' name='[Calculation_6207156615556669441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sqlproxy.07fs8xj1ng20ob1gljxat0gipyp1].[projected_nc_net])/SUM([sqlproxy.0vdjd3800lgxzu15qq4he1vsurpc].[cnt_order_is_first])' />
      </column>
      <column caption='Glovo NC RR (MTD)' datatype='real' default-format='p0.0%' hidden='true' name='[Calculation_6591862538179272705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([NC RUN RATE])/sum([NC Target])' />
      </column>
