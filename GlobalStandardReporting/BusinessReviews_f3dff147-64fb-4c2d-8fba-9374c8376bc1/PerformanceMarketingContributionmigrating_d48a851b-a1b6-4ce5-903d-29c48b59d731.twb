    <calculation class='tableau' formula='IF &\#10;DATETRUNC(&apos;month&apos;,[date])=DATETRUNC(&apos;month&apos;,dateadd(&apos;month&apos;,0,TODAY()-1))THEN &apos;Current Month&apos; &\#10;ELSEIF DATETRUNC(&apos;month&apos;,[date])=DATETRUNC(&apos;month&apos;,dateadd(&apos;month&apos;,-1,TODAY()-1))&\#10;THEN &apos;Last Month&apos; END' />
