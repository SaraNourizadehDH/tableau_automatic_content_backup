              <calculation class='tableau' formula='if [network] = &apos;ironsource&apos; then [nc_gross]&#13;&#10;ELSEIF [network] = &apos;jampp&apos; then [nc_gross]&#13;&#10;ELSE [projected_nc_net]&#13;&#10;END' />
