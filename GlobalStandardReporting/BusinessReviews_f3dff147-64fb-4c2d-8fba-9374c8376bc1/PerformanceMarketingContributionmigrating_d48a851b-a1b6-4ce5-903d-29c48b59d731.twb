  <column aggregation='User' caption='CAC' datatype='real' default-format='c\#,\#\#0&quot; €&quot;;-\#,\#\#0&quot; €&quot;' default-type='quantitative' name='[Calculation_1495969175201931277]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
