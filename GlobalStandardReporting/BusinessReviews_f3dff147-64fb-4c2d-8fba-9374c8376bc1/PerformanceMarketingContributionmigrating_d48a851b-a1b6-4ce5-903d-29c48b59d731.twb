        <calculation class='tableau' formula='SUM({FIXED [Calculation_1930848021153996800],[Calculation_4159426149281636352],[Calculation_1930848021159436291]:SUM&#10;&#10;        (IF DATETRUNC(&apos;day&apos;,[p_creation_date]) &gt;= DATETRUNC(&apos;day&apos;,DATEADD(&apos;day&apos;, -6,TODAY())) &#10;&#10;        THEN [cnt_order_is_first]&#10;&#10;        ELSE 0&#10;&#10;        END &#10;)})' />
