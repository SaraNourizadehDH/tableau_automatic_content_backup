  <column aggregation='Sum' caption='AVG Locked' datatype='real' default-type='quantitative' hidden='true' name='[AVG Outlook (copy)_59391255420276737]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='SUM([federated.165pziv0ehndlg17kt5tn1daap4h].[Locked BUDGET CONSOLIDATED])/DAY( DATEADD( &apos;month&apos;, 1, DATETRUNC(&apos;month&apos; , TODAY() ) - 1))' />
