      <column caption='Country (OD)' datatype='string' name='[Calculation_1930848021153996800]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [order_country_name]&#10;when &apos;Bosnia and Herzegovina&apos; then &apos;Bosnia &amp; Herzegovina&apos;&#10;when &apos;Ivory Coast&apos; then &apos;Ivory coast&apos;&#10;when &apos;Moldova, Republic of&apos; then &apos;Moldova&apos;&#10;else [order_country_name] end' />
      </column>
      <column caption='Country code (OD)' datatype='string' name='[Calculation_1930848021155483649]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [order_country_name]&#10;when &apos;Andorra&apos; then &apos;AD&apos;&#10;else [order_country_code] end' />
      </column>
      <column caption='OS (OD)' datatype='string' name='[Calculation_1930848021159436291]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [order_customer_device_operating_system]&#10;when &apos;ANDROID&apos; then &apos;android&apos;&#10;when &apos;IOS&apos; then &apos;ios&apos;&#10;when &apos;WEB&apos; then &apos;web&apos;&#10;else [order_customer_device_operating_system]&#10;end' />
      </column>
      <column caption='Last 7 days FOs' datatype='integer' hidden='true' name='[Calculation_3609353678561599489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;,[p_creation_date],TODAY()) &gt;= 1 and DATEDIFF(&apos;day&apos;, [p_creation_date], TODAY()) &lt;= 7 Then [cnt_order_is_first] else 0 end' />
      </column>
      <column caption='Last day of data' datatype='integer' hidden='true' name='[Calculation_3609353678561964034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='day(MAX([p_creation_date]))' />
      </column>
      <column caption='Remaining days of the month' datatype='real' hidden='true' name='[Calculation_3609353678562115587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEADD(&apos;month&apos;,1, DATETRUNC(&apos;month&apos;,TODAY()-1) ) - TODAY()' />
      </column>
      <column caption='FO Full Month Projection' datatype='real' hidden='true' name='[Calculation_3609353678562263044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cnt_order_is_first]) + ([Last 7 days FOs (copia)_1588785560668123140] / 7 * ([Calculation_3609353678562115587]))' />
      </column>
      <column caption='FO Run Rate' datatype='real' default-format='p0%' hidden='true' name='[Calculation_3609353678564970501]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3609353678562263044]/SUM([federated.1fvlfod15im14o1ab1p4f01jyo3y].[NC Target])' />
      </column>
      <column caption='Region (OD)' datatype='string' name='[Calculation_4159426149281636352]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Calculation_1930848021155483649] &#10;when &apos;ES&apos; then &apos;WE&apos;&#10;WHEN &apos;PT&apos; then &apos;WE&apos;&#10;WHEN &apos;PL&apos; then &apos;WE&apos;&#10;WHEN &apos;IT&apos; then &apos;WE&apos;&#10;WHEN &apos;RO&apos; then &apos;SEE&apos;&#10;WHEN &apos;MD&apos; then &apos;SEE&apos;&#10;WHEN &apos;BG&apos; then &apos;SEE&apos;&#10;WHEN &apos;HR&apos; then &apos;SEE&apos;&#10;WHEN &apos;RS&apos; then &apos;SEE&apos;&#10;WHEN &apos;ME&apos; then &apos;SEE&apos;&#10;WHEN &apos;SI&apos; then &apos;SEE&apos;&#10;WHEN &apos;BA&apos; then &apos;SEE&apos;&#10;WHEN &apos;UA&apos; then &apos;ECA&apos;&#10;WHEN &apos;GE&apos; then &apos;ECA&apos;&#10;WHEN &apos;KG&apos; then &apos;ECA&apos;&#10;WHEN &apos;KZ&apos; then &apos;ECA&apos;&#10;WHEN &apos;AM&apos; then &apos;ECA&apos;&#10;WHEN &apos;MA&apos; then &apos;AFRICA&apos;&#10;WHEN &apos;KE&apos; then &apos;AFRICA&apos;&#10;WHEN &apos;CI&apos; then &apos;AFRICA&apos;&#10;WHEN &apos;IC&apos; then &apos;AFRICA&apos;&#10;WHEN &apos;GH&apos; then &apos;AFRICA&apos;&#10;WHEN &apos;UG&apos; then &apos;AFRICA&apos;&#10;WHEN &apos;NG&apos; then &apos;AFRICA&apos;&#10;WHEN &apos;TN&apos; then &apos;AFRICA&apos;&#10;WHEN &apos;AR&apos; then &apos;LATAM&apos;&#10;WHEN &apos;AD&apos; THEN &apos;WE&apos;&#10;WHEN &apos;BY&apos; THEN &apos;ECA&apos;&#10;WHEN &apos;BR&apos; THEN &apos;LATAM&apos;&#10;WHEN &apos;CL&apos; THEN &apos;LATAM&apos;&#10;WHEN &apos;CO&apos; THEN &apos;LATAM&apos;&#10;WHEN &apos;CR&apos; THEN &apos;LATAM&apos;&#10;WHEN &apos;DO&apos; THEN &apos;LATAM&apos;&#10;WHEN &apos;EC&apos; THEN &apos;LATAM&apos;&#10;WHEN &apos;GT&apos; THEN &apos;LATAM&apos;&#10;WHEN &apos;HN&apos; THEN &apos;LATAM&apos;&#10;WHEN &apos;PA&apos; THEN &apos;LATAM&apos;&#10;WHEN &apos;PE&apos; THEN &apos;LATAM&apos;&#10;WHEN &apos;PR&apos; THEN &apos;LATAM&apos;&#10;WHEN &apos;UY&apos; THEN &apos;LATAM&apos;&#10;&#10;END' />
