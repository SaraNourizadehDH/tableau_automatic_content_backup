  <column aggregation='User' caption='Data update time' datatype='string' default-type='nominal' name='[Calculation_14425606797488173]' pivot='key' role='measure' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='&quot;Data is updated at &quot; + STR(DATE(MAX([date]) + 1))' />
