          <datasource-dependencies datasource='federated.1tj1o4k1bg5su011ga2520b9p3f3'>
            <column caption='% Browsing &amp; Altering Messages' datatype='real' name='[% Browsing Messages (copy)_3831367016651239429]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([count_browsing_and_altering_search_template]) + SUM([count_browsing_and_altering_shortcut_template]) + SUM([count_browsing_and_altering_suggested_template])) / (SUM([count_pasted_messages]) + SUM([count_template_messages]))' />
            </column>
            <column caption='% Altering Messages' datatype='real' name='[% Happy Path Messages (copy) (copy)_3831367016651042820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([count_altering_search_template]) + SUM([count_altering_shortcut_template]) + SUM([count_altering_suggested_template])) / (SUM([count_pasted_messages]) + SUM([count_template_messages]))' />
            </column>
            <column caption='% Browsing Messages' datatype='real' name='[% Happy Path Messages (copy)_3831367016651034627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([count_browsing_search_template]) + SUM([count_browsing_shortcut_template]) + SUM([count_browsing_suggested_template])) / (SUM([count_pasted_messages]) + SUM([count_template_messages]))' />
            </column>
            <column caption='% Shortcut Templates' datatype='real' name='[% Search Templates (copy) (copy)_6433603176326590474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_shortcut_template_messages]) / SUM([count_template_messages])' />
            </column>
            <column caption='% Suggested Templates' datatype='real' name='[% Search Templates (copy)_6433603176326574089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_suggested_template_messages]) / SUM([count_template_messages])' />
            </column>
            <column caption='Date Dimension' datatype='string' name='[Calculation_1722767599746527242]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Daily&apos; THEN STR([created_date])&#10;ELSEIF  [Parameters].[Parameter 4] = &apos;Weekly&apos; THEN STR([created_week])&#10;ELSEIF  [Parameters].[Parameter 4] = &apos;Monthly&apos; THEN STR([created_month])&#10;END' />
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_6433603176264065028]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Management Entity Group&apos; THEN [management_entity_group]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Stakeholder&apos; THEN [stakeholder]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Contact Reason L1&apos; THEN [contact_reason_l1]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Contact Reason L2&apos; THEN [contact_reason_l2]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Contact Reason L3&apos; THEN [contact_reason_l3]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Global&apos; THEN &apos;Global&apos;&#10;END' />
            </column>
            <column caption='% Search Templates' datatype='real' name='[Calculation_6433603176326492168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_search_template_messages]) / SUM([count_template_messages])' />
