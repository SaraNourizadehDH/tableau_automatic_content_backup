          <datasource-dependencies datasource='federated.19oip8u0re5tt51d41fts0xec6zi'>
            <column caption='% Browsing &amp; Altering' datatype='real' name='[% Happy Path (copy) (copy) (copy)_1722767599427829766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([browsing_and_altering_ind]) / SUM([Calculation_1722767601547247641])' />
            </column>
            <column caption='% Altering' datatype='real' name='[% Happy Path (copy) (copy)_1722767599427821573]' role='measure' type='quantitative'>
