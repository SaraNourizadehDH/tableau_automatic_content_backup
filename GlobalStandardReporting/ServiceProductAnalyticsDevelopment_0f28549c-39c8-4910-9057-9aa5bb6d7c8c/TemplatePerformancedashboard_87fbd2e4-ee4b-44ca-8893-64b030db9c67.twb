            <column caption='% Pasted Messages' datatype='real' name='[% Template Messages (copy)_6433603175984693250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_pasted_messages]) / SUM([count_all_agent_messages])' />
            </column>
            <column caption='% Typed Messages' datatype='real' name='[% Template Messages (copy)_6433603175984766979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([count_all_agent_messages]) - SUM([count_template_messages]) - SUM([count_pasted_messages]))&#10;&#10; / SUM([count_all_agent_messages])' />
            </column>
            <column caption='Date Dimension' datatype='string' name='[Calculation_1722767599746527242]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Daily&apos; THEN STR([created_date])&#10;ELSEIF  [Parameters].[Parameter 4] = &apos;Weekly&apos; THEN STR([created_week])&#10;ELSEIF  [Parameters].[Parameter 4] = &apos;Monthly&apos; THEN STR([created_month])&#10;END' />
