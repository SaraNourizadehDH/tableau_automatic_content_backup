    <datasource caption='Custom SQL Query (sandbox_iqra)' inline='true' name='federated.0ny0p7r1xp8y3t1dkem020zfpk1c' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1rdrxya109esr211e0fwh0c9ihyx'>
            <connection CATALOG='logistics-data-storage-staging' EXECCATALOG='logistics-service-staging' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='logistics-data-storage-staging' schema='sandbox_iqra' server-oauth='server-custom' username='iqra.qamar@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1rdrxya109esr211e0fwh0c9ihyx' name='Custom SQL Query' type='text'>SELECT o.management_entity_group
, o.created_date
, FORMAT_DATE(&apos;%G-%V&apos;, o.created_date) AS week
, count(distinct o.order_id) as num_orders_seamless
, count(distinct f.order_id) as num_orders_future
FROM `fulfillment-dwh-production.cl.seamless_orders` o
LEFT JOIN `fulfillment-dwh-production.cl._future_orders` f ON o.order_id = f.order_id AND f.created_date &gt;&gt;= &apos;2024-01-01&apos; AND f.delivery_provider = &apos;Own Delivery&apos; AND f.global_entity_id NOT LIKE &apos;BM_%&apos;
WHERE o.created_date &gt;&gt;= &apos;2024-01-01&apos;
AND o.delivery_provider = &apos;Own Delivery&apos;
AND o.global_entity_id NOT LIKE &apos;BM_%&apos;
AND o.customer_id IS NOT NULL
group by 1,2,3
order by 2,1</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1rdrxya109esr211e0fwh0c9ihyx' name='Custom SQL Query' type='text'>SELECT o.management_entity_group
