              <calculation class='tableau' formula='[€ Profit (incl. Extrapol.) (copy)_529735972448997376]&#10;/SUM([sum_redeemed_comp_incl_deflection_eur_observation_period])&#10;&#10;&#10;//SUM(([€ GMV Observation Period Test] - [€ GMV Observation Period Control])) &#10;// / SUM([compensation_cohort_analysis (rl_gcc_service)].[Count Redeemed Compensation Orders]) -1' />
            </column>
            <column caption='Avg. GMV per Customer Control' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Avg. GMV per Customer Test (copy)_3633701256832733193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([€ GMV Observation Period Test (copy)_3877247465320497182]) / SUM([Cohort Customers Test (copy)_3877247465256128516]))' />
            </column>
            <column caption='Avg. Incremental GMV per Customer GEID' datatype='real' name='[Avg. Incremental GMV (copy)_6631761599105007642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [quarter], [global_entity_id] :&#10;(SUM([€ GMV Observation Period (copy)_3877247465320390685]) / SUM([Cohort Customers (copy)_3877247465256046595]))&#10;- (SUM([€ GMV Observation Period Test (copy)_3877247465320497182]) / SUM([Cohort Customers Test (copy)_3877247465256128516]))&#10;}' />
            </column>
            <column caption='Avg. GMV per Customer Test' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Avg. Incremental GMV per Customer (copy)_3633701256832581640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([€ GMV Observation Period (copy)_3877247465320390685]) / SUM([Cohort Customers (copy)_3877247465256046595]))' />
            </column>
