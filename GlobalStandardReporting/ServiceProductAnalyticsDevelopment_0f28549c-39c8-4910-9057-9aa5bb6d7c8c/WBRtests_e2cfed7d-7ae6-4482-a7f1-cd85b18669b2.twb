          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Top N segments' datatype='integer' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
              <range max='12' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.17yth810bgpil111fqo5a0a178pn'>
            <column caption='Customer Group' datatype='string' name='[customer_group]' role='dimension' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
