          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1pnqs9m1x802n111p06yr06100jr'>
            <column caption='Delta Cumulative Orders (to extrapolate)' datatype='real' name='[Avg Order Frequency (copy)_7543810897328017414]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//ZN(RUNNING_SUM([Cumulative orders / cohort size])) - LOOKUP(ZN(RUNNING_SUM([Cumulative orders / cohort size])), -1)&#10;&#10;IF ATTR([customer_group]) = &apos;control&apos; THEN&#10;RUNNING_SUM((IF ATTR([customer_group]) != &apos;control&apos; THEN [Avg. Orders per Customer (copy)_2540733914625966080] END)) - RUNNING_SUM((IF ATTR([customer_group]) = &apos;control&apos; THEN [Avg. Orders per Customer (copy)_2540733914625966080] END))&#10;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Avg Order Frequency' datatype='real' name='[Avg Order Frequency (cumulative orders / cohort size) (copy)_2540733914640244738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM([Avg. Orders per Customer (copy)_2540733914625966080])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Cumulative orders / cohort size' datatype='real' name='[Avg. Orders per Customer (copy)_2540733914625966080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_reorders]) / SUM([Count Customers (copy)_2540733914626953217])&#10;&#10;// chose if only reorders or all orders' />
            </column>
            <column caption='All Orders' datatype='integer' name='[Calculation_2250885042458046464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Count Reference Orders (copy)_3133168370754555905] + [count_reorders]' />
            </column>
            <column caption='Customer Loyalty Status' datatype='string' name='[Calculation_242138891016667136]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([customer_loyalty_status], &apos;N/A&apos;)' />
            </column>
            <column caption='Avg. Orders per Customer' datatype='real' name='[Calculation_3877247467407200291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2250885042458046464]) / SUM([count_customers])' />
            </column>
            <column caption='Count Customers LOD' datatype='integer' name='[Count Customers (copy)_251849777963220992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id], [customer_cohort], [Calculation_242138891016667136] : MAX([count_customers]) }' />
            </column>
            <column caption='Initial Size of the Cohort (=Customers count week 0 on cohort level)' datatype='integer' name='[Count Customers (copy)_2540733914626953217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id], [customer_group], [policy], [customer_cohort]: MAX([count_customers])}&#10;//' />
            </column>
            <column caption='Count Reference Orders (1)' datatype='integer' name='[Count Reference Orders (copy)_3133168370754555905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Count Customers' datatype='integer' name='[count_customers]' role='measure' type='quantitative' />
            <column caption='Count Reorders' datatype='integer' name='[count_reorders]' role='measure' type='quantitative' />
            <column-instance column='[Avg. Orders per Customer (copy)_2540733914625966080]' derivation='User' name='[cum:usr:Avg. Orders per Customer (copy)_2540733914625966080:qk]' pivot='key' type='quantitative'>
