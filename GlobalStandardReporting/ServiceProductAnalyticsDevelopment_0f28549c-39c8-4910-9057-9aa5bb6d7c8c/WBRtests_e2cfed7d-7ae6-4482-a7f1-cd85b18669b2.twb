    <worksheet name='KPIs'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='14' italic='true'>KPIs</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cost_extrapolation2' name='federated.17yth810bgpil111fqo5a0a178pn' />
            <datasource caption='compensation_cohort_analysis (rl_gcc_service)' name='federated.1pnqs9m1x802n111p06yr06100jr' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Entity Granularity' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Global Entity Id&quot;'>
              <calculation class='tableau' formula='&quot;Global Entity Id&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.17yth810bgpil111fqo5a0a178pn'>
            <column caption='Δ Cumulative Orders Per Customer' datatype='real' name='[Calculation_289989660725477376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3877247465256202245] /&#10;[Order Frequency Test (copy)_3877247465256284166] - 1' />
            </column>
            <column caption='# Reorders Observation Period Test' datatype='integer' name='[Calculation_3877247465255759873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [customer_group] = &apos;test&apos; THEN [count_observation_period_cumulative_orders] ELSE 0 END' />
            </column>
            <column caption='# Cumulative Orders per Customer Test' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3877247465256202245]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3877247465255759873]) / SUM([Cohort Customers (copy)_3877247465256046595])' />
            </column>
            <column caption='Reorder Rate' datatype='real' name='[Calculation_3877247465257484298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reorder_customers]) / SUM([cohort_customers])' />
            </column>
            <column caption='€ GMV per Customer over Observation Period' datatype='real' name='[Calculation_3877247465257738251]' role='measure' type='quantitative'>
