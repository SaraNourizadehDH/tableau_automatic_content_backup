            <column caption='€ GMV (incl. Extrapol.) ' datatype='real' name='[€ Profit (incl. Extrapol.) (copy)_529735972448997376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([€ Profit (Actuals) (copy)_529735972449361921])&#10;&#10;&#10;+ [# Forecasted Incremental Orders (44w) (copy)_529735972464226314]' />
