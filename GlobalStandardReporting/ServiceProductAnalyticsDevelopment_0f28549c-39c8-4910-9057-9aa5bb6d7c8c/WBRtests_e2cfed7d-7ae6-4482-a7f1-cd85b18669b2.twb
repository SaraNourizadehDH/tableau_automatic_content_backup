              <calculation class='tableau' formula='IF&#10;([Calculation_3877247465291264020]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;) &lt; 0&#10;THEN 0&#10;ELSE &#10;([Calculation_3877247465291264020]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;)&#10;END' />
            </column>
            <column caption='Is Profit ROI positive' datatype='boolean' name='[Calculation_3877247465322987553]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Profit ROI (copy)_6631761597682597905] &gt; 0 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='% Target Profit' datatype='real' name='[Calculation_6631761597666430984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;  WHEN &apos;5%&apos;&#10;    THEN 0.05&#10;  WHEN &apos;6%&apos;&#10;    THEN 0.06&#10;  WHEN &apos;7%&apos;&#10;    THEN 0.07&#10;  WHEN &apos;8%&apos;&#10;    THEN 0.08&#10;  WHEN &apos;9%&apos;&#10;    THEN 0.09&#10;  WHEN &apos;10%&apos;&#10;    THEN 0.1&#10;&#10;END' />
            </column>
            <column caption='€ Profit (incl. Extrapol.)' datatype='real' name='[Calculation_6631761597667368969]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Incremental Orders Target Profit (copy)_6631761599112548382]&#10;&#10;&#10;+ IFNULL([Calculation_3877247465292410901],0) * [€ Avg. Order Value Test (copy)_529735972500033551] * [Calculation_6631761597666430984]' />
            </column>
            <column caption='Entity Granularity' datatype='string' name='[Calculation_6631761599051235350]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Management Entity&apos; THEN [management_entity_group]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Global Entity Id&apos; THEN [global_entity_id]&#10;END' />
            </column>
            <column caption='€ Delta Profit per Customer (Test)' datatype='real' default-format='C1031%' name='[Calculation_6631761599096475672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg. Incremental GMV (copy)_6631761599105007642]&#10; * [Calculation_6631761597666430984]' />
            </column>
            <column caption='Checkpoint Difference Y1' datatype='real' name='[Checkpoint Difference Y2 (copy)_3877247465290649619]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Reorders Checkpoint 1 (copy)_3877247465283809293] - [# Reorders Checkpoint 1 Test (copy)_3877247465283911694]' />
            </column>
            <column caption='# Cohort Customers Test' datatype='integer' name='[Cohort Customers (copy)_3877247465256046595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [customer_group] = &apos;test&apos; THEN [cohort_customers] ELSE 0 END' />
            </column>
            <column caption='# Cohort Customers Control' datatype='integer' name='[Cohort Customers Test (copy)_3877247465256128516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [customer_group] = &apos;control&apos; THEN [cohort_customers] ELSE 0 END' />
            </column>
            <column caption='€ Profit (Actuals)' datatype='real' name='[Incremental Orders Target Profit (copy)_6631761599112548382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN([Calculation_6631761599096475672]) * SUM([Cohort Customers (copy)_3877247465256046595])' />
            </column>
            <column caption='Profit ROI (incl. Profit Extrapol.)' datatype='real' name='[Profit ROI (copy)_6631761597682597905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6631761597667368969] / &#10;SUM([sum_redeemed_comp_incl_deflection_eur_observation_period])&#10;-1' />
            </column>
            <column caption='# Cohort Customers' datatype='integer' name='[cohort_customers]' role='measure' type='quantitative' />
