            <column caption='€ Avg. Customer Order Value Control' datatype='real' default-format='C1031%' name='[€ Avg. Customer Order Value Test (copy)_529735972500234256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [customer_group] = &apos;control&apos; THEN [sum_customer_avg_order_value] END) / &#10;SUM(IF [customer_group] = &apos;control&apos; THEN [Cohort Customers Test (copy)_3877247465256128516] END)' />
            </column>
            <column caption='€ Avg. Customer Order Value Test' datatype='real' default-format='C1031%' name='[€ Avg. Order Value Test (copy)_529735972500033551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [customer_group] = &apos;test&apos; THEN [sum_customer_avg_order_value] END) / &#10;SUM(IF [customer_group] = &apos;test&apos; THEN [Cohort Customers (copy)_3877247465256046595] END)' />
            </column>
            <column caption='€ GMV Observation Period Test' datatype='real' name='[€ GMV Observation Period (copy)_3877247465320390685]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [customer_group] = &apos;test&apos; THEN [sum_gmv_eur_incl_voucher_observation_period] ELSE 0 END' />
            </column>
            <column caption='€ GMV Observation Period Control' datatype='real' name='[€ GMV Observation Period Test (copy)_3877247465320497182]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [customer_group] = &apos;control&apos; THEN [sum_gmv_eur_incl_voucher_observation_period] ELSE 0 END' />
            </column>
            <column caption='€ GMV (Actuals)' datatype='real' name='[€ Profit (Actuals) (copy)_529735972449361921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg. Incremental GMV (copy)_6631761599105007642] * [Cohort Customers (copy)_3877247465256046595]' />
