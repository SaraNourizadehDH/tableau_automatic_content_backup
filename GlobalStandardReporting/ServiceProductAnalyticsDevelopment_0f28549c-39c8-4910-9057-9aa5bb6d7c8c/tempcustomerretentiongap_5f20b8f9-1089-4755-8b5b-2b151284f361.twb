    <worksheet lock-updates='true' name='Retention Gap - Reorders'>
      <table>
        <view>
          <datasources>
            <datasource caption='customer_retention_gap (sandbox_iqra)' name='federated.1ck9cb303ncghk14jb13z1h7fylw' />
          </datasources>
          <datasource-dependencies datasource='federated.1ck9cb303ncghk14jb13z1h7fylw'>
            <column caption='% reorders difference' datatype='real' name='[% GMV difference  (copy)_536209837673340941]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Avg GMV -  Non-Seamless (copy)_536209837673209867] - [Avg GMV -  Seamless (copy)_536209837673267212])/[Avg GMV -  Seamless (copy)_536209837673267212]' />
            </column>
            <column caption='Avg GMV -  Seamless' datatype='real' name='[Avg GMV -  Non-Seamless (copy)_536209837668012040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Seamless reorders (copy)_536209837664923652])/&#10;SUM({ FIXED [created_date], [global_entity_id]: COUNTD([Seamless reorders (copy)_536209837664722946])})' />
            </column>
            <column caption='Avg reorders -  Non-Seamless' datatype='real' name='[Avg GMV -  Non-Seamless (copy)_536209837673209867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Non-Seamless gmv (copy)_536209837673152522])/COUNTD([Seamless customers (copy)_536209837665046533])' />
            </column>
            <column caption='Avg reorders -  Seamless' datatype='real' name='[Avg GMV -  Seamless (copy)_536209837673267212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_536209837664563201])/COUNTD([Seamless reorders (copy)_536209837664722946])' />
            </column>
            <column caption='Seamless reorders' datatype='integer' name='[Calculation_536209837664563201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [order_experience] = &apos;Seamless&apos;&#10;then [reorders_30D] end' />
            </column>
            <column caption='Reorders difference absolute' datatype='real' name='[GMV difference  euros (copy)_536209837673783310]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg GMV -  Non-Seamless (copy)_536209837673209867] - [Avg GMV -  Seamless (copy)_536209837673267212]' />
            </column>
            <column caption='Non-Seamless reorders' datatype='integer' name='[Non-Seamless gmv (copy)_536209837673152522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [order_experience] = &apos;Non-Seamless&apos;&#10;then [reorders_30D] end' />
            </column>
            <column caption='Non-Seamless customers' datatype='string' default-role='measure' default-type='quantitative' name='[Seamless customers (copy)_536209837665046533]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [order_experience] = &apos;Non-Seamless&apos;&#10;then [customer_id] end' />
            </column>
            <column caption='Seamless customers' datatype='string' default-role='measure' default-type='quantitative' name='[Seamless reorders (copy)_536209837664722946]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [order_experience] = &apos;Seamless&apos;&#10;then [customer_id] end' />
            </column>
            <column caption='Seamless gmv' datatype='real' name='[Seamless reorders (copy)_536209837664923652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [created_date], [global_entity_id]: SUM(if [order_experience] = &apos;Seamless&apos;&#10;then [gmv_30D] end)}' />
            </column>
            <column-instance column='[Seamless customers (copy)_536209837665046533]' derivation='Count' name='[cnt:Seamless customers (copy)_536209837665046533:qk]' pivot='key' type='quantitative' />
