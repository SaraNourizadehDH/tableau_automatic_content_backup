      <aliases enabled='yes' />
      <column caption='% non-seamless orders ' datatype='real' name='[Calculation_1005499031245688833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [ranked_order_experience] IN (&apos;Not On-time&apos;, &apos;Post Order Issue&apos;, &apos;Cancelled&apos;) then [num_orders]&#10;end)/SUM([num_orders])' />
      </column>
      <column caption='% clean orders' datatype='real' name='[Calculation_649362815963140096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_clean_orders])/SUM([num_orders])' />
      </column>
      <column caption='% clean order 7D' datatype='real' name='[Calculation_649362815963365377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_clean_orders_7D])/SUM([num_orders])' />
      </column>
      <column caption='% orders with multiple issue types' datatype='real' name='[Calculation_649362815963734018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_orders_with_multiple_issues])/SUM([num_orders])' />
      </column>
      <column caption='% Customers with 70p clean orders' datatype='real' name='[Calculation_649362815963951107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_num_customers]-[num_customers_less70p_clean_orders])&#10;/ SUM([total_num_customers])' />
      </column>
      <column caption='% customers with 70p clean orders 7D' datatype='real' name='[Calculation_649362815964364804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_num_customers] - [num_customers_less70p_clean_orders_7D])/ SUM([total_num_customers])' />
      </column>
