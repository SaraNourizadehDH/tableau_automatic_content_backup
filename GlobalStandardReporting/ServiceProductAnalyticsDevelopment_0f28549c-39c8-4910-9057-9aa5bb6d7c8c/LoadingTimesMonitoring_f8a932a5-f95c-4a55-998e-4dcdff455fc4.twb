      <column caption='User Entitlement' datatype='boolean' name='[Calculation_319333412295643136]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(USERNAME(), &quot;deliveryhero&quot;) AND ISNULL([username (tableau_gsr_entitlements_management_entity_group1)]) THEN &#10;    TRUE &#10;ELSE &#10;    [username (tableau_gsr_entitlements_management_entity_group1)] = USERNAME() &#10;END' />
