          <datasource-dependencies datasource='federated.1q1nv6h1dn91yy1e1redg1grtxrc'>
            <column caption='Dimension 1' datatype='string' name='[Calculation_325244383714705409]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[product version param (copy)] = &apos;Device Type&apos; THEN [device_type]&#10;ELSEIF [Parameters].[product version param (copy)] = &apos;Product Version&apos; THEN [product_version]&#10;ELSEIF [Parameters].[product version param (copy)] = &apos;Management Entity&apos; THEN [management_entity]&#10;ELSEIF [Parameters].[product version param (copy)] = &apos;Country&apos; THEN [country]&#10;ELSE &apos;All/Global&apos;&#10;END' />
            </column>
            <column caption='Selected Metric' datatype='real' name='[Calculation_3646789862262067202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;P90 WSTI&apos; THEN SUM([p90_wsti])&#10;ELSEIF [Parameters].[Parameter 3] = &apos;P75 WSTI&apos; THEN SUM([p75_wsti])&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Median WSTI&apos; THEN SUM([median_wsti])&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Maximum WSTI&apos; THEN SUM([maximum_wsti])&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Minimum WSTI&apos; THEN SUM([minimum_wsti])&#10;END' />
            </column>
            <column caption='&quot;&quot;' datatype='string' name='[Calculation_3646789862263164932]' role='dimension' type='nominal' user:unnamed='Tabular View (Horizontal)'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column caption='&quot;&quot;' datatype='string' name='[Calculation_3646789862263201798]' role='dimension' type='nominal' user:unnamed='Tabular View (Horizontal)'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column caption='Today' datatype='date' name='[Calculation_4781415480280002562]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY()' />
            </column>
            <column caption='Today - 1 month' datatype='datetime' name='[Calculation_4781415480281300995]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;,-1,TODAY())' />
            </column>
            <column caption='Date Range Filter' datatype='boolean' name='[Date Range Filter (copy)_325244384366813190]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [aggregation_level] = &quot;daily&quot; THEN&#10;    (&#10;        STR(DATEPART(&quot;year&quot;, [Parameters].[Parameter 2])) + &quot;-&quot; + &#10;        RIGHT(&quot;0&quot; + STR(DATEPART(&quot;month&quot;, [Parameters].[Parameter 2])), 2) + &quot;-&quot; + &#10;        RIGHT(&quot;0&quot; + STR(DATEPART(&quot;day&quot;, [Parameters].[Parameter 2])), 2)&#10;    ) &#10;    &lt;= [time_granularity]&#10;    AND &#10;    (&#10;        STR(DATEPART(&quot;year&quot;, [Parameters].[start date (copy)])) + &quot;-&quot; + &#10;        RIGHT(&quot;0&quot; + STR(DATEPART(&quot;month&quot;, [Parameters].[start date (copy)])), 2) + &quot;-&quot; + &#10;        RIGHT(&quot;0&quot; + STR(DATEPART(&quot;day&quot;, [Parameters].[start date (copy)])), 2)&#10;    ) &#10;    &gt;= [time_granularity]&#10;&#10;// same for weekly&#10;ELSEIF [aggregation_level] = &quot;weekly&quot; THEN&#10;    (&#10;        STR(DATEPART(&quot;year&quot;, [Parameters].[Parameter 2])) + &quot;-&quot; + &#10;        RIGHT(&quot;0&quot; + STR(DATEPART(&quot;week&quot;, [Parameters].[Parameter 2])), 2)&#10;    ) &#10;    &lt;= [time_granularity]&#10;    AND &#10;    (&#10;        STR(DATEPART(&quot;year&quot;, [Parameters].[start date (copy)])) + &quot;-&quot; + &#10;        RIGHT(&quot;0&quot; + STR(DATEPART(&quot;week&quot;, [Parameters].[start date (copy)])), 2)&#10;    ) &#10;    &gt;= [time_granularity]&#10;&#10;// same for monthly&#10;ELSEIF [aggregation_level] = &quot;monthly&quot; THEN&#10;    (&#10;        STR(DATEPART(&quot;year&quot;, [Parameters].[Parameter 2])) + &quot;-&quot; + &#10;        RIGHT(&quot;0&quot; + STR(DATEPART(&quot;month&quot;, [Parameters].[Parameter 2])), 2)&#10;    ) &#10;    &lt;= [time_granularity]&#10;    AND &#10;    (&#10;        STR(DATEPART(&quot;year&quot;, [Parameters].[start date (copy)])) + &quot;-&quot; + &#10;        RIGHT(&quot;0&quot; + STR(DATEPART(&quot;month&quot;, [Parameters].[start date (copy)])), 2)&#10;    ) &#10;    &gt;= [time_granularity]&#10;END' />
            </column>
            <column caption='Dimension 2' datatype='string' name='[Dimension 1 Dynamic (copy)_325244383720206339]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Dimension 1 Param (copy)_325244383720075266] = &apos;Device Type&apos; THEN [device_type]&#10;ELSEIF [Parameters].[Dimension 1 Param (copy)_325244383720075266] = &apos;Product Version&apos; THEN [product_version]&#10;ELSEIF [Parameters].[Dimension 1 Param (copy)_325244383720075266] = &apos;Management Entity&apos; THEN [management_entity]&#10;ELSEIF [Parameters].[Dimension 1 Param (copy)_325244383720075266] = &apos;Country&apos; THEN [country]&#10;ELSEIF [Parameters].[Dimension 1 Param (copy)_325244383720075266] = &apos;All/Global&apos; THEN &apos;All/Global&apos;&#10;END' />
            </column>
            <column caption='Aggregation Level' datatype='string' name='[aggregation_level]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
