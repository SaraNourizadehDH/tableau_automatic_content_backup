            <column caption='Tabular View Filter' datatype='boolean' name='[filter for all (copy)_2639602009930121226]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//[Aggregation Level] = [Time Granularity param] &#10;&#10;&#10;// Note: for management entity and country we need to define special logic &#10;// as these fields are dependent on each other&#10;&#10; (&#10;// If we only have selected management entity but not country&#10;IF ([Parameters].[product version param (copy)] = &quot;Management Entity&quot; OR [Parameters].[Dimension 1 Param (copy)_325244383720075266] = &quot;Management Entity&quot;) &#10;    AND NOT ([Parameters].[product version param (copy)] = &quot;Country&quot; OR [Parameters].[Dimension 1 Param (copy)_325244383720075266] = &quot;Country&quot;) &#10;    THEN ([management_entity] != &quot;global&quot; AND [country] = &quot;global&quot;)&#10;&#10;// If we have selected either country or management entity&#10;ELSEIF ([Parameters].[product version param (copy)] = &quot;Management Entity&quot; OR [Parameters].[Dimension 1 Param (copy)_325244383720075266] = &quot;Management Entity&quot;) &#10;    AND ([Parameters].[product version param (copy)] = &quot;Country&quot; OR [Parameters].[Dimension 1 Param (copy)_325244383720075266] = &quot;Country&quot;) &#10;    THEN ([management_entity] != &quot;global&quot; AND [country] != &quot;global&quot;)&#10;&#10;// If we have selected only country&#10;ELSEIF ([Parameters].[product version param (copy)] = &quot;Country&quot; OR [Parameters].[Dimension 1 Param (copy)_325244383720075266] = &quot;Country&quot;) &#10;    THEN ([management_entity] != &quot;global&quot; AND [country] != &quot;global&quot;)&#10;&#10;// Otherwise if neither are selected we default to the global &#10;ELSEIF ([Parameters].[product version param (copy)] != &quot;Country&quot; AND [Parameters].[Dimension 1 Param (copy)_325244383720075266] != &quot;Country&quot;) &#10;    AND ([Parameters].[product version param (copy)] != &quot;Management Entity&quot; AND [Parameters].[Dimension 1 Param (copy)_325244383720075266] != &quot;Management Entity&quot;) &#10;    THEN ([management_entity] = &quot;global&quot; AND [country] = &quot;global&quot;)&#10;END&#10;)&#10;&#10;&#10;AND (&#10;    [product_version] = [Calculation_325244383714705409] &#10;    OR [product_version] = [Dimension 1 Dynamic (copy)_325244383720206339] &#10;    OR ([Calculation_325244383714705409] != [product_version] AND [Dimension 1 Dynamic (copy)_325244383720206339] != [product_version] AND [product_version] = &quot;all&quot;)&#10;)&#10;&#10;AND (&#10;    [device_type] = [Calculation_325244383714705409] &#10;    OR [device_type] = [Dimension 1 Dynamic (copy)_325244383720206339]&#10;    OR ([Calculation_325244383714705409] != [device_type] AND [Dimension 1 Dynamic (copy)_325244383720206339] != [device_type] AND [device_type] = &quot;all&quot;)&#10;)' />
            </column>
