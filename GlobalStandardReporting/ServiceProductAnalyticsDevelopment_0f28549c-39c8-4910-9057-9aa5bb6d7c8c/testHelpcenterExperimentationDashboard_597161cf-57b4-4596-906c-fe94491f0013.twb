      <aliases enabled='yes' />
      <column caption='% Multiple leaves visited' datatype='real' name='[% Active Sessions (copy)_309552106693746688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_sessions_multiple_leaves_reached])/SUM([num_sessions_leaf_reached])' />
      </column>
      <column caption='% Misclassified chats' datatype='real' name='[Calculation_1145462426274926593]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([chats_misclassified_ccr])/SUM([chats_served])' />
      </column>
      <column caption='AHT(mins)' datatype='real' name='[Calculation_1145462426275028994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([sum_chats_handling_time_sec])/60)/SUM([chats_served])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1407656393245929474]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Date filter - end date' datatype='boolean' name='[Calculation_1574008082469036032]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [created_date], DATE([end_date])) &gt;= 7' />
      </column>
      <column caption='Contacts per Orders' datatype='real' name='[Calculation_2404500034279518208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_contacts_per_order])/ SUM([num_orders])' />
      </column>
      <column caption='Maximum Date Feature-Variant' datatype='date' name='[Calculation_2404500034293587969]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{ INCLUDE [feature], [variant] : MAX([created_date]) }' />
      </column>
      <column caption='Short Term Retention' datatype='real' name='[Calculation_2480638978642718720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_7D_customer])/SUM([num_customers])' />
      </column>
      <column caption='% Multi Contact Sessions' datatype='real' name='[Calculation_309552106693865473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_sessions_multiple_contacts_created])/SUM([num_sessions_contact_created])' />
      </column>
      <column caption='Self-service CSAT' datatype='real' name='[Calculation_309552106693988354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_self_service_csat_4_5])/SUM([num_self_service_csat_responses])' />
      </column>
      <column caption='Automation CSAT' datatype='real' name='[Calculation_309552106694828036]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_automation_csat_4_5])/SUM([num_sessions_with_auto_request])' />
      </column>
      <column caption='ccr level 3 list' datatype='string' name='[Calculation_309552106696724485]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([ccr_l3_list], &apos;Unknown&apos;)' />
      </column>
      <column caption='Count of days' datatype='integer' name='[Calculation_453737662819360768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 3], [Parameters].[Start Date (copy)_623959658885988353]))' />
      </column>
      <column caption='Variant Formatted' datatype='string' name='[Calculation_453737662876241922]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REGEXP_REPLACE([variant], &apos;_&apos;, &apos; &apos;)' />
      </column>
      <column caption='% Customer cancellations' datatype='real' name='[Calculation_5564408493932224512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_orders_customer_cancelled])/SUM([num_orders])' />
      </column>
      <column caption='% Sessions with Customised Feedback' datatype='real' name='[Calculation_6207297327731085312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_sessions_customised_feedback])/SUM([num_sessions_with_leaf_rating])' />
      </column>
      <column caption='% Sessions with Leaf Rating' datatype='real' name='[Calculation_6207297327731163137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_sessions_with_leaf_rating])/SUM([num_sessions_leaf_reached])' />
      </column>
      <column caption='% Customised Feedback Submitted' datatype='real' name='[Calculation_6207297327731257346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_customised_feedback_submitted])/ SUM([num_feedback_submitted])' />
      </column>
      <column caption='Customised Feedback Volume' datatype='integer' name='[Calculation_6207297328038424580]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;% Customised Feedback Submitted&apos;&#10;THEN [num_customised_feedback_submitted]&#10;END' />
      </column>
      <column caption='Customised Feedback Volume str' datatype='string' name='[Calculation_6207297328044707847]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;% Customised Feedback Submitted&apos;&#10;THEN &apos;Customised Feedback Volume:&apos;&#10;END' />
      </column>
      <column caption='Date filter' datatype='boolean' name='[Calculation_623959658886053890]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[created_date] &gt;= [Parameters].[Parameter 3]&#10;AND [created_date] &lt;= &#10;  IF [Parameters].[Start Date (copy)_623959658885988353] &gt; TODAY() - 1 &#10;    THEN TODAY() - 1  &#10;  ELSE [Parameters].[Start Date (copy)_623959658885988353] &#10;END' />
      </column>
      <column caption='Contacts per Session' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6859826699921293312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_contacts_created])/ SUM([num_sessions_reached_resolution_page])' />
      </column>
      <column caption='Automation Adoption Rate' datatype='real' name='[Calculation_6859826699921821697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_sessions_with_auto_request])/SUM([num_sessions_reached_resolution_page])' />
      </column>
      <column caption='Automation No Contact Rate' datatype='real' name='[Calculation_6859826699922120706]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_sessions_successful_automations_no_contact])/SUM([num_sessions_successful_automations])' />
      </column>
      <column caption='Average Cost per Session' datatype='real' name='[Calculation_6859826699922472963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_compensation_agent]&#10;    + [total_compensation_helpcenter]&#10;    + [total_refund_agent]&#10;    + [total_refund_helpcenter])/&#10;SUM([num_sessions_reached_resolution_page])' />
      </column>
      <column caption='Helpcenter Refund per Session' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Calculation_6859826699924246532]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_refund_helpcenter])/ SUM([num_sessions_reached_resolution_page])' />
      </column>
      <column caption='Agent Refund per Session' datatype='real' name='[Calculation_6859826699924504581]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_refund_agent])/SUM([num_sessions_reached_resolution_page])' />
      </column>
      <column caption='Helpcenter Compensation per Session' datatype='real' name='[Calculation_6859826699924701190]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_compensation_helpcenter])/SUM([num_sessions_reached_resolution_page])' />
      </column>
      <column caption='Agent Compensation per Session' datatype='real' name='[Calculation_6859826699924893703]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_compensation_agent])/SUM([num_sessions_reached_resolution_page])' />
      </column>
      <column caption='Percentage Metrics' datatype='real' default-format='p0.0%' name='[Calculation_6859826699966287881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &apos;Automation CSAT&apos; THEN [Calculation_309552106694828036]&#10;  WHEN &apos;Self-Service CSAT&apos; THEN [Calculation_309552106693988354]&#10;  WHEN &apos;% Active Sessions&apos; THEN [Calculation_703828247325265923]&#10;  WHEN &apos;% Multiple Leaves Visited&apos; THEN [% Active Sessions (copy)_309552106693746688]&#10;  WHEN &apos;% Multi Contact Sessions&apos; THEN [Calculation_309552106693865473]&#10;  WHEN &apos;Automation Success Rate&apos; THEN [Calculation_703828247329476616]&#10;  WHEN &apos;Automation Rate&apos; THEN [Calculation_703828247328915463]&#10;  WHEN &apos;% Sessions with Customised Feedback&apos; THEN [Calculation_6207297327731085312]&#10;  WHEN &apos;% Sessions with Leaf Rating&apos; THEN [Calculation_6207297327731163137]&#10;  WHEN &apos;% Customised Feedback Submitted&apos; THEN [Calculation_6207297327731257346]&#10;  WHEN &apos;Automation Adoption Rate&apos; THEN [Calculation_6859826699921821697]&#10;  WHEN &apos;Automation No Contact Rate&apos; THEN [Calculation_6859826699922120706]&#10;  WHEN &apos;Misclassified Chats&apos; THEN [Calculation_1145462426274926593]&#10;  WHEN &apos;% Customer order cancellations&apos; THEN [Calculation_5564408493932224512]&#10;  WHEN &apos;gmv 7D&apos; then &#10;END' />
      </column>
      <column caption='Currency Metrics' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Calculation_6859826699968069642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &apos;Average Cost per Session&apos; THEN [Calculation_6859826699922472963]&#10;  WHEN &apos;Helpcenter Refund per Session&apos; THEN [Calculation_6859826699924246532]&#10;  WHEN &apos;Agent Refund per Session&apos; THEN [Calculation_6859826699924504581]&#10;  WHEN &apos;Helpcenter Compensation per Session&apos; THEN [Calculation_6859826699924701190]&#10;  WHEN &apos;Agent Compensation per Session&apos; THEN [Calculation_6859826699924893703]&#10;&#10;END' />
      </column>
      <column caption='Percentage Metrics filter' datatype='boolean' name='[Calculation_6859826699970207755]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2] IN (&#10;  &apos;Automation CSAT&apos;,&#10;  &apos;Self-Service CSAT&apos;,&#10;  &apos;% Active Sessions&apos;,&#10;  &apos;% Multiple Leaves Visited&apos;,&#10;  &apos;% Multi Contact Sessions&apos;,&#10;  &apos;Automation Success Rate&apos;,&#10;  &apos;Automation Rate&apos;,&#10;  &apos;% Sessions with Customised Feedback&apos;,&#10;  &apos;% Sessions with Leaf Rating&apos;,&#10;  &apos;% Customised Feedback Submitted&apos;,&#10;  &apos;Automation Adoption Rate&apos;,&#10;  &apos;Automation No Contact Rate&apos;,&#10;  &apos;Misclassified Chats&apos;,&#10;  &apos;% Customer order cancellations&apos;&#10;)' />
      </column>
      <column caption='Currency Metrics filter' datatype='boolean' name='[Calculation_6859826699970273292]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2] IN (&#10;  &apos;Average Cost per Session&apos;,&#10;  &apos;Helpcenter Refund per Session&apos;,&#10;  &apos;Agent Refund per Session&apos;,&#10;  &apos;Helpcenter Compensation per Session&apos;,&#10;  &apos;Agent Compensation per Session&apos;&#10;)' />
      </column>
      <column caption='% Active Sessions' datatype='real' default-format='p0.0%' name='[Calculation_703828247325265923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_sessions_active])/SUM([num_sessions])' />
      </column>
      <column caption='Self Service Rate' datatype='real' name='[Calculation_703828247326060549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_sessions_self_served])/SUM([num_sessions_reached_resolution_page])' />
      </column>
      <column caption='Variant color' datatype='string' name='[Calculation_703828247328149510]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if CONTAINS([variant], &apos;control&apos;) then &apos;Control&apos;&#10;ELSEIF CONTAINS([variant], &apos;variant&apos;) then &apos;Variant&apos;&#10;ELSEIF CONTAINS([variant], &apos;variation&apos;) then &apos;Variant&apos;&#10;else [variant] end' />
      </column>
      <column caption='Automation Rate' datatype='real' name='[Calculation_703828247328915463]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_sessions_automated])/SUM([num_sessions_reached_resolution_page])' />
      </column>
      <column caption='Automation Success Rate' datatype='real' name='[Calculation_703828247329476616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_sessions_successful_automations])/SUM([num_sessions_with_auto_request])' />
      </column>
      <column caption='CCR filter' datatype='boolean' name='[Calculation_703828247330316297]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS([Calculation_309552106696724485], [Parameters].[Parameter 1])' />
      </column>
      <column caption='Initial Page Visited' datatype='string' name='[Calculation_703828247331057674]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [initial_page] IN (&apos;mainMenu&apos;, &apos;orderDetail&apos;, &apos;whereIsMyOrder&apos;) then [initial_page]&#10;ELSEIF ISNULL([initial_page]) then &apos;Unknown&apos;&#10;ELSE &apos;Other&apos; end' />
      </column>
      <column caption='Contacts per session' datatype='real' name='[Calculation_804948094778068993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_contacts_created])/ SUM([num_sessions])' />
      </column>
      <column caption='gmv' datatype='real' name='[Calculation_988047581123121152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_7D_customer])' />
      </column>
      <column caption='No unit Metrics filter' datatype='boolean' name='[Currency Metrics filter (copy)_6859826700210290702]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2] IN (&#10;  &apos;Contacts per Session&apos;,&#10;  &apos;Contacts per Orders&apos;,&#10;   &apos;AHT(mins)&apos;&#10;)' />
      </column>
      <column caption='Feedback Submitted Volume' datatype='integer' name='[Customised Feedback Volume (copy)_6207297328038797317]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;% Customised Feedback Submitted&apos;&#10;THEN [num_feedback_submitted]&#10;END' />
      </column>
      <column caption='Submitted Feedback Volume str ' datatype='string' name='[Customised Feedback Volume str (copy)_6207297328045252616]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;% Customised Feedback Submitted&apos;&#10;THEN &apos;Submitted Feedback Volume:&apos;&#10;END' />
      </column>
      <column caption='Health Metrics Units' datatype='string' name='[Health Metrics Axis Title (copy)_6859826700223832079]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;% Active Sessions&apos; THEN &apos;%&apos;&#10;    WHEN &apos;% Multiple Leaves Visited&apos; THEN &apos;%&apos;&#10;    WHEN &apos;% Multi Contact Sessions&apos; THEN &apos;%&apos;&#10;    WHEN &apos;Automation Success Rate&apos; THEN &apos;%&apos;&#10;    WHEN &apos;Self-Service CSAT&apos; THEN &apos;%&apos;&#10;    WHEN &apos;Automation CSAT&apos; THEN &apos;%&apos;&#10;    WHEN &apos;Automation Rate&apos; THEN &apos;%&apos;&#10;    WHEN &apos;% Sessions with Customised Feedback&apos; THEN &apos;%&apos;&#10;    WHEN &apos;% Sessions with Leaf Rating&apos; THEN &apos;%&apos;&#10;    WHEN &apos;% Customised Feedback Submitted&apos; THEN &apos;%&apos;&#10;    WHEN &apos;Contacts per Session&apos; THEN &apos;&apos;&#10;    WHEN &apos;Automation Adoption Rate&apos; THEN &apos;%&apos;&#10;    WHEN &apos;Automation No Contact Rate&apos; THEN &apos;%&apos;&#10;    WHEN &apos;Average Cost per Session&apos; THEN &apos;€&apos;&#10;    WHEN &apos;Helpcenter Refund per Session&apos; THEN &apos;€&apos;&#10;    WHEN &apos;Agent Refund per Session&apos; THEN &apos;€&apos;&#10;    WHEN &apos;Helpcenter Compensation per Session&apos; THEN &apos;€&apos;&#10;    WHEN &apos;Agent Compensation per Session&apos; THEN &apos;€&apos;&#10;END' />
      </column>
      <column caption='Health Metrics Axis Title' datatype='string' name='[Metric (copy)_6859826699961987080]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;% Active Sessions&apos; THEN &apos;Active Sessions (%)&apos;&#10;    WHEN &apos;% Multiple Leaves Visited&apos; THEN &apos;Multiple Leaves Visited (%)&apos;&#10;    WHEN &apos;% Multi Contact Sessions&apos; THEN &apos;Multi Contact Sessions (%)&apos;&#10;    WHEN &apos;Automation Success Rate&apos; THEN &apos;Automation Success Rate (%)&apos;&#10;    WHEN &apos;Self-Service CSAT&apos; THEN &apos;Self-Service CSAT&apos;&#10;    WHEN &apos;Automation CSAT&apos; THEN &apos;Automation CSAT&apos;&#10;    WHEN &apos;Automation Rate&apos; THEN &apos;Automation Rate (%)&apos;&#10;    WHEN &apos;% Sessions with Customised Feedback&apos; THEN &apos;Sessions with Customised Feedback (%)&apos;&#10;    WHEN &apos;% Sessions with Leaf Rating&apos; THEN &apos;Sessions with Leaf Rating (%)&apos;&#10;    WHEN &apos;% Customised Feedback Submitted&apos; THEN &apos;Customised Feedback Submitted (%)&apos;&#10;    WHEN &apos;Contacts per Session&apos; THEN &apos;Contacts per Session&apos;&#10;    WHEN &apos;Contacts per Orders&apos; THEN &apos;Contacts per Orders&apos;&#10;    WHEN &apos;Automation Adoption Rate&apos; THEN &apos;Automation Adoption Rate (%)&apos;&#10;    WHEN &apos;Automation No Contact Rate&apos; THEN &apos;Automation No Contact Rate (%)&apos;&#10;    WHEN &apos;Average Cost per Session&apos; THEN &apos;Average Cost per Session (€)&apos;&#10;    WHEN &apos;Helpcenter Refund per Session&apos; THEN &apos;Helpcenter Refund per Session (€)&apos;&#10;    WHEN &apos;Agent Refund per Session&apos; THEN &apos;Agent Refund per Session (€)&apos;&#10;    WHEN &apos;Helpcenter Compensation per Session&apos; THEN &apos;Helpcenter Compensation per Session (€)&apos;&#10;    WHEN &apos;Agent Compensation per Session&apos; THEN &apos;Agent Compensation per Session (€)&apos;&#10;END' />
      </column>
      <column caption='No unit Metrics Denom' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[No unit Metrics (copy)_3346385641116119042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &apos;Contacts per Session&apos; THEN [num_sessions]&#10;  WHEN &apos;Contacts per Orders&apos; THEN [num_orders]&#10;  WHEN &apos;AHT(mins)&apos; THEN [chats_served]&#10;END' />
      </column>
      <column caption='No unit Metrics Denom Name' datatype='string' default-format='n#,##0.00;-#,##0.00' name='[No unit Metrics Denom (copy)_3346385641116246019]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &apos;Contacts per Session&apos; THEN &apos;Num Sessions&apos;&#10;  WHEN &apos;Contacts per Orders&apos; THEN &apos;Num Orders&apos;&#10;  WHEN &apos;AHT(mins)&apos; THEN &apos;Chats Served&apos;&#10;END' />
      </column>
      <column caption='Percentage Metrics Denom' datatype='integer' default-format='p0.0%' name='[Percentage Metrics (copy)_3346385641114423296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &apos;Automation CSAT&apos; THEN [num_sessions_with_auto_request]&#10;  WHEN &apos;Self-Service CSAT&apos; THEN [num_self_service_csat_responses]&#10;  WHEN &apos;% Active Sessions&apos; THEN [num_sessions]&#10;  WHEN &apos;% Multiple Leaves Visited&apos; THEN [num_sessions_leaf_reached]&#10;  WHEN &apos;% Multi Contact Sessions&apos; THEN [num_sessions_contact_created]&#10;  WHEN &apos;Automation Success Rate&apos; THEN [num_sessions_with_auto_request]&#10;  WHEN &apos;Automation Rate&apos; THEN [num_sessions_reached_resolution_page]&#10;  WHEN &apos;% Sessions with Customised Feedback&apos; THEN [num_sessions_with_leaf_rating]&#10;  WHEN &apos;% Sessions with Leaf Rating&apos; THEN [num_sessions_leaf_reached]&#10;  WHEN &apos;% Customised Feedback Submitted&apos; THEN [num_feedback_submitted]&#10;  WHEN &apos;Automation Adoption Rate&apos; THEN [num_sessions_reached_resolution_page]&#10;  WHEN &apos;Automation No Contact Rate&apos; THEN [num_sessions_successful_automations]&#10;  WHEN &apos;Misclassified Chats&apos; THEN [chats_served]&#10;  WHEN &apos;% Customer order cancellations&apos; THEN [num_orders]&#10;END' />
      </column>
      <column caption='No unit Metrics' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Percentage Metrics (copy)_6859826700209098765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &apos;Contacts per Session&apos; THEN [Calculation_804948094778068993]&#10;  WHEN &apos;Contacts per Orders&apos; THEN [Calculation_2404500034279518208]&#10;  WHEN &apos;AHT(mins)&apos; THEN [Calculation_1145462426275028994]&#10;  WHEN &apos;gmv 7D&apos; THEN [Calculation_988047581123121152]&#10;END' />
      </column>
      <column caption='Percentage Metrics Denom Name' datatype='string' default-format='p0.0%' name='[Percentage Metrics Denom (copy)_3346385641115152385]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &apos;Automation CSAT&apos; THEN &apos;Num Sessions With Auto Request&apos;&#10;  WHEN &apos;Self-Service CSAT&apos; THEN &apos;Num Self Service Csat Responses&apos;&#10;  WHEN &apos;% Active Sessions&apos; THEN &apos;Num Sessions&apos;&#10;  WHEN &apos;% Multiple Leaves Visited&apos; THEN &apos;Num Sessions Leaf Reached&apos;&#10;  WHEN &apos;% Multi Contact Sessions&apos; THEN &apos;Num Sessions Contact Created&apos;&#10;  WHEN &apos;Automation Success Rate&apos; THEN &apos;Num Sessions With Auto Request&apos;&#10;  WHEN &apos;Automation Rate&apos; THEN &apos;Num Sessions Reached Resolution Page&apos;&#10;  WHEN &apos;% Sessions with Customised Feedback&apos; THEN &apos;Num Session Leaf Rating&apos;&#10;  WHEN &apos;% Sessions with Leaf Rating&apos; THEN &apos;Num Sessions Leaf Reached&apos;&#10;  WHEN &apos;% Customised Feedback Submitted&apos; THEN &apos;Num Feedback Submitted&apos;&#10;  WHEN &apos;Automation Adoption Rate&apos; THEN &apos;Num Sessions Reached Resolution Page&apos;&#10;  WHEN &apos;Automation No Contact Rate&apos; THEN &apos;Num Sessions Successful Automations&apos;&#10;  WHEN &apos;Misclassified Chats&apos; THEN &apos;Chats Served&apos;&#10;  WHEN &apos;% Customer order cancellations&apos; THEN &apos;Num Orders&apos;&#10;END' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='helpcenter_experimentation' datatype='table' name='[__tableau_internal_object_id__].[helpcenter_experimentation_15360BDA8F944DF7AEA49AD9D01AB211]' role='measure' type='quantitative' />
      <column caption='Ccr L3 List' datatype='string' name='[ccr_l3_list]' role='dimension' type='nominal' />
      <column caption='Count Automation Csat 4 5' datatype='integer' name='[count_automation_csat_4_5]' role='measure' type='quantitative' />
      <column caption='Count Self Service Csat 4 5' datatype='integer' name='[count_self_service_csat_4_5]' role='measure' type='quantitative' />
