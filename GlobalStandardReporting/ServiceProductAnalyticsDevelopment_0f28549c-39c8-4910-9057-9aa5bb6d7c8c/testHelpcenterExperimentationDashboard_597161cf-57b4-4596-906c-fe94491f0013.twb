              <calculation class='tableau' formula='if [p_value] &gt; 0.05 then &apos;Not Statistically Signifcant ❌&apos; &#10;ELSEIF [p_value] &lt;= 0.05 then &apos;Statistically Significant ✅&apos;&#10;end' />
