    <worksheet name='Total Contacts'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Regular'>Contacts Created </run>
            <run>Æ&#10;</run>
            <run fontname='Tableau Regular' fontsize='10'>for selected </run>
            <run bold='true' fontcolor='#cb001b' fontname='Tableau Regular' fontsize='10'><![CDATA[<[federated.1x5fbud0g1fzor1dm0w7l1h9q5yi].[usr:Calculation_453737662819360768:qk]>]]></run>
            <run fontname='Tableau Regular' fontsize='10'> days</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='helpcenter_experimentation (rl)' name='federated.1x5fbud0g1fzor1dm0w7l1h9q5yi' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose CCR' datatype='string' datatype-customized='true' name='[Parameter 1]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column caption='Select Start Date' datatype='date' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2025-06-01#'>
              <calculation class='tableau' formula='#2025-06-01#' />
            </column>
            <column caption='Select End Date' datatype='date' name='[Start Date (copy)_623959658885988353]' param-domain-type='any' role='measure' type='quantitative' value='#2025-06-19#'>
              <calculation class='tableau' formula='#2025-06-19#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1x5fbud0g1fzor1dm0w7l1h9q5yi'>
            <column caption='ccr level 3 list' datatype='string' name='[Calculation_309552106696724485]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([ccr_l3_list], &apos;Unknown&apos;)' />
            </column>
            <column caption='Count of days' datatype='integer' name='[Calculation_453737662819360768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(DATEDIFF(&apos;day&apos;, [Parameters].[Parameter 3], [Parameters].[Start Date (copy)_623959658885988353]))' />
            </column>
            <column caption='Variant Formatted' datatype='string' name='[Calculation_453737662876241922]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='REGEXP_REPLACE([variant], &apos;_&apos;, &apos; &apos;)' />
            </column>
            <column caption='Date filter' datatype='boolean' name='[Calculation_623959658886053890]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_date] &gt;= [Parameters].[Parameter 3]&#10;AND [created_date] &lt;= &#10;  IF [Parameters].[Start Date (copy)_623959658885988353] &gt; TODAY() - 1 &#10;    THEN TODAY() - 1  &#10;  ELSE [Parameters].[Start Date (copy)_623959658885988353] &#10;END' />
            </column>
            <column caption='Variant color' datatype='string' name='[Calculation_703828247328149510]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if CONTAINS([variant], &apos;control&apos;) then &apos;Control&apos;&#10;ELSEIF CONTAINS([variant], &apos;variant&apos;) then &apos;Variant&apos;&#10;ELSEIF CONTAINS([variant], &apos;variation&apos;) then &apos;Variant&apos;&#10;else [variant] end' />
            </column>
            <column caption='CCR filter' datatype='boolean' name='[Calculation_703828247330316297]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CONTAINS([Calculation_309552106696724485], [Parameters].[Parameter 1])' />
            </column>
            <column caption='Initial Page Visited' datatype='string' name='[Calculation_703828247331057674]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [initial_page] IN (&apos;mainMenu&apos;, &apos;orderDetail&apos;, &apos;whereIsMyOrder&apos;) then [initial_page]&#10;ELSEIF ISNULL([initial_page]) then &apos;Unknown&apos;&#10;ELSE &apos;Other&apos; end' />
            </column>
