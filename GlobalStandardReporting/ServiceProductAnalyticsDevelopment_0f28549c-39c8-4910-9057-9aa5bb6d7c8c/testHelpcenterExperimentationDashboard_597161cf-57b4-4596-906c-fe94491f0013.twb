      <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
      <column caption='Feature' datatype='string' name='[feature]' role='dimension' type='nominal' />
      <column caption='Order Status' datatype='string' name='[first_order_status]' role='dimension' type='nominal' />
      <column caption='Has Delay Contact' datatype='boolean' name='[has_delay_contact]' role='dimension' type='nominal' />
