          <datasource-dependencies datasource='federated.1q3pctm1vie4vm14xd0ze18kwlqt'>
            <column caption='Self Service CSAT Response Rate (%)' datatype='real' default-format='p0.0%' name='[After Contact CSAT Response Rate (%) (copy)_6167257524476489740]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [session_type] = &apos;Automated&apos; OR [session_type] = &apos;Deflected&apos; &#10;    THEN [total_self_service_csat_responses] END)&#10;/SUM([num_contacted_sessions] + [num_deflected_sessions])' />
            </column>
            <column caption='CSAT Response Rate (%)' datatype='real' name='[Calculation_4685432511027367943]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_with_csat_response])/ SUM([num_conversations_with_resolution])' />
            </column>
            <column caption='Conversation Created Rate (%)' datatype='real' default-format='p0.0%' name='[Calculation_4685432511039066123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_with_conversation])/ SUM([num_active_sessions])' />
            </column>
            <column caption='Avg. Resolution Reach Time  (seconds)' datatype='real' name='[Calculation_4685432511379808329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_seconds_to_resolution])/SUM([num_conversations_with_resolution])' />
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_4685432511406506058]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Management Entity&apos; THEN [management_entity]&#10;    ELSEIF [Parameters].[Parameter 3] = &apos;Country&apos; THEN [country]&#10;    ELSEIF [Parameters].[Parameter 3] = &apos;Flow Version&apos; THEN [flow_version]&#10;    ELSEIF [Parameters].[Parameter 3] = &apos;Session Type&apos; THEN [session_type]&#10;    ELSEIF [Parameters].[Parameter 3] = &apos;First Order Status&apos; THEN [first_order_status]&#10;    ELSEIF [Parameters].[Parameter 3] = &apos;Total&apos; THEN &apos;Total&apos;&#10;END' />
            </column>
            <column caption='[Graphical View] Select Metric' datatype='real' name='[Calculation_4685432511410466892]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;After Contact CSAT Response Rate&apos; THEN [Calculation_6167257524476170251]&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;CSAT Response Rate&apos; THEN [Calculation_4685432511027367943]&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Positive After Contact CSAT&apos; THEN [Calculation_6167257524196282375]&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Positive After Contact Csat Responses&apos; THEN SUM([positive_after_contact_csat_responses])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Positive Self Service Csat Responses&apos; THEN SUM([positive_self_service_csat_responses])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Positive Self-Service CSAT&apos; THEN [Calculation_6167257524182712324]&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Self Service CSAT Response Rate&apos; THEN [After Contact CSAT Response Rate (%) (copy)_6167257524476489740]&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Total After Contact Csat Responses&apos; THEN SUM([total_after_contact_csat_responses])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Total Self Service Csat Responses&apos; THEN SUM([total_self_service_csat_responses])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Automation Rate&apos; THEN [Calculation_6167257524181737473]&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Avg # Go Back Clicked&apos; THEN [Calculation_6167257524249894921]&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Avg # Options Clicked&apos; THEN [Calculation_6167257524250181642]&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Avg. Resolution Reach Time&apos; THEN [Calculation_4685432511379808329]&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Avg. Step Depth to Resolution&apos; THEN [Calculation_6167257524479180817]&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Conversation Created Rate&apos; THEN [Calculation_4685432511039066123]&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Conversation Intent Rate&apos; THEN [Calculation_6167257524477714446]&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Conversation Resolution Rate&apos; THEN [Calculation_6167257524478242831]&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Deflection Rate&apos; THEN [Calculation_6167257524180905984]&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Distinct Num Stakeholders&apos; THEN SUM([distinct_num_stakeholders])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Flow Error Rate&apos; THEN [Calculation_6167257524190334981]&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Num Actions Submitted&apos; THEN SUM([num_actions_submitted])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Num Active Sessions&apos; THEN SUM([num_active_sessions])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Num Automated Sessions&apos; THEN SUM([num_automated_sessions])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Num Contacted Sessions&apos; THEN SUM([num_contacted_sessions])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Num Contacts Created&apos; THEN SUM([num_contacts_created])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Num Conversations Created&apos; THEN SUM([num_conversations_created])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Num Conversations With Intent&apos; THEN SUM([num_conversations_with_intent])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Num Conversations With Resolution&apos; THEN SUM([num_conversations_with_resolution])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Num Conversations Without Resolution&apos; THEN SUM([num_conversations_without_resolution])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Num Deflected Sessions&apos; THEN SUM([num_deflected_sessions])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Num Go Back Clicked&apos; THEN SUM([num_go_back_clicked])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Num Options Clicked&apos; THEN SUM([num_options_clicked])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Num Sessions&apos; THEN SUM([num_sessions])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Num Sessions Reached Resolution&apos; THEN SUM([num_sessions_reached_resolution])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Num Sessions With Conversation&apos; THEN SUM([num_sessions_with_conversation])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Num Sessions With Conversation Intention&apos; THEN SUM([num_sessions_with_conversation_intention])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Num Sessions With Csat Response&apos; THEN SUM([num_sessions_with_csat_response])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Num Sessions With Flow Errors&apos; THEN SUM([num_sessions_with_flow_errors])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;num_options_displayed&apos; THEN SUM([num_options_displayed])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;num_richtext_messages_displayed&apos; THEN SUM([num_richtext_messages_displayed])&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;Self-Service Rate&apos; THEN [Deflection Rate (%) (copy)_6167257524182425603]&#10;    ELSEIF [Parameters].[[Behavioural Metrics]] Select Metric (copy)_4685432511408971851] = &apos;total_seconds_to_resolution&apos; THEN SUM([total_seconds_to_resolution])&#10;END' />
            </column>
            <column caption='Deflection Rate (%)' datatype='real' default-format='p0.0%' name='[Calculation_6167257524180905984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_deflected_sessions])/SUM([num_sessions_reached_resolution])' />
            </column>
            <column caption='Automation Rate (%)' datatype='real' default-format='p0.0%' name='[Calculation_6167257524181737473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_automated_sessions])/SUM([num_sessions_reached_resolution])' />
            </column>
            <column caption='Positive Self-Service CSAT (%)' datatype='real' default-format='p0.0%' name='[Calculation_6167257524182712324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [session_type] = &apos;Deflected&apos; OR [session_type] = &apos;Automated&apos; &#10;    THEN [positive_self_service_csat_responses] &#10;    END)&#10;/&#10;SUM(IF [session_type] = &apos;Deflected&apos; OR [session_type] = &apos;Automated&apos; &#10;    THEN [total_self_service_csat_responses]&#10;    END)' />
            </column>
            <column caption='Flow Error Rate (%)' datatype='real' default-format='p0.0%' name='[Calculation_6167257524190334981]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_with_flow_errors])/SUM([num_sessions_with_conversation])' />
            </column>
            <column caption='Positive After Contact CSAT (%)' datatype='real' default-format='p0.0%' name='[Calculation_6167257524196282375]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([positive_after_contact_csat_responses])/SUM([total_after_contact_csat_responses])' />
            </column>
            <column caption='Granularity' datatype='string' name='[Calculation_6167257524214206472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Day&apos; THEN STR([created_date])&#10;    WHEN &apos;Week&apos; THEN [week]&#10;    WHEN &apos;Month&apos; THEN [month]&#10;END' />
            </column>
            <column caption='Avg # Go Back Clicked' datatype='real' name='[Calculation_6167257524249894921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_options_clicked])/ SUM([num_conversations_with_intent])' />
            </column>
            <column caption='Avg # Options Clicked' datatype='real' name='[Calculation_6167257524250181642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_options_clicked])/ SUM([num_conversations_with_intent])' />
            </column>
            <column caption='After Contact CSAT Response Rate (%)' datatype='real' default-format='p0.0%' name='[Calculation_6167257524476170251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_after_contact_csat_responses])/SUM([num_contacted_sessions])' />
            </column>
            <column caption='Conversation Intent Rate (%)' datatype='real' default-format='p0.0%' name='[Calculation_6167257524477714446]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_with_conversation_intention]) / SUM([num_sessions_with_conversation])' />
            </column>
            <column caption='Conversation Resolution Rate (%)' datatype='real' default-format='p0.0%' name='[Calculation_6167257524478242831]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_reached_resolution])/ SUM([num_sessions_with_conversation_intention])' />
            </column>
            <column caption='Avg. Step Depth to Resolution' datatype='real' name='[Calculation_6167257524479180817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [num_conversations_with_resolution] &gt; 0 THEN [num_options_clicked] ELSE 0 END)&#10;/ SUM([num_conversations_with_resolution])' />
            </column>
            <column caption='Date Range' datatype='date' name='[Date (copy)_6167257524858830868]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[created_date]' />
            </column>
            <column caption='Self-Service Rate (%)' datatype='real' default-format='p0.0%' name='[Deflection Rate (%) (copy)_6167257524182425603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_deflected_sessions] + [num_automated_sessions])/SUM([num_sessions_reached_resolution])' />
            </column>
