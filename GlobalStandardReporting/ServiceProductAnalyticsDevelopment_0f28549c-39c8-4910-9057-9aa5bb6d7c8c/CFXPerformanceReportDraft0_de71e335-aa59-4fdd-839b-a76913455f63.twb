              <calculation class='tableau' formula='{FIXED [month]: MAX([created_date])} = {FIXED: MAX([created_date])}' />
            </column>
            <column caption='Is Max Week' datatype='boolean' name='[Is Max Month (copy)_4685432511019843587]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [week]: MAX([Calculation_6167257524858769427])} = {FIXED: MAX([Calculation_6167257524858769427])}' />
            </column>
            <column caption='Is Max Week - 1 ' datatype='boolean' name='[Is Max Month - 1 (copy)_4685432511094013978]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT [Is Max Month (copy)_4685432511019843587]&#10;AND&#10;{FIXED [week]: MAX([created_date])} = {FIXED [Is Max Month (copy)_4685432511019843587]: MAX([created_date])}' />
            </column>
            <column caption='[Current] Positive Self-Service CSAT Rate' datatype='real' default-format='p0.0%' name='[[Current]] Positive After-Contact CSAT Rate (copy)_4685432511367045177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Week&apos;&#10;THEN &#10;    {EXCLUDE [created_date]: &#10;    SUM(&#10;    IF [Is Max Month (copy)_4685432511019843587]&#10;    AND ([session_type] = &apos;Deflected&apos; OR [session_type] = &apos;Automated&apos;)&#10;    THEN [positive_self_service_csat_responses]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Is Max Month (copy)_4685432511019843587]&#10;    AND ([session_type] = &apos;Deflected&apos; OR [session_type] = &apos;Automated&apos;)&#10;    THEN [total_self_service_csat_responses]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;    {EXCLUDE [created_date]: &#10;    SUM(&#10;    IF [Calculation_4685432511018688513]&#10;    AND ([session_type] = &apos;Deflected&apos; OR [session_type] = &apos;Automated&apos;)&#10;    THEN [positive_self_service_csat_responses]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Calculation_4685432511018688513]&#10;    AND ([session_type] = &apos;Deflected&apos; OR [session_type] = &apos;Automated&apos;)&#10;    THEN [total_self_service_csat_responses]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;    {EXCLUDE [created_date]: &#10;    SUM(&#10;    IF [Is Max Date (copy)_4685432511018827778]&#10;    AND ([session_type] = &apos;Deflected&apos; OR [session_type] = &apos;Automated&apos;)&#10;    THEN [positive_self_service_csat_responses]&#10;    ELSE 0 END&#10;    )&#10;&#10;    /&#10;     SUM(&#10;    IF [Is Max Date (copy)_4685432511018827778]&#10;    AND ([session_type] = &apos;Deflected&apos; OR [session_type] = &apos;Automated&apos;)&#10;    THEN [total_self_service_csat_responses]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;END' />
            </column>
            <column caption='[Negative Diff] Positive Self-Service CSAT Rate (%)' datatype='string' name='[[Negative Diff]] Positive AC CSAT Rate (%) (copy)_4685432511368478780]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [[Pct Change]] Positive AC CSAT Rate (%) (copy)_4685432511367622715]  &lt; 0&#10;THEN &quot;▼&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='[Pct Change] Positive Self-Service CSAT Rate (%)' datatype='real' default-format='p0.0%' name='[[Pct Change]] Positive AC CSAT Rate (%) (copy)_4685432511367622715]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([[Current]] Positive After-Contact CSAT Rate (copy)_4685432511367045177])-SUM([[Previous]] Positive After-Contact CSAT Rate (copy)_4685432511367311418]))/SUM([[Previous]] Positive After-Contact CSAT Rate (copy)_4685432511367311418])' />
            </column>
