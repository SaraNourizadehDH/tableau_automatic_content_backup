            <column caption='[Previous] After-Contact CSAT Response Rate (%)' datatype='real' default-format='p0.0%' name='[[Current]] After-Contact CSAT Response Rate (%) (copy)_4685432511373033537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Week&apos;&#10;THEN &#10;    {EXCLUDE [created_date]: &#10;    SUM(&#10;    IF [Is Max Month - 1 (copy)_4685432511094013978]&#10;    THEN [total_after_contact_csat_responses]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Is Max Month - 1 (copy)_4685432511094013978]&#10;    THEN [num_contacted_sessions]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;    {EXCLUDE [created_date]: &#10;    SUM(&#10;    IF [Calculation_4685432511093665816]&#10;    THEN [total_after_contact_csat_responses]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Calculation_4685432511093665816]&#10;    THEN [num_contacted_sessions]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;    {EXCLUDE [created_date]: &#10;    SUM(&#10;    IF [Is Max Date - 1 (copy)_4685432511093841945]&#10;    THEN [total_after_contact_csat_responses]&#10;    ELSE 0 END&#10;    )&#10;&#10;    /&#10;     SUM(&#10;    IF [Is Max Date - 1 (copy)_4685432511093841945]&#10;    THEN [num_contacted_sessions]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;END' />
            </column>
            <column caption='[Current] After-Contact CSAT Response Rate (%)' datatype='real' default-format='p0.0%' name='[[Current]] CSAT Response Rate (%) (copy)_4685432511371059263]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Week&apos;&#10;THEN &#10;    {EXCLUDE [created_date]: &#10;    SUM(&#10;    IF [Is Max Month (copy)_4685432511019843587]&#10;    THEN [total_after_contact_csat_responses]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Is Max Month (copy)_4685432511019843587]&#10;    THEN [num_contacted_sessions]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;    {EXCLUDE [created_date]: &#10;    SUM(&#10;    IF [Calculation_4685432511018688513]&#10;    THEN [total_after_contact_csat_responses]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Calculation_4685432511018688513]&#10;    THEN [num_contacted_sessions]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;    {EXCLUDE [created_date]: &#10;    SUM(&#10;    IF [Is Max Date (copy)_4685432511018827778]&#10;    THEN [total_after_contact_csat_responses]&#10;    ELSE 0 END&#10;    )&#10;&#10;    /&#10;     SUM(&#10;    IF [Is Max Date (copy)_4685432511018827778]&#10;    THEN [num_contacted_sessions]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;END' />
            </column>
            <column caption='[Negative Diff] After-Contact CSAT Response Rate (%)' datatype='string' name='[[Negative Diff]] Self-Service CSAT Response Rate (%) (copy)_4685432511375876168]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [[Pct Change]] Self-Service CSAT Response Rate (%) (copy)_4685432511374745668]  &lt; 0&#10;THEN &quot;▼&quot;&#10;ELSE &apos;&apos;&#10;END' />
