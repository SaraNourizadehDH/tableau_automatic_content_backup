    <worksheet name='SeSe CSAT RR tile'>
      <table>
        <view>
          <datasources>
            <datasource caption='cfx_performance_report (rl)' name='federated.1q3pctm1vie4vm14xd0ze18kwlqt' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1q3pctm1vie4vm14xd0ze18kwlqt'>
            <column caption='Is Max Date' datatype='boolean' name='[Calculation_4685432511018688513]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;,[created_date]) = &#10;&#10;{MAX(DATETRUNC(&apos;day&apos;,[created_date]))}' />
            </column>
            <column caption='Is Max Date - 1' datatype='boolean' name='[Calculation_4685432511093665816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;,[created_date]) = &#10;&#10;{MAX(DATETRUNC(&apos;day&apos;,[created_date]))} - 1' />
            </column>
            <column caption='Date' datatype='date' name='[Calculation_6167257524858769427]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[created_date]' />
            </column>
            <column caption='Date Range' datatype='date' name='[Date (copy)_6167257524858830868]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[created_date]' />
            </column>
            <column caption='Is Max Month' datatype='boolean' name='[Is Max Date (copy)_4685432511018827778]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [month]: MAX([created_date])} = {FIXED: MAX([created_date])}' />
            </column>
            <column caption='Is Max Month - 1' datatype='boolean' name='[Is Max Date - 1 (copy)_4685432511093841945]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT [Is Max Date (copy)_4685432511018827778]&#10;AND&#10;{FIXED [month]: MAX([created_date])} = {FIXED [Is Max Date (copy)_4685432511018827778]: MAX([created_date])}' />
            </column>
            <column caption='Is Max Week' datatype='boolean' name='[Is Max Month (copy)_4685432511019843587]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [week]: MAX([Calculation_6167257524858769427])} = {FIXED: MAX([Calculation_6167257524858769427])}' />
            </column>
            <column caption='Is Max Week - 1 ' datatype='boolean' name='[Is Max Month - 1 (copy)_4685432511094013978]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT [Is Max Month (copy)_4685432511019843587]&#10;AND&#10;{FIXED [week]: MAX([created_date])} = {FIXED [Is Max Month (copy)_4685432511019843587]: MAX([created_date])}' />
            </column>
            <column caption='[Current] Self-Service CSAT Response Rate (%)' datatype='real' default-format='p0.0%' name='[[Current]] After-Contact CSAT Response Rate (%) (copy)_4685432511371714624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Week&apos;&#10;THEN &#10;    {EXCLUDE [created_date]: &#10;    SUM(&#10;    IF [Is Max Month (copy)_4685432511019843587]&#10;    THEN &#10;        IF [session_type] = &apos;Automated&apos; OR [session_type] = &apos;Deflected&apos; &#10;        THEN [total_self_service_csat_responses] END&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Is Max Month (copy)_4685432511019843587]&#10;    THEN [num_automated_sessions] + [num_deflected_sessions]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;    {EXCLUDE [created_date]: &#10;    SUM(&#10;    IF [Calculation_4685432511018688513]&#10;    THEN &#10;        IF [session_type] = &apos;Automated&apos; OR [session_type] = &apos;Deflected&apos; &#10;        THEN [total_self_service_csat_responses] END&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Calculation_4685432511018688513]&#10;    THEN [num_automated_sessions] + [num_deflected_sessions]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;    {EXCLUDE [created_date]: &#10;    SUM(&#10;    IF [Is Max Date (copy)_4685432511018827778]&#10;    THEN &#10;        IF [session_type] = &apos;Automated&apos; OR [session_type] = &apos;Deflected&apos; &#10;        THEN [total_self_service_csat_responses] END&#10;    ELSE 0 END&#10;    )&#10;&#10;    /&#10;     SUM(&#10;    IF [Is Max Date (copy)_4685432511018827778]&#10;    THEN [num_automated_sessions] + [num_deflected_sessions]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;END' />
            </column>
            <column caption='[Previous] Self-Service CSAT Response Rate (%)' datatype='real' default-format='p0.0%' name='[[Current]] Self-Service CSAT Response Rate (%) (copy)_4685432511373422658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Week&apos;&#10;THEN &#10;    {EXCLUDE [created_date]: &#10;    SUM(&#10;    IF [Is Max Month - 1 (copy)_4685432511094013978]&#10;    THEN &#10;        IF [session_type] = &apos;Automated&apos; OR [session_type] = &apos;Deflected&apos; &#10;        THEN [total_self_service_csat_responses] END&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Is Max Month - 1 (copy)_4685432511094013978]&#10;    THEN [num_automated_sessions] + [num_deflected_sessions]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;    {EXCLUDE [created_date]: &#10;    SUM(&#10;    IF [Calculation_4685432511093665816]&#10;    THEN &#10;        IF [session_type] = &apos;Automated&apos; OR [session_type] = &apos;Deflected&apos; &#10;        THEN [total_self_service_csat_responses] END&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Calculation_4685432511093665816]&#10;    THEN [num_automated_sessions] + [num_deflected_sessions]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;    {EXCLUDE [created_date]: &#10;    SUM(&#10;    IF [Is Max Date - 1 (copy)_4685432511093841945]&#10;    THEN &#10;        IF [session_type] = &apos;Automated&apos; OR [session_type] = &apos;Deflected&apos; &#10;        THEN [total_self_service_csat_responses] END&#10;    ELSE 0 END&#10;    )&#10;&#10;    /&#10;     SUM(&#10;    IF [Is Max Date - 1 (copy)_4685432511093841945]&#10;    THEN [num_automated_sessions] + [num_deflected_sessions]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;END' />
            </column>
            <column caption='[Negative Diff] Self-Service CSAT Response Rate (%)' datatype='string' name='[[Negative Diff]] Positive Self-Service CSAT Rate (%) (copy)_4685432511375724615]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [[Pct Change]] Positive Self-Service CSAT Rate (%) (copy)_4685432511374385219]  &lt; 0&#10;THEN &quot;▼&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='[Pct Change] Self-Service CSAT Response Rate (%)' datatype='real' default-format='p0.0%' name='[[Pct Change]] Positive Self-Service CSAT Rate (%) (copy)_4685432511374385219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([[Current]] After-Contact CSAT Response Rate (%) (copy)_4685432511371714624])-SUM([[Current]] Self-Service CSAT Response Rate (%) (copy)_4685432511373422658]))/SUM([[Current]] Self-Service CSAT Response Rate (%) (copy)_4685432511373422658])' />
            </column>
            <column caption='[Positive Diff]  Self-Service CSAT Response Rate (%)' datatype='string' name='[[Positive Diff]] Positive Self-Service CSAT Rate (%) (copy)_4685432511375441989]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [[Pct Change]] Positive Self-Service CSAT Rate (%) (copy)_4685432511374385219] &gt; 0&#10;THEN &quot;▲&quot;&#10;ELSE &quot;&quot;&#10;END' />
            </column>
            <column-instance column='[[Current]] After-Contact CSAT Response Rate (%) (copy)_4685432511371714624]' derivation='Attribute' name='[attr:[Current]] After-Contact CSAT Response Rate (%) (copy)_4685432511371714624:qk]' pivot='key' type='quantitative' />
