          <datasource-dependencies datasource='federated.1q3pctm1vie4vm14xd0ze18kwlqt'>
            <column caption='Is Max Date' datatype='boolean' name='[Calculation_4685432511018688513]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;,[created_date]) = &#10;&#10;{MAX(DATETRUNC(&apos;day&apos;,[created_date]))}' />
