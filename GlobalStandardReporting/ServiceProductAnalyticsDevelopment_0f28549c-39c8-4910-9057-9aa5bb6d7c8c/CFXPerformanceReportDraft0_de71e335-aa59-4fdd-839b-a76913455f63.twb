            <column caption='[Pct Change] After-Contact CSAT Response Rate (%)' datatype='real' default-format='p0.0%' name='[[Pct Change]] Self-Service CSAT Response Rate (%) (copy)_4685432511374745668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([[Current]] CSAT Response Rate (%) (copy)_4685432511371059263])-SUM([[Current]] After-Contact CSAT Response Rate (%) (copy)_4685432511373033537]))/SUM([[Current]] After-Contact CSAT Response Rate (%) (copy)_4685432511373033537])' />
            </column>
            <column caption='[Positive Diff]  After-Contact CSAT Response Rate (%)' datatype='string' name='[[Positive Diff]]  Self-Service CSAT Response Rate (%) (copy)_4685432511375581254]' role='measure' type='nominal'>
