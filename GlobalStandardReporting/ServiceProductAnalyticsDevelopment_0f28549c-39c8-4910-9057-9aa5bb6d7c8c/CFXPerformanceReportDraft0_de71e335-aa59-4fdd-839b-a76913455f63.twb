                    <run fontcolor='#000000' fontname='Tableau Regular'>Please find the definitions for all the metrics in this dashboard on this tab.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Regular'>The following is a temporary glossary. It will be updated with the official data dictionary once all definitions are added.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='246' forceUpdate='true' h='83500' id='135' type-v2='text' w='18142' x='571' y='15125'>
                  <formatted-text>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>Deflection Rate</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>Automation Rate</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>Contact Rate</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>Self-Service Rate</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>Positive Self-Service CSAT</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>Positive After-Contact CSAT</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>Session Flow Error Rate</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>Avg. # of Conversations per Session</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>Avg. # of Options Clicked</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>Avg. # of Back Button Clicks</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>Conversation Intent Rate</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>Conversation Resolution Rate</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>Avg. # of Options Displayed</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>Avg. Step Depth to Resolution</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>Avg. # of Messages Displayed</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>Avg. Resolution Reach Time</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>Redirect to Case Detail Rate</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>Cancel Chat Pop-Up Rate</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#ffffff' />
                  </zone-style>
                </zone>
                <zone fixed-size='521' forceUpdate='true' h='83500' id='136' type-v2='text' w='37785' x='18713' y='15125'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>% of resolution sessions resolved without automation or contact</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>% of resolution sessions resolved through automation</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>% of resolution sessions that escalated to an agent</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>% of resolution sessions that were deflected or automated</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>% of self-service sessions rated 4 or 5 stars</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>% of contact csat sessions rated 4 or 5 stars</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>% of sessions where a system error occurred</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>Total number of conversations/ # Help center session with at least 1 conversation</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>Avg. UI options clicked to reach resolution</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>Avg. back button clicks during a conversation</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>% of sessions where the user submitted at least one action (i.e., showed engagement with the flow)</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>% of engaged sessions (with intent) that resulted in a successful resolution</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>Avg. number of clickable options shown per conversation</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>Avg. number of option clicks needed to reach resolution</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>Avg. system-generated messages shown per conversation</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>Avg. time from conversation start to resolution</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>% of sessions where users click “Go to case” after case creation</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='8'>% of sessions where users cancel chat close after seeing cancel chat pop-up</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#ffffff' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='83500' id='137' type-v2='text' w='42931' x='56498' y='15125'>
                  <formatted-text>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>SUM([# Sessions Deflected]) / SUM([# Sessions with Resolution])</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>SUM([# Sessions Automated]) / SUM([# Sessions with Resolution])</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>SUM([# Sessions Contacted]) / SUM([# Sessions with Resolution])</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>(SUM([# Sessions Deflected]) + SUM([# Sessions Automated])) / SUM([# Sessions with Resolution])</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>SUM([# Sessions with CSAT 4-5]) / SUM([# Sessions with Self-Service CSAT Response and resolution])</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>SUM([# Sessions with After-Contact CSAT 4-5]) / SUM([# Sessions with After-Contact CSAT])</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>SUM([# Sessions with System Error]) / SUM([# Total Sessions])</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>SUM([# Conversations]) / SUM([# Sessions with at least 1 Conversation])</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>SUM([# Options Clicked]) / SUM([# Resolved Conversations])</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>SUM([# Back Button Clicks]) / SUM([# Conversations with Intent])</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>SUM([# Sessions with &gt;=1 Action Submitted]) / SUM([# Total Sessions with &gt;=1 Conversation])</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>SUM([# Conversations with Resolution]) / SUM([# Sessions with Conversation Intent])</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>SUM([# Options Displayed]) / SUM([# Conversations])</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>SUM([# Option Clicks to Resolution]) / SUM([# Resolved Conversations])</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>SUM([# System Messages Displayed]) / SUM([# Conversations])</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>SUM([Resolution Timestamp] - [Conversation Start Timestamp])/SUM([# Conversations])</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>SUM([# Sessions with &quot;Go to Case&quot; Click]) / SUM([# Sessions with Case Creation])</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1c1d' fontname='Tableau Regular' fontsize='8'>SUM([# Sessions with Cancel Chat Close]) / SUM([# Sessions Where Pop-Up Was Shown])</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#ffffff' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{68B73EB3-66BE-4EE8-9D4D-AB2484CCC6C8}' />
    </dashboard>
