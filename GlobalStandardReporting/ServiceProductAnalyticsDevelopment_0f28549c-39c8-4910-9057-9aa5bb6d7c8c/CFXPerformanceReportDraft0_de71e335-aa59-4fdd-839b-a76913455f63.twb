            <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='First Order Status' datatype='string' name='[first_order_status]' role='dimension' type='nominal' />
            <column caption='Flow Version' datatype='string' name='[flow_version]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Month' datatype='string' name='[month]' role='dimension' type='nominal' />
