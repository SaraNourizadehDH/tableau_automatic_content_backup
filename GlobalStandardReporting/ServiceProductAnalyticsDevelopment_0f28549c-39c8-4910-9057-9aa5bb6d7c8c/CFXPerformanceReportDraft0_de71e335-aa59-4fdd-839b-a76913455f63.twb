              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [created_date]: &#10;    SUM(&#10;    IF [Is Max Month (copy)_4685432511019843587]&#10;    THEN [num_sessions_with_flow_errors]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Is Max Month (copy)_4685432511019843587]&#10;    THEN [num_sessions_with_conversation]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;    {EXCLUDE [created_date]: &#10;    SUM(&#10;    IF [Calculation_4685432511018688513]&#10;    THEN [num_sessions_with_flow_errors]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Calculation_4685432511018688513]&#10;    THEN [num_sessions_with_conversation]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;    {EXCLUDE [created_date]: &#10;    SUM(&#10;    IF [Is Max Date (copy)_4685432511018827778]&#10;    THEN [num_sessions_with_flow_errors]&#10;    ELSE 0 END&#10;    )&#10;&#10;    /&#10;     SUM(&#10;    IF [Is Max Date (copy)_4685432511018827778]&#10;    THEN [num_sessions_with_conversation]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;&#10;end' />
            </column>
            <column caption='[Negative Diff] Flow Error Rate (%)' datatype='string' name='[[Negative Diff]] Automation Rate (%)  (copy)_4685432511125487665]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [[Pct Change]] Deflection Rate (%) (copy)_4685432511125221424] &lt; 0&#10;THEN &quot;▼&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='[Pct Change] Flow Error Rate (%)' datatype='real' default-format='p0.0%' name='[[Pct Change]] Deflection Rate (%) (copy)_4685432511125221424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([[Previous]] Deflection Rate (%) (copy)_4685432511125004335]) != 0 &#10;THEN (SUM([[Current]] Deflection Rate (%) (copy)_4685432511124725806])-SUM([[Previous]] Deflection Rate (%) (copy)_4685432511125004335]))/SUM([[Previous]] Deflection Rate (%) (copy)_4685432511125004335])&#10;ELSE SUM([[Current]] Deflection Rate (%) (copy)_4685432511124725806])&#10;END' />
