    <worksheet name='Flow Metric Section'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#555555' fontname='Tableau Regular'>&lt;</run>
            <run bold='true' fontalignment='1' fontcolor='#555555' fontname='Tableau Regular'>[Parameters].[Parameter 2]</run>
            <run bold='true' fontalignment='1' fontcolor='#555555' fontname='Tableau Regular'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cfx_performance_report (rl)' name='federated.1q3pctm1vie4vm14xd0ze18kwlqt' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
            <column caption='[Conversation Performance] Select Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Avg. \# of Conversations per Session&quot;'>
              <calculation class='tableau' formula='&quot;Avg. # of Conversations per Session&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1q3pctm1vie4vm14xd0ze18kwlqt'>
            <column caption='Avg. # Messages Displayed' datatype='real' name='[Avg. # Options Displayed (copy)_4685432511771471954]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_richtext_messages_displayed])/sum([num_conversations_created])' />
            </column>
            <column caption='CSAT Response Rate (%)' datatype='real' name='[Calculation_4685432511027367943]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_with_csat_response])/ SUM([num_conversations_with_resolution])' />
            </column>
            <column caption='Conversation Created Rate (%)' datatype='real' default-format='p0.0%' name='[Calculation_4685432511039066123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_with_conversation])/ SUM([num_active_sessions])' />
            </column>
            <column caption='Flow Metric Chosen' datatype='real' name='[Calculation_4685432511058599958]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Avg. # of Conversations per Session&apos; THEN [Calculation_6167257524195147782]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg. Step Depth to Resolution&apos; THEN [Calculation_6167257524479180817]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg. Resolution Reach Time (seconds)&apos; THEN [Calculation_4685432511379808329]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg. # of Options Clicked&apos; THEN [Calculation_6167257524250181642]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg. # of Back Button Clicks&apos; THEN [Calculation_6167257524249894921]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg. # Options Displayed&apos; THEN [Calculation_6167257524478906384]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg. # Messages Displayed&apos; THEN [Avg. # Options Displayed (copy)_4685432511771471954]&#10;&#10;END' />
            </column>
            <column caption='Avg. Resolution Reach Time  (seconds)' datatype='real' name='[Calculation_4685432511379808329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_seconds_to_resolution])/SUM([num_conversations_with_resolution])' />
            </column>
            <column caption='Deflection Rate (%)' datatype='real' default-format='p0.0%' name='[Calculation_6167257524180905984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_deflected_sessions])/SUM([num_sessions_reached_resolution])' />
            </column>
            <column caption='Automation Rate (%)' datatype='real' default-format='p0.0%' name='[Calculation_6167257524181737473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_automated_sessions])/SUM([num_sessions_reached_resolution])' />
            </column>
            <column caption='Flow Error Rate (%)' datatype='real' default-format='p0.0%' name='[Calculation_6167257524190334981]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_with_flow_errors])/SUM([num_sessions_with_conversation])' />
            </column>
            <column caption='Average # of Conversations per Session ' datatype='real' name='[Calculation_6167257524195147782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_conversations_created])/SUM([num_sessions_with_conversation])' />
            </column>
            <column caption='Granularity' datatype='string' name='[Calculation_6167257524214206472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Day&apos; THEN STR([created_date])&#10;    WHEN &apos;Week&apos; THEN [week]&#10;    WHEN &apos;Month&apos; THEN [month]&#10;END' />
            </column>
            <column caption='Avg # Go Back Clicked' datatype='real' name='[Calculation_6167257524249894921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_options_clicked])/ SUM([num_conversations_with_intent])' />
            </column>
            <column caption='Avg # Options Clicked' datatype='real' name='[Calculation_6167257524250181642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_options_clicked])/ SUM([num_conversations_with_intent])' />
            </column>
            <column caption='After Contact CSAT Response Rate (%)' datatype='real' default-format='p0.0%' name='[Calculation_6167257524476170251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_after_contact_csat_responses])/SUM([num_contacted_sessions])' />
            </column>
            <column caption='Conversation Intent Rate (%)' datatype='real' default-format='p0.0%' name='[Calculation_6167257524477714446]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_with_conversation_intention]) / SUM([num_sessions_with_conversation])' />
            </column>
            <column caption='Conversation Resolution Rate (%)' datatype='real' default-format='p0.0%' name='[Calculation_6167257524478242831]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_reached_resolution])/ SUM([num_sessions_with_conversation_intention])' />
            </column>
            <column caption='Avg. # Options Displayed' datatype='real' name='[Calculation_6167257524478906384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_options_displayed])/sum([num_conversations_created])' />
            </column>
            <column caption='Avg. Step Depth to Resolution' datatype='real' name='[Calculation_6167257524479180817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [num_conversations_with_resolution] &gt; 0 THEN [num_options_clicked] ELSE 0 END)&#10;/ SUM([num_conversations_with_resolution])' />
            </column>
            <column caption='Date Range' datatype='date' name='[Date (copy)_6167257524858830868]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[created_date]' />
            </column>
            <column caption='Contact Rate (%) ' datatype='real' default-format='p0.0%' name='[Deflection Rate (%) (copy)_6167257524182142978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_contacted_sessions])/SUM([num_sessions_reached_resolution])' />
            </column>
            <column caption='CCR L3 list' datatype='string' name='[ccr_list]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
