    <worksheet name='Tabular View (detailed)'>
      <table>
        <view>
          <datasources>
            <datasource caption='fcr_report' name='federated.0jmkiiy1b0xy4t1gapzyr1ynxntk' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension 2' datatype='string' name='[Dimension 1 (copy)_5817595246632890379]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand&quot;'>
              <calculation class='tableau' formula='&quot;Brand&quot;' />
            </column>
            <column caption='% FCR Type' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% FCR&quot;'>
              <calculation class='tableau' formula='&quot;% FCR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jmkiiy1b0xy4t1gapzyr1ynxntk'>
            <column caption='% Order Level FCR' datatype='real' default-format='p0.0%' name='[% FCR (copy)_6260777585673494528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_order_level_fcr])&#10;/&#10;SUM([orders])' />
            </column>
            <column caption='% Ghostless FCR' datatype='real' default-format='p0.0%' name='[% FCR (copy)_6302717321999802368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_ghostless_fcr])&#10;/&#10;SUM([count_non_ghost_contacts])' />
            </column>
            <column caption='FCR Numerator' datatype='integer' name='[Calculation_533887676058472452]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;  WHEN &apos;% Order Level FCR&apos;&#10;    THEN [count_order_level_fcr]&#10;  WHEN &apos;% Ghostless FCR&apos;&#10;    THEN [count_ghostless_fcr]&#10;  ELSE [count_fcr]&#10;END' />
            </column>
            <column caption='Date' datatype='date' name='[Calculation_5817595246513180672]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[iso_date]' />
            </column>
            <column caption='Granularity' datatype='string' name='[Calculation_5817595246522150914]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Daily&apos; THEN STR([iso_date])&#10;    WHEN &apos;Weekly&apos; THEN [week]&#10;    WHEN &apos;Monthly&apos; THEN [month]&#10;    WHEN &apos;Quarterly&apos; THEN [quarter]&#10;END' />
            </column>
            <column caption='% FCR' datatype='real' default-format='p0.0%' name='[Calculation_5817595246522478595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_fcr])&#10;/&#10;SUM([contacts])' />
            </column>
            <column caption='Dimension Selection 1' datatype='string' name='[Calculation_5817595246632919052]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;All&apos; THEN &apos;All&apos;&#10;    WHEN &apos;Management Entity&apos; THEN [management_entity]&#10;    WHEN &apos;Contact Center&apos; THEN [contact_center]&#10;    WHEN &apos;Country&apos; THEN [country]&#10;    WHEN &apos;Brand&apos; THEN [brand]&#10;    WHEN &apos;Vertical&apos; THEN [vertical]&#10;    WHEN &apos;Delivery Type&apos; THEN [delivery_type]&#10;    WHEN &apos;Preorder&apos; THEN STR([is_preorder])&#10;    WHEN &apos;Corporate&apos; THEN STR([is_corporate])&#10;    WHEN &apos;First Channel&apos; THEN [first_channel]&#10;    WHEN &apos;First Agent Tool&apos; THEN [first_agent_facing_tool]&#10;    WHEN &apos;CCR 1&apos; THEN [contact_reason_l1]&#10;    WHEN &apos;CCR 2&apos; THEN [contact_reason_l2]&#10;    WHEN &apos;CCR 3&apos; THEN [contact_reason_l3]&#10;    WHEN &apos;First Exploit Flag&apos; THEN [first_exploit_flag]&#10;    WHEN &apos;Has order_id&apos; THEN STR([is_no_order_fcr])&#10;    WHEN &apos;Date Granularity&apos; THEN [Calculation_5817595246522150914]&#10;    WHEN &apos;Stakeholder&apos; THEN [stakeholder]&#10;END' />
            </column>
            <column caption='% FCR Type' datatype='real' default-format='p0.0%' name='[Calculation_6260777585673801729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;  WHEN &apos;% Order Level FCR&apos;&#10;    THEN [% FCR (copy)_6260777585673494528]&#10;  WHEN &apos;% Ghostless FCR&apos;&#10;    THEN [% FCR (copy)_6302717321999802368]&#10;  ELSE [Calculation_5817595246522478595]&#10;END' />
