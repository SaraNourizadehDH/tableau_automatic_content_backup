    <worksheet name='FCR Contribution'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='12'>&lt;[Parameters].[Parameter 4]&gt;  </run>
            <run fontcolor='#1b1b1b' fontname='Tableau Medium' fontsize='12'>Failure</run>
            <run fontcolor='#898989' fontname='Tableau Medium' fontsize='12'>Æ </run>
            <run fontname='Tableau Medium' fontsize='12'>Contribution</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fcr_report' name='federated.0jmkiiy1b0xy4t1gapzyr1ynxntk' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Top N' datatype='integer' name='[Dimension 1 (copy)]' param-domain-type='range' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
              <range max='100' min='1' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand&quot;'>
              <calculation class='tableau' formula='&quot;Brand&quot;' />
            </column>
            <column caption='% FCR Type' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% FCR&quot;'>
              <calculation class='tableau' formula='&quot;% FCR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jmkiiy1b0xy4t1gapzyr1ynxntk'>
            <column caption='% FCR Failure Contribution by Dimension' datatype='real' default-format='p0.0%' name='[% FCR (copy)_6302717322317897730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_non_fcr_contacts])&#10;/&#10;sum([Calculation_6302717322317578241])' />
            </column>
            <column caption='% FCR Type by Dimension' datatype='real' default-format='p0.0%' name='[% FCR Type (copy)_6302717322318741510]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;  WHEN &apos;% Ghostless FCR&apos;&#10;    THEN [% Ghostless FCR (copy)_6302717322318413827]&#10;  ELSE [% FCR (copy)_6302717322317897730]&#10;END' />
            </column>
            <column caption='% Ghostless FCR Failure Contribution by Dimension' datatype='real' default-format='p0.0%' name='[% Ghostless FCR (copy)_6302717322318413827]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_non_ghostless_fcr_contacts])&#10;/&#10;sum([Contacts (Fixed) (copy)_533887675013029889])' />
            </column>
            <column caption='% Ghostless FCR Failure ' datatype='real' name='[Calculation_2080381592387514426]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_non_ghostless_fcr_contacts])&#10;/&#10;SUM([count_non_ghost_contacts])' />
            </column>
            <column caption='% FCR Failure' datatype='real' name='[Calculation_2080381592389058619]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_non_fcr_contacts])&#10;/&#10;sum([contacts])' />
            </column>
            <column caption='Date' datatype='date' name='[Calculation_5817595246513180672]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[iso_date]' />
            </column>
            <column caption='Granularity' datatype='string' name='[Calculation_5817595246522150914]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Daily&apos; THEN STR([iso_date])&#10;    WHEN &apos;Weekly&apos; THEN [week]&#10;    WHEN &apos;Monthly&apos; THEN [month]&#10;    WHEN &apos;Quarterly&apos; THEN [quarter]&#10;END' />
            </column>
            <column caption='Dimension Selection 1' datatype='string' name='[Calculation_5817595246632919052]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;All&apos; THEN &apos;All&apos;&#10;    WHEN &apos;Management Entity&apos; THEN [management_entity]&#10;    WHEN &apos;Contact Center&apos; THEN [contact_center]&#10;    WHEN &apos;Country&apos; THEN [country]&#10;    WHEN &apos;Brand&apos; THEN [brand]&#10;    WHEN &apos;Vertical&apos; THEN [vertical]&#10;    WHEN &apos;Delivery Type&apos; THEN [delivery_type]&#10;    WHEN &apos;Preorder&apos; THEN STR([is_preorder])&#10;    WHEN &apos;Corporate&apos; THEN STR([is_corporate])&#10;    WHEN &apos;First Channel&apos; THEN [first_channel]&#10;    WHEN &apos;First Agent Tool&apos; THEN [first_agent_facing_tool]&#10;    WHEN &apos;CCR 1&apos; THEN [contact_reason_l1]&#10;    WHEN &apos;CCR 2&apos; THEN [contact_reason_l2]&#10;    WHEN &apos;CCR 3&apos; THEN [contact_reason_l3]&#10;    WHEN &apos;First Exploit Flag&apos; THEN [first_exploit_flag]&#10;    WHEN &apos;Has order_id&apos; THEN STR([is_no_order_fcr])&#10;    WHEN &apos;Date Granularity&apos; THEN [Calculation_5817595246522150914]&#10;    WHEN &apos;Stakeholder&apos; THEN [stakeholder]&#10;END' />
            </column>
            <column caption='Top N vs Other' datatype='string' name='[Calculation_6058819287256420352]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Dimension Selection 1 Set]&#10;THEN [Calculation_5817595246632919052]&#10;ELSE &quot;Others&quot;&#10;END' />
            </column>
            <column caption='Contacts (Fixed)' datatype='integer' name='[Calculation_6302717322317578241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_5817595246522150914], [Calculation_5817595246513180672], [Parameters].[Parameter 2] : SUM([contacts])}' />
            </column>
            <column caption='Non Ghost Contacts (Fixed) ' datatype='integer' name='[Contacts (Fixed) (copy)_533887675013029889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_5817595246522150914], [Calculation_5817595246513180672], [Parameters].[Parameter 2] : SUM([count_non_ghost_contacts])}' />
            </column>
