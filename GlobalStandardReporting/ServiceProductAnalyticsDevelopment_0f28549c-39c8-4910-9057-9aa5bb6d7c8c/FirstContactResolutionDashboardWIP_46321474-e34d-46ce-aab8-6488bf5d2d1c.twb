    <dashboard name='Channel Deep Dive'>
      <repository-location derived-from='http://ip-172-31-0-77:8405/t/GlobalStandardReporting/workbooks/FirstContactResolutionDashboard/ChannelDeepDive?rev=' id='ChannelDeepDive' path='/t/GlobalStandardReporting/workbooks/FirstContactResolutionDashboard-WIP' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1200' maxwidth='1400' minheight='1200' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='fcr_report' name='federated.0jmkiiy1b0xy4t1gapzyr1ynxntk' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
          <calculation class='tableau' formula='&quot;Weekly&quot;' />
          <members>
            <member value='&quot;Daily&quot;' />
            <member value='&quot;Weekly&quot;' />
            <member value='&quot;Monthly&quot;' />
            <member value='&quot;Quarterly&quot;' />
