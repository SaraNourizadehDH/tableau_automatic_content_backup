            <column caption='Ticket Pickup Time Non Live Negative % Diff' datatype='string' name='[Ticket Pickup Time Live Negative % Diff (copy)_5006876886093336640]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Ticket Pickup Time Live % chg (copy)_5006876886093336639] &lt; 0&#13;&#10;THEN &quot;▼&quot;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
