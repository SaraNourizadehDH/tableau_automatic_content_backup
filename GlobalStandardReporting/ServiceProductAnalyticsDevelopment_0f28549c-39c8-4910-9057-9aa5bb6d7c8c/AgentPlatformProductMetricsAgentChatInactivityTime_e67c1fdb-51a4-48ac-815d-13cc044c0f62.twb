              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.147my0y177zl1w16t0vvu14ig1fx'>
            <column caption='Reach Negative % Diff ' datatype='string' name='[% Active Sessions Negative % Diff  (copy)_352899259486584854]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_5006876885824131077] &lt; 0&#13;&#10;THEN &quot;▼&quot;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Reach Positive % Diff ' datatype='string' name='[% Active Sessions Positive % Diff (copy)_352899259486683159]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_5006876885824131077] &gt; 0&#13;&#10;THEN &quot;▲&quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
            </column>
            <column caption='Reach' datatype='real' default-format='p0.0%' name='[Calculation_5006876885816963072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([reach_numerator]) / SUM([reach_denominator]),0)' />
            </column>
            <column caption='Reach previous' datatype='real' default-format='p0.0%' name='[Calculation_5006876885823795204]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [reach_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [reach_denominator]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [reach_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [reach_denominator]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [reach_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [reach_denominator]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;end' />
            </column>
            <column caption='Reach % chg' datatype='real' default-format='p0.0%' name='[Calculation_5006876885824131077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Reach (copy)_5006876885821673475])-SUM([Calculation_5006876885823795204]))/SUM([Calculation_5006876885823795204])' />
            </column>
            <column caption='is_max_week' datatype='boolean' name='[Calculation_672443783518289922]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [week]: MAX([report_date])} = {FIXED: MAX([report_date])}' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_905786523632222210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Day&quot; THEN STR([report_date])&#13;&#10;WHEN &quot;Week&quot; THEN [week]&#13;&#10;WHEN &quot;Month&quot; THEN [month]&#13;&#10;END' />
