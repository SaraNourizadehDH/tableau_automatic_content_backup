      <column caption='Buckets (Chats) + user increment --  cume %' datatype='string' name='[Buckets (Chats) + user increment -- volume (copy)_2750643844119781378]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// -- just a simple field to display the bucket size in tooltip&#10;//case [Handling time (in mins) for bin aggregation]&#10;//  when ([Buckets (Chats)])&#10;//    then &quot;Cumulative percentage of &quot; +[Abandoned Chat Type]+ &quot; with handling time from &quot; + str(([Buckets (Chats)])) + &quot; to &quot; + str([Abandoned chats handling time (in mins) filter]) + &quot; minutes &quot;&#10;//  else &#10;//     &quot;Cumulative percentage of &quot; +[Abandoned Chat Type]+ &quot; with handling time from &quot; + str(([Buckets (Chats)])) + &quot; to &quot; + str(([Buckets (Chats)]) + [Increment size for Chats (in mins)]) + &quot; minutes &quot;&#10;//end&#10;&#10;&#10;case [Parameters].[Increment size for Chats (in mins) (copy)_5006876886218899548]&#10;  when ([Work Item Buckets (Non-Live) (copy)_1473873381185953792])&#10;    then &quot;Cumulative percentage of &quot; +[Parameters].[Parameter 2]+ &quot; with handling time upto &quot; + str([Buckets (Chats) (copy)_6782983991717527558]) + &quot; minutes &quot;&#10;  else &#10;     &quot;Cumulative percentage of &quot; +[Parameters].[Parameter 2]+ &quot; with handling time upto &quot; + str(([Work Item Buckets (Non-Live) (copy)_1473873381185953792]) + [Parameters].[Parameter 4]) + &quot; minutes &quot;&#10;end' />
      </column>
