            <column caption='Ticket Pickup Time Live (secs)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Queue TIme Live (secs) (copy)_5006876886090911804]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([pickup_time_live_numerator]) / SUM([pickup_time_live_denominator]),0)' />
            </column>
            <column caption='Ticket Pickup Time Live % chg' datatype='real' default-format='p0.0%' name='[Queue Time Live % chg (copy)_5006876886090911803]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Queue Time Live current (copy)_5006876886090911801])-SUM([Queue Time Live previous (copy)_5006876886090911802]))/SUM([Queue Time Live previous (copy)_5006876886090911802])' />
            </column>
            <column caption='Ticket Pickup Time Live Negative % Diff' datatype='string' name='[Queue Time Live Negative % Diff (copy)_5006876886090911800]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Queue Time Live % chg (copy)_5006876886090911803] &lt; 0&#13;&#10;THEN &quot;▼&quot;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Ticket Pickup Time Live Positive % Diff' datatype='string' name='[Queue Time Live Positive % Diff (copy)_5006876886090911805]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Queue Time Live % chg (copy)_5006876886090911803] &gt; 0&#13;&#10;THEN &quot;▲&quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
            </column>
            <column caption='Ticket Pickup Time Live current' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Queue Time Live current (copy)_5006876886090911801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [pickup_time_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [pickup_time_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [pickup_time_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [pickup_time_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [pickup_time_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [pickup_time_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;end' />
            </column>
            <column caption='Ticket Pickup Time Live previous' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Queue Time Live previous (copy)_5006876886090911802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [pickup_time_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [pickup_time_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [pickup_time_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [pickup_time_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [pickup_time_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [pickup_time_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;end' />
            </column>
            <column caption='Ticket Pickup Time Non Live % chg' datatype='real' default-format='p0.0%' name='[Ticket Pickup Time Live % chg (copy)_5006876886093336639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Ticket Pickup Time Live current (copy)_5006876886093336642])-SUM([Ticket Pickup Time Live previous (copy)_5006876886093336643]))/SUM([Ticket Pickup Time Live previous (copy)_5006876886093336643])' />
            </column>
            <column caption='Ticket Pickup Time Non Live (hrs)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Ticket Pickup Time Live (secs) (copy)_5006876886093336638]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([pickup_time_non_live_numerator]) / SUM([pickup_time_non_live_denominator]) / 60,0)' />
