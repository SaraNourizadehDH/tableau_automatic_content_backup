      <table>
        <view>
          <datasources>
            <datasource caption='herocare_agent_platform_kpi_tree_report' name='federated.147my0y177zl1w16t0vvu14ig1fx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.147my0y177zl1w16t0vvu14ig1fx'>
            <column caption='is_max_week' datatype='boolean' name='[Calculation_672443783518289922]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [week]: MAX([report_date])} = {FIXED: MAX([report_date])}' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_905786523632222210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Day&quot; THEN STR([report_date])&#13;&#10;WHEN &quot;Week&quot; THEN [week]&#13;&#10;WHEN &quot;Month&quot; THEN [month]&#13;&#10;END' />
            </column>
            <column caption='Date Range' datatype='date' name='[Date (copy)_5006876885817917441]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='Wrap Up Time Live % chg' datatype='real' default-format='p0.0%' name='[Ticket Pickup Time Live % chg (copy)_5006876886173913157]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Ticket Pickup Time Live current (copy)_5006876886173913160])-SUM([Ticket Pickup Time Live previous (copy)_5006876886173913161]))/SUM([Ticket Pickup Time Live previous (copy)_5006876886173913161])' />
            </column>
            <column caption='Wrap Up Time Live (secs)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Ticket Pickup Time Live (secs) (copy)_5006876886173913156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([wrapup_time_live_numerator]) / SUM([wrapup_time_live_denominator]),0)' />
            </column>
            <column caption='Wrap Up Time Live Negative % Diff' datatype='string' name='[Ticket Pickup Time Live Negative % Diff (copy)_5006876886173913158]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Ticket Pickup Time Live % chg (copy)_5006876886173913157] &lt; 0&#13;&#10;THEN &quot;▼&quot;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Wrap Up Time Live Positive % Diff' datatype='string' name='[Ticket Pickup Time Live Positive % Diff (copy)_5006876886173913159]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Ticket Pickup Time Live % chg (copy)_5006876886173913157] &gt; 0&#13;&#10;THEN &quot;▲&quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
            </column>
            <column caption='Wrap Up Time Live current' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Ticket Pickup Time Live current (copy)_5006876886173913160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [wrapup_time_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [wrapup_time_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [wrapup_time_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [wrapup_time_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [wrapup_time_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [wrapup_time_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;end' />
            </column>
            <column caption='Wrap Up Time Live previous' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Ticket Pickup Time Live previous (copy)_5006876886173913161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [wrapup_time_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [wrapup_time_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [wrapup_time_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [wrapup_time_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [wrapup_time_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [wrapup_time_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;end' />
            </column>
            <column caption='Wrap Up Time Non Live % chg' datatype='real' default-format='p0.0%' name='[Ticket Pickup Time Non Live % chg (copy)_5006876886175236170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Ticket Pickup Time Non Live current (copy)_5006876886175236174])-SUM([Ticket Pickup Time Non Live previous (copy)_5006876886175236175]))/SUM([Ticket Pickup Time Non Live previous (copy)_5006876886175236175])' />
            </column>
            <column caption='Wrap Up Time Non Live (hrs)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Ticket Pickup Time Non Live (mins) (copy)_5006876886175236171]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([wrapup_time_non_live_numerator]) / SUM([wrapup_time_non_live_denominator]) / 60,0)' />
            </column>
            <column caption='Wrap Up Time Non Live Negative % Diff' datatype='string' name='[Ticket Pickup Time Non Live Negative % Diff (copy)_5006876886175236172]' role='measure' type='nominal'>
