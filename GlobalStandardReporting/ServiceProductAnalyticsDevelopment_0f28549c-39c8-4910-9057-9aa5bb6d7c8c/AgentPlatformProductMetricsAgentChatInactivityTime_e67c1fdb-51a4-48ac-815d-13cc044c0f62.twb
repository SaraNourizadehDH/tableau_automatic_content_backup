            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.147my0y177zl1w16t0vvu14ig1fx'>
            <column caption='Queue Time Live Negative % Diff' datatype='string' name='[Agent Chat Inactivity Time Negative % Diff (copy)_5006876886085328942]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Agent Chat Inactivty Time % chg (copy)_5006876886085328940] &lt; 0&#13;&#10;THEN &quot;▼&quot;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Queue Time Live current' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Agent Chat Inactivity Time current (copy)_5006876886085328944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [queue_time_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [queue_time_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [queue_time_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [queue_time_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [queue_time_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [queue_time_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;end' />
            </column>
            <column caption='Queue Time Live previous' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Agent Chat Inactivity Time previous (copy)_5006876886085328945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [queue_time_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [queue_time_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [queue_time_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [queue_time_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [queue_time_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [queue_time_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;end' />
            </column>
            <column caption='Queue Time Live % chg' datatype='real' default-format='p0.0%' name='[Agent Chat Inactivty Time % chg (copy)_5006876886085328940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Agent Chat Inactivity Time current (copy)_5006876886085328944])-SUM([Agent Chat Inactivity Time previous (copy)_5006876886085328945]))/SUM([Agent Chat Inactivity Time previous (copy)_5006876886085328945])' />
            </column>
            <column caption='Queue Time Live (secs)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Agent Chat Inactivty Time (secs) (copy)_5006876886085328941]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([queue_time_live_numerator]) / SUM([queue_time_live_denominator]),0)' />
            </column>
            <column caption='Queue Time Live Positive % Diff' datatype='string' name='[Agent Chat Inactivty Time Positive % Diff (copy)_5006876886085328943]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Agent Chat Inactivty Time % chg (copy)_5006876886085328940] &gt; 0&#13;&#10;THEN &quot;▲&quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
            </column>
            <column caption='is_max_week' datatype='boolean' name='[Calculation_672443783518289922]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [week]: MAX([report_date])} = {FIXED: MAX([report_date])}' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_905786523632222210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Day&quot; THEN STR([report_date])&#13;&#10;WHEN &quot;Week&quot; THEN [week]&#13;&#10;WHEN &quot;Month&quot; THEN [month]&#13;&#10;END' />
            </column>
            <column caption='Date Range' datatype='date' name='[Date (copy)_5006876885817917441]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='Queue Time Non Live (hrs)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Queue TIme Live (secs) (copy)_5006876886086873142]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([queue_time_non_live_numerator]) / SUM([queue_time_non_live_denominator]) / 60,0)' />
            </column>
            <column caption='Queue Time Non Live % chg' datatype='real' default-format='p0.0%' name='[Queue Time Live % chg (copy)_5006876886086873141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Queue Time Live current (copy)_5006876886086873139])-SUM([Queue Time Live previous (copy)_5006876886086873140]))/SUM([Queue Time Live previous (copy)_5006876886086873140])' />
            </column>
            <column caption='Queue Time Non Live Negative % Diff' datatype='string' name='[Queue Time Live Negative % Diff (copy)_5006876886086873138]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Queue Time Live % chg (copy)_5006876886086873141] &lt; 0&#13;&#10;THEN &quot;▼&quot;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Queue Time Non Live Positive % Diff' datatype='string' name='[Queue Time Live Positive % Diff (copy)_5006876886086873143]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Queue Time Live % chg (copy)_5006876886086873141] &gt; 0&#13;&#10;THEN &quot;▲&quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
            </column>
            <column caption='Queue Time Non Live current' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Queue Time Live current (copy)_5006876886086873139]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [queue_time_non_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [queue_time_non_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    / 60&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [queue_time_non_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [queue_time_non_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    / 60&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [queue_time_non_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [queue_time_non_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    / 60&#10;    }&#10;end' />
            </column>
            <column caption='Queue Time Non Live previous' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Queue Time Live previous (copy)_5006876886086873140]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [queue_time_non_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [queue_time_non_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    / 60&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [queue_time_non_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [queue_time_non_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    / 60&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [queue_time_non_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [queue_time_non_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    / 60&#10;    }&#10;end' />
