              <calculation class='tableau' formula='INT(case [Parameters].[Parameter 2]&#10;  when &apos;Agent abandoned chats&apos; &#10;    then &#10;       [agent_abandoned_chats_handling_time_mins]&#10;&#10;  when &apos;Stakeholder abandoned chats&apos;&#10;    then &#10;       [stakeholder_abandoned_chats_handling_time_mins]&#10;end)' />
