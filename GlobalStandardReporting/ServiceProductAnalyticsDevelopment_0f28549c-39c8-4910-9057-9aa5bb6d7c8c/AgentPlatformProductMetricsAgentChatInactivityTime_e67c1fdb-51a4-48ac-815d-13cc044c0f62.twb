      <column caption='Wrap Up Time Non Live (hrs)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Ticket Pickup Time Non Live (mins) (copy)_5006876886175236171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([wrapup_time_non_live_numerator]) / SUM([wrapup_time_non_live_denominator]) / 60,0)' />
      </column>
      <column caption='Wrap Up Time Non Live Negative % Diff' datatype='string' name='[Ticket Pickup Time Non Live Negative % Diff (copy)_5006876886175236172]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Ticket Pickup Time Non Live % chg (copy)_5006876886175236170] &lt; 0&#13;&#10;THEN &quot;▼&quot;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='Wrap Up Time Non Live Positive % Diff' datatype='string' name='[Ticket Pickup Time Non Live Positive % Diff (copy)_5006876886175236173]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Ticket Pickup Time Non Live % chg (copy)_5006876886175236170] &gt; 0&#13;&#10;THEN &quot;▲&quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='Wrap Up Time Non Live current' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Ticket Pickup Time Non Live current (copy)_5006876886175236174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [wrapup_time_non_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [wrapup_time_non_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    / 60&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [wrapup_time_non_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [wrapup_time_non_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    / 60&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [wrapup_time_non_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [wrapup_time_non_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    / 60&#10;    }&#10;end' />
      </column>
      <column caption='Wrap Up Time Non Live previous' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Ticket Pickup Time Non Live previous (copy)_5006876886175236175]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [wrapup_time_non_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [wrapup_time_non_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    / 60&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [wrapup_time_non_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [wrapup_time_non_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    / 60&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [wrapup_time_non_live_numerator]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [wrapup_time_non_live_denominator]&#10;    ELSE 0 END&#10;    )&#10;    / 60&#10;    }&#10;end' />
      </column>
      <column caption='Buckets (Chats)' datatype='integer' datatype-customized='true' name='[Work Item Buckets (Non-Live) (copy)_1473873381185953792]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 2]&#10;  when &apos;Agent abandoned chats&apos; &#10;    then &#10;       if [agent_abandoned_chats_handling_time_mins] &lt;= [Parameters].[Increment size for Chats (in mins) (copy)_5006876886218899548] &#10;          then CEILING([agent_abandoned_chats_handling_time_mins] / [Parameters].[Parameter 4]) * [Parameters].[Parameter 4]   //-- buckets of user given input until Start time of bin aggregation&#10;       elseif [agent_abandoned_chats_handling_time_mins] &gt; [Parameters].[Increment size for Chats (in mins) (copy)_5006876886218899548] &#10;          then [Parameters].[Increment size for Chats (in mins) (copy)_5006876886218899548]  //-- above Start time of bin aggregation all chats grouped into 1 bucket&#10;    end &#10;&#10;&#10;&#10;  when &apos;Stakeholder abandoned chats&apos;&#10;    then &#10;       if [stakeholder_abandoned_chats_handling_time_mins] &lt;= [Parameters].[Increment size for Chats (in mins) (copy)_5006876886218899548] &#10;          then CEILING([stakeholder_abandoned_chats_handling_time_mins] / [Parameters].[Parameter 4]) * [Parameters].[Parameter 4]   //-- buckets of user given input until Start time of bin aggregation&#10;       elseif [stakeholder_abandoned_chats_handling_time_mins] &gt; [Parameters].[Increment size for Chats (in mins) (copy)_5006876886218899548] &#10;          then [Parameters].[Increment size for Chats (in mins) (copy)_5006876886218899548]  //-- above Start time of bin aggregation all chats grouped into 1 bucket&#10;    end &#10;end' />
      </column>
      <column caption='Buckets (Chats) + user increment -- volume' datatype='string' name='[Work Item Buckets (Non-Live) + 5 (copy)_1473873381188009988]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// -- just a simple field to display the bucket size in tooltip&#10;case [Parameters].[Increment size for Chats (in mins) (copy)_5006876886218899548]&#10;  when ([Work Item Buckets (Non-Live) (copy)_1473873381185953792])&#10;    then &quot;Volume of &quot; +[Parameters].[Parameter 2]+ &quot; with handling time from &quot; + str(([Work Item Buckets (Non-Live) (copy)_1473873381185953792])) + &quot; to &quot; + str([Buckets (Chats) (copy)_6782983991717527558]) + &quot; minutes &quot;&#10;  else &#10;     &quot;Volume of &quot; +[Parameters].[Parameter 2]+ &quot; with handling time from &quot; + str(([Work Item Buckets (Non-Live) (copy)_1473873381185953792])) + &quot; to &quot; + str(([Work Item Buckets (Non-Live) (copy)_1473873381185953792]) + [Parameters].[Parameter 4]) + &quot; minutes &quot;&#10;end' />
      </column>
