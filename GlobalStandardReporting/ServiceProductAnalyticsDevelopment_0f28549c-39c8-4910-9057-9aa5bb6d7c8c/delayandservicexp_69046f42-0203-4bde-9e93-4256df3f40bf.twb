  <datasources>
    <datasource caption='Custom SQL Query (sandbox_iqra)' inline='true' name='federated.0jaumh70qc73t8185pemq0rshr26' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.18bek0r0rqrk4j169dfty1g5l21m'>
            <connection CATALOG='logistics-data-storage-staging' EXECCATALOG='logistics-service-staging' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='logistics-data-storage-staging' schema='sandbox_iqra' server-oauth='' username='iqra.qamar@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.18bek0r0rqrk4j169dfty1g5l21m' name='Custom SQL Query' type='text'><![CDATA[select global_entity_id, has_contact, has_no_contact_helpcenter_session, delay_bin, count((order_id || global_entity_id)) as num_orders
from (
with delay_info AS (
SELECT
   ro.created_date
   , ro.entity.id AS global_entity_id
   , ro.global_order_id AS order_id
   , ro.created_at
   , ro.timings.order_delay
   , FLOOR(ro.timings.order_delay / 60) AS delay_mins
   , CASE
    WHEN ro.timings.order_delay IS NULL THEN 'Unknown'
    WHEN FLOOR(ro.timings.order_delay / 60) << -10 THEN 'More than 10 minutes early'
    WHEN FLOOR(ro.timings.order_delay / 60) BETWEEN -10 AND -1 THEN '1-10 minutes early'
    WHEN FLOOR(ro.timings.order_delay / 60) = 0 THEN 'On time'
    WHEN FLOOR(ro.timings.order_delay / 60) BETWEEN 1 AND 10 THEN '1-10 minutes late'
    WHEN FLOOR(ro.timings.order_delay / 60) BETWEEN 11 AND 20 THEN '11-20 minutes late'
    WHEN FLOOR(ro.timings.order_delay / 60) BETWEEN 21 AND 30 THEN '21-30 minutes late'
    WHEN FLOOR(ro.timings.order_delay / 60) >> 30 THEN 'More than 30 minutes late'
END AS delay_bin
 FROM `fulfillment-dwh-production.cl.orders` ro
 WHERE ro.created_date BETWEEN '2024-06-01' AND '2024-08-31'
 AND ro.entity.id IN ('HS_SA', 'PY_AR')
)
, contacts AS (
 SELECT distinct order_id, global_entity_id
 FROM `fulfillment-dwh-production.cl.all_contacts`
  WHERE created_date BETWEEN '2024-06-01' AND '2024-09-30'
 AND global_entity_id IN ('HS_SA', 'PY_AR')
 AND stakeholder = 'Customer'
 AND order_id IS NOT NULL
 AND global_cr_code IN ('1A.1', '1A.2', '1A.12', '1A.13', '1A.14', '1A.15') -- Only considering delay and check order status related contacts
)
, helpcenter_sessions AS (
 select distinct orders AS order_id
 , global_entity_id
 from `fulfillment-dwh-production.cl.helpcenter_sessions` s
 JOIN UNNEST(order_ids) orders
  WHERE s.helpcenter = 'Customer'
   AND s.order_id IS NOT NULL
   AND s.num_contacts_created = 0
   AND created_date BETWEEN '2024-06-01' AND '2024-09-30'
   AND global_entity_id IN ('HS_SA', 'PY_AR')
   AND (last_ccr IN ('1A.1', '1A.2', '1A.12', '1A.13', '1A.14', '1A.15') -- Only considering delay and check order status related sessions
   OR first_leaf_ccr IN ('1A.1', '1A.2', '1A.12', '1A.13', '1A.14', '1A.15'))
)


SELECT d.order_id
, d.global_entity_id
, d.delay_bin
, IF(c.order_id IS NOT NULL, TRUE, FALSE) has_contact
, IF(s.order_id IS NOT NULL, TRUE, FALSE) has_no_contact_helpcenter_session
FROM delay_info d
LEFT JOIN contacts c on c.order_id = d.order_id and c.global_entity_id = d.global_entity_id
LEFT JOIN helpcenter_sessions s on s.order_id = d.order_id and s.global_entity_id = d.global_entity_id
)
group by all
order by 1,2]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.18bek0r0rqrk4j169dfty1g5l21m' name='Custom SQL Query' type='text'><![CDATA[select global_entity_id, has_contact, has_no_contact_helpcenter_session, delay_bin, count((order_id || global_entity_id)) as num_orders
from (
with delay_info AS (
SELECT
   ro.created_date
   , ro.entity.id AS global_entity_id
   , ro.global_order_id AS order_id
   , ro.created_at
   , ro.timings.order_delay
   , FLOOR(ro.timings.order_delay / 60) AS delay_mins
   , CASE
    WHEN ro.timings.order_delay IS NULL THEN 'Unknown'
    WHEN FLOOR(ro.timings.order_delay / 60) << -10 THEN 'More than 10 minutes early'
    WHEN FLOOR(ro.timings.order_delay / 60) BETWEEN -10 AND -1 THEN '1-10 minutes early'
    WHEN FLOOR(ro.timings.order_delay / 60) = 0 THEN 'On time'
    WHEN FLOOR(ro.timings.order_delay / 60) BETWEEN 1 AND 10 THEN '1-10 minutes late'
    WHEN FLOOR(ro.timings.order_delay / 60) BETWEEN 11 AND 20 THEN '11-20 minutes late'
    WHEN FLOOR(ro.timings.order_delay / 60) BETWEEN 21 AND 30 THEN '21-30 minutes late'
    WHEN FLOOR(ro.timings.order_delay / 60) >> 30 THEN 'More than 30 minutes late'
END AS delay_bin
 FROM `fulfillment-dwh-production.cl.orders` ro
 WHERE ro.created_date BETWEEN '2024-06-01' AND '2024-08-31'
 AND ro.entity.id IN ('HS_SA', 'PY_AR')
)
, contacts AS (
 SELECT distinct order_id, global_entity_id
 FROM `fulfillment-dwh-production.cl.all_contacts`
  WHERE created_date BETWEEN '2024-06-01' AND '2024-09-30'
 AND global_entity_id IN ('HS_SA', 'PY_AR')
 AND stakeholder = 'Customer'
 AND order_id IS NOT NULL
 AND global_cr_code IN ('1A.1', '1A.2', '1A.12', '1A.13', '1A.14', '1A.15') -- Only considering delay and check order status related contacts
)
, helpcenter_sessions AS (
 select distinct orders AS order_id
 , global_entity_id
 from `fulfillment-dwh-production.cl.helpcenter_sessions` s
 JOIN UNNEST(order_ids) orders
  WHERE s.helpcenter = 'Customer'
   AND s.order_id IS NOT NULL
   AND s.num_contacts_created = 0
   AND created_date BETWEEN '2024-06-01' AND '2024-09-30'
   AND global_entity_id IN ('HS_SA', 'PY_AR')
   AND (last_ccr IN ('1A.1', '1A.2', '1A.12', '1A.13', '1A.14', '1A.15') -- Only considering delay and check order status related sessions
   OR first_leaf_ccr IN ('1A.1', '1A.2', '1A.12', '1A.13', '1A.14', '1A.15'))
)


SELECT d.order_id
, d.global_entity_id
, d.delay_bin
, IF(c.order_id IS NOT NULL, TRUE, FALSE) has_contact
, IF(s.order_id IS NOT NULL, TRUE, FALSE) has_no_contact_helpcenter_session
FROM delay_info d
LEFT JOIN contacts c on c.order_id = d.order_id and c.global_entity_id = d.global_entity_id
LEFT JOIN helpcenter_sessions s on s.order_id = d.order_id and s.global_entity_id = d.global_entity_id
)
group by all
order by 1,2]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
