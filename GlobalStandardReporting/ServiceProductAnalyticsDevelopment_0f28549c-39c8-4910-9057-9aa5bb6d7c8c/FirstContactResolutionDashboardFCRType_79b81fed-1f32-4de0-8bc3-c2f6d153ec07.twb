      <aliases enabled='yes' />
      <column caption='% Call Contacts' datatype='real' default-format='p0.0%' name='[% Chat Contacts (copy)_5978176726361849857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([call_contacts]) / SUM([contacts])' />
      </column>
      <column caption='% Email Contacts' datatype='real' default-format='p0.0%' name='[% Chat Contacts (copy)_5978176726361911298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([email_contacts]) / SUM([contacts])' />
      </column>
      <column caption='% Form Contacts' datatype='real' default-format='p0.0%' name='[% Email Contacts (copy)_5978176726361956355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([form_contacts]) / SUM([contacts])' />
      </column>
      <column caption='% Order Level FCR' datatype='real' default-format='p0.0%' name='[% FCR (copy)_6260777585673494528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_order_level_fcr])&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% Other Contacts' datatype='real' default-format='p0.0%' name='[% Form Contacts (copy)_5978176726362017796]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([other_contacts]) / SUM([contacts])' />
      </column>
      <column caption='% Social Media Contacts' datatype='real' default-format='p0.0%' name='[% Other Contacts (copy)_5978176726362083333]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([social_media_contacts]) / SUM([contacts])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0jmkiiy1b0xy4t1gapzyr1ynxntk].[pcto:sum:contacts:qk:8]&quot;' value='% of Total Contacts within Granularity, Dimension 1' />
          <alias key='&quot;[federated.0jmkiiy1b0xy4t1gapzyr1ynxntk].[pcto:sum:orders:qk:7]&quot;' value='% of Total within Granularity, Dimension 1' />
          <alias key='&quot;[federated.0jmkiiy1b0xy4t1gapzyr1ynxntk].[sum:orders:qk]&quot;' value='# Unique Order-CR combinations' />
        </aliases>
      </column>
      <column caption='Avg. Wrap Duration (mins)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AHT (mins) (copy)_5817595246525636613]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([wrap_up_time_secs]) / 60)&#10;/&#10;SUM([contacts])' />
      </column>
      <column caption='Avg. Duration Since Prev Contact (mins)' datatype='real' name='[Avg. Duration Since Order (mins) (copy)_5817595246526533640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([total_duration_since_prev_contact_secs]) / 60)&#10;/&#10;SUM([contacts])' />
      </column>
      <column caption='Avg. Duration Since First Contact (mins)' datatype='real' name='[Avg. Duration Since Prev Contact (mins) (copy)_5817595246526717961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([total_duration_since_first_contact_secs]) / 60)&#10;/&#10;SUM([contacts])' />
      </column>
      <column caption='aTHT (mins)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Wrap Duration (mins) (copy)_5817595246525714438]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([total_handling_time_secs]) / 60)&#10;/&#10;SUM([contacts])' />
      </column>
      <column caption='Contacts per Order-CCR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2061100576821096448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([contacts])&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_4412472165206384640]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_5817595246513180672]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[iso_date]' />
      </column>
      <column caption='CSAT Score' datatype='real' default-format='p0.0%' name='[Calculation_5817595246518210561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_csat_4_5])&#10;/&#10;SUM([csat_responses])' />
      </column>
      <column caption='Granularity' datatype='string' name='[Calculation_5817595246522150914]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Daily&apos; THEN STR([iso_date])&#10;    WHEN &apos;Weekly&apos; THEN [week]&#10;    WHEN &apos;Monthly&apos; THEN [month]&#10;END' />
      </column>
      <column caption='% FCR' datatype='real' default-format='p0.0%' name='[Calculation_5817595246522478595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_fcr])&#10;/&#10;SUM([contacts])' />
      </column>
      <column caption='AHT (mins)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5817595246525394948]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([handling_time_secs]) / 60)&#10;/&#10;SUM([contacts])' />
      </column>
      <column caption='Avg. Duration Since Order (mins)' datatype='real' name='[Calculation_5817595246525837319]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([total_duration_since_order_secs]) / 60)&#10;/&#10;SUM([contacts])' />
      </column>
      <column caption='Metric Selection 1' datatype='integer' name='[Calculation_5817595246606299146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &apos;Orders&apos; THEN [orders]&#10;    WHEN &apos;Contacts&apos; THEN [contacts]&#10;END' />
