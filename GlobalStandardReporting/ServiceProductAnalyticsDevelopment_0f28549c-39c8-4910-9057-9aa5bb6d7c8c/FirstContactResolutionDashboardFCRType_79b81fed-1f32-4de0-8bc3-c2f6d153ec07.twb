    <worksheet lock-updates='true' name='FCR vs CSAT trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='12'>&lt;[Parameters].[Parameter 4]&gt; </run>
            <run fontname='Tableau Medium' fontsize='12'>vs </run>
            <run fontcolor='#ff9da7' fontname='Tableau Medium' fontsize='12'>Contacts per Order-Contact Reason </run>
            <run fontname='Tableau Medium' fontsize='12'>Trend </run>
            <run fontsize='10'>(hover-over for secondary metrics)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fcr_report' name='federated.0jmkiiy1b0xy4t1gapzyr1ynxntk' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='% FCR Type' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% FCR&quot;'>
              <calculation class='tableau' formula='&quot;% FCR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jmkiiy1b0xy4t1gapzyr1ynxntk'>
            <column caption='% Order Level FCR' datatype='real' default-format='p0.0%' name='[% FCR (copy)_6260777585673494528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_order_level_fcr])&#10;/&#10;SUM([orders])' />
            </column>
            <column caption='Contacts per Order-CCR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2061100576821096448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([contacts])&#10;/&#10;SUM([orders])' />
            </column>
            <column caption='Date' datatype='date' name='[Calculation_5817595246513180672]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[iso_date]' />
            </column>
            <column caption='CSAT Score' datatype='real' default-format='p0.0%' name='[Calculation_5817595246518210561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_csat_4_5])&#10;/&#10;SUM([csat_responses])' />
            </column>
            <column caption='Granularity' datatype='string' name='[Calculation_5817595246522150914]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Daily&apos; THEN STR([iso_date])&#10;    WHEN &apos;Weekly&apos; THEN [week]&#10;    WHEN &apos;Monthly&apos; THEN [month]&#10;END' />
            </column>
            <column caption='% FCR' datatype='real' default-format='p0.0%' name='[Calculation_5817595246522478595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_fcr])&#10;/&#10;SUM([contacts])' />
            </column>
            <column caption='% FCR Type' datatype='real' default-format='p0.0%' name='[Calculation_6260777585673801729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;  WHEN &apos;% Order Level FCR&apos;&#10;    THEN [% FCR (copy)_6260777585673494528]&#10;  ELSE [Calculation_5817595246522478595]&#10;END' />
            </column>
