      <aliases enabled='yes' />
      <column caption='Reorder_Cohort' datatype='string' name='[Calculation_4592334679912890370]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if&#10;[had_reorder_0_30d] = 1 then &quot;0-30D&quot;&#10;elseif [had_reorder_31_60d] = 1 then &quot;31-60D&quot;&#10;elseif [had_reorder_61_90d] = 1 then &quot;61-90D&quot;&#10;elseif [had_reorder_91_120d] = 1 then &quot;91-120D&quot;&#10;elseif [had_reorder_121_150d] = 1 then &quot;121-150D&quot;&#10;ELSEIF [had_reorder_151_180d] = 1 then &quot;151-180D&quot;&#10;ELSEIF [had_reorder_181_210d] = 1 then &quot;181-210D&quot;&#10;ELSEIF [had_reorder_211_240d] = 1 then &quot;211-240d&quot;&#10;ELSEIF [had_reorder_241_270d] = 1 then &quot;241-270d&quot;&#10;ELSEIF [had_reorder_241_270d] = 1 then &quot;241-270d&quot;&#10;ELSEIF [had_reorder_271_300d] = 1 then &quot;271-300d&quot;&#10;ELSEIF [had_reorder_301_330d] = 1 then &quot;301-330d&quot;&#10;ELSEIF [had_reorder_331_360d] = 1 then &quot;331-360d&quot;&#10;end' />
      </column>
      <column caption='Retained_customers' datatype='string' name='[Calculation_4592334679918641155]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [had_reorder_0_360d] = 1 then &quot;Returned&quot;&#10;else &quot;Churned&quot; end' />
      </column>
      <column caption='Region' datatype='string' name='[Calculation_4592334679921487876]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [global_entity_id] in (&apos;FP_RO&apos;) then &quot;Europe&quot;&#10;elseif [global_entity_id] in (&apos;IN_SA&apos;) then &quot;MENA&quot;&#10;elseif [global_entity_id] in (&apos;HG_SE&apos;) then &quot;Europe&quot;&#10;elseif [global_entity_id] in (&apos;FP_JP&apos;) then &quot;Asia&quot;&#10;else [region]&#10;end' />
      </column>
      <column caption='30D Retention (%)' datatype='real' name='[Calculation_4592334679953330181]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [had_reorder_0_30d] = 1 then [analytical_customer_id] end) / COUNTD([analytical_customer_id])' />
      </column>
      <column caption='Last' datatype='boolean' name='[Calculation_4592334679955075078]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST() &lt; 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
