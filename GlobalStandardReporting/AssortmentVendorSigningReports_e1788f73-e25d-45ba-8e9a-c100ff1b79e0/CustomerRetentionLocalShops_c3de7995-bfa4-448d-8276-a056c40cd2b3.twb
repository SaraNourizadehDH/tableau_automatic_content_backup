          <calculation class='tableau' formula='if [global_entity_id] in (&apos;FP_RO&apos;) then &quot;Europe&quot;&#10;elseif [global_entity_id] in (&apos;IN_SA&apos;) then &quot;MENA&quot;&#10;elseif [global_entity_id] in (&apos;HG_SE&apos;) then &quot;Europe&quot;&#10;elseif [global_entity_id] in (&apos;FP_JP&apos;) then &quot;Asia&quot;&#10;else [region]&#10;end' />
