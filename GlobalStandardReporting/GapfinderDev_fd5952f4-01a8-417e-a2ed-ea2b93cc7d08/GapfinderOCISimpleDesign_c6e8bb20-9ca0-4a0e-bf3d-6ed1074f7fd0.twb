            <column caption='Last Month Lead Count' datatype='integer' name='[Calculation_5722667815685902347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DATEDIFF (&apos;month&apos;,DATETRUNC(&apos;month&apos;, [period]), {MAX(DATETRUNC(&apos;month&apos;, [period]))})=0&#10;&#10;Then [count_leads]&#10;&#10;END' />
            </column>
            <column caption='Last - 1 Month Lead Count' datatype='integer' name='[Last Month Lead Count (copy)_5722667815686037516]' role='measure' type='quantitative'>
