      <aliases enabled='yes' />
      <column caption='city' datatype='string' name='[Calculation_132082138506801158]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[city_name]' />
      </column>
      <column caption='Zombies' datatype='integer' name='[Calculation_252975651246878723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [zombie_flag] then [vendor_ids_qty] END' />
      </column>
      <column caption='Active %' datatype='real' name='[Calculation_252975651248812037]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Zombies (copy)_5872201374850379778])/SUM([vendor_ids_qty]))' />
      </column>
      <column caption='Gmv per restaurant' datatype='real' name='[Calculation_252975651249438727]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv])/SUM([vendor_ids_qty])' />
      </column>
      <column caption='Vendor Type' datatype='string' name='[Calculation_3443705613758586881]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_competitor] THEN &apos;Shared Vendor&apos; ELSE &apos;DH Only Vendor&apos; END' />
      </column>
      <column caption='k' datatype='integer' name='[Calculation_3790130950654181378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='DH &amp; Shared Vendors Breakdown' datatype='string' name='[Calculation_5722667814755725314]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
      </column>
      <column caption='Orders Bucket for Active' datatype='string' name='[Calculation_5872201374849486849]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [orders] &gt;= 1 AND [orders] &lt; 30 THEN &apos;1-30 orders&apos; &#10;ELSEIF  [orders] &gt;= 30 THEN &apos;30+ orders&apos; ELSE &apos;0 orders&apos; END' />
      </column>
      <column caption='Sub Entity' datatype='string' name='[Display Name (copy)_132082136335396869]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[display_name]' />
      </column>
      <column caption='Orders per Resto' datatype='real' name='[Orders per Resto previous month (copy)_1514194672199864320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])/SUM([vendor_ids_qty])' />
      </column>
      <column caption='Active' datatype='integer' name='[Zombies (copy)_5872201374850379778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [zombie_flag] = FALSE then [vendor_ids_qty] END' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='gf_inventory_inverse_gap' datatype='table' name='[__tableau_internal_object_id__].[gf_inventory_inverse_gap_89EF45ABC9A24B1F8D83FDB8D54D3661]' role='measure' type='quantitative' />
