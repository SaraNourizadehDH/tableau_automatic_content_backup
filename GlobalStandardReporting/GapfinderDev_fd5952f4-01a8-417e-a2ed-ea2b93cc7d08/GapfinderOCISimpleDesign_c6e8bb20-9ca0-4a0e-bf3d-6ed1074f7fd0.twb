jeeran&apos; and [sub_entity] = &apos;TB - Jordan&apos;)&#10;    //or (([Competitor] = &apos;daleel&apos; or [Competitor] = &apos;akeed&apos;) and [Sub entity] = &apos;TB - Oman&apos;)&#10;    or ([lead_source] = &apos;zomato&apos; and [region] = &apos;MENA&apos;)&#10;    //or [Entity] = &apos;DH Greece&apos;&#10;    //or [Sub entity] = &apos;HS - Bahrain&apos;&#10;&#10;then &apos;no&apos;&#10;else &apos;yes&apos;&#10;end' />
