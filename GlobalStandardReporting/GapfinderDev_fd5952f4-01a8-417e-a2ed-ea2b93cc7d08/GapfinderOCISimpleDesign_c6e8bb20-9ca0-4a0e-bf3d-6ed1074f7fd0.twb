            <column caption='Percent Change Leads Count' datatype='real' name='[Calculation_5722667815684055049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_5722667815685902347]) - SUM([Last Month Lead Count (copy)_5722667815686037516]))/SUM([Last Month Lead Count (copy)_5722667815686037516])' />
