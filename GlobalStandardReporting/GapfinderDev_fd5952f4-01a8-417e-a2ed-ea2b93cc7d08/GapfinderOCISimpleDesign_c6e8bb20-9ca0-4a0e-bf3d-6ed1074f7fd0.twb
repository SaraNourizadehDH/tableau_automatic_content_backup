  <worksheets>
    <worksheet name='Competitor Gap Classified Monthly Evolution'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#333333'>Addressable Gap Evolution</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='INVENTORY: Gap Deep Dive' name='federated.012rs1e0350a1519h5x0i0bgea1b' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Target achievement date level' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.012rs1e0350a1519h5x0i0bgea1b'>
            <column caption='Non Addresable Gap' datatype='integer' name='[Addresable Gap (copy)_6944972874983821314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [gap_type] = &apos;non addressable&apos; THEN [competitor_leads] END' />
            </column>
            <column caption='REPORT DATE CLEANED' datatype='date' name='[Calculation_1584844890250047488]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [report_date] = DATE(&apos;2023-05-28&apos;) THEN DATE(&apos;2022-01-01&apos;) ELSE [report_date] END' />
            </column>
            <column caption='Top 3 months' datatype='boolean' name='[Calculation_2592173444221517824]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST() &lt; 3'>
                <table-calc level-address='[federated.012rs1e0350a1519h5x0i0bgea1b].[mn:report_date:ok]' ordering-field='[federated.012rs1e0350a1519h5x0i0bgea1b].[report_date]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='K' datatype='integer' name='[Calculation_3167860150811881476]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Addressabel Gap' datatype='integer' name='[Calculation_3167860150812884997]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [gap_type] = &apos;addressable&apos; then [competitor_leads]  END' />
