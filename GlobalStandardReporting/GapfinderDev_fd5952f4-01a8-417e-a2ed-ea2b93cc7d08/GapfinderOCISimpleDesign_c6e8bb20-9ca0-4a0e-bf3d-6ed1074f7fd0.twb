      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.012rs1e0350a1519h5x0i0bgea1b].[sum:Addresable Gap (copy)_6944972874983821314:qk]&quot;' value='Non Addresable' />
          <alias key='&quot;[federated.012rs1e0350a1519h5x0i0bgea1b].[sum:Calculation_3167860150812884997:qk]&quot;' value='Addressable' />
        </aliases>
      </column>
      <column caption='Non Addresable Gap' datatype='integer' name='[Addresable Gap (copy)_6944972874983821314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [gap_type] = &apos;non addressable&apos; THEN [competitor_leads] END' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Calculation_3167860150812884997])) - LOOKUP(ZN(SUM([Calculation_3167860150812884997])), -1)) / ABS(LOOKUP(ZN(SUM([Calculation_3167860150812884997])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='keep last rundate for week' datatype='boolean' name='[Calculation_1045749946900492288]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], DATETRUNC(&apos;week&apos;,[report_date],&apos;monday&apos;):MAX([report_date])}=[report_date]' />
      </column>
      <column caption='Week started' datatype='datetime' name='[Calculation_1045749946903318530]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;,[report_date],&apos;monday&apos;)' />
      </column>
      <column caption='last run' datatype='boolean' name='[Calculation_1045749946910003203]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED :MAX([report_date])}=[report_date]' />
      </column>
      <column caption='REPORT DATE CLEANED' datatype='date' name='[Calculation_1584844890250047488]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [report_date] = DATE(&apos;2023-05-28&apos;) THEN DATE(&apos;2022-01-01&apos;) ELSE [report_date] END' />
      </column>
      <column caption='Top 3 months' datatype='boolean' name='[Calculation_2592173444221517824]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST() &lt; 3'>
          <table-calc level-address='[federated.012rs1e0350a1519h5x0i0bgea1b].[mn:report_date:ok]' ordering-field='[federated.012rs1e0350a1519h5x0i0bgea1b].[report_date]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='K' datatype='integer' name='[Calculation_3167860150811881476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Addressabel Gap' datatype='integer' name='[Calculation_3167860150812884997]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [gap_type] = &apos;addressable&apos; then [competitor_leads]  END' />
      </column>
      <column caption='Keep monthly view' datatype='boolean' name='[Calculation_5253941596497436672]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 7]=&apos;month&apos;' />
      </column>
      <column caption='keep weekly view' datatype='boolean' name='[Calculation_5253941596497633281]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 7]=&apos;week&apos;' />
      </column>
      <column caption='Vendor Grade' datatype='string' name='[Calculation_5928637130109931520]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([vendor_grade] = &apos;AAA&apos; OR [vendor_grade] = &apos;AA&apos; OR [vendor_grade] = &apos;A+&apos;) THEN &apos;A&apos;&#10;ELSEIF ISNULL([vendor_grade]) THEN &apos;Ungraded&apos;&#10;ELSE [vendor_grade] END' />
