    <worksheet name='DH Vendor DEL MP - MOM Latest'>
      <table>
        <view>
          <datasources>
            <datasource caption='INVENTORY.DH_PLUS_SHARED' name='federated.0jfkl4w16c9m3k100n3aq1m5axmx' />
            <datasource caption='INVENTORY.GAP' name='federated.1jqzaz71x52o7m0zxktv81j19g9e' />
          </datasources>
          <datasource-dependencies datasource='federated.0jfkl4w16c9m3k100n3aq1m5axmx'>
            <column caption='DH vendors Latest Compared to Previous' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([DH_vendors])) - LOOKUP(ZN(SUM([DH_vendors])), -1)) / ABS(LOOKUP(ZN(SUM([DH_vendors])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Last' datatype='boolean' name='[Calculation_2581899643802955776]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST()=0'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MIN(0.0)' datatype='real' name='[Calculation_2581899643803729922]' role='measure' type='quantitative' user:unnamed='DH Vendor Universe - Month Latest'>
              <calculation class='tableau' formula='MIN(0.0)' />
            </column>
            <column caption='[DH vendors Latest Compared to Previous]&gt;=0' datatype='boolean' name='[Calculation_2581899643804000260]' role='measure' type='nominal' user:unnamed='DH Vendor Universe - Month Latest'>
              <calculation class='tableau' formula='[Calculation1]&gt;=0'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='[DH vendors Latest Compared to Previous] &gt; 0' datatype='boolean' name='[Calculation_2581899644557553692]' role='measure' type='nominal' user:unnamed='DH Vendor Universe - MOM Latest'>
              <calculation class='tableau' formula='[Calculation1] &gt; 0'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='DH vendors' datatype='integer' name='[DH_vendors]' role='measure' type='quantitative' />
            <column datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Match Event Date' datatype='date' name='[match_event_date]' role='dimension' type='ordinal' />
            <column-instance column='[delivery_type]' derivation='None' name='[none:delivery_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[match_event_date]' derivation='None' name='[none:match_event_date:ok]' pivot='key' type='ordinal' />
