      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.01hhapm0psj6hn1eirfay0gf0tk8].[usr:Calculation_2347993908506955782:qk]&quot;' value='Vendors Acquired From The Gap' />
        </aliases>
      </column>
      <column caption='Acquisitions Below Commision Floor' datatype='integer' name='[Acquisitions (copy)_2347993908508196872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF NOT [below_commision_floor_flag] THEN [grid] END)' />
      </column>
      <column caption='Acquisitions High Value Vendors' datatype='integer' name='[Acquisitions Below Commision Floor (copy)_2347993908537675788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [high_value_flag] THEN [grid] END)' />
      </column>
      <column caption='Acquisitions New Vendors %' datatype='real' default-format='p0.0%' name='[Acquisitions High Value Vendors % (copy)_2347993908550533138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Acquisitions High Value Vendors (copy)_2347993908543545357]&#10;/[Calculation_2347993908506955782]' />
      </column>
      <column caption='Acquisitions New Vendors' datatype='integer' name='[Acquisitions High Value Vendors (copy)_2347993908543545357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF NOT [key_vip_account__c] THEN [grid] END)' />
      </column>
      <column caption='Acquisitions Outlet Expansions' datatype='integer' name='[Acquisitions New Vendors (copy)_2347993908552761363]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [key_vip_account__c] THEN [grid] END)' />
      </column>
      <column caption='Central role' datatype='string' name='[Calculation_1694057174896635904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([central_job_role__c],&apos;Field Sales&apos;) THEN &apos;Field Sales&apos;&#10;ELSEIF CONTAINS([central_job_role__c],&apos;Tele Sales&apos;) THEN &apos;Tele Sales&apos;&#10;ELSE &apos;Other&apos;&#10;end' />
      </column>
      <column caption='TIM_DAY' datatype='date' datatype-customized='true' name='[Calculation_2347993908496166917]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[op_closedate]))' />
      </column>
      <column caption='Acquisitions' datatype='integer' name='[Calculation_2347993908506955782]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([grid])' />
      </column>
      <column caption='Commision AVG' datatype='real' default-format='p0.0%' name='[Calculation_2347993908507553799]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([commission])&#10;/COUNT([commission])' />
      </column>
      <column caption='Show Commission' datatype='boolean' name='[Calculation_2347993908513349642]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 11] == &apos;COMMISSION&apos;' />
      </column>
      <column caption='Acquisitions High Value Vendors %' datatype='real' default-format='p0.0%' name='[Calculation_2347993908550365201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Acquisitions Below Commision Floor (copy)_2347993908537675788]&#10;/[Calculation_2347993908506955782]' />
      </column>
      <column caption='Show HIGH VALUE VENDORS' datatype='boolean' name='[Show Commission (copy)_2347993908537225227]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 11] == &apos;HIGH VALUE VENDORS&apos;' />
      </column>
      <column caption='Show VENDOR REVIEWS' datatype='boolean' name='[Show HIGH VALUE VENDORS (copy)_2347993908546449422]' role='dimension' type='nominal'>
