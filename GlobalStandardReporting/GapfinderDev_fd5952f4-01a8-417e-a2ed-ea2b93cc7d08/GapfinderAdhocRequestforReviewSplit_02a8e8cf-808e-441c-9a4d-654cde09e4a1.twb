      <column caption='TIM_DAY' datatype='date' datatype-customized='true' name='[Calculation_2347993908446691329]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[iso_date]))' />
