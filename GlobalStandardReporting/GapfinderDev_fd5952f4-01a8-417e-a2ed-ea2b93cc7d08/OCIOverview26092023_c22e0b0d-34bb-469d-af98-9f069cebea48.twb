      <table>
        <view>
          <datasources>
            <datasource caption='INVENTORY : Summary' name='federated.01jbtei00d5spw1bpmw1x0g5y7bk' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KeyMetric: Date Param' datatype='date' default-format='*MMM YY' name='[Parameter 1 1]' param-domain-type='list' role='measure' type='quantitative' value='#2023-09-01#'>
              <calculation class='tableau' formula='#2023-09-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.01jbtei00d5spw1bpmw1x0g5y7bk'>
            <column caption='@Current Total DH Only' datatype='integer' name='[@Current Total DH (copy)_706079979999424548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_130322975906648065] = &apos;DH ONLY VENDORS&apos; AND [period]= [Parameters].[Parameter 1 1] THEN [count_leads] END)' />
            </column>
            <column caption='@Previous Total DH Only' datatype='integer' name='[@Previous Total DH (copy)_706079979999440933]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_130322975906648065] = &apos;DH ONLY VENDORS&apos; AND [period] = [Current Period Selected (copy)_5000473398202585089] THEN [count_leads] END)' />
            </column>
            <column caption='@Shape DH only PoP' datatype='string' name='[@Shape Total DH PoP (copy)_2687382344830599169]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [@Total DH PoP (copy)_706079980000141350] &gt; 0 THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='@Total DH Only PoP' datatype='real' name='[@Total DH PoP (copy)_706079980000141350]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([@Current Total DH (copy)_706079979999424548]-[@Previous Total DH (copy)_706079979999440933])/[@Previous Total DH (copy)_706079979999440933]' />
            </column>
            <column caption='Overall Distribution Category Split' datatype='string' name='[Calculation_130322975906648065]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [gap] = FALSE AND ([is_competitor]=FALSE OR ISNULL([is_competitor])) THEN &apos;DH ONLY VENDORS&apos;&#10;ELSEIF [gap] = FALSE AND ([is_competitor]=TRUE) THEN &apos;SHARED VENDORS&apos;&#10;ELSEIF [gap] = TRUE AND ([is_competitor]=TRUE) THEN &apos;COMPETITOR GAP&apos; END' />
            </column>
            <column caption='MIN(0)' datatype='integer' name='[Calculation_1987283772513955863]' role='measure' type='quantitative' user:unnamed='Overview: Key Metric Gap'>
              <calculation class='tableau' formula='MIN(0)' />
