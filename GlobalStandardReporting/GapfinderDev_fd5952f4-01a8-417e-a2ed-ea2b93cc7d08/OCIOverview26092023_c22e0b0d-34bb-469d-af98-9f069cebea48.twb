    <worksheet name='Overview: Key Metric DH'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tableau Medium' fontsize='8'>TOTAL DH VENDORS</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='INVENTORY : Summary' name='federated.01jbtei00d5spw1bpmw1x0g5y7bk' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KeyMetric: Date Param' datatype='date' default-format='*MMM YY' name='[Parameter 1 1]' param-domain-type='list' role='measure' type='quantitative' value='#2023-09-01#'>
              <calculation class='tableau' formula='#2023-09-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.01jbtei00d5spw1bpmw1x0g5y7bk'>
            <column caption='@Current Total DH' datatype='integer' name='[@Current Total Gap (copy)_5000473398222999561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_130322975906648065] &lt;&gt; &apos;COMPETITOR GAP&apos; AND [period]= [Parameters].[Parameter 1 1] THEN [count_leads] END)' />
            </column>
            <column caption='@Previous Total DH' datatype='integer' name='[@Previous Total Gap (copy)_5000473398223523850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_130322975906648065] &lt;&gt; &apos;COMPETITOR GAP&apos; AND [period] = [Current Period Selected (copy)_5000473398202585089] THEN [count_leads] END)' />
            </column>
            <column caption='@Shape Total DH PoP' datatype='string' name='[@Shape Total Gap PoP (copy)_1943162504575500296]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [@Total Gap PoP (copy)_5000473398223732747] &gt; 0 THEN &apos;▲&apos; ELSE &apos;▼&apos; END' />
            </column>
            <column caption='@Total DH PoP' datatype='real' name='[@Total Gap PoP (copy)_5000473398223732747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([@Current Total Gap (copy)_5000473398222999561]-[@Previous Total Gap (copy)_5000473398223523850])/[@Previous Total Gap (copy)_5000473398223523850]' />
            </column>
            <column caption='Overall Distribution Category Split' datatype='string' name='[Calculation_130322975906648065]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [gap] = FALSE AND ([is_competitor]=FALSE OR ISNULL([is_competitor])) THEN &apos;DH ONLY VENDORS&apos;&#10;ELSEIF [gap] = FALSE AND ([is_competitor]=TRUE) THEN &apos;SHARED VENDORS&apos;&#10;ELSEIF [gap] = TRUE AND ([is_competitor]=TRUE) THEN &apos;COMPETITOR GAP&apos; END' />
            </column>
            <column caption='MIN(0)' datatype='integer' name='[Calculation_1987283772513955863]' role='measure' type='quantitative' user:unnamed='Overview: Key Metric Gap'>
              <calculation class='tableau' formula='MIN(0)' />
            </column>
            <column caption='MIN(0)' datatype='integer' name='[Calculation_1987283772514000923]' role='measure' type='quantitative' user:unnamed='Overview: Key Metric Gap'>
              <calculation class='tableau' formula='MIN(0)' />
            </column>
            <column caption='[@Total DH PoP] &gt; 0' datatype='boolean' name='[Calculation_2528067507991965696]' role='measure' type='nominal' user:unnamed='Overview: Key Metric DH'>
              <calculation class='tableau' formula='[@Total Gap PoP (copy)_5000473398223732747] &gt; 0' />
            </column>
            <column caption='MIN(0.85)' datatype='real' name='[Calculation_4044654681283137549]' role='measure' type='quantitative' user:unnamed='Overview: Key Metric DH'>
              <calculation class='tableau' formula='MIN(0.85)' />
            </column>
            <column caption='Current Period Selected' datatype='date' name='[Calculation_5000473398202454016]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1 1]' />
            </column>
            <column caption='Previous Period Selected' datatype='date' datatype-customized='true' name='[Current Period Selected (copy)_5000473398202585089]' role='dimension' type='ordinal'>
