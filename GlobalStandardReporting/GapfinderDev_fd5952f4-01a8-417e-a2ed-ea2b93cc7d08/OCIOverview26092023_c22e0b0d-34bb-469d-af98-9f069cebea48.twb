      <column caption='Percent Change Leads Count' datatype='real' name='[Calculation_5722667815684055049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_5722667815685902347]) - SUM([Last Month Lead Count (copy)_5722667815686037516]))/SUM([Last Month Lead Count (copy)_5722667815686037516])' />
      </column>
      <column caption='Last Month Lead Count' datatype='integer' name='[Calculation_5722667815685902347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEDIFF (&apos;month&apos;,DATETRUNC(&apos;month&apos;, [period]), {MAX(DATETRUNC(&apos;month&apos;, [period]))})=0&#10;&#10;Then [count_leads]&#10;&#10;END' />
      </column>
      <column caption='Period Maxima' datatype='date' name='[Calculation_6293991650025639943]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([period]) }' />
      </column>
      <column caption='Previous Period Selected' datatype='date' datatype-customized='true' name='[Current Period Selected (copy)_5000473398202585089]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1 1]))' />
      </column>
      <column caption='Last Month Addressable Lead Count ' datatype='integer' name='[Last Month Lead Count (copy)_1987283771334189068]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEDIFF (&apos;month&apos;,DATETRUNC(&apos;month&apos;, [period]), {MAX(DATETRUNC(&apos;month&apos;, [period]))})=0 AND [gap_type]= &apos;addressable&apos;&#10;&#10;Then [count_leads]&#10;&#10;END' />
      </column>
      <column caption='Last - 1 Month Lead Count' datatype='integer' name='[Last Month Lead Count (copy)_5722667815686037516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEDIFF (&apos;month&apos;,DATETRUNC(&apos;month&apos;, [period]), {MAX(DATETRUNC(&apos;month&apos;, [period]))})=1&#10;&#10;Then [count_leads]&#10;&#10;END' />
      </column>
      <column caption='Position 2' datatype='real' name='[Position 1 (copy)_1987283771333619723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(-5)' />
      </column>
