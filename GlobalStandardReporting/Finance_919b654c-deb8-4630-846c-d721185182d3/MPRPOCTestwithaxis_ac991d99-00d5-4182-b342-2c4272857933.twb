            <column aggregation='CountD' caption='1.1 Actual -1' datatype='string' name='[Calculation_1385138363645460494]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;ACTUAL&#13;&#10; (M-1): &#13;&#10;&quot;+&#13;&#10;str(DATEPART(&quot;month&quot;, [Calculation_435723265374801929]))+&#13;&#10;&quot;.&quot;+ &#13;&#10;str(DATEPART(&quot;year&quot;, [Calculation_435723265374801929]))' />
            </column>
            <column caption='TGT Scenario' datatype='string' name='[Calculation_1949214220066537473]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;LEFT([Scenario], 2) = &quot;BU&quot; &#13;&#10;AND NOT CONTAINS([Scenario], &quot;_APY&quot;)&#13;&#10;AND CONTAINS([Scenario],&apos;2024&apos;)&#13;&#10;THEN [Scenario] &#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='BEString' datatype='string' name='[Calculation_435723265373413384]' role='dimension' type='nominal'>
