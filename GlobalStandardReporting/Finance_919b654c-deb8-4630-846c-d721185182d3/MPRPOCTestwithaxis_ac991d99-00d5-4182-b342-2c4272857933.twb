            <column aggregation='CountD' caption='1.7 TGT Delta' datatype='string' name='[1.6 TGT (copy)_1385138363650871320]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Δ vs &#13;&#10;&quot; + [Parameters].[Parameter 6]' />
            </column>
            <column aggregation='CountD' caption='1.8 TGT %' datatype='string' name='[1.7 TGT Delta (copy)_1385138363651006489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;% vs&#13;&#10;&quot;+ [Parameters].[Parameter 6]' />
            </column>
            <column caption='BE Scenario' datatype='string' name='[Actuals Dates (copy)_956733447996776451]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;LEFT([Scenario], 2) = &quot;BE&quot; AND NOT CONTAINS([Scenario], &quot;_APY&quot;)&#13;&#10;THEN [Scenario] &#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
            <column aggregation='CountD' caption='1.1 Actual -1' datatype='string' name='[Calculation_1385138363645460494]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;ACTUAL&#13;&#10; (M-1): &#13;&#10;&quot;+&#13;&#10;str(DATEPART(&quot;month&quot;, [Calculation_435723265374801929]))+&#13;&#10;&quot;.&quot;+ &#13;&#10;str(DATEPART(&quot;year&quot;, [Calculation_435723265374801929]))' />
            </column>
            <column caption='TGT Scenario' datatype='string' name='[Calculation_1949214220066537473]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;LEFT([Scenario], 2) = &quot;BU&quot; &#13;&#10;AND NOT CONTAINS([Scenario], &quot;_APY&quot;)&#13;&#10;AND CONTAINS([Scenario],&apos;2024&apos;)&#13;&#10;THEN [Scenario] &#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='BEString' datatype='string' name='[Calculation_435723265373413384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF LEN(STR(MONTH([Calculation_435723265374801929]))) = 1 THEN&#13;&#10;    &quot;BE0&quot; + STR(MONTH([Calculation_435723265374801929]))&#13;&#10;ELSE&#13;&#10;    &quot;BE&quot; +STR(MONTH([Calculation_435723265374801929]))&#13;&#10;END' />
            </column>
            <column caption='Selected Month -1' datatype='datetime' name='[Calculation_435723265374801929]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1])' />
