                <alias key='&quot;ver&quot;' value='Vertical' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0dqejtw0n5678g1alqegp0i6gh6y].[Actuals Dates (copy)_956733447996776451]' caption='Select BE' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;BE08&quot;'>
              <calculation class='tableau' formula='&quot;BE08&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0dqejtw0n5678g1alqegp0i6gh6y].[Actuals Dates (copy)_956733447996776451]' caption='Previous BE' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;BE07&quot;'>
              <calculation class='tableau' formula='&quot;BE07&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0dqejtw0n5678g1alqegp0i6gh6y].[Calculation_1949214220066537473]' caption='Target Szenario' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;BUDGET2024&quot;'>
              <calculation class='tableau' formula='&quot;BUDGET2024&quot;' />
            </column>
            <column alias='YoY HI &amp; w/O HI' caption='View Change' datatype='string' name='[Parameter 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;YOY&quot;'>
              <calculation class='tableau' formula='&quot;YOY&quot;' />
              <aliases>
                <alias key='&quot;FY&quot;' value='FY BE &amp;  FY TGT Comparison' />
                <alias key='&quot;MON&quot;' value='Actual vs Best Estimate' />
                <alias key='&quot;YOY&quot;' value='YoY HI &amp; w/O HI' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dqejtw0n5678g1alqegp0i6gh6y'>
            <column caption='TGT' datatype='real' name='[Actual (copy)_1441433358143574017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [f_month_date] = [Parameters].[Parameter 1] &#13;&#10;AND [Scenario] =  [Parameters].[Parameter 6] &#13;&#10;AND [Flow] = &quot;Fnone&quot;&#13;&#10;AND [UD2_Main_MGMA_TOT] = &quot;MGMA_TOT&quot;&#13;&#10;THEN [Amount]&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='FY-YEAR' datatype='real' name='[Actual (copy)_551690956124565504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Scenario] = [Calculation_956733448023736331] &#13;&#10;AND [Flow] = &quot;Fnone&quot;&#13;&#10;AND [F Month Date (Years)] = [Calculation_1159958382538104844]&#13;&#10;AND [UD2_Main_MGMA_TOT] = &quot;MGMA_TOT&quot;&#13;&#10;then [Amount]&#13;&#10;Else NULL&#13;&#10;END' />
            </column>
            <column caption='BE Scenario' datatype='string' name='[Actuals Dates (copy)_956733447996776451]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;LEFT([Scenario], 2) = &quot;BE&quot; AND NOT CONTAINS([Scenario], &quot;_APY&quot;)&#13;&#10;THEN [Scenario] &#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='real' name='[Amount]' role='measure' type='quantitative' />
            <column caption='BE Scenario CC' datatype='string' name='[BE Scenario (copy)_1159958382534995977]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3] + &quot;_APY&quot;' />
            </column>
            <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
            <column caption='Select Month -Year' datatype='date' name='[Calculation_1159958382538104844]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;year&apos;, [Parameters].[Parameter 1]))' />
            </column>
            <column caption='YoY RC %' datatype='real' name='[Calculation_1159958382544773137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([FY-YEAR (copy)_1159958382540791822]) / SUM([FY-YEAR YOY (copy)_1159958382541258767]) -1' />
            </column>
            <column caption='FY-YEAR CC YOY' datatype='real' name='[Calculation_1159958382546329619]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Scenario] = [BE Scenario (copy)_1159958382534995977]&#13;&#10;AND [Flow] = &quot;Fnone&quot;&#13;&#10;AND [F Month Date (Years)] = [Calculation_1159958382538104844]&#13;&#10;AND [UD2_Main_MGMA_TOT] = &quot;MGMA_TOT&quot;&#13;&#10;then [Amount]&#13;&#10;Else NULL&#13;&#10;END' />
            </column>
            <column caption='FY-1 w/o HI' datatype='real' name='[Calculation_1159958382552506391]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Scenario] = &quot;ACTUAL&quot;&#13;&#10;AND [F Month Date (Years)] = [Select Month -Year (copy)_1159958382542090256]&#13;&#10;AND [Flow] IN (&quot;Fnone&quot;,&quot;FHCLAV&quot;) &#13;&#10;AND [UD2_Main_MGMA_CPI_LOC] = &quot;MGMA_CPI_LOC&quot;&#13;&#10;THEN&#13;&#10;[Amount]&#13;&#10;END' />
            </column>
            <column caption='TGT Scenario' datatype='string' name='[Calculation_1949214220066537473]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;LEFT([Scenario], 2) = &quot;BU&quot; &#13;&#10;AND NOT CONTAINS([Scenario], &quot;_APY&quot;)&#13;&#10;AND CONTAINS([Scenario],&apos;2024&apos;)&#13;&#10;THEN [Scenario] &#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='L1' datatype='string' name='[Calculation_435723265369501700]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;reg&apos; THEN [Region]&#13;&#10;WHEN &apos;bra&apos; THEN [Brand]&#13;&#10;WHEN &apos;ent&apos; THEN [Entity]&#13;&#10;WHEN &apos;con&apos; THEN [CountryName]&#13;&#10;WHEN &apos;ver&apos; THEN [Vertical]&#13;&#10;WHEN &apos;gei&apos; THEN [global_entity_id]&#13;&#10;WHEN &apos;nbr&apos; THEN &apos;&apos;&#13;&#10;END' />
