              <calculation class='tableau' formula='#2024-01-01#' />
            </column>
            <column alias='No Breakdown' caption='L1' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;nbr&quot;'>
              <calculation class='tableau' formula='&quot;nbr&quot;' />
