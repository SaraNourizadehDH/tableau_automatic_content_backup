              <calculation class='tableau' formula='IF  [Scenario] = [Calculation_956733448023736331] &#13;&#10;AND [Flow] = &quot;Fnone&quot;&#13;&#10;AND [F Month Date (Years)] = [Calculation_1159958382538104844]&#13;&#10;AND [UD2_Main_MGMA_TOT] = &quot;MGMA_TOT&quot;&#13;&#10;then [Amount]&#13;&#10;Else NULL&#13;&#10;END' />
