              <calculation class='tableau' formula='&quot;BUDGET2024&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dqejtw0n5678g1alqegp0i6gh6y'>
            <column aggregation='CountD' caption='1.2 Actual' datatype='string' name='[1.1 (copy)_1385138363647311888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;ACTUAL: &#13;&#10;&quot;+&#13;&#10;str(DATEPART(&quot;month&quot;, [Parameters].[Parameter 1]))+&#13;&#10;&quot;.&quot;+ &#13;&#10;str(DATEPART(&quot;year&quot;, [Parameters].[Parameter 1]))' />
            </column>
            <column aggregation='CountD' caption='1.3 BEXX' datatype='string' name='[1.2 Actual (copy)_1385138363649740818]' role='dimension' type='nominal'>
