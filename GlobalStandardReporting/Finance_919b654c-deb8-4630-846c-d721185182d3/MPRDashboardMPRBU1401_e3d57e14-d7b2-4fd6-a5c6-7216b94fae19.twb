          <datasource-dependencies datasource='federated.0dqejtw0n5678g1alqegp0i6gh6y'>
            <column aggregation='CountD' caption='1.0 Actual PY' datatype='string' name='[1.1 Actual -1 (copy)_992762250073612291]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;ACT&#13;&#10; PY &#13;&#10;&quot;+&#13;&#10;IF LEN(STR(MONTH([Selected Month -1 (copy)_992762250077605893]))) = 1 THEN&#13;&#10;    &quot;0&quot; + STR(MONTH([Selected Month -1 (copy)_992762250077605893]))&#13;&#10;ELSE&#13;&#10;    STR(MONTH([Selected Month -1 (copy)_992762250077605893]))&#13;&#10;END +&#13;&#10;&quot;.&quot;+ &#13;&#10;str(DATEPART(&quot;year&quot;, [Selected Month -1 (copy)_992762250077605893]))' />
            </column>
            <column caption='TGT' datatype='real' name='[Actual (copy)_1441433358143574017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [f_month_date] = [Parameters].[Parameter 1] &#13;&#10;AND [Scenario] =  [Parameters].[Parameter 6] &#13;&#10;AND [Flow] = &quot;Fnone&quot;&#13;&#10;AND [UD2_Main_MGMA_TOT] = &quot;MGMA_TOT&quot;&#13;&#10;THEN [Amount]&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Actual -1py' datatype='real' name='[Actual -1 (copy)_992762250066935808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Selected Month -1 (copy)_992762250077605893] = [f_month_date] &#13;&#10;AND [Scenario] = &quot;ACTUAL&quot;&#13;&#10;AND [Flow] = &quot;Fnone&quot;&#13;&#10;AND [UD2_Main_MGMA_TOT] = &quot;MGMA_TOT&quot;&#13;&#10;THEN [Amount]&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column aggregation='CountD' caption='BE Scenario' datatype='string' name='[Actuals Dates (copy)_956733447996776451]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;LEFT([Scenario], 2) = &quot;BE&quot; AND NOT CONTAINS([Scenario], &quot;_APY&quot;)&#13;&#10;THEN [Scenario] &#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='real' name='[Amount]' role='measure' type='quantitative' />
            <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
            <column caption='TGT Scenario' datatype='string' name='[Calculation_1949214220066537473]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;LEFT([Scenario], 2) = &quot;BU&quot; &#13;&#10;AND NOT CONTAINS([Scenario], &quot;_APY&quot;)&#13;&#10;AND CONTAINS([Scenario],&quot;24&quot;)&#13;&#10;THEN [Scenario] &#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='L1' datatype='string' name='[Calculation_2090514659427086340]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[L1 (copy)_435723265665511440] = &apos;nbr&apos;&#13;&#10;THEN [L1 (copy)_2090514659426881539]&#13;&#10;ELSE [Calculation_435723265369501700]&#13;&#10;&#13;&#10;END' />
