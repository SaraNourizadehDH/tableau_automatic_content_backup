          <datasource-dependencies datasource='federated.0dqejtw0n5678g1alqegp0i6gh6y'>
            <column aggregation='CountD' caption='BE Scenario' datatype='string' name='[Actuals Dates (copy)_956733447996776451]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;LEFT([Scenario], 2) = &quot;BE&quot; AND NOT CONTAINS([Scenario], &quot;_APY&quot;)&#13;&#10;THEN [Scenario] &#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='real' name='[Amount]' role='measure' type='quantitative' />
            <column caption='BE Scenario CC' datatype='string' name='[BE Scenario (copy)_1159958382534995977]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3] + &quot;_APY&quot;' />
            </column>
            <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
            <column caption='Select Month - Curr.Year' datatype='date' name='[Calculation_1159958382538104844]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;year&apos;, [Parameters].[Parameter 1]))' />
            </column>
            <column caption='YoY RC %' datatype='real' name='[Calculation_1159958382544773137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if abs(sum([FY-YEAR YOY (copy)_1159958382541258767])) &gt; 100 then&#13;&#10;&#13;&#10;    IF SUM([FY-YEAR YOY (copy)_1159958382541258767]) &lt; 0&#13;&#10;    THEN -(SUM([FY-YEAR (copy)_1159958382540791822] ) / SUM([FY-YEAR YOY (copy)_1159958382541258767])-1)&#13;&#10;    ELSE SUM([FY-YEAR (copy)_1159958382540791822] ) / SUM([FY-YEAR YOY (copy)_1159958382541258767])-1&#13;&#10;    END&#13;&#10;&#13;&#10;ELSE 0 &#13;&#10;END' />
            </column>
            <column caption='FY-YEAR CC YOY' datatype='real' name='[Calculation_1159958382546329619]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Scenario] = [BE Scenario (copy)_1159958382534995977]&#13;&#10;AND [Flow] = &quot;Fnone&quot;&#13;&#10;AND [F Month Date (Years)] = [Calculation_1159958382538104844]&#13;&#10;AND [UD2_Main_MGMA_TOT] = &quot;MGMA_TOT&quot;&#13;&#10;then [Amount]&#13;&#10;Else NULL&#13;&#10;END' />
            </column>
            <column caption='FY-1 w/o HI' datatype='real' name='[Calculation_1159958382552506391]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Scenario] = &quot;ACTUAL&quot;&#13;&#10;AND [F Month Date (Years)] = [Select Month -Year (copy)_1159958382542090256]&#13;&#10;AND [Flow] IN (&quot;Fnone&quot;,&quot;FHCLAV&quot;) &#13;&#10;AND [UD2_Main_MGMA_CPI_LOC] = &quot;MGMA_CPI_LOC&quot;&#13;&#10;THEN&#13;&#10;[Amount]&#13;&#10;END' />
            </column>
            <column caption='L1' datatype='string' name='[Calculation_2090514659427086340]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[L1 (copy)_435723265665511440] = &apos;nbr&apos;&#13;&#10;THEN [L1 (copy)_2090514659426881539]&#13;&#10;ELSE [Calculation_435723265369501700]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='L1 - totals' datatype='string' name='[Calculation_435723265369501700]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;reg&apos; THEN [Region]&#13;&#10;WHEN &apos;bra&apos; THEN [Brand]&#13;&#10;WHEN &apos;ent&apos; THEN [Entity]&#13;&#10;WHEN &apos;con&apos; THEN [CountryName]&#13;&#10;WHEN &apos;ver&apos; THEN [Vertical]&#13;&#10;WHEN &apos;nbr&apos; THEN &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Dummy' datatype='integer' name='[Calculation_551690956406702084]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Actuals Dates' datatype='date' name='[Calculation_956733447991144450]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Scenario] = &quot;ACTUAL&quot; AND &#13;&#10;YEAR([f_month_date]) = 2024&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10; THEN [f_month_date] END' />
            </column>
            <column caption='dynamic BE' datatype='string' name='[Calculation_956733448023736331]' role='dimension' type='nominal'>
