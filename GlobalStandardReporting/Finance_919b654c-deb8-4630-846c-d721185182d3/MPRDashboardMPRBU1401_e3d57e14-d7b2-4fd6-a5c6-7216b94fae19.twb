            <column aggregation='CountD' caption='ACTUAL PM' datatype='string' name='[1.1 Actual PM (copy)_2090514659415560193]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF LEN(STR(MONTH([Calculation_435723265374801929]))) = 1 THEN&#13;&#10;    &quot;0&quot; + STR(MONTH([Calculation_435723265374801929]))&#13;&#10;ELSE&#13;&#10;    STR(MONTH([Calculation_435723265374801929]))&#13;&#10;END +&#13;&#10;&quot;.&quot;+ &#13;&#10;str(DATEPART(&quot;year&quot;, [Calculation_435723265374801929]))' />
            </column>
            <column aggregation='CountD' caption='BE Scenario' datatype='string' name='[Actuals Dates (copy)_956733447996776451]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;LEFT([Scenario], 2) = &quot;BE&quot; AND NOT CONTAINS([Scenario], &quot;_APY&quot;)&#13;&#10;THEN [Scenario] &#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
            <column caption='TGT Scenario' datatype='string' name='[Calculation_1949214220066537473]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;LEFT([Scenario], 2) = &quot;BU&quot; &#13;&#10;AND NOT CONTAINS([Scenario], &quot;_APY&quot;)&#13;&#10;AND CONTAINS([Scenario],&quot;24&quot;)&#13;&#10;THEN [Scenario] &#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Selected Month -1' datatype='datetime' name='[Calculation_435723265374801929]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1])' />
            </column>
            <column caption='Actuals Dates' datatype='date' name='[Calculation_956733447991144450]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Scenario] = &quot;ACTUAL&quot; AND &#13;&#10;YEAR([f_month_date]) = 2024&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10; THEN [f_month_date] END' />
            </column>
