      <aliases enabled='yes' />
      <column caption='# Employees Used Budget' datatype='integer' name='[# Employees eligible (copy)_426153125736558592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [used_eb] = &apos;Yes&apos; THEN [employee_name] END)' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0ppyw5i1s7yymx17az62c14arx4v].[avg:eligible_eb_budget:qk]&quot;' value='Budget' />
          <alias key='&quot;[federated.0ppyw5i1s7yymx17az62c14arx4v].[max:total_spent_by_employee:qk]&quot;' value='Total Spent' />
          <alias key='&quot;[federated.0ppyw5i1s7yymx17az62c14arx4v].[min:amount_left_by_employee:qk]&quot;' value='Amount Left' />
        </aliases>
      </column>
      <column caption='% Source from Total' datatype='real' name='[Amount In GC (copy)_1203587005777108992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([amount_in_gc]) / TOTAL(SUM([amount_in_gc]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cost Center' datatype='string' name='[Calculation_1271422474919817216]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[cost_center]+ &apos; - &apos; + [cost_center_name]' />
      </column>
      <column caption='Budget Total' datatype='real' name='[Calculation_1271422474923905025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum({Fixed [employee_name],[workday_year]:AVG([eligible_eb_budget])})' />
      </column>
      <column caption='Actuals Total ' datatype='real' name='[Calculation_1271422474924773378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum({Fixed [employee_name],[fiscal_year],[workday_year]:Max([total_spent_by_employee])})' />
      </column>
      <column caption='Remaining Total' datatype='real' name='[Calculation_1271422474926469123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum({Fixed [employee_name],[workday_year]:Min([amount_left_by_employee])})' />
      </column>
      <column caption='Concat' datatype='string' name='[Calculation_1271422474927685636]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[cost_center]+[Calculation_1271422474919817216]+[cost_center_name]+[employee_manager]+[employee_name]' />
      </column>
      <column caption='# Employees Eligible' datatype='integer' name='[Calculation_1271422474937294855]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [can_use_EB] = &apos;Yes&apos; THEN [employee_name] END)' />
      </column>
      <column caption='Spent on Ariba' datatype='real' name='[Calculation_1271422474938417162]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [source_data] = &apos;Ariba&apos; THEN [amount_in_gc] END)' />
      </column>
      <column caption='Year Comparison' datatype='integer' name='[Calculation_130041444920942592]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if MONTH([posting_date])&gt;=1 then   year([posting_date])&#13;&#10;&#13;&#10;else year([posting_date])-1 end' />
      </column>
      <column caption='YoY comparison' datatype='boolean' name='[Calculation_130041444922363905]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_130041444920942592]=year({max([posting_date])}) Or [Calculation_130041444920942592] =year({max([posting_date])})-1 OR [Calculation_130041444920942592] =year({max([posting_date])})-2' />
      </column>
      <column caption='Login Check' datatype='boolean' name='[Calculation_2705537487473557505]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[tableau_username]=USERNAME()' />
      </column>
      <column caption='# Total Employees' datatype='integer' name='[Calculation_524950835616858115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([employee_name])' />
      </column>
      <column caption='Counter Orders' datatype='integer' name='[Calculation_846676741667237888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([document_number])' />
      </column>
      <column caption='% EB Usage from Total' datatype='real' name='[Calculation_897342233553301504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([employee_name]) / TOTAL(COUNTD([employee_name]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Spent on Concur' datatype='real' name='[Catalog Items (copy)_1271422474938564619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [source_data] = &apos;Concur&apos; THEN [amount_in_gc] END)' />
      </column>
      <column datatype='real' hidden='true' name='[FTE]' role='measure' type='quantitative' />
      <column caption='Level - Filter' datatype='string' name='[Level (copy)_2825305110141739097]' role='dimension' type='nominal'>
