            <column datatype='date' name='[F Month Date (Months)]' role='dimension' type='quantitative' user:agg-type='Month-Trunc' user:base-field='f_month_date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [f_month_date]))' />
            </column>
            <column caption='CALC_% EBITDA On GMV' datatype='real' name='[FYACT % EBITDA on GMV (copy)_1462825465855234092 2 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([aebitda_incl_gc])/SUM([gmv])' />
            </column>
            <column caption='CALC_% EBITDA On Revenue' datatype='real' name='[FYACT % EBITDA on Revenue (copy)_1462825465855234093 2 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([aebitda_incl_gc])/SUM([revenue])' />
            </column>
            <column caption='CALC_% Gross Profit On GMV' datatype='real' name='[FYACT % Gross Profit on GMV (copy 2)_1462825465855234094 2 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([grossprofit])/SUM([gmv])' />
            </column>
            <column caption='CALC_% OD Share' datatype='real' name='[FYACT % OD Share (copy 2)_1462825465855234098 2 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([od_orders])/SUM([orders])' />
            </column>
            <column caption='CALC_% Take rate' datatype='real' name='[FYACT % Take rate (copy 2)_1462825465855234100 2 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([revenue])/SUM([gmv])' />
            </column>
            <column caption='CALC_AOV' datatype='real' name='[FYBECC AOV (copy)_1513772441944219649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv])/SUM([orders])' />
            </column>
            <column caption='GetMonth - Select Month' datatype='date' name='[GetYear - Select Year (copy)_1462825465852686376]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 1]))' />
            </column>
