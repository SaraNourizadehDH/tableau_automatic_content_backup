          <datasource-dependencies datasource='federated.0dqejtw0n5678g1alqegp0i6gh6y'>
            <column caption='FYBE % EBITDA on GMV' datatype='real' name='[% EBITDA on GMV (copy)_255016339441885217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([FYBE_Adj. EBITDA w/o Group Costs) (copy)_255016339441750046])/sum([FYBE_Orders (copy)_255016339435651076])' />
            </column>
            <column caption='FYBE % EBITDA on Revenue ' datatype='real' name='[% EBITDA on Revenue (copy)_255016339441885218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([FYBE_Adj. EBITDA w/o Group Costs) (copy)_255016339441750046])/sum([FYBE_Orders (copy)_255016339438202889])' />
            </column>
            <column caption='FYBE % Gross Profit on GMV' datatype='real' name='[% Gross Profit on GMV (copy)_255016339439353871]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([FYBE_CostOfSales (copy)_255016339439046669])/sum([FYBE_Orders (copy)_255016339435651076])' />
            </column>
            <column caption='FYBE % Take rate' datatype='real' name='[% Take rate (copy)_255016339438551051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([FYBE_Orders (copy)_255016339438202889])/sum([FYBE_Orders (copy)_255016339435651076])' />
            </column>
            <column aggregation='CountD' caption='2.3 Δ  FY ACT vs TGT' datatype='string' name='[1.5 Δ  ACT vs TGT (copy)_1695605274453684227]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Δ (%) vs Target&quot;' />
            </column>
            <column caption='FYBE_Orders' datatype='real' name='[Actual (copy)_551690956124565504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Scenario] = [Parameters].[Parameter 3] AND &#13;&#10;[F Month Date (Years)] = [Calculation_1159958382538104844] THEN&#13;&#10;[orders]&#13;&#10;ELSE 0 END' />
            </column>
            <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
