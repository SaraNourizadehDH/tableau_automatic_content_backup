            <column caption='BE - sel' datatype='string' name='[Calculation_1359524199078891520]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;BE05&quot;' />
            </column>
            <column caption='TGT Scenario' datatype='string' name='[Calculation_1949214220066537473]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;LEFT([Scenario], 2) = &quot;BU&quot; &#13;&#10;AND NOT CONTAINS([Scenario], &quot;_APY&quot;)&#13;&#10;&#13;&#10;THEN [Scenario] &#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='―' datatype='integer' name='[Calculation_5083578837547855884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(1-1)' />
            </column>
            <column caption='TGT Scenario - default' datatype='string' name='[Calculation_746190214956224518]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;BUDGET2025AI&quot;' />
            </column>
            <column caption='Actuals Dates' datatype='date' name='[Calculation_956733447991144450]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Scenario] = &quot;ACTUAL&quot; AND ( &#13;&#10;YEAR([f_month_date]) &gt;= 2024 )&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10; THEN [f_month_date] END' />
            </column>
            <column caption='Country Name' datatype='string' name='[CountryName]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Currency Flag' datatype='string' name='[CurrencyFlag]' role='dimension' type='nominal' />
