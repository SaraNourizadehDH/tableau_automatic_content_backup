              <calculation class='tableau' formula='SUM([aebitda_incl_gc])/ SUM([gmv])' />
            </column>
            <column caption='CALC_% NCR On GMV' datatype='real' name='[MACT % Gross Profit on GMV (copy)_1926133280044105735 1 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ncr_revenue])/SUM([gmv])' />
            </column>
            <column caption='CALC_% Marketing CCS On GMV' datatype='real' name='[MACT % Gross Profit on GMV (copy)_1926133280044531721 1 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([marketing_ccs])/SUM([gmv])' />
