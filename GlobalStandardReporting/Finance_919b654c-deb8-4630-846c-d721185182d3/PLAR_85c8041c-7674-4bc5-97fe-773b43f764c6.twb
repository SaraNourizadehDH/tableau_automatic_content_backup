            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0dqejtw0n5678g1alqegp0i6gh6y].[Calculation_746190214956224518]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0dqejtw0n5678g1alqegp0i6gh6y].[Calculation_1949214220066537473]' caption='Select Target Scenario' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;BUDGET2025AI&quot;'>
              <calculation class='tableau' formula='&quot;BUDGET2025AI&quot;' />
