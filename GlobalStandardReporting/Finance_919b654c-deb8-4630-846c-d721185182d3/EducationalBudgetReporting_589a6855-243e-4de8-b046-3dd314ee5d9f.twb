          <datasource-dependencies datasource='federated.0ppyw5i1s7yymx17az62c14arx4v'>
            <column caption='Cost Center' datatype='string' name='[Calculation_1271422474919817216]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[fi_cost_center]+ &apos; - &apos; + [cost_center_name]' />
            </column>
            <column caption='Total Budget' datatype='real' name='[Calculation_1271422474923905025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum({Fixed [employee_name],[fiscal_year]:AVG([eligible_eb_budget])})' />
            </column>
            <column caption='Total Spent' datatype='real' name='[Calculation_1271422474924773378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum({Fixed [employee_name],[fiscal_year]:Max([total_spent_by_employee])})' />
            </column>
            <column caption='Total Left' datatype='real' name='[Calculation_1271422474926469123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum({Fixed [employee_name],[fiscal_year]:Min([amount_left_by_employee])})' />
            </column>
            <column caption='# Employees eligible' datatype='integer' name='[Calculation_1271422474937294855]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [can_use_EB] = &apos;Yes&apos; THEN [employee_name] END)' />
            </column>
            <column caption='Spent on Ariba' datatype='real' name='[Calculation_1271422474938417162]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [source_data] = &apos;Ariba&apos; THEN [amount_in_gc] END)' />
            </column>
            <column caption='# Total Employees' datatype='integer' name='[Calculation_524950835616858115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([employee_email])' />
            </column>
            <column caption='Spent on Concur' datatype='real' name='[Catalog Items (copy)_1271422474938564619]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [source_data] = &apos;Concur&apos; THEN [amount_in_gc] END)' />
            </column>
            <column caption='Amount In GC' datatype='real' name='[amount_in_gc]' role='measure' type='quantitative' />
            <column caption='Left by Employee' datatype='real' name='[amount_left_by_employee]' role='measure' type='quantitative' />
