        <calculation class='tableau' formula='DATE(LEFT([Parameters].[Parameter 2], 4) + &quot;-&quot; + RIGHT([Parameters].[Parameter 2], 2) + &quot;-01&quot;)' />
      </column>
      <column caption='Parameter Date +1 ' datatype='datetime' name='[Calculation_1299288560402255873]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Calculation_1299288560401965056]))' />
      </column>
      <column caption='Login Check Func' datatype='boolean' name='[Calculation_684828676388593664]' role='dimension' type='nominal'>
