    <worksheet name='Daily Fail Rates'>
      <table>
        <view>
          <datasources>
            <datasource caption='PeYa Vendor Portal and Integrations Usage Data' name='federated.188qzre0x1okjv14sst891685f7z' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Fail Rate Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Fail Rate (5 mins)&quot;'>
              <calculation class='tableau' formula='&quot;Fail Rate (5 mins)&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.188qzre0x1okjv14sst891685f7z'>
            <column caption='Failed Orders' datatype='integer' name='[Calculation_150800269351473172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Fail Rate (5 mins)&quot; THEN SUM([failed_orders_in_5_minutes])&#10;WHEN &quot;Fail Rate (10 mins)&quot; THEN SUM([failed_orders_in_10_minutes])&#10;WHEN &quot;Fail Rate (15 mins)&quot; THEN SUM([failed_orders_in_15_minutes])&#10;WHEN &quot;Fail Rate (30 mins)&quot; THEN SUM([failed_orders_in_30_minutes])&#10;WHEN &quot;Fail Rate (60 mins)&quot; THEN SUM([failed_orders_in_60_minutes])&#10;WHEN &quot;Vendor Fail Rate (5 mins)&quot; THEN SUM([vendor_failed_orders_in_5_minutes])&#10;WHEN &quot;Vendor Fail Rate (10 mins)&quot; THEN SUM([vendor_failed_orders_in_10_minutes])&#10;WHEN &quot;Vendor Fail Rate (15 mins)&quot; THEN SUM([vendor_failed_orders_in_15_minutes])&#10;WHEN &quot;Vendor Fail Rate (30 mins)&quot; THEN SUM([vendor_failed_orders_in_30_minutes])&#10;WHEN &quot;Vendor Fail Rate (60 mins)&quot; THEN SUM([vendor_failed_orders_in_60_minutes])&#10;WHEN &quot;Closed Vendor Fail Rate (5 mins)&quot; THEN SUM([closed_vendor_failed_orders_in_5_minutes])&#10;WHEN &quot;Closed Vendor Fail Rate (10 mins)&quot; THEN SUM([closed_vendor_failed_orders_in_10_minutes])&#10;WHEN &quot;Closed Vendor Fail Rate (15 mins)&quot; THEN SUM([closed_vendor_failed_orders_in_15_minutes])&#10;WHEN &quot;Closed Vendor Fail Rate (30 mins)&quot; THEN SUM([closed_vendor_failed_orders_in_30_minutes])&#10;WHEN &quot;Closed Vendor Fail Rate (60 mins)&quot; THEN SUM([closed_vendor_failed_orders_in_60_minutes])&#10;WHEN &quot;Too Busy Vendor Fail Rate (5 mins)&quot; THEN SUM([too_busy_vendor_failed_orders_in_5_minutes])&#10;WHEN &quot;Too Busy Vendor Fail Rate (10 mins)&quot; THEN SUM([too_busy_vendor_failed_orders_in_10_minutes])&#10;WHEN &quot;Too Busy Vendor Fail Rate (15 mins)&quot; THEN SUM([too_busy_vendor_failed_orders_in_15_minutes])&#10;WHEN &quot;Too Busy Vendor Fail Rate (30 mins)&quot; THEN SUM([too_busy_vendor_failed_orders_in_30_minutes])&#10;WHEN &quot;Too Busy Vendor Fail Rate (60 mins)&quot; THEN SUM([too_busy_vendor_failed_orders_in_60_minutes])&#10;END' />
            </column>
            <column caption='Orders' datatype='integer' name='[Calculation_150800269352763414]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Fail Rate (5 mins)&quot; THEN SUM([orders_in_5_minutes])&#10;WHEN &quot;Fail Rate (10 mins)&quot; THEN SUM([orders_in_10_minutes])&#10;WHEN &quot;Fail Rate (15 mins)&quot; THEN SUM([orders_in_15_minutes])&#10;WHEN &quot;Fail Rate (30 mins)&quot; THEN SUM([orders_in_30_minutes])&#10;WHEN &quot;Fail Rate (60 mins)&quot; THEN SUM([orders_in_60_minutes])&#10;WHEN &quot;Vendor Fail Rate (5 mins)&quot; THEN SUM([orders_in_5_minutes])&#10;WHEN &quot;Vendor Fail Rate (10 mins)&quot; THEN SUM([orders_in_10_minutes])&#10;WHEN &quot;Vendor Fail Rate (15 mins)&quot; THEN SUM([orders_in_15_minutes])&#10;WHEN &quot;Vendor Fail Rate (30 mins)&quot; THEN SUM([orders_in_30_minutes])&#10;WHEN &quot;Vendor Fail Rate (60 mins)&quot; THEN SUM([orders_in_60_minutes])&#10;WHEN &quot;Closed Vendor Fail Rate (5 mins)&quot; THEN SUM([orders_in_5_minutes])&#10;WHEN &quot;Closed Vendor Fail Rate (10 mins)&quot; THEN SUM([orders_in_10_minutes])&#10;WHEN &quot;Closed Vendor Fail Rate (15 mins)&quot; THEN SUM([orders_in_15_minutes])&#10;WHEN &quot;Closed Vendor Fail Rate (30 mins)&quot; THEN SUM([orders_in_30_minutes])&#10;WHEN &quot;Closed Vendor Fail Rate (60 mins)&quot; THEN SUM([orders_in_60_minutes])&#10;WHEN &quot;Too Busy Vendor Fail Rate (5 mins)&quot; THEN SUM([orders_in_5_minutes])&#10;WHEN &quot;Too Busy Vendor Fail Rate (10 mins)&quot; THEN SUM([orders_in_10_minutes])&#10;WHEN &quot;Too Busy Vendor Fail Rate (15 mins)&quot; THEN SUM([orders_in_15_minutes])&#10;WHEN &quot;Too Busy Vendor Fail Rate (30 mins)&quot; THEN SUM([orders_in_30_minutes])&#10;WHEN &quot;Too Busy Vendor Fail Rate (60 mins)&quot; THEN SUM([orders_in_60_minutes])&#10;END' />
            </column>
            <column caption='Fail Rate Metric' datatype='real' name='[Failed Orders (copy)_150800269353279511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_150800269351473172]/[Calculation_150800269352763414]' />
