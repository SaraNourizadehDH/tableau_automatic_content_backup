      <table>
        <view>
          <datasources>
            <datasource caption='PeYa Vendor Portal and Integrations Usage Data' name='federated.188qzre0x1okjv14sst891685f7z' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Vendor Attributes' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vendor Grade&quot;'>
              <calculation class='tableau' formula='&quot;Vendor Grade&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.188qzre0x1okjv14sst891685f7z'>
            <column aggregation='Sum' caption='Total Vendors per Attribute' datatype='integer' name='[Calculation_103864301823172612]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [Calculation_150800269324308493]: COUNTD([vendor_code])}' />
            </column>
            <column caption='Vendor Portal Vendor' datatype='string' name='[Calculation_150800269269405697]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF { FIXED [vendor_code]: COUNT(IF [client_name] = &apos;Vendor Portal&apos; THEN [client_name] END)} &gt; 0 THEN &quot;YES&quot; ELSE &quot;NO&quot; END' />
              <aliases>
                <alias key='&quot;NO&quot;' value='Non Vendor Portal User' />
                <alias key='&quot;YES&quot;' value='Vendor Portal User' />
              </aliases>
            </column>
            <column caption='MIN(1)' datatype='integer' name='[Calculation_150800269272592387]' role='measure' type='quantitative' user:unnamed='Sheet 3'>
              <calculation class='tableau' formula='MIN(1)' />
            </column>
            <column caption='Clients' datatype='string' name='[Calculation_150800269274898441]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_150800269269405697] = &quot;YES&quot;&#10;THEN&#10;    (&#10;    IF [Vendor Portal User (copy)_150800269274513414] = &quot;YES&quot; THEN &quot;Vendor Portal + GoDroid&quot;&#10;    ELSEIF [Vendor Portal User (copy) (copy)_150800269274517511] = &quot;YES&quot; THEN &quot;Vendor Portal + GoWin&quot;&#10;    ELSEIF [Vendor Portal User (copy) (copy) (copy)_150800269274525704] = &quot;YES&quot; THEN &quot;Vendor Portal + GoWeb&quot;&#10;    ELSE &quot;Vendor Portal&quot;&#10;    END&#10;    )&#10;ELSE&#10;    (&#10;    IF [Vendor Portal User (copy)_150800269274513414] = &quot;YES&quot; THEN &quot;GoDroid&quot;&#10;    ELSEIF [Vendor Portal User (copy) (copy)_150800269274517511] = &quot;YES&quot; THEN &quot;GoWin&quot;&#10;    ELSEIF [Vendor Portal User (copy) (copy) (copy)_150800269274525704] = &quot;YES&quot; THEN &quot;GoWeb&quot;&#10;    ELSE &quot;N/A&quot;&#10;    END&#10;    )&#10;END' />
            </column>
            <column caption='Vendor Attribute' datatype='string' name='[Calculation_150800269324308493]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Is Dormant Vendor&quot; THEN [is_dormant_vendor]&#10;WHEN &quot;Is Inoperative Vendor&quot; THEN [is_inoperative_vendor]&#10;WHEN &quot;Is New Vendor&quot; THEN [is_new_vendor]&#10;WHEN &quot;Is Unengaged Vendor&quot; THEN [is_unengaged_vendor]&#10;WHEN &quot;Vendor Grade&quot; THEN [vendor_grade]&#10;WHEN &quot;Vertical Type&quot; THEN [vertical_type]&#10;END' />
              <aliases>
                <alias key='&quot;false&quot;' value='FALSE' />
                <alias key='&quot;true&quot;' value='TRUE' />
              </aliases>
            </column>
            <column caption='GoWeb Vendor' datatype='string' name='[Vendor Portal User (copy) (copy) (copy)_150800269274525704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF { FIXED [vendor_code]: COUNT(IF [client_name] = &apos;GOWEB&apos; THEN [client_name] END)} &gt; 0 THEN &quot;YES&quot; ELSE &quot;NO&quot; END' />
            </column>
            <column caption='GoWin Vendor' datatype='string' name='[Vendor Portal User (copy) (copy)_150800269274517511]' role='dimension' type='nominal'>
