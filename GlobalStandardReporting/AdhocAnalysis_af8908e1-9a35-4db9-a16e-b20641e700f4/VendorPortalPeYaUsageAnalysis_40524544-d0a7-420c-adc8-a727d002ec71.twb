              <calculation class='tableau' formula='IF { FIXED [vendor_code]: COUNT(IF [client_name] = &apos;Vendor Portal&apos; THEN [client_name] END)} &gt; 0 THEN &quot;YES&quot; ELSE &quot;NO&quot; END' />
