        <calculation class='tableau' formula='IF [Calculation_150800269269405697] = &quot;YES&quot;&#10;THEN&#10;    (&#10;    IF [Vendor Portal User (copy)_150800269274513414] = &quot;YES&quot; THEN &quot;Vendor Portal + GoDroid&quot;&#10;    ELSEIF [Vendor Portal User (copy) (copy)_150800269274517511] = &quot;YES&quot; THEN &quot;Vendor Portal + GoWin&quot;&#10;    ELSEIF [Vendor Portal User (copy) (copy) (copy)_150800269274525704] = &quot;YES&quot; THEN &quot;Vendor Portal + GoWeb&quot;&#10;    ELSE &quot;Vendor Portal&quot;&#10;    END&#10;    )&#10;ELSE&#10;    (&#10;    IF [Vendor Portal User (copy)_150800269274513414] = &quot;YES&quot; THEN &quot;GoDroid&quot;&#10;    ELSEIF [Vendor Portal User (copy) (copy)_150800269274517511] = &quot;YES&quot; THEN &quot;GoWin&quot;&#10;    ELSEIF [Vendor Portal User (copy) (copy) (copy)_150800269274525704] = &quot;YES&quot; THEN &quot;GoWeb&quot;&#10;    ELSE &quot;N/A&quot;&#10;    END&#10;    )&#10;END' />
