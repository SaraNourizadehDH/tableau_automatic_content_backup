      </column>
      <column caption='Demand level' datatype='string' name='[Calculation_3288542574872719366]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF (([normalized_pickup_delay] &gt;= [Parameters].[Parameter 1]  &#10;AND [normalized_pickup_delay] &lt; [Parameters].[Parameter 2]) &#10;OR ([normalized_pickup_delay] &lt; [Parameters].[Parameter 1] &#10;AND [zone_demand_percentile1] &gt; [Parameters].[Parameter 4])) THEN &apos;Moderate demand&apos;&#10;ELSEIF [normalized_pickup_delay] &gt;= [Parameters].[Parameter 2] &#10;AND [normalized_pickup_delay] &lt; [Parameters].[Parameter 3]&#10;AND [zone_demand_percentile1] &gt; [Parameters].[Parameter 4]&#10;THEN &apos;High demand&apos;&#10;ELSEIF [normalized_pickup_delay] &gt;= [Parameters].[Parameter 3] &#10;AND [zone_demand_percentile1] &gt; [Parameters].[Parameter 4]&#10;THEN &apos;Very high demand&apos;&#10;ELSE &apos;Low demand&apos; END' />
      </column>
      <column caption='Hour' datatype='integer' name='[Calculation_3288542574874275847]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [valid_to])' />
      </column>
      <column caption='Avg.number of deliveries' datatype='real' name='[Calculation_3288542574882172937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([deliveries])' />
      </column>
      <column caption='Avg.pickup delay (minutes)' datatype='real' name='[Calculation_3288542574882541578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([total_delay_sec]/[deliveries])/60' />
      </column>
