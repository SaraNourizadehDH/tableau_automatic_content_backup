      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='heatmap_calculator (rider_availability)' name='federated.0szg5cs04739p815dt9x21b6i97o' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Moderate demand' datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='0.20000000000000001'>
              <calculation class='tableau' formula='0.20000000000000001' />
              <range granularity='0.05' max='1.0' min='0.0' />
            </column>
            <column caption='High demand' datatype='real' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='0.69999999999999973'>
              <calculation class='tableau' formula='0.69999999999999973' />
              <range granularity='0.05' max='1.0' min='0.0' />
            </column>
            <column caption='Very high demand' datatype='real' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='0.89999999999999991'>
              <calculation class='tableau' formula='0.89999999999999991' />
              <range granularity='0.05' max='1.0' min='0.0' />
            </column>
            <column caption='Order volume threshold' datatype='real' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value='0.05'>
              <calculation class='tableau' formula='0.05' />
              <range granularity='0.05' max='1.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0szg5cs04739p815dt9x21b6i97o'>
            <column caption='Heatmap snapshot' datatype='string' name='[Calculation_3288542574870626304]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[h3_index] + STR([valid_to])' />
            </column>
            <column caption='Heatmap snapshots' datatype='integer' name='[Calculation_3288542574870745089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_3288542574870626304])' />
            </column>
            <column caption='Demand level' datatype='string' name='[Calculation_3288542574872719366]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF (([normalized_pickup_delay] &gt;= [Parameters].[Parameter 1]  &#10;AND [normalized_pickup_delay] &lt; [Parameters].[Parameter 2]) &#10;OR ([normalized_pickup_delay] &lt; [Parameters].[Parameter 1] &#10;AND [zone_demand_percentile1] &gt; [Parameters].[Parameter 4])) THEN &apos;Moderate demand&apos;&#10;ELSEIF [normalized_pickup_delay] &gt;= [Parameters].[Parameter 2] &#10;AND [normalized_pickup_delay] &lt; [Parameters].[Parameter 3]&#10;AND [zone_demand_percentile1] &gt; [Parameters].[Parameter 4]&#10;THEN &apos;High demand&apos;&#10;ELSEIF [normalized_pickup_delay] &gt;= [Parameters].[Parameter 3] &#10;AND [zone_demand_percentile1] &gt; [Parameters].[Parameter 4]&#10;THEN &apos;Very high demand&apos;&#10;ELSE &apos;Low demand&apos; END' />
            </column>
            <column caption='Hour' datatype='integer' name='[Calculation_3288542574874275847]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [valid_to])' />
            </column>
            <column caption='Avg.number of deliveries' datatype='real' name='[Calculation_3288542574882172937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([deliveries])' />
            </column>
            <column caption='Avg.pickup delay (minutes)' datatype='real' name='[Calculation_3288542574882541578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([total_delay_sec]/[deliveries])/60' />
            </column>
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Created Date Local' datatype='date' name='[created_date_local]' role='dimension' type='ordinal' />
            <column caption='Deliveries' datatype='integer' name='[deliveries]' role='measure' type='quantitative' />
            <column caption='H3 Index' datatype='string' name='[h3_index]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3288542574872719366]' derivation='None' name='[none:Calculation_3288542574872719366:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_3288542574874275847]' derivation='None' name='[none:Calculation_3288542574874275847:ok]' pivot='key' type='ordinal' />
