          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Time Since Too Busy' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;5 Minutes&quot;'>
              <calculation class='tableau' formula='&quot;5 Minutes&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0y018xh04g0x1m1ccx9g20y6gnmd'>
            <column caption='Date' datatype='string' name='[Calculation_784048607388274688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date_local]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date_local]))+&quot;-W&quot;+STR(ISOWEEK([created_date_local]))&#10;END' />
            </column>
            <column caption='Orders' datatype='integer' name='[Calculation_784048607395319809]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;5 Minutes&quot; THEN [orders_five_minutes_after_too_busy]&#10;WHEN &quot;10 Minutes&quot; THEN [orders_ten_minutes_after_too_busy]&#10;WHEN &quot;15 Minutes&quot; THEN [orders_fifteen_minutes_after_too_busy]&#10;WHEN &quot;20 Minutes&quot; THEN [orders_twenty_minutes_after_too_busy]&#10;WHEN &quot;30 Minutes&quot; THEN [orders_thirty_minutes_after_too_busy]&#10;WHEN &quot;60 Minutes&quot; THEN [orders_sixty_minutes_after_too_busy]&#10;END' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_784048607396077573]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Orders (copy)_784048607395655682])/SUM([Calculation_784048607395319809])' />
            </column>
            <column caption='Vendor Fail Rate' datatype='real' name='[Fail Rate (copy)_784048607396159494]' role='measure' type='quantitative'>
