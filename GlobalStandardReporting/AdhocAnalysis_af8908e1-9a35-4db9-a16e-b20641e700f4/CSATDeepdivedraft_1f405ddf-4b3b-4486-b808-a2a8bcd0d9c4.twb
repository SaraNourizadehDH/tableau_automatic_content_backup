      <column caption='CSAT (%)' datatype='real' default-format='p0.0%' name='[Calculation_1364801858805805056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [self_service_csat] = 4 OR [self_service_csat] = 5 THEN 1 ELSE 0 END&#10;) / COUNT([self_service_csat])' />
      </column>
      <column caption='CSAT (%) ccr' datatype='real' default-format='p0.0%' name='[Calculation_1364801858813505537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [self_service_csat (csat_deep_dive_ccr_l3)] = 4 OR [self_service_csat (csat_deep_dive_ccr_l3)] = 5 THEN 1 ELSE 0 END&#10;) / COUNT([self_service_csat (csat_deep_dive_ccr_l3)])' />
      </column>
      <column caption=' Percentage of Total sessions' datatype='real' default-format='p0.0%' name='[Calculation_642818543589318656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([session_id]) / MAX({ FIXED : COUNTD([session_id]) })' />
      </column>
      <column caption='Impact Score' datatype='real' name='[Calculation_642818543589801985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_642818543589318656] * (1 - [Calculation_1364801858805805056])' />
      </column>
      <column caption='Total Sessions' datatype='integer' name='[Calculation_642818543590912002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : COUNTD([session_id]) }' />
      </column>
      <column caption='Percentage of Total Sessions (ccr)' datatype='real' name='[Calculation_642818543596019719]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([session_id (csat_deep_dive_ccr_l3)]) / MAX({ FIXED : COUNTD([session_id (csat_deep_dive_ccr_l3)]) })' />
      </column>
      <column caption='Impact Score CCR ' datatype='real' name='[Composite impact Score (copy)_642818543596212232]' role='measure' type='quantitative'>
