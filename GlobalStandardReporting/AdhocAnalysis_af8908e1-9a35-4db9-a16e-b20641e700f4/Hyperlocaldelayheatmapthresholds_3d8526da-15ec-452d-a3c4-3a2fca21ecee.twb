              <calculation class='tableau' formula='DATEPART(&apos;hour&apos;,[valid_to])' />
            </column>
            <column caption='Difference from prev interval' datatype='real' name='[Calculation_367043395154051073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([prev_delay]) THEN 0&#10;ELSE [normalized_pickup_delay] - [prev_delay]&#10;END' />
            </column>
            <column-instance column='[Calculation_367043395154051073]' derivation='Avg' name='[avg:Calculation_367043395154051073:qk]' pivot='key' type='quantitative' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='datetime' name='[interval_3_min]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_3214444257765113866]' derivation='None' name='[none:Calculation_3214444257765113866:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_3214444257765158923]' derivation='None' name='[none:Calculation_3214444257765158923:qk]' pivot='key' type='quantitative' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[interval_3_min]' derivation='None' name='[none:interval_3_min:ok]' pivot='key' type='ordinal' />
            <column-instance column='[zone_id]' derivation='None' name='[none:zone_id:nk]' pivot='key' type='nominal' />
            <column caption='Normalized Pickup Delay' datatype='real' name='[normalized_pickup_delay]' role='measure' type='quantitative' />
            <column datatype='real' name='[prev_delay]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_367043395154051073]' derivation='Stdev' name='[std:Calculation_367043395154051073:qk]' pivot='key' type='quantitative' />
            <column caption='Valid To' datatype='datetime' name='[valid_to]' role='dimension' type='ordinal' />
            <column caption='Zone Id' datatype='string' name='[zone_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1px5f6w1491er8105upqw0d9x2r7].[avg:Calculation_367043395154051073:qk]' included-values='non-null' />
          <filter class='categorical' column='[federated.1px5f6w1491er8105upqw0d9x2r7].[none:Calculation_3214444257765113866:ok]' filter-group='8'>
            <groupfilter function='member' level='[none:Calculation_3214444257765113866:ok]' member='#2024-06-04#' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
