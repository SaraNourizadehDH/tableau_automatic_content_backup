      <aliases enabled='yes' />
      <column caption='heatmap snapshot' datatype='string' name='[Calculation_3214444257425530880]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([h3_index])+STR([valid_to])' />
      </column>
      <column caption='heatmap snapshots count' datatype='integer' name='[Calculation_3214444257426161666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_3214444257425530880])' />
      </column>
      <column caption='Average delay value' datatype='real' name='[Calculation_3214444257426460675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delay_mins_sum])/sum([deliveries_rows])' />
      </column>
      <column caption='Demand category' datatype='string' name='[Calculation_3214444257428656134]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [normalized_pickup_delay] &gt;= [Parameters].[Parameter 3]&#10;THEN  &apos;Very high demand&apos; &#10;ELSEIF [normalized_pickup_delay] &gt;= [Parameters].[Parameter 2] &#10;THEN &apos;High demand threshold&apos;&#10;ELSEIF [normalized_pickup_delay] &gt;= [Parameters].[Parameter 1]&#10;THEN &apos;Moderate threshold&apos;&#10;ELSE &apos;Low demand threshold&apos; &#10;END' />
        <aliases>
          <alias key='&quot;High demand threshold&quot;' value='High demand ' />
          <alias key='&quot;Low demand threshold&quot;' value='Low demand' />
          <alias key='&quot;Moderate threshold&quot;' value='Moderate demand' />
        </aliases>
      </column>
      <column caption='Number of zones' datatype='integer' name='[Calculation_3214444257431085063]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD((STR([zone_id]) + STR([valid_to])))' />
      </column>
      <column caption='number of hexagons in zone' datatype='integer' name='[Calculation_3214444257700495369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [country_code],[zone_id]: COUNTD([h3_index])}' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_3214444257765113866]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([valid_to])' />
      </column>
      <column caption='Hour' datatype='integer' name='[Calculation_3214444257765158923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;,[valid_to])' />
      </column>
      <column caption='Difference from prev interval' datatype='real' name='[Calculation_367043395154051073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([prev_delay]) THEN 0&#10;ELSE [normalized_pickup_delay] - [prev_delay]&#10;END' />
      </column>
      <column caption='Interval 3 minute' datatype='datetime' name='[Calculation_367043395161153538]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETIME(&#10;    DATEPART(&apos;year&apos;, [valid_to]) * 10000000000 +&#10;    DATEPART(&apos;month&apos;, [valid_to]) * 100000000 +&#10;    DATEPART(&apos;day&apos;, [valid_to]) * 1000000 +&#10;    DATEPART(&apos;hour&apos;, [valid_to]) * 10000 +&#10;    (INT(DATEPART(&apos;minute&apos;, [valid_to]) / 3) * 3) * 100 +&#10;    0&#10;)' />
      </column>
      <column caption='% of deliveries with delay &gt;= 10 minutes' datatype='real' name='[Calculation_3833829944385290240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([deliveries_with_delay_10_mins])/SUM([deliveries_rows])' />
      </column>
      <column caption='Previous delay' datatype='real' name='[Calculation_404901779538612224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([prev_delay]) THEN 0 ELSE [prev_delay] END' />
      </column>
      <column caption='Difference with prev prev ts' datatype='real' name='[Calculation_417638522237558784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([prev2_delay]) THEN 0&#10;ELSE [normalized_pickup_delay] - [prev2_delay]&#10;END' />
      </column>
      <column caption='Difference with prev 3 ts' datatype='real' name='[Calculation_417638522237714433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([prev3_delay]) THEN 0&#10;ELSE [normalized_pickup_delay] - [prev3_delay]&#10;END' />
      </column>
      <column caption='Standard deviation of the normalized pickup delay within one h3' datatype='real' name='[Calculation_417638522243182595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [h3_index], [Calculation_3214444257765158923]: STDEV([normalized_pickup_delay])}' />
      </column>
      <column aggregation='None' datatype='integer' name='[Difference from prev interval (bin)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='-2' formula='[Calculation_367043395154051073]' peg='0' size='0.069' />
      </column>
