    <worksheet name='Sheet 7'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='12'>Dynamics of the average change in normalized pickup delay between 2 following timestamps in one h3</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='hyperlocal_heatmap_thresholds (rider_availability)' name='federated.1px5f6w1491er8105upqw0d9x2r7' />
          </datasources>
