        <calculation class='tableau' formula='(ZN([ABS (copy)_2522297286727381025]) - LOOKUP(ZN([ABS (copy)_2522297286727381025]), -1)) / ABS(LOOKUP(ZN([ABS (copy)_2522297286727381025]), -1))'>
