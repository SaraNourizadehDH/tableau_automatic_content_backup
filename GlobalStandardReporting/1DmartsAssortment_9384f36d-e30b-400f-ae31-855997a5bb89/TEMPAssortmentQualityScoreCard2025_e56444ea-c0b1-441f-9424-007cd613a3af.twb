      <column caption='Delete' datatype='real' hidden='true' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(ATTR([avg_listed_skus_check])) - LOOKUP(ZN(ATTR([avg_listed_skus_check])), -1)'>
          <table-calc ordering-field='[federated.15l6rta1088oux1dx3dar03qh865].[display_name]' ordering-type='Field' />
