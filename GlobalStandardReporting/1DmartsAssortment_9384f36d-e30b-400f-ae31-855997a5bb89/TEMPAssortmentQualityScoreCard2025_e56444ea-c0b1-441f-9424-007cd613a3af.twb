            <column caption='Dist Listed Skus' datatype='integer' name='[dist_listed_skus]' role='measure' type='quantitative' />
            <column caption='Dmart Covered Mau' datatype='integer' name='[dmart_covered_mau]' role='measure' type='quantitative' />
