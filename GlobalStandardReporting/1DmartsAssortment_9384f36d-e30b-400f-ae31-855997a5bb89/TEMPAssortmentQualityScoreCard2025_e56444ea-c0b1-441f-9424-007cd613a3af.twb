      <aliases enabled='yes' />
      <column caption='2. Score Asst. Design Gap ' datatype='integer' hidden='true' name='[1. Score Avg Listed SKUs (copy)_1185854145411874821]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [perc_design_compliance]  &gt; 30 THEN 0&#13;&#10;ELSEIF [perc_design_compliance] &gt;= 27.5 THEN 1&#13;&#10;ELSEIF [perc_design_compliance] &gt;= 25 THEN 2&#13;&#10;ELSEIF [perc_design_compliance] &gt;= 22.5 THEN 3&#13;&#10;ELSEIF [perc_design_compliance] &gt;= 20 THEN 4&#13;&#10;ELSEIF [perc_design_compliance] &gt;= 17.5 THEN 5&#13;&#10;ELSEIF [perc_design_compliance] &gt;= 15 THEN 6&#13;&#10;ELSEIF [perc_design_compliance] &gt;= 12.5 THEN 7&#13;&#10;ELSEIF [perc_design_compliance] &gt;= 10 THEN 8&#13;&#10;ELSEIF [perc_design_compliance] &gt;= 7.5 THEN 9&#13;&#10;ELSE 10 END' />
      </column>
      <column caption='3. Score Efficiency %' datatype='integer' hidden='true' name='[1. Score Avg Listed SKUs (copy)_1185854145413308422]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [check_efficiency]  &lt;= .45 THEN 0&#13;&#10;ELSEIF [check_efficiency]  &lt;= .5 THEN 1&#13;&#10;ELSEIF [check_efficiency]  &lt;= .55 THEN 2&#13;&#10;ELSEIF [check_efficiency]  &lt;= .6 THEN 3&#13;&#10;ELSEIF [check_efficiency]  &lt;= .65 THEN 4&#13;&#10;ELSEIF [check_efficiency]  &lt;= .7 THEN 5&#13;&#10;ELSEIF [check_efficiency]  &lt;= .75 THEN 6&#13;&#10;ELSEIF [check_efficiency]  &lt;= .8 THEN 7&#13;&#10;ELSEIF [check_efficiency]  &lt;= .85 THEN 8&#13;&#10;ELSEIF [check_efficiency]  &lt;= .9 THEN 9&#13;&#10;ELSE 10 END' />
      </column>
      <column caption='8. Score DOH' datatype='integer' hidden='true' name='[2. Score Asst. Design Gap  (copy)_1185854145417588747]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [check_book_value]  &gt; 40 THEN 0&#13;&#10;ELSEIF [check_book_value] &gt;= 37.5 THEN 1&#13;&#10;ELSEIF [check_book_value] &gt;= 35 THEN 2&#13;&#10;ELSEIF [check_book_value] &gt;= 32.5 THEN 3&#13;&#10;ELSEIF [check_book_value] &gt;= 30 THEN 4&#13;&#10;ELSEIF [check_book_value] &gt;= 27.5 THEN 5&#13;&#10;ELSEIF [check_book_value] &gt;= 25 THEN 6&#13;&#10;ELSEIF [check_book_value] &gt;= 22.5 THEN 7&#13;&#10;ELSEIF [check_book_value] &gt;= 20 THEN 8&#13;&#10;ELSEIF [check_book_value] &gt;= 17.5 THEN 9&#13;&#10;ELSE 10 END' />
      </column>
      <column caption='4. Score L3 Coverage %' datatype='integer' hidden='true' name='[3. Score Efficiency % (copy)_1185854145414529031]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [check_core_sku_coverage]  &lt;= .45 THEN 0&#13;&#10;ELSEIF [check_core_sku_coverage]  &lt;= .5 THEN 1&#13;&#10;ELSEIF [check_core_sku_coverage]  &lt;= .55 THEN 2&#13;&#10;ELSEIF [check_core_sku_coverage]  &lt;= .6 THEN 3&#13;&#10;ELSEIF [check_core_sku_coverage]  &lt;= .65 THEN 4&#13;&#10;ELSEIF [check_core_sku_coverage]  &lt;= .7 THEN 5&#13;&#10;ELSEIF [check_core_sku_coverage]  &lt;= .75 THEN 6&#13;&#10;ELSEIF [check_core_sku_coverage]  &lt;= .8 THEN 7&#13;&#10;ELSEIF [check_core_sku_coverage]  &lt;= .85 THEN 8&#13;&#10;ELSEIF [check_core_sku_coverage]  &lt;= .9 THEN 9&#13;&#10;ELSE 10 END' />
      </column>
      <column caption='5. Score Ultrafresh GPV Contr' datatype='integer' hidden='true' name='[4. Score L3 Coverage % (copy)_1185854145415168008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1185854145189216256]  &lt;= .05 THEN 0&#13;&#10;ELSEIF [Calculation_1185854145189216256]  &lt;= .08 THEN 1&#13;&#10;ELSEIF [Calculation_1185854145189216256]  &lt;= .1 THEN 2&#13;&#10;ELSEIF [Calculation_1185854145189216256]  &lt;= .13 THEN 3&#13;&#10;ELSEIF [Calculation_1185854145189216256]  &lt;= .15 THEN 4&#13;&#10;ELSEIF [Calculation_1185854145189216256]  &lt;= .175 THEN 5&#13;&#10;ELSEIF [Calculation_1185854145189216256]  &lt;= .2 THEN 6&#13;&#10;ELSEIF [Calculation_1185854145189216256]  &lt;= .225 THEN 7&#13;&#10;ELSEIF [Calculation_1185854145189216256]  &lt;= .25 THEN 8&#13;&#10;ELSEIF [Calculation_1185854145189216256]  &lt;= .275 THEN 9&#13;&#10;ELSE 10 END' />
