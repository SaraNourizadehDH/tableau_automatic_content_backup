        <calculation class='tableau' formula='CASE [Parameters].[X Axis (copy)_1185854145492967437]&#13;&#10;    WHEN &quot;Score&quot; THEN [Calculation_1185854145418219532]&#13;&#10;    WHEN &quot;ABV&quot; THEN ([gbv])/([total_orders])&#13;&#10;    WHEN &quot;Assortment Design Gap L1 p.p.&quot; THEN [perc_design_compliance]&#13;&#10;    WHEN &quot;Avg. Listed SKUs&quot; THEN [avg_listed_skus_check]&#13;&#10;    WHEN &quot;Listed SKUs Target Completion&quot; THEN [perc_listed_target_completion]*100&#13;&#10;    WHEN &quot;CVR&quot; THEN [check_cvr]&#13;&#10;    WHEN &quot;DOH&quot; THEN [check_book_value]*100&#13;&#10;    WHEN &quot;Efficiency %&quot; THEN [check_efficiency]&#13;&#10;    WHEN &quot;Frequency&quot; THEN [Calculation_1185854145204133891]&#13;&#10;    WHEN &quot;Availability %&quot; THEN [check_perc_availability]&#13;&#10;    WHEN &quot;L3 Cat Cover. %&quot; THEN [check_core_sku_coverage]&#13;&#10;    WHEN &quot;Newness %&quot; THEN [check_newness]&#13;&#10;    WHEN &quot;Spoilage %&quot; THEN [check_perc_availability]&#13;&#10;    WHEN &quot;Ultrafresh GPV % contr.&quot; THEN [Calculation_1185854145189216256]&#13;&#10;    WHEN &quot;ABS&quot; THEN ([qty_sold])/([total_orders])&#13;&#10;    WHEN &quot;ODS&quot; THEN [ods]&#13;&#10;    WHEN &quot;Distinct SKUs&quot; THEN [dist_listed_skus]&#13;&#10;    WHEN &quot;MAU Penetration&quot; THEN ([dmart_mau])/([dmart_covered_mau])&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Comp Metric Label' datatype='string' name='[X Axis (copy)_127226694211346432]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Score&quot; THEN &quot;&quot;&#13;&#10;    WHEN &quot;ABV&quot; THEN &quot;&quot;&#13;&#10;    WHEN &quot;Assortment Design Gap L1 p.p.&quot; THEN &quot;&quot;&#13;&#10;    WHEN &quot;Avg. Listed SKUs&quot; THEN &quot;&quot;&#13;&#10;    WHEN &quot;Content Score&quot; THEN &quot;&quot;&#13;&#10;    WHEN &quot;CVR&quot; THEN &quot;%&quot;&#13;&#10;    WHEN &quot;DOH&quot; THEN &quot;%&quot;&#13;&#10;    WHEN &quot;Efficiency %&quot; THEN &quot;%&quot;&#13;&#10;    WHEN &quot;Frequency&quot; THEN &quot;&quot;&#13;&#10;    WHEN &quot;Availability %&quot; THEN &quot;%&quot;&#13;&#10;    WHEN &quot;L3 Cat Cover. %&quot; THEN &quot;%&quot;&#13;&#10;    WHEN &quot;Newness %&quot; THEN &quot;%&quot;&#13;&#10;    WHEN &quot;Spoilage %&quot; THEN &quot;%&quot;&#13;&#10;    WHEN &quot;Ultrafresh GPV % contr.&quot; THEN &quot;%&quot;&#13;&#10;    WHEN &quot;ABS&quot; THEN &quot;&quot;&#13;&#10;    WHEN &quot;ODS&quot; THEN &quot;&quot;&#13;&#10;    WHEN &quot;Distinct SKUs&quot; THEN &quot;&quot;&#13;&#10;    WHEN &quot;MAU Penetration&quot; THEN &quot;%&quot;&#13;&#10;END' />
      </column>
