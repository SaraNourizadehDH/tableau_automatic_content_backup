            <column caption='Efficiency %' datatype='real' name='[check_efficiency]' role='measure' type='quantitative' />
            <column caption='Newness %' datatype='real' name='[check_newness]' role='measure' type='quantitative' />
            <column caption='Weighted Availability %' datatype='real' name='[check_perc_availability]' role='measure' type='quantitative' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
