      <table>
        <view>
          <datasources>
            <datasource caption='assortment_performance_deepdive2' name='federated.0p9e7qv0rwfa4l1bqbcas1kn32n1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Warehouse Maturity' datatype='string' name='[Parameter 2 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;Mature&quot;' value='Mature ( &gt;= 30 Days)' />
                <alias key='&quot;Non Mature&quot;' value='Non Mature ( &lt; 30 Days)' />
              </aliases>
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 3 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
              <aliases>
                <alias key='&quot;LC&quot;' value='Local Currency' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0p9e7qv0rwfa4l1bqbcas1kn32n1'>
            <column caption='Avg Listed SKUs Share' datatype='real' default-format='p0.00%' name='[% Avg Listed SKUs (copy)_2249548068894244866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2522297283988086785]/SUM([Calculation2])' />
            </column>
            <column caption='%Efficiency' datatype='real' name='[% Newness (copy)_1241586136712630283]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([efficient_movers])/SUM([efficiency_denom_not_weighted]))' />
            </column>
            <column caption='% Shrinkage' datatype='real' name='[% Newness (copy)_1241586136713236494]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shrinkage_eur_expired])/SUM([total_price_paid_eur])' />
            </column>
            <column caption='ASP per Cat' datatype='real' name='[ABS (copy)_2522297286715924506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE  [Calculation_2522297286706167826]&#13;&#10;WHEN &apos;L0&apos; &#13;&#10;THEN [ABV_L1 (copy)_2522297286715809816]&#13;&#10;WHEN &apos;L1&apos;&#13;&#10;THEN [Calculation_2522297284285665282]&#13;&#10;WHEN &apos;L2&apos; &#13;&#10;THEN [ABV_L1 (copy)_2522297284309721096]&#13;&#10;END' />
            </column>
            <column caption='Total Orders' datatype='integer' name='[ABS (copy)_2522297286727381025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE  [Calculation_2522297286706167826]&#13;&#10;WHEN &apos;L0&apos; &#13;&#10;THEN SUM([Fixed_OrdersL1 (copy)_2522297286714585109])&#13;&#10;WHEN &apos;L1&apos;&#13;&#10;THEN   SUM( [Calculation_2522297283983908864 2])&#13;&#10;WHEN &apos;L2&apos; &#13;&#10;THEN SUM([totalOrders_L2])&#13;&#10;END' />
            </column>
            <column caption='Basket Penetration' datatype='real' name='[ABS (copy)_2522297286732042276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE  [Calculation_2522297286706167826]&#13;&#10;WHEN &apos;L0&apos; &#13;&#10;THEN [Basket Penetration L1 (copy)_2522297286731927587]&#13;&#10;WHEN &apos;L1&apos;&#13;&#10;THEN [ABS_L1 (copy)_2522297284303474693]&#13;&#10;WHEN &apos;L2&apos; &#13;&#10;THEN [Basket Penetration L1 (copy)_2522297284313559050]&#13;&#10;END' />
            </column>
            <column caption='Customer Penetration' datatype='real' name='[ABS (copy)_2522297286733406248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE  [Calculation_2522297286706167826]&#13;&#10;WHEN &apos;L0&apos; &#13;&#10;THEN [Customer Penetration L1  (copy)_2522297286733275174]&#13;&#10;WHEN &apos;L1&apos;&#13;&#10;THEN [Basket Penetration L1 (copy)_2522297284306083846]&#13;&#10;WHEN &apos;L2&apos; &#13;&#10;THEN [Customer Penetration L1  (copy)_2522297284313907211]&#13;&#10;END' />
            </column>
            <column caption='AQS per Cat' datatype='real' name='[ABS_L0 (copy)_2522297286715002903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE  [Calculation_2522297286706167826]&#13;&#10;WHEN &apos;L0&apos; &#13;&#10;THEN [ABS_L1 (copy)_2522297286714830870]&#13;&#10;WHEN &apos;L1&apos;&#13;&#10;THEN [Calculation_2522297284285665282 1]&#13;&#10;WHEN &apos;L2&apos; &#13;&#10;THEN [ABS_L1 (copy)_2522297284308856839]&#13;&#10;END' />
            </column>
            <column caption='FrequencyIN_L1_Metric1' datatype='real' name='[ABS_L1 (copy)_2522297284300570627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2522297283983908864 2])/SUM([Calculation_2522297283983908864 2 1])' />
            </column>
            <column caption='Basket Penetration L1' datatype='real' name='[ABS_L1 (copy)_2522297284303474693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2522297283983908864 2])/SUM([Calculation_2522297283983908864 2 2])' />
            </column>
            <column caption='ABS_L2' datatype='real' name='[ABS_L1 (copy)_2522297284308856839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qtySold_L2])/SUM([totalOrders_L2])' />
            </column>
            <column caption='ABS_L0' datatype='real' name='[ABS_L1 (copy)_2522297286714830870]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qtySold_L2])/SUM([Fixed_OrdersL1 (copy)_2522297286714585109])' />
            </column>
            <column caption='Avg # other master cats' datatype='real' name='[ABV (copy)_1241586136694317065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE  [Calculation_2522297286706167826]&#13;&#10;WHEN &apos;L0&apos; &#13;&#10;THEN AVG([avg_ql0])&#13;&#10;WHEN &apos;L1&apos;&#13;&#10;THEN AVG([avg_ql1])&#13;&#10;WHEN &apos;L2&apos; &#13;&#10;THEN AVG([avg_ql2])&#13;&#10;END' />
            </column>
            <column caption='ABS' datatype='real' name='[ABV per Cat (copy)_1241586136650235912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE  [Calculation_2522297286706167826]&#13;&#10;WHEN &apos;L0&apos; &#13;&#10;THEN SUM([Fixed Global GMV L0 (copy)_1241586136649891847])/SUM([Fixed_OrdersL1 (copy)_2522297286714585109])&#13;&#10;WHEN &apos;L1&apos;&#13;&#10;THEN SUM([Fixed Global GMV L1 (copy)_1241586136649891846])/SUM([Calculation_2522297283983908864 2])&#13;&#10;WHEN &apos;L2&apos; &#13;&#10;THEN SUM([global_items_L2])/SUM([totalOrders_L2])&#13;&#10;END' />
            </column>
            <column caption='ASP_L2' datatype='real' name='[ABV_L1 (copy)_2522297284309721096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2522297286712328212])/SUM([totalOrders_L2])' />
            </column>
            <column caption='ASP_L0' datatype='real' name='[ABV_L1 (copy)_2522297286715809816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2522297286712328212])/SUM([Fixed_OrdersL1 (copy)_2522297286714585109])' />
            </column>
            <column caption='GPV Share' datatype='real' default-format='p0.00%' name='[Avg Listed SKUs Share (copy)_2249548068916903940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2522297286712328212]/([Fixed Avg Listed SKUs  (copy)_2249548068916641795])' />
            </column>
            <column caption='Customer Penetration L1 ' datatype='real' name='[Basket Penetration L1 (copy)_2522297284306083846]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2522297283983908864 2 1])/SUM([Fixed_OrdersL1 (copy)_2522297284302934020])' />
            </column>
            <column caption='Basket Penetration L2' datatype='real' name='[Basket Penetration L1 (copy)_2522297284313559050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([totalOrders_L2])/SUM([Calculation_2522297283983908864 2 2])' />
            </column>
            <column caption='Basket Penetration L0' datatype='real' name='[Basket Penetration L1 (copy)_2522297286731927587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Fixed_OrdersL1 (copy)_2522297286714585109])/SUM([Fixed_GeneralOrdersL1 (copy)_2522297286731157538])' />
            </column>
            <column caption='Fixed Avg Listed SKUs ' datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [date_month],[global_entity_id]: ([Calculation_2522297283988086785])}' />
            </column>
            <column caption='%Eff. Listings' datatype='real' name='[Calculation_1241586136712318986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([new_efficient_movers])/SUM([sku_listed])' />
            </column>
            <column caption='Fixed_mature_Denom' datatype='integer' name='[Calculation_2522297283983908864 1 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Month]: MAX([mature_denom_listsku])}' />
            </column>
            <column caption='Fixed_nonmature_Denom' datatype='integer' name='[Calculation_2522297283983908864 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Month]: MAX([non_mature_denom_listsku])}' />
            </column>
            <column caption='Fixed_UsersL1' datatype='integer' name='[Calculation_2522297283983908864 2 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Month],[master_category_one]: MAX([totalCustomers_L1])}' />
            </column>
            <column caption='Fixed_GeneralOrdersL1' datatype='integer' name='[Calculation_2522297283983908864 2 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [Month],[master_category_one]: MAX([totalGeneralOrders])}' />
            </column>
            <column caption='Fixed_OrdersL1' datatype='integer' name='[Calculation_2522297283983908864 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Month],[master_category_one]: MAX([totalOrders_L1])}' />
            </column>
            <column caption='Fixed_total_Denom' datatype='real' name='[Calculation_2522297283983908864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Month]: AVG([total_denom_listsku])}' />
            </column>
            <column caption='Listed SKUs' datatype='real' name='[Calculation_2522297283988086785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 1] &#13;&#10;WHEN &quot;Mature&quot; &#13;&#10;THEN SUM([ListedSKU_Mature])/SUM([Calculation_2522297283983908864 1 1])&#13;&#10;WHEN &quot;Non Mature&quot;&#13;&#10;THEN SUM([ListedSKU_NonMature])/SUM([Calculation_2522297283983908864 1])&#13;&#10;ELSE&#13;&#10;SUM([ListedSKU])/SUM([Calculation_2522297283983908864]) END' />
