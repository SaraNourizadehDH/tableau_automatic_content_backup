            <column caption='ODS' datatype='real' name='[ods]' role='measure' type='quantitative' />
            <column caption='L2 Core Category Design %' datatype='real' name='[perc_design_compliance]' role='measure' type='quantitative' />
            <column caption='Listed SKUs Achievement %' datatype='real' name='[perc_listed_target_completion]' role='measure' type='quantitative' />
            <column caption='Qty Sold' datatype='real' name='[qty_sold]' role='measure' type='quantitative' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1185854145493569550]' derivation='Sum' name='[sum:Calculation_1185854145493569550:qk]' pivot='key' type='quantitative' />
            <column caption='Total Orders' datatype='integer' name='[total_orders]' role='measure' type='quantitative' />
