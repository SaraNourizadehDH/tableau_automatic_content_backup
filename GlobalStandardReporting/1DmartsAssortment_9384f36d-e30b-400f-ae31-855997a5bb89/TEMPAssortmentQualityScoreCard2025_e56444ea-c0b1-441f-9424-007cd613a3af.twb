      <table>
        <view>
          <datasources>
            <datasource caption='assortment_quality_scorecard_mtd (rl_dmart)' name='federated.15l6rta1088oux1dx3dar03qh865' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Newness %' caption='X Axis' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Newness \%&quot;'>
              <calculation class='tableau' formula='&quot;Newness %&quot;' />
              <aliases>
                <alias key='&quot;Assortment Design Gap L1 p.p.&quot;' value='L2 Design Compliance' />
                <alias key='&quot;Avg. Listed SKUs&quot;' value='Listed SKUs' />
                <alias key='&quot;DOH&quot;' value='Discontinued Book Value' />
                <alias key='&quot;Listed SKUs Target Completion&quot;' value='Listed SKUs Completion %' />
                <alias key='&quot;Newness \%&quot;' value='Newness %' />
                <alias key='&quot;Ultrafresh GPV \% contr.&quot;' value='Ultrafresh BP %' />
              </aliases>
            </column>
            <column caption='Y Axis' datatype='string' name='[X Axis (copy)_1185854145492967437]' param-domain-type='list' role='measure' type='nominal' value='&quot;ABV&quot;'>
              <calculation class='tableau' formula='&quot;ABV&quot;' />
              <aliases>
                <alias key='&quot;Assortment Design Gap L1 p.p.&quot;' value='L2 Design Compliance' />
                <alias key='&quot;Avg. Listed SKUs&quot;' value='Listed SKUs' />
                <alias key='&quot;DOH&quot;' value='Discontinued Book Value' />
                <alias key='&quot;Listed SKUs Target Completion&quot;' value='Listed SKUs Completion %' />
                <alias key='&quot;Newness \%&quot;' value='Newness %' />
                <alias key='&quot;Ultrafresh GPV \% contr.&quot;' value='Ultrafresh BP %' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15l6rta1088oux1dx3dar03qh865'>
            <column caption='Ultrafresh BP %' datatype='real' name='[Calculation_1185854145189216256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[ultrafresh_bp]' />
            </column>
            <column caption='Frequency' datatype='real' name='[Calculation_1185854145204133891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_orders]/[unique_users]' />
            </column>
            <column caption='Score' datatype='real' name='[Calculation_1185854145418219532]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[final_score]' />
            </column>
            <column caption='X Axis' datatype='real' name='[Calculation_1185854145493569550]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Score&quot; THEN [Calculation_1185854145418219532]&#13;&#10;    WHEN &quot;ABV&quot; THEN ([gbv])/([total_orders])&#13;&#10;    WHEN &quot;Assortment Design Gap L1 p.p.&quot; THEN [perc_design_compliance]&#13;&#10;    WHEN &quot;Avg. Listed SKUs&quot; THEN [avg_listed_skus_check]&#13;&#10;    WHEN &quot;Listed SKUs Target Completion&quot; THEN [perc_listed_target_completion]*100&#13;&#10;    WHEN &quot;CVR&quot; THEN [check_cvr]*100&#13;&#10;    WHEN &quot;DOH&quot; THEN [check_book_value]*100&#13;&#10;    WHEN &quot;Efficiency %&quot; THEN [check_efficiency]*100&#13;&#10;    WHEN &quot;Frequency&quot; THEN [Calculation_1185854145204133891]&#13;&#10;    WHEN &quot;Availability %&quot; THEN [check_perc_availability]*100&#13;&#10;    WHEN &quot;L3 Cat Cover. %&quot; THEN [check_core_sku_coverage]*100&#13;&#10;    WHEN &quot;Newness %&quot; THEN [check_newness]*100&#13;&#10;    WHEN &quot;Spoilage %&quot; THEN [check_perc_availability]*100&#13;&#10;    WHEN &quot;Ultrafresh GPV % contr.&quot; THEN [Calculation_1185854145189216256]*100&#13;&#10;    WHEN &quot;ABS&quot; THEN ([qty_sold])/([total_orders])&#13;&#10;    WHEN &quot;ODS&quot; THEN [ods]&#13;&#10;    WHEN &quot;Distinct SKUs&quot; THEN [dist_listed_skus]&#13;&#10;    WHEN &quot;MAU Penetration&quot; THEN ([dmart_mau])/([dmart_covered_mau])*100&#13;&#10;END' />
            </column>
            <column caption='Granularity2' datatype='string' name='[Calculation_1608629514730786818]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[granularity]' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_238972299405660163]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT([Month],4)+&apos;-&apos; +RIGHT([Month],2)' />
            </column>
            <column caption='Month__' datatype='string' datatype-customized='true' name='[Month]' role='dimension' type='nominal' />
            <column caption='Y Axis' datatype='real' name='[X Axis (copy)_1185854145498325007]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[X Axis (copy)_1185854145492967437]&#13;&#10;    WHEN &quot;Score&quot; THEN [Calculation_1185854145418219532]&#13;&#10;    WHEN &quot;ABV&quot; THEN ([gbv])/([total_orders])&#13;&#10;    WHEN &quot;Assortment Design Gap L1 p.p.&quot; THEN [perc_design_compliance]&#13;&#10;    WHEN &quot;Avg. Listed SKUs&quot; THEN [avg_listed_skus_check]&#13;&#10;    WHEN &quot;Listed SKUs Target Completion&quot; THEN [perc_listed_target_completion]*100&#13;&#10;    WHEN &quot;CVR&quot; THEN [check_cvr]&#13;&#10;    WHEN &quot;DOH&quot; THEN [check_book_value]*100&#13;&#10;    WHEN &quot;Efficiency %&quot; THEN [check_efficiency]&#13;&#10;    WHEN &quot;Frequency&quot; THEN [Calculation_1185854145204133891]&#13;&#10;    WHEN &quot;Availability %&quot; THEN [check_perc_availability]&#13;&#10;    WHEN &quot;L3 Cat Cover. %&quot; THEN [check_core_sku_coverage]&#13;&#10;    WHEN &quot;Newness %&quot; THEN [check_newness]&#13;&#10;    WHEN &quot;Spoilage %&quot; THEN [check_perc_availability]&#13;&#10;    WHEN &quot;Ultrafresh GPV % contr.&quot; THEN [Calculation_1185854145189216256]&#13;&#10;    WHEN &quot;ABS&quot; THEN ([qty_sold])/([total_orders])&#13;&#10;    WHEN &quot;ODS&quot; THEN [ods]&#13;&#10;    WHEN &quot;Distinct SKUs&quot; THEN [dist_listed_skus]&#13;&#10;    WHEN &quot;MAU Penetration&quot; THEN ([dmart_mau])/([dmart_covered_mau])&#13;&#10;&#13;&#10;END' />
            </column>
