    <worksheet name='Final View (2)'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='assortment_performance_deepdive2' name='federated.0p9e7qv0rwfa4l1bqbcas1kn32n1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Warehouse Maturity' datatype='string' name='[Parameter 2 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;Mature&quot;' value='Mature ( &gt;= 30 Days)' />
                <alias key='&quot;Non Mature&quot;' value='Non Mature ( &lt; 30 Days)' />
              </aliases>
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 3 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
              <aliases>
                <alias key='&quot;LC&quot;' value='Local Currency' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0p9e7qv0rwfa4l1bqbcas1kn32n1'>
            <column caption='%Efficiency' datatype='real' name='[% Newness (copy)_1241586136712630283]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([efficient_movers])/SUM([efficiency_denom_not_weighted]))' />
            </column>
            <column caption='% Shrinkage' datatype='real' name='[% Newness (copy)_1241586136713236494]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shrinkage_eur_expired])/SUM([total_price_paid_eur])' />
            </column>
            <column caption='ASP per Cat' datatype='real' name='[ABS (copy)_2522297286715924506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE  [Calculation_2522297286706167826]&#13;&#10;WHEN &apos;L0&apos; &#13;&#10;THEN [ABV_L1 (copy)_2522297286715809816]&#13;&#10;WHEN &apos;L1&apos;&#13;&#10;THEN [Calculation_2522297284285665282]&#13;&#10;WHEN &apos;L2&apos; &#13;&#10;THEN [ABV_L1 (copy)_2522297284309721096]&#13;&#10;END' />
            </column>
            <column caption='Total Orders' datatype='integer' name='[ABS (copy)_2522297286727381025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE  [Calculation_2522297286706167826]&#13;&#10;WHEN &apos;L0&apos; &#13;&#10;THEN SUM([Fixed_OrdersL1 (copy)_2522297286714585109])&#13;&#10;WHEN &apos;L1&apos;&#13;&#10;THEN   SUM( [Calculation_2522297283983908864 2])&#13;&#10;WHEN &apos;L2&apos; &#13;&#10;THEN SUM([totalOrders_L2])&#13;&#10;END' />
