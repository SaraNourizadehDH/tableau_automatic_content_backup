  <worksheets>
    <worksheet name='% Listed SKUs vs % GPV'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>&lt;Sheet Name&gt; (L0 Cat)</run>
            <run fontalignment='1'>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='assortment_performance_deepdive2' name='federated.0p9e7qv0rwfa4l1bqbcas1kn32n1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Warehouse Maturity' datatype='string' name='[Parameter 2 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;Mature&quot;' value='Mature ( &gt;= 30 Days)' />
                <alias key='&quot;Non Mature&quot;' value='Non Mature ( &lt; 30 Days)' />
              </aliases>
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 3 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
              <aliases>
                <alias key='&quot;LC&quot;' value='Local Currency' />
              </aliases>
            </column>
            <column caption='Geographical Aggregation' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0p9e7qv0rwfa4l1bqbcas1kn32n1'>
            <column caption='% GPV from Total' datatype='real' default-format='p0.00%' name='[Calculation3]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2522297286712328212]) / TOTAL(SUM([Calculation_2522297286712328212]))'>
                <table-calc ordering-type='Columns' />
              </calculation>
            </column>
            <column caption='% Listed SKUs' datatype='real' default-format='p0.00%' name='[Calculation4]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2522297283988086785] / TOTAL([Calculation_2522297283988086785])'>
                <table-calc ordering-type='Columns' />
              </calculation>
            </column>
            <column caption='Geo' datatype='string' name='[Calculation_2232378085547450383]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6] WHEN &apos;Country&apos; THEN [global_entity_id]&#13;&#10;ELSE [management_entity] END' />
            </column>
            <column caption='Fixed_mature_Denom' datatype='integer' name='[Calculation_2522297283983908864 1 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Month]: MAX([mature_denom_listsku])}' />
            </column>
            <column caption='Fixed_nonmature_Denom' datatype='integer' name='[Calculation_2522297283983908864 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Month]: MAX([non_mature_denom_listsku])}' />
            </column>
            <column caption='Fixed_total_Denom' datatype='real' name='[Calculation_2522297283983908864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Month]: AVG([total_denom_listsku])}' />
            </column>
            <column caption='Listed SKUs' datatype='real' name='[Calculation_2522297283988086785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 1] &#13;&#10;WHEN &quot;Mature&quot; &#13;&#10;THEN SUM([ListedSKU_Mature])/SUM([Calculation_2522297283983908864 1 1])&#13;&#10;WHEN &quot;Non Mature&quot;&#13;&#10;THEN SUM([ListedSKU_NonMature])/SUM([Calculation_2522297283983908864 1])&#13;&#10;ELSE&#13;&#10;SUM([ListedSKU])/SUM([Calculation_2522297283983908864]) END' />
            </column>
            <column caption='GPV' datatype='real' name='[Calculation_2522297286712328212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3 1]&#13;&#10;WHEN &apos;Euro&apos;&#13;&#10;THEN [total_price_paid_eur]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN [total_price_paid_lc]&#13;&#10;END' />
            </column>
            <column caption='Listed SKU' datatype='integer' name='[ListedSKU]' role='measure' type='quantitative' />
            <column caption='ListedSKU Mature' datatype='integer' name='[ListedSKU_Mature]' role='measure' type='quantitative' />
            <column caption='ListedSKU NonMature' datatype='integer' name='[ListedSKU_NonMature]' role='measure' type='quantitative' />
            <column caption='Month1' datatype='string' name='[Month]' role='dimension' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='L0 Category' datatype='string' name='[master_category_cero]' role='dimension' type='nominal' />
            <column caption='Mature Denom Listsku' datatype='integer' name='[mature_denom_listsku]' role='measure' type='quantitative' />
            <column caption='Non Mature Denom Listsku' datatype='integer' name='[non_mature_denom_listsku]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2232378085547450383]' derivation='None' name='[none:Calculation_2232378085547450383:nk]' pivot='key' type='nominal' />
            <column-instance column='[Month]' derivation='None' name='[none:Month:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[master_category_cero]' derivation='None' name='[none:master_category_cero:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Total Denom Listsku' datatype='integer' name='[total_denom_listsku]' role='measure' type='quantitative' />
            <column caption='Total Price Paid Eur' datatype='real' name='[total_price_paid_eur]' role='measure' type='quantitative' />
            <column caption='Total Price Paid Lc' datatype='real' name='[total_price_paid_lc]' role='measure' type='quantitative' />
            <column-instance column='[Calculation3]' derivation='User' name='[usr:Calculation3:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' />
            </column-instance>
            <column-instance column='[Calculation4]' derivation='User' name='[usr:Calculation4:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' />
            </column-instance>
          </datasource-dependencies>
