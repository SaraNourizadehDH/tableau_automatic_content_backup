    <worksheet name='Assortment Quality Metrics MoM Delta WH View'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='assortment_quality_scorecard_mtd (rl_dmart)' name='federated.15l6rta1088oux1dx3dar03qh865' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.RefreshableParameterRanges.true...source-field='[federated.15l6rta1088oux1dx3dar03qh865].[date_month]' caption='MonthP' datatype='date' default-format='*YYYY-MM' name='[X Axis (copy)]' param-domain-type='range' role='measure' type='quantitative' value='#2024-12-01#'>
              <calculation class='tableau' formula='#2024-12-01#' />
              <range granularity='1' period-type-v2='month' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15l6rta1088oux1dx3dar03qh865'>
            <column caption='Efficiency % MoM' datatype='real' name='[Asst, Design Gap L1 MoM (copy)_2028308713514352643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;,[date_month]) = [Parameters].[X Axis (copy)] &#13;&#10;THEN [check_efficiency] END)&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;SUM(IF DATETRUNC(&apos;month&apos;,[date_month]) = DATEADD(&apos;month&apos;,-1,[Parameters].[X Axis (copy)]) &#13;&#10;THEN [check_efficiency] END))' />
            </column>
            <column caption='L2 Core Cat. Design % MoM' datatype='real' name='[Avg Listed SKUs MoM (copy)_2028308713513172994]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;,[date_month]) = [Parameters].[X Axis (copy)] &#13;&#10;THEN [perc_design_compliance] END)&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;SUM(IF DATETRUNC(&apos;month&apos;,[date_month]) = DATEADD(&apos;month&apos;,-1,[Parameters].[X Axis (copy)]) &#13;&#10;THEN [perc_design_compliance] END))' />
            </column>
            <column caption='Ultrafresh BP %' datatype='real' name='[Calculation_1185854145189216256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[ultrafresh_bp]' />
            </column>
            <column caption='Listed SKUs MoM' datatype='real' name='[Calculation_2981101509400100869]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;,[date_month]) = [Parameters].[X Axis (copy)] THEN [avg_listed_skus_check] END)&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;SUM(IF DATETRUNC(&apos;month&apos;,[date_month]) = DATEADD(&apos;month&apos;,-1,[Parameters].[X Axis (copy)]) THEN [avg_listed_skus_check] END))' />
            </column>
            <column caption='Warehouse Filter' datatype='boolean' name='[Country Filter (copy)_451767341724971010]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[granularity] = &apos;Warehouse&apos;' />
            </column>
            <column caption='GPV_SelectedMonth' datatype='real' name='[Efficiency % MoM (copy)_1608629514669178880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;,[date_month]) = [Parameters].[X Axis (copy)] &#13;&#10;THEN [gbv] END))' />
            </column>
            <column caption='L3 Cat Cover. % MoM' datatype='real' name='[Efficiency % MoM (copy)_2028308713516109828]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;,[date_month]) = [Parameters].[X Axis (copy)] &#13;&#10;THEN [check_core_sku_coverage] END)&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;SUM(IF DATETRUNC(&apos;month&apos;,[date_month]) = DATEADD(&apos;month&apos;,-1,[Parameters].[X Axis (copy)]) &#13;&#10;THEN [check_core_sku_coverage] END))' />
            </column>
            <column caption='Ultrafresh BP % MoM' datatype='real' name='[L3 Cat Cover. % MoM (copy)_2028308713516871685]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;,[date_month]) = [Parameters].[X Axis (copy)] &#13;&#10;THEN [Calculation_1185854145189216256] END)&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;SUM(IF DATETRUNC(&apos;month&apos;,[date_month]) = DATEADD(&apos;month&apos;,-1,[Parameters].[X Axis (copy)]) &#13;&#10;THEN [Calculation_1185854145189216256] END))' />
            </column>
            <column caption='Listed SKUs Target Compl. MoM' datatype='real' name='[Listed SKUs MoM (copy)_2904258814637662208]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;,[date_month]) = [Parameters].[X Axis (copy)] THEN [perc_listed_target_completion] END)&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;SUM(IF DATETRUNC(&apos;month&apos;,[date_month]) = DATEADD(&apos;month&apos;,-1,[Parameters].[X Axis (copy)]) THEN [perc_listed_target_completion] END))' />
