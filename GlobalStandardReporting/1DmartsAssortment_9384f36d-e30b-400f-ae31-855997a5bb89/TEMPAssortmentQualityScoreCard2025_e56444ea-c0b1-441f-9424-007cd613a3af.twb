        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;Metric&apos; THEN&#13;&#10;[check_efficiency]&#13;&#10;WHEN &apos;Score&apos; THEN &#13;&#10;[score_efficiency]&#13;&#10;END' />
      </column>
