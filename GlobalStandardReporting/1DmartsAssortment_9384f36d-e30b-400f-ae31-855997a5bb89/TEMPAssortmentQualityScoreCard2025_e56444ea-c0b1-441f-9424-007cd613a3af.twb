            <column caption='Granularity' datatype='string' name='[granularity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_238972299405660163]' derivation='None' name='[none:Calculation_238972299405660163:nk]' pivot='key' type='nominal' />
