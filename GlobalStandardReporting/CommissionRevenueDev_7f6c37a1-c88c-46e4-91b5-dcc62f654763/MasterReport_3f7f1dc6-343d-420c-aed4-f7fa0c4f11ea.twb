            <column caption='min(1)' datatype='integer' name='[Calculation_2630172558228480089]' role='measure' type='quantitative' user:unnamed='Sheet 1'>
              <calculation class='tableau' formula='min(1)' />
            </column>
            <column caption='Avg Comm Rev per Vendor' datatype='real' name='[Calculation_3286079622900871169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_eur])/SUM([total_vendors])' />
            </column>
            <column caption='Floor Compliance' datatype='real' name='[Calculation_3286079622901592067]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1.00 - SUM([vendors_below_floor])/SUM([total_vendors])' />
            </column>
            <column caption='Acq Comm Rate' datatype='real' name='[Calculation_3286079622902001668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([new_intake_commission_eur])/SUM([new_intake_commission_base_eur])' />
            </column>
            <column caption='Comm Rate' datatype='real' name='[Calculation_3286079622902312965]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUm([commission_eur])/SUM([commission_base_eur])' />
            </column>
            <column caption='AFV' datatype='real' name='[Calculation_3286079622902603782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_base_eur])/SUM([orders])' />
            </column>
            <column caption='Avg Listing Fees' datatype='real' name='[Calculation_3286079622902964231]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_list_fees])/SUM([total_vendors])' />
            </column>
            <column caption='Avg Registration Fees' datatype='real' name='[Calculation_3286079622903377928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_reg_fees_new_intake])/SUM([Acquisitions])' />
            </column>
            <column caption='Avg Order per Ven' datatype='real' name='[Calculation_3286079622903676937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM([total_vendors])' />
            </column>
            <column caption='Registration Fees Compliance' datatype='real' name='[Calculation_3286079622904016906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_vendors_paying_reg_new_intake])/SUM([Acquisitions])' />
            </column>
            <column caption='Listing Fees Compliance' datatype='real' name='[Calculation_3286079622904246283]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_vendors_paying_list])/SUM([total_vendors])' />
            </column>
