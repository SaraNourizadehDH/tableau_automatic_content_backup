            <column caption='Total Portal Engaged Vendors' datatype='integer' name='[Calculation_2676967800380604416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [entity_id], [experiment_group], [created_date]: COUNTD([vendor_code])}' />
            </column>
            <column caption='Rewards Adoption Rate (Test Group)' datatype='real' name='[Calculation_2781817229215862786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Total Rewards Related Events per Vendor (copy)_2676967800383885315]) / MIN([Calculation_2781817229217218564])' />
            </column>
            <column aggregation='Sum' caption='Test Group Size' datatype='integer' name='[Calculation_2781817229217218564]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [entity_id], [experiment_group]: MIN(&#10;            IF [experiment_group] = &apos;control&apos; THEN [control_test_group_size]&#10;            ELSEIF [experiment_group] = &apos;treatment&apos; THEN [treatment_test_group_size]&#10;            END&#10;        )&#10;    }' />
            </column>
            <column caption='Rewards Adoption Rate (Portal Users)' datatype='real' name='[Rewards Adoption Rate (Target Group) (copy)_2781817229218062341]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Total Rewards Related Events per Vendor (copy)_2676967800383885315]) / SUM([Calculation_2676967800380604416])' />
            </column>
            <column caption='Total Rewards Events per Vendor' datatype='integer' name='[Total Rewards Events (copy)_2781817229254479888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [entity_id], [vendor_code], [created_date]: SUM(IF [app_event_name] != &quot;non_rewards_related&quot; THEN [events] END)}' />
            </column>
            <column caption='Total Rewards Engaged Vendors' datatype='integer' name='[Total Rewards Related Events per Vendor (copy)_2676967800383885315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF { FIXED [entity_id], [experiment_group], [created_date]: COUNTD(IF [Total Rewards Events (copy)_2781817229254479888] &gt; 0 THEN [vendor_code] END)} = 0&#10;    THEN NULL&#10;ELSE { FIXED [entity_id], [experiment_group], [created_date]: COUNTD(IF [Total Rewards Events (copy)_2781817229254479888] &gt; 0 THEN [vendor_code] END)}&#10;END' />
            </column>
            <column caption='App Event Name' datatype='string' name='[app_event_name]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Control Test Group Size' datatype='integer' name='[control_test_group_size]' role='dimension' type='ordinal' />
