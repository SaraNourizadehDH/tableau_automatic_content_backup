            <column caption='% Share of Rewards Engaged Vendors' datatype='real' name='[% Share of Rewards Events (copy)_2781817229253373966]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_code])/SUM([Total Rewards Related Events per Vendor (copy)_2676967800383885315])' />
            </column>
            <column caption='Rewards Only' datatype='boolean' name='[Calculation_2781817229256810516]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [app_event_name] = &apos;non_rewards_related&apos; THEN FALSE ELSE TRUE END' />
            </column>
            <column caption='Total Vendors' datatype='integer' name='[Total Events (copy)_2781817229255749650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_code])' />
            </column>
            <column caption='Total Rewards Events per Vendor' datatype='integer' name='[Total Rewards Events (copy)_2781817229254479888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [entity_id], [vendor_code], [created_date]: SUM(IF [app_event_name] != &quot;non_rewards_related&quot; THEN [events] END)}' />
            </column>
            <column caption='Total Rewards Engaged Vendors' datatype='integer' name='[Total Rewards Related Events per Vendor (copy)_2676967800383885315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF { FIXED [entity_id], [experiment_group], [created_date]: COUNTD(IF [Total Rewards Events (copy)_2781817229254479888] &gt; 0 THEN [vendor_code] END)} = 0&#10;    THEN NULL&#10;ELSE { FIXED [entity_id], [experiment_group], [created_date]: COUNTD(IF [Total Rewards Events (copy)_2781817229254479888] &gt; 0 THEN [vendor_code] END)}&#10;END' />
            </column>
