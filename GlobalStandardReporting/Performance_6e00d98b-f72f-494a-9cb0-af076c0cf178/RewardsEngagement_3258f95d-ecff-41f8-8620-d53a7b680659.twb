      <aliases enabled='yes' />
      <column caption='% Share of Rewards Engaged Vendors' datatype='real' name='[% Share of Rewards Events (copy)_2781817229253373966]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_code])/SUM([Total Rewards Related Events per Vendor (copy)_2676967800383885315])' />
      </column>
      <column caption='Total Portal Engaged Vendors' datatype='integer' name='[Calculation_2676967800380604416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [entity_id], [experiment_group], [created_date]: COUNTD([vendor_code])}' />
      </column>
      <column caption='Rewards Adoption Rate (Test Group)' datatype='real' name='[Calculation_2781817229215862786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total Rewards Related Events per Vendor (copy)_2676967800383885315]) / MIN([Calculation_2781817229217218564])' />
      </column>
      <column aggregation='Sum' caption='Test Group Size' datatype='integer' name='[Calculation_2781817229217218564]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [entity_id], [experiment_group]: MIN(&#10;            IF [experiment_group] = &apos;control&apos; THEN [control_test_group_size]&#10;            ELSEIF [experiment_group] = &apos;treatment&apos; THEN [treatment_test_group_size]&#10;            END&#10;        )&#10;    }' />
      </column>
      <column caption='% Share of Rewards Events' datatype='real' name='[Calculation_2781817229249470477]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([events])/SUM([Total Vendors using Portal per Experiment Group (copy)_2676967800382820353])' />
      </column>
      <column caption='Total Events' datatype='integer' name='[Calculation_2781817229255696401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([events])' />
      </column>
      <column caption='Rewards Only' datatype='boolean' name='[Calculation_2781817229256810516]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [app_event_name] = &apos;non_rewards_related&apos; THEN FALSE ELSE TRUE END' />
      </column>
      <column caption='Rewards Event Share (Portal Users)' datatype='real' name='[Rewards Adoption Rate (Portal Users) (copy)_2781817229230264329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total Vendors using Portal per Experiment Group (copy)_2676967800382820353]) / SUM([Total Rewards Events per Vendor (copy)_2781817229229518855])' />
      </column>
      <column caption='Rewards Adoption Rate (Portal Users)' datatype='real' name='[Rewards Adoption Rate (Target Group) (copy)_2781817229218062341]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total Rewards Related Events per Vendor (copy)_2676967800383885315]) / SUM([Calculation_2676967800380604416])' />
      </column>
      <column caption='Total Vendors' datatype='integer' name='[Total Events (copy)_2781817229255749650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_code])' />
      </column>
      <column caption='Total Rewards Engaged Vendors (per Event)' datatype='integer' name='[Total Rewards Engaged Vendors (copy)_2781817229247684619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF { FIXED [entity_id], [experiment_group], [created_date], [app_event_name], [app_event_context_name]: COUNTD(IF [Total Rewards Events (copy)_2781817229254479888] &gt; 0 THEN [vendor_code] END)} = 0&#10;    THEN NULL&#10;ELSE { FIXED [entity_id], [experiment_group], [created_date], [app_event_name], [app_event_context_name]: COUNTD(IF [Total Rewards Events (copy)_2781817229254479888] &gt; 0 THEN [vendor_code] END)}&#10;END' />
      </column>
      <column caption='Total Rewards Events (per Event)' datatype='integer' name='[Total Rewards Events (copy)_2781817229247684620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [entity_id], [created_date], [app_event_name], [app_event_context_name]: SUM(IF [app_event_name] != &quot;non_rewards_related&quot; THEN [events] END)}' />
      </column>
      <column caption='Total Rewards Events per Vendor' datatype='integer' name='[Total Rewards Events (copy)_2781817229254479888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [entity_id], [vendor_code], [created_date]: SUM(IF [app_event_name] != &quot;non_rewards_related&quot; THEN [events] END)}' />
      </column>
      <column caption='Total Portal Events' datatype='integer' name='[Total Rewards Events per Vendor (copy)_2781817229229518855]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [entity_id], [vendor_code], [created_date]: SUM([events])}' />
      </column>
      <column caption='Total Rewards Engaged Vendors' datatype='integer' name='[Total Rewards Related Events per Vendor (copy)_2676967800383885315]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF { FIXED [entity_id], [experiment_group], [created_date]: COUNTD(IF [Total Rewards Events (copy)_2781817229254479888] &gt; 0 THEN [vendor_code] END)} = 0&#10;    THEN NULL&#10;ELSE { FIXED [entity_id], [experiment_group], [created_date]: COUNTD(IF [Total Rewards Events (copy)_2781817229254479888] &gt; 0 THEN [vendor_code] END)}&#10;END' />
      </column>
      <column caption='Total Rewards Events' datatype='integer' name='[Total Vendors using Portal per Experiment Group (copy)_2676967800382820353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [entity_id], [created_date]: SUM(IF [app_event_name] != &quot;non_rewards_related&quot; THEN [events] END)}' />
