    <worksheet name='Vendor KPIs (%)'>
      <table>
        <view>
          <datasources>
            <datasource caption='growth_vendor_tiered_rewards_kpis' name='federated.1oxnf7f0ffpl1c19k0lv41fftkja' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Select Metric' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vendors&quot;'>
              <calculation class='tableau' formula='&quot;Vendors&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1oxnf7f0ffpl1c19k0lv41fftkja'>
            <column caption='Date' datatype='string' name='[Calculation_2344545861120446492]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date]))+&quot;-W&quot;+STR(ISOWEEK([created_date]))&#10;WHEN &quot;Monthly&quot; THEN STR(YEAR([created_date]))+&quot;-M&quot;+STR(MONTH([created_date]))&#10;END' />
            </column>
            <column caption='Menu Content score' datatype='real' name='[Calculation_6229744971994759169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(0.7 * (SUM([total_images]) / SUM([total_description]))) + (0.3 * (SUM([total_description]) / SUM([total_products])))' />
            </column>
            <column caption='Offline Rate' datatype='real' name='[Calculation_6229744971995205635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([offline_duration])/SUM([scheduled_duration])' />
            </column>
            <column caption='Vendor Fail Rate' datatype='real' name='[Calculation_6229744971995840516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rejected_order_count]) / SUM([order_count])' />
            </column>
            <column caption='Customer Contact Rate' datatype='real' name='[Calculation_6229744971995922437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_contacts]) / SUM([order_count])' />
            </column>
            <column caption='Vendor Delay Factor' datatype='real' name='[Calculation_6229744971997241352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR({ FIXED [entity_id], [created_month]: MIN([entity_own_delivery_vendor_delay_contacts_received]) / MIN([entity_delayed_orders_count])})' />
            </column>
            <column caption='Vendor Delay Rate' datatype='real' name='[Calculation_6229744972006047754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([delayed_orders_count]) &#10;+&#10;    (&#10;    MIN(SUM([vendor_delivery_order_delivered]), SUM([vendor_delivery_vendor_delay_contacts])&#10;    *&#10;    [Calculation_6229744971997241352])&#10;    )&#10;)&#10;/&#10;(&#10;SUM([delayed_orders_denominator])&#10;+&#10;(IF SUM([vendor_delivery_vendor_delay_contacts]) &gt; 0 THEN SUM([vendor_delivery_order_delivered]) ELSE 0 END)&#10;)' />
            </column>
            <column caption='% Metric' datatype='real' name='[Metric (copy)_6229744972032499735]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &quot;Offline Rate&quot; THEN [Calculation_6229744971995205635]&#10;    WHEN &quot;Vendor Fail Rate&quot; THEN [Calculation_6229744971995840516]&#10;    WHEN &quot;Customer Contact Rate&quot; THEN [Calculation_6229744971995922437]&#10;    WHEN &quot;Vendor Delay Rate&quot; THEN [Calculation_6229744972006047754]&#10;    WHEN &quot;Menu Content Score&quot; THEN [Calculation_6229744971994759169]&#10;END' />
            </column>
            <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='Created Month' datatype='date' name='[created_month]' role='dimension' type='ordinal' />
            <column caption='Customer Contacts' datatype='integer' name='[customer_contacts]' role='measure' type='quantitative' />
            <column caption='Delayed Orders Count' datatype='integer' name='[delayed_orders_count]' role='measure' type='quantitative' />
            <column caption='Delayed Orders Denominator' datatype='integer' name='[delayed_orders_denominator]' role='measure' type='quantitative' />
            <column caption='Engagement Type' datatype='string' name='[engagement_type]' role='dimension' type='nominal' />
            <column caption='Entity Delayed Orders Count' datatype='integer' name='[entity_delayed_orders_count]' role='measure' type='quantitative' />
            <column caption='Entity Id' datatype='string' name='[entity_id]' role='dimension' type='nominal' />
            <column caption='Entity Own Delivery Vendor Delay Contacts Received' datatype='integer' name='[entity_own_delivery_vendor_delay_contacts_received]' role='measure' type='quantitative' />
            <column caption='Experiment Group' datatype='string' name='[experiment_group]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;control&quot;' value='Control' />
                <alias key='&quot;treatment&quot;' value='Treatment' />
              </aliases>
            </column>
            <column-instance column='[Calculation_2344545861120446492]' derivation='None' name='[none:Calculation_2344545861120446492:nk]' pivot='key' type='nominal' />
            <column-instance column='[created_date]' derivation='None' name='[none:created_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[engagement_type]' derivation='None' name='[none:engagement_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[entity_id]' derivation='None' name='[none:entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[experiment_group]' derivation='None' name='[none:experiment_group:nk]' pivot='key' type='nominal' />
            <column caption='Offline Duration' datatype='integer' name='[offline_duration]' role='measure' type='quantitative' />
            <column caption='Order Count' datatype='integer' name='[order_count]' role='measure' type='quantitative' />
            <column caption='Rejected Order Count' datatype='integer' name='[rejected_order_count]' role='measure' type='quantitative' />
            <column caption='Scheduled Duration' datatype='integer' name='[scheduled_duration]' role='measure' type='quantitative' />
            <column caption='Total Description' datatype='integer' name='[total_description]' role='measure' type='quantitative' />
            <column caption='Total Images' datatype='integer' name='[total_images]' role='measure' type='quantitative' />
            <column caption='Total Products' datatype='integer' name='[total_products]' role='measure' type='quantitative' />
            <column-instance column='[Metric (copy)_6229744972032499735]' derivation='User' name='[usr:Metric (copy)_6229744972032499735:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Delivery Order Delivered' datatype='integer' name='[vendor_delivery_order_delivered]' role='measure' type='quantitative' />
            <column caption='Vendor Delivery Vendor Delay Contacts' datatype='integer' name='[vendor_delivery_vendor_delay_contacts]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='relative-date' column='[federated.1oxnf7f0ffpl1c19k0lv41fftkja].[none:created_date:qk]' filter-group='7' first-period='-2' include-future='true' include-null='false' last-period='0' period-type-v2='week' />
          <filter class='categorical' column='[federated.1oxnf7f0ffpl1c19k0lv41fftkja].[none:engagement_type:nk]'>
            <groupfilter function='union' user:ui-domain='cascading' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:engagement_type:nk]' member='&quot;Engaged&quot;' />
              <groupfilter function='member' level='[none:engagement_type:nk]' member='&quot;Unengaged&quot;' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.1oxnf7f0ffpl1c19k0lv41fftkja].[none:entity_id:nk]' filter-group='8'>
            <groupfilter function='member' level='[none:entity_id:nk]' member='&quot;PY_PY&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1oxnf7f0ffpl1c19k0lv41fftkja].[none:experiment_group:nk]'>
            <groupfilter function='union' user:ui-domain='cascading' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:experiment_group:nk]' member='&quot;control&quot;' />
              <groupfilter function='member' level='[none:experiment_group:nk]' member='&quot;treatment&quot;' />
            </groupfilter>
          </filter>
          <filter class='quantitative' column='[federated.1oxnf7f0ffpl1c19k0lv41fftkja].[usr:Metric (copy)_6229744972032499735:qk]' included-values='non-null' />
          <slices>
            <column>[federated.1oxnf7f0ffpl1c19k0lv41fftkja].[none:created_date:qk]</column>
            <column>[federated.1oxnf7f0ffpl1c19k0lv41fftkja].[none:entity_id:nk]</column>
            <column>[federated.1oxnf7f0ffpl1c19k0lv41fftkja].[none:experiment_group:nk]</column>
