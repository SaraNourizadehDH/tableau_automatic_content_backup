      <aliases enabled='yes' />
      <column caption='% Share of Rewards Events' datatype='real' name='[% Share of Rewards Engaged Vendors (copy)_2344545861040193542]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[All Events (copy)_2344545861039980549]/[Total Vendors using Portal per Experiment Group (copy)_2676967800382820353]' />
      </column>
      <column caption='% Share of Rewards Engaged Users' datatype='real' name='[% Share of Rewards Engaged Vendors (copy)_2344545861062995981]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Vendors in Segment (copy)_2344545861061767180]/[All Rewards Engaged Vendors (copy)_2344545861059596298]' />
      </column>
      <column caption='% Share of Rewards Engaged Vendors' datatype='real' name='[% Share of Rewards Events (copy)_2781817229253373966]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Events (copy)_2781817229255749650]/[Total Rewards Related Events per Vendor (copy)_2676967800383885315]' />
      </column>
      <column caption='Events in Segment' datatype='integer' name='[All Events (copy)_2344545861039980549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([events])' />
      </column>
      <column caption='All Portal Engaged Users' datatype='integer' name='[All Portal Engaged Vendors (copy)_2344545861059596296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([user_id])' />
      </column>
      <column caption='All Rewards Engaged Users' datatype='integer' name='[All Rewards Engaged Vendors (copy)_2344545861059596298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF { FIXED [entity_id], [experiment_group], [created_date]: COUNTD(IF [Total Rewards Events (copy)_2781817229254479888] &gt; 0 THEN [user_id] END)} = 0&#10;        THEN NULL&#10;    ELSE { FIXED [entity_id], [experiment_group], [created_date]: COUNTD(IF [Total Rewards Events (copy)_2781817229254479888] &gt; 0 THEN [user_id] END)}&#10;    END&#10;)' />
      </column>
      <column caption='Total Vendors per User' datatype='integer' name='[Calculation_1900589453711781888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [user_id]: MIN([attached_vendors])}' />
      </column>
      <column caption='Engagement Level' datatype='string' name='[Calculation_2344545861079359503]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='Granularity Generator' datatype='string' name='[Calculation_2344545861117247513]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([app_event_name], &apos;goal&apos;) THEN &quot;Daily&quot;&#10;ElSEIF CONTAINS([app_event_name], &apos;faq&apos;) THEN &quot;Weekly&quot;&#10;ELSEIF CONTAINS([app_event_name], &apos;tier&apos;) THEN &quot;Monthly&quot;&#10;END' />
        <aliases>
          <alias key='&quot;Daily&quot;' value='D' />
          <alias key='&quot;Monthly&quot;' value='M' />
          <alias key='&quot;Weekly&quot;' value='W' />
        </aliases>
      </column>
      <column caption='Date' datatype='string' name='[Calculation_2344545861120446492]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date]))+&quot;-W&quot;+STR(ISOWEEK([created_date]))&#10;WHEN &quot;Monthly&quot; THEN STR(YEAR([created_date]))+&quot;-M&quot;+STR(MONTH([created_date]))&#10;END' />
      </column>
      <column caption='Granularity Colour' datatype='boolean' name='[Calculation_2344545861125414941]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2] = [Calculation_2344545861117247513]' />
      </column>
      <column caption='All Portal Engaged Vendors' datatype='integer' name='[Calculation_2676967800380604416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1900589453711781888])' />
      </column>
      <column caption='Test Group Size' datatype='real' name='[Calculation_2781817229217218564]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='AVG(&#10;{ FIXED [entity_id], [experiment_group]: MIN(&#10;            IF [experiment_group] = &apos;control&apos; THEN [control_test_group_size]&#10;            ELSEIF [experiment_group] = &apos;treatment&apos; THEN [treatment_test_group_size]&#10;            END&#10;        )&#10;}&#10;)' />
      </column>
      <column caption='All Portal Events' datatype='integer' name='[Calculation_2781817229255696401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([events])' />
      </column>
      <column caption='Rewards Only' datatype='boolean' name='[Calculation_2781817229256810516]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [app_event_name] = &apos;non_rewards_related&apos; THEN FALSE ELSE TRUE END' />
      </column>
      <column caption='Attached Vendors per User' datatype='real' name='[Calculation_4258505331832287232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [entity_id], [user_id]: AVG([attached_vendors])}' />
      </column>
      <column caption='_user_entitlement' datatype='boolean' name='[Calculation_5760103973025574912]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Interaction Level' datatype='string' name='[Engagement Level (copy)_2344545861093085203]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Engagement Level (copy)_2344545861091479570]' />
      </column>
      <column caption='Rewards Event Share' datatype='real' name='[Rewards Adoption Rate (Portal Users) (copy)_2781817229230264329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Vendors using Portal per Experiment Group (copy)_2676967800382820353] / [Total Rewards Events per Vendor (copy)_2781817229229518855]' />
      </column>
      <column caption='Rewards Adoption Rate (Vendors)' datatype='real' name='[Rewards Adoption Rate (Target Group) (copy)_2781817229218062341]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Rewards Related Events per Vendor (copy)_2676967800383885315] / [Calculation_2676967800380604416]' />
      </column>
      <column caption='Rewards Adoption Rate (Users)' datatype='real' name='[Rewards Adoption Rate (Vendors) (copy)_2344545861059596297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[All Rewards Engaged Vendors (copy)_2344545861059596298] / [All Portal Engaged Vendors (copy)_2344545861059596296]' />
      </column>
      <column caption='Vendors in Segment' datatype='integer' name='[Total Events (copy)_2781817229255749650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1900589453711781888])' />
      </column>
      <column caption='Total Rewards Events per User' datatype='integer' name='[Total Rewards Events (copy)_2781817229254479888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [entity_id], [user_id], [created_date]: SUM(IF [app_event_name] != &quot;non_rewards_related&quot; THEN [events] END)}' />
      </column>
      <column caption='Total Portal Events' datatype='integer' name='[Total Rewards Events per Vendor (copy)_2781817229229518855]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ FIXED [entity_id], [user_id], [created_date]: SUM([events])})' />
