            </column>
            <column caption='Total Rewards Events per User' datatype='integer' name='[Total Rewards Events (copy)_2781817229254479888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [entity_id], [user_id], [created_date]: SUM(IF [app_event_name] != &quot;non_rewards_related&quot; THEN [events] END)}' />
            </column>
            <column caption='All Rewards Engaged Vendors' datatype='integer' name='[Total Rewards Related Events per Vendor (copy)_2676967800383885315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF { FIXED [entity_id], [experiment_group], [created_date]: SUM(IF [Total Rewards Events (copy)_2781817229254479888] &gt; 0 THEN [Calculation_1900589453711781888] END)} = 0&#10;        THEN NULL&#10;    ELSE { FIXED [entity_id], [experiment_group], [created_date]: SUM(IF [Total Rewards Events (copy)_2781817229254479888] &gt; 0 THEN [Calculation_1900589453711781888] END)}&#10;    END&#10;)' />
