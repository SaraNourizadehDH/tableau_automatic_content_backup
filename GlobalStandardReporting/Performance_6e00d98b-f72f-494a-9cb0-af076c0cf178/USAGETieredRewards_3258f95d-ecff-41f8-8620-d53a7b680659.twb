    <worksheet name='Engagement: Events'>
      <table>
        <view>
          <datasources>
            <datasource caption='growth_vendor_tiered_rewards_engagement' name='federated.03xqotj1etxqj518ocyvl0n4n3lx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Engagement Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Events&quot;'>
              <calculation class='tableau' formula='&quot;Events&quot;' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03xqotj1etxqj518ocyvl0n4n3lx'>
            <column caption='Engagement Level' datatype='string' name='[Calculation_2344545861079359503]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_2344545861120446492]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date]))+&quot;-W&quot;+STR(ISOWEEK([created_date]))&#10;WHEN &quot;Monthly&quot; THEN STR(YEAR([created_date]))+&quot;-M&quot;+STR(MONTH([created_date]))&#10;END' />
            </column>
            <column caption='All Portal Events' datatype='integer' name='[Calculation_2781817229255696401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([events])' />
            </column>
            <column caption='Rewards Event Share' datatype='real' name='[Rewards Adoption Rate (Portal Users) (copy)_2781817229230264329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Vendors using Portal per Experiment Group (copy)_2676967800382820353] / [Total Rewards Events per Vendor (copy)_2781817229229518855]' />
            </column>
            <column caption='Total Portal Events' datatype='integer' name='[Total Rewards Events per Vendor (copy)_2781817229229518855]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [entity_id], [user_id], [created_date]: SUM([events])})' />
            </column>
            <column caption='All Rewards Events' datatype='integer' name='[Total Vendors using Portal per Experiment Group (copy)_2676967800382820353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [entity_id], [created_date]: SUM(IF [app_event_name] != &quot;non_rewards_related&quot; THEN [events] END)})' />
            </column>
            <column caption='App Event Name' datatype='string' name='[app_event_name]' role='dimension' type='nominal' />
            <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='Entity Id' datatype='string' name='[entity_id]' role='dimension' type='nominal' />
            <column caption='Events' datatype='integer' name='[events]' role='measure' type='quantitative' />
            <column caption='Experiment Group' datatype='string' name='[experiment_group]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2344545861079359503]' derivation='None' name='[none:Calculation_2344545861079359503:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2344545861120446492]' derivation='None' name='[none:Calculation_2344545861120446492:nk]' pivot='key' type='nominal' />
