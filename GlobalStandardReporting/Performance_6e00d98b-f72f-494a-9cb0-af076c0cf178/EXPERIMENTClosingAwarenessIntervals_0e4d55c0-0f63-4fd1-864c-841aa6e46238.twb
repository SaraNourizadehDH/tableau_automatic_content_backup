        <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [offline_duration] END)&#10;    /&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [daily_schedule_duration] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [offline_duration] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [daily_schedule_duration] END)&#10;    })&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [offline_duration] END)&#10;    /&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [daily_schedule_duration] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [offline_duration] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [daily_schedule_duration] END)&#10;    })&#10;)' />
      </column>
      <column caption='Post ∆ - Pre ∆ Tag' datatype='string' name='[Calculation_337277410518667266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Post ∆ - Pre ∆&quot;' />
      </column>
      <column caption='Timespan' datatype='boolean' name='[Calculation_396387155265060867]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_418201462836531203] != &quot;N/A&quot; OR [Calculation_418201462828920833] != &quot;N/A&quot; THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Analysis Timespan (Pre-Rollout)' datatype='string' name='[Calculation_418201462828920833]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [experiment_name] = &apos;APAC-TH|SG|PK|HK&apos; AND [created_date] &gt;= DATE(&apos;2024-12-23&apos;) AND [created_date] &lt;= DATE(&apos;2025-01-12&apos;) THEN &quot;2024W52-2025W02&quot;&#10;ELSEIF [experiment_name] = &apos;MENA-SA&apos; AND [created_date] &gt;= DATE(&apos;2024-12-23&apos;) AND [created_date] &lt;= DATE(&apos;2025-01-12&apos;) THEN &quot;2024W52-2025W02&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
      </column>
      <column caption='Analysis Timespan (Post-Rollout)' datatype='string' name='[Calculation_418201462836531203]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [experiment_name] = &apos;APAC-TH|SG|PK|HK&apos; AND [created_date] &gt;= DATE(&apos;2025-01-20&apos;) AND [created_date] &lt;= DATE(&apos;2025-02-16&apos;) THEN &quot;2025W04-2025W07&quot;&#10;ELSEIF [experiment_name] = &apos;MENA-SA&apos; AND [created_date] &gt;= DATE(&apos;2025-01-20&apos;) AND [created_date] &lt;= DATE(&apos;2025-02-16&apos;) THEN &quot;2025W04-2025W07&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
      </column>
      <column caption='Rollout Phase' datatype='string' name='[Calculation_4848195386618671104]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_418201462836531203] = &apos;N/A&apos; THEN &quot;Pre&quot;&#10;ELSEIF [Calculation_418201462828920833] = &apos;N/A&apos; THEN &quot;Post&quot;&#10;END' />
      </column>
      <column caption='Offline Duration %' datatype='real' name='[Calculation_4848195386620149761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([offline_duration])/SUM([daily_schedule_duration])' />
      </column>
      <column caption='Monitor Offline Duration %' datatype='real' name='[Calculation_4848195386620248066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([monitor_rule_offline_duration])/SUM([daily_schedule_duration])' />
      </column>
      <column caption='Vendor Fail Rate' datatype='real' name='[Calculation_4848195386620370947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
      </column>
      <column caption='Variant' datatype='boolean' name='[Calculation_4848195386621218820]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = [experiment_group]&#10;OR [experiment_group] = &quot;Baseline&quot;' />
      </column>
      <column caption='Delta Phase' datatype='string' name='[Calculation_4848195386623766534]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4848195386618671104] = &quot;Post&quot; THEN &quot;Post ∆ (&quot; + [Parameters].[Parameter 1] + &quot; - Baseline)&quot;&#10;ELSEIF [Calculation_4848195386618671104] = &quot;Pre&quot; THEN &quot;Pre ∆ (&quot; + [Parameters].[Parameter 1] + &quot; - Baseline)&quot;&#10;END' />
      </column>
      <column caption='Days Till/Since Rollout' datatype='integer' name='[Calculation_485825823130701828]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [rollout_date], [created_date])' />
      </column>
      <column caption='_user_entitlement' datatype='boolean' name='[Calculation_693061775433273344]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Parameters' datatype='string' name='[Calculation_693061775434362881]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [experiment_group]&#10;WHEN &quot;Baseline&quot; THEN &quot;Enabled, Sound Frequency = 180 seconds, Overlay Frequency = 15 minutes&quot;&#10;WHEN &quot;Variant A&quot; THEN &quot;Enabled, Sound Frequency = 60 seconds, Overlay Frequency = 15 minutes&quot;&#10;WHEN &quot;Variant B&quot; THEN &quot;Enabled, Sound Frequency = 180 seconds, Overlay Frequency = 1 minutes&quot;&#10;WHEN &quot;Variant C&quot; THEN &quot;Enabled, Sound Frequency = 60 seconds, Overlay Frequency = 1 minutes&quot;&#10;END' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_693061775437230082]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date]))+&quot;-W&quot;+STR(ISOWEEK([created_date]))&#10;END' />
      </column>
      <column caption='% Metric Numerator' datatype='integer' name='[Calculation_693061775494160390]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;Offline %&quot; THEN [offline_duration]&#10;WHEN &quot;Client Offline %&quot; THEN [client_offline_duration]&#10;WHEN &quot;Client Offline % (excl. Check In Required and Special Days)&quot; THEN [client_offline_duration_excluding_special_day_and_checkin]&#10;WHEN &quot;Area Disruption Offline %&quot; THEN [area_disruption_offline_duration]&#10;WHEN &quot;Bad Weather Offline %&quot; THEN [bad_weather_offline_duration]&#10;WHEN &quot;Check In Failed Offline %&quot; THEN [check_in_failed_offline_duration]&#10;WHEN &quot;Check In Required Offline %&quot; THEN [check_in_required_offline_duration]&#10;WHEN &quot;Closed Offline %&quot; THEN [closed_offline_duration]&#10;WHEN &quot;Compliance Issues Offline %&quot; THEN [compliance_issues_offline_duration]&#10;WHEN &quot;Courier Delayed At Pickup Offline %&quot; THEN [courier_delayed_at_pickup_offline_duration]&#10;WHEN &quot;Holiday Special Day Offline %&quot; THEN [holiday_special_day_offline_duration]&#10;WHEN &quot;Offboarding Offline %&quot; THEN [offboarding_offline_duration]&#10;WHEN &quot;Onboarding Offline %&quot; THEN [onboarding_offline_duration]&#10;WHEN &quot;Other Offline %&quot; THEN [other_offline_duration]&#10;WHEN &quot;Ownership Change Offline %&quot; THEN [ownership_change_offline_duration]&#10;WHEN &quot;Refurbishment Offline %&quot; THEN [refurbishment_offline_duration]&#10;WHEN &quot;Restricted Visibility Offline %&quot; THEN [restricted_visibility_offline_duration]&#10;WHEN &quot;Retention Offline %&quot; THEN [retention_offline_duration]&#10;WHEN &quot;Special Day Offline %&quot; THEN [special_day_offline_duration]&#10;WHEN &quot;Technical Problem Offline %&quot; THEN [technical_problem_offline_duration]&#10;WHEN &quot;Too Busy Kitchen Offline %&quot; THEN [too_busy_kitchen_offline_duration]&#10;WHEN &quot;Too Busy No Drivers Offline %&quot; THEN [too_busy_no_drivers_offline_duration]&#10;WHEN &quot;Too Many Rejected Orders Offline %&quot; THEN [too_many_rejected_orders_offline_duration]&#10;WHEN &quot;Unreachable Offline %&quot; THEN [unreachable_offline_duration]&#10;WHEN &quot;Updates In Menu Offline %&quot; THEN [updates_in_menu_offline_duration]&#10;WHEN &quot;Monitor Rule Offline %&quot; THEN [monitor_rule_offline_duration]&#10;WHEN &quot;Availability Monitor Rule Offline %&quot; THEN [availability_monitor_rule_offline_duration]&#10;WHEN &quot;Order Failure Monitor Rule Offline %&quot; THEN [order_failure_monitor_rule_offline_duration]&#10;WHEN &quot;Order Failure Realtime Monitor Rule Offline %&quot; THEN [order_failure_realtime_monitor_rule_offline_duration]&#10;WHEN &quot;Unreachable Monitor Rule Offline %&quot; THEN [unreachable_monitor_rule_offline_duration]&#10;WHEN &quot;Vendor Late Realtime Monitor Rule Offline %&quot; THEN [vendor_late_realtime_monitor_rule_offline_duration]&#10;WHEN &quot;Null Monitor Rule Offline %&quot; THEN [null_monitor_rule_offline_duration]&#10;WHEN &quot;Vendor Fail Rate %&quot; THEN [vendor_failed_orders]&#10;WHEN &quot;Closed Vendor Fail Rate %&quot; THEN [closed_vendor_failed_orders]&#10;WHEN &quot;No Response Vendor Fail Rate %&quot; THEN [no_response_vendor_failed_orders]&#10;WHEN &quot;Unreachable Vendor Fail Rate %&quot; THEN [unreachable_vendor_failed_orders]&#10;END' />
      </column>
      <column caption='% Metric Denominator' datatype='real' name='[Calculation_693061775494680583]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Client Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Client Offline % (excl. Check In Required and Special Days)&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Area Disruption Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Bad Weather Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Check In Failed Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Check In Required Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Closed Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Compliance Issues Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Courier Delayed At Pickup Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Holiday Special Day Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Offboarding Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Onboarding Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Other Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Ownership Change Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Refurbishment Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Restricted Visibility Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Retention Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Special Day Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Technical Problem Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Too Busy Kitchen Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Too Busy No Drivers Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Too Many Rejected Orders Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Unreachable Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Updates In Menu Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Monitor Rule Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Availability Monitor Rule Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Order Failure Monitor Rule Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Order Failure Realtime Monitor Rule Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Unreachable Monitor Rule Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Vendor Late Realtime Monitor Rule Offline %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Vendor Fail Rate %&quot; THEN [orders]&#10;WHEN &quot;Closed Vendor Fail Rate %&quot; THEN [orders]&#10;WHEN &quot;No Response Vendor Fail Rate %&quot; THEN [orders]&#10;WHEN &quot;Unreachable Vendor Fail Rate %&quot; THEN [orders]&#10;END' />
