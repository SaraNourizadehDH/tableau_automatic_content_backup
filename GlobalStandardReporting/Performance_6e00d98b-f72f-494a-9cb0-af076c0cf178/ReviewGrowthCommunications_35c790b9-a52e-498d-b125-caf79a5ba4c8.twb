            </column>
            <column caption='Dimension A' datatype='string' name='[Calculation_3134364618425950223]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Inbox Table Dimension A (copy)_3134364618424266765]&#10;    WHEN &apos;Region&apos; THEN [region]&#10;    WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;    WHEN &apos;Country&apos; THEN [country_iso]&#10;    WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;    WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;    WHEN &apos;Platform&apos; THEN [platform]&#10;    WHEN &apos;Channel&apos; THEN [channel]&#10;    WHEN &apos;Template Name&apos; THEN [template_name]&#10;END' />
            </column>
            <column caption='Time Period' datatype='boolean' name='[Calculation_3134364618429489170]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_granularity]=&apos;Daily&apos; and str([Parameters].[Parameter 21]) = &apos;1&apos;&#10;  THEN TRUE&#10;ELSEIF [date_granularity]=&apos;Weekly&apos; and str([Parameters].[Parameter 21]) = &apos;2&apos;&#10; THEN TRUE&#10;ELSEIF [date_granularity]=&apos;Monthly&apos; and str([Parameters].[Parameter 21]) = &apos;3&apos;&#10; THEN TRUE &#10;ELSE FALSE &#10;END' />
            </column>
            <column caption='Dimension B' datatype='string' name='[Dimension A (copy)_3134364618426470416]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Messages Table Dimension A (copy)_3134364618426609681]&#10;    WHEN &apos;Region&apos; THEN [region]&#10;    WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;    WHEN &apos;Country&apos; THEN [country_iso]&#10;    WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;    WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;    WHEN &apos;Platform&apos; THEN [platform]&#10;    WHEN &apos;Channel&apos; THEN [channel]&#10;    WHEN &apos;Template Name&apos; THEN [template_name]&#10;    WHEN &apos;Campaign Name&apos; THEN [campaign_name]&#10;    WHEN &apos;ALL&apos; THEN &apos;ALL&apos;&#10;END' />
            </column>
            <column caption='Messages X-Axis Date' datatype='string' name='[Messages X-Axis (copy)_3134364618423922700]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([created_date]))+ &quot;/&quot;&#10;+ (IF MONTH([created_date])&lt;10 THEN &quot;0&quot;+STR(MONTH([created_date])) ELSE STR(MONTH([created_date])) END) + &quot;/&quot;&#10;+(IF DAY([created_date])&lt;10 THEN &quot;0&quot;+STR(DAY([created_date])) ELSE STR(DAY([created_date])) END)' />
            </column>
