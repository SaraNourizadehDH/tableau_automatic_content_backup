            <datasource caption='growth_communications (rl_vendor)' name='federated.1r5aol91nafqnh13jexnj17me8n1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Inbox X-Axis Param v2' datatype='string' name='[Inbox X-Axis Param (copy)_2256092353880391682]' param-domain-type='list' role='measure' type='nominal' value='&quot;By Time&quot;'>
              <calculation class='tableau' formula='&quot;By Time&quot;' />
            </column>
            <column caption='Inbox Color Param v2' datatype='string' name='[Inbox X-Axis Param v2 (copy)_3134364618420658186]' param-domain-type='list' role='measure' type='nominal' value='&quot;By Platform&quot;'>
              <calculation class='tableau' formula='&quot;By Platform&quot;' />
            </column>
            <column alias='Day' caption='Select Time Granularity' datatype='integer' name='[Parameter 21]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Day' />
                <alias key='2' value='Week' />
                <alias key='3' value='Month' />
              </aliases>
            </column>
            <column alias='# Messages Sent' caption='Y-Left Metric Parameter v2' datatype='string' name='[Y-Left Metric Parameter (copy)_3134364618406215682]' param-domain-type='list' role='measure' type='nominal' value='&quot;Messages Sent&quot;'>
              <calculation class='tableau' formula='&quot;Messages Sent&quot;' />
              <aliases>
                <alias key='&quot;Messages Sent&quot;' value='# Messages Sent' />
                <alias key='&quot;Users Sent&quot;' value='# Users Sent' />
                <alias key='&quot;Vendors Sent&quot;' value='# Vendors Sent' />
              </aliases>
            </column>
            <column alias='% Read Rate' caption='Y-Right Metric Parameter v2' datatype='string' name='[Y-Left Metric Parameter v2 (copy)_3134364618407395334]' param-domain-type='list' role='measure' type='nominal' value='&quot;Read Rate&quot;'>
              <calculation class='tableau' formula='&quot;Read Rate&quot;' />
              <aliases>
                <alias key='&quot;Click Rate&quot;' value='% Click Rate' />
                <alias key='&quot;Read Rate&quot;' value='% Read Rate' />
                <alias key='&quot;Read Rate 12hr&quot;' value='% Read Rate 12hr' />
                <alias key='&quot;Seconds To Read&quot;' value='# Seconds To Read' />
                <alias key='&quot;Seconds To Read 12hr&quot;' value='# Seconds To Read 12hr' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1r5aol91nafqnh13jexnj17me8n1'>
            <column caption='Messages X-Axis' datatype='string' name='[Calculation_3134364618405507072]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Inbox X-Axis Param (copy)_2256092353880391682]&#10;  WHEN &apos;By Time&apos;&#10;    THEN &#10;STR(YEAR([created_date]))+ &quot;/&quot;&#10;+ (IF MONTH([created_date])&lt;10 THEN &quot;0&quot;+STR(MONTH([created_date])) ELSE STR(MONTH([created_date])) END) + &quot;/&quot;&#10;+(IF DAY([created_date])&lt;10 THEN &quot;0&quot;+STR(DAY([created_date])) ELSE STR(DAY([created_date])) END)&#10;&#10;  WHEN &apos;By Platform&apos;&#10;    THEN [platform]&#10;  WHEN &apos;By Template Name&apos;&#10;    THEN [template_name]&#10;END' />
            </column>
            <column caption='Y-Left Metric' datatype='integer' name='[Calculation_3134364618406957061]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Y-Left Metric Parameter (copy)_3134364618406215682]&#10;  WHEN &apos;Messages Sent&apos;&#10;    THEN [messages_sent]&#10;  WHEN &apos;Vendors Sent&apos;&#10;    THEN [messages_sent_vendors]&#10;  WHEN &apos;Users Sent&apos;&#10;    THEN [messages_sent_users]&#10;END' />
            </column>
            <column caption='Time Period' datatype='boolean' name='[Calculation_3134364618429489170]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_granularity]=&apos;Daily&apos; and str([Parameters].[Parameter 21]) = &apos;1&apos;&#10;  THEN TRUE&#10;ELSEIF [date_granularity]=&apos;Weekly&apos; and str([Parameters].[Parameter 21]) = &apos;2&apos;&#10; THEN TRUE&#10;ELSEIF [date_granularity]=&apos;Monthly&apos; and str([Parameters].[Parameter 21]) = &apos;3&apos;&#10; THEN TRUE &#10;ELSE FALSE &#10;END' />
            </column>
            <column caption='Messages Color Axis' datatype='string' name='[Messages X-Axis (copy)_3134364618420822027]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Inbox X-Axis Param v2 (copy)_3134364618420658186]&#10;  WHEN &apos;By Channel&apos; &#10;    THEN [channel]&#10;  WHEN &apos;By Platform&apos;&#10;    THEN [platform]&#10;  WHEN &apos;By Campaign Name&apos;&#10;    THEN [campaign_name]&#10;  WHEN &apos;ALL&apos;&#10;    THEN &apos;ALL&apos;&#10;END' />
            </column>
            <column caption='Y-Right Metric' datatype='real' name='[Y-Left Metric (copy)_3134364618408329223]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(CASE [Parameters].[Y-Left Metric Parameter v2 (copy)_3134364618407395334]&#10;  WHEN &apos;Read Rate 12hr&apos;&#10;    THEN (CASE [Parameters].[Y-Left Metric Parameter (copy)_3134364618406215682]&#10;            WHEN &apos;Messages Sent&apos; THEN SUM([messages_read_12hr])/ SUM([Calculation_3134364618406957061])&#10;            WHEN &apos;Vendors Sent&apos; THEN  SUM([messages_read_12hr_vendors])/ SUM([Calculation_3134364618406957061])&#10;            WHEN &apos;Users Sent&apos; THEN  SUM([messages_read_12hr_users])/ SUM([Calculation_3134364618406957061])&#10;           END&#10;         )&#10;  WHEN &apos;Read Rate&apos;&#10;    THEN (CASE [Parameters].[Y-Left Metric Parameter (copy)_3134364618406215682]&#10;            WHEN &apos;Messages Sent&apos; THEN  SUM([messages_read])/ SUM([Calculation_3134364618406957061])&#10;            WHEN &apos;Vendors Sent&apos; THEN  SUM([messages_read_vendors])/ SUM([Calculation_3134364618406957061])&#10;            WHEN &apos;Users Sent&apos; THEN  SUM([messages_read_users])/ SUM([Calculation_3134364618406957061])&#10;           END&#10;         )&#10;  WHEN &apos;Seconds To Read 12hr&apos;&#10;    THEN  SUM([messages_read_12hr_seconds_to_read]) /  SUM([messages_sent])&#10;  WHEN &apos;Seconds To Read&apos;&#10;    THEN  SUM([messages_read_seconds_to_read]) /  SUM([messages_sent])&#10;  WHEN &apos;Click Rate&apos;&#10;    THEN (CASE [Parameters].[Y-Left Metric Parameter (copy)_3134364618406215682]&#10;            WHEN &apos;Messages Sent&apos; THEN  SUM([messages_clicked])/ SUM([Calculation_3134364618406957061])&#10;            WHEN &apos;Vendors Sent&apos; THEN  SUM([messages_clicked_vendors])/ SUM([Calculation_3134364618406957061])&#10;            WHEN &apos;Users Sent&apos; THEN  SUM([messages_clicked_users])/ SUM([Calculation_3134364618406957061])&#10;           END&#10;         )&#10;&#10;END)' />
            </column>
