              <calculation class='tableau' formula='STR(YEAR([created_date]))+ &quot;/&quot;&#10;+ (IF MONTH([created_date])&lt;10 THEN &quot;0&quot;+STR(MONTH([created_date])) ELSE STR(MONTH([created_date])) END) + &quot;/&quot;&#10;+(IF DAY([created_date])&lt;10 THEN &quot;0&quot;+STR(DAY([created_date])) ELSE STR(DAY([created_date])) END)' />
            </column>
            <column caption='SUM([perimeterx_challenge_solved_cnt])/SUM(iif([is_perimeterx...' datatype='real' name='[Calculation_5480247456843599876]' role='measure' type='quantitative' user:unnamed='Orders - Vendor Funnel Abs CNT (2)'>
              <calculation class='tableau' formula='SUM([perimeterx_challenge_solved_cnt])/SUM(iif([is_perimeterx_challenge_solved_today], [vendors_cnt],NULL))' />
