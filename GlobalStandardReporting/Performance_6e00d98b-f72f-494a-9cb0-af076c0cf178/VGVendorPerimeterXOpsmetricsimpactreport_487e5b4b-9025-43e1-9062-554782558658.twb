      <aliases enabled='yes' />
      <column caption=' AVG orders - perimeterx blocked today' datatype='real' name='[ AVG orders (copy)_3003760241954816004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IIF([perimeterx_request_blocked_cnt_today]&gt;0, orders, NULL))' />
      </column>
      <column caption='% Vendor Fail Rate' datatype='real' name='[% Failed Orders  (copy)_5108700487264792577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] != &apos;completed&apos; and [is_cancelled_by_vendor] THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0pbui4m00qjk6g14z9jr2144e9un].[sum:perimeterx_challenge_cancelled_cnt:qk]&quot;' value='Cancelled Block Requests - PerimeterX' />
          <alias key='&quot;[federated.0pbui4m00qjk6g14z9jr2144e9un].[sum:perimeterx_challenge_solved_cnt:qk]&quot;' value='Solved Blocked Requests - PerimeterX' />
          <alias key='&quot;[federated.0pbui4m00qjk6g14z9jr2144e9un].[sum:perimeterx_request_blocked_cnt:qk]&quot;' value='Blocked Requests - PerimeterX' />
          <alias key='&quot;[federated.0pbui4m00qjk6g14z9jr2144e9un].[usr:Calculation_5480247456843218945:qk]&quot;' value='AVG - Blocked Events Per Blocked Vendor' />
          <alias key='&quot;[federated.0pbui4m00qjk6g14z9jr2144e9un].[usr:Calculation_5480247456843403267:qk]&quot;' value='AVG - Cancelled Events Per Cancelled Vendor' />
          <alias key='&quot;[federated.0pbui4m00qjk6g14z9jr2144e9un].[usr:Calculation_5480247456843599876:qk]&quot;' value='AVG - Solved Events Per Solved Vendor ' />
          <alias key='&quot;[federated.0pbui4m00qjk6g14z9jr2144e9un].[usr:Calculation_5480247456844292101:qk]&quot;' value='Vendors with Blocked Requests - PerimeterX' />
          <alias key='&quot;[federated.0pbui4m00qjk6g14z9jr2144e9un].[usr:Calculation_5480247456844328966:qk]&quot;' value='Vendors with Cancelled Block Requests - PerimeterX' />
          <alias key='&quot;[federated.0pbui4m00qjk6g14z9jr2144e9un].[usr:Calculation_5480247456844361735:qk]&quot;' value='Vendors with Solved Block Requests - PerimeterX' />
        </aliases>
      </column>
      <column caption=' AVG orders' datatype='real' name='[Calculation_3003760241954676739]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg([orders])' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_3169971215731462144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([created_date]))+ &quot;/&quot;&#10;+ (IF MONTH([created_date])&lt;10 THEN &quot;0&quot;+STR(MONTH([created_date])) ELSE STR(MONTH([created_date])) END) + &quot;/&quot;&#10;+(IF DAY([created_date])&lt;10 THEN &quot;0&quot;+STR(DAY([created_date])) ELSE STR(DAY([created_date])) END)' />
      </column>
      <column caption='% Overall Fail Rate' datatype='real' name='[Calculation_336151517175132160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] != &apos;completed&apos; THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_4545891270990229506]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
      </column>
      <column caption='% Contact Rate' datatype='real' name='[Calculation_5108700487261986816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([vendor_contact_flag], [orders],0))/SUM([orders])' />
      </column>
      <column caption='Vendors Segment' datatype='string' name='[Calculation_5108700487293329410]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [metric_type] = &apos;Overall&apos; THEN &apos;Overall Vendors&apos;&#10;ELSEIF  [metric_type] = &apos;Comparison - Today&apos; AND [is_perimeterx_request_blocked_today] THEN &apos;PerimeterX Blocked Vendors&apos;&#10;ELSE &apos;PerimeterX Not Blocked Vendors&apos;&#10;END' />
      </column>
      <column caption='Blocked Today Vendors' datatype='integer' name='[Calculation_5108700487296024579]' role='measure' type='quantitative'>
