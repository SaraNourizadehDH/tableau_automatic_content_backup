      <aliases enabled='yes' />
      <column caption='Dashboard CTR' datatype='real' name='[Calculation_3573184094480793604]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [int_ref_flag] AND (not CONTAINS([int_ref_description],&apos;side-&apos;)) then [sessions] else 0 end )&#10;/ &#10;sum(if event_label=&apos;DASHBOARD&apos; then [sessions] else 0 end )' />
      </column>
      <column caption='Label Filter' datatype='boolean' name='[Calculation_3835378035297103873]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT CONTAINS([event_label], &apos;https&apos;)&#10;and&#10;NOT CONTAINS([event_label], &apos;title&apos;)&#10;and &#10;NOT CONTAINS([event_label], &apos;description&apos;)&#10;and &#10;NOT CONTAINS([event_label], &apos;side-&apos;)&#10;and &#10;NOT CONTAINS([event_label], &apos;vendor_code&apos;)' />
      </column>
      <column caption='Group by' datatype='string' name='[Calculation_3835378035299508228]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Metric (copy)_3835378035299323907]&#10;when &apos;Overall&apos;           then [Calculation_3835378035299717125]&#10;when &apos;Management Entity&apos; then [management_entity]&#10;when &apos;Global Entity&apos;     then [global_entity_id]&#10;when &apos;Country Name&apos;      then [country_name]&#10;when &apos;Brand&apos;             then [brand]&#10;when &apos;Plugin Name&apos;       then [Calculation_3835378035299717125]&#10; END' />
      </column>
      <column caption='Overall' datatype='string' name='[Calculation_3835378035299717125]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(&quot;Overall&quot;)' />
      </column>
      <column caption='top-15' datatype='boolean' name='[Calculation_3835378035301560327]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX()&lt;=10'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Filtered Int-Ref' datatype='boolean' name='[Calculation_3835378035301945352]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT CONTAINS([int_ref_description], &apos;-nav&apos;)&#10;AND &#10;NOT CONTAINS([int_ref_description], &apos;-&apos;)' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_3835378035341651980]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Overall (copy)' datatype='string' name='[Overall (copy)_3835378035301351430]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(&quot;Overall&quot;)' />
      </column>
