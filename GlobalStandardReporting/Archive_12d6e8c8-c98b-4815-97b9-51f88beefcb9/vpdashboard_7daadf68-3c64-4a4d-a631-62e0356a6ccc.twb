            <column caption='sum([Num Sessions])/sum([Num Users])' datatype='real' name='[Calculation_1743596745216925705]' role='measure' type='quantitative' user:unnamed='Stickiness - Plugin (2)'>
              <calculation class='tableau' formula='sum([num_sessions])/sum([num_users])' />
