      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='mplvch_dashboard_retention_report2_v (rl_sales_revenue)' name='federated.1u7a8o90093oi91fvkos80le36yz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric' datatype='string' name='[Dau Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;WAU&quot;'>
              <calculation class='tableau' formula='&quot;WAU&quot;' />
            </column>
            <column caption='Group by' datatype='string' name='[Metric (copy)_3835378035299323907]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1u7a8o90093oi91fvkos80le36yz'>
            <column caption='Metric' datatype='integer' name='[Calculation_1743596745210920960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Dau Parameter]&#10;WHEN &apos;DAU&apos; THEN [dau]&#10;WHEN &apos;WAU&apos; THEN [wau]&#10;WHEN &apos;MAU&apos; THEN [mau]&#10;END' />
            </column>
            <column caption='Label Filter' datatype='boolean' name='[Calculation_1743596745212497921]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT CONTAINS([event_label], &apos;https&apos;)&#10;and&#10;NOT CONTAINS([event_label], &apos;title&apos;)&#10;and &#10;NOT CONTAINS([event_label], &apos;description&apos;)&#10;and &#10;NOT CONTAINS([event_label], &apos;side-&apos;)&#10;and &#10;NOT CONTAINS([event_label], &apos;vendor_code&apos;)' />
            </column>
            <column caption='SUM([Metric Mobile])/SUM([Metric])' datatype='real' name='[Calculation_1743596745214529539]' role='measure' type='quantitative' user:unnamed='Metric Mobile % by Entity'>
              <calculation class='tableau' formula='SUM([Metric (copy)_1743596745213931522])/SUM([Calculation_1743596745210920960])' />
            </column>
            <column caption='SUM([Metric Mobile])/SUM([Metric])' datatype='real' name='[Calculation_3573184094465687553]' role='measure' type='quantitative' user:unnamed='Metric Mobile % by Entity'>
              <calculation class='tableau' formula='SUM([Metric (copy)_1743596745213931522])/SUM([Calculation_1743596745210920960])' />
            </column>
            <column caption='Overall' datatype='string' name='[Calculation_3573184094465810434]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(&quot;Overall&quot;)' />
            </column>
            <column caption='Group By' datatype='string' name='[Calculation_3835378035303305225]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Metric (copy)_3835378035299323907]&#10;when &apos;Overall&apos;           then [Calculation_3573184094465810434]&#10;when &apos;Management Entity&apos; then [management_entity]&#10;when &apos;Global Entity&apos;     then [global_entity_id]&#10;when &apos;Country Name&apos;      then [country_name]&#10;when &apos;Brand&apos;             then [brand]&#10;when &apos;Plugin Name&apos;       then [event_label]&#10; END' />
            </column>
            <column caption='Metric Mobile' datatype='integer' name='[Metric (copy)_1743596745213931522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Dau Parameter]&#10;WHEN &apos;DAU&apos; THEN if [device_category]=&apos;mobile&apos; then [dau] else 0 end &#10;WHEN &apos;WAU&apos; THEN if [device_category]=&apos;mobile&apos; then [wau] else 0 end &#10;WHEN &apos;MAU&apos; THEN if [device_category]=&apos;mobile&apos; then [mau] else 0 end &#10;END' />
            </column>
