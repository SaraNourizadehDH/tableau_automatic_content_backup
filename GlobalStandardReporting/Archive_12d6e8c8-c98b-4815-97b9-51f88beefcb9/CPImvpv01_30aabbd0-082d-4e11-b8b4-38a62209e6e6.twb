        <view>
          <datasources>
            <datasource caption='mplvch_orders_cpi_agg (rl_sales_revenue)' name='federated.0raft821trasbh1fnpzuo0k8mcvq' />
          </datasources>
          <datasource-dependencies datasource='federated.0raft821trasbh1fnpzuo0k8mcvq'>
            <column caption='(ZN([item_price_eur_overall]) / LOOKUP(ZN([item_price_eur_ove...' datatype='real' name='[Calculation_171840482727424021]' role='measure' type='quantitative' user:unnamed='CPI MoM EUR - TR - Meal Type'>
              <calculation class='tableau' formula='(ZN([Calculation_6556748485627305998]) / LOOKUP(ZN([Calculation_6556748485627305998]), FIRST()))-1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='(ZN([item_price_eur_80/20]) / LOOKUP(ZN([item_price_eur_80/20...' datatype='real' name='[Calculation_171840482727440406]' role='measure' type='quantitative' user:unnamed='CPI MoM EUR - TR - Meal Type'>
              <calculation class='tableau' formula='(ZN([item_price_eur_overall (copy)_6556748485627400207]) / LOOKUP(ZN([item_price_eur_overall (copy)_6556748485627400207]), FIRST()))-1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='dish &amp; categort' datatype='boolean' name='[Calculation_6556748485625733131]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[ranked_dish_flag] and [ranked_category_flag]' />
            </column>
            <column caption='pct_20/80' datatype='boolean' name='[Calculation_6556748485627101197]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='iif([norm_price_flag]=&apos;pct_20&apos; or [norm_price_flag]=&apos;pct_80&apos;, True, False)' />
            </column>
            <column caption='item_price_eur_overall' datatype='real' name='[Calculation_6556748485627305998]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([product_sum_eur])/sum([items])' />
            </column>
            <column caption='Prep-Base' datatype='boolean' name='[Calculation_6556748485628579857]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[fielddate_week]&lt;=date(&apos;2021-06-27&apos;)' />
            </column>
            <column caption='filter_flag ' datatype='boolean' name='[Calculation_6556748485629628435]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='iif(MONTH([fielddate_week])=6 and year([fielddate_week])=2021, True, False)&#10;or  &#10;iif(MONTH([fielddate_week])=3 and year([fielddate_week])=2023, True, False)' />
            </column>
            <column caption='date_adopted' datatype='string' name='[Calculation_6556748485630668822]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='iif([Calculation_6556748485628579857], &apos;Base&apos;, str(year([fielddate_week]))+&apos; - &apos;+str(month([fielddate_week])))' />
            </column>
            <column caption='Fielddate Week' datatype='date' name='[fielddate_week]' role='dimension' type='ordinal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='item_price_eur_80/20' datatype='real' name='[item_price_eur_overall (copy)_6556748485627400207]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(iif([Calculation_6556748485627101197],[product_sum_eur],0))/sum(iif([Calculation_6556748485627101197],[items],0))' />
            </column>
            <column datatype='integer' name='[items]' role='measure' type='quantitative' />
