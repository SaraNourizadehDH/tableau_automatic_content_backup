      <aliases enabled='yes' />
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_171840482731405344]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Norm Dish matched' datatype='boolean' name='[Calculation_4675932690849366017]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([norm_dish_name])' />
      </column>
      <column caption='pre-flag' datatype='boolean' name='[Calculation_4675932690854473733]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[fielddate_week]&lt;=Date(&apos;2021-06-06&apos;)' />
      </column>
      <column caption='index 100' datatype='boolean' name='[Calculation_6556748485580488708]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX()&lt;=100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='dish &amp; categort' datatype='boolean' name='[Calculation_6556748485625733131]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[ranked_dish_flag] and [ranked_category_flag]' />
      </column>
      <column caption='pct_20/80' datatype='boolean' name='[Calculation_6556748485627101197]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='iif([norm_price_flag]=&apos;pct_20&apos; or [norm_price_flag]=&apos;pct_80&apos;, True, False)' />
      </column>
      <column caption='item_price_eur_overall' datatype='real' name='[Calculation_6556748485627305998]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([product_sum_eur])/sum([items])' />
      </column>
      <column caption='Prep-Base' datatype='boolean' name='[Calculation_6556748485628579857]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[fielddate_week]&lt;=date(&apos;2021-06-27&apos;)' />
      </column>
      <column caption='filter_flag ' datatype='boolean' name='[Calculation_6556748485629628435]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='iif(MONTH([fielddate_week])=6 and year([fielddate_week])=2021, True, False)&#10;or  &#10;iif(MONTH([fielddate_week])=3 and year([fielddate_week])=2023, True, False)' />
      </column>
      <column caption='date_adopted' datatype='string' name='[Calculation_6556748485630668822]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='iif([Calculation_6556748485628579857], &apos;Base&apos;, str(year([fielddate_week]))+&apos; - &apos;+str(month([fielddate_week])))' />
      </column>
      <column caption='Rank' datatype='integer' name='[Orders (copy 2)_6556748485580910597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(sum([orders]),&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column aggregation='Sum' caption='Orders (copy)' datatype='integer' name='[Orders (copy)_6556748485579558914]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[orders]' />
      </column>
      <column caption='lead_orders' datatype='integer' name='[Rank (copy)_6556748485582569480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LEAD(sum([orders]),1)' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='mplvch_orders_cpi_agg' datatype='table' name='[__tableau_internal_object_id__].[mplvch_orders_cpi_agg_82576CE3BD224BE3971DE41E3E740D16]' role='measure' type='quantitative' />
      <column caption='Access Group' datatype='string' name='[access_group]' role='dimension' type='nominal' />
      <column caption='date_adopted wow' datatype='string' name='[date_adopted (copy)_6556748485634076703]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='iif([Calculation_6556748485628579857], &apos;Base&apos;, str(year([fielddate_week]))+&apos; - &apos;+str(WEEK([fielddate_week])))' />
      </column>
      <column caption='Fielddate Week' datatype='date' name='[fielddate_week]' role='dimension' type='ordinal' />
      <column caption='Global Entity Id (Tableau Gsr Entitlements Global Entity Id)' datatype='string' name='[global_entity_id (tableau_gsr_entitlements_global_entity_id)]' role='dimension' type='nominal' />
      <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
      <column caption='item_price_local_80/20' datatype='real' name='[item_price_eur_80/20 (copy)_6556748485632471063]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(iif([Calculation_6556748485627101197],[product_sum_local],0))/sum(iif([Calculation_6556748485627101197],[items],0))' />
      </column>
      <column caption='item_price_eur_80/20' datatype='real' name='[item_price_eur_overall (copy)_6556748485627400207]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(iif([Calculation_6556748485627101197],[product_sum_eur],0))/sum(iif([Calculation_6556748485627101197],[items],0))' />
      </column>
      <column caption='item_price_local_overall' datatype='real' name='[item_price_eur_overall (copy)_6556748485632577560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([product_sum_local])/sum([items])' />
      </column>
      <column datatype='integer' name='[items]' role='measure' type='quantitative' />
      <column caption='Norm Category Name' datatype='string' name='[norm_category_name]' role='dimension' type='nominal' />
