      <column-instance column='[product_sum_eur]' derivation='Avg' name='[avg:product_sum_eur:qk]' pivot='key' type='quantitative' />
      <column-instance column='[Calculation_6556748485627305998]' derivation='User' name='[diff:usr:Calculation_6556748485627305998:qk]' pivot='key' type='quantitative'>
        <table-calc diff-options='Relative' ordering-type='Rows' type='Difference'>
