            <column-instance column='[Calculation_4111856891752361998]' derivation='None' name='[none:Calculation_4111856891752361998:nk]' pivot='key' type='nominal' />
            <column-instance column='[orders_pct]' derivation='None' name='[none:orders_pct:nk]' pivot='key' type='nominal' />
            <column caption='One Star Reviews' datatype='integer' name='[one_star_reviews]' role='measure' type='quantitative' />
            <column caption='Orders Num' datatype='integer' name='[orders_num]' role='measure' type='quantitative' />
            <column caption='Orders Pct' datatype='string' name='[orders_pct]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4111856890053881859]' derivation='Sum' name='[sum:Calculation_4111856890053881859:qk]' pivot='key' type='quantitative' />
            <column caption='Texted Review Flag' datatype='boolean' name='[texted_review_flag]' role='dimension' type='nominal' />
