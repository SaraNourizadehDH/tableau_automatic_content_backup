    <worksheet name='pct_ratings'>
      <repository-location id='pct_ratings' path='/t/GlobalStandardReporting/workbooks/voucher_orders_overview' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='voucher_check_reviews' name='federated.14g1q3q0lqvm1z1csi4lt13fmrlu' />
          </datasources>
          <datasource-dependencies datasource='federated.14g1q3q0lqvm1z1csi4lt13fmrlu'>
            <column caption='countd vendor ' datatype='integer' name='[Calculation_1996713177204424714]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(str([vendor_id])+&apos; &apos;+str([global_entity_id]))' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_1996713177205358603]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='left([global_entity_id],2)' />
            </column>
            <column caption='One Star Reviews upd' datatype='integer' name='[Calculation_1996713177207963675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[one_star_reviews]+[zero_star_reviews]' />
            </column>
            <column caption='one-two star reviews' datatype='integer' name='[Calculation_4111856890053881859]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[zero_star_reviews]&#10;+&#10;[one_star_reviews]&#10;+&#10;[two_star_reviews]&#10;+&#10;((if [Calculation_1996713177205358603] = &apos;YS&apos; then 1 else 0 end)*([three_star_reviews]+[four_star_reviews]))' />
            </column>
            <column caption='(SUM([Five Star Reviews]+[Ten Star Reviews])/SUM([Orders Num]...' datatype='real' name='[Calculation_4111856891751456781]' role='measure' type='quantitative' user:unnamed='pct_ratings'>
              <calculation class='tableau' formula='(SUM([five_star_reviews]+[ten_star_reviews])/SUM([orders_num]))/(SUM([Calculation_1996713177207963675])/sum([Orders Num (Voucher Check Reviews 4.Csv) (copy)_1996713177194868743]))' />
            </column>
            <column caption='Review Flag' datatype='boolean' name='[Calculation_4111856891752361998]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([texted_review_flag], FALSE)' />
            </column>
            <column caption='sum([Five Star Reviews]+[Ten Star Reviews])/sum([Orders Num])' datatype='real' name='[Calculation_4111856891753676817]' role='measure' type='quantitative' user:unnamed='pct_ratings'>
              <calculation class='tableau' formula='sum([five_star_reviews]+[ten_star_reviews])/sum([orders_num])' />
            </column>
            <column caption='sum([one-two star reviews])/sum([Orders Num])' datatype='real' name='[Calculation_4111856891753840660]' role='measure' type='quantitative' user:unnamed='pct_ratings'>
              <calculation class='tableau' formula='sum([Calculation_4111856890053881859])/sum([orders_num])' />
            </column>
            <column caption='Orders Num (Voucher Check Reviews 4.Csv) (copy)' datatype='integer' name='[Orders Num (Voucher Check Reviews 4.Csv) (copy)_1996713177194868743]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders_num]' />
            </column>
            <column-instance column='[Orders Num (Voucher Check Reviews 4.Csv) (copy)_1996713177194868743]' derivation='Avg' name='[avg:Orders Num (Voucher Check Reviews 4.Csv) (copy)_1996713177194868743:qk]' pivot='key' type='quantitative' />
            <column caption='countd vendor  has 1-2 reviews' datatype='integer' name='[countd vendor  (copy)_4111856890311389189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [has_ratings (copy)_1996713177205944335] then ([vendor_id])+&apos; &apos;+str([global_entity_id]) else &apos;0&apos; end)' />
            </column>
            <column caption='Five Star Reviews' datatype='integer' name='[five_star_reviews]' role='measure' type='quantitative' />
            <column caption='Four Star Reviews' datatype='integer' name='[four_star_reviews]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='has_ratings 1,2' datatype='boolean' name='[has_ratings (copy)_1996713177205944335]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[zero_star_reviews]&gt;=1&#10;OR &#10;[one_star_reviews]&gt;=1&#10;OR &#10;[two_star_reviews]&gt;=1&#10;OR&#10;(&#10;if [Calculation_1996713177205358603] = &apos;YS&apos; and ([three_star_reviews]&gt;=1 or [four_star_reviews]&gt;=1)  &#10;then true else false end)' />
            </column>
            <column caption='Nine Star Reviews' datatype='integer' name='[nine_star_reviews]' role='measure' type='quantitative' />
