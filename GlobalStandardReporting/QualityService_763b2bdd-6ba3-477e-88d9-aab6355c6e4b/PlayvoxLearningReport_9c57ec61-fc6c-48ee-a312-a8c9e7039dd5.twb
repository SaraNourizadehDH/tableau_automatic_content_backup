            <column-instance column='[team_name]' derivation='None' name='[none:team_name:nk]' pivot='key' type='nominal' />
            <column caption='Sum Handling Time Chat Sec' datatype='real' name='[sum_handling_time_chat_sec]' role='measure' type='quantitative' />
            <column caption='Sum Inbound Handling Time Call Sec' datatype='integer' name='[sum_inbound_ht_call_sec]' role='measure' type='quantitative' />
