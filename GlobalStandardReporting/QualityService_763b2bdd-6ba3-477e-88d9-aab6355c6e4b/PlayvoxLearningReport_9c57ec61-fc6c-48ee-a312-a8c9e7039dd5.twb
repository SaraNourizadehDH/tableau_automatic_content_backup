      <aliases enabled='yes' />
      <column caption='Agent Id - with course' datatype='string' name='[Agent Id (copy)_6947435774308003862]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [course_title] != NULL THEN [agent_id] ELSE NULL END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_138837594208718848]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Count Course Completed' datatype='integer' name='[Calculation_6947435773988376576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_completed] THEN STR([agent_id]) + STR([Course Title (copy)_6947435777107701826]) ELSE NULL END)' />
      </column>
      <column caption='Avg. Score' datatype='real' name='[Calculation_6947435773989531649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([course_total_score])&#10;/&#10;[Calculation_6947435773988376576]' />
      </column>
      <column caption='Chat AHT (min)' datatype='real' name='[Calculation_6947435773993115650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([sum_handling_time_chat_sec]),0) / SUM([count_served_chats]) / 60' />
      </column>
      <column caption='Non Live AHT (min)' datatype='real' name='[Calculation_6947435773993791493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_work_items_ht_sec]) / SUM([count_work_items]) / 60' />
      </column>
      <column caption='Granularity Level' datatype='string' name='[Calculation_6947435773996199942]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN STR([created_date])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN [week]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN [month]&#10;END' />
      </column>
      <column caption='Is Current Period' datatype='boolean' name='[Calculation_6947435774000295946]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN &#10;STR([created_date]) = STR(TODAY()-1)&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN &#10;[week] = STR(YEAR(TODAY()-7)) + &apos;-&apos; + STR(WEEK(TODAY()-7)) &#10;// subtracting 7 as &quot;week&quot; function in Tableau uses US format,&#10;// while in the script we use iso format&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN &#10;[month] = STR(YEAR(TODAY())) + &apos;-&apos; + STR(MONTH(TODAY()))&#10;&#10;END' />
      </column>
      <column caption='Count Agent Id - Current Period' datatype='integer' name='[Calculation_6947435774004928526]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( &#10;IF [Calculation_6947435774000295946]&#10;THEN  [agent_id]&#10;ELSE NULL&#10;END)' />
      </column>
      <column caption='If % Agents increased' datatype='boolean' name='[Calculation_6947435774007324690]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_6947435774004928526] &gt; [Count Agent Id - Current Period (copy)_6947435774005338128]' />
      </column>
      <column caption='Channel' datatype='real' name='[Calculation_6947435774012911636]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Chat&apos; THEN [Calculation_6947435773993115650]&#10;ELSEIF  [Parameters].[Parameter 2] = &apos;Inbpound Call&apos; THEN [Chat AHT (min) (copy)_6947435773993287683]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Outbound Call&apos; THEN [Call Inbound AHT (min) (copy)_6947435773993500676]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Non Live&apos; THEN [Calculation_6947435773993791493]&#10;END' />
      </column>
      <column caption='QA Score' datatype='real' name='[Calculation_6947435774019141653]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(IFNULL(SUM([sum_score_percentage]),0)&#10;/&#10;(IFNULL(SUM([count_evaluations]),0)*100),0)' />
      </column>
      <column caption='Count Courses Enrolled' datatype='integer' name='[Calculation_6947435774343204888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Course Title (copy)_6947435777107701826] != &apos; No course&apos; THEN [agent_id] + &apos;_&apos; + [Course Title (copy)_6947435777107701826] ELSE NULL END)' />
      </column>
      <column caption='Pass Rate' datatype='real' name='[Calculation_6947435774699364382]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Count Course Completed (copy)_6947435774699282461] / [Calculation_6947435774343204888]' />
      </column>
      <column caption='Pass Rate - pp. chage' datatype='real' name='[Calculation_6947435774701633573]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Pass Rate - Current Period minus 1 (copy)_6947435774701727782] - [Pass Rate (copy)_6947435774701195300]) * 100' />
      </column>
      <column caption='Count Course Completed - change' datatype='integer' name='[Calculation_6947435774704320554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Count Course Completed (copy)_6947435774704181288] - [Count Course Completed - Current Period (copy)_6947435774704246825]' />
      </column>
      <column caption='Left alignment' datatype='real' name='[Calculation_6947435776814039102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.15' />
      </column>
      <column caption='Right alignment' datatype='real' name='[Calculation_6947435776814067775]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.6' />
      </column>
      <column caption='Call Outbound AHT (min)' datatype='real' name='[Call Inbound AHT (min) (copy)_6947435773993500676]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_outbound_ht_call_sec]) / SUM([count_outbound_call_success]) / 60' />
      </column>
      <column caption='Call Inbound AHT (min)' datatype='real' name='[Chat AHT (min) (copy)_6947435773993287683]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_inbound_ht_call_sec]) / SUM([count_served_calls]) / 60' />
      </column>
      <column caption='Count Agent Id - Current Period minus 1' datatype='integer' name='[Count Agent Id - Current Period (copy)_6947435774005338128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( &#10;IF [Is Current Period (copy)_6947435774002155532]&#10;THEN  [agent_id]&#10;ELSE NULL&#10;END)' />
      </column>
      <column caption='Count Agent Id - % change' datatype='real' name='[Count Agent Id - Current Period minus 1 (copy)_6947435774005415953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_6947435774004928526] - [Count Agent Id - Current Period (copy)_6947435774005338128]) / [Count Agent Id - Current Period (copy)_6947435774005338128]' />
      </column>
      <column caption='Count Course Passed' datatype='integer' name='[Count Course Completed (copy)_6947435774699282461]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_course_passed] THEN STR([agent_id]) + STR([Course Title (copy)_6947435777107701826]) ELSE NULL END)' />
      </column>
      <column caption='Count Course Completed - Current Period' datatype='integer' name='[Count Course Completed (copy)_6947435774704181288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_completed] AND [Calculation_6947435774000295946] THEN STR([agent_id]) + STR([Course Title (copy)_6947435777107701826]) ELSE NULL END)' />
      </column>
      <column caption='Count Course Completed - Current Period minus 1' datatype='integer' name='[Count Course Completed - Current Period (copy)_6947435774704246825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_completed] AND [Is Current Period (copy)_6947435774002155532] THEN STR([agent_id]) + STR([Course Title (copy)_6947435777107701826]) ELSE NULL END)' />
