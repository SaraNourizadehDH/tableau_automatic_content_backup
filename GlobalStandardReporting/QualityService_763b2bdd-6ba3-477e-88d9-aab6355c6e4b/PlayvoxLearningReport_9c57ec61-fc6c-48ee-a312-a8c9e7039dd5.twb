      <column caption='Count Course Passed - Current Period' datatype='integer' name='[Count Course Passed (copy)_6947435774700847136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_course_passed] AND [Calculation_6947435774000295946] THEN STR([agent_id]) + STR([Course Title (copy)_6947435777107701826]) ELSE NULL END)' />
      </column>
      <column caption='Count Course Passed - Current Period minus 1' datatype='integer' name='[Count Course Passed - Current Period (copy)_6947435774701060130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_course_passed] AND [Is Current Period (copy)_6947435774002155532] THEN STR([agent_id]) + STR([Course Title (copy)_6947435777107701826]) ELSE NULL END)' />
      </column>
      <column caption='Count Courses Enrolled - Current Period' datatype='integer' name='[Count Courses Enrolled (copy)_6947435774700924961]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD(IF [Course Title (copy)_6947435777107701826] != &apos; No course&apos; AND [Calculation_6947435774000295946] &#10;THEN [agent_id] + &apos;_&apos; + [Course Title (copy)_6947435777107701826] ELSE NULL END)' />
      </column>
      <column caption='Count Courses Enrolled - Current Period minus 1' datatype='integer' name='[Count Courses Enrolled - Current Period (copy)_6947435774701113379]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD(IF [Course Title (copy)_6947435777107701826] != &apos; No course&apos; AND [Is Current Period (copy)_6947435774002155532]&#10;THEN [agent_id] + &apos;_&apos; + [course_title] ELSE NULL END)' />
      </column>
      <column caption='Course Title - cleaned' datatype='string' name='[Course Title (copy)_6947435777107701826]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [course_title] = &apos;No course&apos;&#10;THEN &apos; No course&apos;&#10;ELSE [course_title]&#10;END &#10;// this is to make sure it won&apos;t get lost in the filter but is the first value displayed, easy to include/exclude' />
      </column>
      <column caption='Created Date Relative' datatype='date' name='[Created Date (copy)_6947435773997182983]' role='dimension' type='ordinal'>
