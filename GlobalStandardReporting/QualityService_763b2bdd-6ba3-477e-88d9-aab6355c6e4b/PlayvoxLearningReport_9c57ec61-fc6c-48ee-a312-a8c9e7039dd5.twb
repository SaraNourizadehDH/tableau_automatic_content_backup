    <worksheet name='AHT (min)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='playvox_learning_report' name='federated.12obd6g1pidu6d1cnzsgv0t04dd8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='Select Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Chat&quot;'>
              <calculation class='tableau' formula='&quot;Chat&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.12obd6g1pidu6d1cnzsgv0t04dd8'>
            <column caption='Chat AHT (min)' datatype='real' name='[Calculation_6947435773993115650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([sum_handling_time_chat_sec]),0) / SUM([count_served_chats]) / 60' />
            </column>
            <column caption='Non Live AHT (min)' datatype='real' name='[Calculation_6947435773993791493]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_work_items_ht_sec]) / SUM([count_work_items]) / 60' />
            </column>
            <column caption='Granularity Level' datatype='string' name='[Calculation_6947435773996199942]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN STR([created_date])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN [week]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN [month]&#10;END' />
            </column>
            <column caption='Channel' datatype='real' name='[Calculation_6947435774012911636]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Chat&apos; THEN [Calculation_6947435773993115650]&#10;ELSEIF  [Parameters].[Parameter 2] = &apos;Inbpound Call&apos; THEN [Chat AHT (min) (copy)_6947435773993287683]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Outbound Call&apos; THEN [Call Inbound AHT (min) (copy)_6947435773993500676]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Non Live&apos; THEN [Calculation_6947435773993791493]&#10;END' />
            </column>
            <column caption='Count Courses Enrolled' datatype='integer' name='[Calculation_6947435774343204888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Course Title (copy)_6947435777107701826] != &apos; No course&apos; THEN [agent_id] + &apos;_&apos; + [Course Title (copy)_6947435777107701826] ELSE NULL END)' />
            </column>
            <column caption='RUNNING_SUM([Count Course Passed]) / RUNNING_SUM([Count Cours...' datatype='real' name='[Calculation_6947435774723108916]' role='measure' type='quantitative' user:unnamed='QA Score (2)'>
              <calculation class='tableau' formula='RUNNING_SUM([Count Course Completed (copy)_6947435774699282461]) / RUNNING_SUM([Calculation_6947435774343204888])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Call Outbound AHT (min)' datatype='real' name='[Call Inbound AHT (min) (copy)_6947435773993500676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_outbound_ht_call_sec]) / SUM([count_outbound_call_success]) / 60' />
            </column>
            <column caption='Call Inbound AHT (min)' datatype='real' name='[Chat AHT (min) (copy)_6947435773993287683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_inbound_ht_call_sec]) / SUM([count_served_calls]) / 60' />
            </column>
            <column caption='Count Course Passed' datatype='integer' name='[Count Course Completed (copy)_6947435774699282461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_course_passed] THEN STR([agent_id]) + STR([Course Title (copy)_6947435777107701826]) ELSE NULL END)' />
            </column>
            <column caption='Course Title - cleaned' datatype='string' name='[Course Title (copy)_6947435777107701826]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [course_title] = &apos;No course&apos;&#10;THEN &apos; No course&apos;&#10;ELSE [course_title]&#10;END &#10;// this is to make sure it won&apos;t get lost in the filter but is the first value displayed, easy to include/exclude' />
            </column>
            <column caption='Created Date Relative' datatype='date' name='[Created Date (copy)_6947435773997182983]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[created_date]' />
            </column>
            <column caption='Agent Id' datatype='string' name='[agent_id]' role='dimension' type='nominal' />
            <column caption='Agent Tenure Months' datatype='string' name='[agent_tenure_months]' role='dimension' type='nominal' />
            <column caption='BPO' datatype='string' name='[bpo_name]' role='dimension' type='nominal' />
            <column caption='Contact Center' datatype='string' name='[contact_center]' role='dimension' type='nominal' />
            <column caption='Count Outbound Call Success' datatype='integer' name='[count_outbound_call_success]' role='measure' type='quantitative' />
            <column caption='Count Served Calls' datatype='integer' name='[count_served_calls]' role='measure' type='quantitative' />
            <column caption='Count Served Chats' datatype='integer' name='[count_served_chats]' role='measure' type='quantitative' />
            <column caption='Count Work Items' datatype='real' name='[count_work_items]' role='measure' type='quantitative' />
            <column caption='Course Title' datatype='string' name='[course_title]' role='dimension' type='nominal' />
            <column caption='Enrollment Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
