    <worksheet name='Pass Rate pp. change'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>&lt;</run>
            <run fontsize='12'>[Parameters].[Parameter 1]</run>
            <run fontsize='12'>&gt; pp. change in Pass Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='playvox_learning_report' name='federated.12obd6g1pidu6d1cnzsgv0t04dd8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.12obd6g1pidu6d1cnzsgv0t04dd8'>
            <column caption='Is Current Period' datatype='boolean' name='[Calculation_6947435774000295946]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN &#10;STR([created_date]) = STR(TODAY()-1)&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN &#10;[week] = STR(YEAR(TODAY()-7)) + &apos;-&apos; + STR(WEEK(TODAY()-7)) &#10;// subtracting 7 as &quot;week&quot; function in Tableau uses US format,&#10;// while in the script we use iso format&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN &#10;[month] = STR(YEAR(TODAY())) + &apos;-&apos; + STR(MONTH(TODAY()))&#10;&#10;END' />
            </column>
            <column caption='Pass Rate - pp. chage' datatype='real' name='[Calculation_6947435774701633573]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Pass Rate - Current Period minus 1 (copy)_6947435774701727782] - [Pass Rate (copy)_6947435774701195300]) * 100' />
            </column>
            <column caption='Left alignment' datatype='real' name='[Calculation_6947435776814039102]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0.15' />
            </column>
            <column caption='Right alignment' datatype='real' name='[Calculation_6947435776814067775]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0.6' />
            </column>
            <column caption='Count Course Passed - Current Period' datatype='integer' name='[Count Course Passed (copy)_6947435774700847136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_course_passed] AND [Calculation_6947435774000295946] THEN STR([agent_id]) + STR([Course Title (copy)_6947435777107701826]) ELSE NULL END)' />
            </column>
            <column caption='Count Course Passed - Current Period minus 1' datatype='integer' name='[Count Course Passed - Current Period (copy)_6947435774701060130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_course_passed] AND [Is Current Period (copy)_6947435774002155532] THEN STR([agent_id]) + STR([Course Title (copy)_6947435777107701826]) ELSE NULL END)' />
            </column>
            <column caption='Count Courses Enrolled - Current Period' datatype='integer' name='[Count Courses Enrolled (copy)_6947435774700924961]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD(IF [Course Title (copy)_6947435777107701826] != &apos; No course&apos; AND [Calculation_6947435774000295946] &#10;THEN [agent_id] + &apos;_&apos; + [Course Title (copy)_6947435777107701826] ELSE NULL END)' />
            </column>
            <column caption='Count Courses Enrolled - Current Period minus 1' datatype='integer' name='[Count Courses Enrolled - Current Period (copy)_6947435774701113379]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD(IF [Course Title (copy)_6947435777107701826] != &apos; No course&apos; AND [Is Current Period (copy)_6947435774002155532]&#10;THEN [agent_id] + &apos;_&apos; + [course_title] ELSE NULL END)' />
            </column>
            <column caption='Course Title - cleaned' datatype='string' name='[Course Title (copy)_6947435777107701826]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [course_title] = &apos;No course&apos;&#10;THEN &apos; No course&apos;&#10;ELSE [course_title]&#10;END &#10;// this is to make sure it won&apos;t get lost in the filter but is the first value displayed, easy to include/exclude' />
            </column>
            <column caption='If Pass Rate increased' datatype='boolean' name='[If % Agents increased (copy)_6947435774701850663]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Pass Rate - Current Period minus 1 (copy)_6947435774701727782]) OR ISNULL([Pass Rate (copy)_6947435774701195300])&#10;THEN FALSE&#10;ELSE&#10;[Pass Rate - Current Period minus 1 (copy)_6947435774701727782] &gt; [Pass Rate (copy)_6947435774701195300]&#10;END' />
            </column>
            <column caption='Is Current Period minus 1' datatype='boolean' name='[Is Current Period (copy)_6947435774002155532]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Daily&apos; THEN &#10;STR([created_date]) = STR(TODAY()-2)&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN &#10;[week] = STR(YEAR(TODAY()-14)) + &apos;-&apos; + STR(WEEK(TODAY()-14)) &#10;// subtracting 14 as &quot;week&quot; function in Tableau uses US format,&#10;// while in the script we use iso format&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; THEN &#10;&#10;IF MONTH(DATETRUNC(&apos;month&apos;, TODAY() - 31)) &lt; 10 THEN // add 0 if month number is a single digit&#10;[month] = STR(YEAR(DATETRUNC(&apos;month&apos;, TODAY() - 31))) + &apos;-&apos; + &apos;0&apos; + STR(MONTH(DATETRUNC(&apos;month&apos;, TODAY() - 31)))&#10;ELSE &#10;[month] = STR(YEAR(DATETRUNC(&apos;month&apos;, TODAY() - 31))) + &apos;-&apos; + STR(MONTH(DATETRUNC(&apos;month&apos;, TODAY() - 31)))&#10;END&#10;&#10;&#10;END' />
            </column>
            <column caption='Pass Rate - Current Period minus 1' datatype='real' name='[Pass Rate (copy)_6947435774701195300]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Count Course Passed - Current Period (copy)_6947435774701060130] / [Count Courses Enrolled - Current Period (copy)_6947435774701113379]' />
            </column>
            <column caption='Pass Rate - Current Period' datatype='real' name='[Pass Rate - Current Period minus 1 (copy)_6947435774701727782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Count Course Passed (copy)_6947435774700847136] / [Count Courses Enrolled (copy)_6947435774700924961]' />
            </column>
            <column caption='Agent Id' datatype='string' name='[agent_id]' role='dimension' type='nominal' />
            <column caption='Agent Tenure Months' datatype='string' name='[agent_tenure_months]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_6947435776814039102]' derivation='Avg' name='[avg:Calculation_6947435776814039102:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_6947435776814067775]' derivation='Avg' name='[avg:Calculation_6947435776814067775:qk]' pivot='key' type='quantitative' />
            <column caption='BPO' datatype='string' name='[bpo_name]' role='dimension' type='nominal' />
            <column caption='Contact Center' datatype='string' name='[contact_center]' role='dimension' type='nominal' />
            <column caption='Course Title' datatype='string' name='[course_title]' role='dimension' type='nominal' />
            <column caption='Enrollment Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
