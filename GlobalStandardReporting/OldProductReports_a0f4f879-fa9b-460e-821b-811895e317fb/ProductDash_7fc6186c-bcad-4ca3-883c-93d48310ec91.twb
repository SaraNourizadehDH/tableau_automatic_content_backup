            <column caption='App Version Filter' datatype='string' name='[App Version (copy)_2441232501632868363]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[app_version]' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_1161225044643995648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_with_orders])/SUM([sessions])' />
            </column>
            <column caption='mCVR1' datatype='real' name='[Calculation_1262204192555864068]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mcvr1_total])/SUM([mocvr1_count])' />
            </column>
            <column caption='mCVR2' datatype='real' name='[Calculation_1262204192556363781]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mcvr2_total])/SUM([mocvr2_count])' />
            </column>
            <column caption='mCVR3' datatype='real' name='[Calculation_1262204192556548102]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mcvr3_total])/SUM([mocvr3_count])' />
            </column>
            <column caption='mCVR4' datatype='real' name='[Calculation_1262204192556699655]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mcvr4_total])/SUM([mocvr4_count])' />
            </column>
            <column caption='Time to Order' datatype='real' default-format='*hh:mm:ss' name='[Calculation_1262204192572346381]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([time_to_order_total])/SUM([sessions_with_orders]))' />
            </column>
            <column caption='Mobile App filter' datatype='boolean' name='[Calculation_2233081756289728515]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[platform] IN (&apos;Android&apos;,&apos;iOS&apos;)' />
            </column>
            <column caption='Transactions' datatype='integer' name='[Calculation_2441232501603987456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([transaction])' />
            </column>
            <column caption='Platform Filter' datatype='string' name='[Platform (copy)_2441232501633626124]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[platform]' />
            </column>
            <column caption='Time Checkout' datatype='real' default-format='*hh:mm:ss' name='[Time menu (copy)_1262204192580382739]' role='measure' type='quantitative'>
