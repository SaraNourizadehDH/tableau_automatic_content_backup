        <calculation class='tableau' formula='SUM([no_response_failed_vendor])/SUM([orders])' />
      </column>
      <column caption='% No Response Fail Rate (∆ Divergence)' datatype='real' name='[Calculation_1984680089614422018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [no_response_failed_vendor] END)&#10;    /&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [no_response_failed_vendor] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    - 1&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [no_response_failed_vendor] END)&#10;    /&#10;    SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    /&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [no_response_failed_vendor] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    - 1&#10;)' />
