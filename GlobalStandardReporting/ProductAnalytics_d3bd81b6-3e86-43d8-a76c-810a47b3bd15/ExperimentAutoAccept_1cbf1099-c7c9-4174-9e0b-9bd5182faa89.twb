              <calculation class='tableau' formula='(&#10;    (&#10;    SUM({ INCLUDE [date_type]:&#10;     &#10;        SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [on_time_order] END)&#10;        })&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;     &#10;        SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;        })&#10;    )&#10;    &#10;    -&#10;    &#10;    (&#10;         SUM({ INCLUDE [date_type]:&#10;            SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [on_time_order] END)&#10;            })&#10;        /&#10;         SUM({ INCLUDE [date_type]:&#10;            SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;            })&#10;    )&#10;&#10;)&#10;&#10;-&#10;&#10;(&#10;    (&#10;    SUM({ INCLUDE [date_type]:&#10;     &#10;        SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [on_time_order] END)&#10;        })&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;     &#10;        SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;        })&#10;    )&#10;    &#10;    -&#10;    &#10;    (&#10;         SUM({ INCLUDE [date_type]:&#10;            SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [on_time_order] END)&#10;            })&#10;        /&#10;         SUM({ INCLUDE [date_type]:&#10;            SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;            })&#10;    )&#10;&#10;)' />
