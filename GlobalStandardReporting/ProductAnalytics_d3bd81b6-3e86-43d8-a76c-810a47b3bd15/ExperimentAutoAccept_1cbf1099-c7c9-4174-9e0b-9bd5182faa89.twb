          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hr6f8u087m4kg1bqrbfm17yze5s'>
            <column caption='aVTC (minutes)' datatype='real' name='[Calculation_1984680089634066440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avtc])/SUM([platform_order_code_avtc])' />
            </column>
            <column caption='Vendor Late Above 10' datatype='real' name='[Calculation_1984680089637269513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([_pcnt_vendor_late_10])/SUM([vendor_late_calculation])' />
            </column>
            <column caption='Vendor Late Above 10 Delta' datatype='real' name='[Calculation_1984680089637769228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(   // varient A&#10;  SUM(IF [experiment_group] = [Parameters].[Parameter 2] THEN [_pcnt_vendor_late_10] END)&#10;/  SUM(IF [experiment_group] = [Parameters].[Parameter 2] THEN [vendor_late_calculation] END) &#10;)    &#10;    &#10;/&#10;(  // Baseline&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [_pcnt_vendor_late_10] END)&#10;/SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [vendor_late_calculation] END) &#10;    &#10;)&#10;- 1' />
