    <worksheet name='Customer Fail Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run>% Customer Fail Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='auto accept + user entitlement' name='federated.0hr6f8u087m4kg1bqrbfm17yze5s' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Date Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column alias='Variant A' caption='Select Variant' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Variant A&quot;'>
              <calculation class='tableau' formula='&quot;Variant A&quot;' />
              <aliases>
                <alias key='&quot;Variant A&quot;' value='Variant A' />
              </aliases>
            </column>
            <column alias='Charts' caption='Select Charts or Tabular View' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;charts&quot;'>
              <calculation class='tableau' formula='&quot;charts&quot;' />
              <aliases>
                <alias key='&quot;charts&quot;' value='Charts' />
                <alias key='&quot;tab&quot;' value='Tabular View' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hr6f8u087m4kg1bqrbfm17yze5s'>
            <column caption='% Customer Fail Rate' datatype='real' default-format='p0.000%' name='[% Contact Rate [Vendor&amp;Customer]] (copy)_50876604578615297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_failed_orders])/SUM([orders])' />
            </column>
            <column caption='_granularity_filter' datatype='boolean' name='[Calculation_4565524148946161665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &quot;Daily&quot; THEN [date_type] = &quot;Daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [date_type] = &quot;Weekly&quot;&#10;&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_4565524148946345986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date_local]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date_local]))+&quot;-W&quot;+STR([weeks])&#10;END' />
            </column>
            <column caption='_view_charts_or_tab' datatype='string' name='[Calculation_4565524149402353741]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
            </column>
            <column caption='Variants filter' datatype='boolean' name='[Variants (copy)_1879126963555889156]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;&#10;WHEN &quot;Variant A&quot; THEN [experiment_group] IN (&quot;Variant A&quot;, &quot;Baseline&quot;)&#10;WHEN &quot;Variant B&quot; THEN [experiment_group] IN (&quot;Variant B&quot;, &quot;Baseline&quot;)&#10;&#10;END' />
            </column>
            <column caption='Customer Fail Rate Delta' datatype='real' name='[Vendor Fail Rate Delta (copy)_50876604591833091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(   // varient A&#10;    (SUM(IF [experiment_group] = [Parameters].[Parameter 2] THEN [customer_failed_orders] END)&#10;      / SUM(IF [experiment_group] = [Parameters].[Parameter 2] THEN [orders] END) &#10;     ) &#10;    &#10;/&#10;  // Baseline&#10;    (SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [customer_failed_orders] END)&#10;    / SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END) &#10;    )&#10;)&#10;- 1' />
            </column>
            <column-instance column='[rollout_phase]' derivation='Attribute' name='[attr:rollout_phase:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[auto_accept_seconds]' role='dimension' type='nominal' />
