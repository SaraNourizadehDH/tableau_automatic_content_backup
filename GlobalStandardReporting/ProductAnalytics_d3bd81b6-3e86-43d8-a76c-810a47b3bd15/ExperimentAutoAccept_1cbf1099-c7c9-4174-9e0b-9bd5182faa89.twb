          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hr6f8u087m4kg1bqrbfm17yze5s'>
            <column caption='On Time Orders Delta' datatype='real' name='[Calculation_1984680089640124429]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(   // varient A&#10;  SUM(IF [experiment_group] = [Parameters].[Parameter 2] THEN [on_time_order] END)&#10;/  SUM(IF [experiment_group] = [Parameters].[Parameter 2] THEN [orders] END) &#10;)    &#10;    &#10;/&#10;(  // Baseline&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [on_time_order] END)&#10;/SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END) &#10;    &#10;)&#10;- 1' />
            </column>
            <column caption='%On Time Orders' datatype='real' name='[Calculation_1984680089640300558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([on_time_order])/SUM([orders])' />
            </column>
            <column caption='_granularity_filter' datatype='boolean' name='[Calculation_4565524148946161665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &quot;Daily&quot; THEN [date_type] = &quot;Daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [date_type] = &quot;Weekly&quot;&#10;&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_4565524148946345986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date_local]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date_local]))+&quot;-W&quot;+STR([weeks])&#10;END' />
            </column>
            <column caption='_view_charts_or_tab' datatype='string' name='[Calculation_4565524149402353741]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
            </column>
            <column caption='Variants filter' datatype='boolean' name='[Variants (copy)_1879126963555889156]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;&#10;WHEN &quot;Variant A&quot; THEN [experiment_group] IN (&quot;Variant A&quot;, &quot;Baseline&quot;)&#10;WHEN &quot;Variant B&quot; THEN [experiment_group] IN (&quot;Variant B&quot;, &quot;Baseline&quot;)&#10;&#10;END' />
            </column>
            <column datatype='string' name='[auto_accept_seconds]' role='dimension' type='nominal' />
            <column caption='Created Date Local' datatype='date' name='[created_date_local]' role='dimension' type='ordinal' />
            <column caption='Date Type' datatype='string' name='[date_type]' role='dimension' type='nominal' />
            <column caption='Entity Id' datatype='string' name='[entity_id]' role='dimension' type='nominal' />
            <column caption='Experiment' datatype='string' name='[experiment]' role='dimension' type='nominal' />
            <column caption='Experiment Group' datatype='string' name='[experiment_group]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4565524148946161665]' derivation='None' name='[none:Calculation_4565524148946161665:nk]' pivot='key' type='nominal' />
