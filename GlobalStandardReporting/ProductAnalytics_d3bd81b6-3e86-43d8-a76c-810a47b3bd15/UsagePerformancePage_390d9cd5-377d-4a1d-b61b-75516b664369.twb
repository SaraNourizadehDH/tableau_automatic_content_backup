      <aliases enabled='yes' />
      <column caption='_user_entitlement' datatype='boolean' name='[Calculation_302655980935065600]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_302655980936810497]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date]))+&quot;-W&quot;+STR(ISOWEEK([created_date]))&#10;END' />
      </column>
      <column caption='Checkin Clicked % of Checkin Displayed' datatype='real' name='[Calculation_501518050963824641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([checkin_clicked_vendors])/SUM([checkin_displayed_vendors])' />
      </column>
      <column caption='Checkin Displayed % of Total Vendors' datatype='real' name='[Checkin Clicked % of Checkin Displayed (copy)_501518050992689166]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([checkin_displayed_vendors])/SUM([total_vendors])' />
      </column>
      <column caption='Navigation Drawer Item Clicked % of Navigation Drawer Shown' datatype='real' name='[Checkin Clicked % of Navigation Drawer Item Shown (copy)_501518050965114883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([navigation_drawer_item_clicked_vendors])/SUM([navigation_drawer_shown_vendors])' />
      </column>
      <column caption='Navigation Drawer Shown % of Checkin Clicked' datatype='real' name='[Checkin Displayed % of Checkin Clicked (copy)_501518050964795394]' role='measure' type='quantitative'>
