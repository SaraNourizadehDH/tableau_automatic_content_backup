      <aliases enabled='yes' />
      <column caption='ALLL vendors activated AB' datatype='integer' name='[ALLL vendors activated (copy)_2618561732553244691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [rn] = 1 AND [Grade_group_flag]= &apos;AB&apos; THEN [grid_id] END)' />
      </column>
      <column caption='AVG FOOD VALUE EXISTING F90' datatype='real' name='[AVG FOOD VALUE (copy)_2618561732539715600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Incremental Revenue AB NEW F90 (copy)_2618561732502904835])/SUM([Incremental Orders AB New  (copy)_2618561732533870603])' />
      </column>
      <column datatype='real' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_2618561732502188034]) - LOOKUP(ZN([Calculation_2618561732502188034]), -1)'>
