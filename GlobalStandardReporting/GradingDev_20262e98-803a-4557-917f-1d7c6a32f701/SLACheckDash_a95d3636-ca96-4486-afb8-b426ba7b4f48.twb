        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1b29b7l06ok5771c6l9ku1ue9a50' name='Custom SQL Query' type='text'>(Select  entity, vertical__c, is_key_account, 
  date(lead_created_date) as ldt, 
  CASE WHEN date(lead_created_date) between &apos;2023-05-21&apos; AND &apos;2023-05-25&apos; THEN &apos;PRE-SLA&apos; ELSE&apos;POST-SLA&apos; END as SLA,
  (TIMESTAMP_DIFF(graded_at,lead_created_date,HOUR)) AS age_of_comparision,
  lead_id as grid_id 
  from `dh-global-sales-data-dev`.`temp_rsa`.`adhoc_tablegardingfinal_03052023`
  where lead_created_date &gt;&gt;= &apos;2023-05-21&apos;
  and is_key_account = FALSE
 and lead_status not in (&apos;Lost&apos;,&apos;Terminated&apos;,&apos;Win Back failed&apos;,&apos;Perdido&apos;) AND lead_status is not null
  and vertical__c is not NULL and vertical__c in (&apos;Restaurant&apos;)
  Group by 1,2,3,4,5,6,7
  having age_of_comparision &gt;&gt;= 0)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1b29b7l06ok5771c6l9ku1ue9a50' name='Custom SQL Query' type='text'>(Select  entity, vertical__c, is_key_account, 
