      <column caption='Category (Pre)' datatype='real' name='[Brand  (copy)_4286371331554304001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10; [Parameters].[Parameter 2] = &quot;7 Days&quot; &#10;   THEN (&#10;          IF &#10;            [Parameters].[Parameter 3] = &quot;Order count&quot; THEN { FIXED [analytical_customer_id],[brand_name]: SUM([pre_campaign_7_days_category_orders])}&#10;       ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Qty Ordered&quot; THEN  { FIXED [analytical_customer_id],[brand_name]: SUM([pre_campaign_7_days_category_qty_ordered])}&#10;         END&#10;        )&#10;ELSEIF &#10; [Parameters].[Parameter 2] = &quot;14 Days&quot;&#10;   THEN (&#10;         IF [Parameters].[Parameter 3] = &quot;Order count&quot; THEN { FIXED [analytical_customer_id],[brand_name]: SUM([pre_campaign_14_days_category_orders])}&#10;        ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Qty Ordered&quot; THEN { FIXED [analytical_customer_id],[brand_name]: SUM([pre_campaign_14_days_category_qty_ordered])}&#10;        END&#10;        )&#10;END' />
      </column>
