            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gushkp0ezbpb415r73hn1ymf7vf'>
            <column caption='Granularity' datatype='string' name='[Calculation_1410752649278832641]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;DH Group&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country&quot; THEN [country_name]&#13;&#10;END' />
            </column>
            <column caption='Split' datatype='string' name='[Calculation_1410752649280139268]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &quot;Vertical Parent&quot; THEN [vertical_parent]&#13;&#10;    WHEN &quot;Vertical Type&quot; THEN [vertical_type]&#13;&#10;    WHEN &quot;AAA Chain Name&quot; THEN [aaa_chain_name_cleaned]&#13;&#10;    WHEN &quot;Nothing&quot; THEN NULL&#13;&#10;END' />
