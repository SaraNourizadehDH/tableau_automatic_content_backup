            <column-instance column='[FIXED CVR - Conversions / Sessions (copy)_182184682779570184]' derivation='Median' name='[med:FIXED CVR - Conversions / Sessions (copy)_182184682779570184:qk]' pivot='key' type='quantitative' />
            <column-instance column='[FIXED Frequency (copy)_182184682779426822]' derivation='Median' name='[med:FIXED Frequency (copy)_182184682779426822:qk]' pivot='key' type='quantitative' />
