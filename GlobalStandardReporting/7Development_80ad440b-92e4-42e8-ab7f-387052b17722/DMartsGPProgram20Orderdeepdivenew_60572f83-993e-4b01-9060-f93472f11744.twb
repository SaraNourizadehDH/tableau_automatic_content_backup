      </column>
      <column caption='Daily Orders Per Store' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1053560894827261956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(AVG([orders_confirmed_daily]))' />
      </column>
      <column aggregation='Sum' caption='Store Age (Current Month)' datatype='integer' name='[Calculation_1053560894829027334]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Store&quot;&#13;&#10;    THEN&#13;&#10;        DATEDIFF(&apos;month&apos;,[store_first_order_date],NOW())&#13;&#10;    ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Frequency' datatype='real' name='[Calculation_1053560894860681232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_confirmed])/SUM([customers_dmart])' />
      </column>
      <column caption='AVG Dmart MAU' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_1053560894860963857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([customers_dmart])' />
      </column>
      <column caption='+/- X D/O/S' datatype='string' name='[Calculation_1053560894863626259]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1053560894827261956] &lt;= [Parameters].[Parameter 5] THEN &quot;-&quot;+STR([Parameters].[Parameter 5])+&quot; D/O/S&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1053560894827261956] &gt; [Parameters].[Parameter 5] THEN &quot;+&quot;+STR([Parameters].[Parameter 5])+&quot; D/O/S&quot;&#13;&#10;&#13;&#10;ELSE NULL&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='FIXED Covered Prospect MAU / Covered MAU' datatype='real' name='[Calculation_157837096186281985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :[Calculation_644859174375981057] }' />
      </column>
      <column caption='Share of Incentivized Orders' datatype='real' default-format='p0.0%' name='[Calculation_299489432926388235]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;    WHEN &quot;Vouchers&quot; THEN SUM([orders_w_vouchers])/SUM([orders_confirmed])&#13;&#10;    WHEN &quot;Free Delivery Fee&quot; THEN SUM([orders_w_fdf])/SUM([orders_confirmed])&#13;&#10;    WHEN &quot;Discounts&quot; THEN SUM([orders_w_discounts])/SUM([orders_confirmed])&#13;&#10;    WHEN &quot;Any&quot; THEN SUM([orders_incentivized])/SUM([orders_confirmed])&#13;&#10;END' />
      </column>
      <column caption='AVG Covered MAU' datatype='real' name='[Calculation_334110855393845250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([dmart_covered_mau])' />
      </column>
      <column caption='AVG Covered Prospect MAU / Covered MAU' datatype='real' name='[Calculation_644859174375981057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([dmart_covered_prospect_mau]/[dmart_covered_mau])' />
      </column>
      <column caption='Retention Rate 30d' datatype='real' default-format='p0.0%' name='[Calculation_695524724791033858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([n_retended_customer_trial_last_month])/SUM([n_customers_trials_last_month])' />
      </column>
      <column caption='AVG Covered Prospect MAU' datatype='real' name='[Calculation_864268917962711041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([dmart_covered_prospect_mau])' />
      </column>
      <column caption='Customer X-sells / Covered Prospect MAU' datatype='real' name='[Calculation_864268917962878978]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([crosssells])/[Calculation_864268917962711041]' />
      </column>
      <column caption='Session per covered MAUs' datatype='real' name='[Calculation_864268917964685315]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([n_sessions])/SUM([dmart_covered_mau])' />
      </column>
      <column caption='CVR - Conversions / Sessions' datatype='real' name='[Calculation_864268917964931076]' role='measure' type='quantitative'>
