      <size maxheight='900' maxwidth='1500' minheight='900' minwidth='1500' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='13778' id='5' type-v2='text' w='98934' x='533' y='889'>
            <formatted-text>
              <run bold='true' fontcolor='#d71d24' fontname='Tableau Bold' fontsize='16'>Glossary</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='84444' id='14' type-v2='text' w='98934' x='533' y='14667'>
            <formatted-text>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>Daily Orders Per Store:</run>
              <run fontcolor='#000000' fontsize='12'> The average number of daily orders per store, measured on a monthly basis.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>Store Age (Current Month)</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>:</run>
              <run fontcolor='#000000' fontsize='12'> Time difference between the first order date of each stores and current month </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>Dmart MAU:</run>
              <run fontcolor='#000000' fontsize='12'> Dmart monthly active users</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>Frequency:</run>
              <run fontcolor='#000000' fontsize='12'> The number of confirmed orders for dmart per monthly active user.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>Trials</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>:</run>
              <run fontcolor='#000000' fontsize='12'> The number of platform users who use dmart for the first time</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>Retention Rate 30d</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>:</run>
              <run fontcolor='#000000' fontsize='12'> The percentage of trial users who made a repeated purchase within 30 days after their first purchase</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>Covered Prospect MAU</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>:</run>
              <run fontcolor='#000000' fontsize='12'> The number of platform users who are covered by dmart</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>X-sells/ Covered Prosepct MAU</run>
              <run bold='true' fontcolor='#000000' fontsize='12'>:</run>
              <run fontcolor='#000000' fontsize='12'> The percentage of platform users who have never made a purchase before, made a purchase.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>Sessions</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>:</run>
              <run fontcolor='#000000' fontsize='12'> The number of times app users have opened the dmart.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>Covered MAU:</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='12'>Æ </run>
              <run fontcolor='#000000' fontsize='12'>The no.of monthly active dmart users </run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>Conversions:</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='12'>Æ </run>
              <run fontcolor='#000000' fontsize='12'>The number of completed purchases by the user.</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Bold' fontsize='12'>Dmart covered MAU:</run>
              <run fontcolor='#000000' fontname='Arial' fontsize='12'>Æ </run>
              <run fontcolor='#000000' fontsize='12'>The number of MAU in the platform</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
