            </column>
            <column caption='+/- X D/O/S' datatype='string' name='[Calculation_1053560894863626259]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1053560894827261956] &lt;= [Parameters].[Parameter 5] THEN &quot;-&quot;+STR([Parameters].[Parameter 5])+&quot; D/O/S&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1053560894827261956] &gt; [Parameters].[Parameter 5] THEN &quot;+&quot;+STR([Parameters].[Parameter 5])+&quot; D/O/S&quot;&#13;&#10;&#13;&#10;ELSE NULL&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Color' datatype='string' name='[Color (copy)_299489432904306695]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Structure (copy)_1053560894862991378]&#13;&#10;    WHEN &quot;DH Group&quot; THEN ATTR(&quot;DH Group&quot;)&#13;&#10;    WHEN &quot;Region&quot; THEN ATTR([region])&#13;&#10;    WHEN &quot;Management Entity&quot; THEN ATTR([management_entity])&#13;&#10;    WHEN &quot;Country&quot; THEN ATTR([country_name])&#13;&#10;    WHEN &quot;Store&quot; THEN ATTR([warehouse_name])&#13;&#10;    WHEN &quot;+/- 300 D/O/S&quot; THEN [Calculation_1053560894863626259]&#13;&#10;END' />
            </column>
            <column caption='FIXED AVG Dmart MAU' datatype='real' name='[FIXED  Covered Prospect MAU / Covered MAU (copy)_157837096210083842]' role='measure' type='quantitative'>
