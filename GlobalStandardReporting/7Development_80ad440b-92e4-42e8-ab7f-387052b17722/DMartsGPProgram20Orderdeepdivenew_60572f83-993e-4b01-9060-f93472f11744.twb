    <worksheet name='X-sells vs Covered prospect MAUs'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#d71d24' fontname='Tableau Bold' fontsize='16'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#666666' fontsize='10'>Please use filters (blue) and parameters (orange) on the right and zoom in/out to adjust the view to your needs</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Query v1' name='federated.0zs5t390z61j6a1aonsgc0b1rod1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Structure' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Store&quot;'>
              <calculation class='tableau' formula='&quot;Store&quot;' />
            </column>
            <column caption='D/O/S threshold' datatype='real' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='300.'>
              <calculation class='tableau' formula='300.' />
            </column>
            <column caption='Color by' datatype='string' name='[Structure (copy)_1053560894862991378]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
              <aliases>
                <alias key='&quot;+/- 300 D/O/S&quot;' value='D/O/S Threshold' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zs5t390z61j6a1aonsgc0b1rod1'>
            <column caption='Daily Orders Per Store' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1053560894827261956]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(AVG([orders_confirmed_daily]))' />
            </column>
            <column aggregation='Sum' caption='Store Age (Current Month)' datatype='integer' name='[Calculation_1053560894829027334]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Store&quot;&#13;&#10;    THEN&#13;&#10;        DATEDIFF(&apos;month&apos;,[store_first_order_date],NOW())&#13;&#10;    ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='AVG Dmart MAU' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_1053560894860963857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([customers_dmart])' />
            </column>
            <column caption='+/- X D/O/S' datatype='string' name='[Calculation_1053560894863626259]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1053560894827261956] &lt;= [Parameters].[Parameter 5] THEN &quot;-&quot;+STR([Parameters].[Parameter 5])+&quot; D/O/S&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1053560894827261956] &gt; [Parameters].[Parameter 5] THEN &quot;+&quot;+STR([Parameters].[Parameter 5])+&quot; D/O/S&quot;&#13;&#10;&#13;&#10;ELSE NULL&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='AVG Covered Prospect MAU' datatype='real' name='[Calculation_864268917962711041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([dmart_covered_prospect_mau])' />
            </column>
            <column caption='Customer X-sells / Covered Prospect MAU' datatype='real' name='[Calculation_864268917962878978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([crosssells])/[Calculation_864268917962711041]' />
            </column>
            <column caption='Color' datatype='string' name='[Color (copy)_299489432904306695]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Structure (copy)_1053560894862991378]&#13;&#10;    WHEN &quot;DH Group&quot; THEN ATTR(&quot;DH Group&quot;)&#13;&#10;    WHEN &quot;Region&quot; THEN ATTR([region])&#13;&#10;    WHEN &quot;Management Entity&quot; THEN ATTR([management_entity])&#13;&#10;    WHEN &quot;Country&quot; THEN ATTR([country_name])&#13;&#10;    WHEN &quot;Store&quot; THEN ATTR([warehouse_name])&#13;&#10;    WHEN &quot;+/- 300 D/O/S&quot; THEN [Calculation_1053560894863626259]&#13;&#10;END' />
            </column>
            <column caption='FIXED Covered Prospect MAU ' datatype='real' name='[FIXED Covered Prospect MAU / Covered MAU (copy)_182184682775478277]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED :[Calculation_864268917962711041] }' />
            </column>
            <column caption='FIXED Customer X-sells / Covered Prospect MAU' datatype='real' name='[FIXED Retention Rate 30D (copy)_182184682775113732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED :[Calculation_864268917962878978] }' />
            </column>
