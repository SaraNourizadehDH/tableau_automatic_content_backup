            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Customer Trials' datatype='integer' name='[customer_trials]' role='measure' type='quantitative' />
            <column caption='Dmart MAU' datatype='integer' name='[customers_dmart]' role='measure' type='quantitative' />
            <column caption='Month' datatype='date' datatype-customized='true' name='[date_trunc_month]' role='dimension' type='ordinal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
