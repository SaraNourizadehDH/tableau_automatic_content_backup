          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.1gu1imr1gh7dn616rojrv158ctlu'>
            <column caption='@Activity last 7 days' datatype='integer' name='[Calculation_267471614722744323]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [country] : MAX(IF DATEDIFF(&apos;day&apos;, [task_date],&#10;    {FIXED : MAX([task_date])}) &lt;= 7 &#10;    AND [tasks] &gt; 0 &#10;THEN 1 ELSE 0 END)}' />
            </column>
            <column caption='Enablement_adoptionn' datatype='string' name='[Calculation_267471614722875396]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [enablement] = &quot;Enabled&quot; AND [Calculation_267471614722744323] = 1 THEN &quot;Enabled and using&quot;&#10;ELSEIF [enablement] = &quot;Enabled&quot; AND [Calculation_267471614722744323] = 0 THEN &quot;Enabled and not using&quot;&#10;ELSE &quot;Not enabled&quot;&#10;END' />
            </column>
            <column caption='# Compl. tasks last 7 days' datatype='integer' name='[Calculation_267471614724706309]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [task_status] = &apos;COMPLETE&apos; AND DATEDIFF(&apos;day&apos;, [task_date], {FIXED : MAX([task_date])}) &lt;= 7 THEN [tasks]&#10;    ELSE NULL&#10;    END&#10;)' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Enablement' datatype='string' name='[enablement]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_267471614722875396]' derivation='None' name='[none:Calculation_267471614722875396:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
