      <aliases enabled='yes' />
      <column caption='#d active countries' datatype='integer' default-format='n#,##0;-#,##0' name='[# d warehouses (copy)_267471614725832710]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF[tasks] &gt; 0 THEN [global_entity_id] ELSE NULL END)' />
      </column>
      <column caption='#d warehouses (total)' datatype='integer' default-format='n#,##0;-#,##0' name='[# d warehouses (copy)_3865636623214194690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( [global_warehouse_id])' />
      </column>
      <column caption='# Non-active warehouses' datatype='integer' default-format='n#,##0;-#,##0' name='[# d warehouses (total) (copy)_3865636623216156675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[# d warehouses (copy)_3865636623214194690]-[Calculation_2559522349828423681]' />
      </column>
      <column caption='#f Countries' datatype='integer' name='[#f Warehouses (copy)_1851964636292513800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [region] : COUNTD([country]) }' />
      </column>
      <column caption='#countries w/ completed tasks' datatype='integer' name='[#whouse w/ completed tasks (copy)_94927468562153476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF {FIXED [task_date],[region],[country] : MAX(IF [task_status] = &apos;COMPLETE&apos; &#10;                                THEN 1 ELSE 0 END)} = 1 &#10;                                    THEN [country] END)' />
      </column>
      <column caption='#whouse w/  any tasks' datatype='integer' name='[#whouse w/ completed tasks (copy)_94927468569092101]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF ISNULL([task_status]) THEN NULL&#10;            ELSE [global_warehouse_id]&#10;END)' />
      </column>
      <column caption='%whouses w. completed task' datatype='real' default-format='p0%' name='[%f adopting warehouses (copy)_3865636623214088193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_94927468510826497]/ [# d warehouses (copy)_3865636623214194690]' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1gu1imr1gh7dn616rojrv158ctlu].[sum:Calculation_1851964636286083073:qk]&quot;' value='Distinct warehouses' />
          <alias key='&quot;[federated.1gu1imr1gh7dn616rojrv158ctlu].[sum:Calculation_267471614736625672:qk]&quot;' value='# Shifts' />
          <alias key='&quot;[federated.1gu1imr1gh7dn616rojrv158ctlu].[sum:Calculation_267471614739099658:qk]&quot;' value='# Tasks' />
          <alias key='&quot;[federated.1gu1imr1gh7dn616rojrv158ctlu].[usr:\# d warehouses (copy)_267471614725832710:qk]&quot;' value='#countries with any task' />
          <alias key='&quot;[federated.1gu1imr1gh7dn616rojrv158ctlu].[usr:\# d warehouses (copy)_3865636623214194690:qk]&quot;' value='# Total warehouses' />
          <alias key='&quot;[federated.1gu1imr1gh7dn616rojrv158ctlu].[usr:Calculation_1851964636288630788:qk]&quot;' value='Non-adopting warehouses' />
          <alias key='&quot;[federated.1gu1imr1gh7dn616rojrv158ctlu].[usr:Calculation_2559522349828423681:qk]&quot;' value='#whouses with any task' />
          <alias key='&quot;[federated.1gu1imr1gh7dn616rojrv158ctlu].[usr:Calculation_94927468510826497:qk]&quot;' value='#whouses w. completed task' />
        </aliases>
      </column>
      <column aggregation='Attribute' caption='#f Warehouses' datatype='integer' name='[Calculation_1851964636286083073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [task_status], [task_date], [week_label], [enablement]: COUNTD([global_warehouse_id]) }' />
      </column>
      <column caption='#f Non-active warehouses' datatype='integer' name='[Calculation_1851964636288630788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[# d warehouses (copy)_3865636623214194690] - [Calculation_94927468510826497]' />
      </column>
      <column caption='#date First task date' datatype='date' name='[Calculation_1851964636290678790]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MIN([task_date])' />
      </column>
      <column caption='#d active warehouses' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2559522349828423681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF[tasks] &gt; 0 THEN [global_warehouse_id] ELSE NULL END)' />
      </column>
      <column caption='@Activity last 7 days' datatype='integer' name='[Calculation_267471614722744323]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [country] : MAX(IF DATEDIFF(&apos;day&apos;, [task_date],&#10;    {FIXED : MAX([task_date])}) &lt;= 7 &#10;    AND [tasks] &gt; 0 &#10;THEN 1 ELSE 0 END)}' />
      </column>
      <column caption='Enablement_adoptionn' datatype='string' name='[Calculation_267471614722875396]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [enablement] = &quot;Enabled&quot; AND [Calculation_267471614722744323] = 1 THEN &quot;Enabled and using&quot;&#10;ELSEIF [enablement] = &quot;Enabled&quot; AND [Calculation_267471614722744323] = 0 THEN &quot;Enabled and not using&quot;&#10;ELSE &quot;Not enabled&quot;&#10;END' />
      </column>
      <column caption='# Compl. tasks last 7 days' datatype='integer' name='[Calculation_267471614724706309]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [task_status] = &apos;COMPLETE&apos; AND DATEDIFF(&apos;day&apos;, [task_date], {FIXED : MAX([task_date])}) &lt;= 7 THEN [tasks]&#10;    ELSE NULL&#10;    END&#10;)' />
      </column>
      <column caption='# Agg shifts' datatype='integer' name='[Calculation_267471614736625672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_warehouse_id], [task_date], [global_entity_id] : MAX([shifts])}' />
      </column>
      <column caption='Tasks per shfit' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_267471614737887241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_267471614739099658])/SUM([Calculation_267471614736625672])' />
      </column>
      <column caption='#Agg tasks' datatype='integer' name='[Calculation_267471614739099658]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_warehouse_id], [task_date], [global_entity_id] : SUM([tasks])}' />
      </column>
      <column caption='# Total reciving time (minutes)' datatype='real' name='[Calculation_841187986081828865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [global_warehouse_id], [task_date], [global_entity_id] : MAX([st_receiving_time])})&#10;+SUM({FIXED [global_warehouse_id], [task_date], [global_entity_id] : MAX([po_receiving_time])})' />
      </column>
      <column caption='# Total picking time (minutes)' datatype='real' name='[Calculation_841187986082820099]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [global_warehouse_id], [task_date], [global_entity_id] : MAX([picking_time])})' />
      </column>
      <column caption='# Total packing time (minutes)' datatype='real' name='[Calculation_841187986082877444]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [global_warehouse_id], [task_date], [global_entity_id] : MAX([packing_time])})' />
      </column>
      <column caption='# Total task time (minutes)' datatype='real' name='[Calculation_841187986082926597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([task_duration_mins_capped])' />
      </column>
      <column caption='# Total working time (minutes)' datatype='real' name='[Calculation_841187986084044807]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [global_warehouse_id], [task_date], [global_entity_id] : MAX([inputed_working_time])})' />
      </column>
      <column caption='# Total idle time' datatype='real' name='[Calculation_841187986084319240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_841187986084044807]-[Calculation_841187986081828865]-[Calculation_841187986082820099]-[Calculation_841187986082877444]-[Calculation_841187986082926597]' />
      </column>
      <column caption='#whouse w/ completed tasks' datatype='integer' name='[Calculation_94927468510826497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [task_status] = &apos;COMPLETE&apos; &#10;&#10;                                    THEN [global_warehouse_id] END)' />
      </column>
      <column caption='# Total countries' datatype='integer' name='[Calculation_94927468561502211]' role='measure' type='quantitative'>
