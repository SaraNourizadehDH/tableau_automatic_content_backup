            <column-instance column='[task_date]' derivation='None' name='[none:task_date:qk]' pivot='key' type='quantitative' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
              <aliases>
                <alias key='&quot;America&quot;' value='Latin America' />
                <alias key='&quot;Asia&quot;' value='APAC' />
              </aliases>
            </column>
            <column caption='Task Date' datatype='date' name='[task_date]' role='dimension' type='ordinal' />
            <column caption='Task Status' datatype='string' name='[task_status]' role='dimension' type='nominal' />
            <column caption='Tasks' datatype='integer' name='[tasks]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_267471614724706309]' derivation='User' name='[usr:Calculation_267471614724706309:qk]' pivot='key' type='quantitative' />
