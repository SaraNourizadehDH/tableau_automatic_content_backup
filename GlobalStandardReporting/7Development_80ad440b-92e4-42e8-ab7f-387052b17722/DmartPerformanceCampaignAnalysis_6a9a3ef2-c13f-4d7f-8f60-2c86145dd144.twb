      <column caption='Campaign Reason' datatype='string' name='[Calculation_1201053789593493553]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF LOWER([campaign_reason])=&apos;overstock&apos; THEN &apos;overstock&apos;&#13;&#10;ELSEIF LOWER([campaign_reason])=&apos;delisting&apos; THEN &apos;delisting&apos;&#13;&#10;ELSEIF LOWER([campaign_reason])= &apos;competitiveness&apos; THEN &apos;competitiveness&apos;&#13;&#10;ELSEIF LOWER([campaign_reason])= &apos;expiring soon&apos; THEN &apos;expiring soon&apos;&#13;&#10;ELSEIF LOWER([campaign_reason])= &apos;nmr&apos; THEN &apos;nmr&apos; &#13;&#10;ELSEIF LOWER([campaign_reason])= &apos;trading&apos; THEN &apos;trading&apos;&#13;&#10;ELSE &apos;other&apos; &#13;&#10;END' />
