      </column>
      <column caption='Banner Shown' datatype='integer' name='[Calculation_4191795748178055169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [platform],[partition_date],[product_name],[global_product_id] : SUM([bnr_shown_sessions]) }' />
      </column>
      <column caption='  Banner Position' datatype='string' name='[Calculation_4191795748206272514]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE(&#10;(REPLACE(( &#10;REPLACE([banner_position],&apos;{&quot;&apos;,&quot;&quot;)),&apos;}&apos;,&quot;&quot;)), &apos;&quot;:&apos;,&apos; -&apos;)' />
      </column>
      <column caption='M : Product count ' datatype='integer' name='[Calculation_4191795748210106371]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([product_sku_be])' />
      </column>
      <column caption='Pre_Post_Metric' datatype='real' name='[Calculation_5533446232813338624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF     &#10;       [Parameters].[Parameter 1]=&apos;Orders&apos; THEN SUM([M : Banner_Campaign_Qty_sold (copy)_75576065643761673])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Sales&apos;  THEN sum([M : Banner_Campaign_Qty_sold (copy)_75576065646075914])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Qty Sold&apos;  THEN sum([M : Banner_ATC_sessions (copy)_75576065642893320])&#10;END' />
      </column>
      <column caption='Pre Campaign' datatype='real' name='[Calculation_5533446232819650569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF     &#10;       [Parameters].[Parameter 1]=&apos;Orders&apos;    THEN SUM([M : Banner_Campaign_orders (copy)_5533446232819126277])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Sales&apos;  THEN SUM([M : Banner_Campaign_Sales (copy)_5533446232818802691])&#10;ELSEIF [Parameters].[Parameter 1]=&apos;Qty Sold&apos;  THEN SUM([M : Banner_Campaign_Qty_sold (copy)_5533446232819367943])&#10;END' />
      </column>
      <column caption='M: Click through rate' datatype='real' name='[Calculation_6894799960911323136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([M : Banner_Shown_Users (copy)_75576065636261890])/SUM([Calculation_75576065630724096])' />
