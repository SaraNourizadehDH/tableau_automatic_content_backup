    <worksheet name='B: campaign_daily_performance '>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='12'>Day over day banner performance</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='trade_analysis_final_data (dev_dmart)' name='federated.01i039z0k209bd14l87j107kpgcd' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Metric' datatype='string' name='[Pre Post Metric (copy)_4370884220243017730]' param-domain-type='list' role='measure' type='nominal' value='&quot;Banner Orders&quot;'>
              <calculation class='tableau' formula='&quot;Banner Orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.01i039z0k209bd14l87j107kpgcd'>
            <column caption='B : Banner_Name' datatype='string' name='[Banner Name (copy)_5533446233502781452]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[banner_name]' />
            </column>
            <column caption='Banner Shown' datatype='integer' name='[Calculation_4191795748178055169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [platform],[partition_date],[product_name],[global_product_id] : SUM([bnr_shown_sessions]) }' />
            </column>
            <column caption='M: Click through rate' datatype='real' name='[Calculation_6894799960911323136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([M : Banner_Shown_Users (copy)_75576065636261890])/SUM([Calculation_75576065630724096])' />
            </column>
            <column caption='M : Banner_shown' datatype='real' name='[Calculation_75576065630724096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id],[banner_id],[partition_date], [platform] : AVG([Calculation_4191795748178055169]) }' />
            </column>
            <column caption='M : Banner_ATC_sessions' datatype='real' name='[M : Banner_Shown_Users (copy) (copy) (copy)_75576065636282372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id],[banner_id],[partition_date], [platform] : AVG([bnr_atc_sessions]) }' />
            </column>
            <column caption='M : Banner_Clicked_Sessions' datatype='real' name='[M : Banner_Shown_Users (copy)_75576065636261890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id],[partition_date], [platform],[banner_id]: AVG([bnr_clicked_sessions]) }' />
            </column>
            <column caption='M : Banner_Shown_Users' datatype='real' name='[M : Banner_shown (copy)_75576065635463169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id],[banner_id],[partition_date], [platform] : AVG([bnr_shown_users]) }' />
            </column>
            <column caption='Metric' datatype='real' name='[Pre_Post_Metric (copy)_4370884220242972673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF     &#10;  [Parameters].[Pre Post Metric (copy)_4370884220243017730]=&apos;Banner Orders&apos;    &#10;  THEN SUM([orders])&#10;&#10;ELSEIF &#10;  [Parameters].[Pre Post Metric (copy)_4370884220243017730]=&apos;Banner Qty Sold&apos;  &#10;  THEN SUM([Qty Sold (copy)_5533446232824221707])&#10;ELSEIF &#10;  [Parameters].[Pre Post Metric (copy)_4370884220243017730]=&apos;Banner Sessions&apos;  &#10;  THEN SUM([Calculation_75576065630724096])&#10;ELSEIF &#10;  [Parameters].[Pre Post Metric (copy)_4370884220243017730]=&apos;Banner Shown Users&apos;  &#10;  THEN SUM([M : Banner_shown (copy)_75576065635463169])&#10;ELSEIF &#10;  [Parameters].[Pre Post Metric (copy)_4370884220243017730]=&apos;Banner Clicks&apos;  &#10;  THEN SUM([M : Banner_Shown_Users (copy)_75576065636261890])&#10;ELSEIF &#10;  [Parameters].[Pre Post Metric (copy)_4370884220243017730]=&apos;Banner ATC Sessions&apos;  &#10;  THEN SUM([M : Banner_Shown_Users (copy) (copy) (copy)_75576065636282372])&#10;ELSEIF &#10;  [Parameters].[Pre Post Metric (copy)_4370884220243017730]=&apos;Banner CTR&apos;  &#10;  THEN ([Calculation_6894799960911323136])&#10;&#10;END' />
            </column>
            <column caption='M: Qty Sold' datatype='real' name='[Qty Sold (copy)_5533446232824221707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id],[product_sku_be],[partition_date], [platform],[global_product_id] : SUM([qty_sold]) }' />
            </column>
            <column caption='Banner Id' datatype='string' name='[banner_id]' role='dimension' type='nominal' />
            <column caption='Banner Name' datatype='string' name='[banner_name]' role='dimension' type='nominal' />
            <column caption='Bnr Atc Sessions' datatype='integer' name='[bnr_atc_sessions]' role='measure' type='quantitative' />
            <column caption='Bnr Clicked Sessions' datatype='integer' name='[bnr_clicked_sessions]' role='measure' type='quantitative' />
            <column caption='Bnr Shown Sessions' datatype='integer' name='[bnr_shown_sessions]' role='measure' type='quantitative' />
            <column caption='Bnr Shown Users' datatype='integer' name='[bnr_shown_users]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;FP_BD&quot;' value='Bangladesh' />
                <alias key='&quot;FP_HK&quot;' value='Hong Kong' />
                <alias key='&quot;FP_MY&quot;' value='Malaysia' />
                <alias key='&quot;FP_PH&quot;' value='Philippines' />
                <alias key='&quot;FP_PK&quot;' value='Pakistan' />
                <alias key='&quot;FP_TH&quot;' value='Thailand' />
                <alias key='&quot;FP_TW&quot;' value='Taiwan' />
                <alias key='&quot;HF_EG&quot;' value='Egypt' />
                <alias key='&quot;TB_KW&quot;' value='Kuwait' />
                <alias key='&quot;TB_OM&quot;' value='Oman' />
                <alias key='&quot;TB_QA&quot;' value='Qatar' />
                <alias key='&quot;YS_TR&quot;' value='Turkey' />
              </aliases>
            </column>
            <column caption='Global Product Id' datatype='string' name='[global_product_id]' role='dimension' type='nominal' />
            <column-instance column='[Banner Name (copy)_5533446233502781452]' derivation='None' name='[none:Banner Name (copy)_5533446233502781452:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[orders]' role='measure' type='quantitative' />
            <column caption='Partition Date' datatype='date' name='[partition_date]' role='dimension' type='ordinal' />
            <column caption='Platform' datatype='string' name='[platform]' role='dimension' type='nominal' />
            <column caption='Product Name' datatype='string' name='[product_name]' role='dimension' type='nominal' />
