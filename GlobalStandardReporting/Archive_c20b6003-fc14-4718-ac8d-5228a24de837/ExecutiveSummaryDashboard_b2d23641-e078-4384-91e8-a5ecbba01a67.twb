      <table>
        <view>
          <datasources>
            <datasource caption='okr_main (staging)' name='federated.1yz59ih11fea841e3awyr1dmf7dh' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Bi-weekly' caption='Trendlines aggregation' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;bi-weekly&quot;'>
              <calculation class='tableau' formula='&quot;bi-weekly&quot;' />
              <aliases>
                <alias key='&quot;bi-weekly&quot;' value='Bi-weekly' />
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Acceptance Rate target' datatype='real' datatype-customized='true' default-format='p0.0%' name='[Quantity target (copy)_5419308132926636035]' param-domain-type='range' role='measure' type='quantitative' value='0.44572286143071538'>
              <calculation class='tableau' formula='0.44572286143071538' />
              <range max='1.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1yz59ih11fea841e3awyr1dmf7dh'>
            <column caption='Acceptance Rate - Reporting P.' datatype='real' name='[Acceptance Rate (copy)_6707337634877673485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - [Failure Rate (copy)_6707337634877820942]' />
            </column>
            <column caption='Acceptance Rate - Prev. P.' datatype='real' name='[Acceptance Rate - Reporting P. (copy)_6707337634880303122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - [Failure Rate - Reporting P. (copy)_6707337634879324177]' />
            </column>
            <column caption='Date - Timeframe' datatype='date' name='[Calculation_5419308132924030978]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 4]&#10;WHEN &apos;bi-weekly&apos; THEN &#10;    (&#10;    IF DATEPART(&apos;week&apos;,[date], &apos;Monday&apos;)%2 != 0 THEN DATETRUNC(&apos;week&apos;, [date], &apos;Monday&apos;)&#10;       ELSE DATEADD(&apos;week&apos;,-1, DATETRUNC(&apos;week&apos;, [date], &apos;Monday&apos;))&#10;    END )&#10;&#10;WHEN &apos;day&apos; THEN DATETRUNC(&apos;day&apos;, [date], &apos;Monday&apos;)&#10;WHEN &apos;week&apos; THEN DATETRUNC(&apos;week&apos;, [date], &apos;Monday&apos;)&#10;WHEN &apos;month&apos; THEN DATETRUNC(&apos;month&apos;, [date], &apos;Monday&apos;)&#10;WHEN &apos;quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [date], &apos;Monday&apos;)&#10;END)' />
            </column>
            <column caption='Date - Last Full Period' datatype='date' datatype-customized='true' name='[Calculation_6707337633816190976]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE({MAX(&#10;CASE [Parameters].[Parameter 4]&#10;WHEN &apos;bi-weekly&apos; THEN DATEADD(&apos;week&apos;, -2, [Calculation_5419308132924030978])&#10;WHEN &apos;day&apos; THEN DATEADD(&apos;day&apos;, -1, [Calculation_5419308132924030978])&#10;WHEN &apos;week&apos; THEN DATEADD(&apos;week&apos;, -1, [Calculation_5419308132924030978])&#10;WHEN &apos;month&apos; THEN DATEADD(&apos;month&apos;, -1, [Calculation_5419308132924030978])&#10;WHEN &apos;quarter&apos; THEN DATEADD(&apos;quarter&apos;, -1, [Calculation_5419308132924030978])&#10;END)})' />
            </column>
            <column caption='Date - Report P. End' datatype='date' datatype-customized='true' name='[Calculation_6707337633862434818]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;, -1,&#10;CASE [Parameters].[Parameter 4]&#10;WHEN &apos;bi-weekly&apos; THEN DATEADD(&apos;week&apos;, 2, [Calculation_6707337634868895753])&#10;WHEN &apos;day&apos; THEN DATEADD(&apos;day&apos;, 1, [Calculation_6707337634868895753])&#10;WHEN &apos;week&apos; THEN DATEADD(&apos;week&apos;, 1, [Calculation_6707337634868895753])&#10;WHEN &apos;month&apos; THEN DATEADD(&apos;month&apos;, 1, [Calculation_6707337634868895753])&#10;WHEN &apos;quarter&apos; THEN DATEADD(&apos;quarter&apos;, 1, [Calculation_6707337634868895753])&#10;END))' />
            </column>
            <column caption='Is Prev. P.' datatype='boolean' name='[Calculation_6707337633863921667]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_5419308132924030978]=[Date - Report P. End (copy)_6707337633864224772]' />
