      </column>
      <column caption='Order Loss Rate' datatype='real' name='[Calculation_1899604312521015296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_loss_count]) / SUM([order_count])' />
      </column>
      <column caption='Online Payment Share' datatype='real' name='[Calculation_1899604312535035910]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([online_order_count]) / SUM([success_order_count])' />
      </column>
      <column caption='Failure Rate' datatype='real' name='[Calculation_5419308132922961920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_order_count]) / SUM([order_count])' />
      </column>
      <column caption='Acceptance Rate' datatype='real' name='[Calculation_5419308132923129857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_5419308132922961920]' />
      </column>
      <column caption='Date - Timeframe' datatype='date' name='[Calculation_5419308132924030978]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 4]&#10;WHEN &apos;bi-weekly&apos; THEN &#10;    (&#10;    IF DATEPART(&apos;week&apos;,[date], &apos;Monday&apos;)%2 != 0 THEN DATETRUNC(&apos;week&apos;, [date], &apos;Monday&apos;)&#10;       ELSE DATEADD(&apos;week&apos;,-1, DATETRUNC(&apos;week&apos;, [date], &apos;Monday&apos;))&#10;    END )&#10;&#10;WHEN &apos;day&apos; THEN DATETRUNC(&apos;day&apos;, [date], &apos;Monday&apos;)&#10;WHEN &apos;week&apos; THEN DATETRUNC(&apos;week&apos;, [date], &apos;Monday&apos;)&#10;WHEN &apos;month&apos; THEN DATETRUNC(&apos;month&apos;, [date], &apos;Monday&apos;)&#10;WHEN &apos;quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [date], &apos;Monday&apos;)&#10;END)' />
      </column>
      <column caption='Cost Per GMV' datatype='real' name='[Calculation_5431200476940845056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([success_order_cost]) / SUM(&#10;IIF(ISNULL([success_order_cost]),0,[success_order_gmv]))' />
      </column>
      <column caption='Acceptance Rate - Start' datatype='real' name='[Calculation_5431200477021409296]' role='measure' type='quantitative'>
