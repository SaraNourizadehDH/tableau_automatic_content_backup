      <layout-options>
        <title>
          <formatted-text>
            <run>Level 0 KPI</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='okr_main (staging)' name='federated.1yz59ih11fea841e3awyr1dmf7dh' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Order Loss Rate target' datatype='real' datatype-customized='true' default-format='p0.00%' name='[Order Loss target (copy)_1899604312524582917]' param-domain-type='range' role='measure' type='quantitative' value='0.0001'>
              <calculation class='tableau' formula='0.0001' />
              <range min='0.0' />
            </column>
            <column alias='Bi-weekly' caption='Trendlines aggregation' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;bi-weekly&quot;'>
              <calculation class='tableau' formula='&quot;bi-weekly&quot;' />
              <aliases>
                <alias key='&quot;bi-weekly&quot;' value='Bi-weekly' />
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1yz59ih11fea841e3awyr1dmf7dh'>
            <column caption='Order Loss Rate - Diff' datatype='real' name='[Acceptance Rate - Diff (copy)_1899604312523288579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Failure Rate - Reporting P. (copy)_1899604312522862593] - [Failure Rate - Prev. P. (copy)_1899604312523108354]' />
            </column>
            <column caption='Date - Timeframe' datatype='date' name='[Calculation_5419308132924030978]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 4]&#10;WHEN &apos;bi-weekly&apos; THEN &#10;    (&#10;    IF DATEPART(&apos;week&apos;,[date], &apos;Monday&apos;)%2 != 0 THEN DATETRUNC(&apos;week&apos;, [date], &apos;Monday&apos;)&#10;       ELSE DATEADD(&apos;week&apos;,-1, DATETRUNC(&apos;week&apos;, [date], &apos;Monday&apos;))&#10;    END )&#10;&#10;WHEN &apos;day&apos; THEN DATETRUNC(&apos;day&apos;, [date], &apos;Monday&apos;)&#10;WHEN &apos;week&apos; THEN DATETRUNC(&apos;week&apos;, [date], &apos;Monday&apos;)&#10;WHEN &apos;month&apos; THEN DATETRUNC(&apos;month&apos;, [date], &apos;Monday&apos;)&#10;WHEN &apos;quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [date], &apos;Monday&apos;)&#10;END)' />
            </column>
            <column caption='Date - Last Full Period' datatype='date' datatype-customized='true' name='[Calculation_6707337633816190976]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE({MAX(&#10;CASE [Parameters].[Parameter 4]&#10;WHEN &apos;bi-weekly&apos; THEN DATEADD(&apos;week&apos;, -2, [Calculation_5419308132924030978])&#10;WHEN &apos;day&apos; THEN DATEADD(&apos;day&apos;, -1, [Calculation_5419308132924030978])&#10;WHEN &apos;week&apos; THEN DATEADD(&apos;week&apos;, -1, [Calculation_5419308132924030978])&#10;WHEN &apos;month&apos; THEN DATEADD(&apos;month&apos;, -1, [Calculation_5419308132924030978])&#10;WHEN &apos;quarter&apos; THEN DATEADD(&apos;quarter&apos;, -1, [Calculation_5419308132924030978])&#10;END)})' />
            </column>
            <column caption='Order Loss Count - Reporting P.' datatype='integer' name='[Calculation_6707337633861529601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_93520122110033922],[order_loss_count],Null)' />
            </column>
            <column caption='Date - Report P. End' datatype='date' datatype-customized='true' name='[Calculation_6707337633862434818]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;, -1,&#10;CASE [Parameters].[Parameter 4]&#10;WHEN &apos;bi-weekly&apos; THEN DATEADD(&apos;week&apos;, 2, [Calculation_6707337634868895753])&#10;WHEN &apos;day&apos; THEN DATEADD(&apos;day&apos;, 1, [Calculation_6707337634868895753])&#10;WHEN &apos;week&apos; THEN DATEADD(&apos;week&apos;, 1, [Calculation_6707337634868895753])&#10;WHEN &apos;month&apos; THEN DATEADD(&apos;month&apos;, 1, [Calculation_6707337634868895753])&#10;WHEN &apos;quarter&apos; THEN DATEADD(&apos;quarter&apos;, 1, [Calculation_6707337634868895753])&#10;END))' />
            </column>
            <column caption='Is Prev. P.' datatype='boolean' name='[Calculation_6707337633863921667]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_5419308132924030978]=[Date - Report P. End (copy)_6707337633864224772]' />
            </column>
            <column caption='Date - Report P. (Fixed)' datatype='date' name='[Calculation_6707337634868895753]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Calculation_6707337633816190976]' />
            </column>
            <column caption='Is Report P.' datatype='boolean' name='[Calculation_93520122110033922]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_5419308132924030978]=[Calculation_6707337634868895753]' />
            </column>
            <column caption='Date - Prev. P.' datatype='date' datatype-customized='true' name='[Date - Report P. End (copy)_6707337633864224772]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(&#10;CASE [Parameters].[Parameter 4]&#10;WHEN &apos;bi-weekly&apos; THEN DATEADD(&apos;week&apos;, -2, [Calculation_6707337634868895753])&#10;WHEN &apos;day&apos; THEN DATEADD(&apos;day&apos;, -1, [Calculation_6707337634868895753])&#10;WHEN &apos;week&apos; THEN DATEADD(&apos;week&apos;, -1, [Calculation_6707337634868895753])&#10;WHEN &apos;month&apos; THEN DATEADD(&apos;month&apos;, -1, [Calculation_6707337634868895753])&#10;WHEN &apos;quarter&apos; THEN DATEADD(&apos;quarter&apos;, -1, [Calculation_6707337634868895753])&#10;END)' />
            </column>
            <column caption='Order Count - Reporting P.' datatype='integer' name='[Fail Order Count - Reporting P. (copy)_6707337634877444108]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_93520122110033922],[order_count],Null)' />
            </column>
            <column caption='Order Loss Rate - Prev. P.' datatype='real' name='[Failure Rate - Prev. P. (copy)_1899604312523108354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Order Loss Count - Reporting P. (copy)_6707337633864990726]) / SUM([Order Count - Reporting P. (copy)_6707337634879205392])' />
            </column>
            <column caption='Order Loss Rate - Reporting P.' datatype='real' name='[Failure Rate - Reporting P. (copy)_1899604312522862593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6707337633861529601]) / SUM([Fail Order Count - Reporting P. (copy)_6707337634877444108])' />
            </column>
            <column caption='Order Count - Prev. P.' datatype='integer' name='[Order Count - Reporting P. (copy)_6707337634879205392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_6707337633863921667],[order_count],Null)' />
            </column>
            <column caption='Order Loss Count - Prev. P.' datatype='integer' name='[Order Loss Count - Reporting P. (copy)_6707337633864990726]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_6707337633863921667],[order_loss_count],Null)' />
            </column>
            <column caption='Order Loss Rate - Target Prop.' datatype='real' name='[Order Loss Count - Target Prop. (copy)_1899604312524447748]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Failure Rate - Reporting P. (copy)_1899604312522862593]/[Parameters].[Order Loss target (copy)_1899604312524582917]' />
            </column>
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
