      <column caption='CPG' datatype='real' name='[Calculation_464996684815224832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([success_order_cost_cpo])/sum([success_order_gmv_cpo])' />
      </column>
      <column caption='Acceptance Rate' datatype='real' name='[Calculation_464996684817027073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-sum([fail_order_count])/sum([order_count])' />
      </column>
      <column caption='OP share' datatype='real' name='[Calculation_5302425637806829568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([online_order_count])/sum([success_order_count])' />
      </column>
      <column caption='last month quarter' datatype='boolean' name='[Calculation_5302425637816557571]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF date = DATEADD(&apos;month&apos;,2,DATETRUNC(&apos;quarter&apos;,date)) then true else false end' />
      </column>
      <column caption='diff target' datatype='real' name='[Calculation_5302425637829910532]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((sum([success_order_cost])/sum([success_order_gmv]))*100-max([federated.02l0fpt0szvcri12fkvq504dhyip].[cpo_target])*100)*100' />
      </column>
      <column caption='diff target color' datatype='boolean' name='[Calculation_5302425637834821637]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_5302425637829910532] &gt; 0 then true&#10;else false&#10;end' />
      </column>
      <column caption='1' datatype='integer' name='[Calculation_5302425637857587206]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='cpo vs target' datatype='real' name='[Calculation_6849834324700094465]' role='measure' type='quantitative'>
