      <aliases enabled='yes' />
      <column caption='Acceptance Rate - Reporting P.' datatype='real' name='[Acceptance Rate (copy)_6707337634877673485]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Failure Rate (copy)_6707337634877820942]' />
      </column>
      <column caption='Order Loss Rate - Diff' datatype='real' name='[Acceptance Rate - Diff (copy)_1899604312523288579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Failure Rate - Reporting P. (copy)_1899604312522862593] - [Failure Rate - Prev. P. (copy)_1899604312523108354]' />
      </column>
      <column caption='Online Payment Share - Diff' datatype='real' name='[Acceptance Rate - Diff (copy)_1899604312570023951]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Acceptance Rate - Reporting P. (copy)_1899604312569069578] - [Failure Rate - Prev. P. (copy)_1899604312569839630]' />
      </column>
      <column caption='Online Payment Share - Reporting P.' datatype='real' name='[Acceptance Rate - Reporting P. (copy)_1899604312569069578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Fail Order Count - Reporting P. (copy)_1899604312567947272]) / SUM([Online Order Count - Reporting P. (copy)_1899604312568926217])' />
      </column>
      <column caption='Acceptance Rate - Prev. P.' datatype='real' name='[Acceptance Rate - Reporting P. (copy)_6707337634880303122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Failure Rate - Reporting P. (copy)_6707337634879324177]' />
