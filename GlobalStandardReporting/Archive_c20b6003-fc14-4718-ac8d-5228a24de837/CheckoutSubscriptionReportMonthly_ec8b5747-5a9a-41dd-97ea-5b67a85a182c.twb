      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0r35n5u1sg8r8h172z6dn0mtoktf].[avg:Calculation_1583578225570439168:qk]&quot;' value='Avg.Amt per Order' />
          <alias key='&quot;[federated.0r35n5u1sg8r8h172z6dn0mtoktf].[sum:amount:qk]&quot;' value='Amount in lc' />
          <alias key='&quot;[federated.0r35n5u1sg8r8h172z6dn0mtoktf].[sum:orders:qk]&quot;' value='All Transactions' />
          <alias key='&quot;[federated.0r35n5u1sg8r8h172z6dn0mtoktf].[sum:unique_subscriber:qk]&quot;' value='New Subscribers' />
          <alias key='&quot;[federated.0r35n5u1sg8r8h172z6dn0mtoktf].[usr:Calculation_1583578225570570242:qk]&quot;' value='Subscriber Retention' />
        </aliases>
      </column>
      <column caption='month_PM_1' datatype='integer' name='[Calculation_1445374013400277006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [num_months]=0 THEN [unique_subscriber] ELSE 0 END' />
      </column>
      <column caption='month_PM_2' datatype='integer' name='[Calculation_1445374013407158289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [num_months]=1 THEN [unique_subscriber] ELSE 0 END' />
      </column>
      <column caption='KPI_2nd_month' datatype='real' name='[Calculation_1445374013407285266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='TOTAL(SUM([Calculation_1445374013407158289]))/TOTAL(SUM([Calculation_1445374013400277006]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg.AmtperOrder' datatype='real' name='[Calculation_1583578225570439168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[amount]/[orders]' />
      </column>
      <column caption='Stable Cohort Base' datatype='integer' name='[Calculation_1583578225570496513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [subsequent_month] : sum(if [subsequent_month] = [subscription_month] then [unique_subscriber] else 0 end)}' />
      </column>
      <column caption='Customer Retention' datatype='real' name='[Calculation_1583578225570570242]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unique_subscriber])/ATTR([Calculation_1583578225570496513])' />
      </column>
      <column caption='Customer Retention v2' datatype='string' name='[Calculation_1583578225570615299]' role='measure' type='nominal'>
        <calculation class='tableau' formula='str(ROUND([Calculation_1583578225570570242]*100,0))+&apos;%&apos;' />
      </column>
      <column caption='New Customers' datatype='integer' name='[Calculation_1583578225570660356]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(sum([unique_subscriber]),first())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Amount (lc)' datatype='real' name='[Calculation_1583578225570717701]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([amount])' />
      </column>
      <column caption='Username Active' datatype='boolean' name='[Calculation_3023956108642824192]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
