      <column caption='Global Entity Id (Tableau Entitlements Gsr Payment Global Entity Id)' datatype='string' name='[global_entity_id (tableau_entitlements_gsr_payment_global_entity_id)]' role='dimension' type='nominal' />
      <column caption='Udf4_Like_20__' datatype='integer' name='[udf4_like_20__]' role='measure' type='quantitative' />
      <column caption='Username' datatype='string' name='[username]' role='dimension' type='nominal' />
      <column-instance column='[udf4_like_20__]' derivation='Sum' name='[sum:udf4_like_20__:qk]' pivot='key' type='quantitative' />
      <group name='[User Filter 1]' name-style='unqualified' user:ui-builder='identity-set'>
        <groupfilter function='intersection'>
          <groupfilter function='level-members' level='[business_name]' />
          <groupfilter function='union'>
            <groupfilter expression='false' function='filter'>
              <groupfilter function='level-members' level='[business_name]' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;gsr_performance_carriage_enduser&apos;)' function='filter'>
              <groupfilter function='union'>
                <groupfilter function='member' level='[business_name]' member='&quot;Carriage Food - AED DXB Recurring&quot;' />
                <groupfilter function='member' level='[business_name]' member='&quot;Carriage Food - BHD Recurring&quot;' />
                <groupfilter function='member' level='[business_name]' member='&quot;Carriage Food - KWD Recurring&quot;' />
                <groupfilter function='member' level='[business_name]' member='&quot;Carriage Food - QAR Recurring&quot;' />
                <groupfilter function='member' level='[business_name]' member='&quot;Carriage Food - SAR Recurring&quot;' />
              </groupfilter>
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;gsr_performance_developer&apos;)' function='filter'>
              <groupfilter function='union'>
                <groupfilter function='member' level='[business_name]' member='&quot;Carriage Food - AED DXB Recurring&quot;' />
                <groupfilter function='member' level='[business_name]' member='&quot;Carriage Food - BHD Recurring&quot;' />
                <groupfilter function='member' level='[business_name]' member='&quot;Carriage Food - KWD Recurring&quot;' />
                <groupfilter function='member' level='[business_name]' member='&quot;Carriage Food - QAR Recurring&quot;' />
                <groupfilter function='member' level='[business_name]' member='&quot;Carriage Food - SAR Recurring&quot;' />
