      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/SubscriptionReport_15759976238590/Dashboard-Lost_Canceled?rev=' id='Dashboard-Lost_Canceled' path='/t/GlobalStandardReporting/workbooks/SubscriptionReport_15759976238590' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='parameter-ctrl'>
          <format attr='font-family' value='Segoe UI' />
        </style-rule>
