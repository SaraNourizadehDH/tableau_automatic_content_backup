      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1be48uf0c07umm11iswok0clsei2].[pcto:sum:all_trx:qk:3]&quot;' value='% of Total' />
        </aliases>
      </column>
      <column caption='Succ_Trx_PM_1' datatype='integer' name='[Calculation_1445374013419270166]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LEN(STR(MONTH(DATEADD(&apos;month&apos;, -1, TODAY()))))=1 THEN&#13;&#10;    IF [action_month] = STR(YEAR(DATEADD(&apos;month&apos;, -1, TODAY()))) + &apos;-0&apos; + STR(MONTH(DATEADD(&apos;month&apos;, -1, TODAY()))) THEN&#13;&#10;        [successful_trx] ELSE 0 END&#13;&#10;ELSE&#13;&#10;    IF [action_month] = STR(YEAR(DATEADD(&apos;month&apos;, -1, TODAY()))) + &apos;-&apos; + STR(MONTH(DATEADD(&apos;month&apos;, -1, TODAY()))) THEN&#13;&#10;        [successful_trx] ELSE 0 END&#13;&#10;END' />
      </column>
      <column caption='All_Trx_PM_1' datatype='integer' name='[Calculation_1445374013419917335]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LEN(STR(MONTH(DATEADD(&apos;month&apos;, -1, TODAY()))))=1 THEN&#13;&#10;    IF [action_month] = STR(YEAR(DATEADD(&apos;month&apos;, -1, TODAY()))) + &apos;-0&apos; + STR(MONTH(DATEADD(&apos;month&apos;, -1, TODAY()))) THEN&#13;&#10;        [all_trx] ELSE 0 END&#13;&#10;ELSE&#13;&#10;    IF [action_month] = STR(YEAR(DATEADD(&apos;month&apos;, -1, TODAY()))) + &apos;-&apos; + STR(MONTH(DATEADD(&apos;month&apos;, -1, TODAY()))) THEN&#13;&#10;        [all_trx] ELSE 0 END&#13;&#10;END' />
      </column>
      <column caption='KPI_SR_Trx_PM_1' datatype='real' name='[Calculation_1445374013420408856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL( SUM([Calculation_1445374013419270166]) / SUM([Calculation_1445374013419917335]) ,0)' />
      </column>
      <column caption='Username Active' datatype='boolean' name='[Calculation_3023956108643020803]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Success Rate - User' datatype='real' name='[Calculation_491455315955073026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL( (SUM([successful_users])/SUM([all_users])) , 0)' />
      </column>
      <column caption='Drop Rate - User' datatype='real' name='[Calculation_491455315955163139]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL( (SUM([dropped_users])/SUM([all_users])) , 0)' />
      </column>
      <column caption='Fail Rate - User' datatype='real' name='[Calculation_491455315955224580]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL( (SUM([failed_users])/SUM([all_users])) , 0)' />
      </column>
      <column caption='Success Rate' datatype='real' name='[Calculation_491455315955277829]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL( SUM([successful_trx]) / SUM([all_trx]) ,0)' />
      </column>
      <column caption='Drop Rate' datatype='real' name='[Calculation_491455315955326982]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL( SUM([dropped_trx]) / SUM([all_trx]) ,0)' />
      </column>
      <column caption='Fail Rate' datatype='real' name='[Calculation_491455315955380231]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL( SUM([failed_trx]) / SUM([all_trx]) ,0)' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
