      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97620' id='47' param='horz' type-v2='layout-flow' w='98482' x='759' y='1190'>
            <zone h='97620' id='23' type-v2='layout-basic' w='98482' x='759' y='1190'>
              <zone h='91795' id='5' param='horz' type-v2='layout-flow' w='98482' x='759' y='7015'>
                <zone h='91795' id='3' type-v2='layout-basic' w='98482' x='759' y='7015'>
                  <zone forceUpdate='true' h='7694' id='8' type-v2='text' w='98482' x='759' y='7015'>
                    <formatted-text>
                      <run fontname='Segoe UI' fontsize='10'>This graphic looks like a Cohort, but it&apos;s not exactly one. This graphic actually shows the amount of customers that left the subscription program every month after their subscription. The &apos;Subscription Month&apos; is represented by the vertical column at the left, and the subsequent months after the subscription are the represented by the horizontal line on the top. Additionally, we can see what&apos;s the reason why the customers left, if their last transaction was approved and they never returned, then we consider that they&apos;ve canceled their subscription program. If their last transaction was not approved and they never returned, then we consider that we lost them due to online payment issues. Those online payment issues can be analyzed in further details using the graphic at the bottom, which you can use the filter to select the &apos;Subscription Month&apos; you want to analyze.</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                      <format attr='margin-left' value='0' />
