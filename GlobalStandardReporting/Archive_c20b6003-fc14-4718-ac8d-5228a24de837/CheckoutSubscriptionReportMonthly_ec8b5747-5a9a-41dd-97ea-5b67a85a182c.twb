      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0bbqg701mgv16q1c45wrg0rko5er].[sum:udf4_like_20__:qk]&quot;' value='udf4' />
        </aliases>
      </column>
      <column caption='udf4_PM_1' datatype='integer' name='[Calculation_1445374013376716810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LEN(STR(MONTH(DATEADD(&apos;month&apos;, -1, TODAY()))))=1 THEN&#13;&#10;    IF [action_month] = STR(YEAR(DATEADD(&apos;month&apos;, -1, TODAY()))) + &apos;-0&apos; + STR(MONTH(DATEADD(&apos;month&apos;, -1, TODAY()))) THEN&#13;&#10;        [udf4_like_20__] ELSE 0 END&#13;&#10;ELSE&#13;&#10;    IF [action_month] = STR(YEAR(DATEADD(&apos;month&apos;, -1, TODAY()))) + &apos;-&apos; + STR(MONTH(DATEADD(&apos;month&apos;, -1, TODAY()))) THEN&#13;&#10;        [udf4_like_20__] ELSE 0 END&#13;&#10;END' />
      </column>
      <column caption='all_rows_PM_1' datatype='integer' name='[Calculation_1445374013378732044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LEN(STR(MONTH(DATEADD(&apos;month&apos;, -1, TODAY()))))=1 THEN&#13;&#10;    IF [action_month] = STR(YEAR(DATEADD(&apos;month&apos;, -1, TODAY()))) + &apos;-0&apos; + STR(MONTH(DATEADD(&apos;month&apos;, -1, TODAY()))) THEN&#13;&#10;        [all_rows] ELSE 0 END&#13;&#10;ELSE&#13;&#10;    IF [action_month] = STR(YEAR(DATEADD(&apos;month&apos;, -1, TODAY()))) + &apos;-&apos; + STR(MONTH(DATEADD(&apos;month&apos;, -1, TODAY()))) THEN&#13;&#10;        [all_rows] ELSE 0 END&#13;&#10;END' />
      </column>
      <column caption='missing_udf4_PM_1' datatype='real' name='[Calculation_1445374013378936845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-(TOTAL(SUM([Calculation_1445374013376716810]))/TOTAL(SUM([Calculation_1445374013378732044])))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Username Active' datatype='boolean' name='[Calculation_3023956108643094532]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='missing_udf4' datatype='real' name='[Calculation_487514667339968512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-(SUM([udf4_like_20__])/SUM([all_rows]))' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Migrated Data' datatype='table' name='[__tableau_internal_object_id__].[Migrated Data]' role='measure' type='quantitative' />
      <column caption='Action Month' datatype='string' name='[action_month]' role='dimension' type='nominal' />
