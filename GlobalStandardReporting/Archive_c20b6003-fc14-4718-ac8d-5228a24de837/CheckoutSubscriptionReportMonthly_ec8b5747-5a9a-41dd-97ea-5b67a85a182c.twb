        </style-rule>
        <style-rule element='parameter-ctrl-title'>
          <format attr='font-family' value='Segoe UI' />
          <format attr='font-size' value='9' />
        </style-rule>
      </style>
      <size sizing-mode='automatic' />
      <datasources>
        <datasource caption='lb_checkout_subscription_p5_missing_udf4' name='federated.0bbqg701mgv16q1c45wrg0rko5er' />
        <datasource caption='lb_checkout_subscription_p4_sr_per_trx' name='federated.1be48uf0c07umm11iswok0clsei2' />
      </datasources>
      <datasource-dependencies datasource='federated.0bbqg701mgv16q1c45wrg0rko5er'>
        <column caption='Business Name' datatype='string' name='[business_name]' role='dimension' type='nominal' />
        <column-instance column='[business_name]' derivation='None' name='[none:business_name:nk]' pivot='key' type='nominal' />
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1be48uf0c07umm11iswok0clsei2'>
        <column caption='Action Month' datatype='string' name='[action_month]' role='dimension' type='nominal' />
        <column-instance column='[action_month]' derivation='None' name='[none:action_month:nk]' pivot='key' type='nominal' />
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97620' id='47' param='horz' type-v2='layout-flow' w='98482' x='759' y='1190'>
            <zone h='97620' id='23' type-v2='layout-basic' w='98482' x='759' y='1190'>
              <zone h='91796' id='5' param='horz' type-v2='layout-flow' w='98482' x='759' y='7014'>
                <zone h='91796' id='3' type-v2='layout-basic' w='98482' x='759' y='7014'>
                  <zone forceUpdate='true' h='7693' id='8' type-v2='text' w='98482' x='759' y='7014'>
                    <formatted-text>
                      <run fontname='Segoe UI' fontsize='12'>Having the field &quot;Subscription Date (udf4)&quot; available is also important because a customer might unsubscribe from the program and after some months subscribe again, and if that&apos;s the case, we want to consider the subsequent subscriptions as new subscriptions, even if it&apos;s the same person in that same entity. Currently we can&apos;t use &quot;Subscription Date (udf4)&quot; because there is a significant amount of missing data.</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                      <format attr='margin-left' value='0' />
                    </zone-style>
                  </zone>
                  <zone h='84103' id='20' param='horz' type-v2='layout-flow' w='80369' x='759' y='14707'>
                    <zone fixed-size='494' h='84103' id='31' is-fixed='true' param='vert' type-v2='layout-flow' w='80369' x='759' y='14707'>
                      <zone h='0' id='60' name='missing_udf4' show-title='false' w='79419' x='1234' y='15451'>
                        <layout-cache type-h='cell' type-w='fixed' />
                        <zone-style>
                          <format attr='border-color' value='#000000' />
                          <format attr='border-style' value='none' />
                          <format attr='border-width' value='0' />
                          <format attr='margin' value='4' />
                        </zone-style>
                      </zone>
                      <zone fixed-size='47' h='8184' id='61' is-fixed='true' type-v2='empty' w='79419' x='1234' y='15451'>
                        <zone-style>
                          <format attr='border-color' value='#000000' />
