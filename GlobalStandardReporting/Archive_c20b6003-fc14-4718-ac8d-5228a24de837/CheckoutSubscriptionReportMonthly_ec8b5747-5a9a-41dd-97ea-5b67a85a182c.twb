                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone h='19643' id='11' name='KPI (SR_user)' show-title='false' w='19772' x='20423' y='33333'>
                  <layout-cache type-h='cell' type-w='cell' />
