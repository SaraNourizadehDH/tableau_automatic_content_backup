              <calculation class='tableau' formula='IF LEN(STR(MONTH(DATEADD(&apos;month&apos;, -1, TODAY()))))=1 THEN&#13;&#10;    IF [subscription_month] = STR(YEAR(DATEADD(&apos;month&apos;, -1, TODAY()))) + &apos;-0&apos; + STR(MONTH(DATEADD(&apos;month&apos;, -1, TODAY()))) THEN&#13;&#10;        IF [canceled_or_lost]=&apos;Lost&apos; THEN [unique_cust] ELSE 0 END &#13;&#10;        ELSE 0 END&#13;&#10;ELSE&#13;&#10;    IF [subscription_month] = STR(YEAR(DATEADD(&apos;month&apos;, -1, TODAY()))) + &apos;-&apos; + STR(MONTH(DATEADD(&apos;month&apos;, -1, TODAY()))) THEN&#13;&#10;        IF [canceled_or_lost]=&apos;Lost&apos; THEN [unique_cust] ELSE 0 END &#13;&#10;        ELSE 0 END&#13;&#10;END' />
            </column>
            <column caption='KPI_canc_lost_PM_1' datatype='real' name='[Calculation_1445374013332168706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1445374013331406849])/(SUM([Calculation_1445374013331406849])+SUM([Calculation_1445374013330890752]))' />
            </column>
            <column caption='Business Name' datatype='string' name='[business_name]' role='dimension' type='nominal' />
