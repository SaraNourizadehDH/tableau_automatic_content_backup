    <worksheet name='missing_udf4_details'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='false'>Missing &quot;Subscription Date (udf4)&quot;</run>
            <run>Æ&#10;</run>
            <run bold='false' fontsize='10'>Having the Subscription Date (udf4) is also important because a customer might unsubscribe from the program and after some months subscribe again, and if that&apos;s the case, we want to consider the subsequent subscriptions as new subscriptions, even if it&apos;s the same person in that same entity. Currently we can&apos;t use &quot;Subscription Date (udf4)&quot; because there is a significant amount of missing data.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='lb_checkout_subscription_p5_missing_udf4' name='federated.0bbqg701mgv16q1c45wrg0rko5er' />
