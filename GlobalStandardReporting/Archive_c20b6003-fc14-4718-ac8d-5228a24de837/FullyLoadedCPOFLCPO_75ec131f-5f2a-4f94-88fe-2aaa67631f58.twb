              <calculation class='tableau' formula='#2023-11-01#' />
            </column>
            <column alias='Cost per Order (FLCPO)' caption='Cost Selector' datatype='integer' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Cost per Order (FLCPO)' />
