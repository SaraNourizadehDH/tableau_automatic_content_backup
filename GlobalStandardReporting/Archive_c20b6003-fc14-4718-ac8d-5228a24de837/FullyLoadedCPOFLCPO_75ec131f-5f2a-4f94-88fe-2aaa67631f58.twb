              <calculation class='tableau' formula='DATE(DATEPARSE(&quot;yyyyMM&quot;,[month]))' />
            </column>
            <column caption='date_Selected TF' datatype='integer' datatype-customized='true' name='[Calculation_2875618794085990402]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='INT(INDEX() = (IF MIN([Calculation_2875618794069385216])=[Parameters].[Parameter 1] THEN INDEX() END))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Total Cost ' datatype='real' name='[Calculation_3198118748894441482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = 1 THEN [total_cpo]&#10;ELSEIF [Parameters].[Parameter 2] = 2 THEN [total_gmv_eur]*100&#10;ELSEIF [Parameters].[Parameter 2] = 3 THEN [total_total_costs]&#10;END' />
            </column>
            <column caption='increase/decrease in cost (GMV)' datatype='real' name='[Calculation_5381168236144984064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ABS( (ZN(max([total_gmv_eur])) - LOOKUP(ZN(max([total_gmv_eur])), -1)) ) * 100)*sum([successful_gmv_eur])/100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='increase/decrease' datatype='string' name='[Calculation_5381168236179660804]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF&#10;(( (ZN(max([total_gmv_eur])) - LOOKUP(ZN(max([total_gmv_eur])), -1)) ) * 100) &gt; 0 THEN &apos;increase&apos;&#10;ELSE &apos;decrease&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='total_variation_Cost selector' datatype='real' name='[Cost selector total (copy)_3198118748895064076]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = 1 THEN ZN(max([Calculation_3198118748894441482])) - LOOKUP(ZN(max([Calculation_3198118748894441482])), -1)&#10;ELSEIF [Parameters].[Parameter 2] = 2 THEN ( (ZN(max([total_gmv_eur])) - LOOKUP(ZN(max([total_gmv_eur])), -1)) ) * 100&#10;ELSEIF [Parameters].[Parameter 2] = 3 THEN (ZN(max([Calculation_3198118748894441482])) - LOOKUP(ZN(max([Calculation_3198118748894441482])), -1))/LOOKUP(ZN(max([Calculation_3198118748894441482])), -1)*100&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Cost selector total symbol' datatype='string' name='[Cost selector total (copy)_3198118748896071695]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = 1 THEN &apos;€&apos;&#10;ELSEIF [Parameters].[Parameter 2] = 2 THEN &apos;%&apos;&#10;ELSEIF [Parameters].[Parameter 2] = 3 THEN &apos;€&apos;&#10;END' />
            </column>
            <column caption='Cost selector total var symbol' datatype='string' name='[Cost selector total variation (copy)_3198118748895449102]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = 1 THEN &apos;MoM&apos;&#10;ELSEIF [Parameters].[Parameter 2] = 2 THEN &apos;% pts MoM&apos;&#10;ELSEIF [Parameters].[Parameter 2] = 3 THEN &apos;% MoM&apos;&#10;END' />
