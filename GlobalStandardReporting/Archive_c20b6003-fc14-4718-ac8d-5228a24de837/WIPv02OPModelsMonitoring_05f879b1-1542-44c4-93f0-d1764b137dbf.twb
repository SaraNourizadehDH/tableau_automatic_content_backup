    <worksheet name='Obs about benchmark metrics'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Semibold' fontsize='10'>OBS:</run>
            <run fontsize='11'>Æ  </run>
            <run>Æ&#10;</run>
            <run fontname='Tableau Regular' fontsize='10'>- The threshold parameter can be chosen either by the values used in production (</run>
            <run bold='true' fontname='Tableau Regular' fontsize='10'>3DS and block</run>
            <run fontname='Tableau Regular' fontsize='10'>) or the percentile of the scores for the selected model (</run>
            <run bold='true' fontname='Tableau Regular' fontsize='10'>e.g. pctl_99.95</run>
            <run fontname='Tableau Regular' fontsize='10'>) </run>
            <run>Æ&#10;</run>
            <run fontname='Tableau Regular' fontsize='10'>- Dotted lines represent benchmark performance calculated in the four weeks period starting 2021-11-28.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources />
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane id='4' selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <mark-sizing mark-sizing-setting='marks-scaling-off' />
            <style>
              <style-rule element='mark'>
                <format attr='size' value='0.16392265260219574' />
              </style-rule>
              <style-rule element='pane'>
                <format attr='minwidth' value='-1' />
                <format attr='maxwidth' value='-1' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid='{336445B7-0F80-43A6-A0F7-BC9AAEA8E2A4}' />
    </worksheet>
  </worksheets>
