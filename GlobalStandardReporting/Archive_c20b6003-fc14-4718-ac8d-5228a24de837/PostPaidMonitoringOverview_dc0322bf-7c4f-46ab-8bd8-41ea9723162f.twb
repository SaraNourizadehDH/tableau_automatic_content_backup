  <worksheets>
    <worksheet name='Default rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Default Rate - </run>
            <run bold='true' fontcolor='#555555'>targets, </run>
            <run bold='true' fontcolor='#d61f26'>actuals</run>
            <run bold='true' fontcolor='#555555'>, and </run>
            <run bold='true' fontcolor='#d68184'>forecasts</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bnpl_overview' name='federated.03flxd51rrkz7y1g9n9pm0mt91u0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Local' caption='Currency' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='EUR' />
                <alias key='2' value='Local' />
              </aliases>
            </column>
            <column alias='Monthly' caption='Timeframe - Overview' datatype='string' name='[Timeframe (copy)_3252021202669297668]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03flxd51rrkz7y1g9n9pm0mt91u0'>
            <column caption='Platform_clean' datatype='string' name='[Calculation_1456562641301032960]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [platform_id (bnpl_overview)] = &apos;HF&apos; THEN &apos;TB&apos;&#10;ELSE [platform_id (bnpl_overview)] END' />
            </column>
            <column caption='Timeframe Date' datatype='date' datatype-customized='true' name='[Calculation_1924796273437519872]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Timeframe (copy)_3252021202669297668], [date (bnpl_overview)]))' />
            </column>
            <column caption='Default Rate' datatype='real' name='[Calculation_2728548111900991488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - SUM(&#10;    IF ([date (bnpl_overview)] &lt;= &#10;        DATEADD(&apos;day&apos;, -1,&#10;        DATEADD([Parameters].[Timeframe (copy)_3252021202669297668], 1, [Calculation_2728548111918075905])))&#10;    THEN [gmv_collected_local (bnpl_overview)]&#10;    ELSE NULL END&#10;) / SUM({FIXED [global_entity_id], [Calculation_1456562641301032960], [date (bnpl_overview)] : SUM([gmv_disbursed_local (bnpl_overview)])})' />
            </column>
            <column caption='Last Date Default' datatype='datetime' name='[Calculation_2728548111918075905]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD([Parameters].[Timeframe (copy)_3252021202669297668], -1,&#10;DATETRUNC([Parameters].[Timeframe (copy)_3252021202669297668], &#10;    DATEADD(&apos;day&apos;, -91, DATEADD(&apos;hour&apos;, 4, TODAY()))&#10;))' />
            </column>
            <column caption='Disbursed Target' datatype='real' name='[Calculation_3252021202662699008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN 2 THEN [disbursed_target_local (bnpl_overview)]&#10;    WHEN 1 THEN [disbursed_target_eur (bnpl_overview)]&#10;END' />
            </column>
            <column caption='GMV Disbursed' datatype='real' name='[Calculation_3252021202662928385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN 2 THEN [gmv_disbursed_local (bnpl_overview)]&#10;    WHEN 1 THEN [gmv_disbursed_eur (bnpl_overview)]&#10;END' />
            </column>
            <column caption='Difference From Target' datatype='real' name='[Calculation_6160009557573124096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3252021202662928385])/SUM([Calculation_3252021202662699008])-1' />
            </column>
            <column caption='Gmv Collected Local - Pred' datatype='real' name='[Calculation_792492840574222337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[gmv_disbursed_local (bnpl_overview)] * (1 - [default_rate_forecast])' />
            </column>
            <column caption='Default Rate Pred' datatype='real' name='[Default Rate (copy)_792492840572432384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (&#10;SUM([Calculation_792492840574222337]) &#10;/ SUM({FIXED [global_entity_id], [Calculation_1456562641301032960], [date (bnpl_overview)] : SUM([gmv_disbursed_local (bnpl_overview)])}))' />
            </column>
            <column caption='Difference From Target - Default' datatype='real' name='[Difference From Target (copy)_4124312097868754952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([default_rate_target (bnpl_overview)]) - SUM([default_rate_forecast])' />
            </column>
            <column-instance column='[Calculation_1924796273437519872]' derivation='Attribute' name='[attr:Calculation_1924796273437519872:ok]' pivot='key' type='ordinal' />
            <column-instance column='[default_rate_target (bnpl_overview)]' derivation='Avg' name='[avg:default_rate_target (bnpl_overview):qk]' pivot='key' type='quantitative' />
            <column caption='Date (Bnpl Overview)' datatype='date' name='[date (bnpl_overview)]' role='dimension' type='ordinal' />
            <column caption='Default Rate Forecast' datatype='integer' name='[default_rate_forecast]' role='measure' type='quantitative' />
            <column caption='Default Rate Target (Bnpl Overview)' datatype='real' name='[default_rate_target (bnpl_overview)]' role='measure' type='quantitative' />
            <column caption='Disbursed Target Eur (Bnpl Overview)' datatype='real' name='[disbursed_target_eur (bnpl_overview)]' role='measure' type='quantitative' />
            <column caption='Disbursed Target Local (Bnpl Overview)' datatype='real' name='[disbursed_target_local (bnpl_overview)]' role='measure' type='quantitative' />
