    <worksheet name='repayment_rate_bins (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;</run>
            <run>[Parameters].[Topline Eur Parameter]</run>
            <run><![CDATA[> (based on GMV local currency) by <]]></run>
            <run>[Parameters].[Order Count Parameter]</run>
            <run>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bnpl_summary (rl_fintech)' name='federated.1dvxfyc00f88b410yjte10j584z6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Total' caption='Repayment Rates breakdown' datatype='string' name='[Order Count Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;total&quot;'>
              <calculation class='tableau' formula='&quot;total&quot;' />
              <aliases>
                <alias key='&quot;a_seg&quot;' value='A Segment' />
                <alias key='&quot;b_segment&quot;' value='B Segment' />
                <alias key='&quot;global_entity_id&quot;' value='Global Entity Id' />
                <alias key='&quot;installment_repayment_method&quot;' value='Installment Repayment Method' />
                <alias key='&quot;is_fallback&quot;' value='Fallback' />
                <alias key='&quot;loyalty_segment&quot;' value='Loyalty Segment' />
                <alias key='&quot;ml_version&quot;' value='ML version' />
                <alias key='&quot;order_date&quot;' value='Order Month' />
                <alias key='&quot;total&quot;' value='Total' />
              </aliases>
            </column>
            <column alias='Outstanding Rate %' caption='Rate selection' datatype='integer' name='[Topline Eur Parameter]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='0' value='Repayment Rate %' />
                <alias key='1' value='Outstanding Rate %' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1dvxfyc00f88b410yjte10j584z6'>
            <column caption='Days Since Order Category' datatype='string' name='[Calculation_2632565112365522946]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_87609105151172615]&gt;= 0 AND [Calculation_87609105151172615]&lt;=29 THEN &apos;Early&apos;&#10;ELSEIF [Calculation_87609105151172615]&gt;= 30 AND [Calculation_87609105151172615]&lt;=32 THEN &apos;On time&apos;&#10;ELSEIF [Calculation_87609105151172615]&gt;= 33 AND [Calculation_87609105151172615]&lt;=48 THEN &apos;Retries&apos;&#10;ELSEIF [Calculation_87609105151172615]&gt;= 49 AND [Calculation_87609105151172615]&lt;=57 THEN &apos;Extended retries&apos;&#10;ELSEIF [Calculation_87609105151172615]&gt;= 58 AND [Calculation_87609105151172615]&lt;=90 THEN &apos;Late&apos;&#10;ELSEIF [Calculation_87609105151172615]&gt;= 91 THEN &apos;Default&apos;&#10;ELSE Null&#10;END' />
            </column>
            <column caption='Days Since Order Bucket' datatype='string' name='[Calculation_2693997023640158223]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case  [days_since_order]&#10;  when 10 then &apos;1-10&apos;&#10;   when 20 then &apos;11-20&apos;&#10;  when  29 then &apos;21-29&apos; &#10;  when  30 then &apos;30&apos; &#10;  when  33 then &apos;31-33&apos;&#10;  when  40 then &apos;34-40&apos;&#10;  when  50 then &apos;41-50&apos;  &#10;when  60 then &apos;51-60&apos; &#10;  when  70 then &apos;61-70&apos;&#10;  when  80 then &apos;71-80&apos;&#10;  when  90 then &apos;81-90&apos;  &#10;  when 120 then &apos;91-120&apos;&#10;  else &apos;121+&apos;  end' />
            </column>
            <column caption='A Segment' datatype='string' name='[Calculation_4419720106811158559]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([a_segment]) then &apos;No Segment&apos;&#10;else [a_segment]&#10;end' />
            </column>
            <column caption='B Segment' datatype='string' name='[Calculation_5380816414793256989]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISNULL([b_segment]) then &apos;No Segment&apos;&#10;else [b_segment] &#10;end' />
            </column>
            <column caption='Rate selected' datatype='real' default-format='p0.0%' name='[Calculation_811562752317489152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Topline Eur Parameter]&#10;WHEN 0 THEN [Repayment Rate_fixed (copy)_87609105170673674]&#10;WHEN 1 THEN 1-[Repayment Rate_fixed (copy)_87609105170673674]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Days Since Order bin Int' datatype='integer' name='[Calculation_87609105151172615]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [days_since_order] &gt; 120 THEN 121&#10;ELSE [days_since_order]&#10;END' />
            </column>
            <column caption='Dimension breakdown' datatype='string' name='[Calculation_87609105169272841]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Order Count Parameter]&#10;WHEN &apos;total&apos; THEN &apos;Total&apos;&#10;WHEN &apos;order_date&apos; THEN STR(YEAR([order_date]))+&apos;-&apos;+STR(DATEPART(&apos;month&apos;, [order_date]))&#10;WHEN &apos;a_seg&apos; THEN [Calculation_4419720106811158559]&#10;WHEN &apos;b_segment&apos; then [Calculation_5380816414793256989]&#10;WHEN &apos;ml_version&apos; THEN [model_version]&#10;WHEN &apos;loyalty_segment&apos; THEN [loyalty_segment]&#10;WHEN &apos;is_fallback&apos; THEN case [is_fallback] when TRUE then &apos;Yes&apos; else &apos;No&apos; end&#10;WHEN &apos;installment_repayment_method&apos; THEN STR([installment_repayment_method])&#10;WHEN &apos;global_entity_id&apos; THEN STR([global_entity_id])&#10;END' />
            </column>
            <column caption='Reference_line_28' datatype='integer' name='[Calculation_87609105174806539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF WINDOW_MAX(MAX([Calculation_87609105151172615])) &gt;= 28&#10;AND WINDOW_MIN(MIN([Calculation_87609105151172615])) &lt;= 28&#10;THEN 28&#10;ELSEIF WINDOW_MIN(MIN([Calculation_87609105151172615])) &lt; 28 AND WINDOW_MAX(MAX([Calculation_87609105151172615])) &lt; 28&#10;THEN WINDOW_MAX(MAX([Calculation_87609105151172615]))&#10;ELSE NULL&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
