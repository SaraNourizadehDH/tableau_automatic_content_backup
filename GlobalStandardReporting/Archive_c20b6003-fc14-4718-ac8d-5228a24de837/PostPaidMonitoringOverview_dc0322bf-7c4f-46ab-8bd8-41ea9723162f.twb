        <column caption='Days Since Order bin Int' datatype='integer' name='[Calculation_87609105151172615]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='IF [days_since_order] &gt; 120 THEN 121&#10;ELSE [days_since_order]&#10;END' />
