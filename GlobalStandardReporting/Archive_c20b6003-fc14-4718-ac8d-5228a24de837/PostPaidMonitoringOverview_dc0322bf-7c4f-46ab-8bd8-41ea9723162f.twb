        <column caption='Dimension breakdown' datatype='string' name='[Calculation_87609105169272841]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [Parameters].[Order Count Parameter]&#10;WHEN &apos;total&apos; THEN &apos;Total&apos;&#10;WHEN &apos;order_date&apos; THEN STR(YEAR([order_date]))+&apos;-&apos;+STR(DATEPART(&apos;month&apos;, [order_date]))&#10;WHEN &apos;a_seg&apos; THEN [Calculation_4419720106811158559]&#10;WHEN &apos;b_segment&apos; then [Calculation_5380816414793256989]&#10;WHEN &apos;ml_version&apos; THEN [model_version]&#10;WHEN &apos;loyalty_segment&apos; THEN [loyalty_segment]&#10;WHEN &apos;is_fallback&apos; THEN case [is_fallback] when TRUE then &apos;Yes&apos; else &apos;No&apos; end&#10;WHEN &apos;installment_repayment_method&apos; THEN STR([installment_repayment_method])&#10;WHEN &apos;global_entity_id&apos; THEN STR([global_entity_id])&#10;END' />
        </column>
