      <aliases enabled='yes' />
      <column caption='Repaid Rate' datatype='real' name='[Calculation_1000362128614277125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_collected_local (bnpl_overview)])&#10;/ SUM([gmv_disbursed_local (bnpl_overview)])' />
      </column>
      <column caption='Currency Indicator - Orders Collections' datatype='string' hidden='true' name='[Calculation_116460320639913985]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Metric selector - volumes view (copy)_2086081479285084171]&#10;WHEN 0 THEN IIF([Parameters].[Parameter 1]=1,&quot;€&quot;,&quot;Local&quot;)&#10;WHEN 1 THEN IIF([Parameters].[Parameter 1]=1,&quot;€&quot;,&quot;Local&quot;)&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Date MIN (day)' datatype='date' hidden='true' name='[Calculation_116460320645115910]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MIN([date (bnpl_overview)])}' />
      </column>
      <column caption='Date - 30 Days Ago' datatype='date' datatype-customized='true' hidden='true' name='[Calculation_125608276135317504]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos;, -1, [date (bnpl_overview)]))' />
      </column>
      <column caption='Date Range - MAX' datatype='string' hidden='true' name='[Calculation_125608276145192961]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&apos;from &apos; + &#10;STR(DAY([Date MAX (day) (copy)_125608276146135042]))&#10;+&apos;.&apos;+&#10;STR(MONTH([Date MAX (day) (copy)_125608276146135042]))&#10;+&apos;.&apos;+&#10;STR(YEAR([Date MAX (day) (copy)_125608276146135042]))&#10;+ &apos; to &apos; +&#10;STR(DAY([Calculation_3799067791296081920 1]))&#10;+&apos;.&apos;+&#10;STR(MONTH([Calculation_3799067791296081920 1]))&#10;+&apos;.&apos;+&#10;STR(YEAR([Calculation_3799067791296081920 1]))' />
      </column>
      <column caption='Default Rate - Diff' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1298021916513665032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Repay Rate - Selected Month (copy)_1298021916490833920] - [Default Rate - Latest (copy)_1298021916512604165])&#10;* 100' />
      </column>
      <column caption='Latest Date' datatype='date' name='[Calculation_1302877338558836738]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX([date (bnpl_overview)])}' />
      </column>
      <column caption='Platform_clean' datatype='string' name='[Calculation_1456562641301032960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [platform_id (bnpl_overview)] = &apos;HF&apos; THEN &apos;TB&apos;&#10;ELSE [platform_id (bnpl_overview)] END' />
      </column>
      <column caption='Timeframe Date' datatype='date' datatype-customized='true' name='[Calculation_1924796273437519872]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Timeframe (copy)_3252021202669297668], [date (bnpl_overview)]))' />
      </column>
      <column caption='Gmv Collected' datatype='real' name='[Calculation_2377759915038404608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 1]=1,[gmv_collected_eur (bnpl_overview)], [gmv_collected_local (bnpl_overview)])' />
      </column>
      <column caption='Default Rate' datatype='real' name='[Calculation_2728548111900991488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM(&#10;    IF ([date (bnpl_overview)] &lt;= &#10;        DATEADD(&apos;day&apos;, -1,&#10;        DATEADD([Parameters].[Timeframe (copy)_3252021202669297668], 1, [Calculation_2728548111918075905])))&#10;    THEN [gmv_collected_local (bnpl_overview)]&#10;    ELSE NULL END&#10;) / SUM({FIXED [global_entity_id], [Calculation_1456562641301032960], [date (bnpl_overview)] : SUM([gmv_disbursed_local (bnpl_overview)])})' />
      </column>
      <column caption='Last Date Default' datatype='datetime' name='[Calculation_2728548111918075905]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD([Parameters].[Timeframe (copy)_3252021202669297668], -1,&#10;DATETRUNC([Parameters].[Timeframe (copy)_3252021202669297668], &#10;    DATEADD(&apos;day&apos;, -91, DATEADD(&apos;hour&apos;, 4, TODAY()))&#10;))' />
      </column>
      <column caption='Date - Month' datatype='date' name='[Calculation_2795679873944383488]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [date (bnpl_overview)]))' />
      </column>
      <column caption='Date - 30 days before' datatype='date' hidden='true' name='[Calculation_3097421062165336066]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos;, -1, [date (bnpl_overview)]))' />
      </column>
      <column caption='from_date_title_card' datatype='date' hidden='true' name='[Calculation_3097421062460375047]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;,-30, [Parameters].[Date (Bnpl Rolling Mau) Parameter (copy)_3097421062455193604]))' />
      </column>
      <column caption='Disbursed Target' datatype='real' name='[Calculation_3252021202662699008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN 2 THEN [disbursed_target_local (bnpl_overview)]&#10;    WHEN 1 THEN [disbursed_target_eur (bnpl_overview)]&#10;END' />
      </column>
      <column caption='GMV Disbursed' datatype='real' name='[Calculation_3252021202662928385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN 2 THEN [gmv_disbursed_local (bnpl_overview)]&#10;    WHEN 1 THEN [gmv_disbursed_eur (bnpl_overview)]&#10;END' />
      </column>
      <column caption='Date MAX' datatype='date' default-format='*m/d/yyyy' name='[Calculation_3799067791296081920 1]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='Max([date (bnpl_overview)])' />
      </column>
      <column caption='Date MAX (day)' datatype='date' default-format='*m/d/yyyy' hidden='true' name='[Calculation_3799067791296081920]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX([date (bnpl_overview)])}' />
      </column>
      <column caption='Date Range STR' datatype='string' hidden='true' name='[Calculation_3799067791296376834]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DAY([Calculation_116460320645115910]))+&quot;.&quot;+&#10;STR(MONTH([Calculation_116460320645115910]))+&quot;.&quot;+&#10;STR(YEAR([Calculation_116460320645115910]))&#10; + &quot; to &quot; + &#10;STR(DAY([Calculation_3799067791296081920]))+&quot;.&quot;+&#10;STR(MONTH([Calculation_3799067791296081920]))+&quot;.&quot;+&#10;STR(YEAR([Calculation_3799067791296081920]))' />
      </column>
      <column caption='Date Axis' datatype='string' name='[Calculation_4124312097853190146]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Timeframe (copy)_3252021202669297668]&#10;WHEN &apos;month&apos; THEN DATENAME(&apos;month&apos;, [date (bnpl_overview)])&#10;WHEN &apos;quarter&apos; THEN &apos;Q&apos;+DATENAME(&apos;quarter&apos;, [date (bnpl_overview)])&#10;END' />
      </column>
      <column caption='min(1)' datatype='integer' name='[Calculation_4124312097853497349]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(1)' />
      </column>
      <column caption='Platform Id_prefix' datatype='string' name='[Calculation_4124312097893818377]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT([global_entity_id], 2)' />
      </column>
      <column caption='Platform GMV - Selected Month' datatype='real' name='[Calculation_4576853548151508992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(&#10;    [Parameters].[Parameter 1]=1,&#10;    {FIXED [global_entity_id], [date (bnpl_overview)], [Calculation_4124312097893818377] : SUM( IIF([Is latest month? (copy)_4582834877411524609], [platform_gmv_eur],Null))},&#10;    {FIXED [global_entity_id], [date (bnpl_overview)], [Calculation_4124312097893818377] : SUM( IIF([Is latest month? (copy)_4582834877411524609], [platform_gmv_local],Null))}&#10;)' />
