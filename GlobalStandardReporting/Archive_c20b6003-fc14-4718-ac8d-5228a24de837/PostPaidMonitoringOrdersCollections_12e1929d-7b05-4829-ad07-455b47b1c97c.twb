    <worksheet name='orders_collections_line'>
      <table>
        <view>
          <datasources>
            <datasource caption='bnpl_activity_daily (rl_fintech)' name='federated.042hnnc06vcl8917yflhy11slm65' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='GMV platform share' caption='Metric Selector - Orders Collections' datatype='integer' name='[Metric selector - volumes view (copy)_2086081479285084171]' param-domain-type='list' role='measure' type='quantitative' value='4'>
              <calculation class='tableau' formula='4' />
              <aliases>
                <alias key='0' value='Disbursed GMV' />
                <alias key='1' value='Collected GMV' />
                <alias key='2' value='Number of Orders' />
                <alias key='3' value='Number of Collections' />
                <alias key='4' value='GMV platform share' />
                <alias key='5' value='Platform GMV' />
              </aliases>
            </column>
            <column alias='Local' caption='Currency' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='EUR' />
                <alias key='2' value='Local' />
              </aliases>
            </column>
            <column alias='Monthly' caption='Timeframe' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column alias='Total' caption='Breakdown' datatype='string' name='[Repayment Rates breakdown (copy)_6421851644013830144]' param-domain-type='list' role='measure' type='nominal' value='&quot;total&quot;'>
              <calculation class='tableau' formula='&quot;total&quot;' />
              <aliases>
                <alias key='&quot;a_segment&quot;' value='A Segment' />
                <alias key='&quot;country&quot;' value='Country' />
                <alias key='&quot;device&quot;' value='Device' />
                <alias key='&quot;fallback&quot;' value='Fallback' />
                <alias key='&quot;installment_repayment_method&quot;' value='Installment Repayment Method' />
                <alias key='&quot;is_first_order&quot;' value='New / Returning Customers' />
                <alias key='&quot;loyalty_segment&quot;' value='Loyalty Segment' />
                <alias key='&quot;payment_requestor&quot;' value='Payment Requestor' />
                <alias key='&quot;total&quot;' value='Total' />
                <alias key='&quot;vertical&quot;' value='Vertical' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.042hnnc06vcl8917yflhy11slm65'>
            <column caption='Currency Indicator - Orders Collections' datatype='string' name='[Calculation_116460320639913985]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Metric selector - volumes view (copy)_2086081479285084171]&#10;WHEN 0 THEN IIF([Parameters].[Parameter 1]=1,&quot;€&quot;,&quot;Local&quot;)&#10;WHEN 1 THEN IIF([Parameters].[Parameter 1]=1,&quot;€&quot;,&quot;Local&quot;)&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Timeframe Date' datatype='date' datatype-customized='true' name='[Calculation_1924796273437519872]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 3], [date]))' />
            </column>
            <column caption='Gmv Collected' datatype='real' name='[Calculation_2377759915038404608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 1]=1,[gmv_collected_eur], [gmv_collected_local])' />
            </column>
            <column caption='Fallback' datatype='string' name='[Calculation_3325486170843664384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_fallback] then &apos;Yes&apos; else &apos;No&apos; end' />
            </column>
            <column caption='Platform Id' datatype='string' name='[Calculation_4124312097893818377]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[platform]' />
            </column>
            <column caption='Dimension Breakdown' datatype='string' name='[Calculation_6421851644014882817]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Repayment Rates breakdown (copy)_6421851644013830144]&#10;WHEN &apos;total&apos; THEN &apos;Total&apos;&#10;WHEN &apos;device&apos; THEN [device]&#10;WHEN &apos;a_segment&apos; THEN [a_segment]&#10;WHEN &apos;loyalty_segment&apos; THEN [loyalty_segment]&#10;WHEN &apos;is_first_order&apos; THEN [is_first_order]&#10;WHEN &apos;country&apos; THEN [Platform Id (copy)_3005167600262213632]&#10;WHEN &apos;vertical&apos; then [vertical]&#10;WHEN &apos;fallback&apos; then [Calculation_3325486170843664384]&#10;WHEN &apos;payment_requestor&apos; then [payment_requestor]&#10;WHEN &apos;installment_repayment_method&apos; then [installment_repayment_method]&#10;END' />
              <aliases>
                <alias key='&quot;0-6, 14-20, 21-27 and 6 more&quot;' value='Paid' />
                <alias key='&quot;CREDIT&quot;' value='Credit' />
                <alias key='&quot;DEBIT&quot;' value='Debit' />
                <alias key='&quot;false&quot;' value='Returning' />
                <alias key='&quot;true&quot;' value='New' />
              </aliases>
            </column>
            <column caption='Order Count - Platform' datatype='real' name='[Calculation_6924284442377621505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [date], [Calculation_4124312097893818377] : AVG([order_count] / [order_count_platform_share])}' />
            </column>
            <column caption='Order Count Platform Share' datatype='real' name='[Calculation_6924284442397212674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[order_count] / {FIXED [Calculation_4124312097893818377], [Calculation_1924796273437519872]: SUM([Calculation_6924284442377621505])}' />
            </column>
            <column caption='Metric - Orders Collections' datatype='real' name='[Disbursement Metric (copy)_2086081479285973004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Metric selector - volumes view (copy)_2086081479285084171]&#10;WHEN 0 THEN SUM([Gmv Collected (copy)_3069695776546131968])//Collected&#10;WHEN 1 THEN SUM([Calculation_2377759915038404608])//Collected&#10;WHEN 2 THEN SUM([order_count])//Orders&#10;WHEN 3 THEN SUM([payment_order_count])//Orders&#10;WHEN 4 THEN SUM([Gmv Collected (copy)_3069695776546131968])/sum([Order Count - Platform (copy)_6924284442403414022])&#10;WHEN 5 then sum([Order Count - Platform (copy)_6924284442403414022])&#10;END' />
            </column>
            <column caption='Gmv Disbursed' datatype='real' name='[Gmv Collected (copy)_3069695776546131968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 1]=1,[gmv_disbursed_eur], [gmv_disbursed_local])' />
            </column>
            <column caption='Metric PS - Orders Collections' datatype='real' name='[Metric - Orders Collections (copy)_6924284442480742410]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Metric selector - volumes view (copy)_2086081479285084171]&#10;WHEN 0 THEN SUM([Gmv Collected (copy)_3069695776546131968])/sum([Order Count - Platform (copy)_6924284442403414022])//Disbursed&#10;WHEN 2 THEN SUM([Calculation_6924284442397212674])//Order count&#10;WHEN 4 THEN SUM([Gmv Collected (copy)_3069695776546131968])/sum([Order Count - Platform (copy)_6924284442403414022])&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Gmv - Platform' datatype='real' name='[Order Count - Platform (copy)_6924284442403414022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(&#10;    [Parameters].[Parameter 1]=1,&#10;    {FIXED [date], [Calculation_4124312097893818377], [global_entity_id] : AVG([platform_eur_gmv])},&#10;    {FIXED [date], [Calculation_4124312097893818377], [global_entity_id] : AVG([platform_local_gmv])}&#10;)' />
            </column>
            <column caption='Country Code' datatype='string' name='[Platform Id (copy)_3005167600262213632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT([global_entity_id], 2)' />
            </column>
            <column datatype='string' name='[a_segment]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_116460320639913985]' derivation='Attribute' name='[attr:Calculation_116460320639913985:nk]' pivot='key' type='nominal' />
