      <aliases enabled='yes' />
      <column caption='Repaid Rate' datatype='real' name='[Calculation_1000362128614277125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([is_paid] = &apos;Paid&apos;, [gmv_disbursed_local], 0))&#10;/ SUM([gmv_disbursed_local])' />
      </column>
      <column caption='Disbursement Metric' datatype='real' name='[Calculation_116460320634937344 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Timeframe Parameter (copy)]&#10;WHEN 0 THEN SUM([order_count])//Orders&#10;WHEN 1 THEN SUM([Gmv Collected (copy)_3069695776546131968])//Collected&#10;END' />
      </column>
      <column caption='Collection Metric' datatype='real' name='[Calculation_116460320634937344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN 0 THEN SUM([payment_order_count])//Orders&#10;WHEN 1 THEN SUM([Calculation_2377759915038404608])//Collected&#10;END' />
      </column>
      <column caption='Currency Indicator - Orders Collections' datatype='string' name='[Calculation_116460320639913985]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Metric selector - volumes view (copy)_2086081479285084171]&#10;WHEN 0 THEN IIF([Parameters].[Parameter 1]=1,&quot;€&quot;,&quot;Local&quot;)&#10;WHEN 1 THEN IIF([Parameters].[Parameter 1]=1,&quot;€&quot;,&quot;Local&quot;)&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Collection Metric_avg' datatype='real' name='[Calculation_116460320640913410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN 0 THEN SUM([payment_order_count])/COUNTD([date])//Orders&#10;WHEN 1 THEN SUM({FIXED [date] : SUM([Calculation_2377759915038404608])})/COUNTD([date])//Disbursed&#10;END' />
      </column>
      <column caption='Collected Amount - Timeframe' datatype='real' name='[Calculation_116460320644370435]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Calculation_4124312097893818377], [Platform Id (copy)_3005167600262213632], [date], [Calculation_6421851644014882817]: SUM([Calculation_2377759915038404608])}' />
      </column>
      <column caption='Collection Metric_totals' datatype='real' name='[Calculation_116460320644661252]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN 0 THEN SUM([payment_order_count])//Orders&#10;WHEN 1 THEN SUM([Calculation_116460320644370435])//Collected&#10;END' />
      </column>
      <column caption='Date MIN (day)' datatype='date' name='[Calculation_116460320645115910]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MIN([date])}' />
      </column>
      <column aggregation='Attribute' caption='Gmv Disbursed Proj' datatype='real' name='[Calculation_1183531961612877834 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [repayment_band]&#10;&#10;WHEN &apos;0-6&apos; THEN&#10;{EXCLUDE [repayment_band], [Calculation_1924796273437519872]: &#10;SUM(IF [Calculation_1924796273437519872] &gt;= [Proj Start (copy)_2728548112242339853]&#10;    AND [Calculation_1924796273437519872] &lt;= [Proj End (copy)_2728548112242057228]&#10;    THEN [gmv_disbursed_local] ELSE 0 END)}&#10;&#10;WHEN &apos;7-13&apos; THEN&#10;{EXCLUDE [repayment_band], [Calculation_1924796273437519872]: &#10;SUM(IF [Calculation_1924796273437519872] &gt;= [Proj Start 0-6 (copy)_2728548112244744213]&#10;    AND [Calculation_1924796273437519872] &lt;= [Proj End 0-6 (copy)_2728548112243695630]&#10;    THEN [gmv_disbursed_local] ELSE 0 END)}&#10;&#10;WHEN &apos;14-20&apos; THEN&#10;{EXCLUDE [repayment_band], [Calculation_1924796273437519872]: &#10;SUM(IF [Calculation_1924796273437519872] &gt;= [Proj Start 7-13 (copy)_2728548112244871190]&#10;    AND [Calculation_1924796273437519872] &lt;= [Proj End 7-13 (copy)_2728548112243908623]&#10;    THEN [gmv_disbursed_local] ELSE 0 END)}&#10;&#10;WHEN &apos;21-27&apos; THEN&#10;{EXCLUDE [repayment_band], [Calculation_1924796273437519872]: &#10;SUM(IF [Calculation_1924796273437519872] &gt;= [Proj Start 14-20 (copy)_2728548112244949015]&#10;    AND [Calculation_1924796273437519872] &lt;= [Proj End 14-20 (copy)_2728548112243990544]&#10;    THEN [gmv_disbursed_local] ELSE 0 END)}&#10;&#10;WHEN &apos;28-29&apos; THEN&#10;{EXCLUDE [repayment_band], [Calculation_1924796273437519872]: &#10;SUM(IF [Calculation_1924796273437519872] &gt;= [Proj Start 21-27 (copy)_2728548112245035032]&#10;    AND [Calculation_1924796273437519872] &lt;= [Proj End 30-32 (copy)_2728548112244338706]&#10;    THEN [gmv_disbursed_local] ELSE 0 END)}&#10;&#10;WHEN &apos;30-32&apos; THEN&#10;{EXCLUDE [repayment_band], [Calculation_1924796273437519872]: &#10;SUM(IF [Calculation_1924796273437519872] &gt;= [Proj Start 28-29 (copy)_2728548112245137433]&#10;    AND [Calculation_1924796273437519872] &lt;= [Proj End 21-27 (copy)_2728548112244101137]&#10;    THEN [gmv_disbursed_local] ELSE 0 END)}&#10;&#10;WHEN &apos;33-57&apos; THEN&#10;{EXCLUDE [repayment_band], [Calculation_1924796273437519872]: &#10;SUM(IF [Calculation_1924796273437519872] &gt;= [Proj Start 30-32 (copy)_2728548112245231642]&#10;    AND [Calculation_1924796273437519872] &lt;= [Proj End 30-32 (copy)_2728548112244461587]&#10;    THEN [gmv_disbursed_local] ELSE 0 END)}&#10;&#10;ELSE&#10;{EXCLUDE [repayment_band], [Calculation_1924796273437519872]: &#10;SUM(IF [Calculation_1924796273437519872] &gt;= [Proj Start 33-57 (copy)_2728548112245325851]&#10;    AND [Calculation_1924796273437519872] &lt;= [Proj End 33-57 (copy)_2728548112244600852]&#10;    THEN [gmv_disbursed_local] ELSE 0 END)}&#10;END' />
      </column>
      <column caption='Gmv Disbursed Fixed' datatype='real' name='[Calculation_1183531961612877834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Calculation_4124312097893818377], [Platform Id (copy)_3005167600262213632], [Calculation_1411385958040424448], [Calculation_6421851644014882817], [device] : SUM([gmv_disbursed_local])}' />
      </column>
      <column caption='Repayment Rate' datatype='real' name='[Calculation_1183531961613852683]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_disbursed_local])/SUM([Calculation_1183531961612877834])' />
      </column>
      <column caption='Default Rate - Diff' datatype='real' name='[Calculation_1298021916513665032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Repay Rate - Selected Month (copy)_1298021916490833920] - [Default Rate - Latest (copy)_1298021916512604165])&#10;* 100' />
      </column>
      <column caption='Date Axis' datatype='string' name='[Calculation_1411385958040424448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;day&apos; then STR([date])&#10;WHEN &apos;week&apos; THEN &apos;W&apos;+DATENAME(&apos;week&apos;, [date])+&apos; &apos;+DATENAME(&apos;year&apos;, [date])&#10;WHEN &apos;month&apos; THEN LEFT(DATENAME(&apos;month&apos;, [date]),3)+&apos; &apos;+DATENAME(&apos;year&apos;, [date])&#10;WHEN &apos;quarter&apos; THEN &apos;Q&apos;+DATENAME(&apos;quarter&apos;, [date])+&apos; &apos;+DATENAME(&apos;year&apos;, [date])&#10;END' />
      </column>
      <column caption='Repayment Type Band' datatype='string' name='[Calculation_1411385958074929156]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [repayment_type]&#10;WHEN &apos;Adhoc&apos; THEN &apos;Adhoc&apos; + &quot; - &quot; + [repayment_band (group)]&#10;WHEN &apos;First Attempt&apos; THEN &apos;On Schedule&apos;&#10;ELSE [repayment_type]&#10;END' />
      </column>
      <column caption='Timeframe Date' datatype='date' datatype-customized='true' name='[Calculation_1924796273437519872]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 3], [date]))' />
      </column>
      <column caption='Repayment Groups' datatype='string' name='[Calculation_2086081478964256769]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[View selection (copy)_2086081478960656384]&#10;WHEN 0 THEN [repayment_band (group)]&#10;WHEN 1 THEN [repayment_type (group)]&#10;END' />
      </column>
      <column caption='Repayment Legend' datatype='string' name='[Calculation_2086081478966009858]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[View selection (copy)_2086081478960656384]&#10;WHEN 0 THEN [repayment_band]&#10;WHEN 1 THEN [Calculation_1411385958074929156]&#10;END' />
      </column>
      <column caption='Repayment Rate Mark' datatype='real' name='[Calculation_2086081478972547075]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[View selection (copy)_2086081478960656384]&#10;WHEN 0 THEN [Default Rate (copy)_2728548111929581571]&#10;WHEN 1 THEN [Calculation_1183531961613852683]&#10;END' />
      </column>
      <column caption='Gmv Collected' datatype='real' name='[Calculation_2377759915038404608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 1]=1,[gmv_collected_eur], [gmv_collected_local])' />
      </column>
      <column caption='Default Rate' datatype='real' name='[Calculation_2728548111900991488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM(&#10;    IF (NOT [repayment_band] IN (&apos;91+&apos;, &apos;Not Paid&apos;))&#10;    AND ([date] &lt;= &#10;        DATEADD(&apos;day&apos;, -1,&#10;        DATEADD([Parameters].[Parameter 3], 1, [Calculation_2728548111918075905])))&#10;    THEN [gmv_disbursed_local]&#10;    ELSE NULL END&#10;) / SUM([Calculation_1183531961612877834])' />
      </column>
      <column caption='Proj End' datatype='datetime' name='[Calculation_2728548111918075905 1]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD([Parameters].[Parameter 3], -1,&#10;DATETRUNC(&#10;    [Parameters].[Parameter 3],&#10;    DATEADD(&#10;        &apos;day&apos;,&#10;        CASE [repayment_band]&#10;            WHEN &apos;0-6&apos; THEN -7&#10;            WHEN &apos;7-13&apos; THEN -14&#10;            WHEN &apos;14-20&apos; THEN -21&#10;            WHEN &apos;21-27&apos; THEN -28&#10;            WHEN &apos;28-29&apos; THEN -30&#10;            WHEN &apos;30-32&apos; THEN -33&#10;            WHEN &apos;33-57&apos; THEN -58&#10;            WHEN &apos;58-90&apos; THEN -91&#10;            WHEN &apos;91+&apos; THEN -91&#10;            WHEN &apos;Not Paid&apos; THEN -91&#10;            ELSE NULL END,&#10;        DATEADD(&apos;hour&apos;, 4, TODAY()))&#10;))' />
      </column>
      <column caption='Last Date Default' datatype='datetime' name='[Calculation_2728548111918075905]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD([Parameters].[Parameter 3], -1,&#10;DATETRUNC([Parameters].[Parameter 3], &#10;    DATEADD(&apos;day&apos;, -91, DATEADD(&apos;hour&apos;, 4, TODAY()))&#10;))' />
      </column>
      <column caption='Proj Start' datatype='datetime' name='[Calculation_2728548111942230025]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Data point 3 months ago&#10;DATETRUNC([Parameters].[Parameter 3], DATEADD(&apos;month&apos;, -2, [Calculation_2728548111918075905 1]))' />
      </column>
      <column aggregation='Attribute' caption='Repayment Rate Proj' datatype='real' name='[Calculation_2728548112246771740]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Gmv Collected Proj (copy)_2728548112247955485] / [Calculation_1183531961612877834 1]' />
      </column>
      <column aggregation='Attribute' caption='Not Paid Rate Proj' datatype='real' name='[Calculation_2728548112249634846]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [repayment_band] : MIN([Calculation_2728548112246771740])}' />
      </column>
      <column caption='Date - Month' datatype='date' name='[Calculation_2795679873944383488]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [date]))' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_2825305100872560656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Gmv Collected (copy)_3069695776546131968])/sum([Order Count - Platform (copy)_6924284442403414022])' />
      </column>
      <column caption='Liability Agg' datatype='real' name='[Calculation_3069695776600100874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Gmv Disbursed (copy)_3069695776579584006]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Date - 30 days before' datatype='date' name='[Calculation_3097421062165336066]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;, -30, [date]))' />
      </column>
      <column caption='Date Range - Selected' datatype='string' name='[Calculation_3097421062452285443]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;from: &apos; + &#10;STR(DAY([Calculation_3097421062165336066]))&#10;+&apos;.&apos;+&#10;STR(MONTH([Calculation_3097421062165336066]))&#10;+&apos;.&apos;+&#10;STR(YEAR([Calculation_3097421062165336066]))&#10;+ &apos;&#10;to:&apos;' />
      </column>
      <column caption='Rolling GMV Penetration - Selected' datatype='real' default-format='p0.00%' name='[Calculation_3097421062456254469]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [date] = [Parameters].[Date (Bnpl Rolling Mau) Parameter (copy)_3097421062455193604]&#10;THEN [gmv_penetration_30d_rolling]&#10;END' />
      </column>
      <column caption='from_date_title_card' datatype='date' name='[Calculation_3097421062460375047]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;,-30, [Parameters].[Date (Bnpl Rolling Mau) Parameter (copy)_3097421062455193604]))' />
      </column>
      <column caption='Fallback' datatype='string' name='[Calculation_3325486170843664384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [is_fallback] then &apos;Yes&apos; else &apos;No&apos; end' />
      </column>
      <column caption='Date MAX (day)' datatype='date' default-format='*m/d/yyyy' name='[Calculation_3799067791296081920]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX([date])}' />
      </column>
      <column caption='Date Range STR' datatype='string' name='[Calculation_3799067791296376834]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DAY([Calculation_116460320645115910]))+&quot;.&quot;+&#10;STR(MONTH([Calculation_116460320645115910]))+&quot;.&quot;+&#10;STR(YEAR([Calculation_116460320645115910]))&#10; + &quot; to &quot; + &#10;STR(DAY([Calculation_3799067791296081920]))+&quot;.&quot;+&#10;STR(MONTH([Calculation_3799067791296081920]))+&quot;.&quot;+&#10;STR(YEAR([Calculation_3799067791296081920]))' />
      </column>
      <column caption='Platform Id' datatype='string' name='[Calculation_4124312097893818377]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[platform]' />
      </column>
      <column caption='Platform GMV - Selected Month' datatype='real' name='[Calculation_4576853548151508992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(&#10;    [Parameters].[Parameter 1]=1,&#10;    {FIXED [date], [Calculation_4124312097893818377] : AVG( IIF([Calculation_93520122110033922], [gmv_disbursed_eur],Null) / IIF([Calculation_93520122110033922],[gmv_disbursed_eur_platform_share], Null))},&#10;    {FIXED [date], [Calculation_4124312097893818377] : AVG( IIF([Calculation_93520122110033922], [gmv_disbursed_local],Null) / IIF([Calculation_93520122110033922],[gmv_disbursed_local_platform_share],Null))}&#10;)' />
      </column>
      <column caption='Platform GMV Share - Month' datatype='real' default-format='p0.00%' name='[Calculation_4576853548225060865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4807029695973330975] / SUM([Calculation_4576853548151508992])' />
      </column>
      <column caption='Platform GMV - Selected Month v2' datatype='real' name='[Calculation_4576853548225986562]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([Calculation_93520122110033922],&#10;{FIXED DATETRUNC(&apos;month&apos;, [date]), [Calculation_4124312097893818377] : MIN(&#10;&#10;IIF(&#10;    [Parameters].[Parameter 1]=1,&#10;    {FIXED [date], [Calculation_4124312097893818377] : AVG([gmv_disbursed_eur] / [gmv_disbursed_eur_platform_share])},&#10;    {FIXED [date], [Calculation_4124312097893818377] : AVG([gmv_disbursed_local] / [gmv_disbursed_local_platform_share])}&#10;)&#10;)&#10;}&#10;,Null))' />
      </column>
      <column caption='Last full month' datatype='datetime' datatype-customized='true' name='[Calculation_4582834877410529280]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX(DATEADD(&apos;month&apos;, -1, [Calculation_2795679873944383488]))}' />
      </column>
      <column caption='Repay Rate - Up Arrow' datatype='string' name='[Calculation_4807029695966720022 1]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF([Calculation_93520122113298437 1] &gt; 0, &quot;▲&quot;, Null)' />
      </column>
      <column caption='Order Count - Up Arrow' datatype='string' name='[Calculation_4807029695966720022]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF([Calculation_93520122113298437] &gt; 0, &quot;▲&quot;, Null)' />
      </column>
      <column caption='Collected Amt - Selected Month' datatype='real' name='[Calculation_4807029695971508251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([Calculation_93520122110033922], [Calculation_2377759915038404608], Null))' />
      </column>
      <column caption='Collected Amt - Diff' datatype='real' default-format='p0.0%' name='[Calculation_4807029695971794973]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4807029695971508251] / [Collected Amt (exc Never Paid) Last month (copy)_4807029695971729436]&#10;- 1' />
      </column>
      <column caption='Disbursed Amt - Selected Month' datatype='real' name='[Calculation_4807029695973330975]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([Calculation_93520122110033922], [Gmv Collected (copy)_3069695776546131968], Null))' />
      </column>
      <column caption='Disbursed Amt - Diff' datatype='real' default-format='p0.0%' name='[Calculation_4807029695973781537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4807029695973330975] &#10;/ [Disbursed Amt - Last Month (copy)_4807029695973703712]&#10;- 1' />
      </column>
      <column caption='Is Actual' datatype='boolean' name='[Calculation_5033617065331302400]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1924796273437519872] &lt;= [Calculation_2728548111918075905 1]' />
      </column>
      <column caption='Repayment Band Selected' datatype='string' name='[Calculation_5837017015141511168 1]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN 0 THEN [repayment_band (group)]&#10;WHEN 1 THEN &quot;&quot;&#10;END' />
      </column>
      <column caption='Repayment Axis' datatype='string' name='[Calculation_5837017015141511168]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN 0 THEN [Calculation_2086081478964256769]&#10;WHEN 1 THEN &quot;&quot;&#10;END' />
      </column>
      <column caption='Metric Selected' datatype='real' name='[Calculation_5837017015177383939]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;WHEN 0 THEN [Calculation_2086081478972547075]&#10;WHEN 1 THEN ROUND(SUM([gmv_disbursed_local]),0)&#10;END' />
      </column>
      <column caption='Dimension Breakdown' datatype='string' name='[Calculation_6421851644014882817]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Repayment Rates breakdown (copy)_6421851644013830144]&#10;WHEN &apos;total&apos; THEN &apos;Total&apos;&#10;WHEN &apos;device&apos; THEN [device]&#10;WHEN &apos;a_segment&apos; THEN [a_segment]&#10;WHEN &apos;loyalty_segment&apos; THEN [loyalty_segment]&#10;WHEN &apos;is_first_order&apos; THEN [is_first_order]&#10;WHEN &apos;country&apos; THEN [Platform Id (copy)_3005167600262213632]&#10;WHEN &apos;vertical&apos; then [vertical]&#10;WHEN &apos;fallback&apos; then [Calculation_3325486170843664384]&#10;WHEN &apos;payment_requestor&apos; then [payment_requestor]&#10;WHEN &apos;installment_repayment_method&apos; then [installment_repayment_method]&#10;END' />
        <aliases>
          <alias key='&quot;0-6, 14-20, 21-27 and 6 more&quot;' value='Paid' />
          <alias key='&quot;CREDIT&quot;' value='Credit' />
          <alias key='&quot;DEBIT&quot;' value='Debit' />
          <alias key='&quot;false&quot;' value='Returning' />
          <alias key='&quot;true&quot;' value='New' />
        </aliases>
      </column>
      <column caption='Is Too Recent' datatype='boolean' name='[Calculation_6715078151364825088]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date] = TODAY()' />
      </column>
      <column caption='Order Count - Platform' datatype='real' name='[Calculation_6924284442377621505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [date], [Calculation_4124312097893818377] : AVG([order_count] / [order_count_platform_share])}' />
      </column>
      <column caption='Order Count Platform Share' datatype='real' name='[Calculation_6924284442397212674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[order_count] / {FIXED [Calculation_4124312097893818377], [Calculation_1924796273437519872]: SUM([Calculation_6924284442377621505])}' />
      </column>
      <column caption='Color Logic' datatype='real' name='[Calculation_919156572697776129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Currency (copy)]&#10;WHEN 1 THEN&#10;([Metric Selected (copy)_919156572688576512]-WINDOW_MIN([Metric Selected (copy)_919156572688576512]))&#10;/&#10;(WINDOW_MAX([Metric Selected (copy)_919156572688576512])-WINDOW_MIN([Metric Selected (copy)_919156572688576512]))&#10;WHEN 2 THEN&#10;([Metric Selected (copy)_919156572688576512]-WINDOW_MIN([Metric Selected (copy)_919156572688576512]))&#10;/&#10;(WINDOW_MAX([Metric Selected (copy)_919156572688576512])-WINDOW_MIN([Metric Selected (copy)_919156572688576512]))&#10;&#10;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Date Axis Title' datatype='string' name='[Calculation_93520122084179969]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Metric selector - volumes view (copy)_2086081479285084171]&#10;WHEN 0 THEN &apos;Order Date&apos;&#10;WHEN 1 THEN &apos;Repayment Date&apos;&#10;WHEN 2 THEN &apos;Order Date&apos;&#10;WHEN 3 THEN &apos;Repayment Date&apos;&#10;END' />
      </column>
      <column caption='Is Selected Month' datatype='boolean' name='[Calculation_93520122110033922]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [date])=[Parameters].[Date - Month Parameter]' />
