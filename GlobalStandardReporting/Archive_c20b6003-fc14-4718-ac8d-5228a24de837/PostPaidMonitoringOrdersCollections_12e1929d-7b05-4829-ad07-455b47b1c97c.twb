            </column>
            <column datatype='string' name='[repayment_type]' role='dimension' type='nominal' />
            <column-instance column='[gmv_disbursed_local]' derivation='Sum' name='[sum:gmv_disbursed_local:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2086081478972547075]' derivation='User' name='[usr:Calculation_2086081478972547075:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_5837017015177383939]' derivation='User' name='[usr:Calculation_5837017015177383939:qk]' pivot='key' type='quantitative' />
