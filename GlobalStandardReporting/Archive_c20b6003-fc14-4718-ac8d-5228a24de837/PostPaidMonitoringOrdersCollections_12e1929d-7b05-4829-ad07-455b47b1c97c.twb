      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bnpl_activity_daily (rl_fintech)' name='federated.042hnnc06vcl8917yflhy11slm65' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Timeframe' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column alias='Grouped' caption='View selection' datatype='integer' name='[Parameter 6]' param-domain-type='list' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='Grouped' />
                <alias key='1' value='Stacked' />
              </aliases>
            </column>
            <column alias='GMV Repaid' caption='Metric Selector - Repayment' datatype='integer' name='[Parameter 7]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='0' value='Repaid Share %' />
                <alias key='1' value='GMV Repaid' />
              </aliases>
            </column>
            <column alias='Total' caption='Breakdown' datatype='string' name='[Repayment Rates breakdown (copy)_6421851644013830144]' param-domain-type='list' role='measure' type='nominal' value='&quot;total&quot;'>
              <calculation class='tableau' formula='&quot;total&quot;' />
              <aliases>
                <alias key='&quot;a_segment&quot;' value='A Segment' />
                <alias key='&quot;country&quot;' value='Country' />
                <alias key='&quot;device&quot;' value='Device' />
                <alias key='&quot;fallback&quot;' value='Fallback' />
                <alias key='&quot;installment_repayment_method&quot;' value='Installment Repayment Method' />
                <alias key='&quot;is_first_order&quot;' value='New / Returning Customers' />
                <alias key='&quot;loyalty_segment&quot;' value='Loyalty Segment' />
                <alias key='&quot;payment_requestor&quot;' value='Payment Requestor' />
                <alias key='&quot;total&quot;' value='Total' />
                <alias key='&quot;vertical&quot;' value='Vertical' />
              </aliases>
            </column>
            <column alias='Duration' caption='Repayment Categories' datatype='integer' name='[View selection (copy)_2086081478960656384]' param-domain-type='list' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='Duration' />
                <alias key='1' value='Method' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.042hnnc06vcl8917yflhy11slm65'>
            <column caption='Gmv Disbursed Fixed' datatype='real' name='[Calculation_1183531961612877834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Calculation_4124312097893818377], [Platform Id (copy)_3005167600262213632], [Calculation_1411385958040424448], [Calculation_6421851644014882817], [device] : SUM([gmv_disbursed_local])}' />
            </column>
            <column caption='Repayment Rate' datatype='real' name='[Calculation_1183531961613852683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_disbursed_local])/SUM([Calculation_1183531961612877834])' />
            </column>
            <column caption='Date Axis' datatype='string' name='[Calculation_1411385958040424448]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;day&apos; then STR([date])&#10;WHEN &apos;week&apos; THEN &apos;W&apos;+DATENAME(&apos;week&apos;, [date])+&apos; &apos;+DATENAME(&apos;year&apos;, [date])&#10;WHEN &apos;month&apos; THEN LEFT(DATENAME(&apos;month&apos;, [date]),3)+&apos; &apos;+DATENAME(&apos;year&apos;, [date])&#10;WHEN &apos;quarter&apos; THEN &apos;Q&apos;+DATENAME(&apos;quarter&apos;, [date])+&apos; &apos;+DATENAME(&apos;year&apos;, [date])&#10;END' />
            </column>
            <column caption='Repayment Type Band' datatype='string' name='[Calculation_1411385958074929156]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [repayment_type]&#10;WHEN &apos;Adhoc&apos; THEN &apos;Adhoc&apos; + &quot; - &quot; + [repayment_band (group)]&#10;WHEN &apos;First Attempt&apos; THEN &apos;On Schedule&apos;&#10;ELSE [repayment_type]&#10;END' />
            </column>
            <column caption='Timeframe Date' datatype='date' datatype-customized='true' name='[Calculation_1924796273437519872]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 3], [date]))' />
            </column>
            <column caption='Repayment Groups' datatype='string' name='[Calculation_2086081478964256769]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[View selection (copy)_2086081478960656384]&#10;WHEN 0 THEN [repayment_band (group)]&#10;WHEN 1 THEN [repayment_type (group)]&#10;END' />
            </column>
            <column caption='Repayment Legend' datatype='string' name='[Calculation_2086081478966009858]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[View selection (copy)_2086081478960656384]&#10;WHEN 0 THEN [repayment_band]&#10;WHEN 1 THEN [Calculation_1411385958074929156]&#10;END' />
            </column>
            <column caption='Repayment Rate Mark' datatype='real' name='[Calculation_2086081478972547075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[View selection (copy)_2086081478960656384]&#10;WHEN 0 THEN [Default Rate (copy)_2728548111929581571]&#10;WHEN 1 THEN [Calculation_1183531961613852683]&#10;END' />
            </column>
            <column caption='Proj End' datatype='datetime' name='[Calculation_2728548111918075905 1]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD([Parameters].[Parameter 3], -1,&#10;DATETRUNC(&#10;    [Parameters].[Parameter 3],&#10;    DATEADD(&#10;        &apos;day&apos;,&#10;        CASE [repayment_band]&#10;            WHEN &apos;0-6&apos; THEN -7&#10;            WHEN &apos;7-13&apos; THEN -14&#10;            WHEN &apos;14-20&apos; THEN -21&#10;            WHEN &apos;21-27&apos; THEN -28&#10;            WHEN &apos;28-29&apos; THEN -30&#10;            WHEN &apos;30-32&apos; THEN -33&#10;            WHEN &apos;33-57&apos; THEN -58&#10;            WHEN &apos;58-90&apos; THEN -91&#10;            WHEN &apos;91+&apos; THEN -91&#10;            WHEN &apos;Not Paid&apos; THEN -91&#10;            ELSE NULL END,&#10;        DATEADD(&apos;hour&apos;, 4, TODAY()))&#10;))' />
            </column>
            <column caption='Fallback' datatype='string' name='[Calculation_3325486170843664384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_fallback] then &apos;Yes&apos; else &apos;No&apos; end' />
            </column>
            <column caption='Platform Id' datatype='string' name='[Calculation_4124312097893818377]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[platform]' />
            </column>
            <column caption='Is Actual' datatype='boolean' name='[Calculation_5033617065331302400]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1924796273437519872] &lt;= [Calculation_2728548111918075905 1]' />
            </column>
            <column caption='Repayment Axis' datatype='string' name='[Calculation_5837017015141511168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN 0 THEN [Calculation_2086081478964256769]&#10;WHEN 1 THEN &quot;&quot;&#10;END' />
            </column>
            <column caption='Metric Selected' datatype='real' name='[Calculation_5837017015177383939]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;WHEN 0 THEN [Calculation_2086081478972547075]&#10;WHEN 1 THEN ROUND(SUM([gmv_disbursed_local]),0)&#10;END' />
            </column>
            <column caption='Dimension Breakdown' datatype='string' name='[Calculation_6421851644014882817]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Repayment Rates breakdown (copy)_6421851644013830144]&#10;WHEN &apos;total&apos; THEN &apos;Total&apos;&#10;WHEN &apos;device&apos; THEN [device]&#10;WHEN &apos;a_segment&apos; THEN [a_segment]&#10;WHEN &apos;loyalty_segment&apos; THEN [loyalty_segment]&#10;WHEN &apos;is_first_order&apos; THEN [is_first_order]&#10;WHEN &apos;country&apos; THEN [Platform Id (copy)_3005167600262213632]&#10;WHEN &apos;vertical&apos; then [vertical]&#10;WHEN &apos;fallback&apos; then [Calculation_3325486170843664384]&#10;WHEN &apos;payment_requestor&apos; then [payment_requestor]&#10;WHEN &apos;installment_repayment_method&apos; then [installment_repayment_method]&#10;END' />
              <aliases>
                <alias key='&quot;0-6, 14-20, 21-27 and 6 more&quot;' value='Paid' />
                <alias key='&quot;CREDIT&quot;' value='Credit' />
                <alias key='&quot;DEBIT&quot;' value='Debit' />
                <alias key='&quot;false&quot;' value='Returning' />
                <alias key='&quot;true&quot;' value='New' />
              </aliases>
            </column>
            <column caption='Repayment Rate Cropped' datatype='real' name='[Default Rate (copy)_2728548111929581571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(&#10;    ATTR([Calculation_5033617065331302400]),&#10;    SUM([gmv_disbursed_local]) / SUM([Calculation_1183531961612877834]),&#10;    NULL)' />
            </column>
            <column caption='Country Code' datatype='string' name='[Platform Id (copy)_3005167600262213632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT([global_entity_id], 2)' />
            </column>
            <column datatype='string' name='[a_segment]' role='dimension' type='nominal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[device]' role='dimension' type='nominal' />
            <column caption='Global Entity Id (Bnpl Rolling Gmv Penetration)' datatype='string' name='[global_entity_id (bnpl_rolling_gmv_penetration)]' role='dimension' type='nominal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Gmv Disbursed Local' datatype='real' name='[gmv_disbursed_local]' role='measure' type='quantitative' />
            <column caption='Installment Repayment Method' datatype='string' name='[installment_repayment_method]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_fallback]' role='dimension' type='nominal' />
            <column datatype='string' datatype-customized='true' name='[is_first_order]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;false&quot;' value='Returning' />
                <alias key='&quot;true&quot;' value='New' />
              </aliases>
            </column>
            <column datatype='string' name='[loyalty_segment]' role='dimension' type='nominal' />
            <column-instance column='[date]' derivation='Min' name='[min:date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1411385958040424448]' derivation='None' name='[none:Calculation_1411385958040424448:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2086081478966009858]' derivation='None' name='[none:Calculation_2086081478966009858:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5837017015141511168]' derivation='None' name='[none:Calculation_5837017015141511168:nk]' pivot='key' type='nominal' />
            <column-instance column='[Platform Id (copy)_3005167600262213632]' derivation='None' name='[none:Platform Id (copy)_3005167600262213632:nk]' pivot='key' type='nominal' />
            <column-instance column='[date]' derivation='None' name='[none:date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[device]' derivation='None' name='[none:device:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id (bnpl_rolling_gmv_penetration)]' derivation='None' name='[none:global_entity_id (bnpl_rolling_gmv_penetration):nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[payment_requestor]' derivation='None' name='[none:payment_requestor:nk]' pivot='key' type='nominal' />
            <column caption='Repayment Requestor' datatype='string' name='[payment_requestor]' role='dimension' type='nominal' />
            <column datatype='string' name='[platform]' role='dimension' type='nominal' />
            <column datatype='string' name='[repayment_band (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[repayment_band]' new-bin='true'>
                <bin default-name='false' value='&quot;Early&quot;'>
                  <value>&quot;0-6&quot;</value>
                  <value>&quot;14-20&quot;</value>
                  <value>&quot;21-27&quot;</value>
                  <value>&quot;28-29&quot;</value>
                  <value>&quot;7-13&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Late&quot;'>
                  <value>&quot;33-57&quot;</value>
                  <value>&quot;58-90&quot;</value>
                  <value>&quot;91+&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;On Time&quot;'>
                  <value>&quot;30-32&quot;</value>
                </bin>
              </calculation>
            </column>
            <column datatype='string' name='[repayment_band]' role='dimension' type='nominal' />
            <column datatype='string' name='[repayment_type (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[repayment_type]' new-bin='true'>
                <bin default-name='false' value='&quot;On Schedule&quot;'>
                  <value>&quot;First Attempt&quot;</value>
