          </datasource-dependencies>
          <computed-sort column='[federated.042hnnc06vcl8917yflhy11slm65].[none:Calculation_1411385958040424448:nk]' direction='ASC' using='[federated.042hnnc06vcl8917yflhy11slm65].[min:date:qk]' />
          <filter class='categorical' column='[federated.042hnnc06vcl8917yflhy11slm65].[none:Calculation_2086081478966009858:nk]'>
            <groupfilter function='level-members' level='[none:Calculation_2086081478966009858:nk]' />
          </filter>
          <manual-sort column='[federated.042hnnc06vcl8917yflhy11slm65].[none:Calculation_2086081478966009858:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Not Paid&quot;</bucket>
              <bucket>&quot;On Schedule&quot;</bucket>
              <bucket>&quot;Adhoc - Early&quot;</bucket>
              <bucket>&quot;Adhoc - On Time&quot;</bucket>
              <bucket>&quot;Adhoc - Late&quot;</bucket>
