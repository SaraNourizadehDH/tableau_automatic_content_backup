          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#4e79a7' fontname='Tableau Book'>F1 Score</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='perf_metrics (ft_model_monitor)' name='federated.0ezq4mb1bbk0gx19gowcf0ymvm20' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='TEST: Choose Threshold' datatype='string' datatype-customized='true' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;pctl_90.0&quot;'>
              <calculation class='tableau' formula='&quot;pctl_90.0&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ezq4mb1bbk0gx19gowcf0ymvm20'>
            <column caption='Chargeback_revised' datatype='string' name='[Calculation_1270226254445654017]' role='dimension' type='nominal'>
