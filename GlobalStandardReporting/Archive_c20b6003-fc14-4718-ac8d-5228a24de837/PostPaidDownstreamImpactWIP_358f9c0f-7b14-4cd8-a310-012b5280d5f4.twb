              <calculation class='tableau' formula='[reference_month] &lt;= [Parameters].[Parameter 1]' />
            </column>
            <column caption='Incremental Recovered Customers' datatype='real' name='[Calculation_2320479709138853892]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-(&#10;    ( SUM(IIF([is_adopter],[customer_churn_count], Null)) / SUM(IIF([is_adopter],[customer_count], Null)) )&#10;    -&#10;    ( SUM(IIF(NOT [is_adopter],[customer_churn_count], Null)) / SUM(IIF(NOT [is_adopter],[customer_count], Null)) )&#10;)&#10;*SUM([federated.0h5zhuo0eapc9e14yyv6s054on5p].[active_users])' />
            </column>
            <column caption='Incremental Recovered Cust. Share' datatype='real' default-format='p0.0%' name='[Calculation_2320479709139668997]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2320479709138853892]/SUM([federated.0h5zhuo0eapc9e14yyv6s054on5p].[active_users])' />
            </column>
            <column caption='Post-adoption + limit' datatype='boolean' name='[Calculation_277112181186707456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[reference_month] &gt; 0 AND [Calculation_126523068041449474]' />
            </column>
