      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Semibold'>Customer Churn Rate</run>
            <run>Æ&#10;</run>
            <run fontcolor='#333333' fontsize='10'>Monthly trend and increments</run>
            <run>Æ&#10;</run>
            <run fontcolor='#555555' fontname='Tableau Regular' fontsize='9'><![CDATA[For <[federated.0lszcyb086r77z1gld1lh168jf7k].[my:adoption_month:ok]> adopters]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bnpl_downstream_impact (rl_fintech)' name='federated.0lszcyb086r77z1gld1lh168jf7k' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Post-adoption Months' datatype='integer' datatype-customized='true' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
              <range max='12' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0lszcyb086r77z1gld1lh168jf7k'>
            <column caption='Customer Churn diff' datatype='real' default-format='*0.0;-0.0' name='[AOV diff (copy)_744993958127349779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    ( SUM(IIF([is_adopter],[customer_churn_count], Null)) / SUM(IIF([is_adopter],[customer_count], Null)) )&#10;    -&#10;    ( SUM(IIF(NOT [is_adopter],[customer_churn_count], Null)) / SUM(IIF(NOT [is_adopter],[customer_count], Null)) )&#10;)&#10;*100' />
            </column>
            <column caption='Post-adoption months limit' datatype='boolean' name='[Calculation_126523068041449474]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[reference_month] &lt;= [Parameters].[Parameter 1]' />
            </column>
            <column caption='Post-adoption + limit' datatype='boolean' name='[Calculation_277112181186707456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[reference_month] &gt; 0 AND [Calculation_126523068041449474]' />
            </column>
            <column caption='Customer Churn Rate' datatype='real' default-format='p0.0%' name='[Calculation_744993958085517315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_churn_count])/SUM(IIF([order_count]&gt;0,[customer_count],Null))' />
            </column>
            <column caption='Adoption Date' datatype='date' name='[adoption_month]' role='dimension' type='ordinal' />
            <column caption='Customer Churn Count' datatype='integer' name='[customer_churn_count]' role='measure' type='quantitative' />
            <column caption='Customer Count' datatype='integer' name='[customer_count]' role='measure' type='quantitative' />
            <column caption='User group' datatype='boolean' name='[is_adopter]' role='dimension' type='nominal'>
