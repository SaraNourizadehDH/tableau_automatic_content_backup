    <worksheet name='table_all_cohorts'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Monthly &lt;</run>
            <run>[Parameters].[Parameter 2]</run>
            <run>&gt; uplift per cohort</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bnpl_downstream_impact (rl_fintech)' name='federated.0lszcyb086r77z1gld1lh168jf7k' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='AOF' caption='Select a metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;aof&quot;'>
              <calculation class='tableau' formula='&quot;aof&quot;' />
              <aliases>
                <alias key='&quot;aof&quot;' value='AOF' />
                <alias key='&quot;aov&quot;' value='AOV' />
                <alias key='&quot;churn&quot;' value='Avg. Churn' />
                <alias key='&quot;gmv&quot;' value='Avg. GMV per customer' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0lszcyb086r77z1gld1lh168jf7k'>
            <column caption='AOV diff' datatype='real' default-format='*0.0%;-0.0%' name='[AOV (copy)_744993958089789450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( SUM(IIF([is_adopter],[gmv_total], Null)) / SUM(IIF([is_adopter],[order_count], Null)) )&#10;/&#10;( SUM(IIF(NOT [is_adopter],[gmv_total], Null)) / SUM(IIF(NOT [is_adopter],[order_count], Null)) )&#10;-1' />
            </column>
            <column caption='AOF diff' datatype='real' default-format='*0.0%;-0.0%' name='[AOV diff (copy)_744993958119157774]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( SUM(IIF([is_adopter],[order_count], Null)) / SUM(IIF([is_adopter],[customer_count], Null)) )&#10;/&#10;( SUM(IIF(NOT [is_adopter],[order_count], Null)) / SUM(IIF(NOT [is_adopter],[customer_count], Null)) )&#10;-1' />
            </column>
            <column caption='GMV per customer diff' datatype='real' default-format='*0.0%;-0.0%' name='[AOV diff (copy)_744993958124019730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( SUM(IIF([is_adopter],[gmv_total], Null)) / SUM(IIF([is_adopter],[customer_count], Null)) )&#10;/&#10;( SUM(IIF(NOT [is_adopter],[gmv_total], Null)) / SUM(IIF(NOT [is_adopter],[customer_count], Null)) ) - 1' />
            </column>
            <column caption='Customer Churn diff' datatype='real' default-format='*0.0;-0.0' name='[AOV diff (copy)_744993958127349779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    ( SUM(IIF([is_adopter],[customer_churn_count], Null)) / SUM(IIF([is_adopter],[customer_count], Null)) )&#10;    -&#10;    ( SUM(IIF(NOT [is_adopter],[customer_churn_count], Null)) / SUM(IIF(NOT [is_adopter],[customer_count], Null)) )&#10;)&#10;*100' />
            </column>
            <column caption='Order Month' datatype='string' name='[Calculation_2320479709189558282]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[order_month]) + &apos; &apos; + STR(YEAR([order_month]))' />
            </column>
            <column caption='Metric by Parameter' datatype='real' name='[Calculation_2320479709191589901]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;aof&apos; THEN [AOV diff (copy)_744993958119157774]*100&#10;WHEN &apos;aov&apos; THEN [AOV (copy)_744993958089789450]*100&#10;WHEN &apos;gmv&apos; THEN [AOV diff (copy)_744993958124019730]*100&#10;WHEN &apos;churn&apos; THEN [AOV diff (copy)_744993958127349779]&#10;ELSE Null&#10;END' />
