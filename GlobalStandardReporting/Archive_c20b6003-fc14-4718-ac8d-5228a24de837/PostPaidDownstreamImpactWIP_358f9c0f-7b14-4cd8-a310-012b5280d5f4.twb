      <column caption='AOV arrow indicator' datatype='string' name='[AOF arrow indicator (copy)_80501908275593221]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF([AOV (copy)_744993958089789450]&gt;=0,&apos;▲&apos;,&apos;▼&apos;)' />
      </column>
      <column caption='AOF increase' datatype='real' name='[AOF diff (copy)_5333387859102330880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( SUM(IIF([is_adopter],[order_count], Null)) / SUM(IIF([is_adopter],[customer_count], Null)) )&#10;-&#10;( SUM(IIF(NOT [is_adopter],[order_count], Null)) / SUM(IIF(NOT [is_adopter],[customer_count], Null)) )' />
      </column>
      <column caption='AOV diff' datatype='real' default-format='*0.0%;-0.0%' name='[AOV (copy)_744993958089789450]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( SUM(IIF([is_adopter],[gmv_total], Null)) / SUM(IIF([is_adopter],[order_count], Null)) )&#10;/&#10;( SUM(IIF(NOT [is_adopter],[gmv_total], Null)) / SUM(IIF(NOT [is_adopter],[order_count], Null)) )&#10;-1' />
      </column>
      <column caption='GMV arrow indicator' datatype='string' name='[AOV arrow indicator (copy)_80501908277669894]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF([AOV diff (copy)_744993958124019730]&gt;=0,&apos;▲&apos;,&apos;▼&apos;)' />
      </column>
      <column caption='AOF diff' datatype='real' default-format='*0.0%;-0.0%' name='[AOV diff (copy)_744993958119157774]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( SUM(IIF([is_adopter],[order_count], Null)) / SUM(IIF([is_adopter],[customer_count], Null)) )&#10;/&#10;( SUM(IIF(NOT [is_adopter],[order_count], Null)) / SUM(IIF(NOT [is_adopter],[customer_count], Null)) )&#10;-1' />
      </column>
      <column caption='GMV per customer diff' datatype='real' default-format='*0.0%;-0.0%' name='[AOV diff (copy)_744993958124019730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( SUM(IIF([is_adopter],[gmv_total], Null)) / SUM(IIF([is_adopter],[customer_count], Null)) )&#10;/&#10;( SUM(IIF(NOT [is_adopter],[gmv_total], Null)) / SUM(IIF(NOT [is_adopter],[customer_count], Null)) ) - 1' />
      </column>
      <column caption='Customer Churn diff' datatype='real' default-format='*0.0;-0.0' name='[AOV diff (copy)_744993958127349779]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    ( SUM(IIF([is_adopter],[customer_churn_count], Null)) / SUM(IIF([is_adopter],[customer_count], Null)) )&#10;    -&#10;    ( SUM(IIF(NOT [is_adopter],[customer_churn_count], Null)) / SUM(IIF(NOT [is_adopter],[customer_count], Null)) )&#10;)&#10;*100' />
      </column>
      <column caption='Post-adoption months limit' datatype='boolean' name='[Calculation_126523068041449474]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[reference_month] &lt;= [Parameters].[Parameter 1]' />
      </column>
      <column caption='Incremental Orders Share' datatype='real' default-format='p0.0%' name='[Calculation_2320479708844589058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5333387859103858689]/SUM([federated.0h5zhuo0eapc9e14yyv6s054on5p].[order_count])' />
      </column>
      <column caption='Incremental GMV Share' datatype='real' default-format='p0.0%' name='[Calculation_2320479708845731843]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Incremental Orders (copy)_2320479708453556225]/SUM([federated.0h5zhuo0eapc9e14yyv6s054on5p].[gmv_disbursed_local])' />
      </column>
      <column caption='Incremental Recovered Customers' datatype='real' name='[Calculation_2320479709138853892]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-(&#10;    ( SUM(IIF([is_adopter],[customer_churn_count], Null)) / SUM(IIF([is_adopter],[customer_count], Null)) )&#10;    -&#10;    ( SUM(IIF(NOT [is_adopter],[customer_churn_count], Null)) / SUM(IIF(NOT [is_adopter],[customer_count], Null)) )&#10;)&#10;*SUM([federated.0h5zhuo0eapc9e14yyv6s054on5p].[active_users])' />
      </column>
      <column caption='Incremental Recovered Cust. Share' datatype='real' default-format='p0.0%' name='[Calculation_2320479709139668997]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2320479709138853892]/SUM([federated.0h5zhuo0eapc9e14yyv6s054on5p].[active_users])' />
      </column>
      <column caption='Order Month' datatype='string' name='[Calculation_2320479709189558282]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[order_month]) + &apos; &apos; + STR(YEAR([order_month]))' />
      </column>
      <column caption='Metric by Parameter' datatype='real' name='[Calculation_2320479709191589901]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;aof&apos; THEN [AOV diff (copy)_744993958119157774]*100&#10;WHEN &apos;aov&apos; THEN [AOV (copy)_744993958089789450]*100&#10;WHEN &apos;gmv&apos; THEN [AOV diff (copy)_744993958124019730]*100&#10;WHEN &apos;churn&apos; THEN [AOV diff (copy)_744993958127349779]&#10;ELSE Null&#10;END' />
      </column>
      <column caption='Post-adoption + limit' datatype='boolean' name='[Calculation_277112181186707456]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[reference_month] &gt; 0 AND [Calculation_126523068041449474]' />
      </column>
      <column caption='Reference period' datatype='string' name='[Calculation_277112181568753665]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_277112181186707456] THEN &apos;Aggregated&apos;&#10;ELSE &apos;Not aggregated&apos;&#10;END' />
      </column>
      <column caption='Reference Periods - pre-post' datatype='string' name='[Calculation_277112181889380354]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [reference_month] &lt; 0 THEN &apos;Pre-adoption&apos;&#10;ELSEIF [reference_month] &gt; 0 AND [reference_month] &lt;= [Parameters].[Parameter 1] THEN &apos;Post-adoption&apos;&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='Period legend' datatype='string' name='[Calculation_371476664762400770]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_744993958484848668] THEN &apos;Aggregated months&apos;&#10;ELSEIF [reference_month] = 0 THEN &apos;Reference month&apos;&#10;ELSE Null&#10;END' />
      </column>
      <column caption='Reference Month Cap' datatype='boolean' name='[Calculation_371476664764669955]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[reference_month] &gt;= -3 AND [reference_month] &lt;= 6' />
      </column>
      <column caption='Incremental Orders' datatype='real' name='[Calculation_5333387859103858689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[AOF diff (copy)_5333387859102330880] * SUM([federated.0h5zhuo0eapc9e14yyv6s054on5p].[active_users])' />
      </column>
      <column caption='AOF' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_744993958085193729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([order_count]&gt;0,[order_count],Null))/SUM(IIF([order_count]&gt;0,[customer_count],Null))' />
      </column>
      <column caption='AOV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_744993958085390338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([gmv_total],NULL))/SUM(IFNULL([order_count],Null))' />
      </column>
      <column caption='Customer Churn Rate' datatype='real' default-format='p0.0%' name='[Calculation_744993958085517315]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([customer_churn_count])/SUM(IIF([order_count]&gt;0,[customer_count],Null))' />
      </column>
      <column caption='GMV per customer' datatype='real' name='[Calculation_744993958085918724]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([Gmv Total])/SUM(IIF([Order Count]&gt;0,[Customer Count],Null))&#10;SUM([gmv_total])/SUM([customer_count])' />
      </column>
      <column caption='Filter past full months' datatype='boolean' name='[Calculation_744993958405664789]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[order_month]) &lt; DATETRUNC(&apos;month&apos;, TODAY())&#10;AND&#10;DATETRUNC(&apos;month&apos;,[order_month]) &gt;= DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;year&apos;, TODAY()))' />
      </column>
      <column caption='Post-adoption - limited by parameter' datatype='boolean' name='[Calculation_744993958484848668]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[reference_month]&gt;0 AND [reference_month]&lt;=[Parameters].[Parameter 1]' />
      </column>
      <column caption='AOF arrow indicator' datatype='string' name='[Calculation_80501908275302404]' role='measure' type='nominal'>
