            <column caption='Customer Count' datatype='integer' name='[customer_count]' role='measure' type='quantitative' />
            <column caption='User group' datatype='boolean' name='[is_adopter]' role='dimension' type='nominal'>
              <aliases>
                <alias key='false' value='Control' />
                <alias key='true' value='BNPL Test' />
              </aliases>
            </column>
            <column-instance column='[order_month]' derivation='MY' name='[my:order_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_277112181186707456]' derivation='None' name='[none:Calculation_277112181186707456:nk]' pivot='key' type='nominal' />
            <column caption='Order Date' datatype='date' name='[order_month]' role='dimension' type='ordinal' />
            <column caption='Reference Month' datatype='integer' name='[reference_month]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_2320479709138853892]' derivation='User' name='[usr:Calculation_2320479709138853892:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2320479709139668997]' derivation='User' name='[usr:Calculation_2320479709139668997:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
