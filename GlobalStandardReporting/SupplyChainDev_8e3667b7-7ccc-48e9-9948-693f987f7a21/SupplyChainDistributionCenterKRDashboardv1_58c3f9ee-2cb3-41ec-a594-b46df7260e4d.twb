          <formatted-text>
            <run bold='true' fontcolor='#555555' fontsize='14'>Cost Per Item</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rdvr_dc_cpi (dev_dmart)' name='federated.13w6qdi1pignrt15mqekc15ro6q7' />
          </datasources>
          <datasource-dependencies datasource='federated.13w6qdi1pignrt15mqekc15ro6q7'>
            <column caption='Cost_pos' datatype='integer' name='[Calculation_2756836358464663553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([cost] &lt;0 ) then cost * (-1) ELSE [cost] END' />
            </column>
            <column caption='Cost Per Item' datatype='real' default-format='c#,##0.0000' name='[Calculation_6348879269170262016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_2756836358464663553])/sum([picked_qty]))' />
            </column>
            <column caption='Cost' datatype='integer' name='[cost]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[period]' derivation='None' name='[none:period:ok]' pivot='key' type='ordinal' />
