    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/SupplyChainCentralizationDashboardv1_0/Definitions?rev=' id='Definitions' path='/t/GlobalStandardReporting/workbooks/SupplyChainDistributionCenterKRDashboardv1' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='32250' id='3' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run bold='true' fontsize='20'>Defintions:</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='8'>Centralization % = Total # of Units Supplied by DCs / Total # of Units supplied to all DMarts and DCs</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='8'>DC to Dmart Fill Rate = Total # of Units Delivered by DC to Dmart/ Total # of Units  Requested by Dmart</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='8'>Cost Per Item = Total DC cost of country / Total # of Items delivered by DCs to Dmarts in the country</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='8'>CIT : Cost of Inventory Transport, calculated as ( cost of item) * (# of units transferred)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontsize='8'>Cost over CIT %:  (Total DC Cost of Country )/ (Total CIT for items in the country)</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='65750' id='5' type-v2='empty' w='98400' x='800' y='33250'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
