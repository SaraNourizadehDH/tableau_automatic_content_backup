      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/SupplyChainCentralizationDashboardv1_0/CentralizationTrends?rev=' id='CentralizationTrends' path='/t/GlobalStandardReporting/workbooks/SupplyChainCentralizationDashboardv1_0' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='2066' maxwidth='2001' minheight='1366' minwidth='1401' sizing-mode='range' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='rdvr_dc_fill_rate (dev_dmart)' name='federated.0vjoava01dvlfb1gcwm6d1eyb8vf' />
        <datasource caption='rdvr_dc_cpi (dev_dmart)' name='federated.13w6qdi1pignrt15mqekc15ro6q7' />
        <datasource caption='rdvr_scm_centralization_list (dev_dmart)' name='federated.189jzwz1wpp9o819iffnz0t3dtsn' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Integration?' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
          <calculation class='tableau' formula='&quot;All&quot;' />
          <aliases>
            <alias key='&quot;False&quot;' value='Not Integrated' />
            <alias key='&quot;True&quot;' value='Integrated' />
          </aliases>
          <members>
            <member alias='Integrated' value='&quot;True&quot;' />
            <member alias='Not Integrated' value='&quot;False&quot;' />
            <member value='&quot;All&quot;' />
          </members>
        </column>
        <column caption='Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
          <calculation class='tableau' formula='&quot;All&quot;' />
          <members>
            <member value='&quot;DC&quot;' />
            <member value='&quot;Parent Child&quot;' />
