      <aliases enabled='yes' />
      <column caption='Created and Received same month' datatype='integer' name='[Calculation_4907868069522812929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if (month([received_date]) = MONTH([created_date])) AND  (MONTH([created_date]) = MONTH([iso_date])) and ((YEAR([received_date]) = YEAR([created_date]) AND (YEAR([received_date]) = YEAR([iso_date])))) then [order_id] END)' />
      </column>
      <column caption='Received Orders' datatype='integer' name='[Calculation_4907868069523329026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if MONTH([received_date]) = MONTH([iso_date]) and YEAR([received_date]) = year([iso_date]) then [order_id] END)' />
      </column>
      <column caption='Multiple Receiving Orders (DC)' datatype='integer' name='[Calculation_4907868069523898371]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_multi_receiving] = TRUE and MONTH([received_date]) = MONTH([iso_date])  and [is_dc] = 1 then [order_id] END)' />
      </column>
      <column caption='Lead Time' datatype='integer' name='[Calculation_4907868070605656070]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[created_date],[received_date])' />
      </column>
      <column caption='LT Accuracy % ' datatype='integer' name='[Calculation_4907868070608867335]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF   [flag] = &apos;PO_DC2Dmart&apos; and date([received_date]) &lt;= date([promised_at]) then [order_id] END)' />
      </column>
      <column caption='LT Accuracy %  less than received date' datatype='integer' name='[LT Accuracy %  (copy)_4907868070609264648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF   [flag] = &apos;PO_DC2Dmart&apos; and [received_date] &lt; DATE([promised_at]) then [order_id] END)' />
      </column>
      <column caption='Created Orders' datatype='integer' name='[Received Orders (copy)_4907868069942894596]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if MONTH([created_date]) = MONTH([iso_date]) and YEAR([created_date]) = year([iso_date]) then [order_id] END)' />
      </column>
      <column caption='Received Orders (DC)' datatype='integer' name='[Received Orders (copy)_4907868070350925829]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if MONTH([received_date]) = MONTH([iso_date]) and YEAR([received_date]) = year([iso_date]) and [is_dc] = 1 then [order_id] END)' />
      </column>
