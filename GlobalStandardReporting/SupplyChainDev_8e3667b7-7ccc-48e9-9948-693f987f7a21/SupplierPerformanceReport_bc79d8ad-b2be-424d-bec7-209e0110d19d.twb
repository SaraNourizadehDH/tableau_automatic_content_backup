      <column caption='New Supplier Performance Score' datatype='real' name='[Calculation_3639471482358677507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*(0.5 * (([Calculation_3910461499494731778] / [Calculation_1780962558294376448]) * [Calculation_3910461499509145611]) + (0.25* [Calculation_3910461499495452676]) + (0.25 * [Calculation_3910461499490897920]) + 0.25 * (RANK_PERCENTILE(([Calculation_1780962558294376448]),&apos;asc&apos;)))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='rank_new_supplier_performance_score' datatype='integer' name='[Calculation_3639471482359771140]' role='measure' type='quantitative'>
