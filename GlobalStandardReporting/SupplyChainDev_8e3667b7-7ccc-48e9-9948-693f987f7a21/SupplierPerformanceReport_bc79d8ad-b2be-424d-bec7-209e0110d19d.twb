      <column caption='Availability' datatype='real' default-format='p0%' name='[Availability (copy)_4596556772634021892]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [order_status] = &apos;done&apos; then [available_hours] end)/sum(if [order_status] = &apos;done&apos; then [potential_hours] end)' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3910461499537334284] / TOTAL([Calculation_3910461499537334284])'>
