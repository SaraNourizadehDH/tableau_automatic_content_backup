            </column>
            <column caption='Segment' datatype='string' name='[Calculation_517280663029956608]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if RANK_PERCENTILE(SUM([total_received_qty_per_order])) &gt;= 0.7 then &apos;A&apos; ELSEIF RANK_PERCENTILE(SUM([total_received_qty_per_order])) &lt; 0.7 and RANK_PERCENTILE(SUM([total_received_qty_per_order])) &gt;= 0.4 then &apos;B&apos; else &apos;C&apos; END'>
