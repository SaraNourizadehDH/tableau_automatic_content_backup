    <worksheet name='Country Trends'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rdvr_tableau_supplier_operational_performance (rl_dmart)' name='federated.1iyom6o0hhrpc51e91bt9066ongh' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Yes' caption='On Time Delivery' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Including Supplier Cancellation&quot;'>
              <calculation class='tableau' formula='&quot;Including Supplier Cancellation&quot;' />
              <aliases>
                <alias key='&quot;Excluding Supplier Cancellation&quot;' value='No' />
                <alias key='&quot;Including Supplier Cancellation&quot;' value='Yes' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1iyom6o0hhrpc51e91bt9066ongh'>
            <column caption='Total Orders' datatype='integer' name='[Calculation_1780962558294376448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([po_order_id])' />
            </column>
            <column caption='Supplier Cancelled Orders' datatype='integer' name='[Calculation_1780962558296092673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(IF  [cancel_reason] = &apos;REJECTED BY SM&apos; OR [cancel_reason] = &apos;Supplier non fulfillment&apos; OR [cancel_reason] = &apos;PO rejected on site (Quality issue)&apos; OR [cancel_reason] = &apos;AUTO CANCELLED&apos;&#10;then [po_order_id] END)' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_2825516219450949632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [country_code] = &apos;tr&apos; then &apos;Turkey&apos;&#10;ELSEIF [country_code] = &apos;sa&apos; then &apos;KSA&apos;&#10;else [country_region] END' />
            </column>
            <column caption='Completed Orders' datatype='integer' name='[Calculation_3910461499493888001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [order_status] = &quot;done&quot; then [po_order_id] end)' />
            </column>
            <column caption='On Time Orders' datatype='integer' name='[Calculation_3910461499494731778]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [order_received_on_time]= 1 then [po_order_id] end)' />
            </column>
            <column caption='Supplier Non Fulfilled order qty' datatype='integer' name='[Calculation_4596556772656324614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM(if [country_region] = &quot;America&quot; and [cancel_reason] in  (&apos;Supplier non fulfillment&apos;, &apos;Stock not available&apos;)  then [total_demanded_qty_per_order]&#10;elseif  [country_region] &lt;&gt; &quot;America&quot; and [cancel_reason] in  (&apos;Supplier non fulfillment&apos;, &apos;AUTO CANCELLED&apos;) then [total_demanded_qty_per_order] end),0)' />
            </column>
            <column caption='On Time Delivery' datatype='real' default-format='p0%' name='[Calculation_4968033392588619781]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;when &quot;Including Supplier Cancellation&quot; then [Calculation_3910461499494731778]/([Calculation_3910461499493888001] + [Calculation_1780962558296092673])&#10;when &quot;Excluding Supplier Cancellation&quot; then [Calculation_3910461499494731778]/([Calculation_3910461499493888001])&#10;when &quot;Only Supplier Cancellation&quot; then [Calculation_3910461499494731778]/([Calculation_1780962558296092673]) &#10;END' />
            </column>
            <column caption='Date' datatype='date' name='[Calculation_5246834331093684224]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF [country_code] = &apos;tr&apos; then [promised_date] &#10;elseif  [country_region] = &apos;America&apos; then [create_date]&#10;&#10;ELSEIF [country_region] = &apos;America&apos; and ( [order_status] = &apos;canceled&apos; or [order_status] = &apos;cancellation_requested&apos; ) then [create_date]&#10;ELSEIF [country_region] = &apos;Asia&apos; and ( [order_status] = &apos;canceled&apos; or [order_status] = &apos;cancellation_requested&apos; ) then [create_date]&#10;ELSEIF [country_region] = &apos;Turkey&apos; and ( [order_status] = &apos;canceled&apos; or [order_status] = &apos;cancellation_requested&apos; ) then [promised_date]&#10;ELSEIF  [order_status] = &apos;canceled&apos; or [order_status] = &apos;cancellation_requested&apos; and isnull([promised_date])  then [create_date]&#10;ELSEIF ( [order_status] = &apos;canceled&apos; or [order_status] = &apos;cancellation_requested&apos; ) then [create_date]&#10;ELSEIF [order_delayed_outstanding] = 1 then [create_date]&#10;&#10;&#10;ELSE [received_date] END' />
            </column>
            <column caption='Total Quanitity Delivered' datatype='integer' name='[Calculation_5246834331133001731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([total_received_qty_per_order])' />
            </column>
            <column caption='Total Demanded' datatype='integer' name='[Calculation_5377227615560704000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([total_demanded_qty_per_order])' />
            </column>
            <column caption='Cancelled POs Supplier' datatype='integer' name='[Calculation_560768559685672960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [cancel_reason] in (&apos;AUTO CANCELLED&apos;,&apos;Supplier non fulfillment&apos;,&apos;PO rejected on site (Quality issue)&apos;) then [po_order_id] END)' />
            </column>
            <column caption='Cancelled POs DH' datatype='integer' default-format='N' name='[Calculation_560768559689224193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [cancel_reason] in (&apos;Picker opened PO by mistake&apos;,&apos;REJECTED BY SM&apos;,&apos;PO rejected on site (Capacity issue)&apos;,&apos;PO rejected on site (Barcodes issue)&apos;,&apos;Incorrect link to supplier&apos;,&apos;Supplier payments issue&apos;,&apos;User error / Test PO&apos;,&apos;Incorrect trade costs in PO&apos;,&apos;Rejected by DC&apos;,&apos;MOQ is not met&apos;) then [po_order_id] END)' />
            </column>
            <column caption='% Cancelled POs Supplier' datatype='real' default-format='p0%' name='[Calculation_560768559690379266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_560768559685672960]/[Calculation_1780962558294376448]' />
            </column>
            <column caption='% Cancelled POs DH' datatype='real' default-format='p0%' name='[Calculation_560768559690694659]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_560768559689224193]/[Calculation_1780962558294376448]' />
            </column>
            <column caption='Country Filtered Delivery' datatype='integer' name='[Calculation_762726858250027010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [country_code] = &apos;tr&apos; THEN [Calculation_5246834331133001731] &#10;ELSEIF [order_status] = &apos;done&apos; THEN [Calculation_5246834331133001731] &#10;END' />
            </column>
            <column caption='Country Filtered Demand' datatype='integer' name='[Calculation_762726858250149891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [country_code] = &apos;tr&apos; THEN [Calculation_5377227615560704000] &#10;ELSEIF [order_status] = &apos;done&apos; THEN [Calculation_5377227615560704000] &#10;END' />
            </column>
            <column caption='Fill Rate (Units) (old)' datatype='real' default-format='p0%' name='[Fill Rate (Units) (copy)_6356690193024028672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;when &quot;Including Supplier Cancellation&quot; then IFNULL(sum(if [order_status] = &apos;done&apos; then [Calculation_5246834331133001731] end)/(sum(if [order_status] = &apos;done&apos; then [Calculation_5377227615560704000] end) + ([Calculation_4596556772656324614])),0)&#10;when &quot;Excluding Supplier Cancellation&quot; then IFNULL(sum(if [order_status] = &apos;done&apos; then [Calculation_5246834331133001731] end)/(sum(if [order_status] = &apos;done&apos; then [Calculation_5377227615560704000] end)),0)&#10;when &quot;Only Supplier Cancellation&quot; then IFNULL(sum(if [order_status] = &apos;done&apos; then [Calculation_5246834331133001731] end)/([Calculation_4596556772656324614]),0)&#10;END' />
            </column>
            <column caption='Fill Rate (Units)' datatype='real' default-format='p0%' name='[Fill Rate (Units) (copy)_762726858248347649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Including Supplier Cancellation&quot; THEN &#10;    IFNULL(SUM([Calculation_762726858250027010]) / (SUM([Calculation_762726858250149891]) + [Calculation_4596556772656324614]),0)&#10;WHEN &quot;Excluding Supplier Cancellation&quot; THEN &#10;    IFNULL(SUM([Calculation_762726858250027010]) / SUM([Calculation_762726858250149891]),0)&#10;WHEN &quot;Only Supplier Cancellation&quot; THEN &#10;    IFNULL(SUM([Calculation_762726858250027010]) / [Calculation_4596556772656324614],0)&#10;END' />
            </column>
            <column caption='Cancel Reason' datatype='string' name='[cancel_reason]' role='dimension' type='nominal' />
