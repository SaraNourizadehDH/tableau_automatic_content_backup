        </calculation>
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_1515883526640414721]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='if [Calculation_517280663029956608] = &apos;A&apos; then index() end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Fill Rate with Supplier Cancellation' datatype='real' name='[Calculation_1588081843503415296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(sum(if [order_status] = &apos;done&apos; then [total_received_qty_per_order] end)/(sum(if [order_status] = &apos;done&apos; then [total_demanded_qty_per_order] end) + ([Calculation_4596556772656324614])),0)' />
      </column>
      <column caption='Fill Rate without Supplier Cancellation' datatype='real' name='[Calculation_1588081843503529985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(sum(if [order_status] = &apos;done&apos; then [total_received_qty_per_order] end)/(sum(if [order_status] = &apos;done&apos; then [total_demanded_qty_per_order] end)),0)' />
      </column>
      <column caption='Supplier Rank' datatype='integer' default-format='N' name='[Calculation_1717771450130161664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK([Calculation_2863022756930822150], &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Region_' datatype='string' name='[Calculation_1717771450482012161]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [country_code]&#10;  WHEN &apos;sg&apos; THEN &apos;APAC&apos;&#10;  WHEN &apos;my&apos; THEN &apos;APAC&apos;&#10;  WHEN &apos;hk&apos; THEN &apos;APAC&apos;&#10;  WHEN &apos;tw&apos; THEN &apos;APAC&apos;&#10;  WHEN &apos;ph&apos; THEN &apos;APAC&apos;&#10;  WHEN &apos;pk&apos; THEN &apos;APAC&apos;&#10;  WHEN &apos;bd&apos; THEN &apos;APAC&apos;&#10;  WHEN &apos;tr&apos; THEN &apos;MENA&apos;&#10;  WHEN &apos;kw&apos; THEN &apos;MENA&apos;&#10;  WHEN &apos;ar&apos; THEN &apos;LATAM&apos;&#10;  WHEN &apos;cl&apos; THEN &apos;LATAM&apos;&#10;  WHEN &apos;ec&apos; THEN &apos;LATAM&apos;&#10;  WHEN &apos;pe&apos; THEN &apos;LATAM&apos;   &#10;&#10;  ELSE &apos;No Mapped Region&apos;&#10;&#10;END' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_1780962558294376448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([po_order_id])' />
      </column>
      <column caption='Supplier Cancelled Orders' datatype='integer' name='[Calculation_1780962558296092673]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(IF  [cancel_reason] = &apos;REJECTED BY SM&apos; OR [cancel_reason] = &apos;Supplier non fulfillment&apos; OR [cancel_reason] = &apos;PO rejected on site (Quality issue)&apos; OR [cancel_reason] = &apos;AUTO CANCELLED&apos;&#10;then [po_order_id] END)' />
      </column>
      <column caption='Done_orders_qty_delivered' datatype='integer' name='[Calculation_2035345579390693376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [order_status] = &apos;done&apos; then [total_received_qty_per_order] end)' />
      </column>
      <column caption='done_orders_qty_demanded' datatype='integer' name='[Calculation_2035345579390894081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [order_status] = &apos;done&apos; then [total_demanded_qty_per_order] end)' />
      </column>
      <column caption='Segmentation Denominator' datatype='integer' name='[Calculation_2035345579421794306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [common_name] : sum([Calculation_2863022754822524928])}' />
      </column>
      <column caption='Segmentation Numerator ' datatype='real' name='[Calculation_2035345579421966339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='Today_Creator' datatype='date' name='[Calculation_2134495143830794242]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date(TODAY()-1)' />
      </column>
      <column caption='OTD Delay Days' datatype='real' name='[Calculation_2172212781908512771]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, DATE([received_date]), DATE([promised_date])) &lt; 0 THEN 1&#10;ELSEIF DATEDIFF(&apos;day&apos;, DATE([received_date]), DATE([promised_date])) = 0 THEN 1&#10;ELSEIF DATEDIFF(&apos;day&apos;, DATE([received_date]), DATE([promised_date])) = 1 THEN 0.75&#10;ELSEIF DATEDIFF(&apos;day&apos;, DATE([received_date]), DATE([promised_date])) = 2 THEN 0.5&#10;ELSEIF DATEDIFF(&apos;day&apos;, DATE([received_date]), DATE([promised_date])) = 3 THEN 0.25&#10;ELSE 0 END' />
      </column>
      <column caption='Region' datatype='string' name='[Calculation_2825516219450949632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [country_code] = &apos;tr&apos; then &apos;Turkey&apos;&#10;ELSEIF [country_code] = &apos;sa&apos; then &apos;KSA&apos;&#10;else [country_region] END' />
      </column>
      <column caption='Supplier Quantity' datatype='integer' name='[Calculation_2863022754822524928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [supplier_name]: sum([total_received_qty_per_order])}' />
      </column>
      <column caption='quantity_percentile' datatype='real' default-format='p0.0%' name='[Calculation_2863022754824720385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_PERCENTILE(sum([Calculation_2863022754822524928]),&apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Row Number' datatype='integer' name='[Calculation_2863022754830848002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Segmentation' datatype='boolean' name='[Calculation_2863022754834788355]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LOOKUP([Calculation_517280663029956608] = &apos;A&apos;,0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Supplier Score ' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_2863022756930822150]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='100*(0.5 * ([Calculation_4968033392588619781] * [Fill Rate (Units) (copy)_6356690193024028672]) + (0.25* [Fill Rate (Units) (copy)_6356690193024028672]) + (0.25 * avg([Calculation_2172212781908512771])))' />
      </column>
      <column caption='Supplier Count' datatype='integer' name='[Calculation_2863022756946051079]' role='measure' type='quantitative'>
