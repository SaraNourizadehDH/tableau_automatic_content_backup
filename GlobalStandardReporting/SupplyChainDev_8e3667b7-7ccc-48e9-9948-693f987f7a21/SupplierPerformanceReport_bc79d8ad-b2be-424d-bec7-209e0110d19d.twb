            <column-instance column='[Calculation_5246834331133001731]' derivation='Sum' name='[sum:Calculation_5246834331133001731:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_5377227615561183233]' derivation='Sum' name='[sum:Calculation_5377227615561183233:qk]' pivot='key' type='quantitative' />
