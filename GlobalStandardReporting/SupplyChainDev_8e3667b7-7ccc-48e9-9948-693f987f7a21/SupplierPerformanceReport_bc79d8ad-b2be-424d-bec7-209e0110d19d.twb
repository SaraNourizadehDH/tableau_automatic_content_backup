    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Definitions'>
      <repository-location derived-from='http://ip-172-31-0-74:8216/t/GlobalStandardReporting/workbooks/SupplierPerformanceReportV2WIP/Definitions?rev=' id='Definitions' path='/t/GlobalStandardReporting/workbooks/SupplierPerformanceReportV2WIP' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1200' maxwidth='1000' minheight='1200' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98666' id='3' type-v2='text' w='98400' x='800' y='667'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='14'>Definitions: </run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b'>FIll Rate: </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>Fill Rate (Units) = # of units delivered per order / # of units ordered per order</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b'>On Time Delivery:  </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>Number of lines that arrived on time (considering expected delivery date  input by planner) </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>/Total number of lines (delivered + cancelled because of supplier at fault)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b'>Availability: </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>Available Hours / Total Hours</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b'>Cancelled POs DH:</run>
              <run fontcolor='#1b1b1b'>Æ </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>Count of total cancelled POs Cancelled by DH</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#1b1b1b'>i.e POs cancelled with the following reasons: </run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#e15759'>Picker Opened PO by Mistake, </run>
              <run>Æ&#10;</run>
              <run fontcolor='#e15759'>REJECTED BY SM, </run>
              <run>Æ&#10;</run>
              <run fontcolor='#e15759'>PO Rejected on Site (Capacity Issue), </run>
              <run>Æ&#10;</run>
              <run fontcolor='#e15759'>PO Rejected on Site (Barcodes Issue), </run>
              <run>Æ&#10;</run>
              <run fontcolor='#e15759'>Incorrect Link to Supplier, </run>
              <run>Æ&#10;</run>
              <run fontcolor='#e15759'>Supplier Payments Issue,</run>
              <run>Æ&#10;</run>
              <run fontcolor='#e15759'> User Error/ Test PO, Rejected by DC, </run>
              <run>Æ&#10;</run>
              <run fontcolor='#e15759'>MOQ is not met</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b'>Cancelled POs Supplier:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>Count of total cancelled POs cancelled by Supplier </run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#1b1b1b'>i.e POs cancelled with the following reasons: </run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#e15759'>AUTO CANCELLED, </run>
              <run>Æ&#10;</run>
              <run fontcolor='#e15759'>Supplier non fulfillment, </run>
              <run>Æ&#10;</run>
              <run fontcolor='#e15759'>PO rejected on site (Quality Issue) </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b'>%Supplier Cancelled POs:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>Cancelled POs Supplier/ Total POs</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b'>%DH Cancelled POs</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>Cancelled POs DH/Total POs</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b'>Segmentation: </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'> If A, supplier is in top 30% suppliers by unit volume in the country </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>If B, supplier is in 30-70% of of suppliers by unit volume in the country</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'> If C, supplier is in bottom 30% of suppliers by unit volume in the country</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b'>Supplier Score:  </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>Weighted Score for measuring the supply performance of suppliers. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>Calculated for Segment A</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1b1b1b'>Formula:  50%*( [On Time Delivery] * [Fill Rate (Units)]) + 25%*([Fill Rate (Units)]) + 25%* ( [On Time Delivery Delay Days])</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b'>On Time Delivery Delay Days:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Measure of degree of delay from expected delivery date</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1f1f1f'> If order is within or on expected delivery date then 100%</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1f1f1f'>                                        If order is one day late then 75%        </run>
              <run>Æ&#10;</run>
              <run fontcolor='#1f1f1f'>                                        If order is two days late then 50%</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1f1f1f'>                                        If order is three days late then 25%</run>
              <run>Æ&#10;</run>
              <run fontcolor='#1f1f1f'>                                        If order is four days late or greater than 0%</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>Quantity Percentile:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Between 0 and 100.  Higher number means the supplier is a high volume supplier for that country</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>Retail Revenue:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Revenue made by the SKUs in a DMart which were supplied by a supplier.  This is not a measure of the supplier&apos;s retail revenue, but of the SKUs themselves in a DMart in a given time period</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>Supplier Sales Contribution:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>% of Supplier Sales Relative to the overall sales of that country</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Total Supplier Sales / Total Country Sales</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#e6e6e6' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='282' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='281' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone forceUpdate='true' h='98666' id='3' type-v2='text' w='98400' x='800' y='667'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='14'>Definitions: </run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>FIll Rate: </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>Fill Rate (Units) = # of units delivered per order / # of units ordered per order</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>On Time Delivery:  </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>Number of lines that arrived on time (considering expected delivery date  input by planner) </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>/Total number of lines (delivered + cancelled because of supplier at fault)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>Availability: </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>Available Hours / Total Hours</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>Cancelled POs DH:</run>
                    <run fontcolor='#1b1b1b'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>Count of total cancelled POs Cancelled by DH</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1b1b'>i.e POs cancelled with the following reasons: </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#e15759'>Picker Opened PO by Mistake, </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e15759'>REJECTED BY SM, </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e15759'>PO Rejected on Site (Capacity Issue), </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e15759'>PO Rejected on Site (Barcodes Issue), </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e15759'>Incorrect Link to Supplier, </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e15759'>Supplier Payments Issue,</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e15759'> User Error/ Test PO, Rejected by DC, </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e15759'>MOQ is not met</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>Cancelled POs Supplier:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>Count of total cancelled POs cancelled by Supplier </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1b1b'>i.e POs cancelled with the following reasons: </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#e15759'>AUTO CANCELLED, </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e15759'>Supplier non fulfillment, </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e15759'>PO rejected on site (Quality Issue) </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>%Supplier Cancelled POs:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>Cancelled POs Supplier/ Total POs</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>%DH Cancelled POs</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>Cancelled POs DH/Total POs</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>Segmentation: </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'> If A, supplier is in top 30% suppliers by unit volume in the country </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>If B, supplier is in 30-70% of of suppliers by unit volume in the country</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'> If C, supplier is in bottom 30% of suppliers by unit volume in the country</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>Supplier Score:  </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>Weighted Score for measuring the supply performance of suppliers. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>Calculated for Segment A</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1b1b1b'>Formula:  50%*( [On Time Delivery] * [Fill Rate (Units)]) + 25%*([Fill Rate (Units)]) + 25%* ( [On Time Delivery Delay Days])</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b'>On Time Delivery Delay Days:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>Measure of degree of delay from expected delivery date</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1f1f1f'> If order is within or on expected delivery date then 100%</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1f1f1f'>                                        If order is one day late then 75%        </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1f1f1f'>                                        If order is two days late then 50%</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1f1f1f'>                                        If order is three days late then 25%</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#1f1f1f'>                                        If order is four days late or greater than 0%</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000'>Quantity Percentile:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>Between 0 and 100.  Higher number means the supplier is a high volume supplier for that country</run>
                    <run>Æ&#10;&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000'>Retail Revenue:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>Revenue made by the SKUs in a DMart which were supplied by a supplier.  This is not a measure of the supplier&apos;s retail revenue, but of the SKUs themselves in a DMart in a given time period</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000'>Supplier Sales Contribution:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>% of Supplier Sales Relative to the overall sales of that country</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>Total Supplier Sales / Total Country Sales</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#e6e6e6' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{B75FED97-7814-460F-A372-B41FADAF3250}' />
    </dashboard>
