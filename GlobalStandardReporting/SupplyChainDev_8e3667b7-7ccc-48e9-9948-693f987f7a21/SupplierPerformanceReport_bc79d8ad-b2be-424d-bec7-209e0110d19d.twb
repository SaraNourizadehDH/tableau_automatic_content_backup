      </column>
      <column caption='On Time Delivery (Fixed Formula)' datatype='real' default-format='p0%' name='[Calculation_3910461499490897920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3910461499494731778]/([Calculation_3910461499493888001] + [Calculation_1780962558296092673])' />
      </column>
      <column caption='Completed Orders' datatype='integer' name='[Calculation_3910461499493888001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [order_status] = &quot;done&quot; then [po_order_id] end)' />
      </column>
      <column caption='On Time Orders' datatype='integer' name='[Calculation_3910461499494731778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [order_received_on_time]= 1 then [po_order_id] end)' />
      </column>
      <column caption='Fill Rate (Old)' datatype='real' default-format='p0%' name='[Calculation_3910461499495452676]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if country_code &lt;&gt; &apos;tr&apos; then IFNULL(sum(if [order_status] = &apos;done&apos; then [Calculation_5246834331133001731] end)/(sum(if [order_status] = &apos;done&apos; then [Calculation_5377227615560704000] end) + ([Calculation_4596556772656324614])),0)&#10;ELSEIF  country_code = &apos;tr&apos; then sum([Calculation_5246834331133001731])/ sum([Calculation_5377227615560704000]) end' />
      </column>
      <column caption='Outstanding POs' datatype='integer' name='[Calculation_3910461499497660422]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if ([order_status] = &apos;in_progess&apos;  or [order_status] = &apos;partially_inbounded&apos; or [order_status] = &apos;confirmed&apos; or [order_status] = &apos;pending&apos;) and [order_delayed] = 1 then [po_order_id] end)' />
      </column>
      <column caption='Cancelled POs' datatype='integer' name='[Calculation_3910461499497906183]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [order_status] = &apos;canceled&apos; OR [order_status] = &apos;cancellation_requested&apos; then [po_order_id] end)' />
      </column>
      <column caption='Shrinkage (%)' datatype='real' default-format='p0%' name='[Calculation_3910461499504508938]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum(if [order_status] = &apos;done&apos; then ([shrinkage_q_expired]) end)/sum(if [order_status] = &apos;done&apos; then [total_received_qty_per_order] end))' />
      </column>
      <column caption='Fill Rate (PO Line)' datatype='real' default-format='p0%' name='[Calculation_3910461499509145611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum( if [order_status] = &apos;done&apos; then [fully_delivered_lines] end)/sum(if [order_status] = &apos;done&apos; then [total_items_per_order] end)' />
      </column>
      <column caption='% Cancelled POs' datatype='real' default-format='p0%' name='[Calculation_3910461499537334284]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_3910461499497906183])/([Calculation_1780962558294376448])' />
      </column>
      <column caption='Region_old_values' datatype='string' name='[Calculation_3910461499540783117]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [country_code]&#10;  WHEN &apos;sg&apos; THEN &apos;APAC&apos;&#10;  WHEN &apos;my&apos; THEN &apos;APAC&apos;&#10;  WHEN &apos;hk&apos; THEN &apos;APAC&apos;&#10;  WHEN &apos;tw&apos; THEN &apos;APAC&apos;&#10;  WHEN &apos;ph&apos; THEN &apos;APAC&apos;&#10;  WHEN &apos;pk&apos; THEN &apos;APAC&apos;&#10;  WHEN &apos;bd&apos; THEN &apos;APAC&apos;&#10;  WHEN &apos;tr&apos; THEN &apos;MENA&apos;&#10;  WHEN &apos;kw&apos; THEN &apos;MENA&apos;&#10;  WHEN &apos;ar&apos; THEN &apos;LATAM&apos;&#10;  WHEN &apos;cl&apos; THEN &apos;LATAM&apos;&#10;  WHEN &apos;ec&apos; THEN &apos;LATAM&apos;&#10;  WHEN &apos;pe&apos; THEN &apos;LATAM&apos; &#10;  WHEN &apos;bo&apos; THEN &apos;LATAM&apos;&#10;  WHEN &apos;do&apos; THEN &apos;LATAM&apos;&#10;  WHEN &apos;hn&apos; THEN &apos;LATAM&apos;&#10;  WHEN &apos;ni&apos; THEN &apos;LATAM&apos;&#10;  WHEN &apos;pa&apos; THEN &apos;LATAM&apos;&#10;  WHEN &apos;sa&apos; THEN &apos;MENA&apos;&#10;  WHEN &apos;bh&apos; THEN &apos;MENA&apos;&#10;  WHEN &apos;eg&apos; THEN &apos;MENA&apos;&#10;  WHEN &apos;iq&apos; THEN &apos;MENA&apos;&#10;  WHEN &apos;jo&apos; THEN &apos;MENA&apos;&#10;  WHEN &apos;om&apos; THEN &apos;MENA&apos;&#10;  WHEN &apos;qa&apos; THEN &apos;MENA&apos;&#10;  WHEN &apos;ae&apos; THEN &apos;MENA&apos;&#10;  when &apos;uy&apos; then &apos;LATAM&apos;&#10;  when &apos;th&apos; then &apos;APAC&apos;&#10;  when &apos;py&apos; then &apos;LATAM&apos;&#10;  when &apos;no&apos; then &apos;EUROPE&apos;&#10;  when &apos;cr&apos; then &apos;LATAM&apos;&#10;  when &apos;gt&apos; then &apos;LATAM&apos;&#10;  when &apos;sv&apos; then &apos;LATAM&apos;  &#10;  ELSE &apos;No Mapped Region&apos;&#10;&#10;END' />
      </column>
      <column caption='Nfilter' datatype='boolean' name='[Calculation_4416764643630424064]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX() &lt;= [Parameters].[Parameter 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Supplier Score A' datatype='real' name='[Calculation_4596556772579905536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  ([Calculation_2863022754824720385]) &gt; 0.7 then 100*(0.5 * ([Calculation_4968033392588619781] * [Fill Rate (Units) (copy)_6356690193024028672]) + (0.25* [Fill Rate (Units) (copy)_6356690193024028672]) + (0.25 * avg([Calculation_2172212781908512771]))) ELSE 0 END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Shrinkage ' datatype='real' name='[Calculation_4596556772632719362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Total_Shr_Eur])/sum([unit_cost_eur])' />
      </column>
      <column caption='Supplier Non Fulfilled order qty' datatype='integer' name='[Calculation_4596556772656324614]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM(if [country_region] = &quot;America&quot; and [cancel_reason] in  (&apos;Supplier non fulfillment&apos;, &apos;Stock not available&apos;)  then [total_demanded_qty_per_order]&#10;elseif  [country_region] &lt;&gt; &quot;America&quot; and [cancel_reason] in  (&apos;Supplier non fulfillment&apos;, &apos;AUTO CANCELLED&apos;) then [total_demanded_qty_per_order] end),0)' />
      </column>
      <column caption='Sales Volume Percentile' datatype='real' default-format='p0%' name='[Calculation_4596556772658434055]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :RANK_PERCENTILE({ FIXED [country_code]: (sum([sales]),&apos;desc&apos;})}'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='RANK_DELIVERED_QTY' datatype='string' name='[Calculation_4596556772660232200]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if[Calculation_2863022754824720385] &gt; 0.7 then &apos;A&apos; end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Country Sales' datatype='real' name='[Calculation_4708302354660073472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [common_name] : SUM([sales]) }' />
      </column>
      <column caption='Supplier Sales (Euro)' datatype='real' name='[Calculation_4708302354660315137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL({ FIXED [supplier_name] : sum([sales])},0)' />
      </column>
      <column caption='Supplier Sales Contribution' datatype='real' default-format='p0.00%' name='[Calculation_4708302354660556802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4708302354660315137] / [Calculation_4708302354660073472]' />
      </column>
      <column caption='Units Delivered' datatype='integer' name='[Calculation_4708302354666491907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([total_received_qty_per_order],0)' />
      </column>
      <column caption='country_supplier' datatype='string' name='[Calculation_4952200406621057025]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[common_name]+[supplier_name]' />
      </column>
      <column caption='row_number' datatype='integer' name='[Calculation_4952200406622015491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2863022754830848002]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='countrymax' datatype='string' name='[Calculation_4952200406629810181]' role='measure' type='nominal'>
        <calculation class='tableau' formula='Lookup(max([supplier_name]),0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Quantity Rank' datatype='integer' name='[Calculation_4968033392574017538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE(max([qty_percentile]),&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='On Time Delivery' datatype='real' default-format='p0%' name='[Calculation_4968033392588619781]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;when &quot;Including Supplier Cancellation&quot; then [Calculation_3910461499494731778]/([Calculation_3910461499493888001] + [Calculation_1780962558296092673])&#10;when &quot;Excluding Supplier Cancellation&quot; then [Calculation_3910461499494731778]/([Calculation_3910461499493888001])&#10;when &quot;Only Supplier Cancellation&quot; then [Calculation_3910461499494731778]/([Calculation_1780962558296092673]) &#10;END' />
      </column>
      <column caption='COGS %' datatype='real' name='[Calculation_5139381231184871424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [supplier_name]: SUM([cogs_eur])}/{FIXED [common_name]: SUM([cogs_eur])}' />
      </column>
      <column caption='Returned Qty %' datatype='real' name='[Calculation_5139381231187697665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [supplier_name]: SUM([total_returned_qty_per_order])}/{FIXED [common_name]: SUM([total_returned_qty_per_order])}' />
      </column>
      <column caption='Total Orders %' datatype='real' name='[Calculation_5139381231188037634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [supplier_name]: ([Calculation_1780962558294376448])}/{FIXED [common_name]: ([Calculation_1780962558294376448])}' />
      </column>
      <column caption='Units Delivered %' datatype='real' default-format='p0%' name='[Calculation_5139381231188369411]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [supplier_name]: SUM([Calculation_4708302354666491907])}/{FIXED [common_name]: SUM([Calculation_4708302354666491907])}' />
      </column>
      <column caption='Segment' datatype='string' name='[Calculation_517280663029956608]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if RANK_PERCENTILE(SUM([total_received_qty_per_order])) &gt;= 0.7 then &apos;A&apos; ELSEIF RANK_PERCENTILE(SUM([total_received_qty_per_order])) &lt; 0.7 and RANK_PERCENTILE(SUM([total_received_qty_per_order])) &gt;= 0.4 then &apos;B&apos; else &apos;C&apos; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Segment Filter' datatype='boolean' name='[Calculation_517280663043379204]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CONTAINS([Calculation_517280663029956608],&apos;A&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Date' datatype='date' name='[Calculation_5246834331093684224]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='IF [country_code] = &apos;tr&apos; then [promised_date] &#10;elseif  [country_region] = &apos;America&apos; then [create_date]&#10;&#10;ELSEIF [country_region] = &apos;America&apos; and ( [order_status] = &apos;canceled&apos; or [order_status] = &apos;cancellation_requested&apos; ) then [create_date]&#10;ELSEIF [country_region] = &apos;Asia&apos; and ( [order_status] = &apos;canceled&apos; or [order_status] = &apos;cancellation_requested&apos; ) then [create_date]&#10;ELSEIF [country_region] = &apos;Turkey&apos; and ( [order_status] = &apos;canceled&apos; or [order_status] = &apos;cancellation_requested&apos; ) then [promised_date]&#10;ELSEIF  [order_status] = &apos;canceled&apos; or [order_status] = &apos;cancellation_requested&apos; and isnull([promised_date])  then [create_date]&#10;ELSEIF ( [order_status] = &apos;canceled&apos; or [order_status] = &apos;cancellation_requested&apos; ) then [create_date]&#10;ELSEIF [order_delayed_outstanding] = 1 then [create_date]&#10;&#10;&#10;ELSE [received_date] END' />
      </column>
      <column caption='Tukey Non DC' datatype='string' name='[Calculation_5246834331102588930]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [country_code] = &apos;tr&apos; and not [warehouse_name]  in (&apos;Yemeksepeti Market, İst. Avrupa DC&apos;, &apos;Yemeksepeti Market, İst. Anadolu DC&apos;, &apos;Yemeksepeti Market, Ankara DC&apos;, &apos;Yemeksepeti Market, İzmir DC&apos;) then &apos;Turkish Non DC&apos; else [warehouse_name] end' />
      </column>
      <column caption='Total Quanitity Delivered' datatype='integer' name='[Calculation_5246834331133001731]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([total_received_qty_per_order])' />
      </column>
      <column caption='Total Demanded' datatype='integer' name='[Calculation_5377227615560704000]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([total_demanded_qty_per_order])' />
      </column>
      <column caption='Fill Rate numerator' datatype='integer' name='[Calculation_5377227615561183233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [order_status] = &apos;done&apos; then [Calculation_5246834331133001731] END' />
      </column>
      <column caption='FIll Rate Denominator' datatype='integer' name='[Calculation_5377227615561465858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [country_code] = &apos;tr&apos; then [Calculation_5377227615560704000] &#10;ELSEIF  [country_code] &lt;&gt; &apos;tr&apos; and [order_status] = &apos;done&apos; then [Calculation_5377227615560704000] &#10;end)' />
      </column>
      <column caption='Rows' datatype='integer' name='[Calculation_5377227616257187845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Index()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Supplier Score Impact' datatype='real' name='[Calculation_5377227616265179143]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_5246834331133001731]) * (100 - [Calculation_2863022756930822150])' />
      </column>
      <column caption='orders' datatype='integer' name='[Calculation_5422615474743300096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([po_order_id])' />
      </column>
      <column caption='Cancelled POs Supplier' datatype='integer' name='[Calculation_560768559685672960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [cancel_reason] in (&apos;AUTO CANCELLED&apos;,&apos;Supplier non fulfillment&apos;,&apos;PO rejected on site (Quality issue)&apos;) then [po_order_id] END)' />
      </column>
      <column caption='Cancelled POs DH' datatype='integer' default-format='N' name='[Calculation_560768559689224193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [cancel_reason] in (&apos;Picker opened PO by mistake&apos;,&apos;REJECTED BY SM&apos;,&apos;PO rejected on site (Capacity issue)&apos;,&apos;PO rejected on site (Barcodes issue)&apos;,&apos;Incorrect link to supplier&apos;,&apos;Supplier payments issue&apos;,&apos;User error / Test PO&apos;,&apos;Incorrect trade costs in PO&apos;,&apos;Rejected by DC&apos;,&apos;MOQ is not met&apos;) then [po_order_id] END)' />
      </column>
      <column caption='% Cancelled POs Supplier' datatype='real' default-format='p0%' name='[Calculation_560768559690379266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_560768559685672960]/[Calculation_1780962558294376448]' />
      </column>
      <column caption='% Cancelled POs DH' datatype='real' default-format='p0%' name='[Calculation_560768559690694659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_560768559689224193]/[Calculation_1780962558294376448]' />
      </column>
      <column caption='Cancelled Order DH' datatype='string' name='[Calculation_560768559702220804]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [cancel_reason] in (&apos;Picker opened PO by mistake&apos;,&apos;REJECTED BY SM&apos;,&apos;PO rejected on site (Capacity issue)&apos;,&apos;PO rejected on site (Barcodes issue)&apos;,&apos;Incorrect link to supplier&apos;,&apos;Supplier payments issue&apos;,&apos;User error / Test PO&apos;,&apos;Incorrect trade costs in PO&apos;,&apos;Rejected by DC&apos;,&apos;MOQ is not met&apos;) then [po_order_id] END' />
      </column>
      <column caption='Cancellation Reasons DH' datatype='string' name='[Calculation_560768559711506438]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [cancel_reason] in (&apos;Picker opened PO by mistake&apos;,&apos;REJECTED BY SM&apos;,&apos;PO rejected on site (Capacity issue)&apos;,&apos;PO rejected on site (Barcodes issue)&apos;,&apos;Incorrect link to supplier&apos;,&apos;Supplier payments issue&apos;,&apos;User error / Test PO&apos;,&apos;Incorrect trade costs in PO&apos;,&apos;Rejected by DC&apos;,&apos;MOQ is not met&apos;) then [cancel_reason] END' />
      </column>
      <column caption='Supplier Cancellation Reason' datatype='string' name='[Calculation_560768559717752840]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [cancel_reason] in (&apos;AUTO CANCELLED&apos;,&apos;Supplier non fulfillment&apos;,&apos;PO rejected on site (Quality issue)&apos;) then [cancel_reason] END' />
      </column>
      <column caption='Start Date Parameter' datatype='date' name='[Calculation_6623387704744415232]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(&apos;2023-01-01&apos;)' />
      </column>
      <column caption='Top 30 Score' datatype='string' name='[Calculation_6660964608105840641]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF { INCLUDE [country_code], [supplier_name] : SUM([Calculation_2863022754822524928]) } &lt;= &#10;   { INCLUDE [country_code]: COUNTD([supplier_name]) } * 0.3 &#10;THEN &apos;A&apos;&#10;ELSEIF  {INCLUDE [country_code], [supplier_name] : SUM([Calculation_2863022754822524928]) } &lt;= &#10;   { INCLUDE [country_code]: COUNTD([supplier_name]) } * 0.4 &#10;AND&#10;{ INCLUDE [country_code], [supplier_name] : SUM([Calculation_2863022754822524928]) } &gt;= &#10;   { INCLUDE [country_code]: COUNTD([supplier_name]) } * 0.7&#10;then &apos;B&apos;&#10;ELSE &apos;C&apos;&#10;END' />
      </column>
      <column caption='% Supplier Cancelled Orders' datatype='real' name='[Calculation_6902329437493772288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1780962558296092673]/ [Calculation_1780962558294376448]' />
      </column>
      <column caption='% Overdue POs' datatype='real' default-format='p0.00%' name='[Calculation_75857532949106688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([order_delayed_outstanding])/[Calculation_1780962558294376448]' />
      </column>
      <column caption='Country Filtered Delivery' datatype='integer' name='[Calculation_762726858250027010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [country_code] = &apos;tr&apos; THEN [Calculation_5246834331133001731] &#10;ELSEIF [order_status] = &apos;done&apos; THEN [Calculation_5246834331133001731] &#10;END' />
      </column>
      <column caption='Country Filtered Demand' datatype='integer' name='[Calculation_762726858250149891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [country_code] = &apos;tr&apos; THEN [Calculation_5377227615560704000] &#10;ELSEIF [order_status] = &apos;done&apos; THEN [Calculation_5377227615560704000] &#10;END' />
      </column>
      <column caption='Days on Hand' datatype='real' name='[Calculation_857583909570273280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([book_value]) / sum([cogs_eur])' />
      </column>
      <column caption='Fill Rate (Units) (old)' datatype='real' default-format='p0%' name='[Fill Rate (Units) (copy)_6356690193024028672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;when &quot;Including Supplier Cancellation&quot; then IFNULL(sum(if [order_status] = &apos;done&apos; then [Calculation_5246834331133001731] end)/(sum(if [order_status] = &apos;done&apos; then [Calculation_5377227615560704000] end) + ([Calculation_4596556772656324614])),0)&#10;when &quot;Excluding Supplier Cancellation&quot; then IFNULL(sum(if [order_status] = &apos;done&apos; then [Calculation_5246834331133001731] end)/(sum(if [order_status] = &apos;done&apos; then [Calculation_5377227615560704000] end)),0)&#10;when &quot;Only Supplier Cancellation&quot; then IFNULL(sum(if [order_status] = &apos;done&apos; then [Calculation_5246834331133001731] end)/([Calculation_4596556772656324614]),0)&#10;END' />
      </column>
      <column caption='Fill Rate (Units)' datatype='real' default-format='p0%' name='[Fill Rate (Units) (copy)_762726858248347649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Including Supplier Cancellation&quot; THEN &#10;    IFNULL(SUM([Calculation_762726858250027010]) / (SUM([Calculation_762726858250149891]) + [Calculation_4596556772656324614]),0)&#10;WHEN &quot;Excluding Supplier Cancellation&quot; THEN &#10;    IFNULL(SUM([Calculation_762726858250027010]) / SUM([Calculation_762726858250149891]),0)&#10;WHEN &quot;Only Supplier Cancellation&quot; THEN &#10;    IFNULL(SUM([Calculation_762726858250027010]) / [Calculation_4596556772656324614],0)&#10;END' />
      </column>
      <column caption='Outstanding POs (copy)' datatype='integer' name='[Outstanding POs (copy)_4952200406690856967]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if ([order_status] = &apos;in_progess&apos;  or [order_status] = &apos;partially_inbounded&apos; or [order_status] = &apos;confirmed&apos; or [order_status] = &apos;pending&apos;) and [order_delayed] = 1 then [po_order_id] end)' />
      </column>
      <column caption='Sales Volume Percentile (copy)' datatype='real' default-format='p0%' name='[Sales Volume Percentile (copy)_5845813092662673409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_PERCENTILE(sum([sales]),&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Segmentation (copy 2)' datatype='string' name='[Segmentation (copy 2)_2172212783942967307]' role='measure' type='nominal'>
        <calculation class='tableau' formula='{INCLUDE [country_code], [supplier_name]:&#10;IF (&#10;SUM([Calculation_2863022754822524928]) &gt;= (&#10;MAX({INCLUDE [country_code]: SUM([Calculation_2863022754822524928])}) * (&#10;COUNTD(IF {INCLUDE [country_code]: SUM([Calculation_2863022754822524928])} &gt; 0 THEN [supplier_name] END) - 1&#10;) + SUM(IF {INCLUDE [country_code]: SUM([Calculation_2863022754822524928])} &gt; 0 THEN [Calculation_2863022754822524928] END)&#10;) / COUNTD(IF {INCLUDE [country_code]: SUM([Calculation_2863022754822524928])} &gt; 0 THEN [supplier_name] END)&#10;AND&#10;SUM([Calculation_2863022754822524928]) &lt;= MAX({INCLUDE [country_code]: SUM([Calculation_2863022754822524928])})&#10;)&#10;THEN &apos;A&apos;&#10;ELSEIF (&#10;SUM([Calculation_2863022754822524928]) &gt;= (&#10;MAX({INCLUDE [country_code]: SUM([Calculation_2863022754822524928])}) * (&#10;COUNTD(IF {INCLUDE [country_code], [supplier_name]: SUM([Calculation_2863022754822524928])} &gt; 0 THEN [supplier_name] END) * 0.4 - 1&#10;) + SUM(IF {INCLUDE [country_code], [supplier_name]: SUM([Calculation_2863022754822524928])} &gt; 0 THEN [Calculation_2863022754822524928] END)&#10;) / COUNTD(IF {INCLUDE [country_code], [supplier_name]: SUM([Calculation_2863022754822524928])} &gt; 0 THEN [supplier_name] END)&#10;AND&#10;SUM([Calculation_2863022754822524928]) &lt; (&#10;MAX({INCLUDE [country_code]: SUM([Calculation_2863022754822524928])}) * (&#10;COUNTD(IF {INCLUDE [country_code], [supplier_name]: SUM([Calculation_2863022754822524928])} &gt; 0 THEN [supplier_name] END) * 0.7 - 1&#10;) + SUM(IF {INCLUDE [country_code], [supplier_name]: SUM([Calculation_2863022754822524928])} &gt; 0 THEN [Calculation_2863022754822524928] END)&#10;) / COUNTD(IF {INCLUDE [country_code], [supplier_name]: SUM([Calculation_2863022754822524928])} &gt; 0 THEN [supplier_name] END)&#10;)&#10;THEN &apos;B&apos;&#10;ELSE&#10;&apos;C&apos;&#10;END}' />
      </column>
      <column caption='Segmentation (Sales)' datatype='string' name='[Segmentation (copy 2)_5845813092662554624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [sales_percentile] &gt;= 0.7 and [sales_percentile] &lt;= 1 then &apos;A&apos;&#10;ELSEIF [sales_percentile] &gt;= 0.3 and [sales_percentile] &lt; 0.7 then &apos;B&apos;&#10;ELSEIF [sales_percentile] &lt; 0.3 then &apos;C&apos; END' />
      </column>
      <column caption='Segmentation (copy)' datatype='string' default-type='ordinal' name='[Segmentation (copy)_2172212782910849029]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF { INCLUDE [country_code], [supplier_name] : SUM([Calculation_2863022754822524928]) } &lt;= &#10;   { INCLUDE [country_code]: COUNTD([supplier_name]) } * 0.3 &#10;THEN &apos;A&apos;&#10;ELSEIF  {INCLUDE [country_code], [supplier_name] : SUM([Calculation_2863022754822524928]) } &lt;= &#10;   { INCLUDE [country_code]: COUNTD([supplier_name]) } * 0.4 &#10;AND&#10;{ INCLUDE [country_code], [supplier_name] : SUM([Calculation_2863022754822524928]) } &gt;= &#10;   { INCLUDE [country_code]: COUNTD([supplier_name]) } * 0.7&#10;then &apos;B&apos;&#10;ELSE &apos;C&apos;&#10;END' />
      </column>
      <column caption='Shrinkage (%) (revenue)' datatype='real' default-format='p0%' name='[Shrinkage (%) (copy)_2470013338417537024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([shrinkage_eur_expired_wac]) / SUM([retail_revenue])' />
