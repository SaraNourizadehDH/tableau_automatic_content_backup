    <worksheet name='Not(30 days) Login History Country'>
      <table>
        <view>
          <datasources>
            <datasource caption='dpm_adoption_CG (dev_dmart)' name='federated.0mqbmg01j9oesu18r67um0eisn7j' />
          </datasources>
          <datasource-dependencies datasource='federated.0mqbmg01j9oesu18r67um0eisn7j'>
            <column caption='not logged in(yes/no)' datatype='string' name='[Calculation_3830030032798658561]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [lastlogindate], TODAY()) &lt;= 30 THEN &quot;Yes&quot; ELSE &quot;No&quot; END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[id (DPM_user_info_CG)]' derivation='CountD' name='[ctd:id (DPM_user_info_CG):qk]' pivot='key' type='quantitative' />
            <column caption='id (DPM user info CG)' datatype='string' name='[id (DPM_user_info_CG)]' role='dimension' type='nominal' />
            <column caption='Lastlogindate' datatype='date' name='[lastlogindate]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_3830030032798658561]' derivation='None' name='[none:Calculation_3830030032798658561:nk]' pivot='key' type='nominal' />
