      </connection>
      <aliases enabled='yes' />
      <column aggregation='Sum' caption='Contract Score' datatype='real' name='[Calculation_3019522837201866752]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='((If ISNULL([score_contract]) THEN 0 ELSE [score_contract] END)/6)' />
      </column>
      <column caption='No of Warehouses Contract' datatype='integer' name='[Calculation_3019522837204471809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([warehouse_id (contract_CG)])' />
      </column>
      <column caption='No of Contract' datatype='integer' name='[Calculation_3437302071483555840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([contractnumber])' />
      </column>
      <column caption='License/Permit calculation' datatype='real' name='[Calculation_3437302071494582274]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='({ FIXED [warehouse_id (license_permit_CG)] : SUM([completion_percentage (license_permit_CG)])/COUNTD([ID_LP])})*100' />
      </column>
      <column caption='No of Warehouses LP' datatype='integer' name='[Calculation_3437302071495950340]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([warehouse_id (license_permit_CG)])' />
      </column>
      <column caption='No of LP' datatype='integer' name='[Calculation_3437302071496511493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([ID_LP])' />
      </column>
      <column caption='Number of Vendor Account history' datatype='integer' name='[Calculation_3437302071507324935]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([global_vendor_id])' />
      </column>
      <column caption='not logged in(yes/no)' datatype='string' name='[Calculation_3830030032798658561]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [lastlogindate], TODAY()) &lt;= 30 THEN &quot;Yes&quot; ELSE &quot;No&quot; END' />
      </column>
      <column caption='Completion %' datatype='real' name='[Calculation_406801732917071872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(((If ISNULL([score_c]) THEN 0 ELSE [score_c] END))/6)' />
      </column>
