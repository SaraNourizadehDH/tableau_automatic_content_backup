            <column caption='No of Warehouses Contact' datatype='integer' name='[Calculation_406801732933210116]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([warehouse_id_RC])' />
            </column>
            <column caption='Calculation1' datatype='real' name='[Calculation_566679519959822339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='({ FIXED [warehouse_name_RC] : SUM([completion_percentage])/COUNTD([unique_id_RC])})*100' />
            </column>
            <column caption='No of Warehouse &lt; 100 Contact' datatype='integer' name='[Calculation_566679519962542085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF { FIXED [warehouse_id_RC]: SUM(IFNULL([Calculation_566679519959822339], 0)) } &lt; 100 THEN 1 ELSE 0 END)' />
            </column>
