    <worksheet name='Region  LP WA - AM'>
      <table>
        <view>
          <datasources>
            <datasource caption='dpm_adoption_CG (dev_dmart)' name='federated.0mqbmg01j9oesu18r67um0eisn7j' />
          </datasources>
          <datasource-dependencies datasource='federated.0mqbmg01j9oesu18r67um0eisn7j'>
            <column caption='License/Permit calculation' datatype='real' name='[Calculation_3437302071494582274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='({ FIXED [warehouse_id (license_permit_CG)] : SUM([completion_percentage (license_permit_CG)])/COUNTD([ID_LP])})*100' />
            </column>
            <column caption='ID LP' datatype='string' name='[ID_LP]' role='dimension' type='nominal' />
            <column caption='No of Warehouse &lt; 100 License/Permit' datatype='integer' name='[No of Warehouse &lt; 100 Contract (copy)_3437302071494758403]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF { FIXED [warehouse_id (license_permit_CG)]: SUM(IFNULL([Calculation_3437302071494582274], 0)) } &lt; 100 THEN 1 ELSE 0 END)' />
            </column>
            <column aggregation='Sum' caption='Completion Percentage' datatype='real' name='[completion_percentage (license_permit_CG)]' role='dimension' type='ordinal' />
            <column-instance column='[completion_percentage (license_permit_CG)]' derivation='None' name='[none:completion_percentage (license_permit_CG):ok]' pivot='key' type='ordinal' />
            <column-instance column='[region (license_permit_CG)]' derivation='None' name='[none:region (license_permit_CG):nk]' pivot='key' type='nominal' />
            <column-instance column='[store_status (license_permit_CG)]' derivation='None' name='[none:store_status (license_permit_CG):nk]' pivot='key' type='nominal' />
