            <column caption='Backmargin' datatype='real' name='[Calculation_1787014325313527816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[dc_backmargin] + [ds_backmargin]' />
            </column>
            <column caption='Product Margin' datatype='real' name='[Calculation_1787014325313859593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1787014325308465152] + [cost_of_goods_sold]+ [Calculation_1787014325313527816] + [packaging_costs]) + SUM([Calculation_1787014325316378635])' />
            </column>
            <column caption='shrinkage xd' datatype='real' name='[Calculation_1787014325316378635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([shrinkage],0)' />
            </column>
            <column caption='Product Margin as % of RR' datatype='real' name='[Calculation_1787014325322453004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1787014325313859593] / SUM([retail_revenue_incl_discounts])' />
            </column>
            <column caption='Contribution Margin' datatype='real' name='[Calculation_1787014325322887181]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1787014325313859593] + SUM([ic_commission] + [ic_delivery_services] + [shopper_cost])' />
            </column>
            <column caption='Contribution Margin as % of RR' datatype='real' name='[Calculation_1787014325323321358]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1787014325322887181] / SUM([retail_revenue_incl_discounts])' />
            </column>
            <column caption='Total Store Cost' datatype='real' name='[Calculation_1787014325324165135]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[store_personnel] + [store_non_personnel] + [store_utilities] + [store_overheads_wo_utilities] + [store_rent]' />
            </column>
            <column caption='Total DC Cost' datatype='real' name='[Calculation_1787014325325299728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[dc_personnel] + [dc_non_personnel] + [dc_utilities] + [dc_overheads_wo_utilities] + [dc_rent]' />
            </column>
            <column caption='Contribution Margin 2' datatype='real' name='[Calculation_1787014325327208465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1787014325322887181] + SUM([Calculation_1787014325324165135] + [Calculation_1787014325325299728] + [other_costs] + [bad_debt] + [payment_fee] + [depreciation_amortization])' />
            </column>
            <column caption='Gross Profit excl. NRV' datatype='real' name='[Calculation_1787014325327974419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1787014325327208465] + SUM([cancellation_of_rent_and_depr])' />
            </column>
            <column caption='Gross Profit incl. NRV' datatype='real' name='[Calculation_1787014325329211412]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1787014325327974419] + SUM([nrv])' />
            </column>
            <column caption='AEBITDA' datatype='real' name='[Calculation_1787014325329907733]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1787014325329211412] + SUM([sales_and_marketing] + [product_and_tech] + [sga])' />
            </column>
