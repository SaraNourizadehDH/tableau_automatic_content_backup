      <column caption='Agent Interactions (Contact Reason L3)' datatype='real' default-format='n#,##0;-#,##0' name='[Agent Interactions (Contact Reason L3) (copy)_822751421723574272]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='ROUND ({ FIXED [contact_reason_l1],[contact_reason_l2],[contact_reason_l3]: &#13;&#10;  SUM([interaction_count]*[work_item_count])&#13;&#10;  / SUM([work_item_count])&#13;&#10;},0)' />
      </column>
      <column caption='Period 2 Agent Interactions (CR3)' datatype='real' default-format='n#,##0;-#,##0' name='[Agent Interactions (Contact Reason L3) (copy)_822751421827096583]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [resolved_date]&gt;= [Parameters].[(Period 1) Start Date (copy)_993606727672020998]&#13;&#10;       AND [resolved_date]&lt;= [Parameters].[(Period 1) End Date (copy)_993606727671861253]&#13;&#10;THEN &#13;&#10;ROUND ({ FIXED [contact_reason_l1],[contact_reason_l2],[contact_reason_l3]: &#13;&#10;  SUM(IF [resolved_date]&gt;= [Parameters].[(Period 1) Start Date (copy)_993606727672020998] &#13;&#10;       AND [resolved_date]&lt;= [Parameters].[(Period 1) End Date (copy)_993606727671861253]&#13;&#10;    THEN  [interaction_count]*[work_item_count] END)&#13;&#10;  / SUM(IF [resolved_date]&gt;= [Parameters].[(Period 1) Start Date (copy)_993606727672020998] &#13;&#10;       AND [resolved_date]&lt;= [Parameters].[(Period 1) End Date (copy)_993606727671861253]&#13;&#10;    THEN [work_item_count] END)&#13;&#10;},0)&#13;&#10;END&#13;&#10;&#13;&#10;//ROUND ({ FIXED [Contact Reason L1],[Contact Reason L2],[Contact Reason L3]: &#13;&#10;//  SUM(IF [Resolved Date]&gt;= [(Period 2) Start Date] &#13;&#10;//       AND [Resolved Date]&lt;= [(Period 2) End Date]&#13;&#10;//    THEN  [Interaction Count]*[Work Item Count] END)&#13;&#10;//  / SUM(IF [Resolved Date]&gt;= [(Period 2) Start Date] &#13;&#10;//       AND [Resolved Date]&lt;= [(Period 2) End Date]&#13;&#10;//    THEN [Work Item Count] END)&#13;&#10;//},0)' />
      </column>
      <column caption='Current Agent Interactions' datatype='real' name='[Agent Interactions (copy)_1204994393547456513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([interaction_count]*[work_item_count])&#13;&#10;/&#13;&#10;SUM([work_item_count])' />
      </column>
      <column caption='Influence' datatype='real' name='[Calculation_1096908003810025472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Agent Interactions (copy)_1204994393547456513] - MAX({ FIXED : [Agent Interactions (copy)_1204994393547456513]}))&#13;&#10;*&#13;&#10;(SUM([work_item_count])&#13;&#10;/MAX({ FIXED : SUM([work_item_count])}))' />
      </column>
