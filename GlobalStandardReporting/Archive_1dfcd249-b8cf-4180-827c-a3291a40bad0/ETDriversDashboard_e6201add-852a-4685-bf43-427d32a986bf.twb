      <aliases enabled='yes' />
      <column caption=' % of live requests with total handling time above 15 min poistive % diff' datatype='string' name='[ % of live requests with total handling time above 15 min Previous (copy)_6037990117236490282]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_6037990117236441129]&gt; 0&#10;THEN &quot;▲&quot;&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption=' % of live requests with total handling time above 15 min negative % diff' datatype='string' name='[ % of live requests with total handling time above 15 min Previous (copy)_6037990117236547627]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_6037990117236441129]&lt; 0&#10;THEN &quot;▼&quot;&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption=' % of live requests with total handling time above 15 min' datatype='real' default-format='p0%' name='[ % of non-live requests with handling time above 30 min (copy)_1628684606500179969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//--- excludes current and previous day from calculation as orders data is incomplete&#10;SUM([percent_live_requests_with_tht_above_15mins_numerator])&#10;/&#10;SUM([percent_live_requests_with_tht_above_15mins_denominator])' />
      </column>
      <column caption=' % of non-live requests with handling time above 30 min' datatype='real' default-format='p0%' name='[ % of requests with handling time above X min (HT = THT Chats &amp; HT non-live) (copy)_1628684606499618816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//--- excludes current and previous day from calculation as orders data is incomplete&#10;SUM([percent_non_live_requests_with_ht_above_30mins_numerator])&#10;/&#10;SUM([percent_non_live_requests_with_ht_above_30mins_denominator])' />
      </column>
      <column caption='Avg. time to answer chat (secs)' datatype='real' default-format='p0%' name='[% of backoffice changes (copy)_4884364919487881223]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//--- excludes current and previous day from calculation as orders data is incomplete&#10;SUM([avg_time_to_answer_chat_numerator])&#10;/&#10;SUM([avg_time_to_answer_chat_denominator])' />
      </column>
      <column caption='% of change requests out of all config changes Positive % Diff ' datatype='string' name='[% of change requests out of all config changes Negative % Diff  (copy)_6037990117222305802]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_6037990117221928966]&gt; 0&#10;THEN &quot;▲&quot;&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='% of inbound contacts handled in SfS' datatype='real' default-format='p0%' name='[% of first answers resolved wih special skill (copy)_4884364919490396170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//--- excludes current and previous day from calculation as orders data is incomplete&#10;SUM([percent_inbound_contacts_handled_in_Sf_numerator])&#10;/&#10;SUM([percent_inbound_contacts_handled_in_Sf_denominator])' />
      </column>
      <column caption='% of first answers resolved wih special skill previous' datatype='real' name='[% of first answers resolved wih special skill current (copy)_6037990117228273676]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Completed Week Parameter] = &apos;Weekly&apos;&#10;then &#10;{ SUM(&#10;    IF [is_max_week (copy)_6037990117221265410]&#10;    THEN [percent_requests_resolved_with_special_skill_numerator]&#10;    ELSE 0 END&#10;    )&#10;&#10;/ SUM(IF [is_max_week (copy)_6037990117221265410]&#10;    THEN [percent_requests_resolved_with_special_skill_denominator]&#10;    ELSE 0 END&#10;    )&#10;}&#10;ELSEIF  [Parameters].[Completed Week Parameter]= &apos;Monthly&apos;&#10;then &#10;{ EXCLUDE [week]:&#10;    SUM(&#10;    IF [is_max_month (copy)_6037990117221519364]&#10;    THEN [percent_requests_resolved_with_special_skill_numerator]&#10;    ELSE 0 END&#10;    )&#10;/&#10; SUM(&#10;    IF [is_max_month (copy)_6037990117221519364]&#10;    THEN [percent_requests_resolved_with_special_skill_denominator]&#10;    ELSE 0 END&#10;    )&#10;}&#10;end' />
      </column>
      <column caption=' % of requests with handling time above X min (HT = THT Chats &amp; HT non-live)' datatype='real' default-format='p0%' name='[% of inbound contacts handled in SfS (copy)_4884364919491182603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//--- excludes current and previous day from calculation as orders data is incomplete&#10;SUM([percent_requests_with_ht_above_Xmins_numerator])&#10;/&#10;SUM([percent_requests_with_ht_above_Xmins_denominator])' />
      </column>
