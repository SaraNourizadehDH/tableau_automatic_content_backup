    <worksheet name='Drivers Adoption tab'>
      <table>
        <view>
          <datasources>
            <datasource caption='et_drivers' name='federated.0gqoovo0dtggoq11xfe5g16gaz4t' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Granularity Level' datatype='string' name='[Completed Week Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
              <aliases>
                <alias key='&quot;Monthly&quot;' value='Month' />
                <alias key='&quot;Weekly&quot;' value='Week' />
              </aliases>
            </column>
            <column caption='Drivers' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Cancellations&quot;'>
              <calculation class='tableau' formula='&quot;Cancellations&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gqoovo0dtggoq11xfe5g16gaz4t'>
            <column caption=' % of live requests with total handling time above 15 min' datatype='real' default-format='p0%' name='[ % of non-live requests with handling time above 30 min (copy)_1628684606500179969]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//--- excludes current and previous day from calculation as orders data is incomplete&#10;SUM([percent_live_requests_with_tht_above_15mins_numerator])&#10;/&#10;SUM([percent_live_requests_with_tht_above_15mins_denominator])' />
            </column>
            <column caption=' % of non-live requests with handling time above 30 min' datatype='real' default-format='p0%' name='[ % of requests with handling time above X min (HT = THT Chats &amp; HT non-live) (copy)_1628684606499618816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//--- excludes current and previous day from calculation as orders data is incomplete&#10;SUM([percent_non_live_requests_with_ht_above_30mins_numerator])&#10;/&#10;SUM([percent_non_live_requests_with_ht_above_30mins_denominator])' />
            </column>
            <column caption='Avg. time to answer chat (secs)' datatype='real' default-format='p0%' name='[% of backoffice changes (copy)_4884364919487881223]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//--- excludes current and previous day from calculation as orders data is incomplete&#10;SUM([avg_time_to_answer_chat_numerator])&#10;/&#10;SUM([avg_time_to_answer_chat_denominator])' />
            </column>
            <column caption='% of inbound contacts handled in SfS' datatype='real' default-format='p0%' name='[% of first answers resolved wih special skill (copy)_4884364919490396170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//--- excludes current and previous day from calculation as orders data is incomplete&#10;SUM([percent_inbound_contacts_handled_in_Sf_numerator])&#10;/&#10;SUM([percent_inbound_contacts_handled_in_Sf_denominator])' />
            </column>
            <column caption='% of first answers resolved wih special skill' datatype='real' default-format='p0%' name='[Avg. time to answer chat (copy)_4884364919489646601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//--- excludes current and previous day from calculation as orders data is incomplete&#10;SUM([percent_requests_resolved_with_special_skill_numerator])&#10;/&#10;SUM([percent_requests_resolved_with_special_skill_denominator])' />
            </column>
            <column caption='Oneview Core Actions : % Adoption' datatype='real' default-format='p0%' name='[Calculation_2343419957315035146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cancellations_numerator]) + SUM([comp_and_refund_numerator]) + SUM([change_dropoff_address_numerator]))&#10;/ &#10;(SUM([cancellations_denominator]) + SUM([comp_and_refund_denominator]) +SUM([change_dropoff_address_denominator]))' />
            </column>
            <column caption='oneview_core_actions_numerator' datatype='integer' name='[Calculation_323625874212675584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([cancellations_numerator]) + SUM([comp_and_refund_numerator]) + SUM([change_dropoff_address_numerator]))' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_323625874223710210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Completed Week Parameter]&#10;WHEN &quot;Weekly&quot; THEN [week]&#10;WHEN &quot;Monthly&quot; THEN [month]&#10;END' />
            </column>
            <column caption='Change Delivery Address: % Adoption ' datatype='real' default-format='p0%' name='[Cancellations: % Reach (copy)_4884364919455830016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//--- excludes current and previous day from calculation as orders data is incomplete&#10;SUM([change_dropoff_address_numerator])&#10;/&#10;SUM([change_dropoff_address_denominator])' />
            </column>
            <column caption='% of change requests out of all config changes' datatype='real' default-format='p0%' name='[Cancellations: % Reach (copy)_4884364919484776454]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//--- excludes current and previous day from calculation as orders data is incomplete&#10;SUM([backoffice_config_updates_numerator])&#10;/&#10;SUM([backoffice_config_updates_denominator])' />
            </column>
            <column caption='Cancellations: % Adoption' datatype='real' default-format='p0%' name='[O3.2 - Auto-comp reach *** (copy)_2343419957270347777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//--- excludes current and previous day from calculation as orders data is incomplete&#10;SUM([cancellations_numerator])&#10;/&#10;SUM([cancellations_denominator])' />
            </column>
            <column caption='Driver - Denominator' datatype='integer' default-format='n#,##0;-#,##0' name='[OneView: % of SF Agents on OneView (copy) (copy) (copy)_5341761744702689300]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;Cancellations&apos; THEN SUM(ZN([cancellations_denominator]))&#10;    WHEN &apos;Comp and refunds&apos; THEN SUM(ZN([comp_and_refund_denominator]))&#10;    WHEN &apos;Change Delivery Address&apos; THEN SUM(ZN([change_dropoff_address_denominator]))&#10;    WHEN &apos;% of change requests out of all config changes&apos; THEN SUM(ZN([backoffice_config_updates_denominator]))&#10;    WHEN &apos;Avg. time to answer chat&apos; THEN SUM(ZN([avg_time_to_answer_chat_denominator]))&#10;    WHEN &apos;% of requests with handling time above X min&apos; THEN SUM(ZN([percent_requests_with_ht_above_Xmins_denominator]))&#10;    WHEN &apos;% of first answers resolved wih special skill&apos; THEN SUM(ZN([percent_requests_resolved_with_special_skill_denominator]))&#10;    WHEN &apos;% of inbound contacts handled in SfS&apos; THEN SUM(ZN([percent_inbound_contacts_handled_in_Sf_denominator]))&#10;    WHEN &apos;Oneview Core Actions : % Adoption&apos; THEN [oneview_core_actions_numerator (copy)_323625874216329217]&#10;    WHEN &apos; % of live requests with total handling time above 15 min&apos; THEN SUM(ZN([percent_live_requests_with_tht_above_15mins_denominator]))&#10;    WHEN &apos; % of non-live requests with handling time above 30 min&apos; THEN SUM(ZN([percent_non_live_requests_with_ht_above_30mins_denominator]))&#10;END' />
            </column>
            <column caption='Driver - Numerator' datatype='integer' default-format='n#,##0;-#,##0' name='[OneView: % of SF Agents on OneView (copy) (copy)_5341761744702648339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;Cancellations&apos; THEN SUM(ZN([cancellations_numerator]))&#10;    WHEN &apos;Comp and refunds&apos; THEN SUM(ZN([comp_and_refund_numerator]))&#10;    WHEN &apos;Change Delivery Address&apos; THEN SUM(ZN([change_dropoff_address_numerator]))&#10;    WHEN &apos;% of change requests out of all config changes&apos; THEN SUM(ZN([backoffice_config_updates_numerator]))&#10;    WHEN &apos;Avg. time to answer chat&apos; THEN SUM(ZN([avg_time_to_answer_chat_numerator]))&#10;    WHEN &apos;% of requests with handling time above X min&apos; THEN SUM(ZN([percent_requests_with_ht_above_Xmins_numerator]))&#10;    WHEN &apos;% of first answers resolved wih special skill&apos; THEN SUM(ZN([percent_requests_resolved_with_special_skill_numerator]))&#10;    WHEN &apos;% of inbound contacts handled in SfS&apos; THEN SUM(ZN([percent_inbound_contacts_handled_in_Sf_numerator]))&#10;    WHEN &apos;Oneview Core Actions : % Adoption&apos; THEN ([Calculation_323625874212675584])&#10;    WHEN &apos; % of live requests with total handling time above 15 min&apos; THEN SUM(ZN([percent_live_requests_with_tht_above_15mins_numerator]))&#10;    WHEN &apos; % of non-live requests with handling time above 30 min&apos; then SUM(ZN([percent_non_live_requests_with_ht_above_30mins_numerator]))&#10;END' />
            </column>
            <column caption='% Adoption' datatype='real' default-format='*#,##0;0%' name='[Reach KPI (copy)_5341761744706871318]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// This is the Reach label which has a custom number format to display % and absolute values simultaneously&#10;// For % values, we place a &apos;-&apos; sign in front of the KPI to be displayed. This technique works for scenarios where you do not have -ve values in your % values.&#10;// More info on how this works here : https://www.vizwiz.com/2015/01/formattinghack.html&#10;&#10;IF     [Parameters].[Parameter 2] = &apos;Cancellations&apos;              THEN  -[O3.2 - Auto-comp reach *** (copy)_2343419957270347777]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Comp and refunds&apos;           THEN  -[Salesforce : % Reach (copy)_3699988608278556676]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Change Delivery Address&apos; THEN -[Cancellations: % Reach (copy)_4884364919455830016]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% of change requests out of all config changes&apos; THEN -[Cancellations: % Reach (copy)_4884364919484776454]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% of inbound contacts handled in SfS&apos; THEN -[% of first answers resolved wih special skill (copy)_4884364919490396170]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg. time to answer chat&apos; THEN [% of backoffice changes (copy)_4884364919487881223]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% of first answers resolved wih special skill&apos; THEN -[Avg. time to answer chat (copy)_4884364919489646601]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Oneview Core Actions : % Adoption&apos; THEN -[Calculation_2343419957315035146]&#10;ELSEIF [Parameters].[Parameter 2] = &apos; % of live requests with total handling time above 15 min&apos; THEN -[ % of non-live requests with handling time above 30 min (copy)_1628684606500179969]&#10;ELSEIF [Parameters].[Parameter 2] = &apos; % of non-live requests with handling time above 30 min&apos; THEN -[ % of requests with handling time above X min (HT = THT Chats &amp; HT non-live) (copy)_1628684606499618816]&#10;END' />
            </column>
            <column caption='Compensation and refunds : % Adoption' datatype='real' default-format='p0%' name='[Salesforce : % Reach (copy)_3699988608278556676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([comp_and_refund_numerator])&#10;/&#10;SUM([comp_and_refund_denominator])' />
            </column>
            <column caption='Select Week' datatype='string' datatype-customized='true' name='[Week1 (copy 2)_4649262981741772804]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[week]' />
            </column>
