    <worksheet name='% of change requests out of all config changes'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontsize='10'>&lt;Sheet Name&gt;</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='false' fontalignment='1' fontcolor='#000000' fontsize='8'>(Please select  a single week  to have detailed number for this driver. Reason : Check </run>
            <run fontalignment='1' fontcolor='#000000' fontsize='8'>5/ </run>
            <run bold='false' fontalignment='1' fontcolor='#000000' fontsize='8'>in Notes)</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='false' fontalignment='1' fontcolor='#59a14f' fontsize='9'><![CDATA[<[federated.0gqoovo0dtggoq11xfe5g16gaz4t].[usr:% of change requests out of all config changes Negative % Diff  (copy)_6037990117222305802:nk]>]]></run>
            <run bold='false' fontalignment='1' fontcolor='#e15759' fontsize='9'><![CDATA[<[federated.0gqoovo0dtggoq11xfe5g16gaz4t].[usr:Calculation_6037990117222199305:nk]> ]]></run>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Light' fontsize='9'><![CDATA[<[federated.0gqoovo0dtggoq11xfe5g16gaz4t].[usr:Calculation_6037990117221928966:qk]> ]]></run>
            <run bold='false' fontalignment='1' fontcolor='#555555' fontname='Tableau Light' fontsize='9'><![CDATA[change  vs Previous <[Parameters].[Completed Week Parameter]> ]]></run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='false' fontalignment='1' fontcolor='#000000' fontname='Tableau Light' fontsize='9'>Æ </run>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Light' fontsize='9'><![CDATA[<[federated.0gqoovo0dtggoq11xfe5g16gaz4t].[usr:Calculation_6037990117222092808:qk]>]]></run>
            <run fontalignment='1' fontcolor='#555555' fontname='Tableau Light' fontsize='9'> PP </run>
            <run bold='false' fontalignment='1' fontcolor='#555555' fontname='Tableau Light' fontsize='9'><![CDATA[change vs Previous <[Parameters].[Completed Week Parameter]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='et_drivers' name='federated.0gqoovo0dtggoq11xfe5g16gaz4t' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Granularity Level' datatype='string' name='[Completed Week Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
              <aliases>
                <alias key='&quot;Monthly&quot;' value='Month' />
                <alias key='&quot;Weekly&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gqoovo0dtggoq11xfe5g16gaz4t'>
            <column caption='% of change requests out of all config changes Positive % Diff ' datatype='string' name='[% of change requests out of all config changes Negative % Diff  (copy)_6037990117222305802]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_6037990117221928966]&gt; 0&#10;THEN &quot;▲&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_323625874223710210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Completed Week Parameter]&#10;WHEN &quot;Weekly&quot; THEN [week]&#10;WHEN &quot;Monthly&quot; THEN [month]&#10;END' />
            </column>
            <column caption='% of change requests out of all config changes current' datatype='real' name='[Calculation_6037990117216595968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Completed Week Parameter] = &apos;Weekly&apos;&#10;then &#10;{ EXCLUDE [week]:&#10;    SUM(&#10;    IF [Calculation_6037990117218693121]&#10;    THEN [backoffice_config_updates_numerator]&#10;    ELSE 0 END&#10;    )&#10;&#10;/ SUM(IF [Calculation_6037990117218693121]&#10;    THEN [backoffice_config_updates_denominator]&#10;    ELSE 0 END&#10;    )&#10;}&#10;ELSEIF  [Parameters].[Completed Week Parameter]= &apos;Monthly&apos;&#10;then &#10;{ EXCLUDE [week]:&#10;    SUM(&#10;    IF [is_max_week (copy)_6037990117221425155]&#10;    THEN [backoffice_config_updates_numerator]&#10;    ELSE 0 END&#10;    )&#10;/&#10; SUM(&#10;    IF [is_max_week (copy)_6037990117221425155]&#10;    THEN [backoffice_config_updates_denominator]&#10;    ELSE 0 END&#10;    )&#10;}&#10;end' />
            </column>
            <column caption='is_max_week' datatype='boolean' name='[Calculation_6037990117218693121]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [week]: MAX([week])} = {FIXED: MAX([week])}' />
            </column>
            <column caption='% of change requests out of all config changes previous' datatype='real' name='[Calculation_6037990117221699589]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Completed Week Parameter] = &apos;Weekly&apos;&#10;then &#10;{ SUM(&#10;    IF [is_max_week (copy)_6037990117221265410]&#10;    THEN [backoffice_config_updates_numerator]&#10;    ELSE 0 END&#10;    )&#10;&#10;/ SUM(IF [is_max_week (copy)_6037990117221265410]&#10;    THEN [backoffice_config_updates_denominator]&#10;    ELSE 0 END&#10;    )&#10;}&#10;ELSEIF  [Parameters].[Completed Week Parameter]= &apos;Monthly&apos;&#10;then &#10;{ EXCLUDE [week]:&#10;    SUM(&#10;    IF [is_max_month (copy)_6037990117221519364]&#10;    THEN [backoffice_config_updates_numerator]&#10;    ELSE 0 END&#10;    )&#10;/&#10; SUM(&#10;    IF [is_max_month (copy)_6037990117221519364]&#10;    THEN [backoffice_config_updates_denominator]&#10;    ELSE 0 END&#10;    )&#10;}&#10;end' />
            </column>
            <column caption='% of change requests out of all config changes % Change ' datatype='real' default-format='p0.00%' name='[Calculation_6037990117221928966]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_6037990117216595968])&#10;-SUM([Calculation_6037990117221699589]))&#10;/SUM([Calculation_6037990117221699589])' />
            </column>
            <column caption='% of change requests out of all config changes % Change PP' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6037990117222092808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_6037990117216595968])&#10;- SUM([Calculation_6037990117221699589])) &#10;* 100' />
            </column>
            <column caption='% of change requests out of all config changes Negative % Diff ' datatype='string' name='[Calculation_6037990117222199305]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_6037990117221928966]&lt; 0&#10;THEN &quot;▼&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='% of change requests out of all config changes' datatype='real' default-format='p0%' name='[Cancellations: % Reach (copy)_4884364919484776454]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//--- excludes current and previous day from calculation as orders data is incomplete&#10;SUM([backoffice_config_updates_numerator])&#10;/&#10;SUM([backoffice_config_updates_denominator])' />
            </column>
            <column caption='Select Week' datatype='string' datatype-customized='true' name='[Week1 (copy 2)_4649262981741772804]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[week]' />
            </column>
