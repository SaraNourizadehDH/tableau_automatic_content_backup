            </column>
            <column aggregation='Attribute' caption='% of inbound contacts handled in SfS current' datatype='real' name='[Calculation_6037990117233205273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Completed Week Parameter] = &apos;Weekly&apos;&#10;then &#10;{ EXCLUDE [week]:&#10;    SUM(&#10;    IF [Calculation_6037990117218693121]&#10;    THEN [percent_inbound_contacts_handled_in_Sf_numerator]&#10;    ELSE 0 END&#10;    )&#10;&#10;/ SUM(IF [Calculation_6037990117218693121]&#10;    THEN [percent_inbound_contacts_handled_in_Sf_denominator]&#10;    ELSE 0 END&#10;    )&#10;}&#10;ELSEIF  [Parameters].[Completed Week Parameter]= &apos;Monthly&apos;&#10;then &#10;{ EXCLUDE [week]:&#10;    SUM(&#10;    IF [is_max_week (copy)_6037990117221425155]&#10;    THEN [percent_inbound_contacts_handled_in_Sf_numerator]&#10;    ELSE 0 END&#10;    )&#10;/&#10; SUM(&#10;    IF [is_max_week (copy)_6037990117221425155]&#10;    THEN [percent_inbound_contacts_handled_in_Sf_denominator]&#10;    ELSE 0 END&#10;    )&#10;}&#10;end' />
            </column>
