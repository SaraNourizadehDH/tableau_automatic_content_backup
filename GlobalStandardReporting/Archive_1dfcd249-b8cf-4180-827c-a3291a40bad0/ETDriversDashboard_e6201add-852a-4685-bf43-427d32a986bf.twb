    <worksheet name=' % of non-live requests with handling time above 30 min'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#1b1b1b' fontsize='8'>&lt;Sheet Name&gt;</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#e15759' fontsize='8'><![CDATA[<[federated.0gqoovo0dtggoq11xfe5g16gaz4t].[usr:Calculation_6037990117367439410:nk]>]]></run>
            <run fontalignment='1' fontcolor='#59a14f' fontsize='8'><![CDATA[<[federated.0gqoovo0dtggoq11xfe5g16gaz4t].[usr:Calculation_6037990117367504947:nk]> ]]></run>
            <run fontalignment='1' fontcolor='#1b1b1b' fontsize='8'><![CDATA[<[federated.0gqoovo0dtggoq11xfe5g16gaz4t].[usr:Calculation_6037990117367390257:qk]> (]]></run>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Light' fontsize='8'><![CDATA[<[federated.0gqoovo0dtggoq11xfe5g16gaz4t].[usr:Calculation_6037990117368688693:qk]> PP]]></run>
            <run bold='false' fontalignment='1' fontcolor='#000000' fontname='Tableau Light' fontsize='8'><![CDATA[)  vs Previous <[Parameters].[Completed Week Parameter]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='et_drivers' name='federated.0gqoovo0dtggoq11xfe5g16gaz4t' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Granularity Level' datatype='string' name='[Completed Week Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
              <aliases>
                <alias key='&quot;Monthly&quot;' value='Month' />
                <alias key='&quot;Weekly&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gqoovo0dtggoq11xfe5g16gaz4t'>
            <column caption=' % of non-live requests with handling time above 30 min' datatype='real' default-format='p0%' name='[ % of requests with handling time above X min (HT = THT Chats &amp; HT non-live) (copy)_1628684606499618816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//--- excludes current and previous day from calculation as orders data is incomplete&#10;SUM([percent_non_live_requests_with_ht_above_30mins_numerator])&#10;/&#10;SUM([percent_non_live_requests_with_ht_above_30mins_denominator])' />
            </column>
            <column caption='CW Week' datatype='string' name='[Calculation_1071364175301328899]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//STR(&apos;CW &apos; + [Week1])&#10;//STR(&apos;CW &apos; + STR(DATEPART(&apos;week&apos;,[Date])))&#10;STR(&apos;CW &apos; + STR([week]))' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_323625874223710210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Completed Week Parameter]&#10;WHEN &quot;Weekly&quot; THEN [week]&#10;WHEN &quot;Monthly&quot; THEN [month]&#10;END' />
            </column>
            <column caption='is_max_week' datatype='boolean' name='[Calculation_6037990117218693121]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [week]: MAX([week])} = {FIXED: MAX([week])}' />
            </column>
            <column aggregation='Attribute' caption=' % of non-live requests with handling time above 30 min current' datatype='real' name='[Calculation_6037990117367337007]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Completed Week Parameter] = &apos;Weekly&apos;&#10;then &#10;{EXCLUDE [week]:&#10;    SUM(&#10;    IF [Calculation_6037990117218693121]&#10;    THEN [percent_non_live_requests_with_ht_above_30mins_numerator]&#10;    ELSE 0 END&#10;    )&#10;&#10;/ SUM(IF [Calculation_6037990117218693121]&#10;    THEN [percent_non_live_requests_with_ht_above_30mins_denominator]&#10;    ELSE 0 END&#10;    )&#10;}&#10;ELSEIF  [Parameters].[Completed Week Parameter]= &apos;Monthly&apos;&#10;then &#10;{ EXCLUDE [week]:&#10;    SUM(&#10;    IF [is_max_week (copy)_6037990117221425155]&#10;    THEN [percent_non_live_requests_with_ht_above_30mins_numerator]&#10;    ELSE 0 END&#10;    )&#10;/&#10; SUM(&#10;    IF [is_max_week (copy)_6037990117221425155]&#10;    THEN [percent_non_live_requests_with_ht_above_30mins_denominator]&#10;    ELSE 0 END&#10;    )&#10;}&#10;end' />
            </column>
            <column caption=' % of non-live requests with handling time above 30 min previous' datatype='real' name='[Calculation_6037990117367361584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Completed Week Parameter] = &apos;Weekly&apos;&#10;then &#10;{ SUM(&#10;    IF [is_max_week (copy)_6037990117221265410]&#10;    THEN [percent_non_live_requests_with_ht_above_30mins_numerator]&#10;    ELSE 0 END&#10;    )&#10;&#10;/ SUM(IF [is_max_week (copy)_6037990117221265410]&#10;    THEN [percent_non_live_requests_with_ht_above_30mins_denominator]&#10;    ELSE 0 END&#10;    )&#10;}&#10;ELSEIF  [Parameters].[Completed Week Parameter]= &apos;Monthly&apos;&#10;then &#10;{ EXCLUDE [week]:&#10;    SUM(&#10;    IF [is_max_month (copy)_6037990117221519364]&#10;    THEN [percent_non_live_requests_with_ht_above_30mins_numerator]&#10;    ELSE 0 END&#10;    )&#10;/&#10; SUM(&#10;    IF [is_max_month (copy)_6037990117221519364]&#10;    THEN [percent_non_live_requests_with_ht_above_30mins_denominator]&#10;    ELSE 0 END&#10;    )&#10;}&#10;end' />
            </column>
            <column caption=' % of non-live requests with handling time above 30 min % change' datatype='real' default-format='p0.00%' name='[Calculation_6037990117367390257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_6037990117367337007])&#10;-SUM([Calculation_6037990117367361584]))&#10;/SUM([Calculation_6037990117367361584])' />
            </column>
            <column caption=' % of non-live requests with handling time above 30 min positive % diff' datatype='string' name='[Calculation_6037990117367439410]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_6037990117367390257]&gt; 0&#10;THEN &quot;▲&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption=' % of non-live requests with handling time above 30 min negative % diff' datatype='string' name='[Calculation_6037990117367504947]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_6037990117367390257]&lt; 0&#10;THEN &quot;▼&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption=' % of non-live requests with handling time above 30 min chnage PP' datatype='real' name='[Calculation_6037990117368688693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_6037990117367337007])&#10;-SUM([Calculation_6037990117367361584]))&#10;* 100' />
            </column>
            <column caption='Select Week' datatype='string' datatype-customized='true' name='[Week1 (copy 2)_4649262981741772804]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[week]' />
            </column>
            <column-instance column='[Calculation_1071364175301328899]' derivation='Attribute' name='[attr:Calculation_1071364175301328899:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='is_max_month_minus_one' datatype='boolean' name='[is_max_month (copy)_6037990117221519364]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT [is_max_week (copy)_6037990117221425155]&#10;AND&#10;{FIXED [month]: MAX([week])} = {FIXED [is_max_week (copy)_6037990117221425155]: MAX([week])}' />
            </column>
            <column caption='is_max_week_minus_one' datatype='boolean' name='[is_max_week (copy)_6037990117221265410]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT [Calculation_6037990117218693121]&#10;AND&#10;{FIXED [week]: MAX([week])} = {FIXED [Calculation_6037990117218693121]: MAX([week])}' />
            </column>
            <column caption='is_max_month' datatype='boolean' name='[is_max_week (copy)_6037990117221425155]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [month]: MAX([week])} = {FIXED: MAX([week])}' />
            </column>
