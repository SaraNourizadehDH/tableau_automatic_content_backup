          <datasource-dependencies datasource='federated.0gqoovo0dtggoq11xfe5g16gaz4t'>
            <column caption=' % of live requests with total handling time above 15 min poistive % diff' datatype='string' name='[ % of live requests with total handling time above 15 min Previous (copy)_6037990117236490282]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_6037990117236441129]&gt; 0&#10;THEN &quot;▲&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption=' % of live requests with total handling time above 15 min negative % diff' datatype='string' name='[ % of live requests with total handling time above 15 min Previous (copy)_6037990117236547627]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_6037990117236441129]&lt; 0&#10;THEN &quot;▼&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption=' % of live requests with total handling time above 15 min' datatype='real' default-format='p0%' name='[ % of non-live requests with handling time above 30 min (copy)_1628684606500179969]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//--- excludes current and previous day from calculation as orders data is incomplete&#10;SUM([percent_live_requests_with_tht_above_15mins_numerator])&#10;/&#10;SUM([percent_live_requests_with_tht_above_15mins_denominator])' />
            </column>
            <column caption='CW Week' datatype='string' name='[Calculation_1071364175301328899]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//STR(&apos;CW &apos; + [Week1])&#10;//STR(&apos;CW &apos; + STR(DATEPART(&apos;week&apos;,[Date])))&#10;STR(&apos;CW &apos; + STR([week]))' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_323625874223710210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Completed Week Parameter]&#10;WHEN &quot;Weekly&quot; THEN [week]&#10;WHEN &quot;Monthly&quot; THEN [month]&#10;END' />
            </column>
            <column caption='is_max_week' datatype='boolean' name='[Calculation_6037990117218693121]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [week]: MAX([week])} = {FIXED: MAX([week])}' />
            </column>
            <column aggregation='Attribute' caption=' % of live requests with total handling time above 15 min current' datatype='real' name='[Calculation_6037990117236363303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Completed Week Parameter] = &apos;Weekly&apos;&#10;then &#10;{EXCLUDE [week]:&#10;    SUM(&#10;    IF [Calculation_6037990117218693121]&#10;    THEN [percent_live_requests_with_tht_above_15mins_numerator]&#10;    ELSE 0 END&#10;    )&#10;&#10;/ SUM(IF [Calculation_6037990117218693121]&#10;    THEN [percent_live_requests_with_tht_above_15mins_denominator]&#10;    ELSE 0 END&#10;    )&#10;}&#10;ELSEIF  [Parameters].[Completed Week Parameter]= &apos;Monthly&apos;&#10;then &#10;{ EXCLUDE [week]:&#10;    SUM(&#10;    IF [is_max_week (copy)_6037990117221425155]&#10;    THEN [percent_live_requests_with_tht_above_15mins_numerator]&#10;    ELSE 0 END&#10;    )&#10;/&#10; SUM(&#10;    IF [is_max_week (copy)_6037990117221425155]&#10;    THEN [percent_live_requests_with_tht_above_15mins_denominator]&#10;    ELSE 0 END&#10;    )&#10;}&#10;end' />
            </column>
            <column caption=' % of live requests with total handling time above 15 min Previous' datatype='real' name='[Calculation_6037990117236408360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Completed Week Parameter] = &apos;Weekly&apos;&#10;then &#10;{ SUM(&#10;    IF [is_max_week (copy)_6037990117221265410]&#10;    THEN [percent_live_requests_with_tht_above_15mins_numerator]&#10;    ELSE 0 END&#10;    )&#10;&#10;/ SUM(IF [is_max_week (copy)_6037990117221265410]&#10;    THEN [percent_live_requests_with_tht_above_15mins_denominator]&#10;    ELSE 0 END&#10;    )&#10;}&#10;ELSEIF  [Parameters].[Completed Week Parameter]= &apos;Monthly&apos;&#10;then &#10;{ EXCLUDE [week]:&#10;    SUM(&#10;    IF [is_max_month (copy)_6037990117221519364]&#10;    THEN [percent_live_requests_with_tht_above_15mins_numerator]&#10;    ELSE 0 END&#10;    )&#10;/&#10; SUM(&#10;    IF [is_max_month (copy)_6037990117221519364]&#10;    THEN [percent_live_requests_with_tht_above_15mins_denominator]&#10;    ELSE 0 END&#10;    )&#10;}&#10;end' />
            </column>
            <column caption=' % of live requests with total handling time above 15 min % Change' datatype='real' default-format='p0.00%' name='[Calculation_6037990117236441129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_6037990117236363303])&#10;-SUM([Calculation_6037990117236408360]))&#10;/SUM([Calculation_6037990117236408360])' />
            </column>
            <column caption=' % of live requests with total handling time above 15 min % Change PP' datatype='real' name='[Calculation_6037990117237751853]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_6037990117236363303])&#10;-SUM([Calculation_6037990117236408360]))&#10;*100' />
