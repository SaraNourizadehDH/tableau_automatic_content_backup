      <table>
        <view>
          <datasources>
            <datasource caption='et_drivers' name='federated.0gqoovo0dtggoq11xfe5g16gaz4t' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Granularity Level' datatype='string' name='[Completed Week Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
              <aliases>
                <alias key='&quot;Monthly&quot;' value='Month' />
                <alias key='&quot;Weekly&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gqoovo0dtggoq11xfe5g16gaz4t'>
            <column caption='CW Week' datatype='string' name='[Calculation_1071364175301328899]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//STR(&apos;CW &apos; + [Week1])&#10;//STR(&apos;CW &apos; + STR(DATEPART(&apos;week&apos;,[Date])))&#10;STR(&apos;CW &apos; + STR([week]))' />
            </column>
            <column caption='Oneview Core Actions : % Adoption' datatype='real' default-format='p0%' name='[Calculation_2343419957315035146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([cancellations_numerator]) + SUM([comp_and_refund_numerator]) + SUM([change_dropoff_address_numerator]))&#10;/ &#10;(SUM([cancellations_denominator]) + SUM([comp_and_refund_denominator]) +SUM([change_dropoff_address_denominator]))' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_323625874223710210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Completed Week Parameter]&#10;WHEN &quot;Weekly&quot; THEN [week]&#10;WHEN &quot;Monthly&quot; THEN [month]&#10;END' />
            </column>
            <column caption='is_max_week' datatype='boolean' name='[Calculation_6037990117218693121]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [week]: MAX([week])} = {FIXED: MAX([week])}' />
            </column>
            <column aggregation='Attribute' caption='Oneview core actions current' datatype='real' name='[Calculation_6037990117234872352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Completed Week Parameter] = &apos;Weekly&apos;&#13;&#10;then &#13;&#10;{ EXCLUDE [week]:&#13;&#10;   (SUM(&#13;&#10;    IF [Calculation_6037990117218693121]&#13;&#10;    THEN [cancellations_numerator]&#13;&#10;    ELSE 0 END&#13;&#10;    )&#13;&#10;+ &#13;&#10; SUM(&#13;&#10;    IF [Calculation_6037990117218693121]&#13;&#10;    THEN [comp_and_refund_numerator]&#13;&#10;    ELSE 0 END&#13;&#10;    )&#13;&#10;+ &#13;&#10; SUM(&#13;&#10;    IF [Calculation_6037990117218693121]&#13;&#10;    THEN [change_dropoff_address_numerator]&#13;&#10;    ELSE 0 END&#13;&#10;    ))&#13;&#10;&#13;&#10;/ (SUM(IF [Calculation_6037990117218693121]&#13;&#10;    THEN [cancellations_denominator]&#13;&#10;    ELSE 0 END&#13;&#10;    )&#13;&#10;+&#13;&#10;SUM(&#13;&#10;    IF [Calculation_6037990117218693121]&#13;&#10;    THEN [comp_and_refund_denominator]&#13;&#10;    ELSE 0 END&#13;&#10;    )&#13;&#10;+&#13;&#10;SUM(&#13;&#10;    IF [Calculation_6037990117218693121]&#13;&#10;    THEN [change_dropoff_address_denominator]&#13;&#10;    ELSE 0 END&#13;&#10;    ))&#13;&#10;}&#13;&#10;ELSEIF  [Parameters].[Completed Week Parameter]= &apos;Monthly&apos;&#13;&#10;then &#13;&#10;{ EXCLUDE [week]:&#13;&#10;    (SUM(&#13;&#10;    IF [is_max_week (copy)_6037990117221425155]&#13;&#10;    THEN [cancellations_numerator]&#13;&#10;    ELSE 0 END&#13;&#10;    )&#13;&#10;+ &#13;&#10; SUM(&#13;&#10;    IF [is_max_week (copy)_6037990117221425155]&#13;&#10;    THEN [comp_and_refund_numerator]&#13;&#10;    ELSE 0 END&#13;&#10;    )&#13;&#10;+ &#13;&#10; SUM(&#13;&#10;    IF [is_max_week (copy)_6037990117221425155]&#13;&#10;    THEN [change_dropoff_address_numerator]&#13;&#10;    ELSE 0 END&#13;&#10;    ))&#13;&#10;&#13;&#10;/ (SUM(IF [is_max_week (copy)_6037990117221425155]&#13;&#10;    THEN [cancellations_denominator]&#13;&#10;    ELSE 0 END&#13;&#10;    )&#13;&#10;+&#13;&#10;  SUM(&#13;&#10;    IF [is_max_week (copy)_6037990117221425155]&#13;&#10;    THEN [comp_and_refund_denominator]&#13;&#10;    ELSE 0 END&#13;&#10;    )&#13;&#10;+&#13;&#10;  SUM(&#13;&#10;    IF [is_max_week (copy)_6037990117221425155]&#13;&#10;    THEN [change_dropoff_address_denominator]&#13;&#10;    ELSE 0 END&#13;&#10;    ))&#13;&#10;&#13;&#10;}&#13;&#10;end' />
            </column>
            <column aggregation='Attribute' caption='Oneview core actions previous' datatype='real' name='[Calculation_6037990117235109921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Completed Week Parameter] = &apos;Weekly&apos;&#13;&#10;then &#13;&#10;{ EXCLUDE [week]:&#13;&#10;   (SUM(&#13;&#10;    IF [is_max_week (copy)_6037990117221265410]&#13;&#10;    THEN [cancellations_numerator]&#13;&#10;    ELSE 0 END&#13;&#10;    )&#13;&#10;+ &#13;&#10; SUM(&#13;&#10;    IF [is_max_week (copy)_6037990117221265410]&#13;&#10;    THEN [comp_and_refund_numerator]&#13;&#10;    ELSE 0 END&#13;&#10;    )&#13;&#10;+ &#13;&#10; SUM(&#13;&#10;    IF [is_max_week (copy)_6037990117221265410]&#13;&#10;    THEN [change_dropoff_address_numerator]&#13;&#10;    ELSE 0 END&#13;&#10;    ))&#13;&#10;&#13;&#10;/ (SUM(IF [is_max_week (copy)_6037990117221265410]&#13;&#10;    THEN [cancellations_denominator]&#13;&#10;    ELSE 0 END&#13;&#10;    )&#13;&#10;+&#13;&#10;SUM(&#13;&#10;    IF [is_max_week (copy)_6037990117221265410]&#13;&#10;    THEN [comp_and_refund_denominator]&#13;&#10;    ELSE 0 END&#13;&#10;    )&#13;&#10;+&#13;&#10;SUM(&#13;&#10;    IF [is_max_week (copy)_6037990117221265410]&#13;&#10;    THEN [change_dropoff_address_denominator]&#13;&#10;    ELSE 0 END&#13;&#10;    ))&#13;&#10;}&#13;&#10;ELSEIF  [Parameters].[Completed Week Parameter]= &apos;Monthly&apos;&#13;&#10;then &#13;&#10;{ EXCLUDE [week]:&#13;&#10;    (SUM(&#13;&#10;    IF [is_max_week (copy)_6037990117221425155]&#13;&#10;    THEN [cancellations_numerator]&#13;&#10;    ELSE 0 END&#13;&#10;    )&#13;&#10;+ &#13;&#10; SUM(&#13;&#10;    IF [is_max_month (copy)_6037990117221519364]&#13;&#10;    THEN [comp_and_refund_numerator]&#13;&#10;    ELSE 0 END&#13;&#10;    )&#13;&#10;+ &#13;&#10; SUM(&#13;&#10;    IF [is_max_month (copy)_6037990117221519364]&#13;&#10;    THEN [change_dropoff_address_numerator]&#13;&#10;    ELSE 0 END&#13;&#10;    ))&#13;&#10;&#13;&#10;/ (SUM(IF [is_max_month (copy)_6037990117221519364]&#13;&#10;    THEN [cancellations_denominator]&#13;&#10;    ELSE 0 END&#13;&#10;    )&#13;&#10;+&#13;&#10;  SUM(&#13;&#10;    IF [is_max_month (copy)_6037990117221519364]&#13;&#10;    THEN [comp_and_refund_denominator]&#13;&#10;    ELSE 0 END&#13;&#10;    )&#13;&#10;+&#13;&#10;  SUM(&#13;&#10;    IF [is_max_month (copy)_6037990117221519364]&#13;&#10;    THEN [change_dropoff_address_denominator]&#13;&#10;    ELSE 0 END&#13;&#10;    ))&#13;&#10;}&#13;&#10;end' />
            </column>
            <column caption='Oneview core action % Change' datatype='real' default-format='p0.00%' name='[Calculation_6037990117235302434]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_6037990117234872352])&#10;-SUM([Calculation_6037990117235109921]))&#10;/SUM([Calculation_6037990117235109921])' />
            </column>
            <column caption='Oneview core action % Change PP' datatype='real' name='[Calculation_6037990117235363875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_6037990117234872352])&#10;-SUM([Calculation_6037990117235109921]))&#10;*100' />
            </column>
            <column caption=' Oneview core actions Positive % Diff' datatype='string' name='[Calculation_6037990117235671076]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_6037990117235302434]&gt; 0&#10;THEN &quot;▲&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption=' Oneview core actions Negative % Diff ' datatype='string' name='[Calculation_6037990117235765285]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_6037990117235302434] &lt; 0&#10;THEN &quot;▼&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Management Entity ' datatype='string' name='[Management Entity (copy)_5341761744712458263]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[management_entity_group]' />
            </column>
            <column caption='Select Week' datatype='string' datatype-customized='true' name='[Week1 (copy 2)_4649262981741772804]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[week]' />
            </column>
            <column-instance column='[Calculation_1071364175301328899]' derivation='Attribute' name='[attr:Calculation_1071364175301328899:nk]' pivot='key' type='nominal' />
            <column caption='Cancellations Denominator' datatype='integer' name='[cancellations_denominator]' role='measure' type='quantitative' />
            <column caption='Cancellations Numerator' datatype='integer' name='[cancellations_numerator]' role='measure' type='quantitative' />
            <column caption='Change Dropoff Address Denominator' datatype='integer' name='[change_dropoff_address_denominator]' role='measure' type='quantitative' />
            <column caption='Change Dropoff Address Numerator' datatype='integer' name='[change_dropoff_address_numerator]' role='measure' type='quantitative' />
            <column caption='Comp And Refund Denominator' datatype='integer' name='[comp_and_refund_denominator]' role='measure' type='quantitative' />
            <column caption='Comp And Refund Numerator' datatype='integer' name='[comp_and_refund_numerator]' role='measure' type='quantitative' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='is_max_month_minus_one' datatype='boolean' name='[is_max_month (copy)_6037990117221519364]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT [is_max_week (copy)_6037990117221425155]&#10;AND&#10;{FIXED [month]: MAX([week])} = {FIXED [is_max_week (copy)_6037990117221425155]: MAX([week])}' />
            </column>
            <column caption='is_max_week_minus_one' datatype='boolean' name='[is_max_week (copy)_6037990117221265410]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT [Calculation_6037990117218693121]&#10;AND&#10;{FIXED [week]: MAX([week])} = {FIXED [Calculation_6037990117218693121]: MAX([week])}' />
            </column>
            <column caption='is_max_month' datatype='boolean' name='[is_max_week (copy)_6037990117221425155]' role='dimension' type='nominal'>
