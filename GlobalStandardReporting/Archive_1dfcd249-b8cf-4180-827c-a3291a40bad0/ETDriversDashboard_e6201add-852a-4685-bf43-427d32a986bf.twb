    <worksheet name='% of first answers resolved wih special skill'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#1b1b1b' fontsize='10'>&lt;Sheet Name&gt;</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#59a14f' fontsize='10'><![CDATA[<[federated.0gqoovo0dtggoq11xfe5g16gaz4t].[usr:Calculation_6037990117228568591:nk]>]]></run>
            <run fontalignment='1' fontcolor='#e15759' fontsize='10'><![CDATA[<[federated.0gqoovo0dtggoq11xfe5g16gaz4t].[usr:Calculation_6037990117228482574:nk]>]]></run>
            <run fontalignment='1' fontcolor='#000000' fontsize='10'><![CDATA[<[federated.0gqoovo0dtggoq11xfe5g16gaz4t].[usr:Calculation_6037990117228388365:qk]> ]]></run>
            <run bold='false' fontalignment='1' fontcolor='#000000' fontname='Tableau Light' fontsize='8'><![CDATA[change vs Previous <[Parameters].[Completed Week Parameter]>]]></run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Light' fontsize='9'><![CDATA[<[federated.0gqoovo0dtggoq11xfe5g16gaz4t].[usr:Calculation_6037990117228978192:qk]> ]]></run>
            <run fontalignment='1' fontcolor='#555555' fontname='Tableau Light' fontsize='8'>PP</run>
            <run bold='false' fontalignment='1' fontcolor='#555555' fontname='Tableau Light' fontsize='8'>Æ </run>
            <run bold='false' fontalignment='1' fontcolor='#000000' fontname='Tableau Light' fontsize='8'><![CDATA[change vs Previous <[Parameters].[Completed Week Parameter]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='et_drivers' name='federated.0gqoovo0dtggoq11xfe5g16gaz4t' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Granularity Level' datatype='string' name='[Completed Week Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
              <aliases>
                <alias key='&quot;Monthly&quot;' value='Month' />
                <alias key='&quot;Weekly&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gqoovo0dtggoq11xfe5g16gaz4t'>
            <column caption='% of first answers resolved wih special skill previous' datatype='real' name='[% of first answers resolved wih special skill current (copy)_6037990117228273676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Completed Week Parameter] = &apos;Weekly&apos;&#10;then &#10;{ SUM(&#10;    IF [is_max_week (copy)_6037990117221265410]&#10;    THEN [percent_requests_resolved_with_special_skill_numerator]&#10;    ELSE 0 END&#10;    )&#10;&#10;/ SUM(IF [is_max_week (copy)_6037990117221265410]&#10;    THEN [percent_requests_resolved_with_special_skill_denominator]&#10;    ELSE 0 END&#10;    )&#10;}&#10;ELSEIF  [Parameters].[Completed Week Parameter]= &apos;Monthly&apos;&#10;then &#10;{ EXCLUDE [week]:&#10;    SUM(&#10;    IF [is_max_month (copy)_6037990117221519364]&#10;    THEN [percent_requests_resolved_with_special_skill_numerator]&#10;    ELSE 0 END&#10;    )&#10;/&#10; SUM(&#10;    IF [is_max_month (copy)_6037990117221519364]&#10;    THEN [percent_requests_resolved_with_special_skill_denominator]&#10;    ELSE 0 END&#10;    )&#10;}&#10;end' />
            </column>
            <column caption='% of first answers resolved wih special skill' datatype='real' default-format='p0%' name='[Avg. time to answer chat (copy)_4884364919489646601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//--- excludes current and previous day from calculation as orders data is incomplete&#10;SUM([percent_requests_resolved_with_special_skill_numerator])&#10;/&#10;SUM([percent_requests_resolved_with_special_skill_denominator])' />
            </column>
            <column caption='CW Week' datatype='string' name='[Calculation_1071364175301328899]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//STR(&apos;CW &apos; + [Week1])&#10;//STR(&apos;CW &apos; + STR(DATEPART(&apos;week&apos;,[Date])))&#10;STR(&apos;CW &apos; + STR([week]))' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_323625874223710210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Completed Week Parameter]&#10;WHEN &quot;Weekly&quot; THEN [week]&#10;WHEN &quot;Monthly&quot; THEN [month]&#10;END' />
            </column>
            <column caption='is_max_week' datatype='boolean' name='[Calculation_6037990117218693121]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [week]: MAX([week])} = {FIXED: MAX([week])}' />
            </column>
            <column aggregation='Attribute' caption='% of first answers resolved wih special skill current' datatype='real' name='[Calculation_6037990117227597835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Completed Week Parameter] = &apos;Weekly&apos;&#10;then &#10;{EXCLUDE [week]:&#10;    SUM(&#10;    IF [Calculation_6037990117218693121]&#10;    THEN [percent_requests_resolved_with_special_skill_numerator]&#10;    ELSE 0 END&#10;    )&#10;&#10;/ SUM(IF [Calculation_6037990117218693121]&#10;    THEN [percent_requests_resolved_with_special_skill_denominator]&#10;    ELSE 0 END&#10;    )&#10;}&#10;ELSEIF  [Parameters].[Completed Week Parameter]= &apos;Monthly&apos;&#10;then &#10;{ EXCLUDE [week]:&#10;    SUM(&#10;    IF [is_max_week (copy)_6037990117221425155]&#10;    THEN [percent_requests_resolved_with_special_skill_numerator]&#10;    ELSE 0 END&#10;    )&#10;/&#10; SUM(&#10;    IF [is_max_week (copy)_6037990117221425155]&#10;    THEN [percent_requests_resolved_with_special_skill_denominator]&#10;    ELSE 0 END&#10;    )&#10;}&#10;end' />
            </column>
            <column caption='% of first answers resolved wih special skill % change' datatype='real' default-format='p0.00%' name='[Calculation_6037990117228388365]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_6037990117227597835])&#10;-SUM([% of first answers resolved wih special skill current (copy)_6037990117228273676]))&#10;/SUM([% of first answers resolved wih special skill current (copy)_6037990117228273676])' />
            </column>
            <column caption='% of first answers resolved wih special skill negative  % diff ' datatype='string' name='[Calculation_6037990117228482574]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_6037990117228388365] &lt; 0&#10;THEN &quot;▼&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='% of first answers resolved wih special skill positive % diff' datatype='string' name='[Calculation_6037990117228568591]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_6037990117228388365]&gt; 0&#10;THEN &quot;▲&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='% of first answers resolved wih special skill % change pp' datatype='real' name='[Calculation_6037990117228978192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_6037990117227597835])&#10;-SUM([% of first answers resolved wih special skill current (copy)_6037990117228273676]))&#10; * 100' />
            </column>
            <column caption='Select Week' datatype='string' datatype-customized='true' name='[Week1 (copy 2)_4649262981741772804]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[week]' />
            </column>
