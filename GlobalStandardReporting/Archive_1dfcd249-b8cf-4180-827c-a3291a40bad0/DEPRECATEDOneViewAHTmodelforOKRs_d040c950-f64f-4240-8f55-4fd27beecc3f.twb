      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.11znag402guui819satwv0pjq3s4].[max:Targeted all aTHT (ignore dims) (copy)_555350136318947329:qk]&quot;' value=' Targeted aTHT (ignore dims) in time format' />
          <alias key='&quot;[federated.11znag402guui819satwv0pjq3s4].[max:Targeted Avg Total Handling Time Min (copy)_1495195082870087683:qk]&quot;' value=' Targeted aTHT (ignore dims)' />
        </aliases>
      </column>
      <column caption='aTHT (ignore dims)' datatype='real' name='[All THT (copy)_1495195082878373894]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Gen Targeted Avg Total Handling Time Min (copy)_1495195082873303044]&#13;&#10;/&#13;&#10;[test (copy)_1495195082875473925]' />
      </column>
      <column caption='Targeted aTHT (per dim selection)' datatype='real' name='[Avg Total Handling Time Min (copy)_1495195082866884610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Handling Time Min Total (copy)_1495195082864156673]&#13;&#10;-&#13;&#10;[Parameters].[Parameter 1]' />
      </column>
      <column caption='Quarterly Cost Savings for actual aTHT' datatype='real' name='[Calculation_474566824041721856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(1 / [Parameters].[Parameter 2] ) &#13;&#10;* &#13;&#10;([Parameters].[Parameter 2] - [Total Handling Time Min Total (copy)_1495195082864156673] ) &#13;&#10;* ( [Parameters].[Parameter 3] / [Parameters].[Parameter 4]  * 13)' />
      </column>
      <column caption='Estim Quarterly Cost Savings' datatype='real' name='[Calculation_555350136325865476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1/([Total Handling Time Min Total (copy)_1495195082864156673]) //cost per minute of contacts based on current AHT for the impacted CRs&#13;&#10;* [Parameters].[Parameter 1]&#13;&#10;* (SUM([work_item_count]) //## work items impacted&#13;&#10;/COUNTD([assigned_week])*13)' />
      </column>
      <column caption='# weeks' datatype='integer' name='[Calculation_555350136579522565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([assigned_week])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_707628101143773184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='THT (ignore dims)' datatype='real' name='[Gen Targeted Avg Total Handling Time Min (copy)_1495195082873303044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='({ FIXED : SUM([handling_time_min_total])} &#13;&#10;+ { FIXED : SUM([wrap_up_time_min_total])})' />
      </column>
      <column caption='Targeted aTHT (ignore dims)' datatype='real' name='[Targeted Avg Total Handling Time Min (copy)_1495195082870087683]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Gen Targeted Avg Total Handling Time Min (copy)_1495195082873303044]&#13;&#10;- [Parameters].[Parameter 1]* { EXCLUDE [contact_reason_l3],[stakeholder]: SUM([work_item_count])})&#13;&#10;/&#13;&#10;[test (copy)_1495195082875473925]' />
      </column>
      <column caption='Targeted aTHT (per dim selection) in time format' datatype='real' name='[Targeted aTHT (per dim selection) (copy)_555350136319676418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Total Handling Time Min Total (copy)_1495195082864156673]&#13;&#10;-&#13;&#10;[Parameters].[Parameter 1])/(24*60)' />
      </column>
      <column caption='Targeted aTHT (ignore dims) in time format' datatype='real' name='[Targeted all aTHT (ignore dims) (copy)_555350136318947329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([Gen Targeted Avg Total Handling Time Min (copy)_1495195082873303044]&#13;&#10;- [Parameters].[Parameter 1]* { EXCLUDE [contact_reason_l3],[stakeholder]: SUM([work_item_count])})&#13;&#10;/&#13;&#10;[test (copy)_1495195082875473925])/(24*60)' />
      </column>
      <column caption='aTHT (per dim selection)' datatype='real' name='[Total Handling Time Min Total (copy)_1495195082864156673]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([handling_time_min_total]) + SUM([wrap_up_time_min_total]))&#13;&#10;/&#13;&#10;SUM([work_item_count])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='oneview_aht_model_for_okr' datatype='table' hidden='true' name='[__tableau_internal_object_id__].[oneview_aht_model_for_okr_527AAB7C41834C2D9C45DAA0BAF2B894]' role='measure' type='quantitative' />
      <_.fcp.ObjectModelTableType.true...column caption='oneview_aht_model_for_okr1' datatype='table' name='[__tableau_internal_object_id__].[oneview_aht_model_for_okr_638E84581E3242E5BB91C66C348C0BB7]' role='measure' type='quantitative' />
      <column caption='aTHT (ignore dims but week) in time format' datatype='real' name='[aTHT (ignore dims) in time format (copy)_474566824044773379]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([all aTHT (ignore dims) (copy)_1495195083181019145])/(24*60)' />
      </column>
      <column caption='aTHT (per dim selection) in time format' datatype='real' name='[aTHT (per dim selection) (copy)_555350136320491523]' role='measure' type='quantitative'>
