    <worksheet name='definition cost estim'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='10'>Estim Quarterly Cost Savings</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10' italic='true'>Given</run>
            <run fontcolor='#000000' fontsize='10'>: Cost of work item = 1 Euro</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>Cost per min</run>
            <run fontcolor='#000000' fontsize='10'> = 1 Euro / aTHT (per dim selection) </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10'>Æ </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>Estimated Quarterly Cost Savings</run>
            <run fontcolor='#000000' fontsize='10'> = Cost per min * AHT Improvement * (avg # work items (per dim selection)</run>
            <run fontcolor='#000000' fontsize='10' italic='true' underline='true'> per week</run>
            <run fontcolor='#000000' fontsize='10'> * 13 )</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10'><![CDATA[<[federated.11znag402guui819satwv0pjq3s4].[usr:Calculation_555350136325865476:qk]> ]]></run>
            <run fontcolor='#000000' fontsize='10'>= (1 Euro / </run>
            <run fontsize='10'><![CDATA[<[federated.11znag402guui819satwv0pjq3s4].[usr:Total Handling Time Min Total (copy)_1495195082864156673:qk]>]]></run>
            <run fontcolor='#000000' fontsize='10'><![CDATA[) *  <[Parameters].[Parameter 1]> * ( <[federated.11znag402guui819satwv0pjq3s4].[sum:work_item_count:qk]> / <[federated.11znag402guui819satwv0pjq3s4].[usr:Calculation_555350136579522565:qk]>  * 13)]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='oneview_aht_model_for_okr (rl)' name='federated.11znag402guui819satwv0pjq3s4' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='AHT Improvement min' datatype='real' default-format='n#,##0.00&quot; min&quot;;-#,##0.00&quot; min&quot;' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='1.'>
              <calculation class='tableau' formula='1.' />
              <range granularity='0.1' max='10.0' min='0.1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.11znag402guui819satwv0pjq3s4'>
            <column caption='Estim Quarterly Cost Savings' datatype='real' name='[Calculation_555350136325865476]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1/([Total Handling Time Min Total (copy)_1495195082864156673]) //cost per minute of contacts based on current AHT for the impacted CRs&#13;&#10;* [Parameters].[Parameter 1]&#13;&#10;* (SUM([work_item_count]) //## work items impacted&#13;&#10;/COUNTD([assigned_week])*13)' />
            </column>
            <column caption='# weeks' datatype='integer' name='[Calculation_555350136579522565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([assigned_week])' />
            </column>
            <column caption='aTHT (per dim selection)' datatype='real' name='[Total Handling Time Min Total (copy)_1495195082864156673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([handling_time_min_total]) + SUM([wrap_up_time_min_total]))&#13;&#10;/&#13;&#10;SUM([work_item_count])' />
            </column>
            <column caption='Agent Facing Tool' datatype='string' name='[agent_facing_tool]' role='dimension' type='nominal' />
            <column caption='Assigned Date' datatype='date' name='[assigned_date]' role='dimension' type='ordinal' />
