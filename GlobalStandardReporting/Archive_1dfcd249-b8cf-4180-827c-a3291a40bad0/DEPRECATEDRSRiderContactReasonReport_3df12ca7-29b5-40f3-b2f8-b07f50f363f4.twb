      <column caption='Chat AHT (m)' datatype='real' name='[Calculation_1194016888929374213]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Handling Time (copy)_1194016888929615878])/SUM([Resolved Cases (copy)_1194016888930238471])/60' />
