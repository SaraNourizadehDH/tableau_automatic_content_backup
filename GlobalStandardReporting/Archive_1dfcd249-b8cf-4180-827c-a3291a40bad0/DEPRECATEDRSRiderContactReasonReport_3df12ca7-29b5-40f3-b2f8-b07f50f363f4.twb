    <worksheet name='RCR Performance'>
      <layout-options>
        <caption>
          <formatted-text>
            <run>The list of rider contact reason can be found on this link : </run>
            <run auto-url='true' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/spreadsheets/d/1Ow37fFOk7UGWH4JO2fj9jkQg6TcHuAlaB55XnNICnNM/edit#gid=1434631233.&amp;quot;'>https://docs.google.com/spreadsheets/d/1Ow37fFOk7UGWH4JO2fj9jkQg6TcHuAlaB55XnNICnNM/edit#gid=1434631233.</run>
            <run> 
Some RCR may be new or removed, thus appearing blank for certain timeframes.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rider_contact_reason_report' name='federated.0000m2s18r1iy9193dttr0z5ky8p' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Chose Dimension (D/W/M)' datatype='string' name='[Chose Dimension (Columns) (copy)_526358231437660160]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
              <aliases>
                <alias key='&quot;Date&quot;' value='Daily' />
                <alias key='&quot;Month&quot;' value='Monthly' />
                <alias key='&quot;Week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0000m2s18r1iy9193dttr0z5ky8p'>
            <column caption='Chat AHT (m)' datatype='real' name='[Calculation_1194016888929374213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Handling Time (copy)_1194016888929615878])/60/ SUM([Calculation_958422319232569345]))' />
            </column>
            <column caption='Avg. Full Resolution Time (m)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1515179817555480578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_958422319248875523]) / SUM([Calculation_958422319232569345]) /60' />
            </column>
            <column caption='Flag Null RCR' datatype='boolean' name='[Calculation_164240697377370113]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ISNULL([category]) OR [category]=&apos;Unknown&apos;' />
            </column>
            <column caption='Sub Category' datatype='string' name='[Calculation_2743255146905026561]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[category] + &apos;-&apos; +  [sub_category]' />
            </column>
            <column caption='CSAT (%)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_338121849629618177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_rcsat_4_5])/SUM([count_rcsat_responses]) *100' />
            </column>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_4191092097107337216]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username] = USERNAME()' />
            </column>
            <column caption='QA Score' datatype='real' name='[Calculation_5733786016161800192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([score_avg])&#10;/&#10;SUM([evaluations])' />
            </column>
            <column caption='FCR (%)' datatype='real' default-format='*0.00%' name='[Calculation_5733786016161947649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_first_contact_resolution])&#10;/&#10;SUM([count_contacts_related_to_order])' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_581245852810321921]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF[Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Month&apos; THEN STR([month])&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Week&apos; THEN STR([week])&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Date&apos; THEN STR([report_date])&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Country&apos; THEN [country]&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Contact Center&apos; THEN STR([dispatch_center])&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;DH Regions&apos; THEN STR([GCC Regions (copy)_2633761390312833027])&#13;&#10;END' />
            </column>
            <column caption='Served Chats' datatype='integer' name='[Calculation_958422319232569345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[incoming_chat_ind]-[missed_chat_ind]' />
            </column>
            <column caption='Chats Full Resolution Time' datatype='real' name='[Calculation_958422319248875523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Handling Time (copy)_1194016888929615878],0)+ IFNULL([queue_time],0)' />
            </column>
            <column caption='DH Region' datatype='string' name='[GCC Regions (copy)_2633761390312833027]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[dh_region]' />
            </column>
            <column caption='Chat Handling Time' datatype='real' name='[Handling Time (copy)_1194016888929615878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([handling_time],0)' />
            </column>
