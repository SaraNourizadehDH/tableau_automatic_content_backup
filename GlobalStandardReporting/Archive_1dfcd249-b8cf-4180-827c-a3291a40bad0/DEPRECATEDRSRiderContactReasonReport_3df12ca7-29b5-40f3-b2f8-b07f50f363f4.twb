    <worksheet name='RCR on Agent Level'>
      <layout-options>
        <caption>
          <formatted-text>
            <run>The list of rider contact reason can be found on this link : </run>
            <run auto-url='true' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/spreadsheets/d/1Ow37fFOk7UGWH4JO2fj9jkQg6TcHuAlaB55XnNICnNM/edit#gid=1434631233.&amp;quot;'>https://docs.google.com/spreadsheets/d/1Ow37fFOk7UGWH4JO2fj9jkQg6TcHuAlaB55XnNICnNM/edit#gid=1434631233.</run>
            <run> 
Some RCR may be new or removed, thus appearing blank for certain timeframes.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rider_contact_reason_agent_report' name='federated.15ybwr81stl5bw12g5iy41syqyl6' />
            <datasource name='Parameters' />
            <datasource caption='rider_contact_reason_report' name='federated.0000m2s18r1iy9193dttr0z5ky8p' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Chose Dimension (D/W/M)' datatype='string' name='[Chose Dimension (Columns) (copy)_526358231437660160]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
              <aliases>
                <alias key='&quot;Date&quot;' value='Daily' />
                <alias key='&quot;Month&quot;' value='Monthly' />
                <alias key='&quot;Week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='KPIs (Agents)' datatype='string' name='[KPIs (copy)_1264385618995630081]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Served Chats&quot;'>
              <calculation class='tableau' formula='&quot;# Served Chats&quot;' />
              <aliases>
                <alias key='&quot;Avg. Full Resolution Time&quot;' value='Avg. Full Resolution Time (m)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0000m2s18r1iy9193dttr0z5ky8p'>
            <column caption='Date Range' datatype='date' name='[report_date (copy)_164240697374330880]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15ybwr81stl5bw12g5iy41syqyl6'>
            <column caption='Chat AHT (m)' datatype='real' name='[Calculation_1194016888929374213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Handling Time (copy)_1194016888929615878])/SUM([Resolved Cases (copy)_1194016888930238471])/60' />
            </column>
            <column caption='Avg. Full Resolution Time (m)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1515179817555480578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_958422319248875523]) / SUM([Resolved Cases (copy)_1194016888930238471])/60' />
            </column>
            <column caption='KPIs' datatype='real' name='[Calculation_201254636165591040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF   [Parameters].[KPIs (copy)_1264385618995630081]=&apos;# Served Chats&apos; THEN sum([Resolved Cases (copy)_1194016888930238471])&#10;ELSEIF  [Parameters].[KPIs (copy)_1264385618995630081]=&apos;Chat AHT (m)&apos; THEN ROUND([Calculation_1194016888929374213],1)&#13;&#10;ELSEIF  [Parameters].[KPIs (copy)_1264385618995630081]=&apos;Avg. Full Resolution Time&apos; THEN ROUND([Calculation_1515179817555480578],1)&#10;ELSEIF  [Parameters].[KPIs (copy)_1264385618995630081]=&apos;CSAT (%)&apos; THEN ROUND([Calculation_338121849628798976],0)&#13;&#10;END' />
            </column>
            <column caption='CSAT (%)' datatype='real' name='[Calculation_338121849628798976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_rcsat_4_5]) / SUM([count_rcsat_responses]) *100' />
            </column>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_4191092097112576001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username] = USERNAME()' />
            </column>
            <column caption='Choosen Dimension' datatype='string' name='[Calculation_581245852810321921]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF[Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Month&apos; THEN STR([month])&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Week&apos; THEN STR([week])&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Date&apos; THEN STR([report_date])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Chat Full Resolution Time' datatype='real' name='[Calculation_958422319248875523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([queue_time],0)+IFNULL([handling_time],0)' />
            </column>
            <column caption='DH Region' datatype='string' name='[GCC Regions (copy)_2633761390310883329]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[dh_region]' />
            </column>
            <column caption='Chat Handling Time (s)' datatype='real' name='[Handling Time (copy)_1194016888929615878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([handling_time],0)' />
            </column>
            <column caption='Served Chats' datatype='integer' name='[Resolved Cases (copy)_1194016888930238471]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[incoming_chat_ind]-[missed_chat_ind]' />
            </column>
            <column caption='BPO' datatype='string' name='[bpo]' role='dimension' type='nominal' />
            <column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' />
            <column caption='Count Rcsat 4 5' datatype='integer' name='[count_rcsat_4_5]' role='measure' type='quantitative' />
