            <column caption='Dh Region' datatype='string' name='[dh_region]' role='dimension' type='nominal' />
            <column caption='Dispatch Center' datatype='string' name='[dispatch_center]' role='dimension' type='nominal' />
            <column caption='Email' datatype='string' name='[email]' role='dimension' type='nominal' />
