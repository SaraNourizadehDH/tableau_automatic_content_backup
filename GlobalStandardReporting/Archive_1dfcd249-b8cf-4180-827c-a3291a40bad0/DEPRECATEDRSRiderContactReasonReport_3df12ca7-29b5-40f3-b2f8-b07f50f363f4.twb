            <column caption='Incoming Chat Ind' datatype='integer' name='[incoming_chat_ind]' role='measure' type='quantitative' />
            <column caption='Management Entity' datatype='string' name='[management_entity_group]' role='dimension' type='nominal' />
            <column caption='Missed Chat Ind' datatype='integer' name='[missed_chat_ind]' role='measure' type='quantitative' />
            <column caption='Month' datatype='string' name='[month]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_164240697377370113]' derivation='None' name='[none:Calculation_164240697377370113:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2743255146905026561]' derivation='None' name='[none:Calculation_2743255146905026561:nk]' pivot='key' type='nominal' />
