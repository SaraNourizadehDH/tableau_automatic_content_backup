            <column-instance column='[GCC Regions (copy)_2633761390312833027]' derivation='None' name='[none:GCC Regions (copy)_2633761390312833027:nk]' pivot='key' type='nominal' />
            <column-instance column='[brand]' derivation='None' name='[none:brand:nk]' pivot='key' type='nominal' />
