    <worksheet name='RCR Category Evolution'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='11'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rider_contact_reason_report' name='federated.0000m2s18r1iy9193dttr0z5ky8p' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Chose Dimension (D/W/M)' datatype='string' name='[Chose Dimension (Columns) (copy)_526358231437660160]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
              <aliases>
                <alias key='&quot;Date&quot;' value='Daily' />
                <alias key='&quot;Month&quot;' value='Monthly' />
                <alias key='&quot;Week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='KPIs Graphs Evolution 1' datatype='string' datatype-customized='true' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Incoming Chats&quot;'>
              <calculation class='tableau' formula='&quot;# Incoming Chats&quot;' />
              <aliases>
                <alias key='&quot;\% Incoming Chats per order&quot;' value='% Incoming Chats per order' />
                <alias key='&quot;\% Served Chats per order&quot;' value='% Served Chats per order' />
                <alias key='&quot;Chats AHT (m)&quot;' value='Chats AHT (m)' />
                <alias key='&quot;CSAT (\%)&quot;' value='CSAT (%)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0000m2s18r1iy9193dttr0z5ky8p'>
            <column caption='Chat AHT (m)' datatype='real' name='[Calculation_1194016888929374213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Handling Time (copy)_1194016888929615878])/60/ SUM([Calculation_958422319232569345]))' />
            </column>
            <column caption='Od orders fixed at iso date_country' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1252000751479169032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE [category], [sub_category]:&#10;&#9;SUM( { FIXED [start_time], [report_date],[global_entity_id] : MAX([od_orders]) }) &#10;}' />
            </column>
            <column caption='Flag Null RCR' datatype='boolean' name='[Calculation_164240697377370113]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ISNULL([category]) OR [category]=&apos;Unknown&apos;' />
            </column>
            <column caption='Sub Category' datatype='string' name='[Calculation_2743255146905026561]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[category] + &apos;-&apos; +  [sub_category]' />
            </column>
            <column caption='CSAT (%)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_338121849629618177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_rcsat_4_5])/SUM([count_rcsat_responses]) *100' />
            </column>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_4191092097107337216]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username] = USERNAME()' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_581245852810321921]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF[Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Month&apos; THEN STR([month])&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Week&apos; THEN STR([week])&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Date&apos; THEN STR([report_date])&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Country&apos; THEN [country]&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Contact Center&apos; THEN STR([dispatch_center])&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;DH Regions&apos; THEN STR([GCC Regions (copy)_2633761390312833027])&#13;&#10;END' />
            </column>
            <column caption='KPIs Graphs 1' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_735212659243257856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 5]=&apos;# Incoming Chats&apos; then ROUND(SUM([incoming_chat_ind]),2)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;% Incoming Chats&apos; then ROUND(SUM([incoming_chat_ind]) / TOTAL(SUM([incoming_chat_ind]))*100,1)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;# Served Chats&apos; then round(sum([Calculation_958422319232569345]),2)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;% Served Chats&apos; then ROUND(SUM([Calculation_958422319232569345]) / TOTAL(SUM([Calculation_958422319232569345]))*100,1)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;% Incoming Chats per order&apos; then ROUND([Cases per order (copy)_552535426687778822],1)&#13;&#10;ELSEIF [Parameters].[Parameter 5]=&apos;% Served Chats per order&apos; then ROUND([Cases per order (copy) (copy)_552535426687787015],1)&#10;ELSEIF [Parameters].[Parameter 5]=&apos;CSAT (%)&apos; then ROUND([Calculation_338121849629618177],2)&#10;ELSEIF [Parameters].[Parameter 5]=&apos;Chats AHT (m)&apos; then ROUND([Calculation_1194016888929374213],1)&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Served Chats' datatype='integer' name='[Calculation_958422319232569345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[incoming_chat_ind]-[missed_chat_ind]' />
            </column>
            <column caption='Served Chats per order (%)' datatype='real' default-format='n#,##0.0000;-#,##0.0000' name='[Cases per order (copy) (copy)_552535426687787015]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_958422319232569345])/SUM([Calculation_1252000751479169032]))*100' />
            </column>
            <column caption='Incoming Chats per order (%)' datatype='real' default-format='p0.000000%' name='[Cases per order (copy)_552535426687778822]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([incoming_chat_ind])/SUM([Calculation_1252000751479169032]))*100' />
            </column>
            <column caption='DH Region' datatype='string' name='[GCC Regions (copy)_2633761390312833027]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[dh_region]' />
            </column>
            <column caption='Chat Handling Time' datatype='real' name='[Handling Time (copy)_1194016888929615878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([handling_time],0)' />
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' />
            <column caption='Count Rcsat 4 5' datatype='integer' name='[count_rcsat_4_5]' role='measure' type='quantitative' />
            <column caption='# CSAT Responses' datatype='integer' name='[count_rcsat_responses]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Dh Region' datatype='string' name='[dh_region]' role='dimension' type='nominal' />
            <column caption='Dispatch Center' datatype='string' name='[dispatch_center]' role='dimension' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Freshchat Group' datatype='string' name='[group_name]' role='dimension' type='nominal' />
            <column caption='Handling Time' datatype='real' name='[handling_time]' role='measure' type='quantitative' />
            <column caption='Incoming Chat Ind' datatype='integer' name='[incoming_chat_ind]' role='measure' type='quantitative' />
