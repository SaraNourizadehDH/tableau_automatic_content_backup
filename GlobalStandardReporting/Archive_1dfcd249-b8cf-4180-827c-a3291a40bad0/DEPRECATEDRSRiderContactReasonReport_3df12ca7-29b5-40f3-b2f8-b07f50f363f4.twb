      <column caption='KPIs' datatype='real' name='[Calculation_201254636165591040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF   [Parameters].[KPIs (copy)_1264385618995630081]=&apos;# Served Chats&apos; THEN sum([Resolved Cases (copy)_1194016888930238471])&#10;ELSEIF  [Parameters].[KPIs (copy)_1264385618995630081]=&apos;Chat AHT (m)&apos; THEN ROUND([Calculation_1194016888929374213],1)&#13;&#10;ELSEIF  [Parameters].[KPIs (copy)_1264385618995630081]=&apos;Avg. Full Resolution Time&apos; THEN ROUND([Calculation_1515179817555480578],1)&#10;ELSEIF  [Parameters].[KPIs (copy)_1264385618995630081]=&apos;CSAT (%)&apos; THEN ROUND([Calculation_338121849628798976],0)&#13;&#10;END' />
      </column>
      <column caption='CSAT (%)' datatype='real' name='[Calculation_338121849628798976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_rcsat_4_5]) / SUM([count_rcsat_responses]) *100' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_4191092097112576001]' role='dimension' type='nominal'>
