        <calculation class='tableau' formula='IF [Parameters].[KPIs (copy)_5013632330121199618] = &apos;# Incoming Chats&apos; THEN SUM([Calculation_5013632330122424324])&#10;ELSEIF [Parameters].[KPIs (copy)_5013632330121199618] = &apos;# Served Chats&apos; THEN SUM([Resolved Cases (copy)_1194016888930238471])&#10;ELSEIF [Parameters].[KPIs (copy)_5013632330121199618] = &apos;Chat AHT (m)&apos; THEN [Calculation_1194016888929374213]&#10;END' />
