          <datasource-dependencies datasource='federated.15ybwr81stl5bw12g5iy41syqyl6'>
            <column caption='Chat AHT (m)' datatype='real' name='[Calculation_1194016888929374213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Handling Time (copy)_1194016888929615878])/SUM([Resolved Cases (copy)_1194016888930238471])/60' />
            </column>
            <column caption='Avg. Full Resolution Time (m)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1515179817555480578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_958422319248875523]) / SUM([Resolved Cases (copy)_1194016888930238471])/60' />
            </column>
            <column caption='KPIs' datatype='real' name='[Calculation_201254636165591040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF   [Parameters].[KPIs (copy)_1264385618995630081]=&apos;# Served Chats&apos; THEN sum([Resolved Cases (copy)_1194016888930238471])&#10;ELSEIF  [Parameters].[KPIs (copy)_1264385618995630081]=&apos;Chat AHT (m)&apos; THEN ROUND([Calculation_1194016888929374213],1)&#13;&#10;ELSEIF  [Parameters].[KPIs (copy)_1264385618995630081]=&apos;Avg. Full Resolution Time&apos; THEN ROUND([Calculation_1515179817555480578],1)&#10;ELSEIF  [Parameters].[KPIs (copy)_1264385618995630081]=&apos;CSAT (%)&apos; THEN ROUND([Calculation_338121849628798976],0)&#13;&#10;END' />
            </column>
            <column caption='CSAT (%)' datatype='real' name='[Calculation_338121849628798976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_rcsat_4_5]) / SUM([count_rcsat_responses]) *100' />
            </column>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_4191092097112576001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username] = USERNAME()' />
            </column>
            <column caption='Choosen Dimension' datatype='string' name='[Calculation_581245852810321921]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF[Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Month&apos; THEN STR([month])&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Week&apos; THEN STR([week])&#13;&#10;ELSEIF [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]=&apos;Date&apos; THEN STR([report_date])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Chat Full Resolution Time' datatype='real' name='[Calculation_958422319248875523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([queue_time],0)+IFNULL([handling_time],0)' />
