    <worksheet name='Trend_CCR'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='11'>CCR 1</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='HC Product RL' name='federated.10wzubq0o0tcwh1cjmbyo1vmy6qv' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Contact rate (HC)&quot;'>
              <calculation class='tableau' formula='&quot;Contact rate (HC)&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.10wzubq0o0tcwh1cjmbyo1vmy6qv'>
            <column caption='Deflection Rate _ denom' datatype='integer' default-format='p0.0%' name='[Automation Rate _ denom (copy)_663999527789305866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[sessions]' />
            </column>
            <column caption='SSF CSAT RR _ denom' datatype='integer' default-format='p0.0%' name='[Automation Rate _ denom (copy)_663999527789801485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [session_type]&#13;&#10;WHEN &apos;Contacted&apos; THEN 0&#13;&#10;ELSE [sessions] END' />
            </column>
            <column caption='Deflection Rate _ enum' datatype='integer' default-format='p0.0%' name='[Automation Rate _ enum (copy)_663999527789305867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [session_type] WHEN &apos;Deflected&apos; THEN [sessions] ELSE 0 END' />
            </column>
            <column caption='SSF CSAT RR _ enum' datatype='integer' default-format='p0.0%' name='[Automation Rate _ enum (copy)_663999527789801486]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[self_service_csat_responses]' />
            </column>
            <column caption='Metric' datatype='real' default-format='p0.0%' name='[Calculation_195906614563823616]' role='measure' type='quantitative'>
