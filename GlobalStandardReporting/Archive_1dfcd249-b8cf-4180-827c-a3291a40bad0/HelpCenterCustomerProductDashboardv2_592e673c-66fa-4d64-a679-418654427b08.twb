      <column caption='filter out unwanted sessions' datatype='boolean' name='[Calculation_600175022247292928]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [session_type] IN (&apos;Automated&apos; , &apos;Contacted&apos;) and [session_segmentation_l2] = &apos;Visited Order Detail Page&apos;&#10;then FALSE&#10;ELSE TRUE end' />
