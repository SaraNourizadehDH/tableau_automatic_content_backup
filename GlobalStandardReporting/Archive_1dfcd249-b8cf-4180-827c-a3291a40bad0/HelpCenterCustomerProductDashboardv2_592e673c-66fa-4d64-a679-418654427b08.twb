            </column>
            <column caption='Metric _ enum' datatype='integer' name='[Metric (copy)_1201898193785700361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF     [Parameters].[Parameter 2] = &apos;Contact rate (HC)&apos;       THEN [Contact rate (copy)_1201898193761247234]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;SSF CSAT&apos;                THEN [Contact rate _ enum (copy)_1201898193784451078]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Automation Rate&apos;         THEN [Contact rate _ enum (copy)_663999527782334471]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Multi Contact Rate (HC)&apos; THEN [Contact rate _ enum (copy)_663999527779602432]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Multi Leaf Visit Rate&apos;   THEN [Multi Contact Rate (HC) _ enum (copy)_663999527780782085]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Sessions&apos;                THEN [sessions]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Leaf Rating&apos;             THEN [Leaf Rating RR _ enum (copy)_663999527790764052]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Leaf Rating RR&apos;          THEN [SSF CSAT RR _ enum (copy)_663999527790415889]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;SSF CSAT RR&apos;             THEN [Automation Rate _ enum (copy)_663999527789801486]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Deflection Rate&apos;         THEN [Automation Rate _ enum (copy)_663999527789305867]&#13;&#10;END' />
            </column>
            <column caption='Metric _ denom' datatype='integer' name='[Metric _ enum (copy)_1201898193785851914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF     [Parameters].[Parameter 2] = &apos;Contact rate (HC)&apos;       THEN [Contact rate (copy)_1201898193761353731]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;SSF CSAT&apos;                THEN [Contact rate _ denom (copy)_1201898193784578055]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Automation Rate&apos;         THEN [Contact rate _ denom (copy)_663999527782334472]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Multi Contact Rate (HC)&apos; THEN [Contact rate _ denom (copy)_663999527779655681]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Multi Leaf Visit Rate&apos;   THEN [Multi Contact Rate (HC) _ denom (copy)_663999527780782084]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Sessions&apos;                THEN NULL&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Leaf Rating&apos;             THEN [Leaf Rating RR _ denom (copy)_663999527790764051]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Leaf Rating RR&apos;          THEN [SSF CSAT RR _ denom (copy)_663999527790415888]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;SSF CSAT RR&apos;             THEN [Automation Rate _ denom (copy)_663999527789801485]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Deflection Rate&apos;         THEN [Automation Rate _ denom (copy)_663999527789305866]&#13;&#10;END' />
            </column>
            <column caption='Multi Leaf Visit Rate _ denom' datatype='integer' default-format='p0.0%' name='[Multi Contact Rate (HC) _ denom (copy)_663999527780782084]' role='measure' type='quantitative'>
