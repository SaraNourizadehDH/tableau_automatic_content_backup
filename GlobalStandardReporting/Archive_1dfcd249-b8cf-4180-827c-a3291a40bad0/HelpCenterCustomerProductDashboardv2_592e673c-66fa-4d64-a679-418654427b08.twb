        <calculation class='tableau' formula='IF     [Parameters].[Parameter 3] = &apos;Total&apos;                       THEN  &apos;Total&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Management Entity&apos;           THEN [management_entity]&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Country&apos;                     THEN [country]&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;CCR 1&apos;                       THEN [ccr1]&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;CCR 2&apos;                       THEN [ccr2]&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;CCR 3&apos;                       THEN [ccr3]&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Order status&apos;                THEN [order_status]&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Session type&apos;                THEN [session_type]&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Minutes since promised time&apos; THEN [minutes_since_promised_time]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Session Segmentation L1&apos;     THEN [session_segmentation_l1]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Session Experience L1&apos;       THEN [session_experience_l1]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Session Experience L2&apos;       THEN [session_experience_l2]&#13;&#10;END' />
