            <column caption='SSF CSAT RR _ denom' datatype='integer' default-format='p0.0%' name='[Automation Rate _ denom (copy)_663999527789801485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [session_type]&#13;&#10;WHEN &apos;Contacted&apos; THEN 0&#13;&#10;ELSE [sessions] END' />
