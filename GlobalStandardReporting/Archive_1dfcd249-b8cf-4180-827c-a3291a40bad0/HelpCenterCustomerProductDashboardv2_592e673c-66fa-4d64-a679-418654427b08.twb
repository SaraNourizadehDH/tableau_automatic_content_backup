      </column>
      <column caption='SSF CSAT RR _ denom' datatype='integer' default-format='p0.0%' name='[Automation Rate _ denom (copy)_663999527789801485]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [session_type]&#13;&#10;WHEN &apos;Contacted&apos; THEN 0&#13;&#10;ELSE [sessions] END' />
      </column>
      <column caption='Self Service Rate _ enum' datatype='integer' default-format='p0.0%' name='[Automation Rate _ enum (copy)_1182194947786014721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [session_type] = &apos;Automated&apos; OR [session_type] = &apos;Deflected&apos;&#13;&#10;THEN [sessions] ELSE 0 END' />
