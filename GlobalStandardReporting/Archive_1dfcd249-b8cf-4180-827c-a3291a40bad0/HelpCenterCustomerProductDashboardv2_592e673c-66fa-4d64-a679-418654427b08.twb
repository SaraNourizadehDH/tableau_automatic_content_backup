      <column caption='Deflection Rate' datatype='real' default-format='p0.0%' name='[Automation Rate (copy)_663999527789305865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Automation Rate _ enum (copy)_663999527789305867])&#13;&#10;/&#13;&#10;SUM([Automation Rate _ denom (copy)_663999527789305866])' />
      </column>
      <column caption='SSF CSAT RR' datatype='real' default-format='p0.0%' name='[Automation Rate (copy)_663999527789801484]' role='measure' type='quantitative'>
