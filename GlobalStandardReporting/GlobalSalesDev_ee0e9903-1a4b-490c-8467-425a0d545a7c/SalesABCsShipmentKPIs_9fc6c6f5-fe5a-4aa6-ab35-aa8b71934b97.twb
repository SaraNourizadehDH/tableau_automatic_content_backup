    <worksheet name='CR - Table - vs targets'>
      <table>
        <view>
          <datasources>
            <datasource caption='dm_sales_abcs+ (sales_reports)' name='federated.0ndn1n31xl41tk16pdejc0xs2yuj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='OPEN MONTH PARAMETER' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Include current month&quot;'>
              <calculation class='tableau' formula='&quot;Include current month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ndn1n31xl41tk16pdejc0xs2yuj'>
            <column caption='MAX(0.50)' datatype='real' name='[Calculation_1127940640177840135]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(0.50)' />
            </column>
            <column caption='Kpi Name Final' datatype='string' name='[Calculation_2335116459507298304]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([kpi_name_desc],[kpi_name])' />
            </column>
            <column caption='Filter Current Month from base' datatype='boolean' name='[Calculation_5425219113317609473]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ([Parameters].[Parameter 2] = &apos;Only closed months&apos; AND [month_periods] = 0)' />
            </column>
            <column caption='Filter Only Current Quarter' datatype='boolean' name='[Filter Current Month from base (copy)_5425219113327185923]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([Parameters].[Parameter 2] = &apos;Only closed months&apos; AND [quarter_periods_closed_months] = 0)&#10;OR&#10;([Parameters].[Parameter 2] = &apos;Include current month&apos; AND [quarter_periods] = 0)' />
