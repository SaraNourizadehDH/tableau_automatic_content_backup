          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='OPEN MONTH PARAMETER' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Include current month&quot;'>
              <calculation class='tableau' formula='&quot;Include current month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ndn1n31xl41tk16pdejc0xs2yuj'>
            <column caption='Floor Compliance' datatype='real' default-format='p0.0%' name='[CR % - New Vendors (copy)_2301620934263185409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [kpi_id] = &apos;CR_ID_001&apos; and [kpi_calculation] = &apos;sum_1_div_sum_2_perc&apos; then [kpi_1] end) &#10;/ &#10;SUM(if [kpi_id] = &apos;CR_ID_001&apos; and [kpi_calculation] = &apos;sum_1_div_sum_2_perc&apos; then [kpi_2] end)' />
            </column>
            <column caption='max(1)' datatype='integer' name='[Calculation_2215278479260884994]' role='measure' type='quantitative' user:unnamed='Sheet 16'>
              <calculation class='tableau' formula='max(1)' />
            </column>
            <column caption='max(1)' datatype='integer' name='[Calculation_2215278479260913668]' role='measure' type='quantitative' user:unnamed='Sheet 16'>
              <calculation class='tableau' formula='max(1)' />
            </column>
            <column caption='AB - New Online % - Complement' datatype='real' name='[Calculation_2215278479264841734]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-[Key account gap (copy)_5425219113602387990]' />
            </column>
            <column caption='Filter Current Month from base' datatype='boolean' name='[Calculation_5425219113317609473]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ([Parameters].[Parameter 2] = &apos;Only closed months&apos; AND [month_periods] = 0)' />
            </column>
            <column caption='Capex Recovery - Complement' datatype='real' default-format='p0.0%' name='[Capex Recovery (copy)_2301620934282190855]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - [Floor Compliance (copy)_2301620934282100742]' />
            </column>
            <column caption='Filter Only Current Month' datatype='boolean' name='[Filter Current Month from base (copy)_5425219113326223362]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([Parameters].[Parameter 2] = &apos;Only closed months&apos; AND [month_periods] = -1)&#10;OR&#10;([Parameters].[Parameter 2] = &apos;Include current month&apos; AND [month_periods] = 0)' />
            </column>
            <column caption='Capex Recovery' datatype='real' default-format='p0.0%' name='[Floor Compliance (copy)_2301620934282100742]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [kpi_id] = &apos;CR_ID_007&apos; and [kpi_calculation] = &apos;sum_1_div_sum_2_perc&apos; then [kpi_1] end) &#10;/ &#10;SUM(if [kpi_id] = &apos;CR_ID_007&apos; and [kpi_calculation] = &apos;sum_1_div_sum_2_perc&apos; then [kpi_2] end)' />
            </column>
            <column caption='AB - New Online %' datatype='real' default-format='p0.0%' name='[Key account gap (copy)_5425219113602387990]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [kpi_id] = &apos;DS_ID_007&apos; and [kpi_calculation] = &apos;sum_1_div_sum_2_perc&apos; then [kpi_1] end) &#10;/ &#10;SUM(if [kpi_id] = &apos;DS_ID_007&apos; and [kpi_calculation] = &apos;sum_1_div_sum_2_perc&apos; then [kpi_2] end)' />
