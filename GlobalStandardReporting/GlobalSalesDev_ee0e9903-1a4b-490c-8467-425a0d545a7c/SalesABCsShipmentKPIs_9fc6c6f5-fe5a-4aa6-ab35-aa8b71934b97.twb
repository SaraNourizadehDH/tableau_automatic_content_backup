            <column-instance column='[kpi_order]' derivation='Sum' name='[sum:kpi_order:qk]' pivot='key' type='quantitative' />
            <column caption='sum_1_div_sum_2_perc ' datatype='real' default-format='p0.0%' name='[sum_1_div_sum_2 (copy)_1209638762586685447]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [kpi_calculation] = &apos;sum_1_div_sum_2_perc&apos; then [kpi_1] end) &#10;/ &#10;SUM(if [kpi_calculation] = &apos;sum_1_div_sum_2_perc&apos; then [kpi_2] end)&#10;&#10;&#10;/*&#10;SUM(if [Kpi Calculation] = &apos;sum_1_div_sum_2_perc&apos; and ([Kpi Name Final] = &apos;OD CR% (LN data)&apos; OR [Kpi Name Final] = &apos;MP CR% (LN data)&apos;) and TODAY()&gt;=DATE(DATEADD(&apos;day&apos;,50,[Tim Day])) THEN [Kpi 1]&#10;        ELSEIF [Kpi Calculation] = &apos;sum_1_div_sum_2_perc&apos; and ([Kpi Name Final] != &apos;OD CR% (LN data)&apos; AND [Kpi Name Final] != &apos;MP CR% (LN data)&apos;) THEN [Kpi 1]&#10;        ELSE 0 end) &#10;    / &#10;    SUM(if [Kpi Calculation] = &apos;sum_1_div_sum_2_perc&apos; and ([Kpi Name Final] = &apos;OD CR% (LN data)&apos; OR [Kpi Name Final] = &apos;MP CR% (LN data)&apos;) and TODAY()&gt;=DATE(DATEADD(&apos;day&apos;,50,[Tim Day])) THEN [Kpi 2]&#10;        ELSEIF [Kpi Calculation] = &apos;sum_1_div_sum_2_perc&apos; and ([Kpi Name Final] != &apos;OD CR% (LN data)&apos; AND [Kpi Name Final] != &apos;MP CR% (LN data)&apos;) THEN [Kpi 2]&#10;        ELSE 0 end)&#10;*/' />
            </column>
            <column caption='sum_1_div_sum_2_over_sum_3_div_sum_4_as_perc' datatype='real' default-format='p0.0%' name='[sum_1_div_sum_2_perc  (copy)_226798514025287682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM(if [kpi_calculation] = &apos;sum_1_div_sum_2_over_sum_3_div_sum_4_as_perc&apos; then [kpi_1] end) &#10;    / &#10;    SUM(if [kpi_calculation] = &apos;sum_1_div_sum_2_over_sum_3_div_sum_4_as_perc&apos; then [kpi_2] end)&#10;)&#10;/&#10;(&#10;    SUM(if [kpi_calculation] = &apos;sum_1_div_sum_2_over_sum_3_div_sum_4_as_perc&apos; then [kpi_3] end) &#10;    / &#10;    SUM(if [kpi_calculation] = &apos;sum_1_div_sum_2_over_sum_3_div_sum_4_as_perc&apos; then [kpi_4] end)&#10;)' />
            </column>
            <column caption='sum_1_div_sum_2_perc_vs_target' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[sum_1_div_sum_2_vs_target (copy)_6121447469151236099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(   (  SUM(if [kpi_calculation] = &apos;sum_1_div_sum_2_perc_vs_target&apos; then [kpi_1] end) &#10;       / &#10;       SUM(if [kpi_calculation] = &apos;sum_1_div_sum_2_perc_vs_target&apos; then [kpi_2] end)&#10;    )&#10;    -&#10;    (  SUM(if [kpi_calculation] = &apos;sum_1_div_sum_2_perc_vs_target&apos; then [kpi_3] end) &#10;       / &#10;       SUM(if [kpi_calculation] = &apos;sum_1_div_sum_2_perc_vs_target&apos; then [kpi_4] end)&#10;    )&#10;)&#10;*100' />
            </column>
            <column-instance column='[Calculation_1127940640177840135]' derivation='User' name='[usr:Calculation_1127940640177840135:qk]' pivot='key' type='quantitative' />
