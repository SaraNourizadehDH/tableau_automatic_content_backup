            <column caption='Filter Current Month from base' datatype='boolean' name='[Calculation_5425219113317609473]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ([Parameters].[Parameter 2] = &apos;Only closed months&apos; AND [month_periods] = 0)' />
