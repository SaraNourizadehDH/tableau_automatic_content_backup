            <column caption='Kpi Name Final' datatype='string' name='[Calculation_2335116459507298304]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([kpi_name_desc],[kpi_name])' />
            </column>
            <column caption='Table - Global granularity' datatype='string' name='[Calculation_2335116459517370369]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;Global&apos; then &apos;Global&apos;&#10;when &apos;Region&apos; then [region]&#10;when &apos;Entity&apos; then [management_entity]&#10;when &apos;Sub Entity&apos; then [sub_entity]&#10;END' />
