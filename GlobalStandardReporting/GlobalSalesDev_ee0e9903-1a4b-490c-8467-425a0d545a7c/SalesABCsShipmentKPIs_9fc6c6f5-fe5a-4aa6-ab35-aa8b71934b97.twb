              <calculation class='tableau' formula='SUM(if [kpi_id] = &apos;DS_ID_001&apos; and [kpi_calculation] = &apos;sum_1_div_sum_2_perc&apos; then [kpi_1] end) &#10;/ &#10;SUM(if [kpi_id] = &apos;DS_ID_001&apos; and [kpi_calculation] = &apos;sum_1_div_sum_2_perc&apos; then [kpi_2] end)' />
