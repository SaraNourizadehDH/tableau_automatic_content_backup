              <calculation class='tableau' formula='datetrunc(&apos;month&apos;,[event_date])' />
            </column>
            <column caption='Dimension Calculation' datatype='string' name='[Calculation_1480065803529453575]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Entity&quot; THEN [entity]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Region&quot; THEN [region]&#10;ELSEIF [Parameters].[Parameter 1]= &quot;Country&quot; THEN [country]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Account Type&quot; THEN [account_type]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Key Account Sub Category&quot; THEN [key_account_sub_category]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Operation&quot; THEN [operation]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Queried Entities&quot; THEN [queried_entities]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Relevant Source&quot; THEN [relevant_source]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Vendor Grade&quot; THEN [vendor_grade]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Vertical&quot; THEN [vertical]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Vertical Segment&quot; THEN [vertical_segment]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Os Name&quot; THEN [os_name]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Os Version&quot; THEN [os_version]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;User Role&quot; THEN [user_role]&#10;END' />
