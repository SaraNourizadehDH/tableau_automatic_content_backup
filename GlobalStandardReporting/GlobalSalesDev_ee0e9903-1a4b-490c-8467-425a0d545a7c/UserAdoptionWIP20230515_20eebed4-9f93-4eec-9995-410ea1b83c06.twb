      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Granularity' datatype='string' name='[Dimension 2 Parameter (copy)_797981570453860352]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
          <calculation class='tableau' formula='&quot;Region&quot;' />
          <members>
            <member value='&quot;Global&quot;' />
            <member value='&quot;Region&quot;' />
            <member value='&quot;Country&quot;' />
            <member value='&quot;Entity&quot;' />
            <member value='&quot;Sub Entity&quot;' />
          </members>
        </column>
        <column caption='Time Period Parameter UI' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
          <calculation class='tableau' formula='&quot;Week&quot;' />
          <members>
            <member value='&quot;Day&quot;' />
            <member value='&quot;Week&quot;' />
            <member value='&quot;Month&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.16w8id70zhlc0l1bijzzt061vm5w'>
        <column caption='Period' datatype='datetime' default-format='*Mmm dd yyyy' name='[Calculation_1480065803531341832]' role='dimension' type='quantitative'>
          <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Day&quot; THEN [Week (copy)_1480065803526778886]&#10;ELSEIF [Parameters].[Parameter 2]=&quot;Week&quot; THEN [Month (copy)_1480065803526660101]&#10;ELSEIF [Parameters].[Parameter 2]=&quot;Month&quot; THEN [Calculation_1480065803526557700]&#10;END' />
        </column>
        <column caption='operating system' datatype='string' name='[Calculation_252131220415197184]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='[os_name]+&quot; &quot;+[os_version]' />
        </column>
        <column caption='Granularity Calculation' datatype='string' name='[Dimension Calculation (copy)_1480065803534876681]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [Parameters].[Dimension 2 Parameter (copy)_797981570453860352]= &quot;Global&quot; THEN &quot;Global&quot;&#10;ELSEIF [Parameters].[Dimension 2 Parameter (copy)_797981570453860352] = &quot;Region&quot; THEN [gregion]&#10;ELSEIF [Parameters].[Dimension 2 Parameter (copy)_797981570453860352]= &quot;Country&quot; THEN [gcountry]&#10;ELSEIF [Parameters].[Dimension 2 Parameter (copy)_797981570453860352] = &quot;Entity&quot; THEN [gentity]&#10;ELSEIF [Parameters].[Dimension 2 Parameter (copy)_797981570453860352] = &quot;Sub Entity&quot; THEN [gsubentity]&#10;END' />
        </column>
        <column caption='LeadCreation PCT Mobile' datatype='real' default-format='p0.0%' name='[LeadCreation PCT (copy)_1756544617217781765]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM([LeadCreation QTY (copy)_1756544617217036289])/SUM([LeadCreation QTY Mobile (copy)_1756544617218035718])' />
        </column>
        <column caption='LeadCreation QTY Mobile' datatype='integer' default-format='p0.0%' name='[LeadCreation QTY (copy)_1756544617217036289]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='IF [queried_entities]=&quot;Lead&quot; AND [operation]=&quot;Create&quot; AND [device_platform]=&quot;Mobile&quot; then [operations] END' />
