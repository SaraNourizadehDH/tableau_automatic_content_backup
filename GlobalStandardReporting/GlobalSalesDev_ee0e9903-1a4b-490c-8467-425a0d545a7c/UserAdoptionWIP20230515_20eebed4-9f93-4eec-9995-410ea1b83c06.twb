    <worksheet name='QuoteCreation'>
      <table>
        <view>
          <datasources>
            <datasource caption='operations' name='federated.16w8id70zhlc0l1bijzzt061vm5w' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Dimension 2 Parameter (copy)_797981570453860352]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
            <column caption='Time Period Parameter UI' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.16w8id70zhlc0l1bijzzt061vm5w'>
            <column caption='Month' datatype='datetime' name='[Calculation_1480065803526557700]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='datetrunc(&apos;month&apos;,[event_date])' />
            </column>
            <column caption='Period' datatype='datetime' default-format='*Mmm dd yyyy' name='[Calculation_1480065803531341832]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Day&quot; THEN [Week (copy)_1480065803526778886]&#10;ELSEIF [Parameters].[Parameter 2]=&quot;Week&quot; THEN [Month (copy)_1480065803526660101]&#10;ELSEIF [Parameters].[Parameter 2]=&quot;Month&quot; THEN [Calculation_1480065803526557700]&#10;END' />
            </column>
            <column caption='operating system' datatype='string' name='[Calculation_252131220415197184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[os_name]+&quot; &quot;+[os_version]' />
            </column>
            <column caption='TOTAL([QuoteCreation SPK])' datatype='real' name='[Calculation_746823493394841609]' role='measure' type='quantitative' user:unnamed='QuoteCreation'>
              <calculation class='tableau' formula='TOTAL([LeadCreation PCT (copy) (copy)_746823493390499844])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Granularity Calculation' datatype='string' name='[Dimension Calculation (copy)_1480065803534876681]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Dimension 2 Parameter (copy)_797981570453860352]= &quot;Global&quot; THEN &quot;Global&quot;&#10;ELSEIF [Parameters].[Dimension 2 Parameter (copy)_797981570453860352] = &quot;Region&quot; THEN [gregion]&#10;ELSEIF [Parameters].[Dimension 2 Parameter (copy)_797981570453860352]= &quot;Country&quot; THEN [gcountry]&#10;ELSEIF [Parameters].[Dimension 2 Parameter (copy)_797981570453860352] = &quot;Entity&quot; THEN [gentity]&#10;ELSEIF [Parameters].[Dimension 2 Parameter (copy)_797981570453860352] = &quot;Sub Entity&quot; THEN [gsubentity]&#10;END' />
            </column>
            <column caption='QuoteCreation PCT' datatype='real' default-format='p0.0%' name='[LeadCreation (copy) (copy)_746823493390499843]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(if [queried_entities]=&quot;Opportunity_Quote__c&quot; AND [operation]=&quot;Create&quot; AND [device_platform]=&quot;Mobile&quot; then [operations] end)&#10;/&#10;SUM(if [queried_entities]=&quot;Opportunity_Quote__c&quot; AND [operation]=&quot;Create&quot;  then [operations] end))' />
            </column>
            <column caption='QuoteCreation SPK' datatype='real' default-format='p0.0%' name='[LeadCreation PCT (copy) (copy)_746823493390499844]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[LeadCreation (copy) (copy)_746823493390499843]' />
            </column>
            <column caption='QuoteCreation QTY' datatype='integer' default-format='p0.0%' name='[LeadCreation QTY (copy) (copy)_746823493390499845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(if [queried_entities]=&quot;Opportunity_Quote__c&quot; AND [operation]=&quot;Create&quot; AND [device_platform]=&quot;Mobile&quot; then [operations] end))' />
            </column>
            <column caption='Week' datatype='datetime' name='[Month (copy)_1480065803526660101]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;,[event_date])' />
            </column>
            <column caption='Day' datatype='datetime' name='[Week (copy)_1480065803526778886]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;,[event_date])' />
            </column>
            <column caption='Account Type' datatype='string' name='[account_type]' role='dimension' type='nominal' />
            <column caption='Device Platform' datatype='string' name='[device_platform]' role='dimension' type='nominal' />
            <column caption='Entity' datatype='string' name='[entity]' role='dimension' type='nominal' />
            <column caption='Event Date' datatype='date' name='[event_date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[gcountry]' role='dimension' semantic-role='' type='nominal' />
            <column datatype='string' name='[gentity]' role='dimension' type='nominal' />
            <column datatype='string' name='[gregion]' role='dimension' type='nominal' />
            <column caption='Sub-Entity' datatype='string' name='[gsubentity]' role='dimension' type='nominal' />
            <column caption='Key Account Sub Category' datatype='string' name='[key_account_sub_category]' role='dimension' type='nominal' />
