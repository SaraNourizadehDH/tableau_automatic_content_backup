      <column caption='Sales Cockpit (1)' datatype='real' name='[Calculation_139752338405507111 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [page]=&quot;Sales_Cockpit&quot; then [login_key] END)/COUNTD([Calculation_49821081269563394 1])' />
