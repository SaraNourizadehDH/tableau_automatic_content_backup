      </column>
      <column caption='Avg Users Mobile' datatype='real' name='[Average Users (copy)_139752338391789600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(COUNTD(if [device_platform]=&quot;Mobile&quot; then [user_id] END)/COUNTD([Calculation_139752338388643867]))/[Calculation_139752338388963356]' />
      </column>
