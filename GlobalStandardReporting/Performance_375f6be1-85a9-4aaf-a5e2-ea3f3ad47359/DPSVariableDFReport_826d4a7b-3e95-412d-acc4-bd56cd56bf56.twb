                  <zone forceUpdate='true' h='5278' id='1425' type-v2='text' w='42589' x='44007' y='1540'>
                    <formatted-text>
                      <run fontcolor='#77002c'>Please choose the view </run>
                      <run bold='true' fontcolor='#77002c'>Vendor/Orders</run>
                      <run fontcolor='#77002c'> to see results.</run>
                      <run>Æ&#10;</run>
                      <run bold='true' fontcolor='#77002c'>Vendors: </run>
                      <run fontcolor='#77002c'>only vendors with completed/ cancelled orders within the selected date range are used for the calculation.</run>
                      <run>Æ&#10;</run>
                      <run bold='true' fontcolor='#77002c'>Orders: </run>
                      <run fontcolor='#77002c'>only </run>
                      <run bold='true' fontcolor='#77002c'>completed orders</run>
                      <run fontcolor='#77002c'> within the selected date range are used for the calculation.</run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#77002c'>Period: Current </run>
                      <run fontcolor='#77002c'>shows the current setup of the vendors that had an order in </run>
                      <run bold='true' fontcolor='#77002c'>Last 7 Days.</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
