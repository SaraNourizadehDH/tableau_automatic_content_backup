              <calculation class='tableau' formula='SUM([Variable Delay Fee Orders (copy)_1447766562528378881]) / SUM([Calculation_1657465440991240192])' />
            </column>
            <column caption='% Variable MOV- Travel Time Vendors' datatype='real' name='[% Variable Delay Fee (copy)_5896760056171278340]' role='measure' type='quantitative'>
