            <column caption='Show Values- calc' datatype='string' name='[Choose Values  - PM (copy)_846887882860847108]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Toggle Values - DF (copy)_846887882860576771]' />
            </column>
            <column caption='Travel Tme Tiers Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Count Travel Tme Tiers- calc (copy)_2599210316099764262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(LOOKUP(SUM([sum_travel_time_tiers_orders]),0))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Brand' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Orders Date Range' datatype='string' name='[date_filter]' role='dimension' type='nominal' />
            <column caption='Delivery Provider' datatype='string' name='[delivery_provider]' role='dimension' type='nominal' />
            <column aggregation='Attribute' caption='Total Travel Time Tier Orders- Week' datatype='integer' name='[den_travel_time_tiers_orders (copy)_846887882899288073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE [total_travel_time_tiers] : sum([sum_travel_time_tiers_orders])}' />
            </column>
