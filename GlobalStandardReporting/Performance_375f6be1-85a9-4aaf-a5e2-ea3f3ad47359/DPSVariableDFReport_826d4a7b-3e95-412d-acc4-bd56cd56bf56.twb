            </column>
            <column caption='# Countries with Time Condition ' datatype='integer' name='[Variable Travel Time Fee Countries (copy)_6817675808190705671]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_846887882859266049], [country_name]&#10;&#10;: IF SUM([count_time_condition]) &gt; 0 THEN 1 END }' />
            </column>
            <column caption='Variable Travel Time Fee Vendors' datatype='integer' name='[Variable Travel Time Fee Orders (copy)_1447766562528641027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [region], &#10;    [entity_display_name], &#10;    [brand_name], &#10;    [delivery_provider], &#10;    [country_name],&#10;    [date_filter], &#10;    [vertical_type]:&#10;&#10;MIN([count_variable_travel_time_fee])}' />
