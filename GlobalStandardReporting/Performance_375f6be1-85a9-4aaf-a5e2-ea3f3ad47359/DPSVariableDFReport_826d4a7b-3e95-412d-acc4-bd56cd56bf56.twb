          <datasource-dependencies datasource='federated.0injiai1w6e0310zwnul50kh3vcd'>
            <column caption='% No Pricing Mechanism Vendors' datatype='real' default-format='p0.00%' name='[% No Pricing Mechanism Orders (copy)_3569173089377943592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([No Pricing Mechanism Orders (copy)_3569173089355313179]) / SUM([Calculation_1657465440991240192])' />
            </column>
            <column caption='% Single Pricing Mechanism Vendors' datatype='real' default-format='p0.00%' name='[% No Pricing Mechanism Vendors (copy)_3569173089378058281]' role='measure' type='quantitative'>
