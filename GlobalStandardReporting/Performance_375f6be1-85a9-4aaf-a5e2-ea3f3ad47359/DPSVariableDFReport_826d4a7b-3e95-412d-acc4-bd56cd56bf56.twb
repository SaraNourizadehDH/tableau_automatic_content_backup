    <worksheet name='Orders- Delivery Fee Types_Entity'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#555555'>% Orders with Delivery Fee Types</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dps_variable_df_report (rl)' name='federated.0injiai1w6e0310zwnul50kh3vcd' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Toggle Stacked Graph' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
            <column caption='Show ODR' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;No&quot;'>
              <calculation class='tableau' formula='&quot;No&quot;' />
            </column>
            <column alias='Vendors' caption='Choose View' datatype='string' name='[Toggle Stacked Graph (copy)_2599210316360863783]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vendor&quot;'>
              <calculation class='tableau' formula='&quot;Vendor&quot;' />
              <aliases>
                <alias key='&quot;Order&quot;' value='Orders' />
                <alias key='&quot;Vendor&quot;' value='Vendors' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0injiai1w6e0310zwnul50kh3vcd'>
            <column caption='% Flat DF Orders' datatype='real' name='[% Flat DF (copy)_2599210316067246088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_5737093357173198860]) / SUM([Calculation_5737093357173055498])' />
            </column>
            <column caption='% Variable DF Orders' datatype='real' name='[% Variable DF (copy)_2599210316067631114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Variable MOV Orders (copy)_5737093357172207620]) / SUM([Calculation_5737093357173055498])' />
            </column>
            <column caption='Select Dimension' datatype='string' name='[Calculation_1486961935316021252]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Entity Display Name&apos; THEN [entity_display_name]&#10;END' />
            </column>
            <column caption='Vertical Type Grouped' datatype='string' name='[Calculation_1608207294295465984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF lower([vertical_type]) = &apos;restaurants&apos; THEN &apos;Restaurants&apos;&#10;  ELSEIF lower([vertical_type]) = &apos;darkstores&apos; THEN &apos;Darkstores&apos;&#10;  ELSEIF lower([vertical_type]) = &apos;groceries&apos; THEN &apos;Groceries&apos;&#10;  ELSEIF (lower([vertical_type])= &apos;coffee&apos; OR lower([vertical_type]) = &apos;bakery&apos;) THEN &apos;Coffee&amp; Bakery&apos;&#10;  ELSEIF (lower([vertical_type]) = &apos;pharmacies&apos; OR lower([vertical_type]) = &apos;health_supplements&apos; OR lower([vertical_type]) = &apos;health_and_wellness&apos;) THEN &apos;Pharmacies&amp; Health&apos;&#10;  ELSEIF (lower([vertical_type]) = &apos;pets&apos;) THEN &apos;Pets&apos;&#10;  ELSEIF (lower([vertical_type]) = &apos;shops&apos; OR lower([vertical_type]) = &apos;supermarkets&apos; or lower([vertical_type]) = &apos;kiosk&apos;) THEN &apos;Shops&amp; Supermarkets&apos;&#10;  ELSE &apos;Others&apos;&#10;END' />
            </column>
            <column caption='  Total Vendors  ' datatype='integer' name='[Calculation_1657465440991240192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [region], &#10;    [entity_display_name], &#10;    [brand_name], &#10;    [delivery_provider], &#10;    [country_name],&#10;    [date_filter],&#10;    [vertical_type] :&#10;&#10;MIN([total_vendors]) }' />
            </column>
            <column caption='Dash View' datatype='string' name='[Calculation_2599210316361187368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Toggle Stacked Graph (copy)_2599210316360863783]' />
            </column>
            <column caption='Total Orders' datatype='integer' name='[Calculation_5737093357173055498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5737093357173706770] + [Calculation_5737093357173800979] + [Variable MOV Orders (copy)_5737093357172207620]' />
            </column>
            <column caption='Flat DF Vendors' datatype='integer' name='[Calculation_5737093357173125131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [region], &#10;    [entity_display_name], &#10;    [brand_name], &#10;    [delivery_provider], &#10;    [country_name],&#10;    [date_filter],&#10;    [vertical_type] :&#10;&#10; MIN([count_flat_fee_vendors]) + &#10; MIN([count_flat_fee_with_0_df_vendors]) }' />
            </column>
            <column caption='Flat DF Orders' datatype='integer' name='[Calculation_5737093357173198860]' role='measure' type='quantitative'>
