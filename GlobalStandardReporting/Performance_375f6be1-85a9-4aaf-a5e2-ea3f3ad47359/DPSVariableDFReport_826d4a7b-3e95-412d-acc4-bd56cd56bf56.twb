    <dashboard name='Vertical Type Groups Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/DPSVariableDFReport_16032750617620/VerticalTypeGroupsDefinitions?rev=' id='VerticalTypeGroupsDefinitions' path='/t/GlobalStandardReporting/workbooks/DPSVariableDFReport_16032750617620' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='300' maxwidth='1000' minheight='300' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='94666' id='3' type-v2='text' w='98400' x='800' y='2667'>
            <formatted-text>
              <run bold='true' fontcolor='#890005' fontsize='13'>Vertical Type Grouped</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#890005' fontsize='12'>Restaurants:</run>
              <run fontcolor='#890005' fontsize='12'> includes only vertical type restaurants</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#890005' fontsize='12'>Groceries: </run>
              <run fontcolor='#890005' fontsize='12'>includes only vertical type groceries</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#890005' fontsize='12'>Darkstores: </run>
              <run fontcolor='#890005' fontsize='12'>includes only vertical type darkstores</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#890005' fontsize='12'>Pets: </run>
              <run fontcolor='#890005' fontsize='12'>includes only vertical type pets</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#890005' fontsize='12'>Coffee&amp; Bakery:</run>
              <run fontcolor='#890005' fontsize='12'> includes vertical types coffee and bakery</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#890005' fontsize='12'>Pharmacies&amp; Health:</run>
              <run fontcolor='#890005' fontsize='12'> includes vertical types pharmacies, health supplements and health&amp; wellness</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#890005' fontsize='12'>Others:</run>
              <run fontcolor='#890005' fontsize='12'> includes all other vertical types which are not included in the ones above</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#faf5f4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
