            <column caption='% Location Condition Vendors' datatype='real' name='[% Time Based Condition Vendors (copy)_3102839457678405635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Time Based Condition Vendors (copy)_3102839457670959104]) / SUM([Calculation_1657465440991240192])' />
