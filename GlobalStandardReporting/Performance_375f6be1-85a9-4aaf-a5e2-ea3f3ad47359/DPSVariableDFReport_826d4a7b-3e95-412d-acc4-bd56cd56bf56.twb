    <worksheet name='VH- Abs Mechanism'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Pricing Mechanism Weekly/Vendor</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dps_variable_df_report (rl)' name='federated.0injiai1w6e0310zwnul50kh3vcd' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Show ODR' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;No&quot;'>
              <calculation class='tableau' formula='&quot;No&quot;' />
            </column>
            <column alias='Vendors' caption='Choose View' datatype='string' name='[Toggle Stacked Graph (copy)_2599210316360863783]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vendor&quot;'>
              <calculation class='tableau' formula='&quot;Vendor&quot;' />
              <aliases>
                <alias key='&quot;Order&quot;' value='Orders' />
                <alias key='&quot;Vendor&quot;' value='Vendors' />
              </aliases>
            </column>
            <column caption='Show Values' datatype='string' name='[Toggle Values - DF (copy)_846887882860576771]' param-domain-type='list' role='measure' type='nominal' value='&quot;Percentage&quot;'>
              <calculation class='tableau' formula='&quot;Percentage&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0injiai1w6e0310zwnul50kh3vcd'>
            <column caption='Vertical Type Grouped' datatype='string' name='[Calculation_1608207294295465984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF lower([vertical_type]) = &apos;restaurants&apos; THEN &apos;Restaurants&apos;&#10;  ELSEIF lower([vertical_type]) = &apos;darkstores&apos; THEN &apos;Darkstores&apos;&#10;  ELSEIF lower([vertical_type]) = &apos;groceries&apos; THEN &apos;Groceries&apos;&#10;  ELSEIF (lower([vertical_type])= &apos;coffee&apos; OR lower([vertical_type]) = &apos;bakery&apos;) THEN &apos;Coffee&amp; Bakery&apos;&#10;  ELSEIF (lower([vertical_type]) = &apos;pharmacies&apos; OR lower([vertical_type]) = &apos;health_supplements&apos; OR lower([vertical_type]) = &apos;health_and_wellness&apos;) THEN &apos;Pharmacies&amp; Health&apos;&#10;  ELSEIF (lower([vertical_type]) = &apos;pets&apos;) THEN &apos;Pets&apos;&#10;  ELSEIF (lower([vertical_type]) = &apos;shops&apos; OR lower([vertical_type]) = &apos;supermarkets&apos; or lower([vertical_type]) = &apos;kiosk&apos;) THEN &apos;Shops&amp; Supermarkets&apos;&#10;  ELSE &apos;Others&apos;&#10;END' />
            </column>
            <column caption='Dash View' datatype='string' name='[Calculation_2599210316361187368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Toggle Stacked Graph (copy)_2599210316360863783]' />
            </column>
            <column caption='Include ODR Entities' datatype='boolean' name='[Calculation_6391381938436259851]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;&#10;WHEN &apos;No&apos; THEN (NOT CONTAINS([entity_id], &quot;ODR&quot; ))&#10;WHEN &apos;Yes&apos; THEN (NOT ISNULL([entity_id]))&#10;END' />
            </column>
            <column caption='Period' datatype='string' name='[Calculation_846887882859266049]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_filter] = &apos;Last 7 Days&apos; THEN &apos;Current&apos;&#10;ELSEIF [date_filter] = &apos;Last 30 Days&apos; THEN null&#10;ELSE [date_filter] END' />
            </column>
            <column caption='Show Values- calc' datatype='string' name='[Choose Values  - PM (copy)_846887882860847108]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Toggle Values - DF (copy)_846887882860576771]' />
            </column>
            <column caption='Triple Pricing Mechanism Vendors' datatype='integer' name='[Double Pricing Mechanism Vendors (copy)_3569173089377001510]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [region], &#10;    [entity_display_name], &#10;    [brand_name], &#10;    [delivery_provider], &#10;    [country_name],&#10;    [date_filter],&#10;    [vertical_type] :&#10;&#10;MIN([count_at_least_3_pricing_mechanism])}' />
            </column>
            <column caption='Multiple Pricing Mechanism Vendors' datatype='integer' name='[Double Pricing Mechanism Vendors (copy)_3569173089377075239]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [region], &#10;    [entity_display_name], &#10;    [brand_name], &#10;    [delivery_provider], &#10;    [country_name],&#10;    [date_filter],&#10;    [vertical_type] :&#10;&#10;MIN([count_more_than_3_pricing_mechanism])}' />
            </column>
            <column caption='No Pricing Mechanism Vendors' datatype='integer' name='[No Pricing Mechanism Orders (copy)_3569173089355313179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [region], &#10;    [entity_display_name], &#10;    [brand_name], &#10;    [delivery_provider], &#10;    [country_name],&#10;    [date_filter],&#10;    [vertical_type] :&#10;&#10;MIN([count_no_pricing_mechanism])}' />
            </column>
            <column caption='Single Pricing Mechanism Vendors' datatype='integer' name='[No Pricing Mechanism Vendors (copy)_3569173089355436060]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [region], &#10;    [entity_display_name], &#10;    [brand_name], &#10;    [delivery_provider], &#10;    [country_name],&#10;    [date_filter],&#10;    [vertical_type] :&#10;&#10;MIN([count_at_least_1_pricing_mechanism])}' />
            </column>
            <column caption='Double Pricing Mechanism Vendors' datatype='integer' name='[Single Pricing Mechanism Vendors (copy)_3569173089376919589]' role='measure' type='quantitative'>
