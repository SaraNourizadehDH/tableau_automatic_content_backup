            <column caption='% Customer Condition Vendors' datatype='real' name='[% Service Fee (copy)_4004122326475612163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Service Fee Vendors (copy)_4004122326475436033]) / SUM([Calculation_1657465440991240192])' />
