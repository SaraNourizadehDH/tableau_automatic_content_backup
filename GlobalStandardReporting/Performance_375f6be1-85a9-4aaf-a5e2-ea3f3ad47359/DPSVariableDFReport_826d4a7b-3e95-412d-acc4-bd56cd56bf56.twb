    <worksheet name='Service Fee Vendors'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Service Fee Vendors</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dps_variable_df_report (rl)' name='federated.0injiai1w6e0310zwnul50kh3vcd' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Show ODR' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;No&quot;'>
              <calculation class='tableau' formula='&quot;No&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0injiai1w6e0310zwnul50kh3vcd'>
            <column caption='Count Service Fee Vendors (VD)' datatype='integer' name='[% Service Fee Vendors (copy)_6817675808194076681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [delivery_provider] = &apos;VENDOR_DELIVERY&apos; THEN ([Variable Basket Value Fee Vendors (copy)_1657465441014120449]) END' />
            </column>
            <column caption='Vertical Type Grouped' datatype='string' name='[Calculation_1608207294295465984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF lower([vertical_type]) = &apos;restaurants&apos; THEN &apos;Restaurants&apos;&#10;  ELSEIF lower([vertical_type]) = &apos;darkstores&apos; THEN &apos;Darkstores&apos;&#10;  ELSEIF lower([vertical_type]) = &apos;groceries&apos; THEN &apos;Groceries&apos;&#10;  ELSEIF (lower([vertical_type])= &apos;coffee&apos; OR lower([vertical_type]) = &apos;bakery&apos;) THEN &apos;Coffee&amp; Bakery&apos;&#10;  ELSEIF (lower([vertical_type]) = &apos;pharmacies&apos; OR lower([vertical_type]) = &apos;health_supplements&apos; OR lower([vertical_type]) = &apos;health_and_wellness&apos;) THEN &apos;Pharmacies&amp; Health&apos;&#10;  ELSEIF (lower([vertical_type]) = &apos;pets&apos;) THEN &apos;Pets&apos;&#10;  ELSEIF (lower([vertical_type]) = &apos;shops&apos; OR lower([vertical_type]) = &apos;supermarkets&apos; or lower([vertical_type]) = &apos;kiosk&apos;) THEN &apos;Shops&amp; Supermarkets&apos;&#10;  ELSE &apos;Others&apos;&#10;END' />
            </column>
            <column caption='  Total Vendors  ' datatype='integer' name='[Calculation_1657465440991240192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [region], &#10;    [entity_display_name], &#10;    [brand_name], &#10;    [delivery_provider], &#10;    [country_name],&#10;    [date_filter],&#10;    [vertical_type] :&#10;&#10;MIN([total_vendors]) }' />
            </column>
            <column caption='# Countries with Service Fee in Pickup' datatype='integer' name='[Calculation_2177349711639928832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_846887882859266049], [country_name]&#10;&#10;: IF SUM([Count Service Fee Vendors (VD) (copy)_1744159722461499393]) &gt; 0 THEN 1 END }' />
            </column>
            <column caption='current_week' datatype='boolean' name='[Calculation_440508373061595137]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[week_start_week] = &apos;Current&apos;' />
            </column>
            <column caption='Include ODR Entities' datatype='boolean' name='[Calculation_6391381938436259851]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;&#10;WHEN &apos;No&apos; THEN (NOT CONTAINS([entity_id], &quot;ODR&quot; ))&#10;WHEN &apos;Yes&apos; THEN (NOT ISNULL([entity_id]))&#10;END' />
            </column>
            <column caption='% VD Vendors with Service Fee' datatype='real' name='[Calculation_6817675808197816331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([% Service Fee Vendors (copy)_6817675808194076681])/sum([Count Service Fee Vendors (VD) (copy)_6817675808196612106])' />
            </column>
            <column caption='Period' datatype='string' name='[Calculation_846887882859266049]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_filter] = &apos;Last 7 Days&apos; THEN &apos;Current&apos;&#10;ELSEIF [date_filter] = &apos;Last 30 Days&apos; THEN null&#10;ELSE [date_filter] END' />
            </column>
            <column caption='Count Service Fee Vendors (PICKUP)' datatype='integer' name='[Count Service Fee Vendors (VD) (copy)_1744159722461499393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [delivery_provider] = &apos;PICKUP&apos; THEN ([Variable Basket Value Fee Vendors (copy)_1657465441014120449]) END' />
            </column>
            <column caption='Count Vendors (VD) ' datatype='integer' name='[Count Service Fee Vendors (VD) (copy)_6817675808196612106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [delivery_provider] = &apos;VENDOR_DELIVERY&apos; THEN ([Calculation_1657465440991240192]) END' />
            </column>
            <column caption='Service Fee Vendors' datatype='integer' name='[Variable Basket Value Fee Vendors (copy)_1657465441014120449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [region], &#10;    [entity_display_name], &#10;    [brand_name], &#10;    [delivery_provider], &#10;    [country_name],&#10;    [date_filter],&#10;    [vertical_type] :&#10;&#10;MIN([count_service_fee])}' />
            </column>
            <column caption='Brand' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Count Service Fee' datatype='integer' name='[count_service_fee]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Orders Date Range' datatype='string' name='[date_filter]' role='dimension' type='nominal' />
            <column caption='Delivery Provider' datatype='string' name='[delivery_provider]' role='dimension' type='nominal' />
            <column caption='Entity Display Name' datatype='string' name='[entity_display_name]' role='dimension' type='nominal' />
            <column caption='Entity Id' datatype='string' name='[entity_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1608207294295465984]' derivation='None' name='[none:Calculation_1608207294295465984:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_440508373061595137]' derivation='None' name='[none:Calculation_440508373061595137:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_6391381938436259851]' derivation='None' name='[none:Calculation_6391381938436259851:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_846887882859266049]' derivation='None' name='[none:Calculation_846887882859266049:nk]' pivot='key' type='nominal' />
            <column-instance column='[brand_name]' derivation='None' name='[none:brand_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[delivery_provider]' derivation='None' name='[none:delivery_provider:nk]' pivot='key' type='nominal' />
            <column-instance column='[entity_id]' derivation='None' name='[none:entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2177349711639928832]' derivation='Sum' name='[sum:Calculation_2177349711639928832:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[total_vendors]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_6817675808197816331]' derivation='User' name='[usr:Calculation_6817675808197816331:qk]' pivot='key' type='quantitative' />
            <column caption='Vertical Type' datatype='string' name='[vertical_type]' role='dimension' type='nominal' />
            <column caption='Week' datatype='string' name='[week_start_week]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0injiai1w6e0310zwnul50kh3vcd].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0injiai1w6e0310zwnul50kh3vcd].[usr:Calculation_6817675808197816331:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0injiai1w6e0310zwnul50kh3vcd].[sum:Calculation_2177349711639928832:qk]&quot;' />
            </groupfilter>
          </filter>
          <manual-sort column='[federated.0injiai1w6e0310zwnul50kh3vcd].[:Measure Names]' direction='ASC'>
            <dictionary>
              <bucket>&quot;[federated.0injiai1w6e0310zwnul50kh3vcd].[usr:Calculation_6817675808197816331:qk]&quot;</bucket>
              <bucket>&quot;[federated.0injiai1w6e0310zwnul50kh3vcd].[sum:Calculation_2177349711639928832:qk]&quot;</bucket>
            </dictionary>
          </manual-sort>
          <filter class='categorical' column='[federated.0injiai1w6e0310zwnul50kh3vcd].[none:Calculation_1608207294295465984:nk]' filter-group='30'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:Calculation_1608207294295465984:nk]' />
              <groupfilter function='member' level='[none:Calculation_1608207294295465984:nk]' member='%null%' />
