              <calculation class='tableau' formula='SUM([Variable Travel Time MOV Vendors (copy)_762234242936090624]) / SUM([Calculation_1657465440991240192])' />
            </column>
            <column caption='Vertical Type Grouped' datatype='string' name='[Calculation_1608207294295465984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF lower([vertical_type]) = &apos;restaurants&apos; THEN &apos;Restaurants&apos;&#10;  ELSEIF lower([vertical_type]) = &apos;darkstores&apos; THEN &apos;Darkstores&apos;&#10;  ELSEIF lower([vertical_type]) = &apos;groceries&apos; THEN &apos;Groceries&apos;&#10;  ELSEIF (lower([vertical_type])= &apos;coffee&apos; OR lower([vertical_type]) = &apos;bakery&apos;) THEN &apos;Coffee&amp; Bakery&apos;&#10;  ELSEIF (lower([vertical_type]) = &apos;pharmacies&apos; OR lower([vertical_type]) = &apos;health_supplements&apos; OR lower([vertical_type]) = &apos;health_and_wellness&apos;) THEN &apos;Pharmacies&amp; Health&apos;&#10;  ELSEIF (lower([vertical_type]) = &apos;pets&apos;) THEN &apos;Pets&apos;&#10;  ELSEIF (lower([vertical_type]) = &apos;shops&apos; OR lower([vertical_type]) = &apos;supermarkets&apos; or lower([vertical_type]) = &apos;kiosk&apos;) THEN &apos;Shops&amp; Supermarkets&apos;&#10;  ELSE &apos;Others&apos;&#10;END' />
            </column>
            <column caption='  Total Vendors  ' datatype='integer' name='[Calculation_1657465440991240192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [region], &#10;    [entity_display_name], &#10;    [brand_name], &#10;    [delivery_provider], &#10;    [country_name],&#10;    [date_filter],&#10;    [vertical_type] :&#10;&#10;MIN([total_vendors]) }' />
            </column>
            <column caption='Dash View' datatype='string' name='[Calculation_2599210316361187368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Toggle Stacked Graph (copy)_2599210316360863783]' />
            </column>
            <column caption='% Variable Travel Time Fee Vendors' datatype='real' name='[Calculation_4358921518789357572]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Variable Travel Time Fee Orders (copy)_1447766562528641027]) / SUM([Calculation_1657465440991240192])' />
            </column>
            <column caption='Choose Values - DPS' datatype='string' name='[Calculation_4358921518799159304]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2]' />
