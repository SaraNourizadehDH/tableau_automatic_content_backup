    <worksheet name='Growth summary'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Growth </run>
            <run fontcolor='#898989' fontsize='10'>best ÷ pred.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Winning fees' name='federated.0gtgeib1o7btnv1gpk9so0kz88vz' />
            <datasource caption='ds_winning_fees_component_settings' name='federated.0gtgeib1o7btnv1gpk9so0kz88vz (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.0gtgeib1o7btnv1gpk9so0kz88vz'>
            <column caption='total_orders_growth' datatype='real' default-format='p0.0%' name='[Calculation10]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([orders_total])) - LOOKUP((SUM([orders_total])),-1)) / ABS(LOOKUP((SUM([orders_total])),-1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='total_revenue_growth' datatype='real' default-format='p0.0%' name='[Calculation11]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([revenue_total])) - LOOKUP((SUM([revenue_total])),-1)) / ABS(LOOKUP((SUM([revenue_total])),-1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='total_delivery_cost_growth' datatype='real' default-format='p0.0%' name='[Calculation12]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([cost_total])) - LOOKUP((SUM([cost_total])),-1)) / ABS(LOOKUP((SUM([cost_total])),-1))'>
                <table-calc ordering-type='Rows' />
