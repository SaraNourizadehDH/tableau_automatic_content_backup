            <column caption='DBDF' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1526086966516232192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [dbdf_share]&gt;=0.66 then 3&#10;elseif [dbdf_share]&lt;0.66 and [dbdf_share]&gt;=0.33 then 2&#10;elseif [dbdf_share]&lt;0.33 and [dbdf_share]&gt;=0.01 then 1&#10;else 0&#10;END' />
