            <column caption='Score' datatype='real' name='[Calculation_2495908999749869582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ifnull([Surge (copy)_1526086966759231495],0)+ifnull([Calculation_1526086966516232192],0)+ifnull([DBDF (copy)_1526086966518030337],0)+ifnull([DBMOV (copy)_1526086966757314562],0)+ifnull([Surge (copy)_1526086966759108614],0)+ifnull([Surge (copy)_1526086966759378952],0)+ifnull([TOD DOW (copy)_1526086966757994500],0)+ifnull([TOD DOW (copy) (copy)_1526086966758002693],0)+ifnull([FDNC (copy)_1526086966757892099],0)&#10;+ifnull([Unprofitable Orders (copy)_1526086966768955402],0)+ifnull([TOD DOW (copy)_1526086966768644105],0)+ifnull([Share below 30% TT Range (copy)_1526086966775353356],0)+ifnull([Share under 7.5% BV (copy)_1526086966776217613],0)+ifnull([Share under 7.5% BV (copy)_2495908999445946380],0)+ifnull([Calculation_2495908999092027392],0)+ifnull([Calculation_2495908999734874125],0)&#10;+ifnull([Calculation_720364848870981680],0))&#10;/47' />
