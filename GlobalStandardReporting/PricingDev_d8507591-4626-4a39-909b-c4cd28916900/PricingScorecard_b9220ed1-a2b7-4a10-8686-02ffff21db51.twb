        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1gr4he51njes4h1ghmt4u0zbam2a (copy)' name='Custom SQL Query3' type='text'>with all_data as (
  SELECT 
  distinct
  global_entity_id entity_id, 
  case when segment=&apos;America&apos; then &apos;Americas&apos;
  when segment=&apos;Europe&apos; then &apos;Europe&apos;
  when segment=&apos;Asia&apos; then &apos;Asia&apos;
  when segment=&apos;MENA&apos; then &apos;MENA&apos; end as region,
  country_code
  --date_trunc(date(created_at), month) month
  FROM
  `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` ti
  --where is_platform_online
),

all_test_data as (
  SELECT 
  distinct
  date_trunc(date(test_start_date), month) month,
ti.region,
ti.entity_id,
  FROM
  `dh-logistics-product-ops.pricing.pricing_mechanism_testing_intensity_detail_v2` ti
),
temp_table as (SELECT
date_trunc(date(test_start_date), month) month,
ti.region,
ti.entity_id,
ifnull(count(distinct case when test_is_travel_time_different_from_control = true then test_name  end),0) as dbdf_test,
ifnull(count(distinct case when test_is_dbmov_different_from_control = true then test_name end),0) as dbmov_test,
ifnull(count(distinct case when test_is_surge_mov_different_from_control = true then test_name end),0) as surge_mov_test,
ifnull(count(distinct case when test_is_small_order_fee_different_from_control = true then test_name end),0) as sbf_test,
ifnull(count(distinct case when test_is_fleet_delay_different_from_control = true then test_name end),0) as surge_test,
ifnull(count(distinct case when test_is_basket_value_different_from_control = true then test_name end),0) as bv_test,
ifnull(count(distinct case when test_is_service_fee_different_from_control = true then test_name end),0) as sf_test,

count(distinct test_name) total_test_per_country
FROM
  `dh-logistics-product-ops.pricing.pricing_mechanism_testing_intensity_detail_v2` ti
WHERE  date(ti.test_start_date) between current_date() - 29 and current_date() - 2
GROUP BY 1,2,3
Order by entity_id),

final_country_data as(
select 
--t.month,
country_code,
case when a.region is null then td.region else a.region end as region ,
case when a.entity_id is null then td.entity_id else a.entity_id end as entity_id,
-- t.region test_region,
case when td.entity_id is null then a.entity_id else td.entity_id end test_entity,
from all_data a 
left join all_test_data td on lower(a.entity_id) = lower(td.entity_id) and lower(a.region) = lower(td.region) 
left join temp_table t on td.month=t.month and lower(td.entity_id) = lower(t.entity_id) and lower(td.region) = lower(t.region)
WHERE /*td.entity_id is not null 
and*/ a.region is not null
GROUP BY 1,2,3,4
ORDER BY region
),

all_test as (
  SELECT 
  DISTINCT
  --date_trunc(test_start_date, month) month,
  country_code,
  region
  from `dh-logistics-product-ops.pricing.ab_test_list_pricing`
 
)
,

correct_tests as (
  select
  date_trunc(test_start_date, month) month,
  region,
  country_code,
  sum(case when valid_test = &apos;correct test&apos; then counter end) as correct_tests,
  sum(counter) all_test_count
  from `dh-logistics-product-ops.pricing.ab_test_list_pricing`
  where true
   and test_start_date between current_date() - 29 and current_date() - 2
GROUP BY 1,2,3
ORDER BY region ASC
)
select
 ad.country_code,
 a.entity_id,
 a.region,
 --t.month,
 ifnull(t.correct_tests,0) correct_tests,
 ifnull(t.all_test_count,0) all_test_count
from final_country_data a left join all_test ad on lower(a.country_code) = lower(ad.country_code) and lower(a.region) = lower(ad.region)
left join correct_tests t on lower(ad.country_code) = lower(t.country_code)
ORDER BY region ASC</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.1gr4he51njes4h1ghmt4u0zbam2a (copy)' name='Custom SQL Query' type='text'><![CDATA[with tt_range as (
  SELECT
  --DATE_TRUNC(created_date, month) month,
  o.entity_id,
  max(dps_travel_time)-min(dps_travel_time) travel_time_range
   FROM
 `fulfillment-dwh-production.cl.dps_sessions_mapped_to_orders_v2` o
WHERE
  created_date between current_date() - 29 and current_date() - 2
   and o.is_sent
  and o.region is not null
  and o.entity_id is not null
GROUP BY
  entity_id,
  --created_date,
  region,
  country_code
)
SELECT
 -- DATE_TRUNC(created_date, month) month,
  o.region,
  o.entity_id,
  o.country_code,
  count(distinct case when safe_divide((ifnull(o.delivery_fee_eur,0) + ifnull(o.service_fee_eur,0) + ifnull(o.mov_customer_fee_eur,0)),(gfv_eur)) <<= 0.075 then platform_order_code end)/count(distinct platform_order_code)  below_7_5,
  count(distinct case when (ifnull(o.delivery_fee_eur,0) + ifnull(o.service_fee_eur,0) + ifnull(o.mov_customer_fee_eur,0) + ifnull(o.commission_eur,0) + ifnull(joker_vendor_fee_eur,0)) >> ifnull(o.delivery_costs_eur,0) then platform_order_code end)/count(distinct platform_order_code)  prof_orders,
  count(distinct case when safe_divide(ifnull(o.dps_minimum_order_value_eur,0),gfv_eur) <<= 0.15 then platform_order_code end)/count(distinct platform_order_code) mov_below_15,
  count(distinct case when dps_travel_time << travel_time_range*0.3 then platform_order_code end)/*/count(distinct platform_order_code)*/ orders_below_30_tt_range,
  count(distinct case when dps_travel_time << travel_time_range*0.3 then platform_order_code end)/count(distinct platform_order_code) share_below_30_tt_range,
  count(distinct platform_order_code) as orders
  FROM
 `fulfillment-dwh-production.cl.dps_sessions_mapped_to_orders_v2` o
 LEFT JOIN tt_range t on o.entity_id = t.entity_id
WHERE
  created_date between current_date() - 29 and current_date() - 2
  and o.is_sent
  and o.region is not null
  and o.entity_id is not null
GROUP BY
  entity_id,
  --created_date,
  region,
  country_code]]></relation>
