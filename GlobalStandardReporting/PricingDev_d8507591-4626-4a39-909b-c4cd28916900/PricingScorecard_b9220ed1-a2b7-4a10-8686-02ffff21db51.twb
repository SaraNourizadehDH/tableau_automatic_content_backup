            <column caption='Correct T' datatype='integer' name='[Calculation_2495908999092027392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull((if [correct_tests]/[all_test_count]&gt;= 0.9 then 3&#10;elseif [correct_tests]/[all_test_count]&lt; 0.9  and [correct_tests]/[all_test_count]&gt;= 0.8 then 2&#10;elseif [correct_tests]/[all_test_count]&lt;0.8 then 1 &#10;end),0)' />
