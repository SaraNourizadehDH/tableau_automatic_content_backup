            <column caption='Area' datatype='string' name='[Calculation_1174876567955378185]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[region (Custom SQL Query1) Parameter] = &apos;Region&apos; THEN [region]&#13;&#10;ELSEIF [Parameters].[region (Custom SQL Query1) Parameter] = &apos;Entity&apos; THEN [entity_id]&#13;&#10;ELSE NULL&#13;&#10;END' />
