      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_91BADD9256964F4E99EF799AC4F66189'>
            <properties context=''>
              <relation connection='bigquery.1wmhnei06vz1os1bh60dr15ynkhl' name='Custom SQL Query' type='text'><![CDATA[WITH
test_orders AS (
  SELECT
    perseus_client_id,
    target_group,
    test_variant,
    platform_order_code,
    delivery_fee_eur,
  FROM
    `fulfillment-dwh-production.cl.dps_test_orders`
  WHERE
    created_date BETWEEN <[Parameters].[Parameter 2]> - 1 AND <[Parameters].[Parameter 3]> + 1
    AND test_name = <[Parameters].[Parameter 1]>
    AND is_sent
)
, test_users AS (
  SELECT
    perseus_client_id,
    target_group,
    test_variant,
    DENSE_RANK() OVER (PARTITION BY target_group, test_variant ORDER BY perseus_client_id) row_id,
    SUM(delivery_fee_eur) sum_delivery_fee_eur,
    COUNT(*) orders,
  FROM test_orders
  GROUP BY 1,2,3
  ORDER BY 2,3,1
)
, test_config AS (
  SELECT
    test_variant,
    target_group,
    MAX(row_id) row_id,
  FROM test_users
  GROUP BY 1,2
)
, dummy_table AS (
  SELECT
    iteration,
    test_variant,
    target_group,
    1 + CAST(RAND() * (row_id - 1) as INT64) row_id
  FROM test_config
  JOIN UNNEST(GENERATE_ARRAY(1,<[Parameters].[Parameter 4]>)) -- Number of users sampled
  JOIN UNNEST(GENERATE_ARRAY(1,<[Parameters].[Parameter 5]>)) iteration -- Times sampled
  ORDER BY 1,2,3
)
-- , subsamples AS (
  SELECT
    iteration,
    target_group,
    test_variant,
    SUM(sum_delivery_fee_eur)/SUM(orders) avg_delivery_fee_eur,
    SUM(sum_delivery_fee_eur) sum_delivery_fee_eur,
    SUM(orders) orders,
    COUNT(*) users,
    COUNT(DISTINCT perseus_client_id) distinct_users,
    -- ARRAY_AGG(DISTINCT perseus_client_id) user_list,
  FROM dummy_table
  INNER JOIN test_users using (row_id, target_group, test_variant)
  GROUP BY 1,2,3
  ORDER BY 1,2,3
-- )
-- , user_drawn_list AS (
--   SELECT
--     u,
--     COUNT(*) draws,
--   FROM subsamples
--   LEFT JOIN UNNEST(user_list) u
--   GROUP BY 1
-- )
-- SELECT
--   draws,
--   COUNT(*) times,
-- FROM user_drawn_list
-- GROUP BY 1
-- ORDER BY 2 DESC]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
