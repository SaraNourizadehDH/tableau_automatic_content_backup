        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.02w24jj19t0b7y13su1tn0i52ljg'>
            <connection CATALOG='dh-logistics-product-ops' EXECCATALOG='logistics-data-staging-flat' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='10' bq-large-fetch-rows='' bq-project-fetch-rows='2000' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='DH Logistics - Product Ops' schema='pricing' server-oauth='' username='laurent.broering@deliveryhero.com' workgroup-auth-mode='prompt'>
              <connection-customization class='bigquery' enabled='false' version='18.1'>
                <vendor name='bigquery' />
                <driver name='bigquery' />
