          <alias key='&quot;[federated.18dqw5i145lrvs182ms1d0raqblp].[pcdf:usr:Calculation_1465640206578688018:qk]&quot;' value='Delta Avg DF' />
          <alias key='&quot;[federated.18dqw5i145lrvs182ms1d0raqblp].[pcdf:usr:Calculation_1465640206578786323:qk]&quot;' value='Delta Avg Commission' />
          <alias key='&quot;[federated.18dqw5i145lrvs182ms1d0raqblp].[pcdf:usr:Calculation_1465640206578946068:qk]&quot;' value='Delta Avg Delivery Costs' />
