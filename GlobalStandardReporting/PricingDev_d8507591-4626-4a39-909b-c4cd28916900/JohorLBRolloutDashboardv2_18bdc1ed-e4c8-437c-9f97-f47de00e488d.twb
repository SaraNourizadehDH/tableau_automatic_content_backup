    <worksheet name='Time Series Data | Superimposed'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Time Series Data of Standard Business KPIs </run>
            <run fontsize='12' italic='true'>(Only successful orders from OD restaurants in Johor are considered here)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='10' italic='true' underline='true'>Includes:</run>
            <run fontsize='10' italic='true'>Æ </run>
            <run bold='true' fontcolor='#ff0000' fontsize='10' italic='true'># Orders</run>
            <run fontsize='10' italic='true'>, total + avg (</run>
            <run bold='true' fontcolor='#ff0000' fontsize='10' italic='true'>GFV, Revenue, Delivery Costs, Gross Profit</run>
            <run fontsize='10' italic='true'>), and avg (</run>
            <run bold='true' fontcolor='#ff0000' fontsize='10' italic='true'>travel time, delivery distance, and fleet delay</run>
            <run fontsize='10' italic='true'>)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='raw_orders_data' name='federated.18dqw5i145lrvs182ms1d0raqblp' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI_Parameter' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Orders&quot;'>
              <calculation class='tableau' formula='&quot;# Orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18dqw5i145lrvs182ms1d0raqblp'>
            <column caption='KPI_Displayed' datatype='real' name='[Calculation_1328843367833772033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;# Orders&apos; THEN COUNTD([order_id])&#13;&#10;    WHEN &apos;Tot DF&apos; THEN SUM([Correct_DF])&#13;&#10;    WHEN &apos;Tot Commission&apos; THEN SUM([commission_local])&#13;&#10;    WHEN &apos;Tot GFV&apos; THEN SUM([gfv_local])&#13;&#10;    WHEN &apos;Tot Revenue&apos; THEN SUM([revenue_local])&#13;&#10;    WHEN &apos;Tot Delivery Costs&apos; THEN SUM([delivery_costs_local])&#13;&#10;    WHEN &apos;Tot Gross Profit&apos; THEN SUM([gross_profit_local])&#13;&#10;    WHEN &apos;Avg DF&apos; THEN SUM([Correct_DF]) / COUNTD([order_id])&#13;&#10;    WHEN &apos;Avg Commission&apos; THEN SUM([commission_local]) / COUNTD([order_id])&#13;&#10;    WHEN &apos;Avg GFV&apos; THEN SUM([gfv_local]) / COUNTD([order_id])&#13;&#10;    WHEN &apos;Avg Revenue&apos; THEN SUM([revenue_local]) / COUNTD([order_id])&#13;&#10;    WHEN &apos;Avg Delivery Costs&apos; THEN SUM([delivery_costs_local]) / COUNTD([order_id])&#13;&#10;    WHEN &apos;Avg Gross Profit&apos; THEN SUM([gross_profit_local]) / COUNTD([order_id])&#13;&#10;    WHEN &apos;Avg Travel Time&apos; THEN AVG([travel_time])&#13;&#10;    WHEN &apos;Avg Delivery Dist&apos; THEN AVG([delivery_distance_m])&#13;&#10;    WHEN &apos;Avg Fleet Delay&apos; THEN AVG([mean_delay])&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Days Since Start of Period' datatype='integer' name='[Calculation_1465640206566637580]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Period] = &apos;Pre-Period&apos; &#13;&#10;    THEN DATEDIFF(&apos;day&apos;, {Fixed [Period] : MIN(IF [Period] = &apos;Pre-Period&apos; THEN [created_date] END)}, [created_date]) + 1&#13;&#10;    ELSE DATEDIFF(&apos;day&apos;, {Fixed [Period] : MIN(IF [Period] = &apos;Post-Period&apos; THEN [created_date] END)}, [created_date]) + 1&#13;&#10;END' />
            </column>
            <column datatype='real' name='[Correct_DF]' role='measure' type='quantitative' />
            <column datatype='string' name='[Period]' role='dimension' type='nominal' />
            <column datatype='string' name='[cofund_sprint_group]' role='dimension' type='nominal' />
            <column caption='Commission Local' datatype='real' name='[commission_local]' role='measure' type='quantitative' />
            <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1328843367833772033]' derivation='User' name='[cum:usr:Calculation_1328843367833772033:qk:5]' pivot='key' type='quantitative'>
              <table-calc aggregation='Sum' ordering-field='[federated.18dqw5i145lrvs182ms1d0raqblp].[none:Calculation_1465640206566637580:qk]' ordering-type='Field' type='CumTotal' />
            </column-instance>
            <column caption='Delivery Costs Local' datatype='real' name='[delivery_costs_local]' role='measure' type='quantitative' />
            <column caption='Delivery Distance M' datatype='real' name='[delivery_distance_m]' role='measure' type='quantitative' />
            <column caption='Dps Customer Tag' datatype='string' name='[dps_customer_tag]' role='dimension' type='nominal' />
