          <datasource-dependencies datasource='federated.18dqw5i145lrvs182ms1d0raqblp'>
            <column caption='Days Since Start of Period' datatype='integer' name='[Calculation_1465640206566637580]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Period] = &apos;Pre-Period&apos; &#13;&#10;    THEN DATEDIFF(&apos;day&apos;, {Fixed [Period] : MIN(IF [Period] = &apos;Pre-Period&apos; THEN [created_date] END)}, [created_date]) + 1&#13;&#10;    ELSE DATEDIFF(&apos;day&apos;, {Fixed [Period] : MIN(IF [Period] = &apos;Post-Period&apos; THEN [created_date] END)}, [created_date]) + 1&#13;&#10;END' />
            </column>
            <column caption='Avg GFV' datatype='real' name='[Calculation_1465640206574563343]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfv_local])/COUNTD([order_id])' />
            </column>
            <column caption='Avg Revenue' datatype='real' name='[Calculation_1465640206574829584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([revenue_local])/COUNTD([order_id])' />
            </column>
            <column caption='Avg Gross Profit' datatype='real' name='[Calculation_1465640206575058961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gross_profit_local])/COUNTD([order_id])' />
            </column>
            <column caption='Avg DF' datatype='real' name='[Calculation_1465640206578688018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Correct_DF]) / COUNTD([order_id])' />
            </column>
            <column caption='Avg Commission' datatype='real' name='[Calculation_1465640206578786323]' role='measure' type='quantitative'>
