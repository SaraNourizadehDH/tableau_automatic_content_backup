    <worksheet name='Time Series Data | CVR'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Time Series Data of Session and CVR data </run>
            <run fontsize='9' italic='true'>(Only sessions from OD restaurants in Johor are considered here)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='10' italic='true' underline='true'>Metrics Included:</run>
            <run fontsize='10' italic='true'>Æ </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ff0000' fontsize='10' italic='true'>* Distinct # of Sessions + Distinct # of Users</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ff0000' fontsize='10' italic='true'>* CVR1</run>
            <run fontsize='10' italic='true'> (transacted sessions / total # of sessions)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ff0000' fontsize='10' italic='true'>* CVR2 </run>
            <run fontsize='10' italic='true'>(transacted sessions / sessions w/ a shop listing page loaded event)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ff0000' fontsize='10' italic='true'>* CVR3 </run>
            <run fontsize='10' italic='true'>(transacted sessions / sessions w/ a restaurant menu page loaded event)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ff0000' fontsize='10' italic='true'>* mCVR2 </run>
            <run fontsize='10' italic='true'>(listing page to menu page); </run>
            <run bold='true' fontcolor='#ff0000' fontsize='10' italic='true'>mCVR3 </run>
            <run fontsize='10' italic='true'>(menu page to checkout page); </run>
            <run bold='true' fontcolor='#ff0000' fontsize='10' italic='true'>mCVR4 </run>
            <run fontsize='10' italic='true'>(checkout page to transaction)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='raw_cvr_data' name='federated.1xaudv403ukebu1en7l7j1axx89u' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='CVR Type' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;CVR3&quot;'>
              <calculation class='tableau' formula='&quot;CVR3&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xaudv403ukebu1en7l7j1axx89u'>
            <column caption='mCVR2' datatype='real' name='[CVR3 (copy)_1432426159584186372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([list_menu]) / COUNTD([shop_list_no])' />
            </column>
            <column caption='Days Since Start of Period' datatype='integer' name='[Calculation_1432426159578832896]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Period] = &apos;Pre-Period&apos; &#13;&#10;    THEN DATEDIFF(&apos;day&apos;, {Fixed [Period] : MIN(IF [Period] = &apos;Pre-Period&apos; THEN [created_date] END)}, [created_date]) + 1&#13;&#10;    ELSE DATEDIFF(&apos;day&apos;, {Fixed [Period] : MIN(IF [Period] = &apos;Post-Period&apos; THEN [created_date] END)}, [created_date]) + 1&#13;&#10;END' />
            </column>
            <column caption='CVR1' datatype='real' name='[Calculation_1432426159582162945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([transaction_no]) / COUNTD([ga_session_id])' />
            </column>
            <column caption='CVR2' datatype='real' name='[Calculation_1432426159582326786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([transaction_no]) / COUNTD([shop_list_no])' />
            </column>
            <column caption='CVR3' datatype='real' name='[Calculation_1432426159582375939]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([transaction_no]) / COUNTD([shop_menu_no])' />
            </column>
            <column caption='CVR(x)' datatype='real' name='[Calculation_1432426159584505862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &apos;CVR1&apos; THEN [Calculation_1432426159582162945]&#13;&#10;    WHEN &apos;CVR2&apos; THEN [Calculation_1432426159582326786]&#13;&#10;    WHEN &apos;CVR3&apos; THEN [Calculation_1432426159582375939]&#13;&#10;    WHEN &apos;mCVR2&apos; THEN [CVR3 (copy)_1432426159584186372]&#13;&#10;    WHEN &apos;mCVR3&apos; THEN [mCVR2 (copy)_1849572075083026432]&#13;&#10;    WHEN &apos;mCVR4&apos; THEN [mCVR3 (copy)_1849572075083145217]&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Period]' role='dimension' type='nominal' />
            <column caption='Checkout No' datatype='string' name='[checkout_no]' role='dimension' type='nominal' />
            <column caption='Checkout Transaction' datatype='string' name='[checkout_transaction]' role='dimension' type='nominal' />
            <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column-instance column='[ga_session_id]' derivation='CountD' name='[ctd:ga_session_id:qk]' pivot='key' type='quantitative' />
            <column-instance column='[perseus_client_id]' derivation='CountD' name='[ctd:perseus_client_id:qk]' pivot='key' type='quantitative' />
            <column caption='Customer Status' datatype='string' name='[customer_status]' role='dimension' type='nominal' />
            <column caption='Ga Session Id' datatype='string' name='[ga_session_id]' role='dimension' type='nominal' />
            <column caption='List Menu' datatype='string' name='[list_menu]' role='dimension' type='nominal' />
            <column caption='mCVR3' datatype='real' name='[mCVR2 (copy)_1849572075083026432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([menu_checkout]) / COUNTD([shop_menu_no])' />
            </column>
            <column caption='mCVR4' datatype='real' name='[mCVR3 (copy)_1849572075083145217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([checkout_transaction]) / COUNTD([checkout_no])' />
            </column>
            <column caption='Menu Checkout' datatype='string' name='[menu_checkout]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1432426159578832896]' derivation='None' name='[none:Calculation_1432426159578832896:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Period]' derivation='None' name='[none:Period:nk]' pivot='key' type='nominal' />
            <column-instance column='[created_date]' derivation='None' name='[none:created_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[customer_status]' derivation='None' name='[none:customer_status:nk]' pivot='key' type='nominal' />
            <column-instance column='[target_group]' derivation='None' name='[none:target_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[zone_name]' derivation='None' name='[none:zone_name:nk]' pivot='key' type='nominal' />
            <column caption='Perseus Client Id' datatype='string' name='[perseus_client_id]' role='dimension' type='nominal' />
            <column caption='Shop List No' datatype='string' name='[shop_list_no]' role='dimension' type='nominal' />
            <column caption='Shop Menu No' datatype='string' name='[shop_menu_no]' role='dimension' type='nominal' />
            <column caption='Target Group' datatype='string' name='[target_group]' role='dimension' type='nominal' />
            <column caption='Transaction No' datatype='string' name='[transaction_no]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1432426159584505862]' derivation='User' name='[usr:Calculation_1432426159584505862:qk]' pivot='key' type='quantitative' />
            <column caption='Zone Name' datatype='string' name='[zone_name]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <slices>
            <column>[federated.1xaudv403ukebu1en7l7j1axx89u].[none:zone_name:nk]</column>
            <column>[federated.1xaudv403ukebu1en7l7j1axx89u].[none:created_date:qk]</column>
            <column>[federated.1xaudv403ukebu1en7l7j1axx89u].[none:customer_status:nk]</column>
            <column>[federated.1xaudv403ukebu1en7l7j1axx89u].[none:target_group:nk]</column>
            <column>[federated.1xaudv403ukebu1en7l7j1axx89u].[none:Period:nk]</column>
            <column>[federated.1xaudv403ukebu1en7l7j1axx89u].[none:Calculation_1432426159578832896:ok]</column>
          </slices>
          <aggregation value='true' />
        </view>
