      </column>
      <column caption='KPI_Displayed' datatype='real' name='[Calculation_1328843367833772033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;# Orders&apos; THEN COUNTD([order_id])&#13;&#10;    WHEN &apos;Tot DF&apos; THEN SUM([Correct_DF])&#13;&#10;    WHEN &apos;Tot Commission&apos; THEN SUM([commission_local])&#13;&#10;    WHEN &apos;Tot GFV&apos; THEN SUM([gfv_local])&#13;&#10;    WHEN &apos;Tot Revenue&apos; THEN SUM([revenue_local])&#13;&#10;    WHEN &apos;Tot Delivery Costs&apos; THEN SUM([delivery_costs_local])&#13;&#10;    WHEN &apos;Tot Gross Profit&apos; THEN SUM([gross_profit_local])&#13;&#10;    WHEN &apos;Avg DF&apos; THEN SUM([Correct_DF]) / COUNTD([order_id])&#13;&#10;    WHEN &apos;Avg Commission&apos; THEN SUM([commission_local]) / COUNTD([order_id])&#13;&#10;    WHEN &apos;Avg GFV&apos; THEN SUM([gfv_local]) / COUNTD([order_id])&#13;&#10;    WHEN &apos;Avg Revenue&apos; THEN SUM([revenue_local]) / COUNTD([order_id])&#13;&#10;    WHEN &apos;Avg Delivery Costs&apos; THEN SUM([delivery_costs_local]) / COUNTD([order_id])&#13;&#10;    WHEN &apos;Avg Gross Profit&apos; THEN SUM([gross_profit_local]) / COUNTD([order_id])&#13;&#10;    WHEN &apos;Avg Travel Time&apos; THEN AVG([travel_time])&#13;&#10;    WHEN &apos;Avg Delivery Dist&apos; THEN AVG([delivery_distance_m])&#13;&#10;    WHEN &apos;Avg Fleet Delay&apos; THEN AVG([mean_delay])&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Days Since Start of Period' datatype='integer' name='[Calculation_1465640206566637580]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF [Period] = &apos;Pre-Period&apos; &#13;&#10;    THEN DATEDIFF(&apos;day&apos;, {Fixed [Period] : MIN(IF [Period] = &apos;Pre-Period&apos; THEN [created_date] END)}, [created_date]) + 1&#13;&#10;    ELSE DATEDIFF(&apos;day&apos;, {Fixed [Period] : MIN(IF [Period] = &apos;Post-Period&apos; THEN [created_date] END)}, [created_date]) + 1&#13;&#10;END' />
      </column>
      <column caption='Avg GFV' datatype='real' name='[Calculation_1465640206574563343]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gfv_local])/COUNTD([order_id])' />
      </column>
      <column caption='Avg Revenue' datatype='real' name='[Calculation_1465640206574829584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([revenue_local])/COUNTD([order_id])' />
      </column>
      <column caption='Avg Gross Profit' datatype='real' name='[Calculation_1465640206575058961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gross_profit_local])/COUNTD([order_id])' />
      </column>
      <column caption='Avg DF' datatype='real' name='[Calculation_1465640206578688018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Correct_DF]) / COUNTD([order_id])' />
      </column>
      <column caption='Avg Commission' datatype='real' name='[Calculation_1465640206578786323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([commission_local]) / COUNTD([order_id])' />
      </column>
      <column caption='Avg Delivery Costs' datatype='real' name='[Calculation_1465640206578946068]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_costs_local]) / COUNTD([order_id])' />
      </column>
      <column caption='KPI_Disp_Pre' datatype='real' name='[Calculation_654710813510828032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MAX([Period]) = &apos;Pre-Period&apos; THEN [Calculation_1328843367833772033] END' />
      </column>
      <column caption='KPI_Disp_Diff' datatype='real' name='[Calculation_654710813510991874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;    WHEN &apos;30 Days&apos; THEN ZN([KPI_Disp_Pre (copy)_654710813510918145]) / LOOKUP(ZN([Calculation_654710813510828032]), 30) - 1&#13;&#10;    WHEN &apos;29 Days&apos; THEN ZN([KPI_Disp_Pre (copy)_654710813510918145]) / LOOKUP(ZN([Calculation_654710813510828032]), 29) - 1&#13;&#10;    WHEN &apos;28 Days&apos; THEN ZN([KPI_Disp_Pre (copy)_654710813510918145]) / LOOKUP(ZN([Calculation_654710813510828032]), 28) - 1&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' name='[Correct_DF]' role='measure' type='quantitative' />
      <column caption='KPI_Disp_Post' datatype='real' name='[KPI_Disp_Pre (copy)_654710813510918145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN([Period]) = &apos;Post-Period&apos; THEN [Calculation_1328843367833772033] END' />
      </column>
