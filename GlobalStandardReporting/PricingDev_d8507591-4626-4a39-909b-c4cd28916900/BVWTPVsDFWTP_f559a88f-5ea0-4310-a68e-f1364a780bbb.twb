    <worksheet name='KPI Bubbles'>
      <layout-options>
        <title>
          <formatted-text>
            <run>DF WTP Vs. BV WTP Matrix&#10;</run>
            <run bold='true' fontcolor='#ff0000' fontsize='11'>Notes:</run>
            <run>Æ&#10;</run>
            <run fontsize='10'>DF/BV Incentivized orders are </run>
            <run bold='true' fontsize='10'>excluded</run>
            <run>Æ&#10;</run>
            <run fontsize='10'>Customers who placed less than 5 orders over the last 60 days are </run>
            <run bold='true' fontsize='10'>excluded</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ff0000' fontsize='11'>How was the classification done? (Two Ways)</run>
            <run>Æ&#10;</run>
            <run fontsize='10'>- The AFV/customer AND avg DF/customer</run>
            <run bold='true' fontsize='10'>Æ </run>
            <run fontsize='10'>were computed</run>
            <run>Æ&#10;</run>
            <run fontsize='10'>- </run>
            <run bold='true' fontsize='10'>Method 1 (Comparing Customers to Each Other): </run>
            <run fontsize='10'>The AFV/customer and avg DF/customer </run>
            <run bold='true' fontsize='10'>distributions </run>
            <run fontsize='10'>were split into </run>
            <run bold='true' fontsize='10'>three parts </run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='10'>      *** (AFV/Avg DF per cust </run>
            <run fontsize='10'>&lt;= 33rd percentile = </run>
            <run bold='true' fontsize='10'>LOW WTP</run>
            <run fontsize='10'><![CDATA[; if it is > 33rd AND <= 66th percentile = ]]></run>
            <run bold='true' fontsize='10'>INTERMEDIATE WTP</run>
            <run fontsize='10'>; if it is &gt; 66th percentile = </run>
            <run bold='true' fontsize='10'>HIGH WTP</run>
            <run fontsize='10'>)</run>
            <run>Æ&#10;</run>
            <run fontsize='10'>- </run>
            <run bold='true' fontsize='10'>Method 2 (Comparing Customers to Individual Orders): </run>
            <run fontsize='10'>The </run>
            <run bold='true' fontsize='10'>order-level </run>
            <run fontsize='10'>GFV and DF distributions were split into </run>
            <run bold='true' fontsize='10'>three parts</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='10'>      *** </run>
            <run fontsize='10'>The same classification rules were applied, but the distribution uses to calculate percentile ranks was different</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ff0000' fontsize='11' underline='true'>Example:</run>
            <run bold='true' fontcolor='#ff0000' fontsize='11'> How to read the upper leftmost circle in the matrix below (assuming the KPI chosen is % orders)?</run>
            <run bold='true' fontcolor='#ff0000' fontsize='10'>Æ </run>
            <run bold='true' fontcolor='#000000' fontsize='10'>x%</run>
            <run fontcolor='#000000' fontsize='10'> of all OD </run>
            <run bold='true' fontcolor='#000000' fontsize='10'>(vertical)</run>
            <run fontcolor='#000000' fontsize='10'> orders in </run>
            <run bold='true' fontcolor='#000000' fontsize='10'>(region/country) </run>
            <run fontcolor='#000000' fontsize='10'>between </run>
            <run bold='true' fontcolor='#000000' fontsize='10'>(date y) </run>
            <run fontcolor='#000000' fontsize='10'>and </run>
            <run bold='true' fontcolor='#000000' fontsize='10'>(date z) </run>
            <run fontcolor='#000000' fontsize='10'>were placed by customers with a </run>
            <run bold='true' fontcolor='#000000' fontsize='10'>high DF AND high BV WTP</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bv_wtp_vs_df_wtp' name='federated.0pxx3g60w53q1n15o1m5g13w9129' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric_Param' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Orders&quot;'>
              <calculation class='tableau' formula='&quot;% Orders&quot;' />
            </column>
            <column caption='Classification Method' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Comparing Customers to Each Other&quot;'>
              <calculation class='tableau' formula='&quot;Comparing Customers to Each Other&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0pxx3g60w53q1n15o1m5g13w9129'>
            <column caption='# Customers' datatype='integer' name='[# Orders (copy)_313281660367708166]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([perseus_client_id])' />
            </column>
            <column caption='Similar_WTP_Order_Count' datatype='integer' name='[Calculation_1072982622830981124]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF ([GFV_WTP_Var (copy)_1072982622835531786] = &apos;High DF WTP&apos; AND [Calculation_1072982622835224585] = &apos;High BV WTP&apos;)&#13;&#10;    OR&#13;&#10;    ([GFV_WTP_Var (copy)_1072982622835531786] = &apos;Intermediate DF WTP&apos; AND [Calculation_1072982622835224585] = &apos;Intermediate BV WTP&apos;)&#13;&#10;    OR&#13;&#10;    ([GFV_WTP_Var (copy)_1072982622835531786] = &apos;Low DF WTP&apos; AND [Calculation_1072982622835224585] = &apos;Low BV WTP&apos;)&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END)' />
            </column>
            <column caption='Total_Orders_Reg_Ent_Vert' datatype='integer' name='[Calculation_1072982622832435206]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Created Date, Entity Id, Region and 1 more (Combined)] : COUNTD([order_id])}' />
            </column>
            <column caption='Similar_WTP_Order%' datatype='real' name='[Calculation_1072982622832893959]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1072982622830981124]/SUM([Calculation_1072982622832435206])' />
            </column>
            <column caption='Different_WTP_Order%' datatype='real' name='[Calculation_1072982622833704968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-[Calculation_1072982622832893959]' />
            </column>
            <column caption='GFV_WTP_Var' datatype='string' name='[Calculation_1072982622835224585]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#13;&#10;    WHEN &apos;Comparing Customers to Each Other&apos; THEN [gfv_wtp]&#13;&#10;    WHEN &apos;Comparing Customers to Individual Orders&apos; THEN [gfv_wtp_v2]&#13;&#10;END' />
            </column>
            <column caption='Selected Measure Suffix' datatype='string' name='[Calculation_1072982622837342219]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;# Orders&apos; THEN &apos;&apos;&#13;&#10;    WHEN &apos;% Orders&apos; THEN &apos;%&apos;&#13;&#10;    WHEN &apos;# Customers&apos; THEN &apos;&apos;&#13;&#10;    WHEN &apos;Avg Revenue&apos; THEN &apos;&apos;&#13;&#10;    WHEN &apos;Avg Delivery Costs&apos; THEN &apos;&apos;&#13;&#10;    WHEN &apos;Avg Gross Profit&apos; THEN &apos;&apos;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Metric_Displayed' datatype='real' name='[Calculation_1108448463843594240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;# Orders&apos; THEN [Calculation_313281660356370432]&#13;&#10;    WHEN &apos;% Orders&apos; THEN [Calculation_313281660356452353]*100&#13;&#10;    WHEN &apos;# Customers&apos; THEN [# Orders (copy)_313281660367708166]&#13;&#10;    WHEN &apos;Avg Revenue&apos; THEN [Calculation_313281660356636674]&#13;&#10;    WHEN &apos;Avg Delivery Costs&apos; THEN [Calculation_313281660356780035]&#13;&#10;    WHEN &apos;Avg Gross Profit&apos; THEN [Calculation_313281660356870148]&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Order Count_REV' datatype='integer' name='[Calculation_1108448463864172571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Created Date, Entity Id, Region and 1 more (Combined)] : COUNTD([order_id])}' />
            </column>
            <column caption='# Orders' datatype='integer' name='[Calculation_313281660356370432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([order_id])' />
            </column>
            <column caption='% Orders' datatype='real' default-format='p0.00%' name='[Calculation_313281660356452353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([order_id])/SUM([Calculation_1108448463864172571])' />
            </column>
            <column caption='Avg Revenue' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Calculation_313281660356636674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([revenue_local])/COUNTD([order_id])' />
            </column>
            <column caption='Avg Delivery Costs' datatype='real' default-format='n#,##0.00;-#,##0.00' hidden='true' name='[Calculation_313281660356780035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_costs_local])/COUNTD([order_id])' />
            </column>
            <column caption='Avg Gross Profit' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_313281660356870148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gross_profit_local])/COUNTD([order_id])' />
            </column>
            <column caption='DF_WTP_Var' datatype='string' name='[GFV_WTP_Var (copy)_1072982622835531786]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#13;&#10;    WHEN &apos;Comparing Customers to Each Other&apos; THEN [df_wtp]&#13;&#10;    WHEN &apos;Comparing Customers to Individual Orders&apos; THEN [df_wtp_v2]&#13;&#10;END' />
            </column>
            <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='Delivery Costs Local' datatype='real' hidden='true' name='[delivery_costs_local]' role='measure' type='quantitative' />
            <column caption='Df Wtp' datatype='string' name='[df_wtp]' role='dimension' type='nominal' />
            <column datatype='string' name='[df_wtp_v2]' role='dimension' type='nominal' />
            <column caption='Dps Customer Tag' datatype='string' name='[dps_customer_tag]' role='dimension' type='nominal' />
            <column caption='Entity Id' datatype='string' name='[entity_id]' role='dimension' type='nominal' />
            <column caption='Gfv Wtp' datatype='string' name='[gfv_wtp]' role='dimension' type='nominal' />
            <column datatype='string' name='[gfv_wtp_v2]' role='dimension' type='nominal' />
            <column caption='Gross Profit Local' datatype='real' hidden='true' name='[gross_profit_local]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1072982622835224585]' derivation='None' name='[none:Calculation_1072982622835224585:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1072982622837342219]' derivation='None' name='[none:Calculation_1072982622837342219:nk]' pivot='key' type='nominal' />
            <column-instance column='[GFV_WTP_Var (copy)_1072982622835531786]' derivation='None' name='[none:GFV_WTP_Var (copy)_1072982622835531786:nk]' pivot='key' type='nominal' />
