            <column caption='Revenue Local' datatype='real' hidden='true' name='[revenue_local]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1072982622833704968]' derivation='User' name='[usr:Calculation_1072982622833704968:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1108448463843594240]' derivation='User' name='[usr:Calculation_1108448463843594240:qk]' pivot='key' type='quantitative' />
            <column caption='Vertical Type' datatype='string' name='[vertical_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0pxx3g60w53q1n15o1m5g13w9129].[:Measure Names]'>
            <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0pxx3g60w53q1n15o1m5g13w9129].[usr:Calculation_1072982622833704968:qk]&quot;' user:op='manual' />
