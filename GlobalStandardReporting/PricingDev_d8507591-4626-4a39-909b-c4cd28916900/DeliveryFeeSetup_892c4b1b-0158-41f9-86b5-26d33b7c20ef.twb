                <alias key='true' value='Free' />
              </aliases>
            </column>
            <column caption='City' datatype='string' name='[Calculation_951104000350076954]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if len(trim([city])) &gt; 0 then&#13;&#10;    upper(left(trim(split([city],&quot; &quot;,1)),1)) + lower(right(trim(split([city],&quot; &quot;,1)),if len(trim(split([city],&quot; &quot;,1))) &gt; 1 then len(trim(split([city],&quot; &quot;,1)))-1 else 0 end))&#13;&#10;    else &quot;&quot; end&#13;&#10;   +&#13;&#10;    if len(trim(split([city],&quot; &quot;,2))) &gt; 0 then&#13;&#10;    &quot; &quot; + upper(left(trim(split([city],&quot; &quot;,2)),1)) + lower(right(trim(split([city],&quot; &quot;,2)),if len(trim(split([city],&quot; &quot;,2))) &gt; 1 then len(trim(split([city],&quot; &quot;,2)))-1 else 0 end))&#13;&#10;    else &quot;&quot; end&#13;&#10;   +&#13;&#10;   if len(trim(split([city],&quot; &quot;,3))) &gt; 0 then&#13;&#10;    &quot; &quot; + upper(left(trim(split([city],&quot; &quot;,3)),1)) + lower(right(trim(split([city],&quot; &quot;,3)),if len(trim(split([city],&quot; &quot;,3))) &gt; 1 then len(trim(split([city],&quot; &quot;,3)))-1 else 0 end))&#13;&#10;   else &quot;&quot; end&#13;&#10;   +&#13;&#10;   if len(trim(split([city],&quot; &quot;,4))) &gt; 0 then&#13;&#10;   &quot; &quot; + upper(left(trim(split([city],&quot; &quot;,4)),1)) + lower(right(trim(split([city],&quot; &quot;,4)),if len(trim(split([city],&quot; &quot;,4))) &gt; 1 then len(trim(split([city],&quot; &quot;,4)))-1 else 0 end))&#13;&#10;   else &quot;&quot; end&#13;&#10;   +&#13;&#10;   if len(trim(split([city],&quot; &quot;,5))) &gt; 0 then&#13;&#10;   &quot; &quot; + upper(left(trim(split([city],&quot; &quot;,5)),1)) + lower(right(trim(split([city],&quot; &quot;,5)),if len(trim(split([city],&quot; &quot;,5))) &gt; 1 then len(trim(split([city],&quot; &quot;,5)))-1 else 0 end))&#13;&#10;   else &quot;&quot; end' />
            </column>
