      </column>
      <column caption='Detail grouped' datatype='string' name='[Calculation_904660589759197201]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Set 1] THEN [Calculation_908038289195266059] ELSE &apos;Other&apos; END' />
      </column>
      <column caption='Currency' datatype='string' name='[Calculation_904660589761249300]' role='dimension' type='nominal'>
