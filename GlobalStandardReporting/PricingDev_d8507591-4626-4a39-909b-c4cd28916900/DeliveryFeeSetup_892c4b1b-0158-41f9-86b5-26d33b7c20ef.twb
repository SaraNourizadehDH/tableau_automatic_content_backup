      <table>
        <view>
          <datasources>
            <datasource caption='delivery_fee_pricing_report (dwh_bl.delivery_fee_pricing_report) (dwh_bl)' name='federated.0wo5e5i08sn81n1gat8ov1dxxons' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selector' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;City&quot;'>
              <calculation class='tableau' formula='&quot;City&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0wo5e5i08sn81n1gat8ov1dxxons'>
            <column caption='SUM({ EXCLUDE  [city],[Delivery Provider],[Brand] : SUM([Succ...' datatype='real' name='[Calculation_904660589755572232]' role='measure' type='quantitative' user:unnamed='Order share'>
              <calculation class='tableau' formula='SUM({ EXCLUDE  [city],[is_dh_delivery],[brand_name] : SUM([successful_orders])}) / TOTAL(SUM([successful_orders]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Detail grouped' datatype='string' name='[Calculation_904660589759197201]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Set 1] THEN [Calculation_908038289195266059] ELSE &apos;Other&apos; END' />
            </column>
            <column caption='Currency' datatype='string' name='[Calculation_904660589761249300]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;$&apos;+[currency_code]' />
            </column>
            <column caption='Detail' datatype='string' name='[Calculation_908038289195266059]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(IF [Parameters].[Parameter 1] = &apos;City&apos; THEN [Calculation_951104000350076954]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Brand&apos; THEN [brand_name]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Entity&apos; THEN [display_name]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Country&apos; THEN [common_name]&#13;&#10;END,20)' />
              <aliases>
                <alias key='&quot;-Other&quot;' value='Other' />
              </aliases>
            </column>
            <column caption='Orders/day' datatype='real' name='[Calculation_908038289201053709]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders])/COUNTD([order_date])' />
            </column>
            <column caption='Max by Key Account' datatype='integer' name='[Calculation_951104000320720901]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX({ FIXED [source_id],[Calculation_951104000350076954],[brand_name],[order_date],[is_dh_delivery]:COUNTD(IF [brand_name] = &apos;-Other&apos; THEN NULL ELSE [amt_delivery_fee_lc] END)})' />
            </column>
            <column caption='Delivery Fee' datatype='boolean' name='[Calculation_951104000344477719]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[amt_delivery_fee_lc]=0' />
              <aliases>
                <alias key='false' value='Paid' />
                <alias key='true' value='Free' />
              </aliases>
            </column>
            <column caption='City' datatype='string' name='[Calculation_951104000350076954]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if len(trim([city])) &gt; 0 then&#13;&#10;    upper(left(trim(split([city],&quot; &quot;,1)),1)) + lower(right(trim(split([city],&quot; &quot;,1)),if len(trim(split([city],&quot; &quot;,1))) &gt; 1 then len(trim(split([city],&quot; &quot;,1)))-1 else 0 end))&#13;&#10;    else &quot;&quot; end&#13;&#10;   +&#13;&#10;    if len(trim(split([city],&quot; &quot;,2))) &gt; 0 then&#13;&#10;    &quot; &quot; + upper(left(trim(split([city],&quot; &quot;,2)),1)) + lower(right(trim(split([city],&quot; &quot;,2)),if len(trim(split([city],&quot; &quot;,2))) &gt; 1 then len(trim(split([city],&quot; &quot;,2)))-1 else 0 end))&#13;&#10;    else &quot;&quot; end&#13;&#10;   +&#13;&#10;   if len(trim(split([city],&quot; &quot;,3))) &gt; 0 then&#13;&#10;    &quot; &quot; + upper(left(trim(split([city],&quot; &quot;,3)),1)) + lower(right(trim(split([city],&quot; &quot;,3)),if len(trim(split([city],&quot; &quot;,3))) &gt; 1 then len(trim(split([city],&quot; &quot;,3)))-1 else 0 end))&#13;&#10;   else &quot;&quot; end&#13;&#10;   +&#13;&#10;   if len(trim(split([city],&quot; &quot;,4))) &gt; 0 then&#13;&#10;   &quot; &quot; + upper(left(trim(split([city],&quot; &quot;,4)),1)) + lower(right(trim(split([city],&quot; &quot;,4)),if len(trim(split([city],&quot; &quot;,4))) &gt; 1 then len(trim(split([city],&quot; &quot;,4)))-1 else 0 end))&#13;&#10;   else &quot;&quot; end&#13;&#10;   +&#13;&#10;   if len(trim(split([city],&quot; &quot;,5))) &gt; 0 then&#13;&#10;   &quot; &quot; + upper(left(trim(split([city],&quot; &quot;,5)),1)) + lower(right(trim(split([city],&quot; &quot;,5)),if len(trim(split([city],&quot; &quot;,5))) &gt; 1 then len(trim(split([city],&quot; &quot;,5)))-1 else 0 end))&#13;&#10;   else &quot;&quot; end' />
            </column>
            <column caption='Main Partner' datatype='boolean' name='[Calculation_951104000377921573]' role='dimension' type='nominal'>
