          <datasource-dependencies datasource='federated.0wo5e5i08sn81n1gat8ov1dxxons'>
            <column caption='Detail grouped' datatype='string' name='[Calculation_904660589759197201]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Set 1] THEN [Calculation_908038289195266059] ELSE &apos;Other&apos; END' />
            </column>
            <column caption='Currency' datatype='string' name='[Calculation_904660589761249300]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;$&apos;+[currency_code]' />
            </column>
            <column caption='SUM([Successful Orders])/ TOTAL(SUM([Successful Orders])) &lt; 0.01' datatype='boolean' name='[Calculation_904660589773566012]' role='measure' type='nominal' user:unnamed='DF price'>
              <calculation class='tableau' formula='SUM([successful_orders])/ TOTAL(SUM([successful_orders])) &lt; 0.01'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='SUM([Successful Orders]) / TOTAL(SUM([Successful Orders]))' datatype='real' name='[Calculation_904660589776420926]' role='measure' type='quantitative' user:unnamed='DF price (2)'>
              <calculation class='tableau' formula='SUM([successful_orders]) / TOTAL(SUM([successful_orders]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Detail' datatype='string' name='[Calculation_908038289195266059]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(IF [Parameters].[Parameter 1] = &apos;City&apos; THEN [Calculation_951104000350076954]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Brand&apos; THEN [brand_name]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Entity&apos; THEN [display_name]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Country&apos; THEN [common_name]&#13;&#10;END,20)' />
