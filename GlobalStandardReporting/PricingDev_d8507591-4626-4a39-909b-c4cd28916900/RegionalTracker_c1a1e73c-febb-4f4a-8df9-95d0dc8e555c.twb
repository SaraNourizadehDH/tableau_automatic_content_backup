    <worksheet name='Regional Tracker'>
      <table>
        <view>
          <datasources>
            <datasource caption='regional_tracker_cl (pricing)' name='federated.05dck6i00gfso71chfzuc0zj4eod' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05dck6i00gfso71chfzuc0zj4eod'>
            <column caption='DF Revenue' datatype='real' name='[Calculation_2197686252901199873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Euro&quot; THEN [DF_Revenue_EUR] ELSE [DF_Revenue_local] END' />
            </column>
            <column caption='Commission Revenue' datatype='real' name='[Calculation_2197686252901699586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Euro&quot; THEN [Commission_Revenue_EUR] ELSE [Commission_Revenue_local] END' />
            </column>
            <column caption='Basket Value' datatype='real' name='[Calculation_2197686252932050947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Euro&quot; THEN SUM([Total_BV_EUR])/SUM([number_orders]) ELSE SUM([Total_BV_local])/SUM([number_orders]) END' />
            </column>
            <column caption='Average DF' datatype='real' name='[Calculation_5709086629126533120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Euro&quot; THEN&#10;SUM([DF_Revenue_EUR])/SUM([number_orders])&#10;ELSE SUM([DF_Revenue_local])/SUM([number_orders])END' />
            </column>
            <column caption='DF/AFV' datatype='real' datatype-customized='true' default-format='p0.0%' name='[Calculation_5709086629128908801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &quot;Euro&quot; THEN SUM([DF_Revenue_EUR])/SUM([Total_BV_EUR]) ELSE SUM([DF_Revenue_local])/SUM([Total_BV_local]) END' />
            </column>
            <column caption='FD Share' datatype='real' default-format='p0.0%' name='[Calculation_5709086629143797763]' role='measure' type='quantitative'>
