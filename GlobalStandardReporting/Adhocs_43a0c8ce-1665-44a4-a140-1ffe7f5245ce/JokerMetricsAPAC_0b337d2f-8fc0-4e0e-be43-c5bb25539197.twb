      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.015e7h91y3j0gw14xv83b1b30py6].[sum:joker_available:qk]&quot;' value='Joker Inventory' />
          <alias key='&quot;[federated.015e7h91y3j0gw14xv83b1b30py6].[sum:joker_offered:qk]&quot;' value='Joker Impressions' />
          <alias key='&quot;[federated.015e7h91y3j0gw14xv83b1b30py6].[sum:joker_order_gmv_eur:qk]&quot;' value='Joker Gmv' />
          <alias key='&quot;[federated.015e7h91y3j0gw14xv83b1b30py6].[sum:joker_revenue_eur:qk]&quot;' value='Joker Revenue' />
          <alias key='&quot;[federated.015e7h91y3j0gw14xv83b1b30py6].[sum:total_gmv_eur:qk]&quot;' value='Total Gmv' />
        </aliases>
      </column>
      <column caption='Avg Joker Fee' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4272367956860907520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([joker_revenue_eur]) / SUM([joker_orders])' />
      </column>
      <column caption='Joker / Total Orders' datatype='real' default-format='p0.0%' name='[Calculation_4272367956861505537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([joker_orders]) / SUM([total_orders])' />
      </column>
      <column caption='Days in Month' datatype='integer' name='[Calculation_4272367956861849602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,[report_month]))))' />
      </column>
      <column caption='Joker Inventory per Vendor per Day' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4272367956862676995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([joker_available]) / SUM([joker_vendors]) / [Calculation_4272367956861849602]' />
      </column>
      <column caption='Joker Utilisation' datatype='real' default-format='p0.0%' name='[Calculation_4272367956863111173]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([joker_orders]) / SUM([joker_available])' />
      </column>
      <column caption='CVR' datatype='real' default-format='p0.00%' name='[Calculation_4272367956864753670]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([joker_orders]) / SUM([joker_offered])' />
      </column>
      <column caption='Total Orders Share' datatype='real' default-format='p0.0%' name='[Calculation_4272367956867399687]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_orders]) / SUM(&#10;{ FIXED [report_month], [region], [management_entity], [sub_entity] : SUM([total_orders]) }&#10;)' />
