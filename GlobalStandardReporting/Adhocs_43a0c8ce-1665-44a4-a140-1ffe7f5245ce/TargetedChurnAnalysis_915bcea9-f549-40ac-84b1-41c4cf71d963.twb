      <aliases enabled='yes' />
      <column caption='% Churn Revenue Loss' datatype='real' default-format='p0%' name='[% Churn Order Loss (copy)_279223224391774217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Churn Order Loss (copy)_279223224391643144]) / SUM([targeted_deal_charge_eur_pm])' />
      </column>
      <column caption='% Churn rate' datatype='real' default-format='p0%' name='[Calculation_1448681384194568192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_279223224392769546] / [Calculation_279223224663310353]' />
      </column>
      <column caption='Metric' datatype='string' name='[Calculation_2655786822461177856]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2]' />
      </column>
      <column caption='Split by' datatype='string' name='[Calculation_279223224293715969]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;Nothing&quot; THEN NULL&#10;    WHEN &quot;Vendor Class&quot; THEN [vendor_class]&#10;    WHEN &quot;Account Segment&quot; THEN [account_segment]&#10;END' />
      </column>
      <column caption='% Order UTR' datatype='real' default-format='p0%' name='[Calculation_279223224308654083]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_targeted_orders]) / SUM([total_orders])' />
      </column>
      <column caption='Churn Order Loss' datatype='integer' name='[Calculation_279223224390115334]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [incentive_churn] THEN [total_targeted_orders_pm] END' />
      </column>
      <column caption='% Churn Order Loss' datatype='real' default-format='p0%' name='[Calculation_279223224390922247]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_279223224390115334]) / SUM([total_targeted_orders_pm])' />
      </column>
      <column caption='Churned Vendors' datatype='integer' name='[Calculation_279223224392769546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [incentive_churn] THEN [vendor_id] END)' />
      </column>
      <column caption='Churn' datatype='string' name='[Calculation_279223224395882507]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [incentive_churn]&#10;    WHEN TRUE THEN &apos;Churn&apos;&#10;    WHEN FALSE THEN &apos;No Churn&apos;&#10;END' />
      </column>
      <column caption='% Discount Depth' datatype='real' default-format='p0%' name='[Calculation_279223224396800012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([discount_value_eur]) / SUM([targeted_order_gmv_eur])' />
      </column>
      <column caption='% ROI' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_279223224397307917]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([targeted_order_gmv_eur]) / SUM([discount_value_eur] + [targeted_deal_charge_eur])' />
      </column>
      <column caption='# vendors' datatype='integer' name='[Calculation_279223224663310353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_id])' />
      </column>
      <column caption='Churn split' datatype='string' name='[Calculation_5322410387738648577]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN TRUE THEN [Calculation_279223224395882507]&#10;    WHEN FALSE THEN NULL&#10;END' />
      </column>
      <column caption='Churn Revenue Loss' datatype='real' name='[Churn Order Loss (copy)_279223224391643144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [incentive_churn] THEN [targeted_deal_charge_eur_pm] END' />
      </column>
