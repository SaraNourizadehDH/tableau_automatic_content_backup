      <column caption='CTR Deduplicated' datatype='real' default-format='p0.00%' name='[CTR (copy)_1228708674378567680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([cpm_clicks_deduplicated]))/SUM(ZN([impressions]))' />
      </column>
      <column caption='CTR Total' datatype='real' default-format='p0.00%' name='[CTR (copy)_2418855245007790080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([cpm_clicks_total (ad_tech_il_display_ads_creative_id)]))/SUM(ZN([impressions]))' />
      </column>
      <column caption='% Revenue Target Achievement' datatype='real' default-format='p0.0%' name='[Calculation_1291829462048546818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([Calculation_1291829462049595395]))/SUM(ZN([display_ads_vendors_mtd_target]))' />
      </column>
      <column caption='Vendor / Chain Revenue' datatype='real' name='[Calculation_1291829462049595395]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [advertiser_type] = &apos;chain&apos; OR [advertiser_type] = &apos;restaurants&apos; THEN [revenue_eur] END' />
      </column>
      <column caption='UTC Date end' datatype='date' name='[Calculation_2667327277868613632]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([iso_date])' />
      </column>
      <column caption='Date Range' datatype='boolean' name='[Calculation_2667327277935669249]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[iso_date] &gt;= [Parameters].[Parameter 11] AND [iso_date] &lt;= [Parameters].[Start Date (copy)_4846787997235015682]' />
      </column>
      <column caption='exclude new' datatype='boolean' name='[Calculation_3410139767804633089]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[iso_date]&gt;=date([started_at_utc])' />
      </column>
      <column caption='Campaign Monthly Budget' datatype='real' name='[Calculation_3410139767805005826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [campaign_id], DATETRUNC(&apos;month&apos;,[iso_date]):MAX([budget_eur]-zn([cumulative_revenue_eur])+zn([revenue_eur]))}' />
      </column>
      <column caption='Daily Budget Achieved %' datatype='real' default-format='p0.0%' name='[Calculation_3410139767805288451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//WINDOW_SUM(sum([Revenue Eur]))/SUM(ZN([Campaign Budget]))&#10;sum(zn([cumulative_revenue_eur]))/SUM(ZN([Campaign Budget Motnhly (copy)_46724902770409476]))' />
      </column>
      <column caption='AVG CPM' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_3410139767812608005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(ZN([revenue_eur]))/(sum(ZN([impressions]))/1000)' />
      </column>
      <column caption='AVG Campaign Duration' datatype='real' name='[Calculation_3410139767813550086]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [campaign_id]: AVG([duration])}' />
      </column>
      <column caption='Campaigns' datatype='integer' name='[Calculation_3410139767814447111]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([campaign_id])' />
      </column>
      <column caption='Advertisers' datatype='integer' name='[Calculation_3410139767814590472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([advertiser_id])' />
      </column>
      <column caption='Data Up To' datatype='date' name='[Calculation_3410139767816335369]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED &apos;A&apos; : MAX([iso_date])}' />
      </column>
      <column caption='CTR' datatype='real' default-format='p0.00%' name='[Calculation_3410139768037572618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([cpm_clicks]))/SUM(ZN([impressions]))' />
      </column>
      <column caption='View' datatype='string' name='[Calculation_4656229490689548288]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2]' />
      </column>
      <column caption='View txt' datatype='string' name='[Calculation_4656229490691760129]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 2] &#10;when &apos;Display KPIs&apos; then &apos;Display Main KPIs&apos;&#10;when &apos;MTD Targets&apos; then &apos;Display Target Achievement&apos;&#10;end' />
      </column>
      <column caption='Monthly Budget' datatype='real' name='[Calculation_6335227674724610054]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Exclude&apos; THEN [Campaign Monthly Budget (copy)_6335227674723889155] &#10;ELSEIF &#10;[Parameters].[Parameter 1]=&apos;Include&apos; THEN [Calculation_3410139767805005826] &#10;END' />
      </column>
      <column caption='Creative CTR' datatype='real' default-format='p0.0%' name='[Calculation_6335227674726174728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(zn([cpm_clicks (ad_tech_il_display_ads_creative_id)]))/&#10;SUM(ZN([impressions (ad_tech_il_display_ads_creative_id)]))' />
