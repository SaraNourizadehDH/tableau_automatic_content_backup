      <table>
        <view>
          <datasources>
            <datasource caption='ad_tech_il_display_ads (analytics)' name='federated.1vr08nl1j3cwj312utfe30jwh397' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Cancelled Budget' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Exclude&quot;'>
              <calculation class='tableau' formula='&quot;Exclude&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vr08nl1j3cwj312utfe30jwh397'>
            <column caption='CTR Total' datatype='real' default-format='p0.00%' name='[CTR (copy)_2418855245007790080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([cpm_clicks_total (ad_tech_il_display_ads_creative_id)]))/SUM(ZN([impressions]))' />
            </column>
            <column caption='exclude new' datatype='boolean' name='[Calculation_3410139767804633089]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[iso_date]&gt;=date([started_at_utc])' />
            </column>
            <column caption='Campaign Monthly Budget' datatype='real' name='[Calculation_3410139767805005826]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [campaign_id], DATETRUNC(&apos;month&apos;,[iso_date]):MAX([budget_eur]-zn([cumulative_revenue_eur])+zn([revenue_eur]))}' />
            </column>
            <column caption='AVG CPM' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_3410139767812608005]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(ZN([revenue_eur]))/(sum(ZN([impressions]))/1000)' />
            </column>
            <column caption='AVG Campaign Duration' datatype='real' name='[Calculation_3410139767813550086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [campaign_id]: AVG([duration])}' />
            </column>
            <column caption='Campaigns' datatype='integer' name='[Calculation_3410139767814447111]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([campaign_id])' />
            </column>
            <column caption='Advertisers' datatype='integer' name='[Calculation_3410139767814590472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([advertiser_id])' />
            </column>
            <column caption='CTR' datatype='real' default-format='p0.00%' name='[Calculation_3410139768037572618]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([cpm_clicks]))/SUM(ZN([impressions]))' />
            </column>
            <column caption='Monthly Budget' datatype='real' name='[Calculation_6335227674724610054]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Exclude&apos; THEN [Campaign Monthly Budget (copy)_6335227674723889155] &#10;ELSEIF &#10;[Parameters].[Parameter 1]=&apos;Include&apos; THEN [Calculation_3410139767805005826] &#10;END' />
            </column>
            <column caption='Campaign Monthly Budget Excluding Cancelled' datatype='real' name='[Campaign Monthly Budget (copy)_6335227674723889155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [campaign_id], DATETRUNC(&apos;month&apos;,[iso_date]):MAX([budget_excl_cancelled_eur]-zn([cumulative_revenue_eur])+zn([revenue_eur]))}' />
            </column>
            <column caption='Monthly Budget Achieved %' datatype='real' default-format='p0.0%' name='[Daily Budget Achieved % (copy)_46724902759743489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//WINDOW_SUM(sum([Revenue Eur]))/SUM(ZN([Campaign Budget]))&#10;sum(zn([revenue_eur]))/SUM(ZN([Calculation_6335227674724610054]))' />
            </column>
