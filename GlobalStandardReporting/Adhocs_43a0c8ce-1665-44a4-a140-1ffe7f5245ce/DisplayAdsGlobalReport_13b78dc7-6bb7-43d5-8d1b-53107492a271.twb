      </column>
      <column caption='GMV eur TOTAL' datatype='real' name='[Calculation_2202119539924807682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([gmv_eur_marketing_effect]))+SUM(ZN([gmv_eur_post_click]))+SUM(ZN([gmv_eur_repeat_orders]))' />
      </column>
      <column caption='GMV eur (Post click + ME)' datatype='real' name='[Calculation_2202119539926347779]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([gmv_eur_marketing_effect]))+SUM(ZN([gmv_eur_post_click]))' />
      </column>
      <column caption='ROAS (Post click + MEffect)' datatype='real' name='[Calculation_2202119539926536196]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2202119539926347779]/SUM([revenue])' />
      </column>
      <column caption='ROAS (Post click)' datatype='real' name='[Calculation_2202119539926867973]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(ZN([gmv_eur_post_click]))/sum(ZN([revenue]))' />
      </column>
      <column caption='ROAS (MEffect)' datatype='real' name='[Calculation_2202119539927506950]' role='measure' type='quantitative'>
