      <aliases enabled='yes' />
      <column caption='1' datatype='integer' name='[Calculation_1543256945487622144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='0' datatype='integer' name='[Calculation_1543256945487646721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Month-Year Sort.' datatype='integer' name='[Calculation_1802354661559508993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([partition_date]) * 100 + MONTH([partition_date])' />
      </column>
      <column caption='Custom Label for Metric' datatype='string' name='[Calculation_2884696327099101185]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([country_name]) THEN [metric_name] + &quot; Total&quot;&#10;ELSE [country_name]&#10;&#10;END' />
      </column>
      <column caption='Actuals' datatype='real' name='[Calculation_2884696327438176261]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [type] = &apos;Actuals&apos; THEN [metric_value] END' />
      </column>
      <column caption='Targets' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Calculation_2884696327438225414]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [type] = &apos;Targets&apos; THEN [metric_value] END' />
      </column>
      <column caption='Metric selected' datatype='boolean' name='[Calculation_2884696328809873416]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[metric_name]=[Parameters].[Parameter 3]' />
      </column>
      <column caption='Total Vendors Ads Revenue' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Calculation_2884696328815730699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [metric_name] = &apos;Total Vendors Ads Revenue&apos; AND [type]=&apos;Actuals&apos; THEN [metric_value] END' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_2884696329548079119]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [metric_name] = &apos;Amt Gmv Eur&apos; and [type]=&apos;Actuals&apos; THEN [metric_value] END' />
      </column>
      <column caption='Deviation vs Target' datatype='real' default-format='p0.00%' name='[Calculation_3434839171537104896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_2884696327438176261])/ sum([Calculation_2884696327438225414])' />
      </column>
      <column caption='Row Number (calc)' datatype='integer' name='[Calculation_5785577429971464193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Diff Target Colour' datatype='string' name='[Calculation_585116134048997380]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [type] = &apos;vs Target %&apos; OR [type] = &apos;Change Period percent&apos;  OR [type] = &apos;Change Period absolute&apos;  THEN&#10;    IF [metric_value] &gt; 0 THEN&#10;        &quot;Overperforming&quot;&#10;    ELSEIF [metric_value] &lt; 0 THEN&#10;        &quot;Underperforming&quot;&#10;    ELSE&#10;        &quot;Performing&quot;&#10;    END&#10;ELSE&#10;    NULL&#10;END' />
      </column>
      <column caption='Level filter-1 ' datatype='boolean' name='[Calculation_6071555999923109888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN &apos;country&apos; THEN IF [level] = &apos;country&apos; THEN TRUE ELSE FALSE END&#10;  WHEN &apos;entity&apos; THEN IF [level] = &apos;entity&apos; THEN TRUE ELSE FALSE END&#10;  WHEN &apos;chain_name_cleaned&apos; THEN IF [level] = &apos;chain_name_cleaned&apos; THEN TRUE ELSE FALSE END&#10;  WHEN &apos;vendor&apos; THEN IF [level] = &apos;vendor&apos; THEN TRUE ELSE FALSE END&#10;  ELSE FALSE  &#10;END' />
      </column>
      <column caption='Date filter' datatype='boolean' name='[Calculation_6071555999923822593]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &apos;month&apos; THEN IF [date_granularity] = &apos;month&apos; THEN TRUE ELSE FALSE END&#10;  WHEN &apos;quarter&apos; THEN IF [date_granularity] = &apos;quarter&apos; THEN TRUE ELSE FALSE END&#10;  WHEN &apos;year&apos; THEN IF [date_granularity] = &apos;year&apos; THEN TRUE ELSE FALSE END&#10;  ELSE TRUE  &#10;END' />
      </column>
      <column caption='Formated number' datatype='string' name='[Calculation_6071556000015835144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [type] IN(&apos;Change Period percent&apos; ,&apos;vs Target %&apos;)  THEN&#10;    // Format as percentage with two decimals&#10;    IF [metric_value] &gt; 0 THEN &#10;        &quot;+&quot; + STR(ROUND([metric_value] * 100, 2)) + &quot;%&quot;&#10;    ELSEIF [metric_value] &lt; 0 THEN &#10;         STR(ROUND([metric_value] * 100, 2)) + &quot;%&quot;&#10;    ELSE&#10;        &quot;0%&quot;&#10;    END&#10;&#10;ELSEIF [metric_name] IN(&apos;Active Vendors&apos; ,&apos;Confirmed Orders&apos;) THEN&#10;    // Format active_vendors as integers with commas&#10;    IF INT([metric_value]) &gt;= 1000 THEN&#10;        LEFT(STR(INT([metric_value])), LEN(STR(INT([metric_value]))) - 3) + &quot;,&quot; +&#10;        RIGHT(STR(INT([metric_value])), 3)&#10;    ELSE&#10;        STR(INT([metric_value]))&#10;    END&#10;&#10;&#10;ELSEIF [metric_name] = &apos;Ncr Revenue Over Gmv&apos; THEN&#10;    // Format as percentage with two decimals&#10;    STR(ROUND([metric_value] * 100, 6)) + &quot;%&quot;&#10;&#10;&#10;ELSEIF [type] = &apos;Change Period absolute&apos; THEN&#10;    IF [metric_name] IN (&apos;active_vendors&apos; ,&apos;confirmed_orders&apos;) THEN&#10;        // Leave active_vendors as plain integers with manual comma formatting&#10;        IF INT([metric_value]) &gt;= 1000 THEN&#10;            LEFT(STR(INT([metric_value])), LEN(STR(INT([metric_value]))) - 3) + &quot;,&quot; +&#10;            RIGHT(STR(INT([metric_value])), 3)&#10;        ELSE&#10;            STR(INT([metric_value]))&#10;        END&#10;    ELSE&#10;        // Add &apos;+&apos; or &apos;-&apos; for other metrics and append &apos;€&apos;&#10;        IF [metric_value] &gt; 0 THEN&#10;            &quot;+&quot; + &#10;            IF INT([metric_value]) &gt;= 1000 THEN&#10;                LEFT(STR(INT([metric_value])), LEN(STR(INT([metric_value]))) - 3) + &quot;,&quot; +&#10;                RIGHT(STR(INT([metric_value])), 3)&#10;            ELSE&#10;                STR(INT([metric_value]))&#10;            END&#10;            + &quot;€&quot;&#10;        ELSEIF [metric_value] &lt; 0 THEN&#10;            &quot;-&quot; + &#10;            IF INT(ABS([metric_value])) &gt;= 1000 THEN&#10;                LEFT(STR(INT(ABS([metric_value]))), LEN(STR(INT(ABS([metric_value])))) - 3) + &quot;,&quot; +&#10;                RIGHT(STR(INT(ABS([metric_value]))), 3)&#10;            ELSE&#10;                STR(INT(ABS([metric_value])))&#10;            END&#10;            + &quot;€&quot;&#10;        ELSE&#10;            &quot;0&quot;&#10;        END&#10;    END&#10;&#10;&#10;&#10;ELSE&#10;    // Default: Add comma separators and &apos;€&apos; sign for other metrics&#10;    IF INT([metric_value]) &gt;= 1000000 OR INT([metric_value]) &lt;= -1000000 THEN&#10;        // Format for millions: split into three parts&#10;        IF INT([metric_value]) &lt; 0 THEN&#10;            &quot;-&quot; + LEFT(STR(ABS(INT([metric_value]))), LEN(STR(ABS(INT([metric_value])))) - 6) + &quot;,&quot; +&#10;            MID(STR(ABS(INT([metric_value]))), LEN(STR(ABS(INT([metric_value])))) - 5, 3) + &quot;,&quot; +&#10;            RIGHT(STR(ABS(INT([metric_value]))), 3) + &quot;€&quot;&#10;        ELSE&#10;            LEFT(STR(INT([metric_value])), LEN(STR(INT([metric_value]))) - 6) + &quot;,&quot; +&#10;            MID(STR(INT([metric_value])), LEN(STR(INT([metric_value]))) - 5, 3) + &quot;,&quot; +&#10;            RIGHT(STR(INT([metric_value])), 3) + &quot;€&quot;&#10;        END&#10;    ELSEIF INT([metric_value]) &gt;= 1000 OR INT([metric_value]) &lt;= -1000 THEN&#10;        // Format for thousands: split into two parts&#10;        IF INT([metric_value]) &lt; 0 THEN&#10;            &quot;-&quot; + LEFT(STR(ABS(INT([metric_value]))), LEN(STR(ABS(INT([metric_value])))) - 3) + &quot;,&quot; +&#10;            RIGHT(STR(ABS(INT([metric_value]))), 3) + &quot;€&quot;&#10;        ELSE&#10;            LEFT(STR(INT([metric_value])), LEN(STR(INT([metric_value]))) - 3) + &quot;,&quot; +&#10;            RIGHT(STR(INT([metric_value])), 3) + &quot;€&quot;&#10;        END&#10;    ELSE&#10;        // No commas needed&#10;        STR(INT([metric_value])) + &quot;€&quot;&#10;    END&#10;END' />
      </column>
      <column caption='Metric name- MoM' datatype='string' name='[Calculation_6651253715541389316]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;MoM&quot;' />
      </column>
      <column caption='Date column' datatype='string' name='[Calculation_6651253715857567751]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [date_granularity]&#10;    WHEN &apos;month&apos; THEN DATENAME(&apos;month&apos;, [partition_date]) + &quot; &quot; + STR(YEAR([partition_date]))&#10;    WHEN &apos;quarter&apos; THEN &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [partition_date])) + &quot; &quot; + STR(YEAR([partition_date]))&#10;    WHEN &apos;year&apos; THEN STR(YEAR([partition_date]))&#10;END' />
      </column>
      <column caption='Month Year' datatype='string' name='[Partition Date (copy)_1802354661560184834]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [date_granularity]&#10;    WHEN &apos;month&apos; THEN DATENAME(&apos;month&apos;, [partition_date]) + &quot; &quot; + STR(YEAR([partition_date]))&#10;    WHEN &apos;quarter&apos; THEN &quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [partition_date])) + &quot; &quot; + STR(YEAR([partition_date]))&#10;    WHEN &apos;year&apos; THEN STR(YEAR([partition_date]))&#10;END' />
      </column>
      <column caption='NCR over GMV' datatype='real' default-format='p0.00%' name='[Total NCR  Revenue (copy)_2884696328815865868]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_2884696328815730699])/ sum([Calculation_2884696329548079119])' />
      </column>
      <column caption='Total Vendors Ads Revenue(targets)' datatype='real' default-format='c#,##0&quot; €&quot;;-#,##0&quot; €&quot;' name='[Total NCR  Revenue (copy)_2884696329552850960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [metric_name] = &apos;Total Vendors Ads Revenue&apos; AND [type]=&apos;Targets&apos; THEN [metric_value] END' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='_lsba_ncr_rl_report_new' datatype='table' name='[__tableau_internal_object_id__].[_lsba_ncr_rl_report_new_ED1AC6E0A3704E62B75800A6B002C00A]' role='measure' type='quantitative' />
      <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Date Granularity' datatype='string' name='[date_granularity]' role='dimension' type='nominal' />
