      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0cpxpec1owj95z13z72fx15nlvxg (copy)].[avg:Calculation_3696259039221239813:qk]&quot;' value='MAU Platform' />
          <alias key='&quot;[federated.0cpxpec1owj95z13z72fx15nlvxg (copy)].[pcdf:sum:Calculation_3696259039213486082:qk]&quot;' value='MoM % Delta in Partner MAU Coverage' />
        </aliases>
      </column>
      <column caption='Country' datatype='string' name='[Calculation_2700682046943535104]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Management Entity&apos; THEN &apos;ALL&apos;&#10;    WHEN &apos;Global&apos; THEN &apos;ALL&apos;    &#10;    WHEN &apos;Country&apos; THEN [country_name]&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='Reset Filters' datatype='string' hidden='true' name='[Calculation_2700682046950309892]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Click here to reset filters when the data table is blank.&apos;' />
      </column>
      <column caption='z unused string MoM % Delta (Partner MAU Coverage)' datatype='string' name='[Calculation_2700682046966513669]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (ZN(sum([Calculation_3696259039213486082])) - LOOKUP(ZN(sum([Calculation_3696259039213486082])), -1)) &gt; 0 THEN &quot;+&quot; ELSE &quot;&quot; END&#10;+ STR(&#10;    ROUND(&#10;        FLOAT(&#10;            (ZN(sum([Calculation_3696259039213486082])) - LOOKUP(ZN(sum([Calculation_3696259039213486082])), -1))&#10;            / LOOKUP(ZN(sum([Calculation_3696259039213486082])), -1) &#10;            * 100&#10;               ) , 2&#10;          )&#10;      )&#10;    // float is must for * 100 to produce correct value&#10;+ &quot;%&quot;'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Δ over Prev. Period (H&amp;B Key Partners MAU Coverage)' datatype='real' name='[Calculation_2700682047252496392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;// to solve display rounding problem for Quarterly&#10;WHEN &apos;Quarterly&apos; THEN &#10;(ZN(round([Calculation_2700682047286300684],2)) - LOOKUP(ZN(round([Calculation_2700682047286300684],2)), -1)) / ABS(LOOKUP(ZN(round([Calculation_2700682047286300684],2)), -1))&#10;WHEN &apos;Monthly&apos; THEN&#10;(ZN(([Calculation_2700682047286300684])) - LOOKUP(ZN(([Calculation_2700682047286300684])), -1)) / ABS(LOOKUP(ZN(([Calculation_2700682047286300684])), -1))&#10;ELSE NULL&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Report Month' datatype='string' datatype-customized='true' name='[Calculation_2700682047267229706]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(STR(DATENAME(&apos;month&apos;, [month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [month])),2)' />
      </column>
      <column caption='H&amp;B Key Partners MAU Coverage' datatype='real' name='[Calculation_2700682047286300684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Groceries AAA MAU Coverage (copy)_3696259039216865284])' />
      </column>
      <column caption='Report Period' datatype='string' name='[Calculation_2700682047288078349]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_2700682047267229706]&#10;WHEN &apos;Quarterly&apos; THEN [Report Month (copy)_2700682047284346891]&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='Quarter' datatype='date' name='[Calculation_2700682047288893454]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date(DATETRUNC(&apos;quarter&apos;,[month]))' />
      </column>
      <column caption='Partner MAU Coverage' datatype='real' name='[Calculation_2700682047297265682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_3696259039213486082])&#10;//SUM([1st Partner MAU Coverage] * [1st MAU Platform]) / SUM([1st MAU Platform])' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_3696259039211220992]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Management Entity&apos; THEN [Dimension (copy)_3696259039516127239]&#10;    WHEN &apos;Country&apos; THEN [country_name]&#10;    WHEN &apos;Global&apos; THEN [dimension_1]&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='Granularity Data Filter' datatype='boolean' name='[Calculation_3696259039211827201]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Management Entity&apos; THEN ([granularity_3] = &apos;Management Entity&apos; and [granularity_4] != &apos;Country&apos;)&#10;    WHEN &apos;Country&apos; THEN [granularity_4] = &apos;Country&apos;&#10;    WHEN &apos;Global&apos; THEN [granularity_1] = &apos;Global&apos; &#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='1st Partner MAU Coverage' datatype='real' hidden='true' name='[Calculation_3696259039213486082]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Management Entity&apos; THEN (IF [granularity_4] = &apos;ALL&apos; THEN &#10;[avg_platform_mau_key_partners_coverage_score_option2b] END)&#10;    WHEN &apos;Country&apos; THEN (IF [granularity_5] = &apos;ALL&apos; THEN &#10;[avg_platform_mau_key_partners_coverage_score_option2b] END)&#10;    WHEN &apos;Global&apos; THEN (IF [dimension_2] = &apos;ALL&apos; THEN &#10;[avg_platform_mau_key_partners_coverage_score_option2b] END)&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='1st MAU Platform' datatype='integer' hidden='true' name='[Calculation_3696259039221239813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Management Entity&apos; THEN (IF [granularity_4] = &apos;ALL&apos; THEN &#10; [all_platform_mau] END)&#10;    WHEN &apos;Country&apos; THEN (IF [granularity_5] = &apos;ALL&apos; THEN &#10; [all_platform_mau] END)&#10;    WHEN &apos;Global&apos; THEN (IF [dimension_2] = &apos;ALL&apos; THEN &#10; [all_platform_mau] END)&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='1st Groceries AAA MAU Coverage' datatype='real' hidden='true' name='[Calculation_816347815728250880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Management Entity&apos; THEN &#10;(IF [dimension_4] = &apos;0_grocery_multicategory&apos; THEN &#10;[avg_platform_mau_key_partners_coverage_score_option2b] END)&#10;    WHEN &apos;Country&apos; THEN &#10;(IF [dimension_5] = &apos;0_grocery_multicategory&apos; THEN &#10;[avg_platform_mau_key_partners_coverage_score_option2b] END)&#10;    WHEN &apos;Global&apos; THEN &#10;(IF [dimension_2] = &apos;0_grocery_multicategory&apos; THEN &#10;[avg_platform_mau_key_partners_coverage_score_option2b] END)&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Groceries AAA MAU Coverage' datatype='real' name='[Calculation_816347815728574465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_816347815728250880])&#10;// sum of product not working, blank, need to add a new MAU platform for Groceries AAA , SUM([1st Groceries AAA MAU Coverage] * [1st MAU Platform]) / SUM([1st MAU Platform])' />
      </column>
      <column caption='MAU Platform' datatype='real' name='[Calculation_816347815730982915]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_3696259039221239813])' />
      </column>
      <column caption='MAU Covered' datatype='real' name='[Calculation_816347815731073028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([MAU Platform (copy)_3696259039221657606])' />
      </column>
      <column caption='Management Entity' datatype='string' name='[Dimension (copy)_3696259039516127239]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Management Entity&apos; THEN &#10;    (IF [dimension_3] = &apos;DH Europe&apos; and [dimension_2] = &apos;MENA&apos; THEN &apos;Yemeksepeti&apos;&#10;    ELSE [dimension_3] END)&#10;    &#10;    WHEN &apos;Country&apos; THEN &#10;    (IF [dimension_3] = &apos;DH Europe&apos; and [dimension_2] = &apos;MENA&apos; THEN &apos;Yemeksepeti&apos;&#10;    ELSE [dimension_3] END)&#10;&#10;    WHEN &apos;Global&apos; THEN &apos;ALL&apos;&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='1st H&amp;B Key Partners MAU Coverage' datatype='real' hidden='true' name='[Groceries AAA MAU Coverage (copy)_3696259039216865284]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Management Entity&apos; THEN (IF [dimension_4] = &apos;2_health_and_beauty&apos; THEN &#10;[avg_platform_mau_key_partners_coverage_score_option2b] END)&#10;    WHEN &apos;Country&apos; THEN (IF [dimension_5] = &apos;2_health_and_beauty&apos; THEN &#10;[avg_platform_mau_key_partners_coverage_score_option2b] END)&#10;    WHEN &apos;Global&apos; THEN (IF [dimension_2] = &apos;2_health_and_beauty&apos; THEN &#10;[avg_platform_mau_key_partners_coverage_score_option2b] END)&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='1st MAU Covered' datatype='integer' hidden='true' name='[MAU Platform (copy)_3696259039221657606]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Management Entity&apos; THEN (IF [granularity_4] = &apos;ALL&apos; THEN &#10; [ls_coverage_platform_mau] END)&#10;    WHEN &apos;Country&apos; THEN (IF [granularity_5] = &apos;ALL&apos; THEN &#10; [ls_coverage_platform_mau] END)&#10;    WHEN &apos;Global&apos; THEN (IF [dimension_2] = &apos;ALL&apos; THEN &#10; [ls_coverage_platform_mau] END)&#10;ELSE NULL&#10;END' />
