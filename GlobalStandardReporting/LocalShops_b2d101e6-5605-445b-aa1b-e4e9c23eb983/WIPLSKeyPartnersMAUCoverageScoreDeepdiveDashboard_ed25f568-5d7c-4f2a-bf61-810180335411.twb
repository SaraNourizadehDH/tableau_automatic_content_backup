      <aliases enabled='yes' />
      <column caption='Country' datatype='string' name='[Calculation_2700682046943535104]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Management Entity&apos; THEN &apos;ALL&apos;&#10;    WHEN &apos;Global&apos; THEN &apos;ALL&apos;    &#10;    WHEN &apos;Country&apos; THEN [country_name]&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='Reset Filters' datatype='string' name='[Calculation_2700682046950309892]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Click here to reset filters when the data table is blank.&apos;' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_3696259039211220992]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Management Entity&apos; THEN [Dimension (copy)_3696259039516127239]&#10;    WHEN &apos;Country&apos; THEN [country_name]&#10;    WHEN &apos;Global&apos; THEN [dimension_1]&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='Granularity Data Filter' datatype='boolean' name='[Calculation_3696259039211827201]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Management Entity&apos; THEN ([granularity_3] = &apos;Management Entity&apos; and [granularity_4] != &apos;Country&apos;)&#10;    WHEN &apos;Country&apos; THEN [granularity_4] = &apos;Country&apos;&#10;    WHEN &apos;Global&apos; THEN [granularity_1] = &apos;Global&apos; &#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Partner MAU Coverage' datatype='real' name='[Calculation_3696259039213486082]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Management Entity&apos; THEN (IF [granularity_4] = &apos;ALL&apos; THEN &#10;[avg_platform_mau_key_partners_coverage_score_option2b] END)&#10;    WHEN &apos;Country&apos; THEN (IF [granularity_5] = &apos;ALL&apos; THEN &#10;[avg_platform_mau_key_partners_coverage_score_option2b] END)&#10;    WHEN &apos;Global&apos; THEN (IF [dimension_2] = &apos;ALL&apos; THEN &#10;[avg_platform_mau_key_partners_coverage_score_option2b] END)&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='MAU Platform' datatype='integer' name='[Calculation_3696259039221239813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Management Entity&apos; THEN (IF [granularity_4] = &apos;ALL&apos; THEN &#10; [all_platform_mau] END)&#10;    WHEN &apos;Country&apos; THEN (IF [granularity_5] = &apos;ALL&apos; THEN &#10; [all_platform_mau] END)&#10;    WHEN &apos;Global&apos; THEN (IF [dimension_2] = &apos;ALL&apos; THEN &#10; [all_platform_mau] END)&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Management Entity' datatype='string' name='[Dimension (copy)_3696259039516127239]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Management Entity&apos; THEN &#10;    (IF [dimension_3] = &apos;DH Europe&apos; and [dimension_2] = &apos;MENA&apos; THEN &apos;Yemeksepeti&apos;&#10;    ELSE [dimension_3] END)&#10;    &#10;    WHEN &apos;Country&apos; THEN &#10;    (IF [dimension_3] = &apos;DH Europe&apos; and [dimension_2] = &apos;MENA&apos; THEN &apos;Yemeksepeti&apos;&#10;    ELSE [dimension_3] END)&#10;&#10;    WHEN &apos;Global&apos; THEN &apos;ALL&apos;&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='H&amp;B Key Partners MAU Coverage' datatype='real' name='[Groceries AAA MAU Coverage (copy)_3696259039216865284]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Management Entity&apos; THEN (IF [dimension_4] = &apos;2_health_and_beauty&apos; THEN &#10;[avg_platform_mau_key_partners_coverage_score_option2b] END)&#10;    WHEN &apos;Country&apos; THEN (IF [dimension_5] = &apos;2_health_and_beauty&apos; THEN &#10;[avg_platform_mau_key_partners_coverage_score_option2b] END)&#10;    WHEN &apos;Global&apos; THEN (IF [dimension_2] = &apos;2_health_and_beauty&apos; THEN &#10;[avg_platform_mau_key_partners_coverage_score_option2b] END)&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='MAU Covered' datatype='integer' name='[MAU Platform (copy)_3696259039221657606]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Management Entity&apos; THEN (IF [granularity_4] = &apos;ALL&apos; THEN &#10; [ls_coverage_platform_mau] END)&#10;    WHEN &apos;Country&apos; THEN (IF [granularity_5] = &apos;ALL&apos; THEN &#10; [ls_coverage_platform_mau] END)&#10;    WHEN &apos;Global&apos; THEN (IF [dimension_2] = &apos;ALL&apos; THEN &#10; [ls_coverage_platform_mau] END)&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Groceries AAA MAU Coverage' datatype='real' name='[Partner MAU Coverage (copy)_3696259039216226307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Management Entity&apos; THEN &#10;(IF [dimension_4] = &apos;0_grocery_multicategory&apos; THEN &#10;[avg_platform_mau_key_partners_coverage_score_option2b] END)&#10;    WHEN &apos;Country&apos; THEN &#10;(IF [dimension_5] = &apos;0_grocery_multicategory&apos; THEN &#10;[avg_platform_mau_key_partners_coverage_score_option2b] END)&#10;    WHEN &apos;Global&apos; THEN &#10;(IF [dimension_2] = &apos;0_grocery_multicategory&apos; THEN &#10;[avg_platform_mau_key_partners_coverage_score_option2b] END)&#10;ELSE NULL&#10;END' />
      </column>
