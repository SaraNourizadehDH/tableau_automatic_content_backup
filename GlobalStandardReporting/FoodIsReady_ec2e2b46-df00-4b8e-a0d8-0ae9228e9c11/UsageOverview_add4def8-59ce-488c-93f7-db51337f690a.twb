          <zone forceUpdate='true' h='9333' id='417' type-v2='text' w='98770' x='615' y='27524'>
            <formatted-text>
              <run fontsize='10'>This chart shows the distribution of usage of Food Is Ready feature over time. </run>
              <run>Æ&#10;</run>
              <run fontsize='10'>- The Usage Category indicates how many percent in total orders a vendor using Food Is Ready. </run>
              <run>Æ&#10;</run>
              <run fontsize='10'>- </run>
              <run bold='true' fontsize='10'>Include Non Food Is Ready Usage</run>
              <run fontsize='10'>: is a parameter to include (or exclude) Vendors who do not use Food is Ready feature at all.</run>
              <run>Æ&#10;</run>
              <run fontsize='10'>-</run>
              <run bold='true' fontsize='10'> Total Orders?: </run>
              <run fontsize='10'>there are many vendors only have one order per day/week/month and they also use Food Is Ready for their only 1 order. This parameter is to include (or exclude) those.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='7238' id='419' mode='checkdropdown' name='fir_usage_dist' param='[federated.0o5op5b0el06br1fi80bf1976k6y].[none:is_vendor_order:nk]' show-apply='true' type-v2='filter' values='database' w='19385' x='40769' y='20286'>
