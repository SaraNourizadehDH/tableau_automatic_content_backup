          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gsr_food_is_ready_orders' name='federated.04eig1p0jigkw610rvqez137eyvj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Choose Timing Metric' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;At Vendor Time Cleaned&quot;'>
              <calculation class='tableau' formula='&quot;At Vendor Time Cleaned&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.04eig1p0jigkw610rvqez137eyvj'>
            <column caption='_choose_timing_metric' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_3861977420718858241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;At Vendor Time&apos; THEN [Calculation_4866843151396810758]&#10;ELSEIF [Parameters].[Parameter 6] = &apos;At Vendor Time Cleaned&apos; THEN [Calculation_4866843151396909063]&#10;ELSEIF [Parameters].[Parameter 6] = &apos;Delivery Time&apos; THEN [Calculation_4866843151396663301]&#10;ELSEIF [Parameters].[Parameter 6] = &apos;% Vendor Late over 10 minutes&apos; THEN [Calculation_552676165187215360]&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_4866843151358562305]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Daily&apos; &#10;  THEN STR([created_date])&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Weekly&apos; &#10;  THEN STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [created_date]))) +&apos;-&apos; + (IF(DATEPART(&apos;week&apos;,DATETRUNC(&apos;week&apos;, [created_date])) &lt; 10) THEN &apos;0&apos;+STR(DATEPART(&apos;week&apos;,DATETRUNC(&apos;week&apos;, [created_date])))&#10;    ELSE STR(DATEPART(&apos;week&apos;,DATETRUNC(&apos;week&apos;, [created_date]))) END)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; &#10;  THEN STR(DATEPART(&apos;year&apos;, [created_date])) +&apos;-&apos;+  (IF(DATEPART(&apos;month&apos;,[created_date]) &lt; 10) THEN &apos;0&apos;+STR(DATEPART(&apos;month&apos;,[created_date]))&#10;    ELSE STR(DATEPART(&apos;month&apos;,[created_date])) END)&#10;END' />
            </column>
            <column caption='Delivery Time' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4866843151396663301]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_delivery_time_min])/SUM([count_delivery_time])' />
            </column>
            <column caption='At Vendor Time' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4866843151396810758]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_at_vendor_time_min])/SUM([count_at_vendor_time])' />
            </column>
            <column caption='At Vendor Time Cleaned' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4866843151396909063]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_at_vendor_time_cleaned_min])/SUM([count_at_vendor_time_cleaned])' />
            </column>
            <column caption='is_perc_vendor_late_metric' datatype='boolean' name='[Calculation_531072915715989505]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;% Vendor Late over 10 minutes&apos; THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='% Vendor Late over 10 minutes' datatype='real' default-format='p0.00%' name='[Calculation_552676165187215360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_10_min_cnt])/SUM([vendor_late_cnt])' />
            </column>
