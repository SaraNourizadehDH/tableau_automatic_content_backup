              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
            <column caption='Order Or Vendor?' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Order&quot;'>
              <calculation class='tableau' formula='&quot;Order&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.04eig1p0jigkw610rvqez137eyvj'>
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Client Name' datatype='string' name='[client_name]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
