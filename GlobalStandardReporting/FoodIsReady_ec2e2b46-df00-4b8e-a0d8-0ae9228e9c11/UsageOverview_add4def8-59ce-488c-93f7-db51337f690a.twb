            <column caption='Vertical Type' datatype='string' name='[vertical_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0o5op5b0el06br1fi80bf1976k6y'>
            <column caption='Share FiR Dashboard Screen/FiR Vendors' datatype='real' default-format='p0.00%' name='[Calculation_253046071624929284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dashboard_screen_vendors])/SUM([Calculation_253046071667949574])' />
            </column>
            <column caption='Share FiR Order Details/FiR Vendors' datatype='real' default-format='p0.00%' name='[Calculation_253046071625199621]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_details_vendors])/SUM([Calculation_253046071667949574])' />
            </column>
            <column caption='# Food Is Ready Vendors' datatype='integer' name='[Calculation_253046071667949574]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [category] != &apos;Not used FIR&apos; THEN [vendors] ELSE 0 END' />
            </column>
            <column caption='_date_granularity_filter' datatype='boolean' name='[Calculation_5946862637748023298]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Parameters].[Parameter 1] = &apos;Daily&apos; THEN [date_granularity] = &apos;daily&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; THEN [date_granularity] = &apos;weekly&apos;&#10;ELSE [date_granularity] = &apos;monthly&apos;&#10;END' />
            </column>
            <column caption='Date_Shown' datatype='string' name='[Calculation_5946862637748604931]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Daily&apos; &#10;  THEN STR([created_date])&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Weekly&apos; &#10;  THEN STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [created_date]))) +&apos;-&apos; + (IF(DATEPART(&apos;week&apos;,DATETRUNC(&apos;week&apos;, [created_date])) &lt; 10) THEN &apos;0&apos;+STR(DATEPART(&apos;week&apos;,DATETRUNC(&apos;week&apos;, [created_date])))&#10;    ELSE STR(DATEPART(&apos;week&apos;,DATETRUNC(&apos;week&apos;, [created_date]))) END)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; &#10;  THEN STR(DATEPART(&apos;year&apos;, [created_date])) +&apos;-&apos;+  (IF(DATEPART(&apos;month&apos;,[created_date]) &lt; 10) THEN &apos;0&apos;+STR(DATEPART(&apos;month&apos;,[created_date]))&#10;    ELSE STR(DATEPART(&apos;month&apos;,[created_date])) END)&#10;END' />
            </column>
            <column caption='_order_vendor_filter' datatype='boolean' name='[Calculation_5946862637753004037]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Vendor&apos; THEN TRUE ELSE FALSE END' />
            </column>
