              <calculation class='tableau' formula='SUM(IF [is_food_is_ready] = TRUE THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_4866843151358562305]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Daily&apos; &#10;  THEN STR([created_date])&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Weekly&apos; &#10;  THEN STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;, [created_date]))) +&apos;-&apos; + (IF(DATEPART(&apos;week&apos;,DATETRUNC(&apos;week&apos;, [created_date])) &lt; 10) THEN &apos;0&apos;+STR(DATEPART(&apos;week&apos;,DATETRUNC(&apos;week&apos;, [created_date])))&#10;    ELSE STR(DATEPART(&apos;week&apos;,DATETRUNC(&apos;week&apos;, [created_date]))) END)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos; &#10;  THEN STR(DATEPART(&apos;year&apos;, [created_date])) +&apos;-&apos;+  (IF(DATEPART(&apos;month&apos;,[created_date]) &lt; 10) THEN &apos;0&apos;+STR(DATEPART(&apos;month&apos;,[created_date]))&#10;    ELSE STR(DATEPART(&apos;month&apos;,[created_date])) END)&#10;END' />
            </column>
            <column caption='Share FiR Orders / Accepted Orders' datatype='real' default-format='p0.0%' name='[Calculation_4866843151373250563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4866843151357353984]/SUM([accepted_orders])' />
            </column>
            <column caption='Share FiR Orders / Total Orders' datatype='real' default-format='p0.0%' name='[Calculation_4866843151373475844]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4866843151357353984]/SUM([orders])' />
            </column>
            <column caption='Share FiR Dashboard/FiR Orders' datatype='real' default-format='p0.00%' name='[Calculation_4866843151409594376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fir_dashboard_orders])/[Calculation_4866843151357353984]' />
            </column>
            <column caption='Share FiR Order Details/FiR Orders' datatype='real' default-format='p0.00%' name='[Calculation_4866843151409795081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fir_order_details_orders])/[Calculation_4866843151357353984]' />
            </column>
            <column caption='AVG FiR - Accepted At By Vendor (mins)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4866843151410651146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_food_is_ready]=TRUE THEN [delta_fir_accepted_by_vendor] ELSE 0 END)/([Calculation_4866843151357353984]*60)' />
            </column>
            <column caption='AVG FiR Estimated Prep Time (mins)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4866843151413075979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_food_is_ready] = TRUE THEN [sum_fir_est_prep_time] ELSE 0 END)/([Calculation_4866843151357353984] * 60)' />
            </column>
            <column caption='FiR At Vendor Time (mins)' datatype='real' default-format='c#,##0.00' name='[Calculation_4866843151413407756]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_food_is_ready] = TRUE THEN [sum_at_vendor_time_min] ELSE 0 END)/SUM(IF [is_food_is_ready] = TRUE THEN [count_at_vendor_time] ELSE 0 END)' />
            </column>
            <column caption='FiR At Vendor Time Cleaned (mins)' datatype='real' default-format='c#,##0.00;-#,##0.00' name='[Calculation_4866843151414763534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_food_is_ready] = TRUE THEN [sum_at_vendor_time_cleaned_min] ELSE 0 END)/SUM(IF [is_food_is_ready] = TRUE THEN [count_at_vendor_time_cleaned] ELSE 0 END)' />
            </column>
            <column caption='AVG FiR Delivery Time (mins)' datatype='real' default-format='c#,##0.00;-#,##0.00' name='[Calculation_4866843151414997007]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_food_is_ready]=TRUE THEN [sum_delivery_time_min] ELSE 0 END)/SUM(IF [is_food_is_ready] = TRUE THEN [count_delivery_time] ELSE 0 END)' />
            </column>
            <column caption='Share FiR BEFORE Rider near PU' datatype='real' default-format='p0.00%' name='[Calculation_4866843151421399056]' role='measure' type='quantitative'>
