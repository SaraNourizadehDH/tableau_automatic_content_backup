        </aliases>
      </column>
      <column caption='Check' datatype='string' name='[Calculation_1290914659848318980]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]      &#10;WHEN &apos;All&apos; THEN &apos;All&apos;&#10;WHEN &apos;True&apos; THEN &apos;True&apos;&#10;WHEN &apos;False&apos; THEN &apos;False&apos; END' />
      </column>
      <column caption='Group KPI' datatype='real' name='[Calculation_2295850685240016896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ngood) / SUM(nrows) * 100' />
      </column>
      <column caption='Ratio Color' datatype='string' name='[Calculation_2295850685248462850]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2295850685240016896] &gt; 90 THEN &apos;Above 90%&apos;&#10;ELSEIF [Calculation_2295850685240016896] &gt;= 75 AND [Calculation_2295850685240016896] &lt;= 90 THEN &apos;75 - 90 %&apos;&#10;ELSE &apos;Below 75%&apos;&#10;END' />
      </column>
      <column caption='Date Granularity' datatype='date' datatype-customized='true' name='[Calculation_551268782742114304]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Daily&apos; THEN [report_date]&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;, [report_date])&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;, [report_date])&#10;END)' />
      </column>
      <column caption='Share  good rows' datatype='real' name='[Calculation_6264014550151413760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ngood]) / SUM([expected_rows])' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Ratio Color Expected' datatype='string' name='[Ratio Color (copy)_6264014550153285633]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_6264014550151413760] *100 &gt; 90 THEN &apos;Above 90%&apos;&#10;ELSEIF [Calculation_6264014550151413760]*100 &gt;= 75 AND [Calculation_6264014550151413760]*100 &lt;= 90 THEN &apos;75 - 90 %&apos;&#10;ELSE &apos;Below 75%&apos;&#10;END' />
      </column>
