              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]      &#10;WHEN &apos;All&apos; THEN &apos;All&apos;&#10;WHEN &apos;True&apos; THEN &apos;True&apos;&#10;WHEN &apos;False&apos; THEN &apos;False&apos; END' />
            </column>
            <column caption='Group KPI' datatype='real' name='[Calculation_2295850685240016896]' role='measure' type='quantitative'>
