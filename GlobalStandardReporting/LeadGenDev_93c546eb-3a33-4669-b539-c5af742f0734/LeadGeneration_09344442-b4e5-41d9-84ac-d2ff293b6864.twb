            <groupfilter function='member' level='[none:Calculation_4722376109100732421:nk]' member='true' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0vmgqtk0kn70yg11vqvt31eujzoi].[none:Calculation_4722376109107806214:nk]' filter-group='8'>
            <groupfilter function='member' level='[none:Calculation_4722376109107806214:nk]' member='true' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
