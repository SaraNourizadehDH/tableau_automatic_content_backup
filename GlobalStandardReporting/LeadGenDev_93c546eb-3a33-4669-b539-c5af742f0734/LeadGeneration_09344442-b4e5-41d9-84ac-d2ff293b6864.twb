            </column>
            <column caption='ATTR(1)' datatype='integer' name='[Calculation_2295850685251633162]' role='measure' type='quantitative' user:unnamed='Leads Delivery Table'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='Date Granularity' datatype='date' datatype-customized='true' name='[Calculation_551268782742114304]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Daily&apos; THEN [report_date]&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;, [report_date])&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;, [report_date])&#10;END)' />
