    <worksheet name='Total Leads Sent Operational'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000'>DH Salesforce Funnel (not Pandora Salesforce)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ds_global_dev.sf_funnel' name='federated.0vmgqtk0kn70yg11vqvt31eujzoi' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Start Date' datatype='date' datatype-customized='true' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='#2020-05-01#'>
              <calculation class='tableau' formula='#2020-05-01#' />
            </column>
            <column caption='Operational View' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management View&quot;'>
              <calculation class='tableau' formula='&quot;Management View&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vmgqtk0kn70yg11vqvt31eujzoi'>
            <column caption='Signed Share %' datatype='real' name='[Account Share % (copy)_254101593844150274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([number_signed]) / (SUM([number_signed])+SUM([number_signed_external]))' />
            </column>
            <column caption='Account Share  % ' datatype='real' default-format='p0.0%' name='[Account Share Local % (copy)_254101593844670468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([number_of_accounts]) / (SUM([number_of_accounts])+SUM([number_of_accounts_external]))' />
            </column>
            <column caption='Leads Signed %' datatype='real' name='[Calculation_2719681646352928776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([number_signed]) / (SUM([total_leads_sent]))' />
            </column>
            <column caption='leads_qualified_%_internal' datatype='real' default-format='p0.0%' name='[Calculation_2920162173745659916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([number_qualified]) / SUM([total_leads_sent])' />
            </column>
            <column caption='Production Flag' datatype='string' name='[Calculation_3038381636959301632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [common_name] = &apos;Argentina&apos; AND [date] &gt;= DATE(&apos;2020-06-01&apos;) THEN &apos;Production&apos;&#10;ELSEIF [common_name] = &apos;Philippines&apos; AND [date] &gt;= DATE(&apos;2020-03-01&apos;) THEN &apos;Production&apos;&#10;ELSEIF [common_name] = &apos;Romania&apos; AND [date] &gt;= DATE(&apos;2020-04-01&apos;) THEN &apos;Production&apos;&#10;ELSEIF [common_name] = &apos;Sweden&apos; AND [date] &gt;= DATE(&apos;2020-04-01&apos;) THEN &apos;Production&apos;&#10;ELSEIF [common_name] = &apos;Malaysia&apos; AND [date] &gt;= DATE(&apos;2020-05-01&apos;) THEN &apos;Production&apos;&#10;ELSEIF [common_name] = &apos;Hong Kong&apos; AND [date] &gt;= DATE(&apos;2020-06-01&apos;) THEN &apos;Production&apos;&#10;ELSEIF [common_name] = &apos;Myanmar&apos; AND [date] &gt;= DATE(&apos;2020-06-01&apos;) THEN &apos;Production&apos;&#10;ELSEIF [common_name] = &apos;Jordan&apos; AND [date] &gt;= DATE(&apos;2020-06-01&apos;) THEN &apos;Production&apos;&#10;ELSEIF [common_name] = &apos;Oman&apos; AND [date] &gt;= DATE(&apos;2020-06-01&apos;) THEN &apos;Production&apos;&#10;&#10;&#10;// Added 9th September 2020&#10;ELSEIF [common_name] = &apos;Laos&apos; AND [date] &gt;= DATE(&apos;2020-08-01&apos;) THEN &apos;Production&apos;&#10;ELSEIF [common_name] = &apos;Singapore&apos; AND [date] &gt;= DATE(&apos;2020-08-01&apos;) THEN &apos;Production&apos;&#10;ELSEIF [common_name] = &apos;Thailand&apos; AND [date] &gt;= DATE(&apos;2020-09-01&apos;) THEN &apos;Production&apos;&#10;ELSEIF [common_name] = &apos;Taiwan&apos; AND [date] &gt;= DATE(&apos;2020-07-15&apos;) THEN &apos;Production&apos;&#10;ELSEIF [common_name] = &apos;Japan&apos; AND [date] &gt;= DATE(&apos;2020-05-01&apos;) THEN &apos;Production&apos;&#10;ELSEIF [common_name] = &apos;Chile&apos; AND [date] &gt;= DATE(&apos;2020-07-20&apos;) THEN &apos;Production&apos;&#10;ELSEIF [common_name] = &apos;Uruguay&apos; AND [date] &gt;= DATE(&apos;2020-07-01&apos;) THEN &apos;Production&apos;&#10;ELSEIF [common_name] = &apos;Bolivia&apos; AND [date] &gt;= DATE(&apos;2020-08-01&apos;) THEN &apos;Production&apos;&#10;ELSEIF [common_name] = &apos;Dominican Republic&apos; AND [date] &gt;= DATE(&apos;2020-08-01&apos;) THEN &apos;Production&apos;&#10;ELSEIF [common_name] = &apos;Hungary&apos; AND [date] &gt;= DATE(&apos;2020-09-01&apos;) THEN &apos;Production&apos;&#10;ELSEIF [common_name] = &apos;Austria&apos; AND [date] &gt;= DATE(&apos;2020-09-01&apos;) THEN &apos;Production&apos;&#10;&#10;ELSE &apos;Not Production&apos; END' />
            </column>
            <column caption='Leads Active %' datatype='real' default-format='p0.0%' name='[Calculation_389561371080806401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([number_active]) /  SUM([total_leads_sent])' />
            </column>
            <column caption='View Type' datatype='string' name='[Calculation_389561371081674754]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5]' />
            </column>
            <column caption='Date Parameter' datatype='string' datatype-customized='true' name='[Calculation_4722376109072986112]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN  &apos;Daily&apos; THEN STR(date)&#10;WHEN &apos;Weekly&apos; THEN &apos;W&apos;+STR(DATEPART(&apos;week&apos;, [date])) + &apos; &apos; + STR(DATEPART(&apos;year&apos;, [date]))  &#10;WHEN &apos;Monthly&apos; THEN STR(DATENAME(&apos;month&apos;, [date])) + &apos; &apos; + STR(DATEPART(&apos;year&apos;, [date])) &#10;WHEN &apos;Quarterly&apos; THEN STR(DATENAME(&apos;quarter&apos;, [date])) + &apos; &apos; + STR(DATEPART(&apos;year&apos;, [date])) &#10;END' />
            </column>
            <column caption='Share Leads Sent %' datatype='real' name='[Calculation_4722376109078937602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_leads_sent]) / (SUM([total_leads_sent]) + SUM([total_leads_external]))' />
            </column>
            <column caption='Date Check' datatype='boolean' name='[Calculation_4722376109100732421]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Monthly&apos; AND DATETRUNC(&apos;month&apos;,[date]) &gt;=  DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 4]) THEN TRUE&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos; AND DATETRUNC(&apos;week&apos;,[date]) &gt;=  DATETRUNC(&apos;week&apos;,[Parameters].[Parameter 4]) THEN TRUE&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Quarterly&apos; AND DATETRUNC(&apos;quarter&apos;,[date]) &gt;=  DATETRUNC(&apos;quarter&apos;,[Parameters].[Parameter 4]) THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Total Leads Sent Weekly' datatype='boolean' name='[Calculation_4722376109107806214]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED [common_name],DATETRUNC(&apos;week&apos;,date) : SUM([total_leads_sent])} &gt; 0 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Include Inbound ?' datatype='string' name='[Calculation_6126162198079950853]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lead_source] = &apos;Inbound&apos; THEN &apos;Inbounds Only&apos; ELSE &apos;No Inbounds&apos; END' />
            </column>
            <column caption='Country' datatype='string' name='[common_name]' role='dimension' type='nominal' />
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[lead_source]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[date]' derivation='Min' name='[min:date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3038381636959301632]' derivation='None' name='[none:Calculation_3038381636959301632:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_389561371081674754]' derivation='None' name='[none:Calculation_389561371081674754:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4722376109072986112]' derivation='None' name='[none:Calculation_4722376109072986112:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4722376109100732421]' derivation='None' name='[none:Calculation_4722376109100732421:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4722376109107806214]' derivation='None' name='[none:Calculation_4722376109107806214:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_6126162198079950853]' derivation='None' name='[none:Calculation_6126162198079950853:nk]' pivot='key' type='nominal' />
            <column-instance column='[common_name]' derivation='None' name='[none:common_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[date]' derivation='None' name='[none:date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[number_active]' role='measure' type='quantitative' />
            <column datatype='integer' name='[number_of_accounts]' role='measure' type='quantitative' />
            <column datatype='integer' name='[number_of_accounts_external]' role='measure' type='quantitative' />
            <column datatype='integer' name='[number_qualified]' role='measure' type='quantitative' />
            <column datatype='integer' name='[number_signed]' role='measure' type='quantitative' />
            <column datatype='integer' name='[number_signed_external]' role='measure' type='quantitative' />
            <column datatype='integer' name='[number_untouched]' role='measure' type='quantitative' />
            <column caption='Lead Accounts %' datatype='real' name='[signed % (copy)_2719681646353465353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([number_of_accounts]) / SUM([total_leads_sent])' />
            </column>
            <column-instance column='[number_untouched]' derivation='Sum' name='[sum:number_untouched:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_leads_sent]' derivation='Sum' name='[sum:total_leads_sent:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[total_leads_external]' role='measure' type='quantitative' />
