      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.00y2gjz049jrww13lty9z08gvhae].[avg:timeliness:qk]&quot;' value='Timeliness %' />
