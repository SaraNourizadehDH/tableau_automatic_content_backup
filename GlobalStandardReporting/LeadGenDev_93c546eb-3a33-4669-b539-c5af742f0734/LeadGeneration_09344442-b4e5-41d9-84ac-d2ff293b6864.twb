            </column>
            <column caption='Ratio Color' datatype='string' name='[Calculation_2295850685248462850]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2295850685240016896] &gt; 90 THEN &apos;Above 90%&apos;&#10;ELSEIF [Calculation_2295850685240016896] &gt;= 75 AND [Calculation_2295850685240016896] &lt;= 90 THEN &apos;75 - 90 %&apos;&#10;ELSE &apos;Below 75%&apos;&#10;END' />
            </column>
