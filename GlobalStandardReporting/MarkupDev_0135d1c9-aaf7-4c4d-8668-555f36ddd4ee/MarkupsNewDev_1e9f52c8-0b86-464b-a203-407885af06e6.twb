    <worksheet name='KPI Time Evol (3)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Entity Aggregated Onboarding' name='federated.1cmiq7p1hw5v4y19g1k2g0ej28zt (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='% of vendors with markup' caption='KPI 1' datatype='string' name='[Parameter 1 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% of vendors with markup&quot;'>
              <calculation class='tableau' formula='&quot;% of vendors with markup&quot;' />
              <aliases>
                <alias key='&quot;\% of items with markup&quot;' value='% of items with markup' />
                <alias key='&quot;\% of vendors with markup&quot;' value='% of vendors with markup' />
                <alias key='&quot;Avg \% markup weighted by item price&quot;' value='Avg % markup weighted by item price' />
                <alias key='&quot;Unweighted Avg \% markup&quot;' value='Unweighted Avg % markup' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1cmiq7p1hw5v4y19g1k2g0ej28zt (copy)'>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_3559110407244439552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username]=USERNAME()' />
            </column>
            <column caption='Markup weighted by GBV %' datatype='real' default-format='p0.00%' name='[Calculation_5104408014394408960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([item_GBV_markup_sum])/SUM([total_item_GBV_sum])' />
            </column>
            <column caption='Markup Vendor %' datatype='real' default-format='p0%' name='[Calculation_5104408014413828100]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM ([markup_vendor])&#10;/&#10;SUM ([total_vendor])' />
            </column>
            <column caption='Markup Items %' datatype='real' default-format='p0%' name='[Calculation_5104408014418276358]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([markup_items])&#10;/&#10;SUM([total_items])' />
            </column>
            <column caption='Markup AVG Unweighted %' datatype='real' default-format='p0.00%' name='[Calculation_5104408014422253577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([item_markup_sum])&#10;/&#10;SUM([markup_items])' />
            </column>
            <column caption='Markup AVG weighted by Price' datatype='real' default-format='p0.00%' name='[Calculation_5104408014429253643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([item_price_markup_sum])&#10;/&#10;SUM([item_price_sum])' />
            </column>
            <column caption='Markup Visits %' datatype='real' default-format='p0%' name='[Calculation_5104408014430154765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([markup_customer_visit_count])&#10;/&#10;SUM([total_customer_visit_count])' />
            </column>
            <column caption='KPI 1' datatype='real' default-format='p0.00%' name='[Calculation_5104408014453174288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 2]&#10;WHEN &quot;Effective markup&quot; THEN [Calculation_5104408014394408960]&#10;WHEN &quot;% of items with markup&quot; THEN [Calculation_5104408014418276358]&#10;WHEN &quot;% of vendors with markup&quot; THEN [Calculation_5104408014413828100]&#10;WHEN &quot;Unweighted Avg % markup&quot; THEN [Calculation_5104408014422253577]&#10;WHEN &quot;Avg % markup weighted by item price&quot; THEN [Calculation_5104408014429253643]&#10;WHEN &quot;% of visits markup&quot; THEN [Calculation_5104408014430154765]&#10;END' />
            </column>
