          <datasource-dependencies datasource='Parameters'>
            <column caption='Top5Cuisine Ranked By' datatype='string' datatype-customized='true' name='[Breakdown By Metric (copy)_2210352685124796429]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total MU GBV&quot;'>
              <calculation class='tableau' formula='&quot;Total MU GBV&quot;' />
            </column>
            <column caption='Breakdown By Metric' datatype='string' datatype-customized='true' name='[Post-Fix Metric (copy)_2210352685031473152]' param-domain-type='list' role='measure' type='nominal' value='&quot;Top 5 Vendor Cuisine&quot;'>
              <calculation class='tableau' formula='&quot;Top 5 Vendor Cuisine&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0n2no391175w0o164ydqp0vhkkbd'>
            <column caption='% MUI_MU Weighted by GBV' datatype='real' name='[% MUI_Item MU (copy)_719098259515080715]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mui_item_GBV_markup_sum])/SUM([mui_total_item_GBV_sum])' />
            </column>
            <column caption='% MUI_Item MU' datatype='real' name='[% Vendor MU (copy)_719098259513651209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mui_markup_items])/SUM([mui_total_items])' />
            </column>
            <column caption='% Vendor_MU Weighted by GBV' datatype='real' default-format='p0%' name='[% Vendor MU (copy)_719098259514818570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [cohort_month] ,[report_month],[global_entity_id],[source_platform],[is_top_competitor],[vendor_class],[commission_rate_bin],[vendor_cuisine],[markup_age]: AVG([item_GBV_markup_sum])})&#10;/SUM({FIXED [cohort_month] ,[report_month],[global_entity_id],[source_platform],[is_top_competitor],[vendor_class],[commission_rate_bin],[vendor_cuisine],[markup_age]: AVG([total_item_GBV_sum])})' />
            </column>
            <column caption='Metric Breakdown' datatype='string' name='[Calculation_2210352685034647553]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Post-Fix Metric (copy)_2210352685031473152]&#10;WHEN &apos;Commission Rate Bin&apos; THEN [commission_rate_bin]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_class]&#10;WHEN &apos;Item Type&apos; THEN [Calculation_556053874195894273]&#10;WHEN &apos;Top 5 Vendor Cuisine&apos; THEN [Calculation_5104408015176171553]&#10;END' />
            </column>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_3559110407264169989]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username]=USERNAME()' />
            </column>
            <column caption='DIM_Markup weighted by GBV %' datatype='real' default-format='p0.00%' name='[Calculation_5104408014394408960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Post-Fix Metric (copy)_2210352685031473152]&#10;WHEN &apos;Commission Rate Bin&apos; THEN ([% Vendor MU (copy)_719098259514818570])&#10;WHEN &apos;Vendor Grade&apos; THEN ([% Vendor MU (copy)_719098259514818570])&#10;WHEN &apos;Item Type&apos; THEN [% MUI_Item MU (copy)_719098259515080715]&#10;WHEN &apos;Top 5 Vendor Cuisine&apos; THEN ([% Vendor MU (copy)_719098259514818570])&#10;END' />
            </column>
            <column caption='DIM_Markup Incidence Rate  %' datatype='real' default-format='p0%' name='[Calculation_5104408014413828100]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Post-Fix Metric (copy)_2210352685031473152]&#10;WHEN &apos;Commission Rate Bin&apos; THEN ([Calculation_719098259513368584])&#10;WHEN &apos;Vendor Grade&apos; THEN ([Calculation_719098259513368584])&#10;WHEN &apos;Item Type&apos; THEN [% Vendor MU (copy)_719098259513651209]&#10;WHEN &apos;Top 5 Vendor Cuisine&apos; THEN ([Calculation_719098259513368584])&#10;END' />
            </column>
            <column caption='Top5Cuisine + Others' datatype='string' name='[Calculation_5104408015176171553]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Vendor Cuisine Set]&#10;THEN [vendor_cuisine]&#10;ELSE &quot;Others&quot;&#10;END' />
            </column>
            <column caption='Meal Type' datatype='string' name='[Calculation_556053874195894273]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS(LOWER([meal_type_name]),&quot;drink&quot;) then &quot;drinks&quot;&#10;ELSEIF CONTAINS(LOWER([meal_type_name]),&quot;non food, non drinks&quot;) &#10;OR CONTAINS(LOWER([meal_type_name]),&quot;mixed category&quot;)&#10;OR CONTAINS(LOWER([meal_type_name]),&quot;pre-packaged food&quot;)&#10;OR ISNULL([meal_type_name]) then &quot;others&quot;&#10;ELSE [meal_type_name]&#10;END' />
            </column>
            <column caption='% Vendor MU' datatype='real' default-format='p0%' name='[Calculation_719098259513368584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [cohort_month] ,[report_month],[global_entity_id],[source_platform],[is_top_competitor],[vendor_class],[commission_rate_bin],[vendor_cuisine],[markup_age]: AVG([markup_vendor])})&#10;/SUM({FIXED [cohort_month] ,[report_month],[global_entity_id],[source_platform],[is_top_competitor],[vendor_class],[commission_rate_bin],[vendor_cuisine],[markup_age]:AVG([total_vendor])})' />
            </column>
            <column caption='LatestMonth_Total Vendors' datatype='real' name='[LatestMonth_item GBV markup sum (copy) (copy)_2210352685125341199]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//{ INCLUDE  [LatestMonth]:AVG(IF [LatestMonth]= TRUE THEN [item GBV markup sum] END) }&#10;{FIXED [cohort_month] ,[report_month],[global_entity_id],[source_platform],[is_top_competitor],[vendor_class],[commission_rate_bin],[vendor_cuisine],[markup_age]: AVG(IF [LatestMonth] = TRUE THEN ([total_vendor]) END)}' />
            </column>
            <column caption='LatestMonth_MU Vendor' datatype='real' name='[LatestMonth_item GBV markup sum (copy)_2210352685125328910]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//{ INCLUDE  [LatestMonth]:AVG(IF [LatestMonth]= TRUE THEN [item GBV markup sum] END) }&#10;{FIXED [cohort_month] ,[report_month],[global_entity_id],[source_platform],[is_top_competitor],[vendor_class],[commission_rate_bin],[vendor_cuisine],[markup_age]: AVG(IF [LatestMonth] = TRUE THEN ([markup_vendor]) END)}' />
            </column>
            <column caption='Size By Metric' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Metric Breakdown (copy)_2210352685077307397]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Post-Fix Metric (copy)_2210352685031473152]&#10;WHEN &apos;Commission Rate Bin&apos; THEN SUM([item GBV markup sum (copy)_719098259524489230])&#10;WHEN &apos;Vendor Grade&apos; THEN SUM([item GBV markup sum (copy)_719098259524489230])&#10;WHEN &apos;Item Type&apos; THEN SUM([mui_item_GBV_markup_sum])&#10;WHEN &apos;Top 5 Vendor Cuisine&apos; THEN SUM([item GBV markup sum (copy)_719098259524489230])&#10;END' />
            </column>
