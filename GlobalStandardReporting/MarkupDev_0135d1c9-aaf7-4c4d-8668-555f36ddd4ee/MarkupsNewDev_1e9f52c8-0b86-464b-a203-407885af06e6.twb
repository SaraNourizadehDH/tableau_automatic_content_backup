            <column caption='Top5Cuisine + Others' datatype='string' name='[Calculation_5104408015176171553]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Vendor Cuisine Set]&#10;THEN [vendor_cuisine]&#10;ELSE &quot;Others&quot;&#10;END' />
            </column>
            <column caption='Meal Type' datatype='string' name='[Calculation_556053874195894273]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS(LOWER([meal_type_name]),&quot;drink&quot;) then &quot;drinks&quot;&#10;ELSEIF CONTAINS(LOWER([meal_type_name]),&quot;non food, non drinks&quot;) &#10;OR CONTAINS(LOWER([meal_type_name]),&quot;mixed category&quot;)&#10;OR CONTAINS(LOWER([meal_type_name]),&quot;pre-packaged food&quot;)&#10;OR ISNULL([meal_type_name]) then &quot;others&quot;&#10;ELSE [meal_type_name]&#10;END' />
            </column>
            <column caption='LatestMonth_Total Vendors' datatype='real' name='[LatestMonth_item GBV markup sum (copy) (copy)_2210352685125341199]' role='measure' type='quantitative'>
