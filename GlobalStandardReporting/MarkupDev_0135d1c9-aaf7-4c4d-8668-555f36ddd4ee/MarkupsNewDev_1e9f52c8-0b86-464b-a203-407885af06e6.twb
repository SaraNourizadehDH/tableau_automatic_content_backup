    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/Markups_New_Dev/Definitions?rev=' id='Definitions' path='/t/GlobalStandardReporting/workbooks/Markups_New_Dev' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_34' value='top' />
        </style-rule>
      </style>
      <size maxheight='4000' maxwidth='1300' minheight='4000' minwidth='1300' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='553' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' id='556' param='horz' type-v2='layout-flow' w='100000' x='0' y='0'>
            <zone h='100000' id='554' type-v2='layout-basic' w='87692' x='0' y='0'>
              <zone h='100000' id='552' type-v2='text' w='87692' x='0' y='0'>
                <formatted-text>
                  <run>APPENDIX&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
            <zone fixed-size='160' h='100000' id='555' is-fixed='true' param='vert' type-v2='layout-flow' w='12308' x='87692' y='0' />
          </zone>
        </zone>
        <zone forceUpdate='true' h='2000' id='3' type-v2='text' w='100000' x='0' y='0'>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='18'>MARKUPS</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='background-color' value='#d61f26' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='20775' id='557' type-v2='text' w='96923' x='154' y='2050'>
          <formatted-text>
            <run bold='true' fontcolor='#e15759' fontname='Benton Sans Book' fontsize='14'>DEFINITIONS</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>% of vendors marked up:  </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>COUNT [vendors with min 1 item with markup &gt; 0%] / COUNT [all vendors with min 1 item matched to competition] </run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>% of items marked up: </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>COUNT [items with markup &gt; 0%] / COUNT [all items matched to competition]</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Unweighted Avg. % markup:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>SUM [item markup % if item markup &gt; 0%] / COUNT [items with item markup &gt; 0% ]</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Avg. % markup weighted by item price:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>SUM [item markup % if  &gt; 0 * item price] / SUM [price of items with markup &gt; 0% ]</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Avg. markup weighted by GBV:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>SUM [item markup % where markup &gt; 0% * 30D GBV of item] / SUM [30D GBV of all items matched to competition]</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>% of visits marked up:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>COUNT [Total last calendar month visits of vendors with min 1 item with markup &gt; 0% /  COUNT [Total last calendar month visits of all vendors with min 1 item matched to competition]  </run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Cohort Month:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Enhancing both sides&apos; cohort involvement with item and vendor control implies that any missing vendors or items in the following months will impact not only the values of the cohort month but also retroactively.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Top 5 Items:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>The markup metric status of top 5 sold items

</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Top Competitor:&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>TRUE for the highest Effective GBV Markedup competitor in case vendor mapped to multiple competitors</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>TRUE if vendor mapped to single competitor </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>TRUE for competitor = Wolt / LDO (Austria) in case of DH Europe Foodora
TRUE for nham24 for KH</run>
            <run fontcolor='#000000' fontname='docs-Open Sans' fontsize='8'>Æ&#10;</run>
            <run>Æ&#10;&#10;&#10;&#10;&#10;</run>
          </formatted-text>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='573' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='572' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone h='100000' id='552' type-v2='text' w='87692' x='0' y='0'>
                  <formatted-text>
                    <run>APPENDIX&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2000' id='3' type-v2='text' w='100000' x='0' y='0'>
                  <formatted-text>
                    <run fontalignment='1' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='18'>MARKUPS</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#d61f26' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='20775' id='557' type-v2='text' w='96923' x='154' y='2050'>
                  <formatted-text>
                    <run bold='true' fontcolor='#e15759' fontname='Benton Sans Book' fontsize='14'>DEFINITIONS</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>% of vendors marked up:  </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>COUNT [vendors with min 1 item with markup &gt; 0%] / COUNT [all vendors with min 1 item matched to competition] </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>% of items marked up: </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>COUNT [items with markup &gt; 0%] / COUNT [all items matched to competition]</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Unweighted Avg. % markup:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>SUM [item markup % if item markup &gt; 0%] / COUNT [items with item markup &gt; 0% ]</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Avg. % markup weighted by item price:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>SUM [item markup % if  &gt; 0 * item price] / SUM [price of items with markup &gt; 0% ]</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Avg. markup weighted by GBV:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>SUM [item markup % where markup &gt; 0% * 30D GBV of item] / SUM [30D GBV of all items matched to competition]</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>% of visits marked up:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>COUNT [Total last calendar month visits of vendors with min 1 item with markup &gt; 0% /  COUNT [Total last calendar month visits of all vendors with min 1 item matched to competition]  </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Cohort Month:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Enhancing both sides&apos; cohort involvement with item and vendor control implies that any missing vendors or items in the following months will impact not only the values of the cohort month but also retroactively.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Top 5 Items:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>The markup metric status of top 5 sold items

</run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Top Competitor:&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>TRUE for the highest Effective GBV Markedup competitor in case vendor mapped to multiple competitors</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>TRUE if vendor mapped to single competitor </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>TRUE for competitor = Wolt / LDO (Austria) in case of DH Europe Foodora
TRUE for nham24 for KH</run>
                    <run fontcolor='#000000' fontname='docs-Open Sans' fontsize='8'>Æ&#10;</run>
                    <run>Æ&#10;&#10;&#10;&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
