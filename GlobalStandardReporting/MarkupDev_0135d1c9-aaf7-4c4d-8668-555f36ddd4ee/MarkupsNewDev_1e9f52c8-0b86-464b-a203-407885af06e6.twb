      <column caption='Calculation1' datatype='real' name='[Calculation_6056497135662280705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [age]&#10;WHEN 0 THEN [report_month]' />
      </column>
      <column caption='Calculation2' datatype='datetime' name='[Calculation_6056497135662678018]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;month&apos;, [age], [report_month])' />
      </column>
      <column caption='Cohort metric' datatype='real' name='[Calculation_6056497135703498755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 2] WHEN &apos;Matched vendors&apos; THEN [matched_vendors]&#10;WHEN &apos;Matched Items&apos; THEN [matched_items]&#10;WHEN  &apos;Matched GBV&apos; then  [matched_gbv]&#10;END' />
      </column>
      <column caption='Vendors business coverage' datatype='real' name='[Calculation_904590266664361994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([matched_vendors])/SUM([active_vendors])' />
      </column>
      <column caption='Market Cohort metric' datatype='real' name='[Cohort metric (copy)_6056497135719600135]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Metric (copy)_6056497135719493638] WHEN &apos;Matched vendors&apos; THEN [matched_vendors]&#10;WHEN &apos;Matched Items&apos; THEN [matched_items]&#10;WHEN  &apos;Matched GBV&apos; then  [matched_gbv]&#10;END' />
      </column>
      <column caption='GBV business coverage' datatype='real' name='[Items business coverage (copy)_904590266664755212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#10;WHEN FALSE THEN SUM([matched_gbv])/SUM([active_gbv])&#10;ELSE SUM([top_matched_gbv])/SUM([active_gbv])&#10;END' />
      </column>
      <column caption='Items business coverage' datatype='real' name='[Vendors business coverage (copy)_904590266664607755]' role='measure' type='quantitative'>
