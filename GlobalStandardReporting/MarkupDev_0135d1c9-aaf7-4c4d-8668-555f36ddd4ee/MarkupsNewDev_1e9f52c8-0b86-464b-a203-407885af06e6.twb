      <column caption='Fix Rate' datatype='real' default-format='p0%' name='[Calculation_2325827790678138880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Post-Fix Metric (copy)_2325827792164397064]&#10;WHEN &quot;Vendors&quot; THEN ROUND(SUM([fixed_vendors]),0)/ROUND(SUM([last_month_mu_vendor_count]),0)&#10;WHEN &quot;Items&quot; THEN ROUND(SUM([fixed_items]),0)/ROUND(SUM([previous_markup_items]),0)&#10;END' />
