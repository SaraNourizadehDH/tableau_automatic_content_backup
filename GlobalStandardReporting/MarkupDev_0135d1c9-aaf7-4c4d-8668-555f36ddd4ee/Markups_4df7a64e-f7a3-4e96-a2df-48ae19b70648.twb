          <datasource-dependencies datasource='Parameters'>
            <column caption='Main KPI - Top Parameter' datatype='string' name='[Main KPI - Top Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;GBV&quot;'>
              <calculation class='tableau' formula='&quot;GBV&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1kbe2qk0donq2k16xqren19sex0y'>
            <column caption='Main KPI - Top %' datatype='real' default-format='p0.0%' name='[Calculation_11047894985265152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Main KPI (copy)_5946440359998738451])&#10;/&#10;SUM([Calculation_5946440359991574545])' />
            </column>
            <column caption='Main KPI - Markup' datatype='real' name='[Calculation_380061593073123329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_5946440359992066066] IN (&apos;Consecutively Marked Up&apos;,&apos;MARKED UP&apos;) &#10;THEN [Calculation_5946440359991574545]&#10;END' />
            </column>
            <column caption='Main KPI - Markup TOP Ratio vs all Markup' datatype='real' default-format='p0.0%' name='[Calculation_380061593073725445]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Main KPI - Markup (copy)_380061593073610756])&#10;/&#10;SUM([Calculation_380061593073123329])' />
            </column>
            <column caption='Main KPI - Row Filter' datatype='boolean' name='[Calculation_394205707051540480]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Main KPI - Top Parameter]&#10;WHEN &apos;VENDORS&apos; THEN [info_level] = &apos;Vendor&apos;&#10;WHEN &apos;GBV&apos; THEN [info_level] = &apos;Item&apos;&#10;WHEN &apos;ITEMS&apos; THEN [info_level] = &apos;Item&apos;&#10;END' />
            </column>
            <column caption='Item Markup Bin STR' datatype='string' name='[Calculation_4112208675668361216]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [item_markup_bin]&#10;WHEN  0 THEN &apos;AT PAR&apos;&#10;WHEN  1 THEN &apos;MARKED UP&apos;&#10;WHEN -1 THEN &apos;MARKED DOWN&apos;&#10;ELSE &apos;NOT ENOUGH INFO&apos;&#10;END' />
            </column>
            <column caption='Main KPI' datatype='real' name='[Calculation_5946440359991574545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Main KPI - Top Parameter]&#10;WHEN &apos;VENDORS&apos; THEN [Vendor level - Murkup Vendors QTY (copy)_5946440359986393102]&#10;WHEN &apos;GBV&apos; THEN [Item level - Murkup GBV (copy)_5208131496016117763]&#10;WHEN &apos;ITEMS&apos; THEN [Item level - GBV Universe (copy)_5946440359970885633] &#10;END' />
            </column>
            <column caption='Main Dimension' datatype='string' name='[Calculation_5946440359992066066]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Main KPI - Top Parameter]&#10;WHEN &apos;VENDORS&apos; THEN [vendor_avg_markup_gmv_weighted_flag]&#10;WHEN &apos;GBV&apos; THEN [Calculation_4112208675668361216]&#10;WHEN &apos;ITEMS&apos; THEN [Calculation_4112208675668361216]&#10;END' />
            </column>
            <column caption='Item level - Item Universe' datatype='integer' name='[Item level - GBV Universe (copy)_5946440359970885633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [info_level] = &apos;Item&apos; then [count_unique_item] end' />
            </column>
            <column caption='Item level - GBV Universe' datatype='real' name='[Item level - Murkup GBV (copy)_5208131496016117763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [info_level] = &apos;Item&apos; then [item_gbv_eur_90] end' />
            </column>
            <column caption='Main KPI - Top' datatype='real' name='[Main KPI (copy)_5946440359998738451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [chain_rank_class] = &apos;TOP&apos; &#10;THEN &#10;CASE [Parameters].[Main KPI - Top Parameter]&#10;WHEN &apos;VENDORS&apos; THEN [Vendor level - Murkup Vendors QTY (copy)_5946440359986393102]&#10;WHEN &apos;GBV&apos; THEN [Item level - Murkup GBV (copy)_5208131496016117763]&#10;WHEN &apos;ITEMS&apos; THEN [Item level - GBV Universe (copy)_5946440359970885633] &#10;END&#10;END' />
            </column>
            <column caption='Main KPI - Markup TOP' datatype='real' name='[Main KPI - Markup (copy)_380061593073610756]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_5946440359992066066] IN (&apos;Consecutively Marked Up&apos;,&apos;MARKED UP&apos;) &#10;THEN [Main KPI (copy)_5946440359998738451]&#10;END' />
            </column>
