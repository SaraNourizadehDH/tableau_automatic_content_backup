      <aliases enabled='yes' />
      <column caption='Waterfall Label' datatype='string' name='[Calculation_226939218899222532]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE MIN([Id Number])&#10;WHEN 1  THEN &quot;High confidence shared vendors&quot;&#10;WHEN 2  THEN &quot;Shared with a non competitor&quot;&#10;WHEN 3  THEN &quot;High confidence shared vendors (with competitor)&quot;&#10;WHEN 4  THEN &quot;Menu matching disabled (INTENTIONALY)&quot;&#10;WHEN 5  THEN &quot;High confidence shared vendors (with competitor) and menu mathing applies&quot;&#10;WHEN 6  THEN &quot;Unable to scrape menu data&quot;&#10;WHEN 7  THEN &quot;High confidence vendors with at least one item scraped&quot;&#10;WHEN 8  THEN &quot;Vendor with no revenue&quot;&#10;WHEN 9  THEN &quot;Unable to get DH item data&quot;&#10;WHEN 10 THEN &quot;High confidence vendors with DH Items Data (&gt;80% GBV)&quot;&#10;WHEN 11 THEN &quot;Unable to match &gt;50% of Active Items GBV&quot;&#10;WHEN 12 THEN &quot;High confidence matched vendors with &gt;50% of Active Items GBV matched to competition&quot;&#10;END' />
      </column>
      <column caption='Waterfall Size %' datatype='real' default-format='p0.0%' name='[Calculation_226939218939650073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Waterfall Start (copy)_226939218915770388]&#10;/sum([high_conf_vendors_in_competitors_and_mu_applies])' />
      </column>
      <column caption='Vendor Group' datatype='string' name='[Calculation_5672494900363939840]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Split by 1 (copy)_5672494900371451906] in (&apos;Vendor Class&apos;,&apos;Vendor All&apos;)&#10;then&#10;    CASE [vendor_class]&#10;    WHEN &apos;A&apos;  THEN &apos;A/B&apos;&#10;    WHEN &apos;B&apos;  THEN &apos;A/B&apos;&#10;    WHEN &apos;C&apos;  THEN &apos;C/D&apos;&#10;    WHEN &apos;D&apos;  THEN &apos;C/D&apos;&#10;    WHEN &apos;Z&apos;  THEN &apos;Z/ND&apos;&#10;    WHEN &apos;ND&apos; THEN &apos;Z/ND&apos;&#10;    END&#10;else &apos;&apos;&#10;end' />
      </column>
      <column caption='Vendor Type' datatype='string' name='[Calculation_5672494900364705793]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Split by 1 (copy)_5672494900371451906] in (&apos;Vendor Type&apos;,&apos;Vendor All&apos;)&#10;then&#10;    if [is_key_account] then &apos;Key Account&apos;&#10;    else &apos;Non Key Account&apos;&#10;    end&#10;else &apos;&apos;&#10;end' />
      </column>
      <column caption='sub entity level' datatype='string' name='[Calculation_5672494900374564868]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Split by 1 (copy)_5672494900371451906] in (&apos;Country&apos;) then [sub_entity] else &apos;&apos; end' />
      </column>
      <column aggregation='Sum' datatype='integer' name='[Id Number]' role='dimension' type='ordinal' />
      <column caption='Waterfall Start' datatype='integer' datatype-customized='true' name='[Label (copy)_226939218901823493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE MIN([Id Number])&#10;WHEN 1  THEN 0&#10;WHEN 2  THEN sum([high_conf_vendors_in_competitors])&#10;WHEN 3  THEN 0&#10;WHEN 4  THEN sum([high_conf_vendors_in_competitors_and_mu_applies])&#10;WHEN 5  THEN 0&#10;WHEN 6  THEN sum([high_conf_vendors_in_competitors_w_dh_items])&#10;WHEN 7  THEN 0&#10;WHEN 8  THEN sum([high_conf_vendors_in_competitors_w_dh_items])&#10;                - sum([high_conf_vendors_in_competitors_w_dh_items_but_no_revenue])&#10;WHEN 9  THEN sum([high_conf_vendors_in_competitors_w_dh_items_and_gbv_coverage])&#10;WHEN 10 THEN 0&#10;WHEN 11 THEN sum([high_conf_vendors_in_competitors_with_vendor_completeness_flag])&#10;WHEN 12 THEN 0&#10;END' />
      </column>
      <column caption='Waterfall Label Colour' datatype='string' name='[Waterfall Label (copy)_226939218918629400]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE MIN([Id Number])&#10;WHEN 1  THEN &quot;PRE UNIVERSE&quot;&#10;WHEN 2  THEN &quot;CLEANUP&quot;&#10;WHEN 3  THEN &quot;PRE UNIVERSE&quot;&#10;WHEN 4  THEN &quot;CLEANUP 2&quot;&#10;WHEN 5  THEN &quot;TOTALS&quot;&#10;WHEN 6  THEN &quot;DROP&quot;&#10;WHEN 7  THEN &quot;TOTALS&quot;&#10;WHEN 8  THEN &quot;DROP&quot;&#10;WHEN 9  THEN &quot;DROP&quot;&#10;WHEN 10 THEN &quot;TOTALS&quot;&#10;WHEN 11 THEN &quot;DROP&quot;&#10;WHEN 12 THEN &quot;TOTALS&quot;&#10;END' />
      </column>
      <column caption='Waterfall Size' datatype='integer' datatype-customized='true' name='[Waterfall Start (copy)_226939218915770388]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE MIN([Id Number])&#10;WHEN 1  THEN sum([high_conf_vendors])&#10;WHEN 2  THEN sum([high_conf_vendors])&#10;                - sum([high_conf_vendors_in_competitors])&#10;WHEN 3  THEN sum([high_conf_vendors_in_competitors])&#10;WHEN 4  THEN sum([high_conf_vendors_in_competitors])&#10;                - sum([high_conf_vendors_in_competitors_and_mu_applies])&#10;WHEN 5  THEN sum([high_conf_vendors_in_competitors_and_mu_applies])&#10;WHEN 6  THEN sum([high_conf_vendors_in_competitors_and_mu_applies])&#10;                - sum([high_conf_vendors_in_competitors_w_dh_items])&#10;WHEN 7  THEN sum([high_conf_vendors_in_competitors_w_dh_items])&#10;WHEN 8  THEN sum([high_conf_vendors_in_competitors_w_dh_items_but_no_revenue])&#10;WHEN 9  THEN sum([high_conf_vendors_in_competitors_w_dh_items])&#10;                - sum([high_conf_vendors_in_competitors_w_dh_items_but_no_revenue])&#10;                - sum([high_conf_vendors_in_competitors_w_dh_items_and_gbv_coverage])&#10;WHEN 10 THEN sum([high_conf_vendors_in_competitors_w_dh_items_and_gbv_coverage])&#10;WHEN 11 THEN sum([high_conf_vendors_in_competitors_w_dh_items_and_gbv_coverage])&#10;                - sum([high_conf_vendors_in_competitors_with_vendor_completeness_flag])&#10;WHEN 12 THEN sum([high_conf_vendors_in_competitors_with_vendor_completeness_flag])&#10;END' />
      </column>
      <column caption='Waterfall Line' datatype='integer' datatype-customized='true' name='[Waterfall Start (copy)_226939218943070234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE MIN([Id Number])&#10;WHEN 1  THEN sum([high_conf_vendors])&#10;WHEN 2  THEN sum([high_conf_vendors_in_competitors])&#10;WHEN 3  THEN sum([high_conf_vendors_in_competitors])&#10;WHEN 4  THEN sum([high_conf_vendors_in_competitors_and_mu_applies])&#10;WHEN 5  THEN sum([high_conf_vendors_in_competitors_and_mu_applies])&#10;WHEN 6  THEN sum([high_conf_vendors_in_competitors_w_dh_items])&#10;WHEN 7  THEN sum([high_conf_vendors_in_competitors_w_dh_items])&#10;WHEN 8  THEN sum([high_conf_vendors_in_competitors_w_dh_items])&#10;                - sum([high_conf_vendors_in_competitors_w_dh_items_but_no_revenue])&#10;WHEN 9  THEN sum([high_conf_vendors_in_competitors_w_dh_items_and_gbv_coverage])     &#10;WHEN 10 THEN sum([high_conf_vendors_in_competitors_w_dh_items_and_gbv_coverage])&#10;WHEN 11 THEN sum([high_conf_vendors_in_competitors_with_vendor_completeness_flag])&#10;WHEN 12 THEN sum([high_conf_vendors_in_competitors_with_vendor_completeness_flag])&#10;END' />
      </column>
