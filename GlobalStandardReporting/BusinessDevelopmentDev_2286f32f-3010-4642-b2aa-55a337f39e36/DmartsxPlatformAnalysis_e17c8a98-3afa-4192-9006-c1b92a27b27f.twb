    <worksheet name='3. X-sells Chart (return period)'>
      <repository-location id='3_X-sellsChartreturnperiod' path='/t/GlobalStandardReporting/workbooks/DmartsxPlatformAnalysis' revision='' site='GlobalStandardReporting' />
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='15'>GBV / Customer - &lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run fontname='Tableau Light' fontsize='14'>How much does the GBV / Customer increase after x-trial? Is there any cannibalization?</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='9'>Notes: X-rials from Feb&apos;22-Jul&apos;22; excl. Greece; Turkey data before March not reliable. Data only to be displayed at a country level.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Trials' name='federated.0xcz8he13b4qs11fr0i4s1aimr38' />
            <datasource caption='Food Frequency' name='federated.103hgg71b0wk6m1a30wx91xttakj' />
          </datasources>
          <datasource-dependencies datasource='federated.0xcz8he13b4qs11fr0i4s1aimr38'>
            <column caption='Management Entity' datatype='string' name='[Calculation_715509425399508998]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [management_entity]&#13;&#10;    WHEN &quot;DH Austria&quot; THEN &quot;EU Pandora&quot;&#13;&#10;    WHEN &quot;DH CEE&quot; THEN &quot;EU Pandora&quot;&#13;&#10;    WHEN &quot;DH Nordics&quot; THEN &quot;EU Pandora&quot;&#13;&#10;    ELSE [management_entity]&#13;&#10;END' />
            </column>
            <column caption='GBV/Customer' datatype='real' name='[Calculation_715509425399947271]' role='measure' type='quantitative'>
