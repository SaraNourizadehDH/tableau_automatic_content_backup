      <column caption='Non-Dmart User Food Frequency' datatype='real' name='[Active Adopter / Non-Dmart User Food Frequency (copy)_1516305735483224065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;SUM(&#13;&#10;    IF [user_category] = &quot;Non-Dmart user&quot;&#13;&#10;    THEN [order_count] END)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [user_category] = &quot;Non-Dmart user&quot;&#13;&#10;    THEN [user_count] END)&#13;&#10;)' />
      </column>
      <column caption='Active Non-Adopter / Non-Dmart User' datatype='real' default-format='p0%' name='[Active Adopter / Non-Dmart User Food Frequency (copy)_1516305735484047362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;SUM(&#13;&#10;    IF [user_category] = &quot;Dmart active non-adopter&quot;&#13;&#10;    THEN [order_count] END)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [user_category] = &quot;Dmart active non-adopter&quot;&#13;&#10;    THEN [user_count] END)&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;SUM(&#13;&#10;    IF [user_category] = &quot;Non-Dmart user&quot;&#13;&#10;    THEN [order_count] END)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [user_category] = &quot;Non-Dmart user&quot;&#13;&#10;    THEN [user_count] END)&#13;&#10;)' />
      </column>
      <column caption='Active Adopter / Non-Dmart User' datatype='real' default-format='p0%' name='[Calculation_1516305735482576896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;SUM(&#13;&#10;    IF [user_category] = &quot;Dmart active adopter&quot;&#13;&#10;    THEN [order_count] END)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [user_category] = &quot;Dmart active adopter&quot;&#13;&#10;    THEN [user_count] END)&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;SUM(&#13;&#10;    IF [user_category] = &quot;Non-Dmart user&quot;&#13;&#10;    THEN [order_count] END)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [user_category] = &quot;Non-Dmart user&quot;&#13;&#10;    THEN [user_count] END)&#13;&#10;)' />
      </column>
      <column caption='Food Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_715509425388949504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_count])/SUM([user_count])' />
      </column>
      <column caption='Management Entity' datatype='string' name='[Calculation_715509425389748225]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [management_entity]&#13;&#10;    WHEN &quot;DH Austria&quot; THEN &quot;EU Pandora&quot;&#13;&#10;    WHEN &quot;DH CEE&quot; THEN &quot;EU Pandora&quot;&#13;&#10;    WHEN &quot;DH Nordics&quot; THEN &quot;EU Pandora&quot;&#13;&#10;    ELSE [management_entity]&#13;&#10;END' />
      </column>
      <column caption='Rank Freq' datatype='real' name='[Calculation_715509425390743554]' role='measure' type='quantitative'>
