      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0xcz8he13b4qs11fr0i4s1aimr38].[usr:Calculation_715509425399947271:qk]:2&quot;' value='X-sells - GBV/Customer' />
        </aliases>
      </column>
      <column caption='Management Entity' datatype='string' name='[Calculation_715509425399508998]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [management_entity]&#13;&#10;    WHEN &quot;DH Austria&quot; THEN &quot;EU Pandora&quot;&#13;&#10;    WHEN &quot;DH CEE&quot; THEN &quot;EU Pandora&quot;&#13;&#10;    WHEN &quot;DH Nordics&quot; THEN &quot;EU Pandora&quot;&#13;&#10;    ELSE [management_entity]&#13;&#10;END' />
      </column>
      <column caption='GBV/Customer' datatype='real' name='[Calculation_715509425399947271]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gbv])/AVG([total_customers])' />
      </column>
      <column caption='Trial Month flag' datatype='boolean' name='[Calculation_715509425402593289]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[trial_month]=[month]' />
      </column>
      <column caption='Prospects - GBV / Customer' datatype='real' name='[Calculation_779967209575899136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([prospects_gbv])/SUM([prospects_customers])' />
      </column>
      <column caption='Rank GBV/Customer' datatype='real' name='[GBV/Customer (copy)_715509425402019848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_PERCENTILE([Calculation_715509425399947271])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Frequency' datatype='real' name='[GBV/Customer (copy)_715509425403224074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])/AVG([total_customers])' />
      </column>
