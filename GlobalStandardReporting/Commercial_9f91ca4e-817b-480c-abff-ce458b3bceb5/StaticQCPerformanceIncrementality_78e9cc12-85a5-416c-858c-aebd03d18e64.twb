            <column datatype='real' name='[qc_gbv_per_customer_post_6M]' role='measure' type='quantitative' />
            <column datatype='real' name='[total_gbv_per_customer_post_6M]' role='measure' type='quantitative' />
            <column datatype='real' name='[total_gbv_per_customer_pre_6M]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1107041086649581573]' derivation='User' name='[usr:Calculation_1107041086649581573:qk]' pivot='key' type='quantitative' />
