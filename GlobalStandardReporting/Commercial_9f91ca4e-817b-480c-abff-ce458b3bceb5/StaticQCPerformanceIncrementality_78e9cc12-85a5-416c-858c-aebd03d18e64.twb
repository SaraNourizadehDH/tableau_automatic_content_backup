          <formatted-text>
            <run fontcolor='#d30000' fontname='Tableau Bold' fontsize='18'><![CDATA[<[Parameters].[Parameter 2]> GBV Uplift of <[Parameters].[Parameter 1]>: 6M post-trial vs. 6M pre-trial]]></run>
            <run>Æ&#10;</run>
            <run bold='true' fontname='Tableau Book' fontsize='12'><![CDATA[Filtering only cross-selled LS<>DM users from Jan'22 to Jan'23 that have tried the first vertical 6 months before trying the second one.]]></run>
            <run>Æ&#10;</run>
