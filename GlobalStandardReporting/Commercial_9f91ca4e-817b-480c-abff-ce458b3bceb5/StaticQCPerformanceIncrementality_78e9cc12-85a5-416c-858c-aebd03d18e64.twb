            <run bold='true' fontname='Tableau Book' fontsize='12'>Filtering only cross selled users from Jan&apos;22 to Jan&apos;23 that have been acquired at least 6 months before they tried QC.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontname='Tableau Book' fontsize='12'>For simplicity: QC = Dmarts + Shops</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='QC-BarChart-Entity' path='/t/GlobalStandardReporting/workbooks/StaticQC-Performance-Incrementality' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared_central_dwh) (5)' name='federated.0wha2650dkaby01aqx28q117lxrg' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Open by Vertical Parent' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;No&quot;'>
              <calculation class='tableau' formula='&quot;No&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0wha2650dkaby01aqx28q117lxrg'>
            <column caption='Vertical Parent' datatype='string' name='[Calculation_1107041086621126657]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;    WHEN &quot;Yes&quot; THEN [vertical_parent_qc_trial]&#13;&#10;    WHEN &quot;No&quot; THEN NULL&#13;&#10;END' />
            </column>
            <column caption='GBV Total Uplift % New' datatype='real' default-format='p0%' name='[Calculation_1107041086649581573]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(total_gbv_per_customer_post_6M)/SUM([cohort_size])/6)/(SUM(total_gbv_per_customer_pre_6M)/SUM([cohort_size])/6)-1' />
            </column>
            <column caption='GBV  Uplift by QC % New' datatype='real' default-format='p0%' name='[GBV Total Uplift % New (copy)_1107041086649700358]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(qc_gbv_per_customer_post_6M)/SUM([cohort_size])/6)/(SUM(total_gbv_per_customer_pre_6M)/SUM([cohort_size])/6)' />
            </column>
            <column datatype='integer' name='[cohort_size]' role='measure' type='quantitative' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
