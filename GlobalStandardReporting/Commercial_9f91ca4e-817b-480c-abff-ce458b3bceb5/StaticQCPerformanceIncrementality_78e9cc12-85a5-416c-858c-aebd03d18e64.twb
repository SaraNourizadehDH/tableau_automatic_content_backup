      <aliases enabled='yes' />
      <column caption='Frequency' datatype='real' name='[ABV (copy)_1332784067937988616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qc_orders])/SUM([qc_active_customers])' />
      </column>
      <column datatype='real' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_PERCENTILE([Calculation_1266918929111298049])'>
          <table-calc ordering-type='Field'>
            <order field='[federated.1sgro440npktov17xj7s715zch14].[my:trial_month:ok]' />
            <order field='[federated.1sgro440npktov17xj7s715zch14].[return_period]' />
          </table-calc>
        </calculation>
      </column>
      <column datatype='real' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_PERCENTILE([Calculation_1266918929111298049])'>
          <table-calc ordering-type='Field'>
            <order field='[federated.1sgro440npktov17xj7s715zch14].[my:trial_month:ok]' />
            <order field='[federated.1sgro440npktov17xj7s715zch14].[return_period]' />
          </table-calc>
        </calculation>
      </column>
      <column caption='GBV / Customer' datatype='real' name='[Calculation_1266918929111298049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_gbv])/SUM([cohort_size])' />
      </column>
      <column caption='pre and post' datatype='string' name='[Calculation_1332784067583045632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [return_period]&lt;0 THEN &quot;6 months before trial&quot;&#13;&#10;ELSEIF  [return_period]&gt;0 THEN &quot;6 months after trial&quot;&#13;&#10;END' />
      </column>
      <column caption='Hypothesis' datatype='string' name='[Calculation_1332784067890524163]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;FO Ultrafresh&apos; THEN [first_order_ultra_fresh]&#13;&#10;WHEN &apos;FO number cats&apos; THEN [first_order_categories]&#13;&#10;WHEN &apos;FO AAA&apos; THEN [is_aaa]&#13;&#10;END' />
      </column>
      <column caption='Ret' datatype='real' name='[Calculation_1332784067918462981]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_customers])/SUM([cohort_size])' />
      </column>
      <column caption='ABV' datatype='real' name='[Calculation_1332784067923992583]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qc_gbv])/SUM([qc_orders])' />
      </column>
      <column caption='QC GBV / Customer' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[GBV / Customer (copy)_903816209418084352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [return_period] &gt; 0 THEN [qc_gbv] END)/SUM([cohort_size])' />
      </column>
      <column caption='Retention' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[QC GBV / Customer (copy)_1332784067877163009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [return_period] &gt; 0 THEN [qc_active_customers] END)/SUM([cohort_size])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_697F06643F4C4B869C27EE3E710EA078]' role='measure' type='quantitative' />
