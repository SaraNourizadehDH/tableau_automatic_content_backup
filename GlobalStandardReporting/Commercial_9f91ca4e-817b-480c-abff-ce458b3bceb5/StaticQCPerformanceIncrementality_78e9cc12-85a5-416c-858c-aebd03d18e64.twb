            <datasource caption='Custom SQL Query (curated_data_shared_central_dwh) (2)' name='federated.1sgro440npktov17xj7s715zch14' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Highlighted GBV / Customer' datatype='string' name='[GBV / Customer (copy)_903816209438904336]' param-domain-type='list' role='measure' type='nominal' value='&quot;LS&quot;'>
              <calculation class='tableau' formula='&quot;LS&quot;' />
            </column>
            <column caption='Trial Direction' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Existing in DM &gt; Tried LS&quot;'>
              <calculation class='tableau' formula='&quot;Existing in DM &gt; Tried LS&quot;' />
