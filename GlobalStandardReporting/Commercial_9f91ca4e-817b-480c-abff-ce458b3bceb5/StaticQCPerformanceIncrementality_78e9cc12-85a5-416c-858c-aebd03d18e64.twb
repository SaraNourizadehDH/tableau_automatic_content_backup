    <worksheet name='QC - Summary Global'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#d30000' fontname='Tableau Bold' fontsize='18'>GBV Uplift of QC Cross Sells: 6M post-trial vs. 6M pre-trial</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='12'>Filtering only cross selled users from Jan&apos;22 to Jun&apos;23 that have been acquired at least 6 months before they tried QC.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='12'>For simplicity: QC = Dmarts + Shops</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared_central_dwh) (2)' name='federated.1sgro440npktov17xj7s715zch14' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='DM-FO with Ultrafresh' caption='Flags' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;FO Ultrafresh&quot;'>
              <calculation class='tableau' formula='&quot;FO Ultrafresh&quot;' />
              <aliases>
                <alias key='&quot;FO AAA&quot;' value='LS-FO AAA vendor' />
                <alias key='&quot;FO number cats&quot;' value='DM-FO +4 categories' />
                <alias key='&quot;FO Ultrafresh&quot;' value='DM-FO with Ultrafresh' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1sgro440npktov17xj7s715zch14'>
            <column caption='GBV / Customer' datatype='real' name='[Calculation_1266918929111298049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_gbv])/SUM([cohort_size])' />
            </column>
            <column caption='pre and post' datatype='string' name='[Calculation_1332784067583045632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [return_period]&lt;0 THEN &quot;6 months before trial&quot;&#13;&#10;ELSEIF  [return_period]&gt;0 THEN &quot;6 months after trial&quot;&#13;&#10;END' />
            </column>
            <column caption='Hypothesis' datatype='string' name='[Calculation_1332784067890524163]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &apos;FO Ultrafresh&apos; THEN [first_order_ultra_fresh]&#13;&#10;WHEN &apos;FO number cats&apos; THEN [first_order_categories]&#13;&#10;WHEN &apos;FO AAA&apos; THEN [is_aaa]&#13;&#10;END' />
            </column>
            <column caption='QC GBV / Customer' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[GBV / Customer (copy)_903816209418084352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [return_period] &gt; 0 THEN [qc_gbv] END)/SUM([cohort_size])' />
            </column>
            <column caption='Cohort Size' datatype='integer' name='[cohort_size]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='first_order_categories (DMARTS ONLY)' datatype='string' name='[first_order_categories]' role='dimension' type='nominal' />
