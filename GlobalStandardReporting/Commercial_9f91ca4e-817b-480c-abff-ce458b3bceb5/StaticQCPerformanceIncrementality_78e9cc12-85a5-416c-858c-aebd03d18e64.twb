            <column caption='DM - QC GBV / Customer' datatype='real' name='[DM - LS GBV / Customer (copy)_903816209435426824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([dm_ls_gbv],0)+IFNULL([dm_dm_gbv],0))/SUM([dm_cohort_size])' />
