    <worksheet name='QC - Plot Chart'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#d30000' fontname='Tableau Bold' fontsize='18'>GBV Uplift of QC Cross Sells: 6M post-trial vs. 6M pre-trial</run>
            <run>Æ&#10;</run>
            <run bold='true' fontname='Tableau Book' fontsize='12'>Filtering only cross selled users from Jan&apos;22 to Jan&apos;23 that have been acquired at least 6 months before they tried QC.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontname='Tableau Book' fontsize='12'>For simplicity: QC = Dmarts + Shops</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='QC-PlotChart' path='/t/GlobalStandardReporting/workbooks/StaticQC-Performance-Incrementality' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared_central_dwh)' name='federated.1gj45hp0yoptb51flxcds1ss6wen' />
          </datasources>
          <datasource-dependencies datasource='federated.1gj45hp0yoptb51flxcds1ss6wen'>
            <column caption='GBV Uplift % - QC New' datatype='real' default-format='p0%' name='[Calculation_1107041086644584451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(qc_gbv_per_customer_post_6M)/SUM([cohort_size])/6)/(SUM(total_gbv_per_customer_pre_6M)/SUM([cohort_size])/6)' />
            </column>
