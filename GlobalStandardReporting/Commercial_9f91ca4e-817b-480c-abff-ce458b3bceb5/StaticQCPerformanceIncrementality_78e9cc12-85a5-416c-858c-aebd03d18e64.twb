              <calculation class='tableau' formula='&quot;FO Ultrafresh&quot;' />
              <aliases>
                <alias key='&quot;FO AAA&quot;' value='LS-FO AAA vendor' />
                <alias key='&quot;FO number cats&quot;' value='DM-FO +4 categories' />
