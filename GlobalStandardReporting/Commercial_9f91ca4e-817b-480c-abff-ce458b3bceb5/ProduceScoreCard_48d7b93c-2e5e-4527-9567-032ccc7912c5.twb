                  <formatted-text>
                    <run fontcolor='#e15759' fontsize='32'>Assortment Quality Scorecard</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>Calculations and Definitions</run>
