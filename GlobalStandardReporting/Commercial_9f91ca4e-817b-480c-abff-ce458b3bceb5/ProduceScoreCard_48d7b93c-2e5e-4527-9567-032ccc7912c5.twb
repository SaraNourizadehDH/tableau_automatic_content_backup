    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='OLDGetting Started'>
      <repository-location derived-from='http://ip-172-31-0-158:8054/t/GlobalStandardReporting/workbooks/AssortmentQualityScoreCard_P/GettingStarted?rev=' id='GettingStarted' path='/t/GlobalStandardReporting/workbooks/AssortmentQualityScoreCard_P' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1400' maxwidth='1000' minheight='1400' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='6' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='2277' id='5' type-v2='text' w='98400' x='800' y='18652'>
            <formatted-text>
              <run bold='true' fontcolor='#e15759' fontsize='18'>How is the Score calculated?</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='8071' id='7' type-v2='text' w='98400' x='800' y='20929'>
            <formatted-text>
              <run fontcolor='#000000' fontsize='10'>To calculate the final score, the evaluation considers seven Key Performance Indicators (KPIs) displayed below. For each warehouse per month, these KPIs are assigned a specific score ranging from 0 to 10. The scores are then multiplied by the corresponding weight assigned to each KPI, and the results are summed to generate the final score, which falls within the range of 0 to 100. The image below provides a visual representation of the weights, aggregation and scores assigned to each KPI, facilitating a clearer understanding of the calculation process.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='10669' id='45' is-centered='0' is-scaled='1' param='Image/DH-Logo_Tableau 1.png' type-v2='bitmap' w='14400' x='800' y='571'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='10669' id='46' type-v2='text' w='84000' x='15200' y='571'>
            <formatted-text>
              <run fontcolor='#e15759' fontsize='32'>Assortment Quality Scorecard</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>Calculations and Definitions</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#555555' fontsize='11'>D-Marts QCommerce</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='3072' id='47' type-v2='text' w='98400' x='800' y='43571'>
            <formatted-text>
              <run bold='true' fontcolor='#e15759' fontsize='18'>Metrics: </run>
              <run fontcolor='#ea565f' fontsize='14' italic='true'>Definitions &amp; Calculations</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='52786' id='48' type-v2='text' w='98400' x='800' y='46643'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='13' underline='true'>Imput Metrics</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='11' italic='true'>*Please click the above AQS Calculations link for detailed explanations, examples of each calculation, and definitions of how each metric is aggregated at the country, region, and global levels</run>
              <run fontcolor='#000000' fontsize='11'>.</run>
              <run fontcolor='#000000' fontsize='11' italic='true'>Æ  </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='11' italic='true'>**Warehouses are considered in this report  if (1) iwarehouse maturity is greater than 90 days and (2) are not closed/to close warehouses.  </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Listed SKUs Achievement %</run>
              <run fontcolor='#000000' fontsize='11'>: Achievement (%) vs ambition level for each country.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Newness: </run>
              <run fontcolor='#000000' fontsize='11'>% of products onboarded in the past 90 days.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>L2 Core Category Design %: </run>
              <run fontcolor='#000000' fontsize='11'>Compliance to min accceptable category share per 10 Core L2 categories.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Ultrafresh Basket Penetration %: </run>
              <run fontcolor='#000000' fontsize='11'> Baskets containing at least one UltraFresh SKU / overall baskets (excluding single tobacco orders).</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Efficiency %</run>
              <run fontcolor='#000000' fontsize='11'>: % of mature and available products that sell at least 1 unit per store per week.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Weighted Availability %: </run>
              <run fontcolor='#000000' fontsize='11'>Sales session weighted availability of products.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Discontinued Book Value:</run>
              <run fontcolor='#000000' fontsize='11'> WAC Eur Value of discontinued (delisted) products.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10' italic='true'>1. For regions with Status Hierarchy: Book Value of not listed SKUs (Discontinued) / Total Warehouse Book Value</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10' italic='true'>2. For regions without Status Hierarchy: Book Value of Long Term Zero Movers (labeled as ZMs consistently during the last three months) / Total Warehouse Book Value</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>EOY Target Completion %: </run>
              <run fontcolor='#000000' fontsize='11'>(Month AQS  - Last Year&apos;s December AQS) / (EOY Target AQS- Last Year&apos;s December AQS)</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Æ </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='13' underline='true'>Perception Metrics</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>GPV Share: </run>
              <run fontcolor='#000000' fontsize='11'>Share of GPV based on total whs/countries/regions displayed (Be aware that calculation is along table, meaning that if you manually select some countries, the GPV share will be recalculated based only on those selected)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Listed SKUs: </run>
              <run fontcolor='#000000' fontsize='11'>Number of listed SKUs at the last day of the month.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>1. For coutries with Status Hierarchy, since 2023-07-01 a listed SKU follows this rule: (SH-ACTIVE OR (SH-ON_HOLD AND on_hand_qty&gt;0) AND NOT stale_sku)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>2. For coutries without Status Hierarchy a listed SKU follows this rule: (is_active from catalog AND NOT stale_sku)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>MAU Penetration: </run>
              <run fontcolor='#000000' fontsize='11'># MAU covered by at least 1 DMart / Platform MAU</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Core SKU Coverage: </run>
              <run fontcolor='#000000' fontsize='11'>#</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Æ </run>
              <run fontcolor='#000000' fontsize='11'>Top 70% selling SKUs within a country which are listed in the WH/#</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Æ </run>
              <run fontcolor='#000000' fontsize='11'>Top 70% selling SKUs within a country   </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='13' underline='true'>Output Metrics</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>ABV:</run>
              <run fontcolor='#000000' fontsize='11'> Average Basket Value:  Total GPV / Number of orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>ABS:</run>
              <run fontcolor='#000000' fontsize='11'> Average Basket Size:  Total Items Sold / Number of orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>ODS</run>
              <run fontcolor='#000000' fontsize='11'>: Orders per Day per Store</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Frequency</run>
              <run fontcolor='#000000' fontsize='11'>: Number of Orders / Number of Unique Customers</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>CVR (Dmart homepage to Transaction)</run>
              <run fontcolor='#000000' fontsize='11'>: Conversion rate i.e total number of sessions with transactions/total number of sessions (For WHs the country&apos;s CVR is shown)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10' italic='true'>*Using Perseus Data since  August 2023</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='14571' id='503' is-scaled='1' param='Image/AQS_V6_Instructions_20241223.png' type-v2='bitmap' w='98400' x='800' y='29000'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
