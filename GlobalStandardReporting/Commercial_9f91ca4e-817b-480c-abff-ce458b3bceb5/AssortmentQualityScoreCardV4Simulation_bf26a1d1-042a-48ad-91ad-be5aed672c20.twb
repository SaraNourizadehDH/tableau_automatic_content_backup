            <column caption='X Axis' datatype='real' name='[Calculation_1185854145493569550]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Score&quot; THEN [Calculation_1185854145418219532]&#13;&#10;    WHEN &quot;ABV&quot; THEN ([gbv])/([total_orders])&#13;&#10;    WHEN &quot;Assortment Design Gap L1 p.p.&quot; THEN [gap_design_score]&#13;&#10;    WHEN &quot;Avg. Listed SKUs&quot; THEN [avg_listed_skus_check]&#13;&#10;    WHEN &quot;Content Score&quot; THEN [content_score]&#13;&#10;    WHEN &quot;CVR&quot; THEN [check_cvr]&#13;&#10;    WHEN &quot;DOH&quot; THEN [check_doh]&#13;&#10;    WHEN &quot;Efficiency %&quot; THEN [check_efficiency]&#13;&#10;    WHEN &quot;Frequency&quot; THEN [Calculation_1185854145204133891]&#13;&#10;    WHEN &quot;Instock %&quot; THEN [check_perc_availability]&#13;&#10;    WHEN &quot;L3 Cat Cover. %&quot; THEN [check_l3_coverage]&#13;&#10;    WHEN &quot;Newness %&quot; THEN [check_newness]&#13;&#10;    WHEN &quot;Spoilage %&quot; THEN [check_perc_spoilage]&#13;&#10;    WHEN &quot;Ultrafresh GPV % contr.&quot; THEN [Calculation_1185854145189216256]&#13;&#10;    WHEN &quot;ABS&quot; THEN ([qty_sold])/([total_orders])&#13;&#10;    WHEN &quot;ODS&quot; THEN [ods]&#13;&#10;    WHEN &quot;Distinct SKUs&quot; THEN [dist_listed_skus]&#13;&#10;    WHEN &quot;MAU Penetration&quot; THEN ([dmart_mau])/([dmart_covered_mau])&#13;&#10;END' />
            </column>
            <column caption='Granularity2' datatype='string' name='[Calculation_1608629514730786818]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[granularity]' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_238972299405660163]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT([Month],4)+&apos;-&apos; +RIGHT([Month],2)' />
            </column>
            <column caption='Month__' datatype='string' datatype-customized='true' name='[Month]' role='dimension' type='nominal' />
            <column caption='Y Axis' datatype='real' name='[X Axis (copy)_1185854145498325007]' role='measure' type='quantitative'>
