    <worksheet name='MoM Scores'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Score</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='assortment_quality_scorecard (dev_dmart)' name='federated.15l6rta1088oux1dx3dar03qh865' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.RefreshableParameterRanges.true...source-field='[federated.15l6rta1088oux1dx3dar03qh865].[date_month]' caption='MonthP' datatype='date' default-format='*YYYY-MM' name='[X Axis (copy)]' param-domain-type='range' role='measure' type='quantitative' value='#2023-06-01#'>
              <calculation class='tableau' formula='#2023-06-01#' />
              <range granularity='1' period-type-v2='month' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15l6rta1088oux1dx3dar03qh865'>
            <column caption='Score' datatype='real' name='[Calculation_1185854145418219532]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[final_score]' />
            </column>
            <column caption='GPV_SelectedMonth' datatype='real' name='[Efficiency % MoM (copy)_1608629514669178880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;,[date_month]) = [Parameters].[X Axis (copy)] &#13;&#10;THEN [gbv] END))' />
            </column>
            <column caption='EOY Target.' datatype='integer' name='[Q Target (copy)_904097690927570946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;,[date_month]) = [Parameters].[X Axis (copy)] &#13;&#10;THEN [aqs_eoy_target] END)&#13;&#10;)' />
            </column>
            <column caption='Q Target' datatype='integer' name='[Score MoM (copy)_2863444977212227584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;,[date_month]) = [Parameters].[X Axis (copy)] &#13;&#10;THEN [aqs_target] END)&#13;&#10;)' />
