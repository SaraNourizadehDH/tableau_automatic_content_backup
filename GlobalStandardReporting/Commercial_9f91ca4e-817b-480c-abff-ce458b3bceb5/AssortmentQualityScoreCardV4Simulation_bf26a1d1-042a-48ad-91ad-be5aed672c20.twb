      <aliases enabled='yes' />
      <column caption='GPV Share' datatype='real' default-format='p0.0%' name='[Avg Listed Share (copy)_1752463268192800785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND((SUM([gpv_eur])/SUM([Fixed Avg Listed SKUs (copy)_1752463268192284688]))*100,1)' />
      </column>
      <column caption='Target Delta' datatype='real' default-format='p0.0%' name='[Avg Listed Share (copy)_1752463268621795358]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &apos;number&apos; THEN ROUND((SUM([Calculation_1752463267876102153])-[Calculation_1752463266827415553]),0)&#13;&#10;WHEN &apos;perc&apos; THEN ([Calculation_1752463266856128516]-SUM([perc_target]))*100&#13;&#10;END' />
      </column>
      <column caption='Avg. Listed SKUs' datatype='real' name='[Calculation_1752463266827415553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_listed_sku])/SUM([Calculation_1752463266849849347])' />
      </column>
      <column caption='Display Month' datatype='string' name='[Calculation_1752463266828206082]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT([Month],4)+&apos;-&apos; +RIGHT([Month],2)' />
      </column>
      <column caption='Fixed Total Denom' datatype='real' name='[Calculation_1752463266849849347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [Month]: AVG([denom_listed_sku])}' />
      </column>
      <column caption='Avg Listed Share' datatype='real' default-format='p0.0%' name='[Calculation_1752463266856128516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1752463266827415553]/SUM([Calculation_1752463267830595589])' />
      </column>
      <column caption='Fixed Avg Listed SKUs' datatype='real' name='[Calculation_1752463267830595589]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id],[date_month]:&#13;&#10;SUM([total_listed_sku])/SUM([Calculation_1752463266849849347])}' />
      </column>
      <column caption='Progress Tracker' datatype='string' hidden='true' name='[Calculation_1752463267835252742]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &apos;number&apos; THEN STR(ROUND([Calculation_1752463266827415553],0))&#13;&#10;WHEN &apos;perc&apos; THEN STR(ROUND([Calculation_1752463266856128516]*100,1))+&quot;%&quot;&#13;&#10;END' />
      </column>
      <column caption='Measure Selected Sufix' datatype='string' hidden='true' name='[Calculation_1752463267838939143]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &apos;number&apos; THEN &quot;&quot;&#13;&#10;WHEN &apos;perc&apos; THEN &quot;%&quot;&#13;&#10;END' />
      </column>
      <column caption='Listed Target' datatype='real' name='[Calculation_1752463267876102153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[perc_target]*[listed_country_target]' />
      </column>
      <column caption='Progress Tracker Target' datatype='string' name='[Calculation_1752463267883773962]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &apos;number&apos; THEN STR(ROUND(SUM([Calculation_1752463267876102153]),0))&#13;&#10;WHEN &apos;perc&apos; THEN STR(ROUND(SUM([perc_target])*100,1))+&quot;%&quot;&#13;&#10;END' />
      </column>
      <column caption='Cat 0' datatype='string' name='[Calculation_1752463267928965132]' role='dimension' type='nominal'>
