      <column caption='Last Month Target' datatype='real' hidden='true' name='[Calculation_1752463268553912344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_1752463268605952025] = TRUE&#13;&#10;THEN [perc_target] END)' />
