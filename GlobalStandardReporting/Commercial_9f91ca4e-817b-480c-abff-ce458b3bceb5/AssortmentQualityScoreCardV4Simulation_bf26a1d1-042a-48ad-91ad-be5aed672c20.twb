      <repository-location id='ScoreEvolution' path='/t/GlobalStandardReporting/workbooks/AssortmentQualityScoreCard_V4_Simulation' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1350' maxwidth='1900' minheight='1350' minwidth='1900' sizing-mode='fixed' />
