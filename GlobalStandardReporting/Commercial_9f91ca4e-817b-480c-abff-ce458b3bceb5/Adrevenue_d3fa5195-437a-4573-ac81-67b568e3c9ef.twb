      <aliases enabled='yes' />
      <column caption='Product Ad revenue % of NMR ' datatype='real' name='[Ad revenue % of NMR (copy)_33565906183184389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_33565906174267392])/SUM([nmr_revenue_eur])' />
      </column>
      <column caption='Monetization Revenue' datatype='real' name='[Banner Revenue (copy)_33565906176139266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [asset_type] = &quot;DIP&quot; THEN [ad_revenue_eur] ELSE 0 END' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_33565906179387396]) / TOTAL(SUM([Calculation_33565906179387396]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Product Ads Revenue' datatype='real' name='[Calculation_33565906174267392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [asset_type] = &quot;Product Ads&quot; THEN [ad_revenue_eur] ELSE 0 END' />
      </column>
      <column caption='Ad revenue % of NMR' datatype='real' name='[Calculation_33565906179387396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[ad_revenue_eur]/[nmr_revenue_eur]' />
      </column>
      <column caption='CPC Ad revenue' datatype='real' name='[Calculation_33565906211741704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IF  CONTAINS([asset], &quot;CPC&quot;) THEN [ad_revenue_eur] else null end)' />
      </column>
      <column caption='CPC % of NMR' datatype='real' name='[Calculation_33565906228117513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_33565906211741704])/SUM([nmr_revenue_eur])' />
      </column>
      <column caption='Retail revenue % of NMR ' datatype='real' name='[Product Ad revenue % of NMR  (copy)_33565906183888902]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[retail_revenue_eur]/[nmr_revenue_eur]' />
      </column>
      <column caption='Banner Revenue' datatype='real' name='[Product Ads Revenue (copy)_33565906175733761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [asset_type] = &quot;Banner&quot; THEN [ad_revenue_eur] ELSE 0 END' />
      </column>
