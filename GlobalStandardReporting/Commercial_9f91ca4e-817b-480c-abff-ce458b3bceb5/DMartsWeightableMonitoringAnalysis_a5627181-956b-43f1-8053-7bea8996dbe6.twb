    <worksheet name='GPV'>
      <table>
        <view>
          <datasources>
            <datasource caption='weightable_tableau_abv_analysis' name='federated.0bsv20j0tyeh4f10rkih21pux4iu' />
          </datasources>
          <datasource-dependencies datasource='federated.0bsv20j0tyeh4f10rkih21pux4iu'>
            <column caption='GPV Penetration' datatype='real' name='[Calculation_1895945127157555201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([w_items_GPV])/SUM([total_GPV])' />
            </column>
            <column caption='Global' datatype='string' name='[Calculation_363947197164003340]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [management_entity] &lt;&gt; &apos;&apos; THEN &apos;Global&apos; END' />
            </column>
            <column caption='Weightable GPV % from Total' datatype='real' name='[Calculation_5122703897003552768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([w_order_GPV])/SUM([total_GPV])' />
            </column>
            <column caption='Weightable GPV% from UF' datatype='real' name='[Calculation_5122703897003778049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([w_order_GPV])/SUM([uf_f_order_GPV])' />
            </column>
            <column caption='% Weightable Orders from Total' datatype='real' name='[Calculation_5122703897004961796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([w_orders])/SUM([total_orders])' />
            </column>
            <column caption='% Weightable Orders from UF/F' datatype='real' name='[Calculation_5122703897005072389]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([w_orders])/SUM([uf_f_orders])' />
            </column>
            <column caption='Total ABS' datatype='real' name='[Calculation_5122703897006260230]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_items])/SUM([total_orders])' />
            </column>
            <column caption='UF/F ABS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5122703897006444551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([uf_f_all_order_items])/SUM([uf_f_orders])' />
            </column>
            <column caption='Weightables ABS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5122703897006882824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([w_all_order_items])/SUM([w_orders])' />
            </column>
            <column caption='AVG # of UF/F Items in Basket' datatype='real' name='[Calculation_5122703897007411209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([uf_f_items])/SUM([uf_f_orders])' />
            </column>
            <column caption='AVG # of Weightables Items in Basket' datatype='real' name='[Calculation_5122703897007546378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([w_items])/SUM([w_orders])' />
            </column>
            <column caption='Total ABV' datatype='real' name='[Calculation_5122703897009041419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_GPV])/sum([total_orders])' />
            </column>
            <column caption='UF/F ABV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5122703897009197068]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([uf_f_order_GPV])/sum([uf_f_orders])' />
            </column>
            <column caption='Weightables ABV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5122703897009455117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([w_order_GPV])/SUM([w_orders])' />
            </column>
