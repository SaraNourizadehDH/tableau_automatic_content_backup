    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='General Performance'>
      <repository-location id='GeneralPerformance' path='/t/GlobalStandardReporting/workbooks/DMartsWeightableMonitoringAnalysis' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_37' value='center' />
        </style-rule>
      </style>
      <size maxheight='2000' maxwidth='1380' minheight='2000' minwidth='1380' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='jmg_weightable_sku_detail (rl_dmart)' name='federated.006gfpq0k45jrf172ecos19psrlb' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Select Aggregation' datatype='string' name='[Global Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
          <calculation class='tableau' formula='&quot;Country&quot;' />
          <members>
            <member value='&quot;Global&quot;' />
            <member value='&quot;Management Entity&quot;' />
            <member value='&quot;Country&quot;' />
            <member value='&quot;Warehouse&quot;' />
          </members>
        </column>
        <column caption='Performance Metrics' datatype='string' name='[Select Metrics (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;GPV&quot;'>
          <calculation class='tableau' formula='&quot;GPV&quot;' />
          <members>
            <member value='&quot;GPV&quot;' />
            <member value='&quot;Qty Sold&quot;' />
            <member value='&quot;GPV Gain&quot;' />
            <member value='&quot;GPV Lost&quot;' />
            <member value='&quot;Percentage GPV Gain Net&quot;' />
            <member value='&quot;Distinct Warehouses&quot;' />
            <member value='&quot;Distinct Listed SKUs&quot;' />
            <member value='&quot;Avg Listed SKUs per WH&quot;' />
            <member value='&quot;Shrinkage \%&quot;' />
            <member value='&quot;Weighted Availability&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.006gfpq0k45jrf172ecos19psrlb'>
        <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
