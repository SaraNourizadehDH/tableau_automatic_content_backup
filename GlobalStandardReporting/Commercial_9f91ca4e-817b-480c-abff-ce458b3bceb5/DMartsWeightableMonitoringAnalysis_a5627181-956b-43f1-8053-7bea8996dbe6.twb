                  <formatted-text>
                    <run>Æ&#10;</run>
                    <run fontcolor='#b7090e' fontname='Tableau Bold' fontsize='14'>GPV</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#1b1b1b' fontname='Tableau Regular' fontsize='11'>Total GPV of Chains (that rolled out Weightables) :  </run>
                    <run fontname='Tableau Regular' fontsize='11'>Total Price paid by customer for an order [including VAT]</run>
