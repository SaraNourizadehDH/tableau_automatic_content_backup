    <worksheet name='Performance Table'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000'>Monthly KPIs by Global/Mgmt Entity/Country/WH</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='jmg_weightable_sku_detail (rl_dmart)' name='federated.006gfpq0k45jrf172ecos19psrlb' />
          </datasources>
          <datasource-dependencies datasource='federated.006gfpq0k45jrf172ecos19psrlb'>
            <column caption='Distinct Warehouses' datatype='integer' name='[Calculation_363947196498817024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([warehouse_id])' />
            </column>
            <column caption='Avg Listed SKUs per WH' datatype='real' name='[Calculation_363947196499587073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// This calculation first finds the distinct count of SKUs for each individual warehouse,&#10;// and then calculates the average of those counts.&#10;&#10;// Level of Detail (LOD) expressions are necessary because we need to control the&#10;// level at which the distinct count is performed before the final average is computed.&#10;&#10;AVG(&#10;  // Part 1: FIXED LOD - Calculate Distinct SKUs for each Warehouse&#10;  // For each [warehouse_id], this inner part calculates the number of distinct SKUs&#10;  // that meet the condition [Listed Sku] = 1.&#10;  // The result is a list of numbers (e.g., [150, 200, 125, ...]), one for each warehouse.&#10;  { FIXED [warehouse_id] : COUNTD(&#10;      IF [listed_sku] = 1 THEN [sku] END&#10;    )&#10;  }&#10;)&#10;&#10;// Part 2: AVG() - Average the Per-Warehouse Results&#10;// The outer AVG() function then takes the list of per-warehouse counts&#10;// generated by the LOD and computes their average.' />
            </column>
            <column caption='Distinct Listed SKUs' datatype='integer' name='[Calculation_363947196503576578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    IF [listed_sku] = 1 THEN [sku] END&#10;)' />
            </column>
            <column caption='Shrinkage %' datatype='real' name='[Calculation_363947196520697861]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([spoilage_num]) / SUM([spoilage_denom])' />
            </column>
            <column caption='Weighted Availability' datatype='real' name='[Calculation_363947196521254918]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([numerator_new_avail])/ SUM([denom_new_avail])' />
            </column>
            <column caption='Percentage GPV Gain Net' datatype='real' name='[Calculation_363947196874264583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([w_above_gpv]) + SUM([w_below_gpv]))/SUM([total_price_paid_eur])' />
            </column>
            <column caption='Global' datatype='string' name='[Calculation_363947197149138954]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [management_entity] &lt;&gt; &apos;&apos; THEN &apos;Global&apos; END' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Percentage GPV Gain' datatype='real' name='[Percentage GPV Gain Net (copy)_363947197577601037]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([w_above_gpv]))/(SUM([total_price_paid_eur])-SUM([w_above_gpv]))' />
            </column>
            <column datatype='boolean' name='[aqs_wh]' role='dimension' type='nominal' />
            <column caption='Date Month' datatype='date' name='[date_month]' role='dimension' type='ordinal' />
            <column caption='Denom New Avail' datatype='real' name='[denom_new_avail]' role='measure' type='quantitative' />
            <column caption='Level Cero' datatype='string' name='[level_cero]' role='dimension' type='nominal' />
            <column caption='Level One' datatype='string' name='[level_one]' role='dimension' type='nominal' />
