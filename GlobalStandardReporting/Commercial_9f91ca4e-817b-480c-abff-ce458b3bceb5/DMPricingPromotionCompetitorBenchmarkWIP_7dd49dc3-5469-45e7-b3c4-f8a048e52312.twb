      <aliases enabled='yes' />
      <column caption='Max Base Price Index' datatype='real' name='[Calculation_212232149546651649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([max_bp_index_weight]) / SUM([gpv_eur])) * 100' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_2492672057610440704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Sheet Swapper' datatype='boolean' name='[Calculation_305681854481285120]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] IN (&apos;Median Base Price Index&apos;, &apos;Median Paid Price Index&apos;)' />
      </column>
      <column caption='Index Comparison' datatype='real' name='[Calculation_305681854494990337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Median Base Price Index&apos;   THEN [Calculation_767582278858473473] &#13;&#10;WHEN &apos;Median Paid Price Index&apos;   THEN [Calculation_767582278859550724]&#13;&#10;END' />
      </column>
      <column caption='Min Base Price Index' datatype='real' name='[Calculation_767582278858133504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([min_bp_index_weight]) / SUM([gpv_eur])) *100' />
      </column>
      <column caption='Median Base Price Index' datatype='real' name='[Calculation_767582278858473473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([median_bp_index_weight]) / SUM([gpv_eur]))*100' />
      </column>
      <column caption='Max Paid Price Index' datatype='real' name='[Calculation_767582278858731522]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([max_dp_index_weight]) / SUM([gpv_eur])) *100' />
      </column>
      <column caption='Min Paid Price Index' datatype='real' name='[Calculation_767582278859255811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([min_dp_index_weight]) / SUM([gpv_eur])) *100' />
