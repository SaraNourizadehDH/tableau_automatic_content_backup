      <column caption='Comp Price Index (copy)' datatype='real' name='[Comp Price Index (copy)_912823418131226627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_323696250560692230] * [sku_gpv_eur])/SUM([sku_gpv_eur])) *100' />
