  <worksheets>
    <worksheet name='Blended Price Index - Country'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#555555' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='competitor_benchmark_indices (rl_dmart)' name='federated.1u9mbm70eyi6nw11zeckh09jiw22' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Final Benchmark' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Median paid&quot;'>
              <calculation class='tableau' formula='&quot;Median paid&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1u9mbm70eyi6nw11zeckh09jiw22'>
            <column caption='Blended Price Index (Sku)' datatype='real' name='[Calculation_323696250557853698]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#13;&#10;WHEN &apos;Min base&apos;      THEN {FIXED [stamp_week], [country_name], [dmart_sku] : MAX([median_bp_index])}&#13;&#10;WHEN &apos;Median base&apos;   THEN {FIXED [stamp_week], [country_name], [dmart_sku] : AVG([median_bp_index])}&#13;&#10;WHEN &apos;Max base&apos;      THEN {FIXED [stamp_week], [country_name], [dmart_sku] : MIN([median_bp_index])}&#13;&#10;&#13;&#10;WHEN &apos;Min paid&apos;      THEN {FIXED [stamp_week], [country_name], [dmart_sku] : MAX([median_dp_index])}&#13;&#10;WHEN &apos;Median paid&apos;   THEN {FIXED [stamp_week], [country_name], [dmart_sku] : AVG([median_dp_index])}&#13;&#10;WHEN &apos;Max paid&apos;      THEN {FIXED [stamp_week], [country_name], [dmart_sku] : MIN([median_dp_index])}&#13;&#10;END' />
            </column>
            <column caption='Blended Price Index (Country)' datatype='real' name='[Calculation_323696250561662983]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [stamp_week], [country_name]:(SUM([Calculation_323696250557853698] * [sku_gpv_eur])/SUM([sku_gpv_eur])) * 100}' />
            </column>
            <column caption='Competitor Id' datatype='string' name='[competitor_id]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Dmart Sku' datatype='string' name='[dmart_sku]' role='dimension' type='nominal' />
            <column caption='L2 Master Category' datatype='string' name='[l2_master_category]' role='dimension' type='nominal' />
            <column-instance column='[stamp_week]' derivation='MDY' name='[md:stamp_week:ok]' pivot='key' type='ordinal' />
            <column caption='Median Bp Index' datatype='real' name='[median_bp_index]' role='measure' type='quantitative' />
            <column caption='Median Dp Index' datatype='real' name='[median_dp_index]' role='measure' type='quantitative' />
            <column-instance column='[competitor_id]' derivation='None' name='[none:competitor_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[l2_master_category]' derivation='None' name='[none:l2_master_category:nk]' pivot='key' type='nominal' />
            <column caption='Sku Gpv Eur' datatype='real' name='[sku_gpv_eur]' role='measure' type='quantitative' />
            <column caption='Stamp Week' datatype='date' name='[stamp_week]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_323696250561662983]' derivation='Sum' name='[sum:Calculation_323696250561662983:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1u9mbm70eyi6nw11zeckh09jiw22].[md:stamp_week:ok]' filter-group='3'>
            <groupfilter function='member' level='[md:stamp_week:ok]' member='20250331' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1u9mbm70eyi6nw11zeckh09jiw22].[none:competitor_id:nk]' context='true' filter-group='9'>
            <groupfilter function='level-members' level='[none:competitor_id:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1u9mbm70eyi6nw11zeckh09jiw22].[none:country_name:nk]' context='true' filter-group='4'>
            <groupfilter function='member' level='[none:country_name:nk]' member='&quot;Singapore&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1u9mbm70eyi6nw11zeckh09jiw22].[none:l2_master_category:nk]' filter-group='36'>
            <groupfilter function='level-members' level='[none:l2_master_category:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.1u9mbm70eyi6nw11zeckh09jiw22].[none:competitor_id:nk]</column>
            <column>[federated.1u9mbm70eyi6nw11zeckh09jiw22].[none:country_name:nk]</column>
