      <column caption='Fixed Country GPV Coverage' datatype='real' name='[Fixed Country matched GPV (copy)_6967772358164475908]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Fixed Country GPV (copy)_6967772358164086786] / [Calculation_6967772358162608129]' />
