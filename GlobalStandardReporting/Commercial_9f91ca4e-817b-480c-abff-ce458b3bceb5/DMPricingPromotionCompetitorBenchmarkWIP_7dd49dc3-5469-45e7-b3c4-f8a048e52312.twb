    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <aliases enabled='yes' />
      <column alias='Base Price Index' caption='Index Comparison' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Median Base Price Index&quot;'>
        <calculation class='tableau' formula='&quot;Median Base Price Index&quot;' />
        <aliases>
          <alias key='&quot;Median Base Price Index&quot;' value='Base Price Index' />
          <alias key='&quot;Median Paid Price Index&quot;' value='Paid Price Index' />
        </aliases>
        <members>
          <member alias='Base Price Index' value='&quot;Median Base Price Index&quot;' />
          <member alias='Paid Price Index' value='&quot;Median Paid Price Index&quot;' />
          <member value='&quot;Both Indices&quot;' />
        </members>
      </column>
      <column alias='Paid Price Index' caption='Price Comparison' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Median Paid Price Index&quot;'>
        <calculation class='tableau' formula='&quot;Median Paid Price Index&quot;' />
        <aliases>
          <alias key='&quot;Median Base Price Index&quot;' value='Base Price Index' />
          <alias key='&quot;Median Paid Price Index&quot;' value='Paid Price Index' />
        </aliases>
        <members>
          <member alias='Base Price Index' value='&quot;Median Base Price Index&quot;' />
          <member alias='Paid Price Index' value='&quot;Median Paid Price Index&quot;' />
        </members>
      </column>
      <column caption='Final Benchmark' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Median paid&quot;'>
        <calculation class='tableau' formula='&quot;Median paid&quot;' />
        <members>
          <member value='&quot;Min base&quot;' />
          <member value='&quot;Median base&quot;' />
          <member value='&quot;Max base&quot;' />
          <member value='&quot;Min paid&quot;' />
          <member value='&quot;Median paid&quot;' />
          <member value='&quot;Max paid&quot;' />
        </members>
      </column>
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[Parameter 1]' type='palette'>
            <map to='#49525e'>
              <bucket>&quot;Median Paid Price Index&quot;</bucket>
            </map>
            <map to='#ae123a'>
              <bucket>&quot;Median Base Price Index&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
