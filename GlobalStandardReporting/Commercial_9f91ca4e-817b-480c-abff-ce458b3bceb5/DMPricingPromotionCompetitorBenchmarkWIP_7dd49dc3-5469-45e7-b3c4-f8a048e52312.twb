      <column caption='Blended Price Index (Item Roles)' datatype='real' name='[Calculation_323696250557235200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [stamp_week], [country_name], [item_role]:(SUM([Calculation_323696250557853698] * [sku_gpv_eur])/SUM([sku_gpv_eur])) * 100}' />
      </column>
      <column caption='Blended Price Index (Sku)' datatype='real' name='[Calculation_323696250557853698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#13;&#10;WHEN &apos;Min base&apos;      THEN {FIXED [stamp_week], [country_name], [dmart_sku] : MAX([median_bp_index])}&#13;&#10;WHEN &apos;Median base&apos;   THEN {FIXED [stamp_week], [country_name], [dmart_sku] : AVG([median_bp_index])}&#13;&#10;WHEN &apos;Max base&apos;      THEN {FIXED [stamp_week], [country_name], [dmart_sku] : MIN([median_bp_index])}&#13;&#10;&#13;&#10;WHEN &apos;Min paid&apos;      THEN {FIXED [stamp_week], [country_name], [dmart_sku] : MAX([median_dp_index])}&#13;&#10;WHEN &apos;Median paid&apos;   THEN {FIXED [stamp_week], [country_name], [dmart_sku] : AVG([median_dp_index])}&#13;&#10;WHEN &apos;Max paid&apos;      THEN {FIXED [stamp_week], [country_name], [dmart_sku] : MIN([median_dp_index])}&#13;&#10;END' />
      </column>
      <column caption='Final Benchmark' datatype='real' name='[Calculation_323696250558398467]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#13;&#10;WHEN &apos;Min base&apos;      THEN {FIXED [stamp_week], [country_name], [dmart_sku] : MIN([median_comp_price_local])}&#13;&#10;WHEN &apos;Median base&apos;   THEN {FIXED [stamp_week], [country_name], [dmart_sku] : AVG([median_comp_price_local])}&#13;&#10;WHEN &apos;Max base&apos;      THEN {FIXED [stamp_week], [country_name], [dmart_sku] : MAX([median_comp_price_local])}&#13;&#10;&#13;&#10;WHEN &apos;Min paid&apos;      THEN {FIXED [stamp_week], [country_name], [dmart_sku] : MIN([median_comp_discounted_price_local])}&#13;&#10;WHEN &apos;Median paid&apos;   THEN {FIXED [stamp_week], [country_name], [dmart_sku] : AVG([median_comp_discounted_price_local])}&#13;&#10;WHEN &apos;Max paid&apos;      THEN {FIXED [stamp_week], [country_name], [dmart_sku] : MAX([median_comp_discounted_price_local])}&#13;&#10;END' />
      </column>
      <column caption='Blended Paid Price Index (Sku)' datatype='real' name='[Calculation_323696250558955524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[dh_discounted_price_local]/[Calculation_323696250558398467]' />
      </column>
      <column caption='Comp Price Index' datatype='real' name='[Calculation_323696250560499717]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_323696250560692230] * [sku_gpv_eur])/SUM([sku_gpv_eur])) *100' />
      </column>
      <column caption='Sku Price Index' datatype='real' name='[Calculation_323696250560692230]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#13;&#10;WHEN &apos;Min base&apos;      THEN [median_bp_index]&#13;&#10;WHEN &apos;Median base&apos;   THEN [median_bp_index]&#13;&#10;WHEN &apos;Max base&apos;      THEN [median_bp_index]&#13;&#10;&#13;&#10;WHEN &apos;Min paid&apos;      THEN [median_dp_index]&#13;&#10;WHEN &apos;Median paid&apos;   THEN [median_dp_index]&#13;&#10;WHEN &apos;Max paid&apos;      THEN [median_dp_index]&#13;&#10;END' />
      </column>
      <column caption='Blended Price Index (Country)' datatype='real' name='[Calculation_323696250561662983]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [stamp_week], [country_name]:(SUM([Calculation_323696250557853698] * [sku_gpv_eur])/SUM([sku_gpv_eur])) * 100}' />
