                <formatted-text>
                  <run bold='true' fontcolor='#cf001b' fontsize='32'>Competitor Benchmark Dashboard</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#555555' fontsize='12'>QUICK - COMMERCE</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff0000' fontsize='13'>D-Marts</run>
                  <run>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
            <zone h='63000' id='37' param='horz' type-v2='layout-flow' w='98666' x='667' y='14000'>
              <zone h='63000' id='39' param='vert' type-v2='layout-flow' w='45916' x='667' y='14000'>
                <zone h='12333' id='40' is-scaled='1' param='Image/value (2).jpg' type-v2='bitmap' w='45916' x='667' y='14000'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
