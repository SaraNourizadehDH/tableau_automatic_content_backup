      <column caption='Blended Price Index (Country) (copy)' datatype='real' name='[Blended Price Index (Country) (copy)_912823418138357765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#13;&#10;WHEN &apos;Min base&apos;      THEN {FIXED [stamp_week], [country_name]:(SUM([Calculation_323696250557853698] * [sku_gpv_eur])/SUM([sku_gpv_eur])) * 100}&#13;&#10;WHEN &apos;Median base&apos;   THEN {FIXED [stamp_week], [country_name]:(SUM([Calculation_323696250557853698] * [sku_gpv_eur])/SUM([sku_gpv_eur])) * 100}&#13;&#10;WHEN &apos;Max base&apos;      THEN {FIXED [stamp_week], [country_name]:(SUM([Calculation_323696250557853698] * [sku_gpv_eur])/SUM([sku_gpv_eur])) * 100}&#13;&#10;&#13;&#10;WHEN &apos;Min paid&apos;      THEN {FIXED [stamp_week], [country_name]:(SUM([Calculation_323696250557853698] * [sku_gpv_eur])/SUM([sku_gpv_eur])) * 100}&#13;&#10;WHEN &apos;Median paid&apos;   THEN {FIXED [stamp_week], [country_name]:(SUM([Calculation_323696250557853698] * [sku_gpv_eur])/SUM([sku_gpv_eur])) * 100}&#13;&#10;WHEN &apos;Max paid&apos;      THEN {FIXED [stamp_week], [country_name]:(SUM([Calculation_323696250557853698] * [sku_gpv_eur])/SUM([sku_gpv_eur])) * 100}&#13;&#10;END' />
      </column>
      <column caption='Blended Price Index (Item Roles) (copy)' datatype='real' name='[Blended Price Index (Item Roles) (copy)_912823418130862082]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#13;&#10;WHEN &apos;Min base&apos;      THEN {FIXED [stamp_week], [country_name], [item_role]:(SUM([Calculation_323696250557853698] * [sku_gpv_eur])/SUM([sku_gpv_eur])) * 100}&#13;&#10;WHEN &apos;Median base&apos;   THEN {FIXED [stamp_week], [country_name], [item_role]:(SUM([Calculation_323696250557853698] * [sku_gpv_eur])/SUM([sku_gpv_eur])) * 100}&#13;&#10;WHEN &apos;Max base&apos;      THEN {FIXED [stamp_week], [country_name], [item_role]:(SUM([Calculation_323696250557853698] * [sku_gpv_eur])/SUM([sku_gpv_eur])) * 100}&#13;&#10;&#13;&#10;WHEN &apos;Min paid&apos;      THEN {FIXED [stamp_week], [country_name], [item_role]:(SUM([Calculation_323696250558955524] * [sku_gpv_eur])/SUM([sku_gpv_eur])) * 100}&#13;&#10;WHEN &apos;Median paid&apos;   THEN {FIXED [stamp_week], [country_name], [item_role]:(SUM([Calculation_323696250558955524] * [sku_gpv_eur])/SUM([sku_gpv_eur])) * 100}&#13;&#10;WHEN &apos;Max paid&apos;      THEN {FIXED [stamp_week], [country_name], [item_role]:(SUM([Calculation_323696250558955524] * [sku_gpv_eur])/SUM([sku_gpv_eur])) * 100}&#13;&#10;END' />
