      <column caption='Sku Price Index (copy)' datatype='real' name='[Sku Price Index (copy)_912823418131468292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#13;&#10;WHEN &apos;Min base&apos;      THEN [dh_price_local]/[median_comp_price_local]&#13;&#10;WHEN &apos;Median base&apos;   THEN [dh_price_local]/[median_comp_price_local]&#13;&#10;WHEN &apos;Max base&apos;      THEN [dh_price_local]/[median_comp_price_local]&#13;&#10;&#13;&#10;WHEN &apos;Min paid&apos;      THEN [dh_discounted_price_local]/[median_comp_discounted_price_local]&#13;&#10;WHEN &apos;Median paid&apos;   THEN [dh_discounted_price_local]/[median_comp_discounted_price_local]&#13;&#10;WHEN &apos;Max paid&apos;      THEN [dh_discounted_price_local]/[median_comp_discounted_price_local]&#13;&#10;END' />
      </column>
