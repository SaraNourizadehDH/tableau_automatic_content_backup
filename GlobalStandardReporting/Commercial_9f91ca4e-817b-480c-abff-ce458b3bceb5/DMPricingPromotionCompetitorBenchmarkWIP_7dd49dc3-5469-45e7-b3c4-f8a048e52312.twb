      <column caption='Fixed Country matched GPV from Promo' datatype='real' name='[Fixed Country matched GPV (copy)_6967772358165356550]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [country_name], [stamp_month] : MAX([matched_GPV_from_promo_eur])})' />
