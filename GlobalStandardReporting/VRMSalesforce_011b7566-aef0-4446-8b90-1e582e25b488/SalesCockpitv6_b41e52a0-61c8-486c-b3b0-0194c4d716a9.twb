      <aliases enabled='yes' />
      <column caption='Period' datatype='datetime' name='[Calculation_1868079096125493248]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&quot;Day&quot; THEN [Calculation_1868079096125722625]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Week&quot; THEN [Calculation_1868079096125771778]&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Month&quot; THEN [Calculation_1868079096125820931]&#10;END' />
      </column>
      <column caption='Day' datatype='datetime' name='[Calculation_1868079096125722625]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;,[iso_date])' />
      </column>
      <column caption='Week' datatype='datetime' name='[Calculation_1868079096125771778]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;,[iso_date])' />
      </column>
      <column caption='Month' datatype='datetime' name='[Calculation_1868079096125820931]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[iso_date])' />
      </column>
      <column caption='%Logins per Active Users' datatype='real' name='[Calculation_1868079096130236421]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_users_with_logins])/SUM([active_users_with_permission_set])' />
      </column>
      <column caption='Avg time per Session' datatype='real' name='[Calculation_1868079096130736134]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([duration])/SUM([sessions])' />
      </column>
      <column caption='% Users with Access Vs Total Users' datatype='real' name='[Calculation_1868079096131002375]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_users_with_permission_set])/SUM([active_users])' />
      </column>
      <column caption='% Users who Logged in Vs Total Active users' datatype='real' name='[Calculation_1868079096131383304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='Avg time spent on Sales Cockpit' datatype='real' name='[Calculation_1868079096133050377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([duration])/SUM([active_users_with_permission_set])' />
      </column>
      <column caption='% Users with Targets configured Vs Users Configured' datatype='real' name='[Calculation_1868079096134950922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_users_with_target_set])/SUM([active_users_with_permission_set])' />
      </column>
