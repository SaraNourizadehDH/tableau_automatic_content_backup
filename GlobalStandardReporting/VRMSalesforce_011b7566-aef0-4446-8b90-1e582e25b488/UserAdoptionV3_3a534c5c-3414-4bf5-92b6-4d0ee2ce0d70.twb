    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Activities New'>
      <style />
      <size maxheight='3000' maxwidth='1200' minheight='3000' minwidth='1200' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='operations' name='federated.16w8id70zhlc0l1bijzzt061vm5w' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Granularity' datatype='string' name='[Dimension 2 Parameter (copy)_797981570453860352]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
          <calculation class='tableau' formula='&quot;Region&quot;' />
          <members>
            <member value='&quot;Global&quot;' />
            <member value='&quot;Region&quot;' />
            <member value='&quot;Country&quot;' />
            <member value='&quot;Entity&quot;' />
          </members>
        </column>
        <column caption='Time Period Parameter UI' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
          <calculation class='tableau' formula='&quot;Month&quot;' />
          <members>
            <member value='&quot;Day&quot;' />
            <member value='&quot;Week&quot;' />
            <member value='&quot;Month&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.16w8id70zhlc0l1bijzzt061vm5w'>
        <column caption='Period' datatype='datetime' default-format='*Mmm dd yyyy' name='[Calculation_1480065803531341832]' role='dimension' type='quantitative'>
          <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Day&quot; THEN [Week (copy)_1480065803526778886]&#10;ELSEIF [Parameters].[Parameter 2]=&quot;Week&quot; THEN [Month (copy)_1480065803526660101]&#10;ELSEIF [Parameters].[Parameter 2]=&quot;Month&quot; THEN [Calculation_1480065803526557700]&#10;END' />
        </column>
        <column caption='operating system' datatype='string' name='[Calculation_252131220415197184]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='[os_name]+&quot; &quot;+[os_version]' />
        </column>
        <column caption='Granularity Calculation' datatype='string' name='[Dimension Calculation (copy)_1480065803534876681]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [Parameters].[Dimension 2 Parameter (copy)_797981570453860352]= &quot;Global&quot; THEN &quot;Global&quot;&#10;ELSEIF [Parameters].[Dimension 2 Parameter (copy)_797981570453860352] = &quot;Region&quot; THEN [region]&#10;ELSEIF [Parameters].[Dimension 2 Parameter (copy)_797981570453860352]= &quot;Country&quot; THEN [country]&#10;ELSEIF [Parameters].[Dimension 2 Parameter (copy)_797981570453860352] = &quot;Entity&quot; THEN [entity]&#10;END' />
        </column>
        <column caption='% Leads Created on Mobile' datatype='real' default-format='p0.0%' name='[LeadCreation PCT (copy)_1756544617217781765]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='[LeadCreation QTY (copy)_1756544617217036289]/(([LeadCreation QTY Mobile (copy)_1756544617220300808])+([LeadCreation QTY (copy)_1756544617217036289]))' />
        </column>
        <column caption='Leads Created on Mobile' datatype='integer' default-format='p0.0%' name='[LeadCreation QTY (copy)_1756544617217036289]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='COUNTD(IF ([lead_created_from] = &quot;New Form Manual-Mobile&quot; OR [lead_created_from] = &quot;New Form Enriched-Mobile&quot;) then [record_id] END)' />
        </column>
        <column caption='Account Type' datatype='string' name='[account_type]' role='dimension' type='nominal' />
        <column caption='Key Account Sub Category' datatype='string' name='[key_account_sub_category]' role='dimension' type='nominal' />
        <column-instance column='[Calculation_1480065803531341832]' derivation='None' name='[none:Calculation_1480065803531341832:ok]' pivot='key' type='ordinal' />
        <column-instance column='[Calculation_252131220415197184]' derivation='None' name='[none:Calculation_252131220415197184:nk]' pivot='key' type='nominal' />
