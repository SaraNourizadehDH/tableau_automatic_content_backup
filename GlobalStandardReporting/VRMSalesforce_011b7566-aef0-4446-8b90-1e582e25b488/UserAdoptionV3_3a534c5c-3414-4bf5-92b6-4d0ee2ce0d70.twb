              <calculation class='tableau' formula='[LeadCreation QTY (copy)_1756544617217036289]/(([LeadCreation QTY Mobile (copy)_1756544617220300808])+([LeadCreation QTY (copy)_1756544617217036289]))' />
            </column>
            <column caption='% Leads Enriched on Mobile' datatype='real' default-format='p0.0%' name='[LeadCreation PCT Mobile (copy)_1756544617225973779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([LeadCreation QTY Mobile (copy)_1756544617226002453])/([LeadCreation QTY (copy)_1756544617217036289])' />
