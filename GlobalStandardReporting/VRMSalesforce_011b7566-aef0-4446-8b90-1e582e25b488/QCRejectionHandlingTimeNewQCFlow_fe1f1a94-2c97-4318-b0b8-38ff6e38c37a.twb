      </column>
      <column caption='(Quarter) - Truncated' datatype='date' name='[Calculation_1263259719050330126]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;quarter&apos;, [Calculation_1263259719049043977]))' />
      </column>
      <column caption='Date (KYB creation)' datatype='date' name='[Calculation_1263259719050547215]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='//IF &#13;&#10;//[Date Granularity] = &apos;Daily&apos; then [Created Date (Days) - Truncated]&#13;&#10;//ELSEIF &#13;&#10;//[Date Granularity] = &apos;Weekly&apos; then [Created Date (Weekd numbers) - Truncated] &#13;&#10;//ELSE&#10;IF &#13;&#10;[Parameters].[Group Email Parameter] = &apos;Monthly&apos; then [Calculation_1263259719049490443]&#13;&#10;ELSEIF &#13;&#10;[Parameters].[Group Email Parameter] = &apos;Quarterly&apos; then [Calculation_1263259719050330126]&#13;&#10;END' />
      </column>
      <column caption='FIRST QC Rejected' datatype='integer' name='[Calculation_160229668771991552]' role='measure' type='quantitative'>
