      <table>
        <view>
          <datasources>
            <datasource caption='digitizing_vendor_support ' name='federated.0riyffl13vrt5w19ux84r06ii5c7' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Group Email Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0riyffl13vrt5w19ux84r06ii5c7'>
            <column caption='Date - Truncated' datatype='date' name='[Calculation_1263259719049043977]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([tim_day])' />
            </column>
            <column caption='(Days) - Truncated' datatype='date' name='[Calculation_1263259719049236490]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;day&apos;, [Calculation_1263259719049043977]))' />
            </column>
            <column caption='(Months) - Truncated' datatype='date' name='[Calculation_1263259719049490443]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='date(DATETRUNC(&apos;month&apos;, [Calculation_1263259719049043977]))' />
            </column>
            <column caption='Date (Weekd numbers) - Truncated' datatype='date' name='[Calculation_1263259719049670668]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [Calculation_1263259719049043977]))' />
