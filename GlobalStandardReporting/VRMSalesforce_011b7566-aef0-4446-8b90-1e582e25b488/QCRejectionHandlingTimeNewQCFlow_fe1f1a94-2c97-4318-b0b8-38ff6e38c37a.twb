            <column caption='First QC Rejected(%) - Account' datatype='real' name='[Calculation_160229668772147201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_160229668771991552]/[Calculation_5054164722853298180]' />
            </column>
            <column caption='AccountSource' datatype='string' name='[Calculation_160229668777000964]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If(accountsource = &apos;Self Sign Up&apos;) THEN &apos;SSU&apos; ELSE &apos;Non-SSU&apos; END' />
