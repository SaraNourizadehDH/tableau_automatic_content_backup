      <column caption='Avg &quot;Pending with Vendor&quot; Time' datatype='real' name='[Avg &quot;Pending with Agent&quot; Time (copy) (copy)_5054164722566840322]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_time])/3600/[Calculation_160229668772454402]' />
      </column>
      <column caption='Avg &quot;Pending with SalesRep&quot; Time' datatype='real' name='[Avg &quot;Pending with Agent&quot; Time (copy)_5054164722566832129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sales_rep_time])/3600/[Calculation_160229668772454402]' />
      </column>
