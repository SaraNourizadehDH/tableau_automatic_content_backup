    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='General Information'>
      <style />
      <size maxheight='700' maxwidth='1000' minheight='700' minwidth='1000' preset-index='1' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='86714' id='3' type-v2='text' w='98400' x='800' y='12143'>
            <formatted-text>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>-</run>
              <run fontcolor='#000000' fontname='Times New Roman' fontsize='11'>Æ          </run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Documentation HERE :</run>
              <run fontcolor='#000000' fontname='Benton Sans Book'>Æ </run>
              <run auto-url='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='8' hyperlink='tabdoc:load-url url=&amp;quot;https://deliveryhero.atlassian.net/wiki/spaces/GSD/pages/24129283/AMC+Dashboard&amp;quot;'>https://deliveryhero.atlassian.net/wiki/spaces/GSD/pages/24129283/AMC+Dashboard</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>-</run>
              <run fontcolor='#000000' fontname='Times New Roman' fontsize='11'>Æ          </run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Dashboard Workbooks:  </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>1. General information: Consolidates important links and KPI calculations for easy reference. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>2. AMC Actioned Vendors: Gain Insights into Vendor Engagement and Success </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>3. AMC Action Items Overview: Provides a comprehensive view of action item progress, from initiation to closure. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>4. AMC Active Users: Provides insights into user behavior by analyzing various user actions. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>5. AMC Action Item Type Level </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>6. AMC AM Level </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>7. AMC Level Unsuccessful Root Causes </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Æ  </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>-</run>
              <run fontcolor='#000000' fontname='Times New Roman' fontsize='11'>Æ          </run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>KPI Calculation and Definition: </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>-           Maming &amp; Abbreviations:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>AI : Action Item</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>* with Status Change: </run>
              <run fontcolor='#222222' fontname='Arial,Helvetica,sans-serif' fontsize='11'>new status is different from old status over the selected period</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>* with Actions: </run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='11'>Æ  </run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='11000' id='7' type-v2='text' w='98400' x='800' y='1143'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>General Documentation </run>
