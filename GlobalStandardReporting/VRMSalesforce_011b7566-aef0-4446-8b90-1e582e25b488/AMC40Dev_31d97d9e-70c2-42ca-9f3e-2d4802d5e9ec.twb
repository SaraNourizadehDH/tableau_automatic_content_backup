        <calculation class='tableau' formula='COUNTD(IF [logins] &gt; 0 AND &#13;&#10;(&#13;&#10;[operation] = &apos;update action item&apos; OR&#13;&#10;[operation] = &apos;book promotion deal&apos; OR&#13;&#10;[operation] = &apos;book ncr deal&apos; OR&#13;&#10;[operation] = &apos;log call action&apos; OR&#13;&#10;[operation] = &apos;create task action&apos; OR&#13;&#10;[operation] = &apos;whatsapp action&apos; OR&#13;&#10;[operation] = &apos;create event action&apos; OR&#13;&#10;[operation] = &apos;my performance filter&apos;&#13;&#10;)&#13;&#10;THEN [ownerid] END)&#13;&#10;/&#13;&#10;ATTR({EXCLUDE DATETRUNC(&apos;day&apos;, [Ai Date (copy)_1726286054144745472]):COUNTD(IF [logins] &gt; 0 THEN [ownerid] END)})' />
