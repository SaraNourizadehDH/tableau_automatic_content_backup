      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='amc_action_items_test (sales_reports)' name='federated.15ot6ae1ki8i9k1b6jozc0blgv2t' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='Type of Granularity' datatype='string' name='[Time Param (copy)_1062356985736065025]' param-domain-type='list' role='measure' type='nominal' value='&quot;Sub Entity&quot;'>
              <calculation class='tableau' formula='&quot;Sub Entity&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15ot6ae1ki8i9k1b6jozc0blgv2t'>
            <column caption='Login Date Hierarchy' datatype='date' name='[Ai Date (copy)_1726286054144745472]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Login Date Hierarchy (copy)_1852105370063376384]' />
            </column>
            <column caption='Login Day' datatype='date' name='[Ai Day (copy)_1726286054144950273]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;day&apos;,DATE([login_date])))' />
            </column>
            <column caption='Login Month' datatype='date' name='[Ai Month (copy)_1726286054145224707]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,DATE([login_date])))' />
            </column>
            <column caption='Login Week' datatype='date' name='[Ai Week (copy)_1726286054145097730]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,DATE([login_date])))' />
            </column>
            <column caption='created_date_flag' datatype='boolean' name='[Calculation_1008032315023286272]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [iso_date] = DATE([ai_created_date]) THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Ai Created Date_' datatype='date' name='[Calculation_2279947332556169222]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(&#13;&#10;IF &#13;&#10;[Parameters].[Parameter 1] = &apos;Daily&apos; then [Createddate (copy)_501095881573449733]&#13;&#10;ELSEIF &#13;&#10;[Parameters].[Parameter 1] = &apos;Weekly&apos; then [Created Day (copy)_501095881573560326]&#13;&#10;ELSEIF&#13;&#10;[Parameters].[Parameter 1] = &apos;Monthly&apos; then [Created Week (copy)_501095881573609479]&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='Action Items Created' datatype='integer' name='[Calculation_501095881571758083]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_1008032315023286272] THEN [action_item_id] END)' />
            </column>
            <column caption='AI In Progress' datatype='integer' name='[Calculation_501095881574121480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Status__c] = &apos;In Progress&apos; THEN [action_item_id] END)' />
            </column>
            <column caption='AI Successful' datatype='integer' name='[Completed (copy)_1062356985807011852]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF ([Status__c] = &apos;Successful&apos; AND ISNULL([Processed_On__c]) = false) THEN [action_item_id] END)' />
            </column>
            <column caption='Ai Week' datatype='date' name='[Created Day (copy)_501095881573560326]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,DATE([ai_created_date])))' />
            </column>
            <column caption='Ai Month' datatype='date' name='[Created Week (copy)_501095881573609479]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,DATE([ai_created_date])))' />
            </column>
            <column caption='Ai Day' datatype='date' name='[Createddate (copy)_501095881573449733]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;day&apos;,DATE([ai_created_date])))' />
            </column>
            <column caption='AI Actioned' datatype='integer' name='[In Progress (copy)_1408993389845893120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF (([Status__c] = &apos;In Progress&apos; OR [Status__c] = &apos;Successful&apos; &#13;&#10;OR [Status__c] = &apos;Not Successful&apos; ) AND ISNULL([Processed_On__c]) = false)THEN [action_item_id] END)' />
            </column>
            <column caption='AI Expired' datatype='integer' name='[In Progress AIs (copy)_501095881574670346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF ([Root_Cause__c]  = &apos;Expired&apos; AND ISNULL([Processed_On__c]) = false) THEN [action_item_id] END)' />
            </column>
            <column caption='Login Date_' datatype='date' name='[Login Date Hierarchy (copy)_1852105370063376384]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(&#13;&#10;IF &#13;&#10;[Parameters].[Parameter 1] = &apos;Daily&apos; then [Ai Day (copy)_1726286054144950273]&#13;&#10;ELSEIF &#13;&#10;[Parameters].[Parameter 1] = &apos;Weekly&apos; then [Ai Week (copy)_1726286054145097730]&#13;&#10;ELSEIF&#13;&#10;[Parameters].[Parameter 1] = &apos;Monthly&apos; then [Ai Month (copy)_1726286054145224707]&#13;&#10;END&#13;&#10;)' />
            </column>
            <column datatype='string' name='[Processed_On__c]' role='dimension' type='nominal' />
            <column caption='Root Cause' datatype='string' name='[Root_Cause__c]' role='dimension' type='nominal' />
            <column caption='Status' datatype='string' name='[Status__c]' role='dimension' type='nominal' />
            <column caption='AI Unsuccessful' datatype='integer' name='[Successful (copy)_1062356985807089677]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF ([Status__c] = &apos;Not Successful&apos; AND ISNULL([Processed_On__c]) = false AND [Root_Cause__c]&lt;&gt; &apos;Expired&apos;) THEN [action_item_id] END)' />
            </column>
            <column caption='Granularity' datatype='string' name='[Time (copy)_1062356985736347650]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Parameters].[Time Param (copy)_1062356985736065025] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Time Param (copy)_1062356985736065025] = &apos;Management Entity&apos; THEN [management_entity]&#10;ELSEIF [Parameters].[Time Param (copy)_1062356985736065025] = &apos;Sub Entity&apos; THEN [sub_entity]&#10;ELSEIF [Parameters].[Time Param (copy)_1062356985736065025] = &apos;AM Name&apos; THEN [name]&#10;END' />
            </column>
