    <worksheet name='2.8 Deepdive Standard - ACM Users'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='amc_action_items_test (sales_reports)' name='federated.15ot6ae1ki8i9k1b6jozc0blgv2t' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Breakdown By 1' datatype='string' name='[Breakdown By (copy)_2279947332546396165]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vertical&quot;'>
              <calculation class='tableau' formula='&quot;Vertical&quot;' />
            </column>
            <column caption='Breakdown By 2' datatype='string' name='[Old_Status__c Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
            <column caption='Time Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='Report View' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vendor View&quot;'>
              <calculation class='tableau' formula='&quot;Vendor View&quot;' />
            </column>
            <column caption='Type of Granularity' datatype='string' name='[Time Param (copy)_1062356985736065025]' param-domain-type='list' role='measure' type='nominal' value='&quot;Sub Entity&quot;'>
              <calculation class='tableau' formula='&quot;Sub Entity&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15ot6ae1ki8i9k1b6jozc0blgv2t'>
            <column caption='% Total Users with Actions' datatype='real' name='[% Active Users with Actions (copy)_1079526942697627651]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1062356985735409664]/[Active Users (copy 2)_1062356985802657803]' />
            </column>
            <column caption='% Active Users with Updated AI' datatype='real' name='[% Active Users with Actions (copy)_1371064630993264641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Ionut_ Active_Users_Status (copy)_1371064630993047552]/[Active Users with Actions (copy)_1079526942683885568]' />
            </column>
            <column caption='Users with Access' datatype='integer' name='[Active Users (copy 2)_1062356985802657803]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_permission_set] THEN [ownerid] END)' />
            </column>
            <column caption='Active Users' datatype='integer' name='[Active Users with Actions (copy)_1079526942683885568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [logins] &gt; 0 THEN [ownerid] END)' />
            </column>
            <column caption='Ai Created Date Hierarchy' datatype='date' name='[Ai Created Date (copy)_2279947332958986254]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Calculation_2279947332556169222]' />
            </column>
            <column caption='Login Date Hierarchy' datatype='date' name='[Ai Date (copy)_1726286054144745472]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Login Date Hierarchy (copy)_1852105370063376384]' />
            </column>
            <column caption='Login Day' datatype='date' name='[Ai Day (copy)_1726286054144950273]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;day&apos;,DATE([login_date])))' />
            </column>
            <column caption='Login Month' datatype='date' name='[Ai Month (copy)_1726286054145224707]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,DATE([login_date])))' />
            </column>
            <column caption='Login Week' datatype='date' name='[Ai Week (copy)_1726286054145097730]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,DATE([login_date])))' />
            </column>
            <column caption='Breakdown By 2' datatype='string' name='[Breakdown By (copy)_2279947332546207748]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Old_Status__c Parameter] = &apos;Region&apos; then [region]&#13;&#10;ELSEIF [Parameters].[Old_Status__c Parameter] = &apos;Management Entity&apos; then [management_entity]&#13;&#10;ELSEIF [Parameters].[Old_Status__c Parameter] = &apos;Sub Entity&apos; then [sub_entity]&#13;&#10;ELSEIF [Parameters].[Old_Status__c Parameter] = &apos;Vertical&apos; then [vertical__c]&#13;&#10;ELSEIF [Parameters].[Old_Status__c Parameter] = &apos;Vertical Segment&apos; then [vertical_segment__c]&#13;&#10;ELSEIF [Parameters].[Old_Status__c Parameter] = &apos;Status&apos; then [Status__c]&#13;&#10;ELSEIF [Parameters].[Old_Status__c Parameter] = &apos;Root Cause&apos; then [Root_Cause__c]&#13;&#10;ELSEIF [Parameters].[Old_Status__c Parameter] = &apos;Ai Created Date&apos; then STR([Calculation_2279947332556169222])&#13;&#10;ELSEIF [Parameters].[Old_Status__c Parameter] = &apos;Account Manager&apos; then [name]&#13;&#10;ELSEIF [Parameters].[Old_Status__c Parameter] = &apos;Login Date&apos; then STR([Login Date Hierarchy (copy)_1852105370063376384])&#13;&#10;ELSEIF [Parameters].[Old_Status__c Parameter] = &apos;Type&apos; then [type__c]&#13;&#10;END' />
            </column>
            <column caption='Active Users with Actions' datatype='integer' name='[Calculation_1062356985735409664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [logins] &gt; 0 AND &#13;&#10;(&#13;&#10;[operation] = &apos;update action item&apos; OR&#13;&#10;[operation] = &apos;book promotion deal&apos; OR&#13;&#10;[operation] = &apos;book ncr deal&apos; OR&#13;&#10;[operation] = &apos;log call action&apos; OR&#13;&#10;[operation] = &apos;create task action&apos; OR&#13;&#10;[operation] = &apos;whatsapp action&apos; OR&#13;&#10;[operation] = &apos;create event action&apos; OR&#13;&#10;[operation] = &apos;my performance filter&apos;&#13;&#10;)&#13;&#10;THEN [ownerid] END)' />
            </column>
            <column caption='% Active Users with Actions' datatype='real' name='[Calculation_1079526942684229633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1062356985735409664]/[Active Users with Actions (copy)_1079526942683885568]' />
            </column>
            <column caption='Swap Report View' datatype='string' name='[Calculation_1710523455725486080]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2]' />
            </column>
            <column caption='Breakdown By 1' datatype='string' name='[Calculation_2279947332543610882]' role='dimension' type='nominal'>
