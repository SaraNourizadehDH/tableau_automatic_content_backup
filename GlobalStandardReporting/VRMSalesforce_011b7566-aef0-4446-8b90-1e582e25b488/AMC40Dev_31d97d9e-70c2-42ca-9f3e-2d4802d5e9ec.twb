            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#606b76'>&quot;Active Users&quot;: All owner ids with at least one login furing the selected period.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#606b76'>Formula: COUNTD(IF [Logins] &gt; 0 THEN [Ownerid] END)</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#606b76'>&quot;Active Users with Actions&quot;: All owner ids with at least one login during the selected period and some specific operations (see formula).</run>
                <run>Æ&#10;</run>
                <run fontcolor='#606b76'>Formula:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#606b76'>COUNTD(IF [Logins] &gt; 0 AND  ([Operation] = &apos;update action item&apos; OR</run>
                <run>Æ&#10;</run>
                <run fontcolor='#606b76'>[Operation] = &apos;book promotion deal&apos; OR</run>
                <run>Æ&#10;</run>
                <run fontcolor='#606b76'>[Operation] = &apos;book ncr deal&apos; OR</run>
                <run>Æ&#10;</run>
                <run fontcolor='#606b76'>[Operation] = &apos;log call action&apos; OR</run>
                <run>Æ&#10;</run>
                <run fontcolor='#606b76'>[Operation] = &apos;create task action&apos; OR</run>
                <run>Æ&#10;</run>
                <run fontcolor='#606b76'>[Operation] = &apos;whatsapp action&apos; OR</run>
                <run>Æ&#10;</run>
                <run fontcolor='#606b76'>[Operation] = &apos;create event action&apos; OR</run>
                <run>Æ&#10;</run>
                <run fontcolor='#606b76'>[Operation] = &apos;my performance filter&apos;) THEN [Ownerid] END)</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#606b76'>&quot;Active Users with Updated AI&quot;: All owner ids with operation &apos;update action item&apos;</run>
                <run>Æ&#10;</run>
                <run fontcolor='#606b76'>Formula: COUNTD(IF [Operation] = &apos;update action item&apos; THEN [Ownerid] END)</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#606b76'>&quot;%Active Users with Actions&quot; : [Active Users with Actions]/[Active Users]</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#606b76'>&quot;%Active Users with Updated AI&quot;: [Active Users with Updated AI]/[Active Users]</run>
              </formatted-text>
