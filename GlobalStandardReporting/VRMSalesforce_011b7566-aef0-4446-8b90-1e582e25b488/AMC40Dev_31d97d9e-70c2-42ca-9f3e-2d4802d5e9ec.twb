          <datasource-dependencies datasource='Parameters'>
            <column caption='Breakdown By 1' datatype='string' name='[Breakdown By (copy)_2279947332546396165]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vertical&quot;'>
              <calculation class='tableau' formula='&quot;Vertical&quot;' />
            </column>
            <column caption='Breakdown By 2' datatype='string' name='[Old_Status__c Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
            <column caption='Time Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
