        <calculation class='tableau' formula='IF ISNULL({FIXED [ownerid],[Calculation_501095881571323904]:MAX([logins])}) THEN 0&#10;ELSEIF [Status__c] = &apos;In Progress&apos; THEN ({FIXED [ownerid],[Calculation_501095881571323904]:MAX([logins])})&#10;END' />
