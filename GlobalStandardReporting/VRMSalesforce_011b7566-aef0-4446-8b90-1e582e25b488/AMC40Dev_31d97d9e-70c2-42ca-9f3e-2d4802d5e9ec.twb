              <text column='[federated.15ot6ae1ki8i9k1b6jozc0blgv2t].[attr:Calculation_317785272714883072:nk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#606b76' underline='true'>&quot;Action Items Created&quot; </run>
                <run fontcolor='#606b76'>refers to the total number of action items generated within the specified time period.</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#606b76'>&quot;% Actioned&quot; represents the proportion of action items that have either succeeded, failed, or are in progress and have been processed, relative to the total number of action items created during the specified timeframe.</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#606b76'>The remaining KPIs are determined by the status type.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#a7acad'>*&quot;Actioned&quot;: COUNTD(IF (([Status] = &apos;In Progress&apos; OR [Status] = &apos;Successful&apos;  OR [Status] = &apos;Not Successful&apos; ) AND ISNULL([Processed_On__c]) = false)THEN [Action Item Id] END)</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#a7acad'>* &quot;In Progress &quot;: COUNTD(IF [Status] = &apos;In Progress&apos; THEN [Action Item Id] END)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#a7acad'>*&quot;Closed&quot;:COUNTD(IF (closed_action = new_value_Status__c is &apos;success&apos; and &apos;not success&apos; and new_value_Processed_On__c is not null) THEN [Action Item Id]  END)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#a7acad'>*&quot;Succesfull&quot;: COUNTD(IF ([Status] = &apos;Successful&apos; AND ISNULL([Processed_On__c]) = false) THEN [Action Item Id] END)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#a7acad'><![CDATA[*" Unsuccessful": COUNTD(IF ([Status] = 'Not Successful' AND ISNULL([Processed_On__c]) = false ADN [Root Cause] <> 'Expired') THEN [Action Item Id] END)]]></run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#a7acad'>*&quot;Expired&quot;:COUNTD(IF ([Root Cause] = &apos;Expired&apos; AND ISNULL([Processed_On__c]) = false) THEN [Action Item Id] END)</run>
              </formatted-text>
            </customized-tooltip>
