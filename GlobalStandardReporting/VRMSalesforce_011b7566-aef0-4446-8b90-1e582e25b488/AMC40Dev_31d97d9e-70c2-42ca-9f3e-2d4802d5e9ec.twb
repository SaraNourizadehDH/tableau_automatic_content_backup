      <column caption='Users with Access (copy 2)' datatype='integer' name='[Users with Access (copy 2)_1079526942696386562]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_permission_set] AND&#10;(&#10;[operation] = &apos;update action item&apos; OR&#10;[operation] = &apos;book promotion deal&apos; OR&#10;[operation] = &apos;book ncr deal&apos; OR&#10;[operation] = &apos;log call action&apos; OR&#10;[operation] = &apos;create task action&apos; OR&#10;[operation] = &apos;whatsapp action&apos; OR&#10;[operation] = &apos;create event action&apos;&#10;)&#10;THEN [ownerid] END)' />
      </column>
