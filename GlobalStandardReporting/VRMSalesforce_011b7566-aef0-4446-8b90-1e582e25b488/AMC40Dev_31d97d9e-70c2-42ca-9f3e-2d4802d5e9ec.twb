          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15ot6ae1ki8i9k1b6jozc0blgv2t'>
            <column caption='% Closed' datatype='real' name='[% Actioned (copy)_1657043207675265028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Actioned (copy)_1657043207674351618]/[Calculation_501095881571758083]' />
            </column>
            <column caption='% AI Expired' datatype='real' name='[% Completed (copy)_1062356985738346502]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[In Progress AIs (copy)_501095881574670346]/[Successful (copy)_1062356985807089677]' />
            </column>
            <column caption='% AI Unsuccessful' datatype='real' name='[% In Progress (copy) (copy)_1062356985807253519]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Successful (copy)_1062356985807089677]/[Calculation_501095881571758083]' />
            </column>
            <column caption='% AI Successful' datatype='real' name='[% In Progress (copy)_1062356985807241230]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Completed (copy)_1062356985807011852]/[Calculation_501095881571758083]' />
            </column>
            <column caption='AI Closed' datatype='integer' name='[Actioned (copy)_1657043207674351618]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [closed_action] THEN [action_item_id]  END)&#13;&#10;//Formula: closed_action = new_value_Status__c is &apos;success&apos; and (to be replaced with OR) &apos;not success&apos; and new_value_Processed_On__c is not null ;' />
            </column>
            <column caption='% AI Actioned' datatype='real' name='[Actioned (copy)_2761128810249703424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[In Progress (copy)_1408993389845893120]/[Calculation_501095881571758083]' />
            </column>
            <column caption='Ai Created Date Hierarchy' datatype='date' name='[Ai Created Date (copy)_2279947332958986254]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Calculation_2279947332556169222]' />
            </column>
            <column caption='Login Date Hierarchy' datatype='date' name='[Ai Date (copy)_1726286054144745472]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Login Date Hierarchy (copy)_1852105370063376384]' />
            </column>
            <column caption='Login Day' datatype='date' name='[Ai Day (copy)_1726286054144950273]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;day&apos;,DATE([login_date])))' />
            </column>
            <column caption='Login Month' datatype='date' name='[Ai Month (copy)_1726286054145224707]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,DATE([login_date])))' />
            </column>
            <column caption='Login Week' datatype='date' name='[Ai Week (copy)_1726286054145097730]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,DATE([login_date])))' />
            </column>
            <column caption='Breakdown By 2' datatype='string' name='[Breakdown By (copy)_2279947332546207748]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Old_Status__c Parameter] = &apos;Region&apos; then [region]&#13;&#10;ELSEIF [Parameters].[Old_Status__c Parameter] = &apos;Management Entity&apos; then [management_entity]&#13;&#10;ELSEIF [Parameters].[Old_Status__c Parameter] = &apos;Sub Entity&apos; then [sub_entity]&#13;&#10;ELSEIF [Parameters].[Old_Status__c Parameter] = &apos;Vertical&apos; then [vertical__c]&#13;&#10;ELSEIF [Parameters].[Old_Status__c Parameter] = &apos;Vertical Segment&apos; then [vertical_segment__c]&#13;&#10;ELSEIF [Parameters].[Old_Status__c Parameter] = &apos;Status&apos; then [Status__c]&#13;&#10;ELSEIF [Parameters].[Old_Status__c Parameter] = &apos;Root Cause&apos; then [Root_Cause__c]&#13;&#10;ELSEIF [Parameters].[Old_Status__c Parameter] = &apos;Ai Created Date&apos; then STR([Calculation_2279947332556169222])&#13;&#10;ELSEIF [Parameters].[Old_Status__c Parameter] = &apos;Account Manager&apos; then [name]&#13;&#10;ELSEIF [Parameters].[Old_Status__c Parameter] = &apos;Login Date&apos; then STR([Login Date Hierarchy (copy)_1852105370063376384])&#13;&#10;ELSEIF [Parameters].[Old_Status__c Parameter] = &apos;Type&apos; then [type__c]&#13;&#10;END' />
            </column>
            <column caption='created_date_flag' datatype='boolean' name='[Calculation_1008032315023286272]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [iso_date] = DATE([ai_created_date]) THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Swap Report View' datatype='string' name='[Calculation_1710523455725486080]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2]' />
            </column>
            <column caption='Breakdown By 1' datatype='string' name='[Calculation_2279947332543610882]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Breakdown By (copy)_2279947332546396165] = &apos;Region&apos; then [region]&#13;&#10;ELSEIF [Parameters].[Breakdown By (copy)_2279947332546396165] = &apos;Management Entity&apos; then [management_entity]&#13;&#10;ELSEIF [Parameters].[Breakdown By (copy)_2279947332546396165] = &apos;Sub Entity&apos; then [sub_entity]&#13;&#10;ELSEIF [Parameters].[Breakdown By (copy)_2279947332546396165] = &apos;Vertical&apos; then [vertical__c]&#13;&#10;ELSEIF [Parameters].[Breakdown By (copy)_2279947332546396165] = &apos;Vertical Segment&apos; then [vertical_segment__c]&#13;&#10;ELSEIF [Parameters].[Breakdown By (copy)_2279947332546396165] = &apos;Status&apos; then [Status__c]&#13;&#10;ELSEIF [Parameters].[Breakdown By (copy)_2279947332546396165] = &apos;Root Cause&apos; then [Root_Cause__c]&#13;&#10;ELSEIF [Parameters].[Breakdown By (copy)_2279947332546396165] = &apos;Ai Created Date&apos; then STR([Calculation_2279947332556169222])&#13;&#10;ELSEIF [Parameters].[Breakdown By (copy)_2279947332546396165] = &apos;Account Manager&apos; then [name]&#13;&#10;ELSEIF [Parameters].[Breakdown By (copy)_2279947332546396165] = &apos;Login Date&apos; then STR([Login Date Hierarchy (copy)_1852105370063376384])&#13;&#10;ELSEIF [Parameters].[Breakdown By (copy)_2279947332546396165] = &apos;Type&apos; then [type__c]&#13;&#10;END' />
            </column>
            <column caption='Ai Created Date_' datatype='date' name='[Calculation_2279947332556169222]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(&#13;&#10;IF &#13;&#10;[Parameters].[Parameter 1] = &apos;Daily&apos; then [Createddate (copy)_501095881573449733]&#13;&#10;ELSEIF &#13;&#10;[Parameters].[Parameter 1] = &apos;Weekly&apos; then [Created Day (copy)_501095881573560326]&#13;&#10;ELSEIF&#13;&#10;[Parameters].[Parameter 1] = &apos;Monthly&apos; then [Created Week (copy)_501095881573609479]&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='Action Items Created' datatype='integer' name='[Calculation_501095881571758083]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_1008032315023286272] THEN [action_item_id] END)' />
            </column>
            <column caption='AI In Progress' datatype='integer' name='[Calculation_501095881574121480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Status__c] = &apos;In Progress&apos; THEN [action_item_id] END)' />
            </column>
            <column caption='AI Successful' datatype='integer' name='[Completed (copy)_1062356985807011852]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF ([Status__c] = &apos;Successful&apos; AND ISNULL([Processed_On__c]) = false) THEN [action_item_id] END)' />
            </column>
            <column caption='Ai Week' datatype='date' name='[Created Day (copy)_501095881573560326]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,DATE([ai_created_date])))' />
            </column>
            <column caption='Ai Month' datatype='date' name='[Created Week (copy)_501095881573609479]' role='dimension' type='ordinal'>
