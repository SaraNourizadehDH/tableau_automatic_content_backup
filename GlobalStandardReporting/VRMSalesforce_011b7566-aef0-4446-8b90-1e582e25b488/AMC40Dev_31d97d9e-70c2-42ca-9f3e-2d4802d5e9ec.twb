          <datasource-dependencies datasource='federated.15ot6ae1ki8i9k1b6jozc0blgv2t'>
            <column caption='% Actioned Vendors per month' datatype='real' name='[% Actioned Vendors per month (copy)_552816891390541853]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [status_changed] THEN [grid] END) / ATTR({EXCLUDE DATETRUNC(&apos;day&apos;, [Calculation_2279947332556169222]):COUNTD([grid])})' />
            </column>
            <column caption='% Successfully Actioned Vendors per Month' datatype='real' name='[% Successfully Actioned Vendors per Month (copy)_552816891391442974]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF ([Status__c] = &apos;Successful&apos; AND ISNULL([Processed_On__c]) = false)  THEN [grid] END) /  ATTR({EXCLUDE DATETRUNC(&apos;day&apos;, [Calculation_2279947332556169222]):COUNTD([grid])})' />
