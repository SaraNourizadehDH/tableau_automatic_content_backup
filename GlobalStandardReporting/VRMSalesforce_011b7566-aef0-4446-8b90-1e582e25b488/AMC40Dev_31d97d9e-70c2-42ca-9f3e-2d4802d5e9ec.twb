      </column>
      <column caption='% AI Actioned per month' datatype='real' name='[% Actioned (copy)_552816890760413186]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF (([Status__c] = &apos;In Progress&apos; OR [Status__c] = &apos;Successful&apos; &#13;&#10;OR [Status__c] = &apos;Not Successful&apos; ) AND ISNULL([Processed_On__c]) = false)THEN [action_item_id] END)&#13;&#10;/&#13;&#10;ATTR({EXCLUDE DATETRUNC(&apos;day&apos;, [Calculation_2279947332556169222]):COUNTD(IF [Calculation_1008032315023286272] THEN [action_item_id] END)})' />
      </column>
      <column caption='% Actioned Vendors per month' datatype='real' name='[% Actioned Vendors per month (copy)_552816891390541853]' role='measure' type='quantitative'>
