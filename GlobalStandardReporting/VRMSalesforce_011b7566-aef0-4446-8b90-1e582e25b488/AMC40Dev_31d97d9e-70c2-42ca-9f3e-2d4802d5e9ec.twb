          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <tooltip column='[federated.15ot6ae1ki8i9k1b6jozc0blgv2t].[attr:Calculation_317785272714883072:nk]' />
              <text column='[federated.15ot6ae1ki8i9k1b6jozc0blgv2t].[attr:Calculation_317785272714883072:nk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#606b76' underline='true'>&quot;Active AI Vendors&quot; </run>
                <run fontcolor='#606b76'>represents the total number of vendors that have been involved in at least one action item within the selected period.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#a7acad'>Formula: COUNTD([Grid])</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#606b76' underline='true'>&quot;Actioned Vendors&quot; </run>
                <run fontcolor='#606b76'>refers to the total count of vendors that experienced at least one status change during the specified timeframe.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#a7acad'>Formula: COUNTD(IF [status_changed] THEN grid END)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#a7acad'><![CDATA[* [status_changed]:  status_changed = change old_value_Status__c <> new_value_Status__c except null in both and new_status is 'new']]></run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#606b76' underline='true'>&quot;% Actioned Vendors&quot;</run>
                <run fontcolor='#606b76'> represents the proportion of vendors that experienced a status change out of the total vendors with at least one action item during the specified timeframe.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#a7acad'>Formula: [Actioned Vendors]/COUNTD([Grid])</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#606b76' underline='true'>&quot;% Successfully Actioned Vendors&quot;</run>
                <run fontcolor='#606b76'> represents the proportion of vendors that have achieved a &quot;successful&quot; status and have a recorded processing date, relative to the total number of vendors.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#a7acad'>Formula: COUNTD(IF ([Status] = &apos;Successful&apos; AND ISNULL([Processed_On__c]) = false)  THEN [Grid] END) /COUNTD([Grid])</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-transparency' value='255' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
