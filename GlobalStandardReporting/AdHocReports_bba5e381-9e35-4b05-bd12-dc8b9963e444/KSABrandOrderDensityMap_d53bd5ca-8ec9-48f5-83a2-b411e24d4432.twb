          <relation connection='bigquery.1tgvzgt13x7sq919xbyqb0i6m1a5' name='Custom SQL Query' type='text'>SELECT
DISTINCT
    a.global_entity_id,
    a.location_name,
    a.location_status,
    a.kitchen_latitude AS f_latitude,
    a.kitchen_longitude AS f_longitude,
    b.kitchen_name
  FROM
    `fulfillment-dwh-production.dbt_cl_gfs.kitchen_locations_polygons` a
LEFT JOIN `fulfillment-dwh-production.dbt_cl_gfs.kitchen_locations_polygons` b
ON a.global_entity_id=b.global_entity_id AND a.location_name=b.official_kitchen_name
  WHERE
    a.global_entity_id IN(&apos;HS_SA&apos;)
    AND a.location_status IN (
      &apos;2. Approved&apos;,
      &apos;5. Kitchen Live&apos;,
      &apos;3. Lease Signed&apos;,
      &apos;4. Under Construction&apos;)</relation>
