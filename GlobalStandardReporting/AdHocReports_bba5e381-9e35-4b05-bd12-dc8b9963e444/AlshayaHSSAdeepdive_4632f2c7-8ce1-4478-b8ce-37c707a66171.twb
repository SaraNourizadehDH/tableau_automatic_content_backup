      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_3D9696AA087544A1BA43AA42CBCFB2DB'>
            <properties context=''>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Custom SQL Query].[global_entity_id]' />
                    <expression op='[tableau_user_entitlement].[global_entity_id]' />
                  </expression>
                </clause>
                <relation connection='bigquery.1ahfbfq1dybynt1fga5wl03g0uyz' name='Custom SQL Query' type='text'><![CDATA[WITH logo AS (
  SELECT
          entity.id    global_entity_id,
          vendor_code  vendor_id,
          order_code order_id,
           (SELECT MAX(delivery.delivery_distance)
           FROM UNNEST(rider.deliveries) delivery
           WHERE delivery.is_primary) delivery_distance,
          SUM(CASE WHEN is_preorder IS FALSE THEN TIMESTAMP_DIFF(o.vendor.picked_up_at, o.vendor.sending_to_vendor_at, MINUTE) -- as received_by_vendor is unavailable, sending to vendor is used as replacement
          END) AS prep_time_tb,
          COUNT(CASE WHEN is_rider_order AND ROUND((SELECT MAX(delivery.timings.vendor_late)
                                                  FROM UNNEST(rider.deliveries) delivery
                                                  WHERE delivery.is_primary)/60, 0) >> 5 THEN order_code END) as vendor_late_5_min_count,
          --Removed delivery time, cause accepted_by_vendor_at is often NULL, for our vendors always NULLs
          --SUM(ROUND(CASE WHEN is_rider_order AND NOT is_preorder THEN
           -- DATE_DIFF(COALESCE(o.vendor.near_dropoff_at, o.vendor.delivered_at),COALESCE(o.vendor.accepted_by_vendor_at, o.vendor.implicitly_accepted_by_vendor_at), minute)
           -- END,0)) AS actual_delivery_time
        FROM `fulfillment-dwh-production.curated_data_shared.orders_v2` o
        JOIN gfs-tech.gfs_bi.ksa_alshaya_vendor_facility_distance v ON v.vendor_id = o.vendor_code AND v.global_entity_id = o.entity.id
        WHERE o.vendor.cancelled_at IS NULL AND entity.id IN ('HS_SA', 'TB_KW', 'TB_AE', 'TB_QA', 'TB_BH') AND o.created_date >>= '2023-05-01'-- AND v.facility_distance/1000 <<= 5
        GROUP BY 1, 2, 3, 4
),

availability AS (
SELECT
        entity_id AS global_entity_id,
        vendor_code AS vendor_id,
        created_date,
        SUM(ac.slot.offline_seconds/60) AS offline_minutes,
        AVG(ac.slot.schedule_seconds/60) AS schedule_minutes
      FROM `fulfillment-dwh-production.curated_data_shared.vendor_availability_connectivity` ac
      WHERE created_date >>= '2023-05-01' AND entity_id IN ('HS_SA', 'TB_KW', 'TB_AE', 'TB_QA', 'TB_BH')
      GROUP BY 1, 2, 3
)
, pre AS (
SELECT
base.global_entity_id,
base.vendor_id,
location_name,
distance_km, 
COUNT(distinct base.vendor_id) AS vendor_count,
SUM(successful_orders) AS successful_orders,
SUM(prep_time_tb_count) AS prep_time_tb_count,
SUM(prep_time_tb_sum) AS prep_time_tb_sum,
SUM(delivery_distance_count) AS delivery_distance_count,
SUM(delivery_distance_sum) AS delivery_distance_sum,
SUM(vendor_late_5_min_count) AS vendor_late_5_min_count,
SUM(failed_orders_vendor) AS failed_orders_vendor,
SUM(total_orders) AS total_orders,
SUM(a.offline_minutes) AS offline_minutes,
SUM(a.schedule_minutes) AS schedule_minutes
FROM
(SELECT
o.global_entity_id,
o.vendor_id,
v.location_name,
CASE WHEN v.facility_distance/1000 << 2 THEN 'below 2 km'
     WHEN v.facility_distance/1000 BETWEEN 2 AND 3 THEN '2-3km'
     WHEN v.facility_distance/1000 BETWEEN 3 AND 4 THEN '3-4km'
     WHEN v.facility_distance/1000 BETWEEN 4 AND 5 THEN '4-5km'
     ELSE '>> 5km'
     END AS distance_km,
DATE(o.placed_at_local) AS report_date,
COUNT(distinct CASE WHEN o.is_sent THEN o.order_id END) AS successful_orders,
COUNT(logo.prep_time_tb) AS prep_time_tb_count,
SUM(logo.prep_time_tb) AS prep_time_tb_sum,
--COUNT(logo.actual_delivery_time) AS actual_delivery_time_min_count,
--SUM(logo.actual_delivery_time) AS actual_delivery_time_min_sum,
COUNT(delivery_distance) AS delivery_distance_count,
SUM(delivery_distance) AS delivery_distance_sum,
SUM(logo.vendor_late_5_min_count) AS vendor_late_5_min_count,
COUNT(DISTINCT CASE WHEN o.failure_owner = "VENDOR" THEN o.order_id END) AS failed_orders_vendor,
COUNT(DISTINCT o.order_id) AS total_orders,
--AVG(CASE WHEN 1 - IFNULL(a.offline_minutes, 0)/a.schedule_minutes = 0
  --  THEN NULL ELSE a.offline_minutes END) AS offline_minutes,
--AVG(CASE WHEN 1 - IFNULL(a.offline_minutes, 0)/ a.schedule_minutes = 0
      --THEN NULL ELSE a.schedule_minutes END) AS schedule_minutes
FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o
JOIN gfs-tech.gfs_bi.ksa_alshaya_vendor_facility_distance v ON v.vendor_id = o.vendor_id AND v.global_entity_id = o.global_entity_id
LEFT JOIN logo ON logo.global_entity_id=o.global_entity_id AND o.order_id=logo.order_id
--LEFT JOIN availability a ON o.global_entity_id = a.global_entity_id AND o.vendor_id = a.vendor_id AND DATE(o.placed_at_local) = a.created_date
WHERE o.global_entity_id IN('HS_SA', 'TB_KW', 'TB_AE', 'TB_QA', 'TB_BH') AND DATE(o.placed_at_local) >>= '2023-05-01' --AND v.facility_distance/1000 <<= 5
GROUP BY 1,2,3,4, 5) base
LEFT JOIN availability a ON base.vendor_id = a.vendor_id AND base.report_date = a.created_date
GROUP BY 1,2,3, 4
)
SELECT * FROM pre JOIN gfs-tech.gfs_bi.ksa_alshaya_vendor_facility_distance f using (global_entity_id, vendor_id, location_name)]]></relation>
                <relation connection='bigquery.0l5muq6095wteb18pvsn81ae504r' name='tableau_user_entitlement' table='[fulfillment-dwh-production.rl_gfs].[tableau_user_entitlement]' type='table' />
              </relation>
            </properties>
            <properties context='extract'>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Custom SQL Query].[global_entity_id]' />
                    <expression op='[tableau_user_entitlement].[global_entity_id]' />
                  </expression>
                </clause>
                <relation name='Custom SQL Query' table='[Extract].[Custom SQL Query]' type='table' />
                <relation name='tableau_user_entitlement' table='[Extract].[tableau_user_entitlement]' type='table' />
              </relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
