  <worksheets>
    <worksheet name='Fail Rate'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (gfs_bi)' name='federated.0zmzvxs1m5jly913i00b01fm8pnh' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.0zmzvxs1m5jly913i00b01fm8pnh'>
            <column caption='Facility Point' datatype='spatial' name='[Calculation_841047258189598724]' role='measure' type='nominal'>
              <calculation class='tableau' formula='MAKEPOINT([f_latitude], [f_longitude])' />
            </column>
            <column caption='Vendor Point' datatype='spatial' name='[Calculation_841047258189856773]' role='measure' type='nominal'>
