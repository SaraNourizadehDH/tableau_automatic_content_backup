                <relation connection='bigquery.1ahfbfq1dybynt1fga5wl03g0uyz (copy)' name='Custom SQL Query' type='text'>SELECT
    global_entity_id,
    location_name,
    location_status,
    latitude AS f_latitude,
    longitude AS f_longitude
  FROM
    `fulfillment-dwh-production.cl_gfs.kitchen_locations`
  WHERE
    global_entity_id IN(&apos;HS_SA&apos;)
    AND kitchen_owner IN (&apos;CSS_Colab&apos;,
      &apos;Central&apos;)
    AND location_status IN (&apos;Live&apos;,
      &apos;Approved&apos;,
      &apos;2. Approved&apos;,
      &apos;5. Kitchen Live&apos;,
      &apos;3. Lease Signed&apos;,
      &apos;4. Under Construction&apos;)</relation>
