      <aliases enabled='yes' />
      <column caption='Has Suc. Orders Last 30 Days' datatype='boolean' name='[Calculation_1452973831398273025]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [orders_ct] &gt; 0 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Vendor' datatype='string' name='[Calculation_1452973831411077122]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[entity_id]+[vendor_code]' />
      </column>
      <column caption='user_name' datatype='boolean' name='[Calculation_2000161187171266561]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Unreachable Duration Cat2' datatype='string' name='[Calculation_5883741810935160832]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_7027867286411821058] &lt;= 20160 THEN &apos;Less than 14 days&apos;&#10;ELSEIF [Calculation_7027867286411821058] &lt;= 43200 THEN &apos;14 - 30 days&apos;&#10;ELSEIF [Calculation_7027867286411821058] &lt;= 129600 THEN &apos;30 - 90 days&apos;&#10;ELSE &apos;More than 90 days&apos;&#10;END' />
      </column>
      <column caption='last 30 Days Orders Category' datatype='string' name='[Calculation_5883741810937815041]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [orders_ct] = 0 THEN &apos;0 Orders&apos;&#10;ELSEIF [orders_ct] = 1 THEN &apos;1 Orders&apos;&#10;ELSEIF [orders_ct] &lt;= 10 THEN &apos;2 - 10 Orders&apos;&#10;ELSEIF [orders_ct] &lt;= 30 THEN &apos;10 - 30 Orders&apos;&#10;ELSEIF [orders_ct] &lt;= 50 THEN &apos;30 - 50 Orders&apos;&#10;ELSEIF [orders_ct] &lt;= 100 THEN &apos;50 - 100 Orders&apos;&#10;ELSEIF ISNULL([orders_ct]) THEN &apos;0 Orders&apos;&#10;ELSE &apos;More than 100 Orders&apos;&#10;END' />
      </column>
      <column caption='Checkin Required &apos;UnReachable&apos; Duration (min)' datatype='real' name='[Calculation_7027867286378254336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[duration_seconds]/60' />
      </column>
      <column caption='Checkin Required Unreachable Duration Category' datatype='string' name='[Calculation_7027867286378840065]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_7027867286378254336] &lt;= 30 THEN &apos;Less than 30 Min&apos;&#10;ELSEIF [Calculation_7027867286378254336] &lt;= 60 THEN &apos;30 - 60 Min&apos;&#10;ELSEIF [Calculation_7027867286378254336] &lt;= 120 THEN &apos;60 - 120 Min&apos;&#10;ELSEIF [Calculation_7027867286378254336] &lt;= 240 THEN &apos;2 - 4 Hrs&apos;&#10;ELSEIF [Calculation_7027867286378254336] &lt;= 360 THEN &apos;4 - 6 Hrs&apos;&#10;ELSEIF [Calculation_7027867286378254336] &lt;= 480 THEN &apos;6 - 8 Hrs&apos;&#10;ELSEIF [Calculation_7027867286378254336] &lt;= 600 THEN &apos;8 - 10 Hrs&apos;&#10;ELSEIF [Calculation_7027867286378254336] &lt;= 720 THEN &apos;10 - 12 Hrs&apos;&#10;ELSE &apos;12 - 24 Hrs&apos;&#10;END' />
      </column>
      <column caption='Unreachable Duration (min)' datatype='real' name='[Calculation_7027867286411821058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[unreachable_duration]/60' />
      </column>
      <column caption='Unreachable Duration Category' datatype='string' name='[Calculation_7027867286412308483]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_7027867286411821058] &lt;= 20160 THEN &apos;Less than 14 days&apos;&#10;ELSEIF [Calculation_7027867286411821058] &lt;= 43200 THEN &apos;14 - 30 days&apos;&#10;ELSEIF [Calculation_7027867286411821058] &lt;= 129600 THEN &apos;30 - 90 days&apos;&#10;ELSE &apos;More than 90 days&apos;&#10;END' />
      </column>
      <column caption='Detailed Reason' datatype='string' name='[Calculation_7027867286628941828]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bad_internet_client] = &apos;internet&apos; THEN &apos;Bad Internet - Client Event&apos;&#10;ELSEIF [low_battery_client] = &apos;battery&apos; THEN &apos;Low Battery - Client Event&apos;&#10;ELSEIF [avg_signal_strength] &lt;= 30 THEN &apos;Bad Internet - Device Event&apos;&#10;ELSEIF [avg_battery_level] &lt;= 30 THEN &apos;Low Battery - Device Event&apos;&#10;ELSEIF (&#10;  ISNULL([bad_internet_client]) = TRUE AND&#10;  ISNULL([low_battery_client]) = TRUE AND&#10;  ISNULL([avg_battery_level]) = TRUE AND&#10;  ISNULL([avg_signal_strength]) = TRUE &#10;) THEN &apos;No Associated Activities&apos;&#10;ELSE &apos;Unknown&apos;&#10;END' />
      </column>
      <column caption='Is Unreachable more than 24 hrs' datatype='boolean' name='[Calculation_7027867286629543941]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [unreachable_duration] &gt;= 604800 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Is Vendor Offline Whole Schedule' datatype='boolean' name='[Calculation_7027867286729269254]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [duration_seconds]/[schedule_seconds] &gt;= 0.95 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Reason' datatype='string' name='[Calculation_7027867286730760199]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_7027867286628941828] = &apos;Bad Internet - Client Event&apos; THEN &apos;Bad Internet&apos;&#10;ELSEIF [Calculation_7027867286628941828] = &apos;Bad Internet - Device Event&apos; THEN &apos;Bad Internet&apos;&#10;ELSEIF [Calculation_7027867286628941828] = &apos;Low Battery - Client Event&apos; THEN &apos;Low Battery&apos;&#10;ELSEIF [Calculation_7027867286628941828] = &apos;Low Battery - Device Event&apos; THEN &apos;Low Battery&apos;&#10;ELSE [Calculation_7027867286628941828]&#10;END' />
      </column>
