    <worksheet name='Reason'>
      <table>
        <view>
          <datasources>
            <datasource caption='unreachable_offline_analysis_v2' name='federated.10pg61n055rztt1er08tp1b76pzk' />
          </datasources>
          <datasource-dependencies datasource='federated.10pg61n055rztt1er08tp1b76pzk'>
            <column caption='Has Orders Last 30 days' datatype='boolean' name='[Calculation_1452973831382790144]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [orders_ct] &gt; 0 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Reason' datatype='string' name='[Calculation_201184293580578819]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_856246932185382931] = &apos;Bad Internet - Client Event&apos; THEN &apos;Bad Internet&apos;&#10;ELSEIF [Calculation_856246932185382931] = &apos;Bad Internet - Device Event&apos; THEN &apos;Bad Internet&apos;&#10;ELSEIF [Calculation_856246932185382931] = &apos;Low Battery - Client Event&apos; THEN &apos;Low Battery&apos;&#10;ELSEIF [Calculation_856246932185382931] = &apos;Low Battery - Device Event&apos; THEN &apos;Low Battery&apos;&#10;ELSE [Calculation_856246932185382931]&#10;END' />
            </column>
            <column caption='Device Type from Events' datatype='string' name='[Calculation_201184293599440901]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([client_name])=FALSE THEN [client_name]&#10;ELSE [device_client_name]&#10;END' />
            </column>
            <column caption='Associated Device Type' datatype='string' name='[Calculation_856246932165263367]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [device_general_client] = &apos;AWW&apos; THEN &apos;GODROID&apos;&#10;ELSE [device_general_client]&#10;END' />
            </column>
            <column caption='Detailed Reason' datatype='string' name='[Calculation_856246932185382931]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [bad_internet_client] = &apos;internet&apos; THEN &apos;Bad Internet - Client Event&apos;&#10;ELSEIF [low_battery_client] = &apos;battery&apos; THEN &apos;Low Battery - Client Event&apos;&#10;ELSEIF [avg_signal_strength] &lt;= 30 THEN &apos;Bad Internet - Device Event&apos;&#10;ELSEIF [avg_battery_level] &lt;= 30 THEN &apos;Low Battery - Device Event&apos;&#10;ELSEIF ([due_to_previous_event] = &apos;SLOT STARTS&apos; AND [is_working_hours_check_in_enabled] = TRUE) THEN &apos;Late Vendor Online&apos;&#10;ELSEIF [next_event] = &apos;SLOT ENDS&apos; THEN &apos;Early Vendor Closure&apos;&#10;ELSEIF (&#10;  ISNULL([bad_internet_client]) = TRUE AND&#10;  ISNULL([low_battery_client]) = TRUE AND&#10;  ISNULL([due_to_previous_event]) = TRUE AND&#10;  ISNULL([next_event]) = TRUE AND &#10;  ISNULL([avg_battery_level]) = TRUE AND&#10;  ISNULL([avg_signal_strength]) = TRUE &#10;) THEN &apos;No Associated Activities&apos;&#10;ELSE &apos;Unclassified&apos;&#10;END' />
            </column>
            <column datatype='real' name='[avg_battery_level]' role='measure' type='quantitative' />
            <column datatype='real' name='[avg_signal_strength]' role='measure' type='quantitative' />
            <column datatype='string' name='[bad_internet_client]' role='dimension' type='nominal' />
            <column datatype='string' name='[client_name]' role='dimension' type='nominal' />
            <column-instance column='[starts_at]' derivation='Count' name='[cnt:starts_at:qk]' pivot='key' type='quantitative' />
            <column caption='Device Client Name' datatype='string' name='[device_client_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[device_general_client]' role='dimension' type='nominal' />
            <column datatype='string' name='[due_to_previous_event]' role='dimension' type='nominal' />
            <column datatype='integer' name='[duration_seconds]' role='measure' type='quantitative' />
            <column caption='Entity Id' datatype='string' name='[entity_id]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_working_hours_check_in_enabled]' role='dimension' type='nominal' />
            <column datatype='string' name='[low_battery_client]' role='dimension' type='nominal' />
            <column datatype='string' name='[next_event]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1452973831382790144]' derivation='None' name='[none:Calculation_1452973831382790144:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_201184293580578819]' derivation='None' name='[none:Calculation_201184293580578819:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_201184293599440901]' derivation='None' name='[none:Calculation_201184293599440901:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_856246932165263367]' derivation='None' name='[none:Calculation_856246932165263367:nk]' pivot='key' type='nominal' />
            <column-instance column='[entity_id]' derivation='None' name='[none:entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[orders_ct]' role='measure' type='quantitative' />
            <column-instance column='[starts_at]' derivation='Count' name='[pcto:cnt:starts_at:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
            <column-instance column='[duration_seconds]' derivation='Sum' name='[pcto:sum:duration_seconds:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column datatype='datetime' name='[starts_at]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <manual-sort column='[federated.10pg61n055rztt1er08tp1b76pzk].[none:Calculation_201184293580578819:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Bad Internet&quot;</bucket>
              <bucket>&quot;Low Battery&quot;</bucket>
              <bucket>&quot;Late Vendor Online&quot;</bucket>
              <bucket>&quot;Early Vendor Closure&quot;</bucket>
              <bucket>&quot;No Associated Activities&quot;</bucket>
              <bucket>&quot;Unclassified&quot;</bucket>
