              <calculation class='tableau' formula='IF [orders_ct] = 0 THEN &apos;0 Orders&apos;&#10;ELSEIF [orders_ct] = 1 THEN &apos;1 Orders&apos;&#10;ELSEIF [orders_ct] &lt;= 10 THEN &apos;2 - 10 Orders&apos;&#10;ELSEIF [orders_ct] &lt;= 30 THEN &apos;10 - 30 Orders&apos;&#10;ELSEIF [orders_ct] &lt;= 50 THEN &apos;30 - 50 Orders&apos;&#10;ELSEIF [orders_ct] &lt;= 100 THEN &apos;50 - 100 Orders&apos;&#10;ELSEIF ISNULL([orders_ct]) THEN &apos;0 Orders&apos;&#10;ELSE &apos;More than 100 Orders&apos;&#10;END' />
