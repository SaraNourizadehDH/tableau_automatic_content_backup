    <datasource caption='Custom SQL Query (Match_Lists)' inline='true' name='federated.06kaihn1o7d8v31b3juto1wfn9o8' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0p76cdg0cvpfz213zrlak1281e9m'>
            <connection CATALOG='dh-marketing-analytics' EXECCATALOG='dh-marketing-analytics' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='DH-Marketing-Analytics' schema='Match_Lists' server-oauth='server-custom' username='thomas.perl@deliveryhero.com' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0p76cdg0cvpfz213zrlak1281e9m' name='Custom SQL Query' type='text'>SELECT management_entity, global_entity_id,&#13;
CASE&#13;
    WHEN order_rank = 1 THEN &apos;A: 1&apos;&#13;
    WHEN order_rank BETWEEN 2 AND 3 THEN &apos;B: 2-3&apos;&#13;
    WHEN order_rank BETWEEN 4 AND 5 THEN &apos;C: 4-5&apos;&#13;
    WHEN order_rank BETWEEN 6 AND 9 THEN &apos;D: 6-9&apos;&#13;
    WHEN order_rank BETWEEN 10 AND 15 THEN &apos;E: 10-15&apos;&#13;
    WHEN order_rank BETWEEN 16 AND 30 THEN &apos;F: 16-30&apos;&#13;
    WHEN order_rank BETWEEN 31 AND 100 THEN &apos;G: 31-100&apos;&#13;
    WHEN order_rank &gt;&gt; 100 THEN &apos;H: 100+&apos;&#13;
    ELSE &apos;NA&apos;&#13;
  END AS lifetime_order_count_bins, &#13;
FLOOR(incentivization_rate * 10) / 10 lifetime_incentivization_bins,&#13;
AVG(customer_lifetime_gmv_13_weeks_eur) AS avg_customer_lifetime_gmv_13_weeks_eur ,&#13;
AVG(actual_gmv_13_weeks_eur) AS avg_actual_gmv_13_weeks_eur,&#13;
COUNT(DISTINCT analytical_customer_id) cnt_customers,&#13;
FROM `dh-marketing-analytics.Match_Lists.DHMA-2769_clv_actuals`&#13;
WHERE customer_lifetime_gmv_13_weeks_eur IS NOT NULL&#13;
GROUP BY 1,2,3,4</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0p76cdg0cvpfz213zrlak1281e9m' name='Custom SQL Query' type='text'>SELECT management_entity, global_entity_id,&#13;
CASE&#13;
    WHEN order_rank = 1 THEN &apos;A: 1&apos;&#13;
    WHEN order_rank BETWEEN 2 AND 3 THEN &apos;B: 2-3&apos;&#13;
    WHEN order_rank BETWEEN 4 AND 5 THEN &apos;C: 4-5&apos;&#13;
    WHEN order_rank BETWEEN 6 AND 9 THEN &apos;D: 6-9&apos;&#13;
    WHEN order_rank BETWEEN 10 AND 15 THEN &apos;E: 10-15&apos;&#13;
    WHEN order_rank BETWEEN 16 AND 30 THEN &apos;F: 16-30&apos;&#13;
    WHEN order_rank BETWEEN 31 AND 100 THEN &apos;G: 31-100&apos;&#13;
    WHEN order_rank &gt;&gt; 100 THEN &apos;H: 100+&apos;&#13;
    ELSE &apos;NA&apos;&#13;
  END AS lifetime_order_count_bins, &#13;
FLOOR(incentivization_rate * 10) / 10 lifetime_incentivization_bins,&#13;
AVG(customer_lifetime_gmv_13_weeks_eur) AS avg_customer_lifetime_gmv_13_weeks_eur ,&#13;
AVG(actual_gmv_13_weeks_eur) AS avg_actual_gmv_13_weeks_eur,&#13;
COUNT(DISTINCT analytical_customer_id) cnt_customers,&#13;
