      <aliases enabled='yes' />
      <column caption='%Unhealthy Orders' datatype='real' name='[Calculation_86131364743573504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_unhealthy]) / SUM([orders_total])' />
      </column>
      <column caption='%Unhealthy Spend' datatype='real' name='[Calculation_86131364743696385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([mkt_dh_contribution_eur_unhealthy]) / SUM([mkt_dh_contribution_eur_total])' />
      </column>
      <column caption='Spend per Order' datatype='real' default-format='c#,##0.00&quot; €&quot;;(#,##0.00&quot; €&quot;)' name='[Calculation_86131364747218946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([mkt_dh_contribution_eur_total]) / SUM([orders_total])' />
      </column>
