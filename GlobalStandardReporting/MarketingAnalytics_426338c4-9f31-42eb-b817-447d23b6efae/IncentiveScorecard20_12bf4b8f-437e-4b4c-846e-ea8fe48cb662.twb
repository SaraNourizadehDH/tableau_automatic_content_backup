    <worksheet name='QC Trials (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='12'>QC Trial incentives and resulting FLGPO</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10' italic='true'>ABV, Avg. MOV</run>
            <run fontcolor='#000000' fontsize='12' italic='true'>²</run>
            <run bold='true' fontcolor='#000000' fontsize='12' italic='true'>Æ </run>
            <run fontcolor='#000000' fontsize='10' italic='true'>, Avg. Incentive amount and FLGPO</run>
            <run fontcolor='#000000' fontsize='12' italic='true'>³</run>
            <run fontcolor='#000000' fontsize='10' italic='true'> (in €) of first QC order</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='DHMA-2712_new_metrics_tableau (Match_Lists)' name='federated.0qrujk50mmd5hr17ocj36000anvx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Frequency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qrujk50mmd5hr17ocj36000anvx'>
            <column caption='Avg. QC Trials MOV' datatype='real' name='[Avg. Acquisition MOV (copy)_982910618892201988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([New Acq Mov Eur (copy)_982910618892505093])/SUM([New cnt acq orders w MOV (copy)_982910618892517382])' />
            </column>
            <column caption='Avg. Basket Value - QC Trials' datatype='real' name='[Avg. Basket Value - Acquisitions (copy)_982910618891141123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_trial_gbv_incentivised])/SUM([cnt_qc_trial_inc_orders])' />
            </column>
            <column caption='Avg. DH-funded Incentive Spend - QC Trials' datatype='real' name='[Avg. DH-funded Incentive Spend - Acquisitions (copy)_982910618893230087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_trial_dh_contribution_eur])/SUM([cnt_qc_trial_inc_orders])' />
            </column>
            <column caption='Avg. FLGPO - QC Trials' datatype='real' name='[Avg. FLGPO - Acquisitions (copy)_982910618893381640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_trial_flgpo_eur])/SUM([cnt_qc_trial_inc_orders])' />
            </column>
            <column caption='Analysis Frequency' datatype='string' datatype-customized='true' name='[Calculation_1343198651782078472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Monthly&apos; THEN STR(YEAR(DATETRUNC(&apos;year&apos;,[year_month]))) +  &apos; - &apos; + STR(MONTH(DATETRUNC(&apos;month&apos;,[year_month]))) &#13;&#10;WHEN &apos;Quarterly&apos; THEN STR(YEAR(DATETRUNC(&apos;year&apos;,[year_month]))) +  &apos; - Q&apos; + STR(QUARTER(DATETRUNC(&apos;quarter&apos;,[year_month]))) &#13;&#10;END' />
            </column>
            <column caption='Avg. FLGPO - Acquisitions' datatype='real' name='[Calculation_917608491919167494]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acq_flgpo_eur])/SUM([cnt_dh_incentivised_acquisitions])' />
            </column>
            <column caption='Avg. DH-funded Incentive Spend - Early Customers' datatype='real' name='[Calculation_917608491931766795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([early_dh_contribution_eur])/SUM([cnt_early_inc_orders])' />
            </column>
            <column caption='New QC Trial Mov Eur' datatype='real' name='[New Acq Mov Eur (copy)_982910618892505093]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [management_entity] IN  (&quot;Talabat&quot;, &quot;Instashop&quot;, &quot;HungerStation&quot;, &quot;Foodpanda Germany&quot;, &quot;Carriage&quot;)&#13;&#10;THEN 0&#13;&#10;ELSE [qc_trial_mov_eur]&#13;&#10;END' />
