                            <zone forceUpdate='true' h='2618' id='207' type-v2='text' w='99022' x='489' y='95643'>
                              <formatted-text>
                                <run fontsize='8' italic='true'>Notes: </run>
                                <run>Æ&#10;</run>
                                <run fontsize='8'>¹ </run>
                                <run fontsize='8' italic='true'>DH-funded spend does not include Delivery fee incentives coming from DPS</run>
                                <run>Æ&#10;</run>
                                <run fontsize='8'>² </run>
                                <run fontsize='8' italic='true'>Avg. MOV is calculated by dividing the sum of MOVs by the number of orders that had an MOV. MOV not available for Talabat and HungerStation</run>
                                <run>Æ&#10;</run>
                                <run fontsize='8'>³  </run>
                                <run fontsize='8' italic='true'>FLGP is imputed for orders where the Lucanet values are not available (usually orders in the last month). For the imputation, the average performance of orders fulfilled by customers in the same entity and the same vertical was used</run>
                                <run>Æ&#10;</run>
                                <run fontsize='8'>⁴ </run>
                                <run fontsize='8' italic='true'>User Segmentation not available before September 2022  and not available for Woowa, HungerStation, FP_SK, HN_DK, TB_SA, PY_NI and PY_VE </run>
                              </formatted-text>
