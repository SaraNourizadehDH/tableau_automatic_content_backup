    <worksheet name='Acq. Incentives (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='12'>Acquisition incentives and resulting FLGPO</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10' italic='true'>ABV, Avg. MOV</run>
            <run fontcolor='#000000' fontsize='12' italic='true'>²</run>
            <run bold='true' fontcolor='#000000' fontsize='12' italic='true'>Æ </run>
            <run fontcolor='#000000' fontsize='10' italic='true'>, Avg. Incentive amount and FLGPO</run>
            <run fontcolor='#000000' fontsize='12' italic='true'>³ </run>
            <run fontcolor='#000000' fontsize='10' italic='true'>(in €) of first order</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='DHMA-2712_new_metrics_tableau (Match_Lists)' name='federated.0qrujk50mmd5hr17ocj36000anvx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Frequency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qrujk50mmd5hr17ocj36000anvx'>
            <column caption='Analysis Frequency' datatype='string' datatype-customized='true' name='[Calculation_1343198651782078472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Monthly&apos; THEN STR(YEAR(DATETRUNC(&apos;year&apos;,[year_month]))) +  &apos; - &apos; + STR(MONTH(DATETRUNC(&apos;month&apos;,[year_month]))) &#13;&#10;WHEN &apos;Quarterly&apos; THEN STR(YEAR(DATETRUNC(&apos;year&apos;,[year_month]))) +  &apos; - Q&apos; + STR(QUARTER(DATETRUNC(&apos;quarter&apos;,[year_month]))) &#13;&#10;END' />
            </column>
            <column caption='Avg. Basket Value - Acquisitions' datatype='real' name='[Calculation_917608491917684739]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acq_gbv_incentivised])/SUM([cnt_dh_incentivised_acquisitions])' />
            </column>
            <column caption='Avg. Acquisition MOV' datatype='real' name='[Calculation_917608491918483460]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_917608492208259089])/SUM([Calculation_917608492208988178])' />
            </column>
            <column caption='Avg. DH-funded Incentive Spend - Acquisitions' datatype='real' name='[Calculation_917608491918876677]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acq_dh_contribution_eur])/SUM([cnt_dh_incentivised_acquisitions])' />
            </column>
            <column caption='Avg. FLGPO - Acquisitions' datatype='real' name='[Calculation_917608491919167494]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acq_flgpo_eur])/SUM([cnt_dh_incentivised_acquisitions])' />
            </column>
            <column caption='New Acq Mov Eur' datatype='real' name='[Calculation_917608492208259089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [management_entity] IN  (&quot;Talabat&quot;, &quot;Instashop&quot;, &quot;HungerStation&quot;, &quot;Foodpanda Germany&quot;, &quot;Carriage&quot;)&#13;&#10;THEN 0&#13;&#10;ELSE [acq_mov_eur]&#13;&#10;END' />
            </column>
            <column caption='New cnt acq orders w MOV' datatype='integer' name='[Calculation_917608492208988178]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [management_entity] IN  (&quot;Talabat&quot;, &quot;Instashop&quot;, &quot;HungerStation&quot;, &quot;Foodpanda Germany&quot;, &quot;Carriage&quot;)&#13;&#10;THEN 0&#13;&#10;ELSE [cnt_acq_orders_w_mov]&#13;&#10;END' />
            </column>
            <column caption='Avg. Acquisition MOV (all orders)' datatype='real' name='[Calculation_917608492234338325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_917608492208259089])/SUM([cnt_incentivised_acquisition_orders_dh])' />
            </column>
            <column caption='Acq Dh Contribution Eur' datatype='real' name='[acq_dh_contribution_eur]' role='measure' type='quantitative' />
            <column caption='Acq Flgpo Eur' datatype='real' name='[acq_flgpo_eur]' role='measure' type='quantitative' />
            <column caption='Acq Gbv Incentivised' datatype='real' name='[acq_gbv_incentivised]' role='measure' type='quantitative' />
