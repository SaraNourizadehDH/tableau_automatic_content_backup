            <column caption='Frequency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qrujk50mmd5hr17ocj36000anvx'>
            <column caption='% of Incentives spent on QC Early' datatype='real' name='[% of Incentives spent on QC Trials (copy)_982910618893852681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_early_dh_contribution_eur])/SUM([mkt_dh_contribution_eur])' />
            </column>
            <column caption='% of Incentivised QC Early' datatype='real' name='[% of Incentivised QC Trials (copy)_982910618894028810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cnt_qc_early_inc_orders])/SUM([cnt_qc_early_orders])' />
            </column>
            <column caption='Analysis Frequency' datatype='string' datatype-customized='true' name='[Calculation_1343198651782078472]' role='dimension' type='nominal'>
