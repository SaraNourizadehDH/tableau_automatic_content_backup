          <datasource-dependencies datasource='federated.0qrujk50mmd5hr17ocj36000anvx'>
            <column caption='% of Incentives spent on Infrequent' datatype='real' name='[% of Incentives spent on QC Early (copy)_982910618895745041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([infrequent_dh_contribution_eur])=0&#13;&#10;THEN NULL&#13;&#10;ELSE  SUM([infrequent_dh_contribution_eur])/SUM([mkt_dh_contribution_eur])&#13;&#10;END' />
            </column>
