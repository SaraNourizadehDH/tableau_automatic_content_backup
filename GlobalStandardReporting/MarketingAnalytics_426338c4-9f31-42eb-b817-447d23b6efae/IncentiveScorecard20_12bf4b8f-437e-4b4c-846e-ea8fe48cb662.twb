    <worksheet name='Dormant'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='12'>Share of incentives</run>
            <run fontcolor='#000000' fontsize='12'>¹</run>
            <run bold='true' fontcolor='#000000' fontsize='12'> on Dormant Reactivation </run>
            <run fontcolor='#000000' fontsize='12'>⁴</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10' italic='true'>DH-Incentivized dormant reactivations (%) and % of incentives spent on DH-funded dormant reactivations</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='DHMA-2712_new_metrics_tableau (Match_Lists)' name='federated.0qrujk50mmd5hr17ocj36000anvx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Frequency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qrujk50mmd5hr17ocj36000anvx'>
            <column caption='% of Incentives spent on Dormant' datatype='real' name='[% of Incentives spent on Infrequent (copy)_982910618899583003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([dormant_dh_contribution_eur])=0&#13;&#10;THEN NULL&#13;&#10;ELSE  SUM([dormant_dh_contribution_eur])/SUM([mkt_dh_contribution_eur])&#13;&#10;END' />
            </column>
            <column caption='% of Incentivised Dormant orders' datatype='real' name='[% of Incentivised Infrequent orders (copy)_982910618899333146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cnt_dormant_inc_orders])/SUM([cnt_dormant_orders])' />
            </column>
            <column caption='Analysis Frequency' datatype='string' datatype-customized='true' name='[Calculation_1343198651782078472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Monthly&apos; THEN STR(YEAR(DATETRUNC(&apos;year&apos;,[year_month]))) +  &apos; - &apos; + STR(MONTH(DATETRUNC(&apos;month&apos;,[year_month]))) &#13;&#10;WHEN &apos;Quarterly&apos; THEN STR(YEAR(DATETRUNC(&apos;year&apos;,[year_month]))) +  &apos; - Q&apos; + STR(QUARTER(DATETRUNC(&apos;quarter&apos;,[year_month]))) &#13;&#10;END' />
            </column>
            <column caption='Cnt Dormant Inc Orders' datatype='integer' name='[cnt_dormant_inc_orders]' role='measure' type='quantitative' />
            <column caption='Cnt Dormant Orders' datatype='integer' name='[cnt_dormant_orders]' role='measure' type='quantitative' />
            <column caption='Dormant Dh Contribution Eur' datatype='real' name='[dormant_dh_contribution_eur]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Existing Lvc Spend' datatype='real' name='[existing_lvc_spend]' role='dimension' type='ordinal' />
            <column caption='Country' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Mkt Dh Contribution Eur' datatype='real' name='[mkt_dh_contribution_eur]' role='measure' type='quantitative' />
            <column caption='New Lvc Spend' datatype='real' name='[new_lvc_spend]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1343198651782078472]' derivation='None' name='[none:Calculation_1343198651782078472:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
