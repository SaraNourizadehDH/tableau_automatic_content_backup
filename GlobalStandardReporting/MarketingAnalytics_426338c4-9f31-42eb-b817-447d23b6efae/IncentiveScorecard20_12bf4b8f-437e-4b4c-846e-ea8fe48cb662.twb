    <worksheet name='Infrequent (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='12'>Infrequent Retention incentives and resulting FLGPO</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10' italic='true'>ABV, Avg. MOV</run>
            <run fontcolor='#000000' fontsize='12' italic='true'>²</run>
            <run bold='true' fontcolor='#000000' fontsize='12' italic='true'>Æ </run>
            <run fontcolor='#000000' fontsize='10' italic='true'>, Avg. Incentive amount and FLGPO</run>
            <run fontcolor='#000000' fontsize='12' italic='true'>³</run>
            <run fontcolor='#000000' fontsize='10' italic='true'> (in €) of infrequent customer orders</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='DHMA-2712_new_metrics_tableau (Match_Lists)' name='federated.0qrujk50mmd5hr17ocj36000anvx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Frequency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qrujk50mmd5hr17ocj36000anvx'>
            <column caption='Avg. Basket Value - Infrequent' datatype='real' name='[Avg. Basket Value - Acquisitions (copy)_982910618898300947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([infrequent_gbv_incentivised])/SUM([cnt_infrequent_inc_orders])' />
            </column>
            <column caption='Avg. DH-funded Incentive Spend - Infrequent' datatype='real' name='[Avg. DH-funded Incentive Spend - QC Early (copy)_982910618899001368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([infrequent_dh_contribution_eur])/SUM([cnt_infrequent_inc_orders])' />
            </column>
            <column caption='Avg. Infrequent MOV' datatype='real' name='[Avg. Dormant MOV (copy)_982910618900422687]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([New QC Trial Mov Eur (copy)_982910618898616341])/SUM([New cnt QC Early orders w MOV (copy)_982910618898468884])' />
            </column>
            <column caption='Avg. FLGPO - Infrequent' datatype='real' name='[Avg. FLGPO - QC Early (copy)_982910618899103769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([infrequent_flgpo_eur])/SUM([cnt_infrequent_inc_orders])' />
            </column>
            <column caption='Analysis Frequency' datatype='string' datatype-customized='true' name='[Calculation_1343198651782078472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Monthly&apos; THEN STR(YEAR(DATETRUNC(&apos;year&apos;,[year_month]))) +  &apos; - &apos; + STR(MONTH(DATETRUNC(&apos;month&apos;,[year_month]))) &#13;&#10;WHEN &apos;Quarterly&apos; THEN STR(YEAR(DATETRUNC(&apos;year&apos;,[year_month]))) +  &apos; - Q&apos; + STR(QUARTER(DATETRUNC(&apos;quarter&apos;,[year_month]))) &#13;&#10;END' />
            </column>
            <column caption='New Infrequent Mov Eur' datatype='real' name='[New QC Trial Mov Eur (copy)_982910618898616341]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [management_entity] IN  (&quot;Talabat&quot;, &quot;Instashop&quot;, &quot;HungerStation&quot;, &quot;Foodpanda Germany&quot;, &quot;Carriage&quot;)&#13;&#10;THEN 0&#13;&#10;ELSE [infrequent_mov_eur]&#13;&#10;END' />
            </column>
            <column caption='New cnt Infrequent orders w MOV' datatype='integer' name='[New cnt QC Early orders w MOV (copy)_982910618898468884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [management_entity] IN  (&quot;Talabat&quot;, &quot;Instashop&quot;, &quot;HungerStation&quot;, &quot;Foodpanda Germany&quot;, &quot;Carriage&quot;)&#13;&#10;THEN 0&#13;&#10;ELSE [cnt_infrequent_orders_w_mov]&#13;&#10;END' />
            </column>
            <column caption='Cnt Infrequent Inc Orders' datatype='integer' name='[cnt_infrequent_inc_orders]' role='measure' type='quantitative' />
            <column caption='Cnt Infrequent Orders W Mov' datatype='integer' name='[cnt_infrequent_orders_w_mov]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Infrequent Dh Contribution Eur' datatype='real' name='[infrequent_dh_contribution_eur]' role='measure' type='quantitative' />
            <column caption='Infrequent Flgpo Eur' datatype='real' name='[infrequent_flgpo_eur]' role='measure' type='quantitative' />
            <column caption='Infrequent Gbv Incentivised' datatype='real' name='[infrequent_gbv_incentivised]' role='measure' type='quantitative' />
            <column caption='Infrequent Mov Eur' datatype='real' name='[infrequent_mov_eur]' role='measure' type='quantitative' />
            <column caption='Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1343198651782078472]' derivation='None' name='[none:Calculation_1343198651782078472:nk]' pivot='key' type='nominal' />
