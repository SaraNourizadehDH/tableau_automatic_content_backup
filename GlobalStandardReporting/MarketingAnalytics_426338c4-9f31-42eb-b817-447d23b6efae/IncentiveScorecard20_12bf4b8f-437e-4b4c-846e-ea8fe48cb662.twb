    <worksheet name='Dormant (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='12'>Reactivation incentives and resulting FLGPO</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10' italic='true'>ABV, Avg. MOV</run>
            <run fontcolor='#000000' fontsize='12' italic='true'>²</run>
            <run bold='true' fontcolor='#000000' fontsize='12' italic='true'>Æ </run>
            <run fontcolor='#000000' fontsize='10' italic='true'>, Avg. Incentive amount and FLGPO</run>
            <run fontcolor='#000000' fontsize='12' italic='true'>³</run>
            <run fontcolor='#000000' fontsize='10' italic='true'> (in €) of reactivation orders</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='DHMA-2712_new_metrics_tableau (Match_Lists)' name='federated.0qrujk50mmd5hr17ocj36000anvx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Frequency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qrujk50mmd5hr17ocj36000anvx'>
            <column caption='Avg. Basket Value - Dormant' datatype='real' name='[Avg. Basket Value - Infrequent (copy)_982910618899931164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dormant_gbv_incentivised])/SUM([cnt_dormant_inc_orders])' />
            </column>
            <column caption='Avg. DH-funded Incentive Spend - Dormant' datatype='real' name='[Avg. DH-funded Incentive Spend - Infrequent (copy)_982910618900647968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dormant_dh_contribution_eur])/SUM([cnt_dormant_inc_orders])' />
            </column>
            <column caption='Avg. FLGPO - Dormant' datatype='real' name='[Avg. FLGPO - Infrequent (copy)_982910618900795425]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dormant_flgpo_eur])/SUM([cnt_dormant_inc_orders])' />
            </column>
            <column caption='Avg. FLGPO - Infrequent' datatype='real' name='[Avg. FLGPO - QC Early (copy)_982910618899103769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([infrequent_flgpo_eur])/SUM([cnt_infrequent_inc_orders])' />
            </column>
            <column caption='Avg. Dormant MOV' datatype='real' name='[Avg. QC Early MOV (copy)_982910618898726934]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([New Infrequent Mov Eur (copy)_982910618900103197])/SUM([New cnt Infrequent orders w MOV (copy)_982910618900209694])' />
            </column>
            <column caption='Analysis Frequency' datatype='string' datatype-customized='true' name='[Calculation_1343198651782078472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Monthly&apos; THEN STR(YEAR(DATETRUNC(&apos;year&apos;,[year_month]))) +  &apos; - &apos; + STR(MONTH(DATETRUNC(&apos;month&apos;,[year_month]))) &#13;&#10;WHEN &apos;Quarterly&apos; THEN STR(YEAR(DATETRUNC(&apos;year&apos;,[year_month]))) +  &apos; - Q&apos; + STR(QUARTER(DATETRUNC(&apos;quarter&apos;,[year_month]))) &#13;&#10;END' />
            </column>
            <column caption='New Dormant Mov Eur' datatype='real' name='[New Infrequent Mov Eur (copy)_982910618900103197]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [management_entity] IN  (&quot;Talabat&quot;, &quot;Instashop&quot;, &quot;HungerStation&quot;, &quot;Foodpanda Germany&quot;, &quot;Carriage&quot;)&#13;&#10;THEN 0&#13;&#10;ELSE [dormant_mov_eur]&#13;&#10;END' />
            </column>
            <column caption='New cnt Dormant orders w MOV' datatype='integer' name='[New cnt Infrequent orders w MOV (copy)_982910618900209694]' role='measure' type='quantitative'>
