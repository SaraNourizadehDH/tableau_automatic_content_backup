    <worksheet name='QC Early'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='12'>Share of incentives</run>
            <run fontcolor='#000000' fontsize='12'>¹</run>
            <run bold='true' fontcolor='#000000' fontsize='12'> on Early QC orders (First 5 QC orders)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10' italic='true'>DH-Incentivized  Early QC orders (%) and % of incentives spent on DH-funded Early QC orders</run>
          </formatted-text>
        </title>
