  <worksheets>
    <worksheet name='ABCs'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='12'>Incentives spent on Low Value Customers⁴ (in EUR mln)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10' italic='true'>DH funded incentives on LVC (%) &amp; Ratio of Incentive Spend between New and Existing LVC (%)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='DHMA-2712_new_metrics_tableau (Match_Lists)' name='federated.0qrujk50mmd5hr17ocj36000anvx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Frequency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qrujk50mmd5hr17ocj36000anvx'>
            <column caption='ABC metric' datatype='real' name='[Calculation_1343198651779330052]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Monthly&apos; THEN SUM([neg_mkt_dh_contribution_eur])/SUM([total_mkt_dh_contribution_eur])&#13;&#10;WHEN &apos;Quarterly&apos; THEN SUM([neg_mkt_dh_contribution_eur_l3m])/SUM([total_mkt_dh_contribution_eur_l3m])&#13;&#10;END' />
            </column>
            <column caption='Analysis Frequency' datatype='string' datatype-customized='true' name='[Calculation_1343198651782078472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Monthly&apos; THEN STR(YEAR(DATETRUNC(&apos;year&apos;,[year_month]))) +  &apos; - &apos; + STR(MONTH(DATETRUNC(&apos;month&apos;,[year_month]))) &#13;&#10;WHEN &apos;Quarterly&apos; THEN STR(YEAR(DATETRUNC(&apos;year&apos;,[year_month]))) +  &apos; - Q&apos; + STR(QUARTER(DATETRUNC(&apos;quarter&apos;,[year_month]))) &#13;&#10;END' />
            </column>
            <column caption='new vs existing spend (in Eur M)' datatype='real' name='[Calculation_1343198652388962334]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Monthly&apos; THEN [total_mkt_dh_contribution_eur (abc_metric_new_vs_existing_old)]/1000000&#13;&#10;WHEN &apos;Quarterly&apos; THEN [total_mkt_dh_contribution_eur_l3m (abc_metric_new_vs_existing_old)]/1000000&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Existing Lvc Spend' datatype='real' name='[existing_lvc_spend]' role='dimension' type='ordinal' />
            <column caption='Country' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Lvc' datatype='string' name='[lvc]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;existing LVC&quot;' value='Existing LVC' />
                <alias key='&quot;new LVC&quot;' value='New LVC' />
              </aliases>
            </column>
            <column caption='Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Neg Mkt Dh Contribution Eur' datatype='real' name='[neg_mkt_dh_contribution_eur]' role='measure' type='quantitative' />
            <column caption='Neg Mkt Dh Contribution Eur L3M' datatype='real' name='[neg_mkt_dh_contribution_eur_l3m]' role='measure' type='quantitative' />
            <column caption='New Lvc Spend' datatype='real' name='[new_lvc_spend]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1343198651782078472]' derivation='None' name='[none:Calculation_1343198651782078472:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
