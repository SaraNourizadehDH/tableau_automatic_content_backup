    <worksheet name='Acq. Incentives'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='12'>Share of incentives</run>
            <run fontcolor='#000000' fontsize='12'>¹</run>
            <run bold='true' fontcolor='#000000' fontsize='12'> on DH-funded acquisitions</run>
