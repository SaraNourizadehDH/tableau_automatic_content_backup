              <calculation class='tableau' formula='SUM([non_hva_targeted_mkt_dh_contribution_eur])/SUM([mkt_dh_contribution_eur])' />
            </column>
            <column caption='Incentivised Acquisitions' datatype='real' name='[Calculation_1343198651778007040]' role='measure' type='quantitative'>
