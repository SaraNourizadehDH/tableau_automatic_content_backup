              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0qrujk50mmd5hr17ocj36000anvx].[usr:Avg. DH-funded Incentive Spend - QC Early (copy)_982910618899001368:qk]&quot;' />
