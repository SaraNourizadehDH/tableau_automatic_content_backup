            <column-instance column='[Avg. DH-funded Incentive Spend - QC Early (copy)_982910618899001368]' derivation='User' name='[usr:Avg. DH-funded Incentive Spend - QC Early (copy)_982910618899001368:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Avg. Dormant MOV (copy)_982910618900422687]' derivation='User' name='[usr:Avg. Dormant MOV (copy)_982910618900422687:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Avg. FLGPO - QC Early (copy)_982910618899103769]' derivation='User' name='[usr:Avg. FLGPO - QC Early (copy)_982910618899103769:qk]' pivot='key' type='quantitative' />
