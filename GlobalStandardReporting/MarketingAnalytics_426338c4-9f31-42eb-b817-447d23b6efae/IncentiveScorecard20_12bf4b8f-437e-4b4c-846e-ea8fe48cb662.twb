          <datasource-dependencies datasource='federated.0qrujk50mmd5hr17ocj36000anvx'>
            <column caption='Avg. Basket Value - QC Early' datatype='real' name='[Avg. Basket Value - QC Trials (copy)_982910618894442507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_early_gbv_incentivised])/SUM([cnt_qc_early_inc_orders])' />
            </column>
            <column caption='Avg. DH-funded Incentive Spend - QC Early' datatype='real' name='[Avg. DH-funded Incentive Spend - QC Trials (copy)_982910618895089679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_early_dh_contribution_eur])/SUM([cnt_qc_early_inc_orders])' />
            </column>
            <column caption='Avg. FLGPO - QC Trials' datatype='real' name='[Avg. FLGPO - Acquisitions (copy)_982910618893381640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_trial_flgpo_eur])/SUM([cnt_qc_trial_inc_orders])' />
            </column>
            <column caption='Avg. FLGPO - QC Early' datatype='real' name='[Avg. FLGPO - QC Trials (copy)_982910618895241232]' role='measure' type='quantitative'>
