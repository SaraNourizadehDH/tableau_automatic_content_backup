            <column-instance column='[new_lvc_spend]' derivation='Sum' name='[sum:new_lvc_spend:qk]' pivot='key' type='quantitative' />
            <column-instance column='[% of Incentives spent on Infrequent (copy)_982910618899583003]' derivation='User' name='[usr:% of Incentives spent on Infrequent (copy)_982910618899583003:qk]' pivot='key' type='quantitative' />
            <column-instance column='[% of Incentivised Infrequent orders (copy)_982910618899333146]' derivation='User' name='[usr:% of Incentivised Infrequent orders (copy)_982910618899333146:qk]' pivot='key' type='quantitative' />
