    <worksheet name='QC Trials'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='12'>Share of incentives</run>
            <run fontcolor='#000000' fontsize='12'>¹</run>
            <run bold='true' fontcolor='#000000' fontsize='12'> on QC Trials</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10' italic='true'>DH-Incentivized QC Trials (%) and % of incentives spent on  DH-funded QC Trials</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
