              <calculation class='tableau' formula='SUM([qc_trial_dh_contribution_eur])/SUM([mkt_dh_contribution_eur])' />
            </column>
            <column caption='% of Incentivised QC Trials' datatype='real' name='[% of Incentivised Acquisitions (copy)_982910618890530818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cnt_qc_trial_inc_orders])/SUM([cnt_qc_trial_orders])' />
            </column>
            <column caption='Analysis Frequency' datatype='string' datatype-customized='true' name='[Calculation_1343198651782078472]' role='dimension' type='nominal'>
