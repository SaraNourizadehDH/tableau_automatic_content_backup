      </column>
      <column caption='HVA - Total' datatype='real' name='[Calculation_1343198651783815177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([acq_mkt_dh_contribution_eur])+&#13;&#10;SUM([early_mkt_dh_contribution_eur])+&#13;&#10;SUM([qc_trial_mkt_dh_contribution_eur])+&#13;&#10;SUM([dormant_reac_mkt_dh_contribution_eur])+&#13;&#10;SUM([qc_early_mkt_dh_contribution_eur]))&#13;&#10;/SUM([mkt_dh_contribution_eur])' />
