      <column caption='Reset All Button' datatype='string' name='[Apply All Button (copy)_5490380533408673801]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Reset All&quot;' />
      </column>
      <column caption='% Plugin Clicked Vendors' datatype='real' name='[Calculation_1031605822665142272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([plugin_clicked_vendors])/SUM([vendors])' />
      </column>
      <column caption='% Order Detail Clicked Vendors' datatype='real' name='[Calculation_1031605822684499979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_details_clicked_vendors])/SUM([vendors])' />
      </column>
      <column caption='% Download Order Report Vendors' datatype='real' name='[Calculation_1031605823045521424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([download_orders_clicked_vendors])/SUM([vendors])' />
      </column>
      <column caption='Time Granularity' datatype='string' name='[Calculation_1134344187971227648]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN 1 THEN&#10;    CASE [date_type]&#10;    WHEN &apos;Daily&apos; THEN STR([created_date_local])&#10;    END&#10;WHEN 2 THEN&#10;    CASE [date_type]&#10;    WHEN &apos;Weekly&apos; THEN STR([week_month])&#10;    END&#10;WHEN 3 THEN&#10;    CASE [date_type]&#10;    WHEN &apos;Monthly&apos; THEN STR([week_month])&#10;    END&#10;END' />
      </column>
      <column caption='check' datatype='boolean' name='[Calculation_1134344187976626179]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1134344187971227648]=[date_type]' />
      </column>
      <column caption='Adoption' datatype='string' name='[Calculation_1134344187990106118]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Adoption Metrics&quot;' />
      </column>
      <column caption='Dimension A' datatype='string' name='[Calculation_1134344188016398343]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Entity ID&apos; THEN [entity_id]&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;&#10;WHEN &apos;Client&apos; THEN [client_name]&#10;WHEN &apos;POS Integration Type&apos; THEN [pos_integration_type]&#10;&#10;//Transmission flow&#10;//WHEN &apos;Delivery Type&apos; THEN [Delivery Type]&#10;//WHEN &apos;Is Preorder?&apos; THEN STR([Is Preorder])&#10;//WHEN &apos;Is Auto-Accept Configured?&apos; THEN STR([is_auto_accept_configured])&#10;&#10;END' />
      </column>
      <column caption='Dimension B' datatype='string' name='[Calculation_1134344188016865288]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Orders - Fails - Dimension A (copy)_5909004253127778306]&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Entity ID&apos; THEN [entity_id]&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;&#10;WHEN &apos;Client&apos; THEN [client_name]&#10;WHEN &apos;POS Integration Type&apos; THEN [pos_integration_type]&#10;&#10;//Transmission flow&#10;//WHEN &apos;Delivery Type&apos; THEN [Delivery Type]&#10;//WHEN &apos;Is Preorder?&apos; THEN STR([Is Preorder])&#10;//WHEN &apos;Is Auto-Accept Configured?&apos; THEN STR([is_auto_accept_configured])&#10;&#10;END' />
      </column>
      <column caption='% Rider Contact Rate' datatype='real' name='[Calculation_2434195638697463808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rider_contacts])/SUM([orders])' />
      </column>
      <column caption='% Customer Contact Rate' datatype='real' name='[Calculation_2434195638697549825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([customer_contacts])/SUM([orders])' />
      </column>
      <column caption='&gt; 1 order?' datatype='boolean' name='[Calculation_2667397635911798785]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [orders]&gt;0 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='% Order Detail Clicked Orders' datatype='real' name='[Calculation_3612942477643784192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([clicked_orders])/SUM([orders])' />
      </column>
      <column caption='Metrics' datatype='real' name='[Calculation_3902369094159556608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN [% Vendor Fail Rate (copy)_4868320897008328704]&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN [% Item Unavailable Fail Rate (copy)_4565524149295542293]&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN[% Vendor Contact Rate (copy)_7010697278586339343]&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN [% Vendor Fail Rate (copy)_4565524149295779862]&#10;WHEN &quot;% Rider Contact Rate&quot; THEN [Calculation_2434195638697463808]&#10;WHEN &quot;% Customer Contact Rate&quot; THEN [Calculation_2434195638697549825]&#10;WHEN &quot;% Order Billing Contact Rate&quot; THEN [%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_4565524149296615449]&#10;WHEN &quot;% Billing Inquiries Contact - Clicked Orders&quot; THEN [Calculation_823243982809722880]&#10;&#10;// % Vendors&#10;WHEN &apos;% Download Order Report Vendors&apos; THEN [Calculation_1031605823045521424]&#10;WHEN &apos;% Order Detail Clicks Vendors&apos; THEN [Calculation_1031605822684499979]&#10;WHEN &apos;% Order Plugin Clicks Vendors&apos; THEN [Calculation_1031605822665142272]&#10;WHEN &apos;% Order Detail Clicked Orders&apos; THEN [Calculation_3612942477643784192]&#10;&#10;//int value&#10;WHEN &apos;# Orders&apos; THEN SUM([orders])&#10;WHEN &apos;# Billing Inquiries Contacts&apos; THEN SUM([billing_contacts])&#10;WHEN &apos;# Order Plugin Clicks&apos; THEN SUM([plugin_clicks])&#10;&#10;&#10;END' />
      </column>
      <column caption='Order Growth sub-text (prior CW)' datatype='string' name='[Calculation_4002503800111595520]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos; vs. prior week (CW &apos; + STR(WEEK(TODAY()) - 2) + &apos;)&apos;' />
      </column>
      <column caption='_int_metrics' datatype='boolean' name='[Calculation_4047962031569936392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;# Orders&apos; THEN TRUE&#10;WHEN &apos;# Billing Inquiries Contacts&apos; THEN TRUE&#10;&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Date STR' datatype='string' name='[Calculation_4474466972988317700]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([created_date_local])' />
      </column>
      <column caption='View As' datatype='string' name='[Calculation_4474466972991692806]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [date_type]&#10;  WHEN &apos;Daily&apos; THEN STR([created_date_local])&#10;  WHEN &apos;Weekly&apos; THEN [week_month]&#10;  WHEN &apos;Monthly&apos; THEN [week_month]&#10;END' />
      </column>
      <column caption='All Orders' datatype='integer' name='[Calculation_4474466973307117583]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])' />
      </column>
      <column caption='_line_break' datatype='integer' name='[Calculation_5365898278712320001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='Apply All Button' datatype='string' name='[Calculation_5490380533401985032]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Apply All&quot;' />
      </column>
      <column caption='ISO Week' datatype='integer' name='[Calculation_5909004253490094125]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='WEEK([created_date_local]-1)' />
      </column>
      <column caption='_user_entitlement' datatype='boolean' name='[Calculation_6747799621875978240]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Order Growth subtext - CW' datatype='string' name='[Calculation_814940434188034048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;CW &apos; + STR(WEEK(TODAY()) - 1)' />
      </column>
      <column caption='Is prev. CW?' datatype='boolean' name='[Calculation_814940434193047553]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='([Calculation_5909004253490094125] = (WEEK(TODAY()) - 1))' />
      </column>
      <column caption='% Billing Contact Rate - Clicked Orders' datatype='real' name='[Calculation_823243982809722880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([billing_contacts_clicked_orders])/SUM([clicked_orders])' />
      </column>
      <column caption='Metric Name' datatype='string' name='[Calculation_868209618038423552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4]' />
      </column>
      <column caption='% Orders cumulative' datatype='real' name='[Orders (copy)_4474466973315518486]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM([Calculation_4474466973307117583]) / TOTAL([Calculation_4474466973307117583])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
