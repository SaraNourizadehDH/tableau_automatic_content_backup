            <column caption='% Billing Contact Rate - Clicked Orders' datatype='real' name='[Calculation_823243982809722880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([billing_contacts_clicked_orders])/SUM([clicked_orders])' />
