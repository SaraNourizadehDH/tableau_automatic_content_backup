      <table>
        <view>
          <datasources>
            <datasource caption='growth_financial_clarity_dashboard_contacts (pa_static)' name='federated.11jehfg0nu6km71fh1uc01f3ra4f' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Contacts - Reasons - Dimension' datatype='string' name='[Orders - Summary - Dimension A (copy)_4002503800819843120]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column alias='Week' caption='Time Granularity' datatype='integer' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='Day' />
                <alias key='2' value='Week' />
                <alias key='3' value='Month' />
              </aliases>
            </column>
            <column caption='Contacts - CR Reasons - Metric' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Contacts&quot;'>
              <calculation class='tableau' formula='&quot;# Contacts&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.11jehfg0nu6km71fh1uc01f3ra4f'>
            <column caption='% Contact Rate - Table' datatype='real' name='[Calculation_3407465708722020357]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([all_contacts])&#10;/&#10;(CASE [Parameters].[Orders - Summary - Dimension A (copy)_4002503800819843120]&#10;WHEN IN (&apos;All&apos;, &apos;Region&apos;, &apos;Country&apos;, &apos;Brand Name&apos;, &apos;Entity ID&apos;, &apos;Vertical Type&apos;) &#10;THEN SUM({ FIXED [Time Granularity - Contact Rate (copy)_4002503800821403700], [Calculation_4002503800820092977]: SUM([orders])})&#10;ELSE SUM({ FIXED [Time Granularity - Contact Rate (copy)_4002503800821403700]: SUM([orders])})&#10;END)' />
            </column>
            <column caption='KPI to Display - CR' datatype='string' name='[Calculation_3407465708727005190]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5]' />
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_4002503800820092977]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Orders - Summary - Dimension A (copy)_4002503800819843120]&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Entity ID&apos; THEN [entity_id]&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;ELSE &apos;All&apos;&#10;END' />
            </column>
            <column caption='CR Table Metric' datatype='real' name='[Calculation_4002503800820768819]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;&#10;WHEN &apos;# Contacts&apos; THEN -1 * SUM([all_contacts])&#10;&#10;WHEN &apos;% Contacts&apos; THEN &#10;SUM([all_contacts]) / SUM({ EXCLUDE [Calculation_4002503800820092977], [contact_reason_l1], [contact_reason_l2], [contact_reason_l3]: SUM([all_contacts])})&#10;&#10;WHEN &apos;% Contact Rate&apos; THEN [Calculation_3407465708722020357]&#10;END' />
            </column>
            <column caption='Date STR' datatype='string' name='[Calculation_4474466972988317700]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([created_date_local])' />
            </column>
            <column caption='Time Granularity - CR Reasons' datatype='string' name='[Time Granularity - Contact Rate (copy)_4002503800821403700]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;  WHEN 1 THEN STR([created_date_local])&#10;  WHEN 2 THEN [created_week]&#10;  WHEN 3 THEN [created_month]&#10;END' />
            </column>
            <column caption='All Contacts' datatype='integer' name='[all_contacts]' role='measure' type='quantitative' />
