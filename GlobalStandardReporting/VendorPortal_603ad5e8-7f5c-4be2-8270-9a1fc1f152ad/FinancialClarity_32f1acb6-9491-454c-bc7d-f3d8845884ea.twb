      <table>
        <view>
          <datasources>
            <datasource caption='growth_financial_clarity_dashboard' name='federated.1ojd7v71vqmhzj0zxnscw0emaozw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Time Granularity' datatype='integer' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='Day' />
                <alias key='2' value='Week' />
                <alias key='3' value='Month' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ojd7v71vqmhzj0zxnscw0emaozw'>
            <column caption='%  Billing Contact Rate   ' datatype='real' default-format='p0.000%' name='[%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_4565524149296615449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([billing_contacts])&#10;    /&#10;    SUM([orders])' />
            </column>
            <column caption='% Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Contact Rate (copy)_7010697278586339343]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([all_contacts])/SUM([orders])' />
            </column>
            <column caption='% Plugin Clicked Vendors' datatype='real' name='[Calculation_1031605822665142272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([plugin_clicked_vendors])/SUM([vendors])' />
            </column>
            <column caption='% Order Detail Clicked Vendors' datatype='real' name='[Calculation_1031605822684499979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_details_clicked_vendors])/SUM([vendors])' />
            </column>
            <column caption='% Download Order Report Vendors' datatype='real' name='[Calculation_1031605823045521424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([download_orders_clicked_vendors])/SUM([vendors])' />
            </column>
            <column caption='Time Granularity' datatype='string' name='[Calculation_1134344187971227648]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN 1 THEN&#10;    CASE [date_type]&#10;    WHEN &apos;Daily&apos; THEN STR([created_date_local])&#10;    END&#10;WHEN 2 THEN&#10;    CASE [date_type]&#10;    WHEN &apos;Weekly&apos; THEN STR([week_month])&#10;    END&#10;WHEN 3 THEN&#10;    CASE [date_type]&#10;    WHEN &apos;Monthly&apos; THEN STR([week_month])&#10;    END&#10;END' />
            </column>
            <column caption='% Order Detail Clicked Orders' datatype='real' name='[Calculation_3612942477643784192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([clicked_orders])/SUM([orders])' />
            </column>
            <column caption='Date STR' datatype='string' name='[Calculation_4474466972988317700]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([created_date_local])' />
            </column>
            <column caption='_line_break' datatype='integer' name='[Calculation_5365898278712320001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='Apply All Button' datatype='string' name='[Calculation_5490380533401985032]' role='dimension' type='nominal'>
