    <worksheet name='Line Chart'>
      <table>
        <view>
          <datasources>
            <datasource caption='growth_financial_clarity_dashboard' name='federated.1ojd7v71vqmhzj0zxnscw0emaozw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Time Granularity' datatype='integer' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='Day' />
                <alias key='2' value='Week' />
                <alias key='3' value='Month' />
              </aliases>
            </column>
            <column caption='Select Metric' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Billing Inquiries Contacts&quot;'>
              <calculation class='tableau' formula='&quot;# Billing Inquiries Contacts&quot;' />
              <aliases>
                <alias key='&quot;\# Orders&quot;' value='# Orders' />
                <alias key='&quot;\% Contact Rate&quot;' value='% Contact Rate' />
                <alias key='&quot;\% Order Billing Contact Rate&quot;' value='% Billing Inquiries Contact Rate' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ojd7v71vqmhzj0zxnscw0emaozw'>
            <column caption='%  Billing Contact Rate   ' datatype='real' default-format='p0.000%' name='[%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_4565524149296615449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([billing_contacts])&#10;    /&#10;    SUM([orders])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_4565524149295542293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Contact Rate (copy)_7010697278586339343]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([all_contacts])/SUM([orders])' />
            </column>
            <column caption='% Vendor Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Fail Rate (copy)_4565524149295779862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_contacts])/SUM([orders])' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_4868320897008328704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Plugin Clicked Vendors' datatype='real' name='[Calculation_1031605822665142272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([plugin_clicked_vendors])/SUM([vendors])' />
            </column>
            <column caption='% Order Detail Clicked Vendors' datatype='real' name='[Calculation_1031605822684499979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_details_clicked_vendors])/SUM([vendors])' />
            </column>
            <column caption='% Download Order Report Vendors' datatype='real' name='[Calculation_1031605823045521424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([download_orders_clicked_vendors])/SUM([vendors])' />
            </column>
            <column caption='Time Granularity' datatype='string' name='[Calculation_1134344187971227648]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN 1 THEN&#10;    CASE [date_type]&#10;    WHEN &apos;Daily&apos; THEN STR([created_date_local])&#10;    END&#10;WHEN 2 THEN&#10;    CASE [date_type]&#10;    WHEN &apos;Weekly&apos; THEN STR([week_month])&#10;    END&#10;WHEN 3 THEN&#10;    CASE [date_type]&#10;    WHEN &apos;Monthly&apos; THEN STR([week_month])&#10;    END&#10;END' />
            </column>
            <column caption='% Rider Contact Rate' datatype='real' name='[Calculation_2434195638697463808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_contacts])/SUM([orders])' />
            </column>
            <column caption='% Customer Contact Rate' datatype='real' name='[Calculation_2434195638697549825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_contacts])/SUM([orders])' />
            </column>
            <column caption='% Order Detail Clicked Orders' datatype='real' name='[Calculation_3612942477643784192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([clicked_orders])/SUM([orders])' />
            </column>
            <column caption='Metrics' datatype='real' name='[Calculation_3902369094159556608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN [% Vendor Fail Rate (copy)_4868320897008328704]&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN [% Item Unavailable Fail Rate (copy)_4565524149295542293]&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN[% Vendor Contact Rate (copy)_7010697278586339343]&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN [% Vendor Fail Rate (copy)_4565524149295779862]&#10;WHEN &quot;% Rider Contact Rate&quot; THEN [Calculation_2434195638697463808]&#10;WHEN &quot;% Customer Contact Rate&quot; THEN [Calculation_2434195638697549825]&#10;WHEN &quot;% Order Billing Contact Rate&quot; THEN [%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_4565524149296615449]&#10;WHEN &quot;% Billing Inquiries Contact - Clicked Orders&quot; THEN [Calculation_823243982809722880]&#10;&#10;// % Vendors&#10;WHEN &apos;% Download Order Report Vendors&apos; THEN [Calculation_1031605823045521424]&#10;WHEN &apos;% Order Detail Clicks Vendors&apos; THEN [Calculation_1031605822684499979]&#10;WHEN &apos;% Order Plugin Clicks Vendors&apos; THEN [Calculation_1031605822665142272]&#10;WHEN &apos;% Order Detail Clicked Orders&apos; THEN [Calculation_3612942477643784192]&#10;&#10;//int value&#10;WHEN &apos;# Orders&apos; THEN SUM([orders])&#10;WHEN &apos;# Billing Inquiries Contacts&apos; THEN SUM([billing_contacts])&#10;WHEN &apos;# Order Plugin Clicks&apos; THEN SUM([plugin_clicks])&#10;&#10;&#10;END' />
            </column>
            <column caption='_int_metrics' datatype='boolean' name='[Calculation_4047962031569936392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;# Orders&apos; THEN TRUE&#10;WHEN &apos;# Billing Inquiries Contacts&apos; THEN TRUE&#10;&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Date STR' datatype='string' name='[Calculation_4474466972988317700]' role='dimension' type='nominal'>
