      <column caption='Bot Execution Time' datatype='real' name='[Calculation_1897282113910206464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(DATEDIFF(&apos;second&apos;,[Started],[Ended]))/3600' />
      </column>
      <column caption='DistinctDays' datatype='integer' name='[Calculation_1897282113911095297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Started Date])*24' />
      </column>
      <column caption='Bot Idle Time' datatype='real' name='[Calculation_1897282113911234562]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1897282113911095297]-SUM([Calculation_1897282113910206464])' />
      </column>
      <column caption='TotalDays' datatype='integer' name='[Calculation_2442780620537151489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Pivot Field Values],[Calculation_6192238414447636480])' />
      </column>
      <column caption='TodayDate' datatype='date' name='[Calculation_2442780620537778178]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY()' />
      </column>
      <column caption='Total Spent Days' datatype='integer' name='[Calculation_2466213412645376000]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Pivot Field Values (Pivot1)],[Calculation_2466213412648349697])' />
      </column>
      <column caption='EndDateNew' datatype='date' name='[Calculation_2466213412648349697]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;MM/dd/yyyy&quot;, if CONTAINS([Pivot Field Names (Pivot1)],&quot;Analysis&quot;) then [Analysis End]&#10;ELSEIF  CONTAINS([Pivot Field Names (Pivot1)],&quot;Development&quot;) then [Development End]&#10;ELSEIF  CONTAINS([Pivot Field Names (Pivot1)],&quot;Solution&quot;) then [Solution End]&#10;ELSEIF CONTAINS([Pivot Field Names (Pivot1)],&quot;Testing&quot;) then [Testing End]&#10;END ))' />
      </column>
      <column caption='EndDate' datatype='date' datatype-customized='true' name='[Calculation_6192238414447636480]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;MM/dd/yyyy&quot;, if CONTAINS([Pivot Field Names],&quot;Analysis&quot;) then [Baseline_Analysis_End]&#10;ELSEIF  CONTAINS([Pivot Field Names],&quot;Solution&quot;) then [Baseline_Solution_End]&#10;ELSEIF CONTAINS([Pivot Field Names],&quot;Testing&quot;) then [Baseline_Testing_End]&#10;ELSEIF CONTAINS([Pivot Field Names],&quot;Live&quot;) then [Baseline_Live_End]&#10;END )) ' />
      </column>
      <column caption='Total Days' datatype='integer' name='[Calculation_6192238414448304129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Pivot Field Values],[Calculation_6192238414447636480])' />
      </column>
      <column caption='Today' datatype='date' datatype-customized='true' name='[Calculation_8264809038063329280]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='TODAY()' />
      </column>
