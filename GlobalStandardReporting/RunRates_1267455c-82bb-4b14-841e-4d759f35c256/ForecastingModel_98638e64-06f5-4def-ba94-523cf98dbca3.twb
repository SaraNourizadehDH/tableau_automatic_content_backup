            <column-instance column='[sub_entity]' derivation='None' name='[none:sub_entity:nk]' pivot='key' type='nominal' />
            <column caption='Ord Yhat' datatype='real' name='[ord_yhat]' role='measure' type='quantitative' />
            <column caption='Segment ' datatype='string' name='[segment]' role='dimension' type='nominal' />
            <column datatype='string' name='[source]' role='dimension' type='nominal' />
            <column caption='Sub Entity' datatype='string' name='[sub_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_293437702452826141]' derivation='User' name='[usr:Calculation_293437702452826141:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.17i2ufa1hb66jp11dzg490mxapkp].[none:Calculation_293437702376075265:nk]' filter-group='3'>
            <groupfilter function='member' level='[none:Calculation_293437702376075265:nk]' member='true' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.17i2ufa1hb66jp11dzg490mxapkp].[none:Calculation_293437702378971141:nk]' context='true' filter-group='16'>
            <groupfilter function='member' level='[none:Calculation_293437702378971141:nk]' member='false' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='quantitative' column='[federated.17i2ufa1hb66jp11dzg490mxapkp].[none:Run Rate Date (copy)_5300947925285093382:qk]' filter-group='12' included-values='all' />
          <filter class='categorical' column='[federated.17i2ufa1hb66jp11dzg490mxapkp].[none:management_entity:nk]' filter-group='8'>
            <groupfilter function='level-members' level='[none:management_entity:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.17i2ufa1hb66jp11dzg490mxapkp].[none:segment:nk]' filter-group='4'>
            <groupfilter function='level-members' level='[none:segment:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.17i2ufa1hb66jp11dzg490mxapkp].[none:sub_entity:nk]' filter-group='9'>
            <groupfilter function='level-members' level='[none:sub_entity:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
