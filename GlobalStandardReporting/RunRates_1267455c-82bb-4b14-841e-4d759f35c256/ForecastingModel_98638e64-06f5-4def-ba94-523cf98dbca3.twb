      <aliases enabled='yes' />
      <column caption='Selected Diff' datatype='string' name='[Calculation_1242360217714880512]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;Actual vs Target&apos;         THEN STR(ROUND(SUM([Calculation_293437702438895640])))&#10;WHEN &apos;Actual vs Target %&apos;       THEN STR(ROUND([Calculation_293437702439047193]*100,1)) + &apos;%&apos;&#10;WHEN &apos;Forecast vs Actual&apos;       THEN STR(ROUND(SUM([Calculation_293437702452723740])))&#10;WHEN &apos;Forecast vs Actual %&apos;     THEN STR(ROUND([Calculation_293437702452826141]*100,1)) + &apos;%&apos;&#10;WHEN &apos;Forecast vs Target&apos;       THEN STR(ROUND(SUM([Calculation_293437702438342678])))&#10;WHEN &apos;Forecast vs Target %&apos;     THEN STR(ROUND([Calculation_293437702438613015]*100,1)) + &apos;%&apos;&#10;// Run rates must NOT be used with the rolling N date diffs!&#10;END' />
      </column>
      <column caption='Regressor Names' datatype='string' name='[Calculation_125960098515152897]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [ord_regressor_names]&#10;WHEN &apos;acquisitions&apos;     THEN [acq_regressor_names]&#10;WHEN &apos;aov_lc&apos;           THEN [aov_regressor_names]&#10;WHEN &apos;gmv_lc&apos;           THEN NULL&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Actual (Prev Year)' datatype='real' name='[Calculation_132996966932877312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [actual_orders_prev_year]&#10;WHEN &apos;acquisitions&apos;     THEN [actual_acquisitions_prev_year]&#10;WHEN &apos;aov_lc&apos;           THEN [actual_aov_lc_prev_year]&#10;WHEN &apos;gmv_lc&apos;           THEN [actual_gmv_lc_prev_year]&#10;ELSE FLOAT(NULL)&#10;END' />
      </column>
      <column caption='Run Rate' datatype='real' name='[Calculation_133630284566827008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF&#10;    [Calculation_133630284577730565]&#10;    THEN&#10;        IF [Calculation_293437702375575552] &lt; 0&#10;            THEN IFNULL([Calculation_293437702438092821],[Calculation_293437702429495306]) //in case previous date&apos;s actuals are not there.&#10;            ELSE [Calculation_293437702429495306]&#10;        END&#10;END' />
      </column>
      <column caption='Run Rate vs Target' datatype='real' name='[Calculation_133630284568428545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_133630284566827008]) - SUM([Calculation_293437702437937172])' />
      </column>
      <column caption='Run Rate vs Target %' datatype='real' default-format='p0.0%' name='[Calculation_133630284568629250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_133630284568428545]) / SUM([Calculation_293437702437937172])' />
      </column>
      <column caption='Same Month Forecast' datatype='boolean' name='[Calculation_133630284577730565]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [ds]) = DATETRUNC(&apos;month&apos;, [Calculation_267260554895929344])' />
      </column>
      <column caption='Complete-Month Actual' datatype='real' name='[Calculation_133630284578902022]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [ds] &lt; DATETRUNC(&apos;month&apos;, TODAY()) THEN [Calculation_293437702438092821] END' />
      </column>
      <column caption='Run Rate vs Complete-Month Actual' datatype='real' name='[Calculation_133630284579921927]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_133630284566827008] - [Calculation_133630284578902022]' />
      </column>
      <column caption='Run Rate vs Complete-Month Actual %' datatype='real' default-format='p0.0%' name='[Calculation_133630284580126728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_133630284579921927])&#10;/&#10;SUM([Calculation_133630284578902022])' />
      </column>
      <column caption='Earliest Target Date' datatype='date' default-format='*YYYY-MM-DD' name='[Calculation_214695082329554944]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MIN([ds])' />
      </column>
      <column caption='Latest Target Date' datatype='date' default-format='*YYYY-MM-DD' name='[Calculation_214695082330275841]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([ds])' />
      </column>
      <column caption='Current Month +3 filter' datatype='boolean' name='[Calculation_2378041394997170176]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;[ds] &lt;= DATEADD(&apos;month&apos;,3,DATETRUNC(&apos;month&apos;,TODAY()))&#10;&#10;THEN TRUE &#10;ELSE FALSE END' />
      </column>
      <column caption='Show Future 1 Month' datatype='boolean' name='[Calculation_2393452147349733376]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [ds] &lt;= DATEADD(&apos;month&apos;,1,TODAY()) THEN TRUE ELSE FALSE END' />
      </column>
      <column aggregation='Sum' caption='M Target Date - FC Date' datatype='real' name='[Calculation_2393452147352301570]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[forecast_date] - DATETRUNC(&apos;month&apos;,[ds])' />
      </column>
      <column caption='Run Rate Date' datatype='datetime' default-format='*YYYY-MM-DD' name='[Calculation_267260554895929344]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;day&apos;,-1,[forecast_date]) //previous day' />
      </column>
      <column caption='Target Date - Model Date' datatype='integer' name='[Calculation_293437702375575552]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Run Rate Date (copy)_5300947925285093382], [ds])' />
      </column>
      <column caption='Model Date In Following N Days' datatype='boolean' name='[Calculation_293437702376075265]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_293437702375575552] &gt;= 0 &#10;AND [Calculation_293437702375575552] &lt; [Parameters].[Parameter 1] &#10;THEN TRUE&#10;ELSE FALSE&#10;END&#10;//for each model date it takes following [Rolling (Following) N Days]' />
      </column>
      <column caption='Today - Model Date' datatype='integer' name='[Calculation_293437702378496004]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Run Rate Date (copy)_5300947925285093382], TODAY())' />
      </column>
      <column caption='Model Date In Last N Days' datatype='boolean' name='[Calculation_293437702378971141]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_293437702378496004] &lt; [Parameters].[Parameter 1] THEN TRUE&#10;ELSE FALSE&#10;END&#10;//last N days should not be in the data because we don&apos;t know following N days actuals for them' />
      </column>
      <column caption='Trend' datatype='real' name='[Calculation_293437702428110856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [ord_trend]&#10;WHEN &apos;acquisitions&apos;     THEN [acq_trend]&#10;WHEN &apos;aov_lc&apos;           THEN [aov_trend]&#10;WHEN &apos;gmv_lc&apos;           THEN [ord_trend] * [aov_trend]&#10;ELSE FLOAT(NULL)&#10;END' />
      </column>
      <column caption='Model Fit' datatype='real' name='[Calculation_293437702429495306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [ord_yhat]&#10;WHEN &apos;acquisitions&apos;     THEN [acq_yhat]&#10;WHEN &apos;aov_lc&apos;           THEN [aov_yhat]&#10;WHEN &apos;gmv_lc&apos;           THEN [ord_yhat] * [aov_yhat]&#10;ELSE FLOAT(NULL)&#10;END' />
      </column>
      <column caption='Yearly' datatype='real' name='[Calculation_293437702429659147]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [ord_yearly]&#10;WHEN &apos;acquisitions&apos;     THEN [acq_yearly]&#10;WHEN &apos;aov_lc&apos;           THEN [aov_yearly]&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Weekly' datatype='real' name='[Calculation_293437702429765644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [ord_weekly]&#10;WHEN &apos;acquisitions&apos;     THEN [acq_weekly]&#10;WHEN &apos;aov_lc&apos;           THEN [aov_weekly]&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Additive Terms' datatype='real' name='[Calculation_293437702429892621]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [ord_additive_terms]&#10;WHEN &apos;acquisitions&apos;     THEN [acq_additive_terms]&#10;WHEN &apos;aov_lc&apos;           THEN [aov_additive_terms]&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Holidays' datatype='real' name='[Calculation_293437702430027790]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [ord_holidays]&#10;WHEN &apos;acquisitions&apos;     THEN [acq_holidays]&#10;WHEN &apos;aov_lc&apos;           THEN [aov_holidays]&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Multiplicative Terms' datatype='real' name='[Calculation_293437702430179343]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [ord_multiplicative_terms]&#10;WHEN &apos;acquisitions&apos;     THEN [acq_multiplicative_terms]&#10;WHEN &apos;aov_lc&apos;           THEN [aov_multiplicative_terms]&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Extra Regressors Additive' datatype='real' name='[Calculation_293437702430334992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [ord_extra_regressors_additive]&#10;WHEN &apos;acquisitions&apos;     THEN [acq_extra_regressors_additive]&#10;WHEN &apos;aov_lc&apos;           THEN [aov_extra_regressors_additive]&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Extra Regressors Multiplicative' datatype='real' name='[Calculation_293437702430515217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [ord_extra_regressors_multiplicative]&#10;WHEN &apos;acquisitions&apos;     THEN [acq_extra_regressors_multiplicative]&#10;WHEN &apos;aov_lc&apos;           THEN [aov_extra_regressors_multiplicative]&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Model Fit Lower' datatype='real' name='[Calculation_293437702432018450]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [ord_yhat_lower]&#10;WHEN &apos;acquisitions&apos;     THEN [acq_yhat_lower]&#10;WHEN &apos;aov_lc&apos;           THEN [aov_yhat_lower]&#10;WHEN &apos;gmv_lc&apos;           THEN [ord_yhat_lower] * [aov_yhat_lower]&#10;ELSE FLOAT(NULL)&#10;END' />
      </column>
      <column caption='Model Fit Upper' datatype='real' name='[Calculation_293437702432124947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [ord_yhat_upper]&#10;WHEN &apos;acquisitions&apos;     THEN [acq_yhat_upper]&#10;WHEN &apos;aov_lc&apos;           THEN [aov_yhat_upper]&#10;WHEN &apos;gmv_lc&apos;           THEN [ord_yhat_upper] * [aov_yhat_upper]&#10;ELSE FLOAT(NULL)&#10;END' />
      </column>
      <column caption='Target' datatype='real' name='[Calculation_293437702437937172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE&#10;    CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;orders&apos;           THEN [target_orders]&#10;    WHEN &apos;acquisitions&apos;     THEN [target_acquisitions]&#10;    WHEN &apos;aov_lc&apos;           THEN [target_gmv_lc] / [target_orders]&#10;    WHEN &apos;gmv_lc&apos;           THEN [target_gmv_lc]&#10;    ELSE FLOAT(NULL)&#10;    END&#10;WHEN&#10;    0 THEN NULL&#10;ELSE&#10;    CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;orders&apos;           THEN [target_orders]&#10;    WHEN &apos;acquisitions&apos;     THEN [target_acquisitions]&#10;    WHEN &apos;aov_lc&apos;           THEN [target_gmv_lc] / [target_orders]&#10;    WHEN &apos;gmv_lc&apos;           THEN [target_gmv_lc]&#10;    ELSE FLOAT(NULL)&#10;    END&#10;END' />
      </column>
      <column caption='Actual' datatype='real' name='[Calculation_293437702438092821]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [actual_orders]&#10;WHEN &apos;acquisitions&apos;     THEN [actual_acquisitions]&#10;WHEN &apos;aov_lc&apos;           THEN [actual_aov_lc]&#10;WHEN &apos;gmv_lc&apos;           THEN [actual_gmv_lc]&#10;ELSE FLOAT(NULL)&#10;END' />
      </column>
      <column caption='Model Fit vs Target' datatype='real' name='[Calculation_293437702438342678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_293437702429495306] - [Calculation_293437702437937172]' />
      </column>
      <column caption='Model Fit vs Target %' datatype='real' default-format='p0.0%' name='[Calculation_293437702438613015]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_293437702438342678])&#10;/&#10;SUM([Calculation_293437702437937172])' />
      </column>
      <column caption='Actual vs Target' datatype='real' name='[Calculation_293437702438895640]' role='measure' type='quantitative'>
