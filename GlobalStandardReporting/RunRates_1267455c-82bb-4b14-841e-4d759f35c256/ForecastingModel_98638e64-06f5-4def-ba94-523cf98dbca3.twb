    <worksheet name='Run Rate Progression by Entity (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run> Run Rate Monthly Breakdown</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='RunRateProgressionbyEntity2' path='/t/GlobalStandardReporting/workbooks/ForecastingModel' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='forecasting_consolidated_daily (cl_intl_markets)' name='federated.17i2ufa1hb66jp11dzg490mxapkp' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Orders' caption='Regressand' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;orders&quot;'>
              <calculation class='tableau' formula='&quot;orders&quot;' />
              <aliases>
                <alias key='&quot;acquisitions&quot;' value='Acquisitions' />
                <alias key='&quot;aov_lc&quot;' value='AOV LC' />
                <alias key='&quot;gmv_lc&quot;' value='GMV LC' />
                <alias key='&quot;orders&quot;' value='Orders' />
              </aliases>
              <desc>
                <formatted-text>
                  <run>Use AOV only on entity+date level. AOV is not usable for run rate or running N dates calculations.</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='View' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Sub Entity &quot;'>
              <calculation class='tableau' formula='&quot;Sub Entity &quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.17i2ufa1hb66jp11dzg490mxapkp'>
            <column caption='Actual (Prev Year)' datatype='real' name='[Calculation_132996966932877312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [actual_orders_prev_year]&#10;WHEN &apos;acquisitions&apos;     THEN [actual_acquisitions_prev_year]&#10;WHEN &apos;aov_lc&apos;           THEN [actual_aov_lc_prev_year]&#10;WHEN &apos;gmv_lc&apos;           THEN [actual_gmv_lc_prev_year]&#10;ELSE FLOAT(NULL)&#10;END' />
            </column>
            <column caption='Run Rate' datatype='real' name='[Calculation_133630284566827008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#10;    [Calculation_133630284577730565]&#10;    THEN&#10;        IF [Calculation_293437702375575552] &lt; 0&#10;            THEN IFNULL([Calculation_293437702438092821],[Calculation_293437702429495306]) //in case previous date&apos;s actuals are not there.&#10;            ELSE [Calculation_293437702429495306]&#10;        END&#10;END' />
            </column>
            <column caption='Same Month Forecast' datatype='boolean' name='[Calculation_133630284577730565]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [ds]) = DATETRUNC(&apos;month&apos;, [Calculation_267260554895929344])' />
            </column>
            <column caption='Complete-Month Actual' datatype='real' name='[Calculation_133630284578902022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [ds] &lt; DATETRUNC(&apos;month&apos;, TODAY()) THEN [Calculation_293437702438092821] END' />
            </column>
            <column caption='Current Month +3 filter' datatype='boolean' name='[Calculation_2378041394997170176]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[ds] &lt;= DATEADD(&apos;month&apos;,3,DATETRUNC(&apos;month&apos;,TODAY()))&#10;&#10;THEN TRUE &#10;ELSE FALSE END' />
            </column>
            <column caption='Run Rate Date' datatype='datetime' default-format='*YYYY-MM-DD' name='[Calculation_267260554895929344]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;,-1,[forecast_date]) //previous day' />
            </column>
            <column caption='Target Date - Model Date' datatype='integer' name='[Calculation_293437702375575552]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Run Rate Date (copy)_5300947925285093382], [ds])' />
            </column>
            <column caption='Model Fit' datatype='real' name='[Calculation_293437702429495306]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [ord_yhat]&#10;WHEN &apos;acquisitions&apos;     THEN [acq_yhat]&#10;WHEN &apos;aov_lc&apos;           THEN [aov_yhat]&#10;WHEN &apos;gmv_lc&apos;           THEN [ord_yhat] * [aov_yhat]&#10;ELSE FLOAT(NULL)&#10;END' />
            </column>
            <column caption='Target' datatype='real' name='[Calculation_293437702437937172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE&#10;    CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;orders&apos;           THEN [target_orders]&#10;    WHEN &apos;acquisitions&apos;     THEN [target_acquisitions]&#10;    WHEN &apos;aov_lc&apos;           THEN [target_gmv_lc] / [target_orders]&#10;    WHEN &apos;gmv_lc&apos;           THEN [target_gmv_lc]&#10;    ELSE FLOAT(NULL)&#10;    END&#10;WHEN&#10;    0 THEN NULL&#10;ELSE&#10;    CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;orders&apos;           THEN [target_orders]&#10;    WHEN &apos;acquisitions&apos;     THEN [target_acquisitions]&#10;    WHEN &apos;aov_lc&apos;           THEN [target_gmv_lc] / [target_orders]&#10;    WHEN &apos;gmv_lc&apos;           THEN [target_gmv_lc]&#10;    ELSE FLOAT(NULL)&#10;    END&#10;END' />
            </column>
            <column caption='Actual' datatype='real' name='[Calculation_293437702438092821]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [actual_orders]&#10;WHEN &apos;acquisitions&apos;     THEN [actual_acquisitions]&#10;WHEN &apos;aov_lc&apos;           THEN [actual_aov_lc]&#10;WHEN &apos;gmv_lc&apos;           THEN [actual_gmv_lc]&#10;ELSE FLOAT(NULL)&#10;END' />
            </column>
            <column caption='View' datatype='string' name='[Calculation_5406430681016373248]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 7] = &apos;Segment&apos; THEN [segment]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Management Entity&apos; THEN [management_entity] &#10;ELSEIF  [Parameters].[Parameter 7] = &apos;Sub Entity &apos; THEN [sub_entity]&#10;END' />
            </column>
            <column caption='Model Date ' datatype='date' default-format='*YYYY-MM-DD' name='[Run Rate Date (copy)_5300947925285093382]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[forecast_date] //model execution date' />
            </column>
            <column caption='Acq Yhat' datatype='real' name='[acq_yhat]' role='measure' type='quantitative' />
            <column caption='Actual Acquisitions' datatype='integer' name='[actual_acquisitions]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Actual Acquisitions Prev Year' datatype='integer' name='[actual_acquisitions_prev_year]' role='dimension' type='quantitative' />
            <column caption='Actual Aov Lc' datatype='real' name='[actual_aov_lc]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Actual Aov Lc Prev Year' datatype='real' name='[actual_aov_lc_prev_year]' role='dimension' type='quantitative' />
            <column caption='Actual Gmv Lc' datatype='real' name='[actual_gmv_lc]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Actual Gmv Lc Prev Year' datatype='real' name='[actual_gmv_lc_prev_year]' role='dimension' type='quantitative' />
            <column caption='Actual Orders' datatype='integer' name='[actual_orders]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Actual Orders Prev Year' datatype='integer' name='[actual_orders_prev_year]' role='dimension' type='quantitative' />
            <column caption='Aov Yhat' datatype='real' name='[aov_yhat]' role='measure' type='quantitative' />
            <column caption='Target Date' datatype='date' default-format='*YYYY-MM-DD' name='[ds]' role='dimension' type='ordinal' />
            <column caption='Forecast Date' datatype='date' default-format='*YYYY-MM-DD' name='[forecast_date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[kind]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2378041394997170176]' derivation='None' name='[none:Calculation_2378041394997170176:nk]' pivot='key' type='nominal' />
