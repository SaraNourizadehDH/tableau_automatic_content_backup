    <worksheet name='Entity Diffs'>
      <table>
        <view>
          <datasources>
            <datasource caption='forecasting_consolidated_daily (cl_intl_markets)' name='federated.17i2ufa1hb66jp11dzg490mxapkp' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='1 week (7d)' caption='Rolling (Following) N Days' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='7'>
              <calculation class='tableau' formula='7' />
              <aliases>
                <alias key='7' value='1 week (7d)' />
                <alias key='28' value='4 weeks (28d)' />
                <alias key='30' value='30 days' />
                <alias key='31' value='31 days' />
                <alias key='84' value='12 weeks (84d)' />
                <alias key='168' value='24 weeks (168d)' />
              </aliases>
            </column>
            <column alias='Orders' caption='Regressand' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;orders&quot;'>
              <calculation class='tableau' formula='&quot;orders&quot;' />
              <aliases>
                <alias key='&quot;acquisitions&quot;' value='Acquisitions' />
                <alias key='&quot;aov_lc&quot;' value='AOV LC' />
                <alias key='&quot;gmv_lc&quot;' value='GMV LC' />
                <alias key='&quot;orders&quot;' value='Orders' />
              </aliases>
              <desc>
                <formatted-text>
                  <run>Use AOV only on entity+date level. AOV is not usable for run rate or running N dates calculations.</run>
                </formatted-text>
              </desc>
            </column>
            <column alias='Model Fit vs Actual %' caption='Diff' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Forecast vs Actual \%&quot;'>
              <calculation class='tableau' formula='&quot;Forecast vs Actual %&quot;' />
              <aliases>
                <alias key='&quot;Actual vs Target&quot;' value='Actual vs Target' />
                <alias key='&quot;Forecast vs Actual&quot;' value='Model Fit vs Actual' />
                <alias key='&quot;Forecast vs Actual \%&quot;' value='Model Fit vs Actual %' />
                <alias key='&quot;Forecast vs Target&quot;' value='Model Fit vs Target' />
                <alias key='&quot;Forecast vs Target \%&quot;' value='Model Fit vs Target %' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.17i2ufa1hb66jp11dzg490mxapkp'>
            <column caption='Selected Diff' datatype='string' name='[Calculation_1242360217714880512]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;Actual vs Target&apos;         THEN STR(ROUND(SUM([Calculation_293437702438895640])))&#10;WHEN &apos;Actual vs Target %&apos;       THEN STR(ROUND([Calculation_293437702439047193]*100,1)) + &apos;%&apos;&#10;WHEN &apos;Forecast vs Actual&apos;       THEN STR(ROUND(SUM([Calculation_293437702452723740])))&#10;WHEN &apos;Forecast vs Actual %&apos;     THEN STR(ROUND([Calculation_293437702452826141]*100,1)) + &apos;%&apos;&#10;WHEN &apos;Forecast vs Target&apos;       THEN STR(ROUND(SUM([Calculation_293437702438342678])))&#10;WHEN &apos;Forecast vs Target %&apos;     THEN STR(ROUND([Calculation_293437702438613015]*100,1)) + &apos;%&apos;&#10;// Run rates must NOT be used with the rolling N date diffs!&#10;END' />
            </column>
            <column caption='Target Date - Model Date' datatype='integer' name='[Calculation_293437702375575552]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Run Rate Date (copy)_5300947925285093382], [ds])' />
            </column>
            <column caption='Model Date In Following N Days' datatype='boolean' name='[Calculation_293437702376075265]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_293437702375575552] &gt;= 0 &#10;AND [Calculation_293437702375575552] &lt; [Parameters].[Parameter 1] &#10;THEN TRUE&#10;ELSE FALSE&#10;END&#10;//for each model date it takes following [Rolling (Following) N Days]' />
            </column>
            <column caption='Today - Model Date' datatype='integer' name='[Calculation_293437702378496004]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Run Rate Date (copy)_5300947925285093382], TODAY())' />
            </column>
            <column caption='Model Date In Last N Days' datatype='boolean' name='[Calculation_293437702378971141]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_293437702378496004] &lt; [Parameters].[Parameter 1] THEN TRUE&#10;ELSE FALSE&#10;END&#10;//last N days should not be in the data because we don&apos;t know following N days actuals for them' />
            </column>
            <column caption='Model Fit' datatype='real' name='[Calculation_293437702429495306]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [ord_yhat]&#10;WHEN &apos;acquisitions&apos;     THEN [acq_yhat]&#10;WHEN &apos;aov_lc&apos;           THEN [aov_yhat]&#10;WHEN &apos;gmv_lc&apos;           THEN [ord_yhat] * [aov_yhat]&#10;ELSE FLOAT(NULL)&#10;END' />
            </column>
            <column caption='Target' datatype='real' name='[Calculation_293437702437937172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE&#10;    CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;orders&apos;           THEN [target_orders]&#10;    WHEN &apos;acquisitions&apos;     THEN [target_acquisitions]&#10;    WHEN &apos;aov_lc&apos;           THEN [target_gmv_lc] / [target_orders]&#10;    WHEN &apos;gmv_lc&apos;           THEN [target_gmv_lc]&#10;    ELSE FLOAT(NULL)&#10;    END&#10;WHEN&#10;    0 THEN NULL&#10;ELSE&#10;    CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;orders&apos;           THEN [target_orders]&#10;    WHEN &apos;acquisitions&apos;     THEN [target_acquisitions]&#10;    WHEN &apos;aov_lc&apos;           THEN [target_gmv_lc] / [target_orders]&#10;    WHEN &apos;gmv_lc&apos;           THEN [target_gmv_lc]&#10;    ELSE FLOAT(NULL)&#10;    END&#10;END' />
            </column>
            <column caption='Actual' datatype='real' name='[Calculation_293437702438092821]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [actual_orders]&#10;WHEN &apos;acquisitions&apos;     THEN [actual_acquisitions]&#10;WHEN &apos;aov_lc&apos;           THEN [actual_aov_lc]&#10;WHEN &apos;gmv_lc&apos;           THEN [actual_gmv_lc]&#10;ELSE FLOAT(NULL)&#10;END' />
            </column>
            <column caption='Model Fit vs Target' datatype='real' name='[Calculation_293437702438342678]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_293437702429495306] - [Calculation_293437702437937172]' />
            </column>
            <column caption='Model Fit vs Target %' datatype='real' default-format='p0.0%' name='[Calculation_293437702438613015]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_293437702438342678])&#10;/&#10;SUM([Calculation_293437702437937172])' />
            </column>
            <column caption='Actual vs Target' datatype='real' name='[Calculation_293437702438895640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_293437702438092821] - [Calculation_293437702437937172]' />
            </column>
            <column caption='Actual vs Target %' datatype='real' default-format='p0.0%' name='[Calculation_293437702439047193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_293437702438895640])&#10;/&#10;SUM([Calculation_293437702437937172])' />
            </column>
            <column caption='Model Fit vs Actual' datatype='real' name='[Calculation_293437702452723740]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_293437702429495306] - [Calculation_293437702438092821]' />
            </column>
            <column caption='Model Fit vs Actual %' datatype='real' default-format='p0.0%' name='[Calculation_293437702452826141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_293437702452723740])&#10;/&#10;SUM([Calculation_293437702438092821])' />
            </column>
            <column caption='Model Date (beginning of period)' datatype='date' default-format='*YYYY-MM-DD' name='[Model Date (copy)_1266004122740961280]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF&#10;[Calculation_293437702376075265] = TRUE&#10;AND&#10;[Calculation_293437702378971141] = FALSE&#10;THEN [Run Rate Date (copy)_5300947925285093382]&#10;END' />
            </column>
            <column caption='Model Date ' datatype='date' default-format='*YYYY-MM-DD' name='[Run Rate Date (copy)_5300947925285093382]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[forecast_date] //model execution date' />
            </column>
            <column caption='Selected Diff Value' datatype='real' name='[Selected Diff (copy)_1242360217722437633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;Actual vs Target&apos;         THEN SUM([Calculation_293437702438895640])&#10;WHEN &apos;Actual vs Target %&apos;       THEN [Calculation_293437702439047193]&#10;WHEN &apos;Forecast vs Actual&apos;       THEN SUM([Calculation_293437702452723740])&#10;WHEN &apos;Forecast vs Actual %&apos;     THEN [Calculation_293437702452826141]&#10;WHEN &apos;Forecast vs Target&apos;       THEN SUM([Calculation_293437702438342678])&#10;WHEN &apos;Forecast vs Target %&apos;     THEN [Calculation_293437702438613015]&#10;// Run rates must NOT be used with the rolling N date diffs!&#10;END' />
            </column>
