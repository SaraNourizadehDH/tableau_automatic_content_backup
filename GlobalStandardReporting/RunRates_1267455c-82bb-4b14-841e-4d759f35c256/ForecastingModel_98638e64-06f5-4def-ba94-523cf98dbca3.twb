            <column-instance column='[Run Rate Date (copy)_5300947925285093382]' derivation='None' name='[none:Run Rate Date (copy)_5300947925285093382:qk]' pivot='key' type='quantitative' />
            <column-instance column='[kind]' derivation='None' name='[none:kind:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
