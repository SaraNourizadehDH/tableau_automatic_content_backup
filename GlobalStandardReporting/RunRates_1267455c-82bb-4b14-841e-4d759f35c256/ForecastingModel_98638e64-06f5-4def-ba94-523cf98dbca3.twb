            <column-instance column='[sub_entity]' derivation='None' name='[none:sub_entity:nk]' pivot='key' type='nominal' />
            <column caption='Ord Yhat' datatype='real' name='[ord_yhat]' role='measure' type='quantitative' />
            <column caption='Segment ' datatype='string' name='[segment]' role='dimension' type='nominal' />
            <column datatype='string' name='[source]' role='dimension' type='nominal' />
            <column caption='Sub Entity' datatype='string' name='[sub_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_132996966932877312]' derivation='Sum' name='[sum:Calculation_132996966932877312:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_133630284566827008]' derivation='Sum' name='[sum:Calculation_133630284566827008:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_133630284578902022]' derivation='Sum' name='[sum:Calculation_133630284578902022:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_293437702429495306]' derivation='Sum' name='[sum:Calculation_293437702429495306:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_293437702437937172]' derivation='Sum' name='[sum:Calculation_293437702437937172:qk]' pivot='key' type='quantitative' />
            <column caption='Target Acquisitions' datatype='real' name='[target_acquisitions]' role='measure' type='quantitative' />
