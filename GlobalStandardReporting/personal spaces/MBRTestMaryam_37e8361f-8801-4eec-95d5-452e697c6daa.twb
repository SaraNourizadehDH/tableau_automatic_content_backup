              <calculation class='tableau' formula='100 *&#10;(&#10;(&#10;SUM(if [date] = DATE([Parameters].[Parameter 1]) THEN [susbcribers_eom] END)&#10;/&#10;SUM(if [date] = DATE([Parameters].[Parameter 1]) THEN [monthly_active_users] END)&#10;)&#10;-&#10;(&#10;SUM(if [date] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [susbcribers_eom] END)&#10;/&#10;SUM(if [date] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [monthly_active_users] END)&#10;)&#10;)' />
