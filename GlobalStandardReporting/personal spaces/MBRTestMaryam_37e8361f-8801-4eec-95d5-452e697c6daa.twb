            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.1ytmb2908uk2mi118qh5006b41lr].[Calculation_2612650762646335488]' caption='Reporting month (p)' datatype='date' default-format='*mmm-yy' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2023-08-01#'>
              <calculation class='tableau' formula='#2023-08-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ytmb2908uk2mi118qh5006b41lr'>
            <column caption='Reporting Month GMV BE' datatype='real' name='[Calculation_1696731205734641666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date]=[Parameters].[Parameter 1] THEN [gmv_be] END)' />
            </column>
            <column caption='Reporting Month GMV vs BE' datatype='real' default-format='p0.0%' name='[Calculation_1696731205734899715]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_3250543426482286629]/[Calculation_1696731205734641666])-1' />
            </column>
            <column caption='Reporting Month Orders BE' datatype='real' name='[Calculation_1696731205735460868]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date]=[Parameters].[Parameter 1] THEN [orders_be] END)' />
            </column>
            <column caption='Reporting Month Orders vs BE' datatype='real' default-format='p0.0%' name='[Calculation_1696731205735788549]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Reporting Month GMV (copy)_3250543426484105254]/[Calculation_1696731205735460868])-1' />
            </column>
            <column caption='Month Date' datatype='date' name='[Calculation_2612650762646335488]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[date]))' />
            </column>
            <column caption='Reporting Month GMV' datatype='real' default-format='*#,##0,,;-#,##0,,' name='[Calculation_3250543426482286629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date]=[Parameters].[Parameter 1] THEN [amt_gmv_eur] END)' />
            </column>
            <column caption='MoM GMV' datatype='real' default-format='p0.0%' name='[Calculation_4134234115488178186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(IF [date]=[Parameters].[Parameter 1] THEN [amt_gmv_eur] END)&#10;-&#10;SUM(if [date] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [amt_gmv_eur]  END )&#10;)&#10;/&#10;SUM(if [date] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [amt_gmv_eur]  END )' />
            </column>
            <column caption='MoM Orders' datatype='real' name='[Calculation_4134234115490357259]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(if [date] = DATE([Parameters].[Parameter 1]) THEN [orders]  END)&#10;-&#10;SUM(if [date] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [orders]  END )&#10;)&#10;/&#10;SUM(if [date] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [orders]  END )' />
