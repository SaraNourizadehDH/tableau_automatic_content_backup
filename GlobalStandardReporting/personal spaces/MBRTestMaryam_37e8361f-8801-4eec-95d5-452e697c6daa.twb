    <worksheet name='Brand management entity level performance'>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_summary_kpis (rl_mkt)' name='federated.1ytmb2908uk2mi118qh5006b41lr' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.1ytmb2908uk2mi118qh5006b41lr].[Calculation_2612650762646335488]' caption='Reporting month (p)' datatype='date' default-format='*mmm-yy' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2023-08-01#'>
              <calculation class='tableau' formula='#2023-08-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ytmb2908uk2mi118qh5006b41lr'>
            <column caption='blank10' datatype='integer' name='[Calculation_1304636562102054920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(null)' />
            </column>
            <column caption='Month Date' datatype='date' name='[Calculation_2612650762646335488]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[date]))' />
            </column>
            <column caption='Management Entity' datatype='string' name='[Calculation_6142346981967892481]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE&#10;[display_name]&#10;WHEN &quot;Yemeksepeti&quot;&#10;THEN &quot;Yemeksepeti&quot;&#10;ELSE [management_entity]&#10;END' />
            </column>
            <column caption='Reporting Month TV healthiness' datatype='real' default-format='p0%' name='[Food TOM (copy)_3261450599532281856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([country]) = 1 THEN&#10;MAX(if [date] = DATE([Parameters].[Parameter 1]) THEN [media_healthiness_tv]END)&#10;END' />
            </column>
            <column caption='Management Entity (copy)' datatype='string' name='[Management Entity (copy)_2933602604879351809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[management_entity]' />
            </column>
            <column caption='MoM Food TOM' datatype='real' name='[MoM Acquisitions (copy)_3250543426468364311]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([country]) = 1 THEN&#10;100&#10;*&#10;(&#10;MAX(&#10;    IF [date] = [Parameters].[Parameter 1] AND [food_tom_mom] &lt;&gt; 0 THEN [food_tom_mom] END&#10;)&#10;)&#10;END' />
            </column>
            <column caption='MoM TV Healthiness' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[MoM Food TOM (copy)_3261450599535357954]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([country]) = 1 THEN&#10;100&#10;*&#10;(&#10;MAX(&#10;    IF [date] = [Parameters].[Parameter 1] AND [media_healthiness_tv_wow] &lt;&gt; 0 THEN [media_healthiness_tv_wow] END&#10;)&#10;)&#10;END' />
            </column>
            <column caption='YoY Preference ' datatype='real' name='[MoM Preference (copy)_3250543426473562144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;AVG(if [date] = DATE([Parameters].[Parameter 1]) THEN [TOM (copy)_3250543426209808395] END)&#10;-&#10;AVG(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [TOM (copy)_3250543426209808395] END)&#10;)&#10;/&#10;AVG(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [TOM (copy)_3250543426209808395] END)' />
            </column>
            <column caption='MoM Preference' datatype='real' name='[MoM TOM (copy)_3250543426469466137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;AVG(if [date] = DATE([Parameters].[Parameter 1]) THEN [TOM (copy)_3250543426209808395] END)&#10;-&#10;AVG(if [date] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [TOM (copy)_3250543426209808395] END)&#10;)&#10;/&#10;AVG(if [date] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [TOM (copy)_3250543426209808395] END)' />
            </column>
            <column caption='MoM OB Healthiness' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[MoM TV Healthiness (copy)_3261450599535525891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([country]) = 1 THEN&#10;100&#10;*&#10;(&#10;MAX(&#10;    IF [date] = [Parameters].[Parameter 1] AND [media_healthiness_ob_wow] &lt;&gt; 0 THEN [media_healthiness_ob_wow] END&#10;)&#10;)&#10;END' />
            </column>
            <column caption='Reporting Month TOM' datatype='real' name='[Reporting Month Sessions (copy)_3250543426847391797]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF COUNTD([country]) = 1 THEN&#13;&#10;MAX(IF [date]=[Parameters].[Parameter 1] THEN [top_of_mind] END)&#13;&#10;END' />
            </column>
            <column caption='Reporting Month Preference' datatype='real' name='[Reporting Month TOM (copy)_3250543426866835512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [date]=[Parameters].[Parameter 1] THEN [TOM (copy)_3250543426209808395] END)' />
            </column>
            <column caption='Preference' datatype='real' name='[TOM (copy)_3250543426209808395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([question]=&quot;Preference&quot;, [survey_result], null)' />
            </column>
            <column caption='Reporting Month OB healthiness' datatype='real' default-format='p0%' name='[TV healthiness (copy)_3261450599534469121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([country]) = 1 THEN&#10;MAX(if [date] = DATE([Parameters].[Parameter 1]) THEN [media_healthiness_ob] END)&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='blank_3' datatype='integer' name='[blank_1 (copy) (copy)_4134234114094931973]' role='measure' type='quantitative'>
