    <worksheet name='Overall Monthly View Target'>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_summary_kpis (rl_mkt)' name='federated.1ytmb2908uk2mi118qh5006b41lr' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.1ytmb2908uk2mi118qh5006b41lr].[Calculation_2612650762646335488]' caption='Reporting month (p)' datatype='date' default-format='*mmm-yy' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2023-08-01#'>
              <calculation class='tableau' formula='#2023-08-01#' />
            </column>
            <column alias='Last 2 months' caption='Months to show' datatype='integer' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='0' value='YTD' />
                <alias key='1' value='Last 2 months' />
                <alias key='2' value='Last 3 months' />
                <alias key='6' value='Last 6 months' />
                <alias key='12' value='Last 12 months' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ytmb2908uk2mi118qh5006b41lr'>
            <column caption='blank11' datatype='integer' name='[Calculation_1103944906314534912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(null)' />
            </column>
            <column caption='Reporting Month MM CAC vs Target' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[Calculation_1103944906318655492]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Reporting Month MM TOM (copy)_3804063974288932878] - [Reporting Month MM CAC (copy)_1103944906318299139]) * 100' />
            </column>
            <column caption='blank10' datatype='integer' name='[Calculation_1304636562102054920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(null)' />
            </column>
            <column aggregation='Sum' caption='Months to show mirror' datatype='integer' name='[Calculation_1745778205977341956]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
            </column>
            <column caption='Month Date' datatype='date' name='[Calculation_2612650762646335488]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[date]))' />
            </column>
            <column caption='Reporting Month GMV' datatype='real' default-format='*#,##0,,;-#,##0,,' name='[Calculation_3250543426482286629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date]=[Parameters].[Parameter 1] THEN [amt_gmv_eur] END)' />
            </column>
            <column caption='Reporting Month Frequency Target - Order / Active 1M' datatype='real' name='[Calculation_588845696395100162]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date]=[Parameters].[Parameter 1] THEN ([orders_target]) END)&#13;&#10;/&#13;&#10;SUM(IF [date]=[Parameters].[Parameter 1] THEN ([monthly_active_users_target]) END)' />
            </column>
            <column caption='Reporting Month Frequency - Order / Active 1M vs Target' datatype='real' default-format='p0.0%' name='[Calculation_588845696397090819]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Reporting month PM CPA (copy)_6020890523113529353] / [Calculation_588845696395100162]) -1' />
            </column>
            <column caption='Reporting Month AOV Target - GMV / Order' datatype='real' name='[Calculation_588845696398929925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Reporting Month GMV (copy)_1048212847078916104]/[Reporting Month GMV target (copy)_1048212847079669769]' />
            </column>
            <column caption='Reporting Month AOV - GMV / Order vs Target' datatype='real' default-format='p0.0%' name='[Calculation_588845696399208454]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Reporting month Frequency - Order / Active 1M  (copy)_6020890523114209292]/ [Calculation_588845696398929925])-1' />
            </column>
            <column caption='Reporting Month CARC Target' datatype='real' name='[Calculation_588845696402063368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date]=[Parameters].[Parameter 1] THEN ABS([carc_target]) END)' />
            </column>
            <column caption='Reporting Month CARC vs Target' datatype='real' default-format='p0.0%' name='[Calculation_588845696402186249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Reporting Month CARC/GMV (copy)_5224034871815741440]/[Calculation_588845696402063368])-1' />
            </column>
            <column caption='Reporting Month CARC/GMV Target' datatype='real' default-format='p0.0%' name='[Calculation_588845696405671946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date]=[Parameters].[Parameter 1] THEN abs([carc_target]) END)&#13;&#10;/&#13;&#10;SUM(IF [date]=[Parameters].[Parameter 1] THEN abs([gmv_target]) END)' />
            </column>
            <column caption='Reporting Month CARC/GMV vs Target' datatype='real' default-format='p0.0%' name='[Calculation_588845696408281099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Reporting Month CPA Paid (copy)_3250543426847825974] - [Calculation_588845696405671946]) * 100' />
            </column>
            <column caption='Reporting Month CPA Target' datatype='real' name='[Calculation_588845696411410445]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS(&#13;&#10;&#13;&#10;(sum(IF [date]=[Parameters].[Parameter 1] THEN ABS([tom_top_of_mind_target]) END)&#13;&#10;+&#13;&#10;sum(IF [date]=[Parameters].[Parameter 1] THEN ABS([cac_target]) END)&#13;&#10;)&#13;&#10;/&#13;&#10;sum(IF [date]=[Parameters].[Parameter 1] THEN [acquisitions_target] END)&#13;&#10;)' />
            </column>
            <column caption='Reporting Month CPA' datatype='real' name='[Calculation_588845696413032463]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS(&#13;&#10;&#13;&#10;(sum(IF [date]=[Parameters].[Parameter 1] THEN ABS([tom_top_of_mind]) END)&#13;&#10;+&#13;&#10;sum(IF [date]=[Parameters].[Parameter 1] THEN ABS([cac]) END)&#13;&#10;)&#13;&#10;/&#13;&#10;sum(IF [date]=[Parameters].[Parameter 1] THEN [acquisitions_calibration_ios14fix] END)&#13;&#10;)' />
            </column>
            <column caption='Reporting Month CPA vs Target' datatype='real' default-format='p0.0%' name='[Calculation_588845696413147152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_588845696413032463]/[Calculation_588845696411410445])-1' />
            </column>
            <column caption='Management Entity' datatype='string' name='[Calculation_6142346981967892481]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE&#10;[display_name]&#10;WHEN &quot;Yemeksepeti&quot;&#10;THEN &quot;Yemeksepeti&quot;&#10;ELSE [management_entity]&#10;END' />
            </column>
            <column caption='Management Entity (copy)' datatype='string' name='[Management Entity (copy)_2933602604879351809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[management_entity]' />
            </column>
            <column caption='Months to display' datatype='boolean' name='[Months to display (copy)_3250543426883694650]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&quot;month&quot;,[date],[Parameters].[Parameter 1])&lt;= [Parameters].[Parameter 3]&#10;AND &#10;DATEDIFF(&quot;month&quot;,[date],[Parameters].[Parameter 1])&gt;= 0' />
            </column>
            <column caption='Reporting Month Acquisition Calibrated iosfix' datatype='real' default-format='*#,##0;-#,##0' name='[Reporting Month CAC (copy)_2165387024591544323]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date]=[Parameters].[Parameter 1] THEN [acquisitions_calibration_ios14fix] END)' />
            </column>
            <column caption='Reporting Month CARC' datatype='real' default-format='*#,##0,;-#,##0,' name='[Reporting Month CARC/GMV (copy)_5224034871815741440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date]=[Parameters].[Parameter 1]&#13;&#10;&#13;&#10;THEN ABS([carc]) END)' />
            </column>
            <column caption='Reporting Month CARC/GMV' datatype='real' default-format='p0.0%' name='[Reporting Month CPA Paid (copy)_3250543426847825974]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date]=[Parameters].[Parameter 1] THEN abs([carc]) END)&#10;/&#10;SUM(IF [date]=[Parameters].[Parameter 1] THEN abs([amt_gmv_eur]) END)' />
            </column>
            <column caption='Reporting Month GMV target' datatype='real' default-format='*#,##0,,;-#,##0,,' name='[Reporting Month GMV (copy)_1048212847078916104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date]=[Parameters].[Parameter 1] THEN [gmv_target] END)' />
            </column>
            <column caption='Reporting Month Orders' datatype='real' name='[Reporting Month GMV (copy)_3250543426484105254]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date]=[Parameters].[Parameter 1] THEN [orders] END)' />
