    <worksheet name='Overall Monthly View YoY'>
      <repository-location id='OverallMonthlyViewYoY' path='/t/GlobalStandardReporting/workbooks/MBRKPIs_16848582092730' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_summary_kpis (rl_mkt)' name='federated.1ytmb2908uk2mi118qh5006b41lr' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.1ytmb2908uk2mi118qh5006b41lr].[Calculation_2612650762646335488]' caption='Reporting month (p)' datatype='date' default-format='*mmm-yy' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2023-08-01#'>
              <calculation class='tableau' formula='#2023-08-01#' />
            </column>
            <column alias='Last 2 months' caption='Months to show' datatype='integer' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='0' value='YTD' />
                <alias key='1' value='Last 2 months' />
                <alias key='2' value='Last 3 months' />
                <alias key='6' value='Last 6 months' />
                <alias key='12' value='Last 12 months' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ytmb2908uk2mi118qh5006b41lr'>
            <column caption='YoY Food TOM Country Performance' datatype='integer' name='[Calculation_1563312065714098176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(null)' />
            </column>
            <column aggregation='Sum' caption='Months to show mirror' datatype='integer' name='[Calculation_1745778205977341956]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
            </column>
            <column caption='Month Date' datatype='date' name='[Calculation_2612650762646335488]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[date]))' />
            </column>
            <column caption='Reporting Month GMV' datatype='real' default-format='*#,##0,,;-#,##0,,' name='[Calculation_3250543426482286629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date]=[Parameters].[Parameter 1] THEN [amt_gmv_eur] END)' />
            </column>
            <column caption='Reporting Month CPA CRM Incentives' datatype='integer' name='[Calculation_3300083030185598979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//z[Reporting Month CRM RMA vouchers]/[Reporting Month Acquisitions CRM RMA]&#10;sum(null)' />
            </column>
            <column caption='blank_1' datatype='integer' name='[Calculation_4134234114094501891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(null)' />
            </column>
            <column caption='Newly Churning Customers' datatype='integer' default-format='*#,##0,;-#,##0,' name='[Calculation_4134234114500407303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([churning_from_acquisition]&#10;+[churning_from_almost_churned]&#10;+[churning_from_reactivated]&#10;+[churning_from_retained])&#10;*(-1)' />
            </column>
            <column caption='Reporting month FLGPO vs subs' datatype='real' name='[Calculation_5301933059618570262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//FLGPO(subs)&#10;(&#10;[MoM FLGPO (vs non-subs) (copy)_5301933059631960089]&#10;-&#10;[Reporting month FLGPO (subs) (copy)_5301933059640041501]&#10;)&#10;/&#10;[Reporting month FLGPO (subs) (copy)_5301933059640041501]' />
            </column>
            <column caption='Reporting Month Frequency (Delivery/Recipient)' datatype='real' name='[Calculation_5439081754060382213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date]=[Parameters].[Parameter 1] THEN [total_delivery] END)&#10;/&#10;SUM(IF [date]=[Parameters].[Parameter 1] THEN [total_recipient] END)' />
            </column>
            <column caption='Customer to Acquired' datatype='real' name='[Calculation_6020890523054374912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[customers_to_acquired]' />
            </column>
            <column caption='Management Entity' datatype='string' name='[Calculation_6142346981967892481]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE&#10;[display_name]&#10;WHEN &quot;Yemeksepeti&quot;&#10;THEN &quot;Yemeksepeti&quot;&#10;ELSE [management_entity]&#10;END' />
            </column>
            <column caption='Management Entity (copy)' datatype='string' name='[Management Entity (copy)_2933602604879351809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[management_entity]' />
            </column>
            <column caption='YoY Acquisitions' datatype='real' default-format='p0.0%' name='[MoM Acquisitions (copy)_3250543426153742338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(if [date] = DATE([Parameters].[Parameter 1]) THEN [acquisitions_calibration_ios14fix]  END)&#10;-&#10;SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [acquisitions_calibration_ios14fix]  END )&#10;)&#10;/&#10;SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [acquisitions_calibration_ios14fix]  END )' />
            </column>
            <column caption='YoY Active Customers' datatype='real' default-format='p0.0%' name='[MoM Active Customers (copy)_3250543426156412933]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(if [date] = DATE([Parameters].[Parameter 1]) THEN [active_customers]  END)&#10;-&#10;SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [active_customers]  END )&#10;)&#10;/&#10;SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [active_customers]  END )' />
            </column>
            <column caption='YoY Automation' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[MoM Automation (copy)_6340012774007783442]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;[Reporting month Reachability (copy)_6340012774007234576]&#10;-&#10;[Reporting month-1 Automation (copy)_5439081754064211978]&#10;)' />
            </column>
            <column caption='YoY CARC' datatype='real' default-format='p0.0%' name='[MoM CARC (copy)_5224034871816941573]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Reporting Month CARC/GMV (copy)_5224034871815741440]&#10;-&#10;[Reporting Month -1 CARC (copy)_5224034871815946242]&#10;)&#10;/&#10;[Reporting Month -1 CARC (copy)_5224034871815946242]' />
            </column>
            <column caption='YoY CARC/GMV' datatype='real' default-format='p0.0%' name='[MoM CARC/GMV (copy)_3250543426815713332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100 *&#10;(&#10;ABS(&#10;SUM(if [date] = DATE([Parameters].[Parameter 1]) THEN [carc] END)&#10;/&#10;SUM(if [date] = DATE([Parameters].[Parameter 1]) THEN [amt_gmv_eur] END)&#10;)&#10;-&#10;ABS(&#10;SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [carc] END)&#10;/&#10;SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [amt_gmv_eur] END)&#10;)&#10;)' />
            </column>
            <column caption='YoY CPA CRM Incentives' datatype='real' default-format='p0.0%' name='[MoM CPA CRM Incentives (copy)_3300083030187491340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Calculation_3300083030185598979]&#10;-&#10;[Reporting Month -1 CPA CRM Incentives (copy)_3300083030187122697]&#10;)&#10;/&#10;[Reporting Month -1 CPA CRM Incentives (copy)_3300083030187122697]' />
            </column>
            <column caption='YoY CPA paid' datatype='real' name='[MoM CPA paid (copy)_3250543426472497181]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-&#10;(&#10;[Reporting Month Acquisitions (copy)_3250543426533961772]&#10;/&#10;[Reporting Month-1 CPA Paid (copy)_5439081754348519458]&#10;)' />
            </column>
            <column caption='YoY Column Name' datatype='string' name='[MoM Column Name (copy)_3250543426152861697]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;YoY&quot;' />
            </column>
            <column caption='Reporting month FLGPO (subs)' datatype='real' name='[MoM FLGPO (vs non-subs) (copy)_5301933059631960089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//FLGPO(subs)&#10;(&#10;sum(if [date] = DATE([Parameters].[Parameter 1]) THEN [flgp_subscribers_eur] END)&#10;/&#10;sum(if [date] = DATE([Parameters].[Parameter 1]) THEN [subscription_orders] END)&#10;)' />
            </column>
            <column caption='YoY FLGPO (vs subs)' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[MoM FLGPO (vs subs) (copy)_5301933059642216486]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;[Calculation_5301933059618570262]&#10;-&#10;IFNULL([Past month FLGPO vs subs (copy)_5301933059641724964], 0)&#10;)' />
            </column>
            <column caption='YoY Frequency (Delivery/Recipient)' datatype='real' default-format='p0.0%' name='[MoM Frequency % (copy)_6340012774006665228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Calculation_5439081754060382213]&#10;-&#10;[Reporting Month-1 Frequency (Delivery/Recipient) (copy)_5439081754061754376]&#10;)&#10;/&#10;[Reporting Month-1 Frequency (Delivery/Recipient) (copy)_5439081754061754376]' />
            </column>
            <column caption='YoY Frequency Uplift' datatype='real' name='[MoM Frequency Uplift (copy)_3078632585562783752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;[Reporting Month Retained Customers (copy)_2165387024599846922]&#10;-&#10;[Reporting Month-1 Frequency Uplift (copy)_5439081754084778005]&#10;)' />
            </column>
            <column caption='YoY GCG Incremental %' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[MoM GCG Incremental % (copy)_6340012774000574468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;[Reporting month FLGPO (subs) (copy)_6340012773998407681]&#10;-&#10;(&#10;    (&#10;        sum(if [date]=DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])  THEN [tg_gmv] END)&#10;        /&#10;        sum(if [date]=DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])  THEN [tg_user] END)&#10;        -&#10;&#10;        sum(if [date]=DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])  THEN [gcg_gmv] END)&#10;        /&#10;        sum(if [date]=DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])  THEN [gcg_user] END)&#10;    )&#10;    * sum(if [date]=DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])  THEN [tg_user] END)&#10;    /&#10;    sum(if [date]=DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])  THEN [tg_gmv] END)&#10;)&#10;)' />
            </column>
