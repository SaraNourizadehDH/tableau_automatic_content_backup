          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Month/YTD (p)' datatype='string' name='[Function (p) (copy)_4855795226906460165]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
