              <calculation class='tableau' formula='100*&#10;(&#10;[Reporting YTD FLGPO (vs non subsc) (copy)_1519261223405924375]&#10;-&#10;[Reporting YTD FLGPU (vs non subsc) (copy)_1519261223406784537]&#10;)' />
