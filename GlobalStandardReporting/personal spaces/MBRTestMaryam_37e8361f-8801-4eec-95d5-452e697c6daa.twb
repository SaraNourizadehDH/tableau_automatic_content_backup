            </column>
            <column caption='YtdoYtd Food TOM' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[MoM TOM (copy)_3250543426473095199]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([country]) = 1 THEN&#13;&#10;&#13;&#10;(&#13;&#10;MAX(if [date] = DATE([Parameters].[Parameter 1]) THEN  [food_tom_mom]  END)&#13;&#10;-&#13;&#10;MAX(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [food_tom_mom]  END )&#13;&#10;)&#13;&#10;END' />
