            </column>
            <column caption='Reporting YTD weighted pre subs frequency 30d before' datatype='real' name='[Reporting YTD weighted current frequency (copy)_968414708792791043]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF(year([date])=year([Parameters].[Parameter 1])&#10;AND &#10;month([date])&lt;=month([Parameters].[Parameter 1]))&#10;THEN&#10;([pre_subs_frequency_30d_before])&#10;*&#10;([subscribers_total_month])&#10;END)&#10;/&#10;sum(IF(year([date])=year([Parameters].[Parameter 1])&#10;AND &#10;month([date])&lt;=month([Parameters].[Parameter 1]))&#10;THEN[subscribers_total_month] END)' />
            </column>
            <column caption='YTDoYTD-1 Subscription Penetration' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[Reporting YTD-1 Subscription Penetration (copy) (copy)_462885635492425754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;[Reporting Month Subscription Penetration (copy)_462885635491700760]&#10;-&#10;[Reporting YTD Subscription Penetration (copy)_462885635492098073]&#10;)' />
            </column>
            <column caption='Reporting YTD-1 weighted pre subs frequency 30d before' datatype='real' name='[Reporting YTD-1 weighted current frequency (copy)_968414708792983556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF(year([date])=year(DATEADD( &quot;year&quot;,-1,[Parameters].[Parameter 1]))&#10;AND &#10;month([date])&lt;=month(DATEADD(&quot;year&quot;,-1,[Parameters].[Parameter 1])))THEN&#10;([pre_subs_frequency_30d_before])&#10;*&#10;([subscribers_total_month])&#10;END)&#10;/&#10;sum(IF(year([date])=year(DATEADD( &quot;year&quot;,-1,[Parameters].[Parameter 1]))&#10;AND &#10;month([date])&lt;=month(DATEADD(&quot;year&quot;,-1,[Parameters].[Parameter 1])))THEN&#10;[subscribers_total_month] END)' />
            </column>
            <column caption='Reporting YTD FLGPO (subs)' datatype='real' name='[Reporting month FLGPO (subs) (copy)_1519261223403335693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//FLGPO(subs)&#10;(&#10;sum(&#10;IF&#10;(&#10;year([date])=year([Parameters].[Parameter 1])&#10;AND &#10;month([date])&lt;=month([Parameters].[Parameter 1])&#10;)&#10;THEN [flgp_subscribers_eur] END)&#10;/&#10;sum(&#10;IF&#10;(&#10;year([date])=year([Parameters].[Parameter 1])&#10;AND &#10;month([date])&lt;=month([Parameters].[Parameter 1])&#10;)&#10;THEN [subscription_orders] END)&#10;)' />
            </column>
            <column caption='Reporting YTD FLGPO (vs non subsc)' datatype='real' default-format='p0.0%' name='[Reporting month FLGPO (vs non subsc.) (copy)_1519261223404105746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Reporting month FLGPO (subs) (copy)_1519261223403335693]&#10;-&#10;[Reporting month weighted FLGPO (non-subs) (copy)_1519261223403675663]&#10;)&#10;/&#10;[Reporting month weighted FLGPO (non-subs) (copy)_1519261223403675663]' />
            </column>
            <column caption='Reporting YTD weighted FLGPO (non-subs)' datatype='real' name='[Reporting month weighted FLGPO (non-subs) (copy)_1519261223403675663]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//Weighted FLGPO (non subs)&#10;(&#10;sum(&#10;    (&#10;IF&#10;(&#10;year([date])=year([Parameters].[Parameter 1])&#10;AND &#10;month([date])&lt;=month([Parameters].[Parameter 1])&#10;)&#10;THEN ([flgp_non_subscribers_eur]/[non_subscription_orders]) END)&#10;    *&#10;    (&#10;IF&#10;(&#10;year([date])=year([Parameters].[Parameter 1])&#10;AND &#10;month([date])&lt;=month([Parameters].[Parameter 1])&#10;)&#10;THEN [subscription_orders] END)&#10;)&#10;/&#10;sum(&#10;IF&#10;(&#10;year([date])=year([Parameters].[Parameter 1])&#10;AND &#10;month([date])&lt;=month([Parameters].[Parameter 1])&#10;)&#10;THEN [subscription_orders] END)&#10;)' />
            </column>
            <column caption='Reporting YTD weighted post subs frequency 30d after' datatype='real' name='[Reporting month weighted current frequency (copy)_968414708791263233]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF(year([date])=year([Parameters].[Parameter 1])&#10;AND &#10;month([date])&lt;=month([Parameters].[Parameter 1]))&#10;THEN&#10;([post_subs_frequency_30d_after])&#10;*&#10;([subscribers_total_month])&#10;END)&#10;/&#10;sum(IF(year([date])=year([Parameters].[Parameter 1])&#10;AND &#10;month([date])&lt;=month([Parameters].[Parameter 1]))&#10;THEN[subscribers_total_month] END)' />
