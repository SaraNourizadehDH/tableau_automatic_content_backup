            <column caption='MoM GCG Incremental %' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[MoM FLGPO (vs subs) (copy)_6340012773999337474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;[Reporting month FLGPO (subs) (copy)_6340012773998407681]&#10;-&#10;(&#10;    (&#10;        sum(if [date]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1])  THEN [tg_gmv] END)&#10;        /&#10;        sum(if [date]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1])  THEN [tg_user] END)&#10;        -&#10;&#10;        sum(if [date]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1])  THEN [gcg_gmv] END)&#10;        /&#10;        sum(if [date]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1])  THEN [gcg_user] END)&#10;    )&#10;    * sum(if [date]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1])  THEN [tg_user] END)&#10;    /&#10;    sum(if [date]=DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1])  THEN [tg_gmv] END)&#10;)&#10;)' />
