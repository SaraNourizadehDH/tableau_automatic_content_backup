              <calculation class='tableau' formula='100*&#10;(&#10;[Reporting month FLGPO (vs non subsc.) (copy)_1519261223404105746]&#10;-&#10;[Reporting YTD FLGPO (vs non subsc) (copy)_1519261223404224531]&#10;)' />
