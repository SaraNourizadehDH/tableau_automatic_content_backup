    <worksheet name='Overall Monthly View'>
      <repository-location id='OverallMonthlyView' path='/t/GlobalStandardReporting/workbooks/MBRKPIs_16848582092730' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_summary_kpis (rl_mkt)' name='federated.1ytmb2908uk2mi118qh5006b41lr' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.1ytmb2908uk2mi118qh5006b41lr].[Calculation_2612650762646335488]' caption='Reporting month (p)' datatype='date' default-format='*mmm-yy' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2023-08-01#'>
              <calculation class='tableau' formula='#2023-08-01#' />
            </column>
            <column alias='Last 2 months' caption='Months to show' datatype='integer' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='0' value='YTD' />
                <alias key='1' value='Last 2 months' />
                <alias key='2' value='Last 3 months' />
                <alias key='6' value='Last 6 months' />
                <alias key='12' value='Last 12 months' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ytmb2908uk2mi118qh5006b41lr'>
            <column caption='% of HVA / Incentives (%)  - duplicate for country view only' datatype='real' default-format='p0.0%' name='[% of HVA / Incentives (%)  (copy)_635289074228162562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;sum([acq_mkt_dh_contribution_eur])&#10;+&#10;sum([early_mkt_dh_contribution_eur])&#10;+&#10;sum([qc_trial_mkt_dh_contribution_eur])&#10;+&#10;sum([qc_early_mkt_dh_contribution_eur])&#10;+&#10;sum([dormant_reac_mkt_dh_contribution_eur])&#10;)&#10;/&#10;SUM([mkt_dh_contribution_eur])' />
            </column>
            <column caption='SUM(ABS([carc]))' datatype='real' name='[Calculation_1215971948045103105]' role='measure' type='quantitative' user:unnamed='Overall Monthly View'>
              <calculation class='tableau' formula='SUM(ABS([carc]))' />
            </column>
            <column aggregation='Sum' caption='Months to show mirror' datatype='integer' name='[Calculation_1745778205977341956]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
            </column>
            <column caption='Month Date' datatype='date' name='[Calculation_2612650762646335488]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[date]))' />
            </column>
            <column caption='Food TOM' datatype='real' default-format='p0%' name='[Calculation_3250543426208997386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([country]) = 1 THEN&#10;MAX([top_of_mind])&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Returned Customers' datatype='integer' default-format='*#,##0,;-#,##0,' name='[Calculation_3250543426212220943]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reactivated_customers])+SUM([almost_churned_customers])' />
            </column>
            <column caption='New subscribers (%)' datatype='real' name='[Calculation_3250543426877595705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([new_subscribers])/sum([monthly_active_users])' />
            </column>
            <column caption='CPA' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_3250543426905010235]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS(sum([tom_top_of_mind])+sum([cac]))/sum([acquisitions_calibration_ios14fix])' />
            </column>
            <column caption='CPA CRM incentives' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[Calculation_3300083030183878656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum([crm_rma_vouchers])/sum([acquisitions_crm_rma])&#10;sum(null)' />
            </column>
            <column caption='QC penetration' datatype='real' name='[Calculation_3696610896938487808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([qc_active_users])/sum([active_customers])' />
            </column>
            <column caption='CARC / GMV' datatype='real' default-format='p0.0%' name='[Calculation_4134234113730387968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ABS([carc]))&#10;/&#10;SUM(ABS([amt_gmv_eur]))' />
            </column>
            <column caption='blank_1' datatype='integer' name='[Calculation_4134234114094501891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(null)' />
            </column>
            <column caption='Newly Churning Customers' datatype='integer' default-format='*#,##0,;-#,##0,' name='[Calculation_4134234114500407303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([churning_from_acquisition]&#10;+[churning_from_almost_churned]&#10;+[churning_from_reactivated]&#10;+[churning_from_retained])&#10;*(-1)' />
            </column>
            <column caption='FLGPU (vs non subsc.)' datatype='real' name='[Calculation_5301933059203690497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[FLGPO (subs) (copy)_5301933059623075863]&#10;-&#10;[Weighted FLGPO (non subs) (copy)_5301933059624468504]&#10;)&#10;/&#10;[Weighted FLGPO (non subs) (copy)_5301933059624468504]' />
            </column>
            <column caption='FLGPO (vs non subsc.)' datatype='real' default-format='p0.0%' name='[Calculation_5301933059204227075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Calculation_5301933059585306641]&#10;-&#10;[Weighted FLGPO (subs) (copy)_5301933059231199242]&#10;)&#10;/&#10;[Weighted FLGPO (subs) (copy)_5301933059231199242]' />
            </column>
            <column caption='Churn (1M) / Subscribers LM' datatype='real' name='[Calculation_5301933059223076869]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([churned_subscribers])/sum([previous_month_subscribers])' />
            </column>
            <column caption='Weighted pre subs frequency 30d before' datatype='real' name='[Calculation_5301933059225972742]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#10;([pre_subs_frequency_30d_before])&#10;*&#10;([subscribers_total_month])&#10;)&#10;/&#10;sum([subscribers_total_month])' />
            </column>
            <column caption='Weighted post subs frequency 30d after' datatype='real' name='[Calculation_5301933059226333191]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;([post_subs_frequency_30d_after])&#10;*&#10;([subscribers_total_month])&#10;)&#10;/&#10;sum([subscribers_total_month])' />
            </column>
            <column caption='Frequency uplift  (%)' datatype='real' name='[Calculation_5301933059226451976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Calculation_5301933059226333191]&#10;-&#10;[Calculation_5301933059225972742]&#10;)&#10;/&#10;ABS([Calculation_5301933059225972742])' />
            </column>
            <column caption='FLGPO (subs)' datatype='real' name='[Calculation_5301933059585306641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([flgp_subscribers_eur])&#10;/&#10;sum([subscription_orders])' />
            </column>
            <column caption='Subscription Penetration' datatype='real' name='[Calculation_5301933059635171354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([susbcribers_eom])&#10;/&#10;sum([monthly_active_users])' />
            </column>
            <column caption='Customer to Acquired' datatype='real' name='[Calculation_6020890523054374912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[customers_to_acquired]' />
            </column>
            <column caption='Frequency - Order / Active 1M ' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6020890523109441543]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM([active_customers])' />
            </column>
            <column caption='AOV (€/ord)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6020890523109945352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_gmv_eur])/SUM([orders])' />
            </column>
            <column caption='Management Entity' datatype='string' name='[Calculation_6142346981967892481]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE&#10;[display_name]&#10;WHEN &quot;Yemeksepeti&quot;&#10;THEN &quot;Yemeksepeti&quot;&#10;ELSE [management_entity]&#10;END' />
            </column>
            <column caption='GCG Incremental GMV %' datatype='real' default-format='p0.0%' name='[Calculation_6340012773995560960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([tg_gmv])/SUM([tg_user]) - SUM([gcg_gmv])/SUM([gcg_user]))&#10;*SUM([tg_user])&#10;/SUM([tg_gmv])' />
            </column>
            <column caption='Frequency (Delivery/Recipient)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6340012774001516549]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_delivery])/SUM([total_recipient])' />
            </column>
            <column caption='Reachability' datatype='real' default-format='p0.0%' name='[Calculation_6340012774002728968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_reachable]) / SUM([total_active_users])' />
            </column>
            <column caption='Automation' datatype='real' default-format='p0.0%' name='[Calculation_6340012774004690953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_delivery_lc])/SUM([total_delivery])' />
            </column>
            <column caption='PM CPA' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6340012774010208275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pm_costs])/SUM([pm_acquisitions])' />
            </column>
            <column caption='PM App Download Gap' datatype='real' default-format='p0.0%' name='[Calculation_6340012774011686934]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([dh_app_downloads])) / ZN(SUM([comp_downloads]))' />
            </column>
            <column caption='Tv Healthiness' datatype='real' default-format='p0%' name='[Calculation_635289076519874577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([country]) = 1 THEN&#13;&#10;MAX([media_healthiness_tv])&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='OB Healthiness' datatype='real' default-format='p0%' name='[Calculation_635289076519993362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([country]) = 1 THEN&#13;&#10;MAX([media_healthiness_ob])&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='QC Incentives/QC GMV' datatype='real' default-format='p0.0%' name='[Calculation_6799239198580502528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_incentives])/SUM([qc_gmv])' />
            </column>
            <column caption='FLGPU (subs)' datatype='real' name='[FLGPO (subs) (copy)_5301933059623075863]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([flgp_subscribers_eur])&#10;/&#10;sum([subscribers_total_month])' />
            </column>
            <column caption='GCG Incremental GMV % - duplicate for country view only ' datatype='real' default-format='p0.0%' name='[GCG Incremental GMV % (copy)_635289074227642369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([tg_gmv])/SUM([tg_user]) - SUM([gcg_gmv])/SUM([gcg_user]))&#10;*SUM([tg_user])&#10;/SUM([tg_gmv])' />
            </column>
            <column caption='Inc Early %' datatype='real' default-format='p0.0%' name='[Inc Acquisition % (copy)_1296825616714625028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([early_mkt_dh_contribution_eur]) / SUM([mkt_dh_contribution_eur])' />
            </column>
            <column caption='% of HVA / Incentives (%) ' datatype='real' default-format='p0.0%' name='[Inc Acquisition % (copy)_3580502473218285568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;sum([acq_mkt_dh_contribution_eur])&#10;+&#10;sum([early_mkt_dh_contribution_eur])&#10;+&#10;sum([qc_trial_mkt_dh_contribution_eur])&#10;+&#10;sum([qc_early_mkt_dh_contribution_eur])&#10;+&#10;sum([dormant_reac_mkt_dh_contribution_eur])&#10;)&#10;/&#10;SUM([mkt_dh_contribution_eur])' />
            </column>
            <column caption='Inc QC Trial %' datatype='real' default-format='p0.0%' name='[Inc Early % (copy)_1296825616714919944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_trial_mkt_dh_contribution_eur]) / SUM([mkt_dh_contribution_eur])' />
            </column>
            <column caption='Inc Reactivation %' datatype='real' default-format='p0.0%' name='[Inc Early % (copy)_1296825616715706384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dormant_reac_mkt_dh_contribution_eur]) / SUM([mkt_dh_contribution_eur])' />
            </column>
            <column caption='Inc % of DH funded incentives on Low Value Customers' datatype='real' default-format='p0.0%' name='[Inc Early % (copy)_1296825616716025876]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([neg_mkt_dh_contribution_eur]) / SUM([total_mkt_dh_contribution_eur])' />
            </column>
            <column caption='Incentives / GMV %' datatype='real' default-format='p0.0%' name='[Inc Early % (copy)_1296825616716677144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM([inc_acquisitions]) +SUM([inc_retention])&#10;)&#10;/ SUM (ABS([amt_gmv_eur]))' />
            </column>
            <column caption='Inc QC Early %' datatype='real' default-format='p0.0%' name='[Inc QC Trial % (copy)_1296825616715337740]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qc_early_mkt_dh_contribution_eur]) / SUM([mkt_dh_contribution_eur])' />
            </column>
            <column caption='MM CRC %' datatype='real' default-format='p0.0%' name='[MM CAC % (copy)_3804063974289109008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([crc])/SUM([carc])' />
