            </column>
            <column caption='YoY CPA paid' datatype='real' name='[MoM CPA paid (copy)_3250543426472497181]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-&#10;(&#10;[Reporting Month Acquisitions (copy)_3250543426533961772]&#10;/&#10;[Reporting Month-1 CPA Paid (copy)_5439081754348519458]&#10;)' />
