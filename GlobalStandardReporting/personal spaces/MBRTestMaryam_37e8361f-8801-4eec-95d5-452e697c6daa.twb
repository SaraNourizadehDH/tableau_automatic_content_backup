            <column caption='YoY Acquisitions' datatype='real' default-format='p0.0%' name='[MoM Acquisitions (copy)_3250543426153742338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(if [date] = DATE([Parameters].[Parameter 1]) THEN [acquisitions_calibration_ios14fix]  END)&#10;-&#10;SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [acquisitions_calibration_ios14fix]  END )&#10;)&#10;/&#10;SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [acquisitions_calibration_ios14fix]  END )' />
            </column>
            <column caption='MoM CPA paid' datatype='real' default-format='p0.0%' name='[MoM Acquisitions (copy)_3250543426457120790]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Reporting Month Acquisitions (copy)_3250543426533961772]&#10;/&#10;[Reporting Month CPA Paid (copy)_5439081754348273697]&#10;)&#10;-1' />
            </column>
            <column caption='MoM CARC/GMV' datatype='real' default-format='p0.0%' name='[MoM Acquisitions (copy)_3250543426810208305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100 *&#10;(&#10;ABS(&#10;SUM(if [date] = DATE([Parameters].[Parameter 1]) THEN [carc] END)&#10;/&#10;SUM(if [date] = DATE([Parameters].[Parameter 1]) THEN [amt_gmv_eur] END)&#10;)&#10;-&#10;ABS(&#10;SUM(if [date] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [carc] END)&#10;/&#10;SUM(if [date] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1]) THEN [amt_gmv_eur] END)&#10;)&#10;)' />
            </column>
            <column caption='YoY CARC' datatype='real' default-format='p0.0%' name='[MoM CARC (copy)_5224034871816941573]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;[Reporting Month CARC/GMV (copy)_5224034871815741440]&#10;-&#10;[Reporting Month -1 CARC (copy)_5224034871815946242]&#10;)&#10;/&#10;[Reporting Month -1 CARC (copy)_5224034871815946242]' />
            </column>
            <column caption='YoY CARC/GMV' datatype='real' default-format='p0.0%' name='[MoM CARC/GMV (copy)_3250543426815713332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100 *&#10;(&#10;ABS(&#10;SUM(if [date] = DATE([Parameters].[Parameter 1]) THEN [carc] END)&#10;/&#10;SUM(if [date] = DATE([Parameters].[Parameter 1]) THEN [amt_gmv_eur] END)&#10;)&#10;-&#10;ABS(&#10;SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [carc] END)&#10;/&#10;SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [amt_gmv_eur] END)&#10;)&#10;)' />
