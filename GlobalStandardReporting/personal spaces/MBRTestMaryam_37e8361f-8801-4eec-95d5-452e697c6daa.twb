        <calculation class='tableau' formula='(&#10;sum(if [date] = DATEADD(&quot;year&quot;, -1, [Parameters].[Parameter 1]) THEN [acq_mkt_dh_contribution_eur] END)&#10;+&#10;sum(if [date] = DATEADD(&quot;year&quot;, -1, [Parameters].[Parameter 1]) THEN [early_mkt_dh_contribution_eur] END)&#10;+&#10;sum(if [date] = DATEADD(&quot;year&quot;, -1, [Parameters].[Parameter 1]) THEN [qc_trial_mkt_dh_contribution_eur] END)&#10;+&#10;sum(if [date] = DATEADD(&quot;year&quot;, -1, [Parameters].[Parameter 1]) THEN [qc_early_mkt_dh_contribution_eur] END)&#10;+&#10;sum(if [date] = DATEADD(&quot;year&quot;, -1, [Parameters].[Parameter 1]) THEN [dormant_reac_mkt_dh_contribution_eur] END)&#10;)&#10;/&#10;sum(if [date] = DATEADD(&quot;year&quot;, -1, [Parameters].[Parameter 1]) THEN [mkt_dh_contribution_eur] END)' />
      </column>
      <column caption='Reporting month-12 Automation' datatype='real' default-format='p0.0%' name='[Reporting month-1 Automation (copy)_5439081754064211978]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;sum(if [date]=DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])  THEN [total_delivery_lc] END)&#10;/&#10;sum(if [date]=DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])  THEN [total_delivery] END)&#10;)' />
      </column>
      <column caption='Reporting month-12 Cross-Sell %' datatype='real' default-format='p0.0%' name='[Reporting month-1 Cross-Sell % (copy)_5439081754079854607]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [qc_trials] END)&#10;/&#10;SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [active_customers]  END)' />
      </column>
      <column caption='Reporting month-12 Incentives / GMV' datatype='real' default-format='p0.0%' name='[Reporting month-1 Incentives / GMV (copy)_5439081754068185101]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [inc_acquisitions] END)&#10;+&#10;SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [inc_retention] END)&#10;)&#10;/&#10;SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [gmv_incentivised_orders] END)' />
      </column>
      <column caption='Reporting month-12 PM 30D Revenue / CPA' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Reporting month-1 PM 30D Revenue / CPA (copy)_5439081754353446952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [revenue_30d] END)&#10;/&#10;[Reporting month-1 PM CPA (copy)_5439081754353549353]' />
      </column>
      <column caption='Reporting month-12 PM CPA' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Reporting month-1 PM CPA (copy)_5439081754353549353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [pm_costs] END)&#10;/&#10;SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [pm_acquisitions] END)' />
      </column>
      <column caption='Reporting month-12 PM RMO iGMV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Reporting month-1 PM RMO iGMV (copy)_1213368298184941570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [igmv_rmo] END)' />
      </column>
      <column caption='Reporting month-12 weighted post subs frequency 30d after' datatype='real' name='[Reporting month-1 weighted current frequency (copy)_5439081754084941846]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN&#10;([post_subs_frequency_30d_after])&#10;*&#10;([subscribers_total_month])&#10;END)&#10;/&#10;SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [subscribers_total_month] END)' />
