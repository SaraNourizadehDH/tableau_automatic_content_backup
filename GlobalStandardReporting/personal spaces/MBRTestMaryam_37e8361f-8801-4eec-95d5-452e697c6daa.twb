            <column caption='Reporting month-12 weighted post subs frequency 30d after' datatype='real' name='[Reporting month-1 weighted current frequency (copy)_5439081754084941846]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN&#10;([post_subs_frequency_30d_after])&#10;*&#10;([subscribers_total_month])&#10;END)&#10;/&#10;SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [subscribers_total_month] END)' />
            </column>
            <column caption='Reporting month-12 weighted pre subs frequency 30d before' datatype='real' name='[Reporting month-1 weighted previous frequency (copy)_5439081754085060631]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN&#10;([pre_subs_frequency_30d_before])&#10;*&#10;([subscribers_total_month])&#10;END)&#10;/&#10;SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [subscribers_total_month] END)' />
            </column>
            <column caption='Reporting month weighted post subs frequency 30d after' datatype='real' name='[Weighted current frequency (copy)_5439081754081693712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [date]=[Parameters].[Parameter 1] THEN&#10;([post_subs_frequency_30d_after])&#10;*&#10;([subscribers_total_month])&#10;END)&#10;/&#10;SUM(IF [date]=[Parameters].[Parameter 1] THEN [subscribers_total_month] END)' />
            </column>
            <column caption='YoY FLGPU (vs subs)' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[YoY FLGPO (vs subs) (copy)_5301933059647754291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*&#10;(&#10;[Reporting month FLGPO vs subs (copy)_5301933059643998251]&#10;-&#10;ifnull([Past year FLGPO vs subs (copy)_5301933059647557682], 0)&#10;)' />
            </column>
            <column caption='YoY New Subscribers %' datatype='real' name='[YoY New Subscribers % (clone) (copy)_3078632585562107911]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100 *&#10;(&#10;(&#10;SUM(if [date] = DATE([Parameters].[Parameter 1]) THEN [new_subscribers] END)&#10;/&#10;SUM(if [date] = DATE([Parameters].[Parameter 1]) THEN [monthly_active_users] END)&#10;)&#10;-&#10;(&#10;SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [new_subscribers] END)&#10;/&#10;SUM(if [date] = DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]) THEN [monthly_active_users] END)&#10;)&#10;)' />
            </column>
