      <aliases enabled='yes' />
      <column caption='Total Responses' datatype='integer' name='[Calculation_6856519336502923264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([response_id])' />
      </column>
      <column caption='Answer Categorized' datatype='string' name='[Calculation_6964605727575232512]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [has_category] = 1 THEN &apos;Yes&apos; &#10;ELSE &apos;No&apos; END' />
      </column>
      <column caption='Assigned Sentiment' datatype='string' name='[Calculation_78883372313010176]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;IFNULL([text_translated_sentiment], &apos;No&apos;) != &apos;No&apos; THEN &apos;Yes&apos;&#10;ELSE &apos;No&apos; END' />
      </column>
      <column caption='SUM Responses' datatype='real' name='[Calculation_78883372321718273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_6856519336502923264])' />
      </column>
      <column caption='NOT NULL What Product Would ...?' datatype='string' name='[Calculation_78883372327723010]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;IFNULL([what_product_would_like_to_add], &apos;No&apos;) != &apos;No&apos; THEN &apos;Yes&apos;&#10;ELSE &apos;No&apos; END' />
      </column>
      <column caption='NOT NULL Is there anything else...?' datatype='string' name='[Calculation_78883372328296451]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;IFNULL([final_answer], &apos;No&apos;) != &apos;No&apos; THEN &apos;Yes&apos;&#10;ELSE &apos;No&apos; END' />
      </column>
