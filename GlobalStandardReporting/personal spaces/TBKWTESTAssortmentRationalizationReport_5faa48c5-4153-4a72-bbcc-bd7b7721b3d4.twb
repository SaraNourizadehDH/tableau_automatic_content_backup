        <view>
          <datasources>
            <datasource caption='_tableau_sku_optimization_scores (rl_dmart)' name='federated.010rk66132xq971f6gqq80zez27o' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.010rk66132xq971f6gqq80zez27o'>
            <column caption='GMV' datatype='real' name='[Calculation_150026164713431040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN &apos;Euro&apos; THEN [gmv_eur] ELSE [gmv_lc] END' />
            </column>
            <column caption='Combined Score (B1+C3B)' datatype='real' name='[Calculation_155233515938582529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(0.5*[Calculation_827043916911669251]) + (0.5*[Customer Risk Score (L3) (copy)_827043916914118676])' />
            </column>
            <column caption='Avg Sales Price' datatype='real' name='[Calculation_155233515939696643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN &apos;Euro&apos; THEN [avg_price_eur] ELSE [avg_price_lc] END' />
            </column>
            <column caption='Front Margin %' datatype='real' name='[Calculation_2980186753056079875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(zn([total_sku_sales_eur_l6Mon]) - zn([cogs_eur]))/zn([total_sku_sales_eur_l6Mon])' />
            </column>
            <column caption='category combined' datatype='string' name='[Calculation_5385601477152006144]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[category_level_one] + [category_level_two] + [category_level_three]' />
            </column>
            <column caption='Max Business Risk Score (L1)' datatype='real' name='[Calculation_827043916911169536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [category_level_one]: MAX([business_kpi]) }' />
            </column>
            <column caption='Importance to Revenue' datatype='real' name='[Calculation_827043916911669251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([business_kpi]/[Calculation_827043916911169536])*100' />
            </column>
            <column caption='Importance to Customers' datatype='real' name='[Customer Risk Score (L3) (copy)_827043916914118676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([sku_category3_trips_fraction_basket]/[Max Cat 3 Trip Fraction (copy)_827043916913201163])*100' />
            </column>
            <column caption='Max Cat 3 Trip Fraction Basket' datatype='real' name='[Max Cat 3 Trip Fraction (copy)_827043916913201163]' role='measure' type='quantitative'>
