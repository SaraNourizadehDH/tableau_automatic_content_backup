    <worksheet name='Contact Rate (Line)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#e15759' fontsize='18'>DAILY CONTACT RATE</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='incentive_fraud_report (rl_cdp)' name='sqlproxy.1i7rg4n1lb5e7518p92rp0204z6n' />
            <datasource caption='incentive_fraud_sizing_report (rl_cdp)' name='sqlproxy.1232it41e4oxan1cipfwx18qepml' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Aggregation' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.1232it41e4oxan1cipfwx18qepml'>
            <column caption='Date Aggregation' datatype='date' name='[Calculation_4039728879549718528]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 2] = &quot;Day&quot;&#10;THEN DATETRUNC(&apos;day&apos;,[date])&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Week&quot;&#10;THEN DATETRUNC(&apos;week&apos;,[date])&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Month&quot;&#10;THEN DATETRUNC(&apos;month&apos;,[date])&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Quarter&quot;&#10;THEN DATETRUNC(&apos;quarter&apos;,[date])&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Year&quot;&#10;THEN DATETRUNC(&apos;year&apos;,[date])&#10;END)' />
            </column>
            <column aggregation='Year' caption='Date' datatype='date' default-type='ordinal' layered='true' name='[date]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.1i7rg4n1lb5e7518p92rp0204z6n'>
            <column caption='Daily Contact Rate' datatype='real' name='[% FP (copy)_6806205697780121600 1]' role='measure' type='quantitative'>
