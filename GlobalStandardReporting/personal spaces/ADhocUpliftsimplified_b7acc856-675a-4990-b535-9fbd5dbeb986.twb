            <column caption='Revenue 1Day' datatype='real' name='[Commission 1Day (copy)_2706170859600891917]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [uplift_window]=&apos;12h&apos; OR [uplift_window]=&apos;1Day&apos; THEN [revenue_eur] END' />
