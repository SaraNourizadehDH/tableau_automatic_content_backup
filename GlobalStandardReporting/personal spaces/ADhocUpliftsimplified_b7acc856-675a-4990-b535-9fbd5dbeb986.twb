    <calculation class='tableau' formula='//((SUM(IF [In Control] = FALSE THEN [Voucher Eur Month] END )/[Target: Receivers]) &\#13;&\#10;//- (SUM(IF [In Control] = TRUE THEN [Voucher Eur Month] END )/[Control: Receivers])) &\#13;&\#10;//* [Target: Receivers]&\#10;&\#10;&\#10;SUM(&\#10;{ FIXED   &\#10;[date],&\#10;[management_entity],&\#10;[country],&\#10;[display_name],&\#10;[campaign_type],&\#10;[campaign_name]:&\#10;((SUM(IF [in_control] = FALSE THEN [voucher_eur_month] END )/[Calculation_919578770525192195]) &\#10;- (SUM(IF [in_control] = TRUE THEN [voucher_eur_month] END )/[Calculation_919578770525470725])) &\#10;* [Calculation_919578770525192195]&\#10;})' />
