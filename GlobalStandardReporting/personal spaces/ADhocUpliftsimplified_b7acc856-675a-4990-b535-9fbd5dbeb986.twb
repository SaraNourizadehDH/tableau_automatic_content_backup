    <calculation class='tableau' formula='CASE [loyalty_status]&\#13;&\#10;    WHEN &apos;Acquisition&apos;                    THEN &apos;Acquisition&apos;&\#13;&\#10;    WHEN &apos;Loyal&apos;                          THEN &apos;Loyal&apos;&\#13;&\#10;    WHEN &apos;Active Steady&apos;                  THEN &apos;Active NL&apos;&\#13;&\#10;    WHEN &apos;Active Frequent&apos;                THEN &apos;Active NL&apos;&\#13;&\#10;    WHEN &apos;Active not Steady nor Frequent&apos; THEN &apos;Active NL&apos;&\#13;&\#10;    WHEN &apos;Churning Loyal&apos;                 THEN &apos;Churn&apos;&\#13;&\#10;    WHEN &apos;Churning Multiple Orders&apos;       THEN &apos;Churn&apos;&\#13;&\#10;    WHEN &apos;Churning 1 Timer&apos;               THEN &apos;Churn&apos;&\#13;&\#10;    WHEN &apos;Inactive Loyal&apos;                 THEN &apos;Inactive&apos;&\#13;&\#10;    WHEN &apos;Inactive Multiple Orders&apos;       THEN &apos;Inactive&apos;&\#13;&\#10;    WHEN &apos;Inactive Churning 1 Timer&apos;      THEN &apos;Inactive&apos;&\#13;&\#10;END' />
