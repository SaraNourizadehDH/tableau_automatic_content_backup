              <calculation class='tableau' formula='//([Target: Voucher Costs] / [Target: Receivers] - [Control: Voucher Costs] / [Control: Receivers]) * [Target: Receivers]&#10;&#10;SUM({INCLUDE [canvas_name] : ([Control: Voucher Costs (copy)] / [Control: Users (copy)] - [Calculation_427982738204729355] / [Calculation_427982738192842757]) * [Control: Users (copy)]})' />
