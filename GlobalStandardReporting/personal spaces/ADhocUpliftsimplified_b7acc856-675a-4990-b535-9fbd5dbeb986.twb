          <datasource-dependencies datasource='sqlproxy.18ddi8n1474ky411hqm0a0ro06fe'>
            <column aggregation='User' caption='Target: % Loyal Receivers' datatype='real' default-format='p0.0%' default-type='quantitative' layered='true' name='[Calculation_1583507885478207498]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='if min([in_control]) = FALSE then [Loyal Receivers (copy)_968273957651783699] END / [Control: Users (copy)]' />
            </column>
            <column aggregation='User' caption='Control: % Loyal Receivers' datatype='real' default-format='p0.0%' default-type='quantitative' layered='true' name='[Calculation_1583507885478436875]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='if min([in_control]) = true then [Loyal Receivers (copy)_968273957651783699] END / [Calculation_427982738192842757]' />
            </column>
            <column aggregation='Sum' caption='Orders (cases)' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_2477261275902283776]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;when 1 then [orders_day]&#10;when 2 then [orders_week]&#10;when 3 then [orders_month]&#10;when 4 then [orders_2months]&#10;when 5 then [orders_3months]&#10;end' />
            </column>
            <column aggregation='Sum' caption='Users (cases)' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_2477261275903102977]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='{ FIXED   &#13;&#10;[date],&#13;&#10;[date_type],&#13;&#10;[Calculation_6017160963953504256],&#13;&#10;[region],&#13;&#10;[management_entity],&#13;&#10;[country],&#13;&#10;[display_name],&#13;&#10;[campaign_type],&#13;&#10;[canvas_name],&#13;&#10;[variation_name],&#10;[expedition_type]:&#13;&#10;case MIN([Parameters].[Parameter 8])&#13;&#10;when 1 then MIN([users_day])&#13;&#10;when 2 then MIN([users_week])&#13;&#10;when 3 then MIN([users_month])&#13;&#10;when 4 then MIN([users_2months])&#13;&#10;when 5 then MIN([users_3months])&#13;&#10;end&#13;&#10;}' />
            </column>
            <column aggregation='Sum' caption='SWITCH: Receivers' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_3773594308397547521]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='{ FIXED   &#13;&#10;[date],&#13;&#10;[date_type],&#13;&#10;[Calculation_6017160963953504256],&#13;&#10;[region],&#13;&#10;[management_entity],&#13;&#10;[country],&#13;&#10;[display_name],&#13;&#10;[campaign_type],&#13;&#10;[canvas_name],&#13;&#10;[variation_name]:&#13;&#10;case min([Parameters].[Parameter 9])&#13;&#10;when 1 then min([receivers_external_id])&#13;&#10;when 2 then min([receivers])&#13;&#10;end&#13;&#10;}' />
            </column>
            <column aggregation='User' caption='Control: Orders' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_427982738192322564]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='sum(&#10;if [in_control] = true &#10;then [Calculation_2477261275902283776]&#10;end &#10;)' />
            </column>
            <column aggregation='User' caption='Control: Receivers' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_427982738192842757]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='SUM({ FIXED   &#13;&#10;[date],&#13;&#10;[date_type],&#13;&#10;[Calculation_6017160963953504256],&#13;&#10;[region],&#13;&#10;[management_entity],&#13;&#10;[country],&#13;&#10;[display_name],&#13;&#10;[campaign_type],&#13;&#10;[canvas_name],&#13;&#10;[variation_name]:&#13;&#10;case min([in_control])&#13;&#10;when true then min([Calculation_3773594308397547521])&#13;&#10;end&#13;&#10;})' />
            </column>
            <column aggregation='User' caption='Control: Orders Per Receiver' datatype='real' default-format='n#,##0.00;-#,##0.00' default-type='quantitative' layered='true' name='[Calculation_427982738193100807]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='[Calculation_427982738192322564] &#10;/ &#10;[Calculation_427982738192842757]' />
            </column>
            <column aggregation='User' caption='Target: Orders Per Receiver' datatype='real' default-format='n#,##0.00;-#,##0.00' default-type='quantitative' layered='true' name='[Calculation_427982738193240072]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='[Control: Orders (copy)]&#10;/&#10;[Control: Users (copy)]' />
            </column>
            <column aggregation='User' caption='Incremental Orders' datatype='real' default-format='n#,##0;-#,##0' default-type='quantitative' layered='true' name='[Calculation_427982738193461257]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='//([Target: Orders Per Receiver] - [Control: Orders Per Receiver]) * [Target: Receivers]&#10;&#10;SUM({INCLUDE [canvas_name] : ([Calculation_427982738193240072] - [Calculation_427982738193100807]) * [Control: Users (copy)]})' />
            </column>
            <column aggregation='Count' caption='Clean Canvases  Filter' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_4355966027353235470]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
              <calculation class='tableau' formula='CONTAINS(LOWER([canvas_name]),&apos;controlgroup&apos;) &#10;OR CONTAINS(LOWER([canvas_name]),&apos;educational&apos;)&#10;OR CONTAINS(LOWER([canvas_name]),&apos;-survey-&apos;)&#10;OR ISNULL({FIXED [canvas_name] : [Control: Users (copy)]}) &#10;OR {FIXED [canvas_name] : [Control: Users (copy)]} &lt; 1&#10;OR [canvas_name] = &apos;2101XX_APAC_FP_EG_YearlyPersonalized2020_Canvas&apos;&#10;OR CONTAINS(LOWER([canvas_name]),&apos;probot&apos;) &#10;    AND NOT(CONTAINS(LOWER([canvas_name]),&apos;probot-globalcg&apos;))&#10;OR CONTAINS([canvas_name],&apos;NPS&apos;)&#10;OR CONTAINS([canvas_name],&apos;_VertiBot&apos;)&#10;OR CONTAINS([canvas_name],&apos;_Challenge&apos;)' />
            </column>
