country],&#10;[display_name],&#10;[campaign_type],&#10;[campaign_name]: [Calculation_941252330474115083]} &gt;= 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;positive&quot;&#10;    ELSE &quot;CG too small&quot;&#10;    END&#10;END' />
