              <calculation class='tableau' formula='//IF MIN([Date Range]) &gt; 14 THEN&#10;//((SUM(IF [In Control] = FALSE THEN [Orders Month] END )/[Target: Receivers]) &#10;//- (SUM(IF [In Control] = TRUE THEN [Orders Month] END )/[Control: Receivers]))&#10;//END&#10;&#10;[30d Incremental Orders (copy)_1663798598740070411]/[FIXED Control: Receivers (copy)_4826381097263513619]' />
