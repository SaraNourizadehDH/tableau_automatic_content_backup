    <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&\#10;when 1 then [voucher_eur_day]&\#10;when 2 then [voucher_eur_week]&\#10;when 3 then [voucher_eur_2weeks]&\#10;when 4 then [voucher_eur_month]&\#10;when 5 then [voucher_eur_2months]&\#10;when 6 then [voucher_eur_3months]&\#10;end' />
