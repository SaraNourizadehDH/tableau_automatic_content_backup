            <column aggregation='User' caption='Orders Per Receiver' datatype='real' default-format='n#,##0.00;-#,##0.00' default-type='quantitative' layered='true' name='[Calculation_5376242445508902912]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='sum(IFNULL([Calculation_2477261275902283776],0)) &#10;/ &#10;sum(IFNULL([Calculation_3773594308397547521],0))' />
