              <calculation class='tableau' formula='CONTAINS(LOWER([canvas_name]),&apos;controlgroup&apos;) &#10;OR CONTAINS(LOWER([canvas_name]),&apos;educational&apos;)&#10;OR CONTAINS(LOWER([canvas_name]),&apos;-survey-&apos;)&#10;OR ISNULL({FIXED [canvas_name] : [Control: Users (copy)]}) &#10;OR {FIXED [canvas_name] : [Control: Users (copy)]} &lt; 1&#10;OR [canvas_name] = &apos;2101XX_APAC_FP_EG_YearlyPersonalized2020_Canvas&apos;&#10;OR CONTAINS(LOWER([canvas_name]),&apos;probot&apos;) &#10;    AND NOT(CONTAINS(LOWER([canvas_name]),&apos;probot-globalcg&apos;))&#10;OR CONTAINS([canvas_name],&apos;NPS&apos;)&#10;OR CONTAINS([canvas_name],&apos;_VertiBot&apos;)&#10;OR CONTAINS([canvas_name],&apos;_Challenge&apos;)' />
