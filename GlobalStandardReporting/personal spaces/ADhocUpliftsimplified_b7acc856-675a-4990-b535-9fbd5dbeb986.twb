              <calculation class='tableau' formula='[Incremental Activation (FIXED logic) (copy 3)]/[Control: Users (copy 2)_2179038590000627712]&#10;//(sum(if [In Control] = false then [Users (cases)] end ) / [Target: Receivers] - [Control: Users] / [Control: Receivers]) / ([Control: Users] / [Control: Receivers])' />
