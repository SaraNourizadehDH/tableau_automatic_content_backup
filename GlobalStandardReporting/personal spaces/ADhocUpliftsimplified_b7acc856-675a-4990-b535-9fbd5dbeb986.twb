  <column aggregation='User' caption='Orders Norm 2Months' datatype='real' default-type='quantitative' name='[Orders per Activations 2Months (copy)_114771466780151831]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = 1 THEN &\#10;SUM([orders_2months])/60&\#10;ELSE&\#10;SUM([orders_2months])/60/SUM([orders_day])*100&\#10;END' />
  </column>
  <column aggregation='User' caption='Orders Norm 3Months' datatype='real' default-type='quantitative' name='[Orders per Activations 3Months (copy)_114771466780241944]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = 1 THEN &\#10;SUM([orders_3months])/90&\#10;ELSE&\#10;SUM([orders_3months])/90/SUM([orders_day])*100&\#10;END' />
  </column>
  <column aggregation='User' caption='Orders Norm Day' datatype='real' default-type='quantitative' name='[Orders per Activations Day (copy)_114771466779672596]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = 1 THEN &\#10;SUM([orders_day])&\#10;ELSE&\#10;SUM([orders_day])/SUM([orders_day])*100&\#10;END' />
  </column>
  <column aggregation='User' caption='Orders Norm Month' datatype='real' default-type='quantitative' name='[Orders per Activations Month (copy)_114771466780373017]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = 1 THEN &\#10;SUM([orders_month])/30&\#10;ELSE&\#10;SUM([orders_month])/30/SUM([orders_day])*100&\#10;END' />
  </column>
  <column aggregation='User' caption='Orders Norm Week' datatype='real' default-type='quantitative' name='[Orders per Activations Week (copy)_114771466779750421]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = 1 THEN &\#10;SUM([orders_week])/7&\#10;ELSE&\#10;SUM([orders_week])/7/SUM([orders_day])*100&\#10;END' />
  </column>
  <column aggregation='User' caption='Incremental Customer / Target: Customers' datatype='real' default-format='p0.0\%' default-type='quantitative' name='[Rel. Incremental Activation (FIXED logic) (copy 2)]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='[Incremental Activation (FIXED logic) (copy 3)]/[Calculation_896497824906715136]&\#10;//(sum(if [In Control] = false then [Users (cases)] end ) / [Target: Receivers] - [Control: Users] / [Control: Receivers]) / ([Control: Users] / [Control: Receivers])' />
  </column>
  <column aggregation='User' caption='Incremental Orders / Target: Orders' datatype='real' default-format='p0.0\%' default-type='quantitative' name='[Rel. Incremental Orders (FIXED logic) (copy 2)]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='[Calculation_919578770527047694]/[Calculation_919578770525786118]&\#10;//([Target: Orders Per Receiver] - [Control: Orders Per Receiver]) / [Control: Orders Per Receiver]' />
  </column>
  <column aggregation='User' caption='Total  Receivers' datatype='integer' default-type='ordinal' name='[SWITCH: Receivers (copy)_217298712552816641]' pivot='key' role='measure' type='ordinal' user-datatype='integer' visual-totals='Default'>
