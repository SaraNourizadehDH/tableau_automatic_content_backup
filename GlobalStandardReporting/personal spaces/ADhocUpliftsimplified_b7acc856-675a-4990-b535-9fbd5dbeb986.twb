    <worksheet name='Bladerunners - Table'>
      <table>
        <view>
          <datasources>
            <datasource caption='dhma_1420_tableau_mkt_crm_bladerunners_verticals (Match_Lists)' name='federated.1o5w9rk1sw8lum12twveu1l1x7d2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='7 Days' caption='Select Uplift Window' datatype='string' name='[Date View (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;7Days&quot;'>
              <calculation class='tableau' formula='&quot;7Days&quot;' />
              <aliases>
                <alias key='&quot;12h&quot;' value='12 h' />
                <alias key='&quot;1Day&quot;' value='1 Day' />
                <alias key='&quot;7Days&quot;' value='7 Days' />
              </aliases>
            </column>
            <column alias='External ID' caption='Receiver Switch' datatype='integer' name='[Parameter 9]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='External ID' />
                <alias key='2' value='Analytical Customer ID' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o5w9rk1sw8lum12twveu1l1x7d2'>
            <column caption='Receivers' datatype='integer' name='[Calculation_2163768573878886400]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN 1 THEN [users]&#10;WHEN 2 THEN [users_aid]&#10;END' />
            </column>
            <column caption='Incremental Orders' datatype='real' name='[Calculation_2618069151543599105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({INCLUDE [campaign_name] : ([Calculation_2764999089390469122] - [Target Orders per Receivers (copy)_2764999089390542851]) * [Target Receivers (copy)_7032863453457432579]})' />
            </column>
            <column caption='Target Orders per Receivers' datatype='real' name='[Calculation_2764999089390469122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Control Orders (copy)_2618069151543508992])&#10;/&#10;[Target Receivers (copy)_7032863453457432579]' />
            </column>
            <column caption='Incremental GMV' datatype='real' name='[Calculation_2764999089393831947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({INCLUDE [campaign_name] :(SUM([Target Orders (copy)_2764999089393528840]) / [Target Receivers (copy)_7032863453457432579] - SUM([Control Orders (copy)_1882786142590476291]) / [Control Receivers (copy)_7032863453458165764]) * [Target Receivers (copy)_7032863453457432579]})' />
            </column>
            <column caption='iCPO' datatype='real' name='[Calculation_2764999089411280909]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2764999089393831947]/[Calculation_2618069151543599105]' />
            </column>
            <column caption='_Orders' datatype='integer' name='[Calculation_326511010489094144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Date View (copy)]&#10;WHEN &apos;12h&apos; THEN [Orders Cg (copy)]&#10;WHEN &apos;1Day&apos; THEN [Orders 12h (copy)_2163768573880893442]&#10;WHEN &apos;7Days&apos; THEN [Orders 1Day (copy)_2163768573881036803]&#10;END' />
            </column>
            <column caption='Opened Push Direct' datatype='integer' name='[Calculation_7032863453476450309]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED   &#10;[sent_date],&#10;[global_entity_id],&#10;[region],&#10;[management_entity],&#10;[country],&#10;[display_name],&#10;[campaign_type],&#10;[campaign_name]:&#10;MAX([opened_push_direct])&#10;})' />
            </column>
            <column caption='Clicked In App Message' datatype='integer' name='[Calculation_7032863453477142534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED   &#10;[sent_date],&#10;[global_entity_id],&#10;[region],&#10;[management_entity],&#10;[country],&#10;[display_name],&#10;[campaign_type],&#10;[campaign_name]:&#10;MAX([clicked_in_app_message])&#10;})' />
            </column>
            <column caption='Opened Email' datatype='integer' name='[Calculation_7032863453477634055]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED   &#10;[sent_date],&#10;[global_entity_id],&#10;[region],&#10;[management_entity],&#10;[country],&#10;[display_name],&#10;[campaign_type],&#10;[campaign_name]:&#10;MAX([opened_email])&#10;})' />
            </column>
            <column caption='Clicked Email' datatype='integer' name='[Calculation_7032863453477941256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED   &#10;[sent_date],&#10;[global_entity_id],&#10;[region],&#10;[management_entity],&#10;[country],&#10;[display_name],&#10;[campaign_type],&#10;[campaign_name]:&#10;MAX([clicked_email])&#10;})' />
            </column>
            <column caption='Revenue 12h' datatype='real' name='[Commission 12h (copy)_2706170859600822284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [uplift_window]=&apos;12h&apos; THEN [revenue_eur] END' />
