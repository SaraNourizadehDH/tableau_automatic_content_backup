      <table>
        <view>
          <datasources>
            <datasource caption='marketing_bi_weekly_tableau_mkt_crm_loyalty_analysis' name='sqlproxy.07wja2o16j67k51fhev6h0p6pv52' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='7 Days' caption='Time After Enter' datatype='integer' name='[Parameter 8]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='1 Day' />
                <alias key='2' value='7 Days' />
                <alias key='3' value='14 Days' />
                <alias key='4' value='30 Days' />
                <alias key='5' value='60 Days' />
                <alias key='6' value='90 Days' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.07wja2o16j67k51fhev6h0p6pv52'>
            <column aggregation='Count' caption='Loyalty Status Aggregated' datatype='string' default-type='nominal' layered='true' name='[Calculation_1562186128552763392]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='CASE [loyalty_status]&#13;&#10;    WHEN &apos;Acquisition&apos;                    THEN &apos;Acquisition&apos;&#13;&#10;    WHEN &apos;Loyal&apos;                          THEN &apos;Loyal&apos;&#13;&#10;    WHEN &apos;Active Steady&apos;                  THEN &apos;Active NL&apos;&#13;&#10;    WHEN &apos;Active Frequent&apos;                THEN &apos;Active NL&apos;&#13;&#10;    WHEN &apos;Active not Steady nor Frequent&apos; THEN &apos;Active NL&apos;&#13;&#10;    WHEN &apos;Churning Loyal&apos;                 THEN &apos;Churn&apos;&#13;&#10;    WHEN &apos;Churning Multiple Orders&apos;       THEN &apos;Churn&apos;&#13;&#10;    WHEN &apos;Churning 1 Timer&apos;               THEN &apos;Churn&apos;&#13;&#10;    WHEN &apos;Inactive Loyal&apos;                 THEN &apos;Inactive&apos;&#13;&#10;    WHEN &apos;Inactive Multiple Orders&apos;       THEN &apos;Inactive&apos;&#13;&#10;    WHEN &apos;Inactive Churning 1 Timer&apos;      THEN &apos;Inactive&apos;&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Users (cases)' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_2477261275903102977]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 8]&#10;when 1 then [users_day]&#10;when 2 then [users_week]&#10;when 3 then [users_2weeks]&#10;when 4 then [users_month]&#10;when 5 then [users_2months]&#10;when 6 then [users_3months]&#10;end' />
            </column>
            <column aggregation='Count' caption='Clean Canvases  Filter' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_4355966027353235470]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
              <calculation class='tableau' formula='CONTAINS(LOWER([campaign_name]),&apos;controlgroup&apos;) &#10;OR CONTAINS(LOWER([campaign_name]),&apos;educational&apos;)&#10;OR CONTAINS(LOWER([campaign_name]),&apos;-survey-&apos;)&#10;OR ISNULL({FIXED [campaign_name] : [Calculation_919578770525192195]}) &#10;OR {FIXED [campaign_name] : [Calculation_919578770525192195]} &lt; 1&#10;OR [campaign_name] = &apos;2101XX_APAC_FP_EG_YearlyPersonalized2020_Canvas&apos;&#10;OR (CONTAINS(LOWER([campaign_name]),&apos;probot&apos;) &#10;    AND NOT(CONTAINS(LOWER([campaign_name]),&apos;probot-globalcg&apos;)))&#10;OR CONTAINS([campaign_name],&apos;NPS&apos;)&#10;OR CONTAINS([campaign_name],&apos;_VertiBot&apos;)&#10;OR CONTAINS([campaign_name],&apos;_Challenge&apos;)' />
            </column>
            <column aggregation='User' caption='Target: Users' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_896497824906715136]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='SUM( IF [in_control] = FALSE THEN [Calculation_2477261275903102977] END)' />
            </column>
            <column aggregation='User' caption='Incremental Customer' datatype='real' default-type='quantitative' layered='true' name='[Calculation_896497824907956226]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM({INCLUDE [campaign_name] : ([Calculation_896497824906715136] / [Calculation_919578770525192195] - [Target: Users (copy)_896497824908230659] / [Calculation_919578770525470725]) * [Calculation_919578770525192195]})' />
            </column>
            <column aggregation='User' caption='Target: Receivers' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_919578770525192195]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='SUM(&#13;&#10;if [in_control]  = false &#13;&#10;then [receivers]&#13;&#10;end)' />
            </column>
            <column aggregation='User' caption='Control: Receivers' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_919578770525470725]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='sum(&#13;&#10;if [in_control] = true &#13;&#10;//then [Users (cases)]&#13;&#10;then [receivers]&#13;&#10;end&#13;&#10;)' />
            </column>
            <column aggregation='User' caption='Target: Orders' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_919578770525786118]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='sum(&#13;&#10;if [in_control] = false &#13;&#10;then [Orders (cases) (copy)]&#13;&#10;end &#13;&#10;)' />
            </column>
            <column aggregation='User' caption='Control: Orders' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_919578770525888519]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='sum(&#13;&#10;if [in_control] = true &#13;&#10;then [Orders (cases) (copy)]&#13;&#10;end &#13;&#10;)' />
            </column>
            <column aggregation='User' caption='Target: Orders Per Receiver' datatype='real' default-type='quantitative' layered='true' name='[Calculation_919578770526011400]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='[Calculation_919578770525786118]&#13;&#10;/&#13;&#10;[Calculation_919578770525192195]' />
            </column>
            <column aggregation='User' caption='Control: Orders Per Receiver' datatype='real' default-type='quantitative' layered='true' name='[Calculation_919578770526220297]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='[Calculation_919578770525888519] &#13;&#10;/ &#13;&#10;[Calculation_919578770525470725]' />
            </column>
            <column aggregation='User' caption='Incremental Orders' datatype='real' default-format='n#,##0;-#,##0' default-type='quantitative' layered='true' name='[Calculation_919578770527047694]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='SUM({INCLUDE [campaign_name] : ([Calculation_919578770526011400] - [Calculation_919578770526220297]) * [Calculation_919578770525192195]})' />
            </column>
            <column aggregation='Year' caption='Date Only' datatype='date' datatype-customized='true' default-format='*YYYY-MM-DD' default-type='ordinal' layered='true' name='[Date (copy)_2590273538449895424]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
              <calculation class='tableau' formula='DATE([date])' />
            </column>
            <column aggregation='Sum' caption='Orders (cases)' datatype='integer' default-type='quantitative' layered='true' name='[Orders (cases) (copy)]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
