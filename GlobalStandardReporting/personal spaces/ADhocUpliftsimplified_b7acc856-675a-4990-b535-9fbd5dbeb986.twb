    <worksheet name='Campaign Details - Main KPIs'>
      <table>
        <view>
          <datasources>
            <datasource name='marketing_bi_weekly_tableau_mkt_crm_campaign_verticals (local copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='7 Days' caption='Select Uplift Window' datatype='string' name='[Date View (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;7Days&quot;'>
              <calculation class='tableau' formula='&quot;7Days&quot;' />
              <aliases>
                <alias key='&quot;12h&quot;' value='12 h' />
                <alias key='&quot;1Day&quot;' value='1 Day' />
                <alias key='&quot;7Days&quot;' value='7 Days' />
              </aliases>
            </column>
            <column caption='Verticals Parameter' datatype='string' name='[Parameter 1 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='KPI View' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column alias='External ID' caption='Receiver Switch' datatype='integer' name='[Parameter 9]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='External ID' />
                <alias key='2' value='Analytical Customer ID' />
              </aliases>
            </column>
            <column alias='Weekly' caption='Date View' datatype='string' name='[Users Tg Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='marketing_bi_weekly_tableau_mkt_crm_campaign_verticals (local copy)'>
            <column caption='Date' datatype='datetime' default-format='*YYYY-MM-DD' name='[Calculation_1134484955555418112]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[Users Tg Parameter],[sent_date],&apos;monday&apos;)' />
            </column>
            <column caption='[New] Increment % of All Orders' datatype='real' name='[Calculation_1134484955561709571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([_Orders/Customers TG (copy)_114771466801725477]-[_Orders/Customers CG (copy)_114771466801635364])' />
            </column>
            <column caption='Uplift Proportion' datatype='string' name='[Calculation_1510887370073456647]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF { FIXED [Campaign Name]: [Increment Orders 7Days]} &lt; 0 AND [Significant Campaign]=TRUE THEN &quot;negative&quot;&#10;//ELSEIF { FIXED [Campaign Name]: [Increment Orders 7Days]} &gt;= 0 AND [Significant Campaign]=TRUE THEN &quot;positive&quot;&#10;//ELSE &quot;CG too small&quot;&#10;//END&#10;&#10;IF [Parameters].[Date View (copy)]=&apos;12h&apos; THEN &#10;    IF { FIXED [campaign_name]: [Increment Orders (copy)]} &lt; 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;negative&quot;&#10;    ELSEIF { FIXED [campaign_name]: [Increment Orders (copy)]} &gt;= 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;positive&quot;&#10;    ELSE &quot;CG too small&quot;&#10;    END&#10;ELSEIF [Parameters].[Date View (copy)]=&apos;1Day&apos; THEN&#10;    IF { FIXED [campaign_name]: [Calculation_941252330473996298]} &lt; 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;negative&quot;&#10;    ELSEIF { FIXED [campaign_name]: [Calculation_941252330473996298]} &gt;= 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;positive&quot;&#10;    ELSE &quot;CG too small&quot;&#10;    END&#10;ELSEIF [Parameters].[Date View (copy)]=&apos;7Days&apos; THEN&#10;    IF { FIXED [campaign_name]: [Calculation_941252330474115083]} &lt; 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;negative&quot;&#10;    ELSEIF { FIXED [campaign_name]: [Calculation_941252330474115083]} &gt;= 0 AND [Calculation_956663138992619522]=TRUE THEN &quot;positive&quot;&#10;    ELSE &quot;CG too small&quot;&#10;    END&#10;END' />
            </column>
            <column caption='Target: Receivers' datatype='real' name='[Calculation_164381441401962500]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN 1 THEN [users_tg]&#10;WHEN 2 THEN [users_aid_tg]&#10;END' />
            </column>
            <column caption='GMV per Receiver Tg' datatype='real' name='[Calculation_326511010493829123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur_tg])/SUM([Calculation_164381441401962500])' />
            </column>
            <column caption='KPI View Filter' datatype='string' name='[Calculation_326511010543423495]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 4]' />
            </column>
            <column caption='Clean Canvases  Filter' datatype='boolean' name='[Calculation_4355966027353235470]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CONTAINS(LOWER([campaign_name]),&apos;controlgroup&apos;) &#10;OR CONTAINS(LOWER([campaign_name]),&apos;educational&apos;)&#10;OR CONTAINS(LOWER([campaign_name]),&apos;-survey-&apos;)&#10;OR ISNULL({FIXED [campaign_name] : SUM([Calculation_164381441401962500])}) &#10;OR {FIXED [campaign_name] : SUM([Calculation_164381441401962500])} &lt; 1&#10;OR [campaign_name] = &apos;2101XX_APAC_FP_EG_YearlyPersonalized2020_Canvas&apos;&#10;OR (CONTAINS(LOWER([campaign_name]),&apos;probot&apos;) &#10;    AND NOT(CONTAINS(LOWER([campaign_name]),&apos;probot-globalcg&apos;)))&#10;OR CONTAINS([campaign_name],&apos;NPS&apos;)&#10;OR CONTAINS([campaign_name],&apos;_VertiBot&apos;)&#10;OR CONTAINS([campaign_name],&apos;_Challenge&apos;)' />
            </column>
            <column caption='Orders Cg 1Day' datatype='real' name='[Calculation_941252330469060609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [uplift_window]=&apos;12h&apos; OR [uplift_window]=&apos;1Day&apos; &#10;THEN [orders_cg] END' />
            </column>
            <column caption='Orders Cg 7Days' datatype='real' name='[Calculation_941252330469216258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [uplift_window]=&apos;12h&apos; &#10;OR [uplift_window]=&apos;1Day&apos; OR [uplift_window]=&apos;7Days&apos;&#10;THEN [orders_cg] END' />
            </column>
            <column caption='Orders Tg 12h' datatype='real' name='[Calculation_941252330470084612]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [uplift_window]=&apos;12h&apos; THEN [orders_tg] END' />
            </column>
            <column caption='Orders Tg 1Day' datatype='real' name='[Calculation_941252330470629381]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [uplift_window]=&apos;12h&apos; OR [uplift_window]=&apos;1Day&apos; &#10;THEN [orders_tg] END' />
            </column>
            <column caption='Orders Tg 7Days' datatype='real' name='[Calculation_941252330470830086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [uplift_window]=&apos;12h&apos; &#10;OR [uplift_window]=&apos;1Day&apos; OR [uplift_window]=&apos;7Days&apos;&#10;THEN [orders_tg] END' />
            </column>
            <column caption='Increment Orders 1Day' datatype='real' name='[Calculation_941252330473996298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM([Calculation_941252330470629381])/SUM([Calculation_164381441401962500]))&#10;-&#10;(SUM([Calculation_941252330469060609])/SUM([Target Group Users (copy)_164381441402490885]))&#10;)&#10;*&#10;SUM([Calculation_164381441401962500])' />
            </column>
            <column caption='Increment Orders 7Days' datatype='real' name='[Calculation_941252330474115083]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM([Calculation_941252330470830086])/SUM([Calculation_164381441401962500]))&#10;-&#10;(SUM([Calculation_941252330469216258])/SUM([Target Group Users (copy)_164381441402490885]))&#10;)&#10;*&#10;SUM([Calculation_164381441401962500])' />
            </column>
            <column caption='Significant Campaign' datatype='boolean' name='[Calculation_956663138992619522]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF { FIXED [campaign_name]: SUM([users_cg])} &gt;100 THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Campaign Name Keyword' datatype='string' name='[Campaign Name (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[campaign_name]' />
            </column>
            <column caption='GMV per Receiver Cg' datatype='real' name='[GMV per Receivers Tg (copy)_326511010494259204]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur_cg])/SUM([Target Group Users (copy)_164381441402490885])' />
            </column>
            <column caption='Increment Orders 12h' datatype='real' name='[Increment Orders (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM([Calculation_941252330470084612])/SUM([Calculation_164381441401962500]))&#10;-&#10;(SUM([Orders Cg (copy)])/SUM([Target Group Users (copy)_164381441402490885]))&#10;)&#10;*&#10;SUM([Calculation_164381441401962500])' />
            </column>
            <column caption='Increment Vouchers 12h' datatype='real' name='[Increment Orders 12h (copy)_164381441443012623]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM([Vouchers Cg 12h (copy)_164381441442160652])/SUM([Calculation_164381441401962500]))&#10;-&#10;(SUM([Vouchers Cg 12h (copy)_164381441442160652])/SUM([Target Group Users (copy)_164381441402490885]))&#10;)&#10;*&#10;SUM([Calculation_164381441401962500])' />
            </column>
            <column caption='Increment Vouchers 1Day' datatype='real' name='[Increment Orders 1Day (copy)_164381441444196368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM([Vouchers Cg 1Day (copy)_164381441442353165])/SUM([Calculation_164381441401962500]))&#10;-&#10;(SUM([Orders Cg 1Day (copy)_164381441441107978])/SUM([Target Group Users (copy)_164381441402490885]))&#10;)&#10;*&#10;SUM([Calculation_164381441401962500])' />
            </column>
            <column caption='Increment Vouchers 7Days' datatype='real' name='[Increment Orders 7Days (copy)_164381441445199889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM([Vouchers Cg 7Days (copy)_164381441442627598])/SUM([Calculation_164381441401962500]))&#10;-&#10;(SUM([Orders Cg 7Days (copy)_164381441441550347])/SUM([Target Group Users (copy)_164381441402490885]))&#10;)&#10;*&#10;SUM([Calculation_164381441401962500])' />
            </column>
            <column caption='Incr CPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Incremental CPO (copy)_7032863454195646474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[[New]] Incremental Voucher Cost (copy)_7032863454195810315]/[[New]] Incremental Orders (copy)_7032863454193799177]' />
            </column>
            <column caption='Orders Cg 12h' datatype='real' name='[Orders Cg (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [uplift_window]=&apos;12h&apos; THEN [orders_cg] END' />
            </column>
            <column caption='Vouchers Cg 1Day' datatype='real' name='[Orders Cg 1Day (copy)_164381441441107978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [uplift_window]=&apos;12h&apos; OR [uplift_window]=&apos;1Day&apos; &#10;THEN [voucher_eur_cg] END' />
            </column>
            <column caption='Vouchers Cg 7Days' datatype='real' name='[Orders Cg 7Days (copy)_164381441441550347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [uplift_window]=&apos;12h&apos; &#10;OR [uplift_window]=&apos;1Day&apos; OR [uplift_window]=&apos;7Days&apos;&#10;THEN [voucher_eur_cg] END' />
            </column>
            <column caption='Control: Receivers' datatype='real' name='[Target Group Users (copy)_164381441402490885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 9]&#10;WHEN 1 THEN [users_cg]&#10;WHEN 2 THEN [users_aid_cg]&#10;END' />
            </column>
            <column caption='Vouchers Tg 12h' datatype='real' name='[Vouchers Cg 12h (copy)_164381441442160652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [uplift_window]=&apos;12h&apos; THEN [voucher_eur_tg] END' />
            </column>
            <column caption='Vouchers Tg 1Day' datatype='real' name='[Vouchers Cg 1Day (copy)_164381441442353165]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [uplift_window]=&apos;12h&apos; OR [uplift_window]=&apos;1Day&apos; &#10;THEN [voucher_eur_tg] END' />
            </column>
            <column caption='Vouchers Tg 7Days' datatype='real' name='[Vouchers Cg 7Days (copy)_164381441442627598]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [uplift_window]=&apos;12h&apos; &#10;OR [uplift_window]=&apos;1Day&apos; OR [uplift_window]=&apos;7Days&apos;&#10;THEN [voucher_eur_tg] END' />
            </column>
            <column caption='Incr GMV' datatype='real' name='[[New]] Incremental GMV (copy)_7032863454196322316]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED   &#10;[sent_date],&#10;[management_entity_group],&#10;[country],&#10;[display_name],&#10;[campaign_type],&#10;[campaign_name]:&#10;([Calculation_326511010493829123]-[GMV per Receivers Tg (copy)_326511010494259204])*SUM([Calculation_164381441401962500])&#10;})' />
            </column>
            <column caption='Incr Orders' datatype='real' name='[[New]] Incremental Orders (copy)_7032863454193799177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED   &#10;[sent_date],&#10;[management_entity_group],&#10;[country],&#10;[display_name],&#10;[campaign_type],&#10;[campaign_name]:&#10;[Calculation_1134484955561709571]*SUM([Calculation_164381441401962500])&#10;})' />
            </column>
            <column caption='[New] Incremental Voucher Cost' datatype='real' name='[[New]] Incremental Voucher Cost (copy)_7032863454195810315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED   &#10;[sent_date],&#10;[management_entity_group],&#10;[country],&#10;[display_name],&#10;[campaign_type],&#10;[campaign_name]:&#10;CASE [Parameters].[Date View (copy)]&#10;WHEN &apos;12h&apos; THEN [Increment Orders 12h (copy)_164381441443012623] //[Increment Orders 12h]&#10;WHEN &apos;1Day&apos; THEN [Increment Orders 1Day (copy)_164381441444196368]//[Increment Orders 1Day]&#10;WHEN &apos;7Days&apos; THEN [Increment Orders 7Days (copy)_164381441445199889]//[Increment Orders 7Days]&#10;END&#10;})' />
            </column>
            <column caption='_Orders Cg (Case) filtered' datatype='real' name='[_Orders Cg (Case) (copy)_114771466801029154]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [shop_type] = [Parameters].[Parameter 1 1]&#10;OR [Parameters].[Parameter 1 1] = &quot;All&quot;&#10;THEN &#10;CASE [Parameters].[Date View (copy)]&#10;WHEN &apos;12h&apos; THEN [Orders Cg (copy)]&#10;WHEN &apos;1Day&apos; THEN [Calculation_941252330469060609]&#10;WHEN &apos;7Days&apos; THEN [Calculation_941252330469216258]&#10;END End' />
            </column>
            <column caption='_Orders Tg (Case) filtered' datatype='real' name='[_Orders Tg (Case) (copy)_114771466801524771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [shop_type] = [Parameters].[Parameter 1 1]&#10;OR [Parameters].[Parameter 1 1] = &quot;All&quot;&#10;THEN &#10;CASE [Parameters].[Date View (copy)]&#10;WHEN &apos;12h&apos; THEN [Calculation_941252330470084612]&#10;WHEN &apos;1Day&apos; THEN [Calculation_941252330470629381]&#10;WHEN &apos;7Days&apos; THEN [Calculation_941252330470830086]&#10;END END' />
            </column>
            <column caption='_Orders/Customers CG filtered' datatype='real' name='[_Orders/Customers CG (copy)_114771466801635364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([_Orders Cg (Case) (copy)_114771466801029154])/SUM([Target Group Users (copy)_164381441402490885])' />
            </column>
            <column caption='_Orders/Customers TG filtered' datatype='real' name='[_Orders/Customers TG (copy)_114771466801725477]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([_Orders Tg (Case) (copy)_114771466801524771])/SUM([Calculation_164381441401962500])' />
            </column>
            <column caption='Campaign Category' datatype='string' name='[campaign_category]' role='dimension' type='nominal' />
            <column caption='Campaign Name' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
            <column caption='Campaign Type' datatype='string' name='[campaign_type]' role='dimension' type='nominal' />
            <column caption='Channel' datatype='string' name='[channel]' role='dimension' type='nominal' />
            <column caption='Company Name' datatype='string' name='[company_name]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Display Name' datatype='string' name='[display_name]' role='dimension' type='nominal' />
            <column datatype='real' name='[gmv_eur_cg]' role='measure' type='quantitative' />
            <column datatype='real' name='[gmv_eur_tg]' role='measure' type='quantitative' />
            <column caption='expedition_type' datatype='boolean' name='[is_takeout]' role='dimension' type='nominal'>
              <aliases>
                <alias key='false' value='Delivery' />
                <alias key='true' value='Takeout' />
