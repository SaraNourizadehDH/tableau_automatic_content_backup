        <calculations>
          <calculation column='[  60d Incremental Orders Per Receiver (copy)_1663798598742142990]' formula='//IF MIN([Date Range]) &gt; 30 THEN&#10;//((SUM(IF [In Control] = FALSE THEN [Orders 2Months] END )/[Target: Receivers]) &#13;&#10;//- (SUM(IF [In Control] = TRUE THEN [Orders 2Months] END )/[Control: Receivers]))&#10;//END&#10;&#10;SUM(&#10;{ FIXED   &#10;[date],&#10;[management_entity],&#10;[country],&#10;[display_name],&#10;[campaign_type],&#10;[campaign_name]:&#10;((SUM(IF [in_control] = FALSE THEN [orders_2months] END )/[Calculation_919578770525192195]) &#10;- (SUM(IF [in_control] = TRUE THEN [orders_2months] END )/[Calculation_919578770525470725]))&#10;})' />
          <calculation column='[30d  Incremental Orders (copy)_5778470202558095363]' formula='//((SUM(IF [In Control] = FALSE THEN [gmv_eur_month] END )/[Target: Receivers]) &#13;&#10;//- (SUM(IF [In Control] = TRUE THEN [gmv_eur_month] END )/[Control: Receivers])) &#13;&#10;//* [Target: Receivers]&#10;&#10;SUM(&#10;{ FIXED   &#10;[date],&#10;[management_entity],&#10;[country],&#10;[display_name],&#10;[campaign_type],&#10;[campaign_name]:&#10;((SUM(IF [in_control] = FALSE THEN [gmv_eur_month] END )/[Calculation_919578770525192195]) &#10;- (SUM(IF [in_control] = TRUE THEN [gmv_eur_month] END )/[Calculation_919578770525470725])) &#10;* [Calculation_919578770525192195]&#10;})' />
          <calculation column='[30d  Incremental Orders (copy)_726416580544647168]' formula='// old standard calculation&#10;//[30d  Incremental Orders]/SUM([Orders Month])&#10;&#10;SUM(&#10;{ FIXED   &#10;[date],&#10;[management_entity],&#10;[country],&#10;[display_name],&#10;[campaign_type],&#10;[campaign_name]:&#10;[30d Incremental Orders (copy)_1663798598740070411]&#10;})/[30d FIXED Control: Orders (copy)_4826381097262850063]' />
          <calculation column='[30d FIXED Control: Orders (copy)_4826381097262850063]' formula='SUM(&#10;{ FIXED   &#10;[date],&#10;[management_entity],&#10;[country],&#10;[display_name],&#10;[campaign_type],&#10;[campaign_name]:&#13;&#10;sum( if [in_control] = FALSE then [orders_month] end)&#13;&#10;}&#13;&#10;)' />
          <calculation column='[30d Incremental Customer Proportion (copy)_1663798598728925187]' formula='//[30d Incremental Customer]/[30d Target: Users]&#10;&#10;SUM(&#10;{ FIXED   &#10;[date],&#10;[management_entity],&#10;[country],&#10;[display_name],&#10;[campaign_type],&#10;[campaign_name]:&#10;[Incremental Customer (copy)_1663798598729691141]/[WS Target: Users (discrete) (copy)_1663798598738927624]&#10;})' />
          <calculation column='[30d Incremental Orders (copy)_1663798598740070411]' formula='// Old Standard Incremental Order&#10;//((SUM(IF [In Control] = FALSE THEN [Orders Month] END )/[Target: Receivers]) &#13;&#10;//- (SUM(IF [In Control] = TRUE THEN [Orders Month] END )/[Control: Receivers])) &#13;&#10;//* [Target: Receivers]&#10;&#10;SUM(&#10;{ FIXED   &#10;[date],&#10;[management_entity],&#10;[country],&#10;[display_name],&#10;[campaign_type],&#10;[campaign_name]:&#10;([30d FIXED Control: Orders (copy)_4826381097262850063]/[FIXED Control: Receivers (copy)_4826381097263513619]&#10;- [FIXED Control: Orders (copy)_4826381097262366732]/[FIXED Control: Receivers (copy)_4826381097263472658])&#10;*[FIXED Control: Receivers (copy)_4826381097263513619]&#10;})' />
          <calculation column='[30d Incremental Orders Per Receiver (copy)_1635932609258606593]' formula='//((SUM(IF [In Control] = FALSE THEN [Orders 2Weeks] END )/[Target: Receivers]) &#13;&#10;//- (SUM(IF [In Control] = TRUE THEN [Orders 2Weeks] END )/[Control: Receivers]))&#10;&#10;SUM(&#10;{ FIXED   &#10;[date],&#10;[management_entity],&#10;[country],&#10;[display_name],&#10;[campaign_type],&#10;[campaign_name]:&#10;((SUM(IF [in_control] = FALSE THEN [orders_2weeks] END )/[Calculation_919578770525192195]) &#10;- (SUM(IF [in_control] = TRUE THEN [orders_2weeks] END )/[Calculation_919578770525470725]))&#10;})' />
          <calculation column='[30d iCPC (copy)_1663798598739443721]' formula='IFNULL([WS Incremental Voucher Cost 30d (copy)_1663798598739734538]/[Incremental Customer (copy)_1663798598729691141], 0)' />
          <calculation column='[30d iCPO (copy)_1663798598740779020]' formula='IFNULL([WS Incremental Voucher Cost 30d (copy)_1663798598739734538]/[30d Incremental Orders (copy)_1663798598740070411], 0)' />
          <calculation column='[90d - 30d Incremental Orders Per Receiver (copy)_1635932609259675650]' formula='[  60d Incremental Orders Per Receiver (copy)_1663798598742142990] - [30d Incremental Orders Per Receiver (copy)_1635932609258606593]' />
          <calculation column='[Calculation_114771466771881998]' formula='SUM([orders_day])/SUM([users_day])' />
