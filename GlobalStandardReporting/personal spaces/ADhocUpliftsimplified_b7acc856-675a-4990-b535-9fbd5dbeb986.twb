  <column aggregation='User' caption='FIXED Control: Orders' datatype='integer' default-type='quantitative' name='[Calculation_1583507884844228609]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='SUM(&\#13;&\#10;{ FIXED   &\#13;&\#10;[date],&\#13;&\#10;[date_type],&\#13;&\#10;[management_entity],&\#13;&\#10;[country],&\#13;&\#10;[display_name],&\#13;&\#10;[campaign_type],&\#13;&\#10;[canvas_name],&\#10;[expedition_type]:&\#13;&\#10;sum( if [in_control] = true then [Calculation_2477261275902283776] end)&\#13;&\#10;}&\#13;&\#10;)' />
  </column>
  <column aggregation='Count' caption='Filter: Show Variants' datatype='boolean' default-type='nominal' name='[Calculation_1583507885144969220]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
    <calculation class='tableau' formula='case [Parameters].[Parameter 10]&\#10;when 1 then FALSE&\#10;when 2 then TRUE&\#10;end' />
  </column>
  <column aggregation='Count' caption='Filter: Show Variants = True' datatype='boolean' default-type='nominal' name='[Calculation_1583507885147652102]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
    <calculation class='tableau' formula='[Calculation_1583507885144969220] = TRUE' />
  </column>
  <column aggregation='Sum' caption='Receiver Threshold (Date View dependent)' datatype='integer' default-type='quantitative' name='[Calculation_1583507885161340935]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
    <calculation class='tableau' formula='CASE [date_type]&\#10;when &apos;2-monthly&apos; then 15&\#10;when &apos;monthly&apos; then 15&\#10;when &apos;weekly&apos; then 7&\#10;when &apos;daily&apos; then 1&\#10;end' />
  </column>
  <column aggregation='Count' caption='Receiver Threshold satisfied' datatype='boolean' default-type='nominal' name='[Calculation_1583507885163405320]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
    <calculation class='tableau' formula='[Calculation_3773594308397547521] &gt; [Calculation_1583507885161340935]' />
  </column>
  <column aggregation='User' caption='Incremental Activation (FIXED logic)' datatype='real' default-type='quantitative' name='[Calculation_1583507885203116041]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='([Orders Per Receiver (copy)_968273957774950429] - sum([Control: Orders Per Receiver (FIXED logic) (copy)_968273957774630940])) * [Control: Users (copy)]&\#13;&\#10;&\#13;&\#10;//(sum(if [In Control] = false then [Users (cases)] end ) / [Target: Receivers] - [Control: Receivers]/ sum([FIXED Control: Receivers verticals])) * [Target: Receivers]' />
  </column>
  <column aggregation='User' caption='Target: \% Loyal Receivers' datatype='real' default-format='p0.0\%' default-type='quantitative' name='[Calculation_1583507885478207498]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='if min([in_control]) = FALSE then [Loyal Receivers (copy)_968273957651783699] END / [Control: Users (copy)]' />
  </column>
  <column aggregation='User' caption='Control: \% Loyal Receivers' datatype='real' default-format='p0.0\%' default-type='quantitative' name='[Calculation_1583507885478436875]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
