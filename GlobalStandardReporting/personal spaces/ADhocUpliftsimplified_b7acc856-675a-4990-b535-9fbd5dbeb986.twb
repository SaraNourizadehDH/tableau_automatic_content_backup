          <calculation column='[Calculation_164381441401962500]' formula='CASE [Parameters].[Parameter 9]&#10;WHEN 1 THEN [users_tg]&#10;WHEN 2 THEN [users_aid_tg]&#10;END' />
          <calculation column='[Calculation_164381441440518153]' formula='IF [uplift_window]=&apos;12h&apos; THEN [voucher_eur_cg] END' />
