        <calculation class='tableau' formula='WINDOW_SUM(SUM({INCLUDE [campaign_name] : (&#13;&#10;(SUM(IF [in_control] = FALSE THEN [voucher_eur_2months] END )/[Calculation_919578770525192195]) &#13;&#10;- (SUM(IF [in_control] = TRUE THEN [voucher_eur_2months] END )/[Calculation_919578770525470725])) &#13;&#10;* [Calculation_919578770525192195]&#13;&#10;}))'>
