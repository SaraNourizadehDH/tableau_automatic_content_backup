              <calculation class='tableau' formula='SUM({ FIXED   &#13;&#10;[date],&#13;&#10;[date_type],&#13;&#10;[Calculation_6017160963953504256],&#13;&#10;[region],&#13;&#10;[management_entity],&#13;&#10;[country],&#13;&#10;[display_name],&#13;&#10;[campaign_type],&#13;&#10;[canvas_name],&#13;&#10;[variation_name]:&#13;&#10;case min([in_control])&#13;&#10;when true then min([Calculation_3773594308397547521])&#13;&#10;end&#13;&#10;})' />
