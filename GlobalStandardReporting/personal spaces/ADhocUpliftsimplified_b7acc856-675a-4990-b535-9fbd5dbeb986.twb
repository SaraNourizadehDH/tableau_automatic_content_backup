            <column aggregation='Count' caption='Filter: Show Variants = True' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_1583507885147652102]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
              <calculation class='tableau' formula='[Calculation_1583507885144969220] = TRUE' />
            </column>
            <column aggregation='Sum' caption='Receiver Threshold (Date View dependent)' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_1583507885161340935]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='CASE [date_type]&#10;when &apos;2-monthly&apos; then 15&#10;when &apos;monthly&apos; then 15&#10;when &apos;weekly&apos; then 7&#10;when &apos;daily&apos; then 1&#10;end' />
            </column>
            <column aggregation='Count' caption='Receiver Threshold satisfied' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_1583507885163405320]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
              <calculation class='tableau' formula='[Calculation_3773594308397547521] &gt; [Calculation_1583507885161340935]' />
            </column>
            <column aggregation='Sum' caption='Orders (cases)' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_2477261275902283776]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;when 1 then [orders_day]&#10;when 2 then [orders_week]&#10;when 3 then [orders_month]&#10;when 4 then [orders_2months]&#10;when 5 then [orders_3months]&#10;end' />
            </column>
            <column aggregation='Sum' caption='Voucher Eur (cases)' datatype='real' default-type='quantitative' layered='true' name='[Calculation_2477261275951964162]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;when 1 then [voucher_eur_day]&#10;when 2 then [voucher_eur_week]&#10;when 3 then [voucher_eur_month]&#10;when 4 then [voucher_eur_2months]&#10;when 5 then [voucher_eur_3months]&#10;end' />
            </column>
            <column aggregation='Sum' caption='SWITCH: Receivers' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_3773594308397547521]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='{ FIXED   &#13;&#10;[date],&#13;&#10;[date_type],&#13;&#10;[Calculation_6017160963953504256],&#13;&#10;[region],&#13;&#10;[management_entity],&#13;&#10;[country],&#13;&#10;[display_name],&#13;&#10;[campaign_type],&#13;&#10;[canvas_name],&#13;&#10;[variation_name]:&#13;&#10;case min([Parameters].[Parameter 9])&#13;&#10;when 1 then min([receivers_external_id])&#13;&#10;when 2 then min([receivers])&#13;&#10;end&#13;&#10;}' />
