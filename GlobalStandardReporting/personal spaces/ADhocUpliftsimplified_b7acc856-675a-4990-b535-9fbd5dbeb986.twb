      <column aggregation='User' caption='Orders Norm Week' datatype='real' default-type='quantitative' layered='true' name='[Orders per Activations Week (copy)_114771466779750421]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = 1 THEN &#10;SUM([orders_week])/7&#10;ELSE&#10;SUM([orders_week])/7/SUM([orders_day])*100&#10;END' />
      </column>
      <column aggregation='User' caption='Incremental Customer / Target: Customers' datatype='real' default-format='p0.0%' default-type='quantitative' layered='true' name='[Rel. Incremental Activation (FIXED logic) (copy 2)]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='[Incremental Activation (FIXED logic) (copy 3)]/[Calculation_896497824906715136]&#10;//(sum(if [In Control] = false then [Users (cases)] end ) / [Target: Receivers] - [Control: Users] / [Control: Receivers]) / ([Control: Users] / [Control: Receivers])' />
      </column>
      <column aggregation='User' caption='Incremental Orders / Target: Orders' datatype='real' default-format='p0.0%' default-type='quantitative' layered='true' name='[Rel. Incremental Orders (FIXED logic) (copy 2)]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='[Calculation_919578770527047694]/[Calculation_919578770525786118]&#10;//([Target: Orders Per Receiver] - [Control: Orders Per Receiver]) / [Control: Orders Per Receiver]' />
      </column>
