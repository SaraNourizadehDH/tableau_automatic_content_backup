          <calculation column='[Calculation_114771466772451347]' formula='SUM([orders_3months])/SUM([users_3months])' />
          <calculation column='[Calculation_1318991770680533001]' formula='//IF MIN([Date Range]) &gt; 14 THEN&#10;//((SUM(IF [In Control] = FALSE THEN [Orders Month] END )/[Target: Receivers]) &#10;//- (SUM(IF [In Control] = TRUE THEN [Orders Month] END )/[Control: Receivers]))&#10;//END&#10;&#10;[30d Incremental Orders (copy)_1663798598740070411]/[FIXED Control: Receivers (copy)_4826381097263513619]' />
          <calculation column='[Calculation_1562186128552763392]' formula='CASE [loyalty_status]&#13;&#10;    WHEN &apos;Acquisition&apos;                    THEN &apos;Acquisition&apos;&#13;&#10;    WHEN &apos;Loyal&apos;                          THEN &apos;Loyal&apos;&#13;&#10;    WHEN &apos;Active Steady&apos;                  THEN &apos;Active NL&apos;&#13;&#10;    WHEN &apos;Active Frequent&apos;                THEN &apos;Active NL&apos;&#13;&#10;    WHEN &apos;Active not Steady nor Frequent&apos; THEN &apos;Active NL&apos;&#13;&#10;    WHEN &apos;Churning Loyal&apos;                 THEN &apos;Churn&apos;&#13;&#10;    WHEN &apos;Churning Multiple Orders&apos;       THEN &apos;Churn&apos;&#13;&#10;    WHEN &apos;Churning 1 Timer&apos;               THEN &apos;Churn&apos;&#13;&#10;    WHEN &apos;Inactive Loyal&apos;                 THEN &apos;Inactive&apos;&#13;&#10;    WHEN &apos;Inactive Multiple Orders&apos;       THEN &apos;Inactive&apos;&#13;&#10;    WHEN &apos;Inactive Churning 1 Timer&apos;      THEN &apos;Inactive&apos;&#13;&#10;END' />
          <calculation column='[Calculation_1583507885203116041]' formula='(sum(if [in_control] = false then [Calculation_2477261275903102977] end ) / [Calculation_919578770525192195] - [FIXED Control: Orders (copy 4)] / [Calculation_919578770565566488]) * [Calculation_919578770525192195]' />
          <calculation column='[Calculation_2477261275903102977]' formula='case [Parameters].[Parameter 8]&#10;when 1 then [users_day]&#10;when 2 then [users_week]&#10;when 3 then [users_2weeks]&#10;when 4 then [users_month]&#10;when 5 then [users_2months]&#10;when 6 then [users_3months]&#10;end' />
          <calculation column='[Calculation_2925299093582770176]' formula='DATEDIFF(&apos;day&apos;,{MIN([Date (copy)_2590273538449895424])},{MAX([Date (copy)_2590273538449895424])})' />
          <calculation column='[Calculation_3773594308397547521]' formula='[receivers]' />
          <calculation column='[Calculation_4355966027353235470]' formula='CONTAINS(LOWER([campaign_name]),&apos;controlgroup&apos;) &#10;OR CONTAINS(LOWER([campaign_name]),&apos;educational&apos;)&#10;OR CONTAINS(LOWER([campaign_name]),&apos;-survey-&apos;)&#10;OR ISNULL({FIXED [campaign_name] : [Calculation_919578770525192195]}) &#10;OR {FIXED [campaign_name] : [Calculation_919578770525192195]} &lt; 1&#10;OR [campaign_name] = &apos;2101XX_APAC_FP_EG_YearlyPersonalized2020_Canvas&apos;&#10;OR (CONTAINS(LOWER([campaign_name]),&apos;probot&apos;) &#10;    AND NOT(CONTAINS(LOWER([campaign_name]),&apos;probot-globalcg&apos;)))&#10;OR CONTAINS([campaign_name],&apos;NPS&apos;)&#10;OR CONTAINS([campaign_name],&apos;_VertiBot&apos;)&#10;OR CONTAINS([campaign_name],&apos;_Challenge&apos;)' />
