        <calculation class='tableau' formula='SUM({INCLUDE [campaign_name] :(SUM([Target Orders (copy)_2764999089393528840]) / [Target Receivers (copy)_7032863453457432579] - SUM([Control Orders (copy)_1882786142590476291]) / [Control Receivers (copy)_7032863453458165764]) * [Target Receivers (copy)_7032863453457432579]})' />
