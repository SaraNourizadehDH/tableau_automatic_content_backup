          <datasource-dependencies datasource='sqlproxy.18ddi8n1474ky411hqm0a0ro06fe'>
            <column aggregation='Count' caption='Filter: Show Variants' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_1583507885144969220]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
