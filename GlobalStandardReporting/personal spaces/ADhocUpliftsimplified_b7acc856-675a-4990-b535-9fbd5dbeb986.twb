      <column aggregation='User' caption='Orders Norm Month' datatype='real' default-type='quantitative' layered='true' name='[Orders per Activations Month (copy)_114771466780373017]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = 1 THEN &#10;SUM([orders_month])/30&#10;ELSE&#10;SUM([orders_month])/30/SUM([orders_day])*100&#10;END' />
