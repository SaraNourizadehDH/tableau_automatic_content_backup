      <column aggregation='User' caption='Orders Norm 3Months' datatype='real' default-type='quantitative' layered='true' name='[Orders per Activations 3Months (copy)_114771466780241944]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = 1 THEN &#10;SUM([orders_3months])/90&#10;ELSE&#10;SUM([orders_3months])/90/SUM([orders_day])*100&#10;END' />
      </column>
      <column aggregation='User' caption='Orders Norm Day' datatype='real' default-type='quantitative' layered='true' name='[Orders per Activations Day (copy)_114771466779672596]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = 1 THEN &#10;SUM([orders_day])&#10;ELSE&#10;SUM([orders_day])/SUM([orders_day])*100&#10;END' />
