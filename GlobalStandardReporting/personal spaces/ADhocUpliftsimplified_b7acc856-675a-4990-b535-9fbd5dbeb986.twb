        <calculation class='tableau' formula='//[30d Incremental Customer]/[30d Target: Users]&#10;&#10;SUM(&#10;{ FIXED   &#10;[date],&#10;[management_entity],&#10;[country],&#10;[display_name],&#10;[campaign_type],&#10;[campaign_name]:&#10;[Incremental Customer (copy)_1663798598729691141]/[WS Target: Users (discrete) (copy)_1663798598738927624]&#10;})' />
