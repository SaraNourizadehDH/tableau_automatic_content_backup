              <bucket>&quot;[federated.0qy7fuu0mls29015oj85r0csj6tz].[sum:orders:qk]&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;[federated.0qy7fuu0mls29015oj85r0csj6tz].[sum:prio_order:qk]&quot;</bucket>
            </map>
