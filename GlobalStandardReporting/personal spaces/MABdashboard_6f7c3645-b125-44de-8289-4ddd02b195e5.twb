      </field-sort-info>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_0F1CB7F702844619B4B76B78DC7F1ABB'>
            <properties context=''>
              <relation connection='bigquery.08336el06pyp4d14fxi3s1y2ueio' name='Custom SQL Query' type='text'><![CDATA[-- Access data from:
-- `logistics-data-storage-staging.pricing_multi_armed_bandit.mab_bayesian_updating_results`

-- `logistics-data-storage-staging.pricing_multi_armed_bandit.mab_dps_payload`

-- `logistics-data-storage-staging.pricing_multi_armed_bandit.mab_new_variant`


WITH parse AS(
SELECT 
         created_at
       , created_date
       , analysed_date
       , entity_id
       , test_name
       , test_id
       , JSON_VALUE(dps_payload, '$.target_kpi') AS target_kpi
       , JSON_VALUE(kpi, '$.name') AS kpi
       , JSON_VALUE(variant, '$.variant_name') AS variant_name
       , JSON_VALUE(variant, '$.winning_probability') AS winning_probability

  FROM `logistics-data-storage-staging.pricing_multi_armed_bandit.mab_dps_payload`, --`log-data-science-production.pricing_multi_armed_bandit.mab_dps_payload`,
  UNNEST(CAST(JSON_QUERY_ARRAY(dps_payload, '$.kpis') AS ARRAY<<STRING>>)) AS kpi,
  UNNEST(CAST(JSON_QUERY_ARRAY(kpi, '$.winning_variant_probabilities') AS ARRAY<<STRING>>)) AS variant
),

dps_exp AS(
SELECT
          A.name test_name
        , A.id
        , A.country_code
        , date(max(updated_at)) created_date
        , JSON_EXTRACT_SCALAR(variant_share, '$.variant') variant
        , CAST(JSON_EXTRACT_SCALAR(variant_share, '$.share') as numeric) share

FROM `fulfillment-dwh-production.hl.dynamic_pricing_experiment` A, 
 UNNEST(JSON_EXTRACT_ARRAY(shares, '$.variant_shares')) AS variant_share
WHERE LOWER(experiment_type)="ab_mab"
AND created_at>>='2023-01-01'
AND already_executed = TRUE
GROUP BY ALL
),

base AS(
  SELECT 
         -- From 'ds_pricing_multi_armed_bandit_mab_bayesian_updating_results'
          bay.created_date
        , bay.created_at
        , MAX(bay.analysed_date) AS analysed_date
        , bay.entity_id
        , bay.test_id -- changed to deagregated
        , bay.test_name
        , MAX(bay.version) AS version
        , bay.target_kpi AS kpi
        , AVG(bay.p_var_greater_all) AS winning_probability
        , bay.variant AS variant_name
        , AVG(bayesian_mean) AS bayesian_mean
        , AVG(lower_quartile) AS lower_quartile
        , AVG(upper_quartile) AS upper_quartile
        , AVG(bay.hdi_lower_bound) AS hdi_lower_bound
        , AVG(bay.hdi_upper_bound) AS hdi_upper_bound

        -- From 'pricing_multi_armed_bandit.mab_dps_payload'
       , MAX(p.target_kpi) AS target_kpi
       
       --From `fulfillment-dwh-production.hl.dynamic_pricing_experiment`
       , AVG(share) AS share

FROM `fulfillment-dwh-production.dl.ds_pricing_multi_armed_bandit_mab_bayesian_updating_results` bay
  LEFT JOIN parse p
  ON   p.entity_id = bay.entity_id
      AND p.created_date = bay.created_date
      AND p.test_name = bay.test_name
      AND p.test_id = bay.test_id
      AND p.kpi = bay.target_kpi
      AND p.variant_name = bay.variant
  
  LEFT JOIN dps_exp dps
  ON  dps.country_code = bay.country_code
      AND dps.test_name = bay.test_name
      AND dps.id = bay.test_id
      AND dps.created_date = bay.created_date
      AND dps.variant = bay.variant

WHERE bay.test_name IN(
	SELECT test_name
	FROM dps_exp
)


GROUP BY ALL
),

base2 AS(
SELECT 
  created_date
, created_at
, analysed_date
, entity_id
, test_id
, test_name
, version
, kpi
, winning_probability
, variant_name
, bayesian_mean
, hdi_lower_bound
, hdi_upper_bound
, lower_quartile
, upper_quartile
, target_kpi
, COALESCE(share, LAST_VALUE(share IGNORE NULLS) OVER(PARTITION BY entity_id, test_name, kpi, variant_name ORDER BY created_date ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)) AS share

FROM base
)




-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

-- Generate dates and value for 3 days before each test starts
, enriched_data AS(
    SELECT 
        created_date,
        created_at,
        entity_id,
        test_name,
        test_id,
        version,
        target_kpi,
        kpi,
        variant_name,
        share,
        hdi_lower_bound,
        hdi_upper_bound,
        FIRST_VALUE(created_date) OVER (PARTITION BY entity_id, test_name, kpi ORDER BY created_date ASC) AS first_created_date,
        COUNT(DISTINCT variant_name) OVER (PARTITION BY entity_id, test_name, kpi, created_date) AS variant_count,
    FROM base
),

processed_data1 AS(
SELECT 
    DATE_SUB(first_created_date, INTERVAL 1 DAY) AS created_date,  -- Shift date back
    MAX(created_at) AS created_at,
    DATE_SUB(first_created_date, INTERVAL 3 DAY) AS analysed_date,
    entity_id,
    MIN(test_id) AS test_id,
    test_name,
    MIN(version) AS version,
    kpi,
    1.0 / variant_count AS winning_probability,  -- Compute new Bayesian mean
    variant_name,
    NULL AS bayesian_mean,
    NULL AS hdi_lower_bound,
    NULL AS hdi_upper_bound,
    NULL AS lower_quartile,
    NULL AS upper_quartile,
    ANY_VALUE(target_kpi) AS target_kpi,
    NULL AS share,
    --NULL AS uplift_percentage

FROM enriched_data
GROUP BY entity_id, test_name, kpi, variant_name, first_created_date, variant_count
),

processed_data2 AS(
SELECT 
    DATE_SUB(first_created_date, INTERVAL 2 DAY) AS created_date,  -- Shift date back
    MAX(created_at) AS created_at,
    DATE_SUB(first_created_date, INTERVAL 4 DAY) AS analysed_date,
    entity_id,
    MIN(test_id) AS test_id,
    test_name,
    MIN(version) AS version,
    kpi,
    1.0 / variant_count AS winning_probability,  -- Compute new Bayesian mean
    variant_name,
    NULL AS bayesian_mean,
    NULL AS hdi_lower_bound,
    NULL AS hdi_upper_bound,
    NULL AS lower_quartile,
    NULL AS upper_quartile,
    ANY_VALUE(target_kpi) AS target_kpi,
    NULL AS share,
    --NULL AS uplift_percentage

FROM enriched_data
GROUP BY entity_id, test_name, kpi, variant_name, first_created_date, variant_count
),

processed_data3 AS(
SELECT 
    DATE_SUB(first_created_date, INTERVAL 3 DAY) AS created_date,  -- Shift date back
    MAX(created_at) AS created_at,
    DATE_SUB(first_created_date, INTERVAL 5 DAY) AS analysed_date,
    entity_id,
    MIN(test_id) AS test_id,
    test_name,
    MIN(version) AS version,
    kpi,
    1.0 / variant_count AS winning_probability,  -- Compute new Bayesian mean
    variant_name,
    NULL AS bayesian_mean,
    NULL AS hdi_lower_bound,
    NULL AS hdi_upper_bound,
    NULL AS lower_quartile,
    NULL AS upper_quartile,
    ANY_VALUE(target_kpi) AS target_kpi,
    NULL AS share,
    --NULL AS uplift_percentage

FROM enriched_data
GROUP BY entity_id, test_name, kpi, variant_name, first_created_date, variant_count
)

-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
, union_tabs AS(
-- Adding the generated date tables to the base table
SELECT *
FROM base2

UNION ALL
SELECT * FROM processed_data1
UNION ALL
SELECT * FROM processed_data2
UNION ALL
SELECT * FROM processed_data3
)

SELECT  created_date
        , created_at
        , analysed_date
        , entity_id
        , test_id
        , test_name
        , version
        , kpi
        , winning_probability
        , variant_name
        , bayesian_mean
        , hdi_lower_bound
        , hdi_upper_bound
        , lower_quartile
        , upper_quartile
        , target_kpi
        
        --replace NULL for the first days of share -- still need to automate the diff between MIN(created_date) and first_date of variant record, to automate the interval
, CASE WHEN created_date << (MIN(created_date) OVER(PARTITION BY entity_id, test_name, kpi ORDER BY created_date) + interval 6 day) THEN COALESCE(100 / COUNT(variant_name) OVER(PARTITION BY entity_id, test_name, kpi, created_date))
      ELSE share END AS share
FROM union_tabs 

ORDER BY entity_id, test_name, kpi, created_date, variant_name]]></relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Prio_test_kpi' inline='true' name='federated.0qy7fuu0mls29015oj85r0csj6tz' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1f0tzdd09k8cbv10q33dw1fziycy'>
            <connection CATALOG='publicdata' EXECCATALOG='logistics-customer-staging' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='publicdata' schema='samples' server-oauth='server-custom' username='bertrand.flanet@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1f0tzdd09k8cbv10q33dw1fziycy' name='Custom SQL Query' type='text'>WITH prio_orders AS (
  SELECT 
  entity_id, 
  platform_order_code,
  priority_fee_eur,
  priority_fee_local,
  FROM `logistics-data-storage-staging.shared_pricing.prio_orders` 
  WHERE created_date_local &gt;&gt;= &apos;2024-11-01&apos;
  AND entity_id IN (&apos;FP_TW&apos;, &apos;PY_DO&apos;, &apos;PY_PE&apos;, &apos;PY_CL&apos;, &apos;PY_AR&apos;)
  AND has_dps_priority_fee IS TRUE
)

, base_orders AS (
  SELECT
  created_date,
  region,
  entity_id,
  perseus_client_id, 
  DATE(created_date) order_date,
  zone_name,
  test_name,
  platform_order_code,
  test_variant,
  is_in_treatment,
  ROUND(mean_delay) as mean_delay, 
  ROUND(actual_delivery_time) as delivery_time,
  dps_delivery_fee_local,
  gfv_local,
  dps_priority_fee_local,
  dps_priority_fee_eur
  FROM `fulfillment-dwh-production.cl.dps_test_orders`
  WHERE created_date &gt;&gt;= &apos;2024-11-01&apos;
  AND entity_id IN (&apos;FP_TW&apos;, &apos;PY_DO&apos;, &apos;PY_PE&apos;, &apos;PY_CL&apos;, &apos;PY_AR&apos;)
  AND test_name IN( &apos;CL_20241128_R_K0_R_Prio_Fee_MAB&apos;, 
                    &apos;DO_20241209_Z_K0_R_Santo_Domingo_MAB&apos;, 
                    &apos;DO_20250118_Z_K0_R_Santiago_Priority_MAB_Var_Gen_M&apos;, 
                    &apos;AR_20250314_Z_K0_R_PF_Alta_Cordoba_MAB_Var_Gen&apos;, 
                    &apos;TW_20250313_Z_K0_O_MAB_Priority&apos;, 
                    &apos;TW_20250313_Z_K0_O_MAB_Priority_Other_Cities&apos;)
  AND vendor_vertical_parent NOT IN (&apos;courier&apos;, &apos;courier_business&apos;)
  AND dps_priority_fee_local is not null
  AND dps_priority_fee_local IS NOT NULL
  AND is_sent
  AND is_own_delivery
  AND platform_order_code IS NOT NULL
)

, joined_orders AS (
  SELECT 
  dps.*,
  IFNULL(prio.priority_fee_local,0) priority_fee_local,
  IFNULL(prio.priority_fee_eur,0) priority_fee_eur
  FROM base_orders dps
  LEFT JOIN prio_orders prio 
  ON dps.entity_id = prio.entity_id
  AND dps.platform_order_code = prio.platform_order_code
)

SELECT 
order_date,
entity_id,
test_name,
test_variant,
MIN(order_date) as start_date,
MAX(order_date) as end_date,
COUNT(platform_order_code) as orders,
COUNT(CASE WHEN priority_fee_local &gt;&gt; 0 THEN platform_order_code END) as prio_order,
COUNT(CASE WHEN priority_fee_local &gt;&gt; 0 THEN platform_order_code END)/COUNT(platform_order_code) as adoption,
SUM(priority_fee_local) AS prio_fee_revenue,
SUM(priority_fee_eur) AS prio_fee_revenue_eur
FROM joined_orders
GROUP BY test_name, test_variant, entity_id, order_date</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
