      <date-options start-of-week='monday' />
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_9CDCEFDDE71D43679C40EA332DFE3CCA'>
            <properties context=''>
              <relation connection='bigquery.1f0tzdd09k8cbv10q33dw1fziycy' name='Custom SQL Query' type='text'>WITH prio_orders AS (
  SELECT 
  entity_id, 
  platform_order_code,
  priority_fee_eur,
  priority_fee_local,
  FROM `logistics-data-storage-staging.shared_pricing.prio_orders` 
  WHERE created_date_local &gt;&gt;= &apos;2024-11-01&apos;
  AND entity_id IN (&apos;FP_TW&apos;, &apos;PY_DO&apos;, &apos;PY_PE&apos;, &apos;PY_CL&apos;, &apos;PY_AR&apos;)
  AND has_dps_priority_fee IS TRUE
)

, base_orders AS (
  SELECT
  created_date,
  region,
  entity_id,
  perseus_client_id, 
  DATE(created_date) order_date,
  zone_name,
  test_name,
  platform_order_code,
  test_variant,
  is_in_treatment,
  ROUND(mean_delay) as mean_delay, 
  ROUND(actual_delivery_time) as delivery_time,
  dps_delivery_fee_local,
  gfv_local,
  dps_priority_fee_local,
  dps_priority_fee_eur
  FROM `fulfillment-dwh-production.cl.dps_test_orders`
  WHERE created_date &gt;&gt;= &apos;2024-11-01&apos;
  AND entity_id IN (&apos;FP_TW&apos;, &apos;PY_DO&apos;, &apos;PY_PE&apos;, &apos;PY_CL&apos;, &apos;PY_AR&apos;)
  AND test_name IN( &apos;CL_20241128_R_K0_R_Prio_Fee_MAB&apos;, 
                    &apos;DO_20241209_Z_K0_R_Santo_Domingo_MAB&apos;, 
                    &apos;DO_20250118_Z_K0_R_Santiago_Priority_MAB_Var_Gen_M&apos;, 
                    &apos;AR_20250314_Z_K0_R_PF_Alta_Cordoba_MAB_Var_Gen&apos;, 
                    &apos;TW_20250313_Z_K0_O_MAB_Priority&apos;, 
                    &apos;TW_20250313_Z_K0_O_MAB_Priority_Other_Cities&apos;)
  AND vendor_vertical_parent NOT IN (&apos;courier&apos;, &apos;courier_business&apos;)
  AND dps_priority_fee_local is not null
  AND dps_priority_fee_local IS NOT NULL
  AND is_sent
  AND is_own_delivery
  AND platform_order_code IS NOT NULL
)

, joined_orders AS (
  SELECT 
  dps.*,
  IFNULL(prio.priority_fee_local,0) priority_fee_local,
  IFNULL(prio.priority_fee_eur,0) priority_fee_eur
  FROM base_orders dps
  LEFT JOIN prio_orders prio 
  ON dps.entity_id = prio.entity_id
  AND dps.platform_order_code = prio.platform_order_code
)

SELECT 
order_date,
entity_id,
test_name,
test_variant,
MIN(order_date) as start_date,
MAX(order_date) as end_date,
COUNT(platform_order_code) as orders,
COUNT(CASE WHEN priority_fee_local &gt;&gt; 0 THEN platform_order_code END) as prio_order,
COUNT(CASE WHEN priority_fee_local &gt;&gt; 0 THEN platform_order_code END)/COUNT(platform_order_code) as adoption,
SUM(priority_fee_local) AS prio_fee_revenue,
SUM(priority_fee_eur) AS prio_fee_revenue_eur
FROM joined_orders
GROUP BY test_name, test_variant, entity_id, order_date</relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
