[Parameters].[Parameter 2]=&apos;Lifetime&apos; AND
 (([Darkstores Last16W Order Counts (copy)_355291800576163854]&gt;0 OR [Darkstores Lifetime Order Counts (copy)_355291800594341942]&gt;0) ) AND [profile_night_time_drinkers]=\&quot;1\&quot;
