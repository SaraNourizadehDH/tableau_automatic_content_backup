            <attributes>
              <attribute datatype='integer' name='field-type'>0</attribute>
              <attribute datatype='string' name='formula'>&quot;IF 
[Parameters].[Parameter 4]=&apos;Quick Commerce&apos;
  THEN (
             IF 
              [Parameters].[Parameter 1]= &apos;Discount sum&apos; THEN SUM([Darkstores Lifetime  ABV (copy)_355291800578986002]+[Darkstores Lifetime  Discount Sums (copy)_355291800581550122])/SUM([Lastyear Order Count (copy)_2764576880137015312])*100
