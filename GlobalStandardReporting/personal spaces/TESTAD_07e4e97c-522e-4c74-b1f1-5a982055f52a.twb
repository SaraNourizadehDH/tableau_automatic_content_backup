             ELSEIF 
              [Parameters].[Parameter 1] = &apos;Order count&apos; then SUM([Darkstores Last16W Order Counts (copy)_355291800576163854]+[Darkstores Lifetime Order Counts (copy)_355291800594341942])
             ELSEIF 
              [Parameters].[Parameter 1] = &apos;Qty ordered&apos; then SUM([Darkstores Lifetime  ABV (copy)_355291800580624412]+[Darkstores Lifetime  Qty Ordered sums (copy)_355291800581550124])/SUM([Lastyear Order Count (copy)_2764576880137015312])
             ELSEIF 
              [Parameters].[Parameter 1] = &apos;Voucher sum&apos; then SUM([Darkstores Lifetime Voucher Sums (copy)_469289168638087186]+[Darkstores Lifetime Voucher Order Counts (copy)_469289168640339992])/SUM([Lastyear Order Count (copy)_2764576880137015312])
             ELSEIF 
              [Parameters].[Parameter 1] = &apos;Unique Customers&apos; then COUNTD([Calculation_1422856010755297281])

END
)
ELSEIF 
[Parameters].[Parameter 4]=&apos;Dmart&apos;
THEN   (
             IF 
              [Parameters].[Parameter 1]= &apos;Discount sum&apos; THEN SUM([Darkstores Lifetime  ABV (copy)_355291800578986002])/SUM([Darkstores Last16W Order Counts (copy)_355291800576163854])*100
             ELSEIF 
              [Parameters].[Parameter 1] = &apos;ABV&apos; then SUM([Darkstores Last16W ABV (copy) (copy 3)_355291800574345228])/SUM([Darkstores Last16W Order Counts (copy)_355291800576163854])
             ELSEIF 
              [Parameters].[Parameter 1] = &apos;Order count&apos; then SUM([Darkstores Last16W Order Counts (copy)_355291800576163854])
             ELSEIF 
              [Parameters].[Parameter 1] = &apos;Qty ordered&apos; then SUM([Darkstores Lifetime  ABV (copy)_355291800580624412])/SUM([Darkstores Last16W Order Counts (copy)_355291800576163854])
             ELSEIF 
              [Parameters].[Parameter 1] = &apos;Voucher sum&apos; then SUM([Darkstores Lifetime Voucher Sums (copy)_469289168638087186])/SUM([Darkstores Last16W Order Counts (copy)_355291800576163854])
             ELSEIF 
              [Parameters].[Parameter 1] = &apos;Unique Customers&apos; then COUNTD([Calculation_1422856010755297281])

END
)
ELSEIF  
[Parameters].[Parameter 4]=&apos;Localstores&apos;
  THEN   (
             IF 
              [Parameters].[Parameter 1]= &apos;Discount sum&apos; THEN SUM([Darkstores Lifetime  Discount Sums (copy)_355291800581550122])/SUM([Darkstores Lifetime Order Counts (copy)_355291800594341942])*100
             ELSEIF 
              [Parameters].[Parameter 1] = &apos;ABV&apos; then SUM([Darkstores Lifetime  ABV (copy)_355291800585158704])/SUM([Darkstores Lifetime Order Counts (copy)_355291800594341942])
             ELSEIF 
              [Parameters].[Parameter 1] = &apos;Order count&apos; then SUM([Darkstores Lifetime Order Counts (copy)_355291800594341942])
             ELSEIF 
