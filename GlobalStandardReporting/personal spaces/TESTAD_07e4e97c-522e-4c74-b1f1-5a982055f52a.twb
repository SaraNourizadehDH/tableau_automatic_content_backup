             ELSEIF 
              [Parameters].[Parameter 1] = &apos;Voucher sum&apos; then SUM([Darkstores Lifetime Voucher Order Counts (copy)_469289168640339992])/SUM([Darkstores Lifetime Order Counts (copy)_355291800594341942])
             ELSEIF 
              [Parameters].[Parameter 1] = &apos;Unique Customers&apos; then COUNTD([Calculation_1422856010755297281])

END
)

END&quot;</attribute>
