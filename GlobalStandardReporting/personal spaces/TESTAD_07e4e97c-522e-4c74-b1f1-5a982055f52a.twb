ElSEIF 
[Parameters].[Parameter 2]=&apos;Lifetime&apos; 

THEN  SUM(([darkstores_last4w_weekday_order_counts (copy) (copy) (copy)_2504212503524044802]+ [localstores_last16w_weekday_order_counts (copy) (copy) (copy) (copy)_2504212503555391498]))/SUM([Lastyear Order Count (copy)_2764576880137015312])
END)
ElSEIF 
[Parameters].[Parameter 4]=&apos;Dmart&apos;
THEN (IF
[Parameters].[Parameter 2]=&apos;1 week&apos; 

