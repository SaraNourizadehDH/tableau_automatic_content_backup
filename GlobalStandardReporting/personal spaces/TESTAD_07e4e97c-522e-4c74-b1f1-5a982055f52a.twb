[Parameters].[Parameter 2]=&apos;Lifetime&apos; 

THEN  SUM(([darkstores_last4w_weekday_order_counts (copy) (copy) (copy)_2504212503524044802] ))/SUM([Darkstores Last16W Order Counts (copy)_355291800576163854])
