    <dashboard name='L1 Without - With Basket Comparison'>
      <repository-location id='L1Without-WithBasketComparison' path='/t/GlobalStandardReporting/workbooks/SKUOptimizationWIP_16251254177330' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='900' maxwidth='1500' minheight='900' minwidth='1500' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='_tableau_sku_optimization_scores_rationalizer' name='federated.010rk66132xq971f6gqq80zez27o' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Cutoff Point (Percentile)' datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='10.'>
          <calculation class='tableau' formula='10.' />
          <range max='100.0' min='0.0' />
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.010rk66132xq971f6gqq80zez27o'>
        <column caption='Business Risk Score (L1)' datatype='real' name='[Calculation_827043916911669251]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='([business_kpi]/[Calculation_827043916911169536])*100' />
        </column>
        <column caption='Customer Risk Score (L1)' datatype='real' name='[Calculation_827043916913586190]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='([sku_category1_trips_fraction]/[Max Business Risk Score (L1) (copy)_827043916912672774])*100' />
        </column>
        <column caption='Customer Risk Score (L1-Basket)' datatype='real' name='[Customer Risk Score (L1) (copy)_827043916913672207]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='([sku_category1_trips_fraction_basket]/[Max Cat 1 Trip Fraction (copy)_827043916912865287])*100' />
        </column>
        <column caption='Days in Assortment' datatype='integer' name='[SKU_age]' role='measure' type='quantitative' />
        <column caption='Availability' datatype='real' default-format='p0.0%' name='[availability]' role='measure' type='quantitative' />
        <column caption='Category Level 1' datatype='string' name='[category_level_one]' role='dimension' type='nominal' />
        <column caption='Category Level 3' datatype='string' name='[category_level_three]' role='dimension' type='nominal' />
        <column caption='Category Level 2' datatype='string' name='[category_level_two]' role='dimension' type='nominal' />
        <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
        <column-instance column='[SKU_age]' derivation='None' name='[none:SKU_age:qk]' pivot='key' type='quantitative' />
        <column-instance column='[category_level_one]' derivation='None' name='[none:category_level_one:nk]' pivot='key' type='nominal' />
        <column-instance column='[category_level_three]' derivation='None' name='[none:category_level_three:nk]' pivot='key' type='nominal' />
        <column-instance column='[category_level_two]' derivation='None' name='[none:category_level_two:nk]' pivot='key' type='nominal' />
        <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_827043916911669251]' derivation='Sum' name='[sum:Calculation_827043916911669251:qk]' pivot='key' type='quantitative' />
        <column-instance column='[Calculation_827043916913586190]' derivation='Sum' name='[sum:Calculation_827043916913586190:qk]' pivot='key' type='quantitative' />
        <column-instance column='[Customer Risk Score (L1) (copy)_827043916913672207]' derivation='Sum' name='[sum:Customer Risk Score (L1) (copy)_827043916913672207:qk]' pivot='key' type='quantitative' />
        <column-instance column='[availability]' derivation='Sum' name='[sum:availability:qk]' pivot='key' type='quantitative' />
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98222' id='3' param='horz' type-v2='layout-flow' w='12860' x='85532' y='889'>
            <zone h='98222' id='5' param='vert' type-v2='layout-flow' w='12860' x='85532' y='889'>
              <zone h='5778' id='21' mode='checkdropdown' name='Level 1 Calculation (2)' param='[federated.010rk66132xq971f6gqq80zez27o].[none:global_entity_id:nk]' show-apply='true' type-v2='filter' values='all' w='12860' x='85532' y='889'>
