          <alias key='&quot;[federated.010rk66132xq971f6gqq80zez27o].[sum:Customer Risk Score (L3) (copy)_827043916914118676:qk]&quot;' value='Importance to Customers' />
        </aliases>
      </column>
      <column caption='Business Risk Score (L2) ' datatype='real' name='[Business Risk Score (L1) (copy)_827043916911779844]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([business_kpi1]/[Max Business Risk Score (L1) (copy)_827043916911443969])*100' />
      </column>
      <column caption='Business Risk Score (L3)' datatype='real' name='[Business Risk Score (L2)  (copy)_827043916911984645]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([business_kpi1]/[Max Business Risk Score (L2)  (copy)_827043916911525890])*100' />
      </column>
      <column caption='L Indicator' datatype='string' name='[Business Risk Score (copy)_2071233676042940420]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2071233676040642560] &gt;= 1000 THEN &apos;L3&apos;&#10;ELSEIF [Calculation_2071233676040642560] &lt; 1000 AND [Calculation_2071233676040642560] &gt;= 100 THEN &apos;L2&apos;&#10;ELSE &apos;L1&apos; END' />
      </column>
      <column caption='Days On Hand' datatype='real' name='[Calculation_1087478598241906688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([book_value]) / SUM([cogs_eur])' />
      </column>
      <column caption='Spoilage %' datatype='real' name='[Calculation_1087478598242181122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([shrinkage_eur_expired]) / SUM([gmv_eur])' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_150026164713431040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN &apos;Euro&apos; THEN [gmv_eur] ELSE [gmv_lc] END' />
      </column>
      <column caption='Combined Score (B1+C3B)' datatype='real' name='[Calculation_155233515938582529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(0.5*[Calculation_827043916911669251]) + (0.5*[Customer Risk Score (L3) (copy)_827043916914118676])' />
      </column>
      <column caption='Avg Sales Price' datatype='real' name='[Calculation_155233515939696643]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN &apos;Euro&apos; THEN [avg_price_eur] ELSE [avg_price_lc] END' />
      </column>
      <column caption='SKUs by Country, Category 1' datatype='integer' name='[Calculation_2071233676040642560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id],[category_level_one]: COUNTD([sku])}' />
      </column>
      <column caption='Front Margin Euro' datatype='real' name='[Calculation_2980186753055137792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_sku_sales_eur_l6Mon]) - sum([cogs_eur])' />
      </column>
      <column caption='Front Margin' datatype='real' name='[Calculation_2980186753055703042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE  [Parameters].[Parameter 2] WHEN &apos;Euro&apos; THEN [Calculation_2980186753055137792] ELSE [Front Margin Euro (copy)_2980186753055342593] END' />
      </column>
      <column caption='Front Margin %' datatype='real' name='[Calculation_2980186753056079875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(zn([total_sku_sales_eur_l6Mon]) - zn([cogs_eur]))/zn([total_sku_sales_eur_l6Mon])' />
      </column>
      <column caption='category combined' datatype='string' name='[Calculation_5385601477152006144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[category_level_one] + [category_level_two] + [category_level_three]' />
      </column>
      <column caption='LN GMV' datatype='real' name='[Calculation_594052938969104384]' role='measure' type='quantitative'>
