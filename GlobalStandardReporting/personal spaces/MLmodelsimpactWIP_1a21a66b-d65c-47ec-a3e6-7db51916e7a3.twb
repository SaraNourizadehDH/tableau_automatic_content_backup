      </column>
      <column caption='Reference date aggregate' datatype='string' name='[Calculation_6586021937357471745]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//DATETRUNC([Timeframe],[Reference Date],&apos;monday&apos;)&#10;&#10;CASE [Parameters].[Parameter 1]&#10;WHEN &apos;day&apos; THEN STR([reference_date])&#10;WHEN &apos;week&apos; THEN &apos;W&apos;+DATENAME(&apos;week&apos;, [reference_date],&apos;monday&apos;) &#10;WHEN &apos;month&apos; THEN LEFT(DATENAME(&apos;month&apos;, [reference_date]),3) + &apos; &apos; + DATENAME(&apos;year&apos;, [reference_date]) &#10;WHEN &apos;quarter&apos; THEN &apos;Q&apos;+DATENAME(&apos;quarter&apos;, [reference_date]) + &apos; &apos; + DATENAME(&apos;year&apos;, [reference_date])&#10;WHEN &apos;year&apos; THEN DATENAME(&apos;year&apos;, [reference_date])&#10;ELSE Null&#10;End' />
      </column>
      <column caption='Reference date MAX' datatype='date' name='[Calculation_6586021937375784963]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MAX([reference_date])}' />
      </column>
      <column caption='Period' datatype='string' name='[Calculation_6586021937375932421]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DAY([Reference date MAX (copy)_6586021937375858692]))+&apos;.&apos;+STR(MONTH([Reference date MAX (copy)_6586021937375858692])) +&apos;.&apos;+STR(YEAR([Reference date MAX (copy)_6586021937375858692]))&#10;+ &apos; to &apos; + &#10;STR(DAY([Calculation_6586021937375784963]))+&apos;.&apos;+STR(MONTH([Calculation_6586021937375784963])) +&apos;.&apos;+STR(YEAR([Calculation_6586021937375784963]))' />
      </column>
      <column caption='is_matured' datatype='boolean' name='[Calculation_6586021937377484807]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[is_matured]&gt;0' />
      </column>
      <column caption='Reference date MIN' datatype='date' name='[Reference date MAX (copy)_6586021937375858692]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{MIN([reference_date])}' />
      </column>
