      <aliases enabled='yes' />
      <column caption='# HeroCare Work Items' datatype='integer' name='[# FreshChat Work Item (copy)_197384330000404491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [crm_app]=&quot;HeroCare&quot; THEN [work_item_count] END)' />
      </column>
      <column caption='# Mercury Work Items' datatype='integer' name='[# HeroCare Work Item (copy)_197384330000560140]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [product_version]=&quot;Mercury&quot; THEN [work_item_count] END)' />
      </column>
      <column caption='# Salesforce Work Items' datatype='integer' name='[# HeroCare Work Item (copy)_197384330000863246]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [crm_app]=&quot;Salesforce&quot; THEN [work_item_count] END)' />
      </column>
      <column caption='# mini1VU Work Items' datatype='integer' name='[# Mercury Work Item (copy)_197384330000748557]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [product_version]=&quot;mini1VU&quot; THEN [work_item_count] END)' />
      </column>
      <column caption='# United UI Work Items' datatype='integer' name='[# Salesforce Work Item (copy)_197384330001047567]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;CASE [product_version]&#10;    WHEN &apos;United UI&apos; THEN [work_item_count]&#10;END)' />
      </column>
      <column caption='FreshChat aTHT (live)' datatype='real' name='[AHT (copy)_1300695895965446146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [crm_app]=&quot;FreshChat&quot; AND [contact_channel] IN (&quot;Chat&quot;, &quot;Call&quot;) THEN [sum_handling_time_minutes]END)&#10;/SUM(IF [crm_app]=&quot;FreshChat&quot; AND [contact_channel] IN (&quot;Chat&quot;, &quot;Call&quot;) THEN [work_item_count]END)' />
      </column>
      <column caption='AHT (non-live)' datatype='real' name='[AHT (live) (copy)_1158410295429689344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM(IF NOT [contact_channel] IN (&quot;Chat&quot;,&quot;Call&quot;)  THEN [sum_handling_time_minutes] END)&#10;/SUM(IF NOT [contact_channel]IN (&quot;Chat&quot;,&quot;Call&quot;)  THEN[work_item_count]END),2)' />
      </column>
      <column caption='Chat (live)' datatype='real' name='[AHT/aTHT (copy)_8270860744434978817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM(IF [contact_channel]= &quot;Chat&quot; THEN [sum_handling_time_minutes]END)&#10;/SUM(IF [contact_channel] = &quot;Chat&quot; THEN[work_item_count] END),2)' />
      </column>
      <column caption='Time Range' datatype='string' name='[Calculation_197384329998696448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Day&quot; THEN STR([created_date])&#10;WHEN &quot;Week&quot; THEN [created_week]&#10;WHEN &quot;Month&quot; THEN [created_month]&#10;END' />
      </column>
      <column caption='Date Range' datatype='date' name='[Calculation_197384329998749697]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[created_date]' />
      </column>
      <column caption='Selected Dimension' datatype='string' name='[Calculation_197384329999138818]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10; WHEN &apos;Product Version&apos; THEN [product_version]&#10; WHEN &apos;Crm App&apos; THEN [crm_app]&#10;END' />
      </column>
      <column caption='is_current_date' datatype='boolean' name='[Calculation_197384329999265795]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;,[created_date]) = &#10;&#10;{MAX(DATETRUNC(&apos;day&apos;,[created_date]))}' />
      </column>
      <column caption='is_current_month' datatype='boolean' name='[Calculation_197384329999405060]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [created_month]: MAX([created_date])} = {FIXED: MAX([created_date])}' />
      </column>
      <column caption='is_current_week' datatype='boolean' name='[Calculation_197384329999519749]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [created_week]: MAX([created_date])} = {FIXED: MAX([created_date])}' />
      </column>
      <column caption='is_previous_date' datatype='boolean' name='[Calculation_197384329999597574]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;,[created_date]) = &#10;&#10;{MAX(DATETRUNC(&apos;day&apos;,[created_date]))} - 1' />
      </column>
      <column caption='is_previous_month' datatype='boolean' name='[Calculation_197384329999704071]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT [Calculation_197384329999405060]&#10;AND&#10;{FIXED [created_month]: MAX([created_date])} = {FIXED [Calculation_197384329999405060]: MAX([created_date])}' />
      </column>
      <column caption='is_previous_week' datatype='boolean' name='[Calculation_197384329999802376]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT [Calculation_197384329999519749]&#10;AND&#10;{FIXED [created_week]: MAX([created_date])} = {FIXED [Calculation_197384329999519749]: MAX([created_date])}' />
      </column>
      <column caption='FreshChat %' datatype='real' name='[Calculation_197384330000027657]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [crm_app]=&quot;FreshChat&quot; THEN [work_item_count] END)&#10;/SUM([work_item_count])' />
      </column>
      <column caption='# FreshChat Work Items' datatype='integer' name='[Calculation_197384330000293898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [crm_app]=&quot;FreshChat&quot; THEN [work_item_count] END)' />
