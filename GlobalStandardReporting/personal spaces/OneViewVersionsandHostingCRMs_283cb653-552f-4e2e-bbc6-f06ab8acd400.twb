              <calculation class='tableau' formula='SUM(IF [crm_app]=&quot;FreshChat&quot; AND [contact_channel] IN (&quot;Chat&quot;, &quot;Call&quot;) THEN [sum_handling_time_minutes]END)&#10;/SUM(IF [crm_app]=&quot;FreshChat&quot; AND [contact_channel] IN (&quot;Chat&quot;, &quot;Call&quot;) THEN [work_item_count]END)' />
