            <column caption='Chat (live)' datatype='real' name='[AHT/aTHT (copy)_8270860744434978817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(IF [contact_channel]= &quot;Chat&quot; THEN [sum_handling_time_minutes]END)&#10;/SUM(IF [contact_channel] = &quot;Chat&quot; THEN[work_item_count] END),2)' />
            </column>
            <column caption='Time Range' datatype='string' name='[Calculation_197384329998696448]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Day&quot; THEN STR([created_date])&#10;WHEN &quot;Week&quot; THEN [created_week]&#10;WHEN &quot;Month&quot; THEN [created_month]&#10;END' />
