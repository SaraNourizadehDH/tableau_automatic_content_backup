    <worksheet name='CS:agent'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tableau Regular' fontsize='16'>Customer Service Agent Adoption</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#555555' fontname='Tableau Regular' fontsize='21'><![CDATA[<[federated.0crxz5h1syi4nl163ohfs1oy3y33].[attr:Calculation_3623216271566794755:qk]>]]></run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#19ac23' fontname='Tableau Regular' fontsize='16'><![CDATA[<[federated.0crxz5h1syi4nl163ohfs1oy3y33].[attr:Calculation_3623216271567175687:nk]>]]></run>
            <run fontalignment='1' fontcolor='#ff0000' fontname='Tableau Regular' fontsize='16'><![CDATA[<[federated.0crxz5h1syi4nl163ohfs1oy3y33].[attr:Calculation_3623216271567093766:nk]>]]></run>
            <run bold='true' fontalignment='1' fontcolor='#59a14f' fontname='Tableau Regular'>Æ </run>
            <run bold='true' fontalignment='1' fontcolor='#555555' fontname='Tableau Regular' fontsize='10'><![CDATA[<[federated.0crxz5h1syi4nl163ohfs1oy3y33].[attr:Calculation_3623216271566999557:qk]>]]></run>
            <run fontalignment='1' fontcolor='#555555' fontname='Tableau Regular' fontsize='11'>Æ </run>
            <run fontalignment='1' fontcolor='#555555' fontname='Tableau Regular' fontsize='9'>vs previous week</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='oneview_agents (rl_gcc_service)' name='federated.0crxz5h1syi4nl163ohfs1oy3y33' />
          </datasources>
          <datasource-dependencies datasource='federated.0crxz5h1syi4nl163ohfs1oy3y33'>
            <column caption='is_current_week' datatype='boolean' name='[Calculation_3623216271566413824]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [created_week]: MAX([created_week])} = {FIXED: MAX([created_week])}' />
            </column>
            <column caption='is_previous_week' datatype='boolean' name='[Calculation_3623216271566487553]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT [Calculation_3623216271566413824]&#10;AND&#10;{FIXED [created_week]: MAX([created_week])} = {FIXED [Calculation_3623216271566413824]: MAX([created_week])}' />
            </column>
            <column caption='United UI Agent Adoption %' datatype='real' name='[Calculation_3623216271566610434]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unique_united_ui_agent_count])/SUM([unique_agent_count])' />
            </column>
            <column aggregation='Attribute' caption='United UI Current Agent Adoption %' datatype='real' name='[Calculation_3623216271566794755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE [created_week]:&#10;    (SUM(&#10;    IF [Calculation_3623216271566413824]&#10;    THEN [unique_united_ui_agent_count]&#10;    ELSE 0 END&#10;    ))&#10;&#10;/ SUM(IF [Calculation_3623216271566413824]&#10;    THEN [unique_agent_count]&#10;    ELSE 0 END&#10;    )&#10;}' />
            </column>
            <column aggregation='Attribute' caption='United UI Previous Agent Adoption %' datatype='real' name='[Calculation_3623216271566880772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE [created_week]:&#10;    (SUM(&#10;    IF [Calculation_3623216271566487553]&#10;    THEN [unique_united_ui_agent_count]&#10;    ELSE 0 END&#10;    ))&#10;&#10;/ SUM(IF [Calculation_3623216271566487553]&#10;    THEN [unique_agent_count]&#10;    ELSE 0 END&#10;    )&#10;}' />
            </column>
            <column aggregation='Attribute' caption='United UI Agnet Adoption % Chg' datatype='real' name='[Calculation_3623216271566999557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_3623216271566794755])-([Calculation_3623216271566880772])' />
            </column>
            <column aggregation='Attribute' caption='United UI Agent Adoption Negative % Diff' datatype='string' name='[Calculation_3623216271567093766]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3623216271566999557] &lt; 0&#10;THEN &quot;▼&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column aggregation='Attribute' caption='United UI Agent Adoption Positive % Diff ' datatype='string' name='[Calculation_3623216271567175687]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3623216271566999557] &gt; 0&#10;THEN &quot;▲&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Agent Role Type' datatype='string' name='[agent_role]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3623216271566794755]' derivation='Attribute' name='[attr:Calculation_3623216271566794755:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3623216271566999557]' derivation='Attribute' name='[attr:Calculation_3623216271566999557:qk]' pivot='key' type='quantitative' />
