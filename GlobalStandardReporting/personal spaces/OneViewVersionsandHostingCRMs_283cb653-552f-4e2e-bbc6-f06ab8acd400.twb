          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='oneview_work_items (rl_gcc_service)' name='federated.1alfioy0zrrxjx0zog5el0xhj6iz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1alfioy0zrrxjx0zog5el0xhj6iz'>
            <column caption='Time Range' datatype='string' name='[Calculation_197384329998696448]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Day&quot; THEN STR([created_date])&#10;WHEN &quot;Week&quot; THEN [created_week]&#10;WHEN &quot;Month&quot; THEN [created_month]&#10;END' />
            </column>
            <column caption='Date Range' datatype='date' name='[Calculation_197384329998749697]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[created_date]' />
            </column>
            <column caption='is_current_date' datatype='boolean' name='[Calculation_197384329999265795]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;,[created_date]) = &#10;&#10;{MAX(DATETRUNC(&apos;day&apos;,[created_date]))}' />
            </column>
            <column caption='is_current_month' datatype='boolean' name='[Calculation_197384329999405060]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [created_month]: MAX([created_date])} = {FIXED: MAX([created_date])}' />
            </column>
            <column caption='is_current_week' datatype='boolean' name='[Calculation_197384329999519749]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [created_week]: MAX([created_date])} = {FIXED: MAX([created_date])}' />
            </column>
            <column caption='is_previous_date' datatype='boolean' name='[Calculation_197384329999597574]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;,[created_date]) = &#10;&#10;{MAX(DATETRUNC(&apos;day&apos;,[created_date]))} - 1' />
            </column>
            <column caption='is_previous_month' datatype='boolean' name='[Calculation_197384329999704071]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT [Calculation_197384329999405060]&#10;AND&#10;{FIXED [created_month]: MAX([created_date])} = {FIXED [Calculation_197384329999405060]: MAX([created_date])}' />
            </column>
            <column caption='is_previous_week' datatype='boolean' name='[Calculation_197384329999802376]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT [Calculation_197384329999519749]&#10;AND&#10;{FIXED [created_week]: MAX([created_date])} = {FIXED [Calculation_197384329999519749]: MAX([created_date])}' />
            </column>
            <column aggregation='Attribute' caption='HeroCare Current % ' datatype='real' name='[Calculation_197384330001367057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Week&apos;&#10;THEN &#10;{ EXCLUDE [Calculation_197384329998696448]:&#10;    SUM(&#10;    IF [Calculation_197384329999519749]&#10;    AND [crm_app]=&quot;HeroCare&quot;&#10;    THEN [work_item_count]&#10;    ELSE 0 END&#10;    )&#10;/ &#10; SUM(&#10;    IF [Calculation_197384329999519749]&#10;    THEN [work_item_count]&#10;    ELSE 0 END&#10;    )&#10;}&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;{ EXCLUDE [Calculation_197384329998696448]:&#10;    SUM(&#10;    IF [Calculation_197384329999265795]&#10;    AND [crm_app]=&quot;HeroCare&quot;&#10;    THEN [work_item_count]&#10;    ELSE 0 END&#10;    )&#10;/ &#10; SUM(&#10;    IF [Calculation_197384329999265795]&#10;    THEN [work_item_count]&#10;    ELSE 0 END&#10;    )&#10;}&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;{ EXCLUDE [Calculation_197384329998696448]:&#10;    SUM(&#10;    IF [Calculation_197384329999405060]&#10;    AND [crm_app]=&quot;HeroCare&quot;&#10;    THEN [work_item_count]&#10;    ELSE 0 END&#10;    )&#10;/ &#10; SUM(&#10;    IF [Calculation_197384329999405060]&#10;    THEN [work_item_count]&#10;    ELSE 0 END&#10;    )&#10;}&#10;END' />
            </column>
            <column aggregation='Attribute' caption='HeroCare Previous % ' datatype='real' name='[Calculation_197384330001465362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Week&apos;&#10;THEN &#10;{ EXCLUDE [Calculation_197384329998696448]:&#10;    SUM(&#10;    IF [Calculation_197384329999802376]&#10;    AND [crm_app]=&quot;HeroCare&quot;&#10;    THEN [work_item_count]&#10;    ELSE 0 END&#10;    )&#10;/ &#10; SUM(&#10;    IF [Calculation_197384329999802376]&#10;    THEN [work_item_count]&#10;    ELSE 0 END&#10;    )&#10;}&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;{ EXCLUDE [Calculation_197384329998696448]:&#10;    SUM(&#10;    IF [Calculation_197384329999597574]&#10;    AND [crm_app]=&quot;HeroCare&quot;&#10;    THEN [work_item_count]&#10;    ELSE 0 END&#10;    )&#10;/ &#10; SUM(&#10;    IF [Calculation_197384329999597574]&#10;    THEN [work_item_count]&#10;    ELSE 0 END&#10;    )&#10;}&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;{ EXCLUDE [Calculation_197384329998696448]:&#10;    SUM(&#10;    IF [Calculation_197384329999704071]&#10;    AND [crm_app]=&quot;HeroCare&quot;&#10;    THEN [work_item_count]&#10;    ELSE 0 END&#10;    )&#10;/ &#10; SUM(&#10;    IF [Calculation_197384329999704071]&#10;    THEN [work_item_count]&#10;    ELSE 0 END&#10;    )&#10;}&#10;END' />
            </column>
            <column caption='Herocare % Chg' datatype='real' name='[Calculation_197384330001547283]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_197384330001367057])-SUM([Calculation_197384330001465362]))/SUM([Calculation_197384330001465362])' />
            </column>
            <column caption='HeroCare Negative % Diff ' datatype='string' name='[Calculation_197384330001653780]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_197384330001547283] &lt;= 0&#10;THEN &quot;▼&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='HeroCare Positive % Diff ' datatype='string' name='[Calculation_197384330001698837]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_197384330001547283]&gt; 0&#10;THEN &quot;▲&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='HeroCare %' datatype='real' name='[FreshChat % (copy)_197384330001215504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [crm_app]=&quot;HeroCare&quot; THEN [work_item_count] END)&#10;/SUM([work_item_count])' />
