            <column caption='AHT (non-live)' datatype='real' name='[AHT (live) (copy)_1158410295429689344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(SUM(IF NOT [contact_channel] IN (&quot;Chat&quot;,&quot;Call&quot;)  THEN [sum_handling_time_minutes] END)&#10;/SUM(IF NOT [contact_channel]IN (&quot;Chat&quot;,&quot;Call&quot;)  THEN[work_item_count]END),2)' />
