            <column caption='Minute' datatype='string' datatype-customized='true' name='[Dimension 1 (copy)_1542342163458732032]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(CASE [Parameters].[Parameter 3]&#10; WHEN &apos;Chat (live)&apos; THEN [AHT/aTHT (copy)_8270860744434978817]&#10; WHEN &apos;Call (live)&apos; THEN [aTHT (live) (copy)_3922494567848112128]&#10; WHEN &apos;AHT (non-live)&apos; THEN [AHT (live) (copy)_1158410295429689344]&#10;END)' />
            </column>
            <column caption='Minutes' datatype='real' datatype-customized='true' name='[Value (min) (copy)_3075395624333832193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10; WHEN &apos;Chat (live)&apos; THEN [AHT/aTHT (copy)_8270860744434978817]&#10; WHEN &apos;Call (live)&apos; THEN [aTHT (live) (copy)_3922494567848112128]&#10; WHEN &apos;AHT (non-live)&apos; THEN [AHT (live) (copy)_1158410295429689344]&#10;END' />
