            <member value='&quot;Product Version&quot;' />
          </members>
        </column>
        <column caption='Select AHT/aTHT' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Chat (live)&quot;'>
          <calculation class='tableau' formula='&quot;Chat (live)&quot;' />
          <members>
            <member value='&quot;Chat (live)&quot;' />
            <member value='&quot;AHT (non-live)&quot;' />
            <member value='&quot;Call (live)&quot;' />
          </members>
        </column>
