              </zone>
              <zone h='19428' id='10' name='CS:agent' pane-specification-id='1' param='[federated.0crxz5h1syi4nl163ohfs1oy3y33].[:Measure Names]' type-v2='color' w='23557' x='75792' y='6865'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='11350' id='21' type-v2='text' w='49346' x='651' y='26293'>
                <formatted-text>
                  <run bold='true' fontname='Tableau Regular'>Definitions: </run>
                  <run>Æ&#10;</run>
                  <run fontname='Tableau Regular'>1. </run>
                  <run bold='true' fontname='Tableau Regular'>United UI Agents</run>
                  <run fontname='Tableau Regular'>: Agents who worked on work items in OneView United UI.</run>
                  <run>Æ&#10;</run>
                  <run fontname='Tableau Regular'>2. </run>
                  <run bold='true' fontname='Tableau Regular'># of United UI Agent&apos;s Adoption</run>
                  <run fontname='Tableau Regular'> = Unique Count of United UI Agents.</run>
                  <run>Æ&#10;</run>
                  <run fontname='Tableau Regular'>3. </run>
                  <run bold='true' fontname='Tableau Regular'>United UI Agent Adoption %</run>
                  <run fontname='Tableau Regular'> = Unique Count of United UI Agents / Unique Count of Agents.</run>
                  <run>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='2' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#fefaf1' />
                </zone-style>
              </zone>
              <zone h='11350' id='24' type-v2='text' w='49352' x='49997' y='26293'>
                <formatted-text>
                  <run bold='true' fontname='Tableau Regular'>Notes: </run>
                  <run>Æ&#10;</run>
                  <run fontname='Tableau Regular'>1. </run>
                  <run bold='true' fontname='Tableau Regular'>Only &apos;Week&apos; level date granularity is available.</run>
                  <run>Æ&#10;</run>
                  <run fontname='Tableau Regular'>2. There is overlapping of the agents across stakeholder dimension and our recommendation is not to sum up that as it&apos;ll show&gt;100% having duplicacy issue.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='2' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#fefaf1' />
                </zone-style>
              </zone>
              <zone h='5875' id='74' mode='checkdropdown' name='CS:agent' param='[federated.0crxz5h1syi4nl163ohfs1oy3y33].[none:agent_role:nk]' show-apply='true' type-v2='filter' values='database' w='23557' x='75792' y='990'>
