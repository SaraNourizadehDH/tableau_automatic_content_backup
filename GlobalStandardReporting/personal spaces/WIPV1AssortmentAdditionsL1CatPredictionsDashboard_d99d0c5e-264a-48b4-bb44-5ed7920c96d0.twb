          <alias key='&quot;[federated.0qpsgr005167gq176ow521aiz118].[pcto:ctd:comp_assort_comp_product_name:qk]&quot;' value='% Distribution of Competitor SKUs' />
          <alias key='&quot;[federated.0qpsgr005167gq176ow521aiz118].[pcto:ctd:comp_product_name:qk]&quot;' value='% Distribution of Comp SKUs' />
