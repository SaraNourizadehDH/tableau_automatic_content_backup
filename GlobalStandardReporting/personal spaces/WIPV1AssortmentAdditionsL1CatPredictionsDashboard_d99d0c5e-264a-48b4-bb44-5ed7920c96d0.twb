      <aliases enabled='yes' />
      <column caption='% Matching Competitor' datatype='real' default-format='p0.0%' name='[% Matching (L1) (copy)_3703788504020000771]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([matched_comp_product_name])/COUNTD([master_id])' />
      </column>
      <column caption='% SKU covered by matching' datatype='real' name='[Calculation_2497597870675435520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([matched_master_id])/COUNTD([comp_assort_comp_product_name])' />
      </column>
      <column caption='DH Matched SKU' datatype='boolean' datatype-customized='true' name='[Calculation_2497597870684770305]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [time_level] = &apos;SKU level&apos; AND  NOT(ISNULL([product_name])) THEN TRUE &#10;ELSE FALSE &#10;END' />
      </column>
      <column caption='Rank of Matched DH assortment' datatype='integer' name='[Calculation_296815398985371648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE( COUNTD([matched_master_id]) )'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Is Competitor' datatype='boolean' name='[Calculation_3050485062343933952]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  ISNULL([comp_assort_competitor_name]) THEN FALSE ELSE TRUE END' />
      </column>
      <column caption='Difference (in %)' datatype='real' default-format='p0.00%' name='[Calculation_3263772724385202178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(AVG([comp_country_assrtment_size 1]) - AVG([dh_country_sku_count 1]))/avg([dh_country_sku_count 1])' />
      </column>
      <column caption='% Matching Category' datatype='real' default-format='p0.0%' name='[Calculation_3703788504003756034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([latest_comp_matched_master_id])/COUNTD([master_id])' />
      </column>
      <column caption='SKU Addition Opputunity in Category' datatype='real' name='[Calculation_406449906347806720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([comp_assort_comp_category_prod_count]) - COUNTD([matched_comp_product_name])' />
      </column>
      <column caption='filter DH SKUs' datatype='boolean' name='[Calculation_406449906660376579]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([master_id] ) THEN FALSE ELSE TRUE end' />
      </column>
      <column caption='filter Comp Assort' datatype='boolean' name='[Calculation_406449906672177156]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  ISNULL([comp_assort_competitor_name 1]) THEN FALSE ELSE TRUE END' />
      </column>
      <column caption='DH Brand Name' datatype='string' name='[Calculation_406449906678575109]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([brand_name],&apos;&apos;)' />
      </column>
      <column caption='Comp Prod Review Count' datatype='string' name='[Comp Assort Prod Review Count (copy)_509891971264028672]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([comp_assort_prod_review_count 1])  THEN STR([comp_assort_prod_review_count 1])&#10;ELSE &apos;&apos; END' />
      </column>
      <column caption='Comp Prod Review Rating' datatype='string' name='[Comp Assort Prod Review Rating (copy)_509891971266027521]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([comp_assort_prod_review_rating 1])  THEN STR([comp_assort_prod_review_rating 1])&#10;ELSE &apos;&apos; END' />
      </column>
      <column caption='Competitor Category ' datatype='string' name='[Competitor Category (copy)_2719259422281711616]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([comp_assort_comp_category 1],&apos;&apos;)' />
      </column>
      <column caption='DH PIM L1 Category' datatype='string' name='[DH PIM L1 Category (copy)_3268065250779426817]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([pim_l1_category 1],&apos;&apos;)' />
