      <column caption='# Orders (SDL2W)' datatype='integer' name='[# Orders (SDLW) (copy)_4300796931935232004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sdl2w_orders])' />
      </column>
      <column caption='# Orders Diff (Now v/s SDL2W)' datatype='integer' name='[# Orders Diff (Now v/s SDLW) (copy)_4300796931971039244]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4300796931934674946] - [# Orders (SDLW) (copy)_4300796931935232004]' />
      </column>
      <column caption='% CCR (SDL2W)' datatype='real' name='[% CCR (SDLW) (copy)_4300796931938570248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Param Contacts SDLW (copy)_4300796932181401635])*100/sum([sdl2w_orders])' />
      </column>
      <column caption='% CCR Diff (Now v/s SDL2W)' datatype='real' name='[% CCR Diff (Now v/s SDLW) (copy)_4300796931939962890]' role='measure' type='quantitative'>
