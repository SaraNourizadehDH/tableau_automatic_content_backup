    <worksheet name='Cost of CCR'>
      <layout-options>
        <title>
          <formatted-text>
            <run>(€) Cost of Contacts Incurred</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='seamless_analytics_otx_incident_ccr_analysis (rl)' name='federated.1gfatp30m68z6g19liusx1os7b46' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Overall (All)' caption='Contact Reasons' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Overall&quot;'>
              <calculation class='tableau' formula='&quot;Overall&quot;' />
              <aliases>
                <alias key='&quot;1A1&quot;' value='1A.1 - Check order status' />
                <alias key='&quot;1A10&quot;' value='1A.10 - Order not assigned to a rider' />
                <alias key='&quot;1A12&quot;' value='1A.12 - Complaint about short delay' />
                <alias key='&quot;1A13&quot;' value='1A.13 - Complaint about moderate delay' />
                <alias key='&quot;1A14&quot;' value='1A.14 - Complaint about severe delay' />
                <alias key='&quot;1A15&quot;' value='1A.15 - Complaint about extreme delay' />
                <alias key='&quot;1A2&quot;' value='1A.2 - Complain about late order' />
                <alias key='&quot;1A3&quot;' value='1A.3 - ETA is stuck or increasing' />
                <alias key='&quot;1A5&quot;' value='1A.5 - Restaurant hasn&apos;t started preparing the food' />
                <alias key='&quot;1C1&quot;' value='1C.1 - Request: order will take longer than expected' />
                <alias key='&quot;1C5&quot;' value='1C.5 - Request: order is late, does not want to wait' />
                <alias key='&quot;2D1&quot;' value='2D.1 - Short delay' />
                <alias key='&quot;2D2&quot;' value='2D.2 - Moderate delay' />
                <alias key='&quot;2D3&quot;' value='2D.3 - Severe delay' />
                <alias key='&quot;2D4&quot;' value='2D.4 - Extreme delay' />
                <alias key='&quot;2D5&quot;' value='2D.5 - Early delivery' />
                <alias key='&quot;2D6&quot;' value='2D.6 - Delayed delivery' />
                <alias key='&quot;Overall&quot;' value='Overall (All)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gfatp30m68z6g19liusx1os7b46'>
            <column caption='% CCR (SDL2W)' datatype='real' name='[% CCR (SDLW) (copy)_4300796931938570248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Param Contacts SDLW (copy)_4300796932181401635])*100/sum([sdl2w_orders])' />
            </column>
            <column caption='% CCR Diff (Now v/s SDL2W)' datatype='real' name='[% CCR Diff (Now v/s SDLW) (copy)_4300796931939962890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4300796931938369542] - [% CCR (SDLW) (copy)_4300796931938570248]' />
            </column>
            <column caption='% CCR (SDLW)' datatype='real' name='[% CCR Now (copy)_4300796931938451463]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Param Contacts Now (copy)_4300796932181061664])*100/sum([sdlw_orders])' />
            </column>
            <column caption='(€) Cost Incurred (Now v/s SDL2W)' datatype='real' name='[(€) Cost Incurred (Now v/s SDLW) (copy)_4300796931973009422]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_4300796931938369542] - [% CCR (SDLW) (copy)_4300796931938570248])*(sum(if [region] = &quot;ap&quot; then [orders] else 0 end))*(2.3)/100&#10;+&#10;([Calculation_4300796931938369542] - [% CCR (SDLW) (copy)_4300796931938570248])*(sum(if [region] = &quot;mena&quot; then [orders] else 0 end))*(0.7)/100&#10;+&#10;([Calculation_4300796931938369542] - [% CCR (SDLW) (copy)_4300796931938570248])*(sum(if [region] = &quot;eu&quot; then [orders] else 0 end))*(3.8)/100&#10;+&#10;([Calculation_4300796931938369542] - [% CCR (SDLW) (copy)_4300796931938570248])*(sum(if [region] = &quot;us&quot; then [orders] else 0 end))*(1.5)/100&#10;+&#10;([Calculation_4300796931938369542] - [% CCR (SDLW) (copy)_4300796931938570248])*(sum(if [region] = &quot;kr&quot; then [orders] else 0 end))*(1)/100' />
            </column>
            <column caption='Time Dimension' datatype='string' name='[Calculation_4300796931934208000]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([dates]) + &quot; &quot; + STR([hours]) + &quot;H &quot; + STR([minutes]) +&quot;M&quot;' />
            </column>
            <column caption='% CCR Now' datatype='real' name='[Calculation_4300796931938369542]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_4300796932179578910])*100/sum([orders])' />
            </column>
            <column caption='% CCR Diff (Now v/s SDLW)' datatype='real' name='[Calculation_4300796931939794953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4300796931938369542] - [% CCR Now (copy)_4300796931938451463]' />
            </column>
            <column caption='(€) Cost Incurred (Now v/s SDLW)' datatype='real' name='[Calculation_4300796931972362253]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_4300796931938369542] - [% CCR Now (copy)_4300796931938451463])*(sum(if [region] = &quot;ap&quot; then [orders] else 0 end))*(2.3)/100&#10;+&#10;([Calculation_4300796931938369542] - [% CCR Now (copy)_4300796931938451463])*(sum(if [region] = &quot;mena&quot; then [orders] else 0 end))*(0.7)/100&#10;+&#10;([Calculation_4300796931938369542] - [% CCR Now (copy)_4300796931938451463])*(sum(if [region] = &quot;eu&quot; then [orders] else 0 end))*(3.8)/100&#10;+&#10;([Calculation_4300796931938369542] - [% CCR Now (copy)_4300796931938451463])*(sum(if [region] = &quot;us&quot; then [orders] else 0 end))*(1.5)/100&#10;+&#10;([Calculation_4300796931938369542] - [% CCR Now (copy)_4300796931938451463])*(sum(if [region] = &quot;kr&quot; then [orders] else 0 end))*(1)/100' />
