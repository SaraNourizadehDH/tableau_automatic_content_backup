            <run bold='true' fontcolor='#000000'>APAC</run>
            <run fontcolor='#000000'> = </run>
            <run fontcolor='#555555'>€ </run>
            <run fontcolor='#000000'>2.3, </run>
            <run bold='true' fontcolor='#000000'>US</run>
            <run fontcolor='#000000'> = </run>
            <run fontcolor='#555555' fontname='arial'>€ </run>
            <run fontcolor='#000000'>1.5, </run>
            <run bold='true' fontcolor='#000000'>EU</run>
            <run fontcolor='#000000'> = </run>
            <run fontcolor='#555555' fontname='arial'>€ </run>
            <run fontcolor='#000000'>3.8, </run>
            <run bold='true' fontcolor='#000000'>MENA</run>
            <run fontcolor='#000000'> = </run>
            <run fontcolor='#555555' fontname='arial'>€ </run>
            <run fontcolor='#000000'>0.7, </run>
            <run bold='true' fontcolor='#000000'>KR</run>
            <run fontcolor='#000000'> = </run>
            <run fontcolor='#555555' fontname='arial'>€ </run>
            <run fontcolor='#000000'>1</run>
            <run>Æ&#10;</run>
