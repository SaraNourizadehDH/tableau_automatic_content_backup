      <column caption='IC Billing Partner ' datatype='string' name='[Calculation_1197676043108896771]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;I-1001-&quot;+[entity_code]' />
      </column>
      <column caption='Today vs. Previous Day # Users' datatype='real' name='[Calculation_1356709427233427458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Truncated Date (Month)-1 (String) (copy)_1356709427227332608]/[Todays # Users (copy)_1356709427232698369]-1' />
      </column>
      <column caption='Report Month  ' datatype='string' name='[Calculation_1441996334889988098]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Left(DATENAME(&apos;month&apos;,[Report Month (copy)_49258142045900810]), 3)+&quot;-&quot;+DATENAME(&apos;year&apos;,[Report Month (copy)_49258142045900810])' />
      </column>
      <column caption='Row Number' datatype='integer' name='[Calculation_1488158222589480960]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Average Net Amount' datatype='real' name='[Calculation_1488158222669328391]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_757730676494147599]*[Calculation_757730676488499213]' />
      </column>
      <column caption='License Type' datatype='string' name='[Calculation_160440765617238016]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [license_description]&#13;&#10;when &apos;Full license&apos; then &apos;Full (irrespective of Geo Rest. Price the same)&apos;&#13;&#10;when &apos;Sales - Geo Restricted&apos; then &apos;Full (irrespective of Geo Rest. Price the same)&apos;&#13;&#10;ELSE [license_description]&#13;&#10;END' />
      </column>
      <column caption='Today' datatype='boolean' name='[Calculation_3747065318034448384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='date([insert_date (copy)_757730676485943306]) = TODAY()' />
      </column>
      <column caption='max month' datatype='string' datatype-customized='true' name='[Calculation_49258142042337289]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR({Fixed Year([Report Month (copy)_49258142045900810])&#13;&#10;:Max([Report Month (copy)_49258142045900810])})' />
      </column>
      <column caption='max_month_y_n' datatype='string' name='[Calculation_49258142048022540]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Calculation_1441996334889988098]&#13;&#10;when [Calculation_49258142042337289] then &quot;max&quot;&#13;&#10;&#9;else &quot;null&quot; end' />
      </column>
      <column caption='Attribute type' datatype='string' name='[Calculation_518758404241793025]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[License Description E Parameter]&#13;&#10;WHEN &quot;Cost Center&quot; THEN [user_cost_center]&#13;&#10;ELSE &quot;Total&quot;&#13;&#10;END' />
