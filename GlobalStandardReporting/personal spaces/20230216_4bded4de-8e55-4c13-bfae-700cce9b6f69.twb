    <worksheet name='Historical Evolution - Automatically Generated'>
      <table>
        <view>
          <datasources>
            <datasource caption='salesforce_licenses (salesforce_platform_analytics)' name='federated.0mtnasx0tfmuf51gg98j11qn5tb5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[insert_date Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0mtnasx0tfmuf51gg98j11qn5tb5'>
            <column caption='Average Net Amount' datatype='real' name='[Calculation_1488158222669328391]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_757730676494147599]*[Calculation_757730676488499213]' />
            </column>
            <column caption='License Type' datatype='string' name='[Calculation_160440765617238016]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [license_description]&#13;&#10;when &apos;Full license&apos; then &apos;Full (irrespective of Geo Rest. Price the same)&apos;&#13;&#10;when &apos;Sales - Geo Restricted&apos; then &apos;Full (irrespective of Geo Rest. Price the same)&apos;&#13;&#10;ELSE [license_description]&#13;&#10;END' />
            </column>
            <column caption='Today' datatype='boolean' name='[Calculation_3747065318034448384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='date([insert_date (copy)_757730676485943306]) = TODAY()' />
            </column>
            <column caption='Report Date' datatype='date' name='[Calculation_757730676480811015]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF &#13;&#10;[Parameters].[insert_date Parameter] = &apos;Daily&apos; then [insert_date (copy)_757730676479234049]&#13;&#10;ELSEIF &#13;&#10;[Parameters].[insert_date Parameter] = &apos;Weekly&apos; then [insert_date (copy)_757730676479967237] &#13;&#10;ELSEIF &#13;&#10;[Parameters].[insert_date Parameter] = &apos;Monthly&apos; then [insert_date (copy)_757730676479356930]&#13;&#10;ELSEIF &#13;&#10;[Parameters].[insert_date Parameter] = &apos;Quarterly&apos; then [insert_date (copy)_757730676479512579]&#13;&#10;END' />
            </column>
            <column caption='Average Number of Users' datatype='real' name='[Calculation_757730676488499213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([number_of_users])/COUNTD([insert_date])' />
            </column>
            <column caption='Average License Price' datatype='real' name='[Calculation_757730676494147599]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([price])/count([price])' />
            </column>
            <column caption='Report Date (range)' datatype='date' name='[Report Date (copy)_757730676481429512]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF &#13;&#10;[Parameters].[insert_date Parameter] = &apos;Daily&apos; then [insert_date (copy)_757730676479234049]&#13;&#10;ELSEIF &#13;&#10;[Parameters].[insert_date Parameter] = &apos;Weekly&apos; then [insert_date (copy)_757730676479967237] &#13;&#10;ELSEIF &#13;&#10;[Parameters].[insert_date Parameter] = &apos;Monthly&apos; then [insert_date (copy)_757730676479356930]&#13;&#10;ELSEIF &#13;&#10;[Parameters].[insert_date Parameter] = &apos;Quarterly&apos; then [insert_date (copy)_757730676479512579]&#13;&#10;END' />
            </column>
            <column caption='Report Date ' datatype='string' datatype-customized='true' name='[Report Date (copy)_757730676484558857]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(IF &#13;&#10;[Parameters].[insert_date Parameter] = &apos;Daily&apos; then [insert_date (copy)_757730676479234049]&#13;&#10;ELSEIF &#13;&#10;[Parameters].[insert_date Parameter] = &apos;Weekly&apos; then [insert_date (copy)_757730676479967237] &#13;&#10;ELSEIF &#13;&#10;[Parameters].[insert_date Parameter] = &apos;Monthly&apos; then [insert_date (copy)_757730676479356930]&#13;&#10;ELSEIF &#13;&#10;[Parameters].[insert_date Parameter] = &apos;Quarterly&apos; then [insert_date (copy)_757730676479512579]&#13;&#10;END)' />
            </column>
            <column caption='User Country  ' datatype='string' name='[User Country (copy)_49258142007242755]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[country_name]' />
