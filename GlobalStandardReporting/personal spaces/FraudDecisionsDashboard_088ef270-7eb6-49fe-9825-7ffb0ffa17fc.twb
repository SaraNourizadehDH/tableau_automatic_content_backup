      <aliases enabled='yes' />
      <column caption='Timeframe' datatype='string' name='[Calculation_668714242016944128]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// In this calc, we want to return FORMATTED dates. So the calc return should be STRINGS&#10;// To get the date elements, there&apos;s basically two options:&#10;// DATEPART() returns the desired element as numbers. So those need to be converted to strings with STR()&#10;// DAY() and YEAR() are convenience functions that do the same thing as DATEPART()&#10;// DATENAME() already returns text strings.&#10;// The rest of it is basically concatenating everything to return a nicely formatted date string&#10;// Don&apos;t forget that you need to fix the SORT of the dates. By default, Tableau will order those dates alphabetically&#10;&#10;CASE [Parameters].[Parameter 2]&#10;WHEN &apos;d&apos; THEN STR(DAY([order_date])) + &apos; &apos; + LEFT(DATENAME(&apos;month&apos;,[order_date]),3) +&apos; &apos;+ RIGHT(STR(YEAR([order_date])),2)&#10;WHEN &apos;w&apos; THEN &apos;W&apos; + STR(DATEPART(&apos;week&apos;,[order_date])) + &apos; &apos; + STR(YEAR([order_date]))&#10;WHEN &apos;m&apos; THEN LEFT(DATENAME(&apos;month&apos;,[order_date]),3) + &apos; &apos; + STR(YEAR([order_date]))&#10;WHEN &apos;q&apos; THEN &apos;Q&apos;+STR(DATEPART(&apos;quarter&apos;,[order_date])) + &apos; &apos; + STR(YEAR([order_date]))&#10;END' />
      </column>
      <column caption='Region of Country-parameter' datatype='string' name='[Calculation_668714243123216385]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{fixed :Max(if [country]=[Parameters].[Parameter 3] then [region] end )}' />
      </column>
      <column caption='Region of selected Country' datatype='boolean' name='[Calculation_668714243124305922]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_668714243123216385]=[region]' />
      </column>
      <column caption='Transactions Country' datatype='integer' name='[Calculation_668714243127275525]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] WHEN [country] THEN [transactions] ELSE Null END' />
      </column>
      <column caption='GMV Country Eur' datatype='real' name='[Calculation_668714243127484425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] WHEN [country] THEN [amount_eur] ELSE Null END' />
      </column>
      <column caption='GMV Country Local' datatype='real' name='[Calculation_668714243127726090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] WHEN [country] THEN [amount_lc] ELSE Null END' />
      </column>
      <column caption='Metric selected _ units' datatype='string' name='[Calculation_940900543287234560]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Count&quot; THEN &quot;&quot;&#10;WHEN &quot;Count %&quot; THEN &quot;%&quot;&#10;WHEN &quot;GMV&quot; THEN &quot; €&quot;&#10;WHEN &quot;GMV %&quot; THEN &quot;%&quot;&#10;END' />
      </column>
      <column caption='GMV Share' datatype='real' name='[Calculation_940900543288487938]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([amount_eur]) / TOTAL(SUM([amount_eur]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Transaction Share' datatype='real' name='[Calculation_940900543288705027]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([transactions]) / TOTAL(sum([transactions]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Metric selected' datatype='real' name='[Calculation_940900543288881156]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Count&quot; THEN sum([transactions])&#10;WHEN &quot;Count %&quot; THEN ROUND([Calculation_940900543288705027]*100,2)&#10;WHEN &quot;GMV&quot; THEN ROUND(SUM([amount_eur]),0)&#10;WHEN &quot;GMV %&quot; THEN ROUND([Calculation_940900543288487938]*100,2)&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Metric selected_sort' datatype='real' name='[Calculation_940900543289135110]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Count&quot; THEN sum([transactions])&#10;WHEN &quot;Count %&quot; THEN SUM([transactions])&#10;WHEN &quot;GMV&quot; THEN SUM([amount_eur])&#10;WHEN &quot;GMV %&quot; THEN SUM([amount_eur])&#10;END' />
      </column>
      <column caption='GMV Country Share Eur' datatype='real' name='[GMV Share (copy)_668714243128410125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_668714243127484425]) / TOTAL(SUM([Calculation_668714243127484425]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Metric Region' datatype='real' name='[Metric selected (copy)_668714243125665795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Count&quot; THEN sum([transactions])/COUNTD([country])&#10;WHEN &quot;Count %&quot; THEN ROUND([Calculation_940900543288705027]*100,2)&#10;WHEN &quot;GMV&quot; THEN ROUND(SUM([amount_eur])/COUNTD([country]),0)&#10;WHEN &quot;GMV %&quot; THEN ROUND([Calculation_940900543288487938]*100,2)&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Metric Country' datatype='real' name='[Metric selected (copy)_668714243126632452]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Count&quot; THEN sum([Calculation_668714243127275525])&#10;WHEN &quot;Count %&quot; THEN ROUND([Transaction Share (copy)_668714243127984140]*1000,2)&#10;WHEN &quot;GMV&quot; THEN ROUND(SUM([Calculation_668714243127484425]),0)&#10;WHEN &quot;GMV %&quot; THEN ROUND([GMV Share (copy)_668714243128410125]*100,2)&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Transaction Country Share ' datatype='real' name='[Transaction Share (copy)_668714243127984140]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_668714243127275525]) / TOTAL(sum([Calculation_668714243127275525]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
