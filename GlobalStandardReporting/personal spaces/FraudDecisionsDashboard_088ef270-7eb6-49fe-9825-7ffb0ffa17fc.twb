    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Information'>
      <repository-location derived-from='http://ip-172-31-0-134:8020/t/GlobalStandardReporting/workbooks/GordonDecisionsDashboardWIP/Information?rev=' id='Information' path='/t/GlobalStandardReporting/workbooks/FraudDecisionsDashboard' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_17' value='top' />
          <format attr='vertical-align' id='dash-text_26' value='top' />
          <format attr='vertical-align' id='dash-text_82' value='top' />
        </style-rule>
      </style>
      <size maxheight='1000' maxwidth='1350' minheight='1000' minwidth='1350' preset-index='17' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='66900' id='113' param='vert' type-v2='layout-flow' w='98814' x='593' y='800'>
            <zone h='66900' id='111' type-v2='layout-basic' w='98814' x='593' y='800'>
              <zone h='52600' id='24' param='horz' type-v2='layout-flow' w='98814' x='593' y='15100'>
                <zone h='52600' id='18' param='vert' type-v2='layout-flow' w='98814' x='593' y='15100'>
                  <zone h='52600' id='7' param='horz' type-v2='layout-flow' w='98814' x='593' y='15100'>
                    <zone h='52600' id='5' type-v2='layout-basic' w='98814' x='593' y='15100'>
                      <zone forceUpdate='true' h='52600' id='104' type-v2='text' w='98814' x='593' y='15100'>
                        <formatted-text>
                          <run bold='true' fontcolor='#000000' fontname='Tableau Semibold' fontsize='12'>Purpose:</run>
                          <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='12'>Æ </run>
                          <run>Æ&#10;</run>
                          <run fontcolor='#000000' fontsize='12'>Tracking of </run>
                          <run bold='true' fontcolor='#000000' fontsize='12' italic='true'>Fraud Decisions</run>
                          <run fontcolor='#000000' fontsize='12'> globally by Region, Country, Entity, Payment Method and other transaction types</run>
                          <run>Æ&#10;</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#000000' fontname='Tableau Semibold' fontsize='12'>Main Metrics:</run>
                          <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='12'>Æ </run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#000000' fontsize='12'>- 3DS Rate </run>
                          <run fontcolor='#000000' fontsize='12'>-&gt; share of transactions sent to 3DS / total transactions</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#000000' fontsize='12'>- Fraud Decline Rate </run>
                          <run fontcolor='#000000' fontsize='12'>-&gt; share of transactions declined by Gordon / total transactions</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#000000' fontsize='12'>- Total Friction</run>
                          <run fontcolor='#000000' fontsize='12'> -&gt; sum of 3DS rate and fraud decline rate</run>
                          <run>Æ&#10;</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#000000' fontname='Tableau Semibold' fontsize='12'>Report Time Frame:</run>
                          <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='12'>Æ </run>
                          <run>Æ&#10;</run>
                          <run fontcolor='#000000' fontsize='12'>From 2022-01-01 and onwards</run>
                          <run>Æ&#10;</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#000000' fontname='Tableau Semibold' fontsize='12'>Data:</run>
                          <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='12'>Æ </run>
                          <run>Æ&#10;</run>
                          <run fontcolor='#000000' fontsize='12'>- This report covers all payment types processed by Gordon (Fraud Prevention Setup)</run>
                          <run>Æ&#10;</run>
                          <run fontcolor='#000000' fontsize='12'>- More information about the data source can be found at </run>
                          <run>Æ&#10;</run>
                          <run fontcolor='#4996b2' fontsize='12' hyperlink='tabdoc:load-url url=&amp;quot;https://confluence.deliveryhero.com/display/WAL/Gordon+Datamart&amp;quot;'>https://confluence.deliveryhero.com/display/WAL/Gordon+Datamart</run>
                          <run>Æ&#10;</run>
                          <run>Æ&#10;</run>
                          <run bold='true' fontcolor='#000000' fontname='Tableau Semibold' fontsize='12'>Notes:</run>
                          <run fontcolor='#000000' fontname='Tableau Semibold' fontsize='12'>Æ </run>
                          <run>Æ&#10;</run>
                          <run fontcolor='#000000' fontsize='12'>* In the calculation of 3DS rate, cash, alternative payment methods and wallet payment methods are not excluded</run>
                          <run>Æ&#10;</run>
                          <run fontcolor='#000000' fontsize='12'>* GMV metrics are in  </run>
                          <run fontcolor='#222222' fontsize='12'>€</run>
                          <run fontcolor='#000000' fontsize='12'>Æ </run>
                          <run>Æ&#10;</run>
                          <run fontcolor='#000000' fontsize='12'>*This dashboard only includes the decisions taken by Gordon. Before April 2022, Adyen Revenue Protect was also enabled for APAC and EU countries. Since April 2022, Gordon is the only fraud prevention system taking the decisions.</run>
                          <run>Æ&#10;</run>
                          <run>Æ&#10;</run>
                        </formatted-text>
                        <zone-style>
                          <format attr='border-color' value='#000000' />
                          <format attr='border-style' value='none' />
                          <format attr='border-width' value='0' />
                          <format attr='margin' value='4' />
                        </zone-style>
                      </zone>
                    </zone>
                  </zone>
                </zone>
              </zone>
