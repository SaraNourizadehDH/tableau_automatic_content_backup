        <rows>([federated.09p2y4h1q7o4m317b39b217nfl0d].[none:brand_name:nk] / ([federated.09p2y4h1q7o4m317b39b217nfl0d].[none:official_kitchen_name:nk] / ([federated.09p2y4h1q7o4m317b39b217nfl0d].[none:kitchen_status:nk] / ([federated.09p2y4h1q7o4m317b39b217nfl0d].[none:lead_status:nk] / ([federated.09p2y4h1q7o4m317b39b217nfl0d].[none:relevant_competitors_in_kitchen_area:nk] / ([federated.09p2y4h1q7o4m317b39b217nfl0d].[none:relevant_competitors_in_entity:nk] / ([federated.09p2y4h1q7o4m317b39b217nfl0d].[none:recommended_item:nk] / ([federated.09p2y4h1q7o4m317b39b217nfl0d].[none:ref_item_real_name:nk] / ([federated.09p2y4h1q7o4m317b39b217nfl0d].[none:ref_brand:nk] / [federated.09p2y4h1q7o4m317b39b217nfl0d].[none:ref_vendor_url:nk])))))))))</rows>
