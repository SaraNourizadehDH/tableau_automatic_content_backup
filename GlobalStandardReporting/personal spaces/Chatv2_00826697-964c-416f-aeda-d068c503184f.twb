            </column>
            <column caption='% Web Customer Chats' datatype='real' name='[% Android Customer Chats (copy)_5273292999105708061]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [chat_category] = &apos;customer&apos; THEN [web_chats] ELSE 0 END) &#10;/ &#10;[Calculation_5273292997749710853]' />
            </column>
            <column caption='% Android Rider Chats' datatype='real' name='[% Android Customer Chats (copy)_5273292999110770724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [chat_category] = &apos;rider&apos; THEN [android_chats] ELSE 0 END) &#10;/ &#10;[# Chat Started by Customer (copy)_5273292997750095878]' />
            </column>
            <column caption='% Rider Initiated Chats' datatype='real' name='[% Chats started by Customer (copy)_5273292997750558728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Chat Started by Customer (copy)_5273292997750095878]&#10;/&#10;SUM([total_chat_sessions])' />
            </column>
            <column caption='% First Messages Read by Customers' datatype='real' default-format='p0.0%' name='[% Customer First Messages Read (copy)_4623789461316349957]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_first_messages_read]) / [# Chat Started by Customer (copy)_5273292997750095878]' />
            </column>
            <column caption='% First Messages Read by Riders' datatype='real' default-format='p0.0%' name='[% Customer Messages Read (copy)_4623789461311471619]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_first_messages_read]) / [Calculation_5273292997749710853]' />
            </column>
            <column caption='% IOS Rider Chats' datatype='real' name='[% IOS Customer Chats (copy)_5273292999110877221]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [chat_category] = &apos;rider&apos; THEN [ios_chats] ELSE 0 END) &#10;/ &#10;[# Chat Started by Customer (copy)_5273292997750095878]' />
            </column>
            <column caption='% Served Chats' datatype='real' name='[% Missed Chats (copy)_5273292997751455755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_served_chats]) &#10;/ &#10;SUM([total_chat_sessions])' />
            </column>
            <column caption='% Messages Read by Riders' datatype='real' default-format='p0.0%' name='[% Rider Messages Read (copy)_4623789461310722049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_customer_messages_read]) / SUM([total_customer_messages])' />
            </column>
            <column caption='% Android Chats' datatype='real' name='[% Web Chats (copy)_5273292999097454608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([android_chats]) &#10;/ &#10;SUM([total_chat_sessions])' />
