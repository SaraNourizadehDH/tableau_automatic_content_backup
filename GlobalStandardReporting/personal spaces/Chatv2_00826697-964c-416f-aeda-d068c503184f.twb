  <worksheets>
    <worksheet name='Customers'>
      <table>
        <view>
          <datasources>
            <datasource caption='rl_gcc_service.p2p_chats_report' name='federated.18hic5c0roi51q1cuczyp11sm7f4' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='Date Granularity' datatype='string' name='[Chose Dimension (Columns) (copy)_526358231437660160]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
              <aliases>
                <alias key='&quot;Daily&quot;' value='Daily' />
                <alias key='&quot;Monthly&quot;' value='Monthly' />
                <alias key='&quot;Weekly&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Dimensions' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Global&quot;'>
              <calculation class='tableau' formula='&quot;Global&quot;' />
              <aliases>
                <alias key='&quot;Contact Center&quot;' value='Contact Center' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18hic5c0roi51q1cuczyp11sm7f4'>
            <column caption='# Rider Initiated Chats' datatype='integer' name='[# Chat Started by Customer (copy)_5273292997750095878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[chat_category] = &apos;rider&apos; THEN [total_chat_sessions] ELSE 0 END)' />
            </column>
            <column caption='# Customer Messages' datatype='integer' default-format='n#,##0;-#,##0' name='[# Last Message sent by Rider (copy)_5273292999101837333]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_customer_messages])' />
            </column>
            <column caption='% Android Customer Chats' datatype='real' name='[% Android Chats (copy)_5273292999105413148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [chat_category] = &apos;customer&apos; THEN [android_chats] ELSE 0 END) &#10;/ &#10;[Calculation_5273292997749710853]' />
            </column>
            <column caption='% Web Customer Chats' datatype='real' name='[% Android Customer Chats (copy)_5273292999105708061]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [chat_category] = &apos;customer&apos; THEN [web_chats] ELSE 0 END) &#10;/ &#10;[Calculation_5273292997749710853]' />
            </column>
            <column caption='% First Messages Read by Customers' datatype='real' default-format='p0.0%' name='[% Customer First Messages Read (copy)_4623789461316349957]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_first_messages_read]) / [# Chat Started by Customer (copy)_5273292997750095878]' />
            </column>
            <column caption='% IOS Customer Chats' datatype='real' name='[% Web Customer Chats (copy)_5273292999105835038]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [chat_category] = &apos;customer&apos; THEN [ios_chats] ELSE 0 END) &#10;/ &#10;[Calculation_5273292997749710853]' />
            </column>
            <column caption='% Translated Customer Chats' datatype='real' default-format='p0%' name='[Calculation_3159415907927654403]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [chat_category] = &apos;customer&apos; THEN [translated_chats] ELSE 0 END) &#10;/ &#10;[Calculation_5273292997749710853]' />
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_3190096707021156352]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 6]=&apos;Country&apos; THEN [country]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;DH Regions&apos; THEN [dh_region]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Contact Center&apos; THEN [contact_center]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Management Entity&apos; THEN [management_entity_group]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Global&apos; THEN &apos;Global&apos;&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Device Type&apos; THEN [device_type]&#10;END' />
            </column>
            <column caption='% Messages Read by Customers' datatype='real' default-format='p0.0%' name='[Calculation_4623789461310492672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_rider_messages_read]) / SUM([total_rider_messages])' />
            </column>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_509188294470447104]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username] = USERNAME()' />
            </column>
            <column caption='# Customer Initiated Chats' datatype='integer' name='[Calculation_5273292997749710853]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF[chat_category] = &apos;customer&apos; THEN [total_chat_sessions] ELSE 0 END)' />
            </column>
            <column caption='Granularity' datatype='string' name='[Calculation_5273292997752655886]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Chose Dimension (Columns) (copy)_526358231437660160]&#10;    WHEN &apos;Daily&apos; THEN STR([iso_date])&#10;    WHEN &apos;Weekly&apos; THEN [week]&#10;    WHEN &apos;Monthly&apos; THEN [month]&#10;END' />
            </column>
            <column caption='Customer Response Rate' datatype='real' name='[Calculation_5273292999099621394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [chat_category] = &apos;rider&apos; THEN [total_served_chats] ELSE 0 END)&#10;/ &#10;SUM(IF [chat_category] = &apos;rider&apos; THEN [total_chat_sessions] ELSE 0 END)&#10;// proportion of chats where the customer answers to chats initiated by a rider //' />
            </column>
            <column caption='Avg. Customer Messages per Chat' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5273292999102992406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Last Message sent by Rider (copy)_5273292999101837333]&#10;/ &#10;SUM([total_chat_sessions])' />
            </column>
            <column caption='Avg. FRT for Customer Chats (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5273292999103918105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [chat_category] = &apos;customer&apos; THEN [rider_first_reply_time] ELSE 0 END)&#10;/ &#10;[Calculation_5273292999104880667]&#10;/&#10;60' />
            </column>
            <column caption='% Customer First  Chats' datatype='real' default-format='p0.0%' name='[Calculation_5273292999104430106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_first_chats]) &#10;/ &#10;SUM([total_chat_sessions])' />
            </column>
            <column caption='# Served Customer Chats' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_5273292999104880667]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(If [chat_category] = &apos;customer&apos; THEN [total_served_chats] ELSE 0 END)' />
            </column>
            <column caption='# Last Message sent by Rider' datatype='integer' default-format='n#,##0;-#,##0' name='[Rider Response Rate (copy)_5273292999101534228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([chat_ended_by_rider])' />
            </column>
            <column caption='# Android Chats' datatype='integer' name='[android_chats]' role='measure' type='quantitative' />
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Chat Category' datatype='string' name='[chat_category]' role='dimension' type='nominal' />
            <column caption='Chat Ended By Rider' datatype='integer' name='[chat_ended_by_rider]' role='measure' type='quantitative' />
            <column caption='Chat Source' datatype='string' name='[chat_source]' role='dimension' type='nominal' />
            <column caption='Contact Center' datatype='string' name='[contact_center]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Customer First Chats' datatype='integer' name='[customer_first_chats]' role='measure' type='quantitative' />
