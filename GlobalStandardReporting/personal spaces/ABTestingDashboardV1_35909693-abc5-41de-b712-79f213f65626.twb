      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0wyov131tt7mcy171hof21rnzh8h]&quot;' value='Delta Exp - Ctrl' />
        </aliases>
      </column>
      <column caption='Unit' datatype='string' name='[Calculation_178103360061231104]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF[agg_level] = &quot;global&quot; THEN &quot;global&quot; ELSEIF [agg_level] = &quot;region&quot; THEN [region] ELSE [entities] END' />
      </column>
      <column caption='max date' datatype='boolean' name='[Calculation_178103360101007361]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[created_date] = {FIXED:MAX([created_date])}' />
      </column>
      <column caption='delta color' datatype='integer' name='[Calculation_3149071700622553088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [improvement] = &apos;improvement&apos; THEN 1 &#10;ELSEIF [improvement] = &apos;downgrade&apos; THEN -1 &#10;ELSEIF [improvement] = &apos;no-significance&apos; THEN 0 &#10;ELSEIF [p] &lt; 0.05 THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='delta' datatype='real' name='[Calculation_4262797785360281601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg([version_b.aggregate]) - avg([version_a.aggregate])' />
      </column>
      <column caption='% Ctrl' datatype='real' name='[Calculation_4262797785364803587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg([version_a.percentage])' />
      </column>
      <column caption='% Exp' datatype='real' name='[Calculation_4262797785365135365]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg([version_b.percentage])' />
      </column>
      <column caption='P - Value' datatype='real' name='[Calculation_4262797785365917702]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([p])' />
      </column>
