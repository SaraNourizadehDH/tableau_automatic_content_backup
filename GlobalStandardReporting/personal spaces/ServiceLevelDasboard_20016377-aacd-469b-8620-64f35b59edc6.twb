      <aliases enabled='yes' />
      <column caption='KPI Value' datatype='real' name='[Calculation_3196007672901947392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([denominator]) &lt;&gt; 0 THEN&#10;    SUM([numerator]) / SUM([denominator])&#10;END' />
      </column>
      <column caption='Report Year' datatype='integer' name='[Calculation_3196007672902115329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT([report_year])' />
      </column>
      <column caption='Yearly Metric Value' datatype='real' name='[Calculation_3196007672905125890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [brand], [kpi], [Calculation_3196007672902115329] :&#10;    IF SUM([denominator]) &lt;&gt; 0 THEN SUM([numerator]) / SUM([denominator]) END&#10;}' />
      </column>
      <column caption='First Available Year &gt;= Floor' datatype='integer' name='[Calculation_3196007672905199619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [brand], [kpi] :&#10;    MIN( IF [Calculation_3196007672902115329] &gt;= [Parameters].[Parameter 1]&#10;         AND NOT ISNULL([Calculation_3196007672905125890])&#10;         THEN [Calculation_3196007672902115329] END )&#10;}' />
      </column>
      <column caption='Base KPI Value' datatype='real' name='[Calculation_3196007672905510916]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [brand], [kpi] :&#10;    MIN( IF [Calculation_3196007672902115329] = [Calculation_3196007672905199619]&#10;         THEN [Calculation_3196007672905125890] END )&#10;}' />
      </column>
      <column caption='Indexed KPI' datatype='real' name='[Calculation_3196007672905576453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_3196007672905510916] &lt;&gt; 0 THEN (100 * [Calculation_3196007672905125890] / [Calculation_3196007672905510916])-100 END' />
      </column>
      <column caption='Brand' datatype='string' name='[Calculation_3196007672906403846]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [brand] = &quot;Pedidosya&quot; THEN &quot;PedidosYa&quot;&#10;ELSEIF [brand] = &quot;Hungerstation&quot; THEN &quot;HungerStation&quot;&#10;ELSE [brand]&#10;END' />
      </column>
      <column caption='Date (Chosen Granularity)' datatype='datetime' default-format='S' name='[Calculation_4147393094452707328]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &apos;Year&apos;    THEN DATETRUNC(&apos;year&apos;,    [report_month])&#10;  WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [report_month])&#10;  ELSE                DATETRUNC(&apos;month&apos;,   [report_month])&#10;END' />
      </column>
      <column caption='Line Group' datatype='string' name='[Calculation_4147393094452854785]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Global&apos; THEN &apos;Selected Brands (rolled up)&apos;&#10;ELSE [Calculation_3196007672906403846]&#10;END' />
      </column>
      <column caption='Display KPI Value' datatype='real' name='[Calculation_4147393094452994050]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IIF(ENDSWITH(ATTR([kpi]), &apos;(%)&apos;),&#10;    ROUND([Calculation_3196007672901947392] * 100,2),&#10;    ROUND([Calculation_3196007672901947392],2)&#10;)' />
      </column>
      <column caption='Display KPI Label' datatype='string' name='[Calculation_4147393094454640643]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ENDSWITH(ATTR([kpi]), &apos;(%)&apos;) THEN&#10;    STR(ROUND([Calculation_4147393094452994050], 2)) + &apos;%&apos;&#10;ELSE&#10;    STR(ROUND([Calculation_4147393094452994050], 2))&#10;END' />
      </column>
      <column caption='Date Label' datatype='string' name='[Calculation_4147393094466088964]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &apos;Year&apos; THEN&#10;    STR(DATEPART(&apos;year&apos;, [report_month]))&#10;&#10;  WHEN &apos;Quarter&apos; THEN&#10;    &apos;Q&apos; + STR(DATEPART(&apos;quarter&apos;, [report_month]))&#10;    + &apos; &apos; + STR(DATEPART(&apos;year&apos;, [report_month]))&#10;&#10;  ELSE  // Month&#10;    LEFT(DATENAME(&apos;month&apos;, [report_month]), 3)  &#10;    + &apos;-&apos; + STR(DATEPART(&apos;year&apos;, [report_month]))&#10;END' />
      </column>
