    <worksheet name='Indexed KPI Brand Level'>
      <table>
        <view>
          <datasources>
            <datasource caption='service_level_dashboard (long_term_ops_rider)' name='federated.0corpki178xbz31gklrhz1pn5fek' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='[Global Base Floor]' datatype='integer' default-format='*####' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='2021'>
              <calculation class='tableau' formula='2021' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0corpki178xbz31gklrhz1pn5fek'>
            <column caption='KPI Value' datatype='real' name='[Calculation_3196007672901947392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([denominator]) &lt;&gt; 0 THEN&#10;    SUM([numerator]) / SUM([denominator])&#10;END' />
            </column>
            <column caption='Report Year' datatype='integer' name='[Calculation_3196007672902115329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT([report_year])' />
            </column>
            <column caption='Yearly Metric Value' datatype='real' name='[Calculation_3196007672905125890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [brand], [kpi], [Calculation_3196007672902115329] :&#10;    IF SUM([denominator]) &lt;&gt; 0 THEN SUM([numerator]) / SUM([denominator]) END&#10;}' />
            </column>
            <column caption='First Available Year &gt;= Floor' datatype='integer' name='[Calculation_3196007672905199619]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [brand], [kpi] :&#10;    MIN( IF [Calculation_3196007672902115329] &gt;= [Parameters].[Parameter 1]&#10;         AND NOT ISNULL([Calculation_3196007672905125890])&#10;         THEN [Calculation_3196007672902115329] END )&#10;}' />
            </column>
            <column caption='Base KPI Value' datatype='real' name='[Calculation_3196007672905510916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [brand], [kpi] :&#10;    MIN( IF [Calculation_3196007672902115329] = [Calculation_3196007672905199619]&#10;         THEN [Calculation_3196007672905125890] END )&#10;}' />
            </column>
            <column caption='Indexed KPI' datatype='real' name='[Calculation_3196007672905576453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_3196007672905510916] &lt;&gt; 0 THEN (100 * [Calculation_3196007672905125890] / [Calculation_3196007672905510916])-100 END' />
            </column>
            <column caption='Brand' datatype='string' name='[Calculation_3196007672906403846]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [brand] = &quot;Pedidosya&quot; THEN &quot;PedidosYa&quot;&#10;ELSEIF [brand] = &quot;Hungerstation&quot; THEN &quot;HungerStation&quot;&#10;ELSE [brand]&#10;END' />
            </column>
            <column caption='Display KPI Value' datatype='real' name='[Calculation_4147393094452994050]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IIF(ENDSWITH(ATTR([kpi]), &apos;(%)&apos;),&#10;    ROUND([Calculation_3196007672901947392] * 100,2),&#10;    ROUND([Calculation_3196007672901947392],2)&#10;)' />
            </column>
            <column caption='Display KPI Label' datatype='string' name='[Calculation_4147393094454640643]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ENDSWITH(ATTR([kpi]), &apos;(%)&apos;) THEN&#10;    STR(ROUND([Calculation_4147393094452994050], 2)) + &apos;%&apos;&#10;ELSE&#10;    STR(ROUND([Calculation_4147393094452994050], 2))&#10;END' />
            </column>
            <column-instance column='[Calculation_3196007672905576453]' derivation='Avg' name='[avg:Calculation_3196007672905576453:qk]' pivot='key' type='quantitative' />
            <column caption='Brand_raw' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Denominator' datatype='real' name='[denominator]' role='measure' type='quantitative' />
            <column caption='Kpi' datatype='string' name='[kpi]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3196007672902115329]' derivation='None' name='[none:Calculation_3196007672902115329:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3196007672906403846]' derivation='None' name='[none:Calculation_3196007672906403846:nk]' pivot='key' type='nominal' />
            <column-instance column='[kpi]' derivation='None' name='[none:kpi:nk]' pivot='key' type='nominal' />
            <column caption='Numerator' datatype='real' name='[numerator]' role='measure' type='quantitative' />
            <column caption='Report Year (str)' datatype='string' name='[report_year]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3196007672905576453]' derivation='Sum' name='[sum:Calculation_3196007672905576453:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4147393094454640643]' derivation='User' name='[usr:Calculation_4147393094454640643:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0corpki178xbz31gklrhz1pn5fek].[none:Calculation_3196007672906403846:nk]'>
            <groupfilter function='level-members' level='[none:Calculation_3196007672906403846:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0corpki178xbz31gklrhz1pn5fek].[none:kpi:nk]'>
            <groupfilter function='member' level='[none:kpi:nk]' member='&quot;Order On-Time(\%)&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.0corpki178xbz31gklrhz1pn5fek].[none:Calculation_3196007672906403846:nk]</column>
            <column>[federated.0corpki178xbz31gklrhz1pn5fek].[none:kpi:nk]</column>
          </slices>
