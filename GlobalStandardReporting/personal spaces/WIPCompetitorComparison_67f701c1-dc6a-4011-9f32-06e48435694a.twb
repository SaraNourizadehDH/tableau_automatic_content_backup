          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Matched' datatype='string' name='[Calculation_3312186430811926529]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF (IF ISNULL([has_competitor_match]) THEN 1 ELSE [has_competitor_match] END) = 0 &#10;THEN &apos;No&apos; ELSE &apos;Yes&apos; END' />
      </column>
      <column caption='Total Brands' datatype='integer' name='[Calculation_3515622464975138816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([brand_name])' />
      </column>
      <column caption='Products' datatype='integer' name='[Calculation_3515622464983879681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IFNULL(STR([master_id]), [product_name]))' />
      </column>
      <column caption='L0 Category' datatype='string' name='[Calculation_470907650061963272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE[l1_category] &#10;    WHEN &apos;Bread / Bakery&apos; THEN &apos;Fresh&apos;&#10;    WHEN &apos;Dairy / Chilled / Eggs&apos; THEN &apos;Fresh&apos;&#10;    WHEN &apos;Meat / Seafood&apos; THEN &apos;Ultrafresh&apos;&#10;    WHEN &apos;Produce&apos; THEN &apos;Ultrafresh&apos;&#10;    WHEN &apos;Ready To Consume&apos; THEN &apos;Ultrafresh&apos;&#10;    WHEN &apos;Packaged Foods&apos; THEN &apos;Packaged Foods&apos;&#10;    WHEN &apos;Frozen&apos; THEN &apos;Packaged Foods&apos;&#10;    WHEN &apos;Beverages&apos; THEN &apos;Impulse&apos;&#10;    WHEN &apos;Snacks&apos; THEN &apos;Impulse&apos;&#10;    WHEN &apos;BWS&apos; THEN &apos;BWS&apos;&#10;    WHEN &apos;Home / Pet&apos; THEN &apos;Non-Food Grocery&apos;&#10;    WHEN &apos;Personal Care / Baby / Health&apos; THEN &apos;Non-Food Grocery&apos;&#10;    WHEN &apos;Smoking / Tobacco&apos; THEN &apos;Non-Food Grocery&apos;&#10;    WHEN &apos;General Merchandise&apos; THEN &apos;GM&apos;&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Presence' datatype='integer' name='[Calculation_470907650087546892]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(IF &#10;COUNTD(IFNULL(STR([master_id]), [product_name])) &gt; 0 &#10;THEN 1&#10;ELSE 0 END&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
