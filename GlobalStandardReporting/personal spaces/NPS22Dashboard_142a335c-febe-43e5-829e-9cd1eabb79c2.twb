      <aliases enabled='yes' />
      <column caption='Color' datatype='integer' name='[Calculation_271834488517828608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  &#10;    FIND([Optimized KPI],&apos;%Sub&apos;)&gt;0 then 1&#10;Else 0&#10;END' />
      </column>
      <column caption='Day-Month' datatype='string' name='[Calculation_5106730153187958784]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;day&apos;,[nps_date]) + &apos;-&apos; + LEFT(DATENAME(&apos;month&apos;,[nps_date]),3)' />
      </column>
      <column caption='Value Final' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5106730153188835329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  &#10;    FIND([Optimized KPI],&apos;nps&apos;)&gt;0 then [Value]*100&#10;ELSEIF FIND([Optimized KPI],&apos;%&apos;)&gt;0 then [Value]*100&#10;Else [Value]&#10;END' />
      </column>
      <column caption='Value (for conditional formatting)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5106730153198563330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  &#10;    FIND([KPI],&apos;csat&apos;)&gt;0 then [Value]/5&#10;Else [Value]&#10;END' />
      </column>
      <column caption='Snapshot Date' datatype='date' name='[Calculation_5106730153202737155]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(&apos;2023-10-30&apos;)' />
      </column>
      <column caption='Sub Drivers Visible' datatype='string' name='[Color (copy)_271834488518520833]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  &#10;    FIND([Optimized KPI],&apos;%Sub&apos;)&gt;0 then &apos;Yes&apos;&#10;Else &apos;No&apos;&#10;END' />
      </column>
      <column datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Value]' role='measure' type='quantitative' />
