            <column caption='Proportion Responses' datatype='real' default-format='p0%' name='[prop_reason]' role='measure' type='quantitative' />
            <column caption='Reason' datatype='string' name='[reason]' role='dimension' type='nominal' />
            <column datatype='date' name='[reporting_month]' role='dimension' type='ordinal' />
            <column caption='Sub Entity' datatype='string' name='[sub_entity]' role='dimension' type='nominal' />
            <column-instance column='[importance]' derivation='Sum' name='[sum:importance:qk]' pivot='key' type='quantitative' />
            <column-instance column='[prop_reason]' derivation='Sum' name='[sum:prop_reason:qk]' pivot='key' type='quantitative' />
