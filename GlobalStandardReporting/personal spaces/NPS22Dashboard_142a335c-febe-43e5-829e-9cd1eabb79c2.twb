            </map>
            <map to='#b07aa1'>
              <bucket>&quot;time_start_cart_in_minutes&quot;</bucket>
            </map>
            <map to='#b6992d'>
              <bucket>&quot;contact_rate_with_hc&quot;</bucket>
            </map>
            <map to='#b6992d'>
              <bucket>&quot;delay_duration_mins_greater_5_percent&quot;</bucket>
            </map>
            <map to='#b6992d'>
              <bucket>&quot;pricing_nps&quot;</bucket>
            </map>
            <map to='#bab0ac'>
              <bucket>&quot;DT_mins_greater_60_mins_percent&quot;</bucket>
            </map>
            <map to='#d37295'>
              <bucket>&quot;DURATION_TO_CANCELLATION_MINs_greater_15_percent&quot;</bucket>
            </map>
            <map to='#d4a6c8'>
              <bucket>&quot;is_discount_and_voucher_percent&quot;</bucket>
            </map>
            <map to='#d7b5a6'>
              <bucket>&quot;is_free_delivery_percent&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;delivery_nps&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;time_checkout_in_minutes&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;variety_nps&quot;</bucket>
            </map>
            <map to='#edc948'>
              <bucket>&quot;time_menu_in_minutes&quot;</bucket>
            </map>
            <map to='#f1ce63'>
              <bucket>&quot;contact_rate_wm&quot;</bucket>
            </map>
            <map to='#f1ce63'>
              <bucket>&quot;delay_duration_mins_greater_10_percent&quot;</bucket>
            </map>
            <map to='#f1ce63'>
              <bucket>&quot;quality_nps&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;bounces&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;brand_nps&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;is_voucher_percent&quot;</bucket>
            </map>
            <map to='#fabfd2'>
              <bucket>&quot;DURATION_TO_CANCELLATION_MINs_greater_60_percent&quot;</bucket>
            </map>
            <map to='#ff9d9a'>
              <bucket>&quot;delivery_time_mins_less_20_percent&quot;</bucket>
            </map>
            <map to='#ff9da7'>
              <bucket>&quot;time_to_order_in_minutes&quot;</bucket>
            </map>
            <map to='#ffbe7d'>
              <bucket>&quot;contact_rate_late&quot;</bucket>
            </map>
            <map to='#ffbe7d'>
              <bucket>&quot;csat_1to3&quot;</bucket>
            </map>
            <map to='#ffbe7d'>
              <bucket>&quot;order_on_time_percent&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <date-options start-of-week='monday' />
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_A8F080BB7607471885597B8FF4ABA2F3'>
            <properties context=''>
              <relation connection='bigquery.04c8glg19c8asj11ydyn90uq04k5' name='Custom SQL Query' type='text'><![CDATA[With 

--get the latest nps score of customer
--for all markets
--data from the last 1 year
nps as ( 
Select * from (
  SELECT 
    n.global_entity_id,
    n.analytical_customer_id,
    response_id,
    n.created_date,
    n.nps_score,
    n.nps_reason,
    Row_number() Over (PARTITION BY n.global_entity_id,n.analytical_customer_id order by n.created_date desc) rnk
  FROM 
    `fulfillment-dwh-production.curated_data_shared_cx.nps_relational_all_survey_responses` AS n
  LEFT JOIN fulfillment-dwh-production.curated_data_shared_coredata.global_entities  AS ge
    ON n.global_entity_id = ge.global_entity_id
  WHERE 
    ge.is_reporting_enabled
    AND n.created_date >>= current_date - 365
    and nps_score is not null
    AND (external_id is not null AND n.global_entity_id is not null)
  ) T
where rnk=1
),

--we need nps aggregation individual of the nps_combined tables. (previously we combined nps with orders, SO for correlation exercise- not needed here since this is dashboard reporting and needs original NPS trend)
nps_aggregated_temp as (
Select 
  global_entity_id,
  nps_reason,
  Date_trunc(created_date,week) nps_date,
  SUM(CASE WHEN nps_score >> 8 THEN 1 ELSE 0 END) promoters, 
  SUM(CASE WHEN nps_score <<= 6 THEN 1 ELSE 0 END) detractors,
  SUM(CASE WHEN nps_score IS NOT NULL THEN 1 ELSE 0 END) responses
FROM
  nps n
Group by 1,2,3
),

nps_aggregated as (
SELECT
  n.global_entity_id,
  n.nps_date,
  Sum(n.promoters) promoters,
  Sum(n.detractors) detractors,
  Sum(n.responses) responses,
  Safe_divide(Sum(n.promoters)-Sum(n.detractors),Sum(n.responses)) overall_nps,
  Safe_divide(Sum(Case when n.nps_reason is null then n.promoters End)-Sum(Case when n.nps_reason is null then n.detractors End),
    Sum(Case when n.nps_reason is null then n.responses End)) no_reason_nps,
  Safe_divide(Sum(Case when Trim(n.nps_reason) = 'Delivery' then n.promoters End)-Sum(Case when Trim(n.nps_reason) = 'Delivery' then n.detractors End),
    Sum(Case when Trim(n.nps_reason) = 'Delivery' then n.responses End)) delivery_nps,  --trim is to handle dq issues temporarily
  Safe_divide(Sum(Case when n.nps_reason = 'Quality and Accuracy' then n.promoters End)-
    Sum(Case when n.nps_reason = 'Quality and Accuracy' then n.detractors End), 
    Sum(Case when n.nps_reason = 'Quality and Accuracy' then n.responses End)) quality_nps,
  Safe_divide(Sum(Case when n.nps_reason = 'Deals and discounts' then n.promoters End)-
    Sum(Case when n.nps_reason = 'Deals and discounts' then n.detractors End), Sum(Case when n.nps_reason = 'Deals and discounts' then n.responses End)) deals_discounts_nps,
  Safe_divide(Sum(Case when n.nps_reason = 'Variety and ease of ordering' then n.promoters End)-
    Sum(Case when n.nps_reason = 'Variety and ease of ordering' then n.detractors End),Sum(Case when n.nps_reason = 'Variety and ease of ordering' then n.responses End)) variety_nps,
  Safe_divide(Sum(Case when n.nps_reason = 'Pricing' then n.promoters End)-Sum(Case when n.nps_reason = 'Pricing' then n.detractors End),
    Sum(Case when n.nps_reason = 'Pricing' then n.responses End)) pricing_nps,
  Safe_divide(Sum(Case when n.nps_reason = 'Customer service' then n.promoters End)-
    Sum(Case when n.nps_reason = 'Customer service' then n.detractors End),Sum(Case when n.nps_reason = 'Customer service' then n.responses End)) service_nps,
  Sum(Case when n.nps_reason is null then n.responses End) no_reason_responses,
  Sum(Case when Trim(n.nps_reason) = 'Delivery' then n.responses End) delivery_responses,   --trim is to handle dq issues temporarily
  Sum(Case when n.nps_reason = 'Quality and Accuracy' then n.responses End) quality_responses,
  Sum(Case when n.nps_reason = 'Deals and discounts' then n.responses End) deals_discounts_responses,
  Sum(Case when n.nps_reason = 'Variety and ease of ordering' then n.responses End) variety_responses,
  Sum(Case when n.nps_reason = 'Pricing' then n.responses End) pricing_responses,
  Sum(Case when n.nps_reason = 'Customer service' then n.responses End) service_responses
From
  nps_aggregated_temp n
Group by 1,2
),

--orders
--Pull orders table for last 13 months (1 month extra to ensure nps_date-30 data is always there)
orders as (
Select 
  o.global_entity_id,
  o.analytical_customer_id,
  o.order_id,
  o.placed_at_local,
  o.value.delivery_fee_eur,
  o.value.gmv_eur,
  o.is_acquisition,
  o.is_pickup,
  o.is_discount,
  o.VALUE.DISCOUNT_DH_EUR,
  o.is_voucher,
  o.VALUE.VOUCHER_DH_EUR,
  o.VALUE.MOV_EUR,
  o.value.service_fee_eur,
  o.is_own_delivery,
  o.is_free_delivery
from
  `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` AS o
LEFT JOIN fulfillment-dwh-production.curated_data_shared_coredata.global_entities  AS ge
  ON o.global_entity_id = ge.global_entity_id
LEFT JOIN fulfillment-dwh-production.curated_data_shared_coredata_business.vendors v 
  ON o.global_entity_id = v.global_entity_id and o.vendor_id = v.vendor_id
where
  o.is_sent
  AND o.placed_at_local >>= current_date - 395
  AND ge.is_reporting_enabled
),


--pull order related metrics within 30 days prior to the NPS response date
--due to join with NPS, orders will automatically be pulled only for live NPS-R markets
--data aggregated at customer level
nps_orders_combined as (
Select  
  o.global_entity_id,
  o.analytical_customer_id,
  n.nps_reason,
  n.created_date,
  Max(n.nps_score) nps_score,
  count(o.analytical_customer_id) num_orders,
  Avg(o.delivery_fee_eur) delivery_fee_eur,
  Avg(o.gmv_eur) gmv_eur,
  Safe_divide(Sum(o.delivery_fee_eur),Sum(o.gmv_eur)) delivery_fee_percent,
  Safe_divide(Sum(o.delivery_fee_eur),Sum(o.gmv_eur))>>0.2 AS delivery_fee_percent_greater_20,
  Max(If(o.is_acquisition,1,0)) is_acquisition, --if at least 1 order is_acquisition then true
  Round(Sum(If(o.is_pickup,1,0))/count(o.order_id)) is_pickup, --if more than 50% orders are is_pickup then true
  Round(Sum(If(o.is_discount,1,0))/count(o.order_id)) is_discount,
  Avg(o.DISCOUNT_DH_EUR) DISCOUNT_DH_EUR,
  Round(Sum(If(is_voucher,1,0))/count(o.order_id)) is_voucher,
  Avg(o.VOUCHER_DH_EUR) VOUCHER_DH_EUR,
  Round(Sum(If(is_discount,1,0))/count(o.order_id) + Sum(If(is_voucher,1,0))/count(o.order_id)) is_discount_voucher,
  Avg(VOUCHER_DH_EUR + DISCOUNT_DH_EUR) as discount_voucher_EUR,
  Avg(MOV_EUR) MOV_EUR,
  Avg(service_fee_eur) service_fee_eur,
  Round(Sum(If(o.is_own_delivery,1,0))/count(o.order_id)) is_own_delivery,
  Round(Sum(If(o.is_free_delivery,1,0))/count(o.order_id)) is_free_delivery,
from
  orders AS o
JOIN nps AS n
  ON o.global_entity_id = n.global_entity_id 
  and o.analytical_customer_id = n.analytical_customer_id
  and o.placed_at_local between n.created_date-30 and n.created_date 
Group by 1,2,3,4
),

--data aggregated at weekly level to get ready for running correlations
nps_orders_final as (
Select 
  global_entity_id,
  Date_trunc(created_date,week) nps_date,   
  SUM(CASE WHEN nps_score >> 8 THEN 1 ELSE 0 END) promoters,    
  SUM(CASE WHEN nps_score <<= 6 THEN 1 ELSE 0 END) detractors,   
  SUM(CASE WHEN nps_score IS NOT NULL THEN 1 ELSE 0 END) responses,   
  Count(analytical_customer_id) as all_customers,
  Avg(delivery_fee_percent) AS avg_delivery_fee_as_percent,
  Avg(Case when is_free_delivery=0 then delivery_fee_eur end) as avg_delivery_fee_eur,
  Avg(Case when is_discount=1 then DISCOUNT_DH_EUR end) as avg_discount_eur,
  Avg(Case when is_voucher=1 then VOUCHER_DH_EUR end) as avg_voucher_eur,
  Avg(Case when is_discount_voucher=1 then discount_voucher_EUR end) as avg_discount_and_voucher,
  Avg(Case when service_fee_eur<<>>0 then service_fee_eur end) as avg_service_fee_eur,

  Safe_divide(Count(Case when delivery_fee_percent_greater_20 then analytical_customer_id end),
    Count(analytical_customer_id)) as delivery_fee_percent_greater_20_percent,
  Safe_divide(Sum(is_acquisition),Count(analytical_customer_id)) as is_acquisition_percent,
  Safe_divide(Sum(is_pickup),Count(analytical_customer_id)) as is_pickup_percent,
  Safe_divide(Sum(is_free_delivery),Count(analytical_customer_id)) as is_free_delivery_percent,
  Safe_divide(Sum(is_own_delivery),Count(analytical_customer_id)) as is_own_delivery_percent,
  Safe_divide(Sum(is_discount),Count(analytical_customer_id)) as is_discount_percent,
  Safe_divide(Sum(is_voucher),Count(analytical_customer_id)) as is_voucher_percent,
  Safe_divide(Sum(is_discount_voucher),Count(analytical_customer_id)) as is_discount_and_voucher_percent,
  Safe_divide(Count(Case when service_fee_eur<<>>0 then analytical_customer_id end),
    Count(analytical_customer_id)) as is_service_fee_percent,
  Safe_divide(Count(Case when MOV_EUR<<>>0 then analytical_customer_id end),
    Count(analytical_customer_id)) as is_MOV_percent
From 
  nps_orders_combined
Group By 1,2
),

--seamless orders
--pull seamless order related metrics within 30 days prior to the NPS response date
--due to join with NPS, orders will automatically be pulled only for live NPS-R markets
--data aggregated at customer level
nps_Sorders_combined as (
Select  
  ge.global_entity_id,
  ord.analytical_customer_id,
  n.nps_reason,
  n.created_date,
  Max(n.nps_score) nps_score,
  count(o.order_id) num_orders,
  Round(Sum(If(o.is_preorder,1,0))/count(o.order_id)) is_preorder,
  Round(Sum(If(o.IS_SEAMLESS,1,0))/count(o.order_id)) IS_SEAMLESS,
  Avg(ORDER_DELAY_MINUTES) ORDER_DELAY_MINUTES,
  Avg(DELIVERY_TIME_MINUTES) DELIVERY_TIME_MINUTES,
  Round(Sum(If(DELIVERY_TIME_MINUTES>>60,1,0))/count(o.order_id)) delivery_time_mins_greater_60,
  Round(Sum(If(DELIVERY_TIME_MINUTES<<=20,1,0))/count(o.order_id)) delivery_time_mins_less_20,
  Round(Sum(If(DELIVERY_TIME_MINUTES>>45,1,0))/count(o.order_id)) delivery_time_mins_greater_45,
  Round(Sum(If(ORDER_DELAY_MINUTES>>10,1,0))/count(o.order_id)) delay_duration_mins_greater_10,
  Round(Sum(If(ORDER_DELAY_MINUTES<<=10,1,0))/count(o.order_id)) delay_duration_mins_less_10,
  Round(Sum(If(ORDER_DELAY_MINUTES>>5,1,0))/count(o.order_id)) delay_duration_mins_greater_5,
  Round(Sum(If(ABS(ORDER_DELAY_MINUTES) <<= 10,1,0))/count(o.order_id)) order_on_time,
  Round(Sum(If(o.IS_CANCELLATION_LOGISTICS,1,0))/count(o.order_id)) IS_CANCELLATION_LOGISTICS,
  Avg(Case when IS_CANCELLATION_LOGISTICS then DURATION_TO_CANCELLATION_MINUTES End) DURATION_TO_CANCELLATION_MINUTES,  
  Round(Sum(If(IS_CANCELLATION_LOGISTICS and o.DURATION_TO_CANCELLATION_MINUTES >>15,1,0))/count(o.order_id)) 
    as DURATION_TO_CANCELLATION_MINs_greater_15,
  Round(Sum(If(IS_CANCELLATION_LOGISTICS and o.DURATION_TO_CANCELLATION_MINUTES >>60,1,0))/count(o.order_id))
    as DURATION_TO_CANCELLATION_MINs_greater_60,
from
  fulfillment-dwh-production.curated_data_shared_gcc_service.seamless_orders o
JOIN orders AS ord   --so doesn't have acid
  ON ord.global_entity_id = o.global_entity_id and ord.order_id = o.order_id
JOIN nps AS n
  ON ord.global_entity_id = n.global_entity_id 
  and ord.analytical_customer_id = n.analytical_customer_id
  and o.created_date between n.created_date-30 and n.created_date 
LEFT JOIN fulfillment-dwh-production.curated_data_shared_coredata.global_entities  AS ge
  ON o.global_entity_id = ge.global_entity_id
LEFT JOIN fulfillment-dwh-production.curated_data_shared_coredata_business.vendors v 
    ON o.global_entity_id = v.global_entity_id and o.vendor_id = v.vendor_id
Group by 1,2,3,4
),

nps_Sorders_final As (
SELECT
  o.global_entity_id,
  Date_trunc(created_date,week) nps_date,   
  SUM(CASE WHEN nps_score >> 8 THEN 1 ELSE 0 END) promoters,    
  SUM(CASE WHEN nps_score <<= 6 THEN 1 ELSE 0 END) detractors,   
  SUM(CASE WHEN nps_score IS NOT NULL THEN 1 ELSE 0 END) responses,  
  Count(analytical_customer_id) all_customers,
  Safe_divide(Sum(o.IS_SEAMLESS),Count(analytical_customer_id)) as seamless_percent,
  Safe_divide(Sum(o.IS_CANCELLATION_LOGISTICS),Count(analytical_customer_id)) as cancelled_percent,
  Safe_divide(Sum(o.order_on_time),Count(analytical_customer_id)) as order_on_time_percent,
  Safe_divide(Sum(o.delivery_time_mins_less_20),Count(analytical_customer_id)) as delivery_time_mins_less_20_percent,
  Safe_divide(Sum(o.delivery_time_mins_greater_45),Count(analytical_customer_id)) as DT_mins_greater_45_mins_percent,
  Safe_divide(Sum(o.delivery_time_mins_greater_60),Count(analytical_customer_id)) as DT_mins_greater_60_mins_percent,
  Safe_divide(Sum(o.delay_duration_mins_less_10),
    Count(analytical_customer_id)) as delay_duration_mins_less_10_percent,
  Safe_divide(Sum(o.delay_duration_mins_greater_5),
    Count(analytical_customer_id)) as delay_duration_mins_greater_5_percent,
  Safe_divide(Sum(o.delay_duration_mins_greater_10),
    Count(analytical_customer_id)) as delay_duration_mins_greater_10_percent,
  Safe_divide(Sum(o.DURATION_TO_CANCELLATION_MINs_greater_15),
    Count(analytical_customer_id)) as DURATION_TO_CANCELLATION_MINs_greater_15_percent,
  Safe_divide(Sum(o.DURATION_TO_CANCELLATION_MINs_greater_60),
    Count(analytical_customer_id)) as DURATION_TO_CANCELLATION_MINs_greater_60_percent,
From 
  nps_Sorders_combined o
Group By 1,2
),

--service contacts
--aggregated for each customer get the metrics from the relevent table
--includes contacts placed for a successful order which are within 30 days of NPS survey
contacts as (   
Select 
  c.GLOBAL_ENTITY_ID,
  o.analytical_customer_id,
  Count(contact_id) as contacts,
  Round(Sum(If(contact_reason_l2 IN ('Delivery time', 'Order status'),1,0))/count(contact_id)) is_contact_late,
  Round(Sum(If(contact_reason_l2 IN ('Wrong / Missing item', 'Food Issue', 'Wrong order / Never arrived'),1,0))
    /count(contact_id)) is_contact_wrong_items,
FROM 
  fulfillment-dwh-production.curated_data_shared_gcc_service.all_contacts c
JOIN 
  orders AS o   --contacts doesn't have acid
  ON o.global_entity_id = c.global_entity_id and o.order_id = c.order_id
JOIN nps AS nps
  ON o.global_entity_id = nps.global_entity_id 
  and o.analytical_customer_id = nps.analytical_customer_id
  and o.placed_at_local between nps.created_date-30 and nps.created_date 
WHERE 
  c.order_id IS NOT NULL
  AND c.stakeholder = 'Customer'
Group by 1,2
),

--aggregated for each customer get the metrics from the relevent table
--includes contacts placed for a successful order which are within 30 days of NPS survey
chats as (
SELECT
  c.global_entity_id,
  o.analytical_customer_id, 
  Count(chat_id) as chats, 
  Round(Sum(If(served_chat_ind = 1 AND chat_within_sla_30_ind = 1,1,0))/count(chat_id)) is_sla_30s_chat
FROM 
  `fulfillment-dwh-production.curated_data_shared_gcc_service.all_chats` c
JOIN 
  orders AS o
  ON o.global_entity_id = c.global_entity_id and o.order_id = c.order_id
JOIN nps AS nps
  ON o.global_entity_id = nps.global_entity_id 
  and o.analytical_customer_id = nps.analytical_customer_id
  and o.placed_at_local between nps.created_date-30 and nps.created_date 
WHERE
  c.order_id IS NOT NULL
  AND stakeholder = 'Customer'
Group by 1,2
),


--All NPS responses for which order data is available but contacts data is optional
contact_chat_nps_combined as (  
SELECT 
  n.* except (rnk),
  c.contacts,
  If(c.analytical_customer_id is not null,1,0) is_contact,
  c.is_contact_late,
  c.is_contact_wrong_items,
  If(ch.analytical_customer_id is not null,1,0) is_chat,
  ch.is_sla_30s_chat
FROM 
  nps AS n
Left Join contacts c
  on c.global_entity_id = n.global_entity_id and c.analytical_customer_id = n.analytical_customer_id
Left Join chats ch
  on ch.global_entity_id = n.global_entity_id and ch.analytical_customer_id = n.analytical_customer_id
),

nps_service_final As(
SELECT
  global_entity_id,
  Date_trunc(created_date,week) nps_date,
  SUM(CASE WHEN nps_score >> 8 THEN 1 ELSE 0 END) promoters, 
  SUM(CASE WHEN nps_score <<= 6 THEN 1 ELSE 0 END) detractors,
  SUM(CASE WHEN nps_score IS NOT NULL THEN 1 ELSE 0 END) responses,
  Count(analytical_customer_id) customers,
  Sum(is_contact) customer_with_contacts,
  Sum(contacts) total_contacts,
  Sum(is_contact_late) is_contact_late,
  Sum(is_contact_wrong_items) is_contact_wrong_items,
  Safe_divide(Sum(is_contact),Count(analytical_customer_id)) contact_rate_with_cc,
  Safe_divide(Sum(contacts),Count(analytical_customer_id)) contact_rate_overall,
  Safe_divide(Sum(is_contact_late),Sum(is_contact)) contact_rate_late, 
  Safe_divide(Sum(is_contact_wrong_items),Sum(is_contact)) contact_rate_wm, 
  Sum(is_chat) customer_with_chats,
  Sum(is_sla_30s_chat) is_sla_30s_chat,
  Safe_divide(Sum(is_chat),Count(analytical_customer_id)) contact_rate_with_hc,
  Safe_divide(Sum(is_sla_30s_chat),Sum(is_chat)) sla_30s_chat
From 
  contact_chat_nps_combined
Group By 1,2
),


--CSAT
--aggregated for each customer get the metrics from the relevent table
--includes csats placed for a successful order which are within 30 days of NPS survey
csat_nps_orders_combined AS (   
SELECT 
  n.global_entity_id,
  o.analytical_customer_id,
  n.created_date AS nps_date,
  Max(nps.nps_score) nps_score,
  Count(n.ORDER_ID) all_csats,
  Round(Avg(CAST(n.csat AS INT64))) Csat,
FROM 
  `fulfillment-dwh-production.curated_data_shared_gcc_service.all_csat_responses` n
JOIN orders o 
  ON n.order_id = o.order_id and n.global_entity_id = o.global_entity_id  
JOIN nps AS nps
  ON o.global_entity_id = nps.global_entity_id 
  and o.analytical_customer_id = nps.analytical_customer_id
  and o.placed_at_local between nps.created_date-30 and nps.created_date 
WHERE 
  n.stakeholder='Customer'
  and csat is not null
Group by 1,2,3
),

nps_csat_final as (
SELECT
  global_entity_id,
  Date_trunc(nps_date,week) nps_date,
  SUM(CASE WHEN nps_score >> 8 THEN 1 ELSE 0 END) promoters, 
  SUM(CASE WHEN nps_score <<= 6 THEN 1 ELSE 0 END) detractors,
  SUM(CASE WHEN nps_score IS NOT NULL THEN 1 ELSE 0 END) responses,
  Count(analytical_customer_id) as all_customers,
  SUM(CASE WHEN csat = 1 THEN 1 ELSE 0 END) AS csat_1,
  SUM(CASE WHEN csat = 2 THEN 1 ELSE 0 END) AS csat_2,
  SUM(CASE WHEN csat = 3 THEN 1 ELSE 0 END) AS csat_3,
  SUM(CASE WHEN csat = 4 THEN 1 ELSE 0 END) AS csat_4,
  SUM(CASE WHEN csat = 5 THEN 1 ELSE 0 END) AS csat_5,
  Safe_divide(SUM(CASE WHEN csat >> 3 THEN 1 ELSE 0 END),Count(analytical_customer_id)) csat_1to3,
  Safe_divide(SUM(CASE WHEN csat <<= 3 THEN 1 ELSE 0 END),Count(analytical_customer_id)) csat_4to5,
  Avg(CSAT) avg_CSAT,
FROM  
  csat_nps_orders_combined
Group by 1,2
),

--get all sessions within 1 day before the order
--get it only for for orders within 30 days of the NPS survey
--data aggregated at customer level
nps_session_combined As (  
SELECT
  ga.global_entity_id,
  n.analytical_customer_id,
  ga.partition_date,
  Max(n.nps_score) nps_score,
  Count(ga.SESSION_ID) num_sessions,
  count(Case when has_order then nested_orders.order_id end) orders,
  Avg(Case when has_order then time_home_in_minutes end) time_home_in_minutes,
  Avg(Case when has_order then time_list_in_minutes end) time_list_in_minutes,
  Avg(Case when has_order then time_menu_in_minutes end) time_menu_in_minutes,
  Avg(Case when has_order then time_start_cart_in_minutes end) time_start_cart_in_minutes,
  Avg(Case when has_order then time_checkout_in_minutes end) time_checkout_in_minutes,
  Avg(Case when has_order then time_to_order_in_minutes end) time_to_order_in_minutes,
  Sum(totals.bounces) bounces
  --unique_shop --to be used later for choice  
FROM 
  fulfillment-dwh-production.curated_data_shared_coredata_tracking.perseus_sessions ga
LEFT JOIN unnest(ga.orders) as nested_orders 
JOIN orders o
  on nested_orders.order_id = o.order_id
  and ga.partition_date between Date(o.placed_at_local) -1 and Date(o.placed_at_local)
JOIN nps AS n
  ON o.global_entity_id = n.global_entity_id 
  and o.analytical_customer_id = n.analytical_customer_id
  and o.placed_at_local between n.created_date-30 and n.created_date 
Group by 1,2,3
),

 --cvr and bounces not reliable metrics as we are considering only those sessions with orders so will be 0 and 1 resp
--data aggregated at weekly level
nps_session_final as (
Select 
  global_entity_id,
  Date_trunc(partition_date,week) nps_date,
  SUM(CASE WHEN nps_score >> 8 THEN 1 ELSE 0 END) promoters, 
  SUM(CASE WHEN nps_score <<= 6 THEN 1 ELSE 0 END) detractors,
  SUM(CASE WHEN nps_score IS NOT NULL THEN 1 ELSE 0 END) responses,
  Count(analytical_customer_id) customers,
  Sum(num_sessions) num_sessions,
  --Sum(orders) orders,
  --Safe_divide(Sum(orders),Sum(num_sessions)) cvr,
  Avg(time_home_in_minutes) time_home_in_minutes,
  Avg(time_list_in_minutes) time_list_in_minutes,
  Avg(time_menu_in_minutes) time_menu_in_minutes,
  Avg(time_start_cart_in_minutes) time_start_cart_in_minutes,
  Avg(time_checkout_in_minutes) time_checkout_in_minutes,
  Avg(time_to_order_in_minutes) time_to_order_in_minutes,
  --Avg(bounces) bounces,
From 
  nps_session_combined
Group By 1,2
),

category_static As(
  Select 'avg_csat' as KPI, 'Service NPS' as category
  Union All Select 'avg_delivery_fee_percent', 'Pricing NPS'
  --Union All Select 'bounces', 'Quality NPS'
  Union All Select 'cancelled_percent', 'Quality NPS'
  Union All Select 'csat_1to3', 'Service NPS'
  Union All Select 'csat_4to5', 'Service NPS'
  --Union All Select 'cvr', 'Application NPS'
  Union All Select 'delay_duration_mins_greater_10_percent', 'Pricing NPS'
  Union All Select 'delay_duration_mins_greater_5_percent', 'Pricing NPS'
  Union All Select 'delay_duration_mins_less_10_percent', 'Pricing NPS'
  Union All Select 'delivery_fee_percent_greater_20_percent', 'Pricing NPS'
  Union All Select 'delivery_time_mins_less_20_percent', 'Delivery NPS'
  Union All Select 'DT_mins_greater_45_mins_percent', 'Quality NPS'
  Union All Select 'DT_mins_greater_60_mins_percent', 'Quality NPS'
  Union All Select 'DURATION_TO_CANCELLATION_MINs_greater_15_percent', 'Quality NPS'
  Union All Select 'DURATION_TO_CANCELLATION_MINs_greater_60_percent', 'Quality NPS'
  Union All Select 'is_acquisition_percent', 'Brand NPS'
  Union All Select 'is_discount_and_voucher_percent', 'Pricing NPS'
  Union All Select 'is_discount_percent', 'Delivery NPS'
  Union All Select 'is_free_delivery_percent', 'Pricing NPS'
  Union All Select 'is_MOV_percent', 'Pricing NPS'
  Union All Select 'is_own_delivery_percent', 'Delivery NPS'
  Union All Select 'is_pickup_percent', 'Delivery NPS'
  Union All Select 'is_service_fee_percent', 'Payment NPS'
  Union All Select 'is_voucher_percent', 'Pricing NPS'
  Union All Select 'order_on_time_percent', 'Delivery NPS'
  Union All Select 'seamless_percent', 'Quality NPS'
  Union All Select 'time_checkout_in_minutes', 'Pricing NPS'
  Union All Select 'time_home_in_minutes', 'Variety NPS'
  Union All Select 'time_list_in_minutes', 'Variety NPS'
  Union All Select 'time_menu_in_minutes', 'Variety NPS'
  Union All Select 'time_start_cart_in_minutes', 'Pricing NPS'
  Union All Select 'time_to_order_in_minutes', 'Pricing NPS'
  Union All Select 'contact_rate_late', 'Service NPS'
  Union All Select 'contact_rate_overall', 'Service NPS'
  Union All Select 'contact_rate_with_cc', 'Service NPS'
  Union All Select 'contact_rate_with_hc', 'Service NPS'
  Union All Select 'contact_rate_wm', 'Service NPS'

  Union All Select 'overall_nps', 'Overall NPS'
  Union All Select 'no_reason_nps', 'No Reason NPS'
  Union All Select 'delivery_nps', 'Delivery NPS'
  Union All Select 'quality_nps', 'Quality NPS'
  Union All Select 'deals_discounts_nps', 'Deals & Discounts NPS'
  Union All Select 'variety_nps', 'Variety NPS'
  Union All Select 'pricing_nps', 'Pricing NPS'
  Union All Select 'service_nps', 'Service NPS'

  Union All Select 'avg_delivery_fee_eur', 'uncategorised'
  Union All Select 'avg_discount_eur', 'uncategorised'
  Union All Select 'avg_voucher_eur', 'uncategorised'
  Union All Select 'avg_discount_and_voucher', 'uncategorised'
  Union All Select 'avg_service_fee_eur', 'uncategorised'
  Union All Select 'delivery_fee_percent_greater_20_percent', 'uncategorised'
  Union All Select 'sla_30s_chat', 'uncategorised'
),

temp as(
Select 
  n.global_entity_id,
  n.nps_date,
  --customer segmentation here
  --vertical, sub_entity, management_entity here

  --nps
  Cast(n.overall_nps as float64) overall_nps,
  Cast(n.no_reason_nps as float64) no_reason_nps,
  Cast(n.delivery_nps as float64) delivery_nps,
  Cast(n.quality_nps as float64) quality_nps,
  Cast(n.deals_discounts_nps as float64) deals_discounts_nps,
  Cast(n.variety_nps as float64) variety_nps,
  Cast(n.pricing_nps as float64) pricing_nps,
  Cast(n.service_nps as float64) service_nps,
  
  /*
  Cast(n.no_reason_responses as float64) no_reason_responses,
  Cast(n.delivery_responses as float64) delivery_responses,
  Cast(n.quality_responses as float64) quality_responses,
  Cast(n.deals_discounts_responses as float64) deals_discounts_responses,
  Cast(n.variety_responses as float64) variety_responses,
  Cast(n.pricing_responses as float64) pricing_responses,
  Cast(n.service_responses as float64) service_responses,
  */

  --orders
  --Cast(o.all_customers as float64) orders_all_customers,
  Cast(o.delivery_fee_percent_greater_20_percent as float64) delivery_fee_percent_greater_20_percent,
  Cast(o.is_acquisition_percent as float64) is_acquisition_percent,
  Cast(o.is_pickup_percent as float64) is_pickup_percent,
  Cast(o.is_free_delivery_percent as float64) is_free_delivery_percent,
  Cast(o.is_own_delivery_percent as float64) is_own_delivery_percent,
  Cast(o.is_discount_percent as float64) is_discount_percent,
  Cast(o.is_voucher_percent as float64) is_voucher_percent,
  Cast(o.is_discount_and_voucher_percent as float64) is_discount_and_voucher_percent,
  --Cast(o.is_service_fee_percent as float64) is_service_fee_percent,
  --Cast(o.is_MOV_percent as float64) is_MOV_percent,
  Cast(o.avg_delivery_fee_as_percent as float64) avg_delivery_fee_percent,
  Cast(o.avg_delivery_fee_eur as float64) avg_delivery_fee_eur,
  Cast(o.avg_discount_eur as float64) avg_discount_eur,
  Cast(o.avg_voucher_eur as float64) avg_voucher_eur,
  Cast(o.avg_discount_and_voucher as float64) avg_discount_and_voucher,
  Cast(o.avg_service_fee_eur as float64) avg_service_fee_eur,
  

  --Sorders
  --Cast(s.all_customers as float64) so_all_customers,
  Cast(s.seamless_percent as float64) seamless_percent,
  Cast(s.cancelled_percent as float64) cancelled_percent,
  Cast(s.order_on_time_percent as float64) order_on_time_percent,
  Cast(s.delivery_time_mins_less_20_percent as float64) delivery_time_mins_less_20_percent,
  Cast(s.DT_mins_greater_45_mins_percent as float64) DT_mins_greater_45_mins_percent,
  Cast(s.DT_mins_greater_60_mins_percent as float64) DT_mins_greater_60_mins_percent,
  Cast(s.delay_duration_mins_less_10_percent as float64) delay_duration_mins_less_10_percent,
  Cast(s.delay_duration_mins_greater_5_percent as float64) delay_duration_mins_greater_5_percent,
  Cast(s.delay_duration_mins_greater_10_percent as float64) delay_duration_mins_greater_10_percent,
  Cast(s.DURATION_TO_CANCELLATION_MINs_greater_15_percent as float64) DURATION_TO_CANCELLATION_MINs_greater_15_percent,
  Cast(s.DURATION_TO_CANCELLATION_MINs_greater_60_percent as float64) DURATION_TO_CANCELLATION_MINs_greater_60_percent,

  --service
  --Cast(svc.customers as float64) svc_customers,
  --Cast(svc.customer_with_contacts as float64) customer_with_contacts,
  --Cast(svc.is_contact_late as float64) is_contact_late,
  --Cast(svc.is_contact_wrong_items as float64) is_contact_wrong_items,
  Cast(svc.contact_rate_with_cc as float64) contact_rate_with_cc,
  Cast(svc.contact_rate_overall as float64) contact_rate_overall,
  Cast(svc.contact_rate_late as float64) contact_rate_late, 
  Cast(svc.contact_rate_wm as float64) contact_rate_wm, 
  --Cast(svc.customer_with_chats as float64) customer_with_chats,
  --Cast(svc.is_sla_30s_chat as float64) is_sla_30s_chat,
  Cast(svc.contact_rate_with_hc as float64) contact_rate_with_hc,
  Cast(svc.sla_30s_chat as float64) sla_30s_chat,

  --csat
  --Cast(c.all_customers as float64) csat_all_customers,
  --Cast(c.csat_4to5_responses as float64) csat_4to5_responses,
  --Cast(c.csat_1to3_responses as float64) csat_1to3_responses,
  Cast(c.csat_4to5 as float64) csat_4to5,
  Cast(c.csat_1to3 as float64) csat_1to3,
  Cast(c.avg_csat as float64) avg_csat,

  --session
  --Cast(sn.customers as float64) session_customers,
  --Cast(sn.cvr as float64) cvr,
  Cast(sn.time_home_in_minutes as float64) time_home_in_minutes,
  Cast(sn.time_list_in_minutes as float64) time_list_in_minutes,
  Cast(sn.time_menu_in_minutes as float64) time_menu_in_minutes,
  Cast(sn.time_start_cart_in_minutes as float64) time_start_cart_in_minutes,
  Cast(sn.time_checkout_in_minutes as float64) time_checkout_in_minutes,
  Cast(sn.time_to_order_in_minutes as float64) time_to_order_in_minutes,
  --Cast(sn.bounces as float64) bounces

From 
  nps_aggregated n
Join
  nps_orders_final o
  on n.global_entity_id = o.global_entity_id
  and n.nps_date = o.nps_date
Join
  nps_Sorders_final s
  on n.global_entity_id = s.global_entity_id
  and n.nps_date = s.nps_date
Join
  nps_service_final svc
  on n.global_entity_id = svc.global_entity_id
  and n.nps_date = svc.nps_date
Join
  nps_csat_final c
  on n.global_entity_id = c.global_entity_id
  and n.nps_date = c.nps_date
Join
  nps_session_final sn
  on n.global_entity_id = sn.global_entity_id
  and n.nps_date = sn.nps_date
),

final as (
SELECT * FROM temp
UNPIVOT(
  Value FOR KPI IN (
    /*
    promoters,
    detractors,
    responses,
    */

    --nps
    overall_nps,
    no_reason_nps,
    delivery_nps,
    quality_nps,
    deals_discounts_nps,
    variety_nps,
    pricing_nps,
    service_nps,
    
    /*
    no_reason_responses,
    delivery_responses,
    quality_responses,
    pricing_responses,
    pickup_responses,
    variety_responses,
    application_responses,
    payment_responses,
    cancellation_responses,
    brand_responses,
    service_responses,
    other_responses,
    */

    --orders
    --orders_all_customers,
    delivery_fee_percent_greater_20_percent,
    is_acquisition_percent,
    is_pickup_percent,
    is_free_delivery_percent,
    is_own_delivery_percent,
    is_discount_percent,
    is_voucher_percent,
    is_discount_and_voucher_percent,
    --is_service_fee_percent,
    --is_MOV_percent,
    
    avg_delivery_fee_percent,
    avg_delivery_fee_eur,
    avg_discount_eur,
    avg_voucher_eur,
    avg_discount_and_voucher,
    avg_service_fee_eur,

    --Sorders
    --so_all_customers,
    seamless_percent,
    cancelled_percent,
    order_on_time_percent,
    delivery_time_mins_less_20_percent,
    DT_mins_greater_45_mins_percent,
    DT_mins_greater_60_mins_percent,
    delay_duration_mins_less_10_percent,
    delay_duration_mins_greater_5_percent,
    delay_duration_mins_greater_10_percent,
    DURATION_TO_CANCELLATION_MINs_greater_15_percent,
    DURATION_TO_CANCELLATION_MINs_greater_60_percent,

    --service
    --svc_customers,
    --customer_with_contacts,
    --is_contact_late,
    --is_contact_wrong_items,
    contact_rate_with_cc,
    contact_rate_overall,
    contact_rate_late, 
    contact_rate_wm, 
    --customer_with_chats,
    --is_sla_30s_chat,
    contact_rate_with_hc,
    sla_30s_chat,

    --csat
    --csat_all_customers,
    --csat_4to5_responses,
    --csat_1to3_responses,
    csat_4to5,
    csat_1to3,
    avg_csat,

    --session
    --session_customers,
    --cvr,
    time_home_in_minutes,
    time_list_in_minutes,
    time_menu_in_minutes,
    time_start_cart_in_minutes,
    time_checkout_in_minutes,
    time_to_order_in_minutes
    --bounces
  )
))

Select
  f.*,
  c.category
FROM Final f
Join category_static c on c.kpi = f.kpi]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='SQI View' inline='true' name='federated.1oisr9f1i2kb6116wdk4811s0cuw' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0pghwk51yoprh81b7ml2l0t2s5cw'>
            <connection CATALOG='publicdata' EXECCATALOG='global-cx' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='publicdata' schema='samples' server-oauth='' username='aakash.jaiswal@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0pghwk51yoprh81b7ml2l0t2s5cw' name='Custom SQL Query' type='text'><![CDATA[Select 
  s.management_entity,
  If(s.global_entity_id='ALL','Overall',s.global_entity_id) global_entity_id,
  If(s.sub_entity='ALL','Overall',s.sub_entity) sub_entity,
  If(s.vertical='ALL','Overall',s.vertical) vertical,
  s.nps,	
  s.responded,	
  s.targeted,	
  s.response_rate_by_targeted,	
  s.response_rate_by_ordering,	
  s.population,	
  s.sampling_rate,
  s.n_opt as optimal_responses_needed,	
  s.cadence_possible_days,
  Case 
    When s.cadence_possible_days<<=30 then 'Monthly'
    When s.cadence_possible_days<<=60 then 'Bi-Monthly'
    Else 'Stats Insignificant'
  End AS sampling_cadence,
  s.orders_braze,	
  s.orders_pre,	
  s.orders_post,
  Date('2023-10-01') as reporting_month,
  Date('2023-12-05') as snapshot_date
From 
  fulfillment-dwh-production.curated_data_shared_cx.nps_relational_sqi AS s
Where
  management_entity <<>> 'Foodpanda APAC'
  AND sub_entity Not in ('Yemeksepeti','Foody')
Order by 1,2,3,4]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0pghwk51yoprh81b7ml2l0t2s5cw' name='Custom SQL Query' type='text'><![CDATA[Select 
  s.management_entity,
  If(s.global_entity_id='ALL','Overall',s.global_entity_id) global_entity_id,
  If(s.sub_entity='ALL','Overall',s.sub_entity) sub_entity,
  If(s.vertical='ALL','Overall',s.vertical) vertical,
  s.nps,	
  s.responded,	
  s.targeted,	
  s.response_rate_by_targeted,	
  s.response_rate_by_ordering,	
  s.population,	
  s.sampling_rate,
  s.n_opt as optimal_responses_needed,	
  s.cadence_possible_days,
  Case 
    When s.cadence_possible_days<<=30 then 'Monthly'
    When s.cadence_possible_days<<=60 then 'Bi-Monthly'
    Else 'Stats Insignificant'
  End AS sampling_cadence,
  s.orders_braze,	
  s.orders_pre,	
  s.orders_post,
  Date('2023-10-01') as reporting_month,
  Date('2023-12-05') as snapshot_date
From 
  fulfillment-dwh-production.curated_data_shared_cx.nps_relational_sqi AS s
Where
  management_entity <<>> 'Foodpanda APAC'
  AND sub_entity Not in ('Yemeksepeti','Foody')
Order by 1,2,3,4]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
