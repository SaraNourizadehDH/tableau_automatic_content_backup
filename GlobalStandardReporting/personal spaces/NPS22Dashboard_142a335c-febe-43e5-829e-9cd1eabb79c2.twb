            <column caption='Reporting Month' datatype='string' name='[Calculation_2379448733054353410]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[reporting_month]) + &apos; &apos; + DATENAME(&apos;year&apos;,[reporting_month])' />
            </column>
