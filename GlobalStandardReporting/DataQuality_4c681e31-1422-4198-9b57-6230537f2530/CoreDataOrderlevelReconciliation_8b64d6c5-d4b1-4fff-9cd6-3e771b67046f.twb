      <aliases enabled='yes' />
      <column caption='Last Report Date' datatype='boolean' name='[Calculation_3071595718887870464]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATE([placed_at_local]) = [Calculation_3586202356649672705] THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Orders' datatype='integer' name='[Calculation_3071595718890065921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_3071595719222321154]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;DH Platform&quot; THEN [dh_platform]&#10;    WHEN &quot;Sub-Entity&quot; THEN [sub_entity]&#10;END' />
      </column>
      <column caption='Placed At Local MAX' datatype='date' name='[Calculation_3586202356649672705]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED : MAX(DATE([placed_at_local]))}' />
      </column>
      <column caption='Problem Owner' datatype='string' name='[Problem (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[problem]' new-bin='true'>
          <bin default-name='false' value='&quot;Coredata&quot;'>
            <value>&quot;Coredata Orders missing order&quot;</value>
            <value>&quot;Coredata Orders status incorrect&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Platform&quot;'>
            <value>&quot;<![CDATA[Delivery Fee in local currency <99\% correct]]>&quot;</value>
            <value>&quot;<![CDATA[GBV in local currency <99\% correct]]>&quot;</value>
            <value>&quot;GMV in EUR &lt;99\% correct&quot;</value>
            <value>&quot;<![CDATA[GMV in local currency <99\% correct]]>&quot;</value>
            <value>&quot;<![CDATA[Incentives total in local currency <99\% correct]]>&quot;</value>
            <value>&quot;Incorrect customer_id&quot;</value>
            <value>&quot;Order Status stream final status incorrect&quot;</value>
            <value>&quot;Order Status stream missing order&quot;</value>
            <value>&quot;Order stream missing order&quot;</value>
            <value>&quot;<![CDATA[Service Fee in local currency <99\% correct]]>&quot;</value>
          </bin>
        </calculation>
      </column>
