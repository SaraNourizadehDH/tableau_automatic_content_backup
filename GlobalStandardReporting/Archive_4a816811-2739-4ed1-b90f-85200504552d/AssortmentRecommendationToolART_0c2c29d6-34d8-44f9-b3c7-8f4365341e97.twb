          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='309' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='98764' id='308' param='vert' type-v2='layout-flow' w='99318' x='341' y='618'>
                <zone fixed-size='108' h='14551' id='13' is-fixed='true' is-scaled='1' param='Image/DH-LOGO-01 (1).jpeg' type-v2='bitmap' w='17599' x='341' y='618'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
