              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone fixed-size='93' forceUpdate='true' h='14551' id='14' is-fixed='true' type-v2='text' w='81719' x='17940' y='618'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#c42f45' fontsize='30'>Assortment Reccomendation Tool</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run bold='true' fontalignment='1' fontcolor='#606b76' fontsize='12'>Local Shops</run>
              <run fontalignment='1'>Æ&#10;&#10;</run>
              <run bold='true' fontalignment='1' fontcolor='#c42f45' fontname='Tableau Bold' fontsize='22'>User-guide  and Terminologies</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
