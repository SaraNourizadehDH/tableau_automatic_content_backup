      <table>
        <view>
          <datasources>
            <datasource caption='ART - Top Selling Products - Last 12 months' name='federated.1f51fbd1xe8tzf19lg7kq1sds9k0' />
          </datasources>
          <datasource-dependencies datasource='federated.1f51fbd1xe8tzf19lg7kq1sds9k0'>
            <column caption='[Vendor Levele] % Active Top Selling Products' datatype='real' name='[% Active Top Selling Products (copy)_6924073371953152002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_1489706344300732416], [seasonal_or_annual], [city]: COUNTD(IF [Calculation_3093902604589355008] = &apos;Active&apos; THEN [master_code] END) / COUNTD([master_code])}' />
            </column>
            <column caption='Vendor Information' datatype='string' name='[Calculation_1489706344300732416]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot; ( &quot; + [platform_vendor_id] + &quot; ) - &quot; + [vendor_name] + &quot; - &quot; + [global_entity_id]&#10;&#10;//&quot; ( &quot; + [Platform Vendor Id] + &quot; ) - &quot; + [vendor_name] + &quot; - &quot; + [Global Entity Id] + &quot; - &quot; + [City]' />
            </column>
            <column caption='AAA Flag' datatype='string' name='[Calculation_2406611102327435264]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ISNULL([aaa_chain_name_cleaned]) = true then &apos;False&apos; else &apos;True&apos; end' />
            </column>
            <column caption='Catalog Status' datatype='string' name='[Calculation_3093902604589355008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [is_present_in_assortment] = 0 then &apos;Not listed on Catalog&apos;&#10;elseif [status] = &apos;Off&apos; then &apos;Inactive&apos;&#10;ELSEIF [status] = &apos;Out of Catalog&apos; then &apos;Deleted from Catalog&apos;&#10;ELSEIF [status] = &apos;In Catalog&apos; then &apos;Active&apos;&#10;end' />
            </column>
            <column caption='Country or City Level' datatype='string' name='[Calculation_600597261854785536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [city] = &apos;country_level&apos; then &apos;Country Level&apos;&#10;else &apos;City Level&apos; end' />
            </column>
            <column datatype='string' name='[aaa_chain_name_cleaned]' role='dimension' type='nominal' />
            <column caption='Account Manager' datatype='string' name='[account_manager]' role='dimension' type='nominal' />
            <column-instance column='[% Active Top Selling Products (copy)_6924073371953152002]' derivation='Avg' name='[avg:% Active Top Selling Products (copy)_6924073371953152002:qk]' pivot='key' type='quantitative' />
