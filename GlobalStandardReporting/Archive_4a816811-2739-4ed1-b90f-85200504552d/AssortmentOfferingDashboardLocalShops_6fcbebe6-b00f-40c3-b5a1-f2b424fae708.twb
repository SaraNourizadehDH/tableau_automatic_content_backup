      <column caption='Level (2)' datatype='string' name='[Breakdown (copy)_3005660209780588553]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Select Breakdown (copy)_3005660209780527112]&#10;//WHEN &quot;1&quot; THEN STR([vendor_name])&#10;WHEN &quot;2&quot; THEN STR([chain_name])&#10;WHEN &quot;3&quot; THEN STR([global_entity_id])&#10;WHEN &quot;4&quot; THEN STR([country_name])&#10;//WHEN &quot;5&quot; THEN STR([is_acquisition_darkstore])&#10;WHEN &quot;6&quot; THEN [region]&#10;//WHEN &quot;7&quot; THEN [management_entity]&#10;//WHEN &quot;8&quot; THEN [city]&#10;//WHEN &quot;9&quot; THEN [store_type]&#10;//WHEN &quot;10&quot; THEN [global_view]&#10;END' />
      </column>
      <column caption='Null_region' datatype='string' name='[Calculation_1451355379718844416]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISNULL([region]) or [region] = &apos;Null&apos; then &apos;Null&apos; else &apos;Not Null&apos; end' />
      </column>
      <column caption='Null_Not_Null' datatype='string' name='[Calculation_1451355379736616961]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISNULL([global_entity_id]) THEN &apos;NULL&apos; ELSE &apos;NOT NULL&apos; END' />
      </column>
      <column caption='AAA Flag' datatype='string' name='[Calculation_2274106757069148160]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([aaa_chain_name_cleaned]) = TRUE then &apos;False&apos; ELSE &apos;True&apos; END' />
      </column>
      <column caption='New Level Name' datatype='string' name='[Calculation_2274106757070163969]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [level] = &apos;Vendor ID&apos; THEN &quot;(&quot; + [level_name] + &quot;) &quot; + [vendor_name] &#10;ELSEIF [level] = &apos;Chain ID&apos; THEN &quot;(&quot; + [level_name] + &quot;) &quot; + [chain_name]&#10;ELSE [level_name]&#10;END' />
      </column>
      <column caption='Top 3' datatype='boolean' name='[Calculation_3005660209716801540]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST()&lt;3'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Apply' datatype='string' name='[Calculation_3406269436258721793]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Apply&quot;' />
      </column>
      <column caption='#Vendors' datatype='integer' name='[Calculation_5504102457499828233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([platform_vendor_id])' />
      </column>
      <column caption='Measure' datatype='integer' name='[Calculation_6804868675105562626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;#Vendors&quot; THEN COUNTD([platform_vendor_id])&#10;//WHEN &quot;#SKU&quot; THEN COUNTD([Sku])&#10;//WHEN &quot;#Global Product ID&quot; THEN COUNTD([Global Product Id])&#10;//WHEN &quot;#Master Code&quot; THEN COUNTD([Master Code])&#10;END' />
      </column>
      <column caption='Level (3)' datatype='string' name='[Dimension X (pim)  (copy)_3232177210295291904]' role='dimension' type='nominal'>
