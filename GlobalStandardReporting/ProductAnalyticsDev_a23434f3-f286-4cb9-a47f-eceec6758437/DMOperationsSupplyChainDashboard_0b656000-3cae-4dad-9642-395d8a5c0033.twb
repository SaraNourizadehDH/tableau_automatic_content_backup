      <column caption='Weighted Availability %' datatype='real' name='[Calculation_3837489128366522369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([available_events_weightage]*IFNULL(sales_forecast_quantity_corr,0))/&#10;sum([total_events_weightage]*IFNULL(sales_forecast_quantity_corr,0))' />
