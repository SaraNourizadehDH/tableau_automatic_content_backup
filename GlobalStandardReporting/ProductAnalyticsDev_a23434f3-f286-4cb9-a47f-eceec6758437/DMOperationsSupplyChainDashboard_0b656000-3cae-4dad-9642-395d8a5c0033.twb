          <datasource-dependencies datasource='federated.0sao06n15z6zt51292chc1fne7fl'>
            <column caption='Requested Qty' datatype='integer' name='[Calculation_248049883867996163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [order_status] = &apos;done&apos; &#10;        THEN [total_demanded_qty_per_order]&#10;    ELSE 0 &#10;END' />
            </column>
            <column caption='Supplier Fill Rate %' datatype='real' name='[Calculation_248049883872342023]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_received_qty_per_order])/(SUM([Calculation_248049883867996163]) + SUM([Requested Qty (copy)_248049883871617030]))' />
            </column>
            <column caption='Supplier Non Fulfilled Order Quantity' datatype='integer' name='[Requested Qty (copy)_248049883871617030]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;[region] = &quot;America&quot; AND &#10;[cancel_reason] IN (&apos;Supplier non fulfillment&apos;,&apos;AUTO CANCELLED&apos;, &apos;Stock not available&apos;)&#10;  THEN total_demanded_qty_per_order&#10;ELSEIF  &#10;[region] &lt;&gt; &quot;America&quot; AND &#10;[cancel_reason] IN (&apos;Supplier non fulfillment&apos;, &apos;AUTO CANCELLED&apos;) &#10;  THEN total_demanded_qty_per_order &#10;ELSE 0 &#10;END' />
            </column>
            <column caption='Cancel Reason' datatype='string' name='[cancel_reason]' role='dimension' type='nominal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_248049883867996163]' derivation='Sum' name='[sum:Calculation_248049883867996163:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_demanded_qty_per_order]' derivation='Sum' name='[sum:total_demanded_qty_per_order:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_received_qty_per_order]' derivation='Sum' name='[sum:total_received_qty_per_order:qk]' pivot='key' type='quantitative' />
