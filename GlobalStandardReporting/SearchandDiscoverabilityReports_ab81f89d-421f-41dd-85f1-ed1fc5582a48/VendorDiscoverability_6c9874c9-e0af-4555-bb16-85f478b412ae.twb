          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
              <aliases>
                <alias key='&quot;Day&quot;' value='Daily' />
                <alias key='&quot;Month&quot;' value='Monthly' />
                <alias key='&quot;Quarter&quot;' value='Quarterly' />
                <alias key='&quot;Week&quot;' value='Weekly' />
                <alias key='&quot;Year&quot;' value='Yearly' />
              </aliases>
            </column>
            <column caption='Select level of details' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0furr2h1k46wja1egcgy2069ry2m'>
            <column caption='CVR' datatype='real' default-format='p0.00%' name='[CVR- Transactions (copy)_2118028860197515264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_orders]) / SUM([total_sessions_localshops])' />
            </column>
            <column caption='Period' datatype='string' datatype-customized='true' name='[Calculation_2118028860221112325]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN &#10;    STR(DATEPART(&apos;year&apos;, [day])) + STR(&apos;-&apos;) + STR(DATEPART(&apos;month&apos;, [day])) + STR(&apos;-&apos;) + STR(DATEPART(&apos;day&apos;, [day]))&#10;&#10;WHEN &apos;Week&apos; THEN STR(DATEPART(&apos;year&apos;, [day])) + STR(&quot;-W&quot;) + STR(DATEPART(&apos;week&apos;, [day]))&#10;&#10;&#10;WHEN &apos;Month&apos; THEN STR(DATEPART(&apos;year&apos;, [day])) &#10;&#9;+ STR(&quot;-&quot;) &#10;&#9;+ IF DATEPART(&apos;month&apos;, [day]) &lt; 10 THEN STR(&quot;0&quot;) ELSE STR(&quot;&quot;) END&#10;&#9;+ STR(DATEPART(&apos;month&apos;, [day]))&#10;WHEN &apos;Quarter&apos; THEN STR(DATEPART(&apos;year&apos;, [day])) + STR(&quot;-Q&quot;) + STR(DATEPART(&apos;quarter&apos;, [day]))&#10;WHEN &apos;Year&apos; THEN STR(DATEPART(&apos;year&apos;, [day]))&#10;END' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_3699847860891140096]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&apos;Management Entity&apos; then [management_entity] &#10;else &apos;&apos; end' />
            </column>
            <column caption='Country' datatype='string' name='[Calculation_717831591025639424]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&apos;Country&apos; then [country]&#10;else &apos;&apos; end' />
            </column>
            <column caption='Vertical' datatype='string' name='[Country (copy)_3699847860895649796]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&apos;Vertical&apos; then [vertical_type]&#10;else &apos;&apos; end' />
