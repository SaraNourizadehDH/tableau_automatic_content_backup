      <column caption='CVR' datatype='real' name='[Calculation_2118028860279558154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(([total_orders]) )/ sum(([total_sessions_localshops_month]))' />
      </column>
      <column caption='Orders Per Vendor' datatype='real' name='[Calculation_2118028860282949644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_orders]) / sum([online_vendors])' />
      </column>
      <column caption='Sessions Per Vendor' datatype='real' name='[Calculation_2904469945255419904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([total_sessions_localshops_month])/ sum([online_vendors])' />
      </column>
      <column caption='CVR3' datatype='real' default-format='p0.00%' name='[Calculation_3509218934790664192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_transactions_local_shops_month])/ sum([total_sessions_localshops_month])' />
