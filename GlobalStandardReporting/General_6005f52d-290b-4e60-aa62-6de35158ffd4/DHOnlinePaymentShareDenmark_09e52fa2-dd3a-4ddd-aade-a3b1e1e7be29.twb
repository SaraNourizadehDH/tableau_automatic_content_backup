            </column>
            <column caption='Nb Orders - Dynamic_Label' datatype='real' name='[GMV Eur - Dynamic (copy)_4646096380277075972]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([nb_orders]) &gt;= POWER(10,9) THEN SUM([nb_orders]) / POWER(10,9)&#10;ELSEIF SUM([nb_orders]) &gt;= POWER(10,6) THEN SUM([nb_orders]) / POWER(10,6)&#10;ELSEIF SUM([nb_orders]) &gt;= POWER(10,3) THEN SUM([nb_orders]) / POWER(10,3)&#10;ELSE SUM([nb_orders])&#10;END' />
            </column>
            <column caption='OP Orders - Dynamic_Suffix' datatype='string' name='[Nb Orders - Dynamic_Suffix (copy)_4646096380277968903]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([OP_orders]) &gt;= POWER(10,9) THEN &apos;B&apos;&#10;ELSEIF SUM([OP_orders]) &gt;= POWER(10,6) THEN &apos;M&apos;&#10;ELSEIF SUM([OP_orders]) &gt;= POWER(10,3) THEN &apos;K&apos;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
