      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0o0238r08z5sda14sbxuk0szfsrf].[pcto:sum:nb_orders:qk]&quot;' value='% share orders selection' />
          <alias key='&quot;[federated.0o0238r08z5sda14sbxuk0szfsrf].[usr:Calculation_1849220265700880384:qk]&quot;' value='AOV' />
          <alias key='&quot;[federated.0o0238r08z5sda14sbxuk0szfsrf].[usr:Calculation_2243918552081534977:qk:5]&quot;' value='% share orders overall' />
        </aliases>
      </column>
      <column caption='OP AOV' datatype='real' name='[AOV total (copy)_1849220265701052417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([OP_gmv_eur])/sum([OP_orders])' />
      </column>
      <column caption='% share orders selected' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nb_orders]) / TOTAL(SUM([nb_orders]))'>
          <table-calc ordering-field='[federated.0o0238r08z5sda14sbxuk0szfsrf].[none:payment_payment_method:nk]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='label_Multiple currencies' datatype='string' name='[Calculation_1448822132480606208]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF(COUNTD([currency_code])&gt;1,&apos;* multiple currencies&apos;,NULL)' />
      </column>
      <column caption='AOV total' datatype='real' name='[Calculation_1849220265700880384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gmv_eur])/sum([nb_orders])' />
      </column>
      <column caption='Timeframe selection' datatype='string' name='[Calculation_1849220265702256642]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    [Parameters].[Parameter 1] = 1 THEN str([order_date])&#10;ELSEIF &#10;    [Parameters].[Parameter 1] = 2 THEN [week]&#10;ELSEIF &#10;    [Parameters].[Parameter 1] = 3 THEN [month]&#10;ELSEIF &#10;    [Parameters].[Parameter 1] = 4 THEN DATENAME(&apos;year&apos;,[order_date])+&apos;-&apos;+&apos;Q&apos;+DATENAME(&apos;quarter&apos;, [order_date])&#10;END' />
      </column>
      <column caption='% share orders overall' datatype='real' name='[Calculation_2243918552081534977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nb_orders]) / sum({fixed [country_country], [Calculation_1849220265702256642], [is_sent]: sum([nb_orders])})' />
      </column>
      <column caption='Metric selected' datatype='real' name='[Calculation_2362138073193086976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN 1 THEN SUM([gmv_eur])&#10;WHEN 2 THEN SUM([nb_orders])&#10;ELSE Null&#10;END' />
      </column>
      <column caption='Payment Methods grouped' datatype='string' name='[Calculation_3014597048913575937]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Timeframe (copy)]&#10;WHEN True Then [payment_payment_method]&#10;ELSE (&#10;IF [online_offline]=&apos;online&apos; THEN [payment_payment_method]&#10;    ELSE &apos;Offline PM&apos;&#10;    END&#10;)&#10;END' />
