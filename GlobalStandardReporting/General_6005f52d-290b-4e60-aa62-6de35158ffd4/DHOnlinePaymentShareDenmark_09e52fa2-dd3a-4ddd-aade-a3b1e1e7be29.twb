            </column>
            <column caption='GMV Eur - Dynamic_Label' datatype='real' name='[Calculation_4646096380274204672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([gmv_eur]) &gt;= POWER(10,9) THEN SUM([gmv_eur]) / POWER(10,9)&#10;ELSEIF SUM([gmv_eur]) &gt;= POWER(10,6) THEN SUM([gmv_eur]) / POWER(10,6)&#10;ELSEIF SUM([gmv_eur]) &gt;= POWER(10,3) THEN SUM([gmv_eur]) / POWER(10,3)&#10;ELSE SUM([gmv_eur])&#10;END' />
