      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Book'>OP share by PM - </run>
            <run bold='true' fontname='Tableau Book'>trendline</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='op_share (rl_fintech)' name='federated.0o0238r08z5sda14sbxuk0szfsrf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Timeframe' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='Daily' />
                <alias key='2' value='Weekly' />
                <alias key='3' value='Monthly' />
                <alias key='4' value='Quarterly' />
              </aliases>
            </column>
            <column alias='Stacked' caption='Chart type' datatype='integer' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Stacked' />
                <alias key='2' value='Line' />
              </aliases>
            </column>
            <column alias='GMV €' caption='Metric selection' datatype='integer' name='[Parameter 4]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='GMV €' />
                <alias key='2' value='Orders' />
              </aliases>
            </column>
            <column alias='Grouped into &quot;Offline PM&quot;' caption='Offline payments methods' datatype='boolean' name='[Timeframe (copy)]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
              <aliases>
                <alias key='false' value='Grouped into &quot;Offline PM&quot;' />
                <alias key='true' value='Not grouped' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0o0238r08z5sda14sbxuk0szfsrf'>
            <column caption='label_Multiple currencies' datatype='string' name='[Calculation_1448822132480606208]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF(COUNTD([currency_code])&gt;1,&apos;* multiple currencies&apos;,NULL)' />
            </column>
            <column caption='Timeframe selection' datatype='string' name='[Calculation_1849220265702256642]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    [Parameters].[Parameter 1] = 1 THEN str([order_date])&#10;ELSEIF &#10;    [Parameters].[Parameter 1] = 2 THEN [week]&#10;ELSEIF &#10;    [Parameters].[Parameter 1] = 3 THEN [month]&#10;ELSEIF &#10;    [Parameters].[Parameter 1] = 4 THEN DATENAME(&apos;year&apos;,[order_date])+&apos;-&apos;+&apos;Q&apos;+DATENAME(&apos;quarter&apos;, [order_date])&#10;END' />
            </column>
            <column caption='Metric selected' datatype='real' name='[Calculation_2362138073193086976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN 1 THEN SUM([gmv_eur])&#10;WHEN 2 THEN SUM([nb_orders])&#10;ELSE Null&#10;END' />
            </column>
            <column caption='Payment Methods grouped' datatype='string' name='[Calculation_3014597048913575937]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Timeframe (copy)]&#10;WHEN True Then [payment_payment_method]&#10;ELSE (&#10;IF [online_offline]=&apos;online&apos; THEN [payment_payment_method]&#10;    ELSE &apos;Offline PM&apos;&#10;    END&#10;)&#10;END' />
            </column>
            <column caption='Payment Methods - Top Grouped' datatype='string' name='[Calculation_3671700387079028736]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Payment Methods grouped Set] THEN [Calculation_3014597048913575937]&#10;ELSE &quot;Other grouped&quot;&#10;END' />
            </column>
            <column caption='Chart type filter' datatype='integer' name='[Calculation_5308336649435078656]' role='dimension' type='ordinal'>
