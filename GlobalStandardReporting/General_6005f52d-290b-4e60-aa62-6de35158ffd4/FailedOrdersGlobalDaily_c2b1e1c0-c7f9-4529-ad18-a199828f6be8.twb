        <calculation class='tableau' formula='IF [order_date] == [Parameters].[Parameter 1] THEN &quot;CHOSEN DAY&quot;&#10;ELSEIF [order_date] == DATEADD(&apos;day&apos;, -1, [Parameters].[Parameter 1]) THEN &quot;PREVIOUS DAY&quot;&#10;ELSEIF [order_date] == DATEADD(&apos;day&apos;, -7, [Parameters].[Parameter 1]) THEN &quot;PREVIOUS WEEK&quot;&#10;ELSE &quot;OTHER&quot;&#10;END' />
      </column>
      <column caption='failed_share' datatype='real' name='[Calculation_564146282088828929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_failed_order])/SUM([count_grouped_orders])' />
      </column>
      <column caption='failed_payment_share' datatype='real' name='[Calculation_564146282088951810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_failed_payment_order])/SUM([count_grouped_orders])' />
      </column>
      <column caption='failed_hard_share' datatype='real' name='[Calculation_564146282089058307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_hard_failed_order])/SUM([count_grouped_orders])' />
      </column>
      <column caption='success_share' datatype='real' name='[Calculation_564146282089168900]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_success_order])/SUM([count_grouped_orders])' />
      </column>
      <column caption='filter_kpi' datatype='real' name='[Calculation_564146282090967045]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Failed Share&quot; THEN [Calculation_564146282088828929]&#10;WHEN &quot;Failed Payment Share&quot; THEN [Calculation_564146282088951810]&#10;WHEN &quot;Failed Hard Share&quot; THEN [Calculation_564146282089058307]&#10;WHEN &quot;Success Share&quot; THEN [Calculation_564146282089168900]&#10;WHEN &quot;Count Failed&quot; THEN SUM([count_failed_order])&#10;WHEN &quot;Count Failed Payment&quot; THEN SUM([count_failed_payment_order])&#10;WHEN &quot;Count Failed Hard&quot; THEN SUM([count_hard_failed_order])&#10;WHEN &quot;Count Success&quot; THEN SUM([count_success_order])&#10;WHEN &quot;Count All Orders&quot; THEN SUM([count_grouped_orders])&#10;END' />
      </column>
      <column caption='order date (rel.)' datatype='date' name='[Calculation_564146282114093063]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[order_date]' />
      </column>
      <column caption='latest_date' datatype='date' name='[Calculation_613545146530734080]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED: MAX([order_date])}' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Migrated Data' datatype='table' name='[__tableau_internal_object_id__].[Migrated Data]' role='measure' type='quantitative' />
      <column datatype='string' name='[country_brand]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Country' datatype='string' name='[country_country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' name='[country_segment]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='filter_kpi_string' datatype='string' name='[filter_kpi (copy)_564146282093543430]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Failed Share&quot; THEN STR(ROUND([Calculation_564146282088828929]*100,2)) + &apos;%&apos;&#10;WHEN &quot;Failed Payment Share&quot; THEN STR(ROUND([Calculation_564146282088951810]*100,2)) + &apos;%&apos;&#10;WHEN &quot;Failed Hard Share&quot; THEN STR(ROUND([Calculation_564146282089058307]*100,2)) + &apos;%&apos;&#10;WHEN &quot;Success Share&quot; THEN STR(ROUND([Calculation_564146282089168900]*100,2)) + &apos;%&apos;&#10;&#10;WHEN &quot;Count Failed&quot; THEN IF SUM([count_failed_order])&gt;=1000000000 THEN STR(ROUND(SUM([count_failed_order]/1000000000),1)) + &apos;B&apos; &#10;    ELSEIF SUM([count_failed_order])&gt;=1000000 THEN STR(ROUND(SUM([count_failed_order]/1000000),1)) + &apos;M&apos; &#10;    ELSEIF SUM([count_failed_order])&gt;=1000 THEN STR(ROUND(SUM([count_failed_order]/1000),1)) + &apos;K&apos; &#10;    ELSE STR(ROUND(SUM([count_failed_order]),0)) END&#10;&#10;WHEN &quot;Count Failed Payment&quot; THEN IF SUM([count_failed_payment_order])&gt;=1000000000 THEN STR(ROUND(SUM([count_failed_payment_order]/1000000000),1)) + &apos;B&apos; &#10;    ELSEIF SUM([count_failed_payment_order])&gt;=1000000 THEN STR(ROUND(SUM([count_failed_payment_order]/1000000),1)) + &apos;M&apos; &#10;    ELSEIF SUM([count_failed_payment_order])&gt;=1000 THEN STR(ROUND(SUM([count_failed_payment_order]/1000),1)) + &apos;K&apos; &#10;    ELSE STR(ROUND(SUM([count_failed_payment_order]),0)) END&#10;&#10;WHEN &quot;Count Failed Hard&quot; THEN IF SUM([count_hard_failed_order])&gt;=1000000000 THEN STR(ROUND(SUM([count_hard_failed_order]/1000000000),1)) + &apos;B&apos; &#10;    ELSEIF SUM([count_hard_failed_order])&gt;=1000000 THEN STR(ROUND(SUM([count_hard_failed_order]/1000000),1)) + &apos;M&apos; &#10;    ELSEIF SUM([count_hard_failed_order])&gt;=1000 THEN STR(ROUND(SUM([count_hard_failed_order]/1000),1)) + &apos;K&apos; &#10;    ELSE STR(ROUND(SUM([count_hard_failed_order]),0)) END&#10;&#10;WHEN &quot;Count Success&quot; THEN IF SUM([count_success_order])&gt;=1000000000 THEN STR(ROUND(SUM([count_success_order]/1000000000),1)) + &apos;B&apos; &#10;    ELSEIF SUM([count_success_order])&gt;=1000000 THEN STR(ROUND(SUM([count_success_order]/1000000),1)) + &apos;M&apos; &#10;    ELSEIF SUM([count_success_order])&gt;=1000 THEN STR(ROUND(SUM([count_success_order]/1000),1)) + &apos;K&apos; &#10;    ELSE STR(ROUND(SUM([count_success_order]),0)) END&#10;&#10;WHEN &quot;Count All Orders&quot; THEN IF SUM([count_grouped_orders])&gt;=1000000000 THEN STR(ROUND(SUM([count_grouped_orders]/1000000000),1)) + &apos;B&apos; &#10;    ELSEIF SUM([count_grouped_orders])&gt;=1000000 THEN STR(ROUND(SUM([count_grouped_orders]/1000000),1)) + &apos;M&apos; &#10;    ELSEIF SUM([count_grouped_orders])&gt;=1000 THEN STR(ROUND(SUM([count_grouped_orders]/1000),1)) + &apos;K&apos; &#10;    ELSE STR(ROUND(SUM([count_grouped_orders]),0)) END&#10;END' />
      </column>
