            <datasource caption='lb_failed_orders_dashboard (il_reporting.lb_failed_orders_dashboard)' name='federated.0pt7epl039xaq4178813p1jlh4q5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0pt7epl039xaq4178813p1jlh4q5].[Calculation_613545146530734080]' _.fcp.ParameterDefaultValues.true...source-field='[federated.0pt7epl039xaq4178813p1jlh4q5].[Calculation_613545146530734080]' caption='Select a day' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2021-12-13#'>
              <calculation class='tableau' formula='#2021-12-13#' />
            </column>
            <column caption='Select a KPI' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Failed Payment Share&quot;'>
              <calculation class='tableau' formula='&quot;Failed Payment Share&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0pt7epl039xaq4178813p1jlh4q5'>
            <column caption='Day_in_words' datatype='string' name='[Calculation_564146282084884480]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [order_date] == [Parameters].[Parameter 1] THEN &quot;CHOSEN DAY&quot;&#10;ELSEIF [order_date] == DATEADD(&apos;day&apos;, -1, [Parameters].[Parameter 1]) THEN &quot;PREVIOUS DAY&quot;&#10;ELSEIF [order_date] == DATEADD(&apos;day&apos;, -7, [Parameters].[Parameter 1]) THEN &quot;PREVIOUS WEEK&quot;&#10;ELSE &quot;OTHER&quot;&#10;END' />
            </column>
            <column caption='failed_share' datatype='real' name='[Calculation_564146282088828929]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_failed_order])/SUM([count_grouped_orders])' />
            </column>
            <column caption='failed_payment_share' datatype='real' name='[Calculation_564146282088951810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_failed_payment_order])/SUM([count_grouped_orders])' />
            </column>
            <column caption='failed_hard_share' datatype='real' name='[Calculation_564146282089058307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_hard_failed_order])/SUM([count_grouped_orders])' />
            </column>
            <column caption='success_share' datatype='real' name='[Calculation_564146282089168900]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_success_order])/SUM([count_grouped_orders])' />
            </column>
            <column caption='filter_kpi' datatype='real' name='[Calculation_564146282090967045]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Failed Share&quot; THEN [Calculation_564146282088828929]&#10;WHEN &quot;Failed Payment Share&quot; THEN [Calculation_564146282088951810]&#10;WHEN &quot;Failed Hard Share&quot; THEN [Calculation_564146282089058307]&#10;WHEN &quot;Success Share&quot; THEN [Calculation_564146282089168900]&#10;WHEN &quot;Count Failed&quot; THEN SUM([count_failed_order])&#10;WHEN &quot;Count Failed Payment&quot; THEN SUM([count_failed_payment_order])&#10;WHEN &quot;Count Failed Hard&quot; THEN SUM([count_hard_failed_order])&#10;WHEN &quot;Count Success&quot; THEN SUM([count_success_order])&#10;WHEN &quot;Count All Orders&quot; THEN SUM([count_grouped_orders])&#10;END' />
            </column>
            <column caption='latest_date' datatype='date' name='[Calculation_613545146530734080]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED: MAX([order_date])}' />
