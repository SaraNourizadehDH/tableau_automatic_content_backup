            <column datatype='string' name='[country_segment]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='filter_kpi_string' datatype='string' name='[filter_kpi (copy)_564146282093543430]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Failed Share&quot; THEN STR(ROUND([Calculation_564146282088828929]*100,2)) + &apos;%&apos;&#10;WHEN &quot;Failed Payment Share&quot; THEN STR(ROUND([Calculation_564146282088951810]*100,2)) + &apos;%&apos;&#10;WHEN &quot;Failed Hard Share&quot; THEN STR(ROUND([Calculation_564146282089058307]*100,2)) + &apos;%&apos;&#10;WHEN &quot;Success Share&quot; THEN STR(ROUND([Calculation_564146282089168900]*100,2)) + &apos;%&apos;&#10;&#10;WHEN &quot;Count Failed&quot; THEN IF SUM([count_failed_order])&gt;=1000000000 THEN STR(ROUND(SUM([count_failed_order]/1000000000),1)) + &apos;B&apos; &#10;    ELSEIF SUM([count_failed_order])&gt;=1000000 THEN STR(ROUND(SUM([count_failed_order]/1000000),1)) + &apos;M&apos; &#10;    ELSEIF SUM([count_failed_order])&gt;=1000 THEN STR(ROUND(SUM([count_failed_order]/1000),1)) + &apos;K&apos; &#10;    ELSE STR(ROUND(SUM([count_failed_order]),0)) END&#10;&#10;WHEN &quot;Count Failed Payment&quot; THEN IF SUM([count_failed_payment_order])&gt;=1000000000 THEN STR(ROUND(SUM([count_failed_payment_order]/1000000000),1)) + &apos;B&apos; &#10;    ELSEIF SUM([count_failed_payment_order])&gt;=1000000 THEN STR(ROUND(SUM([count_failed_payment_order]/1000000),1)) + &apos;M&apos; &#10;    ELSEIF SUM([count_failed_payment_order])&gt;=1000 THEN STR(ROUND(SUM([count_failed_payment_order]/1000),1)) + &apos;K&apos; &#10;    ELSE STR(ROUND(SUM([count_failed_payment_order]),0)) END&#10;&#10;WHEN &quot;Count Failed Hard&quot; THEN IF SUM([count_hard_failed_order])&gt;=1000000000 THEN STR(ROUND(SUM([count_hard_failed_order]/1000000000),1)) + &apos;B&apos; &#10;    ELSEIF SUM([count_hard_failed_order])&gt;=1000000 THEN STR(ROUND(SUM([count_hard_failed_order]/1000000),1)) + &apos;M&apos; &#10;    ELSEIF SUM([count_hard_failed_order])&gt;=1000 THEN STR(ROUND(SUM([count_hard_failed_order]/1000),1)) + &apos;K&apos; &#10;    ELSE STR(ROUND(SUM([count_hard_failed_order]),0)) END&#10;&#10;WHEN &quot;Count Success&quot; THEN IF SUM([count_success_order])&gt;=1000000000 THEN STR(ROUND(SUM([count_success_order]/1000000000),1)) + &apos;B&apos; &#10;    ELSEIF SUM([count_success_order])&gt;=1000000 THEN STR(ROUND(SUM([count_success_order]/1000000),1)) + &apos;M&apos; &#10;    ELSEIF SUM([count_success_order])&gt;=1000 THEN STR(ROUND(SUM([count_success_order]/1000),1)) + &apos;K&apos; &#10;    ELSE STR(ROUND(SUM([count_success_order]),0)) END&#10;&#10;WHEN &quot;Count All Orders&quot; THEN IF SUM([count_grouped_orders])&gt;=1000000000 THEN STR(ROUND(SUM([count_grouped_orders]/1000000000),1)) + &apos;B&apos; &#10;    ELSEIF SUM([count_grouped_orders])&gt;=1000000 THEN STR(ROUND(SUM([count_grouped_orders]/1000000),1)) + &apos;M&apos; &#10;    ELSEIF SUM([count_grouped_orders])&gt;=1000 THEN STR(ROUND(SUM([count_grouped_orders]/1000),1)) + &apos;K&apos; &#10;    ELSE STR(ROUND(SUM([count_grouped_orders]),0)) END&#10;END' />
            </column>
