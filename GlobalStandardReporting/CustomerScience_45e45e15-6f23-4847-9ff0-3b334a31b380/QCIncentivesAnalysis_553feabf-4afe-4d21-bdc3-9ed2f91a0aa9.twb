              <calculation class='tableau' formula='CASE [Parameters].[# Count Metrics (copy)_5754263331495493634]&#10;WHEN &apos;Total GBV Eur&apos; THEN SUM([amt_gbv_eur])&#10;WHEN &apos;Total GMV Eur&apos; THEN SUM([amt_gmv_eur])&#10;WHEN &apos;% Share of Total GMV&apos; THEN (SUM([amt_gmv_eur]) / SUM([Calculation_5372020316030652416]) * 100)&#10;WHEN &apos;Avg Basket Value&apos; THEN SUM([amt_gmv_eur]) / SUM([orders])&#10;WHEN &apos;Total Profit Eur&apos; THEN SUM([amt_profit_eur])&#10;WHEN &apos;Total Voucher Eur&apos; &#10;    THEN SUM([amt_voucher_dh_eur]) + SUM([amt_voucher_other_eur])&#10;WHEN &apos;Total Discount Eur&apos; &#10;    THEN SUM([amt_discount_dh_eur]) + SUM([amt_discount_other_eur])&#10;WHEN &apos;Total Incentives Eur&apos; &#10;    THEN SUM([amt_discount_dh_eur]) + SUM([amt_discount_other_eur])&#10;   + SUM([amt_voucher_dh_eur]) + SUM([amt_voucher_other_eur])&#10;WHEN &apos;Total Item Level Incentives Eur&apos; &#10;    THEN SUM([total_item_discount])&#10;WHEN &apos;DH Item Level Incentives Eur&apos; &#10;    THEN SUM([dh_funded_item_discount])&#10;WHEN &apos;Vendor Item Level Incentives Eur&apos; &#10;    THEN SUM([total_supplier_item_discount])&#10;WHEN &apos;Total Incentives Share of GMV&apos; &#10;    THEN (SUM([amt_voucher_dh_eur]) + SUM([amt_voucher_other_eur]) &#10;        + SUM([amt_discount_dh_eur]) + SUM([amt_discount_other_eur]))*100 / SUM([amt_gmv_eur])&#10;WHEN &apos;DH Share of Incentives of GMV&apos; &#10;    THEN (SUM([amt_voucher_dh_eur]) + SUM([amt_discount_dh_eur]))*100 / SUM([amt_gmv_eur])&#10;WHEN &apos;Vendor Share of Incentives of GMV&apos; &#10;    THEN (SUM([amt_voucher_other_eur]) + SUM([amt_discount_other_eur]))*100 / SUM([amt_gmv_eur])&#10;WHEN &apos;Total Item Level Incentives Share of GMV&apos; &#10;    THEN SUM([total_item_discount])*100 / SUM([amt_gmv_eur])&#10;WHEN &apos;DH Share of Item Level Incentives of GMV&apos; &#10;    THEN SUM([dh_funded_item_discount])*100 / SUM([amt_gmv_eur])&#10;WHEN &apos;Vendor Share of Item Level Incentives of GMV&apos; &#10;    THEN SUM([total_supplier_item_discount])*100 / SUM([amt_gmv_eur])&#10;&#10;WHEN &apos;GMV from the Orders with DH Item Level Incentives&apos;&#10;    THEN SUM([amt_gmv_eur_orders_w_dh_item_level_incentives])&#10;WHEN &apos;GMV from the Orders with DH Item Level Incentives Share of Total GMV&apos;&#10;    THEN SUM([amt_gmv_eur_orders_w_dh_item_level_incentives])*100 / SUM([Calculation_5372020316030652416])&#10;WHEN &apos;Profit Per GMV&apos;&#10;    THEN [Calculation_4164774138627301379]*100&#10;WHEN &apos;Profit Per Total GMV&apos;&#10;    THEN (SUM([amt_profit_eur]) / SUM([Calculation_5372020316030652416]))*100&#10;WHEN &apos;Profit Share of DH Item Level Incentives of Total Profit&apos;&#10;    THEN [Calculation_6595169827874852867]&#10;WHEN &apos;DH Incentives Per Order&apos; &#10;    THEN (SUM([amt_voucher_dh_eur]) + SUM([amt_discount_dh_eur])) / SUM([orders])&#10;WHEN &apos;DH Item Level Incentives Per Order&apos; &#10;    THEN SUM([dh_funded_item_discount]) / SUM([orders])&#10;WHEN &apos;DH Incentives Per Customer&apos; &#10;    THEN (SUM([amt_voucher_dh_eur]) + SUM([amt_discount_dh_eur])) / SUM([customers])&#10;WHEN &apos;DH Item Level Incentives Per Customer&apos; &#10;    THEN SUM([dh_funded_item_discount]) / SUM([customers])&#10;&#10;WHEN &apos;Incremental Profit&apos;&#10;    THEN [Calculation_6595169827875753989]&#10;END' />
            </column>
            <column caption='Profit Per GMV' datatype='real' name='[Calculation_4164774138627301379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_profit_eur])/SUM([amt_gmv_eur])' />
            </column>
            <column caption='Total GMV' datatype='real' name='[Calculation_5372020316030652416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [store_type] : SUM([amt_gmv_eur]) }' />
            </column>
            <column aggregation='Sum' caption='Unhealthy Customers Score' datatype='real' name='[Calculation_5754263331538030605]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[ucm_bin]' />
