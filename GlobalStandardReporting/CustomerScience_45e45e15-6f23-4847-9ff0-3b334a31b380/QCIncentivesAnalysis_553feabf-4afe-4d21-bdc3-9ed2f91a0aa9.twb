      <column caption='# Count Metrics Filter' datatype='real' name='[Calculation_5754263331491053569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Customers&apos; THEN SUM([customers])&#10;WHEN &apos;Orders&apos; THEN SUM([orders])&#10;WHEN &apos;Orders with Incentives&apos; THEN SUM([orders_w_dh_incentives]) + SUM([orders_w_other_incentives])&#10;WHEN &apos;Orders with DH Incentives&apos; THEN SUM([orders_w_dh_incentives])&#10;WHEN &apos;Orders with Vendor Incentives&apos; THEN SUM([orders_w_other_incentives])&#10;WHEN &apos;Orders with Item Level Incentives&apos; THEN SUM([orders_w_overall_item_level_incentives])&#10;WHEN &apos;Orders with DH Item Level Incentives&apos; THEN SUM([orders_w_dh_item_level_incentives])&#10;WHEN &apos;Orders with Vendor Item Level Incentives&apos; THEN SUM([orders_w_supplier_item_level_incentives])&#10;WHEN &apos;% of Orders with DH Incentives&apos; THEN [Calculation_5754263331519262723]*100&#10;WHEN &apos;Orders Per Customer&apos; THEN [Calculation_3271372562244526080]&#10;WHEN &apos;DH Incentive Orders Per Customer&apos; THEN [Orders Per Customer (copy)_4164774138625368064]&#10;WHEN &apos;DH Item Level Incentive Orders Per Customer&apos; THEN [DH Incentive Orders Per Customer (copy)_4164774138625495042]&#10;&#10;END' />
      </column>
      <column caption='% of Orders with DH Incentives' datatype='real' name='[Calculation_5754263331519262723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_w_dh_incentives])/SUM([orders])' />
