      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='qc_orders_item_level_discounts (test_sashank)' name='federated.0gl8o7l0l1v7dk10mzhqa1b6o211' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Efficiency Metrics' datatype='string' name='[$ Revenue Metrics (copy)_1496532100584579076]' param-domain-type='list' role='measure' type='nominal' value='&quot;Profit Per Customer&quot;'>
              <calculation class='tableau' formula='&quot;Profit Per Customer&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gl8o7l0l1v7dk10mzhqa1b6o211'>
            <column caption='$ Efficiency Metrics' datatype='real' name='[$ Revenue Metrics Filter (copy)_1496532100585050117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[$ Revenue Metrics (copy)_1496532100584579076]&#10;WHEN &apos;% Share of Customers&apos; THEN SUM([customers]) / SUM([Calculation_1619677402911145984]) * 100&#10;WHEN &apos;% Share of Total GMV&apos; THEN (SUM([amt_gmv_eur]) / SUM([Calculation_5372020316030652416]) * 100)&#10;WHEN &apos;Avg Basket Value&apos; THEN SUM([amt_gmv_eur]) / SUM([orders])&#10;WHEN &apos;Total Profit Eur&apos; THEN SUM([amt_profit_eur])&#10;WHEN &apos;Profit Per Customer&apos; THEN [Profit Per Order (copy)_1425600409891192845]&#10;WHEN &apos;Profit Per Order&apos; THEN [Profit Per GMV (copy)_1496532100584210434]&#10;WHEN &apos;Profit Per DH Item Level Order&apos; THEN [Profit Per Order (copy)_1496532100584398851]&#10;WHEN &apos;DH Item Level Incentives Orders as a Share of Total Orders&apos;&#10;THEN [% of Orders with Vendor Item Level Incentives (copy)_6595169827853430786]&#10;WHEN &apos;DH Item Level Incentive Efficiency&apos; THEN [Calculation_1496532100565893120]&#10;WHEN &apos;DH Item Level Incentives Per Customer&apos; &#10;    THEN SUM([dh_funded_item_discount]) / SUM([customers])&#10;WHEN &apos;Profit Share of DH Item Level Incentives of Total Profit&apos;&#10;    THEN [Calculation_6595169827874852867]*100&#10;WHEN &apos;GMV Share of DH Item Level Incentives of Total GMV&apos;&#10;    THEN (SUM([amt_gmv_eur_orders_w_dh_item_level_incentives]) / SUM([Calculation_5372020316030652416]))*100&#10;WHEN &apos;Profit Per GMV&apos; THEN [Calculation_4164774138627301379]*100&#10;WHEN &apos;Incremental Profit&apos;&#10;    THEN [Calculation_6595169827875753989]&#10;WHEN &apos;DH Incentives Orders Per Customer&apos; THEN [Orders Per Customer (copy)_4164774138625368064]&#10;END' />
            </column>
            <column caption='DH Item Level Incentives Orders as a Share of Total Orders' datatype='real' name='[% of Orders with Vendor Item Level Incentives (copy)_6595169827853430786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_w_dh_item_level_incentives])/SUM([Orders (copy)_6595169827852996609])' />
            </column>
            <column caption='DH Item Level Incentive Efficiency' datatype='real' name='[Calculation_1496532100565893120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dh_funded_item_discount])*100 / SUM([Calculation_5372020316030652416])' />
            </column>
            <column caption='Total Customers' datatype='integer' name='[Calculation_1619677402911145984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [store_type] : SUM([customers]) }' />
            </column>
            <column caption='Profit Per GMV' datatype='real' name='[Calculation_4164774138627301379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_profit_eur])/SUM([amt_gmv_eur])' />
            </column>
            <column caption='Total GMV' datatype='real' name='[Calculation_5372020316030652416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [store_type] : SUM([amt_gmv_eur]) }' />
            </column>
            <column aggregation='Sum' caption='Unhealthy Customers Score' datatype='real' name='[Calculation_5754263331538030605]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[ucm_bin]' />
            </column>
            <column aggregation='Sum' caption='QC Reorder Probability' datatype='real' name='[Calculation_5754263331538288654]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[qc_rp_bin]' />
            </column>
            <column caption='Profit Share of DH Item Level Incentives of Total Profit' datatype='real' name='[Calculation_6595169827874852867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_profit_eur_orders_w_dh_item_level_incentives]) / SUM([Calculation_6595169827875520516])' />
            </column>
            <column caption='Total Profit' datatype='real' name='[Calculation_6595169827875520516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : SUM([amt_profit_eur]) }' />
            </column>
            <column caption='Incremental Profit' datatype='real' name='[Calculation_6595169827875753989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([amt_profit_eur]) - SUM([amt_profit_eur_orders_w_dh_item_level_incentives]))' />
            </column>
            <column caption='Total Orders' datatype='integer' name='[Orders (copy)_6595169827852996609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : SUM([orders])}' />
            </column>
            <column caption='DH Incentive Orders Per Customer' datatype='real' name='[Orders Per Customer (copy)_4164774138625368064]' role='measure' type='quantitative'>
