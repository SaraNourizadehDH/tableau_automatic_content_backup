    <worksheet name='[Segment] # Counts Metrics'>
      <layout-options>
        <title>
          <formatted-text>
            <run># Count Metric - &lt;</run>
            <run>[Parameters].[Parameter 1]</run>
            <run>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='qc_orders_item_level_discounts (test_sashank)' name='federated.0gl8o7l0l1v7dk10mzhqa1b6o211' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='# Count Metrics' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Customers&quot;'>
              <calculation class='tableau' formula='&quot;Customers&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gl8o7l0l1v7dk10mzhqa1b6o211'>
            <column caption='Orders Per Customer' datatype='real' name='[Calculation_3271372562244526080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM([customers])' />
            </column>
            <column caption='# Count Metrics Filter' datatype='real' name='[Calculation_5754263331491053569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Customers&apos; THEN SUM([customers])&#10;WHEN &apos;Orders&apos; THEN SUM([orders])&#10;WHEN &apos;Orders with Incentives&apos; THEN SUM([orders_w_dh_incentives]) + SUM([orders_w_other_incentives])&#10;WHEN &apos;Orders with DH Incentives&apos; THEN SUM([orders_w_dh_incentives])&#10;WHEN &apos;Orders with Vendor Incentives&apos; THEN SUM([orders_w_other_incentives])&#10;WHEN &apos;Orders with Item Level Incentives&apos; THEN SUM([orders_w_overall_item_level_incentives])&#10;WHEN &apos;Orders with DH Item Level Incentives&apos; THEN SUM([orders_w_dh_item_level_incentives])&#10;WHEN &apos;Orders with Vendor Item Level Incentives&apos; THEN SUM([orders_w_supplier_item_level_incentives])&#10;WHEN &apos;% of Orders with DH Incentives&apos; THEN [Calculation_5754263331519262723]*100&#10;WHEN &apos;Orders Per Customer&apos; THEN [Calculation_3271372562244526080]&#10;WHEN &apos;DH Incentive Orders Per Customer&apos; THEN [Orders Per Customer (copy)_4164774138625368064]&#10;WHEN &apos;DH Item Level Incentive Orders Per Customer&apos; THEN [DH Incentive Orders Per Customer (copy)_4164774138625495042]&#10;&#10;END' />
            </column>
            <column caption='% of Orders with DH Incentives' datatype='real' name='[Calculation_5754263331519262723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_w_dh_incentives])/SUM([orders])' />
            </column>
            <column aggregation='Sum' caption='Unhealthy Customers Score' datatype='real' name='[Calculation_5754263331538030605]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[ucm_bin]' />
            </column>
            <column aggregation='Sum' caption='QC Reorder Probability' datatype='real' name='[Calculation_5754263331538288654]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[qc_rp_bin]' />
            </column>
            <column caption='DH Item Level Incentive Orders Per Customer' datatype='real' name='[DH Incentive Orders Per Customer (copy)_4164774138625495042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_w_dh_item_level_incentives])/SUM([customers])' />
            </column>
            <column caption='DH Incentive Orders Per Customer' datatype='real' name='[Orders Per Customer (copy)_4164774138625368064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_w_dh_incentives])/SUM([customers])' />
            </column>
            <column aggregation='None' caption='QC Reorder Probability (Low, Medium and High)' datatype='integer' name='[QC Reorder Probability (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='1' formula='[Calculation_5754263331538288654]' peg='0' size='20' />
