    <worksheet name='[UHC] Incentive Efficiency'>
      <layout-options>
        <title>
          <formatted-text>
            <run><![CDATA[<Sheet Name>

Efficiency Metric - <]]></run>
            <run>[Parameters].[$ Revenue Metrics (copy)_1496532100584579076]</run>
            <run>&gt;&#10;Revenue Metric - &lt;</run>
            <run>[Parameters].[# Count Metrics (copy)_5754263331495493634]</run>
            <run>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='qc_orders_uhc_scores_aggregate (test_sashank)' name='federated.11qkpxi13ygrnr1069g3i0gr0ihc' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='$ Revenue Metrics' datatype='string' name='[# Count Metrics (copy)_5754263331495493634]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total GMV Eur&quot;'>
              <calculation class='tableau' formula='&quot;Total GMV Eur&quot;' />
            </column>
            <column caption='Efficiency Metrics' datatype='string' name='[$ Revenue Metrics (copy)_1496532100584579076]' param-domain-type='list' role='measure' type='nominal' value='&quot;Profit Per Customer&quot;'>
              <calculation class='tableau' formula='&quot;Profit Per Customer&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.11qkpxi13ygrnr1069g3i0gr0ihc'>
            <column caption='$ Efficiency Metrics' datatype='real' name='[$ Revenue Metrics Filter (copy)_1496532100585050117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[$ Revenue Metrics (copy)_1496532100584579076]&#10;WHEN &apos;% Share of Customers&apos; THEN (SUM([customers]) / SUM([Calculation_1619677402911145984]) * 100)&#10;WHEN &apos;% Share of Total GMV&apos; THEN (SUM([amt_gmv_eur]) / SUM([Calculation_5372020316030652416]) * 100)&#10;WHEN &apos;Avg Basket Value&apos; THEN SUM([amt_gmv_eur]) / SUM([orders])&#10;WHEN &apos;DH Incentives Orders Per Customer&apos;&#10;THEN [Orders Per Customer (copy)_4164774138625368064]&#10;WHEN &apos;Total Profit Eur&apos; THEN SUM([amt_profit_eur])&#10;WHEN &apos;Profit Per Order&apos; THEN [Profit Per GMV (copy)_1496532100584210434]&#10;WHEN &apos;Profit Per DH Item Level Order&apos; THEN [Profit Per Order (copy)_1496532100584398851]&#10;WHEN &apos;DH Item Level Incentives Orders as a Share of Total Orders&apos;&#10;THEN [% of Orders with Vendor Item Level Incentives (copy)_6595169827853430786]&#10;WHEN &apos;DH Item Level Incentive Efficiency&apos; THEN [Calculation_1496532100565893120]&#10;WHEN &apos;DH Item Level Incentives Per Customer&apos; &#10;    THEN SUM([dh_funded_item_discount]) / SUM([customers])&#10;WHEN &apos;Profit Share of DH Item Level Incentives of Total Profit&apos;&#10;    THEN [Calculation_6595169827874852867]*100&#10;WHEN &apos;Profit Per GMV&apos; THEN [Calculation_4164774138627301379]*100&#10;WHEN &apos;Incremental Profit&apos;&#10;    THEN [Calculation_6595169827875753989]&#10;END' />
            </column>
            <column caption='$ Revenue Metrics Filter' datatype='real' name='[% Metrics Filter (copy)_5754263331521892358]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[# Count Metrics (copy)_5754263331495493634]&#10;WHEN &apos;Total GBV Eur&apos; THEN SUM([amt_gbv_eur])&#10;WHEN &apos;Total GMV Eur&apos; THEN SUM([amt_gmv_eur])&#10;WHEN &apos;% Share of Total GMV&apos; THEN (SUM([amt_gmv_eur]) / SUM([Calculation_5372020316030652416]) * 100)&#10;WHEN &apos;Avg Basket Value&apos; THEN SUM([amt_gmv_eur]) / SUM([orders])&#10;WHEN &apos;Total Profit Eur&apos; THEN SUM([amt_profit_eur])&#10;WHEN &apos;Total Voucher Eur&apos; &#10;    THEN SUM([amt_voucher_dh_eur]) + SUM([amt_voucher_other_eur])&#10;WHEN &apos;Total Discount Eur&apos; &#10;    THEN SUM([amt_discount_dh_eur]) + SUM([amt_discount_other_eur])&#10;WHEN &apos;Total Incentives Eur&apos; &#10;    THEN SUM([amt_discount_dh_eur]) + SUM([amt_discount_other_eur])&#10;   + SUM([amt_voucher_dh_eur]) + SUM([amt_voucher_other_eur])&#10;WHEN &apos;Total Item Level Incentives Eur&apos; &#10;    THEN SUM([total_item_discount])&#10;WHEN &apos;DH Item Level Incentives Eur&apos; &#10;    THEN SUM([dh_funded_item_discount])&#10;WHEN &apos;Vendor Item Level Incentives Eur&apos; &#10;    THEN SUM([total_supplier_item_discount])&#10;WHEN &apos;Total Incentives Share of GMV&apos; &#10;    THEN (SUM([amt_voucher_dh_eur]) + SUM([amt_voucher_other_eur]) &#10;        + SUM([amt_discount_dh_eur]) + SUM([amt_discount_other_eur]))*100 / SUM([amt_gmv_eur])&#10;WHEN &apos;DH Share of Incentives of GMV&apos; &#10;    THEN (SUM([amt_voucher_dh_eur]) + SUM([amt_discount_dh_eur]))*100 / SUM([amt_gmv_eur])&#10;WHEN &apos;Vendor Share of Incentives of GMV&apos; &#10;    THEN (SUM([amt_voucher_other_eur]) + SUM([amt_discount_other_eur]))*100 / SUM([amt_gmv_eur])&#10;WHEN &apos;Total Item Level Incentives Share of GMV&apos; &#10;    THEN SUM([total_item_discount])*100 / SUM([amt_gmv_eur])&#10;WHEN &apos;DH Share of Item Level Incentives of GMV&apos; &#10;    THEN SUM([dh_funded_item_discount])*100 / SUM([amt_gmv_eur])&#10;WHEN &apos;Vendor Share of Item Level Incentives of GMV&apos; &#10;    THEN SUM([total_supplier_item_discount])*100 / SUM([amt_gmv_eur])&#10;&#10;WHEN &apos;GMV from the Orders with DH Item Level Incentives&apos;&#10;    THEN SUM([amt_gmv_eur_orders_w_dh_item_level_incentives])&#10;WHEN &apos;GMV from the Orders with DH Item Level Incentives Share of Total GMV&apos;&#10;    THEN SUM([amt_gmv_eur_orders_w_dh_item_level_incentives])*100 / SUM([Calculation_5372020316030652416])&#10;WHEN &apos;Profit Per GMV&apos;&#10;    THEN [Calculation_4164774138627301379]*100&#10;WHEN &apos;Profit Per Total GMV&apos;&#10;    THEN (SUM([amt_profit_eur]) / SUM([Calculation_5372020316030652416]))*100&#10;WHEN &apos;Profit Share of DH Item Level Incentives of Total Profit&apos;&#10;    THEN [Calculation_6595169827874852867]&#10;WHEN &apos;DH Incentives Per Order&apos; &#10;    THEN (SUM([amt_voucher_dh_eur]) + SUM([amt_discount_dh_eur])) / SUM([orders])&#10;WHEN &apos;DH Item Level Incentives Per Order&apos; &#10;    THEN SUM([dh_funded_item_discount]) / SUM([orders])&#10;WHEN &apos;DH Incentives Per Customer&apos; &#10;    THEN (SUM([amt_voucher_dh_eur]) + SUM([amt_discount_dh_eur])) / SUM([customers])&#10;WHEN &apos;DH Item Level Incentives Per Customer&apos; &#10;    THEN SUM([dh_funded_item_discount]) / SUM([customers])&#10;&#10;WHEN &apos;Incremental Profit&apos;&#10;    THEN [Calculation_6595169827875753989]&#10;END' />
            </column>
            <column caption='DH Item Level Incentives Orders as a Share of Total Orders' datatype='real' name='[% of Orders with Vendor Item Level Incentives (copy)_6595169827853430786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_w_dh_item_level_incentives])/SUM([Orders (copy)_6595169827852996609])' />
            </column>
            <column caption='DH Item Level Incentive Efficiency' datatype='real' name='[Calculation_1496532100565893120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dh_funded_item_discount])*100 / SUM([amt_gmv_eur])' />
            </column>
            <column caption='Total Customers' datatype='integer' name='[Calculation_1619677402911145984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [store_type] : SUM([customers]) }' />
            </column>
            <column caption='Management Entity' datatype='string' name='[Calculation_1834442810326691840]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [global_entity_id] != &apos;PY_AR&apos; THEN &apos;Talabat&apos; ELSE &apos;PY_AR&apos; END' />
            </column>
            <column caption='Profit Per GMV' datatype='real' name='[Calculation_4164774138627301379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_profit_eur])/SUM([amt_gmv_eur])' />
            </column>
            <column caption='Total GMV' datatype='real' name='[Calculation_5372020316030652416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [store_type] : SUM([amt_gmv_eur]) }' />
            </column>
            <column caption='Minimum Customers Flag (&gt;100 Customers)' datatype='boolean' name='[Calculation_5372020316031909889]' role='measure' type='nominal'>
              <calculation class='tableau' formula='SUM([customers]) &gt; 100' />
            </column>
            <column caption='Profit Share of DH Item Level Incentives of Total Profit' datatype='real' name='[Calculation_6595169827874852867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_profit_eur_orders_w_dh_item_level_incentives]) / SUM([Calculation_6595169827875520516])' />
            </column>
            <column caption='Total Profit' datatype='real' name='[Calculation_6595169827875520516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [store_type] : SUM([amt_profit_eur]) }' />
            </column>
            <column caption='Incremental Profit' datatype='real' name='[Calculation_6595169827875753989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([amt_profit_eur]) - SUM([amt_gmv_eur_orders_w_dh_item_level_incentives]))' />
            </column>
            <column caption='Total Orders' datatype='integer' name='[Orders (copy)_6595169827852996609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : SUM([orders])}' />
            </column>
            <column caption='DH Incentive Orders Per Customer' datatype='real' name='[Orders Per Customer (copy)_4164774138625368064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_w_dh_incentives])/SUM([customers])' />
            </column>
            <column caption='Profit Per Order' datatype='real' name='[Profit Per GMV (copy)_1496532100584210434]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_profit_eur])/SUM([orders])' />
            </column>
            <column caption='Profit Per DH Item Level Order' datatype='real' name='[Profit Per Order (copy)_1496532100584398851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_profit_eur_orders_w_dh_item_level_incentives])/SUM([orders_w_dh_item_level_incentives])' />
            </column>
            <column caption='Amt Discount Dh Eur' datatype='real' name='[amt_discount_dh_eur]' role='measure' type='quantitative' />
            <column caption='Amt Discount Other Eur' datatype='real' name='[amt_discount_other_eur]' role='measure' type='quantitative' />
            <column caption='Amt Gbv Eur' datatype='real' name='[amt_gbv_eur]' role='measure' type='quantitative' />
            <column caption='Amt Gmv Eur' datatype='real' name='[amt_gmv_eur]' role='measure' type='quantitative' />
            <column caption='Amt Gmv Eur Orders W Dh Item Level Incentives' datatype='real' name='[amt_gmv_eur_orders_w_dh_item_level_incentives]' role='measure' type='quantitative' />
            <column caption='Amt Profit Eur' datatype='real' name='[amt_profit_eur]' role='measure' type='quantitative' />
            <column caption='Amt Profit Eur Orders W Dh Item Level Incentives' datatype='real' name='[amt_profit_eur_orders_w_dh_item_level_incentives]' role='measure' type='quantitative' />
            <column caption='Amt Voucher Dh Eur' datatype='real' name='[amt_voucher_dh_eur]' role='measure' type='quantitative' />
            <column caption='Amt Voucher Other Eur' datatype='real' name='[amt_voucher_other_eur]' role='measure' type='quantitative' />
