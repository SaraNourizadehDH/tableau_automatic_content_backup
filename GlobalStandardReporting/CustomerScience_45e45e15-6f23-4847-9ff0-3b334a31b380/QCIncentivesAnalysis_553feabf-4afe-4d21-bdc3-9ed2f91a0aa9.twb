            <column caption='Orders W Dh Item Level Incentives' datatype='integer' name='[orders_w_dh_item_level_incentives]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Qc Rp Bin' datatype='real' name='[qc_rp_bin]' role='dimension' type='ordinal' />
            <column caption='Store Type' datatype='string' name='[store_type]' role='dimension' type='nominal' />
            <column-instance column='[customers]' derivation='Sum' name='[sum:customers:qk]' pivot='key' type='quantitative' />
            <column caption='Total Item Discount' datatype='real' name='[total_item_discount]' role='measure' type='quantitative' />
            <column caption='Total Supplier Item Discount' datatype='real' name='[total_supplier_item_discount]' role='measure' type='quantitative' />
            <column-instance column='[$ Revenue Metrics Filter (copy)_1496532100585050117]' derivation='User' name='[usr:$ Revenue Metrics Filter (copy)_1496532100585050117:qk]' pivot='key' type='quantitative' />
            <column-instance column='[% Metrics Filter (copy)_5754263331521892358]' derivation='User' name='[usr:% Metrics Filter (copy)_5754263331521892358:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
