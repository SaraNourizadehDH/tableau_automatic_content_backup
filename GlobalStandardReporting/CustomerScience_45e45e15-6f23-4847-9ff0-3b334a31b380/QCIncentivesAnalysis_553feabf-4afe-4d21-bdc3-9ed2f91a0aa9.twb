            <column-instance column='[QC Reorder Probability (bin)]' derivation='None' name='[none:QC Reorder Probability (bin):ok]' pivot='key' type='ordinal' />
            <column-instance column='[Unhealthy Customers Score (bin)]' derivation='None' name='[none:Unhealthy Customers Score (bin):ok]' pivot='key' type='ordinal' />
