      <column caption='% Metrics Filter' datatype='real' name='[Metrics Filter (copy)_5754263331520966661]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[$ Revenue Metrics (copy)_5754263331519889412]&#10;WHEN &apos;% of Customers&apos; THEN SUM([customers]) / SUM([Calculation_1619677402911145984])&#10;WHEN &apos;% of Orders with Incentives&apos; THEN [% of Orders with Total Item Level Incentives (copy)_5754263331523067915]&#10;WHEN &apos;% of Orders with DH Incentives&apos; THEN [Calculation_5754263331519262723]&#10;WHEN &apos;% of Orders with Vendor Incentives&apos; THEN [% of Orders with Vendor Item Level Incentives (copy)_5754263331522650121]&#10;WHEN &apos;% of Orders with Total Item Level Incentives&apos; THEN [% of Orders with Vendor Incentives (copy)_5754263331522863114]&#10;WHEN &apos;% of Orders with DH Item Level Incentives&apos; THEN [% of Orders with DH Incentives (copy)_5754263331522486279]&#10;WHEN &apos;% of Orders with Vendor Item Level Incentives&apos; THEN [% of Orders with DH Item Level Incentives (copy)_5754263331522580488]&#10;WHEN &apos;DH Item Level Incentives Orders as a Share of Total Orders&apos; THEN [% of Orders with Vendor Item Level Incentives (copy)_6595169827853430786]&#10;WHEN &apos;% of DH Item Level Incentives Per Total Item Incentives&apos; THEN SUM([dh_funded_item_discount])/SUM([Total Customers (copy)_1425600409867579404])&#10;&#10;END' />
