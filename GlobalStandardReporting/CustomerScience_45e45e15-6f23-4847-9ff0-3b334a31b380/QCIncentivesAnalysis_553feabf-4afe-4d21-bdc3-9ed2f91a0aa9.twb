      <column caption='% of Orders with Incentives' datatype='real' name='[% of Orders with Total Item Level Incentives (copy)_5754263331523067915]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([orders_w_other_incentives]) + SUM([orders_w_dh_incentives]))/SUM([orders])' />
      </column>
      <column caption='% of Orders with Total Item Level Incentives' datatype='real' name='[% of Orders with Vendor Incentives (copy)_5754263331522863114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_w_overall_item_level_incentives])/SUM([orders])' />
