    <dashboard name='Summary'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/WalletTxnMonitoring/Summary?rev=' id='Summary' path='/t/GlobalStandardReporting/workbooks/WalletTxnMonitoring' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98000' id='3' param='horz' type-v2='layout-flow' w='98400' x='800' y='1000'>
            <zone forceUpdate='true' h='98000' id='5' type-v2='text' w='98400' x='800' y='1000'>
              <formatted-text>
                <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='12'>Purpose:</run>
                <run fontcolor='#000000' fontname='Segoe UI' fontsize='12'> Track wallet transaction limits for each subsidiary</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='12'>Filters:</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000' fontname='Segoe UI' fontsize='12'>There are 2 filters that you can use: </run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='12'>Report Date:</run>
                <run fontcolor='#000000' fontname='Segoe UI' fontsize='12'> Date on which limit report is generated</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='12'>Subsidiary: </run>
                <run fontcolor='#000000' fontname='Segoe UI' fontsize='12'>Users can choose a specific enity</run>
                <run>Æ&#10;&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='12'>Metrics:</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='12'>Limit Exceeded Customers : </run>
                <run fontcolor='#000000' fontname='Segoe UI' fontsize='12'>Unique customers whose transaction value is higher than AR$ 100.000 in last 30 days (with respect to report date) </run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#333333' fontname='Segoe UI' fontsize='12'>Limit Exceeded Transactions: </run>
                <run fontcolor='#333333' fontname='Segoe UI' fontsize='12'>Transactions which are responsible for crossing the the limit of </run>
                <run fontcolor='#000000' fontname='Segoe UI' fontsize='12'>AR$ 100.000 in last 30 days  (with respect to report date) </run>
                <run>Æ&#10;</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
