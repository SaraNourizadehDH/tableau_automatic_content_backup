      </column>
      <column caption='creation date' datatype='date' name='[Calculation_3154419720365543442]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [timeframe] = &apos;month&apos; THEN DATE( LEFT([creation_month],4) + &quot;-&quot; + RIGHT([creation_month],2) + &quot;-01&quot; )&#10;ELSEIF [timeframe] = &apos;quarter&apos; THEN DATE( LEFT([creation_month],4) + &quot;-&quot; + &quot;0&quot; + STR(INT(RIGHT([creation_month],2))*3-2) + &quot;-01&quot; )&#10;END' />
      </column>
      <column caption='is selected period' datatype='boolean' name='[Calculation_3154419720365785107]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [timeframe] = &apos;month&apos; then [Parameters].[Order Date Parameter]=[Calculation_3154419720365543442]&#10;elseif [timeframe] = &apos;quarter&apos; then DATETRUNC(&apos;quarter&apos;,[Parameters].[Order Date Parameter]) = DATETRUNC(&apos;quarter&apos;,[Calculation_3154419720365543442])&#10;end' />
      </column>
      <column caption='is previous period' datatype='boolean' name='[Calculation_3154419720365867028]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [timeframe] = &apos;month&apos; then DATEADD(&apos;month&apos;,-1,[Parameters].[Order Date Parameter]) = [Calculation_3154419720365543442]&#10;elseif [timeframe] = &apos;quarter&apos; then DATETRUNC(&apos;quarter&apos;,DATEADD(&apos;quarter&apos;,-1,[Parameters].[Order Date Parameter])) = DATETRUNC(&apos;quarter&apos;,[Calculation_3154419720365543442])&#10;end' />
      </column>
      <column caption='Platform AOF' datatype='real' name='[Calculation_3154419720401166375]' role='measure' type='quantitative'>
