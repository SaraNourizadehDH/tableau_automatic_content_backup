      <aliases enabled='yes' />
      <column caption='creation date' datatype='date' name='[Calculation_5742793234937274368]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [timeframe] = &apos;month&apos; THEN DATE( LEFT([creation_month],4) + &quot;-&quot; + RIGHT([creation_month],2) + &quot;-01&quot; )&#10;ELSEIF [timeframe] = &apos;quarter&apos; THEN DATE( LEFT([creation_month],4) + &quot;-&quot; + &quot;0&quot; + STR(INT(RIGHT([creation_month],2))*3-2) + &quot;-01&quot; )&#10;END' />
      </column>
      <column caption='is selected period - gmv' datatype='boolean' name='[Calculation_5742793234937737218]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [timeframe] = &apos;month&apos; then [Parameters].[Order Date Parameter]=[Calculation_5742793234937274368]&#10;elseif [timeframe] = &apos;quarter&apos; then DATETRUNC(&apos;quarter&apos;,[Parameters].[Order Date Parameter]) = DATETRUNC(&apos;quarter&apos;,[Calculation_5742793234937274368])&#10;end' />
      </column>
      <column caption='wallet trx - selected month' datatype='integer' name='[Calculation_5742793234940342275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([is selected month - gmv (copy)_5742793234950606858],[order_cnt],Null)' />
      </column>
      <column caption='AOV Eur' datatype='real' name='[Calculation_5742793234948255750]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gmv_eur])/sum([order_cnt])' />
      </column>
      <column caption='AOF' datatype='real' name='[Calculation_5742793234948395015]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([order_cnt])/sum([customer_cnt])' />
      </column>
      <column caption='is previous period' datatype='boolean' name='[Calculation_5742793234955948046]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [timeframe] = &apos;month&apos; then DATEADD(&apos;month&apos;,-1,[Parameters].[Order Date Parameter]) = [Calculation_5742793234937274368]&#10;elseif [timeframe] = &apos;quarter&apos; then DATETRUNC(&apos;quarter&apos;,DATEADD(&apos;quarter&apos;,-1,[Parameters].[Order Date Parameter])) = DATETRUNC(&apos;quarter&apos;,[Calculation_5742793234937274368])&#10;end' />
      </column>
      <column caption='wallet trx - previous month' datatype='integer' name='[Calculation_5742793234956095503]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_5742793234955948046],[order_cnt],Null)' />
      </column>
      <column caption='wallet trx - diff %' datatype='real' name='[Calculation_5742793234956247056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5742793234940342275])/SUM([Calculation_5742793234956095503])-1' />
      </column>
      <column caption='inflows gmv' datatype='real' name='[Calculation_6575396226300796928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [event_category] = &apos;Inflows&apos; then [gmv_eur] end' />
      </column>
      <column caption='inflows - outflows' datatype='real' name='[Calculation_6575396226323193858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_6575396226300796928])-sum([inflows gmv (copy)_6575396226300968961])' />
      </column>
      <column caption='inflows - outflows color' datatype='integer' name='[Calculation_6575396226336325635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_6575396226323193858] &gt; 0 then 1 else 0 end' />
      </column>
      <column caption='period - graphs' datatype='integer' name='[Calculation_6575396227074809861]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [timeframe] = &apos;month&apos; then (DATEPART(&apos;year&apos;, [Calculation_5742793234937274368])*100 + DATEPART(&apos;month&apos;, [Calculation_5742793234937274368]))&#10;elseif [timeframe] = &apos;quarter&apos; then (DATEPART(&apos;year&apos;, [Calculation_5742793234937274368])*100 + DATEPART(&apos;quarter&apos;, [Calculation_5742793234937274368]))&#10;end' />
      </column>
      <column aggregation='Sum' caption='Calculation1' datatype='integer' name='[Calculation_87257265853468672]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='int(RIGHT([creation_month],2))*3-2' />
      </column>
