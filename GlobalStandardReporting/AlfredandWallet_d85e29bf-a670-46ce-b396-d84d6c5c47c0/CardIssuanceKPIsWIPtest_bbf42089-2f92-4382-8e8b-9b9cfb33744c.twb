              <calculation class='tableau' formula='STR(Day([purchase_date]))+&apos; &apos;+LEFT(DATENAME(&apos;month&apos;,[purchase_date]),3) +&apos; &apos;+RIGHT(DATENAME(&apos;year&apos;,[purchase_date]),2)' />
            </column>
            <column caption='week' datatype='string' name='[Calculation_1050183194865324034]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;week&apos;+&apos; &apos;+STR(DATEPART(&apos;iso-week&apos;,[purchase_date])) +&apos; &apos;+STR(YEAR([purchase_date]))' />
            </column>
            <column caption='month' datatype='string' name='[Calculation_1050183194865451011]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[purchase_date]),3)+&apos; &apos;+STR(YEAR([purchase_date]))' />
            </column>
            <column caption='quarter' datatype='string' name='[Calculation_1050183194865569796]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(&quot;Q&quot; + str(DATEPART(&apos;quarter&apos;, [purchase_date])) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [purchase_date])))' />
            </column>
            <column caption='year' datatype='string' name='[Calculation_1050183194865709061]' role='dimension' type='nominal'>
