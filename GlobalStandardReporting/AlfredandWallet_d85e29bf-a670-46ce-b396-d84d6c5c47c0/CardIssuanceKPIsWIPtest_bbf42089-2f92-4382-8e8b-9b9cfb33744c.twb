    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Spend Overview'>
      <repository-location id='SpendOverview' path='/t/GlobalStandardReporting/workbooks/CardIssuanceKPIsWIPtest' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#f5f5f5' />
        </style-rule>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_686' value='center' />
          <format attr='text-align' id='dash-text_686' value='center' />
          <format attr='text-orientation' id='dash-text_704' value='-90' />
          <format attr='text-align' id='dash-text_704' value='center' />
          <format attr='text-orientation' id='dash-text_705' value='-90' />
