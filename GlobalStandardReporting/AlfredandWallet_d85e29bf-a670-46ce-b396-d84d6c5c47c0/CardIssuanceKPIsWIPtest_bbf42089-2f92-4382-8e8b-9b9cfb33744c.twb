    <dashboard name='Info'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/CTBCDashboard/Info?rev=' id='Info' path='/t/GlobalStandardReporting/workbooks/CardIssuanceKPIsWIPtest' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#f5f5f5' />
        </style-rule>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_686' value='center' />
