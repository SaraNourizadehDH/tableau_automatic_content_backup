              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0e5j7wk09glqk716o9wpn1ebfrod'>
            <column caption='day' datatype='string' name='[Calculation_1050183194865152001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(Day([process_date]))+&apos; &apos;+LEFT(DATENAME(&apos;month&apos;,[process_date]),3) +&apos; &apos;+RIGHT(DATENAME(&apos;year&apos;,[process_date]),2)' />
