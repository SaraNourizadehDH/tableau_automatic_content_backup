          <format attr='text-orientation' id='dash-text_662' value='-90' />
          <format attr='text-align' id='dash-text_662' value='center' />
          <format attr='text-orientation' id='dash-text_658' value='-90' />
          <format attr='text-align' id='dash-text_658' value='center' />
          <format attr='text-orientation' id='dash-text_676' value='-90' />
          <format attr='text-align' id='dash-text_676' value='center' />
          <format attr='text-orientation' id='dash-text_677' value='-90' />
          <format attr='text-align' id='dash-text_677' value='center' />
          <format attr='text-orientation' id='dash-text_678' value='-90' />
          <format attr='text-align' id='dash-text_678' value='center' />
          <format attr='text-orientation' id='dash-text_663' value='-90' />
          <format attr='text-align' id='dash-text_663' value='center' />
          <format attr='text-orientation' id='dash-text_752' value='-90' />
          <format attr='vertical-align' id='dash-text_752' value='center' />
          <format attr='text-align' id='dash-text_752' value='center' />
