      </column>
      <column caption='day' datatype='string' name='[Calculation_1050183194865152001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(Day([report_date]))+&apos; &apos;+LEFT(DATENAME(&apos;month&apos;,[report_date]),3) +&apos; &apos;+RIGHT(DATENAME(&apos;year&apos;, [report_date]),2)' />
      </column>
      <column caption='week' datatype='string' name='[Calculation_1050183194865324034]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;week&apos;+&apos; &apos;+STR(DATEPART(&apos;iso-week&apos;,[report_date])) +&apos; &apos;+STR(YEAR([report_date]))' />
      </column>
      <column caption='month' datatype='string' name='[Calculation_1050183194865451011]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[report_date]),3)+&apos; &apos;+STR(YEAR([report_date]))' />
      </column>
      <column caption='quarter' datatype='string' name='[Calculation_1050183194865569796]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='(&quot;Q&quot; + str(DATEPART(&apos;quarter&apos;, [report_date])) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [report_date])))' />
      </column>
      <column caption='year' datatype='string' name='[Calculation_1050183194865709061]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(DATEPART(&apos;year&apos;, [report_date]))' />
      </column>
      <column caption='Date Level' datatype='string' name='[Calculation_1050183194865819654]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Daily&apos; THEN [Calculation_1050183194865152001]&#10;    WHEN &apos;Weekly&apos; THEN [Calculation_1050183194865324034]&#10;    WHEN &apos;Monthly&apos; THEN [Calculation_1050183194865451011]&#10;    WHEN &apos;Quarterly&apos; THEN [Calculation_1050183194865569796]&#10;    WHEN &apos;Yearly&apos; THEN [Calculation_1050183194865709061]&#10;END' />
      </column>
      <column caption='CB Metric' datatype='real' name='[Calculation_1271211420342562818 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Usage Metric Selector (copy)_1271211420345303043] &#10;WHEN &apos;Customers&apos; THEN [Customers (copy)_5463429359685918723] &#10;WHEN &apos;Cashbacks&apos; THEN [Calculation_5463429359735885828] &#10;WHEN &apos;Cashback Amount&apos; THEN [FP Cust Transactions (copy)_470907698232291328]&#10;END' />
      </column>
      <column caption='Cashback' datatype='integer' name='[Calculation_5463429359735885828]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([ctbc_cashback])' />
      </column>
      <column caption='Customers' datatype='real' name='[Customers (copy)_5463429359685918723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Daily&apos; THEN avg([daily_customers]) &#10;    WHEN &apos;Weekly&apos; THEN avg([weekly_customers])&#10;    WHEN &apos;Monthly&apos; THEN avg([monthly_customers])&#10;    WHEN &apos;Quarterly&apos; THEN avg([quarterly_customers])&#10;    WHEN &apos;Yearly&apos; THEN avg([yearly_customers])&#10;END' />
