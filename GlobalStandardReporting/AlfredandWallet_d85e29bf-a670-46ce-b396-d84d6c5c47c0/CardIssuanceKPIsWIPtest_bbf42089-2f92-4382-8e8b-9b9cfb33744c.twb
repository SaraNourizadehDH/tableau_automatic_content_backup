            <column caption='week' datatype='string' name='[Calculation_1050183194865324034]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;week&apos;+&apos; &apos;+STR(DATEPART(&apos;iso-week&apos;,[process_date])) +&apos; &apos;+STR(YEAR([process_date]))' />
            </column>
            <column caption='month' datatype='string' name='[Calculation_1050183194865451011]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[process_date]),3)+&apos; &apos;+STR(YEAR([process_date]))' />
            </column>
            <column caption='quarter' datatype='string' name='[Calculation_1050183194865569796]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(&quot;Q&quot; + str(DATEPART(&apos;quarter&apos;, [process_date])) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [process_date])))' />
            </column>
            <column caption='year' datatype='string' name='[Calculation_1050183194865709061]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(DATEPART(&apos;year&apos;, [process_date]))' />
            </column>
            <column caption='Date Level' datatype='string' name='[Calculation_1050183194865819654]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Daily&apos; THEN [Calculation_1050183194865152001]&#10;    WHEN &apos;Weekly&apos; THEN [Calculation_1050183194865324034]&#10;    WHEN &apos;Monthly&apos; THEN [Calculation_1050183194865451011]&#10;    WHEN &apos;Quarterly&apos; THEN [Calculation_1050183194865569796]&#10;    WHEN &apos;Yearly&apos; THEN [Calculation_1050183194865709061]&#10;END' />
            </column>
            <column caption='FP Spend  AOF' datatype='real' name='[Calculation_1980950519949799430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Transactions (copy)_6575114720979718165]/[Customers Pro Seg (copy)_1980950519948750848]' />
            </column>
            <column caption='Customers FP Spend' datatype='real' name='[Customers Pro Seg (copy)_1980950519948750848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Daily&apos; THEN avg([Customers Pro Seg Daily (copy)_1980950519948750849]) &#10;    WHEN &apos;Weekly&apos; THEN avg([Customers Pro Seg Weekly (copy)_1980950519948750852])&#10;    WHEN &apos;Monthly&apos; THEN avg([Customers Pro Seg Monthly (copy)_1980950519948750850])&#10;    WHEN &apos;Quarterly&apos; THEN avg([Customers Pro Seg Quarterly (copy)_1980950519948750851])&#10;    WHEN &apos;Yearly&apos; THEN avg([Customers Pro Seg Yearly (copy)_1980950519948750853])&#10;END' />
            </column>
            <column caption='Customers FP Spend Daily' datatype='integer' name='[Customers Pro Seg Daily (copy)_1980950519948750849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [process_date], [binding_status], [pandapro_cust]: SUM([fp_daily_customers]) }' />
            </column>
            <column caption='Customers FP Spend Monthly' datatype='integer' name='[Customers Pro Seg Monthly (copy)_1980950519948750850]' role='measure' type='quantitative'>
