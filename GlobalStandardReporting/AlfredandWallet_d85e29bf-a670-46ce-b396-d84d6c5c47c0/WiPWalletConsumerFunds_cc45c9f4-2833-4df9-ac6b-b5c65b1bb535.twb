    <worksheet name='customer_metrics'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rl_wallet_p2p_agg' name='federated.07or82x1rnbw8m16b2c121uo8rd6' />
            <datasource caption='rl_wallet_customer_p2p_group (rl_fintech)' name='federated.0o42gkk1dcodle1gthgbz10rqtwl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Euro' caption='select currency' datatype='string' datatype-customized='true' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
              <aliases>
                <alias key='&quot;Euro&quot;' value='Euro' />
                <alias key='&quot;Local Currency&quot;' value='Local Currency' />
              </aliases>
            </column>
            <column caption='select date level' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column alias='# P2P Senders' caption='select customer metric' datatype='string' datatype-customized='true' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# P2P Senders&quot;'>
              <calculation class='tableau' formula='&quot;# P2P Senders&quot;' />
              <aliases>
                <alias key='&quot;\# P2P Senders&quot;' value='# P2P Senders' />
                <alias key='&quot;AVG Transfer Value per Sender&quot;' value='AVG Transfer Value per Sender' />
                <alias key='&quot;AVG Transfer Volume per Sender&quot;' value='AVG Transfer Volume per Sender' />
              </aliases>
            </column>
            <column alias='Overall' caption='select breakdown by' datatype='string' datatype-customized='true' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Overall&quot;'>
              <calculation class='tableau' formula='&quot;Overall&quot;' />
              <aliases>
                <alias key='&quot;Entity&quot;' value='Entity' />
                <alias key='&quot;Overall&quot;' value='Overall' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07or82x1rnbw8m16b2c121uo8rd6'>
            <column caption='P2P Transfer Amount' datatype='real' name='[Calculation_1211890526299025411]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &apos;Euro&apos; THEN [amount_eur]&#10;    WHEN &apos;Local Currency&apos; THEN [amount_lc]&#10;END' />
            </column>
            <column caption='day' datatype='string' name='[Calculation_1211890526304854024]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(Day([transfer_date]))+&apos; &apos;+LEFT(DATENAME(&apos;month&apos;,[transfer_date]),3) +&apos; &apos;+RIGHT(DATENAME(&apos;year&apos;,[transfer_date]),2)' />
            </column>
            <column caption='month' datatype='string' name='[Calculation_1211890526305095689]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[transfer_date]),3)+&apos; &apos;+STR(YEAR([transfer_date]))' />
            </column>
            <column caption='quarter' datatype='string' name='[Calculation_1211890526305288202]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(&quot;Q&quot; + str(DATEPART(&apos;quarter&apos;, [transfer_date])) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [transfer_date])))' />
            </column>
            <column caption='week' datatype='string' name='[Calculation_1211890526305423371]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;week&apos;+&apos; &apos;+STR(DATEPART(&apos;week&apos;,[transfer_date])) +&apos; &apos;+STR(YEAR([transfer_date]))' />
            </column>
            <column caption='year' datatype='string' name='[Calculation_1211890526305538060]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(DATEPART(&apos;year&apos;, [transfer_date]))' />
            </column>
            <column caption='date level' datatype='string' name='[Calculation_1211890526305693709]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Daily&apos; THEN [Calculation_1211890526304854024]&#10;    WHEN &apos;Weekly&apos; THEN [Calculation_1211890526305423371]&#10;    WHEN &apos;Monthly&apos; THEN [Calculation_1211890526305095689]&#10;    WHEN &apos;Quarterly&apos; THEN [Calculation_1211890526305288202]&#10;    WHEN &apos;Yearly&apos; THEN [Calculation_1211890526305538060]&#10;END' />
            </column>
            <column caption='customer metric suffix' datatype='string' name='[Calculation_1211890526316376079]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;  WHEN &apos;# P2P Senders&apos; THEN &apos;&apos;&#10;  WHEN &apos;AVG Transfer Volume per Sender&apos; THEN &apos;&apos;&#10;  WHEN &apos;AVG Transfer Amount per Sender&apos; THEN &#10;    CASE [Parameters].[Parameter 3] &#10;        WHEN &apos;Euro&apos; THEN &apos;(€)&apos; &#10;        ELSE &apos;(LC)&apos; &#10;    END&#10;    ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='customer break down' datatype='string' name='[Calculation_1211890526318706704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &apos;Overall&apos; THEN &quot;Overall&quot;&#10;    WHEN &apos;Entity&apos; THEN [global_entity_id]&#10;    ELSE NULL&#10;END' />
            </column>
            <column caption='Unique Customers' datatype='integer' name='[Calculation_1211890526319112209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Daily&apos; THEN SUM({FIXED [global_entity_id], [transfer_date]: MAX([p2p_senders_daily])})&#10;    WHEN &apos;Weekly&apos; THEN SUM({FIXED [global_entity_id], [Calculation_1211890526305423371]: MAX([p2p_senders_weekly])})&#10;    WHEN &apos;Monthly&apos; THEN SUM({FIXED [global_entity_id],  [Calculation_1211890526305095689]: MAX([p2p_senders_monthly])})&#10;    WHEN &apos;Quarterly&apos; THEN SUM({FIXED [global_entity_id], [Calculation_1211890526305288202]: MAX([p2p_senders_quarterly])})&#10;    WHEN &apos;Yearly&apos; THEN SUM({FIXED [global_entity_id],  [Calculation_1211890526305538060]: MAX([p2p_senders_yearly])})&#10;END' />
            </column>
            <column caption='Avg P2P Transfer Amt per customer' datatype='real' name='[Calculation_1211890526320414738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1211890526299025411])/ [Calculation_1211890526319112209]' />
            </column>
            <column caption='Avg P2P Transfer Trx per customer' datatype='real' name='[Calculation_1211890526321393683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([p2p_transfer_txns])/ [Calculation_1211890526319112209]' />
            </column>
            <column caption='Customer Metrics' datatype='real' name='[Calculation_1211890526321704980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &apos;# P2P Senders&apos; THEN [Calculation_1211890526319112209]&#10;    WHEN &apos;AVG Transfer Volume per Sender&apos; THEN [Calculation_1211890526321393683]&#10;    WHEN &apos;AVG Transfer Value per Sender&apos; THEN [Calculation_1211890526320414738]&#10;    ELSE NULL&#10;END' />
            </column>
            <column caption='Amount Eur' datatype='real' name='[amount_eur]' role='measure' type='quantitative' />
            <column caption='Amount Lc' datatype='real' name='[amount_lc]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1211890526316376079]' derivation='Attribute' name='[attr:Calculation_1211890526316376079:nk]' pivot='key' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[transfer_date]' derivation='Min' name='[min:transfer_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1211890526305693709]' derivation='None' name='[none:Calculation_1211890526305693709:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1211890526316376079]' derivation='None' name='[none:Calculation_1211890526316376079:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1211890526318706704]' derivation='None' name='[none:Calculation_1211890526318706704:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[transfer_date]' derivation='None' name='[none:transfer_date:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[p2p_senders_daily]' role='measure' type='quantitative' />
            <column datatype='integer' name='[p2p_senders_monthly]' role='measure' type='quantitative' />
            <column datatype='integer' name='[p2p_senders_quarterly]' role='measure' type='quantitative' />
            <column datatype='integer' name='[p2p_senders_weekly]' role='measure' type='quantitative' />
