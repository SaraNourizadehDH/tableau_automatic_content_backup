    <worksheet name='Sheet 7'>
      <table>
        <view>
          <datasources>
            <datasource caption='rl_wallet_p2p_time_to_next_wallet_purchase (rl_fintech)' name='federated.0mxhw2o1m9rbwk145l2o11rvwkq9' />
            <datasource caption='rl_wallet_customer_p2p_group (rl_fintech)' name='federated.0o42gkk1dcodle1gthgbz10rqtwl' />
          </datasources>
          <datasource-dependencies datasource='federated.0mxhw2o1m9rbwk145l2o11rvwkq9'>
            <column caption='next wallet purchase window (cap)' datatype='string' name='[Calculation_1674776130818920448]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [next_wallet_purchase_window] &lt;= 2 THEN &apos;0-2 hours&apos;&#10;    ELSEIF [next_wallet_purchase_window] &gt; 2 AND [next_wallet_purchase_window] &lt;= 6 THEN &apos;2-6 hours&apos;&#10;    ELSEIF [next_wallet_purchase_window] &gt; 6 AND [next_wallet_purchase_window] &lt;=12 THEN &apos;6-12 hours&apos;&#10;    ELSEIF [next_wallet_purchase_window] &gt; 12 AND [next_wallet_purchase_window] &lt;= 24 THEN &apos;12-24 hours&apos;&#10;    ELSEIF [next_wallet_purchase_window] &gt; 24 AND [next_wallet_purchase_window] &lt;= 48 THEN &apos;1-2 days&apos;&#10;    ELSEIF [next_wallet_purchase_window] &gt; 48 AND [next_wallet_purchase_window] &lt;= 96 THEN &apos;2-4 days&apos;&#10;    ELSEIF [next_wallet_purchase_window] &gt; 96 AND [next_wallet_purchase_window] &lt;= 168 THEN &apos;4-7 days&apos;&#10;    ELSEIF [next_wallet_purchase_window] &gt; 168 THEN &apos;&gt; 7 days&apos;&#10;ELSE NULL&#10;END' />
            </column>
            <column aggregation='Attribute' caption='total p2p trx across all purchase windows' datatype='integer' name='[Calculation_4990410618966085632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// This calculation shows the overall total of P2P transactions. &#10;// It adds up all the p2p_trx values but deliberately ignores the [NextWalletPurchase Window (Cap)] category.&#10;&#10;{EXCLUDE [Calculation_1674776130818920448]: SUM([p2p_trx])}' />
            </column>
            <column-instance column='[Calculation_4990410618966085632]' derivation='Attribute' name='[attr:Calculation_4990410618966085632:ok]' pivot='key' type='ordinal' />
            <column caption='Next Wallet Purchase Window' datatype='integer' name='[next_wallet_purchase_window]' role='measure' type='quantitative' />
            <column caption='Next Wallet Purchase Window Capped' datatype='string' name='[next_wallet_purchase_window_capped]' role='dimension' type='nominal' />
            <column-instance column='[next_wallet_purchase_window_capped]' derivation='None' name='[none:next_wallet_purchase_window_capped:nk]' pivot='key' type='nominal' />
            <column-instance column='[receive_date]' derivation='None' name='[none:receive_date:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[p2p_trx]' role='measure' type='quantitative' />
            <column caption='Receive Date' datatype='date' name='[receive_date]' role='dimension' type='ordinal' />
            <column-instance column='[p2p_trx]' derivation='Sum' name='[sum:p2p_trx:ok]' pivot='key' type='ordinal' />
            <column-instance column='[wallet_orders]' derivation='Sum' name='[sum:wallet_orders:ok]' pivot='key' type='ordinal' />
            <column-instance column='[receive_date]' derivation='Day-Trunc' name='[tdy:receive_date:ok]' pivot='key' type='ordinal' />
            <column caption='Wallet Orders' datatype='integer' name='[wallet_orders]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0o42gkk1dcodle1gthgbz10rqtwl'>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <slices>
            <column>[federated.0mxhw2o1m9rbwk145l2o11rvwkq9].[none:receive_date:qk]</column>
            <column>[federated.0o42gkk1dcodle1gthgbz10rqtwl].[none:global_entity_id:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='header'>
            <format attr='width' field='[federated.0mxhw2o1m9rbwk145l2o11rvwkq9].[tdy:receive_date:ok]' value='164' />
            <format attr='width' field='[federated.0mxhw2o1m9rbwk145l2o11rvwkq9].[sum:wallet_orders:ok]' value='160' />
          </style-rule>
        </style>
        <panes>
          <pane id='1' selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
        </panes>
        <rows>([federated.0mxhw2o1m9rbwk145l2o11rvwkq9].[tdy:receive_date:ok] / ([federated.0mxhw2o1m9rbwk145l2o11rvwkq9].[none:next_wallet_purchase_window_capped:nk] / ([federated.0mxhw2o1m9rbwk145l2o11rvwkq9].[sum:wallet_orders:ok] / ([federated.0mxhw2o1m9rbwk145l2o11rvwkq9].[attr:Calculation_4990410618966085632:ok] / [federated.0mxhw2o1m9rbwk145l2o11rvwkq9].[sum:p2p_trx:ok]))))</rows>
        <cols />
