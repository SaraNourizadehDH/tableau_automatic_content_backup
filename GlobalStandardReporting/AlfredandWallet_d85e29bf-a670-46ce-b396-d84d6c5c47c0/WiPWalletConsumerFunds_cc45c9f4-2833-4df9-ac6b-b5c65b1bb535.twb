          <datasource-dependencies datasource='federated.07or82x1rnbw8m16b2c121uo8rd6'>
            <column caption='overview metric suffix string' datatype='string' name='[Calculation_1211890526297845761]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &apos;Euro&apos; THEN&#10;        CASE [Parameters].[Parameter 1]&#10;            WHEN &apos;Total P2P Transfer volume&apos; THEN &quot;&quot;&#10;            ELSE &quot;(€)&quot;&#10;        END&#10;    WHEN &apos;Local Currency&apos; THEN&#10;        CASE [Parameters].[Parameter 1]&#10;            WHEN &apos;Total P2P Transfer volume&apos; THEN &quot;&quot;&#10;            ELSE &quot;(LC)&quot;&#10;        END&#10;END' />
            </column>
            <column caption='Overview Metric' datatype='real' name='[Calculation_1211890526298435586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Total P2P Transfer Volume&apos; THEN SUM([p2p_transfer_txns])&#10;    WHEN &apos;Total P2P Transfer Value&apos; THEN SUM([Calculation_1211890526299025411])&#10;    WHEN &apos;Average P2P Transfer Value&apos; THEN SUM([Calculation_1211890526299025411])/SUM([p2p_transfer_txns])&#10;    WHEN &apos;Minimum P2P Transfer Value&apos; THEN MIN([Calculation_1211890526299172868])&#10;    WHEN &apos;Maximum P2P Transfer Value&apos; THEN MAX([Min P2P Transfer Amount (copy)_1211890526299721733])&#10;END' />
            </column>
            <column caption='P2P Transfer Amount' datatype='real' name='[Calculation_1211890526299025411]' role='measure' type='quantitative'>
