    <worksheet name='customer_p2p_column'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold' fontsize='12'>Customer by Number of P2P Transactions</run>
            <run>Æ&#10;</run>
            <run fontcolor='#707070' fontname='Tableau Medium' fontsize='10'><![CDATA[Filtered by: Entity <[federated.0o42gkk1dcodle1gthgbz10rqtwl].[none:global_entity_id:nk]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rl_wallet_customer_p2p_group (rl_fintech)' name='federated.0o42gkk1dcodle1gthgbz10rqtwl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='select date level' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0o42gkk1dcodle1gthgbz10rqtwl'>
            <column caption='% of &gt;3' datatype='real' name='[Calculation_1211890526330056726]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([num_customers_more_than_3_transactions]))/(sum([num_customers_1_transaction])+sum([num_customers_2_transactions])+sum([num_customers_3_transactions])+sum([num_customers_more_than_3_transactions]))' />
            </column>
            <column caption='% of 1' datatype='real' name='[Calculation_1211890526330163223]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([num_customers_1_transaction]))/(sum([num_customers_1_transaction])+sum([num_customers_2_transactions])+sum([num_customers_3_transactions])+sum([num_customers_more_than_3_transactions]))' />
            </column>
            <column caption='% of 2' datatype='real' name='[Calculation_1211890526330232856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([num_customers_2_transactions]))/(sum([num_customers_1_transaction])+sum([num_customers_2_transactions])+sum([num_customers_3_transactions])+sum([num_customers_more_than_3_transactions]))' />
            </column>
            <column caption='% of 3' datatype='real' name='[Calculation_1211890526330327065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([num_customers_3_transactions]))/(sum([num_customers_1_transaction])+sum([num_customers_2_transactions])+sum([num_customers_3_transactions])+sum([num_customers_more_than_3_transactions]))' />
            </column>
            <column caption='date level' datatype='string' name='[Calculation_1211890526330515482]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Daily&apos; THEN (str(DATEPART(&apos;day&apos;, [transaction_day])) + &quot;.&quot; + str(DATEPART(&apos;month&apos;, [transaction_day])) + &quot;.&quot; + str(DATEPART(&apos;year&apos;, [transaction_day])))&#10;    WHEN &apos;Weekly&apos; THEN (str(DATE(DATETRUNC(&apos;week&apos;, [transaction_day], &apos;Sunday&apos;))))&#10;    WHEN &apos;Monthly&apos; THEN (str(LEFT(DATENAME(&apos;month&apos;, [transaction_day]),3)) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [transaction_day])))&#10;    WHEN &apos;Quarterly&apos; THEN (&quot;Q&quot; + str(DATEPART(&apos;quarter&apos;, [transaction_day])) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [transaction_day])))&#10;    WHEN &apos;Yearly&apos; THEN str(DATEPART(&apos;year&apos;, [transaction_day]))&#10;END' />
            </column>
            <column caption='level filter' datatype='string' name='[Level filter (copy)_3410210100717596673]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [level] = [Parameters].[Parameter 4] THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
            </column>
            <column caption='Customer Type' datatype='string' name='[customer_type]' role='dimension' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Level' datatype='string' name='[level]' role='dimension' type='nominal' />
            <column-instance column='[transaction_day]' derivation='Min' name='[min:transaction_day:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1211890526330515482]' derivation='None' name='[none:Calculation_1211890526330515482:nk]' pivot='key' type='nominal' />
            <column-instance column='[Level filter (copy)_3410210100717596673]' derivation='None' name='[none:Level filter (copy)_3410210100717596673:nk]' pivot='key' type='nominal' />
            <column-instance column='[customer_type]' derivation='None' name='[none:customer_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[transaction_day]' derivation='None' name='[none:transaction_day:qk]' pivot='key' type='quantitative' />
            <column caption='Num Customers 1 Transaction' datatype='integer' name='[num_customers_1_transaction]' role='measure' type='quantitative' />
            <column caption='Num Customers 2 Transactions' datatype='integer' name='[num_customers_2_transactions]' role='measure' type='quantitative' />
            <column caption='Num Customers 3 Transactions' datatype='integer' name='[num_customers_3_transactions]' role='measure' type='quantitative' />
            <column caption='Num Customers More Than 3 Transactions' datatype='integer' name='[num_customers_more_than_3_transactions]' role='measure' type='quantitative' />
            <column-instance column='[num_customers_1_transaction]' derivation='Sum' name='[sum:num_customers_1_transaction:qk]' pivot='key' type='quantitative' />
