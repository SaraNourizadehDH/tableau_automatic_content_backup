            </column>
            <column caption='Min P2P Transfer Amount' datatype='real' name='[Calculation_1211890526299172868]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;    WHEN &apos;Euro&apos; THEN [min_amount_eur]&#10;    WHEN &apos;Local Currency&apos; THEN [min_amount_lc]&#10;END' />
            </column>
            <column caption='day' datatype='string' name='[Calculation_1211890526304854024]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(Day([transfer_date]))+&apos; &apos;+LEFT(DATENAME(&apos;month&apos;,[transfer_date]),3) +&apos; &apos;+RIGHT(DATENAME(&apos;year&apos;,[transfer_date]),2)' />
            </column>
            <column caption='month' datatype='string' name='[Calculation_1211890526305095689]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[transfer_date]),3)+&apos; &apos;+STR(YEAR([transfer_date]))' />
            </column>
            <column caption='quarter' datatype='string' name='[Calculation_1211890526305288202]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(&quot;Q&quot; + str(DATEPART(&apos;quarter&apos;, [transfer_date])) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [transfer_date])))' />
            </column>
            <column caption='week' datatype='string' name='[Calculation_1211890526305423371]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;week&apos;+&apos; &apos;+STR(DATEPART(&apos;week&apos;,[transfer_date])) +&apos; &apos;+STR(YEAR([transfer_date]))' />
            </column>
            <column caption='year' datatype='string' name='[Calculation_1211890526305538060]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(DATEPART(&apos;year&apos;, [transfer_date]))' />
            </column>
            <column caption='date level' datatype='string' name='[Calculation_1211890526305693709]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Daily&apos; THEN [Calculation_1211890526304854024]&#10;    WHEN &apos;Weekly&apos; THEN [Calculation_1211890526305423371]&#10;    WHEN &apos;Monthly&apos; THEN [Calculation_1211890526305095689]&#10;    WHEN &apos;Quarterly&apos; THEN [Calculation_1211890526305288202]&#10;    WHEN &apos;Yearly&apos; THEN [Calculation_1211890526305538060]&#10;END' />
            </column>
            <column caption='customer break down' datatype='string' name='[Calculation_1211890526318706704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &apos;Overall&apos; THEN &quot;Overall&quot;&#10;    WHEN &apos;Entity&apos; THEN [global_entity_id]&#10;    ELSE NULL&#10;END' />
