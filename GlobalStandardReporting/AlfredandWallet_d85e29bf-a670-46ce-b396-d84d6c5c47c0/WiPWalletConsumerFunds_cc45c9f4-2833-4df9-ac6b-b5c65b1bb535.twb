    <worksheet name='Sheet 9'>
      <table>
        <view>
          <datasources>
            <datasource caption='rl_wallet_p2p_agg' name='federated.07or82x1rnbw8m16b2c121uo8rd6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='select date level' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column alias='Overall' caption='select breakdown by' datatype='string' datatype-customized='true' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Overall&quot;'>
              <calculation class='tableau' formula='&quot;Overall&quot;' />
              <aliases>
                <alias key='&quot;Entity&quot;' value='Entity' />
                <alias key='&quot;Overall&quot;' value='Overall' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07or82x1rnbw8m16b2c121uo8rd6'>
            <column caption='month' datatype='string' name='[Calculation_1211890526305095689]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;,[transfer_date]),3)+&apos; &apos;+STR(YEAR([transfer_date]))' />
            </column>
            <column caption='quarter' datatype='string' name='[Calculation_1211890526305288202]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(&quot;Q&quot; + str(DATEPART(&apos;quarter&apos;, [transfer_date])) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [transfer_date])))' />
            </column>
            <column caption='week' datatype='string' name='[Calculation_1211890526305423371]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;week&apos;+&apos; &apos;+STR(DATEPART(&apos;week&apos;,[transfer_date])) +&apos; &apos;+STR(YEAR([transfer_date]))' />
            </column>
            <column caption='year' datatype='string' name='[Calculation_1211890526305538060]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(DATEPART(&apos;year&apos;, [transfer_date]))' />
            </column>
            <column caption='customer break down' datatype='string' name='[Calculation_1211890526318706704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &apos;Overall&apos; THEN &quot;Overall&quot;&#10;    WHEN &apos;Entity&apos; THEN [global_entity_id]&#10;    ELSE NULL&#10;END' />
            </column>
            <column caption='Unique Customers' datatype='integer' name='[Calculation_1211890526319112209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Daily&apos; THEN SUM({FIXED [global_entity_id], [transfer_date]: MAX([p2p_senders_daily])})&#10;    WHEN &apos;Weekly&apos; THEN SUM({FIXED [global_entity_id], [Calculation_1211890526305423371]: MAX([p2p_senders_weekly])})&#10;    WHEN &apos;Monthly&apos; THEN SUM({FIXED [global_entity_id],  [Calculation_1211890526305095689]: MAX([p2p_senders_monthly])})&#10;    WHEN &apos;Quarterly&apos; THEN SUM({FIXED [global_entity_id], [Calculation_1211890526305288202]: MAX([p2p_senders_quarterly])})&#10;    WHEN &apos;Yearly&apos; THEN SUM({FIXED [global_entity_id],  [Calculation_1211890526305538060]: MAX([p2p_senders_yearly])})&#10;END' />
            </column>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1211890526305423371]' derivation='None' name='[none:Calculation_1211890526305423371:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1211890526318706704]' derivation='None' name='[none:Calculation_1211890526318706704:nk]' pivot='key' type='nominal' />
            <column-instance column='[transfer_date]' derivation='None' name='[none:transfer_date:ok]' pivot='key' type='ordinal' />
            <column datatype='integer' name='[p2p_senders_daily]' role='measure' type='quantitative' />
            <column datatype='integer' name='[p2p_senders_monthly]' role='measure' type='quantitative' />
            <column datatype='integer' name='[p2p_senders_quarterly]' role='measure' type='quantitative' />
            <column datatype='integer' name='[p2p_senders_weekly]' role='measure' type='quantitative' />
            <column datatype='integer' name='[p2p_senders_yearly]' role='measure' type='quantitative' />
            <column-instance column='[p2p_senders_daily]' derivation='Sum' name='[sum:p2p_senders_daily:qk]' pivot='key' type='quantitative' />
            <column-instance column='[p2p_senders_weekly]' derivation='Sum' name='[sum:p2p_senders_weekly:qk]' pivot='key' type='quantitative' />
            <column caption='Transfer Date' datatype='date' name='[transfer_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1211890526319112209]' derivation='User' name='[usr:Calculation_1211890526319112209:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.07or82x1rnbw8m16b2c121uo8rd6].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.07or82x1rnbw8m16b2c121uo8rd6].[usr:Calculation_1211890526319112209:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.07or82x1rnbw8m16b2c121uo8rd6].[sum:p2p_senders_daily:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.07or82x1rnbw8m16b2c121uo8rd6].[sum:p2p_senders_weekly:qk]&quot;' />
            </groupfilter>
