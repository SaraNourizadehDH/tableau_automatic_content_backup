            <column caption='P2P Transfer Txns' datatype='integer' name='[p2p_transfer_txns]' role='measure' type='quantitative' />
            <column caption='Transfer Date' datatype='date' name='[transfer_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1211890526321704980]' derivation='User' name='[usr:Calculation_1211890526321704980:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0o42gkk1dcodle1gthgbz10rqtwl'>
