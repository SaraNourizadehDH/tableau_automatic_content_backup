    <worksheet name='Time to first Order (check)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold' fontsize='12'>Time to first Order</run>
            <run>Æ&#10;</run>
            <run fontcolor='#c0c0c0' fontname='Benton Sans Book' fontsize='10'>Time from P2P Receipt to Next Wallet Purchase (transfer-level)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rl_wallet_p2p_time_to_next_wallet_purchase (rl_fintech)' name='federated.0mxhw2o1m9rbwk145l2o11rvwkq9' />
            <datasource caption='rl_wallet_customer_p2p_group (rl_fintech)' name='federated.0o42gkk1dcodle1gthgbz10rqtwl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='select date level' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0mxhw2o1m9rbwk145l2o11rvwkq9'>
            <column caption='next wallet purchase window (cap)' datatype='string' name='[Calculation_1674776130818920448]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [next_wallet_purchase_window] &lt;= 2 THEN &apos;0-2 hours&apos;&#10;    ELSEIF [next_wallet_purchase_window] &gt; 2 AND [next_wallet_purchase_window] &lt;= 6 THEN &apos;2-6 hours&apos;&#10;    ELSEIF [next_wallet_purchase_window] &gt; 6 AND [next_wallet_purchase_window] &lt;=12 THEN &apos;6-12 hours&apos;&#10;    ELSEIF [next_wallet_purchase_window] &gt; 12 AND [next_wallet_purchase_window] &lt;= 24 THEN &apos;12-24 hours&apos;&#10;    ELSEIF [next_wallet_purchase_window] &gt; 24 AND [next_wallet_purchase_window] &lt;= 48 THEN &apos;1-2 days&apos;&#10;    ELSEIF [next_wallet_purchase_window] &gt; 48 AND [next_wallet_purchase_window] &lt;= 96 THEN &apos;2-4 days&apos;&#10;    ELSEIF [next_wallet_purchase_window] &gt; 96 AND [next_wallet_purchase_window] &lt;= 168 THEN &apos;4-7 days&apos;&#10;    ELSEIF [next_wallet_purchase_window] &gt; 168 THEN &apos;&gt; 7 days&apos;&#10;ELSE NULL&#10;END' />
            </column>
            <column aggregation='Attribute' caption='total p2p trx across all purchase windows' datatype='integer' name='[Calculation_4990410618966085632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// This calculation shows the overall total of P2P transactions. &#10;// It adds up all the p2p_trx values but deliberately ignores the [NextWalletPurchase Window (Cap)] category.&#10;&#10;{EXCLUDE [Calculation_1674776130818920448]: SUM([p2p_trx])}' />
            </column>
            <column caption='wallet purchase rate (per after each p2p trx)' datatype='real' name='[Calculation_4990410618966331393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// For a customer&apos;s entire volume of P2P transactions, what portion of wallet orders happened within this specific time window&#10;// SUM([Wallet Orders]): This is the number of wallet orders that fall within the specific [NextWalletPurchase Window (Cap)]&#10;// MAX([total p2p trx across all purchase windows]): This is the customer&apos;s total P2P transactions, used as a stable baseline for comparison.&#10;&#10;SUM([wallet_orders])/ATTR([Calculation_4990410618966085632])' />
            </column>
            <column caption='date level' datatype='string' name='[Calculation_4990410618967228419]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Daily&apos; THEN (str(DATEPART(&apos;day&apos;, [receive_date])) + &quot;.&quot; + str(DATEPART(&apos;month&apos;, [receive_date])) + &quot;.&quot; + str(DATEPART(&apos;year&apos;, [receive_date])))&#10;    WHEN &apos;Weekly&apos; THEN (str(DATE(DATETRUNC(&apos;week&apos;, [receive_date], &apos;Sunday&apos;))))&#10;    WHEN &apos;Monthly&apos; THEN (str(LEFT(DATENAME(&apos;month&apos;, [receive_date]),3)) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [receive_date])))&#10;    WHEN &apos;Quarterly&apos; THEN (&quot;Q&quot; + str(DATEPART(&apos;quarter&apos;, [receive_date])) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [receive_date])))&#10;    WHEN &apos;Yearly&apos; THEN str(DATEPART(&apos;year&apos;, [receive_date]))&#10;    end' />
            </column>
            <column-instance column='[Calculation_4990410618966085632]' derivation='Attribute' name='[attr:Calculation_4990410618966085632:qk]' pivot='key' type='quantitative' />
            <column caption='Next Wallet Purchase Window' datatype='integer' name='[next_wallet_purchase_window]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1674776130818920448]' derivation='None' name='[none:Calculation_1674776130818920448:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4990410618967228419]' derivation='None' name='[none:Calculation_4990410618967228419:nk]' pivot='key' type='nominal' />
            <column-instance column='[receive_date]' derivation='None' name='[none:receive_date:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[p2p_trx]' role='measure' type='quantitative' />
            <column caption='Receive Date' datatype='date' name='[receive_date]' role='dimension' type='ordinal' />
            <column-instance column='[next_wallet_purchase_window]' derivation='Sum' name='[sum:next_wallet_purchase_window:qk]' pivot='key' type='quantitative' />
            <column-instance column='[p2p_trx]' derivation='Sum' name='[sum:p2p_trx:qk]' pivot='key' type='quantitative' />
            <column-instance column='[wallet_orders]' derivation='Sum' name='[sum:wallet_orders:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_4990410618966331393]' derivation='User' name='[usr:Calculation_4990410618966331393:qk]' pivot='key' type='quantitative' />
            <column caption='Wallet Orders' datatype='integer' name='[wallet_orders]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0o42gkk1dcodle1gthgbz10rqtwl'>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0mxhw2o1m9rbwk145l2o11rvwkq9].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0mxhw2o1m9rbwk145l2o11rvwkq9].[sum:next_wallet_purchase_window:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0mxhw2o1m9rbwk145l2o11rvwkq9].[sum:wallet_orders:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0mxhw2o1m9rbwk145l2o11rvwkq9].[sum:p2p_trx:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0mxhw2o1m9rbwk145l2o11rvwkq9].[attr:Calculation_4990410618966085632:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0mxhw2o1m9rbwk145l2o11rvwkq9].[usr:Calculation_4990410618966331393:qk]&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.0mxhw2o1m9rbwk145l2o11rvwkq9].[:Measure Names]</column>
            <column>[federated.0mxhw2o1m9rbwk145l2o11rvwkq9].[none:receive_date:qk]</column>
            <column>[federated.0o42gkk1dcodle1gthgbz10rqtwl].[none:global_entity_id:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
