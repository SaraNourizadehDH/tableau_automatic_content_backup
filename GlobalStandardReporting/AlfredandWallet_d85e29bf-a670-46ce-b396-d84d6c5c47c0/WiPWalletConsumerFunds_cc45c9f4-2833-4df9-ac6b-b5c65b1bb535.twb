      <aliases enabled='yes' />
      <column caption='next wallet purchase window (cap)' datatype='string' name='[Calculation_1674776130818920448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [next_wallet_purchase_window] &lt;= 2 THEN &apos;0-2 hours&apos;&#10;    ELSEIF [next_wallet_purchase_window] &gt; 2 AND [next_wallet_purchase_window] &lt;= 6 THEN &apos;2-6 hours&apos;&#10;    ELSEIF [next_wallet_purchase_window] &gt; 6 AND [next_wallet_purchase_window] &lt;=12 THEN &apos;6-12 hours&apos;&#10;    ELSEIF [next_wallet_purchase_window] &gt; 12 AND [next_wallet_purchase_window] &lt;= 24 THEN &apos;12-24 hours&apos;&#10;    ELSEIF [next_wallet_purchase_window] &gt; 24 AND [next_wallet_purchase_window] &lt;= 48 THEN &apos;1-2 days&apos;&#10;    ELSEIF [next_wallet_purchase_window] &gt; 48 AND [next_wallet_purchase_window] &lt;= 96 THEN &apos;2-4 days&apos;&#10;    ELSEIF [next_wallet_purchase_window] &gt; 96 AND [next_wallet_purchase_window] &lt;= 168 THEN &apos;4-7 days&apos;&#10;    ELSEIF [next_wallet_purchase_window] &gt; 168 THEN &apos;&gt; 7 days&apos;&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='User Entitlements' datatype='boolean' name='[Calculation_1674776131146870785]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='total p2p trx' datatype='integer' name='[Calculation_2980468180113231873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([p2p_trx])' />
      </column>
      <column aggregation='Attribute' caption='total p2p trx across all purchase windows' datatype='integer' name='[Calculation_4990410618966085632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// This calculation shows the overall total of P2P transactions. &#10;// It adds up all the p2p_trx values but deliberately ignores the [NextWalletPurchase Window (Cap)] category.&#10;&#10;{EXCLUDE [Calculation_1674776130818920448]: SUM([p2p_trx])}' />
      </column>
      <column caption='wallet purchase rate (per after each p2p trx)' datatype='real' name='[Calculation_4990410618966331393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// For a customer&apos;s entire volume of P2P transactions, what portion of wallet orders happened within this specific time window&#10;// SUM([Wallet Orders]): This is the number of wallet orders that fall within the specific [NextWalletPurchase Window (Cap)]&#10;// MAX([total p2p trx across all purchase windows]): This is the customer&apos;s total P2P transactions, used as a stable baseline for comparison.&#10;&#10;SUM([wallet_orders])/ATTR([Calculation_4990410618966085632])' />
      </column>
      <column caption='date level' datatype='string' name='[Calculation_4990410618967228419]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Daily&apos; THEN (str(DATEPART(&apos;day&apos;, [receive_date])) + &quot;.&quot; + str(DATEPART(&apos;month&apos;, [receive_date])) + &quot;.&quot; + str(DATEPART(&apos;year&apos;, [receive_date])))&#10;    WHEN &apos;Weekly&apos; THEN (str(DATE(DATETRUNC(&apos;week&apos;, [receive_date], &apos;Sunday&apos;))))&#10;    WHEN &apos;Monthly&apos; THEN (str(LEFT(DATENAME(&apos;month&apos;, [receive_date]),3)) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [receive_date])))&#10;    WHEN &apos;Quarterly&apos; THEN (&quot;Q&quot; + str(DATEPART(&apos;quarter&apos;, [receive_date])) + &quot; &quot; + str(DATEPART(&apos;year&apos;, [receive_date])))&#10;    WHEN &apos;Yearly&apos; THEN str(DATEPART(&apos;year&apos;, [receive_date]))&#10;    end' />
      </column>
