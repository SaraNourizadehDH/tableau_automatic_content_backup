          <datasource-dependencies datasource='federated.077698b0tktnj81ahgq3r08djx94'>
            <column caption='creation date' datatype='date' name='[Calculation_5742793234937274368]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [timeframe] = &apos;month&apos; THEN&#10;    DATE( LEFT([creation_month], 4) + &quot;-&quot; + RIGHT([creation_month], 2) + &quot;-01&quot; )&#10;ELSEIF [timeframe] = &apos;quarter&apos; THEN&#10;    DATE( LEFT([creation_month], 4) + &quot;-&quot; + &#10;          IF (INT(RIGHT([creation_month], 2)) * 3 - 2) &lt; 10 THEN &#10;              &quot;0&quot; + STR(INT(RIGHT([creation_month], 2)) * 3 - 2)&#10;          ELSE &#10;              STR(INT(RIGHT([creation_month], 2)) * 3 - 2)&#10;          END + &quot;-01&quot; )&#10;END' />
            </column>
            <column caption='wallet trx - selected month' datatype='integer' name='[Calculation_5742793234940342275]' role='measure' type='quantitative'>
