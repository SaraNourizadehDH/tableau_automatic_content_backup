      <aliases enabled='yes' />
      <column caption='Funds Breakdown' datatype='string' name='[Balance Breakdown (copy)_2052937800729608192]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Balance View By (copy)_2052937800729653249]&#10;    WHEN &apos;Overall&apos; THEN &apos;Overall&apos;&#10;    WHEN &apos;Funds Source&apos; THEN [funds_source]&#10;    WHEN &apos;Platform&apos; THEN [country_brand]&#10;    ELSE [wallet_account_type]&#10;END' />
      </column>
      <column caption='Wallet Order Share' datatype='real' name='[Calculation_1822057945794187264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([type] = &apos;Wallet Order&apos;, [transaction_cnt], 0)) /&#10;SUM(IIF([type] = &apos;Platform&apos;, [transaction_cnt], 0))' />
      </column>
      <column caption='Available Balance' datatype='real' name='[Calculation_1822057945801564164]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [date] = { FIXED : MAX(IF [date] &lt;= {MAX([date])} THEN [date] END) }&#10;THEN [Calculation_2483524139630927873]&#10;END' />
      </column>
      <column caption='Balance Breakdown' datatype='string' name='[Calculation_1822057945805393927]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &apos;Overall&apos; THEN &apos;Overall&apos;&#10;    WHEN &apos;Funds Source&apos; THEN [funds_source]&#10;    WHEN &apos;Platform&apos; THEN [country_brand]&#10;    ELSE [wallet_account_type]&#10;END' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_2483524139630927873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5] WHEN &apos;Euro&apos; THEN [amount_eur] ELSE [amount_lc] END' />
      </column>
      <column caption='Timeframe' datatype='string' name='[Calculation_2483524139631063042]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Daily&apos; THEN STR(Day([date]))+&apos; &apos;+LEFT(DATENAME(&apos;month&apos;,[date]),3) +&apos; &apos;+RIGHT(DATENAME(&apos;year&apos;,[date]),2)&#10;    WHEN &apos;Weekly&apos; THEN &apos;week&apos;+&apos; &apos;+STR(DATEPART(&apos;iso-week&apos;,[date])) +&apos; &apos;+STR(YEAR([date]))&#10;    WHEN &apos;Monthly&apos; THEN LEFT(DATENAME(&apos;month&apos;,[date]),3)+&apos; &apos;+STR(YEAR([date]))&#10;    WHEN &apos;Quarterly&apos; THEN (&quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [date])) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [date])))&#10;    WHEN &apos;Yearly&apos; THEN STR(DATEPART(&apos;year&apos;, [date]))&#10;END' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_2724114878395219968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2483524139630927873])/SUM([transaction_cnt])' />
      </column>
      <column caption='Wallet Order Average Value' datatype='real' name='[Calculation_2724114878418001921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([subtype] = &apos;Wallet Order&apos;, [Calculation_2483524139630927873], 0))/SUM(IIF([subtype] = &apos;Wallet Order&apos;, [transaction_cnt], 0))' />
      </column>
      <column caption='Metric' datatype='real' name='[Calculation_2724114880898994181]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;    WHEN &apos;GMV&apos; THEN [Wallet GMV Share (copy)_5731745375833690113]&#10;    WHEN &apos;Orders&apos; THEN [Wallet GMV (copy)_5731745375841947650]&#10;    WHEN &apos;AOV&apos; THEN [Calculation_2724114878395219968]&#10;END' />
      </column>
      <column caption='Closing Balance' datatype='real' name='[Calculation_2724114880905920519]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [date] = &#10;   { FIXED &#10;     CASE [Parameters].[Parameter 4]&#10;       WHEN &apos;Daily&apos; THEN [date]&#10;       WHEN &apos;Weekly&apos; THEN DATEADD(&apos;day&apos;, 1 - DATEPART(&apos;weekday&apos;, [date]), [date])&#10;       WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;, [date])&#10;       WHEN &apos;Quarterly&apos; THEN DATETRUNC(&apos;quarter&apos;, [date])&#10;       WHEN &apos;Yearly&apos; THEN DATETRUNC(&apos;year&apos;, [date])&#10;     END &#10;   : MAX([date]) &#10;   }&#10;THEN [Calculation_2483524139630927873]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Earliest Date in Period' datatype='date' name='[Calculation_2724114880922980361]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [Parameters].[Parameter 4], &#10;        CASE [Parameters].[Parameter 4]&#10;            WHEN &apos;Daily&apos; THEN [date]&#10;            WHEN &apos;Weekly&apos; THEN DATEADD(&apos;day&apos;, 1 - DATEPART(&apos;weekday&apos;, [date]), [date])&#10;            WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;, [date])&#10;            WHEN &apos;Quarterly&apos; THEN DATETRUNC(&apos;quarter&apos;, [date])&#10;            WHEN &apos;Yearly&apos; THEN DATETRUNC(&apos;year&apos;, [date])&#10;        END : MIN([date]) }' />
      </column>
      <column caption='Is earliest date' datatype='boolean' name='[Calculation_2724114880923164682]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='date = [Calculation_2724114880922980361]' />
      </column>
      <column caption='Monthly - Quarterly Label' datatype='real' name='[Calculation_2827134723879477248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Weekly&apos; THEN [Calculation_2724114880898994181]&#10;    WHEN &apos;Monthly&apos; THEN [Calculation_2724114880898994181]&#10;    WHEN &apos;Quarterly&apos; THEN [Calculation_2724114880898994181]&#10;    WHEN &apos;Yearly&apos; THEN [Calculation_2724114880898994181]&#10;END' />
      </column>
      <column caption='Breakdown Colour' datatype='string' name='[Calculation_3305501446705754115]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;    WHEN &apos;Overall&apos; THEN &apos;Overall&apos;&#10;    WHEN &apos;Attribution&apos; THEN [wallet_account_type]&#10;    WHEN &apos;Platform&apos; THEN [country_brand]&#10;END' />
      </column>
      <column caption='Currency String' datatype='string' name='[Calculation_4622593225193877504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5] WHEN &apos;Euro&apos; THEN &apos;€&apos; ELSE &apos;LC&apos; END' />
      </column>
      <column caption='Date Range String' datatype='string' name='[Calculation_4622593225195364353]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(DAY(MIN([date])))+&quot;/&quot;+&#10;STR(MONTH(MIN([date])))+&quot;/&quot;+&#10;STR(YEAR(MIN([date])))+&quot; to &quot;+&#10;STR(DAY(MAX([date])))+&quot;/&quot;+&#10;STR(MONTH(MAX([date])))+&quot;/&quot;+&#10;STR(YEAR(MAX([date])))' />
      </column>
      <column caption='Currency String - Metric selector' datatype='string' name='[Currency String (copy)_5731745375843426309]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7] &#10;    WHEN &apos;GMV&apos; THEN&#10;    CASE [Parameters].[Parameter 5] &#10;        WHEN &apos;Euro&apos; THEN &apos;€&apos; &#10;        ELSE &apos;LC&apos; &#10;    END&#10;    ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='Date - for last 2 quarters filter' datatype='date' name='[Date (copy)_2724114879440089091]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[date]' />
