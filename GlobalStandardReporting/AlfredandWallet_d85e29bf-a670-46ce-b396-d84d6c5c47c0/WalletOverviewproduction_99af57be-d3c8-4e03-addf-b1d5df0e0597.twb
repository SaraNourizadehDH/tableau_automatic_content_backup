            <column caption='Funds Breakdown' datatype='string' name='[Balance View By (copy)_2052937800729653249]' param-domain-type='list' role='measure' type='nominal' value='&quot;Funds Source&quot;'>
              <calculation class='tableau' formula='&quot;Funds Source&quot;' />
            </column>
