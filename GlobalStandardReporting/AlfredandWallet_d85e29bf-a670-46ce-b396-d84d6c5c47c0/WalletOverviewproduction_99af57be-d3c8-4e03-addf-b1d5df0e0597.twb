    <worksheet name='daily_by_metric'>
      <table>
        <view>
          <datasources>
            <datasource caption='rl_wallet_volumes_daily (rl_fintech)' name='federated.0iphkdw1hykzx716casef00amdka' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Timeframe Selector' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Currency Selector' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
            <column caption='Metric' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
              <calculation class='tableau' formula='&quot;Orders&quot;' />
            </column>
            <column caption='GMV-Orders Breakdown' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;Overall&quot;'>
              <calculation class='tableau' formula='&quot;Overall&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0iphkdw1hykzx716casef00amdka'>
            <column caption='Wallet Order Share' datatype='real' name='[Calculation_1822057945794187264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([type] = &apos;Wallet Order&apos;, [transaction_cnt], 0)) /&#10;SUM(IIF([type] = &apos;Platform&apos;, [transaction_cnt], 0))' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_2483524139630927873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5] WHEN &apos;Euro&apos; THEN [amount_eur] ELSE [amount_lc] END' />
            </column>
            <column caption='Timeframe' datatype='string' name='[Calculation_2483524139631063042]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Daily&apos; THEN STR(Day([date]))+&apos; &apos;+LEFT(DATENAME(&apos;month&apos;,[date]),3) +&apos; &apos;+RIGHT(DATENAME(&apos;year&apos;,[date]),2)&#10;    WHEN &apos;Weekly&apos; THEN &apos;week&apos;+&apos; &apos;+STR(DATEPART(&apos;iso-week&apos;,[date])) +&apos; &apos;+STR(YEAR([date]))&#10;    WHEN &apos;Monthly&apos; THEN LEFT(DATENAME(&apos;month&apos;,[date]),3)+&apos; &apos;+STR(YEAR([date]))&#10;    WHEN &apos;Quarterly&apos; THEN (&quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [date])) + &quot; &quot; + STR(DATEPART(&apos;year&apos;, [date])))&#10;    WHEN &apos;Yearly&apos; THEN STR(DATEPART(&apos;year&apos;, [date]))&#10;END' />
            </column>
            <column caption='AOV' datatype='real' name='[Calculation_2724114878395219968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2483524139630927873])/SUM([transaction_cnt])' />
            </column>
            <column caption='Metric' datatype='real' name='[Calculation_2724114880898994181]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;    WHEN &apos;GMV&apos; THEN [Wallet GMV Share (copy)_5731745375833690113]&#10;    WHEN &apos;Orders&apos; THEN [Wallet GMV (copy)_5731745375841947650]&#10;    WHEN &apos;AOV&apos; THEN [Calculation_2724114878395219968]&#10;END' />
            </column>
            <column caption='Monthly - Quarterly Label' datatype='real' name='[Calculation_2827134723879477248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;    WHEN &apos;Weekly&apos; THEN [Calculation_2724114880898994181]&#10;    WHEN &apos;Monthly&apos; THEN [Calculation_2724114880898994181]&#10;    WHEN &apos;Quarterly&apos; THEN [Calculation_2724114880898994181]&#10;    WHEN &apos;Yearly&apos; THEN [Calculation_2724114880898994181]&#10;END' />
            </column>
            <column caption='Breakdown Colour' datatype='string' name='[Calculation_3305501446705754115]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;    WHEN &apos;Overall&apos; THEN &apos;Overall&apos;&#10;    WHEN &apos;Attribution&apos; THEN [wallet_account_type]&#10;    WHEN &apos;Platform&apos; THEN [country_brand]&#10;END' />
            </column>
            <column caption='Currency String' datatype='string' name='[Calculation_4622593225193877504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5] WHEN &apos;Euro&apos; THEN &apos;€&apos; ELSE &apos;LC&apos; END' />
            </column>
            <column caption='Currency String - Metric selector' datatype='string' name='[Currency String (copy)_5731745375843426309]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7] &#10;    WHEN &apos;GMV&apos; THEN&#10;    CASE [Parameters].[Parameter 5] &#10;        WHEN &apos;Euro&apos; THEN &apos;€&apos; &#10;        ELSE &apos;LC&apos; &#10;    END&#10;    ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Share Metric' datatype='real' name='[Metric (copy)_2724114880902905862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;    WHEN &apos;GMV&apos; THEN [Wallet Order Share (copy)_1822057946175262728]&#10;    WHEN &apos;Orders&apos; THEN [Calculation_1822057945794187264]&#10;    WHEN &apos;AOV&apos; THEN [Calculation_2724114878395219968]&#10;END' />
            </column>
            <column caption='Platform GMV' datatype='real' name='[Platform Orders (copy)_5731745375842365444]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([type] = &apos;Platform&apos;, [Calculation_2483524139630927873], 0))' />
            </column>
            <column caption='Wallet Orders' datatype='integer' name='[Wallet GMV (copy)_5731745375841947650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;    WHEN &apos;Attribution&apos; THEN SUM(IIF([type] = &apos;Wallet Order&apos; AND [subtype] = &apos;Purchase Attribution&apos;, [transaction_cnt], 0))&#10;    ELSE SUM(IIF([type] = &apos;Wallet Order&apos; AND [subtype] = &apos;Wallet Order&apos;, [transaction_cnt], 0))&#10;END' />
            </column>
            <column caption='Wallet GMV' datatype='real' name='[Wallet GMV Share (copy)_5731745375833690113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([type] = &apos;Wallet Order&apos; AND [subtype] = &apos;Purchase Attribution&apos;, [Calculation_2483524139630927873], 0))' />
            </column>
            <column caption='Wallet GMV Share' datatype='real' name='[Wallet Order Share (copy)_1822057946175262728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([type] = &apos;Wallet Order&apos;, [Calculation_2483524139630927873], 0)) /&#10;SUM(IIF([type] = &apos;Platform&apos;, [Calculation_2483524139630927873], 0))' />
            </column>
            <column caption='Platform Orders' datatype='integer' name='[Wallet Order Share (copy)_5731745375842299907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([type] = &apos;Platform&apos;, [transaction_cnt], 0))' />
            </column>
            <column caption='Amount Eur' datatype='real' name='[amount_eur]' role='measure' type='quantitative' />
            <column caption='Amount Lc' datatype='real' name='[amount_lc]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3305501446705754115]' derivation='Attribute' name='[attr:Calculation_3305501446705754115:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4622593225193877504]' derivation='Attribute' name='[attr:Calculation_4622593225193877504:nk]' pivot='key' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Country Brand' datatype='string' name='[country_brand]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
