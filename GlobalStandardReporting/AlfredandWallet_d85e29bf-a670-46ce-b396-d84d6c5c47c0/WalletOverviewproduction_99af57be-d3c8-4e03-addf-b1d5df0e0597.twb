    <worksheet name='ge_summary_adoption_rate'>
      <table>
        <view>
          <datasources>
            <datasource caption='rl_wallet_growth_customers (rl_fintech)' name='federated.0rrbr320rchhy315panzb0j20pgy' />
            <datasource caption='rl_platform_data (rl_fintech)' name='federated.1cco4ir1rctzwh1djzlbo02sebu8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Month' datatype='date' default-format='*(Qqq) mmmm yyyy' name='[Order Date Parameter]' param-domain-type='list' role='measure' type='quantitative' value='#2024-09-01#'>
              <calculation class='tableau' formula='#2024-09-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0rrbr320rchhy315panzb0j20pgy'>
            <column caption='customer count (excluding churn)' datatype='integer' name='[Calculation_5156551265775263745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF segment != &apos;churn&apos; THEN [customer_cnt] END' />
            </column>
            <column caption='is selected month' datatype='boolean' name='[Calculation_5156551265796190214]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Order Date Parameter] = [purchase_month] THEN true ELSE false END' />
            </column>
            <column caption='new customer count' datatype='integer' name='[Calculation_5289759302105481217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if segment = &apos;new customer&apos; then [Calculation_5156551265775263745] end' />
            </column>
            <column caption='adoption rate - previous month' datatype='real' name='[adoption rate - selected month (copy)_5289759302106759175]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([new customer count - selected month (copy)_5289759302105776131])/SUM([federated.1cco4ir1rctzwh1djzlbo02sebu8].[New platform customer - Selected month (copy)_5289759302106427398])' />
            </column>
            <column caption='adoption rate - diff pp' datatype='real' name='[churn rate - diff pp  (copy)_5289759302106976264]' role='measure' type='quantitative'>
