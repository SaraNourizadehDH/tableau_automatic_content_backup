            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='is previous month' datatype='boolean' name='[is selected month (copy)_5156551265798938631]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEADD(&apos;month&apos;,-1,[Parameters].[Order Date Parameter]) = [purchase_month] THEN true ELSE false END' />
