          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Month' datatype='date' default-format='*(Qqq) mmmm yyyy' name='[Order Date Parameter]' param-domain-type='list' role='measure' type='quantitative' value='#2024-09-01#'>
              <calculation class='tableau' formula='#2024-09-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.077698b0tktnj81ahgq3r08djx94'>
            <column caption='creation date' datatype='date' name='[Calculation_5742793234937274368]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [timeframe] = &apos;month&apos; THEN&#10;    DATE( LEFT([creation_month], 4) + &quot;-&quot; + RIGHT([creation_month], 2) + &quot;-01&quot; )&#10;ELSEIF [timeframe] = &apos;quarter&apos; THEN&#10;    DATE( LEFT([creation_month], 4) + &quot;-&quot; + &#10;          IF (INT(RIGHT([creation_month], 2)) * 3 - 2) &lt; 10 THEN &#10;              &quot;0&quot; + STR(INT(RIGHT([creation_month], 2)) * 3 - 2)&#10;          ELSE &#10;              STR(INT(RIGHT([creation_month], 2)) * 3 - 2)&#10;          END + &quot;-01&quot; )&#10;END' />
            </column>
            <column caption='wallet trx - selected month' datatype='integer' name='[Calculation_5742793234940342275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([is selected month - gmv (copy)_5742793234950606858],[order_cnt],Null)' />
            </column>
            <column caption='AOV Eur' datatype='real' name='[Calculation_5742793234948255750]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_eur])/sum([order_cnt])' />
            </column>
            <column caption='period - graphs' datatype='integer' name='[Calculation_6575396227074809861]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [timeframe] = &apos;month&apos; THEN&#10;    (DATEPART(&apos;year&apos;, [Calculation_5742793234937274368]) * 100) + DATEPART(&apos;month&apos;, [Calculation_5742793234937274368])&#10;ELSEIF [timeframe] = &apos;quarter&apos; THEN&#10;    (DATEPART(&apos;year&apos;, [Calculation_5742793234937274368]) * 100) + (DATEPART(&apos;quarter&apos;, [Calculation_5742793234937274368]) + 10)  &#10;END' />
            </column>
            <column-instance column='[Calculation_6575396227074809861]' derivation='Attribute' name='[attr:Calculation_6575396227074809861:qk]' pivot='key' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Country Brand' datatype='string' name='[country_brand]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Creation Month' datatype='string' name='[creation_month]' role='dimension' type='nominal' />
            <column caption='Event Subtype' datatype='string' name='[event_subtype]' role='dimension' type='nominal' />
            <column caption='Event Type' datatype='string' name='[event_type]' role='dimension' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Gmv Eur' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column caption='is selected period - order' datatype='boolean' name='[is selected month - gmv (copy)_5742793234950606858]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [timeframe] = &apos;month&apos; then [Parameters].[Order Date Parameter]=[Calculation_5742793234937274368]&#10;elseif [timeframe] = &apos;quarter&apos; then DATETRUNC(&apos;quarter&apos;,[Parameters].[Order Date Parameter]) = DATETRUNC(&apos;quarter&apos;,[Calculation_5742793234937274368])&#10;end' />
            </column>
            <column caption='is selected period - aov' datatype='boolean' name='[is selected month - user (copy)_5742793234950967308]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [timeframe] = &apos;month&apos; then [Parameters].[Order Date Parameter]=[Calculation_5742793234937274368]&#10;elseif [timeframe] = &apos;quarter&apos; then DATETRUNC(&apos;quarter&apos;,[Parameters].[Order Date Parameter]) = DATETRUNC(&apos;quarter&apos;,[Calculation_5742793234937274368])&#10;end' />
