              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
            <column caption='Currency Selector' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
            <column caption='Balance Breakdown' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Funds Source&quot;'>
              <calculation class='tableau' formula='&quot;Funds Source&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0iphkdw1hykzx716casef00amdka'>
            <column caption='Available Balance' datatype='real' name='[Calculation_1822057945801564164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [date] = { FIXED : MAX(IF [date] &lt;= {MAX([date])} THEN [date] END) }&#10;THEN [Calculation_2483524139630927873]&#10;END' />
            </column>
            <column caption='Balance Breakdown' datatype='string' name='[Calculation_1822057945805393927]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &apos;Overall&apos; THEN &apos;Overall&apos;&#10;    WHEN &apos;Funds Source&apos; THEN [funds_source]&#10;    WHEN &apos;Platform&apos; THEN [country_brand]&#10;    ELSE [wallet_account_type]&#10;END' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_2483524139630927873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5] WHEN &apos;Euro&apos; THEN [amount_eur] ELSE [amount_lc] END' />
            </column>
            <column caption='Closing Balance' datatype='real' name='[Calculation_2724114880905920519]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [date] = &#10;   { FIXED &#10;     CASE [Parameters].[Parameter 4]&#10;       WHEN &apos;Daily&apos; THEN [date]&#10;       WHEN &apos;Weekly&apos; THEN DATEADD(&apos;day&apos;, 1 - DATEPART(&apos;weekday&apos;, [date]), [date])&#10;       WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;, [date])&#10;       WHEN &apos;Quarterly&apos; THEN DATETRUNC(&apos;quarter&apos;, [date])&#10;       WHEN &apos;Yearly&apos; THEN DATETRUNC(&apos;year&apos;, [date])&#10;     END &#10;   : MAX([date]) &#10;   }&#10;THEN [Calculation_2483524139630927873]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Currency String' datatype='string' name='[Calculation_4622593225193877504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5] WHEN &apos;Euro&apos; THEN &apos;€&apos; ELSE &apos;LC&apos; END' />
            </column>
            <column caption='Date Range String - Balance' datatype='string' name='[Date Range String (copy)_1822057945801474051]' role='measure' type='nominal'>
              <calculation class='tableau' formula='&quot;On &quot;+&#10;STR(DAY(MAX([date])))+&quot;/&quot;+&#10;STR(MONTH(MAX([date])))+&quot;/&quot;+&#10;STR(YEAR(MAX([date])))' />
