            <run fontcolor='#707070' fontsize='10'>Fintech Data Analytics Team - email: </run>
            <run fontcolor='#707070' fontsize='10' underline='true'>fintech_product_analytics@deliveryhero.com</run>
            <run fontcolor='#707070' fontsize='10'> - slack: </run>
