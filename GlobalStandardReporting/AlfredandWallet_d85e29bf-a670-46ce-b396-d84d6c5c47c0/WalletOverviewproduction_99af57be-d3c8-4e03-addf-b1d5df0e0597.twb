    <worksheet name='ge_sourced'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>How are active customers being sourced? </run>
            <run>Æ&#10;</run>
            <run fontcolor='#555555' fontsize='8' italic='true'>* Pressing the category will filter the &quot;Wallet preferences by event type&quot; graph</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rl_wallet_growth_customers (rl_fintech)' name='federated.0rrbr320rchhy315panzb0j20pgy' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Month' datatype='date' default-format='*(Qqq) mmmm yyyy' name='[Order Date Parameter]' param-domain-type='list' role='measure' type='quantitative' value='#2024-09-01#'>
              <calculation class='tableau' formula='#2024-09-01#' />
            </column>
            <column caption='Currency Selector' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0rrbr320rchhy315panzb0j20pgy'>
            <column caption='AOV' datatype='real' default-format='n#,##0.00&quot;€&quot;;-#,##0.00&quot;€&quot;' name='[AOF (copy)_5156551266867146786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_5156551266866409499])/sum([order_cnt])' />
            </column>
            <column caption='currency selector symbol' datatype='string' name='[Calculation_225602256431136771]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Euro&apos; then &apos;€&apos; else &apos;&apos; END' />
            </column>
            <column caption='customer count (excluding churn)' datatype='integer' name='[Calculation_5156551265775263745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF segment != &apos;churn&apos; THEN [customer_cnt] END' />
            </column>
            <column caption='AOF' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5156551265775673347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_cnt])/sum([Calculation_5156551265775263745])' />
            </column>
            <column caption='is selected month' datatype='boolean' name='[Calculation_5156551265796190214]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Order Date Parameter] = [purchase_month] THEN true ELSE false END' />
            </column>
            <column caption='gmv currency' datatype='real' name='[Calculation_5156551266866409499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 5] = &apos;Euro&apos; then [gmv_eur]&#10;elseif [Parameters].[Parameter 5] = &apos;Local Currency&apos; then [gmv_lc]&#10;end' />
            </column>
            <column caption='Customer Cnt' datatype='integer' name='[customer_cnt]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[gmv_lc]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_225602256431136771]' derivation='None' name='[none:Calculation_225602256431136771:nk]' pivot='key' type='nominal' />
