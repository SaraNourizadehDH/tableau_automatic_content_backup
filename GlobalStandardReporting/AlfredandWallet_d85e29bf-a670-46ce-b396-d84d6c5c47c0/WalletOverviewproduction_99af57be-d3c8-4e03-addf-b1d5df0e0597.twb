            <column caption='Wallet AOF - diff %' datatype='real' name='[Platform AOF - diff % (copy)_3154419720412102705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Platform AOF - Selected month (copy)_3154419720401973290]/[Wallet AOF - Selected month (copy)_3154419720411271215]-1' />
            </column>
            <column caption='Platform customer - Previous month' datatype='integer' name='[Platform gmv - Previous month (copy)_3154419720394235939]' role='measure' type='quantitative'>
