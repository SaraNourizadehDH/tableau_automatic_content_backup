    <worksheet name='ge_kpi_graph'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'># active customers by selection</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rl_wallet_growth_customers (rl_fintech)' name='federated.0rrbr320rchhy315panzb0j20pgy' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Active Customers' caption='KPI selection' datatype='real' name='[Parameter 10]' param-domain-type='list' role='measure' type='quantitative' value='1.'>
              <calculation class='tableau' formula='1.' />
              <aliases>
                <alias key='1.' value='Active Customers' />
                <alias key='2.' value='AOF' />
                <alias key='3.' value='AOV' />
              </aliases>
            </column>
            <column caption='Currency Selector' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
            <column alias='Most Event Type' caption='Selection' datatype='real' name='[Parameter 9]' param-domain-type='list' role='measure' type='quantitative' value='4.'>
              <calculation class='tableau' formula='4.' />
              <aliases>
                <alias key='1.' value='Total' />
                <alias key='2.' value='Sourced' />
                <alias key='3.' value='Event Type' />
                <alias key='4.' value='Most Event Type' />
                <alias key='5.' value='Segment' />
                <alias key='6.' value='Wallet Penetration' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0rrbr320rchhy315panzb0j20pgy'>
            <column caption='AOV' datatype='real' default-format='n#,##0.00&quot;€&quot;;-#,##0.00&quot;€&quot;' name='[AOF (copy)_5156551266867146786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_5156551266866409499])/sum([order_cnt])' />
            </column>
            <column caption='purchase_month_axis' datatype='string' name='[Calculation_225602256411176961]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(LEFT(DATENAME(&apos;month&apos;,[purchase_month]),3))+&apos; &apos;+STR(YEAR([purchase_month]))' />
            </column>
            <column caption='wallet mix penetration' datatype='string' name='[Calculation_3749176384745271302]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [product_interaction] = 1 then &apos;1 product&apos;&#10;elseif [product_interaction] &gt; 1 then str([product_interaction]) + &apos; products&apos;&#10;else &apos;1 product&apos;&#10;end' />
            </column>
            <column caption='current month (T/F)' datatype='boolean' name='[Calculation_3806104700532121607]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [purchase_month] = DATETRUNC(&apos;month&apos;,now()) then true else false end' />
            </column>
            <column caption='customer count (excluding churn)' datatype='integer' name='[Calculation_5156551265775263745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF segment != &apos;churn&apos; THEN [customer_cnt] END' />
            </column>
            <column caption='AOF' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5156551265775673347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_cnt])/sum([Calculation_5156551265775263745])' />
            </column>
            <column caption='Selection selector' datatype='string' name='[Calculation_5156551266806435858]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 9] = 1 then &apos;Total&apos;&#10;elseif [Parameters].[Parameter 9] = 2 then [sourced_category]&#10;elseif [Parameters].[Parameter 9] = 3 then [sourced_event_type]&#10;elseif [Parameters].[Parameter 9] = 4 then [mostly_event_type]&#10;elseif [Parameters].[Parameter 9] = 5 then [segment]&#10;elseif [Parameters].[Parameter 9] = 6 then [Calculation_3749176384745271302]&#10;end' />
              <aliases>
                <alias key='&quot;reactivated customer&quot;' value='recovered churned users' />
              </aliases>
            </column>
            <column caption='KPI selection selector' datatype='real' name='[Calculation_5156551266808541203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 10] = 1 then sum([Calculation_5156551265775263745])&#10;elseif [Parameters].[Parameter 10] = 2 then round([Calculation_5156551265775673347],2)&#10;elseif [Parameters].[Parameter 10] = 3 then round([AOF (copy)_5156551266867146786],2)&#10;end' />
            </column>
            <column caption='gmv currency' datatype='real' name='[Calculation_5156551266866409499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 5] = &apos;Euro&apos; then [gmv_eur]&#10;elseif [Parameters].[Parameter 5] = &apos;Local Currency&apos; then [gmv_lc]&#10;end' />
            </column>
            <column caption='Customer Cnt' datatype='integer' name='[customer_cnt]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[gmv_lc]' role='measure' type='quantitative' />
            <column-instance column='[purchase_month]' derivation='Max' name='[max:purchase_month:qk]' pivot='key' type='quantitative' />
            <column caption='Mostly Event Type' datatype='string' name='[mostly_event_type]' role='dimension' type='nominal' />
