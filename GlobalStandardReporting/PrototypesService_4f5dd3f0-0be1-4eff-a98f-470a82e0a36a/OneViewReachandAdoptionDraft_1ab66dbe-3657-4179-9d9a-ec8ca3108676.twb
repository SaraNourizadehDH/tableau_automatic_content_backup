      <column caption='% Action Stickiness' datatype='real' name='[Calculation_5543438605144940546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [agent_email], [Calculation_1668865158819282949]: SUM([work_items_w_oneview_action_count])}&#10;/&#10;{ FIXED [agent_email], [Calculation_1668865158819282949]: SUM([total_work_items])}' />
