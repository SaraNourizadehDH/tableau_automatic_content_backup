    <worksheet name='Funnel Step Influencers per dimension (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run><![CDATA[ <[Parameters].[Parameter 3]> Influencers per <[Parameters].[Parameter 2]> and <[Parameters].[Select 1st Dimension (copy)_835980702928535554]>
]]></run>
            <run fontcolor='#898989' fontsize='10'>What drives OneView adoption per funnel step and selected dimention(s)?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='oneview_reach_and_adoption sandbox_draft' name='federated.0zz4t6a0n7mnzb19p7pb90wjry93' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
            <column caption='Select 1st Dimension' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Global&quot;'>
              <calculation class='tableau' formula='&quot;Global&quot;' />
            </column>
            <column caption='Select Funnel Step' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Reach&quot;'>
              <calculation class='tableau' formula='&quot;Reach&quot;' />
            </column>
            <column caption='Select 2nd Dimension' datatype='string' name='[Select 1st Dimension (copy)_835980702928535554]' param-domain-type='list' role='measure' type='nominal' value='&quot;Contact Reason 2&quot;'>
              <calculation class='tableau' formula='&quot;Contact Reason 2&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zz4t6a0n7mnzb19p7pb90wjry93'>
            <column caption=' % Agents with multi Work Items with Activity' datatype='real' name='[ % at Least One Work Item with Activity (copy)_1668865158815813634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [work_items_w_oneview_activity_count]&gt;1 THEN [agent_email] END)&#13;&#10;/ &#13;&#10;COUNTD([agent_email])' />
            </column>
            <column caption=' % Agents with at Least One Work Item with Action' datatype='real' name='[ % at Least One Work Item with Activity (copy)_1668865158815989763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [work_items_w_oneview_action_count]&gt;0 THEN [agent_email] END)&#13;&#10;/ &#13;&#10;COUNTD([agent_email])' />
            </column>
            <column caption='% Agents with multi Work Items with Action' datatype='real' name='[ % multi Work Items with Activity (copy)_1668865158816133124]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [work_items_w_oneview_action_count]&gt;1 THEN [agent_email] END)&#13;&#10;/ &#13;&#10;COUNTD([agent_email])' />
            </column>
            <column caption='2nd Dimension' datatype='string' name='[1st Dimension (copy)_835980702933581830]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Select 1st Dimension (copy)_835980702928535554]&#13;&#10;WHEN &quot;Global&quot; Then [Calculation_610026676822482944]&#13;&#10;WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;WHEN &quot;Stakeholder&quot; THEN [stakeholder]&#13;&#10;WHEN &quot;Contact Center&quot; THEN [contact_center]&#13;&#10;WHEN &quot;Contact Reason 1&quot; THEN [contact_reason_l1]&#10;WHEN &quot;Contact Reason 2&quot; THEN [contact_reason_l2]&#10;WHEN &quot;Contact Reason 3&quot; THEN [contact_reason_l3]&#13;&#10;WHEN &quot;CRM App&quot; THEN [crm_app]&#13;&#10;WHEN &quot;Is BPO&quot; THEN STR([is_bpo])&#13;&#10;WHEN &quot;Volume Tenure&quot; THEN [volume_tenure_bins]&#13;&#10;WHEN &quot;Channel&quot; THEN [channel]&#13;&#10;END' />
            </column>
            <column caption='Relative Date' datatype='date' datatype-customized='true' name='[Assignment Date (copy)_917326972339048448]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[assignment_date]' />
            </column>
            <column caption='% Agents with OneView Work Items (Reach)' datatype='real' name='[Calculation_1668865158814986240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [work_items_w_oneview_count]&gt;0 THEN [agent_email] END)&#13;&#10;/ &#13;&#10;COUNTD([agent_email])' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_1668865158819282949]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Day&quot; THEN STR([assignment_date])&#13;&#10;WHEN &quot;Week&quot; THEN STR([assignment_week])&#13;&#10;WHEN &quot;Month&quot; THEN STR([assignment_month])&#13;&#10;END' />
            </column>
            <column caption='Global' datatype='string' name='[Calculation_610026676822482944]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Global&apos;' />
            </column>
            <column caption='1st Dimension' datatype='string' name='[Calculation_835980702929907716]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Global&quot; THEN [Calculation_610026676822482944]&#10;WHEN &quot;Management Entity&quot; THEN [management_entity]&#10;WHEN &quot;Stakeholder&quot; THEN [stakeholder]&#10;WHEN &quot;Contact Center&quot; THEN [contact_center]&#10;WHEN &quot;Contact Reason 1&quot; THEN [contact_reason_l1]&#10;WHEN &quot;Contact Reason 2&quot; THEN [contact_reason_l2]&#10;WHEN &quot;Contact Reason 3&quot; THEN [contact_reason_l3]&#10;WHEN &quot;CRM App&quot; THEN [crm_app]&#10;WHEN &quot;Is BPO&quot; THEN STR([is_bpo])&#10;WHEN &quot;Volume Tenure&quot; THEN [volume_tenure_bins]&#10;WHEN &quot;Channel&quot; THEN [channel]&#10;END' />
            </column>
            <column caption='Funnel Step' datatype='real' name='[Calculation_835980702933250053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 3] = &apos;Reach&apos; then [Calculation_1668865158814986240]&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Adoption - activity in at least one work item&apos; then [OneView Work Items % (copy)_1668865158815408129]&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Adoption - activity in multi work items&apos; then [ % at Least One Work Item with Activity (copy)_1668865158815813634]&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Adoption - action in at least one work item&apos; then [ % at Least One Work Item with Activity (copy)_1668865158815989763]&#13;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Adoption - action in multi work items&apos; then [ % multi Work Items with Activity (copy)_1668865158816133124]&#13;&#10;END&#13;&#10;&#13;&#10;//Adoption - activity in at least one work item' />
            </column>
            <column caption='Metric Influencers' datatype='real' name='[Calculation_835980703086141447]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_835980702933250053] - MAX({ FIXED [Calculation_1668865158819282949] : [Calculation_835980702933250053]}))&#13;&#10;*&#13;&#10;(SUM([total_work_items])/MAX({ FIXED [Calculation_1668865158819282949] : SUM([total_work_items])}))&#13;&#10;&#13;&#10;//([% Reach] - MAX({ FIXED [Date Granularity] : SUM([Ov Contact Count])/IFNULL(SUM([Contact Count]),1)}))&#13;&#10;//*&#13;&#10;//(SUM([Contact Count])/MAX({ FIXED [Date Granularity] : SUM([Contact Count])}))' />
            </column>
            <column caption=' % Agents with  at Least One Work Item with Activity' datatype='real' name='[OneView Work Items % (copy)_1668865158815408129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [work_items_w_oneview_activity_count]&gt;0 THEN [agent_email] END)&#13;&#10;/ &#13;&#10;COUNTD([agent_email])' />
            </column>
            <column caption='Agent Email' datatype='string' name='[agent_email]' role='dimension' type='nominal' />
            <column aggregation='Count' caption='Assignment Date' datatype='date' datatype-customized='true' name='[assignment_date]' role='dimension' type='ordinal' />
