                <zone forceUpdate='true' h='20050' id='11' type-v2='text' w='35138' x='14862' y='1009'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Tableau Regular' fontsize='20'>Oneview General Reach and Adoption</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#898989' fontname='Tableau Regular' fontsize='16'>Reach and adoption funnel and its evolution</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#ffffff' />
                  </zone-style>
                </zone>
                <zone custom-title='true' h='6683' id='30' mode='compact' param='[Parameters].[Parameter 1]' type-v2='paramctrl' w='12372' x='50000' y='1009'>
                  <formatted-text>
                    <run fontalignment='0' fontcolor='#000000'>Date  Granularity</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='76' forceUpdate='true' h='15133' id='18' type-v2='text' w='49414' x='586' y='21059'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Tableau Book' italic='true'>Definitions and limitations</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Book' italic='true'>1/ Work items are counted on date of assignment</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Book' italic='true'>2/ OneView activities happened before a work item is assigned or after it&apos;s resolved are disregarded</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Book' italic='true'>3/ </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Book' italic='true'>Activities</run>
                    <run fontcolor='#000000' fontname='Tableau Book' italic='true'> are any (tracked) &quot;conscious&quot; agent interactions with OneView, e.g. click on a tab, cancel order, open rider-customer chat. Activities can have a purpose to look up the data or manipulate the data</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Book' italic='true'>4/ </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Book' italic='true'>Actions</run>
                    <run fontcolor='#000000' fontname='Tableau Book' italic='true'> are activities to manipulate the data, e.g. refund or cancel an order.</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#fefaf1' />
                  </zone-style>
                </zone>
