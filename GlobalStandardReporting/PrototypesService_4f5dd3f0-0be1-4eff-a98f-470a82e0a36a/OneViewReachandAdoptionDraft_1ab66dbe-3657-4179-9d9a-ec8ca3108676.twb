              <zone forceUpdate='true' h='8272' id='24' type-v2='text' w='98682' x='659' y='24998'>
                <formatted-text>
                  <run fontname='Tableau Regular'>1.</run>
                  <run fontcolor='#000000' fontname='Tableau Regular'> % Reach Stickiness </run>
                  <run fontname='Tableau Regular'>=  % of work items (out of all work items)  an agent </run>
                  <run bold='true' fontname='Tableau Regular'>saw on OneView</run>
                  <run>Æ&#10;</run>
                  <run fontname='Tableau Regular'>2. </run>
                  <run fontcolor='#000000' fontname='Tableau Regular'>% Activity Stickiness</run>
                  <run fontname='Tableau Regular'> = % of work items (out of all work items) where an agent had at </run>
                  <run bold='true' fontname='Tableau Regular'>least one activity/interaction on OneView</run>
                  <run>Æ&#10;</run>
                  <run fontname='Tableau Regular'>3. </run>
                  <run fontcolor='#000000' fontname='Tableau Regular'>% Action Stickiness</run>
                  <run fontname='Tableau Regular'> = % of work items (out of all work items)  where an agent had </run>
                  <run bold='true' fontname='Tableau Regular'>at least one action on OneView</run>
                  <run>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#fefaf1' />
