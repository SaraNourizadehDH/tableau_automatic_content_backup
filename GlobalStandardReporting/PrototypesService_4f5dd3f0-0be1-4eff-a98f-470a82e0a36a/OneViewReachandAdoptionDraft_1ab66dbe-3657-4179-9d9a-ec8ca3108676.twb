      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/OneViewReachandAdoptionDraft/StickinessAgentLevel?rev=' id='StickinessAgentLevel' path='/t/GlobalStandardReporting/workbooks/OneViewReachandAdoptionDraft' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#00000000' />
