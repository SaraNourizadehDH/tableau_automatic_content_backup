            </column>
            <column caption='Last Week Label' datatype='string' name='[Calculation_1151514197697335305]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Last &apos;+ [Parameters].[Parameter 1]+&#13;&#10;&apos;[&apos;+[Calculation_677791810075480071]+&apos;]&apos;' />
            </column>
            <column caption='Metric' datatype='real' name='[Calculation_1470425339610685444]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([metric_n])&#13;&#10;/&#13;&#10;IFNULL(SUM([metric_d]),1)' />
            </column>
            <column caption='Selected Date Granularity' datatype='string' name='[Calculation_1470425339613560837]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Date&apos; THEN STR([report_date])&#13;&#10;WHEN &apos;Week&apos; THEN [report_week]&#13;&#10;END' />
            </column>
            <column caption='Metric % Diff (curr - prev) ' datatype='real' default-format='p0%' name='[Calculation_1470425339624062987]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Metric (copy)_1470425339616120839] - [Metric (current period) (copy)_1470425339623428106])&#13;&#10;/&#13;&#10;[Metric (copy)_1470425339616120839]' />
            </column>
            <column caption='Is b/migr on country' datatype='boolean' name='[Calculation_192528949155418112]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [pre_migration_week] &lt;=&#13;&#10;{ FIXED [country_code]: MIN([pre_migration_week])} + 3&#13;&#10;THEN TRUE&#13;&#10;END' />
            </column>
            <column caption='Title X-1' datatype='string' name='[Calculation_677791810075480071]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Week&apos; THEN &apos;W-1&apos;&#13;&#10;WHEN &apos;Date&apos; THEN &apos;D-1&apos;&#13;&#10;END' />
