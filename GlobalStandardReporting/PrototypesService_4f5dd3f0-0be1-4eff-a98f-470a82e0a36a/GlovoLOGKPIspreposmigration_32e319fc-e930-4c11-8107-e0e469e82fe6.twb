    <worksheet name='v2.0 (w2-w7)'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Monitoring</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='glovo_pre_post_kpis_dashboard (sandbox_maria)' name='federated.0saqsdt025w3yw13nimg30xu3qbt' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
            <column caption='Number of Segments' datatype='integer' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='4'>
              <calculation class='tableau' formula='4' />
              <range granularity='1' max='8' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0saqsdt025w3yw13nimg30xu3qbt'>
            <column caption='# days' datatype='integer' name='[# days (copy)_1151514197702254605]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;&#13;&#10;  , { FIXED [country_code] : &#13;&#10;MIN(IF [is_post_migration] &#13;&#10;  AND (NOT [Calculation_192528949155418112] OR ISNULL([Calculation_192528949155418112]))&#13;&#10;THEN [report_date] END)}&#13;&#10;  , [report_date]&#13;&#10;)' />
            </column>
            <column caption='MIN(0)' datatype='integer' name='[Calculation_1151514197686087681]' role='measure' type='quantitative' user:unnamed='v2.0'>
              <calculation class='tableau' formula='MIN(0)' />
            </column>
            <column caption='Empty field' datatype='string' name='[Calculation_1151514197686501378]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;&apos;' />
            </column>
            <column caption='MIN(2)' datatype='integer' name='[Calculation_1151514197699608588]' role='measure' type='quantitative' user:unnamed='v2.0 (w2-w7)'>
              <calculation class='tableau' formula='MIN(2)' />
            </column>
            <column caption='Metric' datatype='real' name='[Calculation_1470425339610685444]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([metric_n])&#13;&#10;/&#13;&#10;IFNULL(SUM([metric_d]),1)' />
            </column>
            <column caption='Selected Date Granularity' datatype='string' name='[Calculation_1470425339613560837]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Date&apos; THEN STR([report_date])&#13;&#10;WHEN &apos;Week&apos; THEN [report_week]&#13;&#10;END' />
            </column>
            <column caption='Is b/migr on country' datatype='boolean' name='[Calculation_192528949155418112]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [pre_migration_week] &lt;=&#13;&#10;{ FIXED [country_code]: MIN([pre_migration_week])} + 3&#13;&#10;THEN TRUE&#13;&#10;END' />
            </column>
            <column caption='Top X Countries' datatype='string' name='[Calculation_677791810086940682]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Country Code Set] &#13;&#10;THEN [country_code]&#13;&#10;ELSE &apos;Other&apos; END' />
            </column>
            <column caption='City Code Excluder' datatype='string' name='[City Code (copy)_1470425339662950418]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <calculation class='tableau' formula='[city_code]' />
            </column>
            <column caption='Is Unfinished  Date Period' datatype='boolean' name='[Is Today (copy)_1470425339625254924]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;Date&apos; THEN [report_date] = TODAY() &#13;&#10;    WHEN &apos;Week&apos; THEN WEEK([report_date]) = WEEK(TODAY()) &#13;&#10;END' />
            </column>
            <column caption='Monitoring Label' datatype='string' name='[Last Week Label (copy)_1151514197698826250]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Monitoring &apos;+ &apos;W2-W7&apos;' />
            </column>
            <column caption='Metric % Diff (curr - b/migr)' datatype='real' default-format='p0%' name='[Metric % Diff (curr - prev)  (copy)_1470425339648901136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Metric (copy)_1470425339616120839] - [Metric (prev period) (copy)_1470425339649110033])&#13;&#10;/&#13;&#10;[Metric (copy)_1470425339616120839]' />
            </column>
            <column caption='Metric (curr period)' datatype='real' default-format='N' name='[Metric (copy)_1470425339616120839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Selected Date Granularity (copy)_1470425339614187526] THEN [metric_n] END)&#13;&#10;/&#13;&#10;IFNULL(SUM(IF [Selected Date Granularity (copy)_1470425339614187526] THEN [metric_d] END),1)' />
            </column>
            <column caption='Metric (curr period formatted)' datatype='real' default-format='N' name='[Metric (curr period) (copy)_303148611279183873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MAX([metric_name]) = &apos;Delivery Time&apos; THEN &#13;&#10;ROUND([Metric (copy)_1470425339616120839], 1)&#13;&#10;ELSEIF MAX([metric_name]) = &apos;% Delivery Over 60 min&apos; THEN&#13;&#10;ROUND([Metric (copy)_1470425339616120839]*100, 1)&#13;&#10;ELSE [Metric (copy)_1470425339616120839]&#13;&#10;END' />
            </column>
            <column caption='Metric (b/migr)' datatype='real' default-format='n#,##0.0000;-#,##0.0000' name='[Metric (prev period) (copy)_1470425339649110033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM(IF [Calculation_192528949155418112] THEN [metric_n] END)&#13;&#10;/&#13;&#10;COUNTD(IF [Calculation_192528949155418112] THEN [Calculation_1470425339613560837] END)&#13;&#10;)&#13;&#10;/&#13;&#10;IFNULL(&#13;&#10;SUM(IF [Calculation_192528949155418112] THEN [metric_d] END)&#13;&#10;/&#13;&#10;COUNTD(IF [Calculation_192528949155418112] THEN [Calculation_1470425339613560837] END)&#13;&#10;,1)' />
            </column>
            <column caption='Is Curr Date Granularity' datatype='boolean' name='[Selected Date Granularity (copy)_1470425339614187526]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1470425339613560837] = { FIXED : MAX([Calculation_1470425339613560837])}' />
            </column>
