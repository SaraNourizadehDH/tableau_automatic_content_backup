          <datasource-dependencies datasource='federated.0saqsdt025w3yw13nimg30xu3qbt'>
            <column caption='# days' datatype='integer' name='[# days (copy)_1151514197702254605]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;&#13;&#10;  , { FIXED [country_code] : &#13;&#10;MIN(IF [is_post_migration] &#13;&#10;  AND (NOT [Calculation_192528949155418112] OR ISNULL([Calculation_192528949155418112]))&#13;&#10;THEN [report_date] END)}&#13;&#10;  , [report_date]&#13;&#10;)' />
            </column>
            <column caption='MIN(0)' datatype='integer' name='[Calculation_1151514197686087681]' role='measure' type='quantitative' user:unnamed='v2.0'>
              <calculation class='tableau' formula='MIN(0)' />
            </column>
