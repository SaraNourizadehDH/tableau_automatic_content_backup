            </column>
            <column caption='Is Unfinished  Date Period' datatype='boolean' name='[Is Today (copy)_1470425339625254924]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;Date&apos; THEN [report_date] = TODAY() &#13;&#10;    WHEN &apos;Week&apos; THEN WEEK([report_date]) = WEEK(TODAY()) &#13;&#10;END' />
