              <calculation class='tableau' formula='CASE [Parameters].[Select 1st Dimension (copy)_835980702928535554]&#13;&#10;WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;WHEN &quot;Country&quot; THEN [country]&#13;&#10;WHEN &quot;Contact Center&quot; THEN [contact_center]&#13;&#10;WHEN &quot;none&quot; THEN &apos;none&apos;&#13;&#10;END' />
