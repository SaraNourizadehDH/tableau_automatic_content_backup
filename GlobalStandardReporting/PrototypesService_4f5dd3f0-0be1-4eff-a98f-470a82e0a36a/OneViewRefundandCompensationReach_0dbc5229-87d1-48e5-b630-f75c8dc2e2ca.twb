    <worksheet name='Refund Reach Influencers'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;&#10;</run>
            <run fontcolor='#898989' fontsize='10'>What drives OneView Reach for Refund?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='oneview_refund_and_compensation_reach (rl_gcc_service) (2)' name='federated.0t8x8nt1qm2esn12xyky40yny0tz' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
            <column caption='Select 1st Dimension' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
            </column>
            <column caption='Select 2nd Dimension' datatype='string' name='[Select 1st Dimension (copy)_835980702928535554]' param-domain-type='list' role='measure' type='nominal' value='&quot;none&quot;'>
              <calculation class='tableau' formula='&quot;none&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0t8x8nt1qm2esn12xyky40yny0tz'>
            <column caption='2nd Dimension' datatype='string' name='[1st Dimension (copy)_1000643566133628931]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Select 1st Dimension (copy)_835980702928535554]&#13;&#10;WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;WHEN &quot;Country&quot; THEN [country]&#13;&#10;WHEN &quot;Contact Center&quot; THEN [contact_center]&#13;&#10;WHEN &quot;none&quot; THEN &apos;none&apos;&#13;&#10;END' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_1000643566130249728]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Day&quot; THEN STR([created_date])&#13;&#10;WHEN &quot;Week&quot; THEN [created_week]&#13;&#10;WHEN &quot;Month&quot; THEN [created_month]&#13;&#10;END' />
            </column>
            <column caption='Refund Reach' datatype='real' name='[Calculation_1000643566130692097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(SUM([refund_count]) != 0 ,SUM ([ov_refund_count])/ SUM([refund_count]),0)' />
            </column>
            <column caption='1st Dimension' datatype='string' name='[Calculation_1000643566133460994]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;WHEN &quot;Country&quot; THEN [country]&#13;&#10;WHEN &quot;Contact Center&quot; THEN [contact_center]&#13;&#10;END' />
            </column>
            <column caption='Refund Reach Influencers' datatype='real' name='[Calculation_1000643566136012804]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1000643566130692097] - MAX({ FIXED [Calculation_1000643566130249728] : [Calculation_1000643566130692097]}))&#13;&#10;*&#13;&#10;(SUM( [refund_count])/MAX({ FIXED [Calculation_1000643566130249728] : SUM([refund_count])}))' />
            </column>
