    <worksheet name='Validation : avg Reorders 30D VS 5D'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Validating the trends for Bot experience :  Avg reorders_30D vs Avg reorders_5D </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (sandbox_rutuja)' name='federated.0klddfr1hv5ctl155qmwe17fio9k' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0klddfr1hv5ctl155qmwe17fio9k'>
            <column caption='Avg reodrers bot  30 Days' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg reodrers bot  (copy)_3640667775689371656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reorders_30D_bot]) / SUM([total_orders_bot])' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_3019804345447768066]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10; WHEN &apos;Daily&apos; THEN STR([created_date])&#10; WHEN &apos;Weekly&apos; THEN [week]&#10;END' />
            </column>
            <column caption='Avg reoders bot ' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_3640667775674064896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reorders_5D_bot]) / SUM([total_orders_bot])' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='created date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='Management Entity Group' datatype='string' name='[management_entity_group]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3019804345447768066]' derivation='None' name='[none:Calculation_3019804345447768066:nk]' pivot='key' type='nominal' />
