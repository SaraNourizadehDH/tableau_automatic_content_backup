      <column caption='Avg reodrers agent 30 Days' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg reodrers agent (copy)_3640667775689056262]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reorders_30D_agent]) / SUM([total_orders_agent])' />
      </column>
      <column caption='Avg reodrers agent + bot 30 Days' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg reodrers agent + bot (copy)_3640667775689142279]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reorders_30D_agent_plus_bot]) / SUM([total_orders_bot])' />
      </column>
