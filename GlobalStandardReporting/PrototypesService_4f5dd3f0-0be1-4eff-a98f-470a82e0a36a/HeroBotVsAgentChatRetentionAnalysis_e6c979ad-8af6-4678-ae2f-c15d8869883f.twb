            <column-instance column='[management_entity_group]' derivation='None' name='[none:management_entity_group:nk]' pivot='key' type='nominal' />
            <column caption='reorders 30D bot' datatype='integer' name='[reorders_30D_bot]' role='measure' type='quantitative' />
            <column caption='reorders 5D bot' datatype='integer' name='[reorders_5D_bot]' role='measure' type='quantitative' />
            <column caption='total orders bot' datatype='integer' name='[total_orders_bot]' role='measure' type='quantitative' />
            <column-instance column='[Avg reodrers bot  (copy)_3640667775689371656]' derivation='User' name='[usr:Avg reodrers bot  (copy)_3640667775689371656:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3640667775674064896]' derivation='User' name='[usr:Calculation_3640667775674064896:qk]' pivot='key' type='quantitative' />
            <column datatype='string' datatype-customized='true' name='[week]' role='dimension' type='nominal' />
