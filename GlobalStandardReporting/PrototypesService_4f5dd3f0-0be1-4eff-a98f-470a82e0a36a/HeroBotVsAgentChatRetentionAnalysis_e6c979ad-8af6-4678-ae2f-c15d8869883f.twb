    <datasource caption='Custom SQL Query (sandbox_rutuja)' inline='true' name='federated.0klddfr1hv5ctl155qmwe17fio9k' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.15jegbl07vio1n140ws9r1wl3fll'>
            <connection CATALOG='logistics-data-storage-staging' EXECCATALOG='logistics-service-staging' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='logistics-data-storage-staging' schema='sandbox_rutuja' server-oauth='' username='rutuja.bhosale@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.15jegbl07vio1n140ws9r1wl3fll' name='Custom SQL Query' type='text'><![CDATA[SELECT 
  created_date
  , week
  , management_entity_group
  , country
  , issue_type
---- agent chat metrics
  , SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type NOT LIKE '%Bot%' THEN num_orders END ) AS total_orders_agent
  , SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type NOT LIKE '%Bot%' THEN opti_kpi_reorders_5D END ) reorders_5D_agent
  , SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type NOT LIKE '%Bot%' THEN reorders_30D END ) reorders_30D_agent
  , ROUND(SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type NOT LIKE '%Bot%' THEN opti_kpi_reorders_5D END )/SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type NOT LIKE '%Bot%' THEN num_orders END ), 2) AS avg_reorders_agent
  , ROUND(SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type NOT LIKE '%Bot%' THEN reorders_30D END )/SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type NOT LIKE '%Bot%' THEN num_orders END ), 2) AS avg_reorders_agent_30D
---- bot metrics
  , SUM(CASE WHEN resolution_type like '%Bot%' OR (resolution_type like '%Bot%' AND resolution_type LIKE '%HC%') THEN num_orders END ) AS total_orders_bot
  , SUM(CASE WHEN resolution_type like '%Bot%' OR (resolution_type like '%Bot%' AND resolution_type LIKE '%HC%') THEN opti_kpi_reorders_5D END ) reorders_5D_bot
  , SUM(CASE WHEN resolution_type like '%Bot%' OR (resolution_type like '%Bot%' AND resolution_type LIKE '%HC%') THEN reorders_30D END ) reorders_30D_bot
  , ROUND(SUM(CASE WHEN resolution_type like '%Bot%' OR (resolution_type like '%Bot%' AND resolution_type LIKE '%HC%') THEN opti_kpi_reorders_5D END )/SUM(CASE WHEN resolution_type like '%Bot%' OR (resolution_type like '%Bot%' AND resolution_type LIKE '%HC%') THEN num_orders END), 2) AS avg_reorders_bot
  , ROUND(SUM(CASE WHEN resolution_type like '%Bot%' OR (resolution_type like '%Bot%' AND resolution_type LIKE '%HC%') THEN reorders_30D END )/SUM(CASE WHEN resolution_type like '%Bot%' OR (resolution_type like '%Bot%' AND resolution_type LIKE '%HC%') THEN num_orders END), 2) AS avg_reorders_bot_30D
---- Agent chat + bot metrics
  , SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type LIKE '%Bot%' THEN num_orders END ) AS total_orders_agent_plus_bot
  , SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type LIKE '%Bot%' THEN opti_kpi_reorders_5D END ) AS reorders_5D_agent_plus_bot
  , SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type LIKE '%Bot%' THEN reorders_30D END ) AS reorders_30D_agent_plus_bot
  , ROUND(SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type LIKE '%Bot%' THEN opti_kpi_reorders_5D END )/SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type LIKE '%Bot%' THEN num_orders END ), 2) AS avg_reorders_agent_plus_bot
  , ROUND(SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type LIKE '%Bot%' THEN reorders_30D END ) /SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type LIKE '%Bot%' THEN num_orders END ), 2) AS avg_reorders_agent_plus_bot_30D

FROM `fulfillment-dwh-production.rl.retention_gap_service_xp`
WHERE created_date >>= '2023-12-01' 
 AND issue_type IN ( 'Check order status',
        'Complain about late order',
        'Complaint about short delay',
        'Complaint about moderate delay',
        'Complaint about severe delay',
        'Complaint about extreme delay')
 AND created_date <<= DATE_SUB(CURRENT_DATE, INTERVAL 7 DAY) ---- we are looking at next 5 days orders, to get the complete data kept it to orders placed before last 6 days 
 AND country IN (SELECT distinct country FROM `fulfillment-dwh-production.rl.retention_gap_service_xp`
 WHERE resolution_type LIKE '%Bot%') -- to limit the data to only countries where bot is live
GROUP BY 1, 2, 3, 4, 5
ORDER BY 2, 3, 1 DESC]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.15jegbl07vio1n140ws9r1wl3fll' name='Custom SQL Query' type='text'><![CDATA[SELECT 
  created_date
  , week
  , management_entity_group
  , country
  , issue_type
---- agent chat metrics
  , SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type NOT LIKE '%Bot%' THEN num_orders END ) AS total_orders_agent
  , SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type NOT LIKE '%Bot%' THEN opti_kpi_reorders_5D END ) reorders_5D_agent
  , SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type NOT LIKE '%Bot%' THEN reorders_30D END ) reorders_30D_agent
  , ROUND(SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type NOT LIKE '%Bot%' THEN opti_kpi_reorders_5D END )/SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type NOT LIKE '%Bot%' THEN num_orders END ), 2) AS avg_reorders_agent
  , ROUND(SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type NOT LIKE '%Bot%' THEN reorders_30D END )/SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type NOT LIKE '%Bot%' THEN num_orders END ), 2) AS avg_reorders_agent_30D
---- bot metrics
  , SUM(CASE WHEN resolution_type like '%Bot%' OR (resolution_type like '%Bot%' AND resolution_type LIKE '%HC%') THEN num_orders END ) AS total_orders_bot
  , SUM(CASE WHEN resolution_type like '%Bot%' OR (resolution_type like '%Bot%' AND resolution_type LIKE '%HC%') THEN opti_kpi_reorders_5D END ) reorders_5D_bot
  , SUM(CASE WHEN resolution_type like '%Bot%' OR (resolution_type like '%Bot%' AND resolution_type LIKE '%HC%') THEN reorders_30D END ) reorders_30D_bot
  , ROUND(SUM(CASE WHEN resolution_type like '%Bot%' OR (resolution_type like '%Bot%' AND resolution_type LIKE '%HC%') THEN opti_kpi_reorders_5D END )/SUM(CASE WHEN resolution_type like '%Bot%' OR (resolution_type like '%Bot%' AND resolution_type LIKE '%HC%') THEN num_orders END), 2) AS avg_reorders_bot
  , ROUND(SUM(CASE WHEN resolution_type like '%Bot%' OR (resolution_type like '%Bot%' AND resolution_type LIKE '%HC%') THEN reorders_30D END )/SUM(CASE WHEN resolution_type like '%Bot%' OR (resolution_type like '%Bot%' AND resolution_type LIKE '%HC%') THEN num_orders END), 2) AS avg_reorders_bot_30D
---- Agent chat + bot metrics
  , SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type LIKE '%Bot%' THEN num_orders END ) AS total_orders_agent_plus_bot
  , SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type LIKE '%Bot%' THEN opti_kpi_reorders_5D END ) AS reorders_5D_agent_plus_bot
  , SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type LIKE '%Bot%' THEN reorders_30D END ) AS reorders_30D_agent_plus_bot
  , ROUND(SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type LIKE '%Bot%' THEN opti_kpi_reorders_5D END )/SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type LIKE '%Bot%' THEN num_orders END ), 2) AS avg_reorders_agent_plus_bot
  , ROUND(SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type LIKE '%Bot%' THEN reorders_30D END ) /SUM(CASE WHEN resolution_type LIKE '%Agent%' AND resolution_type LIKE '%Bot%' THEN num_orders END ), 2) AS avg_reorders_agent_plus_bot_30D

FROM `fulfillment-dwh-production.rl.retention_gap_service_xp`
WHERE created_date >>= '2023-12-01' 
 AND issue_type IN ( 'Check order status',
        'Complain about late order',
        'Complaint about short delay',
        'Complaint about moderate delay',
        'Complaint about severe delay',
        'Complaint about extreme delay')
 AND created_date <<= DATE_SUB(CURRENT_DATE, INTERVAL 7 DAY) ---- we are looking at next 5 days orders, to get the complete data kept it to orders placed before last 6 days 
 AND country IN (SELECT distinct country FROM `fulfillment-dwh-production.rl.retention_gap_service_xp`
 WHERE resolution_type LIKE '%Bot%') -- to limit the data to only countries where bot is live
GROUP BY 1, 2, 3, 4, 5
ORDER BY 2, 3, 1 DESC]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
