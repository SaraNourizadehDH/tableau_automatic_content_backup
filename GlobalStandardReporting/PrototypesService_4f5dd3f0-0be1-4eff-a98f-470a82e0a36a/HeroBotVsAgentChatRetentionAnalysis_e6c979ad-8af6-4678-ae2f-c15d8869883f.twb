      <datasource-dependencies datasource='Parameters'>
        <column caption='Metric 1' datatype='string' name='[Date Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Avg Reorders Agent chat&quot;'>
          <calculation class='tableau' formula='&quot;Avg Reorders Agent chat&quot;' />
        </column>
        <column caption='Metric 2' datatype='string' name='[Metric 1 (copy)_3640667775680610307]' param-domain-type='list' role='measure' type='nominal' value='&quot;Avg Reorders Bot&quot;'>
          <calculation class='tableau' formula='&quot;Avg Reorders Bot&quot;' />
        </column>
        <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
