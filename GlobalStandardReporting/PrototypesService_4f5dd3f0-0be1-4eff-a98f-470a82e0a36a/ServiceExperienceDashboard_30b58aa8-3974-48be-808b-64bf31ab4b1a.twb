      <table>
        <view>
          <datasources>
            <datasource caption='Service Experience' name='federated.0gqoovo0dtggoq11xfe5g16gaz4t' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Pick Top X Event Sequences' datatype='integer' name='[Dimension (copy) 1]' param-domain-type='any' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gqoovo0dtggoq11xfe5g16gaz4t'>
            <column caption='Path Duration (mins) ' datatype='real' default-format='n#,##0;-#,##0' name='[Avg Stage Duration (mins) (copy)_5314177226550829067]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_stage_duration])&#10;/[Calculation_5314177225960136707]' />
            </column>
            <column caption='With Cancellation' datatype='boolean' name='[Calculation_2036682593485135872]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([events_sequence], &apos;cancellation&apos;)&#10;THEN true&#10;ELSE false&#10;END' />
            </column>
            <column caption='Pick Top X Event Sequences' datatype='string' name='[Calculation_2036682593496600577]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [events_sequence Set] THEN [events_sequence]&#10;ELSE &apos;Others&apos;&#10;END' />
            </column>
            <column caption='Path Volume' datatype='integer' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_5314177225960136707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF stage =&apos;placed&apos; THEN [sum_stage_volume] END)' />
            </column>
            <column caption='is Own Delivery' datatype='boolean' name='[Calculation_5314177226607775765]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [delivery_type] = &apos;Own Delivery&apos;&#10;THEN true&#10;ELSE false&#10;END' />
            </column>
            <column caption='Path Volume %' datatype='real' default-format='p0.00%' name='[Path Volume (copy)_1346505965180456961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF stage =&apos;placed&apos; THEN [sum_stage_volume] END) / SUM([volume % (copy)_5314177227255115805])' />
            </column>
            <column caption='With Refund/Compensation' datatype='boolean' name='[With Cancellation (copy)_2036682593514840066]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([events_sequence], &apos;refund&apos;)&#10;  THEN true&#10;ELSEIF CONTAINS([events_sequence], &apos;compensation&apos;)&#10;  THEN true&#10;ELSE false&#10;END' />
            </column>
            <column caption='With Contact' datatype='boolean' name='[With Cancellation (copy)_436145508316934146]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([events_sequence], &apos;|| chat ||&apos;)  // avoid mixing with p2p chat&#10;  THEN true&#10;ELSEIF CONTAINS([events_sequence], &apos;|| case ||&apos;)&#10;  THEN true&#10;ELSE false&#10;END' />
            </column>
            <column caption='With Helpcenter' datatype='boolean' name='[With Cancellation (copy)_5314177226626338838]' role='dimension' type='nominal'>
