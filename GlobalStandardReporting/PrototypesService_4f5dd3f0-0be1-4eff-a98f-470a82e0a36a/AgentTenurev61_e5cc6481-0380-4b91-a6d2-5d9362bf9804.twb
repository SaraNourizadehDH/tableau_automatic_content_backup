      <column aggregation='None' caption='Agent Level Time Volume Corr (bin)' datatype='integer' name='[Agent Level Time Volume Corr (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='-2' formula='[agent_level_time_volume_corr]' peg='0' size='0.05' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_1470143822999461888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Management Entity Group&quot; THEN [management_entity_group]&#13;&#10;WHEN &quot;Agent Work Channel&quot; THEN [agent_work_channel]&#13;&#10;WHEN &quot;BPO Name&quot; THEN [bpo_name]&#13;&#10;WHEN &quot;Skill Name&quot; THEN [skill_name]&#13;&#10;ELSE &quot;none&quot;&#13;&#10;END' />
      </column>
      <column caption='Milestone volume bins' datatype='string' name='[Calculation_509469712331730946]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [volume_tenure]&lt;200 THEN &apos;200 Contacts&apos;&#13;&#10;ELSEIF [volume_tenure]&lt;1000 THEN &apos;1K Contacts&apos;&#13;&#10;ELSEIF [volume_tenure]&lt;4000 THEN &apos;4K Contacts&apos;&#13;&#10;ELSEIF [volume_tenure]&lt;8000 THEN &apos;8K Contacts&apos;&#13;&#10;ELSEIF [volume_tenure]&lt;18000 THEN &apos;18K Contacts&apos;&#13;&#10;ELSE &apos;&gt;18K Contacts&apos; &#13;&#10;END' />
      </column>
      <column caption='Csat Quartiles' datatype='string' name='[Calculation_640355578243940353]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [avg_day_csat]&lt;={FIXED [agent_contact_milestones] :PERCENTILE([avg_day_csat],.25)} THEN &quot;25% underperformers&quot;&#13;&#10;ELSEIF [avg_day_csat]&lt;={FIXED [agent_contact_milestones] :PERCENTILE([avg_day_csat],.5)} THEN &quot;50%&quot;&#13;&#10;ELSEIF [avg_day_csat]&lt;={FIXED [agent_contact_milestones] :PERCENTILE([avg_day_csat],.75)} THEN &quot;75%&quot;&#13;&#10;ELSE &quot;100% overperformers&quot;&#13;&#10;END' />
      </column>
      <column caption='Volume Tenure % Bins' datatype='integer' name='[Calculation_855965410161905676]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;2%_Bins&quot; THEN [volume_tenure_bin_2percent]&#13;&#10;WHEN &quot;5%_Bins&quot; THEN [volume_tenure_bin_5percent]&#13;&#10;WHEN &quot;10%_Bins&quot; THEN [volume_tenure_bin_10percent]&#13;&#10;WHEN &quot;20%_Bins&quot; THEN [volume_tenure_bin_20percent]&#13;&#10;END' />
      </column>
      <column caption='Aht Quartiles' datatype='string' name='[Csat Quartiles (copy)_640355578259898370]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [avg_day_ht_min]&lt;={FIXED [agent_contact_milestones] :PERCENTILE([avg_day_ht_min],.25)} THEN &quot;100% overperformenrs&quot;&#13;&#10;ELSEIF [avg_day_ht_min]&lt;={FIXED [agent_contact_milestones] :PERCENTILE([avg_day_ht_min],.5)} THEN &quot;70%&quot;&#13;&#10;ELSEIF [avg_day_ht_min]&lt;={FIXED [agent_contact_milestones] :PERCENTILE([avg_day_ht_min],.75)} THEN &quot;50%&quot;&#13;&#10;ELSE &quot;25% underperformers&quot;&#13;&#10;END' />
      </column>
      <column caption='Volume tenure 2K - 99%' datatype='integer' name='[Milestone volume bins (challenge) (copy)_267964189110771712]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='IF [volume_tenure]&lt;2000 THEN 0&#13;&#10;ELSEIF [volume_tenure]&lt;4000 THEN 2000&#13;&#10;ELSEIF [volume_tenure]&lt;6000 THEN 4000&#13;&#10;ELSEIF [volume_tenure]&lt;8000 THEN 6000&#13;&#10;ELSEIF [volume_tenure]&lt;10000 THEN 8000&#13;&#10;ELSEIF [volume_tenure]&lt;12000 THEN 10000&#13;&#10;ELSEIF [volume_tenure]&lt;14000 THEN 12000&#13;&#10;ELSEIF [volume_tenure]&lt;16000 THEN 14000&#13;&#10;ELSEIF [volume_tenure]&lt;18000 THEN 16000&#13;&#10;ELSEIF [volume_tenure]&lt;20000 THEN 18000&#13;&#10;ELSEIF [volume_tenure]&lt;22000 THEN 20000&#13;&#10;ELSEIF [volume_tenure]&lt;24000 THEN 22000&#13;&#10;ELSEIF [volume_tenure]&lt;26000 THEN 24000&#13;&#10;ELSEIF [volume_tenure]&lt;28000 THEN 26000&#13;&#10;ELSEIF [volume_tenure]&lt;30000 THEN 28000&#13;&#10;ELSEIF [volume_tenure]&lt;32000 THEN 30000&#13;&#10;ELSEIF [volume_tenure]&lt;34000 THEN 32000&#13;&#10;ELSEIF [volume_tenure]&lt;36000 THEN 34000&#13;&#10;ELSEIF [volume_tenure]&lt;38000 THEN 36000&#13;&#10;ELSEIF [volume_tenure]&lt;40000 THEN 38000&#13;&#10;ELSEIF [volume_tenure]&lt;42000 THEN 40000&#13;&#10;ELSEIF [volume_tenure]&lt;44000 THEN 42000&#13;&#10;ELSEIF [volume_tenure]&lt;46000 THEN 44000&#13;&#10;ELSEIF [volume_tenure]&lt;48000 THEN 46000&#13;&#10;ELSEIF [volume_tenure]&lt;50000 THEN 48000&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Milestone volume bins (challenge)' datatype='string' name='[Milestone volume bins (copy)_1455507112626126855]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [volume_tenure]&lt;200 THEN &apos;200 Contacts&apos;&#13;&#10;ELSEIF [volume_tenure]&lt;2000 THEN &apos;2K Contacts&apos;&#13;&#10;ELSEIF [volume_tenure]&lt;5000 THEN &apos;5K Contacts&apos;&#13;&#10;ELSEIF [volume_tenure]&lt;10000 THEN &apos;10K Contacts&apos;&#13;&#10;ELSEIF [volume_tenure]&lt;20000 THEN &apos;20K Contacts&apos;&#13;&#10;ELSE &apos;&gt;20K Contacts&apos; &#13;&#10;END' />
      </column>
      <column aggregation='None' caption='Time Tenure (2month bins)' datatype='integer' name='[Time Tenure (bin) 2]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='1' formula='[time_tenure]' peg='0' size='61' />
      </column>
      <column aggregation='None' caption='Time Tenure (weekly bins)' datatype='integer' name='[Time Tenure (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[time_tenure]' peg='0' size='7' />
