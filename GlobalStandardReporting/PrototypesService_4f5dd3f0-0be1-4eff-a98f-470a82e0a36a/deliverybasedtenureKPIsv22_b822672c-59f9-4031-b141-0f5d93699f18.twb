      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0u1qnvc08xad2v155303w0fy93a9].[pcdf:usr:Calculation_3662622819470143505:qk:1]&quot;' value='AR ∆.' />
          <alias key='&quot;[federated.0u1qnvc08xad2v155303w0fy93a9].[pcdf:usr:Calculation_431923407667224578:qk:3]&quot;' value='UTR ∆.' />
          <alias key='&quot;[federated.0u1qnvc08xad2v155303w0fy93a9].[pcdf:usr:Calculation_431923407667470339:qk:3]&quot;' value='Idle Time ∆.' />
