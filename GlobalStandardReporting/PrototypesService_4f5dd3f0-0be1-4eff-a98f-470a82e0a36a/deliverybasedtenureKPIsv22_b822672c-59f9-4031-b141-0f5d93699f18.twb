      <column caption='UTR.' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_431923407667224578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([completed_deliveries]) / SUM([working_hours])' />
      </column>
      <column caption='Idle Time.' datatype='real' default-format='p0%' name='[Calculation_431923407667470339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([idle_time] * [working_hours]) / SUM([working_hours])' />
