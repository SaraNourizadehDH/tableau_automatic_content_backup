      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.05avgx71undcm91h7ko4y157wb0h].[pcdf:usr:Calculation_472596488274763781:qk:3]&quot;' value='UTR ∆.' />
          <alias key='&quot;[federated.05avgx71undcm91h7ko4y157wb0h].[pcdf:usr:Calculation_472596488274948102:qk:3]&quot;' value='Idle Time ∆.' />
          <alias key='&quot;[federated.05avgx71undcm91h7ko4y157wb0h].[pcdf:usr:Calculation_472596488275214343:qk:3]&quot;' value='AR ∆.' />
          <alias key='&quot;[federated.05avgx71undcm91h7ko4y157wb0h].[pcto:sum:completed_deliveries:qk:2]&quot;' value='% Completed Deliveries' />
        </aliases>
      </column>
      <column caption='Batch Number (bins)' datatype='integer' name='[Batch Number (copy)_472596488270254080]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [batch_number] &gt;= 1 AND [batch_number] &lt;= 4 THEN [batch_number]&#13;&#10;ELSE 5&#13;&#10;END' />
      </column>
      <column caption='% Riders' datatype='real' default-format='p0%' name='[Calculation_472596488270811137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_riders])&#13;&#10;/&#13;&#10;SUM([count_country_month_riders])' />
      </column>
      <column caption='% Top Batch [1,2] Riders' datatype='real' default-format='p0%' name='[Calculation_472596488271466498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_riders_batch_1_2])&#13;&#10;/&#13;&#10;SUM([count_riders])' />
      </column>
      <column caption='% New (&lt;4 weeks tenure) Riders' datatype='real' default-format='p0%' name='[Calculation_472596488272211971]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_new_riders])&#13;&#10;/&#13;&#10;SUM([count_riders])' />
      </column>
      <column caption='UTR.' datatype='real' default-format='p0%' name='[Calculation_472596488274763781]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([completed_deliveries]) / SUM([working_hours])' />
      </column>
      <column caption='Idle Time.' datatype='real' default-format='p0%' name='[Calculation_472596488274948102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([idle_time] * [working_hours]) / SUM([working_hours])' />
      </column>
      <column caption='% Acceptance Rate' datatype='real' default-format='p0%' name='[Calculation_472596488275214343]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([count_accepted]) - SUM([count_undispatched]))&#13;&#10;/&#13;&#10;SUM([count_notified])' />
      </column>
      <column caption='Selected Metric (batch based)' datatype='real' name='[Calculation_472596488283439117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;UTR&apos; THEN [Calculation_472596488274763781]&#13;&#10;WHEN &apos;Idle Time&apos; THEN [Calculation_472596488274948102]&#13;&#10;WHEN &apos;AR&apos; THEN [Calculation_472596488275214343]&#13;&#10;END' />
      </column>
