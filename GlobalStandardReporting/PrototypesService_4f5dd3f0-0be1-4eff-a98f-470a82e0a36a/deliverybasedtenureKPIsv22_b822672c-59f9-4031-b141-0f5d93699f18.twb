      <column caption='% Riders' datatype='real' default-format='p0%' name='[Calculation_3662622819277250560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_riders])&#10;/&#10;SUM([count_country_month_riders])' />
      </column>
      <column caption='% Acceptance Rate' datatype='real' default-format='p0.0%' name='[Calculation_3662622819470143505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([count_accepted]) - SUM([count_undispatched]))&#10;/&#10;SUM([count_notified])' />
