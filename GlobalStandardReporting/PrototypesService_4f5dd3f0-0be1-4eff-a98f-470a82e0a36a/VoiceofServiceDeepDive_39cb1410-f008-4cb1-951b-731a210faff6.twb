    <worksheet name='LDA Description'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='10'>Customer chats are grouped into sentiment categories. This approach relies on a dictionary that maps words to emotion intensities known as sentiment.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#f28a87' fontname='Tableau Bold' fontsize='9'>Positive</run>
            <run>Æ&#10;</run>
            <run fontcolor='#343b46' fontname='Tableau Book' fontsize='9'>E.g. &quot;Please bring some soy sauce . Thanks so much&quot;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#466199' fontname='Tableau Book' fontsize='9'>Negative</run>
            <run>Æ&#10;</run>
            <run fontcolor='#343b46' fontname='Tableau Book' fontsize='9'>E.g. &quot;Where is it? I see the message that the delivery is delayed and then delayed&quot;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#99bde5' fontname='Tableau Book' fontsize='9'>Neutral</run>
            <run>Æ&#10;</run>
            <run fontcolor='#343b46' fontname='Tableau Book' fontsize='9'>E.g. &quot;How long will you take&quot;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='voice_of_service_lda (sandbox_dorota)' name='federated.0gljrh31mr4eb61agq9hd1w1tcfy' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
