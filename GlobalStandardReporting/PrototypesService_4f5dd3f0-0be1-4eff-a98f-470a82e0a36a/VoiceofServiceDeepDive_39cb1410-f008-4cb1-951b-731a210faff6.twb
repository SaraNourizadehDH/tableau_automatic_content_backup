              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Contact Reason L1&apos; THEN [Contact Reason L1 raw (copy)_6281395592945721345]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Contact Reason L2&apos; THEN [Contact Reason L2 raw (copy)_6281395592945811458]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Contact Reason L3&apos; THEN [Contact Reason L3 raw (copy)_6281395592945897475]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;After Contact CSAT&apos; THEN STR([Calculation_6281395592918556672])&#10;END' />
            </column>
            <column caption='LDA Topic' datatype='string' name='[Calculation_2025634679042060319]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lda_label] = &apos;delivered&apos; THEN &apos;Topic 1&apos;&#10;ELSEIF [lda_label] = &apos;during delivery&apos; THEN &apos;Topic 2&apos;&#10;ELSEIF [lda_label] = &apos;at destination&apos; THEN &apos;Topic 3&apos;&#10;END' />
            </column>
            <column caption='CSAT' datatype='string' name='[Calculation_6281395592918556672]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [csat_score] &lt;= 3 THEN &apos;Negative CSAT&apos;&#10;ELSEIF [csat_score] &gt;= 4 THEN &apos;Positive CSAT&apos;&#10;ELSE &apos;N/A&apos;&#10;END' />
