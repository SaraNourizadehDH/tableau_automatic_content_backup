      <aliases enabled='yes' />
      <column caption='Calculation1' datatype='real' name='[Calculation_1944429148186292230]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[voice_of_service_lda_F0327EF532FD4EA2B4BD72A02AA5BD0A]) / TOTAL(COUNT([__tableau_internal_object_id__].[voice_of_service_lda_F0327EF532FD4EA2B4BD72A02AA5BD0A]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Split By' datatype='string' name='[Calculation_2025634678972329985]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Contact Reason L1&apos; THEN [Contact Reason L1 raw (copy)_6281395592945721345]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Contact Reason L2&apos; THEN [Contact Reason L2 raw (copy)_6281395592945811458]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Contact Reason L3&apos; THEN [Contact Reason L3 raw (copy)_6281395592945897475]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;After Contact CSAT&apos; THEN STR([Calculation_6281395592918556672])&#10;END' />
      </column>
      <column caption='Chat count' datatype='real' name='[Calculation_2025634679005724683]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(COUNT([__tableau_internal_object_id__].[voice_of_service_lda_F0327EF532FD4EA2B4BD72A02AA5BD0A]))/2'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Chat Count' datatype='real' name='[Calculation_2025634679005941772]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(COUNT([__tableau_internal_object_id__].[voice_of_service_lda_F0327EF532FD4EA2B4BD72A02AA5BD0A]))/2'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Percentage ' datatype='real' name='[Calculation_2025634679006035981]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2025634679005724683] / [Calculation_2025634679005941772]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Percentage Adjusted' datatype='real' name='[Calculation_2025634679006519310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2025634679006035981]/ WINDOW_MAX([Calculation_2025634679006035981])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank' datatype='integer' name='[Calculation_2025634679006666767]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE([Calculation_2025634679005724683], &quot;desc&quot;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='X' datatype='real' name='[Calculation_2025634679006801936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(INDEX()-1)*0.12 - 6'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sigmoid' datatype='real' name='[Calculation_2025634679006953489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1/(1+EXP(-[Calculation_2025634679006801936]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Y' datatype='real' name='[Calculation_2025634679007653906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2025634679006953489]*([Calculation_2025634679006666767]-(WINDOW_MAX([Calculation_2025634679006666767])+1)/2)/100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Size' datatype='integer' name='[Calculation_2025634679008116755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2025634679006801936] &gt;= 6 AND [Calculation_2025634679006801936] &lt;= 6+(10 * [Calculation_2025634679006519310]) THEN 1&#10;ELSE 0&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='LDA Topic' datatype='string' name='[Calculation_2025634679042060319]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [lda_label] = &apos;delivered&apos; THEN &apos;Topic 1&apos;&#10;ELSEIF [lda_label] = &apos;during delivery&apos; THEN &apos;Topic 2&apos;&#10;ELSEIF [lda_label] = &apos;at destination&apos; THEN &apos;Topic 3&apos;&#10;END' />
      </column>
      <column caption='Total Chat Count - deduplicated' datatype='real' name='[Calculation_382524506408628227]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[voice_of_service_lda_F0327EF532FD4EA2B4BD72A02AA5BD0A])/2' />
      </column>
      <column caption='CSAT' datatype='string' name='[Calculation_6281395592918556672]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [csat_score] &lt;= 3 THEN &apos;Negative CSAT&apos;&#10;ELSEIF [csat_score] &gt;= 4 THEN &apos;Positive CSAT&apos;&#10;ELSE &apos;N/A&apos;&#10;END' />
      </column>
      <column caption='LDA Description' datatype='string' name='[Calculation_6308206088064204800]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Customer chats are grouped into topics, based on following key words:&#10;&#10;Topic 1 - Expressing gratitude, order placement instructions&#10;please, thank, put, door, room, help, thanks, table, management, guard &#10;Topic 2 - Address instructions&#10;floor, send, lane, address, first, road, next, right, th, gate&#10;Topic 3 - Request to do sth, an issue&#10;call, hello, go, downstairs, wait, get, im, hard, work, trouble&apos;' />
      </column>
      <column caption='Topic Description' datatype='string' name='[Calculation_6308206088073367561]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;LDA (3 topics)&apos; THEN [Calculation_6308206088064204800]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;DMM (5 topics)&apos; THEN [LDA Description (copy)_6308206088064667649]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Vader (sentiment)&apos; THEN [DMM Description (copy)_6308206088072916998]&#10;END' />
      </column>
      <column caption='Exclude N/A' datatype='boolean' name='[Calculation_6474909639489859595]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = TRUE AND [Calculation_2025634678972329985] = &apos;N/A&apos;&#10;THEN FALSE&#10;ELSE TRUE&#10;END' />
      </column>
      <column caption='Chat Label' datatype='string' name='[Calculation_6474909639497764876]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;LDA (3 topics)&apos;&#10;THEN [Calculation_2025634679042060319]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;DMM (5 topics)&apos;&#10;THEN STR([Calculation_945333725849481219])&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Vader (sentiment)&apos;&#10;THEN [vader_label]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Title' datatype='string' name='[Calculation_945333725813780481]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4]' />
      </column>
      <column caption='DMM Label' datatype='string' name='[Calculation_945333725849481219]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [dmm_label]&#10;  WHEN 0 THEN &apos;Topic 1&apos;&#10;  WHEN 1 THEN &apos;Topic 2&apos;&#10;  WHEN 2 THEN &apos;Topic 3&apos;&#10;  WHEN 3 THEN &apos;Topic 4&apos;&#10;  WHEN 4 THEN &apos;Topic 5&apos;&#10;END' />
      </column>
      <column caption='Contact Reason L1' datatype='string' name='[Contact Reason L1 raw (copy)_6281395592945721345]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([contact_reason_l1], &apos;N/A&apos;)' />
      </column>
      <column caption='Contact Reason L2' datatype='string' name='[Contact Reason L2 raw (copy)_6281395592945811458]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([contact_reason_l2], &apos;N/A&apos;)' />
      </column>
      <column caption='Contact Reason L3' datatype='string' name='[Contact Reason L3 raw (copy)_6281395592945897475]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([contact_reason_l3], &apos;N/A&apos;)' />
      </column>
      <column caption='Vader Description' datatype='string' name='[DMM Description (copy)_6308206088072916998]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Customer chats are grouped into sentiment categories. This approach relies on a dictionary that maps words to emotion intensities known as sentiment.&#10;&#10;Positive&#10;E.g. &quot;Please bring some soy sauce . Thanks so much&quot;&#10;Negative&#10;E.g. &quot;Where is it? I see the message that the delivery is delayed and then delayed&quot;&#10;Neutral&#10;E.g. &quot;How long will you take&quot;&#10;&#10;&apos;' />
      </column>
      <column caption='DMM Description' datatype='string' name='[LDA Description (copy)_6308206088064667649]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Customer chats are grouped into topics, based on following key words showing up together:&#10;&#10;Topic 1&#10;put, door, floor, room, thanks, help, management, table, send, first&#10;Topic 2&#10;number, house, account, send, soi, front, shop, alley, give, transfer&#10;Topic 3&#10;put, door, front, hang, house, help, table, locomotive, thanks, food&#10;Topic 4&#10;road, address, send, floor, lane, house, street, building, door, call&#10;Topic 5&#10;call, get, number, wait, go, help, thanks, downstairs, long, arrive&#10;&#10;&apos;' />
      </column>
