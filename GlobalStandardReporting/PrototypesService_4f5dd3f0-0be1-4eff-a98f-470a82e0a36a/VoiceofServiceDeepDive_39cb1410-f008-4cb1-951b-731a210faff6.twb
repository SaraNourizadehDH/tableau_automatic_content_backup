            </column>
            <column caption='Chat count' datatype='real' name='[Calculation_2025634679005724683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_SUM(COUNT([__tableau_internal_object_id__].[voice_of_service_lda_F0327EF532FD4EA2B4BD72A02AA5BD0A]))/2'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Rank' datatype='integer' name='[Calculation_2025634679006666767]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_UNIQUE([Calculation_2025634679005724683], &quot;desc&quot;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='X' datatype='real' name='[Calculation_2025634679006801936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(INDEX()-1)*0.12 - 6'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Sigmoid' datatype='real' name='[Calculation_2025634679006953489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1/(1+EXP(-[Calculation_2025634679006801936]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Y' datatype='real' name='[Calculation_2025634679007653906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2025634679006953489]*([Calculation_2025634679006666767]-(WINDOW_MAX([Calculation_2025634679006666767])+1)/2)/100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='LDA Topic' datatype='string' name='[Calculation_2025634679042060319]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [lda_label] = &apos;delivered&apos; THEN &apos;Topic 1&apos;&#10;ELSEIF [lda_label] = &apos;during delivery&apos; THEN &apos;Topic 2&apos;&#10;ELSEIF [lda_label] = &apos;at destination&apos; THEN &apos;Topic 3&apos;&#10;END' />
            </column>
            <column caption='Total Chat Count - deduplicated' datatype='real' name='[Calculation_382524506408628227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[voice_of_service_lda_F0327EF532FD4EA2B4BD72A02AA5BD0A])/2' />
            </column>
            <column caption='CSAT' datatype='string' name='[Calculation_6281395592918556672]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [csat_score] &lt;= 3 THEN &apos;Negative CSAT&apos;&#10;ELSEIF [csat_score] &gt;= 4 THEN &apos;Positive CSAT&apos;&#10;ELSE &apos;N/A&apos;&#10;END' />
            </column>
            <column caption='Exclude N/A' datatype='boolean' name='[Calculation_6474909639489859595]' role='dimension' type='nominal'>
