            <customized-label>
              <formatted-text>
                <run bold='true' fontalignment='0' fontname='Tableau Bold' fontsize='10'>Customer chats are grouped into topics, based on following key words showing up together:</run>
                <run fontalignment='0'>Æ&#10;&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#466199' fontname='Tableau Bold' fontsize='10'>Topic 1</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0' fontsize='10'>put, door, floor, room, thanks, help, management, table, send, first</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#99bde5' fontsize='10'>Topic 2</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0' fontsize='10'>number, house, account, send, soi, front, shop, alley, give, transfer</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#f28a87' fontsize='10'>Topic 3</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0' fontsize='10'>put, door, front, hang, house, help, table, locomotive, thanks, food</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#aba19c' fontsize='10'>Topic 4</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0' fontsize='10'>road, address, send, floor, lane, house, street, building, door, call</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#c8a794' fontsize='10'>Topic 5</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0' fontsize='10'>call, get, number, wait, go, help, thanks, downstairs, long, arrive</run>
                <run fontalignment='0'>Æ&#10;&#10;</run>
              </formatted-text>
            </customized-label>
