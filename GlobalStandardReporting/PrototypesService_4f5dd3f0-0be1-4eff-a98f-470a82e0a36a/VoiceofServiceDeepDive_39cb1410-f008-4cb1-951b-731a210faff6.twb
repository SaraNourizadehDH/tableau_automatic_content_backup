            </column>
            <column caption='Chat Label' datatype='string' name='[Calculation_6474909639497764876]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;LDA (3 topics)&apos;&#10;THEN [Calculation_2025634679042060319]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;DMM (5 topics)&apos;&#10;THEN STR([Calculation_945333725849481219])&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Vader (sentiment)&apos;&#10;THEN [vader_label]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='DMM Label' datatype='string' name='[Calculation_945333725849481219]' role='dimension' type='nominal'>
