            <column caption='Vader Description' datatype='string' name='[DMM Description (copy)_6308206088072916998]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Customer chats are grouped into sentiment categories. This approach relies on a dictionary that maps words to emotion intensities known as sentiment.&#10;&#10;Positive&#10;E.g. &quot;Please bring some soy sauce . Thanks so much&quot;&#10;Negative&#10;E.g. &quot;Where is it? I see the message that the delivery is delayed and then delayed&quot;&#10;Neutral&#10;E.g. &quot;How long will you take&quot;&#10;&#10;&apos;' />
