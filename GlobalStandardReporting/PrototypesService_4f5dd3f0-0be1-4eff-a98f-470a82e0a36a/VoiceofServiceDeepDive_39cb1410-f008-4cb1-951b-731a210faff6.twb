            <customized-label>
              <formatted-text>
                <run bold='true' fontalignment='0' fontname='Tableau Bold' fontsize='10'>Customer chats are grouped into sentiment categories. This approach relies on a dictionary that maps words to emotion intensities known as sentiment.</run>
                <run fontalignment='0'>Æ&#10;&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#f28a87' fontname='Tableau Bold' fontsize='10'>Positive</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0' fontcolor='#343b46' fontsize='10'>E.g. &quot;Please bring some soy sauce . Thanks so much&quot;</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#466199' fontsize='10'>Negative</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0' fontcolor='#343b46' fontsize='10'>E.g. &quot;Where is it? I see the message that the delivery is delayed and then delayed&quot;</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run bold='true' fontalignment='0' fontcolor='#99bde5' fontsize='10'>Neutral</run>
                <run fontalignment='0'>Æ&#10;</run>
                <run fontalignment='0' fontcolor='#343b46' fontsize='10'>E.g. &quot;How long will you take&quot;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-cull' value='true' />
                <format attr='size' value='0.0099999997764825821' />
                <format attr='mark-labels-show' value='true' />
