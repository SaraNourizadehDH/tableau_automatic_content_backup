          <calculation class='tableau' formula='6' />
          <range max='15' min='1' />
        </column>
        <column caption='Split By' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Contact Reason L1&quot;'>
          <calculation class='tableau' formula='&quot;Contact Reason L1&quot;' />
          <members>
            <member value='&quot;Contact Reason L1&quot;' />
            <member value='&quot;Contact Reason L2&quot;' />
            <member value='&quot;Contact Reason L3&quot;' />
            <member value='&quot;After Contact CSAT&quot;' />
          </members>
        </column>
        <column caption='Exclude N/A' datatype='boolean' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='true'>
          <calculation class='tableau' formula='true' />
          <members>
            <member value='true' />
            <member value='false' />
          </members>
        </column>
        <column caption='Choose Chat Label' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;LDA (3 topics)&quot;'>
          <calculation class='tableau' formula='&quot;LDA (3 topics)&quot;' />
          <members>
            <member value='&quot;LDA (3 topics)&quot;' />
            <member value='&quot;DMM (5 topics)&quot;' />
            <member value='&quot;Vader (sentiment)&quot;' />
          </members>
        </column>
