    <worksheet name='Contact Rate MEG'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Tableau Regular' fontsize='16'>Managemnet Entity Groups</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='contact_rate_report' name='federated.17qzwaz1q58zhw16kt1qe1hpvx3g' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Created Week&quot;'>
              <calculation class='tableau' formula='&quot;Created Week&quot;' />
            </column>
            <column caption='Segments' datatype='integer' name='[Parameter 5]' param-domain-type='range' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
              <range max='50' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.17qzwaz1q58zhw16kt1qe1hpvx3g'>
            <column caption='Date Granularity' datatype='string' name='[Calculation_2315131743311069186]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Created Date&quot; THEN STR([created_date])&#10;WHEN &quot;Created Week&quot; THEN [created_week]&#10;WHEN &quot;Created Month&quot; THEN [created_month]&#10;WHEN &quot;Created Quarter&quot; THEN [created_quarter]&#10;WHEN &quot;Created Year&quot; THEN [created_year]&#10;END' />
            </column>
            <column caption='Top Managemnet Entity Group' datatype='string' name='[Calculation_5095330457140604931]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Top Management Entity Groups] THEN [management_entity_group] END' />
            </column>
            <column caption='Contact Reason Cluster' datatype='string' name='[Contact Reason Cluster (copy)_3716454919990935552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([contact_reason_cluster]) THEN &quot;Unknown&quot; ELSE [contact_reason_cluster] END' />
            </column>
            <column caption='Is Road To One Percent Eligible' datatype='string' name='[Is Road To One Percent Eligible (copy)_4699787751385128962]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([is_road_to_one_percent_eligible]) THEN &quot;Unknown&quot; ELSE [is_road_to_one_percent_eligible] END' />
            </column>
            <column caption='Orders' datatype='integer' name='[Orders (copy)_2315131743336009735]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id],[created_date] : MIN([total_orders])}' />
            </column>
            <column caption='Contact Rate' datatype='real' name='[Rate (copy)_4635400345129332737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_contacts])/IFNULL(SUM([Orders (copy)_2315131743336009735]),1)' />
            </column>
            <column caption='Vertical' datatype='string' name='[Vertical (copy)_4699787751384301568]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([vertical]) THEN &quot;Unknown&quot; ELSE [vertical] END' />
