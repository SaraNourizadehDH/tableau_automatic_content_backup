            </column>
            <column caption='Orders' datatype='integer' name='[Orders (copy)_2315131743336009735]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id],[created_date] : MIN([total_orders])}' />
            </column>
            <column caption='Orders without Missed Chats' datatype='integer' name='[Orders with Missed Chats (copy)_311733597295562756]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id],[created_date]&#10; : MIN(IF [is_missed_chat] = FALSE THEN [Orders (copy)_2315131743336009735] END)}' />
            </column>
