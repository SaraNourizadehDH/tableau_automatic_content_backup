          <datasource-dependencies datasource='federated.17qzwaz1q58zhw16kt1qe1hpvx3g'>
            <column caption='Date Granularity' datatype='string' name='[Calculation_2315131743311069186]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Created Date&quot; THEN STR([created_date])&#10;WHEN &quot;Created Week&quot; THEN [created_week]&#10;WHEN &quot;Created Month&quot; THEN [created_month]&#10;WHEN &quot;Created Quarter&quot; THEN [created_quarter]&#10;WHEN &quot;Created Year&quot; THEN [created_year]&#10;END' />
            </column>
            <column caption='Chart Type' datatype='boolean' name='[Calculation_3575084109669343232]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Stacked Bar&apos; THEN TRUE &#10;ELSEIF [Parameters].[Parameter 3] = &apos;Line Chart&apos; THEN FALSE END' />
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_5095330457139023873]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Management Entity Group&apos; THEN [management_entity_group]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Contact Reason L1&apos; THEN [contact_reason_l1]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Contact Reason L2&apos; THEN [contact_reason_l2]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Contact Reason L3&apos; THEN [contact_reason_l3]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Contact Reason Cluster&apos; THEN [Contact Reason Cluster (copy)_3716454919990935552]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Global Entity Id&apos; THEN [global_entity_id]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Multi Contact&apos; THEN [multi_contact]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Country&apos; THEN [country]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Order Status Before Contact&apos; THEN [order_status_before_contact]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Stakeholder&apos; THEN [stakeholder]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Channel&apos; THEN [channel]&#10;END' />
            </column>
            <column caption='Top Segment' datatype='string' name='[Calculation_5095330457399291910]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Dimension Set] THEN [Calculation_5095330457139023873]ELSE &quot;Everything Else&quot; END' />
            </column>
            <column caption='Contact Reason Cluster' datatype='string' name='[Contact Reason Cluster (copy)_3716454919990935552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([contact_reason_cluster]) THEN &quot;Unknown&quot; ELSE [contact_reason_cluster] END' />
