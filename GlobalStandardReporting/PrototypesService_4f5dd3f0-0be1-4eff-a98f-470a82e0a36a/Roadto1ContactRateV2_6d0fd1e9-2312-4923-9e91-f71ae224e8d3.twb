              <calculation class='tableau' formula='&quot;Created Week&quot;' />
            </column>
            <column caption='Chart Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Stacked Bar&quot;'>
              <calculation class='tableau' formula='&quot;Stacked Bar&quot;' />
