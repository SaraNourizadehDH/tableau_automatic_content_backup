      </column>
      <column caption='Date Granularity' datatype='string' name='[Calculation_2315131743311069186]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Created Date&quot; THEN STR([created_date])&#10;WHEN &quot;Created Week&quot; THEN [created_week]&#10;WHEN &quot;Created Month&quot; THEN [created_month]&#10;WHEN &quot;Created Quarter&quot; THEN [created_quarter]&#10;WHEN &quot;Created Year&quot; THEN [created_year]&#10;END' />
      </column>
      <column caption='Label' datatype='string' name='[Calculation_2519201103038017536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Label&quot;' />
      </column>
      <column caption='Chart Type' datatype='boolean' name='[Calculation_3575084109669343232]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Stacked Bar&apos; THEN TRUE &#10;ELSEIF [Parameters].[Parameter 3] = &apos;Line Chart&apos; THEN FALSE END' />
      </column>
      <column caption='Metric' datatype='real' name='[Calculation_5095330457134198784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Contact Rate&apos;  THEN [Rate (copy)_4635400345129332737]&#10;END' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_5095330457139023873]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Management Entity Group&apos; THEN [management_entity_group]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Contact Reason L1&apos; THEN [contact_reason_l1]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Contact Reason L2&apos; THEN [contact_reason_l2]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Contact Reason L3&apos; THEN [contact_reason_l3]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Contact Reason Cluster&apos; THEN [Contact Reason Cluster (copy)_3716454919990935552]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Global Entity Id&apos; THEN [global_entity_id]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Multi Contact&apos; THEN [multi_contact]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Country&apos; THEN [country]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Order Status Before Contact&apos; THEN [order_status_before_contact]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Stakeholder&apos; THEN [stakeholder]&#10;    ELSEIF [Parameters].[Parameter 4] = &apos;Channel&apos; THEN [channel]&#10;END' />
      </column>
      <column caption='Top Managemnet Entity Group' datatype='string' name='[Calculation_5095330457140604931]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Top Management Entity Groups] THEN [management_entity_group] END' />
      </column>
      <column caption='Top Contact Reason L3' datatype='string' name='[Calculation_5095330457221844997]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Contact Reason L3 Set] THEN [contact_reason_l3] ELSE &quot;Everything Else&quot;END' />
      </column>
      <column caption='Top Segment' datatype='string' name='[Calculation_5095330457399291910]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Dimension Set] THEN [Calculation_5095330457139023873]ELSE &quot;Everything Else&quot; END' />
      </column>
      <column caption='is_current_date' datatype='boolean' name='[Calculation_6195616141452177411]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;,[created_date]) = &#10;&#10;{MAX(DATETRUNC(&apos;day&apos;,[created_date]))}-1' />
      </column>
      <column caption='is_current_month' datatype='boolean' name='[Calculation_6195616141452963844]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [created_month]: MAX([created_date])} = {FIXED: MAX([created_date])}' />
      </column>
      <column caption='is_prev_week' datatype='boolean' name='[Calculation_6195616141453336584]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT [is_current_month (copy)_6195616141453074437]&#10;AND&#10;{FIXED [created_week]: MAX([created_date])} = {FIXED [is_current_month (copy)_6195616141453074437]: MAX([created_date])}' />
      </column>
      <column caption='is_prev_date' datatype='boolean' name='[Calculation_6195616141453762570]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;,[created_date]) = &#10;&#10;{MAX(DATETRUNC(&apos;day&apos;,[created_date]))} - 2' />
      </column>
      <column caption='Current Conatct Rate' datatype='real' name='[Calculation_6195616141455335437]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Created Date&apos;&#10;then &#10;{ EXCLUDE [Calculation_2315131743311069186]:&#10;    SUM(&#10;    IF [Calculation_6195616141452177411]&#10;    THEN [total_contacts]&#10;    END&#10;    )&#10;/ &#10; SUM(&#10;    [Current Conatct Rate (copy)_6195616141498413076] &#10;    )&#10;&#10;}&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Created Week&apos;&#10;THEN &#10;{ EXCLUDE [Calculation_2315131743311069186]:&#10;    SUM(&#10;    IF [is_current_month (copy)_6195616141453074437]&#10;    THEN [total_contacts]&#10;    END&#10;    )&#10;/ &#10; SUM(&#10;    IF [is_current_month (copy)_6195616141453074437]&#10;    THEN [Orders (copy)_2315131743336009735]&#10;    END&#10;    )&#10;}&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Created Month&apos;&#10;THEN &#10;{ EXCLUDE [Calculation_2315131743311069186]:&#10;    SUM(&#10;    IF [Calculation_6195616141452963844]&#10;    THEN [total_contacts]&#10;    END&#10;    )&#10;/ &#10; SUM(&#10;    IF [Calculation_6195616141452963844]&#10;    THEN [Orders (copy)_2315131743336009735]&#10;    END&#10;    )&#10;}&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Created Quarter&apos;&#10;THEN &#10;{ EXCLUDE [Calculation_2315131743311069186]:&#10;    SUM(&#10;    IF [is_current_week (copy)_6195616141453139974]&#10;    THEN [total_contacts]&#10;    END&#10;    )&#10;/ &#10; SUM(&#10;    IF [is_current_week (copy)_6195616141453139974]&#10;    THEN [Orders (copy)_2315131743336009735]&#10;    END&#10;    )&#10;}&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Created Year&apos;&#10;THEN &#10;{ EXCLUDE [Calculation_2315131743311069186]:&#10;    SUM(&#10;    IF [is_current_week (copy) (copy)_6195616141453156359]&#10;    THEN [total_contacts]&#10;    END&#10;    )&#10;/ &#10; SUM(&#10;    IF [is_current_week (copy) (copy)_6195616141453156359]&#10;    THEN [Orders (copy)_2315131743336009735]&#10;    END&#10;    )&#10;}&#10;END' />
      </column>
      <column caption='Contact Rate % Chg' datatype='real' name='[Calculation_6195616141459501071]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_6195616141455335437])-SUM([Current Conatct Rate (copy)_6195616141458972686]))/SUM([Current Conatct Rate (copy)_6195616141458972686])' />
      </column>
      <column caption='Contact Rate Neg % Diff' datatype='string' name='[Calculation_6195616141459730448]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_6195616141459501071] &lt;= 0&#10;THEN &quot;▼&quot;&#10;ELSE &apos;&apos;&#10;END' />
      </column>
