            <column caption='Orders' datatype='integer' name='[Orders (copy)_2315131743336009735]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id],[created_date] : MIN([total_orders])}' />
            </column>
            <column caption='Contact Rate' datatype='real' name='[Rate (copy)_4635400345129332737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_contacts])/IFNULL(SUM([Orders (copy)_2315131743336009735]),1)' />
