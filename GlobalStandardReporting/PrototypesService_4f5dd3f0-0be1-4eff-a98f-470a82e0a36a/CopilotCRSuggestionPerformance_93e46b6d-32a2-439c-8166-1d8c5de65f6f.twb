      <column caption='Selected Dimension' datatype='string' name='[Calculation_745064317497999360]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Management Entity Group&apos; THEN [management_entity_group]&#13;&#10;WHEN &apos;Contact Center&apos; THEN [contact_center]&#13;&#10;WHEN &apos;Global CR Code&apos; THEN [suggested_cr_code]&#13;&#10;END' />
