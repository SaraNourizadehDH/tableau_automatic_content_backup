      <aliases enabled='yes' />
      <column caption='% CR Accuracy (P1|2) ' datatype='real' default-format='p0.0%' name='[% CR Accuracy (P1) (copy)_1004865724886654979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [llm_cr_position]&lt;=2 THEN [cr_suggestion_cnt]END)&#13;&#10;/&#13;&#10;SUM([cr_suggestion_cnt])' />
      </column>
      <column caption='% CR Accuracy (P1)' datatype='real' default-format='p0.0%' name='[% CR Accuracy (total) (copy)_1004865724886417410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [llm_cr_position]=1 THEN [cr_suggestion_cnt]END)&#13;&#10;/&#13;&#10;SUM([cr_suggestion_cnt])' />
      </column>
      <column caption='Selected Cr Code &amp; MEG' datatype='string' name='[Calculation_1004865724885086208]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[selected_cr] + &apos;(&apos;+ [management_entity_group]+&apos;)&apos;' />
      </column>
      <column caption='% CR Accuracy (P1|2|3)' datatype='real' default-format='p0.0%' name='[Calculation_1004865724885532673]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [llm_cr_position]&lt;=30 THEN [cr_suggestion_cnt]END)&#13;&#10;/&#13;&#10;SUM([cr_suggestion_cnt])' />
      </column>
      <column caption='Selected Dimension' datatype='string' name='[Calculation_1004865724902297605]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;Management Entity Group&apos; THEN [management_entity_group]&#13;&#10;WHEN &apos;Contact Center&apos; THEN [contact_center]&#13;&#10;WHEN &apos;Global CR Code&apos; THEN [selected_cr]&#13;&#10;WHEN &apos;CR (MEG)&apos; THEN [Calculation_1004865724885086208]&#13;&#10;END' />
      </column>
