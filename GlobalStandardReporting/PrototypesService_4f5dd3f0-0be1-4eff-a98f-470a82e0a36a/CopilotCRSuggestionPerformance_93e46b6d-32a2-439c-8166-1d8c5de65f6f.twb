      <column caption='% Suggestion Accuracy' datatype='real' default-format='p0.0%' name='[% Suggestion Accuracy (copy)_559009360116752386]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([suggestion_selected_count])&#13;&#10;/&#13;&#10;SUM([cr_suggestion_count])' />
      </column>
      <column caption='% Suggestion Selected (P3)' datatype='real' default-format='p0.0%' name='[% Suggestion Selected (P1) (copy) (copy) (copy)_1532349821693739011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [suggested_cr_position]=3 THEN [suggestion_selected_count] END)&#13;&#10;/&#13;&#10;SUM(IF [suggested_cr_position]=3 THEN [cr_suggestion_count] END)' />
