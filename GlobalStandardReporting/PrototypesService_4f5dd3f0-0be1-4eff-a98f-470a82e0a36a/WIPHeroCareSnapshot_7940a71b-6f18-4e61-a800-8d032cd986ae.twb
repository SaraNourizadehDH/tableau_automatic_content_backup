      <aliases enabled='yes' />
      <column caption='Average Handling Time' datatype='real' name='[Calculation_2176364548837851136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(([handling_time_chat] / [total_inbound_chats]) / 60)' />
      </column>
      <column caption='AHT(Mins)' datatype='real' name='[Calculation_2176364549638483969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([handling_time_chat])/[Calculation_2176364549638651906]/60' />
      </column>
      <column caption='# Served Chats' datatype='integer' name='[Calculation_2176364549638651906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([served_chat_ind])' />
      </column>
      <column caption='# Incoming Chats' datatype='integer' name='[Calculation_2176364549639778307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([incoming_chat_ind])' />
      </column>
      <column caption='CSAT' datatype='real' name='[Calculation_4769382404519403520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_csat_4_5])/SUM([count_csat_responses])' />
      </column>
      <column aggregation='CountD' caption='To Be Filled' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_4769382404624814082]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;xx&quot;' />
      </column>
      <column caption='% Served Chats' datatype='real' name='[Calculation_4769382404640313347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2176364549638651906] / [Calculation_2176364549639778307]' />
      </column>
      <column caption='Avg, Total HT Chats (min)' datatype='real' name='[Calculation_4769382404867985412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([handling_time_chat]) + sum([wrap_up_time_chat]))/[Calculation_2176364549638651906]/60' />
      </column>
      <column caption='AHT-AtHT' datatype='real' name='[Calculation_4769382404963508229]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED MONTH([created_date]) : [Calculation_2176364549638483969]}' />
      </column>
      <column caption='Wrap Up Time Chat (min)' datatype='real' name='[Calculation_4769382404991258630]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([wrap_up_time_chat])/[Calculation_2176364549638651906] )/60' />
      </column>
      <column caption='SLA 30s Chat' datatype='real' name='[Calculation_4769382405287854091]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_sla_30s_chat])/&#10;(([Calculation_2176364549639778307])&#10;)' />
      </column>
      <column caption='To Be Added' datatype='string' name='[Calculation_4769382405292847116]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;To Be Added&quot;' />
      </column>
      <column caption='Report Month' datatype='integer' name='[Calculation_6307713521765658624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MONTH([created_date])' />
      </column>
      <column caption='Select Time Granularity' datatype='integer' name='[Calculation_6307713521766027267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;Quarter&apos; THEN [Report Month (copy)_6307713521765777409]&#10;    WHEN &apos;Month&apos; THEN [Calculation_6307713521765658624]&#10;    WHEN &apos;Week&apos; THEN [Report Quarter (copy)_6307713521765892098]&#10;END' />
      </column>
      <column caption='Report Quarter' datatype='integer' name='[Report Month (copy)_6307713521765777409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='QUARTER([created_date])' />
      </column>
      <column caption='Report Week' datatype='integer' name='[Report Quarter (copy)_6307713521765892098]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WEEK([created_date])' />
      </column>
