              <calculation class='tableau' formula='STR(CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Day&quot; THEN STR([created_date])&#10;WHEN &quot;Week&quot; THEN STR([created_week])&#10;WHEN &quot;Month&quot; THEN STR([created_month])&#10;END)' />
            </column>
            <column caption='Global Contact Coverage' datatype='real' default-format='p0%' name='[Calculation_5771644442819330135]' role='measure' type='quantitative'>
