            <column caption='Created Month' datatype='string' name='[created_month]' role='dimension' type='nominal' />
            <column caption='Week' datatype='string' name='[created_week]' role='dimension' type='nominal' />
            <column caption='Global Contribution' datatype='real' name='[global_contribution]' role='measure' type='quantitative' />
            <column caption='Is Covered' datatype='boolean' name='[is_covered]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_5771644442811007049]' derivation='None' name='[none:Calculation_5771644442811007049:nk]' pivot='key' type='nominal' />
