      <aliases enabled='yes' />
      <column caption='Concurrency Bins' datatype='integer' name='[Calculation_5771644443684888666]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='FLOOR([sum_concurrency_numerator] / [sum_concurrency_denominator])' />
      </column>
      <column caption='AHT Chat Min' datatype='real' name='[Calculation_5771644443690864731]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL((SUM([sum_handling_time_chat_sec])/60) / SUM([count_served_chats]),0)' />
      </column>
      <column caption='Metric Selected' datatype='real' name='[Calculation_5771644443692822620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;  WHEN &apos;AHT - Chats [min]&apos; THEN [Calculation_5771644443690864731]&#10;   WHEN &apos;CSAT(in %)&apos; THEN [Calculation_5771644443693264989]&#10;END' />
      </column>
      <column caption='CSAT' datatype='real' name='[Calculation_5771644443693264989]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_cs_csat_4_5]) / SUM([count_cs_csat_responses])' />
      </column>
      <column caption='Avg Concurrency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5771644443694325854]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([sum_concurrency_numerator] / [sum_concurrency_denominator])' />
      </column>
      <column caption='Concurrency Displayed' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5771644443697365087]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;{ FIXED [Calculation_5771644443697533024]:&#10;IF MAX([Calculation_5771644443697676385])&#10;THEN [Calculation_5771644443694325854]&#10;ELSE 0&#10;END&#10;}&#10;)' />
      </column>
      <column caption='Date Granularity Filter' datatype='string' name='[Calculation_5771644443697533024]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Day&quot; THEN STR([created_date])&#10;WHEN &quot;Week&quot; THEN [week]&#10;WHEN &quot;Month&quot; THEN [week]&#10;END' />
      </column>
      <column caption='Is Current Date Granularity' datatype='boolean' name='[Calculation_5771644443697676385]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [Calculation_5771644443697533024]: MAX([Calculation_5771644443697533024])} = {FIXED: MAX([Calculation_5771644443697533024])}' />
      </column>
      <column caption='Is Previous Date Granularity' datatype='boolean' name='[Calculation_5771644443697811554]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT [Calculation_5771644443697676385]&#10;AND&#10;{FIXED [Calculation_5771644443697533024]: MAX([Calculation_5771644443697533024])} &#10;= &#10;{FIXED [Calculation_5771644443697676385]: MAX([Calculation_5771644443697533024])}' />
      </column>
      <column caption='Concurrency Change' datatype='real' default-format='p0.0%' name='[Calculation_5771644443698401379]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(&#10;{ FIXED [Calculation_5771644443697533024]:&#10;IF MAX([Calculation_5771644443697676385])&#10;THEN [Calculation_5771644443694325854]&#10;ELSE 0&#10;END&#10;}&#10;) &#10;- &#10;SUM(&#10;{ EXCLUDE [Calculation_5771644443697533024]:&#10;SUM(&#10;IF [Calculation_5771644443697811554]&#10;THEN { FIXED [Calculation_5771644443697811554]:[Calculation_5771644443694325854]&#10;}&#10;ELSE 0&#10;END&#10;)&#10;}&#10;))&#10;/&#10;SUM(&#10;{ EXCLUDE [Calculation_5771644443697533024]:&#10;SUM(&#10;IF [Calculation_5771644443697811554]&#10;THEN { FIXED [Calculation_5771644443697811554]:[Calculation_5771644443694325854]&#10;}&#10;ELSE 0&#10;END&#10;)&#10;}&#10;)' />
      </column>
      <column caption='+ve Concurrency Change' datatype='string' name='[Calculation_5771644443698806884]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5771644443698401379] &gt;= 0&#10;THEN &quot;▲&quot;&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='-ve Concurrency Change' datatype='string' name='[Calculation_5771644443698962533]' role='measure' type='nominal'>
