    <worksheet name='LoB Contact Coverage'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Contact Coverage Per LoB</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='oneview_contact_reason_coverage_report (rl)' name='federated.1l4whtp0etqtv517yhjb61lywpui' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column caption='Customer Target' datatype='real' default-format='p0%' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='0.6'>
              <calculation class='tableau' formula='0.6' />
            </column>
            <column caption='Vendor Target' datatype='real' default-format='p0%' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='0.3776'>
              <calculation class='tableau' formula='0.3776' />
            </column>
            <column caption='Rider Target' datatype='real' default-format='p0%' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='0.4338'>
              <calculation class='tableau' formula='0.4338' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1l4whtp0etqtv517yhjb61lywpui'>
            <column caption='Date Range' datatype='string' name='[Calculation_5771644442811007049]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Day&quot; THEN STR([created_date])&#10;WHEN &quot;Week&quot; THEN STR([created_week])&#10;WHEN &quot;Month&quot; THEN STR([created_month])&#10;END)' />
            </column>
            <column caption='% LoB Wise Contribution' datatype='real' default-format='p0%' name='[Calculation_5771644442824433752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &apos;Day&apos;&#10;THEN SUM(IF [is_covered] THEN [lob_wise_contribution]END) &#10;&#10;WHEN &apos;Week&apos;&#10;THEN (SUM(IF [is_covered] THEN [lob_wise_contribution] END)/COUNTD([created_date]))&#10;&#10;WHEN &apos;Month&apos;&#10;THEN (SUM(IF [is_covered] THEN [lob_wise_contribution] END)/COUNTD([created_date]))&#10;END' />
            </column>
            <column caption='Reference Line' datatype='real' name='[Calculation_5771644442828165209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [stakeholder] = &apos;Customer&apos; &#10;    THEN [Parameters].[Parameter 3]&#10;ELSEIF [stakeholder] = &apos;Rider&apos;&#10;    THEN [Parameters].[Parameter 5]&#10;ELSEIF [stakeholder] = &apos;Vendor&apos;&#10;    THEN [Parameters].[Parameter 4]&#10;END' />
            </column>
            <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='Created Month' datatype='string' name='[created_month]' role='dimension' type='nominal' />
            <column caption='Week' datatype='string' name='[created_week]' role='dimension' type='nominal' />
            <column caption='Is Covered' datatype='boolean' name='[is_covered]' role='dimension' type='nominal' />
            <column caption='Lob Wise Contribution' datatype='real' name='[lob_wise_contribution]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_5771644442828165209]' derivation='Min' name='[min:Calculation_5771644442828165209:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_5771644442811007049]' derivation='None' name='[none:Calculation_5771644442811007049:nk]' pivot='key' type='nominal' />
            <column-instance column='[stakeholder]' derivation='None' name='[none:stakeholder:nk]' pivot='key' type='nominal' />
            <column caption='Stakeholder' datatype='string' name='[stakeholder]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_5771644442824433752]' derivation='User' name='[usr:Calculation_5771644442824433752:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.1l4whtp0etqtv517yhjb61lywpui].[usr:Calculation_5771644442824433752:qk]' scope='rows' value='' />
          </style-rule>
          <style-rule element='label'>
            <format attr='text-format' field='[federated.1l4whtp0etqtv517yhjb61lywpui].[min:Calculation_5771644442828165209:qk]' value='p0%' />
            <format attr='font-weight' field='[federated.1l4whtp0etqtv517yhjb61lywpui].[none:stakeholder:nk]' value='bold' />
            <format attr='font-size' field='[federated.1l4whtp0etqtv517yhjb61lywpui].[none:stakeholder:nk]' value='10' />
