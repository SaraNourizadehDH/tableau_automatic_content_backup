            <run fontalignment='1' fontname='Lantinghei SC' fontsize='28'><![CDATA[<[federated.1c00ekp10eyc0w1638isj0ub5fcv].[usr:Calculation_5771644439882465307:qk]>]]></run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#666666' fontname='Lantinghei SC' fontsize='14'><![CDATA[<[federated.1c00ekp10eyc0w1638isj0ub5fcv].[usr:Calculation_5771644439883829279:qk]>]]></run>
            <run fontalignment='1' fontcolor='#59a14f' fontname='Lantinghei SC' fontsize='14'><![CDATA[<[federated.1c00ekp10eyc0w1638isj0ub5fcv].[usr:Calculation_5771644439884165153:nk]>]]></run>
            <run fontalignment='1' fontcolor='#a90000' fontname='Lantinghei SC' fontsize='14'><![CDATA[<[federated.1c00ekp10eyc0w1638isj0ub5fcv].[usr:Calculation_5771644439884390435:nk]>]]></run>
            <run fontalignment='1' fontname='Lantinghei SC' fontsize='28'>Æ </run>
            <run fontalignment='1' fontcolor='#666666' fontname='Lantinghei SC' fontsize='14'><![CDATA[vs Previous <[Parameters].[Parameter 1]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='active_agents_per_channel_report (rl)' name='federated.1c00ekp10eyc0w1638isj0ub5fcv' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column caption='Time Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c00ekp10eyc0w1638isj0ub5fcv'>
            <column caption='Count of Agents' datatype='integer' name='[Calculation_4769382405238243336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [week], [Calculation_5771644439615115275] :  MAX([count_active_agents_per_week_at])})' />
            </column>
            <column caption='Agent Facing Tool' datatype='string' name='[Calculation_5771644439615115275]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [agent_facing_tool] = &quot;Pandacare&quot;&#10;THEN &quot;HeroCare&quot;&#10;ELSE [agent_facing_tool]&#10;END' />
            </column>
            <column caption='Date Granularity Filter' datatype='string' name='[Calculation_5771644439638896656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Day&quot; THEN STR([report_date])&#10;WHEN &quot;Week&quot; THEN [week]&#10;WHEN &quot;Month&quot; THEN [Calculation_5771644439639126033]&#10;END' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_5771644439639126033]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([report_date])) + &quot;-&quot; +  IF &#10;&#10;STR(MONTH([report_date]))= &apos;1&apos; THEN &apos;01&apos; ELSEIF&#10;&#10;STR(MONTH([report_date]))= &apos;2&apos; THEN &apos;02&apos; ELSEIF&#10;&#10;STR(MONTH([report_date]))= &apos;3&apos; THEN &apos;03&apos; ELSEIF&#10;&#10;STR(MONTH([report_date]))= &apos;4&apos; THEN &apos;04&apos; ELSEIF&#10;&#10;STR(MONTH([report_date]))= &apos;5&apos; THEN &apos;05&apos; ELSEIF&#10;&#10;STR(MONTH([report_date]))= &apos;6&apos; THEN &apos;06&apos; ELSEIF&#10;&#10;STR(MONTH([report_date]))= &apos;7&apos; THEN &apos;07&apos; ELSEIF&#10;&#10;STR(MONTH([report_date]))= &apos;8&apos; THEN &apos;08&apos; ELSEIF&#10;&#10;STR(MONTH([report_date]))= &apos;9&apos; THEN &apos;09&apos; ELSE&#10;&#10;STR(MONTH([report_date])) END' />
            </column>
            <column caption='Is Previous Date Granularity' datatype='boolean' name='[Calculation_5771644439881658393]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT [Calculation_5771644439881855002]&#10;AND&#10;{FIXED [Calculation_5771644439638896656]: MAX([Calculation_5771644439638896656])} &#10;= &#10;{FIXED [Calculation_5771644439881855002]: MAX([Calculation_5771644439638896656])}' />
            </column>
            <column caption='Is Current Date Granularity' datatype='boolean' name='[Calculation_5771644439881855002]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [Calculation_5771644439638896656]: MAX([Calculation_5771644439638896656])} = {FIXED: MAX([Calculation_5771644439638896656])}' />
            </column>
            <column caption='HrC Agent Count Displayed' datatype='integer' name='[Calculation_5771644439882465307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;{ FIXED [Calculation_5771644439638896656]:&#10;IF MAX([Calculation_5771644439881855002])&#10;THEN [Calculation_5771644439883075612]&#10;ELSE 0&#10;END&#10;}&#10;)' />
            </column>
            <column caption='HrC Agents' datatype='integer' name='[Calculation_5771644439883075612]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_5771644439615115275] = &quot;Herocare&quot;&#10;THEN 1&#10;ELSE 0&#10;END)' />
            </column>
            <column caption='HrC Agent Count Change' datatype='real' name='[Calculation_5771644439883829279]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(&#10;{ FIXED [Calculation_5771644439638896656]:&#10;IF MAX([Calculation_5771644439881855002])&#10;THEN [Calculation_5771644439883075612]&#10;ELSE 0&#10;END&#10;}&#10;) &#10;- &#10;SUM(&#10;{ EXCLUDE [Calculation_5771644439638896656]:&#10;SUM(&#10;IF [Calculation_5771644439881658393]&#10;THEN { FIXED [Calculation_5771644439881658393]:[Calculation_5771644439883075612]&#10;}&#10;ELSE 0&#10;END&#10;)&#10;}&#10;))&#10;/&#10;SUM(&#10;{ EXCLUDE [Calculation_5771644439638896656]:&#10;SUM(&#10;IF [Calculation_5771644439881658393]&#10;THEN { FIXED [Calculation_5771644439881658393]:[Calculation_5771644439883075612]&#10;}&#10;ELSE 0&#10;END&#10;)&#10;}&#10;)' />
            </column>
            <column caption='-ve Global Agent Count Change' datatype='string' name='[Calculation_5771644439884165153]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [HrC Agent Count Change (copy)_5771644439954702379] &gt;= 0&#10;THEN &quot;▲&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='-ve HrC Agent Count Change' datatype='string' name='[Calculation_5771644439884390435]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_5771644439883829279] &lt; 0&#10;THEN &quot;▼&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Time Granularity Filter' datatype='string' name='[Date Granularity Filter (copy)_5771644441774530620]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Week&quot; THEN [week]&#10;END' />
            </column>
            <column caption='Global Agent Count Change ' datatype='real' default-format='p0.0%' name='[HrC Agent Count Change (copy)_5771644439954702379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(&#10;{ FIXED [Date Granularity Filter (copy)_5771644441774530620]:&#10;IF MAX([Is Current Date Granularity (copy)_5771644441782677565])&#10;THEN [Calculation_4769382405238243336]&#10;ELSE 0&#10;END&#10;}&#10;) &#10;- &#10;SUM(&#10;{ EXCLUDE [Date Granularity Filter (copy)_5771644441774530620]:&#10;SUM(&#10;IF [Is Previous Date Granularity (copy)_5771644441782849598]&#10;THEN { FIXED [Is Previous Date Granularity (copy)_5771644441782849598]:[Calculation_4769382405238243336]&#10;}&#10;ELSE 0&#10;END&#10;)&#10;}&#10;))&#10;/&#10;SUM(&#10;{ EXCLUDE [Date Granularity Filter (copy)_5771644441774530620]:&#10;SUM(&#10;IF [Is Previous Date Granularity (copy)_5771644441782849598]&#10;THEN { FIXED [Is Previous Date Granularity (copy)_5771644441782849598]:[Calculation_4769382405238243336]&#10;}&#10;ELSE 0&#10;END&#10;)&#10;}&#10;)' />
            </column>
            <column caption='Is Current Time Granularity ' datatype='boolean' name='[Is Current Date Granularity (copy)_5771644441782677565]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [Date Granularity Filter (copy)_5771644441774530620]: MAX([Date Granularity Filter (copy)_5771644441774530620])} = {FIXED: MAX([Date Granularity Filter (copy)_5771644441774530620])}' />
            </column>
            <column caption='Is Previous Time Granularity ' datatype='boolean' name='[Is Previous Date Granularity (copy)_5771644441782849598]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT [Is Current Date Granularity (copy)_5771644441782677565]&#10;AND&#10;{FIXED [Date Granularity Filter (copy)_5771644441774530620]: MAX([Date Granularity Filter (copy)_5771644441774530620])} &#10;= &#10;{FIXED [Is Current Date Granularity (copy)_5771644441782677565]: MAX([Date Granularity Filter (copy)_5771644441774530620])}' />
            </column>
            <column caption='Agent Facing Tool_old' datatype='string' name='[agent_facing_tool]' role='dimension' type='nominal' />
            <column caption='Count Active Agents Per Week At' datatype='integer' name='[count_active_agents_per_week_at]' role='measure' type='quantitative' />
