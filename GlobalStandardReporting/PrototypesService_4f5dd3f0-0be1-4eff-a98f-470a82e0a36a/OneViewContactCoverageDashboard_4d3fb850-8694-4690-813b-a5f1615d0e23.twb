              <calculation class='tableau' formula='IF [Calculation_4040502926568726566] &lt; 0&#10;THEN &quot;▼&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='LoB Positive CS % Diff' datatype='string' name='[Global Positive CS % Diff (copy)_4040502926569492524]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_4040502926568726566]&gt;= 0&#10;THEN &quot;▲&quot;&#10;ELSE &apos;&apos;&#10;END' />
