    <worksheet name='RS LoB Wise %'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Regular' fontsize='16'>% Coverage LoB: RS</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#cb2935' fontname='Tableau Regular' fontsize='16'><![CDATA[<[federated.06jagdi0gjnyo71fa0r0o0mfoj9h].[usr:LoB Negative CS % Diff (copy)_4040502926569349162:nk]>]]></run>
            <run fontalignment='1' fontcolor='#26b427' fontname='Tableau Regular' fontsize='16'><![CDATA[<[federated.06jagdi0gjnyo71fa0r0o0mfoj9h].[usr:LoB Positive CS % Diff (copy)_4040502926569566253:nk]>]]></run>
            <run bold='true' fontalignment='1' fontcolor='#555555' fontname='Tableau Regular' fontsize='10'><![CDATA[<[federated.06jagdi0gjnyo71fa0r0o0mfoj9h].[usr:% LoB CS Chg (copy)_4040502926568874023:qk]> ]]></run>
            <run fontalignment='1' fontcolor='#555555' fontsize='9'>vs Past Fortnight</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='oneview_contact_reason_coverage_report (rl_gcc_service)' name='federated.06jagdi0gjnyo71fa0r0o0mfoj9h' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06jagdi0gjnyo71fa0r0o0mfoj9h'>
            <column aggregation='Attribute' caption='% Current LoB RS Coverage  ' datatype='real' name='[% Current LoB CS Coverage  (copy)_4040502926568157217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;{ EXCLUDE [Calculation_4040502925602742281]:&#10;    SUM(&#10;    IF [Calculation_4040502925601513477]&#10;    AND [is_covered] = true&#10;    AND [stakeholder] = &apos;Rider&apos;&#10;    THEN [lob_wise_contribution]&#10;ELSE 0 END&#10;    )&#10;}&#10;END' />
            </column>
            <column caption='% LoB RS Chg' datatype='real' name='[% LoB CS Chg (copy)_4040502926568874023]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([% Current LoB CS Coverage  (copy)_4040502926568157217])-SUM([% Previous LoB CS Coverage (copy)_4040502926568534052]))&#10;/SUM([% Previous LoB CS Coverage (copy)_4040502926568534052])' />
            </column>
            <column aggregation='Attribute' caption='% Previous LoB RS Coverage' datatype='real' name='[% Previous LoB CS Coverage (copy)_4040502926568534052]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;{ EXCLUDE [Calculation_4040502925602742281]:&#10;    SUM(&#10;    IF [Calculation_4040502925601714182]&#10;    AND [is_covered] = true&#10;    AND [stakeholder] = &apos;Rider&apos;&#10;    THEN [lob_wise_contribution]&#10;ELSE 0 END&#10;    )&#10;}&#10;END' />
            </column>
            <column caption='is_current_week' datatype='boolean' name='[Calculation_4040502925601513477]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [created_week]: MAX([created_date])} = {FIXED: MAX([created_date])}' />
            </column>
            <column caption='is_previous_week' datatype='boolean' name='[Calculation_4040502925601714182]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT [Calculation_4040502925601513477]&#10;AND&#10;{FIXED [created_week]: MAX([created_date])} = {FIXED [Calculation_4040502925601513477]: MAX([created_date])}' />
            </column>
            <column caption='Date Range' datatype='string' datatype-customized='true' name='[Calculation_4040502925602742281]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Week&quot; THEN [created_week]&#10;END)' />
            </column>
            <column caption='Relative Date' datatype='date' name='[Calculation_4040502926637318192]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='[created_date]' />
            </column>
            <column caption='LoB Negative RS % Diff' datatype='string' name='[LoB Negative CS % Diff (copy)_4040502926569349162]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [% LoB CS Chg (copy)_4040502926568874023] &lt; 0&#10;THEN &quot;▼&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='LoB Positive RS % Diff' datatype='string' name='[LoB Positive CS % Diff (copy)_4040502926569566253]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [% LoB CS Chg (copy)_4040502926568874023]&gt;= 0&#10;THEN &quot;▲&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Date' datatype='date' name='[Relative Date (copy)_4040502926657540147]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='[created_date]' />
            </column>
