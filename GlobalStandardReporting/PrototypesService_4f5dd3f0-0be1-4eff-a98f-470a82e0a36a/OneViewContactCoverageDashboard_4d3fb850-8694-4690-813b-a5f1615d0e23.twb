            <run bold='true' fontalignment='1' fontcolor='#555555' fontname='Tableau Regular' fontsize='10'><![CDATA[<[federated.06jagdi0gjnyo71fa0r0o0mfoj9h].[usr:Calculation_4040502926568726566:qk]> ]]></run>
            <run fontalignment='1' fontcolor='#555555' fontsize='9'>vs Past Fortnight</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
