          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06jagdi0gjnyo71fa0r0o0mfoj9h'>
            <column aggregation='Attribute' caption='% Current Global RS Coverage ' datatype='real' name='[% Current Global CS Coverage  (copy)_4040502925616349202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;{ EXCLUDE [Calculation_4040502925602742281]:&#10;    SUM(&#10;    IF [Calculation_4040502925601513477]&#10;    AND [is_covered] = true&#10;    AND [stakeholder] = &apos;Rider&apos;&#10;    THEN [global_contribution]&#10;ELSE 0 END&#10;    )&#10;}&#10;END' />
            </column>
            <column caption='% Global RS Chg ' datatype='real' name='[% Global Chg (copy) (copy)_4040502925616648213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([% Current Global CS Coverage  (copy)_4040502925616349202])-SUM([% Previous Global Coverage (copy) (copy)_4040502925616705560]))&#10;/SUM([% Previous Global Coverage (copy) (copy)_4040502925616705560])' />
            </column>
            <column aggregation='Attribute' caption='% Previous Global RS Coverage' datatype='real' name='[% Previous Global Coverage (copy) (copy)_4040502925616705560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;{ EXCLUDE [Calculation_4040502925602742281]:&#10;    SUM(&#10;    IF [Calculation_4040502925601714182]&#10;    AND [is_covered] = true&#10;    AND [stakeholder] = &apos;Rider&apos;&#10;    THEN [global_contribution]&#10;ELSE 0 END&#10;    )&#10;}&#10;END' />
