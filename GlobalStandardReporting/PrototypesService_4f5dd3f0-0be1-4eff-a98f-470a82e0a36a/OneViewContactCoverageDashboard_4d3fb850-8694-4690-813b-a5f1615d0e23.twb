      <table>
        <view>
          <datasources>
            <datasource caption='oneview_contact_reason_coverage_report (rl_gcc_service)' name='federated.06jagdi0gjnyo71fa0r0o0mfoj9h' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06jagdi0gjnyo71fa0r0o0mfoj9h'>
            <column aggregation='Attribute' caption='% Current Global VS Coverage' datatype='real' name='[% Current Global CS Coverage  (copy) (copy)_4040502925616353299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;{ EXCLUDE [Calculation_4040502925602742281]:&#10;    SUM(&#10;    IF [Calculation_4040502925601513477]&#10;    AND [is_covered] = true&#10;    AND [stakeholder] = &apos;Vendor&apos;&#10;    THEN [global_contribution]&#10;ELSE 0 END&#10;    )&#10;}&#10;END' />
            </column>
            <column caption='% Global VS Chg ' datatype='real' name='[% Global Chg (copy) (copy) (copy)_4040502925616656406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([% Current Global CS Coverage  (copy) (copy)_4040502925616353299])-SUM([% Previous Global Coverage (copy) (copy) (copy)_4040502925616713753]))&#10;/SUM([% Previous Global Coverage (copy) (copy) (copy)_4040502925616713753])' />
            </column>
            <column aggregation='Attribute' caption='% Previous Global VS Coverage' datatype='real' name='[% Previous Global Coverage (copy) (copy) (copy)_4040502925616713753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;{ EXCLUDE [Calculation_4040502925602742281]:&#10;    SUM(&#10;    IF [Calculation_4040502925601714182]&#10;    AND [is_covered] = true&#10;    AND [stakeholder] = &apos;Vendor&apos;&#10;    THEN [global_contribution]&#10;ELSE 0 END&#10;    )&#10;}&#10;END' />
            </column>
            <column caption='is_current_week' datatype='boolean' name='[Calculation_4040502925601513477]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [created_week]: MAX([created_date])} = {FIXED: MAX([created_date])}' />
            </column>
            <column caption='is_previous_week' datatype='boolean' name='[Calculation_4040502925601714182]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT [Calculation_4040502925601513477]&#10;AND&#10;{FIXED [created_week]: MAX([created_date])} = {FIXED [Calculation_4040502925601513477]: MAX([created_date])}' />
            </column>
            <column caption='Date Range' datatype='string' datatype-customized='true' name='[Calculation_4040502925602742281]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Week&quot; THEN [created_week]&#10;END)' />
            </column>
            <column caption='Relative Date' datatype='date' name='[Calculation_4040502926637318192]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='[created_date]' />
            </column>
            <column caption='Global Negative VS % Diff ' datatype='string' name='[Global Negative % Diff  (copy) (copy) (copy)_4040502925617532956]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [% Global Chg (copy) (copy) (copy)_4040502925616656406] &lt; 0&#10;THEN &quot;▼&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Global Positive VS % Diff ' datatype='string' name='[Global Positive RS % Diff (copy)_4040502925618257951]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [% Global Chg (copy) (copy) (copy)_4040502925616656406]&gt;= 0&#10;THEN &quot;▲&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Date' datatype='date' name='[Relative Date (copy)_4040502926657540147]' role='dimension' type='quantitative'>
