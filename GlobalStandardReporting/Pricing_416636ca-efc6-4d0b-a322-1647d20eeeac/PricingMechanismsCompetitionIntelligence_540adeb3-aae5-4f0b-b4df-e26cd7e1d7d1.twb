      <aliases enabled='yes' />
      <column datatype='integer' name='[Address id]' role='dimension' type='ordinal' />
      <column caption='Competitor' datatype='string' name='[App]' role='dimension' type='nominal' />
      <column aggregation='CountD' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Basket value after discounts]' role='measure' type='quantitative' />
      <column datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[Basket value threshold for free delivery]' role='measure' type='quantitative' />
      <column datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Basket value]' role='measure' type='quantitative' />
      <column caption='App rank' datatype='integer' name='[Calculation_1334472876276928513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [App] = &apos;Pedidos Ya&apos; THEN 1 ELSE 2 END' />
      </column>
      <column caption='Date' datatype='datetime' name='[Calculation_1516868651311144961]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF ABS(DATEDIFF(&apos;day&apos;,[Scrapping date], [Timestamp]-5/24))&gt; 2 THEN [Timestamp]-5/24&#13;&#10;ELSE IFNULL([Scrapping date],[Timestamp]-5/24)&#13;&#10;END' />
      </column>
      <column caption='Tips/BV' datatype='real' default-format='p0.0%' name='[Calculation_1516868651318116354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Tips])/SUM([Basket value])' />
      </column>
      <column caption='SF/BV' datatype='real' default-format='p0.0%' name='[Calculation_1516868651318124547]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Service fee])/SUM([Basket value])' />
      </column>
      <column caption='DF/BV' datatype='real' default-format='p0.0%' name='[Calculation_1516868651318128644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Delivery fee])/SUM([Basket value])' />
      </column>
      <column aggregation='Sum' caption='Time of day' datatype='real' name='[Calculation_1516868651322589192]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='ROUND(([Date (Hours)]-1.5)/3)*3' />
        <aliases>
          <alias key='9.0' value='Morning' />
          <alias key='12.0' value='Lunch' />
          <alias key='15.0' value='Afternoon' />
          <alias key='18.0' value='Dinner' />
        </aliases>
      </column>
      <column caption='Net SF/BV' datatype='real' default-format='p0.0%' name='[Calculation_1516868651325337612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Service fee after discounts])/SUM(IFNULL([Basket value after discounts],[Basket value]))' />
      </column>
      <column caption='Has SOF' datatype='boolean' name='[Calculation_1516868651337457691]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([Small order fee or MOV top-up])&gt;0' />
      </column>
      <column caption='Has DBDF' datatype='boolean' name='[Calculation_1516868651770441766]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNT([__tableau_internal_object_id__].[Form_E35FB27698E64E8BA2ADD52D09DE3F1E]) &gt; 1 THEN&#13;&#10;MAX({ FIXED [country_code], [App], [Platform used], [city_id], [Date (Month / Day / Year)], [Calculation_1516868651322589192] : &#13;&#10;    COUNTD([Delivery fee]) }) &gt; 1&#13;&#10;ELSE NULL END' />
      </column>
      <column caption='Distance' datatype='real' name='[Calculation_1935421944451424260]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DISTANCE(&#13;&#10;MAKEPOINT([latitude (Vendors)],[longitude (Vendors)]),&#13;&#10;MAKEPOINT([latitude],[longitude]),&#13;&#10;&apos;km&apos;&#13;&#10;)' />
      </column>
      <column caption='User filter' datatype='boolean' name='[Calculation_527202635286556672]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
      </column>
      <column caption='Delivery Fee Comm' datatype='string' name='[Calculation_527202635292057602]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Pricing mechanisms],&apos;Delivery fee&apos;) THEN &apos;DF&apos; END' />
      </column>
      <column caption='Basket Value comm' datatype='string' name='[Calculation_527202635292172291]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Pricing mechanisms],&apos;Basket value&apos;) THEN &apos;BV deals&apos; END' />
      </column>
      <column caption='Surge Comm' datatype='string' name='[Calculation_527202635292213252]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Pricing mechanisms],&apos;Surge&apos;) THEN &apos;Surge&apos; END' />
      </column>
      <column caption='Food Discounts Comm' datatype='string' name='[Calculation_527202635292286981]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Pricing mechanisms],&apos;Food discounts&apos;) THEN &apos;Discounts&apos; END' />
      </column>
      <column caption='MOV Comm' datatype='string' name='[Calculation_527202635292319750]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Pricing mechanisms],&apos;Minimum Order Value&apos;) THEN &apos;MOV&apos; END' />
      </column>
      <column caption='Service Fee Comm' datatype='string' name='[Calculation_527202635292790791]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Pricing mechanisms],&apos;Service fee&apos;) THEN &apos;SF&apos; END' />
      </column>
      <column caption='FDNC Comm' datatype='string' name='[Calculation_527202635292823560]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Pricing mechanisms],&apos;Free delivery&apos;) THEN &apos;FDNC&apos; END' />
      </column>
      <column caption='Has PM Comm' datatype='boolean' name='[Calculation_527202635295793162]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([Calculation_527202635292057602])&#13;&#10;OR&#13;&#10;NOT ISNULL([Calculation_527202635292823560])&#13;&#10;OR&#13;&#10;NOT ISNULL([Calculation_527202635292286981])&#13;&#10;OR&#13;&#10;NOT ISNULL([Calculation_527202635292319750])&#13;&#10;OR&#13;&#10;NOT ISNULL([Calculation_527202635292790791])&#13;&#10;OR&#13;&#10;NOT ISNULL([Calculation_527202635292213252])&#13;&#10;OR&#13;&#10;NOT ISNULL([Calculation_527202635292172291])' />
      </column>
      <column datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Customer paid]' role='measure' type='quantitative' />
      <column caption='Has Time' datatype='boolean' name='[DBDF (copy)_1516868651771351079]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD([Calculation_1516868651322589192]) &gt; 1 THEN&#13;&#10;MAX({ FIXED [country_code], [App], [Platform used], [city_id], [Date (Week numbers)], [Address id]&#13;&#10;    : COUNTD([Delivery fee]) }) &gt; 1&#13;&#10;ELSE NULL END' />
      </column>
      <column caption='Has MOV' datatype='boolean' name='[DBDF (copy)_1516868651790024746]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNT([MOV]) &gt; 1 THEN&#13;&#10;MAX({ FIXED [country_code], [App], [Platform used], [city_id], [Date (Month / Day / Year)], [Address id] :&#13;&#10;    COUNTD([MOV]) }) &gt; 0&#13;&#10;ELSE NULL END' />
      </column>
      <column aggregation='Sum' datatype='integer' name='[Date (Hours)]' role='dimension' type='ordinal' user:agg-type='Hour' user:base-field='Calculation_1516868651311144961' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [Calculation_1516868651311144961])' />
      </column>
      <column aggregation='Sum' datatype='integer' name='[Date (Month / Day / Year)]' role='dimension' type='ordinal' user:agg-type='MDY' user:base-field='Calculation_1516868651311144961' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='(DATEPART(&apos;year&apos;, [Calculation_1516868651311144961])*10000 + DATEPART(&apos;month&apos;, [Calculation_1516868651311144961])*100 + DATEPART(&apos;day&apos;, [Calculation_1516868651311144961]))' />
      </column>
      <column aggregation='Sum' datatype='integer' name='[Date (Week numbers)]' role='dimension' type='ordinal' user:agg-type='Week' user:base-field='Calculation_1516868651311144961' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='DATEPART(&apos;week&apos;, [Calculation_1516868651311144961])' />
      </column>
