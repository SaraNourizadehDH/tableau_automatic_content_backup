            <column caption='Date' datatype='datetime' name='[Calculation_1516868651311144961]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF ABS(DATEDIFF(&apos;day&apos;,[Scrapping date], [Timestamp]-5/24))&gt; 2 THEN [Timestamp]-5/24&#13;&#10;ELSE IFNULL([Scrapping date],[Timestamp]-5/24)&#13;&#10;END' />
            </column>
            <column caption='Tips/BV' datatype='real' default-format='p0.0%' name='[Calculation_1516868651318116354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Tips])/SUM([Basket value])' />
            </column>
            <column caption='SF/BV' datatype='real' default-format='p0.0%' name='[Calculation_1516868651318124547]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Service fee])/SUM([Basket value])' />
            </column>
            <column caption='DF/BV' datatype='real' default-format='p0.0%' name='[Calculation_1516868651318128644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Delivery fee])/SUM([Basket value])' />
            </column>
            <column aggregation='Sum' caption='Time of day' datatype='real' name='[Calculation_1516868651322589192]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='ROUND(([Date (Hours)]-1.5)/3)*3' />
              <aliases>
                <alias key='9.0' value='Morning' />
                <alias key='12.0' value='Lunch' />
                <alias key='15.0' value='Afternoon' />
                <alias key='18.0' value='Dinner' />
              </aliases>
            </column>
            <column caption='Net SF/BV' datatype='real' default-format='p0.0%' name='[Calculation_1516868651325337612]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Service fee after discounts])/SUM(IFNULL([Basket value after discounts],[Basket value]))' />
            </column>
            <column caption='Distance' datatype='real' name='[Calculation_1935421944451424260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DISTANCE(&#13;&#10;MAKEPOINT([latitude (Vendors)],[longitude (Vendors)]),&#13;&#10;MAKEPOINT([latitude],[longitude]),&#13;&#10;&apos;km&apos;&#13;&#10;)' />
            </column>
