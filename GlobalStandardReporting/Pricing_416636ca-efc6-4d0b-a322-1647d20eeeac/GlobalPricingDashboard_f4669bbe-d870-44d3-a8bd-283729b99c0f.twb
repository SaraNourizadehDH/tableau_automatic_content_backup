          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Metric ' datatype='string' name='[Choose Dimension (A) (copia)_1019220897822756864]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders Total&quot;'>
              <calculation class='tableau' formula='&quot;Orders Total&quot;' />
            </column>
            <column alias='Include Zero' caption='Zero Axis' datatype='boolean' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='true'>
