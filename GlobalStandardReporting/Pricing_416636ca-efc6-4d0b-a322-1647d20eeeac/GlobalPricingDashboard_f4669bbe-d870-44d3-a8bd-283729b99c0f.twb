            <column caption='Period' datatype='string' name='[Calculation_1334754396853891210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date] &gt; [Parameters].[Test start (copy)] THEN &apos;After Ref.&apos;&#10;ELSEIF [date] &lt;= [Parameters].[Test start (copy)] AND [date] &gt;= [Parameters].[Parameter 1] THEN &apos;Ref.&apos;&#10;END' />
