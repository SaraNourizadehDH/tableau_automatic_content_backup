              <calculation class='tableau' formula='{MAX(DATEADD(&apos;day&apos;,0,(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,&#10;    IF DATEPART(&apos;day&apos;, { FIXED [Granularity (copy)_464715196823744580] : MAX([date])}) &lt;= 6 THEN -2 ELSE -1 END,&#10;{ FIXED [Granularity (copy)_464715196823744580] : MAX([date])})))))}' />
