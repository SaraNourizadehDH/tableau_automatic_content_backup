            <column caption='UTR Reference' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[PC1 Reference (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_SUM(SUM([Orders Total (copy)_1054686752841457674])*MIN([Reference period (copy 2)]))/&#13;&#10;WINDOW_SUM(SUM([Calculation_439382481406099463])*MIN([Reference period (copy 2)]))'>
