            <column caption='DH Rev Evolution' datatype='real' default-format='*&quot;+&quot;#,##0.0%;&quot;-&quot;#,##0.0%' name='[PC1 Avg. Evolution (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN((SUM([Calculation_1286622118875705346]))) - [PC1 Avg. Reference (copy)]) / ABS([PC1 Avg. Reference (copy)])'>
