      <column caption='Gross Profit Evolution' datatype='real' name='[Calculation_1599903833579696130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN((SUM([Calculation_1599903833578086400]))) - [Calculation_1599903833579462657]) / ABS([Calculation_1599903833579462657])'>
