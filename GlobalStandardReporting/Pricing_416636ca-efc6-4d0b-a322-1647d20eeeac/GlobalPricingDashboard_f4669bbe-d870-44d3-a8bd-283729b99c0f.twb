            <column caption='Total Commission' datatype='real' name='[Calculation_1286622118880763911]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [entity_display_name], [city], [zone], [vertical_type], [date], [df_lc], [df_eur],  [is_stacked], [is_own_delivery] : SUM([Calculation_464715196816117811]) }' />
            </column>
            <column caption='Filter last day' datatype='boolean' name='[Calculation_1489284113387163657]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &lt; { FIXED : MAX([date]) }' />
            </column>
            <column caption='Commission %' datatype='real' default-format='p0.0%' name='[Calculation_1885319442042429462]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1286622118880763911])/SUM([Calculation_1286622118875705346])' />
            </column>
            <column caption='Delivery Fee %' datatype='real' default-format='p0.0%' name='[Calculation_1885319442042441751]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Total DF Revenue (copy)_893683109265276929])/SUM([Calculation_1286622118875705346])' />
            </column>
            <column caption='commission' datatype='real' name='[Calculation_464715196816117811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Euro&apos; THEN [commission_eur] ELSE [commission_lc] END' />
            </column>
            <column caption='delivery_fee' datatype='real' name='[Calculation_464715196816498741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Euro&apos; THEN [delivery_fee_eur]&#13;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Local&apos; THEN [delivery_fee_lc]&#13;&#10;END' />
            </column>
            <column caption='joker' datatype='real' name='[Calculation_464715196816982071]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Euro&apos; THEN [joker_eur] ELSE [joker_local] END' />
            </column>
            <column caption='revenue_dh' datatype='real' name='[Calculation_464715196817338424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Euro&apos; THEN [revenue_dh_eur] ELSE [revenue_dh_lc] END&#13;&#10;//IFNULL([delivery_fee],0) + IFNULL([commission],0) + IFNULL([joker],0) // - IFNULL([delivery_fee_vat],0) &lt;-- to be added to the dataset, joker rev to be validated' />
            </column>
            <column caption='Default Ref. Start' datatype='datetime' datatype-customized='true' name='[Default Ref. End (copy)_1301540347149590531]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX(DATEADD(&apos;day&apos;,0,(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,&#10;    IF DATEPART(&apos;day&apos;, { FIXED [Granularity (copy)_464715196823744580] : MAX([date])}) &lt;= 6 THEN -2 ELSE -1 END,&#10;{ FIXED [Granularity (copy)_464715196823744580] : MAX([date])})))))}' />
            </column>
            <column caption='Area' datatype='string' name='[Granularity (copy)_464715196823744580]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Granularity (copy)_464715196823789637] = &apos;Global&apos; THEN &apos;DH&apos;&#13;&#10;ELSEIF [Parameters].[Granularity (copy)_464715196823789637] = &apos;Region&apos; THEN [region]&#13;&#10;ELSEIF [Parameters].[Granularity (copy)_464715196823789637] = &apos;Country&apos; THEN [country]&#13;&#10;ELSEIF [Parameters].[Granularity (copy)_464715196823789637] = &apos;Company&apos; THEN [company_name]&#13;&#10;ELSEIF [Parameters].[Granularity (copy)_464715196823789637] = &apos;Entity&apos; THEN [entity_display_name]&#13;&#10;ELSEIF [Parameters].[Granularity (copy)_464715196823789637] = &apos;City&apos; THEN [city]&#13;&#10;ELSEIF [Parameters].[Granularity (copy)_464715196823789637] = &apos;Zone&apos; THEN [zone]&#13;&#10;ELSEIF [Parameters].[Granularity (copy)_464715196823789637] = &apos;Weekday&apos; THEN DATENAME(&apos;weekday&apos;,[date])&#13;&#10;END' />
            </column>
            <column caption='DH Rev Evolution' datatype='real' default-format='*&quot;+&quot;#,##0.0%;&quot;-&quot;#,##0.0%' name='[PC1 Avg. Evolution (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN((SUM([Calculation_1286622118875705346]))) - [PC1 Avg. Reference (copy)]) / ABS([PC1 Avg. Reference (copy)])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='DH Rev Reference' datatype='real' name='[PC1 Avg. Reference (copy)]' role='measure' type='quantitative'>
