          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0e9s4ay1brv4ze131xvly1ttdo7i'>
            <column caption='CV' datatype='real' default-format='n#,##0;-#,##0' name='[ACV (copy)_464715196786262054]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [entity_display_name], [city], [zone], [vertical_type], [date], [df_lc], [df_eur], [is_own_delivery], [is_stacked] : SUM([commission_eur]) }' />
            </column>
            <column caption='Orders Total' datatype='integer' name='[Calculation_1286622118865899520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [entity_display_name], [city], [zone], [vertical_type], [date], [df_lc], [df_eur], [is_stacked], [is_own_delivery] : SUM([orders]) }' />
            </column>
            <column caption='Total DH Revenue' datatype='real' name='[Calculation_1286622118875705346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [entity_display_name], [city], [zone], [vertical_type], [date], [df_lc], [df_eur],  [is_stacked], [is_own_delivery] : SUM([Calculation_464715196817338424]) }' />
            </column>
            <column caption='Total DF Revenue' datatype='real' name='[Calculation_1286622118877085701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [entity_display_name], [city], [zone], [vertical_type], [date], [df_lc], [df_eur], [is_stacked], [is_own_delivery] : SUM([Calculation_464715196816498741]) }' />
            </column>
            <column caption='Dimension A' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_139330180109369344]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Country Parámetro]&#13;&#10;&#13;&#10;    WHEN &apos;Region&apos; THEN [region]&#13;&#10;    WHEN &apos;Country&apos; THEN [country]&#13;&#10;    WHEN &apos;City&apos; THEN [city]&#13;&#10;    WHEN &apos;Zone&apos; THEN [zone]&#13;&#10;    WHEN &apos;Is Own Delivery&apos; THEN STR([is_own_delivery])&#13;&#10;    WHEN &apos;Vertical Type&apos; THEN STR([vertical_type])&#13;&#10;    WHEN &apos;Is Stacked&apos; THEN STR([is_stacked])&#13;&#10;    WHEN &apos;Driving Distance Bucket&apos; THEN [drivingdistancebucket]&#13;&#10;    WHEN &apos;DF adjusted&apos; THEN [Calculation_464715196833329247]&#13;&#10;    WHEN &apos;None&apos; THEN &apos;&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Dimension B' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_139330180159877121]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Dimension (A) (copia)_139330180160065539]&#13;&#10;&#13;&#10;    WHEN &apos;Region&apos; THEN [region]&#13;&#10;    WHEN &apos;Country&apos; THEN [country]&#13;&#10;    WHEN &apos;City&apos; THEN [city]&#13;&#10;    WHEN &apos;Zone&apos; THEN [zone]&#13;&#10;    WHEN &apos;Is Own Delivery&apos; THEN STR([is_own_delivery])&#13;&#10;    WHEN &apos;Vertical Type&apos; THEN STR([vertical_type])&#13;&#10;    WHEN &apos;Is Stacked&apos; THEN STR([is_stacked])&#13;&#10;    WHEN &apos;Driving Distance Bucket&apos; THEN [drivingdistancebucket]&#13;&#10;    WHEN &apos;DF adjusted&apos; THEN [Calculation_464715196833329247]&#13;&#10;    WHEN &apos;None&apos; THEN &apos;&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Dimension C' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_139330180159983618]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Dimension (B) (copia)_139330180160348164]&#13;&#10;&#13;&#10;    WHEN &apos;Region&apos; THEN [region]&#13;&#10;    WHEN &apos;Country&apos; THEN [country]&#13;&#10;    WHEN &apos;City&apos; THEN [city]&#13;&#10;    WHEN &apos;Zone&apos; THEN [zone]&#13;&#10;    WHEN &apos;Is Own Delivery&apos; THEN STR([is_own_delivery])&#13;&#10;    WHEN &apos;Vertical Type&apos; THEN STR([vertical_type])&#13;&#10;    WHEN &apos;Is Stacked&apos; THEN STR([is_stacked])&#13;&#10;    WHEN &apos;Driving Distance Bucket&apos; THEN [drivingdistancebucket]&#13;&#10;    WHEN &apos;DF adjusted&apos; THEN [Calculation_464715196833329247]&#13;&#10;    WHEN &apos;None&apos; THEN &apos;&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='NPS' datatype='real' name='[Calculation_1555149312298430464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*(sum(Case [nps_group] when &apos;Promoter&apos; then [nps_responses] END)-sum(Case [nps_group] when &quot;Detractor&quot; then [nps_responses] END))&#13;&#10;/sum( [nps_responses] )' />
            </column>
            <column caption='od_orders' datatype='integer' name='[Calculation_1555149312604618765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Case [is_own_delivery] when  TRUE THEN [orders] END' />
            </column>
            <column caption='OD Orders Total' datatype='integer' name='[Calculation_1555149312604774414]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [entity_display_name], [city], [zone], [vertical_type], [date], [df_lc], [df_eur],  [is_stacked] : SUM([Calculation_1555149312604618765]) }' />
            </column>
            <column caption='Total Gross Profit' datatype='real' name='[Calculation_1599903833578086400]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [entity_display_name], [city], [zone], [vertical_type], [date], [df_lc], [df_eur],  [is_stacked], [is_own_delivery] : SUM([gross_profit_eur]) }' />
            </column>
            <column caption='Avg Gross Profit' datatype='real' name='[Calculation_1599903833580716035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1599903833578086400])/SUM([Calculation_1555149312604774414])' />
            </column>
            <column caption='delivery_costs' datatype='real' name='[Calculation_1660420953521610753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Euro&apos; THEN [delivery_costs_eur] ELSE [delivery_costs_local] END' />
            </column>
            <column caption='Total Delivery Costs' datatype='real' name='[Calculation_1660420953521926146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [entity_display_name], [city], [zone], [vertical_type], [date], [df_lc], [df_eur],  [is_stacked], [is_own_delivery] : SUM([Calculation_1660420953521610753]) }' />
            </column>
            <column caption='Avg Delivery Costs' datatype='real' name='[Calculation_1660420953527070723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1660420953521926146])/SUM([Calculation_1555149312604774414])' />
            </column>
            <column caption='DF/AOV' datatype='real' name='[Calculation_4277153034457772034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1286622118877085701])/SUM([Total DF Revenue (copy)_4277153034457587713])' />
            </column>
            <column caption='df' datatype='real' name='[Calculation_464715196815274034]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Euro&apos; THEN [df_eur]&#13;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Local&apos; THEN [df_lc]&#13;&#10;END' />
            </column>
            <column caption='delivery_fee' datatype='real' name='[Calculation_464715196816498741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Euro&apos; THEN [delivery_fee_eur]&#13;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Local&apos; THEN [delivery_fee_lc]&#13;&#10;END' />
            </column>
            <column caption='revenue_dh' datatype='real' name='[Calculation_464715196817338424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Euro&apos; THEN [revenue_dh_eur] ELSE [revenue_dh_lc] END&#13;&#10;//IFNULL([delivery_fee],0) + IFNULL([commission],0) + IFNULL([joker],0) // - IFNULL([delivery_fee_vat],0) &lt;-- to be added to the dataset, joker rev to be validated' />
            </column>
            <column caption='DF adjusted' datatype='string' name='[Calculation_464715196833329247]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[Calculation_464715196815274034] = 0 OR ISNULL([Calculation_464715196815274034]) THEN &apos;Free&apos;&#10;ELSEIF [Parameters].[Parameter 5]  = &apos;Euro&apos; AND {FIXED [country], STR(FLOOR([Calculation_464715196815274034]/0.5)*0.5)+&apos;-&apos;+STR(FLOOR([Calculation_464715196815274034]/0.5)*0.5+0.5) : SUM([Calculation_1286622118865899520])/MAX({FIXED [country]: SUM([Calculation_1286622118865899520])})} &lt; [Parameters].[Parameter 7]/100  THEN &apos;Other&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Euro&apos; THEN &apos;€&apos;+LEFT(STR(FLOOR([Calculation_464715196815274034]/0.5)*0.5+0.001),LEN(STR(FLOOR([Calculation_464715196815274034])))+3)+&apos;-€&apos;+LEFT(STR(FLOOR([Calculation_464715196815274034]/0.5)*0.5+0.499),LEN(STR(FLOOR([Calculation_464715196815274034])))+3)&#10;ELSEIF {FIXED [Calculation_464715196815274034], [country] : SUM([Calculation_1286622118865899520])}/({FIXED [country] : (SUM([Calculation_1286622118865899520]))}) &lt; ([Parameters].[Parameter 7] / 100) THEN &apos;Other&apos;&#10;ELSE &#10;    IF LEFT(STR(INT(ROUND([Calculation_464715196815274034],2)*100)), LEN(STR(INT(ROUND([Calculation_464715196815274034],2)*100))) - 2) = &apos;&apos; THEN &apos;0&apos; ELSE&#10;    LEFT(STR(INT(ROUND([Calculation_464715196815274034],2)*100) ), LEN(STR(INT(ROUND([Calculation_464715196815274034],2)*100))) - 2) END&#10;    + &quot;.&quot; + RIGHT(STR(INT(ROUND([Calculation_464715196815274034],2)*100)), 2)+ [currency]&#10;END' />
              <aliases>
                <alias key='&quot;Free&quot;' value='0 - Free' />
              </aliases>
            </column>
            <column caption='Driving Time Total' datatype='real' name='[Calculation_830069748763209729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [entity_display_name], [city], [zone], [vertical_type], [date], [drivingdistancebucket],  [is_stacked] : MAX([totaldrivingtime])} / 60 / 60 / 24' />
            </column>
            <column caption='Avg DH Revenue' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Delivery Fee (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1286622118875705346])/SUM([Calculation_1286622118865899520])' />
            </column>
            <column caption='Avg Paid Delivery Fee' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Delivery Fee Average (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1286622118877085701])/SUM([Calculation_1286622118865899520])' />
            </column>
            <column caption='Avg Driving Distance' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Driving Time Average (copy 2)_761952798338113537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Driving Time Total (copy 2)_761952798338215938])/SUM([Drivings With Time (copy)_880735254345297920])' />
            </column>
            <column caption='Drivings With Time' datatype='integer' name='[Driving Time Total (copy 2)_464715196762177542]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [entity_display_name], [city], [zone], [vertical_type], [date], [is_own_delivery], [is_stacked], [drivingdistancebucket] : MAX([totaldrivingswithtime])}' />
            </column>
            <column caption='Driving Distance Total' datatype='real' name='[Driving Time Total (copy 2)_761952798338215938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [entity_display_name], [city], [zone], [vertical_type], [date], [drivingdistancebucket],  [is_stacked] : MAX([totaldrivingdistance])} / 1000' />
            </column>
            <column caption='Avg Driving Time' datatype='real' default-format='*nn:ss' name='[Driving Time Total (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_830069748763209729])/SUM([Driving Time Total (copy 2)_464715196762177542])' />
            </column>
            <column caption='Drivings With Distance' datatype='integer' name='[Drivings With Time (copy)_880735254345297920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [entity_display_name], [city], [zone], [vertical_type], [date],[is_stacked], [is_own_delivery], [drivingdistancebucket] : MAX([totaldrivingswithdistance])}' />
            </column>
            <column caption='Avg Commission Value' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[PC1 (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ACV (copy)_464715196786262054])/SUM([Calculation_1286622118865899520])' />
            </column>
            <column caption='Displayed period' datatype='string' name='[Reference period (copy)]' role='measure' type='nominal'>
              <calculation class='tableau' formula='str(DAY(DATE((MAX([date])-MIN([Parameters].[Parameter 4],DATEDIFF(&apos;day&apos;,MIN([date]),MAX([date])-2))-2))))+&apos;.&apos;&#13;&#10;+str(MONTH(DATE((MAX([date])-MIN([Parameters].[Parameter 4],DATEDIFF(&apos;day&apos;,MIN([date]),MAX([date])-2))-2))))+&apos;.&apos;&#13;&#10;+right(str(YEAR(DATE((MAX([date])-MIN([Parameters].[Parameter 4],DATEDIFF(&apos;day&apos;,MIN([date]),MAX([date])-2))-2)))),2)&#13;&#10;&#13;&#10;+&apos; - &apos;+&#13;&#10;&#13;&#10;str(DAY(DATE(MAX([date]))))+&apos;.&apos;&#13;&#10;+str(MONTH(DATE(MAX([date]))))+&apos;.&apos;&#13;&#10;+right(str(YEAR(DATE(MAX([date])))),2)' />
            </column>
            <column caption='Total  GMV' datatype='real' name='[Total DF Revenue (copy)_4277153034457587713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [entity_display_name], [city], [zone], [vertical_type], [date], [df_lc], [df_eur], [is_stacked], [is_own_delivery] : SUM([delivery_fee (copy)_4277153034457456640]) }' />
