            </column>
            <column caption='Currency' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
              <aliases>
                <alias key='&quot;Local&quot;' value='Local Currency' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0e9s4ay1brv4ze131xvly1ttdo7i'>
            <column caption='CV' datatype='real' default-format='n#,##0;-#,##0' name='[ACV (copy)_464715196786262054]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [entity_display_name], [city], [zone], [vertical_type], [date], [df_lc], [df_eur], [is_own_delivery], [is_stacked] : SUM([commission_eur]) }' />
            </column>
            <column caption='Orders Total' datatype='integer' name='[Calculation_1286622118865899520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [entity_display_name], [city], [zone], [vertical_type], [date], [df_lc], [df_eur], [is_stacked], [is_own_delivery] : SUM([orders]) }' />
            </column>
            <column caption='Total DH Revenue' datatype='real' name='[Calculation_1286622118875705346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [entity_display_name], [city], [zone], [vertical_type], [date], [df_lc], [df_eur],  [is_stacked], [is_own_delivery] : SUM([Calculation_464715196817338424]) }' />
            </column>
            <column caption='Total DF Revenue' datatype='real' name='[Calculation_1286622118877085701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [entity_display_name], [city], [zone], [vertical_type], [date], [df_lc], [df_eur], [is_stacked], [is_own_delivery] : SUM([Calculation_464715196816498741]) }' />
            </column>
            <column caption='Filter last day' datatype='boolean' name='[Calculation_1489284113387163657]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &lt; { FIXED : MAX([date]) }' />
            </column>
            <column caption='NPS' datatype='real' name='[Calculation_1555149312298430464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100*(sum(Case [nps_group] when &apos;Promoter&apos; then [nps_responses] END)-sum(Case [nps_group] when &quot;Detractor&quot; then [nps_responses] END))&#13;&#10;/sum( [nps_responses] )' />
            </column>
            <column caption='od_orders' datatype='integer' name='[Calculation_1555149312604618765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Case [is_own_delivery] when  TRUE THEN [orders] END' />
            </column>
            <column caption='OD Orders Total' datatype='integer' name='[Calculation_1555149312604774414]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [entity_display_name], [city], [zone], [vertical_type], [date], [df_lc], [df_eur],  [is_stacked] : SUM([Calculation_1555149312604618765]) }' />
            </column>
            <column caption='Total Gross Profit' datatype='real' name='[Calculation_1599903833578086400]' role='measure' type='quantitative'>
