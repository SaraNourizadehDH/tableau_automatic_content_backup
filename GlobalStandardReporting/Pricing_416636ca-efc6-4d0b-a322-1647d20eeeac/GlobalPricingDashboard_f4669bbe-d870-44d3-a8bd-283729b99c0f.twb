      <column caption='Reference period' datatype='string' name='[Calculation_1752463250592944189]' role='measure' type='nominal'>
        <calculation class='tableau' formula='str(datepart(&apos;day&apos;,MAX(MIN([date]),[Parameters].[Parameter 1])))+&apos;.&apos;&#13;&#10;+str(datepart(&apos;month&apos;,MAX(MIN([date]),[Parameters].[Parameter 1])))+&apos;.&apos;&#13;&#10;+right(str((datepart(&apos;year&apos;,MAX(MIN([date]),[Parameters].[Parameter 1])))),2)&#13;&#10;&#13;&#10;+&apos; - &apos;+&#13;&#10;&#13;&#10;str(datepart(&apos;day&apos;,DATE([Parameters].[Test start (copy)])))+&apos;.&apos;&#13;&#10;+str(datepart(&apos;month&apos;,DATE([Parameters].[Test start (copy)])))+&apos;.&apos;&#13;&#10;+right(str((datepart(&apos;year&apos;,DATE([Parameters].[Test start (copy)])))),2)' />
