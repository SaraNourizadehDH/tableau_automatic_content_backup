            </column>
            <column caption='Default Ref. Start' datatype='datetime' datatype-customized='true' name='[Default Ref. End (copy)_1301540347149590531]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX(DATEADD(&apos;day&apos;,0,(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,&#10;    IF DATEPART(&apos;day&apos;, { FIXED [Granularity (copy)_464715196823744580] : MAX([date])}) &lt;= 6 THEN -2 ELSE -1 END,&#10;{ FIXED [Granularity (copy)_464715196823744580] : MAX([date])})))))}' />
            </column>
            <column caption='Avg Driving Distance' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Driving Time Average (copy 2)_761952798338113537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Driving Time Total (copy 2)_761952798338215938])/SUM([Drivings With Time (copy)_880735254345297920])' />
            </column>
            <column caption='Driving Distance Evolution' datatype='real' default-format='*&quot;+&quot;#,##0.0%;&quot;-&quot;#,##0.0%' name='[Driving Time Evolution (copy 2)_761952798339186692]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Driving Time Average (copy 2)_761952798338113537]) - [Driving Time Reference (copy 3)_761952798338842627]) / ABS([Driving Time Reference (copy 3)_761952798338842627])'>
