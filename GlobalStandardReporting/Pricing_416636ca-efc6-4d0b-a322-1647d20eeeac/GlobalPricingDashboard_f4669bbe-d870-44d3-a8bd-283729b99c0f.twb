            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0e9s4ay1brv4ze131xvly1ttdo7i].[Default Ref. End (copy)_1301540347149590531]' caption='Reference Period Start' datatype='date' default-format='*dd.mm.yyyy' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='#2023-07-18#'>
              <calculation class='tableau' formula='#2023-07-18#' />
            </column>
            <column caption='Displayed period' datatype='integer' default-format='*0 days' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value='180'>
              <calculation class='tableau' formula='180' />
              <range granularity='1' max='180' min='1' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
              <aliases>
                <alias key='&quot;Local&quot;' value='Local Currency' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0e9s4ay1brv4ze131xvly1ttdo7i].[Period End (copy)_1301540347146248194]' caption='Reference Period End' datatype='date' default-format='*dd.mm.yyyy' name='[Test start (copy)]' param-domain-type='any' role='measure' type='quantitative' value='#2023-07-18#'>
              <calculation class='tableau' formula='#2023-07-18#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0e9s4ay1brv4ze131xvly1ttdo7i'>
            <column caption='Display filter' datatype='boolean' name='[Calculation_1156299259153158144]' role='measure' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,&#13;&#10;    LOOKUP(MIN({ FIXED [Granularity (copy)_464715196823744580],[date] : MIN([date]) }),0),&#13;&#10;    MAX({ FIXED [Granularity (copy)_464715196823744580] : MAX([date])})&#13;&#10;)&lt;=[Parameters].[Parameter 4]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Orders Total' datatype='integer' name='[Calculation_1286622118865899520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [entity_display_name], [city], [zone], [vertical_type], [date], [df_lc], [df_eur], [is_stacked], [is_own_delivery] : SUM([orders]) }' />
            </column>
            <column caption='Total DH Revenue' datatype='real' name='[Calculation_1286622118875705346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [entity_display_name], [city], [zone], [vertical_type], [date], [df_lc], [df_eur],  [is_stacked], [is_own_delivery] : SUM([Calculation_464715196817338424]) }' />
            </column>
            <column caption='Filter last day' datatype='boolean' name='[Calculation_1489284113387163657]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &lt; { FIXED : MAX([date]) }' />
            </column>
            <column caption='stacked_orders' datatype='integer' name='[Calculation_1555149312601047050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Case [is_stacked] when  TRUE THEN [orders] END' />
            </column>
            <column caption='% Stacked' datatype='real' name='[Calculation_1555149312602349579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1555149312602832908])/sum([Calculation_1555149312604774414])' />
            </column>
            <column caption='Stacked Orders Total' datatype='integer' name='[Calculation_1555149312602832908]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [entity_display_name], [city], [zone], [vertical_type], [date], [df_lc], [df_eur],  [is_own_delivery] : SUM([Calculation_1555149312601047050]) }' />
            </column>
            <column caption='od_orders' datatype='integer' name='[Calculation_1555149312604618765]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Case [is_own_delivery] when  TRUE THEN [orders] END' />
            </column>
            <column caption='OD Orders Total' datatype='integer' name='[Calculation_1555149312604774414]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [entity_display_name], [city], [zone], [vertical_type], [date], [df_lc], [df_eur],  [is_stacked] : SUM([Calculation_1555149312604618765]) }' />
            </column>
            <column caption='% Stacking Reference' datatype='real' name='[Calculation_1555149312607297552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(([Calculation_1555149312602349579])*MIN([Reference period (copy 2)]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Delivery Costs %' datatype='real' name='[Calculation_1599903833587707911]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1660420953521926146])/SUM([Calculation_1286622118875705346])' />
            </column>
            <column caption='delivery_costs' datatype='real' name='[Calculation_1660420953521610753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Euro&apos; THEN [delivery_costs_eur] ELSE [delivery_costs_local] END' />
            </column>
            <column caption='Total Delivery Costs' datatype='real' name='[Calculation_1660420953521926146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [entity_display_name], [city], [zone], [vertical_type], [date], [df_lc], [df_eur],  [is_stacked], [is_own_delivery] : SUM([Calculation_1660420953521610753]) }' />
            </column>
            <column caption='Avg Delivery Costs' datatype='real' name='[Calculation_1660420953527070723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1660420953521926146])/SUM([Calculation_1555149312604774414])' />
            </column>
            <column caption='Delivery Costs Avg Reference' datatype='real' name='[Calculation_1660420953527345156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_SUM(SUM([Calculation_1660420953521926146])*MIN([Reference period (copy 2)]))/&#13;&#10;WINDOW_SUM(SUM([Calculation_1286622118865899520])*MIN([Reference period (copy 2)]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Delivery Costs Avg Evolution' datatype='real' name='[Calculation_1660420953532563461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(([Calculation_1660420953527070723])) - [Calculation_1660420953527345156]) / ABS([Calculation_1660420953527345156])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Riders Working Time' datatype='real' name='[Calculation_439382481406099463]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED  [city], [zone], [vertical_type], [date] : SUM([actualworkingtimeinsec]/60/60)}' />
            </column>
            <column caption='revenue_dh' datatype='real' name='[Calculation_464715196817338424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Euro&apos; THEN [revenue_dh_eur] ELSE [revenue_dh_lc] END&#13;&#10;//IFNULL([delivery_fee],0) + IFNULL([commission],0) + IFNULL([joker],0) // - IFNULL([delivery_fee_vat],0) &lt;-- to be added to the dataset, joker rev to be validated' />
            </column>
            <column caption='Default Ref. Start' datatype='datetime' datatype-customized='true' name='[Default Ref. End (copy)_1301540347149590531]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX(DATEADD(&apos;day&apos;,0,(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,&#10;    IF DATEPART(&apos;day&apos;, { FIXED [Granularity (copy)_464715196823744580] : MAX([date])}) &lt;= 6 THEN -2 ELSE -1 END,&#10;{ FIXED [Granularity (copy)_464715196823744580] : MAX([date])})))))}' />
            </column>
            <column caption='Filter last week' datatype='boolean' name='[Filter last day (copy)_2684919454224695296]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='Week([date]) &lt; { FIXED : MAX(week([date])) }' />
            </column>
            <column caption='Area' datatype='string' name='[Granularity (copy)_464715196823744580]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Granularity (copy)_464715196823789637] = &apos;Global&apos; THEN &apos;DH&apos;&#13;&#10;ELSEIF [Parameters].[Granularity (copy)_464715196823789637] = &apos;Region&apos; THEN [region]&#13;&#10;ELSEIF [Parameters].[Granularity (copy)_464715196823789637] = &apos;Country&apos; THEN [country]&#13;&#10;ELSEIF [Parameters].[Granularity (copy)_464715196823789637] = &apos;Company&apos; THEN [company_name]&#13;&#10;ELSEIF [Parameters].[Granularity (copy)_464715196823789637] = &apos;Entity&apos; THEN [entity_display_name]&#13;&#10;ELSEIF [Parameters].[Granularity (copy)_464715196823789637] = &apos;City&apos; THEN [city]&#13;&#10;ELSEIF [Parameters].[Granularity (copy)_464715196823789637] = &apos;Zone&apos; THEN [zone]&#13;&#10;ELSEIF [Parameters].[Granularity (copy)_464715196823789637] = &apos;Weekday&apos; THEN DATENAME(&apos;weekday&apos;,[date])&#13;&#10;END' />
            </column>
            <column caption='Orders Total (UTR)' datatype='integer' name='[Orders Total (copy)_1054686752841457674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE [company_name],[entity_display_name],[vertical_type],  [is_stacked], [is_own_delivery] : SUM([Calculation_1555149312604774414]) }' />
            </column>
            <column caption='Default Ref. End' datatype='datetime' datatype-customized='true' name='[Period End (copy)_1301540347146248194]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX(DATEADD(&apos;day&apos;,-1,(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,&#10;    IF DATEPART(&apos;day&apos;, { FIXED [Granularity (copy)_464715196823744580] : MAX([date])}) &lt;= 6 THEN -1 ELSE 0 END,&#10;{ FIXED [Granularity (copy)_464715196823744580] : MAX([date])})))))}' />
            </column>
            <column caption='Reference period verifier' datatype='integer' name='[Reference period (copy 2)]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [date] &lt;= [Parameters].[Test start (copy)] and [date] &gt;= [Parameters].[Parameter 1] THEN 1 END' />
            </column>
