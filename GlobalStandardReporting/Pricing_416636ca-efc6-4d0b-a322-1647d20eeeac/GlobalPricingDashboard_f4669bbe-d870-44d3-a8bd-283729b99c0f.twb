          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Aggregation Level' datatype='string' name='[Granularity (copy)_464715196823789637]' param-domain-type='list' role='measure' type='nominal' value='&quot;Global&quot;'>
              <calculation class='tableau' formula='&quot;Global&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0e9s4ay1brv4ze131xvly1ttdo7i].[Default Ref. End (copy)_1301540347149590531]' caption='Reference Period Start' datatype='date' default-format='*dd.mm.yyyy' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='#2023-07-18#'>
              <calculation class='tableau' formula='#2023-07-18#' />
            </column>
            <column caption='Displayed period' datatype='integer' default-format='*0 days' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value='180'>
              <calculation class='tableau' formula='180' />
              <range granularity='1' max='180' min='1' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
              <aliases>
                <alias key='&quot;Local&quot;' value='Local Currency' />
              </aliases>
            </column>
            <column caption='Threshold %' datatype='real' name='[Parameter 7]' param-domain-type='range' role='measure' type='quantitative' value='2.5'>
              <calculation class='tableau' formula='2.5' />
              <range max='100.0' min='0.0' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0e9s4ay1brv4ze131xvly1ttdo7i].[Period End (copy)_1301540347146248194]' caption='Reference Period End' datatype='date' default-format='*dd.mm.yyyy' name='[Test start (copy)]' param-domain-type='any' role='measure' type='quantitative' value='#2023-07-18#'>
              <calculation class='tableau' formula='#2023-07-18#' />
            </column>
            <column caption='Toggle' datatype='string' name='[User Filter Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Stacked&quot;'>
              <calculation class='tableau' formula='&quot;Stacked&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0e9s4ay1brv4ze131xvly1ttdo7i'>
            <column caption='Orders Share' datatype='real' name='[Calculation_1054686752769835011]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[User Filter Parameter] = &apos;Stacked&apos; THEN SUM([Calculation_1286622118865899520]) ELSE SUM([Calculation_1286622118865899520])/TOTAL(SUM([Calculation_1286622118865899520])) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Display filter' datatype='boolean' name='[Calculation_1156299259153158144]' role='measure' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,&#13;&#10;    LOOKUP(MIN({ FIXED [Granularity (copy)_464715196823744580],[date] : MIN([date]) }),0),&#13;&#10;    MAX({ FIXED [Granularity (copy)_464715196823744580] : MAX([date])})&#13;&#10;)&lt;=[Parameters].[Parameter 4]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Period End' datatype='date' name='[Calculation_1213720152531263489]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Test start (copy)]+1' />
            </column>
            <column caption='Orders Total' datatype='integer' name='[Calculation_1286622118865899520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [entity_display_name], [city], [zone], [vertical_type], [date], [df_lc], [df_eur], [is_stacked], [is_own_delivery] : SUM([orders]) }' />
            </column>
            <column caption='Filter last day' datatype='boolean' name='[Calculation_1489284113387163657]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] &lt; { FIXED : MAX([date]) }' />
            </column>
            <column caption='df' datatype='real' name='[Calculation_464715196815274034]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Euro&apos; THEN [df_eur]&#13;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Local&apos; THEN [df_lc]&#13;&#10;END' />
            </column>
            <column caption='DF adjusted' datatype='string' name='[Calculation_464715196833329247]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[Calculation_464715196815274034] = 0 OR ISNULL([Calculation_464715196815274034]) THEN &apos;Free&apos;&#10;ELSEIF [Parameters].[Parameter 5]  = &apos;Euro&apos; AND {FIXED [country], STR(FLOOR([Calculation_464715196815274034]/0.5)*0.5)+&apos;-&apos;+STR(FLOOR([Calculation_464715196815274034]/0.5)*0.5+0.5) : SUM([Calculation_1286622118865899520])/MAX({FIXED [country]: SUM([Calculation_1286622118865899520])})} &lt; [Parameters].[Parameter 7]/100  THEN &apos;Other&apos;&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Euro&apos; THEN &apos;€&apos;+LEFT(STR(FLOOR([Calculation_464715196815274034]/0.5)*0.5+0.001),LEN(STR(FLOOR([Calculation_464715196815274034])))+3)+&apos;-€&apos;+LEFT(STR(FLOOR([Calculation_464715196815274034]/0.5)*0.5+0.499),LEN(STR(FLOOR([Calculation_464715196815274034])))+3)&#10;ELSEIF {FIXED [Calculation_464715196815274034], [country] : SUM([Calculation_1286622118865899520])}/({FIXED [country] : (SUM([Calculation_1286622118865899520]))}) &lt; ([Parameters].[Parameter 7] / 100) THEN &apos;Other&apos;&#10;ELSE &#10;    IF LEFT(STR(INT(ROUND([Calculation_464715196815274034],2)*100)), LEN(STR(INT(ROUND([Calculation_464715196815274034],2)*100))) - 2) = &apos;&apos; THEN &apos;0&apos; ELSE&#10;    LEFT(STR(INT(ROUND([Calculation_464715196815274034],2)*100) ), LEN(STR(INT(ROUND([Calculation_464715196815274034],2)*100))) - 2) END&#10;    + &quot;.&quot; + RIGHT(STR(INT(ROUND([Calculation_464715196815274034],2)*100)), 2)+ [currency]&#10;END' />
              <aliases>
                <alias key='&quot;Free&quot;' value='0 - Free' />
              </aliases>
            </column>
            <column caption='Default Ref. Start' datatype='datetime' datatype-customized='true' name='[Default Ref. End (copy)_1301540347149590531]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX(DATEADD(&apos;day&apos;,0,(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,&#10;    IF DATEPART(&apos;day&apos;, { FIXED [Granularity (copy)_464715196823744580] : MAX([date])}) &lt;= 6 THEN -2 ELSE -1 END,&#10;{ FIXED [Granularity (copy)_464715196823744580] : MAX([date])})))))}' />
            </column>
            <column caption='Orders Reference' datatype='real' default-format='n#,##0;-#,##0' name='[Driving Time Reference (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(SUM([Calculation_1286622118865899520])*MIN([Reference period (copy 2)]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Area' datatype='string' name='[Granularity (copy)_464715196823744580]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Granularity (copy)_464715196823789637] = &apos;Global&apos; THEN &apos;DH&apos;&#13;&#10;ELSEIF [Parameters].[Granularity (copy)_464715196823789637] = &apos;Region&apos; THEN [region]&#13;&#10;ELSEIF [Parameters].[Granularity (copy)_464715196823789637] = &apos;Country&apos; THEN [country]&#13;&#10;ELSEIF [Parameters].[Granularity (copy)_464715196823789637] = &apos;Company&apos; THEN [company_name]&#13;&#10;ELSEIF [Parameters].[Granularity (copy)_464715196823789637] = &apos;Entity&apos; THEN [entity_display_name]&#13;&#10;ELSEIF [Parameters].[Granularity (copy)_464715196823789637] = &apos;City&apos; THEN [city]&#13;&#10;ELSEIF [Parameters].[Granularity (copy)_464715196823789637] = &apos;Zone&apos; THEN [zone]&#13;&#10;ELSEIF [Parameters].[Granularity (copy)_464715196823789637] = &apos;Weekday&apos; THEN DATENAME(&apos;weekday&apos;,[date])&#13;&#10;END' />
            </column>
            <column caption='Orders Evolution (Total)' datatype='real' default-format='*&quot;+&quot;#,##0.0%;&quot;-&quot;#,##0.0%' name='[Orders Evolution (copy 3)_880735254473072660]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([Orders Total (copy)_880735254476406805])) - [Orders Reference (copy 2)_880735254472433683]) / ABS([Orders Reference (copy 2)_880735254472433683])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Orders Reference (Total)' datatype='real' default-format='n#,##0;-#,##0' name='[Orders Reference (copy 2)_880735254472433683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(SUM([Orders Total (copy)_880735254476406805])*MIN([Reference period (copy 2)]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Orders Evolution' datatype='real' default-format='*&quot;+&quot;#,##0.0%;&quot;-&quot;#,##0.0%' name='[Orders Reference (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([Calculation_1286622118865899520])) - [Driving Time Reference (copy)]) / ABS([Driving Time Reference (copy)])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column aggregation='Attribute' caption='Orders Total (Total)' datatype='integer' default-format='n#,##0;-#,##0' name='[Orders Total (copy)_880735254476406805]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE [Calculation_464715196833329247] : SUM(&#13;&#10;{ FIXED  [entity_display_name], [city], [zone], [vertical_type], [date], [df_lc], [df_eur], [is_stacked], [is_own_delivery] : SUM([orders]) }) }' />
            </column>
            <column caption='Default Ref. End' datatype='datetime' datatype-customized='true' name='[Period End (copy)_1301540347146248194]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX(DATEADD(&apos;day&apos;,-1,(DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,&#10;    IF DATEPART(&apos;day&apos;, { FIXED [Granularity (copy)_464715196823744580] : MAX([date])}) &lt;= 6 THEN -1 ELSE 0 END,&#10;{ FIXED [Granularity (copy)_464715196823744580] : MAX([date])})))))}' />
            </column>
            <column caption='Reference period verifier' datatype='integer' name='[Reference period (copy 2)]' role='measure' type='ordinal'>
