            <column caption='Choose Dimension (A)' datatype='string' name='[Country Parámetro]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
              <aliases>
                <alias key='&quot;DF adjusted&quot;' value='Delivery Fee Bucket' />
                <alias key='&quot;drivingdistancebucket&quot;' value='Driving Distance Bucket' />
