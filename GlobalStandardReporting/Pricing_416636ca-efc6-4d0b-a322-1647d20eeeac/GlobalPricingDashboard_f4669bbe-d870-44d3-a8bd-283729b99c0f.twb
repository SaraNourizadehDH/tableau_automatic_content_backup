            </column>
            <column caption='Avg Driving Distance Reference' datatype='real' name='[Calculation_3149142059668578305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_SUM(([Driving Time Reference (copy 3)_761952798338842627])*MIN([Reference period (copy 2)]))/&#10;WINDOW_SUM(SUM([Drivings With Time (copy)_880735254345297920])*MIN([Reference period (copy 2)]))'>
                <table-calc ordering-type='Rows' />
