            <column caption='revenue_dh' datatype='real' name='[Calculation_464715196817338424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Euro&apos; THEN [revenue_dh_eur] ELSE [revenue_dh_lc] END&#13;&#10;//IFNULL([delivery_fee],0) + IFNULL([commission],0) + IFNULL([joker],0) // - IFNULL([delivery_fee_vat],0) &lt;-- to be added to the dataset, joker rev to be validated' />
