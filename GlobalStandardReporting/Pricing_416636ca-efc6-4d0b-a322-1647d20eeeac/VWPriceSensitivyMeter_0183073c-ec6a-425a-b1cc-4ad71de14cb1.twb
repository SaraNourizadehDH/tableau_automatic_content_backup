            <column caption='Response Validator' datatype='boolean' name='[response_validator]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_221028293785833541]' derivation='Sum' name='[sum:Calculation_221028293785833541:qk]' pivot='key' type='quantitative' />
