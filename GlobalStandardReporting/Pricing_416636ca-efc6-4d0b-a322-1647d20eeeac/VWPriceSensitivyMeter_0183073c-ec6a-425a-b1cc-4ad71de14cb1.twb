              <calculation class='tableau' formula='0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ude35s0nmvwuu1fpflbe19rnexk'>
            <column caption='Number of Records' datatype='integer' name='[Calculation_221028293771661321]' role='measure' type='quantitative' user:auto-column='numrec'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Responses' datatype='integer' name='[Calculation_221028293785833541]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [response_id] : MAX([Calculation_221028293771661321]) }' />
            </column>
            <column caption='Total Responses' datatype='integer' name='[Calculation_5568630571555373060]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_221028293785833541])' />
            </column>
            <column caption='Above threshold' datatype='boolean' name='[Calculation_5568630571555848198]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_5568630571555373060] &gt;= [Parameters].[Choose Dimension (A) (copy)_5568630571554869251] &#10;THEN TRUE &#10;ELSE FALSE &#10;END' />
            </column>
            <column caption='Survey Recency' datatype='string' name='[Calculation_6403274258579398657]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;month&apos;, {FIXED [country_name]: MAX([wave])}, TODAY()) &lt;= 1&#10;  THEN &apos;New&apos; &#10;ELSEIF DATEDIFF(&apos;month&apos;, {FIXED [country_name]: MAX([wave])}, TODAY()) &lt;= 6&#10;  THEN &apos;Middle&apos; &#10;ELSEIF DATEDIFF(&apos;month&apos;, {FIXED [country_name]: MAX([wave])}, TODAY()) &gt; 6&#10;  THEN &apos;Old&apos; &#10;END' />
            </column>
            <column caption='Last Survey' datatype='string' name='[Survey Recency (copy)_6403274258581319682]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEDIFF(&apos;month&apos;, {FIXED [country_name]: MAX([wave])}, TODAY()))+ &apos; months ago&apos;' />
            </column>
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_6403274258579398657]' derivation='None' name='[none:Calculation_6403274258579398657:nk]' pivot='key' type='nominal' />
