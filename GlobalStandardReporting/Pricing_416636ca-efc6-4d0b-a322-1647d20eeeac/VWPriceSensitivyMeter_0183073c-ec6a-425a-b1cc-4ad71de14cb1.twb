              <calculation class='tableau' formula='IF DATEDIFF(&apos;month&apos;, {FIXED [country_name]: MAX([wave])}, TODAY()) &lt;= 1&#10;  THEN &apos;New&apos; &#10;ELSEIF DATEDIFF(&apos;month&apos;, {FIXED [country_name]: MAX([wave])}, TODAY()) &lt;= 6&#10;  THEN &apos;Middle&apos; &#10;ELSEIF DATEDIFF(&apos;month&apos;, {FIXED [country_name]: MAX([wave])}, TODAY()) &gt; 6&#10;  THEN &apos;Old&apos; &#10;END' />
            </column>
            <column caption='Last Survey' datatype='string' name='[Survey Recency (copy)_6403274258581319682]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEDIFF(&apos;month&apos;, {FIXED [country_name]: MAX([wave])}, TODAY()))+ &apos; months ago&apos;' />
