            </column>
            <column caption='Orders %' datatype='real' default-format='p0.0%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders]) / TOTAL(SUM([orders]))'>
                <table-calc ordering-type='Columns' />
              </calculation>
