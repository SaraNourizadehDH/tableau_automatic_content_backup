            <column caption='Approx. CVR3' datatype='real' default-format='p0.0%' name='[Calculation_1814669242985902090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM([orders]/[cvr3])' />
