            </column>
            <column caption='Denominator' datatype='real' name='[Calculation_1814669242988044299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Average&apos; THEN MIN(1)&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% of Basket Value&apos; THEN [Calculation_2071374419510095874] / 100&#13;&#10;END' />
            </column>
            <column caption='Bin Basket' datatype='real' name='[Calculation_1814669243004100648]' role='measure' type='quantitative'>
