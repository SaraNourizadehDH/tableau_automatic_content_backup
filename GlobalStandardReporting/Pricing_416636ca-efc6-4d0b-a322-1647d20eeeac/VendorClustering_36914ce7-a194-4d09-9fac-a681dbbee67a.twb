          <datasource-dependencies datasource='federated.0i3data1v1xb7m15ii8zm0oh8g6a'>
            <column caption='Delivery Cost' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Basket (copy)_2071374419513585675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-SUM([avg_delivery_cost]*[orders])/SUM([orders])' />
            </column>
