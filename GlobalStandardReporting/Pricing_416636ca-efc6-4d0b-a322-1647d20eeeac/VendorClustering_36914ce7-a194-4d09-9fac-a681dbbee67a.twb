      <aliases enabled='yes' />
      <column caption='Current Gross Profit' datatype='real' name='[Calculation_1715871460030054400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[current_average_vendor_fees]+[current_average_customer_fees]-[current_average_delivery_cost]' />
      </column>
      <column caption='Tier Share ' datatype='integer' name='[Calculation_4929400900383580170]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IFNULL(SUM([cum_share])-LOOKUP(ZN(SUM([cum_share])), -1),SUM([cum_share]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='CF/BV' datatype='real' name='[Calculation_4929400900385316876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([current_average_customer_fees])/SUM([current_average_basket_value_local])*100' />
      </column>
      <column caption='KPI' datatype='real' name='[Calculation_4929400900386115597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Metric type (copy)] = &apos;Basket Value&apos; THEN AVG([current_average_basket_value_local])&#10;ELSEIF [Parameters].[Metric type (copy)] = &apos;Customer Fees&apos; THEN AVG([current_average_customer_fees])&#10;ELSEIF [Parameters].[Metric type (copy)] = &apos;Delivery Cost&apos; THEN AVG([current_average_delivery_cost])&#10;ELSEIF [Parameters].[Metric type (copy)] = &apos;DH Incentives&apos; THEN AVG([current_average_dh_incentives])&#10;ELSEIF [Parameters].[Metric type (copy)] = &apos;Other Incentives&apos; THEN AVG([current_average_other_incentives])&#10;ELSEIF [Parameters].[Metric type (copy)] = &apos;Travel Time Fee&apos; THEN AVG([current_average_travel_time_fee_local])&#10;ELSEIF [Parameters].[Metric type (copy)] = &apos;Vendor Fees&apos; THEN AVG([current_average_vendor_fees])&#10;ELSEIF [Parameters].[Metric type (copy)] = &apos;Travel Time&apos; THEN AVG([dps_travel_time_decimal])&#10;ELSEIF [Parameters].[Metric type (copy)] = &apos;Median Travel Time Fee&apos; THEN AVG([median_tt_fee])&#10;ELSEIF [Parameters].[Metric type (copy)] = &apos;CF/BV&apos; THEN [Calculation_4929400900385316876]&#13;&#10;ELSEIF [Parameters].[Metric type (copy)] = &apos;Gross Profit&apos; THEN AVG([Calculation_1715871460030054400])&#10;END' />
      </column>
      <column caption='Entitlement' datatype='boolean' name='[Calculation_792070585839968256]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='KPI (secondary)' datatype='real' name='[KPI (copy)_4929400900388347919]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Chosen Metric (copy)_4929400900388261902] = &apos;Basket Value&apos; THEN AVG([current_average_basket_value_local])&#10;ELSEIF [Parameters].[Chosen Metric (copy)_4929400900388261902] = &apos;Customer Fees&apos; THEN AVG([current_average_customer_fees])&#10;ELSEIF [Parameters].[Chosen Metric (copy)_4929400900388261902] = &apos;Delivery Cost&apos; THEN AVG([current_average_delivery_cost])&#10;ELSEIF [Parameters].[Chosen Metric (copy)_4929400900388261902] = &apos;DH Incentives&apos; THEN AVG([current_average_dh_incentives])&#10;ELSEIF [Parameters].[Chosen Metric (copy)_4929400900388261902] = &apos;Other Incentives&apos; THEN AVG([current_average_other_incentives])&#10;ELSEIF [Parameters].[Chosen Metric (copy)_4929400900388261902] = &apos;Travel Time Fee&apos; THEN AVG([current_average_travel_time_fee_local])&#10;ELSEIF [Parameters].[Chosen Metric (copy)_4929400900388261902] = &apos;Vendor Fees&apos; THEN AVG([current_average_vendor_fees])&#10;ELSEIF [Parameters].[Chosen Metric (copy)_4929400900388261902] = &apos;Travel Time&apos; THEN AVG([dps_travel_time_decimal])&#10;ELSEIF [Parameters].[Chosen Metric (copy)_4929400900388261902] = &apos;Median Travel Time Fee&apos; THEN AVG([median_tt_fee])&#10;ELSEIF [Parameters].[Chosen Metric (copy)_4929400900388261902] = &apos;CF/BV&apos; THEN [Calculation_4929400900385316876]&#13;&#10;ELSEIF [Parameters].[Chosen Metric (copy)_4929400900388261902] = &apos;Gross Profit&apos; THEN AVG([Calculation_1715871460030054400])&#10;END' />
