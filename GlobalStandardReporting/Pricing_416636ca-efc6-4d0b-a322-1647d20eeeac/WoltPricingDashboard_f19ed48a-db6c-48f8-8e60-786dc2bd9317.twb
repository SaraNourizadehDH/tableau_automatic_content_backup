      <column caption='Avg DF DH' datatype='real' name='[Calculation_3041055666722013187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_fee_local])/sum([orders])' />
      </column>
      <column caption='Avg Food Value' datatype='real' name='[Calculation_3041055666722193412]' role='measure' type='quantitative'>
