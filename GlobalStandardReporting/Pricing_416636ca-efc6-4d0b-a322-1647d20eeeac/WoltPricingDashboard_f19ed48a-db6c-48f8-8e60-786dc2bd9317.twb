      <column caption='Avg DF Wolt' datatype='real' name='[Calculation_3041055666721755138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([delivery_fee_wolt])/sum([Calculation_3041055666721624065])' />
