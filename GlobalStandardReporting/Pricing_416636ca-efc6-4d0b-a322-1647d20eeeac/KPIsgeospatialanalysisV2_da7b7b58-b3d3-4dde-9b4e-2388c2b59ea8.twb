      <aliases enabled='yes' />
      <column caption='Opportunity index' datatype='real' default-format='p0.0%' name='[Calculation_1700953287293329410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( // Orders&#13;&#10;[Percentile (Hex orders) (copy)_1700953287296081924] * [Parameters].[Parameter 3]&#13;&#10;// Primary KPI&#13;&#10;+ IF [Parameters].[Parameter 4]&#13;&#10;    THEN [Percentile (Hex) (copy)_1728537832145059843]&#13;&#10;    ELSE (1 - [Percentile (Hex) (copy)_1728537832145059843])&#13;&#10;    END  * [Parameters].[Order Share Weight (copy)_1700953287293095936]&#13;&#10;&#13;&#10;// Secondary KPI&#13;&#10;+ IF [Parameters].[Primary KPI direction (copy)_1700953287301246985]&#13;&#10;    THEN [Primary Percentile (copy)_290763651201159175]&#13;&#10;    ELSE (1 - [Primary Percentile (copy)_290763651201159175])&#13;&#10;    END  * [Parameters].[Primary KPI Weight (copy)_1700953287293198337]&#13;&#10;) / &#13;&#10;([Parameters].[Parameter 3] &#13;&#10;+ [Parameters].[Order Share Weight (copy)_1700953287293095936] &#13;&#10;+ [Parameters].[Primary KPI Weight (copy)_1700953287293198337])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Order Weight' datatype='real' default-format='p0.0%' name='[Calculation_1700953288313487372]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3]/([Parameters].[Parameter 3]+[Parameters].[Order Share Weight (copy)_1700953287293095936]+[Parameters].[Primary KPI Weight (copy)_1700953287293198337])' />
      </column>
      <column caption='Hexagon' datatype='spatial' name='[Calculation_1728537832115220480]' role='measure' type='nominal'>
        <calculation class='tableau' formula='BUFFER(MAKEPOINT([latitude],[longitude]),(90-ABS([latitude]))/30*25+100,&apos;m&apos;)' />
      </column>
      <column caption='Primary Percentile (Hex)' datatype='real' default-format='p0%' name='[Calculation_1728537832143859713]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_PERCENTILE(SUM([KPI (copy)_3239565936888627207]))'>
