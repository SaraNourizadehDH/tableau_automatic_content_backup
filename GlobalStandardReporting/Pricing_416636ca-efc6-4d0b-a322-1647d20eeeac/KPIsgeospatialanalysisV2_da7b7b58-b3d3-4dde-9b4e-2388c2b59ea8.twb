              <calculation class='tableau' formula='( // Orders&#13;&#10;[Percentile (Hex orders) (copy)_1700953287296081924] * [Parameters].[Parameter 3]&#13;&#10;// Primary KPI&#13;&#10;+ IF [Parameters].[Parameter 4]&#13;&#10;    THEN [Percentile (Hex) (copy)_1728537832145059843]&#13;&#10;    ELSE (1 - [Percentile (Hex) (copy)_1728537832145059843])&#13;&#10;    END  * [Parameters].[Order Share Weight (copy)_1700953287293095936]&#13;&#10;&#13;&#10;// Secondary KPI&#13;&#10;+ IF [Parameters].[Primary KPI direction (copy)_1700953287301246985]&#13;&#10;    THEN [Primary Percentile (copy)_290763651201159175]&#13;&#10;    ELSE (1 - [Primary Percentile (copy)_290763651201159175])&#13;&#10;    END  * [Parameters].[Primary KPI Weight (copy)_1700953287293198337]&#13;&#10;) / &#13;&#10;([Parameters].[Parameter 3] &#13;&#10;+ [Parameters].[Order Share Weight (copy)_1700953287293095936] &#13;&#10;+ [Parameters].[Primary KPI Weight (copy)_1700953287293198337])'>
