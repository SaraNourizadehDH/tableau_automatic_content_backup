            </properties>
          </object>
          <object caption='Logistics Zones' id='_52B840C12FFC43E5812E62291E53193A'>
            <properties context=''>
              <relation connection='bigquery.0sz7dn00nf05ce1e7i3d91ysc283' name='Custom SQL Query4' type='text'>with&#13;
dps_entities as (&#13;
  select&#13;
    global_entity_id,&#13;
    country_code,&#13;
  from `fulfillment-dwh-production.dl.dynamic_pricing_global_configuration`&#13;
),&#13;
zone_shapes as (&#13;
select&#13;
    dps.global_entity_id,&#13;
    co.country_code,&#13;
    co.country_iso,&#13;
    ci.name city_name,&#13;
    ci.id city_id,&#13;
    zo.name zone_name,&#13;
    zo.shape zone_shape,&#13;
from `fulfillment-dwh-production.cl.countries` co&#13;
inner join dps_entities dps using(country_code)&#13;
left join unnest(co.cities) ci&#13;
left join unnest(ci.zones) zo&#13;
where true&#13;
    and ci.is_active&#13;
    and zo.is_active)&#13;
select&#13;
    h.global_entity_id,&#13;
    h.city_name,&#13;
    z.zone_name,&#13;
    h.h3,&#13;
from `logistics-data-storage-staging.long_term_pricing.hexagon_data` h&#13;
left join zone_shapes z&#13;
  on h.global_entity_id = z.global_entity_id&#13;
    and st_contains(z.zone_shape, st_geogpoint(h.longitude, h.latitude))</relation>
            </properties>
            <properties context='extract'>
              <relation name='Custom SQL Query4' table='[Extract].[Custom SQL Query4]' type='table' />
            </properties>
          </object>
