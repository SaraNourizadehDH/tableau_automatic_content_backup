          <relation connection='bigquery.0sz7dn00nf05ce1e7i3d91ysc283' name='Custom SQL Query3' type='text'>select &apos;AFV&apos; as filter_2 union all&#13;
select &apos;CF % of AFV&apos; as filter_2 union all&#13;
