      <column caption='Primary KPI' datatype='real' name='[Calculation_3410702722695450624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(IF     [filter]  =  &apos;AFV&apos; THEN ROUND([weighted_afv],2)&#10;ELSEIF [filter]  =  &apos;CF % of AFV&apos; THEN ROUND([weighted_cf_share]*100,1)&#10;ELSEIF [filter]  =  &apos;Avg take-in&apos; THEN ROUND([weighted_take_in],2)&#10;ELSEIF [filter]  =  &apos;Avg take-in % of AFV&apos; THEN ROUND([weighted_take_in_share]*100,1)&#10;ELSEIF [filter]  =  &apos;CPO&apos; THEN ROUND([weighted_cpo],2)&#10;ELSEIF [filter]  =  &apos;CPO % of AFV&apos; THEN ROUND([weighted_cpo_share]*100,1)&#10;ELSEIF [filter]  =  &apos;GPO&apos; THEN ROUND([weighted_gpo],2)&#10;ELSEIF [filter]  =  &apos;GPO % of AFV&apos; THEN ROUND([weighted_gpo_share]*100,1)&#10;ELSEIF [filter]  =  &apos;Incentive % of AFV&apos; THEN ROUND([weighted_incentive_share]*100,1)&#10;ELSEIF [filter]  =  &apos;FLGPO&apos; THEN ROUND([weighted_flgpo],2)&#10;ELSEIF [filter]  =  &apos;FLGPO % of AFV&apos; THEN ROUND([weighted_flgpo_share]*100,1)&#10;ELSEIF [filter]  =  &apos;Loved Brand % of Orders&apos; THEN ROUND([weighted_lb_share]*100,1)&#10;ELSEIF [filter]  =  &apos;Hex orders&apos; THEN IFNULL(ROUND([hex_orders],1),ROUND([hex_orders],1))&#10;ELSEIF [filter]  =  &apos;Weighted orders&apos; THEN ROUND([order_weight],1)&#13;&#10;ELSEIF [filter]  =  &apos;Avg DF&apos; THEN ROUND([weighted_df],1)&#13;&#10;END)' />
      </column>
      <column caption='Primary KPI (hex)' datatype='real' name='[KPI (copy)_3239565936888627207]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(IF  [hex_filter]  =  &apos;AFV&apos; THEN ROUND([hex_afv],2)&#10;//ELSEIF [hex_filter]  =  &apos;CF % of AFV&apos; THEN ROUND([Weighted Cf Share]*100,1)&#10;ELSEIF [hex_filter]  =  &apos;Avg take-in&apos; THEN ROUND([hex_take_in],2)&#10;//ELSEIF [hex_filter]  =  &apos;Avg take-in % of AFV&apos; THEN ROUND([Weighted Take In Share]*100,1)&#10;ELSEIF [hex_filter]  =  &apos;CPO&apos; THEN ROUND([hex_cpo],2)&#10;//ELSEIF [hex_filter]  =  &apos;CPO % of AFV&apos; THEN ROUND([Weighted Cpo Share]*100,1)&#10;ELSEIF [hex_filter]  =  &apos;GPO&apos; THEN ROUND([hex_gpo],2)&#10;//ELSEIF [hex_filter]  =  &apos;GPO % of AFV&apos; THEN ROUND([Weighted Gpo Share]*100,1)&#10;//ELSEIF [hex_filter]  =  &apos;Incentive % of AFV&apos; THEN ROUND([Weighted Incentive Share]*100,1)&#10;ELSEIF [hex_filter]  =  &apos;FLGPO&apos; THEN ROUND([hex_flgpo],2)&#10;//ELSEIF [hex_filter]  =  &apos;FLGPO % of BV&apos; THEN ROUND([Weighted Flgpo Share]*100,1)&#10;ELSEIF [hex_filter]  =  &apos;Loved Brand % of Orders&apos; THEN ROUND([hex_lb_share]*100,1)&#10;ELSEIF [hex_filter]  =  &apos;Orders&apos; THEN ROUND([hex_orders],1)&#10;ELSEIF [hex_filter]  =  &apos;Orders 2&apos; THEN ROUND([hex_orders],1)&#13;&#10;ELSEIF [hex_filter] = &apos;Avg DF&apos; THEN ROUND ([hex_df],1)&#10;END)' />
      </column>
      <column caption='Percentile (Weighted orders)' datatype='real' default-format='p0%' name='[Percentile (Hex orders) (copy)_1700953287296081924]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(RANK_PERCENTILE(SUM([order_weight])))'>
          <table-calc ordering-field='[federated.03hbhel00oh42r163vu4n15j9019].[h3]' ordering-type='Field' />
