      <datasource-dependencies datasource='federated.03hbhel00oh42r163vu4n15j9019'>
        <column caption='Primary KPI (hex)' datatype='real' name='[KPI (copy)_3239565936888627207]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='ZN(IF  [hex_filter]  =  &apos;AFV&apos; THEN ROUND([hex_afv],2)&#10;//ELSEIF [hex_filter]  =  &apos;CF % of AFV&apos; THEN ROUND([Weighted Cf Share]*100,1)&#10;ELSEIF [hex_filter]  =  &apos;Avg take-in&apos; THEN ROUND([hex_take_in],2)&#10;//ELSEIF [hex_filter]  =  &apos;Avg take-in % of AFV&apos; THEN ROUND([Weighted Take In Share]*100,1)&#10;ELSEIF [hex_filter]  =  &apos;CPO&apos; THEN ROUND([hex_cpo],2)&#10;//ELSEIF [hex_filter]  =  &apos;CPO % of AFV&apos; THEN ROUND([Weighted Cpo Share]*100,1)&#10;ELSEIF [hex_filter]  =  &apos;GPO&apos; THEN ROUND([hex_gpo],2)&#10;//ELSEIF [hex_filter]  =  &apos;GPO % of AFV&apos; THEN ROUND([Weighted Gpo Share]*100,1)&#10;//ELSEIF [hex_filter]  =  &apos;Incentive % of AFV&apos; THEN ROUND([Weighted Incentive Share]*100,1)&#10;ELSEIF [hex_filter]  =  &apos;FLGPO&apos; THEN ROUND([hex_flgpo],2)&#10;//ELSEIF [hex_filter]  =  &apos;FLGPO % of BV&apos; THEN ROUND([Weighted Flgpo Share]*100,1)&#10;ELSEIF [hex_filter]  =  &apos;Loved Brand % of Orders&apos; THEN ROUND([hex_lb_share]*100,1)&#10;ELSEIF [hex_filter]  =  &apos;Orders&apos; THEN ROUND([hex_orders],1)&#10;ELSEIF [hex_filter]  =  &apos;Orders 2&apos; THEN ROUND([hex_orders],1)&#13;&#10;ELSEIF [hex_filter] = &apos;Avg DF&apos; THEN ROUND ([hex_df],1)&#10;END)' />
        </column>
        <column caption='Secondary KPI (hex)' datatype='real' name='[Primary KPI (hex) (copy)_290763651201159174]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='ZN(IF  [hex_filter_2]  =  &apos;AFV&apos; THEN ROUND([hex_afv],2)&#10;//ELSEIF [[hex_filter_2]]  =  &apos;CF % of BV&apos; THEN ROUND([Weighted Cf Share]*100,1)&#10;ELSEIF [hex_filter_2]  =  &apos;Avg take-in&apos; THEN ROUND([hex_take_in],2)&#10;//ELSEIF [[hex_filter_2]]  =  &apos;Avg take-in % of BV&apos; THEN ROUND([Weighted Take In Share]*100,1)&#10;ELSEIF [hex_filter_2]  =  &apos;CPO&apos; THEN ROUND([hex_cpo],2)&#10;//ELSEIF [[hex_filter_2]]  =  &apos;CPO % of BV&apos; THEN ROUND([Weighted Cpo Share]*100,1)&#10;ELSEIF [hex_filter_2]  =  &apos;GPO&apos; THEN ROUND([hex_gpo],2)&#10;//ELSEIF [[hex_filter_2]]  =  &apos;GPO % of BV&apos; THEN ROUND([Weighted Gpo Share]*100,1)&#10;//ELSEIF [[hex_filter_2]]  =  &apos;Incentive % of BV&apos; THEN ROUND([Weighted Incentive Share]*100,1)&#10;ELSEIF [hex_filter_2]  =  &apos;FLGPO&apos; THEN ROUND([hex_flgpo],2)&#10;//ELSEIF [[hex_filter_2]]  =  &apos;FLGPO % of BV&apos; THEN ROUND([Weighted Flgpo Share]*100,1)&#10;ELSEIF [hex_filter_2]  =  &apos;Loved Brand % of Orders&apos; THEN ROUND([hex_lb_share]*100,1)&#10;ELSEIF [hex_filter_2]  =  &apos;Orders&apos; THEN ROUND([hex_orders],1)&#10;ELSEIF [hex_filter_2]  =  &apos;Orders 2&apos; THEN ROUND([hex_orders],1)&#13;&#10;ELSEIF [hex_filter_2] = &apos;Avg DF&apos; THEN ROUND([hex_df],1)&#10;END)' />
