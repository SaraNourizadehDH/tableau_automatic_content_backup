    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Weighted KPIs'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/Book1/WeightedKPIs_1?rev=' id='WeightedKPIs' path='/t/GlobalStandardReporting/workbooks/KPIsgeospatialanalysisV2' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='800' maxwidth='1400' minheight='800' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource caption='hexagon _data' name='federated.03hbhel00oh42r163vu4n15j9019' />
      </datasources>
      <datasource-dependencies datasource='federated.03hbhel00oh42r163vu4n15j9019'>
        <column caption='Primary KPI' datatype='real' name='[Calculation_3410702722695450624]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='ZN(IF     [filter]  =  &apos;AFV&apos; THEN ROUND([weighted_afv],2)&#10;ELSEIF [filter]  =  &apos;CF % of AFV&apos; THEN ROUND([weighted_cf_share]*100,1)&#10;ELSEIF [filter]  =  &apos;Avg take-in&apos; THEN ROUND([weighted_take_in],2)&#10;ELSEIF [filter]  =  &apos;Avg take-in % of AFV&apos; THEN ROUND([weighted_take_in_share]*100,1)&#10;ELSEIF [filter]  =  &apos;CPO&apos; THEN ROUND([weighted_cpo],2)&#10;ELSEIF [filter]  =  &apos;CPO % of AFV&apos; THEN ROUND([weighted_cpo_share]*100,1)&#10;ELSEIF [filter]  =  &apos;GPO&apos; THEN ROUND([weighted_gpo],2)&#10;ELSEIF [filter]  =  &apos;GPO % of AFV&apos; THEN ROUND([weighted_gpo_share]*100,1)&#10;ELSEIF [filter]  =  &apos;Incentive % of AFV&apos; THEN ROUND([weighted_incentive_share]*100,1)&#10;ELSEIF [filter]  =  &apos;FLGPO&apos; THEN ROUND([weighted_flgpo],2)&#10;ELSEIF [filter]  =  &apos;FLGPO % of AFV&apos; THEN ROUND([weighted_flgpo_share]*100,1)&#10;ELSEIF [filter]  =  &apos;Loved Brand % of Orders&apos; THEN ROUND([weighted_lb_share]*100,1)&#10;ELSEIF [filter]  =  &apos;Hex orders&apos; THEN IFNULL(ROUND([hex_orders],1),ROUND([hex_orders],1))&#10;ELSEIF [filter]  =  &apos;Weighted orders&apos; THEN ROUND([order_weight],1)&#13;&#10;ELSEIF [filter]  =  &apos;Avg DF&apos; THEN ROUND([weighted_df],1)&#13;&#10;END)' />
        </column>
        <column caption='Secondary KPI' datatype='real' name='[Primary KPI (copy)_290763651201159173]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='ZN(IF  [filter_2]  =  &apos;AFV&apos; THEN ROUND([weighted_afv],2)&#10;ELSEIF [filter_2]  =  &apos;CF % of AFV&apos; THEN ROUND([weighted_cf_share]*100,1)&#10;ELSEIF [filter_2]  =  &apos;Avg take-in&apos; THEN ROUND([weighted_take_in],2)&#10;ELSEIF [filter_2]  =  &apos;Avg take-in % of AFV&apos; THEN ROUND([weighted_take_in_share]*100,1)&#10;ELSEIF [filter_2]  =  &apos;CPO&apos; THEN ROUND([weighted_cpo],2)&#10;ELSEIF [filter_2]  =  &apos;CPO % of AFV&apos; THEN ROUND([weighted_cpo_share]*100,1)&#10;ELSEIF [filter_2]  =  &apos;GPO&apos; THEN ROUND([weighted_gpo],2)&#10;ELSEIF [filter_2]  =  &apos;GPO % of AFV&apos; THEN ROUND([weighted_gpo_share]*100,1)&#10;ELSEIF [filter_2]  =  &apos;Incentive % of AFV&apos; THEN ROUND([weighted_incentive_share]*100,1)&#10;ELSEIF [filter_2]  =  &apos;FLGPO&apos; THEN ROUND([weighted_flgpo],2)&#10;ELSEIF [filter_2]  =  &apos;FLGPO % of AFV&apos; THEN ROUND([weighted_flgpo_share]*100,1)&#10;ELSEIF [filter_2]  =  &apos;Loved Brand % of Orders&apos; THEN ROUND([weighted_lb_share]*100,1)&#10;ELSEIF [filter_2]  =  &apos;Hex orders&apos; THEN IFNULL(ROUND([hex_orders],1),ROUND([hex_orders],1))&#10;ELSEIF [filter_2]  =  &apos;Weighted orders&apos; THEN ROUND([order_weight],1)&#13;&#10;ELSEIF [filter_2]  =  &apos;Avg DF&apos; THEN ROUND([weighted_df],1)&#10;END)' />
        </column>
