    <worksheet name='what-if-scenario'>
      <layout-options>
        <title>
          <formatted-text>
            <run>What-if scenarios</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='BigQuery' name='federated.0sum6q90ofhiyj147j94f143q68c' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Calculation Type' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Relative&quot;'>
              <calculation class='tableau' formula='&quot;Relative&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0sum6q90ofhiyj147j94f143q68c'>
            <column caption='sim_orders' datatype='real' name='[Calculation_1088815632303624192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1201124146876149768] + [Calculation_1201124146844348418]' />
            </column>
            <column caption='revenue' datatype='real' name='[Calculation_1088815632305475590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1201124146876149768] * [avg_revenue]' />
            </column>
            <column caption='sim_revenue' datatype='real' name='[Calculation_1088815632528281614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[sim_GMV (copy)_1088815632310489096] * [Calculation_1088815632303624192]' />
            </column>
            <column caption='sim_avg_delivery_fee' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1201124146838953984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[avg_delivery_fee_local] * ( 1 + [pct_change]/100)' />
            </column>
            <column caption=' Δ CVR3 [p.p]' datatype='real' default-format='p0.00%' name='[Calculation_1201124146840231937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[coef_avg (Custom SQL Query)] * [avg_delivery_fee_local] * [pct_change]/100' />
            </column>
            <column caption='Δ Orders' datatype='integer' name='[Calculation_1201124146844348418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOOR([Calculation_1201124146840231937] * [n_sessions])' />
            </column>
            <column caption='Δ Revenue' datatype='real' name='[Calculation_1201124146844696579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1088815632528281614] - [Calculation_1088815632305475590]' />
            </column>
            <column caption='Δ  Profit' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1201124146845360133]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1972435953171693569] - [Calculation_1972435953171603456]' />
            </column>
            <column caption='Avg Orders' datatype='real' name='[Calculation_1201124146876149768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[cvr3] * [n_sessions]' />
            </column>
            <column caption='Δ DF' datatype='real' name='[Calculation_1201124146877325323]' role='measure' type='quantitative'>
