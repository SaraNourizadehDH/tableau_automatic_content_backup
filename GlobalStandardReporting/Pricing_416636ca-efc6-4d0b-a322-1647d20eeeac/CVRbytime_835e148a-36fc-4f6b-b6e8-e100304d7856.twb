      <aliases enabled='yes' />
      <column caption='No vendor visited share' datatype='real' default-format='p0.0%' name='[CVR (copy)_1333065533607874560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions_no_vendors_visited])/SUM([sessions])' />
      </column>
      <column caption='Weekday' datatype='string' name='[Calculation_667095736116256771]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;, [hour]) &lt; 6&#13;&#10;THEN &#13;&#10;&#13;&#10;DATENAME(&apos;weekday&apos;, &#13;&#10;DATEADD(&apos;hour&apos;,-6,[hour]))&#13;&#10;&#13;&#10;ELSE&#13;&#10;DATENAME(&apos;weekday&apos;, [hour])&#13;&#10;END' />
      </column>
      <column caption='Entitlement' datatype='boolean' name='[Calculation_667095736120397828]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='All days' datatype='string' name='[Calculation_667095736134057996]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;All days&apos;' />
      </column>
      <column caption='Date' datatype='date' datatype-customized='true' name='[Calculation_667095736137433104]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;day&apos;, [hour]))' />
      </column>
      <column caption='Order share' datatype='real' default-format='p0.0%' name='[Calculation_667095736150573081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions])/TOTAL(SUM([sessions]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='All entities' datatype='string' name='[Calculation_667095736154923035]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;All entities&apos;' />
      </column>
      <column caption='CVR' datatype='real' default-format='p0.0%' name='[Calculation_993043757143613445]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([transacted_sessions])/SUM([sessions])' />
      </column>
      <column caption='Time' datatype='datetime' default-format='*hh:mm' name='[Calculation_993043757154553877]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETIME(&#13;&#10;    STR(IF DATEPART(&apos;hour&apos;, [hour]) &lt; 6 THEN DATE(&quot;2000-01-02&quot;) ELSE DATE(&quot;2000-01-01&quot;) END)&#13;&#10;    + &quot; &quot; +&#13;&#10;    RIGHT(&quot;0&quot;+STR(DATEPART(&apos;hour&apos;, [hour])),2)&#13;&#10;    +&quot;:&quot;+&#13;&#10;    RIGHT(&quot;0&quot;+STR(DATEPART(&apos;minute&apos;, [hour])),2)&#13;&#10;    +&quot;:&quot;+&#13;&#10;    RIGHT(&quot;0&quot;+STR(DATEPART(&apos;second&apos;, [hour])),2)&#13;&#10;)' />
      </column>
      <column caption='Week' datatype='string' name='[Weekday (copy)_1333065533611864068]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(IF DATEPART(&apos;hour&apos;, [hour]) &lt; 6 &#13;&#10;    THEN DATENAME(&apos;week&apos;, DATEADD(&apos;hour&apos;,-6,[hour])) &#13;&#10;    ELSE DATENAME(&apos;week&apos;, [hour]) END)' />
      </column>
