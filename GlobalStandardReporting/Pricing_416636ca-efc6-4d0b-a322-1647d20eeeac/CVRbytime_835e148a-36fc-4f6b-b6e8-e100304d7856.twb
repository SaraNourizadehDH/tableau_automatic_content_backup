          <relation connection='bigquery.121h9rm1k2mopt1akgfiq1465vxe' name='Custom SQL Query' type='text'><![CDATA[WITH session_data AS (
  SELECT  
    entity_id,
    dps_session_id,
    dps_city_name city_name,
    dps_zones_name zones_name,
    TIMESTAMP_SECONDS(1800 * DIV(UNIX_SECONDS(TIMESTAMP(created_at_local)) + 900, 1800)) hour,
    COUNT(DISTINCT vendor_code) vendors,
    COUNT(DISTINCT transaction_no) transacted_sessions,
    COUNT(DISTINCT dps_session_id) sessions,
  FROM `fulfillment-dwh-production.curated_data_shared.dps_cvr_events` 
  WHERE created_date BETWEEN <[Parameters].[Parameter 1]> AND <[Parameters].[Parameter 2]>
  GROUP BY 1,2,3,4,5
  ORDER BY 1,2)
SELECT
  entity_id,
  dps_session_id,
  city_name,
  zones_name,
  hour,
  COUNT(DISTINCT CASE WHEN vendors = 0 THEN dps_session_id END) sessions_no_vendors_visited,
  AVG(vendors) vendors_visited_per_session,
  SUM(transacted_sessions) transacted_sessions,
  SUM(sessions) sessions,
FROM session_data
GROUP BY 1,2,3,4,5]]></relation>
