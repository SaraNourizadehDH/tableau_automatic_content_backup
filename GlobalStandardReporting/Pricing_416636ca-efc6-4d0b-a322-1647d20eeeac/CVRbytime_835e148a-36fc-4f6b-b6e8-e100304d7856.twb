    <datasource caption='Custom SQL Query (pricing)' inline='true' name='federated.0xxw65g04t4umy14vy52m1cpqpx3' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0285ufa0noivj815gvagr1248cp3'>
            <connection CATALOG='dh-logistics-product-ops' EXECCATALOG='pricing-256817' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='10' bq-large-fetch-rows='' bq-project-fetch-rows='2000' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='DH Logistics - Product Ops' schema='pricing' server-oauth='' username='laurent.broering@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[Custom SQL Query].[entity_id]' />
              <expression op='[tableau_entity_user_entitlements_entity_id].[entity_id]' />
            </expression>
          </clause>
          <relation connection='bigquery.0285ufa0noivj815gvagr1248cp3' name='Custom SQL Query' type='text'><![CDATA[WITH session_data AS (
  SELECT  
    entity_id,
    dps_session_id,
    COUNT(DISTINCT vendor_code) vendors,
    COUNT(DISTINCT transaction_no) transacted_sessions,
    COUNT(DISTINCT dps_session_id) sessions,
  FROM `fulfillment-dwh-production.curated_data_shared.dps_cvr_events` 
  WHERE created_date BETWEEN <[Parameters].[Parameter 1]> AND <[Parameters].[Parameter 2]>
  GROUP BY 1,2
  ORDER BY 1,2)
SELECT
  entity_id,
  COUNT(DISTINCT CASE WHEN vendors = 0 THEN dps_session_id END) sessions_no_vendors_visited,
  AVG(vendors) vendors_visited_per_session,
  SUM(transacted_sessions) transacted_sessions,
  SUM(sessions) sessions,
FROM session_data
GROUP BY 1]]></relation>
          <relation connection='bigquery.0285ufa0noivj815gvagr1248cp3' name='tableau_entity_user_entitlements_entity_id' table='[dh-logistics-product-ops.pricing].[tableau_entity_user_entitlements_entity_id]' type='table' />
