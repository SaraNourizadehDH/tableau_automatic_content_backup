            <column caption='No vendor visited share' datatype='real' default-format='p0.0%' name='[CVR (copy)_1333065533607874560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_no_vendors_visited])/SUM([sessions])' />
            </column>
            <column caption='[No vendor visited share] / TOTAL([No vendor visited share])' datatype='real' name='[Calculation_1333065533609615362]' role='measure' type='quantitative' user:unnamed='CVR (2)'>
