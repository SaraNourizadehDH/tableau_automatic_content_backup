                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Weekday' datatype='string' name='[Calculation_667095736116256771]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;, [hour]) &lt; 6&#13;&#10;THEN &#13;&#10;&#13;&#10;DATENAME(&apos;weekday&apos;, &#13;&#10;DATEADD(&apos;hour&apos;,-6,[hour]))&#13;&#10;&#13;&#10;ELSE&#13;&#10;DATENAME(&apos;weekday&apos;, [hour])&#13;&#10;END' />
            </column>
            <column caption='Entitlement' datatype='boolean' name='[Calculation_667095736120397828]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username]=USERNAME()' />
            </column>
            <column caption='All days' datatype='string' name='[Calculation_667095736134057996]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;All days&apos;' />
            </column>
            <column caption='Date' datatype='date' datatype-customized='true' name='[Calculation_667095736137433104]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;day&apos;, [hour]))' />
            </column>
            <column caption='Order share' datatype='real' default-format='p0.0%' name='[Calculation_667095736150573081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions])/TOTAL(SUM([sessions]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='All entities' datatype='string' name='[Calculation_667095736154923035]' role='dimension' type='nominal'>
