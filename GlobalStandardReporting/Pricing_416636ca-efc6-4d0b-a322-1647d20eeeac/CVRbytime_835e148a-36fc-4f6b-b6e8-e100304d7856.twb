        <column caption='Time' datatype='datetime' default-format='*hh:mm' name='[Calculation_993043757154553877]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='DATETIME(&#13;&#10;    STR(IF DATEPART(&apos;hour&apos;, [hour]) &lt; 6 THEN DATE(&quot;2000-01-02&quot;) ELSE DATE(&quot;2000-01-01&quot;) END)&#13;&#10;    + &quot; &quot; +&#13;&#10;    RIGHT(&quot;0&quot;+STR(DATEPART(&apos;hour&apos;, [hour])),2)&#13;&#10;    +&quot;:&quot;+&#13;&#10;    RIGHT(&quot;0&quot;+STR(DATEPART(&apos;minute&apos;, [hour])),2)&#13;&#10;    +&quot;:&quot;+&#13;&#10;    RIGHT(&quot;0&quot;+STR(DATEPART(&apos;second&apos;, [hour])),2)&#13;&#10;)' />
