    <worksheet name='Tabular View'>
      <table>
        <view>
          <datasources>
            <datasource caption='routes_ab_test_results (ml_analytics)' name='federated.1cn2r5w0onep4g1bh883c123deol' />
          </datasources>
          <datasource-dependencies datasource='federated.1cn2r5w0onep4g1bh883c123deol'>
            <column caption='% Orders with Seamless Routes ' datatype='real' name='[Calculation_143693013049221121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([seamless_route_order])/sum([total_orders])' />
            </column>
            <column caption='% Rider did not take predicted route point' datatype='real' name='[Calculation_143693013049638914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([points_where_rider_did_not_follow])/sum([total_rider_points])' />
            </column>
            <column caption='% Re-routes where distance increased' datatype='real' name='[Calculation_143693013050134531]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([reroutes_with_distance_jump])/sum([points_where_rider_did_not_follow])' />
            </column>
            <column caption='% Re-routes where time increased' datatype='real' name='[Calculation_143693013050769412]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([reroutes_with_time_jump])/sum([points_where_rider_did_not_follow])' />
            </column>
            <column caption='% Route Accuracy' datatype='real' name='[Calculation_143693013052354567]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(sum([points_where_rider_did_not_follow])/sum([total_rider_points]))' />
            </column>
            <column caption='% Customer Cancellations' datatype='real' name='[Calculation_143693013227655179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customer_cancelled_orders])/sum([all_orders])' />
            </column>
            <column caption='% Customer Cancellations After Pickup' datatype='real' name='[Calculation_143693013227733004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customer_cancelled_after_pickup_orders])/sum([all_orders])' />
            </column>
            <column caption='% Order Status Contacts After Pickup' datatype='real' name='[Calculation_4968525957135335424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_with_contact_after_pickup])/sum([total_orders])' />
            </column>
            <column caption='% Order with HC Sessions After Pickup' datatype='real' name='[Calculation_4968525957135601665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_with_hc_after_pickup])/sum([total_orders])' />
            </column>
            <column caption='Local Date' datatype='date' name='[Calculation_6362952991424495616]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([local_created_Date])' />
            </column>
