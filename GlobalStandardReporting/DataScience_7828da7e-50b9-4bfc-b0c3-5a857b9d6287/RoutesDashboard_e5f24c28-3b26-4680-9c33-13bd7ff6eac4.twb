      <aliases enabled='yes' />
      <column caption='100% Live Roll-out' datatype='string' name='[Calculation_1555571512400134144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Rollout Flag (copy)_1555571512405512193]&#10;when 0 then &quot;Not rolled out yet&quot;&#10;when 1 then &quot;100% Rolled out&quot; end' />
      </column>
      <column caption='% Lag-Free Requests' datatype='real' name='[Calculation_1815513648797360128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(1- (sum([laggy_requests])/sum([all_requests])) )*100' />
      </column>
      <column caption='% Stale Ping Requests' datatype='real' name='[Calculation_1815513648797712385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([stale_requests])*100/sum([all_requests])' />
      </column>
      <column caption='Time between New Suggestions (s)' datatype='real' name='[Calculation_1815513649149501442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([time_between_Requests]*[all_requests])/sum(all_requests)' />
      </column>
      <column caption='Time between Rider Pings (s)' datatype='real' name='[Calculation_1815513649149583363]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([time_between_rider_pings]*unique_rider_pings)/sum(unique_rider_pings)' />
      </column>
      <column caption='Local Date' datatype='date' name='[Calculation_4596416047113629696]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date([local_created_Date])' />
      </column>
      <column caption='Date Dimension' datatype='string' name='[Calculation_4596416047113691137]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 1] = &quot;day&quot; THEN&#10;STR(DATEPART(&quot;year&quot;, [local_created_Date])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [local_created_Date])) + &quot;-&quot; + STR(DATEPART(&quot;day&quot;, [local_created_Date]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;week&quot; THEN &#10;STR(DATEPART(&quot;year&quot;, [local_created_Date])) + &quot; W&quot; + STR(DATEPART(&quot;week&quot;, [local_created_Date]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;month&quot; then &#10;STR(DATEPART(&quot;year&quot;, [local_created_Date])) + &quot;-&quot; + STR(DATEPART(&quot;month&quot;, [local_created_Date]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;quarter&quot; then&#10;STR(DATEPART(&quot;year&quot;, [local_created_Date])) + &quot; Q&quot; + STR(DATEPART(&quot;quarter&quot;, [local_created_Date]))&#10;ELSEIF [Parameters].[Parameter 1] = &quot;year&quot; then &#10;&quot;Year - &quot; + STR(DATEPART(&quot;year&quot;, [local_created_Date]))&#10;END' />
      </column>
      <column caption='# Route Shown Orders' datatype='integer' name='[Calculation_4596416047116099586]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([route_shown_orders])' />
      </column>
      <column caption='% Rider Lag &lt; 150m' datatype='real' name='[Calculation_4596416047116378115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(1-(sum([laggy_rider_pings])/sum([unique_rider_pings])))*100' />
      </column>
      <column caption='% Customer Cancellation' datatype='real' name='[Calculation_4596416047116541956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([customer_cancelled_orders])*100/sum([all_orders])' />
      </column>
      <column caption='% Customer Cancellation After Pickup' datatype='real' name='[Calculation_4596416047116738565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([customer_cancelled_after_pickup_orders])*100/sum([all_orders])' />
      </column>
      <column caption='% Contacts' datatype='real' name='[Calculation_4596416047117008902]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([contact_orders])*100/sum([completed_orders])' />
      </column>
      <column caption='% Contacts After Pickup' datatype='real' name='[Calculation_4596416047117086727]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([contact_After_pickup_orders])*100/sum([completed_orders])' />
      </column>
      <column caption='% Help Center Sessions' datatype='real' name='[Calculation_4596416047117254664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([hc_orders])*100/sum([completed_orders])' />
      </column>
      <column caption='% Help Center After Pickup' datatype='real' name='[Calculation_4596416047117336585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([hc_After_pickup_orders])*100/sum([completed_orders])' />
      </column>
      <column caption='% Seamless Routes Orders' datatype='real' name='[Calculation_4596416047117578250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([seamless_routes_order])*100/sum([route_shown_orders])' />
      </column>
      <column caption='% Routes when Distance Increased' datatype='real' name='[Calculation_4596416047117934603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([rider_pings_distance_jump])*100/sum([unique_rider_pings])' />
      </column>
      <column caption='% Routes when Time Increased' datatype='real' name='[Calculation_4596416047118008332]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([rider_pings_time_jump])*100/sum([unique_rider_pings])' />
      </column>
      <column caption='% Rider Lag &gt; 150m ' datatype='real' name='[Calculation_4596416047118168077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([laggy_rider_pings])*100/sum([unique_rider_pings])' />
      </column>
      <column caption='Dimension #1' datatype='string' name='[Calculation_4596416047123734543]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 2]&#10;when &quot;Country&quot; then [country_code]&#10;when &quot;City&quot; then [city_id]&#10;when &quot;Date Field&quot; then [Calculation_4596416047113691137]&#10;when &quot;Stack Tag&quot; then [stack_tag]&#10;when &quot;Vehicle Type&quot; then [vehicle_type]&#10;when &quot;Region&quot; then [region]&#10;when &quot;Brand Name&quot; then [brand_name]&#10;when &quot;Rollout Flag&quot; then [Calculation_1555571512400134144]&#10;END' />
      </column>
      <column caption='Dimension #2' datatype='string' name='[Dimension #1 (copy)_4596416047124054032]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Row Dimension (copy)_4596416047123656718]&#10;when &quot;Country&quot; then [country_code]&#10;when &quot;City&quot; then [city_id]&#10;when &quot;Date Field&quot; then [Calculation_4596416047113691137]&#10;when &quot;Stack Tag&quot; then [stack_tag]&#10;when &quot;Vehicle Type&quot; then [vehicle_type]&#10;when &quot;Region&quot; then [region]&#10;when &quot;Brand Name&quot; then [brand_name]&#10;when &quot;Rollout Flag&quot; then [Calculation_1555571512400134144]&#10;END' />
      </column>
      <column aggregation='Sum' caption='Rollout Flag 2' datatype='integer' name='[Rollout Flag (copy)_1555571512405512193]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [country_code] = &quot;de2&quot; AND [local_created_Date] &gt;= DATE(&quot;2023-07-12&quot;) then 1 else [rollout_flag] end' />
      </column>
