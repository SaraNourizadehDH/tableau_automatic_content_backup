      <aliases enabled='yes' />
      <column caption='Avg Events Per Hour (Prediction)' datatype='real' name='[Calculation_1019220894704144385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([avg_events_per_hr])' />
      </column>
      <column caption='MAPE From BPE Opt' datatype='real' name='[Calculation_1878845538130796546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(abs([avg_bpe] - [bpe_opt])/[bpe_opt])' />
      </column>
      <column caption='Actual Budget Remaining' datatype='real' name='[Calculation_5274981859985645569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg(if [actual_remaining_budget] &gt; 0 then [actual_remaining_budget] end)' />
      </column>
      <column caption='Ideal Budget Remaining' datatype='real' name='[Calculation_5274981859987857410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg(if [ideal_budget_remaining] &gt; 0 then [ideal_budget_remaining] end)' />
      </column>
      <column caption='Clipped Proportional Factor' datatype='real' name='[Calculation_5274981860605976581]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([raw_proportional_factor] &gt; 0.5, 0.5, IIF([raw_proportional_factor] &gt; 0 , [raw_proportional_factor], NULL))' />
      </column>
      <column caption='Raw Proportional Factor ' datatype='real' name='[Calculation_5274981860606763014]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([raw_proportional_factor] &gt; 0, [raw_proportional_factor], NULL)' />
      </column>
      <column caption='Traffic Share' datatype='real' name='[Calculation_6987405258828652545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([DISTINCT_events])/TOTAL(SUM([DISTINCT_events]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='DISTINCT events' datatype='integer' name='[DISTINCT_events]' role='measure' type='quantitative' />
