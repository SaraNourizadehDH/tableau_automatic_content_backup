            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='logistics-data-staging-flat' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='DataHub Production' schema='cl' server-oauth='' username='sindhu.mallya@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0xg9fpj0x0wikz19cb51o10mh632' name='Custom SQL Query' type='text'>SELECT shifts.* ,case when uploaded=True THEN slots ELSE 0 END as Uploaded_slots,&#13;
case when uploaded=False THEN slots ELSE 0 END as NonUploaded_slots,&#13;
 date(window_start) AS window_start_date,&#13;
row_number() OVER (PARTITION BY country_code,zone_id,starting_point_id,city_id,&#13;
window_start,&#13;
window_stop ORDER BY created_at DESC) AS row_numb&#13;
FROM fulfillment-dwh-production.cl._staffing_model_data shifts&#13;
WHERE country_code IS NOT NULL&#13;
AND zone_id IS NOT NULL&#13;
AND starting_point_id IS NOT NULL&#13;
AND city_id IS NOT NULL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0xg9fpj0x0wikz19cb51o10mh632' name='Custom SQL Query' type='text'>SELECT shifts.* ,case when uploaded=True THEN slots ELSE 0 END as Uploaded_slots,&#13;
case when uploaded=False THEN slots ELSE 0 END as NonUploaded_slots,&#13;
 date(window_start) AS window_start_date,&#13;
row_number() OVER (PARTITION BY country_code,zone_id,starting_point_id,city_id,&#13;
window_start,&#13;
window_stop ORDER BY created_at DESC) AS row_numb&#13;
FROM fulfillment-dwh-production.cl._staffing_model_data shifts&#13;
WHERE country_code IS NOT NULL&#13;
AND zone_id IS NOT NULL&#13;
AND starting_point_id IS NOT NULL&#13;
AND city_id IS NOT NULL</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
