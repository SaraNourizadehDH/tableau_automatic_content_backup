        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.09vw3aa1v04pre0zqk2rm18riajz' name='Custom SQL Query' type='text'>WITH bayesian AS (&#13;
  SELECT&#13;
  created_date,&#13;
  country_code,&#13;
  entity_id,&#13;
  analysed_date,&#13;
  test_name,&#13;
  dist_family,&#13;
  best_variant,&#13;
  bayesian_mean,&#13;
  variant,&#13;
  p_var_greater_all,&#13;
  p_var_greater_control,&#13;
  target_kpi,&#13;
  lower_quartile, median, upper_quartile,&#13;
  COALESCE(CAST(JSON_EXTRACT(dist_params, &quot;$.a&quot;) AS INT64),0) AS a,&#13;
COALESCE(CAST(JSON_EXTRACT(dist_params, &quot;$.b&quot;) AS INT64),0) AS b,&#13;
COALESCE(CAST(JSON_EXTRACT(dist_params, &quot;$.mu&quot;) AS FLOAT64),0) AS mu,&#13;
COALESCE(CAST(JSON_EXTRACT(dist_params, &quot;$.sigma&quot;) AS FLOAT64),0) AS sigma,&#13;
  --quantiles_values,&#13;
  --quantiles,&#13;
  --sessions_count,&#13;
  --users_count&#13;
FROM (&#13;
  SELECT &#13;
    *,&#13;
    Rank() OVER (PARTITION BY country_code, test_name,entity_id, variant, analysed_date ORDER BY created_at DESC) AS rn&#13;
  FROM `log-data-science-production.pricing_multi_armed_bandit.mab_bayesian_updating_results`&#13;
) &#13;
--UNPIVOT(quantiles_values FOR quantiles IN (min_value, lower_quartile, median, upper_quartile, max_value))&#13;
WHERE rn = 1&#13;
),&#13;
&#13;
actuals AS (&#13;
  SELECT&#13;
  created_date,&#13;
  country_code,&#13;
  entity_id,&#13;
  analysed_date,&#13;
  test_name,&#13;
  variant,&#13;
  actual_values,&#13;
  actual_kpis&#13;
&#13;
FROM (&#13;
  SELECT &#13;
    *, CAST(users_count AS float64) AS users_count_,CAST(sessions_count AS float64) AS sessions_count_,&#13;
    CAST(transactions_count AS float64) AS transactions_count_,&#13;
    CAST(no_transactions_count AS float64) AS no_transactions_count_,&#13;
    CAST(profit_sum AS float64) AS profit_sum_,&#13;
    CAST(orders_count AS float64) AS orders_count_,&#13;
    CAST(revenue_sum AS float64) AS revenue_eur_,&#13;
    CAST(delivery_costs_sum AS float64) AS delivery_costs_eur_,&#13;
    CAST(gmv_per_order AS float64) AS gmv_per_order_,&#13;
    CAST(gmv_per_session AS float64) AS gmv_per_session_,&#13;
    Rank() OVER (PARTITION BY country_code, test_name, variant,entity_id, analysed_date ORDER BY created_at DESC) AS rn&#13;
  FROM `log-data-science-production.pricing_multi_armed_bandit.mab_bayesian_updating_actuals`&#13;
) &#13;
UNPIVOT(actual_values FOR actual_kpis IN (sessions_count_,&#13;
  users_count_,&#13;
  cvr,&#13;
  profit_per_order,&#13;
  profit_per_session,&#13;
  transactions_count_,&#13;
  no_transactions_count_,&#13;
  profit_sum_,&#13;
  orders_count_,&#13;
  revenue_eur_,&#13;
  delivery_costs_eur_,&#13;
  gmv_per_order_,&#13;
  gmv_per_session_&#13;
))&#13;
WHERE rn = 1&#13;
),&#13;
&#13;
status AS (&#13;
  SELECT&#13;
  created_date,&#13;
  country_code,&#13;
  analysed_date,&#13;
  test_name,&#13;
  lead_variants,&#13;
  status,&#13;
  target_kpi&#13;
FROM (&#13;
  SELECT&#13;
    created_date,&#13;
    country_code,&#13;
    analysed_date,&#13;
    test_name,&#13;
    lead_variants,&#13;
    target_kpi,&#13;
    status,&#13;
    RANK() OVER (PARTITION BY country_code, test_name,target_kpi, analysed_date ORDER BY created_at DESC) AS rn&#13;
  FROM&#13;
    log-data-science-production.pricing_multi_armed_bandit.mab_convergence_results)&#13;
WHERE&#13;
  rn = 1&#13;
),&#13;
&#13;
traffic AS (&#13;
  SELECT&#13;
    created_date,&#13;
    country_code,&#13;
    analysed_date,&#13;
    test_name,&#13;
    variant_name AS variant,&#13;
    target_kpi,&#13;
    traffic_share&#13;
FROM (&#13;
  SELECT&#13;
    created_date,&#13;
    country_code,&#13;
    analysed_date,&#13;
    test_name,&#13;
    variant_name,&#13;
    target_kpi,&#13;
    traffic_share,&#13;
    RANK() OVER (PARTITION BY country_code, test_name,entity_id, variant_name, analysed_date ORDER BY created_at DESC) AS rn&#13;
  FROM&#13;
    log-data-science-production.pricing_multi_armed_bandit.mab_variant_status)&#13;
WHERE&#13;
  rn = 1&#13;
&#13;
),&#13;
&#13;
&#13;
actuals_per_user AS (&#13;
  SELECT&#13;
  created_date,&#13;
  country_code,&#13;
  entity_id,&#13;
  analysed_date,&#13;
  test_name,&#13;
  variant,&#13;
  actual_values_user,&#13;
  actual_kpis_user&#13;
&#13;
FROM (&#13;
  SELECT &#13;
    *, CAST(sessions_count_per_user AS float64) AS sessions_count_per_user_,CAST(order_count_per_user AS float64) AS order_count_per_user_,&#13;
    CAST(user_cvr AS float64) AS user_cvr_,&#13;
    CAST(profit_per_user AS float64) AS profit_per_user_,&#13;
    CAST(gmv_per_user AS float64) AS gmv_per_user_,&#13;
    CAST(revenue_per_user AS float64) AS revenue_per_user_,&#13;
    Rank() OVER (PARTITION BY country_code, test_name, variant,entity_id, analysed_date ORDER BY created_at DESC) AS rn&#13;
  FROM `log-data-science-production.pricing_multi_armed_bandit.mab_actuals_per_user`&#13;
) &#13;
UNPIVOT(actual_values_user FOR actual_kpis_user IN (sessions_count_per_user_,&#13;
  order_count_per_user_,&#13;
  user_cvr_,&#13;
  profit_per_user_,&#13;
  gmv_per_user_,&#13;
  revenue_per_user_&#13;
))&#13;
WHERE rn = 1&#13;
)&#13;
&#13;
SELECT bayesian.*,actuals.actual_values,actuals.actual_kpis,status.status,status.lead_variants,traffic.traffic_share,&#13;
actuals_per_user.actual_kpis_user,actuals_per_user.actual_values_user&#13;
FROM bayesian&#13;
LEFT JOIN actuals&#13;
ON bayesian.created_date=actuals.created_date&#13;
AND bayesian.country_code=actuals.country_code&#13;
--AND bayesian.entity_id=actuals.entity_id&#13;
AND bayesian.test_name=actuals.test_name&#13;
AND bayesian.analysed_date=actuals.analysed_date&#13;
AND bayesian.variant=actuals.variant&#13;
LEFT JOIN actuals_per_user&#13;
ON bayesian.created_date=actuals_per_user.created_date&#13;
AND bayesian.country_code=actuals_per_user.country_code&#13;
--AND bayesian.entity_id=actuals.entity_id&#13;
AND bayesian.test_name=actuals_per_user.test_name&#13;
AND bayesian.analysed_date=actuals_per_user.analysed_date&#13;
AND bayesian.variant=actuals_per_user.variant&#13;
LEFT JOIN status&#13;
ON bayesian.country_code=status.country_code&#13;
--AND bayesian.entity_id=actuals.entity_id&#13;
AND bayesian.test_name=status.test_name&#13;
AND bayesian.analysed_date=status.analysed_date&#13;
AND bayesian.target_kpi=status.target_kpi&#13;
LEFT JOIN traffic&#13;
ON bayesian.country_code=traffic.country_code&#13;
AND bayesian.test_name=traffic.test_name&#13;
AND bayesian.analysed_date=traffic.analysed_date &#13;
AND bayesian.variant=traffic.variant&#13;
AND bayesian.target_kpi=traffic.target_kpi&#13;
ORDER BY 1,2</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
