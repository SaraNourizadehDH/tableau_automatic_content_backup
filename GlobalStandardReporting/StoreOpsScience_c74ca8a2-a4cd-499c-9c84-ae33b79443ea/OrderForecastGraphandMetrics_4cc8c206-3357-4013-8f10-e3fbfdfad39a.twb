          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xavujt0mw5qgu11a5m9i0tiuroj'>
            <column caption='weekday or weekend' datatype='string' name='[Calculation_1654580286464307208]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATENAME(&quot;weekday&quot;,[Calculation_2854648911668211714]) == &apos;Saturday&apos; THEN &apos;Weekend&apos;&#10;ELSEIF DATENAME(&quot;weekday&quot;,[Calculation_2854648911668211714]) == &apos;Sunday&apos; THEN &apos;Weekend&apos;&#10;ELSE &apos;Weekday&apos;&#10;END' />
            </column>
            <column caption='Granularity Calc' datatype='datetime' name='[Calculation_2854648911668211714]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Hour&apos; THEN [order_datetime]&#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;, [order_datetime])&#10;END' />
            </column>
            <column caption='MAPE 3W (Day)' datatype='real' name='[Calculation_2854648913441468445]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS(SUM([num_actual_orders]) - SUM([forecasted_3_weeks_ago]))/SUM([num_actual_orders])' />
            </column>
            <column caption='MAPE 7W (Day)' datatype='real' name='[Calculation_2854648913441603614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS(SUM([num_actual_orders]) - SUM([forecasted_7_weeks_ago]))/SUM([num_actual_orders])' />
            </column>
            <column caption='Order Date' datatype='datetime' name='[Order Datetime (copy)_2854648913437282327]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;, [order_datetime])' />
            </column>
            <column caption='Orders forecasted 3 Weeks Ago' datatype='real' name='[forecasted_3_weeks_ago]' role='measure' type='quantitative' />
            <column caption='Orders forecasted 7 Weeks Ago' datatype='real' name='[forecasted_7_weeks_ago]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1654580286464307208]' derivation='None' name='[none:Calculation_1654580286464307208:nk]' pivot='key' type='nominal' />
