      <aliases enabled='yes' />
      <column caption='Upper percentile orders' datatype='real' name='[Calculation_1654580285497499651]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_PERCENTILE(SUM([num_actual_orders]), 0.80)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Lower Percentile Orders' datatype='real' name='[Calculation_1654580285504868359]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_PERCENTILE(SUM([num_actual_orders]), 0.10)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='weekday or weekend' datatype='string' name='[Calculation_1654580286464307208]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATENAME(&quot;weekday&quot;,[Calculation_2854648911668211714]) == &apos;Saturday&apos; THEN &apos;Weekend&apos;&#10;ELSEIF DATENAME(&quot;weekday&quot;,[Calculation_2854648911668211714]) == &apos;Sunday&apos; THEN &apos;Weekend&apos;&#10;ELSE &apos;Weekday&apos;&#10;END' />
      </column>
      <column caption='Granularity Calc' datatype='datetime' name='[Calculation_2854648911668211714]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Hour&apos; THEN [order_datetime]&#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;, [order_datetime])&#10;END' />
      </column>
      <column caption='ME 1W (Day)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2854648911677026308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_actual_orders]) - SUM([forecasted_1_weeks_ago])' />
      </column>
      <column caption='ME 3W (Day)' datatype='real' name='[Calculation_2854648912081588235]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_actual_orders]) - SUM([forecasted_3_weeks_ago])' />
      </column>
      <column caption='ME 7W (Day)' datatype='real' name='[Calculation_2854648912082165772]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_actual_orders]) - SUM([forecasted_7_weeks_ago])' />
      </column>
      <column caption='MAPE 1W (Hour)' datatype='real' name='[Calculation_2854648912083173392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(ABS([num_actual_orders] - [forecasted_1_weeks_ago])/[num_actual_orders])' />
      </column>
      <column caption='MAPE 3W (Hour)' datatype='real' name='[Calculation_2854648912083759124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(ABS([num_actual_orders] - [forecasted_3_weeks_ago])/[num_actual_orders])' />
      </column>
      <column caption='MAPE 7W (Hour)' datatype='real' name='[Calculation_2854648912083841045]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(ABS([num_actual_orders] - [forecasted_7_weeks_ago])/[num_actual_orders])' />
      </column>
      <column caption='MAPE 1W (Day)' datatype='real' name='[Calculation_2854648913440931867]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(SUM([num_actual_orders]) - SUM([forecasted_1_weeks_ago]))/SUM([num_actual_orders])' />
      </column>
      <column caption='MAPE 3W (Day)' datatype='real' name='[Calculation_2854648913441468445]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(SUM([num_actual_orders]) - SUM([forecasted_3_weeks_ago]))/SUM([num_actual_orders])' />
      </column>
      <column caption='MAPE 7W (Day)' datatype='real' name='[Calculation_2854648913441603614]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(SUM([num_actual_orders]) - SUM([forecasted_7_weeks_ago]))/SUM([num_actual_orders])' />
      </column>
      <column caption='Null Percent in 1W Forecast' datatype='real' name='[Calculation_5058949756887232512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-(COUNT([forecasted_1_weeks_ago])/SUM(IIF(ISNULL([forecasted_1_weeks_ago]),1,1)))' />
      </column>
      <column caption='Null Percent in 3W Forecast' datatype='real' name='[Calculation_5058949756889853953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-(COUNT([forecasted_3_weeks_ago])/SUM(IIF(ISNULL([forecasted_3_weeks_ago]),1,1)))' />
      </column>
      <column caption='Null Percent in 7W Forecast' datatype='real' name='[Calculation_5058949756889997314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-(COUNT([forecasted_7_weeks_ago])/SUM(IIF(ISNULL([forecasted_7_weeks_ago]),1,1)))' />
      </column>
      <column caption='Order Date' datatype='datetime' name='[Order Datetime (copy)_2854648913437282327]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;, [order_datetime])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='forecast_data_sos_90_days' datatype='table' name='[__tableau_internal_object_id__].[forecast_data_sos_90_days_4F081716C10F433199F5F1336DDBCE2F]' role='measure' type='quantitative' />
