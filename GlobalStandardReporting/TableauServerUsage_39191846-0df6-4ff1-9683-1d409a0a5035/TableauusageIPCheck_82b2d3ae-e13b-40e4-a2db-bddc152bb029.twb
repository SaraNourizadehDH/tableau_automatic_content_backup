      <column caption='Count Distinct IPs' datatype='integer' name='[Calculation_2928395319794036736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([remote_ip])' />
      </column>
      <column caption='Count Distinct User Agents' datatype='integer' name='[Calculation_2928395319794188289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([http_user_agent])' />
      </column>
      <column caption='Count Distinct User Agent + IP combinations' datatype='integer' name='[Calculation_2928395319794348034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([http_user_agent_ip])' />
      </column>
      <column caption='Count Distinct IPs per hour' datatype='integer' default-format='N' name='[Calculation_6409959335432482816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [created_at (Hours)], [user_login] : COUNTD([remote_ip])}' />
      </column>
      <column caption='Filter' datatype='boolean' name='[Calculation_6409959335434252289]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_6409959335432482816]) &gt; 1 &#10;OR SUM([Count Distinct User Agent per hour (copy)]) &gt; 1&#10;OR SUM([Count Distinct IPs per hour (copy)]) &gt; 1&#10;THEN TRUE &#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Count Distinct User Agent per hour' datatype='integer' default-format='N' name='[Count Distinct IPs per hour (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [created_at (Hours)], [user_login] : COUNTD([http_user_agent])}' />
      </column>
      <column caption='Count Distinct User Agent + IP per hour' datatype='integer' default-format='N' name='[Count Distinct User Agent per hour (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [created_at (Hours)], [user_login] : COUNTD([http_user_agent_ip])}' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='IP Query' datatype='table' name='[__tableau_internal_object_id__].[_7D7645F3A7084D6892022488A20E33A1]' role='measure' type='quantitative' />
