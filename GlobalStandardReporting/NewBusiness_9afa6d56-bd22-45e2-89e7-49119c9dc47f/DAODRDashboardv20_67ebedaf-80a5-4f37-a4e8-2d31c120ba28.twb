      <aliases enabled='yes' />
      <column caption='Date Vendors' datatype='date' datatype-customized='true' name='[Calculation_1561763960510111755]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(case [Parameters].[Date Selection (copy)]&#10;when 2 then DATETRUNC(&apos;week&apos;,[date])&#10;when 3 then datetrunc(&apos;month&apos;,[date])&#10;when 5 then DATETRUNC(&apos;year&apos;,[date])&#10;END)' />
      </column>
      <column caption='Vendor Metric 1' datatype='real' name='[Calculation_1561763960510963724]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Case [Parameters].[Orders Metric Selector 1 (copy 2)]&#10;when 1 then sum([registered_vendors])&#10;when 2 then sum([confirmed_vendors])&#10;when 3 then sum([activated_vendors])&#10;when 4 then sum([active_vendors_30d])&#10;when 5 then [Calculation_1561763960511807502]*100&#10;when 6 then [Calculation_1561763960511979535]*100&#10;when 7 then [Calculation_1561763960512163856]*100&#10;when 8 then [Calculation_1561763960512315409]*100&#10;END' />
      </column>
      <column caption='Registration Rate' datatype='real' name='[Calculation_1561763960511807502]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([registered_vendors])/sum([all_vendors])' />
      </column>
      <column caption='Confirmation Rate' datatype='real' name='[Calculation_1561763960511979535]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([confirmed_vendors])/sum([registered_vendors])' />
      </column>
      <column caption='Activation Rate' datatype='real' name='[Calculation_1561763960512163856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([activated_vendors])/sum([registered_vendors])' />
      </column>
      <column caption='Churn Rate' datatype='real' name='[Calculation_1561763960512315409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([activated_vendors])-sum([active_vendors_30d]))/sum([activated_vendors])' />
      </column>
      <column caption='Latest Period' datatype='boolean' name='[Calculation_226657790869696512]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1561763960510111755]={fixed: max([Calculation_1561763960510111755])}' />
      </column>
      <column caption='Latest_ period' datatype='date' name='[Calculation_751467838352834560]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed: max([date])}' />
      </column>
      <column caption='Last' datatype='integer' name='[Calculation_751467838353022977]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='LAST()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Date Disp' datatype='real' name='[Calculation_751467838353850370]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='Max_Date' datatype='date' datatype-customized='true' name='[Calculation_751467838354690051]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATE(max([Calculation_1561763960510111755]))' />
      </column>
      <column caption='Last Row' datatype='integer' name='[Calculation_751467838355103748]' role='measure' type='ordinal'>
