            </column>
            <column caption='Churn Rate' datatype='real' name='[Calculation_1561763960512315409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([activated_vendors])-sum([active_vendors_30d]))/sum([activated_vendors])' />
