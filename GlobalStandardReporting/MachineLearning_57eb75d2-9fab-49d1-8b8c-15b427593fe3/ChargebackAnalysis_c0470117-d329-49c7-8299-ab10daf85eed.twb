          <datasource-dependencies datasource='federated.0yimd8i18gjpg61dbbn5u0y2ijs9 (copy 15)'>
            <column caption='day_diff_bin' datatype='integer' name='[Calculation_3452853597367861270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [days_diff]&lt;=20 then 20&#10;ELSEIF [days_diff]&lt;=40 then 40&#10;ELSEIF [days_diff]&lt;=60 then 60&#10;ELSEIF [days_diff]&lt;=80 then 80&#10;ELSEIF [days_diff]&lt;=100 then 100&#10;ELSEIF [days_diff]&lt;=120 then 120&#10;ELSEIF [days_diff]&lt;=140 then 140&#10;ELSEIF [days_diff]&gt;140 then 160&#10;&#10;END' />
            </column>
            <column caption='(ZN([total Amount Loss]) - LOOKUP(ZN([total Amount Loss]), -1...' datatype='real' name='[Calculation_3452853597494693938]' role='measure' type='quantitative' user:unnamed='PK Cap Diff bin Chargepack amount vs Days Diff'>
              <calculation class='tableau' formula='(ZN([Calculation_6023142345688870913]) - LOOKUP(ZN([Calculation_6023142345688870913]), -1))/min([amount_ent_month_160])'>
                <table-calc ordering-type='Rows' />
