      <aliases enabled='yes' />
      <column caption='day_diff_bin' datatype='integer' name='[Calculation_3452853597367861270]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [days_diff]&lt;=20 then 20&#10;ELSEIF [days_diff]&lt;=40 then 40&#10;ELSEIF [days_diff]&lt;=60 then 60&#10;ELSEIF [days_diff]&lt;=80 then 80&#10;ELSEIF [days_diff]&lt;=100 then 100&#10;ELSEIF [days_diff]&lt;=120 then 120&#10;ELSEIF [days_diff]&lt;=140 then 140&#10;ELSEIF [days_diff]&gt;140 then 160&#10;&#10;END' />
      </column>
      <column caption='count_trans' datatype='integer' name='[Calculation_5047057494554492928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([external_id])' />
      </column>
      <column caption='count_dist_trans' datatype='integer' name='[Calculation_5047057494554615809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([external_id])' />
      </column>
      <column caption='total Amount Loss' datatype='real' name='[Calculation_6023142345688870913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if ISNULL([dispute_amount_eur]) then [amount_eur] else [dispute_amount_eur] end)' />
      </column>
      <column caption='flag' datatype='integer' name='[Calculation_6023142345689784322]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [amount_eur]==FLOAT([dispute_amount]) then 1 else 0 end' />
      </column>
      <column aggregation='Sum' datatype='integer' name='[Order Date (Month / Year)]' role='dimension' type='ordinal' user:agg-type='MY' user:base-field='order_date' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='(DATEPART(&apos;year&apos;, [order_date])*100 + DATEPART(&apos;month&apos;, [order_date]))' />
      </column>
