      <column caption='tot_amount_loss' datatype='real' name='[Calculation_6023142345694097415]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if ISNULL([dispute_amount_eur]) then [amount_eur] else [dispute_amount_eur] end)' />
