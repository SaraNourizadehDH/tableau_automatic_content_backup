            </column>
            <column caption='total Amount Loss' datatype='real' name='[Calculation_6023142345688870913]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if ISNULL([dispute_amount_eur]) then [amount_eur] else [dispute_amount_eur] end)' />
            </column>
