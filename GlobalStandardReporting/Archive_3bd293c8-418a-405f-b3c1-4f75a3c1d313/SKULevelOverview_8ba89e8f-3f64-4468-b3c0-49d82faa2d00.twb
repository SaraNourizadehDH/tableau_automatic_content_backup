    <dashboard name='Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/AssortmentReport/Definitions?rev=' id='Definitions' path='/t/GlobalStandardReporting/workbooks/AssortmentReport' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98000' id='3' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run bold='true' fontcolor='#4e79a7' fontname='Avenir' fontsize='12'>SKU Information</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>Status</run>
              <run fontcolor='#222222' fontname='Avenir'> - Active or Inactive. Most recent status in catalog </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>Listing price</run>
              <run fontcolor='#222222' fontname='Avenir'> - Reference price Catalog without VAT </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>ASP - </run>
              <run fontcolor='#222222' fontname='Avenir'> total sales / total units without </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>Sku age - </run>
              <run fontcolor='#222222' fontname='Avenir'>in days, since the first order arrived </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>Average cost of product - </run>
              <run fontcolor='#222222' fontname='Avenir'>COGS / Total units </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>Number of stores selling</run>
              <run fontcolor='#222222' fontname='Avenir'> - Number of stores where the product is listed </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#4e79a7' fontname='Avenir' fontsize='12'>Sales Performance </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>Unit sales</run>
              <run fontcolor='#222222' fontname='Avenir'> - Units sold during x period </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>Share of units (Basket penetration) </run>
              <run fontcolor='#222222' fontname='Avenir'>- % of the total units. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>Net Retail Revenue</run>
              <run fontcolor='#222222' fontname='Avenir'> - Revenue from the sales of SKUs - VAT</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>Share of Net Retail Revenue</run>
              <run fontcolor='#222222' fontname='Avenir'> - as % of the total sales. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>Customers</run>
              <run fontcolor='#222222' fontname='Avenir'> - Number of unique customers that bought the sku </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>Orders</run>
              <run fontcolor='#222222' fontname='Avenir'> - Total number of orders that included the SKU</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>SKU Velocity - </run>
              <run fontcolor='#222222' fontname='Avenir'>Unit sales / Active stores / week(/s)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#4e79a7' fontname='Avenir' fontsize='12'>Profitability</run>
              <run bold='true' fontcolor='#4e79a7' fontname='Avenir'>Æ </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>Front (Net) Margin $</run>
              <run fontcolor='#222222' fontname='Avenir'> - Front earnings </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>Share of Front (Net) Margin</run>
              <run fontcolor='#222222' fontname='Avenir'> - as % of the total</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>Front Margin % -  </run>
              <run fontcolor='#222222' fontname='Avenir'>Front Earnings/Sales </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>PPP - </run>
              <run fontcolor='#222222' fontname='Avenir'> Front earnings+Supplier funding </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>Share of PPP</run>
              <run fontcolor='#222222' fontname='Avenir'> - as % of the total.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>PPP Margin</run>
              <run fontcolor='#222222' fontname='Avenir'> - PPP/Sales </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#4e79a7' fontname='Avenir' fontsize='12'>Operational indicators </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>Availability</run>
              <run fontcolor='#222222' fontname='Avenir'> - Only available if Stock in hand is higher than the minimum order quantity, calculated as available days / total days in period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>Shrinkage</run>
              <run fontcolor='#222222' fontname='Avenir'> - Monetary value lost due to shrinkage</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>% Shrinkage</run>
              <run fontcolor='#222222' fontname='Avenir'> - Shrinkage as % of sales </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>Stock Units - </run>
              <run fontcolor='#222222' fontname='Avenir'>Average stock units of the CP </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>DOH</run>
              <run fontcolor='#222222' fontname='Avenir'>Æ </run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>Days of inventory</run>
              <run fontcolor='#222222' fontname='Avenir'> - </run>
              <run fontcolor='#1d1c1d' fontname='Avenir'>Inventory in units/daily sales units</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#222222' fontname='Avenir'>Number of stores stocking</run>
              <run fontcolor='#222222' fontname='Avenir'> - Average number of stores where the product was available</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
