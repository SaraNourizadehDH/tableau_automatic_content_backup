    <worksheet name='Operational Reporting Weekly'>
      <table>
        <view>
          <datasources>
            <datasource caption='Assortment Report' name='federated.0ay3zvo1kwsigy1b42qse1paqqy2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
            <column alias='Weekly' caption='Date Level' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ay3zvo1kwsigy1b42qse1paqqy2'>
            <column caption='Shrinkage' datatype='real' name='[COGS (copy)_5871638394937298975]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;EUR&apos; THEN [shrinkage_amt_eur]&#10;WHEN &apos;Local Currency&apos; THEN [shrinkage_amt_lc]&#10;END' />
            </column>
            <column caption='Status' datatype='string' name='[Calculation_5871638392462495744]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_active] = TRUE THEN &apos;Active&apos; &#10;ELSE &apos;Inactive&apos;&#10;END' />
            </column>
            <column caption='SKU Age (Days)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_5871638392467095557]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='AVG([sku_age_in_days])' />
            </column>
            <column caption='Stores Selling' datatype='integer' name='[Calculation_5871638392474738694]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([warehouse_id_selling])' />
            </column>
            <column caption='Average Cost' datatype='real' name='[Calculation_5871638392476139527]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(CASE [Parameters].[Parameter 1]&#10;WHEN &apos;EUR&apos; THEN [average_cost_eur]&#10;WHEN &apos;Local Currency&apos; THEN [average_cost_lc]&#10;END)' />
            </column>
            <column caption='Stores Stocking' datatype='integer' name='[Calculation_5871638392479473672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([warehouse_id_stocking])' />
            </column>
            <column caption='Net Retail Revenue' datatype='real' name='[Calculation_5871638392481222665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [Parameters].[Parameter 1]&#10;WHEN &apos;EUR&apos; THEN [net_retail_revenue_eur]&#10;WHEN &apos;Local Currency&apos; THEN [net_retail_revenue_lc]&#10;END)' />
            </column>
            <column caption='Show Data' datatype='string' name='[Calculation_5871638392512425996]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2]' />
            </column>
            <column caption='Days in period' datatype='real' name='[Calculation_5871638392524918798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [sku], [date_level], [iso_date]: AVG(&#10;{FIXED [sku], [warehouse_name], [date_level], [iso_date]: AVG([days_in_period])})})' />
            </column>
            <column caption='Weeks in Period' datatype='real' name='[Calculation_5871638392528773135]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_5871638392524918798])&#10;&#10;/ AVG([Calculation_5871638392530243600])' />
            </column>
            <column caption='Days in Week' datatype='integer' name='[Calculation_5871638392530243600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='7' />
            </column>
            <column caption='Velocity Weekly' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5871638392530911249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_sold]) / COUNTD(if [Calculation_5871638392462495744] = &apos;Active&apos; THEN [warehouse_name] END) &#10;&#10;/ [Calculation_5871638392528773135]' />
            </column>
            <column caption='COGS' datatype='real' name='[Calculation_5871638392746295318]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;EUR&apos; THEN [cogs_eur]&#10;WHEN &apos;Local Currency&apos; THEN [cogs_lc]&#10;END' />
            </column>
            <column caption='Availability' datatype='real' name='[Calculation_5871638392772071451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([available_times]) / SUM([days_in_period])' />
            </column>
            <column caption='Date' datatype='datetime' name='[Calculation_5871638394903355422]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 2], [iso_date])' />
            </column>
            <column caption='Shrinkage %' datatype='real' name='[Calculation_5871638394937466912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([COGS (copy)_5871638394937298975]) / ([Calculation_5871638392481222665])' />
            </column>
            <column caption='DOH Weekly' datatype='real' name='[Calculation_5871638394948112418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Shrinkage (copy)_5871638394947854369]) / SUM([Calculation_5871638392746295318]) * 7' />
            </column>
            <column caption='Stock Value' datatype='real' name='[Shrinkage (copy)_5871638394947854369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;EUR&apos; THEN [stock_value_eur]&#10;WHEN &apos;Local Currency&apos; THEN [stock_value_lc]&#10;END' />
            </column>
            <column caption='Available Times' datatype='integer' name='[available_times]' role='measure' type='quantitative' />
            <column caption='Average Cost Eur' datatype='real' name='[average_cost_eur]' role='measure' type='quantitative' />
            <column caption='Average Cost Lc' datatype='real' name='[average_cost_lc]' role='measure' type='quantitative' />
