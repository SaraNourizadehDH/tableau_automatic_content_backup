            </column>
            <column caption='Front (Net) Margin' datatype='real' name='[Calculation_5871638392746455063]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5871638392481222665] - SUM([Calculation_5871638392746295318])' />
            </column>
            <column caption='Front (Net) Margin %' datatype='real' name='[Calculation_5871638392746663960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_5871638392481222665] - SUM([Calculation_5871638392746295318])) / [Calculation_5871638392481222665]' />
            </column>
            <column caption='PPP' datatype='real' name='[Calculation_5871638392746799129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;EUR&apos; THEN [ppp_eur]&#10;WHEN &apos;Local Currency&apos; THEN [ppp_lc]&#10;END' />
            </column>
            <column caption='PPP Margin %' datatype='real' name='[Calculation_5871638392746934298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_5871638392746799129]) / ([Calculation_5871638392481222665])' />
            </column>
            <column caption='Availability' datatype='real' name='[Calculation_5871638392772071451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([available_times]) / SUM([days_in_period])' />
