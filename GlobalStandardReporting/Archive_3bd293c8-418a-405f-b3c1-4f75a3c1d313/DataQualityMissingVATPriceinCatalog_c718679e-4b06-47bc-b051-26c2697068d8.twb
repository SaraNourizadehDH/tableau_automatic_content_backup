      <aliases enabled='yes' />
      <column caption='Distinct SKUs' datatype='integer' name='[Calculation_5668554237963710464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([skus])' />
      </column>
      <column caption='Distinct Missing VAT SKUs' datatype='integer' name='[Calculation_5977613753423831040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(CASE [product_vat_rate] WHEN NULL THEN [skus] END)' />
      </column>
      <column caption='Distinct 0 VAT SKUs' datatype='integer' name='[Calculation_5977613753427357699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(CASE [product_vat_rate] WHEN 0 THEN [skus] END)' />
      </column>
      <column caption='Is Catalog Price Zero' datatype='boolean' name='[Calculation_5977613753429491716]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[catalog_price_lc] = 0' />
      </column>
      <column caption='Distinct Catalog Price 0 SKUs' datatype='integer' name='[Calculation_5977613753429815301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_5977613753429491716] THEN [skus] END)' />
      </column>
      <column caption='VAT is ZERO/0' datatype='boolean' name='[Calculation_6183231232930820096]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[product_vat_rate] = 0' />
      </column>
      <column caption='Is Missing VAT Rate' datatype='boolean' name='[Missing VAT Rate (copy)_5977613753424998401]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [product_vat_rate] WHEN NULL THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Zero VAT Rate' datatype='integer' name='[Missing VAT Rate (copy)_5977613753426776066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [product_vat_rate] WHEN 0 THEN 1 END' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
