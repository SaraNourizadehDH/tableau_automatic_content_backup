      <column caption='Avg. Picking Time (m)' datatype='real' name='[Avg Assignment Time (S) (copy)_1760344572831461378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([picking_time_m_sum])/(SUM([picking_time_m_count]))' />
      </column>
      <column caption='Avg. Delivery Time (m)' datatype='real' name='[Avg. At Vendor Time (m) (copy)_2742340357606166531]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([delivery_time_dmart_sum])/(sum([delivery_time_dmart_count]))' />
      </column>
      <column caption='Avg. End to End Delivery Time(m)' datatype='real' name='[Avg. At Vendor Time (m) (copy)_2742340357607317508]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([delivery_time_logistics_sum])/sum([delivery_time_logistics_count])' />
      </column>
      <column caption='Avg. SKUs per Order' datatype='real' name='[Avg. Basket Value (copy)_472877987021529090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([skus_sold])/sum([all_customer_orders])' />
      </column>
      <column caption='Avg. Picking Time per SKU (S)' datatype='real' name='[Avg. Picking Time (S) (copy)_472877987005030400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(60*SUM([picking_time_m_sum]))/SUM([skus_sold])' />
      </column>
      <column caption='Avg. Qty per Order' datatype='real' name='[Avg. SKUs per Order (copy)_472877987023253507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([quantity_sold])/sum([all_customer_orders])' />
      </column>
      <column caption='Avg. At Vendor Time (m)' datatype='real' name='[Avg. To Vendor Time (m) (copy)_2742340357602926593]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([at_vendor_time_s_sum])/(60*sum([at_vendor_time_s_count]))' />
      </column>
      <column caption='Avg. To Customer Time (m)' datatype='real' name='[Avg. To Vendor Time (m) (copy)_2742340357604712450]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([to_customer_time_s_sum])/(60*sum([to_customer_time_s_count]))' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_12525677450035201]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='% Rider Late &gt; 5mins' datatype='real' name='[Calculation_1760344572830089216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rider_late_gt5])/SUM([all_customer_orders])' />
      </column>
      <column caption='Avg. Assignment Time (m)' datatype='real' name='[Calculation_1760344572830289921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([assignment_time_m_sum])/SUM([assignment_time_m_count])' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_1760344572834332675]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1],[period]))' />
      </column>
      <column caption='Avg. To Vendor Time (m)' datatype='real' name='[Calculation_2742340357601517568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([to_vendor_time_s_sum])/(60*sum([to_vendor_time_s_count]))' />
      </column>
      <column caption='Stacked %' datatype='real' name='[Calculation_2742340357620789253]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([stacked_orders])/sum([all_customer_orders])' />
      </column>
      <column caption='Split Delivery %' datatype='real' name='[Calculation_2742340357630550022]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([utr_split_orders_count])/sum([utr_orders])' />
      </column>
      <column caption='Known Shrink %' datatype='real' name='[Calculation_2742340357640478727]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([known_shrink_eur])/sum([sales_eur])' />
      </column>
      <column caption='Unknown Shrink %' datatype='real' name='[Calculation_2742340357640962056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([unknown_shrink_eur])/sum([sales_eur])' />
      </column>
      <column caption='Avg. Basket Value' datatype='real' name='[Calculation_472877987019464705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sales_eur])/sum([successful_orders])' />
      </column>
      <column caption='Availability %' datatype='real' name='[Calculation_472877987026636804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([available_hours])/SUM([potential_hours])' />
      </column>
