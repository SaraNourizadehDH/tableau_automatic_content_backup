  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='KPI Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/Darkstores-OperationalExcellenceKPIs_16541744568320/KPIDefinitions?rev=' id='KPIDefinitions' path='/t/GlobalStandardReporting/workbooks/Darkstores-OperationalExcellenceKPIs_16541744568320' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_5' value='top' />
        </style-rule>
      </style>
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='8375' id='3' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='14'>KPI Definitions</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='85625' id='5' type-v2='text' w='98400' x='800' y='9375'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='10' underline='true'>Picker Performance</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Avg. Assignment Time (m): Average time taken to assign an order</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Avg. Picking Time (m)- Average time taken by picker to pick an order</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Avg. Picking Time per SKU (s): Average time taken by picker to pick an SKU </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10' underline='true'>Store Performance</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Total Customer Orders: Total number of customer orders received </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>No. of POs received: During receiving, number of POs inbounded by the store </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Cycle Count Batches: How many cycle count batches have been completed per store </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Cycle Count SKUs: How many cycle count SKUs have been completed per store </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Successful Customer Orders : Total number of Successful customer orders received  </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Avg. Basket Value: Average Basket Value (Excluding Delivery fees) for Successful Customer Orders</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Avg. SKUs per Order: No of unique SKUs per Orders</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Avg. Qty per Order: Total Quantity delivered per order</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Known Shrink %: Total Inventory Adjustment Value (Damage, Expired)/ Total Sales</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Unknown Shrink %: Total Inventory Adjustment Value (Cycle Count Removal, Stock Subtraction)/ Total Sales</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Pickers Count: No of Active Pickers</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Avg. Daily Skus Available: Avg. No. of SKU Available at End of Day </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Availability %: Total Aailable SKU Hours/ Total SKU Hours</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10' underline='true'>Customer Experience</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Missing Items delivered: No. of orders which had missing items</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Expired / Damaged  items: No. of orders in which we delivered bad quality items</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Wrong Items Delivered: No. of orders in which we delivered the wrong items</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Switch Orders Delivered: No. of times customer received a wrong bag altogether</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Contact Rate: How many times Customer Contact the customer service </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Refund Amount: Refund amount processed by the Customer Service team</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Auto Refund Amount: Auto refund amount to the customer due to order modification</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10' underline='true'>Logistics Performance</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>% Rider Lateness &gt; 5 mins:  How many times the rider was late by more than 5 mins after the order was prepared and ready for pick up</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Avg. To Vendor Time (m): Avg. time between rider acceptance and arriving at the restaurant</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Avg. At Vendor Time (m): Avg. time difference between rider arrival at vendor and the rider picking up the food</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Avg. To Customer Time (m): Avg. time difference between rider arrival at customer and the pickup time.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Avg. End to End Delivery Time(m): Avg. time it took to deliver the order. Measured from order creation until rider at customer from Logistics.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Stacked Delivery %: No of Orders with Stacked Delivery/ Total Orders</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='10'>Stacked %: No of Orders with Split Delivery/ Total Orders</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='4000' id='6' type-v2='empty' w='98400' x='800' y='95000'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
