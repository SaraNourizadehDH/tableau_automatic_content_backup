          <datasources>
            <datasource caption='tableau_supplier_performance_monthly_report (rl_dmart)' name='federated.11wred70jzh0q81b1u7zo0ephhe4' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.11wred70jzh0q81b1u7zo0ephhe4'>
            <column caption='Brand % of Value of Category' datatype='real' name='[Brand % of Qty of Category (copy)_1530660974781558802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([Total Qty by Category - Brand  (copy)_1530660974781366288])/SUM([Total Qty by Category (copy)_1530660974781263887]))' />
            </column>
            <column caption='Brand % of Value of Supplier-Category' datatype='real' name='[Brand % of Qty of Supplier-Category (copy)_1530660974781759507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([Total Qty by Category - Brand  (copy)_1530660974781366288])/SUM([Total Qty by Category - Supplier  (copy)_1530660974781456401]))' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_1530660974721089538]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(CASE [Parameters].[Parameter 1] WHEN &apos;Euro&apos; THEN [total_price_paid_eur]&#10;ELSE [total_price_paid_lc] END)' />
            </column>
            <column caption='Total Qty by Category' datatype='real' name='[Calculation_1530660974754512903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [aggregation_level],[global_entity_id],[category],[month]:sum([qty_delivered])}' />
            </column>
