            </column>
            <column caption='Brand % of Qty of Category' datatype='real' name='[Calculation_1530660974754951178]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([Calculation_1530660974754553864])/SUM([Calculation_1530660974754512903]))' />
