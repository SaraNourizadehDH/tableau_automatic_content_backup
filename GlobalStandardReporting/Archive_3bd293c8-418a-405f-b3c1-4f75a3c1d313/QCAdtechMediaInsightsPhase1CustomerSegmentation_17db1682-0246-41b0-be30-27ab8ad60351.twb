      <column caption='Night Shopper' datatype='real' name='[Morning Shopper (copy)_1643110201659809793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 2]=&apos;Lifetime&apos;&#10;THEN&#10;SUM([qc_lifetime_night_order_count])&#10;/(SUM([qc_lifetime_morning_order_count])+SUM([qc_lifetime_afternoon_order_count])+SUM([qc_lifetime_night_order_count]))&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Last year&apos;&#10;THEN&#10;SUM([qc_lastyear_night_order_count])&#10;/(SUM([qc_lastyear_morning_order_count])+SUM([qc_lastyear_afternoon_order_count])+SUM([qc_lastyear_night_order_count]))&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;16 weeks&apos;&#10;THEN&#10;SUM([qc_last16w_night_order_count])&#10;/(SUM([qc_last16w_morning_order_count])+SUM([qc_last16w_afternoon_order_count])+SUM([qc_last16w_night_order_count]))&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;4 weeks&apos;&#10;THEN&#10;SUM([qc_last4w_night_order_count])&#10;/(SUM([qc_last4w_morning_order_count])+SUM([qc_last4w_afternoon_order_count])+SUM([qc_last4w_night_order_count]))&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;1 week&apos;&#10;THEN&#10;SUM([qc_last1w_night_order_count])&#10;/(SUM([qc_last1w_morning_order_count])+SUM([qc_last1w_afternoon_order_count])+SUM([qc_last1w_night_order_count]))&#10;END' />
