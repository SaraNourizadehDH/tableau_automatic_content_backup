            <column caption='Last16W Voucher sum' datatype='real' name='[Last16W Qty ordered (copy)_2281706550470017028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[darkstores_last16w_voucher_sum]+ [localstores_last16w_voucher_sum]' />
