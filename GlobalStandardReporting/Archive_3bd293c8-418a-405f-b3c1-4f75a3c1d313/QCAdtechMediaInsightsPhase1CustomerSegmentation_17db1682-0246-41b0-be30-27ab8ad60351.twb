                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='250' h='14444' id='311' is-fixed='true' name='AllStores_discountsegment' show-title='false' w='82583' x='1167' y='61165'>
