      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='user_profiles_segments (cl_dmart)' name='federated.0jaxr8v1p4aspm14xh9z71587fdh' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Total GMV' caption='Metrics' datatype='string' name='[Metric (copy)_607915608915910656]' param-domain-type='list' role='measure' type='nominal' value='&quot;GMV&quot;'>
              <calculation class='tableau' formula='&quot;GMV&quot;' />
              <aliases>
                <alias key='&quot;Discount sum&quot;' value='Total Discount' />
                <alias key='&quot;GMV&quot;' value='Total GMV' />
                <alias key='&quot;Qty ordered&quot;' value='Total Qty ordered' />
              </aliases>
            </column>
            <column caption='Timeframe' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Lifetime&quot;'>
              <calculation class='tableau' formula='&quot;Lifetime&quot;' />
            </column>
            <column caption='Top N Group' datatype='integer' name='[Parameter 5]' param-domain-type='any' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
            </column>
            <column caption='First Segment' datatype='string' name='[Segment for Graph 1 (copy)_6798676243794608152]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekday Shopper&quot;'>
              <calculation class='tableau' formula='&quot;Weekday Shopper&quot;' />
            </column>
            <column caption='Second Segment' datatype='string' name='[Segment for Graph 2 (copy)_6798676243794636825]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekend Shopper&quot;'>
              <calculation class='tableau' formula='&quot;Weekend Shopper&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jaxr8v1p4aspm14xh9z71587fdh'>
            <column caption='Axis Title Metrics' datatype='string' name='[Calculation_2904962528962785285]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Metric (copy)_607915608915910656]&#10;WHEN &quot;Discount sum&quot; THEN &quot;Discount sum&quot;&#10;WHEN &quot;GMV&quot; THEN &quot;GMV&quot;&#10;WHEN &quot;Qty ordered&quot; THEN &quot;Qty ordered&quot;&#10;END' />
            </column>
            <column caption='Axis title timeframe' datatype='string' name='[Calculation_2904962529006407686]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Lifetime&quot;  THEN &quot;Lifetime&quot;&#10;WHEN &quot;Last year&quot; THEN &quot;Last year&quot;&#10;WHEN &quot;16 weeks&quot;  THEN &quot;16 weeks&quot;&#10;WHEN &quot;4 weeks&quot;   THEN &quot;4 weeks&quot;&#10;WHEN &quot;1 week&quot;    THEN &quot;1 week&quot;&#10;END' />
            </column>
            <column caption='First Segment' datatype='string' name='[Calculation_3979774717593001985]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Segment for Graph 1 (copy)_6798676243794608152] = &apos;Alcohol Shopper&apos; then [alcohol_shopper]&#10;&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Discount Shopper&apos; then [alcohol_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Exploring Shopper&apos; then [exploring_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Fickle Shopper&apos; then [fickle_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Fresh Shopper&apos; then [fresh_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Guaranteed Shopper&apos; then [guaranteed_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Goal Oreintated Shopper&apos; then [goal_orientated_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Snacks Shopper&apos; then [snacks_shopper]      &#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Ultra Fresh Shopper&apos; then [ultra_fresh_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Weekday Shopper&apos; then [weekday_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Weekend Shopper&apos; then [weekend_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] = &apos;Voucher Shopper&apos; then [voucher_shopper]&#10;END' />
              <aliases>
                <alias key='&quot;1&quot;' value='First segment' />
              </aliases>
            </column>
            <column caption='Index First Segment' datatype='integer' name='[Calculation_6798676243506507785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Segment with 0/1' datatype='string' name='[Calculation_6798676243610206229]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//Filter segments which have 1 in either area&#10;IF &#10;[Calculation_3979774717593001985]=&apos;1&apos; or [Segment for Graph1 (copy)_3979774717595312130]=&apos;1&apos;&#10;THEN &#10;&apos;True&apos;&#10;ELSE&#10;&apos;False&apos;&#10;END' />
            </column>
            <column caption='Index Second Segment' datatype='integer' name='[Index segment A (copy)_6798676243506589706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Metrics_product level' datatype='real' name='[Metrics_allstores (copy) (copy) (copy)_223139315675217922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;   [Parameters].[Parameter 2] = &quot;16 weeks&quot; &#10;       THEN (&#10;             IF &#10;              [Parameters].[Metric (copy)_607915608915910656]= &apos;Discount sum&apos; THEN (SUM([product_last16w_discount_amount])/SUM([product_last16w_quantity_sold]))*100&#10;             ELSEIF &#10;              [Parameters].[Metric (copy)_607915608915910656] = &apos;GMV&apos; then SUM([product_last16w_gmv_sum])/SUM([product_last16w_quantity_sold])&#10;             //ELSEIF &#10;             // [Metric] = &apos;Order count&apos; then SUM([Last16W Order Count])&#10;             ELSEIF &#10;              [Parameters].[Metric (copy)_607915608915910656] = &apos;Qty ordered&apos; then SUM([product_last16w_quantity_sold])&#10;            // ELSEIF &#10;             // [Metric] = &apos;Voucher sum&apos; then SUM([Last16W Voucher sum])/SUM([Last16W Order Count])&#10;            // ELSEIF &#10;              //[Metric] = &apos;Unique Customers&apos; then [Unique Customers]&#10;        END&#10;)&#10;// 4 WEEKS//&#10;ELSEIF&#10;  [Parameters].[Parameter 2]=&quot;4 weeks&quot;&#10;THEN   (&#10;    IF &#10;     [Parameters].[Metric (copy)_607915608915910656]= &apos;Discount sum&apos; then (SUM([product_last4w_discount_amount])/SUM([product_last4w_quantity_sold]))*100&#10;    ELSEIF &#10;     [Parameters].[Metric (copy)_607915608915910656] = &apos;GMV&apos; then SUM([product_last4w_gmv_sum])/SUM([product_last4w_quantity_sold])&#10;    //ELSEIF &#10;    // [Metric] = &apos;Order count&apos; then SUM([Last4W Order Count])&#10;    ELSEIF &#10;     [Parameters].[Metric (copy)_607915608915910656] = &apos;Qty ordered&apos; then SUM([product_last4w_quantity_sold])&#10;   // ELSEIF &#10;    // [Metric] = &apos;Voucher sum&apos; then SUM([Last4W Voucher sum])/SUM([Last4W Order Count])&#10;    //ELSEIF &#10;    // [Metric] = &apos;Unique Customers&apos; then [Unique Customers]&#10;END&#10;)&#10;ELSEIF&#10;  [Parameters].[Parameter 2]=&quot;1 week&quot;&#10;THEN   (&#10;    IF &#10;     [Parameters].[Metric (copy)_607915608915910656]= &apos;Discount sum&apos; then (SUM([product_last1w_discount_amount])/SUM([product_last1w_quantity_sold]))*100&#10;    ELSEIF &#10;     [Parameters].[Metric (copy)_607915608915910656] = &apos;GMV&apos; then SUM([product_last1w_gmv_sum])/SUM([product_last1w_quantity_sold])&#10;    //ELSEIF &#10;     //[Metric] = &apos;Order count&apos; then SUM([Last1W Order Count])&#10;    ELSEIF &#10;     [Parameters].[Metric (copy)_607915608915910656] = &apos;Qty ordered&apos; then SUM([product_last1w_quantity_sold])&#10;    //ELSEIF &#10;     //[Metric] = &apos;Voucher sum&apos; then SUM([Last1W Voucher sum])/SUM([Last1W Order Count])&#10;    //ELSEIF &#10;     //[Metric] = &apos;Unique Customers&apos; then [Unique Customers]&#10;END&#10;)&#10;ELSEIF&#10;  [Parameters].[Parameter 2]=&quot;Last year&quot;&#10;THEN   (&#10;    IF &#10;     [Parameters].[Metric (copy)_607915608915910656]= &apos;Discount sum&apos; then (SUM([product_lastyear_discount_amount])/SUM([product_lastyear_quantity_sold]))*100&#10;    ELSEIF &#10;     [Parameters].[Metric (copy)_607915608915910656] = &apos;GMV&apos; then SUM([product_lastyear_gmv_sum])/SUM([product_lastyear_quantity_sold])&#10;    //ELSEIF &#10;     //[Metric] = &apos;Order count&apos; then SUM([Lastyear Order Count])&#10;    ELSEIF &#10;     [Parameters].[Metric (copy)_607915608915910656] = &apos;Qty ordered&apos; then SUM([product_lastyear_quantity_sold])&#10;    //ELSEIF &#10;     //[Metric] = &apos;Voucher sum&apos; then SUM([Lastyear Voucher sum])/SUM([Lastyear Order Count])&#10;    //ELSEIF &#10;     //[Metric] = &apos;Unique Customers&apos; then [Unique Customers]&#10;END&#10;)&#10;ELSEIF&#10;  [Parameters].[Parameter 2]=&quot;Lifetime&quot;&#10;THEN   (&#10;    IF &#10;     [Parameters].[Metric (copy)_607915608915910656]= &apos;Discount sum&apos; then (SUM([product_lifetime_discount_amount])/SUM([product_lifetime_quantity_sold]))*100&#10;    ELSEIF &#10;     [Parameters].[Metric (copy)_607915608915910656] = &apos;GMV&apos; then SUM([product_lifetime_gmv_sum])/SUM([product_lifetime_quantity_sold])&#10;    //ELSEIF &#10;     //[Metric] = &apos;Order count&apos; then SUM([Lifetime Order Count])&#10;    ELSEIF &#10;     [Parameters].[Metric (copy)_607915608915910656] = &apos;Qty ordered&apos; then SUM([product_lifetime_quantity_sold])&#10;    //ELSEIF &#10;     //[Metric] = &apos;Voucher sum&apos; then SUM([Lifetime Voucher sum])/SUM([Lifetime Order Count])&#10;    //ELSEIF &#10;     //[Metric] = &apos;Unique Customers&apos; then [Unique Customers]&#10;END&#10;)&#10;&#10;END' />
