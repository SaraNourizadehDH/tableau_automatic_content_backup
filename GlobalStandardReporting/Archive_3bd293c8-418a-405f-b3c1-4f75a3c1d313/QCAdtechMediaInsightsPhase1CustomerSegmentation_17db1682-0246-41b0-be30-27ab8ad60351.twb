                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='4500' id='314' type-v2='text' w='82583' x='1167' y='56665'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='12'>Discount Segment</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>Based on Marketing Tech segmentation, tailored for QC orders.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>Segments created based on proportion of total order value that is made up by incentives (discount + voucher) used for orders in the last 4 months.  </run>
                    <run>Æ&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
