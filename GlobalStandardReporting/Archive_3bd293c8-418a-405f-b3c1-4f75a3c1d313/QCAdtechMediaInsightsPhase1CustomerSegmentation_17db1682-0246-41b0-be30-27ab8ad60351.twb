      <column caption='Axis title Metric' datatype='string' name='[Calculation_2904962528961114116]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &quot;Discount sum&quot;     THEN &quot;Avg Discount&quot;&#10;WHEN &quot;GMV&quot;              THEN &quot;Avg GMV&quot;&#10;WHEN &quot;Qty ordered&quot;      THEN &quot;Avg Quantity ordered&quot;&#10;WHEN &quot;Order count&quot;      THEN &quot;Order count&quot;&#10;WHEN &quot;Voucher sum&quot;      THEN &quot;Voucher sum&quot;&#10;WHEN &quot;Unique Customers&quot; THEN &quot;Unique customers&quot;&#10;&#10;else NULL&#10;&#10;END' />
