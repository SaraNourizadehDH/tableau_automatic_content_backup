    <worksheet name='Discount Shopper'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='9'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='user_profiles_segments (cl_dmart)' name='federated.0jaxr8v1p4aspm14xh9z71587fdh' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Avg. GMV' caption='Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;GMV&quot;'>
              <calculation class='tableau' formula='&quot;GMV&quot;' />
              <aliases>
                <alias key='&quot;Discount sum&quot;' value='Avg. discount' />
                <alias key='&quot;GMV&quot;' value='Avg. GMV' />
                <alias key='&quot;Qty ordered&quot;' value='Avg. quantity ordered' />
                <alias key='&quot;Voucher sum&quot;' value='Avg. voucher sum' />
              </aliases>
            </column>
            <column caption='Timeframe' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Lifetime&quot;'>
              <calculation class='tableau' formula='&quot;Lifetime&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jaxr8v1p4aspm14xh9z71587fdh'>
            <column caption='Last16W Discount Sum' datatype='real' name='[Calculation_2281706550469423104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[darkstores_last16w_discount_sum]+ [localstores_last16w_discount_sum]' />
            </column>
            <column caption='Timeframe customer count' datatype='integer' name='[Calculation_4687402819684085761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 2]=&apos;1 week&apos; and (([Last1W Discount Sum (copy)_2764576880128221188])&gt;0) then 1 &#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;4 weeks&apos; and (([Last16W Discount GMV sum (copy)_2281706550470209541])&gt;0) &#10;THEN 1 &#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;16 weeks&apos; and (([Last16W Discount Sum (copy)_2281706550469640193])&gt;0) &#10;THEN 1 &#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Last year&apos; and  (([Last1W GMV Sum (copy)_2764576880129130505])&gt;0) &#10;THEN 1 &#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Lifetime&apos; and (([Lastyear GMV Sum (copy)_2764576880137015311])&gt;0) &#10;THEN 1 &#10;&#10;else 0 END' />
            </column>
            <column caption='Unique Customers' datatype='integer' name='[Calculation_6372452757941436417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([analytical_customer_id])' />
            </column>
            <column caption='Last16W Order Count' datatype='integer' name='[Last16W Discount GMV sum (copy)_2281706550469763074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[darkstores_last16w_order_count]+ [localstores_last16w_order_count]' />
            </column>
            <column caption='Last4W GMV Sum' datatype='real' name='[Last16W Discount GMV sum (copy)_2281706550470209541]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[darkstores_last4w_gmv_sum]+ [localstores_last4w_gmv_sum]' />
            </column>
            <column caption='Last16W GMV sum' datatype='real' name='[Last16W Discount Sum (copy)_2281706550469640193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[darkstores_last16w_gmv_sum]+ [localstores_last16w_gmv_sum]' />
            </column>
            <column caption='Last4W Discount Sum' datatype='real' name='[Last16W Discount Sum (copy)_2281706550470356998]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[darkstores_last4w_discount_sum]+ [localstores_last4w_discount_sum]' />
            </column>
            <column caption='Last1W Discount Sum' datatype='real' name='[Last16W Discount Sum (copy)_2764576880127250432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[darkstores_last1w_discount_sum]+ [localstores_last1w_discount_sum]' />
            </column>
            <column caption='Last16W Qty ordered' datatype='integer' name='[Last16W Order Count (copy)_2281706550469885955]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[darkstores_last16w_qty_ordered]+ [localstores_last16w_qty_ordered]' />
            </column>
