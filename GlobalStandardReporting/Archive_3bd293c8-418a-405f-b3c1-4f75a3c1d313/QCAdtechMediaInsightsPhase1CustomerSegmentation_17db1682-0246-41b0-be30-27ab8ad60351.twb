              <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 2]=&apos;1 week&apos; and (([Last1W Discount Sum (copy)_2764576880128221188])&gt;0) then 1 &#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;4 weeks&apos; and (([Last16W Discount GMV sum (copy)_2281706550470209541])&gt;0) &#10;THEN 1 &#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;16 weeks&apos; and (([Last16W Discount Sum (copy)_2281706550469640193])&gt;0) &#10;THEN 1 &#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Last year&apos; and  (([Last1W GMV Sum (copy)_2764576880129130505])&gt;0) &#10;THEN 1 &#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Lifetime&apos; and (([Lastyear GMV Sum (copy)_2764576880137015311])&gt;0) &#10;THEN 1 &#10;&#10;else 0 END' />
