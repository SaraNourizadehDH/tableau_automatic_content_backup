            <column caption='Metrics_brand level' datatype='real' name='[Metrics_allstores (copy) (copy)_223139315675205633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;   [Parameters].[Parameter 2] = &quot;16 weeks&quot; &#10;       THEN (&#10;             IF &#10;              [Parameters].[Metric (copy)_607915608915910656]= &apos;Discount sum&apos; THEN (SUM([brand_last16w_discount_amount])/SUM([brand_last16w_quantity_sold]))*100&#10;             ELSEIF &#10;              [Parameters].[Metric (copy)_607915608915910656] = &apos;GMV&apos; then SUM([brand_last16w_gmv_sum])/SUM([brand_last16w_quantity_sold])&#10;             //ELSEIF &#10;              //[Metric] = &apos;Order count&apos; then SUM([Last16W Order Count])&#10;             ELSEIF &#10;              [Parameters].[Metric (copy)_607915608915910656] = &apos;Qty ordered&apos; then SUM([brand_last16w_quantity_sold])&#10;             //ELSEIF &#10;              //[Metric] = &apos;Voucher sum&apos; then SUM([Last16W Voucher sum])/SUM([Last16W Order Count])&#10;             //ELSEIF &#10;              //[Metric] = &apos;Unique Customers&apos; then [Unique Customers]&#10;        END&#10;)&#10;// 4 WEEKS//&#10;ELSEIF&#10;  [Parameters].[Parameter 2]=&quot;4 weeks&quot;&#10;THEN   (&#10;    IF &#10;     [Parameters].[Metric (copy)_607915608915910656]= &apos;Discount sum&apos; then (SUM([brand_last4w_discount_amount])/SUM([brand_last4w_quantity_sold]))*100&#10;    ELSEIF &#10;     [Parameters].[Metric (copy)_607915608915910656] = &apos;GMV&apos; then SUM([brand_last4w_gmv_sum])/SUM([brand_last4w_quantity_sold])&#10;   // ELSEIF &#10;     //[Metric] = &apos;Order count&apos; then SUM([Last4W Order Count])&#10;    ELSEIF &#10;     [Parameters].[Metric (copy)_607915608915910656] = &apos;Qty ordered&apos; then SUM([brand_last4w_quantity_sold])&#10;    //ELSEIF &#10;    // [Metric] = &apos;Voucher sum&apos; then SUM([Last4W Voucher sum])/SUM([Last4W Order Count])&#10;   // ELSEIF &#10;     //[Metric] = &apos;Unique Customers&apos; then [Unique Customers]&#10;END&#10;)&#10;ELSEIF&#10;  [Parameters].[Parameter 2]=&quot;1 week&quot;&#10;THEN   (&#10;    IF &#10;     [Parameters].[Metric (copy)_607915608915910656]= &apos;Discount sum&apos; then (SUM([brand_last1w_discount_amount])/SUM([brand_last1w_quantity_sold]))*100&#10;    ELSEIF &#10;     [Parameters].[Metric (copy)_607915608915910656] = &apos;GMV&apos; then SUM([brand_last1w_gmv_sum])/SUM([brand_last16w_quantity_sold])&#10;    //ELSEIF &#10;     //[Metric] = &apos;Order count&apos; then SUM([Last1W Order Count])&#10;    ELSEIF &#10;     [Parameters].[Metric (copy)_607915608915910656] = &apos;Qty ordered&apos; then SUM([brand_last1w_quantity_sold])&#10;   // ELSEIF &#10;    // [Metric] = &apos;Voucher sum&apos; then SUM([Last1W Voucher sum])/SUM([Last1W Order Count])&#10;    //ELSEIF &#10;     //[Metric] = &apos;Unique Customers&apos; then [Unique Customers]&#10;END&#10;)&#10;ELSEIF&#10;  [Parameters].[Parameter 2]=&quot;Last year&quot;&#10;THEN   (&#10;    IF &#10;     [Parameters].[Metric (copy)_607915608915910656]= &apos;Discount sum&apos; then (SUM([brand_lastyear_discount_amount])/SUM([brand_lastyear_quantity_sold]))*100&#10;    ELSEIF &#10;     [Parameters].[Metric (copy)_607915608915910656] = &apos;GMV&apos; then SUM([brand_lastyear_gmv_sum])/SUM([brand_lastyear_quantity_sold])&#10;    //ELSEIF &#10;     //[Metric] = &apos;Order count&apos; then SUM([Lastyear Order Count])&#10;    ELSEIF &#10;     [Parameters].[Metric (copy)_607915608915910656] = &apos;Qty ordered&apos; then SUM([brand_lastyear_quantity_sold])&#10;    //ELSEIF &#10;     //[Metric] = &apos;Voucher sum&apos; then SUM([Lastyear Voucher sum])/SUM([Lastyear Order Count])&#10;    //ELSEIF &#10;     //[Metric] = &apos;Unique Customers&apos; then [Unique Customers]&#10;END&#10;)&#10;ELSEIF&#10;  [Parameters].[Parameter 2]=&quot;Lifetime&quot;&#10;THEN   (&#10;    IF &#10;     [Parameters].[Metric (copy)_607915608915910656]= &apos;Discount sum&apos; then (SUM([brand_lifetime_discount_amount])/SUM([brand_lifetime_quantity_sold]))*100&#10;    ELSEIF &#10;     [Parameters].[Metric (copy)_607915608915910656] = &apos;GMV&apos; then SUM([brand_lifetime_gmv_sum])/SUM([brand_lifetime_quantity_sold])&#10;   // ELSEIF &#10;    // [Metric] = &apos;Order count&apos; then SUM([Lifetime Order Count])&#10;    ELSEIF &#10;     [Parameters].[Metric (copy)_607915608915910656] = &apos;Qty ordered&apos; then SUM([brand_lifetime_quantity_sold])/SUM([Lastyear Order Count (copy)_2764576880137015312])&#10;   // ELSEIF &#10;    // [Metric] = &apos;Voucher sum&apos; then SUM([Lifetime Voucher sum])/SUM([Lifetime Order Count])&#10;    //ELSEIF &#10;     //[Metric] = &apos;Unique Customers&apos; then [Unique Customers]&#10;END&#10;)&#10;&#10;END' />
