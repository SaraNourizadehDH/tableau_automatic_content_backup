              </aliases>
            </column>
            <column caption='Timeframe' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Lifetime&quot;'>
              <calculation class='tableau' formula='&quot;Lifetime&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jaxr8v1p4aspm14xh9z71587fdh'>
            <column caption='Metrics_darkstores' datatype='real' name='[Calculation_1106970734765707264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2] = &quot;16 weeks&quot; then (&#10;&#10;if [Parameters].[Parameter 1]= &apos;Discount sum&apos; then (SUM([darkstores_last16w_discount_sum])/SUM([darkstores_last16w_order_count]))*100&#10;ELSEIF &#10;[Parameters].[Parameter 1] = &apos;GMV&apos; then SUM([darkstores_last16w_gmv_sum])/SUM([darkstores_last16w_order_count])&#10;ELSEIF &#10;[Parameters].[Parameter 1] = &apos;Order count&apos; then SUM([darkstores_last16w_order_count])&#10;ELSEIF &#10;[Parameters].[Parameter 1] = &apos;Qty ordered&apos; then SUM([darkstores_last16w_qty_ordered])/SUM([darkstores_last16w_order_count])&#10;ELSEIF &#10;[Parameters].[Parameter 1] = &apos;Voucher sum&apos; then SUM([darkstores_last16w_voucher_sum])/SUM([darkstores_last16w_order_count])&#10;END&#10;)&#10;&#10;ELSE&#10;(&#10;if [Parameters].[Parameter 1]= &apos;Discount sum&apos; then (SUM([darkstores_last4w_discount_sum])/SUM([darkstores_last4w_order_count]))*100&#10;ELSEIF &#10;[Parameters].[Parameter 1] = &apos;GMV&apos; then SUM([darkstores_last4w_gmv_sum])/SUM([darkstores_last4w_order_count])&#10;ELSEIF &#10;[Parameters].[Parameter 1] = &apos;Order count&apos; then SUM([darkstores_last4w_order_count])&#10;ELSEIF &#10;[Parameters].[Parameter 1] = &apos;Qty ordered&apos; then SUM([darkstores_last4w_qty_ordered])/SUM([darkstores_last4w_order_count])&#10;ELSEIF &#10;[Parameters].[Parameter 1] = &apos;Voucher sum&apos; then SUM([darkstores_last4w_voucher_sum])/SUM([darkstores_last4w_order_count])&#10;END&#10;)&#10;END' />
            </column>
            <column caption='Darkstores Last16W Discount Sum' datatype='real' name='[darkstores_last16w_discount_sum]' role='measure' type='quantitative' />
            <column caption='Darkstores Last16W Gmv Sum' datatype='real' name='[darkstores_last16w_gmv_sum]' role='measure' type='quantitative' />
            <column caption='Darkstores Last16W Order Count' datatype='integer' name='[darkstores_last16w_order_count]' role='measure' type='quantitative' />
            <column caption='Darkstores Last16W Qty Ordered' datatype='integer' name='[darkstores_last16w_qty_ordered]' role='measure' type='quantitative' />
