      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='1650' minheight='1650' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='460' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='459' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone fixed-size='113' h='6277' id='317' is-fixed='true' is-scaled='1' param='Image/Screenshot 2021-10-27 at 14.54.12.png' type-v2='bitmap' w='8917' x='966' y='1112'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#c63530' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='6277' id='33' type-v2='text' w='74234' x='9883' y='1112'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='16'>MKT Tech Segmentation</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='16'>      All Stores</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#c63530' />
                  </zone-style>
                </zone>
                <zone fixed-size='241' forceUpdate='true' h='13389' id='305' type-v2='text' w='82583' x='1167' y='7611'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='12'>Frequency Segment</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>Based on Marketing Tech segmentation, tailored for QC orders.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>Possible values - A, B, C, D, E, F, M, N</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>“N” - new customers who ordered for the first time in the last 4 weeks</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>“M” - new customers who ordered for the first time between the the last 4 and 8 weeks</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>“F” - customers who have only ordered once in their lifetime</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>“E” - customers who have ordered zero or one time in the last 4 months</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>All the rest of the customers (that is, customers that have ordered for the first time more than 8 weeks ago and that have placed at least 2 orders in the last 4 months) are classified in the segments A to D based on their lifetime frequency.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>Lifetime frequency is calculated by: </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>“A” - 75th or above percentile in terms of lifetime frequency</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>“B” - 50th to 75th percentile in terms of lifetime frequency</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>“C” - 25th to 50th percentile in terms of lifetime frequency</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>“D” - 25th or below percentile in terms of lifetime frequency</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone h='2888' id='60' mode='compact' param='[Parameters].[Parameter 2]' type-v2='paramctrl' w='14651' x='84216' y='7612'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone h='2888' id='61' mode='compact' param='[Parameters].[Parameter 1]' type-v2='paramctrl' w='14651' x='84216' y='10500'>
                  <zone-style>
