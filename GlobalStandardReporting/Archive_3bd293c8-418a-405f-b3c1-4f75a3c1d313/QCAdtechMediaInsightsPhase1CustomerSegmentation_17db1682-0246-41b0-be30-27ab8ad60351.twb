          </datasource-dependencies>
          <filter class='categorical' column='[federated.0jaxr8v1p4aspm14xh9z71587fdh].[none:global_entity_id:nk]' context='true' filter-group='4'>
            <groupfilter function='member' level='[none:global_entity_id:nk]' member='&quot;FP_SG&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
