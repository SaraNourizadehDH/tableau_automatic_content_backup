            </column>
            <column caption='Lastyear GMV Sum' datatype='real' name='[Last1W GMV Sum (copy)_2764576880129130505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[darkstores_lastyear_gmv_sum]+ [localstores_lastyear_gmv_sum]' />
            </column>
