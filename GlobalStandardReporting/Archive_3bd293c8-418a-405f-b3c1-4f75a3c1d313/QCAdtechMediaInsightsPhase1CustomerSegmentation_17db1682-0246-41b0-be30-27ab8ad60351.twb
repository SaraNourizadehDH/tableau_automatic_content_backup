          <zone fixed-size='123' h='8200' id='536' is-fixed='true' param='vert' type-v2='layout-flow' w='98034' x='983' y='11792'>
            <zone fixed-size='91' h='6067' id='385' is-fixed='true' param='horz' type-v2='layout-flow' w='98034' x='983' y='11792'>
              <zone forceUpdate='true' h='6067' id='387' type-v2='text' w='48850' x='983' y='11792'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='10'>Definitions Shopper by Time of day</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000'>Morning Shopper-  </run>
                  <run fontcolor='#000000'>orders between 5am and 12pm</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000'>Afternoon Shopper</run>
                  <run fontcolor='#000000'>Æ </run>
                  <run bold='true' fontcolor='#000000'>-</run>
                  <run fontcolor='#000000'>Æ </run>
                  <run bold='true' fontcolor='#000000'>Æ </run>
                  <run fontcolor='#000000'>orders between 1pm and 5pm</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000'>Night Shopper</run>
                  <run fontcolor='#000000'>Æ </run>
                  <run bold='true' fontcolor='#000000'>Æ </run>
                  <run fontcolor='#000000'>- </run>
                  <run bold='true' fontcolor='#000000'>Æ </run>
                  <run fontcolor='#000000'>orders between 5pm and 5am</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='6067' id='386' type-v2='text' w='49184' x='49833' y='11792'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='10'>Definitions Timeframe distribution</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000'>Lifetime- </run>
                  <run fontcolor='#000000'>from the first date of order till today           </run>
                  <run bold='true' fontcolor='#000000'>Last year</run>
                  <run fontcolor='#000000'>Æ </run>
                  <run bold='true' fontcolor='#000000'>-</run>
                  <run fontcolor='#000000'> from today minus 365 days</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000'>16 weeks </run>
                  <run fontcolor='#000000'>- from today to the last 16 weeks                  </run>
                  <run bold='true' fontcolor='#000000'>4 weeks </run>
                  <run fontcolor='#000000'>- from today to the last 4 weeks</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000'>1 week </run>
                  <run fontcolor='#000000'>- the last 7 days</run>
