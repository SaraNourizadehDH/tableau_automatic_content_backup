            <column caption='Darkstores Last4W Gmv Sum' datatype='real' name='[darkstores_last4w_gmv_sum]' role='measure' type='quantitative' />
            <column caption='Darkstores Last4W Order Count' datatype='integer' name='[darkstores_last4w_order_count]' role='measure' type='quantitative' />
            <column caption='Darkstores Last4W Qty Ordered' datatype='integer' name='[darkstores_last4w_qty_ordered]' role='measure' type='quantitative' />
            <column caption='Darkstores Last4W Voucher Sum' datatype='real' name='[darkstores_last4w_voucher_sum]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[global_entity_id]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;FP_HK&quot;' value='Hongkong' />
                <alias key='&quot;FP_MY&quot;' value='Malaysia' />
