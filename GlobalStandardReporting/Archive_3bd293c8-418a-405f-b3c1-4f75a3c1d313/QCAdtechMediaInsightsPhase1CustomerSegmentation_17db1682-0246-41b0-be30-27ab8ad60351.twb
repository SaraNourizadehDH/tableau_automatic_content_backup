              <calculation class='tableau' formula='IF &#10;     [Parameters].[Parameter 1]= &apos;Discount sum&apos; then (SUM([Lastyear Discount Sum (copy)_2764576880137015310])/SUM([Lastyear Order Count (copy)_2764576880137015312]))*100&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;GMV&apos; then SUM([Lastyear GMV Sum (copy)_2764576880137015311])/SUM([Lastyear Order Count (copy)_2764576880137015312])&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;Order count&apos; then SUM([Lastyear Order Count (copy)_2764576880137015312])&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;Qty ordered&apos; then SUM([Lastyear Qty ordered (copy)_2764576880137015313])/SUM([Lastyear Order Count (copy)_2764576880137015312])&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;Voucher sum&apos; then SUM([Lastyear Voucher sum (copy)_2764576880137015314])/SUM([Lastyear Order Count (copy)_2764576880137015312])&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;Unique Customers&apos; then [Calculation_6372452757941436417]&#10;END' />
