              <calculation class='tableau' formula='CASE [Parameters].[Metric (copy)_607915608915910656]&#10;WHEN &quot;Discount sum&quot; THEN &quot;Discount sum&quot;&#10;WHEN &quot;GMV&quot; THEN &quot;GMV&quot;&#10;WHEN &quot;Qty ordered&quot; THEN &quot;Qty ordered&quot;&#10;END' />
