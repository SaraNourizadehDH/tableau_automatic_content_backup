              <calculation class='tableau' formula='IF &#10;   [Parameters].[Parameter 2] = &quot;16 weeks&quot; &#10;       THEN (&#10;             IF &#10;              [Parameters].[Parameter 1]= &apos;Discount sum&apos; THEN (SUM([Calculation_2281706550469423104])/SUM([Last16W Discount GMV sum (copy)_2281706550469763074]))*100&#10;             ELSEIF &#10;              [Parameters].[Parameter 1] = &apos;GMV&apos; then SUM([Last16W Discount Sum (copy)_2281706550469640193])/SUM([Last16W Discount GMV sum (copy)_2281706550469763074])&#10;             ELSEIF &#10;              [Parameters].[Parameter 1] = &apos;Order count&apos; then SUM([Last16W Discount GMV sum (copy)_2281706550469763074])&#10;             ELSEIF &#10;              [Parameters].[Parameter 1] = &apos;Qty ordered&apos; then SUM([Last16W Order Count (copy)_2281706550469885955])/SUM([Last16W Discount GMV sum (copy)_2281706550469763074])&#10;             ELSEIF &#10;              [Parameters].[Parameter 1] = &apos;Voucher sum&apos; then SUM([Last16W Qty ordered (copy)_2281706550470017028])/SUM([Last16W Discount GMV sum (copy)_2281706550469763074])&#10;             ELSEIF &#10;              [Parameters].[Parameter 1] = &apos;Unique Customers&apos; then [Calculation_6372452757941436417]&#10;        END&#10;)&#10;// 4 WEEKS//&#10;ELSEIF&#10;  [Parameters].[Parameter 2]=&quot;4 weeks&quot;&#10;THEN   (&#10;    IF &#10;     [Parameters].[Parameter 1]= &apos;Discount sum&apos; then (SUM([Last16W Discount Sum (copy)_2281706550470356998])/SUM([Last16W Order Count (copy)_2281706550470545415]))*100&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;GMV&apos; then SUM([Last16W Discount GMV sum (copy)_2281706550470209541])/SUM([Last16W Order Count (copy)_2281706550470545415])&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;Order count&apos; then SUM([Last16W Order Count (copy)_2281706550470545415])&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;Qty ordered&apos; then SUM([Last16W Qty ordered (copy)_2281706550470836232])/SUM([Last16W Order Count (copy)_2281706550470545415])&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;Voucher sum&apos; then SUM([Last16W Voucher sum (copy)_2281706550470971401])/SUM([Last16W Order Count (copy)_2281706550470545415])&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;Unique Customers&apos; then [Calculation_6372452757941436417]&#10;END&#10;)&#10;ELSEIF&#10;  [Parameters].[Parameter 2]=&quot;1 week&quot;&#10;THEN   (&#10;    IF &#10;     [Parameters].[Parameter 1]= &apos;Discount sum&apos; then (SUM([Last16W Discount Sum (copy)_2764576880127250432])/SUM([Last1W GMV Sum (copy)_2764576880128450565]))*100&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;GMV&apos; then SUM([Last1W Discount Sum (copy)_2764576880128221188])/SUM([Last1W GMV Sum (copy)_2764576880128450565])&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;Order count&apos; then SUM([Last1W GMV Sum (copy)_2764576880128450565])&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;Qty ordered&apos; then SUM([Last1W GMV Sum (copy) (copy)_2764576880128462854])/SUM([Last1W GMV Sum (copy)_2764576880128450565])&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;Voucher sum&apos; then SUM([Last1W GMV Sum (copy) (copy) (copy)_2764576880128491527])/SUM([Last1W GMV Sum (copy)_2764576880128450565])&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;Unique Customers&apos; then [Calculation_6372452757941436417]&#10;END&#10;)&#10;ELSEIF&#10;  [Parameters].[Parameter 2]=&quot;Last year&quot;&#10;THEN   (&#10;    IF &#10;     [Parameters].[Parameter 1]= &apos;Discount sum&apos; then (SUM([Last1W Discount Sum (copy)_2764576880129130504])/SUM([Last1W Order Count (copy)_2764576880129130508]))*100&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;GMV&apos; then SUM([Last1W GMV Sum (copy)_2764576880129130505])/SUM([Last1W Order Count (copy)_2764576880129130508])&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;Order count&apos; then SUM([Last1W Order Count (copy)_2764576880129130508])&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;Qty ordered&apos; then SUM([Last1W Qty ordered (copy)_2764576880129130507])/SUM([Last1W Order Count (copy)_2764576880129130508])&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;Voucher sum&apos; then SUM([Last1W Voucher sum (copy)_2764576880129130506])/SUM([Last1W Order Count (copy)_2764576880129130508])&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;Unique Customers&apos; then [Calculation_6372452757941436417]&#10;END&#10;)&#10;ELSEIF&#10;  [Parameters].[Parameter 2]=&quot;Lifetime&quot;&#10;THEN   (&#10;    IF &#10;     [Parameters].[Parameter 1]= &apos;Discount sum&apos; then (SUM([Lastyear Discount Sum (copy)_2764576880137015310])/SUM([Lastyear Order Count (copy)_2764576880137015312]))*100&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;GMV&apos; then SUM([Lastyear GMV Sum (copy)_2764576880137015311])/SUM([Lastyear Order Count (copy)_2764576880137015312])&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;Order count&apos; then SUM([Lastyear Order Count (copy)_2764576880137015312])&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;Qty ordered&apos; then SUM([Lastyear Qty ordered (copy)_2764576880137015313])/SUM([Lastyear Order Count (copy)_2764576880137015312])&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;Voucher sum&apos; then SUM([Lastyear Voucher sum (copy)_2764576880137015314])/SUM([Lastyear Order Count (copy)_2764576880137015312])&#10;    ELSEIF &#10;     [Parameters].[Parameter 1] = &apos;Unique Customers&apos; then [Calculation_6372452757941436417]&#10;END&#10;)&#10;&#10;END' />
