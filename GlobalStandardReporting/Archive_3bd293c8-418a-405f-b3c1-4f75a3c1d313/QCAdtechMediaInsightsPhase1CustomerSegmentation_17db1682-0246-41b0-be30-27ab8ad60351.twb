    <worksheet name='Time (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Shoppers by Time of day</run>
            <run>Æ&#10;</run>
            <run bold='true'>Æ                  </run>
            <run bold='true' fontsize='12'>Æ                 </run>
            <run bold='true' fontsize='9'><![CDATA[ <[Parameters].[Segment for Graph 1 (copy)_6798676243794608152]>                                                              <[Parameters].[Segment for Graph 2 (copy)_6798676243794636825]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='user_profiles_segments (cl_dmart)' name='federated.0jaxr8v1p4aspm14xh9z71587fdh' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Timeframe' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Lifetime&quot;'>
              <calculation class='tableau' formula='&quot;Lifetime&quot;' />
            </column>
            <column caption='First Segment' datatype='string' name='[Segment for Graph 1 (copy)_6798676243794608152]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekday Shopper&quot;'>
              <calculation class='tableau' formula='&quot;Weekday Shopper&quot;' />
            </column>
            <column caption='Second Segment' datatype='string' name='[Segment for Graph 2 (copy)_6798676243794636825]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekend Shopper&quot;'>
              <calculation class='tableau' formula='&quot;Weekend Shopper&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jaxr8v1p4aspm14xh9z71587fdh'>
            <column caption='Morning Shopper' datatype='real' name='[Calculation_1643110201658597376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 2]=&apos;Lifetime&apos;&#10;THEN&#10;SUM([qc_lifetime_morning_order_count])&#10;/(SUM([qc_lifetime_morning_order_count])+SUM([qc_lifetime_afternoon_order_count])+SUM([qc_lifetime_night_order_count]))&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Last year&apos;&#10;THEN&#10;SUM([qc_lastyear_morning_order_count])&#10;/(SUM([qc_lastyear_morning_order_count])+SUM([qc_lastyear_afternoon_order_count])+SUM([qc_lastyear_night_order_count]))&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;16 weeks&apos;&#10;THEN&#10;SUM([qc_last16w_morning_order_count])&#10;/(SUM([qc_last16w_morning_order_count])+SUM([qc_last16w_afternoon_order_count])+SUM([qc_last16w_night_order_count]))&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;4 weeks&apos;&#10;THEN&#10;SUM([qc_last4w_morning_order_count])&#10;/(SUM([qc_last4w_morning_order_count])+SUM([qc_last4w_afternoon_order_count])+SUM([qc_last4w_night_order_count]))&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;1 week&apos;&#10;THEN&#10;SUM([qc_last1w_morning_order_count])&#10;/(SUM([qc_last1w_morning_order_count])+SUM([qc_last1w_afternoon_order_count])+SUM([qc_last1w_night_order_count]))&#10;END' />
            </column>
            <column caption='Axis title timeframe' datatype='string' name='[Calculation_2904962529006407686]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Lifetime&quot;  THEN &quot;Lifetime&quot;&#10;WHEN &quot;Last year&quot; THEN &quot;Last year&quot;&#10;WHEN &quot;16 weeks&quot;  THEN &quot;16 weeks&quot;&#10;WHEN &quot;4 weeks&quot;   THEN &quot;4 weeks&quot;&#10;WHEN &quot;1 week&quot;    THEN &quot;1 week&quot;&#10;END' />
            </column>
            <column caption='First Segment' datatype='string' name='[Calculation_3979774717593001985]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Segment for Graph 1 (copy)_6798676243794608152] = &apos;Alcohol Shopper&apos; then [alcohol_shopper]&#10;&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Discount Shopper&apos; then [alcohol_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Exploring Shopper&apos; then [exploring_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Fickle Shopper&apos; then [fickle_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Fresh Shopper&apos; then [fresh_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Guaranteed Shopper&apos; then [guaranteed_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Goal Oreintated Shopper&apos; then [goal_orientated_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Snacks Shopper&apos; then [snacks_shopper]      &#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Ultra Fresh Shopper&apos; then [ultra_fresh_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Weekday Shopper&apos; then [weekday_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Weekend Shopper&apos; then [weekend_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] = &apos;Voucher Shopper&apos; then [voucher_shopper]&#10;END' />
              <aliases>
                <alias key='&quot;1&quot;' value='First segment' />
              </aliases>
            </column>
            <column caption='Index First Segment' datatype='integer' name='[Calculation_6798676243506507785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Segment with 0/1' datatype='string' name='[Calculation_6798676243610206229]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//Filter segments which have 1 in either area&#10;IF &#10;[Calculation_3979774717593001985]=&apos;1&apos; or [Segment for Graph1 (copy)_3979774717595312130]=&apos;1&apos;&#10;THEN &#10;&apos;True&apos;&#10;ELSE&#10;&apos;False&apos;&#10;END' />
            </column>
            <column caption='Index Second Segment' datatype='integer' name='[Index segment A (copy)_6798676243506589706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Night Shopper' datatype='real' name='[Morning Shopper (copy)_1643110201659809793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 2]=&apos;Lifetime&apos;&#10;THEN&#10;SUM([qc_lifetime_night_order_count])&#10;/(SUM([qc_lifetime_morning_order_count])+SUM([qc_lifetime_afternoon_order_count])+SUM([qc_lifetime_night_order_count]))&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Last year&apos;&#10;THEN&#10;SUM([qc_lastyear_night_order_count])&#10;/(SUM([qc_lastyear_morning_order_count])+SUM([qc_lastyear_afternoon_order_count])+SUM([qc_lastyear_night_order_count]))&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;16 weeks&apos;&#10;THEN&#10;SUM([qc_last16w_night_order_count])&#10;/(SUM([qc_last16w_morning_order_count])+SUM([qc_last16w_afternoon_order_count])+SUM([qc_last16w_night_order_count]))&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;4 weeks&apos;&#10;THEN&#10;SUM([qc_last4w_night_order_count])&#10;/(SUM([qc_last4w_morning_order_count])+SUM([qc_last4w_afternoon_order_count])+SUM([qc_last4w_night_order_count]))&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;1 week&apos;&#10;THEN&#10;SUM([qc_last1w_night_order_count])&#10;/(SUM([qc_last1w_morning_order_count])+SUM([qc_last1w_afternoon_order_count])+SUM([qc_last1w_night_order_count]))&#10;END' />
            </column>
            <column caption='Afternoon Shopper' datatype='real' name='[Morning Shopper (copy)_1643110201660633090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 2]=&apos;Lifetime&apos;&#10;THEN&#10;SUM([qc_lifetime_afternoon_order_count])&#10;/(SUM([qc_lifetime_morning_order_count])+SUM([qc_lifetime_afternoon_order_count])+SUM([qc_lifetime_night_order_count]))&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Last year&apos;&#10;THEN&#10;SUM([qc_lastyear_afternoon_order_count])&#10;/(SUM([qc_lastyear_morning_order_count])+SUM([qc_lastyear_afternoon_order_count])+SUM([qc_lastyear_night_order_count]))&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;16 weeks&apos;&#10;THEN&#10;SUM([qc_last16w_afternoon_order_count])&#10;/(SUM([qc_last16w_morning_order_count])+SUM([qc_last16w_afternoon_order_count])+SUM([qc_last16w_night_order_count]))&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;4 weeks&apos;&#10;THEN&#10;SUM([qc_last4w_afternoon_order_count])&#10;/(SUM([qc_last4w_morning_order_count])+SUM([qc_last4w_afternoon_order_count])+SUM([qc_last4w_night_order_count]))&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;1 week&apos;&#10;THEN&#10;SUM([qc_last1w_afternoon_order_count])&#10;/(SUM([qc_last1w_morning_order_count])+SUM([qc_last1w_afternoon_order_count])+SUM([qc_last1w_night_order_count]))&#10;END' />
            </column>
            <column caption='Second Segment' datatype='string' name='[Segment for Graph1 (copy)_3979774717595312130]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Segment for Graph 2 (copy)_6798676243794636825] = &apos;Alcohol Shopper&apos; then [alcohol_shopper]&#10;&#10;ELSEIF &#10;[Parameters].[Segment for Graph 2 (copy)_6798676243794636825] =  &apos;Discount Shopper&apos; then [alcohol_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 2 (copy)_6798676243794636825] =  &apos;Exploring Shopper&apos; then [exploring_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 2 (copy)_6798676243794636825] =  &apos;Fickle Shopper&apos; then [fickle_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 2 (copy)_6798676243794636825] =  &apos;Fresh Shopper&apos; then [fresh_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 2 (copy)_6798676243794636825] =  &apos;Guaranteed Shopper&apos; then [guaranteed_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 2 (copy)_6798676243794636825] =  &apos;Goal Oreintated Shopper&apos; then [goal_orientated_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 2 (copy)_6798676243794636825] =  &apos;Snacks Shopper&apos; then [snacks_shopper]      &#10;ELSEIF &#10;[Parameters].[Segment for Graph 2 (copy)_6798676243794636825] =  &apos;Ultra Fresh Shopper&apos; then [ultra_fresh_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 2 (copy)_6798676243794636825] =  &apos;Weekday Shopper&apos; then [weekday_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 2 (copy)_6798676243794636825] =  &apos;Weekend Shopper&apos; then [weekend_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 2 (copy)_6798676243794636825] = &apos;Voucher Shopper&apos; then [voucher_shopper]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 2 (copy)_6798676243794636825] = &apos;No Selection&apos; then &quot;0&quot;&#10;END' />
              <aliases>
