      <column caption='Stores - Equipment Data' datatype='integer' name='[# of Countries (copy)_4428164386451013635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;  IF [equipment_volume_m] &gt; 0 THEN [store_name]&#10;  ELSE NULL&#10;  END&#10;)' />
