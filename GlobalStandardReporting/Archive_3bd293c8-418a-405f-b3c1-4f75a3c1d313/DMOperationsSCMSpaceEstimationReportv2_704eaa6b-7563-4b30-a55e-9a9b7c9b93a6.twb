      <column caption='Utilization Rate (%)' datatype='real' name='[Calculation_4428164386456793096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([stock_volume_m])/sum([equipment_volume_m])' />
      </column>
      <column caption='Utilization Granularity' datatype='string' name='[Calculation_4670584711382302720]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;store&quot; THEN [store_name]&#10;WHEN &quot;country&quot; THEN [country]&#10;ELSE NULL&#10;END' />
