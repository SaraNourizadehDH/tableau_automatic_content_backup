      <aliases enabled='yes' />
      <column caption='Difference: Forecasted - Clocked ' datatype='real' name='[Actual - Planned (copy)_2872522525966921729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4960926119661735937]) - SUM([pickers_worked])' />
      </column>
      <column caption='Difference: Clocked - Planned' datatype='real' name='[Calculation_2872522525966852096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pickers_worked]) - SUM([pickers_planned])' />
      </column>
      <column caption='Hours Forecasted' datatype='real' name='[Calculation_4960926119661735937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5023483933263224834] / [Parameters].[Parameter 1]' />
      </column>
      <column caption='Hours Demanded' datatype='real' name='[Calculation_4960926119662071810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_actual]) / [Parameters].[Parameter 1]' />
      </column>
      <column caption='Delta Order Forecast (Absolute)' datatype='real' name='[Calculation_5023483933241233408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_5023483933263224834], 0) - IFNULL([orders_actual], 0)' />
      </column>
      <column caption='Delta Order Forecast (Percentage)' datatype='real' default-format='p0.00%' name='[Calculation_5023483933245693953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_5023483933263224834]) - SUM([orders_actual]))&#10;/&#10;SUM([Calculation_5023483933263224834])' />
      </column>
      <column caption='Orders [Forecast]' datatype='real' name='[Calculation_5023483933263224834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 2]&#10;when 1 then [orders_forecasted_sr]&#10;when 2 then [orders_forecasted_r]&#10;when 3 then [orders_forecasted_ra]&#10;end' />
      </column>
      <column caption='Date Hours Forecasted (Absolute)' datatype='real' name='[Calculation_5023483933268062211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4960926119661735937]) - SUM([pickers_worked])' />
      </column>
