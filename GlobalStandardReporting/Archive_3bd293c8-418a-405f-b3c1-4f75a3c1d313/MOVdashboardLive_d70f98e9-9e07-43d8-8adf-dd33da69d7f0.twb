      <table>
        <view>
          <datasources>
            <datasource caption='shops_mov_orders (live)' name='federated.1dw53dw0uebn5k19zy94k0me2b10' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Aggregate Distance (KM) Value over (please input based on the Currency Code)' datatype='integer' name='[Aggregate Basket Value over (please input based on the Currency Code) (copy)_1964132433326878725]' param-domain-type='range' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
              <range max='10000' min='2' />
            </column>
            <column caption='Bucket Size (Distance in KM)' datatype='real' datatype-customized='true' name='[Bucket Size (BV) (copy)_1964132433326669828]' param-domain-type='range' role='measure' type='quantitative' value='1.'>
              <calculation class='tableau' formula='1.' />
              <range granularity='0.1' max='100.0' min='0.1' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1dw53dw0uebn5k19zy94k0me2b10'>
            <column aggregation='Sum' caption='Distance (KM) Value buckets (&gt;=n)' datatype='real' name='[Basket Value bukets (Local) (copy)_1964132433325936643]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_1964132433329639430] &gt; [Parameters].[Aggregate Basket Value over (please input based on the Currency Code) (copy)_1964132433326878725] then [Parameters].[Aggregate Basket Value over (please input based on the Currency Code) (copy)_1964132433326878725]&#10;// - 0.5 so 10.5 will go to 10 not 11, and 10.4 still goes to 10&#10;elseif ([Calculation_1964132433329639430]/[Parameters].[Bucket Size (BV) (copy)_1964132433326669828]) &gt;= 0.5 then ROUND([Calculation_1964132433329639430]/[Parameters].[Bucket Size (BV) (copy)_1964132433326669828] - 0.4999999999999999999999 , 0) * [Parameters].[Bucket Size (BV) (copy)_1964132433326669828]&#10;ELSEIF  ([Calculation_1964132433329639430]/[Parameters].[Bucket Size (BV) (copy)_1964132433326669828]) &lt; 0.5 then 0&#10;END' />
            </column>
            <column caption='CM per order eur' datatype='real' name='[CM_per_order_eur]' role='measure' type='quantitative' />
            <column caption='CM per order local' datatype='real' name='[CM_per_order_local]' role='measure' type='quantitative' />
            <column caption='Delivery Distance (KM)' datatype='real' name='[Calculation_1964132433329639430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[delivery_distance]/1000' />
            </column>
            <column caption='CM Per Order' datatype='real' name='[Calculation_498210752914481156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;Euro&apos; then [CM_per_order_eur]&#10;when &apos;Local&apos; then [CM_per_order_local]&#10;ELSE null&#10;END' />
            </column>
            <column caption='Chain' datatype='string' name='[Calculation_5792192127169396736]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ifnull([chain_name],&quot;Null Chain Name&quot;) +&quot; | &quot;+ [chain_id]' />
