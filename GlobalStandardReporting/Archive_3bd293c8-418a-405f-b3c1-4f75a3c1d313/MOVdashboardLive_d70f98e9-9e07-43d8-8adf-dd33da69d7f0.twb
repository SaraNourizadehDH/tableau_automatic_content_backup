    <worksheet name='Table 3a: MOV, Revenue, Costs per Country'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#d61f26'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='shops_mov_orders (live)' name='federated.1dw53dw0uebn5k19zy94k0me2b10' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1dw53dw0uebn5k19zy94k0me2b10'>
            <column caption='Average Service Fee Per Order' datatype='real' name='[Average Commission Per Order (copy)_565624012332773397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;Local&apos; then avg([service_fee_local])&#10;when &apos;Euro&apos; then avg([service_fee_eur])&#10;END' />
            </column>
            <column caption='Average Delivery Costs Per Order' datatype='real' name='[Average Commission Per Order (copy)_565624012333244439]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;Local&apos; then avg([delivery_costs_local])&#10;when &apos;Euro&apos; then avg([delivery_costs_eur])&#10;END' />
            </column>
            <column caption='Average Commission Per Order' datatype='real' name='[Average Realized DF Per Order (copy)_565624012332404756]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;Local&apos; then avg([Commission_local])&#10;when &apos;Euro&apos; then avg([Commission_eur])&#10;END' />
            </column>
            <column caption='Average MOV Fee Per Order' datatype='real' name='[Average Service Fee Per Order (copy)_565624012332957718]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;Local&apos; then avg([mov_fee_local])&#10;when &apos;Euro&apos; then avg([mov_fee_eur])&#10;END' />
            </column>
            <column caption='Average MOV' datatype='real' name='[CM Per Order (copy)_1964132431934001152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;Euro&apos; then AVG([mov_eur])&#10;when &apos;Local&apos; then avg([mov_local])&#10;ELSE null&#10;END' />
            </column>
            <column caption='CM per order eur' datatype='real' name='[CM_per_order_eur]' role='measure' type='quantitative' />
            <column caption='CM per order local' datatype='real' name='[CM_per_order_local]' role='measure' type='quantitative' />
            <column caption='CM Per Order' datatype='real' name='[Calculation_498210752914481156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;Euro&apos; then [CM_per_order_eur]&#10;when &apos;Local&apos; then [CM_per_order_local]&#10;ELSE null&#10;END' />
            </column>
            <column caption='Currency Code Display' datatype='string' name='[Calculation_498210752915935237]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;Euro&apos; then &apos;EUR&apos;&#10;when &apos;Local&apos; then [currency_code]&#10;else null&#10;END' />
            </column>
            <column caption='Average Contribution Margin Per Order' datatype='real' name='[Calculation_565624011950010368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg([Calculation_498210752914481156])' />
