        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Shape' />
            <mark-sizing mark-sizing-setting='marks-scaling-off' />
            <encodings>
              <shape column='[federated.1dw53dw0uebn5k19zy94k0me2b10].[none:Calculation_2509701285342257152:nk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#222222' fontname='Arial' fontsize='11'>[New Data Enhancements on 27 June 2023]:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#222222' fontname='Arial' fontsize='11'>With the help of Data Engineers from both Central and Talabat, now the </run>
                <run bold='true' fontcolor='#f28e2b' fontname='Arial' fontsize='11'>Estimated</run>
                <run fontcolor='#222222' fontname='Arial' fontsize='11'> Talabat Commission data for the </run>
                <run bold='true' fontcolor='#222222' fontname='Arial' fontsize='11'>Current Month</run>
                <run fontcolor='#222222' fontname='Arial' fontsize='11'> is sent from Talabat to Central </run>
                <run bold='true' fontcolor='#222222' fontname='Arial' fontsize='11'>on daily basis</run>
                <run fontcolor='#222222' fontname='Arial' fontsize='11'>.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#222222' fontname='Arial' fontsize='11'>Then, same as before, Talabat sends the </run>
                <run bold='true' fontcolor='#222222' fontname='Arial' fontsize='11'>last month </run>
                <run fontcolor='#222222' fontname='Arial' fontsize='11'>commission data (</run>
                <run bold='true' fontcolor='#59a14f' fontname='Arial' fontsize='11'>Finalised</run>
                <run fontcolor='#222222' fontname='Arial' fontsize='11'>) to the Central Data Hub </run>
                <run bold='true' fontcolor='#222222' fontname='Arial' fontsize='11'>after the first week of this month</run>
                <run fontcolor='#222222' fontname='Arial' fontsize='11'>.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#222222' fontname='Arial' fontsize='11'>Therefore, for example, the Final April Talabat &quot;Commission Per Order&quot; will be available in the MOV dashboard after 8th May.</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='size' value='0.86756908893585205' />
                <format attr='mark-color' value='#ffffff' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid='{52D4F338-9938-4804-9B55-9044729F5973}' />
    </worksheet>
