        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.12gym0s1mzl83e1g6d4gb06j9w11' name='Custom SQL Query' type='text'>SELECT 
region,
CAST(`shops_mov_orders`.`BV_eur` AS FLOAT64) AS `BV_eur`,
  CAST(`shops_mov_orders`.`BV_local` AS FLOAT64) AS `BV_local`,
  `shops_mov_orders`.`CM_per_order_eur` AS `CM_per_order_eur`,
  `shops_mov_orders`.`CM_per_order_local` AS `CM_per_order_local`,
  CAST(`shops_mov_orders`.`Commission_eur` AS FLOAT64) AS `Commission_eur`,
  CAST(`shops_mov_orders`.`Commission_local` AS FLOAT64) AS `Commission_local`,
  CAST(`shops_mov_orders`.`DF_eur` AS FLOAT64) AS `DF_eur`,
  CAST(`shops_mov_orders`.`DF_local` AS FLOAT64) AS `DF_local`,
  `shops_mov_orders`.`MOV_flag` AS `MOV_flag`,
  CAST(`shops_mov_orders`.`commission_base_eur` AS FLOAT64) AS `commission_base_eur`,
  CAST(`shops_mov_orders`.`commission_base_local` AS FLOAT64) AS `commission_base_local`,
  `shops_mov_orders`.`country_name` AS `country_name`,
  `shops_mov_orders`.`currency_code` AS `currency_code`,
  `shops_mov_orders`.`date_of_order` AS `date_of_order`,
  `shops_mov_orders`.`delivery_costs_eur` AS `delivery_costs_eur`,
  `shops_mov_orders`.`delivery_costs_local` AS `delivery_costs_local`,
  `shops_mov_orders`.`delivery_distance` AS `delivery_distance`,
  `shops_mov_orders`.`entity_id` AS `entity_id`,
  `shops_mov_orders`.`isFreeOrderBBDF` AS `isFreeOrderBBDF`,
  `shops_mov_orders`.`is_free_order` AS `is_free_order`,
  `shops_mov_orders`.`items_per_order` AS `items_per_order`,
  CAST(`shops_mov_orders`.`mov_eur` AS FLOAT64) AS `mov_eur`,
  CAST(`shops_mov_orders`.`mov_fee_eur` AS FLOAT64) AS `mov_fee_eur`,
  CAST(`shops_mov_orders`.`mov_fee_local` AS FLOAT64) AS `mov_fee_local`,
  CAST(`shops_mov_orders`.`mov_local` AS FLOAT64) AS `mov_local`,
  `shops_mov_orders`.`order_id` AS `order_id`,
  CAST(`shops_mov_orders`.`service_fee_eur` AS FLOAT64) AS `service_fee_eur`,
  CAST(`shops_mov_orders`.`service_fee_local` AS FLOAT64) AS `service_fee_local`,
  `shops_mov_orders`.`sub_vertical` AS `sub_vertical`,
  `shops_mov_orders`.`week_of_order` AS `week_of_order`,
  chain_id,
  chain_name,
  vendor_id,
  vendor_name,
  main_cuisine
FROM `fulfillment-dwh-production.rl_dmart.shops_mov_orders` `shops_mov_orders`
where date_of_order &gt;&gt;= date(date_trunc(DATE_ADD(CURRENT_DATE,INTERVAL -6 month),month))</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
