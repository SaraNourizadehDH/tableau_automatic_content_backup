    <worksheet name='Chart 1b: Order Pareto distribution by ABV vs Running Total of CM'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#d61f26'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='shops_mov_orders (live)' name='federated.1dw53dw0uebn5k19zy94k0me2b10' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
            <column caption='Bucket Size (BV)' datatype='real' datatype-customized='true' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='1.'>
              <calculation class='tableau' formula='1.' />
              <range granularity='0.1' max='100000.0' min='0.1' />
            </column>
            <column caption='Aggregate Basket Value over (please input based on the Currency Code)' datatype='integer' name='[Parameter 5]' param-domain-type='range' role='measure' type='quantitative' value='20'>
              <calculation class='tableau' formula='20' />
              <range max='1000000000' min='10' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1dw53dw0uebn5k19zy94k0me2b10'>
            <column caption='BV eur' datatype='real' name='[BV_eur]' role='measure' type='quantitative' />
            <column caption='BV local' datatype='real' name='[BV_local]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Basket Value buckets (Local)' datatype='real' name='[Basket Value bukets (EUR) (copy)_498210752913121282]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [BV_local] &gt; [Parameters].[Parameter 5] then [Parameters].[Parameter 5]&#10;// - 0.5 so 10.5 will go to 10 not 11, and 10.4 still goes to 10&#10;elseif ([BV_local]/[Parameters].[Parameter 2]) &gt;= 0.5 then ROUND([BV_local]/[Parameters].[Parameter 2] - 0.4999999999999999999999 , 0) * [Parameters].[Parameter 2]&#10;ELSEIF  ([BV_local]/[Parameters].[Parameter 2]) &lt; 0.5 then 0&#10;&#10;END' />
            </column>
            <column caption='CM per order eur' datatype='real' name='[CM_per_order_eur]' role='measure' type='quantitative' />
            <column caption='CM per order local' datatype='real' name='[CM_per_order_local]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Basket Value buckets (EUR)' datatype='real' name='[Calculation_498210752902787072]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [BV_eur] &gt; [Parameters].[Parameter 5] then [Parameters].[Parameter 5]&#10;// - 0.5 so 10.5 will go to 10 not 11, and 10.4 still goes to 10&#10;elseif ([BV_eur]/[Parameters].[Parameter 2]) &gt;= 0.5 then ROUND([BV_eur]/[Parameters].[Parameter 2] - 0.4999999999999999999999 , 0) * [Parameters].[Parameter 2]&#10;ELSEIF  ([BV_eur]/[Parameters].[Parameter 2]) &lt; 0.5 then 0&#10;END' />
            </column>
            <column aggregation='Sum' caption='Basket Value buckets (&gt;=n)' datatype='real' name='[Calculation_498210752913289219]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;Local&apos; then [Basket Value bukets (EUR) (copy)_498210752913121282]&#10;when &apos;Euro&apos; then [Calculation_498210752902787072]&#10;ELSE null&#10;END' />
            </column>
            <column caption='CM Per Order' datatype='real' name='[Calculation_498210752914481156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;Euro&apos; then [CM_per_order_eur]&#10;when &apos;Local&apos; then [CM_per_order_local]&#10;ELSE null&#10;END' />
            </column>
            <column caption='Chain' datatype='string' name='[Calculation_5792192127169396736]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ifnull([chain_name],&quot;Null Chain Name&quot;) +&quot; | &quot;+ [chain_id]' />
            </column>
            <column caption='Vendor' datatype='string' name='[Calculation_5792192127169888257]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_name]+&quot; | &quot;+[vendor_id]' />
            </column>
            <column caption='MOV flag' datatype='string' name='[MOV_flag]' role='dimension' type='nominal' />
            <column datatype='string' name='[chain_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_498210752914481156]' derivation='Sum' name='[cum:sum:Calculation_498210752914481156:qk]' pivot='key' type='quantitative'>
              <table-calc aggregation='Sum' ordering-type='Rows' type='CumTotal' />
            </column-instance>
            <column caption='Date Of Order' datatype='date' name='[date_of_order]' role='dimension' type='ordinal' />
