      <column caption='ABV' datatype='real' name='[Basket Value bukets (&gt;=n) (copy)_1964132431962202113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;Local&apos; then AVG([BV_local])&#10;when &apos;Euro&apos; then avg([BV_eur])&#10;ELSE null&#10;END' />
      </column>
      <column aggregation='Sum' caption='Basket Value buckets (Local)' datatype='real' name='[Basket Value bukets (EUR) (copy)_498210752913121282]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [BV_local] &gt; [Parameters].[Parameter 5] then [Parameters].[Parameter 5]&#10;// - 0.5 so 10.5 will go to 10 not 11, and 10.4 still goes to 10&#10;elseif ([BV_local]/[Parameters].[Parameter 2]) &gt;= 0.5 then ROUND([BV_local]/[Parameters].[Parameter 2] - 0.4999999999999999999999 , 0) * [Parameters].[Parameter 2]&#10;ELSEIF  ([BV_local]/[Parameters].[Parameter 2]) &lt; 0.5 then 0&#10;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Distance (KM) Value buckets (&gt;=n)' datatype='real' name='[Basket Value bukets (Local) (copy)_1964132433325936643]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Calculation_1964132433329639430] &gt; [Parameters].[Aggregate Basket Value over (please input based on the Currency Code) (copy)_1964132433326878725] then [Parameters].[Aggregate Basket Value over (please input based on the Currency Code) (copy)_1964132433326878725]&#10;// - 0.5 so 10.5 will go to 10 not 11, and 10.4 still goes to 10&#10;elseif ([Calculation_1964132433329639430]/[Parameters].[Bucket Size (BV) (copy)_1964132433326669828]) &gt;= 0.5 then ROUND([Calculation_1964132433329639430]/[Parameters].[Bucket Size (BV) (copy)_1964132433326669828] - 0.4999999999999999999999 , 0) * [Parameters].[Bucket Size (BV) (copy)_1964132433326669828]&#10;ELSEIF  ([Calculation_1964132433329639430]/[Parameters].[Bucket Size (BV) (copy)_1964132433326669828]) &lt; 0.5 then 0&#10;END' />
      </column>
      <column caption='Average MOV' datatype='real' name='[CM Per Order (copy)_1964132431934001152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;Euro&apos; then AVG([mov_eur])&#10;when &apos;Local&apos; then avg([mov_local])&#10;ELSE null&#10;END' />
