    <worksheet name='Country view'>
      <table>
        <view>
          <datasources>
            <datasource caption='pp_dash' name='federated.18l83j70j4gbf0170dx5103lbykl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select KPI' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;UTR&quot;'>
              <calculation class='tableau' formula='&quot;UTR&quot;' />
            </column>
            <column caption='Date granularity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18l83j70j4gbf0170dx5103lbykl'>
            <column caption='Date_1' datatype='string' name='[Calculation_1298514448182894592]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;Quarter&quot; THEN MID(STR(DATE(DATETRUNC(&apos;quarter&apos;,[main_date]))),3,LEN(STR(DATE(DATETRUNC(&apos;quarter&apos;,[main_date]))))-5)&#10;WHEN &quot;Month&quot; THEN MID(STR(DATE(DATETRUNC(&apos;month&apos;,[main_date]))),3,LEN(STR(DATE(DATETRUNC(&apos;month&apos;,[main_date]))))-5)&#10;WHEN &quot;Week&quot; THEN MID(STR(DATE(DATETRUNC(&apos;week&apos;,[main_date]))),3,LEN(STR(DATE(DATETRUNC(&apos;week&apos;,[main_date]))))-0)&#10;WHEN &quot;Day&quot; THEN MID(STR(DATE(DATETRUNC(&apos;day&apos;,[main_date]))),3,LEN(STR(DATE(DATETRUNC(&apos;day&apos;,[main_date]))))-0)&#10;END' />
            </column>
            <column caption='Dynamic KPI select' datatype='real' name='[Calculation_1298514448183877634]' role='measure' type='quantitative' visual-totals='Avg'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;UTR&apos;  then [Calculation_448178545945776128]&#10;WHEN &apos;# Successful orders&apos; then [Calculation_448178545947250694]&#10;WHEN &apos;# Shift hours&apos; then [Calculation_448178545945980931]&#10;WHEN &apos;# Pickers&apos; then [Calculation_168462788898717697]&#10;WHEN &apos;# Shifts&apos; then [Calculation_448178545946595333]&#10;WHEN &apos;% no clocked-out&apos; then [Calculation_448178545946386436]&#10;WHEN &apos;# Shift expected hours&apos; then [Calculation_256494087516364800]&#10;WHEN &apos;# Task hours&apos; then [Calculation_448178546006138896]&#10;WHEN &apos;avg orders per shift&apos; then [Calculation_256494087517220868]&#10;WHEN &apos;avg packing seconds per item&apos; then [Calculation_448178546012209171]&#10;WHEN &apos;avg picking seconds per item&apos; then [Calculation_448178546011590674]&#10;WHEN &apos;avg shift duration&apos; then [Calculation_256494087519793157]&#10;WHEN &apos;% utilized hours&apos; then [Calculation_448178546006573073]&#10;WHEN &apos;% late start&apos; then [Calculation_256494087586369549]&#10;WHEN &apos;# Partial fulfilled orders&apos; then [Calculation_482588867121504257]&#10;WHEN &apos;% partial fulfilled orders&apos; then [Calculation_482588867121577986]&#10;WHEN &apos;avg partial fulfilled per shift&apos; then [Calculation_482588867124457477]&#10;WHEN &apos;avg basket size&apos; then [Calculation_3407958284218576900]&#10;WHEN &apos;# Auto clocked-out shifts&apos; then SUM([Calculation_3407958284231446534])&#10;WHEN &apos;% auto clocked-out shifts&apos; THEN [Calculation_3407958284238282761]&#10;END' />
            </column>
            <column caption='Label % no clocked-out' datatype='real' default-format='p0.0%' name='[Calculation_1298514448197758979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 1]=&apos;% no clocked-out&apos;, [Calculation_1298514448183877634], NULL)' />
            </column>
            <column caption='# Items delivered on Rooster' datatype='real' name='[Calculation_154389048908029952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM ( IF [shift_id] &gt; 0&#10;       THEN [qty_items_picked]&#10;       END)' />
            </column>
            <column caption='# Pickers' datatype='integer' name='[Calculation_168462788898717697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([shopper_id])' />
            </column>
            <column caption='# Shift expected hours' datatype='real' name='[Calculation_256494087516364800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([expected_working_s])/3600' />
            </column>
            <column caption='Label # Shift expected hours' datatype='real' name='[Calculation_256494087516712961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 1]=&apos;# Shift expected hours&apos;, [Calculation_1298514448183877634], NULL)' />
            </column>
            <column caption='#avg orders per shift' datatype='real' name='[Calculation_256494087517220868]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_448178545947250694]/[Calculation_448178545946595333]' />
            </column>
            <column caption='#avg shift duration' datatype='real' name='[Calculation_256494087519793157]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_448178545945980931]/[Calculation_448178545946595333]' />
            </column>
            <column caption='% late start shifts' datatype='real' name='[Calculation_256494087586369549]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [late_start_time_s]&gt;900 THEN [shift_id] else null END)/COUNTD([shift_id])' />
            </column>
            <column caption='#avg basket size' datatype='real' name='[Calculation_3407958284218576900]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_items_picked])/[Calculation_448178545947250694]' />
            </column>
            <column caption='# Auto clocked-out shifts' datatype='integer' name='[Calculation_3407958284231446534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [Calculation_1298514448182894592] : SUM(&#10;    { FIXED [global_entity_id], [main_date] : MAX([auto_clockout_count]) }&#10;)}' />
            </column>
            <column caption='% auto clocked-out shifts' datatype='real' name='[Calculation_3407958284238282761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3407958284231446534])/[Calculation_448178545946595333]' />
            </column>
            <column caption='# UTR' datatype='real' name='[Calculation_448178545945776128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_154389048908029952]/[Calculation_448178545945980931]' />
            </column>
            <column caption='# Shift hours' datatype='real' name='[Calculation_448178545945980931]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([after_adjust_working_s])/3600' />
            </column>
            <column caption='% no clocked-out' datatype='real' name='[Calculation_448178545946386436]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [discrepancy_inputed_expected]&gt;18000 THEN [shift_id] else null END)/COUNTD([shift_id])' />
            </column>
