    <worksheet name='Rooster Compliance Report'>
      <table>
        <view>
          <datasources>
            <datasource caption='pp_dash' name='federated.18l83j70j4gbf0170dx5103lbykl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date granularity' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18l83j70j4gbf0170dx5103lbykl'>
            <column caption='Is rooster' datatype='boolean' name='[Calculation_1250874821150986241]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(ISNULL([rooster_employee_id]),FALSE,TRUE)' />
            </column>
            <column caption='Date_1' datatype='string' name='[Calculation_1298514448182894592]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;Quarter&quot; THEN MID(STR(DATE(DATETRUNC(&apos;quarter&apos;,[main_date]))),3,LEN(STR(DATE(DATETRUNC(&apos;quarter&apos;,[main_date]))))-5)&#10;WHEN &quot;Month&quot; THEN MID(STR(DATE(DATETRUNC(&apos;month&apos;,[main_date]))),3,LEN(STR(DATE(DATETRUNC(&apos;month&apos;,[main_date]))))-5)&#10;WHEN &quot;Week&quot; THEN MID(STR(DATE(DATETRUNC(&apos;week&apos;,[main_date]))),3,LEN(STR(DATE(DATETRUNC(&apos;week&apos;,[main_date]))))-0)&#10;WHEN &quot;Day&quot; THEN MID(STR(DATE(DATETRUNC(&apos;day&apos;,[main_date]))),3,LEN(STR(DATE(DATETRUNC(&apos;day&apos;,[main_date]))))-0)&#10;END' />
            </column>
            <column caption='# Items delivered on Rooster' datatype='real' name='[Calculation_154389048908029952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM ( IF [shift_id] &gt; 0&#10;       THEN [qty_items_picked]&#10;       END)' />
            </column>
            <column caption='# Pickers' datatype='integer' name='[Calculation_168462788898717697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([shopper_id])' />
            </column>
            <column caption='# Shift hours w/o managers' datatype='real' name='[Calculation_1786099516187713541]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE ATTR([job_title])&#10; WHEN &quot;WAREHOUSE_MANAGER&quot; THEN [Calculation_448178545945980931]&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Days_month' datatype='integer' name='[Calculation_1786099516204695561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED YEAR([shift_created_at]),MONTH([shift_created_at]): MAX(INT(DATENAME(&apos;day&apos;,[shift_created_at])))}' />
            </column>
            <column caption='#avg worked hours' datatype='real' name='[Calculation_1786099516206538762]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_448178545945980931]/MAX([Calculation_1786099516204695561])' />
            </column>
            <column caption='#avg shifts per day' datatype='real' name='[Calculation_1786099516207497227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_448178545946595333]/MAX([Calculation_1786099516204695561])' />
            </column>
            <column caption='# Shift expected hours' datatype='real' name='[Calculation_256494087516364800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([expected_working_s])/3600' />
            </column>
            <column caption='#avg shift duration' datatype='real' name='[Calculation_256494087519793157]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_448178545945980931]/[Calculation_448178545946595333]' />
            </column>
            <column caption='# UTR' datatype='real' name='[Calculation_448178545945776128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_154389048908029952]/[Calculation_448178545945980931]' />
            </column>
            <column caption='# Shift hours' datatype='real' name='[Calculation_448178545945980931]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([after_adjust_working_s])/3600' />
            </column>
            <column caption='% no clocked-out' datatype='real' name='[Calculation_448178545946386436]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [discrepancy_inputed_expected]&gt;18000 THEN [shift_id] else null END)/COUNTD([shift_id])' />
            </column>
            <column caption='# Shifts' datatype='integer' name='[Calculation_448178545946595333]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([shift_id])' />
            </column>
            <column caption='# no clocked-out shifts' datatype='integer' name='[Calculation_448178545947369479]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [discrepancy_inputed_expected]&gt;18000 THEN [shift_id] END)' />
            </column>
            <column caption='# Qty delivered' datatype='real' name='[Calculation_448178545968336906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_items_picked])' />
            </column>
            <column caption='Month' datatype='integer' name='[Calculation_6865315462048743425]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='MONTH([main_date])' />
            </column>
            <column caption='# Pickers w/o Rooster id' datatype='integer' name='[Calculation_6865315462050660355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_1250874821150986241]=FALSE THEN [shopper_id] END)' />
            </column>
            <column caption='% worked/planned hours' datatype='real' name='[Calculation_825636524124901378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_256494087516364800]-[Calculation_448178545945980931])/[Calculation_256494087516364800]' />
            </column>
            <column caption='After Adjust Working S' datatype='integer' name='[after_adjust_working_s]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <aliases>
                <alias key='&quot;Dominican Republic&quot;' value='D. Republic' />
                <alias key='&quot;United Arab Emirates&quot;' value='UAE' />
              </aliases>
            </column>
            <column caption='Discrepancy Inputed Expected' datatype='integer' name='[discrepancy_inputed_expected]' role='measure' type='quantitative' />
            <column caption='Expected Working S' datatype='integer' name='[expected_working_s]' role='measure' type='quantitative' />
            <column datatype='string' name='[job_title]' role='dimension' type='nominal' />
            <column datatype='date' name='[main_date]' role='dimension' type='ordinal' />
