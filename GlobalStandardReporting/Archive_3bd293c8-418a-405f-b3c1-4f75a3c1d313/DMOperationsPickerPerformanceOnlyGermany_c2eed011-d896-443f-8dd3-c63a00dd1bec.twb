                    <run fontcolor='#606b76' fontsize='11'>‣ </run>
                    <run bold='true' fontcolor='#606b76' fontsize='11'>Successful orders</run>
                    <run fontcolor='#606b76' fontsize='11'>: </run>
                    <run bold='true' fontcolor='#606b76' fontsize='11'>Æ </run>
                    <run fontcolor='#606b76' fontsize='11'>#Qty of delivered </run>
                    <run bold='true' fontcolor='#606b76' fontsize='11'>orders</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#606b76' fontsize='11'>‣</run>
                    <run bold='true' fontcolor='#606b76' fontsize='11'> Picking hours: </run>
                    <run fontcolor='#606b76' fontsize='11'>#Qty of </run>
                    <run bold='true' fontcolor='#606b76' fontsize='11'>hours</run>
                    <run fontcolor='#606b76' fontsize='11'> spent on picking task</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#606b76' fontsize='11'>‣ </run>
                    <run bold='true' fontcolor='#606b76' fontsize='11'>Packing hours: </run>
                    <run fontcolor='#606b76' fontsize='11'>#Qty of </run>
                    <run bold='true' fontcolor='#606b76' fontsize='11'>hours</run>
                    <run fontcolor='#606b76' fontsize='11'> spent on packing task</run>
