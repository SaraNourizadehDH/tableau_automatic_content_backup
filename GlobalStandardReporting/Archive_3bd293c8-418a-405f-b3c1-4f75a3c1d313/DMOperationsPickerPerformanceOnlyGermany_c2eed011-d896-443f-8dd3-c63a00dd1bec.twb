                    <run fontcolor='#606b76' fontsize='11'>‣ </run>
                    <run bold='true' fontcolor='#606b76' fontsize='11'>% no clock-out: </run>
                    <run fontcolor='#606b76' fontsize='11'>#Qty of </run>
                    <run bold='true' fontcolor='#606b76' fontsize='11'>shifts</run>
                    <run fontcolor='#606b76' fontsize='11'> clocked out 5h or more after expected / # Qty </run>
                    <run bold='true' fontcolor='#606b76' fontsize='11'>shifts</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#606b76' fontsize='11'>‣ </run>
                    <run bold='true' fontcolor='#606b76' fontsize='11'>% late start: </run>
                    <run fontcolor='#606b76' fontsize='11'>#Qty of </run>
                    <run bold='true' fontcolor='#606b76' fontsize='11'>shifts</run>
                    <run fontcolor='#606b76' fontsize='11'> started 15 mins or more after expected/ # Qty </run>
                    <run bold='true' fontcolor='#606b76' fontsize='11'>shifts</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#606b76' fontsize='11'>‣ %  </run>
                    <run bold='true' fontcolor='#606b76' fontsize='11'>Partial fulfilled orders: </run>
