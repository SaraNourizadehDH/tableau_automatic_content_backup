                    <run bold='true' fontcolor='#606b76' fontsize='11'>Pickers: </run>
                    <run fontcolor='#606b76' fontsize='11'>#Qty of </run>
                    <run bold='true' fontcolor='#606b76' fontsize='11'>pickers</run>
                    <run fontcolor='#606b76' fontsize='11'> on that dimension and time (pelican_id and not rooster_id)</run>
