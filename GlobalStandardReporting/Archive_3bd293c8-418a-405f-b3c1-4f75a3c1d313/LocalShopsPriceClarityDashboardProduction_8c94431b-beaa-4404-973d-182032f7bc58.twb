      <aliases enabled='yes' />
      <column caption='# Total Active SKU*' datatype='integer' name='[# Active SKU Below Benchmark (copy)_1553038196279808011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;//when &quot;25th Percentile of Listed Prices&quot; then [total]&#10;//WHEN &quot;50th Percentile of Listed Prices&quot; then [total]&#10;//WHEN &quot;75th Percentile of Listed Prices&quot; then [total]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [count_item_above_25pct_vertical]+[count_item_below_25pct_vertical]&#10;//WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [total]&#10;//WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [total]&#10;//WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then ([total] - [count_item_without_wtd_avg])&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then ([total_count_items] - [count_item_without_dm_wtd_avg])&#10;end' />
      </column>
      <column caption='# Active SKU Above Benchmark' datatype='integer' name='[# Active SKU Below Benchmark (copy)_2014516435463454720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;//when &quot;25th Percentile of Listed Prices&quot; then [count_item_above_25pct]&#10;//WHEN &quot;50th Percentile of Listed Prices&quot; then [count_item_above_50pct]&#10;//WHEN &quot;75th Percentile of Listed Prices&quot; then [count_item_above_75pct]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [count_item_above_25pct_vertical]&#10;//WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [count_item_above_50pct_vertical]&#10;//WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [count_item_above_75pct_vertical]&#10;//WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [count_item_above_wtd_avg_5pct]&#10;when &quot;Dmart Weighted Average of Sold Prices&quot; then [count_item_above_dm_wtd_avg]&#10;end' />
      </column>
      <column caption='% Active SKU Below (Dmart Weighted Avg)' datatype='real' name='[% Active SKU Below (Weighted Avg + 5% markup) (copy)_793829822748823552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([count_item_below_dm_wtd_avg])/sum([count_item_above_dm_wtd_avg]+[count_item_below_dm_wtd_avg])' />
      </column>
      <column caption='% Active SKU Below 25Pct by vertical' datatype='real' name='[% Active SKU Below 25Pct (copy)_1297670075677745155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([count_item_below_25pct_vertical])/sum([# Active SKU Below Benchmark (copy)_1553038196279808011])' />
      </column>
      <column caption='# Active SKU Below Benchmark' datatype='integer' name='[% Active SKU Below Benchmark (copy)_1553038196276400138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;//when &quot;25th Percentile of Listed Prices&quot; then [count_item_below_25pct]&#10;//WHEN &quot;50th Percentile of Listed Prices&quot; then [count_item_below_50pct]&#10;//WHEN &quot;75th Percentile of Listed Prices&quot; then [count_item_below_75pct]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [count_item_below_25pct_vertical]&#10;//WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [count_item_below_50pct_vertical]&#10;//WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [count_item_below_75pct_vertical]&#10;//WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [count_item_below_wtd_avg_5pct]&#10;when &quot;Dmart Weighted Average of Sold Prices&quot; then [count_item_below_dm_wtd_avg]&#10;end' />
      </column>
      <column caption='% Active SKU Above Benchmark' datatype='real' name='[% Active SKU Below Benchmark (copy)_3059210798403952640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;//when &quot;25th Percentile of Listed Prices&quot; then 1-[% Active SKU Below 25Pct]&#10;//WHEN &quot;50th Percentile of Listed Prices&quot; then 1-[% Active SKU Below 50Pct]&#10;//WHEN &quot;75th Percentile of Listed Prices&quot; then 1-[% Active SKU Below 75Pct]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then 1- [% Active SKU Below 25Pct (copy)_1297670075677745155]&#10;//WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then 1 - [% Active SKU Below 50Pct by vertical]&#10;//WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then 1 - [% Active SKU Below 75Pct by vertical]&#10;//WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then 1-[% Active SKU Below (Weighted Avg + 5% markup)]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then 1-[% Active SKU Below (Weighted Avg + 5% markup) (copy)_793829822748823552]&#10;end' />
      </column>
      <column caption='Chain Name *' datatype='string' name='[Calculation_1261781998051356673]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [region]&#10;when &quot;Asia&quot; then [Catalog_Chain_Name]&#10;when &quot;MENA&quot; then [Chain_Name]&#10;END' />
      </column>
      <column caption='Chain Name - ID *' datatype='string' name='[Calculation_1261781998425554948]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1261781998051356673]+&quot;-&quot;+[Chain_ID]' />
