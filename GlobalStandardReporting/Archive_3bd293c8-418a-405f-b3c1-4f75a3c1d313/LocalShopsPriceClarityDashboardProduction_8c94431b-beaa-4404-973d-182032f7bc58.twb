    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Price Clarity - Assortment View'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/LocalShopsPriceClarityDashboardProduction/PriceClarity-AssortmentView?rev=' id='PriceClarity-AssortmentView' path='/t/GlobalStandardReporting/workbooks/LocalShopsPriceClarityDashboardProduction' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#f5f5f6' />
        </style-rule>
      </style>
      <size maxheight='2000' maxwidth='1320' minheight='2000' minwidth='1320' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='lsba_vw_listed_price_vendor_category (prod)' name='federated.19o1vym0uhoegr17t4gxx089dc50 (copy 2)' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Benchmark Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dmart Weighted Average of Sold Prices&quot;'>
          <calculation class='tableau' formula='&quot;Dmart Weighted Average of Sold Prices&quot;' />
          <members>
            <member value='&quot;[By Vertical] 25th Percentile of Listed Prices&quot;' />
            <member value='&quot;Dmart Weighted Average of Sold Prices&quot;' />
          </members>
        </column>
        <column caption='Rank By Vendor Metrics (Assortment View):' datatype='string' name='[Rank By Absolute Amount (Vendor View): (copy)_2730659141063516161]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Monthly Price Updates&quot;'>
          <calculation class='tableau' formula='&quot;# Monthly Price Updates&quot;' />
          <members>
            <member value='&quot;\# Total Active SKU&quot;' />
            <member value='&quot;\# Monthly Price Updates&quot;' />
            <member value='&quot;\# Monthly Order Count&quot;' />
          </members>
        </column>
        <column caption='(Assortment View) Rank By &quot;% Active SKU vs Benchmark&quot; or &quot;# L2 Categories&quot;:' datatype='string' name='[Rank By Calculated Amount (Vendor View): (copy)_2730659141063684098]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Active SKU Above Benchmark&quot;'>
          <calculation class='tableau' formula='&quot;% Active SKU Above Benchmark&quot;' />
          <members>
            <member value='&quot;\% Active SKU Above Benchmark&quot;' />
            <member value='&quot;\% Active SKU Below Benchmark&quot;' />
            <member value='&quot;\# L2 Categories listed&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.19o1vym0uhoegr17t4gxx089dc50 (copy 2)'>
        <column caption='% Active SKU Below Benchmark' datatype='real' name='[Calculation_1553038196198420482]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;//when &quot;25th Percentile of Listed Prices&quot; then [% Active SKU Below 25Pct]&#10;//WHEN &quot;50th Percentile of Listed Prices&quot; then [% Active SKU Below 50Pct]&#10;//WHEN &quot;75th Percentile of Listed Prices&quot; then [% Active SKU Below 75Pct]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [% Active SKU Below 25Pct (copy)_1297670075677745155]&#10;//WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [% Active SKU Below 50Pct by vertical]&#10;//WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [% Active SKU Below 75Pct by vertical]&#10;//WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [% Active SKU Below (Weighted Avg + 5% markup)]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [% Active SKU Below (Weighted Avg + 5% markup) (copy)_793829822748823552]&#10;end' />
        </column>
        <column caption='Chain Name - ID * (c)' datatype='string' name='[Chain Name - ID * (copy)_1034490961724551170]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='[Calculation_1261781998051356673]+&quot;-&quot;+[Chain_ID]' />
        </column>
        <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
        <column caption='Pim Level One Name (c)' datatype='string' name='[Pim Level One Name (copy)_458804233185075210]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='[pim_level_one_name]' />
        </column>
        <column caption='Pim Level Two Name (c)' datatype='string' name='[Pim Level Two Name (copy)_458804233185366027]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='[pim_level_two_name]' />
        </column>
        <column caption='Vendor Name - ID (c)' datatype='string' name='[Vendor Name - ID (copy)_1034490961724485633]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='[Local_Shop_Vendor_Name]+&quot;-&quot;+[vendor_id]' />
        </column>
        <column caption='Account Manager' datatype='string' name='[account_manager]' role='dimension' type='nominal' />
        <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
