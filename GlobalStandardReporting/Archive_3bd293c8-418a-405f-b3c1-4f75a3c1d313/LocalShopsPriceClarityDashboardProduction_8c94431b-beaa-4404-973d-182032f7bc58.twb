    <worksheet name='List of SKUs (Top Chain/Vendors)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#499894' fontsize='10'>Please click on the + in the Country Name column label to zoom into the City column.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='lsba_vw_item_price (prod)' name='federated.0iy36780hye0iu1cc2x2v0w9qxjj (copy 2)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Benchmark Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dmart Weighted Average of Sold Prices&quot;'>
              <calculation class='tableau' formula='&quot;Dmart Weighted Average of Sold Prices&quot;' />
            </column>
            <column caption='Chain/Vendor' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vendor&quot;'>
              <calculation class='tableau' formula='&quot;Vendor&quot;' />
            </column>
            <column caption='Exclude Outlier [markup vs dmart &gt; 200%]' datatype='boolean' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0iy36780hye0iu1cc2x2v0w9qxjj (copy 2)'>
            <column caption='Account Manager' datatype='string' name='[Account_Manager]' role='dimension' type='nominal' />
            <column datatype='string' name='[Barcodes]' role='dimension' type='nominal' />
            <column caption='AAA Chain Flag' datatype='string' name='[Calculation_1034490962125955078]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(isnull([aaa_chain_name_cleaned]),&quot;Not AAA Chain&quot;,&quot;AAA Chain&quot;)' />
            </column>
            <column caption='Listed Price Date' datatype='date' name='[Calculation_2211408171349479424]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(DATETRUNC(&apos;day&apos;, [date_of_listed_price]))' />
            </column>
            <column caption='Benchmark Price' datatype='real' name='[Calculation_2211408171395112963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;//when &quot;25th Percentile of Listed Prices&quot; then [pct25_price]&#10;//WHEN &quot;50th Percentile of Listed Prices&quot; then [med_price]&#10;//WHEN &quot;75th Percentile of Listed Prices&quot; then [pct75_price]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [pct25_price_vertical]&#10;//WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [med_price_vertical]&#10;//WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [pct75_price_vertical]&#10;//WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [shops_wtd_avg_price_lc]SUM([tableau_ls_item_price_mena (local_shops_analytics)].[Dmart Wtd Avg Price Lc])&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [wtd_avg_price_lc]&#10;end' />
            </column>
            <column caption='Markup %' datatype='real' name='[Calculation_2211408171397038085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;case [Parameters].[Parameter 1]&#10;//when &quot;25th Percentile of Listed Prices&quot; then [Markup % (listed price)]&#10;//WHEN &quot;50th Percentile of Listed Prices&quot; then [Markup % (listed price)]&#10;//WHEN &quot;75th Percentile of Listed Prices&quot; then [Markup % (listed price)]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [Markup % (copy)_1297670074872569856]&#10;//WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [Markup % (listed price)]&#10;//WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [Markup % (listed price)]&#10;//WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [Markup % (sold price)]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [Markup % (copy)_1297670074872569856]&#10;end, 0)' />
            </column>
            <column caption='Below Benchmark Flag' datatype='boolean' name='[Calculation_382665296199548930]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;//when &quot;25th Percentile of Listed Prices&quot; then [below_25pct]&#10;//WHEN &quot;50th Percentile of Listed Prices&quot; then [below_50pct]&#10;//WHEN &quot;75th Percentile of Listed Prices&quot; then [below_75pct]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [below_25pct_vertical]&#10;//WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [below_50pct_vertical]&#10;//WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [below_75pct_vertical]&#10;//WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [below_wtd_avg]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [below_dm_wtd_avg]&#10;end' />
            </column>
            <column caption='Catalog Chain Name' datatype='string' name='[Catalog_Chain_Name]' role='dimension' type='nominal' />
            <column caption='Chain ID *' datatype='string' name='[Chain Name * (copy)_1034490962479202320]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [region]=&quot;Asia&quot; then IFNULL([Chain_ID],str([catalog_chain_id]))&#10;ELSEIF  [region]=&quot;MENA&quot; then [Chain_ID]&#10;ELSE [Chain_ID] END' />
            </column>
            <column caption='Chain or Vendor ID' datatype='string' name='[Chain or Vendor Name (copy)_1034490962477928463]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF     [Parameters].[Parameter 2] IN (&apos;Chain&apos;) THEN [Chain Name * (copy)_1034490962479202320]&#10;ELSEIF  [Parameters].[Parameter 2] IN (&apos;Vendor&apos;) THEN [vendor_id]&#10;END' />
            </column>
            <column caption='Chain ID' datatype='string' name='[Chain_ID]' role='dimension' type='nominal' />
            <column caption='Chain Name' datatype='string' name='[Chain_Name]' role='dimension' type='nominal' />
            <column caption='Is Outlier Filter' datatype='boolean' name='[Is Outlier? (copy)_4731242537230192644]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if  (abs([markup_vs_dmart])&gt;2 or ISNULL([markup_vs_dmart])) then true&#10;ELSE false &#10;end' />
            </column>
            <column caption='Local Shop Vendor Name' datatype='string' name='[Local_Shop_Vendor_Name]' role='dimension' type='nominal' />
            <column caption='Markup % (listed price)' datatype='real' name='[Markup % (copy)_1297670074872569856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if isnull([Calculation_382665296199548930]) = false then IFNULL(([Price_Local] - [Calculation_2211408171395112963])/[Calculation_2211408171395112963],0) &#10;&#10;END' />
            </column>
            <column caption='Chain or Vendor Name' datatype='string' name='[Perspective 1 (copy)_1034490962147917832]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF     [Parameters].[Parameter 2] IN (&apos;Chain&apos;) THEN [Vertical Type * (copy)_1034490962140557319]&#10;ELSEIF  [Parameters].[Parameter 2] IN (&apos;Vendor&apos;) THEN [Local_Shop_Vendor_Name]&#10;END' />
            </column>
            <column caption='Price Local' datatype='real' name='[Price_Local]' role='measure' type='quantitative' />
            <column caption='Product Name' datatype='string' name='[Product_Name]' role='dimension' type='nominal' />
            <column caption='Chain Name *' datatype='string' name='[Vertical Type * (copy)_1034490962140557319]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [region]=&quot;Asia&quot; then IFNULL([aaa_chain_name_cleaned],[Catalog_Chain_Name])&#10;ELSEIF  [region]=&quot;MENA&quot; then IFNULL([aaa_chain_name_cleaned],[Chain_Name])&#10;ELSE IFNULL([aaa_chain_name_cleaned],[Chain_Name]) END' />
            </column>
