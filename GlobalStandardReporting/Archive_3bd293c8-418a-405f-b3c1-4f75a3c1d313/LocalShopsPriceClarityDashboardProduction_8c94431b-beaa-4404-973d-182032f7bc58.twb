    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' lock-quick-filters='true' name='Price Details'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/LocalShopsPriceClarityDashboardProduction/PriceDetails?rev=' id='PriceDetails' path='/t/GlobalStandardReporting/workbooks/LocalShopsPriceClarityDashboardProduction' revision='' site='GlobalStandardReporting' />
      <style>
