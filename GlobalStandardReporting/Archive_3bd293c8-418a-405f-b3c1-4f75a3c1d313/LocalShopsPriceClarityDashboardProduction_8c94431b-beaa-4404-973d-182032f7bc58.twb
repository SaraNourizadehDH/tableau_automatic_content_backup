    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='[-- For Central team] Aggregated View: Average Markup %'>
      <style />
      <size maxheight='2000' maxwidth='1320' minheight='2000' minwidth='1320' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='lsba_vw_item_price (prod)' name='federated.0iy36780hye0iu1cc2x2v0w9qxjj (copy 2)' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Benchmark Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dmart Weighted Average of Sold Prices&quot;'>
          <calculation class='tableau' formula='&quot;Dmart Weighted Average of Sold Prices&quot;' />
          <members>
            <member value='&quot;[By Vertical] 25th Percentile of Listed Prices&quot;' />
            <member value='&quot;Dmart Weighted Average of Sold Prices&quot;' />
          </members>
        </column>
        <column caption='Perspective' datatype='string' name='[Parameter 2 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Global&quot;'>
          <calculation class='tableau' formula='&quot;Global&quot;' />
          <members>
            <member value='&quot;Global&quot;' />
            <member value='&quot;Region&quot;' />
            <member value='&quot;Country&quot;' />
            <member value='&quot;Vertical&quot;' />
            <member value='&quot;AAA Chain Name Cleaned&quot;' />
            <member value='&quot;Chain&quot;' />
            <member value='&quot;Vendor&quot;' />
            <member value='&quot;Country ▸ City&quot;' />
            <member value='&quot;Country ▸ Vertical&quot;' />
            <member value='&quot;Country ▸ Chain&quot;' />
            <member value='&quot;Vertical ▸ Country&quot;' />
            <member value='&quot;Chain ▸ Country&quot;' />
            <member value='&quot;PIM Level 1 ▸ Level 2&quot;' />
            <member value='&quot;Country ▸ Vertical ▸ Chain&quot;' />
            <member value='&quot;Vertical ▸ Country ▸ Chain&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0iy36780hye0iu1cc2x2v0w9qxjj (copy 2)'>
        <column caption='Below Benchmark Flag' datatype='boolean' name='[Calculation_382665296199548930]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;//when &quot;25th Percentile of Listed Prices&quot; then [below_25pct]&#10;//WHEN &quot;50th Percentile of Listed Prices&quot; then [below_50pct]&#10;//WHEN &quot;75th Percentile of Listed Prices&quot; then [below_75pct]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [below_25pct_vertical]&#10;//WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [below_50pct_vertical]&#10;//WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [below_75pct_vertical]&#10;//WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [below_wtd_avg]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [below_dm_wtd_avg]&#10;end' />
        </column>
        <column caption='Chain Name' datatype='string' name='[Chain_Name]' role='dimension' type='nominal' />
        <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
        <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column caption='Date Of Listed Price' datatype='date' name='[date_of_listed_price]' role='dimension' type='ordinal' />
        <column caption='Is Key Account' datatype='boolean' name='[is_key_account]' role='dimension' type='nominal' />
        <column caption='Item Role' datatype='string' name='[item_role]' role='dimension' type='nominal' />
        <column-instance column='[Calculation_382665296199548930]' derivation='None' name='[none:Calculation_382665296199548930:nk]' pivot='key' type='nominal' />
        <column-instance column='[Chain_Name]' derivation='None' name='[none:Chain_Name:nk]' pivot='key' type='nominal' />
        <column-instance column='[City]' derivation='None' name='[none:City:nk]' pivot='key' type='nominal' />
        <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[date_of_listed_price]' derivation='None' name='[none:date_of_listed_price:qk]' pivot='key' type='quantitative' />
        <column-instance column='[is_key_account]' derivation='None' name='[none:is_key_account:nk]' pivot='key' type='nominal' />
        <column-instance column='[item_role]' derivation='None' name='[none:item_role:nk]' pivot='key' type='nominal' />
      </datasource-dependencies>
