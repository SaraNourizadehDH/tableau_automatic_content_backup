      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='900' minheight='900' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='1175' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='1174' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone fixed-size='90' h='3300' id='95' mode='compact' param='[Parameters].[Parameter 2 1]' type-v2='paramctrl' w='7424' x='606' y='400'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
