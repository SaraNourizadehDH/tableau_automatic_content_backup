      <column caption='% Active SKU Below Benchmark' datatype='real' name='[Calculation_1553038196198420482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;//when &quot;25th Percentile of Listed Prices&quot; then [% Active SKU Below 25Pct]&#10;//WHEN &quot;50th Percentile of Listed Prices&quot; then [% Active SKU Below 50Pct]&#10;//WHEN &quot;75th Percentile of Listed Prices&quot; then [% Active SKU Below 75Pct]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [% Active SKU Below 25Pct (copy)_1297670075677745155]&#10;//WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [% Active SKU Below 50Pct by vertical]&#10;//WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [% Active SKU Below 75Pct by vertical]&#10;//WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [% Active SKU Below (Weighted Avg + 5% markup)]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [% Active SKU Below (Weighted Avg + 5% markup) (copy)_793829822748823552]&#10;end' />
      </column>
