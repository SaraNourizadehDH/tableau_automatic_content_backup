              </zone-style>
            </zone>
            <zone h='3300' id='158' mode='checkdropdown' name='Item Role: % SKUs below benchmark' param='[federated.0iy36780hye0iu1cc2x2v0w9qxjj (copy 2)].[none:City:nk]' show-apply='true' type-v2='filter' values='relevant' w='10833' x='77725' y='400'>
              <zone-style>
                <format attr='border-color' value='#000000' />
