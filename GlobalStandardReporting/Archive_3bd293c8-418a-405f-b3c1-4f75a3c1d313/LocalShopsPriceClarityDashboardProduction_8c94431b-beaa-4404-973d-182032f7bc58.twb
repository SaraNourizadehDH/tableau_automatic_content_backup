              <calculation class='tableau' formula='CASE [Parameters].[Rank By Absolute Amount (Vendor View): (copy)_2730659140976795648]&#10;//WHEN &apos;# Active SKU&apos;  THEN [# Total Active SKU*]&#10;WHEN &apos;# L2 Categories Listed&apos; then str([Calculation_458804232750358528])&#10;when &apos;% Active SKU Below Benchmark&apos; then str(round(round([Calculation_1553038196198420482],3)*100,1))+&quot;%&quot;&#10;when &apos;% Active SKU Above Benchmark&apos; then str(round(round([% Active SKU Below Benchmark (copy)_3059210798403952640],3)*100,1))+&quot;%&quot;&#10;//when &apos;Monthly Price Updates&apos; then [Monthly Price Update Count]&#10;//when &apos;Monthly Order Count&apos; then [Monthly Order Count]&#10;end' />
            </column>
            <column caption='Vendor Name - ID (v)' datatype='string' name='[Vendor Name - ID (copy)_1261781998428463110]' role='dimension' type='nominal'>
