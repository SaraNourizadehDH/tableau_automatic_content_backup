            <column caption='Mena Vertical' datatype='string' name='[mena_vertical]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_382665295505428480]' derivation='None' name='[none:Calculation_382665295505428480:nk]' pivot='key' type='nominal' />
