            <column caption='Total Count Items' datatype='integer' name='[total_count_items]' role='measure' type='quantitative' />
            <column-instance column='[% Active SKU Below Benchmark (copy)_3059210798403952640]' derivation='User' name='[usr:% Active SKU Below Benchmark (copy)_3059210798403952640:qk]' pivot='key' type='quantitative' />
            <column caption='Vertical Type' datatype='string' name='[vertical_type]' role='dimension' type='nominal' />
