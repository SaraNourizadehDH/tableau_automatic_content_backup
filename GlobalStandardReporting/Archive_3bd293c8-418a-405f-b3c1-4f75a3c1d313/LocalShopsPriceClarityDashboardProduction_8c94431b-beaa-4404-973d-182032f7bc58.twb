            <zone h='3300' id='156' mode='checkdropdown' name='Item Role: % SKUs below benchmark' param='[federated.0iy36780hye0iu1cc2x2v0w9qxjj (copy 2)].[none:mena_vertical:nk]' show-apply='true' type-v2='filter' w='10833' x='66892' y='400'>
              <zone-style>
                <format attr='border-color' value='#000000' />
