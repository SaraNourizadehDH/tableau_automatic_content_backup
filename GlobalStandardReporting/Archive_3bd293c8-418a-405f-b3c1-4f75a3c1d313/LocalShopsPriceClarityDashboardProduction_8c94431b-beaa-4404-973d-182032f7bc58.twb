          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Benchmark Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dmart Weighted Average of Sold Prices&quot;'>
              <calculation class='tableau' formula='&quot;Dmart Weighted Average of Sold Prices&quot;' />
            </column>
            <column caption='Perspective' datatype='string' name='[Parameter 2 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Global&quot;'>
              <calculation class='tableau' formula='&quot;Global&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.19o1vym0uhoegr17t4gxx089dc50 (copy 2)'>
            <column caption='# Total Active SKU*' datatype='integer' name='[# Active SKU Below Benchmark (copy)_1553038196279808011]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;//when &quot;25th Percentile of Listed Prices&quot; then [total]&#10;//WHEN &quot;50th Percentile of Listed Prices&quot; then [total]&#10;//WHEN &quot;75th Percentile of Listed Prices&quot; then [total]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [count_item_above_25pct_vertical]+[count_item_below_25pct_vertical]&#10;//WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [total]&#10;//WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [total]&#10;//WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then ([total] - [count_item_without_wtd_avg])&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then ([total_count_items] - [count_item_without_dm_wtd_avg])&#10;end' />
            </column>
            <column caption='# Active SKU Above Benchmark' datatype='integer' name='[# Active SKU Below Benchmark (copy)_2014516435463454720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;//when &quot;25th Percentile of Listed Prices&quot; then [count_item_above_25pct]&#10;//WHEN &quot;50th Percentile of Listed Prices&quot; then [count_item_above_50pct]&#10;//WHEN &quot;75th Percentile of Listed Prices&quot; then [count_item_above_75pct]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [count_item_above_25pct_vertical]&#10;//WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [count_item_above_50pct_vertical]&#10;//WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [count_item_above_75pct_vertical]&#10;//WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [count_item_above_wtd_avg_5pct]&#10;when &quot;Dmart Weighted Average of Sold Prices&quot; then [count_item_above_dm_wtd_avg]&#10;end' />
            </column>
            <column caption='% Active SKU Below (Dmart Weighted Avg)' datatype='real' name='[% Active SKU Below (Weighted Avg + 5% markup) (copy)_793829822748823552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_item_below_dm_wtd_avg])/sum([count_item_above_dm_wtd_avg]+[count_item_below_dm_wtd_avg])' />
            </column>
            <column caption='% Active SKU Below 25Pct by vertical' datatype='real' name='[% Active SKU Below 25Pct (copy)_1297670075677745155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_item_below_25pct_vertical])/sum([# Active SKU Below Benchmark (copy)_1553038196279808011])' />
            </column>
            <column caption='% Active SKU Above Benchmark' datatype='real' name='[% Active SKU Below Benchmark (copy)_3059210798403952640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;//when &quot;25th Percentile of Listed Prices&quot; then 1-[% Active SKU Below 25Pct]&#10;//WHEN &quot;50th Percentile of Listed Prices&quot; then 1-[% Active SKU Below 50Pct]&#10;//WHEN &quot;75th Percentile of Listed Prices&quot; then 1-[% Active SKU Below 75Pct]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then 1- [% Active SKU Below 25Pct (copy)_1297670075677745155]&#10;//WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then 1 - [% Active SKU Below 50Pct by vertical]&#10;//WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then 1 - [% Active SKU Below 75Pct by vertical]&#10;//WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then 1-[% Active SKU Below (Weighted Avg + 5% markup)]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then 1-[% Active SKU Below (Weighted Avg + 5% markup) (copy)_793829822748823552]&#10;end' />
            </column>
            <column caption='Chain Name *' datatype='string' name='[Calculation_1261781998051356673]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [region]&#10;when &quot;Asia&quot; then [Catalog_Chain_Name]&#10;when &quot;MENA&quot; then [Chain_Name]&#10;END' />
            </column>
            <column caption='Chain Name - ID *' datatype='string' name='[Calculation_1261781998425554948]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1261781998051356673]+&quot;-&quot;+[Chain_ID]' />
            </column>
            <column caption='% Active SKU Below Benchmark' datatype='real' name='[Calculation_1553038196198420482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;//when &quot;25th Percentile of Listed Prices&quot; then [% Active SKU Below 25Pct]&#10;//WHEN &quot;50th Percentile of Listed Prices&quot; then [% Active SKU Below 50Pct]&#10;//WHEN &quot;75th Percentile of Listed Prices&quot; then [% Active SKU Below 75Pct]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [% Active SKU Below 25Pct (copy)_1297670075677745155]&#10;//WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [% Active SKU Below 50Pct by vertical]&#10;//WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [% Active SKU Below 75Pct by vertical]&#10;//WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [% Active SKU Below (Weighted Avg + 5% markup)]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [% Active SKU Below (Weighted Avg + 5% markup) (copy)_793829822748823552]&#10;end' />
            </column>
            <column caption='Persp #1' datatype='string' name='[Calculation_1553038196263419910]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF     [Parameters].[Parameter 2 1] IN (&apos;Vertical&apos;,&#10;                         &apos;Vertical ▸ Country&apos;,&#10;                         &apos;Vertical ▸ Country ▸ Chain&apos;) &#10;THEN [Calculation_1977924693293023232]&#10;ELSEIF [Parameters].[Parameter 2 1] IN (&apos;Country&apos;,&#10;                         &apos;Country ▸ City&apos;, &apos;Country ▸ Chain&apos;,  &#10;                         &apos;Country ▸ Vertical&apos;,  &#10;                         &apos;Country ▸ Vertical ▸ Chain&apos;)  &#10;THEN [country_name]&#10;ELSEIF  [Parameters].[Parameter 2 1] = &apos;Region&apos; THEN [region]&#10;ELSEIF  [Parameters].[Parameter 2 1] = &apos;Global&apos; THEN &quot;Global&quot;&#10;ELSEIF  [Parameters].[Parameter 2 1] IN (&apos;Chain&apos;,&apos;Chain ▸ Country&apos;) THEN [Chain_Name]&#10;ELSEIF [Parameters].[Parameter 2 1] in (&apos;PIM Level 1 ▸ Level 2&apos;) then [pim_level_one_name]&#10;END' />
            </column>
            <column caption='Persp #2' datatype='string' name='[Calculation_1553038196265345033]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF     [Parameters].[Parameter 2 1] in (&apos;Vertical ▸ Country&apos; , &apos;Chain ▸ Country&apos; ,&#10;                         &apos;Vertical ▸ Country ▸ Chain&apos;)&#10;THEN [country_name]&#10;ELSEIF [Parameters].[Parameter 2 1] IN (&apos;Country ▸ Vertical&apos;,&apos;Country ▸ Vertical ▸ Chain&apos;&#10;                         )&#10;THEN [Calculation_1977924693293023232]&#10;ELSEIF [Parameters].[Parameter 2 1] IN ( &#10;                         &apos;Country ▸ City&apos;&#10;                         )&#10;THEN [City]&#10;ELSEIF [Parameters].[Parameter 2 1] IN ( &#10;                         &apos;Country ▸ Chain&apos;,&#10;                         &apos;Vertical ▸ Chain&apos;&#10;                         )&#10;THEN [Chain_Name]&#10;&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Country&apos; THEN [global_entity_id]&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Vertical&apos; THEN &apos;All&apos;&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Region&apos; THEN [management_entity]&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Global&apos; THEN [region]&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Chain&apos; THEN &apos;All&apos;&#10;ELSEIF [Parameters].[Parameter 2 1] in (&apos;PIM Level 1 ▸ Level 2&apos;) then [pim_level_two_name]&#10;END' />
            </column>
            <column caption='Vertical Type *' datatype='string' name='[Calculation_1977924693293023232]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [region]&#10;when &quot;MENA&quot; then [mena_vertical]&#10;when &quot;Asia&quot; then [vertical_type]&#10;END' />
            </column>
            <column caption='Catalog Chain Name' datatype='string' name='[Catalog_Chain_Name]' role='dimension' type='nominal' />
            <column caption='Chain ID' datatype='string' name='[Chain_ID]' role='dimension' type='nominal' />
            <column caption='Chain Name' datatype='string' name='[Chain_Name]' role='dimension' type='nominal' />
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Quarter' datatype='string' name='[Max Date Of Listed Price (copy)_458804234157781019]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(year([date_of_listed_price]))+&quot;-Q&quot;+str(QUARTER([date_of_listed_price]))' />
            </column>
            <column caption='Persp #3' datatype='string' name='[Persp #2 (copy)_1553038196289220620]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF     [Parameters].[Parameter 2 1] in (&#10;&apos;Vertical ▸ Country ▸ Chain&apos;,&#10;&apos;Country ▸ Vertical ▸ Chain&apos;&#10;                         )&#10;THEN [Chain_Name]&#10;ELSEIF [Parameters].[Parameter 2 1]=&quot;Global&quot; THEN [management_entity]&#10;ELSE &apos;All&apos;&#10;END' />
