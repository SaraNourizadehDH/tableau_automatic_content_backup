      <column caption='Country Customers' datatype='real' name='[Calculation_6367808450479525898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = 90&#10; THEN SUM({ FIXED [country_code], [region]:AVG([n_customers_l90d])})&#10;ELSEIF  [Parameters].[Parameter 1] = 30&#10;  THEN SUM({FIXED [country_code], [region]: AVG([n_customers_l30d])})&#10;ELSEIF [Parameters].[Parameter 1] = 7&#10;THEN SUM({FIXED [country_code], [region]: AVG([n_customers_l7d])})&#10;END' />
