    <worksheet name='N Under T'>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_sge_snapshot (rl_dmart)' name='federated.1xibkuf0zz5eix1a7hd1q0a6jdpl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Last N Days' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='7'>
              <calculation class='tableau' formula='7' />
            </column>
            <column caption='Delivery / Ride Time' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Ride Time&quot;'>
              <calculation class='tableau' formula='&quot;Ride Time&quot;' />
            </column>
            <column caption='Less than T' datatype='integer' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
              <range granularity='5' max='60' min='5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xibkuf0zz5eix1a7hd1q0a6jdpl'>
            <column caption='Bucket Ceiling' datatype='integer' name='[Calculation_6367808450529816591]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='INT(REGEXP_EXTRACT([Calculation_6367808450539139088], &apos;([0-9]+)[-+]&apos;))+5' />
            </column>
            <column caption='Correct Bucket' datatype='string' name='[Calculation_6367808450539139088]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Parameters].[Parameter 2] = &quot;Delivery Time&quot;&#10;  THEN IF [Parameters].[Parameter 1] = 90&#10;       THEN [qc_delivery_time_bucket_l90d]&#10;      ELSEIF [Parameters].[Parameter 1] = 30&#10;        THEN [qc_delivery_time_bucket_l30d]&#10;      ELSEIF [Parameters].[Parameter 1] = 7&#10;         THEN [qc_delivery_time_bucket_l7d]&#10;        END&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Ride Time&quot;&#10;  THEN IF [Parameters].[Parameter 1] = 90&#10;       THEN [qc_ride_time_bucket_l90d]&#10;      ELSEIF [Parameters].[Parameter 1] = 30&#10;        THEN [qc_ride_time_bucket_l30d]&#10;      ELSEIF [Parameters].[Parameter 1] = 7&#10;         THEN [qc_ride_time_bucket_l7d]&#10;    END&#10;END' />
