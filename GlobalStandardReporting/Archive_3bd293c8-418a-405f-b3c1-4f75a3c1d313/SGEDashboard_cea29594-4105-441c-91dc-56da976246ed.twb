      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/SGEDashboard/Glossary?rev=' id='Glossary' path='/t/GlobalStandardReporting/workbooks/SGEDashboard' revision='' site='GlobalStandardReporting' />
