    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Info, racks A-zone'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/StoreOpsABCAdoptionReporting-WIP/InforacksA-zone?rev=' id='InforacksA-zone' path='/t/GlobalStandardReporting/workbooks/StoreOpsABCAdoptionReporting-WIP' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_24' value='left' />
        </style-rule>
        <style-rule element='parameter-ctrl'>
          <format attr='background-color' value='#f5f5f5' />
          <format attr='border-style' value='solid' />
          <format attr='border-color' value='#000000' />
        </style-rule>
      </style>
      <size maxheight='800' maxwidth='1600' minheight='800' minwidth='1600' preset-index='1' sizing-mode='fixed' />
      <datasources>
        <datasource caption='abc_mixing_locations_rack_ranking (rl_dmart)' name='federated.060rcsb0e4dq6e16kutj51j2psmp' />
      </datasources>
      <datasource-dependencies datasource='federated.060rcsb0e4dq6e16kutj51j2psmp'>
        <column aggregation='Sum' caption='A-zone rack, manual' datatype='integer' name='[A_location_manual (copy)_1499417202944122889]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='[A_location_manual]' />
        </column>
        <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column-instance column='[A_location_manual (copy)_1499417202944122889]' derivation='None' name='[none:A_location_manual (copy)_1499417202944122889:ok]' pivot='key' type='ordinal' />
        <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
        <column-instance column='[storage_type]' derivation='None' name='[none:storage_type:nk]' pivot='key' type='nominal' />
        <column-instance column='[warehouse_name]' derivation='None' name='[none:warehouse_name:nk]' pivot='key' type='nominal' />
        <column caption='Storage Type' datatype='string' name='[storage_type]' role='dimension' type='nominal' />
        <column caption='Warehouse name' datatype='string' name='[warehouse_name]' role='dimension' type='nominal' />
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98000' id='30' param='horz' type-v2='layout-flow' w='99000' x='500' y='1000'>
            <zone fixed-size='1324' h='98000' id='28' is-fixed='true' type-v2='layout-basic' w='82750' x='500' y='1000'>
              <zone forceUpdate='true' h='8569' id='22' type-v2='text' w='76078' x='7172' y='1000'>
                <formatted-text>
                  <run bold='true' fontcolor='#e15759' fontsize='20'>Store Ops  | ABC Adoption Tracking </run>
                  <run bold='true' fontcolor='#c0c0c0' fontsize='15' italic='true'>Quick Commerce  </run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='8569' id='23' is-scaled='1' param='Image/Delivery-Hero-Comet.png' type-v2='bitmap' w='6672' x='500' y='1000'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='89431' id='564' name='Rack rank' w='61563' x='500' y='9569'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='68431' id='597' type-v2='text' w='21187' x='62063' y='9569'>
                <formatted-text>
                  <run bold='true' fontcolor='#172b4d' fontname='-apple-system' fontsize='10'>A - zone</run>
                  <run fontcolor='#172b4d' fontname='-apple-system' fontsize='10'> are racks, ranked within each storage type both ways: from biggest number to the smallest and vice-verca. </run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#172b4d' fontname='-apple-system' fontsize='10'>A-zone start - we suppose, that A-zone is places at the beginning of the picker`s route</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#172b4d' fontname='-apple-system' fontsize='10'>A-zone end - we suppose, that A-zone is places at the end of the picker`s route, wich is more advisable.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#172b4d' fontname='-apple-system' fontsize='10'>How we define how many racks we need - we chose such number of racks that stores 120% of skus of our lists (in each storage type)</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#172b4d' fontname='-apple-system' fontsize='10'>More about the development of this approach </run>
                  <run bold='true' fontcolor='#326ca6' fontname='-apple-system' fontsize='10' underline='true'>here</run>
                  <run bold='true' fontcolor='#172b4d' fontname='-apple-system' fontsize='10'>. </run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#172b4d' fontname='-apple-system' fontsize='10'>A-zone, manual - </run>
                  <run fontcolor='#172b4d' fontname='-apple-system' fontsize='10'>if the store have a non-standard planogram, that does not fit the definition above, local teams have ability to define the racks manually.</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#172b4d' fontname='-apple-system' fontsize='10'>A-skus share in manual racks</run>
                  <run fontcolor='#172b4d' fontname='-apple-system' fontsize='10'> - we devide number of A-skus that should be located in A-zone on the number of current total stock on manually proposed racks. If the value is low, than too many racks are included manually.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='21000' id='598' type-v2='empty' w='21187' x='62063' y='78000'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
