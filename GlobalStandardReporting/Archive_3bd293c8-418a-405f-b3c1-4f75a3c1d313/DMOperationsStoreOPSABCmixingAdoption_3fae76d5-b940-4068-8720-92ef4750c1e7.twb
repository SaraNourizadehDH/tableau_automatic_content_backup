        <column-instance column='[A_location_flag]' derivation='None' name='[none:A_location_flag:ok]' pivot='key' type='ordinal' />
        <column-instance column='[category_one]' derivation='None' name='[none:category_one:nk]' pivot='key' type='nominal' />
        <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
