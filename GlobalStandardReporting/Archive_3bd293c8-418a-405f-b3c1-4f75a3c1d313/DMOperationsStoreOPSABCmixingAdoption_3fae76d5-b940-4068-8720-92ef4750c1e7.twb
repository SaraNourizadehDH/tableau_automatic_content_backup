                <zone h='16000' id='582' mode='checkdropdown' name='Rack rank' param='[federated.060rcsb0e4dq6e16kutj51j2psmp].[none:storage_type:nk]' type-v2='filter' values='database' w='15625' x='83250' y='41875'>
