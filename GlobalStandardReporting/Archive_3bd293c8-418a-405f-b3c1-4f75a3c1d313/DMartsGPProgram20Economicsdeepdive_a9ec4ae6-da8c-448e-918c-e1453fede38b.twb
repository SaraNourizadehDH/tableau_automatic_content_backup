            </column>
            <column caption='Realized DF (% of ABV)' datatype='real' default-format='p0.00%' name='[Calculation_133700674173546521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[ABV (copy)_133700674172489750]/[Avg. Price per Item (copy)_133700674111868934]' />
            </column>
            <column caption='% Orders w/DF &gt; 0' datatype='real' default-format='p0.00%' name='[Calculation_133700674177273885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Vouchers (copy)_118289864404250633])/SUM([GBV Gross Of VAT (copy)_118289864391184386])' />
            </column>
            <column caption='Food - Realized DF' datatype='real' name='[Food - ABV (copy)_133700674172923927]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Food GBV (copy)_118289864445546513] )/SUM([Food GBV (copy)_118289864446406675])' />
            </column>
            <column caption='Food - Nominal DF' datatype='real' name='[Food - Realized DF (copy)_133700674174517275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Food GBV (copy)_118289864445546513])/SUM([Food Orders (copy)_118289864445939730])' />
            </column>
            <column caption='Food Delivery Fee' datatype='real' name='[Food GBV (copy)_118289864445546513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 3] = &apos;Incl. Pandapro&apos; then [food_delivery_fee] ELSE [food_delivery_fee_wout_pandapro] END' />
            </column>
            <column caption='Food OD Orders' datatype='integer' name='[Food GBV (copy)_118289864446406675]' role='measure' type='quantitative'>
