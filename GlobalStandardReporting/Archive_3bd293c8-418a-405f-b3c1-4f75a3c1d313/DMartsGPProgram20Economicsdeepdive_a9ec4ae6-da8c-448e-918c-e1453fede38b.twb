              <calculation class='tableau' formula='&quot;Incl. Pandapro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1kqu49p19gbt3b1d7org91ku68ok'>
            <column caption='Confirmed Voucher Orders' datatype='integer' name='[Calculation_123286048818544641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [Parameters].[Parameter 3] = &apos;Incl. Pandapro&apos; THEN [confirmed_vouchers_orders] ELSE [confirmed_vouchers_orders_wout_pandapro] END' />
