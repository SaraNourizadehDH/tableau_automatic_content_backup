            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1kqu49p19gbt3b1d7org91ku68ok'>
            <column caption='Avg. Items per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Price per Item (copy)_133700674111709189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Successful Orders (copy)_118289864391995395])/SUM([GBV Gross Of VAT (copy)_118289864391184386])' />
            </column>
            <column caption='ABV' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Avg. Price per Item (copy)_133700674111868934]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_118289864390574081])/SUM([GBV Gross Of VAT (copy)_118289864391184386])' />
            </column>
            <column caption='GBV Gross Of VAT' datatype='real' name='[Calculation_118289864390574081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 3] = &apos;Incl. Pandapro&apos; then [gbv_gross_of_vat] ELSE [gbv_gross_of_vat_wout_pandapro] END' />
            </column>
            <column caption='Food GBV' datatype='real' name='[Calculation_118289864444923919]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 3] = &apos;Incl. Pandapro&apos; then [food_gbv] ELSE [food_gbv_wout_pandapro] END' />
            </column>
            <column caption='Structure' datatype='string' name='[Calculation_133700674110947329]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;DH Group&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Region&quot; THEN [region]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country&quot; THEN [country_name]&#13;&#10;    WHEN &quot;Store&quot; THEN [Store]&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Store Current Age' datatype='integer' name='[Calculation_133700674115506184]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[warehouse_first_order_date],NOW())' />
            </column>
            <column aggregation='Sum' caption='Store Age in Reporting Month' datatype='integer' name='[Calculation_133700674115698697]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='MAX(DATEDIFF(&apos;month&apos;,[warehouse_first_order_date],[date_trunc_month]),0)' />
            </column>
            <column caption='Food - ABV' datatype='real' name='[Calculation_133700674121162764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_118289864444923919])/SUM([Food GBV (copy)_118289864445038608])' />
            </column>
            <column caption='ABV (% of Food)' datatype='real' default-format='p0.00%' name='[Calculation_133700674121281549]' role='measure' type='quantitative'>
