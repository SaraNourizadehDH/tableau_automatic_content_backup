        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared_dmart)' name='federated.1kqu49p19gbt3b1d7org91ku68ok' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Structure' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
            </column>
            <column caption='Pandapro Status' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Incl. Pandapro&quot;'>
              <calculation class='tableau' formula='&quot;Incl. Pandapro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1kqu49p19gbt3b1d7org91ku68ok'>
            <column caption='Avg. Active SKUs' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Avg. Listed SKUs (copy)_133700674166767635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([avg_skus_inventory_active_monthly])' />
            </column>
            <column caption='Avg. Items per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Price per Item (copy)_133700674111709189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Successful Orders (copy)_118289864391995395])/SUM([GBV Gross Of VAT (copy)_118289864391184386])' />
            </column>
            <column caption='MOV / Avg. Price per Item' datatype='real' name='[Calculation_1122803746517528578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([GBV Gross Of VAT (copy)_118289864394043396])/&#13;&#10;[Calculation_133700674111606788]' />
            </column>
            <column caption='GBV Gross Of VAT' datatype='real' name='[Calculation_118289864390574081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 3] = &apos;Incl. Pandapro&apos; then [gbv_gross_of_vat] ELSE [gbv_gross_of_vat_wout_pandapro] END' />
            </column>
            <column caption='Structure' datatype='string' name='[Calculation_133700674110947329]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;DH Group&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Region&quot; THEN [region]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country&quot; THEN [country_name]&#13;&#10;    WHEN &quot;Store&quot; THEN [Store]&#13;&#10;END' />
            </column>
            <column caption='Avg. Price per Item' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_133700674111606788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_118289864390574081])/SUM([Successful Orders (copy)_118289864391995395])' />
            </column>
            <column aggregation='Sum' caption='Store Current Age' datatype='integer' name='[Calculation_133700674115506184]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[warehouse_first_order_date],NOW())' />
            </column>
            <column aggregation='Sum' caption='Store Age in Reporting Month' datatype='integer' name='[Calculation_133700674115698697]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='MAX(DATEDIFF(&apos;month&apos;,[warehouse_first_order_date],[date_trunc_month]),0)' />
            </column>
            <column caption='Successful Orders' datatype='integer' name='[GBV Gross Of VAT (copy)_118289864391184386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 3] = &apos;Incl. Pandapro&apos; then [successful_orders] ELSE [successful_orders_wout_pandapro] END' />
            </column>
            <column caption='MOV Eur' datatype='real' name='[GBV Gross Of VAT (copy)_118289864394043396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 3] = &apos;Incl. Pandapro&apos; then [mov_eur] ELSE [mov_eur_wout_pandapro] END' />
            </column>
            <column datatype='string' name='[Store]' role='dimension' type='nominal' />
            <column caption='QTY Delivered' datatype='integer' name='[Successful Orders (copy)_118289864391995395]' role='measure' type='quantitative'>
