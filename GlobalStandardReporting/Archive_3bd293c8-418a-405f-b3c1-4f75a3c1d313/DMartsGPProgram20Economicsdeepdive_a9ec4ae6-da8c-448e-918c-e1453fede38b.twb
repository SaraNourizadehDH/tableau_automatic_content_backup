      <aliases enabled='yes' />
      <column caption='Realized DF (% of Food)' datatype='real' default-format='p0.00%' name='[ABV (% of Food) (copy)_133700674173112344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Food - ABV (copy)_133700674172923927] &gt; 0.1 THEN &#13;&#10;&#13;&#10;[ABV (copy)_133700674172489750]/[Food - ABV (copy)_133700674172923927]&#13;&#10;&#13;&#10;ELSE NULL END' />
      </column>
      <column caption='Realized DF' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[ABV (copy)_133700674172489750]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([GBV Gross Of VAT (copy)_118289864404529163])/SUM([GBV Gross Of VAT (copy)_118289864391184386])' />
      </column>
      <column caption='Avg. Active SKUs' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Avg. Listed SKUs (copy)_133700674166767635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([avg_skus_inventory_active_monthly])' />
      </column>
      <column caption='Avg. Items per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Price per Item (copy)_133700674111709189]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Successful Orders (copy)_118289864391995395])/SUM([GBV Gross Of VAT (copy)_118289864391184386])' />
      </column>
      <column caption='ABV' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Avg. Price per Item (copy)_133700674111868934]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_118289864390574081])/SUM([GBV Gross Of VAT (copy)_118289864391184386])' />
      </column>
      <column caption='Avg. Price per Item Excl. VAT' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Price per Item (copy)_479351888378777608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([GBV Gross Of VAT (copy)_118289864401551368])/SUM([Successful Orders (copy)_118289864391995395])' />
      </column>
      <column caption='Avg. Items per Voucher / Avg. Items p/o' datatype='real' name='[Calculation_1035546506264387584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1122803746483826688] / [Avg. Price per Item (copy)_133700674111709189]' />
      </column>
      <column caption='ABV as % of Food' datatype='real' default-format='p0.0%' name='[Calculation_1035546506267725825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Avg. Price per Item (copy)_133700674111868934]/(SUM([food_gbv])/SUM([food_od_orders]))' />
      </column>
      <column caption='Avg. Voucher Value / Avg. Price p/Item' datatype='real' name='[Calculation_1122803746483826688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([QTY Delivered (copy)_118289864399347719])/SUM([Vouchers (copy)_118289864406233101]))&#13;&#10;/&#13;&#10;(SUM([Calculation_118289864390574081])/SUM([QTY Delivered (copy)_118289864394678277]))' />
      </column>
      <column caption='Avg. Voucher Value / ABV' datatype='real' default-format='p0.00%' name='[Calculation_1122803746484387841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([vouchers])/SUM([voucher_orders]))&#13;&#10;/&#13;&#10;(SUM([gbv_gross_of_vat])/SUM([successful_orders]))' />
      </column>
      <column caption='MOV / Avg. Price per Item' datatype='real' name='[Calculation_1122803746517528578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([GBV Gross Of VAT (copy)_118289864394043396])/&#13;&#10;[Calculation_133700674111606788]' />
      </column>
      <column caption='Price per item' datatype='real' name='[Calculation_1122803746560196612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([gbv_gross_of_vat_orders_table])/SUM([qty_sold_orders_table])' />
      </column>
      <column caption='Fixed Total Orders' datatype='integer' name='[Calculation_118289864365715456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM([successful_orders])}' />
      </column>
      <column caption='GBV Gross Of VAT' datatype='real' name='[Calculation_118289864390574081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Parameters].[Parameter 3] = &apos;Incl. Pandapro&apos; then [gbv_gross_of_vat] ELSE [gbv_gross_of_vat_wout_pandapro] END' />
      </column>
      <column caption='Food GBV' datatype='real' name='[Calculation_118289864444923919]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Parameters].[Parameter 3] = &apos;Incl. Pandapro&apos; then [food_gbv] ELSE [food_gbv_wout_pandapro] END' />
      </column>
      <column caption='Confirmed Voucher Orders' datatype='integer' name='[Calculation_123286048818544641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [Parameters].[Parameter 3] = &apos;Incl. Pandapro&apos; THEN [confirmed_vouchers_orders] ELSE [confirmed_vouchers_orders_wout_pandapro] END' />
      </column>
      <column caption='Vouchers Gross VAT' datatype='real' name='[Calculation_123286048837251078]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [Parameters].[Parameter 3] = &apos;Incl. Pandapro&apos; THEN [vouchers_gross_vat] ELSE [vouchers_gross_vat_wout_pandapro] END' />
      </column>
      <column caption='Structure' datatype='string' name='[Calculation_133700674110947329]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;DH Group&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Region&quot; THEN [region]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country&quot; THEN [country_name]&#13;&#10;    WHEN &quot;Store&quot; THEN [Store]&#13;&#10;END' />
      </column>
      <column caption='Avg. Price per Item' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_133700674111606788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_118289864390574081])/SUM([Successful Orders (copy)_118289864391995395])' />
      </column>
      <column aggregation='Sum' caption='Store Current Age' datatype='integer' name='[Calculation_133700674115506184]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[warehouse_first_order_date],NOW())' />
      </column>
      <column aggregation='Sum' caption='Store Age in Reporting Month' datatype='integer' name='[Calculation_133700674115698697]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='MAX(DATEDIFF(&apos;month&apos;,[warehouse_first_order_date],[date_trunc_month]),0)' />
      </column>
      <column caption='Food - ABV' datatype='real' name='[Calculation_133700674121162764]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_118289864444923919])/SUM([Food GBV (copy)_118289864445038608])' />
      </column>
      <column caption='ABV (% of Food)' datatype='real' default-format='p0.00%' name='[Calculation_133700674121281549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Avg. Price per Item (copy)_133700674111868934]/[Calculation_133700674121162764]' />
      </column>
      <column caption='Expired+Damaged as % of GBV' datatype='real' default-format='p0.00%' name='[Calculation_133700674129317903]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-sum([stock_adjustment])/SUM([GBV Gross Of VAT (copy)_118289864401551368])' />
      </column>
      <column caption='Avg. Listed SKUs' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_133700674164994066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([avg_skus_listed_monthly])' />
      </column>
      <column caption='Realized DF (% of ABV)' datatype='real' default-format='p0.00%' name='[Calculation_133700674173546521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[ABV (copy)_133700674172489750]/[Avg. Price per Item (copy)_133700674111868934]' />
      </column>
      <column caption='% Orders w/DF &gt; 0' datatype='real' default-format='p0.00%' name='[Calculation_133700674177273885]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Vouchers (copy)_118289864404250633])/SUM([GBV Gross Of VAT (copy)_118289864391184386])' />
      </column>
      <column caption='mov_item' datatype='real' name='[Calculation_160229633444749313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([GBV Gross Of VAT (copy)_118289864394043396])/[Avg. Price per Item (copy)_133700674111709189]' />
      </column>
      <column caption='Rider_cost/avg_price_item' datatype='real' name='[Calculation_160229633445203970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([delivery_cpo] + [packaging_cpo])/[Avg. Price per Item (copy)_133700674111709189]' />
      </column>
      <column caption='Total Cost Without Shopper' datatype='real' name='[Calculation_479351888375918592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([packaging_cpo] + [shrinkage_cpo] + [delivery_cpo]) * SUM([successful_orders])' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_479351888377094147]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_479351888375918592] + SUM([vouchers])' />
      </column>
      <column caption='Vouchers Excl.VAT' datatype='real' name='[Calculation_479351888377839620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[QTY Delivered (copy)_118289864399347719]/ (1+ [vat_rate_gbv])' />
      </column>
      <column caption='Front Margin %' datatype='real' name='[Calculation_479351888379060233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gbv_net_of_vat] - [cogs]) / SUM([gbv_net_of_vat])' />
      </column>
      <column caption='No Items To Cover CPO Excl. Shopper' datatype='real' name='[Calculation_479351888380264459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([Calculation_479351888375918592] + SUM([Calculation_479351888377839620]) - SUM([Vouchers ext VAT (copy)_479351888378171397]))&#10;/ SUM([successful_orders]))&#10;/ ([Avg. Price per Item (copy)_479351888378777608] * ([Calculation_479351888379060233] + [Front Margin % (copy)_479351888379879434]))' />
      </column>
      <column caption='Vouchers (% of GBV+DF)' datatype='real' default-format='p0.00%' name='[Calculation_725642550296264704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([QTY Delivered (copy)_118289864399347719])/SUM([Calculation_118289864390574081]+[GBV Gross Of VAT (copy)_118289864404529163])' />
      </column>
      <column caption='Daily Orders per Store' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_725642550296616961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([DF Gross VAT  (copy)_118289864404844556])' />
      </column>
      <column caption='% Orders w/Vouchers' datatype='real' default-format='p0.00%' name='[Calculation_725642550296940546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([voucher_orders])/SUM([successful_orders])' />
      </column>
      <column caption='Avg. DMart Voucher Order Rank' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_725642550307139587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([customer_dmart_voucher_order_rank])/SUM([customer_dmart_voucher_order_rank_orders]) &lt;=100 THEN &#13;&#10;SUM([customer_dmart_voucher_order_rank])/SUM([customer_dmart_voucher_order_rank_orders])&#13;&#10;ELSE NULL END' />
      </column>
      <column caption='Shopper UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_725642550315196420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_orders])/SUM([worked_hours])' />
      </column>
      <column caption='% fdf food' datatype='real' name='[Calculation_779685746015637504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([food_orders]-[food_w_df_orders])/SUM([food_orders])' />
