            </column>
            <column caption='DF Gross VAT ' datatype='real' name='[GBV Gross Of VAT (copy)_118289864404529163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 3] = &apos;Incl. Pandapro&apos; then [df_gross_vat] ELSE [df_gross_vat_wout_pandapro] END' />
            </column>
            <column caption='Nominal DF (% of Food)' datatype='real' default-format='p0.00%' name='[Realized DF (% of Food) (copy)_133700674176737308]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Realized DF (copy)_133700674174369818]/[Food - Realized DF (copy)_133700674174517275]' />
