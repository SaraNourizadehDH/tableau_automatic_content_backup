    <worksheet name='Shopper Cost'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='12'>Status</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared_dmart)' name='federated.1kqu49p19gbt3b1d7org91ku68ok' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Structure' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
            </column>
            <column caption='Pandapro Status' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Incl. Pandapro&quot;'>
              <calculation class='tableau' formula='&quot;Incl. Pandapro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1kqu49p19gbt3b1d7org91ku68ok'>
            <column caption='Structure' datatype='string' name='[Calculation_133700674110947329]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;DH Group&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Region&quot; THEN [region]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country&quot; THEN [country_name]&#13;&#10;    WHEN &quot;Store&quot; THEN [Store]&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Store Current Age' datatype='integer' name='[Calculation_133700674115506184]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[warehouse_first_order_date],NOW())' />
            </column>
            <column aggregation='Sum' caption='Store Age in Reporting Month' datatype='integer' name='[Calculation_133700674115698697]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='MAX(DATEDIFF(&apos;month&apos;,[warehouse_first_order_date],[date_trunc_month]),0)' />
            </column>
            <column caption='Daily Orders per Store' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_725642550296616961]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([DF Gross VAT  (copy)_118289864404844556])' />
            </column>
            <column caption='Shopper UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_725642550315196420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders])/SUM([worked_hours])' />
            </column>
            <column caption='Daily Orders Per Store' datatype='real' name='[DF Gross VAT  (copy)_118289864404844556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 3] = &apos;Incl. Pandapro&apos; then [daily_orders_per_store] ELSE [daily_orders_per_store_wout_pandapro] END' />
            </column>
            <column datatype='string' name='[Store]' role='dimension' type='nominal' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Daily Orders Per Store W Pandapro' datatype='real' name='[daily_orders_per_store]' role='measure' type='quantitative' />
            <column caption='Daily Orders Per Store W/O Pandapro' datatype='real' name='[daily_orders_per_store_wout_pandapro]' role='measure' type='quantitative' />
            <column caption='Month' datatype='date' name='[date_trunc_month]' role='dimension' type='ordinal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_133700674110947329]' derivation='None' name='[none:Calculation_133700674110947329:nk]' pivot='key' type='nominal' />
