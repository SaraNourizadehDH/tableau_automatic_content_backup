    <worksheet name='MOV item vs total cost'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='12'>Avg Items Per Order vs Minimum Items To Cover CPO</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (curated_data_shared_dmart)' name='federated.1kqu49p19gbt3b1d7org91ku68ok' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Structure' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
            </column>
            <column caption='Pandapro Status' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Incl. Pandapro&quot;'>
              <calculation class='tableau' formula='&quot;Incl. Pandapro&quot;' />
            </column>
            <column caption='MOV Cost Type' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Only Rider Cost&quot;'>
              <calculation class='tableau' formula='&quot;Only Rider Cost&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1kqu49p19gbt3b1d7org91ku68ok'>
            <column caption='Avg. Active SKUs' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Avg. Listed SKUs (copy)_133700674166767635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([avg_skus_inventory_active_monthly])' />
            </column>
            <column caption='Avg. Items per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Price per Item (copy)_133700674111709189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Successful Orders (copy)_118289864391995395])/SUM([GBV Gross Of VAT (copy)_118289864391184386])' />
            </column>
            <column caption='Avg. Price per Item Excl. VAT' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg. Price per Item (copy)_479351888378777608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GBV Gross Of VAT (copy)_118289864401551368])/SUM([Successful Orders (copy)_118289864391995395])' />
            </column>
            <column caption='MOV / Avg. Price per Item' datatype='real' name='[Calculation_1122803746517528578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([GBV Gross Of VAT (copy)_118289864394043396])/&#13;&#10;[Calculation_133700674111606788]' />
            </column>
            <column caption='GBV Gross Of VAT' datatype='real' name='[Calculation_118289864390574081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 3] = &apos;Incl. Pandapro&apos; then [gbv_gross_of_vat] ELSE [gbv_gross_of_vat_wout_pandapro] END' />
            </column>
            <column caption='Structure' datatype='string' name='[Calculation_133700674110947329]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;DH Group&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Region&quot; THEN [region]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country&quot; THEN [country_name]&#13;&#10;    WHEN &quot;Store&quot; THEN [Store]&#13;&#10;END' />
            </column>
            <column caption='Avg. Price per Item' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_133700674111606788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_118289864390574081])/SUM([Successful Orders (copy)_118289864391995395])' />
            </column>
            <column aggregation='Sum' caption='Store Current Age' datatype='integer' name='[Calculation_133700674115506184]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[warehouse_first_order_date],NOW())' />
            </column>
            <column aggregation='Sum' caption='Store Age in Reporting Month' datatype='integer' name='[Calculation_133700674115698697]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='MAX(DATEDIFF(&apos;month&apos;,[warehouse_first_order_date],[date_trunc_month]),0)' />
            </column>
            <column caption='Total Cost Without Shopper' datatype='real' name='[Calculation_479351888375918592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([packaging_cpo] + [shrinkage_cpo] + [delivery_cpo]) * SUM([successful_orders])' />
            </column>
            <column caption='Vouchers Excl.VAT' datatype='real' name='[Calculation_479351888377839620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[QTY Delivered (copy)_118289864399347719]/ (1+ [vat_rate_gbv])' />
            </column>
            <column caption='Front Margin %' datatype='real' name='[Calculation_479351888379060233]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_net_of_vat] - [cogs]) / SUM([gbv_net_of_vat])' />
            </column>
            <column caption='No Items To Cover CPO Excl. Shopper' datatype='real' name='[Calculation_479351888380264459]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(([Calculation_479351888375918592] + SUM([Calculation_479351888377839620]) - SUM([Vouchers ext VAT (copy)_479351888378171397]))&#10;/ SUM([successful_orders]))&#10;/ ([Avg. Price per Item (copy)_479351888378777608] * ([Calculation_479351888379060233] + [Front Margin % (copy)_479351888379879434]))' />
            </column>
            <column caption='Back Margin %' datatype='real' name='[Front Margin % (copy)_479351888379879434]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([back_margin]) / SUM([retail_revenue])' />
            </column>
            <column caption='Successful Orders' datatype='integer' name='[GBV Gross Of VAT (copy)_118289864391184386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 3] = &apos;Incl. Pandapro&apos; then [successful_orders] ELSE [successful_orders_wout_pandapro] END' />
            </column>
            <column caption='MOV Eur' datatype='real' name='[GBV Gross Of VAT (copy)_118289864394043396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 3] = &apos;Incl. Pandapro&apos; then [mov_eur] ELSE [mov_eur_wout_pandapro] END' />
            </column>
            <column caption='GBV Net Of VAT' datatype='real' name='[GBV Gross Of VAT (copy)_118289864401551368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 3] = &apos;Incl. Pandapro&apos; then [gbv_net_of_vat] ELSE [gbv_net_of_vat_wout_pandapro] END' />
            </column>
            <column caption='DF Gross VAT ' datatype='real' name='[GBV Gross Of VAT (copy)_118289864404529163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 3] = &apos;Incl. Pandapro&apos; then [df_gross_vat] ELSE [df_gross_vat_wout_pandapro] END' />
            </column>
            <column caption='No Items To Cover CPO Incl. Shopper' datatype='real' name='[No Items To Cover CPO ext Shopper (copy)_809029455989903360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(([Total Cost Without Shopper (copy)_479351888376987650] + SUM([Calculation_479351888377839620]) - SUM([Vouchers ext VAT (copy)_479351888378171397]))&#10;/ SUM([GBV Gross Of VAT (copy)_118289864391184386]))&#10;/ ([Avg. Price per Item (copy)_479351888378777608] * ([Calculation_479351888379060233] + [Front Margin % (copy)_479351888379879434]))' />
            </column>
            <column caption='Vouchers' datatype='real' name='[QTY Delivered (copy)_118289864399347719]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 3] = &apos;Incl. Pandapro&apos; then [vouchers] ELSE [vouchers_without_pandapro] END' />
            </column>
            <column datatype='string' name='[Store]' role='dimension' type='nominal' />
            <column caption='QTY Delivered' datatype='integer' name='[Successful Orders (copy)_118289864391995395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 3] = &apos;Incl. Pandapro&apos; then [qty_delivered] ELSE [qty_delivered_wout_pandapro] END' />
            </column>
            <column caption='Total Cost With Shopper' datatype='real' name='[Total Cost Without Shopper (copy)_479351888376987650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([packaging_cpo] + [shrinkage_cpo] + [delivery_cpo] + [shopper_cpo]) * SUM([successful_orders])' />
            </column>
            <column caption='No Items To Cover CPO' datatype='real' name='[Voucher Orders (copy)_118289864463704086]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 4] = &apos;Only Rider Cost&apos; then [Calculation_479351888380264459] ELSE [No Items To Cover CPO ext Shopper (copy)_809029455989903360] END' />
            </column>
            <column caption='DF Excl. VAT' datatype='real' name='[Vouchers ext VAT (copy)_479351888378171397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[GBV Gross Of VAT (copy)_118289864404529163]/ (1+ [vat_rate_fees])' />
            </column>
