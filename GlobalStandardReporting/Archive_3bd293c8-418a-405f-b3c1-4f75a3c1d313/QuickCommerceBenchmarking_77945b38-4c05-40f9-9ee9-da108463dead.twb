      <column caption='% Acquisitions (o/Platform)' datatype='real' default-format='p0.00%' name='[% Active Adopters (o/Platform) (copy)_157063096522940431]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [type] = &quot;Food&quot; THEN NULL &#13;&#10;ELSEIF [type] = NULL THEN NULL &#13;&#10;ELSEIF [type] = &quot;Other&quot; THEN NULL &#13;&#10;ELSEIF [type] = &quot;Platform&quot; THEN NULL &#13;&#10;ELSE [customers_acquisitions]&#13;&#10;END)&#13;&#10;/SUM(&#13;&#10;IF [type] = &quot;Food&quot; THEN NULL &#13;&#10;ELSEIF [type] = NULL THEN NULL &#13;&#10;ELSEIF [type] = &quot;Other&quot; THEN NULL &#13;&#10;ELSEIF [type] = &quot;Platform&quot; THEN NULL &#13;&#10;ELSE [Total - Active Adopters (copy)_157063096523005968]&#13;&#10;END)' />
      </column>
      <column caption='% Active Adopters (o/Platform)' datatype='real' default-format='p0.00%' name='[% Orders (o/Platform) (copy)_157063096522727438]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([adopters])/SUM([Total - Confirmed Orders (copy)_157063096522493965])' />
      </column>
      <column caption='Structure' datatype='string' name='[Calculation_157063096514600962]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE  [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;DH Group&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Segment&quot; then [segment]&#13;&#10;    when &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country&quot; THEN [country_name]&#13;&#10;END' />
      </column>
      <column caption='Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_157063096516268037]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_failed])/SUM([orders_total])' />
      </column>
      <column caption='% Orders (o/Platform)' datatype='real' default-format='p0.00%' name='[Calculation_157063096520990732]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [type] = &quot;Food&quot; THEN NULL &#13;&#10;ELSEIF [type] = NULL THEN NULL &#13;&#10;ELSEIF [type] = &quot;Other&quot; THEN NULL &#13;&#10;ELSEIF [type] = &quot;Platform&quot; THEN NULL &#13;&#10;ELSE [orders_confirmed]&#13;&#10;END)&#13;&#10;/SUM(&#13;&#10;IF [type] = &quot;Food&quot; THEN NULL &#13;&#10;ELSEIF [type] = NULL THEN NULL &#13;&#10;ELSEIF [type] = &quot;Other&quot; THEN NULL &#13;&#10;ELSEIF [type] = &quot;Platform&quot; THEN NULL &#13;&#10;ELSE [Food - Adopters (copy)_157063096520744971]&#13;&#10;END)' />
      </column>
      <column caption='Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_157063096543240217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_confirmed])/SUM([customers_total])' />
      </column>
      <column caption='Reorder Rate 30d' datatype='real' default-format='p0.00%' name='[Calculation_157063096544235546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_customers_reorder])/SUM([total_customers_prev])' />
      </column>
      <column caption='Nominal DF' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Calculation_157063096544612379]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([df])/SUM([orders_w_df])' />
      </column>
      <column caption='% FDF' datatype='real' default-format='p0.00%' name='[Calculation_157063096544825372]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_w_fdf])/SUM([orders_confirmed])' />
      </column>
      <column caption='ABV' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Calculation_157063096545542174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gbv])/SUM([orders_confirmed])' />
      </column>
      <column caption='Total - Confirmed Orders' datatype='integer' name='[Food - Adopters (copy)_157063096520744971]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],[month]:&#13;&#10;SUM(IF  [type] = &quot;Platform&quot; THEN [orders_confirmed] END)}' />
      </column>
      <column caption='Food - Customers' datatype='integer' name='[Food - Orders (copy)_157063096524599316]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],[month]:&#13;&#10;SUM(IF [type] = &quot;Food&quot; THEN &#13;&#10;[customers_total]ELSE 0&#13;&#10;END)}' />
      </column>
      <column caption='Pre-Pre-Structure' datatype='string' name='[Pre-Structure (copy)_157063096515223556]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE  [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;DH Group&quot; THEN NULL&#13;&#10;    WHEN &quot;Segment&quot; then NULL&#13;&#10;    when &quot;Management Entity&quot; THEN &quot;DH Group&quot;&#13;&#10;    WHEN &quot;Country&quot; THEN [segment]&#13;&#10;END' />
      </column>
      <column caption='Pre-Structure' datatype='string' name='[Structure (copy)_157063096515092483]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE  [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;DH Group&quot; THEN NULL&#13;&#10;    WHEN &quot;Segment&quot; then &quot;DH Group&quot;&#13;&#10;    when &quot;Management Entity&quot; THEN [segment]&#13;&#10;    WHEN &quot;Country&quot; THEN [management_entity]&#13;&#10;END' />
      </column>
      <column caption='Total - Acquisitions' datatype='integer' name='[Total - Active Adopters (copy)_157063096523005968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],[month]:&#13;&#10;SUM([customers_acquisitions])}' />
      </column>
      <column caption='Total - Active Adopters' datatype='integer' name='[Total - Confirmed Orders (copy)_157063096522493965]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],[month]:&#13;&#10;SUM(IF [type (Custom SQL Query1)] = &quot;Platform&quot; THEN [adopters] END)}' />
      </column>
      <column caption='Food - Orders' datatype='integer' name='[Total - Confirmed Orders (copy)_157063096523788307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],[month]:&#13;&#10;SUM(IF [type] = &quot;Food&quot; THEN &#13;&#10;[orders_confirmed] ELSE 0&#13;&#10;END)}' />
      </column>
