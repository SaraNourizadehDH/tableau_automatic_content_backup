      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Query Adopters' id='_64EEE458B1264F3B898183884C5739A7'>
            <properties context=''>
              <relation connection='bigquery.0i0f34y1y5oah81csa8kz0ixrpc6' name='Custom SQL Query1' type='text'>WITH&#13;
  dates AS (&#13;
  SELECT&#13;
    DATE_TRUNC(DATE_ADD(DATE_ADD(CURRENT_DATE,INTERVAL -1 YEAR), INTERVAL -1 MONTH),MONTH) AS from_date,&#13;
    DATE_ADD(CURRENT_DATE,INTERVAL -1 DAY) AS thru_date),&#13;
    &#13;
  dates_customer AS (&#13;
  SELECT&#13;
    DATE(&apos;2019-01-01&apos;) AS from_date),&#13;
    &#13;
  vendors AS (&#13;
  SELECT DISTINCT&#13;
    global_entity_id,&#13;
    vendor_id,&#13;
    CASE WHEN LOWER(store_type) NOT IN (&apos;darkstores&apos;,&apos;deliver anything&apos;,&apos;restaurants&apos;) AND LOWER(vertical_type) NOT IN (&apos;bills_and_services&apos;,&apos;charity&apos;,&apos;caterers&apos;,&apos;courier&apos;,&apos;courier_business&apos;,&apos;darkstores&apos;,&apos;vouchers&apos;,&apos;restaurants&apos;,&apos;coffee&apos;,&apos;home_based_kitchen&apos;) THEN TRUE ELSE FALSE END AS is_ls_vendor,&#13;
    CASE WHEN vertical_parent = &apos;Dmarts&apos; THEN TRUE ELSE FALSE END AS is_ds_vendor&#13;
  &#13;
  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.vendors`&#13;
  &#13;
  WHERE&#13;
    (LOWER(store_type) NOT IN (&apos;darkstores&apos;,&apos;deliver anything&apos;,&apos;restaurants&apos;) AND LOWER(vertical_type) NOT IN (&apos;bills_and_services&apos;,&apos;charity&apos;,&apos;caterers&apos;,&apos;courier&apos;,&apos;courier_business&apos;,&apos;darkstores&apos;,&apos;vouchers&apos;,&apos;restaurants&apos;,&apos;coffee&apos;,&apos;home_based_kitchen&apos;))&#13;
    OR vertical_parent = &apos;Dmarts&apos;),&#13;
&#13;
  platform AS (  &#13;
  WITH platform_rank AS (&#13;
  SELECT&#13;
    global_entity_id,&#13;
    analytical_customer_id,&#13;
    order_id,&#13;
    placed_at_local,&#13;
    DATE(DATE_TRUNC(placed_at_local,MONTH)) AS month,&#13;
    ROW_NUMBER() OVER (PARTITION BY global_entity_id,analytical_customer_id ORDER BY placed_at_local,order_id) as customer_order_rank_platform&#13;
&#13;
  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o&#13;
&#13;
  WHERE&#13;
    is_sent&#13;
    AND analytical_customer_id IS NOT NULL&#13;
    AND DATE(placed_at_local) BETWEEN (SELECT from_date FROM dates_customer) AND (SELECT thru_date FROM dates))&#13;
    &#13;
  SELECT&#13;
    global_entity_id,&#13;
    month,&#13;
    COUNT(DISTINCT CASE WHEN customer_order_rank_platform &gt;&gt;= 3 THEN analytical_customer_id END) AS platform_adopters&#13;
  &#13;
  FROM platform_rank&#13;
  &#13;
  GROUP BY 1,2),&#13;
    &#13;
  ls AS (&#13;
  WITH ls_rank AS (&#13;
  SELECT&#13;
    v.global_entity_id,&#13;
    analytical_customer_id,&#13;
    order_id,&#13;
    placed_at_local,&#13;
    DATE(DATE_TRUNC(placed_at_local,MONTH)) AS month,&#13;
    ROW_NUMBER() OVER (PARTITION BY v.global_entity_id,analytical_customer_id ORDER BY placed_at_local,order_id) as customer_order_rank_ls&#13;
&#13;
  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o&#13;
&#13;
  INNER JOIN vendors v ON v.global_entity_id = o.global_entity_id AND v.vendor_id = o.vendor_id&#13;
&#13;
  WHERE&#13;
    is_sent&#13;
    AND analytical_customer_id IS NOT NULL&#13;
    AND is_ls_vendor&#13;
    AND DATE(placed_at_local) BETWEEN (SELECT from_date FROM dates_customer) AND (SELECT thru_date FROM dates))&#13;
    &#13;
  SELECT&#13;
    global_entity_id,&#13;
    month,&#13;
    COUNT(DISTINCT CASE WHEN customer_order_rank_ls &gt;&gt;= 3 THEN analytical_customer_id END) AS ls_adopters&#13;
  &#13;
  FROM ls_rank&#13;
  &#13;
  GROUP BY 1,2),&#13;
  &#13;
  ds AS (&#13;
  WITH ds_rank AS (&#13;
  SELECT&#13;
    v.global_entity_id,&#13;
    analytical_customer_id,&#13;
    order_id,&#13;
    placed_at_local,&#13;
    DATE(DATE_TRUNC(placed_at_local,MONTH)) AS month,&#13;
    ROW_NUMBER() OVER (PARTITION BY v.global_entity_id,analytical_customer_id ORDER BY placed_at_local,order_id) as customer_order_rank_ds&#13;
&#13;
  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o&#13;
&#13;
  INNER JOIN vendors v ON v.global_entity_id = o.global_entity_id AND v.vendor_id = o.vendor_id&#13;
&#13;
  WHERE&#13;
    is_sent&#13;
    AND analytical_customer_id IS NOT NULL&#13;
    AND is_ds_vendor&#13;
    AND DATE(placed_at_local) BETWEEN (SELECT from_date FROM dates_customer) AND (SELECT thru_date FROM dates))&#13;
    &#13;
  SELECT&#13;
    global_entity_id,&#13;
    month,&#13;
    COUNT(DISTINCT CASE WHEN customer_order_rank_ds &gt;&gt;= 3 THEN analytical_customer_id END) AS ds_adopters&#13;
  &#13;
  FROM ds_rank&#13;
  &#13;
  GROUP BY 1,2),&#13;
  &#13;
 types AS (&#13;
 SELECT&#13;
  &apos;Local Shops&apos; AS type&#13;
  UNION ALL SELECT &apos;DMarts&apos;&#13;
  UNION ALL SELECT &apos;Platform&apos;)&#13;
    &#13;
SELECT&#13;
global_entity_id,&#13;
month,&#13;
type,&#13;
CASE&#13;
  WHEN type = &apos;Platform&apos; THEN platform_adopters&#13;
  WHEN type = &apos;Local Shops&apos; THEN ls_adopters&#13;
  WHEN type = &apos;DMarts&apos; THEN ds_adopters&#13;
END AS adopters&#13;
&#13;
FROM platform p&#13;
LEFT JOIN ls USING (global_entity_id,month)&#13;
LEFT JOIN ds USING (global_entity_id,month)&#13;
CROSS JOIN types&#13;
&#13;
WHERE month BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates)</relation>
            </properties>
            <properties context='extract'>
              <relation name='_64EEE458B1264F3B898183884C5739A7' table='[Extract].[_64EEE458B1264F3B898183884C5739A7]' type='table' />
            </properties>
          </object>
          <object caption='Query Sales' id='_81616A43ABD64D3CB1272E0337A2FE41'>
            <properties context=''>
              <relation connection='bigquery.0i0f34y1y5oah81csa8kz0ixrpc6' name='Custom SQL Query' type='text'><![CDATA[WITH
  dates AS (
  SELECT
    DATE_TRUNC(DATE_ADD(DATE_ADD(CURRENT_DATE,INTERVAL -1 YEAR), INTERVAL -1 MONTH),MONTH) AS from_date,
    DATE_ADD(CURRENT_DATE,INTERVAL -1 DAY) AS thru_date),
  
  qc_entities AS (
    SELECT DISTINCT
        global_entity_id
        
    FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.vendors`
    
    WHERE is_qcommerce),

  ls_vendors AS (
    SELECT DISTINCT
      global_entity_id,
      vendor_id,
      TRUE AS is_ls_vendor,
    FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.vendors`

    WHERE LOWER(store_type) NOT IN ('darkstores','deliver anything','restaurants') AND LOWER(vertical_type) NOT IN ('bills_and_services','charity','caterers','courier','courier_business','darkstores','vouchers','restaurants','coffee','home_based_kitchen')),
    
  ds_vendors AS (
    SELECT DISTINCT
      global_entity_id,
      vendor_id,
      TRUE AS is_ds_vendor,
    FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.vendors`
    
    WHERE vertical_parent = 'Dmarts'),
    
  quantity AS (
   SELECT
     global_entity_id,
     order_id,
     SUM(items.quantity) AS quantity,

   FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.orders`,
   UNNEST(items) AS items

   WHERE DATE(placed_at_local) BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates)

   GROUP BY 1,2),

  sales_verticals AS (SELECT
  DISTINCT
  segment,
  management_entity,
  country_name,
  o.global_entity_id,
  CASE
    WHEN is_ls_vendor THEN 'Local Shops'
    WHEN is_ds_vendor THEN 'DMarts'
    WHEN is_ls_vendor IS NOT TRUE AND is_ds_vendor IS NOT TRUE AND is_qcommerce = FALSE THEN 'Food'
    WHEN is_ls_vendor IS NOT TRUE AND is_ds_vendor IS NOT TRUE AND is_qcommerce = TRUE THEN 'Other'
  END AS type,
  DATE(DATE_TRUNC(placed_at_local,MONTH)) AS month,
  COUNT(DISTINCT o.order_id) AS orders_total,
  COUNT(DISTINCT CASE WHEN is_sent THEN o.order_id END) AS orders_confirmed,
  COUNT(DISTINCT CASE WHEN is_sent AND value.delivery_fee_eur >> 0 THEN o.order_id END) AS orders_w_df,
  COUNT(DISTINCT CASE WHEN is_sent AND value.delivery_fee_eur = 0 THEN o.order_id END) AS orders_w_fdf,
  COUNT(DISTINCT CASE WHEN is_sent = FALSE THEN o.order_id END) AS orders_failed,
  SUM(CASE WHEN is_sent THEN value.gbv_eur END) AS gbv,
  SUM(CASE WHEN is_sent THEN value.delivery_fee_eur END) AS df,
  SUM(CASE WHEN is_sent THEN quantity END) AS qty,
  COUNT(DISTINCT CASE WHEN is_sent AND is_acquisition THEN analytical_customer_id END) AS customers_acquisitions,
  COUNT(DISTINCT CASE WHEN is_sent THEN analytical_customer_id END) AS customers_total

  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o

  INNER JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` e USING (global_entity_id)
  INNER JOIN quantity q ON q.order_id = o.order_id AND q.global_entity_id = o.global_entity_id
  INNER JOIN qc_entities qe ON q.global_entity_id = qe.global_entity_id
  LEFT JOIN ls_vendors l ON l.global_entity_id = o.global_entity_id AND l.vendor_id = o.vendor_id
  LEFT JOIN ds_vendors d ON d.global_entity_id = o.global_entity_id AND d.vendor_id = o.vendor_id

  WHERE
    date(placed_at_local) BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates)
    AND management_entity <<>> "Instashop"

  GROUP BY 1,2,3,4,5,6),
  
  sales_platform AS (SELECT
  DISTINCT
  segment,
  management_entity,
  country_name,
  o.global_entity_id,
  "Platform" AS type,
  DATE(DATE_TRUNC(placed_at_local,MONTH)) AS month,
  COUNT(DISTINCT o.order_id) AS orders_total,
  COUNT(DISTINCT CASE WHEN is_sent THEN o.order_id END) AS orders_confirmed,
  COUNT(DISTINCT CASE WHEN is_sent AND value.delivery_fee_eur >> 0 THEN o.order_id END) AS orders_w_df,
  COUNT(DISTINCT CASE WHEN is_sent AND value.delivery_fee_eur = 0 THEN o.order_id END) AS orders_w_fdf,
  COUNT(DISTINCT CASE WHEN is_sent = FALSE THEN o.order_id END) AS orders_failed,
  SUM(CASE WHEN is_sent THEN value.gbv_eur END) AS gbv,
  SUM(CASE WHEN is_sent THEN value.delivery_fee_eur END) AS df,
  SUM(CASE WHEN is_sent THEN quantity END) AS qty,
  COUNT(DISTINCT CASE WHEN is_sent AND is_acquisition THEN analytical_customer_id END) AS customers_acquisitions,
  COUNT(DISTINCT CASE WHEN is_sent THEN analytical_customer_id END) AS customers_total

  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o

  INNER JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` e USING (global_entity_id)
  INNER JOIN quantity q ON q.order_id = o.order_id AND q.global_entity_id = o.global_entity_id
  INNER JOIN qc_entities qe ON q.global_entity_id = qe.global_entity_id
  LEFT JOIN ls_vendors l ON l.global_entity_id = o.global_entity_id AND l.vendor_id = o.vendor_id
  LEFT JOIN ds_vendors d ON d.global_entity_id = o.global_entity_id AND d.vendor_id = o.vendor_id

  WHERE
    date(placed_at_local) BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates)
    AND management_entity <<>> "Instashop"

  GROUP BY 1,2,3,4,5,6)
  
SELECT
  *
FROM
sales_verticals
UNION ALL
(SELECT * FROM sales_platform)]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_81616A43ABD64D3CB1272E0337A2FE41' table='[Extract].[_81616A43ABD64D3CB1272E0337A2FE41]' type='table' />
            </properties>
          </object>
          <object caption='Query Reorder 30d' id='_8B10FFD5C78C4F26A5E362E2C0122850'>
            <properties context=''>
              <relation connection='bigquery.0i0f34y1y5oah81csa8kz0ixrpc6' name='Custom SQL Query2' type='text'><![CDATA[WITH
  dates AS (
  SELECT
    DATE_TRUNC(DATE_ADD(DATE_ADD(CURRENT_DATE,INTERVAL -1 YEAR), INTERVAL -2 MONTH),MONTH) AS from_date,
    DATE_ADD(CURRENT_DATE,INTERVAL -1 DAY) AS thru_date),
    
  vendors AS (
  SELECT DISTINCT
    global_entity_id,
    vendor_id,
    CASE WHEN LOWER(store_type) NOT IN ('darkstores','deliver anything','restaurants') AND LOWER(vertical_type) NOT IN ('bills_and_services','charity','caterers','courier','courier_business','darkstores','vouchers','restaurants','coffee','home_based_kitchen') THEN TRUE ELSE FALSE END AS is_ls_vendor,
    CASE WHEN vertical_parent = 'Dmarts' THEN TRUE ELSE FALSE END AS is_ds_vendor,
    CASE WHEN vertical_parent = 'Food' THEN TRUE ELSE FALSE END AS is_food_vendor
  
  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.vendors`
  
  WHERE
    (LOWER(store_type) NOT IN ('darkstores','deliver anything','restaurants') AND LOWER(vertical_type) NOT IN ('bills_and_services','charity','caterers','courier','courier_business','darkstores','vouchers','restaurants','coffee','home_based_kitchen'))
    OR vertical_parent = 'Dmarts'
    OR vertical_parent = 'Food'),

  retention_food AS (
  
  WITH time_diff AS ( 
  
  WITH visit_log AS (

    SELECT
       DISTINCT
       o.global_entity_id,
       analytical_customer_id,
       DATE_TRUNC(DATE(placed_at_local),DAY) as day,
       DATE_DIFF(DATE(placed_at_local),"2018-01-01",DAY) AS visit_day

  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o

  INNER JOIN vendors v ON v.global_entity_id = o.global_entity_id AND v.vendor_id = o.vendor_id

  WHERE
    is_sent
    AND analytical_customer_id IS NOT NULL
    AND is_food_vendor
    AND DATE(placed_at_local) BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates)

  GROUP BY 1,2,3,4
  ORDER BY 1,2,3)
   
    SELECT 
      global_entity_id,
      analytical_customer_id,
      day,
      visit_day,
      lead(visit_day, 1) OVER (PARTITION BY global_entity_id,analytical_customer_id ORDER BY global_entity_id, analytical_customer_id, visit_day) AS lead,
      lead(visit_day, 1) OVER (PARTITION BY global_entity_id,analytical_customer_id ORDER BY global_entity_id, analytical_customer_id, visit_day) - visit_day AS time_diff

    FROM visit_log
    
    ORDER BY 1,2,3)
    
  SELECT
    global_entity_id,
    DATE_TRUNC(day,MONTH) AS month,
    DATE_ADD(DATE_TRUNC(day,MONTH), INTERVAL 1 MONTH) AS next_month,
    COUNT(DISTINCT analytical_customer_id) total_customers_prev_month_food,
    COUNT(DISTINCT CASE WHEN time_diff.time_diff <<=30 THEN analytical_customer_id END) total_customers_reorder_30d_food

  FROM time_diff

  GROUP BY 1,2,3

  ORDER BY 1,2,3),
  
  retention_ls AS (
  
  WITH time_diff AS ( 
  
  WITH visit_log AS (

    SELECT
       DISTINCT
       o.global_entity_id,
       analytical_customer_id,
       DATE_TRUNC(DATE(placed_at_local),DAY) as day,
       DATE_DIFF(DATE(placed_at_local),"2018-01-01",DAY) AS visit_day

  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o

  INNER JOIN vendors v ON v.global_entity_id = o.global_entity_id AND v.vendor_id = o.vendor_id

  WHERE
    is_sent
    AND analytical_customer_id IS NOT NULL
    AND is_ls_vendor
    AND DATE(placed_at_local) BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates)

  GROUP BY 1,2,3,4
  ORDER BY 1,2,3)
   
    SELECT 
      global_entity_id,
      analytical_customer_id,
      day,
      visit_day,
      lead(visit_day, 1) OVER (PARTITION BY global_entity_id,analytical_customer_id ORDER BY global_entity_id, analytical_customer_id, visit_day) AS lead,
      lead(visit_day, 1) OVER (PARTITION BY global_entity_id,analytical_customer_id ORDER BY global_entity_id, analytical_customer_id, visit_day) - visit_day AS time_diff

    FROM visit_log
    
    ORDER BY 1,2,3)
    
  SELECT
    global_entity_id,
    DATE_TRUNC(day,MONTH) AS month,
    DATE_ADD(DATE_TRUNC(day,MONTH), INTERVAL 1 MONTH) AS next_month,
    COUNT(DISTINCT analytical_customer_id) total_customers_prev_month_ls,
    COUNT(DISTINCT CASE WHEN time_diff.time_diff <<=30 THEN analytical_customer_id END) total_customers_reorder_30d_ls

  FROM time_diff

  GROUP BY 1,2,3

  ORDER BY 1,2,3),
  
  retention_ds AS (
  
  WITH time_diff AS ( 
  
  WITH visit_log AS (

    SELECT
       DISTINCT
       o.global_entity_id,
       analytical_customer_id,
       DATE_TRUNC(DATE(placed_at_local),DAY) as day,
       DATE_DIFF(DATE(placed_at_local),"2018-01-01",DAY) AS visit_day

  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o

  INNER JOIN vendors v ON v.global_entity_id = o.global_entity_id AND v.vendor_id = o.vendor_id

  WHERE
    is_sent
    AND analytical_customer_id IS NOT NULL
    AND is_ds_vendor
    AND DATE(placed_at_local) BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates)

  GROUP BY 1,2,3,4
  ORDER BY 1,2,3)
   
    SELECT 
      global_entity_id,
      analytical_customer_id,
      day,
      visit_day,
      lead(visit_day, 1) OVER (PARTITION BY global_entity_id,analytical_customer_id ORDER BY global_entity_id, analytical_customer_id, visit_day) AS lead,
      lead(visit_day, 1) OVER (PARTITION BY global_entity_id,analytical_customer_id ORDER BY global_entity_id, analytical_customer_id, visit_day) - visit_day AS time_diff

    FROM visit_log
    
    ORDER BY 1,2,3)
    
  SELECT
    global_entity_id,
    DATE_TRUNC(day,MONTH) AS month,
    DATE_ADD(DATE_TRUNC(day,MONTH), INTERVAL 1 MONTH) AS next_month,
    COUNT(DISTINCT analytical_customer_id) total_customers_prev_month_ds,
    COUNT(DISTINCT CASE WHEN time_diff.time_diff <<=30 THEN analytical_customer_id END) total_customers_reorder_30d_ds

  FROM time_diff

  GROUP BY 1,2,3

  ORDER BY 1,2,3),
  
  types AS (
   SELECT
    'Local Shops' AS type
    UNION ALL SELECT 'DMarts'
    UNION ALL SELECT 'Food')
    
SELECT
global_entity_id,
month,
next_month,
type,
CASE
  WHEN type = 'Food' THEN total_customers_prev_month_food
  WHEN type = 'Local Shops' THEN total_customers_prev_month_ls
  WHEN type = 'DMarts' THEN total_customers_prev_month_ds
END AS total_customers_prev,
CASE
  WHEN type = 'Food' THEN total_customers_reorder_30d_food
  WHEN type = 'Local Shops' THEN total_customers_reorder_30d_ls
  WHEN type = 'DMarts' THEN total_customers_reorder_30d_ds
END AS total_customers_reorder

FROM retention_food f
LEFT JOIN retention_ls USING (global_entity_id,month,next_month)
LEFT JOIN retention_ds USING (global_entity_id,month,next_month)
CROSS JOIN types

WHERE month BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates)]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='_8B10FFD5C78C4F26A5E362E2C0122850' table='[Extract].[_8B10FFD5C78C4F26A5E362E2C0122850]' type='table' />
            </properties>
          </object>
        </objects>
        <relationships>
          <relationship>
            <expression op='AND'>
