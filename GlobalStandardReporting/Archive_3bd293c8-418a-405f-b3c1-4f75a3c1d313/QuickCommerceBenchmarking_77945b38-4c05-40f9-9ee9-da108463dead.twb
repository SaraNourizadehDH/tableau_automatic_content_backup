          <relation connection='bigquery.0i0f34y1y5oah81csa8kz0ixrpc6' name='Custom SQL Query2' type='text'><![CDATA[WITH
  dates AS (
  SELECT
    DATE_TRUNC(DATE_ADD(DATE_ADD(CURRENT_DATE,INTERVAL -1 YEAR), INTERVAL -2 MONTH),MONTH) AS from_date,
    DATE_ADD(CURRENT_DATE,INTERVAL -1 DAY) AS thru_date),
    
  vendors AS (
  SELECT DISTINCT
    global_entity_id,
    vendor_id,
    CASE WHEN LOWER(store_type) NOT IN ('darkstores','deliver anything','restaurants') AND LOWER(vertical_type) NOT IN ('bills_and_services','charity','caterers','courier','courier_business','darkstores','vouchers','restaurants','coffee','home_based_kitchen') THEN TRUE ELSE FALSE END AS is_ls_vendor,
    CASE WHEN vertical_parent = 'Dmarts' THEN TRUE ELSE FALSE END AS is_ds_vendor,
    CASE WHEN vertical_parent = 'Food' THEN TRUE ELSE FALSE END AS is_food_vendor
  
  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.vendors`
  
  WHERE
    (LOWER(store_type) NOT IN ('darkstores','deliver anything','restaurants') AND LOWER(vertical_type) NOT IN ('bills_and_services','charity','caterers','courier','courier_business','darkstores','vouchers','restaurants','coffee','home_based_kitchen'))
    OR vertical_parent = 'Dmarts'
    OR vertical_parent = 'Food'),

  retention_food AS (
  
  WITH time_diff AS ( 
  
  WITH visit_log AS (

    SELECT
       DISTINCT
       o.global_entity_id,
       analytical_customer_id,
       DATE_TRUNC(DATE(placed_at_local),DAY) as day,
       DATE_DIFF(DATE(placed_at_local),"2018-01-01",DAY) AS visit_day

  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o

  INNER JOIN vendors v ON v.global_entity_id = o.global_entity_id AND v.vendor_id = o.vendor_id

  WHERE
    is_sent
    AND analytical_customer_id IS NOT NULL
    AND is_food_vendor
    AND DATE(placed_at_local) BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates)

  GROUP BY 1,2,3,4
  ORDER BY 1,2,3)
   
    SELECT 
      global_entity_id,
      analytical_customer_id,
      day,
      visit_day,
      lead(visit_day, 1) OVER (PARTITION BY global_entity_id,analytical_customer_id ORDER BY global_entity_id, analytical_customer_id, visit_day) AS lead,
      lead(visit_day, 1) OVER (PARTITION BY global_entity_id,analytical_customer_id ORDER BY global_entity_id, analytical_customer_id, visit_day) - visit_day AS time_diff

    FROM visit_log
    
    ORDER BY 1,2,3)
    
  SELECT
    global_entity_id,
    DATE_TRUNC(day,MONTH) AS month,
    DATE_ADD(DATE_TRUNC(day,MONTH), INTERVAL 1 MONTH) AS next_month,
    COUNT(DISTINCT analytical_customer_id) total_customers_prev_month_food,
    COUNT(DISTINCT CASE WHEN time_diff.time_diff <<=30 THEN analytical_customer_id END) total_customers_reorder_30d_food

  FROM time_diff

  GROUP BY 1,2,3

  ORDER BY 1,2,3),
  
  retention_ls AS (
  
  WITH time_diff AS ( 
  
  WITH visit_log AS (

    SELECT
       DISTINCT
       o.global_entity_id,
       analytical_customer_id,
       DATE_TRUNC(DATE(placed_at_local),DAY) as day,
       DATE_DIFF(DATE(placed_at_local),"2018-01-01",DAY) AS visit_day

  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o

  INNER JOIN vendors v ON v.global_entity_id = o.global_entity_id AND v.vendor_id = o.vendor_id

  WHERE
    is_sent
    AND analytical_customer_id IS NOT NULL
    AND is_ls_vendor
    AND DATE(placed_at_local) BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates)

  GROUP BY 1,2,3,4
  ORDER BY 1,2,3)
   
    SELECT 
      global_entity_id,
      analytical_customer_id,
      day,
      visit_day,
      lead(visit_day, 1) OVER (PARTITION BY global_entity_id,analytical_customer_id ORDER BY global_entity_id, analytical_customer_id, visit_day) AS lead,
      lead(visit_day, 1) OVER (PARTITION BY global_entity_id,analytical_customer_id ORDER BY global_entity_id, analytical_customer_id, visit_day) - visit_day AS time_diff

    FROM visit_log
    
    ORDER BY 1,2,3)
    
  SELECT
    global_entity_id,
    DATE_TRUNC(day,MONTH) AS month,
    DATE_ADD(DATE_TRUNC(day,MONTH), INTERVAL 1 MONTH) AS next_month,
    COUNT(DISTINCT analytical_customer_id) total_customers_prev_month_ls,
    COUNT(DISTINCT CASE WHEN time_diff.time_diff <<=30 THEN analytical_customer_id END) total_customers_reorder_30d_ls

  FROM time_diff

  GROUP BY 1,2,3

  ORDER BY 1,2,3),
  
  retention_ds AS (
  
  WITH time_diff AS ( 
  
  WITH visit_log AS (

    SELECT
       DISTINCT
       o.global_entity_id,
       analytical_customer_id,
       DATE_TRUNC(DATE(placed_at_local),DAY) as day,
       DATE_DIFF(DATE(placed_at_local),"2018-01-01",DAY) AS visit_day

  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o

  INNER JOIN vendors v ON v.global_entity_id = o.global_entity_id AND v.vendor_id = o.vendor_id

  WHERE
    is_sent
    AND analytical_customer_id IS NOT NULL
    AND is_ds_vendor
    AND DATE(placed_at_local) BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates)

  GROUP BY 1,2,3,4
  ORDER BY 1,2,3)
   
    SELECT 
      global_entity_id,
      analytical_customer_id,
      day,
      visit_day,
      lead(visit_day, 1) OVER (PARTITION BY global_entity_id,analytical_customer_id ORDER BY global_entity_id, analytical_customer_id, visit_day) AS lead,
      lead(visit_day, 1) OVER (PARTITION BY global_entity_id,analytical_customer_id ORDER BY global_entity_id, analytical_customer_id, visit_day) - visit_day AS time_diff

    FROM visit_log
    
    ORDER BY 1,2,3)
    
  SELECT
    global_entity_id,
    DATE_TRUNC(day,MONTH) AS month,
    DATE_ADD(DATE_TRUNC(day,MONTH), INTERVAL 1 MONTH) AS next_month,
    COUNT(DISTINCT analytical_customer_id) total_customers_prev_month_ds,
    COUNT(DISTINCT CASE WHEN time_diff.time_diff <<=30 THEN analytical_customer_id END) total_customers_reorder_30d_ds

  FROM time_diff

  GROUP BY 1,2,3

  ORDER BY 1,2,3),
  
  types AS (
   SELECT
    'Local Shops' AS type
    UNION ALL SELECT 'DMarts'
    UNION ALL SELECT 'Food')
    
SELECT
global_entity_id,
month,
next_month,
type,
CASE
  WHEN type = 'Food' THEN total_customers_prev_month_food
  WHEN type = 'Local Shops' THEN total_customers_prev_month_ls
  WHEN type = 'DMarts' THEN total_customers_prev_month_ds
END AS total_customers_prev,
CASE
  WHEN type = 'Food' THEN total_customers_reorder_30d_food
  WHEN type = 'Local Shops' THEN total_customers_reorder_30d_ls
  WHEN type = 'DMarts' THEN total_customers_reorder_30d_ds
END AS total_customers_reorder

FROM retention_food f
LEFT JOIN retention_ls USING (global_entity_id,month,next_month)
LEFT JOIN retention_ds USING (global_entity_id,month,next_month)
CROSS JOIN types

WHERE month BETWEEN (SELECT from_date FROM dates) AND (SELECT thru_date FROM dates)]]></relation>
