            <column caption='Promo Flag' datatype='string' name='[promo_flag]' role='dimension' type='nominal' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Report Date' datatype='date' default-format='*yyyy-mm-dd' name='[report_date]' role='dimension' type='ordinal' />
