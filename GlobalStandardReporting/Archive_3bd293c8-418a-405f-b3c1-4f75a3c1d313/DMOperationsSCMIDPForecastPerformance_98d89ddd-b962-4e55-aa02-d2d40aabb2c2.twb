      <table>
        <view>
          <datasources>
            <datasource caption='idp_forecast_performance_group (rl_dmart)' name='federated.02x5z430h96nho1a70w960d0tcrc' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity 2' datatype='string' name='[Date Granularity (copy 3)_1627488341532135434]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
            </column>
            <column caption='Grouping 1' datatype='string' name='[Dimentions (copy)_1627488341530181635]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
            <column caption='Grouping 2' datatype='string' name='[Grouping 1 (copy)_1627488341530255364]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Grouping 3' datatype='string' name='[Grouping 2 (copy)_1627488341530308613]' param-domain-type='list' role='measure' type='nominal' value='&quot;Product Segment&quot;'>
              <calculation class='tableau' formula='&quot;Product Segment&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.02x5z430h96nho1a70w960d0tcrc'>
            <column caption='Bias effective' datatype='real' default-format='p0%' name='[Bias  baseline (copy)_1040331538717097991]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([predicted_qty_effective_filtered]) / SUM([sold_qty_filtered])' />
            </column>
            <column caption='weekday' datatype='string' name='[Calculation_1628332796241698823]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(IF DATEPART(&apos;weekday&apos;,[report_date])=1 THEN 7&#10;ELSE DATEPART(&apos;weekday&apos;,[report_date])-1 &#10;END)&#10;+ &quot;.&quot; + DATENAME(&apos;weekday&apos;,[report_date])' />
            </column>
            <column caption='Product Segment' datatype='string' name='[Calculation_1720093618108919809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[abc_segmentation]+&quot;. &quot;+[unit_sales_contribution_bucket]' />
            </column>
            <column caption='Grouping 1' datatype='string' name='[Dimention breakdown (copy)_1627488341530468358]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimentions (copy)_1627488341530181635]&#13;&#10;WHEN &apos;Product Segment&apos; THEN [abc_segmentation]&#13;&#10;WHEN &apos;Promo Flag&apos; THEN [promo_flag]&#13;&#10;WHEN &apos;Country&apos; THEN [country]&#13;&#10;WHEN &apos;Region&apos; THEN [region]&#13;&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#13;&#10;WHEN &apos;Category L0&apos; THEN [category_level_zero]&#13;&#10;WHEN &apos;Category L1&apos; THEN [category_level_one]&#13;&#10;WHEN &apos;Category L2&apos; THEN [category_level_two]&#13;&#10;ELSE &apos;-&apos;&#13;&#10;END' />
            </column>
            <column caption='Grouping 2' datatype='string' name='[Grouping 1 (copy)_1627488341530775559]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Grouping 1 (copy)_1627488341530255364]&#13;&#10;WHEN &apos;Product Segment&apos; THEN [abc_segmentation]&#13;&#10;WHEN &apos;Promo Flag&apos; THEN [promo_flag]&#13;&#10;WHEN &apos;Country&apos; THEN [country]&#13;&#10;WHEN &apos;Region&apos; THEN [region]&#13;&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#13;&#10;WHEN &apos;Category L0&apos; THEN [category_level_zero]&#13;&#10;WHEN &apos;Category L1&apos; THEN [category_level_one]&#13;&#10;WHEN &apos;Category L2&apos; THEN [category_level_two]&#13;&#10;ELSE &apos;-&apos;&#13;&#10;END' />
            </column>
            <column caption='Grouping 3' datatype='string' name='[Grouping 2 (copy)_1627488341530845192]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Grouping 2 (copy)_1627488341530308613]&#13;&#10;WHEN &apos;Product Segment&apos; THEN [abc_segmentation]&#13;&#10;WHEN &apos;Promo Flag&apos; THEN [promo_flag]&#13;&#10;WHEN &apos;Country&apos; THEN [country]&#13;&#10;WHEN &apos;Region&apos; THEN [region]&#13;&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#13;&#10;WHEN &apos;Category L0&apos; THEN [category_level_zero]&#13;&#10;WHEN &apos;Category L1&apos; THEN [category_level_one]&#13;&#10;WHEN &apos;Category L2&apos; THEN [category_level_two]&#13;&#10;ELSE &apos;-&apos;&#13;&#10;END' />
            </column>
            <column caption='Week number' datatype='string' default-format='*yyyy-mm-dd' name='[Report Date (copy 2)_4493044339490689097]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Week &apos; + STR(CEILING(DATEPART(&apos;day&apos;, [report_date])/7))' />
            </column>
            <column caption='Report Date (copy)' datatype='date' default-format='*yyyy-mm-dd' name='[Report Date (copy)_6334946203135479808]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='Forecast factor application, %' datatype='real' default-format='p0%' name='[Skus with 100% availablility (copy)_869757705673637891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sku_qty_forecast_factor]) / SUM([sku_qty])' />
            </column>
            <column caption='Bias baseline' datatype='real' default-format='p0%' name='[WAPE  baseline (copy)_1040331538716925958]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([predicted_qty_baseline_filtered]) / SUM([sold_qty_filtered])' />
            </column>
            <column caption='WAPE baseline' datatype='real' default-format='p0%' name='[WAPE  baseline rolling (copy)_1040331538716549123]' role='measure' type='quantitative'>
