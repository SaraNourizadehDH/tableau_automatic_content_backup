      <aliases enabled='yes' />
      <column caption='Sku qty, % of total' datatype='real' default-format='p0%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sku_qty]) / TOTAL(SUM([sku_qty]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='date granularity' datatype='string' name='[Calculation_5680939134636843024]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Country Code Parameter] &#10;WHEN &apos;day&apos; THEN STR(DATE(DATETRUNC(&apos;day&apos;, [report_date]))) &#10;WHEN &apos;week&apos; THEN STR(DATE(DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;)))&#10;WHEN &apos;month&apos; THEN STR(DATE(DATETRUNC(&apos;month&apos;, [report_date])))  &#10;WHEN &apos;# week&apos; THEN STR(DATEPART(&apos;year&apos;, [report_date])) +&quot;  &quot;+ STR(DATEPART(&apos;week&apos;, [report_date]))&#10;WHEN &apos;quarter&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;, [report_date]))) &#10;END' />
      </column>
      <column caption='WAPE effective' datatype='real' default-format='p0%' name='[Calculation_578149646769131521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([forecast_error_effective_filtered]) / SUM([sold_qty_filtered])' />
      </column>
      <column caption='Metrics promo' datatype='real' name='[Calculation_738520019269636098]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Metric switcher - 1 (copy)_738520019268710401]&#10;WHEN &apos;WAPE effective&apos; THEN [Calculation_578149646769131521]&#10;WHEN &apos;Bias effective&apos; THEN [WAPE effective (copy)_738520019263303680]&#10;ELSE 0&#10;END' />
      </column>
      <column caption='WAPE effective promo in model' datatype='real' name='[WAPE effective (copy)_578149646769356802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [ds_promo_flag] = &apos;model_promo&apos;  THEN [forecast_error_effective_filtered] END) &#10;/ &#10;SUM(IF [ds_promo_flag] = &apos;model_promo&apos;  THEN [sold_qty_filtered] END)' />
      </column>
      <column caption='BIAS effective ' datatype='real' default-format='p0%' name='[WAPE effective (copy)_738520019263303680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([predicted_qty_effective_filtered]) / SUM([sold_qty_filtered])' />
      </column>
      <column caption='WAPE effective promo not in model' datatype='real' name='[WAPE effective promo in model (copy)_3040985324570357766]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [ds_promo_flag] = &apos;non_model_promo&apos;  THEN [forecast_error_effective_filtered] END) &#10;/ &#10;SUM(IF [ds_promo_flag] = &apos;non_model_promo&apos;  THEN [sold_qty_filtered] END)' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='idp_forecast_performance_promos_group_temp' datatype='table' name='[__tableau_internal_object_id__].[idp_forecast_performance_promos_group_temp_B1F67930BCD6427699C85460504EC78A]' role='measure' type='quantitative' />
      <column caption='All Users Flag' datatype='boolean' name='[all_users_flag]' role='dimension' type='nominal' />
      <column datatype='string' name='[audience_types]' role='dimension' type='nominal' />
      <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
