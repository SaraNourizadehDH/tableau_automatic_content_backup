    <worksheet name='1. G - Metric WAPE rolling dissection'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='10'>WAPE baseline division by over- and under- forecast</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='idp_forecast_performance_group (rl_dmart)' name='federated.02x5z430h96nho1a70w960d0tcrc' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Country Code Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
            </column>
            <column caption='Category switcher' datatype='string' name='[Dimentions (copy)_808959110061649921]' param-domain-type='list' role='measure' type='nominal' value='&quot;Category L1&quot;'>
              <calculation class='tableau' formula='&quot;Category L1&quot;' />
            </column>
            <column caption='GEO switcher' datatype='string' name='[Dimentions (copy)_808959110062010371]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.02x5z430h96nho1a70w960d0tcrc'>
            <column caption='WAPE baseline rolling' datatype='real' default-format='p0%' name='[Calculation_1040331538715611136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([forecast_error_baseline_filtered_rolling]) / SUM([sold_qty_filtered_rolling])' />
            </column>
            <column caption='date granularity' datatype='string' name='[Calculation_1040331538717286408]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Country Code Parameter] &#13;&#10;WHEN &apos;day&apos; THEN STR(DATE(DATETRUNC(&apos;day&apos;, [report_date]))) &#13;&#10;WHEN &apos;week&apos; THEN STR(DATE(DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;)))&#13;&#10;WHEN &apos;month&apos; THEN STR(DATE(DATETRUNC(&apos;month&apos;, [report_date])))  &#13;&#10;WHEN &apos;# week&apos; THEN STR(DATEPART(&apos;year&apos;, [report_date])) +&quot;  &quot;+ STR(DATEPART(&apos;week&apos;, [report_date]))&#13;&#10;WHEN &apos;quarter&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;, [report_date]))) &#13;&#10;WHEN &apos;weekday&apos; THEN [Calculation_1628332796241698823]&#13;&#10;WHEN &apos;week number&apos; THEN [Report Date (copy 2)_4493044339490689097]&#13;&#10;END' />
            </column>
            <column caption='weekday' datatype='string' name='[Calculation_1628332796241698823]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(IF DATEPART(&apos;weekday&apos;,[report_date])=1 THEN 7&#10;ELSE DATEPART(&apos;weekday&apos;,[report_date])-1 &#10;END)&#10;+ &quot;.&quot; + DATENAME(&apos;weekday&apos;,[report_date])' />
            </column>
            <column caption='Product Segment' datatype='string' name='[Calculation_1720093618108919809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[abc_segmentation]+&quot;. &quot;+[unit_sales_contribution_bucket]' />
            </column>
            <column caption='Category switcher' datatype='string' name='[Dimention breakdown (copy)_808959110061334528]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimentions (copy)_808959110061649921]&#13;&#10;WHEN &apos;Category L0&apos; THEN [category_level_zero]&#13;&#10;WHEN &apos;Category L1&apos; THEN [category_level_one]&#13;&#10;WHEN &apos;Category L2&apos; THEN [category_level_two]&#13;&#10;ELSE &apos;-&apos;&#13;&#10;END' />
            </column>
            <column caption='GEO switcher' datatype='string' name='[Dimention breakdown (copy)_808959110061821954]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimentions (copy)_808959110062010371]&#13;&#10;WHEN &apos;Country&apos; THEN [country]&#13;&#10;WHEN &apos;Region&apos; THEN [region]&#13;&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#13;&#10;ELSE &apos;-&apos;&#13;&#10;END' />
            </column>
            <column caption='Week number' datatype='string' default-format='*yyyy-mm-dd' name='[Report Date (copy 2)_4493044339490689097]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Week &apos; + STR(CEILING(DATEPART(&apos;day&apos;, [report_date])/7))' />
            </column>
            <column caption='Report Date (copy)' datatype='date' default-format='*yyyy-mm-dd' name='[Report Date (copy)_6334946203135479808]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='W-Overforecast-PE baseline rolling, %' datatype='real' default-format='p0%' name='[W-Underforecast-PE baseline rolling, % (copy)_1530660924775518209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([over_forecast_error_baseline_filtered_rolling]) / SUM([sold_qty_filtered_rolling])' />
            </column>
            <column caption='W-Underforecast-PE baseline rolling, %' datatype='real' default-format='p0%' name='[WAPE baseline rolling (copy)_1530660924775227392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-SUM([under_forecast_error_baseline_filtered_rolling]) / SUM([sold_qty_filtered_rolling])' />
            </column>
            <column caption='Abc Segmentation' datatype='string' name='[abc_segmentation]' role='dimension' type='nominal' />
            <column caption='Category Level One' datatype='string' name='[category_level_one]' role='dimension' type='nominal' />
            <column caption='Category Level Two' datatype='string' name='[category_level_two]' role='dimension' type='nominal' />
            <column caption='Category Level Zero' datatype='string' name='[category_level_zero]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Forecast Error Baseline Filtered Rolling' datatype='real' name='[forecast_error_baseline_filtered_rolling]' role='measure' type='quantitative' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1040331538717286408]' derivation='None' name='[none:Calculation_1040331538717286408:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1720093618108919809]' derivation='None' name='[none:Calculation_1720093618108919809:nk]' pivot='key' type='nominal' />
            <column-instance column='[Report Date (copy)_6334946203135479808]' derivation='None' name='[none:Report Date (copy)_6334946203135479808:qk]' pivot='key' type='quantitative' />
            <column-instance column='[category_level_one]' derivation='None' name='[none:category_level_one:nk]' pivot='key' type='nominal' />
