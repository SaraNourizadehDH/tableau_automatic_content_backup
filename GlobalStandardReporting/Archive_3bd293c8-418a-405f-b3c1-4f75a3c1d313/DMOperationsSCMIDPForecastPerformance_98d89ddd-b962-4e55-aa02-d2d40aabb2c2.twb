          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Country Code Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
            </column>
            <column caption='Metric switcher - Promo' datatype='string' name='[Metric switcher - 1 (copy)_738520019268710401]' param-domain-type='list' role='measure' type='nominal' value='&quot;WAPE effective&quot;'>
              <calculation class='tableau' formula='&quot;WAPE effective&quot;' />
