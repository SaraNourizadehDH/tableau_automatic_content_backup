      <table>
        <view>
          <datasources>
            <datasource caption='idp_forecast_management_usage (rl_dmart)' name='federated.1e6nb3913v9k0l1487wyz095ejme' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Country Code Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
            </column>
            <column caption='Category switcher' datatype='string' name='[Dimentions (copy)_808959110061649921]' param-domain-type='list' role='measure' type='nominal' value='&quot;Category L1&quot;'>
              <calculation class='tableau' formula='&quot;Category L1&quot;' />
            </column>
            <column caption='GEO switcher' datatype='string' name='[Dimentions (copy)_808959110062010371]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1e6nb3913v9k0l1487wyz095ejme'>
            <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sku_qty_factor_applied]) / TOTAL(SUM([sku_qty_factor_applied]))'>
                <table-calc ordering-type='ColumnInPane' />
              </calculation>
            </column>
            <column caption='date granularity' datatype='string' name='[Calculation_1040331538717286408]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Country Code Parameter] &#13;&#10;WHEN &apos;day&apos; THEN STR(DATE(DATETRUNC(&apos;day&apos;, [report_date]))) &#13;&#10;WHEN &apos;week&apos; THEN STR(DATE(DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;)))&#13;&#10;WHEN &apos;month&apos; THEN STR(DATE(DATETRUNC(&apos;month&apos;, [report_date])))  &#13;&#10;WHEN &apos;# week&apos; THEN STR(DATEPART(&apos;year&apos;, [report_date])) +&quot;  &quot;+ STR(DATEPART(&apos;week&apos;, [report_date]))&#13;&#10;WHEN &apos;quarter&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;, [report_date]))) &#13;&#10;END' />
            </column>
            <column caption='WAPE correction' datatype='real' default-format='p0%' name='[Calculation_904379149047742466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[WAPE corrected (copy)_904379149045788673]-[WAPE effective (copy)_1442559304513236992]' />
            </column>
            <column caption='Category' datatype='string' name='[Dimention breakdown (copy)_808959110061334528]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimentions (copy)_808959110061649921]&#13;&#10;WHEN &apos;Category L0&apos; THEN [category_level_zero]&#13;&#10;WHEN &apos;Category L1&apos; THEN [category_level_one]&#13;&#10;ELSE &apos;-&apos;&#13;&#10;END' />
            </column>
            <column caption='Entity' datatype='string' name='[Dimention breakdown (copy)_808959110061821954]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimentions (copy)_808959110062010371]&#13;&#10;WHEN &apos;Country&apos; THEN [country]&#13;&#10;WHEN &apos;Region&apos; THEN [region]&#13;&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#13;&#10;ELSE &apos;-&apos;&#13;&#10;END' />
            </column>
            <column caption='WAPE corrected under forecast FF applied' datatype='real' default-format='p0%' name='[WAPE  corrected over forecast FF applied (copy)_1628332795888406529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF[sku_qty_factor_applied_filtered]&gt;0 &#10;THEN IFNULL([forecast_error_corrected_filtered_under_factor_applied],0)&#10;END&#10;)&#10;/ SUM([sold_qty_filtered_factor_applied])' />
            </column>
            <column caption='WAPE corrected FF applied' datatype='real' default-format='p0%' name='[WAPE corrected (copy)_904379149045788673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([forecast_error_corrected_filtered_factor_applied]) / SUM([sold_qty_filtered_factor_applied])' />
            </column>
            <column caption='WAPE corrected over forecast FF applied' datatype='real' default-format='p0%' name='[WAPE corrected FF applied (copy)_1628332795887841280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-SUM(&#10;IF[sku_qty_factor_applied]&gt;0 &#10;THEN IFNULL([forecast_error_corrected_filtered_over_factor_applied],0)&#10;END&#10;) / SUM([sold_qty_filtered_factor_applied])' />
            </column>
            <column caption='WAPE effective under forecast FF applied' datatype='real' default-format='p0%' name='[WAPE corrected under forecast FF applied (copy)_1628332795888828418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([forecast_error_effective_filtered_under_factor_applied] )/ SUM([sold_qty_filtered_factor_applied])' />
            </column>
            <column caption='WAPE effective FF applied' datatype='real' default-format='p0%' name='[WAPE effective (copy)_1442559304513236992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([forecast_error_effective_filtered_factor_applied]) / SUM([sold_qty_filtered_factor_applied])' />
            </column>
            <column caption='WAPE effective over  forecast FF applied' datatype='real' default-format='p0%' name='[WAPE effective under forecast FF applied (copy)_1628332795889176579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-SUM([forecast_error_effective_filtered_over_factor_applied] )/ SUM([sold_qty_filtered_factor_applied])' />
            </column>
            <column caption='WAPE correction, over forecast' datatype='real' default-format='p0%' name='[WAPEs delta diff (copy)_1628332795891294212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[WAPE corrected FF applied (copy)_1628332795887841280] - [WAPE effective under forecast FF applied (copy)_1628332795889176579]' />
            </column>
            <column caption='WAPE correction, under forecast' datatype='real' default-format='p0%' name='[WAPEs delta diff, over forecast (copy)_1628332795891507205]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[WAPE  corrected over forecast FF applied (copy)_1628332795888406529] -&#13;&#10; [WAPE corrected under forecast FF applied (copy)_1628332795888828418]' />
            </column>
