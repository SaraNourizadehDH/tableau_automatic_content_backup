    <worksheet name='1. G - Promo WAPE &amp; BIAS'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='10'>Split by Promo</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='idp_forecast_performance_group (rl_dmart)' name='federated.02x5z430h96nho1a70w960d0tcrc' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric switcher - 1' datatype='string' name='[Date Granularity (copy 2)]' param-domain-type='list' role='measure' type='nominal' value='&quot;WAPE baseline&quot;'>
              <calculation class='tableau' formula='&quot;WAPE baseline&quot;' />
            </column>
            <column caption='Category switcher' datatype='string' name='[Dimentions (copy)_808959110061649921]' param-domain-type='list' role='measure' type='nominal' value='&quot;Category L1&quot;'>
              <calculation class='tableau' formula='&quot;Category L1&quot;' />
            </column>
            <column caption='GEO switcher' datatype='string' name='[Dimentions (copy)_808959110062010371]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
            <column caption='Metric switcher - 2' datatype='string' name='[Metric switcher - 1 (copy)_355502920401879040]' param-domain-type='list' role='measure' type='nominal' value='&quot;Bias baseline&quot;'>
              <calculation class='tableau' formula='&quot;Bias baseline&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.02x5z430h96nho1a70w960d0tcrc'>
            <column caption='Bias effective' datatype='real' default-format='p0%' name='[Bias  baseline (copy)_1040331538717097991]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([predicted_qty_effective_filtered]) / SUM([sold_qty_filtered])' />
            </column>
            <column caption='Bias baseline rolling' datatype='real' default-format='p0%' name='[Bias baseline (copy)_1627488341528109056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([predicted_qty_baseline_filtered_rolling]) / SUM([sold_qty_filtered_rolling])' />
            </column>
            <column caption='Bias corrected rolling' datatype='real' default-format='p0%' name='[Bias corrected (copy)_1627488341528346625]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([predicted_qty_corrected_filtered_rolling]) / SUM(sold_qty_filtered_rolling)' />
            </column>
            <column caption='Bias effective rolling' datatype='real' default-format='p0%' name='[Bias effective (copy)_1627488341528469506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([predicted_qty_effective_filtered_rolling]) / SUM([sold_qty_filtered_rolling])' />
            </column>
            <column caption='Bias corrected' datatype='real' default-format='p0%' name='[Bias effective (copy)_355502920403668995]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([predicted_qty_corrected_filtered]) / SUM([sold_qty_filtered])' />
            </column>
            <column caption='Sold Qty, % of total' datatype='real' default-format='p0%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sold_qty]) / TOTAL(SUM([sold_qty]))'>
                <table-calc ordering-type='Columns' />
              </calculation>
            </column>
            <column caption='WAPE baseline rolling' datatype='real' default-format='p0%' name='[Calculation_1040331538715611136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([forecast_error_baseline_filtered_rolling]) / SUM([sold_qty_filtered_rolling])' />
            </column>
            <column caption='Skus/wh/days with forecast factor' datatype='integer' name='[Calculation_1415537698997256192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sku_qty_forecast_factor])' />
            </column>
            <column caption='Product Segment' datatype='string' name='[Calculation_1720093618108919809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[abc_segmentation]+&quot;. &quot;+[unit_sales_contribution_bucket]' />
            </column>
            <column caption='Skus with 100% availablility' datatype='real' default-format='p0%' name='[Calculation_869757705667653634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sku_qty_full_availability]) / SUM([sku_qty])' />
            </column>
            <column caption='Skus with promo, qty' datatype='integer' name='[Calculation_912823395104022529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [promo_flag] = &apos;promo&apos; THEN [sku_qty] else 0 END)' />
            </column>
            <column caption='Skus with promo, %' datatype='real' default-format='p0.0%' name='[Calculation_912823395104305154]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_912823395104022529] / sum([sku_qty])' />
            </column>
            <column caption='Metric 1' datatype='real' name='[Dimention breakdown (copy)_355502920403083266]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy 2)]&#13;&#10;WHEN &apos;WAPE baseline&apos; THEN [WAPE  baseline rolling (copy)_1040331538716549123]&#13;&#10;WHEN &apos;WAPE corrected&apos; THEN [WAPE corrected rolling (copy)_1040331538716610564]&#13;&#10;WHEN &apos;WAPE effective&apos; THEN [WAPE effective rolling (copy)_1040331538716672005]&#13;&#10;WHEN &apos;WAPE baseline rolling&apos; THEN [Calculation_1040331538715611136]&#13;&#10;WHEN &apos;WAPE effective rolling&apos; THEN [WAPE rolling baseline (copy)_1040331538715832321]&#13;&#10;WHEN &apos;WAPE corrected rolling&apos; THEN [WAPE effective rolling (copy)_1040331538716405762]&#13;&#10;WHEN &apos;Bias baseline&apos; THEN [WAPE  baseline (copy)_1040331538716925958]&#13;&#10;WHEN &apos;Bias corrected&apos; THEN [Bias effective (copy)_355502920403668995] &#13;&#10;WHEN &apos;Bias effective&apos; THEN [Bias  baseline (copy)_1040331538717097991]&#13;&#10;WHEN &apos;Bias baseline rolling&apos; THEN [Bias baseline (copy)_1627488341528109056]&#13;&#10;WHEN &apos;Bias corrected rolling&apos; THEN [Bias corrected (copy)_1627488341528346625]&#13;&#10;WHEN &apos;Bias effective rolling&apos; THEN [Bias effective (copy)_1627488341528469506]&#13;&#10;WHEN &apos;Skus 100% availalable&apos; THEN  [Calculation_869757705667653634]&#13;&#10;WHEN &apos;Forecast factor application, %&apos; THEN [Skus with 100% availablility (copy)_869757705673637891]&#13;&#10;WHEN &apos;Skus/wh/days with forecast factor&apos; THEN [Calculation_1415537698997256192]&#13;&#10;WHEN &apos;Skus with promo, %&apos; THEN [Calculation_912823395104305154]&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Category switcher' datatype='string' name='[Dimention breakdown (copy)_808959110061334528]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimentions (copy)_808959110061649921]&#13;&#10;WHEN &apos;Category L0&apos; THEN [category_level_zero]&#13;&#10;WHEN &apos;Category L1&apos; THEN [category_level_one]&#13;&#10;WHEN &apos;Category L2&apos; THEN [category_level_two]&#13;&#10;ELSE &apos;-&apos;&#13;&#10;END' />
            </column>
            <column caption='GEO switcher' datatype='string' name='[Dimention breakdown (copy)_808959110061821954]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimentions (copy)_808959110062010371]&#13;&#10;WHEN &apos;Country&apos; THEN [country]&#13;&#10;WHEN &apos;Region&apos; THEN [region]&#13;&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#13;&#10;ELSE &apos;-&apos;&#13;&#10;END' />
            </column>
            <column caption='Metric 2' datatype='real' name='[Metric 1 (copy)_355502920404004868]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Metric switcher - 1 (copy)_355502920401879040]&#13;&#10;WHEN &apos;WAPE baseline&apos; THEN [WAPE  baseline rolling (copy)_1040331538716549123]&#13;&#10;WHEN &apos;WAPE corrected&apos; THEN [WAPE corrected rolling (copy)_1040331538716610564]&#13;&#10;WHEN &apos;WAPE effective&apos; THEN [WAPE effective rolling (copy)_1040331538716672005]&#13;&#10;WHEN &apos;WAPE baseline rolling&apos; THEN [Calculation_1040331538715611136]&#13;&#10;WHEN &apos;WAPE effective rolling&apos; THEN [WAPE rolling baseline (copy)_1040331538715832321]&#13;&#10;WHEN &apos;WAPE corrected rolling&apos; THEN [WAPE effective rolling (copy)_1040331538716405762]&#13;&#10;WHEN &apos;Bias baseline&apos; THEN [WAPE  baseline (copy)_1040331538716925958]&#13;&#10;WHEN &apos;Bias corrected&apos; THEN [Bias effective (copy)_355502920403668995]&#13;&#10;WHEN &apos;Bias effective&apos; THEN [Bias  baseline (copy)_1040331538717097991]&#13;&#10;WHEN &apos;Bias baseline rolling&apos; THEN [Bias baseline (copy)_1627488341528109056]&#13;&#10;WHEN &apos;Bias corrected rolling&apos; THEN [Bias corrected (copy)_1627488341528346625]&#13;&#10;WHEN &apos;Bias effective rolling&apos; THEN [Bias effective (copy)_1627488341528469506]&#13;&#10;WHEN &apos;Forecast factor application, %&apos; THEN [Skus with 100% availablility (copy)_869757705673637891]&#13;&#10;WHEN &apos;Skus/wh/days with forecast factor&apos; THEN [Calculation_1415537698997256192]&#13;&#10;WHEN &apos;Skus with promo, %&apos; THEN [Calculation_912823395104305154]&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Report Date (copy)' datatype='date' default-format='*yyyy-mm-dd' name='[Report Date (copy)_6334946203135479808]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
