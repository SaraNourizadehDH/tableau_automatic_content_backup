    <worksheet name='FM - M. H - FF application countries'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='10'>Countries use FF</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='idp_forecast_management (rl_dmart)' name='federated.0gs6kzq07b5hj013q1vqc0xh1jt0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Country Code Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
            </column>
            <column caption='FM. Dimensions' datatype='string' name='[Dimensions (copy)_861594954737872898]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
            </column>
            <column caption='Category switcher' datatype='string' name='[Dimentions (copy)_808959110061649921]' param-domain-type='list' role='measure' type='nominal' value='&quot;Category L1&quot;'>
              <calculation class='tableau' formula='&quot;Category L1&quot;' />
            </column>
            <column caption='GEO switcher' datatype='string' name='[Dimentions (copy)_808959110062010371]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gs6kzq07b5hj013q1vqc0xh1jt0'>
            <column caption='Bias corrected FF applied' datatype='real' default-format='p0%' name='[Bias corrected (copy)_904379149048451075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([predicted_qty_corrected_filtered_factor_applied]) / SUM([sold_qty_filtered_factor_applied])' />
            </column>
            <column caption='Bias effective FF applied' datatype='real' default-format='p0%' name='[Bias effective (copy)_904379149048655876]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([predicted_qty_effective_filtered_factor_applied]) / SUM([sold_qty_filtered_factor_applied])' />
            </column>
            <column caption='date granularity' datatype='string' name='[Calculation_1040331538717286408]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Country Code Parameter] &#13;&#10;WHEN &apos;day&apos; THEN STR(DATE(DATETRUNC(&apos;day&apos;, [report_date]))) &#13;&#10;WHEN &apos;week&apos; THEN STR(DATE(DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;)))&#13;&#10;WHEN &apos;month&apos; THEN STR(DATE(DATETRUNC(&apos;month&apos;, [report_date])))  &#13;&#10;WHEN &apos;# week&apos; THEN STR(DATEPART(&apos;year&apos;, [report_date])) +&quot;  &quot;+ STR(DATEPART(&apos;week&apos;, [report_date]))&#13;&#10;WHEN &apos;quarter&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;, [report_date]))) &#13;&#10;END' />
            </column>
            <column caption='Product Segment' datatype='string' name='[Calculation_1720093618108919809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[abc_segmentation]' />
            </column>
            <column caption='Countries apply FF' datatype='integer' name='[Calculation_235876047824535552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [sku_qty_factor_applied] &gt;0 THEN [country] END&#13;&#10;)' />
            </column>
            <column caption='Dimension breakdown' datatype='string' name='[Calculation_861594954744569866]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimensions (copy)_861594954737872898]&#13;&#10;WHEN &apos;Product Segment&apos; THEN [Calculation_1720093618108919809]&#13;&#10;WHEN &apos;Country&apos; THEN [country]&#13;&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#13;&#10;WHEN &apos;Category L0&apos; THEN [category_level_zero]&#13;&#10;WHEN &apos;Category L1&apos; THEN [category_level_one]&#13;&#10;ELSE &apos;-&apos;&#13;&#10;END' />
            </column>
            <column caption='Category' datatype='string' name='[Dimention breakdown (copy)_808959110061334528]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimentions (copy)_808959110061649921]&#13;&#10;WHEN &apos;Category L0&apos; THEN [category_level_zero]&#13;&#10;WHEN &apos;Category L1&apos; THEN [category_level_one]&#13;&#10;ELSE &apos;-&apos;&#13;&#10;END' />
            </column>
            <column caption='Entity' datatype='string' name='[Dimention breakdown (copy)_808959110061821954]' role='dimension' type='nominal'>
