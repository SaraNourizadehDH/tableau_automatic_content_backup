      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/GeneralRankingReport2022/UserInstructions?rev=' id='UserInstructions' path='/t/GlobalStandardReporting/workbooks/GeneralRankingReport2022' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98000' id='5' param='vert' type-v2='layout-flow' w='98400' x='800' y='1000'>
            <zone h='4625' id='7' type-v2='title' w='98400' x='800' y='1000'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='background-color' value='#000000' />
              </zone-style>
            </zone>
            <zone h='93375' id='6' type-v2='layout-basic' w='98400' x='800' y='5625'>
              <zone forceUpdate='true' h='93375' id='8' type-v2='text' w='98400' x='800' y='5625'>
                <formatted-text>
                  <run bold='true' fontcolor='#ffffff' fontsize='15'>Dashboards:</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#ffffff' fontsize='12'>Æ  </run>
                  <run bold='true' fontcolor='#ffffff' fontsize='12'>&gt;&gt; Ranking Variation - </run>
                  <run fontcolor='#ffffff' fontsize='12'>Shows the performance of ranking variations with respect to each other. Helps analyse the best performing variation for a selected metric. </run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#ffffff' fontsize='12'>Æ  </run>
                  <run bold='true' fontcolor='#ffffff' fontsize='12'>&gt;&gt; Entity Overview -</run>
                  <run fontcolor='#ffffff' fontsize='12'> Shows an aggregation of metric values for each ranking variation on the global entity level for the selected time period. </run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#ffffff' fontsize='12'>Æ  </run>
                  <run bold='true' fontcolor='#ffffff' fontsize='12'>&gt;&gt; Weekday Metrics - </run>
                  <run fontcolor='#ffffff' fontsize='12'>Gives an overview of ranking variation performance for all metrics on each day of the week</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#ffffff' fontsize='12'>Æ  </run>
                  <run bold='true' fontcolor='#ffffff' fontsize='12'>&gt;&gt; Ranking Comparison Over time </run>
                  <run fontcolor='#ffffff' fontsize='12'>- Graphical view of metric performace with time for different ranking variations.</run>
                  <run>Æ&#10;&#10;&#10;&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='15'>Filters:</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='12'>   &gt;&gt; Date filters -</run>
                  <run fontcolor='#ffffff' fontsize='12'>Æ </run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#ffffff' fontsize='12'>Æ          </run>
                  <run fontcolor='#e15759' fontsize='12'>Please  keep in mind the launch date for each entity.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#ffffff' fontsize='12'>          Limit date range to smaller ranges for better view and loading times. </run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#ffffff' fontsize='12'>          To avoid skewed data make sure the ranking variations are distributed evenly. </run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#ffffff' fontsize='12'>         Check with dashboard owners on the timelines for the experiment.</run>
                  <run>Æ&#10;&#10;&#10;</run>
                  <run fontcolor='#ffffff' fontsize='12'>Æ   </run>
                  <run bold='true' fontcolor='#ffffff' fontsize='12'>&gt;&gt; Global Entity ID - </run>
                  <run fontcolor='#ffffff' fontsize='12'>For better insights, it is recommended to select on entity at a time. </run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#ffffff' fontsize='12'>Æ   </run>
                  <run bold='true' fontcolor='#ffffff' fontsize='12'>&gt;&gt; Select Metric - </run>
                  <run fontcolor='#ffffff' fontsize='12'>filter different metrics to check how each metric has performed for different variations(</run>
                  <run fontcolor='#ffffff' fontsize='10' italic='true'>applies only to  Single Metric Trend Over time, Ranking_Variation).</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#ffffff' fontsize='12'>Æ   </run>
                  <run bold='true' fontcolor='#ffffff' fontsize='12'>&gt;&gt; Ranking Variation Select</run>
                  <run fontcolor='#ffffff' fontsize='12'> - Select the ranking variations which has to be compared to other varitions (</run>
                  <run fontcolor='#ffffff' fontsize='10' italic='true'>applies only to Ranking_Variation).</run>
                  <run>Æ&#10;&#10;&#10;&#10;&#10;&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#666666' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
