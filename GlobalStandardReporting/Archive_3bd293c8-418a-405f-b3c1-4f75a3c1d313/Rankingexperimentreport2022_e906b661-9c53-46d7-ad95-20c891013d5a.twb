    <worksheet name='Sheet 2'>
      <table>
        <view>
          <datasources>
            <datasource caption='_category_product_ranking_experiment (cl_data_science_qcommerce)' name='federated.1gapam51ampag210uhsd80mrjdoj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Order Count per Session&quot;'>
              <calculation class='tableau' formula='&quot;Order Count per Session&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gapam51ampag210uhsd80mrjdoj'>
            <column caption='Metrics' datatype='real' name='[Calculation_1437422365870317569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE   [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;ABV&apos;  THEN AVG([gbv_eur])&#10;WHEN &apos;Order Count per Session&apos; THEN SUM([count_orders_in_session])/COUNTD([perseus_session_id])&#10;WHEN &apos;Rank Normalised avg&apos; THEN AVG([rank_normalized_avg])&#10;&#10;&#10;&#10;WHEN &apos;Add cart time (avg)&apos;      THEN AVG([add_cart_time])&#10;WHEN &apos;Conversion rate&apos; THEN AVG([count_add_to_cart])&#10;&#10;&#10;WHEN &apos;Basket Size (avg)&apos;      THEN AVG([count_basket_items])&#10;WHEN &apos;Distinct Products (avg)&apos;   THEN AVG([count_distinct_products])&#10;&#10;&#10;WHEN &apos;Conversion rate&apos;  THEN AVG([count_cat_loaded])&#10;WHEN &apos;Clients&apos;            THEN COUNTD([perseus_client_id])&#10;WHEN &apos;Vendors&apos;              THEN COUNTD([vendor_code])&#10;&#10;END' />
            </column>
            <column caption='Axis Metric' datatype='string' name='[Calculation_1437422365933506565]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;ABV&quot;  THEN &quot;ABV&quot;&#10;WHEN &quot;Add cart time(avg)&quot; THEN &quot;Add to Cart Time(s)Avg&quot;&#10;WHEN &quot;Order Count&quot;  THEN &quot;Order Count&quot;&#10;WHEN &quot;Basket Size (avg)&quot;   THEN &quot;Basket size(avg)&quot;&#10;WHEN &quot;Clients&quot;    THEN &quot;Client count&quot;&#10;WHEN &quot;Distinct Products (avg)&quot; THEN &quot;Distinct Products(avg)&quot;&#10;WHEN &quot;Vendors&quot; THEN &quot;Vendor Count&quot;&#10;WHEN &quot;Rank Normalised avg&quot; THEN &quot;Rank Normalised avg&quot;&#10;END' />
            </column>
            <column caption='Add Cart Time' datatype='real' name='[add_cart_time]' role='measure' type='quantitative' />
            <column caption='Count Add To Cart' datatype='integer' name='[count_add_to_cart]' role='measure' type='quantitative' />
            <column caption='Count Basket Items' datatype='real' name='[count_basket_items]' role='measure' type='quantitative' />
            <column caption='Count Cat Loaded' datatype='integer' name='[count_cat_loaded]' role='measure' type='quantitative' />
            <column caption='Count Distinct Products' datatype='real' name='[count_distinct_products]' role='measure' type='quantitative' />
            <column caption='Count Orders In Session' datatype='integer' name='[count_orders_in_session]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Gbv Eur' datatype='real' name='[gbv_eur]' role='measure' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1437422365933506565]' derivation='None' name='[none:Calculation_1437422365933506565:nk]' pivot='key' type='nominal' />
            <column-instance column='[date]' derivation='None' name='[none:date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[rank_variation]' derivation='None' name='[none:rank_variation:nk]' pivot='key' type='nominal' />
            <column caption='Perseus Client Id' datatype='string' name='[perseus_client_id]' role='dimension' type='nominal' />
            <column caption='Perseus Session Id' datatype='string' name='[perseus_session_id]' role='dimension' type='nominal' />
            <column caption='Rank Normalized Avg' datatype='real' name='[rank_normalized_avg]' role='measure' type='quantitative' />
            <column caption='Rank Variation' datatype='string' name='[rank_variation]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;SORT_ORDER_PERSONALIZED&quot;' value='Personalized Rank' />
                <alias key='&quot;SORT_ORDER_POPULARITY_SCORE&quot;' value='Popularity Rank' />
              </aliases>
            </column>
            <column-instance column='[date]' derivation='Day-Trunc' name='[tdy:date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1437422365870317569]' derivation='User' name='[usr:Calculation_1437422365870317569:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Code' datatype='string' name='[vendor_code]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1gapam51ampag210uhsd80mrjdoj].[User Filter 1]' context='true' />
          <filter class='categorical' column='[federated.1gapam51ampag210uhsd80mrjdoj].[none:global_entity_id:nk]'>
            <groupfilter function='member' level='[none:global_entity_id:nk]' member='&quot;TB_JO&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
