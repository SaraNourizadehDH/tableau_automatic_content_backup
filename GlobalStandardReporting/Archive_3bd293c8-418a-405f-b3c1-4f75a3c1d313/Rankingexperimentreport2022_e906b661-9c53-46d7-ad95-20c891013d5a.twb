      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1gapam51ampag210uhsd80mrjdoj].[avg:add_cart_time:qk]&quot;' value='Add Cart Time(s) Avg' />
          <alias key='&quot;[federated.1gapam51ampag210uhsd80mrjdoj].[avg:count_add_to_cart:qk]&quot;' value='Conversion rate' />
          <alias key='&quot;[federated.1gapam51ampag210uhsd80mrjdoj].[avg:count_basket_items:qk]&quot;' value='Basket size (Avg)' />
          <alias key='&quot;[federated.1gapam51ampag210uhsd80mrjdoj].[avg:count_orders_in_session:qk]&quot;' value='Order count' />
          <alias key='&quot;[federated.1gapam51ampag210uhsd80mrjdoj].[avg:gbv_eur:qk]&quot;' value='ABV' />
          <alias key='&quot;[federated.1gapam51ampag210uhsd80mrjdoj].[pcdf:usr:Calculation_1437422365870317569:qk:2]&quot;' value='% Difference in Metrics along Rank Variation' />
          <alias key='&quot;[federated.1gapam51ampag210uhsd80mrjdoj].[pcdf:usr:Calculation_1437422365870317569:qk]&quot;' value='% Difference in Metrics from the Select Variation along Rank Variation' />
          <alias key='&quot;[federated.1gapam51ampag210uhsd80mrjdoj].[sum:count_orders_in_session:qk]&quot;' value='Order Count ' />
        </aliases>
      </column>
      <column caption='Metrics' datatype='real' name='[Calculation_1437422365870317569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE   [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;ABV&apos;  THEN AVG([gbv_eur])&#10;WHEN &apos;Order Count per Session&apos; THEN SUM([count_orders_in_session])/COUNTD([perseus_session_id])&#10;WHEN &apos;Rank Normalised avg&apos; THEN AVG([rank_normalized_avg])&#10;&#10;&#10;&#10;WHEN &apos;Add cart time (avg)&apos;      THEN AVG([add_cart_time])&#10;WHEN &apos;Conversion rate&apos; THEN AVG([count_add_to_cart])&#10;&#10;&#10;WHEN &apos;Basket Size (avg)&apos;      THEN AVG([count_basket_items])&#10;WHEN &apos;Distinct Products (avg)&apos;   THEN AVG([count_distinct_products])&#10;&#10;&#10;WHEN &apos;Conversion rate&apos;  THEN AVG([count_cat_loaded])&#10;WHEN &apos;Clients&apos;            THEN COUNTD([perseus_client_id])&#10;WHEN &apos;Vendors&apos;              THEN COUNTD([vendor_code])&#10;&#10;END' />
      </column>
      <column caption='Axis Metric' datatype='string' name='[Calculation_1437422365933506565]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;ABV&quot;  THEN &quot;ABV&quot;&#10;WHEN &quot;Add cart time(avg)&quot; THEN &quot;Add to Cart Time(s)Avg&quot;&#10;WHEN &quot;Order Count&quot;  THEN &quot;Order Count&quot;&#10;WHEN &quot;Basket Size (avg)&quot;   THEN &quot;Basket size(avg)&quot;&#10;WHEN &quot;Clients&quot;    THEN &quot;Client count&quot;&#10;WHEN &quot;Distinct Products (avg)&quot; THEN &quot;Distinct Products(avg)&quot;&#10;WHEN &quot;Vendors&quot; THEN &quot;Vendor Count&quot;&#10;WHEN &quot;Rank Normalised avg&quot; THEN &quot;Rank Normalised avg&quot;&#10;END' />
      </column>
      <column caption='Order count per Session' datatype='real' name='[Calculation_1604196323869147137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([count_orders_in_session])/COUNTD([perseus_session_id])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='_category_product_ranking_experiment' datatype='table' name='[__tableau_internal_object_id__].[_category_product_ranking_experiment_A4955F7E34E14C05842D5AFD161AFA3D]' role='measure' type='quantitative' />
