      <aliases enabled='yes' />
      <column caption='Avg. Distance (KM)' datatype='real' name='[Avg. Delivery Time (m) (copy)_2167005490378227718]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_distance])/(sum([delivery_id_count]) *1000)' />
      </column>
      <column caption='Avg. No. of Riders' datatype='real' name='[Avg. Distance (KM) (copy)_2167005490378964999]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([delivery_id_count])/sum([count_orders])' />
      </column>
      <column caption='Avg. CPO' datatype='real' name='[CPO (copy)_2167005490376003589]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2167005490366021633]/[count_orders]' />
      </column>
      <column caption='Date' datatype='date' datatype-customized='true' name='[Calculation_2070178096545873920]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1],[created_date],&apos;monday&apos;))' />
      </column>
      <column caption='CPO' datatype='real' name='[Calculation_2070178096546537474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_2167005490366021633])/SUM([count_orders])' />
      </column>
      <column caption='Delivery Costs' datatype='real' name='[Calculation_2167005490366021633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Date Granularity (copy)_2167005490365669376] = &apos;Euro&apos; THEN [delivery_costs_eur]&#10;ELSEIF [Parameters].[Date Granularity (copy)_2167005490365669376] = &apos;Local Currency&apos; &#10;THEN [delivery_costs_lc]&#10;END' />
      </column>
      <column caption='Avg. Delivery Time (m)' datatype='real' name='[Calculation_2167005490372747267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_delivery_time])/(sum([delivery_id_count]) *60)' />
      </column>
      <column caption='Stacking %' datatype='real' name='[Calculation_2167005490379866120]' role='measure' type='quantitative'>
