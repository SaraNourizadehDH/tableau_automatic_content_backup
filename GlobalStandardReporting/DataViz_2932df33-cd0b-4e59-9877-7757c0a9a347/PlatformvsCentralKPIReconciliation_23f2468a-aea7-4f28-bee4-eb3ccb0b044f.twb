              <tooltip column='[federated.0mn3kzs193c1tj141fn300kc95sk].[sum:successful_orders_central:qk]' />
              <tooltip column='[federated.0mn3kzs193c1tj141fn300kc95sk].[sum:successful_orders_platform:qk]' />
            </encodings>
