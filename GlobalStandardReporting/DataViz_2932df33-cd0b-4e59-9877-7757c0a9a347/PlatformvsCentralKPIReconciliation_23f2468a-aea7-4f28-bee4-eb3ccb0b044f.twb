      <column caption='Acquisitions Correctness' datatype='real' name='[Calculation_3478819608963043328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-ABS(SUM([acquisitions_central])-sum([acquisitions_platform]))/sum([acquisitions_platform])' />
      </column>
      <column caption='Successful Orders Correctness' datatype='real' name='[Calculation_3478819608963379201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-ABS(SUM([successful_orders_central])-SUM([successful_orders_platform]))/SUM([successful_orders_platform])' />
      </column>
