      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;  </run>
            <run fontsize='11'>(</run>
            <run bold='true' fontcolor='#454d59' fontsize='11'>Platform</run>
            <run fontsize='11'> vs </run>
            <run bold='true' fontcolor='#feae66' fontsize='11'>Central Order</run>
