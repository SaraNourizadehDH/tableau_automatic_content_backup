          <named-connection caption='BigQuery' name='bigquery.1gbpg8l1job7jz1f3nsd7013qad7'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh-looker' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='10' bq-large-fetch-rows='' bq-project-fetch-rows='2000' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='DataHub Production' schema='cl_govops' server-oauth='' username='alistair.hart@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
