            <run fontsize='11'> actuals)</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/PlatformvsCentralKPIReconciliation/OrderKPIsActuals?rev=' id='OrderKPIsActuals' path='/t/GlobalStandardReporting/workbooks/PlatformvsCentralKPIReconciliation' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='800' maxwidth='1440' minheight='800' minwidth='1440' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Platform vs Central Order KPIs' name='federated.0mn3kzs193c1tj141fn300kc95sk' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Entity Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
          <calculation class='tableau' formula='&quot;Management Entity&quot;' />
          <members>
            <member value='&quot;DH Platform&quot;' />
            <member value='&quot;Sub-Entity&quot;' />
            <member value='&quot;Management Entity&quot;' />
          </members>
