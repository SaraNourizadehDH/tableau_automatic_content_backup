      <datasource-dependencies datasource='Parameters'>
        <column caption='Entity Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
          <calculation class='tableau' formula='&quot;Management Entity&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_D041D877D57B490A82F7A119965D1A75'>
            <properties context=''>
              <relation connection='bigquery.1gbpg8l1job7jz1f3nsd7013qad7' name='Custom SQL Query' type='text'><![CDATA[WITH central_orders AS 
(
SELECT
  o.global_entity_id,
  DATE(placed_at_local) as order_date,
  COUNT(*) as successful_orders,
  COUNT(CASE WHEN o.is_acquisition THEN 1 ELSE NULL END) as acquisitions,
  SUM(o.value.gmv_eur) as gmv_eur,
  SUM(o.value.gbv_eur) as gbv_eur,
  SUM(o.value.delivery_fee_eur) as delivery_fee_eur,
  SUM(o.value.service_fee_eur) as service_fee_eur,
  SUM(COALESCE(o.value.discount_dh_eur,0) + COALESCE(o.value.voucher_dh_eur,0) + COALESCE(o.value.discount_other_eur,0) + COALESCE(o.value.voucher_other_eur,0) + COALESCE(o.value.joker_customer_discount_eur,0)) as incentives_total_eur,
  SUM(COALESCE(o.value.discount_dh_eur,0) + COALESCE(o.value.voucher_dh_eur,0)) as incentives_dh_funded_total_eur
FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o 
JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` g USING (global_entity_id)
WHERE o.is_sent
AND o.placed_at_local >>= '2023-01-01'
AND o.placed_at_local << CURRENT_DATE
AND g.management_entity IN ('Talabat', 'Foodpanda APAC', 'DH Europe', 'Foodpanda Germany', 'Pedidosya')
GROUP BY 1,2
),
central_incentives AS
(
SELECT
  o.global_entity_id,
  DATE(placed_at_local) as order_date,
  SUM(cit.incentive_applied.amount / x.fx_rate_eur) as incentives_total_eur_cit,
  SUM(cit.incentive_applied.amount * COALESCE(sponsorship_ratio.value,0) / x.fx_rate_eur) as incentives_dh_funded_total_eur_ci_sr,
  SUM(sponsorship.amount / x.fx_rate_eur) as incentives_dh_funded_total_eur_cit_s
FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.orders` o 
JOIN `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` x ON x.currency_code = o.currency_code AND x.fx_rate_date = DATE(o.placed_at_local) 
JOIN `fulfillment-dwh-production.curated_data_shared_data_stream.customer_incentive_transactions` cit on cit.global_entity_id = o.global_entity_id AND cit.order_id = o.order_id AND cit.created_date >>= '2023-01-01'
  LEFT JOIN UNNEST (cit.incentive_applied.sponsorship) as sponsorship on sponsorship.party = 'platform'
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_data_stream.customer_incentives` ci on ci.global_entity_id = cit.global_entity_id AND ci.customer_incentive_id = cit.customer_incentive_id
  LEFT JOIN UNNEST (ci.sponsorship_ratios) as sponsorship_ratio on sponsorship_ratio.party = 'platform'
JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` g ON o.global_entity_id = g.global_entity_id
WHERE o.is_sent
AND o.placed_at_local >>= '2023-01-01'
AND o.placed_at_local << CURRENT_DATE
AND g.management_entity IN ('Talabat', 'Foodpanda APAC', 'DH Europe', 'Foodpanda Germany', 'Pedidosya')
GROUP BY 1,2
),
platform_orders AS
(
SELECT 
  p.global_entity_id,
  DATE(p.placed_at_local) as order_date,
  COUNT(*) as successful_orders,
  COUNT(CASE WHEN p.is_acquisition THEN 1 ELSE NULL END) as acquisitions,
  SUM(p.gmv_lc / x.fx_rate_eur) as gmv_eur,
  SUM(p.gbv_lc / x.fx_rate_eur) as gbv_eur,
  SUM(p.delivery_fee_lc / x.fx_rate_eur) as delivery_fee_eur,
  SUM(p.service_fee_lc / x.fx_rate_eur) as service_fee_eur,
  SUM(p.incentives_total_lc / x.fx_rate_eur) as incentives_total_eur,
  SUM(p.incentives_dh_funded_total_lc / x.fx_rate_eur) as incentives_dh_funded_total_eur
FROM `fulfillment-dwh-production.cl_govops.platform_orders` p 
JOIN `fulfillment-dwh-production.curated_data_shared_coredata.fx_rates` x ON x.currency_code = p.currency_code AND x.fx_rate_date = DATE(p.placed_at_local) 
WHERE p.is_successful
AND p.partition_date >>= '2023-01-01'
AND p.partition_date << CURRENT_DATE
GROUP BY 1,2
)
SELECT
  p.global_entity_id,
  g.management_entity,
  g.sub_entity,
  p.order_date,
  p.successful_orders as successful_orders_platform,
  c.successful_orders as successful_orders_central,
  p.acquisitions as acquisitions_platform,
  c.acquisitions as acquisitions_central,
  p.gmv_eur as gmv_eur_platform,
  c.gmv_eur as gmv_eur_central,
  p.gbv_eur as gbv_eur_platform,
  c.gbv_eur as gbv_eur_central,
  p.delivery_fee_eur as delivery_fee_eur_platform,
  c.delivery_fee_eur as delivery_fee_eur_central,
  p.service_fee_eur as service_fee_eur_platform,
  c.service_fee_eur as service_fee_eur_central,
  p.incentives_total_eur as incentives_total_eur_platform,
  c.incentives_total_eur as incentives_total_eur_central,
  i.incentives_total_eur_cit,
  p.incentives_dh_funded_total_eur as incentives_dh_funded_total_eur_platform,
  c.incentives_dh_funded_total_eur as incentives_dh_funded_total_eur_central,
  i.incentives_dh_funded_total_eur_ci_sr,
  i.incentives_dh_funded_total_eur_cit_s
FROM platform_orders p
LEFT JOIN central_orders c USING (global_entity_id, order_date)
LEFT JOIN central_incentives i USING (global_entity_id, order_date)
JOIN `fulfillment-dwh-production.curated_data_shared_coredata.global_entities` g USING (global_entity_id)]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <shared-views>
    <shared-view name='federated.0mn3kzs193c1tj141fn300kc95sk'>
