      <column caption='Date is in last 2 weeks?' datatype='boolean' name='[Calculation_3478819609337221136]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_date] &gt; DATEADD(&quot;day&quot;, -15, TODAY()) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='User Filter' datatype='string' name='[Calculation_578149619609022465]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(USERNAME(), &apos;talabat.com&apos;) THEN &quot;Talabat&quot; &#10;ELSEIF CONTAINS(USERNAME(), &apos;pedidosya.com&apos;) THEN &quot;Pedidosya&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;hungerstation.com&apos;) THEN &quot;HungerStation&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;e-food.gr&apos;) THEN &quot;eFood&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;foody.com&apos;) THEN &quot;eFood&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;woowahan.com&apos;) THEN &quot;Woowa&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;foodpanda&apos;) THEN &quot;Pandora&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;foodora&apos;) THEN &quot;Pandora&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;yemeksepeti&apos;) THEN &quot;Pandora&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;deliveryhero.at&apos;) THEN &quot;Pandora&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;deliveryhero.fi&apos;) THEN &quot;Pandora&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;damejidlo&apos;) THEN &quot;Pandora&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;trycarriage&apos;) THEN &quot;Carriage&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;deliveryhero.com&apos;) THEN &quot;all&quot;&#10;ELSEIF USERNAME() = &quot;carlos.jaime&quot; THEN &quot;Pedidosya&quot;&#10;ELSEIF (ISMEMBEROF(&apos;gsr_performance_enduser&apos;) OR ISMEMBEROF(&apos;gsr_performance_developer&apos;)) AND NOT CONTAINS(USERNAME(), &apos;@&apos;) THEN &quot;all&quot;&#10;END' />
      </column>
      <column caption='User Filter pt 2' datatype='boolean' name='[Calculation_578149619609149442]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Management Entity (group)] = [Calculation_578149619609022465] THEN TRUE &#10;ELSEIF [Calculation_578149619609022465] = &quot;all&quot; THEN TRUE&#10;ELSE FALSE END' />
      </column>
      <column caption='Entity' datatype='string' name='[Calculation_6771443524415926273]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;DH Platform&quot; THEN [Management Entity (group)]&#10;    WHEN &quot;Sub-Entity&quot; THEN [sub_entity]&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#10;END' />
      </column>
      <column caption='Date is today' datatype='boolean' name='[Date is in last 2 weeks? (copy)_6771443524419723266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_date] = TODAY() THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='DH Platform' datatype='string' name='[Management Entity (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[management_entity]' new-bin='true'>
          <bin default-name='false' value='&quot;Pandora&quot;'>
            <value>&quot;DH Europe&quot;</value>
            <value>&quot;Foodpanda APAC&quot;</value>
            <value>&quot;Foodpanda Germany&quot;</value>
          </bin>
        </calculation>
      </column>
