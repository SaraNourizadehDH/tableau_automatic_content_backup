    <worksheet name='Successful Orders'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Platform vs Central Order KPIs' name='federated.0mn3kzs193c1tj141fn300kc95sk' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Entity Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0mn3kzs193c1tj141fn300kc95sk'>
            <column caption='Successful Orders Diff' datatype='integer' name='[Calculation_3478819608966717443]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_platform]) - SUM([successful_orders_central])' />
            </column>
            <column caption='Date is in last 2 weeks?' datatype='boolean' name='[Calculation_3478819609337221136]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [order_date] &gt; DATEADD(&quot;day&quot;, -15, TODAY()) THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='User Filter' datatype='string' name='[Calculation_578149619609022465]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS(USERNAME(), &apos;talabat.com&apos;) THEN &quot;Talabat&quot; &#10;ELSEIF CONTAINS(USERNAME(), &apos;pedidosya.com&apos;) THEN &quot;Pedidosya&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;hungerstation.com&apos;) THEN &quot;HungerStation&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;e-food.gr&apos;) THEN &quot;eFood&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;foody.com&apos;) THEN &quot;eFood&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;woowahan.com&apos;) THEN &quot;Woowa&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;foodpanda&apos;) THEN &quot;Pandora&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;foodora&apos;) THEN &quot;Pandora&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;yemeksepeti&apos;) THEN &quot;Pandora&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;deliveryhero.at&apos;) THEN &quot;Pandora&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;deliveryhero.fi&apos;) THEN &quot;Pandora&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;damejidlo&apos;) THEN &quot;Pandora&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;trycarriage&apos;) THEN &quot;Carriage&quot;&#10;ELSEIF CONTAINS(USERNAME(), &apos;deliveryhero.com&apos;) THEN &quot;all&quot;&#10;ELSEIF USERNAME() = &quot;carlos.jaime&quot; THEN &quot;Pedidosya&quot;&#10;ELSEIF (ISMEMBEROF(&apos;gsr_performance_enduser&apos;) OR ISMEMBEROF(&apos;gsr_performance_developer&apos;)) AND NOT CONTAINS(USERNAME(), &apos;@&apos;) THEN &quot;all&quot;&#10;END' />
            </column>
            <column caption='User Filter pt 2' datatype='boolean' name='[Calculation_578149619609149442]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Management Entity (group)] = [Calculation_578149619609022465] THEN TRUE &#10;ELSEIF [Calculation_578149619609022465] = &quot;all&quot; THEN TRUE&#10;ELSE FALSE END' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_6771443524415926273]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;DH Platform&quot; THEN [Management Entity (group)]&#10;    WHEN &quot;Sub-Entity&quot; THEN [sub_entity]&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#10;END' />
            </column>
            <column caption='Date is today' datatype='boolean' name='[Date is in last 2 weeks? (copy)_6771443524419723266]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [order_date] = TODAY() THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='DH Platform' datatype='string' name='[Management Entity (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[management_entity]' new-bin='true'>
                <bin default-name='false' value='&quot;Pandora&quot;'>
                  <value>&quot;DH Europe&quot;</value>
                  <value>&quot;Foodpanda APAC&quot;</value>
                  <value>&quot;Foodpanda Germany&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3478819609337221136]' derivation='None' name='[none:Calculation_3478819609337221136:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_578149619609149442]' derivation='None' name='[none:Calculation_578149619609149442:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_6771443524415926273]' derivation='None' name='[none:Calculation_6771443524415926273:nk]' pivot='key' type='nominal' />
            <column-instance column='[Date is in last 2 weeks? (copy)_6771443524419723266]' derivation='None' name='[none:Date is in last 2 weeks? (copy)_6771443524419723266:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[sub_entity]' derivation='None' name='[none:sub_entity:nk]' pivot='key' type='nominal' />
            <column caption='Order Date' datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column caption='Sub-Entity' datatype='string' name='[sub_entity]' role='dimension' type='nominal' />
            <column caption='Successful Orders Central' datatype='integer' name='[successful_orders_central]' role='measure' type='quantitative' />
            <column caption='Successful Orders Platform' datatype='integer' name='[successful_orders_platform]' role='measure' type='quantitative' />
            <column-instance column='[successful_orders_central]' derivation='Sum' name='[sum:successful_orders_central:qk]' pivot='key' type='quantitative' />
            <column-instance column='[successful_orders_platform]' derivation='Sum' name='[sum:successful_orders_platform:qk]' pivot='key' type='quantitative' />
            <column-instance column='[order_date]' derivation='Day-Trunc' name='[tdy:order_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3478819608966717443]' derivation='User' name='[usr:Calculation_3478819608966717443:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0mn3kzs193c1tj141fn300kc95sk].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0mn3kzs193c1tj141fn300kc95sk].[sum:successful_orders_central:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0mn3kzs193c1tj141fn300kc95sk].[sum:successful_orders_platform:qk]&quot;' />
            </groupfilter>
          </filter>
          <slices>
