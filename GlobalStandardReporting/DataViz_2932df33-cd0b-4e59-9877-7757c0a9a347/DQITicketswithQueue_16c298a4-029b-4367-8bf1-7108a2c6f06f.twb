    <worksheet name='Open Tickets Open Time Producers'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='14'>Average Lifecycle Days</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='DQI Table' name='federated.0qbrtkd1ch5fgv13z079r02ms0xc' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Grouping' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qbrtkd1ch5fgv13z079r02ms0xc'>
            <column caption='COUNTD Ticket Keys Last' datatype='integer' name='[COUNTD Ticket Keys (copy)_215046916811264008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [order_of_events_DESC] = 1 THEN [Ticket_Key]&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='Issue Date Parametered' datatype='date' datatype-customized='true' name='[Calculation_1242993547044073482]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 1] = &apos;Day&apos;&#13;&#10;THEN DATETRUNC(&apos;day&apos;, [date])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos;&#13;&#10;THEN DATETRUNC(&apos;week&apos;, [date],&apos;monday&apos;)&#13;&#10;ELSE DATETRUNC(&apos;month&apos;, [date])&#13;&#10;END)' />
            </column>
            <column caption='Is DataStream' datatype='string' name='[Calculation_1298444117040934912]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Data_Producer] IN (&quot;perseus&quot;, &quot;perseus_sdk&quot;, &quot;perseus_curation&quot;, &quot;perseus_global&quot;,&#13;&#10; &quot;perseus_pandora&quot;, &quot;perseus_peya&quot;, &quot;perseus_hungerstation&quot;,&#13;&#10; &quot;perseus_talabat&quot;, &quot;perseus_instashop&quot;, &quot;perseus_efood&quot;, &quot;perseus_woowa_korea&quot;) THEN &apos;Perseus&apos;&#13;&#10;&#13;&#10;ELSEIF CONTAINS( [table_id], &quot;curated_data_shared_data_stream&quot;) THEN &apos;DataStreams&apos; &#13;&#10;&#13;&#10;Else &apos;DataHub&apos; End' />
            </column>
            <column caption='Is Automatic' datatype='boolean' name='[Calculation_1361213034350088192]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [reporter] = &quot;DataStreams Notifier&quot; THEN TRUE Else FALSE END' />
            </column>
            <column caption='Avg Ticket Lifecycle Days' datatype='real' name='[Calculation_215046916843970570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [order_of_events_DESC] = 1&#13;&#10;    THEN&#13;&#10;        [Minutes_Open] / 1440 // Minutes to Days&#13;&#10;END&#13;&#10;    ) &#13;&#10;&#13;&#10;/[COUNTD Ticket Keys (copy)_215046916811264008]' />
            </column>
            <column datatype='string' name='[Data Producers]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Data_Producer]' new-bin='true'>
                <bin default-name='false' value='&quot;CDP&quot;'>
                  <value>&quot;cdp&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Core Data&quot;'>
                  <value>&quot;central_dwh&quot;</value>
                  <value>&quot;coredata&quot;</value>
                  <value>&quot;dwh&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Core Data Tracking&quot;'>
                  <value>&quot;perseus_curation&quot;</value>
                  <value>&quot;perseus_curation,platform_bug,platform_perseus,platform_sd&quot;</value>
                  <value>&quot;perseus_curation,platform_bug,platform_perseus,platform_sd,sla_reminder&quot;</value>
                  <value>&quot;perseus_curation,platform_feature_request,platform_perseus,platform_sd&quot;</value>
                  <value>&quot;Product_Analytics&quot;</value>
