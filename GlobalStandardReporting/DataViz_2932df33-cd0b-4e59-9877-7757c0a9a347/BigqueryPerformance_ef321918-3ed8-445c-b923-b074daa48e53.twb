      <aliases enabled='yes' />
      <column caption='17, 18 Jan' datatype='boolean' name='[24, 25 Jan (copy)_4567635249790558213]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([created_date] = DATEPARSE(&quot;YYYY-MM-DD&quot;, &quot;2022-01-17&quot;)&#10;OR [created_date] = DATEPARSE(&quot;YYYY-MM-DD&quot;, &quot;2022-01-18&quot;), TRUE, FALSE)' />
      </column>
      <column caption='Weighted Average Duration (s)' datatype='real' name='[Calculation_4188629193167949825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_duration_secs])/SUM([num_jobs])' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_4188629193169801218]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;project_id&quot; THEN [project_id]&#10;    WHEN &quot;has_reserved_slots&quot; THEN STR([has_reserved_slots])&#10;    WHEN &quot;is_cached&quot; THEN STR([is_cached])&#10;END' />
      </column>
      <column caption='Today' datatype='boolean' name='[Calculation_4567635249364361219]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[created_date] = TODAY()' />
      </column>
      <column caption='24, 25 Jan' datatype='boolean' name='[Calculation_4567635249789558788]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([created_date] = DATEPARSE(&quot;YYYY-MM-DD&quot;, &quot;2022-01-24&quot;)&#10;OR [created_date] = DATEPARSE(&quot;YYYY-MM-DD&quot;, &quot;2022-01-25&quot;), TRUE, FALSE)' />
      </column>
      <column caption='Query Growth' datatype='real' name='[Calculation_4567635249790697478]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([Calculation_4567635249789558788] = TRUE, [num_jobs], 0))&#10;/&#10;SUM(IIF([24, 25 Jan (copy)_4567635249790558213] = TRUE, [num_jobs], 0))-1' />
      </column>
      <column caption='24, 25 Jobs' datatype='integer' name='[Calculation_4567635249791365127]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([Calculation_4567635249789558788] = TRUE, [num_jobs], 0))' />
      </column>
      <column caption='Total Slot Days' datatype='real' name='[Calculation_5318469751796006912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_slot_ms]) / (24 * 60 * 60 * 1000)' />
      </column>
      <column caption='Total Slot Days Reserved' datatype='real' name='[Calculation_8077839299158097922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [has_reserved_slots] = TRUE THEN [total_slot_ms] END)&#10;/ (24 * 60 * 60 * 1000)' />
      </column>
      <column caption='% of Slots Reserved' datatype='real' name='[Calculation_8077839299158929412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_8077839299158097922] / [Calculation_5318469751796006912]' />
      </column>
      <column caption='Total Slot Days On-Demand' datatype='real' name='[Total Slot Days Reserved (copy)_8077839299158614019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [has_reserved_slots] = FALSE THEN [total_slot_ms] END)&#10;/ (24 * 60 * 60 * 1000)' />
      </column>
      <column caption='Weighted Average Slots' datatype='real' name='[Weighted Average Duration (s) (copy)_4567635249358864384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_avg_slots])/SUM([num_jobs])' />
      </column>
