      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_587A7DC7AF9F41218AD357C2B280D0D6'>
            <properties context=''>
              <relation connection='bigquery.1gm0oop1r8mcrp1cwdh0i0wok5ju' name='Custom SQL Query' type='text'>SELECT 
  b.project_id,
  r.name as reservation_project_name,
  b.created_date,
  SUM(r.slotMs) as slot_ms,
  SUM(r.slotMs) / SUM(b.total_slot_ms) as percentage_slots
FROM `fulfillment-dwh-production.curated_data_shared_psf.billing_bigquery` b
JOIN UNNEST (b.reservation_usage) r
WHERE created_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR), MONTH)
AND b.has_reserved_slots is true
GROUP BY 1,2,3</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
