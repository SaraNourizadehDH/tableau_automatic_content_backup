          <named-connection caption='BigQuery' name='bigquery.0h52hgi0cvmmhz13f2i111qfhbc9'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh-looker' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='10' bq-large-fetch-rows='' bq-project-fetch-rows='2000' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='DataHub Production' schema='curated_data_shared_gcs' server-oauth='' username='alistair.hart@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0h52hgi0cvmmhz13f2i111qfhbc9' name='Custom SQL Query' type='text'>SELECT 
    b.project_id,
    b.is_cached,
    b.has_reserved_slots,
    b.created_date,
    COUNT(*) as num_jobs, 
    SUM(duration) as total_duration_secs,
    SUM(b.average_slots_used) as total_avg_slots,
    SUM(b.cost_usd) as total_cost_usd, 
    SUM(b.total_slot_ms) as total_slot_ms,
    SUM(b.total_billed_terabytes) as total_billed_terabytes	
FROM `fulfillment-dwh-production.curated_data_shared_psf.billing_bigquery` b
WHERE created_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR), MONTH)
GROUP BY 1,2,3,4</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0h52hgi0cvmmhz13f2i111qfhbc9' name='Custom SQL Query' type='text'>SELECT 
