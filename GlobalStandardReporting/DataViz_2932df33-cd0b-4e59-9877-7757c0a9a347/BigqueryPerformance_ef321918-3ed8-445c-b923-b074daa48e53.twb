      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_3F818B1101EB4795B3A652734B6A3C85'>
            <properties context=''>
              <relation connection='bigquery.0h52hgi0cvmmhz13f2i111qfhbc9' name='Custom SQL Query' type='text'>SELECT 
    b.project_id,
    b.is_cached,
    b.has_reserved_slots,
    b.created_date,
    COUNT(*) as num_jobs, 
    SUM(duration) as total_duration_secs,
    SUM(b.average_slots_used) as total_avg_slots,
    SUM(b.cost_usd) as total_cost_usd, 
    SUM(b.total_slot_ms) as total_slot_ms,
    SUM(b.total_billed_terabytes) as total_billed_terabytes	
FROM `fulfillment-dwh-production.curated_data_shared_psf.billing_bigquery` b
WHERE created_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR), MONTH)
GROUP BY 1,2,3,4</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Bigquery Billing Reservations (curated_data_shared_psf)' inline='true' name='federated.0vo25te1he3jv413iaade1cvefqm' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1gm0oop1r8mcrp1cwdh0i0wok5ju'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh-looker' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='10' bq-large-fetch-rows='' bq-project-fetch-rows='2000' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='DataHub Production' schema='curated_data_filtered_gcs' server-oauth='' username='alistair.hart@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1gm0oop1r8mcrp1cwdh0i0wok5ju' name='Custom SQL Query' type='text'>SELECT 
  b.project_id,
  r.name as reservation_project_name,
  b.created_date,
  SUM(r.slotMs) as slot_ms,
  SUM(r.slotMs) / SUM(b.total_slot_ms) as percentage_slots
FROM `fulfillment-dwh-production.curated_data_shared_psf.billing_bigquery` b
JOIN UNNEST (b.reservation_usage) r
WHERE created_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR), MONTH)
AND b.has_reserved_slots is true
GROUP BY 1,2,3</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1gm0oop1r8mcrp1cwdh0i0wok5ju' name='Custom SQL Query' type='text'>SELECT 
  b.project_id,
  r.name as reservation_project_name,
  b.created_date,
  SUM(r.slotMs) as slot_ms,
  SUM(r.slotMs) / SUM(b.total_slot_ms) as percentage_slots
FROM `fulfillment-dwh-production.curated_data_shared_psf.billing_bigquery` b
JOIN UNNEST (b.reservation_usage) r
WHERE created_date &gt;&gt;= DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 YEAR), MONTH)
AND b.has_reserved_slots is true
GROUP BY 1,2,3</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
