            <zone fixed-size='122' friendly-name='Data Freshness Container' h='11667' id='11' is-fixed='true' param='vert' type-v2='layout-flow' w='8472' x='8578' y='1000'>
              <zone alt-text='Data Freshness Icon' fixed-size='57' friendly-name='Data Freshness Icon' h='7666' id='12' is-fixed='true' is-scaled='1' param='Image/image (1) 1.png' type-v2='bitmap' w='8472' x='8578' y='1000'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
