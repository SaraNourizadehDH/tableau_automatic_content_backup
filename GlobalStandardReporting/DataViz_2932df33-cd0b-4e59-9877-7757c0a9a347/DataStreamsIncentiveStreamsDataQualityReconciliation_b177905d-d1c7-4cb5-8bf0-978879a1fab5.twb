    <worksheet name='Incentive KPIs Correctness WS'>
      <table>
        <view>
          <datasources>
            <datasource caption='Transactions Agg Data' name='federated.1ojujxh0t68b4211zx17s1i2x2h2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Entity Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ojujxh0t68b4211zx17s1i2x2h2'>
            <column caption='Neutral Date Max' datatype='date' name='[Calculation_1156017774982324224]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX([neutral_placed_date])}' />
            </column>
            <column caption='Incentive Amount Diff' datatype='real' name='[Calculation_1392456748754214912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([entities_incentive_amount_eur]) - SUM([streams_incentive_amount_eur])' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_6771443524415926273]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &quot;DH Platform&quot; THEN [dh_platform]&#10;    WHEN &quot;Sub-Entity&quot; THEN [sub_entity]&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#10;END' />
            </column>
            <column caption='Limit Report Data to' datatype='string' name='[Copy Streams Placed Date (copy)_345651316743082016]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [neutral_placed_date] &gt; DATEADD(&quot;day&quot;, -15, [Calculation_1156017774982324224]) AND [neutral_placed_date] &lt; DATEADD(&quot;day&quot;, -1, [Calculation_1156017774982324224])&#13;&#10;THEN &quot;Last 14 complete days&quot;&#13;&#10;ELSEIF [neutral_placed_date] = [Calculation_1156017774982324224] THEN &quot;Latest report date&quot;&#13;&#10;ELSE &quot;Other days&quot;&#13;&#10;END' />
            </column>
            <column caption='Incentive Amount Vendor Funded Diff' datatype='real' name='[Incentive Amount DH Funded Diff (copy)_1392456748759056388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([entities_incentive_vendor_funded_amount_eur]) - SUM([streams_incentive_vendor_funded_amount_eur])' />
            </column>
            <column caption='Incentive Amount DH Funded Diff' datatype='real' name='[Incentive Amount Diff (copy)_1392456748755673089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([entities_incentive_dh_funded_amount_eur]) - SUM([streams_incentive_dh_funded_amount_eur])' />
            </column>
            <column caption='Timestamp Amount Diff' datatype='integer' name='[Incentive Amount Diff (copy)_419960706004144129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([entities_count_placed_date_utc]) - SUM([streams_count_placed_date_utc])' />
            </column>
            <column caption='Incentive Amount 3Party Funded Diff' datatype='real' name='[Incentive Amount Vendor Funded Diff (copy)_1392456748760506374]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([entities_incentive_3party_funded_amount_eur]) - SUM([streams_incentive_3party_funded_amount_eur])' />
            </column>
            <column caption='Copy Streams Placed Date' datatype='date' name='[Streams Placed Date (copy)_1065945777282617344]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[neutral_placed_date]' />
            </column>
            <column caption='Total Incentive Amount Correctness' datatype='real' name='[Successful Orders Correctness (copy)_5667287550891479042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-ABS(SUM([streams_incentive_amount_eur])-SUM([entities_incentive_amount_eur]))/SUM([entities_incentive_amount_eur])' />
            </column>
            <column caption='Total Timestamps Correctness' datatype='real' name='[Total Incentive Amount (copy)_419960706000244736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-ABS(SUM([streams_count_placed_date_utc])-SUM([entities_count_placed_date_utc]))/SUM([entities_count_placed_date_utc])' />
            </column>
            <column caption='Total Incentive DH Funded Correctness' datatype='real' name='[Total Incentive Amount (copy)_967711007770365952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-ABS(SUM([streams_incentive_dh_funded_amount_eur])-SUM([entities_incentive_dh_funded_amount_eur]))/SUM([entities_incentive_dh_funded_amount_eur])' />
            </column>
            <column caption='Total Incentive Vendor Funded Correctness' datatype='real' name='[Total Incentive DH Funded (copy)_967711007770779649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-ABS(SUM([streams_incentive_vendor_funded_amount_eur])-SUM([entities_incentive_vendor_funded_amount_eur]))/SUM([entities_incentive_vendor_funded_amount_eur])' />
            </column>
            <column caption='Total Incentive 3Party Funded Correctness' datatype='real' name='[Total Incentive Vendor Funded (copy)_967711007771078658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-ABS(SUM([streams_incentive_3party_funded_amount_eur]-[entities_incentive_3party_funded_amount_eur]))/SUM([entities_incentive_3party_funded_amount_eur])' />
            </column>
            <column caption='Total Incentive Subscription Correctness' datatype='real' name='[Total Incentive Vendor Funded Correctness (copy)_345651316406779935]' role='measure' type='quantitative'>
