      <aliases enabled='yes' />
      <column caption='Neutral Date Max' datatype='date' name='[Calculation_1156017774982324224]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED : MAX([neutral_placed_date])}' />
      </column>
      <column caption='Incentive Amount Diff' datatype='real' name='[Calculation_1392456748754214912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([entities_incentive_amount_eur]) - SUM([streams_incentive_amount_eur])' />
      </column>
      <column caption='Month-1' datatype='boolean' name='[Calculation_2064407860762324993]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATETRUNC(&apos;month&apos;, [neutral_placed_date]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY())) THEN true ELSE false END' />
      </column>
      <column caption='Total Incentive DH Funded DS M-1' datatype='real' name='[Calculation_2064407860763213827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2064407860762324993] THEN [streams_incentive_dh_funded_amount_eur] END' />
      </column>
      <column caption='Total Incentive DH Funded Correctness MoM' datatype='real' name='[Calculation_2064407860765376521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Orders DS M-1 (copy)_2064407860764626951]-[Total Orders Correctness M-1 (copy)_2064407860764864520]' />
      </column>
      <column caption='Column Incentive Amount' datatype='integer' name='[Calculation_2064407861797715985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Month Name' datatype='string' name='[Calculation_2064407862161866846]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, TODAY()))' />
      </column>
      <column caption='Entity' datatype='string' name='[Calculation_6771443524415926273]' role='dimension' type='nominal'>
