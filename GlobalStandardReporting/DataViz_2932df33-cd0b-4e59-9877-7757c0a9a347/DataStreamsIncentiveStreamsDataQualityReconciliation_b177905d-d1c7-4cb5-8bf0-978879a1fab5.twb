          <zone fixed-size='105' friendly-name='Header Container' h='11667' id='9' is-fixed='true' param='horz' type-v2='layout-flow' w='98400' x='800' y='1000'>
            <zone alt-text='Link to slack channel for questions' fixed-size='112' friendly-name='Slack Button' h='11667' id='14' is-fixed='true' is-scaled='1' param='Image/Slack Button.png' type-v2='bitmap' url='https://deliveryhero.enterprise.slack.com/archives/C03FHFH1NLX' w='7778' x='800' y='1000'>
