            <column caption='Open Issues Minor/Low' datatype='integer' name='[Open Issues (copy 2)_215046916848046104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  &#13;&#10;        (NOT [Status_To] IN (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;))&#13;&#10;        AND &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;        AND ([Priority] = &quot;Minor&quot; OR [Priority] = &quot;Low&quot;)&#13;&#10;THEN [Ticket_Key] END)' />
            </column>
            <column caption='Open Issues High' datatype='integer' name='[Open Issues (copy) (copy 2)_215046916848054298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  &#13;&#10;        (NOT [Status_To] IN (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;))&#13;&#10;        AND &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;        AND [Priority] = &quot;High&quot;&#13;&#10;THEN [Ticket_Key] END)' />
            </column>
            <column caption='Open Issues Blocker' datatype='integer' name='[Open Issues (copy) (copy)_215046916848046105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  &#13;&#10;        (NOT [Status_To] IN (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;))&#13;&#10;        AND &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;        AND [Priority] = &quot;Blocker&quot;&#13;&#10;THEN [Ticket_Key] END)' />
            </column>
            <column caption='Open Issues Medium' datatype='integer' name='[Open Issues (copy)_215046916848025623]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  &#13;&#10;        (NOT [Status_To] IN (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;))&#13;&#10;        AND &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;        AND [Priority] = &quot;Medium&quot;&#13;&#10;THEN [Ticket_Key] END)' />
            </column>
