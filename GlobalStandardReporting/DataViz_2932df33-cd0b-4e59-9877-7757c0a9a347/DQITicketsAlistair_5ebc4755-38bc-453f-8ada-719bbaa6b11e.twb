    <worksheet name='Issues Table Producers'>
      <table>
        <view>
          <datasources>
            <datasource caption='JIRA tickets' name='federated.1rgqql315b9z6e1dli34h142gihg' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Grouping' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1rgqql315b9z6e1dli34h142gihg'>
            <column caption='% Days to First Response' datatype='real' name='[Avg Days to First Response (copy)_215046916856279075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_215046916845842446]&#13;&#10;&#13;&#10;/&#13;&#10;[Calculation_215046916843970570]' />
            </column>
            <column caption='% Progress Days ' datatype='real' name='[Avg Progress Days (copy)_215046916855742498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    (&#13;&#10;    SUM(&#13;&#10;        IF [order_of_events_DESC] =1 &#13;&#10;        THEN [Progress_Time] END&#13;&#10;            ) / 1440&#13;&#10;    )&#13;&#10;    /[COUNTD Ticket Keys (copy)_215046916811264008]&#13;&#10;)&#13;&#10;/[Calculation_215046916843970570]' />
            </column>
            <column caption='% Resolution Days ' datatype='real' name='[Avg Resolution Days (copy)_215046916854288416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Resolution Time (copy)_215046916812607497]&#13;&#10;/ [Calculation_215046916843970570]' />
            </column>
            <column caption='% Waiting on Customer Days' datatype='real' name='[Avg Waiting on Customer Days (copy)_215046916854984737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    (&#13;&#10;        SUM(&#13;&#10;            IF [order_of_events_DESC] =1 &#13;&#10;            THEN [Waiting_On_Customer_Time] END&#13;&#10;            )/(1440)&#13;&#10;    )&#13;&#10;    /[COUNTD Ticket Keys (copy)_215046916811264008]&#13;&#10;)&#13;&#10;/[Calculation_215046916843970570]' />
            </column>
            <column caption='COUNTD Ticket Keys Last' datatype='integer' name='[COUNTD Ticket Keys (copy)_215046916811264008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [order_of_events_DESC] = 1 THEN [Ticket_Key]&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='Created Issues' datatype='integer' datatype-customized='true' name='[Calculation_1242993547031945217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [order_of_events_ASC]= 1 THEN [Ticket_Key] END)&#13;&#10;&#13;&#10; //[From Status]= &quot;Created&quot; THEN [Ticket_Key] END)' />
            </column>
            <column caption='Closed Issues' datatype='integer' name='[Calculation_1242993547032330242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  &#13;&#10;        [Status_To] IN (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;)&#13;&#10;        AND &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;&#13;&#10;THEN [Ticket_Key] END)' />
            </column>
            <column caption='Issue Date Parametered' datatype='date' datatype-customized='true' name='[Calculation_1242993547044073482]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 1] = &apos;Day&apos;&#13;&#10;THEN DATETRUNC(&apos;day&apos;, [date])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos;&#13;&#10;THEN DATETRUNC(&apos;week&apos;, [date],&apos;monday&apos;)&#13;&#10;ELSE DATETRUNC(&apos;month&apos;, [date])&#13;&#10;END)' />
            </column>
            <column caption='Is DataStream' datatype='boolean' name='[Calculation_1298444117040934912]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS( [table_id], &quot;data_stream&quot;) THEN TRUE Else False End' />
            </column>
            <column caption='Is Automatic' datatype='boolean' name='[Calculation_1361213034350088192]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [reporter] = &quot;DataStreams Notifier&quot; THEN TRUE Else FALSE END' />
            </column>
            <column caption='Avg Ticket Lifecycle Days' datatype='real' name='[Calculation_215046916843970570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [order_of_events_DESC] = 1&#13;&#10;    THEN&#13;&#10;        [Minutes_Open] / 1440 // Minutes to Days&#13;&#10;END&#13;&#10;    ) &#13;&#10;&#13;&#10;/[COUNTD Ticket Keys (copy)_215046916811264008]' />
            </column>
            <column caption='Avg Waiting on Customer Days' datatype='real' name='[Calculation_215046916845305868]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    SUM(&#13;&#10;        IF [order_of_events_DESC] =1 &#13;&#10;        THEN [Waiting_On_Customer_Time] END&#13;&#10;        )/(1440)&#13;&#10;)&#13;&#10;/[COUNTD Ticket Keys (copy)_215046916811264008]' />
            </column>
            <column caption='Avg Progress Days' datatype='real' name='[Calculation_215046916845596685]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM(&#13;&#10;    IF [order_of_events_DESC] =1 &#13;&#10;    THEN [Progress_Time] END&#13;&#10;        ) / 1440&#13;&#10;)&#13;&#10;/[COUNTD Ticket Keys (copy)_215046916811264008]' />
            </column>
            <column caption='Avg Days to First Response' datatype='real' name='[Calculation_215046916845842446]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [order_of_events_DESC] = 1&#13;&#10;    THEN&#13;&#10;        [Time_to_First_Response] / 1440 // Minutes to Days&#13;&#10;END&#13;&#10;    ) &#13;&#10;&#13;&#10;/[COUNTD Ticket Keys (copy)_215046916811264008]' />
            </column>
            <column caption='Closed Issues Minor/Low' datatype='integer' name='[Closed Issues (copy 2)_215046916847378452]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  &#13;&#10;        [Status_To] IN (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;)&#13;&#10;        AND &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;        AND ([Priority] = &quot;Minor&quot; OR [Priority] = &quot;Low&quot;)&#13;&#10;THEN [Ticket_Key] END)' />
            </column>
            <column caption='Open Issues' datatype='integer' name='[Closed Issues (copy 2)_817403366315143170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  &#13;&#10;        (NOT [Status_To] IN (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;))&#13;&#10;        AND &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;&#13;&#10;THEN [Ticket_Key] END)' />
            </column>
            <column caption='Closed Issues Blocker' datatype='integer' name='[Closed Issues (copy) (copy) (copy)_215046916847386646]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  &#13;&#10;        [Status_To] IN (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;)&#13;&#10;        AND &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;        AND [Priority] = &quot;Blocker&quot;&#13;&#10;THEN [Ticket_Key] END)' />
            </column>
            <column caption='Closed Issues High' datatype='integer' name='[Closed Issues (copy) (copy)_215046916847378453]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  &#13;&#10;        [Status_To] IN (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;)&#13;&#10;        AND &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;        AND [Priority] = &quot;High&quot;&#13;&#10;THEN [Ticket_Key] END)' />
            </column>
            <column caption='Closed Issues Medium' datatype='integer' name='[Closed Issues (copy)_215046916847357971]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  &#13;&#10;        [Status_To] IN (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;)&#13;&#10;        AND &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;        AND [Priority] = &quot;Medium&quot;&#13;&#10;THEN [Ticket_Key] END)' />
            </column>
            <column caption='Closed Issues Automatic' datatype='integer' name='[Closed Issues (copy)_983192142397247489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  &#13;&#10;        [Status_To] IN (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;)&#13;&#10;        AND &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;        AND &#13;&#10;        [Calculation_1361213034350088192]&#13;&#10;&#13;&#10;THEN [Ticket_Key] END)' />
            </column>
            <column caption='Created Issues Medium' datatype='integer' datatype-customized='true' name='[Created Issues (copy) (copy 2)_215046916846104594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Status_From]= &quot;Created&quot; AND [Priority] = &quot;Medium&quot; THEN [Ticket_Key] END)' />
            </column>
            <column caption='Created Issues Blocker' datatype='integer' datatype-customized='true' name='[Created Issues (copy) (copy) (copy)_215046916846104593]' role='measure' type='quantitative'>
