_215046916854288416:qk] + ([federated.1rgqql315b9z6e1dli34h142gihg].[usr:Calculation_215046916845305868:qk] + ([federated.1rgqql315b9z6e1dli34h142gihg].[usr:Avg Waiting on Customer Days (copy)_215046916854984737:qk] + ([federated.1rgqql315b9z6e1dli34h142gihg].[usr:Calculation_215046916845596685:qk] + ([federated.1rgqql315b9z6e1dli34h142gihg].[usr:Avg Progress Days (copy)_215046916855742498:qk] + ([federated.1rgqql315b9z6e1dli34h142gihg].[usr:Calculation_215046916845842446:qk] + [federated.1rgqql315b9z6e1dli34h142gihg].[usr:Avg Days to First Response (copy)_215046916856279075:qk]))))))))))))))))))))))))))</rows>
