    <datasource caption='JIRA tickets' inline='true' name='federated.1rgqql315b9z6e1dli34h142gihg' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1rm7dh80teqj7616r2ina06ttmmy'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh-looker' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='10' bq-large-fetch-rows='' bq-project-fetch-rows='2000' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='DataHub Production' schema='acl' server='' server-oauth='server-custom' username='alistair.hart@deliveryhero.com' workgroup-auth-mode='as-is'>
              <connection-customization class='bigquery' enabled='false' version='18.1'>
                <vendor name='bigquery' />
                <driver name='bigquery' />
                <customizations>
                  <customization name='CAP_BIGQUERY_FORCE_SPOOL_JOB' value='no' />
                  <customization name='CAP_FAST_METADATA' value='no' />
                  <customization name='bq-fetch-tasks' value='10' />
                  <customization name='bq-project-fetch-rows' value='2000' />
                </customizations>
              </connection-customization>
            </connection>
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1rm7dh80teqj7616r2ina06ttmmy' name='Custom SQL Query' type='text'><![CDATA[With base as (
  WITH temp_base AS (
    SELECT DISTINCT
      Ticket_Key,
      DATE(Status_Changed_at) as date,
      Status_Changed_at,
      Status_From,
      Status_To,
      CASE WHEN resolution_to IS NOT NULL THEN resolution_to ELSE "No" END Resolution,
      CASE WHEN Status_to IN ('Closed', 'Done', 'Resolved', 'Canceled')
        AND resolution_to IS NOT NULL THEN 1
          ELSE 0 END AS Is_Resolved
    FROM `fulfillment-dwh-production.curated_data_shared_psf.jira_tickets_changelogs`
    WHERE Ticket_Key LIKE "DQI%"
  -- We Artificially Add a line for when the Ticket is Created -->>
  UNION ALL
    SELECT
        Ticket_key,
        DATE(created_at),
        created_at as created_timestamp,
        "Created" as Status_From,
        "Waiting for support" as Status_To,
        "No" as resolution,
        0 as is_resolved
    FROM `fulfillment-dwh-production.curated_data_shared_psf.jira_tickets`
    WHERE Ticket_key LIKE "DQI%"
    ORDER BY 1,3 ASC
    )

  SELECT 
    Ticket_Key,
    date,
    Status_Changed_at,
    Status_From,
    COALESCE(LEAD(Status_From) OVER (PARTITION BY Ticket_key ORDER BY Status_Changed_at),Status_To) AS Status_To,
    Resolution,
    Is_Resolved
    FROM temp_base

)
, details as (
  SELECT DISTINCT
        ticket_key,
        labels as data_producer,
        priority,
        reporter,
        COALESCE(comment_count,0) AS comment_count
  FROM `fulfillment-dwh-production.curated_data_shared_psf.jira_tickets` t
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_psf.jira_tickets_comments_count`
  USING(ticket_key)
    WHERE ticket_key LIKE 'DQI-%'
  ORDER BY 1
)
, base_details as (
  SELECT
    MIN(Status_Changed_at) OVER (PARTITION BY b.ticket_key) as created_at,
    MIN(date) OVER (PARTITION BY b.ticket_key) as created_date,
    b.ticket_key,
    data_producer,
    priority,
    reporter,
    date,
    Status_Changed_at,
    Status_From,
    Status_To,
    resolution,
    is_resolved,
    comment_count,
    TIMESTAMP_DIFF(Status_Changed_at,
                LAG(Status_Changed_at) OVER (PARTITION BY b.ticket_key ORDER BY Status_Changed_at ASC),
                MINUTE) as Minutes_From_Last_Change,

  CASE WHEN SUM(is_resolved) OVER (PARTITION BY b.ticket_key)>>0 THEN TRUE ELSE FALSE END as ticket_will_be_resolved ,
  ROW_NUMBER() OVER (PARTITION BY b.ticket_key ORDER BY Status_Changed_at DESC) as order_of_events_DESC,
  ROW_NUMBER() OVER (PARTITION BY b.ticket_key ORDER BY Status_Changed_at ASC) as order_of_events_ASC,
  FROM base as b
  LEFT JOIN details as d
    On b.ticket_key = d.ticket_key
  ORDER BY 1, 5 ASC
)
, first_response as (
  SELECT 
      ticket_key,
      CAST(CASE WHEN 
               REGEXP_EXTRACT(
                  REGEXP_EXTRACT(
                     REGEXP_EXTRACT(value, r'goalDuration(.*)$')
                     , r'elapsedTime(.*)$')
                        ,r'millis\': (.*)$') LIKE "%startTime%"
          THEN 
               REGEXP_EXTRACT(
                  REGEXP_EXTRACT(
                     REGEXP_EXTRACT(
                        REGEXP_EXTRACT(
                           REGEXP_EXTRACT(value, r'goalDuration(.*)$')
                           , r'goalDuration(.*)$')
                              , r'elapsedTime(.*)$')
                                 ,r'millis\': (.*)$')
                                    ,r'^(.+?),')
            ELSE
               REGEXP_EXTRACT(
                  REGEXP_EXTRACT(
                     REGEXP_EXTRACT(
                        REGEXP_EXTRACT(value, r'goalDuration(.*)$')
                        , r'elapsedTime(.*)$')
                           ,r'millis\': (.*)$')
                              ,r'^(.+?),')
               END as INT64) / 3600000 AS first_response_hours_jira,
      CAST(
            CASE WHEN 
               REGEXP_EXTRACT(value, r'goalDuration(.*)$') LIKE "%goalDuration%"
            THEN 
               REGEXP_EXTRACT(
                  REGEXP_EXTRACT(
                     REGEXP_EXTRACT(
                        REGEXP_EXTRACT(value, r'goalDuration(.*)$')
                        , r'goalDuration(.*)$')
                           , r'millis\': (.*)$')
                              , r'^(.+?),')            
            ELSE
               REGEXP_EXTRACT(
                  REGEXP_EXTRACT(
                     REGEXP_EXTRACT(value, r'goalDuration(.*)$')
                        ,r'millis\': (.*)$')
                           ,r'^(.+?),')
            END
         as INT64) / 3600000 AS first_response_hours_target_jira
    FROM `fulfillment-dwh-production.curated_data_shared_psf.jira_tickets_custom_fields` 
    LEFT JOIN UNNEST(custom_fields) as cf
    WHERE ticket_key LIKE "DQI%"
    AND cf.name = "Time to first response"
)
, resolution_time as (
  SELECT 
      ticket_key,
      CAST ( 
         CASE WHEN 
               REGEXP_EXTRACT(
                  REGEXP_EXTRACT(
                     REGEXP_EXTRACT(value, r'goalDuration(.*)$')
                     , r'elapsedTime(.*)$')
                        ,r'millis\': (.*)$') LIKE "%startTime%"
         THEN 
            REGEXP_EXTRACT(
               REGEXP_EXTRACT(
                  REGEXP_EXTRACT(
                     REGEXP_EXTRACT(
                        REGEXP_EXTRACT(value, r'goalDuration(.*)$'),
                        r'goalDuration(.*)$'),
                           r'elapsedTime(.*)$'),
                              r'millis\': (.*)$'),
                                 r'^(.+?),') 
         ELSE
            REGEXP_EXTRACT(
               REGEXP_EXTRACT(
                  REGEXP_EXTRACT(
                     REGEXP_EXTRACT(value, r'goalDuration(.*)$'),
                        r'elapsedTime(.*)$'),
                           r'millis\': (.*)$'),
                              r'^(.+?),') 
         END as INT64 ) / 3600000 AS resolution_hours_jira,

      CAST(
         CASE WHEN 
            REGEXP_EXTRACT(value, r'goalDuration(.*)$') LIKE "goalDuration"
         THEN 
            REGEXP_EXTRACT(
               REGEXP_EXTRACT(
                  REGEXP_EXTRACT(
                     REGEXP_EXTRACT(value, r'goalDuration(.*)$'),
                        r'goalDuration(.*)$'),
                           r'millis\': (.*)$'),
                              r'^(.+?),')         
         ELSE
            REGEXP_EXTRACT(
               REGEXP_EXTRACT(
                  REGEXP_EXTRACT(value, r'goalDuration(.*)$'),
                     r'millis\': (.*)$'),
                        r'^(.+?),')
         END
        as INT64) / 3600000 AS resolution_hours_target_jira
    FROM `fulfillment-dwh-production.curated_data_shared_psf.jira_tickets_custom_fields` 
    LEFT JOIN UNNEST(custom_fields) as cf
    WHERE ticket_key LIKE "DQI%"
    AND cf.name = "Time to resolution"
)
, tables_id as (
    With tickets as (
    SELECT ticket_key 
    FROM `fulfillment-dwh-production.curated_data_shared_psf.jira_tickets` 
    WHERE ticket_key LIKE "DQI%" 
  )
  , tables as (
    SELECT
      ticket_key,
      custom_fields.value
    FROM `fulfillment-dwh-production.curated_data_shared_psf.jira_tickets_custom_fields`
    LEFT JOIN UNNEST(custom_fields) as custom_fields
    WHERE ticket_key LIKE "DQI%"
    AND custom_fields.name = "Datahub Table ID"
  )

  SELECT
    t.ticket_key,
    CASE WHEN value IS NOT NULL THEN value ElSE "No Table" END as table_id
  FROM tickets as t
  LEFT JOIN tables
    USING(ticket_key)
)
, dates as (
  SELECT
    ISO_date
  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.dates`
  WHERE ISO_date >>= (SELECT MIN(date) FROM base)
  AND ISO_date <<= (SELECT MAX(date) FROM base)
)

SELECT
  created_at,
  created_date,
  ISO_date as date,
  bd.Ticket_Key ,
  Data_Producer,
  Priority,
  reporter,
  Status_Changed_at,
  Status_From,
  Status_To,
  Resolution,
  Is_Resolved,
  comment_count,
  COALESCE(Minutes_From_Last_Change,0) AS Minutes_From_Last_Change,
  Ticket_Will_Be_Resolved,
  order_of_events_DESC,
  order_of_events_ASC,
  first_response_hours_jira,
  first_response_hours_target_jira,
  resolution_hours_jira,
  resolution_hours_target_jira,
  table_id,


  CASE WHEN 
        Status_To IN ("Done", "Resolved","Canceled","Closed")
        AND 
        order_of_events_DESC = 1
        AND DATE_TRUNC(date,MONTH) = DATE_SUB(DATE_TRUNC(CURRENT_DATE(),MONTH), INTERVAL 1 Month)  
        THEN True Else False END AS Is_Closed_Last_Month,
  COALESCE(
    SUM(
      Minutes_From_Last_Change)
      OVER (PARTITION BY bd.ticket_key)
    ,TIMESTAMP_DIFF(CURRENT_TIMESTAMP(),Status_Changed_at,MINUTE)) 
  AS Minutes_Open,

  COALESCE(
    SUM(
      CASE WHEN Status_From != "Waiting for customer" THEN Minutes_From_Last_Change END)
      OVER (PARTITION BY bd.ticket_key)
    ,TIMESTAMP_DIFF(CURRENT_TIMESTAMP(),Status_Changed_at,MINUTE)) 
    AS Resolution_Time,

  COALESCE(
    TIMESTAMP_DIFF(
    MIN(
      CASE WHEN Status_To IN ("Waiting for customer", "In Progress","Done", "Canceled", "Work in Progress", "Resolved", "Waiting for dependencies", "Closed") THEN Status_Changed_at END)
      OVER (PARTITION BY bd.ticket_key),created_at, MINUTE)
    ,0)
    as  Time_to_First_Response,

  COALESCE(
    SUM(
      CASE WHEN Status_From = "Waiting for customer" THEN Minutes_From_Last_Change END)
      OVER (PARTITION BY bd.ticket_key)
    ,0)
    AS Waiting_On_Customer_Time,

  COALESCE(
    SUM(
      CASE WHEN Status_From IN ("Waiting for support","In Progress","Work in Progress") THEN Minutes_From_Last_Change END)
      OVER (PARTITION BY bd.ticket_key) 
    ,0)
    AS Progress_Time

FROM  dates
LEFT JOIN base_details bd
  ON ISO_date = date
LEFT JOIN first_response
  USING(ticket_key)
LEFT JOIN resolution_time
  USING(ticket_key)
LEFT JOIN tables_id
  USING (ticket_key)
order by 3 desc, order_of_events_ASC]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1rm7dh80teqj7616r2ina06ttmmy' name='Custom SQL Query' type='text'><![CDATA[With base as (
  WITH temp_base AS (
    SELECT DISTINCT
      Ticket_Key,
      DATE(Status_Changed_at) as date,
      Status_Changed_at,
      Status_From,
      Status_To,
      CASE WHEN resolution_to IS NOT NULL THEN resolution_to ELSE "No" END Resolution,
      CASE WHEN Status_to IN ('Closed', 'Done', 'Resolved', 'Canceled')
        AND resolution_to IS NOT NULL THEN 1
          ELSE 0 END AS Is_Resolved
    FROM `fulfillment-dwh-production.curated_data_shared_psf.jira_tickets_changelogs`
    WHERE Ticket_Key LIKE "DQI%"
  -- We Artificially Add a line for when the Ticket is Created -->>
  UNION ALL
    SELECT
        Ticket_key,
        DATE(created_at),
        created_at as created_timestamp,
        "Created" as Status_From,
        "Waiting for support" as Status_To,
        "No" as resolution,
        0 as is_resolved
    FROM `fulfillment-dwh-production.curated_data_shared_psf.jira_tickets`
    WHERE Ticket_key LIKE "DQI%"
    ORDER BY 1,3 ASC
    )

  SELECT 
    Ticket_Key,
    date,
    Status_Changed_at,
    Status_From,
    COALESCE(LEAD(Status_From) OVER (PARTITION BY Ticket_key ORDER BY Status_Changed_at),Status_To) AS Status_To,
    Resolution,
    Is_Resolved
    FROM temp_base

)
, details as (
  SELECT DISTINCT
        ticket_key,
        labels as data_producer,
        priority,
        reporter,
        COALESCE(comment_count,0) AS comment_count
  FROM `fulfillment-dwh-production.curated_data_shared_psf.jira_tickets` t
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_psf.jira_tickets_comments_count`
  USING(ticket_key)
    WHERE ticket_key LIKE 'DQI-%'
  ORDER BY 1
)
, base_details as (
  SELECT
    MIN(Status_Changed_at) OVER (PARTITION BY b.ticket_key) as created_at,
    MIN(date) OVER (PARTITION BY b.ticket_key) as created_date,
    b.ticket_key,
    data_producer,
    priority,
    reporter,
    date,
    Status_Changed_at,
    Status_From,
    Status_To,
    resolution,
    is_resolved,
    comment_count,
    TIMESTAMP_DIFF(Status_Changed_at,
                LAG(Status_Changed_at) OVER (PARTITION BY b.ticket_key ORDER BY Status_Changed_at ASC),
                MINUTE) as Minutes_From_Last_Change,

  CASE WHEN SUM(is_resolved) OVER (PARTITION BY b.ticket_key)>>0 THEN TRUE ELSE FALSE END as ticket_will_be_resolved ,
  ROW_NUMBER() OVER (PARTITION BY b.ticket_key ORDER BY Status_Changed_at DESC) as order_of_events_DESC,
  ROW_NUMBER() OVER (PARTITION BY b.ticket_key ORDER BY Status_Changed_at ASC) as order_of_events_ASC,
  FROM base as b
  LEFT JOIN details as d
    On b.ticket_key = d.ticket_key
  ORDER BY 1, 5 ASC
)
, first_response as (
  SELECT 
      ticket_key,
      CAST(CASE WHEN 
               REGEXP_EXTRACT(
                  REGEXP_EXTRACT(
                     REGEXP_EXTRACT(value, r'goalDuration(.*)$')
                     , r'elapsedTime(.*)$')
                        ,r'millis\': (.*)$') LIKE "%startTime%"
          THEN 
               REGEXP_EXTRACT(
                  REGEXP_EXTRACT(
                     REGEXP_EXTRACT(
                        REGEXP_EXTRACT(
                           REGEXP_EXTRACT(value, r'goalDuration(.*)$')
                           , r'goalDuration(.*)$')
                              , r'elapsedTime(.*)$')
                                 ,r'millis\': (.*)$')
                                    ,r'^(.+?),')
            ELSE
               REGEXP_EXTRACT(
                  REGEXP_EXTRACT(
                     REGEXP_EXTRACT(
                        REGEXP_EXTRACT(value, r'goalDuration(.*)$')
                        , r'elapsedTime(.*)$')
                           ,r'millis\': (.*)$')
                              ,r'^(.+?),')
               END as INT64) / 3600000 AS first_response_hours_jira,
      CAST(
            CASE WHEN 
               REGEXP_EXTRACT(value, r'goalDuration(.*)$') LIKE "%goalDuration%"
            THEN 
               REGEXP_EXTRACT(
                  REGEXP_EXTRACT(
                     REGEXP_EXTRACT(
                        REGEXP_EXTRACT(value, r'goalDuration(.*)$')
                        , r'goalDuration(.*)$')
                           , r'millis\': (.*)$')
                              , r'^(.+?),')            
            ELSE
               REGEXP_EXTRACT(
                  REGEXP_EXTRACT(
                     REGEXP_EXTRACT(value, r'goalDuration(.*)$')
                        ,r'millis\': (.*)$')
                           ,r'^(.+?),')
            END
         as INT64) / 3600000 AS first_response_hours_target_jira
    FROM `fulfillment-dwh-production.curated_data_shared_psf.jira_tickets_custom_fields` 
    LEFT JOIN UNNEST(custom_fields) as cf
    WHERE ticket_key LIKE "DQI%"
    AND cf.name = "Time to first response"
)
, resolution_time as (
  SELECT 
      ticket_key,
      CAST ( 
         CASE WHEN 
               REGEXP_EXTRACT(
                  REGEXP_EXTRACT(
                     REGEXP_EXTRACT(value, r'goalDuration(.*)$')
                     , r'elapsedTime(.*)$')
                        ,r'millis\': (.*)$') LIKE "%startTime%"
         THEN 
            REGEXP_EXTRACT(
               REGEXP_EXTRACT(
                  REGEXP_EXTRACT(
                     REGEXP_EXTRACT(
                        REGEXP_EXTRACT(value, r'goalDuration(.*)$'),
                        r'goalDuration(.*)$'),
                           r'elapsedTime(.*)$'),
                              r'millis\': (.*)$'),
                                 r'^(.+?),') 
         ELSE
            REGEXP_EXTRACT(
               REGEXP_EXTRACT(
                  REGEXP_EXTRACT(
                     REGEXP_EXTRACT(value, r'goalDuration(.*)$'),
                        r'elapsedTime(.*)$'),
                           r'millis\': (.*)$'),
                              r'^(.+?),') 
         END as INT64 ) / 3600000 AS resolution_hours_jira,

      CAST(
         CASE WHEN 
            REGEXP_EXTRACT(value, r'goalDuration(.*)$') LIKE "goalDuration"
         THEN 
            REGEXP_EXTRACT(
               REGEXP_EXTRACT(
                  REGEXP_EXTRACT(
                     REGEXP_EXTRACT(value, r'goalDuration(.*)$'),
                        r'goalDuration(.*)$'),
                           r'millis\': (.*)$'),
                              r'^(.+?),')         
         ELSE
            REGEXP_EXTRACT(
               REGEXP_EXTRACT(
                  REGEXP_EXTRACT(value, r'goalDuration(.*)$'),
                     r'millis\': (.*)$'),
                        r'^(.+?),')
         END
        as INT64) / 3600000 AS resolution_hours_target_jira
    FROM `fulfillment-dwh-production.curated_data_shared_psf.jira_tickets_custom_fields` 
    LEFT JOIN UNNEST(custom_fields) as cf
    WHERE ticket_key LIKE "DQI%"
    AND cf.name = "Time to resolution"
)
, tables_id as (
    With tickets as (
    SELECT ticket_key 
    FROM `fulfillment-dwh-production.curated_data_shared_psf.jira_tickets` 
    WHERE ticket_key LIKE "DQI%" 
  )
  , tables as (
    SELECT
      ticket_key,
      custom_fields.value
    FROM `fulfillment-dwh-production.curated_data_shared_psf.jira_tickets_custom_fields`
    LEFT JOIN UNNEST(custom_fields) as custom_fields
    WHERE ticket_key LIKE "DQI%"
    AND custom_fields.name = "Datahub Table ID"
  )

  SELECT
    t.ticket_key,
    CASE WHEN value IS NOT NULL THEN value ElSE "No Table" END as table_id
  FROM tickets as t
  LEFT JOIN tables
    USING(ticket_key)
)
, dates as (
  SELECT
    ISO_date
  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.dates`
  WHERE ISO_date >>= (SELECT MIN(date) FROM base)
  AND ISO_date <<= (SELECT MAX(date) FROM base)
)

SELECT
  created_at,
  created_date,
  ISO_date as date,
  bd.Ticket_Key ,
  Data_Producer,
  Priority,
  reporter,
  Status_Changed_at,
  Status_From,
  Status_To,
  Resolution,
  Is_Resolved,
  comment_count,
  COALESCE(Minutes_From_Last_Change,0) AS Minutes_From_Last_Change,
  Ticket_Will_Be_Resolved,
  order_of_events_DESC,
  order_of_events_ASC,
  first_response_hours_jira,
  first_response_hours_target_jira,
  resolution_hours_jira,
  resolution_hours_target_jira,
  table_id,


  CASE WHEN 
        Status_To IN ("Done", "Resolved","Canceled","Closed")
        AND 
        order_of_events_DESC = 1
        AND DATE_TRUNC(date,MONTH) = DATE_SUB(DATE_TRUNC(CURRENT_DATE(),MONTH), INTERVAL 1 Month)  
        THEN True Else False END AS Is_Closed_Last_Month,
  COALESCE(
    SUM(
      Minutes_From_Last_Change)
      OVER (PARTITION BY bd.ticket_key)
    ,TIMESTAMP_DIFF(CURRENT_TIMESTAMP(),Status_Changed_at,MINUTE)) 
  AS Minutes_Open,

  COALESCE(
    SUM(
      CASE WHEN Status_From != "Waiting for customer" THEN Minutes_From_Last_Change END)
      OVER (PARTITION BY bd.ticket_key)
    ,TIMESTAMP_DIFF(CURRENT_TIMESTAMP(),Status_Changed_at,MINUTE)) 
    AS Resolution_Time,

  COALESCE(
    TIMESTAMP_DIFF(
    MIN(
      CASE WHEN Status_To IN ("Waiting for customer", "In Progress","Done", "Canceled", "Work in Progress", "Resolved", "Waiting for dependencies", "Closed") THEN Status_Changed_at END)
      OVER (PARTITION BY bd.ticket_key),created_at, MINUTE)
    ,0)
    as  Time_to_First_Response,

  COALESCE(
    SUM(
      CASE WHEN Status_From = "Waiting for customer" THEN Minutes_From_Last_Change END)
      OVER (PARTITION BY bd.ticket_key)
    ,0)
    AS Waiting_On_Customer_Time,

  COALESCE(
    SUM(
      CASE WHEN Status_From IN ("Waiting for support","In Progress","Work in Progress") THEN Minutes_From_Last_Change END)
      OVER (PARTITION BY bd.ticket_key) 
    ,0)
    AS Progress_Time

FROM  dates
LEFT JOIN base_details bd
  ON ISO_date = date
LEFT JOIN first_response
  USING(ticket_key)
LEFT JOIN resolution_time
  USING(ticket_key)
LEFT JOIN tables_id
  USING (ticket_key)
order by 3 desc, order_of_events_ASC]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
