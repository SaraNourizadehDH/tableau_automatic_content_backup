    <worksheet name='Issues Timeseries'>
      <table>
        <view>
          <datasources>
            <datasource caption='DQI Table' name='federated.0qbrtkd1ch5fgv13z079r02ms0xc' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Grouping' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qbrtkd1ch5fgv13z079r02ms0xc'>
            <column caption='Days to Resolution' datatype='real' name='[Average Age of Open Tickets (copy)_1335598814417649664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  &#13;&#10;        [order_of_events_ASC] = 1&#13;&#10;        AND Ticket_Will_Be_Resolved = True&#13;&#10;    THEN&#13;&#10;        Resolution_Time / 1440 // Minutes to Days&#13;&#10;END' />
            </column>
            <column caption='Unworkable Days' datatype='real' name='[Avg Waiting on Customer Days (copy)_1335598814438948874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [order_of_events_ASC] =1 &#13;&#10;    THEN [Waiting_On_Customer_Time] /(1440) // Minutes to Days&#13;&#10;END' />
            </column>
            <column caption='Is Completed Date' datatype='boolean' name='[Calculation_1173750704585510912]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Month&quot; THEN &#13;&#10;    &#13;&#10;    DATETRUNC(&apos;month&apos;,[Calculation_1242993547044073482]) &lt;  DATETRUNC(&apos;month&apos;,TODAY())&#13;&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Week&quot; THEN &#13;&#10;    &#13;&#10;    DATETRUNC(&apos;week&apos;,[Calculation_1242993547044073482]) &lt;  DATETRUNC(&apos;week&apos;,TODAY())&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Day&quot; THEN &#13;&#10;    &#13;&#10;    DATETRUNC(&apos;day&apos;,[Calculation_1242993547044073482]) &lt;  DATETRUNC(&apos;day&apos;,TODAY())&#13;&#10;END' />
            </column>
            <column caption='Created Tickets' datatype='integer' datatype-customized='true' name='[Calculation_1242993547031945217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [order_of_events_ASC]= 1 THEN [Ticket_Key] END)&#13;&#10;&#13;&#10; //[From Status]= &quot;Created&quot; THEN [Ticket_Key] END)' />
            </column>
            <column caption='Closed Tickets' datatype='integer' name='[Calculation_1242993547032330242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  &#13;&#10;        [Status_To] IN (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;)&#13;&#10;        AND &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;&#13;&#10;THEN [Ticket_Key] END)' />
            </column>
            <column caption='Issue Date Parametered' datatype='date' datatype-customized='true' name='[Calculation_1242993547044073482]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 1] = &apos;Day&apos;&#13;&#10;THEN DATETRUNC(&apos;day&apos;, [date])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos;&#13;&#10;THEN DATETRUNC(&apos;week&apos;, [date],&apos;monday&apos;)&#13;&#10;ELSE DATETRUNC(&apos;month&apos;, [date])&#13;&#10;END)' />
            </column>
            <column caption='Source' datatype='string' name='[Calculation_1298444117040934912]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Data_Producer] IN (&quot;perseus&quot;, &quot;perseus_sdk&quot;, &quot;perseus_curation&quot;, &quot;perseus_global&quot;,&#13;&#10; &quot;perseus_pandora&quot;, &quot;perseus_peya&quot;, &quot;perseus_hungerstation&quot;,&#13;&#10; &quot;perseus_talabat&quot;, &quot;perseus_instashop&quot;, &quot;perseus_efood&quot;, &quot;perseus_woowa_korea&quot;) THEN &apos;Perseus&apos;&#13;&#10;&#13;&#10;ELSEIF CONTAINS( [table_id], &quot;curated_data_shared_data_stream&quot;) THEN &apos;DataStreams&apos; &#13;&#10;&#13;&#10;Else &apos;DataHub&apos; End' />
            </column>
            <column caption='Resolution Rate' datatype='real' name='[Calculation_1335598814429650949]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [order_of_events_ASC] = 1 AND [Ticket_Will_Be_Resolved] = True&#13;&#10;THEN [Ticket_Key] END&#13;&#10;&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD(IF [order_of_events_ASC] = 1&#13;&#10;THEN [Ticket_Key] END)' />
            </column>
            <column caption='Status Changes' datatype='integer' name='[Calculation_1335598814431698950]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [order_of_events_ASC] != 1 &#13;&#10;    THEN [Ticket_Key] END&#13;&#10;)' />
            </column>
            <column caption='Blank Line 1' datatype='real' datatype-customized='true' name='[Calculation_1335598814436380679]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='FLOAT(NULL)' />
            </column>
            <column caption='Tables Affected' datatype='integer' name='[Calculation_1335598814438404105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [order_of_events_ASC] = 1 &#13;&#10;    THEN [table_id]END&#13;&#10;)' />
            </column>
            <column caption='Days to First Status Change' datatype='real' name='[Calculation_1335598814440689675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [order_of_events_ASC] = 1&#13;&#10;THEN [Time_to_First_Response]/ (1440) // Minutes to Days&#13;&#10;END' />
            </column>
            <column caption='Is Automatic' datatype='boolean' name='[Calculation_1361213034350088192]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [reporter] = &quot;DataStreams Notifier&quot; THEN TRUE Else FALSE END' />
            </column>
            <column caption='Left Open Tickets' datatype='integer' name='[Closed Issues (copy 2)_817403366315143170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  &#13;&#10;        (NOT [Status_To] IN (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;))&#13;&#10;        AND &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;&#13;&#10;THEN [Ticket_Key] END)' />
            </column>
            <column caption='Labels' datatype='string' name='[Data_Producer]' role='dimension' type='nominal' />
            <column datatype='string' name='[Priority]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Resolution_Time]' role='measure' type='quantitative' />
            <column caption='Status To' datatype='string' name='[Status_To]' role='dimension' type='nominal' />
            <column caption='Key' datatype='string' name='[Ticket_Key]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[Ticket_Will_Be_Resolved]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Time_to_First_Response]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Waiting_On_Customer_Time]' role='measure' type='quantitative' />
            <column-instance column='[Avg Waiting on Customer Days (copy)_1335598814438948874]' derivation='Avg' name='[avg:Avg Waiting on Customer Days (copy)_1335598814438948874:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1335598814436380679]' derivation='Avg' name='[avg:Calculation_1335598814436380679:qk]' pivot='key' type='quantitative' />
            <column caption='Comments' datatype='integer' name='[comment_count]' role='measure' type='quantitative' />
