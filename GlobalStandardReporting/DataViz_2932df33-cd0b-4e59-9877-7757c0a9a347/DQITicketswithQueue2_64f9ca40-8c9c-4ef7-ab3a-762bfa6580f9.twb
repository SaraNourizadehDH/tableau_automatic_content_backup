      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='shape' field='[none:Definition:nk]' type='shape'>
            <map to='asterisk'>
              <bucket>&quot;The accumulative through time of the measure &apos;Left Open Tickets&apos;.&quot;</bucket>
            </map>
            <map to='circle'>
              <bucket>&quot;A Jira DQI ticket that was created.&quot;</bucket>
            </map>
            <map to='circle'>
              <bucket>&quot;The number of status changes that occured in a date.&quot;</bucket>
            </map>
            <map to='diamond'>
              <bucket>&quot;The average number of days a ticket was in \&quot;Waiting for Customer\&quot; or the ticket was resolved before being re-opened.&quot;</bucket>
            </map>
            <map to='down-triangle'>
              <bucket>&quot;The median number of days it took for a ticket to be resolved. It does not count time spent in \&quot;Waiting for Customer\&quot; or time it took to re-open a ticket.&quot;</bucket>
            </map>
            <map to='left-triangle'>
              <bucket>&quot;The number of comments submitted.&quot;</bucket>
            </map>
            <map to='plus'>
              <bucket>&quot;A Jira DQI ticket whose last satus is either \&quot;Canceled\&quot;,\&quot;Closed\&quot;,\&quot;Done\&quot; or \&quot;Resolved\&quot;.&quot;</bucket>
            </map>
            <map to='plus'>
              <bucket>&quot;The percentage of tickets closed of the created tickects.&quot;</bucket>
            </map>
            <map to='right-triangle'>
              <bucket>&quot;The number of distinct tables being affected by the tickets.&quot;</bucket>
            </map>
            <map to='square'>
              <bucket>%null%</bucket>
            </map>
            <map to='square'>
              <bucket>&quot;The numbers of tickets which are still open and whose last status change ocurred on the specified date.&quot;</bucket>
            </map>
            <map to='times'>
              <bucket>&quot;A Jira DQI ticket whose last status is not \&quot;Canceled\&quot;,\&quot;Closed\&quot;,\&quot;Done\&quot; or \&quot;Resolved\&quot;.&quot;</bucket>
            </map>
            <map to='triangle'>
              <bucket>&quot;The median number of days it took a ticket to change status for the first time.&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
