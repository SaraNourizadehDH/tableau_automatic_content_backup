            <column caption='Divider Bar' datatype='string' name='[Divider Line (copy)_1335598814516019216]' param-domain-type='list' role='measure' type='nominal' value='&quot; None&quot;'>
              <calculation class='tableau' formula='&quot; None&quot;' />
            </column>
            <column caption='Bar Measure' datatype='string' name='[Line Measure (copy)_1335598814452621325]' param-domain-type='list' role='measure' type='nominal' value='&quot;Created Tickets&quot;'>
              <calculation class='tableau' formula='&quot;Created Tickets&quot;' />
            </column>
            <column caption='Divider Line' datatype='string' name='[Open Age Buckets (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot; None&quot;'>
              <calculation class='tableau' formula='&quot; None&quot;' />
            </column>
            <column caption='Date Grouping' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
            <column caption='Line Measure' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Resolution Rate&quot;'>
              <calculation class='tableau' formula='&quot;Resolution Rate&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qbrtkd1ch5fgv13z079r02ms0xc'>
            <column caption='Age of Open Tickets' datatype='real' name='[Average Age of Open Tickets (copy)_1052716462139359232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;        [order_of_events_DESC] = 1 AND [order_of_events_ASC]=1&#13;&#10;    THEN &#13;&#10;        [Resolution_Time]/1440&#13;&#10;    ELSEIF  &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;        AND NOT [Status_To]  in (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;, &quot;Waiting for customer&quot;)&#13;&#10;    THEN&#13;&#10;        (Resolution_Time + DATEDIFF(&apos;minute&apos;,[Status_Changed_at],NOW()))/1440&#13;&#10;     ELSEIF     &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;        AND NOT [Status_To]  in (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;)&#13;&#10;        AND  [Status_To]  in (&quot;Waiting for customer&quot;)&#13;&#10;    THEN&#13;&#10;        (Resolution_Time/1440) &#13;&#10;END  // Minutes to Days' />
            </column>
            <column caption='Days to Resolution' datatype='real' name='[Average Age of Open Tickets (copy)_1335598814417649664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  &#13;&#10;        [order_of_events_ASC] = 1&#13;&#10;        AND Ticket_Will_Be_Resolved = True&#13;&#10;    THEN&#13;&#10;        Resolution_Time / 1440 // Minutes to Days&#13;&#10;END' />
            </column>
            <column caption='Unworkable Days' datatype='real' name='[Avg Waiting on Customer Days (copy)_1335598814438948874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [order_of_events_ASC] =1 &#13;&#10;    THEN [Waiting_On_Customer_Time] /(1440) // Minutes to Days&#13;&#10;END' />
            </column>
            <column caption='COUNTD Ticket Keys Last' datatype='integer' name='[COUNTD Ticket Keys (copy)_215046916811264008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [order_of_events_DESC] = 1 THEN [Ticket_Key]&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='Is Completed Date' datatype='boolean' name='[Calculation_1173750704585510912]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Month&quot; THEN &#13;&#10;    &#13;&#10;    DATETRUNC(&apos;month&apos;,[Calculation_1242993547044073482]) &lt;  DATETRUNC(&apos;month&apos;,TODAY())&#13;&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Week&quot; THEN &#13;&#10;    &#13;&#10;    DATETRUNC(&apos;week&apos;,[Calculation_1242993547044073482]) &lt;  DATETRUNC(&apos;week&apos;,TODAY())&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Day&quot; THEN &#13;&#10;    &#13;&#10;    DATETRUNC(&apos;day&apos;,[Calculation_1242993547044073482]) &lt;  DATETRUNC(&apos;day&apos;,TODAY())&#13;&#10;END' />
            </column>
            <column caption='Created Tickets' datatype='integer' datatype-customized='true' name='[Calculation_1242993547031945217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [order_of_events_ASC]= 1 THEN [Ticket_Key] END)&#13;&#10;&#13;&#10; //[From Status]= &quot;Created&quot; THEN [Ticket_Key] END)' />
            </column>
            <column caption='Closed Tickets' datatype='integer' name='[Calculation_1242993547032330242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  &#13;&#10;        [Status_To] IN (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;)&#13;&#10;        AND &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;&#13;&#10;THEN [Ticket_Key] END)' />
            </column>
            <column caption='Issue Date Parametered' datatype='date' datatype-customized='true' name='[Calculation_1242993547044073482]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 1] = &apos;Day&apos;&#13;&#10;THEN DATETRUNC(&apos;day&apos;, [date])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos;&#13;&#10;THEN DATETRUNC(&apos;week&apos;, [date],&apos;monday&apos;)&#13;&#10;ELSE DATETRUNC(&apos;month&apos;, [date])&#13;&#10;END)' />
            </column>
            <column caption='Source' datatype='string' name='[Calculation_1298444117040934912]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Data_Producer] IN (&quot;perseus&quot;, &quot;perseus_sdk&quot;, &quot;perseus_curation&quot;, &quot;perseus_global&quot;,&#13;&#10; &quot;perseus_pandora&quot;, &quot;perseus_peya&quot;, &quot;perseus_hungerstation&quot;,&#13;&#10; &quot;perseus_talabat&quot;, &quot;perseus_instashop&quot;, &quot;perseus_efood&quot;, &quot;perseus_woowa_korea&quot;) THEN &apos;Perseus&apos;&#13;&#10;&#13;&#10;ELSEIF CONTAINS( [table_id], &quot;curated_data_shared_data_stream&quot;) THEN &apos;DataStreams&apos; &#13;&#10;&#13;&#10;Else &apos;DataHub&apos; End' />
            </column>
            <column caption='Resolution Rate' datatype='real' name='[Calculation_1335598814429650949]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [order_of_events_ASC] = 1 AND [Ticket_Will_Be_Resolved] = True&#13;&#10;THEN [Ticket_Key] END&#13;&#10;&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD(IF [order_of_events_ASC] = 1&#13;&#10;THEN [Ticket_Key] END)' />
            </column>
            <column caption='Status Changes' datatype='integer' name='[Calculation_1335598814431698950]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [order_of_events_ASC] != 1 &#13;&#10;    THEN [Ticket_Key] END&#13;&#10;)' />
            </column>
            <column caption='Tables Affected' datatype='integer' name='[Calculation_1335598814438404105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [order_of_events_ASC] = 1 &#13;&#10;    THEN [table_id]END&#13;&#10;)' />
            </column>
            <column caption='Days to First Status Change' datatype='real' name='[Calculation_1335598814440689675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [order_of_events_ASC] = 1&#13;&#10;THEN [Time_to_First_Response]/ (1440) // Minutes to Days&#13;&#10;END' />
            </column>
            <column caption='Line measure CF' datatype='real' name='[Calculation_1335598814452056076]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &quot;Blank&quot; THEN NULL&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Avg Age of Open Tickets&quot; THEN AVG([Average Age of Open Tickets (copy)_1052716462139359232])&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Closed Issues&quot; THEN [Calculation_1242993547032330242]&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Created Tickets&quot; THEN [Calculation_1242993547031945217]&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Median Days to First Status Change&quot; THEN MEDIAN([Calculation_1335598814440689675])&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Median Days to Resolution&quot; THEN MEDIAN([Average Age of Open Tickets (copy)_1335598814417649664])&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Issues Left Open&quot; THEN [Closed Issues (copy 2)_817403366315143170]&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Nr of Comments&quot; THEN SUM([comment_count])&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Median Progress Days&quot; THEN [Calculation_215046916845596685]&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Resolution Rate&quot; THEN [Calculation_1335598814429650949]&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Status Changes&quot; THEN [Calculation_1335598814431698950]&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Tables Affected&quot; THEN [Calculation_1335598814438404105]&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Avg Unworkable Days&quot; THEN Avg([Avg Waiting on Customer Days (copy)_1335598814438948874])&#13;&#10;END' />
            </column>
            <column caption='Divider Line CF' datatype='string' name='[Calculation_1335598814461276175]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Open Age Buckets (copy)] = &quot;None&quot; THEN Null&#13;&#10;ELSEIF [Parameters].[Open Age Buckets (copy)] = &quot;Priority&quot; THEN [Priority]&#13;&#10;ELSEIF [Parameters].[Open Age Buckets (copy)] = &quot;Labels&quot; THEN [Data_Producer]&#13;&#10;ELSEIF [Parameters].[Open Age Buckets (copy)] = &quot;Is Automatic&quot; THEN &#13;&#10;    If [Calculation_1361213034350088192] Then &quot;True&quot; Else &quot;False&quot; END&#13;&#10;ELSEIF [Parameters].[Open Age Buckets (copy)] = &quot;Source&quot; THEN [Calculation_1298444117040934912]&#13;&#10;ELSEIF [Parameters].[Open Age Buckets (copy)] = &quot;Reporter&quot; THEN [reporter]&#13;&#10;ELSEIF [Parameters].[Open Age Buckets (copy)] = &quot;Table Id&quot; THEN [table_id]&#13;&#10;ELSEIF [Parameters].[Open Age Buckets (copy)] = &quot;Will be Resolved&quot; THEN &#13;&#10; If [Ticket_Will_Be_Resolved] Then &quot;True&quot; Else &quot;False&quot; END&#13;&#10;END' />
            </column>
            <column caption='Is Automatic' datatype='boolean' name='[Calculation_1361213034350088192]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [reporter] = &quot;DataStreams Notifier&quot; THEN TRUE Else FALSE END' />
            </column>
            <column caption='Avg Progress Days' datatype='real' name='[Calculation_215046916845596685]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;SUM(&#13;&#10;    IF [order_of_events_DESC] =1 &#13;&#10;    THEN [Progress_Time] END&#13;&#10;        ) / 1440&#13;&#10;)&#13;&#10;/[COUNTD Ticket Keys (copy)_215046916811264008]' />
            </column>
            <column caption='Left Open Tickets' datatype='integer' name='[Closed Issues (copy 2)_817403366315143170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  &#13;&#10;        (NOT [Status_To] IN (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;))&#13;&#10;        AND &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;&#13;&#10;THEN [Ticket_Key] END)' />
