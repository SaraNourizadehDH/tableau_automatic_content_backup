      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#00d9fc' fontname='Tableau Bold' fontsize='18'>| </run>
            <run fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
