            </column>
            <column caption='(ZN([Left Open Tickets]) - LOOKUP(ZN([Left Open Tickets]), -1...' datatype='real' name='[Calculation_908038327013855239]' role='measure' type='quantitative' user:unnamed='Left Open Tickets Change'>
              <calculation class='tableau' formula='(ZN([Closed Issues (copy 2)_817403366315143170]) - LOOKUP(ZN([Closed Issues (copy 2)_817403366315143170]), -1)) / ABS(LOOKUP(ZN([Closed Issues (copy 2)_817403366315143170]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Left Open Tickets' datatype='integer' name='[Closed Issues (copy 2)_817403366315143170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF  &#13;&#10;        (NOT [Status_To] IN (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;))&#13;&#10;        AND &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;&#13;&#10;THEN [Ticket_Key] END)' />
