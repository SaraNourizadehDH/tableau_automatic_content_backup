      <column caption='Queque Dimension Field' datatype='string' name='[Calculation_849491512337084418]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Date Grouping (copy)] = &quot;Labels&quot; THEN [Data_Producer]&#13;&#10;ELSEIF [Parameters].[Date Grouping (copy)] = &quot;Table Id&quot; THEN &#13;&#10;    if [table_id] != &apos;No Table&apos; THEN SPLIT(REPLACE(REPLACE([table_id],&apos;`&apos;,&apos;&apos;),&apos;:&apos;,&apos;.&apos;),&apos;.&apos;,3) ELSE  &apos;No Table&apos; END&#13;&#10;ELSEIF [Parameters].[Date Grouping (copy)] = &quot;Reporter&quot; THEN [reporter]&#13;&#10;ELSEIF [Parameters].[Date Grouping (copy)] = &quot;Priority&quot; THEN [Priority]&#13;&#10;END' />
      </column>
      <column caption='Table Filter Is Open' datatype='real' hidden='true' name='[Calculation_849491512376414212]' role='measure' type='quantitative'>
