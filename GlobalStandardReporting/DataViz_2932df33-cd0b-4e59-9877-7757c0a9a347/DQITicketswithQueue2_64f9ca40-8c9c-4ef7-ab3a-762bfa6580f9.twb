        <calculation class='tableau' formula='IF [SLA Dif (copy)_964896255892140035] &gt;= 0&#13;&#10;THEN &quot;Actual&gt;=Target&quot;&#13;&#10;ELSE &quot;Actual&lt;Target&quot;&#13;&#10;END' />
      </column>
      <column caption='SLA Dif' datatype='real' hidden='true' name='[Calculation_964896255881818112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([first_response_hours_target_jira])-[Avg Days to First Response (copy)_1071856747028316169]' />
      </column>
      <column caption='Left Open Tickets' datatype='integer' name='[Closed Issues (copy 2)_817403366315143170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF  &#13;&#10;        (NOT [Status_To] IN (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;))&#13;&#10;        AND &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;&#13;&#10;THEN [Ticket_Key] END)' />
      </column>
      <column caption='Closed Month' datatype='datetime' hidden='true' name='[Closed Issues (copy)_731553515756048384]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='IF  &#13;&#10;        [Status_To] IN (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;)&#13;&#10;        AND &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;&#13;&#10;THEN DATETRUNC(&apos;month&apos;,[date]) END' />
      </column>
      <column caption='Color SLA TTFR' datatype='string' hidden='true' name='[Color SLA   (copy)_94012678216892417]' role='measure' type='nominal'>
