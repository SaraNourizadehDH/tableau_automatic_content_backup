        <calculation class='tableau' formula='IF [Parameters].[Line Measure (copy)_1335598814452621325] = &quot;Blank&quot; THEN NULL&#13;&#10;ELSEIF [Parameters].[Line Measure (copy)_1335598814452621325] = &quot;Avg Age of Open Tickets&quot; THEN AVG([Average Age of Open Tickets (copy)_1052716462139359232])&#13;&#10;ELSEIF [Parameters].[Line Measure (copy)_1335598814452621325] = &quot;Closed Issues&quot; THEN [Calculation_1242993547032330242]&#13;&#10;ELSEIF [Parameters].[Line Measure (copy)_1335598814452621325] = &quot;Created Tickets&quot; THEN [Calculation_1242993547031945217]&#13;&#10;ELSEIF [Parameters].[Line Measure (copy)_1335598814452621325] = &quot;Median Days to First Status Change&quot; THEN MEDIAN([Calculation_1335598814440689675])&#13;&#10;ELSEIF [Parameters].[Line Measure (copy)_1335598814452621325] = &quot;Median Days to Resolution&quot; THEN MEDIAN([Average Age of Open Tickets (copy)_1335598814417649664])&#13;&#10;ELSEIF [Parameters].[Line Measure (copy)_1335598814452621325] = &quot;Issues Left Open&quot; THEN [Closed Issues (copy 2)_817403366315143170]&#13;&#10;ELSEIF [Parameters].[Line Measure (copy)_1335598814452621325] = &quot;Nr of Comments&quot; THEN SUM([comment_count])&#13;&#10;ELSEIF [Parameters].[Line Measure (copy)_1335598814452621325] = &quot;Median Progress Days&quot; THEN [Calculation_215046916845596685]&#13;&#10;ELSEIF [Parameters].[Line Measure (copy)_1335598814452621325] = &quot;Resolution Rate&quot; THEN [Calculation_1335598814429650949]&#13;&#10;ELSEIF [Parameters].[Line Measure (copy)_1335598814452621325] = &quot;Status Changes&quot; THEN [Calculation_1335598814431698950]&#13;&#10;ELSEIF [Parameters].[Line Measure (copy)_1335598814452621325] = &quot;Tables Affected&quot; THEN [Calculation_1335598814438404105]&#13;&#10;ELSEIF [Parameters].[Line Measure (copy)_1335598814452621325] = &quot;Avg Unworkable Days&quot; THEN Avg([Avg Waiting on Customer Days (copy)_1335598814438948874])&#13;&#10;END' />
