            <column caption='Divider Bar CF' datatype='string' name='[Divider Line CF (copy)_1335598814516060177]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Divider Line (copy)_1335598814516019216] = &quot;None&quot; THEN Null&#13;&#10;ELSEIF [Parameters].[Divider Line (copy)_1335598814516019216] = &quot;Priority&quot; THEN [Priority]&#13;&#10;ELSEIF [Parameters].[Divider Line (copy)_1335598814516019216] = &quot;Labels&quot; THEN [Data_Producer]&#13;&#10;ELSEIF [Parameters].[Divider Line (copy)_1335598814516019216] = &quot;Is Automatic&quot; THEN &#13;&#10;    If [Calculation_1361213034350088192] Then &quot;True&quot; Else &quot;False&quot; END&#13;&#10;ELSEIF [Parameters].[Divider Line (copy)_1335598814516019216] = &quot;Source&quot; THEN [Calculation_1298444117040934912]&#13;&#10;ELSEIF [Parameters].[Divider Line (copy)_1335598814516019216] = &quot;Reporter&quot; THEN [reporter]&#13;&#10;ELSEIF [Parameters].[Divider Line (copy)_1335598814516019216] = &quot;Table Id&quot; THEN [table_id]&#13;&#10;ELSEIF [Parameters].[Divider Line (copy)_1335598814516019216] = &quot;Will be Resolved&quot; THEN &#13;&#10; If [Ticket_Will_Be_Resolved] Then &quot;True&quot; Else &quot;False&quot; END&#13;&#10;END' />
