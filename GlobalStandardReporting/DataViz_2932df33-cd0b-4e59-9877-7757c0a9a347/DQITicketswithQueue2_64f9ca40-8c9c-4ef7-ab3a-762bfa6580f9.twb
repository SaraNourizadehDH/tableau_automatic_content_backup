      <column caption='Line measure CF' datatype='real' name='[Calculation_1335598814452056076]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &quot;Blank&quot; THEN NULL&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Avg Age of Open Tickets&quot; THEN AVG([Average Age of Open Tickets (copy)_1052716462139359232])&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Closed Issues&quot; THEN [Calculation_1242993547032330242]&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Created Tickets&quot; THEN [Calculation_1242993547031945217]&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Median Days to First Status Change&quot; THEN MEDIAN([Calculation_1335598814440689675])&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Median Days to Resolution&quot; THEN MEDIAN([Average Age of Open Tickets (copy)_1335598814417649664])&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Issues Left Open&quot; THEN [Closed Issues (copy 2)_817403366315143170]&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Nr of Comments&quot; THEN SUM([comment_count])&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Median Progress Days&quot; THEN [Calculation_215046916845596685]&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Resolution Rate&quot; THEN [Calculation_1335598814429650949]&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Status Changes&quot; THEN [Calculation_1335598814431698950]&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Tables Affected&quot; THEN [Calculation_1335598814438404105]&#13;&#10;ELSEIF [Parameters].[Parameter 4] = &quot;Avg Unworkable Days&quot; THEN Avg([Avg Waiting on Customer Days (copy)_1335598814438948874])&#13;&#10;END' />
      </column>
      <column caption='Divider Line CF' datatype='string' name='[Calculation_1335598814461276175]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Open Age Buckets (copy)] = &quot;None&quot; THEN Null&#13;&#10;ELSEIF [Parameters].[Open Age Buckets (copy)] = &quot;Priority&quot; THEN [Priority]&#13;&#10;ELSEIF [Parameters].[Open Age Buckets (copy)] = &quot;Labels&quot; THEN [Data_Producer]&#13;&#10;ELSEIF [Parameters].[Open Age Buckets (copy)] = &quot;Is Automatic&quot; THEN &#13;&#10;    If [Calculation_1361213034350088192] Then &quot;True&quot; Else &quot;False&quot; END&#13;&#10;ELSEIF [Parameters].[Open Age Buckets (copy)] = &quot;Source&quot; THEN [Calculation_1298444117040934912]&#13;&#10;ELSEIF [Parameters].[Open Age Buckets (copy)] = &quot;Reporter&quot; THEN [reporter]&#13;&#10;ELSEIF [Parameters].[Open Age Buckets (copy)] = &quot;Table Id&quot; THEN [table_id]&#13;&#10;ELSEIF [Parameters].[Open Age Buckets (copy)] = &quot;Will be Resolved&quot; THEN &#13;&#10; If [Ticket_Will_Be_Resolved] Then &quot;True&quot; Else &quot;False&quot; END&#13;&#10;END' />
      </column>
