            </column>
            <column caption='(ZN([Created Tickets]) - LOOKUP(ZN([Created Tickets]), -1)) /...' datatype='real' name='[Calculation_908038327007735809]' role='measure' type='quantitative' user:unnamed='Issues Change'>
              <calculation class='tableau' formula='(ZN([Calculation_1242993547031945217]) - LOOKUP(ZN([Calculation_1242993547031945217]), -1)) / ABS(LOOKUP(ZN([Calculation_1242993547031945217]), -1))'>
