    <dashboard name='Jira Tickets Tracking'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/DQITicketswithQueue2/JiraTicketsTracking?rev=' id='JiraTicketsTracking' path='/t/GlobalStandardReporting/workbooks/DQITicketswithQueue2' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_883' value='center' />
          <format attr='text-orientation' id='dash-text_883' value='0' />
        </style-rule>
      </style>
      <size maxheight='3500' maxwidth='1400' minheight='3500' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='DQI Table' name='federated.0qbrtkd1ch5fgv13z079r02ms0xc' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Date Grouping' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
          <calculation class='tableau' formula='&quot;Week&quot;' />
          <members>
            <member value='&quot;Day&quot;' />
            <member value='&quot;Week&quot;' />
            <member value='&quot;Month&quot;' />
          </members>
        </column>
        <column caption='Open Tickets Bar' datatype='string' name='[Priority Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Source&quot;'>
          <calculation class='tableau' formula='&quot;Source&quot;' />
          <members>
            <member value='&quot;Source&quot;' />
            <member value='&quot;Reporter&quot;' />
            <member value='&quot;Table&quot;' />
            <member value='&quot;Labels&quot;' />
            <member value='&quot;From Status&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0qbrtkd1ch5fgv13z079r02ms0xc'>
        <column caption='Is Completed Date' datatype='boolean' name='[Calculation_1173750704585510912]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Month&quot; THEN &#13;&#10;    &#13;&#10;    DATETRUNC(&apos;month&apos;,[Calculation_1242993547044073482]) &lt;  DATETRUNC(&apos;month&apos;,TODAY())&#13;&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Week&quot; THEN &#13;&#10;    &#13;&#10;    DATETRUNC(&apos;week&apos;,[Calculation_1242993547044073482]) &lt;  DATETRUNC(&apos;week&apos;,TODAY())&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Day&quot; THEN &#13;&#10;    &#13;&#10;    DATETRUNC(&apos;day&apos;,[Calculation_1242993547044073482]) &lt;  DATETRUNC(&apos;day&apos;,TODAY())&#13;&#10;END' />
        </column>
        <column caption='Issue Date Parametered' datatype='date' datatype-customized='true' name='[Calculation_1242993547044073482]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 1] = &apos;Day&apos;&#13;&#10;THEN DATETRUNC(&apos;day&apos;, [date])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos;&#13;&#10;THEN DATETRUNC(&apos;week&apos;, [date],&apos;monday&apos;)&#13;&#10;ELSE DATETRUNC(&apos;month&apos;, [date])&#13;&#10;END)' />
        </column>
        <column caption='Source' datatype='string' name='[Calculation_1298444117040934912]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [Data_Producer] IN (&quot;perseus&quot;, &quot;perseus_sdk&quot;, &quot;perseus_curation&quot;, &quot;perseus_global&quot;,&#13;&#10; &quot;perseus_pandora&quot;, &quot;perseus_peya&quot;, &quot;perseus_hungerstation&quot;,&#13;&#10; &quot;perseus_talabat&quot;, &quot;perseus_instashop&quot;, &quot;perseus_efood&quot;, &quot;perseus_woowa_korea&quot;) THEN &apos;Perseus&apos;&#13;&#10;&#13;&#10;ELSEIF CONTAINS( [table_id], &quot;curated_data_shared_data_stream&quot;) THEN &apos;DataStreams&apos; &#13;&#10;&#13;&#10;Else &apos;DataHub&apos; End' />
        </column>
        <column caption='Is Automatic' datatype='boolean' name='[Calculation_1361213034350088192]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF [reporter] = &quot;DataStreams Notifier&quot; THEN TRUE Else FALSE END' />
        </column>
        <column caption='Labels' datatype='string' name='[Data_Producer]' role='dimension' type='nominal' />
        <column datatype='string' name='[Priority]' role='dimension' type='nominal' />
        <column datatype='date' name='[date]' role='dimension' type='ordinal' />
        <column-instance column='[Calculation_1173750704585510912]' derivation='None' name='[none:Calculation_1173750704585510912:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_1242993547044073482]' derivation='None' name='[none:Calculation_1242993547044073482:qk]' pivot='key' type='quantitative' />
        <column-instance column='[Calculation_1298444117040934912]' derivation='None' name='[none:Calculation_1298444117040934912:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_1361213034350088192]' derivation='None' name='[none:Calculation_1361213034350088192:nk]' pivot='key' type='nominal' />
        <column-instance column='[Data_Producer]' derivation='None' name='[none:Data_Producer:nk]' pivot='key' type='nominal' />
        <column-instance column='[Priority]' derivation='None' name='[none:Priority:nk]' pivot='key' type='nominal' />
        <column-instance column='[date]' derivation='None' name='[none:date:qk]' pivot='key' type='quantitative' />
        <column-instance column='[reporter]' derivation='None' name='[none:reporter:nk]' pivot='key' type='nominal' />
        <column caption='Reporter' datatype='string' name='[reporter]' role='dimension' type='nominal' />
