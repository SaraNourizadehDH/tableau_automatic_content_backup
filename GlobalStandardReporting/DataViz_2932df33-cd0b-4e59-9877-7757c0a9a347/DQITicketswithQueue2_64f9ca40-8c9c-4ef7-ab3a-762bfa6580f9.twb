            <column caption='Change Date Parametered' datatype='string' datatype-customized='true' name='[Issue Date Parametered (copy)_122723140042670080]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Day&apos;&#13;&#10;THEN &apos;DoD&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos;&#13;&#10;THEN &apos;WoW&apos;&#13;&#10;ELSE &apos;MoM&apos;&#13;&#10;END' />
