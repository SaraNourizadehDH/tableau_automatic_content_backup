      <column caption='Avg Ticket Lifecycle Days' datatype='real' hidden='true' name='[Calculation_215046916843970570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [order_of_events_DESC] = 1&#13;&#10;    THEN&#13;&#10;        [Minutes_Open] / 1440 // Minutes to Days&#13;&#10;END&#13;&#10;    ) &#13;&#10;&#13;&#10;/[COUNTD Ticket Keys (copy)_215046916811264008]' />
      </column>
      <column caption='Avg Waiting on Customer Days' datatype='real' hidden='true' name='[Calculation_215046916845305868]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    SUM(&#13;&#10;        IF [order_of_events_DESC] =1 &#13;&#10;        THEN [Waiting_On_Customer_Time] END&#13;&#10;        )/(1440)&#13;&#10;)&#13;&#10;/[COUNTD Ticket Keys (copy)_215046916811264008]' />
      </column>
      <column caption='Avg Progress Days' datatype='real' name='[Calculation_215046916845596685]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;SUM(&#13;&#10;    IF [order_of_events_DESC] =1 &#13;&#10;    THEN [Progress_Time] END&#13;&#10;        ) / 1440&#13;&#10;)&#13;&#10;/[COUNTD Ticket Keys (copy)_215046916811264008]' />
      </column>
      <column caption='Avg Days to First Response' datatype='real' hidden='true' name='[Calculation_215046916845842446]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [order_of_events_DESC] = 1&#13;&#10;    THEN&#13;&#10;        [Time_to_First_Response] / 1440 // Minutes to Days&#13;&#10;END&#13;&#10;    ) &#13;&#10;&#13;&#10;/[COUNTD Ticket Keys (copy)_215046916811264008]' />
      </column>
      <column caption='Resolution Percentage' datatype='real' hidden='true' name='[Calculation_466685546815643648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1242993547032330242]/[Calculation_215046916767911936]' />
      </column>
      <column caption='Hours to Change' datatype='real' name='[Calculation_731553515837140993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [order_of_events_DESC] = 1 AND NOT [Status_To] IN (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;)&#13;&#10;THEN &#13;&#10;    DATEDIFF(&apos;hour&apos;,[Status_Changed_at],NOW())  &#13;&#10;ELSE&#13;&#10;[Minutes_From_Last_Change]/60&#13;&#10;END' />
      </column>
      <column caption='Hours Open (Full)' datatype='real' hidden='true' name='[Calculation_731553515837448194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Minutes_Open]/60' />
      </column>
      <column caption='Resolution Hours' datatype='real' hidden='true' name='[Calculation_731553515838181379]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Resolution_Time]/60' />
      </column>
      <column caption='First Resp. Hours (Full)' datatype='real' hidden='true' name='[Calculation_731553515838996484]' role='measure' type='quantitative'>
