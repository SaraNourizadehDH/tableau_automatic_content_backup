      <column aggregation='None' caption='Age of Open Tickets (bin)' datatype='integer' hidden='true' name='[Age of Open Tickets (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='1' formula='[Average Age of Open Tickets (copy)_1052716462139359232]' peg='0' size-parameter='[Parameters].[Parameter 3]' />
      </column>
      <column caption='Age of Open Tickets' datatype='real' name='[Average Age of Open Tickets (copy)_1052716462139359232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;        [order_of_events_DESC] = 1 AND [order_of_events_ASC]=1&#13;&#10;    THEN &#13;&#10;        [Resolution_Time]/1440&#13;&#10;    ELSEIF  &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;        AND NOT [Status_To]  in (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;, &quot;Waiting for customer&quot;)&#13;&#10;    THEN&#13;&#10;        (Resolution_Time + DATEDIFF(&apos;minute&apos;,[Status_Changed_at],NOW()))/1440&#13;&#10;     ELSEIF     &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;        AND NOT [Status_To]  in (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;)&#13;&#10;        AND  [Status_To]  in (&quot;Waiting for customer&quot;)&#13;&#10;    THEN&#13;&#10;        (Resolution_Time/1440) &#13;&#10;END  // Minutes to Days' />
      </column>
      <column caption='Days to Resolution' datatype='real' name='[Average Age of Open Tickets (copy)_1335598814417649664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  &#13;&#10;        [order_of_events_ASC] = 1&#13;&#10;        AND Ticket_Will_Be_Resolved = True&#13;&#10;    THEN&#13;&#10;        Resolution_Time / 1440 // Minutes to Days&#13;&#10;END' />
      </column>
      <column caption='Avg Hours to First Response' datatype='real' hidden='true' name='[Avg Days to First Response (copy)_1071856747028316169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;SUM(&#13;&#10;    IF [order_of_events_DESC] = 1&#13;&#10;    THEN [Time_to_First_Response] END&#13;&#10;    ) / 60&#13;&#10;)&#13;&#10;/[COUNTD Ticket Keys (copy)_215046916811264008]' />
      </column>
      <column caption='% Days to First Response' datatype='real' hidden='true' name='[Avg Days to First Response (copy)_215046916856279075]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_215046916845842446]&#13;&#10;&#13;&#10;/&#13;&#10;[Calculation_215046916843970570]' />
      </column>
      <column caption='% Progress Days ' datatype='real' hidden='true' name='[Avg Progress Days (copy)_215046916855742498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    (&#13;&#10;    SUM(&#13;&#10;        IF [order_of_events_DESC] =1 &#13;&#10;        THEN [Progress_Time] END&#13;&#10;            ) / 1440&#13;&#10;    )&#13;&#10;    /[COUNTD Ticket Keys (copy)_215046916811264008]&#13;&#10;)&#13;&#10;/[Calculation_215046916843970570]' />
      </column>
      <column caption='% Resolution Days ' datatype='real' hidden='true' name='[Avg Resolution Days (copy)_215046916854288416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Resolution Time (copy)_215046916812607497]&#13;&#10;/ [Calculation_215046916843970570]' />
      </column>
      <column caption='Avg Resolution Hours' datatype='real' hidden='true' name='[Avg Resolution Days (copy)_964896255891734530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    SUM(&#13;&#10;        IF [order_of_events_DESC] =1 &#13;&#10;        THEN [Resolution_Time] END&#13;&#10;        ) /(60)&#13;&#10;)&#13;&#10;/[COUNTD Ticket Keys (copy)_215046916811264008]' />
      </column>
      <column caption='Average Age of Open Tickets' datatype='real' hidden='true' name='[Avg Ticket Lifecycle Days (copy)_418553339735261184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF &#13;&#10;        [order_of_events_DESC] = 1 AND [order_of_events_ASC]=1&#13;&#10;    THEN &#13;&#10;        [Resolution_Time]/1440&#13;&#10;    ELSEIF  &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;        AND NOT [Status_To]  in (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;, &quot;Waiting for customer&quot;)&#13;&#10;    THEN&#13;&#10;        (Resolution_Time + DATEDIFF(&apos;minute&apos;,[Status_Changed_at],NOW()))/1440&#13;&#10;     ELSEIF     &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;        AND NOT [Status_To]  in (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;)&#13;&#10;        AND  [Status_To]  in (&quot;Waiting for customer&quot;)&#13;&#10;    THEN&#13;&#10;        (Resolution_Time/1440) &#13;&#10;END ) // Minutes to Days' />
      </column>
      <column caption='Unworkable Days' datatype='real' name='[Avg Waiting on Customer Days (copy)_1335598814438948874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [order_of_events_ASC] =1 &#13;&#10;    THEN [Waiting_On_Customer_Time] /(1440) // Minutes to Days&#13;&#10;END' />
      </column>
      <column caption='% Waiting on Customer Days' datatype='real' hidden='true' name='[Avg Waiting on Customer Days (copy)_215046916854984737]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    (&#13;&#10;        SUM(&#13;&#10;            IF [order_of_events_DESC] =1 &#13;&#10;            THEN [Waiting_On_Customer_Time] END&#13;&#10;            )/(1440)&#13;&#10;    )&#13;&#10;    /[COUNTD Ticket Keys (copy)_215046916811264008]&#13;&#10;)&#13;&#10;/[Calculation_215046916843970570]' />
      </column>
      <column caption='COUNTD Ticket Keys Last' datatype='integer' name='[COUNTD Ticket Keys (copy)_215046916811264008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [order_of_events_DESC] = 1 THEN [Ticket_Key]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Open Tickets Parameter Calculated Field' datatype='string' name='[Calculation_1052716462142914562]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Priority Parameter] = &quot;Source&quot; Then [Calculation_1298444117040934912]&#13;&#10;ELSEIF [Parameters].[Priority Parameter] = &quot;Reporter&quot; Then [reporter]&#13;&#10;ELSEIF [Parameters].[Priority Parameter] = &quot;Table&quot; Then [table_id]&#13;&#10;ELSEIF [Parameters].[Priority Parameter] = &quot;Labels&quot; Then [Data_Producer]&#13;&#10;ELSEIF [Parameters].[Priority Parameter] = &quot;From Status&quot; Then [Status_From]&#13;&#10;END' />
      </column>
      <column caption='Open Tickets Age Bin' datatype='string' name='[Calculation_1052716462164836357]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ( IF [order_of_events_DESC] = 1 THEN [Average Age of Open Tickets (copy)_1052716462139359232] END) &lt; 7 THEN &quot;&lt; 1 Week&quot;&#13;&#10;    ELSEIF  ( IF [order_of_events_DESC] = 1 THEN [Average Age of Open Tickets (copy)_1052716462139359232] END) &lt;= 30 THEN &quot;1 Month&quot;&#13;&#10;    ELSEIF  ( IF [order_of_events_DESC] = 1 THEN [Average Age of Open Tickets (copy)_1052716462139359232] END) &lt;= 90 THEN &quot;3 Month&quot;&#13;&#10;    ELSEIF  ( IF [order_of_events_DESC] = 1 THEN [Average Age of Open Tickets (copy)_1052716462139359232] END) &lt;= 210 THEN &quot;3 to 6 Months&quot;&#13;&#10;    ELSE &quot;6+ Months&quot;&#13;&#10;END' />
      </column>
      <column caption='Time to First Response SLA ' datatype='integer' hidden='true' name='[Calculation_1071856747026898952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Priority] = &quot;Blocker&quot; THEN 1&#13;&#10;    ELSEIF  [Priority] = &quot;High&quot; THEN 8&#13;&#10;    ELSEIF [Priority] = &quot;Medium&quot; THEN 72&#13;&#10;    ELSEIF [Priority] = &quot;Low&quot; THEN 72&#13;&#10; END' />
      </column>
      <column caption='Is Completed Date' datatype='boolean' name='[Calculation_1173750704585510912]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Month&quot; THEN &#13;&#10;    &#13;&#10;    DATETRUNC(&apos;month&apos;,[Calculation_1242993547044073482]) &lt;  DATETRUNC(&apos;month&apos;,TODAY())&#13;&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Week&quot; THEN &#13;&#10;    &#13;&#10;    DATETRUNC(&apos;week&apos;,[Calculation_1242993547044073482]) &lt;  DATETRUNC(&apos;week&apos;,TODAY())&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Day&quot; THEN &#13;&#10;    &#13;&#10;    DATETRUNC(&apos;day&apos;,[Calculation_1242993547044073482]) &lt;  DATETRUNC(&apos;day&apos;,TODAY())&#13;&#10;END' />
      </column>
      <column caption='Created Tickets' datatype='integer' datatype-customized='true' name='[Calculation_1242993547031945217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_of_events_ASC]= 1 THEN [Ticket_Key] END)&#13;&#10;&#13;&#10; //[From Status]= &quot;Created&quot; THEN [Ticket_Key] END)' />
      </column>
      <column caption='Closed Tickets' datatype='integer' name='[Calculation_1242993547032330242]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF  &#13;&#10;        [Status_To] IN (&quot;Done&quot;, &quot;Resolved&quot;,&quot;Canceled&quot;,&quot;Closed&quot;)&#13;&#10;        AND &#13;&#10;        [order_of_events_DESC] = 1&#13;&#10;&#13;&#10;THEN [Ticket_Key] END)' />
      </column>
      <column caption='Issue Date Parametered' datatype='date' datatype-customized='true' name='[Calculation_1242993547044073482]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 1] = &apos;Day&apos;&#13;&#10;THEN DATETRUNC(&apos;day&apos;, [date])&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos;&#13;&#10;THEN DATETRUNC(&apos;week&apos;, [date],&apos;monday&apos;)&#13;&#10;ELSE DATETRUNC(&apos;month&apos;, [date])&#13;&#10;END)' />
      </column>
      <column caption='LAST' datatype='integer' name='[Calculation_1242993547049693199]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LAST()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Source' datatype='string' name='[Calculation_1298444117040934912]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Data_Producer] IN (&quot;perseus&quot;, &quot;perseus_sdk&quot;, &quot;perseus_curation&quot;, &quot;perseus_global&quot;,&#13;&#10; &quot;perseus_pandora&quot;, &quot;perseus_peya&quot;, &quot;perseus_hungerstation&quot;,&#13;&#10; &quot;perseus_talabat&quot;, &quot;perseus_instashop&quot;, &quot;perseus_efood&quot;, &quot;perseus_woowa_korea&quot;) THEN &apos;Perseus&apos;&#13;&#10;&#13;&#10;ELSEIF CONTAINS( [table_id], &quot;curated_data_shared_data_stream&quot;) THEN &apos;DataStreams&apos; &#13;&#10;&#13;&#10;Else &apos;DataHub&apos; End' />
      </column>
      <column caption='Resolution Rate' datatype='real' name='[Calculation_1335598814429650949]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [order_of_events_ASC] = 1 AND [Ticket_Will_Be_Resolved] = True&#13;&#10;THEN [Ticket_Key] END&#13;&#10;&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD(IF [order_of_events_ASC] = 1&#13;&#10;THEN [Ticket_Key] END)' />
      </column>
      <column caption='Status Changes' datatype='integer' name='[Calculation_1335598814431698950]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [order_of_events_ASC] != 1 &#13;&#10;    THEN [Ticket_Key] END&#13;&#10;)' />
      </column>
