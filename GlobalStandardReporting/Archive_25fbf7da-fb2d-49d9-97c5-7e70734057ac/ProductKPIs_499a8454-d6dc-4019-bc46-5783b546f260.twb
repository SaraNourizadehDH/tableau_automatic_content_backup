  <column aggregation='Year' caption='Week Date' datatype='date' datatype-customized='true' default-type='ordinal' name='[Calculation_1295347896596676609]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default'>
    <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[partition_date],&apos;monday&apos;))' />
