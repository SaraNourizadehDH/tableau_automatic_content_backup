          <zone h='92896' id='76' param='vert' type-v2='layout-flow' w='98400' x='800' y='2750'>
            <zone fixed-size='50' h='1786' id='80' is-fixed='true' type-v2='layout-basic' w='98400' x='800' y='2750'>
              <zone h='1786' id='77' param='horz' type-v2='layout-flow' w='98400' x='800' y='2750'>
                <zone fixed-size='154' h='1428' id='78' is-fixed='true' type-v2='text' w='16200' x='1300' y='2929'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontsize='12'>aCVR</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
