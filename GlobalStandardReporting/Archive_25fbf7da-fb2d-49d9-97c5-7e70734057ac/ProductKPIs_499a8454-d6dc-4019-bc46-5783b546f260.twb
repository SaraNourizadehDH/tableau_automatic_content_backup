  <column aggregation='User' caption='Sessions Positive Icon' datatype='string' default-type='nominal' name='[Calculation_1295347896597680130]' pivot='key' role='measure' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='IF (ZN(SUM([sessions])) - LOOKUP(ZN(SUM([sessions])), -1)) / ABS(LOOKUP(ZN(SUM([sessions])), -1)) &gt; 0&\#13;&\#10;THEN &apos;▲&apos;&\#13;&\#10;ELSE &apos;&apos;&\#13;&\#10;END'>
