                <zone forceUpdate='true' h='1428' id='79' type-v2='text' w='81200' x='17500' y='2929'>
                  <formatted-text>
                    <run fontcolor='#616161' italic='true'># of Session with </run>
                    <run bold='true' fontcolor='#6a1b9a' italic='true'>Transaction</run>
