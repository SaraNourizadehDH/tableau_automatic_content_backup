                  <zone fixed-size='658' forceUpdate='true' h='4934' id='65' is-fixed='true' type-v2='text' w='66600' x='13800' y='533'>
                    <formatted-text>
                      <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='22'>mCVRs  by Brand</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
