                <zone h='4934' id='67' param='horz' type-v2='layout-flow' w='16103' x='83097' y='533'>
                  <zone h='4934' id='63' is-scaled='1' param='Image/DH-LOGO-05.jpg' type-v2='bitmap' w='16103' x='83097' y='533'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
