  <column aggregation='User' caption='Time To Order' datatype='real' default-type='quantitative' name='[Calculation_249386889493774336]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='(SUM([sum_time_to_order]) / SUM([count_time_to_order]))/1440' />
