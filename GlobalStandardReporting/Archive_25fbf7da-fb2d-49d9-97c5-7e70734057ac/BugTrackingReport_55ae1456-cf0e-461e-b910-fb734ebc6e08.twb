            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0utbu2607vvam61berdw91a8x6dn'>
            <column caption='Data Analytics Member as Requestor' datatype='boolean' name='[Calculation_1218505234202869770]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[requester_email] IN (&#10;    &apos;michal.ratajewski@deliveryhero.com&apos;,&#10;    &apos;ankur.shah@deliveryhero.com&apos;,&#10;    &apos;arsalan.uddin@deliveryhero.com&apos;,&#10;    &apos;pasquale.santoro@deliveryhero.com&apos;,&#10;    &apos;julie.dufaux@deliveryhero.com&apos;,&#10;    &apos;trupti.karnire@deliveryhero.com&apos;,&#10;    &apos;ankita.naik@deliveryhero.com&apos;,&#10;    &apos;bruno.lichy@deliveryhero.com&apos;,&#10;    &apos;leandro.mazoni@deliveryhero.com&apos;,&#10;    &apos;galih.ramadhani@deliveryhero.com&apos;,&#10;    &apos;xun.gong@deliveryhero.com&apos;,&#10;    &apos;grecia.diaz@deliveryhero.com&apos;,&#10;    &apos;fatima.rodriguez@pedidosya.com&apos;,&#10;    &apos;fatima.rodriguez@deliveryhero.com&apos;,&#10;    &apos;nilay.tuermen@deliveryhero.com&apos;,&#10;    &apos;anelia.spasova@deliveryhero.com&apos;,&#10;    &apos;michal.ratajewski@deliveryhero.com&apos;,&#10;    &apos;thi.le@deliveryhero.com&apos;,&#10;    &apos;oren.blumenfeld@deliveryhero.com&apos;,&#10;    &apos;saeed.esmaili@deliveryhero.com&apos;,&#10;    &apos;tanmoy.porel@deliveryhero.com&apos;,&#10;    &apos;maryna.davydenko@deliveryhero.com&apos;,&#10;    &apos;dorota.mierzwa@deliveryhero.com&apos;,&#10;    &apos;rutuja.bhosale@deliveryhero.com&apos;,&#10;    &apos;arsalan.uddin@deliveryhero.com&apos;,&#10;    &apos;mohsin.rizvi@deliveryhero.com&apos;,&#10;    &apos;shiva.arora@deliveryhero.com&apos;,&#10;    &apos;mathieu.hefti@deliveryhero.com &apos;&#10;)' />
              <aliases>
                <alias key='false' value='Others' />
                <alias key='true' value='Data Analytics' />
              </aliases>
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_1218505234221318156]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] WHEN &apos;Issue Type&apos; THEN [issue_type]&#10;  WHEN &apos;App&apos; THEN [Calculation_165577714813665282]&#10;  WHEN &apos;Labels&apos; THEN [all_labels]&#10;  WHEN &apos;Root Cause (RASD)&apos; THEN [root_cause_rasd]&#10;  WHEN &apos;Impact (RASD)&apos; THEN [impact_rasd]&#10;  WHEN &apos;Project&apos; THEN [project_name]&#10;  WHEN &apos;Assignee Name&apos; THEN [assignee_name]&#10;  WHEN &apos;Reporter Name&apos; THEN [requester_name]&#10;  WHEN &apos;Reported by DA&apos; THEN IF [Calculation_1218505234202869770] = TRUE THEN &apos;True&apos; ELSE &apos;False&apos; END&#10;  WHEN &apos;None&apos; THEN NULL&#10;END' />
            </column>
            <column caption='% Correctly Logged' datatype='real' default-format='p0%' name='[Calculation_1218505234224144397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_165577714817544195] = TRUE THEN 1 END)&#10;/&#10;SUM(IF ISNULL([Calculation_165577714817544195]) = FALSE THEN 1 END)&#10;* 100' />
            </column>
            <column caption='Days to resolve' datatype='integer' name='[Calculation_1218505234249220120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [resolution_date], [report_date])*-1' />
            </column>
            <column caption='Story Points' datatype='integer' name='[Calculation_165577714796859392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [story_points] WHEN &apos;&apos; THEN NULL&#10;ELSE INT([story_points])&#10;END' />
            </column>
            <column caption='App / Product' datatype='string' name='[Calculation_165577714813665282]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [app_product] WHEN &apos;&apos; THEN NULL&#10;ELSE [app_product]&#10;END' />
            </column>
            <column caption='Correctly Logged' datatype='boolean' name='[Calculation_165577714817544195]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [project_name] != &apos;RASD&apos; AND [issue_type] = &apos;Bug&apos; THEN FALSE&#10;ELSE TRUE&#10;END' />
            </column>
            <column caption='Owner = Analytics' datatype='boolean' name='[Calculation_2806094460822294528]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [root_cause_rasd] IN (&apos;code&apos;, &apos;data import&apos;, &apos;tableau&apos;, &apos;design&apos;)&#10;  THEN TRUE&#10;ELSE FALSE&#10;END' />
              <aliases>
                <alias key='false' value='Others' />
                <alias key='true' value='Data Analytics' />
              </aliases>
            </column>
            <column caption='Metric' datatype='real' name='[Dim 4 (copy)_3015371090431811590]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ROUND(&#10;CASE [Parameters].[Dimension 3 (copy)]&#10;    WHEN &apos;Issues&apos; THEN COUNTD([jira_id])&#10;    WHEN &apos;Story Points&apos; THEN SUM(INT([Calculation_165577714796859392]))&#10;    WHEN &apos;% Correctly Logged&apos; THEN [Calculation_1218505234224144397]&#10;    WHEN &apos;Days to resolve&apos; THEN SUM([Calculation_1218505234249220120])&#10;END&#10;, 2)' />
            </column>
            <column datatype='integer' name='[Month - creation time]' role='dimension' type='ordinal' user:agg-type='MY' user:base-field='Calculation_3973863743516508160' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='(DATEPART(&apos;year&apos;, [report_date])*100 + DATEPART(&apos;month&apos;, [report_date]))' scope-isolation='false' />
            </column>
