              <calculation class='tableau' formula='SUM(IF [Calculation_165577714817544195] = TRUE THEN 1 END)&#10;/&#10;SUM(IF ISNULL([Calculation_165577714817544195]) = FALSE THEN 1 END)&#10;* 100' />
            </column>
            <column caption='Days to resolve' datatype='integer' name='[Calculation_1218505234249220120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [resolution_date], [report_date])*-1' />
            </column>
            <column caption='Story Points' datatype='integer' name='[Calculation_165577714796859392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [story_points] WHEN &apos;&apos; THEN NULL&#10;ELSE INT([story_points])&#10;END' />
            </column>
            <column caption='App / Product' datatype='string' name='[Calculation_165577714813665282]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [app_product] WHEN &apos;&apos; THEN NULL&#10;ELSE [app_product]&#10;END' />
            </column>
            <column caption='Correctly Logged' datatype='boolean' name='[Calculation_165577714817544195]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [project_name] != &apos;RASD&apos; AND [issue_type] = &apos;Bug&apos; THEN FALSE&#10;ELSE TRUE&#10;END' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Calculation_2530671180097941506]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Dimension 1 (copy)]=&apos;Monthly&apos; THEN DATENAME(&apos;month&apos;, [report_date]) + &apos; – &apos; + STR(YEAR([report_date]))&#10;ELSEIF [Parameters].[Dimension 1 (copy)]=&apos;Weekly&apos; THEN DATENAME(&apos;week&apos;, [report_date]) + &apos; – &apos; + STR(YEAR([report_date]))&#10;END' />
            </column>
            <column caption='Metric' datatype='real' name='[Dim 4 (copy)_3015371090431811590]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ROUND(&#10;CASE [Parameters].[Dimension 3 (copy)]&#10;    WHEN &apos;Issues&apos; THEN COUNTD([jira_id])&#10;    WHEN &apos;Story Points&apos; THEN SUM(INT([Calculation_165577714796859392]))&#10;    WHEN &apos;% Correctly Logged&apos; THEN [Calculation_1218505234224144397]&#10;    WHEN &apos;Days to resolve&apos; THEN SUM([Calculation_1218505234249220120])&#10;END&#10;, 2)' />
            </column>
