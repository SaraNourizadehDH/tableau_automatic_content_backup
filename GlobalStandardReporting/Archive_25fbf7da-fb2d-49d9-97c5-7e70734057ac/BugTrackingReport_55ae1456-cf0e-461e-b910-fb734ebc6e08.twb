      <column caption='Dimension' datatype='string' name='[Calculation_1218505234221318156]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] WHEN &apos;Issue Type&apos; THEN [issue_type]&#10;  WHEN &apos;App&apos; THEN [Calculation_165577714813665282]&#10;  WHEN &apos;Labels&apos; THEN [all_labels]&#10;  WHEN &apos;Root Cause (RASD)&apos; THEN [root_cause_rasd]&#10;  WHEN &apos;Impact (RASD)&apos; THEN [impact_rasd]&#10;  WHEN &apos;Project&apos; THEN [project_name]&#10;  WHEN &apos;Assignee Name&apos; THEN [assignee_name]&#10;  WHEN &apos;Reporter Name&apos; THEN [requester_name]&#10;  WHEN &apos;Reported by DA&apos; THEN IF [Calculation_1218505234202869770] = TRUE THEN &apos;True&apos; ELSE &apos;False&apos; END&#10;  WHEN &apos;None&apos; THEN NULL&#10;END' />
