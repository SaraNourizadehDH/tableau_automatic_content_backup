          <calculation class='tableau' formula='&quot;% Correctly Logged&quot;' />
          <members>
            <member value='&quot;Issues&quot;' />
            <member value='&quot;Story Points&quot;' />
            <member value='&quot;\% Correctly Logged&quot;' />
