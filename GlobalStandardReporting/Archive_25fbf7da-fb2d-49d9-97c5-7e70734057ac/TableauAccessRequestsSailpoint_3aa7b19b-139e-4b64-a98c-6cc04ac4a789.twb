    <datasource caption='Custom SQL Query (raw_eiga)' inline='true' name='federated.1g1klsl0jsolc01803gk216zmq93' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0bd4t8s02fsxa61ef8vgi02tksnq'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh-looker' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='10' bq-large-fetch-rows='' bq-project-fetch-rows='2000' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='DataHub Production' schema='dl_eiga' server-oauth='' username='alistair.hart@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0bd4t8s02fsxa61ef8vgi02tksnq' name='Custom SQL Query' type='text'><![CDATA[WITH aggregated_data AS 
(
  SELECT 
    ir.id,
    ir.created_date,
    ir.end_date,
    TIMESTAMP_DIFF(COALESCE(ir.end_date, CURRENT_TIMESTAMP()), ir.created_date, MINUTE) as ticket_open_minutes,
    TIMESTAMP_DIFF(COALESCE(ir.end_date, CURRENT_TIMESTAMP()), ir.created_date, DAY) as ticket_open_days,
    REPLACE(role_name, '&amp;', '&') as role_name,
    ir.target_display_name,
    MAX(i.email) as approver_email,
    MAX(iri.approval_state) as approval_state
  FROM `fulfillment-dwh-production.raw_eiga.identity_iq_spt_identity_request` ir,
    UNNEST(SPLIT(ir.Role_name, ' ')) as role_name
  LEFT JOIN `fulfillment-dwh-production.staging_eiga.identity_iq_spt_identity_request_item*` iri ON ir.id = iri.identity_request_id --AND iri.application = 'IIQ' AND CONCAT('IT-ROLE-', UPPER(iri.owner_name)) = REPLACE(role_name, '&amp;', '&')
  LEFT JOIN `fulfillment-dwh-production.raw_eiga.identity_iq_spt_identity` i on i.ID_Name = iri.approver_name
  WHERE Role_name LIKE 'IT-ROLE-TABLEAU-GLOBAL-STANDARD-REPORTING%'
  AND ir.created_date >> '2023-01-01'
  GROUP BY ALL
)
SELECT
  id, 
  created_date, 
  end_date,
  ticket_open_minutes,
  SUBSTR(role_name, 43) as role_name,
  target_display_name,
  approver_email,
  CASE 
    WHEN approval_state = 'Finished' THEN 'Approved'
    WHEN approval_state IS NULL AND ticket_open_days >>= 7 THEN 'Expired'
    WHEN approval_state IS NULL AND ticket_open_days << 7 AND created_date >> CURRENT_TIMESTAMP-INTERVAL 7 DAY THEN 'Open'
    WHEN approval_state = 'Rejected' THEN 'Rejected'
    ELSE 'Unknown'
  END as approval_state
FROM aggregated_data
ORDER BY created_date DESC]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0bd4t8s02fsxa61ef8vgi02tksnq' name='Custom SQL Query' type='text'><![CDATA[WITH aggregated_data AS 
(
  SELECT 
    ir.id,
    ir.created_date,
    ir.end_date,
    TIMESTAMP_DIFF(COALESCE(ir.end_date, CURRENT_TIMESTAMP()), ir.created_date, MINUTE) as ticket_open_minutes,
    TIMESTAMP_DIFF(COALESCE(ir.end_date, CURRENT_TIMESTAMP()), ir.created_date, DAY) as ticket_open_days,
    REPLACE(role_name, '&amp;', '&') as role_name,
    ir.target_display_name,
    MAX(i.email) as approver_email,
    MAX(iri.approval_state) as approval_state
  FROM `fulfillment-dwh-production.raw_eiga.identity_iq_spt_identity_request` ir,
    UNNEST(SPLIT(ir.Role_name, ' ')) as role_name
  LEFT JOIN `fulfillment-dwh-production.staging_eiga.identity_iq_spt_identity_request_item*` iri ON ir.id = iri.identity_request_id --AND iri.application = 'IIQ' AND CONCAT('IT-ROLE-', UPPER(iri.owner_name)) = REPLACE(role_name, '&amp;', '&')
  LEFT JOIN `fulfillment-dwh-production.raw_eiga.identity_iq_spt_identity` i on i.ID_Name = iri.approver_name
  WHERE Role_name LIKE 'IT-ROLE-TABLEAU-GLOBAL-STANDARD-REPORTING%'
  AND ir.created_date >> '2023-01-01'
  GROUP BY ALL
)
SELECT
  id, 
  created_date, 
  end_date,
  ticket_open_minutes,
  SUBSTR(role_name, 43) as role_name,
  target_display_name,
  approver_email,
  CASE 
    WHEN approval_state = 'Finished' THEN 'Approved'
    WHEN approval_state IS NULL AND ticket_open_days >>= 7 THEN 'Expired'
    WHEN approval_state IS NULL AND ticket_open_days << 7 AND created_date >> CURRENT_TIMESTAMP-INTERVAL 7 DAY THEN 'Open'
    WHEN approval_state = 'Rejected' THEN 'Rejected'
    ELSE 'Unknown'
  END as approval_state
FROM aggregated_data
ORDER BY created_date DESC]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
