            <column-instance column='[Calculation_6731896294851362820]' derivation='None' name='[none:Calculation_6731896294851362820:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
