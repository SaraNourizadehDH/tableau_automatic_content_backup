            <column-instance column='[Calculation_6731896295254347823]' derivation='Sum' name='[sum:Calculation_6731896295254347823:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_6731896295255326768]' derivation='Sum' name='[sum:Calculation_6731896295255326768:qk]' pivot='key' type='quantitative' />
