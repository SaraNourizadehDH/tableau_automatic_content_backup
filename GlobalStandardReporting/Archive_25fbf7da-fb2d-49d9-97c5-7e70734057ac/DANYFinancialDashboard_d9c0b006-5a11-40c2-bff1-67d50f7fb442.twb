            <column caption='Time Level' datatype='string' name='[time_level]' role='dimension' type='nominal' />
            <column caption='Time Period' datatype='date' name='[time_period]' role='dimension' type='ordinal' />
            <column caption='Total Orders' datatype='integer' name='[total_orders]' role='measure' type='quantitative' />
