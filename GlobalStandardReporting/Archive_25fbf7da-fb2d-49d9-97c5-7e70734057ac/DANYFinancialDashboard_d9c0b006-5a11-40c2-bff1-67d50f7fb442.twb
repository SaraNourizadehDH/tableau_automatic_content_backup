    <worksheet name='Latam Region Level '>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_deliver_anything_financial_report (dev_dmart)' name='federated.03m5p771ykm9611asopw60ugicv6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Frequency' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='Weekly' />
                <alias key='2' value='Monthly' />
              </aliases>
            </column>
            <column alias='Both' caption='Business Model' datatype='integer' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
              <aliases>
                <alias key='1' value='B2B2C' />
                <alias key='2' value='C2C' />
                <alias key='3' value='Both' />
              </aliases>
            </column>
            <column alias='Unit Economics' caption='Metric Type' datatype='integer' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Unit Economics' />
                <alias key='2' value='Actual Numbers' />
              </aliases>
            </column>
            <column caption='Last N Periods' datatype='integer' name='[Parameter 4]' param-domain-type='range' role='measure' type='quantitative' value='12'>
              <calculation class='tableau' formula='12' />
              <range max='12' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03m5p771ykm9611asopw60ugicv6'>
            <column caption='Time Level Filter' datatype='boolean' name='[Calculation_6731896294849921025]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE  [Parameters].[Parameter 1] WHEN 1 THEN [time_level]=&apos;weekly&apos;&#10;WHEN 2 THEN[time_level]=&apos;monthly&apos; END' />
            </column>
            <column caption='Date Display' datatype='string' name='[Calculation_6731896294850691075]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=1 THEN &#10;STR(DATEPART(&apos;day&apos;,[time_period])) + &quot;-&quot; + LEFT(STR(DATENAME(&apos;month&apos;,[time_period])),3) + &quot;-&quot; + RIGHT(STR(DATEPART(&apos;year&apos;,[time_period])),2)&#10;ELSE LEFT(STR(DATENAME(&apos;month&apos;,[time_period])),3) + &quot;-&quot; + RIGHT(STR(DATEPART(&apos;year&apos;,[time_period])),2)&#10; END' />
            </column>
            <column caption='Business Model Filter' datatype='boolean' name='[Calculation_6731896294851362820]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] &#10;WHEN 1 then [business_model]=&apos;B2B2C&apos;&#10;WHEN 2 then [business_model]=&apos;C2C&apos;&#10;WHEN 3 then TRUE&#10;END' />
            </column>
            <column caption='Delivery Fee' datatype='real' name='[Calculation_6731896294852284422]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=1 then sum([DF_euro])/sum([successful_orders])&#10;else round(sum([DF_euro])) end' />
            </column>
            <column caption='Platform Rider CPO' datatype='real' name='[Calculation_6731896294852964360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Delivery_CPO]&#10;+&#10;IFNULL([Drivers_Equipment_CPO],0)&#10;+&#10;IFNULL([Food_Delivery_Accident_CPO],0)' />
            </column>
            <column caption='Penetration %' datatype='real' name='[Calculation_6731896294874902552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_orders])/&#10;sum({ fixed [time_level],[time_period],[country_name]: avg([platform_orders])})' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_6731896294889373724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders])/sum([total_orders])' />
            </column>
            <column caption='Avg Delivery Time ' datatype='real' name='[Calculation_6731896294892814366]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Delivery_time_minutes])/sum([successful_orders])' />
            </column>
            <column caption='Personal Cost - Local' datatype='integer' name='[Calculation_6731896295254298670]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='int(NULL)' />
            </column>
            <column caption='Personal Cost - Regional' datatype='integer' name='[Calculation_6731896295254347823]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Int(NULL)' />
            </column>
            <column caption='EBIDTA' datatype='integer' name='[Calculation_6731896295255326768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
            </column>
            <column caption='Region level Platform Total Delivery Cost' datatype='real' name='[Calculation_6731896295271538737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3]=1 then &#10;SUM([Platform_Total_Delivery_CPO]*[successful_orders])/sum([successful_orders])&#10;else SUM([Platform_Total_Delivery_CPO]*[successful_orders]) END' />
            </column>
            <column caption='Region Platform Rider Cost' datatype='real' name='[Calculation_6731896295274352690]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3]=1 then&#10;sum([Calculation_6731896294852964360]*[successful_orders])/sum([successful_orders])&#10;else  sum([Calculation_6731896294852964360]*[successful_orders]) END' />
            </column>
            <column caption='Regional Pandago Rider Cost' datatype='real' name='[Calculation_6731896295274856499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3]=1&#10;then -sum([Pandago_Salary_CPO]*[successful_orders])/sum([successful_orders])&#10;else -sum([Pandago_Salary_CPO]*[successful_orders]) end' />
            </column>
            <column caption='Region level Other Costs' datatype='real' name='[Calculation_6731896295275270196]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6731896295271538737]-[Calculation_6731896295274352690]' />
            </column>
            <column caption='Region level pandago total delivery cost' datatype='real' name='[Calculation_6731896295275966517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6731896295274856499]+[Calculation_6731896295275270196]' />
            </column>
            <column caption='Region level Gross Profit' datatype='real' name='[Calculation_6731896295276261430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6731896294852284422]+[Calculation_6731896295275966517]' />
            </column>
            <column caption='Last' datatype='integer' name='[Calculation_6731896295281569851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LAST()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Last&lt;=Last N' datatype='boolean' name='[Calculation_6731896295281602620]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_6731896295281569851]&lt;[Parameters].[Parameter 4]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='DF euro' datatype='real' name='[DF_euro]' role='measure' type='quantitative' />
            <column caption='Delivery CPO' datatype='real' name='[Delivery_CPO]' role='measure' type='quantitative' />
            <column caption='Delivery time minutes' datatype='real' name='[Delivery_time_minutes]' role='measure' type='quantitative' />
            <column caption='Drivers Equipment CPO' datatype='real' name='[Drivers_Equipment_CPO]' role='measure' type='quantitative' />
            <column caption='Food Delivery Accident CPO' datatype='real' name='[Food_Delivery_Accident_CPO]' role='measure' type='quantitative' />
            <column caption='Pandago Salary CPO' datatype='real' name='[Pandago_Salary_CPO]' role='measure' type='quantitative' />
            <column datatype='real' name='[Platform_Total_Delivery_CPO]' role='measure' type='quantitative' />
            <column caption='Active Vendors' datatype='integer' name='[active_vendors]' role='measure' type='quantitative' />
            <column caption='Business Model' datatype='string' name='[business_model]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
