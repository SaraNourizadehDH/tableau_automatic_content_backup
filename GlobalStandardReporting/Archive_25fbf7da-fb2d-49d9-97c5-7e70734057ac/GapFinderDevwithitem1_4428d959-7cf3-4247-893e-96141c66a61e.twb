      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0so4tmk0fbjbta16ifhp21mrfmqr].[sum:vendors:qk]&quot;' value='Vendors acquired from competitor' />
