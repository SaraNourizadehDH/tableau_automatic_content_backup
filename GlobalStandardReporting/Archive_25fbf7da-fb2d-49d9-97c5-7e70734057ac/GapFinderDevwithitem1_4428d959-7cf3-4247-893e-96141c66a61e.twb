    <worksheet name='Inverse Gap being Zombies v2'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Arial' fontsize='11'>Inverse Gap Qualification</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='gf_inverse_gap+ (sales_reports) (2)' name='federated.1q1l64e18khlhs168mhcq0bz6dcn' />
          </datasources>
          <datasource-dependencies datasource='federated.1q1l64e18khlhs168mhcq0bz6dcn'>
            <column caption='city' datatype='string' name='[Calculation_132082138506801158]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[city_name]' />
            </column>
            <column caption='Zombies' datatype='integer' name='[Calculation_252975651246878723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [zombie_flag] then [vendor_ids_qty] END' />
