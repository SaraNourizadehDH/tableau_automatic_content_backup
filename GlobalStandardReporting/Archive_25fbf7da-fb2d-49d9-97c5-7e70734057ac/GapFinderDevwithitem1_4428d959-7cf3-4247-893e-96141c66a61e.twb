              <calculation class='tableau' formula='IF [Parameters].[Parameter 13] = &apos;Cuisine&apos; &#10;    THEN &apos;TOP CUISINES IN DH (BY QTY OF RESTAURANTS)&apos;&#10;ELSEIF [Parameters].[Parameter 13] = &apos;Review Velocity&apos; &#10;    THEN &apos;TOP SUB ENTITIES (BY QTY OF VENDORS WITH LIFT)&apos;&#10;ELSEIF [Parameters].[Parameter 13] = &apos;Opening Hours&apos;&#10;    AND [Parameters].[Analysis Level 1 (copy)_478366753628950536] IN (&apos;Competitor vs DH Real&apos;,&apos;Competitor vs DH Scheduled&apos;)&#10;    THEN &apos;VENDORS BY HOUR SLOT AND WEEKDAY&apos;&#10;ELSEIF [Parameters].[Parameter 13] = &apos;Opening Hours&apos;&#10;    AND [Parameters].[Analysis Level 1 (copy)_478366753628950536] IN (&apos;DH Scheduled vs DH Real&apos;)&#10;    THEN &apos;VENDORS BY HOUR SLOT AND WEEKDAY - SCHEDULED VS REAL&apos;&#10;ELSEIF [Parameters].[Parameter 13] = &apos;Summary&apos;&#10;    AND [Parameters].[Analysis Level 1 (copy)_478366753628950536] IN (&apos;Competitor Gap&apos;)&#10;    THEN &apos;TOP COMPETITORS BY ADDRESSABLE GAP&apos;&#10;ELSEIF [Parameters].[Parameter 13] = &apos;Menu Offer&apos;&#10;    THEN &apos;VENDORS WITH MARKUP&apos;&#10;END' />
            </column>
            <column caption='showTitle 1' datatype='boolean' name='[Title 1 (copy)_4218113665075212292]' role='dimension' type='nominal'>
