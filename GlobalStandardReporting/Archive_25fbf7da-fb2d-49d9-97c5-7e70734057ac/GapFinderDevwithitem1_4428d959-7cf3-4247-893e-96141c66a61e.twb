          <datasource-dependencies datasource='federated.0so4tmk0fbjbta16ifhp21mrfmqr'>
            <column caption='Monthly orders per vendor' datatype='real' name='[Calculation_4652711047919788034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([successful_orders])/sum([days_online]))*30' />
            </column>
            <column caption='%Fail Rate' datatype='real' name='[Calculation_4652711047919927299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders])/sum([total_orders])' />
            </column>
            <column caption='AOV' datatype='real' name='[Calculation_4652711047920185348]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_eur])/sum([successful_orders])' />
            </column>
            <column caption='Commission Rate' datatype='real' name='[Calculation_4652711047920349189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([commission_revenue])/sum([comissionable_base])' />
            </column>
            <column caption='k' datatype='integer' name='[Calculation_4652711047934042118]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
