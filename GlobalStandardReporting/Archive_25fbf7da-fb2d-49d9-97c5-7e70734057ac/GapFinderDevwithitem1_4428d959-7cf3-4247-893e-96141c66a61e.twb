    <worksheet name='SUMMARY - Table'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='18'>Hero Dash</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='gap_finder_hero_dash (sales_reports)' name='federated.01snocg0qtheue15ima4s17nl4qt' />
            <datasource caption='gf_review_velocity_analysis+ (sales_reports)' name='federated.1g3asdm0fxusvs164gyfv0w0th0l' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Analysis Level 2' datatype='string' name='[Analysis Level 1 (copy)_478366753628950536]' param-domain-type='list' role='measure' type='nominal' value='&quot;Competitor Gap&quot;'>
              <calculation class='tableau' formula='&quot;Competitor Gap&quot;' />
            </column>
            <column caption='Analysis Level 1' datatype='string' name='[Parameter 13]' param-domain-type='list' role='measure' type='nominal' value='&quot;Summary&quot;'>
              <calculation class='tableau' formula='&quot;Summary&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.01snocg0qtheue15ima4s17nl4qt'>
            <column caption='Non-addressable Gap' datatype='integer' name='[Addressable gap (copy)_3600839011488849923]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [gap_type] = &apos;non addressable&apos; and [gap] THEN [leads] END' />
            </column>
            <column caption='Gap Competitor' datatype='integer' name='[Calculation_251638690516484096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF (NOT [lead_source] IN (&apos;salesforce&apos;,&apos;deliveryhero&apos;)) AND [gap] then [leads] end' />
            </column>
            <column caption='DH size' datatype='integer' name='[Calculation_251638690520965127]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//{ FIXED   [Global Entity Id],[City Name], [Sales Area Name]: SUM(ZN([DH Restaurants]))}&#10;{ EXCLUDE [lead_source]: SUM(ZN([Market Size (copy)_420523639049596930]))}' />
            </column>
            <column caption='Addressable Gap' datatype='integer' name='[Calculation_3064840286745047041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [gap_type] = &apos;addressable&apos; and [gap] then [leads] end' />
            </column>
            <column caption='showCompetitorGap' datatype='boolean' name='[Calculation_3762476046231134208]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 13] = &apos;Summary&apos; AND [Parameters].[Analysis Level 1 (copy)_478366753628950536] = &apos;Competitor Gap&apos;' />
            </column>
            <column caption='vertical' datatype='string' name='[Calculation_3864792221769039872]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vertical]' />
            </column>
            <column caption='Relative Gap' datatype='real' name='[Calculation_4212202672567234560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(zn([Calculation_251638690516484096]))/Sum(zn([Calculation_251638690520965127]))' />
            </column>
            <column caption='Rank Total Gap' datatype='real' name='[Calculation_4212202672606302211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_PERCENTILE([Calculation_4212202672567234560])'>
                <table-calc ordering-field='[federated.01snocg0qtheue15ima4s17nl4qt].[region]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='k' datatype='integer' name='[Calculation_779474598742753280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='competitor display' datatype='string' name='[Lead Source (copy)_132082136256651264]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if  (([lead_source] = &apos;delivereat&apos; or [lead_source] = &apos;zomato&apos;) and [sub_entity] = &apos;FP - Malaysia&apos;)&#10;    or ([lead_source] = &apos;pathao&apos; and [sub_entity] = &apos;FP - Bangladesh&apos;)&#10;    or ([lead_source] = &apos;cheetay&apos; and [sub_entity] = &apos;FP - Pakistan&apos;)&#10;    or (([lead_source] = &apos;wongnai&apos; or [lead_source] = &apos;lineman&apos;) and [sub_entity] = &apos;FP - Thailand&apos;)&#10;    or ([lead_source] = &apos;phonebooky&apos; and [sub_entity] = &apos;FP - Philippines&apos;)&#10;   &#10;&#10;    or (([lead_source] = &apos;aptit&apos; or [lead_source] = &apos;allabolag&apos;) and [sub_entity] = &apos;FD - Sweden&apos;)&#10;    or ([lead_source] = &apos;bolt&apos; and [sub_entity] = &apos;FP - Hungary&apos;)&#10;    or (([lead_source] = &apos;justeat&apos;) and [sub_entity] = &apos;FD - Norway&apos;)&#10;    &#10;    or ([lead_source] = &apos;restaurantesbbb&apos; and [sub_entity] = &apos;PY - Ecuador&apos;)&#10;    or ([lead_source] = &apos;ubereats&apos; and [sub_entity] = &apos;PY - Bolivia&apos;)&#10;    or (([lead_source] = &apos;mrsool&apos; or [lead_source] = &apos;akelni&apos;) and [sub_entity] = &apos;TB - Egypt&apos;)&#10;    or (([lead_source] = &apos;notlob&apos; or [lead_source] = &apos;wasel&apos;) and [sub_entity] = &apos;TB - Bahrain&apos;)&#10;    or (([lead_source] = &apos;alsaree3&apos; or [lead_source] = &apos;brsima&apos;) and [sub_entity] = &apos;TB - Iraq&apos;)&#10;&#10;    or (([lead_source] = &apos;makemymeal&apos; or [lead_source] = &apos;eateasy&apos; or [lead_source] = &apos;instashop&apos;) and [sub_entity] = &apos;TB - UAE&apos;)&#10;    or ([lead_source] = &apos;jeeran&apos; and [sub_entity] = &apos;TB - Jordan&apos;)&#10;    //or (([[Lead Source]] = &apos;daleel&apos; or [[Lead Source]] = &apos;akeed&apos;) and [Sub entity] = &apos;TB - Oman&apos;)&#10;    or ([lead_source] = &apos;zomato&apos; and [region] = &apos;MENA&apos;)&#10;    or [management_entity] = &apos;DH Greece&apos;&#10;    //or [Sub entity] = &apos;HS - Bahrain&apos;&#10;&#10;then &apos;no&apos;&#10;else &apos;yes&apos;&#10;end' />
            </column>
