      <column caption='Display Flag1' datatype='boolean' name='[Calculation_478366753649012756]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 13] = &apos;Opening Hours&apos; &#10;    AND [Parameters].[Analysis Level 1 (copy)_478366753628950536] IN (&apos;Competitor vs DH Real&apos;,&apos;Competitor vs DH Scheduled&apos;)&#10;    THEN TRUE&#10;    ELSE FALSE&#10;END' />
