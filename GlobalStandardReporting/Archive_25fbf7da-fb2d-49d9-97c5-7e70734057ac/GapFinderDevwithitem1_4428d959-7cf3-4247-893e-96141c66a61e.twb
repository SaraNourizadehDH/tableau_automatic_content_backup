      <column caption='competitor display' datatype='string' name='[Lead Source (copy)_132082136256651264]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if  (([lead_source] = &apos;delivereat&apos; or [lead_source] = &apos;zomato&apos;) and [sub_entity] = &apos;FP - Malaysia&apos;)&#10;    or ([lead_source] = &apos;pathao&apos; and [sub_entity] = &apos;FP - Bangladesh&apos;)&#10;    or ([lead_source] = &apos;cheetay&apos; and [sub_entity] = &apos;FP - Pakistan&apos;)&#10;    or (([lead_source] = &apos;wongnai&apos; or [lead_source] = &apos;lineman&apos;) and [sub_entity] = &apos;FP - Thailand&apos;)&#10;    or ([lead_source] = &apos;phonebooky&apos; and [sub_entity] = &apos;FP - Philippines&apos;)&#10;   &#10;&#10;    or (([lead_source] = &apos;aptit&apos; or [lead_source] = &apos;allabolag&apos;) and [sub_entity] = &apos;FD - Sweden&apos;)&#10;    or ([lead_source] = &apos;bolt&apos; and [sub_entity] = &apos;FP - Hungary&apos;)&#10;    or (([lead_source] = &apos;justeat&apos;) and [sub_entity] = &apos;FD - Norway&apos;)&#10;    &#10;    or ([lead_source] = &apos;restaurantesbbb&apos; and [sub_entity] = &apos;PY - Ecuador&apos;)&#10;    or ([lead_source] = &apos;ubereats&apos; and [sub_entity] = &apos;PY - Bolivia&apos;)&#10;    or (([lead_source] = &apos;mrsool&apos; or [lead_source] = &apos;akelni&apos;) and [sub_entity] = &apos;TB - Egypt&apos;)&#10;    or (([lead_source] = &apos;notlob&apos; or [lead_source] = &apos;wasel&apos;) and [sub_entity] = &apos;TB - Bahrain&apos;)&#10;    or (([lead_source] = &apos;alsaree3&apos; or [lead_source] = &apos;brsima&apos;) and [sub_entity] = &apos;TB - Iraq&apos;)&#10;&#10;    or (([lead_source] = &apos;makemymeal&apos; or [lead_source] = &apos;eateasy&apos; or [lead_source] = &apos;instashop&apos;) and [sub_entity] = &apos;TB - UAE&apos;)&#10;    or ([lead_source] = &apos;jeeran&apos; and [sub_entity] = &apos;TB - Jordan&apos;)&#10;    //or (([[Lead Source]] = &apos;daleel&apos; or [[Lead Source]] = &apos;akeed&apos;) and [Sub entity] = &apos;TB - Oman&apos;)&#10;    or ([lead_source] = &apos;zomato&apos; and [region] = &apos;MENA&apos;)&#10;    or [management_entity] = &apos;DH Greece&apos;&#10;    //or [Sub entity] = &apos;HS - Bahrain&apos;&#10;&#10;then &apos;no&apos;&#10;else &apos;yes&apos;&#10;end' />
      </column>
