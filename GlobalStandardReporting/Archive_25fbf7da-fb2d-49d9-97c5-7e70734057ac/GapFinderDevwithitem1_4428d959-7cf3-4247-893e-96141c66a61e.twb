    <worksheet name='Cuisine TOP'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='0' fontname='Tableau Medium'>TOP CUISINES IN DH (BY QTY OF RESTAURANTS)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='gf_cuisine_analysis (sales_reports)' name='federated.04mqw3t0kcxkk51f35mwm1me5tgc' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Analysis Level 1' datatype='string' name='[Parameter 13]' param-domain-type='list' role='measure' type='nominal' value='&quot;Summary&quot;'>
              <calculation class='tableau' formula='&quot;Summary&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.04mqw3t0kcxkk51f35mwm1me5tgc'>
            <column caption='showCuisine' datatype='boolean' name='[Calculation_478366753699782684]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 13] = &apos;Cuisine&apos;' />
            </column>
            <column caption='Size DH' datatype='integer' name='[Calculation_478366753702756381]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [lead_source] = &apos;deliveryhero&apos; THEN [qty_of_vendors] END' />
            </column>
            <column caption='Rank cuisine DH' datatype='integer' name='[Calculation_478366753990946848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK(SUM([Calculation_478366753702756381]),&apos;desc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Competior' datatype='string' name='[Calculation_478366753997099042]' role='measure' type='nominal'>
              <calculation class='tableau' formula='MAX(IF [lead_source] = &apos;deliveryhero&apos; then NULL ELSE [lead_source] END)' />
            </column>
            <column caption='Main competitor in cuisine flag' datatype='boolean' name='[Calculation_478366754015715376]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Rank cuisine Competitor (copy)_478366754010783786]=[Rank cuisine Competitor (copy) (copy)_478366754014666798]' />
            </column>
            <column caption='Size Ratio' datatype='real' default-format='p0.0%' name='[Calculation_478366754021642291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Qty Of Vendors DH (copy)_478366753702940702])/SUM([Calculation_478366753702756381])' />
            </column>
            <column caption='Size Comp' datatype='integer' name='[Qty Of Vendors DH (copy)_478366753702940702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [lead_source] != &apos;deliveryhero&apos; THEN [qty_of_vendors] END' />
            </column>
            <column caption='Competitor vendors (lod cuisine, lead source)' datatype='integer' name='[Rank cuisine Competitor (copy) (copy)_478366754014666798]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='//{FIXED: [Cuisine],[Lead Source]: SUM([Qty Of Vendors Competitor])}[Lead Source]{ INCLUDE [Lead Source]: SUM(&#10;{ FIXED [cuisine],[lead_source]: SUM([Qty Of Vendors DH (copy)_478366753702940702]) }' />
            </column>
            <column caption='Main competitor vendors (lod cuisine, lead source)' datatype='integer' name='[Rank cuisine Competitor (copy)_478366754010783786]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='//{FIXED: [Cuisine],[Lead Source]: SUM([Qty Of Vendors Competitor])}[Lead Source]&#10;{ FIXED [cuisine]: MAX( { INCLUDE [lead_source]: SUM([Qty Of Vendors DH (copy)_478366753702940702]) } ) }' />
            </column>
            <column caption='Cuisine' datatype='string' name='[cuisine]' role='dimension' type='nominal' />
            <column caption='Lead Source' datatype='string' name='[lead_source]' role='dimension' type='nominal' />
