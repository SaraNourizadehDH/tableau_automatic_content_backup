      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.01snocg0qtheue15ima4s17nl4qt]&quot;' value='Run Date:' />
        </aliases>
      </column>
      <column caption='Non-addressable Gap' datatype='integer' name='[Addressable gap (copy)_3600839011488849923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [gap_type] = &apos;non addressable&apos; and [gap] THEN [leads] END' />
      </column>
      <column caption='Gap Competitor' datatype='integer' name='[Calculation_251638690516484096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF (NOT [lead_source] IN (&apos;salesforce&apos;,&apos;deliveryhero&apos;)) AND [gap] then [leads] end' />
      </column>
      <column caption='Gap In Progress' datatype='integer' name='[Calculation_251638690517516291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [gap] and [sf_status]=&apos;In Progress&apos; then [leads] END' />
      </column>
      <column caption='Gap Lost' datatype='integer' name='[Calculation_251638690517835780]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [gap] AND [sf_status]=&apos;Lost&apos; THEN leads end' />
      </column>
      <column caption='Gap No Match' datatype='integer' name='[Calculation_251638690518171653]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [gap] and [sf_status]=&apos;No Match&apos; THEN [leads] end' />
      </column>
      <column caption='Gap Terminated' datatype='integer' name='[Calculation_251638690518388742]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [gap] and [sf_status]=&apos;Terminated&apos; then [leads] END' />
      </column>
      <column caption='DH size' datatype='integer' name='[Calculation_251638690520965127]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//{ FIXED   [Global Entity Id],[City Name], [Sales Area Name]: SUM(ZN([DH Restaurants]))}&#10;{ EXCLUDE [lead_source]: SUM(ZN([Market Size (copy)_420523639049596930]))}' />
      </column>
      <column caption='Total active leads' datatype='integer' name='[Calculation_251638690529423369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([lead_source] IN (&apos;salesforce&apos;,&apos;deliveryhero&apos;) and [status]=&apos;Active&apos;) &#10;OR (NOT [lead_source] IN (&apos;salesforce&apos;,&apos;deliveryhero&apos;))&#10;THEN [leads] END' />
      </column>
      <column caption='K' datatype='integer' name='[Calculation_2649946188104617985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Salesforce Gap' datatype='integer' name='[Calculation_2690478565177393152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_251638690517835780])+zn([Calculation_251638690518388742])+ZN([Calculation_251638690517516291])' />
      </column>
      <column caption='Addressable Gap' datatype='integer' name='[Calculation_3064840286745047041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [gap_type] = &apos;addressable&apos; and [gap] then [leads] end' />
      </column>
      <column caption='Competitor 2' datatype='string' name='[Calculation_3457357161921552384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[lead_source]' />
      </column>
      <column caption='filter null gap competitor' datatype='boolean' name='[Calculation_3561010361457672193]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([Calculation_251638690516484096]) = FALSE' />
      </column>
      <column caption='showCompetitorGap' datatype='boolean' name='[Calculation_3762476046231134208]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 13] = &apos;Summary&apos; AND [Parameters].[Analysis Level 1 (copy)_478366753628950536] = &apos;Competitor Gap&apos;' />
      </column>
      <column caption='vertical' datatype='string' name='[Calculation_3864792221769039872]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[vertical]' />
      </column>
      <column caption='Relative Gap' datatype='real' name='[Calculation_4212202672567234560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(zn([Calculation_251638690516484096]))/Sum(zn([Calculation_251638690520965127]))' />
      </column>
      <column caption='Rank Total Gap' datatype='real' name='[Calculation_4212202672606302211]' role='measure' type='quantitative'>
