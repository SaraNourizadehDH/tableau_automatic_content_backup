      <column caption='showReviewVelocity' datatype='boolean' name='[Calculation_2400840845274968065]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 13] = &apos;Review Velocity&apos;' />
      </column>
      <column caption='Days Apart' datatype='integer' name='[Calculation_3131057305407012864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[run_date_previous],[run_date_current])' />
      </column>
      <column caption='Review Velocity' datatype='real' name='[Calculation_3131057305407827969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4218113665039876097])&#10;/SUM([Calculation_3131057305407012864])' />
      </column>
      <column caption='Review Velocity Per Month' datatype='real' name='[Calculation_3131057305412120578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3131057305407827969]*30' />
      </column>
      <column caption='Filter by review Velocity' datatype='boolean' name='[Calculation_4218113665039532032]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Analysis Level 1 (copy)_478366753628950536]&#10;WHEN &apos;Delta between [1,30]&apos; &#10;THEN (  0 &lt; [Calculation_4218113665039876097] AND [Calculation_4218113665039876097]&lt;= 30)&#10;WHEN &apos;Delta between [31,100]&apos; &#10;THEN ( 30 &lt; [Calculation_4218113665039876097] AND [Calculation_4218113665039876097]&lt;=100)&#10;WHEN &apos;Delta grater than 100&apos; &#10;THEN (100 &lt; [Calculation_4218113665039876097])&#10;ELSE TRUE&#10;END' />
      </column>
      <column caption='Amount Of Reviews Delta' datatype='real' name='[Calculation_4218113665039876097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[amount_of_reviews_current]-[amount_of_reviews_previous]' />
      </column>
      <column caption='Vendors in Gap' datatype='integer' name='[Calculation_4218113665068101634]' role='measure' type='quantitative'>
