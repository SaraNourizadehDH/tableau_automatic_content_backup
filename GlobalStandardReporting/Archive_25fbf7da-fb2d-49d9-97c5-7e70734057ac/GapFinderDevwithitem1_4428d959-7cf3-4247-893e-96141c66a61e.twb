      <aliases enabled='yes' />
      <column caption='Competitor Gap' datatype='real' name='[Calculation_1261219066987761664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn([gap_leads_in_progress])+zn([gap_leads_lost])+zn([gap_leads_terminate])+zn([gap_no_match])' />
      </column>
      <column caption='Calculation2' datatype='datetime' name='[Calculation_1261219067042754563]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;,[run_date],&apos;monday&apos;)' />
      </column>
      <column caption='iso week' datatype='datetime' name='[Calculation_1261219067046092804]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;,[run_date],&apos;monday&apos;)' />
      </column>
      <column caption='Inverse Gap' datatype='real' name='[Calculation_127578545956585473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[dh_restos]-([competitor_size]-[Calculation_1261219066987761664])' />
      </column>
      <column caption='Current GAP' datatype='real' name='[Calculation_1375286770241908736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if { FIXED [global_entity_id],[lead_source]: MAX([run_date])}=[run_date] then [Calculation_1261219066987761664] ELSE 0 end' />
      </column>
      <column caption='Last run date' datatype='date' name='[Calculation_1375286770261897227]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id]: MAX([run_date])}' />
      </column>
      <column caption='Delta GAP MoM' datatype='real' name='[Calculation_1375286770267840524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1375286770241908736])-sum([weekly compatitor GAP (copy)_1375286770254942210])' />
      </column>
      <column caption='Last run by week' datatype='boolean' name='[Calculation_1375286770272022545]' role='dimension' type='nominal'>
