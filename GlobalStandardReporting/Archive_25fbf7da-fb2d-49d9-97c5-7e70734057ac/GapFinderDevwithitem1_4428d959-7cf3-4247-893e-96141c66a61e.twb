    <worksheet name='Region table Gap view'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'>&lt;</run>
            <run bold='true' fontcolor='#ffffff'>[Parameters].[n_other_leads Parameter]</run>
            <run bold='true' fontcolor='#ffffff'>&gt; Competitor GAP Evolution</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='gf_brand_historical_penetration (sales_reports)' name='federated.13w8ry40sy8e3j17qf29h1602xmm' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='MoM' caption='Date Granularity' datatype='string' name='[n_other_leads Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;month&quot;' value='MoM' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='WoW' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13w8ry40sy8e3j17qf29h1602xmm'>
            <column caption='Competitor Gap' datatype='real' name='[Calculation_1261219066987761664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn([gap_leads_in_progress])+zn([gap_leads_lost])+zn([gap_leads_terminate])+zn([gap_no_match])' />
            </column>
            <column caption='Last run by week' datatype='boolean' name='[Calculation_1375286770272022545]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], DATETRUNC(&apos;week&apos;,[run_date],&apos;monday&apos;): MAX([run_date])}=[run_date]' />
            </column>
            <column caption='Gap ToT' datatype='boolean' name='[Calculation_1514194672208674818]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[n_other_leads Parameter] = &apos;month&apos; THEN [Last run by week (copy)_1514194672208564225] &#10;ELSEIF  [Parameters].[n_other_leads Parameter] = &apos;week&apos; then [Calculation_1375286770272022545] &#10;ELSEIF  [Parameters].[n_other_leads Parameter] = &apos;quarter&apos; then [Last run by month (copy)_1514194672212975621] END' />
            </column>
            <column caption='Date time frame' datatype='string' name='[Calculation_1514194672211472388]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME([Parameters].[n_other_leads Parameter], DATETRUNC([Parameters].[n_other_leads Parameter],[run_date]),&apos;monday&apos;)' />
            </column>
            <column caption='k' datatype='integer' name='[Calculation_1514194672225886218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='filter starting date' datatype='boolean' name='[Calculation_1977643221423751169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[run_date]&gt;=DATE(&apos;2021-08-01&apos;)' />
            </column>
            <column caption='Describe time frame' datatype='string' name='[Calculation_1977643221723607044]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[n_other_leads Parameter]=&apos;week&apos; then &apos;WoW&apos;&#10;ELSEIF [Parameters].[n_other_leads Parameter]=&apos;month&apos; then &apos;MoM&apos;&#10;ELSEIF  [Parameters].[n_other_leads Parameter]=&apos;quarter&apos; then &apos;QoQ&apos;&#10;END' />
            </column>
            <column caption='period start' datatype='datetime' name='[Date time frame (copy)_1977643221724766213]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[n_other_leads Parameter],[run_date])' />
            </column>
            <column caption='Last run by quarter' datatype='boolean' name='[Last run by month (copy)_1514194672212975621]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], DATETRUNC(&apos;quarter&apos;,[run_date]): MAX([run_date])}=[run_date]' />
            </column>
            <column caption='Last run by month' datatype='boolean' name='[Last run by week (copy)_1514194672208564225]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], DATETRUNC(&apos;month&apos;,[run_date]): MAX([run_date])}=[run_date]' />
            </column>
            <column caption='competitor display' datatype='string' name='[Lead Source (copy)_132082136256651264]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if  (([lead_source] = &apos;delivereat&apos; or [lead_source] = &apos;zomato&apos;) and [sub_entity] = &apos;FP - Malaysia&apos;)&#10;    or ([lead_source] = &apos;pathao&apos; and [sub_entity] = &apos;FP - Bangladesh&apos;)&#10;    or ([lead_source] = &apos;cheetay&apos; and [sub_entity] = &apos;FP - Pakistan&apos;)&#10;    or (([lead_source] = &apos;wongnai&apos; or [lead_source] = &apos;lineman&apos;) and [sub_entity] = &apos;FP - Thailand&apos;)&#10;    or ([lead_source] = &apos;phonebooky&apos; and [sub_entity] = &apos;FP - Philippines&apos;)&#10;   &#10;&#10;    or (([lead_source] = &apos;aptit&apos; or [lead_source] = &apos;allabolag&apos;) and [sub_entity] = &apos;FD - Sweden&apos;)&#10;    or ([lead_source] = &apos;bolt&apos; and [sub_entity] = &apos;FP - Hungary&apos;)&#10;    or (([lead_source] = &apos;justeat&apos;) and [sub_entity] = &apos;FD - Norway&apos;)&#10;    &#10;    or ([lead_source] = &apos;restaurantesbbb&apos; and [sub_entity] = &apos;PY - Ecuador&apos;)&#10;    or ([lead_source] = &apos;ubereats&apos; and [sub_entity] = &apos;PY - Bolivia&apos;)&#10;    or (([lead_source] = &apos;mrsool&apos; or [lead_source] = &apos;akelni&apos;) and [sub_entity] = &apos;TB - Egypt&apos;)&#10;    or (([lead_source] = &apos;notlob&apos; or [lead_source] = &apos;wasel&apos;) and [sub_entity] = &apos;TB - Bahrain&apos;)&#10;    or (([lead_source] = &apos;alsaree3&apos; or [lead_source] = &apos;brsima&apos;) and [sub_entity] = &apos;TB - Iraq&apos;)&#10;&#10;    or (([lead_source] = &apos;makemymeal&apos; or [lead_source] = &apos;eateasy&apos; or [lead_source] = &apos;instashop&apos;) and [sub_entity] = &apos;TB - UAE&apos;)&#10;    or ([lead_source] = &apos;jeeran&apos; and [sub_entity] = &apos;TB - Jordan&apos;)&#10;    //or (([[Lead Source]] = &apos;daleel&apos; or [[Lead Source]] = &apos;akeed&apos;) and [Sub entity] = &apos;TB - Oman&apos;)&#10;    or ([lead_source] = &apos;zomato&apos; and [region] = &apos;MENA&apos;)&#10;    or [entity] = &apos;DH Greece&apos;&#10;    //or [Sub entity] = &apos;HS - Bahrain&apos;&#10;&#10;then &apos;no&apos;&#10;else &apos;yes&apos;&#10;end' />
