      <aliases enabled='yes' />
      <column caption='CPT' datatype='real' name='[CPA (copy)_484136962276184065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1345872659728474114]) * (1+[Parameters].[Parameter 2])) / SUM([trials])' />
      </column>
      <column caption='CPA (Calibrated)' datatype='real' name='[CPA (copy)_605452677444194306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1345872659728474114])/SUM([acquisitions_calibration])' />
      </column>
      <column caption='CPO' datatype='real' name='[CPA (copy)_605452677444300803]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1345872659728474114])/SUM([total_orders])' />
      </column>
      <column caption='Cost' datatype='real' name='[Calculation_1345872659728474114 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[KPI (copy)]&#10;WHEN &apos;eur&apos; THEN [cost_eur]&#10;WHEN &apos;usd&apos; THEN [cost_usd]&#10;WHEN &apos;lc&apos; THEN [cost_lc]&#10;END' />
      </column>
      <column caption='Cost (with TOM)' datatype='real' name='[Calculation_1345872659728474114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[KPI (copy)]&#13;&#10;WHEN &apos;eur&apos; THEN [cost_eur] * (1+([Parameters].[Parameter 2] / 100))&#13;&#10;WHEN &apos;usd&apos; THEN [cost_usd] * (1+([Parameters].[Parameter 2] / 100))&#13;&#10;WHEN &apos;lc&apos;  THEN [cost_lc]  * (1+([Parameters].[Parameter 2] / 100))&#13;&#10;END' />
      </column>
      <column caption='CPA' datatype='real' name='[Calculation_1345872659736039430]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1345872659728474114])/SUM([acquisitions])' />
      </column>
      <column caption='% out of total orders' datatype='real' name='[Calculation_1605885158066196480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_orders]/[QCommerce Order Share  (copy)_507006848677335042]' />
      </column>
      <column caption='Platform Grouped' datatype='string' name='[Calculation_2138154306712477696]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LOWER([platform])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_2192479013991239680]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME()=[username]' />
      </column>
      <column caption='restaurants flag' datatype='integer' name='[Calculation_2458261749224804352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LOWER([shop_type]) = &apos;restaurants&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Aligning Vertical Color' datatype='string' hidden='true' name='[Calculation_3820108077672153089]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF shop_type = &apos;&lt;Cost data&gt;&apos; THEN [target_vertical] ELSE [shop_type] END' />
      </column>
      <column caption='Shop Types' datatype='string' name='[Calculation_484136962133389312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [actual_vertical]&#13;&#10;WHEN &apos;Restaurant / Food&apos; THEN &apos;Platform&apos;&#13;&#10;WHEN &apos;Darkstores / Dmarts&apos; THEN &apos;DMarts&apos;&#13;&#10;WHEN NULL THEN NULL&#13;&#10;ELSE &apos;Local Stores&apos;&#13;&#10;END' />
      </column>
      <column caption='QCommerce Cost Share' datatype='real' name='[Calculation_484136962279202818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Calculation_6938076740195209216]: SUM(IIF([target_vertical] != &apos;Restaurant / Food&apos;, [Calculation_1345872659728474114], 0))} /&#13;&#10;{FIXED [Calculation_6938076740195209216]: SUM([Calculation_1345872659728474114])}' />
      </column>
      <column caption='Cumulative Trials' datatype='real' name='[Calculation_484136962280783875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cumulative_trials]) / COUNTD([order_date])' />
      </column>
      <column caption='Customer Type' datatype='string' name='[Calculation_484136962283220997]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([loyalty_group] = &apos;Acquisition&apos;, &apos;Acquisition&apos;, &apos;Existing Customer&apos;)' />
      </column>
      <column caption='Breakdown KPI' datatype='string' name='[Calculation_484136962284699654]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3 2]&#13;&#10;WHEN 1 THEN [Calculation_484136962133389312]&#13;&#10;WHEN 2 THEN [actual_vertical]&#13;&#10;WHEN 3 THEN [Calculation_484136962283220997]&#13;&#10;WHEN 4 THEN [loyalty_group]&#13;&#10;END' />
        <aliases>
          <alias key='&quot;Local Shops&quot;' value='Local Stores' />
        </aliases>
      </column>
      <column caption='Channel - Sub-Channel' datatype='string' name='[Calculation_5512124520249184256]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[channel] + &#10;IF [subchannel] = &apos;&apos; THEN &apos;&apos; ELSE &quot; - &quot; + [subchannel] END' />
      </column>
      <column caption='Delivery Metric' datatype='real' name='[Calculation_605452677439049728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4 2]&#13;&#10;WHEN 1 THEN [trials]&#13;&#10;WHEN 2 THEN [acquisitions]&#13;&#10;WHEN 3 THEN [acquisitions_calibration]&#13;&#10;WHEN 4 THEN [total_orders]&#13;&#10;END' />
      </column>
      <column caption='Cost per Delivery Metric' datatype='real' name='[Calculation_605452677443842049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4 2]&#13;&#10;WHEN 1 THEN [CPA (copy)_484136962276184065]&#13;&#10;WHEN 2 THEN [Calculation_1345872659736039430]&#13;&#10;WHEN 3 THEN [CPA (copy)_605452677444194306]&#13;&#10;WHEN 4 THEN [CPA (copy)_605452677444300803]&#13;&#10;END' />
      </column>
      <column caption='Trials %YoY' datatype='real' name='[Calculation_605452677509582854]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([trials]) &#13;&#10;/ &#13;&#10;(&#13;&#10;IF [Parameters].[Parameter 1 1 2] = &apos;month&apos; THEN SUM([prev_y_trials])&#13;&#10;ELSEIF [Parameters].[Parameter 1 1 2] = &apos;week&apos; THEN SUM([prev_364d_trials]) &#13;&#10;END&#13;&#10;) - 1' />
      </column>
      <column caption='Date View' datatype='datetime' default-format='*yyyy-mm-dd' name='[Calculation_6938076740195209216]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1 2]&#10;WHEN &apos;Daily&apos; THEN [order_date]&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;, [order_date])&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;, [order_date])&#10;END' />
      </column>
      <column caption='% Voucher Trials' datatype='real' name='[Calculation_859906056755351552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Calculation_6938076740195209216]: SUM(IIF([source_of_funding] != &apos;Not Funded&apos;, [trials], 0))} /&#13;&#10;{FIXED [Calculation_6938076740195209216]: SUM([trials])}' />
      </column>
      <column caption='Channel (SEM)  ' datatype='string' name='[Channel (APP)  (copy 2)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[channel]' />
      </column>
      <column caption='Channel (Display) ' datatype='string' name='[Channel (APP)  (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[channel]' />
      </column>
      <column caption='Channel (SEO)' datatype='string' name='[Channel (PS) (copy 2)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[channel]' />
      </column>
      <column caption='Channel (APP) ' datatype='string' name='[Channel (PS) (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[channel]' />
      </column>
      <column caption='Channel (Brand) ' datatype='string' name='[Channel (SEM)   (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[channel]' />
      </column>
      <column caption='Channel (PS)' datatype='string' name='[Channel (copy)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[channel]' />
      </column>
      <column caption='QCommerce Order Share - old definition' datatype='real' name='[NFV Cost Share (copy)_605452677492695044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Calculation_6938076740195209216]: SUM(IIF([actual_vertical] != &apos;Restaurant / Food&apos;, [total_orders], 0))} /&#13;&#10;{FIXED [Calculation_6938076740195209216]: SUM([total_orders])}' />
      </column>
      <column datatype='integer' hidden='true' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='QCommerce Order Share' datatype='real' name='[QCommerce Order Share  (copy)_1605885158066454529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_orders]&#10;/ {FIXED [Calculation_6938076740195209216], [display_name]: &#10;SUM(&#10;IIF([Shop Types (copy)_507006848670797825] = &apos;DMarts&apos; or &#10;[Shop Types (copy)_507006848670797825] = &apos;Local Stores&apos;&#10;, [total_orders], 0))}' />
      </column>
      <column caption='Total Orders' datatype='real' name='[QCommerce Order Share  (copy)_507006848677335042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Calculation_6938076740195209216], [display_name]: &#10;SUM( [total_orders])}' />
      </column>
      <column caption='Share Shopping Cost' datatype='real' name='[Share Shopping Acquisitions  (copy 2)_1345872659732815877]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LOWER(MIN(STR([Calculation_484136962133389312]))) != &apos;f&apos; THEN NULL &#10;ELSEIF LOWER(MAX(STR([Calculation_484136962133389312]))) != &apos;t&apos; THEN NULL &#10;ELSEIF SUM([Calculation_2458261749224804352]) = 0 THEN NULL //addition DATA-4193&#10;ELSE SUM([Shopping Acquisitions (copy)_1345872659730231300])/SUM([Calculation_1345872659728474114]) END&#10;//SUM([Shopping Acquisitions])/SUM([Acquisitions])' />
      </column>
      <column caption='Shop Types (copy)' datatype='string' name='[Shop Types (copy)_507006848670797825]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [shop_type]&#13;&#10;WHEN &apos;coffee&apos; THEN &apos;Platform&apos;&#13;&#10;WHEN &apos;restaurants&apos; THEN &apos;Platform&apos;&#13;&#10;WHEN &apos;darkstores&apos; THEN &apos;DMarts&apos;&#13;&#10;WHEN &apos;courier&apos; THEN &apos;Courier Service&apos;&#13;&#10;WHEN NULL THEN NULL&#13;&#10;ELSE &apos;Local Stores&apos;&#13;&#10;END' />
      </column>
      <column caption='Shopping Cost' datatype='real' name='[Shopping Acquisitions (copy)_1345872659730231300]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_484136962133389312] IN (&apos;DMarts&apos;, &apos;Local Shops&apos;)&#10;THEN [Calculation_1345872659728474114]&#10;ELSE 0 END' />
      </column>
      <column caption='Subchannel (SEM)  ' datatype='string' name='[Subchannel (APP)  (copy 2)]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [subchannel]&#13;&#10;    WHEN &apos;COMP&apos; THEN &apos;COMPETITOR&apos;&#13;&#10;    WHEN &apos;GEN&apos; THEN &apos;GENERIC&apos;&#13;&#10;ELSE [subchannel]&#13;&#10;END' />
      </column>
