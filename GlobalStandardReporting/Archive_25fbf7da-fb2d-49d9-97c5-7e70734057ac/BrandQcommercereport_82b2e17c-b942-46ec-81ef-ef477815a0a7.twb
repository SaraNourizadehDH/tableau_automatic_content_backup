        <view>
          <datasources>
            <datasource caption='Vertical Orders' name='federated.18iwwu60b08r0l1go42ad16yhcvh (copy 2)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date View 1' datatype='string' name='[Parameter 1 1 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18iwwu60b08r0l1go42ad16yhcvh (copy 2)'>
            <column caption='% out of total orders' datatype='real' name='[Calculation_1605885158066196480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_orders]/[QCommerce Order Share  (copy)_507006848677335042]' />
            </column>
            <column caption='Platform Grouped' datatype='string' name='[Calculation_2138154306712477696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LOWER([platform])' />
            </column>
            <column caption='Customer Type' datatype='string' name='[Calculation_484136962283220997]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([loyalty_group] = &apos;Acquisition&apos;, &apos;Acquisition&apos;, &apos;Existing Customer&apos;)' />
            </column>
            <column caption='Channel - Sub-Channel' datatype='string' name='[Calculation_5512124520249184256]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[channel] + &#10;IF [subchannel] = &apos;&apos; THEN &apos;&apos; ELSE &quot; - &quot; + [subchannel] END' />
            </column>
            <column caption='Date View' datatype='datetime' default-format='*yyyy-mm-dd' name='[Calculation_6938076740195209216]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1 2]&#10;WHEN &apos;Daily&apos; THEN [order_date]&#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;, [order_date])&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;, [order_date])&#10;END' />
            </column>
            <column caption='QCommerce Order Share' datatype='real' name='[QCommerce Order Share  (copy)_1605885158066454529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_orders]&#10;/ {FIXED [Calculation_6938076740195209216], [display_name]: &#10;SUM(&#10;IIF([Shop Types (copy)_507006848670797825] = &apos;DMarts&apos; or &#10;[Shop Types (copy)_507006848670797825] = &apos;Local Stores&apos;&#10;, [total_orders], 0))}' />
            </column>
            <column caption='Total Orders' datatype='real' name='[QCommerce Order Share  (copy)_507006848677335042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Calculation_6938076740195209216], [display_name]: &#10;SUM( [total_orders])}' />
            </column>
            <column caption='Shop Types (copy)' datatype='string' name='[Shop Types (copy)_507006848670797825]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [shop_type]&#13;&#10;WHEN &apos;coffee&apos; THEN &apos;Platform&apos;&#13;&#10;WHEN &apos;restaurants&apos; THEN &apos;Platform&apos;&#13;&#10;WHEN &apos;darkstores&apos; THEN &apos;DMarts&apos;&#13;&#10;WHEN &apos;courier&apos; THEN &apos;Courier Service&apos;&#13;&#10;WHEN NULL THEN NULL&#13;&#10;ELSE &apos;Local Stores&apos;&#13;&#10;END' />
