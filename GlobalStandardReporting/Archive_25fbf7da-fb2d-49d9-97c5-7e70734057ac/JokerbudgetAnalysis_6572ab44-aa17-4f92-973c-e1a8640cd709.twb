      <aliases enabled='yes' />
      <column caption='Vendor Count' datatype='integer' name='[Calculation_5517754004062195713]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_id])' />
      </column>
      <column caption='Budget Utilization' datatype='real' name='[Calculation_6073455974395961344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([joker_orders])/sum([joker_available])' />
      </column>
      <column caption='Avg Joker Available' datatype='real' name='[Calculation_6073455974396506113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([joker_available])/(COUNTD([vendor_id]))' />
      </column>
      <column caption='Joker order Share' datatype='real' name='[Calculation_803751822066638848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([joker_orders])/sum([total_orders])' />
      </column>
      <column caption='Joker GMV Share' datatype='real' name='[Joker order Share (copy)_803751822068367362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([joker_gmv])/sum([all_orders_GMV])' />
      </column>
