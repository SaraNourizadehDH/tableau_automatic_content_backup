      <aliases enabled='yes' />
      <column caption='yr_mon' datatype='string' name='[Calculation_579838479154139137]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Yr]+&quot;-&quot;+[Mon]' />
      </column>
      <column caption='TM_tot_pos' datatype='integer' name='[Calculation_579838479154978818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;,[month_number]) = [Calculation_579838479155171331] THEN [Total_POs] END))' />
      </column>
      <column caption='Latest_month' datatype='date' name='[Calculation_579838479155171331]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE({ FIXED :MAX(DATETRUNC(&apos;month&apos;,[month_number]))})' />
      </column>
      <column caption='MoM_tot_po_change' datatype='integer' default-format='*###,###,###▲;-###,###,###▼' name='[Calculation_579838479156146180]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;,[month_number]) = [Calculation_579838479155171331] THEN [Total_POs] END)&#13;&#10;-&#13;&#10;SUM(IF DATETRUNC(&apos;month&apos;,[month_number]) = DATEADD(&apos;month&apos;,-1,[Calculation_579838479155171331]) THEN [Total_POs] END))' />
      </column>
      <column caption='MoM_tot_po_change_perc' datatype='real' default-format='*0.00%▲;-0.00%▼' name='[Calculation_579838479156318213]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;,[month_number]) = [Calculation_579838479155171331] THEN [Total_POs] END)&#13;&#10;-&#13;&#10;SUM(IF DATETRUNC(&apos;month&apos;,[month_number]) = DATEADD(&apos;month&apos;,-1,[Calculation_579838479155171331]) THEN [Total_POs] END))&#13;&#10;/&#13;&#10;SUM(IF DATETRUNC(&apos;month&apos;,[month_number]) = DATEADD(&apos;month&apos;,-1,[Calculation_579838479155171331]) THEN [Total_POs] END)' />
      </column>
      <column caption='YoY_tot_Po_change' datatype='integer' default-format='*###,###,###▲;-###,###,###▼' name='[Calculation_579838479156547590]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;,[month_number]) = [Calculation_579838479155171331] THEN [Total_POs] END)&#13;&#10;-&#13;&#10;SUM(IF DATETRUNC(&apos;month&apos;,[month_number]) = DATEADD(&apos;year&apos;,-1,[Calculation_579838479155171331]) THEN [Total_POs] END))' />
      </column>
      <column caption='MoM_cancelled_po_change' datatype='integer' default-format='*###,###,###▲;-###,###,###▼' name='[MoM_completed_po_change (copy)_579838479180701710]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;,[month_number]) = [Calculation_579838479155171331] THEN [cancelled_pos] END)&#13;&#10;-&#13;&#10;SUM(IF DATETRUNC(&apos;month&apos;,[month_number]) = DATEADD(&apos;month&apos;,-1,[Calculation_579838479155171331]) THEN [cancelled_pos] END))' />
