          <datasource-dependencies datasource='federated.01mkqj01y78giq143apqn00slj6z'>
            <column caption='Latest_month' datatype='date' name='[Calculation_1236238119486464001]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE({ FIXED :MAX(DATETRUNC(&apos;month&apos;,[month_number]))})' />
            </column>
            <column caption='MoM_psp_change' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[MoM_cogs_change (copy)_781374562120024073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM(IF DATETRUNC(&apos;month&apos;,[month_number]) = [Calculation_1236238119486464001] THEN [discounted_units] END)*100)&#13;&#10;/&#13;&#10;(SUM(IF DATETRUNC(&apos;month&apos;,[month_number]) = [Calculation_1236238119486464001] THEN [units_sold] END)))&#13;&#10;-&#13;&#10;&#13;&#10;((SUM(IF DATETRUNC(&apos;month&apos;,[month_number]) = DATEADD(&apos;month&apos;,-1,[Calculation_1236238119486464001]) THEN [discounted_units] END)*100)&#13;&#10;/&#13;&#10;(SUM(IF DATETRUNC(&apos;month&apos;,[month_number]) = DATEADD(&apos;month&apos;,-1,[Calculation_1236238119486464001]) THEN [units_sold] END)))' />
            </column>
            <column caption='TM_psp' datatype='real' default-format='p0.00%' name='[TM_ASP (copy)_781374562097614856]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;,[month_number]) = [Calculation_1236238119486464001] THEN [discounted_units] END))&#13;&#10;/&#13;&#10;(SUM(IF DATETRUNC(&apos;month&apos;,[month_number]) = [Calculation_1236238119486464001] THEN [units_sold] END))' />
            </column>
            <column caption='YoY_psp_change' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[YoY_Units_change (copy)_781374562137235467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;(SUM(IF DATETRUNC(&apos;month&apos;,[month_number]) = [Calculation_1236238119486464001] THEN [discounted_units] END))*100&#13;&#10;/&#13;&#10;(SUM(IF DATETRUNC(&apos;month&apos;,[month_number]) = [Calculation_1236238119486464001] THEN [units_sold] END))&#13;&#10;)&#13;&#10;-&#13;&#10;((SUM(IF DATETRUNC(&apos;month&apos;,[month_number]) = DATEADD(&apos;year&apos;,-1,[Calculation_1236238119486464001]) THEN [discounted_units] END))*100&#13;&#10;/&#13;&#10;((SUM(IF DATETRUNC(&apos;month&apos;,[month_number]) = DATEADD(&apos;year&apos;,-1,[Calculation_1236238119486464001]) THEN [units_sold] END))))' />
            </column>
