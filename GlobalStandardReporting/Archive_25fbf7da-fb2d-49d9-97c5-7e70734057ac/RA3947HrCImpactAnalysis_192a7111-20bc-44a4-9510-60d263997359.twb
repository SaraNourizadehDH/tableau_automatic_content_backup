                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2714' id='33' type-v2='text' w='52952' x='482' y='83141'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#555555'>Date Granularity : &lt;</run>
                    <run bold='true' fontalignment='1' fontcolor='#555555'>[Parameters].[Parameter 2 1]</run>
                    <run bold='true' fontalignment='1' fontcolor='#555555'>&gt;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='13574' id='267' type-v2='text' w='49518' x='482' y='85855'>
                  <formatted-text>
                    <run bold='true'>Calcuation Guide :</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#f4511e'>1</run>
                    <run fontcolor='#000000'>. Chat THT Improvement = percentage change </run>
                    <run fontcolor='#3367d6'>in</run>
                    <run fontcolor='#000000'> chat THT this month compared </run>
                    <run fontcolor='#3367d6'>to</run>
                    <run fontcolor='#000000'> previous month </run>
                    <run fontcolor='#3367d6'>for</run>
                    <run fontcolor='#000000'> HeroCare only</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#f4511e'>2</run>
                    <run fontcolor='#000000'>. Saved </run>
                    <run fontcolor='#3367d6'>time</run>
                    <run fontcolor='#000000'> per chat </run>
                    <run fontcolor='#37474f'>(</run>
                    <run fontcolor='#000000'>mins</run>
                    <run fontcolor='#37474f'>) </run>
                    <run fontcolor='#000000'>=  </run>
                    <run fontcolor='#3367d6'>Avg</run>
                    <run fontcolor='#000000'>. THT Chats </run>
                    <run fontcolor='#37474f'>(</run>
                    <run fontcolor='#000000'>mins</run>
                    <run fontcolor='#37474f'>)</run>
                    <run fontcolor='#000000'>Æ </run>
                    <run fontcolor='#37474f'>*</run>
                    <run fontcolor='#000000'> Chat THT Improvement</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#f4511e'>3</run>
                    <run fontcolor='#000000'>. Non Live AHT Improvement =  percentage change </run>
                    <run fontcolor='#3367d6'>in</run>
                    <run fontcolor='#000000'> non</run>
                    <run fontcolor='#37474f'>-</run>
                    <run fontcolor='#000000'>live AHT this month compared </run>
                    <run fontcolor='#3367d6'>to</run>
                    <run fontcolor='#000000'> previous month </run>
                    <run fontcolor='#3367d6'>for</run>
                    <run fontcolor='#000000'> HeroCare only</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#f4511e'>4</run>
                    <run fontcolor='#000000'>. Saved </run>
                    <run fontcolor='#3367d6'>time</run>
                    <run fontcolor='#000000'> per non</run>
                    <run fontcolor='#37474f'>-</run>
                    <run fontcolor='#000000'>live </run>
                    <run fontcolor='#37474f'>(</run>
                    <run fontcolor='#000000'>mins</run>
                    <run fontcolor='#37474f'>) </run>
                    <run fontcolor='#000000'>= </run>
                    <run fontcolor='#3367d6'>Avg</run>
                    <run fontcolor='#000000'>. HT Non Live </run>
                    <run fontcolor='#37474f'>(</run>
                    <run fontcolor='#000000'>mins</run>
                    <run fontcolor='#37474f'>)</run>
                    <run fontcolor='#000000'>Æ  </run>
                    <run fontcolor='#37474f'>*</run>
                    <run fontcolor='#000000'> Non Live AHT Improvement</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#f4511e'>5</run>
                    <run fontcolor='#000000'>. Adoption Rate Chats </run>
                    <run fontcolor='#37474f'>(</run>
                    <run fontcolor='#000000'>percentage</run>
                    <run fontcolor='#37474f'>)</run>
                    <run fontcolor='#000000'> =  proportion </run>
                    <run fontcolor='#3367d6'>of</run>
                    <run fontcolor='#000000'> chats originating via HeroCare vs. global tools</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#f4511e'>6</run>
                    <run fontcolor='#000000'>. Adoption Rate Non</run>
                    <run fontcolor='#37474f'>-</run>
                    <run fontcolor='#000000'>Live </run>
                    <run fontcolor='#37474f'>(</run>
                    <run fontcolor='#000000'>percentage</run>
                    <run fontcolor='#37474f'>)</run>
                    <run fontcolor='#000000'> =  proportion </run>
                    <run fontcolor='#3367d6'>of</run>
                    <run fontcolor='#000000'> non</run>
                    <run fontcolor='#37474f'>-</run>
                    <run fontcolor='#000000'>live originating via HeroCare vs. global tools</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#f4511e'>7</run>
                    <run fontcolor='#000000'>. Adoption Rate </run>
                    <run fontcolor='#37474f'>(</run>
                    <run fontcolor='#000000'>Chats &amp; Non</run>
                    <run fontcolor='#37474f'>-</run>
                    <run fontcolor='#000000'>Live</run>
                    <run fontcolor='#37474f'>)</run>
                    <run fontcolor='#000000'>Æ </run>
                    <run fontcolor='#37474f'>(</run>
                    <run fontcolor='#000000'>percentage</run>
                    <run fontcolor='#37474f'>)</run>
                    <run fontcolor='#000000'> =  proportion </run>
                    <run fontcolor='#3367d6'>of</run>
                    <run fontcolor='#000000'> chats </run>
                    <run fontcolor='#3367d6'>and</run>
                    <run fontcolor='#000000'> non</run>
                    <run fontcolor='#37474f'>-</run>
                    <run fontcolor='#000000'>live originating via HeroCare vs. global tools</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#f4511e'>8</run>
                    <run fontcolor='#000000'>. Herocare Launch AHT Improvement = Chat THT Improvement  </run>
                    <run fontcolor='#37474f'>+</run>
                    <run fontcolor='#000000'> Non Live AHT Improvement</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#f4511e'>9</run>
                    <run fontcolor='#000000'>. HrC Launch Saved </run>
                    <run fontcolor='#3367d6'>time</run>
                    <run fontcolor='#000000'>Æ </run>
                    <run fontcolor='#37474f'>(</run>
                    <run fontcolor='#000000'>mins</run>
                    <run fontcolor='#37474f'>)</run>
                    <run fontcolor='#000000'> = </run>
                    <run fontcolor='#3367d6'>Avg</run>
                    <run fontcolor='#000000'>. THT Chats </run>
                    <run fontcolor='#37474f'>(</run>
                    <run fontcolor='#000000'>mins</run>
                    <run fontcolor='#37474f'>)</run>
                    <run fontcolor='#000000'>Æ </run>
                    <run fontcolor='#37474f'>*</run>
                    <run fontcolor='#000000'> Herocare Launch AHT Improvement</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='13574' id='269' type-v2='text' w='49518' x='50000' y='85855'>
                  <formatted-text>
                    <run>Æ&#10;</run>
                    <run fontcolor='#f4511e'>10</run>
                    <run fontcolor='#000000'>. Saved Hours = </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>((## of chats * Adoption Rate (Chats &amp; Non-Live) *  Saved time per chat (mins)) + </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>(## of chats * Adoption Rate (Chats &amp; Non-Live) *  HrC Launch Saved time (mins)) + </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>(## of non-live requests * Saved time per non-live (mins)*  Adoption Rate (Chats &amp; Non-Live)))/60</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#f4511e'>11</run>
                    <run fontcolor='#000000'>. Saved FTEs = Saved Hours  </run>
                    <run fontcolor='#37474f'>/</run>
                    <run fontcolor='#000000'>  FTE Hours </run>
                    <run fontcolor='#3367d6'>set</run>
                    <run fontcolor='#000000'>Æ </run>
                    <run fontcolor='#3367d6'>in</run>
                    <run fontcolor='#000000'> Projected Savings section</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#f4511e'>12</run>
                    <run fontcolor='#000000'>. Personnel Savings =  Saved FTEs </run>
                    <run fontcolor='#37474f'>*</run>
                    <run fontcolor='#000000'>Æ </run>
                    <run fontcolor='#3367d6'>Avg</run>
                    <run fontcolor='#000000'>. agent salary </run>
                    <run fontcolor='#3367d6'>set</run>
                    <run fontcolor='#000000'>Æ </run>
                    <run fontcolor='#3367d6'>in</run>
                    <run fontcolor='#000000'> Projected Savings section</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#f4511e'>13</run>
                    <run fontcolor='#000000'>. Non Personnel Savings = Freshchat licences cost  </run>
                    <run fontcolor='#3367d6'>set</run>
                    <run fontcolor='#000000'>Æ </run>
                    <run fontcolor='#3367d6'>in</run>
                    <run fontcolor='#000000'> Projected Savings section </run>
                    <run fontcolor='#37474f'>+</run>
                    <run fontcolor='#000000'> Salesforce licences cost </run>
                    <run fontcolor='#3367d6'>set</run>
                    <run fontcolor='#000000'>Æ </run>
                    <run fontcolor='#3367d6'>in</run>
                    <run fontcolor='#000000'> Projected Savings section </run>
                    <run fontcolor='#37474f'>*</run>
                    <run fontcolor='#000000'> Adoption Rate Chats &amp; Non Live</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#f4511e'>14</run>
                    <run fontcolor='#000000'>. Actual Savings = Personnel Savings </run>
                    <run fontcolor='#37474f'>+</run>
                    <run fontcolor='#000000'> Non Personnel Savings</run>
