            <column caption='Chat Adoption rate (% of requests served by HeroCare)' datatype='real' default-format='p0%' name='[Calculation_3740450661463244828]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE ATTR([Date])&#10;WHEN DATE(&quot;2022-05-01&quot;)&#10;  THEN 1900000/ [Calculation_3740450661445730315]&#10;ELSE (IF PREVIOUS_VALUE(0) + 0.03 &gt; 1 THEN 1 ELSE PREVIOUS_VALUE(0) + 0.03 END)&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Saved time per chat (min)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3740450661464272925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Parameters].[## of chats (copy)_3740450661443002371] * [Parameters].[Request grow rate (in %) (copy)_3740450661443551237])' />
