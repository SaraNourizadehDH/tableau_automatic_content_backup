            <column caption='Non personnel Savings' datatype='real' default-format='c#,##0,.00K&quot; €&quot;;-#,##0,.00K&quot; €&quot;' name='[Calculation_3740450661471641644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Parameters].[Avg. agent salary (in EUR) (copy)_3740450661471887406] + [Parameters].[Freshchat licences cost (copy)_3740450661472264239]) * [## of chats (copy)_3740450661468389413]'>
