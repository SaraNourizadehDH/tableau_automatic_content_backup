            <column caption='Adoption rate (% of requests served by HeroCare for both live and non-live)' datatype='real' default-format='p0.00%' name='[## of chats (copy)_3740450661468389413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE ATTR([Date])&#10;WHEN DATE(&quot;2022-05-01&quot;)&#10;  THEN SUM([Parameters].[Chat AHT improvement (in %) (copy)_3740450661468520486])&#10;ELSE PREVIOUS_VALUE(0) + 0.06&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
