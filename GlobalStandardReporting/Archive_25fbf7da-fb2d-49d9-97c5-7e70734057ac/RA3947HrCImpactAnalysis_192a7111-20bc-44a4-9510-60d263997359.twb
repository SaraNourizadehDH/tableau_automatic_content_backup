              <calculation class='tableau' formula='SUM([Parameters].[## of chats (copy)_3740450661443002371]) * SUM([Parameters].[Chat AHT improvement (in %) (copy)_3740450661465681952])' />
            </column>
            <column caption='Saved Hours' datatype='real' name='[Calculation_3740450661469421609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;  ([Calculation_3740450661456961557] * [## of chats (copy)_3740450661468389413] * [Calculation_3740450661464272925])&#10;   +&#10;  ([Calculation_3740450661456961557] * [## of chats (copy)_3740450661468389413] * [Calculation_3740450661469274152])&#10;   +&#10;   ([## of chats (copy)_3740450661462339610] * [Saved time per chat (min) (copy)_3740450661467340834] * [## of chats (copy)_3740450661468389413])&#10;) /60'>
                <table-calc ordering-type='Rows' />
