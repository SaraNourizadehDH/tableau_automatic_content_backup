            <column caption='## of non-live requests' datatype='real' name='[## of chats (copy)_3740450661462339610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE ATTR([Date])&#10;WHEN DATE(&quot;2022-05-01&quot;)&#10;  THEN SUM([Parameters].[## of chats (copy)_3740450661445488650])&#10;ELSE PREVIOUS_VALUE(0) * SUM(1 + [Parameters].[## of chats (copy)_3740450661443137540])&#10;END'>
