            <column caption='Actual Saved Hours' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1161647232326078465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;  (SUM([count_incoming_chats]) * SUM([adoption_rate_chats_and_non_live]) * [Calculation_3740450661464272925])&#10;   +&#10;  (SUM([count_incoming_chats]) * SUM([adoption_rate_chats_and_non_live]) * [Calculation_3740450661469274152])&#10;   +&#10;   (SUM([count_incoming_non_live]) * [Saved time per chat (min) (copy)_3740450661467340834] * SUM([adoption_rate_chats_and_non_live]))&#10;) /60' />
            </column>
            <column caption='## of customer/vendor/rider requests' datatype='real' name='[Calculation_3740450661445730315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3740450661456961557] + [## of chats (copy)_3740450661462339610]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='## of chats' datatype='real' name='[Calculation_3740450661456961557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE ATTR([Date])&#10;  WHEN DATE(&quot;2022-05-01&quot;)&#10;    THEN SUM([Parameters].[Parameter 2])&#10;  ELSE PREVIOUS_VALUE(0) * SUM(1 + [Parameters].[## of chats (copy)_3740450661443137540])&#10;END'>
