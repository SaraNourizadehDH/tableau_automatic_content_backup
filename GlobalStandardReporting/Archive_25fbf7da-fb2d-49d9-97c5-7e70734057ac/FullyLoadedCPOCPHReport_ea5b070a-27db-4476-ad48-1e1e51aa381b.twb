            <column caption='Time Dimension' datatype='string' name='[Calculation_1647754580089847817]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE   [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN    &apos;Report Date&apos;  THEN     STR([report_date_local])&#13;&#10;&#13;&#10;WHEN  &apos;Report Week&apos; THEN [report_week]&#13;&#10;&#13;&#10;WHEN &apos;Report Month&apos; THEN  [report_month]&#13;&#10;&#10;WHEN &apos;All 8 Weeks&apos; THEN  &apos;&apos;&#13;&#10;END' />
