            <column caption='Total Costs EUR' datatype='real' name='[Calculation_2135269191497048075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Basic (copy)_833165944340946949] + &#13;&#10;[Calculation_2135269191496724486] + &#13;&#10;[Calculation_2135269191496650757] + &#13;&#10;[Calculation_2135269191496892425] +&#13;&#10;[Calculation_2135269191496785927]+&#13;&#10;[Calculation_859061662380531728]+&#13;&#10;[Calculation_1427359657290174465]+&#13;&#10;[Calculation_1427359657289691136]' />
