              <calculation class='tableau' formula='if  [Parameters].[Parameter 7]&#10;&#10;&#10;= &apos;Hidden Basic&apos; then 0 &#10;ELSEIF [Parameters].[Exclude Payment A (copy)_3124442651332010004] &#10;= &apos;Hidden Basic&apos; then 0 &#10;ELSEIF [Parameters].[Exclude Payment B (copy)_3124442651332067349]&#10;=  &apos;Hidden Basic&apos; then 0 &#10;else [hidden_basic_total]&#10;&#10;&#10;END' />
