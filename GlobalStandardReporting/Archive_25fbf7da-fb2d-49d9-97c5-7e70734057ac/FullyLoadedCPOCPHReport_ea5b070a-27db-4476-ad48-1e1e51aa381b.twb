              </calculation>
            </column>
            <column caption='Costs Contribution' datatype='string' name='[Calculation_1071293762908565505]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE  [Parameters].[Parameter 8]&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;Country&apos; THEN [country_name]&#13;&#10;WHEN &apos;City&apos; THEN [city_name]&#13;&#10;WHEN &apos;Contract Type&apos; THEN [contract_type]&#13;&#10;WHEN &apos;Contract Name&apos; THEN [contract_name]&#13;&#10;WHEN  &apos;Batch&apos; THEN STR([batch_number]&#13;&#10;)&#13;&#10;END' />
