            </column>
            <column caption='CPO baseline' datatype='real' name='[Calculation_1440870418492620800]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 10] &#13;&#10;WHEN 0 THEN LOOKUP(([CPO (copy 2)_833165944341774346]),FIRST())&#13;&#10;WHEN 1 THEN LOOKUP(([Calculation_2135269190454149122]),FIRST())&#13;&#10;END'>
