            </column>
            <column caption='Choose Graph Type' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;CPO&quot;'>
              <calculation class='tableau' formula='&quot;CPO&quot;' />
            </column>
            <column caption='Exclude Payment A' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
              <calculation class='tableau' formula='&quot;None&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1agcisb0glw0qp16ly0wl09ihind'>
            <column caption='# Scoring (exclusion)' datatype='real' name='[# Basic (exclusion) (copy)_3124442651330498572]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  [Parameters].[Parameter 7]&#10;&#10;&#10;= &apos;Scoring&apos; then 0 &#10;ELSEIF [Parameters].[Exclude Payment A (copy)_3124442651332010004] &#10;= &apos;Scoring&apos; then 0 &#10;ELSEIF [Parameters].[Exclude Payment B (copy)_3124442651332067349]&#10;=  &apos;Scoring&apos; then 0 &#10;else [scoring_payment_total]&#10;end' />
            </column>
            <column caption='# Quest (exclusion)' datatype='real' name='[# Hidden Basic (exclusion) (copy)_3124442651331219474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  [Parameters].[Parameter 7]&#10;&#10;&#10;= &apos;Quest&apos; then 0 &#10;ELSEIF [Parameters].[Exclude Payment A (copy)_3124442651332010004] &#10;= &apos;Quest&apos; then 0 &#10;ELSEIF [Parameters].[Exclude Payment B (copy)_3124442651332067349]&#10;=  &apos;Quest&apos; then 0 &#10;else [quest_payment_total]&#10;&#10;&#10;END' />
            </column>
            <column caption='# Tip (exclusion)' datatype='real' name='[# New Hire Benefit (exclusion) (copy)_3124442651330899984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  [Parameters].[Parameter 7]&#10;&#10;&#10;= &apos;Tip&apos; then 0 &#10;ELSEIF [Parameters].[Exclude Payment A (copy)_3124442651332010004] &#10;= &apos;Tip&apos; then 0 &#10;ELSEIF [Parameters].[Exclude Payment B (copy)_3124442651332067349]&#10;=  &apos;Tip&apos; then 0 &#10;else [tip_payment_total]&#10;end' />
            </column>
            <column caption='# Special (exclusion)' datatype='real' name='[# Scoring (exclusion) (copy)_3124442651330670605]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  [Parameters].[Parameter 7]&#10;&#10;&#10;= &apos;Special&apos; then 0 &#10;ELSEIF [Parameters].[Exclude Payment A (copy)_3124442651332010004] &#10;= &apos;Special&apos; then 0 &#10;ELSEIF [Parameters].[Exclude Payment B (copy)_3124442651332067349]&#10;=  &apos;Special&apos; then 0 &#10;else [special_payment_total]&#10;end' />
            </column>
            <column caption='# New Hire Benefit (exclusion)' datatype='real' name='[# Special (exclusion) (copy)_3124442651330801679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  [Parameters].[Parameter 7]&#10;&#10;&#10;= &apos;New Hire Benefit&apos; then 0 &#10;ELSEIF [Parameters].[Exclude Payment A (copy)_3124442651332010004] &#10;= &apos;New Hire Benefit&apos; then 0 &#10;ELSEIF [Parameters].[Exclude Payment B (copy)_3124442651332067349]&#10;=  &apos;New Hire Benefit&apos; then 0 &#10;else [new_hire_benefit_payment_total]&#10;END' />
            </column>
            <column caption='# Hidden Basic (exclusion)' datatype='real' name='[# Tip (exclusion) (copy)_3124442651331088401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  [Parameters].[Parameter 7]&#10;&#10;&#10;= &apos;Hidden Basic&apos; then 0 &#10;ELSEIF [Parameters].[Exclude Payment A (copy)_3124442651332010004] &#10;= &apos;Hidden Basic&apos; then 0 &#10;ELSEIF [Parameters].[Exclude Payment B (copy)_3124442651332067349]&#10;=  &apos;Hidden Basic&apos; then 0 &#10;else [hidden_basic_total]&#10;&#10;&#10;END' />
            </column>
            <column caption='Time Dimension' datatype='string' name='[Calculation_1647754580089847817]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE   [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN    &apos;Report Date&apos;  THEN     STR([report_date_local])&#13;&#10;&#13;&#10;WHEN  &apos;Report Week&apos; THEN [report_week]&#13;&#10;&#13;&#10;WHEN &apos;Report Month&apos; THEN  [report_month]&#13;&#10;&#10;WHEN &apos;All 8 Weeks&apos; THEN  &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Total Costs' datatype='real' name='[Calculation_2135269190453858305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3124442651330076683] + &#13;&#10;[# Basic (exclusion) (copy)_3124442651330498572] + &#13;&#10;[# Hidden Basic (exclusion) (copy)_3124442651331219474] +&#13;&#10;[referral_payment_total] +&#13;&#10;[# Scoring (exclusion) (copy)_3124442651330670605]       +&#13;&#10;[# Tip (exclusion) (copy)_3124442651331088401]+&#13;&#10;[# New Hire Benefit (exclusion) (copy)_3124442651330899984]+&#13;&#10;[# Special (exclusion) (copy)_3124442651330801679]' />
            </column>
            <column caption='CPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2135269190454149122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2135269190453858305]) / SUM([deliveries])' />
            </column>
            <column caption='CPO variation' datatype='real' default-format='p0.0%' name='[Calculation_217298714041180160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_2135269190454149122]) - LOOKUP(ZN([Calculation_2135269190454149122]), -1)) / ABS(LOOKUP(ZN([Calculation_2135269190454149122]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='# Basic (exclusion)' datatype='real' name='[Calculation_3124442651330076683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  [Parameters].[Parameter 7]&#10;&#10;&#10;= &apos;Basic&apos; then 0 &#10;ELSEIF [Parameters].[Exclude Payment A (copy)_3124442651332010004] &#10;= &apos;Basic&apos; then 0 &#10;ELSEIF [Parameters].[Exclude Payment B (copy)_3124442651332067349]&#10;=  &apos;Basic&apos; then 0 &#10;else [basic_total]&#10;&#10;&#10;END' />
            </column>
            <column caption='Absolute or variation' datatype='string' name='[Calculation_788692917728010240]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 6]' />
