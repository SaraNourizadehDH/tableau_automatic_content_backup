            <column caption='CPO EUR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[CPO (copy 2)_833165944341774346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2135269191497048075]) / SUM([deliveries])' />
