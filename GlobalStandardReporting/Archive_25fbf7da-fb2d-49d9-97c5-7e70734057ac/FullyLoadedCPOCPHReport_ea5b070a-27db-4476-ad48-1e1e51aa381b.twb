              <calculation class='tableau' formula='[Calculation_3124442651330076683] + &#13;&#10;[# Basic (exclusion) (copy)_3124442651330498572] + &#13;&#10;[# Hidden Basic (exclusion) (copy)_3124442651331219474] +&#13;&#10;[referral_payment_total] +&#13;&#10;[# Scoring (exclusion) (copy)_3124442651330670605]       +&#13;&#10;[# Tip (exclusion) (copy)_3124442651331088401]+&#13;&#10;[# New Hire Benefit (exclusion) (copy)_3124442651330899984]+&#13;&#10;[# Special (exclusion) (copy)_3124442651330801679]' />
