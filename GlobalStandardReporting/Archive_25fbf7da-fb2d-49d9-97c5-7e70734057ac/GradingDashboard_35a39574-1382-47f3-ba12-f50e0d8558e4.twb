        <calculation class='tableau' formula='IF [vendor_grade]=&apos;Ungraded&apos; then [leads] END' />
      </column>
      <column caption='%Of Ungraded' datatype='real' name='[%Of null (copy)_1523201888945668111]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([# Of non graded (Null) (copy)_1523201888945520654])/ SUM([leads])' />
      </column>
      <column caption='AVG days to be activated' datatype='real' name='[AVG days to be converted (copy)_1523201888934596621]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(DATEDIFF(&apos;day&apos;,[account_created_date],[activation_date])*[leads])' />
      </column>
      <column caption='Closed won leads' datatype='integer' name='[Active leads (copy)_6866863585696444416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [closed_won] THEN [leads] end' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_641762991592550405]) / TOTAL(SUM([Calculation_641762991592550405]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='Source' datatype='string' name='[Calculation_1063271776383561729]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2]=&apos;Zoom +&apos; THEN [Lead_source] ELSE &apos;Source&apos; end' />
      </column>
      <column caption='accurate' datatype='integer' name='[Calculation_1523201888500789249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [active] and [vendor_grade]=[grade_achieved] THEN [leads] END' />
      </column>
      <column caption='has gmv' datatype='boolean' name='[Calculation_1523201888501039106]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  ISNULL([gmv]) then FALSE else TRUE end' />
      </column>
      <column caption='%accurate' datatype='real' name='[Calculation_1523201888501370883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1523201888500789249])/sum([Calculation_641762990868578304])' />
      </column>
      <column caption='%of acurate leads' datatype='real' name='[Calculation_1523201888544018436]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1523201888500789249])/&#10;sum(if ISNULL([grade_achieved])= FALSE or [grade_achieved] &lt;&gt; &apos;Ungraded&apos;&#10;then [Calculation_641762990868578304] end )' />
      </column>
      <column caption='Grade completeness' datatype='string' name='[Calculation_1523201888562229253]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([vendor_grade]) or [Calculation_460493109023535114]=&apos;Ungraded&apos; then [Calculation_460493109023535114] ELSE &apos;Graded&apos; END' />
      </column>
      <column caption='Graded leads' datatype='integer' name='[Calculation_1523201888564166662]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_1523201888562229253]=&apos;Graded&apos; then [leads] END' />
      </column>
      <column caption='% Graded leads' datatype='real' name='[Calculation_1523201888565116935]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1523201888564166662])/sum([leads])' />
      </column>
      <column caption='AVG days to be converted' datatype='real' name='[Calculation_1523201888896725001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(DATEDIFF(&apos;day&apos;,[lead_created_date],[account_created_date])*[leads])' />
      </column>
      <column caption='Pending to be converted' datatype='integer' name='[Calculation_1523201888897794058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [isconverted] then NULL else [leads] end' />
      </column>
      <column caption='Converted but not activated' datatype='integer' name='[Calculation_1523201888898191371]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [isconverted] and [active]= false then [leads] end' />
      </column>
      <column caption='AVG Current age' datatype='real' name='[Calculation_1523201888899026956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG( IF  [active]=FALSE then DATEDIFF(&apos;day&apos;,[lead_created_date], TODAY()) end )' />
      </column>
      <column caption='Cuisine match' datatype='boolean' name='[Calculation_2829104991222493184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS([sf_cuisine],[main_cuisine])' />
      </column>
      <column caption='Funnel stage' datatype='string' name='[Calculation_460493108662419457]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [closed_won] then &apos;Closed Won&apos; ELSEIF [isconverted] then &apos;Converted&apos; ELSE &apos;Lead Created&apos; end' />
      </column>
      <column caption='Grading' datatype='string' name='[Calculation_460493108665946118]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&apos;Zoom +&apos; then [vendor_grade] ELSE &apos;Edit parametrs for grade details&apos; END' />
