      </column>
      <column caption='Active leads' datatype='integer' name='[Calculation_641762990868578304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [active] THEN [leads] end' />
      </column>
      <column caption='GMV/Active leads' datatype='real' name='[Calculation_641762990868746241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv])/SUM([Calculation_641762990868578304])' />
      </column>
      <column caption='%Of null' datatype='real' name='[Calculation_641762991579029508]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF ISNULL([vendor_grade]) then [leads] END) / SUM(leads)' />
