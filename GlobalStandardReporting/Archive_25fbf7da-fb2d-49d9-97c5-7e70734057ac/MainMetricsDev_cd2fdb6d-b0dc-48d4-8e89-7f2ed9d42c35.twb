      <column caption='Total Revenue Increase' datatype='real' default-format='c#,##0,.0K&quot; €&quot;;-#,##0,.0K&quot; €&quot;' name='[Calculation1 (copy) (copy)_1989816983527145474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([cpc_revenue_eur] - ([cpc_revenue_eur] / (1+[cpc_revenue_uplift]))) &#10;+ &#10;([commission_eur] - ([commission_eur]/ (1+[cr_revenue_uplift])))' />
      </column>
      <column caption='Commission Revenue Increase' datatype='real' default-format='c#,##0,.0K&quot; €&quot;;-#,##0,.0K&quot; €&quot;' name='[Calculation1 (copy)_1989816983526907905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[commission_eur] - ([commission_eur]/ (1+[cr_revenue_uplift]))' />
      </column>
      <column caption='CPC Revenue Increase' datatype='real' default-format='c#,##0,.0K&quot; €&quot;;-#,##0,.0K&quot; €&quot;' name='[Calculation_1989816983526612992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[cpc_revenue_eur] - ([cpc_revenue_eur]/ (1+[cpc_revenue_uplift]))' />
      </column>
      <column caption='Date To' datatype='date' name='[Calculation_1989816983530741763]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([date_month])' />
      </column>
      <column caption='CTR' datatype='real' default-format='p0.00%' name='[Calculation_5642869663487729664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([clicks])/SUM([requests])' />
      </column>
      <column caption='CVR' datatype='real' default-format='p0.00%' name='[Calculation_5642869663487901697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])/SUM([clicks])' />
      </column>
      <column caption='CPC Revenue per Request' datatype='real' default-format='c#,##0.0000&quot; €&quot;;-#,##0.0000&quot; €&quot;' name='[Calculation_5642869663487991810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cpc_revenue_eur])/SUM([requests])' />
      </column>
      <column caption='Commission Revenue per Request' datatype='real' default-format='c#,##0.0000&quot; €&quot;;-#,##0.0000&quot; €&quot;' name='[Calculation_5642869663488139267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([commission_eur])/SUM([requests])' />
      </column>
      <column caption='Total Revenue per Request' datatype='real' default-format='c#,##0.0000&quot; €&quot;;-#,##0.0000&quot; €&quot;' name='[Calculation_5642869663488458758]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(cpc_revenue_eur)+ SUM(commission_eur))/SUM([requests])' />
      </column>
