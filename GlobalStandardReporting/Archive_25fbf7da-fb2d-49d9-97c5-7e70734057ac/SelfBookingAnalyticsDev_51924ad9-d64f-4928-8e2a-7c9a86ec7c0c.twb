    <worksheet name='Bids, Budget, ROAS'>
      <table>
        <view>
          <datasources>
            <datasource caption='self_booking_mbr (analytics)' name='federated.12a431z0x4j3ro1c5t0z50aavzd9' />
          </datasources>
          <datasource-dependencies datasource='federated.12a431z0x4j3ro1c5t0z50aavzd9'>
            <column caption='CPC Avg Budget Self Booking' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[CPC Avg Bid Self Booking (copy)_69172530112696328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_budget_sb])/sum([cpc_bookings_sb])' />
            </column>
            <column caption='CPC Avg Bid Self Booking' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_69172530112389127]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_bids_sb])/sum([cpc_bookings_sb])' />
            </column>
            <column caption='CPC Avg ROAS Self Booking' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_69172530112868361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_vendor_revenue_sb])/sum([cpc_revenue_sb])' />
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='County' datatype='string' name='[county]' role='dimension' semantic-role='[County].[Name]' type='nominal' />
            <column caption='Cpc Bids Sb' datatype='real' name='[cpc_bids_sb]' role='measure' type='quantitative' />
