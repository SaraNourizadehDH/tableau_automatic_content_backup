    <worksheet name='CPC Product Conv'>
      <table>
        <view>
          <datasources>
            <datasource caption='self_booking_mbr (analytics)' name='federated.12a431z0x4j3ro1c5t0z50aavzd9' />
          </datasources>
          <datasource-dependencies datasource='federated.12a431z0x4j3ro1c5t0z50aavzd9'>
            <column caption='+ CPC Delta Product Conv' datatype='string' name='[+ FP Delta Product Conv (copy)_1202390788303466548]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Delta Last Month CPC New SB share (copy)_1202390788302549039] &gt; 0 then &apos;▲&apos; end' />
            </column>
            <column caption='- CPC Delta Product Conv' datatype='string' name='[- CPC Delta New SB (copy)_1202390788302913585]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Delta Last Month CPC New SB share (copy)_1202390788302549039] &lt; 0 then &apos;▼&apos; end' />
            </column>
            <column caption='Current Month' datatype='date' default-format='*MMM yy' name='[Calculation_1202390787910475781]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='max([date_month])' />
            </column>
            <column caption='Delta Last Month CPC Product Conv' datatype='real' default-format='*0.0ppt' name='[Delta Last Month CPC New SB share (copy)_1202390788302549039]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Last Month CPC New SB share (copy)_1202390788302270509] - sum(if {fixed:dateadd(&apos;month&apos;, -1, max([date_month]))} = [date_month] then [cpc_booking_success_sessions] end)&#10;/ sum(if {fixed:dateadd(&apos;month&apos;, -1, max([date_month]))} = [date_month] then [cpc_booking_sessions] end))*100' />
            </column>
            <column caption='Last Month CPC Product Conv' datatype='real' default-format='p0.0%' name='[Last Month CPC New SB share (copy)_1202390788302270509]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if {fixed:dateadd(&apos;month&apos;, 0, max([date_month]))} = [date_month] then [cpc_booking_success_sessions] end)&#10;/ sum(if {fixed:dateadd(&apos;month&apos;, 0, max([date_month]))} = [date_month] then [cpc_booking_sessions] end)' />
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='County' datatype='string' name='[county]' role='dimension' semantic-role='[County].[Name]' type='nominal' />
            <column caption='CPC Booking Page Sessions' datatype='integer' name='[cpc_booking_sessions]' role='measure' type='quantitative' />
            <column caption='CPC Booking Success Sessions' datatype='integer' name='[cpc_booking_success_sessions]' role='measure' type='quantitative' />
            <column caption='Date Month' datatype='date' name='[date_month]' role='dimension' type='ordinal' />
            <column caption='Is Zombie' datatype='boolean' name='[is_zombie]' role='dimension' type='nominal' />
            <column-instance column='[brand]' derivation='None' name='[none:brand:nk]' pivot='key' type='nominal' />
