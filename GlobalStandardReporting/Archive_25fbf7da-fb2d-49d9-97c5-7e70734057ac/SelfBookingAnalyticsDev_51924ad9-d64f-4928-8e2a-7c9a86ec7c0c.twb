    <worksheet name='Metrics Glossary'>
      <table>
        <view>
          <datasources>
            <datasource caption='self_booking_analytics_ab_dashboard (analytics)' name='federated.164afhd1bztqvs17ybb7u0kvjsjk' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Scale' datatype='string' name='[Metrics (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.164afhd1bztqvs17ybb7u0kvjsjk'>
            <column caption='Date' datatype='date' name='[Calculation_2610258227957329921]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(datetrunc([Parameters].[Metrics (copy)], [session_date]))' />
            </column>
            <column caption='USER ACCESS' datatype='boolean' name='[Calculation_4828069950911795204]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='USERNAME() = [username]' />
            </column>
            <column caption='Device Type' datatype='string' name='[device_type]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4828069950911795204]' derivation='None' name='[none:Calculation_4828069950911795204:nk]' pivot='key' type='nominal' />
            <column-instance column='[device_type]' derivation='None' name='[none:device_type:nk]' pivot='key' type='nominal' />
            <column caption='Session Date' datatype='date' name='[session_date]' role='dimension' type='ordinal' />
            <column caption='Username' datatype='string' name='[username]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2610258227957329921]' derivation='Year' name='[yr:Calculation_2610258227957329921:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.164afhd1bztqvs17ybb7u0kvjsjk].[none:device_type:nk]' filter-group='14'>
            <groupfilter function='level-members' level='[none:device_type:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.164afhd1bztqvs17ybb7u0kvjsjk].[none:Calculation_4828069950911795204:nk]</column>
            <column>[federated.164afhd1bztqvs17ybb7u0kvjsjk].[none:device_type:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='table'>
            <format attr='background-color' value='#990000' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.164afhd1bztqvs17ybb7u0kvjsjk].[yr:Calculation_2610258227957329921:ok]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold='true'>Metrics Glossary:</run>
                <run>Æ&#10;</run>
                <run bold='true'>- CPC Page Users: </run>
                <run>sum(users, who opened CPC booking page)</run>
                <run>Æ&#10;</run>
                <run bold='true'>- CPC Booking Users: </run>
                <run>sum(users, who created CPC booking)</run>
                <run>Æ&#10;</run>
                <run bold='true'>- CPC: % Acquisition Conversion: </run>
                <run>sum(</run>
                <run bold='true'>CPC  Booking Users</run>
                <run>)/sum(</run>
                <run bold='true'>CPC Page Users)</run>
                <run>Æ&#10;</run>
                <run bold='true'>- CPC Page Opened Sessions: </run>
                <run>sum(sessions, in which  CPC booking page was opened)</run>
                <run>Æ&#10;</run>
                <run bold='true'>- CPC Booking Sessions: </run>
                <run>sum(sessions, in which CPC booking was created)</run>
                <run>Æ&#10;</run>
                <run bold='true'>- CPC: % Session Conversion: </run>
                <run>sum(</run>
                <run bold='true'>CPC  Booking Sessions</run>
                <run>)/sum(</run>
                <run bold='true'>CPC Page Opened Sessions)</run>
                <run>Æ&#10;</run>
                <run bold='true'>- CPC Opened Vendors Sessions: </run>
                <run>the same as </run>
                <run bold='true'>CPC Page Opened Sessions </run>
                <run>but for each vendor in the session </run>
                <run bold='true'>Æ </run>
                <run>Æ&#10;</run>
                <run bold='true'>- CPC Booking Vendors Sessions: </run>
                <run>the same as </run>
                <run bold='true'>CPC Booking Sessions </run>
                <run>but for each vendor in the session </run>
                <run bold='true'>Æ </run>
                <run>Æ&#10;</run>
                <run bold='true'>- CPC: % Product Conversion: </run>
                <run>sum(</run>
                <run bold='true'>CPC  Booking Vendors Sessions</run>
                <run>)/sum(</run>
                <run bold='true'>CPC Opened Vendors Sessions)</run>
                <run>Æ&#10;</run>
                <run bold='true'>- Total Bookings: </run>
                <run>total number of bookings</run>
                <run>Æ&#10;</run>
                <run bold='true'>- Bookings per User: </run>
                <run>sum(</run>
                <run bold='true'>Total Bookings</run>
                <run>)/sum(</run>
                <run bold='true'>CPC Page Users</run>
                <run>)</run>
                <run>Æ&#10;</run>
                <run bold='true'>- CPC: Booked Budget Eur: </run>
                <run>sum(booked budget eur)</run>
                <run>Æ&#10;</run>
                <run bold='true'>- CPC: AVG Budget Eur: </run>
                <run>sum(</run>
                <run bold='true'>CPC: Booked Budget Eur</run>
                <run>)/sum(</run>
                <run bold='true'>Total Bookings)</run>
                <run>Æ&#10;</run>
                <run bold='true'>- CPC: ROAS: </run>
                <run>sum(GMV received by vendor)/sum(CPC Revenue</run>
                <run bold='true'>)</run>
                <run>Æ&#10;</run>
                <run bold='true'>- CPC: % Budget Utilisation: </run>
                <run>sum(CPC Revenue)/sum(</run>
                <run bold='true'>CPC: Booked Budget Eur)</run>
                <run>Æ&#10;</run>
                <run bold='true'>- CPC: AVG Budget Eur: </run>
                <run>sum(total bids sum)/sum(</run>
                <run bold='true'>Total Bookings)</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true'>More info - https://confluence.deliveryhero.com/pages/viewpage.action?pageId=517900173</run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
              <formatted-text>
                <run bold='true' fontcolor='#ffffff'>Metrics </run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#ffffff'>Glossary</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-labels-show' value='true' />
              </style-rule>
              <style-rule element='pane'>
                <format attr='minwidth' value='-1' />
                <format attr='maxwidth' value='-1' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid='{44B6CAFD-09A8-40D5-8160-61F7D56EE70B}' />
    </worksheet>
