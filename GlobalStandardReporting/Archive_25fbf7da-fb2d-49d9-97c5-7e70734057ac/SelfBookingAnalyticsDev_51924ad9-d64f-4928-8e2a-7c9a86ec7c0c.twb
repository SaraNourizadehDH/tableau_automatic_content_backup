      <column caption='CPC Avg Budget Self Booking' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[CPC Avg Bid Self Booking (copy)_69172530112696328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cpc_budget_sb])/sum([cpc_bookings_sb])' />
      </column>
      <column caption='Current Month' datatype='date' default-format='*MMM yy' name='[Calculation_1202390787910475781]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='max([date_month])' />
      </column>
      <column caption='Month Filter' datatype='string' name='[Calculation_1202390787910758406]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([date_month] = DATETRUNC(&apos;month&apos;,TODAY()),&apos;true&apos;,&apos;false&apos;)' />
      </column>
      <column caption='Last Month CPC New SB share' datatype='real' default-format='p0.0%' name='[Calculation_1202390787946885132]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if {fixed:dateadd(&apos;month&apos;, 0, max([date_month]))} = [date_month] then [cpc_new_bookings_sb] end)&#10;/ sum(if {fixed:dateadd(&apos;month&apos;, 0, max([date_month]))} = [date_month] then [cpc_new_bookings] end)' />
      </column>
      <column caption='+ CPC Delta New SB' datatype='string' name='[Calculation_1202390787949510670]' role='measure' type='nominal'>
