      <column caption='CPC: AVG Bid Price Eur' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Calculation_6644005785177616384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cpc_price_eur])/sum([bookings])' />
