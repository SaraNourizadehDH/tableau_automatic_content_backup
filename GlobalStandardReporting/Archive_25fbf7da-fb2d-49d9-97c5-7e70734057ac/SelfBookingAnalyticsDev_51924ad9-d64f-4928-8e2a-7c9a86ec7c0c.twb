    <worksheet name='MBR CPC Commercial Contrywise (table)'>
      <table>
        <view>
          <datasources>
            <datasource caption='self_booking_mbr (analytics)' name='federated.12a431z0x4j3ro1c5t0z50aavzd9' />
          </datasources>
          <datasource-dependencies datasource='federated.12a431z0x4j3ro1c5t0z50aavzd9'>
            <column caption='% CPC New Self Booking Share' datatype='real' default-format='p0.0%' name='[% CPC Self Booking Share (copy)_69172529600610307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_new_bookings_sb])/sum([cpc_new_bookings])' />
            </column>
            <column caption='% CPC Self Booking Share' datatype='real' default-format='p0.0%' name='[Calculation_69172529580486658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_bookings_sb])/sum([cpc_bookings])' />
            </column>
            <column caption='% CPC Self Booking Revenue' datatype='real' default-format='p0.0%' name='[Calculation_69172529602596868]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_revenue_sb]) / sum([cpc_revenue])' />
            </column>
            <column caption='% CPC churned Self Booking vendors' datatype='real' default-format='p0.0%' name='[Calculation_69172529604714502]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_churned_vendors_sb])/sum([unique_vendors_sb_pm])' />
