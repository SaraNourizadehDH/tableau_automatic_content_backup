    <worksheet name='FP Product Conv'>
      <table>
        <view>
          <datasources>
            <datasource caption='self_booking_mbr (analytics)' name='federated.12a431z0x4j3ro1c5t0z50aavzd9' />
          </datasources>
          <datasource-dependencies datasource='federated.12a431z0x4j3ro1c5t0z50aavzd9'>
            <column caption='+ FP Delta Product Conv' datatype='string' name='[+ FP Delta New SB (copy)_1202390788303364147]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Delta Last Month CPC Product Conv (copy)_1202390788302700592] &gt; 0 then &apos;▲&apos; end' />
            </column>
            <column caption='- FP Delta Product Conv' datatype='string' name='[- CPC Delta Product Conv (copy)_1202390788303028274]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Delta Last Month CPC Product Conv (copy)_1202390788302700592] &lt; 0 then &apos;▼&apos; end' />
            </column>
            <column caption='Current Month' datatype='date' default-format='*MMM yy' name='[Calculation_1202390787910475781]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='max([date_month])' />
            </column>
            <column caption='Delta Last Month FP Product Conv' datatype='real' default-format='*0.0ppt' name='[Delta Last Month CPC Product Conv (copy)_1202390788302700592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Last Month CPC Product Conv (copy)_1202390788302372910] - sum(if {fixed:dateadd(&apos;month&apos;, -1, max([date_month]))} = [date_month] then [fp_booking_success_sessions] end)&#10;/ sum(if {fixed:dateadd(&apos;month&apos;, -1, max([date_month]))} = [date_month] then [fp_booking_sessions] end))*100' />
            </column>
            <column caption='Last Month FP Product Conv' datatype='real' default-format='p0.0%' name='[Last Month CPC Product Conv (copy)_1202390788302372910]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if {fixed:dateadd(&apos;month&apos;, 0, max([date_month]))} = [date_month] then [fp_booking_success_sessions] end)&#10;/ sum(if {fixed:dateadd(&apos;month&apos;, 0, max([date_month]))} = [date_month] then [fp_booking_sessions] end)' />
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='County' datatype='string' name='[county]' role='dimension' semantic-role='[County].[Name]' type='nominal' />
            <column caption='Date Month' datatype='date' name='[date_month]' role='dimension' type='ordinal' />
            <column caption='FP Booking Page Sessions' datatype='integer' name='[fp_booking_sessions]' role='measure' type='quantitative' />
