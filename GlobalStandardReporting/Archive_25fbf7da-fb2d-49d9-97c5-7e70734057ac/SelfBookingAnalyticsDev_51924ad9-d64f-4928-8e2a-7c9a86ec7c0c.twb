            <column caption='% Conv Marketing -&gt; FP Product Page' datatype='real' default-format='p0.0%' name='[% Conv Marketing -&gt; CPC Product Page (copy)_1202390788295737375]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fp_booking_sessions])/sum([marketing_sessions])' />
            </column>
            <column caption='% Conv Marketing -&gt; Joker Product Page' datatype='real' default-format='p0.0%' name='[% Conv Marketing -&gt; CPC Product Page (copy)_1202390791934697570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([joker_booking_sessions])/sum([marketing_sessions])' />
            </column>
            <column caption='% Conv Marketing -&gt; Discounts Product Page' datatype='real' default-format='p0.0%' name='[% Conv Marketing -&gt; Joker Product Page (copy)_1202390791934877795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vfd_booking_sessions])/sum([marketing_sessions])' />
            </column>
            <column caption='% Conv Marketing -&gt; Any Product Page' datatype='real' default-format='p0.0%' name='[% Conv Marketing -&gt; Joker Product Page (copy)_1202390791936462948]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([any_product_booking_sessions])/sum([marketing_sessions])' />
            </column>
            <column caption='% Conv Marketing -&gt; CPC Product Page' datatype='real' default-format='p0.0%' name='[Calculation_1202390788295507998]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_booking_sessions])/sum([marketing_sessions])' />
