          <datasource-dependencies datasource='federated.164afhd1bztqvs17ybb7u0kvjsjk'>
            <column caption='CPC: % Booking Users with Recommended Budget' datatype='real' default-format='p0.0%' name='[CPC: % Acquisition Conversion (copy)_1464373613218340865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_booking_users_recommended_budget])/sum([cpc_booking_users])' />
            </column>
            <column caption='Marketing  % Conversion' datatype='real' default-format='p0.00%' name='[CPC: % Acquisition Conversion (copy)_3214514663497338908]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3214514663496777750])/sum([mkt_opened_users])' />
            </column>
            <column caption='CPC: % Bookings Sessions with Recommended Budget' datatype='real' default-format='p0.0%' name='[CPC: % Bookings Sessions with Recommended Bid (copy)_1464373613238366214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_booking_sessions_recommended_budget])/sum([cpc_booking_sessions])' />
            </column>
            <column caption='CPC: % Bookings Sessions with Recommended Bid' datatype='real' default-format='p0.0%' name='[CPC: % Bookings with Recommended Bid (copy)_1464373613238095877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_booking_sessions_recommended_bid])/sum([cpc_booking_sessions])' />
            </column>
            <column caption='CPC: % Acquisition Conversion' datatype='real' default-format='p0.00%' name='[CPC: % Product Conversion (copy)_6644005786959806484]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_booking_users])/sum([cpc_opened_users])' />
            </column>
            <column caption='CPC: % Booking Users with Recommended Bid' datatype='real' default-format='p0.0%' name='[CPC: % Recommended Budget (copy)_1464373613218623490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_booking_users_recommended_bid])/sum([cpc_booking_users])' />
            </column>
            <column caption='CPC: % Session Conversion' datatype='real' default-format='p0.0%' name='[CPC: % Session Conversion (control) (copy)_6644005786972463141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_booking_sessions])/sum([cpc_opened_sessions])' />
