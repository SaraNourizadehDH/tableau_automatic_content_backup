      </column>
      <column caption='% FP Product Conversion' datatype='real' default-format='p0.0%' name='[Calculation_1202390788294766620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([fp_booking_success_sessions])/sum([fp_booking_sessions])' />
      </column>
      <column caption='% Conv Marketing -&gt; CPC Product Page' datatype='real' default-format='p0.0%' name='[Calculation_1202390788295507998]' role='measure' type='quantitative'>
