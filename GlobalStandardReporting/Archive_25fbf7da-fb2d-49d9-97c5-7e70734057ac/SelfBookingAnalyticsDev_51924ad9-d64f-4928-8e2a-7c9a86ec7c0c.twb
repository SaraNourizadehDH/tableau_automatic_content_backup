            <column caption='% FP New Self Booking Share' datatype='real' default-format='p0.0%' name='[% CPC New Self Booking Share (copy)_1202390787906342913]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fp_new_bookings_sb])/sum([fp_new_bookings])' />
            </column>
            <column caption='% FP Self Booking Revenue' datatype='real' default-format='p0.0%' name='[% CPC Self Booking Revenue (copy)_1202390787906674691]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fp_revenue_sb]) / sum([fp_revenue])' />
