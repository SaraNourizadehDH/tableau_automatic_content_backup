          <datasource-dependencies datasource='federated.1ybgi1l01niiqf1dlwqtf0hu8i52'>
            <column caption='CPC: % bid selected' datatype='real' default-format='p0.00%' name='[CPC: % Terms and Conditions Cliked (copy)_2610258227960901635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_bid_selected])/sum([cpc_booking_entered_sessions])' />
            </column>
            <column caption='CPC: % promo area edit clicked' datatype='real' default-format='p0.00%' name='[CPC: % bid selected (copy)_2610258227961757703]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_edit_promo_area_sessions])/sum([cpc_booking_entered_sessions])' />
            </column>
            <column caption='CPC: % booking created' datatype='real' default-format='p0.00%' name='[CPC: % budget selected (copy)_2610258227961417734]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_bookings_sessions])/sum([cpc_booking_entered_sessions])' />
            </column>
            <column caption='CPC: % budget selected' datatype='real' default-format='p0.00%' name='[CPC: % terms and conditions clicked (copy)_2610258227961081860]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_budget_selected])/sum([cpc_booking_entered_sessions])' />
            </column>
            <column caption='Date' datatype='datetime' name='[Calculation_1972224795003691020]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [granularity]&#10;WHEN &apos;Monthly&apos;&#10;THEN DATETRUNC(&apos;month&apos;, [session_date])&#10;WHEN &apos;Daily&apos;&#10;THEN DATETRUNC(&apos;day&apos;, [session_date])&#10;WHEN &apos;Weekly&apos;&#10;THEN DATETRUNC(&apos;week&apos;, [session_date])&#10;END' />
            </column>
            <column caption='CPC: % terms and conditions clicked' datatype='real' default-format='p0.00%' name='[Calculation_2610258227960573954]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_terms_and_conditions_clicked])/sum([cpc_booking_entered_sessions])' />
            </column>
            <column caption='CPC: % booking page opened' datatype='integer' default-format='p0.00%' name='[Calculation_2610258227961294853]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='USER ACCESS' datatype='boolean' name='[Calculation_4828069950911328259]' role='dimension' type='nominal'>
