              <calculation class='tableau' formula='sum(if {fixed:dateadd(&apos;month&apos;, 0, max([date_month]))} = [date_month] then [cpc_booking_vendors] end)&#10;/ sum(if {fixed:dateadd(&apos;month&apos;, 0, max([date_month]))} = [date_month] then [vp_vendors] end)' />
