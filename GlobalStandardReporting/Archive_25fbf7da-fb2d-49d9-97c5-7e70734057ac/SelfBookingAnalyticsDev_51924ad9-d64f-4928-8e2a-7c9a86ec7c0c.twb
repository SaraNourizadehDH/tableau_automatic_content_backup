          <datasource-dependencies datasource='federated.12a431z0x4j3ro1c5t0z50aavzd9'>
            <column caption='% FP Product Card from Marketing' datatype='real' default-format='p0.0%' name='[% CPC Product Card from Marketing (copy)_4282571417252966409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fp_product_card_sessions])/sum([marketing_sessions])' />
            </column>
            <column caption='% FP plugin from Marketing' datatype='real' default-format='p0.0%' name='[% CPC plugin from Marketing (copy) (copy 2)_4282571417250906120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fp_plugin_sessions])/sum([marketing_sessions])' />
            </column>
            <column caption='% VFD plugin from Marketing' datatype='real' default-format='p0.0%' name='[% CPC plugin from Marketing (copy) (copy)_4282571417250893831]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vfd_plugin_sessions])/sum([marketing_sessions])' />
            </column>
            <column caption='% Joker plugin from Marketing' datatype='real' default-format='p0.0%' name='[% CPC plugin from Marketing (copy)_4282571417250885638]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([joker_plugin_sessions])/sum([marketing_sessions])' />
            </column>
            <column caption='% Conv Marketing -&gt; Any Product Page' datatype='real' default-format='p0.0%' name='[% Conv Marketing -&gt; Joker Product Page (copy)_1202390791936462948]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([any_product_booking_sessions])/sum([marketing_sessions])' />
            </column>
            <column caption='% VFD Product Card from Marketing' datatype='real' default-format='p0.0%' name='[% Joker Product Card from Marketing (copy)_4282571416366116866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vfd_product_card_sessions])/sum([marketing_sessions])' />
            </column>
            <column caption='% Marketing page user penetration' datatype='real' default-format='p0.0%' name='[Calculation_2451998915206856704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([marketing_users])/sum([vp_users])' />
            </column>
            <column caption='% Marketing Bounce Rate' datatype='real' default-format='p0.0%' name='[Calculation_4282571416226947072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([marketing_zero_bounce_sessions])/sum([marketing_sessions]-([marketing_bounce_sessions]-[marketing_zero_bounce_sessions]))' />
