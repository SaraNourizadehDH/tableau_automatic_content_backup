          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Is Graph View' datatype='boolean' name='[Is Table View (copy)_5530138868768964608]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column caption='Date Scale' datatype='string' name='[Metrics (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;day&quot;'>
              <calculation class='tableau' formula='&quot;day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.164afhd1bztqvs17ybb7u0kvjsjk'>
            <column caption='CPC: % Acquisition Conversion' datatype='real' default-format='p0.00%' name='[CPC: % Product Conversion (copy)_6644005786959806484]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_booking_users])/sum([cpc_opened_users])' />
            </column>
            <column caption='CPC: % Session Conversion' datatype='real' default-format='p0.0%' name='[CPC: % Session Conversion (control) (copy)_6644005786972463141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_booking_sessions])/sum([cpc_opened_sessions])' />
            </column>
            <column caption='CPC: % Product Conversion' datatype='real' default-format='p0.00%' name='[CPC: % budget selected (copy)_2610258227961417734]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_booking_vendors_sessions])/sum([cpc_opened_vendors_sessions])' />
            </column>
            <column caption='CPC: AVG Budget Eur' datatype='real' default-format='n#,##0;-#,##0' name='[CPC: AVG Bid Price Eur (copy)_6644005786973962279]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([budget_eur])/sum([bookings])' />
            </column>
            <column caption='CPC: % Budget Utilization' datatype='real' default-format='p0.0%' name='[CPC: ROAS  (copy)_6644005785179566083]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_revenue_eur])/sum([budget_eur])' />
            </column>
            <column caption='Graph View Filter' datatype='boolean' name='[Calculation_1324691610474229787]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Is Table View (copy)_5530138868768964608] = True' />
            </column>
            <column caption='Bookings per User' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Calculation_1324691677466759168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([bookings])/sum([cpc_opened_users])' />
            </column>
            <column caption='Date' datatype='date' name='[Calculation_2610258227957329921]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(datetrunc([Parameters].[Metrics (copy)], [session_date]))' />
            </column>
            <column caption='USER ACCESS' datatype='boolean' name='[Calculation_4828069950911795204]' role='dimension' type='nominal'>
