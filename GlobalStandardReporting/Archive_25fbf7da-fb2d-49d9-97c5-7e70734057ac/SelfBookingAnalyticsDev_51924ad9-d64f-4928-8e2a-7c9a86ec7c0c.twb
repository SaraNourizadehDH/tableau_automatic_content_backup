    <worksheet name='Bookings share'>
      <table>
        <view>
          <datasources>
            <datasource caption='self_booking_mbr (analytics)' name='federated.12a431z0x4j3ro1c5t0z50aavzd9' />
          </datasources>
          <datasource-dependencies datasource='federated.12a431z0x4j3ro1c5t0z50aavzd9'>
            <column caption='% CPC New Self Booking Share' datatype='real' default-format='p0.0%' name='[% CPC Self Booking Share (copy)_69172529600610307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cpc_new_bookings_sb])/sum([cpc_new_bookings])' />
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='County' datatype='string' name='[county]' role='dimension' semantic-role='[County].[Name]' type='nominal' />
            <column caption='Cpc New Bookings' datatype='integer' name='[cpc_new_bookings]' role='measure' type='quantitative' />
            <column caption='CPC New Self Bookings' datatype='integer' name='[cpc_new_bookings_sb]' role='measure' type='quantitative' />
            <column caption='Date Month' datatype='date' name='[date_month]' role='dimension' type='ordinal' />
