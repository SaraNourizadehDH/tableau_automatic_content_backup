              <calculation class='tableau' formula='([Last Month CPC Vendors with Reporting (copy)_1202390792307716199] - sum(if {fixed:dateadd(&apos;month&apos;, -1, max([date_month]))} = [date_month] then [cpc_booking_vendors] end)&#10;/ sum(if {fixed:dateadd(&apos;month&apos;, -1, max([date_month]))} = [date_month] then [vp_vendors] end))*100' />
