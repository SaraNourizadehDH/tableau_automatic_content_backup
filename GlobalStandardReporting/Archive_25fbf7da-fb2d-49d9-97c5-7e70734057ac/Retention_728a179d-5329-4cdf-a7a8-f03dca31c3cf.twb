          <datasource-dependencies datasource='federated.0avtu3p0aqn6fo144ef5r0im52j0'>
            <column caption='1st Order Retention_GMV' datatype='real' default-format='n&quot;€‎&quot;#,##0.0;-&quot;€‎&quot;#,##0.0' name='[1st Order Retention (copy)_3358770538076385281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([order_1_gmv])/Sum([Reorder_1_customers])' />
            </column>
            <column caption='2nd Order Retention' datatype='real' default-format='p0.0%' name='[1st Order Retention (copy)_6561603924382162948]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([Reorder_2_customers])/SUM([all_customers])' />
            </column>
            <column caption='2nd Order Retention_GMV' datatype='real' default-format='n&quot;€‎&quot;#,##0.0;-&quot;€‎&quot;#,##0.0' name='[1st Order Retention_GMV (copy)_3358770538077315074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([order_2_gmv])/Sum([Reorder_2_customers])' />
