              <calculation class='tableau' formula='If &#10;    [is_discount] = &apos;Yes&apos;&#10;    or [is_free_delivery] = &apos;Yes&apos;&#10;    or [is_voucher] = &apos;Yes&apos;&#10;Then &apos;Yes&apos;&#10;ELSE &apos;No&apos;&#10;END' />
