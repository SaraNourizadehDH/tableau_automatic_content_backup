              <calculation class='tableau' formula='If &#10;    [is_hc_session] = &apos;No&apos;&#10;    and [is_order_not_on_time] = &apos;No&apos;&#10;    and [is_contact] = &apos;No&apos;&#10;    and [is_cancellation_logistics] = &apos;No&apos;&#10;Then &apos;Yes&apos;&#10;ELSE &apos;No&apos;&#10;END' />
