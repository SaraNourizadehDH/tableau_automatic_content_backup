      <column caption='NPS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6561603924389527560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_6561603924388868101] - [Promoters (copy)_6561603924389142534])/SUM([all_customers])*100' />
