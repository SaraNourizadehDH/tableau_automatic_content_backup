            <column caption='Base_Order_GMV' datatype='real' default-format='n&quot;€‎&quot;#,##0.0;-&quot;€‎&quot;#,##0.0' name='[1st Order Retention_GMV (copy)_3358770538078859267]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([order_base_gmv])/Sum([all_customers])' />
