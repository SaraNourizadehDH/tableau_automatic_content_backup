      <column caption='Base_Order_GMV' datatype='real' default-format='n&quot;€‎&quot;#,##0.0;-&quot;€‎&quot;#,##0.0' name='[1st Order Retention_GMV (copy)_3358770538078859267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([order_base_gmv])/Sum([all_customers])' />
      </column>
      <column caption='Max of all GMVs' datatype='real' default-format='n&quot;€‎&quot;#,##0.0;-&quot;€‎&quot;#,##0.0' name='[1st Order Retention_GMV (copy)_3358770538081435652]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{Fixed [score] : Max(Max([1st Order Retention (copy)_3358770538076385281], [1st Order Retention_GMV (copy)_3358770538077315074]),  [1st Order Retention_GMV (copy)_3358770538078859267])}' />
      </column>
      <column caption='Seamless' datatype='string' default-format='n&quot;€‎&quot;#,##0.0;-&quot;€‎&quot;#,##0.0' name='[Base_Order_GMV (copy)_4027203239295168512]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If &#10;    [is_hc_session] = &apos;No&apos;&#10;    and [is_order_not_on_time] = &apos;No&apos;&#10;    and [is_contact] = &apos;No&apos;&#10;    and [is_cancellation_logistics] = &apos;No&apos;&#10;Then &apos;Yes&apos;&#10;ELSE &apos;No&apos;&#10;END' />
      </column>
      <column caption='NPS Date' datatype='date' name='[CREATED_DATE]' role='dimension' type='ordinal' />
      <column caption='%Response' datatype='real' default-format='p0%' name='[Calculation_6561603924380401666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([all_customers])/SUM([Total Customers (copy) (copy)_294774678352130049])' />
