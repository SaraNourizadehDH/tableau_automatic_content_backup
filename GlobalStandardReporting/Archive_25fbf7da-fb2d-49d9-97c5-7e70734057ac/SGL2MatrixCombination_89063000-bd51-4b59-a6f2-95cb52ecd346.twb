      </column>
      <column caption='MaxPerCat' datatype='integer' name='[Calculation_95982997443420165]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [mc1_left], [Month], [global_entity_id]: MAX([orders])}' />
      </column>
      <column caption='% Shared Category L1' datatype='real' name='[Calculation_95982997444055046]' role='measure' type='quantitative'>
