              <calculation class='tableau' formula='{ include [country]: SUM([no_listed_sku_country_week])/SUM([no_date_country_week])}' />
            </column>
            <column caption='No of Listed SKUs Region' datatype='integer' name='[No of Listed SKUs Country (copy)_5926948279956865024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] WHEN &apos;Weekly&apos; THEN [no_listed_sku_region_week]&#10;WHEN &apos;Monthly&apos; THEN [no_listed_sku_region_month]&#10;END' />
            </column>
            <column caption='No of Listed SKUs Country - Comparison Tab' datatype='real' name='[No of Listed SKUs Country - Comparison (copy)_6385400591936368646]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country],[Calculation_3187633795247927300]: sum([Avg No of Listed SKUs Warehouse (copy)_3207970362327228425])}' />
