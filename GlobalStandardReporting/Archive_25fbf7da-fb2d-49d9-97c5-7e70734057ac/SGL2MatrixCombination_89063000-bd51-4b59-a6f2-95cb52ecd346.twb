    <worksheet name='Monthly Order Increas'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'><![CDATA[Overview Categories by Orders (Size) and Avg Listed SKUs (Color) - <Page Name>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='assortment_performance_deepdive2' name='federated.0p9e7qv0rwfa4l1bqbcas1kn32n1' />
          </datasources>
          <datasource-dependencies datasource='federated.0p9e7qv0rwfa4l1bqbcas1kn32n1'>
            <column caption='Total Orders' datatype='integer' name='[ABS (copy)_2522297286727381025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE  [Calculation_2522297286706167826]&#13;&#10;WHEN &apos;L0&apos; &#13;&#10;THEN SUM([Fixed_OrdersL1 (copy)_2522297286714585109])&#13;&#10;WHEN &apos;L1&apos;&#13;&#10;THEN   SUM( [Calculation_2522297283983908864 2])&#13;&#10;WHEN &apos;L2&apos; &#13;&#10;THEN SUM([totalOrders_L2])&#13;&#10;END' />
            </column>
            <column caption='Fixed_OrdersL1' datatype='integer' name='[Calculation_2522297283983908864 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Month],[master_category_one]: MAX([totalOrders_L1])}' />
            </column>
            <column caption='MCL1_Count' datatype='integer' name='[Calculation_2522297286703149070]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([master_category_one])' />
            </column>
            <column caption='Display Category Level' datatype='string' name='[Calculation_2522297286706167826]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ([MCL1_Count (copy)_2522297286704115729]=1 AND [Calculation_2522297286703149070] = 1 AND [MCL1_Count (copy)_2522297286703820815] =1)&#13;&#10;THEN &apos;L2&apos;&#13;&#10;ELSEIF ([MCL1_Count (copy)_2522297286704115729]=1 AND [Calculation_2522297286703149070] = 1 AND [MCL1_Count (copy)_2522297286703820815] &gt;1 &#13;&#10;AND SUM([Calculation_2522297286708469779]) = 0)&#13;&#10;THEN &apos;L1&apos;&#13;&#10;ELSE &apos;L0&apos;&#13;&#10;END' />
            </column>
            <column caption='TakeOut' datatype='integer' name='[Calculation_2522297286708469779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [master_category_cero]&#13;&#10;WHEN &apos;General Merchandise&apos;&#13;&#10;THEN 1&#13;&#10;WHEN &apos;BWS&apos;&#13;&#10;THEN 1&#13;&#10;WHEN &apos;Unknown&apos;&#13;&#10;THEN 1&#13;&#10;ELSE 0 &#13;&#10;END' />
            </column>
            <column caption='Fixed_OrdersL0' datatype='integer' name='[Fixed_OrdersL1 (copy)_2522297286714585109]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Month],[master_category_cero]: MAX([totalOrders_L0])}' />
            </column>
            <column caption='MCL2_Count' datatype='integer' name='[MCL1_Count (copy)_2522297286703820815]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([master_category_two])' />
            </column>
            <column caption='MCL0_Count' datatype='integer' name='[MCL1_Count (copy)_2522297286704115729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([master_category_cero])' />
            </column>
            <column caption='Month1' datatype='string' name='[Month]' role='dimension' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='L0 Category' datatype='string' name='[master_category_cero]' role='dimension' type='nominal' />
            <column caption='L1 Category' datatype='string' name='[master_category_one]' role='dimension' type='nominal' />
            <column caption='L2 Category' datatype='string' name='[master_category_two]' role='dimension' type='nominal' />
            <column-instance column='[Month]' derivation='None' name='[none:Month:nk]' pivot='key' type='nominal' />
            <column-instance column='[master_category_cero]' derivation='None' name='[none:master_category_cero:nk]' pivot='key' type='nominal' />
            <column-instance column='[master_category_one]' derivation='None' name='[none:master_category_one:nk]' pivot='key' type='nominal' />
            <column-instance column='[master_category_two]' derivation='None' name='[none:master_category_two:nk]' pivot='key' type='nominal' />
            <column caption='totalOrders L0' datatype='integer' name='[totalOrders_L0]' role='measure' type='quantitative' />
            <column caption='totalOrders L1' datatype='integer' name='[totalOrders_L1]' role='measure' type='quantitative' />
            <column caption='totalOrders L2' datatype='integer' name='[totalOrders_L2]' role='measure' type='quantitative' />
            <column-instance column='[ABS (copy)_2522297286727381025]' derivation='User' name='[usr:ABS (copy)_2522297286727381025:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
