      <aliases enabled='yes' />
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) / TOTAL(SUM([orders]))'>
          <table-calc ordering-type='Table' />
        </calculation>
      </column>
      <column caption='Index 1' datatype='integer' name='[Calculation_1610036899649085444]' role='measure' type='quantitative'>
