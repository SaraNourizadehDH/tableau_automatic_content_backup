    <worksheet name='View 2_L2'>
      <table>
        <view>
          <datasources>
            <datasource caption='assortment_performance_deepdive2' name='federated.0p9e7qv0rwfa4l1bqbcas1kn32n1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Warehouse Maturity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;Mature&quot;' value='Mature ( &gt;= 30 Days)' />
                <alias key='&quot;Non Mature&quot;' value='Non Mature ( &lt; 30 Days)' />
              </aliases>
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
              <aliases>
                <alias key='&quot;LC&quot;' value='Local Currency' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0p9e7qv0rwfa4l1bqbcas1kn32n1'>
            <column caption='ABS_L2' datatype='real' name='[ABS_L1 (copy)_2522297284308856839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qtySold_L2])/SUM([totalOrders_L2])' />
            </column>
            <column caption='ASP_L2' datatype='real' name='[ABV_L1 (copy)_2522297284309721096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2522297286712328212])/SUM([totalOrders_L2])' />
            </column>
            <column caption='Basket Penetration L2' datatype='real' name='[Basket Penetration L1 (copy)_2522297284313559050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([totalOrders_L2])/SUM([Calculation_2522297283983908864 2 2])' />
            </column>
            <column caption='Fixed_mature_Denom' datatype='integer' name='[Calculation_2522297283983908864 1 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Month]: MAX([mature_denom_listsku])}' />
            </column>
            <column caption='Fixed_nonmature_Denom' datatype='integer' name='[Calculation_2522297283983908864 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Month]: MAX([non_mature_denom_listsku])}' />
            </column>
            <column caption='Fixed_GeneralOrdersL1' datatype='integer' name='[Calculation_2522297283983908864 2 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [Month],[master_category_one]: MAX([totalGeneralOrders])}' />
            </column>
            <column caption='Fixed_OrdersL1' datatype='integer' name='[Calculation_2522297283983908864 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Month],[master_category_one]: MAX([totalOrders_L1])}' />
            </column>
            <column caption='Fixed_total_Denom' datatype='real' name='[Calculation_2522297283983908864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Month]: AVG([total_denom_listsku])}' />
            </column>
            <column caption='Avg Lis. SKUs' datatype='real' name='[Calculation_2522297283988086785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] &#13;&#10;WHEN &quot;Mature&quot; &#13;&#10;THEN SUM([ListedSKU_Mature])/SUM([Calculation_2522297283983908864 1 1])&#13;&#10;WHEN &quot;Non Mature&quot;&#13;&#10;THEN SUM([ListedSKU_NonMature])/SUM([Calculation_2522297283983908864 1])&#13;&#10;ELSE&#13;&#10;SUM([ListedSKU])/SUM([Calculation_2522297283983908864]) END' />
            </column>
            <column caption='ABS_L1' datatype='real' name='[Calculation_2522297284285665282 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qtySold_L2])/SUM([Calculation_2522297283983908864 2])' />
            </column>
            <column caption='GPV' datatype='real' name='[Calculation_2522297286712328212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &apos;Euro&apos;&#13;&#10;THEN [total_price_paid_eur]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN [total_price_paid_lc]&#13;&#10;END' />
            </column>
            <column caption='Customer Penetration L2' datatype='real' name='[Customer Penetration L1  (copy)_2522297284313907211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([totalCustomers_L2])/SUM([Fixed_OrdersL1 (copy)_2522297284302934020])' />
            </column>
            <column caption='Fixed_GeneralUsersL1' datatype='integer' name='[Fixed_OrdersL1 (copy)_2522297284302934020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [Month],[master_category_one]: MAX([totalGeneralCustomers])}' />
            </column>
            <column caption='FrequencyIN_L2_Metric1' datatype='real' name='[FrequencyIN_L1_Metric1 (copy)_2522297284310073353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([totalOrders_L2])/SUM([totalCustomers_L2])' />
