      <datasource-dependencies datasource='Parameters'>
        <column caption='Warehouse Maturity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
          <calculation class='tableau' formula='&quot;All&quot;' />
          <aliases>
            <alias key='&quot;Mature&quot;' value='Mature ( &gt;= 30 Days)' />
            <alias key='&quot;Non Mature&quot;' value='Non Mature ( &lt; 30 Days)' />
          </aliases>
          <members>
            <member value='&quot;All&quot;' />
            <member alias='Mature ( &gt;= 30 Days)' value='&quot;Mature&quot;' />
            <member alias='Non Mature ( &lt; 30 Days)' value='&quot;Non Mature&quot;' />
          </members>
        </column>
        <column alias='No Orders per Warehouse per Day' caption='KPI' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;No Orders&quot;'>
          <calculation class='tableau' formula='&quot;No Orders&quot;' />
          <aliases>
            <alias key='&quot;GPV&quot;' value='GPV per Warehouse per Day' />
            <alias key='&quot;No Orders&quot;' value='No Orders per Warehouse per Day' />
          </aliases>
          <members>
            <member value='&quot;ABS&quot;' />
            <member value='&quot;ABV&quot;' />
            <member value='&quot;Frequency&quot;' />
            <member alias='No Orders per Warehouse per Day' value='&quot;No Orders&quot;' />
            <member alias='GPV per Warehouse per Day' value='&quot;GPV&quot;' />
          </members>
        </column>
        <column caption='Efficiency / Newness' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Efficiency&quot;'>
          <calculation class='tableau' formula='&quot;Efficiency&quot;' />
          <members>
            <member value='&quot;Efficiency&quot;' />
            <member value='&quot;Newness&quot;' />
          </members>
        </column>
        <column caption='Geographical Aggregation' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
          <calculation class='tableau' formula='&quot;Region&quot;' />
          <members>
            <member value='&quot;Region&quot;' />
            <member value='&quot;Country&quot;' />
          </members>
        </column>
      </datasource-dependencies>
