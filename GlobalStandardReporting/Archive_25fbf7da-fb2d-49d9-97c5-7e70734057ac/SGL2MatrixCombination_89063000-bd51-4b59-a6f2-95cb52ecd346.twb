        </calculation>
      </column>
      <column caption='Fixed_GeneralOrders' datatype='integer' name='[Calculation_2232378080509857795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [Month] : MAX([GeneralOrders])}' />
      </column>
      <column caption='Basket Penetration' datatype='real' name='[Calculation_2232378080511008772]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])/SUM([Calculation_2232378080509857795])' />
