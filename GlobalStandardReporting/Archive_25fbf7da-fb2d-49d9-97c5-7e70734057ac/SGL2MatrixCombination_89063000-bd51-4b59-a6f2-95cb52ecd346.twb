    <worksheet name='Final Graph Newness &amp; Eff'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Category Comparison</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='assortment_performance_deepdive2' name='federated.0p9e7qv0rwfa4l1bqbcas1kn32n1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Warehouse Maturity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;Mature&quot;' value='Mature ( &gt;= 30 Days)' />
                <alias key='&quot;Non Mature&quot;' value='Non Mature ( &lt; 30 Days)' />
              </aliases>
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
              <aliases>
                <alias key='&quot;LC&quot;' value='Local Currency' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0p9e7qv0rwfa4l1bqbcas1kn32n1'>
            <column caption='%Efficiency' datatype='real' name='[% Newness (copy)_1241586136712630283]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(SUM([slow_turners])/SUM([sku_mature]))' />
            </column>
            <column caption='% Shrinkage' datatype='real' name='[% Newness (copy)_1241586136713236494]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shrinkage_eur_expired])/SUM([total_price_paid_eur])' />
            </column>
            <column caption='ASP per Cat' datatype='real' name='[ABS (copy)_2522297286715924506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE  [Calculation_2522297286706167826]&#13;&#10;WHEN &apos;L0&apos; &#13;&#10;THEN [ABV_L1 (copy)_2522297286715809816]&#13;&#10;WHEN &apos;L1&apos;&#13;&#10;THEN [Calculation_2522297284285665282]&#13;&#10;WHEN &apos;L2&apos; &#13;&#10;THEN [ABV_L1 (copy)_2522297284309721096]&#13;&#10;END' />
            </column>
            <column caption='AQS per Cat' datatype='real' name='[ABS_L0 (copy)_2522297286715002903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE  [Calculation_2522297286706167826]&#13;&#10;WHEN &apos;L0&apos; &#13;&#10;THEN [ABS_L1 (copy)_2522297286714830870]&#13;&#10;WHEN &apos;L1&apos;&#13;&#10;THEN [Calculation_2522297284285665282 1]&#13;&#10;WHEN &apos;L2&apos; &#13;&#10;THEN [ABS_L1 (copy)_2522297284308856839]&#13;&#10;END' />
            </column>
            <column caption='FrequencyIN_L1_Metric1' datatype='real' name='[ABS_L1 (copy)_2522297284300570627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2522297283983908864 2])/SUM([Calculation_2522297283983908864 2 1])' />
            </column>
            <column caption='ABS_L2' datatype='real' name='[ABS_L1 (copy)_2522297284308856839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qtySold_L2])/SUM([totalOrders_L2])' />
            </column>
            <column caption='ABS_L0' datatype='real' name='[ABS_L1 (copy)_2522297286714830870]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qtySold_L2])/SUM([Fixed_OrdersL1 (copy)_2522297286714585109])' />
            </column>
            <column caption='ASP_L2' datatype='real' name='[ABV_L1 (copy)_2522297284309721096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2522297286712328212])/SUM([totalOrders_L2])' />
            </column>
            <column caption='ASP_L0' datatype='real' name='[ABV_L1 (copy)_2522297286715809816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2522297286712328212])/SUM([Fixed_OrdersL1 (copy)_2522297286714585109])' />
            </column>
            <column caption='% Newness' datatype='real' name='[Calculation_1241586136712318986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sku_new])/SUM([cat_country_skus])' />
            </column>
            <column caption='Fixed_mature_Denom' datatype='integer' name='[Calculation_2522297283983908864 1 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Month]: MAX([mature_denom_listsku])}' />
            </column>
            <column caption='Fixed_nonmature_Denom' datatype='integer' name='[Calculation_2522297283983908864 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Month]: MAX([non_mature_denom_listsku])}' />
            </column>
            <column caption='Fixed_UsersL1' datatype='integer' name='[Calculation_2522297283983908864 2 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Month],[master_category_one]: MAX([totalCustomers_L1])}' />
            </column>
            <column caption='Fixed_OrdersL1' datatype='integer' name='[Calculation_2522297283983908864 2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Month],[master_category_one]: MAX([totalOrders_L1])}' />
            </column>
            <column caption='Fixed_total_Denom' datatype='real' name='[Calculation_2522297283983908864]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Month]: AVG([total_denom_listsku])}' />
            </column>
            <column caption='Avg Lis. SKUs' datatype='real' name='[Calculation_2522297283988086785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] &#13;&#10;WHEN &quot;Mature&quot; &#13;&#10;THEN SUM([ListedSKU_Mature])/SUM([Calculation_2522297283983908864 1 1])&#13;&#10;WHEN &quot;Non Mature&quot;&#13;&#10;THEN SUM([ListedSKU_NonMature])/SUM([Calculation_2522297283983908864 1])&#13;&#10;ELSE&#13;&#10;SUM([ListedSKU])/SUM([Calculation_2522297283983908864]) END' />
            </column>
            <column caption='ABS_L1' datatype='real' name='[Calculation_2522297284285665282 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qtySold_L2])/SUM([Calculation_2522297283983908864 2])' />
            </column>
            <column caption='ASP_L1' datatype='real' name='[Calculation_2522297284285665282]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2522297286712328212])/SUM([Calculation_2522297283983908864 2])' />
            </column>
            <column caption='MCL1_Count' datatype='integer' name='[Calculation_2522297286703149070]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([master_category_one])' />
            </column>
            <column caption='Display Category Level' datatype='string' name='[Calculation_2522297286706167826]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ([MCL1_Count (copy)_2522297286704115729]=1 AND [Calculation_2522297286703149070] = 1 AND [MCL1_Count (copy)_2522297286703820815] =1)&#13;&#10;THEN &apos;L2&apos;&#13;&#10;ELSEIF ([MCL1_Count (copy)_2522297286704115729]=1 AND [Calculation_2522297286703149070] = 1 AND [MCL1_Count (copy)_2522297286703820815] &gt;1 &#13;&#10;AND SUM([Calculation_2522297286708469779]) = 0)&#13;&#10;THEN &apos;L1&apos;&#13;&#10;ELSE &apos;L0&apos;&#13;&#10;END' />
            </column>
            <column caption='TakeOut' datatype='integer' name='[Calculation_2522297286708469779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [master_category_cero]&#13;&#10;WHEN &apos;General Merchandise&apos;&#13;&#10;THEN 1&#13;&#10;WHEN &apos;BWS&apos;&#13;&#10;THEN 1&#13;&#10;WHEN &apos;Unknown&apos;&#13;&#10;THEN 1&#13;&#10;ELSE 0 &#13;&#10;END' />
            </column>
            <column caption='GPV' datatype='real' name='[Calculation_2522297286712328212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &apos;Euro&apos;&#13;&#10;THEN [total_price_paid_eur]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN [total_price_paid_lc]&#13;&#10;END' />
            </column>
            <column caption='Fixed_OrdersL0' datatype='integer' name='[Fixed_OrdersL1 (copy)_2522297286714585109]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Month],[master_category_cero]: MAX([totalOrders_L0])}' />
            </column>
