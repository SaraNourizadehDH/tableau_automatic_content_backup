    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Category Deep Dive KPIs'>
      <repository-location id='CategoryDeepDiveKPIs' path='/t/GlobalStandardReporting/workbooks/AssortmentPerformanceDeepDive_16581531678340' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1300' maxwidth='1200' minheight='1300' minwidth='1200' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='assortment_performance_deepdive2' name='federated.0p9e7qv0rwfa4l1bqbcas1kn32n1' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Warehouse Maturity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
          <calculation class='tableau' formula='&quot;All&quot;' />
          <aliases>
            <alias key='&quot;Mature&quot;' value='Mature ( &gt;= 30 Days)' />
            <alias key='&quot;Non Mature&quot;' value='Non Mature ( &lt; 30 Days)' />
          </aliases>
          <members>
            <member value='&quot;All&quot;' />
            <member alias='Mature ( &gt;= 30 Days)' value='&quot;Mature&quot;' />
            <member alias='Non Mature ( &lt; 30 Days)' value='&quot;Non Mature&quot;' />
          </members>
        </column>
        <column caption='Currency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
          <calculation class='tableau' formula='&quot;Euro&quot;' />
          <aliases>
            <alias key='&quot;LC&quot;' value='Local Currency' />
          </aliases>
          <members>
            <member value='&quot;Euro&quot;' />
            <member alias='Local Currency' value='&quot;LC&quot;' />
          </members>
        </column>
        <column caption='Geographical Aggregation' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
          <calculation class='tableau' formula='&quot;Region&quot;' />
          <members>
            <member value='&quot;Region&quot;' />
            <member value='&quot;Country&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0p9e7qv0rwfa4l1bqbcas1kn32n1'>
        <column caption='Month1' datatype='string' name='[Month]' role='dimension' type='nominal' />
