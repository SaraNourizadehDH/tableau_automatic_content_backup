          <datasource-dependencies datasource='federated.0p9e7qv0rwfa4l1bqbcas1kn32n1'>
            <column caption='FrequencyIN_L1_Metric1' datatype='real' name='[ABS_L1 (copy)_2522297284300570627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2522297283983908864 2])/SUM([Calculation_2522297283983908864 2 1])' />
            </column>
            <column caption='ABS' datatype='real' name='[ABV per Cat (copy)_1241586136650235912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE  [Calculation_2522297286706167826]&#13;&#10;WHEN &apos;L0&apos; &#13;&#10;THEN SUM([Fixed Global GMV L0 (copy)_1241586136649891847])/SUM([Fixed_OrdersL1 (copy)_2522297286714585109])&#13;&#10;WHEN &apos;L1&apos;&#13;&#10;THEN SUM([Fixed Global GMV L1 (copy)_1241586136649891846])/SUM([Calculation_2522297283983908864 2])&#13;&#10;WHEN &apos;L2&apos; &#13;&#10;THEN SUM([global_items_L2])/SUM([totalOrders_L2])&#13;&#10;END' />
            </column>
            <column caption='Fixed_mature_Denom' datatype='integer' name='[Calculation_2522297283983908864 1 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_code], [Month]: MAX([mature_denom_listsku])}' />
            </column>
            <column caption='Fixed_nonmature_Denom' datatype='integer' name='[Calculation_2522297283983908864 1]' role='measure' type='quantitative'>
