      <column caption='Avg. First Reply Time Chats (s)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_831195618844454912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [first_reply_time_chat] &gt;= 0 THEN [first_reply_time_chat] END)/[Calculation_939844957981401088]' />
      </column>
      <column caption='Gross Attendance' datatype='real' default-format='p0.0%' hidden='true' name='[Calculation_873416875852017666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([hours_clocked_within_schedule])/sum([hours_scheduled])' />
