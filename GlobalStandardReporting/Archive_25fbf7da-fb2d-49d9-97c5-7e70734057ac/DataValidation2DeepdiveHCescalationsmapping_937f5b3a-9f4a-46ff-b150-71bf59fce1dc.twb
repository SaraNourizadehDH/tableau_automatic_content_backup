  <worksheets>
    <worksheet name='(Chats)'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/CSPS-GlobalCountryBasedReport/Chats_1?rev=' id='Chats_1' path='/t/GlobalStandardReporting/workbooks/Alldepartments-CountryChannelDeep-DiveReport-ToolStakeholderSplit' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='channel_day_metrics' name='federated.0gqoovo0dtggoq11xfe5g16gaz4t' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity Level' datatype='string' name='[Completed Week Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='2nd Dimension' datatype='string' name='[Dimensions (copy)_2888003668867932160]' param-domain-type='list' role='measure' type='nominal' value='&quot;Agent Facing Tool&quot;'>
              <calculation class='tableau' formula='&quot;Agent Facing Tool&quot;' />
              <aliases>
                <alias key='&quot;Contact Center&quot;' value='Contact Center' />
              </aliases>
            </column>
            <column caption='1st Dimension' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
              <aliases>
                <alias key='&quot;Contact Center&quot;' value='Contact Center' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gqoovo0dtggoq11xfe5g16gaz4t'>
            <column caption='% Missed Chats with QT &lt; 1 min' datatype='real' default-format='p0%' name='[% Missed Chats Online (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(count_missed_qt_less_1min_chat) / SUM([missed_chat_ind])' />
            </column>
            <column caption='% Served Chats with QT &lt; 1 min' datatype='real' default-format='p0%' name='[% Missed Chats Online with QT &lt; 1 min (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(count_served_qt_less_1min_chat) / ([Calculation_939844957981401088])' />
            </column>
            <column caption='% Dropped Chats within 30s' datatype='real' default-format='p0%' name='[% Valid Chats (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6901414648091095043] / [Calculation_6901414647111073792]' />
            </column>
            <column caption='Avg, Full Resolution Time Chats (min)' datatype='real' name='[AHT Chats  (min) (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([handling_time_chat]) +sum([queue_time_served_chat]))/[Calculation_939844957981401088]/60' />
            </column>
            <column caption='Avg, Total HT Chats (min)' datatype='real' name='[Avg, Full Resolution Time Chats (min) (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([handling_time_chat]) + sum([wrap_up_time_chat]))/[Calculation_939844957981401088]/60' />
            </column>
            <column caption='Avg. Wrap Up Time Chats (min)' datatype='real' name='[Avg. First Reply Time Chats (s) (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([wrap_up_time_chat])/[Calculation_939844957981401088] )/60' />
            </column>
            <column caption='CSAT' datatype='real' default-format='p0%' name='[CSAT (Chats) (copy)_3562980665898053633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_csat_4_5])/SUM([count_csat_responses])' />
            </column>
            <column caption='Avg. Pandacare Agent FRT' datatype='real' name='[Calculation_1302877346779938816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [agent_facing_tool]&#10;  WHEN &apos;Pandacare&apos;&#10;THEN [agent_first_reply_time_chat] END) &#10;/ &#10;[Calculation_939844957981401088]' />
            </column>
            <column caption='% Missed Chats' datatype='real' default-format='p0%' name='[Calculation_3075677127721164801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([missed_chat_ind]) / [Calculation_6901414647111073792]' />
            </column>
            <column caption='Global' datatype='string' name='[Calculation_610026676822482944]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Global&apos;' />
            </column>
            <column caption='# Incoming Chats' datatype='integer' name='[Calculation_6901414647111073792]' role='measure' type='quantitative'>
