      <column caption='# Solved Emails' datatype='integer' hidden='true' name='[All Incoming Emails (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([solved_emails]),0)&#10;+IFNULL(SUM([Calculation_785033765983760385]),0)' />
      </column>
      <column caption='Net Attendance (excluding breaks)' datatype='real' default-format='p0.0%' hidden='true' name='[Attendance (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([hours_clocked_net])/(sum([hours_scheduled]) - SUM([hours_shift_break]))' />
