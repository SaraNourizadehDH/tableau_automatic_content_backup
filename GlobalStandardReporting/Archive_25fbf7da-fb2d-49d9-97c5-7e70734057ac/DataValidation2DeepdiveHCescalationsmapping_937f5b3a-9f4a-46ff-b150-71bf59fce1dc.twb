            <column caption='# Incoming Issues' datatype='integer' name='[# Incoming Chats (copy)_875387238557908994]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([incoming_chat_ind],0)) +&#10;(IFNULL([# Incoming IVR (copy)],0)) +&#10;SUM(IFNULL([outbound_call_ind],0)) +&#10;SUM(IFNULL([incoming_case_ind],0))' />
            </column>
            <column caption='# Inbound Valid Calls' datatype='integer' name='[# Incoming IVR (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([inbound_call_ind],0)) &#10;- SUM(IFNULL([abandoned_call_ind],0)) &#10;+SUM(IFNULL([missed_call_ind],0))' />
            </column>
            <column caption='# Processed Issues' datatype='integer' name='[# Incoming Issues (copy)_875387238557978627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([resolved_case_ind],0)) +&#10;(IFNULL([Calculation_939844957981401088],0)) +&#10;SUM(IFNULL([served_call_ind],0)) +&#10;SUM(IFNULL([count_outbound_more_30s_call],0))' />
            </column>
            <column caption='AHT All Outbound Calls  (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AHT Outbound Calls  (min) (copy)_5558638216501174274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([outbound_ht_call])/sum([outbound_call_ind])/60' />
            </column>
            <column caption='# Incoming Cases' datatype='integer' name='[Calculation_3201988983234580480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(([incoming_case_ind]),0)' />
            </column>
            <column caption='# Incoming Chats' datatype='integer' name='[Calculation_6901414647111073792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([incoming_chat_ind])' />
            </column>
            <column caption='# Served Chats' datatype='integer' name='[Calculation_939844957981401088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([served_chat_ind])' />
            </column>
            <column caption='SLA 30s Chats' datatype='real' default-format='p0.0%' name='[Calculation_939844958047555588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_sla_30s_chat])/&#10;(([Calculation_6901414647111073792])&#10;)' />
