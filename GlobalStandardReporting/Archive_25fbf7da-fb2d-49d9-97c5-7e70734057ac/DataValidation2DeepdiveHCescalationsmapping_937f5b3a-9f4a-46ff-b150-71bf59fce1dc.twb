    <worksheet name='graph'>
      <table>
        <view>
          <datasources>
            <datasource caption='channel_day_metrics' name='federated.0gqoovo0dtggoq11xfe5g16gaz4t' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity Level' datatype='string' name='[Completed Week Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='2nd Dimension' datatype='string' name='[Dimensions (copy)_2888003668867932160]' param-domain-type='list' role='measure' type='nominal' value='&quot;Agent Facing Tool&quot;'>
              <calculation class='tableau' formula='&quot;Agent Facing Tool&quot;' />
              <aliases>
                <alias key='&quot;Contact Center&quot;' value='Contact Center' />
              </aliases>
            </column>
            <column caption='1st Dimension' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
              <aliases>
                <alias key='&quot;Contact Center&quot;' value='Contact Center' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gqoovo0dtggoq11xfe5g16gaz4t'>
            <column caption='# Inbound Valid Calls' datatype='integer' name='[# Incoming IVR (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([served_call_ind]) +SUM([missed_call_ind])' />
            </column>
            <column caption='Contacts' datatype='real' name='[Calculation_1081708379139670019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IFNULL(([# Incoming IVR (copy)]),0)+IFNULL(([Calculation_6901414647111073792]),0)+IFNULL(SUM([Calculation_785033765983760385]),0))' />
            </column>
            <column caption='Global' datatype='string' name='[Calculation_610026676822482944]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Global&apos;' />
            </column>
            <column caption='# Incoming Chats' datatype='integer' name='[Calculation_6901414647111073792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([incoming_chat_ind])' />
            </column>
            <column caption='Granularity' datatype='string' name='[Calculation_772930316894855168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Completed Week Parameter]=&apos;Daily&apos; THEN STR([created_date_localtime])&#13;&#10;ELSEIF [Parameters].[Completed Week Parameter]=&apos;Weekly&apos; THEN STR([week])&#13;&#10;ELSEIF [Parameters].[Completed Week Parameter]=&apos;Monthly&apos; THEN STR([month])&#13;&#10;END' />
            </column>
            <column caption='Work Items L1' datatype='real' name='[Calculation_785033765983760385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([count_working_item_l1_close],0) + IFNULL([count_working_item_l1_escalated],0)' />
            </column>
