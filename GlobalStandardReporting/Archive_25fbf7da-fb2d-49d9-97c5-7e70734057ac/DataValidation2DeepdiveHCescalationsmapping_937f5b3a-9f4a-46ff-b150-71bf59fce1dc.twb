      <column caption='AHTSuccessful  Outbound Calls  (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AHT (Inbound Calls) (min.) (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([outbound_more_30s_ht_call])/sum([count_outbound_more_30s_call])/60' />
      </column>
      <column caption='Avg, Full Resolution Time Chats (min)' datatype='real' name='[AHT Chats  (min) (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([handling_time_chat]) +sum([queue_time_served_chat]))/[Calculation_939844957981401088]/60' />
      </column>
      <column caption='Case AHT (min)' datatype='real' name='[AHT L1 (copy)_5558638216490074112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;sum(IFNULL([sum_handling_time_l1_close],0))+&#13;&#10;sum(IFNULL([sum_handling_time_l1_escalated],0))+&#13;&#10;sum(IFNULL([sum_handling_time_l2],0))&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;sum([resolved_case_ind])&#13;&#10;)' />
      </column>
      <column caption='AHT All Outbound Calls  (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AHT Outbound Calls  (min) (copy)_5558638216501174274]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([outbound_ht_call])/sum([outbound_call_ind])/60' />
      </column>
      <column caption='AQT Served Chats  (min)' datatype='real' default-format='n#,##0;-#,##0' name='[AQT Served Chats  (s) (copy)_2548685551325855746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([queue_time_served_chat])/[Calculation_939844957981401088]) / 60' />
      </column>
      <column caption='# Solved Emails' datatype='integer' hidden='true' name='[All Incoming Emails (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([solved_emails]),0)&#10;+IFNULL(SUM([Calculation_785033765983760385]),0)' />
      </column>
      <column caption='Net Attendance (excluding breaks)' datatype='real' default-format='p0.0%' hidden='true' name='[Attendance (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([hours_clocked_net])/(sum([hours_scheduled]) - SUM([hours_shift_break]))' />
      </column>
      <column caption='Break Rate' datatype='real' default-format='p0.0%' hidden='true' name='[Attendance (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([hours_shift_break])/sum([hours_scheduled])' />
      </column>
      <column caption='Avg First Reply TIme L2' datatype='real' name='[Avg First Reply TIme L1 Close (copy) (copy)_6481594722565971972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_first_reply_time_l2]) / SUM([count_working_item_l2])/60' />
      </column>
      <column caption='Avg First Reply TIme L1 Escalate' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg First Reply TIme L1 Close (copy)_6481594722565947395]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_first_reply_time_l1_escalated]) / SUM([count_working_item_l1_escalated])/60' />
      </column>
