        <calculation class='tableau' formula='if [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Country&apos; THEN [country]&#10;ELSEIF  [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Language&apos; THEN [language]&#13;&#10;ELSEIF  [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;DH Regions&apos; THEN [dh_region]&#13;&#10;ELSEIF  [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Contact Center&apos; THEN [contact_center]&#13;&#10;ELSEIF  [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Management Entity&apos; THEN [management_entity_group]&#13;&#10;ELSEIF  [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Brand&apos; THEN [brand]&#13;&#10;ELSEIF  [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Global&apos; THEN [Calculation_610026676822482944]&#10;ELSEIF [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Stakeholder Entry Point&apos; THEN [stakeholder_entry_point]&#10;ELSEIF [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Agent Facing Tool&apos; THEN [agent_facing_tool]&#10;ELSEIF [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Contact Resolution Skill&apos; THEN [contact_resolution_skill]&#10;ELSEIF [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Vertical&apos; THEN [vertical]&#10;ELSEIF [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Delivery Type&apos; THEN [delivery_type]&#10;ELSEIF [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Stakeholder&apos; THEN [stakeholder]&#10;ELSEIF [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Channel&apos; THEN [channel]&#10;&#10;&#13;&#10;END' />
