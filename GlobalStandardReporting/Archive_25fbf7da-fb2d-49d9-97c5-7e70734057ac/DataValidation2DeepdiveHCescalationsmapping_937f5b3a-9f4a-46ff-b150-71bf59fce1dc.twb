    <worksheet name='Social Media Non-Live '>
      <table>
        <view>
          <datasources>
            <datasource caption='channel_day_metrics' name='federated.0gqoovo0dtggoq11xfe5g16gaz4t' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity Level' datatype='string' name='[Completed Week Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='2nd Dimension' datatype='string' name='[Dimensions (copy)_2888003668867932160]' param-domain-type='list' role='measure' type='nominal' value='&quot;Agent Facing Tool&quot;'>
              <calculation class='tableau' formula='&quot;Agent Facing Tool&quot;' />
              <aliases>
                <alias key='&quot;Contact Center&quot;' value='Contact Center' />
              </aliases>
            </column>
            <column caption='1st Dimension' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
              <aliases>
                <alias key='&quot;Contact Center&quot;' value='Contact Center' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gqoovo0dtggoq11xfe5g16gaz4t'>
            <column caption='Case AHT (min)' datatype='real' name='[AHT L1 (copy)_5558638216490074112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;sum(IFNULL([sum_handling_time_l1_close],0))+&#13;&#10;sum(IFNULL([sum_handling_time_l1_escalated],0))+&#13;&#10;sum(IFNULL([sum_handling_time_l2],0))&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;sum([resolved_case_ind])&#13;&#10;)' />
            </column>
            <column caption='Avg First Reply TIme L2' datatype='real' name='[Avg First Reply TIme L1 Close (copy) (copy)_6481594722565971972]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_first_reply_time_l2]) / SUM([count_working_item_l2])/60' />
            </column>
            <column caption='Avg First Reply TIme L1 Escalate' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg First Reply TIme L1 Close (copy)_6481594722565947395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_first_reply_time_l1_escalated]) / SUM([count_working_item_l1_escalated])/60' />
            </column>
            <column caption='CSAT' datatype='real' default-format='p0%' name='[CSAT (Chats) (copy)_3562980665898053633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_csat_4_5])/SUM([count_csat_responses])' />
            </column>
            <column caption='AHT L1' datatype='real' name='[Calculation_1204712958360883200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;sum(IFNULL([sum_handling_time_l1_close],0))+&#13;&#10;sum(IFNULL([sum_handling_time_l1_escalated],0))&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;sum([count_working_item_l1_close])+&#13;&#10; sum([count_working_item_l1_escalated])&#13;&#10;)' />
            </column>
            <column caption='% Escalate' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1204712958362390529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_working_item_l1_escalated])/ sum([Calculation_785033765983760385])' />
            </column>
            <column caption='% close' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1204712958362562562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_working_item_l1_close])/ sum([Calculation_785033765983760385])' />
            </column>
            <column caption='% Incoming per Channel' datatype='real' default-format='p0%' name='[Calculation_1927822154905395200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3201988983234580480])&#10;/&#13;&#10;SUM({FIXED [Calculation_772930316894855168], [contact_center], [country], [brand]: SUM([Calculation_3201988983234580480])})' />
            </column>
            <column caption='Social Media Platform' datatype='string' name='[Calculation_2015360873762983936]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [socialmedia_channel] = &apos;All&apos; THEN &apos;Unknown&apos;&#13;&#10;ELSEIF [socialmedia_channel] = &apos;None&apos; THEN &apos;Unknown&apos;&#13;&#10;ELSE [socialmedia_channel]&#13;&#10;END' />
            </column>
            <column caption='Case SLA 48 Hrs' datatype='real' name='[Calculation_216735767526223873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([case_within_sla_48h])/sum([Calculation_3201988983234580480])' />
            </column>
            <column caption='# Incoming Cases' datatype='integer' name='[Calculation_3201988983234580480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(([incoming_case_ind]),0)' />
            </column>
            <column caption='SLA L1' datatype='real' default-format='p0.0%' name='[Calculation_592504881661333504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_785033765984468995])/sum([Calculation_785033765983760385])' />
            </column>
            <column caption='SLA L2' datatype='real' name='[Calculation_592504881661399041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(ifnull([count_within_sla_l2],0))/sum([count_working_item_l2])' />
            </column>
            <column caption='Global' datatype='string' name='[Calculation_610026676822482944]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Global&apos;' />
            </column>
            <column caption='Avg. Full Resolution Time' datatype='real' name='[Calculation_6481594722565246977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([full_resolution_time]) / SUM([resolved_case_ind]) /60' />
            </column>
            <column caption='Avg First Reply TIme L1 Close' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6481594722565775362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_first_reply_time_l1_close]) / SUM([count_working_item_l1_close])/60' />
            </column>
            <column caption='% Resolved' datatype='real' default-format='p0%' name='[Calculation_6481594722821074951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([resolved_case_ind])/SUM([Calculation_3201988983234580480])' />
            </column>
            <column caption='Work Items L1+L2' datatype='real' name='[Calculation_6481594722821292040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Calculation_785033765983760385], 0)&#10;+IFNULL([count_working_item_l2], 0)' />
            </column>
            <column caption='display only non live channels' datatype='boolean' name='[Calculation_6481594722858754058]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [channel] = &apos;Email&apos; THEN true&#10;ELSEIF [channel] = &apos;Social Media&apos; THEN true&#10;ELSEIF [channel] = &apos;Form&apos; THEN true&#10;ELSEIF [channel] = &apos;Outbound Email&apos; THEN true&#10;ELSEIF [channel] = &apos;Feedback Widget&apos; THEN true&#10;ELSEIF [channel] = &apos;Portal&apos; Then TRUE&#10;ELSEIF [channel] = &apos;Phone&apos; THEN true&#10;ELSEIF [channel] = &apos;case-inbox&apos; THEN true&#10;ELSEIF [channel] = &apos;Non-live&apos; THEN true&#10;ELSE false&#10;END' />
            </column>
            <column caption='Granularity' datatype='string' name='[Calculation_772930316894855168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Completed Week Parameter]=&apos;Daily&apos; THEN STR([created_date_localtime])&#13;&#10;ELSEIF [Parameters].[Completed Week Parameter]=&apos;Weekly&apos; THEN STR([week])&#13;&#10;ELSEIF [Parameters].[Completed Week Parameter]=&apos;Monthly&apos; THEN STR([month])&#13;&#10;END' />
            </column>
            <column caption='Work Items L1' datatype='real' name='[Calculation_785033765983760385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([count_working_item_l1_close],0) + IFNULL([count_working_item_l1_escalated],0)' />
            </column>
            <column caption='count_within_sla_l1' datatype='integer' name='[Calculation_785033765984468995]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([count_within_sla_l1_close], 0) + IFNULL([count_within_sla_l1_escalated], 0)' />
            </column>
            <column caption='AHT l1 close' datatype='real' name='[Calculation_93168273245208576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_handling_time_l1_close])/sum([count_working_item_l1_close])' />
            </column>
            <column caption='AHT l1 Escalate' datatype='real' name='[Calculation_93168273245335553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_handling_time_l1_escalated])/sum([count_working_item_l1_escalated])' />
            </column>
            <column caption='AHT l2' datatype='real' name='[Calculation_93168273245642754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_handling_time_l2])/sum([count_working_item_l2])' />
            </column>
            <column caption='Case SLA 8 Hr' datatype='real' default-format='p0.0%' name='[Case SLA 1 Hr  (copy)_1927822154906951683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([case_within_sla_8h])/sum([Calculation_3201988983234580480])' />
            </column>
            <column caption='Case SLA 1 Hr ' datatype='real' default-format='p0.0%' name='[Case SLA 24 Hrs (copy)_1927822154906767362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([case_within_sla_1h])/sum([Calculation_3201988983234580480])' />
            </column>
            <column caption='Date ' datatype='date' name='[Date Range (copy)_1446288859652755456]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[created_date_localtime]' />
            </column>
            <column caption='2nd Dimension' datatype='string' default-format='n#,##0.0;-#,##0.0' name='[Dimensions (copy)_2888003668867956737]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Country&apos; THEN [country]&#10;ELSEIF  [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Language&apos; THEN [language]&#13;&#10;ELSEIF  [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;DH Regions&apos; THEN [dh_region]&#13;&#10;ELSEIF  [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Contact Center&apos; THEN [contact_center]&#13;&#10;ELSEIF  [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Management Entity&apos; THEN [management_entity_group]&#13;&#10;ELSEIF  [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Brand&apos; THEN [brand]&#13;&#10;ELSEIF  [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Global&apos; THEN [Calculation_610026676822482944]&#10;ELSEIF [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Stakeholder Entry Point&apos; THEN [stakeholder_entry_point]&#10;ELSEIF [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Agent Facing Tool&apos; THEN [agent_facing_tool]&#10;ELSEIF [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Contact Resolution Skill&apos; THEN [contact_resolution_skill]&#10;ELSEIF [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Vertical&apos; THEN [vertical]&#10;ELSEIF [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Delivery Type&apos; THEN [delivery_type]&#10;ELSEIF [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Stakeholder&apos; THEN [stakeholder]&#10;ELSEIF [Parameters].[Dimensions (copy)_2888003668867932160]=&apos;Channel&apos; THEN [channel]&#10;&#10;&#13;&#10;END' />
            </column>
            <column caption='Date Range' datatype='date' name='[Iso Date (copy 2)]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[created_date_localtime]' />
            </column>
            <column caption='1st Dimension' datatype='string' default-format='n#,##0.0;-#,##0.0' name='[KPIS 1 (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 6]=&apos;Country&apos; THEN [country]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Language&apos; THEN [language]&#13;&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;DH Regions&apos; THEN [dh_region]&#13;&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Contact Center&apos; THEN [contact_center]&#13;&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Management Entity&apos; THEN [management_entity_group]&#13;&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Brand&apos; THEN [brand]&#13;&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Global&apos; THEN [Calculation_610026676822482944]&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Stakeholder Entry Point&apos; THEN [stakeholder_entry_point]&#10;ELSEIF [Parameters].[Parameter 6]=&apos;Agent Facing Tool&apos; THEN [agent_facing_tool]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Contact Resolution Skill&apos; THEN [contact_resolution_skill]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Vertical&apos; THEN [vertical]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Delivery Type&apos; THEN [delivery_type]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Stakeholder&apos; THEN [stakeholder]&#10;ELSEIF  [Parameters].[Parameter 6]=&apos;Channel&apos; THEN [channel]&#10;&#13;&#10;END' />
            </column>
            <column caption='Case SLA 24 Hrs' datatype='real' default-format='p0.0%' name='[SLA L1 (copy)_5558638216490434561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([case_within_sla])/sum([Calculation_3201988983234580480])' />
