          <datasource-dependencies datasource='federated.0gqoovo0dtggoq11xfe5g16gaz4t'>
            <column caption='% Outbound Unsuccess Rate' datatype='real' default-format='p0%' name='[% Outbound Success Rate (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_3704140387771023364])/SUM([outbound_call_ind])' />
            </column>
            <column caption='AHTSuccessful  Outbound Calls  (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AHT (Inbound Calls) (min.) (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([outbound_more_30s_ht_call])/sum([count_outbound_more_30s_call])/60' />
            </column>
            <column caption='AHT All Outbound Calls  (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AHT Outbound Calls  (min) (copy)_5558638216501174274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([outbound_ht_call])/sum([outbound_call_ind])/60' />
            </column>
            <column caption='% Outbound Success Rate' datatype='real' default-format='p0%' name='[Calculation_1567674907872342016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_outbound_more_30s_call])/SUM([outbound_call_ind])' />
            </column>
            <column caption='# Unsuccessful Outbound Calls' datatype='integer' name='[Calculation_3704140387771023364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([outbound_call_ind]) - SUM([count_outbound_more_30s_call])' />
            </column>
            <column caption='% Outbound HT &lt; 3 min' datatype='real' default-format='p0%' name='[Calculation_3704140387771650053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(count_outbound_less_3min_call)/ SUM([outbound_call_ind])' />
            </column>
