      <column caption='Gross Orders' datatype='real' default-format='n#,##0;-#,##0' hidden='true' name='[Calculation_886927663763963905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [brand],[country],[iso_date]: max([gross_orders])})' />
      </column>
      <column caption='Incoming incidents' datatype='integer' default-format='n#,##0;-#,##0' hidden='true' name='[Calculation_902127311510130689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IFNULL([Calculation_583216190460092416],0))+&#13;&#10;IFNULL([Calculation_886927664064929795],0)+&#13;&#10;SUM(IFNULL([outbound_call_ind],0))+&#13;&#10;SUM(IFNULL([new_emails],0))+&#13;&#10;SUM(IFNULL([new_some],0))+&#13;&#10;SUM(IFNULL([Calculation_3201988983234580480],0))+&#10;SUM(IFNULL([Calculation_1320680644565000199],0) )' />
      </column>
      <column caption='Productivity' datatype='real' default-format='n#,##0.0;-#,##0.0' hidden='true' name='[Calculation_902127311510458370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL(SUM([hours_clocked_net])) THEN&#10;   ( ([Calculation_508343809385873408]) &#10;    )&#10;    / SUM([hours_clocked_net] )&#10;ELSE null&#10;END' />
      </column>
      <column caption='Productivity (Chats)' datatype='real' default-format='n#,##0.0;-#,##0.0' hidden='true' name='[Calculation_902127311510740995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_939844957981401088]/sum([hours_clocked_net_chats])' />
      </column>
      <column caption='AHT l1 close' datatype='real' name='[Calculation_93168273245208576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sum_handling_time_l1_close])/sum([count_working_item_l1_close])' />
      </column>
      <column caption='AHT l1 Escalate' datatype='real' name='[Calculation_93168273245335553]' role='measure' type='quantitative'>
