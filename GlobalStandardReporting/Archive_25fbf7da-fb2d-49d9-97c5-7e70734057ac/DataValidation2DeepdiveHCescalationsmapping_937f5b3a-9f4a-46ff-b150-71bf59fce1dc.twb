      </column>
      <column caption='AQT All Chats (s) ' datatype='real' default-format='n#,##0;-#,##0' name='[AQT Served Chats  (s) (copy)_1248693410757128193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([queue_time_served_chat],0) +IFNULL([queue_time_missed_chat],0))/&#10;[Calculation_6901414647111073792]' />
