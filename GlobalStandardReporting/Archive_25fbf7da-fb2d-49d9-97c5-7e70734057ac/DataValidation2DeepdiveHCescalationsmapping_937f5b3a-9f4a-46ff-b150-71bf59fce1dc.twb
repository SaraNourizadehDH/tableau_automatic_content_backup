            <column caption='Select KPI' datatype='real' name='[Calculation_875387238556819457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Case Origin (copy)] = &apos;# Processed Issues&apos; THEN [# Incoming Issues (copy)_875387238557978627]&#10;ELSEIF [Parameters].[Case Origin (copy)] = &apos;# Incoming Issues&apos; THEN [# Incoming Chats (copy)_875387238557908994]&#10;ELSEIF [Parameters].[Case Origin (copy)] = &apos;# Incoming Chats&apos; THEN ([Calculation_6901414647111073792])&#10;ELSEIF [Parameters].[Case Origin (copy)] = &apos;SLA 30s Chats&apos; THEN [Calculation_939844958047555588]&#10;ELSEIF [Parameters].[Case Origin (copy)] = &apos;AQT Served Chats&apos;  THEN [Calculation_939844958072664075]&#10;ELSEIF [Parameters].[Case Origin (copy)] = &apos;AHT Chats  (min)&apos; THEN [Calculation_939844958072197130]&#10;ELSEIF [Parameters].[Case Origin (copy)] = &apos;# Inbound Valid Calls&apos; THEN ([# Incoming IVR (copy)])&#10;ELSEIF [Parameters].[Case Origin (copy)] = &apos;AHT Inbound Calls (min)&apos; THEN [Calculation_939844958077071376]&#10;ELSEIF [Parameters].[Case Origin (copy)] = &apos;SLA 30s Calls&apos; THEN [Calculation_939844958049337350]&#10;ELSEIF [Parameters].[Case Origin (copy)] = &apos;# Outbound Calls&apos; THEN SUM([outbound_call_ind])&#10;ELSEIF [Parameters].[Case Origin (copy)] = &apos;AHT All Outbound Calls  (min)&apos; THEN [AHT Outbound Calls  (min) (copy)_5558638216501174274]&#10;ELSEIF [Parameters].[Case Origin (copy)] = &apos;# Incoming Cases&apos; THEN SUM([Calculation_3201988983234580480])&#10;END' />
            </column>
            <column caption='# Served Chats' datatype='integer' name='[Calculation_939844957981401088]' role='measure' type='quantitative'>
