      <aliases enabled='yes' />
      <column caption='# Incoming Issues' datatype='integer' name='[# Incoming Chats (copy)_875387238557908994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([incoming_chat_ind],0)) +&#10;(IFNULL([# Incoming IVR (copy)],0)) +&#10;SUM(IFNULL([outbound_call_ind],0)) +&#10;SUM(IFNULL([incoming_case_ind],0))' />
      </column>
      <column caption='# Inbound Valid Calls' datatype='integer' name='[# Incoming IVR (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([inbound_call_ind],0)) &#10;- SUM(IFNULL([abandoned_call_ind],0)) &#10;+SUM(IFNULL([missed_call_ind],0))' />
      </column>
      <column caption='# Processed Issues' datatype='integer' name='[# Incoming Issues (copy)_875387238557978627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([resolved_case_ind],0)) +&#10;(IFNULL([Calculation_939844957981401088],0)) +&#10;SUM(IFNULL([served_call_ind],0)) +&#10;SUM(IFNULL([count_outbound_more_30s_call],0))' />
      </column>
      <column caption='% No- Evaluation Shifts' datatype='real' default-format='p0%' hidden='true' name='[% Evaluated Shifts (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([no_evaluation]) /([Calculation_1936125657671262210])' />
      </column>
      <column caption='% Other Reasons' datatype='real' default-format='p0.0%' hidden='true' name='[% Late to Dropoff (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - (&#10;[Calculation_788129994232078336]&#10;+ [Calculation_788129994232700929]&#10;+ [Calculation_788129994232897538]&#10;+ [Calculation_788129994276970502]&#10;+ [Calculation_788129994277163015]&#10;+ [Calculation_788129994233057283]&#10;+ [Calculation_788129994234224645]&#10;+ [Calculation_788129994277888010]&#10;+ [Calculation_788129994277437448]&#10;+ [Calculation_788129994277552137]&#10;+ [% Waiting (copy)]&#10;&#10;&#10;)' />
      </column>
      <column caption='% Missed Chats with QT &lt; 1 min' datatype='real' default-format='p0%' name='[% Missed Chats Online (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(count_missed_qt_less_1min_chat) / SUM([missed_chat_ind])' />
      </column>
      <column caption='% Served Chats with QT &lt; 1 min' datatype='real' default-format='p0%' name='[% Missed Chats Online with QT &lt; 1 min (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(count_served_qt_less_1min_chat) / ([Calculation_939844957981401088])' />
      </column>
      <column caption='% Missed Calls with QT &lt; 30 sec' datatype='real' default-format='p0%' name='[% Missed Online (copy 2)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([missed_qt_less_30s_call]) / SUM( [missed_call_ind])' />
      </column>
      <column caption='% Outbound Unsuccess Rate' datatype='real' default-format='p0%' name='[% Outbound Success Rate (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_3704140387771023364])/SUM([outbound_call_ind])' />
      </column>
      <column caption='% Evaluated Shifts' datatype='real' default-format='p0%' hidden='true' name='[% Punched Shifts (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([evaluated]) /([Calculation_1936125657671262210])' />
      </column>
      <column caption='% Dropped Chats within 30s' datatype='real' default-format='p0%' name='[% Valid Chats (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6901414648091095043] / [Calculation_6901414647111073792]' />
      </column>
      <column caption='% Missed Calls' datatype='real' default-format='p0%' name='[% Valid Inbound (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( [missed_call_ind]) / ([# Incoming IVR (copy)])' />
      </column>
      <column caption='% Orders Manually Dispatched' datatype='real' default-format='p0.0%' hidden='true' name='[% Waiting (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders_manually_dispatched])/sum([Calculation_1320680644565000199])' />
      </column>
