      <table>
        <view>
          <datasources>
            <datasource caption='channel_day_metrics' name='federated.0gqoovo0dtggoq11xfe5g16gaz4t' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity Level' datatype='string' name='[Completed Week Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='2nd Dimension' datatype='string' name='[Dimensions (copy)_2888003668867932160]' param-domain-type='list' role='measure' type='nominal' value='&quot;Agent Facing Tool&quot;'>
              <calculation class='tableau' formula='&quot;Agent Facing Tool&quot;' />
              <aliases>
                <alias key='&quot;Contact Center&quot;' value='Contact Center' />
              </aliases>
            </column>
            <column caption='1st Dimension' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
              <aliases>
                <alias key='&quot;Contact Center&quot;' value='Contact Center' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0gqoovo0dtggoq11xfe5g16gaz4t'>
            <column caption='# Inbound Valid Calls' datatype='integer' name='[# Incoming IVR (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([served_call_ind]) +SUM([missed_call_ind])' />
            </column>
            <column caption='CSAT' datatype='real' default-format='p0%' name='[CSAT (Chats) (copy)_3562980665898053633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_csat_4_5])/SUM([count_csat_responses])' />
            </column>
            <column caption='AHT L1' datatype='real' name='[Calculation_1204712958360883200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;sum(IFNULL([sum_handling_time_l1_close],0))+&#13;&#10;sum(IFNULL([sum_handling_time_l1_escalated],0))&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;sum([count_working_item_l1_close])+&#13;&#10; sum([count_working_item_l1_escalated])&#13;&#10;)' />
            </column>
            <column caption='Case SLA 48 Hrs' datatype='real' name='[Calculation_216735767526223873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([case_within_sla_48h])/sum([Calculation_3201988983234580480])' />
            </column>
            <column caption='% 1-time Contacts' datatype='real' default-format='p0%' hidden='true' name='[Calculation_277956598566154240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_first_contact_resolution]) / SUM([no_contacts_related_to_order])' />
            </column>
            <column caption='# Incoming Cases' datatype='integer' name='[Calculation_3201988983234580480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(([incoming_case_ind]),0)' />
            </column>
            <column caption='Completed Contacts' datatype='real' hidden='true' name='[Calculation_508343809385873408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IFNULL([Calculation_939844957981401088],0)&#13;&#10;+SUM(IFNULL([served_call_ind],0))&#13;&#10;+SUM(IFNULL([Calculation_785033765983760385],0)))' />
            </column>
            <column caption='Global' datatype='string' name='[Calculation_610026676822482944]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Global&apos;' />
            </column>
            <column caption='# Incoming Chats' datatype='integer' name='[Calculation_6901414647111073792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([incoming_chat_ind])' />
            </column>
            <column caption='Granularity' datatype='string' name='[Calculation_772930316894855168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Completed Week Parameter]=&apos;Daily&apos; THEN STR([created_date_localtime])&#13;&#10;ELSEIF [Parameters].[Completed Week Parameter]=&apos;Weekly&apos; THEN STR([week])&#13;&#10;ELSEIF [Parameters].[Completed Week Parameter]=&apos;Monthly&apos; THEN STR([month])&#13;&#10;END' />
            </column>
            <column caption='Work Items L1' datatype='real' name='[Calculation_785033765983760385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([count_working_item_l1_close],0) + IFNULL([count_working_item_l1_escalated],0)' />
            </column>
            <column caption='Gross Attendance' datatype='real' default-format='p0.0%' hidden='true' name='[Calculation_873416875852017666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([hours_clocked_within_schedule])/sum([hours_scheduled])' />
            </column>
            <column caption='Productivity' datatype='real' default-format='n#,##0.0;-#,##0.0' hidden='true' name='[Calculation_902127311510458370]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF NOT ISNULL(SUM([hours_clocked_net])) THEN&#10;   ( ([Calculation_508343809385873408]) &#10;    )&#10;    / SUM([hours_clocked_net] )&#10;ELSE null&#10;END' />
            </column>
            <column caption='# Served Chats' datatype='integer' name='[Calculation_939844957981401088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([served_chat_ind])' />
            </column>
            <column caption='SLA 30s Chats' datatype='real' default-format='p0.0%' name='[Calculation_939844958047555588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_sla_30s_chat])/&#10;(([Calculation_6901414647111073792])&#10;)' />
            </column>
            <column caption='AHT Chats  (min)' datatype='real' name='[Calculation_939844958072197130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([handling_time_chat])/[Calculation_939844957981401088]/60' />
            </column>
            <column caption='AQT Served Chats  (s)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_939844958072664075]' role='measure' type='quantitative'>
