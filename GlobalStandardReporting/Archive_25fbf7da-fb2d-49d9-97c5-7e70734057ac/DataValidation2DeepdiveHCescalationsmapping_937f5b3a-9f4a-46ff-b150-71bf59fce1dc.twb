      <column caption='AGG AHT Live (min)' datatype='real' hidden='true' name='[Calculation_934496979295862784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;ifnull(sum([sum_handle_time_answered_inbound])/60, 0)+&#13;&#10;IFNULL( sum([sum_duration_served])/60 ,0)&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;ifnull(sum([served_call_ind]) ,0)+&#13;&#10; ifnull([Calculation_939844957981401088] ,0)&#13;&#10; )' />
      </column>
      <column caption='AGG AHT Batch (hrs)' datatype='real' hidden='true' name='[Calculation_934496979296129025 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10; IFNULL( sum([sum_resolution_time_in]),0)+&#13;&#10;IFNULL( (sum([response_time_l1_close]) * 60) ,0)+&#13;&#10;IFNULL( (sum([response_time_l1_escalated])* 60),0)+&#13;&#10;IFNULL( (sum([response_time_l2])* 60),0)&#13;&#10;)&#13;&#10;/&#13;&#10;(&#13;&#10;IFNULL(sum([ticket_full_resolution_time]),0)+&#13;&#10; IFNULL(sum([count_sla_l1_close]),0) +&#13;&#10;IFNULL( sum([count_sla_l1_escalated]),0) +&#13;&#10;IFNULL( sum([count_sla_l2]),0)&#13;&#10;)' />
