      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/Phase2UserProfiles-CustomerSegmentation_16481377803480/Overview?rev=' id='Overview' path='/t/GlobalStandardReporting/workbooks/Phase2UserProfiles-CustomerSegmentation' revision='' site='GlobalStandardReporting' />
      <style>
