            </column>
            <column caption='Localstores Lastyear Order Counts ' datatype='real' name='[Darkstores Lastyear Order Counts (copy)_355291800594341939]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [analytical_customer_id] : AVG([localstores_lastyear_order_count])}' />
            </column>
