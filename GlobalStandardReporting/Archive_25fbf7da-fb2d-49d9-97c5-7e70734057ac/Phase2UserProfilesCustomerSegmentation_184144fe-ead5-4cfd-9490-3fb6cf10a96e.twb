            <column caption='Last16w Order Frequency (Overview) ' datatype='real' name='[Last16w Order count (Overview) (copy)_307652192206778373]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 4]=&apos;Quick Commerce&apos; THEN&#10;SUM([Last16W Discount GMV sum (copy)_2281706550469763074])/COUNTD([Timeframe Customer count 1w (copy) (copy)_3872251302002044930])//16 weeks and 7 days per week&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Dmart&apos;&#10;THEN&#10;SUM([Darkstores Last16W ABV (copy) (copy)_355291800574275590])/COUNTD([Timeframe Customer count 1w (copy) (copy)_3872251302002044930])&#10;&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Localstores&apos;&#10;THEN&#10; SUM([Darkstores Last16W Order Counts (copy)_355291800594341941])/COUNTD([Timeframe Customer count 1w (copy) (copy)_3872251302002044930])&#10;&#10;END' />
