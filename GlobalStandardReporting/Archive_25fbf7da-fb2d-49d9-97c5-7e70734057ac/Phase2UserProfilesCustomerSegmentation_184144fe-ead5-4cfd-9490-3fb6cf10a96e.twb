            <alias key='&quot;FP_TH&quot;' value='Thailand' />
            <alias key='&quot;FP_TW&quot;' value='Taiwan' />
            <alias key='&quot;FY_CY&quot;' value='Cyprus' />
            <alias key='&quot;HF_EG&quot;' value='Egypt' />
            <alias key='&quot;HS_SA&quot;' value='Saudi Arabia' />
            <alias key='&quot;MJM_AT&quot;' value='Austria' />
