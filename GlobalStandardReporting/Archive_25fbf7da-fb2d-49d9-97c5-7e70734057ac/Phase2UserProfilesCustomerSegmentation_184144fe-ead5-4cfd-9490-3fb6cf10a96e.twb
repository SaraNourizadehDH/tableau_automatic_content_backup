    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Introduction'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/Phase2UserProfiles-CustomerSegmentation_16481377803480/Introduction?rev=' id='Introduction' path='/t/GlobalStandardReporting/workbooks/Phase2UserProfiles-CustomerSegmentation' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1000' maxwidth='1200' minheight='1000' minwidth='1200' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='17700' id='28' param='vert' type-v2='layout-flow' w='98666' x='667' y='800'>
            <zone h='17700' id='335' param='Image/Screenshot 2022-03-14 at 12.53.02.png' type-v2='bitmap' w='98666' x='667' y='800'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone h='80700' id='30' param='horz' type-v2='layout-flow' w='89584' x='5583' y='18500'>
            <zone h='80700' id='29' param='vert' type-v2='layout-flow' w='89584' x='5583' y='18500'>
              <zone fixed-size='53' forceUpdate='true' h='6100' id='12' is-fixed='true' type-v2='text' w='89584' x='5583' y='18500'>
                <formatted-text>
                  <run bold='true' fontcolor='#c63530' fontsize='18'>Introduction</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='22000' id='11' type-v2='text' w='89584' x='5583' y='24600'>
                <formatted-text>
                  <run fontcolor='#000000' fontsize='12'>This dashboard is the evolution from Phase 1 of the Customer Segmentation Workstream. Please click on  the link below to access the phase 1 dashboard </run>
                  <run auto-url='true' fontcolor='#000000' fontsize='12' hyperlink='tabdoc:load-url url=&amp;quot;https://tableau.deliveryhero.net/#/site/GlobalStandardReporting/workbooks/16557/views&amp;quot;'>https://tableau.deliveryhero.net/#/site/GlobalStandardReporting/workbooks/16557/views</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#000000' fontsize='12'>We have used a modeling approach to identify 8 independent User Profiles. By providing Order related features,  Onsite / In-App behavior features and Categories preferences into a Unsupervised Machine Learning model, we have uncovered the key User Profiles that exist across all entities, whilst limiting the number of assumptions we have made within the methodology. </run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#000000' fontsize='12'>The 8 Main Entities are shown below. The dashboard visualizes key descriptive metrics for each Profile, as well as allowing deep dives into specific entities to uncover market level trends. </run>
                  <run>Æ&#10;&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone fixed-size='370' h='37800' id='254' is-fixed='true' is-scaled='1' param='Image/Screenshot 2022-03-14 at 14.09.30.png' type-v2='bitmap' w='89584' x='5583' y='46600'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone fixed-size='94' forceUpdate='true' h='10200' id='27' is-fixed='true' type-v2='text' w='89584' x='5583' y='84400'>
                <formatted-text>
                  <run fontcolor='#000000' fontsize='12'>Full details about the methodology and full descriptions and characteristics for each of the User Profiles can be </run>
                  <run auto-url='true' fontcolor='#000000' fontsize='12' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/presentation/d/1cVV-VKL_TBWnPU0e8716vl50QtmJ4DgrFcHAzhwdQHQ/edit#slide=id.g1078be313e9_0_0&amp;quot;'>https://docs.google.com/presentation/d/1cVV-VKL_TBWnPU0e8716vl50QtmJ4DgrFcHAzhwdQHQ/edit#slide=id.g1078be313e9_0_0</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='12'>If you have any questions, please reach out to  (</run>
                  <run fontcolor='#75a1c7' fontsize='12' italic='true' underline='true'>syed.jafri.2@deliveryhero.com</run>
                  <run fontcolor='#000000' fontsize='12'>)</run>
                  <run>Æ&#10;&#10;&#10;&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone h='80700' id='31' type-v2='empty' w='4916' x='667' y='18500'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
