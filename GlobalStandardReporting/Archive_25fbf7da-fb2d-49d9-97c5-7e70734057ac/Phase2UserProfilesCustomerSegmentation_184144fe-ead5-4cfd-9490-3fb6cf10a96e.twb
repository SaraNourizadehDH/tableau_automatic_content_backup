            <column caption='Timeframe ABV' datatype='real' name='[Calculation_1422856010754453504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 4]=&apos;Quick Commerce&apos; THEN (IF &#10;[Parameters].[Parameter 2]=&apos;1 week&apos; then SUM([Darkstores Last16W ABV (copy)_355291800574263301]+ [Darkstores Last1W ABV (copy)_355291800585158705])/SUM([Last1W GMV Sum (copy)_2764576880128450565])&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;4 weeks&apos; then SUM([Darkstores Last16W ABV (copy) (copy 2)_355291800574312456]+ [Darkstores Last4W ABV (copy)_355291800585158703])/SUM([Last16W Order Count (copy)_2281706550470545415])&#10;&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;16 weeks&apos; then SUM([Calculation_355291800552972289]+ [Darkstores Last16W ABV (copy)_355291800585158701])/SUM([Last16W Discount GMV sum (copy)_2281706550469763074])&#10;&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Last year&apos; then SUM([Darkstores Last16W ABV (copy) (copy 2) (copy)_355291800574345225]+ [Darkstores Lastyear ABV  (copy)_355291800585158702])/SUM([Last1W Order Count (copy)_2764576880129130508])&#10;&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Lifetime&apos; then SUM([Darkstores Last16W ABV (copy) (copy 3)_355291800574345228]+[Darkstores Lifetime  ABV (copy)_355291800585158704])/SUM([Lastyear Order Count (copy)_2764576880137015312])&#10;END)&#10;&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Dmart&apos;&#10;THEN&#10;( IF &#10;[Parameters].[Parameter 2]=&apos;1 week&apos; then SUM([Darkstores Last16W ABV (copy)_355291800574263301])/SUM([Darkstores Last16W ABV (copy) (copy) (copy 2)_355291800574345227])&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;4 weeks&apos; then SUM([Darkstores Last16W ABV (copy) (copy 2)_355291800574312456])/SUM([Darkstores Last16W ABV (copy) (copy) (copy)_355291800574312455])&#10;&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;16 weeks&apos; then   Sum([Calculation_355291800552972289])/SUM([Darkstores Last16W ABV (copy) (copy)_355291800574275590])&#10;&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Last year&apos; then SUM([Darkstores Last16W ABV (copy) (copy 2) (copy)_355291800574345225])/SUM([Darkstores Last16W ABV (copy) (copy) (copy) (copy)_355291800574345226])&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Lifetime&apos; then SUM([Darkstores Last16W ABV (copy) (copy 3)_355291800574345228]) /SUM([Darkstores Last16W Order Counts (copy)_355291800576163854])&#10;END)&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Localstores&apos;&#10;THEN&#10;( IF &#10;[Parameters].[Parameter 2]=&apos;1 week&apos; then SUM([Darkstores Last1W ABV (copy)_355291800585158705])/SUM([localstores_last16w_order_count])&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;4 weeks&apos; then SUM([Darkstores Last4W ABV (copy)_355291800585158703])/SUM([Darkstores Last4W Order Counts (copy)_355291800594341940])&#10;&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;16 weeks&apos; then   Sum([Darkstores Last16W ABV (copy)_355291800585158701])/SUM([Darkstores Last16W Order Counts (copy)_355291800594341941])&#10;&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Last year&apos; then SUM([Darkstores Lastyear ABV  (copy)_355291800585158702])/SUM([Darkstores Lastyear Order Counts (copy)_355291800594341939])&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Lifetime&apos; then SUM([Darkstores Lifetime  ABV (copy)_355291800585158704]) /SUM([Darkstores Lifetime Order Counts (copy)_355291800594341942])&#10;END)&#10;END' />
            </column>
            <column caption='Timeframe Customer count' datatype='string' name='[Calculation_1422856010755297281]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 4]=&apos;Quick Commerce&apos;&#10;THEN (IF&#10;[Parameters].[Parameter 2]=&apos;1 week&apos; AND&#10;  (([Darkstores Last16W ABV (copy) (copy) (copy 2)_355291800574345227]&gt;0 OR [Darkstores Last1W Order Counts (copy)_355291800594341938]&gt;0))  &#10;THEN [analytical_customer_id]&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;4 weeks&apos; AND &#10;(([Darkstores Last16W ABV (copy) (copy) (copy)_355291800574312455]&gt;0 OR [Darkstores Last4W Order Counts (copy)_355291800594341940]&gt;0))&#10;THEN [analytical_customer_id]&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;16 weeks&apos; AND&#10; (([Darkstores Last16W ABV (copy) (copy)_355291800574275590]&gt;0 OR [Darkstores Last16W Order Counts (copy)_355291800594341941]&gt;0))&#10;THEN [analytical_customer_id]&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Last year&apos; AND&#10; (([Darkstores Last16W ABV (copy) (copy) (copy) (copy)_355291800574345226]&gt;0 OR [Darkstores Lastyear Order Counts (copy)_355291800594341939]&gt;0) )&#10;THEN [analytical_customer_id]&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Lifetime&apos; AND&#10; (([Darkstores Last16W Order Counts (copy)_355291800576163854]&gt;0 OR [Darkstores Lifetime Order Counts (copy)_355291800594341942]&gt;0) )&#10;THEN [analytical_customer_id]&#10;END)&#10;ELSEIF &#10;[Parameters].[Parameter 4]=&apos;Dmart&apos;&#10;THEN (IF&#10;[Parameters].[Parameter 2]=&apos;1 week&apos; AND&#10;  (([Darkstores Last16W ABV (copy) (copy) (copy 2)_355291800574345227]&gt;0 ))  &#10;THEN [analytical_customer_id]&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;4 weeks&apos; AND &#10;(([Darkstores Last16W ABV (copy) (copy) (copy)_355291800574312455]&gt;0 ))&#10;THEN [analytical_customer_id]&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;16 weeks&apos; AND&#10; (([Darkstores Last16W ABV (copy) (copy)_355291800574275590]&gt;0 ))&#10;THEN [analytical_customer_id]&#10;ELSEIF &#10;[Parameters]