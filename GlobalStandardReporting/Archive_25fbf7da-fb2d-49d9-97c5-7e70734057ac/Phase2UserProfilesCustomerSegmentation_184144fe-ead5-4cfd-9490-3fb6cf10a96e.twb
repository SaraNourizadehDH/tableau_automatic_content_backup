              <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 4]=&apos;Quick Commerce&apos;&#10;  THEN(IF &#10;   [Parameters].[Parameter 2] = &quot;16 weeks&quot; &#10;       THEN (&#10;             IF &#10;              [Parameters].[Parameter 1]= &apos;Discount sum&apos; THEN SUM([Darkstores Last16W Discount Sums (copy)_469289168632422400]+[Localstores Last16W Discount Sums (copy)_469289168632422401])/SUM([Last16W Discount GMV sum (copy)_2281706550469763074])*100&#10;             ELSEIF &#10;              [Parameters].[Parameter 1] = &apos;ABV&apos; then SUM([Calculation_355291800552972289]+[Darkstores Last16W ABV (copy)_355291800585158701])/SUM([Last16W Discount GMV sum (copy)_2281706550469763074])&#10;             ELSEIF &#10;              [Parameters].[Parameter 1] = &apos;Order count&apos; then SUM([Darkstores Last16W ABV (copy) (copy)_355291800574275590]+[Darkstores Last16W Order Counts (copy)_355291800594341941])&#10;             ELSEIF &#10;              [Parameters].[Parameter 1] = &apos;Qty ordered&apos; then SUM([Darkstores Last16W ABV (copy)_355291800580624409]+[Darkstores Last16W Qty Ordered sums (copy)_355291800581550112])/SUM([Last16W Discount GMV sum (copy)_2281706550469763074])&#10;             ELSEIF &#10;              [Parameters].[Parameter 1] = &apos;Voucher sum&apos; then SUM([Darkstores Last16W Voucher Sums (copy)_469289168638087178]+[Darkstores Last16W Voucher Order Counts (copy)_469289168640339988])/SUM([Last16W Discount GMV sum (copy)_2281706550469763074])&#10;             ELSEIF &#10;              [Parameters].[Parameter 1] = &apos;Unique Customers&apos; then COUNTD([Calculation_1422856010755297281])&#10;        END&#10;)&#10;// 4 WEEKS//&#10;ELSEIF&#10;  [Parameters].[Parameter 2]=&quot;4 weeks&quot;&#10;THEN   (&#10;             IF &#10;              [Parameters].[Parameter 1]= &apos;Discount sum&apos; THEN SUM([Darkstores Last4W Discount Sums (copy)_469289168632422404]+[Localstores Last4W Discount Sums  (copy)_469289168632422405])/SUM([Last16W Order Count (copy)_2281706550470545415])*100&#10;             ELSEIF &#10;              [Parameters].[Parameter 1] = &apos;ABV&apos; then SUM([Darkstores Last16W ABV (copy) (copy 2)_355291800574312456]+[Darkstores Last4W ABV (copy)_355291800585158703])/SUM([Last16W Order Count (copy)_2281706550470545415])&#10;             ELSEIF &#10;              [Parameters].[Parameter 1] = &apos;Order count&apos; then SUM([Darkstores Last16W ABV (copy) (copy) (copy)_355291800574312455]+[Darkstores Last4W Order Counts (copy)_355291800594341940])&#10;             ELSEIF &#10;              [Parameters].[Parameter 1] = &apos;Qty ordered&apos; then SUM([Darkstores Last4W ABV (copy)_355291800580624411]+[Darkstores Last4W Qty Ordered sums (copy)_355291800581550118])/SUM([Last16W Order Count (copy)_2281706550470545415])&#10;             ELSEIF &#10;              [Parameters].[Parameter 1] = &apos;Voucher sum&apos; then SUM([Darkstores Last4W Voucher Sums (copy)_469289168638087182]+[Darkstores Last4W Voucher Order Counts (copy)_469289168640339990])/SUM([Last16W Order Count (copy)_2281706550470545415])&#10;             ELSEIF &#10;              [Parameters].[Parameter 1] = &apos;Unique Customers&apos; then COUNTD([Calculation_1422856010755297281])&#10;&#10;END&#10;)&#10;ELSEIF&#10;  [Parameters].[Parameter 2]=&quot;1 week&quot;&#10;THEN   (&#10;             IF &#10;              [Parameters].[Parameter 1]= &apos;Discount sum&apos; THEN SUM([Darkstores Last1W ABV (copy)_355291800578986003]+[Darkstores Last1W Discount Sums (copy)_355291800581550113])/SUM([Last1W GMV Sum (copy)_2764576880128450565])*100&#10;             ELSEIF &#10;              [Parameters].[Parameter 1] = &apos;ABV&apos; then SUM([Darkstores Last16W ABV (copy)_355291800574263301]+[Darkstores Last1W ABV (copy)_355291800585158705])/SUM([Last1W GMV Sum (copy)_2764576880128450565])&#10;             ELSEIF &#10;              [Parameters].[Parameter 1] = &apos;Order count&apos; then SUM([Darkstores