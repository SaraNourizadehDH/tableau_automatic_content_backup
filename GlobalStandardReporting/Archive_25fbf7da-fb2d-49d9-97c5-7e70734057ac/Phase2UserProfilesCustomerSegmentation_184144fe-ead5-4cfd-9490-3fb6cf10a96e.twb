              <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 4]=&apos;Quick Commerce&apos;&#10;THEN(IF&#10;[Parameters].[Parameter 2]=&apos;Lifetime&apos;&#10;THEN&#10;SUM([Qc Lifetime Morning Order Count (copy)_355291800618340413])&#10;/(SUM([Qc Lifetime Morning Order Count (copy)_355291800618340413])+SUM([Qc Lifetime Afternoon Order Count (copy)_355291800619835458])+SUM([Qc Lifetime Night Order Count (copy)_355291800621015111]))&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Last year&apos;&#10;THEN&#10;SUM([Qc Lastyear Morning Order Count (copy)_355291800618340412])&#10;/(SUM([Qc Lastyear Morning Order Count (copy)_355291800618340412])+SUM([Qc Lastyear Afternoon Order Count (copy)_355291800619835457])+SUM([Qc Lastyear Night Order Count (copy)_355291800621015110]))&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;16 weeks&apos;&#10;THEN&#10;SUM([Qc Last16W Morning Order Count (copy)_355291800618340409])&#10;/(SUM([Qc Last16W Morning Order Count (copy)_355291800618340409])+SUM([Qc Last16W Afternoon Order Count (copy)_355291800619835454])+SUM([Qc Last16W Night Order Count (copy)_355291800621015107]))&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;4 weeks&apos;&#10;THEN&#10;SUM([Qc Last4W Morning Order Count (copy)_355291800618340411])&#10;/(SUM([Qc Last4W Morning Order Count (copy)_355291800618340411])+SUM([Qc Last4W Afternoon Order Count (copy)_355291800619835456])+SUM([Qc Last4W Night Order Count (copy)_355291800621015109]))&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;1 week&apos;&#10;THEN&#10;SUM([Qc Last1W Morning Order Count (copy)_355291800618340410])&#10;/(SUM([Qc Last1W Morning Order Count (copy)_355291800618340410])+SUM([Qc Last1W Afternoon Order Count (copy)_355291800619835455])+SUM([Qc Last1W Night Order Count (copy)_355291800621015108]))&#10;END)&#10;ELSEIF &#10;[Parameters].[Parameter 4]=&apos;Dmart&apos;&#10;THEN(IF&#10;[Parameters].[Parameter 2]=&apos;Lifetime&apos;&#10;THEN&#10;SUM([darkstores_lifetime_morning_order_co