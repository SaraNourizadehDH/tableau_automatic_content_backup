            <column caption='Localstores Last1W Order Counts ' datatype='real' name='[Darkstores Last1W Order Counts (copy)_355291800594341938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [analytical_customer_id] : AVG([localstores_last1w_order_count])}' />
