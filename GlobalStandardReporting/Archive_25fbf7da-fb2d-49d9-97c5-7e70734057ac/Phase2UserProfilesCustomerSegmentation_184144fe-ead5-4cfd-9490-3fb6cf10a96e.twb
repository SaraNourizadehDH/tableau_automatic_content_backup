              <calculation class='tableau' formula='IF ISNULL([sub_segments]) AND [Calculation_3979774717593001985]=&quot;1&quot; THEN&#10; [Parameters].[Segment for Graph 1 (copy)_6798676243794608152]&#10;ELSE&#10;TRIM( SPLIT( [sub_segments], &quot;_&quot;, 2 ) )+&quot; &quot; +TRIM( SPLIT( [sub_segments], &quot;_&quot;, 3 ) )&#10;END' />
