            <column caption='Last16W ABV sum (Overview)' datatype='real' name='[Last16W Discount Sum (copy)_2281706550469640193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 4]=&apos;Quick Commerce&apos; THEN&#10;SUM([Calculation_355291800552972289]+ [Darkstores Last16W ABV (copy)_355291800585158701])/SUM([Last16W Discount GMV sum (copy)_2281706550469763074])&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Dmart&apos;&#10;THEN&#10; Sum([Calculation_355291800552972289])/SUM([Darkstores Last16W ABV (copy) (copy)_355291800574275590])&#10;&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Localstores&apos;&#10;    THEN&#10; Sum([Darkstores Last16W ABV (copy)_355291800585158701])/SUM([Darkstores Last16W Order Counts (copy)_355291800594341941])&#10;&#10;END' />
