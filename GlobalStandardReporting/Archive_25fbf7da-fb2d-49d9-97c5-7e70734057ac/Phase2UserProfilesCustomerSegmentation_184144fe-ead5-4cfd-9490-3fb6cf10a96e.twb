    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Dmart Store Location Deepdive'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>&lt;Sheet Name&gt;</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#c63530' fontsize='8'>To increase space in the text</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontsize='8'>Please note a single customer can belong to multiple segments</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/Phase2UserProfiles-CustomerSegmentation_16481377803480/DmartStoreLocationDeepdive?rev=' id='DmartStoreLocationDeepdive' path='/t/GlobalStandardReporting/workbooks/Phase2UserProfiles-CustomerSegmentation' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#00000000' />
        </style-rule>
        <style-rule element='dash-title'>
          <format attr='color' value='#ffffff' />
          <format attr='background-color' value='#c63530' />
        </style-rule>
      </style>
      <size maxheight='1400' maxwidth='1200' minheight='1400' minwidth='1200' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='user_profiles_dashboard (cl_dmart)' name='federated.1o114nf16bvii41d98hwn0iy5j1s' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column alias='ABV' caption='Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;ABV&quot;'>
          <calculation class='tableau' formula='&quot;ABV&quot;' />
          <aliases>
            <alias key='&quot;ABV&quot;' value='ABV' />
            <alias key='&quot;Discount sum&quot;' value='Avg Discount Orders' />
            <alias key='&quot;Qty ordered&quot;' value='Avg. quantity ordered' />
            <alias key='&quot;Voucher sum&quot;' value='Avg Voucher Orders' />
          </aliases>
          <members>
            <member alias='Avg Discount Orders' value='&quot;Discount sum&quot;' />
            <member alias='ABV' value='&quot;ABV&quot;' />
            <member value='&quot;Order count&quot;' />
            <member alias='Avg. quantity ordered' value='&quot;Qty ordered&quot;' />
            <member alias='Avg Voucher Orders' value='&quot;Voucher sum&quot;' />
            <member value='&quot;Unique Customers&quot;' />
          </members>
        </column>
        <column caption='Timeframe' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Lifetime&quot;'>
          <calculation class='tableau' formula='&quot;Lifetime&quot;' />
          <members>
            <member value='&quot;Lifetime&quot;' />
            <member value='&quot;Last year&quot;' />
            <member value='&quot;16 weeks&quot;' />
            <member value='&quot;4 weeks&quot;' />
            <member value='&quot;1 week&quot;' />
          </members>
        </column>
        <column caption='Verticals' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dmart&quot;'>
          <calculation class='tableau' formula='&quot;Dmart&quot;' />
          <members>
