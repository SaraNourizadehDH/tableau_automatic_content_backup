            <column caption='Timeframe GBV (total)' datatype='real' name='[Timeframe ABV (copy)_3032259563490349061]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 4]=&apos;Quick Commerce&apos;&#10;THEN (IF&#10;[Parameters].[Parameter 2]=&apos;1 week&apos; then SUM([Darkstores Last16W ABV (copy)_355291800574263301]+ [Darkstores Last1W ABV (copy)_355291800585158705])&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;4 weeks&apos; then SUM([Darkstores Last16W ABV (copy) (copy 2)_355291800574312456]+ [Darkstores Last4W ABV (copy)_355291800585158703])&#10;&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;16 weeks&apos; then SUM([Calculation_355291800552972289]+ [Darkstores Last16W ABV (copy)_355291800585158701])&#10;&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Last year&apos; then SUM([Darkstores Last16W ABV (copy) (copy 2) (copy)_355291800574345225]+ [Darkstores Lastyear ABV  (copy)_355291800585158702])&#10;&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Lifetime&apos; then SUM([Darkstores Last16W ABV (copy) (copy 3)_355291800574345228]+[Darkstores Lifetime  ABV (copy)_355291800585158704])&#10;END)&#10;&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Dmart&apos;&#10;  THEN  (IF  &#10;[Parameters].[Parameter 2]=&apos;1 week&apos; then SUM([Darkstores Last16W ABV (copy)_355291800574263301])&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;4 weeks&apos; then SUM([Darkstores Last16W ABV (copy) (copy 2)_355291800574312456])&#10;&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;16 weeks&apos; then SUM([Calculation_355291800552972289])&#10;&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Last year&apos; then SUM([Darkstores Last16W ABV (copy) (copy 2) (copy)_355291800574345225])&#10;&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Lifetime&apos; then SUM([Darkstores Last16W ABV (copy) (copy 3)_355291800574345228])&#10;END)&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Localstores&apos;&#10;THEN (IF&#10;[Parameters].[Parameter 2]=&apos;1 week&apos; then SUM([Darkstores Last1W ABV (copy)_355291800585158705])&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;4 weeks&apos; then SUM( [Darkstores Last4W ABV (copy)_355291800585158703])&#10;&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;16 weeks&apos; then SUM( [Darkstores Last16W ABV (copy)_355291800585158701])&#10;&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Last year&apos; then SUM([Darkstores Lastyear ABV  (copy)_355291800585158702])&#10;&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Lifetime&apos; then SUM([Darkstores Lifetime  ABV (copy)_355291800585158704])&#10;END)&#10;&#10;&#10;END' />
            </column>
