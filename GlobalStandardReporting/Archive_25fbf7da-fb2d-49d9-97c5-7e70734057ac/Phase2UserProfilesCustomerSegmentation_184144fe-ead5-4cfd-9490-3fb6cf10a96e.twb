            </column>
            <column caption='Darkstores Lifetime Order Counts' datatype='real' name='[Darkstores Last16W Order Counts (copy)_355291800576163854]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [analytical_customer_id] : AVG([darkstores_lifetime_order_count])}' />
            </column>
            <column caption='Localstores Last16W Order Counts' datatype='real' name='[Darkstores Last16W Order Counts (copy)_355291800594341941]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [analytical_customer_id] : AVG([localstores_last16w_order_count])}' />
