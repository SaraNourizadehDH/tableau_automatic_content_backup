      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='9'>Count of customers</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='user_profiles_dashboard (cl_dmart)' name='federated.1o114nf16bvii41d98hwn0iy5j1s' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Timeframe' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Lifetime&quot;'>
              <calculation class='tableau' formula='&quot;Lifetime&quot;' />
            </column>
            <column caption='Verticals' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dmart&quot;'>
              <calculation class='tableau' formula='&quot;Dmart&quot;' />
            </column>
            <column caption='First Segment' datatype='string' name='[Segment for Graph 1 (copy)_6798676243794608152]' param-domain-type='list' role='measure' type='nominal' value='&quot;Fresh Shoppers&quot;'>
              <calculation class='tableau' formula='&quot;Fresh Shoppers&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o114nf16bvii41d98hwn0iy5j1s'>
            <column caption='Timeframe Customer count' datatype='string' name='[Calculation_1422856010755297281]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 4]=&apos;Quick Commerce&apos;&#10;THEN (IF&#10;[Parameters].[Parameter 2]=&apos;1 week&apos; AND&#10;  (([Darkstores Last16W ABV (copy) (copy) (copy 2)_355291800574345227]&gt;0 OR [Darkstores Last1W Order Counts (copy)_355291800594341938]&gt;0))  &#10;THEN [analytical_customer_id]&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;4 weeks&apos; AND &#10;(([Darkstores Last16W ABV (copy) (copy) (copy)_355291800574312455]&gt;0 OR [Darkstores Last4W Order Counts (copy)_355291800594341940]&gt;0))&#10;THEN [analytical_customer_id]&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;16 weeks&apos; AND&#10; (([Darkstores Last16W ABV (copy) (copy)_355291800574275590]&gt;0 OR [Darkstores Last16W Order Counts (copy)_355291800594341941]&gt;0))&#10;THEN [analytical_customer_id]&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Last year&apos; AND&#10; (([Darkstores Last16W ABV (copy) (copy) (copy) (copy)_355291800574345226]&gt;0 OR [Darkstores Lastyear Order Counts (copy)_355291800594341939]&gt;0) )&#10;THEN [analytical_customer_id]&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Lifetime&apos; AND&#10; (([Darkstores Last16W Order Counts (copy)_355291800576163854]&gt;0 OR [Darkstores Lifetime Order Counts (copy)_355291800594341942]&gt;0) )&#10;THEN [analytical_customer_id]&#10;END)&#10;ELSEIF &#10;[Parameters].[Parameter 4]=&apos;Dmart&apos;&#10;THEN (IF&#10;[Parameters].[Parameter 2]=&apos;1 week&apos; AND&#10;  (([Darkstores Last16W ABV (copy) (copy) (copy 2)_355291800574345227]&gt;0 ))  &#10;THEN [analytical_customer_id]&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;4 weeks&apos; AND &#10;(([Darkstores Last16W ABV (copy) (copy) (copy)_355291800574312455]&gt;0 ))&#10;THEN [analytical_customer_id]&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;16 weeks&apos; AND&#10; (([Darkstores Last16W ABV (copy) (copy)_355291800574275590]&gt;0 ))&#10;THEN [analytical_customer_id]&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Last year&apos; AND&#10; (([Darkstores Last16W ABV (copy) (copy) (copy) (copy)_355291800574345226]&gt;0 ) )&#10;THEN [analytical_customer_id]&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Lifetime&apos; AND&#10; (([Darkstores Last16W Order Counts (copy)_355291800576163854]&gt;0 ) )&#10;THEN [analytical_customer_id]&#10;END)&#10;&#10;ELSEIF &#10;[Parameters].[Parameter 4]=&apos;Localstores&apos;&#10;THEN (IF&#10;[Parameters].[Parameter 2]=&apos;1 week&apos; AND&#10;  (( [Darkstores Last1W Order Counts (copy)_355291800594341938]&gt;0))  &#10;THEN [analytical_customer_id]&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;4 weeks&apos; AND &#10;(([Darkstores Last4W Order Counts (copy)_355291800594341940]&gt;0))&#10;THEN [analytical_customer_id]&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;16 weeks&apos; AND&#10; (([Darkstores Last16W Order Counts (copy)_355291800594341941]&gt;0))&#10;THEN [analytical_customer_id]&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Last year&apos; AND&#10; (([Darkstores Lastyear Order Counts (copy)_355291800594341939]&gt;0) )&#10;THEN [analytical_customer_id]&#10;ELSEIF &#10;[Parameters].[Parameter 2]=&apos;Lifetime&apos; AND&#10; (( [Darkstores Lifetime Order Counts (copy)_355291800594341942]&gt;0) )&#10;THEN [analytical_customer_id]&#10;END)&#10; END' />
            </column>
            <column caption='Brand Name' datatype='string' name='[Calculation_1603281489887059968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;REGEXP_MATCH([global_entity_id], &apos;FP&apos;) THEN &apos;Foodpanda&apos; &#10;ELSEIF &#10;REGEXP_MATCH([global_entity_id], &apos;NP&apos;) THEN &apos;Foodpanda&apos;&#10;&#10;ELSEIF&#10;REGEXP_MATCH([global_entity_id], &apos;TB&apos;) THEN &apos;Talabat&apos; &#10;ELSEIF &#10;REGEXP_MATCH([global_entity_id],&apos;HF&apos;) THEN &apos;Talabat&apos;&#10;&#10;ELSEIF&#10;REGEXP_MATCH([global_entity_id], &apos;PY&apos;) THEN &apos;Peya&apos;&#10;&#10;ELSEIF&#10;REGEXP_MATCH([global_entity_id], &apos;HS&apos;) THEN &apos;Hungerstation&apos;&#10;ELSEIF&#10;REGEXP_MATCH([global_entity_id],&apos;DJ&apos;) THEN &apos;Damejidlo&apos;&#10;ELSEIF &#10;REGEXP_MATCH([global_entity_id],&apos;EF&apos;) THEN &apos;eFood&apos;&#10;ELSEIF &#10;REGEXP_MATCH([global_entity_id],&apos;MJM&apos;) THEN &apos;Mjam&apos;&#10;ELSEIF&#10;REGEXP_MATCH([global_entity_id],&apos;FO&apos;) THEN &apos;Foodora&apos;&#10;ELSEIF &#10;REGEXP_MATCH([global_entity_id],&apos;OP&apos;) THEN &apos;Foodora&apos;&#10;ELSEIF &#10;REGEXP_MATCH([global_entity_id],&apos;PO&apos;) THEN &apos;Foodora&apos;&#10;ELSEIF &#10;REGEXP_MATCH([global_entity_id],&apos;YS&apos;) THEN &apos;Yemekspeti&apos;&#10;ELSEIF &#10;REGEXP_MATCH([global_entity_id],&apos;FY&apos;) THEN &apos;Foody&apos;&#10;ELSEIF &#10;REGEXP_MATCH([global_entity_id],&apos;AP&apos;) THEN &apos;Appetito24&apos;&#10;ELSE &#10;[global_entity_id]&#10; END' />
            </column>
            <column caption='First Segment' datatype='string' name='[Calculation_3979774717593001985]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152]= &apos;Focused Snackers&apos; then [profile_focused_snackers]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Fresh Shoppers&apos; then [profile_fresh_shoppers]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152]=  &apos;Home Personal Shoppers&apos; then [profile_home_personal_shoppers]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Night Time Drinkers&apos; then [profile_night_time_drinkers]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152]= &apos;Breakfast Shoppers&apos; then [profile_breakfast_shoppers]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Grocery Loyalist&apos; then [profile_grocery_loyalists]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152]=  &apos;Ready to Consume Lunchers&apos; then [profile_ready_to_consume_lunchers]&#10;ELSEIF &#10;[Parameters].[Segment for Graph 1 (copy)_6798676243794608152] =  &apos;Voucher Seekers&apos; then [profile_voucher_seekers]&#10;&#10;END' />
            </column>
            <column caption='Darkstores Last1W Order Counts' datatype='real' name='[Darkstores Last16W ABV (copy) (copy) (copy 2)_355291800574345227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [analytical_customer_id] : AVG([darkstores_last1w_order_count])}' />
