              <calculation class='tableau' formula='IF &#10;[Parameters].[Parameter 4]=&apos;Quick Commerce&apos;&#10;THEN (IF&#10;&#10;  (([Darkstores Last16W ABV (copy) (copy)_355291800574275590]&gt;0 OR [Darkstores Last16W Order Counts (copy)_355291800594341941]&gt;0))  &#10;THEN [analytical_customer_id]&#10;END)&#10;ELSEIF &#10;&#10;&#10;[Parameters].[Parameter 4]=&apos;Dmart&apos;&#10;THEN (IF&#10;&#10;  (([Darkstores Last16W ABV (copy) (copy)_355291800574275590]&gt;0 ))  &#10;THEN [analytical_customer_id]&#10;END)&#10;&#10;ELSEIF &#10;[Parameters].[Parameter 4]=&apos;Localstores&apos;&#10;THEN (IF&#10;&#10;  (( [Darkstores Last16W Order Counts (copy)_355291800594341941]&gt;0))  &#10;THEN [analytical_customer_id]&#10;END)&#10; END' />
