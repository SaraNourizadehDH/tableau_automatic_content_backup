      <aliases enabled='yes' />
      <column caption='90d Reorder Rate' datatype='real' default-format='p0.0%' name='[90d Reorder Rate (copy)_120612032967626758]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_120612032966455300] THEN [reorder_rate_90d] * [users_all] END)&#10;/&#10;SUM(IF [Calculation_120612032966455300] THEN [users_all] END)' />
      </column>
      <column caption='30d Reorder Rate' datatype='real' default-format='p0.0%' name='[90d Reorder Rate (copy)_120612032968175623]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [More than 90d ago (copy)_120612032966672389] THEN [reorder_rate_30d] * [users_all] END)&#10;/&#10;SUM(IF [More than 90d ago (copy)_120612032966672389] THEN [users_all] END)' />
      </column>
      <column caption='Affordable Rest' datatype='boolean' name='[Calculation_120612032961347585]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [affordability_index] &lt; [Parameters].[Parameter 1] THEN TRUE&#10;ELSEIF [affordability_index] &gt;= [Parameters].[Parameter 1] THEN FALSE&#10;END' />
      </column>
      <column caption='More than 90d ago' datatype='boolean' name='[Calculation_120612032966455300]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [report_date], [last_refreshed_on]) &gt; 90' />
      </column>
      <column caption='Group' datatype='string' name='[Calculation_1234197409323274240]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(&#10;    IF [Calculation_120612032961347585] = TRUE THEN &apos;Aff&apos;&#10;    ELSEIF [Calculation_120612032961347585] = FALSE THEN &apos;Non-Aff&apos; END&#10;)&#10;+&#10;&apos; &apos;&#10;+&#10;STR(IF [is_key_account] THEN &apos;KA&apos; ELSE &apos;Non-KA&apos; END)' />
      </column>
      <column caption='Rests' datatype='integer' name='[Calculation_1234197409332645889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([dwh_source_code] + [restaurant_id])' />
      </column>
      <column caption='More than 30d ago' datatype='boolean' name='[More than 90d ago (copy)_120612032966672389]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [report_date], [last_refreshed_on]) &gt; 30' />
      </column>
