    <worksheet name='Avg time spent on Sales Cockpit per Session User Level'>
      <table>
        <view>
          <datasources>
            <datasource caption='sales_cockpit_v6 (sales_reports)' name='federated.14gh92q1p9u8qb1fet15o1pwha5d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Period Parameter UI' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.14gh92q1p9u8qb1fet15o1pwha5d'>
            <column caption='Avg time per Session (Mins)' datatype='real' name='[Avg time per Session (copy)_2775343315140665346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Duration (copy)_2775343315140304896])/[Calculation_3698933082805354500]' />
            </column>
            <column caption='Day' datatype='datetime' name='[Calculation_1868079096125722625]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;,[iso_date])' />
            </column>
            <column caption='Week' datatype='datetime' name='[Calculation_1868079096125771778]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;,[iso_date])' />
            </column>
            <column caption='Month' datatype='datetime' name='[Calculation_1868079096125820931]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[iso_date])' />
            </column>
            <column caption='% Users Logging against Users with Sales Cockpit Access' datatype='real' name='[Calculation_1868079096130236421]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_3698933082806816775]/[Calculation_3698933082805858309]) THEN 0&#10;ELSE [Calculation_3698933082806816775]/[Calculation_3698933082805858309]&#10;END' />
            </column>
            <column caption='Sessions' datatype='integer' name='[Calculation_3698933082805354500]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([session_key])' />
            </column>
            <column caption='Active Users with Sales Cockpit Access ' datatype='integer' name='[Calculation_3698933082805858309]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [permission_set] = TRUE THEN id END)' />
            </column>
            <column caption='Active Users With Logins' datatype='integer' name='[Calculation_3698933082806816775]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL(COUNTD(IF NOT ISNULL([login_key]) THEN id END)) THEN 0&#10;ELSE COUNTD(IF NOT ISNULL([login_key]) THEN id END)&#10;END' />
            </column>
            <column caption='Duration (Mins)' datatype='real' name='[Duration (copy)_2775343315140304896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[duration]/60000' />
            </column>
            <column caption='Period ' datatype='date' name='[Period (copy)_1868079096126193668]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=&quot;Day&quot; THEN DATE([Calculation_1868079096125722625])&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Week&quot; THEN DATE([Calculation_1868079096125771778])&#10;ELSEIF [Parameters].[Parameter 1]=&quot;Month&quot; THEN DATE([Calculation_1868079096125820931])&#10;END' />
            </column>
            <column caption='Year' datatype='datetime' name='[Week (copy)_5840253969541382147]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;year&apos;,[iso_date])' />
            </column>
