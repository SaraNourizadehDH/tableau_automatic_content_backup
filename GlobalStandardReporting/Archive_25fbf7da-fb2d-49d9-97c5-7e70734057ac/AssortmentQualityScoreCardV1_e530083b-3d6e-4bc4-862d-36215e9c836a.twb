            <column caption='Ultrafresh GPV % contr.' datatype='real' name='[Calculation_1185854145189216256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[ultrafresh_gbv]/ [gbv]' />
            </column>
            <column caption='Frequency' datatype='real' name='[Calculation_1185854145204133891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_orders]/[unique_users]' />
