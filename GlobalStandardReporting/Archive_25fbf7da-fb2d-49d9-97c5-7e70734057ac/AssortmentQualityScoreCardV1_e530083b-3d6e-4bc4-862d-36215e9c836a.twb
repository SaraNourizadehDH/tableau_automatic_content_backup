        <calculation class='tableau' formula='(SUM(IF DATETRUNC(&apos;month&apos;,[date_month]) = [Parameters].[X Axis (copy)] &#13;&#10;THEN [check_efficiency] END)&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;SUM(IF DATETRUNC(&apos;month&apos;,[date_month]) = DATEADD(&apos;month&apos;,-1,[Parameters].[X Axis (copy)]) &#13;&#10;THEN [check_efficiency] END))' />
