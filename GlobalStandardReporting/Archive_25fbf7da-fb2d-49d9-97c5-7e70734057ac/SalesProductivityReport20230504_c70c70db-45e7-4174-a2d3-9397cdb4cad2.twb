            <column-instance column='[Calculation_6318268863187902467]' derivation='User' name='[pcto:usr:Calculation_6318268863187902467:qk:2]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
            </column-instance>
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Sf Created Date' datatype='date' name='[sf_created_date]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='Sf User Total Acquisition Bucket' datatype='integer' name='[sf_user_total_acquisition_bucket]' role='dimension' type='ordinal' />
            <column caption='Sub Entity' datatype='string' name='[sub_entity]' role='dimension' type='nominal' />
            <column caption='Tim Month First Day' datatype='date' name='[tim_month_first_day]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_6318268863187206146]' derivation='User' name='[usr:Calculation_6318268863187206146:qk]' pivot='key' type='quantitative' />
