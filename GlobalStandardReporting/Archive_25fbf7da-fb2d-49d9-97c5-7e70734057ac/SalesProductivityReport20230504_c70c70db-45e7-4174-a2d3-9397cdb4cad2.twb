            <column-instance column='[General Bar Chart Filter 1 (copy)_4581779302868414465]' derivation='None' name='[none:General Bar Chart Filter 1 (copy)_4581779302868414465:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Role Type - Final (copy)_4055913677581959172]' derivation='None' name='[none:Role Type - Final (copy)_4055913677581959172:nk]' pivot='key' type='nominal' />
