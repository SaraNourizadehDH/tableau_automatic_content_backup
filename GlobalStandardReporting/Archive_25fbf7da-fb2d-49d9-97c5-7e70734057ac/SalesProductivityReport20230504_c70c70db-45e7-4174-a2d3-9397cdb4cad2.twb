          </datasource-dependencies>
          <filter class='relative-date' column='[federated.1dphh8i0jfrnjt10om4fi0ypt45f].[none:Calculation_2324631524154900483:qk]' filter-group='6' first-period='-9' include-future='true' include-null='false' last-period='0' period-type-v2='month' />
