    <worksheet name='General - Users Bar 2'>
      <table>
        <view>
          <datasources>
            <datasource caption='dm_sales_productivity_detail+ (sales_reports) (2)' name='federated.1dphh8i0jfrnjt10om4fi0ypt45f' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Mapping Source' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;SalesForce&quot;'>
              <calculation class='tableau' formula='&quot;SalesForce&quot;' />
            </column>
            <column caption='General - Split by' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;ROLE MODE&quot;'>
              <calculation class='tableau' formula='&quot;ROLE MODE&quot;' />
            </column>
            <column caption='Chart Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Stacked Bar - 100\%&quot;'>
              <calculation class='tableau' formula='&quot;Stacked Bar - 100%&quot;' />
            </column>
            <column caption='User - W or WO Sales ' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;ALL&quot;'>
              <calculation class='tableau' formula='&quot;ALL&quot;' />
            </column>
            <column caption='Mapping Type' datatype='string' name='[Parámetro 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Food - Hybrid - Shop - NonSeller&quot;'>
              <calculation class='tableau' formula='&quot;Food - Hybrid - Shop - NonSeller&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1dphh8i0jfrnjt10om4fi0ypt45f'>
            <column caption='TIM_DAY' datatype='date' name='[Calculation_2324631524154900483]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[tim_month_first_day]' />
            </column>
            <column caption='Sellers QTY' datatype='integer' name='[Calculation_2324631524158337028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([id])' />
            </column>
            <column caption='Dimension - Split by' datatype='string' name='[Calculation_2324631524161228805]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;REGION&apos; THEN [region]&#10;WHEN &apos;ROLE TYPE&apos; THEN [Calculation_2324631524161372166]&#10;WHEN &apos;ROLE MODE&apos; THEN [Role Type - Final (copy)_4055913677581959172]&#10;WHEN &apos;SF USER AGING&apos; THEN [Calculation_4134867473331650561]&#10;WHEN &apos;ACQUISITION VERTICAL&apos; THEN [vertical__c]&#10;WHEN &apos;ACQUISITION TYPE&apos; THEN [business_type__c]&#10;WHEN &apos;ACQUISITION BUCKETS&apos; THEN [Calculation_4134867473357635586]&#10;END' />
            </column>
            <column caption='Role Type - Final' datatype='string' name='[Calculation_2324631524161372166]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;SalesForce&apos; THEN [Role Type - Manual (copy)_2324631524153987074]&#10;END' />
            </column>
            <column caption='SF user age buckets' datatype='string' name='[Calculation_4134867473331650561]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([sf_created_date]) THEN &apos;Not Defined&apos;&#10;ELSEIF [TIM_DAY (copy)_903956955318996992] - [sf_created_date] &lt;= 30  THEN &apos;1 Month&apos;&#10;ELSEIF [TIM_DAY (copy)_903956955318996992] - [sf_created_date] &lt;= 90  THEN &apos;2-3 Months&apos;&#10;ELSEIF [TIM_DAY (copy)_903956955318996992] - [sf_created_date] &lt;= 180 THEN &apos;4-6 Months&apos;&#10;ELSE &apos;7+ Months&apos;&#10;END' />
            </column>
            <column caption='Sf User Total Acquisition Bucket Groups' datatype='string' name='[Calculation_4134867473357635586]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF      [sf_user_total_acquisition_bucket]  =  0 THEN &apos;0&apos;&#10;ELSEIF  [sf_user_total_acquisition_bucket] &lt;= 10 THEN &apos;1-10&apos;&#10;ELSEIF  [sf_user_total_acquisition_bucket] &lt;= 20 THEN &apos;11-20&apos;&#10;ELSEIF  [sf_user_total_acquisition_bucket] &lt;= 30 THEN &apos;21-30&apos;&#10;ELSE &apos;31+&apos;&#10;END' />
            </column>
            <column caption='SF Users' datatype='integer' name='[Calculation_6318268863187206146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;ALL&apos; THEN [Calculation_2324631524158337028]&#10;WHEN &apos;WITH ACQUISITIONS&apos; THEN [Sellers QTY (copy)_6318268863181123584]&#10;WHEN &apos;WITHOUT ACQUISITIONS&apos; THEN [Sellers (with Acq.) QTY (copy)_6318268863186010113]&#10;END' />
            </column>
            <column aggregation='Sum' caption='General Bar Chart Filter 2' datatype='integer' name='[General Bar Chart Filter 1 (copy)_2324631524206522377]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Stacked Bar&apos; THEN 1 ELSE 0 END' />
            </column>
            <column caption='Role Mode - SF' datatype='string' name='[Role Mode - Manual (copy)_4055913677581705219]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF      [central_job_role_sf] IN  ( &apos;Field Sales Representatives (Restaurant)&apos;,&#10;                                    &apos;Field Sales Representatives (Restaurant &amp; Shop)&apos;,&#10;                                    &apos;Field Sales Representatives (Shop)&apos;,&#10;                                    &apos;Field Sales Representative&apos;)&#10;                                    THEN &apos;Field Sales&apos;&#10;ELSEIF  [central_job_role_sf] IN  ( &apos;Tele Sales Representatives (Restaurant)&apos;,&#10;                                    &apos;Tele Sales Representatives (Restaurant &amp; Shop)&apos;,&#10;                                    &apos;Tele Sales Representatives (Shop)&apos;,&#10;                                    &apos;Telesales Representative&apos;) &#10;                                    THEN &apos;Tele Sales&apos;&#10;ELSE &apos;Non-Sellers&apos; &#10;END' />
            </column>
            <column caption='Role Mode - Final' datatype='string' name='[Role Type - Final (copy)_4055913677581959172]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;SalesForce&apos; THEN [Role Mode - Manual (copy)_4055913677581705219]&#10;END' />
            </column>
            <column caption='Role Type - SF' datatype='string' name='[Role Type - Manual (copy)_2324631524153987074]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#10;WHEN &apos;Seller - NonSeller&apos; THEN &#10;        IF      [central_job_role_sf] IN ( &apos;Field Sales Representatives (Restaurant)&apos;,&apos;Tele Sales Representatives (Restaurant)&apos;) THEN &apos;Seller&apos;&#10;        ELSEIF  [central_job_role_sf] IN ( &apos;Field Sales Representatives (Restaurant &amp; Shop)&apos;,&apos;Tele Sales Representatives (Restaurant &amp; Shop)&apos;) THEN &apos;Seller&apos;&#10;        ELSEIF  [central_job_role_sf] IN ( &apos;Field Sales Representatives (Shop)&apos;,&apos;Tele Sales Representatives (Shop)&apos;) THEN &apos;Seller&apos;&#10;        ELSEIF  [central_job_role_sf] IN ( &apos;Field Sales Representative&apos;,&apos;Telesales Representative&apos;) THEN &apos;Seller&apos;&#10;        ELSE &apos;Non-Sellers&apos; &#10;        END&#10;WHEN &apos;Food - Shop - NonSeller&apos; THEN &#10;        IF      [central_job_role_sf] IN ( &apos;Field Sales Representatives (Restaurant)&apos;,&apos;Tele Sales Representatives (Restaurant)&apos;) THEN &apos;Food&apos;&#10;        ELSEIF  [central_job_role_sf] IN ( &apos;Field Sales Representatives (Restaurant &amp; Shop)&apos;,&apos;Tele Sales Representatives (Restaurant &amp; Shop)&apos;,&#10;                                            &apos;Field Sales Representative&apos;,&apos;Telesales Representative&apos;) THEN &apos;Food&apos;&#10;        ELSEIF  [central_job_role_sf] IN ( &apos;Field Sales Representatives (Shop)&apos;,&apos;Tele Sales Representatives (Shop)&apos;) THEN &apos;Shop&apos;&#10;        ELSE &apos;Non-Sellers&apos; &#10;        END&#10;WHEN &apos;Food - Hybrid - Shop - NonSeller&apos; THEN &#10;        IF      [central_job_role_sf] IN ( &apos;Field Sales Representatives (Restaurant)&apos;,&apos;Tele Sales Representatives (Restaurant)&apos;,&#10;                                            &apos;Field Sales Representative&apos;,&apos;Telesales Representative&apos;) THEN &apos;Food&apos;&#10;        ELSEIF  [central_job_role_sf] IN ( &apos;Field Sales Representatives (Restaurant &amp; Shop)&apos;,&apos;Tele Sales Representatives (Restaurant &amp; Shop)&apos;) THEN &apos;Hybrid&apos;&#10;        ELSEIF  [central_job_role_sf] IN ( &apos;Field Sales Representatives (Shop)&apos;,&apos;Tele Sales Representatives (Shop)&apos;) THEN &apos;Shop&apos;&#10;        ELSE &apos;Non-Sellers&apos; &#10;        END&#10;WHEN &apos;Central Job Role&apos; THEN [central_job_role_sf]&#10;END' />
            </column>
            <column caption='Sellers (without Acq.) QTY' datatype='integer' name='[Sellers (with Acq.) QTY (copy)_6318268863186010113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF IFNULL([sf_user_total_acquisition_bucket],0)=0 THEN [id] END)' />
            </column>
            <column caption='Sellers (with Acq.) QTY' datatype='integer' name='[Sellers QTY (copy)_6318268863181123584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [sf_user_total_acquisition_bucket]&gt;0 THEN [id] END)' />
            </column>
            <column caption='TIM_DAY - Last day of Month' datatype='date' name='[TIM_DAY (copy)_903956955318996992]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE( DATEADD(&apos;day&apos;,-1, DATEADD(&apos;month&apos;,1, DATETRUNC(&apos;month&apos;,[tim_month_first_day]) ) ) )' />
            </column>
            <column caption='Business_Type__C' datatype='string' name='[business_type__c]' role='dimension' type='nominal' />
            <column caption='Central Job Role Sf' datatype='string' name='[central_job_role_sf]' role='dimension' type='nominal' />
