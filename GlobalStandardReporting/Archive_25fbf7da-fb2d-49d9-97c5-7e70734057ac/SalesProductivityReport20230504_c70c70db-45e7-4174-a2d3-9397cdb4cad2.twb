          <filter class='categorical' column='[federated.1dphh8i0jfrnjt10om4fi0ypt45f].[none:job_role_scope__c:nk]' filter-group='26'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:job_role_scope__c:nk]' member='%null%' />
