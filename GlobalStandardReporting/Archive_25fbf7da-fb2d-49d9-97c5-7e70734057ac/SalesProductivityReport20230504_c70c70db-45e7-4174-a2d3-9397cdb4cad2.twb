            <column-instance column='[Calculation_4134867473357635586]' derivation='None' name='[none:Calculation_4134867473357635586:nk]' pivot='key' type='nominal' />
            <column-instance column='[General Bar Chart Filter 1 (copy)_4581779302868414465]' derivation='None' name='[none:General Bar Chart Filter 1 (copy)_4581779302868414465:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Role Type - Final (copy)_4055913677581959172]' derivation='None' name='[none:Role Type - Final (copy)_4055913677581959172:nk]' pivot='key' type='nominal' />
            <column-instance column='[business_type__c]' derivation='None' name='[none:business_type__c:nk]' pivot='key' type='nominal' />
            <column-instance column='[isactive]' derivation='None' name='[none:isactive:nk]' pivot='key' type='nominal' />
            <column-instance column='[job_role_scope__c]' derivation='None' name='[none:job_role_scope__c:nk]' pivot='key' type='nominal' />
