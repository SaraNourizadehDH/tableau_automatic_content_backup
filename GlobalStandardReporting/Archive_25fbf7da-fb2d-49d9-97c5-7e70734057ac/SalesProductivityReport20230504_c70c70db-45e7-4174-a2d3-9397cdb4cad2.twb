            <column caption='Sf Created Date' datatype='date' name='[sf_created_date]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='Sf User Total Acquisition Bucket' datatype='integer' name='[sf_user_total_acquisition_bucket]' role='dimension' type='ordinal' />
            <column caption='Sub Entity' datatype='string' name='[sub_entity]' role='dimension' type='nominal' />
