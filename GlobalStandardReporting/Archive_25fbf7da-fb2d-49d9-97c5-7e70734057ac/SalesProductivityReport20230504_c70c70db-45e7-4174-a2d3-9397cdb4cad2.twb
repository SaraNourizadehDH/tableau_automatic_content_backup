      <aliases enabled='yes' />
      <column caption='Role Type - Manual' datatype='string' name='[Calculation_2324631524153483265]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#10;WHEN &apos;Seller - NonSeller&apos; THEN &#10;        IF      [central_job_role_manual] IN ( &apos;Field Sales Representatives (Restaurant)&apos;,&apos;Tele Sales Representatives (Restaurant)&apos;) THEN &apos;Seller&apos;&#10;        ELSEIF  [central_job_role_manual] IN ( &apos;Field Sales Representatives (Restaurant &amp; Shop)&apos;,&apos;Tele Sales Representatives (Restaurant &amp; Shop)&apos;) THEN &apos;Seller&apos;&#10;        ELSEIF  [central_job_role_manual] IN ( &apos;Field Sales Representatives (Shop)&apos;,&apos;Tele Sales Representatives (Shop)&apos;) THEN &apos;Seller&apos;&#10;        ELSE &apos;Non-Sellers&apos; &#10;        END&#10;WHEN &apos;Food - Shop - NonSeller&apos; THEN &#10;        IF      [central_job_role_manual] IN ( &apos;Field Sales Representatives (Restaurant)&apos;,&apos;Tele Sales Representatives (Restaurant)&apos;) THEN &apos;Food&apos;&#10;        ELSEIF  [central_job_role_manual] IN ( &apos;Field Sales Representatives (Restaurant &amp; Shop)&apos;,&apos;Tele Sales Representatives (Restaurant &amp; Shop)&apos;) THEN &apos;Food&apos;&#10;        ELSEIF  [central_job_role_manual] IN ( &apos;Field Sales Representatives (Shop)&apos;,&apos;Tele Sales Representatives (Shop)&apos;) THEN &apos;Shop&apos;&#10;        ELSE &apos;Non-Sellers&apos; &#10;        END&#10;WHEN &apos;Food - Hybrid - Shop - NonSeller&apos; THEN &#10;        IF      [central_job_role_manual] IN ( &apos;Field Sales Representatives (Restaurant)&apos;,&apos;Tele Sales Representatives (Restaurant)&apos;) THEN &apos;Food&apos;&#10;        ELSEIF  [central_job_role_manual] IN ( &apos;Field Sales Representatives (Restaurant &amp; Shop)&apos;,&apos;Tele Sales Representatives (Restaurant &amp; Shop)&apos;) THEN &apos;Hybrid&apos;&#10;        ELSEIF  [central_job_role_manual] IN ( &apos;Field Sales Representatives (Shop)&apos;,&apos;Tele Sales Representatives (Shop)&apos;) THEN &apos;Shop&apos;&#10;        ELSE &apos;Non-Sellers&apos; &#10;        END&#10;WHEN &apos;Central Job Role&apos; THEN [central_job_role_manual]&#10;END' />
      </column>
      <column caption='TIM_DAY' datatype='date' name='[Calculation_2324631524154900483]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[tim_month_first_day]' />
      </column>
      <column caption='Sellers QTY' datatype='integer' name='[Calculation_2324631524158337028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([id])' />
      </column>
      <column caption='Dimension - Split by' datatype='string' name='[Calculation_2324631524161228805]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;REGION&apos; THEN [region]&#10;WHEN &apos;ROLE TYPE&apos; THEN [Calculation_2324631524161372166]&#10;WHEN &apos;ROLE MODE&apos; THEN [Role Type - Final (copy)_4055913677581959172]&#10;WHEN &apos;SF USER AGING&apos; THEN [Calculation_4134867473331650561]&#10;WHEN &apos;ACQUISITION VERTICAL&apos; THEN [vertical__c]&#10;WHEN &apos;ACQUISITION TYPE&apos; THEN [business_type__c]&#10;WHEN &apos;ACQUISITION BUCKETS&apos; THEN [Calculation_4134867473357635586]&#10;END' />
      </column>
      <column caption='Role Type - Final' datatype='string' name='[Calculation_2324631524161372166]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;SalesForce&apos; THEN [Role Type - Manual (copy)_2324631524153987074]&#10;END' />
      </column>
      <column caption='Vendors 2' datatype='integer' name='[Calculation_2324631524173017095]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[vendors]' />
      </column>
      <column aggregation='Sum' caption='General Bar Chart Filter 1' datatype='integer' name='[Calculation_2324631524205981704]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Line&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Avg productivity L3M' datatype='string' name='[Calculation_2683723168250179584]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[clasification_avg]' />
      </column>
      <column caption='Vendors Aquiered by Food FTES' datatype='integer' name='[Calculation_35325169884930054]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Role Type - Final (copy)_35325169884651525] THEN [vendors] END' />
      </column>
      <column caption='Vendors (Rest) Acquired by Food FTES' datatype='integer' name='[Calculation_35325169890746377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [vertical__c] = &apos;Restaurant&apos; THEN [Calculation_35325169884930054] END' />
      </column>
      <column caption='SF user age buckets' datatype='string' name='[Calculation_4134867473331650561]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([sf_created_date]) THEN &apos;Not Defined&apos;&#10;ELSEIF [TIM_DAY (copy)_903956955318996992] - [sf_created_date] &lt;= 30  THEN &apos;1 Month&apos;&#10;ELSEIF [TIM_DAY (copy)_903956955318996992] - [sf_created_date] &lt;= 90  THEN &apos;2-3 Months&apos;&#10;ELSEIF [TIM_DAY (copy)_903956955318996992] - [sf_created_date] &lt;= 180 THEN &apos;4-6 Months&apos;&#10;ELSE &apos;7+ Months&apos;&#10;END' />
      </column>
      <column caption='Sf User Total Acquisition Bucket Groups' datatype='string' name='[Calculation_4134867473357635586]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF      [sf_user_total_acquisition_bucket]  =  0 THEN &apos;0&apos;&#10;ELSEIF  [sf_user_total_acquisition_bucket] &lt;= 10 THEN &apos;1-10&apos;&#10;ELSEIF  [sf_user_total_acquisition_bucket] &lt;= 20 THEN &apos;11-20&apos;&#10;ELSEIF  [sf_user_total_acquisition_bucket] &lt;= 30 THEN &apos;21-30&apos;&#10;ELSE &apos;31+&apos;&#10;END' />
      </column>
      <column caption='Region 2' datatype='string' name='[Calculation_4581779302867017728]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[region]' />
      </column>
      <column caption='Main KPI' datatype='real' name='[Calculation_6009279713382678528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &apos;ACQUISITION&apos;  THEN SUM([vendors])&#10;WHEN &apos;SF USERS&apos;     THEN [Calculation_6318268863187206146]&#10;WHEN &apos;PRODUCTIVITY&apos; THEN [Calculation_6318268863203221508]&#10;END' />
      </column>
      <column caption='Main KPI 2 - wo productivity' datatype='real' name='[Calculation_6009279713435836418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] == &apos;PRODUCTIVITY&apos; THEN 0 ELSE [Calculation_6009279713382678528] END' />
      </column>
      <column caption='SF Users' datatype='integer' name='[Calculation_6318268863187206146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;ALL&apos; THEN [Calculation_2324631524158337028]&#10;WHEN &apos;WITH ACQUISITIONS&apos; THEN [Sellers QTY (copy)_6318268863181123584]&#10;WHEN &apos;WITHOUT ACQUISITIONS&apos; THEN [Sellers (with Acq.) QTY (copy)_6318268863186010113]&#10;END' />
      </column>
      <column caption='SF Users 2' datatype='integer' name='[Calculation_6318268863187902467]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6318268863187206146]' />
      </column>
      <column caption='RATIO - Acquisition over SF Users' datatype='real' name='[Calculation_6318268863203221508]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendors]) / [Calculation_6318268863187206146]' />
      </column>
      <column caption='SF User Created month first day' datatype='date' name='[Calculation_903956955345944583]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[sf_created_date]))' />
      </column>
      <column aggregation='Sum' caption='General Bar Chart Filter 2' datatype='integer' name='[General Bar Chart Filter 1 (copy)_2324631524206522377]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Stacked Bar&apos; THEN 1 ELSE 0 END' />
      </column>
      <column aggregation='Sum' caption='Summary Chart wo prod Filter' datatype='integer' name='[General Bar Chart Filter 1 (copy)_4581779302868414465]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;PRODUCTIVITY&apos; THEN 1&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Line&apos; THEN 1 &#10;ELSEIF [Parameters].[Parameter 3] = &apos;Stacked Bar&apos; THEN 2 &#10;ELSEIF [Parameters].[Parameter 3] = &apos;Stacked Bar - 100%&apos; THEN 3&#10;ELSE 0 &#10;END' />
      </column>
      <column aggregation='Sum' caption='General Bar Chart Filter 3' datatype='integer' name='[General Bar Chart Filter 2 (copy)_2324631524207144970]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Stacked Bar - 100%&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Main KPI 2 - w productivity' datatype='real' name='[Main KPI wo productivity (copy)_4581779302883172357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6009279713382678528]' />
      </column>
      <column caption='Role Food Flag - SF' datatype='boolean' name='[Role Food Flag - Manual (copy)_35325169884520452]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF      [central_job_role_sf] IN ( &apos;Field Sales Representatives (Restaurant)&apos;,&apos;Tele Sales Representatives (Restaurant)&apos;,&apos;Field Sales Representative&apos;,&apos;Telesales Representative&apos;) THEN TRUE&#10;ELSEIF  [central_job_role_sf] IN ( &apos;Field Sales Representatives (Restaurant &amp; Shop)&apos;,&apos;Tele Sales Representatives (Restaurant &amp; Shop)&apos;) THEN TRUE&#10;ELSEIF  [central_job_role_sf] IN ( &apos;Field Sales Representatives (Shop)&apos;,&apos;Tele Sales Representatives (Shop)&apos;) THEN FALSE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Role Mode - SF' datatype='string' name='[Role Mode - Manual (copy)_4055913677581705219]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF      [central_job_role_sf] IN  ( &apos;Field Sales Representatives (Restaurant)&apos;,&#10;                                    &apos;Field Sales Representatives (Restaurant &amp; Shop)&apos;,&#10;                                    &apos;Field Sales Representatives (Shop)&apos;,&#10;                                    &apos;Field Sales Representative&apos;)&#10;                                    THEN &apos;Field Sales&apos;&#10;ELSEIF  [central_job_role_sf] IN  ( &apos;Tele Sales Representatives (Restaurant)&apos;,&#10;                                    &apos;Tele Sales Representatives (Restaurant &amp; Shop)&apos;,&#10;                                    &apos;Tele Sales Representatives (Shop)&apos;,&#10;                                    &apos;Telesales Representative&apos;) &#10;                                    THEN &apos;Tele Sales&apos;&#10;ELSE &apos;Non-Sellers&apos; &#10;END' />
      </column>
      <column caption='Role Food Flag - Final' datatype='boolean' name='[Role Type - Final (copy)_35325169884651525]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;SalesForce&apos; THEN [Role Food Flag - Manual (copy)_35325169884520452]&#10;END' />
      </column>
      <column caption='Role Mode - Final' datatype='string' name='[Role Type - Final (copy)_4055913677581959172]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;SalesForce&apos; THEN [Role Mode - Manual (copy)_4055913677581705219]&#10;END' />
      </column>
      <column caption='Role Type - SF' datatype='string' name='[Role Type - Manual (copy)_2324631524153987074]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#10;WHEN &apos;Seller - NonSeller&apos; THEN &#10;        IF      [central_job_role_sf] IN ( &apos;Field Sales Representatives (Restaurant)&apos;,&apos;Tele Sales Representatives (Restaurant)&apos;) THEN &apos;Seller&apos;&#10;        ELSEIF  [central_job_role_sf] IN ( &apos;Field Sales Representatives (Restaurant &amp; Shop)&apos;,&apos;Tele Sales Representatives (Restaurant &amp; Shop)&apos;) THEN &apos;Seller&apos;&#10;        ELSEIF  [central_job_role_sf] IN ( &apos;Field Sales Representatives (Shop)&apos;,&apos;Tele Sales Representatives (Shop)&apos;) THEN &apos;Seller&apos;&#10;        ELSEIF  [central_job_role_sf] IN ( &apos;Field Sales Representative&apos;,&apos;Telesales Representative&apos;) THEN &apos;Seller&apos;&#10;        ELSE &apos;Non-Sellers&apos; &#10;        END&#10;WHEN &apos;Food - Shop - NonSeller&apos; THEN &#10;        IF      [central_job_role_sf] IN ( &apos;Field Sales Representatives (Restaurant)&apos;,&apos;Tele Sales Representatives (Restaurant)&apos;) THEN &apos;Food&apos;&#10;        ELSEIF  [central_job_role_sf] IN ( &apos;Field Sales Representatives (Restaurant &amp; Shop)&apos;,&apos;Tele Sales Representatives (Restaurant &amp; Shop)&apos;,&#10;                                            &apos;Field Sales Representative&apos;,&apos;Telesales Representative&apos;) THEN &apos;Food&apos;&#10;        ELSEIF  [central_job_role_sf] IN ( &apos;Field Sales Representatives (Shop)&apos;,&apos;Tele Sales Representatives (Shop)&apos;) THEN &apos;Shop&apos;&#10;        ELSE &apos;Non-Sellers&apos; &#10;        END&#10;WHEN &apos;Food - Hybrid - Shop - NonSeller&apos; THEN &#10;        IF      [central_job_role_sf] IN ( &apos;Field Sales Representatives (Restaurant)&apos;,&apos;Tele Sales Representatives (Restaurant)&apos;,&#10;                                            &apos;Field Sales Representative&apos;,&apos;Telesales Representative&apos;) THEN &apos;Food&apos;&#10;        ELSEIF  [central_job_role_sf] IN ( &apos;Field Sales Representatives (Restaurant &amp; Shop)&apos;,&apos;Tele Sales Representatives (Restaurant &amp; Shop)&apos;) THEN &apos;Hybrid&apos;&#10;        ELSEIF  [central_job_role_sf] IN ( &apos;Field Sales Representatives (Shop)&apos;,&apos;Tele Sales Representatives (Shop)&apos;) THEN &apos;Shop&apos;&#10;        ELSE &apos;Non-Sellers&apos; &#10;        END&#10;WHEN &apos;Central Job Role&apos; THEN [central_job_role_sf]&#10;END' />
      </column>
      <column caption='Role Food Flag - Manual' datatype='boolean' name='[Role Type - Manual (copy)_35325169883856898]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF      [central_job_role_manual] IN ( &apos;Field Sales Representatives (Restaurant)&apos;,&apos;Tele Sales Representatives (Restaurant)&apos;) THEN TRUE&#10;ELSEIF  [central_job_role_manual] IN ( &apos;Field Sales Representatives (Restaurant &amp; Shop)&apos;,&apos;Tele Sales Representatives (Restaurant &amp; Shop)&apos;) THEN TRUE&#10;ELSEIF  [central_job_role_manual] IN ( &apos;Field Sales Representatives (Shop)&apos;,&apos;Tele Sales Representatives (Shop)&apos;) THEN FALSE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Role Mode - Manual' datatype='string' name='[Role Type - Manual (copy)_4055913677580591106]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF      [central_job_role_manual] IN  ( &apos;Field Sales Representatives (Restaurant)&apos;,&#10;                                        &apos;Field Sales Representatives (Restaurant &amp; Shop)&apos;,&#10;                                        &apos;Field Sales Representatives (Shop)&apos;,&apos;Field Sales Representatives&apos;)&#10;                                        THEN &apos;Field Sales&apos;&#10;ELSEIF  [central_job_role_manual] IN  ( &apos;Tele Sales Representatives (Restaurant)&apos;,&#10;                                        &apos;Tele Sales Representatives (Restaurant &amp; Shop)&apos;,&#10;                                        &apos;Tele Sales Representatives (Shop)&apos;,&apos;Tele Sales Representatives&apos;) &#10;                                        THEN &apos;Tele Sales&apos;&#10;ELSE &apos;Non-Sellers&apos; &#10;END' />
      </column>
      <column caption='SF user age buckets - criteria 2' datatype='string' name='[SF user age buckets (copy)_4055913677597335557]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([sf_created_date]) THEN &apos;Not Defined&apos;&#10;ELSEIF [TIM_DAY (copy)_903956955318996992] - [sf_created_date] &lt;= 180 THEN &apos;1-6 Months&apos;&#10;ELSE &apos;7+ Months&apos;&#10;END' />
      </column>
      <column caption='SF user age in months' datatype='integer' name='[SF user age buckets (copy)_903956955346808840]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF ISNULL([sf_created_date]) THEN NULL&#10;ELSE datediff(&apos;month&apos;,[Calculation_903956955345944583],[TIM_DAY (copy)_903956955318996992])&#10;END' />
      </column>
      <column caption='Sellers (without Acq.) QTY' datatype='integer' name='[Sellers (with Acq.) QTY (copy)_6318268863186010113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF IFNULL([sf_user_total_acquisition_bucket],0)=0 THEN [id] END)' />
      </column>
      <column caption='Sellers (with Acq.) QTY' datatype='integer' name='[Sellers QTY (copy)_6318268863181123584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [sf_user_total_acquisition_bucket]&gt;0 THEN [id] END)' />
      </column>
      <column aggregation='Sum' caption='Summary Chart w prod Filter' datatype='integer' name='[Summary Chart wo prod Filter 1 (copy)_4581779302880468996]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF     [Parameters].[Parameter 3] = &apos;Line&apos; THEN 1 &#10;ELSEIF [Parameters].[Parameter 3] = &apos;Stacked Bar&apos; THEN 2 &#10;ELSEIF [Parameters].[Parameter 3] = &apos;Stacked Bar - 100%&apos; THEN 3&#10;ELSE 0 &#10;END' />
      </column>
      <column caption='TIM_DAY - Last day of Month' datatype='date' name='[TIM_DAY (copy)_903956955318996992]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE( DATEADD(&apos;day&apos;,-1, DATEADD(&apos;month&apos;,1, DATETRUNC(&apos;month&apos;,[tim_month_first_day]) ) ) )' />
      </column>
      <column caption='Vendors (Shop) Acquired by Food FTES' datatype='integer' name='[Vendors (Rest) Acquired by Food FTES (copy)_35325169891151882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [vertical__c] = &apos;Shop&apos; THEN [Calculation_35325169884930054] END' />
      </column>
