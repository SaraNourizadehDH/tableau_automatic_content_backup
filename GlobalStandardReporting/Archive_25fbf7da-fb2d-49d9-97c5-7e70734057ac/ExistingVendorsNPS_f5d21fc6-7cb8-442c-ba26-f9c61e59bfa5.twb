          <relation connection='bigquery.112hmy60rb5pfx1dplgyc11t32id' name='Custom SQL Query' type='text'>WITH active_vendors AS (
SELECT
  DATE_TRUNC(report_month, QUARTER) AS report_quarter,
  CASE 
    WHEN management_entity=&apos;HungerStation&apos; THEN &apos;HS_SA&apos; WHEN country_name=&apos;Slovakia&apos; THEN &apos;FP_SK&apos; WHEN country_name=&apos;Finland&apos; THEN &apos;PO_FI&apos;  
    WHEN country_name=&apos;Sweden&apos; THEN &apos;OP_SE&apos; WHEN country_name=&apos;Greece&apos; THEN &apos;EF_GR&apos; 
    ELSE v.global_entity_id END AS global_entity_id,
  CASE segment
    WHEN &apos;Asia&apos; THEN &apos;APAC&apos;
    WHEN &apos;America&apos; THEN &apos;LATAM&apos;
    ELSE segment 
    END AS segment,
  management_entity AS management_entity_group,
  country_name AS country,
  COUNT(DISTINCT CASE WHEN v.is_online AND v.successful_orders &gt;&gt; 0 THEN v.vendor_id END) AS vendors_active
FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.agg_vendor_kpis_monthly` v
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` c
ON v.global_entity_id = c.global_entity_id
WHERE
  management_entity IN (&apos;DH Austria&apos;, &apos;DH CEE&apos;, &apos;DH Greece&apos;, &apos;DH Nordics&apos;, &apos;Foodpanda APAC&apos;, &apos;HungerStation&apos;, &apos;Pedidosya&apos;, &apos;Talabat&apos;, &apos;DH Europe&apos;)
  AND report_month &gt;&gt;= &apos;2021-07-01&apos;
GROUP BY
  1, 2, 3, 4, 5
),
nps AS (
SELECT
    DATE_TRUNC(DATE(recorded_at_utc), QUARTER) AS Quarter,
    CASE 
      WHEN management_entity_group=&apos;HungerStation&apos; THEN &apos;HS_SA&apos; WHEN country=&apos;Slovakia&apos; THEN &apos;FP_SK&apos; WHEN country=&apos;Finland&apos; THEN &apos;PO_FI&apos;  
      WHEN country=&apos;Sweden&apos; THEN &apos;OP_SE&apos; WHEN country=&apos;Greece&apos; THEN &apos;EF_GR&apos; WHEN q_language=&apos;ZH_T&apos; THEN &apos;FP_TW&apos; WHEN q_language=&apos;ZH_T (HK)&apos; THEN &apos;FP_HK&apos; 
      WHEN q_language=&apos;MS&apos; THEN &apos;FP_MY&apos;  WHEN q_language=&apos;MY&apos; THEN &apos;FP_MM&apos; WHEN q_language=&apos;LA&apos; THEN &apos;FP_LA&apos; WHEN q_language=&apos;KM&apos; THEN  &apos;FP_KH&apos; 
      WHEN q_language=&apos;TH&apos; THEN  &apos;FP_TH&apos; WHEN q_language=&apos;BN&apos; THEN &apos;FP_BD&apos;  WHEN q_language=&apos;PK-EN&apos; THEN &apos;FP_PK&apos;
    ELSE global_entity_id END AS global_entity,
    COUNT(DISTINCT CASE WHEN nps_group = &apos;Promoter&apos; THEN response_id END) AS Promoters,
    COUNT(DISTINCT CASE WHEN nps_group = &apos;Passive&apos; THEN response_id END) AS Passives,
    COUNT(DISTINCT CASE WHEN nps_group = &apos;Detractor&apos; THEN response_id END) AS Detractors,
    COUNT(DISTINCT CASE WHEN nps_group IS NOT NULL THEN response_id END) AS Surveys
FROM `fulfillment-dwh-production.rl_sales_revenue.qualtrics_responses_existing_vendor_aggregated` as va
GROUP BY 1, 2
)
SELECT * EXCEPT(report_quarter)
FROM nps AS n
INNER JOIN active_vendors AS a
    ON n.global_entity = a.global_entity_id
    AND Quarter = report_quarter
ORDER BY Quarter, global_entity</relation>
