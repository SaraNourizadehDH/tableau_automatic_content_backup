            <column caption='Promoters' datatype='integer' name='[Calculation_4092224015749894147]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [nps_group]=&apos;Promoter&apos; THEN [response_id] END)' />
