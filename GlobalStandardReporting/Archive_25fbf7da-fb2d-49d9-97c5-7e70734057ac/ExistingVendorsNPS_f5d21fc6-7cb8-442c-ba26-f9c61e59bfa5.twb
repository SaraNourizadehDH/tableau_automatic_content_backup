      <aliases enabled='yes' />
      <column caption='VA %' datatype='real' default-format='p0.0%' name='[% of total calc (copy)_2035064095206387712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;% of region&quot; THEN [Calculation_2035064095210307585]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;% of total&quot; THEN [region percentile (copy)_2035064095213420546]&#10;ELSE NULL END' />
      </column>
      <column caption='User Entitlements' datatype='boolean' name='[Calculation_1015913596766900225]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='VA Label' datatype='real' name='[Calculation_1884052772798586880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Company Level (copy 2)_3732991528128086016] &#10;WHEN &quot;Country&quot; THEN AVG([vendors_active])&#10;WHEN &quot;Segment&quot; THEN AVG([Calculation_2003468529053978625])&#10;WHEN &quot;Management Entity Group&quot; THEN  AVG([Calculation_4881761273224630273])&#10;WHEN &quot;Global&quot; THEN  AVG([LOD Segment (copy)_2003468529055481859])&#10;ELSE NULL END' />
      </column>
      <column caption='Total Sample' datatype='real' hidden='true' name='[Calculation_1884052772808462337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Nps Score Parameter] &#10;WHEN &quot;Month&quot; THEN [LOD Segment (copy)_2003468529055481859]&#10;WHEN &quot;Quarter&quot; THEN [LOD Segment (copy)_2003468529055481859]/4&#10;WHEN &quot;Year&quot; THEN [LOD Segment (copy)_2003468529055481859]/12&#10;ELSE NULL END' />
      </column>
      <column caption='VA Size' datatype='integer' name='[Calculation_2003468529053446144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &quot;Size&quot; THEN [vendors_active]&#10;ELSE NULL END' />
      </column>
      <column caption='LOD Segment' datatype='integer' name='[Calculation_2003468529053978625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [segment], [Quarter]: SUM([vendors_active])}' />
      </column>
      <column caption='VA Segment %' datatype='real' default-format='p0.00%' name='[Calculation_2035064095210307585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE [Parameters].[Company Level (copy 2)_3732991528128086016], [Parameters].[Date Granularity (copy)_966655456019529730]: SUM([vendors_active])/ sum([Calculation_2003468529053978625])}' />
      </column>
      <column caption='Date' datatype='date' default-format='*dd.mm.yyyy' name='[Calculation_2035064095222099972]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)_966655456019529730]&#10;WHEN &apos;Month&apos; THEN [Quarter]&#10;WHEN &apos;Quarter&apos; THEN DATE(DATETRUNC(&apos;quarter&apos;, [Quarter]))&#10;WHEN &apos;Year&apos; THEN DATE(DATETRUNC(&apos;year&apos;, [Quarter]))&#10;ELSE NULL END' />
      </column>
      <column caption='Active Vendors tp' datatype='integer' name='[Calculation_2352286406114684928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Company Level (copy 2)_3732991528128086016] &#10;WHEN &quot;Global&quot; THEN [LOD Segment (copy)_2003468529055481859]&#10;WHEN &quot;Segment&quot; THEN [Calculation_2003468529053978625]&#10;WHEN &quot;Management Entity Group&quot; THEN [Calculation_4881761273224630273]&#10;ELSE NULL END' />
      </column>
      <column caption='W. NPS Contr. Score' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2352286406117974019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE [country], [Quarter]: SUM([Calculation_2035064095210307585] * [Calculation_3498382130845233172])} * 100' />
      </column>
      <column caption='W. NPS Contr. Share' datatype='real' default-format='p0.0%' name='[Calculation_2352286406371827717]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2352286406117974019] / {fixed [segment], [Quarter]: sum([Calculation_2352286406117974019])}' />
      </column>
      <column caption='Company Level' datatype='string' name='[Calculation_3498382130818826248]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Company Level (copy 2)_3732991528128086016] = &apos;Global&apos;                    THEN &apos;Global&apos;&#10;ELSEIF [Parameters].[Company Level (copy 2)_3732991528128086016] = &apos;Segment&apos;               THEN [segment]&#10;ELSEIF [Parameters].[Company Level (copy 2)_3732991528128086016] = &apos;Management Entity Group&apos;     THEN [management_entity_group]&#10;END' />
