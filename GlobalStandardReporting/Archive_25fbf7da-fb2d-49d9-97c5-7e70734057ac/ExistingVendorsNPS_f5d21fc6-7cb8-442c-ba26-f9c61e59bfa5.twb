      <table>
        <view>
          <datasources>
            <datasource caption='qualtrics_responses_existing_vendor_aggregated (rl_sales_revenue)' name='federated.0o3gb6z0oc3a4h1fn3wod1lshxv8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Nps Score Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Quarter&quot;'>
              <calculation class='tableau' formula='&quot;Quarter&quot;' />
            </column>
            <column caption='Company Level' datatype='string' name='[Satisfied Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Global&quot;'>
              <calculation class='tableau' formula='&quot;Global&quot;' />
            </column>
            <column caption='Last N Date' datatype='integer' name='[Vertical Types Parameter]' param-domain-type='range' role='measure' type='quantitative' value='12'>
              <calculation class='tableau' formula='12' />
              <range max='15' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0o3gb6z0oc3a4h1fn3wod1lshxv8'>
            <column caption='Responses' datatype='integer' name='[Calculation_3627790277979058176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([response_id])' />
            </column>
            <column caption='Passives' datatype='integer' name='[Calculation_4092224015749410816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [nps_group]=&apos;Passive&apos; THEN [response_id] END)' />
            </column>
            <column caption='Detractors' datatype='integer' name='[Calculation_4092224015749824514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [nps_group]=&apos;Detractor&apos; THEN [response_id] END)' />
            </column>
            <column caption='Promoters' datatype='integer' name='[Calculation_4092224015749894147]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [nps_group]=&apos;Promoter&apos; THEN [response_id] END)' />
            </column>
            <column caption='Promoters %' datatype='real' name='[Calculation_4092224015750045700]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4092224015749894147]/([Calculation_4092224015749824514]+[Calculation_4092224015749410816]+[Calculation_4092224015749894147])' />
            </column>
            <column caption='Detractors %' datatype='real' name='[Calculation_4092224015750090757]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4092224015749824514]/([Calculation_4092224015749824514]+[Calculation_4092224015749410816]+[Calculation_4092224015749894147])' />
            </column>
            <column caption='NPS' datatype='real' name='[Calculation_4092224015750168582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4092224015750045700] - [Calculation_4092224015750090757]' />
            </column>
            <column caption='Date ' datatype='date' name='[Calculation_5492280524779581440]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Nps Score Parameter] &#10;WHEN &quot;Month&quot; THEN DATE(DATETRUNC(&apos;month&apos;,[recorded_at_utc]))&#10;WHEN &quot;Quarter&quot; THEN DATE(DATETRUNC(&apos;quarter&apos;,[recorded_at_utc]))&#10;WHEN &quot;Year&quot; THEN DATE(DATETRUNC(&apos;year&apos;,[recorded_at_utc])) &#10;END' />
            </column>
            <column caption='Company Level' datatype='string' name='[Calculation_5492280524783206407]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Satisfied Parameter] = &apos;Global&apos;                    THEN &apos;Global&apos;&#10;ELSEIF [Parameters].[Satisfied Parameter] = &apos;Segment&apos;               THEN [segment]&#10;ELSEIF [Parameters].[Satisfied Parameter] = &apos;Management Entity Group&apos;     THEN [management_entity]&#10;ELSEIF [Parameters].[Satisfied Parameter] = &apos;Country&apos;               THEN [country_name]&#10;END' />
            </column>
