      <datasource-dependencies datasource='Parameters'>
        <column caption='Date Granularity' datatype='string' name='[Nps Score Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Quarter&quot;'>
          <calculation class='tableau' formula='&quot;Quarter&quot;' />
        </column>
        <column caption='VA Metrics' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Size&quot;'>
          <calculation class='tableau' formula='&quot;Size&quot;' />
        </column>
        <column caption='Company Level' datatype='string' name='[Satisfied Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Global&quot;'>
          <calculation class='tableau' formula='&quot;Global&quot;' />
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1u07zr4140gc1n1ccxrn90jz5y60'>
        <column caption='VA %' datatype='real' default-format='p0.0%' name='[% of total calc (copy)_2035064095206387712]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;% of region&quot; THEN [Calculation_2035064095210307585]&#10;ELSEIF [Parameters].[Parameter 1] = &quot;% of total&quot; THEN [region percentile (copy)_2035064095213420546]&#10;ELSE NULL END' />
        </column>
        <column caption='LOD Total' datatype='integer' name='[LOD Segment (copy)_2003468529055481859]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='{FIXED [Quarter]: SUM([vendors_active])}' />
        </column>
        <column caption='vendors active' datatype='integer' name='[vendors_active]' role='measure' type='quantitative' />
      </datasource-dependencies>
      <filter class='categorical' column='[Calculation_1145743918852825088]' filter-group='2'>
        <groupfilter function='member' level='[Calculation_1145743918852825088]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
      </filter>
      <filter class='categorical' column='[access_group]' filter-group='2'>
        <groupfilter function='member' level='[access_group]' member='&quot;Sales Benchmarking&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
      </filter>
      <filter class='categorical' column='[q_chl]' filter-group='2'>
        <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
          <groupfilter function='member' level='[q_chl]' member='&quot;email&quot;' />
          <groupfilter function='member' level='[q_chl]' member='&quot;gl&quot;' />
          <groupfilter function='member' level='[q_chl]' member='&quot;si&quot;' />
        </groupfilter>
      </filter>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='qualtrics_responses_existing_vendor_aggregated' id='qualtrics_responses_existing_vendor_aggregated_9241D091CFDE4B0794123F82F6EF4AEE'>
            <properties context=''>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Custom SQL Query1].[global_entity]' />
                    <expression op='[tableau_gsr_entitlements_global_entity_id].[global_entity_id]' />
                  </expression>
                </clause>
                <relation connection='bigquery.0p98dkp1yfp9i51ek6ia41yqua1c' name='Custom SQL Query1' type='text'>with existing_vendors as
(SELECT CASE WHEN management_entity_group=&apos;HungerStation&apos; THEN &apos;HS_SA&apos; WHEN
country=&apos;Slovakia&apos; THEN &apos;FP_SK&apos; WHEN country=&apos;Finland&apos; THEN &apos;PO_FI&apos;  WHEN country=&apos;Sweden&apos; THEN &apos;OP_SE&apos; WHEN country=&apos;Greece&apos; THEN &apos;EF_GR&apos; 
WHEN q_language=&apos;ZH_T&apos; THEN &apos;FP_TW&apos; WHEN q_language=&apos;ZH_T (HK)&apos; THEN &apos;FP_HK&apos; WHEN q_language=&apos;MS&apos; THEN &apos;FP_MY&apos; 
WHEN q_language=&apos;MY&apos; THEN &apos;FP_MM&apos; WHEN q_language=&apos;LA&apos; THEN &apos;FP_LA&apos; WHEN q_language=&apos;KM&apos; THEN  &apos;FP_KH&apos; 
WHEN q_language=&apos;TH&apos; THEN  &apos;FP_TH&apos; WHEN q_language=&apos;BN&apos; THEN &apos;FP_BD&apos;  WHEN q_language=&apos;PK-EN&apos; THEN &apos;FP_PK&apos;
ELSE global_entity_id END as global_entity , CASE WHEN q_chl LIKE &apos;%email%&apos; THEN &apos;Email&apos; WHEN q_chl=&apos;gl&apos; THEN &apos;Personal Link&apos; WHEN q_chl=&apos;si&apos; THEN &apos;Portal&apos; ELSE q_chl END as channel,   * 
FROM `fulfillment-dwh-production.rl_sales_revenue.qualtrics_responses_existing_vendor_aggregated` as va
 )

SELECT ge.country_name,ge.management_entity,ge.segment,ge.sub_entity,ev.* FROM existing_vendors as ev
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` as ge 
ON ev.global_entity=ge.global_entity_id</relation>
                <relation connection='bigquery.0p98dkp1yfp9i51ek6ia41yqua1c' name='tableau_gsr_entitlements_global_entity_id' table='[fulfillment-dwh-production.curated_data_shared_govops].[tableau_gsr_entitlements_global_entity_id]' type='table' />
              </relation>
            </properties>
            <properties context='extract'>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Custom SQL Query1].[global_entity]' />
                    <expression op='[tableau_gsr_entitlements_global_entity_id].[global_entity_id]' />
                  </expression>
                </clause>
                <relation name='Custom SQL Query1' table='[Extract].[Custom SQL Query1]' type='table' />
                <relation name='tableau_gsr_entitlements_global_entity_id' table='[Extract].[tableau_gsr_entitlements_global_entity_id]' type='table' />
              </relation>
            </properties>
