            <column caption='Passives' datatype='integer' name='[Calculation_4092224015749410816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [nps_group]=&apos;Passive&apos; THEN [response_id] END)' />
