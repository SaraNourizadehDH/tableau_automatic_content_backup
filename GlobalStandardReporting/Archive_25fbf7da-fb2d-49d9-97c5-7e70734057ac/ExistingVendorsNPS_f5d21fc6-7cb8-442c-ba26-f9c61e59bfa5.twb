            <column caption='Date ' datatype='date' name='[Calculation_5492280524779581440]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Nps Score Parameter] &#10;WHEN &quot;Month&quot; THEN DATE(DATETRUNC(&apos;month&apos;,[recorded_at_utc]))&#10;WHEN &quot;Quarter&quot; THEN DATE(DATETRUNC(&apos;quarter&apos;,[recorded_at_utc]))&#10;WHEN &quot;Year&quot; THEN DATE(DATETRUNC(&apos;year&apos;,[recorded_at_utc])) &#10;END' />
