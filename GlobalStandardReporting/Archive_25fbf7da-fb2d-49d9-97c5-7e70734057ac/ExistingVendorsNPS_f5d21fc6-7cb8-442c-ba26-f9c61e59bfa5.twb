              <calculation class='tableau' formula='COUNTD([response_id])' />
            </column>
            <column caption='Passives' datatype='integer' name='[Calculation_4092224015749410816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [nps_group]=&apos;Passive&apos; THEN [response_id] END)' />
            </column>
            <column caption='Detractors' datatype='integer' name='[Calculation_4092224015749824514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [nps_group]=&apos;Detractor&apos; THEN [response_id] END)' />
            </column>
            <column caption='Promoters' datatype='integer' name='[Calculation_4092224015749894147]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [nps_group]=&apos;Promoter&apos; THEN [response_id] END)' />
            </column>
            <column caption='Promoters %' datatype='real' name='[Calculation_4092224015750045700]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4092224015749894147]/([Calculation_4092224015749824514]+[Calculation_4092224015749410816]+[Calculation_4092224015749894147])' />
            </column>
