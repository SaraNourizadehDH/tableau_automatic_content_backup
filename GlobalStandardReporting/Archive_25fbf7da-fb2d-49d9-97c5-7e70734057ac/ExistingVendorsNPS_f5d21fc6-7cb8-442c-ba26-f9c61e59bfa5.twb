            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[finished]' derivation='None' name='[none:finished:nk]' pivot='key' type='nominal' />
            <column-instance column='[level_2_reason]' derivation='None' name='[none:level_2_reason:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity_group]' derivation='None' name='[none:management_entity_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[nps_reason]' derivation='None' name='[none:nps_reason:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column caption='Nps Group' datatype='string' name='[nps_group]' role='dimension' type='nominal' />
            <column caption='Nps Reason' datatype='string' name='[nps_reason]' role='dimension' type='nominal'>
