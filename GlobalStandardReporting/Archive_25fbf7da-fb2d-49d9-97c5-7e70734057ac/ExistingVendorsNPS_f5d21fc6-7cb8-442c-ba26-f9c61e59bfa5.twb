    <datasource caption='qualtrics_responses_existing_vendor_aggregated (rl_sales_revenue)' inline='true' name='federated.0o3gb6z0oc3a4h1fn3wod1lshxv8' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0p98dkp1yfp9i51ek6ia41yqua1c'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh-ncr-live' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='curated_data_shared_govops' server-oauth='' username='momen.jamil@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[Custom SQL Query1].[global_entity]' />
              <expression op='[tableau_gsr_entitlements_global_entity_id].[global_entity_id]' />
            </expression>
          </clause>
          <relation connection='bigquery.0p98dkp1yfp9i51ek6ia41yqua1c' name='Custom SQL Query1' type='text'>with existing_vendors as
(SELECT CASE WHEN management_entity_group=&apos;HungerStation&apos; THEN &apos;HS_SA&apos; WHEN
country=&apos;Slovakia&apos; THEN &apos;FP_SK&apos; WHEN country=&apos;Finland&apos; THEN &apos;PO_FI&apos;  WHEN country=&apos;Sweden&apos; THEN &apos;OP_SE&apos; WHEN country=&apos;Greece&apos; THEN &apos;EF_GR&apos; 
WHEN q_language=&apos;ZH_T&apos; THEN &apos;FP_TW&apos; WHEN q_language=&apos;ZH_T (HK)&apos; THEN &apos;FP_HK&apos; WHEN q_language=&apos;MS&apos; THEN &apos;FP_MY&apos; 
WHEN q_language=&apos;MY&apos; THEN &apos;FP_MM&apos; WHEN q_language=&apos;LA&apos; THEN &apos;FP_LA&apos; WHEN q_language=&apos;KM&apos; THEN  &apos;FP_KH&apos; 
WHEN q_language=&apos;TH&apos; THEN  &apos;FP_TH&apos; WHEN q_language=&apos;BN&apos; THEN &apos;FP_BD&apos;  WHEN q_language=&apos;PK-EN&apos; THEN &apos;FP_PK&apos;
ELSE global_entity_id END as global_entity , CASE WHEN q_chl LIKE &apos;%email%&apos; THEN &apos;Email&apos; WHEN q_chl=&apos;gl&apos; THEN &apos;Personal Link&apos; WHEN q_chl=&apos;si&apos; THEN &apos;Portal&apos; ELSE q_chl END as channel,   * 
FROM `fulfillment-dwh-production.rl_sales_revenue.qualtrics_responses_existing_vendor_aggregated` as va
 )

SELECT ge.country_name,ge.management_entity,ge.segment,ge.sub_entity,ev.* FROM existing_vendors as ev
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` as ge 
ON ev.global_entity=ge.global_entity_id</relation>
          <relation connection='bigquery.0p98dkp1yfp9i51ek6ia41yqua1c' name='tableau_gsr_entitlements_global_entity_id' table='[fulfillment-dwh-production.curated_data_shared_govops].[tableau_gsr_entitlements_global_entity_id]' type='table' />
