      </column>
      <column caption='Joker AOV' datatype='real' name='[AOV (copy)_3348918915374645249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(zn([joker_order_gmv_eur]))/sum(ZN([joker_confirmed_orders]))' />
      </column>
      <column caption='MoM Revenue Eur' datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM(if DATETRUNC(&apos;month&apos;,[run_date])=[report_month] then null else [joker_revenue_eur]END)) &#10;- LOOKUP((SUM(if DATETRUNC(&apos;month&apos;,[run_date])=[report_month] then null else [joker_revenue_eur]END)), -1)) &#10;&#10;/ ABS(LOOKUP((SUM(if DATETRUNC(&apos;month&apos;,[run_date])=[report_month]then null else [joker_revenue_eur]END)), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Joker Offers' datatype='real' name='[Calculation_120893568786526208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [report_month], [global_entity_id] : MAX([joker_total_offers]) }' />
      </column>
      <column caption='Joker Revenue MTD PM' datatype='real' name='[Calculation_2777172859781820420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF     [report_date] &gt;= [Calculation_6214474970309046274] AND [report_date] &lt;= [Calculation_6214474970311700486]&#10;THEN   [joker_revenue_eur (adtech_il_joker_daily)]&#10;END' />
      </column>
      <column caption='Joker Revenue MTD CM' datatype='real' name='[Calculation_2777172859782361093]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF     [report_date] &gt;= [Calculation_6214474970308902913] AND [report_date] &lt;= [Calculation_6214474970308612096]&#10;THEN   [joker_revenue_eur (adtech_il_joker_daily)]&#10;END' />
      </column>
      <column caption='Last Months' datatype='boolean' name='[Calculation_2918543687711260672]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST()&lt; [Parameters].[Parameter 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Self Booking Revenue' datatype='real' default-format='p0.0%' name='[Calculation_333407173243453440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([joker_self_booking_revenue_eur]))/SUM(ZN([joker_revenue_eur]))' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_3348918915374039040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(zn([all_gmv_eur]))/sum(ZN([all_confirmed_orders]))' />
      </column>
      <column caption='filter non active countries' datatype='integer' name='[Calculation_3961971437340237824]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], YEAR([report_month])&#10;:SUM([joker_available])}' />
      </column>
      <column caption='Joker CVR' datatype='real' name='[Calculation_4043739918087868416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(zn([joker_confirmed_orders]))/sum(zn([Calculation_120893568786526208]))' />
      </column>
      <column caption='Inventory Sold' datatype='real' name='[Calculation_4043739918088368129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(ZN([joker_confirmed_orders]))/sum(zn([joker_available]))' />
      </column>
      <column caption='Joker Penetration' datatype='real' name='[Calculation_4043739918089752578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(zn([joker_vendors]))/sum(ZN([online_vendors]))' />
      </column>
      <column caption='% Churn' datatype='real' default-format='p0.00%' name='[Calculation_4043739918090129411]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(zn([joker_churn]))/sum(ZN([joker_active_vendors_pm]))' />
      </column>
      <column caption='% Revenue Over GMV' datatype='real' name='[Calculation_4043739918090756100]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(zn([joker_revenue_eur]))/SUM(ZN([all_gmv_eur]))' />
      </column>
      <column caption='% Self Booking Joker Available' datatype='real' name='[Calculation_4043739918091161605]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(zn([sb_joker_available]))/sum(zn([joker_available]))' />
      </column>
      <column caption='MTD Joker Target Achievement' datatype='real' default-format='p0.0%' name='[Calculation_4774941506913726466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([joker_revenue_eur]))/SUM(ZN([joker_mtd_target]))' />
      </column>
      <column caption='filter current month' datatype='boolean' name='[Calculation_4847210212952121367]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='MONTH({ FIXED :MAX([data_up_to])})=MONTH([date_month]) &#10;AND&#10;YEAR({ FIXED :MAX([data_up_to])})=YEAR([date_month])' />
      </column>
      <column caption='Joker Orders Over Totall Orders' datatype='real' default-format='p0.0%' name='[Calculation_4897734967582916608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([joker_confirmed_orders]))/sum(ZN([all_confirmed_orders]))' />
      </column>
      <column caption='Inventory Sold Over Joker w/Offers' datatype='real' name='[Calculation_4985766298830254080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(zn([joker_confirmed_orders]))/sum(zn([joker_available_with_offers]))' />
      </column>
      <column caption='Joker Revenue Over Joker GMV' datatype='real' default-format='p0.0%' name='[Calculation_6065504329331867649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(ZN([joker_revenue_eur]))/sum(ZN([joker_order_gmv_eur]))' />
      </column>
      <column caption='Latest Date' datatype='date' name='[Calculation_6214474970308612096]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED : MAX(TODAY()) - 1 }' />
      </column>
      <column caption='Latest Month' datatype='date' name='[Calculation_6214474970308902913]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&quot;month&quot;, [Calculation_6214474970308612096]))' />
      </column>
      <column caption='Previous Month' datatype='date' name='[Calculation_6214474970309046274]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&quot;month&quot;, -1, [Calculation_6214474970308902913]))' />
      </column>
      <column caption='Previous Date' datatype='date' name='[Calculation_6214474970311700486]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Calculation_6214474970309046274] + DATEPART(&quot;day&quot;, [Calculation_6214474970308612096] - 1)' />
      </column>
      <column caption='Display targets' datatype='boolean' name='[Calculation_658369972849086464]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 5]=&apos;Show&apos;' />
      </column>
      <column caption='% Zombies Joker' datatype='real' default-format='p0.0%' name='[Calculation_6617195239425007617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([joker_zombie_vendors]))/SUM(ZN([joker_vendors]))' />
      </column>
      <column caption='% Joker CTO (CVR)' datatype='real' default-format='p0.0%' name='[Calculation_6636476280527040512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([joker_confirmed_orders]) / SUM([joker_clicks])' />
      </column>
      <column caption='% Joker CTR' datatype='real' default-format='p0.0%' name='[Calculation_6636476280527216641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([joker_clicks]) / AVG([Calculation_120893568786526208])' />
      </column>
      <column caption='Inventory Sold without Zombies' datatype='real' name='[Inventory Sold (copy)_5222627460554784775]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(ZN([joker_confirmed_orders]))/sum(zn([joker_available_without_zombies]))' />
      </column>
      <column caption='Joker Vendor CVR' datatype='real' default-format='p0.00%' name='[Joker CVR (copy)_647322103429246977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(zn([joker_confirmed_orders]))/sum(zn([joker_offered_vendor]))' />
      </column>
      <column caption='Joker Penetration without Zombies' datatype='real' default-format='p0.0%' name='[Joker Penetration (copy)_5222627460553629702]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(zn([non_zombie_joker_vendors]))/sum(ZN([online_vendors]))' />
      </column>
      <column caption='Management Entity (copy)' datatype='string' name='[Management Entity (copy)_2742058911213719552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[management_entity]' />
      </column>
