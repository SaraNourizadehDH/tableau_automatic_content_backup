          <object caption='adtech_il_joker_monthly' id='adtech_il_joker_monthly_F6AF6D827B464981B1DC0C6C8B2747D2'>
            <properties context=''>
              <relation connection='bigquery.0c6hhld18vaouv144kkng1ehlzse' name='Custom SQL Query' type='text'>SELECT
      run_date,
      data_up_to,
      report_month,
      vertical_parent,
      global_entity_id,
      region,
      management_entity,
      sub_entity,
      sum(joker_available) as joker_available,
      sum(joker_revenue_eur) as joker_revenue_eur,
      sum(joker_confirmed_orders) as joker_confirmed_orders,
      avg(joker_total_offers) as joker_total_offers,
      sum(joker_total_offers) as joker_total_offers_sum,
      sum(all_gmv_eur) as all_gmv_eur,
FROM `dhh-ncr-live.analytics`.`adtech_il_joker_monthly` `adtech_il_joker_monthly`
GROUP BY ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Custom SQL Query' table='[Extract].[Custom SQL Query]' type='table' />
            </properties>
          </object>
          <object caption='il_gmv_by_entity' id='il_gmv_by_entity_51104E99F111419884D10B36CED7D5DD'>
            <properties context=''>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='AND'>
                    <expression op='='>
                      <expression op='[il_gmv_by_entity].[global_entity_id]' />
                      <expression op='[v_tableau_user_global_entity_id1].[global_entity_id]' />
                    </expression>
                    <expression op='='>
                      <expression op='USERNAME()' />
                      <expression op='[v_tableau_user_global_entity_id1].[username]' />
                    </expression>
                  </expression>
                </clause>
                <relation connection='bigquery.0c6hhld18vaouv144kkng1ehlzse' name='il_gmv_by_entity' table='[dhh-ncr-live.analytics].[il_gmv_by_entity]' type='table' />
                <relation connection='bigquery.0c6hhld18vaouv144kkng1ehlzse' name='v_tableau_user_global_entity_id1' table='[dhh-ncr-live.analytics].[v_tableau_user_global_entity_id]' type='table' />
              </relation>
            </properties>
