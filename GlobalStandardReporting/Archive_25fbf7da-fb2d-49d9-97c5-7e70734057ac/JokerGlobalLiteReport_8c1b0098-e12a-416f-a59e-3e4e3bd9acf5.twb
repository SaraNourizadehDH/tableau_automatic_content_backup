    <worksheet name='MTD Total Target MTD'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>MTD Target Achievement</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='MTDTotalTargetMTD' path='/t/GlobalStandardReporting/workbooks/JokerGlobalLiteReport_17453354739370' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='adtech_il_joker_monthly+ (analytics)' name='federated.0f8lxop0mbwp0q1dkk2ez17vnynh' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='MTD Target Achievement' caption='Lucanet Targets' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Show&quot;'>
              <calculation class='tableau' formula='&quot;Show&quot;' />
              <aliases>
                <alias key='&quot;Hide&quot;' value='Overall KPI&apos;s' />
                <alias key='&quot;Show&quot;' value='MTD Target Achievement' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0f8lxop0mbwp0q1dkk2ez17vnynh'>
            <column caption='Joker Revenue MTD PM' datatype='real' name='[Calculation_2777172859781820420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF     [report_date] &gt;= [Calculation_6214474970309046274] AND [report_date] &lt;= [Calculation_6214474970311700486]&#10;THEN   [joker_revenue_eur (adtech_il_joker_daily)]&#10;END' />
            </column>
            <column caption='Joker Revenue MTD CM' datatype='real' name='[Calculation_2777172859782361093]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF     [report_date] &gt;= [Calculation_6214474970308902913] AND [report_date] &lt;= [Calculation_6214474970308612096]&#10;THEN   [joker_revenue_eur (adtech_il_joker_daily)]&#10;END' />
            </column>
            <column caption='filter non active countries' datatype='integer' name='[Calculation_3961971437340237824]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], YEAR([report_month])&#10;:SUM([joker_available])}' />
            </column>
            <column caption='MTD Joker Target Achievement' datatype='real' default-format='p0.0%' name='[Calculation_4774941506913726466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([joker_revenue_eur]))/SUM(ZN([joker_mtd_target]))' />
            </column>
            <column caption='Latest Date' datatype='date' name='[Calculation_6214474970308612096]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX(TODAY()) - 1 }' />
            </column>
            <column caption='Latest Month' datatype='date' name='[Calculation_6214474970308902913]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&quot;month&quot;, [Calculation_6214474970308612096]))' />
            </column>
            <column caption='Previous Month' datatype='date' name='[Calculation_6214474970309046274]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&quot;month&quot;, -1, [Calculation_6214474970308902913]))' />
            </column>
            <column caption='Previous Date' datatype='date' name='[Calculation_6214474970311700486]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Calculation_6214474970309046274] + DATEPART(&quot;day&quot;, [Calculation_6214474970308612096] - 1)' />
            </column>
            <column caption='Display targets' datatype='boolean' name='[Calculation_658369972849086464]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 5]=&apos;Show&apos;' />
            </column>
