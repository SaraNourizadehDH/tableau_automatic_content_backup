ut (PDT) Delta&apos; THEN [actual_dt_range_ckt_delta_buckets_min]&#10;        WHEN &apos;Actual DT (PDT) vs Checkout (Range) Delta&apos; THEN [actual_dt_range_ckt_delta_buckets_min]&#10;        WHEN &apos;Actual DT (PDT) vs RDP (PDT) Delta&apos; THEN [actual_dt_range_rdp_delta_buckets_min]&#10;        WHEN &apos;Actual DT (PDT) vs RDP (Range) Delta&apos; THEN [actual_dt_range_rdp_delta_buckets_min]&#10;        WHEN &apos;Actual DT (PDT) vs RLP (PDT) Delta&apos; THEN [actual_dt_range_rlp_delta_buckets_min]&#10;        WHEN &apos;Actual DT (PDT) vs RLP (Range) Delta&apos; THEN [actual_dt_range_rlp_delta_buckets_min]&#10;        WHEN &apos;None&apos; THEN &apos;&apos;&#10;    END&#10;ELSEIF [Parameters].[Choose Delta Pages - Components (copy)_6530782431808884738] = &quot;Preparation Time&quot; THEN&#10;    CASE [Parameters].[Choose Page (copy)_6651464817088086030]&#10;        WHEN &apos;RDP (PDT) vs RLP (PDT) Delta&apos; THEN [prep_time_rdp_rlp_delta_buckets_min]&#10;        WHEN &apos;Checkout (PDT) vs RDP (PDT) Delta&apos; THEN [prep_time_ckt_rdp_delta_buckets_min]&#10;        WHEN &apos;Checkout (PDT) vs RLP (PDT) Delta&apos; THEN [prep_time_ckt_rlp_delta_buckets_min]&#10;        WHEN &apos;None&apos; THEN &apos;&apos;&#10;    END&#10;ELSEIF [Parameters].[Choose Delta Pages - Components (copy)_6530782431808884738] = &quot;Preparation Time Buffer&quot; THEN&#10;    CASE [Parameters].[Choose Page (copy)_6651464817088086030]&#10;        WHEN &apos;RDP (PDT) vs RLP (PDT) Delta&apos; THEN [prep_buffer_rdp_rlp_delta_buckets_min]&#10;        WHEN &apos;Checkout (PDT) vs RDP (PDT) Delta&apos; THEN [prep_buffer_ckt_rdp_delta_buckets_min]&#10;        WHEN &apos;Checkout (PDT) vs RLP (PDT) Delta&apos; THEN [prep_buffer_ckt_rlp_delta_buckets_min]&#10;        WHEN &apos;None&apos; THEN &apos;&apos;&#10;    END&#10;ELSEIF [Parameters].[Choose Delta Pages - Components (copy)_6530782431808884738] = &quot;Courier Delay&quot; THEN&#10;    CASE [Parameters].[Choose Page (copy)_6651464817088086030]&#10;        WHEN &apos;RDP (PDT) vs RLP (PDT) Delta&apos; THEN [courier_delay_rdp_rlp_delta_buckets_min]&#10;        WHEN &apos;Checkout (PDT) vs RDP (PDT) Delta&apos; THEN [courier_delay_ckt_rdp_delta_buckets_min]&#10;        WHEN &apos;Checkout (PDT) vs RLP (PDT) Delta&apos; THEN [courier_delay_ckt_rlp_delta_buckets_min]&#10;        WHEN &apos;None&apos; THEN &apos;&apos;&#10;    END&#10;ELSEIF [Parameters].[Choose Delta Pages - Components (copy)_6530782431808884738] = &quot;Driving Time&quot; THEN&#10;    CASE [Parameters].[Choose Page (copy)_6651464817088086030]&#10;        WHEN &apos;RDP (PDT) vs RLP (PDT) Delta&apos; THEN [driving_time_rdp_rlp_delta_buckets_min]&#10;        WHEN &apos;Checkout (PDT) vs RDP (PDT) Delta&apos; THEN [driving_time_ckt_rdp_delta_buckets_min]&#10;        WHEN &apos;Checkout (PDT) vs RLP (PDT) Delta&apos; THEN [driving_time_ckt_rlp_delta_buckets_min]&#10;        WHEN &apos;None&apos; THEN &apos;&apos;&#10;    END&#10;ELSEIF [Parameters].[Choose Delta Pages - Components (copy)_6530782431808884738] = &quot;Delivery Duration Buffer&quot; THEN&#10;    CASE [Parameters].[Choose Page (copy)_6651464817088086030]&#10;        WHEN &apos;RDP (PDT) vs RLP (PDT) Delta&apos; THEN [delivery_duration_buffer_rdp_rlp_delta_buckets_min]&#10;        WHEN &apos;Checkout (PDT) vs RDP (PDT) Delta&apos; THEN [delivery_duration_buffer_ckt_rdp_delta_buckets_min]&#10;        WHEN &apos;Checkout (PDT) vs RLP (PDT) Delta&apos; THEN [delivery_duration_buffer_ckt_rlp_delta_buckets_min]&#10;        WHEN &apos;None&apos; THEN &apos;&apos;&#10;    END&#10;ELSEIF [Parameters].[Choose Delta Pages - Components (copy)_6530782431808884738] = &quot;Walk Out Duration&quot; THEN&#10;    CASE [Parameters].[Choose Page (copy)_6651464817088086030]&#10;        WHEN &apos;RDP (PDT) vs RLP (PDT) Delta&apos; THEN [walk_out_duration_rdp_rlp_delta_buckets_min]&#10;        WHEN &apos;Checkout (PDT) vs RDP (PDT) Delta&apos; THEN [walk_out_duration_ckt_rdp_delta_buckets_min]&#10;        WHEN &apos;Checkout (PDT) vs RLP (PDT) Delta&apos; THEN [walk_out_duration_ckt_rlp_delta_buckets_min]&#10;        WHEN &apos;None&apos; THEN &apos;&apos;&#10;    END&#10;END' />
      </column>
      <column caption='RLP Buckets by component' datatype='string' name='[Bucket Delta - Components (copy)_6530782431830953989]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose Delta Pages - Components (copy)_6530782431808884738] &#10;    WHEN &quot;Promised Delivery Time (Total)&quot; THEN [rlp_buckets_min]&#10;    WHEN &quot;Preparation Time&quot; THEN [prep_time_rlp_buckets_min]&#10;    WHEN  &quot;Preparation Time Buffer&quot; THEN [prep_buffer_rlp_buckets_min]&#10;    WHEN &quot;Courier Delay&quot; THEN [courier_delay_rlp_buckets_min]&#10;    WHEN &quot;Driving Time&quot; THEN [driving_time_rlp_buckets_min]&#10;    WHEN &quot;Delivery Duration Buffer&quot; THEN [delivery_duration_buffer_rlp_buckets_min]&#10;    WHEN &quot;Walk Out Duration&quot; THEN [walk_out_duration_rlp_buckets_min]&#10;END' />
      </column>
      <column caption='RDP vs RLP Delta Chosen' datatype='boolean' name='[Bucket Delta - PDT (copy)_424393949058387972]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Parameters].[Choose Page (copy)_6651464817088086030], &apos;RDP&apos;)&#10;    AND CONTAINS([Parameters].[Choose Page (copy)_6651464817088086030], &apos;RLP&apos;)&#10;  THEN TRUE&#10;END' />
      </column>
      <column caption='Number of Records' datatype='integer' name='[Calculation_1201687060763148288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='First OTP Request Delay Buckets (min)' datatype='string' name='[Calculation_1427359659079843840]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [first_otp_request_and_order_creation_request_delay_buckets_min] = &apos;]40 ; ∞]&apos;&#10;    THEN &apos;]40 ; ∞[&apos;&#10;ELSE [first_otp_request_and_order_creation_request_delay_buckets_min]&#10;END' />
      </column>
      <column caption='RDP PDT vs RLP PDT Delta' datatype='real' name='[Calculation_1427359659081646081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rdp_rlp_delta_min_sum]) / SUM([rdp_rlp_delta_min_count])' />
      </column>
      <column caption='Actual DT vs RLP PDT Delta' datatype='real' name='[Calculation_1427359659083005956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_dt_rlp_delta_min_sum]) / SUM([actual_dt_rlp_delta_min_count])' />
      </column>
      <column caption='Cumulative % of Orders' datatype='real' default-format='p0.0%' name='[Calculation_1620803337019138054]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM( SUM([number_of_orders]) / TOTAL(SUM([number_of_orders])) )'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Page' datatype='string' name='[Calculation_174233019314544641]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4]' />
      </column>
      <column caption='Choose PDT / Range' datatype='string' name='[Calculation_176766291884093446]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 6]' />
      </column>
      <column caption='Absolute / Delta' datatype='string' name='[Calculation_1824380070252564486]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
      </column>
      <column caption='Always Absolute Delta' datatype='boolean' name='[Calculation_1850135077099458560]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[delta] = &apos;absolute&apos;' />
      </column>
      <column caption='Absolute Delta Filter' datatype='boolean' name='[Calculation_1951606792055959564]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 5]' />
      </column>
      <column caption='Orders' datatype='integer' hidden='true' name='[Calculation_4018196081149640709]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{ EXCLUDE [region]&#10;    , [entity_display_name]&#10;    , [country_code]&#10;    , [city_name]&#10;    , [zone_id]&#10;    , [order_item_quantity]&#10;    //, [queued_orders]&#10;    , [Calculation_7001127161988063234]&#10;    , [Bucket (A) (copy)_4018196081148739588]&#10;    , [rdp_rlp_delta_buckets_min]&#10;    , [otp_ckt_delta_buckets_min]&#10;    , [actual_dt_otp_delta_buckets_min]&#10;    , [actual_dt_rlp_delta_buckets_min]&#10;: SUM([number_of_orders])&#10;}' />
      </column>
      <column caption='Conversion Rate' datatype='real' name='[Calculation_424393949058072579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(100,100*(SUM([number_of_orders])/SUM([number_of_sessions])))' />
      </column>
      <column caption='Conversion Rate Title' datatype='string' name='[Calculation_424393949059813381]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MIN(&apos;Conversion Rate&apos;)' />
      </column>
      <column caption='Empty String' datatype='string' name='[Calculation_424393949065707527]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;&apos;' />
      </column>
      <column caption='Point PDT / Range' datatype='string' name='[Calculation_4272930889001996289]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Time - Delta / Absolute (copy)_4272930889001435136]' />
      </column>
      <column caption='Avg Actual Delivery Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4824903364634845184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_delivery_time_sum]) / SUM([actual_delivery_time_count])' />
      </column>
      <column caption='Avg Courier Delay RLP' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4824903364655517709]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([estimated_courier_delay_sum_rlp]) / SUM([estimated_courier_delay_count_rlp])' />
      </column>
      <column caption='Conversion Rate Text Dynamic Text' datatype='string' name='[Calculation_5218335018529202176]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Bucket Delta - PDT (copy)_424393949058387972] = TRUE&#10;  THEN &apos;The filters &quot;has transaction&quot; and &quot;delivery type&quot; do not apply to the conversion rate table.&apos;&#10;  ELSE &apos;Conversion rate table is available only when choosing RLP vs. RDP delta.&apos;&#10;END' />
      </column>
      <column caption='Avg RLP Delivery Time' datatype='real' name='[Calculation_5418815565605011456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([promised_delivery_time_sum_rlp]) / sum([promised_delivery_time_count_rlp])' />
      </column>
      <column caption='PDT is chosen' datatype='boolean' name='[Calculation_5434578118306492419]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Choose Delta Pages - Components (copy)_6530782431808884738] = &apos;Promised Delivery Time (Total)&apos;' />
      </column>
      <column caption='Components granularity unavailable text' datatype='string' name='[Calculation_5434578118324793349]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Components granularity is unavailable for the chosen page.&#10;Please choose Promised Delivery Time granularity. For analysis of components, please choose one of the following pages:&#10;RDP (PDT) vs RLP (PDT), Checkout (PDT) vs RLP (PDT) and Checkout (PDT) vs RDP (PDT).&apos;' />
      </column>
      <column caption='Dimension (A)' datatype='string' name='[Calculation_5527113061052891188]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Country Name Parameter]&#10;&#10;    WHEN &apos;Region&apos; THEN [region]&#10;    WHEN &apos;Entity&apos; THEN [entity_display_name]&#10;    WHEN &apos;Country&apos; THEN [country_name]&#10;    WHEN &apos;Week Day&apos; THEN [day_of_week_local]&#10;    WHEN &apos;Hour of Day&apos; THEN [hour_of_day_local]&#10;    WHEN &apos;Time Bucket&apos; THEN [Calculation_7001127161988063234]&#10;    WHEN &apos;Order Item Quantity&apos; THEN [order_item_quantity]&#10;    //WHEN &apos;Queued Orders&apos; THEN STR([queued_orders])&#10;    WHEN &apos;Stacked Delivery&apos; THEN STR([is_stacked_delivery])&#10;    WHEN &apos;Stacked Delivery Rank&apos; THEN [stacked_delivery_rank]&#10;    WHEN &apos;Stacked Intravendor&apos; THEN STR([is_stacked_intravendor])&#10;    WHEN &apos;Vehicle Type&apos; THEN [vehicle_type]&#10;    WHEN &apos;RLP Buckets&apos; THEN [rlp_buckets_min]&#10;    WHEN &apos;RDP Buckets&apos; THEN [rdp_buckets_min]&#10;    WHEN &apos;Checkout Buckets&apos; THEN [ckt_buckets_min]&#10;    WHEN &apos;OTP Buckets&apos; THEN [otp_buckets_min]&#10;    WHEN &apos;Actual DT Buckets&apos; THEN [actual_dt_buckets_min]&#10;    WHEN &apos;RDP PDT vs RLP PDT Delta Buckets&apos; THEN [rdp_rlp_delta_buckets_min]&#10;    WHEN &apos;Checkout PDT vs RLP PDT Delta Buckets&apos; THEN [ckt_rlp_delta_buckets_min]&#10;    WHEN &apos;Checkout Upper Limit vs RLP Upper Limit Delta Buckets&apos; THEN [upper_limit_ckt_rlp_delta_buckets_min]&#10;    WHEN &apos;Checkout Lower Limit vs RLP Lower Limit Delta Buckets&apos; THEN [lower_limit_ckt_rlp_delta_buckets_min]&#10;    WHEN &apos;Checkout PDT vs RDP PDT Delta Buckets&apos; THEN [ckt_rdp_delta_buckets_min]&#10;    WHEN &apos;Checkout Upper Limit vs RDP Upper Limit Delta Buckets&apos; THEN [upper_limit_ckt_rdp_delta_buckets_min]&#10;    WHEN &apos;Checkout Lower Limit vs RDP Lower Limit Delta Buckets&apos; THEN [lower_limit_ckt_rdp_delta_buckets_min]&#10;    WHEN &apos;OTP vs Checkout PDT Delta Buckets&apos; THEN [otp_ckt_delta_buckets_min]&#10;    WHEN &apos;OTP vs Checkout Range Delta Buckets&apos; THEN [otp_range_ckt_delta_buckets_min]&#10;    WHEN &apos;OTP vs RDP PDT Delta Buckets&apos; THEN [otp_rdp_delta_buckets_min]&#10;    WHEN &apos;OTP vs RDP Range Delta Buckets&apos; THEN [otp_range_rdp_delta_buckets_min]&#10;    WHEN &apos;OTP vs RLP PDT Delta Buckets&apos; THEN [otp_rdp_delta_buckets_min]&#10;    WHEN &apos;OTP vs RLP Range Delta Buckets&apos; THEN [otp_range_rdp_delta_buckets_min]&#10;    WHEN &apos;Actual DT vs OTP Delta Buckets&apos; THEN [actual_dt_otp_delta_buckets_min]&#10;    WHEN &apos;First OTP Request Delay Buckets&apos; THEN [Calculation_1427359659079843840]&#10;    WHEN &apos;None&apos; THEN &apos;&apos;&#10;&#10;END' />
      </column>
      <column caption='KPI (1) ' datatype='real' name='[Calculation_5527113061055328310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;    WHEN &apos;RLP&apos; THEN [Calculation_5418815565605011456]&#10;    WHEN &apos;RDP&apos; THEN [Avg Actual Delivery Time (copy)_4824903364635017217]&#10;    WHEN &apos;Checkout&apos; THEN [Avg OTP Delivery Time (copy)_1824380069668937730]&#10;    WHEN &apos;OTP&apos; THEN [Avg Actual Delivery Time (copy)_4824903364639866882]&#10;    WHEN &apos;Actual DT&apos; THEN [Calculation_4824903364634845184]&#10;    WHEN &apos;Prep Time RLP&apos; THEN [Avg Driving Time RLP (copy)_4824903364664811537]&#10;    WHEN &apos;Prep Buffer RLP&apos; THEN [Avg Prep Time RLP (copy)_4824903364664954898]&#10;    WHEN &apos;Courier Delay RLP&apos; THEN [Calculation_4824903364655517709]&#10;    WHEN &apos;Driving Time RLP&apos; THEN [Avg Courier Delay RLP (copy)_4824903364655616014]&#10;    WHEN &apos;Delivery Duration Buffer RLP&apos; THEN [Avg Prep Buffer RLP (copy)_1824380069666684928]&#10;    WHEN &apos;Walk Out Duration RLP&apos; THEN [Avg Prep Time RLP (copy)_5683331674796175361]&#10;    WHEN &apos;Prep Time RDP&apos; THEN [Avg Prep Time RLP (copy)_174233019376885766]&#10;    WHEN &apos;Prep Buffer RDP&apos; THEN [Avg Prep Buffer RLP (copy)_174233019365924867]&#10;    WHEN &apos;Courier Delay RDP&apos; THEN [Avg Courier Delay RLP (copy)_174233019377197065]&#10;    WHEN &apos;Driving Time RDP&apos; THEN [Avg Driving Time RLP (copy)_174233019377430539]&#10;    WHEN &apos;Delivery Duration Buffer RDP&apos; THEN [Avg Delivery Duration Buffer RLP (copy)_174233019376500740]&#10;    WHEN &apos;Walk Out Duration RDP&apos; THEN [Avg Prep Time RDP (copy)_5683331674796408834]&#10;    WHEN &apos;Prep Time Checkout&apos; THEN [Avg Prep Time RDP (copy)_759700971217670153]&#10;    WHEN &apos;Prep Buffer Checkout&apos; THEN [Avg Prep Buffer RLP (copy)_174233019377090568]&#10;    WHEN &apos;Courier Delay Checkout&apos; THEN [Avg Courier Delay RLP (copy) (copy)_174233019377205258]&#10;    WHEN &apos;Driving Time Checkout&apos; THEN [Avg Driving Time RLP (copy) (copy)_174233019377438732]&#10;    WHEN &apos;Delivery Duration Buffer Checkout&apos; THEN [Avg Delivery Duration Buffer RLP (copy) (copy)_174233019376508933]&#10;    WHEN &apos;Walk Out Duration Checkout&apos; THEN [Avg Prep Time Checkout (copy)_5683331674796556291]&#10;    WHEN &apos;At Vendor Time&apos; THEN [Avg Driving Distance (copy)_4824903364655865872]&#10;    WHEN &apos;RDP PDT vs RLP PDT Delta&apos; THEN [Calculation_1427359659081646081]&#10;    WHEN &apos;RDP Upper Limit vs RLP Upper Limit Delta&apos; THEN [Checkout vs RLP Delta Upper Limit (copy)_4272930889014206478]&#10;    WHEN &apos;RDP Lower Limit vs RLP Lower Limit Delta&apos; THEN [Checkout vs RLP Delta Lower Limit (copy)_4272930889014181901]&#10;    WHEN &apos;Checkout PDT vs RDP PDT Delta&apos; THEN [RDP vs RLP Delta (copy)_1824380069670445059]&#10;    WHEN &apos;Checkout Upper Limit vs RDP Upper Limit Delta&apos; THEN [Checkout vs RDP Delta (copy)_4272930889013215241]&#10;    WHEN &apos;Checkout Lower Limit vs RDP Lower Limit Delta&apos; THEN [Checkout vs RDP Delta Upper Limit (copy)_4272930889013776394]&#10;    WHEN &apos;Checkout PDT vs RLP PDT Delta&apos; THEN [Checkout vs RDP Delta (copy)_6651464816956755974]&#10;    WHEN &apos;Checkout Upper Limit vs RLP Upper Limit Delta&apos; THEN [Checkout vs RDP Delta Upper Limit (copy)_4272930889013973004]&#10;    WHEN &apos;Checkout Lower Limit vs RLP Lower Limit Delta&apos; THEN [Checkout vs RDP Delta Lower Limit (copy)_4272930889013964811]&#10;    WHEN &apos;OTP vs Checkout PDT Delta&apos; THEN [OTP vs Checkout Delta  (copy)_1824380069671608324]&#10;    WHEN &apos;OTP vs Checkout Range Delta&apos; THEN [OTP vs Checkout Delta (copy)_4272930889012441096]&#10;    WHEN &apos;Actual DT vs OTP Delta&apos; THEN [Actual DT vs OTP Delta (copy)_1824380069672128517]&#10;    WHEN &apos;Actual DT vs Checkout PDT Delta&apos; THEN [Actual DT vs CKT Range Delta (copy)_176766291944988687]&#10;    WHEN &apos;Actual DT vs Checkout Range Delta&apos; THEN [Actual DT vs RLP Range Delta (copy)_176766291944804366]&#10;    WHEN &apos;Actual DT vs RDP PDT Delta&apos; THEN [Actual DT vs RLP PDT Delta (copy)_176766291939061772]&#10;    WHEN &apos;Actual DT vs RDP Range Delta&apos; THEN [Actual DT vs RLP Range Delta (copy)_176766291944730637]&#10;    WHEN &apos;Actual DT vs RLP PDT Delta&apos; THEN [Calculation_1427359659083005956]&#10;    WHEN &apos;Actual DT vs RLP Range Delta&apos; THEN [Actual DT vs RLP PDT Delta (copy)_176766291895398408]&#10;END' />
      </column>
      <column caption='Total Number of Orders/Sessions' datatype='integer' name='[Calculation_5527113061145841740]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [has_transaction] = TRUE THEN [number_of_orders] ELSE [number_of_sessions] END)' />
      </column>
      <column caption='User Entitlements' datatype='boolean' name='[Calculation_5983946915141976064]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Dynamic Time Buckets' datatype='string' name='[Calculation_7001127161988063234]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [hour_of_day_local] &gt;= [Parameters].[Dinner Start (copy)_7001127161989849093]&#10;  AND [hour_of_day_local] &lt;= [Parameters].[Breakfast Start (copy)_7001127161989939206]&#10;   THEN &apos;Breakfast&apos;&#10;ELSEIF [hour_of_day_local] &gt;= [Parameters].[Parameter 2]&#10;  AND [hour_of_day_local] &lt;= [Parameters].[Lunch start (copy)_7001127161987661825]&#10;    THEN &apos;Lunch&apos; &#10;ELSEIF [hour_of_day_local] &gt;= [Parameters].[Lunch start (copy)_7001127161988554755]&#10;  AND [hour_of_day_local] &lt;= [Parameters].[Dinner start (copy)_7001127161988632580]&#10;    THEN &apos;Dinner&apos;&#10;ELSE &apos;Off-peak&apos; &#10;END' />
      </column>
      <column caption='Checkout Upper Limit vs RDP Upper Limit Delta' datatype='real' name='[Checkout vs RDP Delta (copy)_4272930889013215241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([upper_limit_ckt_rdp_delta_min_sum]) / SUM([upper_limit_ckt_rdp_delta_min_count])' />
      </column>
      <column caption='Checkout PDT vs RLP PDT Delta' datatype='real' name='[Checkout vs RDP Delta (copy)_6651464816956755974]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pdt_delta_ckt_rlp_min_sum]) / SUM([pdt_delta_ckt_rlp_min_count])' />
      </column>
      <column caption='Checkout Lower Limit vs RLP Lower Limit Delta' datatype='real' name='[Checkout vs RDP Delta Lower Limit (copy)_4272930889013964811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([lower_limit_ckt_rlp_delta_min_sum]) / SUM([lower_limit_ckt_rlp_delta_min_count])' />
      </column>
      <column caption='Checkout Lower Limit vs RDP Lower Limit Delta' datatype='real' name='[Checkout vs RDP Delta Upper Limit (copy)_4272930889013776394]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([lower_limit_ckt_rdp_delta_min_sum]) / SUM([lower_limit_ckt_rdp_delta_min_count])' />
      </column>
      <column caption='Checkout Upper Limit vs RLP Upper Limit Delta' datatype='real' name='[Checkout vs RDP Delta Upper Limit (copy)_4272930889013973004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([upper_limit_ckt_rlp_delta_min_sum]) / SUM([upper_limit_ckt_rlp_delta_min_count])' />
      </column>
      <column caption='Checkout vs RLP Delta (abs)' datatype='real' hidden='true' name='[Checkout vs RLP Delta (copy)_1951606792038899716]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(pdt_abs_delta_ckt_rlp_min_sum) / SUM(pdt_abs_delta_ckt_rlp_min_count)' />
      </column>
      <column caption='RDP Lower Limit vs RLP Lower Limit Delta' datatype='real' name='[Checkout vs RLP Delta Lower Limit (copy)_4272930889014181901]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([lower_limit_rdp_rlp_delta_min_sum]) / SUM([lower_limit_rdp_rlp_delta_min_count])' />
      </column>
      <column caption='RDP Upper Limit vs RLP Upper Limit Delta' datatype='real' name='[Checkout vs RLP Delta Upper Limit (copy)_4272930889014206478]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([upper_limit_rdp_rlp_delta_min_sum]) / SUM([upper_limit_rdp_rlp_delta_min_count])' />
      </column>
      <column caption='Range was chosen text' datatype='string' name='[Components granularity unavailable text (copy)_176766291834552320]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose Page (copy)_6651464817088086030]&#10;&#10;WHEN &apos;OTP (PDT) vs Checkout (Range) Delta&apos; THEN&#10;&apos;* When comparing a point-PDT vs. Range-PDT, the jump is calculated relative to the relevant limit. If the PDT falls within the range, the jump is considered to be 0.&#10;For example: If the PDT at the order transaction page is 8 minutes and the range shown at checkout is 10-15 minutes, the jump is -2. If the PDT is 12 minutes, it is considered as &quot;No Jump&quot;&#10;* No jump means the delta is 0 across the pages.&apos;&#10;&#10;WHEN &apos;OTP (PDT) vs RDP (Range) Delta&apos; THEN&#10;&apos;* When comparing a point-PDT vs. Range-PDT, the jump is calculated relative to the relevant limit. If the PDT falls within the range, the jump is considered to be 0.&#10;For example: If the PDT at the order transaction page is 8 minutes and the range shown on the restaurant details page is 10-15 minutes, the jump is -2. If the PDT is 12 minutes, it is considered as &quot;No Jump&quot;.&#10;* No jump means the delta is 0 across the pages.&apos;&#10;&#10;WHEN &apos;OTP (PDT) vs RLP (Range) Delta&apos; THEN&#10;&apos;* When comparing a point-PDT vs. Range-PDT, the jump is calculated relative to the relevant limit. If the PDT falls within the range, the jump is considered to be 0.&#10;For example: If the PDT at the order transaction page is 8 minutes and the range shown on the restaurant listing page is 10-15 minutes, the jump is -2. If the PDT is 12 minutes, it is considered as &quot;No Jump&quot;.&#10;* No jump means the delta is 0 across the pages.&apos;&#10;&#10;WHEN &apos;Actual DT (PDT) vs Checkout (Range) Delta&apos; THEN&#10;&apos;* When comparing a point-PDT vs. Range-PDT, the jump is calculated relative to the relevant limit. If the PDT falls within the range, the jump is considered to be 0.&#10;For example: If the actual delivery time is 8 minutes and the range shown at checkout is 10-15 minutes, the jump is -2. If the PDT is 12 minutes, it is considered as &quot;No Jump&quot;.&#10;* No jump means the delta is 0 across the pages.&apos;&#10;&#10;WHEN &apos;Actual DT (PDT) vs RDP (Range) Delta&apos; THEN&#10;&apos;* When comparing a point-PDT vs. Range-PDT, the jump is calculated relative to the relevant limit. If the PDT falls within the range, the jump is considered to be 0.&#10;For example: If the actual delivery time is 8 minutes and the range shown on the restaurant details page is 10-15 minutes, the jump is -2. If the PDT is 12 minutes, it is considered as &quot;No Jump&quot;.&#10;* No jump means the delta is 0 across the pages.&apos;&#10;&#10;WHEN &apos;Actual DT (PDT) vs RLP (Range) Delta&apos; THEN&#10;&apos;* When comparing a point-PDT vs. Range-PDT, the jump is calculated relative to the relevant limit. If the PDT falls within the range, the jump is considered to be 0.&#10;For example: If actual delivery time is 8 minutes and the range shown on the restaurant listing page is 10-15 minutes, the jump is -2. If the PDT is 12 minutes, it is considered as &quot;No Jump&quot;.&#10;* No jump means the delta is 0 across the pages.&apos;&#10;&#10;ELSE &apos;No jump means the delta is 0 across the pages.&apos;&#10;&#10;END' />
      </column>
      <column caption='Bucket (A) - to delete' datatype='string' name='[Dimension (A) (copy)_4018196081148579843]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose Dimension (A) (copy)_4018196081148280833]&#10;&#10;    WHEN &apos;RLP Buckets (min)&apos; THEN [rlp_buckets_min]&#10;    WHEN &apos;RDP Buckets (min)&apos; THEN [rdp_buckets_min]&#10;    WHEN &apos;Checkout Buckets (min)&apos; THEN [ckt_buckets_min]&#10;    WHEN &apos;OTP Buckets (min)&apos; THEN [otp_buckets_min]&#10;    WHEN &apos;Actual DT Buckets (min)&apos; THEN [actual_dt_buckets_min]&#10;    WHEN &apos;RDP vs RLP Delta Buckets (min)&apos; THEN [rdp_rlp_delta_buckets_min]&#10;    WHEN &apos;Checkout vs RDP Delta Buckets (min)&apos; THEN [ckt_rdp_delta_buckets_min]&#10;    WHEN &apos;Checkout vs RLP Delta Buckets (min)&apos; THEN [ckt_rlp_delta_buckets_min]&#10;    WHEN &apos;OTP vs Checkout Delta Buckets (min)&apos; THEN [otp_ckt_delta_buckets_min]&#10;    WHEN &apos;OTP vs RDP Delta Buckets (min)&apos; THEN [otp_rdp_delta_buckets_min]&#10;    WHEN &apos;OTP vs RLP Delta Buckets (min)&apos; THEN [otp_rlp_delta_buckets_min]&#10;    WHEN &apos;Actual DT vs OTP Delta Buckets (min)&apos; THEN [actual_dt_otp_delta_buckets_min]&#10;    WHEN &apos;Actual DT vs Checkout Delta Buckets (min)&apos; THEN [actual_dt_ckt_delta_buckets_min]&#10;    WHEN &apos;Actual DT vs RDP Delta Buckets (min)&apos; THEN [actual_dt_rdp_delta_buckets_min]&#10;    WHEN &apos;Actual DT vs RLP Delta Buckets (min)&apos; THEN [actual_dt_rlp_delta_buckets_min]&#10;    WHEN &apos;None&apos; THEN &apos;&apos;&#10;&#10;END' />
      </column>
      <column caption='Dimension (B)' datatype='string' name='[Dimension (A) (copy)_5527113061054066741]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose Dimension (A) (copy)_140315290018975744]&#10;&#10;    WHEN &apos;Region&apos; THEN [region]&#10;    WHEN &apos;Entity&apos; THEN [entity_display_name]&#10;    WHEN &apos;Country&apos; THEN [country_name]&#10;    WHEN &apos;Week Day&apos; THEN [day_of_week_local]&#10;    WHEN &apos;Hour of Day&apos; THEN [hour_of_day_local]&#10;    WHEN &apos;Time Bucket&apos; THEN [Calculation_7001127161988063234]&#10;    WHEN &apos;Order Item Quantity&apos; THEN [order_item_quantity]&#10;    //WHEN &apos;Queued Orders&apos; THEN STR([queued_orders])&#10;    WHEN &apos;Stacked Delivery&apos; THEN STR([is_stacked_delivery])&#10;    WHEN &apos;Stacked Delivery Rank&apos; THEN [stacked_delivery_rank]&#10;    WHEN &apos;Stacked Intravendor&apos; THEN STR([is_stacked_intravendor])&#10;    WHEN &apos;Vehicle Type&apos; THEN [vehicle_type]&#10;    WHEN &apos;RLP Buckets&apos; THEN [rlp_buckets_min]&#10;    WHEN &apos;RDP Buckets&apos; THEN [rdp_buckets_min]&#10;    WHEN &apos;Checkout Buckets&apos; THEN [ckt_buckets_min]&#10;    WHEN &apos;OTP Buckets&apos; THEN [otp_buckets_min]&#10;    WHEN &apos;Actual DT Buckets&apos; THEN [actual_dt_buckets_min]&#10;    WHEN &apos;RDP PDT vs RLP PDT Delta Buckets&apos; THEN [rdp_rlp_delta_buckets_min]&#10;    WHEN &apos;Checkout PDT vs RLP PDT Delta Buckets&apos; THEN [ckt_rlp_delta_buckets_min]&#10;    WHEN &apos;Checkout Upper Limit vs RLP Upper Limit Delta Buckets&apos; THEN [upper_limit_ckt_rlp_delta_buckets_min]&#10;    WHEN &apos;Checkout Lower Limit vs RLP Lower Limit Delta Buckets&apos; THEN [lower_limit_ckt_rlp_delta_buckets_min]&#10;    WHEN &apos;Checkout PDT vs RDP PDT Delta Buckets&apos; THEN [ckt_rdp_delta_buckets_min]&#10;    WHEN &apos;Checkout Upper Limit vs RDP Upper Limit Delta Buckets&apos; THEN [upper_limit_ckt_rdp_delta_buckets_min]&#10;    WHEN &apos;Checkout Lower Limit vs RDP Lower Limit Delta Buckets&apos; THEN [lower_limit_ckt_rdp_delta_buckets_min]&#10;    WHEN &apos;OTP vs Checkout PDT Delta Buckets&apos; THEN [otp_ckt_delta_buckets_min]&#10;    WHEN &apos;OTP vs Checkout Range Delta Buckets&apos; THEN [otp_range_ckt_delta_buckets_min]&#10;    WHEN &apos;OTP vs RDP PDT Delta Buckets&apos; THEN [otp_rdp_delta_buckets_min]&#10;    WHEN &apos;OTP vs RDP Range Delta Buckets&apos; THEN [otp_range_rdp_delta_buckets_min]&#10;    WHEN &apos;OTP vs RLP PDT Delta Buckets&apos; THEN [otp_rdp_delta_buckets_min]&#10;    WHEN &apos;OTP vs RLP Range Delta Buckets&apos; THEN [otp_range_rdp_delta_buckets_min]&#10;    WHEN &apos;Actual DT vs OTP Delta Buckets&apos; THEN [actual_dt_otp_delta_buckets_min]&#10;    WHEN &apos;First OTP Request Delay Buckets&apos; THEN [Calculation_1427359659079843840]&#10;    WHEN &apos;None&apos; THEN &apos;&apos;&#10;&#10;END' />
      </column>
      <column caption='Dimension (C)' datatype='string' name='[Dimension (B) (copy)_5527113061086154821]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose Dimension (A) (copy) (copy)_140315290019028993]&#10;&#10;    WHEN &apos;Region&apos; THEN [region]&#10;    WHEN &apos;Entity&apos; THEN [entity_display_name]&#10;    WHEN &apos;Country&apos; THEN [country_name]&#10;    WHEN &apos;Week Day&apos; THEN [day_of_week_local]&#10;    WHEN &apos;Hour of Day&apos; THEN [hour_of_day_local]&#10;    WHEN &apos;Time Bucket&apos; THEN [Calculation_7001127161988063234]&#10;    WHEN &apos;Order Item Quantity&apos; THEN [order_item_quantity]&#10;    //WHEN &apos;Queued Orders&apos; THEN STR([queued_orders])&#10;    WHEN &apos;Stacked Delivery&apos; THEN STR([is_stacked_delivery])&#10;    WHEN &apos;Stacked Delivery Rank&apos; THEN [stacked_delivery_rank]&#10;    WHEN &apos;Stacked Intravendor&apos; THEN STR([is_stacked_intravendor])&#10;    WHEN &apos;Vehicle Type&apos; THEN [vehicle_type]&#10;    WHEN &apos;RLP Buckets&apos; THEN [rlp_buckets_min]&#10;    WHEN &apos;RDP Buckets&apos; THEN [rdp_buckets_min]&#10;    WHEN &apos;Checkout Buckets&apos; THEN [ckt_buckets_min]&#10;    WHEN &apos;OTP Buckets&apos; THEN [otp_buckets_min]&#10;    WHEN &apos;Actual DT Buckets&apos; THEN [actual_dt_buckets_min]&#10;    WHEN &apos;RDP PDT vs RLP PDT Delta Buckets&apos; THEN [rdp_rlp_delta_buckets_min]&#10;    WHEN &apos;Checkout PDT vs RLP PDT Delta Buckets&apos; THEN [ckt_rlp_delta_buckets_min]&#10;    WHEN &apos;Checkout Upper Limit vs RLP Upper Limit Delta Buckets&apos; THEN [upper_limit_ckt_rlp_delta_buckets_min]&#10;    WHEN &apos;Checkout Lower Limit vs RLP Lower Limit Delta Buckets&apos; THEN [lower_limit_ckt_rlp_delta_buckets_min]&#10;    WHEN &apos;Checkout PDT vs RDP PDT Delta Buckets&apos; THEN [ckt_rdp_delta_buckets_min]&#10;    WHEN &apos;Checkout Upper Limit vs RDP Upper Limit Delta Buckets&apos; THEN [upper_limit_ckt_rdp_delta_buckets_min]&#10;    WHEN &apos;Checkout Lower Limit vs RDP Lower Limit Delta Buckets&apos; THEN [lower_limit_ckt_rdp_delta_buckets_min]&#10;    WHEN &apos;OTP vs Checkout PDT Delta Buckets&apos; THEN [otp_ckt_delta_buckets_min]&#10;    WHEN &apos;OTP vs Checkout Range Delta Buckets&apos; THEN [otp_range_ckt_delta_buckets_min]&#10;    WHEN &apos;OTP vs RDP PDT Delta Buckets&apos; THEN [otp_rdp_delta_buckets_min]&#10;    WHEN &apos;OTP vs RDP Range Delta Buckets&apos; THEN [otp_range_rdp_delta_buckets_min]&#10;    WHEN &apos;OTP vs RLP PDT Delta Buckets&apos; THEN [otp_rdp_delta_buckets_min]&#10;    WHEN &apos;OTP vs RLP Range Delta Buckets&apos; THEN [otp_range_rdp_delta_buckets_min]&#10;    WHEN &apos;Actual DT vs OTP Delta Buckets&apos; THEN [actual_dt_otp_delta_buckets_min]&#10;    WHEN &apos;First OTP Request Delay Buckets&apos; THEN [Calculation_1427359659079843840]&#10;    WHEN &apos;None&apos; THEN &apos;&apos;&#10;&#10;END' />
      </column>
      <column caption='Dimension   ' datatype='string' hidden='true' name='[Dimension (copy)_1620803337016680451]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose Dimension (copy)_1620803337016586242]&#10;&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;City&apos; THEN [city_name]&#10;WHEN &apos;Time Bucket&apos; THEN [Calculation_7001127161988063234]&#10;WHEN &apos;None&apos; THEN &apos;&apos;&#10;&#10;END' />
      </column>
      <column caption='Jump Magnitude Colour' datatype='string' name='[Jump Magnitude PDT - Colour (copy)_6530782431815413763]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS( [Bucket Delta (copy)_6530782431808557056], &apos;No Jump&apos;) THEN &apos;No Jump&apos;&#10;  ELSEIF CONTAINS( [Bucket Delta (copy)_6530782431808557056], &apos;(0 ; 1]&apos;) THEN &apos;Small Jump&apos;&#10;  ELSEIF CONTAINS( [Bucket Delta (copy)_6530782431808557056], &apos;(1 ; 2]&apos;) THEN &apos;Small Jump&apos;&#10;  ELSEIF CONTAINS( [Bucket Delta (copy)_6530782431808557056], &apos;(2 ; 3]&apos;) THEN &apos;Small Jump&apos;&#10;  ELSEIF CONTAINS( [Bucket Delta (copy)_6530782431808557056], &apos;(3 ; 4]&apos;) THEN &apos;Small Jump&apos;&#10;  ELSEIF CONTAINS( [Bucket Delta (copy)_6530782431808557056], &apos;(4 ; 5]&apos;) THEN &apos;Small Jump&apos;&#10;  ELSEIF CONTAINS( [Bucket Delta (copy)_6530782431808557056], &apos;[-1 ; 0)&apos;) THEN &apos;Small Jump&apos;&#10;  ELSEIF CONTAINS( [Bucket Delta (copy)_6530782431808557056], &apos;[-2 ; -1)&apos;) THEN &apos;Small Jump&apos;&#10;  ELSEIF CONTAINS( [Bucket Delta (copy)_6530782431808557056], &apos;[-3 ; -2)&apos;) THEN &apos;Small Jump&apos;&#10;  ELSEIF CONTAINS( [Bucket Delta (copy)_6530782431808557056], &apos;[-4 ; -3)&apos;) THEN &apos;Small Jump&apos;&#10;  ELSEIF CONTAINS( [Bucket Delta (copy)_6530782431808557056], &apos;[-5 ; -4)&apos;) THEN &apos;Small Jump&apos;&#10;  ELSEIF ISNULL( [Bucket Delta (copy)_6530782431808557056]) THEN &apos;Null&apos;&#10;ELSE &apos;Big Jump&apos;&#10;END' />
      </column>
      <column caption='KPI (2) ' datatype='real' name='[KPI (1) (copy)_5527113061059031097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose KPI (1) (copy)_4901323783547408387]&#10;&#10;    WHEN &apos;RLP&apos; THEN [Calculation_5418815565605011456]&#10;    WHEN &apos;RDP&apos; THEN [Avg Actual Delivery Time (copy)_4824903364635017217]&#10;    WHEN &apos;Checkout&apos; THEN [Avg OTP Delivery Time (copy)_1824380069668937730]&#10;    WHEN &apos;OTP&apos; THEN [Avg Actual Delivery Time (copy)_4824903364639866882]&#10;    WHEN &apos;Actual DT&apos; THEN [Calculation_4824903364634845184]&#10;    WHEN &apos;Prep Time RLP&apos; THEN [Avg Driving Time RLP (copy)_4824903364664811537]&#10;    WHEN &apos;Prep Buffer RLP&apos; THEN [Avg Prep Time RLP (copy)_4824903364664954898]&#10;    WHEN &apos;Courier Delay RLP&apos; THEN [Calculation_4824903364655517709]&#10;    WHEN &apos;Driving Time RLP&apos; THEN [Avg Courier Delay RLP (copy)_4824903364655616014]&#10;    WHEN &apos;Delivery Duration Buffer RLP&apos; THEN [Avg Prep Buffer RLP (copy)_1824380069666684928]&#10;    WHEN &apos;Walk Out Duration RLP&apos; THEN [Avg Prep Time RLP (copy)_5683331674796175361]&#10;    WHEN &apos;Prep Time RDP&apos; THEN [Avg Prep Time RLP (copy)_174233019376885766]&#10;    WHEN &apos;Prep Buffer RDP&apos; THEN [Avg Prep Buffer RLP (copy)_174233019365924867]&#10;    WHEN &apos;Courier Delay RDP&apos; THEN [Avg Courier Delay RLP (copy)_174233019377197065]&#10;    WHEN &apos;Driving Time RDP&apos; THEN [Avg Driving Time RLP (copy)_174233019377430539]&#10;    WHEN &apos;Delivery Duration Buffer RDP&apos; THEN [Avg Delivery Duration Buffer RLP (copy)_174233019376500740]&#10;    WHEN &apos;Walk Out Duration RDP&apos; THEN [Avg Prep Time RDP (copy)_5683331674796408834]&#10;    WHEN &apos;Prep Time Checkout&apos; THEN [Avg Prep Time RDP (copy)_759700971217670153]&#10;    WHEN &apos;Prep Buffer Checkout&apos; THEN [Avg Prep Buffer RLP (copy)_174233019377090568]&#10;    WHEN &apos;Courier Delay Checkout&apos; THEN [Avg Courier Delay RLP (copy) (copy)_174233019377205258]&#10;    WHEN &apos;Driving Time Checkout&apos; THEN [Avg Driving Time RLP (copy) (copy)_174233019377438732]&#10;    WHEN &apos;Delivery Duration Buffer Checkout&apos; THEN [Avg Delivery Duration Buffer RLP (copy) (copy)_174233019376508933]&#10;    WHEN &apos;Walk Out Duration Checkout&apos; THEN [Avg Prep Time Checkout (copy)_5683331674796556291]&#10;    WHEN &apos;At Vendor Time&apos; THEN [Avg Driving Distance (copy)_4824903364655865872]&#10;    WHEN &apos;RDP PDT vs RLP PDT Delta&apos; THEN [Calculation_1427359659081646081]&#10;    WHEN &apos;RDP Upper Limit vs RLP Upper Limit Delta&apos; THEN [Checkout vs RLP Delta Upper Limit (copy)_4272930889014206478]&#10;    WHEN &apos;RDP Lower Limit vs RLP Lower Limit Delta&apos; THEN [Checkout vs RLP Delta Lower Limit (copy)_4272930889014181901]&#10;    WHEN &apos;Checkout PDT vs RDP PDT Delta&apos; THEN [RDP vs RLP Delta (copy)_1824380069670445059]&#10;    WHEN &apos;Checkout Upper Limit vs RDP Upper Limit Delta&apos; THEN [Checkout vs RDP Delta (copy)_4272930889013215241]&#10;    WHEN &apos;Checkout Lower Limit vs RDP Lower Limit Delta&apos; THEN [Checkout vs RDP Delta Upper Limit (copy)_4272930889013776394]&#10;    WHEN &apos;Checkout PDT vs RLP PDT Delta&apos; THEN [Checkout vs RDP Delta (copy)_6651464816956755974]&#10;    WHEN &apos;Checkout Upper Limit vs RLP Upper Limit Delta&apos; THEN [Checkout vs RDP Delta Upper Limit (copy)_4272930889013973004]&#10;    WHEN &apos;Checkout Lower Limit vs RLP Lower Limit Delta&apos; THEN [Checkout vs RDP Delta Lower Limit (copy)_4272930889013964811]&#10;    WHEN &apos;OTP vs Checkout PDT Delta&apos; THEN [OTP vs Checkout Delta  (copy)_1824380069671608324]&#10;    WHEN &apos;OTP vs Checkout Range Delta&apos; THEN [OTP vs Checkout Delta (copy)_4272930889012441096]&#10;    WHEN &apos;Actual DT vs OTP Delta&apos; THEN [Actual DT vs OTP Delta (copy)_1824380069672128517]&#10;    WHEN &apos;Actual DT vs Checkout PDT Delta&apos; THEN [Actual DT vs CKT Range Delta (copy)_176766291944988687]&#10;    WHEN &apos;Actual DT vs Checkout Range Delta&apos; THEN [Actual DT vs RLP Range Delta (copy)_176766291944804366]&#10;    WHEN &apos;Actual DT vs RDP PDT Delta&apos; THEN [Actual DT vs RLP PDT Delta (copy)_176766291939061772]&#10;    WHEN &apos;Actual DT vs RDP Range Delta&apos; THEN [Actual DT vs RLP Range Delta (copy)_176766291944730637]&#10;    WHEN &apos;Actual DT vs RLP PDT Delta&apos; THEN [Calculation_1427359659083005956]&#10;    WHEN &apos;Actual DT vs RLP Range Delta&apos; THEN [Actual DT vs RLP PDT Delta (copy)_176766291895398408]&#10;END' />
