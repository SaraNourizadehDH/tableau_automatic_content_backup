    <worksheet name='Range was chosen'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tes_tracking_dashboard_v2' name='federated.1xl1wcd1oaj1qw1160mpo0gdo7hf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Delta Pages' datatype='string' name='[Choose Page (copy)_6651464817088086030]' param-domain-type='list' role='measure' type='nominal' value='&quot;RDP (PDT) vs RLP (PDT) Delta&quot;'>
              <calculation class='tableau' formula='&quot;RDP (PDT) vs RLP (PDT) Delta&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xl1wcd1oaj1qw1160mpo0gdo7hf'>
            <column caption='Empty String' datatype='string' name='[Calculation_424393949065707527]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;&apos;' />
            </column>
            <column caption='Range was chosen text' datatype='string' name='[Components granularity unavailable text (copy)_176766291834552320]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Page (copy)_6651464817088086030]&#10;&#10;WHEN &apos;OTP (PDT) vs Checkout (Range) Delta&apos; THEN&#10;&apos;* When comparing a point-PDT vs. Range-PDT, the jump is calculated relative to the relevant limit. If the PDT falls within the range, the jump is considered to be 0.&#10;For example: If the PDT at the order transaction page is 8 minutes and the range shown at checkout is 10-15 minutes, the jump is -2. If the PDT is 12 minutes, it is considered as &quot;No Jump&quot;&#10;* No jump means the delta is 0 across the pages.&apos;&#10;&#10;WHEN &apos;OTP (PDT) vs RDP (Range) Delta&apos; THEN&#10;&apos;* When comparing a point-PDT vs. Range-PDT, the jump is calculated relative to the relevant limit. If the PDT falls within the range, the jump is considered to be 0.&#10;For example: If the PDT at the order transaction page is 8 minutes and the range shown on the restaurant details page is 10-15 minutes, the jump is -2. If the PDT is 12 minutes, it is considered as &quot;No Jump&quot;.&#10;* No jump means the delta is 0 across the pages.&apos;&#10;&#10;WHEN &apos;OTP (PDT) vs RLP (Range) Delta&apos; THEN&#10;&apos;* When comparing a point-PDT vs. Range-PDT, the jump is calculated relative to the relevant limit. If the PDT falls within the range, the jump is considered to be 0.&#10;For example: If the PDT at the order transaction page is 8 minutes and the range shown on the restaurant listing page is 10-15 minutes, the jump is -2. If the PDT is 12 minutes, it is considered as &quot;No Jump&quot;.&#10;* No jump means the delta is 0 across the pages.&apos;&#10;&#10;WHEN &apos;Actual DT (PDT) vs Checkout (Range) Delta&apos; THEN&#10;&apos;* When comparing a point-PDT vs. Range-PDT, the jump is calculated relative to the relevant limit. If the PDT falls within the range, the jump is considered to be 0.&#10;For example: If the actual delivery time is 8 minutes and the range shown at checkout is 10-15 minutes, the jump is -2. If the PDT is 12 minutes, it is considered as &quot;No Jump&quot;.&#10;* No jump means the delta is 0 across the pages.&apos;&#10;&#10;WHEN &apos;Actual DT (PDT) vs RDP (Range) Delta&apos; THEN&#10;&apos;* When comparing a point-PDT vs. Range-PDT, the jump is calculated relative to the relevant limit. If the PDT falls within the range, the jump is considered to be 0.&#10;For example: If the actual delivery time is 8 minutes and the range shown on the restaurant details page is 10-15 minutes, the jump is -2. If the PDT is 12 minutes, it is considered as &quot;No Jump&quot;.&#10;* No jump means the delta is 0 across the pages.&apos;&#10;&#10;WHEN &apos;Actual DT (PDT) vs RLP (Range) Delta&apos; THEN&#10;&apos;* When comparing a point-PDT vs. Range-PDT, the jump is calculated relative to the relevant limit. If the PDT falls within the range, the jump is considered to be 0.&#10;For example: If actual delivery time is 8 minutes and the range shown on the restaurant listing page is 10-15 minutes, the jump is -2. If the PDT is 12 minutes, it is considered as &quot;No Jump&quot;.&#10;* No jump means the delta is 0 across the pages.&apos;&#10;&#10;ELSE &apos;No jump means the delta is 0 across the pages.&apos;&#10;&#10;END' />
            </column>
            <column-instance column='[Calculation_424393949065707527]' derivation='None' name='[none:Calculation_424393949065707527:nk]' pivot='key' type='nominal' />
            <column-instance column='[Components granularity unavailable text (copy)_176766291834552320]' derivation='None' name='[none:Components granularity unavailable text (copy)_176766291834552320:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='stroke-size' value='0' />
            <format attr='tick-color' value='#00000000' />
          </style-rule>
          <style-rule element='cell'>
            <format attr='width' value='14' />
            <format attr='height' field='[federated.1xl1wcd1oaj1qw1160mpo0gdo7hf].[none:Components granularity unavailable text (copy)_176766291834552320:nk]' value='208' />
            <format attr='font-weight' value='normal' />
          </style-rule>
          <style-rule element='header'>
            <format attr='width' field='[federated.1xl1wcd1oaj1qw1160mpo0gdo7hf].[none:Components granularity unavailable text (copy)_176766291834552320:nk]' value='1648' />
            <format attr='band-color' scope='rows' value='#00000000' />
            <format attr='border-width' data-class='subtotal' value='0' />
            <format attr='border-style' data-class='subtotal' value='none' />
            <format attr='text-align' data-class='total' field='[federated.1xl1wcd1oaj1qw1160mpo0gdo7hf].[none:Components granularity unavailable text (copy)_176766291834552320:nk]' value='left' />
            <format attr='vertical-align' data-class='total' field='[federated.1xl1wcd1oaj1qw1160mpo0gdo7hf].[none:Components granularity unavailable text (copy)_176766291834552320:nk]' value='top' />
          </style-rule>
          <style-rule element='label'>
            <format attr='font-weight' value='bold' />
