    <worksheet name='CKT buckets - Conversion Rate Tooltip'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tes_tracking_dashboard_v2' name='federated.1xl1wcd1oaj1qw1160mpo0gdo7hf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Breakfast End' datatype='string' datatype-customized='true' name='[Breakfast Start (copy)_7001127161989939206]' param-domain-type='any' role='measure' type='nominal' value='&quot;09:00&quot;'>
              <calculation class='tableau' formula='&quot;09:00&quot;' />
            </column>
            <column caption='Choose PDT / Component' datatype='string' name='[Choose Delta Pages - Components (copy)_6530782431808884738]' param-domain-type='list' role='measure' type='nominal' value='&quot;Promised Delivery Time (Total)&quot;'>
              <calculation class='tableau' formula='&quot;Promised Delivery Time (Total)&quot;' />
            </column>
            <column caption='Choose Delta Pages' datatype='string' name='[Choose Page (copy)_6651464817088086030]' param-domain-type='list' role='measure' type='nominal' value='&quot;RDP (PDT) vs RLP (PDT) Delta&quot;'>
              <calculation class='tableau' formula='&quot;RDP (PDT) vs RLP (PDT) Delta&quot;' />
            </column>
            <column caption='Breakfast Start' datatype='string' datatype-customized='true' name='[Dinner Start (copy)_7001127161989849093]' param-domain-type='any' role='measure' type='nominal' value='&quot;07:00&quot;'>
              <calculation class='tableau' formula='&quot;07:00&quot;' />
            </column>
            <column caption='Dinner End' datatype='string' datatype-customized='true' name='[Dinner start (copy)_7001127161988632580]' param-domain-type='any' role='measure' type='nominal' value='&quot;23:00&quot;'>
              <calculation class='tableau' formula='&quot;23:00&quot;' />
            </column>
            <column caption='Lunch End' datatype='string' datatype-customized='true' name='[Lunch start (copy)_7001127161987661825]' param-domain-type='any' role='measure' type='nominal' value='&quot;15:00&quot;'>
              <calculation class='tableau' formula='&quot;15:00&quot;' />
            </column>
            <column caption='Dinner Start' datatype='string' datatype-customized='true' name='[Lunch start (copy)_7001127161988554755]' param-domain-type='any' role='measure' type='nominal' value='&quot;18:00&quot;'>
              <calculation class='tableau' formula='&quot;18:00&quot;' />
            </column>
            <column caption='Lunch Start' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='any' role='measure' type='nominal' value='&quot;11:00&quot;'>
              <calculation class='tableau' formula='&quot;11:00&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xl1wcd1oaj1qw1160mpo0gdo7hf'>
            <column caption='Conversion Rate' datatype='real' name='[Calculation_424393949058072579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(100,100*(SUM([number_of_orders])/SUM([number_of_sessions])))' />
            </column>
            <column caption='Empty String' datatype='string' name='[Calculation_424393949065707527]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;&apos;' />
            </column>
            <column caption='MIN(100,[Conversion Rate])' datatype='real' name='[Calculation_424393949071761417]' role='measure' type='quantitative' user:unnamed='CKT buckets - Conversion Rate Tooltip'>
              <calculation class='tableau' formula='MIN(100,[Calculation_424393949058072579])' />
            </column>
            <column caption='Dynamic Time Buckets' datatype='string' name='[Calculation_7001127161988063234]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [hour_of_day_local] &gt;= [Parameters].[Dinner Start (copy)_7001127161989849093]&#10;  AND [hour_of_day_local] &lt;= [Parameters].[Breakfast Start (copy)_7001127161989939206]&#10;   THEN &apos;Breakfast&apos;&#10;ELSEIF [hour_of_day_local] &gt;= [Parameters].[Parameter 2]&#10;  AND [hour_of_day_local] &lt;= [Parameters].[Lunch start (copy)_7001127161987661825]&#10;    THEN &apos;Lunch&apos; &#10;ELSEIF [hour_of_day_local] &gt;= [Parameters].[Lunch start (copy)_7001127161988554755]&#10;  AND [hour_of_day_local] &lt;= [Parameters].[Dinner start (copy)_7001127161988632580]&#10;    THEN &apos;Dinner&apos;&#10;ELSE &apos;Off-peak&apos; &#10;END' />
            </column>
            <column caption='Components/PDT View Exists' datatype='boolean' name='[PDT is chosen (copy)_5434578118311170052]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// If the chosen &quot;page&quot; is PDT the view exists.&#10;// if not, then the view exists only if the delta page is in the list.&#10;[Parameters].[Choose Delta Pages - Components (copy)_6530782431808884738] = &apos;Promised Delivery Time (Total)&apos;&#10;OR&#10;[Parameters].[Choose Page (copy)_6651464817088086030] IN (&apos;RDP (PDT) vs RLP (PDT) Delta&apos;, &apos;Checkout (PDT) vs RLP (PDT) Delta&apos;, &apos;Checkout (PDT) vs RDP (PDT) Delta&apos;)' />
            </column>
            <column caption='Ckt Buckets Min' datatype='string' name='[ckt_buckets_min]' role='dimension' type='nominal' />
            <column caption='Delta' datatype='string' name='[delta]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;absolute&quot;' value='Absolute Value' />
                <alias key='&quot;non_absolute&quot;' value='Non-Absolute Value' />
              </aliases>
            </column>
            <column caption='Hour Of Day Local' datatype='string' name='[hour_of_day_local]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_424393949065707527]' derivation='None' name='[none:Calculation_424393949065707527:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_7001127161988063234]' derivation='None' name='[none:Calculation_7001127161988063234:nk]' pivot='key' type='nominal' />
            <column-instance column='[PDT is chosen (copy)_5434578118311170052]' derivation='None' name='[none:PDT is chosen (copy)_5434578118311170052:nk]' pivot='key' type='nominal' />
            <column-instance column='[ckt_buckets_min]' derivation='None' name='[none:ckt_buckets_min:nk]' pivot='key' type='nominal' />
