    <dashboard name='OTP Details'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/TESTrackingDashboard/OTPDetails?rev=' id='OTPDetails' path='/t/GlobalStandardReporting/workbooks/TESTrackingDashboard-WIP853' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1400' maxwidth='1920' minheight='1400' minwidth='1920' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='tes_tracking_dashboard_v2' name='federated.1xl1wcd1oaj1qw1160mpo0gdo7hf' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Choose Dimension OTP' datatype='string' name='[Choose Dimension (copy)_1620803337016586242]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
