    <worksheet name='RLP buckets'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='10'>RLP Buckets (min)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tes_tracking_dashboard_v2' name='federated.1xl1wcd1oaj1qw1160mpo0gdo7hf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose PDT / Component' datatype='string' name='[Choose Delta Pages - Components (copy)_6530782431808884738]' param-domain-type='list' role='measure' type='nominal' value='&quot;Promised Delivery Time (Total)&quot;'>
              <calculation class='tableau' formula='&quot;Promised Delivery Time (Total)&quot;' />
            </column>
            <column caption='Choose Delta Pages' datatype='string' name='[Choose Page (copy)_6651464817088086030]' param-domain-type='list' role='measure' type='nominal' value='&quot;RDP (PDT) vs RLP (PDT) Delta&quot;'>
              <calculation class='tableau' formula='&quot;RDP (PDT) vs RLP (PDT) Delta&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xl1wcd1oaj1qw1160mpo0gdo7hf'>
            <column caption='RLP Buckets by component' datatype='string' name='[Bucket Delta - Components (copy)_6530782431830953989]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Delta Pages - Components (copy)_6530782431808884738] &#10;    WHEN &quot;Promised Delivery Time (Total)&quot; THEN [rlp_buckets_min]&#10;    WHEN &quot;Preparation Time&quot; THEN [prep_time_rlp_buckets_min]&#10;    WHEN  &quot;Preparation Time Buffer&quot; THEN [prep_buffer_rlp_buckets_min]&#10;    WHEN &quot;Courier Delay&quot; THEN [courier_delay_rlp_buckets_min]&#10;    WHEN &quot;Driving Time&quot; THEN [driving_time_rlp_buckets_min]&#10;    WHEN &quot;Delivery Duration Buffer&quot; THEN [delivery_duration_buffer_rlp_buckets_min]&#10;    WHEN &quot;Walk Out Duration&quot; THEN [walk_out_duration_rlp_buckets_min]&#10;END' />
            </column>
            <column caption='Total Number of Orders/Sessions' datatype='integer' name='[Calculation_5527113061145841740]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [has_transaction] = TRUE THEN [number_of_orders] ELSE [number_of_sessions] END)' />
            </column>
            <column caption='Components/PDT View Exists' datatype='boolean' name='[PDT is chosen (copy)_5434578118311170052]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// If the chosen &quot;page&quot; is PDT the view exists.&#10;// if not, then the view exists only if the delta page is in the list.&#10;[Parameters].[Choose Delta Pages - Components (copy)_6530782431808884738] = &apos;Promised Delivery Time (Total)&apos;&#10;OR&#10;[Parameters].[Choose Page (copy)_6651464817088086030] IN (&apos;RDP (PDT) vs RLP (PDT) Delta&apos;, &apos;Checkout (PDT) vs RLP (PDT) Delta&apos;, &apos;Checkout (PDT) vs RDP (PDT) Delta&apos;)' />
