            <column caption='Rdp Buckets Min' datatype='string' name='[rdp_buckets_min]' role='dimension' type='nominal' />
            <column caption='Walk Out Duration Rdp Buckets Min' datatype='string' name='[walk_out_duration_rdp_buckets_min]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1xl1wcd1oaj1qw1160mpo0gdo7hf].[none:PDT is chosen (copy)_5434578118311170052:nk]'>
            <groupfilter function='member' level='[none:PDT is chosen (copy)_5434578118311170052:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
