                    <zone h='5029' id='1897' is-fixed='true' type-v2='layout-basic' w='99166' x='417' y='14742'>
                      <zone h='2744' id='1896' param='horz' type-v2='layout-flow' w='10312' x='417' y='14742'>
                        <zone h='2743' id='1782' mode='checkdropdown' name='Overview - PointPDT - Delta' param='[federated.1xl1wcd1oaj1qw1160mpo0gdo7hf].[none:has_transaction:nk]' type-v2='filter' values='database' w='10312' x='417' y='14742'>
                          <zone-style>
                            <format attr='border-color' value='#000000' />
                            <format attr='border-style' value='none' />
