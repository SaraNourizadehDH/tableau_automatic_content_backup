    <worksheet name='first OTP request delay sheet'>
      <table>
        <view>
          <datasources>
            <datasource caption='tes_tracking_dashboard_v2' name='federated.1xl1wcd1oaj1qw1160mpo0gdo7hf' />
          </datasources>
          <datasource-dependencies datasource='federated.1xl1wcd1oaj1qw1160mpo0gdo7hf'>
            <column caption='Avg OTP Delivery Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Actual Delivery Time (copy)_4824903364639866882]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promised_delivery_time_otp_sum]) / SUM([promised_delivery_time_otp_count])' />
            </column>
            <column caption='First OTP Request Delay Buckets (min)' datatype='string' name='[Calculation_1427359659079843840]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [first_otp_request_and_order_creation_request_delay_buckets_min] = &apos;]40 ; ∞]&apos;&#10;    THEN &apos;]40 ; ∞[&apos;&#10;ELSE [first_otp_request_and_order_creation_request_delay_buckets_min]&#10;END' />
            </column>
            <column caption='Cumulative % of Orders' datatype='real' default-format='p0.0%' name='[Calculation_1620803337019138054]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM( SUM([number_of_orders]) / TOTAL(SUM([number_of_orders])) )'>
                <table-calc ordering-type='Rows' />
