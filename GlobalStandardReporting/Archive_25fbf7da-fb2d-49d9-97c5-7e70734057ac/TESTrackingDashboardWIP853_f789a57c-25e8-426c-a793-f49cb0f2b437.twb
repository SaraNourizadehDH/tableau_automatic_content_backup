                    <format attr='background-color' value='#ffffff' />
                  </zone-style>
                </zone>
                <zone fixed-size='24' forceUpdate='true' h='1828' id='1445' type-v2='text' w='99166' x='417' y='22628'>
                  <formatted-text>
                    <run bold='true' fontcolor='#c11c2f' fontsize='8'>NOTE: The report has data only for PY and Pandora entities, since the data received incorrectly for the other entities. The applicable teams are working on fixing the data sources and the other entities will be included once the issue is fixed.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
