      <table>
        <view>
          <datasources>
            <datasource caption='tes_tracking_dashboard_v2' name='federated.1xl1wcd1oaj1qw1160mpo0gdo7hf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose PDT / Component' datatype='string' name='[Choose Delta Pages - Components (copy)_6530782431808884738]' param-domain-type='list' role='measure' type='nominal' value='&quot;Promised Delivery Time (Total)&quot;'>
              <calculation class='tableau' formula='&quot;Promised Delivery Time (Total)&quot;' />
            </column>
            <column caption='Choose Delta Pages' datatype='string' name='[Choose Page (copy)_6651464817088086030]' param-domain-type='list' role='measure' type='nominal' value='&quot;RDP (PDT) vs RLP (PDT) Delta&quot;'>
              <calculation class='tableau' formula='&quot;RDP (PDT) vs RLP (PDT) Delta&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xl1wcd1oaj1qw1160mpo0gdo7hf'>
            <column caption='Total Number of Orders/Sessions' datatype='integer' name='[Calculation_5527113061145841740]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [has_transaction] = TRUE THEN [number_of_orders] ELSE [number_of_sessions] END)' />
            </column>
            <column caption='Components/PDT View Exists' datatype='boolean' name='[PDT is chosen (copy)_5434578118311170052]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// If the chosen &quot;page&quot; is PDT the view exists.&#10;// if not, then the view exists only if the delta page is in the list.&#10;[Parameters].[Choose Delta Pages - Components (copy)_6530782431808884738] = &apos;Promised Delivery Time (Total)&apos;&#10;OR&#10;[Parameters].[Choose Page (copy)_6651464817088086030] IN (&apos;RDP (PDT) vs RLP (PDT) Delta&apos;, &apos;Checkout (PDT) vs RLP (PDT) Delta&apos;, &apos;Checkout (PDT) vs RDP (PDT) Delta&apos;)' />
            </column>
            <column caption='CKT Buckets by component' datatype='string' name='[RDP Buckets Delta - Components (copy)_6530782431838691336]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Choose Delta Pages - Components (copy)_6530782431808884738] &#10;    WHEN &quot;Promised Delivery Time (Total)&quot; THEN [ckt_buckets_min]&#10;    WHEN &quot;Preparation Time&quot; THEN [prep_time_ckt_buckets_min]&#10;    WHEN  &quot;Preparation Time Buffer&quot; THEN [prep_buffer_ckt_buckets_min]&#10;    WHEN &quot;Courier Delay&quot; THEN [courier_delay_ckt_buckets_min]&#10;    WHEN &quot;Driving Time&quot; THEN [driving_time_ckt_buckets_min]&#10;    WHEN &quot;Delivery Duration Buffer&quot; THEN [delivery_duration_buffer_ckt_buckets_min]&#10;    WHEN &quot;Walk Out Duration&quot; THEN [walk_out_duration_ckt_buckets_min]&#10;END' />
            </column>
            <column caption='Ckt Buckets Min' datatype='string' name='[ckt_buckets_min]' role='dimension' type='nominal' />
            <column caption='Courier Delay Ckt Buckets Min' datatype='string' name='[courier_delay_ckt_buckets_min]' role='dimension' type='nominal' />
            <column caption='Delivery Duration Buffer Ckt Buckets Min' datatype='string' name='[delivery_duration_buffer_ckt_buckets_min]' role='dimension' type='nominal' />
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='Unknown' />
                <alias key='&quot;OWN_DELIVERY&quot;' value='Own Delivery' />
                <alias key='&quot;PICKUP&quot;' value='Pickup' />
                <alias key='&quot;VENDOR_DELIVERY&quot;' value='Vendor Delivery' />
              </aliases>
            </column>
            <column caption='Delta' datatype='string' name='[delta]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;absolute&quot;' value='Absolute Value' />
                <alias key='&quot;non_absolute&quot;' value='Non-Absolute Value' />
              </aliases>
            </column>
            <column caption='Driving Time Ckt Buckets Min' datatype='string' name='[driving_time_ckt_buckets_min]' role='dimension' type='nominal' />
            <column caption='Has Transaction' datatype='boolean' name='[has_transaction]' role='dimension' type='nominal' />
            <column-instance column='[PDT is chosen (copy)_5434578118311170052]' derivation='None' name='[none:PDT is chosen (copy)_5434578118311170052:nk]' pivot='key' type='nominal' />
            <column-instance column='[RDP Buckets Delta - Components (copy)_6530782431838691336]' derivation='None' name='[none:RDP Buckets Delta - Components (copy)_6530782431838691336:nk]' pivot='key' type='nominal' />
            <column-instance column='[delivery_type]' derivation='None' name='[none:delivery_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[delta]' derivation='None' name='[none:delta:nk]' pivot='key' type='nominal' />
            <column-instance column='[has_transaction]' derivation='None' name='[none:has_transaction:nk]' pivot='key' type='nominal' />
            <column caption='Number Of Orders' datatype='integer' name='[number_of_orders]' role='measure' type='quantitative' />
            <column caption='Number Of Sessions' datatype='integer' name='[number_of_sessions]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_5527113061145841740]' derivation='User' name='[pcto:usr:Calculation_5527113061145841740:qk:21]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.1xl1wcd1oaj1qw1160mpo0gdo7hf].[RDP Buckets Delta - Components (copy)_6530782431838691336]' ordering-type='Field' type='PctTotal' />
            </column-instance>
            <column caption='Prep Buffer Ckt Buckets Min' datatype='string' name='[prep_buffer_ckt_buckets_min]' role='dimension' type='nominal' />
            <column caption='Prep Time Ckt Buckets Min' datatype='string' name='[prep_time_ckt_buckets_min]' role='dimension' type='nominal' />
            <column caption='Walk Out Duration Ckt Buckets Min' datatype='string' name='[walk_out_duration_ckt_buckets_min]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1xl1wcd1oaj1qw1160mpo0gdo7hf].[none:PDT is chosen (copy)_5434578118311170052:nk]'>
            <groupfilter function='member' level='[none:PDT is chosen (copy)_5434578118311170052:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
