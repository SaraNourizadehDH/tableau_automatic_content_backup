                <zone forceUpdate='true' h='89167' id='2012' type-v2='text' w='69479' x='417' y='8611'>
                  <formatted-text>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='11'>What are RDP, RLP and CKT?</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>RLP - Restaurant Listing Page.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000'>RDP - Restaurant Details Page.</run>
                    <run>Æ&#10;</run>
