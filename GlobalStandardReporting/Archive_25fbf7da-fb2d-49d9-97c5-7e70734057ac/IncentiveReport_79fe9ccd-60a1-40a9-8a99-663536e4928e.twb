              <calculation class='tableau' formula='SUM([matched_vfd_amount])/SUM([matched_vfd_orders])' />
            </column>
            <column caption='SUM([matched_only_vfd_orders])/SUM([apac_only_vfd_orders])' datatype='real' name='[Calculation_1308858685360381964]' role='measure' type='quantitative' user:unnamed='Pandora DQ'>
              <calculation class='tableau' formula='SUM([matched_only_vfd_orders])/SUM([apac_only_vfd_orders])' />
