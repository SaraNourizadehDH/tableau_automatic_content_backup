      <datasource-dependencies datasource='Parameters'>
        <column caption='Entity Granularity ' datatype='string' name='[Entity Granularity (copy)_630644724283064326]' param-domain-type='list' role='measure' type='nominal' value='&quot;Managment Entity&quot;'>
          <calculation class='tableau' formula='&quot;Managment Entity&quot;' />
          <members>
            <member value='&quot;Global&quot;' />
            <member value='&quot;Segment&quot;' />
            <member value='&quot;Managment Entity&quot;' />
            <member value='&quot;Country&quot;' />
            <member value='&quot;Sub Entity&quot;' />
            <member value='&quot;City&quot;' />
          </members>
        </column>
        <column caption='Considering Joker as VFD' datatype='boolean' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='true'>
          <calculation class='tableau' formula='true' />
          <members>
            <member value='true' />
            <member value='false' />
          </members>
        </column>
        <column caption='Last N Periods' datatype='integer' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='6'>
          <calculation class='tableau' formula='6' />
          <range granularity='1' max='13' min='1' />
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0da153c0cukp9z1eni6uj00yeyvd'>
        <column caption='Cal_sub_entity' datatype='string' name='[Calculation_1126322158524522498]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IFNULL([sub_entity], &apos;Not definied&apos;)' />
        </column>
        <column caption='Cal_managment_entity' datatype='string' name='[Calculation_1126322158524813315]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IFNULL([management_entity], &apos;Not definied&apos;)' />
        </column>
        <column caption='Cal_is_key_account' datatype='boolean' name='[Calculation_1881941730014146560]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='case [is_key_account] when NULL&#13;&#10;THEN False&#13;&#10;ELSE&#13;&#10;[is_key_account]&#13;&#10;END' />
        </column>
        <column caption='Is Shop' datatype='boolean' name='[Calculation_2501186667585810457]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='case [is_shop] WHEN NULL then FALSE ELSE [is_shop]&#13;&#10;end' />
        </column>
        <column caption='Cal_city' datatype='string' name='[Calculation_2501186667865735201]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='LOWER(TRIM([city]))' />
        </column>
        <column caption='Cal_KA_Brand_Name' datatype='string' name='[Calculation_2619687643718656000]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='case [KA_brand_name] WHEN NULL then &quot;Others&quot;&#13;&#10;ELSE&#13;&#10;[KA_brand_name]&#13;&#10;END' />
        </column>
        <column caption='Vertical Type' datatype='string' name='[Calculation_2880614965148282890]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IFNULL([vertical_type], &apos;restaurants&apos;)' />
        </column>
        <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
