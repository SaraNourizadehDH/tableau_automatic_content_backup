      <column caption='AOV Of Incentivized Orders' datatype='real' name='[AOV (copy)_1832965083132932096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1] when true then sum(gmv_eur_deals_orders)/SUM(incentivised_orders_count)&#13;&#10;when false then sum([gmv_eur_deals_orders_without_joker])/SUM([incentivised_orders_count_without_joker])&#13;&#10;END' />
      </column>
      <column caption='AOV Of Non-Incentivized Orders (EUR)' datatype='real' name='[AOV Of Incentivized Orders (copy)_1832965083135164417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1832965083139936259])&#13;&#10;/&#13;&#10;([Calculation_1832965083140243460])' />
      </column>
      <column caption='AOV For VFD Orders' datatype='real' name='[AOV Of Incentivized Orders (copy)_2880614965145403400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1] when true then sum([gmv_eur_vfd_orders])/SUM([Calculation_246290648571322369])&#13;&#10;when false then sum([gmv_eur_vfd_orders_without_joker])/SUM([Calculation_246290648571322369])&#13;&#10;END' />
      </column>
      <column caption='Only DH Orders DQ' datatype='real' hidden='true' name='[Calculation_1109855873912287236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([matched_only_dh_orders])/SUM([apac_only_dh_orders])' />
      </column>
      <column caption='Only Cofounded Orders DQ' datatype='real' hidden='true' name='[Calculation_1109855873912479749]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([matched_only_cofounded__orders])/SUM([apac_only_cofounded_orders])' />
      </column>
      <column caption='Cal_sub_entity' datatype='string' name='[Calculation_1126322158524522498]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([sub_entity], &apos;Not definied&apos;)' />
      </column>
      <column caption='Cal_managment_entity' datatype='string' name='[Calculation_1126322158524813315]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([management_entity], &apos;Not definied&apos;)' />
      </column>
      <column caption='Pandora Filter' datatype='boolean' name='[Calculation_1308858685384949781]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//CONTAINS([Cal_sub_entity], &quot;FP&quot;)&#13;&#10;//OR &#13;&#10;//CONTAINS([Cal_sub_entity], &quot;FD&quot;)&#13;&#10;&#13;&#10;apac_orders != 0' />
      </column>
      <column caption='gmv_non_incentivized_orders' datatype='real' hidden='true' name='[Calculation_1832965083139936259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1] when true then sum([total_gmv_eur]) - sum([gmv_eur_deals_orders])&#13;&#10;when false then sum([total_gmv_eur]) - sum([gmv_eur_deals_orders_without_joker])&#13;&#10;END' />
      </column>
      <column caption='Non_incentivized_orders_count' datatype='integer' hidden='true' name='[Calculation_1832965083140243460]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1] when true then SUM([all_orders])- SUM([incentivised_orders_count])&#13;&#10;when false then SUM([all_orders])- SUM([incentivised_orders_count_without_joker])&#13;&#10;END' />
      </column>
      <column caption='Cal_is_key_account' datatype='boolean' name='[Calculation_1881941730014146560]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [is_key_account] when NULL&#13;&#10;THEN False&#13;&#10;ELSE&#13;&#10;[is_key_account]&#13;&#10;END' />
      </column>
      <column caption='VFD Orders' datatype='integer' name='[Calculation_246290648571322369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1] when true then [vfd_orders]&#13;&#10;WHEN FALSE then [vfd_orders_without_joker]&#13;&#10;END' />
      </column>
      <column caption='Only VFD Orders' datatype='integer' name='[Calculation_246290648574205954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case  [Parameters].[Parameter 1] when true then [only_VFD_orders]&#13;&#10;WHEN  false then [only_VFD_orders_without_joker]&#13;&#10;END' />
      </column>
      <column caption='Only Cofounded Orders' datatype='integer' name='[Calculation_246290648574799875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1] when true then [only_Cofounded_orders]&#13;&#10;WHEN  false then [only_Cofounded_orders_without_joker]&#13;&#10;end' />
      </column>
      <column caption='Total VFD (EUR)' datatype='real' name='[Calculation_246290648575197188]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1] WHEN  true then [VFD_Eur]&#13;&#10;when false then [VFD_Eur_without_joker]&#13;&#10;end' />
      </column>
      <column caption='Online Vendors' datatype='integer' name='[Calculation_2501186666948280320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([vendor_id])' />
      </column>
      <column caption='Vendor with VFD Orders' datatype='integer' name='[Calculation_2501186666948771841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] when true then COUNT( IF  [Calculation_246290648571322369] != 0 THEN [vendor_id] END) &#13;&#10;WHEN FALSE then COUNT( IF  [vfd_orders_without_joker] != 0 THEN [vendor_id] END) &#13;&#10;END' />
      </column>
      <column caption='Penetration on Online Vendors' datatype='real' name='[Calculation_2501186666952843269]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2501186666948771841]/[Calculation_2501186666948280320]' />
      </column>
      <column caption='Active Vendors' datatype='integer' name='[Calculation_2501186666953121798]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT( if [all_orders] != 0 then [vendor_id] END)' />
      </column>
      <column caption='AVG Discount %' datatype='real' name='[Calculation_2501186666954432520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] when true then SUM([Calculation_246290648575197188])/SUM([vfd_orders_gfv_eur])&#13;&#10;WHEN FALSE then SUM([VFD_Eur_without_joker])/SUM([vfd_orders_gfv_eur_without_joker])&#13;&#10;END' />
      </column>
      <column caption='Penetration on orders' datatype='real' name='[Calculation_2501186666957832202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1] when true then SUM([Calculation_246290648571322369])/SUM([all_orders])&#13;&#10;when false then SUM([vfd_orders_without_joker])/SUM([all_orders])&#13;&#10;END' />
      </column>
      <column caption='VFD/GMV %' datatype='real' name='[Calculation_2501186666959138827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_246290648575197188])/SUM([total_gmv_eur])' />
      </column>
      <column caption='DH Funding /GMV %' datatype='real' name='[Calculation_2501186666960400396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([DH_Funded_Eur])/SUM([total_gmv_eur])' />
      </column>
      <column caption='Total Funding / GMV %' datatype='real' name='[Calculation_2501186666960777229]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_246290648575197188])/SUM([total_gmv_eur])) + (SUM([DH_Funded_Eur])/SUM([total_gmv_eur]))' />
      </column>
      <column caption='% of only VFD orders' datatype='real' name='[Calculation_2501186667234328590]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_246290648574205954])/SUM([all_orders])' />
      </column>
      <column caption='% of Only DH orders' datatype='real' name='[Calculation_2501186667235561487]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([only_DH_orders])/SUM([all_orders])' />
      </column>
      <column caption='Is Shop' datatype='boolean' name='[Calculation_2501186667585810457]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [is_shop]&#13;&#10;WHEN   NULL THEN  False&#13;&#10;ELSE [is_shop]&#13;&#10;END' />
      </column>
      <column caption='Exclusion_date' datatype='boolean' name='[Calculation_2501186667607752730]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_period], TODAY()) &gt; 0' />
      </column>
      <column caption='Cal_city' datatype='string' name='[Calculation_2501186667865735201]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LOWER(TRIM([city]))' />
      </column>
      <column caption='Cal_Key_accont_brand_name' datatype='string' name='[Calculation_2512445677626548228]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [KA_brand_name] WHEN NULL then &quot;Others&quot;&#13;&#10;ELSE&#13;&#10;[KA_brand_name]&#13;&#10;END' />
      </column>
      <column caption='Cal_KA_Brand_Name' datatype='string' name='[Calculation_2619687643718656000]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [KA_brand_name] WHEN NULL then &quot;Others&quot;&#13;&#10;ELSE&#13;&#10;[KA_brand_name]&#13;&#10;END' />
      </column>
      <column caption='AOV Of all Orders' datatype='real' name='[Calculation_2727492549208735744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_gmv_eur])/SUM([all_orders])' />
      </column>
      <column caption='All_chains' datatype='integer' hidden='true' name='[Calculation_2880614965135314944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE  ([global_entity_id]):COUNTD([chain_id])}' />
      </column>
      <column caption='VFD Chains' datatype='integer' hidden='true' name='[Calculation_2880614965135511553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE  ([global_entity_id]) : COUNTD( IF  [Calculation_246290648571322369] != 0 THEN [chain_id] END)}' />
      </column>
      <column caption='Vertical Type' datatype='string' name='[Calculation_2880614965153583115]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([vertical_type], &apos;restaurants&apos;)' />
      </column>
      <column caption='Entity' datatype='string' name='[Calculation_630644724282707973]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Entity Granularity (copy)_630644724283064326] = &apos;Global&apos;                    THEN &apos;DH&apos;&#10;ELSEIF [Parameters].[Entity Granularity (copy)_630644724283064326] = &apos;Segment&apos;               THEN [segment]&#10;ELSEIF [Parameters].[Entity Granularity (copy)_630644724283064326] = &apos;Country&apos;               THEN [country_name]&#10;ELSEIF [Parameters].[Entity Granularity (copy)_630644724283064326] = &apos;Sub Entity&apos;            THEN [Calculation_1126322158524522498]&#10;ELSEIF [Parameters].[Entity Granularity (copy)_630644724283064326] = &apos;Managment Entity&apos;      THEN [Calculation_1126322158524813315]&#13;&#10;ELSEIF [Parameters].[Entity Granularity (copy)_630644724283064326] = &apos;City&apos;      THEN [Calculation_2501186667865735201]&#10;END' />
      </column>
      <column caption='Tests' datatype='string' datatype-customized='true' name='[Calculation_916201111598202880]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [report_period]&#13;&#10;WHEN DATETRUNC(&apos;month&apos;, TODAY()) THEN &apos;MTD&apos;&#13;&#10;ELSE STR([report_period]) &#13;&#10;end' />
      </column>
