      <column caption='Penetration on Active Vendors' datatype='real' name='[Penetration on Online Vendors (copy)_2501186666953502727]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2501186666948771841]/[Calculation_2501186666953121798]' />
