            <column caption='Cal_sub_entity' datatype='string' name='[Calculation_1126322158524522498]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([sub_entity], &apos;Not definied&apos;)' />
            </column>
            <column caption='Cal_managment_entity' datatype='string' name='[Calculation_1126322158524813315]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([management_entity], &apos;Not definied&apos;)' />
            </column>
            <column caption='sum([matched_orders])/SUM([apac_orders])' datatype='real' name='[Calculation_1308858685359239174]' role='measure' type='quantitative' user:unnamed='Pandora DQ'>
              <calculation class='tableau' formula='sum([matched_orders])/SUM([apac_orders])' />
            </column>
            <column caption='SUM([matched_vfd_orders])/sum([apac_vfd_orders])' datatype='real' name='[Calculation_1308858685359845384]' role='measure' type='quantitative' user:unnamed='Pandora DQ'>
              <calculation class='tableau' formula='SUM([matched_vfd_orders])/sum([apac_vfd_orders])' />
