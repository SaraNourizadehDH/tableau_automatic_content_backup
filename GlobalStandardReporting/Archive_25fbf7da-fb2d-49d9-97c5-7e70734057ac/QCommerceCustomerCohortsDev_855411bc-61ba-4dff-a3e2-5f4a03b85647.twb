    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Glossary'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/QCommerceCustomerCohortsDev/Glossary?rev=' id='Glossary' path='/t/GlobalStandardReporting/workbooks/QCommerceCustomerCohortsDev' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='800' maxwidth='900' minheight='800' minwidth='900' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98000' id='110' param='horz' type-v2='layout-flow' w='98222' x='889' y='1000'>
            <zone h='98000' id='6' type-v2='layout-basic' w='98222' x='889' y='1000'>
              <zone forceUpdate='true' h='9959' id='3' type-v2='text' w='98222' x='889' y='1000'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#da1d23' fontsize='22'>&lt;</run>
                  <run bold='true' fontalignment='1' fontcolor='#da1d23' fontsize='22'>[Parameters].[Parameter 1]</run>
                  <run bold='true' fontalignment='1' fontcolor='#da1d23' fontsize='22'>&gt; Customer Cohorts</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='3' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='74291' id='132' type-v2='text' w='98222' x='889' y='10959'>
                <formatted-text>
                  <run bold='true' fontcolor='#aa0000' fontsize='16'>Glossary</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000'>Acquisitions:</run>
                  <run fontcolor='#000000'> Customers that tried the Platform (First platform lifetime order) within a period of time</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000'>Trials:</run>
                  <run fontcolor='#000000'> Customers that tried a certain vertical / subvertical within a period of time</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000'>Retention Rate:</run>
                  <run fontcolor='#000000'> Active Customers from Trial Cohort  / Cohort Acquisition</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000'>Activity (Active Frequency)</run>
                  <run fontcolor='#000000'>: Successful Orders / Active Trial Cohort Base</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000'>Active Trial Cohort Base: All customers who tried QC/ DM/ LS in month 0 and came back in repective months</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000'>Frequency:</run>
                  <run fontcolor='#000000'> Successful Orders / Trial Cohort Base (both Active+Inactive)</run>
                  <run>Æ&#10;&#10;</run>
