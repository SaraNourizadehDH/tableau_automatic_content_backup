            </column>
            <column caption='batch_date_short' datatype='string' name='[Calculation_1875115977519095811]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(STR([batch_date]), 2) + &quot;-&quot; + MID(STR([batch_date]), 6,2)' />
            </column>
            <column caption='currency_code_switch' datatype='string' name='[Calculation_1875115977522012169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [currency_code_complete], &apos;&apos;)' />
            </column>
            <column caption='sg_avg_basket_lower_switch' datatype='real' name='[Calculation_1875115977530179594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [Calculation_1875115977530867727], [Calculation_1875115977530912784])' />
            </column>
            <column caption='sg_avg_basket_upper_switch' datatype='real' name='[Calculation_1875115977530277899]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [Calculation_1875115977530392588], [Calculation_1875115977530511373])' />
            </column>
            <column caption='sg_avg_basket_upper' datatype='real' name='[Calculation_1875115977530392588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1875115977531064337]) + SUM([sem_sg_avg_basket])' />
            </column>
            <column caption='sg_avg_basket_upper_EUR' datatype='real' name='[Calculation_1875115977530511373]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1875115977531191314]) + SUM([sem_sg_avg_basket_EUR])' />
            </column>
            <column caption='sg_avg_basket_lower' datatype='real' name='[Calculation_1875115977530867727]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1875115977531064337])-SUM([sem_sg_avg_basket])' />
            </column>
            <column caption='sg_avg_basket_lower_EUR' datatype='real' name='[Calculation_1875115977530912784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1875115977531191314]) - SUM([sem_sg_avg_basket_EUR])' />
            </column>
            <column caption='Sg Avg Basket Comp Only' datatype='real' name='[Calculation_1875115977531064337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [sg_avg_basket], NULL)' />
            </column>
            <column caption='Sg Avg Basket Comp Only EUR' datatype='real' name='[Calculation_1875115977531191314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [sg_avg_basket_EUR], NULL)' />
            </column>
            <column caption='Avg Basket Switch' datatype='real' name='[Calculation_1875115977532620820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [Calculation_1875115977532723221], [Calculation_1875115977532768278])' />
            </column>
            <column caption='Avg Basket - DH vs. Comp' datatype='real' name='[Calculation_1875115977532723221]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [sg_avg_basket], [avg_basket])' />
            </column>
            <column caption='Avg Basket - DH vs. Comp EUR' datatype='real' name='[Calculation_1875115977532768278]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [sg_avg_basket_EUR], [avg_basket_EUR])' />
            </column>
            <column caption='Brand Name DH' datatype='string' name='[Calculation_1875115977535041559]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [brand_name], &apos;DH&apos;)' />
            </column>
            <column caption='Order Date - End' datatype='date' default-format='*dd/mm/yyyy' name='[Calculation_2703426430137421828]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date]) THEN [batch_date]&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[order_date]))))&#10;ELSEIF [granularity] = &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [order_date]))&#10;END' />
            </column>
            <column aggregation='Min' caption='region_label_linechart' datatype='string' default-role='measure' name='[Calculation_3067021766769016843]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;weekly&apos; AND DATEDIFF(&apos;week&apos;, [order_date], TODAY()) &lt; 3 THEN [Calculation_1042442627312574468]&#10;ELSEIF [granularity] = &apos;monthly&apos; AND DATEDIFF(&apos;month&apos;, [order_date], TODAY()) &lt; 2 THEN [Calculation_1042442627312574468]&#10;ELSE &apos;&apos;&#10;END' />
              <aliases>
                <alias key='&quot;east_coast&quot;' value='East Coast' />
                <alias key='&quot;johor&quot;' value='Johor' />
                <alias key='&quot;klang_valley&quot;' value='Klang Valley' />
                <alias key='&quot;melaka_&amp;_n9&quot;' value='Melaka' />
                <alias key='&quot;north&quot;' value='North' />
                <alias key='&quot;sabah&quot;' value='Sabah' />
                <alias key='&quot;sarawak&quot;' value='Sarawak' />
              </aliases>
            </column>
            <column caption='Country Name Capitalized' datatype='string' name='[Calculation_934074761271492608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country_name] WHEN &apos;hong_kong&apos; THEN &apos;Hong Kong&apos;&#10;WHEN &apos;saudi_arabia&apos; THEN &apos;Saudi Arabia&apos;&#10;WHEN &apos;chile&apos; THEN NULL&#10;WHEN &apos;argentina&apos; THEN NULL&#10;ELSE UPPER(LEFT([country_name], 1)) + MID([country_name], 2)&#10;END' />
            </column>
