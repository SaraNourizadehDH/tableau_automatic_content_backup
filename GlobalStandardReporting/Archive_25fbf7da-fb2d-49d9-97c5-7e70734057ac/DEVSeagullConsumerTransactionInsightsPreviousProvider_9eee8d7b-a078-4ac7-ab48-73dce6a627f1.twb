      <aliases enabled='yes' />
      <column caption='Brand Display Name DH' datatype='string' name='[Brand Display Name (copy)_3979985851576049666]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [brand_display_name], &apos;DH&apos;)' />
      </column>
      <column caption='MY_PH_disclaimer' datatype='string' name='[Calculation_1148980915043708929]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Country (copy)_3979985851574317056] = &apos;Malaysia&apos; OR [Country (copy)_3979985851574317056] = &apos;Philippines&apos; THEN &apos;WARNING! The Orders and GMV for &apos; + [Country (copy)_3979985851574317056] + &apos; is temporarily unavailable due to issues with the externally provided data. We are working on improving the accuracy of the insights.&apos; END' />
      </column>
      <column caption='display_data' datatype='string' name='[Calculation_1149262390007754754]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Country (copy)_3979985851574317056]' />
      </column>
      <column caption='user_filter_4' datatype='boolean' name='[Calculation_2149131831806222336]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
      </column>
      <column caption='Order Date - End' datatype='date' default-format='*dd/mm/yyyy' name='[Calculation_2703426430137163779]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date]) THEN [batch_date]&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[order_date]))))&#10;ELSEIF [granularity] = &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [order_date]))&#10;END' />
      </column>
      <column caption='MtD_sign_long' datatype='string' name='[Calculation_3574802625109254164]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_3979985851578519557])&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column aggregation='Sum' caption='period_diff' datatype='integer' name='[Calculation_3979985851575062529]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='iif([granularity] = &apos;monthly&apos;, DATEDIFF(&apos;month&apos;, [order_date], [Parameters].[Parameter 3]),&#10;DATEDIFF(&apos;week&apos;, [order_date], [Parameters].[Parameter 3]))' />
      </column>
      <column caption='batch_date_short' datatype='string' name='[Calculation_3979985851578519557]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='RIGHT(STR([batch_date]), 2) + &quot;-&quot; + MID(STR([batch_date]), 6,2)' />
      </column>
      <column caption='MtD_sign' datatype='string' name='[Calculation_3979985851578675206]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;(month to &apos; + STR([Calculation_3979985851578519557]) + &apos;)&apos;&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='metric_value_extension' datatype='real' name='[Calculation_3979985851582427144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([metric_value]) + 0.3 * SUM([metric_value])' />
      </column>
      <column caption='metric_value_currency_switch' datatype='real' name='[Calculation_3979985851584872457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [metric_value], [metric_value_EUR])' />
      </column>
      <column caption='metric_value_currency_and_metric_switch' datatype='real' name='[Calculation_3979985851585749002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 9] = 1 AND [Parameters].[Parameter 5] = 1 THEN MAX([metric_value])/1000000&#10;ELSEIF [Parameters].[Parameter 9] = 1 AND [Parameters].[Parameter 5] = 2 THEN (SUM({FIXED [Country (copy)_3979985851574317056], [order_date], [brand_display_name], [Region (copy)_3979985851576934403], [metric_name]: SUM([metric_value])}) / SUM({FIXED  [Country (copy)_3979985851574317056], [order_date], [Region (copy)_3979985851576934403], [brand_display_name]: SUM([metric_value])})) *100&#10;ELSEIF [Parameters].[Parameter 9] = 2 AND [Parameters].[Parameter 5] = 1 THEN MAX([metric_value_EUR])/1000000&#10;ELSEIF [Parameters].[Parameter 9] = 2 AND [Parameters].[Parameter 5] = 2 THEN (SUM({FIXED [Country (copy)_3979985851574317056], [order_date], [brand_display_name], [Region (copy)_3979985851576934403], [metric_name]: SUM([metric_value])}) / SUM({FIXED  [Country (copy)_3979985851574317056], [order_date], [Region (copy)_3979985851576934403], [brand_display_name]: SUM([metric_value])})) *100&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='metric_value_currency_switch_extension' datatype='real' name='[Calculation_3979985851587166219]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3979985851584872457]) + 0.3 * SUM([Calculation_3979985851584872457])' />
      </column>
      <column caption='metric_value_percent_share' datatype='real' name='[Calculation_3979985851587461132]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM({FIXED [Country (copy)_3979985851574317056], [order_date], [brand_display_name], [Region (copy)_3979985851576934403], [metric_name]: SUM([metric_value])}) / SUM({FIXED  [Country (copy)_3979985851574317056], [order_date], [Region (copy)_3979985851576934403], [brand_display_name]: SUM([metric_value])})) *100' />
      </column>
      <column caption='metric_value_currency_switch_sign' datatype='string' name='[Calculation_3979985851587616781]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 9] = 1 AND [Parameters].[Parameter 5] = 1 THEN &apos;M&apos;&#10;ELSEIF [Parameters].[Parameter 9] = 1 AND [Parameters].[Parameter 5] = 2 THEN &apos;%&apos;&#10;ELSEIF [Parameters].[Parameter 9] = 2 AND [Parameters].[Parameter 5] = 1 THEN &apos;M&apos;&#10;ELSEIF [Parameters].[Parameter 9] = 2 AND [Parameters].[Parameter 5] = 2 THEN &apos;%&apos;&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='currency_code_switch' datatype='string' name='[Calculation_3979985851588153358]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [currency_code], &apos;&apos;)' />
      </column>
      <column caption='Country Name Capitalized' datatype='string' name='[Country (copy)_3979985851574317056]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='tableau' formula='CASE [country_name] WHEN &apos;Hong_Kong&apos; THEN &apos;Hong Kong&apos;&#10;WHEN &apos;Saudi_Arabia&apos; THEN &apos;Saudi Arabia&apos;&#10;WHEN &apos;chile&apos; THEN NULL&#10;WHEN &apos;argentina&apos; THEN NULL&#10;ELSE UPPER(LEFT([country_name], 1)) + MID([country_name], 2)&#10;END' />
      </column>
      <column caption='MtD_sign (copy)' datatype='string' name='[MtD_sign (copy)_3979985851579060231]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_3979985851578519557])&#10;ELSE &apos;&apos;&#10;END' />
