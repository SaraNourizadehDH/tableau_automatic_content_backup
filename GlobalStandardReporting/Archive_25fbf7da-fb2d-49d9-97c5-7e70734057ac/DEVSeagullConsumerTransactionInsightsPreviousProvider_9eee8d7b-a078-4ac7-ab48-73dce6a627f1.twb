      <table>
        <view>
          <datasources>
            <datasource caption='fulfillment-dwh-production.rl_intl_markets.ci_seagull_vendor_kpis' name='federated.1995y960u0wcte1h2tlml11se91z' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='EUR' caption='Currency Switch' datatype='integer' name='[Parameter 9]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='LC' />
                <alias key='2' value='EUR' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1995y960u0wcte1h2tlml11se91z'>
            <column caption='currency code switch' datatype='string' name='[Calculation_1716364076510564352]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, &apos;(&apos; + [currency_code] + &apos;)&apos;, &apos;&apos;)' />
            </column>
            <column caption='dh_avg_df_currency_switch' datatype='real' name='[Calculation_1716364076511698945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [dh_avg_df_lcy], [dh_avg_df_EUR])' />
            </column>
            <column caption='Estim Comp Avg Df Currency Switch' datatype='real' name='[Calculation_1716364076511842306]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [estim_comp_avg_df_lcy], [estim_comp_avg_df_EUR])' />
            </column>
            <column caption='L3M Selector' datatype='string' name='[Calculation_219620887827877892]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([start_date]) + &quot; to &quot; + STR([end_date])' />
            </column>
            <column caption='dh_vs_comp_df_ratio' datatype='real' name='[Calculation_4294111915363586051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1716364076511698945])/SUM([Calculation_1716364076511842306])' />
            </column>
            <column caption='total_orders' datatype='integer' name='[Calculation_79024140837826560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dh_orders_k_mthly_avg]) + SUM([estim_comp_k_mthly_avg])' />
            </column>
            <column caption='Country Name Capitalized' datatype='string' name='[Country Name (copy)_219620887471161344]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='CASE [country_name] WHEN &apos;Hong_Kong&apos; THEN &apos;Hong Kong&apos;&#10;WHEN &apos;saudi_arabia&apos; THEN &apos;Saudi Arabia&apos;&#10;WHEN &apos;chile&apos; THEN NULL&#10;WHEN &apos;argentina&apos; THEN NULL&#10;ELSE UPPER(LEFT([country_name], 1)) + MID([country_name], 2)&#10;END' />
            </column>
