    <worksheet name='Country Overview - Perf. Pick-Up GMV'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Net GMV (in &lt;</run>
            <run bold='true'>[Parameters].[Parameter 9]</run>
            <run bold='true'>&gt;) - Pick-Up vs. Delivery</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fulfillment-dwh-production.rl_intl_markets.ci_seagull_country_kpis' name='federated.1gdoyng1dybxef1ccx5080migiwk' />
            <datasource caption='fulfillment-dwh-production.rl_intl_markets.ci_seagull_country_kpis_pivot' name='federated.0tq3qlq1q7ph061ewynzr1dcly72' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Country Pick-Up' datatype='string' name='[Country (copy)_3650167547960819723]' param-domain-type='list' role='measure' type='nominal' value='&quot;Singapore&quot;'>
              <calculation class='tableau' formula='&quot;Singapore&quot;' />
            </column>
            <column caption='Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;monthly&quot;'>
              <calculation class='tableau' formula='&quot;monthly&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0tq3qlq1q7ph061ewynzr1dcly72].[Calculation_1536712670124986368]' caption='p_Date' datatype='date' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2023-01-17#'>
              <calculation class='tableau' formula='#2023-01-17#' />
            </column>
            <column alias='EUR' caption='Currency Switch' datatype='integer' name='[Parameter 9]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='LC' />
                <alias key='2' value='EUR' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0tq3qlq1q7ph061ewynzr1dcly72'>
            <column caption='today' datatype='date' name='[Calculation_1536712670124986368]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='Today()' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gdoyng1dybxef1ccx5080migiwk'>
            <column caption='Brand Name DH' datatype='string' name='[Calculation_2499849639481999360]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [brand_name], &apos;DH&apos;)' />
            </column>
            <column caption='Order Date TW - End' datatype='date' default-format='*dd/mm/yyyy' name='[Calculation_2703426430130393090]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [granularity] WHEN &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[Order Date (copy)_341429202753896448]))))&#10;WHEN &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [Order Date (copy)_341429202753896448]))&#10;END' />
            </column>
            <column caption='brand_filter_sg' datatype='boolean' name='[Calculation_2768095354436059136]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(([Calculation_494621904697266180] = &apos;Singapore&apos; AND [brand_name] = &apos;Deliveroo&apos;), FALSE, TRUE)' />
            </column>
            <column caption='period_diff' datatype='integer' name='[Calculation_3268557805155057664]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='iif([granularity] = &apos;monthly&apos;, DATEDIFF(&apos;month&apos;, [order_date], [Parameters].[Parameter 3]),&#10;DATEDIFF(&apos;week&apos;, [order_date], [Parameters].[Parameter 3]))' />
            </column>
            <column caption='Pick Up GMV - DH vs. Comp' datatype='real' name='[Calculation_3650167547919081472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [proj_sg_pickup_gmv], [pickup_gmv])' />
            </column>
            <column caption='Pick Up GMV - DH vs. Comp EUR' datatype='real' name='[Calculation_3650167547922321409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [proj_sg_pickup_gmv_EUR], [pickup_gmv_EUR])' />
            </column>
            <column caption='Non Pick Up GMV - DH vs. Comp' datatype='real' name='[Calculation_3650167547922468866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [proj_sg_non_pickup_gmv], [non_pickup_gmv])' />
            </column>
            <column caption='Non Pick Up GMV - DH vs Comp EUR' datatype='real' name='[Calculation_3650167547922616323]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [proj_sg_non_pickup_gmv_EUR], [non_pickup_gmv_EUR])' />
            </column>
            <column caption='Pick Up GMV Switch' datatype='real' name='[Calculation_3650167547922771972]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [Calculation_3650167547919081472], [Calculation_3650167547922321409])' />
            </column>
            <column caption='Non Pick Up GMV Switch' datatype='real' name='[Calculation_3650167547922960389]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [Calculation_3650167547922468866], [Calculation_3650167547922616323])' />
            </column>
            <column caption='Non Pick Up GMV Relative Share' datatype='real' name='[Calculation_3650167547926249478]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM({FIXED [Calculation_494621904697266180], [order_date], [brand_name]: SUM([Calculation_3650167547922468866])}) / SUM({FIXED  [Calculation_494621904697266180], [order_date], [brand_name]: SUM([Calculation_3650167547927937031])}))' />
            </column>
            <column caption='GMV DH vs. Comp' datatype='real' name='[Calculation_3650167547927937031]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [proj_sg_gmv], [gmv])' />
            </column>
            <column caption='Pick Up GMV Relative Share' datatype='real' name='[Calculation_3650167547929894921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM({FIXED [Calculation_494621904697266180], [order_date], [brand_name]: SUM([Calculation_3650167547919081472])}) / SUM({FIXED  [Calculation_494621904697266180], [order_date], [brand_name]: SUM([Calculation_3650167547927937031])}))' />
            </column>
            <column caption='batch_date_short' datatype='string' default-format='*DD/MM' name='[Calculation_449163714054664203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(STR([batch_date]), 2) + &quot;-&quot; + MID(STR([batch_date]), 6,2)' />
            </column>
            <column caption='MtD_sign' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_4883309390215806976]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_449163714054664203])&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Country Name Capitalized' datatype='string' name='[Calculation_494621904697266180]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country_name] WHEN &apos;hong_kong&apos; THEN &apos;Hong Kong&apos;&#10;WHEN &apos;saudi_arabia&apos; THEN &apos;Saudi Arabia&apos;&#10;WHEN &apos;chile&apos; THEN NULL&#10;WHEN &apos;argentina&apos; THEN NULL&#10;ELSE UPPER(LEFT([country_name], 1)) + MID([country_name], 2)&#10;END' />
            </column>
            <column caption='currency_code_switch' datatype='string' name='[Calculation_6346979274305511432]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [currency_code_complete], &apos;&apos;)' />
            </column>
            <column caption='taiwan_exclude' datatype='boolean' name='[Calculation_758504735335686144]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Calculation_494621904697266180] = &apos;Taiwan&apos;, FALSE, TRUE)' />
            </column>
            <column caption='MtD_sign (copy)' datatype='string' datatype-customized='true' name='[MtD_sign (copy)_3956341934085222402]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_449163714054664203])&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Order Date TW' datatype='date' default-format='*dd/mm/yyyy' name='[Order Date (copy)_341429202753896448]' role='dimension' type='quantitative'>
