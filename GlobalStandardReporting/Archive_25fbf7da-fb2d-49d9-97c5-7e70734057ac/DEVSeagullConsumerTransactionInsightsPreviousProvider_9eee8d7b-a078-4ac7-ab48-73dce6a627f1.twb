            <column caption='Region Label' datatype='string' name='[Calculation_1042442627312574468]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [region_name] = &apos;greater_bangkok&apos; THEN &apos;Greater Bangkok&apos;&#10;ELSEIF [region_name] = &apos;non_greater_bangkok&apos; THEN &apos;Other Regions&apos;&#10;ELSEIF [region_name] = &apos;metro_manila&apos; THEN &apos;Metro Manila&apos;&#10;ELSEIF [region_name] = &apos;south_luzon&apos; THEN &apos;South Luzon&apos;&#10;ELSEIF [region_name] = &apos;visayas&apos; THEN &apos;Visayas&apos;&#10;ELSEIF [region_name] = &apos;north_luzon&apos; THEN &apos;North Luzon&apos;&#10;ELSEIF [region_name] = &apos;mindanao&apos; THEN &apos;Mindanao&apos;&#10;ELSEIF [region_name] = &apos;kowloon&apos; THEN &apos;Kowloon&apos;&#10;ELSEIF [region_name] = &apos;new_territories&apos; THEN &apos;New Territories&apos;&#10;ELSEIF [region_name] = &apos;hong_kong_island&apos; THEN &apos;Hong Kong Island&apos;&#10;ELSE [region_name]&#10;END' />
              <aliases>
