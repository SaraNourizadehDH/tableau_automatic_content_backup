            <column caption='sg_avg_basket_upper_switch' datatype='real' name='[Calculation_1875115977530277899]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [Calculation_1875115977530392588], [Calculation_1875115977530511373])' />
            </column>
            <column caption='sg_avg_basket_upper' datatype='real' name='[Calculation_1875115977530392588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1875115977531064337]) + SUM([sem_sg_avg_basket])' />
            </column>
            <column caption='sg_avg_basket_upper_EUR' datatype='real' name='[Calculation_1875115977530511373]' role='measure' type='quantitative'>
