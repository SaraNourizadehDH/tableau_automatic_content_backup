          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gdoyng1dybxef1ccx5080migiwk'>
            <column caption='Order Date - End' datatype='date' default-format='*dd/mm/yyyy' name='[Calculation_2703426430128222209]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date]) THEN [batch_date]&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[order_date]))))&#10;ELSEIF [granularity] = &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [order_date]))&#10;END' />
            </column>
            <column caption='period_diff' datatype='integer' name='[Calculation_3268557805155057664]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='iif([granularity] = &apos;monthly&apos;, DATEDIFF(&apos;month&apos;, [order_date], [Parameters].[Parameter 3]),&#10;DATEDIFF(&apos;week&apos;, [order_date], [Parameters].[Parameter 3]))' />
            </column>
            <column caption='N Orders - Weekly' datatype='real' name='[Calculation_3328723077485346816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([granularity] = &apos;weekly&apos;, [n_orders], NULL)' />
            </column>
            <column caption='Proj Sg Orders - Weekly' datatype='real' name='[Calculation_3328723077485780993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([granularity] = &apos;weekly&apos;, [proj_sg_orders], NULL)' />
            </column>
            <column caption='GMV - Monthly' datatype='real' name='[Calculation_3328723077490286594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([granularity] = &apos;monthly&apos;, [gmv], NULL)' />
            </column>
            <column caption='Proj Sg Gmv - Monthly' datatype='real' name='[Calculation_3328723077493579779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IiF([granularity] = &apos;monthly&apos;, [proj_sg_gmv], NULL)' />
            </column>
            <column caption='Avg Basket - Monthly' datatype='real' name='[Calculation_3328723077494308868]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([granularity] = &apos;monthly&apos;, [avg_basket], NULL)' />
            </column>
            <column caption='Sg Avg Basket - Monthly' datatype='real' name='[Calculation_3328723077494378501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([granularity] = &apos;monthly&apos;, [sg_avg_basket], NULL)' />
