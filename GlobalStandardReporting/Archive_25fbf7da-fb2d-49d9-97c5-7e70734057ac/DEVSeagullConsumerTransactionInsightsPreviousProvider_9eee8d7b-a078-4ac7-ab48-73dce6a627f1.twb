            <column caption='Sg Ios Share - Monthly' datatype='real' name='[Calculation_3328723077497712656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IiF([granularity] = &apos;monthly&apos;, [sg_ios_share], NULL)' />
            </column>
            <column caption='sg_data_validation_switch' datatype='real' name='[Calculation_3328723077499891729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 6] = 1, [Calculation_3328723077485780993],&#10;IIF([Parameters].[Parameter 6] = 2, [Calculation_3328723077493579779],&#10;IIF([Parameters].[Parameter 6] = 3 AND [Calculation_494621904697266180] != &apos;Taiwan&apos;, [Calculation_3328723077494378501],&#10;IIF([Parameters].[Parameter 6] = 3 AND [Calculation_494621904697266180] = &apos;Taiwan&apos;, [Calculation_787707776859344898],&#10;IIF([Parameters].[Parameter 6] = 4, [Calculation_3328723077494755336],&#10;IIF([Parameters].[Parameter 6] = 5, [Calculation_3328723077495140362],&#10;IIF([Parameters].[Parameter 6] = 6, [Calculation_3328723077495939084],&#10;IIF([Parameters].[Parameter 6] = 7, [Calculation_3328723077496598542],&#10;IIF([Parameters].[Parameter 6] = 8, [Calculation_3328723077497712656], NULL)))))))))' />
            </column>
            <column caption='DH_data_validation-switch' datatype='real' name='[Calculation_3328723077501874194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 6] = 1, [Calculation_3328723077485346816],&#10;IIF([Parameters].[Parameter 6] = 2, [Calculation_3328723077490286594],&#10;IIF([Parameters].[Parameter 6] = 3 AND [Calculation_494621904697266180] != &apos;Taiwan&apos;, [Calculation_3328723077494308868],&#10;IIF([Parameters].[Parameter 6] = 3 AND [Calculation_494621904697266180] = &apos;Taiwan&apos;, [Calculation_787707776859213825],&#10;IIF([Parameters].[Parameter 6] = 4, [Calculation_3328723077494616070],&#10;IIF([Parameters].[Parameter 6] = 5, [Calculation_3328723077495070729],&#10;IIF([Parameters].[Parameter 6] = 6, [Calculation_3328723077495828491],&#10;IIF([Parameters].[Parameter 6] = 7, [Calculation_3328723077496537101],&#10;IIF([Parameters].[Parameter 6] = 8, [Calculation_3328723077497643023], NULL)))))))))' />
            </column>
            <column caption='batch_date_short' datatype='string' default-format='*DD/MM' name='[Calculation_449163714054664203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(STR([batch_date]), 2) + &quot;-&quot; + MID(STR([batch_date]), 6,2)' />
            </column>
            <column caption='MtD_sign' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_4883309390215806976]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_449163714054664203])&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Country Name Capitalized' datatype='string' name='[Calculation_494621904697266180]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country_name] WHEN &apos;hong_kong&apos; THEN &apos;Hong Kong&apos;&#10;WHEN &apos;saudi_arabia&apos; THEN &apos;Saudi Arabia&apos;&#10;WHEN &apos;chile&apos; THEN NULL&#10;WHEN &apos;argentina&apos; THEN NULL&#10;ELSE UPPER(LEFT([country_name], 1)) + MID([country_name], 2)&#10;END' />
            </column>
            <column caption='Null' datatype='integer' name='[Calculation_6609876883174666243]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
            </column>
            <column caption='currency_switch_sign' datatype='string' name='[Calculation_748301245576802311]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 6] = 2 OR [Parameters].[Parameter 6] = 3 OR [Parameters].[Parameter 6] = 4, &quot;(&quot;+[currency_code_complete]+&quot;)&quot;, &apos;&apos;)' />
            </column>
            <column caption='Avg Order Value - Monthly' datatype='real' name='[Calculation_787707776859213825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([granularity] = &apos;monthly&apos;, [avg_total], NULL)' />
