              <calculation class='tableau' formula='RIGHT(STR([batch_date]), 2) + &quot;-&quot; + MID(STR([batch_date]), 6,2)' />
            </column>
            <column caption='currency_code_switch' datatype='string' name='[Calculation_1875115977522012169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [currency_code_complete], &apos;&apos;)' />
