          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Country_Regions' datatype='string' name='[Parameter 10]' param-domain-type='list' role='measure' type='nominal' value='&quot;Malaysia&quot;'>
              <calculation class='tableau' formula='&quot;Malaysia&quot;' />
            </column>
            <column caption='Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;monthly&quot;'>
              <calculation class='tableau' formula='&quot;monthly&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0tq3qlq1q7ph061ewynzr1dcly72].[Calculation_1536712670124986368]' caption='p_Date' datatype='date' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2023-01-17#'>
              <calculation class='tableau' formula='#2023-01-17#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05ouexe12ancig1747d5c0ao3ymc'>
            <column aggregation='Sum' caption='period_diff' datatype='integer' name='[Calculation_1042442627306168320]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='iif([granularity] = &apos;monthly&apos;, DATEDIFF(&apos;month&apos;, [order_date], [Parameters].[Parameter 3]),&#10;DATEDIFF(&apos;week&apos;, [order_date], [Parameters].[Parameter 3]))' />
            </column>
            <column caption='MoM_orders_sg_dh' datatype='real' name='[Calculation_1042442627307626498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([orders_sg_dh])/SUM([prev_orders_sg_dh]))-1' />
            </column>
            <column caption='Region Label' datatype='string' name='[Calculation_1042442627312574468]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [region_name] = &apos;greater_bangkok&apos; THEN &apos;Greater Bangkok&apos;&#10;ELSEIF [region_name] = &apos;non_greater_bangkok&apos; THEN &apos;Other Regions&apos;&#10;ELSEIF [region_name] = &apos;metro_manila&apos; THEN &apos;Metro Manila&apos;&#10;ELSEIF [region_name] = &apos;south_luzon&apos; THEN &apos;South Luzon&apos;&#10;ELSEIF [region_name] = &apos;visayas&apos; THEN &apos;Visayas&apos;&#10;ELSEIF [region_name] = &apos;north_luzon&apos; THEN &apos;North Luzon&apos;&#10;ELSEIF [region_name] = &apos;mindanao&apos; THEN &apos;Mindanao&apos;&#10;ELSEIF [region_name] = &apos;kowloon&apos; THEN &apos;Kowloon&apos;&#10;ELSEIF [region_name] = &apos;new_territories&apos; THEN &apos;New Territories&apos;&#10;ELSEIF [region_name] = &apos;hong_kong_island&apos; THEN &apos;Hong Kong Island&apos;&#10;ELSE [region_name]&#10;END' />
              <aliases>
                <alias key='&quot;east_coast&quot;' value='East Coast' />
                <alias key='&quot;hong_kong_island&quot;' value='Hong Kong Island' />
                <alias key='&quot;johor&quot;' value='Johor' />
                <alias key='&quot;klang_valley&quot;' value='Klang Valley' />
                <alias key='&quot;kowloon&quot;' value='Kowloon' />
                <alias key='&quot;melaka_&amp;_n9&quot;' value='Melaka' />
                <alias key='&quot;metro_manila&quot;' value='Metro Manila' />
                <alias key='&quot;mindanao&quot;' value='Mindanao' />
                <alias key='&quot;new_territories&quot;' value='New Territories' />
                <alias key='&quot;north&quot;' value='North' />
                <alias key='&quot;north_luzon&quot;' value='North Luzon' />
                <alias key='&quot;sabah&quot;' value='Sabah' />
                <alias key='&quot;sarawak&quot;' value='Sarawak' />
                <alias key='&quot;south_luzon&quot;' value='South Luzon' />
                <alias key='&quot;visayas&quot;' value='Visayas' />
              </aliases>
            </column>
            <column caption='Order Date - End' datatype='date' default-format='*dd/mm/yyyy' name='[Calculation_2703426430137421828]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date]) THEN [batch_date]&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[order_date]))))&#10;ELSEIF [granularity] = &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [order_date]))&#10;END' />
            </column>
            <column caption='Country Name Capitalized' datatype='string' name='[Calculation_934074761271492608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country_name] WHEN &apos;hong_kong&apos; THEN &apos;Hong Kong&apos;&#10;WHEN &apos;saudi_arabia&apos; THEN &apos;Saudi Arabia&apos;&#10;WHEN &apos;chile&apos; THEN NULL&#10;WHEN &apos;argentina&apos; THEN NULL&#10;ELSE UPPER(LEFT([country_name], 1)) + MID([country_name], 2)&#10;END' />
            </column>
            <column caption='Batch Date' datatype='date' name='[batch_date]' role='dimension' type='ordinal' />
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Granularity' datatype='string' name='[granularity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1042442627306168320]' derivation='None' name='[none:Calculation_1042442627306168320:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1042442627312574468]' derivation='None' name='[none:Calculation_1042442627312574468:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2703426430137421828]' derivation='None' name='[none:Calculation_2703426430137421828:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_934074761271492608]' derivation='None' name='[none:Calculation_934074761271492608:nk]' pivot='key' type='nominal' />
            <column-instance column='[batch_date]' derivation='None' name='[none:batch_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[brand_name]' derivation='None' name='[none:brand_name:nk]' pivot='key' type='nominal' />
