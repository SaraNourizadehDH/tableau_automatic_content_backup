          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gdoyng1dybxef1ccx5080migiwk'>
            <column caption='sg_avg_incentive_lower' datatype='real' name='[Calculation_1667317074164957185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1667317074169356295]) - SUM([sem_avg_incentive_per_order_lower])' />
            </column>
            <column caption='sg_avg_incentive_lower_EUR' datatype='real' name='[Calculation_1667317074166464514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1667317074169491464]) - SUM([sem_avg_incentive_per_order_lower_EUR])' />
            </column>
            <column caption='sg_avg_incentive_upper_EUR' datatype='real' name='[Calculation_1667317074166636547]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1667317074169491464]) + SUM([sem_avg_incentive_per_order_upper_EUR])' />
            </column>
            <column caption='sg_avg_incentive_upper' datatype='real' name='[Calculation_1667317074167132164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1667317074169356295]) + SUM([sem_avg_incentive_per_order_upper])' />
            </column>
            <column caption='sg_avg_incentive_upper_switch' datatype='real' name='[Calculation_1667317074167291909]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [Calculation_1667317074167132164], [Calculation_1667317074166636547])' />
            </column>
            <column caption='sg_avg_incentive_lower_switch' datatype='real' name='[Calculation_1667317074167586822]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [Calculation_1667317074164957185], [Calculation_1667317074166464514])' />
            </column>
            <column caption='Avg Incentive Per Order SG only' datatype='real' name='[Calculation_1667317074169356295]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [sg_avg_incentive_per_order], NULL)' />
            </column>
            <column caption='Avg Incentive Per Order SG only EUR' datatype='real' name='[Calculation_1667317074169491464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [sg_avg_incentive_per_order_EUR], NULL)' />
            </column>
            <column caption='sg_avg_incentive_upper_switch_label' datatype='string' name='[Calculation_1667317074174320649]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL(MAX([global_entity_id]))&#10;THEN &apos; - &apos; + STR(ROUND([Calculation_1667317074167291909],2)) + &apos;)&apos;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='sg_avg_incentive_lower_switch_label' datatype='string' name='[Calculation_1667317074175729674]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL(MAX([global_entity_id]))&#10;THEN &apos;(&apos; + STR(ROUND([Calculation_1667317074167586822],2))&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Avg Incentive Per Order SH DH EUR' datatype='real' name='[Calculation_196821402008215552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [sg_avg_incentive_per_order_EUR], [avg_incentive_per_order_EUR])' />
            </column>
            <column caption='Avg Incentive Per Order Switch' datatype='real' name='[Calculation_196821402008301569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [Calculation_5056346136985284608], [Calculation_196821402008215552])' />
            </column>
            <column caption='Brand Name DH' datatype='string' name='[Calculation_2499849639481999360]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [brand_name], &apos;DH&apos;)' />
            </column>
            <column caption='Order Date TW - End' datatype='date' default-format='*dd/mm/yyyy' name='[Calculation_2703426430130393090]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [granularity] WHEN &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[Order Date (copy)_341429202753896448]))))&#10;WHEN &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [Order Date (copy)_341429202753896448]))&#10;END' />
            </column>
            <column caption='period_diff' datatype='integer' name='[Calculation_3268557805155057664]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='iif([granularity] = &apos;monthly&apos;, DATEDIFF(&apos;month&apos;, [order_date], [Parameters].[Parameter 3]),&#10;DATEDIFF(&apos;week&apos;, [order_date], [Parameters].[Parameter 3]))' />
            </column>
            <column caption='Avg Total - DH vs. Comp' datatype='real' name='[Calculation_3574802625083973642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [sg_avg_total], [avg_total])' />
            </column>
            <column caption='Avg Total - DH vs. Comp EUR' datatype='real' name='[Calculation_3574802625097097229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [sg_avg_total_EUR], [avg_total_EUR])' />
            </column>
            <column caption='batch_date_short' datatype='string' default-format='*DD/MM' name='[Calculation_449163714054664203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(STR([batch_date]), 2) + &quot;-&quot; + MID(STR([batch_date]), 6,2)' />
            </column>
            <column caption='MtD_sign' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_4883309390215806976]' role='dimension' type='nominal'>
