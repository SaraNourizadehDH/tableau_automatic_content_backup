              <calculation class='tableau' formula='IF ([Calculation_2894829404496936961] = &apos;Taiwan&apos; OR [brand_display_name] = &apos;UberEats&apos;) AND [metric_name] = &apos;incentivised GMV&apos; THEN &apos;incentivised &apos;&#10;ELSEIF ([Calculation_2894829404496936961] = &apos;Taiwan&apos; OR [brand_display_name] = &apos;UberEats&apos;) AND [metric_name] = &apos;incentivised orders&apos; THEN &apos;incentivised &apos;&#10;ELSEIF ([Calculation_2894829404496936961] = &apos;Taiwan&apos; OR [brand_display_name] = &apos;UberEats&apos;) AND [metric_name] = &apos;unincentivised GMV&apos; THEN &apos;non-incentivised &apos;&#10;ELSEIF ([Calculation_2894829404496936961] = &apos;Taiwan&apos; OR [brand_display_name] = &apos;UberEats&apos;) AND [metric_name] = &apos;unincentivised orders&apos; THEN &apos;non-incentivised &apos;&#10;ELSEIF ([Calculation_2894829404496936961] != &apos;Taiwan&apos; AND [brand_display_name] != &apos;UberEats&apos;) THEN [metric_name]&#10;ELSE NULL &#10;END' />
