              <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = 1 THEN &apos;Orders (weekly)&apos;&#10;ELSEIF [Parameters].[Parameter 6] = 2 THEN &apos;GMV&apos;&#10;ELSEIF  [Parameters].[Parameter 6] = 3 AND [Calculation_494621904697266180] = &apos;Taiwan&apos; THEN &apos;AOV&apos;&#10;ELSEIF  [Parameters].[Parameter 6] = 3 AND [Calculation_494621904697266180] != &apos;Taiwan&apos; THEN &apos;AFV&apos;&#10;ELSEIF  [Parameters].[Parameter 6] = 4 THEN &apos;Delivery Fee&apos;&#10;ELSEIF  [Parameters].[Parameter 6] = 5 THEN &apos;Fraction of Incentivised Orders&apos;&#10;ELSEIF [Parameters].[Parameter 6] = 6 THEN &apos;Active Customers&apos;&#10;ELSEIF  [Parameters].[Parameter 6] = 7 THEN &apos;Customer Frequency&apos;&#10;ELSEIF  [Parameters].[Parameter 6] = 8 THEN &apos;iOS Share&apos;&#10;ELSE NULL&#10;END' />
