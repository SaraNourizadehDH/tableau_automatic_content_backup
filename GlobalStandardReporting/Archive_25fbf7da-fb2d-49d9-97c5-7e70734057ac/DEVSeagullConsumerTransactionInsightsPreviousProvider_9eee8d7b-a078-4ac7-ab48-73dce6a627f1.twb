  <worksheets>
    <worksheet name='Brand Overview - Orders Deliveroo'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Orders: Foodpanda vs. Deliveroo </run>
            <run><![CDATA[in <[federated.0tq3qlq1q7ph061ewynzr1dcly72].[none:Calculation_2894829404496936961:nk]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fulfillment-dwh-production.rl_intl_markets.ci_seagull_country_kpis_pivot' name='federated.0tq3qlq1q7ph061ewynzr1dcly72' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;monthly&quot;'>
              <calculation class='tableau' formula='&quot;monthly&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0tq3qlq1q7ph061ewynzr1dcly72].[Calculation_1536712670124986368]' caption='p_Date' datatype='date' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2023-01-17#'>
              <calculation class='tableau' formula='#2023-01-17#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0tq3qlq1q7ph061ewynzr1dcly72'>
            <column caption='today' datatype='date' name='[Calculation_1536712670124986368]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='Today()' />
            </column>
            <column caption='metric_value_extension' datatype='real' name='[Calculation_1596244618198568964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([metric_value]) + 0.3 * MAX([metric_value])' />
            </column>
            <column caption='Order Date - End' datatype='date' default-format='*dd/mm/yyyy' name='[Calculation_2703426430124564480]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date]) THEN [batch_date]&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[order_date]))))&#10;ELSEIF [granularity] = &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [order_date]))&#10;END' />
            </column>
            <column caption='Brand Display Name DH' datatype='string' name='[Calculation_2894829404494397440]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [brand_display_name], &apos;DH&apos;)' />
            </column>
            <column caption='Country Name Capitalized' datatype='string' name='[Calculation_2894829404496936961]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country_name] WHEN &apos;Hong_Kong&apos; THEN &apos;Hong Kong&apos;&#10;WHEN &apos;Saudi_Arabia&apos; THEN &apos;Saudi Arabia&apos;&#10;WHEN &apos;chile&apos; THEN NULL&#10;WHEN &apos;argentina&apos; THEN NULL&#10;ELSE UPPER(LEFT([country_name], 1)) + MID([country_name], 2)&#10;END' />
            </column>
            <column caption='period_diff' datatype='integer' name='[Calculation_3268557805156294658]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='iif([granularity] = &apos;monthly&apos;, DATEDIFF(&apos;month&apos;, [order_date], [Parameters].[Parameter 3]),&#10;DATEDIFF(&apos;week&apos;, [order_date], [Parameters].[Parameter 3]))' />
            </column>
            <column caption='batch_date_short' datatype='string' name='[Calculation_748301245566836736]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(STR([batch_date]), 2) + &quot;-&quot; + MID(STR([batch_date]), 6,2)' />
            </column>
            <column caption='MtD_sign' datatype='string' name='[Calculation_748301245566943233]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;(month to &apos; + STR([Calculation_748301245566836736]) + &apos;)&apos;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column-instance column='[Calculation_2703426430124564480]' derivation='Attribute' name='[attr:Calculation_2703426430124564480:ok]' pivot='key' type='ordinal' />
            <column caption='Batch Date' datatype='date' name='[batch_date]' role='dimension' type='ordinal' />
            <column caption='Brand Display Name' datatype='string' name='[brand_display_name]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Granularity' datatype='string' name='[granularity]' role='dimension' type='nominal' />
            <column caption='Metric Name' datatype='string' name='[metric_name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;incentivised GMV&quot;' value='incentivised' />
                <alias key='&quot;incentivised orders&quot;' value='incentivised ' />
                <alias key='&quot;unincentivised GMV&quot;' value='unincentivised' />
                <alias key='&quot;unincentivised orders&quot;' value='unincentivised ' />
              </aliases>
            </column>
            <column caption='Metric Value' datatype='real' name='[metric_value]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2894829404494397440]' derivation='None' name='[none:Calculation_2894829404494397440:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2894829404496936961]' derivation='None' name='[none:Calculation_2894829404496936961:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_3268557805156294658]' derivation='None' name='[none:Calculation_3268557805156294658:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_748301245566943233]' derivation='None' name='[none:Calculation_748301245566943233:nk]' pivot='key' type='nominal' />
            <column-instance column='[batch_date]' derivation='None' name='[none:batch_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[brand_display_name]' derivation='None' name='[none:brand_display_name:nk]' pivot='key' type='nominal' />
