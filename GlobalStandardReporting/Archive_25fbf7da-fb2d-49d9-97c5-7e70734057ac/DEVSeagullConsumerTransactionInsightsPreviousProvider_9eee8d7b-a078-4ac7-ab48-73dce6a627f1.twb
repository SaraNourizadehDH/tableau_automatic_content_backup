    <worksheet name='Country Overview - Cust. Active Customers'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Active Customers</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true'>Vertical lines</run>
            <run> represent range of </run>
            <run bold='true'>statistical error</run>
            <run>.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fulfillment-dwh-production.rl_intl_markets.ci_seagull_country_kpis' name='federated.1gdoyng1dybxef1ccx5080migiwk' />
            <datasource caption='fulfillment-dwh-production.rl_intl_markets.ci_seagull_country_kpis_pivot' name='federated.0tq3qlq1q7ph061ewynzr1dcly72' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Country Customers' datatype='string' name='[Country (copy)_657595931974557696]' param-domain-type='list' role='measure' type='nominal' value='&quot;Hong Kong&quot;'>
              <calculation class='tableau' formula='&quot;Hong Kong&quot;' />
            </column>
            <column caption='Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;monthly&quot;'>
              <calculation class='tableau' formula='&quot;monthly&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0tq3qlq1q7ph061ewynzr1dcly72].[Calculation_1536712670124986368]' caption='p_Date' datatype='date' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2023-01-17#'>
              <calculation class='tableau' formula='#2023-01-17#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0tq3qlq1q7ph061ewynzr1dcly72'>
            <column caption='today' datatype='date' name='[Calculation_1536712670124986368]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='Today()' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gdoyng1dybxef1ccx5080migiwk'>
            <column caption='Customers Comp Only' datatype='real' name='[Calculation_1778710753048211463]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [proj_sg_customers], NULL)' />
            </column>
            <column caption='customers_upper' datatype='real' name='[Calculation_1778710753048281096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1778710753048211463]) + SUM([e_proj_sg_customers])' />
            </column>
            <column caption='customers_lower' datatype='real' name='[Calculation_1778710753048641545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1778710753048211463]) - SUM([e_proj_sg_customers])' />
            </column>
            <column caption='Brand Name DH' datatype='string' name='[Calculation_2499849639481999360]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [brand_name], &apos;DH&apos;)' />
            </column>
            <column caption='Customers - DH. vs. Comp.' datatype='real' name='[Calculation_2499849639528464392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [proj_sg_customers], [n_customers])' />
            </column>
            <column caption='Order Date - End' datatype='date' default-format='*dd/mm/yyyy' name='[Calculation_2703426430128222209]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date]) THEN [batch_date]&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[order_date]))))&#10;ELSEIF [granularity] = &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [order_date]))&#10;END' />
            </column>
            <column caption='period_diff' datatype='integer' name='[Calculation_3268557805155057664]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='iif([granularity] = &apos;monthly&apos;, DATEDIFF(&apos;month&apos;, [order_date], [Parameters].[Parameter 3]),&#10;DATEDIFF(&apos;week&apos;, [order_date], [Parameters].[Parameter 3]))' />
            </column>
            <column caption='ue_disclaimer' datatype='string' name='[Calculation_3574802625085739019]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Calculation_494621904697266180] = &apos;Taiwan&apos;, &apos;From May 2021, Consumer transaction insights for UberEats, Taiwan, are limited to orders, net GMV and average order value. Additional metrics, including average food value, are available for other markets.&apos;, &apos;&apos;)' />
            </column>
            <column caption='batch_date_short' datatype='string' default-format='*DD/MM' name='[Calculation_449163714054664203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(STR([batch_date]), 2) + &quot;-&quot; + MID(STR([batch_date]), 6,2)' />
            </column>
            <column caption='MtD_sign' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_4883309390215806976]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_449163714054664203])&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Country Name Capitalized' datatype='string' name='[Calculation_494621904697266180]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country_name] WHEN &apos;hong_kong&apos; THEN &apos;Hong Kong&apos;&#10;WHEN &apos;saudi_arabia&apos; THEN &apos;Saudi Arabia&apos;&#10;WHEN &apos;chile&apos; THEN NULL&#10;WHEN &apos;argentina&apos; THEN NULL&#10;ELSE UPPER(LEFT([country_name], 1)) + MID([country_name], 2)&#10;END' />
            </column>
            <column caption='MtD_sign (copy)' datatype='string' datatype-customized='true' name='[MtD_sign (copy)_3956341934085222402]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_449163714054664203])&#10;ELSE &apos;&apos;&#10;END' />
            </column>
