            <run bold='true'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fulfillment-dwh-production.rl_intl_markets.ci_seagull_qa' name='federated.137ivn208ojs0k15rchql1eqwgax' />
            <datasource caption='fulfillment-dwh-production.rl_intl_markets.ci_seagull_country_kpis' name='federated.1gdoyng1dybxef1ccx5080migiwk' />
            <datasource caption='fulfillment-dwh-production.rl_intl_markets.ci_seagull_country_kpis_pivot' name='federated.0tq3qlq1q7ph061ewynzr1dcly72' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.1gdoyng1dybxef1ccx5080migiwk].[Calculation_494621904697266180]' caption='Country' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Hong Kong&quot;'>
              <calculation class='tableau' formula='&quot;Hong Kong&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0tq3qlq1q7ph061ewynzr1dcly72].[Calculation_1536712670124986368]' caption='p_Date' datatype='date' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2023-01-17#'>
              <calculation class='tableau' formula='#2023-01-17#' />
            </column>
            <column alias='Absolute Values' caption='Absolute vs Percent' datatype='integer' name='[Parameter 5]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Absolute Values' />
                <alias key='2' value='Relative Shares' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0tq3qlq1q7ph061ewynzr1dcly72'>
            <column caption='today' datatype='date' name='[Calculation_1536712670124986368]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='Today()' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.137ivn208ojs0k15rchql1eqwgax'>
            <column caption='Live Active Customers' datatype='integer' name='[Calculation_1830994740580003840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[num_active_customers] - [num_not_live_active_customers]' />
            </column>
            <column caption='country_name_capitalized' datatype='string' name='[Calculation_1830994740580610049]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country_name] WHEN &apos;hong_kong&apos; THEN &apos;Hong Kong&apos;&#10;WHEN &apos;saudi_arabia&apos; THEN &apos;Saudi Arabia&apos;&#10;WHEN &apos;chile&apos; THEN NULL&#10;WHEN &apos;argentina&apos; THEN NULL&#10;ELSE UPPER(LEFT([country_name], 1)) + MID([country_name], 2)&#10;END' />
            </column>
            <column caption='Perc Non-Live Active Customers' datatype='real' name='[Calculation_1830994740582117378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([num_not_live_active_customers])/SUM([num_active_customers])) * 100' />
            </column>
            <column caption='Perc Live Active Customers' datatype='real' name='[Calculation_1830994740582346755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_1830994740580003840])/SUM([num_active_customers])) * 100' />
            </column>
            <column caption='period_diff' datatype='integer' name='[Calculation_1830994740613406726]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='iif([granularity] = &apos;monthly&apos;, DATEDIFF(&apos;month&apos;, [order_date], [Parameters].[Parameter 3]),&#10;DATEDIFF(&apos;week&apos;, [order_date], [Parameters].[Parameter 3]))' />
            </column>
            <column caption='brand_name_dh' datatype='string' name='[Calculation_1830994740618735624]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [brand_name], &apos;DH&apos;)' />
            </column>
            <column caption='Order Date - End' datatype='date' default-format='*dd/mm/yyyy' name='[Calculation_2703426430140956677]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date]) THEN [batch_date]&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[order_date]))))&#10;ELSEIF [granularity] = &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [order_date]))&#10;END' />
            </column>
            <column caption='Non-Live Active Customers Switch' datatype='real' name='[Calculation_449163714022416385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = 1 THEN SUM([num_not_live_active_customers])&#10;ELSEIF [Parameters].[Parameter 5] = 2 THEN ROUND([Calculation_1830994740582117378], 2)&#10;END' />
            </column>
            <column caption='Live Active Customers Switch' datatype='real' name='[Calculation_449163714023747586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = 1 THEN SUM([Calculation_1830994740580003840])&#10;ELSEIF [Parameters].[Parameter 5] = 2 THEN ROUND([Calculation_1830994740582346755], 2)&#10;END' />
            </column>
            <column caption='metric_switch_sign' datatype='string' name='[Calculation_449163714025414660]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = 2 THEN &apos;%&apos;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='reference_line_customers_switch' datatype='integer' name='[Calculation_449163714029588485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [order_date] = DATETRUNC(&apos;month&apos;, TODAY()) THEN NULL&#10;ELSEIF [Parameters].[Parameter 5] = 1 THEN [num_active_customers]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='batch_date_short' datatype='string' name='[Calculation_449163714062757900]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(STR([batch_date]), 2) + &quot;-&quot; + MID(STR([batch_date]), 6,2)' />
