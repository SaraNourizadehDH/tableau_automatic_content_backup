      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>ABV</run>
            <run><![CDATA[ in <[Parameters].[Parameter 9]> <[federated.1995y960u0wcte1h2tlml11se91z].[none:Calculation_1716364076510564352:nk]>]]></run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true'>AFV </run>
            <run>for </run>
            <run bold='true'>competitor brands </run>
            <run>represents the </run>
            <run bold='true'>&quot;subtotal&quot; </run>
            <run>on</run>
            <run bold='true'> e-receipt.</run>
            <run>Æ&#10;</run>
            <run bold='true'>AFV </run>
            <run>for </run>
            <run bold='true'>DH brands </run>
            <run>aligns with</run>
            <run bold='true'> DH AFV definition:</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true'>Average Food Value </run>
            <run>(AFV): Gross Food Value / # of Orders
</run>
            <run bold='true'>Gross Food Value </run>
            <run>(GFV): Total paid compulsory by customer for food. Excluding service fees and delivery fees. Including VAT.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fulfillment-dwh-production.rl_intl_markets.ci_seagull_vendor_kpis' name='federated.1995y960u0wcte1h2tlml11se91z' />
