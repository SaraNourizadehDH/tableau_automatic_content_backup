    <worksheet name='vendor_incentive share'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Incentive Share</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fulfillment-dwh-production.rl_intl_markets.ci_seagull_vendor_kpis' name='federated.1995y960u0wcte1h2tlml11se91z' />
          </datasources>
          <datasource-dependencies datasource='federated.1995y960u0wcte1h2tlml11se91z'>
            <column caption='L3M Selector' datatype='string' name='[Calculation_219620887827877892]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([start_date]) + &quot; to &quot; + STR([end_date])' />
            </column>
            <column caption='dh_vs_comp_incentive_share_ratio' datatype='real' name='[Calculation_4294111915364245508]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dh_incentive_share])/SUM([estim_comp_incentive_share])' />
            </column>
            <column caption='dh_incentive_share_l3m' datatype='real' name='[Calculation_4294111915366035461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dh_incentive_share])/(1+SUM([dh_incentive_share_change_l3m_pct]))' />
            </column>
            <column caption='dh_incentive_share_l3m_pp' datatype='real' name='[Calculation_4294111915368882183]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([dh_incentive_share]) - [Calculation_4294111915366035461]) * 100' />
            </column>
            <column caption='comp_incentive_share_l3m_pp' datatype='real' name='[Calculation_4294111915370827784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([estim_comp_incentive_share]) - [Calculation_4294111915371094025]) * 100' />
            </column>
            <column caption='comp_incentive_share_l3m' datatype='real' name='[Calculation_4294111915371094025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([estim_comp_incentive_share])/(1+SUM([comp_incentive_share_change_l3m_pct]))' />
            </column>
            <column caption='total_orders' datatype='integer' name='[Calculation_79024140837826560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dh_orders_k_mthly_avg]) + SUM([estim_comp_k_mthly_avg])' />
            </column>
            <column caption='Country Name Capitalized' datatype='string' name='[Country Name (copy)_219620887471161344]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='CASE [country_name] WHEN &apos;Hong_Kong&apos; THEN &apos;Hong Kong&apos;&#10;WHEN &apos;saudi_arabia&apos; THEN &apos;Saudi Arabia&apos;&#10;WHEN &apos;chile&apos; THEN NULL&#10;WHEN &apos;argentina&apos; THEN NULL&#10;ELSE UPPER(LEFT([country_name], 1)) + MID([country_name], 2)&#10;END' />
            </column>
            <column caption='Comp Incentive Share Change L3M Pct' datatype='real' name='[comp_incentive_share_change_l3m_pct]' role='measure' type='quantitative' />
