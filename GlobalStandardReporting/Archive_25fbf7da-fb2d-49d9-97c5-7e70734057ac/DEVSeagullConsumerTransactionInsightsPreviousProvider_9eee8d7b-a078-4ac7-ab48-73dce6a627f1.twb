      <aliases enabled='yes' />
      <column caption='Metric Name Thin Receipts Exception' datatype='string' name='[Brand Display Name DH (copy)_787707776872087557]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Calculation_2894829404496936961] = &apos;Taiwan&apos; OR [brand_display_name] = &apos;UberEats&apos;) AND [metric_name] = &apos;incentivised GMV&apos; THEN &apos;incentivised &apos;&#10;ELSEIF ([Calculation_2894829404496936961] = &apos;Taiwan&apos; OR [brand_display_name] = &apos;UberEats&apos;) AND [metric_name] = &apos;incentivised orders&apos; THEN &apos;incentivised &apos;&#10;ELSEIF ([Calculation_2894829404496936961] = &apos;Taiwan&apos; OR [brand_display_name] = &apos;UberEats&apos;) AND [metric_name] = &apos;unincentivised GMV&apos; THEN &apos;non-incentivised &apos;&#10;ELSEIF ([Calculation_2894829404496936961] = &apos;Taiwan&apos; OR [brand_display_name] = &apos;UberEats&apos;) AND [metric_name] = &apos;unincentivised orders&apos; THEN &apos;non-incentivised &apos;&#10;ELSEIF ([Calculation_2894829404496936961] != &apos;Taiwan&apos; AND [brand_display_name] != &apos;UberEats&apos;) THEN [metric_name]&#10;ELSE NULL &#10;END' />
        <aliases>
          <alias key='&quot;incentivised &quot;' value=' ' />
          <alias key='&quot;incentivised GMV&quot;' value='incentivised' />
          <alias key='&quot;incentivised orders&quot;' value='incentivised ' />
          <alias key='&quot;non-incentivised &quot;' value='    ' />
          <alias key='&quot;unincentivised GMV&quot;' value='non-incentivised' />
          <alias key='&quot;unincentivised orders&quot;' value='non-incentivised ' />
        </aliases>
      </column>
      <column caption='Confluence' datatype='string' name='[Calculation_1042442627335028746]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;&apos;' />
      </column>
      <column caption='lower_limit_switch' datatype='real' name='[Calculation_1172906273465495552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [lower_limit], [lower_limit_eur])' />
      </column>
      <column caption='upper_limit_switch' datatype='real' name='[Calculation_1172906273465622529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [upper_limit], [upper_limit_eur])' />
      </column>
      <column caption='today' datatype='date' name='[Calculation_1536712670124986368]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='Today()' />
