            <column caption='Avg Delivery Fee - Monthly' datatype='real' name='[Calculation_3328723077494616070]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IiF([granularity] = &apos;monthly&apos;, [avg_delivery_fee], NULL)' />
            </column>
            <column caption='Sg Avg Delivery Fee - Monthly' datatype='real' name='[Calculation_3328723077494755336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IiF([granularity] = &apos;monthly&apos;, [sg_avg_delivery_fee], NULL)' />
            </column>
            <column caption='Incentive Share - Monthly' datatype='real' name='[Calculation_3328723077495070729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([granularity] = &apos;monthly&apos;, [incentive_share], NULL)' />
            </column>
            <column caption='Sg Incentive Share - Monthly' datatype='real' name='[Calculation_3328723077495140362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IiF([granularity] = &apos;monthly&apos;, [sg_incentive_share], NULL)' />
            </column>
            <column caption='N Customers - Monthly' datatype='real' name='[Calculation_3328723077495828491]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IiF([granularity] = &apos;monthly&apos;, [n_customers], NULL)' />
            </column>
            <column caption='Proj Sg Customers - Monthly' datatype='real' name='[Calculation_3328723077495939084]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IiF([granularity] = &apos;monthly&apos;, [proj_sg_customers], NULL)' />
            </column>
            <column caption='Frequency - Monthly' datatype='real' name='[Calculation_3328723077496537101]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IiF([granularity] = &apos;monthly&apos;, [frequency], NULL)' />
            </column>
            <column caption='Sg Frequency - Monthly' datatype='real' name='[Calculation_3328723077496598542]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IiF([granularity] = &apos;monthly&apos;, [sg_frequency], NULL)' />
