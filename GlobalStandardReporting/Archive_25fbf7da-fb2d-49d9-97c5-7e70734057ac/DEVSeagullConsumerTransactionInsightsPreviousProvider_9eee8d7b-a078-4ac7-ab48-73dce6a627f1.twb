      <aliases enabled='yes' />
      <column caption='bucket_min_int' datatype='integer' datatype-customized='true' name='[Bucket (min) (copy)_2869778151326064663]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT([bucket_min])' />
      </column>
      <column caption='Country Name Capitalized' datatype='string' name='[Calculation_1534109003627954177]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [country_name] WHEN &apos;hong_kong&apos; THEN &apos;Hong Kong&apos;&#10;WHEN &apos;saudi_arabia&apos; THEN &apos;Saudi Arabia&apos;&#10;WHEN &apos;chile&apos; THEN NULL&#10;WHEN &apos;argentina&apos; THEN NULL&#10;ELSE UPPER(LEFT([country_name], 1)) + MID([country_name], 2)&#10;END' />
      </column>
      <column caption='orders_x_pct' datatype='real' name='[Calculation_1534109003629539330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[orders] * [pct]' />
      </column>
      <column caption='weighted_pct' datatype='real' name='[Calculation_1534109003631669252]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1534109003629539330])/SUM([orders])' />
      </column>
      <column caption='Brand Display Name DH' datatype='string' name='[Calculation_1534109003634655237]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [brand_name], &apos;DH&apos;)' />
      </column>
      <column caption='Seagull vs Internal Filter' datatype='string' name='[Calculation_1534109003658559494]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_actual] THEN &apos;DH Internal&apos;&#10;ELSEIF INT([is_actual]) = 0 AND ISNULL([global_entity_id]) THEN &apos;Competitor Seagull&apos;&#10;ELSEIF INT([is_actual]) = 0 AND NOT ISNULL([global_entity_id]) THEN &apos;DH Seagull&apos;&#10;ELSE &apos;unknown&apos;&#10;END' />
      </column>
      <column caption='bucket_midpoint' datatype='real' name='[Calculation_2869778151326203928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Bucket (min) (copy)_2869778151326064663] + (([bucket_max] - [Bucket (min) (copy)_2869778151326064663])/ 2)' />
      </column>
      <column caption='pct_orders_x_bucket' datatype='real' name='[Calculation_2869778151342784538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1534109003629539330] * [Calculation_2869778151326203928]' />
      </column>
      <column caption='avg_kpi_bucket' datatype='real' name='[Calculation_2869778151344541723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2869778151342784538])/SUM([Calculation_1534109003629539330])' />
      </column>
      <column caption='ue_disclaimer' datatype='string' name='[Calculation_3574802625112989717]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Calculation_1534109003627954177] != &apos;Taiwan&apos;, &apos;&apos;, &apos;From May 2021, Consumer transaction insights for UberEats, Taiwan, are limited to orders, net GMV and average order value. Additional metrics, including average food value, are available for other markets.&apos;)' />
      </column>
      <column caption='NULL' datatype='integer' datatype-customized='true' name='[Calculation_6764195546582048772]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='user_filter_3' datatype='boolean' name='[Calculation_711216912983851013]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
      </column>
      <column caption='currency_code_switch' datatype='string' name='[Calculation_748301245577478152]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 4] = &apos;food_value&apos; OR [Parameters].[Parameter 4] = &apos;delivery_fee&apos;, &quot;(in &quot; + [currency_code] + &quot;)&quot;, &apos;&apos;)' />
      </column>
      <column caption='title_delivery_fee' datatype='string' name='[Calculation_930767393826930688]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_1534109003627954177] WHEN &apos;Taiwan&apos; THEN &apos;&apos;&#10;ELSE &apos;Delivery Fee in (&apos; + [currency_code] + &apos;)&apos;&#10;END' />
      </column>
      <column caption='titles_kpi_distribution' datatype='string' name='[Calculation_930767393831370753]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Calculation_1534109003627954177] = &apos;Taiwan&apos;, &apos;&apos;, &apos;Average:&apos;)' />
      </column>
