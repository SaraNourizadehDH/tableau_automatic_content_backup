      <column caption='Order Date TW' datatype='date' default-format='*dd/mm/yyyy' name='[Order Date (copy)_341429202753896448]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_494621904697266180] != &apos;Taiwan&apos;, [order_date],&#10;IIF([Calculation_494621904697266180] = &apos;Taiwan&apos; AND [order_date] &lt;= DATE(&quot;2021-04-30&quot;), [order_date], NULL&#10;))' />
      </column>
