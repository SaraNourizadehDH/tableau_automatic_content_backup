          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.1gdoyng1dybxef1ccx5080migiwk].[Calculation_494621904697266180]' caption='Country' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Hong Kong&quot;'>
              <calculation class='tableau' formula='&quot;Hong Kong&quot;' />
            </column>
            <column caption='Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;monthly&quot;'>
              <calculation class='tableau' formula='&quot;monthly&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0tq3qlq1q7ph061ewynzr1dcly72].[Calculation_1536712670124986368]' caption='p_Date' datatype='date' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2023-01-17#'>
              <calculation class='tableau' formula='#2023-01-17#' />
            </column>
            <column alias='EUR' caption='Currency Switch' datatype='integer' name='[Parameter 9]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='LC' />
                <alias key='2' value='EUR' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0tq3qlq1q7ph061ewynzr1dcly72'>
            <column caption='today' datatype='date' name='[Calculation_1536712670124986368]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='Today()' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gdoyng1dybxef1ccx5080migiwk'>
            <column caption='Sg Avg Delivery Fee Comp Only' datatype='real' name='[Calculation_1778710753024032771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [sg_avg_delivery_fee], NULL)' />
            </column>
            <column caption='sg_avg_delivery_fee_upper' datatype='real' name='[Calculation_1778710753024434180]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1778710753024032771]) + SUM([sem_avg_delivery_fee_upper])' />
            </column>
            <column caption='sg_avg_delivery_fee_lower' datatype='real' name='[Calculation_1778710753036541957]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1778710753024032771]) - SUM([sem_avg_delivery_fee_lower])' />
            </column>
            <column caption='Brand Name DH' datatype='string' name='[Calculation_2499849639481999360]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [brand_name], &apos;DH&apos;)' />
            </column>
            <column caption='Avg Delivery Fee - DH vs. Comp' datatype='real' name='[Calculation_2499849639484567553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [sg_avg_delivery_fee], &#10;IIF(NOT ISNULL([global_entity_id]) AND [Calculation_494621904697266180] = &apos;Hong Kong&apos;, [avg_df_no_pickups],[avg_delivery_fee]&#10;))' />
            </column>
            <column caption='Order Date - End' datatype='date' default-format='*dd/mm/yyyy' name='[Calculation_2703426430128222209]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date]) THEN [batch_date]&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[order_date]))))&#10;ELSEIF [granularity] = &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [order_date]))&#10;END' />
            </column>
            <column caption='afv_aov_title_switch' datatype='string' name='[Calculation_3067021766772797453]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_494621904697266180] = &apos;Taiwan&apos; THEN &apos;Avg. Order Value&apos;&#10;ELSE &apos;Avg. Basket Value&apos;&#10;END' />
            </column>
            <column caption='period_diff' datatype='integer' name='[Calculation_3268557805155057664]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='iif([granularity] = &apos;monthly&apos;, DATEDIFF(&apos;month&apos;, [order_date], [Parameters].[Parameter 3]),&#10;DATEDIFF(&apos;week&apos;, [order_date], [Parameters].[Parameter 3]))' />
            </column>
            <column caption='batch_date_short' datatype='string' default-format='*DD/MM' name='[Calculation_449163714054664203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(STR([batch_date]), 2) + &quot;-&quot; + MID(STR([batch_date]), 6,2)' />
            </column>
            <column caption='MtD_sign' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_4883309390215806976]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_449163714054664203])&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Country Name Capitalized' datatype='string' name='[Calculation_494621904697266180]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country_name] WHEN &apos;hong_kong&apos; THEN &apos;Hong Kong&apos;&#10;WHEN &apos;saudi_arabia&apos; THEN &apos;Saudi Arabia&apos;&#10;WHEN &apos;chile&apos; THEN NULL&#10;WHEN &apos;argentina&apos; THEN NULL&#10;ELSE UPPER(LEFT([country_name], 1)) + MID([country_name], 2)&#10;END' />
            </column>
            <column caption='currency_code_switch' datatype='string' name='[Calculation_6346979274305511432]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [currency_code_complete], &apos;&apos;)' />
            </column>
            <column caption='Avg Delivery Fee - DH vs. Comp EUR' datatype='real' name='[Calculation_6346979274305863689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]),[sg_avg_delivery_fee_EUR], &#10;IIF(NOT ISNULL([global_entity_id]) AND [Calculation_494621904697266180] = &apos;Hong Kong&apos;, [avg_delivery_fee_no_pickups_EUR],[avg_delivery_fee_EUR]&#10;))' />
            </column>
            <column caption='Avg Delivery Fee Switch' datatype='real' name='[Calculation_6346979274306031626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [Calculation_2499849639484567553], [Calculation_6346979274305863689])' />
            </column>
            <column caption='Sg Avg Delivery Fee Comp Only EUR' datatype='real' name='[Calculation_6346979274306830347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [sg_avg_delivery_fee_EUR], NULL)' />
            </column>
            <column caption='sg_avg_delivery_fee_upper_EUR' datatype='real' name='[Calculation_6346979274307006476]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6346979274306830347]) + SUM([sem_avg_delivery_fee_upper_EUR])' />
            </column>
            <column caption='sg_avg_delivery_fee_lower_EUR' datatype='real' name='[Calculation_6346979274307121165]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_6346979274306830347]) - SUM([sem_avg_delivery_fee_lower_EUR])' />
            </column>
            <column caption='sg_avg_delivery_fee_lower_switch' datatype='real' name='[Calculation_6346979274307309582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [Calculation_1778710753036541957], [Calculation_6346979274307121165])' />
