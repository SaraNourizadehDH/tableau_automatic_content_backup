          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Country Incentives' datatype='string' name='[Parameter 11]' param-domain-type='list' role='measure' type='nominal' value='&quot;Hong Kong&quot;'>
              <calculation class='tableau' formula='&quot;Hong Kong&quot;' />
            </column>
            <column alias='GMV' caption='Incentives Switch' datatype='integer' name='[Parameter 12]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='ABV' />
                <alias key='2' value='GMV' />
              </aliases>
            </column>
            <column caption='Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;monthly&quot;'>
              <calculation class='tableau' formula='&quot;monthly&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[federated.0tq3qlq1q7ph061ewynzr1dcly72].[Calculation_1536712670124986368]' caption='p_Date' datatype='date' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2023-01-17#'>
              <calculation class='tableau' formula='#2023-01-17#' />
            </column>
