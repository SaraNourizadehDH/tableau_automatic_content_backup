    <dashboard name='Terminology'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/Seagull-ConsumerTransactionInsightsDRAFT/Terminology?rev=' id='Terminology' path='/t/GlobalStandardReporting/workbooks/DEV-Seagull-ConsumerTransactionInsights-PreviousProvider' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_3' value='top' />
        </style-rule>
      </style>
      <size maxheight='700' maxwidth='900' minheight='700' minwidth='900' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='90143' id='3' type-v2='text' w='98222' x='889' y='8714'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='8'>Terminology</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='8'>Incentivised Orders</run>
              <run fontcolor='#000000' fontsize='8'>: Number of orders placed that included a financial incentive (promotion, discount). </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='8'>Non-Incentivised Orders</run>
              <run fontcolor='#000000' fontsize='8'>: Number of orders placed without any financial incentives (promotion, discount).</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='8'>Incentivised GMV</run>
              <run fontcolor='#000000' fontsize='8'>: Amount of GMV generated from orders that included financial incentives (promotion, discount). </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='8'>Non-Incentivised GMV</run>
              <run fontcolor='#000000' fontsize='8'>: Amount of GMV generated from orders without financial incentives (promotion, discount).</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='8'>Average Food Value</run>
              <run fontcolor='#000000' fontsize='8'> (AFV): AFV displayed for competitor brands represents the “subtotal” on consumers’ e-receipts. AFV displayed for DH brands aligns with the DH-internal AFV definition (Gross Food Value / # of Orders, whereas Gross Food Value (GFV) is the total paid compulsory by customer for food, excluding service fees and delivery fees, but including VAT).</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='8'>Incentive Share</run>
              <run fontcolor='#000000' fontsize='8'>: The percentage of orders, out of the total orders, that included a financial incentive (promotion, discount).</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='8'>Frequency</run>
              <run fontcolor='#000000' fontsize='8'>: Customers’ order frequency within a given month or week.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='8'>Batch Date</run>
              <run fontcolor='#000000' fontsize='8'>: The data provider delivers the latest data in batches at regular weekly intervals. </run>
              <run fontcolor='#000000' fontsize='8' italic='true'>Batch Date </run>
              <run fontcolor='#000000' fontsize='8'>represents the most recent date appearing in a given batch. This is our convention to be able refer to each of these batches in an unequivocal way.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1d1c1d' fontsize='8'>Live Customers</run>
              <run fontcolor='#1d1c1d' fontsize='8'>: Customers that are currently opted-in as panelists. Non live customers&apos; historic transactions (up to the day they opted out of the panel) will still be shown.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1d1c1d' fontsize='8'>Live Transactions</run>
              <run fontcolor='#1d1c1d' fontsize='8'>: Transactions made by Live Customers.</run>
              <run>Æ&#10;&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='7571' id='6' type-v2='text' w='89040' x='10071' y='1143'>
            <formatted-text>
              <run bold='true' fontcolor='#ffffff' fontsize='15'>Methodology</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
              <format attr='background-color' value='#cb011c' />
            </zone-style>
          </zone>
          <zone h='7571' id='7' is-scaled='1' param='Image/DH-ICON-white.png' type-v2='bitmap' w='9182' x='889' y='1143'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
              <format attr='background-color' value='#cb011c' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='2093' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='97714' id='2092' param='vert' type-v2='layout-flow' w='98222' x='889' y='1143'>
                <zone fixed-size='53' h='7571' id='7' is-fixed='true' is-scaled='1' param='Image/DH-ICON-white.png' type-v2='bitmap' w='9182' x='889' y='1143'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#cb011c' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='7571' id='6' type-v2='text' w='89040' x='10071' y='1143'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ffffff' fontsize='15'>Methodology</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#cb011c' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='90143' id='3' type-v2='text' w='98222' x='889' y='8714'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='8'>Terminology</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>Incentivised Orders</run>
                    <run fontcolor='#000000' fontsize='8'>: Number of orders placed that included a financial incentive (promotion, discount). </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>Non-Incentivised Orders</run>
                    <run fontcolor='#000000' fontsize='8'>: Number of orders placed without any financial incentives (promotion, discount).</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>Incentivised GMV</run>
                    <run fontcolor='#000000' fontsize='8'>: Amount of GMV generated from orders that included financial incentives (promotion, discount). </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>Non-Incentivised GMV</run>
                    <run fontcolor='#000000' fontsize='8'>: Amount of GMV generated from orders without financial incentives (promotion, discount).</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>Average Food Value</run>
                    <run fontcolor='#000000' fontsize='8'> (AFV): AFV displayed for competitor brands represents the “subtotal” on consumers’ e-receipts. AFV displayed for DH brands aligns with the DH-internal AFV definition (Gross Food Value / # of Orders, whereas Gross Food Value (GFV) is the total paid compulsory by customer for food, excluding service fees and delivery fees, but including VAT).</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>Incentive Share</run>
                    <run fontcolor='#000000' fontsize='8'>: The percentage of orders, out of the total orders, that included a financial incentive (promotion, discount).</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>Frequency</run>
                    <run fontcolor='#000000' fontsize='8'>: Customers’ order frequency within a given month or week.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='8'>Batch Date</run>
                    <run fontcolor='#000000' fontsize='8'>: The data provider delivers the latest data in batches at regular weekly intervals. </run>
                    <run fontcolor='#000000' fontsize='8' italic='true'>Batch Date </run>
                    <run fontcolor='#000000' fontsize='8'>represents the most recent date appearing in a given batch. This is our convention to be able refer to each of these batches in an unequivocal way.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontsize='8'>Live Customers</run>
                    <run fontcolor='#1d1c1d' fontsize='8'>: Customers that are currently opted-in as panelists. Non live customers&apos; historic transactions (up to the day they opted out of the panel) will still be shown.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1d1c1d' fontsize='8'>Live Transactions</run>
                    <run fontcolor='#1d1c1d' fontsize='8'>: Transactions made by Live Customers.</run>
                    <run>Æ&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{F6754888-4004-454D-BF23-2D79633F47C6}' />
    </dashboard>
