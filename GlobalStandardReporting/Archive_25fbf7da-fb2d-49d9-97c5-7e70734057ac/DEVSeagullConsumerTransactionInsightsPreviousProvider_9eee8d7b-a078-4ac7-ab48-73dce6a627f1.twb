                <alias key='&quot;south_luzon&quot;' value='South Luzon' />
                <alias key='&quot;visayas&quot;' value='Visayas' />
              </aliases>
            </column>
            <column aggregation='CountD' caption='MtD_sign' datatype='string' name='[Calculation_1875115977519030274]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_1875115977519095811])&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='batch_date_short' datatype='string' name='[Calculation_1875115977519095811]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(STR([batch_date]), 2) + &quot;-&quot; + MID(STR([batch_date]), 6,2)' />
            </column>
            <column caption='Avg Incentive Per Order Switch' datatype='real' name='[Calculation_1875115977521332229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [Calculation_1875115977521483783], [Calculation_1875115977521541128])' />
            </column>
            <column caption='Avg Incentive Per Order SG DH' datatype='real' name='[Calculation_1875115977521483783]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [sg_avg_incentive_per_order], [avg_incentive_per_order])' />
            </column>
            <column caption='Avg Incentive Per Order SH DH EUR' datatype='real' name='[Calculation_1875115977521541128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [sg_avg_incentive_per_order_EUR], [avg_incentive_per_order_EUR])' />
            </column>
            <column caption='currency_code_switch' datatype='string' name='[Calculation_1875115977522012169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [currency_code_complete], &apos;&apos;)' />
            </column>
            <column caption='Order Date - End' datatype='date' default-format='*dd/mm/yyyy' name='[Calculation_2703426430137421828]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date]) THEN [batch_date]&#10;ELSEIF [granularity] = &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[order_date]))))&#10;ELSEIF [granularity] = &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [order_date]))&#10;END' />
            </column>
            <column caption='MtD_sign_long' datatype='string' name='[Calculation_3574802625108979731]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_1875115977519095811])&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Country Name Capitalized' datatype='string' name='[Calculation_934074761271492608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country_name] WHEN &apos;hong_kong&apos; THEN &apos;Hong Kong&apos;&#10;WHEN &apos;saudi_arabia&apos; THEN &apos;Saudi Arabia&apos;&#10;WHEN &apos;chile&apos; THEN NULL&#10;WHEN &apos;argentina&apos; THEN NULL&#10;ELSE UPPER(LEFT([country_name], 1)) + MID([country_name], 2)&#10;END' />
            </column>
