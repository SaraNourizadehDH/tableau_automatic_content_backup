              <calculation class='tableau' formula='STR([start_date]) + &quot; to &quot; + STR([end_date])' />
            </column>
            <column caption='dh_vs_comp_items_ratio' datatype='real' name='[Calculation_4294111915362185217]' role='measure' type='quantitative'>
