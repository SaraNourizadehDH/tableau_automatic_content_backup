            <column caption='Order Date' datatype='date' default-format='*dd/mm/yyyy' name='[order_date]' role='dimension' type='ordinal' />
            <column caption='Orders Sg Dh' datatype='real' name='[orders_sg_dh]' role='measure' type='quantitative' />
            <column-instance column='[orders_sg_dh]' derivation='Sum' name='[pcto:sum:orders_sg_dh:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.05ouexe12ancig1747d5c0ao3ymc].[brand_name]' ordering-type='Field' type='PctTotal' />
