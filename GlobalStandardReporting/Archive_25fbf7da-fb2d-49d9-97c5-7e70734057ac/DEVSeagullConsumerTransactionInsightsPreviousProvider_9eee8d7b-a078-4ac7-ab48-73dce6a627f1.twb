            <column caption='Avg Delivery Fee - DH vs. Comp' datatype='real' name='[Calculation_3067021766764265473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [sg_avg_delivery_fee], &#10;IIF(NOT ISNULL([global_entity_id]) AND [Calculation_934074761271492608] = &apos;Hong Kong&apos;, [avg_df_no_pickups],[avg_delivery_fee]&#10;))' />
