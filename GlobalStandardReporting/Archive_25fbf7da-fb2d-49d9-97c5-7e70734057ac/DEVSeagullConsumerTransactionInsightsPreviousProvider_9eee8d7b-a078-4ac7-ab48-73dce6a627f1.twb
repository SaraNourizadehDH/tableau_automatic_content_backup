          <datasource-dependencies datasource='federated.1gdoyng1dybxef1ccx5080migiwk'>
            <column caption='Brand Name DH' datatype='string' name='[Calculation_2499849639481999360]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [brand_name], &apos;DH&apos;)' />
            </column>
            <column caption='Orders - DH vs. Comp.' datatype='real' name='[Calculation_2499849639531048969]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [proj_sg_orders], [n_orders])' />
            </column>
            <column caption='Order Date TW - End' datatype='date' default-format='*dd/mm/yyyy' name='[Calculation_2703426430130393090]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [granularity] WHEN &apos;monthly&apos; THEN DATE(DATEADD(&apos;day&apos;,-1,(DATEADD(&apos;month&apos;,1,[Order Date (copy)_341429202753896448]))))&#10;WHEN &apos;weekly&apos; THEN DATE(DATEADD(&apos;day&apos;, 6, [Order Date (copy)_341429202753896448]))&#10;END' />
            </column>
            <column caption='brand_filter_sg' datatype='boolean' name='[Calculation_2768095354436059136]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(([Calculation_494621904697266180] = &apos;Singapore&apos; AND [brand_name] = &apos;Deliveroo&apos;), FALSE, TRUE)' />
            </column>
            <column caption='period_diff' datatype='integer' name='[Calculation_3268557805155057664]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='iif([granularity] = &apos;monthly&apos;, DATEDIFF(&apos;month&apos;, [order_date], [Parameters].[Parameter 3]),&#10;DATEDIFF(&apos;week&apos;, [order_date], [Parameters].[Parameter 3]))' />
            </column>
            <column caption='Pick Up Orders - DH vs Comp' datatype='real' name='[Calculation_3650167547961262092]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [proj_sg_pickup_orders], [pickup_orders])' />
            </column>
            <column caption='Non Pick Up Orders - DH vs Comp' datatype='real' name='[Calculation_3650167547961393165]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([global_entity_id]), [proj_sg_non_pickup_orders], [non_pickup_orders])' />
            </column>
            <column caption='Pick Up Orders Relative Share' datatype='real' name='[Calculation_3650167547961892878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM({FIXED [Calculation_494621904697266180], [order_date], [brand_name]: SUM([Calculation_3650167547961262092])}) / SUM({FIXED  [Calculation_494621904697266180], [order_date], [brand_name]: SUM([Calculation_2499849639531048969])}))' />
            </column>
            <column caption='Non Pick Up Orders Relative Share' datatype='real' name='[Calculation_3650167547962318863]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM({FIXED [Calculation_494621904697266180], [order_date], [brand_name]: SUM([Calculation_3650167547961393165])}) / SUM({FIXED  [Calculation_494621904697266180], [order_date], [brand_name]: SUM([Calculation_2499849639531048969])}))' />
            </column>
            <column caption='batch_date_short' datatype='string' default-format='*DD/MM' name='[Calculation_449163714054664203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='RIGHT(STR([batch_date]), 2) + &quot;-&quot; + MID(STR([batch_date]), 6,2)' />
            </column>
            <column caption='MtD_sign' datatype='string' default-role='measure' default-type='ordinal' name='[Calculation_4883309390215806976]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [granularity] = &apos;monthly&apos; AND [order_date] = DATETRUNC(&apos;month&apos;, [batch_date])&#10;THEN &apos;displays month to &apos; + STR([Calculation_449163714054664203])&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Country Name Capitalized' datatype='string' name='[Calculation_494621904697266180]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country_name] WHEN &apos;hong_kong&apos; THEN &apos;Hong Kong&apos;&#10;WHEN &apos;saudi_arabia&apos; THEN &apos;Saudi Arabia&apos;&#10;WHEN &apos;chile&apos; THEN NULL&#10;WHEN &apos;argentina&apos; THEN NULL&#10;ELSE UPPER(LEFT([country_name], 1)) + MID([country_name], 2)&#10;END' />
            </column>
            <column caption='currency_code_switch' datatype='string' name='[Calculation_6346979274305511432]' role='dimension' type='nominal'>
