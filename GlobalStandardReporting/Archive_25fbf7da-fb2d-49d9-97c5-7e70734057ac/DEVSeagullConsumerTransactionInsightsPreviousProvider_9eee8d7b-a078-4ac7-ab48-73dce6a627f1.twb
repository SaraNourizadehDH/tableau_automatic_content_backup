                <zone fixed-size='264' forceUpdate='true' h='11103' id='1294' type-v2='text' w='98000' x='1000' y='81839'>
                  <formatted-text>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000'>NOTES</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000'>The table groups data in periods of </run>
                    <run bold='true' fontcolor='#000000'>three months</run>
                    <run fontcolor='#000000'> (E.g. L3M: January - March).</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000'>Vendors </run>
                    <run fontcolor='#000000'>displayed need to have at least </run>
                    <run bold='true' fontcolor='#000000'>40 panelists </run>
                    <run fontcolor='#000000'>in sample from the </run>
                    <run bold='true' fontcolor='#000000'>last three months </run>
                    <run fontcolor='#000000'>to be considered (to ensure statistical relevance).</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000'>Columns of </run>
                    <run bold='true' fontcolor='#000000'>growth/percentage/percentage point</run>
                    <run fontcolor='#000000'> change compare the </run>
                    <run bold='true' fontcolor='#000000'>last three complete months </run>
                    <run fontcolor='#000000'>(E.g. L3M: January - March) with the three months directly before them (E.g. October - December).</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000'>All</run>
                    <run bold='true' fontcolor='#000000'> FP data is internal</run>
                    <run fontcolor='#000000'>, except for Average Number of </run>
                    <run bold='true' fontcolor='#000000'>Items </run>
                    <run fontcolor='#000000'>per Order which is also estimated from the sample.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000'>Blank cells</run>
                    <run fontcolor='#000000'> mean missing data or a division by zero.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{31A843C0-6904-4EE7-B7F7-9593B5FC31B0}' />
