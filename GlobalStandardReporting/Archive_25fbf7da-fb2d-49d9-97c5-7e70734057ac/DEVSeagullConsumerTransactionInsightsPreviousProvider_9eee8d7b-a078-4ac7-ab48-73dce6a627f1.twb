            <column caption='sg_avg_delivery_fee_upper_switch' datatype='real' name='[Calculation_6346979274307452943]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 9] = 1, [Calculation_1778710753024434180], [Calculation_6346979274307006476])' />
