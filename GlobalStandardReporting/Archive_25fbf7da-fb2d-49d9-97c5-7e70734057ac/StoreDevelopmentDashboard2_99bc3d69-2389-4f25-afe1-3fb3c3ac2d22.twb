            </column>
            <column caption='Filter Dmart Covered maus' datatype='string' name='[Calculation_901986569147797518]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1593500244822708226]&gt;[Calculation_6873055994582794242] THEN &quot;Greater than entered threshold&quot; ELSE &quot;Less than or equal to entered threshold&quot; end' />
            </column>
