            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Enter Dmart Covered Users threshold' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <range min='0' />
            </column>
            <column caption='month' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;October&quot;'>
              <calculation class='tableau' formula='&quot;October&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0uoyij70fh2r011bxo9bl0lqckv6'>
            <column caption='month string' datatype='string' name='[Calculation_1593500244822462465]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[Datamonth])' />
            </column>
            <column caption='calc55' datatype='integer' name='[Calculation_1593500244822708226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [warehouse_id]: sum(if [Calculation_1593500244822462465] = [Parameters].[Parameter 2] then [dmart_covered_mau] else 0 end)}' />
            </column>
            <column caption='data of selected month' datatype='string' name='[Calculation_1593500244823158787]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{fixed [warehouse_id]:Max( IF [Calculation_1593500244822462465]=[Parameters].[Parameter 2] THEN &apos;Yes&apos; ELSE &apos;No&apos; end)}' />
            </column>
            <column caption='Dmart Covered Users Margin' datatype='integer' name='[Calculation_6873055994582794242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column caption='Filter Dmart Covered maus' datatype='string' name='[Calculation_901986569147797518]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1593500244822708226]&gt;[Calculation_6873055994582794242] THEN &quot;Greater than entered threshold&quot; ELSE &quot;Less than or equal to entered threshold&quot; end' />
            </column>
