      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98156' id='7' param='horz' type-v2='layout-flow' w='98828' x='586' y='922'>
            <zone h='98156' id='5' type-v2='layout-basic' w='87115' x='586' y='922'>
              <zone h='80990' id='3' name='Output' w='87115' x='586' y='18088'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='17166' id='15' type-v2='text' w='87115' x='586' y='922'>
                <formatted-text>
                  <run bold='true' fontcolor='#333333' fontname='Tableau Light' fontsize='10'>Definitions:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#333333' fontname='Tableau Light' fontsize='8' underline='true'>Vendor Retention:</run>
                  <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'> % of users that tried a vendor and came back to the same specific vendor within the defined time period.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#333333' fontname='Tableau Light' fontsize='8' underline='true'>Vendor Organic Retention:</run>
                  <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'> % of users that tried a vendor and came back to the same specific vendor using 0 vouchers within the defined time period.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#333333' fontname='Tableau Light' fontsize='8' underline='true'>Trial Cohort:</run>
                  <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'> # of users that tried a vendor placing an order with X number of items ordered (quantity ordered)</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#333333' fontname='Tableau Light' fontsize='8' underline='true'>Is Partially Fulfilled:</run>
                  <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'> flag which is True for orders with at least 1 item has not been fulfilled, excluding: Successfully replaced orders, Orders with items not processed and Orders with checkout not confirmed.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#333333' fontname='Tableau Light' fontsize='8' underline='true'>Retention Rate 1M:</run>
                  <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'> % of customers that came back to the same vendor in the 1st month after trying it.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#333333' fontname='Tableau Light' fontsize='8' underline='true'>Retention Rate 3M:</run>
                  <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'> % of customers that came back to the same vendor in the 3rd month after trying it.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#333333' fontname='Tableau Light' fontsize='8' underline='true'>Retention Rate 1-3 months (any):</run>
                  <run fontcolor='#333333' fontname='Tableau Light' fontsize='8'> % of customers that came back to the same vendor within the 1st and 3rd month after trying it.</run>
                  <run>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
