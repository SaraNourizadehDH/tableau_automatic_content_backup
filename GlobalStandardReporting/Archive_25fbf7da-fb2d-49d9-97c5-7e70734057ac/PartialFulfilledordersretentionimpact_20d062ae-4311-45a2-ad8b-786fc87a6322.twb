      <column caption='Vendor Retention' datatype='real' default-format='p0.0%' name='[Calculation_50384081256566790]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;1M&quot; THEN [Vendor Retention 1-3 months (copy)_50384081256325124]&#13;&#10;    WHEN &quot;3M&quot; THEN [Vendor Retention 1M (copy)_50384081256476677]&#13;&#10;    ELSE [Calculation_868068886174052352]&#13;&#10;END' />
      </column>
      <column caption='Vendor Retention 1-3 months' datatype='real' default-format='p0.0%' name='[Calculation_868068886174052352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_retention_three_months])/SUM([trial_cohort_size])' />
      </column>
