      <aliases enabled='yes' />
      <column caption='# Sessions per Unique Visitor' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[#Sessions per Order-Session (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sessions])/sum([unique_stakeholders_daily])' />
      </column>
      <column caption='% Chats Connected' datatype='real' default-format='p0%' name='[% Chats Created (copy)_5703386726420434945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_chat_connected])/SUM([sum_chats_created])' />
      </column>
      <column caption='% Chats Created per Request' datatype='real' default-format='p0%' name='[% Chats Created in Contacts (copy)_5703386726417817600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_chats_created])/SUM([sum_chat_requested])' />
      </column>
      <column caption='% Tickets in Incidents' datatype='real' default-format='p0%' name='[% Chats in Incidents (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([tickets_created])/([Calculation_5848205595694018560])' />
      </column>
      <column caption='% Valid Chats per Order' datatype='real' default-format='p0%' name='[% Chats per Successful Session (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_5346617209719324676]) /  SUM([gross_orders])' />
      </column>
      <column caption='% Missed Chats in Offered Chats' datatype='real' default-format='p0.0%' name='[% Dropped Chats in Valid Chats (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_missed_chats]) / ([Calculation_926897125765316609])' />
      </column>
      <column caption='% Session with Contacts per Successful Session' datatype='real' default-format='p0%' name='[% Incidents per Order (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_4280812209010036737])/sum([successful_sessions])' />
      </column>
      <column caption='% Contacts per Session with Contacts' datatype='real' default-format='p0%' name='[% Incidents per Session (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_5848205595694018560])/([Calculation_4280812209010036737])' />
      </column>
