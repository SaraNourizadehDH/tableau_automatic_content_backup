      <column caption='Granularity' datatype='string' name='[Calculation_1002895405755514880]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Completed Week Parameter]=&apos;Daily&apos; THEN STR([date])&#13;&#10;ELSEIF [Parameters].[Completed Week Parameter]=&apos;Weekly&apos; THEN STR([week])&#13;&#10;ELSEIF [Parameters].[Completed Week Parameter]=&apos;Monthly&apos; THEN STR([month])&#13;&#10;END' />
      </column>
      <column caption='% Order Sessions per Order' datatype='real' default-format='p0%' name='[Calculation_1002895405756514305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_sessions]) /  SUM([gross_orders])' />
      </column>
      <column caption='%  ValidChats per Successful Session' datatype='real' default-format='p0%' name='[Calculation_1002895405757456387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_5346617209719324676]) /  SUM([successful_sessions])' />
      </column>
      <column caption='% Sessions per Order' datatype='real' default-format='p0.00%' name='[Calculation_1002895405757681668]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions]) / SUM([gross_orders])' />
      </column>
      <column caption='% Unique Visitors per Order' datatype='real' default-format='p0%' name='[Calculation_1333558091418394625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6162190950858551296] / SUM([gross_orders])' />
      </column>
      <column caption='% Valid Chats in Chats Created' datatype='real' default-format='p0%' name='[Calculation_1340665380954984448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_5346617209719324676])/SUM([sum_chats_created])' />
      </column>
      <column caption='Global' datatype='string' name='[Calculation_2249266576309104640]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Global&apos;' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_312789129417142272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Failed Sessions' datatype='integer' name='[Calculation_4280812209002344448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[sessions] - [successful_sessions]' />
      </column>
      <column caption='Sessions with Contacts' datatype='integer' name='[Calculation_4280812209010036737]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions_with_incident])' />
      </column>
      <column caption='% Unique Visitors with Order' datatype='real' default-format='p0%' name='[Calculation_485051774342803456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unique_stakeholders_with_order_daily])/ ([Calculation_6162190950858551296])' />
      </column>
      <column caption='% Session with Contact' datatype='real' default-format='p0%' name='[Calculation_485051774348980225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions_with_incident])/ SUM([successful_sessions])' />
      </column>
      <column caption='% Sessions with Chat' datatype='real' default-format='p0%' name='[Calculation_485051774357282819]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions_with_chat_created]) / SUM([sessions])' />
      </column>
      <column caption='Contact Rate' datatype='real' default-format='p0%' name='[Calculation_485051774358286341]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5848205595694018560] / SUM([gross_orders])' />
      </column>
      <column caption='Chat AHT (min)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5105815378461937664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_ht_served_sf]) / SUM([sum_served_chats_sf]) /60 //original field is in seconds' />
      </column>
      <column caption='display high level' datatype='string' name='[Calculation_5346617209467011072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if {fixed [Calculation_1002895405755514880], [stakeholder], [contact_center], [country], [brand] :SUM(IFNULL([sessions], 0))} = 0 THEN &apos;blank&apos;&#13;ELSE &apos;display&apos; END&#13;&#10;&#13;&#10;//if ifnull([Sessions],0) = 0 THEN &apos;blank&apos;&#13;&#10;//ELSE &apos;display&apos; END' />
      </column>
      <column caption='% Failed Sessions' datatype='real' name='[Calculation_5346617209712513025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4280812209002344448]) / SUM([sessions])' />
      </column>
      <column caption='Accidental Chats' datatype='integer' name='[Calculation_5346617209717796866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_dropped_chats_5s])' />
      </column>
      <column caption='% Accidental Chats in Chats' datatype='real' default-format='p0.0%' name='[Calculation_5346617209718394883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5346617209717796866] /sum([sum_chats_created])' />
      </column>
      <column caption='Valid Chats' datatype='integer' name='[Calculation_5346617209719324676]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sum_chat_connected]) - ([Calculation_5346617209717796866])' />
      </column>
      <column caption='% Dropped Chats in Valid Chats' datatype='real' default-format='p0%' name='[Calculation_5346617209721888773]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_dropped_chats]) / ([Calculation_5346617209719324676])' />
      </column>
      <column caption='Contacts' datatype='integer' name='[Calculation_5848205595694018560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_chats_created])+sum([tickets_created])' />
      </column>
      <column caption='# Unique Visitors' datatype='integer' name='[Calculation_6162190950858551296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unique_stakeholders_daily])' />
      </column>
      <column caption='# Session-Orders per Unique Order-Sessions' datatype='real' name='[Calculation_645070303621378048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Unique Customer-Session  (copy)]) / SUM([unique_order_sessions])' />
      </column>
      <column caption='% Chats per Unique Order-Session' datatype='real' default-format='p0%' name='[Calculation_645070303622971393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_chats_created]) / SUM([unique_order_sessions])' />
      </column>
      <column caption='% Sessions with Order' datatype='real' default-format='p0%' name='[Calculation_926897125763903488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Unique Customer-Session  (copy)]) /SUM([successful_sessions])' />
      </column>
      <column caption='Offered Chats (for SLA)' datatype='integer' name='[Calculation_926897125765316609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5346617209719324676] - SUM([sum_dropped_chats])' />
      </column>
      <column caption='% Offered Chats in Valid Chats' datatype='real' default-format='p0%' name='[Calculation_926897125765971970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_926897125765316609] / [Calculation_5346617209719324676]' />
      </column>
      <column caption='% Chats Created per Contact' datatype='real' default-format='p0%' name='[Calculation_926897125768261635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_chats_created])/[Calculation_5848205595694018560]' />
      </column>
      <column caption='#Sessions per Session-Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_961800062245875712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sessions])/([Unique Customer-Session  (copy)])' />
      </column>
      <column caption='% Incidents per Order' datatype='real' default-format='p0%' name='[Calculation_961800062248067073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5848205595694018560]/sum([gross_orders])' />
      </column>
      <column caption='Contact Deflection Rate' datatype='real' default-format='p0%' name='[Calculation_961800062251913219]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_5848205595694018560]/sum([successful_sessions])' />
      </column>
      <column caption='No Contact CSAT' datatype='real' default-format='p0%' name='[Calculation_961800062252695556]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([count_csat_4_5])/sum([count_responses])' />
      </column>
      <column caption='Chat Workload per Order (sec)' datatype='real' default-format='n#,##0;-#,##0' name='[Chat AHT (copy)_5105815378498232321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_5346617209719324676]) / SUM([gross_orders]) // chat contact rate&#10;&#10;* [Calculation_5105815378461937664] *60// in seconds' />
      </column>
      <column caption='Date Range' datatype='date' name='[Date (copy)_1333558089835483136]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[date]' />
      </column>
      <column caption='Chat Deflection Rate' datatype='real' default-format='p0%' name='[Deflection Rate L1 (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([sum_chats_created])/sum([successful_sessions])' />
      </column>
      <column caption='No Contact CSAT Responses Count' datatype='integer' name='[General AC NPS (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([count_responses])' />
      </column>
      <column caption='Sessions with Order' datatype='integer' name='[Unique Customer-Session  (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions_with_order])' />
      </column>
