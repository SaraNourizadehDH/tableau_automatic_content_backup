  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='KPI Definitons'>
      <repository-location id='KPIDefinitons' path='/t/GlobalStandardReporting/workbooks/DarkStores-RandomCycleCount' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#555555' />
        </style-rule>
      </style>
      <size maxheight='900' maxwidth='1500' minheight='900' minwidth='1500' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='6889' id='3' type-v2='text' w='98934' x='533' y='889'>
            <formatted-text>
              <run bold='true' fontcolor='#ffffff' fontsize='16'>KPI Definitions</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='49444' id='5' type-v2='text' w='98934' x='533' y='7778'>
            <formatted-text>
              <run bold='true' fontcolor='#ffffff' fontsize='14'>Random Results</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Distinct SKUs Counted: sum of distinct SKUs counted during the cycle count</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Discrepancy : sum of on hand qty - sum of units counted</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>SKU Defect Rate: number of SKUs with discrepancies / Distinct SKUs Counted</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Item Level Defect Rate (Gross): Absolute(discrepancies)/ sum of on hand qty of counted SKUs</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Item Level Defect Rate (Net): discrepancies/ sum of on hand qty of counted SKUs</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Required SKUs: sum of skus required to be counted based on Cochran&apos;s Formula</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Æ  </run>
              <run bold='true' fontcolor='#ffffff' fontsize='11'> N = (Z² * p * q )/ e²</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>           N = Sample size</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>           Z = Z score (based on confidence level) fixed at 1.96 aka 95% CL</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>           p = Variability ( estimated proportion of an attribute that is present in the population) Avg SKU Defect rate for the last 4 weeks or a variability of 50%</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>           q = 1 - p</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>           e = Margin of error </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'><![CDATA[Required SKUs (Adj): Adjusted sample size for cases where population is significantly low (e.g. <400)]]></run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Æ  </run>
              <run bold='true' fontcolor='#ffffff' fontsize='11'> N = n/(1+((n-1 )/ P))</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>           n = Required SKUs</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>           P = Population size (Active SKUs per warehouse)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Gap : difference between skus counted and required skus to be counted</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Statistical Accuracy :  1 - margin of error genrated from counted SKUs</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>(Note: Margin of error here is calculated by replacing N with the distinct SKUs counted and solving for e using the formula above)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Central Notes : comments generated based on the gap in SKUs counted</run>
              <run>Æ&#10;&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='41889' id='6' type-v2='empty' w='98934' x='533' y='57222'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
