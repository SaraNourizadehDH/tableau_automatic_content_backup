      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1729sj216dcyfk1csswyr18jja07].[sum:distinct_skus:qk]&quot;' value='Distinct SKUs' />
        </aliases>
      </column>
      <column caption='SKU Defect Rate - Tableau' datatype='real' name='[Calculation_1432074369529860096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([defect_skus])/SUM([distinct_skus])' />
      </column>
      <column caption='Item Level Defect Rate (Gross)' datatype='real' name='[Calculation_1432074369530474497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([abs_unit_discrepancy])/SUM([on_hand_qty])' />
      </column>
      <column caption='SKU Defect Rate - l4w' datatype='real' name='[Calculation_1432074369532399619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([sku_defect_rate_wk1])&#10;+SUM([sku_defect_rate_wk2])&#10;+SUM([sku_defect_rate_wk3])&#10;+SUM([sku_defect_rate_wk4])) / 4' />
      </column>
      <column caption='SKU Defect Rate ' datatype='real' name='[Calculation_1432074369536335876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([sku_defect_rate])' />
      </column>
      <column caption='Required SKU Counts' datatype='real' name='[Calculation_1432074369537359878]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SQUARE(1.96)*[Calculation_1432074369532399619] *(1-[Calculation_1432074369532399619] ))/SQUARE(0.05)' />
      </column>
      <column caption='Distinct SKUs Counted' datatype='real' name='[Calculation_1432074369538408457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([distinct_skus])' />
      </column>
      <column caption='SKUs Counted Statistical Accuracy' datatype='real' name='[Calculation_1432074369538961419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-(SQRT((SQUARE(1.96)*[Calculation_1432074369532399619]*(1-[Calculation_1432074369532399619]))/([Calculation_1432074369538408457])))' />
      </column>
      <column caption='Stores with no Gap' datatype='real' name='[Calculation_1432074369690079246]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF ([Required SKU Counts (copy)_1432074369538650122] &gt;= 0) THEN MAX([warehouse_id]) END)' />
      </column>
      <column caption='Is Compliant' datatype='string' name='[Calculation_1432074369782411281]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Required SKU Counts (copy)_1432074369538650122] &gt;= 0 THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
      </column>
      <column caption='Compliance Check' datatype='integer' name='[Calculation_1432074370041794580]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Required SKU Counts (copy)_1432074369538650122] &gt;= 0 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Item Level Defect Rate (Net)' datatype='real' name='[Item Level Defect Rate (Gross) (copy)_1432074369531105282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unit_discrepancy])/SUM([on_hand_qty])' />
      </column>
      <column caption='Required SKU Counts (Adj)' datatype='real' name='[Required SKU Counts (copy)_1432074369537495047]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1432074369537359878]/(1+(([Calculation_1432074369537359878]-1)/MAX([warehouse_skus])))' />
      </column>
      <column caption='Required SKU Counts Gap' datatype='real' name='[Required SKU Counts (copy)_1432074369538650122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1432074369538408457]-[Required SKU Counts (copy)_1432074369537495047]' />
      </column>
      <column caption='Stores with no Gap (copy)' datatype='integer' name='[Stores with no Gap (copy)_1432074369691131919]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([Required SKU Counts (copy)_1432074369538650122] &gt;= 0) THEN 1 ELSE 0 END' />
      </column>
