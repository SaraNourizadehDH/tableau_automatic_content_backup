      <column-instance column='[distinct_skus]' derivation='Sum' name='[sum:distinct_skus:qk]' pivot='key' type='quantitative' />
      <group name='[User Filter 1]' name-style='unqualified' user:ui-builder='identity-set'>
        <groupfilter function='intersection'>
          <groupfilter function='level-members' level='[global_entity_id]' />
          <groupfilter function='union'>
            <groupfilter expression='false' function='filter'>
              <groupfilter function='level-members' level='[global_entity_id]' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;gsr_dmart_ PY_CR&apos;)' function='filter'>
              <groupfilter function='member' level='[global_entity_id]' member='&quot;PY_CR&quot;' />
