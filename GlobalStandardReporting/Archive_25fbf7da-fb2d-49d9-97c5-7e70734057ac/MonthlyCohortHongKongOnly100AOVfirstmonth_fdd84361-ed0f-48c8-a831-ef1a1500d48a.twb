            <column>[federated.05ygp2a1a0hyle1g9af330fxb4w3].[none:sub_entity:nk]</column>
            <column>[federated.05ygp2a1a0hyle1g9af330fxb4w3].[none:management_entity:nk]</column>
            <column>[federated.05ygp2a1a0hyle1g9af330fxb4w3].[none:is_voucher:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
