    <worksheet name='Reorder Rate '>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff' fontsize='16'>Monthly Cohorts - &lt;</run>
            <run fontcolor='#ffffff' fontsize='16'>[Parameters].[Parameter 4]</run>
            <run fontcolor='#ffffff' fontsize='16'>&gt;</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontsize='8'>KPI Definitions</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontsize='8'>Reorder Rate: </run>
            <run fontsize='8'>Active customers divided by cohort acquisitions</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>Reorder Rate Exc. Vouchers: </run>
            <run fontsize='8'>Active customers (not using a voucher within the month) divided by cohort acquisitions</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>Reorder Rate From Vouchers: </run>
            <run fontsize='8'>Active customers (using a voucher within the month) divided by cohort acquisitions</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>Cumulative Reorder Rate: </run>
            <run fontsize='8'>Cumulative unique active customers making reorders divided by cohort acquisitions</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>Active Customers: </run>
            <run fontsize='8'>Number of unique users who ordered in the reporting month</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>Acquisitions:</run>
            <run fontsize='8'> Number of customers who placed their first successful order during the period (For these cohorts, Month 0), where a customer is defined as a distinct Analytical Costumer ID,</run>
            <run fontcolor='#ffffff' fontsize='8'>Æ </run>
            <run auto-url='true' fontcolor='#ffffff' fontsize='8' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/presentation/d/19zkaMmm42CPz9Os5sJZIEhlA1RPmbvFwThO2LR-9X9g&amp;quot;'>https://docs.google.com/presentation/d/19zkaMmm42CPz9Os5sJZIEhlA1RPmbvFwThO2LR-9X9g</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontsize='8'>NOTE: </run>
            <run fontsize='8'>Month 0 is not shown for reorder rate</run>
            <run>Æ&#10;&#10;&#10;</run>
          </formatted-text>
        </caption>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.com/t/GlobalStandardReporting/workbooks/MonthlyCohort_1/ReorderRate?rev=' id='ReorderRate_1' path='/t/GlobalStandardReporting/workbooks/MonthlyCohort_1' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='cohorts_monthly_platform (cl_intl_markets)' name='federated.05ygp2a1a0hyle1g9af330fxb4w3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Reorder Rate KPI' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Reorder Rate&quot;'>
              <calculation class='tableau' formula='&quot;Reorder Rate&quot;' />
            </column>
            <column caption='Cohort Granularity' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column caption='Header Switch' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;Sub Entity&quot;'>
              <calculation class='tableau' formula='&quot;Sub Entity&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05ygp2a1a0hyle1g9af330fxb4w3'>
            <column caption='Acquisition Customers for Calc' datatype='integer' name='[Acquisitions for Calc (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM(IIF([month_number]=0, [customers],0)))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Header' datatype='string' name='[Calculation_384917097103093761]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;WHEN &apos;DH Group&apos; THEN &apos;DH Group&apos;&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#10;WHEN &apos;Sub Entity&apos; THEN [sub_entity]&#10;END' />
            </column>
            <column caption='First Order Year' datatype='integer' name='[Calculation_5674605952235618304]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='YEAR([first_order_month])' />
            </column>
            <column caption='Acq. Date Switch' datatype='string' name='[Calculation_5674605952238977025]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 7] = &apos;Month&apos;, LEFT(str([first_order_month]), 7),&#10;IIF([Parameters].[Parameter 7] = &apos;Quarter&apos;, str([first_order_quarter]),&#10;IIF([Parameters].[Parameter 7] = &apos;Semester&apos;, str([first_order_semester]),&#10;str([Calculation_5674605952235618304]))))' />
            </column>
            <column caption='Reorder Rate KPI' datatype='real' default-format='p0.0%' name='[Calculation_8710807220150253]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 4] &#13;&#10;    when &apos;Reorder Rate&apos; then &#13;&#10;        SUM(IF [month_number] = 0 THEN NULL ELSE [return_customers] END)&#13;&#10;&#9;/&#13;&#10;&#9;[Acquisitions for Calc (copy)]&#10;    when &apos;Reorder Rate Exc. Vouchers&apos; then &#10;        SUM(IF [month_number] = 0 THEN NULL ELSE [return_customers]-[return_customers_vouchers] END)&#10;        / &#10;        [Acquisitions for Calc (copy)]&#10;    when &apos;Reorder Rate From Vouchers&apos; then &#10;        SUM(IF [month_number] = 0 THEN NULL ELSE [return_customers_vouchers] END)&#10;        / &#10;        [Acquisitions for Calc (copy)]&#10; &#13;&#10;    when &apos;Cumulative Reorder Rate&apos; then &#13;&#10;        SUM([cumulative_users])&#13;&#10;&#9;/&#13;&#10;&#9;[Acquisitions for Calc (copy)]  &#10;end' scope-isolation='false'>
                <table-calc ordering-type='Rows' />
