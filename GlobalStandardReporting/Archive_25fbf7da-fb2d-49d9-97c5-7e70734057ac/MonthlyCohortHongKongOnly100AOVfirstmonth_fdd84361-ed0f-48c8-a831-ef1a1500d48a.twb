    <worksheet name='Fully Loaded Gross Profit'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff' fontsize='16'>Monthly Cohorts - Gross Profit per order</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontsize='8'>KPI Definitions</run>
