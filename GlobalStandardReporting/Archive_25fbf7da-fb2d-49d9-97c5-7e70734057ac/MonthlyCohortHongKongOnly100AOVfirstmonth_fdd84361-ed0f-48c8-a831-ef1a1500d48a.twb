            </column>
            <column caption='First Order Month' datatype='date' name='[first_order_month]' role='dimension' type='ordinal' />
            <column caption='First Order Quarter' datatype='string' name='[first_order_quarter]' role='dimension' type='nominal' />
            <column caption='First Order Semester' datatype='string' name='[first_order_semester]' role='dimension' type='nominal' />
            <column datatype='real' name='[gmv_eur_profit]' role='measure' type='quantitative' />
            <column caption='Gpo Eur' datatype='real' name='[gpo_eur]' role='measure' type='quantitative' />
            <column caption='Is Voucher' datatype='boolean' name='[is_voucher]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Month Number' datatype='integer' name='[month_number]' role='dimension' type='ordinal' />
