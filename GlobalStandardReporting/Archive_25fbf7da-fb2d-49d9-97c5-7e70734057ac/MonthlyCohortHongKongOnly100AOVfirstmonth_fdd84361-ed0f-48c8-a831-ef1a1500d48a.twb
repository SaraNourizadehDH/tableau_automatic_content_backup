    <worksheet name='Commission WS'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff' fontsize='16'>Monthly Cohorts - &lt;</run>
            <run fontcolor='#ffffff' fontsize='16'>[Parameters].[MPR Type (Kopie)]</run>
            <run fontcolor='#ffffff' fontsize='16'>&gt;</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontsize='8'>KPI Definitions</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontsize='8'>Commission: </run>
            <run fontsize='8'>The contracted fee paid by the restaurants per order for a specific service (e.g. placement on the portal, domain hosting, delivery etc). Note that this is calculated on successful orders in this report.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>Cumulative Commission / Acquisitions: </run>
            <run fontsize='8'>Cumulative commission revenue divided by cohort acquisitions. I.e. the amount of commission revenue generated by a customer in their lifetime until month X</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontsize='8'><![CDATA[>> exchange in EUR: daily fx rates provided by ECB <<]]></run>
            <run>Æ&#10;</run>
          </formatted-text>
        </caption>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.com/t/GlobalStandardReporting/workbooks/MonthlyCohort_1/Commission?rev=' id='Commission' path='/t/GlobalStandardReporting/workbooks/MonthlyCohort_1' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='cohorts_monthly_platform (cl_intl_markets)' name='federated.05ygp2a1a0hyle1g9af330fxb4w3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Commission Type' datatype='string' name='[MPR Type (Kopie)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Commission LC&quot;'>
              <calculation class='tableau' formula='&quot;Commission LC&quot;' />
              <aliases>
                <alias key='&quot;Commission EUR&quot;' value='Commission EUR' />
                <alias key='&quot;cum Commission / acquisition EUR&quot;' value='Cum. Comm. EUR / Acq.' />
                <alias key='&quot;cum Commission / acquisition LC&quot;' value='Cum. Comm. LC / Acq.' />
              </aliases>
            </column>
            <column caption='Cohort Granularity' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column caption='Header Switch' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;Sub Entity&quot;'>
              <calculation class='tableau' formula='&quot;Sub Entity&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05ygp2a1a0hyle1g9af330fxb4w3'>
            <column caption='Acquisition Customers for Calc' datatype='integer' name='[Acquisitions for Calc (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM(IIF([month_number]=0, [customers],0)))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Header' datatype='string' name='[Calculation_384917097103093761]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;WHEN &apos;DH Group&apos; THEN &apos;DH Group&apos;&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#10;WHEN &apos;Sub Entity&apos; THEN [sub_entity]&#10;END' />
            </column>
            <column caption='First Order Year' datatype='integer' name='[Calculation_5674605952235618304]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='YEAR([first_order_month])' />
            </column>
            <column caption='Acq. Date Switch' datatype='string' name='[Calculation_5674605952238977025]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 7] = &apos;Month&apos;, LEFT(str([first_order_month]), 7),&#10;IIF([Parameters].[Parameter 7] = &apos;Quarter&apos;, str([first_order_quarter]),&#10;IIF([Parameters].[Parameter 7] = &apos;Semester&apos;, str([first_order_semester]),&#10;str([Calculation_5674605952235618304]))))' />
            </column>
            <column caption='Commission KPIs (cum values)' datatype='real' name='[Commission KPIs (Kopie)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[MPR Type (Kopie)] &#13;&#10;&#13;&#10;    when &apos;cum Commission / acquisition LC&apos; then &#13;&#10;        SUM([cumulative_commission_lc])/[Acquisitions for Calc (copy)]&#13;&#10;    when &apos;cum Commission / acquisition EUR&apos; then &#13;&#10;        SUM([cumulative_commission_eur])/[Acquisitions for Calc (copy)]&#13;&#10;end'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Commission KPIs' datatype='real' name='[MPR KPIs (Kopie)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[MPR Type (Kopie)] &#10;    when &apos;Commission LC&apos; then &#13;&#10;        SUM([amt_commission_lc])&#10;    when &apos;Commission EUR&apos; then &#13;&#10;        SUM([amt_commission_eur])&#13;&#10;&#13;&#10;  //  when &apos;cum Commission / acquisition LC&apos; then &#13;&#10;//        sum([Inital Commission Revenue]+[Cum Commission Revenue])/sum([Acquisitions])&#13;&#10;//    when &apos;cum Commission / acquisition EUR&apos; then &#13;&#10;//        sum([inital_commission_revenue_eur]+[cum_commission_revenue_eur])/sum([Acquisitions])&#13;&#10;end' />
            </column>
            <column caption='Amt Commission Eur' datatype='real' name='[amt_commission_eur]' role='measure' type='quantitative' />
            <column caption='Amt Commission Lc' datatype='real' name='[amt_commission_lc]' role='measure' type='quantitative' />
            <column caption='Cumulative Commission Eur' datatype='real' name='[cumulative_commission_eur]' role='measure' type='quantitative' />
            <column caption='Cumulative Commission Lc' datatype='real' name='[cumulative_commission_lc]' role='measure' type='quantitative' />
            <column caption='Customers' datatype='integer' name='[customers]' role='measure' type='quantitative' />
            <column caption='First Order Month' datatype='date' name='[first_order_month]' role='dimension' type='ordinal' />
            <column caption='First Order Quarter' datatype='string' name='[first_order_quarter]' role='dimension' type='nominal' />
            <column caption='First Order Semester' datatype='string' name='[first_order_semester]' role='dimension' type='nominal' />
            <column caption='Is Voucher' datatype='boolean' name='[is_voucher]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Month Number' datatype='integer' name='[month_number]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_384917097103093761]' derivation='None' name='[none:Calculation_384917097103093761:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5674605952238977025]' derivation='None' name='[none:Calculation_5674605952238977025:nk]' pivot='key' type='nominal' />
            <column-instance column='[first_order_month]' derivation='None' name='[none:first_order_month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[is_voucher]' derivation='None' name='[none:is_voucher:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[month_number]' derivation='None' name='[none:month_number:ok]' pivot='key' type='ordinal' />
            <column-instance column='[sub_entity]' derivation='None' name='[none:sub_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[vertical (copy)_579697756310294531]' derivation='None' name='[none:vertical (copy)_579697756310294531:nk]' pivot='key' type='nominal' />
            <column-instance column='[vertical]' derivation='None' name='[none:vertical:nk]' pivot='key' type='nominal' />
            <column caption='Sub Entity' datatype='string' name='[sub_entity]' role='dimension' type='nominal' />
            <column-instance column='[Commission KPIs (Kopie)]' derivation='User' name='[usr:Commission KPIs (Kopie):qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.05ygp2a1a0hyle1g9af330fxb4w3].[Acquisitions for Calc (copy)]' ordering-type='Rows' />
            </column-instance>
            <column-instance column='[MPR KPIs (Kopie)]' derivation='User' name='[usr:MPR KPIs (Kopie):qk]' pivot='key' type='quantitative' />
            <column caption='vertical (copy)' datatype='string' name='[vertical (copy)_579697756310294531]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vertical]' />
            </column>
            <column datatype='string' name='[vertical]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;dmarts&quot;' value='Dmarts to Dmarts' />
                <alias key='&quot;local_stores&quot;' value='Local Stores to Local Stores' />
                <alias key='&quot;restaurants&quot;' value='Food to Food' />
              </aliases>
            </column>
          </datasource-dependencies>
          <filter class='relative-date' column='[federated.05ygp2a1a0hyle1g9af330fxb4w3].[none:first_order_month:qk]' filter-group='3' first-period='-3' include-future='true' include-null='false' last-period='0' period-type-v2='year' />
          <slices>
            <column>[federated.05ygp2a1a0hyle1g9af330fxb4w3].[none:vertical (copy)_579697756310294531:nk]</column>
            <column>[federated.05ygp2a1a0hyle1g9af330fxb4w3].[none:first_order_month:qk]</column>
