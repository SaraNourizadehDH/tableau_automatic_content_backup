      <aliases enabled='yes' />
      <column caption='Acquisition Customers for Calc Dmart' datatype='integer' name='[Acquisition Customers for Calc (copy)_579697756625264645]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM(IIF([month_number]=0, [customers_dmart],0)))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Acquisition Customers for Calc' datatype='integer' name='[Acquisitions for Calc (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM(IIF([month_number]=0, [customers],0)))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Activity KPI (copy)' datatype='real' name='[Activity KPI (copy)_579697756308267009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 5] &#10;    when &apos;Activity&apos; then &#10;        SUM([orders])&#10;        /&#10;        SUM([customers])&#10;    when &apos;Activity Exc. Vouchers&apos; then &#10;        (SUM([orders]) - SUM([reorders_vouchers]))&#10;        /&#10;        SUM([customers])&#10;    when &apos;Activity From Vouchers&apos; then &#10;        (SUM([reorders_vouchers]))&#10;        /&#10;        SUM([customers])&#10;end' />
      </column>
      <column caption='User Check' datatype='boolean' name='[Calculation_2837690039619956736]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() =  [username (gsr_entitlements_performance_global_entity_id)]' />
      </column>
      <column caption='Gross Profit per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3118813123408240642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gpo_eur]) / SUM([orders_profit])' />
      </column>
      <column caption='FLGPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3118813123413127172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([flgpo_eur])/SUM([orders_profit])' />
      </column>
      <column caption='Header' datatype='string' name='[Calculation_384917097103093761]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;WHEN &apos;DH Group&apos; THEN &apos;DH Group&apos;&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#10;WHEN &apos;Sub Entity&apos; THEN [sub_entity]&#10;END' />
      </column>
      <column caption='GP / GMV' datatype='real' default-format='p0.0%' name='[Calculation_4017210880378560512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gpo_eur])/SUM([gmv_eur_profit])' />
      </column>
      <column caption='FLGP / GMV' datatype='real' default-format='p0.0%' name='[Calculation_4017210880378621953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([flgpo_eur])/SUM([gmv_eur_profit])' />
      </column>
      <column caption='Placeholder link' datatype='string' name='[Calculation_4017210880384397314]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;&apos;' />
      </column>
      <column caption='Activity KPI' datatype='real' name='[Calculation_4616752602623627264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 5] &#10;    when &apos;Activity&apos; then &#10;        SUM([orders])&#10;        /&#10;        SUM([customers])&#10;    when &apos;Activity Exc. Vouchers&apos; then &#10;        (SUM([orders]) - SUM([reorders_vouchers]))&#10;        /&#10;        SUM([customers])&#10;    when &apos;Activity From Vouchers&apos; then &#10;        (SUM([reorders_vouchers]))&#10;        /&#10;        SUM([customers])&#10;end' />
      </column>
      <column caption='Order KPI' datatype='real' name='[Calculation_488218394875670529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;    WHEN &apos;Cumulative Orders&apos;    THEN SUM(ZN([cumulative_orders]))&#10;    WHEN &apos;Orders&apos;               THEN SUM([orders])&#13;&#10;END' />
      </column>
      <column caption='Username filter' datatype='boolean' name='[Calculation_5075345688706088960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
      </column>
      <column caption='First Order Year' datatype='integer' name='[Calculation_5674605952235618304]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='YEAR([first_order_month])' />
      </column>
      <column caption='Acq. Date Switch' datatype='string' name='[Calculation_5674605952238977025]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 7] = &apos;Month&apos;, LEFT(str([first_order_month]), 7),&#10;IIF([Parameters].[Parameter 7] = &apos;Quarter&apos;, str([first_order_quarter]),&#10;IIF([Parameters].[Parameter 7] = &apos;Semester&apos;, str([first_order_semester]),&#10;str([Calculation_5674605952235618304]))))' />
      </column>
      <column caption='ABV KPI' datatype='real' name='[Calculation_579697756308504578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &apos;ABV EUR&apos;&#10;THEN SUM([amt_gbv_eur])/SUM([orders])&#10;WHEN &apos;ABV LC&apos; THEN SUM([amt_gbv_lc])/SUM([orders])&#10;END' />
      </column>
      <column caption='AOV ' datatype='real' name='[Calculation_5800073427232825346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([amt_gmv_lc])/SUM([orders])' />
      </column>
      <column caption='Reorder Rate KPI' datatype='real' default-format='p0.0%' name='[Calculation_8710807220150253]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 4] &#13;&#10;    when &apos;Reorder Rate&apos; then &#13;&#10;        SUM(IF [month_number] = 0 THEN NULL ELSE [return_customers] END)&#13;&#10;&#9;/&#13;&#10;&#9;[Acquisitions for Calc (copy)]&#10;    when &apos;Reorder Rate Exc. Vouchers&apos; then &#10;        SUM(IF [month_number] = 0 THEN NULL ELSE [return_customers]-[return_customers_vouchers] END)&#10;        / &#10;        [Acquisitions for Calc (copy)]&#10;    when &apos;Reorder Rate From Vouchers&apos; then &#10;        SUM(IF [month_number] = 0 THEN NULL ELSE [return_customers_vouchers] END)&#10;        / &#10;        [Acquisitions for Calc (copy)]&#10; &#13;&#10;    when &apos;Cumulative Reorder Rate&apos; then &#13;&#10;        SUM([cumulative_users])&#13;&#10;&#9;/&#13;&#10;&#9;[Acquisitions for Calc (copy)]  &#10;end' scope-isolation='false'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Frequency KPI' datatype='real' name='[Calculation_8730807220230403]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 3] &#13;&#10;    when &apos;Frequency&apos; then &#13;&#10;        SUM([orders])&#10;&#9;/&#13;&#10;&#9;[Acquisitions for Calc (copy)]&#10;    when &apos;Frequency Exc. Vouchers&apos; then &#10;        (SUM([orders]) - SUM([reorders_vouchers]))&#10;&#9;/&#10;&#9;[Acquisitions for Calc (copy)]&#10;    when &apos;Frequency From Vouchers&apos; then &#10;        SUM([reorders_vouchers])&#10;&#9;/&#10;&#9;[Acquisitions for Calc (copy)]&#13;&#10;    when &apos;cum. Frequency&apos; then &#13;&#10;        SUM([cumulative_orders])&#13;&#10;&#9;/&#13;&#10;&#9;[Acquisitions for Calc (copy)]  &#13;&#10;end' scope-isolation='false'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='GMV KPIs' datatype='real' name='[Cohort KPI (Kopie)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Metric Type (Kopie)] &#10;    when &apos;GMV LC&apos; then &#13;&#10;        SUM([amt_gmv_lc])&#10;    when &apos;GMV EUR&apos; then &#13;&#10;        SUM([amt_gmv_eur])&#10;    when &apos;cum GMV / acquisition LC&apos; then &#13;&#10;        SUM([cumulative_gmv_lc])/[Acquisitions for Calc (copy)]&#13;&#10;    when &apos;cum GMV / acquisition EUR&apos; then &#13;&#10;        SUM([cumulative_gmv_eur])/[Acquisitions for Calc (copy)]&#13;&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Commission KPIs (cum values)' datatype='real' name='[Commission KPIs (Kopie)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[MPR Type (Kopie)] &#13;&#10;&#13;&#10;    when &apos;cum Commission / acquisition LC&apos; then &#13;&#10;        SUM([cumulative_commission_lc])/[Acquisitions for Calc (copy)]&#13;&#10;    when &apos;cum Commission / acquisition EUR&apos; then &#13;&#10;        SUM([cumulative_commission_eur])/[Acquisitions for Calc (copy)]&#13;&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
