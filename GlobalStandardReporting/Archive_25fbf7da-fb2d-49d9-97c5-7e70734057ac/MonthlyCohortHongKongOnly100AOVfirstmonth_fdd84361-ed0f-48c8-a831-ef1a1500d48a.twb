    <worksheet name='Frequency WS'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff' fontsize='16'>Monthly Cohorts - &lt;</run>
            <run fontcolor='#ffffff' fontsize='16'>[Parameters].[Parameter 3]</run>
            <run fontcolor='#ffffff' fontsize='16'>&gt;</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontsize='8'>KPI Definitions</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontsize='8'>Frequency: </run>
            <run fontsize='8'>Orders divided by cohort acquisitions</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>Frequency Exc. Vouchers:</run>
            <run fontsize='8'> (Orders - Reorders using a Voucher) divided by cohort acquisitions</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>Frequency From Vouchers:</run>
            <run fontsize='8'> Reorders using a Voucher divided by cohort acquisitions</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>Cumulative Frequency: </run>
            <run fontsize='8'>Cumulative orders divided by cohort acquisitions</run>
          </formatted-text>
        </caption>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/MonthlyCohort_1/FrequencyWS?rev=' id='FrequencyWS' path='/t/GlobalStandardReporting/workbooks/MonthlyCohort_1' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='cohorts_monthly_platform (cl_intl_markets)' name='federated.05ygp2a1a0hyle1g9af330fxb4w3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Frequency Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Frequency&quot;'>
              <calculation class='tableau' formula='&quot;Frequency&quot;' />
              <aliases>
                <alias key='&quot;cum. Frequency&quot;' value='Cumulative Frequency' />
              </aliases>
            </column>
            <column caption='Cohort Granularity' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column caption='Header Switch' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;Sub Entity&quot;'>
              <calculation class='tableau' formula='&quot;Sub Entity&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05ygp2a1a0hyle1g9af330fxb4w3'>
            <column caption='Acquisition Customers for Calc' datatype='integer' name='[Acquisitions for Calc (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM(IIF([month_number]=0, [customers],0)))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Header' datatype='string' name='[Calculation_384917097103093761]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;WHEN &apos;DH Group&apos; THEN &apos;DH Group&apos;&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#10;WHEN &apos;Sub Entity&apos; THEN [sub_entity]&#10;END' />
            </column>
            <column caption='First Order Year' datatype='integer' name='[Calculation_5674605952235618304]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='YEAR([first_order_month])' />
            </column>
            <column caption='Acq. Date Switch' datatype='string' name='[Calculation_5674605952238977025]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 7] = &apos;Month&apos;, LEFT(str([first_order_month]), 7),&#10;IIF([Parameters].[Parameter 7] = &apos;Quarter&apos;, str([first_order_quarter]),&#10;IIF([Parameters].[Parameter 7] = &apos;Semester&apos;, str([first_order_semester]),&#10;str([Calculation_5674605952235618304]))))' />
            </column>
            <column caption='Frequency KPI' datatype='real' name='[Calculation_8730807220230403]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 3] &#13;&#10;    when &apos;Frequency&apos; then &#13;&#10;        SUM([orders])&#10;&#9;/&#13;&#10;&#9;[Acquisitions for Calc (copy)]&#10;    when &apos;Frequency Exc. Vouchers&apos; then &#10;        (SUM([orders]) - SUM([reorders_vouchers]))&#10;&#9;/&#10;&#9;[Acquisitions for Calc (copy)]&#10;    when &apos;Frequency From Vouchers&apos; then &#10;        SUM([reorders_vouchers])&#10;&#9;/&#10;&#9;[Acquisitions for Calc (copy)]&#13;&#10;    when &apos;cum. Frequency&apos; then &#13;&#10;        SUM([cumulative_orders])&#13;&#10;&#9;/&#13;&#10;&#9;[Acquisitions for Calc (copy)]  &#13;&#10;end' scope-isolation='false'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Cumulative Orders' datatype='real' name='[cumulative_orders]' role='measure' type='quantitative' />
            <column caption='Customers' datatype='integer' name='[customers]' role='measure' type='quantitative' />
            <column caption='First Order Month' datatype='date' name='[first_order_month]' role='dimension' type='ordinal' />
