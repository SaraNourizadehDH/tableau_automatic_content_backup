              <calculation class='tableau' formula='CASE [Parameters].[Parameter 8]&#10;WHEN &apos;DH Group&apos; THEN &apos;DH Group&apos;&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#10;WHEN &apos;Sub Entity&apos; THEN [sub_entity]&#10;END' />
            </column>
            <column caption='Order KPI' datatype='real' name='[Calculation_488218394875670529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;    WHEN &apos;Cumulative Orders&apos;    THEN SUM(ZN([cumulative_orders]))&#10;    WHEN &apos;Orders&apos;               THEN SUM([orders])&#13;&#10;END' />
