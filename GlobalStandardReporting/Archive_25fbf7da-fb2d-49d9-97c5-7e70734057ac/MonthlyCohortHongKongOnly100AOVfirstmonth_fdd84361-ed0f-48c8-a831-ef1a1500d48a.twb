          <calculation class='tableau' formula='&quot;GMV LC&quot;' />
          <aliases>
            <alias key='&quot;cum GMV / acquisition EUR&quot;' value='Cum. GMV EUR / Acq.' />
            <alias key='&quot;cum GMV / acquisition LC&quot;' value='Cum. GMV LC / Acq.' />
            <alias key='&quot;GMV EUR&quot;' value='GMV EUR' />
