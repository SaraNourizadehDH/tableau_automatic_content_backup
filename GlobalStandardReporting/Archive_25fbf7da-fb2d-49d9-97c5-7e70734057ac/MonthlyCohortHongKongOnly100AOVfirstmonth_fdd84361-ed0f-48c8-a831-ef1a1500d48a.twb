            <column caption='vertical (copy)' datatype='string' name='[vertical (copy)_579697756310294531]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vertical]' />
            </column>
            <column datatype='string' name='[vertical]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;dmarts&quot;' value='Dmarts to Dmarts' />
                <alias key='&quot;local_stores&quot;' value='Local Stores to Local Stores' />
                <alias key='&quot;restaurants&quot;' value='Food to Food' />
              </aliases>
            </column>
