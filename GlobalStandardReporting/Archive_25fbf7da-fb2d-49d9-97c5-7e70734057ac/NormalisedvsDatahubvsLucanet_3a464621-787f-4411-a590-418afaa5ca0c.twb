  <worksheets>
    <worksheet name='Line'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Difference in % between Normalised order profitability and non-normalised</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='order_profit_normalised_checks (cl_intl_markets)' name='federated.17nqg2210zfpku0zk1gtv1w6ixcn' />
          </datasources>
          <datasource-dependencies datasource='federated.17nqg2210zfpku0zk1gtv1w6ixcn'>
            <column caption='% Commission new vs old ' datatype='real' default-format='p0%' name='[% Commission Gsheet vs  order profit new (copy)_960322275686690817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_eur_new]) / SUM([commission_eur_datahub]) - 1' />
            </column>
            <column caption='% DH Incentives new vs old' datatype='real' default-format='p0%' name='[% DH Incentives vs order profit new (copy)_960322275686690818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ABS([dh_basket_incentives_eur_new])) / SUM(ABS([dh_basket_incetives_eur_datahub])) - 1' />
            </column>
            <column caption='% Delivery Costs new vs old' datatype='real' default-format='p0%' name='[% Delivery Costs vs order profit new (copy)_960322275686690819]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ABS([delivery_costs_eur_new])) / SUM([delivery_costs_eur_datahub]) - 1' />
            </column>
            <column caption='% Delivery Fee  new vs old' datatype='real' default-format='p0%' name='[% Delivery Fee  vs order profit new (copy)_960322275686690820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_gross_eur_new]) / SUM([delivery_fee_eur_datahub]) - 1' />
            </column>
            <column caption='Commission Eur Datahub' datatype='real' default-format='n#,##0;-#,##0' name='[commission_eur_datahub]' role='measure' type='quantitative' />
