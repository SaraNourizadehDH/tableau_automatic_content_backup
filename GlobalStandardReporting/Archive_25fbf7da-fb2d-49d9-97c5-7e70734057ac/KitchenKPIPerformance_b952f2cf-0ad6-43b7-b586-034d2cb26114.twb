      <column caption='Select Order Penetration' datatype='real' name='[Area Penetration (copy)_2248140677213704208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [vendor_id] &lt;&gt; &apos;non gfs&apos; AND YEAR([report_date]) = [Parameters].[Current Month (copy)_2248140677182447623] &#10;         AND MONTH([report_date]) = [Parameters].[Report Date 1 (copy)] THEN [successful_order_count] END)&#10;/&#10;SUM(IF [vendor_id] = &apos;non gfs&apos; AND YEAR([report_date]) = [Parameters].[Current Month (copy)_2248140677182447623] &#10;         AND MONTH([report_date]) = [Parameters].[Report Date 1 (copy)] THEN [successful_order_count] END)' />
      </column>
      <column caption='Average Food Rating' datatype='real' name='[Average Food Rating (copy)_4531254581003710466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='5*sum([converted_rating_total])/sum([rated_orders_count])' />
      </column>
      <column caption='Select AOV Kitchen' datatype='real' name='[Average Order Value (copy)_2248140677238784024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([report_date]) = [Parameters].[Current Month (copy)_2248140677182447623] &#10;         AND MONTH([report_date]) = [Parameters].[Report Date 1 (copy)] AND [vendor_id] &lt;&gt; &apos;non gfs&apos; THEN [gmv_eur] END) &#10;/&#10;SUM(IF YEAR([report_date]) = [Parameters].[Current Month (copy)_2248140677182447623] &#10;         AND MONTH([report_date]) = [Parameters].[Report Date 1 (copy)] AND [vendor_id] &lt;&gt; &apos;non gfs&apos; THEN [successful_order_count] END)' />
      </column>
      <column caption='Kitchen Analysis' datatype='real' name='[Average Order Value (copy)_2248140678238838871]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Reorder Definition Basic (copy)]&#10;    WHEN &apos;Avg. Order Value&apos; THEN&#10;(SUM([gmv_eur]) &#10;/&#10;SUM([successful_order_count]))&#10;    WHEN &apos;Order Performance&apos; THEN&#10;SUM([successful_order_count])&#10;    WHEN &apos;Share of DH subsidies (€% of GMV)&apos; THEN&#10;((SUM([discount_dh_eur]) + SUM([voucher_dh_eur]))&#10;/&#10;SUM([gmv_eur]))*100&#10;    WHEN &apos;Avg. CVR&apos; THEN&#10;(SUM([transactions])/ SUM([menu]))*100&#10;    WHEN &apos;Sessions per kitchen&apos; THEN&#10;SUM([transactions])&#10;    WHEN &apos;30d reorder share&apos; THEN&#10;(SUM([Calculation_2248140678000836662])&#10;/ &#10;SUM([Calculation_2248140678005985335]))*100&#10;    WHEN &apos;Avg. Food Rating&apos; THEN &#10;5*sum([converted_rating_total])/sum([rated_orders_count])&#10;    WHEN &apos;Avg. Fail Rate&apos; THEN &#10;(sum([failed_order_count]) / sum([successful_order_count]))*100&#10;    WHEN &apos;Avg. Delivery Time&apos; THEN&#10;((sum([delivery_time_m_sum])/sum([delivery_time_m_count]))&#10;/&#10;60)&#10;END' />
      </column>
      <column caption='Select Brand Count' datatype='integer' name='[Brand Count (copy)_2248140677219618838]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF YEAR([report_date]) = [Parameters].[Current Month (copy)_2248140677182447623] &#10;         AND MONTH([report_date]) = [Parameters].[Report Date 1 (copy)]&#10;AND [vendor_id] &lt;&gt; &apos;non gfs&apos; THEN [vendor_id] END)' />
      </column>
      <column caption='Select CVR Kitchen' datatype='real' name='[CVR (copy)_2248140677259841572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF YEAR([report_date]) = [Parameters].[Current Month (copy)_2248140677182447623] &#10;         AND MONTH([report_date]) = [Parameters].[Report Date 1 (copy)] AND [vendor_id] &lt;&gt; &apos;non gfs&apos; THEN&#10;[transactions] END)&#10;/ &#10;SUM(IF YEAR([report_date]) = [Parameters].[Current Month (copy)_2248140677182447623] &#10;         AND MONTH([report_date]) = [Parameters].[Report Date 1 (copy)] AND [vendor_id] &lt;&gt; &apos;non gfs&apos; THEN&#10;[menu] END)' />
      </column>
      <column caption='Report Month' datatype='datetime' default-format='*Mmm-YYYY' name='[Calculation_1004795348754661378]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[report_date])' />
      </column>
      <column caption='Fail Rate' datatype='real' name='[Calculation_2248140677174681600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([failed_order_count]) / sum([successful_order_count])' />
      </column>
      <column caption='Date Current Month - Current Year' datatype='date' name='[Calculation_2248140677182926856]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='MAKEDATE([Parameters].[Current Month (copy)_2248140677182447623],[Parameters].[Report Date 1 (copy)],1)&#10;//[Data Selection]' />
      </column>
      <column caption='Date Previous Month' datatype='datetime' name='[Calculation_2248140677202747404]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;month&apos;,-1,[Calculation_2248140677182926856])' />
      </column>
      <column caption='1' datatype='integer' name='[Calculation_2248140677269659690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Reorder_aux_basic' datatype='integer' name='[Calculation_2248140678000836662]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Current Year (copy)] = &quot;Reorder Share&quot;&#10;THEN [returning_customer_restaurant]&#10;ELSEIF [Parameters].[Current Year (copy)] = &quot;Customer 30d Rest Lead&quot;&#10;THEN [customer_reorders_same_restaurant_30]&#10;ELSEIF [Parameters].[Current Year (copy)] = &quot;Customer 30d Rest FTC&quot;&#10;THEN [customer_reorders_same_restaurant_30_ft]&#10;ELSEIF [Parameters].[Current Year (copy)] = &quot;Customer 30d Platform Lead&quot;&#10;THEN [customer_reorders_30]&#10;ELSEIF [Parameters].[Current Year (copy)] = &quot;Customer 30d Platform FTC&quot;&#10;THEN [customer_reorders_30_ft]&#10;END' />
      </column>
      <column caption='Order Aux basic' datatype='integer' name='[Calculation_2248140678005985335]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Current Year (copy)] = &quot;Reorder Share&quot;&#10;THEN [new_customer_restaurant] + [returning_customer_restaurant]&#10;ELSEIF [Parameters].[Current Year (copy)] = &quot;Customer 30d Rest Lead&quot;&#10;THEN [customers]&#10;ELSEIF [Parameters].[Current Year (copy)] = &quot;Customer 30d Platform Lead&quot;&#10;THEN [customers]&#10;ELSEIF [Parameters].[Current Year (copy)] = &quot;Customer 30d Rest FTC&quot;&#10;THEN [ft_customers]&#10;ELSEIF [Parameters].[Current Year (copy)] = &quot;Customer 30d Platform FTC&quot;&#10;THEN [ft_customers]&#10;END' />
      </column>
      <column caption='Reorder Rate' datatype='real' name='[Calculation_2248140678006423608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;[Calculation_2248140678000836662]&#10;)&#10;/ SUM([Calculation_2248140678005985335])' />
      </column>
      <column caption='KPI Measure' datatype='string' name='[Calculation_2248140678022369364]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Reorder Definition Basic (copy)]' />
      </column>
      <column caption='calc after' datatype='string' name='[Calculation_2248140678585503837]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Reorder Definition Basic (copy)]&#10;    WHEN &apos;Share of DH subsidies (€% of GMV)&apos; THEN &apos;%&apos;&#10;    WHEN &apos;Avg. CVR&apos; THEN &apos;%&apos;&#10;    WHEN &apos;30d reorder share&apos; THEN &apos;%&apos;&#10;    WHEN &apos;Avg. Fail Rate&apos; THEN &apos;%&apos;&#10;    WHEN &apos;Avg. Delivery Time&apos; THEN &apos;m&apos;&#10;END' />
      </column>
      <column caption='Stalls' datatype='integer' name='[Calculation_2683723201189658624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([stall_no])&#10;//{EXCLUDE [Vendor Id]: MAX([Stall No])}' />
      </column>
      <column caption='assigned stall' datatype='integer' name='[Calculation_2683723201189847041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [primary_fg]=&apos;primary&apos; and [vendor_id]&lt;&gt;&apos;Unassigned Vendor&apos; and [vendor_id]&lt;&gt;&apos;non gfs&apos; THEN [vendor_id] END)' />
      </column>
      <column caption='Occupancy' datatype='real' name='[Calculation_2683723201190404098]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2683723201189847041] / [Calculation_2683723201189658624]' />
      </column>
      <column caption='Average Order Value' datatype='real' name='[Calculation_2683723201194512387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_eur]) &#10;/&#10;SUM([successful_order_count])' />
      </column>
      <column caption='Subsidies %' datatype='real' name='[Calculation_2683723201195098116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([discount_dh_eur]) + SUM([voucher_dh_eur]))&#10;/&#10;SUM([gmv_eur])' />
      </column>
      <column caption='Average Delivery Time' datatype='real' name='[Calculation_2683723201195909126]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([delivery_time_m_sum])&#10;/&#10;sum([delivery_time_m_count]))&#10;/&#10;60' />
      </column>
      <column caption='vendorshow' datatype='string' name='[Calculation_2683723202249756681]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Vendor Id Set] then &apos;&apos; else &apos;dont show&apos; END' />
      </column>
      <column caption='Kitchen_Area' datatype='string' name='[Calculation_4531254581001322497]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [vendor_id] =&apos;non gfs&apos; THEN &apos;Area&apos; ELSE &apos;Kitchen&apos; END' />
      </column>
