    <worksheet name='General_order'>
      <repository-location id='General_order' path='/t/GlobalStandardReporting/workbooks/KitchenKPIPerformance_16457137753820' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='kitchen_monthly_report1 (gfs_bi)' name='federated.0mquc0l0oxcttb1anvede1tvda2b' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='2021' caption='Current Year' datatype='integer' name='[Current Month (copy)_2248140677182447623]' param-domain-type='list' role='measure' type='quantitative' value='2021'>
              <calculation class='tableau' formula='2021' />
              <aliases>
                <alias key='2021' value='2021' />
                <alias key='2022' value='2022' />
              </aliases>
            </column>
            <column alias='Nov' caption='Current Month' datatype='integer' name='[Report Date 1 (copy)]' param-domain-type='list' role='measure' type='quantitative' value='11'>
              <calculation class='tableau' formula='11' />
              <aliases>
                <alias key='1' value='Jan' />
                <alias key='2' value='Feb' />
                <alias key='3' value='Mar' />
                <alias key='4' value='Apr' />
                <alias key='5' value='May' />
                <alias key='6' value='Jun' />
                <alias key='7' value='Jul' />
                <alias key='8' value='Aug' />
                <alias key='9' value='Sep' />
                <alias key='10' value='Oct' />
                <alias key='11' value='Nov' />
                <alias key='12' value='Dec' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0mquc0l0oxcttb1anvede1tvda2b'>
            <column caption='Select Order Penetration' datatype='real' name='[Area Penetration (copy)_2248140677213704208]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vendor_id] &lt;&gt; &apos;non gfs&apos; AND YEAR([report_date]) = [Parameters].[Current Month (copy)_2248140677182447623] &#10;         AND MONTH([report_date]) = [Parameters].[Report Date 1 (copy)] THEN [successful_order_count] END)&#10;/&#10;SUM(IF [vendor_id] = &apos;non gfs&apos; AND YEAR([report_date]) = [Parameters].[Current Month (copy)_2248140677182447623] &#10;         AND MONTH([report_date]) = [Parameters].[Report Date 1 (copy)] THEN [successful_order_count] END)' />
            </column>
            <column caption='Select AOV Kitchen' datatype='real' name='[Average Order Value (copy)_2248140677238784024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([report_date]) = [Parameters].[Current Month (copy)_2248140677182447623] &#10;         AND MONTH([report_date]) = [Parameters].[Report Date 1 (copy)] AND [vendor_id] &lt;&gt; &apos;non gfs&apos; THEN [gmv_eur] END) &#10;/&#10;SUM(IF YEAR([report_date]) = [Parameters].[Current Month (copy)_2248140677182447623] &#10;         AND MONTH([report_date]) = [Parameters].[Report Date 1 (copy)] AND [vendor_id] &lt;&gt; &apos;non gfs&apos; THEN [successful_order_count] END)' />
            </column>
            <column caption='Select Brand Count' datatype='integer' name='[Brand Count (copy)_2248140677219618838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF YEAR([report_date]) = [Parameters].[Current Month (copy)_2248140677182447623] &#10;         AND MONTH([report_date]) = [Parameters].[Report Date 1 (copy)]&#10;AND [vendor_id] &lt;&gt; &apos;non gfs&apos; THEN [vendor_id] END)' />
            </column>
            <column caption='Select CVR Kitchen' datatype='real' name='[CVR (copy)_2248140677259841572]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF YEAR([report_date]) = [Parameters].[Current Month (copy)_2248140677182447623] &#10;         AND MONTH([report_date]) = [Parameters].[Report Date 1 (copy)] AND [vendor_id] &lt;&gt; &apos;non gfs&apos; THEN&#10;[transactions] END)&#10;/ &#10;SUM(IF YEAR([report_date]) = [Parameters].[Current Month (copy)_2248140677182447623] &#10;         AND MONTH([report_date]) = [Parameters].[Report Date 1 (copy)] AND [vendor_id] &lt;&gt; &apos;non gfs&apos; THEN&#10;[menu] END)' />
            </column>
            <column caption='Date Current Month - Current Year' datatype='date' name='[Calculation_2248140677182926856]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='MAKEDATE([Parameters].[Current Month (copy)_2248140677182447623],[Parameters].[Report Date 1 (copy)],1)&#10;//[Data Selection]' />
            </column>
            <column caption='Date Previous Month' datatype='datetime' name='[Calculation_2248140677202747404]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;month&apos;,-1,[Calculation_2248140677182926856])' />
            </column>
            <column caption='Select Orders Per Brand' datatype='real' name='[Orders Per Brand (copy)_2248140677218500627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([report_date]) = [Parameters].[Current Month (copy)_2248140677182447623] &#10;         AND MONTH([report_date]) = [Parameters].[Report Date 1 (copy)]&#10;            AND [vendor_id] &lt;&gt; &apos;non gfs&apos; &#10;                THEN [successful_order_count] ELSE NULL END)&#10;/&#10;COUNTD(IF YEAR([report_date]) = [Parameters].[Current Month (copy)_2248140677182447623] &#10;         AND MONTH([report_date]) = [Parameters].[Report Date 1 (copy)]&#10;AND [vendor_id] &lt;&gt; &apos;non gfs&apos; THEN [vendor_id] END)' />
            </column>
            <column caption='Select AOV Kitchen Change' datatype='real' name='[Select AOV Kitchen (Reference) (copy)_2248140677239816218]' role='measure' type='quantitative'>
