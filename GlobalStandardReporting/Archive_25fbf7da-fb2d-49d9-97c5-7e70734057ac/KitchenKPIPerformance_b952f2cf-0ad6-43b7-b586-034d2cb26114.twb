    <worksheet name='Kitchen Graph'>
      <repository-location id='KitchenGraph' path='/t/GlobalStandardReporting/workbooks/KitchenKPIPerformance_16457137753820' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='kitchen_monthly_report1 (gfs_bi)' name='federated.0mquc0l0oxcttb1anvede1tvda2b' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Reorder rate to restaurant (30d) [first time customers]' caption='Reorder Definition Basic' datatype='string' name='[Current Year (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Customer 30d Rest FTC&quot;'>
              <calculation class='tableau' formula='&quot;Customer 30d Rest FTC&quot;' />
              <aliases>
                <alias key='&quot;Customer 30d Platform FTC&quot;' value='Reorder rate to platform (30d) [first time customers]' />
                <alias key='&quot;Customer 30d Platform Lead&quot;' value='Reorder rate to platform (30d) [all customers]' />
                <alias key='&quot;Customer 30d Rest FTC&quot;' value='Reorder rate to restaurant (30d) [first time customers]' />
                <alias key='&quot;Customer 30d Rest Lead&quot;' value='Reorder rate to restaurant (30d) [all customers]' />
                <alias key='&quot;Reorder Share&quot;' value='Reorder Share' />
              </aliases>
            </column>
            <column alias='Order Performance' caption='KPI Selection' datatype='string' name='[Reorder Definition Basic (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Order Performance&quot;'>
              <calculation class='tableau' formula='&quot;Order Performance&quot;' />
              <aliases>
                <alias key='&quot;Avg. CVR&quot;' value='Avg. CVR' />
                <alias key='&quot;Avg. Order Value&quot;' value='Avg. Order Value' />
                <alias key='&quot;Order Performance&quot;' value='Order Performance' />
                <alias key='&quot;Sessions per kitchen&quot;' value='Sessions per kitchen' />
                <alias key='&quot;Share of DH subsidies (€\% of GMV)&quot;' value='Share of DH subsidies (€% of GMV)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0mquc0l0oxcttb1anvede1tvda2b'>
            <column caption='Kitchen Analysis' datatype='real' name='[Average Order Value (copy)_2248140678238838871]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Reorder Definition Basic (copy)]&#10;    WHEN &apos;Avg. Order Value&apos; THEN&#10;(SUM([gmv_eur]) &#10;/&#10;SUM([successful_order_count]))&#10;    WHEN &apos;Order Performance&apos; THEN&#10;SUM([successful_order_count])&#10;    WHEN &apos;Share of DH subsidies (€% of GMV)&apos; THEN&#10;((SUM([discount_dh_eur]) + SUM([voucher_dh_eur]))&#10;/&#10;SUM([gmv_eur]))*100&#10;    WHEN &apos;Avg. CVR&apos; THEN&#10;(SUM([transactions])/ SUM([menu]))*100&#10;    WHEN &apos;Sessions per kitchen&apos; THEN&#10;SUM([transactions])&#10;    WHEN &apos;30d reorder share&apos; THEN&#10;(SUM([Calculation_2248140678000836662])&#10;/ &#10;SUM([Calculation_2248140678005985335]))*100&#10;    WHEN &apos;Avg. Food Rating&apos; THEN &#10;5*sum([converted_rating_total])/sum([rated_orders_count])&#10;    WHEN &apos;Avg. Fail Rate&apos; THEN &#10;(sum([failed_order_count]) / sum([successful_order_count]))*100&#10;    WHEN &apos;Avg. Delivery Time&apos; THEN&#10;((sum([delivery_time_m_sum])/sum([delivery_time_m_count]))&#10;/&#10;60)&#10;END' />
            </column>
            <column caption='Reorder_aux_basic' datatype='integer' name='[Calculation_2248140678000836662]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Current Year (copy)] = &quot;Reorder Share&quot;&#10;THEN [returning_customer_restaurant]&#10;ELSEIF [Parameters].[Current Year (copy)] = &quot;Customer 30d Rest Lead&quot;&#10;THEN [customer_reorders_same_restaurant_30]&#10;ELSEIF [Parameters].[Current Year (copy)] = &quot;Customer 30d Rest FTC&quot;&#10;THEN [customer_reorders_same_restaurant_30_ft]&#10;ELSEIF [Parameters].[Current Year (copy)] = &quot;Customer 30d Platform Lead&quot;&#10;THEN [customer_reorders_30]&#10;ELSEIF [Parameters].[Current Year (copy)] = &quot;Customer 30d Platform FTC&quot;&#10;THEN [customer_reorders_30_ft]&#10;END' />
            </column>
            <column caption='Order Aux basic' datatype='integer' name='[Calculation_2248140678005985335]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Current Year (copy)] = &quot;Reorder Share&quot;&#10;THEN [new_customer_restaurant] + [returning_customer_restaurant]&#10;ELSEIF [Parameters].[Current Year (copy)] = &quot;Customer 30d Rest Lead&quot;&#10;THEN [customers]&#10;ELSEIF [Parameters].[Current Year (copy)] = &quot;Customer 30d Platform Lead&quot;&#10;THEN [customers]&#10;ELSEIF [Parameters].[Current Year (copy)] = &quot;Customer 30d Rest FTC&quot;&#10;THEN [ft_customers]&#10;ELSEIF [Parameters].[Current Year (copy)] = &quot;Customer 30d Platform FTC&quot;&#10;THEN [ft_customers]&#10;END' />
            </column>
            <column caption='calc after' datatype='string' name='[Calculation_2248140678585503837]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Reorder Definition Basic (copy)]&#10;    WHEN &apos;Share of DH subsidies (€% of GMV)&apos; THEN &apos;%&apos;&#10;    WHEN &apos;Avg. CVR&apos; THEN &apos;%&apos;&#10;    WHEN &apos;30d reorder share&apos; THEN &apos;%&apos;&#10;    WHEN &apos;Avg. Fail Rate&apos; THEN &apos;%&apos;&#10;    WHEN &apos;Avg. Delivery Time&apos; THEN &apos;m&apos;&#10;END' />
            </column>
            <column caption='Kitchen_Area' datatype='string' name='[Calculation_4531254581001322497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [vendor_id] =&apos;non gfs&apos; THEN &apos;Area&apos; ELSE &apos;Kitchen&apos; END' />
            </column>
            <column caption='calc before' datatype='string' name='[calc after (copy)_2248140678586073182]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Reorder Definition Basic (copy)]&#10;    WHEN &apos;Avg. Order Value&apos; THEN &apos;€&apos;&#10;END' />
            </column>
            <column caption='City' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Converted Rating Total' datatype='real' name='[converted_rating_total]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[customer_reorders_30]' role='measure' type='quantitative' />
            <column datatype='integer' name='[customer_reorders_30_ft]' role='measure' type='quantitative' />
            <column datatype='integer' name='[customer_reorders_same_restaurant_30]' role='measure' type='quantitative' />
            <column datatype='integer' name='[customer_reorders_same_restaurant_30_ft]' role='measure' type='quantitative' />
            <column datatype='integer' name='[customers]' role='measure' type='quantitative' />
            <column caption='Delivery Time M Count' datatype='integer' name='[delivery_time_m_count]' role='measure' type='quantitative' />
            <column caption='Delivery Time M Sum' datatype='integer' name='[delivery_time_m_sum]' role='measure' type='quantitative' />
            <column caption='Discount Dh Eur' datatype='real' name='[discount_dh_eur]' role='measure' type='quantitative' />
            <column caption='Failed Order Count' datatype='integer' name='[failed_order_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[ft_customers]' role='measure' type='quantitative' />
            <column caption='Gmv Eur' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column caption='Kitchen Go Live Date' datatype='date' name='[kitchen_go_live_date]' role='dimension' type='ordinal' />
            <column caption='Kitchen Name' datatype='string' name='[kitchen_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column datatype='integer' name='[menu]' role='measure' type='quantitative' />
            <column datatype='integer' name='[new_customer_restaurant]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2248140678585503837]' derivation='None' name='[none:Calculation_2248140678585503837:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4531254581001322497]' derivation='None' name='[none:Calculation_4531254581001322497:nk]' pivot='key' type='nominal' />
            <column-instance column='[calc after (copy)_2248140678586073182]' derivation='None' name='[none:calc after (copy)_2248140678586073182:nk]' pivot='key' type='nominal' />
            <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[kitchen_go_live_date]' derivation='None' name='[none:kitchen_go_live_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[kitchen_name]' derivation='None' name='[none:kitchen_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
