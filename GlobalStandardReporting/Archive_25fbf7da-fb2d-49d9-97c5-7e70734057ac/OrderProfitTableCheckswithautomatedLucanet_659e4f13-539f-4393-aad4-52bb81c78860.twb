    <worksheet name='Normalised Difference'>
      <layout-options>
        <title>
          <formatted-text>
            <run>% Between Lucanet-OP-DWH on normalised metrics
</run>
            <run fontsize='8'>(Commission Revenue;Delivery Costs; Delivery Fee; DH Incentives)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='order_profit_agg_2 (order_profit)' name='federated.17s2e7h060ene011tcez80g4join' />
          </datasources>
          <datasource-dependencies datasource='federated.17s2e7h060ene011tcez80g4join'>
            <column caption='% CR LN VS OP' datatype='real' default-format='p0%' name='[% CR LN VS DWH (copy)_2452139668955648001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_revenue_eur_ln])/SUM([commission_eur]) - 1' />
            </column>
            <column caption='% CR OP VS DWH ' datatype='real' default-format='p0%' name='[% CR LN VS DWH (copy)_2452139668955697154]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_eur])/SUM([non_normalised_amt_commission_eur]) - 1' />
            </column>
            <column caption='% Delivery Costs LN VS DWH ' datatype='real' default-format='p0%' name='[% CR LN VS DWH (copy)_2452139668955889669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_costs_eur_ln])/SUM([non_normalised_amt_delivery_costs_eur]) - 1' />
            </column>
            <column caption='% Delivery Costs LN VS OP ' datatype='real' default-format='p0%' name='[% CR LN VS OP (copy)_2452139668955889667]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_costs_eur_ln])/SUM([delivery_costs_eur]) - 1' />
            </column>
            <column caption='% Delivery Costs OP VS DWH ' datatype='real' default-format='p0%' name='[% CR OP vs DWH  (copy)_2452139668955889668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_costs_eur])/SUM([non_normalised_amt_delivery_costs_eur]) - 1' />
            </column>
            <column caption='% Delivery Fee LN VS DWH' datatype='real' default-format='p0%' name='[% Delivery Costs LN VS DWH  (copy)_2452139668956135430]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_eur_ln])/SUM([non_normalised_amt_delivery_fee_gross_eur]) - 1' />
            </column>
            <column caption='% Delivery Fee LN VS OP  ' datatype='real' default-format='p0%' name='[% Delivery Costs LN VS OP  (copy)_2452139668956135431]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_eur_ln])/SUM([delivery_fee_eur]) - 1' />
            </column>
            <column caption='% Delivery Fee OP vs DWH  ' datatype='real' default-format='p0%' name='[% Delivery Costs OP vs DWH  (copy)_2452139668956135432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_eur])/SUM([non_normalised_amt_delivery_fee_gross_eur]) - 1' />
            </column>
            <column caption='% DH Incentives LN VS OP' datatype='real' default-format='p0%' name='[% Delivery Fee LN VS DWH (copy)_2452139668956336137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dh_basket_incentives_eur_ln])/SUM([amt_dh_basket_incentives_eur]) - 1' />
            </column>
            <column caption='% DH Incentives LN VS DWH' datatype='real' default-format='p0%' name='[% Delivery Fee LN VS OP   (copy)_2452139668956336138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dh_basket_incentives_eur_ln])/SUM([non_normalised_amt_dh_basket_incentives_eur]) - 1' />
            </column>
            <column caption='% DH Incentives OP VS DWH   ' datatype='real' default-format='p0%' name='[% Delivery Fee OP vs DWH   (copy)_2452139668956336139]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3213247987360210945])/SUM([non_normalised_amt_dh_basket_incentives_eur]) - 1' />
            </column>
            <column caption='DH Platform' datatype='string' name='[Calculation_2299791341020700672]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;All Markets&apos;' />
            </column>
            <column caption='% CR LN VS DWH' datatype='real' default-format='p0%' name='[Calculation_2452139668955553792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_revenue_eur_ln])/SUM([non_normalised_amt_commission_eur]) - 1' />
            </column>
            <column caption='DH Incentives' datatype='real' name='[Calculation_3213247987360210945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[dh_voucher_eur] + [dh_discount_eur]' />
            </column>
            <column caption='Sub Entity (copy)' datatype='string' name='[Sub Entity (copy)_2452139668970467340]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[sub_entity]' />
            </column>
            <column datatype='real' name='[amt_dh_basket_incentives_eur]' role='measure' type='quantitative' />
            <column caption='Commission Eur' datatype='real' name='[commission_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[commission_revenue_eur_ln]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Delivery Costs Eur' datatype='real' name='[delivery_costs_eur]' role='measure' type='quantitative' />
            <column datatype='integer' name='[delivery_costs_eur_ln]' role='measure' type='quantitative' />
            <column caption='Delivery Fee Eur' datatype='real' name='[delivery_fee_eur]' role='measure' type='quantitative' />
