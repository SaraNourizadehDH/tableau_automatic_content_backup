    <worksheet name='Own Delivery'>
      <table>
        <view>
          <datasources>
            <datasource caption='order_profit_agg_2 (order_profit)' name='federated.17s2e7h060ene011tcez80g4join' />
          </datasources>
          <datasource-dependencies datasource='federated.17s2e7h060ene011tcez80g4join'>
            <column caption='v2 Comm Rev. per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3209166585658212354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_eur]) / SUM([orders])' />
            </column>
            <column caption='v2 Delivery Fee Net per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3209166585658429443]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_net_eur]) / SUM([orders])' />
            </column>
            <column caption='v2 Card Fee Revenue CPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3209166585658974212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([card_fee_revenue_cpo_eur]) / SUM([orders])' />
            </column>
            <column caption='v2 Other Revenue CPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3209166585659023365]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([other_revenue_cpo_eur]) / SUM([orders])' />
            </column>
            <column caption='v2 Total Revenue Takein CPO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3209166585659097094]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([take_in_cpo__eur])/SUM([orders])' />
            </column>
            <column caption='v2 delivery costs ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3209166585659183111]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_costs_eur])/SUM([orders])' />
            </column>
            <column caption='v2 Payment Costs' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3209166585659244552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([payment_cpo_eur])/SUM([orders])' />
            </column>
            <column caption='v2 Food ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3209166585659310089]' role='measure' type='quantitative'>
