    <worksheet name='Roas vs Churn'>
      <table>
        <view>
          <datasources>
            <datasource caption='custom query cpc churn' name='federated.18qyf8g0p2p9k218rj6su11jjh45' />
          </datasources>
          <datasource-dependencies datasource='federated.18qyf8g0p2p9k218rj6su11jjh45'>
            <column caption='k' datatype='integer' name='[Calculation_3446590764215017474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='pre churned vendors - period' datatype='integer' name='[Calculation_6850256559137087489]' role='measure' type='quantitative'>
