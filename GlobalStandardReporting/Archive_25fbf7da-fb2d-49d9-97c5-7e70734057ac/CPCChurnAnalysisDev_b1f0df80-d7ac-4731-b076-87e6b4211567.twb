      <aliases enabled='yes' />
      <column caption='Vendor CVR%' datatype='real' name='[CVR% (copy)_6850256560523587597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='round((ZN([cpc_sent_orders]))/ZN([cpc_clicks]),2)' />
      </column>
      <column caption='% variations ROAS vs Net ROAS' datatype='real' default-format='p0.00%' name='[Calculation_3344274622821625857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Net ROAS (copy)_3344274622821273600]/[Calculation_3446590764192993280])-1' />
      </column>
      <column caption='ROAS AGG' datatype='real' name='[Calculation_3446590764192993280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([cpc_sent_gmv_eur]))/SUM(ZN([cpc_revenue]))' />
      </column>
      <column caption='k' datatype='integer' name='[Calculation_3446590764215017474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='revenue las 3 months' datatype='real' name='[Calculation_3446590764228550659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if DATEADD(&apos;month&apos;,-3,&#10;{ FIXED [vendor_id], [global_entity_id]: &#10;max(IF [last_activity_month]=&apos;Last active monht&apos; then [date_month] end)}&#10;) &gt;= [date_month] then [cpc_revenue]end' />
      </column>
      <column caption='Net ROAS' datatype='real' name='[Calculation_3479382610952040448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(zn(zn([commission_base_eur])-zn([commission_eur]))/ZN([cpc_revenue]),0)' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_6301872940311203841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='CPC / AOV' datatype='real' name='[Calculation_6301872940311314434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='round([cpc_price_eur_arithmetic_avg]/[aov],2)' />
      </column>
      <column caption='distinct vendors' datatype='integer' name='[Calculation_6850256559135481856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_id])' />
      </column>
      <column caption='pre churned vendors - period' datatype='integer' name='[Calculation_6850256559137087489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(if [last_activity_month]=&quot;Last active month&quot; then [vendor_id] END)' />
      </column>
      <column caption='vendors' datatype='integer' name='[Calculation_6850256559138570242]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([vendor_id])' />
      </column>
      <column caption='%pre churn' datatype='real' default-format='p0.0%' name='[Calculation_6850256559138861059]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6850256559137087489]/[Calculation_6850256559138570242]' />
      </column>
      <column caption='Global' datatype='string' name='[Calculation_6850256559393599497]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Delivery Hero&apos;' />
      </column>
      <column caption='AVG CPC' datatype='real' name='[Calculation_6850256559488507914]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([cpc_revenue]))/SUM(ZN([cpc_clicks]))' />
      </column>
      <column caption='CVR%' datatype='real' name='[Calculation_6850256560478601228]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([cpc_sent_orders]))/SUM(ZN([cpc_clicks]))' />
      </column>
      <column caption='#new advertiser' datatype='integer' name='[Calculation_6850256560534396942]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNT(if [new_advertiser] then [vendor_id] END)' />
      </column>
      <column caption='% new advertisers' datatype='real' name='[Calculation_6850256560534515727]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Calculation_6850256560534396942]))/(zn([Calculation_6850256559138570242]))' />
      </column>
      <column caption='Bucket' datatype='string' name='[Calculation_6850256560564428816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [CVR% (copy)_6850256560523587597] &lt;=0.05 and [ROAS AGG (copy)_6850256559150133254]&lt;3 then &apos;Too Bad&apos;&#10;ELSEIF [CVR% (copy)_6850256560523587597] &gt;=0.05 and [ROAS AGG (copy)_6850256559150133254]&lt;3 then &apos;Bad&apos;&#10;ELSEIF [CVR% (copy)_6850256560523587597] &lt;=0.05 and [ROAS AGG (copy)_6850256559150133254]&gt;=3 then &apos;Good&apos;&#10;ELSEIF [CVR% (copy)_6850256560523587597] &gt;=0.05 and [ROAS AGG (copy)_6850256559150133254]&gt;=3 then &apos;Very Good&apos;&#10;END' />
      </column>
      <column datatype='string' name='[Last two month before churn]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[before_last_activity_month]' new-bin='true'>
          <bin default-name='true' value='&quot;Last active month &amp; Previous last active month&quot;'>
            <value>&quot;Last active month&quot;</value>
            <value>&quot;Previous last active month&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='Net ROAS AGG' datatype='real' name='[Net ROAS (copy)_3344274622821273600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(zn(SUM(zn([commission_base_eur])-zn([commission_eur])))/SUM(ZN([cpc_revenue])),2)' />
      </column>
