    <worksheet name='Historical AOV Chart'>
      <table>
        <view>
          <datasources>
            <datasource caption='custom query cpc churn' name='federated.18qyf8g0p2p9k218rj6su11jjh45' />
          </datasources>
          <datasource-dependencies datasource='federated.18qyf8g0p2p9k218rj6su11jjh45'>
            <column caption='Vendor CVR%' datatype='real' name='[CVR% (copy)_6850256560523587597]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='round((ZN([cpc_sent_orders]))/ZN([cpc_clicks]),2)' />
            </column>
            <column caption='pre churned vendors - period' datatype='integer' name='[Calculation_6850256559137087489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(if [last_activity_month]=&quot;Last active month&quot; then [vendor_id] END)' />
            </column>
            <column caption='vendors' datatype='integer' name='[Calculation_6850256559138570242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([vendor_id])' />
            </column>
            <column caption='%pre churn' datatype='real' default-format='p0.0%' name='[Calculation_6850256559138861059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6850256559137087489]/[Calculation_6850256559138570242]' />
            </column>
            <column caption='Global' datatype='string' name='[Calculation_6850256559393599497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Delivery Hero&apos;' />
            </column>
            <column caption='AVG CPC' datatype='real' name='[Calculation_6850256559488507914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ZN([cpc_revenue]))/SUM(ZN([cpc_clicks]))' />
            </column>
            <column caption='ROAS ' datatype='real' name='[ROAS AGG (copy)_6850256559150133254]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='round(ZN([cpc_sent_gmv_eur])/ZN([cpc_revenue]),0)' />
            </column>
