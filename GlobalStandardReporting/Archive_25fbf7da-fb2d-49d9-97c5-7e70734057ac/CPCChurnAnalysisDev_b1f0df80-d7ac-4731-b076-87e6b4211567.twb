            <properties context=''>
              <relation connection='bigquery.0b5l0nz1n5lkb413d0xaf02sum7p' name='Custom SQL Query' type='text'>select *,
case when  
aov_percentile&gt;&gt;=0.9 THEN &apos;Tier 01&apos; when 
aov_percentile&gt;&gt;=0.8 THEN &apos;Tier 02&apos; when 
aov_percentile&gt;&gt;=0.7 THEN &apos;Tier 03&apos; when 
aov_percentile&gt;&gt;=0.6 THEN &apos;Tier 04&apos; when 
aov_percentile&gt;&gt;=0.5 THEN &apos;Tier 05&apos; when 
aov_percentile&gt;&gt;=0.4 THEN &apos;Tier 06&apos; when 
aov_percentile&gt;&gt;=0.3 THEN &apos;Tier 07&apos; when 
aov_percentile&gt;&gt;=0.2 THEN &apos;Tier 08&apos; when 
aov_percentile&gt;&gt;=0.1 THEN &apos;Tier 09&apos; else
&apos;Tier 10&apos; END tier
from `dhh-ncr-stg.analytics.cpc_churn_analysis`</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
