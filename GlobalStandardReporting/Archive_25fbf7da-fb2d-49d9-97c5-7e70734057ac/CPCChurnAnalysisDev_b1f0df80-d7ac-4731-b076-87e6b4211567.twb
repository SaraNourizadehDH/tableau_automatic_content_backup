          <named-connection caption='BigQuery' name='bigquery.0b5l0nz1n5lkb413d0xaf02sum7p'>
            <connection CATALOG='dhh-ncr-live' EXECCATALOG='dhh-ncr-live' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='dhh-ncr-live' schema='analytics' server-oauth='' username='ramiro.almasque@deliveryhero.com' workgroup-auth-mode='prompt' />
