      <column aggregation='Sum' caption='Summary Chart w prod Filter' datatype='integer' name='[Summary Chart wo prod Filter 1 (copy)_4581779302880468996]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF     [Parameters].[Parameter 3] = &apos;Line&apos; THEN 1 &#10;ELSEIF [Parameters].[Parameter 3] = &apos;Stacked Bar&apos; THEN 2 &#10;ELSEIF [Parameters].[Parameter 3] = &apos;Stacked Bar - 100%&apos; THEN 3&#10;ELSE 0 &#10;END' />
      </column>
      <column caption='TIM_DAY (copy) (copy) (copy)' datatype='string' name='[TIM_DAY (copy) (copy) (copy)_3713429060060246018]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if &#10;&#10;DATEDIFF(&apos;month&apos; , [Date of PIP acknowledgment (Final)], [tim_month_first_day] ) = 0 then &apos;M&apos;&#10;ELSEIF &#10;DATEDIFF(&apos;month&apos; , [Date of PIP acknowledgment (Final)], [tim_month_first_day] ) = 1 then &apos;M+1&apos;&#10;ELSEIF&#10;DATEDIFF(&apos;month&apos; , [Date of PIP acknowledgment (Final)], [tim_month_first_day] ) = 2 then &apos;M+2&apos;&#10;ELSEIF&#10;DATEDIFF(&apos;month&apos; , [Date of PIP acknowledgment (Final)], [tim_month_first_day] ) = 3 then &apos;M+3&apos;&#10;ELSEIF&#10;DATEDIFF(&apos;month&apos; , [Date of PIP acknowledgment (Final)], [tim_month_first_day] ) = -1 then &apos;M-1&apos;&#10; ELSEIF&#10;DATEDIFF(&apos;month&apos; , [Date of PIP acknowledgment (Final)], [tim_month_first_day] ) = -2 then &apos;M-2&apos;&#10;ELSE &#10;&apos;other&apos;&#10;END' />
      </column>
      <column caption='TIM_DAY (copy) (copy)' datatype='string' name='[TIM_DAY (copy) (copy)_601300978296004617]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if &#10;Datetrunc(&apos;month&apos;,[Date of PIP acknowledgment (Final)]) = DATETRUNC(&apos;month&apos;, [tim_month_first_day] ) then &apos;M&apos;&#10;ELSEIF&#10;Datetrunc(&apos;month&apos;,[Date of PIP acknowledgment (Final)]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -2, [tim_month_first_day] )) then &apos;M-2&apos;&#10;ELSEIF &#10;Datetrunc(&apos;month&apos;,[Date of PIP acknowledgment (Final)]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1,  [tim_month_first_day] )) then &apos;M-1&apos;&#10;ELSEIF &#10;Datetrunc(&apos;month&apos;,[Date of PIP acknowledgment (Final)]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 1,  [tim_month_first_day] )) then &apos;M+1&apos;&#10;ELSEIF &#10;Datetrunc(&apos;month&apos;,[Date of PIP acknowledgment (Final)]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 2, [tim_month_first_day] )) then &apos;M+2&apos;&#10;ELSEIF &#10;Datetrunc(&apos;month&apos;,[Date of PIP acknowledgment (Final)]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 3, [tim_month_first_day] )) then &apos;M+3&apos;&#10;&#10;&#10; &#10;ELSE &#10;&apos;other&apos;&#10;END' />
      </column>
      <column caption='TIM_DAY (copy)' datatype='date' name='[TIM_DAY (copy)_601300978194300932]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[tim_month_first_day]' />
      </column>
      <column caption='TIM_DAY - Last day of Month' datatype='date' name='[TIM_DAY (copy)_903956955318996992]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE( DATEADD(&apos;day&apos;,-1, DATEADD(&apos;month&apos;,1, DATETRUNC(&apos;month&apos;,[tim_month_first_day]) ) ) )' />
      </column>
