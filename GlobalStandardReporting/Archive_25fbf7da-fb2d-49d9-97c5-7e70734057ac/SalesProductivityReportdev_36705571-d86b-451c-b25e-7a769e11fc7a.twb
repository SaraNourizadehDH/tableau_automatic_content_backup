          </datasources>
          <datasource-dependencies datasource='federated.1dphh8i0jfrnjt10om4fi0ypt45f'>
            <column caption='Region 2' datatype='string' name='[Calculation_4581779302867017728]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[region]' />
            </column>
            <column datatype='date' datatype-customized='true' name='[Date of PIP acknowledgment (Final)]' role='dimension' type='ordinal' />
            <column caption='Name ' datatype='string' name='[Name (Final)]' role='dimension' type='nominal' />
            <column caption='SF user age buckets' datatype='string' name='[SF user age buckets (copy)_4055913677597335557]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([sf_created_date]) THEN &apos;Not Defined&apos;&#10;ELSEIF [TIM_DAY (copy)_903956955318996992] - [sf_created_date] &lt;= 180 THEN &apos;1-6 Months&apos;&#10;ELSEIF [TIM_DAY (copy)_903956955318996992] - [sf_created_date] &lt;= 360 THEN&#10; &apos;7-12 Months&apos;&#10;ELSE &apos;12+ Months&apos;&#10;END' />
            </column>
            <column caption='TIM_DAY (copy) (copy) (copy)' datatype='string' name='[TIM_DAY (copy) (copy) (copy)_3713429060060246018]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if &#10;&#10;DATEDIFF(&apos;month&apos; , [Date of PIP acknowledgment (Final)], [tim_month_first_day] ) = 0 then &apos;M&apos;&#10;ELSEIF &#10;DATEDIFF(&apos;month&apos; , [Date of PIP acknowledgment (Final)], [tim_month_first_day] ) = 1 then &apos;M+1&apos;&#10;ELSEIF&#10;DATEDIFF(&apos;month&apos; , [Date of PIP acknowledgment (Final)], [tim_month_first_day] ) = 2 then &apos;M+2&apos;&#10;ELSEIF&#10;DATEDIFF(&apos;month&apos; , [Date of PIP acknowledgment (Final)], [tim_month_first_day] ) = 3 then &apos;M+3&apos;&#10;ELSEIF&#10;DATEDIFF(&apos;month&apos; , [Date of PIP acknowledgment (Final)], [tim_month_first_day] ) = -1 then &apos;M-1&apos;&#10; ELSEIF&#10;DATEDIFF(&apos;month&apos; , [Date of PIP acknowledgment (Final)], [tim_month_first_day] ) = -2 then &apos;M-2&apos;&#10;ELSE &#10;&apos;other&apos;&#10;END' />
            </column>
            <column caption='TIM_DAY - Last day of Month' datatype='date' name='[TIM_DAY (copy)_903956955318996992]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE( DATEADD(&apos;day&apos;,-1, DATEADD(&apos;month&apos;,1, DATETRUNC(&apos;month&apos;,[tim_month_first_day]) ) ) )' />
            </column>
