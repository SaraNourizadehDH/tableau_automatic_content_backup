      <column caption='Role Type - Manual' datatype='string' name='[Calculation_2324631524153483265]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1]&#10;WHEN &apos;Seller - NonSeller&apos; THEN &#10;        IF      [central_job_role_manual] IN ( &apos;Field Sales Representatives (Restaurant)&apos;,&apos;Tele Sales Representatives (Restaurant)&apos;) THEN &apos;Seller&apos;&#10;        ELSEIF  [central_job_role_manual] IN ( &apos;Field Sales Representatives (Restaurant &amp; Shop)&apos;,&apos;Tele Sales Representatives (Restaurant &amp; Shop)&apos;) THEN &apos;Seller&apos;&#10;        ELSEIF  [central_job_role_manual] IN ( &apos;Field Sales Representatives (Shop)&apos;,&apos;Tele Sales Representatives (Shop)&apos;) THEN &apos;Seller&apos;&#10;        ELSE &apos;Non-Sellers&apos; &#10;        END&#10;WHEN &apos;Food - Shop - NonSeller&apos; THEN &#10;        IF      [central_job_role_manual] IN ( &apos;Field Sales Representatives (Restaurant)&apos;,&apos;Tele Sales Representatives (Restaurant)&apos;) THEN &apos;Food&apos;&#10;        ELSEIF  [central_job_role_manual] IN ( &apos;Field Sales Representatives (Restaurant &amp; Shop)&apos;,&apos;Tele Sales Representatives (Restaurant &amp; Shop)&apos;) THEN &apos;Food&apos;&#10;        ELSEIF  [central_job_role_manual] IN ( &apos;Field Sales Representatives (Shop)&apos;,&apos;Tele Sales Representatives (Shop)&apos;) THEN &apos;Shop&apos;&#10;        ELSE &apos;Non-Sellers&apos; &#10;        END&#10;WHEN &apos;Food - Hybrid - Shop - NonSeller&apos; THEN &#10;        IF      [central_job_role_manual] IN ( &apos;Field Sales Representatives (Restaurant)&apos;,&apos;Tele Sales Representatives (Restaurant)&apos;) THEN &apos;Food&apos;&#10;        ELSEIF  [central_job_role_manual] IN ( &apos;Field Sales Representatives (Restaurant &amp; Shop)&apos;,&apos;Tele Sales Representatives (Restaurant &amp; Shop)&apos;) THEN &apos;Hybrid&apos;&#10;        ELSEIF  [central_job_role_manual] IN ( &apos;Field Sales Representatives (Shop)&apos;,&apos;Tele Sales Representatives (Shop)&apos;) THEN &apos;Shop&apos;&#10;        ELSE &apos;Non-Sellers&apos; &#10;        END&#10;WHEN &apos;Central Job Role&apos; THEN [central_job_role_manual]&#10;END' />
      </column>
