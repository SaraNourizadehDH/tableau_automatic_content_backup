            <column caption='Region 2' datatype='string' name='[Calculation_4581779302867017728]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[region]' />
            </column>
            <column datatype='date' datatype-customized='true' name='[Date of PIP acknowledgment (Final)]' role='dimension' type='ordinal' />
