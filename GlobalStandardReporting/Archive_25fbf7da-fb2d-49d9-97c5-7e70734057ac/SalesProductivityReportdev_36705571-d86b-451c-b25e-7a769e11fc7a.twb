        <calculation class='tableau' formula='IF      [central_job_role_sf] IN ( &apos;Field Sales Representatives (Restaurant)&apos;,&apos;Tele Sales Representatives (Restaurant)&apos;,&apos;Field Sales Representative&apos;,&apos;Telesales Representative&apos;) THEN TRUE&#10;ELSEIF  [central_job_role_sf] IN ( &apos;Field Sales Representatives (Restaurant &amp; Shop)&apos;,&apos;Tele Sales Representatives (Restaurant &amp; Shop)&apos;) THEN TRUE&#10;ELSEIF  [central_job_role_sf] IN ( &apos;Field Sales Representatives (Shop)&apos;,&apos;Tele Sales Representatives (Shop)&apos;) THEN FALSE&#10;ELSE FALSE&#10;END' />
