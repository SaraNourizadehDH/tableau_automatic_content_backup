            <column-instance column='[Calculation_2324631524173017095]' derivation='Sum' name='[pcto:sum:Calculation_2324631524173017095:qk:2]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
            </column-instance>
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
