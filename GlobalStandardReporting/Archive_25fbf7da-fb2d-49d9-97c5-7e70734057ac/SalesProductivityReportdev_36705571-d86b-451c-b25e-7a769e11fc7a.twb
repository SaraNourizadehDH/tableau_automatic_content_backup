            <column-instance column='[job_role_vertical__c]' derivation='None' name='[none:job_role_vertical__c:nk]' pivot='key' type='nominal' />
            <column-instance column='[leadsource]' derivation='None' name='[none:leadsource:nk]' pivot='key' type='nominal' />
