      <column caption='Calc: % Search Appearence' datatype='real' name='[Calc: % Search Brand Conversion (copy)_3235484540083511307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Metric: Search Brand Appearence (copy)_3235484540082937866]&#10;    WHEN 0 THEN 0&#10;    ELSE [Calculation_3235484540079603720] / [Metric: Search Brand Appearence (copy)_3235484540082937866]&#10;END' />
      </column>
      <column caption='Calc: % Search Category Conversion' datatype='real' name='[Calc: % Search Brand Conversion (copy)_3235484540097982479]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Metric: Search Appearence (copy)_3235484540096831501]&#10;    WHEN 0 THEN 0&#10;    ELSE [Metric: Search Cat. Appearence (copy)_3235484540096966670] / [Metric: Search Appearence (copy)_3235484540096831501]&#10;END' />
      </column>
      <column caption='Calc: % Search Category Appearence' datatype='real' name='[Calc: % Search Category Conversion (copy)_3235484540098220048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Metric: Search Brand Appearence (copy)_3235484540082937866]&#10;    WHEN 0 THEN 0&#10;    ELSE [Metric: Search Appearence (copy)_3235484540096831501] / [Metric: Search Brand Appearence (copy)_3235484540082937866]&#10;END' />
      </column>
      <column caption='LOD: Search Appearence' datatype='real' name='[Calculation_3235484540015808512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [partition_date], [global_entity_id], [country], [platform], [search_term] : MEDIAN([nr_search_appeared_s]) }' />
      </column>
      <column caption='Period (YYYY-MM)' datatype='string' name='[Calculation_3235484540030357509]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, [partition_date])) &#10;&#9;+ STR(&quot;-&quot;) &#10;&#9;+ IF DATEPART(&apos;month&apos;, [partition_date]) &lt; 10 THEN STR(&quot;0&quot;) ELSE STR(&quot;&quot;) END&#10;&#9;+ STR(DATEPART(&apos;month&apos;, [partition_date]))' />
      </column>
      <column caption='Calc: % Search Brand Conversion' datatype='real' name='[Calculation_3235484540078018566]' role='measure' type='quantitative'>
