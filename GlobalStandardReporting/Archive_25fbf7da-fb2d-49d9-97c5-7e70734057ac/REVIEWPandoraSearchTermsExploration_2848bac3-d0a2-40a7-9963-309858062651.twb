      </column>
      <column caption='Metric: Search Brand Appearence' datatype='real' name='[Calculation_3235484540079603720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([LOD: Search Category Appearence (copy)_3235484540020084738])' />
