      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_251E58F08AF3467F8EDB2E1222D0FDC9'>
            <properties context=''>
              <relation connection='bigquery.0zvvqvt11cz6ey1gcy4un11183ue (copy)' name='Custom SQL Query' type='text'>with sessions as
 (SELECT DISTINCT
    ga.session_date AS date
    , REGEXP_EXTRACT((SELECT value FROM UNNEST(hits.custom_dimensions) WHERE index = 3), r&apos;(.*);&apos;) AS global_entity_id
    , REGEXP_EXTRACT((SELECT value FROM UNNEST(hits.custom_dimensions) WHERE index = 3), r&apos;;(.*)&apos;) AS vendor_id
    , ga.session_id
    , ga.user_id
    , device.device_category as device
    , CASE WHEN totals.bounces = 1 THEN TRUE ELSE FALSE END AS is_bounced_session
  FROM `fulfillment-dwh-production.cl_sales_revenue.vp_ga_sessions` AS ga
  CROSS JOIN UNNEST(ga.hits) AS hits
  WHERE TRUE
    AND ga.session_date &gt;&gt; &apos;2022-07-01&apos;
    AND (SELECT value FROM UNNEST(hits.custom_dimensions) WHERE index = 3) IS NOT NULL)
    

    SELECT date,global_entity_id,vendor_id,session_id,
    user_id
    FROM sessions
    WHERE sessions.global_entity_id=&apos;HS_SA&apos;</relation>
            </properties>
            <properties context='extract'>
              <relation name='_251E58F08AF3467F8EDB2E1222D0FDC9' table='[Extract].[_251E58F08AF3467F8EDB2E1222D0FDC9]' type='table' />
            </properties>
          </object>
