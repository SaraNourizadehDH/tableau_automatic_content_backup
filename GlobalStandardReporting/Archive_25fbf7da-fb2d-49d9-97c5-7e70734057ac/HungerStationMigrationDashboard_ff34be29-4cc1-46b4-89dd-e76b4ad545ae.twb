        <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 1]=&apos;Daily&apos; THEN [date]&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,date) &#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,date)&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Quarterly&apos; THEN DATETRUNC(&apos;quarter&apos;,date)&#10;END)' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1026891134600601602]' role='dimension' type='nominal'>
