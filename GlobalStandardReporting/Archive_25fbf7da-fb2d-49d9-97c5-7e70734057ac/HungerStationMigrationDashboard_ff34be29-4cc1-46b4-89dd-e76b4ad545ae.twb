    <datasource caption='Custom SQL Query+ (curated_data_shared_govops) (2)' inline='true' name='federated.106z0mj096ni430zm3gqs1nwtygk (copy)' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0zvvqvt11cz6ey1gcy4un11183ue'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh-ncr-live' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='curated_data_shared_govops' server-oauth='' username='beyazit.egilli@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0zvvqvt11cz6ey1gcy4un11183ue' name='Custom SQL Query' type='text'>with sessions as
 (SELECT DISTINCT
  PARSE_DATE(&apos;%Y%m%d&apos;, ga.date) AS session_date
      , SAFE_CAST(ga.fullVisitorId AS STRING) || SAFE_CAST(ga.visitId AS STRING) AS session_id
      , UPPER(
          SPLIT((SELECT value FROM UNNEST(ga.customDimensions) WHERE index = 1), &apos;-&apos;)[SAFE_OFFSET(0)]
        ) AS vp_region
      , REGEXP_REPLACE(
          (SELECT value FROM UNNEST(ga.customDimensions) WHERE index = 1),
          SPLIT((SELECT value FROM UNNEST(ga.customDimensions) WHERE index = 1), &apos;-&apos;)[SAFE_OFFSET(0)] || &apos;-&apos;, &apos;&apos;
        ) AS user_id
    , REGEXP_EXTRACT((SELECT value FROM UNNEST(ga.customDimensions) WHERE index = 7), r&apos;(.*);&apos;) AS global_entity_id
    , REGEXP_EXTRACT((SELECT value FROM UNNEST(ga.customDimensions) WHERE index = 7), r&apos;;(.*)&apos;) AS vendor_id
    ,hits.eventInfo.eventAction as event_action
    ,hits.eventInfo.eventCategory as event_category
  FROM `dhh---rps-portal.152897304.ga_sessions*` AS ga
  CROSS JOIN UNNEST(ga.hits) AS hits
    where 
      NOT (SELECT value FROM UNNEST(ga.customDimensions) WHERE index = 1) = &apos;&apos;
      AND NOT (SELECT value FROM UNNEST(ga.customDimensions) WHERE index = 1) IS NULL
   AND (SELECT value FROM UNNEST (ga.customDimensions) WHERE index = 7) IS NOT NULL)
    

    SELECT session_date,global_entity_id,vendor_id,session_id,
    user_id,event_action,event_category
    FROM sessions where session_date &gt;&gt; &apos;2022-07-01&apos; and sessions.global_entity_id=&apos;HS_SA&apos; and event_category=&apos;login&apos; and sessions.event_action=&apos;login.failed&apos;</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.0zvvqvt11cz6ey1gcy4un11183ue' name='Custom SQL Query' type='text'>with sessions as
 (SELECT DISTINCT
  PARSE_DATE(&apos;%Y%m%d&apos;, ga.date) AS session_date
      , SAFE_CAST(ga.fullVisitorId AS STRING) || SAFE_CAST(ga.visitId AS STRING) AS session_id
      , UPPER(
          SPLIT((SELECT value FROM UNNEST(ga.customDimensions) WHERE index = 1), &apos;-&apos;)[SAFE_OFFSET(0)]
        ) AS vp_region
      , REGEXP_REPLACE(
          (SELECT value FROM UNNEST(ga.customDimensions) WHERE index = 1),
          SPLIT((SELECT value FROM UNNEST(ga.customDimensions) WHERE index = 1), &apos;-&apos;)[SAFE_OFFSET(0)] || &apos;-&apos;, &apos;&apos;
        ) AS user_id
    , REGEXP_EXTRACT((SELECT value FROM UNNEST(ga.customDimensions) WHERE index = 7), r&apos;(.*);&apos;) AS global_entity_id
    , REGEXP_EXTRACT((SELECT value FROM UNNEST(ga.customDimensions) WHERE index = 7), r&apos;;(.*)&apos;) AS vendor_id
    ,hits.eventInfo.eventAction as event_action
    ,hits.eventInfo.eventCategory as event_category
  FROM `dhh---rps-portal.152897304.ga_sessions*` AS ga
  CROSS JOIN UNNEST(ga.hits) AS hits
    where 
      NOT (SELECT value FROM UNNEST(ga.customDimensions) WHERE index = 1) = &apos;&apos;
      AND NOT (SELECT value FROM UNNEST(ga.customDimensions) WHERE index = 1) IS NULL
   AND (SELECT value FROM UNNEST (ga.customDimensions) WHERE index = 7) IS NOT NULL)
    

    SELECT session_date,global_entity_id,vendor_id,session_id,
