        <objects>
          <object caption='Onboarding Email Sent' id='_D2B3574C78DD4BA59561AAEF33166A0A'>
            <properties context=''>
              <relation connection='bigquery.0zvvqvt11cz6ey1gcy4un11183ue (copy 2)' name='Custom SQL Query' type='text'>SELECT
global_entity_id, 
DATE(onboarding_email_sent_at) AS date,
vendor_id, 
user_id, 
keymaker_id 
FROM fulfillment-dwh-production.cl_sales_revenue.vp_users
JOIN UNNEST (vendors) as vendors
WHERE onboarding_email_sent_at &gt;&gt; &quot;2022-07-01&quot;
AND vendors.global_entity_id=&apos;HS_SA&apos;</relation>
            </properties>
            <properties context='extract'>
