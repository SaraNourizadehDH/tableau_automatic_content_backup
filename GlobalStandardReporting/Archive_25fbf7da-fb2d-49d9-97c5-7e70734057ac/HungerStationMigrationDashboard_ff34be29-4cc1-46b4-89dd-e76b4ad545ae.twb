      <aliases enabled='yes' />
      <column caption='% login fails / login attempts' datatype='real' name='[Calculation_227291106952515584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*COUNT(if [event_action (Custom SQL Query1)]=&apos;login.failed&apos; THEN[user_id (Custom SQL Query1)] END)/COUNT([user_id (Custom SQL Query1)])' />
      </column>
      <column caption='count of login attempts' datatype='integer' name='[Calculation_335799700208787456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([user_id (Custom SQL Query1)])' />
      </column>
      <column caption='Session Date' datatype='date' name='[Calculation_6999719732856360962]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 1]=&apos;Daily&apos; THEN [session_date (Custom SQL Query1)]&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[session_date (Custom SQL Query1)]) &#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[session_date (Custom SQL Query1)])&#10;ELSEIF  [Parameters].[Parameter 1]=&apos;Quarterly&apos; THEN DATETRUNC(&apos;quarter&apos;,[session_date (Custom SQL Query1)])&#10;END)' />
      </column>
