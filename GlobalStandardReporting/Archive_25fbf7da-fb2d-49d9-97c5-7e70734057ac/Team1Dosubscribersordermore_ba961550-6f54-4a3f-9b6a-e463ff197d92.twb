      <column caption='Non Subcribers' datatype='integer' name='[Calculation_395402039962062848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_customers] - [total_subscribers]' />
      </column>
      <column caption='GBV per Non Subscriber' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_395402039968329729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([total_total_gbv])-SUM([total_gbv_subscription])) / SUM([Calculation_395402039962062848])' />
      </column>
      <column caption='GBV per Customer' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_395402039968632834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_total_gbv])/ SUM([total_customers])' />
      </column>
      <column caption='GBV per Subscriber' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[GBV per Customer (copy)_395402039971373060]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_gbv_subscription])/ SUM([total_subscribers])' />
      </column>
      <column caption='GBV per Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[GBV per Customer (copy)_395402039973793799]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_total_gbv])/ SUM([total_orders])' />
      </column>
      <column caption='GBV per Non Sub. Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[GBV per Non Subscriber (copy)_395402039973601286]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([total_total_gbv])-SUM([total_gbv_subscription])) / (SUM([total_orders])-SUM([orders_in_subscription]))' />
      </column>
      <column caption='GBV per Sub. Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[GBV per Subscriber (copy)_395402039973433349]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_gbv_subscription])/ SUM([orders_in_subscription])' />
      </column>
