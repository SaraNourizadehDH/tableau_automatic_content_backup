      <column caption='Avg gap good' datatype='real' name='[Avg CR (below floor) (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [Calculation_610519279287406592]= &apos;Under&apos; THEN [floor_app]-[real_cr] ELSE NULL END)' />
      </column>
      <column caption='Avg. Com. rate gap' datatype='real' default-format='p0%' name='[Calculation_1209216551115952128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([Avg CR (below floor) (copy)])= TRUE THEN 0 ELSE [Avg CR (below floor) (copy)]END' />
      </column>
      <column caption='Key Account Sub Category' datatype='string' name='[Calculation_1229482711374094336]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([is_key_account] and (ISNULL([ka_sub_category]) or [ka_sub_category]=&apos;NULL&apos;)) then &apos;KA&apos; &#10;ELSEIF  [is_key_account] THEN [ka_sub_category] &#10;ELSE &apos;Non KA&apos;&#10;END' />
      </column>
      <column caption='KA under floor' datatype='integer' name='[Calculation_172262693930598404]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( if [is_key_account] and [Calculation_610519279287406592]= &apos;Under&apos; then [vendor_id] end)' />
      </column>
      <column caption='KA Restaurants' datatype='string' name='[Calculation_172262693931425798]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [is_key_account] then [vendor_id] end' />
      </column>
      <column caption='% KA under floor' datatype='real' name='[Calculation_172262693932040200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_172262693930598404])/ZN(countd([Calculation_172262693931425798]))' />
      </column>
      <column caption='% Non KA under floor' datatype='real' name='[Calculation_172262693932167177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn([KA above flor (copy)_172262693930889221])/zn(count([KA Restaurants (copy)_172262693931720711]))' />
      </column>
      <column caption='Exclusive Restaurants' datatype='integer' name='[Calculation_172262694163656717]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [exclusivity] then [vendor_id] END)' />
      </column>
      <column caption='% Exlusive restaurants' datatype='real' name='[Calculation_172262694164226062]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Zn([Calculation_172262694163656717])/zn(COUNTD([vendor_id]))' />
      </column>
      <column caption='Exclusive KA' datatype='string' name='[Calculation_172262694166073359]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [exclusivity] THEN [Calculation_172262693931425798] END' />
