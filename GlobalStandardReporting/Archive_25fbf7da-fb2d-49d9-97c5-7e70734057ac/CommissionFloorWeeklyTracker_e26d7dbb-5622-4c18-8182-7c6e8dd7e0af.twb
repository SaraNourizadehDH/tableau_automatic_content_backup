            <column caption='OD' datatype='boolean' name='[is_dh_delivery]' role='dimension' type='nominal' />
            <column-instance column='[start_date]' derivation='ISO-Week' name='[iwk:start_date:ok]' pivot='key' type='ordinal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
