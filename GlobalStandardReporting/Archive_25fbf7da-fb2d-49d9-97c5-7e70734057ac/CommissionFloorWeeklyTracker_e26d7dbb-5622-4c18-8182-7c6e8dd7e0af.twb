            <column caption='KA/Non KA' datatype='boolean' name='[is_key_account]' role='dimension' type='nominal' />
            <column-instance column='[start_date]' derivation='ISO-Week' name='[iwk:start_date:ok]' pivot='key' type='ordinal' />
            <column caption='Ka Sub Category' datatype='string' name='[ka_sub_category]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[discount_reason__c]' derivation='None' name='[none:discount_reason__c:nk]' pivot='key' type='nominal' />
