    <worksheet name='Avg Commission Below Floor MENA New'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff'>Avg CR - Below floor </run>
            <run fontcolor='#ffffff' fontsize='8'>[Contract commission]</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_new_signed_restaurants (tableau_report)' name='federated.1bpbycc0r1r7lr1fjd83e1eri2lw' />
          </datasources>
          <datasource-dependencies datasource='federated.1bpbycc0r1r7lr1fjd83e1eri2lw'>
            <column caption='Avg Com. rate  (below floor)' datatype='real' default-format='p0%' name='[Calculation_502714363548397568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [Calculation_610519279287406592]= &apos;Under&apos; THEN [Calculation_6697063779349319680] ELSE NULL END)' />
            </column>
            <column caption='Above/Below CR Floor' datatype='string' name='[Calculation_610519279287406592]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [display_name] = &apos;PY - Dominican Republic&apos; AND ([real_cr]+ 0.04000001&gt;=[floor_app]) THEN &apos;Above&apos;&#10;ELSEIF ([display_name] = &apos;PY - Nicaragua&apos; OR [display_name] = &apos;PY - Venezuela&apos;) AND ([real_cr]+ 0.05000001&gt;=[floor_app]) THEN &apos;Above&apos;&#10;ELSEIF ([display_name] &lt;&gt; &apos;PY - Dominican Republic&apos; OR [display_name] &lt;&gt; &apos;PY - Nicaragua&apos; OR  [display_name] &lt;&gt; &apos;PY - Venezuela&apos;)&#10;AND ([real_cr]+ 0.00000001&gt;=[floor_app]) THEN &apos;Above&apos; ELSE &apos;Under&apos; END' />
            </column>
            <column caption='CR' datatype='real' name='[Calculation_6697063779349319680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [display_name] = &apos;PY - Dominican Republic&apos; THEN [real_cr]+ 0.04&#10;ELSEIF [display_name] = &apos;PY - Nicaragua&apos; OR [display_name] = &apos;PY - Venezuela&apos; THEN [real_cr]+ 0.05&#10;ELSEIF ([display_name] &lt;&gt; &apos;PY - Dominican Republic&apos; OR [display_name] &lt;&gt; &apos;PY - Nicaragua&apos; OR  [display_name] &lt;&gt; &apos;PY - Venezuela&apos;)&#10;THEN [real_cr] END' />
            </column>
            <column caption='Distinct restaurants' datatype='integer' name='[Calculation_6810498219433623552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id])' />
            </column>
            <column caption='KA Restaurants commission' datatype='real' name='[KA Restaurants (copy)_172262693934014475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [is_key_account] then [Calculation_6697063779349319680] end' />
            </column>
            <column caption='Non KA Restaurants Commission Below floor' datatype='real' name='[KA Restaurants Commission Below floor (copy)_3645945381857910788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG( if [is_key_account]=FALSE and [Calculation_610519279287406592]=&apos;Under&apos; then [Calculation_6697063779349319680] end )' />
            </column>
            <column caption='KA Restaurants Commission Below floor' datatype='real' name='[Non KA Restaurants commission (copy)_3645945381854699523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG( if [is_key_account] and [Calculation_610519279287406592]=&apos;Under&apos; then [Calculation_6697063779349319680] end )' />
            </column>
            <column caption='Discount Reason' datatype='string' name='[discount_reason__c]' role='dimension' type='nominal' />
            <column caption='Sub Entity' datatype='string' name='[display_name]' role='dimension' type='nominal' />
            <column caption='Comm. Floor' datatype='real' name='[floor_app]' role='measure' type='quantitative' />
            <column caption='OD' datatype='boolean' name='[is_dh_delivery]' role='dimension' type='nominal' />
            <column caption='KA/Non KA' datatype='boolean' name='[is_key_account]' role='dimension' type='nominal' />
