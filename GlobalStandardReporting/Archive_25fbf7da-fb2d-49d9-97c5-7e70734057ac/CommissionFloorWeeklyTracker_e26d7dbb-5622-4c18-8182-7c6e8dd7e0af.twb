          <zone forceUpdate='true' h='6466' id='83' type-v2='text' w='98968' x='516' y='8267'>
            <formatted-text>
              <run fontalignment='0' fontsize='8'>This report has 4 sub-sections:</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontsize='8'>1) Summary- Floor compliance and KA acquisition share</run>
              <run fontalignment='0'>Æ&#10;</run>
              <run fontalignment='0' fontsize='8'>2) Avg. Contract CR(total and below floor acquisitions)</run>
              <run fontalignment='0'>Æ&#10;</run>
