    <worksheet name='Signed below floor'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Accounts Signed Below Floor</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_new_signed_restaurants (tableau_report)' name='federated.1bpbycc0r1r7lr1fjd83e1eri2lw' />
          </datasources>
          <datasource-dependencies datasource='federated.1bpbycc0r1r7lr1fjd83e1eri2lw'>
            <column caption='KA under floor' datatype='integer' name='[Calculation_172262693930598404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( if [is_key_account] and [Calculation_610519279287406592]= &apos;Under&apos; then [vendor_id] end)' />
            </column>
            <column caption='KA Restaurants' datatype='string' name='[Calculation_172262693931425798]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_key_account] then [vendor_id] end' />
            </column>
            <column caption='% KA under floor' datatype='real' name='[Calculation_172262693932040200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_172262693930598404])/ZN(countd([Calculation_172262693931425798]))' />
            </column>
            <column caption='% Non KA under floor' datatype='real' name='[Calculation_172262693932167177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn([KA above flor (copy)_172262693930889221])/zn(count([KA Restaurants (copy)_172262693931720711]))' />
            </column>
            <column caption='Above/Below CR Floor' datatype='string' name='[Calculation_610519279287406592]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [display_name] = &apos;PY - Dominican Republic&apos; AND ([real_cr]+ 0.04000001&gt;=[floor_app]) THEN &apos;Above&apos;&#10;ELSEIF ([display_name] = &apos;PY - Nicaragua&apos; OR [display_name] = &apos;PY - Venezuela&apos;) AND ([real_cr]+ 0.05000001&gt;=[floor_app]) THEN &apos;Above&apos;&#10;ELSEIF ([display_name] &lt;&gt; &apos;PY - Dominican Republic&apos; OR [display_name] &lt;&gt; &apos;PY - Nicaragua&apos; OR  [display_name] &lt;&gt; &apos;PY - Venezuela&apos;)&#10;AND ([real_cr]+ 0.00000001&gt;=[floor_app]) THEN &apos;Above&apos; ELSE &apos;Under&apos; END' />
            </column>
            <column caption='Restaurants Below ct' datatype='integer' name='[Calculation_610519279288807425]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_610519279287406592]= &apos;Under&apos; THEN [vendor_id] ELSE null END)' />
            </column>
            <column caption='% Rest Signed Below' datatype='real' name='[Calculation_610519279301619714]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn([Calculation_610519279288807425])/zn(([Calculation_6810498219433623552]))' />
            </column>
            <column caption='Distinct restaurants' datatype='integer' name='[Calculation_6810498219433623552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id])' />
            </column>
            <column caption='Non KA Restaurants' datatype='string' name='[KA Restaurants (copy)_172262693931720711]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_key_account]=FALSE then [vendor_id] end' />
            </column>
            <column caption='Non KA above floor' datatype='integer' name='[KA above flor (copy)_172262693930889221]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( if ([is_key_account]=FALSE) and [Calculation_610519279287406592]= &apos;Under&apos; then [vendor_id] end)' />
            </column>
            <column-instance column='[Calculation_172262693931425798]' derivation='CountD' name='[ctd:Calculation_172262693931425798:qk]' pivot='key' type='quantitative' />
            <column-instance column='[KA Restaurants (copy)_172262693931720711]' derivation='CountD' name='[ctd:KA Restaurants (copy)_172262693931720711:qk]' pivot='key' type='quantitative' />
