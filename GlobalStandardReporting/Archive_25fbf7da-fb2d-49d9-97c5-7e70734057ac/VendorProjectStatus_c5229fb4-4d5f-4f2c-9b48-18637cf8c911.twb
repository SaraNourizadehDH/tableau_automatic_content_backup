      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0zklgct1nmdkfn15pbjd40bqzea8]&quot;' value='EW' />
        </aliases>
      </column>
      <column caption='Color 1 - Status' datatype='string' name='[Calculation_6736611051162611714]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Status]&#10;    WHEN &quot;TO DO&quot; THEN &quot;GREY&quot;&#10;    WHEN &quot;IN PROGRESS&quot; THEN &quot;BLUE&quot;&#10;    ELSE &quot;GREEN&quot;&#10;END' />
      </column>
      <column caption='1' datatype='real' name='[Calculation_6736611051163013123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1.0' />
        <aliases>
          <alias key='1.0' value='Status' />
        </aliases>
      </column>
      <column caption='Total Projects' datatype='integer' name='[Calculation_6736611051189899272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Is Quarterly Item] = &apos;Yes&apos; &#10;        THEN 1&#10;    ELSE 0&#10;END)' />
      </column>
      <column caption='Color 2 - Current Phase' datatype='string' name='[Color 1 - Status (copy)_6736611051168260102]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Current Phase]&#10;    WHEN &quot;Exploration&quot; THEN &quot;BLUE&quot;&#10;    WHEN &quot;Development - RL&quot; THEN &quot;PURPLE&quot;&#10;    WHEN &quot;Development - Tableau&quot; THEN &quot;GOLD&quot;&#10;    WHEN &quot;Review - Internal&quot; THEN &quot;GOLD&quot;&#10;    WHEN &quot;Review - Exernal&quot; THEN &quot;YELLOW&quot;&#10;    WHEN &quot;Other&quot; THEN &quot;Orange&quot;&#10;    ELSE &quot;GREEN&quot;&#10;END' />
      </column>
      <column datatype='string' name='[On Track?]' role='dimension' type='nominal' />
      <column datatype='string' name='[Status]' role='dimension' type='nominal' />
