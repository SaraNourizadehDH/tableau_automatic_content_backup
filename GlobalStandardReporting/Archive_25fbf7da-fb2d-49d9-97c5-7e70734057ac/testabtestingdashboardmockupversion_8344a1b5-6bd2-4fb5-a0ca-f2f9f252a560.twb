  <datasources>
    <datasource caption='Custom SQL Query (monitoring)' inline='true' name='federated.1urckzz008plny10ljkit1n97vig' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.110ey321dbxpa21ecdlk81myxs38'>
            <connection CATALOG='log-data-science-staging' EXECCATALOG='logistics-data-staging-flat' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='log-data-science-staging' schema='monitoring' server-oauth='' username='juan.montero@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.110ey321dbxpa21ecdlk81myxs38' name='Custom SQL Query' type='text'>WITH
A_model_version AS (

  SELECT 
    CASE WHEN agg_level = &apos;global&apos; THEN &apos;global&apos;
        WHEN agg_level = &apos;region&apos; THEN region
        ELSE entities END AS country,
    start_date,
    end_date,
    version_a.model_version AS model_version,
    version_a.percentage AS percentage,
    version_a.aggregate AS aggregate,
    version_a.conf_int_lb AS conf_int_lb,
    version_a.conf_int_ub AS conf_int_ub,
    p,
    test,
    metric_name,
    metric_aggregation,
    version,
    description,
    test_name,
    owner,
    agg_level,
    created_date
  FROM `log-data-science-staging.monitoring.ab_test_results_test`
),

B_model_version AS (

  SELECT 
    CASE WHEN agg_level = &apos;global&apos; THEN &apos;global&apos;
        WHEN agg_level = &apos;region&apos; THEN region
        ELSE entities END AS country,
    start_date,
    end_date,
    version_b.model_version AS model_version,
    version_b.percentage AS percentage,
    version_b.aggregate AS aggregate,
    version_b.conf_int_lb AS conf_int_lb,
    version_b.conf_int_ub AS conf_int_ub,
    --
    p,
    test,
    metric_name,
    metric_aggregation,
    version,
    description,
    test_name,
    owner,
    agg_level,
    created_date
  FROM `log-data-science-staging.monitoring.ab_test_results_test`
),

all_version AS (

  SELECT * FROM A_model_version
  UNION ALL
  SELECT * FROM B_model_version

),

union_data AS (

    SELECT av.* FROM all_version av
    JOIN (
      SELECT
        test_name,
        MAX(created_date) AS max_created_date
      FROM all_version
      GROUP BY 1
    ) av1
    ON av.test_name = av1.test_name
    AND av.created_date = av1.max_created_date
)

SELECT * FROM union_data UNPIVOT(conf_interval FOR bound_type IN (conf_int_lb, conf_int_ub))</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
