            <formatted-text>
              <run bold='true' fontname='Times New Roman' fontsize='15'>DEFINITIONS</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontname='Times New Roman' fontsize='12'>Active warehouse: </run>
              <run fontname='Times New Roman' fontsize='10'>A warehouse with more than one order in the last seven days</run>
              <run>Æ&#10;</run>
              <run bold='true' fontname='Times New Roman' fontsize='12'>Closed warehouse: </run>
              <run fontname='Times New Roman' fontsize='10'>A warehouse with one or no orders in the last 30 days but at least one order from November .</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
