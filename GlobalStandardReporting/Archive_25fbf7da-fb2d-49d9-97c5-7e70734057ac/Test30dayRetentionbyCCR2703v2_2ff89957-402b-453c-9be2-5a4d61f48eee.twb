            <column caption='CCR group' datatype='string' name='[CCR_group]' role='dimension' type='nominal' />
            <column caption='Include Seamless Orders' datatype='boolean' name='[Calculation_164944386843709441]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] THEN TRUE&#13;&#10;ELSE IF [CCR_group] != &apos;Seamless&apos; THEN TRUE ELSE FALSE END&#13;&#10;END' />
            </column>
            <column caption='Retention Rate' datatype='real' default-format='p0.00%' name='[Calculation_501588452636758016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([retention_30d_orders]) / SUM([orders])' />
            </column>
