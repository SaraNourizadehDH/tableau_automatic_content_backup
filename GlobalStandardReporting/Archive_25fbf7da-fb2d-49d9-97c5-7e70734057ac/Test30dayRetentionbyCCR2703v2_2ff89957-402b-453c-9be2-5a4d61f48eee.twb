      <column caption='Retention Rate Selected CCR 1' datatype='real' default-format='p0.00%' name='[Retention Rate Benchmark (copy)_1207809174562340871]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [CCR_group] = [Parameters].[Parameter 2] THEN [retention_30d_orders] END)&#13;&#10;/&#13;&#10;SUM(IF [CCR_group] = [Parameters].[Parameter 2] THEN [orders] END)' />
      </column>
