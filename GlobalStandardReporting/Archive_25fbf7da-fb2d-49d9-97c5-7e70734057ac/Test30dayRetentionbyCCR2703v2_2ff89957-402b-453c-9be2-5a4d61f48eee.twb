      <column caption='CCR group' datatype='string' name='[CCR_group]' role='dimension' type='nominal' />
      <column caption='Retention Gap' datatype='real' default-format='p0.00%' name='[Calculation_1207809174559064068]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Retention Rate Benchmark (copy)_1207809174562340871] - [Retention Rate Selected CCR (copy)_1207809174558916611]) * 100' />
      </column>
      <column caption='Include Seamless Orders' datatype='boolean' name='[Calculation_164944386843709441]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] THEN TRUE&#13;&#10;ELSE IF [CCR_group] != &apos;Seamless&apos; THEN TRUE ELSE FALSE END&#13;&#10;END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_2393029934841294848]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Dimension 1' datatype='string' name='[Calculation_383931917356445697]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#13;&#10;    WHEN &apos;Week - CCR Group&apos; THEN [week]&#13;&#10;    WHEN &apos;CCR Group - Week&apos; THEN [CCR_group]&#13;&#10;END' />
      </column>
      <column caption='Dimension 2' datatype='string' name='[Calculation_383931917356785666]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#13;&#10;    WHEN &apos;Week - CCR Group&apos; THEN [CCR_group]&#13;&#10;    WHEN &apos;CCR Group - Week&apos; THEN [week]&#13;&#10;END' />
      </column>
      <column caption='Retention Rate' datatype='real' default-format='p0.00%' name='[Calculation_501588452636758016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([retention_30d_orders]) / SUM([orders])' />
      </column>
      <column caption='Show Top N Orders' datatype='integer' name='[Calculation_501588452640169985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM({ FIXED [CCR_group] : SUM([orders])}),&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% of Total orders' datatype='real' name='[Calculation_6090977767526555651]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Retention Rate Benchmark (copy)_1207809174576062474] / [Calculation_6090977767525089282]' />
      </column>
      <column caption='Orders Selected CCR 2' datatype='integer' default-format='n#,##0;-#,##0' name='[Orders Selected CCR (copy)_4224094983136411649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [CCR_group] = [Parameters].[Selected CCR (copy)_4224094983136292864] THEN [orders] END)' />
