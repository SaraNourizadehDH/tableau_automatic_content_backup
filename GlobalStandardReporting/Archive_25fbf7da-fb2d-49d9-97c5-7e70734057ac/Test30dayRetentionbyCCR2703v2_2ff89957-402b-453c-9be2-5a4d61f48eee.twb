    <worksheet name='Retention Trend Sheet'>
      <layout-options>
        <caption>
          <formatted-text>
            <run fontcolor='#555555' fontname='Tableau Bold' fontsize='10'>% of orders split by customer contact reason (CCR) that placed a future order within the next 30d.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#555555'>Note</run>
            <run fontcolor='#555555'>:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#555555' italic='true'>a. Only orders with contacts are considered.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#555555' italic='true'>b. If order has multiple contacts, we p</run>
            <run italic='true'>ick CCR related to the first contact only.</run>
            <run>Æ&#10;</run>
            <run italic='true'>c. Customers, who had multiple orders per month, each with a different CCR, are categorized separately as Multiple CCR.</run>
            <run>Æ&#10;</run>
            <run italic='true'>d. &apos;Show Top N CCR&apos; filters CCR based on the number of orders in all months across all countries.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='retention gap CCR - RL' name='federated.1i61daw1ihxnzb190qvf71f9est4' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Show Top N CCR' datatype='integer' name='[CCR group Parameter]' param-domain-type='range' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
              <range max='132' min='1' />
            </column>
            <column caption='Include Seamless Orders' datatype='boolean' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1i61daw1ihxnzb190qvf71f9est4'>
            <column caption='1% Program grouping' datatype='string' name='[CCR group (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[CCR_group]' default='&quot;Other&quot;' new-bin='true'>
                <bin default-name='false' value='&quot;Feedback, Information Request&quot;'>
