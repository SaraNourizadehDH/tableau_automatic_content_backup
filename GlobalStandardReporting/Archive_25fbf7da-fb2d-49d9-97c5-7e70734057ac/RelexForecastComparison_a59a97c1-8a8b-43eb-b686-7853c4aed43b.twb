      </column>
      <column caption='Relex Out of Scope Predictions' datatype='real' name='[Calculation_613685819684352000]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_in_sd] = 0 THEN [relex_pred_units]&#10;ELSEIF [is_in_sd] = 1 AND [is_active] = False&#10;THEN [relex_pred_units]&#10;ELSE null&#10;END' />
      </column>
      <column caption='% Out of Scope Relex' datatype='real' default-format='p0.00%' name='[Calculation_613685819685093377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_613685819684352000]) / SUM([relex_pred_units])' />
      </column>
      <column caption='Relex Predictions not in sd' datatype='real' name='[Out of Scope Predictions Relex (copy)_613685819687956484]' role='measure' type='quantitative'>
