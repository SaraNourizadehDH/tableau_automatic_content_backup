      <aliases enabled='yes' />
      <column caption='# Forecasted Incremental Orders (44w)' datatype='real' name='[Actual Incremental Orders (8w) (copy)_1776458989818691595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1776458989817978890]&#10;* SUM([cohort_customers_test])&#10;* 44 // duration of year - duration of observation period (8w)' />
      </column>
      <column caption='€ Profit (Current - Option 1)' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Actual Incremental Orders (8w) (copy)_1776458989820399629]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Observation Period Order Frequency Test (copy)_1776458989817323529]) * MIN([federated.01xid240azqgio100ibyh12r7uyh].[actuals_gpo_l3m])&#10;&#10;+ IFNULL(([Actual Incremental Orders (8w) (copy)_1776458989818691595]) * [Profit ROI (copy)_1776458989821198350],0)' />
      </column>
      <column caption='# Actual  Test Orders (8w) ' datatype='real' name='[Actual Incremental Orders (8w) (copy)_3366792611389366272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Observation Period Order Frequency Control - correct (copy)_3249699025998069781])&#10;* SUM([cohort_customers_test])' />
      </column>
      <column caption='Checkpoints Delta OF (Slope)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1776458989817978890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([Checkpoint 1 Order Frequency Test (copy)_525373095216730117] - [Checkpoint 1 Order Frequency Control (copy)_525373095216607236])&#10;- ([Calculation_525373095216381955] - [Calculation_525373095216062466]))&#10;&#10;/ SUM([duration_between_checkpoints])' />
      </column>
      <column caption='# Weeks since experiment started' datatype='integer' name='[Calculation_1776458989819084812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;, DATETIME(ATTR([federated.1y4r4tt0je371i1dgsvfk17qizor].[experimentation_start])), DATETIME(TODAY()))' />
      </column>
      <column caption='Avg. Incremental GMV' datatype='real' name='[Calculation_3249699023973937163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3249699023975952397] - [Reorders GMV Test (copy)_3249699023976038414]' />
      </column>
      <column caption='Marketing ROI' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3249699023974830092]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3249699023973937163] * SUM([cohort_customers_test]) // profit&#10;&#10;/&#10;[€ Profit (copy)_1776458989824892945]' />
      </column>
      <column caption='Reorders GMV Test' datatype='real' name='[Calculation_3249699023975952397]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([observation_period_gmv_eur_test]) // gmv per customer for test&#10; / SUM([cohort_customers_test]) // times test customer group size' />
      </column>
      <column caption='Observation Period Order Frequency Control' datatype='real' name='[Calculation_3249699025997651987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([observation_period_reorders_control])/SUM([cohort_customers_control])' />
      </column>
      <column caption='Profit ROI' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4930245376661602304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE ATTR([federated.1y4r4tt0je371i1dgsvfk17qizor].[roi_forecast_compute_using])&#10;WHEN &apos;Current GPO&apos;&#10;  THEN [Checkpoints Delta OF (Slope) (copy)_1776458989825171474]&#10;WHEN &apos;Target GPO&apos;&#10;  THEN [Profit ROI (Current - 1) (copy)_1776458989827813397]&#10;END' />
      </column>
      <column caption='Checkpoint 1 Order Frequency Control' datatype='real' name='[Calculation_525373095216062466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_future_orders_checkpoint_1_control])/SUM([cohort_customers_control])' />
      </column>
      <column caption='Checkpoint 1 Order Frequency Test' datatype='real' name='[Calculation_525373095216381955]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_future_orders_checkpoint_1_test])/SUM([cohort_customers_test])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_642959266741911553]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Checkpoint 2 Order Frequency Control' datatype='real' name='[Checkpoint 1 Order Frequency Control (copy)_525373095216607236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_future_orders_checkpoint_2_control])/SUM([cohort_customers_control])' />
      </column>
      <column caption='Checkpoint 2 Order Frequency Test' datatype='real' name='[Checkpoint 1 Order Frequency Test (copy)_525373095216730117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_future_orders_checkpoint_2_test])/SUM([cohort_customers_test])' />
      </column>
      <column caption='Profit ROI (Current - Option 1)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Checkpoints Delta OF (Slope) (copy)_1776458989825171474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Actual Incremental Orders (8w) (copy)_1776458989820399629] / [€ Profit (copy)_1776458989824892945] &#10;-1' />
      </column>
      <column caption='# Forecasted Test Orders (44w)' datatype='real' name='[Forecasted Incremental Orders (44w) (copy)_3366792611389693953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Checkpoint 1 Order Frequency Test (copy)_525373095216730117] - [Calculation_525373095216381955])&#10;* SUM([cohort_customers_test])&#10;* 44 // duration of year - duration of observation period (8w)' />
      </column>
      <column caption='Observation Period Order Frequency Test' datatype='real' name='[Observation Period Order Frequency Control - correct (copy)_3249699025998069781]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([observation_period_reorders_test])/SUM([cohort_customers_test])' />
      </column>
      <column caption='# Actual Incremental Orders (8w)' datatype='real' name='[Observation Period Order Frequency Test (copy)_1776458989817323529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Observation Period Order Frequency Control - correct (copy)_3249699025998069781] - [Calculation_3249699025997651987])&#10;* SUM([cohort_customers_test])' />
      </column>
      <column caption='Profit ROI (Future - Option 2) ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Profit ROI (Current - 1) (copy)_1776458989827813397]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[€ Profit (copy)_1776458989826957332]/ [€ Profit (copy)_1776458989824892945] &#10;-1' />
      </column>
      <column caption='forecast_gpo' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Profit ROI (copy)_1776458989821198350]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE IFNULL(MIN([federated.01xid240azqgio100ibyh12r7uyh].[be_gpo]),0)&#10;WHEN 0&#10;  THEN MIN([federated.01xid240azqgio100ibyh12r7uyh].[actuals_gpo_l3m])&#10;ELSE MIN([federated.01xid240azqgio100ibyh12r7uyh].[be_gpo])&#10;END' />
      </column>
      <column caption='Reorders GMV Control' datatype='real' name='[Reorders GMV Test (copy)_3249699023976038414]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([observation_period_gmv_eur_control]) // gmv per customer for control&#10; / SUM([cohort_customers_control]) // times control customer group size' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Compensation Impact RL - experimentation level pivoted' datatype='table' name='[__tableau_internal_object_id__].[comp_roi_pivoted_egypt_2D1401153DDE439199B25119E9FAF5DD]' role='measure' type='quantitative' />
