      <column caption='Delta Orders Observation Period ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1776458989812084741]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Observation Period Delta Orders (copy)_1776458989813829639]&#10;* SUM([Observation Period Delta Orders (copy)_1776458989812969478])' />
      </column>
      <column caption='Incident Report URL' datatype='string' name='[Calculation_3179048786377474048]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MIN([Incident Report URL (copy)_3039015003824041984])' />
      </column>
      <column caption='Order Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3249699023967633408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(count_future_orders_observation_period) / SUM([cohort_customers])' />
      </column>
      <column caption='€ Avg. Order Value' datatype='real' default-format='n&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_3249699023970078727]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(sum_gmv_eur_observation_period) / SUM(count_future_orders_observation_period)' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_642959266741358592]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Reorder Rate' datatype='real' default-format='p0.00%' name='[Delta Order Frequency Observation Period (copy)_3366792611396227075]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reorder_customers]) / SUM([cohort_customers])' />
      </column>
      <column caption='Documentation Deck' datatype='string' name='[Incident Report URL (copy)_3039015003824041984]' role='dimension' type='nominal'>
