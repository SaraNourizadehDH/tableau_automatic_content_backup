  <worksheets>
    <worksheet name='BAN_mktg_roi'>
      <table>
        <view>
          <datasources>
            <datasource caption='Compensation Impact RL - experimentation level' name='federated.1u4t8nd0q8opb912akuw00a12dkw' />
            <datasource caption='Experimentation Configuration - Gsheet' name='federated.1y4r4tt0je371i1dgsvfk17qizor' />
            <datasource caption='Compensation Impact RL - experimentation and week level' name='federated.0t9gur802g6xde1ddsxr810jim67' />
            <datasource caption='Compensation Impact RL - experimentation level pivoted' name='federated.0nwwivx1ony7tk1g9glpj0e3a9pk' />
            <datasource caption='Lucanet Financial Data - Gsheet' name='federated.01xid240azqgio100ibyh12r7uyh' />
          </datasources>
          <datasource-dependencies datasource='federated.01xid240azqgio100ibyh12r7uyh'>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0nwwivx1ony7tk1g9glpj0e3a9pk'>
            <column caption='# Actual  Test Orders (8w) ' datatype='real' name='[Actual Incremental Orders (8w) (copy)_3366792611389366272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Observation Period Order Frequency Control - correct (copy)_3249699025998069781])&#10;* SUM([cohort_customers_test])' />
            </column>
            <column caption='Avg. Incremental GMV' datatype='real' name='[Calculation_3249699023973937163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3249699023975952397] - [Reorders GMV Test (copy)_3249699023976038414]' />
            </column>
            <column caption='Marketing ROI' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3249699023974830092]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3249699023973937163] * SUM([cohort_customers_test]) // profit&#10;&#10;/&#10;[€ Profit (copy)_1776458989824892945]' />
            </column>
            <column caption='Reorders GMV Test' datatype='real' name='[Calculation_3249699023975952397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([observation_period_gmv_eur_test]) // gmv per customer for test&#10; / SUM([cohort_customers_test]) // times test customer group size' />
            </column>
            <column caption='Checkpoint 1 Order Frequency Test' datatype='real' name='[Calculation_525373095216381955]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_future_orders_checkpoint_1_test])/SUM([cohort_customers_test])' />
            </column>
            <column caption='Checkpoint 2 Order Frequency Test' datatype='real' name='[Checkpoint 1 Order Frequency Test (copy)_525373095216730117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_future_orders_checkpoint_2_test])/SUM([cohort_customers_test])' />
            </column>
            <column caption='# Forecasted Test Orders (44w)' datatype='real' name='[Forecasted Incremental Orders (44w) (copy)_3366792611389693953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Checkpoint 1 Order Frequency Test (copy)_525373095216730117] - [Calculation_525373095216381955])&#10;* SUM([cohort_customers_test])&#10;* 44 // duration of year - duration of observation period (8w)' />
            </column>
            <column caption='Observation Period Order Frequency Test' datatype='real' name='[Observation Period Order Frequency Control - correct (copy)_3249699025998069781]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([observation_period_reorders_test])/SUM([cohort_customers_test])' />
            </column>
            <column caption='Reorders GMV Control' datatype='real' name='[Reorders GMV Test (copy)_3249699023976038414]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([observation_period_gmv_eur_control]) // gmv per customer for control&#10; / SUM([cohort_customers_control]) // times control customer group size' />
            </column>
            <column caption='# Cohort Customers Control' datatype='real' name='[cohort_customers_control]' role='measure' type='quantitative' />
            <column caption='# Cohort Customers Test' datatype='real' name='[cohort_customers_test]' role='measure' type='quantitative' />
            <column caption='# Future Orders Checkpoint 1 Test' datatype='real' name='[count_future_orders_checkpoint_1_test]' role='measure' type='quantitative' />
            <column caption='# Future Orders Checkpoint 2 Test' datatype='real' name='[count_future_orders_checkpoint_2_test]' role='measure' type='quantitative' />
            <column caption='Experiment Id' datatype='string' name='[experiment_id]' role='dimension' type='nominal' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='€ Costs Observation Period Test' datatype='real' name='[observation_period_costs_test]' role='measure' type='quantitative' />
            <column caption='€ GMV Observation Period Control' datatype='real' name='[observation_period_gmv_eur_control]' role='measure' type='quantitative' />
            <column caption='€ GMV Observation Period Test' datatype='real' name='[observation_period_gmv_eur_test]' role='measure' type='quantitative' />
            <column caption='# Re-Orders placed over Observation period Test' datatype='real' name='[observation_period_reorders_test]' role='measure' type='quantitative' />
            <column-instance column='[cohort_customers_test]' derivation='Sum' name='[sum:cohort_customers_test:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3249699023973937163]' derivation='User' name='[usr:Calculation_3249699023973937163:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3249699023974830092]' derivation='User' name='[usr:Calculation_3249699023974830092:qk]' pivot='key' type='quantitative' />
            <column-instance column='[€ Profit (copy)_1776458989824892945]' derivation='User' name='[usr:€ Profit (copy)_1776458989824892945:qk]' pivot='key' type='quantitative' />
            <column caption='€ CCPO' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[€ Profit (copy)_1776458989823266832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([observation_period_costs_test]) / sum([observation_period_reorders_test]) // this is CCPO' />
            </column>
            <column caption='€ Costs' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[€ Profit (copy)_1776458989824892945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[€ Profit (copy)_1776458989823266832]&#10;* (IFNULL(([Actual Incremental Orders (8w) (copy)_3366792611389366272]),0) + IFNULL(([Forecasted Incremental Orders (44w) (copy)_3366792611389693953]),0))' />
            </column>
