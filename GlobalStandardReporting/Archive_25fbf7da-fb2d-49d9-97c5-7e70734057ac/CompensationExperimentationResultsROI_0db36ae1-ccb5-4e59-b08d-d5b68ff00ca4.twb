            <column caption='€ Profit - Actuals (tooltip)' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[€ Profit (Current - Option 1) (copy)_4930245376685346822]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Observation Period Order Frequency Test (copy)_1776458989817323529]) * MIN([federated.01xid240azqgio100ibyh12r7uyh].[actuals_gpo_l3m])' />
            </column>
            <column caption='€ CCPO' datatype='real' default-format='c&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[€ Profit (copy)_1776458989823266832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([observation_period_costs_test]) / sum([observation_period_reorders_test]) // this is CCPO' />
            </column>
            <column caption='€ Costs' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[€ Profit (copy)_1776458989824892945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[€ Profit (copy)_1776458989823266832]&#10;* (IFNULL(([Actual Incremental Orders (8w) (copy)_3366792611389366272]),0) + IFNULL(([Forecasted Incremental Orders (44w) (copy)_3366792611389693953]),0))' />
            </column>
            <column caption='€ Profit - Forecast Option 1 (tooltip)' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[€ Profit - Actuals (tooltip) (copy)_4930245376685428743]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(([Actual Incremental Orders (8w) (copy)_1776458989818691595]) * [Profit ROI (copy)_1776458989821198350],0)' />
            </column>
            <column caption='€ Profit - Forecast Option 2 (tooltip)' datatype='real' default-format='c&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[€ Profit - Forecast Option 1 (tooltip) (copy)_4930245376685600778]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(([Actual Incremental Orders (8w) (copy)_1776458989818691595]),0) *  MIN([federated.01xid240azqgio100ibyh12r7uyh].[Calculation_1776458989826326547])' />
