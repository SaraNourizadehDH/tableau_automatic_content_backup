      </column>
      <column caption='# Test Customers' datatype='integer' name='[Observation Period Delta Orders (copy)_1776458989812969478]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [customer_group]&#10;  WHEN &apos;test&apos;&#10;    THEN [cohort_customers]&#10;  ELSE &#10;    0&#10;END' />
      </column>
      <column caption='Delta Order Frequency Observation Period' datatype='real' name='[Observation Period Delta Orders (copy)_1776458989813829639]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(CASE [customer_group]&#10;  WHEN &apos;test&apos;&#10;    THEN [count_future_orders_observation_period]&#10;&#10;  ELSE 0&#10;END&#10;&#10;-&#10;&#10;CASE [customer_group]&#10;  WHEN &apos;control&apos;&#10;    THEN [count_future_orders_observation_period]&#10;  ELSE 0&#10;END&#10;&#10;)&#10;/&#10;SUM([cohort_customers])' />
      </column>
