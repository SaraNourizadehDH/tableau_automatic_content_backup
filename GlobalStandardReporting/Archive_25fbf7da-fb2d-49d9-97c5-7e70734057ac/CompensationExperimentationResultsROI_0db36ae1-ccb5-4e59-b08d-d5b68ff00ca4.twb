            <column caption='# Re-Orders placed over Observation period Test' datatype='real' name='[observation_period_reorders_test]' role='measure' type='quantitative' />
            <column-instance column='[cohort_customers_test]' derivation='Sum' name='[sum:cohort_customers_test:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Actual Incremental Orders (8w) (copy)_1776458989818691595]' derivation='User' name='[usr:Actual Incremental Orders (8w) (copy)_1776458989818691595:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Observation Period Order Frequency Test (copy)_1776458989817323529]' derivation='User' name='[usr:Observation Period Order Frequency Test (copy)_1776458989817323529:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Profit ROI (Current - 1) (copy)_1776458989827813397]' derivation='User' name='[usr:Profit ROI (Current - 1) (copy)_1776458989827813397:qk]' pivot='key' type='quantitative' />
            <column-instance column='[€ Profit (copy)_1776458989823266832]' derivation='User' name='[usr:€ Profit (copy)_1776458989823266832:qk]' pivot='key' type='quantitative' />
