      <column caption='Calculation1' datatype='boolean' name='[Calculation_2170735072037523458]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[year_month]=DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,TODAY()))' />
      </column>
      <column caption='Mom Ct slots var.' datatype='real' name='[Calculation_2170735072039608323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([ct_slots])-SUM([mom_ct_slots]))/SUM([mom_ct_slots])' />
      </column>
      <column caption='Mom PP revenue var.' datatype='real' name='[Calculation_2170735072040341508]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([pp_revenue_eur]-[mom_pp_revenue_eur]))/SUM([mom_pp_revenue_eur])' />
      </column>
      <column caption='Mom Restaurant var.' datatype='real' name='[Calculation_2170735072040513541]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([ct_restaurants])-SUM([mom_ct_restaurants])) /SUM([mom_ct_restaurants])' />
      </column>
      <column caption='Arrow' datatype='integer' name='[Calculation_424464317850521600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Arrow sense' datatype='string' name='[Calculation_424464317850816513]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2170735072040341508] &gt; 0 THEN &quot;Up&quot;&#13;&#10;ELSEIF  [Calculation_2170735072040341508]= 0 THEN &quot;No Change&quot;&#13;&#10;ELSEIF  [Calculation_2170735072040341508] &lt; 0 THEN  &quot;Down&quot;&#13;&#10;ELSE &quot;None&quot;&#13;&#10;END' />
      </column>
      <column caption='mom Rest tot good var.' datatype='real' name='[Calculation_424464317856952322]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(MIN(SUM([Calculation_1605533319097159680]),SUM([ct_restaurants])) - MIN(SUM([Ct Rest tot good (copy)]),SUM([mom_ct_restaurants])))/&#13;&#10;MIN(SUM([Ct Rest tot good (copy)]),SUM([mom_ct_restaurants]))' />
      </column>
      <column caption='Rest tot' datatype='integer' name='[Calculation_424464317861097475]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(SUM([Calculation_1605533319097159680]),SUM([ct_restaurants]))' />
      </column>
      <column caption='Mom Ct Rest tot good ' datatype='integer' name='[Ct Rest tot good (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [display_name], [year_month],[placement_source]:MAX([mom_ct_tot_restaurants])}' />
      </column>
      <column caption='Mom Restaurant tot var. ' datatype='real' name='[Mom Restaurant var. (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1605533319097159680])-SUM([Ct Rest tot good (copy)])) /SUM([Ct Rest tot good (copy)])' />
      </column>
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='mom Rest tot' datatype='integer' name='[Rest tot (copy)]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [placement_type] =  &quot;premium_placements&quot; &#13;&#10;    OR [placement_type] = &quot;organic_placements&quot;&#13;&#10; THEN [mom_ct_restaurants]&#13;&#10;    ELSE [Ct Rest tot good (copy)]&#13;&#10;END' />
      </column>
