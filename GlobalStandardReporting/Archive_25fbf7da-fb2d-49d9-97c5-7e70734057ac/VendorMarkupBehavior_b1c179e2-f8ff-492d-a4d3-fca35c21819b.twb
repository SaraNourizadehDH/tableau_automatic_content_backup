    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Region Summary'>
      <repository-location id='RegionSummary' path='/t/GlobalStandardReporting/workbooks/VendorMarkupBehavior_v2' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1000' maxwidth='1500' minheight='1000' minwidth='1500' sizing-mode='fixed' />
      <datasources>
        <datasource caption='new_design' name='federated.1el2k0s05w1axn13gwpuw0vcsz6o' />
      </datasources>
      <datasource-dependencies datasource='federated.1el2k0s05w1axn13gwpuw0vcsz6o'>
        <column caption='Is Campaign Bad Beh.' datatype='boolean' name='[Calculation_3571706354836537355]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='{ FIXED [campaign_pkey] : IF [Calculation_2505197669865832449]&gt;[Parameters].[Parameter 1]  THEN TRUE ELSE FALSE END}' />
        </column>
        <column caption='Is Campaign Flagged' datatype='boolean' name='[Calculation_5607614857060077571]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='{ FIXED  [campaign_pkey]:  IF [Calculation_2754654870813868032]&gt;[Parameters].[Parameter 2] THEN TRUE ELSE FALSE END}' />
        </column>
        <column caption='Campaign Funding Type' datatype='string' name='[campaign_funding_type]' role='dimension' type='nominal' />
        <column caption='Campaign Start Month' datatype='date' name='[campaign_start_month]' role='dimension' type='ordinal' />
        <column caption='Global Entity ID' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
        <column caption='is_camp_markdown after_camp' datatype='boolean' name='[is_camp_markup (copy)_3571706354821865474]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='{ FIXED  [campaign_pkey]:  IF [agg_price_change (product_weighted) (copy)_2505197670128234504]&lt;0 THEN TRUE ELSE FALSE END}' />
        </column>
        <column caption='is_campaign_bad_beh_1' datatype='boolean' name='[is_campaig_bad_beh_2 (copy)_3571706354836979724]' role='dimension' type='nominal'>
