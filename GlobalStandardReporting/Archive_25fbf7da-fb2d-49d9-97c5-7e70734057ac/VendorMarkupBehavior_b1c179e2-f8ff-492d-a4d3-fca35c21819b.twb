      <datasource-dependencies datasource='Parameters'>
        <column caption='Min. Normalized Markup to flag Campaigns' datatype='real' default-format='p0%' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='0.05'>
          <calculation class='tableau' formula='0.05' />
        </column>
        <column caption='Min %of Campaigns w/M.up, to flag Vendors' datatype='real' default-format='p0%' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='0.1'>
