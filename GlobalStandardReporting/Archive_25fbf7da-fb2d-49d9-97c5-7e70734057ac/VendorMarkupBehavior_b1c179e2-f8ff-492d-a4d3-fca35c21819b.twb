              <calculation class='tableau' formula='COUNTD( IF [is_vendor_bad_beh_2 (copy)_740490305781604355] THEN [vendor_id] ELSE NULL END)' />
            </column>
            <column caption='Disc. Stolen' datatype='real' default-format='p0.0%' name='[Calculation_2505197669865832449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-(SUM([avg_disc_stolen]*[n_of_camp_product_key])&#10;/&#10;SUM([n_of_camp_product_key]))' />
            </column>
            <column caption='Net Discount' datatype='real' default-format='p0.0%' name='[Calculation_2505197669866033154]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avg_net_discount]*[n_of_camp_product_key])&#10;/&#10;SUM([n_of_camp_product_key])' />
            </column>
            <column caption='Disc. Offered ' datatype='real' default-format='p0.0%' name='[Calculation_2505197669893271557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-SUM([avg_disc_offered]*[n_of_camp_product_key])/SUM([n_of_camp_product_key])' />
            </column>
            <column caption='Normalized Markup' datatype='real' default-format='p0.0%' name='[Calculation_2754654870813868032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([agg_price_change (copy)_2505197669852082176]/AVG([Calculation_5887119510777585667]))*30' />
            </column>
            <column caption='Is Campaign Bad Beh.' datatype='boolean' name='[Calculation_3571706354836537355]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [campaign_pkey] : IF [Calculation_2505197669865832449]&gt;[Parameters].[Parameter 1]  THEN TRUE ELSE FALSE END}' />
            </column>
            <column caption='Vendors' datatype='integer' name='[Calculation_5607614857058033664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id])' />
            </column>
            <column caption='Is Campaign Flagged' datatype='boolean' name='[Calculation_5607614857060077571]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED  [campaign_pkey]:  IF [Calculation_2754654870813868032]&gt;[Parameters].[Parameter 2] THEN TRUE ELSE FALSE END}' />
            </column>
            <column caption='Campaigns' datatype='integer' name='[Calculation_5887119510776389634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([campaign_pkey])' />
            </column>
            <column caption='Campaign duration (days)' datatype='real' name='[Calculation_5887119510777585667]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[campaign_duration_m]/60/24' />
            </column>
            <column caption='Markup %' datatype='real' default-format='p0.0%' name='[agg_price_change (copy)_2505197669852082176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avg_camp_price_change_camp]*[n_of_camp_product_key])&#10;/&#10;SUM([n_of_camp_product_key])' />
            </column>
            <column caption='Price Change After Campaign' datatype='real' default-format='p0.0%' name='[agg_price_change (product_weighted) (copy)_2505197670128234504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avg_camp_price_change_after_camp]*[n_of_camp_product_key])&#10;/&#10;SUM([n_of_camp_product_key])' />
            </column>
            <column-instance column='[Calculation_5887119510777585667]' derivation='Avg' name='[avg:Calculation_5887119510777585667:qk]' pivot='key' type='quantitative' />
