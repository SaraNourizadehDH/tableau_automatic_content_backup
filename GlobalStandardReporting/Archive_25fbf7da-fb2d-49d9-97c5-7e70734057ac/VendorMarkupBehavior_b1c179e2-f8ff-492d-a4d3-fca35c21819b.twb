                <zone forceUpdate='true' h='3941' id='194' type-v2='text' w='73357' x='8500' y='471'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='12'>International Markets</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#e3001e' fontsize='18'>Vendor Markup Behavior | </run>
                    <run bold='true' fontcolor='#e3001e' fontsize='14'>Region Summary</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
