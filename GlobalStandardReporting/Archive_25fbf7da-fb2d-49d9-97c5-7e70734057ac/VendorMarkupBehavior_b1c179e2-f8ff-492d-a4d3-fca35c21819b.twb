      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/VendorMarkupBehavior_v2/CampaignsDetailTable?rev=' id='CampaignsDetailTable' path='/t/GlobalStandardReporting/workbooks/VendorMarkupBehavior_v2' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='new_design' name='federated.1el2k0s05w1axn13gwpuw0vcsz6o' />
