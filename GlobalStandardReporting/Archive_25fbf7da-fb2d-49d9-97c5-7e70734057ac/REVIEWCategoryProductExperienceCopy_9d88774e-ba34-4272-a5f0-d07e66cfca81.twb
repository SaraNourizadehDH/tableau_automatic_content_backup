      <table>
        <view>
          <datasources>
            <datasource caption='Assortment' name='federated.189vvuf0hjohza1b4vz270ylelc6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Aggregation Level 3' datatype='string' name='[Parameter 1 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.189vvuf0hjohza1b4vz270ylelc6'>
            <column caption='Period' datatype='string' name='[Calculation_4321274220019838976]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 4] &#10;WHEN &apos;Day&apos; THEN &#10;    STR(DATEPART(&apos;year&apos;, [partition_date])) + STR(&apos;-&apos;) + STR(DATEPART(&apos;month&apos;, [partition_date])) + STR(&apos;-&apos;) + STR(DATEPART(&apos;day&apos;, [partition_date]))&#10;&#9;&#10;WHEN &apos;Week&apos; THEN &#10;&#9;STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;iso-week&apos;,[partition_date]))) + STR(&quot;-W&quot;) &#10;&#9;+ STR(DATEPART(&apos;iso-week&apos;,[partition_date]))&#10;&#10;WHEN &apos;Month&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date])) &#10;&#9;+ STR(&quot;-&quot;) &#10;&#9;+ IF DATEPART(&apos;month&apos;, [partition_date]) &lt; 10 THEN STR(&quot;0&quot;) ELSE STR(&quot;&quot;) END&#10;&#9;+ STR(DATEPART(&apos;month&apos;, [partition_date]))&#10;&#10;WHEN &apos;Quarter&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date])) + STR(&quot;-Q&quot;) + STR(DATEPART(&apos;quarter&apos;, [partition_date]))&#10;WHEN &apos;Year&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date]))&#10;END' />
            </column>
            <column caption='Top 10' datatype='boolean' name='[Calculation_4321274220023033859]' role='measure' type='nominal'>
              <calculation class='tableau' formula='index()&lt;=10'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Curated Category Names]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[category_name]' new-bin='true'>
                <bin default-name='false' value='&quot;[Missing Data]&quot;'>
                  <value>&quot;= back-end data missing =&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Alcoholic beverages and Tobacco&quot;'>
                  <value>&quot;Alcohol&quot;</value>
                  <value>&quot;Alcoholic Beverages&quot;</value>
                  <value>&quot;Alcoholic Beverages &amp; Tobacco&quot;</value>
