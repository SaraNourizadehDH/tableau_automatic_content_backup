              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 4]&#10;WHEN &apos;Day&apos; THEN AVG({FIXED : AVG({INCLUDE [Curated Category Names],[partition_date]: SUM([nr_atc_n_trx_s])})})&#10;WHEN &apos;Week&apos; THEN AVG({FIXED : AVG({INCLUDE [Curated Category Names],ISOWEEK([partition_date]): SUM([nr_atc_n_trx_s])})})&#10;WHEN &apos;Month&apos; THEN AVG({FIXED : AVG({INCLUDE [Curated Category Names],Month([partition_date]): SUM([nr_atc_n_trx_s])})})&#10;END' />
            </column>
