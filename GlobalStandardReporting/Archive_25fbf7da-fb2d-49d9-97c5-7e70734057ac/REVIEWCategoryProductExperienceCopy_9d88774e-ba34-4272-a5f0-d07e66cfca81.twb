      <column caption='Metric: Sessions, Dmart' datatype='integer' name='[Calculation_2839519594709446662]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_dm_sessions])' />
      </column>
      <column caption='Filter: Exclude 2020' datatype='string' name='[Calculation_2840434381425250305]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [partition_date] &lt; DATE(&apos;2021-01-01&apos;) THEN &apos;FALSE&apos;&#10;ELSE &apos;TRUE&apos;&#10;END' />
      </column>
      <column caption='Metric: Sessions per User, Dmart' datatype='real' name='[Calculation_3443213083734859776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN&#10;    SUM([nr_dm_sessions])/WINDOW_AVG(SUM({FIXED [country], [Calculation_515662220689719302],[global_entity_id], [brand], [platform], DAY([partition_date]), [Calculation_4726527870256603136] : [Metric: Users (copy)_1486750891782393858]}))&#10;WHEN &apos;Week&apos; THEN&#10;    SUM([nr_dm_sessions])/WINDOW_AVG(SUM({FIXED [country], [Calculation_515662220689719302],[global_entity_id], [brand], [platform], ISOWEEK([partition_date]), [Calculation_4726527870256603136] : [Metric: Users (copy)_1486750891782393858]}))&#10;WHEN &apos;Month&apos; THEN&#10;    SUM([nr_dm_sessions])/WINDOW_AVG(SUM({FIXED [country], [Calculation_515662220689719302],[global_entity_id], [brand], [platform], MONTH([partition_date]), [Calculation_4726527870256603136] : [Metric: Users (copy)_1486750891782393858]}))&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Metric: Bounce Rate, Dmart' datatype='real' name='[Calculation_3443213083738210307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Metric: Traffic (copy)_3443213083738095618]/[Metric: Users (copy)_1486750891782393858]' />
      </column>
      <column caption='Filter: Brands' datatype='integer' name='[Calculation_3443213083739054084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2 2] = &apos;Quick-Commerce&apos; THEN 1&#10;ELSEIF  [Parameters].[Parameter 2 2] = &quot;All Brands&quot; THEN 1&#10;ELSEIF [Parameters].[Parameter 2 2] = &quot;talabat&quot; OR [Parameters].[Parameter 2 2] = &quot;pandora&quot; OR [Parameters].[Parameter 2 2] = &apos;pedidosya&apos; OR [Parameters].[Parameter 2 2] = &apos;hungerstation&apos;&#10;    THEN&#10;        IF [Parameters].[Parameter 2 2] = [brand] THEN 1 ELSE 0 END&#10;END' />
      </column>
      <column caption='Custom Shapes' datatype='real' name='[Calculation_3443213083743424517]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1.0' />
      </column>
      <column caption='Period' datatype='string' name='[Calculation_4726527870256603136]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Day&apos; THEN &#10;    STR(DATEPART(&apos;year&apos;, [partition_date])) + STR(&apos;-&apos;) + STR(DATEPART(&apos;month&apos;, [partition_date])) + STR(&apos;-&apos;) + STR(DATEPART(&apos;day&apos;, [partition_date]))&#10;&#9;&#10;WHEN &apos;Week&apos; THEN &#10;&#9;STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;iso-week&apos;,[partition_date]))) + STR(&quot;-W&quot;) &#10;&#9;+ STR(DATEPART(&apos;iso-week&apos;,[partition_date]))&#10;&#10;WHEN &apos;Month&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date])) &#10;&#9;+ STR(&quot;-&quot;) &#10;&#9;+ IF DATEPART(&apos;month&apos;, [partition_date]) &lt; 10 THEN STR(&quot;0&quot;) ELSE STR(&quot;&quot;) END&#10;&#9;+ STR(DATEPART(&apos;month&apos;, [partition_date]))&#10;&#10;WHEN &apos;Quarter&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date])) + STR(&quot;-Q&quot;) + STR(DATEPART(&apos;quarter&apos;, [partition_date]))&#10;WHEN &apos;Year&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date]))&#10;END' />
      </column>
      <column caption='Metric: Sessions per User, Dmart - Adjusted' datatype='real' name='[Calculation_4968174127721467904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_3443213083734859776] &lt; 1 THEN &#10;1 ELSE [Calculation_3443213083734859776] END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Last 12 Months' datatype='boolean' name='[Calculation_5009199118102798336]' role='measure' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,MAX([partition_date]), WINDOW_MAX(MAX([partition_date]))) &lt;= 6'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Filter: Partial Period' datatype='boolean' name='[Calculation_5009199118104092673]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;,[partition_date]) = DATETRUNC(&apos;day&apos;,[partition_date])&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[partition_date]) &lt; {FIXED : MAX(DATETRUNC(&apos;month&apos;,[partition_date]))}&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;iso-week&apos;,[partition_date]) &gt; {FIXED : MIN(DATETRUNC(&apos;iso-week&apos;, [partition_date]))} AND DATETRUNC(&apos;iso-week&apos;,[partition_date]) &lt; {FIXED : MAX(DATETRUNC(&apos;iso-week&apos;, [partition_date]))} &#10;END' />
      </column>
      <column caption='Brand Colours' datatype='string' name='[Calculation_515662220689719302]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2 2] = &apos;Quick-Commerce&apos; THEN &apos;Quick-Commerce&apos;&#10;ELSE [brand] &#10;END' />
        <aliases>
          <alias key='&quot;hungerstation&quot;' value='Quick Market' />
          <alias key='&quot;pandora&quot;' value='Pandamart' />
          <alias key='&quot;pedidosya&quot;' value='D-mart' />
          <alias key='&quot;Quick-Commerce&quot;' value='Dmart' />
          <alias key='&quot;talabat&quot;' value='tMart' />
