      <column caption='Dmart Labels' datatype='string' name='[Calculation_6100547943196397578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 2] &#10;WHEN &apos;Quick-Commerce&apos; THEN &apos;Dmart&apos;&#10;WHEN &apos;hungerstation&apos; THEN &apos;Quick Market&apos;&#10;WHEN &apos;pandora&apos; THEN &apos;Pandamart&apos;&#10;WHEN &apos;pedidosya&apos; THEN &apos;D-mart&apos;&#10;WHEN &apos;talabat&apos; THEN &apos;tMart&apos;&#10;END' />
