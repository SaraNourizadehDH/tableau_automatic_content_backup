      <column caption='Category ATC' datatype='real' default-format='p0.00%' name='[Calculation_6495527700123447297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([category_atc_sessions]) / SUM([category_detail_sessions]))' />
      </column>
      <column caption='part-date' datatype='string' name='[Calculation_6495527700124942338]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7] &#10;WHEN &apos;Day&apos; THEN &#10;    STR(DATEPART(&apos;year&apos;, [partition_date])) + STR(&apos;-&apos;) + STR(DATEPART(&apos;month&apos;, [partition_date])) + STR(&apos;-&apos;) + STR(DATEPART(&apos;day&apos;, [partition_date]))&#10;&#9;&#10;WHEN &apos;Week&apos; THEN &#10;&#9;STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;week&apos;,[partition_date]))) + STR(&quot;-W&quot;) &#10;&#9;+ STR(DATEPART(&apos;week&apos;,[partition_date]))&#10;&#10;WHEN &apos;Month&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date])) &#10;&#9;+ STR(&quot;-&quot;) &#10;&#9;+ IF DATEPART(&apos;month&apos;, [partition_date]) &lt; 10 THEN STR(&quot;0&quot;) ELSE STR(&quot;&quot;) END&#10;&#9;+ STR(DATEPART(&apos;month&apos;, [partition_date]))&#10;&#10;WHEN &apos;Quarter&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date])) + STR(&quot;-Q&quot;) + STR(DATEPART(&apos;quarter&apos;, [partition_date]))&#10;WHEN &apos;Year&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date]))&#10;END' />
      </column>
      <column caption='Swimlane ATC' datatype='real' default-format='p0.00%' name='[Calculation_6495527700125503491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([swimlane_atc_sessions]) / SUM([swimlane_detail_sessions])' />
      </column>
      <column caption='Search ATC' datatype='real' default-format='p0.00%' name='[Calculation_6495527700125855748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([search_atc_sessions]) / SUM([search_detail_sessions])' />
      </column>
      <column caption='Banner ATC' datatype='real' default-format='p0.00%' name='[Calculation_6495527700126814213]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([banner_atc_sessions])/SUM([banner_detail_sessions])' />
      </column>
      <column caption='Category CTR' datatype='real' default-format='p0.00%' name='[Calculation_6495527700128260102]' role='measure' type='quantitative'>
