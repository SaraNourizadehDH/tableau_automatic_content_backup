              <aliases>
                <alias key='&quot;Month&quot;' value='Month' />
                <alias key='&quot;Week&quot;' value='Week' />
              </aliases>
            </column>
            <column caption='Brand Split 4' datatype='string' name='[Parameter 2 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Quick-Commerce&quot;'>
              <calculation class='tableau' formula='&quot;Quick-Commerce&quot;' />
