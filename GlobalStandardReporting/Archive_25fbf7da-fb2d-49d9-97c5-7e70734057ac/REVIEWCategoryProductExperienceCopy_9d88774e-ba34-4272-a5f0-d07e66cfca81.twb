              <run>Æ&#10;</run>
              <run bold='true'>Conversion Rate: Over Time</run>
              <run>Æ&#10;</run>
              <run fontcolor='#606b76' fontname='Arial' fontsize='8'>Vertical Homescreen to Transaction, % users</run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true'>Conversion Rate: New Users</run>
              <run>Æ&#10;</run>
              <run fontcolor='#606b76' fontname='Arial' fontsize='8'>% first-time users over all users per vertical</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true'>Conversion Rate: Returning Users</run>
              <run>Æ&#10;</run>
              <run fontcolor='#606b76' fontname='Arial' fontsize='8'>% repeated users over all users per vertical</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true'>Top of Funnel, Over Time</run>
              <run>Æ&#10;</run>
              <run fontcolor='#606b76' fontname='Arial' fontsize='8'>Vertical Homescreen to Transaction, % users</run>
