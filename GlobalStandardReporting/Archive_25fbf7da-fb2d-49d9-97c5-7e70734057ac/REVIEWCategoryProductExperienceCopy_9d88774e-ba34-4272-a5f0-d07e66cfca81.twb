            </column>
            <column caption='Metric: Users, Local Shops' datatype='real' name='[Metric: Users, Dmart (copy)_1486750891783720965]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN SUM([nr_ls_users])&#10;WHEN &apos;Week&apos; THEN SUM([Users Dmart: Weekly (copy)_1486750891783143428])&#10;WHEN &apos;Month&apos; THEN SUM([Users Dmart: Monthly (copy)_1486750891782983683])&#10;END' />
            </column>
            <column caption='Rounding: Users, Local Shops' datatype='real' name='[Rounding: Users, Dmart (copy)_6100547943194767369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Summary: Users, Dmart (copy)_6100547943194705928] &gt;= 1000000000 THEN ROUND([Summary: Users, Dmart (copy)_6100547943194705928] / 1000000000,1)&#10;ELSEIF [Summary: Users, Dmart (copy)_6100547943194705928]  &gt;= 1000000 THEN ROUND([Summary: Users, Dmart (copy)_6100547943194705928]  / 1000000,1)&#10;ELSEIF [Summary: Users, Dmart (copy)_6100547943194705928]  &gt;= 1000 THEN ROUND([Summary: Users, Dmart (copy)_6100547943194705928] / 1000,1)&#10;ELSE ROUND([Summary: Users, Dmart (copy)_6100547943194705928] ,0)&#10;END'>
