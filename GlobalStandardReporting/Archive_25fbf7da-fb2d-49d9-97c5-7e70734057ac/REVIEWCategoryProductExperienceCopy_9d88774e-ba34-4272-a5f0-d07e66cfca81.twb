              </calculation>
            </column>
            <column caption='Summary: Users, Local Shops' datatype='real' name='[Summary: Users, Dmart (copy)_6100547943194705928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN&#10;    WINDOW_AVG(SUM({FIXED [country], [Calculation_515662220689719302],[global_entity_id], [brand], [platform], DAY([partition_date]), [Calculation_4726527870256603136] : [Metric: Users, Dmart (copy)_1486750891783720965]}))/COUNTD([Calculation_4726527870256603136])&#10;WHEN &apos;Week&apos; THEN&#10;    WINDOW_AVG(SUM({FIXED [country], [Calculation_515662220689719302],[global_entity_id], [brand], [platform], ISOWEEK([partition_date]), [Calculation_4726527870256603136] : [Metric: Users, Dmart (copy)_1486750891783720965]}))/COUNTD([Calculation_4726527870256603136])&#10;WHEN &apos;Month&apos; THEN&#10;    WINDOW_AVG(SUM({FIXED [country], [Calculation_515662220689719302],[global_entity_id], [brand], [platform], MONTH([partition_date]), [Calculation_4726527870256603136] : [Metric: Users, Dmart (copy)_1486750891783720965]}))/COUNTD([Calculation_4726527870256603136])&#10;END'>
