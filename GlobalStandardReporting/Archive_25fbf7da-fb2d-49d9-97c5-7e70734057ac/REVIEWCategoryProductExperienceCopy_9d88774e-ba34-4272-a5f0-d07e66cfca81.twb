          <datasource-dependencies datasource='federated.15b85jn00zmv90142zf9k1iwpd36 (copy)'>
            <column caption='Custom Formatting: Users, Dmart' datatype='string' name='[Calculation_1600959362213924867]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Summary: Users (copy)_6100547943194316806] &gt;= 1000000000 THEN &quot;B&quot;&#10;ELSEIF [Summary: Users (copy)_6100547943194316806] &gt;= 1000000 THEN &quot;M&quot;&#10;ELSEIF [Summary: Users (copy)_6100547943194316806] &gt;= 1000 THEN &quot;k&quot;&#10;ELSE &quot;&quot;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Filter: Exclude 2020' datatype='string' name='[Calculation_2840434381425250305]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [partition_date] &lt; DATE(&apos;2021-01-01&apos;) THEN &apos;FALSE&apos;&#10;ELSE &apos;TRUE&apos;&#10;END' />
            </column>
            <column caption='Filter: Brands' datatype='integer' name='[Calculation_3443213083739054084]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2 2] = &apos;Quick-Commerce&apos; THEN 1&#10;ELSEIF  [Parameters].[Parameter 2 2] = &quot;All Brands&quot; THEN 1&#10;ELSEIF [Parameters].[Parameter 2 2] = &quot;talabat&quot; OR [Parameters].[Parameter 2 2] = &quot;pandora&quot; OR [Parameters].[Parameter 2 2] = &apos;pedidosya&apos; OR [Parameters].[Parameter 2 2] = &apos;hungerstation&apos;&#10;    THEN&#10;        IF [Parameters].[Parameter 2 2] = [brand] THEN 1 ELSE 0 END&#10;END' />
            </column>
            <column caption='Period' datatype='string' name='[Calculation_4726527870256603136]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Day&apos; THEN &#10;    STR(DATEPART(&apos;year&apos;, [partition_date])) + STR(&apos;-&apos;) + STR(DATEPART(&apos;month&apos;, [partition_date])) + STR(&apos;-&apos;) + STR(DATEPART(&apos;day&apos;, [partition_date]))&#10;&#9;&#10;WHEN &apos;Week&apos; THEN &#10;&#9;STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;iso-week&apos;,[partition_date]))) + STR(&quot;-W&quot;) &#10;&#9;+ STR(DATEPART(&apos;iso-week&apos;,[partition_date]))&#10;&#10;WHEN &apos;Month&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date])) &#10;&#9;+ STR(&quot;-&quot;) &#10;&#9;+ IF DATEPART(&apos;month&apos;, [partition_date]) &lt; 10 THEN STR(&quot;0&quot;) ELSE STR(&quot;&quot;) END&#10;&#9;+ STR(DATEPART(&apos;month&apos;, [partition_date]))&#10;&#10;WHEN &apos;Quarter&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date])) + STR(&quot;-Q&quot;) + STR(DATEPART(&apos;quarter&apos;, [partition_date]))&#10;WHEN &apos;Year&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date]))&#10;END' />
            </column>
            <column caption='Filter: Partial Period' datatype='boolean' name='[Calculation_5009199118104092673]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;,[partition_date]) = DATETRUNC(&apos;day&apos;,[partition_date])&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[partition_date]) &lt; {FIXED : MAX(DATETRUNC(&apos;month&apos;,[partition_date]))}&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;iso-week&apos;,[partition_date]) &gt; {FIXED : MIN(DATETRUNC(&apos;iso-week&apos;, [partition_date]))} AND DATETRUNC(&apos;iso-week&apos;,[partition_date]) &lt; {FIXED : MAX(DATETRUNC(&apos;iso-week&apos;, [partition_date]))} &#10;END' />
            </column>
            <column caption='Brand Colours' datatype='string' name='[Calculation_515662220689719302]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2 2] = &apos;Quick-Commerce&apos; THEN &apos;Quick-Commerce&apos;&#10;ELSE [brand] &#10;END' />
              <aliases>
                <alias key='&quot;hungerstation&quot;' value='Quick Market' />
                <alias key='&quot;pandora&quot;' value='Pandamart' />
                <alias key='&quot;pedidosya&quot;' value='D-mart' />
                <alias key='&quot;Quick-Commerce&quot;' value='Dmart' />
                <alias key='&quot;talabat&quot;' value='tMart' />
              </aliases>
            </column>
            <column caption='Filter: Year' datatype='string' name='[Calculation_6947365406552662016]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([partition_date]))' />
            </column>
            <column caption='Metric: Users, Dmart' datatype='real' name='[Metric: Users (copy)_1486750891782393858]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN SUM([nr_dmart_users])&#10;WHEN &apos;Week&apos; THEN SUM([Users: Weekly (copy)_1486750891781955584])&#10;WHEN &apos;Month&apos; THEN SUM([Users: Monthly (copy)_1486750891782266881])&#10;END' />
            </column>
            <column caption='Rounding: Users, Dmart' datatype='real' name='[Rounding: Users (copy)_6100547943194411015]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Summary: Users (copy)_6100547943194316806] &gt;= 1000000000 THEN ROUND([Summary: Users (copy)_6100547943194316806] / 1000000000,1)&#10;ELSEIF [Summary: Users (copy)_6100547943194316806]  &gt;= 1000000 THEN ROUND([Summary: Users (copy)_6100547943194316806]  / 1000000,1)&#10;ELSEIF [Summary: Users (copy)_6100547943194316806]  &gt;= 1000 THEN ROUND([Summary: Users (copy)_6100547943194316806] / 1000,1)&#10;ELSE ROUND([Summary: Users (copy)_6100547943194316806] ,0)&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Summary: Users, Dmart' datatype='real' name='[Summary: Users (copy)_6100547943194316806]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN&#10;    WINDOW_AVG(SUM({FIXED [country], [Calculation_515662220689719302],[global_entity_id], [brand], [platform], DAY([partition_date]), [Calculation_4726527870256603136] : [Metric: Users (copy)_1486750891782393858]}))/COUNTD([Calculation_4726527870256603136])&#10;WHEN &apos;Week&apos; THEN&#10;    WINDOW_AVG(SUM({FIXED [country], [Calculation_515662220689719302],[global_entity_id], [brand], [platform], ISOWEEK([partition_date]), [Calculation_4726527870256603136] : [Metric: Users (copy)_1486750891782393858]}))/COUNTD([Calculation_4726527870256603136])&#10;WHEN &apos;Month&apos; THEN&#10;    WINDOW_AVG(SUM({FIXED [country], [Calculation_515662220689719302],[global_entity_id], [brand], [platform], MONTH([partition_date]), [Calculation_4726527870256603136] : [Metric: Users (copy)_1486750891782393858]}))/COUNTD([Calculation_4726527870256603136])&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Users Dmart: Monthly' datatype='real' name='[Users: Monthly (copy)_1486750891782266881]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE [country], [Calculation_515662220689719302],[global_entity_id], [brand], [platform], MONTH([partition_date]): MEDIAN([nr_dmart_users_monthly])}' />
            </column>
            <column caption='Users Dmart: Weekly' datatype='real' name='[Users: Weekly (copy)_1486750891781955584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE [brand],[Calculation_515662220689719302],[global_entity_id],[country], [platform], ISOWEEK([partition_date]): MEDIAN([nr_dmart_users_weekly])}' />
            </column>
