      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0xy5zl30bl5n1h1dsyigp0mjkzpm (copy)].[usr:Metric: Conversion over Time (\%) (copy)_2686678653375991814:qk]&quot;' value='New' />
          <alias key='&quot;[federated.0xy5zl30bl5n1h1dsyigp0mjkzpm (copy)].[usr:Metric: Conversion over Time (\%), New (copy)_2686678653376176135:qk]&quot;' value='Returning' />
          <alias key='&quot;[federated.0xy5zl30bl5n1h1dsyigp0mjkzpm (copy)].[usr:Metric: Users (copy)_4457789643327299593:qk]&quot;' value='NEW' />
          <alias key='&quot;[federated.0xy5zl30bl5n1h1dsyigp0mjkzpm (copy)].[usr:Metric: Users (copy)_5460122035627827200:qk:2]&quot;' value='First' />
          <alias key='&quot;[federated.0xy5zl30bl5n1h1dsyigp0mjkzpm (copy)].[usr:Metric: Users, First Step (copy)_5460122035647692801:qk:11]&quot;' value='Last' />
          <alias key='&quot;[federated.0xy5zl30bl5n1h1dsyigp0mjkzpm (copy)].[usr:Metric: Users, New (copy)_4457789643328061452:qk]&quot;' value='RETURNING' />
          <alias key='&quot;[federated.0xy5zl30bl5n1h1dsyigp0mjkzpm (copy)].[usr:Metric: Users, New (Dmart) (copy)_1600466754388733957:qk]&quot;' value='NEW ' />
          <alias key='&quot;[federated.0xy5zl30bl5n1h1dsyigp0mjkzpm (copy)].[usr:Metric: Users, Returning (Dmart) (copy)_1600466754388992006:qk]&quot;' value='RETURNING ' />
        </aliases>
      </column>
      <column caption='Filter: Brands' datatype='integer' name='[Calculation_1223501413828034561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2 4] = &apos;Quick-Commerce&apos; THEN 1&#10;ELSEIF  [Parameters].[Parameter 2 4] = &quot;All Brands&quot; THEN 1&#10;ELSEIF [Parameters].[Parameter 2 4] = &quot;talabat&quot; OR [Parameters].[Parameter 2 4] = &quot;pandora&quot; OR [Parameters].[Parameter 2 4] = &apos;pedidosya&apos; OR [Parameters].[Parameter 2 4] = &apos;hungerstation&apos;&#10;    THEN&#10;        IF [Parameters].[Parameter 2 4] = [brand] THEN 1 ELSE 0 END&#10;END' />
      </column>
      <column caption='Metric: Drop-off Rate (%), Dmart' datatype='real' name='[Calculation_129408179274362880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6144950643799560201]/[Calculation_4457789643307675649]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Label: Local Shops' datatype='string' name='[Calculation_1600466754379931648]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Local Shops&apos;' />
        <aliases>
          <alias key='&quot;Local Stores&quot;' value='Local Shops' />
        </aliases>
      </column>
      <column caption='Dmart Labels' datatype='string' name='[Calculation_1600466754419126288]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2 4] &#10;WHEN &apos;Quick-Commerce&apos; THEN &apos;Dmart&apos;&#10;WHEN &apos;hungerstation&apos; THEN &apos;Quick Market&apos;&#10;WHEN &apos;pandora&apos; THEN &apos;Pandamart&apos;&#10;WHEN &apos;pedidosya&apos; THEN &apos;D-mart&apos;&#10;WHEN &apos;talabat&apos; THEN &apos;tMart&apos;&#10;END' />
      </column>
      <column caption='Filter: Partial Period' datatype='boolean' name='[Calculation_2676475185431166976]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;,[partition_date]) = DATETRUNC(&apos;day&apos;,[partition_date])&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[partition_date]) &lt; {FIXED : MAX(DATETRUNC(&apos;month&apos;,[partition_date]))}&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;iso-week&apos;,[partition_date]) &gt; {FIXED : MIN(DATETRUNC(&apos;iso-week&apos;, [partition_date]))} AND DATETRUNC(&apos;iso-week&apos;,[partition_date]) &lt; {FIXED : MAX(DATETRUNC(&apos;iso-week&apos;, [partition_date]))} &#10;END' />
      </column>
      <column caption='Filter: Exclude 2020' datatype='string' name='[Calculation_2840434381429751811]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [partition_date] &lt; DATE(&apos;2021-01-01&apos;) THEN &apos;FALSE&apos;&#10;ELSE &apos;TRUE&apos;&#10;END' />
      </column>
      <column caption='Tooltip: Pandora' datatype='string' name='[Calculation_393502017744510976]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4457789643314278405] = &apos;pandora&apos; THEN &apos;Pandora, &apos;&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='Tooltip: Quick-Commerce, All' datatype='string' name='[Calculation_393502017744646145]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2 4] = &apos;All Brands&apos; THEN &apos;All Brands&apos;&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='Tooltip: Quick-Commerce' datatype='string' name='[Calculation_393502017744797698]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4457789643314278405] = &apos;Quick-Commerce&apos; THEN &apos;Quick-Commerce, &apos;&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='Aggregation Level, Labels' datatype='string' name='[Calculation_393502017745514501]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Day&apos; THEN &apos;Dai&apos;&#10;ELSE [Parameters].[Parameter 1]&#10;END' />
      </column>
      <column caption='Metric: New User Rate (%)' datatype='real' name='[Calculation_393502017746989063]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Metric: Users (copy)_4457789643327299593]/[Calculation_4457789643307675649]' />
      </column>
      <column caption='Metric: Users, Dmart' datatype='real' name='[Calculation_4457789643307675649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN SUM([d_nr_dm_users])&#10;WHEN &apos;Week&apos; THEN SUM([Calculation_4457789643308613635])&#10;WHEN &apos;Month&apos; THEN SUM([Users: Weekly (copy)_4457789643308752900])&#10;END' />
      </column>
      <column caption='Period' datatype='string' name='[Calculation_4457789643308380162]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Day&apos; THEN &#10;    STR(DATEPART(&apos;year&apos;, [partition_date])) + STR(&apos;-&apos;) + STR(DATEPART(&apos;month&apos;, [partition_date])) + STR(&apos;-&apos;) + STR(DATEPART(&apos;day&apos;, [partition_date]))&#10;&#9;&#10;WHEN &apos;Week&apos; THEN &#10;&#9;STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;iso-week&apos;,[partition_date]))) + STR(&quot;-W&quot;) &#10;&#9;+ STR(DATEPART(&apos;iso-week&apos;,[partition_date]))&#10;&#10;WHEN &apos;Month&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date])) &#10;&#9;+ STR(&quot;-&quot;) &#10;&#9;+ IF DATEPART(&apos;month&apos;, [partition_date]) &lt; 10 THEN STR(&quot;0&quot;) ELSE STR(&quot;&quot;) END&#10;&#9;+ STR(DATEPART(&apos;month&apos;, [partition_date]))&#10;&#10;WHEN &apos;Quarter&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date])) + STR(&quot;-Q&quot;) + STR(DATEPART(&apos;quarter&apos;, [partition_date]))&#10;WHEN &apos;Year&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date]))&#10;END' />
      </column>
      <column caption='Users: Weekly, Dmart' datatype='real' name='[Calculation_4457789643308613635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE [brand],[Calculation_4457789643314278405],[global_entity_id],[country], [platform], ISOWEEK([partition_date]): MEDIAN([w_nr_dm_users])}' />
      </column>
      <column caption='Brand Colours' datatype='string' name='[Calculation_4457789643314278405]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2 4] = &apos;Quick-Commerce&apos; THEN &apos;Quick-Commerce&apos;&#10;ELSE [brand]&#10;END' />
        <aliases>
          <alias key='&quot;hungerstation&quot;' value='Quick Market' />
          <alias key='&quot;pandora&quot;' value='Pandamart' />
          <alias key='&quot;pedidosya&quot;' value='D-mart' />
          <alias key='&quot;Quick-Commerce&quot;' value='Dmart' />
          <alias key='&quot;talabat&quot;' value='tMart' />
        </aliases>
      </column>
      <column caption='Metric: Conversion, Dmart' datatype='real' name='[Calculation_4457789643330031629]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(LOOKUP([Calculation_4457789643307675649], -0),LAST())/&#10;LOOKUP(LOOKUP([Calculation_4457789643307675649], -0),FIRST())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Right Arrow, Dmart' datatype='string' name='[Calculation_474074288282824705]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF([Calculation_6144950643787407360] &gt; 0, &apos;➲&apos;, NULL)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Summary: Users, Dmart' datatype='real' name='[Calculation_5522679787665739778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Metric: Users, First Step (New) (copy)_2686678653386854408]/COUNTD([Calculation_4457789643308380162])' />
      </column>
      <column caption='Rounding: Users, Dmart' datatype='real' name='[Calculation_5522679787665969155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_5522679787665739778] &gt;= 1000000000 THEN ROUND([Calculation_5522679787665739778] / 1000000000,1)&#10;ELSEIF [Calculation_5522679787665739778]  &gt;= 1000000 THEN ROUND([Calculation_5522679787665739778]  / 1000000,1)&#10;ELSEIF [Calculation_5522679787665739778]  &gt;= 1000 THEN ROUND([Calculation_5522679787665739778] / 1000,1)&#10;ELSE ROUND([Calculation_5522679787665739778] ,0)&#10;END' />
      </column>
      <column caption='Custom Formatting: Users, Dmart' datatype='string' name='[Calculation_5522679787666227204]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5522679787665739778] &gt;= 1000000000 THEN &quot;B&quot;&#10;ELSEIF [Calculation_5522679787665739778] &gt;= 1000000 THEN &quot;M&quot;&#10;ELSEIF [Calculation_5522679787665739778] &gt;= 1000 THEN &quot;k&quot;&#10;ELSE &quot;&quot;&#10;END' />
      </column>
      <column caption='Metric: Drop-off Rate over Time (%), Dmart' datatype='real' name='[Calculation_5522679787668467717]' role='measure' type='quantitative'>
