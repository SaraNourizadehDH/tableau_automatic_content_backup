      <table>
        <view>
          <datasources>
            <datasource caption='QC-PA: Growth' name='federated.0xy5zl30bl5n1h1dsyigp0mjkzpm (copy)' />
            <datasource name='Parameters' />
            <datasource caption='Category' name='Clipboard_20220922T141228' />
          </datasources>
          <datasource-dependencies datasource='Clipboard_20220922T141228'>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[partition_date]' derivation='Day' name='[dy:partition_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[brand]' derivation='None' name='[none:brand:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[platform]' derivation='None' name='[none:platform:nk]' pivot='key' type='nominal' />
            <column caption='Partition Date' datatype='date' name='[partition_date]' role='dimension' type='ordinal' />
            <column caption='Platform' datatype='string' name='[platform]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Month' caption='Aggregation Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
              <aliases>
                <alias key='&quot;Month&quot;' value='Month' />
                <alias key='&quot;Week&quot;' value='Week' />
              </aliases>
            </column>
            <column caption='Brand Split 4' datatype='string' name='[Parameter 2 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Quick-Commerce&quot;'>
              <calculation class='tableau' formula='&quot;Quick-Commerce&quot;' />
              <aliases>
                <alias key='&quot;hungerstation&quot;' value='--&gt; Hunger Station' />
                <alias key='&quot;pandora&quot;' value='--&gt; Pandora' />
                <alias key='&quot;pedidosya&quot;' value='--&gt; PedidosYa' />
                <alias key='&quot;talabat&quot;' value='--&gt; Talabat' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0xy5zl30bl5n1h1dsyigp0mjkzpm (copy)'>
            <column caption='Filter: Brands' datatype='integer' name='[Calculation_1223501413828034561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2 4] = &apos;Quick-Commerce&apos; THEN 1&#10;ELSEIF  [Parameters].[Parameter 2 4] = &quot;All Brands&quot; THEN 1&#10;ELSEIF [Parameters].[Parameter 2 4] = &quot;talabat&quot; OR [Parameters].[Parameter 2 4] = &quot;pandora&quot; OR [Parameters].[Parameter 2 4] = &apos;pedidosya&apos; OR [Parameters].[Parameter 2 4] = &apos;hungerstation&apos;&#10;    THEN&#10;        IF [Parameters].[Parameter 2 4] = [brand] THEN 1 ELSE 0 END&#10;END' />
            </column>
            <column caption='Label: Local Shops' datatype='string' name='[Calculation_1600466754379931648]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Local Shops&apos;' />
              <aliases>
                <alias key='&quot;Local Stores&quot;' value='Local Shops' />
              </aliases>
            </column>
            <column caption='Filter: Partial Period' datatype='boolean' name='[Calculation_2676475185431166976]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;,[partition_date]) = DATETRUNC(&apos;day&apos;,[partition_date])&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[partition_date]) &lt; {FIXED : MAX(DATETRUNC(&apos;month&apos;,[partition_date]))}&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;iso-week&apos;,[partition_date]) &gt; {FIXED : MIN(DATETRUNC(&apos;iso-week&apos;, [partition_date]))} AND DATETRUNC(&apos;iso-week&apos;,[partition_date]) &lt; {FIXED : MAX(DATETRUNC(&apos;iso-week&apos;, [partition_date]))} &#10;END' />
            </column>
            <column caption='Filter: Exclude 2020' datatype='string' name='[Calculation_2840434381429751811]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [partition_date] &lt; DATE(&apos;2021-01-01&apos;) THEN &apos;FALSE&apos;&#10;ELSE &apos;TRUE&apos;&#10;END' />
            </column>
            <column caption='Tooltip: Pandora' datatype='string' name='[Calculation_393502017744510976]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_4457789643314278405] = &apos;pandora&apos; THEN &apos;Pandora, &apos;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Tooltip: Quick-Commerce, All' datatype='string' name='[Calculation_393502017744646145]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2 4] = &apos;All Brands&apos; THEN &apos;All Brands&apos;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Tooltip: Quick-Commerce' datatype='string' name='[Calculation_393502017744797698]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_4457789643314278405] = &apos;Quick-Commerce&apos; THEN &apos;Quick-Commerce, &apos;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Aggregation Level, Labels' datatype='string' name='[Calculation_393502017745514501]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Day&apos; THEN &apos;Dai&apos;&#10;ELSE [Parameters].[Parameter 1]&#10;END' />
            </column>
            <column caption='Period' datatype='string' name='[Calculation_4457789643308380162]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Day&apos; THEN &#10;    STR(DATEPART(&apos;year&apos;, [partition_date])) + STR(&apos;-&apos;) + STR(DATEPART(&apos;month&apos;, [partition_date])) + STR(&apos;-&apos;) + STR(DATEPART(&apos;day&apos;, [partition_date]))&#10;&#9;&#10;WHEN &apos;Week&apos; THEN &#10;&#9;STR(DATEPART(&apos;year&apos;, DATETRUNC(&apos;iso-week&apos;,[partition_date]))) + STR(&quot;-W&quot;) &#10;&#9;+ STR(DATEPART(&apos;iso-week&apos;,[partition_date]))&#10;&#10;WHEN &apos;Month&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date])) &#10;&#9;+ STR(&quot;-&quot;) &#10;&#9;+ IF DATEPART(&apos;month&apos;, [partition_date]) &lt; 10 THEN STR(&quot;0&quot;) ELSE STR(&quot;&quot;) END&#10;&#9;+ STR(DATEPART(&apos;month&apos;, [partition_date]))&#10;&#10;WHEN &apos;Quarter&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date])) + STR(&quot;-Q&quot;) + STR(DATEPART(&apos;quarter&apos;, [partition_date]))&#10;WHEN &apos;Year&apos; THEN STR(DATEPART(&apos;year&apos;, [partition_date]))&#10;END' />
            </column>
            <column caption='Brand Colours' datatype='string' name='[Calculation_4457789643314278405]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2 4] = &apos;Quick-Commerce&apos; THEN &apos;Quick-Commerce&apos;&#10;ELSE [brand]&#10;END' />
              <aliases>
                <alias key='&quot;hungerstation&quot;' value='Quick Market' />
                <alias key='&quot;pandora&quot;' value='Pandamart' />
                <alias key='&quot;pedidosya&quot;' value='D-mart' />
                <alias key='&quot;Quick-Commerce&quot;' value='Dmart' />
                <alias key='&quot;talabat&quot;' value='tMart' />
              </aliases>
            </column>
            <column caption='Filter: Year' datatype='string' name='[Calculation_6947365406612795395]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([partition_date]))' />
            </column>
            <column caption='Metric: Conversion over Time (%), Returning - Dmart' datatype='real' name='[Metric: Conversion over Time (%), New (copy)_2686678653376176135]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Metric: Users, First Step  (Returning) (copy)_2686678653375754245]/[Metric: Users, First Step (copy)_2686678653374873602]' />
            </column>
            <column caption='Metric: Conversion over Time (%), Returning - Local Shops' datatype='real' name='[Metric: Conversion over Time (%), Returning - Dmart (copy)_1600466754687459346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Metric: Users, Last Step (Returning) - Dmart (copy)_1600466754689142807]/[Metric: Users, First Step (Returning) - Dmart (copy)_1600466754687774741]' />
            </column>
            <column caption='Tooltip: Conversion over Time (%), Returning - Dmart' datatype='real' name='[Metric: Conversion over Time (%), Returning - Dmart (copy)_4968174127727312903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Metric: Users, First Step  (Returning) (copy)_2686678653375754245]/[Metric: Users, First Step (copy)_2686678653374873602]' />
            </column>
            <column caption='Metric: Users, Last Step (Returning) - Dmart' datatype='integer' name='[Metric: Users, First Step  (Returning) (copy)_2686678653375754245]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN&#10;    SUM(IF [step] = &apos;5. Transaction&apos; AND [partition_date] = &#10;    {INCLUDE [brand],[Calculation_4457789643314278405],[global_entity_id],[country],[platform], DAY([partition_date]): MAX([partition_date])}&#10;    THEN [d_nr_dm_ret_usr] ELSE 0 END)&#10;WHEN &apos;Week&apos; THEN&#10;    SUM(IF [step] = &apos;5. Transaction&apos; AND [partition_date] = &#10;    {INCLUDE [brand],[Calculation_4457789643314278405],[global_entity_id],[country],[platform], ISOWEEK([partition_date]): MAX([partition_date])}&#10;    THEN [w_nr_dm_ret_usr] ELSE 0 END)&#10;WHEN &apos;Month&apos; THEN&#10;    SUM(IF [step] = &apos;5. Transaction&apos; AND [partition_date] = &#10;    {INCLUDE [brand],[Calculation_4457789643314278405],[global_entity_id],[country],[platform], MONTH([partition_date]): MAX([partition_date])}&#10;    THEN [m_nr_dm_ret_usr] ELSE 0 END)&#10;END' />
            </column>
            <column caption='Metric: Users, First Step (Returning) - Local Shops' datatype='integer' name='[Metric: Users, First Step (Returning) - Dmart (copy)_1600466754687774741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN&#10;    SUM(IF [step] = &apos;1. Visiting Store (DMart/Local Stores)&apos; AND [partition_date] = &#10;    {INCLUDE [brand],[Calculation_4457789643314278405],[global_entity_id],[country],[platform], DAY([partition_date]): MAX([partition_date])}&#10;    THEN [d_nr_ls_ret_usr] ELSE 0 END)&#10;WHEN &apos;Week&apos; THEN&#10;    SUM(IF [step] = &apos;1. Visiting Store (DMart/Local Stores)&apos; AND [partition_date] = &#10;    {INCLUDE [brand],[Calculation_4457789643314278405],[global_entity_id],[country],[platform], ISOWEEK([partition_date]): MAX([partition_date])}&#10;    THEN [w_nr_ls_ret_usr] ELSE 0 END)&#10;WHEN &apos;Month&apos; THEN&#10;    SUM(IF [step] = &apos;1. Visiting Store (DMart/Local Stores)&apos; AND [partition_date] = &#10;    {INCLUDE [brand],[Calculation_4457789643314278405],[global_entity_id],[country],[platform], MONTH([partition_date]): MAX([partition_date])}&#10;    THEN [m_nr_ls_ret_usr] ELSE 0 END)&#10;END' />
            </column>
            <column caption='Metric: Users, First Step (Returning) - Dmart' datatype='integer' name='[Metric: Users, First Step (copy)_2686678653374873602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN&#10;    SUM(IF [step] = &apos;1. Visiting Store (DMart/Local Stores)&apos; AND [partition_date] = &#10;    {INCLUDE [brand],[Calculation_4457789643314278405],[global_entity_id],[country],[platform], DAY([partition_date]): MAX([partition_date])}&#10;    THEN [d_nr_dm_ret_usr] ELSE 0 END)&#10;WHEN &apos;Week&apos; THEN&#10;    SUM(IF [step] = &apos;1. Visiting Store (DMart/Local Stores)&apos; AND [partition_date] = &#10;    {INCLUDE [brand],[Calculation_4457789643314278405],[global_entity_id],[country],[platform], ISOWEEK([partition_date]): MAX([partition_date])}&#10;    THEN [w_nr_dm_ret_usr] ELSE 0 END)&#10;WHEN &apos;Month&apos; THEN&#10;    SUM(IF [step] = &apos;1. Visiting Store (DMart/Local Stores)&apos; AND [partition_date] = &#10;    {INCLUDE [brand],[Calculation_4457789643314278405],[global_entity_id],[country],[platform], MONTH([partition_date]): MAX([partition_date])}&#10;    THEN [m_nr_dm_ret_usr] ELSE 0 END)&#10;END' />
            </column>
            <column caption='Metric: Users, Last Step (Returning) - Local Shops' datatype='integer' name='[Metric: Users, Last Step (Returning) - Dmart (copy)_1600466754689142807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Day&apos; THEN&#10;    SUM(IF [step] = &apos;5. Transaction&apos; AND [partition_date] = &#10;    {INCLUDE [brand],[Calculation_4457789643314278405],[global_entity_id],[country],[platform], DAY([partition_date]): MAX([partition_date])}&#10;    THEN [d_nr_ls_ret_usr] ELSE 0 END)&#10;WHEN &apos;Week&apos; THEN&#10;    SUM(IF [step] = &apos;5. Transaction&apos; AND [partition_date] = &#10;    {INCLUDE [brand],[Calculation_4457789643314278405],[global_entity_id],[country],[platform], ISOWEEK([partition_date]): MAX([partition_date])}&#10;    THEN [w_nr_ls_ret_usr] ELSE 0 END)&#10;WHEN &apos;Month&apos; THEN&#10;    SUM(IF [step] = &apos;5. Transaction&apos; AND [partition_date] = &#10;    {INCLUDE [brand],[Calculation_4457789643314278405],[global_entity_id],[country],[platform], MONTH([partition_date]): MAX([partition_date])}&#10;    THEN [m_nr_ls_ret_usr] ELSE 0 END)&#10;END' />
            </column>
            <column caption='Tooltip: Quick Market' datatype='string' name='[Tooltip: HungerStation (copy)_1600466754728054808]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_4457789643314278405] = &apos;hungerstation&apos; THEN &apos;Quick Market&apos;&#10;ELSE &apos;&apos;&#10;END' />
