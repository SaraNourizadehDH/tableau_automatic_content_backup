            </column>
            <column caption='Filter: Year' datatype='string' name='[Calculation_6947365406612795395]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([partition_date]))' />
            </column>
            <column caption='Difference (#), Dmart' datatype='real' name='[Difference (%) (copy)_6144950643796320262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOOKUP([Calculation_4457789643307675649], 1)'>
                <table-calc ordering-type='Rows' />
