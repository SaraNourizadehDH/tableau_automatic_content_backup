            <column caption='Metric: Conversion over Time (%), Dmart' datatype='real' name='[Metric: Conversion (copy)_393502017763672076]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Metric: Users, Last Step (New) (copy)_2686678653387010057]/[Metric: Users, First Step (New) (copy)_2686678653386854408])' />
