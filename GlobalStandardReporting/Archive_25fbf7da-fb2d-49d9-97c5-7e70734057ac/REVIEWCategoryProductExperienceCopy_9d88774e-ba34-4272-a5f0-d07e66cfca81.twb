      <column caption='STR: Category Visits, Sessions' datatype='integer' name='[Calculation_4321274220025208836]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM([nr_cat_visit_s])' />
      </column>
      <column caption='Filter: Partial Period (1)' datatype='boolean' name='[Calculation_4321274220026925061 1]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 5]&#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;,[partition_date]) = DATETRUNC(&apos;day&apos;,[partition_date])&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[partition_date]) &lt; {FIXED : MAX(DATETRUNC(&apos;month&apos;,[partition_date]))}&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;iso-week&apos;,[partition_date]) &gt; {FIXED : MIN(DATETRUNC(&apos;iso-week&apos;, [partition_date]))} AND DATETRUNC(&apos;iso-week&apos;,[partition_date]) &lt; {FIXED : MAX(DATETRUNC(&apos;iso-week&apos;, [partition_date]))} &#10;END' />
      </column>
      <column caption='Filter: Partial Period' datatype='boolean' name='[Calculation_4321274220026925061]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 4]&#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;,[partition_date]) = DATETRUNC(&apos;day&apos;,[partition_date])&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[partition_date]) &lt; {FIXED : MAX(DATETRUNC(&apos;month&apos;,[partition_date]))}&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;iso-week&apos;,[partition_date]) &gt; {FIXED : MIN(DATETRUNC(&apos;iso-week&apos;, [partition_date]))} AND DATETRUNC(&apos;iso-week&apos;,[partition_date]) &lt; {FIXED : MAX(DATETRUNC(&apos;iso-week&apos;, [partition_date]))} &#10;END' />
      </column>
