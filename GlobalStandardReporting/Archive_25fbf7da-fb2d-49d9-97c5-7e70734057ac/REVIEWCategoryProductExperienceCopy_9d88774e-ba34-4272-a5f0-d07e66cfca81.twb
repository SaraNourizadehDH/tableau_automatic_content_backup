            </column>
            <column caption='Custom Formatting: Users, Local Shops' datatype='string' name='[Custom Formatting: Users, Dmart (copy)_7012949080477216768]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Summary: Users, Dmart (copy)_6100547943194705928] &gt;= 1000000000 THEN &quot;B&quot;&#10;ELSEIF [Summary: Users, Dmart (copy)_6100547943194705928] &gt;= 1000000 THEN &quot;M&quot;&#10;ELSEIF [Summary: Users, Dmart (copy)_6100547943194705928] &gt;= 1000 THEN &quot;k&quot;&#10;ELSE &quot;&quot;&#10;END'>
