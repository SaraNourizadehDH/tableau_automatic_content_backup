          <zone forceUpdate='true' h='24897' id='18' type-v2='text' w='98828' x='586' y='41839'>
            <formatted-text>
              <run bold='true' fontcolor='#df3534' fontsize='13'>MEDIA ASSET PERFORMANCE</run>
              <run>
Note:- All the metrics used over here are at a session-level granularity. 

</run>
              <run bold='true' fontcolor='#ff2600' fontsize='12'>Media Asset Usage and CTR% (Click-Through Rate)</run>
              <run>
# of sessions where specific media-asset was visited over vertical sessions.

</run>
              <run bold='true' fontcolor='#ff2600' fontsize='12'>Media Asset ATC% (Add-to-Cart)</run>
              <run>
# of sessions where there was an ATC from the specific media-asset asset over # of sessions where specific media-asset was visited.

</run>
              <run bold='true' fontcolor='#ff2600' fontsize='12'>Media Asset CVR% (Conversion-rate)</run>
              <run>
# of converted sessions from a specific media asset over # of sessions where there was an ATC from the specific media-asset asset.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
