            </column>
            <column caption='Users: Monthly, Dmart' datatype='real' name='[Users: Weekly (copy)_4457789643308752900]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE [brand], [Calculation_4457789643314278405], [global_entity_id],[country], [platform], [month_number]: MEDIAN([m_nr_dm_users])}' />
            </column>
