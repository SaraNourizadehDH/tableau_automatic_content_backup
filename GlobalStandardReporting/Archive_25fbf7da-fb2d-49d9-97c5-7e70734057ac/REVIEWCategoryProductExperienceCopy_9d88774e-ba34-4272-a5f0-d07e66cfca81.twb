      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='21915' id='3' type-v2='text' w='49414' x='586' y='16618'>
            <formatted-text>
              <run bold='true' fontcolor='#df3534' fontsize='13'>USER FUNNEL</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ff2600' fontsize='12'>Sales Funnel Conversion</run>
              <run>
Percentage of users who completed a transaction over all users in a funnel.

</run>
              <run bold='true' fontcolor='#ff2600' fontsize='12'>Drop-off Rate </run>
              <run>
Percentage of users who did not reach a specific step over all users in a funnel.

</run>
              <run bold='true' fontcolor='#ff2600' fontsize='12'>Returning Users</run>
              <run>
Distinct count of users who visited q-commerce before (Time  agnostic).
</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='21915' id='6' type-v2='text' w='49414' x='50000' y='16618'>
