            <column caption='Rounding: Sessions, PDP (1)' datatype='real' name='[Rounding: Sessions, Category (copy)_6336846160847269891 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Metric: Avg. Category Sessions, Summary (copy)_6336846160847155202 1]) &gt;= 1000000000 THEN ROUND(SUM([Metric: Avg. Category Sessions, Summary (copy)_6336846160847155202 1]) / 1000000000,1)&#10;ELSEIF SUM([Metric: Avg. Category Sessions, Summary (copy)_6336846160847155202 1])  &gt;= 1000000 THEN ROUND(SUM([Metric: Avg. Category Sessions, Summary (copy)_6336846160847155202 1]) / 1000000,1)&#10;ELSEIF SUM([Metric: Avg. Category Sessions, Summary (copy)_6336846160847155202 1]) &gt;= 1000 THEN ROUND(SUM([Metric: Avg. Category Sessions, Summary (copy)_6336846160847155202 1]) / 1000,1)&#10;ELSE ROUND(SUM([Metric: Avg. Category Sessions, Summary (copy)_6336846160847155202 1]), 0)&#10;END' />
            </column>
