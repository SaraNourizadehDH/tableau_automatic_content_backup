      <column caption='Target % calculation' datatype='real' name='[Actual % calculation (copy)_1574008123458568192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_344455048669909003] * MAX([federated.0na4yis1gxzg1215snpx30bqekvu].[Calculation_5752293043956514817])' />
      </column>
      <column caption='Date Dimension' datatype='string' name='[Calculation_1739656137992036372]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Quarterly&apos;&#10;THEN [quarter]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Weekly&apos;&#10;THEN [week]&#10;END' />
      </column>
      <column caption='DRAFT' datatype='real' name='[Calculation_247979507926269952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([contacts]) &#10;/ SUM([Calculation_344455048669450250])) * IFNULL(SUM([federated.0na4yis1gxzg1215snpx30bqekvu].[actual]),1)' />
      </column>
      <column aggregation='Attribute' caption='Total contacts' datatype='integer' name='[Calculation_344455048669450250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [status],[Calculation_5752293044049391622] : SUM([contacts])}' />
      </column>
      <column caption='% Breakdown contacts' datatype='real' name='[Calculation_344455048669909003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([contacts]) &#10;/ SUM([Calculation_344455048669450250])) * 100' />
      </column>
      <column caption='Contact Rate (HC)' datatype='real' name='[Calculation_4485655643111333888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([contacts])&#10;/ SUM([sessions]) * 100' />
      </column>
      <column caption='Quarter' datatype='string' name='[Calculation_4664321893413679105]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [week] WHEN&apos;2022-52&apos;&#10;   THEN &apos;2022-4&apos;&#10;  ELSE [quarter] END' />
