              <calculation class='tableau' formula='CASE [Parameters].[WB KPI 1 (copy)_2111554927716061185]&#10;    WHEN &apos;Total_Population&apos; THEN SUM([Total_Population])&#10;    WHEN &apos;Pop_growth&apos; THEN AVG([Pop_growth])&#10;    WHEN &apos;Pop_density&apos; THEN SUM([Pop_density])&#10;    WHEN &apos;Umployment_rate&apos; THEN AVG([Umployment_rate])&#10;    WHEN &apos;Taxes_on_goods_and_services&apos; THEN AVG([Taxes_on_goods_and_services])&#10;    WHEN &apos;Income_per_Capita_Growth&apos; THEN AVG([Income_per_Capita_Growth])&#10;    WHEN &apos;Consumer_Price_Index&apos; THEN SUM([Consumer_Price_Index])&#10;    WHEN &apos;Inflation&apos; THEN AVG(Inflation)&#10;    WHEN &apos;Diesel_price_per_liter&apos; THEN SUM([Diesel_price_per_liter])&#10;    WHEN &apos;Ease_of_doing_business_score&apos; THEN AVG([Ease_of_doing_business_score])&#10;    WHEN &apos;New_business&apos; THEN SUM([New_business])&#10;    WHEN &apos;New_business_per_1k_people&apos; THEN AVG([New_business_per_1k_people])&#10;    WHEN &apos;Commercial_profit_tax&apos; THEN AVG([Commercial_profit_tax])&#10;    WHEN &apos;Mobile_subscriptions&apos; THEN SUM([Mobile_subscriptions])&#10;    WHEN &apos;Mobile_subscriptions_per_100_people&apos; THEN AVG([Mobile_subscriptions_per_100_people])&#10;    WHEN &apos;Broadband_subscriptions_per_100_people&apos; THEN AVG([Broadband_subscriptions_per_100_people])&#10;    WHEN &apos;Percentage_of_pop_using_internet&apos; THEN AVG([Percentage_of_pop_using_internet])&#10;    WHEN &apos;Percentage_of_pop_25_with_completed_primary_education&apos; THEN AVG([Percentage_of_pop_25_with_completed_primary_education])&#10;    WHEN &apos;Labor_force_participation_rate&apos; THEN AVG([Labor_force_participation_rate])&#10;    WHEN &apos;GDP_constant_2015_US&apos; THEN SUM([GDP_constant_2015_US])&#10;    WHEN &apos;GDP_current_US&apos; THEN SUM([GDP_current_US])&#10;    WHEN &apos;GDP_growth&apos; THEN AVG([GDP_growth])&#10;    WHEN &apos;GDP_per_capita_constant_2015_US