            <column caption='Acq Comm Rate Dash' datatype='real' datatype-customized='true' name='[Acq Comm Rate (copy)_192528943020306435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([new_intake_commission_eur])/SUM([new_intake_commission_base_eur]))*100' />
            </column>
