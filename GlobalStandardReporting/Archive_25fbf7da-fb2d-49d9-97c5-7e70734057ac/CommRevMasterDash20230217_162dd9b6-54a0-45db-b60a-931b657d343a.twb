    <worksheet name='WB KPI 1 (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='world bank data pivot' name='federated.0sbmx750u3zbqm1ervypo00wymqh' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='WB KPI 1' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Rural_pop_growth&quot;'>
              <calculation class='tableau' formula='&quot;Rural_pop_growth&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0sbmx750u3zbqm1ervypo00wymqh'>
            <column caption='Broadband subscriptions per 100 people' datatype='real' name='[Broadband_subscriptions_per_100_people]' role='measure' type='quantitative' />
            <column caption='WB KPI 1' datatype='real' name='[Calculation_2111554927716257794]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;Total_Population&apos; THEN SUM([Total_Population])&#10;    WHEN &apos;Pop_growth&apos; THEN AVG([Pop_growth])&#10;    WHEN &apos;Pop_density&apos; THEN SUM([Pop_density])&#10;    WHEN &apos;Umployment_rate&apos; THEN AVG([Umployment_rate])&#10;    WHEN &apos;Taxes_on_goods_and_services&apos; THEN AVG([Taxes_on_goods_and_services])&#10;    WHEN &apos;Income_per_Capita_Growth&apos; THEN AVG([Income_per_Capita_Growth])&#10;    WHEN &apos;Consumer_Price_Index&apos; THEN SUM([Consumer_Price_Index])&#10;    WHEN &apos;Inflation&apos; THEN AVG(Inflation)&#10;    WHEN &apos;Diesel_price_per_liter&apos; THEN SUM([Diesel_price_per_liter])&#10;    WHEN &apos;Ease_of_doing_business_score&apos; THEN AVG([Ease_of_doing_business_score])&#10;    WHEN &apos;New_business&apos; THEN SUM([New_business])&#10;    WHEN &apos;New_business_per_1k_people&apos; THEN AVG([New_business_per_1k_people])&#10;    WHEN &apos;Commercial_profit_tax&apos; THEN AVG([Commercial_profit_tax])&#10;    WHEN &apos;Mobile_subscriptions&apos; THEN SUM([Mobile_subscriptions])&#10;    WHEN &apos;Mobile_subscriptions_per_100_people&apos; THEN AVG([Mobile_subscriptions_per_100_people])&#10;    WHEN &apos;Broadband_subscriptions_per_100_people&apos; THEN AVG([Broadband_subscriptions_per_100_people])&#10;    WHEN &apos;Percentage_of_pop_using_internet&apos; THEN AVG([Percentage_of_pop_using_internet])&#10;    WHEN &apos;Percentage_of_pop_25_with_completed_primary_education&apos; THEN AVG([Percentage_of_pop_25_with_completed_primary_education])&#10;    WHEN &apos;Labor_force_participation_rate&apos; THEN AVG([Labor_force_participation_rate])&#10;    WHEN &apos;GDP_constant_2015_US&apos; THEN SUM([GDP_constant_2015_US])&#10;    WHEN &apos;GDP_current_US&apos; THEN SUM([GDP_current_US])&#10;    WHEN &apos;GDP_growth&apos; THEN AVG([GDP_growth])&#10;    WHEN &apos;GDP_per_capita_constant_2015_US&apos; THEN AVG([GDP_per_capita_constant_2015_US])&#10;    WHEN &apos;GDP_per_capita_current_US&apos; THEN AVG([GDP_per_capita_current_US])&#10;    WHEN &apos;GDP_per_capita_growth&apos; THEN AVG([GDP_per_capita_growth])&#10;    WHEN &apos;Gini_index&apos; THEN AVG([Gini_index])&#10;    WHEN &apos;Human_Capital_Index&apos; THEN AVG([Human_Capital_Index])&#10;    WHEN &apos;Rural_land_area_sq_KM&apos; THEN SUM([Rural_land_area_sq_KM])&#10;    WHEN &apos;Rural_population&apos; THEN SUM([Rural_population])&#10;    WHEN &apos;Rural_population_percentage_of_total_pop&apos; THEN AVG([Rural_population_percentage_of_total_pop])&#10;    WHEN &apos;Rural_pop_growth&apos; THEN AVG([Rural_pop_growth])&#10;    WHEN &apos;Urban_land_area_sq_KM&apos; THEN SUM([Urban_land_area_sq_KM])&#10;    WHEN &apos;Urban_population&apos; THEN SUM([Urban_population])&#10;    WHEN &apos;Urban_population_percentage_of_total_pop&apos; THEN AVG([Urban_population_percentage_of_total_pop])&#10;    WHEN &apos;Urban_pop_growth&apos; THEN AVG([Urban_pop_growth])&#10;END' />
            </column>
            <column caption='Commercial profit tax' datatype='real' name='[Commercial_profit_tax]' role='measure' type='quantitative' />
            <column caption='Consumer Price Index' datatype='real' name='[Consumer_Price_Index]' role='measure' type='quantitative' />
            <column caption='Diesel price per liter' datatype='real' name='[Diesel_price_per_liter]' role='measure' type='quantitative' />
