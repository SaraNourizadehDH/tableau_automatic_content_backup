          <datasource-dependencies datasource='federated.05u51qi1f3outg1aee7xu0xhe5e5'>
            <column caption='Acq Comm Rate Dash' datatype='real' datatype-customized='true' name='[Acq Comm Rate (copy)_192528943020306435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([new_intake_commission_eur])/SUM([new_intake_commission_base_eur]))*100' />
            </column>
            <column datatype='integer' name='[Acquisitions]' role='measure' type='quantitative' />
            <column caption='below_floor' datatype='boolean' name='[Calculation_2630172558224904277]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [floor_app] &gt; [comm_rate_kpis] THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Avg Comm Rev per Vendor' datatype='real' name='[Calculation_3286079622900871169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_eur])/SUM([total_vendors])' />
            </column>
            <column caption='AFV' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_3286079622902603782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_base_eur])/SUM([orders])' />
            </column>
            <column caption='Avg Listing Fees' datatype='real' name='[Calculation_3286079622902964231]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_list_fees])/SUM([total_vendors])' />
            </column>
            <column caption='Avg Registration Fees' datatype='real' name='[Calculation_3286079622903377928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_reg_fees_new_intake])/SUM([Acquisitions])' />
            </column>
            <column caption='Avg Order per Ven' datatype='real' name='[Calculation_3286079622903676937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM([total_vendors])' />
            </column>
            <column caption='Date Filter' datatype='boolean' name='[Calculation_616359894184873984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[YearMonth]&lt; [Test (copy)_616359894189690883]' />
            </column>
            <column caption='Test' datatype='date' default-format='*yyyymm' name='[Calculation_616359894186373121]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY()' />
            </column>
            <column caption='Comm Rate Dash' datatype='real' datatype-customized='true' name='[Comm Rate (copy)_192528943019425792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([commission_eur])/SUM([commission_base_eur]))*100' />
            </column>
            <column caption='Floor Compliance Dash' datatype='real' name='[Floor Compliance (copy)_192528943020380164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(1.00 - SUM([vendors_below_floor])/SUM([total_vendors]))*100' />
            </column>
            <column caption='KPI 6' datatype='real' name='[KPI 4 (copy) (copy)_372039564451713033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;Acquisitions&apos; THEN SUM([Acquisitions])&#10;ELSEIF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;Trial Acquisitions&apos; THEN SUM([Trial_Acquisitions])&#10;&#10;ELSEIF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;Floor Compliance&apos; THEN [Floor Compliance (copy)_192528943020380164]&#10;ELSEIF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;Comm Rev&apos; THEN SUM([commission_eur])&#10;ELSEIF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;Comm Base&apos; THEN SUM([commission_base_eur])&#10;ELSEIF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;Comm Rate&apos; THEN [Comm Rate (copy)_192528943019425792]&#10;ELSEIF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;Acq Comm Rate&apos; THEN [Acq Comm Rate (copy)_192528943020306435]&#10;ELSEIF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;Active Vendors&apos; THEN SUM([active_vendors])&#10;ELSEIF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;Avg Comm Rev per Vendor&apos; THEN [Calculation_3286079622900871169]&#10;ELSEIF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;AFV&apos; THEN [Calculation_3286079622902603782]&#10;&#10;ELSEIF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;Total Vendors paying Listing Fees&apos; THEN SUM([total_vendors_paying_list])&#10;ELSEIF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;Listing Fees Compliance&apos; THEN [Listing Fees Compliance (copy)_192528943020077057]&#10;ELSEIF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;Avg Listing Fees&apos; THEN [Calculation_3286079622902964231]&#10;ELSEIF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;Total Listing Fees&apos; THEN SUM([total_list_fees])&#10;&#10;ELSEIF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;Total Vendors paying Reg Fees&apos; THEN SUM([total_vendors_paying_reg])&#10;ELSEIF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;Reg Fees Compliance&apos; THEN [Registration Fees Compliance (copy)_192528943020175362]&#10;ELSEIF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;Avg Reg Fees&apos; THEN [Calculation_3286079622903377928]&#10;ELSEIF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;Total Reg Fees&apos; THEN SUM([total_reg_fees])&#10;&#10;ELSEIF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;Acquisitions Comm Rev&apos; THEN SUM([new_intake_commission_eur])&#10;ELSEIF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;Acquisitions GFV&apos; THEN SUM([new_intake_commission_base_eur])&#10;ELSEIF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;Orders&apos; THEN SUM([orders])&#10;ELSEIF [Parameters].[KPI 5 (copy)_372039564446195713] = &apos;Avg Orders per Vendor&apos; THEN [Calculation_3286079622903676937]&#10;END' />
            </column>
            <column caption='DIMENSION 1' datatype='string' name='[KPI 4 (copy)_372039564448088069]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[KPI 6 (copy)_372039564447137794]&#10;WHEN &quot;Vendor Sub Category&quot; THEN [ka_sub_category]&#10;//WHEN &apos;Above_Below_Floor&apos; THEN [below_floor]&#10;//WHEN &apos;Preferred Partnership&apos; THEN [is_preferred_partner]&#10;WHEN &apos;Entity&apos; THEN [management_entity]&#10;WHEN &apos;Market&apos; THEN [display_name]&#10;WHEN &apos;Vertical Segment&apos; THEN [vertical_segment_c]&#10;WHEN &apos;Year Month&apos; THEN [YearMonth]&#10;END' />
            </column>
            <column caption='KPI 5' datatype='real' name='[KPI 4 (copy)_372039564451700744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[KPI 4 (copy)_372039564446134272] = &apos;Acquisitions&apos; THEN SUM([Acquisitions])&#10;ELSEIF [Parameters].[KPI 4 (copy)_372039564446134272] = &apos;Trial Acquisitions&apos; THEN SUM([Trial_Acquisitions])&#10;&#10;ELSEIF [Parameters].[KPI 4 (copy)_372039564446134272] = &apos;Floor Compliance&apos; THEN [Floor Compliance (copy)_192528943020380164]&#10;ELSEIF [Parameters].[KPI 4 (copy)_372039564446134272] = &apos;Comm Rev&apos; THEN SUM([commission_eur])&#10;ELSEIF [Parameters].[KPI 4 (copy)_372039564446134272] = &apos;Comm Base&apos; THEN SUM([commission_base_eur])&#10;ELSEIF [Parameters].[KPI 4 (copy)_372039564446134272] = &apos;Comm Rate&apos; THEN [Comm Rate (copy)_192528943019425792]&#10;ELSEIF [Parameters].[KPI 4 (copy)_372039564446134272] = &apos;Acq Comm Rate&apos; THEN [Acq Comm Rate (copy)_192528943020306435]&#10;ELSEIF [Parameters].[KPI 4 (copy)_372039564446134272] = &apos;Active Vendors&apos; THEN SUM([active_vendors])&#10;ELSEIF [Parameters].[KPI 4 (copy)_372039564446134272] = &apos;Avg Comm Rev per Vendor&apos; THEN [Calculation_3286079622900871169]&#10;ELSEIF [Parameters].[KPI 4 (copy)_372039564446134272] = &apos;AFV&apos; THEN [Calculation_3286079622902603782]&#10;&#10;ELSEIF [Parameters].[KPI 4 (copy)_372039564446134272] = &apos;Total Vendors paying Listing Fees&apos; THEN SUM([total_vendors_paying_list])&#10;ELSEIF [Parameters].[KPI 4 (copy)_372039564446134272] = &apos;Listing Fees Compliance&apos; THEN [Listing Fees Compliance (copy)_192528943020077057]&#10;ELSEIF [Parameters].[KPI 4 (copy)_372039564446134272] = &apos;Avg Listing Fees&apos; THEN [Calculation_3286079622902964231]&#10;ELSEIF [Parameters].[KPI 4 (copy)_372039564446134272] = &apos;Total Listing Fees&apos; THEN SUM([total_list_fees])&#10;&#10;ELSEIF [Parameters].[KPI 4 (copy)_372039564446134272] = &apos;Total Vendors paying Reg Fees&apos; THEN SUM([total_vendors_paying_reg])&#10;ELSEIF [Parameters].[KPI 4 (copy)_37203