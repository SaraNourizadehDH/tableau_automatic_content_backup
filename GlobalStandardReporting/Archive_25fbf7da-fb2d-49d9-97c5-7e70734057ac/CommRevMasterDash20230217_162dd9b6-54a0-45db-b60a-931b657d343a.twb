            <column caption='KPI 2' datatype='string' name='[KPI 1 (copy)_4034451223604277254]' param-domain-type='list' role='measure' type='nominal' value='&quot;Acquisitions GFV&quot;'>
              <calculation class='tableau' formula='&quot;Acquisitions GFV&quot;' />
