            </column>
            <column caption='Avg_Orders_per_week_AGG' datatype='real' name='[Calculation_326510977937076227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if  sum([period_orders]) = 0&#13;&#10;then  0&#13;&#10;else&#13;&#10;sum([period_orders])/sum([period_rests])&#13;&#10;end' />
