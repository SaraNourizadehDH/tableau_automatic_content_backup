    <worksheet name='Rest Cohort % Month'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Active restaurants % reordering each month after activation</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rsc_cohort_overview_report (rl_sales_revenue)' name='federated.1ln2bhh1aeuvhd18wjiwm0ib14w4' />
            <datasource caption='rsc_cohort_vendor_detail_report (rl_sales_revenue)' name='federated.02lyx9319dy39i1cfzb151kwa71v' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Yes' caption='Include Current Month' datatype='boolean' name='[Include Current Week (copy)_571112760279289856]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
              <aliases>
                <alias key='false' value='No' />
                <alias key='true' value='Yes' />
              </aliases>
            </column>
            <column caption='No_Months' datatype='integer' name='[No_Weeks (copy)_571112760279408641]' param-domain-type='range' role='measure' type='quantitative' value='6'>
              <calculation class='tableau' formula='6' />
              <range granularity='1' max='30' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.02lyx9319dy39i1cfzb151kwa71v'>
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ln2bhh1aeuvhd18wjiwm0ib14w4'>
            <column caption='Rest_Reorder_Perc_AGG' datatype='real' name='[Calculation_326510977935507458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if sum([period_rests]) = 0&#13;&#10;then 0&#13;&#10;else  sum([period_rests]) / sum([total_cohort_rests])&#13;&#10;END' />
            </column>
            <column caption='Cohort Rests' datatype='integer' name='[Calculation_947163328825602055]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='sum([total_cohort_rests])' />
            </column>
            <column caption='Cohort_Orders' datatype='integer' name='[Calculation_947163328825901064]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='sum([total_cohort_orders])' />
            </column>
            <column caption='Date_Range_Month' datatype='boolean' name='[Date_Range (copy)_571112760279515138]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if  [Parameters].[Include Current Week (copy)_571112760279289856] = True &#13;&#10;then [report_date] &lt;=  [latest_reporting_date]&#13;&#10;and  [report_date] &gt;= [Start Date (copy)_571112760279961603]&#13;&#10;ELSEIF  [Parameters].[Include Current Week (copy)_571112760279289856] = FALSE&#13;&#10;then [report_date] &lt; [latest_reporting_date]&#13;&#10;and  [report_date] &gt;= [Start Date (copy)_571112760279961603]&#13;&#10;END' />
            </column>
            <column caption='Period_Range_Month' datatype='boolean' name='[Period_Range (copy)_241505562884411392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if  [Parameters].[Include Current Week (copy)_571112760279289856] = True &#13;&#10;then [cohort_period_number_date] &lt;=  [latest_reporting_date]&#13;&#10;ELSEIF  [Parameters].[Include Current Week (copy)_571112760279289856] = FALSE&#13;&#10;then [cohort_period_number_date] &lt; [latest_reporting_date]&#13;&#10;END' />
            </column>
            <column caption='Start Date Month' datatype='date' name='[Start Date (copy)_571112760279961603]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;month&apos;,-[Parameters].[No_Weeks (copy)_571112760279408641],[latest_reporting_date]))' />
            </column>
            <column caption='Cohort Period Number' datatype='integer' name='[cohort_period_number]' role='dimension' type='ordinal' />
