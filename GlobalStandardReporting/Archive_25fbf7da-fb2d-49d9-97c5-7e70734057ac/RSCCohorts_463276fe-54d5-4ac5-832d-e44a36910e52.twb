    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/RSCCohorts/Definitions?rev=' id='Definitions' path='/t/GlobalStandardReporting/workbooks/RSCCohorts_16457915008170' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1361' maxwidth='1357' minheight='1361' minwidth='1357' preset-index='0' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='29023' id='3' type-v2='text' w='98820' x='590' y='70389'>
            <formatted-text>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='69801' id='69' param='vert' type-v2='layout-flow' w='98820' x='590' y='588'>
            <zone forceUpdate='true' h='69801' id='70' type-v2='text' w='98820' x='590' y='588'>
              <formatted-text>
                <run bold='true' fontcolor='#000000' fontsize='20'>Scope and defintions:</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='14'>Scope: </run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>All cancelled orders and test orders are excluded from all data</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#555555' fontsize='10'>Week numbers start at 1 with week 1 being the activation week of the restaurant.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='14'>Definitions for the Three Cohort Tables:</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#555555' fontsize='10'>Date: </run>
                <run fontcolor='#555555' fontsize='10'>The start date of each cohort week.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#555555' fontsize='10'>Rests: </run>
                <run fontcolor='#555555' fontsize='10'>The number of restaurants in the cohort.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#555555' fontsize='10'>Orders: </run>
                <run fontcolor='#555555' fontsize='10'>Total orders placed by all the restaurants in the cohort over time.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='14'>Definitions for the Detailed Restaurants Table:</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#555555' fontsize='10'>Activated Restaurant:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>Restaurant who placed an order on at least 2 seperate days, irrespective of the number of orders placed. The activation week occurs on the week that the 2nd order-day falls in.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#555555' fontsize='10'>Last Order Date:</run>
                <run>Æ&#10;</run>
                <run fontsize='10'>Last date that the restaurant placed an order.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#555555' fontsize='10'>Restaurant Cohort Week No:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>The number of weeks after activation, starting with the activation week at number 1.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#555555' fontsize='10'>No. Order Weeks:</run>
                <run>Æ&#10;</run>
                <run fontsize='10'>Number of weeks in which the restaurant ordered after activation, including the activation week.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#555555' fontsize='10'>% Weeks Ordered:</run>
                <run>Æ&#10;</run>
                <run fontcolor='#555555' fontsize='10'>Number of weeks ordered after activation date as a % of total weeks from activation date.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#555555' fontsize='10'>No. Orders from Activation Date:</run>
                <run fontcolor='#555555' fontsize='10'>Æ </run>
                <run>Æ&#10;</run>
                <run fontsize='10'>Total orders placed from activation date, including the activation order.</run>
                <run>Æ&#10;&#10;&#10;</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
