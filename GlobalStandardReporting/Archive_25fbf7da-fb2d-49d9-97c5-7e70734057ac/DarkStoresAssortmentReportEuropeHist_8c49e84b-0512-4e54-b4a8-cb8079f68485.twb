          <datasource-dependencies datasource='Parameters'>
            <column alias='EUR' caption='Currency' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
              <aliases>
                <alias key='&quot;EUR&quot;' value='EUR' />
                <alias key='&quot;LC&quot;' value='Local Currency' />
              </aliases>
            </column>
