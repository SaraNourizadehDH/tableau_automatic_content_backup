                <zone h='3125' id='295' type-v2='dashboard-object' w='32101' x='35428' y='28927'>
                  <button action='tabdoc:goto-sheet window-id=&quot;{D7AE5B3F-F4C1-4C42-8A24-5AB8ED2A8FE9}&quot;' button-type='text'>
                    <button-visual-state>
                      <caption>PM Marketing Mix</caption>
                      <button-caption-font-style bold='true' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='12' />
                      <format attr='background-color' value='#4e79a7' />
                    </button-visual-state>
                  </button>
