                <zone h='3125' id='296' type-v2='dashboard-object' w='32101' x='35428' y='32052'>
                  <button action='tabdoc:goto-sheet window-id=&quot;{5831D96C-E2B9-466E-924E-812B31A32790}&quot;' button-type='text'>
                    <button-visual-state>
                      <caption>Topline Share</caption>
                      <button-caption-font-style bold='true' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='12' />
                      <format attr='background-color' value='#4e79a7' />
                    </button-visual-state>
                  </button>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
