      <column caption='User Entitlement' datatype='boolean' name='[Calculation_145311516515344384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME()=[username]' />
      </column>
      <column caption='Channel   ' datatype='string' name='[Calculation_152418765089320963]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[channel]' />
      </column>
      <column caption='PM NB Target' datatype='real' name='[Calculation_1713619725013622784 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([pm_acquisitions_calibration_ios14fix],0.0))/&#13;&#10;SUM(IFNULL([others_acquisitions_target],0.0))' />
      </column>
      <column caption='PM NB Budget' datatype='real' name='[Calculation_1713619725013622784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([pm_acquisitions_calibration_ios14fix],0.0))/&#13;&#10;SUM(IFNULL([pm_acquisitions_target],0.0))' />
      </column>
      <column caption='PM NB Budget %' datatype='real' name='[Calculation_1713619725021065217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([pm_costs_eur],0.0))/&#13;&#10;SUM(IFNULL([pm_costs_eur_target],0.0))' />
      </column>
      <column caption='PM NB Target CPA' datatype='real' name='[Calculation_1713619725021659138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([pm_costs_eur_target],0.0))/&#13;&#10;SUM(IFNULL([pm_acquisitions_target],0.0))' />
      </column>
      <column caption='PM NB CPA Share %' datatype='real' name='[Calculation_1713619725022007299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1713619725021659138]/[Calculation_846113844321828898]-1' />
      </column>
      <column caption='Costs' datatype='real' name='[Calculation_1779695940233924609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;EUR&apos; THEN [costs_eur]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;USD&apos; THEN [costs_usd]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;LC&apos; THEN [costs_lc]&#10;END' />
      </column>
      <column caption='Total Acquisitions' datatype='real' name='[Calculation_2277414100173107203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([pm_acquisitions_calibration_ios14fix],0))+&#13;&#10;SUM(IFNULL([sem_brand_acquisitions_calibration_ios14fix],0))+&#13;&#10;SUM(IFNULL([others_acquisitions_calibration_ios14fix],0))' />
      </column>
      <column caption='Total Cost' datatype='real' name='[Calculation_2277414100175843332]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([pm_costs_eur],0))+&#13;&#10;SUM(IFNULL([sem_brand_costs_eur],0))+&#13;&#10;SUM(IFNULL([others_costs_eur],0))' />
      </column>
      <column caption='aCVR' datatype='real' default-format='p0.00%' name='[Calculation_231090960986861575]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([Acquisition Attr.]) / SUM([Sessions])&#10;SUM([Calculation_5742089557526224896]) / SUM([new_sessions])' />
      </column>
      <column caption='Channel - Sub Channel' datatype='string' name='[Calculation_239535208154656768]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[channel] + &quot; - &quot; + [sub_channel]' />
      </column>
      <column caption='CPA' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_239535208184770565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1779695940233924609]) / SUM([Calculation_5742089557526224896])' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_4301148783956627456]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date] &lt;= TODAY()' />
      </column>
      <column caption='Acquisitions Attr.' datatype='real' name='[Calculation_5742089557526224896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6] &#13;&#10;WHEN &apos;40-20-40&apos; THEN [acquisitions]&#13;&#10;WHEN &apos;Calibrated&apos; THEN [acquisitions_calibration]&#13;&#10;WHEN &apos;40-20-40 with iOS 14.5 Fix&apos; THEN [acquisitions_ios14fix]&#13;&#10;WHEN &apos;Calibrated with iOS 14.5 Fix&apos; THEN [acquisitions_calibration_ios14fix]&#13;&#10;END' />
      </column>
      <column caption='Noted' datatype='string' name='[Calculation_639511184137678854]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Note&quot;' />
        <aliases>
          <alias key='&quot;Note&quot;' value='Attribution Model INFO    &gt;&gt;' />
        </aliases>
      </column>
      <column caption='Date ' datatype='datetime' default-format='*YY-MM-DD' name='[Calculation_671317880946876416]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 1 1],[date],&apos;monday&apos;)' />
      </column>
      <column caption='Total Installs' datatype='real' name='[Calculation_846113844320546847]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([pm_installs],0.0)+IFNULL([sem_brand_installs],0.0)+IFNULL([others_installs],0.0))' />
