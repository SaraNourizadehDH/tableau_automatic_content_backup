      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.03jjdki1bcc3wz12tevqo1810e3b].[usr:Calculation_846113844213325824:qk]&quot;' value='PM Acq' />
          <alias key='&quot;[federated.03jjdki1bcc3wz12tevqo1810e3b].[usr:Calculation_846113844252676111:qk]&quot;' value='PM CPA' />
          <alias key='&quot;[federated.03jjdki1bcc3wz12tevqo1810e3b].[usr:Calculation_846113844253519890:qk]&quot;' value='MOM PM CPA %' />
          <alias key='&quot;[federated.03jjdki1bcc3wz12tevqo1810e3b].[usr:Calculation_846113844255363091:qk]&quot;' value='MOM PM Acq &amp;' />
          <alias key='&quot;[federated.03jjdki1bcc3wz12tevqo1810e3b].[usr:PM Acq Share \%(M2) (copy)_846113844214661121:qk]&quot;' value='PM Acq %' />
        </aliases>
      </column>
      <column caption='Acq Cal YoY %' datatype='real' name='[Acq Cal WoW % (copy)_810366474620272654]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_810366474616291336] / [Acquisitions Cal Week Prior (copy)_810366474620117005]) - 1' />
      </column>
      <column caption='Acquisitions Cal Week Prior Year' datatype='real' name='[Acquisitions Cal Week Prior (copy)_810366474620117005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_810366474603941891] = &apos;Full Prior Year&apos; THEN [acquisitions_calibration 1] END)' />
      </column>
      <column caption='Acquisitions Cal With Vouchers Share Week Current' datatype='real' name='[Acquisitions With Vouchers Cal Week Current (copy)_810366474628034586]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_810366474623488020]/[Calculation_810366474616291336]' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_145311516515344384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME()=[username]' />
      </column>
      <column caption='Cost Week Current' datatype='real' name='[Calculation_1575133986791641088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_810366474603941891] = &apos;Full Current&apos; THEN [costs_eur 1] END)' />
      </column>
      <column caption='Cost WoW %' datatype='real' name='[Calculation_1575133986792124418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1575133986791641088]/[Cost Week Current (copy)_1575133986792005633]-1' />
      </column>
      <column caption='CPA Week Current' datatype='real' name='[Calculation_1575133986792218627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1575133986791641088]/[Calculation_810366474616291336]' />
      </column>
      <column caption='CPA Week Prior' datatype='real' name='[Calculation_1575133986792316932]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Cost Week Current (copy)_1575133986792005633]/[Calculation_810366474616467465]' />
      </column>
      <column caption='CPA WoW %' datatype='real' name='[Calculation_1575133986792394757]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1575133986792218627]/[Calculation_1575133986792316932]-1' />
      </column>
      <column caption='CPA WoW Color' datatype='string' name='[Calculation_1575133986794381318]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1575133986792394757] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
      </column>
      <column caption='Costs' datatype='real' name='[Calculation_1779695940233924609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;EUR&apos; THEN [costs_eur]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;USD&apos; THEN [costs_usd]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;LC&apos; THEN [costs_lc]&#10;END' />
      </column>
      <column caption='Partial Week Filter' datatype='boolean' name='[Calculation_1878001062059692048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date] &lt; DATETRUNC(&apos;week&apos;, TODAY())' />
      </column>
      <column caption='Installs Week Current' datatype='integer' name='[Calculation_1878001062070140945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [platform_type] = &apos;App&apos; AND [Calculation_810366474603941891] = &apos;Full Current&apos; THEN [new_sessions 1] END)' />
      </column>
      <column caption='New Sessions Week Current' datatype='integer' name='[Calculation_1878001062074396692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_810366474603941891] = &apos;Full Current&apos; THEN [new_sessions 1] END)' />
      </column>
      <column caption='Total Acquistions' datatype='real' name='[Calculation_2277414100200624135]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([pm_acquisitions_calibration_ios14fix],0))+&#13;&#10;SUM(IFNULL([sem_brand_acquisitions_calibration_ios14fix],0))+&#13;&#10;SUM(IFNULL([others_acquisitions_calibration_ios14fix],0))' />
      </column>
      <column caption='Total Costs (M1)' datatype='real' name='[Calculation_2277414100200968200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[PM Cost (M2) (copy)_846113844253290512]+[SEM Brand Acq (M1) (copy)_846113844262354970]+[Calculation_846113844260171799]' />
      </column>
      <column caption='Total CPA' datatype='real' name='[Calculation_2277414100201320457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2277414100200624135]/[Calculation_2277414100200968200]' />
      </column>
      <column caption='Avg 30d Revenue/CPA' datatype='real' name='[Calculation_2277414100201619466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_846113844261507097]/[Calculation_846113844263280670],0.0)' />
      </column>
      <column caption='aCVR' datatype='real' name='[Calculation_231090960986861575]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([Acquisition Attr.]) / SUM([Sessions])&#10;SUM([Calculation_5742089557526224896]) / SUM([new_sessions])' />
      </column>
      <column caption='CPA' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_239535208184770565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1779695940233924609]) / SUM([Calculation_5742089557526224896])' />
      </column>
      <column caption='Acquisitions Cal Voucher Share (%)' datatype='real' name='[Calculation_3564247273914470430]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([acquisitions_with_vouchers_calibration]) / SUM(IFNULL([acquisitions_calibration 1], 0))' />
      </column>
      <column caption='Attr' datatype='integer' name='[Calculation_3929461081944641542]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_4301148783956627456]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date] &lt;= TODAY()' />
      </column>
      <column caption='aCVR Week Current' datatype='real' name='[Calculation_5361535401856262151]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn([Calculation_810366474616291336]) / zn([Calculation_1878001062074396692])' />
      </column>
      <column caption='Total' datatype='string' name='[Calculation_5528942643787603968]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Total&quot;' />
      </column>
      <column caption='Acquisitions Attr.' datatype='real' name='[Calculation_5742089557526224896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6] &#13;&#10;WHEN &apos;40-20-40&apos; THEN [acquisitions]&#13;&#10;WHEN &apos;Calibrated&apos; THEN [acquisitions_calibration]&#13;&#10;WHEN &apos;40-20-40 with iOS 14.5 Fix&apos; THEN [acquisitions_ios14fix]&#13;&#10;WHEN &apos;Calibrated with iOS 14.5 Fix&apos; THEN [acquisitions_calibration_ios14fix]&#13;&#10;END' />
      </column>
      <column caption='Noted' datatype='string' name='[Calculation_639511184137678854]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Note&quot;' />
        <aliases>
          <alias key='&quot;Note&quot;' value='Attribution Model INFO    &gt;&gt;' />
        </aliases>
      </column>
      <column caption='Date ' datatype='datetime' default-format='*YY-MM-DD' name='[Calculation_671317880946876416]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 1 1],[date],&apos;monday&apos;)' />
      </column>
      <column caption='Week Type' datatype='string' name='[Calculation_810366474603941891]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [date] &lt; DATETRUNC(&apos;week&apos;, TODAY())&#13;&#10;    WHEN [date] &gt;= DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())) THEN &apos;Full Current&apos;&#13;&#10;    WHEN [date] &gt;= DATEADD(&apos;week&apos;, -2, DATETRUNC(&apos;week&apos;, TODAY())) THEN &apos;Full Prior&apos;&#13;&#10;    WHEN [date] &gt;= DATEADD(&apos;week&apos;, -53, DATETRUNC(&apos;week&apos;, TODAY())) AND [date] &lt; DATEADD(&apos;week&apos;, -52, DATETRUNC(&apos;week&apos;, TODAY())) THEN &apos;Full Prior Year&apos;&#13;&#10;END' />
      </column>
      <column caption='Acquisitions Cal Week Current' datatype='real' name='[Calculation_810366474616291336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_810366474603941891] = &apos;Full Current&apos; THEN [acquisitions_calibration 1] END)' />
      </column>
      <column caption='Acquisitions Cal Week Prior' datatype='real' name='[Calculation_810366474616467465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_810366474603941891] = &apos;Full Prior&apos; THEN [acquisitions_calibration 1] END)' />
      </column>
      <column caption='Acq Cal WoW %' datatype='real' name='[Calculation_810366474616643594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_810366474616291336] / [Calculation_810366474616467465]) - 1' />
      </column>
      <column caption='Acquisitions With Vouchers Cal Week Current' datatype='real' name='[Calculation_810366474623488020]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_810366474603941891] = &apos;Full Current&apos; THEN [acquisitions_with_vouchers_calibration] END)' />
      </column>
      <column caption='PM Acq (M2)' datatype='real' name='[Calculation_846113844213325824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [month_diffrentiator] = &apos;M2&apos; THEN [pm_acquisitions_calibration_ios14fix] END)' />
      </column>
      <column caption='PM Acq sum' datatype='real' name='[Calculation_846113844215156738]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pm_acquisitions_calibration_ios14fix])' />
      </column>
      <column caption='PM Share MOM %' datatype='real' name='[Calculation_846113844216692739]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_846113844213325824]/[PM Acq Share %(M2) (copy)_846113844214661121])-1' />
      </column>
      <column caption='Total Acq (M2)' datatype='real' name='[Calculation_846113844226162693]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_846113844213325824]+[Calculation_846113844260032534]+[Other Acq (M1) (copy)_846113844260315160]' />
      </column>
      <column caption='MOM PM Acq %' datatype='real' name='[Calculation_846113844229558281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([Calculation_846113844213325824]/[Total Costs (M1) (copy)_846113844263018525])-([PM Acq (M2) (copy)_846113844226015236]/[Total Acq (M2) (copy)_846113844226367494]))*100' />
      </column>
