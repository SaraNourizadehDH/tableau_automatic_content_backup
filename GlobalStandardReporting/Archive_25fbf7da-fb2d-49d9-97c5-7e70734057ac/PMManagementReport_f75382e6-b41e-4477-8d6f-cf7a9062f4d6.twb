      <column caption='PM CPA' datatype='real' name='[Calculation_846113844321828898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pm_costs_eur])/SUM([pm_acquisitions_calibration_ios14fix])' />
