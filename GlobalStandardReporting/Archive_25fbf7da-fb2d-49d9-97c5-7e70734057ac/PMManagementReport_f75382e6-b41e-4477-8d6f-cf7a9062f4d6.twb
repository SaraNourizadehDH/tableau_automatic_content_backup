      <column caption='Attribution Model' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Calibrated with iOS 14.5 Fix&quot;'>
        <calculation class='tableau' formula='&quot;Calibrated with iOS 14.5 Fix&quot;' />
        <desc>
          <formatted-text>
            <run>Choose from two different methods of distributing </run>
            <run bold='true'>Acquisitions (not Orders)</run>
            <run> to channels. 40-20-40 uses only digital touchpoints in the click-chain, whereas Exit Polls take into account offline channels like TV/OOH etc. from the Exit Poll data.</run>
          </formatted-text>
        </desc>
        <members>
          <member value='&quot;40-20-40&quot;' />
          <member value='&quot;Calibrated&quot;' />
          <member value='&quot;40-20-40 with iOS 14.5 Fix&quot;' />
          <member value='&quot;Calibrated with iOS 14.5 Fix&quot;' />
