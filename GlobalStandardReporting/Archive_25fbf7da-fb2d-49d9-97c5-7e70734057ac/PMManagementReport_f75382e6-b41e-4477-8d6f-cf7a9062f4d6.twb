          <datasource-dependencies datasource='federated.1bi0wca0g9mz7417bcmkc0w7a3fq'>
            <column caption='PM NB Target' datatype='real' name='[Calculation_1713619725013622784 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([pm_acquisitions_calibration_ios14fix],0.0))/&#13;&#10;SUM(IFNULL([others_acquisitions_target],0.0))' />
            </column>
            <column caption='Total Acquisitions' datatype='real' name='[Calculation_2277414100173107203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([pm_acquisitions_calibration_ios14fix],0))+&#13;&#10;SUM(IFNULL([sem_brand_acquisitions_calibration_ios14fix],0))+&#13;&#10;SUM(IFNULL([others_acquisitions_calibration_ios14fix],0))' />
            </column>
            <column caption='Total Cost' datatype='real' name='[Calculation_2277414100175843332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IFNULL([pm_costs_eur],0))+&#13;&#10;SUM(IFNULL([sem_brand_costs_eur],0))+&#13;&#10;SUM(IFNULL([others_costs_eur],0))' />
            </column>
            <column caption='Date ' datatype='datetime' default-format='*YY-MM-DD' name='[Calculation_671317880946876416]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 1 1],[date],&apos;monday&apos;)' />
            </column>
            <column caption='Total CPA' datatype='real' name='[Calculation_846113844321685537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2277414100175843332]/[Calculation_2277414100173107203]' />
            </column>
            <column caption='PM CPA' datatype='real' name='[Calculation_846113844321828898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pm_costs_eur])/SUM([pm_acquisitions_calibration_ios14fix])' />
            </column>
            <column caption='PM Non-Brand Acq' datatype='real' name='[Calculation_846113844321992739]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([pm_acquisitions_calibration_ios14fix])/[Calculation_2277414100173107203]' />
            </column>
            <column caption='PM Non-Brand CPA' datatype='real' name='[Calculation_846113844322824229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_846113844321828898]/[Calculation_846113844321685537]-1' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[Date(MM/YYYY)]' role='dimension' type='ordinal' user:agg-type='MY' user:base-field='Calculation_671317880946876416' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='(DATEPART(&apos;year&apos;, [Calculation_671317880946876416])*100 + DATEPART(&apos;month&apos;, [Calculation_671317880946876416]))' />
