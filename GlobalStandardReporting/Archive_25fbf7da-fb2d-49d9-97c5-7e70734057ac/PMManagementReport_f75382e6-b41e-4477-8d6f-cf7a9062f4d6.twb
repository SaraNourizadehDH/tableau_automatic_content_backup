      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1bi0wca0g9mz7417bcmkc0w7a3fq (copy)].[sum:sem_brand_acquisitions_calibration_ios14fix:qk]&quot;' value='SEM Brand Acquisitions' />
