          <alias key='&quot;[federated.1bi0wca0g9mz7417bcmkc0w7a3fq (copy)].[usr:Calculation_846113844321992739:qk]&quot;' value='Acquisition' />
          <alias key='&quot;[federated.1bi0wca0g9mz7417bcmkc0w7a3fq (copy)].[usr:Calculation_846113844322824229:qk]&quot;' value='CPA' />
        </aliases>
