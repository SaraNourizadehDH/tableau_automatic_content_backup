  <worksheets>
    <worksheet name='3d Revenue/CPA (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000'>Avg 30D Revenue/CPA</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_pm_management_metrics_overview_kpi+ (rl_mkt)' name='federated.03jjdki1bcc3wz12tevqo1810e3b' />
          </datasources>
          <datasource-dependencies datasource='federated.03jjdki1bcc3wz12tevqo1810e3b'>
            <column caption='Avg 30d Revenue/CPA' datatype='real' name='[Calculation_2277414100201619466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Calculation_846113844261507097]/[Calculation_846113844263280670],0.0)' />
            </column>
            <column caption='PM Acq (M2)' datatype='real' name='[Calculation_846113844213325824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_diffrentiator] = &apos;M2&apos; THEN [pm_acquisitions_calibration_ios14fix] END)' />
            </column>
            <column caption='PM Acq sum' datatype='real' name='[Calculation_846113844215156738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pm_acquisitions_calibration_ios14fix])' />
            </column>
            <column caption='Total Acq (M2)' datatype='real' name='[Calculation_846113844226162693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_846113844213325824]+[Calculation_846113844260032534]+[Other Acq (M1) (copy)_846113844260315160]' />
            </column>
            <column caption='MOM PM Acq %' datatype='real' name='[Calculation_846113844229558281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(([Calculation_846113844213325824]/[Total Costs (M1) (copy)_846113844263018525])-([PM Acq (M2) (copy)_846113844226015236]/[Total Acq (M2) (copy)_846113844226367494]))*100' />
            </column>
            <column caption='PM Acq vs Target' datatype='real' name='[Calculation_846113844246163467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_846113844213325824]/[Calculation_846113844247470092 1]' />
            </column>
            <column caption='PM Target(M2)' datatype='real' name='[Calculation_846113844247470092 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_diffrentiator] = &apos;M2&apos; THEN [pm_acquisitions_target] END)' />
            </column>
            <column caption='PM Cost (M2)' datatype='real' name='[Calculation_846113844252499982]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_diffrentiator] = &apos;M2&apos; THEN [pm_costs_eur] END)' />
            </column>
            <column caption='PM CPA (M2)' datatype='real' name='[Calculation_846113844252676111]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_846113844252499982]/[Calculation_846113844213325824]' />
            </column>
            <column caption='MOM CPA %' datatype='real' name='[Calculation_846113844253519890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_846113844252676111]/[PM CPA (M2) (copy)_846113844253388817])-1' />
            </column>
            <column caption='MOM Acq Comparision' datatype='real' name='[Calculation_846113844255363091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_846113844226162693]/[Total Acq (M2) (copy)_846113844226367494])' />
            </column>
            <column caption='SEM Brand Acq (M1)' datatype='real' name='[Calculation_846113844259835924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_diffrentiator] = &apos;M1&apos; THEN [sem_brand_acquisitions_calibration_ios14fix] END)' />
            </column>
            <column caption='SEM Brand Acq (M2)' datatype='real' name='[Calculation_846113844260032534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_diffrentiator] = &apos;M2&apos; THEN [sem_brand_acquisitions_calibration_ios14fix] END)' />
            </column>
            <column caption='Other Cost (M1)' datatype='real' name='[Calculation_846113844260171799]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [month_diffrentiator] = &apos;M1&apos; THEN [others_costs_eur] END)' />
            </column>
            <column caption='AVG 30d Revenue' datatype='real' name='[Calculation_846113844261507097]' role='measure' type='quantitative'>
