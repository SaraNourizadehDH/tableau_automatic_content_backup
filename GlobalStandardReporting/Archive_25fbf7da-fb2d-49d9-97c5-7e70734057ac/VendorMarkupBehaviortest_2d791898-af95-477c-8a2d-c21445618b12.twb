            <column caption='Vendor_based_Bad_behavior_2_bins(increase)' datatype='string' name='[Vendor_based_Bad_behavior_1_bins (copy)_546483722392223746]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [vendor_id],[global_entity_id] :&#10;IF [N Campaigns Camp Window Increase (copy)_1510816986030755842]&gt;0 AND [N Campaigns Camp Window Increase (copy)_1510816986030755842]&lt;=0.20&#10;THEN &quot;0-20%&quot;&#10;ELSEIF [N Campaigns Camp Window Increase (copy)_1510816986030755842]&gt;0.2 AND [N Campaigns Camp Window Increase (copy)_1510816986030755842]&lt;=0.40&#10;THEN &quot;20-40%&quot;&#10;ELSEIF [N Campaigns Camp Window Increase (copy)_1510816986030755842]&gt;0.4 AND [N Campaigns Camp Window Increase (copy)_1510816986030755842]&lt;=0.60&#10;THEN &quot;40-60%&quot;&#10;ELSEIF [N Campaigns Camp Window Increase (copy)_1510816986030755842]&gt;0.6 AND [N Campaigns Camp Window Increase (copy)_1510816986030755842]&lt;=0.80&#10;THEN &quot;60-80%&quot;&#10;ELSEIF [N Campaigns Camp Window Increase (copy)_1510816986030755842]&gt;0.8 AND [N Campaigns Camp Window Increase (copy)_1510816986030755842]&lt;=1&#10;THEN &quot;80-100%&quot;&#10;ELSE &apos;0&apos;&#10;END }' />
