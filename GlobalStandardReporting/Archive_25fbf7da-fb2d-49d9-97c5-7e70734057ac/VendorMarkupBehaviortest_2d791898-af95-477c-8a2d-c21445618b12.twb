              <calculation class='tableau' formula='COUNTD([vendor_id])' />
            </column>
            <column caption='Bad behavior 1 %' datatype='string' name='[Calculation_991847501805797383]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [vendor_id],[global_entity_id] :&#10;IF [% Campaign Products Camp Window Increase (copy)_1510816986031190019]&gt;0 AND [% Campaign Products Camp Window Increase (copy)_1510816986031190019]&lt;=0.20&#10;THEN &quot;0-20%&quot;&#10;ELSEIF [% Campaign Products Camp Window Increase (copy)_1510816986031190019]&gt;0.2 AND [% Campaign Products Camp Window Increase (copy)_1510816986031190019]&lt;=0.40&#10;THEN &quot;20-40%&quot;&#10;ELSEIF [% Campaign Products Camp Window Increase (copy)_1510816986031190019]&gt;0.4 AND [% Campaign Products Camp Window Increase (copy)_1510816986031190019]&lt;=0.60&#10;THEN &quot;40-60%&quot;&#10;ELSEIF [% Campaign Products Camp Window Increase (copy)_1510816986031190019]&gt;0.6 AND [% Campaign Products Camp Window Increase (copy)_1510816986031190019]&lt;=0.80&#10;THEN &quot;60-80%&quot;&#10;ELSEIF [% Campaign Products Camp Window Increase (copy)_1510816986031190019]&gt;0.8 AND [% Campaign Products Camp Window Increase (copy)_1510816986031190019]&lt;=1&#10;THEN &quot;80-100%&quot;&#10;ELSE &apos;0&apos;&#10;END }' />
            </column>
            <column caption='Discount % amount bins' datatype='string' name='[Discount_Percentage_groups]' role='dimension' type='nominal' />
            <column caption='% Campaign Products Camp Window Increase' datatype='real' default-format='p0.0%' name='[N Campaigns Camp Window Increase (copy)_1510816986030755842]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([n_campaign_products_camp_window_increase])&#10;/&#10;SUM([n_campaign_product_pairs])' />
