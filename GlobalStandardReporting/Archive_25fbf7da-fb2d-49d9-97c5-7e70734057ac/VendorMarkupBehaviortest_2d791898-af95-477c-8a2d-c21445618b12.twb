          <datasource-dependencies datasource='federated.0l7vxjt1yx3rai1gyhpit1xcg88d'>
            <column caption='% Campaign Products Camp Window Increase Post Camp Decrease' datatype='real' default-format='p0.0%' name='[% Campaign Products Camp Window Increase (copy)_1510816986031190019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([n_campaign_products_camp_window_increase_post_camp_decrease])&#10;/&#10;SUM([n_campaign_product_pairs])' />
            </column>
            <column caption='% Campaigns Post Camp Decrease' datatype='real' default-format='p0.0%' name='[% Campaigns Camp Window Increase (copy)_1510816986057080838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([n_campaigns_post_camp_decrease])&#10;/&#10;SUM([n_campaigns])' />
            </column>
            <column caption='n_vendors' datatype='integer' name='[Calculation_2809190685069369344]' role='measure' type='quantitative'>
