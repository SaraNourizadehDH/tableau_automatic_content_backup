        <view>
          <datasources>
            <datasource caption='new_design' name='federated.1el2k0s05w1axn13gwpuw0vcsz6o' />
          </datasources>
          <datasource-dependencies datasource='federated.1el2k0s05w1axn13gwpuw0vcsz6o'>
            <column caption='agg_disc_stolen (product weighted)' datatype='real' default-format='p0.0%' name='[Calculation_2505197669865832449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-(SUM([avg_disc_stolen]*[n_of_camp_product_key])&#10;/&#10;SUM([n_of_camp_product_key]))' />
            </column>
            <column caption='agg_net_discount (product_weighted)' datatype='real' default-format='p0.0%' name='[Calculation_2505197669866033154]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avg_net_discount]*[n_of_camp_product_key])&#10;/&#10;SUM([n_of_camp_product_key])' />
            </column>
            <column caption='agg_disc_offered (product weighted)' datatype='real' default-format='p0.0%' name='[Calculation_2505197669893271557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-SUM([avg_disc_offered]*[n_of_camp_product_key])/SUM([n_of_camp_product_key])' />
            </column>
            <column caption='disc_stolen (product weighted)' datatype='real' default-format='p0.0%' name='[Calculation_2505197670121680902]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avg_disc_stolen]*[n_of_camp_product_key])&#10;/&#10;SUM([n_of_camp_product_key])' />
            </column>
            <column caption='avg_net_discount_2' datatype='real' datatype-customized='true' name='[Calculation_3571706354403180544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3571706354826756101]/[avg_pre_camp_avg_price]-1' />
            </column>
            <column caption='avg stolen discount share %' datatype='real' name='[Calculation_3571706354409332737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[avg_disc_stolen (copy)_3571706354829107207]/[avg_disc_offered]' />
            </column>
            <column caption='avg_camp_discounted_price' datatype='real' name='[Calculation_3571706354826756101]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[avg_camp_window_avg_price]*(1-[avg_disc_offered])' />
            </column>
            <column caption='is_campaign_bad_beh_2' datatype='boolean' name='[Calculation_3571706354836537355]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [campaign_pkey] : IF [Calculation_2505197670121680902]&gt;0.1   THEN TRUE ELSE FALSE END}' />
            </column>
            <column caption='n_of_camp_pkeys' datatype='integer' name='[Calculation_3571706355105058832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([campaign_pkey])' />
