                <zone fixed-size='280' h='20254' id='19' is-fixed='true' name='Summary: Behaviors (Product vs Full Menu Campaigns)' w='42538' x='43384' y='52373'>
                  <layout-cache cell-count-w='2' minheight='203' non-cell-size-w='63' type-h='scalable' type-w='cell' />
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
