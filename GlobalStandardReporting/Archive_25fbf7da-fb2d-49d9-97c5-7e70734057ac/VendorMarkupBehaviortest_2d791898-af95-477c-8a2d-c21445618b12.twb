          <datasource-dependencies datasource='federated.1el2k0s05w1axn13gwpuw0vcsz6o'>
            <column caption='agg_disc_stolen (product weighted)' datatype='real' default-format='p0.0%' name='[Calculation_2505197669865832449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-(SUM([avg_disc_stolen]*[n_of_camp_product_key])&#10;/&#10;SUM([n_of_camp_product_key]))' />
            </column>
            <column caption='agg_disc_offered (product weighted)' datatype='real' default-format='p0.0%' name='[Calculation_2505197669893271557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-SUM([avg_disc_offered]*[n_of_camp_product_key])/SUM([n_of_camp_product_key])' />
            </column>
            <column caption='disc_stolen (product weighted)' datatype='real' default-format='p0.0%' name='[Calculation_2505197670121680902]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([avg_disc_stolen]*[n_of_camp_product_key])&#10;/&#10;SUM([n_of_camp_product_key])' />
            </column>
            <column caption='is_campaign_bad_beh_2' datatype='boolean' name='[Calculation_3571706354836537355]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [campaign_pkey] : IF [Calculation_2505197670121680902]&gt;0.1   THEN TRUE ELSE FALSE END}' />
            </column>
            <column caption='n_vendors' datatype='integer' name='[Calculation_5607614857058033664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_id])' />
