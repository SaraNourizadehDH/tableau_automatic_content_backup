    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Entity Level'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/VendorMarkupBehavior/EntityLevel?rev=' id='EntityLevel' path='/t/GlobalStandardReporting/workbooks/VendorMarkupBehavior' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1500' maxwidth='1300' minheight='1500' minwidth='1300' sizing-mode='fixed' />
      <datasources>
        <datasource caption='all data ' name='federated.0l7vxjt1yx3rai1gyhpit1xcg88d' />
      </datasources>
      <datasource-dependencies datasource='federated.0l7vxjt1yx3rai1gyhpit1xcg88d'>
        <column caption='Vendor behavior segments' datatype='string' name='[Vendor_based_Bad_behavior_1_bins (copy)_546483722400325642]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='{FIXED [vendor_id],[global_entity_id] :&#10;IF [% Campaign Products Camp Window Increase (copy)_1510816986031190019]&gt;0  THEN &quot;Behavior 1&quot;&#10;ELSEIF [N Campaigns Camp Window Increase (copy)_1510816986030755842]&gt;0 THEN &quot;Behavior 2&quot; &#10;ELSEIF [% Campaigns Camp Window Increase (copy)_1510816986057080838]&gt;0 THEN &quot;Behavior 3&quot;&#10;ELSE &quot;Not Bad Behavior&quot;&#10;END }' />
        </column>
        <column datatype='date' name='[campaign_start_month]' role='dimension' type='ordinal' />
        <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
        <column-instance column='[Vendor_based_Bad_behavior_1_bins (copy)_546483722400325642]' derivation='None' name='[none:Vendor_based_Bad_behavior_1_bins (copy)_546483722400325642:nk]' pivot='key' type='nominal' />
        <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
        <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
        <column-instance column='[product_or_vendor_camp]' derivation='None' name='[none:product_or_vendor_camp:nk]' pivot='key' type='nominal' />
        <column-instance column='[region_segment]' derivation='None' name='[none:region_segment:nk]' pivot='key' type='nominal' />
        <column datatype='string' name='[product_or_vendor_camp]' role='dimension' type='nominal'>
          <aliases>
            <alias key='%null%' value='No Campaign-Price Change' />
            <alias key='&quot;product_spesific_camp&quot;' value='Product Specific Campaigns' />
            <alias key='&quot;vendor_camp&quot;' value='Full Menu Campaigns' />
          </aliases>
        </column>
        <column datatype='string' name='[region_segment]' role='dimension' type='nominal' />
        <column-instance column='[campaign_start_month]' derivation='Month-Trunc' name='[tmn:campaign_start_month:ok]' pivot='key' type='ordinal' />
        <column-instance column='[campaign_start_month]' derivation='Month-Trunc' name='[tmn:campaign_start_month:qk]' pivot='key' type='quantitative' />
      </datasource-dependencies>
