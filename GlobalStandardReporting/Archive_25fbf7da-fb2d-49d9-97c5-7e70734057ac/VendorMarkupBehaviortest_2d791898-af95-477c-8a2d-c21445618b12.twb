        <calculation class='tableau' formula='{FIXED [vendor_id],[global_entity_id] :&#10;IF [% Campaign Products Camp Window Increase (copy)_1510816986031190019]&gt;0  THEN &apos;Bad Behavior&apos;&#10;ELSE &apos;Not Bad Behavior&apos;&#10;END }' />
