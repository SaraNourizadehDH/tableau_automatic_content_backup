              <calculation class='tableau' formula='{FIXED [vendor_id],[global_entity_id] :&#10;IF [avg_gmv_campvspre_pct (copy)_3845792664708136966]&gt; -0.1 AND [avg_gmv_campvspre_pct (copy)_3845792664708136966]&lt;=0&#10;THEN &quot;less than -10%&quot;&#10;ELSEIF [avg_gmv_campvspre_pct (copy)_3845792664708136966]&gt; -0.1 AND [avg_gmv_campvspre_pct (copy)_3845792664708136966]&lt;=0&#10;THEN &quot;-10-0%&quot;&#10;ELSEIF [avg_gmv_campvspre_pct (copy)_3845792664708136966]&gt;0 AND [avg_gmv_campvspre_pct (copy)_3845792664708136966]&lt;=0.2&#10;THEN &quot;0-20%&quot;&#10;ELSEIF [avg_gmv_campvspre_pct (copy)_3845792664708136966]&gt;0.2 AND [avg_gmv_campvspre_pct (copy)_3845792664708136966]&lt;=0.40&#10;THEN &quot;20-40%&quot;&#10;ELSEIF [avg_gmv_campvspre_pct (copy)_3845792664708136966]&gt;0.4 AND [avg_gmv_campvspre_pct (copy)_3845792664708136966]&lt;=0.60&#10;THEN &quot;40-60%&quot;&#10;ELSEIF [avg_gmv_campvspre_pct (copy)_3845792664708136966]&gt;0.6 AND [avg_gmv_campvspre_pct (copy)_3845792664708136966]&lt;=0.80&#10;THEN &quot;60-80%&quot;&#10;ELSEIF [avg_gmv_campvspre_pct (copy)_3845792664708136966]&gt;0.8 AND [avg_gmv_campvspre_pct (copy)_3845792664708136966]&lt;=1&#10;THEN &quot;80-100%&quot;&#10;ELSEIF [avg_gmv_campvspre_pct (copy)_3845792664708136966]&gt;0.8&#10;THEN &quot;+100%&quot;&#10;ELSE &apos;N/A&apos;&#10;END }' />
            </column>
            <column caption='Vendor behavior segments' datatype='string' name='[Vendor_based_Bad_behavior_1_bins (copy)_546483722400325642]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [vendor_id],[global_entity_id] :&#10;IF [% Campaign Products Camp Window Increase (copy)_1510816986031190019]&gt;0  THEN &quot;Behavior 1&quot;&#10;ELSEIF [N Campaigns Camp Window Increase (copy)_1510816986030755842]&gt;0 THEN &quot;Behavior 2&quot; &#10;ELSEIF [% Campaigns Camp Window Increase (copy)_1510816986057080838]&gt;0 THEN &quot;Behavior 3&quot;&#10;ELSE &quot;Not Bad Behavior&quot;&#10;END }' />
