    <worksheet name='Overview'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Segment Overview</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='Overview' path='/t/GlobalStandardReporting/workbooks/DailyBusinessUpdate-COVID-19-NVDSFoodSplit' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='custom sql query (bi_global_dev)' name='federated.16yayye0hh2esr1551z3b0mloa1j' />
          </datasources>
          <datasource-dependencies datasource='federated.16yayye0hh2esr1551z3b0mloa1j'>
            <column caption='Acq WoW D-2' datatype='real' name='[Acq WoW D-1 (copy)_4339851590311399446]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [report_date] = DATEADD(&quot;day&quot;, -1, [Calculation_4339851590255022093]) THEN [acquisitions] END)&#10;/&#10;SUM(IF [report_date] = DATEADD(&quot;day&quot;, -1, [Calculation_4339851590255022093]) THEN [acquisitions_prev_week] END)-1' />
            </column>
            <column caption='Rest. Online WoW D-1' datatype='real' name='[Acq WoW D-1 (copy)_4339851590313230360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [report_date] = DATEADD(&quot;day&quot;, -0, [Calculation_4339851590255022093]) THEN INT([restaurants_online]) END)&#10;/&#10;SUM(IF [report_date] = DATEADD(&quot;day&quot;, -0, [Calculation_4339851590255022093]) THEN INT([restaurants_online_prev_week]) END)-1' />
            </column>
            <column caption='Acq WoW D-3' datatype='real' name='[Acq WoW D-2 (copy)_4339851590311448599]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [report_date] = DATEADD(&quot;day&quot;, -2, [Calculation_4339851590255022093]) THEN [acquisitions] END)&#10;/&#10;SUM(IF [report_date] = DATEADD(&quot;day&quot;, -2, [Calculation_4339851590255022093]) THEN [acquisitions_prev_week] END)-1' />
            </column>
            <column caption='Orders WoW D-1' datatype='real' name='[Calculation_4339851589961388032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [report_date] = [Calculation_4339851590255022093] THEN [orders_succ] END)&#10;/&#10;SUM(IF [report_date] = [Calculation_4339851590255022093] THEN [orders_succ_prev_week] END)-1' />
            </column>
            <column caption='Last Report Date' datatype='date' default-format='*YYYY-MM-DD' name='[Calculation_4339851590255022093]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX([report_date])}' />
            </column>
            <column caption='Orders D-1' datatype='real' name='[Calculation_4339851590296039439]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [report_date] = [Calculation_4339851590255022093] THEN [orders_succ] ELSE 0 END)' />
            </column>
            <column caption='Fail Rate WoW (abs.) D-2' datatype='real' name='[Fail Rate WoW (abs.) D-1 (copy)_4339851590318190624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(IF [report_date] = DATEADD(&quot;day&quot;, -1, [Calculation_4339851590255022093]) THEN [orders_fail] END)&#10;/&#10;SUM(IF [report_date] = DATEADD(&quot;day&quot;, -1, [Calculation_4339851590255022093]) THEN [orders_total] END)&#10;)&#10;-&#10;(&#10;SUM(IF [report_date] = DATEADD(&quot;day&quot;, -1, [Calculation_4339851590255022093]) THEN [orders_fail_prev_week] END)&#10;/&#10;SUM(IF [report_date] = DATEADD(&quot;day&quot;, -1, [Calculation_4339851590255022093]) THEN [orders_total_prev_week] END)&#10;)' />
            </column>
            <column caption='Fail Rate WoW (abs.) D-3' datatype='real' name='[Fail Rate WoW (abs.) D-2 (copy)_4339851590318264353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(IF [report_date] = DATEADD(&quot;day&quot;, -2, [Calculation_4339851590255022093]) THEN [orders_fail] END)&#10;/&#10;SUM(IF [report_date] = DATEADD(&quot;day&quot;, -2, [Calculation_4339851590255022093]) THEN [orders_total] END)&#10;)&#10;-&#10;(&#10;SUM(IF [report_date] = DATEADD(&quot;day&quot;, -2, [Calculation_4339851590255022093]) THEN [orders_fail_prev_week] END)&#10;/&#10;SUM(IF [report_date] = DATEADD(&quot;day&quot;, -2, [Calculation_4339851590255022093]) THEN [orders_total_prev_week] END)&#10;)' />
            </column>
            <column caption='Acquisitions D-1' datatype='integer' name='[Orders D-1 (copy)_4339851590310948883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [report_date] = [Calculation_4339851590255022093] THEN [acquisitions] ELSE 0 END)' />
