      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='CustomSQL_D5C1857B6B6342BB9FD8B3540478A801'>
            <properties context=''>
              <relation connection='redshift.0sr9who1dc8y3b1f4h9kt1gbz3gt' name='Custom SQL Query' type='text'><![CDATA[with op as 
(SELECT accountid,id op_id, closedate, business_type__c from dwh_salesforce.opportunity
  where stagename = 'Closed Won' --in ('Editorial Queue','Promo and Logistics Queue','Onboarding','Closed Won', 'Delivery Pending')
  and business_type__c in('New Business')
  and closedate>>='2020-01-01'),

oh as(
 select distinct opportunityid from dwh_salesforce.opportunity_history
 where  opportunityid in(select op_id from op) 
 and field='StageName' 
 and createddate>>='2020-01-01'
 and newvalue in ('Quality Check Request', 'Quality Check')
 and createdbyid in('0056900000AVz3YAAT','0051r00000AVr4JAAT','0051r00000AVr4OAAT','0056900000BUli5AAD')
 and opportunityid not in(select opportunityid from dwh_salesforce.opportunity_history
                          where opportunityid in(select op_id from op) 
                          and field='StageName' 
                          and newvalue='Please Check'
                          and createddate>>='2020-01-01')
 ), 

o as (
select op.*, oh.opportunityid virtual_signings
from op 
left join oh 
on op.op_id=oh.opportunityid ),  

ac as 
(SELECT id, 
grid__c, 
createddate,
createdbyid account_created_byid
from dwh_salesforce.account 
  where createddate>>='2020-01-01'),

d as 
(select iso_date,
dc.name,
management_entity_group management_entity,
common_name,
name country_name,
country_iso,
display_name,
region,
ssu_released
from dwh_il.dim_date 
join ds_salesforce.sf_sf_dwh_country_company_mapping dc
on 1=1

left join ds_global_dev.ssu_release_date ssu_date 
on dc.global_entity_id=ssu_date.global_entity_id
and iso_date>>=ssu_release_date

where iso_date>>='2020-08-01' 
and iso_date<<= current_date 
and dc.is_active 
),

leads as (
SELECT  count( l.id) as total_leads,
        l.record_country__c,
        date(date_trunc('day',l.createddate)) lead_createddate,
        date(date_trunc('day',a.createddate)) account_createddate,
        date(date_trunc('day',o.closedate)) op_closedddate,
        count(case when createdbyid in('0056900000AVz3YAAT','0051r00000AVr4JAAT','0051r00000AVr4OAAT','0056900000BUli5AAD')
            then  l.id end) Virtual_leads,
        count(case when account_created_byid in('0056900000AVz3YAAT','0051r00000AVr4JAAT','0051r00000AVr4OAAT','0056900000BUli5AAD')
            then a.grid__c end) Virtual_account,
        count(virtual_signings) Virtual_signings,    
        current_date as Last_update
 FROM deliveryhero.dwh_salesforce.lead l
 
 LEFT JOIN ac a 
 ON a.grid__c=l.grid__c

 LEFT JOIN o 
 on a.id=o.accountid

  
    where l.createddate>>='2020-08-01'
    --and l.leadsource='Self Sign Up' 
    and l.createdbyid in('0056900000AVz3YAAT','0051r00000AVr4JAAT','0051r00000AVr4OAAT','0056900000BUli5AAD')
  group by 
  l.record_country__c,
  date_trunc('day',l.createddate),
  date_trunc('day',a.createddate),
  date_trunc('day',o.closedate))

select 
d.iso_date,
current_date as Last_update,
d.country_name,
d.management_entity,
d.common_name,
d.country_iso,
d.display_name,
d.region,
d.ssu_released,
ll.leads leads, 
ll.virtual_leads,
a.accounts accounts,
a.ssu_account,
o.opps opps,
o.ssu_signings
from d 
left join (select
          sum(total_leads) leads,
          sum(virtual_leads) virtual_leads,
          lead_createddate,
          record_country__c 
          from leads
          group by 
          record_country__c,
          lead_createddate) ll
on d.iso_date=ll.lead_createddate
and d.country_name=ll.record_country__c

left join (select
          sum(total_leads) accounts,
          sum(virtual_account) ssu_account,
          account_createddate,
          record_country__c
          from leads
          group by 
          record_country__c,
          account_createddate) a
on d.iso_date=a.account_createddate
and d.country_name=a.record_country__c

left join (select
          sum(total_leads) opps,
          sum(virtual_account) ssu_opps,
          sum(Virtual_signings) ssu_signings,
          op_closedddate,
          record_country__c
          from leads
          group by 
          record_country__c,
          op_closedddate) o
on d.iso_date=o.op_closedddate
and d.country_name=o.record_country__c
where (leads is not null and accounts is not null and opps is not null)]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
