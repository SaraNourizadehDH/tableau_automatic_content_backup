    <datasource caption='Sales_performance' inline='true' name='federated.0hg43xa0t9l3kt11qn71z0za1o6m' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='global-dwh.c0odzyvokw7w.eu-central-1.redshift.amazonaws.com' name='redshift.1309h9n05m0b8p18d25ht1bbv6aj'>
            <connection class='redshift' dbname='deliveryhero' odbc-connect-string-extras='' one-time-sql='' port='5439' schema='ds_global_dev' server='global-dwh.c0odzyvokw7w.eu-central-1.redshift.amazonaws.com' server-oauth='' single-node='no' sslmode='' username='ramiro_almasque' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='redshift.1309h9n05m0b8p18d25ht1bbv6aj' name='Consulta SQL personalizada' type='text'>with op as &#13;
(SELECT accountid,id op_id, stagename, closedate, business_type__c, &#13;
case when stagename in (&apos;Editorial Queue&apos;,&apos;Promo and Logistics Queue&apos;,&apos;Onboarding&apos;,&apos;Closed Won&apos;, &apos;Delivery Pending&apos;) then &apos;Signed&apos; end Signed,&#13;
case when stagename=&apos;Closed Won&apos; then &apos;Closed Won&apos; end Closed_Won&#13;
from dwh_salesforce.opportunity&#13;
  where stagename in (&apos;Editorial Queue&apos;,&apos;Promo and Logistics Queue&apos;,&apos;Onboarding&apos;,&apos;Closed Won&apos;, &apos;Delivery Pending&apos;)&#13;
  and business_type__c in(&apos;New Business&apos;)&#13;
  and lastmodifieddate&gt;&gt;=&apos;2020-01-01&apos;),&#13;
&#13;
oh as(&#13;
 select distinct opportunityid from dwh_salesforce.opportunity_history&#13;
 where  opportunityid in(select op_id from op) &#13;
 and field=&apos;StageName&apos; &#13;
 and createddate&gt;&gt;=&apos;2020-01-01&apos;&#13;
 and newvalue in (&apos;Quality Check Request&apos;, &apos;Quality Check&apos;)&#13;
 and createdbyid in(&apos;0056900000AVz3YAAT&apos;,&apos;0051r00000AVr4JAAT&apos;,&apos;0051r00000AVr4OAAT&apos;,&apos;0056900000BUli5AAD&apos;)&#13;
 and opportunityid not in(select opportunityid from dwh_salesforce.opportunity_history&#13;
                          where opportunityid in(select op_id from op) &#13;
                          and field=&apos;StageName&apos; &#13;
                          and newvalue=&apos;Please Check&apos;&#13;
                          and createddate&gt;&gt;=&apos;2020-01-01&apos;)),&#13;
&#13;
o as (&#13;
select op.*, oh.opportunityid virtual_signings&#13;
from op &#13;
left join oh &#13;
on op.op_id=oh.opportunityid ), &#13;
&#13;
ac as &#13;
(SELECT id, grid__c,createdbyid, createddate from dwh_salesforce.account &#13;
  where createddate&gt;&gt;=&apos;2020-01-01&apos;)&#13;
&#13;
SELECT  count( l.id) as total_leads,&#13;
        --case when l.createdbyid = &apos;0051r000009S40GAAS&apos; then  &apos;GSD_leads&apos; else &apos;Local_leads&apos; end as leads_origin ,&#13;
        case when l.createdbyid in(&apos;0056900000AVz3YAAT&apos;,&apos;0051r00000AVr4JAAT&apos;,&apos;0051r00000AVr4OAAT&apos;,&apos;0056900000BUli5AAD&apos;) then &apos;Virtual Rep.&apos; else &apos;Human Rep.&apos; end Lead_created_by, &#13;
        case when a.createdbyid in(&apos;0056900000AVz3YAAT&apos;,&apos;0051r00000AVr4JAAT&apos;,&apos;0051r00000AVr4OAAT&apos;,&apos;0056900000BUli5AAD&apos;) then &apos;Virtual Rep.&apos; else &apos;Human Rep.&apos; end Account_converted_by,&#13;
        case when o.virtual_signings is not null then &apos;Virtual Rep.&apos; else &apos;Human Rep.&apos; end Signed_by,&#13;
        l.record_country__c,&#13;
        --GET_SF_SOURCE_ID(l.record_country__c, l.platform__c) as source_id,&#13;
        --case when l.leadsource =&apos;IMPORT&apos; then &apos;Import&apos; else l.leadsource end as Lead_source ,&#13;
        dc.management_entity_group,&#13;
        dc.common_name,&#13;
        dc.country_iso,&#13;
        dc.display_name,&#13;
        dc.region,&#13;
        ssu_date.ssu_released,&#13;
        ssu_release_date,&#13;
        l.status,&#13;
        o.Signed,&#13;
        o.Closed_Won,&#13;
        date(date_trunc(&apos;month&apos;,l.createddate)) lead_createddate,&#13;
        --date(date_trunc(&apos;month&apos;,a.createddate)) account_createddate,&#13;
        --date(date_trunc(&apos;month&apos;,o.closedate)) op_closedddate,&#13;
        l.is_converted,&#13;
        l.isdeleted,&#13;
        l.vertical__c,&#13;
        l.vertical_segment__c,&#13;
        l.lost_reason__c,&#13;
        l.lead_data_origin__c,&#13;
        current_date as Last_update&#13;
 FROM deliveryhero.dwh_salesforce.lead l&#13;
 &#13;
 Left join ds_salesforce.sf_sf_dwh_country_company_mapping dc &#13;
 on dc.name=l.record_country__c&#13;
&#13;
 left join  ds_global_dev.ssu_release_date ssu_date&#13;
 on l.record_country__c=ssu_date.country_name&#13;
 and dc.global_entity_id=ssu_date.global_entity_id &#13;
 and l.createddate&gt;&gt;=ssu_date.ssu_release_date&#13;
&#13;
 LEFT JOIN ac a &#13;
 ON a.grid__c=l.grid__c&#13;
&#13;
  LEFT JOIN o &#13;
 on a.id=o.accountid&#13;
 &#13;
  where l.createddate&gt;&gt;=&apos;2020-08-01&apos;&#13;
  and dc.is_active&#13;
  and l.createdbyid in(&apos;0056900000AVz3YAAT&apos;,&apos;0051r00000AVr4JAAT&apos;,&apos;0051r00000AVr4OAAT&apos;,&apos;0056900000BUli5AAD&apos;)&#13;
  &#13;
  group by &#13;
  case when l.createdbyid in(&apos;0056900000AVz3YAAT&apos;,&apos;0051r00000AVr4JAAT&apos;,&apos;0051r00000AVr4OAAT&apos;,&apos;0056900000BUli5AAD&apos;) then &apos;Virtual Rep.&apos; else &apos;Human Rep.&apos; end,&#13;
  case when a.createdbyid in(&apos;0056900000AVz3YAAT&apos;,&apos;0051r00000AVr4JAAT&apos;,&apos;0051r00000AVr4OAAT&apos;,&apos;0056900000BUli5AAD&apos;) then &apos;Virtual Rep.&apos; else &apos;Human Rep.&apos; end,&#13;
  case when o.virtual_signings  is not null then &apos;Virtual Rep.&apos; else &apos;Human Rep.&apos; end,&#13;
  l.record_country__c,&#13;
  dc.management_entity_group,&#13;
  dc.common_name,&#13;
  dc.country_iso,&#13;
  dc.display_name,&#13;
  dc.region,&#13;
  ssu_date.ssu_released,&#13;
  ssu_release_date,&#13;
  l.status,&#13;
  o.Signed,&#13;
  o.Closed_Won,&#13;
  date(date_trunc(&apos;month&apos;,l.createddate)),&#13;
  --date_trunc(&apos;month&apos;,a.createddate),&#13;
  --date_trunc(&apos;month&apos;,o.closedate),&#13;
  l.is_converted,&#13;
  l.isdeleted,&#13;
  l.vertical__c,&#13;
  l.vertical_segment__c,&#13;
  l.lost_reason__c,&#13;
  l.lead_data_origin__c</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
