      <aliases enabled='yes' />
      <column caption='%Signed' datatype='real' name='[%Closed won (copy)_331577557394100228]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_331577557392285699])/SUM([total_leads])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0hg43xa0t9l3kt11qn71z0za1o6m].[pcto:sum:Calculation_2236318706319044618:qk]&quot;' value='Account created by' />
          <alias key='&quot;[federated.0hg43xa0t9l3kt11qn71z0za1o6m].[pcto:sum:Calculation_2236318706319769612:qk]&quot;' value='Closed Won by' />
          <alias key='&quot;[federated.0hg43xa0t9l3kt11qn71z0za1o6m].[pcto:sum:Calculation_331577557392285699:qk]&quot;' value='Signed by' />
          <alias key='&quot;[federated.0hg43xa0t9l3kt11qn71z0za1o6m].[pcto:sum:total_leads:qk]&quot;' value=' Leades created by' />
          <alias key='&quot;[federated.0hg43xa0t9l3kt11qn71z0za1o6m].[sum:total_leads:qk]&quot;' value='Total leads' />
        </aliases>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_leads]) / TOTAL(SUM([total_leads]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2236318706319044618]) / TOTAL(SUM([Calculation_2236318706319044618]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_331577557392285699]) / TOTAL(SUM([Calculation_331577557392285699]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation4]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2236318706319769612]) / TOTAL(SUM([Calculation_2236318706319769612]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation5]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_331577557392285699]) / TOTAL(SUM([Calculation_331577557392285699]))'>
          <table-calc ordering-field='[federated.0hg43xa0t9l3kt11qn71z0za1o6m].[none:account_converted_by:nk]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Untouched' datatype='integer' name='[Calculation_1352487287228772370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status]=&apos;New&apos; or [status]=&apos;Open&apos; then [total_leads] END' />
      </column>
      <column caption='Leads created' datatype='integer' name='[Calculation_1587518897758896135]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  DATE([Parameters].[Parameter 4])=date([lead_createddate]) then [total_leads] END' />
      </column>
      <column caption='Filter view type' datatype='boolean' name='[Calculation_1633680798696738816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 5]=&apos;Cohorte view&apos;' />
      </column>
      <column caption='Channel deployed' datatype='string' name='[Calculation_1855201610216587264]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [ssu_released] then &apos;Self Sign Up&apos; ELSE &apos;Web to Lead&apos; END' />
      </column>
      <column caption='Lead status' datatype='string' name='[Calculation_2236318706314850312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [status]=&apos;Calificado&apos; then &apos;Qualified&apos; ELSEIF &#13;&#10;[status]=&apos;Seguimiento a Largo Plazo&apos; then &apos;Long-term follow-up&apos; ELSEIF &#13;&#10;[status]=&apos;Contactado&apos; then &apos;Contacted&apos; ELSEIF &#13;&#10;[status]=&apos;Perdido&apos; THEN &apos;Lost&apos; ELSEIF &#13;&#10;[status]=&apos;Nuevo&apos; THEN &apos;New&apos; ELSE [status] end' />
      </column>
      <column caption='Converted' datatype='integer' name='[Calculation_2236318706319044618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [is_converted] then [total_leads] END' />
      </column>
      <column caption='Closed won' datatype='integer' name='[Calculation_2236318706319769612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [closed_won]=&apos;Closed Won&apos;  then [total_leads] ELSE 0 END' />
      </column>
      <column caption='Leads lost' datatype='integer' name='[Calculation_2236318706324008973]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [status]=&apos;Lost&apos; and [is_converted]=FALSE then [total_leads] END)' />
      </column>
      <column caption='%Converted' datatype='real' name='[Calculation_2236318706337566734]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2236318706319044618])/SUM([total_leads])' />
      </column>
      <column caption='%Closed won' datatype='real' name='[Calculation_2236318706337681423]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_2236318706319769612])/SUM([total_leads])' />
      </column>
      <column caption='Filter by top data origin' datatype='boolean' name='[Calculation_2391974369584697349]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(SUM([Calculation_2391974369826611208]),&apos;desc&apos;)&lt;= [Parameters].[Parameter 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Chosen KPI forsource ranking' datatype='integer' name='[Calculation_2391974369826611208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&apos;Total leads&apos; then [total_leads] ELSEIF &#13;&#10;[Parameters].[Parameter 2]=&apos;Converted&apos; AND [is_converted] THEN [total_leads] ELSEIF &#13;&#10;[Parameters].[Parameter 2]=&apos;Activated&apos; then [Calculation_2236318706319769612] END' />
      </column>
      <column caption='%Total leads' datatype='real' name='[Calculation_331577556943130625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_leads])/SUM([total_leads])' />
      </column>
      <column caption='Signed' datatype='integer' name='[Calculation_331577557392285699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [signed]=&apos;Signed&apos; then [total_leads] END' />
      </column>
      <column caption='Not Converted' datatype='real' name='[Converted (copy)_1352487287232847891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [is_converted]= FALSE and [status]&lt;&gt;&apos;Lost&apos; THEN [total_leads] END)/SUM([total_leads])' />
