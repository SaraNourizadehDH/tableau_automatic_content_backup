            <connection class='redshift' dbname='deliveryhero' odbc-connect-string-extras='' one-time-sql='' port='5439' schema='ds_salesforce' server='global-dwh.c0odzyvokw7w.eu-central-1.redshift.amazonaws.com' server-oauth='' single-node='no' sslmode='' username='ramiro_almasque' workgroup-auth-mode='prompt' />
