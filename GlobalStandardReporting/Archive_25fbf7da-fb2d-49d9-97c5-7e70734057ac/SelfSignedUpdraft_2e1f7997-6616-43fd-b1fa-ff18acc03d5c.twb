      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Consulta SQL personalizada' id='CustomSQL_738BBDDBEE9740C3A23A2236971C121E'>
            <properties context=''>
              <relation connection='redshift.1309h9n05m0b8p18d25ht1bbv6aj' name='Consulta SQL personalizada' type='text'>with op as &#13;
(SELECT accountid,id op_id, stagename, closedate, business_type__c, &#13;
case when stagename in (&apos;Editorial Queue&apos;,&apos;Promo and Logistics Queue&apos;,&apos;Onboarding&apos;,&apos;Closed Won&apos;, &apos;Delivery Pending&apos;) then &apos;Signed&apos; end Signed,&#13;
case when stagename=&apos;Closed Won&apos; then &apos;Closed Won&apos; end Closed_Won&#13;
from dwh_salesforce.opportunity&#13;
  where stagename in (&apos;Editorial Queue&apos;,&apos;Promo and Logistics Queue&apos;,&apos;Onboarding&apos;,&apos;Closed Won&apos;, &apos;Delivery Pending&apos;)&#13;
  and business_type__c in(&apos;New Business&apos;)&#13;
  and lastmodifieddate&gt;&gt;=&apos;2020-01-01&apos;),&#13;
&#13;
oh as(&#13;
 select distinct opportunityid from dwh_salesforce.opportunity_history&#13;
 where  opportunityid in(select op_id from op) &#13;
 and field=&apos;StageName&apos; &#13;
 and createddate&gt;&gt;=&apos;2020-01-01&apos;&#13;
 and newvalue in (&apos;Quality Check Request&apos;, &apos;Quality Check&apos;)&#13;
 and createdbyid in(&apos;0056900000AVz3YAAT&apos;,&apos;0051r00000AVr4JAAT&apos;,&apos;0051r00000AVr4OAAT&apos;,&apos;0056900000BUli5AAD&apos;)&#13;
 and opportunityid not in(select opportunityid from dwh_salesforce.opportunity_history&#13;
                          where opportunityid in(select op_id from op) &#13;
                          and field=&apos;StageName&apos; &#13;
                          and newvalue=&apos;Please Check&apos;&#13;
                          and createddate&gt;&gt;=&apos;2020-01-01&apos;)),&#13;
&#13;
o as (&#13;
select op.*, oh.opportunityid virtual_signings&#13;
from op &#13;
left join oh &#13;
on op.op_id=oh.opportunityid ), &#13;
&#13;
ac as &#13;
(SELECT id, grid__c,createdbyid, createddate from dwh_salesforce.account &#13;
  where createddate&gt;&gt;=&apos;2020-01-01&apos;)&#13;
&#13;
SELECT  count( l.id) as total_leads,&#13;
        --case when l.createdbyid = &apos;0051r000009S40GAAS&apos; then  &apos;GSD_leads&apos; else &apos;Local_leads&apos; end as leads_origin ,&#13;
        case when l.createdbyid in(&apos;0056900000AVz3YAAT&apos;,&apos;0051r00000AVr4JAAT&apos;,&apos;0051r00000AVr4OAAT&apos;,&apos;0056900000BUli5AAD&apos;) then &apos;Virtual Rep.&apos; else &apos;Human Rep.&apos; end Lead_created_by, &#13;
        case when a.createdbyid in(&apos;0056900000AVz3YAAT&apos;,&apos;0051r00000AVr4JAAT&apos;,&apos;0051r00000AVr4OAAT&apos;,&apos;0056900000BUli5AAD&apos;) then &apos;Virtual Rep.&apos; else &apos;Human Rep.&apos; end Account_converted_by,&#13;
        case when o.virtual_signings is not null then &apos;Virtual Rep.&apos; else &apos;Human Rep.&apos; end Signed_by,&#13;
        l.record_country__c,&#13;
        --GET_SF_SOURCE_ID(l.record_country__c, l.platform__c) as source_id,&#13;
        --case when l.leadsource =&apos;IMPORT&apos; then &apos;Import&apos; else l.leadsource end as Lead_source ,&#13;
        dc.management_entity_group,&#13;
        dc.common_name,&#13;
        dc.country_iso,&#13;
        dc.display_name,&#13;
        dc.region,&#13;
        ssu_date.ssu_released,&#13;
        ssu_release_date,&#13;
        l.status,&#13;
        o.Signed,&#13;
        o.Closed_Won,&#13;
        date(date_trunc(&apos;month&apos;,l.createddate)) lead_createddate,&#13;
        --date(date_trunc(&apos;month&apos;,a.createddate)) account_createddate,&#13;
        --date(date_trunc(&apos;month&apos;,o.closedate)) op_closedddate,&#13;
        l.is_converted,&#13;
        l.isdeleted,&#13;
        l.vertical__c,&#13;
        l.vertical_segment__c,&#13;
        l.lost_reason__c,&#13;
        l.lead_data_origin__c,&#13;
        current_date as Last_update&#13;
 FROM deliveryhero.dwh_salesforce.lead l&#13;
 &#13;
 Left join ds_salesforce.sf_sf_dwh_country_company_mapping dc &#13;
 on dc.name=l.record_country__c&#13;
&#13;
 left join  ds_global_dev.ssu_release_date ssu_date&#13;
 on l.record_country__c=ssu_date.country_name&#13;
 and dc.global_entity_id=ssu_date.global_entity_id &#13;
 and l.createddate&gt;&gt;=ssu_date.ssu_release_date&#13;
&#13;
 LEFT JOIN ac a &#13;
 ON a.grid__c=l.grid__c&#13;
&#13;
  LEFT JOIN o &#13;
 on a.id=o.accountid&#13;
 &#13;
  where l.createddate&gt;&gt;=&apos;2020-08-01&apos;&#13;
  and dc.is_active&#13;
  and l.createdbyid in(&apos;0056900000AVz3YAAT&apos;,&apos;0051r00000AVr4JAAT&apos;,&apos;0051r00000AVr4OAAT&apos;,&apos;0056900000BUli5AAD&apos;)&#13;
  &#13;
  group by &#13;
  case when l.createdbyid in(&apos;0056900000AVz3YAAT&apos;,&apos;0051r00000AVr4JAAT&apos;,&apos;0051r00000AVr4OAAT&apos;,&apos;0056900000BUli5AAD&apos;) then &apos;Virtual Rep.&apos; else &apos;Human Rep.&apos; end,&#13;
  case when a.createdbyid in(&apos;0056900000AVz3YAAT&apos;,&apos;0051r00000AVr4JAAT&apos;,&apos;0051r00000AVr4OAAT&apos;,&apos;0056900000BUli5AAD&apos;) then &apos;Virtual Rep.&apos; else &apos;Human Rep.&apos; end,&#13;
  case when o.virtual_signings  is not null then &apos;Virtual Rep.&apos; else &apos;Human Rep.&apos; end,&#13;
  l.record_country__c,&#13;
  dc.management_entity_group,&#13;
  dc.common_name,&#13;
  dc.country_iso,&#13;
  dc.display_name,&#13;
  dc.region,&#13;
  ssu_date.ssu_released,&#13;
  ssu_release_date,&#13;
  l.status,&#13;
  o.Signed,&#13;
  o.Closed_Won,&#13;
  date(date_trunc(&apos;month&apos;,l.createddate)),&#13;
  --date_trunc(&apos;month&apos;,a.createddate),&#13;
  --date_trunc(&apos;month&apos;,o.closedate),&#13;
  l.is_converted,&#13;
  l.isdeleted,&#13;
  l.vertical__c,&#13;
  l.vertical_segment__c,&#13;
  l.lost_reason__c,&#13;
  l.lead_data_origin__c</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='SSU revenue' inline='true' name='federated.1asj49w0bsymeq1fofu2s05kbn8d' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='global-dwh.c0odzyvokw7w.eu-central-1.redshift.amazonaws.com' name='redshift.03m850c1jk3hkt1763tku0dj20za'>
            <connection class='redshift' dbname='deliveryhero' odbc-connect-string-extras='' one-time-sql='' port='5439' schema='ds_s3_etl_data_catalog' server='global-dwh.c0odzyvokw7w.eu-central-1.redshift.amazonaws.com' server-oauth='' single-node='no' sslmode='require' username='ramiro_almasque' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='redshift.03m850c1jk3hkt1763tku0dj20za' name='Custom SQL Query' type='text'>with SSU as (&#13;
SELECT &#13;
p.backend_id__c restaurant_id,&#13;
ssu_date.ssu_released,&#13;
case when a.createdbyid in(&apos;0056900000AVz3YAAT&apos;,&apos;0051r00000AVr4JAAT&apos;,&apos;0051r00000AVr4OAAT&apos;,&apos;0056900000BUli5AAD&apos;)&#13;
     then &apos;Virtual Rep&apos; else &apos;Human Rep&apos; end Account_created_by&#13;
FROM deliveryhero.dwh_salesforce.platform p &#13;
&#13;
left join dwh_salesforce.account a&#13;
on p.account__c=a.id&#13;
&#13;
left join dwh_salesforce.lead l&#13;
on p.grid__c=l.grid__c&#13;
&#13;
left join ds_global_dev.ssu_release_date ssu_date &#13;
    on l.record_country__c=ssu_date.country_name&#13;
    and l.createddate&gt;&gt;=ssu_date.ssu_release_date&#13;
&#13;
where l.createdbyid in(&apos;0056900000AVz3YAAT&apos;,&apos;0051r00000AVr4JAAT&apos;,&apos;0051r00000AVr4OAAT&apos;,&apos;0056900000BUli5AAD&apos;)),&#13;
&#13;
o as (&#13;
select source_id,&#13;
      restaurant_id, &#13;
      date_id, &#13;
      date(order_date) date,&#13;
      count(distinct order_id) orders,&#13;
      sum(amt_commission_eur) Commission_revenue,&#13;
      sum(amt_gmv_eur) GMV,&#13;
      sum(amt_gfv_eur) GFV,&#13;
      sum(amt_cv_eur) Commissionable_value&#13;
      from dwh_il.ranked_fct_order&#13;
      where date_id&gt;&gt;=20200801&#13;
      and is_failed is false &#13;
      and restaurant_id in(select restaurant_id from SSU) &#13;
      &#13;
      group by &#13;
      source_id,&#13;
      restaurant_id, &#13;
      date_id, &#13;
      date(order_date)) &#13;
&#13;
 select &#13;
  dc.name,&#13;
  dc.region,&#13;
  dc.management_entity_group AS entity,&#13;
  dc.display_name AS sub_entity,&#13;
  dc.dwh_source_code AS global_entity_id,&#13;
  r.source_id, &#13;
  r.activation_date,&#13;
  r.restaurant_id, &#13;
  SSU.Account_created_by,&#13;
  SSU.ssu_released,&#13;
  sum(o.orders) orders,&#13;
  sum(Commission_revenue) Commission_revenue,&#13;
  sum(GMV) GMV,&#13;
  sum(GFV) GFV,&#13;
  sum(Commissionable_value) Commissionable_value  &#13;
    from  dwh_il.dim_restaurant r&#13;
   &#13;
    inner join SSU&#13;
    on r.restaurant_id=SSU.restaurant_id&#13;
   &#13;
    left join o &#13;
    on o.restaurant_id=r.restaurant_id&#13;
    and r.source_id=o.source_id&#13;
    and o.date&gt;&gt;=date(r.activation_date)&#13;
    and date(dateadd(&apos;day&apos;,30,r.activation_date))&gt;&gt;=o.date&#13;
    &#13;
&#13;
    &#13;
    left join &#13;
    ds_salesforce.sf_sf_dwh_country_company_mapping AS dc&#13;
    on r.source_id=dc.source_id&#13;
&#13;
    &#13;
  &#13;
  where activation_date&gt;&gt;=&apos;2020-08-01&apos;  &#13;
  and is_test_restaurant is false&#13;
  --and r.restaurant_id in(SELECT restaurant_id from SSU)&#13;
   &#13;
  group by &#13;
  dc.name,&#13;
  dc.region,&#13;
  dc.management_entity_group,&#13;
  dc.display_name,&#13;
  dc.dwh_source_code,&#13;
  SSU.Account_created_by,&#13;
  SSU.ssu_released,&#13;
  r.source_id, &#13;
  r.activation_date,&#13;
  r.restaurant_id</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='redshift.03m850c1jk3hkt1763tku0dj20za' name='Custom SQL Query' type='text'>with SSU as (&#13;
SELECT &#13;
p.backend_id__c restaurant_id,&#13;
ssu_date.ssu_released,&#13;
case when a.createdbyid in(&apos;0056900000AVz3YAAT&apos;,&apos;0051r00000AVr4JAAT&apos;,&apos;0051r00000AVr4OAAT&apos;,&apos;0056900000BUli5AAD&apos;)&#13;
     then &apos;Virtual Rep&apos; else &apos;Human Rep&apos; end Account_created_by&#13;
FROM deliveryhero.dwh_salesforce.platform p &#13;
&#13;
left join dwh_salesforce.account a&#13;
on p.account__c=a.id&#13;
&#13;
left join dwh_salesforce.lead l&#13;
on p.grid__c=l.grid__c&#13;
&#13;
left join ds_global_dev.ssu_release_date ssu_date &#13;
    on l.record_country__c=ssu_date.country_name&#13;
    and l.createddate&gt;&gt;=ssu_date.ssu_release_date&#13;
&#13;
where l.createdbyid in(&apos;0056900000AVz3YAAT&apos;,&apos;0051r00000AVr4JAAT&apos;,&apos;0051r00000AVr4OAAT&apos;,&apos;0056900000BUli5AAD&apos;)),&#13;
&#13;
o as (&#13;
select source_id,&#13;
      restaurant_id, &#13;
      date_id, &#13;
      date(order_date) date,&#13;
      count(distinct order_id) orders,&#13;
      sum(amt_commission_eur) Commission_revenue,&#13;
      sum(amt_gmv_eur) GMV,&#13;
      sum(amt_gfv_eur) GFV,&#13;
      sum(amt_cv_eur) Commissionable_value&#13;
      from dwh_il.ranked_fct_order&#13;
      where date_id&gt;&gt;=20200801&#13;
      and is_failed is false &#13;
      and restaurant_id in(select restaurant_id from SSU) &#13;
      &#13;
      group by &#13;
      source_id,&#13;
      restaurant_id, &#13;
      date_id, &#13;
      date(order_date)) &#13;
&#13;
 select &#13;
  dc.name,&#13;
  dc.region,&#13;
  dc.management_entity_group AS entity,&#13;
  dc.display_name AS sub_entity,&#13;
  dc.dwh_source_code AS global_entity_id,&#13;
  r.source_id, &#13;
  r.activation_date,&#13;
  r.restaurant_id, &#13;
  SSU.Account_created_by,&#13;
  SSU.ssu_released,&#13;
  sum(o.orders) orders,&#13;
  sum(Commission_revenue) Commission_revenue,&#13;
  sum(GMV) GMV,&#13;
  sum(GFV) GFV,&#13;
  sum(Commissionable_value) Commissionable_value  &#13;
    from  dwh_il.dim_restaurant r&#13;
   &#13;
    inner join SSU&#13;
    on r.restaurant_id=SSU.restaurant_id&#13;
   &#13;
    left join o &#13;
    on o.restaurant_id=r.restaurant_id&#13;
    and r.source_id=o.source_id&#13;
    and o.date&gt;&gt;=date(r.activation_date)&#13;
    and date(dateadd(&apos;day&apos;,30,r.activation_date))&gt;&gt;=o.date&#13;
    &#13;
&#13;
    &#13;
    left join &#13;
    ds_salesforce.sf_sf_dwh_country_company_mapping AS dc&#13;
    on r.source_id=dc.source_id&#13;
&#13;
    &#13;
  &#13;
  where activation_date&gt;&gt;=&apos;2020-08-01&apos;  &#13;
  and is_test_restaurant is false&#13;
  --and r.restaurant_id in(SELECT restaurant_id from SSU)&#13;
   &#13;
  group by &#13;
  dc.name,&#13;
  dc.region,&#13;
  dc.management_entity_group,&#13;
  dc.display_name,&#13;
  dc.dwh_source_code,&#13;
  SSU.Account_created_by,&#13;
  SSU.ssu_released,&#13;
  r.source_id, &#13;
  r.activation_date,&#13;
  r.restaurant_id</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
