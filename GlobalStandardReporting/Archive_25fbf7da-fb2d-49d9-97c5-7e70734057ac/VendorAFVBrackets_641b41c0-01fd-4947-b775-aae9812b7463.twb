      <aliases enabled='yes' />
      <column caption='ATTR' datatype='integer' name='[Calculation_4028047657959006208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ATTR(1)' />
      </column>
      <column caption='Orders per Vendor' datatype='real' name='[Calculation_4028047657959645185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_orders]) / SUM([n_of_vendors])' />
      </column>
      <column caption='DF as %AFV' datatype='real' name='[Calculation_4028047657959960578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([df_eur]) / SUM([gfv])' />
      </column>
      <column caption='DH Incentives as %AFV' datatype='real' name='[Calculation_4028047657962074115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([amt_dh_funded_incentives_eur]) / SUM([gfv])' />
      </column>
      <column caption='Vendor Incentives as %AFV' datatype='real' name='[DH Incentives as %AFV (copy)_4028047657962475524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([amt_vendor_funded_incentives_eur]) / SUM([gfv])' />
      </column>
      <column caption='GPO (EUR)' datatype='real' name='[GP (EUR) (copy)_2888144373836726272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gp_eur]) / sum([successful_orders])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_16BB53398CB34100932D55A04E7EC864]' role='measure' type='quantitative' />
