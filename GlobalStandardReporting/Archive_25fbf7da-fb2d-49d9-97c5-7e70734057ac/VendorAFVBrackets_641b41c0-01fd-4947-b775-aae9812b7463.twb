    END AS afv_brackets_sort,
  SUM(v.successful_orders) as successful_orders,
  COUNT(DISTINCT v.vendor_id) as n_of_vendors,
  SUM(v.gfv) as gfv,
  SUM(v.df_eur) as df_eur,
