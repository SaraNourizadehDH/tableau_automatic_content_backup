            <column caption='Share %' datatype='real' name='[Calculation_4647011195535126529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([kam]/[fx_rate])+SUM([sam]/[fx_rate]))/(SUM([pp_eur])+SUM([Calculation_4647011195534999552]/[fx_rate])+SUM([vfd_amount]))' />
            </column>
            <column caption='AM Costs' datatype='real' name='[Calculation_4647011195538735106]' role='measure' type='quantitative'>
