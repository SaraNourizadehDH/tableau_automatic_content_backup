      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_F6D2E369CE254167A61950E55C968BBC'>
            <properties context=''>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Sheet1].[global_entity_id]' />
                    <expression op='[tableau_gsr_entitlements_global_entity_id].[global_entity_id]' />
                  </expression>
                </clause>
                <relation join='left' type='join'>
                  <clause type='join'>
                    <expression op='AND'>
                      <expression op='='>
                        <expression op='[Custom SQL Query].[global_entity_id]' />
                        <expression op='[Sheet1].[global_entity_id]' />
                      </expression>
