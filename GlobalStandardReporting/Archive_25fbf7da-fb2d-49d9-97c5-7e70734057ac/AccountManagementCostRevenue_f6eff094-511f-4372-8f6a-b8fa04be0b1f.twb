                      </expression>
                    </expression>
                  </clause>
                  <relation connection='bigquery.1ed7yi218zs76y1d3vm0h0li5ekp' name='Custom SQL Query' type='text'>with lucanet as
(SELECT DATE(date) AS date,global_entity_id,ABS(sam_personnel_costs) as sam, COALESCE(ABS( kam_personnel_costs),0) as  kam ,commission_revenue__delivery as com_od,coalesce(commission_revenue_marketplace,0)  as com_mp  FROM `fulfillment-dwh-production.curated_data_shared_intl_markets.lucanet_actuals` 
WHERE date &gt;&gt;=&apos;2022-01-01&apos; ) ,

pp as
(SELECT DATE_TRUNC(p.pp_date,MONTH) as pp_month,  p.global_entity_id,sum(p.amt_premium_fee) pp,sum(p.amt_premium_fee_eur) as pp_eur from `fulfillment-dwh-production.cl_sales_revenue.fct_premium_placement` as p
group by 1,2), 

fx as
(SELECT DATE_TRUNC(fx_rate_date,MONTH) AS fx_month,global_entity_id,f.currency_code,AVG(fx_rate_eur) as fx_rate FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.fx_rates` as f
INNER JOIN 
`fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` as ge
ON f.currency_code=ge.currency_code
WHERE DATE_TRUNC(fx_rate_date,MONTH) between &apos;2022-01-01&apos; and  &apos;2022-07-01&apos; and is_platform_online is true and is_reporting_enabled is true
GROUP BY 1,2,3
order by 2)

SELECT l.date,l.global_entity_id,fx.fx_rate,pp.pp,pp.pp_eur,l.sam,l.kam,l.com_mp,l.com_od
FROM lucanet l
LEFT JOIN pp 
ON pp.pp_month=l.date and pp.global_entity_id=l.global_entity_id
inner JOIN fx
ON fx.fx_month=l.date and fx.global_entity_id=l.global_entity_id</relation>
