          <alias key='&quot;[federated.0qpsgr005167gq176ow521aiz118].[avg:dh_matched_pim_l2_prod_count:qk]&quot;' value='DH Matched PIM L2 prod Count' />
          <alias key='&quot;[federated.0qpsgr005167gq176ow521aiz118].[ctd:comp_assort_comp_product_name:qk]&quot;' value='Competitor Assortment Size' />
          <alias key='&quot;[federated.0qpsgr005167gq176ow521aiz118].[ctd:comp_product_name:qk]&quot;' value='Comp Assortment size ' />
          <alias key='&quot;[federated.0qpsgr005167gq176ow521aiz118].[ctd:dh_product_name:qk]&quot;' value='DH Assortment size (Matched)' />
          <alias key='&quot;[federated.0qpsgr005167gq176ow521aiz118].[ctd:master_id:qk]&quot;' value='DH Assortment' />
          <alias key='&quot;[federated.0qpsgr005167gq176ow521aiz118].[ctd:matched_comp_product_name:qk]&quot;' value='Matched Comp Assortment' />
