      </column>
      <column datatype='real' default-format='p0.00%' hidden='true' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([comp_product_name]) / TOTAL(COUNTD([comp_product_name]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='% SKU covered by matching' datatype='real' name='[Calculation_2497597870675435520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([matched_master_id])/COUNTD([comp_assort_comp_product_name])' />
      </column>
      <column caption='DH Matched SKU' datatype='boolean' datatype-customized='true' name='[Calculation_2497597870684770305]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [time_level] = &apos;SKU level&apos; AND  NOT(ISNULL([product_name])) THEN TRUE &#10;ELSE FALSE &#10;END' />
      </column>
      <column caption='Rank of Matched DH assortment' datatype='integer' name='[Calculation_296815398985371648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE( COUNTD([matched_master_id]) )'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Difference (in %)' datatype='real' default-format='p0.00%' name='[Calculation_3263772724385202178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(AVG([comp_country_assrtment_size]) - AVG([dh_country_sku_count]))/avg([dh_country_sku_count])' />
      </column>
      <column caption='Latest stock date' datatype='date' name='[Calculation_3703788503999459328]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([stock_date])' />
      </column>
      <column caption='Latest date filter' datatype='boolean' name='[Calculation_3703788504000913409]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3703788503999459328] = MAX([stock_date]) THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='% Matching Category' datatype='real' default-format='p0.0%' name='[Calculation_3703788504003756034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([matched_master_id])/COUNTD([master_id])' />
      </column>
      <column caption='SKU Addition Opputunity in Category' datatype='real' name='[Calculation_406449906347806720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([comp_assort_comp_category_prod_count]) - COUNTD([matched_comp_product_name])' />
      </column>
      <column caption='filter DH SKUs' datatype='boolean' name='[Calculation_406449906660376579]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([master_id] ) THEN FALSE ELSE TRUE end' />
      </column>
      <column caption='filter Comp Assort' datatype='boolean' name='[Calculation_406449906672177156]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  ISNULL([comp_assort_competitor_name]) THEN FALSE ELSE TRUE END' />
      </column>
      <column caption='DH Brand Name' datatype='string' name='[Calculation_406449906678575109]' role='dimension' type='nominal'>
