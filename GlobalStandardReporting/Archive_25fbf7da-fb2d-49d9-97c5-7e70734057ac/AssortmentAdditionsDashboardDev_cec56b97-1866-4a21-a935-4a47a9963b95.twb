    <worksheet name='3.2 Cat to Cat mapping'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'>Category Mapping based on matched products</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_assortment_addition (dev_dmart)' name='federated.0qpsgr005167gq176ow521aiz118' />
          </datasources>
          <datasource-dependencies datasource='federated.0qpsgr005167gq176ow521aiz118'>
            <column caption='Rank of Matched DH assortment' datatype='integer' name='[Calculation_296815398985371648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_DENSE( COUNTD([matched_master_id]) )'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='SKU Addition Opputunity in Category' datatype='real' name='[Calculation_406449906347806720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([comp_assort_comp_category_prod_count]) - COUNTD([matched_comp_product_name])' />
            </column>
            <column caption='Competitor Category ' datatype='string' name='[Competitor Category (copy)_2719259422281711616]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([comp_assort_comp_category],&apos;&apos;)' />
