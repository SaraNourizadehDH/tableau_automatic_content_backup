        <calculation class='tableau' formula='CASE [Parameters].[Choose the metrics (copy)_3755087306451062799] &#10;&#10;WHEN  &apos;Multiple User ID&apos; THEN [% Multiple UserID (copy)_3755087306446430220] / SUM([distinct_sessions])&#10;WHEN &apos;Without User ID&apos; THEN [# Multiple UserID (copy)_3755087306449788941] / SUM([distinct_sessions])&#10;&#10;END' />
