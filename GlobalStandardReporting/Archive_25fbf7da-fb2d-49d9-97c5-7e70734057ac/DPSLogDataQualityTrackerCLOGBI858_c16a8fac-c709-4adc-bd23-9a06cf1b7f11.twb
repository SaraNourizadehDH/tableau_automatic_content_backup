            <column caption='# UserID Per Session' datatype='string' name='[Calculation_3755087306107932678]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [distinct_user_id_per_session] = 0 THEN NULL&#10;ELSEIF [distinct_user_id_per_session] = 1 THEN &apos;1&apos;&#10;ELSEIF [distinct_user_id_per_session] &gt; 1 THEN &apos;&gt;1&apos;&#10;END' />
