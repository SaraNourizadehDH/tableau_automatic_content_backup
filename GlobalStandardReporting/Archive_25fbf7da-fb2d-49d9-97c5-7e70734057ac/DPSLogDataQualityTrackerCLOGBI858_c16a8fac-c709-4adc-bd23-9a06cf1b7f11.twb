      <column caption='# Color code - UserID' datatype='real' name='[# Color code - Variant (copy)_2797861280267788290]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Metrics (copy)_3755087306450165774] &gt; [# Max - Variant (copy)_2797861280267952131] THEN [# Max - Variant (copy)_2797861280267952131]/ ([# Max - Variant (copy)_2797861280267952131] / 5)&#10;&#10;ELSE [Metrics (copy)_3755087306450165774]/ ([# Max - Variant (copy)_2797861280267952131] / 5)&#10;&#10;END'>
