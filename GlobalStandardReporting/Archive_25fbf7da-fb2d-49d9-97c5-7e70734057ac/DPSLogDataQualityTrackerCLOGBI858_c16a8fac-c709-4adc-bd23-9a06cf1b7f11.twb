    <worksheet name='DPS logs #'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='14'># of DPS logs</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dps_log_data_quality_tracker_platforms' name='federated.1m514u90m4j61015nae400ayjy9e' />
            <datasource name='Parameters' />
            <datasource caption='dps_log_data_quality_tracker' name='federated.12d2etj0c6w0km0zskc0o0ahijtr' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='No (% of logs filtered out from DPS pipeline)' caption='Incl Timestamp issue' datatype='string' name='[Parameter 1 1 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;No&quot;'>
              <calculation class='tableau' formula='&quot;No&quot;' />
              <aliases>
                <alias key='&quot;No&quot;' value='No (% of logs filtered out from DPS pipeline)' />
              </aliases>
            </column>
            <column alias='Day' caption='Choose Time Dimension' datatype='string' name='[Parameter 1 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Date&quot;'>
              <calculation class='tableau' formula='&quot;Date&quot;' />
              <aliases>
                <alias key='&quot;Date&quot;' value='Day' />
                <alias key='&quot;Week&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.12d2etj0c6w0km0zskc0o0ahijtr'>
            <column caption='Time Dimension' datatype='string' name='[Calculation_1647754580089847817]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE   [Parameters].[Parameter 1 1]&#13;&#10;&#13;&#10;WHEN  &apos;Date&apos;  THEN [report_date]&#13;&#10;&#13;&#10;WHEN  &apos;Week&apos; THEN [report_week]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Report Date' datatype='string' name='[report_date]' role='dimension' type='nominal' />
            <column caption='Report Week' datatype='string' name='[report_week]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1m514u90m4j61015nae400ayjy9e'>
            <column caption='TTL Logs TimeDim' datatype='integer' name='[Calculation_1186135558363459585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE   [Parameters].[Parameter 1 1]&#13;&#10;&#13;&#10;WHEN  &apos;Date&apos;  THEN [ttl_logs]&#13;&#10;&#13;&#10;WHEN  &apos;Week&apos; THEN [ttl_logs_week]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Valid data Parameter' datatype='boolean' name='[Calculation_1647754580089847817 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE  [Parameters].[Parameter 1 1 1]&#13;&#10;&#13;&#10;WHEN  &apos;Yes&apos;  THEN [Calculation_572520108147740672]&#13;&#10;&#13;&#10;WHEN  &apos;No&apos; THEN [Calculation_572520108147740672 1]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Time Dimension' datatype='string' name='[Calculation_1647754580089847817]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE   [Parameters].[Parameter 1 1]&#13;&#10;&#13;&#10;WHEN  &apos;Date&apos;  THEN [report_date]&#13;&#10;&#13;&#10;WHEN  &apos;Week&apos; THEN [report_week]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Valid data wo timestamp' datatype='boolean' name='[Calculation_572520108147740672 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[has_dps_session_id] AND [has_perseus_client_id] AND [has_customer_location]' />
            </column>
            <column caption='Valid data' datatype='boolean' name='[Calculation_572520108147740672]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[has_dps_session_id] AND [has_perseus_client_id] AND [has_customer_location] AND [has_valid_dps_session_timestamp]' />
            </column>
            <column caption='Logs Fixed Count' datatype='real' name='[Calculation_572520108151304194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [Calculation_1647754580089847817],[platform],[entity_id],[endpoint] : AVG([Calculation_1186135558363459585]) })' />
            </column>
            <column caption='% of Logs' datatype='real' name='[Calculation_572520108152176643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_952792802377474049]/[Calculation_572520108151304194]' />
            </column>
            <column caption='Platform' datatype='string' name='[Calculation_700028274314915840]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [platform]&#13;&#10;WHEN &apos;Yemeksepeti&apos; THEN &apos;pandora&apos;&#13;&#10;WHEN &apos;Damejidlo&apos; THEN &apos;pandora&apos;&#13;&#10;WHEN &apos;Foodpanda&apos; THEN &apos;pandora&apos;&#13;&#10;WHEN &apos;Mjam&apos; THEN &apos;pandora&apos;&#13;&#10;WHEN &apos;Foodora&apos; THEN &apos;pandora&apos;&#13;&#10;WHEN &apos;PedidosYa&apos; THEN &apos;peya&apos;&#13;&#10;WHEN &apos;OnDemandRider&apos; THEN &apos;odr&apos;&#13;&#10;ELSE lower([platform]) END' />
            </column>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_700028274354896897]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username] = USERNAME()' />
            </column>
            <column caption='Filter out Today' datatype='boolean' name='[Calculation_825917963864932358]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_date] &lt; TODAY()' />
            </column>
            <column caption='Logs Sum' datatype='integer' name='[Calculation_952792802377474049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([logs])' />
            </column>
