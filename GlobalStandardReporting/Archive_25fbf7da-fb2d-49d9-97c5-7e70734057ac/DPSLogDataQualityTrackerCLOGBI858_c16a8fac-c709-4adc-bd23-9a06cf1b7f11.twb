              <calculation class='tableau' formula='CASE [Parameters].[Choose Dimension (A) (copy)_3755087306471137297]&#10;&#10;WHEN  &apos;Region&apos; THEN [region]&#10;WHEN &apos;Country Name&apos; THEN [country_name]&#10;WHEN &apos;Country Code&apos; THEN [country_code]&#10;WHEN &apos;Entity ID&apos; THEN [entity_id]&#10;WHEN &apos;Distinct Variant&apos; THEN STR([distinct_variant_per_session])&#10;WHEN &apos;Variant Combination&apos; THEN [variant_combination]&#10;WHEN &apos;Distinct User ID&apos; THEN STR([distinct_user_id_per_session])&#10;WHEN &apos;Distinct Location&apos; THEN STR([distinct_location_per_session])&#10;WHEN &apos;Max distance batch&apos; THEN STR([max_distance_batch])&#10;WHEN &apos;All&apos; THEN &apos;&apos;&#10;&#10;END' />
