      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/AMIMonthlyMetrics_16759418074530/Definitions?rev=' id='Definitions' path='/t/GlobalStandardReporting/workbooks/AMIMonthlyMetrics_16759418074530' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_7' value='top' />
        </style-rule>
      </style>
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='8' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='91400' id='7' type-v2='text' w='69549' x='475' y='7744'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Tableau Regular'>Week:  </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Regular'>Monday is the start of each week</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Tableau Regular'>Activated Account Managers%:  </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Regular'># of AMs who have processed at least 1 Action Item in their lifetime / FT AMs</run>
              <run>Æ&#10;</run>
              <run fontcolor='#37474f' fontname='Tableau Regular'>- AIs with (</run>
              <run fontcolor='#000000' fontname='Tableau Regular'>status__c </run>
              <run fontcolor='#3367d6' fontname='Tableau Regular'>IN</run>
              <run fontcolor='#000000' fontname='Tableau Regular'>Æ </run>
              <run fontcolor='#37474f' fontname='Tableau Regular'>(</run>
              <run fontcolor='#0d904f' fontname='Tableau Regular'>&apos;In Progress&apos;</run>
              <run fontcolor='#000000' fontname='Tableau Regular'>,</run>
              <run fontcolor='#0d904f' fontname='Tableau Regular'>&apos;On Hold&apos;</run>
