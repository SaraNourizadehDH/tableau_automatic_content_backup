      <aliases enabled='yes' />
      <column caption='Plan Price' datatype='real' name='[Calculation_5694942470699220992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[gross_savings]-[net_savings]' />
      </column>
      <column caption='Net Savings / Plan Price' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5694942470700077057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([net_savings])/SUM([Calculation_5694942470699220992])' />
      </column>
      <column caption='Filter taiwan' datatype='boolean' name='[Calculation_5694942470703337474]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [global_entity_id] = &apos;FP_TW&apos; AND [plan_duration] = 12 &#10;AND [Calculation_5780510862153310208] = &apos;CHURN&apos; THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Churn/Not Churn' datatype='string' name='[Calculation_5780510862153310208]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([resub_days_from_next_plan] = &apos;DID NOT RESUB&apos; &#10;OR [resub_days_from_next_plan] = &apos;RESUB &gt;30D&apos;) THEN &apos;CHURN&apos;&#10;ELSE &apos;NOT CHURNED&apos; END' />
      </column>
      <column caption='Net Savings / Benefit Orders' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5780510862159314946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([net_savings])/SUM([benefit_orders])' />
      </column>
      <column caption='Benefit orders / All Orders' datatype='real' default-format='p0.0%' name='[Calculation_5780510862161362947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([benefit_orders])/SUM([total_orders_pd])' />
      </column>
