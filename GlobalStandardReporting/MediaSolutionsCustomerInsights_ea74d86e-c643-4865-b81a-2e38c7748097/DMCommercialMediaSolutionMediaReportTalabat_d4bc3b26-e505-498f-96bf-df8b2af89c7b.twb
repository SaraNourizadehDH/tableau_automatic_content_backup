    <worksheet name='Export_BNR'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/MediaReportTalabat_16751713830750/Export_BNR?rev=' id='Export_BNR' path='/t/GlobalStandardReporting/workbooks/MediaReportTalabat' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='Talabat, Banners' name='federated.1l5omit0d7ak9u1gofw1p01b3or0 (copy)' />
          </datasources>
          <datasource-dependencies datasource='federated.1l5omit0d7ak9u1gofw1p01b3or0 (copy)'>
            <column caption='Week Number' datatype='string' name='[Calculation_2306687468879060992]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(ISOWEEK([partition_date]))' />
            </column>
            <column caption='Date' datatype='date' name='[Calculation_2306687468880179204]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ATTR([partition_date])' />
            </column>
            <column caption='M: Product Clicks' datatype='integer' name='[Calculation_2975049784774819840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([atc_hits]) + SUM([pc_opened_hits])' />
            </column>
            <column caption='M: Banner Impressions' datatype='integer' name='[Calculation_2975049784777113603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [partition_date],[country], [global_entity_id], brand, [platform], [banner_name]: MAX([bnr_shown_sessions])}' />
            </column>
            <column caption='M: Sales Value' datatype='real' name='[Calculation_4145352370194120707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_price_paid_eur]' />
            </column>
            <column caption='M: Product Impressions' datatype='integer' name='[Sessions: Banner Clicked (copy)_4145352370182365185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [partition_date],[country], [global_entity_id], brand, [platform], [product_sku_be]: SUM([atc_sessions])}' />
            </column>
            <column datatype='integer' name='[atc_hits]' role='measure' type='quantitative' />
