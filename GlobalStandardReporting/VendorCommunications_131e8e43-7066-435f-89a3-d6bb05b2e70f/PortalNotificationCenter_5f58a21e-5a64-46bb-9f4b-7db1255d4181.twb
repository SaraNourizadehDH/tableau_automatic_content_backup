      <aliases enabled='yes' />
      <column caption='% Notification Center Sessions Penetration' datatype='real' name='[% Notification Center User Penetration (copy)_649222101872545793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([notification_sessions])/SUM([sessions]),0)' />
      </column>
      <column caption='Daily Active Users / Period Active Users' datatype='real' name='[Calculation_649222034219855880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([daily_notification_users_sum])/SUM([notification_users]),0)' />
      </column>
      <column caption='% Notification Center User Penetration' datatype='real' name='[Calculation_649222101872250880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(SUM([notification_users])/SUM([users]),0)' />
      </column>
      <column caption='Entity Selector' datatype='string' name='[Calculation_649222101874974722]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Segment&apos; THEN [segment]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Management Entity&apos; THEN [management_entity]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Country&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Brand&apos; THEN [brand]&#10;END' />
      </column>
      <column caption='Report Date' datatype='date' name='[Calculation_649222101884219396]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([max_date])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_4E02363F50D14BD8B8842F028CF7DD46]' role='measure' type='quantitative' />
