    <datasource caption='notifications_user_penetration' inline='true' name='federated.1whoseo1dnkao91ga95ig1a6yo16' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0tsry0e1rme5y21h381541v8y5h5'>
            <connection CATALOG='fulfillment-dwh-staging' EXECCATALOG='dhub-sales-revenue' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-staging' schema='rl_sales_revenue' server-oauth='' username='dilys.ong@foodpanda.com' workgroup-auth-mode='prompt' />
