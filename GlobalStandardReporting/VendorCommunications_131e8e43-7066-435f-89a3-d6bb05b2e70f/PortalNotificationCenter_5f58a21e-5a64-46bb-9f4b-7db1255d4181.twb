      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Entity Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand&quot;'>
          <calculation class='tableau' formula='&quot;Brand&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_4E02363F50D14BD8B8842F028CF7DD46'>
            <properties context=''>
              <relation connection='bigquery.0tsry0e1rme5y21h381541v8y5h5' name='Custom SQL Query' type='text'><![CDATA[WITH 
entity AS (
    SELECT 
        management_entity
        ,segment
        ,global_entity_id
        ,brand
        ,country_name
    FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities`
)
,sessions AS (
    SELECT 
    fielddate
    ,user_id
    ,session_id
    ,info.global_entity_id
    ,COUNT(*) ct
    FROM dhh-ncr-live.dbt_sales_revenue_report.vp_sessions
    LEFT JOIN UNNEST(vendors_info) info
    WHERE fielddate >>= '2023-02-02'
    AND fielddate >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),QUARTER),INTERVAL 5 QUARTER) 
    AND fielddate <<= CURRENT_DATE()
    AND user_id IS NOT NULL
    AND device_platform = 'WEB'
    GROUP BY 1,2,3,4
)
,notifications AS (
    SELECT 
    fielddate
    ,session_id
    ,section
    ,event_name
    ,TRUE notification_flag
    ,COUNT(*) ct
     FROM dhh-ncr-live.dbt_sales_revenue_report.vp_events
    WHERE fielddate >>= '2023-02-02'
    AND fielddate >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),QUARTER),INTERVAL 5 QUARTER)
    AND fielddate <<= CURRENT_DATE()
    AND user_id IS NOT NULL
    AND REGEXP_CONTAINS(section,'notifications.main')
    AND event_name = 'page_load'
    AND device_platform = 'WEB'
    GROUP BY 1,2,3,4,5
) 
,raw AS (
    SELECT 
    sessions.fielddate
    ,sessions.user_id
    ,sessions.session_id
    ,sessions.global_entity_id
    ,COALESCE(notification_flag,FALSE) notification_flag 
    FROM sessions 
    LEFT JOIN notifications 
    ON sessions.session_id = notifications.session_id
) 
,daily AS (
    SELECT 
    'day' time_granularity
    ,FORMAT_DATE('%Y%m%d',fielddate) time_period
    ,global_entity_id
    ,MAX(fielddate) max_date
    ,COUNT(DISTINCT user_id) users
    ,COUNT(DISTINCT session_id) sessions
    ,COUNT(DISTINCT CASE WHEN notification_flag IS TRUE THEN user_id END) notification_users
    ,COUNT(DISTINCT CASE WHEN notification_flag IS TRUE THEN session_id END) notification_sessions
    ,COUNT(DISTINCT CASE WHEN notification_flag IS TRUE THEN CONCAT(fielddate,user_id) END) daily_notification_users_sum
    ,COUNT(DISTINCT CASE WHEN notification_flag IS TRUE THEN CONCAT(user_id,session_id) END) notification_user_sessions_sum
    FROM raw
    WHERE fielddate >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),QUARTER),INTERVAL 5 QUARTER) 
    GROUP BY 1,2,3
    )
,weekly AS (
    SELECT 
    'week' time_granularity
    ,FORMAT_DATE('%Y-W%W',DATE_TRUNC(fielddate,WEEK(MONDAY))) time_period
    ,global_entity_id
    ,MAX(fielddate) max_date
    ,COUNT(DISTINCT user_id) users
    ,COUNT(DISTINCT session_id) sessions
    ,COUNT(DISTINCT CASE WHEN notification_flag IS TRUE THEN user_id END) notification_users
    ,COUNT(DISTINCT CASE WHEN notification_flag IS TRUE THEN session_id END) notification_sessions
    ,COUNT(DISTINCT CASE WHEN notification_flag IS TRUE THEN CONCAT(fielddate,user_id) END) daily_notification_users_sum
    ,COUNT(DISTINCT CASE WHEN notification_flag IS TRUE THEN CONCAT(user_id,session_id) END) notification_user_sessions_sum
    FROM raw
    WHERE fielddate >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),WEEK(MONDAY)),INTERVAL 11 WEEK) 
    GROUP BY 1,2,3
    )
,monthly AS (
    SELECT 
    'month' time_granularity
    ,FORMAT_DATE('%Y-%m',DATE_TRUNC(fielddate,MONTH)) time_period
    ,global_entity_id
    ,MAX(fielddate) max_date
    ,COUNT(DISTINCT user_id) users
    ,COUNT(DISTINCT session_id) sessions
    ,COUNT(DISTINCT CASE WHEN notification_flag IS TRUE THEN user_id END) notification_users
    ,COUNT(DISTINCT CASE WHEN notification_flag IS TRUE THEN session_id END) notification_sessions
    ,COUNT(DISTINCT CASE WHEN notification_flag IS TRUE THEN CONCAT(fielddate,user_id) END) daily_notification_users_sum
    ,COUNT(DISTINCT CASE WHEN notification_flag IS TRUE THEN CONCAT(user_id,session_id) END) notification_user_sessions_sum
    FROM raw
    WHERE fielddate >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),MONTH),INTERVAL 5 MONTH) 
    GROUP BY 1,2,3
    )
,quarterly AS (
    SELECT 
    'quarter' time_granularity
    ,FORMAT_DATE('%Y-Q%Q',DATE_TRUNC(fielddate,QUARTER)) time_period
    ,global_entity_id
    ,MAX(fielddate) max_date
    ,COUNT(DISTINCT user_id) users
    ,COUNT(DISTINCT session_id) sessions
    ,COUNT(DISTINCT CASE WHEN notification_flag IS TRUE THEN user_id END) notification_users
    ,COUNT(DISTINCT CASE WHEN notification_flag IS TRUE THEN session_id END) notification_sessions
    ,COUNT(DISTINCT CASE WHEN notification_flag IS TRUE THEN CONCAT(fielddate,user_id) END) daily_notification_users_sum
    ,COUNT(DISTINCT CASE WHEN notification_flag IS TRUE THEN CONCAT(user_id,session_id) END) notification_user_sessions_sum
    FROM raw
    WHERE fielddate >>= DATE_SUB(DATE_TRUNC(CURRENT_DATE(),QUARTER),INTERVAL 5 QUARTER) 
    GROUP BY 1,2,3
    )


SELECT 
agg.time_granularity
,agg.time_period
,agg.max_date
,entity.management_entity
,entity.segment
,entity.global_entity_id
,entity.brand
,entity.country_name
,agg.users
,agg.sessions
,agg.notification_users
,agg.notification_sessions
,agg.daily_notification_users_sum
,agg.notification_user_sessions_sum
FROM (
  SELECT * FROM daily 
  UNION ALL
  SELECT * FROM weekly
  UNION ALL 
  SELECT * FROM monthly
  UNION ALL 
  SELECT * FROM quarterly
  ) agg
JOIN entity
ON agg.global_entity_id = entity.global_entity_id]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
