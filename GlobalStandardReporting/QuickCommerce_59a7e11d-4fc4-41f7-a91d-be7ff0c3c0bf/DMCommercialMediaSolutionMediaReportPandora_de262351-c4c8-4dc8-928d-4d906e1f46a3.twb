      <column caption='Top 5' datatype='boolean' name='[Calculation_126241552637677568]' role='measure' type='nominal'>
        <calculation class='tableau' formula='index()&lt;=5'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='M: # Campaigns' datatype='integer' name='[Calculation_126241552836804609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([banner_name (group)])' />
      </column>
      <column caption='Metrics A' datatype='integer' name='[Calculation_126241552838696963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Impressions&apos; THEN SUM([Calculation_2975049784777113603])&#10;WHEN &apos;Banner Clicks&apos; THEN SUM([Users: Banner Shown (copy)_2975049784777752580])&#10;WHEN &apos;ATC Sessions&apos; THEN SUM([Users: Banner Clicked (copy)_2975049784779149317])&#10;WHEN &apos;ATC Clicks&apos; THEN SUM([M: ATC Clicks (copy)_6717541080015101952])&#10;&#10;END' />
      </column>
      <column caption='STR: Product Clicks' datatype='integer' name='[Calculation_126241552843988998]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2975049784774819840]' />
      </column>
      <column caption='M: Product Clicks' datatype='integer' name='[Calculation_2975049784774819840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([atc_hits]) + SUM([pc_opened_hits])' />
      </column>
      <column caption='M: Banner CTR' datatype='real' name='[Calculation_2975049784775577601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Users: Banner Shown (copy)_2975049784777752580])/SUM([Calculation_2975049784777113603])' />
      </column>
      <column caption='M: Banner Impressions' datatype='integer' name='[Calculation_2975049784777113603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [partition_date],[country], [global_entity_id], brand, [platform], [banner_name]: MAX([bnr_shown_sessions])}' />
      </column>
      <column caption='M: Banner Conversion' datatype='real' name='[Calculation_2975049784780136455]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Users: ATC (copy)_2975049784779329542])/SUM([Users: Banner Shown (copy)_2975049784777752580])' />
      </column>
      <column caption='M: Sales Value' datatype='real' name='[Calculation_4145352370194120707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_price_paid_eur]' />
      </column>
      <column caption='M: ATC Clicks' datatype='integer' name='[M: ATC Clicks (copy)_6717541080015101952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[atc_hits]' />
      </column>
      <column caption='M: Banner ATCR' datatype='real' name='[Metric: CTR (copy)_2975049784775876610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Users: Banner Clicked (copy)_2975049784779149317])/SUM([Users: Banner Shown (copy)_2975049784777752580])' />
      </column>
      <column caption='Metrics B' datatype='real' name='[Metrics A (copy)_126241552839012356]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Metrics A (copy)_126241552838516738]&#10;WHEN &apos;Conversions&apos; THEN SUM([Users: ATC (copy)_2975049784779329542])&#10;WHEN &apos;Units Sold&apos; THEN SUM([qty_sold])&#10;WHEN &apos;Total Sales&apos; THEN SUM([Calculation_4145352370194120707])&#10;END' />
      </column>
      <column caption='STR: Total Sales' datatype='real' name='[STR: Product Clicks (copy)_126241552846069767]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4145352370194120707])' />
