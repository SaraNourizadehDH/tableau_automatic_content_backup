    <worksheet name='CAT_Activity'>
      <table>
        <view>
          <datasources>
            <datasource caption='qc_nmr_rl_pandora_category (cl_adtech)' name='federated.1by75vl1s0poqc1chv0tv07mm7qr' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Total Sales (€)' caption='Metrics B' datatype='string' name='[Metrics A (copy)_126241552838516738]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total Sales&quot;'>
              <calculation class='tableau' formula='&quot;Total Sales&quot;' />
              <aliases>
                <alias key='&quot;Conversions&quot;' value='Conversion Sessions' />
                <alias key='&quot;Total Sales&quot;' value='Total Sales (€)' />
              </aliases>
            </column>
            <column caption='Metrics A 2' datatype='string' name='[Parameter 1 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;ATC Clicks&quot;'>
              <calculation class='tableau' formula='&quot;ATC Clicks&quot;' />
              <aliases>
                <alias key='&quot;Banner Clicks&quot;' value='Clicked Sessions' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1by75vl1s0poqc1chv0tv07mm7qr'>
            <column caption='Metrics A 2' datatype='integer' name='[Calculation_126241552838696963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 2]&#10;WHEN &apos;Banner Clicks&apos; THEN SUM([Users: Banner Shown (copy)_2975049784777752580])&#10;WHEN &apos;ATC Sessions&apos; THEN SUM([Users: Banner Clicked (copy)_2975049784779149317])&#10;WHEN &apos;ATC Clicks&apos; THEN SUM([M: ATC Clicks (copy)_6717541080015101952])&#10;&#10;END' />
            </column>
            <column caption='M: Sales Value' datatype='real' name='[Calculation_4145352370194120707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_price_listed_eur]' />
            </column>
            <column caption='M: ATC Clicks' datatype='integer' name='[M: ATC Clicks (copy)_6717541080015101952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[atc_hits]' />
            </column>
            <column caption='Metrics B' datatype='real' name='[Metrics A (copy)_126241552839012356]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Metrics A (copy)_126241552838516738]&#10;WHEN &apos;Conversions&apos; THEN SUM([Users: ATC (copy)_2975049784779329542])&#10;WHEN &apos;Units Sold&apos; THEN SUM([qty_sold])&#10;WHEN &apos;Total Sales&apos; THEN SUM([Calculation_4145352370194120707])&#10;END' />
            </column>
            <column caption='M: Category Sold' datatype='integer' name='[Users: ATC (copy)_2975049784779329542]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [partition_date],[country], [global_entity_id], brand, [platform], [category_name]: MAX([cat_sold_sessions])}' />
            </column>
            <column caption='M: Category ATC' datatype='integer' name='[Users: Banner Clicked (copy)_2975049784779149317]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [partition_date],[country], [global_entity_id], brand, [platform], [category_name]: MAX([cat_atc_sessions])}' />
            </column>
            <column caption='M: Category Clicked Sessions' datatype='integer' name='[Users: Banner Shown (copy)_2975049784777752580]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [partition_date],[country], [global_entity_id], brand, [platform], [category_name]: MAX([cat_interaction_session])}' />
            </column>
