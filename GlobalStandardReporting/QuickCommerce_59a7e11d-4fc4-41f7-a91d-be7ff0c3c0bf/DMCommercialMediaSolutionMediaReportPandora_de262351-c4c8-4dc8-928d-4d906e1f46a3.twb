      <column caption='M: Units Sold, Summary' datatype='real' name='[M: Sales Value, Summary (copy)_2080240850099220480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([qty_sold]) &gt;= 1000000000 THEN ROUND(SUM([qty_sold]) / 1000000000,1)&#10;ELSEIF SUM([qty_sold]) &gt;= 1000000 THEN ROUND(SUM([qty_sold]) / 1000000,1)&#10;ELSEIF SUM([qty_sold]) &gt;= 1000 THEN ROUND(SUM([qty_sold]) / 1000,1)&#10;ELSE ROUND(SUM([qty_sold]), 0)&#10;END' />
