      <column caption='Top 5' datatype='boolean' name='[Calculation_126241552637677568]' role='measure' type='nominal'>
        <calculation class='tableau' formula='index()&lt;=5'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='M: # Campaigns' datatype='integer' name='[Calculation_126241552836804609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([category_name])' />
      </column>
      <column caption='Metrics A 2' datatype='integer' name='[Calculation_126241552838696963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 2]&#10;WHEN &apos;Banner Clicks&apos; THEN SUM([Users: Banner Shown (copy)_2975049784777752580])&#10;WHEN &apos;ATC Sessions&apos; THEN SUM([Users: Banner Clicked (copy)_2975049784779149317])&#10;WHEN &apos;ATC Clicks&apos; THEN SUM([M: ATC Clicks (copy)_6717541080015101952])&#10;&#10;END' />
      </column>
      <column caption='STR: Product Clicks' datatype='integer' name='[Calculation_126241552843988998]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2975049784774819840]' />
      </column>
      <column caption='LOD: Category Clicks' datatype='integer' name='[Calculation_154529801898360832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [partition_date], [brand],[platform],[global_entity_id], [country], [category_name]: MAX([cat_clicked_hits])}' />
      </column>
      <column caption='M: Product Clicks' datatype='integer' name='[Calculation_2975049784774819840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([atc_hits]) + SUM([pc_opened_hits])' />
      </column>
      <column caption='M: Category Clicks' datatype='real' name='[Calculation_3362640840073269248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_154529801898360832]) &gt;= 1000000000 THEN ROUND(SUM([Calculation_154529801898360832]) / 1000000000,1)&#10;ELSEIF SUM([Calculation_154529801898360832]) &gt;= 1000000 THEN ROUND(SUM([Calculation_154529801898360832]) / 1000000,1)&#10;ELSEIF SUM([Calculation_154529801898360832]) &gt;= 1000 THEN ROUND(SUM([Calculation_154529801898360832]) / 1000,1)&#10;ELSE ROUND(SUM([Calculation_154529801898360832]), 0)&#10;END' />
      </column>
      <column caption='STR: Category Clicks' datatype='string' name='[Calculation_3362640840073433089]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_154529801898360832]) &gt;= 1000000000 THEN &quot;B&quot;&#10;ELSEIF SUM([Calculation_154529801898360832]) &gt;= 1000000 THEN &quot;M&quot;&#10;ELSEIF SUM([Calculation_154529801898360832]) &gt;= 1000 THEN &quot;k&quot;&#10;ELSE &quot;&quot;&#10;END' />
      </column>
      <column caption='M: Sales Value, Summary' datatype='real' name='[Calculation_3362640840073793538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([total_price_listed_eur]) &gt;= 1000000000 THEN ROUND(SUM([total_price_listed_eur]) / 1000000000,1)&#10;ELSEIF SUM([total_price_listed_eur]) &gt;= 1000000 THEN ROUND(SUM([total_price_listed_eur]) / 1000000,1)&#10;ELSEIF SUM([total_price_listed_eur]) &gt;= 1000 THEN ROUND(SUM([total_price_listed_eur]) / 1000,1)&#10;ELSE ROUND(SUM([total_price_listed_eur]), 0)&#10;END' />
      </column>
      <column caption='STR: Sales Value, Summary' datatype='string' name='[Calculation_3362640840073940995]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([total_price_listed_eur]) &gt;= 1000000000 THEN &quot;B&quot;&#10;ELSEIF SUM([total_price_listed_eur]) &gt;= 1000000 THEN &quot;M&quot;&#10;ELSEIF SUM([total_price_listed_eur]) &gt;= 1000 THEN &quot;k&quot;&#10;ELSE &quot;&quot;&#10;END' />
