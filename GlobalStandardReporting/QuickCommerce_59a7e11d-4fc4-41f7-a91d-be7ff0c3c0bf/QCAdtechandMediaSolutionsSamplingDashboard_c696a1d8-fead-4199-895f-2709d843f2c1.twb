  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Introduction'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='28'>INTRODUCTION</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/Sampling_Dashboard_v1/Introduction?rev=' id='Introduction' path='/t/GlobalStandardReporting/workbooks/Sampling_Dashboard_v1' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#00000000' />
        </style-rule>
        <style-rule element='dash-title'>
          <format attr='background-color' value='#b82125' />
        </style-rule>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_10' value='top' />
          <format attr='vertical-align' id='dash-text_8' value='bottom' />
          <format attr='vertical-align' id='dash-text_9' value='bottom' />
        </style-rule>
      </style>
      <size maxheight='700' maxwidth='1000' minheight='700' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97714' id='5' param='vert' type-v2='layout-flow' w='98400' x='800' y='1143'>
            <zone fixed-size='66' h='10572' id='7' is-fixed='true' type-v2='title' w='98400' x='800' y='1143'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='87142' id='6' type-v2='layout-basic' w='98400' x='800' y='11715'>
              <zone forceUpdate='true' h='35407' id='8' type-v2='text' w='98400' x='800' y='11715'>
                <formatted-text>
                  <run fontcolor='#000000' fontsize='12'>This dashboard provides a complete overview of Sampling Campaigns launched by our Quick Commerce teams via the Promo Tool.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#000000' fontsize='12'>It is divided into 2 separate tabs …</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='12'>  1. </run>
                  <run bold='true' fontcolor='#000000' fontsize='12'>Sampling Overview</run>
                  <run fontcolor='#000000' fontsize='12'>: An overview of a country, also known as entity</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='12'>  2. </run>
                  <run bold='true' fontcolor='#000000' fontsize='12'>Sampling Campaign Analysis</run>
                  <run fontcolor='#000000' fontsize='12'>: Deepdive into customer data for a single sampling campaign</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#000000' fontsize='12'>To know more about this project’s background, please refer to our confluence page.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#606b76' fontsize='12'>Æ </run>
                  <run auto-url='true' fontcolor='#606b76' fontsize='12' hyperlink='tabdoc:load-url url=&amp;quot;https://confluence.deliveryhero.com/pages/viewpage.action?pageId=520436702&amp;quot;'>https://confluence.deliveryhero.com/pages/viewpage.action?pageId=520436702</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='17307' id='9' type-v2='text' w='98400' x='800' y='47122'>
                <formatted-text>
                  <run bold='true' fontcolor='#b82125' fontsize='22'>Definitions</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='34428' id='10' type-v2='text' w='98400' x='800' y='64429'>
                <formatted-text>
                  <run fontcolor='#606b76' fontsize='12'>‣ </run>
                  <run bold='true' fontcolor='#606b76' fontsize='12'>Unique Users : </run>
                  <run fontcolor='#606b76' fontsize='12'># Distinct count of customers who recieved the sample during the campaign period.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#606b76' fontsize='12'>‣ </run>
                  <run bold='true' fontcolor='#606b76' fontsize='12'>Samples Delivered : </run>
                  <run fontcolor='#606b76' fontsize='12'># Total quantity of sample items delivered.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#606b76' fontsize='12'>‣ </run>
                  <run bold='true' fontcolor='#606b76' fontsize='12'>Orders with Sample : </run>
                  <run fontcolor='#606b76' fontsize='12'># Total orders which had a sample item.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#606b76' fontsize='12'>‣ </run>
                  <run bold='true' fontcolor='#606b76' fontsize='12'>Pre and Post Performance  : </run>
                  <run fontcolor='#606b76' fontsize='12'># Gives the attributed sales/orders/quantity of the brand and category to which the sample product belonged to.</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#b82125' fontsize='12' italic='true'>The attribution logic - Includes only customers who received the sample. If the customer purchases a product that belongs to the same brand or  category as the product in the Sampling Campaign within the 7day or 14 day timeframe before/after they have received the Sample then the purchase is attributed to that campaign.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <layout-options>
            <title>
              <formatted-text>
                <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='28'>INTRODUCTION</run>
              </formatted-text>
            </title>
          </layout-options>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='86' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='85' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone fixed-size='66' h='10572' id='7' type-v2='title' w='98400' x='800' y='1143'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='35407' id='8' type-v2='text' w='98400' x='800' y='11715'>
                  <formatted-text>
                    <run fontcolor='#000000' fontsize='12'>This dashboard provides a complete overview of Sampling Campaigns launched by our Quick Commerce teams via the Promo Tool.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>It is divided into 2 separate tabs …</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>  1. </run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Sampling Overview</run>
                    <run fontcolor='#000000' fontsize='12'>: An overview of a country, also known as entity</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>  2. </run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Sampling Campaign Analysis</run>
                    <run fontcolor='#000000' fontsize='12'>: Deepdive into customer data for a single sampling campaign</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='12'>To know more about this project’s background, please refer to our confluence page.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#606b76' fontsize='12'>Æ </run>
                    <run auto-url='true' fontcolor='#606b76' fontsize='12' hyperlink='tabdoc:load-url url=&amp;quot;https://confluence.deliveryhero.com/pages/viewpage.action?pageId=520436702&amp;quot;'>https://confluence.deliveryhero.com/pages/viewpage.action?pageId=520436702</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='17307' id='9' type-v2='text' w='98400' x='800' y='47122'>
                  <formatted-text>
                    <run bold='true' fontcolor='#b82125' fontsize='22'>Definitions</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='34428' id='10' type-v2='text' w='98400' x='800' y='64429'>
                  <formatted-text>
                    <run fontcolor='#606b76' fontsize='12'>‣ </run>
                    <run bold='true' fontcolor='#606b76' fontsize='12'>Unique Users : </run>
                    <run fontcolor='#606b76' fontsize='12'># Distinct count of customers who recieved the sample during the campaign period.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#606b76' fontsize='12'>‣ </run>
                    <run bold='true' fontcolor='#606b76' fontsize='12'>Samples Delivered : </run>
                    <run fontcolor='#606b76' fontsize='12'># Total quantity of sample items delivered.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#606b76' fontsize='12'>‣ </run>
                    <run bold='true' fontcolor='#606b76' fontsize='12'>Orders with Sample : </run>
                    <run fontcolor='#606b76' fontsize='12'># Total orders which had a sample item.</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#606b76' fontsize='12'>‣ </run>
                    <run bold='true' fontcolor='#606b76' fontsize='12'>Pre and Post Performance  : </run>
                    <run fontcolor='#606b76' fontsize='12'># Gives the attributed sales/orders/quantity of the brand and category to which the sample product belonged to.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#b82125' fontsize='12' italic='true'>The attribution logic - Includes only customers who received the sample. If the customer purchases a product that belongs to the same brand or  category as the product in the Sampling Campaign within the 7day or 14 day timeframe before/after they have received the Sample then the purchase is attributed to that campaign.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
