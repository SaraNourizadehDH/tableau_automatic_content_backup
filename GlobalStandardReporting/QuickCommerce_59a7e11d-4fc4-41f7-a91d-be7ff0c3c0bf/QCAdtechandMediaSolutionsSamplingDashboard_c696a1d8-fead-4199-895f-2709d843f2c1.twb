        <calculation class='tableau' formula='IF &#10; [Parameters].[Parameter 2] = &quot;7 Days&quot; &#10;   THEN (&#10;          IF &#10;            [Parameters].[Parameter 3] = &quot;Order count&quot; THEN { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([post_campaign_7_days_brand_orders])}&#10;       ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Qty Ordered&quot; THEN  { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([post_campaign_7_days_brand_qty_ordered])}&#10;        ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Sales&quot; THEN  { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([post_campaign_7_days_brand_total_sales_euro])}  &#10;    END&#10;        )&#10;ELSEIF &#10; [Parameters].[Parameter 2] = &quot;14 Days&quot;&#10;   THEN (&#10;         IF [Parameters].[Parameter 3] = &quot;Order count&quot; THEN { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([post_campaign_14_days_brand_orders])}&#10;        ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Qty Ordered&quot; THEN { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([post_campaign_14_days_brand_qty_ordered])}&#10;        ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Sales&quot; THEN  { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([post_campaign_14_days_brand_total_sales_euro])}&#10;        END&#10;        )&#10; ELSEIF &#10; [Parameters].[Parameter 2] = &quot;30 Days&quot;&#10;   THEN (&#10;         IF [Parameters].[Parameter 3] = &quot;Order count&quot; THEN { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([post_campaign_30_days_brand_orders])}&#10;        ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Qty Ordered&quot; THEN { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([post_campaign_30_days_brand_qty_ordered])}&#10;        ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Sales&quot; THEN  { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([post_campaign_30_days_brand_total_sales_euro])}&#10;        END&#10;        )&#10;END' />
      </column>
      <column caption='Brand (Pre)' datatype='real' name='[Calculation_4286371331553308672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10; [Parameters].[Parameter 2] = &quot;7 Days&quot; &#10;   THEN (&#10;          IF &#10;            [Parameters].[Parameter 3] = &quot;Order count&quot; THEN { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([pre_campaign_7_days_brand_orders])}&#10;       ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Qty Ordered&quot; THEN  { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([pre_campaign_7_days_brand_qty_ordered])}&#10;                 ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Sales&quot; THEN  { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([pre_campaign_7_days_brand_total_sales_euro])}&#10;END&#10;        )&#10;ELSEIF &#10; [Parameters].[Parameter 2] = &quot;14 Days&quot;&#10;   THEN (&#10;         IF [Parameters].[Parameter 3] = &quot;Order count&quot; THEN { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([pre_campaign_14_days_brand_orders])}&#10;        ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Qty Ordered&quot; THEN { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([pre_campaign_14_days_brand_qty_ordered])}&#10;           ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Sales&quot; THEN  { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([pre_campaign_14_days_brand_total_sales_euro])}     &#10;END&#10;        )&#10;  ELSEIF &#10; [Parameters].[Parameter 2] = &quot;30 Days&quot;&#10;   THEN (&#10;         IF [Parameters].[Parameter 3] = &quot;Order count&quot; THEN { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([pre_campaign_30_days_brand_orders])}&#10;        ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Qty Ordered&quot; THEN { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([pre_campaign_30_days_brand_qty_ordered])}&#10;           ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Sales&quot; THEN  { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([pre_campaign_30_days_brand_total_sales_euro])}     &#10;END&#10;        )&#10;END' />
      </column>
      <column caption='Days post campaign' datatype='string' name='[Calculation_6245718645442207745]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;   TODAY() &lt;= DATE([end_time]) THEN &quot;Campaign Period is incomplete&quot;&#10;ELSEIF &#10; [Parameters].[Parameter 2] = &quot;7 Days&quot; &#10;   THEN (&#10;          IF &#10;           DATEDIFF(&quot;day&quot;, DATE([end_time]), TODAY()) &gt;= 7 THEN &quot; 7 Day Post campaign period complete&quot; &#10;            ELSE &quot;7 Day Post campaign period Incomplete&quot;&#10;         END&#10;        )&#10;ELSEIF &#10; [Parameters].[Parameter 2] = &quot;14 Days&quot;&#10;   THEN (&#10;          IF &#10;           DATEDIFF(&quot;day&quot;, [end_time],TODAY()) &gt;= 14 THEN &quot; 14 Day Post campaign period complete&quot; &#10;            ELSE &quot;14 Day Post campaign period Incomplete&quot;&#10;         END&#10;        )&#10; ELSEIF &#10; [Parameters].[Parameter 2] = &quot;30 Days&quot;&#10;   THEN (&#10;          IF &#10;           DATEDIFF(&quot;day&quot;, [end_time],TODAY()) &gt;= 30 THEN &quot; 30 Day Post campaign period complete&quot; &#10;            ELSE &quot;30 Day Post campaign period Incomplete&quot;&#10;         END&#10;        )&#10;END' />
      </column>
      <column caption='Order_count' datatype='integer' name='[Calculation_725783237109932032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Metric' datatype='real' name='[Calculation_725783238520926213]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#10;    [Parameters].[Parameter 1] = &apos;Unique Users&apos; &#10;        THEN COUNTD([analytical_customer_id])&#10;ELSEIF &#10;    [Parameters].[Parameter 1] = &apos;Samples Delivered&apos; &#10;        THEN SUM([qty_sold])&#10;ELSEIF &#10;    [Parameters].[Parameter 1] = &apos;Orders with Sample&apos; &#10;        THEN COUNTD([order_id])&#10;END' />
      </column>
