              <calculation class='tableau' formula='IF &#10; [Parameters].[Parameter 2] = &quot;7 Days&quot; &#10;   THEN (&#10;          IF &#10;            [Parameters].[Parameter 3] = &quot;Order count&quot; THEN { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([pre_campaign_7_days_category_orders])}&#10;       ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Qty Ordered&quot; THEN  { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([pre_campaign_7_days_category_qty_ordered])}&#10;       ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Sales&quot; THEN  { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([pre_campaign_7_days_category_total_sales_euro])}&#10;       END&#10;        )&#10;ELSEIF &#10; [Parameters].[Parameter 2] = &quot;14 Days&quot;&#10;   THEN (&#10;         IF [Parameters].[Parameter 3] = &quot;Order count&quot; THEN { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([pre_campaign_14_days_category_orders])}&#10;        ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Qty Ordered&quot; THEN { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([pre_campaign_14_days_category_qty_ordered])}&#10;       ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Sales&quot; THEN  { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([pre_campaign_14_days_category_total_sales_euro])}&#10;       END&#10;        )&#10;   ELSEIF &#10; [Parameters].[Parameter 2] = &quot;30 Days&quot;&#10;   THEN (&#10;         IF [Parameters].[Parameter 3] = &quot;Order count&quot; THEN { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([pre_campaign_30_days_category_orders])}&#10;        ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Qty Ordered&quot; THEN { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([pre_campaign_30_days_category_qty_ordered])}&#10;       ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Sales&quot; THEN  { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([pre_campaign_30_days_category_total_sales_euro])}&#10;       END&#10;        )&#10;END' />
            </column>
            <column caption='Category (Post)' datatype='real' name='[Category (Pre) (copy)_4286371331555389443]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10; [Parameters].[Parameter 2] = &quot;7 Days&quot; &#10;   THEN (&#10;          IF &#10;            [Parameters].[Parameter 3] = &quot;Order count&quot; THEN { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([post_campaign_7_days_category_orders])}&#10;       ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Qty Ordered&quot; THEN  { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([post_campaign_7_days_category_qty_ordered])}&#10;       ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Sales&quot; THEN  { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([post_campaign_7_days_category_total_sales_euro])}&#10;       END&#10;        )&#10;ELSEIF &#10; [Parameters].[Parameter 2] = &quot;14 Days&quot;&#10;   THEN (&#10;         IF [Parameters].[Parameter 3] = &quot;Order count&quot; THEN { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([post_campaign_14_days_category_orders])}&#10;        ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Qty Ordered&quot; THEN { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([post_campaign_14_days_category_qty_ordered])}&#10;       ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Sales&quot; THEN  { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([post_campaign_14_days_category_total_sales_euro])}&#10;       END&#10;        )&#10; ELSEIF &#10; [Parameters].[Parameter 2] = &quot;30 Days&quot;&#10;   THEN (&#10;         IF [Parameters].[Parameter 3] = &quot;Order count&quot; THEN { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([post_campaign_30_days_category_orders])}&#10;        ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Qty Ordered&quot; THEN { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([post_campaign_30_days_category_qty_ordered])}&#10;       ELSEIF &#10;            [Parameters].[Parameter 3] = &quot;Sales&quot; THEN  { FIXED [analytical_customer_id],[brand_name],[partition_date]: SUM([post_campaign_30_days_category_total_sales_euro])}&#10;       END&#10;        )&#10;END' />
