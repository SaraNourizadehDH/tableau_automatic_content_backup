          <datasource-dependencies datasource='federated.1bhun870118hkv134ki39124sie7'>
            <column caption='Metric' datatype='real' name='[Calculation_725783238520926213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#10;    [Parameters].[Parameter 1] = &apos;Unique Users&apos; &#10;        THEN COUNTD([analytical_customer_id])&#10;ELSEIF &#10;    [Parameters].[Parameter 1] = &apos;Samples Delivered&apos; &#10;        THEN SUM([qty_sold])&#10;ELSEIF &#10;    [Parameters].[Parameter 1] = &apos;Orders with Sample&apos; &#10;        THEN COUNTD([order_id])&#10;END' />
