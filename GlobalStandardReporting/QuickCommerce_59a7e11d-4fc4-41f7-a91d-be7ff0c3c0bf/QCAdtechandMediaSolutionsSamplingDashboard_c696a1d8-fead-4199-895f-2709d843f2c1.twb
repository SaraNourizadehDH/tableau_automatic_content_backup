    <worksheet name='Days post campaign'>
      <table>
        <view>
          <datasources>
            <datasource caption='qc_non_sellable_sampling (cl_adtech)' name='federated.1bhun870118hkv134ki39124sie7' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Timeframe' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;30 Days&quot;'>
              <calculation class='tableau' formula='&quot;30 Days&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1bhun870118hkv134ki39124sie7'>
            <column caption='Days post campaign' datatype='string' name='[Calculation_6245718645442207745]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;   TODAY() &lt;= DATE([end_time]) THEN &quot;Campaign Period is incomplete&quot;&#10;ELSEIF &#10; [Parameters].[Parameter 2] = &quot;7 Days&quot; &#10;   THEN (&#10;          IF &#10;           DATEDIFF(&quot;day&quot;, DATE([end_time]), TODAY()) &gt;= 7 THEN &quot; 7 Day Post campaign period complete&quot; &#10;            ELSE &quot;7 Day Post campaign period Incomplete&quot;&#10;         END&#10;        )&#10;ELSEIF &#10; [Parameters].[Parameter 2] = &quot;14 Days&quot;&#10;   THEN (&#10;          IF &#10;           DATEDIFF(&quot;day&quot;, [end_time],TODAY()) &gt;= 14 THEN &quot; 14 Day Post campaign period complete&quot; &#10;            ELSE &quot;14 Day Post campaign period Incomplete&quot;&#10;         END&#10;        )&#10; ELSEIF &#10; [Parameters].[Parameter 2] = &quot;30 Days&quot;&#10;   THEN (&#10;          IF &#10;           DATEDIFF(&quot;day&quot;, [end_time],TODAY()) &gt;= 30 THEN &quot; 30 Day Post campaign period complete&quot; &#10;            ELSE &quot;30 Day Post campaign period Incomplete&quot;&#10;         END&#10;        )&#10;END' />
            </column>
            <column caption='Campaign Id' datatype='string' name='[campaign_id]' role='dimension' type='nominal' />
            <column caption='Campaign Name' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
            <column caption='End Time' datatype='datetime' name='[end_time]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_6245718645442207745]' derivation='None' name='[none:Calculation_6245718645442207745:nk]' pivot='key' type='nominal' />
            <column-instance column='[campaign_id]' derivation='None' name='[none:campaign_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[campaign_name]' derivation='None' name='[none:campaign_name:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1bhun870118hkv134ki39124sie7].[none:campaign_id:nk]' filter-group='6'>
            <groupfilter function='member' level='[none:campaign_id:nk]' member='&quot;4dd4f8c8-c48f-4ba4-8fe9-688448cc17b9&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
