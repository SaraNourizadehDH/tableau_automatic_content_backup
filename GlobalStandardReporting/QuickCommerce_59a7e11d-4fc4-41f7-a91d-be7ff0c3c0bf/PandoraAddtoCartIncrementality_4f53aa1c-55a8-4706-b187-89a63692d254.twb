    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Introduction'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#b82125'>Introduction</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/Pandora-AddtoCart-Incrementality/Introduction?rev=' id='Introduction' path='/t/GlobalStandardReporting/workbooks/Pandora-AddtoCart-Incrementality' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98000' id='5' param='vert' type-v2='layout-flow' w='98400' x='800' y='1000'>
            <zone h='5125' id='7' type-v2='title' w='98400' x='800' y='1000'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='92875' id='6' type-v2='layout-basic' w='98400' x='800' y='6125'>
              <zone forceUpdate='true' h='84613' id='8' type-v2='text' w='98400' x='800' y='6125'>
                <formatted-text>
                  <run>Æ&#10;&#10;&#10;</run>
                  <run fontcolor='#000000' fontsize='12'>This dashboard provides a complete overview of Asset level Add to cart coming via perseus.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#b82125' fontsize='12'>Details and Assumptions</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#000000' fontsize='12'>&gt; Add to cart in the dashboard includes  </run>
                  <run bold='true' fontcolor='#000000' fontsize='12' italic='true'>Add_to cart_clicks.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='12' italic='true'>&gt; </run>
                  <run fontcolor='#000000' fontsize='12'>The data is at the product SKU level.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#000000' fontsize='12'>&gt; Please use the date aggreagtion filter to change the timeframe (daily, weekly, monthy...)</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#1b1b1b' fontsize='12'>&gt; Campaign orders include both Brand and Promotional campaigns. This is a temporary fix to account for Banner Campaign information which is currently unavailable due to tracking issues on perseus.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#1b1b1b' fontsize='12'>&gt; Swimlanes include both organic and promoted swimlanes. </run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#1b1b1b' fontsize='12'>&gt; Product ads are calculated based on the availability of nmr_ad_id , it includes both Search and display ads.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#1b1b1b' fontsize='12'>&gt; Local shops data is currently not a part of this project.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#1b1b1b' fontsize='12'>&gt; Availibilty is calculated based on the standardised definition by the operations team </run>
                  <run auto-url='true' fontcolor='#1b1b1b' fontsize='12' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/presentation/d/1qgu-31yIqzqxxnvXBaDJR4Ozpmz5egy8y71f-RFCNn4/edit#slide=id.g25ec3760f57_2_151&amp;quot;'>https://docs.google.com/presentation/d/1qgu-31yIqzqxxnvXBaDJR4Ozpmz5egy8y71f-RFCNn4/edit#slide=id.g25ec3760f57_2_151</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#1b1b1b' fontsize='12'>For further updates please follow the </run>
                  <run bold='true' fontcolor='#1b1b1b' fontsize='12' italic='true'>qc_nmr_incrementality</run>
                  <run fontcolor='#1b1b1b' fontsize='12'> channel on Slack</run>
                  <run>Æ&#10;&#10;&#10;&#10;&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='8262' id='9' type-v2='text' w='98400' x='800' y='90738'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
