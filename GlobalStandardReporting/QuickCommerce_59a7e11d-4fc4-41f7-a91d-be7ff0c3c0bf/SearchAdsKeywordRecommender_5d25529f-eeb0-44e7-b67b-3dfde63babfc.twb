      <aliases enabled='yes' />
      <column caption='Group Search Term Score' datatype='real' name='[Calculation_2219500572149923840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.75  * &#10;(0.5 * SUM([scaled_impression_l7d]) &#10; + 0.3 *  SUM([scaled_impression_l30d])&#10; + 0.2 * SUM([scaled_impression_l365d]))&#10; + &#10;0.25  *  &#10;  (0.5 * SUM([scaled_ctr_l7d])&#10; + 0.3*  SUM([scaled_ctr_l30d])&#10; + 0.2 * SUM([scaled_ctr_l365d]))' />
      </column>
      <column caption='Group Ranker' datatype='integer' name='[Calculation_2219500572152619009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE([Calculation_2219500572149923840],&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
