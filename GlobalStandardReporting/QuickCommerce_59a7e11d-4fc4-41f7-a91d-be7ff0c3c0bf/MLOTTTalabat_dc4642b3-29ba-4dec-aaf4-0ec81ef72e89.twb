      <column caption='Total Potential Impressions' datatype='real' name='[Potential Impressions (copy)_2408792501616214016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [partition_date],[category_name],[category_parent],[business_type]:AVG([potential_impressions])}' />
      </column>
      <column caption='Potential Revenue ' datatype='real' name='[Potential Revenue (copy)_2408792501655543813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Potential Impressions (copy)_2408792501616214016]* [Calculation_2099240404186050561]* [Category L1 GMV (copy)_2408792502046224396]' />
