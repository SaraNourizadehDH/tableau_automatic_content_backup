              <calculation class='tableau' formula='([ROAS with click based (copy)_1486610155297021956]-[Calculation_1486610155296804867])/[Calculation_1486610155296804867]' />
            </column>
            <column caption='CVR based on impressions' datatype='real' name='[CVR based on Click (copy)_1486610155294752769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([impression_conversions])/SUM([total_impressions])' />
            </column>
            <column caption='CVR based on Click' datatype='real' name='[Calculation_1486610155294461952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([click_conversions])/SUM([total_clicks])' />
            </column>
            <column caption='CVR Lift' datatype='real' name='[Calculation_1486610155295227906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([CVR based on Click (copy)_1486610155294752769]-[Calculation_1486610155294461952])/[Calculation_1486610155294461952]' />
            </column>
            <column caption='ROAS with click based' datatype='real' name='[Calculation_1486610155296804867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sales_revenue_clicks])/SUM([dh_ads_ad_revenue])' />
            </column>
            <column caption='Gap DH Ads Conversion' datatype='real' name='[Calculation_1486610155301629959]' role='measure' type='quantitative'>
