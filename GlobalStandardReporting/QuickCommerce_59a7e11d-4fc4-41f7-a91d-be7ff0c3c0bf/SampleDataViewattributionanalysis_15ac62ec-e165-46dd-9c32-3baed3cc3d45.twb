          <alias key='&quot;SCREEN_VERTICAL_HOME-Fixed&quot;' value='Vertical Home-Fixed' />
        </aliases>
      </column>
      <column caption='Camapaign Count' datatype='integer' name='[Calculation_1486610155320614927]' role='measure' type='quantitative'>
