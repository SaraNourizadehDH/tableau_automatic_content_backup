      <aliases enabled='yes' />
      <column caption='Impact' datatype='real' name='[CVR Lift (copy)_1486610155297157125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([ROAS with click based (copy)_1486610155297021956]-[Calculation_1486610155296804867])/[Calculation_1486610155296804867]' />
      </column>
      <column caption='CVR based on impressions' datatype='real' name='[CVR based on Click (copy)_1486610155294752769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([impression_conversions])/SUM([total_impressions])' />
      </column>
      <column caption='CVR based on Click' datatype='real' name='[Calculation_1486610155294461952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([click_conversions])/SUM([total_clicks])' />
      </column>
      <column caption='CVR Lift' datatype='real' name='[Calculation_1486610155295227906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([CVR based on Click (copy)_1486610155294752769]-[Calculation_1486610155294461952])/[Calculation_1486610155294461952]' />
      </column>
      <column caption='ROAS with click based' datatype='real' name='[Calculation_1486610155296804867]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sales_revenue_clicks])/SUM([dh_ads_ad_revenue])' />
      </column>
      <column caption='Spend per click' datatype='real' name='[Calculation_1486610155300581382]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dh_ads_ad_revenue])/SUM([dh_ads_clicks])' />
      </column>
      <column caption='Gap DH Ads Conversion' datatype='real' name='[Calculation_1486610155301629959]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([dh_ads_conversions])-SUM([click_conversions]))/SUM([dh_ads_conversions])' />
      </column>
      <column caption='CPC' datatype='string' name='[Calculation_1486610155305709577]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [is_cpc]&#10;  WHEN TRUE THEN &quot;CPC&quot;&#10;  ELSE &quot;Fixed&quot;&#10;END' />
      </column>
      <column caption='Assets' datatype='string' name='[Calculation_1486610155306401802]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[placement] + &quot;-&quot; + [Calculation_1486610155305709577]' />
        <aliases>
          <alias key='&quot;SCREEN_CATEGORY-Fixed&quot;' value='Category-Fixed' />
          <alias key='&quot;SCREEN_VENDOR_HOME_PRESEARCH-CPC&quot;' value='Vendor Home Presearch-CPC' />
          <alias key='&quot;SCREEN_VENDOR_HOME-Fixed&quot;' value='Vendor Home-Fixed' />
          <alias key='&quot;SCREEN_VERTICAL_HOME_PRESEARCH-CPC&quot;' value='Vertical Home Presearch-CPC' />
          <alias key='&quot;SCREEN_VERTICAL_HOME-CPC&quot;' value='Vertical Home-CPC' />
          <alias key='&quot;SCREEN_VERTICAL_HOME-Fixed&quot;' value='Vertical Home-Fixed' />
        </aliases>
      </column>
      <column caption='Metric' datatype='real' name='[Calculation_1486610155312029707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Impact&quot; then [CVR Lift (copy)_1486610155297157125]&#10;WHEN &quot;CVR Lift&quot; THEN [Calculation_1486610155295227906]&#10;WHEN &quot;ROAS Clicks&quot; THEN [Calculation_1486610155296804867]&#10;WHEN &quot;ROAS Impressions&quot; THEN [ROAS with click based (copy)_1486610155297021956]&#10;END' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_1486610155315073038]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Assets&quot; THEN [Calculation_1486610155306401802]&#10;WHEN &quot;Global Entity ID&quot; THEN [global_entity_id]&#10;WHEN &quot;Campaign Name&quot; THEN [campaign_name]&#10;end' />
        <aliases>
          <alias key='&quot;SCREEN_CATEGORY-Fixed&quot;' value='Category-Fixed' />
          <alias key='&quot;SCREEN_VENDOR_HOME_PRESEARCH-CPC&quot;' value='Vendor Home Presearch-CPC' />
          <alias key='&quot;SCREEN_VENDOR_HOME-Fixed&quot;' value='Vendor Home-Fixed' />
          <alias key='&quot;SCREEN_VERTICAL_HOME_PRESEARCH-CPC&quot;' value='Vertical Home Presearch-CPC' />
