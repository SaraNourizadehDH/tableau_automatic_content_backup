      <aliases enabled='yes' />
      <column caption='Brand Name ' datatype='string' name='[Brand Name (copy)_3132464656824037377]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[brand_name]' />
      </column>
      <column caption='Active Brand Count' datatype='integer' name='[Brand count (copy)_3132464656836063237]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_3132464656835448836])' />
      </column>
      <column caption='Maximum Date' datatype='date' name='[Calculation3 (copy)_4136415544874057732]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([partition_date])+6' />
      </column>
      <column caption='Fill rate' datatype='real' name='[Calculation_2408792501624438788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Total Potential Impressions (copy)_2408792503422959657])/sum([Potential Impressions (copy)_2408792501616214016])' />
      </column>
      <column caption='MLOTT' datatype='real' name='[Calculation_2408792501665636358]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Potential Revenue (copy)_2408792501655543813])- SUM([total_ad_spend_eur])' />
      </column>
      <column caption='Calculation1' datatype='string' name='[Calculation_2408792501683318794]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;L1&quot; THEN [category_parent]&#10;when &quot;L2&quot; THEN [category_name]&#10;when &quot;L1/L2/B&quot; THEN [Category Parent (copy)_3132464656822304768]&#10;end' />
      </column>
      <column caption='Category L1 GMV' datatype='real' name='[Calculation_2408792502043430923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [category_parent],[global_entity_id],[business_type]:SUM([total_gmv_eur])}' />
      </column>
      <column caption='Calculation2' datatype='integer' name='[Calculation_2408792502053457933]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SIZE() = 1 THEN 0&#10;ELSE RANK_UNIQUE(SUM([total_gmv_eur]), &apos;desc&apos;)&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top N Filter' datatype='integer' name='[Calculation_2408792502057320470]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(&#10;IFNULL (&#10;int(&#10;( SUM([total_gmv_eur]))),0), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Ad Spend' datatype='real' name='[Calculation_2408792502323789850]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_ad_spend_eur])/SUM([total_gmv_eur])' />
      </column>
      <column caption='Last period' datatype='boolean' name='[Calculation_2408792503393652775]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST()&lt;[Parameters].[Parameter 3]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Brand count' datatype='integer' name='[Calculation_3132464656832577539]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([brand_name])' />
      </column>
      <column caption='Active Brand name' datatype='string' name='[Calculation_3132464656835448836]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [marker] THEN [brand_name]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='cost per click' datatype='real' name='[Calculation_3132464656836440070]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_ad_spend_eur])/SUM([clicks])' />
      </column>
      <column caption='Potential Revenue OLD' datatype='real' name='[Calculation_3132464656838066184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Potential Impressions (copy)_2408792501616214016])* 0.39*sum([Category L1 GMV (copy)_2408792502046224396])' />
      </column>
      <column caption='Month' datatype='string' datatype-customized='true' name='[Calculation_4136415542743252993]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(MONTH([partition_date]))' />
      </column>
      <column caption='Minimum Date' datatype='date' name='[Calculation_4136415544873603075]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MIN([partition_date])' />
      </column>
      <column caption='Week Month Year' datatype='string' name='[Calculation_4136415544879480838]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Week &quot; + STR(DATEPART(&apos;week&apos;, [partition_date])) + &quot; &quot; + DATENAME(&apos;month&apos;, [partition_date]) + &quot; &quot; + STR(YEAR([partition_date]))' />
      </column>
      <column caption='Category CTR (potential)' datatype='real' name='[Category L1 GMV (copy)_2408792502046224396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [month],[category_name],[global_entity_id],[business_type]:SUM([Total Potential Impressions (copy)_4136415542764666882])}&#10;/&#10;{ FIXED [month],[category_name],[global_entity_id],[business_type]:SUM([Potential Impressions (copy)_2408792501616214016])}' />
      </column>
      <column caption='Category Name ' datatype='string' name='[Category Name (copy)_3132464656830013442]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[category_name]' />
      </column>
      <column caption='Category Parent ' datatype='string' name='[Category Parent (copy)_3132464656822304768]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[category_parent]' />
      </column>
      <column caption='Total Potential Impressions' datatype='real' name='[Potential Impressions (copy)_2408792501616214016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [partition_month_isoweek],[category_name],[category_parent],[business_type]:AVG([potential_impressions])}' />
      </column>
      <column caption='Potential Revenue ' datatype='real' name='[Potential Revenue (copy)_2408792501655543813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Potential Impressions (copy)_2408792501616214016]* 0.39* [Category L1 GMV (copy)_2408792502046224396]' />
      </column>
      <column caption='Top N Filter (copy)' datatype='integer' name='[Top N Filter (copy)_2408792503353839651]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(&#10;IFNULL (&#10;int(&#10;( SUM([Total Potential Impressions (copy)_2408792503354802212]))),0), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='GMV' datatype='integer' name='[Total Potential Impressions (copy)_2408792503354802212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [category_parent],[category_name],[brand_name]:SUM([potential_impressions])}' />
      </column>
      <column caption='Total Actual Impressions' datatype='real' name='[Total Potential Impressions (copy)_2408792503422959657]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [partition_date],[category_parent],[category_name],[business_type]:AVG([actual_impressions])}' />
      </column>
      <column caption='Total Potential Clicks' datatype='real' name='[Total Potential Impressions (copy)_4136415542764666882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [partition_month_isoweek],[category_parent],[category_name],[business_type]:AVG([potential_clicks]  )}' />
      </column>
