            <column caption='Allc Os Dc Cost  p/o' datatype='real' name='[Allc Os Vouchers  p/o (copy)_6383430320572858376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([allc_os_dc_cost]) / SUM([allc_os_orders])' />
            </column>
            <column caption='Allc Os Other CoS + Store Cost  p/o' datatype='real' name='[Allc Os Vouchers  p/o (copy)_6383430320573116425]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([allc_os_other_cost_of_sales] + [allc_os_store_cost]) / SUM([allc_os_orders])' />
            </column>
            <column caption='Allc Os Ic Logistics  p/o' datatype='real' name='[Allc Os Vouchers  p/o (copy)_6383430320573476875]' role='measure' type='quantitative'>
