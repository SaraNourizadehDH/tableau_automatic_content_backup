            <column caption='Num Of Dh Delivery Orders' datatype='integer' name='[num_of_dh_delivery_orders]' role='measure' type='quantitative' />
            <column caption='Num Of Orders' datatype='integer' name='[num_of_orders]' role='measure' type='quantitative' />
