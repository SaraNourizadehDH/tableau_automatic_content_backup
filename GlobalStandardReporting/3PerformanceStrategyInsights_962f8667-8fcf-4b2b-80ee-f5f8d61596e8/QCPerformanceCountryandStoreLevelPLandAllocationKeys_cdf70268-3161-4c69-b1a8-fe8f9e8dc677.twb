      <aliases enabled='yes' />
      <column caption=' ----&gt;  P&amp;L' datatype='integer' name='[ --&gt;  KPIs (copy)_4446249149949718530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(&quot;&quot;)' />
      </column>
      <column caption=' ❶ Allocated One Stream Data' datatype='integer' name='[ ❶ KPIs (copy)_4446249149946294272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(&quot;&quot;)' />
      </column>
      <column caption='User Filter' datatype='boolean' name='[Calculation_2788994809493577730]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Reporth Month' datatype='string' name='[Calculation_4128041688542724097]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(STR(DATENAME(&apos;month&apos;,[month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [month])),2)' />
      </column>
      <column caption='▶  Total Dmart Revenue (Allocated)' datatype='real' name='[Calculation_4128041688543469570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[allc_os_retail_revenue] + [allc_os_vouchers] + [allc_os_delivery_fee_revenue] + [allc_os_non_margin_revenue] + [allc_os_service_fee_revenue] + [allc_os_other_revenues]' />
      </column>
      <column caption='▶  Gross Profit (Allocated)' datatype='real' name='[Calculation_4128041688547467270]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[▶  Total Dmart Revenue (copy)_679551024383627266] + [allc_os_other_cost_of_sales] + [allc_os_shopper_cost] + [allc_os_store_cost] + [allc_os_dc_cost] + [allc_os_ic_logistics] + [allc_os_ic_commission] + [allc_os_nrv_adjustment]' />
      </column>
      <column caption='_Space_1' datatype='integer' name='[Calculation_562387060169220114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(&quot;&quot;)' />
      </column>
      <column caption='GMV Difference %' datatype='real' name='[Calculation_679551024468148236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([allc_os_gmv]) / SUM([os_gmv]) - 1' />
      </column>
      <column caption='Row L1' datatype='string' name='[Column Level 2 (copy)_562387060579438682]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Column Level 2 (copy)_562387060579319897]&#13;&#10;    WHEN &quot;No Breakdown&quot; THEN &quot;&quot;&#10;    WHEN &quot;Region&quot; THEN [region]&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#10;    WHEN &quot;Country Name&quot; THEN [country_name]&#13;&#10;END' />
      </column>
      <column caption='Orders Difference %' datatype='real' name='[GMV Difference % (copy)_679551024468434957]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([allc_os_orders]) / SUM([os_orders]) - 1' />
      </column>
      <column caption='Gross Profit Difference %' datatype='real' name='[Orders Difference % (copy)_679551024469065742]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4128041688547467270]) / SUM([▶  Gross Profit (Allocated) (copy)_679551024466403339]) - 1' />
      </column>
      <column caption=' ----&gt;  KPIs' datatype='integer' name='[_Space_1 (copy)_562387060581470305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(&quot;&quot;)' />
      </column>
      <column caption='_Space_2' datatype='integer' name='[_Space_1 (copy)_562387060583452771]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(&quot;&quot;)' />
      </column>
