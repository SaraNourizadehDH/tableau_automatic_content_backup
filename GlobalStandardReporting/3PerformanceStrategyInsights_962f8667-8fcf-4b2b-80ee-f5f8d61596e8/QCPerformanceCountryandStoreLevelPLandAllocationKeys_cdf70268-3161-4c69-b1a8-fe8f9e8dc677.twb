    <worksheet name='Dmart Country Level OS PnL &amp; DataHub Lines WS'>
      <table>
        <view>
          <datasources>
            <datasource caption='_dmart_monthly_country_os_and_datahub_lines w. User Filtering' name='federated.0cqkt3108877zq15x36nn1sjwfnm' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Row L1' datatype='string' name='[Column Level 2 (copy)_562387060579319897]' param-domain-type='list' role='measure' type='nominal' value='&quot;No Breakdown&quot;'>
              <calculation class='tableau' formula='&quot;No Breakdown&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0cqkt3108877zq15x36nn1sjwfnm'>
            <column caption=' ----&gt;  Other Allocation Keys' datatype='integer' name='[ ----&gt;  All KPIs and P&amp;L Lines (Allocation Keys) (copy)_4446249149978636292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption=' ----&gt;  Comparable KPIs' datatype='integer' name='[ ----&gt;  P&amp;L (copy)_4446249149975674883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption=' ----&gt;  P&amp;L' datatype='integer' name='[ --&gt;  KPIs (copy)_4446249149949718530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption=' ❶ One Stream Data' datatype='integer' name='[ ❶ KPIs (copy)_4446249149946294272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption=' ❷ DataHub Data' datatype='integer' name='[ ❶ KPIs (copy)_562387060583026786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption='- Amt Cogs Eur' datatype='real' name='[Amt Cogs Eur (copy)_4446249150025134098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-[amt_cogs_eur]' />
            </column>
            <column caption='Amt Voucher Dh Eur (copy)' datatype='real' name='[Amt Voucher Dh Eur (copy)_4446249150024167440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[amt_voucher_dh_eur]' />
            </column>
            <column caption='Reporth Month' datatype='string' name='[Calculation_4128041688542724097]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(STR(DATENAME(&apos;month&apos;,[month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [month])),2)' />
            </column>
            <column caption='▶  Total Dmart Revenue' datatype='integer' name='[Calculation_4128041688543469570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[os_retail_revenue] + [os_vouchers] + [os_delivery_fee] + [os_non_margin_revenue] + [os_service_fee_revenue] + [os_other_revenues]' />
            </column>
            <column caption='▶  Product Margin' datatype='integer' name='[Calculation_4128041688546066436]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4128041688543469570] + [os_cogs] + [os_back_margin] + [os_shrinkage] + [os_packaging_cost]' />
            </column>
            <column caption='▶  Gross Profit' datatype='integer' name='[Calculation_4128041688547467270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4128041688543469570] + [os_cogs] + [os_back_margin] + [os_shrinkage]+ [os_packaging_cost] + [os_other_cost_of_sales] + [os_shopper_cost] + [os_store_cost] + [os_dc_cost] + [os_ic_logistics] + [os_ic_commission] + [os_nrv_adjustment]' />
            </column>
            <column caption='Orders Difference %' datatype='real' name='[Calculation_4446249150014963720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([os_orders]) / SUM([num_of_orders]) - 1' />
            </column>
            <column caption='GMV Difference %' datatype='real' name='[Calculation_4446249150018633738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([os_gmv]) / SUM([amt_gmv_eur]) - 1' />
            </column>
            <column caption='Retail Revenue Difference %' datatype='real' name='[Calculation_4446249150019137547]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([os_retail_revenue]) / SUM([total_amt_paid_net_eur]) - 1' />
            </column>
            <column caption='Delivery Fee Revenue Difference %' datatype='real' name='[Calculation_4446249150019555340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([os_delivery_fee]) / SUM([amt_delivery_fee_eur]) - 1' />
            </column>
            <column caption='Vouchers Difference %' datatype='real' name='[Calculation_4446249150020653070]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([os_vouchers]) / SUM([Calculation_4446249150024192017]) - 1' />
            </column>
            <column caption='Service Fee Revenue Difference %' datatype='real' name='[Calculation_4446249150021804047]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([os_service_fee_revenue]) / SUM([amt_service_fee_eur]) - 1' />
            </column>
            <column caption='Vouchers (DH only)' datatype='real' name='[Calculation_4446249150024192017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-[Amt Voucher Dh Eur (copy)_4446249150024167440]' />
            </column>
            <column caption='COGS Difference %' datatype='real' name='[Calculation_4446249150025543699]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([os_cogs]) / SUM([Amt Cogs Eur (copy)_4446249150025134098]) - 1' />
            </column>
            <column caption='Back Margin Difference %' datatype='real' name='[Calculation_4446249150026600468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([os_back_margin]) / SUM([djini_order_supplier_funded_eur]) - 1' />
            </column>
            <column caption='_Space_1' datatype='integer' name='[Calculation_562387060169220114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption='Shrinkage Difference %' datatype='real' name='[Calculation_5800284525749321728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([os_shrinkage]) / SUM([shrinkage]) - 1' />
            </column>
            <column caption='Num of Days' datatype='integer' name='[Calculation_6142769215416201218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DAY(DATE(DATEADD(&apos;month&apos;, 1, [month])) - 1)' />
            </column>
            <column caption='OS Daily Orders / OS Store' datatype='real' name='[Calculation_6142769215416446979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([os_orders]) / sum([os_active_stores]) / SUM([Calculation_6142769215416201218])' />
            </column>
            <column caption='Platform GP w. dmart' datatype='real' name='[Calculation_679551024398491652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([os_platform_gp_as_perc_of_gmv] * [os_gmv])' />
            </column>
            <column caption='Row L1' datatype='string' name='[Column Level 2 (copy)_562387060579438682]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Column Level 2 (copy)_562387060579319897]&#13;&#10;    WHEN &quot;No Breakdown&quot; THEN &quot;&quot;&#10;    WHEN &quot;Region&quot; THEN [region]&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#10;    WHEN &quot;Country Name&quot; THEN [country_name]&#13;&#10;END' />
            </column>
            <column caption='Os Platform GP as perc of GMV (calc.)' datatype='real' name='[Platform GP w. dmart (copy)_679551024398782469]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([os_platform_gp_as_perc_of_gmv] * [os_gmv]) / SUM([os_gmv])' />
            </column>
            <column caption=' ----&gt;  KPIs' datatype='integer' name='[_Space_1 (copy)_562387060581470305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption='_Space_2' datatype='integer' name='[_Space_1 (copy)_562387060583452771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption='_Space_3' datatype='integer' name='[_Space_2 (copy)_562387060584075366]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption='_Space_4' datatype='integer' name='[_Space_3 (copy)_4446249149992329221]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption='Amt Cogs Eur' datatype='real' name='[amt_cogs_eur]' role='measure' type='quantitative' />
            <column caption='Amt Delivery Fee Eur' datatype='real' name='[amt_delivery_fee_eur]' role='measure' type='quantitative' />
            <column caption='Amt Gmv Eur' datatype='real' name='[amt_gmv_eur]' role='measure' type='quantitative' />
            <column caption='Amt Service Fee Eur' datatype='real' name='[amt_service_fee_eur]' role='measure' type='quantitative' />
            <column caption='Amt Voucher Dh Eur' datatype='real' name='[amt_voucher_dh_eur]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Djini Order Supplier Funded Eur' datatype='real' name='[djini_order_supplier_funded_eur]' role='measure' type='quantitative' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Month' datatype='date' default-format='*MMM YYYY' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_4128041688542724097]' derivation='None' name='[none:Calculation_4128041688542724097:nk]' pivot='key' type='nominal' />
            <column-instance column='[Column Level 2 (copy)_562387060579438682]' derivation='None' name='[none:Column Level 2 (copy)_562387060579438682:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
