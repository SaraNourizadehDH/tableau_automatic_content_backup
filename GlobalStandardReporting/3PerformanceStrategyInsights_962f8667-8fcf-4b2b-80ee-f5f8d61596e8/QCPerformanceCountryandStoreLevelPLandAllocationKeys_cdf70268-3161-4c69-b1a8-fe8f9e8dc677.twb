      <column caption='KPI AK %' datatype='real' default-format='p0.00%' name='[Calculation_1441714890595282945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[KPI (copy)_1441714890593435648]&#13;&#10;    WHEN &quot;LS OD Orders %&quot; THEN [Calculation_1820298731630907414]&#13;&#10;    WHEN &quot;LS VD Orders %&quot; THEN [Calculation_1820298731630989335]&#13;&#10;    WHEN &quot;LS OD GMV %&quot; THEN [Calculation_1820298731631038488]&#13;&#10;    WHEN &quot;LS VD GMV %&quot; THEN [Calculation_1820298731631165465]&#13;&#10;    WHEN &quot;LS GPV %&quot; THEN [Calculation_1820298731631251482]&#13;&#10;    WHEN &quot;LS OD GPV %&quot; THEN [Calculation_1820298731631333403]&#13;&#10;    WHEN &quot;LS VD GPV %&quot; THEN [Calculation_1820298731631415324]&#13;&#10;    WHEN &quot;LS OD Commission Revenue %&quot; THEN [Calculation_1820298731631472669]&#13;&#10;    WHEN &quot;LS VD Commission Revenue %&quot; THEN [Calculation_1820298731631607840]&#13;&#10;    WHEN &quot;LS OD Delivery Fee Revenue %&quot; THEN [Calculation_1820298731631980579]&#13;&#10;    WHEN &quot;LS Service Fee Revenue %&quot; THEN [Calculation_1820298731632050212]&#13;&#10;    WHEN &quot;LS &amp; Food Orders %&quot; THEN [Calculation_1820298731633578021]&#13;&#10;    WHEN &quot;LS &amp; Food Online GMV %&quot; THEN [Calculation_1820298731634180134]&#13;&#10;    WHEN &quot;LS &amp; Food Offline GMV %&quot; THEN [Calculation_1820298731634233383]&#13;&#10;    WHEN &quot;PL Orders %&quot; THEN [Calculation_1820298731634339880]&#13;&#10;    WHEN &quot;PL OD wo Pickup Orders %&quot; THEN [Calculation_1820298731634413609]&#13;&#10;    WHEN &quot;PL Online GMV %&quot; THEN [Calculation_1820298731634487338]&#13;&#10;    WHEN &quot;PL Subscription Benefit Orders %&quot; THEN [Calculation_1820298731634540587]&#13;&#10;    WHEN &quot;PL Delivery Costs %&quot; THEN [Calculation_1820298731634585644]&#13;&#10;    WHEN &quot;PL Contacts %&quot; THEN [Calculation_1820298731634749485]&#13;&#10;    WHEN &quot;PL Contacts Customer %&quot; THEN [Calculation_1820298731634794542]&#13;&#10;    WHEN &quot;PL Contacts Vendor %&quot; THEN [Calculation_1820298731634823215]&#13;&#10;    WHEN &quot;PL Excl. Courier Orders %&quot; THEN [Calculation_1820298731634855984]&#13;&#10;    WHEN &quot;PL Excl. Courier Failed Orders %&quot; THEN [Calculation_1820298731634888753]&#13;&#10;    WHEN &quot;PL Excl. Dmarts Small Order Fee %&quot; THEN [Calculation_1820298731634970674]&#13;&#10;END' />
      </column>
      <column caption='Report Month (String)' datatype='string' name='[Calculation_1537416390866923520]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(STR(DATENAME(&apos;month&apos;, [report_month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [report_month])),2)' />
      </column>
