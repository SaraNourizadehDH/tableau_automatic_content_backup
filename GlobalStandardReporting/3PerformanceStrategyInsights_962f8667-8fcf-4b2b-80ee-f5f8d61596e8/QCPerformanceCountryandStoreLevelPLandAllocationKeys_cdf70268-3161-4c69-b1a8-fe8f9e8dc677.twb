      <column caption='Other Non Marginal Revenue' datatype='integer' name='[Calculation_4128041688536702976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[os_non_margin_revenue] - [os_service_fee_revenue]' />
      </column>
      <column caption='Reporth Month' datatype='string' name='[Calculation_4128041688542724097]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(STR(DATENAME(&apos;month&apos;,[month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [month])),2)' />
      </column>
      <column caption='▶  Total Dmart Revenue' datatype='integer' name='[Calculation_4128041688543469570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[os_retail_revenue] + [os_vouchers] + [os_delivery_fee] + [os_non_margin_revenue] + [os_service_fee_revenue] + [os_other_revenues]' />
      </column>
      <column caption='▶  Product Margin' datatype='integer' name='[Calculation_4128041688546066436]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4128041688543469570] + [os_cogs] + [os_back_margin] + [os_shrinkage] + [os_packaging_cost]' />
      </column>
      <column caption='▶  Contribution Margin' datatype='integer' name='[Calculation_4128041688546832389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4128041688546066436] + [os_ic_logistics] + [os_ic_commission] + [os_shopper_cost]' />
      </column>
      <column caption='▶  Gross Profit' datatype='integer' name='[Calculation_4128041688547467270]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4128041688543469570] + [os_cogs] + [os_back_margin] + [os_shrinkage]+ [os_packaging_cost] + [os_other_cost_of_sales] + [os_shopper_cost] + [os_store_cost] + [os_dc_cost] + [os_ic_logistics] + [os_ic_commission] + [os_nrv_adjustment]' />
      </column>
      <column caption='Total Platfrom Costs &amp; Revenues' datatype='integer' name='[Calculation_4128041688549339144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[os_take_in_platform] + [os_delivery_cost_platform] + [os_payment_cost_platform] + [os_delivery_accident_cost_platform] + [os_semi_variable_delivery_cost_platform] + [os_other_non_delivery_specific_cost_platform]' />
      </column>
      <column caption='▶  Gross Profit incl. NRV &amp; Platform' datatype='integer' name='[Calculation_4446249149949095937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4128041688547467270] + [Calculation_4128041688549339144]' />
