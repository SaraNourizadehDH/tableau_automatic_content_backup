        <calculation class='tableau' formula='-[amt_cogs_eur]' />
      </column>
      <column caption='Amt Voucher Dh Eur (copy)' datatype='real' name='[Amt Voucher Dh Eur (copy)_4446249150024167440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[amt_voucher_dh_eur]' />
      </column>
      <column caption='Daily Orders / Store' datatype='real' name='[Calculation_2619054352466927616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([allc_os_orders]) / COUNTD([warehouse_id]) / SUM([Calculation_6142769215416201218])' />
      </column>
      <column caption='Num of Stores (Datahub Data)' datatype='integer' name='[Calculation_2619054352468480001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([warehouse_id])' />
      </column>
      <column caption='User Filter' datatype='boolean' name='[Calculation_2788994809452036096]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Reporth Month' datatype='string' name='[Calculation_4128041688542724097]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(STR(DATENAME(&apos;month&apos;,[month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [month])),2)' />
      </column>
      <column caption='▶  Total Dmart Revenue' datatype='real' name='[Calculation_4128041688543469570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[allc_os_retail_revenue] + [allc_os_vouchers] + [allc_os_delivery_fee_revenue] + [allc_os_non_margin_revenue] + [allc_os_service_fee_revenue] + [allc_os_other_revenues]' />
      </column>
      <column caption='▶  Gross Profit' datatype='real' name='[Calculation_4128041688547467270]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4128041688543469570] + [allc_os_cogs] + [allc_os_back_margin] + [allc_os_shrinkage]+ [allc_os_packaging_cost] + [allc_os_other_cost_of_sales] + [allc_os_shopper_cost] + [allc_os_store_cost] + [allc_os_dc_cost] + [allc_os_ic_logistics] + [allc_os_ic_commission] + [allc_os_nrv_adjustment]' />
      </column>
      <column caption='Vouchers (DH only)' datatype='real' name='[Calculation_4446249150024192017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-[Amt Voucher Dh Eur (copy)_4446249150024167440]' />
      </column>
      <column caption='_Space_1' datatype='integer' name='[Calculation_562387060169220114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(&quot;&quot;)' />
      </column>
      <column caption='Num of Days' datatype='integer' name='[Calculation_6142769215416201218]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DAY(DATE(DATEADD(&apos;month&apos;, 1, [month])) - 1)' />
      </column>
      <column aggregation='Sum' caption='Age of the Store (till Current Month)' datatype='integer' name='[Calculation_6383430320530071552]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[warehouse_created_month], DATETRUNC(&apos;month&apos;,TODAY()))' />
      </column>
      <column caption='Allc Os Retail Revenue p/o' datatype='real' name='[Calculation_6383430320570851330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([allc_os_retail_revenue]) / SUM([allc_os_orders])' />
      </column>
      <column caption='Frequency' datatype='real' name='[Calculation_6399826180854337536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([allc_os_orders]) / SUM([num_of_customers])' />
      </column>
      <column caption='Gross Profit L3M p/o' datatype='real' name='[Calculation_6532541696883867717]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(SUM([Calculation_4128041688547467270]), -2, 0) / WINDOW_SUM(SUM([allc_os_orders]), -2, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Front Margin' datatype='real' name='[Calculation_679551024382300160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[allc_os_retail_revenue] + [allc_os_cogs]' />
      </column>
      <column caption='Platform GP w. dmart' datatype='real' name='[Calculation_679551024398491652]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([os_platform_gp_as_perc_of_gmv] * [allc_os_gmv])' />
      </column>
      <column caption='12 by 12 ' datatype='string' name='[Calculation_6965731686018940931]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_6383430320530071552] &lt;= 12 THEN &apos;0-12&apos;&#10;ELSEIF [Calculation_6383430320530071552] &gt; 12 AND [Calculation_6383430320530071552] &lt;=24 THEN &apos;13-24&apos;&#10;ELSEIF [Calculation_6383430320530071552] &gt; 24 AND [Calculation_6383430320530071552] &lt;=36 THEN &apos;25-36&apos;&#10;ELSEIF [Calculation_6383430320530071552] &gt;36 THEN &apos;36+&apos;&#10;END' />
      </column>
      <column caption='DOS 1 ' datatype='string' name='[Calculation_6965731686021513222]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF {FIXED [global_entity_id],[warehouse_name]: [Calculation_2619054352466927616]} &lt;= 100 THEN &apos;0-100&apos;&#10;ELSEIF {FIXED [global_entity_id],[warehouse_name]: [Calculation_2619054352466927616]} &gt;100 AND {FIXED [global_entity_id],[warehouse_name]: [Calculation_2619054352466927616]} &lt;=200 THEN &apos;101-200&apos;&#10;ELSEIF {FIXED [global_entity_id],[warehouse_name]: [Calculation_2619054352466927616]} &gt;200 AND {FIXED [global_entity_id],[warehouse_name]: [Calculation_2619054352466927616]} &lt;=300 THEN &apos;201-300&apos;&#10;ELSEIF {FIXED [global_entity_id],[warehouse_name]: [Calculation_2619054352466927616]} &gt;300 AND {FIXED [global_entity_id],[warehouse_name]: [Calculation_2619054352466927616]} &lt;=400 THEN &apos;301-400&apos;&#10;ELSEIF {FIXED [global_entity_id],[warehouse_name]: [Calculation_2619054352466927616]} &gt;400 THEN &apos;+400&apos; END' />
      </column>
      <column caption='Store Group' datatype='string' name='[Calculation_6965731686022975497]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;WHEN &apos;Current age: by 12 months&apos; THEN  [Calculation_6965731686018940931]&#10;WHEN &apos;Current age: by 6 months&apos; THEN [12 by 12  (copy)_6965731686019735556]&#10;WHEN &apos;Current age: by 3 months&apos; THEN [6 by 6  (copy)_6965731686020300805]&#10;WHEN &apos;D/O/S: 0-200; 201-300; +300&apos; THEN  [DOS 2 (copy)_6965731686021971976]&#10;WHEN &apos;D/O/S: 0-100; 101-200; 201-300; +300&apos; THEN [DOS 1  (copy)_6965731686021865479]&#10;WHEN &apos;D/O/S: 0-100; 101-200; 201-300; 301-400; +400&apos; THEN [Calculation_6965731686021513222]&#10;END' />
      </column>
