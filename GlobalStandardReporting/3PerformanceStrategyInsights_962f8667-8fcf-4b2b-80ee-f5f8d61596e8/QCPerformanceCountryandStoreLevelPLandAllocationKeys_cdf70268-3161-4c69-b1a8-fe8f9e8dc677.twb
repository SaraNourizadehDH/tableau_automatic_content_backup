            <column caption='Allc Os Delivery Fee Revenue p/o' datatype='real' name='[Allc Os Retail Revenue p/o (copy)_6383430320571117571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([allc_os_delivery_fee_revenue]) / SUM([allc_os_orders])' />
