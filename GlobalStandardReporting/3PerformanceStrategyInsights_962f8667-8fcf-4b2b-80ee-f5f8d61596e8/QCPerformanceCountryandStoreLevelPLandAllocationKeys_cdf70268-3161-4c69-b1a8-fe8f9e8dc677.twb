            <column caption=' ❷ DataHub Data' datatype='integer' name='[ ❶ KPIs (copy)_562387060583026786 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption='_Space_1' datatype='integer' name='[Calculation_562387060169220114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption='Column L1 1' datatype='string' name='[Calculation_562387060244058184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#13;&#10;    WHEN &quot;No Breakdown&quot; THEN &quot;&quot;&#13;&#10;    WHEN &quot;Segment&quot; THEN [segment]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country Name&quot; THEN [country_name]&#13;&#10;    WHEN &quot;Vertical Parent&quot; THEN [vertical_parent]&#13;&#10;    WHEN &quot;Vertical Type&quot; THEN [vertical_type]&#13;&#10;    WHEN &quot;AAA Chain Name Cleaned&quot; THEN [aaa_chain_name_cleaned]&#13;&#10;    WHEN &quot;Is AAA&quot; THEN STR([is_aaa])&#13;&#10;    WHEN &quot;Is AAA Supermarket&quot; THEN STR([is_aaa_supermarket])&#13;&#10;    WHEN &quot;Is Own Delivery&quot; THEN STR([is_own_delivery])&#13;&#10;    WHEN &quot;Report Month&quot; THEN LEFT(STR(DATENAME(&apos;month&apos;, [report_month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [report_month])),2)&#13;&#10;    WHEN &quot;Report Quarter&quot; THEN &quot;Q&quot; + LEFT(STR(DATENAME(&apos;quarter&apos;, [report_month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [report_month])),2)&#13;&#10;END' />
            </column>
            <column caption='Orders Difference %' datatype='real' name='[Calculation_5800284525795487761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([act_orders]) / SUM([datahub_orders]) - 1' />
            </column>
            <column caption='GMV Difference %' datatype='real' name='[Calculation_5800284525795745810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([act_gmv]) / SUM([datahub_gmv]) - 1' />
            </column>
            <column caption='User filter' datatype='boolean' name='[Calculation_804736960008593408]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username]=USERNAME()' />
            </column>
            <column caption='Column L2 1' datatype='string' name='[Column Level 1 (copy)_562387060578484312]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Column Level 1 (copy)_562387060578435159 1]&#13;&#10;    WHEN &quot;No Breakdown&quot; THEN &quot;&quot;&#13;&#10;    WHEN &quot;Segment&quot; THEN [segment]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country Name&quot; THEN [country_name]&#13;&#10;    WHEN &quot;Vertical Parent&quot; THEN [vertical_parent]&#13;&#10;    WHEN &quot;Vertical Type&quot; THEN [vertical_type]&#13;&#10;    WHEN &quot;AAA Chain Name Cleaned&quot; THEN [aaa_chain_name_cleaned]&#13;&#10;    WHEN &quot;Is AAA&quot; THEN STR([is_aaa])&#13;&#10;    WHEN &quot;Is AAA Supermarket&quot; THEN STR([is_aaa_supermarket])&#13;&#10;    WHEN &quot;Is Own Delivery&quot; THEN STR([is_own_delivery])&#13;&#10;    WHEN &quot;Report Month&quot; THEN LEFT(STR(DATENAME(&apos;month&apos;, [report_month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [report_month])),2)&#13;&#10;    WHEN &quot;Report Quarter&quot; THEN &quot;Q&quot; + LEFT(STR(DATENAME(&apos;quarter&apos;, [report_month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [report_month])),2)&#13;&#10;END' />
            </column>
            <column caption='DT1 1.02. KPIs - GMV' datatype='real' default-format='n#,##0;-#,##0' name='[DT1  1.01. KPIs - Orders (copy)_1537416390879768596]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3 1]&#13;&#10;    WHEN &quot;Actual&quot; THEN [act_gmv]&#13;&#10;    WHEN &quot;Budget&quot; THEN [bud_gmv]&#13;&#10;    WHEN &quot;Last Estimate&quot; THEN [le_gmv]&#13;&#10;    WHEN &quot;Month Estimate&quot; THEN [me_gmv]&#13;&#10;END' />
            </column>
