  <worksheets>
    <worksheet name='DM - Store Level P&amp;L: Monthly Difference Check  - WS '>
      <table>
        <view>
          <datasources>
            <datasource caption='_dmart_monthly_store_level_allocated_pnl w. UserFiltering' name='federated.1wejglc1l8rpsc1bmbr6709e7rhh' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Row L1' datatype='string' name='[Column Level 2 (copy)_562387060579319897]' param-domain-type='list' role='measure' type='nominal' value='&quot;No Breakdown&quot;'>
              <calculation class='tableau' formula='&quot;No Breakdown&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1wejglc1l8rpsc1bmbr6709e7rhh'>
            <column caption=' ----&gt;  P&amp;L' datatype='integer' name='[ --&gt;  KPIs (copy)_4446249149949718530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption=' ❶ Allocated One Stream Data' datatype='integer' name='[ ❶ KPIs (copy)_4446249149946294272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption=' ❷ Unit Economics' datatype='integer' name='[ ❶ KPIs (copy)_562387060583026786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption=' ❸ Key Ratios' datatype='integer' name='[ ❷ Unit Economics (copy)_6383430320574271502]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption='▶  Gross Profit  p/o' datatype='real' name='[Allc Os Vouchers  p/o (copy)_6383430320573820940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_4128041688547467270]) / SUM([allc_os_orders])' />
            </column>
            <column caption='Allc Os Vouchers as % RR' datatype='real' name='[Allc Os Vouchers  p/o (copy)_6383430320582463503]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([allc_os_vouchers]) / SUM([allc_os_retail_revenue])' />
            </column>
            <column caption='Allc Os Non Margin Revenue as % RR' datatype='real' name='[Allc Os Vouchers as % RR (copy)_6383430320582643728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([allc_os_non_margin_revenue]) / SUM([allc_os_retail_revenue])' />
            </column>
            <column caption='Allc Os Shrinkage as % RR' datatype='real' name='[Allc Os Vouchers as % RR (copy)_6383430320582774801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([allc_os_shrinkage]) / SUM([allc_os_retail_revenue])' />
            </column>
            <column caption='Allc Os Shopper Cost as % RR' datatype='real' name='[Allc Os Vouchers as % RR (copy)_6383430320583028754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([allc_os_shopper_cost]) / SUM([allc_os_retail_revenue])' />
            </column>
            <column caption='Allc Os Dc Cost as % RR' datatype='real' name='[Allc Os Vouchers as % RR (copy)_6383430320583188499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([allc_os_dc_cost]) / SUM([allc_os_retail_revenue])' />
            </column>
            <column caption='▶  Gross Profit excl. NRV as % of GMV' datatype='real' name='[Allc Os Vouchers as % RR (copy)_6383430320583405588]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([▶  Gross Profit (copy)_4128041688547909639]) / SUM([allc_os_gmv])' />
            </column>
            <column caption='F+B as % of RR' datatype='real' name='[Allc Os Vouchers as % RR (copy)_679551024382722049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_679551024382300160] + [allc_os_back_margin]) / SUM([allc_os_retail_revenue])' />
            </column>
            <column caption='Reporth Month' datatype='string' name='[Calculation_4128041688542724097]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT(STR(DATENAME(&apos;month&apos;,[month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [month])),2)' />
            </column>
            <column caption='▶  Total Dmart Revenue' datatype='real' name='[Calculation_4128041688543469570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[allc_os_retail_revenue] + [allc_os_vouchers] + [allc_os_delivery_fee_revenue] + [allc_os_non_margin_revenue] + [allc_os_service_fee_revenue] + [allc_os_other_revenues]' />
            </column>
            <column caption='▶  Gross Profit' datatype='real' name='[Calculation_4128041688547467270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4128041688543469570] + [allc_os_cogs] + [allc_os_back_margin] + [allc_os_shrinkage]+ [allc_os_packaging_cost] + [allc_os_other_cost_of_sales] + [allc_os_shopper_cost] + [allc_os_store_cost] + [allc_os_dc_cost] + [allc_os_ic_logistics] + [allc_os_ic_commission] + [allc_os_nrv_adjustment]' />
            </column>
            <column caption='_Space_1' datatype='integer' name='[Calculation_562387060169220114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption='Front Margin' datatype='real' name='[Calculation_679551024382300160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[allc_os_retail_revenue] + [allc_os_cogs]' />
            </column>
            <column caption='Platform GP w. dmart' datatype='real' name='[Calculation_679551024398491652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([os_platform_gp_as_perc_of_gmv] * [allc_os_gmv])' />
            </column>
            <column caption='Row L1' datatype='string' name='[Column Level 2 (copy)_562387060579438682]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Column Level 2 (copy)_562387060579319897]&#13;&#10;    WHEN &quot;No Breakdown&quot; THEN &quot;&quot;&#10;    WHEN &quot;Region&quot; THEN [region]&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#10;    WHEN &quot;Country Name&quot; THEN [country_name]&#13;&#10;END' />
            </column>
            <column caption='▶  Product Margin as % of RR' datatype='real' name='[F+B as % of RR (copy)_679551024384516099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([▶  Total Dmart Revenue (copy)_679551024383627266]) / SUM([allc_os_retail_revenue])' />
            </column>
            <column caption=' ----&gt;  KPIs' datatype='integer' name='[_Space_1 (copy)_562387060581470305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
