            <column caption='Business Gross Profit p/o vs. L3M %' datatype='real' name='[Gross Profit p/o vs. L3M % (copy)_8643885497210777653]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([▶  Gross Profit  p/o (copy)_2619054352469217282] - [Gross Profit L3M p/o (copy)_8643885497209544755]) / ABS([Gross Profit L3M p/o (copy)_8643885497209544755])'>
