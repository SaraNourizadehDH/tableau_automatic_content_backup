      <column caption='Amt Voucher Dh Eur (copy)' datatype='real' name='[Amt Voucher Dh Eur (copy)_4446249150024167440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[amt_voucher_dh_eur]' />
      </column>
      <column caption='Back Margin Difference % (copy)' datatype='real' name='[Back Margin Difference % (copy)_5800284525774528527]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([os_back_margin]) / SUM([djini_order_supplier_funded_eur]) - 1' />
      </column>
      <column caption='COGS Difference % (copy)' datatype='real' name='[COGS Difference % (copy)_5800284525774487566]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([os_cogs]) / SUM([Amt Cogs Eur (copy)_4446249150025134098]) - 1' />
