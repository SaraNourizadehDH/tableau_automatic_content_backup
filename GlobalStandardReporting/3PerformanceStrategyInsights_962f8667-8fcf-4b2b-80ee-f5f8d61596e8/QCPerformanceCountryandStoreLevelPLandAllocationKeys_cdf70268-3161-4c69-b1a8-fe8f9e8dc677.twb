      <column caption='Column L1 1' datatype='string' name='[Calculation_562387060244058184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#13;&#10;    WHEN &quot;No Breakdown&quot; THEN &quot;&quot;&#13;&#10;    WHEN &quot;Segment&quot; THEN [segment]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country Name&quot; THEN [country_name]&#13;&#10;    WHEN &quot;Vertical Parent&quot; THEN [vertical_parent]&#13;&#10;    WHEN &quot;Vertical Type&quot; THEN [vertical_type]&#13;&#10;    WHEN &quot;AAA Chain Name Cleaned&quot; THEN [aaa_chain_name_cleaned]&#13;&#10;    WHEN &quot;Is AAA&quot; THEN STR([is_aaa])&#13;&#10;    WHEN &quot;Is AAA Supermarket&quot; THEN STR([is_aaa_supermarket])&#13;&#10;    WHEN &quot;Is Own Delivery&quot; THEN STR([is_own_delivery])&#13;&#10;    WHEN &quot;Report Month&quot; THEN LEFT(STR(DATENAME(&apos;month&apos;, [report_month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [report_month])),2)&#13;&#10;    WHEN &quot;Report Quarter&quot; THEN &quot;Q&quot; + LEFT(STR(DATENAME(&apos;quarter&apos;, [report_month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [report_month])),2)&#13;&#10;END' />
      </column>
