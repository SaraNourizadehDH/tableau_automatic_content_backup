    <worksheet name='Reactivation Order Characterstics'>
      <table>
        <view>
          <datasources>
            <datasource caption='churn_analysis_dmart_output_reactivation (dev_dmart)' name='federated.01uzui31vp0w7416zj7h6176goei' />
          </datasources>
          <datasource-dependencies datasource='federated.01uzui31vp0w7416zj7h6176goei'>
            <column caption='% Ultra Fresh Orders' datatype='real' name='[% Fresh Orders (copy)_2770980476100243523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Ultrafresh_Order_reactivation])/SUM([reactivationed_orders])' />
            </column>
            <column caption='% Orders with both fresh and ultra fresh' datatype='real' name='[% Ultra Fresh Orders (copy)_2770980476100390980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Fresh_Ultrafresh_Order_reactivation])/SUM([reactivationed_orders])' />
            </column>
            <column caption='ABS reactivation' datatype='real' name='[ABS_reactivation]' role='measure' type='quantitative' />
            <column caption='Basket Size' datatype='real' name='[Calculation_2770980476099051581]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ABS_reactivation])/SUM([reactivationed_orders])' />
            </column>
            <column caption='Avg Category Count' datatype='real' name='[Calculation_2770980476099289150]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Category_Cnt_reactivation])/SUM([reactivationed_orders])' />
            </column>
            <column caption='% Orders with vouchers' datatype='real' name='[Calculation_2770980476099588159]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Voucher_Order_reactivation])/SUM([reactivationed_orders])' />
            </column>
            <column caption='% Orders with discount' datatype='real' name='[Calculation_2770980476099764288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Discount_Order_reactivation])/SUM([reactivationed_orders])' />
            </column>
            <column caption='% FDF Orders' datatype='real' name='[Calculation_2770980476099944513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([FDF_Order_reactivation])/SUM([reactivationed_orders])' />
            </column>
            <column caption='% Fresh Orders' datatype='real' name='[Calculation_2770980476100124738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Fresh_Order_reactivation])/SUM([reactivationed_orders])' />
            </column>
            <column caption='% Subscription Orders' datatype='real' name='[Calculation_2770980476100526149]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Subscription_Order_reactivation])/SUM([reactivationed_orders])' />
            </column>
            <column caption='% Delivery Fee Benefit Orders' datatype='real' name='[Calculation_2770980476100640838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Delivery_Fee_Benefit_Order_reactivation])/SUM([reactivationed_orders])' />
            </column>
            <column caption='Delivery Fee' datatype='real' name='[Calculation_2770980476100845639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_reactivation])/SUM([Orders_With_DF_reactivation])' />
            </column>
            <column caption='Category Cnt reactivation' datatype='integer' name='[Category_Cnt_reactivation]' role='measure' type='quantitative' />
            <column caption='Delivery Fee Benefit Order reactivation' datatype='integer' name='[Delivery_Fee_Benefit_Order_reactivation]' role='measure' type='quantitative' />
