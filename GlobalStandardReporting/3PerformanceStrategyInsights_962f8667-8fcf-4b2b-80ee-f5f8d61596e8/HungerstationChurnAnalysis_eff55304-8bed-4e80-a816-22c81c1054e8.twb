      <aliases enabled='yes' />
      <column caption='% Ultra Fresh Orders' datatype='real' name='[% Fresh Orders (copy)_2770980476086095909]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Ultrafresh_Order_Churn])/SUM([churned_orders])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.084599z12dqbm51dqj4791rizwe5].[sum:MAUs:qk]&quot;' value='# Customers' />
        </aliases>
