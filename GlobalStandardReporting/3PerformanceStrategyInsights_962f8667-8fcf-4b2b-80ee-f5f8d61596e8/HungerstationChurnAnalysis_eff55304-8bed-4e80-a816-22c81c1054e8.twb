        <zone forceUpdate='true' h='1370' id='109' type-v2='text' w='84500' x='3188' y='1370'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans SemiDemi'>This view provides a comprehensive analysis of customer activity in the months following their trial period. The key customer categories are defined as:</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans SemiDemi'>Active Customers – Customers who have placed more than one successful dmart order within a given month.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans SemiDemi'>Inactive Customers – Customers who have not placed any dmart orders in the current month but made at least one order in the past two months.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans SemiDemi'>Churned Customers – Customers who have not placed any dmart orders in the current or previous two months.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans SemiDemi'>Reactivated Customers – Customers who placed an dmart order in the current month but had previously churned (i.e., they were inactive at least once since their trial).</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans SemiDemi'>Please select appropriate segmentations for L1 and L2 to classify customers based on the KPIs derived from their trial order.</run>
            <run>Æ&#10;</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
          </zone-style>
        </zone>
      </zones>
