      <column caption='ABS Churn' datatype='real' name='[ABS_Churn]' role='measure' type='quantitative' />
      <column caption='Basket Size (Churn)' datatype='real' name='[Calculation_2770980476085391394]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ABS_Churn])/SUM([churned_orders])' />
      </column>
      <column caption='Avg Category Count (Churn)' datatype='real' name='[Calculation_2770980476085682211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Category_Cnt_Churn])/SUM([churned_orders])' />
      </column>
      <column caption='% Fresh Orders' datatype='real' name='[Calculation_2770980476085940260]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Fresh_Order_Churn])/SUM([churned_orders])' />
      </column>
      <column caption='% Orders with both fresh and ultrafresh' datatype='real' name='[Calculation_2770980476086222886]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Fresh_Ultrafresh_Order_Churn])/SUM([churned_orders])' />
      </column>
      <column caption='% Subscription Orders ' datatype='real' name='[Calculation_2770980476086353959]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Subscription_Order_Churn])/SUM([churned_orders])' />
      </column>
      <column caption='% Stacked Order' datatype='real' name='[Calculation_2770980476086800424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Stacked_Order_Churn])/SUM([churned_orders])' />
      </column>
      <column caption='% Partial Orders ' datatype='real' name='[Calculation_2770980476087083049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Partial_Order_Churn])/SUM([churned_orders])' />
      </column>
      <column caption='Avg Delivery Delay' datatype='real' name='[Calculation_2770980476087382058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_delay_churn])/SUM([Orders_With_DD_Churn])' />
      </column>
      <column caption='Avg Delivery Fee' datatype='real' name='[Calculation_2770980476087570475]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_fee_churn])/SUM([Orders_With_DF_Churn])' />
      </column>
      <column caption='% Delivery Fee Benefit Orders' datatype='real' name='[Calculation_2770980476087738412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Delivery_Fee_Benefit_Order_Churn])/SUM([churned_orders])' />
      </column>
      <column caption='Avg Stacking' datatype='real' name='[Calculation_2770980476088127533]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([stacked_deliveries_churn])/SUM([Stacked_Order_Churn])' />
      </column>
      <column caption='% Order with vouchers' datatype='real' name='[Calculation_2770980476090572846]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Voucher_Order_Churn])/sum([churned_orders])' />
      </column>
      <column caption='% Orders with Discount' datatype='real' name='[Calculation_2770980476090794031]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Discount_Order_Churn])/sum([churned_orders])' />
      </column>
      <column caption='% Failed Orders' datatype='real' name='[Calculation_2770980476091248688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Failed_Order_Churn])/SUM([churned_orders])' />
      </column>
      <column caption='% FDF Orders' datatype='real' name='[Calculation_2770980476093460534]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([FDF_Order_Churn])/SUM([churned_orders])' />
