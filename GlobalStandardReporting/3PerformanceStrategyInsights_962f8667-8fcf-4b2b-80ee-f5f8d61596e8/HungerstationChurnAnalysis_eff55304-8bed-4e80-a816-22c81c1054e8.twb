      <aliases enabled='yes' />
      <column caption='% Ultra Fresh Orders' datatype='real' name='[% Fresh Orders (copy)_2770980476093026356]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Ultra_Fresh_orders])/sum([dmart_successful_orders])' />
      </column>
      <column caption='% Orders with  Free Delivery' datatype='real' name='[% Orders with discuounts (copy)_3253850781285290002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_order_with_fdf])/SUM([dmart_successful_orders])' />
      </column>
      <column caption='% Orders with discounts' datatype='real' name='[% Orders with vouchers (copy)_3253850781285203985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_order_with_discount])/SUM([dmart_successful_orders])' />
      </column>
      <column caption='% Orders with delivery benefit' datatype='real' name='[% Subscription Orders (copy)_2770980476094062649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_with_delivery_benefit])/SUM([dmart_successful_orders])' />
      </column>
      <column caption='% Orders with both fresh and ultrafresh' datatype='real' name='[% Ultra Fresh Orders (copy)_2770980476093173813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Orders_with_both_fresh_ultrafresh])/sum([dmart_successful_orders])' />
      </column>
