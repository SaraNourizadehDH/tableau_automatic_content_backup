          <alias key='&quot;[federated.1a3tpvk1jnlwgb192vngj18sips6].[usr:Calculation_6555904065290059778:qk]&quot;' value='Dmart KPI  ' />
          <alias key='&quot;[federated.1a3tpvk1jnlwgb192vngj18sips6].[usr:Calculation_6555904065290321923:qk]&quot;' value='Shops KPI  ' />
          <alias key='&quot;[federated.1a3tpvk1jnlwgb192vngj18sips6].[usr:Calculation_6555904065291345924:qk]&quot;' value='AAA KPI ' />
        </aliases>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Customer_cnt]) / TOTAL(SUM([Customer_cnt]))'>
          <table-calc ordering-type='ColumnInPane' />
        </calculation>
      </column>
      <column caption='Active MAUs' datatype='integer' name='[Calculation_2770980475921661953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF  [dmart_customer_status] in (&apos;Active&apos;,&apos;Reactivated&apos;) THEN [Customer_cnt] ELSE 0 END)' />
      </column>
      <column caption='Months Since Churn' datatype='integer' name='[Calculation_2770980475927474178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[reporting_month],[first_churn_month])' />
      </column>
      <column caption='Basket Size ' datatype='real' name='[Calculation_2770980476092035121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ABS])/SUM([dmart_successful_orders])' />
      </column>
      <column caption='Avg Category Cnt' datatype='real' name='[Calculation_2770980476092231730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([category_cnt])/SUM([dmart_successful_orders])' />
      </column>
      <column caption='% Fresh Orders' datatype='real' name='[Calculation_2770980476092645427]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([fresh_orders])/sum([dmart_successful_orders])' />
      </column>
      <column caption='% Subscription Orders' datatype='real' name='[Calculation_2770980476093939768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_with_subscription])/SUM([dmart_successful_orders])' />
      </column>
      <column caption='% Stacked Orders' datatype='real' name='[Calculation_2770980476094246970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Stacked_orders])/sum([dmart_successful_orders])' />
      </column>
      <column caption='Avg Stacking' datatype='real' name='[Calculation_2770980476094447675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Stacked_deliveries])/sum([Stacked_orders])' />
      </column>
      <column caption='Time To Churn' datatype='integer' name='[Calculation_2770980476094955580]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[reporting_month],[first_churn_month])' />
      </column>
      <column caption='Month - Trial Month' datatype='integer' name='[Calculation_3253850781254438912]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[trial_month],[reporting_month])' />
      </column>
      <column caption='Classification L1' datatype='string' name='[Calculation_3253850781257199618]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE  [Parameters].[Parameter 1]&#10;WHEN 1 THEN [customer_classification]&#10;WHEN 2 THEN [Trial_Incentive_Type]&#10;WHEN 3 THEN IF([partial_order_trial])=TRUE THEN &quot;1&quot; ELSE &quot;0&quot; END&#10;WHEN 4 THEN [delivery_time_trial_bucket]&#10;WHEN 5 THEN [delivery_delay_trial_bucket]&#10;WHEN 6 THEN NULL&#10;WHEN 7 THEN [Category_Cnt_Bucket]&#10;WHEN 8 THEN [Category_type_bucket]&#10;WHEN 9 THEN IF([split_order_trial])=TRUE THEN &quot;1&quot; ELSE &quot;0&quot; END&#10;WHEN 10 THEN IF([stacked_order_trial])=TRUE THEN &quot;1&quot; ELSE &quot;0&quot; END&#10;WHEN 11 THEN [stacked_deliveries_trial_bucket]&#10;WHEN 12 THEN IF([has_subscription_trial_bucket])=TRUE THEN &quot;H +&quot; ELSE &quot;Non H+&quot; END&#10;WHEN 13 THEN [delivery_fee_benefit_trial_bucket]&#10;WHEN 14 THEN [abs_trial_bucket]&#10;WHEN 15 THEN IF [partial_order_trial]=TRUE THEN &quot;1&quot; ELSE &quot;0&quot; END&#10;WHEN 16 THEN [trial_aqs_bucket]&#10;END' />
      </column>
      <column caption='Food KPI' datatype='real' name='[Calculation_3253850781276631046]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] &#10;WHEN 1 THEN [food_orders]&#10;WHEN 2 THEN [food_gmv] END' />
      </column>
      <column caption='Months (Trial- Churn)' datatype='integer' name='[Calculation_3253850781277851657]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[trial_month],[reporting_month])' />
      </column>
      <column caption='Delivery Delay' datatype='real' name='[Calculation_3253850781279272970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_delay_minutes])/SUM([dmart_order_with_dd])' />
      </column>
      <column caption='Time Till Churn' datatype='boolean' name='[Calculation_3253850781281447948]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[reporting_month]&lt;=[first_churn_month]' />
      </column>
      <column caption='Partial Orders' datatype='real' name='[Calculation_3253850781282512909]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_partial_orders])/SUM([dmart_successful_orders])' />
      </column>
      <column caption='Failed Orders' datatype='real' name='[Calculation_3253850781282697230]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Dmart_Failed_Orders])/SUM([dmart_total_orders])' />
      </column>
      <column caption='% Orders with delivery delay' datatype='real' name='[Calculation_3253850781283450895]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_order_with_dd])/SUM([dmart_successful_orders])' />
      </column>
      <column caption='% Orders with vouchers' datatype='real' name='[Calculation_3253850781284982800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_order_with_voucher])/SUM([dmart_successful_orders])' />
      </column>
      <column caption='Avg Voucher Spend' datatype='real' name='[Calculation_3253850781287186451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_voucher_spend])/SUM([dmart_order_with_voucher])' />
      </column>
      <column caption='Platform KPI 2' datatype='real' name='[Calculation_6555904065287057408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN 1 THEN SUM([Food KPI (copy)_3802023298526461952])*100/SUM([Food KPI (copy)_3802023298526461952])&#10;WHEN 2 THEN SUM([Food KPI (copy)_3802023298526461952])&#10;END' />
      </column>
      <column caption='Food KPI 2' datatype='real' name='[Calculation_6555904065288560641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN 1 THEN SUM([Calculation_3253850781276631046])*100/SUM([Food KPI (copy)_3802023298526461952])&#10;WHEN 2 THEN SUM([Calculation_3253850781276631046])&#10;END' />
      </column>
      <column caption='Dmart KPI 2' datatype='real' name='[Calculation_6555904065290059778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN 1 THEN SUM([Food KPI (copy)_3253850781330571285])*100/SUM([Food KPI (copy)_3802023298526461952])&#10;WHEN 2 THEN SUM([Food KPI (copy)_3253850781330571285])&#10;END' />
      </column>
      <column caption='Shops KPI 2' datatype='real' name='[Calculation_6555904065290321923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN 1 THEN SUM([Food KPI (copy)_3253850781276762119])*100/SUM([Food KPI (copy)_3802023298526461952])&#10;WHEN 2 THEN SUM([Food KPI (copy)_3253850781276762119])&#10;END' />
      </column>
      <column caption='AAA KPI 2' datatype='real' name='[Calculation_6555904065291345924]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN 1 THEN SUM([Shops KPI (copy) (copy)_3253850781276880904])*100/SUM([Food KPI (copy)_3802023298526461952])&#10;WHEN 2 THEN SUM([Shops KPI (copy) (copy)_3253850781276880904])&#10;END' />
      </column>
      <column caption='Churn Month (Formatted)' datatype='string' name='[Calculation_6555904065295544325]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([first_churn_month])=TRUE THEN &quot;No Churn&quot; ELSE str([first_churn_month]) END' />
      </column>
      <column caption='Nominal Delivery Fee' datatype='real' name='[Calculation_6555904065298186246]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_delivery_fee])/SUM([dmart_order_with_df])' />
      </column>
      <column caption='Realised Delivery Fee' datatype='real' name='[Calculation_6555904065298395143]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dmart_delivery_fee])/SUM([dmart_successful_orders])' />
      </column>
      <column caption='Churn' datatype='boolean' name='[Calculation_6555904065314517001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [reporting_month]=[first_churn_month] then true else FALSE end' />
      </column>
      <column caption='Classification L2' datatype='string' name='[Classification L1 (copy)_3253850781274750980]' role='dimension' type='nominal'>
