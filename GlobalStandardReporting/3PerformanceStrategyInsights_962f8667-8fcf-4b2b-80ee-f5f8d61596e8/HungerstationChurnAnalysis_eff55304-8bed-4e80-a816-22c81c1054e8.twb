            <column caption='Ultrafresh Order reactivation' datatype='integer' name='[Ultrafresh_Order_reactivation]' role='measure' type='quantitative' />
            <column caption='Voucher Order reactivation' datatype='integer' name='[Voucher_Order_reactivation]' role='measure' type='quantitative' />
