      <table>
        <view>
          <datasources>
            <datasource caption='_qc_customer_cohorts_chain_name' name='federated.0iv0u350g9d59r10h9mk31mi5bqh' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Retention Rate' caption='KPI Select' datatype='string' name='[Select Second KPI  (copy)_1033013169304920067]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Retention Rate' />
                <alias key='&quot;10&quot;' value='Orders w/Stacked Incentive' />
                <alias key='&quot;11&quot;' value='Stacked Incentive % of GMV' />
                <alias key='&quot;2&quot;' value='Activity' />
                <alias key='&quot;3&quot;' value='Frequency' />
                <alias key='&quot;4&quot;' value='GMV (EUR)' />
                <alias key='&quot;5&quot;' value='ABV (EUR)' />
                <alias key='&quot;6&quot;' value='ABS' />
                <alias key='&quot;7&quot;' value='Orders w/Vouchers%' />
                <alias key='&quot;8&quot;' value='Vouchers% of GMV' />
                <alias key='&quot;9&quot;' value='Discounts % of GMV' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0iv0u350g9d59r10h9mk31mi5bqh'>
            <column caption='AAA Chain' datatype='string' name='[AAA_Chain]' role='dimension' type='nominal' />
            <column caption='KPI Select Third' datatype='real' name='[Calculation_1117455675086770183]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Select Second KPI  (copy)_1033013169304920067]&#13;&#10;WHEN &apos;1&apos;&#13;&#10;THEN ROUND((SUM([returning_users])/SUM([cohort_size]))*100)&#13;&#10;WHEN &apos;2&apos;&#13;&#10;THEN SUM([orders])/SUM([returning_users])&#13;&#10;WHEN &apos;3&apos;&#13;&#10;THEN SUM([orders])/SUM([cohort_size])&#13;&#10;WHEN &apos;4&apos;&#13;&#10;THEN SUM([amt_gmv_eur])&#13;&#10;WHEN &apos;5&apos;&#13;&#10;THEN SUM([amt_gbv_eur])/SUM([orders])&#13;&#10;WHEN &apos;6&apos;&#13;&#10;THEN SUM([qty_sold])/SUM([orders])&#13;&#10;WHEN &apos;7&apos;&#13;&#10;THEN ROUND((SUM([voucher_orders])/SUM([orders]))*100)&#13;&#10;WHEN &apos;8&apos;&#13;&#10;THEN (SUM([amt_voucher_eur])/SUM([amt_gmv_eur]))&#13;&#10;WHEN &apos;9&apos;&#13;&#10;THEN ROUND((SUM([amt_discount_eur])/SUM([amt_gmv_eur]))*100)&#13;&#10;WHEN &apos;10&apos;&#13;&#10;THEN ROUND((SUM([stacked_incentives])/SUM([amt_gmv_eur]))*100)&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='KPI Suffix Third' datatype='string' name='[KPI Suffix Second (copy)_1033013169305124869]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Select Second KPI  (copy)_1033013169304920067]&#13;&#10;WHEN &apos;1&apos;&#13;&#10;THEN &quot;%&quot;&#13;&#10;WHEN &apos;2&apos;&#13;&#10;THEN &quot;&quot;&#13;&#10;WHEN &apos;3&apos;&#13;&#10;THEN &quot;&quot;&#13;&#10;WHEN &apos;4&apos;&#13;&#10;THEN &quot;&quot;&#13;&#10;WHEN &apos;5&apos;&#13;&#10;THEN &quot;&quot;&#13;&#10;WHEN &apos;6&apos;&#13;&#10;THEN &quot;&quot;&#13;&#10;WHEN &apos;7&apos;&#13;&#10;THEN &quot;%&quot;&#13;&#10;WHEN &apos;8&apos;&#13;&#10;THEN &quot;%&quot;&#13;&#10;WHEN &apos;9&apos;&#13;&#10;THEN &quot;%&quot;&#13;&#10;WHEN &apos;10&apos;&#13;&#10;THEN &quot;%&quot;&#13;&#10;WHEN &apos;11&apos;&#13;&#10;THEN &quot;%&quot;&#13;&#10;END' />
            </column>
            <column caption='Amt Discount Eur' datatype='real' name='[amt_discount_eur]' role='measure' type='quantitative' />
            <column caption='GBV (EUR)' datatype='real' name='[amt_gbv_eur]' role='measure' type='quantitative' />
            <column caption='GMV (EUR)' datatype='real' name='[amt_gmv_eur]' role='measure' type='quantitative' />
            <column caption='Amt Voucher Eur' datatype='real' name='[amt_voucher_eur]' role='measure' type='quantitative' />
            <column-instance column='[return_period]' derivation='Attribute' name='[attr:return_period:qk]' pivot='key' type='quantitative' />
            <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='Cohort_Size' datatype='integer' name='[cohort_size]' role='measure' type='quantitative' />
            <column caption='Incentive Type(Trial Order)' datatype='string' name='[incentive]' role='dimension' type='nominal' />
            <column caption='Is Acquisition' datatype='boolean' name='[is_acquisition]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[AAA_Chain]' derivation='None' name='[none:AAA_Chain:nk]' pivot='key' type='nominal' />
            <column-instance column='[Country]' derivation='None' name='[none:Country:nk]' pivot='key' type='nominal' />
            <column-instance column='[KPI Suffix Second (copy)_1033013169305124869]' derivation='None' name='[none:KPI Suffix Second (copy)_1033013169305124869:nk]' pivot='key' type='nominal' />
            <column-instance column='[chain_name]' derivation='None' name='[none:chain_name:nk]' pivot='key' type='nominal' />
