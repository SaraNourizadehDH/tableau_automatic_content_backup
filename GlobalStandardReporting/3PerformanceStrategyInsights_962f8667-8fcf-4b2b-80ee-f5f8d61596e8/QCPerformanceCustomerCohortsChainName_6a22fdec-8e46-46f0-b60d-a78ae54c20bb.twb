      <table>
        <view>
          <datasources>
            <datasource caption='_qc_customer_cohorts_chain_name' name='federated.0iv0u350g9d59r10h9mk31mi5bqh' />
          </datasources>
          <datasource-dependencies datasource='federated.0iv0u350g9d59r10h9mk31mi5bqh'>
            <column caption='AAA Chain' datatype='string' name='[AAA_Chain]' role='dimension' type='nominal' />
            <column caption='SUM([Returning Users])/SUM([Cohort_Size])' datatype='real' name='[Calculation_1074952959340847104]' role='measure' type='quantitative' user:unnamed='QC-RetentionRate'>
              <calculation class='tableau' formula='SUM([returning_users])/SUM([cohort_size])' />
