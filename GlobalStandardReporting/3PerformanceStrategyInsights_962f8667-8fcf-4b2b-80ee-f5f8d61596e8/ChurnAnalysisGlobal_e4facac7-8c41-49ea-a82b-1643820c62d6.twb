      </column>
      <column caption='Baseline - Delivery Time' datatype='real' name='[Baseline -Basket Size (copy)_7018015645663772733]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ FIXED [trial_month],[Month - Trial Month (copy)_7018015645476868114],[Calculation_2156661323041431552]: SUM( IF [Calculation_7018015645479202836] = &quot;No Churn&quot; THEN [dmart_delivery_time_minutes] END ) })/&#10;SUM({ FIXED [trial_month],[Month - Trial Month (copy)_7018015645476868114],[Calculation_2156661323041431552]: SUM( IF [Calculation_7018015645479202836] = &quot;No Churn&quot; THEN [Dmart_order_with_dt] END ) })' />
