    <worksheet name='View 2 - GMV Per Customer'>
      <layout-options>
        <title>
          <formatted-text>
            <run>GMV Per Customer</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='churn_analysis_dmart_output (dev_dmart)' name='federated.1a3tpvk1jnlwgb192vngj18sips6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Country' caption='Granularity' datatype='real' name='[Parameter 4]' param-domain-type='list' role='measure' type='quantitative' value='2.'>
              <calculation class='tableau' formula='2.' />
              <aliases>
                <alias key='1.' value='Management Entity' />
                <alias key='2.' value='Country' />
                <alias key='3.' value='City' />
                <alias key='4.' value='Warehouse' />
              </aliases>
            </column>
            <column alias='Opt Out' caption='Customer Status OptIn' datatype='real' name='[Parameter 5]' param-domain-type='list' role='measure' type='quantitative' value='2.'>
              <calculation class='tableau' formula='2.' />
              <aliases>
                <alias key='1.' value='Opt In' />
                <alias key='2.' value='Opt Out' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1a3tpvk1jnlwgb192vngj18sips6'>
            <column caption='Granularity' datatype='string' name='[Calculation_2156661323041431552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN 1 THEN [management_entity]&#10;WHEN 2 THEN [country_name]&#10;WHEN 3 THEN [trial_warehouse_city]&#10;WHEN 4 THEN [trial_warehouse_name]&#10;END' />
            </column>
            <column caption='Month - Trial Month' datatype='integer' name='[Calculation_3253850781254438912]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[trial_month],[reporting_month])' />
            </column>
            <column caption='Customer Optin' datatype='string' name='[Calculation_5835328163117142016]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 5]=1 then [dmart_customer_status]&#10;ELSE NULL END' />
            </column>
            <column caption='Active Customers' datatype='integer' name='[Calculation_7018015645427593216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [dmart_customer_status] IN (&apos;Active&apos;,&apos;Reactivated&apos;) THEN [Customer_cnt] END)' />
            </column>
            <column caption='Retention Cohort' datatype='string' name='[Calculation_7018015645439098889]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;M&quot;+STR([Calculation_3253850781254438912])' />
            </column>
            <column caption='GMV Per Customer (Food)' datatype='real' name='[Calculation_7018015645465767949]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([food_gmv])/[Calculation_7018015645427593216]' />
            </column>
            <column caption='Customer cnt' datatype='integer' name='[Customer_cnt]' role='measure' type='quantitative' />
            <column caption='GMV Per Customer (Non AAA)' datatype='real' name='[GMV Per Customer (AAA) (copy)_2156661323054776322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ls_gmv]-[aaa_gmv])/[Calculation_7018015645427593216]' />
            </column>
            <column caption='GMV Per Customer (Dmart) ' datatype='real' name='[GMV Per Customer (Food) (copy)_7018015645465948174]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dmart_gmv])/([Calculation_7018015645427593216])' />
            </column>
            <column caption='GMV Per Customer (Shops)' datatype='real' name='[GMV Per Customer (Food) (copy)_7018015645466288143]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ls_gmv])/([Calculation_7018015645427593216])' />
            </column>
            <column caption='GMV Per Customer (AAA)' datatype='real' name='[GMV Per Customer (Shops) (copy)_2156661323054657537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([aaa_gmv])/[Calculation_7018015645427593216]' />
            </column>
            <column caption='GMV Per Customer (Platform)' datatype='real' name='[GMV Per Customer (Shops) (copy)_7018015645466542096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([platform_gmv])/sum([platform_customers])' />
            </column>
            <column datatype='string' name='[Trial_Incentive_Type]' role='dimension' type='nominal' />
            <column caption='Aaa Gmv' datatype='real' name='[aaa_gmv]' role='measure' type='quantitative' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[customer_classification]' role='dimension' type='nominal' />
            <column caption='Delivery Delay Trial Bucket' datatype='string' name='[delivery_delay_trial_bucket]' role='dimension' type='nominal' />
