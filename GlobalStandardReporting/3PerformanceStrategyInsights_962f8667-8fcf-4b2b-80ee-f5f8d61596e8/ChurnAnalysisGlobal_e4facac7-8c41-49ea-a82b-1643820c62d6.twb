    <worksheet name='Dmart KPIs (% Subscription Orders)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='9'>% Subscription Orders</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='churn_analysis_dmart_output (dev_dmart)' name='federated.1a3tpvk1jnlwgb192vngj18sips6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Country' caption='Granularity' datatype='real' name='[Parameter 4]' param-domain-type='list' role='measure' type='quantitative' value='2.'>
              <calculation class='tableau' formula='2.' />
              <aliases>
                <alias key='1.' value='Management Entity' />
                <alias key='2.' value='Country' />
                <alias key='3.' value='City' />
                <alias key='4.' value='Warehouse' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1a3tpvk1jnlwgb192vngj18sips6'>
            <column caption='% Baseline Delta (% Subscription Orders)' datatype='real' name='[% Baseline Delta (% Fresh Orders) (copy)_7018015645658775601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2770980476093939768]-[Baseline - % Fresh Orders (copy)_7018015645658787890]' />
            </column>
            <column caption='Baseline - % Subscription Orders' datatype='real' name='[Baseline - % Fresh Orders (copy)_7018015645658787890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [trial_month],[Month - Trial Month (copy)_7018015645476868114],[Calculation_2156661323041431552]: SUM( IF [Calculation_7018015645479202836] = &quot;No Churn&quot; THEN [order_with_subscription] END ) })/&#10;SUM({ FIXED [trial_month],[Month - Trial Month (copy)_7018015645476868114],[Calculation_2156661323041431552]: SUM( IF [Calculation_7018015645479202836] = &quot;No Churn&quot; THEN [dmart_successful_orders] END ) })' />
            </column>
            <column caption='Granularity' datatype='string' name='[Calculation_2156661323041431552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN 1 THEN [management_entity]&#10;WHEN 2 THEN [country_name]&#10;WHEN 3 THEN [trial_warehouse_city]&#10;WHEN 4 THEN [trial_warehouse_name]&#10;END' />
            </column>
            <column caption='% Subscription Orders' datatype='real' name='[Calculation_2770980476093939768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_with_subscription])/SUM([dmart_successful_orders])' />
            </column>
            <column caption='Trial - Churn (Label)' datatype='string' name='[Calculation_7018015645479202836]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Months (Trial- Churn) (copy)_7018015645478334483]&#10;WHEN NULL THEN &quot;No Churn&quot;&#10;ELSE &quot;Churned in M&quot;+STR([Months (Trial- Churn) (copy)_7018015645478334483])&#10;END' />
            </column>
            <column caption='Reporting Month - Trial Month (Label)' datatype='string' name='[Month - Trial Month (Label) (copy)_7018015645476806673]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;M&quot;+STR([Month - Trial Month (copy)_7018015645476868114])' />
            </column>
            <column caption='Month (Reporting  - Trial)' datatype='integer' name='[Month - Trial Month (copy)_7018015645476868114]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[trial_month],[reporting_month])' />
            </column>
            <column caption='Months (Trial- Churn) ' datatype='integer' name='[Months (Trial- Churn) (copy)_7018015645478334483]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[trial_month],[first_churn_month])' />
            </column>
            <column datatype='string' name='[Trial_Incentive_Type]' role='dimension' type='nominal' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[customer_classification]' role='dimension' type='nominal' />
            <column caption='Delivery Delay Trial Bucket' datatype='string' name='[delivery_delay_trial_bucket]' role='dimension' type='nominal' />
