            <column alias='GMV' caption='KPI Split' datatype='real' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='2.'>
              <calculation class='tableau' formula='2.' />
              <aliases>
                <alias key='1.' value='Orders' />
                <alias key='2.' value='GMV' />
              </aliases>
            </column>
            <column alias='% of Platform' caption='Ratio' datatype='real' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='1.'>
              <calculation class='tableau' formula='1.' />
              <aliases>
                <alias key='1.' value='% of Platform' />
                <alias key='2.' value='Actuals' />
              </aliases>
            </column>
            <column alias='Country' caption='Granularity' datatype='real' name='[Parameter 4]' param-domain-type='list' role='measure' type='quantitative' value='2.'>
              <calculation class='tableau' formula='2.' />
