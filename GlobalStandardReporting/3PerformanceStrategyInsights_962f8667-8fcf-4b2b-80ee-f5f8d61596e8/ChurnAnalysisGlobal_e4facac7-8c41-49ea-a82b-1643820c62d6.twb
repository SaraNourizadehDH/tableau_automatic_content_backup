            <column alias='Opt Out' caption='Customer Status OptIn' datatype='real' name='[Parameter 5]' param-domain-type='list' role='measure' type='quantitative' value='2.'>
              <calculation class='tableau' formula='2.' />
              <aliases>
                <alias key='1.' value='Opt In' />
                <alias key='2.' value='Opt Out' />
              </aliases>
            </column>
