          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1a3tpvk1jnlwgb192vngj18sips6'>
            <column caption='% Baseline Delta (Failed Orders)' datatype='real' name='[% Baseline Delta (copy)_7018015645506080792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3253850781282697230]-[Baseline - Dmart Orders (copy)_7018015645502808087]' />
            </column>
            <column caption='Baseline - Failed Orders' datatype='real' name='[Baseline - Dmart Orders (copy)_7018015645502808087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [trial_month],[Month - Trial Month (copy)_7018015645476868114],[Calculation_2156661323041431552]: SUM( IF [Calculation_7018015645479202836] = &quot;No Churn&quot; THEN [Dmart_Failed_Orders] END ) })/&#10;SUM({ FIXED [trial_month],[Month - Trial Month (copy)_7018015645476868114],[Calculation_2156661323041431552]: SUM( IF [Calculation_7018015645479202836] = &quot;No Churn&quot; THEN [dmart_total_orders] END ) })' />
            </column>
            <column caption='Granularity' datatype='string' name='[Calculation_2156661323041431552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN 1 THEN [management_entity]&#10;WHEN 2 THEN [country_name]&#10;WHEN 3 THEN [trial_warehouse_city]&#10;WHEN 4 THEN [trial_warehouse_name]&#10;END' />
