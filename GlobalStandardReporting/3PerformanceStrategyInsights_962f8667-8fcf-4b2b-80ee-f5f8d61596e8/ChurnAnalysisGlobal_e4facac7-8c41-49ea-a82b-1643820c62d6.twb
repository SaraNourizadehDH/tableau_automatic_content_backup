      <aliases enabled='yes' />
      <column caption='% Ultra Fresh Orders' datatype='real' name='[% Fresh Orders (copy)_2770980476100243523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Ultrafresh_Order_reactivation])/SUM([reactivationed_orders])' />
      </column>
      <column caption='% Orders with both fresh and ultra fresh' datatype='real' name='[% Ultra Fresh Orders (copy)_2770980476100390980]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Fresh_Ultrafresh_Order_reactivation])/SUM([reactivationed_orders])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
