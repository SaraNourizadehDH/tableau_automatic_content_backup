    <worksheet name='View 1 - Retention'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Retention Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='churn_analysis_dmart_output (dev_dmart)' name='federated.1a3tpvk1jnlwgb192vngj18sips6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Basket Size (Trial)' caption='Classification 1' datatype='real' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='14.'>
              <calculation class='tableau' formula='14.' />
              <aliases>
                <alias key='1.' value='Verticals Tried' />
                <alias key='2.' value='Incentive Type (Trial)' />
                <alias key='3.' value='Pre Order' />
                <alias key='4.' value='Delivery Time (Trial)' />
                <alias key='5.' value='Delivery Delay (Trial)' />
                <alias key='6.' value='None' />
                <alias key='7.' value='Category Count' />
                <alias key='8.' value='Fresh/ Ultra Fresh' />
                <alias key='9.' value='Split Order (Trial)' />
                <alias key='10.' value='Stacked Order (Trial)' />
                <alias key='11.' value='Stacking level (Trial)' />
                <alias key='12.' value='H+ vs Non H+' />
                <alias key='13.' value='H+ Vs Free Del' />
                <alias key='14.' value='Basket Size (Trial)' />
                <alias key='15.' value='Partial Order' />
                <alias key='16.' value='AQS (Warehouse of Trial)' />
              </aliases>
            </column>
            <column alias='Country' caption='Granularity' datatype='real' name='[Parameter 4]' param-domain-type='list' role='measure' type='quantitative' value='2.'>
              <calculation class='tableau' formula='2.' />
              <aliases>
                <alias key='1.' value='Management Entity' />
                <alias key='2.' value='Country' />
                <alias key='3.' value='City' />
                <alias key='4.' value='Warehouse' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1a3tpvk1jnlwgb192vngj18sips6'>
            <column caption='Granularity' datatype='string' name='[Calculation_2156661323041431552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN 1 THEN [management_entity]&#10;WHEN 2 THEN [country_name]&#10;WHEN 3 THEN [trial_warehouse_city]&#10;WHEN 4 THEN [trial_warehouse_name]&#10;END' />
            </column>
            <column caption='Month - Trial Month' datatype='integer' name='[Calculation_3253850781254438912]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[trial_month],[reporting_month])' />
            </column>
            <column caption='Classification L1' datatype='string' name='[Calculation_3253850781257199618]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE  [Parameters].[Parameter 1]&#10;WHEN 1 THEN [customer_classification]&#10;WHEN 2 THEN [Trial_Incentive_Type]&#10;WHEN 3 THEN IF([partial_order_trial])=TRUE THEN &quot;1&quot; ELSE &quot;0&quot; END&#10;WHEN 4 THEN [delivery_time_trial_bucket]&#10;WHEN 5 THEN [delivery_delay_trial_bucket]&#10;WHEN 6 THEN NULL&#10;WHEN 7 THEN [Category_Cnt_Bucket]&#10;WHEN 8 THEN [Category_type_bucket]&#10;WHEN 9 THEN IF([split_order_trial])=TRUE THEN &quot;1&quot; ELSE &quot;0&quot; END&#10;WHEN 10 THEN IF([stacked_order_trial])=TRUE THEN &quot;1&quot; ELSE &quot;0&quot; END&#10;WHEN 11 THEN [stacked_deliveries_trial_bucket]&#10;WHEN 12 THEN IF([has_subscription_trial_bucket])=TRUE THEN &quot;H +&quot; ELSE &quot;Non H+&quot; END&#10;WHEN 13 THEN [delivery_fee_benefit_trial_bucket]&#10;WHEN 14 THEN [abs_trial_bucket]&#10;WHEN 15 THEN IF [partial_order_trial]=TRUE THEN &quot;1&quot; ELSE &quot;0&quot; END&#10;END' />
            </column>
            <column caption='Active Customers' datatype='integer' name='[Calculation_7018015645427593216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [dmart_customer_status] IN (&apos;Active&apos;,&apos;Reactivated&apos;) THEN [Customer_cnt] END)' />
            </column>
            <column caption='Cohort Size' datatype='integer' name='[Calculation_7018015645432426499]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [trial_month],[Calculation_3253850781257199618],[Calculation_2156661323041431552]:&#10;    SUM(IF [Calculation_3253850781254438912]=0 THEN [Customer_cnt] END)&#10;}' />
            </column>
            <column caption='Retention Rate' datatype='real' name='[Calculation_7018015645433036804]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [dmart_customer_status] In (&apos;Active&apos;,&apos;Reactivated&apos;) THEN [Customer_cnt] ELSE 0 END)&#10;/&#10;SUM([Calculation_7018015645432426499])' />
            </column>
            <column caption='Retention Label' datatype='string' name='[Calculation_7018015645433688069]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE&#10;[dmart_customer_status]&#10;WHEN &apos;Active&apos; THEN &apos;Retention Rate&apos;&#10;WHEN &apos;Reactivated&apos; THEN &apos;Reactivation Rate&apos;&#10;END' />
            </column>
            <column caption='Retention Cohort' datatype='string' name='[Calculation_7018015645439098889]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;M&quot;+STR([Calculation_3253850781254438912])' />
            </column>
            <column datatype='string' name='[Category_Cnt_Bucket]' role='dimension' type='nominal' />
            <column datatype='string' name='[Category_type_bucket]' role='dimension' type='nominal' />
            <column caption='Customer cnt' datatype='integer' name='[Customer_cnt]' role='measure' type='quantitative' />
            <column datatype='string' name='[Trial_Incentive_Type]' role='dimension' type='nominal' />
            <column datatype='string' name='[abs_trial_bucket]' role='dimension' type='nominal' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[customer_classification]' role='dimension' type='nominal' />
            <column caption='Delivery Delay Trial Bucket' datatype='string' name='[delivery_delay_trial_bucket]' role='dimension' type='nominal' />
