        <zone forceUpdate='true' h='1500' id='109' type-v2='text' w='95688' x='1750' y='1330'>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Regular'>This view highlights </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Regular'>retention rate, active frequency, and GBV per customer</run>
            <run fontcolor='#000000' fontname='Tableau Regular'> across cohort months </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Regular'>M1, M3, and M12</run>
            <run fontcolor='#000000' fontname='Tableau Regular'>:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Regular'>M1</run>
            <run fontcolor='#000000' fontname='Tableau Regular'> → First month after the Dmart trial</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Regular'>M3</run>
            <run fontcolor='#000000' fontname='Tableau Regular'> → Third month after the Dmart trial</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Regular'>M12</run>
            <run fontcolor='#000000' fontname='Tableau Regular'> → Twelfth month after the Dmart trial</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Regular'>Use the Classification </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Regular'>L1 segmentation filter</run>
            <run fontcolor='#000000' fontname='Tableau Regular'> to classify customers based on KPIs from their trial order.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Regular'>Apply the </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Regular'>granularity filter</run>
            <run fontcolor='#000000' fontname='Tableau Regular'> to view results at </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Regular'>country, city, or warehouse level</run>
            <run fontcolor='#000000' fontname='Tableau Regular'>.</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
          </zone-style>
