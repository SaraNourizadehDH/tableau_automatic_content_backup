            <column caption='Delivery Time Trial Bucket' datatype='string' name='[delivery_time_trial_bucket]' role='dimension' type='nominal' />
            <column datatype='string' name='[dmart_customer_status]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Active&quot;' value='Dmart Active Customers' />
                <alias key='&quot;Churned&quot;' value='Dmart Churned Customers' />
                <alias key='&quot;Inactive&quot;' value='Dmart Inactive Customers' />
                <alias key='&quot;Reactivated&quot;' value='Dmart Reactivated Customers' />
              </aliases>
