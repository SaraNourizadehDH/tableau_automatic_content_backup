            <column caption='Dmart Successful Orders' datatype='integer' name='[dmart_successful_orders]' role='measure' type='quantitative' />
            <column caption='Churn Month' datatype='date' name='[first_churn_month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2156661323041431552]' derivation='None' name='[none:Calculation_2156661323041431552:nk]' pivot='key' type='nominal' />
