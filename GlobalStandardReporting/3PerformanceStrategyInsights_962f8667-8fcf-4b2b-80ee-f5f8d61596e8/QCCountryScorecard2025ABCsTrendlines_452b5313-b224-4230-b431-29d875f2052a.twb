            <column caption='Latest Month' datatype='integer' name='[Calculation_4052676767004360713]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='if ATTR([month])=DATE(&apos;3/1/2025&apos;) THEN 1 ELSE 0 END' />
