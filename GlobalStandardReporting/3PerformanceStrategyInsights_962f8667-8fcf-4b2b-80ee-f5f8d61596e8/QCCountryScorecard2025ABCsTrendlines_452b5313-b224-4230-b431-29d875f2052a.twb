            <column caption='AFS' datatype='real' name='[Calculation_5217560907887837184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([AFS_Numerator])/SUM([AFS_Denominator])' />
            </column>
            <column caption='MoM Afs' datatype='real' name='[MoM AQS (copy)_5217560907887980545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM({ Include [month]: ZN([Calculation_5217560907887837184]) })&#10;  -&#10;  LOOKUP(SUM({ Include [month]: ZN([Calculation_5217560907887837184]) }), -1))&#10;/ ABS(LOOKUP(SUM({ Include [month]: ZN([Calculation_5217560907887837184]) }), -1))'>
