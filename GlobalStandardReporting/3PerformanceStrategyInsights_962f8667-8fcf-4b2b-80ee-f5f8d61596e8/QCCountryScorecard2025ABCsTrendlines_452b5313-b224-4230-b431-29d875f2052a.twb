      <aliases enabled='yes' />
      <column caption='Key Partners Per MAU' datatype='real' name='[Calculation_3788723604212981760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([coverage_numerator])/SUM([coverage_denominator])' />
      </column>
      <column caption='QC MAU as % of Platform' datatype='real' name='[Calculation_4052676766865952768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cdwh_qc_mau])/SUM([cdwh_pl_mau])' />
      </column>
      <column caption='SKU Weighted Availability' datatype='real' name='[Calculation_4052676766873055233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([availability_numerator])/SUM([availability_denominator])' />
      </column>
      <column caption='AQS' datatype='real' name='[Calculation_4052676766873489410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([aqs_final_score_with_gbv])/SUM([aqs_gbv])' />
      </column>
      <column caption='Promo GPV %' datatype='real' name='[Calculation_4052676766995591171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([aaa_sm_gpv_promo_items])/SUM([aaa_sm_gpv_all])' />
      </column>
      <column caption='GAQS' datatype='real' name='[Calculation_4052676766996377604]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([GAQS_Numerator])/SUM([GAQS_Denominator])' />
      </column>
      <column caption='Items not delivered as % of Ordered (AAA)' datatype='real' name='[Calculation_4052676766996668421]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([items_not_delivered_numerator])/SUM([items_not_delivered_denominator])' />
      </column>
      <column caption='MoM (QC MAU as % of Platform)' datatype='real' name='[Calculation_4052676767001935879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM({ Include [month]: ZN([Calculation_4052676766865952768]) })&#10;  -&#10;  LOOKUP(SUM({ Include [month]: ZN([Calculation_4052676766865952768]) }), -1))*100'>
          <table-calc ordering-field='[federated.0eh2nw503qffnq15i564d1n6kht2].[month]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='MoM (QC MAU)' datatype='real' name='[Calculation_4052676767002570760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Calculation_4052676766865952768]) - LOOKUP(ZN([Calculation_4052676766865952768]), -1)) / ABS(LOOKUP(ZN([Calculation_4052676766865952768]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Latest Month' datatype='integer' name='[Calculation_4052676767004360713]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='if ATTR([month])=DATE(&apos;3/1/2025&apos;) THEN 1 ELSE 0 END' />
      </column>
      <column caption='MoM Positive Sign' datatype='string' name='[Calculation_4052676767006769166]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_4052676767001935879]&gt;=0 then &quot;▲&quot; end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='MoM Negative Sign' datatype='string' name='[Calculation_4052676767006969871]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_4052676767001935879]&lt;0 then &quot;▼&quot; end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='AFS' datatype='real' name='[Calculation_5217560907887837184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([AFS_Numerator])/SUM([AFS_Denominator])' />
      </column>
      <column caption='QoQ' datatype='datetime' name='[Calculation_6361686372190863363]' role='dimension' type='ordinal'>
