        <calculation class='tableau' formula='IF [experiment_name] = &apos;LATAM-PY|UY|CL|PA&apos; THEN &quot;W24-W30&quot;&#10;ELSEIF [experiment_name] = &apos;MENA-AE|BH|KW&apos; THEN &quot;W26-W31&quot;&#10;ELSEIF [experiment_name] = &apos;MENA-SA&apos; THEN &quot;W26-W31&quot;&#10;ELSEIF [experiment_name] = &apos;EU-NO&apos; THEN &quot;W26-W31&quot;&#10;ELSEIF [experiment_name] = &apos;EU-AT|SK|FI|CY&apos; THEN &quot;W27-W32&quot;&#10;ELSEIF [experiment_name] = &apos;EU-SE&apos; THEN &quot;W27-W32&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-HK|TH|MY&apos; THEN &quot;W31-W34&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
