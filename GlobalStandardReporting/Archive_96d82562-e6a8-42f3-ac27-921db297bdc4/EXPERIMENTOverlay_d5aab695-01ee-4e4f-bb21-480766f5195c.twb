        <calculation class='tableau' formula='SUM({ FIXED [experiment_name], [region], [entity_id], [vendor_grade], [date_type]:&#10;SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [% Metric Numerator (copy)_441634252867358746] END)&#10;})' />
