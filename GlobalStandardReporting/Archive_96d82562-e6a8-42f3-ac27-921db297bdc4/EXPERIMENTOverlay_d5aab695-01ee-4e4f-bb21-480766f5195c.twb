          <datasource-dependencies datasource='federated.0vg9gty0jlgoxv1anoide144u8d9'>
            <column caption='Date' datatype='string' name='[Calculation_693061775437230082]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date]))+&quot;-W&quot;+STR(ISOWEEK([created_date]))&#10;END' />
            </column>
            <column caption='% Metric Numerator' datatype='integer' name='[Calculation_693061775494160390]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;Offline Duration %&quot; THEN [offline_duration]&#10;WHEN &quot;Monitor Offline Rule %&quot; THEN [monitor_rule_offline_duration]&#10;WHEN &quot;Vendor Fail Rate&quot; THEN [vendor_failed_orders]&#10;WHEN &quot;Closed Vendor Fail Rate&quot; THEN [closed_vendor_failed_orders]&#10;WHEN &quot;Too Busy Vendor Fail Rate&quot; THEN [too_busy_vendor_failed_orders]&#10;WHEN &quot;Item Unavailability Vendor Fail Rate&quot; THEN [item_unavailable_vendor_failed_orders]&#10;WHEN &quot;Unreachable Vendor Fail Rate&quot; THEN [unreachable_vendor_failed_orders]&#10;WHEN &quot;No Response Vendor Fail Rate&quot; THEN [no_response_vendor_failed_orders]&#10;END' />
            </column>
            <column caption='% Metric Denominator' datatype='real' name='[Calculation_693061775494680583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;Offline Duration %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Monitor Offline Rule %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;Closed Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;Too Busy Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;Item Unavailability Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;Unreachable Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;No Response Vendor Fail Rate&quot; THEN [orders]&#10;END' />
            </column>
            <column caption='% Metric' datatype='real' name='[Offline Duration % (copy)_212795146002759682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_693061775494160390])/SUM([Calculation_693061775494680583])' />
            </column>
            <column caption='% Metric Divergence' datatype='real' name='[Vendor Fail Rate Divergence Variant A (Pre vs Post Rollouts) (copy)_212795146105204847]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (SUM(IF [experiment_group] != &apos;Baseline&apos; THEN [Calculation_693061775494160390] END)/SUM(IF [experiment_group] != &apos;Baseline&apos; THEN [Calculation_693061775494680583] END)) &#10;    /&#10;    (SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [Calculation_693061775494160390] END)/SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [Calculation_693061775494680583] END))&#10;)&#10;- 1' />
