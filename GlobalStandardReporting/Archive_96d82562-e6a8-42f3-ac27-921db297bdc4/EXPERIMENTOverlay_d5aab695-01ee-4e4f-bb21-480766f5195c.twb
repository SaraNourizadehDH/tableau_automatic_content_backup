              <calculation class='tableau' formula='IF [experiment_name] = &apos;LATAM-PY|UY|CL|PA&apos; AND [created_date] &gt;= DATE(&apos;2022-08-15&apos;) AND [created_date] &lt;= DATE(&apos;2022-10-02&apos;) THEN &quot;W33-W39&quot;&#10;ELSEIF [experiment_name] = &apos;MENA-AE|BH|KW&apos; AND [created_date] &gt;= DATE(&apos;2022-08-15&apos;) AND [created_date] &lt;= DATE(&apos;2022-09-25&apos;) THEN &quot;W33-W38&quot;&#10;ELSEIF [experiment_name] = &apos;MENA-SA&apos; AND [created_date] &gt;= DATE(&apos;2022-08-15&apos;) AND [created_date] &lt;= DATE(&apos;2022-09-25&apos;) THEN &quot;W33-W38&quot;&#10;ELSEIF [experiment_name] = &apos;EU-NO&apos; AND [created_date] &gt;= DATE(&apos;2022-08-15&apos;) AND [created_date] &lt;= DATE(&apos;2022-09-25&apos;) THEN &quot;W33-W38&quot;&#10;ELSEIF [experiment_name] = &apos;EU-AT|SK|FI|CY&apos; AND [created_date] &gt;= DATE(&apos;2022-08-22&apos;) AND [created_date] &lt;= DATE(&apos;2022-10-02&apos;) THEN &quot;W34-W39&quot;&#10;ELSEIF [experiment_name] = &apos;EU-SE&apos; AND [created_date] &gt;= DATE(&apos;2022-08-22&apos;) AND [created_date] &lt;= DATE(&apos;2022-10-02&apos;) THEN &quot;W34-W39&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-HK|TH|MY&apos; AND [created_date] &gt;= DATE(&apos;2022-09-05&apos;) AND [created_date] &lt;= DATE(&apos;2022-10-02&apos;) THEN &quot;W36-W39&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
