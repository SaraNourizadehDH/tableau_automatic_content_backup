        <calculation class='tableau' formula='IF [Calculation_418201462836531203] = &apos;N/A&apos; THEN &quot;Pre&quot;&#10;ELSEIF [Calculation_418201462828920833] = &apos;N/A&apos; THEN &quot;Post&quot;&#10;END' />
      </column>
      <column caption='Offline Duration %' datatype='real' name='[Calculation_4848195386620149761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([offline_duration])/SUM([daily_schedule_duration])' />
      </column>
      <column caption='Monitor Offline Duration %' datatype='real' name='[Calculation_4848195386620248066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([monitor_rule_offline_duration])/SUM([daily_schedule_duration])' />
      </column>
      <column caption='Vendor Fail Rate' datatype='real' name='[Calculation_4848195386620370947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
      </column>
      <column caption='Variant' datatype='boolean' name='[Calculation_4848195386621218820]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = [experiment_group]&#10;OR [experiment_group] = &quot;Baseline&quot;' />
      </column>
      <column caption='Delta Phase' datatype='string' name='[Calculation_4848195386623766534]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4848195386618671104] = &quot;Post&quot; THEN &quot;Post ∆ (&quot; + [Parameters].[Parameter 1] + &quot; - Baseline)&quot;&#10;ELSEIF [Calculation_4848195386618671104] = &quot;Pre&quot; THEN &quot;Pre ∆ (&quot; + [Parameters].[Parameter 1] + &quot; - Baseline)&quot;&#10;END' />
      </column>
      <column caption='Days Till/Since Rollout' datatype='integer' name='[Calculation_485825823130701828]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [rollout_date], [created_date])' />
      </column>
      <column caption='_user_entitlement' datatype='boolean' name='[Calculation_693061775433273344]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Parameters' datatype='string' name='[Calculation_693061775434362881]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [experiment_group]&#10;WHEN &quot;Baseline&quot; THEN &quot;Disabled&quot;&#10;WHEN &quot;Variant A&quot; THEN &quot;Enabled, Sound Frequency = 180 seconds, Overlay Frequency = 30 minutes&quot;&#10;WHEN &quot;Variant B&quot; THEN &quot;Enabled, Sound Frequency = 180 seconds, Overlay Frequency = 15 minutes&quot;&#10;WHEN &quot;Variant C&quot; THEN &quot;Enabled, Sound Frequency = 300 seconds, Overlay Frequency = 30 minutes&quot;&#10;WHEN &quot;Variant D&quot; THEN &quot;Enabled, Sound Frequency = 600 seconds, Overlay Frequency = 30 minutes&quot;&#10;WHEN &quot;Variant E&quot; THEN &quot;Enabled, Sound Frequency = 1200 seconds, Overlay Frequency = 30 minutes&quot;&#10;END' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_693061775437230082]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date]))+&quot;-W&quot;+STR(ISOWEEK([created_date]))&#10;END' />
      </column>
      <column caption='Successful Orders' datatype='integer' name='[Calculation_693061775476678660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[orders] - [failed_orders]' />
      </column>
      <column caption='% Metric Numerator' datatype='integer' name='[Calculation_693061775494160390]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;Offline Duration %&quot; THEN [offline_duration]&#10;WHEN &quot;Monitor Offline Rule %&quot; THEN [monitor_rule_offline_duration]&#10;WHEN &quot;Vendor Fail Rate&quot; THEN [vendor_failed_orders]&#10;WHEN &quot;Closed Vendor Fail Rate&quot; THEN [closed_vendor_failed_orders]&#10;WHEN &quot;Too Busy Vendor Fail Rate&quot; THEN [too_busy_vendor_failed_orders]&#10;WHEN &quot;Item Unavailability Vendor Fail Rate&quot; THEN [item_unavailable_vendor_failed_orders]&#10;WHEN &quot;Unreachable Vendor Fail Rate&quot; THEN [unreachable_vendor_failed_orders]&#10;WHEN &quot;No Response Vendor Fail Rate&quot; THEN [no_response_vendor_failed_orders]&#10;END' />
      </column>
      <column caption='% Metric Denominator' datatype='real' name='[Calculation_693061775494680583]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;Offline Duration %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Monitor Offline Rule %&quot; THEN [daily_schedule_duration]&#10;WHEN &quot;Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;Closed Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;Too Busy Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;Item Unavailability Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;Unreachable Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;No Response Vendor Fail Rate&quot; THEN [orders]&#10;END' />
      </column>
      <column caption='Dismiss %' datatype='real' name='[Display % (copy)_171277580578631691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([closing_awareness_overlay_dismissed_vendors]) / SUM([closing_awareness_overlay_vendors])' />
      </column>
      <column caption='Target Inventory' datatype='real' name='[Inventory (copy)_203858272668831746]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [experiment_name]&#10;WHEN &quot;LATAM-PY|UY|CL|PA&quot; THEN&#10;    CASE [experiment_group]&#10;    WHEN &quot;Baseline&quot; THEN 0.25&#10;    WHEN &quot;Variant A&quot; THEN 0.25&#10;    WHEN &quot;Variant B&quot; THEN 0.25&#10;    WHEN &quot;Variant C&quot; THEN 0.25&#10;    END&#10;WHEN &quot;MENA-AE|BH|KW&quot; THEN&#10;    CASE [experiment_group]&#10;    WHEN &quot;Baseline&quot; THEN 0.25&#10;    WHEN &quot;Variant A&quot; THEN 0.25&#10;    END&#10;WHEN &quot;MENA-SA&quot; THEN&#10;    CASE [experiment_group]&#10;    WHEN &quot;Baseline&quot; THEN 0.5&#10;    WHEN &quot;Variant C&quot; THEN 0.5&#10;    END&#10;WHEN &quot;EU-NO&quot; THEN&#10;    CASE [experiment_group]&#10;    WHEN &quot;Baseline&quot; THEN 0.5&#10;    WHEN &quot;Variant C&quot; THEN 0.5&#10;    END&#10;WHEN &quot;EU-AT|SK|FI|CY&quot; THEN&#10;    CASE [experiment_group]&#10;    WHEN &quot;Baseline&quot; THEN 0.5&#10;    WHEN &quot;Variant C&quot; THEN 0.5&#10;    END&#10;WHEN &quot;EU-SE&quot; THEN&#10;    CASE [experiment_group]&#10;    WHEN &quot;Baseline&quot; THEN 0.5&#10;    WHEN &quot;Variant C&quot; THEN 0.5&#10;    END&#10;WHEN &quot;APAC-HK|TH|MY&quot; THEN&#10;    CASE [experiment_group]&#10;    WHEN &quot;Baseline&quot; THEN 0.33&#10;    WHEN &quot;Variant D&quot; THEN 0.33&#10;    WHEN &quot;Variant E&quot; THEN 0.33&#10;    END&#10;END' />
      </column>
