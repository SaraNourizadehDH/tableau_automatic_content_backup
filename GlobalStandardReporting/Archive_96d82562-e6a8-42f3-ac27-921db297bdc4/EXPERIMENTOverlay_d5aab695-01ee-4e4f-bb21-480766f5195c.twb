          <datasource-dependencies datasource='federated.0vg9gty0jlgoxv1anoide144u8d9'>
            <column caption='# Metric Value' datatype='integer' name='[% Metric Numerator (copy)_441634252867358746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[% Metric (copy)_441634252866924569]&#10;WHEN &quot;Successful Orders&quot; THEN [Calculation_693061775476678660]&#10;WHEN &quot;Live Order Contacts&quot; THEN [total_live_order_contacts]&#10;END' />
            </column>
            <column caption='Baseline Post (# Metric)' datatype='integer' name='[Baseline Post Rollout 28D (% Metric) (copy)_441634252866859029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [experiment_name], [region], [entity_id], [vendor_grade], [date_type]:&#10;SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [% Metric Numerator (copy)_441634252867358746] END)&#10;})' />
            </column>
            <column caption='Baseline Pre (# Metric)' datatype='integer' name='[Baseline Pre Rollout 28D (% Metric) (copy)_441634252866859031]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [experiment_name], [region], [entity_id], [vendor_grade], [date_type]:&#10;SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [% Metric Numerator (copy)_441634252867358746] END)&#10;})' />
            </column>
            <column caption='Analysis Timespan (Pre-Rollout)' datatype='string' name='[Calculation_418201462828920833]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [experiment_name] = &apos;LATAM-PY|UY|CL|PA&apos; AND [created_date] &gt;= DATE(&apos;2022-06-13&apos;) AND [created_date] &lt;= DATE(&apos;2022-07-31&apos;) THEN &quot;W24-W30&quot;&#10;ELSEIF [experiment_name] = &apos;MENA-AE|BH|KW&apos; AND [created_date] &gt;= DATE(&apos;2022-06-27&apos;) AND [created_date] &lt;= DATE(&apos;2022-08-07&apos;) THEN &quot;W26-W31&quot;&#10;ELSEIF [experiment_name] = &apos;MENA-SA&apos; AND [created_date] &gt;= DATE(&apos;2022-06-27&apos;) AND [created_date] &lt;= DATE(&apos;2022-08-07&apos;) THEN &quot;W26-W31&quot;&#10;ELSEIF [experiment_name] = &apos;EU-NO&apos; AND [created_date] &gt;= DATE(&apos;2022-06-27&apos;) AND [created_date] &lt;= DATE(&apos;2022-08-07&apos;) THEN &quot;W26-W31&quot;&#10;ELSEIF [experiment_name] = &apos;EU-AT|SK|FI|CY&apos; AND [created_date] &gt;= DATE(&apos;2022-07-04&apos;) AND [created_date] &lt;= DATE(&apos;2022-08-14&apos;) THEN &quot;W27-W32&quot;&#10;ELSEIF [experiment_name] = &apos;EU-SE&apos; AND [created_date] &gt;= DATE(&apos;2022-07-04&apos;) AND [created_date] &lt;= DATE(&apos;2022-08-14&apos;) THEN &quot;W27-W32&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-HK|TH|MY&apos; AND [created_date] &gt;= DATE(&apos;2022-08-01&apos;) AND [created_date] &lt;= DATE(&apos;2022-08-28&apos;) THEN &quot;W31-W34&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
