          <datasource-dependencies datasource='federated.0vg9gty0jlgoxv1anoide144u8d9'>
            <column caption='Pre-Post Checker' datatype='string' name='[Calculation_337277410516295680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF RIGHT([Rollout Phase (copy)_396387155264122882], 3) = &quot;Pre&quot; THEN &quot;Pre&quot;&#10;ELSEIF RIGHT([Rollout Phase (copy)_396387155264122882], 4) = &quot;Post&quot; THEN &quot;Post&quot;&#10;END' />
            </column>
            <column caption='Timespan' datatype='boolean' name='[Calculation_396387155265060867]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_418201462836531203] != &quot;N/A&quot; OR [Calculation_418201462828920833] != &quot;N/A&quot; THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Analysis Timespan (Pre-Rollout)' datatype='string' name='[Calculation_418201462828920833]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [experiment_name] = &apos;LATAM-PY|UY|CL|PA&apos; AND [created_date] &gt;= DATE(&apos;2022-06-13&apos;) AND [created_date] &lt;= DATE(&apos;2022-07-31&apos;) THEN &quot;W24-W30&quot;&#10;ELSEIF [experiment_name] = &apos;MENA-AE|BH|KW&apos; AND [created_date] &gt;= DATE(&apos;2022-06-27&apos;) AND [created_date] &lt;= DATE(&apos;2022-08-07&apos;) THEN &quot;W26-W31&quot;&#10;ELSEIF [experiment_name] = &apos;MENA-SA&apos; AND [created_date] &gt;= DATE(&apos;2022-06-27&apos;) AND [created_date] &lt;= DATE(&apos;2022-08-07&apos;) THEN &quot;W26-W31&quot;&#10;ELSEIF [experiment_name] = &apos;EU-NO&apos; AND [created_date] &gt;= DATE(&apos;2022-06-27&apos;) AND [created_date] &lt;= DATE(&apos;2022-08-07&apos;) THEN &quot;W26-W31&quot;&#10;ELSEIF [experiment_name] = &apos;EU-AT|SK|FI|CY&apos; AND [created_date] &gt;= DATE(&apos;2022-07-04&apos;) AND [created_date] &lt;= DATE(&apos;2022-08-14&apos;) THEN &quot;W27-W32&quot;&#10;ELSEIF [experiment_name] = &apos;EU-SE&apos; AND [created_date] &gt;= DATE(&apos;2022-07-04&apos;) AND [created_date] &lt;= DATE(&apos;2022-08-14&apos;) THEN &quot;W27-W32&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-HK|TH|MY&apos; AND [created_date] &gt;= DATE(&apos;2022-08-01&apos;) AND [created_date] &lt;= DATE(&apos;2022-08-28&apos;) THEN &quot;W31-W34&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
            </column>
            <column caption='Analysis Timespan (Post-Rollout)' datatype='string' name='[Calculation_418201462836531203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [experiment_name] = &apos;LATAM-PY|UY|CL|PA&apos; AND [created_date] &gt;= DATE(&apos;2022-08-15&apos;) AND [created_date] &lt;= DATE(&apos;2022-10-02&apos;) THEN &quot;W33-W39&quot;&#10;ELSEIF [experiment_name] = &apos;MENA-AE|BH|KW&apos; AND [created_date] &gt;= DATE(&apos;2022-08-15&apos;) AND [created_date] &lt;= DATE(&apos;2022-09-25&apos;) THEN &quot;W33-W38&quot;&#10;ELSEIF [experiment_name] = &apos;MENA-SA&apos; AND [created_date] &gt;= DATE(&apos;2022-08-15&apos;) AND [created_date] &lt;= DATE(&apos;2022-09-25&apos;) THEN &quot;W33-W38&quot;&#10;ELSEIF [experiment_name] = &apos;EU-NO&apos; AND [created_date] &gt;= DATE(&apos;2022-08-15&apos;) AND [created_date] &lt;= DATE(&apos;2022-09-25&apos;) THEN &quot;W33-W38&quot;&#10;ELSEIF [experiment_name] = &apos;EU-AT|SK|FI|CY&apos; AND [created_date] &gt;= DATE(&apos;2022-08-22&apos;) AND [created_date] &lt;= DATE(&apos;2022-10-02&apos;) THEN &quot;W34-W39&quot;&#10;ELSEIF [experiment_name] = &apos;EU-SE&apos; AND [created_date] &gt;= DATE(&apos;2022-08-22&apos;) AND [created_date] &lt;= DATE(&apos;2022-10-02&apos;) THEN &quot;W34-W39&quot;&#10;ELSEIF [experiment_name] = &apos;APAC-HK|TH|MY&apos; AND [created_date] &gt;= DATE(&apos;2022-09-05&apos;) AND [created_date] &lt;= DATE(&apos;2022-10-02&apos;) THEN &quot;W36-W39&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
            </column>
            <column caption='Offline Duration %' datatype='real' name='[Calculation_4848195386620149761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([offline_duration])/SUM([daily_schedule_duration])' />
            </column>
            <column caption='Monitor Offline Duration %' datatype='real' name='[Calculation_4848195386620248066]' role='measure' type='quantitative'>
