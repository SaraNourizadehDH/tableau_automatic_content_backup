      <aliases enabled='yes' />
      <column caption='Beg. Inventory - DMart' datatype='integer' name='[Beg. Inventory - All (copy) (copy)_623889339245801483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(&#10;IF [Calculation_35958496184770560] = [Date (copy)_623889338208264192]&#10;THEN&#10;{FIXED [period], [dc_warehouse_id], [src_supplier_id]: [Calculation_6497075814883016710]}&#10;END&#10;)' />
      </column>
      <column caption='End.  Inventory - All' datatype='integer' name='[Beg. Inventory - All (copy)_623889339237625864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(&#10;IF [Calculation_35958496184770560] = [Date (DOH) (copy)_623889339243679753]&#10;THEN&#10;{FIXED [period], [dc_warehouse_id], [src_supplier_id]: MAX([total_inventory])}&#10;END&#10;)' />
      </column>
      <column caption='Beg. Inventory - DC' datatype='integer' name='[Beg. Inventory - All (copy)_623889339245793290]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(&#10;IF [Calculation_35958496184770560] = [Date (copy)_623889338208264192]&#10;THEN&#10;{FIXED [period], [dc_warehouse_id], [src_supplier_id]: [Calculation_5678124404093554691]}&#10;END&#10;)' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_35958496184770560]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1], [period]))' />
      </column>
      <column caption='Inbound Qty (items)' datatype='integer' name='[Calculation_360991658973016070]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;yes&apos; THEN [src_qty_delivered_final] &#10;ELSE [src_qty_delivered] END' />
      </column>
      <column caption='Total Purchase Orders' datatype='integer' name='[Calculation_5678124404091736064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [period], [dc_warehouse_id]: MAX([total_orders])})' />
      </column>
      <column caption='Purchase Orders (To DC)' datatype='integer' name='[Calculation_5678124404092383233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [period], [store_name], [src_supplier_id]: MAX([complete_orders])})' />
      </column>
      <column caption='DC - Inventory (Item Level)' datatype='integer' name='[Calculation_5678124404093554691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([dc_total_inventory])' />
      </column>
      <column caption='Share of SKUs at DC' datatype='real' name='[Calculation_5678124404095733767]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Items at DC (copy)_5678124404093820932]/MAX([distinct_skus])' />
      </column>
      <column caption='DC - Inbound (Item Level)' datatype='integer' name='[Calculation_5678124404108431368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [period], [store_name], [src_supplier_id]: MAX([Calculation_360991658973016070])})' />
      </column>
      <column caption='Country Availability (All Stores)' datatype='real' name='[Calculation_5678124404109910026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([available_hours])/SUM([potential_hours])' />
      </column>
      <column caption='DC Inbound (via PO)' datatype='integer' name='[Calculation_623889338909364225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [period], [dc_warehouse_id], [src_supplier_id]: MAX([Calculation_360991658973016070])})' />
      </column>
      <column caption='Centralization %' datatype='real' name='[Calculation_623889338921988100]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_623889338909364225]/([Calculation_623889338909364225]+[DC Inbound (through PO) (copy)_623889338921537538])' />
      </column>
      <column caption='Avg Daily Sales - Country' datatype='real' name='[Calculation_623889339236679686]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([qty_sold_l30d])/30' />
      </column>
      <column caption='Beg. Inventory - All' datatype='integer' name='[Calculation_623889339237437447]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(&#10;IF [Calculation_35958496184770560] = [Date (copy)_623889338208264192]&#10;THEN&#10;{FIXED [period], [dc_warehouse_id], [src_supplier_id]: MAX([total_inventory])}&#10;END&#10;)' />
      </column>
      <column caption='Days On Hand - All' datatype='real' name='[Calculation_6497075814876270595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([Calculation_623889339237437447]+[Beg. Inventory - All (copy)_623889339237625864])/2)/[Calculation_623889339236679686]' />
