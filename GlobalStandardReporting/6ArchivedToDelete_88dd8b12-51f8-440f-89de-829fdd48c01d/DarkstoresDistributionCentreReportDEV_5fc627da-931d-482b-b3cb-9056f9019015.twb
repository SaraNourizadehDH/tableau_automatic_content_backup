            </column>
            <column caption='Fill Rate -  DC' datatype='real' name='[Calculation_6497075814897815560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5678124404108431368]/[Calculation_6497075814899204105]' />
            </column>
            <column caption='DC - Qty Ordered' datatype='integer' name='[Calculation_6497075814899204105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [period], [store_name], [src_supplier_id]: MAX([src_qty_ordered])})' />
            </column>
            <column caption='DC Availability' datatype='real' name='[Country Availability (All Stores) (copy)_473581651103875073]' role='measure' type='quantitative'>
