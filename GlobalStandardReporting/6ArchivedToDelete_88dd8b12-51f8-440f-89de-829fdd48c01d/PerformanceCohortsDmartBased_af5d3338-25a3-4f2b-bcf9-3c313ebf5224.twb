      <column caption='ABV LC' datatype='real' name='[ABV EUR (copy)_5433100391793811456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([amt_gmv_lc]) / SUM([orders])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1631147548753129472]' role='dimension' type='nominal'>
