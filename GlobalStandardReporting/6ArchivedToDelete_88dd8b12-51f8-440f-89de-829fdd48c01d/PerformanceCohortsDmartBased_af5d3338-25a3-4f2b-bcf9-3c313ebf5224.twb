      </column>
      <column caption='Daily Orders' datatype='real' name='[Calculation_499406997281488896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) / 30' />
      </column>
      <column caption='ABV EUR' datatype='real' name='[Calculation_499406997895581699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([amt_gmv_eur]) / SUM([orders])' />
      </column>
      <column caption='ABV EUR/LC' datatype='real' name='[Calculation_5433100391793905665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;EUR&apos; THEN [Calculation_499406997895581699]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;LC&apos; THEN [ABV EUR (copy)_5433100391793811456] END' />
      </column>
      <column caption='Daily Orders (copy)' datatype='real' name='[Daily Orders (copy)_499406997639577601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) / SUM([cohort_size]) / 30' />
      </column>
