    <dashboard name='KPI/Metric Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/DarkStores-SKUDensityReport/KPIMetricDefinitions?rev=' id='KPIMetricDefinitions' path='/t/GlobalStandardReporting/workbooks/DarkStores-SKUDensityReport' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#555555' />
        </style-rule>
      </style>
      <size maxheight='1500' maxwidth='1200' minheight='1500' minwidth='1200' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='5467' id='3' type-v2='text' w='98666' x='667' y='533'>
            <formatted-text>
              <run fontcolor='#ffffff' fontsize='14'>KPI Definitions</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='30200' id='5' type-v2='text' w='98666' x='667' y='6000'>
            <formatted-text>
              <run bold='true' fontcolor='#ffffff' fontsize='12'>Warehouse Launch Date: </run>
              <run fontcolor='#ffffff' fontsize='12'>Currently set to the first order date of each warehouse</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='12'>Available SKUs</run>
              <run fontcolor='#ffffff' fontsize='12'>: SKUs  with on hand  qty &gt; 0 </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='12'>Listed SKUs</run>
              <run fontcolor='#ffffff' fontsize='12'>: A SKU which is active in catalog, has had stock movement in the last 30 days </run>
              <run>Æ&#10;</run>
              <run fontcolor='#ffffff' fontsize='12'>and has an open Purchase Order(s) with a warehouse/warehouses</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='12'>All SKUs</run>
              <run fontcolor='#ffffff' fontsize='12'>: All SKUs available in the inventory mangement tool  (Active +Inactive SKUs) </run>
              <run>Æ&#10;</run>
              <run fontcolor='#ffffff' fontsize='12'>Æ     </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='12'>Active SKUs</run>
              <run fontcolor='#ffffff' fontsize='12'>: All active skus (Stale + Listed SKUs) </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='12'>Inactive SKUs</run>
              <run fontcolor='#ffffff' fontsize='12'>: All inactive skus</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='12'>Stale SKUs</run>
              <run fontcolor='#ffffff' fontsize='12'>: Non listed skus, this is a subset of active SKUs</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='12'>Mature Warehouse</run>
              <run fontcolor='#ffffff' fontsize='12'>: Warehouses with customer orders and has been operating for more than 30 days</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='12'>Non-Mature Warehouse</run>
              <run fontcolor='#ffffff' fontsize='12'>: Warehouses with customer orders and has been operating for less than 30 days</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='63267' id='6' type-v2='empty' w='98666' x='667' y='36200'>
