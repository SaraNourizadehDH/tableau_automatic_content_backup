              <calculation class='tableau' formula='IF [is_mature]= TRUE THEN &quot;Mature&quot; ELSE &quot;Non-Mature&quot; END' />
            </column>
            <column caption='At Launch' datatype='real' name='[Calculation_3520055737162305539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_3520055737184313356] = [period] THEN [available_skus] ELSE NULL END' />
            </column>
            <column caption='Currently Available' datatype='real' name='[Calculation_3520055737163857925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [period] = TODAY()-1 THEN [available_skus] ELSE NULL END' />
            </column>
            <column caption='Warehouse Launch Date' datatype='date' name='[Calculation_3520055737184313356]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[first_order_date]' />
