      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.10cj5hr1w0xc1t1egbt2u0ickoqy].[avg:active_skus:qk]&quot;' value='Active Skus' />
          <alias key='&quot;[federated.10cj5hr1w0xc1t1egbt2u0ickoqy].[avg:all_skus:qk]&quot;' value='All Skus' />
          <alias key='&quot;[federated.10cj5hr1w0xc1t1egbt2u0ickoqy].[avg:inactive_skus:qk]&quot;' value='Inactive Skus' />
          <alias key='&quot;[federated.10cj5hr1w0xc1t1egbt2u0ickoqy].[avg:listed_skus:qk]&quot;' value='Listed Skus' />
          <alias key='&quot;[federated.10cj5hr1w0xc1t1egbt2u0ickoqy].[avg:stale_skus:qk]&quot;' value='Stale Skus' />
        </aliases>
      </column>
      <column caption='User Entitlements' datatype='boolean' name='[Calculation_3479241885892276224]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Warehouse Maturity' datatype='string' name='[Calculation_3520055737129607168]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_mature]= TRUE THEN &quot;Mature&quot; ELSE &quot;Non-Mature&quot; END' />
      </column>
      <column caption='Warehouses' datatype='integer' name='[Calculation_3520055737130700801]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(COUNTD([warehouse_id]))' />
      </column>
      <column caption='At Launch' datatype='real' name='[Calculation_3520055737162305539]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_3520055737184313356] = [period] THEN [available_skus] ELSE NULL END' />
      </column>
      <column caption='Currently Available' datatype='real' name='[Calculation_3520055737163857925]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [period] = TODAY()-1 THEN [available_skus] ELSE NULL END' />
      </column>
      <column caption='Warehouse Launch Date' datatype='date' name='[Calculation_3520055737184313356]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[first_order_date]' />
      </column>
      <column caption='Time Since Launch' datatype='integer' name='[Calculation_3520055737189081107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF([Parameters].[Parameter 2],[Calculation_3520055737184313356],[period])' />
      </column>
      <column caption='Dynamic &apos;Time Since Bin&apos; Names' datatype='string' name='[Calculation_3520055737214799892]' role='dimension' type='nominal'>
