            <column caption='Launch +3 Months' datatype='real' name='[Launch +1 Month (copy)_3520055737185832973]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [period] = [Calculation_3520055737184313356]+ 90 THEN [available_skus] ELSE NULL END' />
            </column>
            <column caption='Launch +1 Month' datatype='real' name='[Launch +1 Week (copy) (copy) (copy)_3520055737165430793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [period] = [Calculation_3520055737184313356]+ 30 THEN [available_skus] ELSE NULL END' />
            </column>
            <column caption='Launch +2 Weeks' datatype='real' name='[Launch +1 Week (copy) (copy)_3520055737165414408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [period] = [Calculation_3520055737184313356]+ 14 THEN [available_skus] ELSE NULL END' />
            </column>
            <column caption='Launch +1 Week' datatype='real' name='[Launch +1Month (copy)_3520055737164554246]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [period] = [Calculation_3520055737184313356]+ 7 THEN [available_skus] ELSE NULL END' />
            </column>
            <column caption='Launch +6 Months ' datatype='real' name='[Launch +5 Months (copy)_3520055737187229713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [period] = [Calculation_3520055737184313356]+ 180 THEN [available_skus] ELSE NULL END' />
            </column>
            <column caption='Launch +1 Year ' datatype='real' name='[Launch &gt;1 Year (copy)_3520055737187692562]' role='measure' type='quantitative'>
