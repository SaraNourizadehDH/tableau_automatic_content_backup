    <worksheet name='Dmart Coverage&amp;Choice M (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_weekly_business_review (rl_dmart)' name='federated.00rxwq200obggy128txgo1bljg5g' />
          </datasources>
          <datasource-dependencies datasource='federated.00rxwq200obggy128txgo1bljg5g'>
            <column caption='Avg Delivery Fee Restaurant' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Avg Delivery Fee dmart (copy)_1894396975229235203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurant_total_delivery_fee])/ SUM([restaurant_orders_w_delivery_fee])' />
            </column>
            <column caption='Last Period Avg Delivery Time Dmart ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg Delivery Time Dmart (copy)_4935523044400091149]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([last_period_total_delivery_time_dmart]) / SUM([last_period_orders_dmart_w_delivery_time])' />
            </column>
            <column caption='Last Period Avg Orders per Dmart' datatype='real' name='[Avg Orders per Dmart (copy)_4935523044382203907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([last_period_sent_orders_dmart]) / SUM([last_period_count_active_dmart_vendor])) / MAX([last_time_period_duration])' />
            </column>
            <column caption='GMV w/o Tax  dmart' datatype='real' name='[Calculation_1429329999824568322]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_gmv_eur_dmart]) / (1 + MAX(IFNULL([pct_tax],0)))' />
            </column>
            <column caption='% Shrinkage' datatype='real' default-format='p0.00%' name='[Calculation_1429329999878914053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shrinkage_eur]) / [Calculation_5860871966613491712]' />
            </column>
            <column caption='% Cohort Reorder - Dmart' datatype='real' default-format='p0.00%' name='[Calculation_1429329999887142919]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_reorder_dmart]) / SUM([last_week_customer_count_dmart])' />
            </column>
            <column caption='% MoM Orders - All Verticals' datatype='real' default-format='p0.00%' name='[Calculation_4131630460001132544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_orders_all_verticals] - [last_period_total_orders_all_verticals]) / SUM([last_period_total_orders_all_verticals])' />
            </column>
            <column caption='New Warhouse Count - Dmart' datatype='integer' name='[Calculation_4171248049470947329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([new_warehouse_count_dmart], 0)' />
            </column>
            <column caption='% Orders w Campaign' datatype='real' default-format='p0.00%' name='[Calculation_433401122295783425]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_campaign_orders_dmart]) / SUM([total_orders_dmart])' />
            </column>
            <column caption='Net Margin' datatype='real' name='[Calculation_4477915103426277378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_price_paid_net_eur]) - SUM(IFNULL([dmart_cogs], 0)))&#10;/ &#10;SUM([total_price_paid_net_eur])' />
            </column>
            <column caption='Avg Orders per Dmart' datatype='real' name='[Calculation_4935523044379795457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_sent_orders_dmart]) / SUM([count_active_dmart_vendor]))/  MAX([current_time_period_duration])' />
            </column>
            <column caption='% MoM Orders - Dmart' datatype='real' default-format='p0.00%' name='[Calculation_4935523044381356034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_sent_orders_dmart]-[last_period_sent_orders_dmart]) / SUM([last_period_sent_orders_dmart])' />
            </column>
            <column caption='Avg Basket Value Dmart' datatype='real' name='[Calculation_4935523044390092804]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_gmv_eur_dmart]) / SUM([total_sent_orders_dmart])' />
            </column>
            <column caption='Avg Food Value - Restaurant' datatype='real' name='[Calculation_4935523044391505925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurant_gmv]) / SUM([restaurant_order_total])' />
            </column>
            <column caption='% ABV of AFV Dmart' datatype='real' default-format='p0.00%' name='[Calculation_4935523044391759878]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_4935523044390092804] - [Calculation_4935523044391505925]) / [Calculation_4935523044391505925]' />
            </column>
            <column caption='% Orders w Voucher Dmart' datatype='real' default-format='p0.00%' name='[Calculation_4935523044392189959]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_voucher_orders_dmart]) / SUM([total_sent_orders_dmart])' />
            </column>
            <column caption='Avg Voucher Amount Dmart' datatype='real' default-format='c&quot;€ &quot;#,##0.00;-&quot;€ &quot;#,##0.00' name='[Calculation_4935523044396163081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([total_voucer_eur_dmart]) / SUM([total_voucher_orders_dmart]),0)' />
            </column>
            <column caption='Avg Delivery Fee dmart' datatype='real' default-format='c&quot;€ &quot;#,##0.00;-&quot;€ &quot;#,##0.00' name='[Calculation_4935523044397658122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dmart_delivery_fee]) / SUM([dmart_orders_w_delivery_fee])' />
            </column>
            <column caption='Front Margin' datatype='real' default-format='p0.00%' name='[Calculation_4935523044398403595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_5860871966613491712] - SUM([dmart_cogs])) / [Calculation_5860871966613491712]' />
            </column>
            <column caption='Avg Delivery Time Dmart' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4935523044399603724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_delivery_time_dmart]) / SUM([orders_dmart_w_delivery_time])' />
            </column>
            <column caption='% MoM Avg. Delivery Time Dmart' datatype='real' default-format='p0.00%' name='[Calculation_4935523044400418830]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_4935523044399603724] - [Avg Delivery Time Dmart (copy)_4935523044400091149])  / [Avg Delivery Time Dmart (copy)_4935523044400091149]' />
            </column>
            <column caption='Avg Delivery Time Restaurant' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4935523044400676879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurant_total_delivery_time]) / SUM([orders_restaurant_w_delivery_time])' />
            </column>
            <column caption='% Orders &gt; 10 Min Late Dmart' datatype='real' default-format='p0.00%' name='[Calculation_4935523044401336336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_10_minutes_late_dmart]) / SUM([orders_dmart_w_delivery_time])' />
            </column>
            <column caption='Fail Rate Dmart' datatype='real' default-format='p0.00%' name='[Calculation_4935523044402888721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders_dmart]) / SUM([total_orders_dmart])' />
            </column>
            <column caption='Last Period Fail Rate Dmart' datatype='real' default-format='p0.00%' name='[Calculation_4935523044403114002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([last_period_failed_orders_dmart]) / SUM([last_period_orders_dmart])' />
            </column>
