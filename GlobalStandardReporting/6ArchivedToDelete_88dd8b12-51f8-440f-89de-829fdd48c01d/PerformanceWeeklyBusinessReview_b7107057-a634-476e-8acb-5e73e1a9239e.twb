      <column caption='Avg Delivery Fee Restaurant' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Avg Delivery Fee dmart (copy)_1894396975229235203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([restaurant_total_delivery_fee])/ SUM([restaurant_orders_w_delivery_fee])' />
      </column>
      <column caption='Last Period Avg Delivery Time Dmart ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg Delivery Time Dmart (copy)_4935523044400091149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([last_period_total_delivery_time_dmart]) / SUM([last_period_orders_dmart_w_delivery_time])' />
      </column>
      <column caption='Last Period Avg Orders per Dmart' datatype='real' name='[Avg Orders per Dmart (copy)_4935523044382203907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([last_period_sent_orders_dmart]) / SUM([last_period_count_active_dmart_vendor])) / MAX([last_time_period_duration])' />
      </column>
