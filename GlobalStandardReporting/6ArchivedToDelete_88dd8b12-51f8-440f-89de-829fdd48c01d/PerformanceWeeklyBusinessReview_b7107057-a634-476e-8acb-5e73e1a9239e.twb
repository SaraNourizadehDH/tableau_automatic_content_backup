            <column caption='% WoW Orders - All Verticals' datatype='real' default-format='*&quot;+&quot; #,##0.00%;&quot;-&quot; #,##0.00%;' name='[MoM Orders - All Verticals (copy)_4131630460001939457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_orders_all_verticals] - [last_period_total_orders_all_verticals]) / SUM([last_period_total_orders_all_verticals])' />
