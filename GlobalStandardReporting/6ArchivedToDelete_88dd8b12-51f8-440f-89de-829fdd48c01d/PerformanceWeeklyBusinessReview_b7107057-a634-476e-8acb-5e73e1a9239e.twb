  <worksheets>
    <worksheet name='3p Coverage&amp;Choice M'>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_weekly_business_review (rl_dmart)' name='federated.00rxwq200obggy128txgo1bljg5g' />
          </datasources>
          <datasource-dependencies datasource='federated.00rxwq200obggy128txgo1bljg5g'>
            <column caption='% Cohort Reorder - 3p' datatype='real' default-format='p0.00%' name='[Calculation_1429329999895334920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_reorder_3p]) / SUM([last_week_customer_count_3p])' />
            </column>
            <column caption='% MoM Active Vendors - 3p' datatype='real' default-format='p0.00%' name='[Calculation_1429330000181063689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_active_3p_vendor] - [last_period_active_vendors_3p]) / SUM([last_period_active_vendors_3p])' />
            </column>
            <column caption='% MoM Orders - All Verticals' datatype='real' default-format='p0.00%' name='[Calculation_4131630460001132544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_orders_all_verticals] - [last_period_total_orders_all_verticals]) / SUM([last_period_total_orders_all_verticals])' />
            </column>
            <column caption='Avg Food Value - Restaurant' datatype='real' name='[Calculation_4935523044391505925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurant_gmv]) / SUM([restaurant_order_total])' />
            </column>
            <column caption='Avg Delivery Time Restaurant' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4935523044400676879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurant_total_delivery_time]) / SUM([orders_restaurant_w_delivery_time])' />
            </column>
            <column caption='% MoM Orders 3p' datatype='real' default-format='p0.00%' name='[Calculation_4935523044407128084]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_sent_orders_3p]-[last_period_sent_orders_3p]) / SUM([last_period_sent_orders_3p])' />
            </column>
            <column caption='Daily Orders Per Active Vendor 3p' datatype='real' name='[Calculation_4935523044407668757]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_orders_3p]) / SUM([count_active_3p_vendor])) / MAX([current_time_period_duration])' />
            </column>
            <column caption='Daily Orders per Active Vendor - Top 3 - 3p' datatype='real' name='[Calculation_4935523044409761815]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([top_3_vendors_3p_order_count]) / 3' />
            </column>
            <column caption='Avg Basket Value - 3p' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Calculation_4935523044411269144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_gmv_eur_3p]) / SUM([total_sent_orders_3p])' />
            </column>
            <column caption='% ABV of AFV 3p' datatype='real' default-format='p0.00%' name='[Calculation_4935523044411666457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_4935523044411269144] -[Calculation_4935523044391505925])/ [Calculation_4935523044391505925]' />
            </column>
            <column caption='Avg. Commission Rate- 3p' datatype='real' default-format='p0.00%' name='[Calculation_4935523044412186650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_commission_eur_3p]) / SUM([total_gmv_eur_3p])' />
            </column>
            <column caption='% Orders w Voucher - 3p' datatype='real' default-format='p0.00%' name='[Calculation_4935523044412502043]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_voucher_orders_3p]) / SUM([total_sent_orders_3p])' />
            </column>
            <column caption='% Share OD Orders' datatype='real' default-format='p0.00%' name='[Calculation_4935523044415680540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([od_3p_orders]) / SUM([total_sent_orders_3p])' />
            </column>
            <column caption='OD Avg. Basket Value' datatype='real' name='[Calculation_4935523044416536606]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([od_3p_gmv]) / SUM([od_3p_orders])' />
            </column>
            <column caption='% Commission OD' datatype='real' default-format='p0.00%' name='[Calculation_4935523044417097760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([od_3p_commission]) / SUM([od_3p_gmv])' />
            </column>
            <column caption='OD Cost per Order' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Calculation_4935523044418707491]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([od_3p_cogs]) / SUM([od_3p_orders])' />
            </column>
            <column caption='Est. OD Gross Profit per Order' datatype='real' default-format='c#,##0.00&quot; €&quot;;-#,##0.00&quot; €&quot;' name='[Calculation_4935523044425871397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([od_3p_commission])/SUM([od_3p_orders]) - [Calculation_4935523044418707491]' />
            </column>
            <column caption='Avg Delivery Time - 3p' datatype='real' name='[Calculation_4935523044428390439]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_delivery_time_3p]) / SUM([orders_3p_w_delivery_time])' />
            </column>
            <column caption='% Orders &gt; 10 Min Late - 3p' datatype='real' default-format='p0.00%' name='[Calculation_4935523044428824616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_10_minutes_late_3p]) / SUM([orders_3p_w_delivery_time])' />
            </column>
            <column caption='Fail Rate  - 3p' datatype='real' default-format='p0.00%' name='[Calculation_4935523044429348905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders_3p]) / SUM([total_orders_3p])' />
            </column>
            <column caption='Avg. Delivery Fee - 3p' datatype='real' default-format='c&quot;€ &quot;#,##0.00;-&quot;€ &quot;#,##0.00' name='[Calculation_4935523044435595306]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([od_3p_delivery_fee]) / SUM([od_3p_orders_w_delivery_time])' />
            </column>
            <column caption='Promoter NPS - 3p' datatype='real' name='[Calculation_5860871966897090565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([promoter_nps_count_3p]) / SUM([total_nps_count_3p])' />
            </column>
            <column caption='Detractor NPS - 3p' datatype='real' name='[Calculation_5860871966897422342]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([detractor_nps_count_3p]) / SUM([total_nps_count_3p])' />
            </column>
            <column caption='NPS - 3p' datatype='real' name='[Calculation_5860871966897664007]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_5860871966897090565] - [Calculation_5860871966897422342]) * 100' />
            </column>
            <column caption='Lines: profitablilty % ..' datatype='integer' name='[Calculation_6845752966845165569]' role='measure' type='quantitative'>
