      <column caption='% MoM Orders - All Verticals' datatype='real' default-format='p0.00%' name='[Calculation_4131630460001132544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_orders_all_verticals] - [last_period_total_orders_all_verticals]) / SUM([last_period_total_orders_all_verticals])' />
      </column>
      <column caption='New Warhouse Count - Dmart' datatype='integer' name='[Calculation_4171248049470947329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([new_warehouse_count_dmart], 0)' />
      </column>
      <column caption='% Orders w Campaign' datatype='real' default-format='p0.00%' name='[Calculation_433401122295783425]' role='measure' type='quantitative'>
