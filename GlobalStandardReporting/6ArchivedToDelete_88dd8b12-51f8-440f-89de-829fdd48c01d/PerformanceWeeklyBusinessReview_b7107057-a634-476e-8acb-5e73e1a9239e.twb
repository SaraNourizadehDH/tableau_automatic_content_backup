            </column>
            <column caption='Avg Voucher Amount Dmart' datatype='real' default-format='c&quot;€ &quot;#,##0.00;-&quot;€ &quot;#,##0.00' name='[Calculation_4935523044396163081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([total_voucer_eur_dmart]) / SUM([total_voucher_orders_dmart]),0)' />
            </column>
            <column caption='Avg Delivery Fee dmart' datatype='real' default-format='c&quot;€ &quot;#,##0.00;-&quot;€ &quot;#,##0.00' name='[Calculation_4935523044397658122]' role='measure' type='quantitative'>
