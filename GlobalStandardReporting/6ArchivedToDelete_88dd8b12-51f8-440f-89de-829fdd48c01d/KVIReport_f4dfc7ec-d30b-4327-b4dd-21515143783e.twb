      <repository-location id='Sheet1' path='/t/GlobalStandardReporting/workbooks/KVIReport' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='Tableau KVI Report' name='federated.1yge0hj0q9jlgo169iw5j16gj0me' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Mass CutOff' datatype='real' default-format='p0%' name='[KVI CutOff (copy)_1162491677627355144]' param-domain-type='range' role='measure' type='quantitative' value='0.4'>
              <calculation class='tableau' formula='0.4' />
              <range max='1.0' min='0.01' />
            </column>
            <column caption='GMV Weight' datatype='real' default-format='p0%' name='[Orders Weight (copy)_1162491677621870593]' param-domain-type='range' role='measure' type='quantitative' value='0.2'>
              <calculation class='tableau' formula='0.2' />
              <range max='1.0' min='0.01' />
            </column>
            <column caption='Frequency Weight' datatype='real' default-format='p0%' name='[Orders Weight (copy)_1162491677622009858]' param-domain-type='range' role='measure' type='quantitative' value='0.4'>
              <calculation class='tableau' formula='0.4' />
              <range max='1.0' min='0.01' />
            </column>
            <column caption='Orders Weight' datatype='real' default-format='p0%' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='0.4'>
              <calculation class='tableau' formula='0.4' />
              <range max='1.0' min='0.01' />
            </column>
            <column caption='KVIs CutOff' datatype='real' default-format='p0%' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='0.25'>
              <calculation class='tableau' formula='0.25' />
              <range max='1.0' min='0.01' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1yge0hj0q9jlgo169iw5j16gj0me'>
            <column caption='Total LN Score' datatype='real' name='[Calculation_1162491677622222851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([gmv_normalized] * [Parameters].[Orders Weight (copy)_1162491677621870593]) &#10;&#10;+&#10;&#10;([orders_normalized] * [Parameters].[Parameter 1])&#10;&#10;+ &#10;&#10;([frequency_normalized] * [Parameters].[Orders Weight (copy)_1162491677622009858])' />
            </column>
            <column caption='Total GMV' datatype='real' name='[Calculation_1162491677625806853]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{EXCLUDE [sku], [product_name], [category], [subcategory], [category_level_three], [brand_name], [product_created_date]: SUM([Calculation_4310789297716133889])}' />
            </column>
            <column caption='% of GMV' datatype='real' name='[Calculation_1162491677625950214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_4310789297716133889]) / SUM([Calculation_1162491677625806853])' />
            </column>
            <column caption='Item Role' datatype='string' name='[Calculation_1162491677628780555]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF RUNNING_SUM([Calculation_1162491677625950214]) &lt;= [Parameters].[Parameter 2] THEN &apos;KVI&apos;&#10;ELSEIF RUNNING_SUM([Calculation_1162491677625950214]) &gt; [Parameters].[Parameter 2] &#10;AND RUNNING_SUM([Calculation_1162491677625950214]) &lt;= ([Parameters].[Parameter 2] + [Parameters].[KVI CutOff (copy)_1162491677627355144]) THEN &apos;Mass&apos;&#10;ELSE &apos;Long Tail&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='100% Weight' datatype='boolean' name='[Calculation_1162491677982531596]' role='measure' type='nominal'>
              <calculation class='tableau' formula='ROUND(AVG([Parameters].[Parameter 1]) + AVG([Parameters].[Orders Weight (copy)_1162491677621870593]) + AVG([Parameters].[Orders Weight (copy)_1162491677622009858]),1)&#10; = 1' />
            </column>
            <column caption='Gross Margin' datatype='real' name='[Calculation_4310789297715818496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [gross_margin_eur]&#10;WHEN &apos;Local&apos; THEN [gross_margin_lc]&#10;END' />
            </column>
            <column caption='Retail Revenue' datatype='real' name='[Calculation_4310789297716133889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [retail_revenue_eur]&#10;WHEN &apos;Local&apos; THEN [retail_revenue_lc]&#10;END' />
            </column>
            <column caption='COGS' datatype='real' name='[Calculation_4310789297716355074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [cogs_eur]&#10;WHEN &apos;Local&apos; THEN [cogs_lc]&#10;END' />
            </column>
            <column caption='Net Retail Revenue' datatype='real' name='[Calculation_5895000852336472064]' role='measure' type='quantitative'>
