            </column>
            <column caption='current_period' datatype='boolean' name='[Calculation_1387249477445312515]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [cohort_type]&#10;when &apos;7d&apos;  then dateadd(&apos;week&apos;, [return_period], [cohort_date])  = DATETRUNC(&apos;week&apos;, TODAY())&#10;when &apos;weekly&apos;  then dateadd(&apos;week&apos;, [return_period], [cohort_date])  = DATETRUNC(&apos;week&apos;, TODAY())&#10;when &apos;30d&apos; then dateadd(&apos;month&apos;, [return_period], [cohort_date]) = DATETRUNC(&apos;month&apos;, TODAY())&#10;when &apos;monthly&apos; then dateadd(&apos;month&apos;, [return_period], [cohort_date]) = DATETRUNC(&apos;month&apos;, TODAY())&#10;end' />
            </column>
            <column caption='Cohort Size New' datatype='integer' name='[Calculation_1519120490500636697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cohort_size])' />
            </column>
            <column caption='AOV ALL' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2294795171160137730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_gmv_eur])/SUM([orders])' />
            </column>
            <column caption='Frequency ALL' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Frequency (copy)]' role='measure' type='quantitative'>
