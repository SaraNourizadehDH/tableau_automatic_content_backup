          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Last parameter' datatype='string' name='[Parameter 10]' param-domain-type='list' role='measure' type='nominal' value='&quot;Current period&quot;'>
              <calculation class='tableau' formula='&quot;Current period&quot;' />
            </column>
            <column caption='Top N' datatype='integer' name='[Parameter 9]' param-domain-type='range' role='measure' type='quantitative' value='5'>
              <calculation class='tableau' formula='5' />
              <range granularity='1' max='100' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0wfyo1002di02915d8uot04p9q76'>
            <column caption='Dynamic filter' datatype='string' name='[Calculation_149955841307344896]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [dimension]&#10;  WHEN &apos;country&apos; THEN [country_name]&#10;  WHEN &apos;chain&apos; THEN [aaa_chain_name_cleaned]&#10;  WHEN &apos;entity&apos; THEN [management_entity]&#10;  WHEN &apos;vendor&apos; THEN [Calculation_495044162704326660]&#10;END' />
            </column>
            <column caption='Rank- avg active SKUs- ' datatype='integer' name='[Calculation_2650649911222091777]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='RANK_UNIQUE([Calculation_2650649911270965265],&apos;desc&apos;)'>
                <table-calc ordering-field='[federated.0wfyo1002di02915d8uot04p9q76].[Dimension- graph user (copy)_2650649911224426500]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Previous period values' datatype='real' name='[Calculation_2650649911267573774]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOOKUP(([Calculation_2650649911270965265]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Calc avg active SKUs' datatype='real' name='[Calculation_2650649911270965265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg([active_skus])' />
            </column>
            <column caption='Variance Calculation' datatype='real' name='[Calculation_2650649911271755794]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg([active_skus]) - [Calculation_2650649911267573774]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
