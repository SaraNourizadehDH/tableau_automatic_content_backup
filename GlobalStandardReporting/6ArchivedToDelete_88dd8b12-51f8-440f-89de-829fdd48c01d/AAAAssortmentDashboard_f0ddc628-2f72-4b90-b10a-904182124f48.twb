      <column caption='First record date- Vendor' datatype='date' name='[Calculation_4684517672808075264]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [dimension]&#10;    WHEN &apos;vendor&apos; THEN [first_date]&#10;    ELSE DATE(&apos;2024-03-01&apos;) &#10;END' />
      </column>
      <column caption='Slot of the day - shown' datatype='string' name='[Calculation_495044162701819904]' role='dimension' type='nominal'>
