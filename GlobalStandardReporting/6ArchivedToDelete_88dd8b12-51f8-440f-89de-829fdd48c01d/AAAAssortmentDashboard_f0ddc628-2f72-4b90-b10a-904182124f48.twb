      <column caption='Metrics Cards' datatype='real' name='[Calculation_6527475133558661125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;    WHEN  &apos;1&apos; THEN  [listed_skus]&#10;    WHEN  &apos;2&apos; THEN [active_skus]&#10;    WHEN  &apos;3&apos; THEN [active_rate]*100&#10;END' />
      </column>
      <column caption='Metrics Cards (Symbol)' datatype='string' name='[Calculation_6527475133559304198]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;    WHEN &apos;1&apos; THEN &quot;&quot;&#10;    WHEN &apos;2&apos; THEN &quot;&quot;&#10;    WHEN &apos;3&apos; THEN &quot;%&quot;&#10; END' />
      </column>
      <column caption='Date - Table' datatype='string' name='[Date - new (copy)_3987937525962682373]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [date_granularity]&#10;WHEN &apos;hourly&apos; then &apos;n.a&apos;&#10;WHEN &apos;daily&apos; THEN &apos;n.a&apos;&#10;WHEN &apos;weekly&apos; THEN str([partition_date])&#10;WHEN &apos;monthly&apos; THEN str([partition_date])&#10;END' />
