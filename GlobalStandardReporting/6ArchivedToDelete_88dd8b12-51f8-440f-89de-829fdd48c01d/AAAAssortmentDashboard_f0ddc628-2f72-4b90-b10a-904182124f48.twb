      <table>
        <view>
          <datasources>
            <datasource caption='ls_assortment_rl_assortment_dashboard' name='federated.0wfyo1002di02915d8uot04p9q76' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Last parameter' datatype='string' name='[Parameter 10]' param-domain-type='list' role='measure' type='nominal' value='&quot;Current period&quot;'>
              <calculation class='tableau' formula='&quot;Current period&quot;' />
            </column>
            <column caption='Top N' datatype='integer' name='[Parameter 9]' param-domain-type='range' role='measure' type='quantitative' value='5'>
              <calculation class='tableau' formula='5' />
              <range granularity='1' max='100' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0wfyo1002di02915d8uot04p9q76'>
            <column caption='Dynamic filter' datatype='string' name='[Calculation_149955841307344896]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [dimension]&#10;  WHEN &apos;country&apos; THEN [country_name]&#10;  WHEN &apos;chain&apos; THEN [aaa_chain_name_cleaned]&#10;  WHEN &apos;entity&apos; THEN [management_entity]&#10;  WHEN &apos;vendor&apos; THEN [Calculation_495044162704326660]&#10;END' />
            </column>
            <column caption='Rank- avg active SKUs- ' datatype='integer' name='[Calculation_2650649911222091777]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='RANK_UNIQUE([Calculation_2650649911270965265],&apos;desc&apos;)'>
                <table-calc ordering-field='[federated.0wfyo1002di02915d8uot04p9q76].[Dimension- graph user (copy)_2650649911224426500]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Previous period values' datatype='real' name='[Calculation_2650649911267573774]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOOKUP(([Calculation_2650649911270965265]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Calc avg active SKUs' datatype='real' name='[Calculation_2650649911270965265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg([active_skus])' />
            </column>
            <column caption='Variance Calculation' datatype='real' name='[Calculation_2650649911271755794]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg([active_skus]) - [Calculation_2650649911267573774]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='LAST' datatype='boolean' name='[Calculation_2650649911278628885]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LAST()=[Calculation_2650649911280312343]'>
                <table-calc ordering-field='[federated.0wfyo1002di02915d8uot04p9q76].[Calculation_495044162702499842]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Calc.field- Last period' datatype='integer' name='[Calculation_2650649911280312343]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 10]=&apos;Current period&apos; THEN 0&#10;ELSE 1&#10;END' />
            </column>
            <column caption='Clasif.' datatype='string' name='[Calculation_2650649911308394526]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_2650649911557279803]+&quot; &quot;+str([Parameters].[Parameter 9])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='filter top N NEW' datatype='string' name='[Calculation_2650649911557279803]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2650649911222091777] &lt;= [Parameters].[Parameter 9] THEN &apos;Top&apos;&#10;ELSEIF RANK(AVG([active_skus]), &apos;asc&apos;) &lt;= [Parameters].[Parameter 9] THEN &apos;Bottom&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MAX' datatype='integer' name='[Calculation_3803641784944324623]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(1)' />
            </column>
            <column caption='Date - new' datatype='string' name='[Calculation_495044162702499842]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_granularity]&#10;WHEN &apos;hourly&apos; then str([formatted_timestamp_local] )&#10;WHEN &apos;daily&apos; THEN str([partition_date])&#10;WHEN &apos;weekly&apos; THEN str([partition_date])&#10;WHEN &apos;monthly&apos; THEN str([partition_date])&#10;END' />
            </column>
            <column caption='Vendor name' datatype='string' name='[Calculation_495044162704326660]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [vendor_id]: &#10;    MAX(&#10;        IF [partition_date] = { FIXED [vendor_id]: MAX([partition_date]) }&#10;        THEN [vendor_name]&#10;        END&#10;    )&#10;}' />
            </column>
            <column caption='Dynamic Measure Selection' datatype='real' name='[Dimension- graph user (copy)_2650649911224426500]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [dimension]&#10;When &apos;vendor&apos; then [active_skus]&#10;WHEN &apos;chain&apos; then [active_skus]&#10;WHEN &apos;country&apos; then [active_skus]&#10;WHEN &apos;entity&apos; then [active_skus]&#10;END' />
            </column>
            <column caption='Is AAA Vendor (BOOLEAN)' datatype='boolean' name='[Is AAA Supermarket (BOOLEAN) (copy 2)_2650649911550664760]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE  [is_aaa_vendor] WHEN&apos;true&apos; then TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Is H&amp;B Vendor.' datatype='boolean' name='[Is AAA Supermarket (BOOLEAN) (copy)_2650649911550648375]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE  [health_and_beauty_vendor] WHEN&apos;true&apos; then TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Is AAA Supermarket (BOOLEAN)' datatype='boolean' name='[Is AAA Supermarket (copy)_2650649911550386230]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE  [is_aaa_supermarket] WHEN&apos;true&apos; then TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Previous period  (date)' datatype='string' name='[Previous period values (copy)_3987937525955018754]' role='measure' type='nominal'>
              <calculation class='tableau' formula='LOOKUP(ATTR([Calculation_495044162702499842]), -1)'>
                <table-calc ordering-type='Rows' />
