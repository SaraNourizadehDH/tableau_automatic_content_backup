      <column caption='Vendor name' datatype='string' name='[Calculation_495044162704326660]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [vendor_id]: &#10;    MAX(&#10;        IF [partition_date] = { FIXED [vendor_id]: MAX([partition_date]) }&#10;        THEN [vendor_name]&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='Dimension- graph user' datatype='string' name='[Calculation_495044162723700741]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [dimension]&#10;When &apos;vendor&apos; then [Calculation_495044162704326660]  &#10;WHEN &apos;chain&apos; then [aaa_chain_name_cleaned]&#10;WHEN &apos;country&apos; then [country_name]&#10;WHEN &apos;entity&apos; then [management_entity]&#10;END' />
