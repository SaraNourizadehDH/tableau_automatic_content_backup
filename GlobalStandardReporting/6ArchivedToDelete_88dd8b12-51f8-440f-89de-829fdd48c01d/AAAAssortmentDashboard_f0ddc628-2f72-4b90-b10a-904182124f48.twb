    <worksheet name='Table- Reporting'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#cc0033' fontname='Benton Sans Book' fontsize='11'>Assortment table for AAA Supermarkets</run>
            <run>Æ&#10;</run>
            <run fontcolor='#898989' fontname='Benton Sans Book' fontsize='9'>Tabular view</run>
            <run>Æ&#10;</run>
            <run fontcolor='#898989' fontname='Benton Sans Book' fontsize='9'><![CDATA[Dimension: <[federated.0wfyo1002di02915d8uot04p9q76].[none:dimension:nk]>]]></run>
            <run>Æ&#10;</run>
            <run fontcolor='#898989' fontname='Benton Sans Book' fontsize='9'><![CDATA[Granularity: <[federated.0wfyo1002di02915d8uot04p9q76].[none:date_granularity:nk]>]]></run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ls_assortment_rl_assortment_dashboard' name='federated.0wfyo1002di02915d8uot04p9q76' />
          </datasources>
          <datasource-dependencies datasource='federated.0wfyo1002di02915d8uot04p9q76'>
            <column caption='Row number' datatype='integer' name='[Calculation_146367036427497474]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Dynamic filter' datatype='string' name='[Calculation_149955841307344896]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [dimension]&#10;  WHEN &apos;country&apos; THEN [country_name]&#10;  WHEN &apos;chain&apos; THEN [aaa_chain_name_cleaned]&#10;  WHEN &apos;entity&apos; THEN [management_entity]&#10;  WHEN &apos;vendor&apos; THEN [Calculation_495044162704326660]&#10;END' />
            </column>
            <column caption='First record date- Vendor' datatype='date' name='[Calculation_4684517672808075264]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [dimension]&#10;    WHEN &apos;vendor&apos; THEN [first_date]&#10;    ELSE DATE(&apos;2024-03-01&apos;) &#10;END' />
            </column>
            <column caption='Slot of the day - shown' datatype='string' name='[Calculation_495044162701819904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [date_granularity]=&apos;hourly&apos; THEN [slot_local_time]&#10;ELSE &quot;&quot;&#10;END' />
            </column>
            <column caption='Date - new' datatype='string' name='[Calculation_495044162702499842]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_granularity]&#10;WHEN &apos;hourly&apos; then str([formatted_timestamp_local] )&#10;WHEN &apos;daily&apos; THEN str([partition_date])&#10;WHEN &apos;weekly&apos; THEN str([partition_date])&#10;WHEN &apos;monthly&apos; THEN str([partition_date])&#10;END' />
            </column>
            <column caption='Vendor name' datatype='string' name='[Calculation_495044162704326660]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [vendor_id]: &#10;    MAX(&#10;        IF [partition_date] = { FIXED [vendor_id]: MAX([partition_date]) }&#10;        THEN [vendor_name]&#10;        END&#10;    )&#10;}' />
            </column>
            <column caption='Chain Name' datatype='string' name='[aaa_chain_name_cleaned]' role='dimension' type='nominal' />
            <column aggregation='Avg' caption='Avg. Active Rate' datatype='real' default-format='p0.00%' name='[active_rate]' role='measure' type='quantitative' />
            <column aggregation='Avg' caption='Avg. Active SKUs' datatype='real' default-format='n#,##0;-#,##0' name='[active_skus]' role='measure' type='quantitative' />
            <column-instance column='[active_rate]' derivation='Avg' name='[avg:active_rate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[active_skus]' derivation='Avg' name='[avg:active_skus:qk]' pivot='key' type='quantitative' />
            <column-instance column='[listed_skus]' derivation='Avg' name='[avg:listed_skus:qk]' pivot='key' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Granularity' datatype='string' name='[date_granularity]' role='dimension' type='nominal' />
            <column caption='Dimension' datatype='string' name='[dimension]' role='dimension' type='nominal' />
            <column caption='Vendor-data being stored from' datatype='date' name='[first_date]' role='dimension' type='ordinal' />
            <column caption='Formatted Timestamp Local' datatype='string' name='[formatted_timestamp_local]' role='dimension' type='nominal' />
            <column caption='Is H&amp;B Vendor' datatype='string' name='[health_and_beauty_vendor]' role='dimension' type='nominal' />
            <column caption='Is AAA Supermarket' datatype='string' name='[is_aaa_supermarket]' role='dimension' type='nominal' />
            <column caption='Is AAA Vendor' datatype='string' name='[is_aaa_vendor]' role='dimension' type='nominal' />
            <column caption='Is Key Partner (2025)' datatype='string' name='[is_key_partner]' role='dimension' type='nominal' />
