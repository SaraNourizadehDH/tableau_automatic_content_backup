            </column>
            <column caption='Variance Calculation (percent)' datatype='real' default-format='p0.00%' name='[Variance Calculation (copy)_2650649911272120339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_2650649911267573774] != 0 THEN&#10;   ( (avg([active_skus]) )- [Calculation_2650649911267573774] )/ [Calculation_2650649911267573774]&#10;ELSE&#10;    NULL&#10;END'>
                <table-calc ordering-type='Rows' />
