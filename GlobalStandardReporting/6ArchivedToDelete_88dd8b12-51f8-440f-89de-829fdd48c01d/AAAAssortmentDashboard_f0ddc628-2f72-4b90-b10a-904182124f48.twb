      <column caption='filtered display name' datatype='string' name='[Calculation_2650649911548428340]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([Parameters].[Parameter 10] = &apos;Current period&apos; OR [Parameters].[Parameter 10] = &apos;Previous period&apos;) AND &#10;   ([Is AAA Supermarket (copy)_2650649911550386230] OR [Is AAA Supermarket (BOOLEAN) (copy 2)_2650649911550664760] OR [Is AAA Supermarket (BOOLEAN) (copy)_2650649911550648375])&#10;THEN [display_name]&#10;ELSE NULL&#10;END' />
