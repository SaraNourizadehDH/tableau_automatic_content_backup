      </column>
      <column caption='sort' datatype='real' name='[Calculation_2650649911563800642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 11]&lt;&gt; 4&#10;THEN&#10;ASCII([Calculation_2650649911562440769])&#10;ELSE&#10;-INT([Calculation_495044162702499842])&#10;END' />
