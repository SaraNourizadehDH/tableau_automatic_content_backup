      </column>
      <column caption='Date - new' datatype='string' name='[Calculation_495044162702499842]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [date_granularity]&#10;WHEN &apos;hourly&apos; then str([formatted_timestamp_local] )&#10;WHEN &apos;daily&apos; THEN str([partition_date])&#10;WHEN &apos;weekly&apos; THEN str([partition_date])&#10;WHEN &apos;monthly&apos; THEN str([partition_date])&#10;END' />
