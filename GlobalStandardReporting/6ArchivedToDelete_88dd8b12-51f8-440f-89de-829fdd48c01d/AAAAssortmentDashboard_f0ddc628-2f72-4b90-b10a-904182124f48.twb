                <table-calc ordering-field='[federated.0wfyo1002di02915d8uot04p9q76].[Calculation_495044162702499842]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Calc.field- Last period' datatype='integer' name='[Calculation_2650649911280312343]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 10]=&apos;Current period&apos; THEN 0&#10;ELSE 1&#10;END' />
            </column>
            <column caption='Clasif.' datatype='string' name='[Calculation_2650649911308394526]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_2650649911557279803]+&quot; &quot;+str([Parameters].[Parameter 9])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='filter top N NEW' datatype='string' name='[Calculation_2650649911557279803]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2650649911222091777] &lt;= [Parameters].[Parameter 9] THEN &apos;Top&apos;&#10;ELSEIF RANK(AVG([active_skus]), &apos;asc&apos;) &lt;= [Parameters].[Parameter 9] THEN &apos;Bottom&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MAX' datatype='integer' name='[Calculation_3803641784944324623]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(1)' />
            </column>
            <column caption='Date - new' datatype='string' name='[Calculation_495044162702499842]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_granularity]&#10;WHEN &apos;hourly&apos; then str([formatted_timestamp_local] )&#10;WHEN &apos;daily&apos; THEN str([partition_date])&#10;WHEN &apos;weekly&apos; THEN str([partition_date])&#10;WHEN &apos;monthly&apos; THEN str([partition_date])&#10;END' />
            </column>
            <column caption='Vendor name' datatype='string' name='[Calculation_495044162704326660]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [vendor_id]: &#10;    MAX(&#10;        IF [partition_date] = { FIXED [vendor_id]: MAX([partition_date]) }&#10;        THEN [vendor_name]&#10;        END&#10;    )&#10;}' />
            </column>
            <column caption='Dynamic Measure Selection' datatype='real' name='[Dimension- graph user (copy)_2650649911224426500]' role='dimension' type='ordinal'>
