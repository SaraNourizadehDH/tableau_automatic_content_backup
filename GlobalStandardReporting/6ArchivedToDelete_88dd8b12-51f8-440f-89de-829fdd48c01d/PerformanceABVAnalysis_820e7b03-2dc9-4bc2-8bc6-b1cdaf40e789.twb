          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/AOVAnalysis/OrderingBehaviourbyLifetimeValue?rev=' id='OrderingBehaviourbyLifetimeValue' path='/t/GlobalStandardReporting/workbooks/AOVAnalysis' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='parameter-ctrl'>
          <format attr='color' value='#ffffff' />
        </style-rule>
        <style-rule element='parameter-ctrl-title'>
          <format attr='color' value='#ffffff' />
        </style-rule>
      </style>
      <size maxheight='900' maxwidth='1600' minheight='900' minwidth='1600' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='2. aov dev' name='federated.09u18mn02hzkxy14ig2u01lv077l' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Currency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
          <calculation class='tableau' formula='&quot;EUR&quot;' />
          <members>
            <member value='&quot;EUR&quot;' />
            <member value='&quot;Local Currency&quot;' />
          </members>
        </column>
        <column caption='Bucket Size' datatype='real' name='[amt_gmv_group Parameter]' param-domain-type='any' role='measure' type='quantitative' value='5.0'>
          <calculation class='tableau' formula='5.0' />
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.09u18mn02hzkxy14ig2u01lv077l'>
        <column caption='User First GMV' datatype='real' name='[Calculation_814940494688677910]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; then [user_first_gmv]&#10;WHEN &apos;Local Currency&apos; then [amt_gmv_lc]&#10;END' />
        </column>
        <column caption='Country' datatype='string' name='[common_name]' role='dimension' type='nominal' />
        <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
