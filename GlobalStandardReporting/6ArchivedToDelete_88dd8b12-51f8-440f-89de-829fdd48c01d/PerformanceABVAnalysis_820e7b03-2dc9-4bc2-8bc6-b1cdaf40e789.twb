      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/AOVAnalysis/UserandOrderEvolution?rev=' id='UserandOrderEvolution' path='/t/GlobalStandardReporting/workbooks/AOVAnalysis' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='parameter-ctrl'>
          <format attr='color' value='#ffffff' />
        </style-rule>
        <style-rule element='parameter-ctrl-title'>
          <format attr='color' value='#ffffff' />
        </style-rule>
      </style>
      <size maxheight='900' maxwidth='1600' minheight='900' minwidth='1600' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='_tableau_aov_lifetime (rl_dmart)' name='federated.1ea5drl0up8wyg1gnt3jy19cxqr4' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column alias='weekly' caption='Date Level' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
          <calculation class='tableau' formula='&quot;week&quot;' />
          <aliases>
            <alias key='&quot;month&quot;' value='monthly' />
            <alias key='&quot;week&quot;' value='weekly' />
          </aliases>
          <members>
            <member alias='weekly' value='&quot;week&quot;' />
            <member alias='monthly' value='&quot;month&quot;' />
            <member value='&quot;quarter&quot;' />
          </members>
        </column>
        <column caption='Currency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
          <calculation class='tableau' formula='&quot;EUR&quot;' />
          <members>
            <member value='&quot;EUR&quot;' />
            <member value='&quot;Local Currency&quot;' />
          </members>
        </column>
        <column caption='Bucket Size' datatype='real' name='[amt_gmv_group Parameter]' param-domain-type='any' role='measure' type='quantitative' value='5.0'>
          <calculation class='tableau' formula='5.0' />
        </column>
      </datasource-dependencies>
