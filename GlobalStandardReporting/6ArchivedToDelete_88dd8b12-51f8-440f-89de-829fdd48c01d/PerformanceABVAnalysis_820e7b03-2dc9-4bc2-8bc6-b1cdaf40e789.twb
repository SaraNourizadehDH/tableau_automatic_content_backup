      <column caption='Order Date' datatype='datetime' default-format='*YYYY-MM-DD' name='[Calculation_5459207223018496028]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 2], [order_date], &apos;monday&apos;)' />
      </column>
      <column caption='LT ABV' datatype='real' name='[Calculation_814940494469148675]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; THEN [lt_abv_eur]&#10;WHEN &apos;Local Currency&apos; THEN [lt_abv_lc]&#10;END' />
      </column>
      <column caption='Not Current Period' datatype='boolean' name='[Calculation_863846727946878984]' role='dimension' type='nominal'>
