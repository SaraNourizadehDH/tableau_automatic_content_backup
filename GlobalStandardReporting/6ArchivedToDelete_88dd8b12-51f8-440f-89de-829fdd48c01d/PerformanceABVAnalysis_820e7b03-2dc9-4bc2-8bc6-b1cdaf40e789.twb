      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;&#10;</run>
            <run fontsize='14'>Bucket: is defining the GMV of the first Dark Store Order of the User</run>
            <run>Æ&#10;</run>
