      <aliases enabled='yes' />
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1099441260247834626]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='ABV' datatype='real' name='[Calculation_2843108418302951425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( [Calculation_814940494682402822] ) / SUM( [orders] )' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_814940494682402822]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; then [amt_gmv_eur]&#10;WHEN &apos;Local Currency&apos; then [amt_gmv_lc]&#10;END' />
      </column>
      <column caption='GMV Group' datatype='real' name='[Calculation_814940494683172871]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &apos;EUR&apos; then [amt_gmv_group]&#10;WHEN &apos;Local Currency&apos; then [amt_gmv_group_lc]&#10;END' />
      </column>
      <column caption='ABV ' datatype='real' name='[Calculation_863846727941435393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM( [Calculation_814940494682402822] ) / SUM( [orders] ))' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_863846727941767170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if 0 = 0 then&#13;&#10;RUNNING_SUM(SUM([orders])) / TOTAL(SUM([orders]))&#13;&#10;else null end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_863846727941976067]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='running_in_total' datatype='real' name='[Calculation_863846727942172676]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ROUND(RUNNING_SUM(SUM([orders]))/TOTAL(SUM([orders]))*100))/100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Keeper' datatype='integer' name='[Calculation_863846727942406149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_863846727941976067] + ([Parameters].[Parameter 1] - 1))%[Parameters].[Parameter 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='running_in_sum_label' datatype='real' name='[Calculation_863846727942496262]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ([Calculation_863846727942406149]) = 0 then&#13;&#10;(ROUND(RUNNING_SUM(SUM([orders]))/TOTAL(SUM([orders]))*100))/100&#13;&#10;elseif (ROUND(RUNNING_SUM(SUM([orders]))/TOTAL(SUM([orders]))*100))/100 &gt; 0.45 and (ROUND(RUNNING_SUM(SUM([orders]))/TOTAL(SUM([orders]))*100))/100 &lt; 0.55 then (ROUND(RUNNING_SUM(SUM([orders]))/TOTAL(SUM([orders]))*100))/100&#13;&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
