    <dashboard name='Ordering Behaviour by Avg Basket Value'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff' fontsize='10' underline='true'>Note:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#ffffff' fontsize='10' italic='true'>Bucket:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#ffffff' fontsize='10'>is defining the GMV of the first Dark Store Order of the User</run>
            <run>Æ&#10;</run>
            <run fontcolor='#ffffff' fontsize='10' italic='true'>x-Axis:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#ffffff' fontsize='10'>n-th Dark Store Order of the User</run>
            <run>Æ&#10;</run>
            <run fontcolor='#ffffff' fontsize='10'>Care: n = 1 does not necessarily mean it&apos;s an acquisition. User could&apos;ve done a restaurant order before. </run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/AOVAnalysis/OrderingBehaviourbyAvgBasketValue?rev=' id='OrderingBehaviourbyAvgBasketValue' path='/t/GlobalStandardReporting/workbooks/AOVAnalysis' revision='' site='GlobalStandardReporting' />
