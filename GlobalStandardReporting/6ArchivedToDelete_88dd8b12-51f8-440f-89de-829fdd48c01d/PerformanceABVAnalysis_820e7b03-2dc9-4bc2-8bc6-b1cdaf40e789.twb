    <worksheet name='Order Share by ABV and Customer LTV '>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff'>&lt;Sheet Name&gt; &#10;</run>
            <run fontcolor='#ffffff' fontsize='12' italic='true'>The graph shows the distribution of orders by average basket size and customer lifetime value.
i.e. For  customers who have lifetime value of 50, what is the distribution of gross margin between their orders.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='2. aov dev' name='federated.09u18mn02hzkxy14ig2u01lv077l' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='weekly' caption='Date Level' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;month&quot;' value='monthly' />
                <alias key='&quot;week&quot;' value='weekly' />
              </aliases>
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
            <column caption='Bucket Size' datatype='real' name='[amt_gmv_group Parameter]' param-domain-type='any' role='measure' type='quantitative' value='5.0'>
              <calculation class='tableau' formula='5.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.09u18mn02hzkxy14ig2u01lv077l'>
            <column caption='Order Date' datatype='datetime' default-format='*YYYY-MM-DD' name='[Calculation_5459207223018496028]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 2], [reorder_date], &apos;monday&apos;)' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_814940494686507027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; then [amt_gmv_eur]&#10;WHEN &apos;Local Currency&apos; then [amt_gmv_lc]&#10;END' />
            </column>
            <column caption='LT ABV' datatype='real' name='[Calculation_814940494688366613]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; then [user_lifetime_aov]&#10;WHEN &apos;Local Currency&apos; then [user_lifetime_aov_lc]&#10;END' />
