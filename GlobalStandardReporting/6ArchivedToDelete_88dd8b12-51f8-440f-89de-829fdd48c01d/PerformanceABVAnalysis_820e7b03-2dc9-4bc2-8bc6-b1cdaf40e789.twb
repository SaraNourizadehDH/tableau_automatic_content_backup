      <aliases enabled='yes' />
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1099441260244029441]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='ABV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_5459207221574877199]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_814940494686507027]) / SUM([orders])' />
      </column>
      <column caption='MIN amt' datatype='real' name='[Calculation_5459207221584924689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([Calculation_814940494688677910])' />
      </column>
      <column caption='Cohort Size' datatype='integer' name='[Calculation_5459207221600722966]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MAX(SUM([users]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Retain' datatype='real' default-format='p0%' name='[Calculation_5459207221600833559]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([users]) / [Calculation_5459207221600722966]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Order Date' datatype='datetime' default-format='*YYYY-MM-DD' name='[Calculation_5459207223018496028]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 2], [reorder_date], &apos;monday&apos;)' />
      </column>
      <column caption='GMV' datatype='real' name='[Calculation_814940494686507027]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; then [amt_gmv_eur]&#10;WHEN &apos;Local Currency&apos; then [amt_gmv_lc]&#10;END' />
      </column>
      <column caption='LT ABV' datatype='real' name='[Calculation_814940494688366613]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; then [user_lifetime_aov]&#10;WHEN &apos;Local Currency&apos; then [user_lifetime_aov_lc]&#10;END' />
      </column>
      <column caption='User First GMV' datatype='real' name='[Calculation_814940494688677910]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;EUR&apos; then [user_first_gmv]&#10;WHEN &apos;Local Currency&apos; then [amt_gmv_lc]&#10;END' />
      </column>
      <column aggregation='Sum' caption='Month Idx' datatype='integer' name='[Calculation_863846727944876039]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [order_date], [Calculation_5459207223018496028])' />
      </column>
      <column caption='GMV Group' datatype='string' name='[GMV (copy)_813322007644483585]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ROUND([Calculation_814940494686507027]) &lt; 5 then &apos;&lt;5&apos;&#10;elseif ROUND([Calculation_814940494686507027]) &gt;= 5 and ROUND([Calculation_814940494686507027]) &lt;= 10 then &apos;5-10&apos;&#10;elseif ROUND([Calculation_814940494686507027]) &gt;10 and ROUND([Calculation_814940494686507027]) &lt;= 20 then &apos;11-20&apos;&#10;elseif ROUND([Calculation_814940494686507027]) &gt; 20 and ROUND([Calculation_814940494686507027]) &lt;= 30 then &apos;21-30&apos;&#10;elseif ROUND([Calculation_814940494686507027]) &gt; 30 and ROUND([Calculation_814940494686507027]) &lt;= 40 then &apos;31-40&apos;&#10;elseif ROUND([Calculation_814940494686507027]) &gt; 40 and ROUND([Calculation_814940494686507027]) &lt;= 50 then &apos;41-50&apos;&#10;elseif ROUND([Calculation_814940494686507027]) &gt; 50 and ROUND([Calculation_814940494686507027]) &lt;= 60 then &apos;51-60&apos;&#10;elseif ROUND([Calculation_814940494686507027]) &gt; 60 and ROUND([Calculation_814940494686507027]) &lt;= 70 then &apos;61-70&apos;&#10;elseif ROUND([Calculation_814940494686507027]) &gt; 70 and ROUND([Calculation_814940494686507027]) &lt;= 80 then &apos;71-80&apos;&#10;elseif ROUND([Calculation_814940494686507027]) &gt; 80 and ROUND([Calculation_814940494686507027]) &lt;= 90 then &apos;81-90&apos;&#10;elseif ROUND([Calculation_814940494686507027]) &gt; 90 and ROUND([Calculation_814940494686507027]) &lt;= 100 then &apos;91-100&apos;&#10;elseif ROUND([Calculation_814940494686507027]) &gt; 100 then &apos;100+&apos;&#10;end' />
      </column>
      <column aggregation='None' caption='LT ABV (bin)' datatype='integer' name='[LT AOV (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[Calculation_814940494688366613]' peg='0' size-parameter='[Parameters].[amt_gmv_group Parameter]' />
      </column>
      <column caption='MAX amt' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[MIN amt (copy)_5459207221584998418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([Calculation_814940494688677910] + 0.99)' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Xtableau_aov_development' datatype='table' name='[__tableau_internal_object_id__].[_tableau_aov_development_567B261D4CE34764A21204C5A060873A]' role='measure' type='quantitative' />
      <column caption='Access Group' datatype='string' name='[access_group]' role='dimension' type='nominal' />
      <column caption='Country' datatype='string' name='[common_name]' role='dimension' type='nominal' />
      <column caption='Global Entity Id (Tableau Gsr Entitlements Global Entity Id)' datatype='string' name='[global_entity_id (tableau_gsr_entitlements_global_entity_id)]' role='dimension' type='nominal' />
      <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
      <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
      <column datatype='string' name='[nth_order (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[nth_order]' new-bin='true'>
          <bin default-name='false' value='&quot;First DS Order&quot;'>
            <value>&quot;1&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Reorder&quot;'>
            <value>&quot;10&quot;</value>
            <value>&quot;11+&quot;</value>
            <value>&quot;2&quot;</value>
            <value>&quot;3&quot;</value>
            <value>&quot;4&quot;</value>
            <value>&quot;5&quot;</value>
            <value>&quot;6&quot;</value>
            <value>&quot;7&quot;</value>
            <value>&quot;8&quot;</value>
            <value>&quot;9&quot;</value>
          </bin>
