          <datasource-dependencies datasource='federated.0fo149o0sdbh6615cwt8u0bnffz3'>
            <column aggregation='Attribute' caption='Total Movement Qty' datatype='integer' name='[Calculation_130604412125782019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{EXCLUDE [stock_move_type],&#10;         [stock_move_source],&#10;         [stock_move_reason_group],&#10;         [stock_move_reason_group]: &#10;SUM([movement_qty])}' />
            </column>
            <column caption='Movement Qty Pct' datatype='real' name='[Calculation_130604412172591112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([movement_qty])/SUM([Calculation_130604412125782019])) * 100' />
            </column>
            <column caption='Movement Metric' datatype='real' name='[Calculation_300615293174562816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Currency (copy)_130604412156510213] = &apos;Qty&apos; THEN SUM([movement_qty])&#10;ELSEIF [Parameters].[Currency (copy)_130604412156510213] = &apos;Qty Percentage&apos; THEN &#10;[Calculation_130604412172591112]&#10;ELSEIF [Parameters].[Currency (copy)_130604412156510213] = &apos;Value&apos; THEN &#10;SUM([Calculation_6382093278263787520])&#10;ELSEIF [Parameters].[Currency (copy)_130604412156510213] = &apos;Value Percentage&apos; THEN &#10;[Movement Qty Pct (copy)_6382093278265237507]&#10;END' />
            </column>
            <column caption='Date' datatype='date' name='[Calculation_3781123748631592964]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1], &#10;[stock_date], &apos;monday&apos;))' />
            </column>
            <column caption='Movement Value' datatype='real' name='[Calculation_6382093278263787520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Euro&apos; THEN [cost_price_eur]*[movement_qty]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Local&apos; THEN [cost_price_lc]*[movement_qty]&#10;END' />
            </column>
            <column aggregation='Attribute' caption='Total Movement Value' datatype='real' name='[Calculation_6382093278265118722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{EXCLUDE [stock_move_type],&#10;         [stock_move_source],&#10;         [stock_move_reason_group],&#10;         [stock_move_reason_group]: &#10;SUM([Calculation_6382093278263787520])}' />
