    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='KPI Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/Darkstores-DistributionCentreReport/KPIDefinitions?rev=' id='KPIDefinitions' path='/t/GlobalStandardReporting/workbooks/Darkstores-DistributionCentreReport_16455162093370' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='6500' id='3' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='16'>KPI Definitions</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='45125' id='5' type-v2='text' w='98400' x='800' y='7500'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='10'>Total Purchase Orders: Total amount of completed purchase orders in the country for a  given time period.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Purchase Orders (To DC): Total amount of completed purchase orders sent to the distribution center for a  given time period.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Store Transfer (From DC): Total store transfers generated from the distribution center for a  given time period</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>DC Unique SKUs: Total unique SKUs in the DC with on_hand_qty &gt; 0</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Country Availability (All Stores): Availability percentage on a Country level</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Share of Items at DC: Percentage of items that are available in the Distribution Center</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>DC - Inbound (Item Level): Items recieved via a purchase order into the distribution center in a given period</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>DC - Inventory (Item Level): Items stored in the distribution center for a given period</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>DC - Outbound (Item Level): Items transferred out of the  distribution center via a store transfer in a given period</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='46375' id='6' type-v2='text' w='98400' x='800' y='52625'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
