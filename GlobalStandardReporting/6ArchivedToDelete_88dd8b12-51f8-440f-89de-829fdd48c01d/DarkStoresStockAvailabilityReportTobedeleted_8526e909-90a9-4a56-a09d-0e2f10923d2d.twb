          <datasource-dependencies datasource='Parameters'>
            <column alias='Local' caption='Currency' datatype='string' name='[Date Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
              <aliases>
                <alias key='&quot;Euro&quot;' value='Euro' />
                <alias key='&quot;Local&quot;' value='Local' />
              </aliases>
            </column>
            <column alias='Monthly' caption='Date Granularity' datatype='string' name='[Stock Date Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.105skd30kdr4al1g4ct751ezxf9j'>
            <column caption='Avg Daily Stale SKU Count' datatype='real' name='[Calculation_1698208962397720576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_stale_skus])/COUNTD([stock_date])' />
            </column>
            <column caption='Date' datatype='date' name='[Calculation_3098546961567268864]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Stock Date Parameter], &#10;[stock_date], &apos;monday&apos;))' />
            </column>
            <column caption='% Availability' datatype='real' name='[Calculation_3098546961571303425]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([available_instances])/sum([total_instances])' />
            </column>
            <column caption='# Stores' datatype='integer' name='[Calculation_3098546961571733506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF(INT([is_dmart])) = 1 THEN [warehouse_id] END)' />
            </column>
            <column caption='# DCs' datatype='integer' name='[Calculation_3098546961610768388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF(INT([is_dc])) = 1 THEN [warehouse_id] END)' />
            </column>
            <column caption='GMV Net' datatype='real' name='[Calculation_6806768684872617984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Date Granularity (copy)] = &apos;Euro&apos; THEN [total_price_paid_net_eur]&#10;ELSEIF [Parameters].[Date Granularity (copy)] = &apos;Local&apos; THEN [total_price_paid_net_lc]&#10;END' />
            </column>
            <column caption='Total GMV' datatype='real' name='[Calculation_6806768684873449473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{EXCLUDE [common_name],&#10;         [warehouse_name],&#10;         [warehouse_id],&#10;         [category_parent_english]: &#10;SUM([total_price_paid_net_eur])}' />
            </column>
