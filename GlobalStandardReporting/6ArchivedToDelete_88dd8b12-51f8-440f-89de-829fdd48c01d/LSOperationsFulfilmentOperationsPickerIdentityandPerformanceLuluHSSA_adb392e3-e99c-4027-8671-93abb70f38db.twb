    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Definitions'>
      <repository-location derived-from='http://ip-172-31-0-74:8271/t/GlobalStandardReporting/workbooks/LS-Operations-FulfilmentOperations-PickerIdentityandPerformanceLulu-HS_SA/Definitions?rev=' id='Definitions' path='/t/GlobalStandardReporting/workbooks/LS-Operations-FulfilmentOperations-PickerIdentityandPerformanceLulu-HS_SA' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1100' maxwidth='1000' minheight='1100' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='13909' id='3' is-scaled='1' param='Image/Delivery-Hero-Comet.png' type-v2='bitmap' w='11500' x='1000' y='909' />
        <zone forceUpdate='true' h='15818' id='4' type-v2='text' w='58300' x='16800' y='909'>
          <formatted-text>
            <run fontcolor='#e15759' fontsize='32'>Picker identity Local Shops</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#606b76' fontsize='12'>QUICK-COMMERCE</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='4' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='5727' id='5' type-v2='text' w='42000' x='800' y='14273'>
          <formatted-text>
            <run bold='true' fontcolor='#e15759' fontsize='18'>Metrics: </run>
            <run fontcolor='#ea565f' fontsize='14' italic='true'>Definitions &amp; Calculations</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='4' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='74273' id='6' type-v2='text' w='83400' x='1400' y='19364'>
          <formatted-text>
            <run fontcolor='#606b76' fontsize='11'>‣ </run>
            <run bold='true' fontcolor='#606b76' fontsize='11'># Total orders:  </run>
            <run fontcolor='#606b76' fontsize='11'>Qty of total orders (successful or not)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>Calculation</run>
            <run fontcolor='#606b76' fontsize='11'>: SUM (#Total orders)</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>‣ </run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>% Succ. orders</run>
            <run fontcolor='#606b76' fontsize='11'>: % of orders that were successful </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>Calculation</run>
            <run fontcolor='#606b76' fontsize='11'>: (SUM # Picked_Up/ SUM #Total orders)</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>‣ </run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>% Partial fulfillment rate (New): </run>
            <run fontcolor='#606b76' fontsize='11'>% of orders that were partially fulfilled </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>Calculation</run>
            <run fontcolor='#606b76' fontsize='11'>: (# partial fulfilled orders/ #pelican_confirmed_orders)</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>‣ </run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>#Partial fulfilled orders (New): </run>
            <run fontcolor='#606b76' fontsize='11'>Qty of orders that were partially fulfilled </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>Calculation</run>
            <run fontcolor='#606b76' fontsize='11'>: (SUM #all_pelican_partially_fulfilled)</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>‣ </run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>% Fill rate:  </run>
            <run fontcolor='#606b76' fontsize='11'>% of items that were sold from those which were ordered</run>
            <run>Æ&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>Æ </run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>Calculation</run>
            <run fontcolor='#606b76' fontsize='11'>:  SUM(items sold)/ SUM (items ordered)</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>‣ </run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>% Fail due to OOS rate: </run>
            <run fontcolor='#606b76' fontsize='11'>% of total orders that were failed due to OOS</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>Calculation</run>
            <run fontcolor='#606b76' fontsize='11'>: SUM(fail_due_to_oos)/SUM(total_orders)</run>
            <run>Æ&#10;&#10;</run>
            <run fontsize='11' italic='true'>‣ </run>
            <run bold='true' fontsize='11' italic='true'>#Products  for replacement</run>
            <run fontsize='11' italic='true'>:  Sum of products for replacement</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='11' italic='true'>Calculation</run>
            <run fontsize='11' italic='true'>: SUM(products_for_replacement)</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>‣ </run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>% Replaced items from eligible: </run>
            <run fontcolor='#606b76' fontsize='11'>% of SKUs that were replaced from those that were eligible for replacement</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>Calculation</run>
            <run fontcolor='#606b76' fontsize='11'>: SUM(products for replacement)/(Sum(products_not_found + products_for_replacement))</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>‣ #</run>
            <run bold='true' fontcolor='#606b76' fontsize='11'> Picking time in seconds (per item): </run>
            <run fontcolor='#606b76' fontsize='11'>Time in seconds to pick each item in each order - on average</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>Calculation</run>
            <run fontcolor='#606b76' fontsize='11'>: SUM(picking_time_minutes_pelican)/(Sum(qty_sold))</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>‣ #</run>
            <run bold='true' fontcolor='#606b76' fontsize='11'> avg distinct SKUs per hour: </run>
            <run fontcolor='#606b76' fontsize='11'>Number of distinct SKUs picked on average each hour. Resets count in different orders.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>Calculation</run>
            <run fontcolor='#606b76' fontsize='11'>: SUM([qty_sold_distinct])/(SUM[# Picking time hours])</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>‣ </run>
            <run bold='true' fontcolor='#606b76' fontsize='11'># avg picked items per hour:</run>
            <run fontcolor='#606b76' fontsize='11'> Number of items picked on average per hour.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>Calculation</run>
            <run fontcolor='#606b76' fontsize='11'>:  SUM([qty_sold])/(SUM[# Picking time hours])</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>‣ </run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>% Orders within vendor: </run>
            <run fontcolor='#606b76' fontsize='11'>% of orders of that vendor that were picked by that picker</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>Calculation: </run>
            <run fontcolor='#606b76' fontsize='11'>SUM(orders picked at picker level) / SUM (orders picker at vendor level)</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>‣ </run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>Vendor pickers: </run>
            <run fontcolor='#606b76' fontsize='11'>Number of pickers on that dimension</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>Calculation: </run>
            <run fontcolor='#606b76' fontsize='11'>COUNT DISTINCT(picker_id)</run>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='4' />
            <format attr='background-color' value='#f5f5f586' />
          </zone-style>
        </zone>
      </zones>
