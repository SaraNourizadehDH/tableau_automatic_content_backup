          <datasource-dependencies datasource='federated.1hwiqww1bgbdze15ren4e11nkc4g'>
            <column caption='#f Pickers vendor' datatype='integer' name='[Calculation_1162632446265827329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [city], [chain_name], [vendor_name], [local_date] : COUNTD([picker_id]) }' />
            </column>
            <column caption='% Orders within vendor' datatype='real' name='[Calculation_1162632446330474501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_907334642101682193]/SUM([Calculation_907334642099384334])' />
            </column>
            <column caption='# Pelican confirmed orders' datatype='integer' name='[Calculation_191332672206401538]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pelican_confirmed_orders])' />
            </column>
            <column caption='# Items initiated for replacament' datatype='integer' name='[Calculation_191332672207777795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(SUM([replacement_started]),0)' />
            </column>
            <column caption='# Products not found' datatype='integer' name='[Calculation_191332672210051077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([products_notfound])' />
            </column>
            <column caption='# Picking time minutes' datatype='real' name='[Calculation_4260616417538752512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pelican_picking_time_minutes])' />
            </column>
            <column caption='# Picking time in seconds (per item)' datatype='real' name='[Calculation_4260616417538834433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4260616417538752512]*60/[Calculation_907334642093821959]' />
            </column>
            <column caption='Total picking seconds' datatype='string' name='[Calculation_4260616417545216007]' role='measure' type='nominal'>
              <calculation class='tableau' formula='RIGHT(&quot;0&quot; + STR(FLOOR([Calculation_4260616417538834433]*60%60)),2)' />
            </column>
            <column caption='@ Picking time' datatype='string' datatype-customized='true' default-format='*mm:ss' name='[Calculation_4260616417546919945]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Total picking seconds (copy)_4260616417546096648]+&apos;:&apos;+[Calculation_4260616417545216007]' />
            </column>
            <column caption='# Products for replacement' datatype='integer' name='[Calculation_5961851168990617601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([products_for_repalcement])' />
            </column>
            <column caption='# Succ. Orders' datatype='integer' name='[Calculation_907334642092838918]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;  IF [pelican_order_status] = &quot;PICKED_UP&quot; OR [pelican_order_status] = &quot;PICKED_UP_BY_CUSTOMER&quot;&#10;  THEN [total_orders]&#10;  ELSE 0&#10;  END&#10;)' />
            </column>
            <column caption='# Items sold' datatype='real' name='[Calculation_907334642093821959]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_sold])' />
            </column>
            <column caption='# Items ordered' datatype='real' name='[Calculation_907334642093899784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_ordered])' />
            </column>
            <column caption='# Partial fulf. orders' datatype='integer' name='[Calculation_907334642094174217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([all_pelican_partially_fulfilled])' />
            </column>
            <column caption='# Fail due to OOS' datatype='integer' name='[Calculation_907334642094645258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_due_to_oos])' />
            </column>
            <column caption='#f Orders vendors' datatype='integer' name='[Calculation_907334642099384334]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [management_entity],[global_entity_id], [city], [chain_name], [vendor_name], [local_date] : SUM([total_orders]) }' />
            </column>
            <column caption='# Total orders' datatype='integer' name='[Calculation_907334642101682193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_orders])' />
            </column>
            <column caption='% Succ. Orders' datatype='real' name='[Calculation_907334642102194195]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_907334642092838918]/[Calculation_907334642101682193]' />
            </column>
            <column caption='% Found rate' datatype='real' name='[Calculation_907334642102505492]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_907334642093821959]/[Calculation_907334642093899784]' />
            </column>
            <column caption='% Partial fulfillment rate' datatype='real' name='[Calculation_907334642102640663]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Calculation_907334642094174217]/[Calculation_191332672206401538],0)' />
            </column>
            <column caption='% Fail due to OOS rate' datatype='real' name='[Calculation_907334642102779928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_907334642094645258]/[Calculation_907334642101682193]' />
            </column>
            <column caption='% Replaced items from eligible' datatype='real' name='[Calculation_907334642102906905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5961851168990617601]/([Calculation_191332672210051077]+[Calculation_5961851168990617601])' />
            </column>
            <column caption='Null_picker_id' datatype='boolean' name='[Calculation_907334642106114075]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ISNULL([picker_id])' />
            </column>
            <column caption='Total picking minutes' datatype='string' name='[Total picking seconds (copy)_4260616417546096648]' role='measure' type='nominal'>
              <calculation class='tableau' formula='RIGHT(&quot;0&quot; + STR(FLOOR([Calculation_4260616417538834433])),2)' />
