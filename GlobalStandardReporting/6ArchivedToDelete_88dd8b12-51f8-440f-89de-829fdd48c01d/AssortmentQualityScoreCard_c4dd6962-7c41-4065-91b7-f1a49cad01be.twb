    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='ScoreCard Calculation'>
      <repository-location id='ScoreCardCalculation' path='/t/GlobalStandardReporting/workbooks/AssortmentQualityScoreCard' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1000' maxwidth='1000' minheight='1000' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='6' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='3900' id='5' type-v2='text' w='98400' x='800' y='53300'>
            <formatted-text>
              <run bold='true' fontcolor='#e15759' fontsize='18'>How is the Score calculated?</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='11400' id='7' type-v2='text' w='98400' x='800' y='57200'>
            <formatted-text>
              <run fontcolor='#000000' fontsize='10'>In order to obtain the final score, the eight KPIs shown below are taken into account. Depending on the performance of each month, each KPI receives an specific amount of points and then those points are multiplied by the weight of each KPI and added altogether to have a final score between 0 and 100. Please refer to the image below to understand better the weight and points per each KPI  </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='30600' id='8' is-centered='0' is-scaled='1' param='Image/AQSC_Scoring System.PNG' type-v2='bitmap' w='98400' x='800' y='68600'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='16567' id='45' is-centered='0' is-scaled='1' param='Image/DH-Logo_Tableau.PNG' type-v2='bitmap' w='14400' x='800' y='800'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='16567' id='46' type-v2='text' w='84000' x='15200' y='800'>
            <formatted-text>
              <run fontcolor='#e15759' fontsize='32'>Assortment Quality ScoreCard</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#606b76' fontsize='12'>QUICK-COMMERCE</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#c70b5d' fontsize='13'>D-Marts</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='5271' id='47' type-v2='text' w='98400' x='800' y='17367'>
            <formatted-text>
              <run bold='true' fontcolor='#e15759' fontsize='18'>Metrics: </run>
              <run fontcolor='#ea565f' fontsize='14' italic='true'>Definitions &amp; Calculations</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='30662' id='48' type-v2='text' w='98400' x='800' y='22638'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='11'>Avg Listed SKUs</run>
              <run fontcolor='#000000' fontsize='11'>: Average number of listed SKUs (only mature warehouses are considered)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Efficiency</run>
              <run fontcolor='#000000' fontsize='11'><![CDATA[: 1 - (Number of listed SKUs older than 90 days with average unit sold < 1 per warehouse-week / Number of listed SKUs older than 90 days)]]></run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Avg. Coverage L3 Categories</run>
              <run fontcolor='#000000' fontsize='11'>: The average number of  listed Level 3 Categories / total number Level 3 Categories per country</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>UltraFresh GPV contribution:</run>
              <run fontcolor='#000000' fontsize='11'> GPV contribution by UltraFresh categories - Produce, Ready to Consume and Meat/Seafood</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Newness:  </run>
              <run fontcolor='#000000' fontsize='11'><![CDATA[Number of SKUs < 90 days old / Number of listed SKUs]]></run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Spoilage:</run>
              <run fontcolor='#000000' fontsize='11'> Shrinkage due to </run>
              <run bold='true' fontcolor='#000000' fontsize='11'>expiry</run>
              <run fontcolor='#000000' fontsize='11'>, not damaged / other stock adjustments. (Spoilage / GMV )</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>DOH </run>
              <run fontcolor='#000000' fontsize='11'>(</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Days on Hand):</run>
              <run fontcolor='#000000' fontsize='11'> book value / COGS for given period</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Content Score: </run>
              <run fontcolor='#000000' fontsize='11'>Average of aggregated completeness and quality metrics score</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>ABV:</run>
              <run fontcolor='#000000' fontsize='11'> Average Basket Value:  Total GPV / Number of orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>Frequency</run>
              <run fontcolor='#000000' fontsize='11'>: Number of Orders / Number of Unique Customers</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='11'>CVR (Dmart homepage to Transaction)</run>
              <run fontcolor='#000000' fontsize='11'>: Conversion rate i.e total number of sessions with transactions/total number of sessions</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
