    <worksheet name='TimeSeries - ScoreLine'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='assortment_quality_scorecard (dev_dmart)' name='federated.15l6rta1088oux1dx3dar03qh865' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='X Axis' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Score&quot;'>
              <calculation class='tableau' formula='&quot;Score&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15l6rta1088oux1dx3dar03qh865'>
            <column caption='2. Score Asst. Design Gap ' datatype='integer' name='[1. Score Avg Listed SKUs (copy)_1185854145411874821]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [gap_design_score]  &gt; 30 THEN 0&#13;&#10;ELSEIF [gap_design_score] &gt;= 27.5 THEN 1&#13;&#10;ELSEIF [gap_design_score] &gt;= 25 THEN 2&#13;&#10;ELSEIF [gap_design_score] &gt;= 22.5 THEN 3&#13;&#10;ELSEIF [gap_design_score] &gt;= 20 THEN 4&#13;&#10;ELSEIF [gap_design_score] &gt;= 17.5 THEN 5&#13;&#10;ELSEIF [gap_design_score] &gt;= 15 THEN 6&#13;&#10;ELSEIF [gap_design_score] &gt;= 12.5 THEN 7&#13;&#10;ELSEIF [gap_design_score] &gt;= 10 THEN 8&#13;&#10;ELSEIF [gap_design_score] &gt;= 7.5 THEN 9&#13;&#10;ELSE 10 END' />
            </column>
            <column caption='3. Score Efficiency %' datatype='integer' name='[1. Score Avg Listed SKUs (copy)_1185854145413308422]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [check_efficiency]  &lt;= .45 THEN 0&#13;&#10;ELSEIF [check_efficiency]  &lt;= .5 THEN 1&#13;&#10;ELSEIF [check_efficiency]  &lt;= .55 THEN 2&#13;&#10;ELSEIF [check_efficiency]  &lt;= .6 THEN 3&#13;&#10;ELSEIF [check_efficiency]  &lt;= .65 THEN 4&#13;&#10;ELSEIF [check_efficiency]  &lt;= .7 THEN 5&#13;&#10;ELSEIF [check_efficiency]  &lt;= .75 THEN 6&#13;&#10;ELSEIF [check_efficiency]  &lt;= .8 THEN 7&#13;&#10;ELSEIF [check_efficiency]  &lt;= .85 THEN 8&#13;&#10;ELSEIF [check_efficiency]  &lt;= .9 THEN 9&#13;&#10;ELSE 10 END' />
            </column>
            <column caption='8. Score DOH' datatype='integer' name='[2. Score Asst. Design Gap  (copy)_1185854145417588747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [check_doh]  &gt; 40 THEN 0&#13;&#10;ELSEIF [check_doh] &gt;= 37.5 THEN 1&#13;&#10;ELSEIF [check_doh] &gt;= 35 THEN 2&#13;&#10;ELSEIF [check_doh] &gt;= 32.5 THEN 3&#13;&#10;ELSEIF [check_doh] &gt;= 30 THEN 4&#13;&#10;ELSEIF [check_doh] &gt;= 27.5 THEN 5&#13;&#10;ELSEIF [check_doh] &gt;= 25 THEN 6&#13;&#10;ELSEIF [check_doh] &gt;= 22.5 THEN 7&#13;&#10;ELSEIF [check_doh] &gt;= 20 THEN 8&#13;&#10;ELSEIF [check_doh] &gt;= 17.5 THEN 9&#13;&#10;ELSE 10 END' />
            </column>
            <column caption='4. Score L3 Coverage %' datatype='integer' name='[3. Score Efficiency % (copy)_1185854145414529031]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [check_l3_coverage]  &lt;= .45 THEN 0&#13;&#10;ELSEIF [check_l3_coverage]  &lt;= .5 THEN 1&#13;&#10;ELSEIF [check_l3_coverage]  &lt;= .55 THEN 2&#13;&#10;ELSEIF [check_l3_coverage]  &lt;= .6 THEN 3&#13;&#10;ELSEIF [check_l3_coverage]  &lt;= .65 THEN 4&#13;&#10;ELSEIF [check_l3_coverage]  &lt;= .7 THEN 5&#13;&#10;ELSEIF [check_l3_coverage]  &lt;= .75 THEN 6&#13;&#10;ELSEIF [check_l3_coverage]  &lt;= .8 THEN 7&#13;&#10;ELSEIF [check_l3_coverage]  &lt;= .85 THEN 8&#13;&#10;ELSEIF [check_l3_coverage]  &lt;= .9 THEN 9&#13;&#10;ELSE 10 END' />
            </column>
            <column caption='5. Score Ultrafresh GPV Contr' datatype='integer' name='[4. Score L3 Coverage % (copy)_1185854145415168008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1185854145189216256]  &lt;= .05 THEN 0&#13;&#10;ELSEIF [Calculation_1185854145189216256]  &lt;= .08 THEN 1&#13;&#10;ELSEIF [Calculation_1185854145189216256]  &lt;= .1 THEN 2&#13;&#10;ELSEIF [Calculation_1185854145189216256]  &lt;= .13 THEN 3&#13;&#10;ELSEIF [Calculation_1185854145189216256]  &lt;= .15 THEN 4&#13;&#10;ELSEIF [Calculation_1185854145189216256]  &lt;= .175 THEN 5&#13;&#10;ELSEIF [Calculation_1185854145189216256]  &lt;= .2 THEN 6&#13;&#10;ELSEIF [Calculation_1185854145189216256]  &lt;= .225 THEN 7&#13;&#10;ELSEIF [Calculation_1185854145189216256]  &lt;= .25 THEN 8&#13;&#10;ELSEIF [Calculation_1185854145189216256]  &lt;= .275 THEN 9&#13;&#10;ELSE 10 END' />
            </column>
            <column caption='6. Score Newness %' datatype='integer' name='[5. Ultrafresh GPV Contr (copy)_1185854145415806985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [check_newness]  &lt;= .05 THEN 0&#13;&#10;ELSEIF [check_newness]  &lt;= .06 THEN 1&#13;&#10;ELSEIF [check_newness]  &lt;= .07 THEN 2&#13;&#10;ELSEIF [check_newness]  &lt;= .08 THEN 3&#13;&#10;ELSEIF [check_newness]  &lt;= .09 THEN 4&#13;&#10;ELSEIF [check_newness]  &lt;= .1 THEN 5&#13;&#10;ELSEIF [check_newness]  &lt;= .11 THEN 6&#13;&#10;ELSEIF [check_newness]  &lt;= .12 THEN 7&#13;&#10;ELSEIF [check_newness]  &lt;= .13 THEN 8&#13;&#10;ELSEIF [check_newness]  &lt;= .14 THEN 9&#13;&#10;ELSE 10 END' />
            </column>
            <column caption='7. Score Spoilage %' datatype='integer' name='[6. Score Newness % (copy)_1185854145416654858]' role='measure' type='quantitative'>
