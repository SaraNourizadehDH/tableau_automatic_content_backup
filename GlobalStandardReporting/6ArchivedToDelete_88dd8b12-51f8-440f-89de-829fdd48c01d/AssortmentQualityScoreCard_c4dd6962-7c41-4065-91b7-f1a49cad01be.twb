              <calculation class='tableau' formula='IF [avg_listed_skus_check]  &lt;= 3000 THEN 0&#13;&#10;ELSEIF [avg_listed_skus_check]  &lt;= 3500 THEN 1&#13;&#10;ELSEIF [avg_listed_skus_check]  &lt;= 4000 THEN 2&#13;&#10;ELSEIF [avg_listed_skus_check]  &lt;= 4500 THEN 3&#13;&#10;ELSEIF [avg_listed_skus_check]  &lt;= 5000 THEN 4&#13;&#10;ELSEIF [avg_listed_skus_check]  &lt;= 5500 THEN 5&#13;&#10;ELSEIF [avg_listed_skus_check]  &lt;= 6000 THEN 6&#13;&#10;ELSEIF [avg_listed_skus_check]  &lt;= 6500 THEN 7&#13;&#10;ELSEIF [avg_listed_skus_check]  &lt;= 7000 THEN 8&#13;&#10;ELSEIF [avg_listed_skus_check]  &lt;= 7500 THEN 9&#13;&#10;ELSE 10 END' />
