          <format attr='vertical-align' id='dash-text_385' value='top' />
          <format attr='vertical-align' id='dash-text_386' value='top' />
        </style-rule>
      </style>
      <size maxheight='868' maxwidth='1466' minheight='868' minwidth='1466' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98156' id='375' param='vert' type-v2='layout-flow' w='98908' x='546' y='922'>
            <zone fixed-size='49' forceUpdate='true' h='6567' id='380' is-fixed='true' type-v2='text' w='98908' x='546' y='922'>
              <formatted-text>
                <run bold='true' fontcolor='#ffffff' fontsize='15'>KPI Definitions</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='background-color' value='#555555' />
              </zone-style>
            </zone>
            <zone fixed-size='123' forceUpdate='true' h='15093' id='3' is-fixed='true' type-v2='text' w='98908' x='546' y='7489'>
              <formatted-text>
                <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Total DT - Dmart : Avg. of ( rider_near_customer_at - placed_at ) for Dmart orders</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Total DT - Logistics : Avg. of actual_delivery_time (From Logistics)</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#ffffff' fontsize='10'>Partial Fulfillment Rate (%) : 1 - ( Sum of Qty Sold / Sum of Qty Ordered )</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Basket Size : Sum of Qty Sold / Count of Dmart Orders</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#ffffff' fontsize='10'>AOV (EUR) : Sum of Amt Gmv Eur / Count of Dmart Orders</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
                <format attr='background-color' value='#555555' />
              </zone-style>
            </zone>
            <zone fixed-size='297' h='34217' id='389' is-fixed='true' type-v2='layout-basic' w='98908' x='546' y='22582'>
              <zone fixed-size='743' forceUpdate='true' h='34217' id='381' is-fixed='true' type-v2='text' w='50750' x='546' y='22582'>
                <formatted-text>
                  <run bold='true' fontcolor='#ffffff' fontsize='12'>Delivery Process KPIs</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Transmission Time : Avg. of ( created_at - placed_at )</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Hold Time : Avg. of ( available_at_in_pelican - created_at )</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Assignment Time : Avg. of ( assigned_at - available_at_in_pelican )</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Picking Time : Avg. of ( checkout_confirmed_at - assigned_at )</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Packaging Time : Avg. of ( ready_for_pickup_at - checkout_confirmed_at )</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Handoff Time : Avg. of ( actual_pickup_at - ready_for_pickup_at )</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Handoff Time (rider late) : Part of Avg. Handoff Time where rider_near_pickup_at &gt; ready_for_pickup_at </run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Handoff Time (dispatching order) : Part of Avg. Handoff Time where actual_pickup_at &gt; rider_near_pickup_at </run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Drive Time : Avg. of ( rider_near_customer_at - actual_pickup_at )</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Rider Late : Avg. of Rider Late Time (From Logistics)</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#555555' />
                </zone-style>
              </zone>
              <zone fixed-size='740' forceUpdate='true' h='34217' id='382' is-fixed='true' type-v2='text' w='48158' x='51296' y='22582'>
                <formatted-text>
                  <run bold='true' fontcolor='#ffffff' fontsize='12'>Rider KPIs</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Rider Late (%) : % of Orders where Rider was Late</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'><![CDATA[Rider Late <1min (%) : % of Orders where Rider was Late by <1 min]]></run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Rider Late 1-3mins (%) : % of Orders where Rider was Late by 1-3 min</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Rider Late 3-5mins (%) : % of Orders where Rider was Late by 3-5 min</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Rider Late 5-10mins (%) : % of Orders where Rider was Late by 5-10 min</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Rider Late &gt;10mins (%) : % of Orders where Rider was Late by &gt;10 min</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Before Commited Pickup (%) : % of Orders where ( estimated_pickup_time - rider_near_pickup_at ) is &gt; 1min</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>After Commited Pickup (%) : % of Orders where ( rider_near_pickup_at - estimated_pickup_time ) is &gt; 1min</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. P-D Distance : Avg. delivery_distance (From Logistics)</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Vendor Walking Time : Avg. estimated_walk_in_duration (From Logistics)</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. At Vendor Time : Avg. of at_vendor_time (From Logistics)</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. At Vendor Time Clean : Avg. of at_vendor_time_cleaned (From Logistics)</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Rider Accepting Time : Avg. of rider_accepting_time (From Logistics)</run>
                  <run>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#555555' />
                </zone-style>
              </zone>
            </zone>
            <zone fixed-size='286' h='32949' id='387' is-fixed='true' type-v2='layout-basic' w='98908' x='546' y='56799'>
              <zone fixed-size='730' forceUpdate='true' h='32948' id='386' is-fixed='true' type-v2='text' w='50750' x='546' y='56799'>
                <formatted-text>
                  <run bold='true' fontcolor='#ffffff' fontsize='12'>Prep Time KPIs</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Est. Prep Time : Avg. estimated_prep_time (From Logistics)</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Actual DMart Prep Time : Sum of (Avg. Assignment Time + Avg. Picking Time + Avg. Packaging Time)</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Prep Time Difference : estimated_prep_time - actual_dmart_prep_time</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Overest. Prep Time &gt;10mins (%) : % of Orders where Prep Time Difference is positive and is &gt; 10min</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Overest. Prep Time 5-10mins (%) : % of Orders where Prep Time Difference is positive and is between 5-10 min</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Overest. Prep Time 3-5mins (%) : % of Orders where Prep Time Difference is positive and is between 3-5 min</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Overest. Prep Time 1-3mins (%) : % of Orders where Prep Time Difference is positive and is between 1-3 min</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'><![CDATA[Synced Est. Prep Time (%) : % of Orders where estimated_prep_time & actual_dmart_prep_time matches (< 1 min Diff.)]]></run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Underest. Prep Time 1-3mins (%) : % of Orders where Prep Time Difference is negative and is between 1-3 min</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Underest. Prep Time 3-5mins (%) : % of Orders where Prep Time Difference is negative and is between 3-5 min</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Underest. Prep Time 5-10mins (%) : % of Orders where Prep Time Difference is negative and is between 5-10 min</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Underest. Prep Time &gt;10mins (%) : % of Orders where Prep Time Difference is negative and is &gt; 10min</run>
                  <run>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#555555' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='32947' id='385' type-v2='text' w='48158' x='51296' y='56801'>
                <formatted-text>
                  <run bold='true' fontcolor='#ffffff' fontsize='12'>Stacking KPIs</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Stacking (%) : % of Orders where stacked_deliveries &gt; 0</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Single Stacking (%) : % of Orders where stacked_deliveries = 1</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Double Stacking (%) : % of Orders where stacked_deliveries = 2</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Triple Stacking (%) : % of Orders where stacked_deliveries = 3</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>&gt; Triple Stacking (%) : % of Orders where stacked_deliveries &gt;3</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Total DT (stacked orders) : Part of Avg. Total DT - Dmart where stacked_deliveries &gt; 0</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Total DT (non-stacked orders) : Part of Avg. Total DT - Dmart where stacked_deliveries = 0</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Handoff Time (stacked orders) : Part of Avg. Handoff Time - Dmart where stacked_deliveries &gt; 0</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Handoff Time (non-stacked orders) : Part of Avg. Handoff Time - Dmart where stacked_deliveries = 0</run>
                  <run>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#555555' />
                </zone-style>
              </zone>
            </zone>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='background-color' value='#555555' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
            <format attr='background-color' value='#898989' />
          </zone-style>
        </zone>
      </zones>
