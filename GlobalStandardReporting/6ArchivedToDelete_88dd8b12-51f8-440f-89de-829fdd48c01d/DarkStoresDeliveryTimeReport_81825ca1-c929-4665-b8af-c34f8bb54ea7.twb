      <aliases enabled='yes' />
      <column caption='Avg. Basket Size' datatype='real' name='[AOV (EUR) (copy)_5904922814959935488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qty_sold])/COUNT([order_id_dwh])' />
      </column>
      <column caption='Stacking (%)' datatype='real' name='[At Commited Pickup (%) (copy)_4976618378209214508]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [is_stacked_order] = TRUE THEN [order_id_dwh] END)&#10;/COUNT([order_id_dwh])' />
      </column>
      <column caption='After Commited Pickup' datatype='string' name='[At Commited Pickup (copy) (copy)_4976618378205470759]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [rider_arrival_type] = &apos;after_commited_pickup&apos; THEN [order_id_dwh] END' />
      </column>
      <column caption='Before Commited Pickup' datatype='string' name='[At Commited Pickup (copy)_4976618378205454374]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [rider_arrival_type] = &apos;before_commited_pickup&apos; THEN [order_id_dwh] END' />
      </column>
      <column caption='Avg. At Vendor Time Clean' datatype='real' name='[Avg. At Vendor Time (mins)  (copy)_4976618378202865700]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([at_vendor_time_cleaned])/COUNT([at_vendor_time_cleaned])' />
      </column>
      <column caption='Avg. Handoff Time (stacked orders)' datatype='real' name='[Avg. Handoff Time (copy)_4976618378211262514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_stacked_order] = TRUE THEN [Calculation_4934256373587963909] END)/COUNT([Calculation_4934256373587963909])' />
      </column>
      <column caption='Avg. Handoff Time (rider late)' datatype='real' name='[Avg. Handoff Time (copy)_4976618382463631432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [has_gfs_timestamp] THEN [gfs_handoff_time_rider_late] ELSE [handoff_time_rider_late] END)&#10;/COUNT(IF [has_gfs_timestamp] THEN [gfs_handoff_time_rider_late] ELSE [handoff_time_rider_late] END)' />
      </column>
      <column caption='Avg. Handoff Time (dispatching order)' datatype='real' name='[Avg. Handoff Time (rider late) (copy)_4976618382463795273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [has_gfs_timestamp] THEN [gfs_handoff_time_dispatching_order] ELSE [handoff_time_dispatching_order] END)&#10;/COUNT(IF [has_gfs_timestamp] THEN [gfs_handoff_time_dispatching_order] ELSE [handoff_time_dispatching_order] END)' />
      </column>
      <column caption='Avg. Handoff Time (non-stacked orders)' datatype='real' name='[Avg. Handoff Time (stacked orders) (copy)_4976618378211491891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_stacked_order] = FALSE THEN [Calculation_4934256373587963909] END)/COUNT([Calculation_4934256373587963909])' />
      </column>
      <column caption='Avg. Packaging Time (copy)' datatype='real' name='[Avg. Packaging Time (copy)_4934256371806932993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [has_gfs_timestamp] THEN [gfs_packaging_time] ELSE [packaging_time] END)&#10;/COUNT(IF [has_gfs_timestamp] THEN [gfs_packaging_time] ELSE [packaging_time] END)' />
      </column>
      <column caption='Avg. Packaging Time' datatype='real' name='[Avg. Picking Time (mins)  (copy)_4976618378186764308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [has_gfs_timestamp] THEN [gfs_packaging_time] ELSE [packaging_time] END)&#10;/COUNT(IF [has_gfs_timestamp] THEN [gfs_packaging_time] ELSE [packaging_time] END)' />
      </column>
      <column caption='Avg. Actual DMart Prep Time ' datatype='real' name='[Avg. Rider Accepting Time (copy) (copy)_4976618378209988654]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_dmart_prep_time])/COUNT([actual_dmart_prep_time])' />
