    <dashboard name='KPI Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/DarkStores-DeliveryTimeReport_16244384621880/KPIDefinitions?rev=' id='KPIDefinitions' path='/t/GlobalStandardReporting/workbooks/DarkStores-DeliveryTimeReport_16244384621880' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_381' value='top' />
          <format attr='vertical-align' id='dash-text_3' value='center' />
