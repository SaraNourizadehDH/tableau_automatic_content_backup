  <worksheets>
    <worksheet name='ATO Overstock Overview'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'>Overstock Overview(Statistical method)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_overstocking_longer_horizon' name='federated.0plby8e1v5zeov15mzjrb0m47s03' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Geographic granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
            <column caption='exclude SKUs younger than 30 days' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;YES&quot;'>
              <calculation class='tableau' formula='&quot;YES&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0plby8e1v5zeov15mzjrb0m47s03'>
            <column caption='Avg. SKUs/ST' datatype='real' name='[Calculation_5018347013937025024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([src_st_sku_count])/SUM([src_store_transfer])' />
            </column>
            <column caption='Avg. Items/SKU/ST' datatype='real' name='[Calculation_5018347013937369089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([src_st_received_qty])/SUM([src_st_sku_count])' />
            </column>
            <column caption='Avg. ST Time (h)' datatype='real' name='[Calculation_5018347013937627138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dest_reciveing_time_s])/(3600 * sum([dest_store_transfer]))' />
            </column>
            <column caption='ST Time (h) / SKU' datatype='real' name='[Calculation_5018347013937897475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dest_reciveing_time_s])/(3600*sum(dest_st_sku_count))' />
            </column>
            <column caption='Granularity level' datatype='string' name='[Calculation_6072189347747520513]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Region&apos; THEN [region] &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Country&apos; THEN [country] &#10;ELSE [Calculation_6072189347749040130]&#10;END' />
            </column>
            <column caption='Strore Name*' datatype='string' name='[Calculation_6072189347749040130]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[warehouse_name]' />
            </column>
            <column caption='% Overstock share' datatype='real' default-format='p0%' name='[Calculation_6072189347761897475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 3] = &apos;NO&apos; THEN&#10;    (IF [on_hand_qty] &lt; 0 THEN 0&#10;        ELSEIF   ([on_hand_qty] - [safety_stock]) &lt; 0 THEN 0&#10;        ELSE [on_hand_qty] - [safety_stock] &#10;    END)&#10;ELSE&#10;    (IF [on_hand_qty] &lt; 0 AND [sku_age_in_days] &gt;= 30 THEN 0&#10;        ELSEIF   ([on_hand_qty] - [safety_stock]) &lt; 0 AND [sku_age_in_days] &gt;= 30 THEN 0&#10;        ELSEIF ([on_hand_qty] - [safety_stock]) &gt;= 0 AND [sku_age_in_days] &gt;= 30 THEN [on_hand_qty] - [safety_stock] &#10;    END)&#10;END)/SUM([on_hand_qty])' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[action_class]' role='dimension' type='ordinal' />
            <column datatype='string' name='[category_parent_english]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[dest_reciveing_time_s]' role='measure' type='quantitative' />
            <column datatype='integer' name='[dest_st_sku_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[dest_store_transfer]' role='measure' type='quantitative' />
            <column datatype='boolean' name='[is_active]' role='dimension' type='nominal' />
            <column caption='Is Distribution Centre' datatype='boolean' name='[is_dc]' role='dimension' type='nominal' />
