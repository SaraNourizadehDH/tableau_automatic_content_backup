    <worksheet name='ATO overstock'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'>Total Overstock Units</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_overstocking_longer_horizon' name='federated.0plby8e1v5zeov15mzjrb0m47s03' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Geographic granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
            <column caption='exclude SKUs younger than 30 days' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;YES&quot;'>
              <calculation class='tableau' formula='&quot;YES&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0plby8e1v5zeov15mzjrb0m47s03'>
            <column caption='Granularity level' datatype='string' name='[Calculation_6072189347747520513]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Region&apos; THEN [region] &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Country&apos; THEN [country] &#10;ELSE [Calculation_6072189347749040130]&#10;END' />
            </column>
            <column caption='Strore Name*' datatype='string' name='[Calculation_6072189347749040130]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[warehouse_name]' />
            </column>
            <column caption='% Overstock share' datatype='real' default-format='p0%' name='[Calculation_6072189347761897475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 3] = &apos;NO&apos; THEN&#10;    (IF [on_hand_qty] &lt; 0 THEN 0&#10;        ELSEIF   ([on_hand_qty] - [safety_stock]) &lt; 0 THEN 0&#10;        ELSE [on_hand_qty] - [safety_stock] &#10;    END)&#10;ELSE&#10;    (IF [on_hand_qty] &lt; 0 AND [sku_age_in_days] &gt;= 30 THEN 0&#10;        ELSEIF   ([on_hand_qty] - [safety_stock]) &lt; 0 AND [sku_age_in_days] &gt;= 30 THEN 0&#10;        ELSEIF ([on_hand_qty] - [safety_stock]) &gt;= 0 AND [sku_age_in_days] &gt;= 30 THEN [on_hand_qty] - [safety_stock] &#10;    END)&#10;END)/SUM([on_hand_qty])' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[action_class]' role='dimension' type='ordinal' />
            <column datatype='string' name='[category_parent_english]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='boolean' name='[is_active]' role='dimension' type='nominal' />
            <column caption='Is Distribution Centre' datatype='boolean' name='[is_dc]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_dummy_product]' role='dimension' type='nominal' />
            <column caption='Tracking Period' datatype='date' default-format='*yyyy-mm-dd' name='[iso_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_6072189347747520513]' derivation='None' name='[none:Calculation_6072189347747520513:nk]' pivot='key' type='nominal' />
            <column-instance column='[action_class]' derivation='None' name='[none:action_class:ok]' pivot='key' type='ordinal' />
            <column-instance column='[category_parent_english]' derivation='None' name='[none:category_parent_english:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_active]' derivation='None' name='[none:is_active:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_dc]' derivation='None' name='[none:is_dc:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_dummy_product]' derivation='None' name='[none:is_dummy_product:nk]' pivot='key' type='nominal' />
            <column-instance column='[iso_date]' derivation='None' name='[none:iso_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[iso_date]' derivation='None' name='[none:iso_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column-instance column='[time_level]' derivation='None' name='[none:time_level:nk]' pivot='key' type='nominal' />
            <column-instance column='[warehouse_age_in_months]' derivation='None' name='[none:warehouse_age_in_months:qk]' pivot='key' type='quantitative' />
            <column-instance column='[warehouse_name]' derivation='None' name='[none:warehouse_name:nk]' pivot='key' type='nominal' />
            <column caption='On Hand Qty' datatype='real' name='[on_hand_qty]' role='measure' type='quantitative' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Safety Stock' datatype='real' name='[safety_stock]' role='measure' type='quantitative' />
            <column caption='Sku Age In Days' datatype='integer' name='[sku_age_in_days]' role='measure' type='quantitative' />
            <column caption='Stats Overstock Units' datatype='real' name='[stats_overstock_units]' role='measure' type='quantitative' />
            <column-instance column='[stats_overstock_units]' derivation='Sum' name='[sum:stats_overstock_units:qk]' pivot='key' type='quantitative' />
            <column caption='Time granularity' datatype='string' name='[time_level]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_6072189347761897475]' derivation='User' name='[usr:Calculation_6072189347761897475:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[warehouse_age_in_months]' role='measure' type='quantitative' />
            <column caption='Store Name' datatype='string' name='[warehouse_name]' role='dimension' type='nominal' />
          </datasource-dependencies>
