            <column caption='KPI 1' datatype='string' name='[Calculation_558376039638327310]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;perc_platform_orders&apos;             THEN STR(ROUND(100*[Calculation_558376039615393794],2))+ &apos;%&apos;&#10;WHEN &apos;perc_platform_GMV&apos;                THEN STR(ROUND(100*[Calculation_558376039596269569],2))+&apos;%&apos;&#10;WHEN &apos;perc_ls_orders&apos;                   THEN STR(ROUND(100*[Calculation_558376039620542470],2)) + &apos;%&apos;&#10;WHEN &apos;perc_local_store_GMV&apos;             THEN STR(ROUND(100*[% of Local Store orders (copy)_558376039626760201],2)) + &apos;%&apos;&#10;WHEN &apos;num_stores_online&apos;                THEN STR(SUM([online_vendors]))&#10;WHEN &apos;num_active_stores&apos;                THEN STR(SUM([active_vendors]))&#10;WHEN &apos;num_new_stores&apos;                   THEN STR(SUM([new_online_vendors]))&#10;WHEN &apos;num_stores_offline&apos;               THEN STR(SUM([offline_vendors]))&#10;WHEN &apos;Avg_orders_per_store&apos;             THEN STR(ROUND([AVG Orders per Store [LS]] (copy)_558376039627743242],2))&#10;WHEN &apos;Avg_order_per_new_store&apos;          THEN STR(ROUND([AVG Orders per New Store [LS]] (copy)_558376039629807627],2))&#10;END' />
