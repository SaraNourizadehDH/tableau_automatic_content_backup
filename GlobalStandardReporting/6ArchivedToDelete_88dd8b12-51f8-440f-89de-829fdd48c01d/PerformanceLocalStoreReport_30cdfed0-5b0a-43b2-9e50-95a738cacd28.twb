      <datasource-dependencies datasource='Parameters'>
        <column alias='% of platform GMV' caption='KPI Selector' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;perc_platform_GMV&quot;'>
          <calculation class='tableau' formula='&quot;perc_platform_GMV&quot;' />
          <aliases>
            <alias key='&quot;Avg_order_per_new_store&quot;' value='Avg. order per new store (added in the last 30 days)' />
            <alias key='&quot;Avg_orders_per_store&quot;' value='Avg. orders per store' />
            <alias key='&quot;num_active_stores&quot;' value='# of active stores' />
            <alias key='&quot;num_new_stores&quot;' value='# of new stores' />
            <alias key='&quot;num_stores_offline&quot;' value='# of stores offline' />
            <alias key='&quot;num_stores_online&quot;' value='# of stores online' />
            <alias key='&quot;perc_local_store_GMV&quot;' value='% of Local Store GMV' />
            <alias key='&quot;perc_ls_orders&quot;' value='% of Local Store orders' />
            <alias key='&quot;perc_platform_GMV&quot;' value='% of platform GMV' />
            <alias key='&quot;perc_platform_orders&quot;' value='% of platform orders' />
          </aliases>
        </column>
        <column caption='Top Shop Type' datatype='integer' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='10'>
          <calculation class='tableau' formula='10' />
          <range granularity='5' max='20' min='5' />
        </column>
