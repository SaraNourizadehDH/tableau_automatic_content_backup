              <calculation class='tableau' formula='SUM([GMV [DMarts]] (copy)_5249015770722947089])/SUM([Orders [LS]] fixed (copy)_558376039626600456])' />
            </column>
            <column caption='Avg. Order Per New Store' datatype='real' name='[AVG Orders per New Store [LS]] (copy)_558376039629807627]' role='measure' type='quantitative'>
