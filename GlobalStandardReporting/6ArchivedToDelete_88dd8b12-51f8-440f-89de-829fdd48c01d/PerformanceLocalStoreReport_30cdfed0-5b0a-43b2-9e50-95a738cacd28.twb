              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#535353' />
            </zone-style>
          </zone>
          <zone h='19233' id='7' type-v2='empty' w='98400' x='800' y='80040'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#535353' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='68127' id='17' type-v2='text' w='98400' x='800' y='11913'>
            <formatted-text>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='14'>Performance</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>Orders [LS]</run>
              <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'> : # of successful orders (orders which were successfully delivered)</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='14'>Marketing</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>Acquisitions [LS]</run>
              <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'> : # of first orders on the platform</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>Organic Acquisitions [LS] </run>
              <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>: Platform customers who place their first order on Local Stores</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>Voucher Revenue Reduction [LS] %</run>
              <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'> : Voucher Amount EUR / GMV of Total Orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>Adoption [LS]</run>
              <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>: % of total platform active customers who placed a Local Store order</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>Adoption among customer base covered by LS %</run>
              <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>: % of total platform active customers who are covered by LS who placed a LS order</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='14'>Inventory &amp; Coverage</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>Online Vendors : </run>
              <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'># of vendors which are online in the specific timeframe (w and w/o orders) </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>Last 4 Weeks Vendors Churned [LS] </run>
              <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>: # of churned vendors in the previous 4 weeks</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>AVG Orders per New Store [LS] : </run>
              <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>Store is counted as new if the activation date is within the selected week</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>Offline Time [LS] % :</run>
              <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'> Offline Time of a Vendor VS Scheduled Open Time</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='14'>Affordability</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>ABV</run>
              <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'> : Avg. basket value in EUR, excluding delivery fee. GMV in EUR / # of successful orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>Deal Orders [LS] % </run>
              <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>: % of succesful orders with Discounts applied</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>AVG Delivery Fee [LS]</run>
              <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'> : delivery fee / # of successful orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>Avg. MOV : </run>
              <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>average of minimum commissionable value</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='14'>Customer Experience</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>AVG Re-order Rate % [LS] : </run>
              <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>Returning LS customers within 30days from order date / Total LS customers. Considers as reorder an order in any LS shop type, not necessarily in the same shop type</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>AVG Re-order Rate % [DMart] </run>
              <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>: Returning DMart customers within 30days / total DMart customers. Considers  as reorder an order in any Dmart, not necessarily in the same Dmart</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>Fail Rate</run>
              <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'> :  % of orders cancelled over the total orders. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>Contact Rate [LS] :</run>
              <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'> Total number of Contacts divided by successful Orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>Customers who also ordered Dmart % [LS]  : </run>
              <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>% of Local stores customers who also ordered in Dmart in the same time frame</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='14'>Speed</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>Avg. Delivery Minutes</run>
              <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'> : Avg. delivery time from order to delivery</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'>Order Share 10 Min Late</run>
              <run fontcolor='#ffffff' fontname='Tableau Regular' fontsize='10'> : % of orders with delay &gt; 10min </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
            <format attr='background-color' value='#535353' />
          </zone-style>
        </zone>
      </zones>
