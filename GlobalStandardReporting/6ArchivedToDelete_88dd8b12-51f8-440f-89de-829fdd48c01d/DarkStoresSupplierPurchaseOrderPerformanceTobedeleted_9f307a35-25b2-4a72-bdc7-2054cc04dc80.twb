            </column>
            <column caption='Avg. Delay Time' datatype='real' name='[Avg. Lead Time (copy)_5664895042568667142]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_delay_time])/(sum([orders_delayed]))' />
            </column>
            <column caption='Date' datatype='date' datatype-customized='true' default-format='*YYYY-MM-DD' name='[Calculation_3215218323347480576]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1], [create_date], &apos;monday&apos;))' />
            </column>
            <column caption='% Fulfilled' datatype='real' default-format='p0.00%' name='[Calculation_3215218323358560257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fulfilled_orders])/SUM([total_orders])' />
            </column>
            <column caption='Item % Fulfilled' datatype='real' default-format='p0.00%' name='[Calculation_3215218323359764482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_received_qty])/SUM([total_demanded_qty])' />
            </column>
            <column caption='% On Time' datatype='real' default-format='p0.00%' name='[Calculation_3215218323362832388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_received_on_time])/SUM([total_orders])' />
            </column>
            <column caption='Item Line % Fulfilled' datatype='real' default-format='p0.00%' name='[Calculation_3215218323382370309]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_linefill])/SUM([total_items])' />
            </column>
            <column caption='Avg. Lead Time' datatype='real' name='[Calculation_5664895042565210112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_lead_time])/sum([fulfilled_orders])' />
            </column>
            <column caption='Supplier Score' datatype='real' name='[Calculation_726909138314039303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((1-[% Returned (copy)_5664895042567737347])*0.1)+&#10;((1-[% Fulfilled (copy)_5664895042565451778])*0.1) +&#10;([Item Line % Fully Fulfilled (copy 2)_726909138303909894]*0.8)' />
            </column>
            <column caption='Item Line % Returned' datatype='real' default-format='p0.00%' name='[Item Line % Fulfilled (copy)_5664895042569416711]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_linereturn])/SUM([total_items])' />
            </column>
            <column caption='Item Line % On Time In Full' datatype='real' default-format='p0.00%' name='[Item Line % Fully Fulfilled (copy 2)_726909138303909894]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_line_received_on_time_infull])/SUM([total_items])' />
            </column>
            <column caption='Item Line % Delayed' datatype='real' default-format='p0.00%' name='[Item Line % Fully Fulfilled (copy)_726909138303897605]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_line_delays])/SUM([total_items])' />
            </column>
            <column caption='Item Line % Fully Fulfilled' datatype='real' default-format='p0.00%' name='[Item Line % Returned (copy)_726909138303082500]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_line_fullyfulfilled])/SUM([total_items])' />
            </column>
            <column caption='Percentile Lead Time' datatype='real' name='[Std. Lead Time (copy)_5664895042587897868]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_PERCENTILE([Calculation_5664895042565210112],&apos;desc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
