    <dashboard name='KPI Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/DarkStores-Supplier-PurchaseOrderPerformance_16474420423600/KPIDefinitions?rev=' id='KPIDefinitions' path='/t/GlobalStandardReporting/workbooks/DarkStores-Supplier-PurchaseOrderPerformance_16474420423600' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#535353' />
        </style-rule>
      </style>
      <size maxheight='868' maxwidth='1566' minheight='868' minwidth='1566' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98156' id='11' param='horz' type-v2='layout-flow' w='98978' x='511' y='922'>
            <zone fixed-size='235' h='98156' id='10' is-fixed='true' param='vert' type-v2='layout-flow' w='98978' x='511' y='922'>
              <zone forceUpdate='true' h='5185' id='95' type-v2='text' w='98978' x='511' y='922'>
                <formatted-text>
                  <run bold='true' fontcolor='#ffffff' fontsize='20'>KPI Definitions</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='66821' id='94' type-v2='text' w='98978' x='511' y='6107'>
                <formatted-text>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Supplier Score : ((1-% Cancelled)*0.1) + ((1-% Returned)*0.1) + (Item Line % On Time In Full*0.8)</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10' underline='true'>KPIs Based on Number of Purchase Orders (In Blue)</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Total Orders : Count of POs</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>% Fulfilled : Count of Fulfilled Orders / Count of Total Orders</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>% Returned : Count of Returned Orders / Count of Total Orders</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>% Cancelled : Count of Cancelled Orders / Count of Total Orders</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>% Cancelled Supplier Issue - Count of Cancelled Orders where cancel reason is Supplier non fulfillment, PO rejected on site (Quality issue) / Count of Total Orders</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>% Cancelled Operational Issue - Count of Cancelled Orders where cancel reason is Supplier payments issue, PO rejected on site (Capacity issue), Picker opened PO by mistake / Count of Total Orders</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>% Cancelled Data Issue - Count of Cancelled Orders where cancel reason is PO rejected on site (Barcodes issue), MOQ is not met, Incorrect link to supplier, Incorrect trade costs in PO / Count of Total Orders</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>% On Time : Count of Orders Received On Time / Count of Total Orders</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>% In Full : Count of Orders Received In Full / Count of Total Orders</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>% On Time In Full : Count of Orders Received On Time In Full / Count of Total Orders</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10' underline='true'>KPIs Based on Time in Days (in Green)</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg Lead Time : total_lead_time / count of fulfilled_orders</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Percentile Lead Time : Percentile of Avg Lead Time with respect to the other Avg Lead Times in the report</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg Delay Time : total_delay_time / Count of Orders Dayed  (Only Delayed Orders considered)</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10' underline='true'>KPIs Based of Number of Line Items (In Orange)</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Total Items : Count of products ordered for all POs</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Item Line % Fulfilled : Count of products where quantity delivered &gt; 0 / Count of products ordered</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Item Line % Returned : Count of products where quantity returned &gt; 0 / Count of products ordered </run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Item Line % Fully Fulfilled : Count of products where quantity delivered &gt;= quantity ordered / Count of products ordered</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Item Line % On Time In Full : Count of products where quantity delivered &gt;= quantity ordered and On Time/ Count of products ordered </run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Item Line % Delayed : Count of products where order is delayed/ Count of products ordered </run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10' underline='true'>KPIs Based of Sum of Quantities (In Teal-Blue)</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Total Demanded Qty : Sum of quantity ordered for all POs</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Total Received Qty : Sum of quantity delivered for all POs</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Total Returned Qty : Sum of quantity returned for all POs</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ffffff' fontsize='10'>Item % Fulfilled : Sum of Total Received Qty / Sum of Total Demanded Qty </run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='0' />
              </zone-style>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='127' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='126' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone forceUpdate='true' h='5185' id='95' type-v2='text' w='98978' x='511' y='922'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ffffff' fontsize='20'>KPI Definitions</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='66821' id='94' type-v2='text' w='98978' x='511' y='6107'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Supplier Score : ((1-% Cancelled)*0.1) + ((1-% Returned)*0.1) + (Item Line % On Time In Full*0.8)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10' underline='true'>KPIs Based on Number of Purchase Orders (In Blue)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Total Orders : Count of POs</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>% Fulfilled : Count of Fulfilled Orders / Count of Total Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>% Returned : Count of Returned Orders / Count of Total Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>% Cancelled : Count of Cancelled Orders / Count of Total Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>% Cancelled Supplier Issue - Count of Cancelled Orders where cancel reason is Supplier non fulfillment, PO rejected on site (Quality issue) / Count of Total Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>% Cancelled Operational Issue - Count of Cancelled Orders where cancel reason is Supplier payments issue, PO rejected on site (Capacity issue), Picker opened PO by mistake / Count of Total Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>% Cancelled Data Issue - Count of Cancelled Orders where cancel reason is PO rejected on site (Barcodes issue), MOQ is not met, Incorrect link to supplier, Incorrect trade costs in PO / Count of Total Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>% On Time : Count of Orders Received On Time / Count of Total Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>% In Full : Count of Orders Received In Full / Count of Total Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>% On Time In Full : Count of Orders Received On Time In Full / Count of Total Orders</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10' underline='true'>KPIs Based on Time in Days (in Green)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg Lead Time : total_lead_time / count of fulfilled_orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Percentile Lead Time : Percentile of Avg Lead Time with respect to the other Avg Lead Times in the report</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg Delay Time : total_delay_time / Count of Orders Dayed  (Only Delayed Orders considered)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10' underline='true'>KPIs Based of Number of Line Items (In Orange)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Total Items : Count of products ordered for all POs</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Item Line % Fulfilled : Count of products where quantity delivered &gt; 0 / Count of products ordered</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Item Line % Returned : Count of products where quantity returned &gt; 0 / Count of products ordered </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Item Line % Fully Fulfilled : Count of products where quantity delivered &gt;= quantity ordered / Count of products ordered</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Item Line % On Time In Full : Count of products where quantity delivered &gt;= quantity ordered and On Time/ Count of products ordered </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Item Line % Delayed : Count of products where order is delayed/ Count of products ordered </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10' underline='true'>KPIs Based of Sum of Quantities (In Teal-Blue)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Total Demanded Qty : Sum of quantity ordered for all POs</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Total Received Qty : Sum of quantity delivered for all POs</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Total Returned Qty : Sum of quantity returned for all POs</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Item % Fulfilled : Sum of Total Received Qty / Sum of Total Demanded Qty </run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
