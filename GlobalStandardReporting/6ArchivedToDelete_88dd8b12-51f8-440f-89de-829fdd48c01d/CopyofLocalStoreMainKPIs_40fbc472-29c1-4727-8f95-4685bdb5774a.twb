              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Global&apos; THEN [total cust count fixed (Region)  (copy)_3651856392427900963]&#10;WHEN &apos;Region&apos; THEN [total cust count fixed (country) (copy)_3651856392414851106]&#10;WHEN &apos;Country&apos; THEN [Calculation_3651856392141144076]&#10;WHEN &apos;Chain code&apos; THEN [total cust count fixed (country) (copy)_1238841746547638276]&#10;WHEN &apos;Chain name&apos; THEN [total cust count fixed (country) (copy)_1238841746547638276]&#10;WHEN &apos;Vendor code&apos; THEN [total_cust_count]&#10;WHEN &apos;Vendor name&apos; THEN [total_cust_count]&#10; ELSE NULL&#10;// ELSE [Total Cust Count (vendor level)]&#10;END' />
            </column>
