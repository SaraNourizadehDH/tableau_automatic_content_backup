      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_local_store_kpis_vendor_report (rl_dmart)' name='federated.0qfhylf042n3l8126oii01tzngug' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Geographic granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Global&quot;'>
              <calculation class='tableau' formula='&quot;Global&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qfhylf042n3l8126oii01tzngug'>
            <column caption='# PIM level 2 Category' datatype='real' name='[# PIM level 1 Category (copy)_1438970494602039296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Global&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id] : AVG([global_level_pim_2_category_name_count])}&#10;WHEN &apos;Region&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id] : AVG([region_level_pim_2_category_name_count])}&#10;WHEN &apos;Country&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id] : AVG([country_level_pim_2_category_name_count])}&#10;WHEN &apos;Chain code&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id],[chain_id] : AVG([chain_level_pim_2_category_name_count])}&#10;WHEN &apos;Chain name&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id], [chain_name] : AVG([chain_level_pim_2_category_name_count])}&#10;WHEN &apos;Vendor code&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id],[vendor_id] : AVG([vendor_level_pim_2_category_id_count])}&#10;WHEN &apos;Vendor name&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id], [vendor_name] : AVG([vendor_level_pim_2_category_id_count])}&#10;WHEN &apos;Shop Type&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id], [shop_type] : AVG([shop_type_level_pim_2_category_name_count])}&#10; ELSE NULL&#10;// ELSE [Total Cust Count (vendor level)]&#10;END' />
            </column>
            <column caption='# Catalog Category' datatype='real' name='[# SKU (copy)_3651856392469647401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Global&apos; THEN {FIXED [time_level],[order_time_period],[global] : AVG([global_level_catalog_category_name_count])}&#10;WHEN &apos;Region&apos; THEN {FIXED [time_level],[order_time_period],[global],[region] : AVG([region_level_catalog_category_name_count])}&#10;WHEN &apos;Country&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id] : AVG([country_level_catalog_category_name_count])}&#10;WHEN &apos;Chain code&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id],[chain_id] : AVG([chain_level_catalog_category_name_count])}&#10;WHEN &apos;Chain name&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id],[chain_name] : AVG([chain_level_catalog_category_name_count])}&#10;WHEN &apos;Vendor code&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id],[vendor_id] : AVG([vendor_level_catalog_category_id_count])}&#10;WHEN &apos;Vendor name&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id], [vendor_name] : AVG([vendor_level_catalog_category_id_count])}&#10;WHEN &apos;Shop Type&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id],[shop_type] : AVG([shop_type_level_catalog_category_name_count])}&#10; ELSE NULL&#10;// ELSE [Total Cust Count (vendor level)]&#10;END' />
            </column>
            <column caption='# PIM level 1 Category' datatype='real' name='[# SKU (copy)_3651856392745218090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Global&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id] : AVG([global_level_pim_1_category_name_count])}&#10;WHEN &apos;Region&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id] : AVG([region_level_pim_1_category_name_count])}&#10;WHEN &apos;Country&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id] : AVG([country_level_pim_1_category_name_count])}&#10;WHEN &apos;Chain code&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id],[chain_id] : AVG([chain_level_pim_1_category_name_count])}&#10;WHEN &apos;Chain name&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id], [chain_name] : AVG([chain_level_pim_1_category_name_count])}&#10;WHEN &apos;Vendor code&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id],[vendor_id] : AVG([chain_level_pim_1_category_name_count])}&#10;WHEN &apos;Vendor name&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id], [vendor_name] : AVG([vendor_level_pim_1_category_id_count])}&#10;WHEN &apos;Vendor name&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id], [vendor_name] : AVG([vendor_level_pim_1_category_id_count])}&#10;WHEN &apos;Shop Type&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id], [shop_type] : AVG([shop_type_level_pim_1_category_name_count])}&#10; ELSE NULL&#10;// ELSE [Total Cust Count (vendor level)]&#10;END' />
            </column>
            <column caption='Avg. Units Ordered ' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# Units Ordered (copy)_3651856392172060702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_qty_ordered]) / SUM([valid_order_count])' />
            </column>
            <column caption='Avg. Units Sold ' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# Units Sold (copy)_3651856392172240927]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_qty_sold]) / SUM([valid_order_count])' />
            </column>
            <column caption='% Commission rate' datatype='real' default-format='p0.0%' name='[% Commission rate old (copy)_1970747109937909760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_amt_commission_eur]) / SUM([sum_amt_commission_base_eur])' />
            </column>
            <column caption='% GMV Share (Platform)' datatype='real' default-format='p0.0%' name='[% Order share (copy)_1439814914576183298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_sum_wo_df])/SUM([Calculation_3651856388187156480])' />
            </column>
            <column caption='--------Marketing' datatype='integer' name='[--------Commercial (copy 2)_3651856388239130626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='--------' datatype='integer' name='[--------Commercial (copy)_1439814914582253572]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='--------Operations' datatype='integer' name='[--------Marketing (copy 2)_3651856388239212548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='----------' datatype='integer' name='[--------Marketing (copy)_3651856388239196163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='-------' datatype='integer' name='[--------Operations (copy)_3651856388239269893]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='AOV (€)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AFV (€) (copy)_1439814914582364166]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_sum])/SUM([valid_order_count])' />
            </column>
            <column caption='AFV (€)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1439814914574807040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_amt_gbv_eur])/SUM([valid_order_count])' />
            </column>
            <column caption='% Order share (Platform)' datatype='real' default-format='p0.0%' name='[Calculation_1439814914575785985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([valid_order_count])/SUM([Platform GMV fixed (copy)_3651856388233900033])' />
            </column>
            <column caption='--------Commercial' datatype='integer' name='[Calculation_1439814914577289219]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='DF / Order (€)' datatype='real' default-format='n&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_1439814914583683079]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_delivery_fee_eur])/SUM([valid_order_count])' />
            </column>
            <column caption='Granularity level' datatype='string' name='[Calculation_1439814914594480136]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Region&apos; THEN [region] &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Country&apos; THEN [country_name] &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Global&apos; THEN [global] &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Vendor code&apos; THEN [vendor_id] &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Vendor name&apos; THEN [vendor_name]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Chain code&apos; THEN [chain_id] &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Chain name&apos; THEN [chain_name] &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Shop Type&apos; THEN [shop_type] &#10;END' />
            </column>
            <column caption='Avg Delivery Time (mins)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1439814915320684565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_delivery_time_minutes])/SUM([valid_order_count])' />
            </column>
            <column caption='Month/Week number' datatype='string' name='[Calculation_1439814915325804566]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [time_level] WHEN &apos;weekly&apos; THEN &apos;WEEK : &apos; + STR(YEAR([order_time_period]))+ &apos;-&apos; + STR([time_period_number]) &#10;ELSE &apos;Month : &apos; + STR(YEAR([order_time_period])) + &apos;-&apos; +STR([time_period_number]) END' />
            </column>
            <column caption='Platform GMV fixed (€)' datatype='real' default-format='n&quot;€&quot;#,##0,,.00M;-&quot;€&quot;#,##0,,.00M' name='[Calculation_3651856388187156480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [time_level],[order_time_period],[global_entity_id] : AVG([platform_gmv])}' />
            </column>
            <column caption='% Voucher orders' datatype='real' default-format='p0.0%' name='[Calculation_3651856388239597574]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([voucher_order_count])/SUM([valid_order_count])' />
            </column>
            <column caption='% Fail rate' datatype='real' default-format='p0.0%' name='[Calculation_3651856388544626696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_order_count])/ (SUM([valid_order_count])+SUM([failed_order_count]))' />
            </column>
            <column caption='Total Take-in Value (€)' datatype='real' default-format='c&quot;€&quot;#,##0,.00K;-&quot;€&quot;#,##0,.00K' name='[Calculation_3651856392137494537]' role='measure' type='quantitative'>
