            </column>
            <column caption='Avg. Units Ordered ' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# Units Ordered (copy)_3651856392172060702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_qty_ordered]) / SUM([valid_order_count])' />
