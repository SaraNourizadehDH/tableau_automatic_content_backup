              <calculation class='tableau' formula='SUM([gmv_sum])/SUM([valid_order_count])' />
            </column>
            <column caption='AFV (€)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1439814914574807040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_amt_gbv_eur])/SUM([valid_order_count])' />
            </column>
            <column caption='% Order share (Platform)' datatype='real' default-format='p0.0%' name='[Calculation_1439814914575785985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([valid_order_count])/SUM([Platform GMV fixed (copy)_3651856388233900033])' />
            </column>
            <column caption='--------Commercial' datatype='integer' name='[Calculation_1439814914577289219]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='DF / Order (€)' datatype='real' default-format='n&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_1439814914583683079]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_delivery_fee_eur])/SUM([valid_order_count])' />
            </column>
            <column caption='Granularity level' datatype='string' name='[Calculation_1439814914594480136]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Region&apos; THEN [region] &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Country&apos; THEN [country_name] &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Global&apos; THEN [global] &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Vendor code&apos; THEN [vendor_id] &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Vendor name&apos; THEN [vendor_name]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Chain code&apos; THEN [chain_id] &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Chain name&apos; THEN [chain_name] &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Shop Type&apos; THEN [shop_type] &#10;END' />
            </column>
            <column caption='Avg Delivery Time (mins)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1439814915320684565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_delivery_time_minutes])/SUM([valid_order_count])' />
            </column>
            <column caption='Month/Week number' datatype='string' name='[Calculation_1439814915325804566]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [time_level] WHEN &apos;weekly&apos; THEN &apos;WEEK : &apos; + STR(YEAR([order_time_period]))+ &apos;-&apos; + STR([time_period_number]) &#10;ELSE &apos;Month : &apos; + STR(YEAR([order_time_period])) + &apos;-&apos; +STR([time_period_number]) END' />
            </column>
            <column caption='Platform GMV fixed (€)' datatype='real' default-format='n&quot;€&quot;#,##0,,.00M;-&quot;€&quot;#,##0,,.00M' name='[Calculation_3651856388187156480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [time_level],[order_time_period],[global_entity_id] : AVG([platform_gmv])}' />
