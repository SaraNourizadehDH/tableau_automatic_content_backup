      <column caption='Granularity level' datatype='string' name='[Calculation_1439814914594480136]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Region&apos; THEN [region] &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Country&apos; THEN [country_name] &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Global&apos; THEN [global] &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Vendor code&apos; THEN [vendor_id] &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Vendor name&apos; THEN [vendor_name]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Chain code&apos; THEN [chain_id] &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Chain name&apos; THEN [chain_name] &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Shop Type&apos; THEN [shop_type] &#10;END' />
      </column>
      <column caption='Avg Delivery Time (mins)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1439814915320684565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_delivery_time_minutes])/SUM([valid_order_count])' />
      </column>
      <column caption='Month/Week number' datatype='string' name='[Calculation_1439814915325804566]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [time_level] WHEN &apos;weekly&apos; THEN &apos;WEEK : &apos; + STR(YEAR([order_time_period]))+ &apos;-&apos; + STR([time_period_number]) &#10;ELSE &apos;Month : &apos; + STR(YEAR([order_time_period])) + &apos;-&apos; +STR([time_period_number]) END' />
      </column>
      <column caption='Exclude current month' datatype='boolean' name='[Calculation_1754433530500161539]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_time_period] ==  {FIXED [time_level] : MAX([order_time_period])} THEN FALSE&#10;ELSE TRUE &#10;END' />
      </column>
      <column caption='Platform GMV fixed (€)' datatype='real' default-format='n&quot;€&quot;#,##0,,.00M;-&quot;€&quot;#,##0,,.00M' name='[Calculation_3651856388187156480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [time_level],[order_time_period],[global_entity_id] : AVG([platform_gmv])}' />
      </column>
      <column caption='% Voucher orders' datatype='real' default-format='p0.0%' name='[Calculation_3651856388239597574]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([voucher_order_count])/SUM([valid_order_count])' />
      </column>
      <column caption='% Fail rate' datatype='real' default-format='p0.0%' name='[Calculation_3651856388544626696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_order_count])/ (SUM([valid_order_count])+SUM([failed_order_count]))' />
      </column>
      <column caption='Total Take-in Value (€)' datatype='real' default-format='c&quot;€&quot;#,##0,.00K;-&quot;€&quot;#,##0,.00K' name='[Calculation_3651856392137494537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_amt_commission_eur]) + SUM([sum_delivery_fee_eur])' />
      </column>
      <column caption='Commission / Order (€)' datatype='real' default-format='n&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_3651856392138514443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_amt_commission_eur]) / SUM([valid_order_count])' />
      </column>
      <column caption='total cust count fixed (country)' datatype='real' name='[Calculation_3651856392141144076]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [time_level],[order_time_period],[global],[region],[global_entity_id] : AVG([country_level_customer_count_ls])}' />
      </column>
      <column caption='Cohort Reorder fixed (Country)' datatype='real' name='[Calculation_3651856392165597204 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [time_level],[order_time_period],[global],[region],[global_entity_id] : AVG([country_level_num_reorder_ls])}' />
      </column>
      <column caption='Cohort Reorder fixed' datatype='real' name='[Calculation_3651856392165597204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [time_level],[order_time_period],[global_entity_id] : AVG([country_level_num_reorder_ls])}' />
      </column>
      <column caption='Cohort Reorder count *' datatype='real' name='[Calculation_3651856392165892117 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Global&apos; THEN [Cohort Reorder fixed (Country) (copy)_1238841746869575687]&#10;WHEN &apos;Region&apos; THEN [Cohort Reorder fixed (chain) (copy)_1238841746867625990]&#10;WHEN &apos;Country&apos; THEN [Calculation_3651856392165597204 1]&#10;WHEN &apos;Chain code&apos; THEN [Cohort Reorder fixed (copy)_1238841746814197765]&#10;WHEN &apos;Chain name&apos; THEN [Cohort Reorder fixed (copy)_1238841746814197765]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Cohort Reorder count' datatype='real' name='[Calculation_3651856392165892117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Global&apos; THEN [Calculation_3651856392165597204]&#10;WHEN &apos;Region&apos; THEN [Calculation_3651856392165597204]&#10;WHEN &apos;Country&apos; THEN [Calculation_3651856392165597204]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='% Free Delivery orders' datatype='real' default-format='p0.0%' name='[Calculation_3651856392167202838]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([free_delivery_order_count]) / SUM([valid_order_count])' />
      </column>
      <column caption='% Cohort Reorder *' datatype='real' default-format='p0.0%' name='[Calculation_3651856392167444503 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_3651856392165892117 1])/AVG([Total Customer count (copy)_3651856392463249446 1])' />
      </column>
      <column caption='% Cohort Reorder' datatype='real' default-format='p0.0%' name='[Calculation_3651856392167444503]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3651856392165892117])/AVG([Total Customer count (copy)_3651856392463249446 1])' />
      </column>
      <column caption='Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3651856392168017944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([valid_order_count]) / AVG([Total Customer count (copy)_3651856392463249446 1])' />
      </column>
      <column caption='# Online Vendor' datatype='integer' name='[Calculation_3651856392169435162]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//CASE [Geographic granularity]&#10;//WHEN &apos;Global&apos; THEN [online vendor fixed]&#10;//WHEN &apos;Region&apos; THEN [online vendor fixed]&#10;//WHEN &apos;Country&apos; THEN [online vendor fixed]&#10;//WHEN &apos;Chain name&apos; THEN [online vendor fixed]&#10;//ELSE NULL&#10;//END&#10;&#10;[online_vendor_count]' />
      </column>
      <column caption='# SKU' datatype='real' name='[Calculation_3651856392465788967]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Global&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id] : AVG([global_level_sku_count])}&#10;WHEN &apos;Region&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id] : AVG([region_level_sku_count])}&#10;WHEN &apos;Country&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id] : AVG([country_level_sku_count])}&#10;WHEN &apos;Chain code&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id],[chain_id] : AVG([chain_level_sku_count])}&#10;WHEN &apos;Chain name&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id],[chain_name] : AVG([chain_level_sku_count])}&#10;WHEN &apos;Vendor code&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id],[vendor_id] : AVG([vendor_level_sku_count])}&#10;WHEN &apos;Vendor name&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id], [vendor_name] : AVG([vendor_level_sku_count])}&#10;WHEN &apos;Shop Type&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id], [shop_type] : AVG([shop_type_level_sku_count])}&#10; ELSE NULL&#10;// ELSE [Total Cust Count (vendor level)]&#10;END' />
      </column>
      <column caption='Total Discount Amount (€) (incl Vouchers)' datatype='real' name='[Calculation_4497336870776745984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_amt_discount_eur]) + SUM([sum_amt_voucher_eur])' />
