      <column caption='# PIM level 2 Category' datatype='real' name='[# PIM level 1 Category (copy)_1438970494602039296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Global&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id] : AVG([global_level_pim_2_category_name_count])}&#10;WHEN &apos;Region&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id] : AVG([region_level_pim_2_category_name_count])}&#10;WHEN &apos;Country&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id] : AVG([country_level_pim_2_category_name_count])}&#10;WHEN &apos;Chain code&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id],[chain_id] : AVG([chain_level_pim_2_category_name_count])}&#10;WHEN &apos;Chain name&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id], [chain_name] : AVG([chain_level_pim_2_category_name_count])}&#10;WHEN &apos;Vendor code&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id],[vendor_id] : AVG([vendor_level_pim_2_category_id_count])}&#10;WHEN &apos;Vendor name&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id], [vendor_name] : AVG([vendor_level_pim_2_category_id_count])}&#10;WHEN &apos;Shop Type&apos; THEN {FIXED [time_level],[order_time_period],[global],[region],[global_entity_id], [shop_type] : AVG([shop_type_level_pim_2_category_name_count])}&#10; ELSE NULL&#10;// ELSE [Total Cust Count (vendor level)]&#10;END' />
      </column>
