      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Tableau Bold' fontsize='20'>Shop Type View - Main KPIs</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_local_store_kpis_vendor_report (rl_dmart)' name='federated.0qfhylf042n3l8126oii01tzngug' />
          </datasources>
          <datasource-dependencies datasource='federated.0qfhylf042n3l8126oii01tzngug'>
            <column caption='Avg. Units Ordered ' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# Units Ordered (copy)_3651856392172060702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_qty_ordered]) / SUM([valid_order_count])' />
            </column>
            <column caption='Avg. Units Sold ' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# Units Sold (copy)_3651856392172240927]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_qty_sold]) / SUM([valid_order_count])' />
            </column>
            <column caption='% Cohort Reorder (Shop Type)' datatype='real' default-format='p0.0%' name='[% Cohort Reorder (Chain) (copy)_1690538723848192001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Cohort Reorder fixed (Chain) (copy)_1690538723830763520]) / SUM ([total cust count fixed (chain) (copy)_4074350301250375692])' />
            </column>
            <column caption='% Commission rate' datatype='real' default-format='p0.0%' name='[% Commission rate old (copy)_1970747109937909760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_amt_commission_eur]) / SUM([sum_amt_commission_base_eur])' />
            </column>
            <column caption='% GMV Share (Platform)' datatype='real' default-format='p0.0%' name='[% Order share (copy)_1439814914576183298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_sum_wo_df])/SUM([Calculation_3651856388187156480])' />
            </column>
            <column caption='AOV (€)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[AFV (€) (copy)_1439814914582364166]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_sum])/SUM([valid_order_count])' />
            </column>
            <column caption='AFV (€)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1439814914574807040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_amt_gbv_eur])/SUM([valid_order_count])' />
            </column>
            <column caption='% Order share (Platform)' datatype='real' default-format='p0.0%' name='[Calculation_1439814914575785985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([valid_order_count])/SUM([Platform GMV fixed (copy)_3651856388233900033])' />
            </column>
            <column caption='DF / Order (€)' datatype='real' default-format='n&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_1439814914583683079]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_delivery_fee_eur])/SUM([valid_order_count])' />
            </column>
            <column caption='Avg Delivery Time (mins)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1439814915320684565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_delivery_time_minutes])/SUM([valid_order_count])' />
            </column>
            <column caption='Month/Week number' datatype='string' name='[Calculation_1439814915325804566]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [time_level] WHEN &apos;weekly&apos; THEN &apos;WEEK : &apos; + STR(YEAR([order_time_period]))+ &apos;-&apos; + STR([time_period_number]) &#10;ELSE &apos;Month : &apos; + STR(YEAR([order_time_period])) + &apos;-&apos; +STR([time_period_number]) END' />
            </column>
            <column caption='Platform GMV fixed (€)' datatype='real' default-format='n&quot;€&quot;#,##0,,.00M;-&quot;€&quot;#,##0,,.00M' name='[Calculation_3651856388187156480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [time_level],[order_time_period],[global_entity_id] : AVG([platform_gmv])}' />
            </column>
            <column caption='% Voucher orders' datatype='real' default-format='p0.0%' name='[Calculation_3651856388239597574]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([voucher_order_count])/SUM([valid_order_count])' />
            </column>
            <column caption='% Fail rate' datatype='real' default-format='p0.0%' name='[Calculation_3651856388544626696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_order_count])/ (SUM([valid_order_count])+SUM([failed_order_count]))' />
            </column>
            <column caption='Total Take-in Value (€)' datatype='real' default-format='c&quot;€&quot;#,##0,.00K;-&quot;€&quot;#,##0,.00K' name='[Calculation_3651856392137494537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_amt_commission_eur]) + SUM([sum_delivery_fee_eur])' />
            </column>
            <column caption='Commission / Order (€)' datatype='real' default-format='n&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_3651856392138514443]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_amt_commission_eur]) / SUM([valid_order_count])' />
            </column>
            <column caption='% Free Delivery orders' datatype='real' default-format='p0.0%' name='[Calculation_3651856392167202838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([free_delivery_order_count]) / SUM([valid_order_count])' />
            </column>
            <column caption='# Online Vendor' datatype='integer' name='[Calculation_3651856392169435162]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//CASE [Geographic granularity]&#10;//WHEN &apos;Global&apos; THEN [online vendor fixed]&#10;//WHEN &apos;Region&apos; THEN [online vendor fixed]&#10;//WHEN &apos;Country&apos; THEN [online vendor fixed]&#10;//WHEN &apos;Chain name&apos; THEN [online vendor fixed]&#10;//ELSE NULL&#10;//END&#10;&#10;[online_vendor_count]' />
            </column>
            <column caption='Total Discount Amount (€) (incl Vouchers)' datatype='real' name='[Calculation_4497336870776745984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_amt_discount_eur]) + SUM([sum_amt_voucher_eur])' />
            </column>
            <column caption='Cohort Reorder fixed (Shop type)' datatype='real' name='[Cohort Reorder fixed (Chain) (copy)_1690538723830763520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [time_level],[order_time_period],[global_entity_id],[global],[region], [shop_type] : AVG([shop_type_level_num_reorder_ls])}' />
            </column>
            <column caption='Frequency (Shop type)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Frequency (Chain) (copy)_1690538723853283330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([valid_order_count]) / SUM([total cust count fixed (chain) (copy)_4074350301250375692])' />
            </column>
            <column caption='Platform Orders fixed' datatype='real' default-format='n#,##0,,.00M;-#,##0,,.00M' name='[Platform GMV fixed (copy)_3651856388233900033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [time_level],[order_time_period],[global_entity_id] : AVG([platform_orders])}' />
