      <size maxheight='1200' maxwidth='1566' minheight='1200' minwidth='1566' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='_tableau_local_store_kpis_vendor_report (rl_dmart)' name='federated.0qfhylf042n3l8126oii01tzngug' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Geographic granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Global&quot;'>
          <calculation class='tableau' formula='&quot;Global&quot;' />
          <members>
            <member value='&quot;Global&quot;' />
            <member value='&quot;Region&quot;' />
            <member value='&quot;Country&quot;' />
            <member value='&quot;Vendor code&quot;' />
            <member value='&quot;Vendor name&quot;' />
            <member value='&quot;Chain code&quot;' />
            <member value='&quot;Chain name&quot;' />
            <member value='&quot;Shop Type&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0qfhylf042n3l8126oii01tzngug'>
        <column caption='Month/Week number' datatype='string' name='[Calculation_1439814915325804566]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [time_level] WHEN &apos;weekly&apos; THEN &apos;WEEK : &apos; + STR(YEAR([order_time_period]))+ &apos;-&apos; + STR([time_period_number]) &#10;ELSE &apos;Month : &apos; + STR(YEAR([order_time_period])) + &apos;-&apos; +STR([time_period_number]) END' />
        </column>
        <column caption='Chain Id' datatype='string' name='[chain_id]' role='dimension' type='nominal' />
        <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
        <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
