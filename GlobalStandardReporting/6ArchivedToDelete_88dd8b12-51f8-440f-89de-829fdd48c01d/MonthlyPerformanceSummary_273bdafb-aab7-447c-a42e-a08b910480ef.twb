      </column>
      <column caption='AOV (Dmart)' datatype='real' default-format='n#,##0.0&quot; €&quot;;-#,##0.0&quot; €&quot;' name='[AOV Vendor (copy)_428193809393668108]' role='measure' type='quantitative'>
