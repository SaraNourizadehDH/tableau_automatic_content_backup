      </column>
      <column caption='Basket Penetration' datatype='real' name='[Calculation_3105091272086335496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Vendor Orders (copy)_428193809391169540])/ SUM([penetration_denominator])' />
      </column>
      <column caption='Orders (Vendor)' datatype='integer' name='[Calculation_428193809390440450]' role='measure' type='quantitative'>
