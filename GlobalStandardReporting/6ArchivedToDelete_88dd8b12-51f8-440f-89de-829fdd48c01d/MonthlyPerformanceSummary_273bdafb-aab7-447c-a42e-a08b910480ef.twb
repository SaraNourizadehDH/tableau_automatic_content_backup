      </column>
      <column caption='Dmart %' datatype='real' default-format='p0%' name='[Calculation_428193809391255557]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Vendor Orders (copy)_428193809391169540]/SUM([successful_orders])' />
