      <aliases enabled='yes' />
      <column caption='Definition' datatype='string' name='[Calculation_3365174142167146496]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;M(0) is the month with first Everyday order&#10;M(1), M(2) … are respectively next months after the month with first Everyday order&#10;M(-1), M(-2) … are respectively previous months before the month with first Everyday order&#10;Average number of monthly dmart orders / From M(-6) to M(12)&#10;Average number of monthly Everyday orders / From M(0) to M(12)&#10;&apos;' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_833728929017933825]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Definition (copy)' datatype='string' name='[Definition (copy)_1599903771787210753]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;&#13;&#10;* Active EDR User: Users with atleast one successful EDR order in last 30 days&#13;&#10;* EDR FTO: Users who ordered EDR category for the first time&#13;&#10;* Monthly Repeat Users: Users who ordered from EDR category again&#13;&#10;* Frequency Returnees: Edr frequency of Dmart customers who started ordering from Edr category again &#13;&#10;                     : Example-(# Edr users Current Month - Edr new acquisitions Current Month) - (Edr users Previous Month - Edr new acquisitions Previous Month) &#13;&#10;* Average number of monthly Everyday orders&#13;&#10;* Average number of monthly dmart orders (Everyday Users)&#13;&#10;* Average number of monthly dmart orders (non Everyday Users)&#13;&#10;&apos;' />
      </column>
