        <aliases>
          <alias key='&quot;[federated.0422w5b0zj9nyb18f6kdq1flt4ng].[pcto:sum:amt_gbv_eur_order:qk:7]&quot;' value='Market Share' />
          <alias key='&quot;[federated.0422w5b0zj9nyb18f6kdq1flt4ng].[pcto:sum:amt_gbv_eur_order:qk]&quot;' value='Market Share%' />
          <alias key='&quot;[federated.0422w5b0zj9nyb18f6kdq1flt4ng].[pcto:sum:Calculation_1130684988036046848:qk]&quot;' value='Market Share% (Orders)' />
