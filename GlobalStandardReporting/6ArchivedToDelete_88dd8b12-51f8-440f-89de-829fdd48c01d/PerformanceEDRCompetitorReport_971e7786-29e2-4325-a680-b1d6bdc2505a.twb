          <alias key='&quot;[federated.0422w5b0zj9nyb18f6kdq1flt4ng].[sum:successful_order_count:qk]&quot;' value='Successful Orders' />
          <alias key='&quot;[federated.0422w5b0zj9nyb18f6kdq1flt4ng].[sum:user_count_fto:qk]&quot;' value='No. of Trials(FTO)' />
          <alias key='&quot;[federated.0422w5b0zj9nyb18f6kdq1flt4ng].[sum:user_count:qk]&quot;' value='No. of Users' />
          <alias key='&quot;[federated.0422w5b0zj9nyb18f6kdq1flt4ng].[usr:Calculation_1128714661093568524:qk:1]&quot;' value='Market Share%(GBV)' />
        </aliases>
      </column>
      <column caption='Order per Store' datatype='real' name='[Calculation_1128714660363595776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [vendor_name] WHEN &apos;Everyday Vendor&apos; THEN [order_count]/[stores_count]&#13;&#10;ELSE [successful_order_count]/[stores_count] END' />
      </column>
      <column caption='Market_Share' datatype='real' name='[Calculation_1128714661093568524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([amt_gbv_eur_order]) / TOTAL(SUM([amt_gbv_eur_order]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Successful Order Count' datatype='integer' name='[Calculation_1130684988036046848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [vendor_name] WHEN &apos;Everyday Vendor&apos; THEN [order_count] ELSE [successful_order_count] END' />
      </column>
      <column caption='ABV' datatype='real' name='[Calculation_1130684988036632577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [vendor_name] WHEN &apos;Everyday Vendor&apos; THEN [amt_gbv_eur_order]/[order_count] &#13;&#10;ELSE [abv] END' />
      </column>
      <column caption='Month_Days' datatype='integer' name='[Calculation_1360650045730045952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;day&apos;, DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [report_month]))))' />
      </column>
      <column caption='Order/Store/Day' datatype='real' name='[Calculation_1360650045730803714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1128714660363595776]/[Calculation_1360650045730045952]' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1459729235410993152]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
