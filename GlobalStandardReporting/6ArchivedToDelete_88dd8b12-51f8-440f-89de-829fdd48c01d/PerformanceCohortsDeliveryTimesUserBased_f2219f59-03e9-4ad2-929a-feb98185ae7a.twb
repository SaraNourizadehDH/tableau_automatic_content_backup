    <worksheet name='KPIs together - Restaurants'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff'><![CDATA[<[Parameters].[Parameter 3]> - Restaurants]]></run>
            <run fontalignment='2'>Æ&#10;</run>
            <run fontalignment='2' fontcolor='#ffffff' fontsize='11'>*users from cohort, who are reordering from Restaurants</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_product_darkstore_cohorts (bi_global_dev.tableau_product_darkstore_cohorts) (dwh_bl)' name='federated.0hdzlsw0bt016s15bfllr16s470j' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='No' caption='Color Period 0?' datatype='integer' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='No' />
                <alias key='1' value='Yes' />
              </aliases>
            </column>
            <column caption='KPI' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Retention Rate&quot;'>
              <calculation class='tableau' formula='&quot;Retention Rate&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hdzlsw0bt016s15bfllr16s470j'>
            <column caption='AOV RS' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AOV DS (copy)_1519120490586787870]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_gmv_eur_rs])/SUM([orders_rs])' />
            </column>
            <column caption='Frequency RS' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Acitivity NV (copy)_1519120482424762383]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_rs]) / [Calculation_1519120490500636697]' />
            </column>
            <column caption='current_period' datatype='boolean' name='[Calculation_1387249477445312515]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [cohort_type]&#10;when &apos;7d&apos;  then dateadd(&apos;week&apos;, [return_period], [cohort_date])  = DATETRUNC(&apos;week&apos;, TODAY())&#10;when &apos;weekly&apos;  then dateadd(&apos;week&apos;, [return_period], [cohort_date])  = DATETRUNC(&apos;week&apos;, TODAY())&#10;when &apos;30d&apos; then dateadd(&apos;month&apos;, [return_period], [cohort_date]) = DATETRUNC(&apos;month&apos;, TODAY())&#10;when &apos;monthly&apos; then dateadd(&apos;month&apos;, [return_period], [cohort_date]) = DATETRUNC(&apos;month&apos;, TODAY())&#10;end' />
            </column>
            <column caption='Cohort Size New' datatype='integer' name='[Calculation_1519120490500636697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cohort_size])' />
            </column>
            <column caption='Activity RS' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Frequency DS (copy)_1519120482423803915]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_rs]) / SUM([returning_users_rs])' />
            </column>
            <column caption='KPI selector RS (string) ' datatype='string' datatype-customized='true' name='[KPI selector ALL (string) (copy) (copy) (copy)_356276973825691655]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(IF [Parameters].[Parameter 3] = &apos;Retention Rate&apos; THEN STR(ROUND([Retention Rate - NV (copy)_1519120482417102852] * 100))  + &apos; %&apos; &#10;ELSEIF [Parameters].[Parameter 3] = &apos;Returning User&apos; THEN STR(SUM([returning_users_rs]))&#10;ELSEIF [Parameters].[Parameter 3] = &apos;User Activity&apos; THEN STR(ROUND([Frequency DS (copy)_1519120482423803915],2))&#10;ELSEIF [Parameters].[Parameter 3] = &apos;User Frequency&apos; THEN STR(ROUND([Acitivity NV (copy)_1519120482424762383],2))&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Orders&apos; THEN STR(SUM([orders_rs]))&#10;ELSEIF [Parameters].[Parameter 3] = &apos;AOV&apos; THEN STR(ROUND([AOV DS (copy)_1519120490586787870],2))&#10;ELSE NULL END)' />
            </column>
            <column caption='Retention Rate RS' datatype='real' default-format='p0%' name='[Retention Rate - NV (copy)_1519120482417102852]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([returning_users_rs]) / [Calculation_1519120490500636697]' />
            </column>
            <column caption='Retention Rate RS (Color)' datatype='real' default-format='p0%' name='[Retention Rate - NV Color (copy)_1519120482417102853]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = 0 AND MAX([return_period]) = 0 THEN 0 ELSE [Retention Rate - NV (copy)_1519120482417102852] END' />
            </column>
            <column caption='Store (wildcard)' datatype='string' name='[Store (copy)_6799802134001123328]' role='dimension' type='nominal'>
