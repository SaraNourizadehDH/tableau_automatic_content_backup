      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1228919807028809728]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Retention Rate ALL' datatype='real' default-format='p0%' name='[Calculation_1387249477440393217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([returning_users]) / [Calculation_1519120490500636697]' />
      </column>
      <column caption='current_period' datatype='boolean' name='[Calculation_1387249477445312515]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [cohort_type]&#10;when &apos;7d&apos;  then dateadd(&apos;week&apos;, [return_period], [cohort_date])  = DATETRUNC(&apos;week&apos;, TODAY())&#10;when &apos;weekly&apos;  then dateadd(&apos;week&apos;, [return_period], [cohort_date])  = DATETRUNC(&apos;week&apos;, TODAY())&#10;when &apos;30d&apos; then dateadd(&apos;month&apos;, [return_period], [cohort_date]) = DATETRUNC(&apos;month&apos;, TODAY())&#10;when &apos;monthly&apos; then dateadd(&apos;month&apos;, [return_period], [cohort_date]) = DATETRUNC(&apos;month&apos;, TODAY())&#10;end' />
      </column>
      <column caption='Calculation1' datatype='string' name='[Calculation_1519120484110606357]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Info:&#10;&#10;This Cohort is User based, while a cohort is defined as following:&#10;&#10;The first time a User places an order on a Dark Store.&#10;This User might have been active before and placed e.g. food orders at an earlier stage.&apos;' />
      </column>
      <column caption='Cohort Size New' datatype='integer' name='[Calculation_1519120490500636697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cohort_size])' />
      </column>
      <column caption='Return Date' datatype='datetime' default-format='*YYYY-MM-DD' name='[Calculation_1519120490500931610]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [cohort_type]&#10;WHEN &apos;7d&apos; THEN DATEADD(&apos;week&apos;, [return_period], [cohort_date])&#10;WHEN &apos;30d&apos; THEN  DATEADD(&apos;month&apos;, [return_period], [cohort_date])&#10;END' />
      </column>
      <column caption='past period' datatype='integer' name='[Calculation_1519120490505461788]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [cohort_type]&#10;WHEN &apos;7d&apos; THEN   DATEDIFF(&apos;week&apos;, [Calculation_1519120490500931610], TODAY())&#10;WHEN &apos;30d&apos; THEN  DATEDIFF(&apos;month&apos;, [Calculation_1519120490500931610], TODAY())&#10;END' />
      </column>
      <column caption='COUNTD(us' datatype='integer' name='[Calculation_1519120490807750688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([returning_users])' />
      </column>
      <column caption='LOD Fixed Return Cohort' datatype='integer' name='[Calculation_1519120490819911715]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [return_period] = 0 : ([Calculation_1519120490500636697])}' />
      </column>
