      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_product_darkstore_cohorts (bi_global_dev.tableau_product_darkstore_cohorts) (dwh_bl)' name='federated.0hdzlsw0bt016s15bfllr16s470j' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Retention Rate&quot;'>
              <calculation class='tableau' formula='&quot;Retention Rate&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hdzlsw0bt016s15bfllr16s470j'>
            <column caption='AOV DS' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AOV (copy)_1519120490586726429]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_gmv_eur_ds])/SUM([orders_ds])' />
            </column>
            <column caption='Frequency DS' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Acitivity (copy)_1519120482424643597]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_ds]) / [Calculation_1519120490500636697]' />
            </column>
            <column caption='current_period' datatype='boolean' name='[Calculation_1387249477445312515]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [cohort_type]&#10;when &apos;7d&apos;  then dateadd(&apos;week&apos;, [return_period], [cohort_date])  = DATETRUNC(&apos;week&apos;, TODAY())&#10;when &apos;weekly&apos;  then dateadd(&apos;week&apos;, [return_period], [cohort_date])  = DATETRUNC(&apos;week&apos;, TODAY())&#10;when &apos;30d&apos; then dateadd(&apos;month&apos;, [return_period], [cohort_date]) = DATETRUNC(&apos;month&apos;, TODAY())&#10;when &apos;monthly&apos; then dateadd(&apos;month&apos;, [return_period], [cohort_date]) = DATETRUNC(&apos;month&apos;, TODAY())&#10;end' />
            </column>
            <column caption='Cohort Size New' datatype='integer' name='[Calculation_1519120490500636697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cohort_size])' />
            </column>
            <column caption='Return Date' datatype='datetime' default-format='*YYYY-MM-DD' name='[Calculation_1519120490500931610]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [cohort_type]&#10;WHEN &apos;7d&apos; THEN DATEADD(&apos;week&apos;, [return_period], [cohort_date])&#10;WHEN &apos;30d&apos; THEN  DATEADD(&apos;month&apos;, [return_period], [cohort_date])&#10;END' />
            </column>
            <column caption='past period' datatype='integer' name='[Calculation_1519120490505461788]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [cohort_type]&#10;WHEN &apos;7d&apos; THEN   DATEDIFF(&apos;week&apos;, [Calculation_1519120490500931610], TODAY())&#10;WHEN &apos;30d&apos; THEN  DATEDIFF(&apos;month&apos;, [Calculation_1519120490500931610], TODAY())&#10;END' />
            </column>
            <column caption='Activity DS' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Frequency (copy 2)_1519120482423672838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_ds]) / SUM([returning_users_ds])' />
            </column>
            <column caption='KPI selector DS' datatype='real' name='[KPI selector ALL (copy)_5087871331990224897]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Retention Rate&apos; THEN round([Retention Rate (copy 3)_1519120482416226304] * 100)&#10;//IF [KPI] = &apos;Retention Rate&apos; THEN STR(ROUND([Retention Rate ALL] * 100, 2)) + &apos; %&apos; &#10;ELSEIF [Parameters].[Parameter 3] = &apos;Returning User&apos; THEN SUM([returning_users_ds])&#10;ELSEIF [Parameters].[Parameter 3] = &apos;User Activity&apos; THEN [Frequency (copy 2)_1519120482423672838]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;User Frequency&apos; THEN [Acitivity (copy)_1519120482424643597]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Orders&apos; THEN SUM([orders_ds])&#10;ELSEIF [Parameters].[Parameter 3] = &apos;AOV&apos; THEN [AOV (copy)_1519120490586726429]&#10;ELSE NULL END' />
            </column>
            <column caption='KPI selector DS (string)' datatype='string' datatype-customized='true' name='[KPI selector ALL (string) (copy)_356276973825667077]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(IF [Parameters].[Parameter 3] = &apos;Retention Rate&apos; THEN STR(ROUND([Retention Rate (copy 3)_1519120482416226304] * 100))  + &apos; %&apos; &#10;ELSEIF [Parameters].[Parameter 3] = &apos;Returning User&apos; THEN STR(SUM([returning_users_ds]))&#10;ELSEIF [Parameters].[Parameter 3] = &apos;User Activity&apos; THEN STR(ROUND([Frequency (copy 2)_1519120482423672838],2))&#10;ELSEIF [Parameters].[Parameter 3] = &apos;User Frequency&apos; THEN STR(ROUND([Acitivity (copy)_1519120482424643597],2))&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Orders&apos; THEN STR(SUM([orders_ds]))&#10;ELSEIF [Parameters].[Parameter 3] = &apos;AOV&apos; THEN STR(ROUND([AOV (copy)_1519120490586726429],2))&#10;ELSE NULL END)' />
            </column>
            <column caption='Retention Rate DS' datatype='real' default-format='p0%' name='[Retention Rate (copy 3)_1519120482416226304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([returning_users_ds]) / [Calculation_1519120490500636697]' />
            </column>
