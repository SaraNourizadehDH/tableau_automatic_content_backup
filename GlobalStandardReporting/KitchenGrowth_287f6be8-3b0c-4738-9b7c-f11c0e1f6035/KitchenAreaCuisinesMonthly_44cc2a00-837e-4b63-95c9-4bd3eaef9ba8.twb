  <worksheets>
    <worksheet name='Cuisine_level'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'>Facility cuisine level: 15 min DT area</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_kitchen_growth_report' name='federated.0tvk7t70ah311s1df95em1n2atmx' />
          </datasources>
          <datasource-dependencies datasource='federated.0tvk7t70ah311s1df95em1n2atmx'>
            <column caption='CVR' datatype='real' name='[Calculation_2201556532851343360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_transactions])/SUM([total_menu])' />
            </column>
            <column caption='AOV euro' datatype='real' name='[Calculation_2573385014360600578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur])/SUM([successful_orders])' />
            </column>
            <column caption='AOV local' datatype='real' name='[Calculation_6105192256990875654]' role='measure' type='quantitative'>
