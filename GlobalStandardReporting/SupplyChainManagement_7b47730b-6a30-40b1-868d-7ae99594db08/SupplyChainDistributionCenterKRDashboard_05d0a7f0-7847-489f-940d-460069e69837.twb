    <worksheet name='DC DOH Deep Dive'>
      <table>
        <view>
          <datasources>
            <datasource caption='dc_doh_dashboard (dev_dmart)' name='federated.13lfz7b1lmqlcq160edlc13ged1s' />
          </datasources>
          <datasource-dependencies datasource='federated.13lfz7b1lmqlcq160edlc13ged1s'>
            <column caption='ABC Segment (Deep Dive)' datatype='string' name='[ABC Segment (copy)_5525213078152441868]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [unit_sales_contribution_bucket]&#10;WHEN &apos;top 50%&apos; THEN &apos;A&apos;&#10;WHEN &apos;50% to 85%&apos; THEN &apos;B&apos;&#10;ELSE &apos;C&apos; END' />
            </column>
            <column caption='% Contribution to Country Revenue L30' datatype='real' name='[Calculation_2091218406005567489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_price_paid_L30])/SUM([country_total_price_paid_L30])' />
            </column>
            <column caption='ABC Segment' datatype='string' name='[Calculation_2091218406012100615]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [unit_sales_contribution_bucket]&#10;WHEN &apos;top 50%&apos; THEN &apos;A&apos;&#10;WHEN &apos;50% to 85%&apos; THEN &apos;B&apos;&#10;ELSE &apos;C&apos; END' />
            </column>
            <column caption='DC to DM Transfers L30 (Units)' datatype='integer' name='[Calculation_2091218406051811336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [warehouse_id],[sku],[Calculation_5156269750166745090]:SUM([st_received_qty])}' />
            </column>
            <column caption='Period 30 Interval' datatype='string' name='[Calculation_5156269750166745090]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF (INT(DATEDIFF(&apos;day&apos;,{FIXED [warehouse_id],[sku]:MIN([period])}, [period]))/30) &lt;1&#10;THEN &apos;First&apos;&#10;ELSEIF (INT(DATEDIFF(&apos;day&apos;,{FIXED [warehouse_id],[sku]:MIN([period])}, [period]))/30) &gt;=1&#10;THEN &apos;Second&apos;&#10;ELSEIF (INT(DATEDIFF(&apos;day&apos;,{FIXED [warehouse_id],[sku]:MIN([period])}, [period]))/30) &gt;2&#10;THEN &apos;Third&apos;&#10;ELSEIF (INT(DATEDIFF(&apos;day&apos;,{FIXED [warehouse_id],[sku]:MIN([period])}, [period]))/30) &gt;3&#10;THEN &apos;Fourth&apos;&#10;ELSEIF (INT(DATEDIFF(&apos;day&apos;,{FIXED [warehouse_id],[sku]:MIN([period])}, [period]))/30) &gt;4&#10;THEN &apos;Fifth&apos;&#10;ELSE &apos;Last&apos;&#10;END' />
            </column>
            <column caption='% Contribution to Total DC Inventory' datatype='real' name='[Contribution to Country Revenue (copy)_2091218406006177795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dc_stock]) / TOTAL(SUM([dc_stock]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Avg DC to DM Transfers L30 (Units)' datatype='real' name='[Total Units Sent from DC to DM (L30) (copy)_2091218406052057097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [warehouse_id],[sku],[Calculation_5156269750166745090]:AVG([st_received_qty])}' />
            </column>
            <column-instance column='[Total Units Sent from DC to DM (L30) (copy)_2091218406052057097]' derivation='Avg' name='[avg:Total Units Sent from DC to DM (L30) (copy)_2091218406052057097:qk]' pivot='key' type='quantitative' />
            <column caption='avg qty sold L30' datatype='real' name='[avg_qty_sold_L30]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='country total price paid L30' datatype='real' name='[country_total_price_paid_L30]' role='measure' type='quantitative' />
            <column caption='Dc Stock' datatype='integer' name='[dc_stock]' role='measure' type='quantitative' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[ABC Segment (copy)_5525213078152441868]' derivation='None' name='[none:ABC Segment (copy)_5525213078152441868:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2091218406012100615]' derivation='None' name='[none:Calculation_2091218406012100615:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[period]' derivation='None' name='[none:period:ok]' pivot='key' type='ordinal' />
            <column-instance column='[sku]' derivation='None' name='[none:sku:nk]' pivot='key' type='nominal' />
