      <column caption='Stock Adjustment data for DC inventory %' datatype='real' name='[Calculation_6132847183742271488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [flag] = &apos;Stock Adjustment data for DC inventory %&apos; then [metric] END' />
      </column>
      <column caption='DC ST - Average Lead time total (Days)' datatype='real' name='[DC ST - Average Lead time total (copy)_3973934139223351297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [flag] = &apos;DC ST - Average Lead time total&apos; THEN [metric] END)/24' />
