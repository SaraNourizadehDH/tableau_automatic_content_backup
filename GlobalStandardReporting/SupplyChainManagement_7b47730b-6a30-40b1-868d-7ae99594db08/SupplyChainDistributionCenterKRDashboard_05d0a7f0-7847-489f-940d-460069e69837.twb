      <column caption='DC to DM Transfers L30 (Units)' datatype='integer' name='[Calculation_2091218406051811336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [warehouse_id],[sku],[Calculation_5156269750166745090]:SUM([st_received_qty])}' />
