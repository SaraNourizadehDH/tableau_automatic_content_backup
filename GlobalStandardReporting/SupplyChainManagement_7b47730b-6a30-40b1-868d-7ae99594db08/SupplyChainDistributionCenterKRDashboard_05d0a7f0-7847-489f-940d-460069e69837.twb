      <aliases enabled='yes' />
      <column caption='DC POs Completion Lead time' datatype='real' name='[Calculation_1461840309327577090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [flag] = &apos;DC PO - Completion Lead Time&apos; then [metric] END' />
      </column>
      <column caption='Non DC PO Completion Lead time' datatype='real' name='[Calculation_1461840309327798275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [flag] = &apos;Non DC PO - Completion Lead Time&apos;  then [metric] END' />
      </column>
      <column caption='Total Inbound from POs' datatype='real' name='[Calculation_1461840309333954565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [flag] = &apos;Total Inbound from POs (Item Level)&apos; then [metric] end' />
      </column>
      <column caption='DC Inbound (Qty Level)' datatype='real' name='[Calculation_1461840309334179847]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [flag] = &apos;DC Inbound (Qty level)&apos; then [metric] end' />
      </column>
      <column caption='Total Inbound from non DC POs (Qty Level)' datatype='real' name='[Calculation_1461840309334351880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [flag] = &apos;Total Inbound from non DC POs (Qty Level)&apos; then [metric] END' />
      </column>
      <column caption='Total Inbound from non DC POs (SKU Level)' datatype='real' name='[Calculation_1461840309342203914]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [flag] = &apos;Total Inbound from non DC POs (SKU Level)&apos; then [metric] end' />
      </column>
      <column caption='DC Inbound (SKU level)' datatype='real' name='[Calculation_1461840309342662667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [flag] = &apos;DC Inbound (SKU level)&apos; then [metric] end' />
      </column>
      <column caption='Purchase Orders (to Dmarts) - Received' datatype='real' name='[Calculation_1461840309691568142]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [flag] = &apos;Purchase Orders (to Dmarts) - Received&apos; then [metric] end' />
      </column>
      <column caption=' Purchase Orders (To DC) - Received' datatype='real' name='[Calculation_1461840309691682831]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [flag] = &apos;Purchase Orders (To DC) - Received&apos; then [metric] end' />
      </column>
      <column caption='Metric_format' datatype='string' name='[Calculation_1461840309729812496]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [flag] = &apos;1. Total Purchase Orders - Created&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;2. Total Purchase Orders - Received&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;3. Total Purchase Orders - Received from created date&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;4. Purchase Orders (to Dmarts) - Received&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;5. Purchase Orders (To DC) - Created&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;6. Purchase Orders (To DC) - Received&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;7. Purchase Orders (To DC) - Received from created date&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;8. Purchase Orders (To DC) - Received Multiple delivery&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;9. Total Inbound from POs (Item Level)&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;10. DC Inbound (item level)&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;11. Total Inbound from non DC POs (Item Level)&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;12. Total Inbound from POs (SKU Level)&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;13. DC Inbound (sku level)&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;14. Total Inbound from non DC POs (SKU Level)&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;15. Total Store Transfers - Created&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;16. Store Transfers (From DC) - Created&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;17. Store Transfers (From DC) - Received from Created date&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;18. Store Transfers (From DC) - Received&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;19. DC outbound (item level)&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;20. DC outbound (sku level)&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;21. Store Transfer from DM to DC&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;27. DC Inventory (item level) - Avg&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;28. DC Inventory (value level) - Avg&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;34. Cancelled POs (for DCs)&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;35. Store Transfer cancellation from DC to DM&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;37. Supplier Drops at DC&apos; then left(str([metric]),len(str([metric]))-2) &#10;ELSEIF [flag] = &apos;38. Lead time for delivery of Fresh and ultra fresh product&apos; then left(str([metric]),len(str([metric]))-2) &#10;else str([metric]) END' />
      </column>
      <column caption='Fresh and Ultra Fresh Lead Time' datatype='real' name='[Calculation_32651150433665024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [flag] = &apos;Lead time for delivery of Fresh and ultra fresh product&apos; then [metric] end' />
      </column>
      <column caption='KPIShow' datatype='string' name='[Calculation_32651150451732483]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [flag] = [Parameters].[Parameter 1 1] THEN &apos;Show&apos; ELSE &apos;Hide&apos; END' />
      </column>
      <column caption='DC vs Non DC Item Count' datatype='real' name='[Calculation_4664181123616378880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [flag] = &apos;DC Inbound (item level)&apos;  then [metric]&#10;&#10;ELSEIF [flag] = &apos;Total Inbound from non DC POs (Item Level)&apos; THEN [metric] end' />
      </column>
      <column caption='DC vs Non DC Item' datatype='string' name='[Calculation_4664181123616452609]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [flag] = &apos;12. DC Inbound (item level)&apos;  then &apos;DC Item&apos;&#10;&#10;ELSEIF [flag] = &apos;13. Total Inbound from non DC POs (Item Level)&apos; THEN &apos;Non DC Item&apos; end' />
      </column>
      <column caption='DC Vs Non DC SKU Count' datatype='real' name='[Calculation_4664181123617062914]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [flag] = &apos;Total Inbound from non DC POs (SKU Level)&apos; then [metric] &#10;&#10;ELSEIF  [flag] = &apos;DC Inbound (sku level)&apos; then [metric] end' />
      </column>
      <column caption='DC Vs Non DC SKU' datatype='string' name='[Calculation_4664181123617341443]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [flag] = &apos;16. Total Inbound from non DC POs (SKU Level)&apos; then &apos;DC SKU&apos;&#10;&#10;ELSEIF  [flag] = &apos;15. DC Inbound (sku level)&apos; then &apos;Non DC SKU&apos; end' />
      </column>
      <column caption='DC ST - Status time created to outbound' datatype='real' name='[Calculation_6110118074019459072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [flag] = &apos;DC ST - Status time created to outbound&apos; then [metric] END' />
      </column>
      <column caption='DC ST - Status time outbound to transferring' datatype='real' name='[Calculation_6110118074019835905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [flag] = &apos;DC ST - Status time outbound to transferring&apos; then [metric] end' />
      </column>
      <column caption='DC ST - Status time transferring to inbounding' datatype='real' name='[Calculation_6110118074020007938]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [flag] = &apos;DC ST - Status time transferring to inbounding&apos; then [metric] end' />
