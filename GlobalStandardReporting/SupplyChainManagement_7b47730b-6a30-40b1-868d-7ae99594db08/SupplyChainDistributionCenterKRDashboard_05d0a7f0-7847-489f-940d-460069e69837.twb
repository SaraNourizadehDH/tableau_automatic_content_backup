      <column caption='Cross Dock' datatype='integer' name='[Calculation_3007208337854668800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Flag] = &quot;Cross Dock&quot; then [received_qty] else 0 END' />
      </column>
      <column caption='DCSKUCount' datatype='integer' name='[Calculation_3286572197389357058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [Flag] = &apos;DC to Dmarts&apos; then  [sku] end)' />
      </column>
      <column caption='TotalSKUCount' datatype='integer' name='[Calculation_3286572198321823748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([sku])' />
      </column>
      <column caption='SKU Centralization %' datatype='real' default-format='p0%' name='[Calculation_3286572198321942533]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3286572197389357058]/[Calculation_3286572198321823748]' />
      </column>
      <column caption='Integrated DC 2 Dmart' datatype='real' default-format='p0.00%' name='[Calculation_3286572198393872390]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [integration] = &quot;true&quot; then [Calculation_897342278734516226] else 0 end)/sum(if [store_type] = &quot;DC&quot; then [Calculation_897342278734516226] else 0 end)' />
      </column>
      <column caption='APAC DC' datatype='integer' name='[Calculation_5529083390680018946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Flag] = &quot;APAC DC&quot; then ([received_qty]) else 0 END' />
      </column>
      <column caption='DC List' datatype='string' name='[Calculation_6545771008975122433]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [store_type] = &apos;DC&apos; and [supplier_name] &lt;&gt; &quot;Null&quot; then [supplier_name] END' />
      </column>
      <column caption='Parent Child' datatype='string' name='[Calculation_6545771008975286274]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [store_type] = &apos;Parent Child&apos; then [supplier_name] END' />
      </column>
      <column caption='Parent Child List' datatype='string' name='[Calculation_6545771008976887811]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [store_type] = &apos;Parent Child&apos; then [supplier_name] END' />
      </column>
      <column caption='Count DC' datatype='integer' name='[Calculation_6545771008977227780]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_6545771008975122433]) - 1' />
      </column>
      <column caption='Count Parent Child' datatype='integer' name='[Calculation_6545771008977297413]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_6545771008976887811]) - 1' />
      </column>
      <column caption='MaxDate' datatype='date' name='[Calculation_6545771009005297671]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='max([Received_date])' />
      </column>
      <column caption='Total Qty Recieved' datatype='integer' name='[Calculation_897342278734303232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [country_code]&#10;  WHEN &apos;tw&apos; THEN [Calculation_897342278734430209]&#10;  WHEN &apos;sg&apos; THEN [Calculation_897342278734430209] + [Calculation_5529083390680018946]&#10;  WHEN &apos;ph&apos; THEN [Calculation_897342278734430209] + [Calculation_5529083390680018946]&#10;  WHEN &apos;hk&apos; then&#10;(If [Received_date] &gt; date(&apos;2022-12-31&apos;) and [Received_date] &lt; date(&apos;2023-02-01&apos;) then  ([Calculation_897342278734430209] + [Calculation_897342278734516226]) else [Calculation_897342278734430209] + [Calculation_5529083390680018946] end )&#10;  WHEN &apos;my&apos; THEN [Calculation_897342278734430209] + [Calculation_5529083390680018946]&#10;&#10;  ELSE [Calculation_897342278734516226] + [Calculation_897342278734430209]&#10;END' />
      </column>
      <column caption='Supplier2Dmarts' datatype='integer' name='[Calculation_897342278734430209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Flag]=&quot;Supplier to Dmarts&quot; then [received_qty] else 0 END' />
      </column>
      <column caption='DC2Dmarts' datatype='integer' name='[Calculation_897342278734516226]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2] =  &quot;True&quot;  then&#10;&#10;(if ([Flag]=&quot;DC to Dmarts&quot; OR [Flag] = &quot;Cross Dock&quot;) and [integration] = &quot;true&quot; then [received_qty]  ELSE 0 END)&#10;&#10;ELSEIF  [Parameters].[Parameter 2] =  &quot;False&quot;  then&#10;&#10;(if  ([Flag]= &quot;DC to Dmarts&quot; OR [Flag] = &quot;Cross Dock&quot;) and [integration] = &quot;false&quot; then [received_qty]  ELSE 0 END)&#10;&#10;ELSEIF  [Parameters].[Parameter 2] =  &quot;All&quot;  then&#10;&#10;(IF  [Flag]=&quot;DC to Dmarts&quot; OR [Flag] = &quot;Cross Dock&quot; then [received_qty]  ELSE 0 END)&#10;&#10;&#10;ELSE 0 END' />
      </column>
      <column caption='Recieved Qty (Country)' datatype='integer' name='[Calculation_897342278738157571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ fixed [country_code],DATE([Received_date]) : sum([Calculation_897342278734303232])}' />
      </column>
      <column caption='DC Centralization %' datatype='real' default-format='p0%' name='[Calculation_897342278738374660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([DC2Dmarts (copy)_3160189990162771972])/sum([Calculation_897342278734303232])' />
      </column>
      <column caption='Country (copy)' datatype='string' name='[Country (copy)_3160189990208794629]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='tableau' formula='[common_name]' />
      </column>
      <column caption='DC2Dmarts (SKU)' datatype='integer' name='[DC2Dmarts (copy 2)_3286572197388054529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2] =  &quot;True&quot;  then&#10;&#10;(if ([Flag]=&quot;DC to Dmarts&quot; OR [Flag] = &quot;Cross Dock&quot;) and [integration] = &quot;true&quot; then [received_qty]  ELSE 0 END)&#10;&#10;ELSEIF  [Parameters].[Parameter 2] =  &quot;False&quot;  then&#10;&#10;(if  ([Flag]= &quot;DC to Dmarts&quot; OR [Flag] = &quot;Cross Dock&quot;) and [integration] = &quot;false&quot; then [received_qty]  ELSE 0 END)&#10;&#10;ELSEIF  [Parameters].[Parameter 2] =  &quot;All&quot;  then&#10;&#10;(IF  [Flag]=&quot;DC to Dmarts&quot; OR [Flag] = &quot;Cross Dock&quot; then [received_qty]  ELSE 0 END)&#10;&#10;&#10;ELSE 0 END' />
      </column>
      <column caption='DC2Dmarts (copy)' datatype='integer' name='[DC2Dmarts (copy)_2756836357006852096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2] =  &quot;Integrated&quot;  then&#10;&#10;(if [country_code] in (&apos;sg&apos;, &apos;my&apos;,&apos;hk&apos;)  and ([Flag]=&quot;DC to Dmarts&quot; OR [Flag] = &quot;Cross Dock&quot;) then [received_qty] &#10;ELSEIF  [Flag]=&quot;DC to Dmarts&quot;  and [integration] = &apos;true&apos; then [received_qty]  ELSE 0 END)&#10;&#10;ELSEIF  [Parameters].[Parameter 2] =  &quot;Not Integrated&quot;  then&#10;&#10;(if [country_code] in (&apos;sg&apos;, &apos;my&apos;,&apos;hk&apos;)  and ([Flag]=&quot;DC to Dmarts&quot; OR [Flag] = &quot;Cross Dock&quot;) then [received_qty] &#10;ELSEIF  [Flag]=&quot;DC to Dmarts&quot;  and [integration] = &apos;false&apos; then [received_qty]  ELSE 0 END)&#10;&#10;ELSEIF  [Parameters].[Parameter 2] =  &quot;All&quot;  then&#10;&#10;(if [country_code] in (&apos;sg&apos;, &apos;my&apos;,&apos;hk&apos;)  and ([Flag]=&quot;DC to Dmarts&quot; OR [Flag] = &quot;Cross Dock&quot;) then [received_qty] &#10;ELSEIF  [Flag]=&quot;DC to Dmarts&quot;  then [received_qty]  ELSE 0 END)&#10;&#10;&#10;ELSE 0 END' />
      </column>
      <column caption='DC2Dmartz' datatype='integer' name='[DC2Dmarts (copy)_3160189990162771972]' role='measure' type='quantitative'>
