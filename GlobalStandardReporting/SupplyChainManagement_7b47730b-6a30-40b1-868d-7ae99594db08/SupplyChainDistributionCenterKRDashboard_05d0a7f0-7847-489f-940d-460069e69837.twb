    <worksheet name='Centralization % Combined'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Volume Centralization</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rdvr_scm_centralization_list (dev_dmart)' name='federated.189jzwz1wpp9o819iffnz0t3dtsn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Integration?' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;False&quot;' value='Not Integrated' />
                <alias key='&quot;True&quot;' value='Integrated' />
              </aliases>
            </column>
            <column caption='Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.189jzwz1wpp9o819iffnz0t3dtsn'>
            <column caption='APAC DC' datatype='integer' name='[Calculation_5529083390680018946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Flag] = &quot;APAC DC&quot; then ([received_qty]) else 0 END' />
            </column>
            <column caption='Total Qty Recieved' datatype='integer' name='[Calculation_897342278734303232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [country_code]&#10;  WHEN &apos;tw&apos; THEN [Calculation_897342278734430209]&#10;  WHEN &apos;sg&apos; THEN [Calculation_897342278734430209] + [Calculation_5529083390680018946]&#10;  WHEN &apos;ph&apos; THEN [Calculation_897342278734430209] + [Calculation_5529083390680018946]&#10;  WHEN &apos;hk&apos; then&#10;(If [Received_date] &gt; date(&apos;2022-12-31&apos;) and [Received_date] &lt; date(&apos;2023-02-01&apos;) then  ([Calculation_897342278734430209] + [Calculation_897342278734516226]) else [Calculation_897342278734430209] + [Calculation_5529083390680018946] end )&#10;  WHEN &apos;my&apos; THEN [Calculation_897342278734430209] + [Calculation_5529083390680018946]&#10;&#10;  ELSE [Calculation_897342278734516226] + [Calculation_897342278734430209]&#10;END' />
            </column>
            <column caption='Supplier2Dmarts' datatype='integer' name='[Calculation_897342278734430209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Flag]=&quot;Supplier to Dmarts&quot; then [received_qty] else 0 END' />
            </column>
            <column caption='DC2Dmarts' datatype='integer' name='[Calculation_897342278734516226]' role='measure' type='quantitative'>
