      <column datatype='integer' name='[Month / Year]' role='dimension' type='ordinal' user:agg-type='MY' user:base-field='month' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='(DATEPART(&apos;year&apos;, [month])*100 + DATEPART(&apos;month&apos;, [month]))' />
