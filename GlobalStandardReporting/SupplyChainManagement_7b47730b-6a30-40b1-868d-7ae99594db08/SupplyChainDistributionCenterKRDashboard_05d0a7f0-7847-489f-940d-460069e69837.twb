      <table>
        <view>
          <datasources>
            <datasource caption='dc_doh_dashboard_recommendations (dev_dmart)' name='federated.0c5kqt700wv3op11f2u431jjfiv8' />
            <datasource caption='dc_doh_dashboard (dev_dmart)' name='federated.13lfz7b1lmqlcq160edlc13ged1s' />
          </datasources>
          <datasource-dependencies datasource='federated.0c5kqt700wv3op11f2u431jjfiv8'>
            <column caption='% Contribution to Country Revenue L60' datatype='real' name='[% Contribution to Country Revenue L30 (copy)_4524217670601048064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_price_paid_L60])/SUM([country_total_price_paid_L60])' />
            </column>
            <column caption='Weighted Availability L60' datatype='real' name='[Availability L30 (copy)_4524217670602125315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([available_events_weightage_L60])*SUM([sales_forecast_quantity_L60]))&#10;/&#10;(SUM([total_events_weightage_L60])*SUM([sales_forecast_quantity_L60]))' />
            </column>
            <column caption='Supplier Fill Rate L30 - base' datatype='real' name='[Availability L60 (copy)_4524217670602162180]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_received_qty_per_order_L30]) /&#10;(SUM([total_demanded_qty_per_order_L30])+SUM([supplier_non_fulfilled_quantity_L30]))' />
            </column>
            <column caption='% Contribution to Country Revenue L30' datatype='real' name='[Calculation_2091218406005567489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_price_paid_L30])/SUM([country_total_price_paid_L30])' />
            </column>
            <column caption='ABC Segment' datatype='string' name='[Calculation_2091218406012100615]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [unit_sales_contribution_bucket]&#10;WHEN &apos;top 50%&apos; THEN &apos;A&apos;&#10;WHEN &apos;50% to 85%&apos; THEN &apos;B&apos;&#10;ELSE &apos;C&apos; END' />
            </column>
            <column caption='Weighted Availability L30' datatype='real' name='[Calculation_4524217670602018818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([available_events_weightage_L30])*SUM([sales_forecast_quantity_L30]))&#10;/&#10;(SUM([total_events_weightage_L30])*SUM([sales_forecast_quantity_L30]))' />
            </column>
            <column caption='ABC Segment (Recommendation)' datatype='string' name='[Calculation_5156269745212272640]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [unit_sales_contribution_bucket]&#10;WHEN &apos;top 50%&apos; THEN &apos;A&apos;&#10;WHEN &apos;50% to 85%&apos; THEN &apos;B&apos;&#10;ELSE &apos;C&apos; END' />
            </column>
            <column caption='Period 30 Interval' datatype='string' name='[Calculation_5156269750205923334]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF (INT(DATEDIFF(&apos;day&apos;,{FIXED [warehouse_id],[sku]:MIN([period])}, [period]))/30) &lt;1&#10;THEN &apos;First&apos;&#10;ELSEIF (INT(DATEDIFF(&apos;day&apos;,{FIXED [warehouse_id],[sku]:MIN([period])}, [period]))/30) &gt;=1&#10;THEN &apos;Second&apos;&#10;ELSEIF (INT(DATEDIFF(&apos;day&apos;,{FIXED [warehouse_id],[sku]:MIN([period])}, [period]))/30) &gt;2&#10;THEN &apos;Third&apos;&#10;ELSEIF (INT(DATEDIFF(&apos;day&apos;,{FIXED [warehouse_id],[sku]:MIN([period])}, [period]))/30) &gt;3&#10;THEN &apos;Fourth&apos;&#10;ELSEIF (INT(DATEDIFF(&apos;day&apos;,{FIXED [warehouse_id],[sku]:MIN([period])}, [period]))/30) &gt;4&#10;THEN &apos;Fifth&apos;&#10;ELSE &apos;Last&apos;&#10;END' />
            </column>
            <column caption='Supplier Fill Rate L60 - base' datatype='real' name='[Supplier Fill Rate L30 (copy)_4524217670602252293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_received_qty_per_order_L60]) /&#10;(SUM([total_demanded_qty_per_order_L60])+SUM([supplier_non_fulfilled_quantity_L60]))' />
            </column>
            <column caption='Supplier Fill Rate L30' datatype='real' name='[Supplier Fill Rate L30 (copy)_5156269750206349319]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [warehouse_id],[sku],[Calculation_5156269750205923334]:[Availability L60 (copy)_4524217670602162180]}' />
            </column>
            <column caption='Supplier Fill Rate L60 ' datatype='real' name='[Supplier Fill Rate L60 (copy)_5156269750207590408]' role='measure' type='quantitative'>
