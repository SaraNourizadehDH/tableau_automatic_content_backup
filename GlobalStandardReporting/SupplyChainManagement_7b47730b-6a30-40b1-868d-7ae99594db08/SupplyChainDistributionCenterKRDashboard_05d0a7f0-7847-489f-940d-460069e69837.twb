          <datasource-dependencies datasource='Parameters'>
            <column caption='Integration?' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;False&quot;' value='Not Integrated' />
                <alias key='&quot;True&quot;' value='Integrated' />
              </aliases>
            </column>
            <column caption='Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.189jzwz1wpp9o819iffnz0t3dtsn'>
            <column caption='APAC DC' datatype='integer' name='[Calculation_5529083390680018946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Flag] = &quot;APAC DC&quot; then ([received_qty]) else 0 END' />
            </column>
            <column caption='Total Qty Recieved' datatype='integer' name='[Calculation_897342278734303232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [country_code]&#10;  WHEN &apos;tw&apos; THEN [Calculation_897342278734430209]&#10;  WHEN &apos;sg&apos; THEN [Calculation_897342278734430209] + [Calculation_5529083390680018946]&#10;  WHEN &apos;ph&apos; THEN [Calculation_897342278734430209] + [Calculation_5529083390680018946]&#10;  WHEN &apos;hk&apos; then&#10;(If [Received_date] &gt; date(&apos;2022-12-31&apos;) and [Received_date] &lt; date(&apos;2023-02-01&apos;) then  ([Calculation_897342278734430209] + [Calculation_897342278734516226]) else [Calculation_897342278734430209] + [Calculation_5529083390680018946] end )&#10;  WHEN &apos;my&apos; THEN [Calculation_897342278734430209] + [Calculation_5529083390680018946]&#10;&#10;  ELSE [Calculation_897342278734516226] + [Calculation_897342278734430209]&#10;END' />
            </column>
            <column caption='Supplier2Dmarts' datatype='integer' name='[Calculation_897342278734430209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Flag]=&quot;Supplier to Dmarts&quot; then [received_qty] else 0 END' />
            </column>
            <column caption='DC2Dmarts' datatype='integer' name='[Calculation_897342278734516226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2] =  &quot;True&quot;  then&#10;&#10;(if ([Flag]=&quot;DC to Dmarts&quot; OR [Flag] = &quot;Cross Dock&quot;) and [integration] = &quot;true&quot; then [received_qty]  ELSE 0 END)&#10;&#10;ELSEIF  [Parameters].[Parameter 2] =  &quot;False&quot;  then&#10;&#10;(if  ([Flag]= &quot;DC to Dmarts&quot; OR [Flag] = &quot;Cross Dock&quot;) and [integration] = &quot;false&quot; then [received_qty]  ELSE 0 END)&#10;&#10;ELSEIF  [Parameters].[Parameter 2] =  &quot;All&quot;  then&#10;&#10;(IF  [Flag]=&quot;DC to Dmarts&quot; OR [Flag] = &quot;Cross Dock&quot; then [received_qty]  ELSE 0 END)&#10;&#10;&#10;ELSE 0 END' />
            </column>
            <column caption='DC Centralization %' datatype='real' default-format='p0%' name='[Calculation_897342278738374660]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([DC2Dmarts (copy)_3160189990162771972])/sum([Calculation_897342278734303232])' />
            </column>
            <column caption='DC2Dmartz' datatype='integer' name='[DC2Dmarts (copy)_3160189990162771972]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [Parameters].[Parameter 3] = &apos;DC&apos;&#10;&#10;then (if [store_type] = &apos;DC&apos; then [Calculation_897342278734516226] END)&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Parent Child&apos;&#10;then (if [store_type] = &apos;Parent Child&apos; then [Calculation_897342278734516226] END)&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Cross Dock&apos;&#10;then (if [store_type] = &apos;Cross Dock&apos; then [Calculation_897342278734516226] END)&#10;ELSEIF  [Parameters].[Parameter 3] = &apos;All&apos; then [Calculation_897342278734516226] END' />
            </column>
            <column caption='Flag1' datatype='string' name='[Flag]' role='dimension' type='nominal' />
            <column caption='Received date' datatype='date' name='[Received_date]' role='dimension' type='ordinal' />
            <column caption='Country' datatype='string' name='[common_name]' role='dimension' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Integration' datatype='string' name='[integration]' role='dimension' type='nominal' />
            <column-instance column='[Received_date]' derivation='Month' name='[mn:Received_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[common_name]' derivation='None' name='[none:common_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column caption='Received Qty' datatype='integer' name='[received_qty]' role='measure' type='quantitative' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Store Type' datatype='string' name='[store_type]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_897342278738374660]' derivation='User' name='[usr:Calculation_897342278738374660:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.189jzwz1wpp9o819iffnz0t3dtsn].[none:common_name:nk]' filter-group='3'>
