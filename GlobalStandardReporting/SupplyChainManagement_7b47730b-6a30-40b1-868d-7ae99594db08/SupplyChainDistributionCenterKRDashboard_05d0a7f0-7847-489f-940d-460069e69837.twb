      <column caption='Period 30 Interval' datatype='string' name='[Calculation_5156269750166745090]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF (INT(DATEDIFF(&apos;day&apos;,{FIXED [warehouse_id],[sku]:MIN([period])}, [period]))/30) &lt;1&#10;THEN &apos;First&apos;&#10;ELSEIF (INT(DATEDIFF(&apos;day&apos;,{FIXED [warehouse_id],[sku]:MIN([period])}, [period]))/30) &gt;=1&#10;THEN &apos;Second&apos;&#10;ELSEIF (INT(DATEDIFF(&apos;day&apos;,{FIXED [warehouse_id],[sku]:MIN([period])}, [period]))/30) &gt;2&#10;THEN &apos;Third&apos;&#10;ELSEIF (INT(DATEDIFF(&apos;day&apos;,{FIXED [warehouse_id],[sku]:MIN([period])}, [period]))/30) &gt;3&#10;THEN &apos;Fourth&apos;&#10;ELSEIF (INT(DATEDIFF(&apos;day&apos;,{FIXED [warehouse_id],[sku]:MIN([period])}, [period]))/30) &gt;4&#10;THEN &apos;Fifth&apos;&#10;ELSE &apos;Last&apos;&#10;END' />
      </column>
      <column caption='% Contribution to Total DC Inventory' datatype='real' name='[Contribution to Country Revenue (copy)_2091218406006177795]' role='measure' type='quantitative'>
