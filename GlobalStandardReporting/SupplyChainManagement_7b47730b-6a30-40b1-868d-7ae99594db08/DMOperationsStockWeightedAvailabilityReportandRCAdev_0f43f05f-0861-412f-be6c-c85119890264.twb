            </column>
            <column caption='Date' datatype='date' name='[Calculation_594475160209260544]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Sku Status Parameter],[period_day], &apos;monday&apos;))' />
