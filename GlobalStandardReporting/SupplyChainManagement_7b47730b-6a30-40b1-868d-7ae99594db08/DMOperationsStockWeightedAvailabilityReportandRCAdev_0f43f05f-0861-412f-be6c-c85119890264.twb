      <aliases enabled='yes' />
      <column caption='Actionable Sorting' datatype='real' name='[Calculation_1906922660939415552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(sum([sales_forecast_quantity]),0)*(1-[Calculation_594475160213049346])' />
      </column>
      <column caption='Country.' datatype='string' name='[Calculation_2272628971722936320]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[common_name]' />
      </column>
      <column caption='Weightage %' datatype='real' name='[Calculation_238338953318182913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sales_forecast_quantity])/sum([Calculation_792352075901247488])' />
      </column>
      <column caption='Country Availability Impact  %' datatype='real' name='[Calculation_3130423956745097216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Weightage % (copy)_5564267710612566016] * (1-[Calculation_594475160213049346])' />
      </column>
      <column caption='Granularity' datatype='string' name='[Calculation_4635329926935134209]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Date Granularity (copy)_4635329926934269952] = &apos;Region&apos; THEN [region]&#10;ELSEIF [Parameters].[Date Granularity (copy)_4635329926934269952] = &apos;Country&apos; THEN [common_name]&#10;ELSEIF [Parameters].[Date Granularity (copy)_4635329926934269952] = &apos;Warehouse Name&apos; THEN [warehouse_name]&#10;ELSEIF [Parameters].[Date Granularity (copy)_4635329926934269952] = &apos;Supplier Name&apos; THEN [supplier_name]&#10;ELSEIF [Parameters].[Date Granularity (copy)_4635329926934269952] = &apos;Level One Category&apos; THEN [level_one_category]&#10;ELSEIF [Parameters].[Date Granularity (copy)_4635329926934269952] = &apos;Level Two Category&apos; THEN [level_two_category]&#10;ELSEIF [Parameters].[Date Granularity (copy)_4635329926934269952] = &apos;Level Zero Category&apos; THEN [level_zero_category]&#10;END' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_594475160209260544]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Sku Status Parameter],[period_day], &apos;monday&apos;))' />
      </column>
      <column caption='Global' datatype='string' name='[Calculation_594475160209506305]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Global&apos;' />
      </column>
      <column caption='Weighted Availability %' datatype='real' name='[Calculation_594475160213049346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([available_events_weightage]*IFNULL([sales_forecast_quantity],0))/&#10;sum([total_events_weightage]*IFNULL([sales_forecast_quantity],0))' />
      </column>
      <column caption='Avg. Daily Listed SKUs per Warehouse' datatype='real' name='[Calculation_594475160214941699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum({ INCLUDE [period_day],[warehouse_id]: &#10;COUNTD([sku])})&#10;/&#10;(COUNTD(STR([period_day])+&quot;_&quot;+[warehouse_id]))' />
      </column>
      <column caption='EntityId_SKUID_Product' datatype='string' name='[Calculation_6165076046600867840]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[global_entity_id]+&quot;_&quot;+IFNULL([sku],&quot;_&quot;)+&quot;_&quot;+[product_name]' />
      </column>
      <column caption='ABC Segment' datatype='string' name='[Calculation_6738581371168821248]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [unit_sales_contribution_bucket] = &quot;top 50%&quot; THEN &quot;A&quot; &#10;ELSEIF [unit_sales_contribution_bucket] = &quot;50% to 85%&quot; THEN &quot;B&quot; &#10;ELSE &quot;C&quot; &#10;END' />
      </column>
      <column aggregation='Attribute' caption='Weightage Denominator' datatype='real' name='[Calculation_792352075901247488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [Calculation_594475160209506305],[region],[Region (copy)_1906922660944707586],[common_name],[Calculation_2272628971722936320],[warehouse_name],[Warehouse Name (copy)_1971591536845946881],&#10;[warehouse_id],[supplier_id],[supplier_name],[level_zero_category],&#10;[level_one_category],[Level One Category (copy)_1971591536845844480],[level_two_category],[sku], [product_name]&#10;,[Calculation_6165076046600867840],[Calculation_6738581371168821248],[Supplier Name (copy)_1848305481738551296]&#10;&#10;&#10;:sum([sales_forecast_quantity])}' />
      </column>
      <column caption='Level One Category.' datatype='string' name='[Level One Category (copy)_1971591536845844480]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[level_one_category]' />
      </column>
      <column caption='Old Availability %' datatype='real' name='[New Availability % (copy)_2085799965150072832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([available_hours])/sum([potential_hours])' />
