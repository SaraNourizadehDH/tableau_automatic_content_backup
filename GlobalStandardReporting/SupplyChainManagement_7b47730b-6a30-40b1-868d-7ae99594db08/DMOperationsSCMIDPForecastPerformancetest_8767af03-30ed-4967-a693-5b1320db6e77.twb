      <column caption='BIAS D1 (Raw)' datatype='real' name='[BIAS D1 (Filtered) (copy)_2151876254786838542]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([predicted_qty_d1])/SUM([qty_sold])' />
      </column>
      <column caption='Rolling WAPE D1 (Filtered)' datatype='real' name='[Calculation_1443192638150619136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rolling_forecast_error_d1_filtered])/SUM([rolling_sales_filtered])' />
      </column>
      <column caption='Rolling BIAS D1 (Filtered)' datatype='real' name='[Calculation_1443192638175354884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rolling_forecast_d1_filtered])/SUM([rolling_sales_filtered])' />
      </column>
      <column caption='date granularity' datatype='string' name='[Calculation_1731915589214568448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Country Code Parameter] &#13;&#10;WHEN &apos;day&apos; THEN STR(DATE(DATETRUNC(&apos;day&apos;, [date]))) &#13;&#10;WHEN &apos;week&apos; THEN STR(DATE(DATETRUNC(&apos;week&apos;, [date], &apos;monday&apos;)))&#13;&#10;WHEN &apos;month&apos; THEN STR(DATE(DATETRUNC(&apos;month&apos;, [date])))  &#13;&#10;WHEN &apos;# week&apos; THEN STR(DATEPART(&apos;year&apos;, [date])) +&quot;  &quot;+ STR(DATEPART(&apos;week&apos;, [date]))&#13;&#10;WHEN &apos;quarter&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;, [date]))) &#13;&#10;END' />
      </column>
      <column caption='BIAS comparison' datatype='real' name='[Calculation_2151876254790369295]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[BIAS D1 (Filtered) (copy)_2151876254786838542]-[Rolling BIAS D1 (Filtered) (copy)_1443192638175543301]' />
      </column>
      <column aggregation='Sum' caption='Flag Consider' datatype='integer' name='[Flag_Consider]' role='dimension' type='ordinal' />
