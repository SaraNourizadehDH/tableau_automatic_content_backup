        <calculation class='tableau' formula='IF ISNULL([expiration_date]) THEN &apos;No Expiry&apos;&#10;ELSEIF ([expiration_date]&lt;[stock_date]) THEN &apos;Expired&apos;&#10;ELSEIF (DATEDIFF(&apos;day&apos;,[stock_date],[expiration_date]) &lt; 4) THEN &apos;0-3 Days&apos;&#10;ELSEIF (DATEDIFF(&apos;day&apos;,[stock_date],[expiration_date]) &lt; 7) THEN &apos;4-7 Days&apos;&#10;ELSEIF (DATEDIFF(&apos;day&apos;,[stock_date],[expiration_date]) &lt; 30) THEN &apos;8-30 Days&apos;&#10;ELSEIF (DATEDIFF(&apos;day&apos;,[stock_date],[expiration_date]) &lt; 61) THEN &apos;1-2 Months&apos;&#10;ELSEIF (DATEDIFF(&apos;day&apos;,[stock_date],[expiration_date]) &lt; 91) THEN &apos;2-3 Months&apos;&#10;ELSEIF (DATEDIFF(&apos;day&apos;,[stock_date],[expiration_date]) &lt; 122) THEN &apos;3-4 Months&apos;&#10;ELSEIF (DATEDIFF(&apos;day&apos;,[stock_date],[expiration_date]) &lt; 152) THEN &apos;4-5 Months&apos;&#10;ELSEIF (DATEDIFF(&apos;day&apos;,[stock_date],[expiration_date]) &gt;= 152) THEN &apos;&gt;5 Months&apos;&#10;END' />
