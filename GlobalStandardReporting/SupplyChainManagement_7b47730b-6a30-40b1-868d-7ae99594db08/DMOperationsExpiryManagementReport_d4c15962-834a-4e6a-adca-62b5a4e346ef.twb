          <zone forceUpdate='true' h='98000' id='3' type-v2='text' w='98978' x='511' y='1000'>
            <formatted-text>
              <run bold='true' fontcolor='#ffffff' fontsize='20'>Definitions</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff'>Received Qty : Stock Quntity Recieved from respective Purchase Order / Store Transfer</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff'>Remaining Qty : Stock Quantity Remaning from the Recieved Qty basis FIFO (First In  First Out)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Adjusted Shelf Life : Expiration Date - Receiving Date </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Remaining Adjusted Shelf Life = Expiration Date - Stock Date </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>% Remaining Adjusted Shelf Life = Remaining Adjusted Shelf Life / Adjusted Shelf Life</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='10'>Refer this doc for how the report calculates various units with different expiry dates:</run>
              <run>Æ&#10;</run>
              <run auto-url='true' fontcolor='#4996b2' fontname='Helvetica Neue' fontsize='10' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/spreadsheets/d/174AvsF0A72sYM9NA2TWpMEjkh2f8ppXWpDYCvLlQOFc/edit#gid=244958244&amp;quot;' underline='true'>https://docs.google.com/spreadsheets/d/174AvsF0A72sYM9NA2TWpMEjkh2f8ppXWpDYCvLlQOFc/edit#gid=244958244</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='10'>Refer this doc for expiry related data for stores that adopted LBI V2</run>
              <run>Æ&#10;</run>
              <run auto-url='true' fontcolor='#ffffff' fontname='Helvetica Neue' fontsize='10' hyperlink='tabdoc:load-url url=&amp;quot;https://lookerstudio.google.com/u/0/reporting/f5bdc4cc-2636-4025-a1a4-3571b1ab0804/page/BY1zD&amp;quot;'>https://lookerstudio.google.com/u/0/reporting/f5bdc4cc-2636-4025-a1a4-3571b1ab0804/page/BY1zD</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#666666' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#666666' />
            </zone-style>
          </zone>
          <zone-style>
