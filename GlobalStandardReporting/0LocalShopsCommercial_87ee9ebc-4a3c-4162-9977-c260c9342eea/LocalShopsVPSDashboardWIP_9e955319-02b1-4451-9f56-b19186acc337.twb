      <column caption='Avg Offline Rate' datatype='real' name='[Calculation_5998724358977069080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(1-[vendor_online_rate])' />
      </column>
      <column caption='# Total' datatype='integer' name='[Calculation_5998724359007277083]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [is_online] THEN [Calculation_5998724359067594799] ELSE NULL END)' />
      </column>
      <column caption='# Delisted' datatype='integer' name='[Calculation_5998724359022534687]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF( LOOKUP([Calculation_5998724359007277083], -1) - [Calculation_5998724359007277083] + [# Zombie (copy)_5998724359019905053]) &lt; 0 THEN 0&#10;ELSE (LOOKUP([Calculation_5998724359007277083], -1) - [Calculation_5998724359007277083] + [# Zombie (copy)_5998724359019905053])  &#10;END'>
          <table-calc level-address='[federated.1k4jxp40mhzs9n11t11zh0p5f037].[mn:report_month:ok]' ordering-field='[federated.1k4jxp40mhzs9n11t11zh0p5f037].[report_month]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Month Year' datatype='string' name='[Calculation_5998724359028228129]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[report_month])+&apos; &apos;+DATENAME(&apos;year&apos;,[report_month])' />
      </column>
      <column caption='Label' datatype='string' name='[Calculation_5998724359029264418]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;# Online Vendors&apos;' />
      </column>
      <column caption='Avg Score - mCVR3 v1' datatype='real' name='[Calculation_5998724359042748452]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([score_mcvr3_v1])' />
      </column>
      <column caption='Avg Score - M1 Retention v1' datatype='real' name='[Calculation_5998724359042916389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([score_m1_retention_v1])' />
      </column>
      <column caption='Avg Score - GMV Loss OOS v1' datatype='real' name='[Calculation_5998724359043092518]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([score_gmv_lost_oos_v1])' />
      </column>
      <column caption='Avg Score - Offline Rate v1' datatype='real' name='[Calculation_5998724359044284455]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([score_offline_rate_v1])' />
      </column>
      <column caption='Avg Score - % Items Not Delivered v1' datatype='real' name='[Calculation_5998724359044427816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([score_perc_items_not_delivered_v1])' />
      </column>
      <column caption='Avg Score - Vendor Fail Rate v1' datatype='real' name='[Calculation_5998724359044591657]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([score_vfr_v1])' />
      </column>
      <column caption='VPS Components' datatype='real' name='[Calculation_5998724359049064490]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_96475568855961608])' />
      </column>
      <column caption='Avg Vendor Online Rate' datatype='real' name='[Calculation_5998724359051542571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([vendor_online_rate])' />
      </column>
      <column caption='Avg Score' datatype='real' name='[Calculation_5998724359061458988]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_3573043383090786316])' />
      </column>
      <column caption='Avg Metric' datatype='real' name='[Calculation_5998724359061860397]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([metric_value])' />
      </column>
      <column caption='# Total Online Vendors' datatype='integer' name='[Calculation_5998724359067451438]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [is_online] THEN [Calculation_5998724359067594799] ELSE NULL END)' />
      </column>
      <column caption='Global Unique Vendor ID' datatype='string' name='[Calculation_5998724359067594799]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[global_entity_id]+[platform_vendor_id]' />
      </column>
      <column caption='GMV (Euro)' datatype='real' name='[Calculation_5998724359075381296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([gmv_eur] / 6)' />
      </column>
      <column caption='Global' datatype='string' name='[Calculation_96475567089090561]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Global&quot;' />
      </column>
      <column caption='GMV / Vendor' datatype='real' name='[Calculation_96475568808148995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [successful_orders] &gt; 0 THEN [gmv_eur 1] END)' />
      </column>
      <column caption='% Zombie' datatype='real' name='[Calculation_96475568808910853]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[# Total Online Vendors (copy)_5998724359019638812] / [Calculation_5998724359007277083]' />
      </column>
      <column caption='Input Metric' datatype='real' name='[Calculation_96475568855961608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] &#10;WHEN  &apos;mCVR3&apos; THEN [mcvr3]&#10;WHEN  &apos;M1 Retention&apos; THEN [m1_retention]&#10;WHEN &apos;Vendor Fail Rate&apos; THEN [fail_rate_vendor]&#10;WHEN &apos;% Items Not Delivered&apos; THEN [perc_items_not_delivered]&#10;WHEN &apos;% OOS GMV Loss&apos; THEN [gmv_lost_oos_percent]&#10;WHEN &apos;Online Rate&apos; THEN [vendor_online_rate]&#10;WHEN &apos;VPS v1&apos; THEN [vps_v1 1]&#10;WHEN &apos;VPS including zombies v1&apos; THEN [vps_including_zombies_v1 1]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='unused Avg. Score Value (Adjusted)' datatype='real' name='[Calculation_96475569179430927]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_96475569201070096])' />
      </column>
      <column caption='unused Score Value (Adjusted)' datatype='real' name='[Calculation_96475569201070096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_pelican] = TRUE AND [score_component]=&apos;weighted_score_gmv_lost_oos_v1&apos; THEN 0&#10;ELSEIF [is_pelican] = FALSE AND [score_component]=&apos;weighted_score_perc_items_not_delivered_v1&apos; THEN 0&#10;ELSE [score_value]&#10;END' />
      </column>
      <column caption='Vendor Count' datatype='integer' name='[Calculation_96475569203101713]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_name])' />
      </column>
      <column caption='Dimension 1' datatype='string' name='[Calculation_96475569209118739]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Avg VPS v1' datatype='real' name='[Calculation_96475569214062613]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([vps_v1])' />
      </column>
      <column caption='Dimension 1 (Deep-Dive By 2 Dimensions)' datatype='string' name='[Dimension 1 (copy)_3573043383012032518]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Dimension 1 (copy)_3573043383008927748]&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Dimension 2' datatype='string' name='[Dimension 1 (copy)_96475569211093012]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Drill Down By (1) (copy)_96475569208922130]&#10;WHEN &apos;Vertical&apos; THEN [vertical]&#10;WHEN &apos;Vertical Segment&apos; THEN [vertical_segment]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Dimension 2 (Deep-Dive By 2 Dimensions)' datatype='string' name='[Dimension 2 (copy)_3573043383013277703]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Dimension 2 (Deep-Dive By 2 Dimensions) (copy)_3573043383010799621]&#10;WHEN &apos;Vertical&apos; THEN [vertical]&#10;WHEN &apos;Vertical Segment&apos; THEN [vertical_segment]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='VPS Components / KPIs' datatype='real' name='[KPIs (copy)_2157857566459785222]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Select VPS Component (copy)_2157857566459015173]&#10;WHEN  &apos;% 0-order Vendor Share&apos; THEN [Calculation_96475568808910853]&#10;WHEN  &apos;GMV&apos; THEN SUM([gmv_eur 1])&#10;WHEN &apos;Orders&apos; THEN SUM([successful_orders])&#10;WHEN &apos;GMV / Vendor&apos; THEN [Calculation_96475568808148995]&#10;WHEN &apos;Take-in per order&apos; THEN AVG([take_in_per_order_eur])&#10;WHEN  &apos;mCVR3&apos; THEN AVG([mcvr3])&#10;WHEN  &apos;M1 Retention&apos; THEN AVG([m1_retention])&#10;WHEN &apos;Vendor Fail Rate&apos; THEN AVG([fail_rate_vendor])&#10;WHEN &apos;% Items Not Delivered&apos; THEN AVG([perc_items_not_delivered])&#10;WHEN &apos;% OOS GMV Loss&apos; THEN AVG([gmv_lost_oos_percent])&#10;WHEN &apos;Online Rate&apos; THEN AVG([vendor_online_rate])&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Max VPS v1' datatype='real' name='[Min VPS v1 (copy)_2157857566376808450]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([vps_v1])' />
      </column>
      <column caption='KPIs' datatype='real' name='[Output Metric (Non-Aggregated) (copy)_96475569114349578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Select Output Metric (copy)_96475569115631628] &#10;WHEN  &apos;% 0-order Vendor Share&apos; THEN [Calculation_96475568808910853]&#10;WHEN  &apos;GMV&apos; THEN SUM([gmv_eur 1])&#10;WHEN &apos;Orders&apos; THEN SUM([successful_orders])&#10;WHEN &apos;GMV / Vendor&apos; THEN [Calculation_96475568808148995]&#10;WHEN &apos;Take-in per order&apos; THEN AVG([take_in_per_order_eur])&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='zzVPS v1 Percentiles 2' datatype='real' name='[VPS v1 Percentiles 1 (copy)_1659154276384145410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [vps_cluster_10_per_vertical_v1] = &quot;bottom 10%&quot; &#10;//WHEN &quot;bottom 10%&quot; THEN MAX([Vps V1])&#10;THEN MAX([vps_v1])&#10;//WHEN &apos;middle 80%&apos; THEN AVG([Vps V1])&#10;//WHEN &quot;top 10%&quot; THEN MIN([Vps V1])&#10;END' />
      </column>
