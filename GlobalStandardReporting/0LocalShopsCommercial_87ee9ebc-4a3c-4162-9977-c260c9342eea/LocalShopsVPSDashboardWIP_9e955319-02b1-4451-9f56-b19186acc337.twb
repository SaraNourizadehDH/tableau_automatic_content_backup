    <worksheet name='download (vertical)'>
      <table>
        <view>
          <datasources>
            <datasource caption='_lsba_vps_stg_monthly (local_shops_analytics)' name='federated.0f2g1i31kz1zg51bncnp805rlg3x' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Vertical or Vertical Segment' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vertical&quot;'>
              <calculation class='tableau' formula='&quot;Vertical&quot;' />
            </column>
            <column caption='Select KPI for download' datatype='string' name='[Select VPS Component / KPI (copy)_4481855720513757186]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Total Online Vendors&quot;'>
              <calculation class='tableau' formula='&quot;# Total Online Vendors&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0f2g1i31kz1zg51bncnp805rlg3x'>
            <column caption='# Zombie' datatype='integer' name='[# Total Online Vendors (copy)_5998724359019638812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [is_zombie] AND [is_online]&#10;   THEN [Calculation_5998724359021813790] ELSE NULL END)' />
            </column>
            <column caption='Vertical / Vertical Segment' datatype='string' name='[Calculation_4481855720511356928]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;Vertical&apos; THEN [vertical]&#10;WHEN &apos;Vertical Segment&apos; THEN [vertical_segment]&#10;ELSE NULL &#10;END' />
            </column>
            <column caption='# Total' datatype='integer' name='[Calculation_5998724359007277083]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [is_online] THEN [Calculation_5998724359021813790] ELSE NULL END)' />
            </column>
            <column caption='Global Unique Vendor ID' datatype='string' name='[Calculation_5998724359021813790]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]+[platform_vendor_id]' />
            </column>
            <column caption='# Total Online Vendors' datatype='integer' name='[Calculation_5998724359067451438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [is_online] THEN [Calculation_5998724359021813790] ELSE NULL END)' />
            </column>
            <column caption='GMV / Vendor' datatype='real' name='[Calculation_96475568808148995]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [successful_orders] &gt; 0 THEN [gmv_eur] END)' />
            </column>
            <column caption='% Zombie' datatype='real' name='[Calculation_96475568808910853]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Total Online Vendors (copy)_5998724359019638812] / [Calculation_5998724359007277083]' />
            </column>
            <column caption='KPI for download' datatype='real' name='[KPIs (copy)_4481855720512528385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Select VPS Component / KPI (copy)_4481855720513757186]&#10;WHEN  &apos;% 0-order Vendor Share&apos; THEN [Calculation_96475568808910853]&#10;WHEN  &apos;GMV&apos; THEN SUM([gmv_eur])&#10;WHEN &apos;Orders&apos; THEN SUM([successful_orders])&#10;WHEN &apos;GMV / Vendor&apos; THEN [Calculation_96475568808148995]&#10;WHEN &apos;Take-in per order&apos; THEN AVG([take_in_per_order_eur])&#10;WHEN  &apos;mCVR3&apos; THEN AVG([mcvr3])&#10;WHEN  &apos;M1 Retention&apos; THEN AVG([m1_retention])&#10;WHEN &apos;Vendor Fail Rate&apos; THEN AVG([fail_rate_vendor])&#10;WHEN &apos;% Items Not Delivered&apos; THEN AVG([perc_items_not_delivered])&#10;WHEN &apos;% OOS GMV Loss&apos; THEN AVG([gmv_lost_oos_percent])&#10;WHEN &apos;Online Rate&apos; THEN AVG([vendor_online_rate])&#10;WHEN &apos;# Total Online Vendors&apos; THEN ([Calculation_5998724359067451438])&#10;WHEN &apos;VPS&apos; THEN AVG([vps_v1])&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='AM Contact Email' datatype='string' name='[am_contact_email]' role='dimension' type='nominal' />
            <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Fail Rate Vendor' datatype='real' name='[fail_rate_vendor]' role='measure' type='quantitative' />
            <column caption='Global Entity ID' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Gmv Eur' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column caption='Gmv Lost Oos Percent' datatype='real' name='[gmv_lost_oos_percent]' role='measure' type='quantitative' />
            <column caption='Is AAA' datatype='boolean' name='[is_aaa]' role='dimension' type='nominal' />
            <column caption='Is Online' datatype='boolean' name='[is_online]' role='dimension' type='nominal' />
