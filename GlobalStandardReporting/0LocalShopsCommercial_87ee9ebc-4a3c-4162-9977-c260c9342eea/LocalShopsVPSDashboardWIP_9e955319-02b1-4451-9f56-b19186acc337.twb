    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='VPS Overview'>
      <repository-location id='VPSOverview' path='/t/GlobalStandardReporting/workbooks/Local_Shops_VPS_DashboardWIP' revision='' site='GlobalStandardReporting' />
      <layout-options>
        <title>
          <formatted-text>
            <run>Local Shops - Vendor Performance Score (VPS) Overview</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='dash-title'>
          <format attr='text-align' value='center' />
        </style-rule>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_219' value='center' />
          <format attr='vertical-align' id='dash-text_219' value='bottom' />
        </style-rule>
        <style-rule element='parameter-ctrl'>
          <format attr='background-color' value='#f5f5f5' />
        </style-rule>
        <style-rule element='parameter-ctrl-title'>
          <format attr='text-align' value='center' />
        </style-rule>
      </style>
      <size maxheight='3500' maxwidth='1366' minheight='3500' minwidth='1366' preset-index='0' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='_lsba_vps_stg_monthly (local_shops_analytics)' name='federated.0f2g1i31kz1zg51bncnp805rlg3x' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Select VPS Component' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;VPS v1&quot;'>
          <calculation class='tableau' formula='&quot;VPS v1&quot;' />
          <members>
            <member value='&quot;mCVR3&quot;' />
            <member value='&quot;M1 Retention&quot;' />
            <member value='&quot;Vendor Fail Rate&quot;' />
            <member value='&quot;\% Items Not Delivered&quot;' />
            <member value='&quot;\% OOS GMV Loss&quot;' />
            <member value='&quot;Online Rate&quot;' />
            <member value='&quot;VPS v1&quot;' />
            <member value='&quot;VPS including zombies v1&quot;' />
          </members>
        </column>
        <column caption='Select KPI' datatype='string' name='[Select Output Metric (copy)_96475569115631628]' param-domain-type='list' role='measure' type='nominal' value='&quot;GMV&quot;'>
          <calculation class='tableau' formula='&quot;GMV&quot;' />
          <members>
            <member value='&quot;GMV&quot;' />
            <member value='&quot;Orders&quot;' />
            <member value='&quot;GMV / Vendor&quot;' />
            <member value='&quot;Take-in per order&quot;' />
            <member value='&quot;\% 0-order Vendor Share&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0f2g1i31kz1zg51bncnp805rlg3x'>
        <column caption='AM Contact Email' datatype='string' name='[am_contact_email]' role='dimension' type='nominal' />
        <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
        <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column caption='Is AAA' datatype='boolean' name='[is_aaa]' role='dimension' type='nominal' />
