    <worksheet name='_backup By 2 Dimensions &amp; Percentiles '>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_lsba_vps_breakdown_monthly (local_shops_analytics)' name='federated.1k4jxp40mhzs9n11t11zh0p5f037' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension 2' datatype='string' name='[Drill Down By (1) (copy)_96475569208922130]' param-domain-type='list' role='measure' type='nominal' value='&quot;Vertical&quot;'>
              <calculation class='tableau' formula='&quot;Vertical&quot;' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1k4jxp40mhzs9n11t11zh0p5f037'>
            <column caption='Med VPS v1' datatype='real' name='[Avg VPS v1 (copy)_2157857566373658624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_MEDIAN(AVG([vps_v1]),0,0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Min VPS v1' datatype='real' name='[Avg VPS v1 (copy)_2157857566374318081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN([vps_v1])' />
            </column>
            <column caption='unused Avg. Score Value (Adjusted)' datatype='real' name='[Calculation_96475569179430927]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_96475569201070096])' />
            </column>
            <column caption='unused Score Value (Adjusted)' datatype='real' name='[Calculation_96475569201070096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_pelican] = TRUE AND [score_component]=&apos;weighted_score_gmv_lost_oos_v1&apos; THEN 0&#10;ELSEIF [is_pelican] = FALSE AND [score_component]=&apos;weighted_score_perc_items_not_delivered_v1&apos; THEN 0&#10;ELSE [score_value]&#10;END' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Calculation_96475569209118739]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Avg VPS v1' datatype='real' name='[Calculation_96475569214062613]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([vps_v1])' />
            </column>
            <column caption='Dimension 2' datatype='string' name='[Dimension 1 (copy)_96475569211093012]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Drill Down By (1) (copy)_96475569208922130]&#10;WHEN &apos;Vertical&apos; THEN [vertical]&#10;WHEN &apos;Vertical Segment&apos; THEN [vertical_segment]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Max VPS v1' datatype='real' name='[Min VPS v1 (copy)_2157857566376808450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([vps_v1])' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
            <column caption='Is Pelican' datatype='boolean' name='[is_pelican]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_zombie]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
