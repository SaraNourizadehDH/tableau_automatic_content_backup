              <zone forceUpdate='true' h='10812' id='34' type-v2='text' w='98814' x='593' y='7313'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='14'>L3 Buyable Rate Deepdive Opportunity Gap</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000'>This page helps you identify and visualize opportunity gaps by comparing a vendor&apos;s product assortment against the top-selling items across the entire chain. </run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000'>Use this data to pinpoint high-demand products a vendor is missing and make data-driven recommendations to close the gap.</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000'>Filters- </run>
                  <run fontcolor='#000000'>Use the filters for </run>
                  <run bold='true' fontcolor='#4e79a7'>Date</run>
                  <run fontcolor='#4e79a7'>, </run>
                  <run bold='true' fontcolor='#cc3922'>Chain</run>
                  <run bold='true' fontcolor='#4e79a7'>,Country</run>
                  <run fontcolor='#4e79a7'>, </run>
                  <run bold='true' fontcolor='#4e79a7'>Chain</run>
                  <run fontcolor='#4e79a7'>, </run>
                  <run bold='true' fontcolor='#4e79a7'>Vendor</run>
                  <run fontcolor='#4e79a7'>Æ </run>
                  <run fontcolor='#000000'>to begin your analysis.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000'>To instantly find products to recommend, use the filter vendor_has_sku set to FALSE</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000'>It is better to select a single vendor, on the Platform Vendor Id Filter.</run>
                  <run>Æ&#10;</run>
                  <run fontsize='8'>* SkU is active vendor=  Indicates whether the specific vendor marked the product as active for the given month.&quot;</run>
                </formatted-text>
