        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &quot;Orders&quot; THEN STR(INT([orders]))&#10;  WHEN &quot;Fresh GPV Contribution %&quot; THEN STR(ROUND([f_gpv_share]*100, 1)) + &quot;%&quot;&#10;  WHEN &quot;Buyable Rate&quot; THEN STR(ROUND([weighted_availability]*100, 1)) + &quot;%&quot;&#10;&#10;END' />
