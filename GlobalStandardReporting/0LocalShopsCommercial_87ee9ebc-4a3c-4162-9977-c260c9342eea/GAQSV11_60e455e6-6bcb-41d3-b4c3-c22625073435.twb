        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Average Active SKUs&quot; THEN [avg_active_skus_per_hour]&#10;WHEN &quot;Buyable Rate&quot; THEN [weighted_availability]&#10;WHEN &quot;L3 Category Coverage %&quot; THEN [level_three_compliant_share]&#10;WHEN &quot;Minimum SKU Compliance %&quot; THEN [level_one_compliant_share]&#10;WHEN &quot;Ultra Fresh GPV Contribution %&quot; THEN [uf_gpv_share]&#10;WHEN &quot;Fresh GPV Contribution %&quot; THEN [f_gpv_share]&#10;WHEN &quot;GAQS&quot; THEN [gaqs]&#10;WHEN &quot;Sessions&quot; THEN [shop_details_loaded]&#10;WHEN &quot;mCVR3&quot; THEN [mCVR3]&#10;WHEN &quot;Orders&quot; THEN [orders]&#10;&#10;WHEN &quot;GMV (€)&quot; THEN [amt_gmv_eur]&#10;WHEN &quot;GPV (€)&quot; THEN [gpv_eur]&#10;WHEN &quot;ABV (GMV €)&quot; THEN [abv_gmv]&#10;END' />
