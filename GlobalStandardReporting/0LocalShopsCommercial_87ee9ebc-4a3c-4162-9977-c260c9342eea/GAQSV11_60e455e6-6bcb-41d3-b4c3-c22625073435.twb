          <zone forceUpdate='true' h='16437' id='34' type-v2='text' w='98814' x='593' y='7188'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='14'>Category Deepdive Table (L0 &amp; L1)</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>This page provides a comprehensive analysis of category availability and compliance across Level 0 and Level 1 for each country, chain, or vendor.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>To begin:</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Select the </run>
              <run bold='true' fontcolor='#4e79a7'>date</run>
              <run fontcolor='#000000'>, </run>
              <run bold='true' fontcolor='#4e79a7'>entity</run>
              <run fontcolor='#000000'>, </run>
              <run bold='true' fontcolor='#4e79a7'>country</run>
              <run fontcolor='#000000'>, and </run>
              <run bold='true' fontcolor='#4e79a7'>chain</run>
              <run fontcolor='#000000'> of interest.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>Choose the </run>
              <run bold='true' fontcolor='#499894'>granularity</run>
              <run fontcolor='#000000'> level you’d like to analyze —</run>
              <run fontcolor='#b4b4b4' fontsize='8' italic='true'>Æ </run>
              <run fontcolor='#898989' fontsize='8' italic='true'>chain </run>
              <run fontcolor='#898989' fontsize='8'>or </run>
              <run fontcolor='#898989' fontsize='8' italic='true'>vendor</run>
              <run fontcolor='#898989' fontsize='8'> and </run>
              <run fontcolor='#898989' fontsize='8' italic='true'>Level 0</run>
              <run fontcolor='#898989' fontsize='8'> or </run>
              <run fontcolor='#898989' fontsize='8' italic='true'>Level 1</run>
              <run fontcolor='#898989' fontsize='8'>.</run>
              <run>Æ&#10;</run>
              <run>---------------------------------------------------------------------------------------------------------------</run>
              <run>Æ&#10;</run>
              <run>Note on targets</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>- Level 0</run>
              <run fontcolor='#000000'> focuses on </run>
              <run bold='true' fontcolor='#000000'>Share Over Total GPV</run>
              <run fontcolor='#000000'> — target values are applied accordingly.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000'>- Level 1</run>
              <run fontcolor='#000000'> evaluates </run>
              <run bold='true' fontcolor='#000000'>Minimum Average Active SKUs</run>
              <run fontcolor='#000000'> as the compliance benchmark .</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000'>⚠ Target columns are displayed separately. Based on your selected level, only the relevant target fields will be populated.</run>
              <run>Æ&#10;</run>
              <run>For Level 0 there are targets defined on Share Over Total GPV.</run>
              <run>Æ&#10;</run>
              <run>For Level 1 there are targets defined on Min. Avg. Active SKUs</run>
              <run>Æ&#10;</run>
              <run>The targets columns are sepated so depending on the user choice, the column will be filled with data or not</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f5f5f5' />
            </zone-style>
          </zone>
          <zone h='3750' id='425' mode='checkdropdown' name='L0 &amp; L1-Category - Deep Dive' param='[federated.1juhps71i6rysq1d3wh4m0yxz5qb].[none:is_online:nk]' show-apply='true' type-v2='filter' values='database' w='11852' x='50074' y='27375'>
