          <zone forceUpdate='true' h='7937' id='34' type-v2='text' w='98814' x='593' y='7313'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='14'>L3 Category Deepdive Table</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Tableau Light'>This dashboard provides an in-depth look at L3 category availability within each country and the corresponding compliance at the chain level. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333' fontname='Tableau Light'>To begin your analysis, make sure to choose the </run>
              <run bold='true' fontcolor='#4e79a7' fontname='Tableau Light'>date,</run>
              <run bold='true' fontcolor='#333333' fontname='Tableau Light'>Æ </run>
              <run bold='true' fontcolor='#4e79a7' fontname='Tableau Light'>entity &amp; chain</run>
              <run bold='true' fontcolor='#333333' fontname='Tableau Light'> you want to analyze and then select the desired </run>
              <run bold='true' fontcolor='#4e79a7' fontname='Tableau Light'>month&amp;year</run>
              <run bold='true' fontcolor='#333333' fontname='Tableau Light'>.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333' fontname='Tableau Light'>Compliance= at least 1 active SKU in the L3 category being analyzed.</run>
              <run>Æ&#10;</run>
            </formatted-text>
