          <datasource-dependencies datasource='federated.1e6eaar00boch717mm1il1gg8i7l'>
            <column caption='Entity Meets KPI Tresholds' datatype='boolean' name='[Calculation_1807069389987176574]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF&#10;  { FIXED [global_entity_id] :&#10;     MAX(IF [kpi_name] = &apos;leads_excl_dupl_drop_reasons&apos; THEN [mean_l6w] END) } &gt;= 10&#10;AND&#10;  { FIXED [global_entity_id] :&#10;     MAX(IF [kpi_name] = &apos;ssu_completed&apos; THEN [mean_l6w] END) } &gt;= 3&#10;THEN&#10;  TRUE&#10;ELSE&#10;  FALSE&#10;END' />
            </column>
            <column caption='Is Relevant KPI' datatype='boolean' name='[Calculation_8218928621606494235]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [kpi_type] =&apos;delta_vs_l6w&apos; &#10;and ([diff_from_mean_pct] &gt; 0 &#10;or isnull(diff_from_mean_pct) )&#10;&#10;&#10;then false &#10;&#10;elseif [kpi_name] = &apos;Leads Without QC after SSU (% of SSU Completions)&apos; &#10;and [global_entity_id] in (&apos;GV_UA&apos;,&apos;GV_ME&apos;,&apos;GV_GE&apos;,&apos;GV_KZ&apos;,&apos;FP_MM&apos;,&apos;FP_KH&apos;, &#10;&apos;EF_GR&apos;,&apos;TB_IQ&apos;,&apos;FP_LA&apos;)&#10;&#10;then false &#10;&#10;else true&#10;end' />
            </column>
