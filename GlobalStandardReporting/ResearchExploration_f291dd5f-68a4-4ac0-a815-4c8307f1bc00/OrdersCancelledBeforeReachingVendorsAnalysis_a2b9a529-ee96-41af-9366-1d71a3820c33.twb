      <aliases enabled='yes' />
      <column caption='Date' datatype='datetime' name='[Calculation_851391489569665024]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN DATETRUNC(&apos;day&apos;, [created_date_local])&#10;WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;, [created_date_local], &apos;Monday&apos;)&#10;END' />
      </column>
      <column caption='Fail Rate' datatype='real' name='[Calculation_851391489571430401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cancelled_orders])/SUM([orders])' />
      </column>
      <column caption='Rider Not Found Fail Rate' datatype='real' name='[Calculation_851391489571803139]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cancelled_orders_rider_not_found])/SUM([orders])' />
      </column>
      <column caption='Non-Vendor Fail Rate' datatype='real' name='[Fail Rate (copy)_851391489571717122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cancelled_by_non_vendor_orders])/SUM([orders])' />
      </column>
      <column caption='Customer (&lt;3 mins) Fail Rate' datatype='real' name='[Rider Not Found Fail Rate (copy)_851391489572446212]' role='measure' type='quantitative'>
