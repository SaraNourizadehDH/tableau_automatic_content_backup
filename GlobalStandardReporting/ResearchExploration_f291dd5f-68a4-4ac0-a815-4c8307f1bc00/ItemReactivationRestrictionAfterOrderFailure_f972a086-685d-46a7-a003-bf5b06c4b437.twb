          <datasource-dependencies datasource='Parameters'>
            <column caption='Contact Type' datatype='string' name='[Fail Rate Type (copy)_451767338535251969]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
