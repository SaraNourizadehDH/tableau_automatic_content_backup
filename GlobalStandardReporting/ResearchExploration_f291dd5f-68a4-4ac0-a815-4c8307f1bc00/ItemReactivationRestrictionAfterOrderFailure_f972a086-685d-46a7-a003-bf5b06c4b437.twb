    <worksheet name='Divergence: Vendor Fail Rate'>
      <table>
        <view>
          <datasources>
            <datasource caption='item_reactivation_restriction_experiment+ (Multiple Connections)' name='federated.0avovu313mepku17fub050f8m1qt' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0avovu313mepku17fub050f8m1qt'>
            <column caption='Date Type' datatype='string' name='[Calculation_212795146001440769]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date_local]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date_local]))+&quot;-W&quot;+STR(ISOWEEK([created_date_local]))&#10;END' />
            </column>
            <column caption='Vendor Fail Rate' datatype='real' name='[Offline Duration % (copy)_212795146002759682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='Vendor Fail Rate Divergence (Pre vs Post Rollouts)' datatype='real' name='[Offline Duration % Divergence (Pre vs Post Rollouts) (copy)_212795146003185669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        (SUM(IF [rollout_phase] != &apos;Pre-Rollout&apos; AND [experiment_group] = &apos;Variant&apos; THEN [vendor_failed_orders] END)/SUM(IF [rollout_phase] != &apos;Pre-Rollout&apos; AND [experiment_group] = &apos;Variant&apos; THEN [orders] END)) &#10;        /&#10;        (SUM(IF [rollout_phase] != &apos;Pre-Rollout&apos; AND [experiment_group] = &apos;Baseline&apos; THEN [vendor_failed_orders] END)/SUM(IF [rollout_phase] != &apos;Pre-Rollout&apos; AND [experiment_group] = &apos;Baseline&apos; THEN [orders] END))&#10;    )&#10;    - 1&#10;)&#10;-&#10;(&#10;    (&#10;        (SUM(IF [rollout_phase] = &apos;Pre-Rollout&apos; AND [experiment_group] = &apos;Variant&apos; THEN [vendor_failed_orders] END)/SUM(IF [rollout_phase] = &apos;Pre-Rollout&apos; AND [experiment_group] = &apos;Variant&apos; THEN [orders] END)) &#10;        /&#10;        (SUM(IF [rollout_phase] = &apos;Pre-Rollout&apos; AND [experiment_group] = &apos;Baseline&apos; THEN [vendor_failed_orders] END)/SUM(IF [rollout_phase] = &apos;Pre-Rollout&apos; AND [experiment_group] = &apos;Baseline&apos; THEN [orders] END))&#10;    )&#10;    - 1&#10;)' />
            </column>
            <column caption='Vendor Fail Rate Divergence' datatype='real' name='[Vendor Fail Rate Divergence Variant A (Pre vs Post Rollouts) (copy)_212795146105204847]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (SUM(IF [experiment_group] != &apos;Baseline&apos; THEN [vendor_failed_orders] END)/SUM(IF [experiment_group] != &apos;Baseline&apos; THEN [orders] END)) &#10;    /&#10;    (SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [vendor_failed_orders] END)/SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END))&#10;)&#10;- 1' />
            </column>
            <column caption='Item Unavailable Vendor Fail Rate Divergence (Pre vs Post Rollouts)' datatype='real' name='[Vendor Fail Rate Divergence Variant A (Pre vs Post Rollouts) (copy)_665266172512354305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        (SUM(IF [rollout_phase] != &apos;Pre-Rollout&apos; AND [experiment_group] = &apos;Variant&apos; THEN [item_unavailable_vendor_failed_orders] END)/SUM(IF [rollout_phase] != &apos;Pre-Rollout&apos; AND [experiment_group] = &apos;Variant&apos; THEN [orders] END)) &#10;        /&#10;        (SUM(IF [rollout_phase] != &apos;Pre-Rollout&apos; AND [experiment_group] = &apos;Baseline&apos; THEN [item_unavailable_vendor_failed_orders] END)/SUM(IF [rollout_phase] != &apos;Pre-Rollout&apos; AND [experiment_group] = &apos;Baseline&apos; THEN [orders] END))&#10;    )&#10;    - 1&#10;)&#10;-&#10;(&#10;    (&#10;        (SUM(IF [rollout_phase] = &apos;Pre-Rollout&apos; AND [experiment_group] = &apos;Variant&apos; THEN [item_unavailable_vendor_failed_orders] END)/SUM(IF [rollout_phase] = &apos;Pre-Rollout&apos; AND [experiment_group] = &apos;Variant&apos; THEN [orders] END)) &#10;        /&#10;        (SUM(IF [rollout_phase] = &apos;Pre-Rollout&apos; AND [experiment_group] = &apos;Baseline&apos; THEN [item_unavailable_vendor_failed_orders] END)/SUM(IF [rollout_phase] = &apos;Pre-Rollout&apos; AND [experiment_group] = &apos;Baseline&apos; THEN [orders] END))&#10;    )&#10;    - 1&#10;)' />
            </column>
            <column caption='Item Set Unavailable For The Day Events Divergence (Pre vs Post Rollouts)' datatype='real' name='[Vendor Fail Rate Divergence Variant A (Pre vs Post Rollouts) (copy)_665266172514615302]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (&#10;        SUM(IF [rollout_phase] != &apos;Pre-Rollout&apos; AND [experiment_group] = &apos;Variant&apos; THEN [order_product_set_availability_events] END)&#10;        /&#10;        SUM(IF [rollout_phase] != &apos;Pre-Rollout&apos; AND [experiment_group] = &apos;Baseline&apos; THEN [order_product_set_availability_events] END)&#10;    )&#10;    - 1&#10;)&#10;-&#10;(&#10;    (&#10;        SUM(IF [rollout_phase] = &apos;Pre-Rollout&apos; AND [experiment_group] = &apos;Variant&apos; THEN [order_product_set_availability_events] END)&#10;        /&#10;        SUM(IF [rollout_phase] = &apos;Pre-Rollout&apos; AND [experiment_group] = &apos;Baseline&apos; THEN [order_product_set_availability_events] END)&#10;    )&#10;    - 1&#10;)' />
            </column>
