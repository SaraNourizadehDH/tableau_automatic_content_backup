            <column caption='Day / Start Day (Week, Month, Quarter)' datatype='datetime' name='[Calculation_3453486913477947392]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN DATETRUNC(&apos;day&apos;, [created_date_local])&#10;WHEN &quot;Weekly&quot; THEN DATETRUNC(&apos;week&apos;, [created_date_local])&#10;WHEN &quot;Monthly&quot; THEN DATETRUNC(&apos;month&apos;, [created_date_local])&#10;WHEN &quot;Quarterly&quot; THEN DATETRUNC(&apos;quarter&apos;, [created_date_local])&#10;END' />
