      <aliases enabled='yes' />
      <column caption='Orders per Vendor' datatype='integer' name='[Calculation_188869771538771968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [region], [entity_id], [vendor_grade], [vendor_code]: SUM([orders])}' />
      </column>
      <column caption='Food Is Ready %' datatype='real' name='[Calculation_212724775493435392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Orders per Vendor (copy)_188869771538821121])/SUM([Calculation_188869771538771968])' />
      </column>
      <column caption='Food Is Ready Points' datatype='integer' name='[Calculation_212724775493672961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[orders_food_is_ready] * 5' />
      </column>
      <column caption='Daily Challenges Points' datatype='integer' name='[Calculation_212724775493906434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(RANDOM() * 7) * INT(RANDOM() * 3) * 5' />
      </column>
      <column caption='Weekly Challenges Points' datatype='integer' name='[Calculation_212724775494057987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(IF RANDOM() &gt; 0.5 THEN 1 ELSE 0 END) * 20' />
      </column>
      <column caption='Performance Points' datatype='integer' name='[Calculation_212724775494418436]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(RANDOM() * 7) * 5' />
      </column>
      <column caption='Check In Points' datatype='integer' name='[Calculation_212724775494582277]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(RANDOM() * 7) * 10' />
      </column>
      <column caption='Menu Review Points' datatype='integer' name='[Calculation_212724775494684678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(RANDOM() * 7) * 10' />
      </column>
      <column caption='Total Points' datatype='integer' name='[Calculation_212724775494815751]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_212724775494582277]&#10;+ [Calculation_212724775493906434]&#10;+ [Calculation_212724775494057987]&#10;+ [Calculation_212724775494684678]&#10;+ [Calculation_212724775494418436]&#10;+ [Calculation_212724775493672961]' />
      </column>
      <column caption='Total Points per Vendor' datatype='integer' name='[Calculation_212724775496417289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [region], [entity_id], [vendor_grade], [vendor_code]: SUM([Calculation_212724775494815751])}' />
      </column>
      <column caption='Points Percentiles' datatype='string' name='[Calculation_212724775496609802]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_212724775496417289] &lt;= {FIXED : PERCENTILE([Calculation_212724775496417289], 0.5)} THEN &quot;0-50th&quot;&#10;ELSEIF [Calculation_212724775496417289] &lt;= {FIXED : PERCENTILE([Calculation_212724775496417289], 0.75)} THEN &quot;50-75th&quot;&#10;ELSEIF [Calculation_212724775496417289] &lt;= {FIXED : PERCENTILE([Calculation_212724775496417289], 0.95)} THEN &quot;75-95th&quot;&#10;ELSEIF [Calculation_212724775496417289] &lt;= {FIXED : PERCENTILE([Calculation_212724775496417289], 0.99)} THEN &quot;95-99th&quot;&#10;ELSEIF [Calculation_212724775496417289] &gt; {FIXED : PERCENTILE([Calculation_212724775496417289], 0.99)} THEN &quot;99-100th&quot;&#10;END' />
      </column>
      <column caption='Total Vendors' datatype='integer' name='[Calculation_212724775497883659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_code])' />
      </column>
      <column caption='Orders Food Is Ready per Vendor' datatype='integer' name='[Orders per Vendor (copy)_188869771538821121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [region], [entity_id], [vendor_grade], [vendor_code]: SUM([orders_food_is_ready])}' />
      </column>
      <column caption='Points Buckets' datatype='string' name='[Points Percentiles (copy)_212724775514517518]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_212724775496417289] &lt;= 100 THEN &quot;0-100&quot;&#10;ELSEIF [Calculation_212724775496417289] &lt;= 500 THEN &quot;100-500&quot;&#10;ELSEIF [Calculation_212724775496417289] &lt;= 1000 THEN &quot;500-1000&quot;&#10;ELSEIF [Calculation_212724775496417289] &lt;= 5000 THEN &quot;1000-5000&quot;&#10;ELSEIF [Calculation_212724775496417289] &lt;= 10000 THEN &quot;5000-10000&quot;&#10;ELSEIF [Calculation_212724775496417289] &gt; 10000 THEN &quot;10000+&quot;&#10;END' />
      </column>
      <column aggregation='None' caption='Total Points (bin)' datatype='integer' name='[Total Points (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='3' formula='[Calculation_212724775494815751]' peg='0' size='1000' />
      </column>
