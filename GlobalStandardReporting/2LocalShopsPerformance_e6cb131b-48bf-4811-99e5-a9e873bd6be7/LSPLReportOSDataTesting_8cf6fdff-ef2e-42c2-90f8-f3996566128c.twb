                <zone h='7000' id='26' mode='radiolist' name='Summary P&amp;L (WS)' param='[federated.0t0wzzw111l10q172v3gc171wrl9].[none:granularity:nk]' show-all='false' show-apply='true' type-v2='filter' w='11260' x='36843' y='4200'>
