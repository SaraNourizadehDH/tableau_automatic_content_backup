            <column caption='Act MoM 2.06. Costs - Delivery Costs' datatype='real' default-format='*+0.00%;-0.00%;0.00%' name='[Calculation13]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;    SUM([act_delivery_costs]) &gt; LOOKUP(ZN(SUM([act_delivery_costs])), -1)&#13;&#10;    THEN&#13;&#10;    ABS(&#13;&#10;(ZN(SUM([act_delivery_costs])) - LOOKUP(ZN(SUM([act_delivery_costs])), -1)) / LOOKUP(ZN(SUM([act_delivery_costs])), -1)&#13;&#10;)&#13;&#10;    ELSE&#13;&#10;    -ABS(&#13;&#10;(ZN(SUM([act_delivery_costs])) - LOOKUP(ZN(SUM([act_delivery_costs])), -1)) / LOOKUP(ZN(SUM([act_delivery_costs])), -1)&#13;&#10;)&#13;&#10;END'>
