            <column caption='Row L1 ' datatype='string' name='[Row L1 (copy)_1670553987949858871]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Row L1 (copy)_1670553987947307060]&#13;&#10;    WHEN &quot;No Breakdown&quot; THEN &quot;&quot;&#13;&#10;    WHEN &quot;Segment&quot; THEN [segment]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country Name&quot; THEN [country_name]&#13;&#10;    WHEN &quot;Vertical Parent&quot; THEN [vertical_parent]&#13;&#10;    WHEN &quot;Vertical Type&quot; THEN [vertical_type]&#13;&#10;    WHEN &quot;AAA Chain Name Cleaned&quot; THEN [aaa_chain_name_cleaned]&#13;&#10;    WHEN &quot;Is AAA&quot; THEN STR([is_aaa])&#13;&#10;    WHEN &quot;Is AAA Supermarket&quot; THEN STR([is_aaa_supermarket])&#13;&#10;    WHEN &quot;Is Own Delivery&quot; THEN STR([is_own_delivery])&#13;&#10;    WHEN &quot;Report Month&quot; THEN LEFT(STR(DATENAME(&apos;month&apos;, [report_month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [report_month])),2)&#13;&#10;    WHEN &quot;Report Quarter&quot; THEN &quot;Q&quot; + LEFT(STR(DATENAME(&apos;quarter&apos;, [report_month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [report_month])),2)&#13;&#10;END' />
            </column>
            <column caption='Row L2 ' datatype='string' name='[Row L2 (copy)_1670553987949858872]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Row L2 (copy)_1670553987948711990]&#13;&#10;    WHEN &quot;No Breakdown&quot; THEN &quot;&quot;&#13;&#10;    WHEN &quot;Segment&quot; THEN [segment]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [management_entity]&#13;&#10;    WHEN &quot;Country Name&quot; THEN [country_name]&#13;&#10;    WHEN &quot;Vertical Parent&quot; THEN [vertical_parent]&#13;&#10;    WHEN &quot;Vertical Type&quot; THEN [vertical_type]&#13;&#10;    WHEN &quot;AAA Chain Name Cleaned&quot; THEN [aaa_chain_name_cleaned]&#13;&#10;    WHEN &quot;Is AAA&quot; THEN STR([is_aaa])&#13;&#10;    WHEN &quot;Is AAA Supermarket&quot; THEN STR([is_aaa_supermarket])&#13;&#10;    WHEN &quot;Is Own Delivery&quot; THEN STR([is_own_delivery])&#13;&#10;    WHEN &quot;Report Month&quot; THEN LEFT(STR(DATENAME(&apos;month&apos;, [report_month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [report_month])),2)&#13;&#10;    WHEN &quot;Report Quarter&quot; THEN &quot;Q&quot; + LEFT(STR(DATENAME(&apos;quarter&apos;, [report_month])),3) + &quot;&apos;&quot; + RIGHT(STR(DATEPART(&apos;year&apos;, [report_month])),2)&#13;&#10;END' />
