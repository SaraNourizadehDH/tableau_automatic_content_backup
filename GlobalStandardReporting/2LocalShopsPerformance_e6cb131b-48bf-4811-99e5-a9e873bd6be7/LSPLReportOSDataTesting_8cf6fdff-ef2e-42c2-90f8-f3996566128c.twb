                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='20'>Local Shops P&amp;L Report</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#d61f26' fontsize='15'>Summary P&amp;L</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#1b1b1b'>Adjustment Level:</run>
