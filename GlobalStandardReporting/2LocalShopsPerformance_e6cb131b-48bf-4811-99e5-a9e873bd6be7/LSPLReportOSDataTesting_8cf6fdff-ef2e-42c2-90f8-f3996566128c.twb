      <column caption='Act vs. DT2 1.01. KPIs - Orders' datatype='real' default-format='*+0.00%;-0.00%;0.00%' name='[Act MoM 1.01. KPIs - Orders (copy)_1967228680473202829]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;    ZN(SUM([act_orders])) &gt; ZN(SUM([DT1 1.01. KPIs - Orders (copy)_1967228680459440263]))&#13;&#10;    THEN&#13;&#10;    ABS(&#13;&#10;ZN(ZN((SUM([act_orders])) - ZN(SUM([DT1 1.01. KPIs - Orders (copy)_1967228680459440263]))) / ZN(SUM([DT1 1.01. KPIs - Orders (copy)_1967228680459440263])))&#13;&#10;)&#13;&#10;    ELSE&#13;&#10;    -ABS(&#13;&#10;ZN(ZN((SUM([act_orders])) - ZN(SUM([DT1 1.01. KPIs - Orders (copy)_1967228680459440263]))) / ZN(SUM([DT1 1.01. KPIs - Orders (copy)_1967228680459440263])))&#13;&#10;)&#13;&#10;END' />
      </column>
      <column caption='Act vs. DT2 1.02. KPIs - GMV' datatype='real' default-format='*+0.00%;-0.00%;0.00%' name='[Act MoM 1.02. KPIs - GMV (copy)_1967228680476106920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;    ZN(SUM([act_gmv])) &gt; ZN(SUM([DT1 1.02. KPIs - GMV (copy)_1967228680459440215]))&#13;&#10;    THEN&#13;&#10;    ABS(&#13;&#10;ZN(ZN((SUM([act_gmv])) - ZN(SUM([DT1 1.02. KPIs - GMV (copy)_1967228680459440215]))) / ZN(SUM([DT1 1.02. KPIs - GMV (copy)_1967228680459440215])))&#13;&#10;)&#13;&#10;    ELSE&#13;&#10;    -ABS(&#13;&#10;ZN(ZN((SUM([act_gmv])) - ZN(SUM([DT1 1.02. KPIs - GMV (copy)_1967228680459440215]))) / ZN(SUM([DT1 1.02. KPIs - GMV (copy)_1967228680459440215])))&#13;&#10;)&#13;&#10;END' />
