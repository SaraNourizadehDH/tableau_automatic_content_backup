            <column caption='Act MoM 2.04. Revenues - Other Revenue' datatype='real' default-format='*+0.00%;-0.00%;0.00%' name='[Calculation10]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;    SUM([act_other_revenue]) &gt; LOOKUP(ZN(SUM([act_other_revenue])), -1)&#13;&#10;    THEN&#13;&#10;    ABS(&#13;&#10;(ZN(SUM([act_other_revenue])) - LOOKUP(ZN(SUM([act_other_revenue])), -1)) / LOOKUP(ZN(SUM([act_other_revenue])), -1)&#13;&#10;)&#13;&#10;    ELSE&#13;&#10;    -ABS(&#13;&#10;(ZN(SUM([act_other_revenue])) - LOOKUP(ZN(SUM([act_other_revenue])), -1)) / LOOKUP(ZN(SUM([act_other_revenue])), -1)&#13;&#10;)&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Act MoM 2.05. Revenues - Card Commission Fee Revenue' datatype='real' default-format='*+0.00%;-0.00%;0.00%' name='[Calculation11]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;    SUM([act_card_fee_revenue]) &gt; LOOKUP(ZN(SUM([act_card_fee_revenue])), -1)&#13;&#10;    THEN&#13;&#10;    ABS(&#13;&#10;(ZN(SUM([act_card_fee_revenue])) - LOOKUP(ZN(SUM([act_card_fee_revenue])), -1)) / LOOKUP(ZN(SUM([act_card_fee_revenue])), -1)&#13;&#10;)&#13;&#10;    ELSE&#13;&#10;    -ABS(&#13;&#10;(ZN(SUM([act_card_fee_revenue])) - LOOKUP(ZN(SUM([act_card_fee_revenue])), -1)) / LOOKUP(ZN(SUM([act_card_fee_revenue])), -1)&#13;&#10;)&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Act MoM 2.00.01 Take In' datatype='real' default-format='*+0.00%;-0.00%;0.00%' name='[Calculation12]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF &#13;&#10;    SUM([act_take_in]) &gt; LOOKUP(ZN(SUM([act_take_in])), -1)&#13;&#10;    THEN&#13;&#10;    ABS(&#13;&#10;(ZN(SUM([act_take_in])) - LOOKUP(ZN(SUM([act_take_in])), -1)) / LOOKUP(ZN(SUM([act_take_in])), -1)&#13;&#10;)&#13;&#10;    ELSE&#13;&#10;    -ABS(&#13;&#10;(ZN(SUM([act_take_in])) - LOOKUP(ZN(SUM([act_take_in])), -1)) / LOOKUP(ZN(SUM([act_take_in])), -1)&#13;&#10;)&#13;&#10;END'>
