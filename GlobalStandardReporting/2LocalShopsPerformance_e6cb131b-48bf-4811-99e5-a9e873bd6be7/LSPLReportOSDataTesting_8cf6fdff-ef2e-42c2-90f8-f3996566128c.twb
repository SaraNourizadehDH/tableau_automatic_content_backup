              </calculation>
            </column>
            <column caption='Act MoM 2.07. Costs - Payment Costs' datatype='real' default-format='*+0.00%;-0.00%;0.00%' name='[Calculation14]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#13;&#10;    SUM([act_payment_costs]) &gt; LOOKUP(ZN(SUM([act_payment_costs])), -1)&#13;&#10;    THEN&#13;&#10;    ABS(&#13;&#10;(ZN(SUM([act_payment_costs])) - LOOKUP(ZN(SUM([act_payment_costs])), -1)) / LOOKUP(ZN(SUM([act_payment_costs])), -1)&#13;&#10;)&#13;&#10;    ELSE&#13;&#10;    -ABS(&#13;&#10;(ZN(SUM([act_payment_costs])) - LOOKUP(ZN(SUM([act_payment_costs])), -1)) / LOOKUP(ZN(SUM([act_payment_costs])), -1)&#13;&#10;)&#13;&#10;END'>
