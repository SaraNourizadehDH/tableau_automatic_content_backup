          </shelf-sorts>
          <slices>
            <column>[federated.17ua9930szfw6z1d19j3v0v1s0rc].[none:Total Density Area Km2 (bin):ok]</column>
            <column>[federated.17ua9930szfw6z1d19j3v0v1s0rc].[none:hour:ok]</column>
