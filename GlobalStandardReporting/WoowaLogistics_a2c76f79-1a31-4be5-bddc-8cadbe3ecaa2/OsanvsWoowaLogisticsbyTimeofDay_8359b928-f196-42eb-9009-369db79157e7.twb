    <worksheet name='Crosstab v2'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Medium' fontsize='12'>&lt;Sheet Name&gt; | </run>
            <run fontname='Tableau Regular' fontsize='12'>RGN2 first, then Metric</run>
