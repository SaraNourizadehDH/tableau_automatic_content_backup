    <worksheet name='RGN2 (City) x Density'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Medium' fontsize='12'>&lt;Sheet Name&gt; | </run>
            <run fontcolor='#666666' fontname='Tableau Book' fontsize='12'>Density is calculated as # orders / total area of all unique pickup hexagons</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/OsanvsWoowaLogisticsbyTimeofDay/RGN2CityxDensity?rev=' id='RGN2CityxDensity' path='/t/GlobalStandardReporting/workbooks/OsanvsWoowaLogisticsbyTimeofDay' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='woowa_peak_non_peak_cx (dashboards_rider)' name='federated.17ua9930szfw6z1d19j3v0v1s0rc' />
          </datasources>
          <datasource-dependencies datasource='federated.17ua9930szfw6z1d19j3v0v1s0rc'>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_2935572954233176064]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username] = USERNAME()' />
            </column>
            <column caption='City Density [orders per sq km per day]' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6107303360288186374]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [dropoff_city_id] :&#10;    (MAX([total_density_orders]) / MAX([total_density_area_km2])) // # orders per sq km&#10;    /&#10;    MAX([density_days]) // divided by # days&#10;}' />
            </column>
            <column caption='Interval hh:mm' datatype='string' name='[Calculation_6107303360289390599]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [hour] &lt; 10 THEN &apos;0&apos; ELSE &apos;&apos; END&#10;+&#10;STR([hour])&#10;+&#10;&apos;:&apos;&#10;+&#10;IF [interval_min] &lt; 10 THEN &apos;0&apos; ELSE &apos;&apos; END&#10;+&#10;STR([interval_min])' />
            </column>
            <column aggregation='None' caption='Area [sq km] (bin)' datatype='integer' name='[Total Density Area Km2 (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='0' formula='[total_density_area_km2]' peg='0' size='2' />
            </column>
            <column caption='Density Days' datatype='integer' name='[density_days]' role='measure' type='quantitative' />
            <column caption='Dropoff City Id' datatype='string' name='[dropoff_city_id]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column aggregation='Sum' caption='Hour' datatype='integer' name='[hour]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='Interval Min' datatype='real' name='[interval_min]' role='dimension' type='ordinal' />
            <column caption='Is Preorder' datatype='boolean' name='[is_preorder]' role='dimension' type='nominal' />
            <column caption='Is Stacked' datatype='boolean' name='[is_stacked]' role='dimension' type='nominal' />
            <column caption='Is STOD' datatype='boolean' name='[is_stod]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2935572954233176064]' derivation='None' name='[none:Calculation_2935572954233176064:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_6107303360289390599]' derivation='None' name='[none:Calculation_6107303360289390599:nk]' pivot='key' type='nominal' />
            <column-instance column='[Total Density Area Km2 (bin)]' derivation='None' name='[none:Total Density Area Km2 (bin):ok]' pivot='key' type='ordinal' />
            <column-instance column='[dropoff_city_id]' derivation='None' name='[none:dropoff_city_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[hour]' derivation='None' name='[none:hour:ok]' pivot='key' type='ordinal' />
            <column-instance column='[is_preorder]' derivation='None' name='[none:is_preorder:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_stacked]' derivation='None' name='[none:is_stacked:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_stod]' derivation='None' name='[none:is_stod:nk]' pivot='key' type='nominal' />
            <column-instance column='[rgn1_name]' derivation='None' name='[none:rgn1_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[rgn2_name]' derivation='None' name='[none:rgn2_name:nk]' pivot='key' type='nominal' />
            <column caption='Orders Created' datatype='integer' name='[orders_created]' role='measure' type='quantitative' />
            <column caption='Rgn1 Name' datatype='string' name='[rgn1_name]' role='dimension' type='nominal' />
            <column caption='Rgn2 Name' datatype='string' name='[rgn2_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_6107303360288186374]' derivation='Sum' name='[sum:Calculation_6107303360288186374:qk]' pivot='key' type='quantitative' />
            <column-instance column='[orders_created]' derivation='Sum' name='[sum:orders_created:qk]' pivot='key' type='quantitative' />
            <column caption='Total Density Area Km2' datatype='real' name='[total_density_area_km2]' role='measure' type='quantitative' />
            <column caption='Total Density Orders' datatype='integer' name='[total_density_orders]' role='measure' type='quantitative' />
            <column caption='Username' datatype='string' name='[username]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.17ua9930szfw6z1d19j3v0v1s0rc].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.17ua9930szfw6z1d19j3v0v1s0rc].[sum:Calculation_6107303360288186374:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.17ua9930szfw6z1d19j3v0v1s0rc].[sum:orders_created:qk]&quot;' />
            </groupfilter>
          </filter>
          <manual-sort column='[federated.17ua9930szfw6z1d19j3v0v1s0rc].[:Measure Names]' direction='ASC'>
            <dictionary>
              <bucket>&quot;[federated.17ua9930szfw6z1d19j3v0v1s0rc].[sum:Calculation_6107303360288186374:qk]&quot;</bucket>
              <bucket>&quot;[federated.17ua9930szfw6z1d19j3v0v1s0rc].[sum:orders_created:qk]&quot;</bucket>
