            <remote-name>access_group</remote-name>
            <remote-type>130</remote-type>
            <local-name>[access_group]</local-name>
            <parent-name>[_tableau_country_user_entitlements]</parent-name>
            <remote-alias>access_group</remote-alias>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
