    <worksheet name='Graph [Pre/Post]'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Medium' fontsize='12'>&lt;Sheet Name&gt; |</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='woowa_peak_non_peak_cx (dashboards_rider)' name='federated.17ua9930szfw6z1d19j3v0v1s0rc' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select KPI' datatype='string' name='[Time Interval (copy)_632192861739229187]' param-domain-type='list' role='measure' type='nominal' value='&quot;DT (mins)&quot;'>
              <calculation class='tableau' formula='&quot;DT (mins)&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.17ua9930szfw6z1d19j3v0v1s0rc'>
            <column caption='% Orders Late &gt; 10' datatype='real' default-format='p0.0%' name='[% DT &gt; 45 (copy)_6107303360288075781]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([late_10_n]) / SUM([late_10_d])' />
            </column>
            <column caption='% DT &gt; 45' datatype='real' default-format='p0.0%' name='[% DT &gt; 60 (copy)_6107303360287768577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt_gt45_n]) / SUM([dt_gt45_d])' />
            </column>
            <column caption='% Failed Orders' datatype='real' default-format='p0.0%' name='[% DT &gt; 60 (copy)_6107303360287862786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_cancelled]) / SUM([orders_created])' />
            </column>
            <column caption='% Stacked Orders' datatype='real' default-format='p0.0%' name='[% Failed Orders (copy)_6107303360287944707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_orders]) / SUM([orders_completed])' />
            </column>
            <column caption='% Stacked Intravendor Orders' datatype='real' default-format='p0.0%' name='[% Stacked Orders (copy)_6107303360288018436]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_intravendor_orders]) / SUM([orders_completed])' />
            </column>
            <column caption='User Entitlement' datatype='boolean' name='[Calculation_2935572954233176064]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username] = USERNAME()' />
            </column>
            <column caption='PD Distance Straightline (m)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_2935572954237673474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pd_straightline_m_n]) / SUM([pd_straightline_m_d])' />
            </column>
            <column caption='% DT &gt; 60' datatype='real' default-format='p0.0%' name='[Calculation_6107303360287657984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt_gt60_n]) / SUM([dt_gt60_d])' />
            </column>
            <column caption='City Density [orders per sq km per day]' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6107303360288186374]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [dropoff_city_id] :&#10;    (MAX([total_density_orders]) / MAX([total_density_area_km2])) // # orders per sq km&#10;    /&#10;    MAX([density_days]) // divided by # days&#10;}' />
            </column>
            <column caption='Interval hh:mm' datatype='string' name='[Calculation_6107303360289390599]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [hour] &lt; 10 THEN &apos;0&apos; ELSE &apos;&apos; END&#10;+&#10;STR([hour])&#10;+&#10;&apos;:&apos;&#10;+&#10;IF [interval_min] &lt; 10 THEN &apos;0&apos; ELSE &apos;&apos; END&#10;+&#10;STR([interval_min])' />
            </column>
            <column caption='DT (mins)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6107303360290508808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dt_n]) / SUM([dt_d])' />
            </column>
            <column caption='Period' datatype='string' name='[Calculation_632192861730676736]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [rgn2_name] = &apos;Osan-si&apos; AND zone_name = &apos;Null&apos;&#10;  AND [created_date_local]&gt;= DATE(&apos;2025-04-01&apos;)&#10;THEN &apos;Post&apos;&#10;ELSEIF [rgn2_name] = &apos;Osan-si&apos; AND zone_name &lt;&gt; &apos;오산시 [osn]&apos; &#10;  AND [created_date_local]&gt;= DATE(&apos;2025-04-01&apos;)&#10;THEN &apos;Post&apos;&#10;ELSEIF  [rgn2_name] = &apos;Hwaseong-si&apos; &#10;  AND [created_date_local]&lt; DATE(&apos;2025-04-01&apos;)&#10;THEN &apos;Pre&apos;&#10;END' />
            </column>
            <column caption='Pre dates' datatype='date' name='[Calculation_632192861735268353]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_632192861730676736] = &apos;Pre&apos; THEN [created_date_local] ELSE NULL END' />
            </column>
            <column caption='KPIs' datatype='real' name='[Calculation_632192861740273668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Time Interval (copy)_632192861739229187]&#10;WHEN &apos;DT (mins)&apos; THEN [Calculation_6107303360290508808]&#10;WHEN &apos;CDT (mins)&apos; THEN [DT (mins) (copy)_6107303360290619401]&#10;WHEN &apos;% Failed Orders&apos; THEN [% DT &gt; 60 (copy)_6107303360287862786]&#10;WHEN &apos;%DT &gt; 60&apos; THEN [Calculation_6107303360287657984]&#10;WHEN &apos;%DT &gt; 45&apos; THEN [% DT &gt; 60 (copy)_6107303360287768577]&#10;WHEN &apos;%Orders Late &gt; 10&apos; THEN [% DT &gt; 45 (copy)_6107303360288075781]&#10;WHEN &apos;City Density&apos; THEN SUM([Calculation_6107303360288186374])&#10;WHEN &apos;% Stacked Orders&apos; THEN [% Failed Orders (copy)_6107303360287944707]&#10;WHEN &apos;% Stacked Intravendor Orders&apos; THEN [% Stacked Orders (copy)_6107303360288018436]&#10;WHEN &apos;PD Distance Straightline (m)&apos; THEN [Calculation_2935572954237673474]&#10;END' />
            </column>
            <column caption='AVG Orders Created' datatype='real' name='[Calculation_632192861760675845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_created])&#10;/ &#10;countd([created_date_local])' />
            </column>
            <column caption='Weekday' datatype='string' name='[Calculation_632192861761880071]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[created_date_local])' />
            </column>
            <column caption='CDT (mins)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[DT (mins) (copy)_6107303360290619401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cdt_n]) / SUM([cdt_d])' />
            </column>
            <column caption='Post dates' datatype='date' name='[Pre dates (copy)_632192861735477250]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_632192861730676736] = &apos;Post&apos; THEN [created_date_local] ELSE NULL END' />
            </column>
            <column aggregation='None' caption='Area [sq km] (bin)' datatype='integer' name='[Total Density Area Km2 (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='0' formula='[total_density_area_km2]' peg='0' size='2' />
            </column>
            <column caption='Cdt D' datatype='integer' name='[cdt_d]' role='measure' type='quantitative' />
            <column caption='Cdt N' datatype='real' name='[cdt_n]' role='measure' type='quantitative' />
            <column caption='Created Date Local' datatype='date' name='[created_date_local]' role='dimension' type='ordinal' />
            <column caption='Density Days' datatype='integer' name='[density_days]' role='measure' type='quantitative' />
            <column caption='Dropoff City Id' datatype='string' name='[dropoff_city_id]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Dt D' datatype='integer' name='[dt_d]' role='measure' type='quantitative' />
            <column caption='Dt Gt45 D' datatype='integer' name='[dt_gt45_d]' role='measure' type='quantitative' />
            <column caption='Dt Gt45 N' datatype='integer' name='[dt_gt45_n]' role='measure' type='quantitative' />
            <column caption='Dt Gt60 D' datatype='integer' name='[dt_gt60_d]' role='measure' type='quantitative' />
            <column caption='Dt Gt60 N' datatype='integer' name='[dt_gt60_n]' role='measure' type='quantitative' />
            <column caption='Dt N' datatype='real' name='[dt_n]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Hour' datatype='integer' name='[hour]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='Interval Min' datatype='real' name='[interval_min]' role='dimension' type='ordinal' />
            <column caption='Is Preorder' datatype='boolean' name='[is_preorder]' role='dimension' type='nominal' />
            <column caption='Is Stacked' datatype='boolean' name='[is_stacked]' role='dimension' type='nominal' />
            <column caption='Is STOD' datatype='boolean' name='[is_stod]' role='dimension' type='nominal' />
            <column caption='Late 10 D' datatype='integer' name='[late_10_d]' role='measure' type='quantitative' />
