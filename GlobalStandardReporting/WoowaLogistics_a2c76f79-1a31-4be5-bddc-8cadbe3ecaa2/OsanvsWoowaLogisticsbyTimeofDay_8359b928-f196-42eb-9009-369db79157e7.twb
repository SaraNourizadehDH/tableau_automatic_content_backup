            </column>
            <column caption='City Density [orders per sq km per day]' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_6107303360288186374]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [dropoff_city_id] :&#10;    (MAX([total_density_orders]) / MAX([total_density_area_km2])) // # orders per sq km&#10;    /&#10;    MAX([density_days]) // divided by # days&#10;}' />
