            <column>[federated.17ua9930szfw6z1d19j3v0v1s0rc].[none:is_preorder:nk]</column>
            <column>[federated.17ua9930szfw6z1d19j3v0v1s0rc].[none:is_stod:nk]</column>
            <column>[federated.17ua9930szfw6z1d19j3v0v1s0rc].[sum:orders_created:qk]</column>
            <column>[federated.17ua9930szfw6z1d19j3v0v1s0rc].[none:is_stacked:nk]</column>
            <column>[federated.17ua9930szfw6z1d19j3v0v1s0rc].[none:Calculation_2935572954233176064:nk]</column>
            <column>[federated.17ua9930szfw6z1d19j3v0v1s0rc].[:Measure Names]</column>
