          <formatted-text>
            <run bold='true' fontsize='10'>Forecast bias</run>
            <run fontsize='10'> - calculated onlly for skus with 100% availability</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='idp_sku_visualiser_test_Czech (rl_dmart)' name='federated.1cttfa608chpmh179acqf152lpw1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Availability Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
            </column>
            <column caption='Grouping 1, parameter' datatype='string' name='[Date Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;date&quot;'>
              <calculation class='tableau' formula='&quot;date&quot;' />
            </column>
            <column caption='Grouping 2, parameter' datatype='string' name='[Grouping 1, parameter (copy)_1316739993139511306]' param-domain-type='list' role='measure' type='nominal' value='&quot;Category L1&quot;'>
              <calculation class='tableau' formula='&quot;Category L1&quot;' />
