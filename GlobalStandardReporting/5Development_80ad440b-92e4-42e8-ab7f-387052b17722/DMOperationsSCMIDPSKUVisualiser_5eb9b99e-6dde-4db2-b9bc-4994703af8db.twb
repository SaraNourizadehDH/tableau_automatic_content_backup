    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Overall view'>
      <repository-location derived-from='http://ip-172-31-0-132:8885/t/GlobalStandardReporting/workbooks/DM-Operations-SCM-IDPSKUVisualiser/Overallview?rev=' id='Overallview' path='/t/GlobalStandardReporting/workbooks/DM-Operations-SCM-IDPSKUVisualiser' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1200' maxwidth='1500' minheight='1200' minwidth='1500' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='idp_sku_visualiser_test_Czech (rl_dmart)' name='federated.1cttfa608chpmh179acqf152lpw1' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Date Granularity' datatype='string' name='[Availability Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
          <calculation class='tableau' formula='&quot;week&quot;' />
          <members>
            <member value='&quot;day&quot;' />
            <member value='&quot;week&quot;' />
            <member value='&quot;\# week&quot;' />
