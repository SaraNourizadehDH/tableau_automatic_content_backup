    <worksheet lock-updates='true' name='H - IDP forecast corr bias'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='8'>IDP forecast corr bias, %</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='idp_sku_visualiser_test_Czech (rl_dmart)' name='federated.1cttfa608chpmh179acqf152lpw1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Availability Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
            </column>
            <column caption='Grouping 1, parameter' datatype='string' name='[Date Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;date&quot;'>
              <calculation class='tableau' formula='&quot;date&quot;' />
            </column>
            <column caption='Grouping 2, parameter' datatype='string' name='[Grouping 1, parameter (copy)_1316739993139511306]' param-domain-type='list' role='measure' type='nominal' value='&quot;Category L1&quot;'>
              <calculation class='tableau' formula='&quot;Category L1&quot;' />
            </column>
            <column caption='Grouping 1-2  high level' datatype='string' name='[Grouping 1-1 (copy)_1078049214028435456]' param-domain-type='list' role='measure' type='nominal' value='&quot;Category L1&quot;'>
              <calculation class='tableau' formula='&quot;Category L1&quot;' />
            </column>
            <column caption='Grouping 3, parameter' datatype='string' name='[Grouping 2, parameter (copy)_1316739993139568651]' param-domain-type='list' role='measure' type='nominal' value='&quot;Category L2&quot;'>
              <calculation class='tableau' formula='&quot;Category L2&quot;' />
            </column>
            <column caption='Grouping 4, parameter' datatype='string' name='[Grouping 3, parameter (copy)_1316739993139679244]' param-domain-type='list' role='measure' type='nominal' value='&quot;Sku name&quot;'>
              <calculation class='tableau' formula='&quot;Sku name&quot;' />
            </column>
            <column caption='Grouping 1-1  high level' datatype='string' name='[Grouping 4, parameter (copy)_1316739993139728397]' param-domain-type='list' role='measure' type='nominal' value='&quot;Category L0&quot;'>
              <calculation class='tableau' formula='&quot;Category L0&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1cttfa608chpmh179acqf152lpw1'>
            <column caption='Date grouping' datatype='string' name='[Calculation_1316739992895864832]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Availability Parameter] &#13;&#10;WHEN &apos;day&apos; THEN STR(DATE(DATETRUNC(&apos;day&apos;, [report_date]))) &#13;&#10;WHEN &apos;week&apos; THEN STR(DATE(DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;)))&#13;&#10;WHEN &apos;# week&apos; THEN STR(DATEPART(&apos;year&apos;, [report_date])) +&quot;  &quot;+ STR(DATEPART(&apos;week&apos;, [report_date]))&#13;&#10;WHEN &apos;month&apos; THEN STR(DATE(DATETRUNC(&apos;month&apos;, [report_date])))  &#13;&#10;WHEN &apos;quarter&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;, [report_date]))) &#13;&#10;END' />
            </column>
            <column caption='date granularity' datatype='string' name='[Calculation_1316739992897728514]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1316739992895864832]' />
            </column>
            <column caption='Grouping 1' datatype='string' name='[Calculation_1316739993138061321]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)] &#13;&#10;WHEN &apos;Country&apos; THEN [country] &#13;&#10;WHEN &apos;Warehouse&apos; THEN [warehouse_name] &#13;&#10;WHEN &apos;Supplier&apos; THEN [supplier_name] &#13;&#10;WHEN &apos;Sku&apos; THEN [sku]&#13;&#10;WHEN &apos;Sku name&apos; THEN [product_name]&#13;&#10;WHEN &apos;Category L0&apos; THEN [category_level_zero]&#13;&#10;WHEN &apos;Category L1&apos; THEN [category_level_one]&#13;&#10;WHEN &apos;Category L2&apos; THEN [category_level_two]&#13;&#10;WHEN &apos;date&apos; THEN [Calculation_1316739992897728514]&#13;&#10;ELSE &apos;-&apos; END' />
            </column>
            <column caption='Forecast Bias, % corrected IDP, filtered' datatype='real' default-format='p0%' name='[Forecast Bias, % effective IDP, non-filtered (copy)_253046066168893445]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [report_date]&lt; TODAY() THEN [predicted_qty_corrected_idp_filtered] ELSE 0 END)/SUM([sold_qty_filtered])' />
            </column>
            <column caption='Grouping 1-1  high level' datatype='string' name='[Grouping 1 (copy) (copy) (copy) (copy)_1316739993139871761]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Grouping 4, parameter (copy)_1316739993139728397] &#13;&#10;WHEN &apos;Country&apos; THEN [country] &#13;&#10;WHEN &apos;Warehouse&apos; THEN [warehouse_name]&#13;&#10;WHEN &apos;Supplier&apos; THEN [supplier_name]&#13;&#10;WHEN &apos;Category L0&apos; THEN [category_level_zero]&#13;&#10;WHEN &apos;Category L1&apos; THEN [category_level_one]&#13;&#10;WHEN &apos;Category L2&apos; THEN [category_level_two]&#13;&#10;WHEN &apos;abc&apos; THEN [abc_segmentation]&#13;&#10;ELSE &apos;-&apos; END' />
            </column>
            <column caption='Grouping 4' datatype='string' name='[Grouping 1 (copy) (copy) (copy)_1316739993139859472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Grouping 3, parameter (copy)_1316739993139679244] &#13;&#10;WHEN &apos;Country&apos; THEN [country] &#13;&#10;WHEN &apos;Warehouse&apos; THEN [warehouse_name] &#13;&#10;WHEN &apos;Supplier&apos; THEN [supplier_name] &#13;&#10;WHEN &apos;Sku&apos; THEN [sku]&#13;&#10;WHEN &apos;Sku name&apos; THEN [product_name]&#13;&#10;WHEN &apos;Category L0&apos; THEN [category_level_zero]&#13;&#10;WHEN &apos;Category L1&apos; THEN [category_level_one]&#13;&#10;WHEN &apos;Category L2&apos; THEN [category_level_two]&#13;&#10;WHEN &apos;date&apos; THEN [Calculation_1316739992897728514]&#13;&#10;ELSE &apos;-&apos; END' />
            </column>
            <column caption='Grouping 3' datatype='string' name='[Grouping 1 (copy) (copy)_1316739993139843087]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Grouping 2, parameter (copy)_1316739993139568651] &#13;&#10;WHEN &apos;Country&apos; THEN [country] &#13;&#10;WHEN &apos;Warehouse&apos; THEN [warehouse_name] &#13;&#10;WHEN &apos;Supplier&apos; THEN [supplier_name] &#13;&#10;WHEN &apos;Sku&apos; THEN [sku]&#13;&#10;WHEN &apos;Sku name&apos; THEN [product_name]&#13;&#10;WHEN &apos;Category L0&apos; THEN [category_level_zero]&#13;&#10;WHEN &apos;Category L1&apos; THEN [category_level_one]&#13;&#10;WHEN &apos;Category L2&apos; THEN [category_level_two]&#13;&#10;WHEN &apos;date&apos; THEN [Calculation_1316739992897728514]&#13;&#10;ELSE &apos;-&apos; END' />
