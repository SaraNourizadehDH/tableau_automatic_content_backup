        <calculation class='tableau' formula='CASE [Parameters].[Availability hourly, % (valid hours) Parameter] &#13;&#10;WHEN &apos;Availability weighted&apos; THEN [Calculation_5714856865202814976 1] &#13;&#10;WHEN &apos;Availability hourly, work hours&apos; THEN [Availability weighted, % (copy)_565764765919379456]&#13;&#10;WHEN &apos;Availability hourly, total&apos; THEN [Availability hourly, % (work hours) (copy)_565764765924065282]&#13;&#10; END' />
      </column>
      <column caption='Grouping 1-2  high level' datatype='string' name='[Grouping 1-1  high level (copy)_1078049214029258754]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Grouping 1-1 (copy)_1078049214028435456] &#13;&#10;WHEN &apos;Country&apos; THEN [country] &#13;&#10;WHEN &apos;Warehouse&apos; THEN [warehouse_name]&#13;&#10;WHEN &apos;Supplier&apos; THEN [supplier_name]&#13;&#10;WHEN &apos;Category L0&apos; THEN [category_level_zero]&#13;&#10;WHEN &apos;Category L1&apos; THEN [category_level_one]&#13;&#10;WHEN &apos;Category L2&apos; THEN [category_level_two]&#13;&#10;WHEN &apos;abc&apos; THEN [abc_segmentation]&#13;&#10;ELSE &apos;-&apos; END' />
