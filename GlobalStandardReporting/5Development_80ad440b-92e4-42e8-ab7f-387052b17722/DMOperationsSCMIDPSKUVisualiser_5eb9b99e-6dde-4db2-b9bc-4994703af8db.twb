      <column caption='Availability hourly, % total' datatype='real' default-format='p0%' name='[Availability hourly, % (work hours) (copy)_565764765924065282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([available_hours])/SUM([potential_hours])' />
        <desc>
          <formatted-text>
            <run>= availalable hours / potential hours 
only within store working hours</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Availability hourly, % work hours' datatype='real' default-format='p0%' name='[Availability weighted, % (copy)_565764765919379456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([available_hours_open_store])/SUM([potential_hours_open_store])' />
        <desc>
          <formatted-text>
            <run>= availalable hours / potential hours 
only within store working hours</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='skus requested total' datatype='integer' name='[Calculation_1237364060026818560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [total_requested_qty] &gt; 0 THEN 1 else NULL END)' />
      </column>
      <column caption='Unedited PO lines, %' datatype='real' default-format='p0%' name='[Calculation_1311391982053470209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unedited_lines_idp]) / SUM([requested_lines_idp])' />
      </column>
      <column caption='Date grouping' datatype='string' name='[Calculation_1316739992895864832]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Availability Parameter] &#13;&#10;WHEN &apos;day&apos; THEN STR(DATE(DATETRUNC(&apos;day&apos;, [report_date]))) &#13;&#10;WHEN &apos;week&apos; THEN STR(DATE(DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;)))&#13;&#10;WHEN &apos;# week&apos; THEN STR(DATEPART(&apos;year&apos;, [report_date])) +&quot;  &quot;+ STR(DATEPART(&apos;week&apos;, [report_date]))&#13;&#10;WHEN &apos;month&apos; THEN STR(DATE(DATETRUNC(&apos;month&apos;, [report_date])))  &#13;&#10;WHEN &apos;quarter&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;, [report_date]))) &#13;&#10;END' />
      </column>
      <column caption='date granularity' datatype='string' name='[Calculation_1316739992897728514]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1316739992895864832]' />
      </column>
      <column caption='Grouping 1' datatype='string' name='[Calculation_1316739993138061321]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)] &#13;&#10;WHEN &apos;Country&apos; THEN [country] &#13;&#10;WHEN &apos;Warehouse&apos; THEN [warehouse_name] &#13;&#10;WHEN &apos;Supplier&apos; THEN [supplier_name] &#13;&#10;WHEN &apos;Sku&apos; THEN [sku]&#13;&#10;WHEN &apos;Sku name&apos; THEN [product_name]&#13;&#10;WHEN &apos;Category L0&apos; THEN [category_level_zero]&#13;&#10;WHEN &apos;Category L1&apos; THEN [category_level_one]&#13;&#10;WHEN &apos;Category L2&apos; THEN [category_level_two]&#13;&#10;WHEN &apos;date&apos; THEN [Calculation_1316739992897728514]&#13;&#10;ELSE &apos;-&apos; END' />
      </column>
      <column caption='Received Qty - Requested' datatype='integer' name='[Calculation_253046066172379145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_received_qty]) - SUM([total_requested_qty])' />
      </column>
      <column caption='weeks qty' datatype='integer' name='[Calculation_565764765938266115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF  [report_date] &lt; TODAY() THEN DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;) ELSE NULL END)' />
      </column>
      <column caption='Avg Shrinkage per granularity' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_565764765945020423]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([shrinkage_qty]) / [Date grouping (copy)_565764765944467462]' />
      </column>
      <column caption='Availability weighted, %' datatype='real' name='[Calculation_5714856865202814976 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_availability])/SUM([dr_availability])' />
