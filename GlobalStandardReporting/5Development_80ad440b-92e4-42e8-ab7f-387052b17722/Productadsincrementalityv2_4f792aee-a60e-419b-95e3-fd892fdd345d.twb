      <aliases enabled='yes' />
      <column datatype='real' default-format='p0.00%' name='[Calculation3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([swimlanes]) / TOTAL(SUM([swimlanes]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total_sales_SKU' datatype='integer' name='[Calculation_30540087393394689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [product_sku] : SUM([all_orders])}' />
      </column>
      <column caption='Calculation2' datatype='integer' name='[Calculation_30540087395598338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(&apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='total_impressions_sku' datatype='integer' name='[Calculation_30540087397961732]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [product_sku]:SUM([product_ad_impression])}' />
      </column>
      <column caption='Swimlane %' datatype='real' name='[Calculation_30540087465566213]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([swimlanes])/sum([Calculation_4346536639634788352])' />
      </column>
      <column caption='CTR' datatype='real' name='[Calculation_3135912767297048576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4346536639634788352])/sum([impressions])' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_3135912767341649921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([product_sku])' />
      </column>
      <column caption='Calculation4' datatype='string' name='[Calculation_32440045310099459]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF WEEK([partition_date]) &gt;= 41 AND WEEK([partition_date]) &lt;= 45 THEN &quot;First_phase&quot; &#10;ELSEIF WEEK([partition_date]) &gt;= 46 AND WEEK([partition_date]) &lt;= 50 THEN&#10;&quot;Second&quot; &#10;ELSEIF WEEK([partition_date]) &gt;= 51  THEN&#10;&quot;Third&quot; &#10;ELSEIF WEEK([partition_date]) &gt;= 1 AND WEEK([partition_date]) &lt;= 2 THEN&#10;&quot;Third&quot; &#10;else &quot;Fourth&quot;&#10;END' />
      </column>
      <column caption='Brand_ATC' datatype='integer' name='[Calculation_376683951691378688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [product_brand] : SUM([Calculation_4346536639634788352])}' />
      </column>
      <column caption='Total  ATC' datatype='integer' name='[Calculation_4346536639634788352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[direct_and_others] +[banners]+[swimlanes]+[product_ads]' />
      </column>
      <column caption='Prod_ads %' datatype='real' name='[Swimlane % (copy) (copy) (copy)_32440045276803074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([product_ads])/sum([Calculation_4346536639634788352])' />
      </column>
      <column caption='Direct &amp; Other %' datatype='real' name='[Swimlane % (copy) (copy)_32440045276790785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([direct_and_others])/sum([Calculation_4346536639634788352])' />
      </column>
      <column caption='Swimlane % (copy)' datatype='real' name='[Swimlane % (copy)_32440045276782592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([swimlanes])/sum([Calculation_4346536639634788352])' />
      </column>
