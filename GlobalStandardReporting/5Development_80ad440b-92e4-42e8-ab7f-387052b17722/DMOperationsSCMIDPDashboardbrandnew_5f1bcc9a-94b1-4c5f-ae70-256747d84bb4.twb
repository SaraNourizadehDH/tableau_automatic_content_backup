      <column caption='Availability hourly, % total' datatype='real' default-format='p0%' hidden='true' name='[Availability hourly, % (work hours) (copy)_565764765924065282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([available_hours])/SUM([potential_hours])' />
        <desc>
          <formatted-text>
            <run>= availalable hours / potential hours 
only within store working hours</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Availability hourly, % work hours' datatype='real' default-format='p0%' name='[Availability weighted, % (copy)_565764765919379456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([available_hours_open_store])/SUM([potential_hours_open_store])' />
        <desc>
          <formatted-text>
            <run>= availalable hours / potential hours 
only within store working hours</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Availability weighted, % (copy)' datatype='real' default-format='p0%' name='[Availability weighted, % (copy)_750975304453607429]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_availability])/SUM([dr_availability])' />
      </column>
      <column caption='Total Po Lines.' datatype='integer' name='[Calculation_1237364060026818560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_po_lines])' />
      </column>
      <column caption='Availability weighted abs diff' datatype='real' name='[Calculation_1289718347331309573]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF FIRST()==0 THEN&#13;&#10;    [Calculation_5714856865202814976 1] - LOOKUP([Calculation_5714856865202814976 1], -1)&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sales, Euro' datatype='real' name='[Calculation_1295066371850907652]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cogs_eur])' />
      </column>
      <column caption='Dates after Start Week 0, flag' datatype='boolean' name='[Calculation_1295066371856822277]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [report_date] &gt;= [start_week_0] THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Date grouping' datatype='string' name='[Calculation_1316739992895864832]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Availability Parameter] &#13;&#10;WHEN &apos;day&apos; THEN STR(DATE(DATETRUNC(&apos;day&apos;, [report_date]))) &#13;&#10;WHEN &apos;week&apos; THEN STR(DATE(DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;)))&#13;&#10;WHEN &apos;# week&apos; THEN STR(DATEPART(&apos;year&apos;, [report_date])) +&quot;  &quot;+ STR(DATEPART(&apos;week&apos;, [report_date]))&#13;&#10;WHEN &apos;month&apos; THEN STR(DATE(DATETRUNC(&apos;month&apos;, [report_date])))  &#13;&#10;WHEN &apos;quarter&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;, [report_date]))) &#13;&#10;END' />
      </column>
      <column caption='date granularity' datatype='string' name='[Calculation_1316739992897728514]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Availability Parameter] &#13;&#10;WHEN &apos;day&apos; THEN STR(DATE(DATETRUNC(&apos;day&apos;, [report_date]))) &#13;&#10;WHEN &apos;week&apos; THEN STR(DATE(DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;)))&#13;&#10;WHEN &apos;# week&apos; THEN STR(DATEPART(&apos;year&apos;, [report_date])) +&quot;  &quot;+ STR(DATEPART(&apos;week&apos;, [report_date]))&#13;&#10;WHEN &apos;month&apos; THEN STR(DATE(DATETRUNC(&apos;month&apos;, [report_date])))  &#13;&#10;WHEN &apos;quarter&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;, [report_date]))) &#13;&#10;END' />
      </column>
      <column caption='Grouping 1' datatype='string' name='[Calculation_1316739993138061321]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)] &#13;&#10;WHEN &apos;Country&apos; THEN [country (idp_dashboard)] &#13;&#10;WHEN &apos;Warehouse&apos; THEN [warehouse_name (idp_dashboard)] &#13;&#10;WHEN &apos;Date&apos; THEN [Calculation_1316739992897728514]&#13;&#10;WHEN &apos;abc&apos; THEN [unit_sales_contribution_bucket]&#13;&#10;&#13;&#10;ELSE &apos;-&apos; END' />
      </column>
      <column caption='Unedited PO lines, %' datatype='real' default-format='p0%' name='[Calculation_1468736494383734784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_matched_idp_po_lines])/SUM([idp_po_lines])' />
      </column>
      <column caption='WAPE Baseline' datatype='real' default-format='p0%' name='[Calculation_1468736494392762369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rolling_forecast_error_baseline_filtered])/SUM([rolling_sales_filtered])' />
      </column>
      <column caption='Recomendation changes, %' datatype='real' default-format='p0%' name='[Calculation_1468736494395305988]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([abs_diff_idp_recomendation])/SUM([sugested_po_qty_in_changed_recomendations])' />
      </column>
      <column caption='DOH' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_424745743098220544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([stock_value_eur]) / SUM([cogs_eur])' />
      </column>
      <column caption='weeks qty' datatype='integer' name='[Calculation_565764765938266115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF  [report_date] &lt; TODAY() THEN DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;) ELSE NULL END)' />
      </column>
      <column caption='Avg Shrinkage per granularity' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_565764765945020423]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([shrinkage_qty]) / [Date grouping (copy)_565764765944467462]' />
