      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='idp_adoption_dashboard_full_rollouts (rl_dmart)' name='federated.16711e30rl125h19j02920qz4lkl' />
          </datasources>
          <datasource-dependencies datasource='federated.16711e30rl125h19j02920qz4lkl'>
            <column caption='Spoilage, % revenue   - diff absolute' datatype='real' name='[Availability weighted, %  - diff absolute (copy)_321162954069082113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Shrinkage, % qty (copy)_253046066158903296]) - LOOKUP(ZN([Shrinkage, % qty (copy)_253046066158903296]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='DOH  - diff absolute' datatype='real' name='[Availability weighted, %  - diff absolute (copy)_321162954069766147]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_424745743098220544]) - LOOKUP(ZN([Calculation_424745743098220544]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Spoilage, % revenue - diff %' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Shrinkage, % qty (copy)_253046066158903296]) - LOOKUP(ZN([Shrinkage, % qty (copy)_253046066158903296]), -1)) / ABS(LOOKUP(ZN([Shrinkage, % qty (copy)_253046066158903296]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Availability weighted, % - diff %' datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([Calculation_5714856865202814976 1]) - LOOKUP(ZN([Calculation_5714856865202814976 1]), -1)) / ABS(LOOKUP(ZN([Calculation_5714856865202814976 1]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Availability weighted, %  - diff absolute' datatype='real' name='[Calculation3]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_5714856865202814976 1]) - LOOKUP(ZN([Calculation_5714856865202814976 1]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='DOH' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_424745743098220544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stock_value_eur]) / SUM([cogs_eur])' />
            </column>
            <column caption='Availability weighted, %' datatype='real' default-format='p0%' name='[Calculation_5714856865202814976 1]' role='measure' type='quantitative'>
