            <column-instance column='[idp_roll_out_type]' derivation='None' name='[none:idp_roll_out_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column caption='Idp PO Lines, %' datatype='real' default-format='p0%' name='[skus requested total (copy)_1237364060027240449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([idp_po_lines])/[Calculation_1237364060026818560]' />
            </column>
            <column caption='Sugested Po Qty In Changed Recomendations' datatype='integer' name='[sugested_po_qty_in_changed_recomendations]' role='measure' type='quantitative' />
            <column caption='Total Matched Idp Po Lines' datatype='integer' name='[total_matched_idp_po_lines]' role='measure' type='quantitative' />
            <column caption='Total Po Lines' datatype='integer' name='[total_po_lines]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1468736494383734784]' derivation='User' name='[usr:Calculation_1468736494383734784:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1468736494395305988]' derivation='User' name='[usr:Calculation_1468736494395305988:qk]' pivot='key' type='quantitative' />
