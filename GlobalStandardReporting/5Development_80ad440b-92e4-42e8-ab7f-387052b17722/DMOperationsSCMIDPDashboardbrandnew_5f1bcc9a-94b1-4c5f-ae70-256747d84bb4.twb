    <worksheet name='Forecast vs Sales + Availability'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='10'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='idp_adoption_dashboard+ (rl_dmart)' name='federated.1mwwb1z0you2di1649fvl18dq21i' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Availability Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
            </column>
            <column caption='Availability metrics, parameter' datatype='string' name='[Availability hourly, % (valid hours) Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Availability weighted&quot;'>
              <calculation class='tableau' formula='&quot;Availability weighted&quot;' />
            </column>
            <column caption='Grouping 1, parameter' datatype='string' name='[Date Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Warehouse&quot;'>
              <calculation class='tableau' formula='&quot;Warehouse&quot;' />
            </column>
            <column caption='Grouping 2, parameter' datatype='string' name='[Grouping 1, parameter (copy)_1316739993139511306]' param-domain-type='list' role='measure' type='nominal' value='&quot;Date&quot;'>
              <calculation class='tableau' formula='&quot;Date&quot;' />
            </column>
            <column caption='Grouping 3, parameter' datatype='string' name='[Grouping 2, parameter (copy)_1316739993139568651]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mwwb1z0you2di1649fvl18dq21i'>
            <column caption='Availability hourly, % work hours' datatype='real' default-format='p0%' name='[Availability weighted, % (copy)_565764765919379456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([available_hours_open_store])/SUM([potential_hours_open_store])' />
              <desc>
                <formatted-text>
                  <run>= availalable hours / potential hours 
only within store working hours</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='date granularity' datatype='string' name='[Calculation_1316739992897728514]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Availability Parameter] &#13;&#10;WHEN &apos;day&apos; THEN STR(DATE(DATETRUNC(&apos;day&apos;, [report_date]))) &#13;&#10;WHEN &apos;week&apos; THEN STR(DATE(DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;)))&#13;&#10;WHEN &apos;# week&apos; THEN STR(DATEPART(&apos;year&apos;, [report_date])) +&quot;  &quot;+ STR(DATEPART(&apos;week&apos;, [report_date]))&#13;&#10;WHEN &apos;month&apos; THEN STR(DATE(DATETRUNC(&apos;month&apos;, [report_date])))  &#13;&#10;WHEN &apos;quarter&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;, [report_date]))) &#13;&#10;END' />
            </column>
            <column caption='Grouping 1' datatype='string' name='[Calculation_1316739993138061321]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)] &#13;&#10;WHEN &apos;Country&apos; THEN [country] &#13;&#10;WHEN &apos;Warehouse&apos; THEN [warehouse_name] &#13;&#10;WHEN &apos;Date&apos; THEN [Calculation_1316739992897728514]&#13;&#10;WHEN &apos;abc&apos; THEN [unit_sales_contribution_bucket]&#13;&#10;&#13;&#10;ELSE &apos;-&apos; END' />
            </column>
            <column caption='Availability weighted, %' datatype='real' default-format='p0%' name='[Calculation_5714856865202814976 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nr_availability])/SUM([dr_availability])' />
            </column>
            <column caption='Grouping 3' datatype='string' name='[Grouping 1 (copy) (copy)_1316739993139843087]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Grouping 2, parameter (copy)_1316739993139568651] &#13;&#10;WHEN &apos;Country&apos; THEN [country] &#13;&#10;WHEN &apos;Warehouse&apos; THEN [warehouse_name] &#13;&#10;WHEN &apos;Date&apos; THEN [Calculation_1316739992897728514]&#13;&#10;WHEN &apos;abc&apos; THEN [unit_sales_contribution_bucket]&#13;&#10;ELSE &apos;-&apos; END' />
            </column>
            <column caption='Grouping 2' datatype='string' name='[Grouping 1 (copy)_1316739993139830798]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Grouping 1, parameter (copy)_1316739993139511306] &#13;&#10;WHEN &apos;Country&apos; THEN [country] &#13;&#10;WHEN &apos;Warehouse&apos; THEN [warehouse_name] &#13;&#10;WHEN &apos;Date&apos; THEN [Calculation_1316739992897728514]&#13;&#10;WHEN &apos;abc&apos; THEN [unit_sales_contribution_bucket]&#13;&#10;ELSE &apos;-&apos; END' />
            </column>
            <column caption='Availability metrics' datatype='real' default-format='p0%' name='[Grouping 1 (copy)_565764765920899073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Availability hourly, % (valid hours) Parameter] &#13;&#10;WHEN &apos;Availability weighted&apos; THEN [Calculation_5714856865202814976 1] &#13;&#10;WHEN &apos;Availability hourly, work hours&apos; THEN [Availability weighted, % (copy)_565764765919379456]&#13;&#10; END' />
            </column>
            <column caption='Predicted Qty Effective Idp.' datatype='real' name='[Predicted Qty Effective Idp (copy)_1127025870965051392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([predicted_qty_effective_idp])' />
            </column>
            <column caption='Available Hours Open Store' datatype='integer' name='[available_hours_open_store]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Dr Availability' datatype='real' name='[dr_availability]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1316739992897728514]' derivation='None' name='[none:Calculation_1316739992897728514:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_date]' derivation='None' name='[none:report_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[unit_sales_contribution_bucket]' derivation='None' name='[none:unit_sales_contribution_bucket:nk]' pivot='key' type='nominal' />
            <column-instance column='[warehouse_name]' derivation='None' name='[none:warehouse_name:nk]' pivot='key' type='nominal' />
            <column caption='Nr Availability' datatype='real' name='[nr_availability]' role='measure' type='quantitative' />
            <column caption='Potential Hours Open Store' datatype='integer' name='[potential_hours_open_store]' role='measure' type='quantitative' />
            <column caption='Predicted Qty Baseline Idp' datatype='real' name='[predicted_qty_baseline_idp]' role='measure' type='quantitative' />
            <column caption='Predicted Qty Corrected Idp' datatype='real' name='[predicted_qty_corrected_idp]' role='measure' type='quantitative' />
            <column caption='Predicted Qty Effective Idp' datatype='real' name='[predicted_qty_effective_idp]' role='measure' type='quantitative' />
            <column caption='Report Date' datatype='date' default-format='*yyyy-mm-dd' name='[report_date]' role='dimension' type='ordinal' />
            <column caption='Sold Qty' datatype='real' name='[sold_qty]' role='measure' type='quantitative' />
            <column-instance column='[Predicted Qty Effective Idp (copy)_1127025870965051392]' derivation='Sum' name='[sum:Predicted Qty Effective Idp (copy)_1127025870965051392:qk]' pivot='key' type='quantitative' />
            <column-instance column='[predicted_qty_baseline_idp]' derivation='Sum' name='[sum:predicted_qty_baseline_idp:qk]' pivot='key' type='quantitative' />
            <column-instance column='[predicted_qty_corrected_idp]' derivation='Sum' name='[sum:predicted_qty_corrected_idp:qk]' pivot='key' type='quantitative' />
            <column-instance column='[predicted_qty_effective_idp]' derivation='Sum' name='[sum:predicted_qty_effective_idp:qk]' pivot='key' type='quantitative' />
            <column-instance column='[sold_qty]' derivation='Sum' name='[sum:sold_qty:qk]' pivot='key' type='quantitative' />
            <column-instance column='[report_date]' derivation='Week-Trunc' name='[twk:report_date:ok]' pivot='key' type='ordinal' />
