    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Info'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/DM-Operations-SCM-IDPDashboardbrandnew/Info?rev=' id='Info' path='/t/GlobalStandardReporting/workbooks/DM-Operations-SCM-IDPDashboardbrandnew' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98000' id='3' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Business owner: Himanshu Raj Gupta</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Data owner: Tatiana Ovchinnikova</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Source: </run>
              <run fontcolor='#1a1a1a' fontname='Segoe UI' fontsize='10'>`dh-darkstores-stg.rl_dmart.idp_dashboard`</run>
              <run>Æ&#10;</run>
              <run auto-url='true' hyperlink='tabdoc:load-url url=&amp;quot;https://console.cloud.google.com/bigquery/scheduled-queries/locations/us/configs/65f8a0be-0000-26b7-a2e6-14c14ef1668c/runs?project=dh-darkstores-live&amp;quot;'>https://console.cloud.google.com/bigquery/scheduled-queries/locations/us/configs/65f8a0be-0000-26b7-a2e6-14c14ef1668c/runs?project=dh-darkstores-live</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Update: daily</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Scope: </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>- included data from 06.2023</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Metrics:</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Full Roll-out countries</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'> - countries, that had at least &gt; 80% of IPD PO Lines Rate for at least 4 weeks in a row  on country level.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Part Roll-out countries</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'> - countries, that had at least &gt; 10% of IPD PO Lines Rate for at least 4 weeks in a row  on country level.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Test Roll-out countrie</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>s - countries, that used IDP recomendation even once.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Start week 80</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'> - week, from which country started Full-roll-out OR after which it had 80% adoption rate &gt; 80% for 4 weeks</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Start week 10 </run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>- week, from which country started Part Roll-out OR after which it had  adoption rate &gt; 10% for 4 weeks</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Start week 0 </run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>- week, when the country created its first PO with IDP recomendation</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'> ------</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='10'>IDP PO Lines, % </run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>- IDP adoption rate - qty of PO lines (skus) created based on IDP</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'> recomendation / all PO lines created </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Unedited PO Lines, % </run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'>- qty of PO lines (skus) where order qty matches with recomendation qty / total qty of PO lines (skus) created based on IDP</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'> recomendation </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Segoe UI' fontsize='10'>Recomendation changes, % </run>
              <run fontcolor='#000000' fontname='Segoe UI' fontsize='10'> - show how significant are the changes in POs = SUM (ABS (recomended qty - ordered qty) / SUM(recomended qty ) - only for lines, where there was a change</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#1b1b1b' fontname='Segoe UI' fontsize='10'>WAPE</run>
              <run fontcolor='#1b1b1b' fontname='Segoe UI' fontsize='10'> calculated only for products with 100% hourly availability</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
