            <column caption='Grouping 1-1  high level' datatype='string' name='[Grouping 1 (copy) (copy) (copy) (copy)_1316739993139871761]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Grouping 4, parameter (copy)_1316739993139728397] &#13;&#10;WHEN &apos;Country&apos; THEN [country] &#13;&#10;WHEN &apos;Warehouse&apos; THEN [warehouse_name] &#13;&#10;WHEN &apos;Date&apos; THEN [Calculation_1316739992897728514]&#13;&#10;WHEN &apos;abc&apos; THEN [unit_sales_contribution_bucket]&#13;&#10;ELSE &apos;-&apos; END' />
