      <table>
        <view>
          <datasources>
            <datasource caption='idp_adoption_dashboard+ (rl_dmart)' name='federated.1mwwb1z0you2di1649fvl18dq21i' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Availability Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
            </column>
            <column caption='Region granularity, parameter' datatype='string' name='[Availability metrics, parameter (copy)_777152477674438657]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mwwb1z0you2di1649fvl18dq21i'>
            <column caption='Total Po Lines.' datatype='integer' name='[Calculation_1237364060026818560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_po_lines])' />
            </column>
            <column caption='date granularity' datatype='string' name='[Calculation_1316739992897728514]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Availability Parameter] &#13;&#10;WHEN &apos;day&apos; THEN STR(DATE(DATETRUNC(&apos;day&apos;, [report_date]))) &#13;&#10;WHEN &apos;week&apos; THEN STR(DATE(DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;)))&#13;&#10;WHEN &apos;# week&apos; THEN STR(DATEPART(&apos;year&apos;, [report_date])) +&quot;  &quot;+ STR(DATEPART(&apos;week&apos;, [report_date]))&#13;&#10;WHEN &apos;month&apos; THEN STR(DATE(DATETRUNC(&apos;month&apos;, [report_date])))  &#13;&#10;WHEN &apos;quarter&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;, [report_date]))) &#13;&#10;END' />
            </column>
            <column caption='Unedited PO lines, %' datatype='real' default-format='p0%' name='[Calculation_1468736494383734784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_matched_idp_po_lines])/SUM([idp_po_lines])' />
            </column>
            <column caption='Recomendation changes, %' datatype='real' default-format='p0%' name='[Calculation_1468736494395305988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([abs_diff_idp_recomendation])/SUM([sugested_po_qty_in_changed_recomendations])' />
            </column>
            <column caption='DOH' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_424745743098220544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stock_value_eur]) / SUM([cogs_eur])' />
            </column>
            <column caption='Availability weighted, %' datatype='real' default-format='p0%' name='[Calculation_5714856865202814976 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nr_availability])/SUM([dr_availability])' />
            </column>
            <column caption='Countries, Part Rollout &gt; 10%' datatype='integer' default-format='n#,##0;-#,##0' name='[Countries (copy)_1295066371870191623]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Dates after Start Week 0, flag (copy)_1295066371869978630] = TRUE THEN [country] END)' />
            </column>
            <column caption='Region granularity' datatype='string' name='[Date grouping (copy)_777152477675180034]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Availability metrics, parameter (copy)_777152477674438657]&#13;&#10;WHEN &apos;Region&apos; THEN [region]&#13;&#10;WHEN &apos;Entity&apos; THEN [management_entity]&#13;&#10;WHEN &apos;Country&apos; THEN [country]&#13;&#10;END' />
            </column>
            <column caption='Dates after Start Week 10, flag' datatype='boolean' name='[Dates after Start Week 0, flag (copy)_1295066371869978630]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [report_date] &gt;= [start_week_10] THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Spoilage, % revenue' datatype='real' default-format='p0.0%' name='[Shrinkage, % qty (copy)_253046066158903296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-SUM([shrinkage_eur])/SUM([total_retail_revenue])' />
            </column>
            <column caption='WAPE Corrected, A-segment' datatype='real' default-format='p0%' name='[WAPE Corrected (copy)_1521372253430464515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [unit_sales_contribution_bucket] = &apos;A&apos;THEN [rolling_forecast_error_corrected_filtered] END)/&#13;&#10;    SUM(IF [unit_sales_contribution_bucket] = &apos;A&apos;THEN [rolling_sales_filtered] END)' />
            </column>
            <column caption='WAPE Corrected' datatype='real' default-format='p0%' name='[WAPE effective (copy)_1468736494393143299]' role='measure' type='quantitative'>
