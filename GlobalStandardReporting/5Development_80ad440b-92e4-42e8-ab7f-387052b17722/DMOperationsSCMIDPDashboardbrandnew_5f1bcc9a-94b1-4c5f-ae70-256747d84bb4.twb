              <calculation class='tableau' formula='CASE [Parameters].[Grouping 2, parameter (copy)_1316739993139568651] &#13;&#10;WHEN &apos;Country&apos; THEN [country] &#13;&#10;WHEN &apos;Warehouse&apos; THEN [warehouse_name] &#13;&#10;WHEN &apos;Date&apos; THEN [Calculation_1316739992897728514]&#13;&#10;WHEN &apos;abc&apos; THEN [unit_sales_contribution_bucket]&#13;&#10;ELSE &apos;-&apos; END' />
