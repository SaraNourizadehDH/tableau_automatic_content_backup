      <column caption='Warehouses' datatype='string' name='[Calculation_1483373134671601664]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Availability metrics, parameter (copy)]&#13;&#10;WHEN &apos;Source Warehouse&apos; THEN [src_warehouse_name]&#13;&#10;WHEN &apos;Destination Warehouse&apos; THEN [dest_warehouse_name]&#13;&#10;END' />
