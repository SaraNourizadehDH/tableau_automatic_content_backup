      <column caption='IPD ST Lines, %' datatype='real' default-format='p0.0%' name='[Calculation_805299915137392640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([idp_st_lines]) /  SUM([total_st_lines])' />
      </column>
      <column caption='date granularity' datatype='string' name='[Calculation_805299915138207745]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Availability Parameter] &#13;&#10;WHEN &apos;day&apos; THEN STR(DATE(DATETRUNC(&apos;day&apos;, [created_at_date]))) &#13;&#10;WHEN &apos;week&apos; THEN STR(DATE(DATETRUNC(&apos;week&apos;, [created_at_date], &apos;monday&apos;)))&#13;&#10;WHEN &apos;# week&apos; THEN STR(DATEPART(&apos;year&apos;, [created_at_date])) +&quot;  &quot;+ STR(DATEPART(&apos;week&apos;, [created_at_date]))&#13;&#10;WHEN &apos;month&apos; THEN STR(DATE(DATETRUNC(&apos;month&apos;, [created_at_date])))  &#13;&#10;WHEN &apos;quarter&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;, [created_at_date]))) &#13;&#10;END' />
      </column>
      <column caption='Region granularity' datatype='string' name='[Calculation_805299915138560002]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Availability metrics, parameter (copy)_777152477674438657]&#13;&#10;WHEN &apos;Region&apos; THEN [region]&#13;&#10;WHEN &apos;Entity&apos; THEN [management_entity]&#13;&#10;WHEN &apos;Country&apos; THEN [country]&#13;&#10;END' />
      </column>
      <column caption='Last report date' datatype='date' name='[Calculation_805299915143413763]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([created_at_date])' />
      </column>
