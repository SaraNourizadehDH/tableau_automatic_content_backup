          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity, graph' datatype='string' name='[Date Granularity (copy 2)_1295066371837288449]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mwwb1z0you2di1649fvl18dq21i'>
            <column caption='DOH' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_424745743098220544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stock_value_eur]) / SUM([cogs_eur])' />
            </column>
            <column caption='Cogs Eur' datatype='real' name='[cogs_eur]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='date granularity, graph' datatype='string' name='[date granularity (copy)_1295066371836837888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy 2)_1295066371837288449] &#13;&#10;WHEN &apos;day&apos; THEN STR(DATE(DATETRUNC(&apos;day&apos;, [report_date]))) &#13;&#10;WHEN &apos;week&apos; THEN STR(DATE(DATETRUNC(&apos;week&apos;, [report_date], &apos;monday&apos;)))&#13;&#10;WHEN &apos;# week&apos; THEN STR(DATEPART(&apos;year&apos;, [report_date])) +&quot;  &quot;+ STR(DATEPART(&apos;week&apos;, [report_date]))&#13;&#10;WHEN &apos;month&apos; THEN STR(DATE(DATETRUNC(&apos;month&apos;, [report_date])))  &#13;&#10;WHEN &apos;quarter&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;, [report_date]))) &#13;&#10;END' />
            </column>
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[date granularity (copy)_1295066371836837888]' derivation='None' name='[none:date granularity (copy)_1295066371836837888:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_date]' derivation='None' name='[none:report_date:qk]' pivot='key' type='quantitative' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Report Date' datatype='date' default-format='*yyyy-mm-dd' name='[report_date]' role='dimension' type='ordinal' />
            <column caption='Stock Value Eur' datatype='real' name='[stock_value_eur]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_424745743098220544]' derivation='User' name='[usr:Calculation_424745743098220544:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1mwwb1z0you2di1649fvl18dq21i].[none:country:nk]' filter-group='12'>
            <groupfilter function='level-members' level='[none:country:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
