            <column-instance column='[Calculation_805299915138207745]' derivation='None' name='[none:Calculation_805299915138207745:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_805299915138560002]' derivation='None' name='[none:Calculation_805299915138560002:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
