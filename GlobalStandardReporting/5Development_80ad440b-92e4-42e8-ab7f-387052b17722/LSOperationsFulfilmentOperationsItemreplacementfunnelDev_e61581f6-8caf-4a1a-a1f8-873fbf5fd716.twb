                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2445' id='648' type-v2='text' w='72182' x='27091' y='84844'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def: </run>
                  <run fontcolor='#000000' fontname='Tableau Light'> The term &quot;Replaced Items GMV&quot; denotes the total savings achieved by substituting products when they were unavailable due to being out of stock</run>
                </formatted-text>
                <zone-style>
