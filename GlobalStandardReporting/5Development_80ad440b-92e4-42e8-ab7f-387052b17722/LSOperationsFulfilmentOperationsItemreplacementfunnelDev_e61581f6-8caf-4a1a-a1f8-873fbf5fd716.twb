                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>OverallMetricsTrend:</run>
                  <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> Understand the overall metric trends that are important for the experiment by comparing regions and countries </run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='dotted' />
