                <zone forceUpdate='true' h='2044' id='240' type-v2='text' w='72182' x='27091' y='53867'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def:</run>
                    <run fontcolor='#000000' fontname='Tableau Light'> Total number of confirmed orders/Items  processed on pelican device</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
