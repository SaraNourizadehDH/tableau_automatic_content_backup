                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2711' id='649' type-v2='text' w='26364' x='727' y='55911'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='12'>Eligible Ord/Item for replacement(all pelican vendors)</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2711' id='650' type-v2='text' w='72182' x='27091' y='55911'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def:</run>
                  <run fontcolor='#000000' fontname='Tableau Light'> Eligible orders/items for replacement are the total number of pelican orders that were Partial Fulfillment (PF) (alternatively, item is not found)  or failed due to Out of Stock (OOS) issues or replaced.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
