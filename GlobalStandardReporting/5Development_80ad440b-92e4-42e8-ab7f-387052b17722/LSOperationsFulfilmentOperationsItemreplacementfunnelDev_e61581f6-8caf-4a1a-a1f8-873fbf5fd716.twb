    <worksheet name='Item Timeline per KPI global'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Global</run>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ls_ops_ir_rl' name='federated.1ex1aqh01b3tvm1enjguy0hjrfl2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
              <aliases>
                <alias key='&quot;Day&quot;' value='Daily' />
                <alias key='&quot;Month&quot;' value='Monthly' />
                <alias key='&quot;Quarter&quot;' value='Quarterly' />
                <alias key='&quot;Week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column alias='% CVR1 - Eligible to initiated replacement' caption='Item Timeline metric' datatype='string' name='[Timeline metric (copy)_2010505394417131534]' param-domain-type='list' role='measure' type='nominal' value='&quot;5&quot;'>
              <calculation class='tableau' formula='&quot;5&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='% Picker Compliance Rate' />
                <alias key='&quot;10&quot;' value='% CVR4 - Confirmed to replaced' />
                <alias key='&quot;11&quot;' value='% Confirmation rate' />
                <alias key='&quot;12&quot;' value='% Rejection rate' />
                <alias key='&quot;13&quot;' value='% Expiration rate' />
                <alias key='&quot;14&quot;' value='% Replaced+Add Products from eligible' />
                <alias key='&quot;15&quot;' value='% Add Products from eligible' />
                <alias key='&quot;2&quot;' value='% Replaced from eligible' />
                <alias key='&quot;4&quot;' value='% Replaced from sent' />
                <alias key='&quot;5&quot;' value='% CVR1 - Eligible to initiated replacement' />
                <alias key='&quot;6&quot;' value='% CVR2 - Initiated replacement to sent' />
                <alias key='&quot;9&quot;' value='% CVR3 - Sent to Confirmed' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ex1aqh01b3tvm1enjguy0hjrfl2'>
            <column caption='Item % Confirmation Rate backend only' datatype='real' default-format='p0.0%' name='[% Confirmation Rate backend only (copy)_2010505394411159563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([be_customer_confirmed])/SUM([be_customer_sent])' />
            </column>
            <column caption='Item % Expiration Rate backend only' datatype='real' default-format='p0.0%' name='[% Expiration Rate backend only (copy)_2010505394411638797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([be_customer_expired])/SUM(be_customer_sent)' />
            </column>
            <column caption='Item % Rejection Rate backend only' datatype='real' default-format='p0.0%' name='[% Rejection Rate backend only (copy)_2010505394411270156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([be_customer_rejected])/SUM([be_customer_sent])' />
            </column>
            <column caption='Item % Replaced from eligible' datatype='real' default-format='p0.0%' name='[% Replaced from eligible (copy)_2010505394408988677]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum([Pelican Replacements Orders]) / sum([partial_orders_old] + [Failed Due To Oos])&#10;&#10;//New definition&#10;sum([replacements_pelican_items_v2]) / SUM([items_eligible_for_replacement_new_definition])&#10;//[Eligible orders for replacement Old]' />
            </column>
            <column caption='Item % Replaced from sent' datatype='real' default-format='p0.0%' name='[% Replaced from sent (copy)_2010505394410823689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [replacements_pelican_items_v2]&#10;    ELSE 0 END&#10;) / &#10;SUM(&#10;    IF [Calculation_5697757283087187968] = &apos;GIR-Phase2&apos; THEN [be_customer_sent]&#10;    ELSE 0 END&#10;)' />
            </column>
            <column caption='Item CVR1 - Eligible to initiated replacement' datatype='real' default-format='p0.0%' name='[CVR1 - Eligible to initiated replacement (copy)_2010505394403991552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([be_replacement_suggestion_qty])/SUM([items_eligible_for_replacement_new_definition])' />
            </column>
            <column caption='Item CVR2 - Initiated replacement to sent' datatype='real' default-format='p0.0%' name='[CVR2 - Initiated replacement to sent (copy)_2010505394404290561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([be_customer_sent])/SUM([be_replacement_suggestion_qty])' />
            </column>
            <column caption='Item CVR3 - Sent to Confirmed (plus talabat)' datatype='real' default-format='p0.0%' name='[CVR3 - Sent to Confirmed (plus talabat) (copy)_2010505394405126147]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUm([be_customer_confirmed])&#10;/SUM([be_customer_sent])' />
            </column>
            <column caption='Item CVR4 - Confirmed to replaced' datatype='real' default-format='p0.0%' name='[CVR4 - Confirmed to replaced (copy)_2010505394405224452]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(replacements_pelican_items_v2)/SUM(be_customer_sent) //Considers 100% max once might have miss-attribuition in flow' />
            </column>
            <column caption='concat_entity_country' datatype='string' name='[Calculation_167477668842803202]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;(&quot;+[management_entity]+&quot;) &quot; + [country]' />
            </column>
            <column caption='Pelican Replacement L30 Flag Boolean' datatype='string' name='[Calculation_2459950625618546688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [pelican_replacement_l30_flag] = 1 then &apos;1&apos; else &apos;0&apos; end' />
            </column>
            <column caption='Dynamic Date' datatype='date' name='[Calculation_3571213798266298371]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;, [local_date]) &#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;, [local_date])&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;, [local_date])  &#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [local_date]) &#10;END)' />
            </column>
            <column caption='pelican_replacement_l30_flag_cf' datatype='string' name='[Calculation_4113123466683564033]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [pelican_replacement_l30_flag] &gt; 0 then &apos;Yes&apos; else &apos;No&apos; end' />
            </column>
            <column caption='Replacement Flow Gir1&amp;2' datatype='string' name='[Calculation_5697757283087187968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF replacement_flow_gir_ph1_flag &gt; 0 then &apos;GIR-Phase1&apos; &#10;//ELSEIF replacement_flow_talabat_inapp_flag &gt; 0 then &apos;Talabat-inapp&apos; &#10;//ELSEIF replacement_flow_new_product_added_flag &gt; 0 then &apos;New-Product-Added&apos; &#10;//ELSEIF replacement_flow_custom_flow_replaced_flag &gt; 0 then &apos;Custom-Flow&apos; &#10;//ELSEIF replacement_flow_gir_ph2_flag &gt; 0 then &apos;GIR-Phase2&apos;&#10;//ELSE &apos;Others&apos;&#10;//END&#10;&#10;//If [Replacement Flow All] = &apos;GIR-Phase1&apos; then &apos;GIR-Phase1&apos;&#10;//ELSEIF [Replacement Flow All] = &apos;GIR-Phase2&apos; then &apos;GIR-Phase2&apos;&#10;//END&#10;&#10;If [Replacement Flow Gir1&amp;2 (copy)_6601854909039779842] = &apos;GIR-Phase1&apos; then &apos;GIR-Phase1&apos;&#10;ELSEIf [replacement_suggested_eligible_for_replacement] &gt; 0 and [replacement_sent_eligible_for_replacement] &gt; 0 then &apos;GIR-Phase2&apos;&#10;END' />
            </column>
            <column caption='Item % Replaced+Add Products from eligible ' datatype='real' default-format='p0.0%' name='[Item % Replaced from eligible (copy)_6507419991450529795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum([Pelican Replacements Orders]) / sum([partial_orders_old] + [Failed Due To Oos])&#10;&#10;//New definition&#10;sum([replacements_pelican_items_v2] + [replacement_flow_new_product_added_item_qty_sold_total]) / SUM(items_eligible_for_replacement_new_definition)&#10;//[Eligible orders for replacement Old]' />
            </column>
            <column caption='Item % Add Products from eligible' datatype='real' default-format='p0.0%' name='[Item % Replaced from eligible +Add Products (copy)_6507419991450976260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum([Pelican Replacements Orders]) / sum([partial_orders_old] + [Failed Due To Oos])&#10;&#10;//New definition&#10;sum([replacement_flow_new_product_added_item_qty_sold_total]) / SUM(items_eligible_for_replacement_new_definition)&#10;//[Eligible orders for replacement Old]' />
            </column>
            <column caption='Item Picker Compliance' datatype='real' default-format='p0.0%' name='[Picker Compliance (copy)_2010505394410926090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([be_customer_sent]) &#10;/SUM([items_eligible_for_replacement_new_definition])' />
            </column>
            <column caption='Replacement Flow All' datatype='string' name='[Replacement Flow Gir1&amp;2 (copy)_6601854909039779842]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF replacement_flow_gir_ph1_flag &gt; 0 then &apos;GIR-Phase1&apos;&#10;ELSEIF replacement_flow_gir_ph2_flag &gt; 0 then &apos;GIR-Phase2&apos;&#10;//ELSEIF replacement_flow_talabat_inapp_flag &gt; 0 then &apos;Talabat-inapp&apos;&#10;ELSEIF replacement_flow_talabat_inapp_flag &gt; 0 then &apos;GIR-Phase2&apos;&#10;ELSEIF replacement_flow_new_product_added_flag &gt; 0 then &apos;New-Product-Added&apos;&#10;ELSEIF replacement_flow_custom_flow_replaced_flag &gt; 0 then &apos;Custom-Flow&apos;&#10;ELSE &apos;Others&apos;&#10;END' />
            </column>
            <column caption='Item Timeline metric selection' datatype='real' default-format='p0.0%' name='[Timeline metric selection (copy)_2010505394417348623]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;1&apos; then [Picker Compliance (copy)_2010505394410926090]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;2&apos; then [% Replaced from eligible (copy)_2010505394408988677]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;3&apos; then [% Confirmation Rate backend only (copy)_2010505394411159563]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;4&apos; then [% Replaced from sent (copy)_2010505394410823689]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;5&apos; then [CVR1 - Eligible to initiated replacement (copy)_2010505394403991552]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;6&apos; then [CVR2 - Initiated replacement to sent (copy)_2010505394404290561]&#10;//ELSEIF [Timeline metric] = &apos;7&apos; then [CVR3 - Sent to Answered]&#10;//ELSEIF [Timeline metric] = &apos;8&apos; then [CVR4 - Answered to replaced]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;9&apos; then [CVR3 - Sent to Confirmed (plus talabat) (copy)_2010505394405126147]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;10&apos; then [CVR4 - Confirmed to replaced (copy)_2010505394405224452]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;11&apos; then [% Confirmation Rate backend only (copy)_2010505394411159563]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;12&apos; then [% Rejection Rate backend only (copy)_2010505394411270156]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;13&apos; then [% Expiration Rate backend only (copy)_2010505394411638797]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;14&apos; then [Item % Replaced from eligible (copy)_6507419991450529795]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;15&apos; then [Item % Replaced from eligible +Add Products (copy)_6507419991450976260]&#10;END' />
