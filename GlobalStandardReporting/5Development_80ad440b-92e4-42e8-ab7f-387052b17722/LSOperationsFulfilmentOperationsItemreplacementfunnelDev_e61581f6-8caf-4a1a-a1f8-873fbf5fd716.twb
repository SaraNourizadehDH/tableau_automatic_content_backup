              </zone>
              <zone forceUpdate='true' h='2489' id='301' type-v2='text' w='72637' x='26636' y='24400'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000'>Def:</run>
                  <run fontcolor='#000000'>Æ </run>
                  <run fontcolor='#000000' fontname='Tableau Light'>This rate is calculated by dividing the total number of partially fulfilled orders without replacement by the overall number of confirmed pelican orders</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#ffffff' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2356' id='447' type-v2='text' w='25909' x='727' y='29422'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='12'>Avg Sent Items</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2356' id='448' type-v2='text' w='72637' x='26636' y='29422'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000'>Def: </run>
                  <run fontcolor='#000000' fontname='Tableau Light'>This metric is calculated by dividing the total number of items sent by the total number of pelican orders made during a period.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
