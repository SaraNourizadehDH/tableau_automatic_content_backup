    <worksheet name='Item-CVR 3 and 4 global'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ls_ops_ir_rl' name='federated.1ex1aqh01b3tvm1enjguy0hjrfl2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
              <aliases>
                <alias key='&quot;Day&quot;' value='Daily' />
                <alias key='&quot;Month&quot;' value='Monthly' />
                <alias key='&quot;Quarter&quot;' value='Quarterly' />
                <alias key='&quot;Week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ex1aqh01b3tvm1enjguy0hjrfl2'>
            <column caption='# Replaced GIR 2' datatype='integer' name='[# Replaced GIR 1 (copy)_263108790774849546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if replacement_flow_gir_ph2_flag &gt; 0&#10; then [elg_pelican_replacement_orders] else 0 end)' />
            </column>
            <column caption='CVR3 - Sent to Confirmed' datatype='real' default-format='p0.0%' name='[CVR3 - Sent to Answered (copy)_253960857604853760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_answer_backend_eligible_for_replacement])/SUM([has_answer_backend_eligible_for_replacement])' />
            </column>
            <column caption='CVR3 - Sent to Confirmed (plus talabat)' datatype='real' default-format='p0.0%' name='[CVR3 - Sent to Confirmed (copy)_763852778203865092]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4792111541182627847]&#10;/SUM([replacement_sent_eligible_for_replacement])' />
            </column>
            <column caption='Item CVR3 - Sent to Confirmed (plus talabat)' datatype='real' default-format='p0.0%' name='[CVR3 - Sent to Confirmed (plus talabat) (copy)_2010505394405126147]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUm([be_customer_confirmed])&#10;/SUM([be_customer_sent])' />
            </column>
            <column caption='CVR4 - Confirmed to replaced' datatype='real' default-format='p0.0%' name='[CVR4 - Answered to replaced (copy)_253960857604853761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(1,[# Replaced GIR 1 (copy)_263108790774849546]/SUM([confirmed_answer_backend_eligible_for_replacement])) //Considers 100% max once might have miss-attribuition in flow' />
            </column>
            <column caption='Item CVR4 - Confirmed to replaced' datatype='real' default-format='p0.0%' name='[CVR4 - Confirmed to replaced (copy)_2010505394405224452]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(replacements_pelican_items_v2)/SUM(be_customer_sent) //Considers 100% max once might have miss-attribuition in flow' />
            </column>
            <column caption='concat_entity_country' datatype='string' name='[Calculation_167477668842803202]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;(&quot;+[management_entity]+&quot;) &quot; + [country]' />
            </column>
            <column caption='Pelican Replacement L30 Flag Boolean' datatype='string' name='[Calculation_2459950625618546688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [pelican_replacement_l30_flag] = 1 then &apos;1&apos; else &apos;0&apos; end' />
            </column>
            <column caption='Dynamic Date' datatype='date' name='[Calculation_3571213798266298371]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;, [local_date]) &#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;, [local_date])&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;, [local_date])  &#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [local_date]) &#10;END)' />
            </column>
            <column caption='pelican_replacement_l30_flag_cf' datatype='string' name='[Calculation_4113123466683564033]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [pelican_replacement_l30_flag] &gt; 0 then &apos;Yes&apos; else &apos;No&apos; end' />
            </column>
            <column caption='Confirmed BE + Talabat' datatype='integer' name='[Calculation_4792111541182627847]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_answer_backend_eligible_for_replacement])+SUM([replacement_answered_confirmed_eligible_for_replacement])' />
            </column>
            <column caption='Replacement Flow Gir1&amp;2' datatype='string' name='[Calculation_5697757283087187968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF replacement_flow_gir_ph1_flag &gt; 0 then &apos;GIR-Phase1&apos; &#10;//ELSEIF replacement_flow_talabat_inapp_flag &gt; 0 then &apos;Talabat-inapp&apos; &#10;//ELSEIF replacement_flow_new_product_added_flag &gt; 0 then &apos;New-Product-Added&apos; &#10;//ELSEIF replacement_flow_custom_flow_replaced_flag &gt; 0 then &apos;Custom-Flow&apos; &#10;//ELSEIF replacement_flow_gir_ph2_flag &gt; 0 then &apos;GIR-Phase2&apos;&#10;//ELSE &apos;Others&apos;&#10;//END&#10;&#10;//If [Replacement Flow All] = &apos;GIR-Phase1&apos; then &apos;GIR-Phase1&apos;&#10;//ELSEIF [Replacement Flow All] = &apos;GIR-Phase2&apos; then &apos;GIR-Phase2&apos;&#10;//END&#10;&#10;If [Replacement Flow Gir1&amp;2 (copy)_6601854909039779842] = &apos;GIR-Phase1&apos; then &apos;GIR-Phase1&apos;&#10;ELSEIf [replacement_suggested_eligible_for_replacement] &gt; 0 and [replacement_sent_eligible_for_replacement] &gt; 0 then &apos;GIR-Phase2&apos;&#10;END' />
            </column>
            <column caption='Replacement Flow All' datatype='string' name='[Replacement Flow Gir1&amp;2 (copy)_6601854909039779842]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF replacement_flow_gir_ph1_flag &gt; 0 then &apos;GIR-Phase1&apos;&#10;ELSEIF replacement_flow_gir_ph2_flag &gt; 0 then &apos;GIR-Phase2&apos;&#10;//ELSEIF replacement_flow_talabat_inapp_flag &gt; 0 then &apos;Talabat-inapp&apos;&#10;ELSEIF replacement_flow_talabat_inapp_flag &gt; 0 then &apos;GIR-Phase2&apos;&#10;ELSEIF replacement_flow_new_product_added_flag &gt; 0 then &apos;New-Product-Added&apos;&#10;ELSEIF replacement_flow_custom_flow_replaced_flag &gt; 0 then &apos;Custom-Flow&apos;&#10;ELSE &apos;Others&apos;&#10;END' />
            </column>
