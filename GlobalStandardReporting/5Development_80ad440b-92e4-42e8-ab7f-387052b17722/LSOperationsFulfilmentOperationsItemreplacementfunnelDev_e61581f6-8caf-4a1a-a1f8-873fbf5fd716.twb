              <zone forceUpdate='true' h='2622' id='489' type-v2='text' w='26364' x='727' y='82222'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='12'>Picker Compliance Rate</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
