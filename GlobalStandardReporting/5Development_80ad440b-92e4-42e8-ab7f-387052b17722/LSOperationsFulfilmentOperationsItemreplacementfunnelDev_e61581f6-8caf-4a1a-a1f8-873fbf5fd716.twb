                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2711' id='650' type-v2='text' w='72182' x='27091' y='55911'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def:</run>
                    <run fontcolor='#000000' fontname='Tableau Light'> Eligible orders/items for replacement are the total number of pelican orders that were Partial Fulfillment (PF) (alternatively, item is not found)  or failed due to Out of Stock (OOS) issues or replaced.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2667' id='242' type-v2='text' w='26364' x='727' y='58622'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Orders/Items triggered for Item Replacment</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2667' id='243' type-v2='text' w='72182' x='27091' y='58622'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000'>Def: </run>
                    <run fontcolor='#000000' fontname='Tableau Light'>The number of Pelican orders/items where the picker clicked on &apos;Item is out of stock&apos; to activate the item replacement flow</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2489' id='244' type-v2='text' w='26364' x='727' y='61289'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Replacement Started Ord/Item</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2489' id='245' type-v2='text' w='72182' x='27091' y='61289'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000'>Def: </run>
                    <run fontcolor='#000000' fontname='Tableau Light'>The number of pelican orders/items in which the picker clicked on &apos;</run>
                    <run fontcolor='#1f1f1f' fontname='Tableau Light'>Replace Items</run>
                    <run fontcolor='#000000' fontname='Tableau Light'>&apos; (indicating  replacement started by the picker on pelican app)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2755' id='246' type-v2='text' w='26364' x='727' y='63778'>
                  <formatted-text>
                    <run bold='true' fontcolor='#333333' fontsize='12'> Picker Picking Replacement Ord/Item (</run>
                    <run bold='true' fontcolor='#000000' fontsize='12'>SKU GridView Shown)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2755' id='247' type-v2='text' w='72182' x='27091' y='63778'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def: </run>
                    <run fontcolor='#000000' fontname='Tableau Light'>The number of Pelican orders/items in which the replacement flow was initiated, and the picker was presented with a grid view containing a list of SKU suggestions for item replacement</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2534' id='248' type-v2='text' w='26364' x='727' y='66533'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Replacement Ord/Item Scanner Open</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2534' id='249' type-v2='text' w='72182' x='27091' y='66533'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def: </run>
                    <run fontcolor='#000000' fontname='Tableau Light'>The number of Pelican orders/items within the replacement flow where the picker clicked on the scanner button to open the scanner for item scanning</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2533' id='250' type-v2='text' w='26364' x='727' y='69067'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Replacements Ord Vendor Catalogue</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2533' id='251' type-v2='text' w='72182' x='27091' y='69067'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def: </run>
                    <run fontcolor='#000000' fontname='Tableau Light'>The number of pelican orders in which a service call</run>
                    <run fontcolor='#1f1f1f' fontname='Tableau Light'> is returned from the Vendor Catalogue during the item replacement flow</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2267' id='840' type-v2='text' w='26364' x='727' y='71600'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Replacement Sent</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2267' id='841' type-v2='text' w='72182' x='27091' y='71600'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000'>Def: </run>
                    <run fontcolor='#000000'>The number of Pelican orders/items in which the replacement flow was initiated and the picker sent the selected SKU suggestion for item replacement to the customer</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='3155' id='842' type-v2='text' w='26364' x='727' y='73867'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Replacement Answered</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='3155' id='843' type-v2='text' w='72182' x='27091' y='73867'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000'>Def: </run>
                    <run fontcolor='#000000'>The number of Pelican orders/items in which 1)replacement flow was initiated 2)the picker sent the selected SKU suggestions to the customer 3) the customer responded with either &apos;Confirmed&apos; or &apos;Rejected&apos;. It&apos;s important to note that expired notifications are excluded from this step.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2400' id='252' type-v2='text' w='26364' x='727' y='77022'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Replaced Orders/Items</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2400' id='253' type-v2='text' w='72182' x='27091' y='77022'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def: </run>
                    <run fontcolor='#000000' fontname='Tableau Light'>The total number of pelican orders replaced [This data is derived from the backend data flow and not from the funnel events]</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2800' id='302' type-v2='text' w='26364' x='727' y='79422'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='12'>PickerCallingOrders(#Orders)(Rate)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2800' id='303' type-v2='text' w='72182' x='27091' y='79422'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000'>Def: (#Orders)(Rate)</run>
                    <run fontcolor='#000000' fontname='Tableau Light'>The metric is calculated by dividing the total number of Pelican orders where the picker clicked on &apos;Call Customer&apos; to confirm item replacement by the total number of Pelican orders where the picker clicked on &apos;Item is out of stock&apos; to activate the item replacement flow. [</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Excluding Talabat</run>
                    <run fontcolor='#000000' fontname='Tableau Light'>]</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2622' id='489' type-v2='text' w='26364' x='727' y='82222'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Picker Compliance Rate</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2622' id='490' type-v2='text' w='72182' x='27091' y='82222'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def: </run>
                    <run fontcolor='#000000' fontname='Tableau Light'>The rate is calculated by dividing the  number of pelican orders where picker clicks on replace item from the total number of pelican orders eligible for replacement(Partial Fulfillment (PF) or failed due to Out of Stock (OOS) or replaced)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2445' id='647' type-v2='text' w='26364' x='727' y='84844'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Replaced Items GMV(Eur)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2445' id='648' type-v2='text' w='72182' x='27091' y='84844'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def: </run>
                    <run fontcolor='#000000' fontname='Tableau Light'> The term &quot;Replaced Items GMV&quot; denotes the total savings achieved by substituting products when they were unavailable due to being out of stock</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2711' id='540' type-v2='text' w='98546' x='727' y='87289'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='15'>Special Filters</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#9a3c40' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2533' id='542' type-v2='text' w='26273' x='727' y='90000'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000cc' fontsize='12'>FP Pilot Vendors</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2533' id='541' type-v2='text' w='72273' x='27000' y='90000'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def: </run>
                    <run fontcolor='#000000' fontname='Tableau Light'>This filter includes both pilot and non-pilot vendors from food panda. Use this to exlude  the non-pilot vendors with a single click.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2534' id='543' type-v2='text' w='26273' x='727' y='92533'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000cc' fontsize='12'>Has Active Replacement(&gt;1 ord L30)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='2534' id='544' type-v2='text' w='72273' x='27000' y='92533'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def: </run>
                    <run fontcolor='#000000' fontname='Tableau Light'>This filter is designated to flag the vendors who had active item replacement in the last 30 days</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='3052' id='838' type-v2='text' w='26273' x='727' y='95067'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='12'>Replacement Flow GIR P1 &amp; P2</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='3052' id='839' type-v2='text' w='72273' x='27000' y='95067'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000'>Def:</run>
                    <run fontcolor='#000000'> This filter is used to distinguish between global item replacement phases 1 and 2. Note: The initial stages of the funnel for phases 1 and 2 are identical, with the exception of the final three steps, beginning from &apos;replacement sent&apos; step.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#f5f5f5' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{D5F86CBE-8679-4D3B-9A11-F3B44E40DAFF}' />
    </dashboard>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='OverallMetricsTrend'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/LS-Operations-FulfilmentOperations-Itemreplacementfunnel/OverallMetricsTrend?rev=' id='OverallMetricsTrend' path='/t/GlobalStandardReporting/workbooks/LS-Operations-FulfilmentOperations-ItemreplacementfunnelDev' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_24' value='left' />
        </style-rule>
      </style>
      <size maxheight='1800' maxwidth='1100' minheight='1800' minwidth='1100' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='ls_ops_ir_rl' name='federated.1ex1aqh01b3tvm1enjguy0hjrfl2' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column alias='Daily' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
          <calculation class='tableau' formula='&quot;Day&quot;' />
          <aliases>
            <alias key='&quot;Day&quot;' value='Daily' />
            <alias key='&quot;Month&quot;' value='Monthly' />
            <alias key='&quot;Quarter&quot;' value='Quarterly' />
            <alias key='&quot;Week&quot;' value='Weekly' />
          </aliases>
          <members>
            <member alias='Daily' value='&quot;Day&quot;' />
            <member alias='Weekly' value='&quot;Week&quot;' />
            <member alias='Monthly' value='&quot;Month&quot;' />
            <member alias='Quarterly' value='&quot;Quarter&quot;' />
          </members>
        </column>
        <column caption='Select Metrics(PELICAN ORDERS)' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;(\%)Items Replaced from Eligible&quot;'>
          <calculation class='tableau' formula='&quot;(%)Items Replaced from Eligible&quot;' />
          <aliases>
            <alias key='&quot;(\%)Eligible orders replaced&quot;' value='(%)Orders Replacements from Eligible' />
            <alias key='&quot;(\%)orders triggered for IR&quot;' value='(%)Orders triggered for IR' />
            <alias key='&quot;(\%)Orders w replacement started&quot;' value='(%)Orders w replacement started' />
            <alias key='&quot;\%Pelican Contacted Order&quot;' value='(%)Contact Rate' />
            <alias key='&quot;ABV&quot;' value='(€)ABV Sent' />
            <alias key='&quot;Avg Order Items&quot;' value='Avg Order Items' />
            <alias key='&quot;OOS GMV Loss&quot;' value='(€)OOS GMV Loss' />
            <alias key='&quot;OOS vendor fail rate&quot;' value='(%)OOS fail rate' />
            <alias key='&quot;Pelican Partial fulfillment rate&quot;' value='(%)PF Rate(new)' />
            <alias key='&quot;Pelican Partial fulfillment rate old&quot;' value='(%)PF Rate(old)' />
            <alias key='&quot;Picker Compliance Rate&quot;' value='(%)Picker Compliance Rate' />
          </aliases>
          <members>
            <member alias='(€)OOS GMV Loss' value='&quot;OOS GMV Loss&quot;' />
            <member alias='(%)OOS fail rate' value='&quot;OOS vendor fail rate&quot;' />
            <member alias='(%)PF Rate(new)' value='&quot;Pelican Partial fulfillment rate&quot;' />
            <member alias='(%)PF Rate(old)' value='&quot;Pelican Partial fulfillment rate old&quot;' />
            <member alias='Avg Order Items' value='&quot;Avg Order Items&quot;' />
            <member value='&quot;Avg Sent Items&quot;' />
            <member alias='(%)Orders Replacements from Eligible' value='&quot;(\%)Eligible orders replaced&quot;' />
            <member value='&quot;(\%)Items Replaced from Eligible&quot;' />
            <member alias='(%)Orders triggered for IR' value='&quot;(\%)orders triggered for IR&quot;' />
            <member alias='(%)Picker Compliance Rate' value='&quot;Picker Compliance Rate&quot;' />
            <member alias='(%)Orders w replacement started' value='&quot;(\%)Orders w replacement started&quot;' />
            <member alias='(%)Contact Rate' value='&quot;\%Pelican Contacted Order&quot;' />
            <member alias='(€)ABV Sent' value='&quot;ABV&quot;' />
            <member value='&quot;(\%)Fill Rate&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1ex1aqh01b3tvm1enjguy0hjrfl2'>
        <column caption='Dynamic Date' datatype='date' name='[Calculation_3571213798266298371]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Day&apos; THEN DATETRUNC(&apos;day&apos;, [local_date]) &#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;, [local_date])&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;, [local_date])  &#10;WHEN &apos;Quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [local_date]) &#10;END)' />
