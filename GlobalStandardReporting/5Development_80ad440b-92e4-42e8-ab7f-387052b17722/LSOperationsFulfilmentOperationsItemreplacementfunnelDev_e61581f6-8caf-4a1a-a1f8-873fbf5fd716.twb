              <zone forceUpdate='true' h='2400' id='197' type-v2='text' w='25909' x='727' y='17422'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='12'>(€)</run>
                  <run bold='true' fontcolor='#000000' fontsize='12'>OOS GMV Loss</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2400' id='198' type-v2='text' w='72637' x='26636' y='17422'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def:</run>
                  <run fontcolor='#000000' fontname='Tableau Light'>  The OOS GMV loss refers to the total Gross Merchandise Value (GMV) lost due to orders that are either partially fulfilled or unable to be fulfilled because the items are out of stock (OOS). </run>
                  <run>Æ&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2267' id='199' type-v2='text' w='25909' x='727' y='19822'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='12'>(%)OOS fail rate</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2267' id='200' type-v2='text' w='72637' x='26636' y='19822'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000'>Def:</run>
                  <run fontcolor='#000000'>Æ </run>
                  <run fontcolor='#000000' fontname='Tableau Light'>Percentage of orders that fail due to vendor Out of Stock (OOS) issues, calculated by dividing the total number of failed orders caused by vendor OOS by the total number of orders placed.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2400' id='202' type-v2='text' w='72637' x='26636' y='36756'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def: </run>
                  <run fontcolor='#000000' fontname='Tableau Light'>The rate is calculated by dividing the number of pelican orders where picker send the suggestion to the customer from the total number of pelican orders eligible for replacement(Partial Fulfillment (PF) or failed due to Out of Stock (OOS) or replaced)</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2533' id='203' type-v2='text' w='25909' x='727' y='26889'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='12'>Avg Order Items</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2533' id='204' type-v2='text' w='72637' x='26636' y='26889'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000'>Def: </run>
                  <run fontcolor='#000000' fontname='Tableau Light'>This metric is calculated by dividing the total number of items ordered by the total number of pelican orders made during a period.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2356' id='205' type-v2='text' w='25909' x='727' y='34400'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='12'>(%)Orders triggered for IR</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2356' id='206' type-v2='text' w='72637' x='26636' y='34400'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000'>Def:</run>
                  <run fontcolor='#000000'>Æ </run>
                  <run fontcolor='#000000' fontname='Benton Sans Book'>Æ </run>
                  <run fontcolor='#000000' fontname='Tableau Light'>The rate calculated by dividing the number of Pelican orders in which the picker clicked on &quot;Item is &apos;out of stock&apos;&quot; (indicating eligibility for replacement) by the total number of Pelican orders placed. </run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2311' id='207' type-v2='text' w='25909' x='727' y='39156'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='12'>(%)Orders w replacement started</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2311' id='208' type-v2='text' w='72637' x='26636' y='39156'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000'>Def:</run>
                  <run fontcolor='#000000'>Æ </run>
                  <run fontcolor='#000000' fontname='Tableau Light'>The rate calculated by dividing the number of Pelican orders in which the picker clicks on &apos;Replace Items&apos; (indicating initiation for replacement) by the total number of Pelican orders placed.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2355' id='209' type-v2='text' w='25909' x='727' y='41467'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='12'>(%)Contact Rate</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2355' id='210' type-v2='text' w='72637' x='26636' y='41467'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000'>Def: </run>
                  <run fontcolor='#000000' fontname='Benton Sans Book'>T</run>
                  <run fontcolor='#000000' fontname='Tableau Light'>he rate calculated by dividing the number of Pelican orders that are contacted for reasons such as &apos;Out of Stock item(s)&apos;, &apos;Issue with item replacement process&apos;, &apos;Missing item&apos;, or &apos;Wrong item&apos; by the total number of Pelican orders placed.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='2622' id='212' type-v2='text' w='72637' x='26636' y='31778'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Light'>Def:</run>
                  <run fontcolor='#000000' fontname='Tableau Light'> The rate calculated by dividing the number of replaced pelican orders from the total number of orders that were Partial Fulfillment (PF) or failed due to Out of Stock (OOS) issues or replaced.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5f5f5' />
                </zone-style>
              </zone>
