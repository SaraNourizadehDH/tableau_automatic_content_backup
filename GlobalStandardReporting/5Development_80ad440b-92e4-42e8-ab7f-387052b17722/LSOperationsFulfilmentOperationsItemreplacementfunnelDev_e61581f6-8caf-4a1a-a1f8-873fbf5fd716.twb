      <column datatype='real' name='[Gmv_lost_due_to_OOS_pelican]' role='measure' type='quantitative' />
      <column caption='Item % Replaced+Add Products from eligible ' datatype='real' default-format='p0.0%' name='[Item % Replaced from eligible (copy)_6507419991450529795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//sum([Pelican Replacements Orders]) / sum([partial_orders_old] + [Failed Due To Oos])&#10;&#10;//New definition&#10;sum([replacements_pelican_items_v2] + [replacement_flow_new_product_added_item_qty_sold_total]) / SUM(items_eligible_for_replacement_new_definition)&#10;//[Eligible orders for replacement Old]' />
      </column>
      <column caption='Item % Add Products from eligible' datatype='real' default-format='p0.0%' name='[Item % Replaced from eligible +Add Products (copy)_6507419991450976260]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//sum([Pelican Replacements Orders]) / sum([partial_orders_old] + [Failed Due To Oos])&#10;&#10;//New definition&#10;sum([replacement_flow_new_product_added_item_qty_sold_total]) / SUM(items_eligible_for_replacement_new_definition)&#10;//[Eligible orders for replacement Old]' />
      </column>
      <column caption='Pelican Partial fulfillment rate' datatype='real' name='[OOS Partial fulfillment rate (copy)_1707779084885458945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([all_pelican_partially_fulfilled])/sum(pelican_confirmed_orders)' />
      </column>
      <column caption='OOS Pelican Partial fulfillment rate' datatype='real' name='[OOS Partial fulfillment rate with replacements (copy)_1707779084884619264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([partial_orders_due_to_oos_pelican])/sum([pelican_confirmed_orders])' />
      </column>
      <column caption='Pelican Partial fulfillment rate(Old)' datatype='real' name='[OOS Pelican Partial fulfillment rate (copy)_5391653226446458884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([partial_orders_old])/sum([pelican_confirmed_orders])' />
      </column>
      <column caption='Item Picker Compliance' datatype='real' default-format='p0.0%' name='[Picker Compliance (copy)_2010505394410926090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([be_customer_sent]) &#10;/SUM([items_eligible_for_replacement_new_definition])' />
      </column>
      <column caption='Call Initiated exclude talabat' datatype='integer' name='[PickerCallingRate exclude talabat (copy)_5391653226120253440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [management_entity] = &apos;Talabat&apos; &#10;  THEN 0&#10;ELSE&#10;    [call_initiated]&#10;END)' />
      </column>
      <column caption='Replacement Flow All' datatype='string' name='[Replacement Flow Gir1&amp;2 (copy)_6601854909039779842]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF replacement_flow_gir_ph1_flag &gt; 0 then &apos;GIR-Phase1&apos;&#10;ELSEIF replacement_flow_gir_ph2_flag &gt; 0 then &apos;GIR-Phase2&apos;&#10;//ELSEIF replacement_flow_talabat_inapp_flag &gt; 0 then &apos;Talabat-inapp&apos;&#10;ELSEIF replacement_flow_talabat_inapp_flag &gt; 0 then &apos;GIR-Phase2&apos;&#10;ELSEIF replacement_flow_new_product_added_flag &gt; 0 then &apos;New-Product-Added&apos;&#10;ELSEIF replacement_flow_custom_flow_replaced_flag &gt; 0 then &apos;Custom-Flow&apos;&#10;ELSE &apos;Others&apos;&#10;END' />
      </column>
      <column caption='Item Timeline metric selection' datatype='real' default-format='p0.0%' name='[Timeline metric selection (copy)_2010505394417348623]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;1&apos; then [Picker Compliance (copy)_2010505394410926090]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;2&apos; then [% Replaced from eligible (copy)_2010505394408988677]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;3&apos; then [% Confirmation Rate backend only (copy)_2010505394411159563]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;4&apos; then [% Replaced from sent (copy)_2010505394410823689]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;5&apos; then [CVR1 - Eligible to initiated replacement (copy)_2010505394403991552]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;6&apos; then [CVR2 - Initiated replacement to sent (copy)_2010505394404290561]&#10;//ELSEIF [Timeline metric] = &apos;7&apos; then [CVR3 - Sent to Answered]&#10;//ELSEIF [Timeline metric] = &apos;8&apos; then [CVR4 - Answered to replaced]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;9&apos; then [CVR3 - Sent to Confirmed (plus talabat) (copy)_2010505394405126147]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;10&apos; then [CVR4 - Confirmed to replaced (copy)_2010505394405224452]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;11&apos; then [% Confirmation Rate backend only (copy)_2010505394411159563]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;12&apos; then [% Rejection Rate backend only (copy)_2010505394411270156]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;13&apos; then [% Expiration Rate backend only (copy)_2010505394411638797]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;14&apos; then [Item % Replaced from eligible (copy)_6507419991450529795]&#10;ELSEIF [Parameters].[Timeline metric (copy)_2010505394417131534] = &apos;15&apos; then [Item % Replaced from eligible +Add Products (copy)_6507419991450976260]&#10;END' />
      </column>
