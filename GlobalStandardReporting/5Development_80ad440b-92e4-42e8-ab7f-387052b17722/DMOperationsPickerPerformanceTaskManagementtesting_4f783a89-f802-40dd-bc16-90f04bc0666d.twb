      <aliases enabled='yes' />
      <column caption='#f LOD total shifts' datatype='integer' name='[#f LOD total time (copy)_2083759292400291841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [region], [country], [store_name] : COUNTD([shift_id])}' />
      </column>
      <column caption='#cap total task time' datatype='real' name='[Calculation_121667604408750080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([task_time_s],28800)' />
      </column>
      <column caption='#total time' datatype='real' default-format='*hh:mm' name='[Calculation_1542694016974442496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_121667604408750080])/24/60/60' />
      </column>
      <column caption='#shifts' datatype='integer' name='[Calculation_1542694016974528513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([shift_id])' />
      </column>
      <column caption='total time per shift' datatype='real' default-format='*h&quot;h&quot;:mm&quot;m&quot;' name='[Calculation_1542694016974843906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1542694016974442496]/[Calculation_1542694016974528513]' />
      </column>
      <column caption='#f LOD total time' datatype='real' name='[Calculation_2083759292399845376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [region], [country], [store_name] : SUM([Calculation_121667604408750080])}/60/24/60' />
      </column>
      <column aggregation='Avg' caption='#LOD total time per shift' datatype='real' default-format='*h&quot;h&quot;:mm&quot;m&quot;' name='[Calculation_2083759292400439298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2083759292399845376]/[#f LOD total time (copy)_2083759292400291841]' />
      </column>
      <column caption='task title = idle time' datatype='integer' name='[Calculation_2083759292404858883]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IIF ([task_title] = &quot;Idle time&quot;, &#10;    [shift_id],NULL)&#10;)' />
      </column>
      <column caption='#total time per idle time' datatype='real' name='[Calculation_2083759292405784580]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1542694016974442496]/[Calculation_2083759292404858883]' />
      </column>
