            <column caption='Tasks per shfit' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_267471614737887241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tasks])/SUM([Calculation_267471614736625672])' />
