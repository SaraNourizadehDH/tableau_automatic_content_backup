    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Definitions'>
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_6' value='top' />
        </style-rule>
      </style>
      <size maxheight='1000' maxwidth='1000' minheight='1000' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='13875' id='3' is-scaled='1' param='Image/Delivery-Hero-Comet.png' type-v2='bitmap' w='11500' x='1000' y='1250' />
        <zone forceUpdate='true' h='15875' id='4' type-v2='text' w='58300' x='14400' y='1000'>
          <formatted-text>
            <run fontcolor='#e15759' fontsize='32'>Picker Task Management</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#606b76' fontsize='12'>QUICK-COMMERCE</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='4' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='5750' id='5' type-v2='text' w='42000' x='1200' y='16375'>
          <formatted-text>
            <run bold='true' fontcolor='#e15759' fontsize='18'>Metrics: </run>
            <run fontcolor='#ea565f' fontsize='14' italic='true'>Definitions &amp; Calculations</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='4' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='68700' id='6' type-v2='text' w='80200' x='800' y='22400'>
          <formatted-text>
            <run fontcolor='#606b76' fontsize='11'>‣# </run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>Total warehouses: </run>
            <run fontcolor='#606b76' fontsize='11'>#Qty of total warehouses active in last 30 days</run>
            <run>Æ&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>COUNT(DISTINCT warehouse_id)</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>‣# </run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>Warehouses with completed task: </run>
            <run fontcolor='#606b76' fontsize='11'>#Qty of warehouses with at least one completed task</run>
            <run>Æ&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>COUNT(DISTINCT IF [Task Status] = &apos;COMPLETE&apos; warehouse_id)</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>‣# </run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>Warehouses with any tasks: </run>
            <run fontcolor='#606b76' fontsize='11'>#Qty of warehouses with any task created</run>
            <run>Æ&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>COUNT(DISTINCT IF NULL [Task Status] THEN NULL ELSE warehouse_id)</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>‣# </run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>Warehouses with no completed task (non-adopting warehouses): </run>
            <run fontcolor='#606b76' fontsize='11'>#Qty of warehouses with no completed task</run>
            <run>Æ&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>Total warehouses - Warehouses with completed task</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>‣ </run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>% Warehouses with completed task: </run>
            <run fontcolor='#606b76' fontsize='11'>% of warehouses (from total) with at least one completed task</run>
            <run>Æ&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>Warehouses with completed task / Total warehouses</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>‣ # Tasks: </run>
            <run fontcolor='#606b76' fontsize='11'>Quantity of tasks created</run>
            <run>Æ&#10;</run>
            <run fontsize='11'>SUM(Tasks)</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>‣ #</run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>Shifts: </run>
            <run fontcolor='#606b76' fontsize='11'>Quantity of shifts with at least one task associated to it</run>
            <run>Æ&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>COUNT(DISTINCT shift_id)</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>‣ </run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>Tasks per shift: </run>
            <run fontcolor='#606b76' fontsize='11'>#Quantity of tasks in each shift on average</run>
            <run>Æ&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>#Tasks/#Shifts</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>‣ </run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>Task type: </run>
            <run fontcolor='#606b76' fontsize='11'>Splitted in task mgmt generated (temperature checking, SKU management, cleaning...) ; business related (picking, packing, receiving, cycle count) and idle time</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#606b76' fontsize='11'>‣ </run>
            <run bold='true' fontcolor='#606b76' fontsize='11'>Idle time</run>
            <run fontcolor='#606b76' fontsize='11'>: Difference between Worked hours (from Rooster) and (task management generated + business related)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='11'>Note</run>
            <run fontsize='11'>: only considers those shifts that have at least one task associated</run>
            <run>Æ&#10;</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='4' />
            <format attr='background-color' value='#f5f5f586' />
          </zone-style>
        </zone>
      </zones>
