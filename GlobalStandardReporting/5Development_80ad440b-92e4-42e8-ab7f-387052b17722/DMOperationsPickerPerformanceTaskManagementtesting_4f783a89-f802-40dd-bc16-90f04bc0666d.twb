      <aliases enabled='yes' />
      <column caption='#d active countries' datatype='integer' default-format='n#,##0;-#,##0' name='[# d warehouses (copy)_267471614725832710]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF[tasks] &gt; 0 THEN [global_entity_id] ELSE NULL END)' />
      </column>
      <column caption='#d warehouses (total)' datatype='integer' default-format='n#,##0;-#,##0' name='[# d warehouses (copy)_3865636623214194690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( [global_warehouse_id])' />
      </column>
      <column caption='# Non-active warehouses' datatype='integer' default-format='n#,##0;-#,##0' name='[# d warehouses (total) (copy)_3865636623216156675]' role='measure' type='quantitative'>
