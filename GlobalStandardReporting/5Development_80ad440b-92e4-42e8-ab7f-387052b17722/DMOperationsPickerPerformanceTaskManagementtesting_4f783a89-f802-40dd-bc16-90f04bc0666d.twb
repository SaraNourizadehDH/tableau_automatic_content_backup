      </column>
      <column caption='#date First task country' datatype='string' name='[#date First task date (copy)_2605895376980951042]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR({ FIXED [country] : MIN(IF [task_status] = &apos;COMPLETE&apos; THEN [task_date] END) })' />
      </column>
      <column caption='#date First task region' datatype='string' name='[#date First task date country (copy)_2605895376982994947]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
