              <calculation class='tableau' formula='IF [task_title] IN (&apos;Food / Temperature Check&apos;, &apos;Cleaning&apos;, &apos;Expiry Management&apos;, &apos;Replenishment&apos;, &apos;Adminsterial Works&apos;, &apos;Organising&apos;, &apos;Break Time&apos;,&apos;Order Monitoring&apos;) THEN 0&#10;ELSE [tasks]&#10;END' />
            </column>
            <column caption='#tasks Break Time' datatype='integer' name='[#tasks Adminsterial Works (copy) (copy)_425168000600367113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [task_title] = &apos;Break Time&apos; THEN [tasks] ELSE 0 END' />
            </column>
            <column caption='#tasks Organising' datatype='integer' name='[#tasks Adminsterial Works (copy)_425168000600338440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [task_title] = &apos;Organising&apos; THEN [tasks] ELSE 0 END' />
            </column>
            <column caption='#tasks Adminsterial Works' datatype='integer' name='[#tasks temp check (copy) (copy) (copy) (copy)_425168000599756806]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [task_title] = &apos;Adminsterial Works&apos; THEN [tasks] ELSE 0 END' />
            </column>
            <column caption='#tasks replenishment' datatype='integer' name='[#tasks temp check (copy) (copy) (copy)_425168000599744517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [task_title] = &apos;Replenishment&apos; THEN [tasks] ELSE 0 END' />
            </column>
            <column caption='#tasks expiry mgmt' datatype='integer' name='[#tasks temp check (copy) (copy)_425168000599736324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [task_title] = &apos;Expiry Management&apos; THEN [tasks] ELSE 0 END' />
            </column>
            <column caption='#tasks cleaning' datatype='integer' name='[#tasks temp check (copy)_425168000599728131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [task_title] = &apos;Cleaning&apos; THEN [tasks] ELSE 0 END' />
            </column>
            <column caption='#countries w/ completed tasks' datatype='integer' name='[#whouse w/ completed tasks (copy)_94927468562153476]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF {FIXED [task_date],[region],[country] : MAX(IF [task_status] = &apos;COMPLETE&apos; &#10;                                THEN 1 ELSE 0 END)} = 1 &#10;                                    THEN [country] END)' />
            </column>
            <column caption='%whouses w. completed task' datatype='real' default-format='p0%' name='[%f adopting warehouses (copy)_3865636623214088193]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_94927468510826497]/ [# d warehouses (copy)_3865636623214194690]' />
            </column>
            <column caption='Date' datatype='datetime' default-format='*dd.mm.yy' name='[Calculation_121667604491931652]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &apos;day&apos; THEN DATETRUNC(&apos;day&apos;, [task_date]) &#10;WHEN &apos;week&apos; THEN DATETRUNC(&apos;week&apos;, [task_date])&#10;WHEN &apos;month&apos; THEN DATETRUNC(&apos;month&apos;, [task_date])  &#10;WHEN &apos;quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [task_date]) &#10;END' />
            </column>
            <column caption='#f Non-active warehouses' datatype='integer' name='[Calculation_1851964636288630788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# d warehouses (copy)_3865636623214194690] - [Calculation_94927468510826497]' />
            </column>
            <column caption='#date First task warehouse' datatype='string' name='[Calculation_1851964636290678790]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR({ FIXED [country], [global_warehouse_id] : MIN(IF [task_status] = &apos;COMPLETE&apos; THEN [task_date] END) })' />
            </column>
            <column caption='#d active warehouses' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2559522349828423681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF[tasks] &gt; 0 THEN [global_warehouse_id] ELSE NULL END)' />
            </column>
            <column caption='Completed at least 1 task' datatype='boolean' name='[Calculation_2605895376984465412]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(ISNULL([Calculation_1851964636290678790]),FALSE,TRUE)' />
            </column>
            <column caption='# Agg shifts' datatype='integer' name='[Calculation_267471614736625672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_warehouse_id], [task_date], [global_entity_id] : MAX([shifts])}' />
            </column>
            <column caption='Tasks per shfit' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_267471614737887241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tasks])/SUM([Calculation_267471614736625672])' />
            </column>
            <column caption='#tasks temp check' datatype='integer' name='[Calculation_425168000599420930]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [task_title] = &apos;Food / Temperature Check&apos; THEN [tasks] ELSE 0 END' />
            </column>
            <column caption='#whouse w/ completed tasks' datatype='integer' name='[Calculation_94927468510826497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [task_status] = &apos;COMPLETE&apos; &#10;&#10;                                    THEN [global_warehouse_id] END)' />
            </column>
            <column caption='# Total countries' datatype='integer' name='[Calculation_94927468561502211]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([country])' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
