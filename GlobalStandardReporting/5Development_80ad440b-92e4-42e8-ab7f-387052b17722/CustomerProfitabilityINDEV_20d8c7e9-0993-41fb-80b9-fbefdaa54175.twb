            </column>
            <column caption='Frequency' datatype='real' name='[Calculation_3632856790859169794]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_559501885255647232] / [Calculation_508554914459754496]' />
            </column>
            <column caption='# Customers' datatype='integer' name='[Calculation_508554914459754496]' role='measure' type='quantitative'>
