    <worksheet name='Customer Table - ABV Tiers'>
      <table>
        <view>
          <datasources>
            <datasource caption='pede_qc_customer_profitability (dev_dmart)' name='federated.0dnlnmx0lsse1t0zy19kh19r3zt7' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='ABV Tier 5' datatype='integer' default-format='N' folder-name='ABV Tiers' name='[BV Tier 1 (copy) (copy) (copy) (copy)_508554914460753924]' param-domain-type='any' role='measure' type='quantitative' value='15'>
              <calculation class='tableau' formula='15' />
            </column>
            <column caption='ABV Tier 4' datatype='integer' default-format='N' folder-name='ABV Tiers' name='[BV Tier 1 (copy) (copy) (copy)_508554914460741635]' param-domain-type='any' role='measure' type='quantitative' value='11'>
              <calculation class='tableau' formula='11' />
            </column>
            <column caption='ABV Tier 3' datatype='integer' default-format='N' folder-name='ABV Tiers' name='[BV Tier 1 (copy) (copy)_508554914460729346]' param-domain-type='any' role='measure' type='quantitative' value='8'>
              <calculation class='tableau' formula='8' />
            </column>
            <column caption='ABV Tier 2' datatype='integer' default-format='N' folder-name='ABV Tiers' name='[BV Tier 1 (copy)_508554914460717057]' param-domain-type='any' role='measure' type='quantitative' value='6'>
              <calculation class='tableau' formula='6' />
            </column>
            <column caption='ABV Tier 1' datatype='integer' default-format='N' folder-name='ABV Tiers' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='4'>
              <calculation class='tableau' formula='4' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0dnlnmx0lsse1t0zy19kh19r3zt7'>
            <column caption='# of Free DF Orders' datatype='integer' name='[# Orders (copy)_559501885261926409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_free_delivery] THEN ([global_entity_id] + [order_id]) END)' />
            </column>
            <column caption='# of Free DF Orders due to Subs.' datatype='integer' name='[# of Free DF Orders (copy)_559501885263167500]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [has_subscription_and_free_delivery] THEN ([global_entity_id] + [order_id]) END)' />
            </column>
            <column caption='# of Voucher Orders' datatype='integer' name='[# of Free DF Orders (copy)_559501885265260559]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_voucher] THEN ([global_entity_id] + [order_id]) END)' />
            </column>
            <column caption='# of Voucher Orders (dh)' datatype='integer' name='[# of Voucher Orders (copy)_3632856790863663110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_voucher_dh] THEN ([global_entity_id] + [order_id]) END)' />
            </column>
            <column caption='# of Voucher and Subs. Orders' datatype='integer' name='[# of Voucher Orders (copy)_559501885266173970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_subs_voucher] THEN ([global_entity_id] + [order_id]) END)' />
            </column>
            <column caption='% of Free DF Orders due to Subs.' datatype='real' name='[% of Free DF Orders (copy)_559501885263273997]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# of Free DF Orders (copy)_559501885263167500] / [Calculation_559501885255647232]' />
            </column>
            <column caption='% of Voucher Orders' datatype='real' name='[% of Free DF Orders (copy)_559501885265375248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# of Free DF Orders (copy)_559501885265260559] / [Calculation_559501885255647232]' />
            </column>
            <column caption='% of Orders below ABV Tier 2' datatype='real' name='[% of Orders below ABV Tier 1 (copy)_559501885257814018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [gbv_eur] &gt; [Parameters].[Parameter 1] AND [gbv_eur] &lt;= [Parameters].[BV Tier 1 (copy)_508554914460717057] THEN ([global_entity_id] + [order_id]) END) / [Calculation_559501885255647232]' />
            </column>
            <column caption='% of Orders below ABV Tier 5' datatype='real' name='[% of Orders below ABV Tier 2 (copy) (copy) (copy)_559501885258698757]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [gbv_eur] &gt; [Parameters].[BV Tier 1 (copy) (copy) (copy)_508554914460741635] AND [gbv_eur] &lt;= [Parameters].[BV Tier 1 (copy) (copy) (copy) (copy)_508554914460753924] THEN ([global_entity_id] + [order_id]) END) / [Calculation_559501885255647232]' />
            </column>
            <column caption='% of Orders below ABV Tier 4' datatype='real' name='[% of Orders below ABV Tier 2 (copy) (copy)_559501885258682372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [gbv_eur] &gt; [Parameters].[BV Tier 1 (copy) (copy)_508554914460729346] AND [gbv_eur] &lt;= [Parameters].[BV Tier 1 (copy) (copy) (copy)_508554914460741635] THEN ([global_entity_id] + [order_id]) END) / [Calculation_559501885255647232]' />
            </column>
            <column caption='% of Orders below ABV Tier 3' datatype='real' name='[% of Orders below ABV Tier 2 (copy)_559501885258649603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [gbv_eur] &gt; [Parameters].[BV Tier 1 (copy)_508554914460717057] AND [gbv_eur] &lt;= [Parameters].[BV Tier 1 (copy) (copy)_508554914460729346] THEN ([global_entity_id] + [order_id]) END) / [Calculation_559501885255647232]' />
            </column>
            <column caption='% of Voucher Orders (dh)' datatype='real' name='[% of Voucher Orders (copy)_3632856790863745031]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# of Voucher Orders (copy)_3632856790863663110] / [Calculation_559501885255647232]' />
            </column>
            <column caption='% of Voucher and Subs. Orders' datatype='real' name='[% of Voucher Orders (copy)_559501885266087953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# of Voucher Orders (copy)_559501885266173970] / [Calculation_559501885255647232]' />
            </column>
            <column caption='AAA Chain or Warehouse Name' datatype='string' name='[AAA_Chain_or_warehouse_name]' role='dimension' type='nominal' />
            <column caption='Total CM' datatype='real' name='[CM / O (copy)_3632856790864818186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fb_margin_or_comission_eur] + [delivery_fee_eur] + [service_fee_customer_eur] + [mov_customer_fee_eur] - [delivery_costs_eur])' />
            </column>
            <column caption='CM / O' datatype='real' name='[CR or F+B % (copy)_3632856790864461833]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[CM / O (copy)_3632856790864818186] / [Calculation_559501885255647232]' />
            </column>
            <column caption='is Dmart Trial within inspection dates' datatype='boolean' name='[Calculation_1529112817405427712]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [months_since_dmart_trial_of_the_customer] &gt; 0 THEN FALSE ELSE TRUE END' />
            </column>
            <column caption='CR or F+B %' datatype='real' name='[Calculation_3632856790861524995]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fb_margin_or_comission_eur]) / SUM([gbv_eur])' />
            </column>
            <column caption='Avg. MOV (value)' datatype='real' name='[Calculation_3632856790862630917]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dps_minimum_order_value_eur]) / [Calculation_559501885255647232]' />
            </column>
            <column caption='Avg. Voucher (dh) size' datatype='real' name='[Calculation_3632856790864142344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([voucher_dh_eur]) / [Calculation_559501885255647232]' />
            </column>
            <column caption='Food GBV' datatype='real' name='[Calculation_3632856790866137103]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[food_abv_3m] * [food_order_count]' />
            </column>
            <column caption='# Customers' datatype='integer' name='[Calculation_508554914459754496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([global_entity_id] + [analytical_customer_id])' />
            </column>
            <column caption='ABV Tiers     (3M QC Level)' datatype='string' name='[Calculation_508554914461327366]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [abv_eur_3m] &lt; [Parameters].[Parameter 1] THEN &apos; &lt; &apos; + STR([Parameters].[Parameter 1])&#10;ELSEIF [abv_eur_3m] &lt; [Parameters].[BV Tier 1 (copy)_508554914460717057] THEN STR([Parameters].[Parameter 1]) + &apos; - &apos; + STR([Parameters].[BV Tier 1 (copy)_508554914460717057])&#10;ELSEIF [abv_eur_3m] &lt; [Parameters].[BV Tier 1 (copy) (copy)_508554914460729346] THEN STR([Parameters].[BV Tier 1 (copy)_508554914460717057]) +  &apos; - &apos; + STR([Parameters].[BV Tier 1 (copy) (copy)_508554914460729346])&#10;ELSEIF [abv_eur_3m] &lt; [Parameters].[BV Tier 1 (copy) (copy) (copy)_508554914460741635] THEN STR([Parameters].[BV Tier 1 (copy) (copy)_508554914460729346]) +  &apos; - &apos; + STR([Parameters].[BV Tier 1 (copy) (copy) (copy)_508554914460741635])&#10;ELSEIF [abv_eur_3m] &lt; [Parameters].[BV Tier 1 (copy) (copy) (copy) (copy)_508554914460753924] THEN STR([Parameters].[BV Tier 1 (copy) (copy) (copy)_508554914460741635]) +  &apos; - &apos; + STR([Parameters].[BV Tier 1 (copy) (copy) (copy) (copy)_508554914460753924])&#10;ELSE STR(MAX( MAX( MAX( MAX([Parameters].[Parameter 1],[Parameters].[BV Tier 1 (copy)_508554914460717057]) ,[Parameters].[BV Tier 1 (copy) (copy)_508554914460729346]), [Parameters].[BV Tier 1 (copy) (copy) (copy)_508554914460741635]), [Parameters].[BV Tier 1 (copy) (copy) (copy) (copy)_508554914460753924])) + &apos; +&apos;&#10;END' />
            </column>
            <column caption='# Orders' datatype='integer' name='[Calculation_559501885255647232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([global_entity_id] + [order_id])' />
            </column>
            <column caption='% of Orders below ABV Tier 1' datatype='real' name='[Calculation_559501885256806401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [gbv_eur] &lt;= [Parameters].[Parameter 1] THEN ([global_entity_id] + [order_id]) END) / [Calculation_559501885255647232]' />
            </column>
            <column caption='ABV' datatype='real' name='[Calculation_559501885260263431]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_eur]) / [Calculation_559501885255647232]' />
            </column>
            <column caption='ABS' datatype='real' name='[Calculation_559501885261197320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_items_quantity]) / [Calculation_559501885255647232]' />
            </column>
            <column caption='Nominal DF' datatype='real' name='[Calculation_559501885262340106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_eur]) / ([Calculation_559501885255647232] - [# Orders (copy)_559501885261926409])' />
            </column>
            <column caption='% of Free DF Orders' datatype='real' name='[Calculation_559501885262934027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Orders (copy)_559501885261926409] / [Calculation_559501885255647232]' />
            </column>
            <column caption='Avg. Customer Food ABV' datatype='real' name='[Calculation_559501885270634515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3632856790866137103]) / SUM([food_order_count])' />
            </column>
