            </column>
            <column caption='Avg. Voucher (dh) size' datatype='real' name='[Calculation_3632856790864142344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([voucher_dh_eur]) / [Calculation_559501885255647232]' />
            </column>
            <column caption='Food GBV' datatype='real' name='[Calculation_3632856790866137103]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[food_abv_3m] * [food_order_count]' />
            </column>
            <column caption='# Customers' datatype='integer' name='[Calculation_508554914459754496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([global_entity_id] + [analytical_customer_id])' />
            </column>
            <column caption='# Orders' datatype='integer' name='[Calculation_559501885255647232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([global_entity_id] + [order_id])' />
            </column>
            <column caption='ABV' datatype='real' name='[Calculation_559501885260263431]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_eur]) / [Calculation_559501885255647232]' />
            </column>
            <column caption='ABS' datatype='real' name='[Calculation_559501885261197320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_items_quantity]) / [Calculation_559501885255647232]' />
            </column>
            <column caption='Nominal DF' datatype='real' name='[Calculation_559501885262340106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_eur]) / ([Calculation_559501885255647232] - [# Orders (copy)_559501885261926409])' />
            </column>
            <column caption='% of Free DF Orders' datatype='real' name='[Calculation_559501885262934027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Orders (copy)_559501885261926409] / [Calculation_559501885255647232]' />
            </column>
            <column caption='Avg. Customer Food ABV' datatype='real' name='[Calculation_559501885270634515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3632856790866137103]) / SUM([food_order_count])' />
            </column>
