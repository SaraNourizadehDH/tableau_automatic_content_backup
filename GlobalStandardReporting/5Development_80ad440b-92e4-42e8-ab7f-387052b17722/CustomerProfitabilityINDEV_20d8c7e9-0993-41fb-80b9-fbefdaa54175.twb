              <calculation class='tableau' formula='IF [abs_3m] &lt; [Parameters].[ABV Tier 1 (copy)_559501885296689173] THEN &apos; &lt; &apos; + STR([Parameters].[ABV Tier 1 (copy)_559501885296689173])&#10;ELSEIF [abs_3m] &lt; [Parameters].[ABV Tier 2 (copy)_559501885296701462] THEN STR([Parameters].[ABV Tier 1 (copy)_559501885296689173]) + &apos; - &apos; + STR([Parameters].[ABV Tier 2 (copy)_559501885296701462])&#10;ELSEIF [abs_3m] &lt; [Parameters].[ABS Tier 2 (copy)_559501885296955416] THEN STR([Parameters].[ABV Tier 2 (copy)_559501885296701462]) +  &apos; - &apos; + STR([Parameters].[ABS Tier 2 (copy)_559501885296955416])&#10;ELSEIF [abs_3m] &lt; [Parameters].[ABS Tier 2 (copy) (copy)_559501885296963609] THEN STR([Parameters].[ABS Tier 2 (copy)_559501885296955416]) +  &apos; - &apos; + STR([Parameters].[ABS Tier 2 (copy) (copy)_559501885296963609])&#10;ELSEIF [abs_3m] &lt; [Parameters].[ABS Tier 2 (copy) (copy) (copy)_559501885296975898] THEN STR([Parameters].[ABS Tier 2 (copy) (copy)_559501885296963609]) +  &apos; - &apos; + STR([Parameters].[ABS Tier 2 (copy) (copy) (copy)_559501885296975898])&#10;ELSE STR(MAX( MAX( MAX( MAX([Parameters].[ABV Tier 1 (copy)_559501885296689173],[Parameters].[ABV Tier 2 (copy)_559501885296701462]) ,[Parameters].[ABS Tier 2 (copy)_559501885296955416]), [Parameters].[ABS Tier 2 (copy) (copy)_559501885296963609]), [Parameters].[ABS Tier 2 (copy) (copy) (copy)_559501885296975898])) + &apos; +&apos;&#10;END' />
