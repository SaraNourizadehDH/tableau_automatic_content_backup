    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='KPI Evolution'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/DM-Performance-ScorecardV2INDEV/KPIEvolution?rev=' id='KPIEvolution' path='/t/GlobalStandardReporting/workbooks/DM-Performance-ScorecardV2INDEV' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='10000' maxwidth='1600' minheight='10000' minwidth='1600' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='dmart_scorecard_monthly_store_level (dev_dmart)' name='federated.1qo4esg1rcu0361fa5x0t1pup6a8' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
          <calculation class='tableau' formula='&quot;Country&quot;' />
          <members>
            <member value='&quot;Store&quot;' />
            <member value='&quot;Country&quot;' />
            <member value='&quot;Management Entity&quot;' />
            <member value='&quot;Region&quot;' />
            <member value='&quot;DH&quot;' />
          </members>
        </column>
        <column caption='KPI Selection' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Active Users as \% of Platform&quot;'>
          <calculation class='tableau' formula='&quot;Active Users as % of Platform&quot;' />
          <members>
            <member value='&quot;Active Users as \% of Platform&quot;' />
            <member value='&quot;GMV&quot;' />
            <member value='&quot;Orders&quot;' />
            <member value='&quot;Daily Orders per Active Store (Days w. Sales))&quot;' />
            <member value='&quot;Daily Orders per Active Store (Days in Month))&quot;' />
            <member value='&quot;ABV&quot;' />
            <member value='&quot;AOV&quot;' />
            <member value='&quot;ABV (\% of Food)&quot;' />
