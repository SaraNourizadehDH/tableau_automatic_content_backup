10;    WHEN &quot;Orders w. FDF as % of Orders&quot; THEN [Calculation_2382756080412585991] * 100&#10;    WHEN &quot;Nominal Delivery Fee, per Order as % of Food&quot; THEN [Calculation_2382756080414339086] * 100&#10;    WHEN &quot;Active Users&quot; THEN [Calculation_2382756080485576723]&#10;    WHEN &quot;Subscription Customers as % of Active Users&quot; THEN [Calculation_1273815046224322629] * 100 &#10;    WHEN &quot;Trials&quot; THEN SUM([num_of_new_dmart_buyers])&#10;    WHEN &quot;Acquisitions&quot; THEN SUM([num_of_new_platform_buyers_via_dmart])&#10;    WHEN &quot;Cross Sells&quot; THEN SUM([num_of_new_dmart_old_platform_buyers])&#10;    WHEN &quot;Reorder Rate Last Month&quot; THEN [Calculation_2382756080489127960] * 100&#10;    WHEN &quot;M+1 Retention Rate of Trials&quot; THEN [Reorder Rate Last Month (copy)_2382756080492294173] * 100&#10;    WHEN &quot;Orders w. Incentives as % of Orders&quot; THEN [Calculation_2382756080493256734] * 100&#10;    WHEN &quot;Orders w. Vouchers as % of Orders&quot; THEN [Calculation_2382756080493535263] * 100&#10;    WHEN &quot;Vouchers, per Order&quot; THEN [Calculation_4173499882706034703]&#10;    WHEN &quot;Vouchers as % of GMV&quot; THEN [Calculation_2382756080494092320] * 100&#10;    WHEN &quot;% Voucher Spend on Trials&quot; THEN [Calculation_2382756080494092320] * 100&#10;    WHEN &quot;Incentive spend as % of GMV&quot; THEN [Calculation_2382756080494329889] * 100&#10;    WHEN &quot;HVA QC Trial - Incentive spend on QC early (as % of all incentive spend)&quot; THEN [Calculation_2382756080497082402] * 100&#10;    WHEN &quot;HVA QC Trial - Incentive spend on QC trial (as % of all incentive spend)&quot; THEN [Calculation_2382756080497549347] * 100&#10;    WHEN &quot;Frequency&quot; THEN [Calculation_2382756080497930276]&#10;    WHEN &quot;Frequency - Trial Customers&quot; THEN [Frequency (copy)_1273815046199926789]&#10;    WHEN &quot;Frequency - Returning Customers&quot; THEN [Frequency - Trial Customers (copy)_12738150