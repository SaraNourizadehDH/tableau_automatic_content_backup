          <datasource-dependencies datasource='federated.1qo4esg1rcu0361fa5x0t1pup6a8'>
            <column caption='Num of Trial Customers Country Level - fixed' datatype='integer' name='[Calculation_1273815046198923264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_name], [month]: MAX([num_of_trial_customers_country_level]) }' />
            </column>
            <column caption='Num of Trial Customers Orders Country Level - fixed' datatype='integer' name='[Calculation_1273815046199205889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_name], [month]: MAX([num_of_trial_customers_orders_country_level]) }' />
            </column>
            <column caption='Num of Trial Customers w. Granularity' datatype='integer' name='[Calculation_1273815046199422978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Store&apos; THEN SUM([num_of_trial_customers])&#10;    ELSE SUM([Calculation_1273815046198923264])&#10;END' />
            </column>
            <column caption='Num of Trial Customers Orders w. Granularity' datatype='integer' name='[Calculation_1273815046199705603]' role='measure' type='quantitative'>
