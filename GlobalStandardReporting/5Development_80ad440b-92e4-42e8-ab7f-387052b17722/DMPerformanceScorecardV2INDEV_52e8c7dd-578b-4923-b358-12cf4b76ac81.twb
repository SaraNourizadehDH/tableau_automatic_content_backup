            </column>
            <column caption='Num of Trial Customers w. Granularity' datatype='integer' name='[Calculation_1273815046199422978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Store&apos; THEN SUM([num_of_trial_customers])&#10;    ELSE SUM([Calculation_1273815046198923264])&#10;END' />
            </column>
            <column caption='Num of Trial Customers Orders w. Granularity' datatype='integer' name='[Calculation_1273815046199705603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Store&apos; THEN SUM([num_of_trial_customers_orders])&#10;    ELSE SUM([Calculation_1273815046199205889])&#10;END' />
