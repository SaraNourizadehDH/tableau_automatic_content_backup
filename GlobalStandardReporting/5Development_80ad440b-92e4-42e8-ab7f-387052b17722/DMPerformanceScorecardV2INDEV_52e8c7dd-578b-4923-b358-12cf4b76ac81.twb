            </column>
            <column caption='Num of Non Subscription Customers Country Level - fixed' datatype='integer' name='[Calculation_1273815046214459450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_name], [month]: MAX([num_of_non_subscription_customers_country_level]) }' />
            </column>
            <column caption='Num of Subscription Customers Orders Country Level - fixed' datatype='integer' name='[Calculation_1273815046214639675]' role='measure' type='quantitative'>
