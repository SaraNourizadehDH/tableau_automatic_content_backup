            </column>
            <column caption='Num of Non Subscription Customers w. Granularity' datatype='integer' name='[Calculation_1273815046215270461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Store&apos; THEN SUM([num_of_non_subscription_customers])&#10;    ELSE SUM([Calculation_1273815046214459450])&#10;END' />
            </column>
            <column caption='Num of Non Subscription Customers Orders w. Granularity' datatype='integer' name='[Calculation_1273815046215618622]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Store&apos; THEN SUM([num_of_non_subscription_customers_orders])&#10;    ELSE SUM([Calculation_1273815046214111289])&#10;END' />
            </column>
            <column caption='Num of Subscription Customers w. Granularity' datatype='integer' name='[Calculation_1273815046215974975]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Store&apos; THEN SUM([num_of_subscription_customers])&#10;    ELSE SUM([Calculation_1273815046213804088])&#10;END' />
            </column>
            <column caption='Num of Subscription Customers Orders w. Granularity' datatype='integer' name='[Calculation_1273815046216233025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Store&apos; THEN SUM([num_of_subscription_customers_orders])&#10;    ELSE SUM([Calculation_1273815046214639675])&#10;END' />
            </column>
            <column caption='Subscription Customers as % of Active Users' datatype='real' name='[Calculation_1273815046224322629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1273815046215974975] / [Calculation_2382756080485576723]' />
            </column>
            <column caption='Num of Days in Month' datatype='integer' name='[Calculation_2129076760439377922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [month], DATEADD(&apos;month&apos;, 1, [month]))' />
            </column>
            <column aggregation='Sum' caption='Store Age in Months' datatype='integer' name='[Calculation_2129076760455061508]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [warehouse_created_month], TODAY())' />
            </column>
            <column caption='Nominal Delivery Fee, per Order' datatype='real' name='[Calculation_2382756080405659648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_delivery_fee_eur]) / SUM([num_of_orders_w_delivery_fee])' />
            </column>
            <column caption='Service Fee, per Order' datatype='real' name='[Calculation_2382756080406233089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_service_fee_eur]) / SUM([num_of_orders])' />
            </column>
            <column caption='Small Order Fee, per Order' datatype='real' name='[Calculation_2382756080406790146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mov_customer_fee_eur]) / SUM([num_of_orders])' />
            </column>
            <column caption='Realized Delivery Fee as % of GPV' datatype='real' name='[Calculation_2382756080407937027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_delivery_fee_eur]) / SUM([gbv_eur])' />
            </column>
            <column caption='MOV, per Order' datatype='real' name='[Calculation_2382756080409047044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dps_minimum_order_value_eur]) / SUM([num_of_orders])' />
            </column>
            <column caption='Avg. Price per Item' datatype='real' name='[Calculation_2382756080411934725]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_eur]) / SUM([quantity_sold])' />
            </column>
            <column caption='MOV, per Order / Avg. Price per Item' datatype='real' name='[Calculation_2382756080412073990]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2382756080409047044] / [Calculation_2382756080411934725]' />
            </column>
            <column caption='Orders w. FDF as % of Orders' datatype='real' name='[Calculation_2382756080412585991]' role='measure' type='quantitative'>
