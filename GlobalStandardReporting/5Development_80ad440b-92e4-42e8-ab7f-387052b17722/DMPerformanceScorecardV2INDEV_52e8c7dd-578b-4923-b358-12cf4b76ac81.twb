      </column>
      <column caption='KPI' datatype='real' name='[Calculation_5530350013219459073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &quot;Active Users as % of Platform&quot; THEN [Calculation_5675239251107987468] * 100&#10;    WHEN &quot;GMV&quot; THEN SUM([gmv_eur])&#10;    WHEN &quot;GMV (% of Platform)&quot; THEN [Calculation_5675239251094966275] * 100 &#10;    WHEN &quot;Orders&quot; THEN SUM([num_of_orders])&#10;    WHEN &quot;Daily Orders per Active Store (Days w. Sales)&quot; THEN [Calculation_5675239251066441728]&#10;    WHEN &quot;Daily Orders per Active Store (Days in Month)&quot; THEN [Daily Orders per Active Store (copy)_2129076760439533571]&#10;    WHEN &quot;ABV&quot; THEN [Calculation_5675239251105161220]&#10;    WHEN &quot;AOV&quot; THEN [Calculation_5675239251105615877]&#10;    WHEN &quot;ABV (% of Food)&quot; THEN [Calculation_5675239251106537482] * 100&#10;    WHEN &quot;Avg. Basket Size&quot; THEN [Calculation_5675239251107491851]&#10;    WHEN &quot;Active Stores&quot; THEN SUM([num_of_warehouses])&#10;    WHEN &quot;Assortment Quality Score&quot; THEN [Calculation_5675239251109851152]&#10;    WHEN &quot;Avg. # of Listed Skus per Store&quot; THEN AVG([avg_listed_skus])&#10;    WHEN &quot;UF GPV %&quot; THEN [Calculation_5675239251121471506] * 100&#10;    WHEN &quot;% Orders w. Subs. DF benefits&quot; THEN [Calculation_5675239251124776979] * 100&#10;    WHEN &quot;Realized Fees, per Order&quot; THEN [Calculation_5675239251126018069]&#10;    WHEN &quot;Nominal Delivery Fee, per Order&quot; THEN [Calculation_2382756080405659648]&#10;    WHEN &quot;Service Fee, per Order&quot; THEN [Calculation_2382756080406233089]&#10;    WHEN &quot;Small Order Fee, per Order&quot; THEN [Calculation_2382756080406790146]&#10;    WHEN &quot;Realized Delivery Fee as % of GPV&quot; THEN [Calculation_2382756080407937027] * 100&#10;    WHEN &quot;MOV, per Order&quot; THEN [Calculation_2382756080409047044]&#10;    WHEN &quot;MOV, per Order / Avg. Price per Item&quot; THEN [Calculation_2382756080412073990]&#10;   