            </column>
            <column caption='Num of Returning Customers w. Granularity' datatype='integer' name='[Calculation_1273815046206087218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Store&apos; THEN SUM([num_of_returning_customers])&#10;    ELSE SUM([Calculation_1273815046205710384])&#10;END' />
            </column>
            <column caption='Num of Returning Customers Orders w. Granularity' datatype='integer' name='[Calculation_1273815046206242867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Store&apos; THEN SUM([num_of_returning_customers_orders])&#10;    ELSE SUM([Calculation_1273815046205894705])&#10;END' />
            </column>
