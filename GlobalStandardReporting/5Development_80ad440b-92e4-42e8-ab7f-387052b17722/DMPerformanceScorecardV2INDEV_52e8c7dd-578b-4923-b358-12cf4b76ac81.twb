              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Store&apos; THEN [warehouse_name]&#10;    WHEN &apos;Country&apos; THEN [country_name]&#10;    WHEN &apos;Management Entity&apos; THEN [management_entity]&#10;    WHEN &apos;Region&apos; THEN [region]&#10;    WHEN &apos;DH&apos; THEN &apos;DH&apos;&#10;END' />
            </column>
            <column caption='KPI' datatype='real' name='[Calculation_5530350013219459073]' role='measure' type='quantitative'>
