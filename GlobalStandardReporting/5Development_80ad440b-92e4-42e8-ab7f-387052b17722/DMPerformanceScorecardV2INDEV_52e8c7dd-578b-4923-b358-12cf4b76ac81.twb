            <column caption='Daily Orders per Active Store (Days w. Sales)' datatype='real' name='[Calculation_5675239251066441728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_orders]) / SUM([num_of_days_w_orders])' />
            </column>
            <column caption='GMV (% of Platform)' datatype='real' name='[Calculation_5675239251094966275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur]) / SUM([Platform GMV - fixed (copy)_5675239251094589442])' />
            </column>
            <column caption='ABV' datatype='real' name='[Calculation_5675239251105161220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_eur]) / SUM([num_of_orders])' />
            </column>
            <column caption='AOV' datatype='real' name='[Calculation_5675239251105615877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur]) / SUM([num_of_orders])' />
            </column>
            <column caption='Food GBV Eur - fixed' datatype='real' name='[Calculation_5675239251105951750]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_name], [month]: MAX([food_gbv_eur]) }' />
            </column>
            <column caption='Food Orders - fixed' datatype='integer' name='[Calculation_5675239251106201608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [country_name], [month]: MAX([food_orders]) }' />
            </column>
            <column caption='Food ABV - fixed' datatype='real' name='[Calculation_5675239251106336777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_5675239251105951750]) / SUM([Calculation_5675239251106201608])' />
            </column>
            <column caption='ABV (% of Food)' datatype='real' name='[Calculation_5675239251106537482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5675239251105161220] / [Calculation_5675239251106336777]' />
            </column>
            <column caption='Avg. Basket Size' datatype='real' name='[Calculation_5675239251107491851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([quantity_sold]) / SUM([num_of_orders])' />
            </column>
            <column caption='Active Users as % of Platform' datatype='real' name='[Calculation_5675239251107987468]' role='measure' type='quantitative'>
