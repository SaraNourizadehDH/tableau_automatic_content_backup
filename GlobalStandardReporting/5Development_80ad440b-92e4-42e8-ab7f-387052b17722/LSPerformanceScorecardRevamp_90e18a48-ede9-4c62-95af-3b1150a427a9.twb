    <worksheet name='Evolution Table Summary'>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_ls_scorecard (dev_dmart)' name='federated.119c67416vmb881d9uvuo081phg3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Month' caption='Frequency' datatype='real' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2.'>
              <calculation class='tableau' formula='2.' />
              <aliases>
                <alias key='1.' value='Week' />
                <alias key='2.' value='Month' />
              </aliases>
            </column>
            <column alias='Country' caption='Granularity' datatype='real' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='2.'>
              <calculation class='tableau' formula='2.' />
              <aliases>
                <alias key='1.' value='Vertical Type' />
                <alias key='2.' value='Country' />
                <alias key='3.' value='Management Entity' />
                <alias key='4.' value='Region' />
                <alias key='5.' value='DH' />
                <alias key='6.' value='Vertical' />
                <alias key='10.' value='City' />
              </aliases>
            </column>
            <column caption='Last N Periods' datatype='integer' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='9'>
              <calculation class='tableau' formula='9' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.119c67416vmb881d9uvuo081phg3'>
            <column datatype='integer' name='[AAA_Covered_MAU]' role='measure' type='quantitative' />
            <column datatype='integer' name='[AAA_Platform_MAU]' role='measure' type='quantitative' />
            <column caption='BLANK (copy) (copy) (copy)' datatype='integer' name='[BLANK (copy) (copy) (copy)_3379740455206330386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum(Null)' />
            </column>
            <column caption='BLANK (copy) (copy)' datatype='integer' name='[BLANK (copy) (copy)_3379740455206305809]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum(Null)' />
            </column>
            <column caption='BLANK (copy)' datatype='integer' name='[BLANK (copy)_3379740455206285328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum(Null)' />
            </column>
            <column caption='Revenue Fees p/o' datatype='real' name='[Calculation_2757047399618953230]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(Sum([df])+Sum([service_fee])+Sum([small_order_fee]))/Sum([successful_orders])' />
            </column>
            <column caption='Take In' datatype='real' name='[Calculation_3136968275089702919]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(Sum([commission])+Sum([df])+Sum([service_fee])+Sum([small_order_fee])-SUM([vouchers]))/SUM([successful_orders])' />
            </column>
            <column caption='Delivery Type' datatype='string' name='[Calculation_3136968275092590601]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_own_delivery] =1 then &quot;Own Delivery&quot; Else &quot;Vendor Delivery&quot; END' />
            </column>
            <column caption='% Partial Orders' datatype='real' name='[Calculation_3379740455194845184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Partial_orders])/sum([pelican_orders])' />
            </column>
            <column caption='BLANK' datatype='integer' name='[Calculation_3379740455206199311]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum(Null)' />
            </column>
            <column caption='Vouchers p/o' datatype='real' name='[Calculation_3785768131101020160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([vouchers])/sum([successful_orders])' />
            </column>
            <column caption='GMV per store' datatype='real' name='[Calculation_3785768131114491908]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([GMV])/Sum([active_vendor])' />
            </column>
            <column caption='GMV as % of QC' datatype='real' name='[Calculation_3785768131114938373]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2]&lt;&gt;1 and [Parameters].[Parameter 2]&lt;&gt;6 then &#10;Sum([GMV])/&#10;(sum([GMV])+SUM({FIXED [time_level],[time_period],[global_entity_id]: AVG([gmv_dmarts])})) end' />
            </column>
            <column caption='Take In (% of GBV)' datatype='real' name='[Calculation_4970214833967230976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(Sum([commission])+Sum([df])+Sum([small_order_fee])+Sum([service_fee])-SUM([vouchers]))/SUM(GBV)' />
            </column>
            <column caption='Realised DF (% of GBV)' datatype='real' name='[Calculation_4970214833967378433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE  [is_own_delivery] when 1 then [df] end)/&#10;SUM(CASE  [is_own_delivery] when 1 then [GBV] end)' />
            </column>
            <column caption='Content quality score' datatype='real' name='[Calculation_5476306842371264512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([quality_score_aggregated]*[no_products])/SUM([no_products])' />
            </column>
            <column caption='% GBV From Fresh' datatype='real' name='[Calculation_5738078569648246786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Fresh_GBV])/SUM([GBV])' />
            </column>
            <column caption='HVA Trial - Incentive spend on trial ( % of entire spend)' datatype='real' name='[Calculation_5738078569648861190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Incentive_Trial_Spend])/sum([Incentive_Spend])' />
            </column>
            <column caption='AAA Coverage %' datatype='real' name='[Calculation_5738078569659146251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum({FIXED [time_level],[time_period],[global_entity_id] : AVG([AAA_Covered_MAU]) } )/&#10;sum({FIXED [time_level],[time_period],[global_entity_id] : AVG([AAA_Platform_MAU]) } )' />
            </column>
            <column caption='Sessions (Deduped)' datatype='real' name='[Calculation_5738078569663197196]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=1 then &#10;sum({FIXED [time_level],[time_period],[global_entity_id],[vendor_type] : AVG([Sessions]) } )&#10;ELSE &#10; if [Parameters].[Parameter 2]=6 then null &#10;ELSE IF [Parameters].[Parameter 2]=10 then &#10;sum({FIXED [time_level],[time_period],[global_entity_id],[city] : AVG([City_Sessions]) } )&#10;ELSE&#10;sum({FIXED [time_level],[time_period],[global_entity_id] : AVG([Country_Sessions]) } )&#10;END END END' />
            </column>
            <column caption='CVR3' datatype='real' name='[Calculation_5738078569663787023]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Sessions (Deduped) (copy)_5738078569663520781]/[Calculation_5738078569663197196]' />
            </column>
            <column caption='CVR2' datatype='real' name='[Calculation_5738078569664036881]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Sessions_w_transactions (Deduped) (copy)_5738078569663885328]/[Sessions_w_transactions (Deduped) (copy)_5738078569663627278]' />
            </column>
            <column caption='Markup Vs Dmarts' datatype='real' name='[Calculation_5738078569666449426]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([mark_up_vs_dmarts]*[mark_up_weight])/SUM([mark_up_weight])' />
            </column>
            <column caption='% Orders w/ Subs. DF benefits' datatype='real' name='[Calculation_5788744068720705536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_benefit_orders])/SUM([successful_orders])' />
            </column>
            <column caption='Last' datatype='integer' name='[Calculation_5994994800493383687]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='LAST()'>
                <table-calc level-address='[federated.119c67416vmb881d9uvuo081phg3].[none:time_period:ok]' ordering-field='[federated.119c67416vmb881d9uvuo081phg3].[time_period]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Last&lt;=N' datatype='boolean' name='[Calculation_5994994800580083838]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_5994994800493383687]&lt;[Parameters].[Parameter 3]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Date DIsplay ' datatype='string' name='[Calculation_721279646024859648]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=1 THEN &#10;STR(DATEPART(&apos;day&apos;,[time_period])) + &quot;-&quot; + LEFT(STR(DATENAME(&apos;month&apos;,[time_period])),3) + &quot;-&quot; + RIGHT(STR(DATEPART(&apos;year&apos;,[time_period])),2)&#10;ELSE LEFT(STR(DATENAME(&apos;month&apos;,[time_period])),3) + &quot;-&quot; + RIGHT(STR(DATEPART(&apos;year&apos;,[time_period])),2)&#10; END' />
            </column>
            <column caption='ME' datatype='string' name='[Calculation_721279646052278274]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [management_entity] &#10;When &apos;DH Nordics&apos; then &apos;EU Pandora&apos; &#10;WHEN &apos;DH Austria&apos; then &apos;EU Pandora&apos; &#10;WHEN &apos;DH CEE&apos; then &apos;EU Pandora&apos; &#10;WHEN &apos;DH Greece&apos; then &apos;EU eFood&apos;&#10;else [management_entity]&#10;END' />
            </column>
            <column caption='% GMV O/ platform' datatype='real' name='[Calculation_721279646055833609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([GMV])&#10;/&#10;SUM({FIXED [time_level],[time_period],[global_entity_id]: AVG([platform_gmv])})' />
            </column>
            <column caption='Avg Items Per Order' datatype='real' name='[Calculation_721279646056349707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Items_sold])/sum([orders_with_non_Zero_qty])' />
            </column>
            <column caption='AO NPS' datatype='real' name='[Calculation_721279646056644620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Promoters])-SUM([Detractors]))*100&#10;/ SUM([NPS_Responses])' />
            </column>
            <column caption='Active Users' datatype='real' name='[Calculation_721279646056931341]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=1 then &#10;sum({FIXED [time_level],[time_period],[global_entity_id],[vendor_type] : AVG([active_customers]) } )&#10;ELSE &#10;IF [Parameters].[Parameter 2]=6 THEN&#10;sum({FIXED [time_level],[time_period],[global_entity_id],[vertical_type_2] : AVG([vertical_type_2_level_active_customers]) } )&#10;ELSE&#10;IF [Parameters].[Parameter 2]=10 THEN&#10;sum({FIXED [time_level],[time_period],[global_entity_id],[city] : AVG([city_level_active_customers]) } )&#10;ELSE&#10;sum({FIXED [time_level],[time_period],[global_entity_id] : AVG([country_level_active_customers]) } )&#10;END END END' />
            </column>
            <column caption='Trials ' datatype='real' name='[Calculation_721279646057222158]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=1 then &#10;sum({ fixed [time_level],[time_period],[global_entity_id],[vendor_type]: AVG([TRIALS])}) &#10;else IF [Parameters].[Parameter 2]=6 then &#10;sum({ fixed [time_level],[time_period],[global_entity_id],[vertical_type_2]: AVG([vertical_type_2_level_trials])}) &#10;else IF [Parameters].[Parameter 2]=10 then &#10;sum({ fixed [time_level],[time_period],[global_entity_id],[city]: AVG([city_level_trials])}) &#10;ELSE&#10;sum({ fixed [time_level],[time_period],[global_entity_id]: AVG([country_level_trials])}) &#10;END END END' />
            </column>
            <column caption='Acquisitions' datatype='real' name='[Calculation_721279646057398287]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=1 then &#10;sum({ fixed [time_level],[time_period],[global_entity_id],[vendor_type]: avg([acquisition])})&#10;else &#10;IF [Parameters].[Parameter 2]=6 then &#10;sum({ fixed [time_level],[time_period],[global_entity_id],[vertical_type_2]: avg([vertical_type_2_level_acquistions])})&#10;else &#10;IF [Parameters].[Parameter 2]=10 then &#10;sum({ fixed [time_level],[time_period],[global_entity_id],[city]: avg([city_level_acquistions])})&#10;else&#10;sum({ fixed [time_level],[time_period],[global_entity_id]: avg([country_level_acquistions])})&#10;END end END' />
            </column>
            <column caption='Cross Sells ' datatype='real' name='[Calculation_721279646057746450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2]=1 then &#10;sum( {fixed [time_level],[global_entity_id],[time_period],[vendor_type]: avg([crosssells])})&#10;else &#10;if [Parameters].[Parameter 2]=6 then &#10;sum( {fixed [time_level],[global_entity_id],[time_period],[vertical_type_2]: avg([vertical_type_2_level_cross_sells])})&#10;else &#10;if [Parameters].[Parameter 2]=10 then &#10;sum( {fixed [time_level],[global_entity_id],[time_period],[city]: avg([city_level_cross_sells])})&#10;else&#10;sum( {fixed [time_level],[global_entity_id],[time_period]: avg([country_level_cross_sells])}) END&#10;end END' />
            </column>
            <column caption='% Reordered LM' datatype='real' name='[Calculation_721279646104793107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF [Parameters].[Parameter 2]=1 THEN &#10;SUM([reordered_prev_month])&#10;ELSE&#10;IF [Parameters].[Parameter 2]=6 THEN &#10;SUM({FIXED [time_level],[time_period],[global_entity_id],[vertical_type_2] : AVG([vertical_type_2_level_reordered_prev_month])})&#10;ELSE IF &#10; [Parameters].[Parameter 2]=10 THEN &#10;SUM({FIXED [time_level],[time_period],[global_entity_id],[city] : AVG([city_level_reordered_prev_month])})&#10;ELSE &#10;SUM({FIXED [time_level],[time_period],[global_entity_id] : AVG([country_level_reordered_prev_month])})&#10;END END END) / LOOKUP([Calculation_721279646056931341],-1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='% Reordered 1M Cohort' datatype='real' name='[Calculation_721279646105038868]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2]=1 then sum([reordered_prev_month_with_trials])&#10;else &#10;IF [Parameters].[Parameter 2]=6 THEN &#10;SUM({FIXED [time_level],[time_period],[global_entity_id],[vertical_type_2] : AVG([vertical_type_2_level_reordered_prev_month_with_trials])})&#10;ELSE IF [Parameters].[Parameter 2]=10 THEN &#10;SUM({FIXED [time_level],[time_period],[global_entity_id],[city] : AVG([city_level_reordered_prev_month_with_trials])})&#10;&#10;&#10;ELSE&#10;sum({FIXED [time_level],[time_period],[global_entity_id]: avg([country_level_reordered_prev_month_with_trials])})&#10;END END END /[Calculation_721279646105153557]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Previous Month Trials' datatype='real' name='[Calculation_721279646105153557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOOKUP([Calculation_721279646057222158],-1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Frequency' datatype='real' name='[Calculation_721279646105944087]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_orders])/([Calculation_721279646056931341])' />
            </column>
            <column caption='Penetration % (o/ platform)' datatype='real' name='[Calculation_721279646106251288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_721279646056931341]/&#10;SUM({FIXED [time_level],[time_period],[global_entity_id]: AVG([platform_users])})' />
            </column>
            <column caption='Avg Basket Value' datatype='real' name='[Calculation_721279646106722329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GBV])/SUM([successful_orders])' />
            </column>
            <column caption='Commision Rate' datatype='real' name='[Calculation_721279646107889692]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([commission])/sum([GBV])' />
            </column>
            <column caption='Commission PO' datatype='real' name='[Calculation_721279646108090397]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([commission])/sum([successful_orders])' />
            </column>
            <column caption='Vouchers (% of GBV)' datatype='real' name='[Calculation_721279646108663838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vouchers])/SUM([GBV])' />
            </column>
            <column caption='% Orders w/ vouchers' datatype='real' name='[Calculation_721279646108897311]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_With_vouchers])/sum([successful_orders])' />
            </column>
            <column caption='% FDF' datatype='real' name='[Calculation_721279646109454369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( case  [is_own_delivery] when 1 then [orders_With_free_df] end )&#10; /&#10;SUM( case [is_own_delivery] when 1 then [successful_orders] end)' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_721279646110384164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders])/sum([total_orders])' />
            </column>
            <column caption='Weekly_Monthly_Switch' datatype='boolean' name='[Calculation_721279646122111014]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=1 then [time_level]=&quot;Weekly&quot; else [time_level]=&quot;Monthly&quot; end' />
            </column>
            <column caption='Vendor Fail Rate' datatype='real' name='[Calculation_721279646126006313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([vendor_failed_orders])/sum([total_orders])' />
            </column>
