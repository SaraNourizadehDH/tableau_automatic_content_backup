            <column caption='Avg Basket Value' datatype='real' name='[Calculation_721279646106722329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GBV])/SUM([successful_orders])' />
            </column>
            <column caption='Realised DFO' datatype='real' name='[Calculation_721279646106951706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE  [is_own_delivery] when 1 then [df] end)/SUM(CASE  [is_own_delivery] when 1 then [successful_orders] end)' />
            </column>
            <column caption='Nominal DFO' datatype='real' name='[Calculation_721279646107308059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( case  [is_own_delivery] when 1 then [df] end )&#10;/SUM(case  [is_own_delivery] when 1 then [orders_With_non_Zero_df] end)' />
            </column>
            <column caption='Vouchers (% of GBV)' datatype='real' name='[Calculation_721279646108663838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vouchers])/SUM([GBV])' />
            </column>
            <column caption='% Orders w/ vouchers' datatype='real' name='[Calculation_721279646108897311]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_With_vouchers])/sum([successful_orders])' />
            </column>
            <column caption='% FDF' datatype='real' name='[Calculation_721279646109454369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( case  [is_own_delivery] when 1 then [orders_With_free_df] end )&#10; /&#10;SUM( case [is_own_delivery] when 1 then [successful_orders] end)' />
            </column>
            <column caption='Avg Delivery Time' datatype='real' name='[Calculation_721279646109818914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_own_delivery]=1 then [Delivery_time] end )&#10;/&#10;sum(if [is_own_delivery]=1 then [orders_with_delivery_time] end)' />
            </column>
            <column caption='Split Orders as % of Orders' datatype='real' name='[Calculation_721279646110101539]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Split_Orders])/sum([successful_orders])' />
