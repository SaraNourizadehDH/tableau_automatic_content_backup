            </column>
            <column caption='% Orders w/ Subs. DF benefits' datatype='real' name='[Calculation_5788744068720705536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_benefit_orders])/SUM([successful_orders])' />
