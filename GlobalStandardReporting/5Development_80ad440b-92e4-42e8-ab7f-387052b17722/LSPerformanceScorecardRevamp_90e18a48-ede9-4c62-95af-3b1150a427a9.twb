                <alias key='24.' value='Service Fee, per Order' />
                <alias key='25.' value='Small Order Fee, per Order' />
                <alias key='26.' value='Realized Delivery Fee as % of GPV (for Shops, OD only)' />
                <alias key='27.' value='MOV, per Order' />
                <alias key='28.' value='MOV, per Order (# Items)' />
                <alias key='29.' value='Orders with FDF as % of Orders (for Shops, OD only)' />
                <alias key='30.' value='Nominal Delivery Fee, per Order as % of Food' />
                <alias key='31.' value='Active Users' />
                <alias key='32.' value='Trials' />
                <alias key='33.' value='Acquisitions' />
                <alias key='34.' value='Cross Sells' />
                <alias key='35.' value='Reorder Rate Last Month' />
                <alias key='36.' value='M+1 Retention Rate of Trials' />
                <alias key='37.' value='Orders w/Incentives as % of Orders' />
                <alias key='38.' value='Orders w/Vouchers as % of Orders' />
                <alias key='39.' value='Vouchers, per Order' />
                <alias key='40.' value='Vouchers as % of GMV' />
                <alias key='41.' value='Incentive spend as % of GMV' />
                <alias key='42.' value='HVA QC Trial - Incentive spend on QC trial (as % of all incentive spend)' />
                <alias key='43.' value='HVA QC Early - Incentive spend on QC &apos;early&apos; (as % of all incentive spend)' />
                <alias key='44.' value='Frequency' />
                <alias key='45.' value='Seamless Orders as % of Total Orders' />
                <alias key='46.' value='Items not Delivered as % of Ordered' />
                <alias key='47.' value='Items Replaced as % of Eligible' />
                <alias key='48.' value='Not Found Rate' />
                <alias key='49.' value='Fail Rate' />
                <alias key='50.' value='Vendor Fail Rate' />
                <alias key='51.' value='Out of Stock Fail Rate' />
                <alias key='52.' value='GMV Loss due to OOS Failure' />
                <alias key='53.' value='GMV Loss due to Partial Fulfillment' />
