        <calculation class='tableau' formula='sum([orders_With_vouchers])/sum([successful_orders])' />
      </column>
      <column caption='ABV (% of Food)' datatype='real' name='[Calculation_721279646109179936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_721279646106722329]/&#10;(&#10;SUM({FIXED [time_level],[time_period],[global_entity_id]: AVG([food_orders_gbv])})&#10;/&#10;SUM({FIXED [time_level],[time_period],[global_entity_id]: AVG([food_orders])})&#10;)' />
      </column>
      <column caption='% FDF' datatype='real' name='[Calculation_721279646109454369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( case  [is_own_delivery] when 1 then [orders_With_free_df] end )&#10; /&#10;SUM( case [is_own_delivery] when 1 then [successful_orders] end)' />
      </column>
      <column caption='Avg Delivery Time' datatype='real' name='[Calculation_721279646109818914]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [is_own_delivery]=1 then [Delivery_time] end )&#10;/&#10;sum(if [is_own_delivery]=1 then [orders_with_delivery_time] end)' />
      </column>
      <column caption='Split Orders as % of Orders' datatype='real' name='[Calculation_721279646110101539]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Split_Orders])/sum([successful_orders])' />
      </column>
      <column caption='Fail Rate' datatype='real' name='[Calculation_721279646110384164]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([failed_orders])/sum([total_orders])' />
      </column>
      <column caption='Weekly_Monthly_Switch' datatype='boolean' name='[Calculation_721279646122111014]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1]=1 then [time_level]=&quot;Weekly&quot; else [time_level]=&quot;Monthly&quot; end' />
      </column>
      <column caption='Avg Delivery Distance' datatype='real' name='[Calculation_721279646122426407]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([delivery_distance]/1000)/sum([successful_orders])' />
      </column>
      <column caption='% Pelican Orders' datatype='real' name='[Calculation_721279646123098152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([pelican_orders])/sum([successful_orders])' />
      </column>
      <column caption='Vendor Fail Rate' datatype='real' name='[Calculation_721279646126006313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Sum([vendor_failed_orders])/sum([total_orders])' />
      </column>
      <column caption='Logistics Fail Rate' datatype='real' name='[Calculation_721279646126145578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([logistics_failed_orders])/sum([total_orders])' />
      </column>
      <column caption='Year Back Switch' datatype='boolean' name='[Calculation_721279646129909804]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1]=1 THEN [Calculation_5994994800493383687]=53 ELSE [Calculation_5994994800493383687]=12 END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Commision Rate (copy)' datatype='real' hidden='true' name='[Commision Rate (copy)_2219500601010024451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([commission])/sum([GBV])' />
      </column>
      <column caption='Commision Rate OD' datatype='real' name='[Commision Rate (copy)_6064026557898391558]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [is_own_delivery]=1 then [commission] end)/sum(&#10;if [is_own_delivery]=1 then [GBV] end)' />
      </column>
      <column caption='Commision Rate OD (o/ Base)' datatype='real' name='[Commision Rate OD (copy)_2219500601010085892]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [is_own_delivery]=1 then [commission] end)/sum(&#10;if [is_own_delivery]=1 then [commission_base] end)' />
      </column>
      <column caption='Commision Rate VD' datatype='real' name='[Commision Rate OD (copy)_6064026557898870791]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [is_own_delivery]=0 then [commission] end)/sum(&#10;if [is_own_delivery]=0 then [GBV] end)' />
      </column>
      <column caption='Commision Rate VD (o/ Base)' datatype='real' name='[Commision Rate VD (copy)_2219500601010200581]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [is_own_delivery]=0 then [commission] end)/sum(&#10;if [is_own_delivery]=0 then [commission_base] end)' />
      </column>
      <column datatype='integer' hidden='true' name='[DM_successful_orders]' role='measure' type='quantitative' />
      <column caption='Delivery time' datatype='real' name='[Delivery_time]' role='measure' type='quantitative' />
      <column caption='% GBV From Ultra Fresh' datatype='real' name='[GBV From Fresh (copy)_5738078569648422915]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Ultra_Fresh_GBV])/SUM([GBV])' />
