      </column>
      <column caption='Orders(Monthly Run Rate)' datatype='real' name='[Calculation_721279646055268358]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF max([Calculation_721279646055407623])=TRUE and ([Parameters].[Parameter 1])=2&#10;then&#10;sum([successful_orders])*&#10;max([Calculation_6947646858892095490])/&#10;max(DATEPART(&apos;day&apos;,[data_upto]))&#10;ELSEIF [Parameters].[Parameter 1]=2 then sum([successful_orders])&#10;else NULL END' />
