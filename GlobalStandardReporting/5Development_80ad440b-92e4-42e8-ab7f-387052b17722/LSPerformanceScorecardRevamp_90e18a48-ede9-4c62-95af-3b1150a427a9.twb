              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=1 then &#10;sum({FIXED [time_level],[time_period],[global_entity_id],[vendor_type] : AVG([shop_list_loaded]) } )&#10;ELSE if [Parameters].[Parameter 2]=6 then null else&#10;IF [Parameters].[Parameter 2]=10 then &#10;sum({FIXED [time_level],[time_period],[global_entity_id],[city] : AVG([City_shop_list_loaded]) } )&#10;ELSE&#10;sum({FIXED [time_level],[time_period],[global_entity_id] : AVG([Country_shop_list_loaded]) } )&#10;END END END' />
            </column>
            <column caption='transactions_and_shop_list_loaded (Deduped)' datatype='real' name='[Sessions_w_transactions (Deduped) (copy)_5738078569663885328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=1 then &#10;sum({FIXED [time_level],[time_period],[global_entity_id],[vendor_type] : AVG([transaction_and_shop_list_loaded]) } )&#10;ELSE if [Parameters].[Parameter 2]=6 &#10;&#10;then null &#10;ELSE if [Parameters].[Parameter 2]=10&#10;&#10;then sum({FIXED [time_level],[time_period],[global_entity_id],[city] : AVG([City_transaction_and_shop_list_loaded]) } ) &#10;&#10;ELSE&#10;&#10;sum({FIXED [time_level],[time_period],[global_entity_id] : AVG([Country_transaction_and_shop_list_loaded]) } )&#10;END END END' />
