            <column caption='Realised DFO' datatype='real' name='[Calculation_721279646106951706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE  [is_own_delivery] when 1 then [df] end)/SUM(CASE  [is_own_delivery] when 1 then [successful_orders] end)' />
            </column>
            <column caption='Nominal DFO' datatype='real' name='[Calculation_721279646107308059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( case  [is_own_delivery] when 1 then [df] end )&#10;/SUM(case  [is_own_delivery] when 1 then [orders_With_non_Zero_df] end)' />
