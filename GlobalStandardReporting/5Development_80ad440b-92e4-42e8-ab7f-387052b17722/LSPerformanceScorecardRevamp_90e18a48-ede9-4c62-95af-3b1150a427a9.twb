      <aliases enabled='yes' />
      <column caption='% Orders o/ platform' datatype='real' name='[% GMV O/ platform (copy)_2757047399611518985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([successful_orders])&#10;/&#10;SUM({FIXED [time_level],[time_period],[global_entity_id]: AVG([platform_orders])})' />
      </column>
      <column caption='% Reordered 3M Cohort' datatype='real' name='[% Reordered 12M Cohort (copy)_5738078569650974730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=1 then sum([reordered_prev_quarter_with_trials])&#10;else IF [Parameters].[Parameter 2]=6 THEN &#10;SUM({FIXED [time_level],[time_period],[global_entity_id],[vertical_type_2] : AVG([vertical_type_2_level_reordered_prev_quarter_with_trials])})&#10;ELSE &#10;sum({fixed [time_level],[time_level],[global_entity_id]: avg([country_level_reordered_prev_quarter_with_trials] )})&#10;end end / LOOKUP([Calculation_721279646057222158],-3)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Stacking' datatype='real' name='[% Split (copy)_2219500600997187584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Stacked_Orders])/sum([successful_orders])' />
      </column>
      <column caption='% Zombies 3M Cohort' datatype='real' name='[% Zombies 6M Cohort (copy)_6064026557895430146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum({ fixed [time_level],[time_period],[global_entity_id],[vendor_type]: AVG([zombie_vendors_acquired_3_months_back])}) &#10;/&#10;sum({ fixed [time_level],[time_period],[global_entity_id],[vendor_type]: AVG([acquired_vendors_3_months_back])})' />
      </column>
