                <alias key='59.' value='Split Orders as % of Orders' />
                <alias key='60.' value='Avg. Unique Items per Basket' />
                <alias key='61.' value='CVR3 %' />
                <alias key='62.' value='Sessions (Shops Details Loaded)' />
                <alias key='63.' value='Vendor Sessions as % of Platform Sessions' />
                <alias key='64.' value='Realized Fees as % of GPV (excl. Orders w/ Subs. DF benefits' />
              </aliases>
            </column>
            <column alias='Month' caption='Frequency' datatype='real' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2.'>
              <calculation class='tableau' formula='2.' />
              <aliases>
                <alias key='1.' value='Week' />
                <alias key='2.' value='Month' />
              </aliases>
            </column>
            <column alias='Country' caption='Granularity' datatype='real' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='2.'>
              <calculation class='tableau' formula='2.' />
              <aliases>
                <alias key='1.' value='Vertical Type' />
                <alias key='2.' value='Country' />
                <alias key='3.' value='Management Entity' />
                <alias key='4.' value='Region' />
                <alias key='5.' value='DH' />
                <alias key='6.' value='Vertical' />
                <alias key='10.' value='City' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.119c67416vmb881d9uvuo081phg3'>
            <column caption='% Stacking' datatype='real' name='[% Split (copy)_2219500600997187584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Stacked_Orders])/sum([successful_orders])' />
            </column>
            <column datatype='integer' name='[AAA_Covered_MAU]' role='measure' type='quantitative' />
            <column datatype='integer' name='[AAA_Platform_MAU]' role='measure' type='quantitative' />
            <column caption='AOV' datatype='real' name='[Avg Basket Value (copy)_5788744068721303553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GMV])/SUM([successful_orders])' />
            </column>
            <column caption='Granularity' datatype='string' name='[Calculation_1696097859495088245]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case  [Parameters].[Parameter 2]&#10;when 1 Then [vendor_type]&#10;when 6 Then [vertical_type_2]&#10;when 2 then [country_name]&#10;WHEN 3 THEN [Calculation_721279646052278274]&#10;when 4 then [region]&#10;when 5 then [Calculation_1696097859495235702]&#10;WHEN 10 then [city]&#10;End' />
              <aliases>
                <alias key='&quot;0_grocery_multicategory&quot;' value='Grocery Multi- Category' />
                <alias key='&quot;1_specialty&quot;' value='Specialty' />
                <alias key='&quot;2_health_and_beauty&quot;' value='Health And Beauty' />
                <alias key='&quot;3_flowers&quot;' value='Flowers' />
                <alias key='&quot;4_pet_care&quot;' value='Pet Care' />
                <alias key='&quot;5_gm_and_others&quot;' value='GM And Others' />
              </aliases>
            </column>
            <column caption='DH' datatype='string' name='[Calculation_1696097859495235702]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;DH&quot;' />
            </column>
            <column caption='Granularity -1' datatype='string' name='[Calculation_1696097859495456887]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case  [Parameters].[Parameter 2]&#10;when 1 then [vertical_type_2]&#10;when 6 then [country_name]&#10;when 2 then [Calculation_721279646052278274]&#10;when 3 then [region]&#10;when 4 then str([Calculation_1696097859495235702])&#10;when 5 then [Calculation_1696097859495235702]&#10;when 10 then [country_name]&#10;End' />
              <aliases>
                <alias key='&quot;0_grocery_multicategory&quot;' value='Grocery Multi-Category' />
                <alias key='&quot;1_specialty&quot;' value='Specialty' />
                <alias key='&quot;2_health_and_beauty&quot;' value='Health And Beauty' />
                <alias key='&quot;3_flowers&quot;' value='Flowers' />
                <alias key='&quot;4_pet_care&quot;' value='Pet Care' />
                <alias key='&quot;5_gm_and_others&quot;' value='GM And Others' />
              </aliases>
            </column>
            <column caption='Granularity -2' datatype='string' name='[Calculation_1696097859495506040]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;when 1 then [country_name]&#10;when 6 Then [Calculation_721279646052278274]&#10;when 2 then [region]&#10;when 10 then [Calculation_721279646052278274]&#10;ELSE  [Calculation_1696097859495235702]&#10;END' />
            </column>
            <column caption='KPI Change WoW %' datatype='real' name='[Calculation_1696097859513413756]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([KPI (copy)_5788744069431971931]) - LOOKUP(ZN([KPI (copy)_5788744069431971931]), -1)) / ABS(LOOKUP(ZN([KPI (copy)_5788744069431971931]), -1))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='KPI Change PP' datatype='real' name='[Calculation_1696097859513512061]' role='measure' type='quantitative'>
