            <column caption='BLANK (copy) (copy) (copy) (copy) (copy) (copy)' datatype='integer' name='[BLANK (copy) (copy) (copy) (copy) (copy) (copy)_554224239010721793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum(Null)' />
            </column>
