            <column caption='% Reordered LM' datatype='real' name='[Calculation_721279646104793107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF [Parameters].[Parameter 2]=1 THEN &#10;SUM([reordered_prev_month])&#10;ELSE&#10;IF [Parameters].[Parameter 2]=6 THEN &#10;SUM({FIXED [time_level],[time_period],[global_entity_id],[vertical_type_2] : AVG([vertical_type_2_level_reordered_prev_month])})&#10;ELSE IF &#10; [Parameters].[Parameter 2]=10 THEN &#10;SUM({FIXED [time_level],[time_period],[global_entity_id],[city] : AVG([city_level_reordered_prev_month])})&#10;ELSE &#10;SUM({FIXED [time_level],[time_period],[global_entity_id] : AVG([country_level_reordered_prev_month])})&#10;END END END) / LOOKUP([Calculation_721279646056931341],-1)'>
                <table-calc ordering-type='Rows' />
