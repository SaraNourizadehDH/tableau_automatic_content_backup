            <column caption='Sessions_w_transactions (Deduped)' datatype='real' name='[Sessions (Deduped) (copy)_5738078569663520781]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=1 then &#10;sum({FIXED [time_level],[time_period],[global_entity_id],[vendor_type] : AVG([Sessions_w_transactions]) } )&#10;ELSE if [Parameters].[Parameter 2]=6 then null&#10;ELSE IF [Parameters].[Parameter 2]=10 then &#10;sum({FIXED [time_level],[time_period],[global_entity_id],[city] : AVG([City_Sessions_w_transactions]) } )&#10;ELSE sum({FIXED [time_level],[time_period],[global_entity_id] : AVG([Country_Sessions_w_transactions]) } )&#10;END END END' />
