    <worksheet name='KPI Change WoW'>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_ls_scorecard (dev_dmart)' name='federated.119c67416vmb881d9uvuo081phg3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Orders' caption='KPI Selector' datatype='real' name='[KPI Selector (copy 2)_5788744069435187292]' param-domain-type='list' role='measure' type='quantitative' value='5.'>
              <calculation class='tableau' formula='5.' />
              <aliases>
                <alias key='1.' value='MAU as % of Platform' />
                <alias key='2.' value='GMV' />
                <alias key='3.' value='GMV as % of Platform' />
                <alias key='4.' value='GMV as % of QC' />
