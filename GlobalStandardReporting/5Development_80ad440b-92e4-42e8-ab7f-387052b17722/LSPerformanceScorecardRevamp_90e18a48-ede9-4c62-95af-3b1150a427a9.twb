      </column>
      <column caption='% OD Orders' datatype='real' name='[Calculation_2219500600998936578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [is_own_delivery]=1 then [successful_orders] else Null end)/&#10;sum([successful_orders])' />
      </column>
      <column caption='ABV after discounts' datatype='real' name='[Calculation_2757047399602196480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([GBV])-sum([discounts]))/SUM([ORDERS_WITH_GBV])' />
