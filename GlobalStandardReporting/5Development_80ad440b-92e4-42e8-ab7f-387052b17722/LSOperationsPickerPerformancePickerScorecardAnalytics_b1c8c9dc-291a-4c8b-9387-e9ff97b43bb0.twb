          <datasources>
            <datasource caption='Main Table' name='federated.0cjl9o30f6b2yz1g985d30obxvt3' />
          </datasources>
          <datasource-dependencies datasource='federated.0cjl9o30f6b2yz1g985d30obxvt3'>
            <column caption='# Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[# GMV Eur (copy)_2624261629459402754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders])' />
            </column>
            <column caption='# Pickers per Vendor' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# Pickers (copy)_6855745327684739072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([picker_id]) / COUNTD([vendor_id])' />
            </column>
            <column caption='# Orders per Picker' datatype='real' default-format='n#,##0;-#,##0' name='[# Pickers per Vendor (copy)_6855745327688339457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([confirmed_orders]) / COUNTD([picker_id])' />
            </column>
            <column caption='# Pickers' datatype='integer' name='[Calculation_1393371555961368576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([picker_id])' />
            </column>
            <column caption='# GMV Eur' datatype='real' default-format='n&quot;€ &quot;#,##0;-&quot;€ &quot;#,##0' name='[Calculation_1393371555971620871]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_gross_eur])' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_1393371556019441685]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([local_date])' />
            </column>
            <column caption='% pickers under performing' datatype='real' default-format='p0%' name='[Calculation_2624261629417811968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNT(IF [general_score] &lt; 40 THEN [performance_category] ELSE NULL END)) /&#10;COUNT([performance_category])' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_5596004066529976320]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF LOWER([country]) = &apos;turkey&apos; THEN &quot;Yemeksepeti&quot; ELSE [management_entity] END' />
            </column>
            <column caption='Color picker' datatype='string' name='[Calculation_81346321433161728]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF(AVG([general_score])) &lt; 20 THEN &quot;E&quot;&#10;ELSEIF (AVG([general_score])) &lt; 40 THEN &quot;D&quot;&#10;ELSEIF (AVG([general_score])) &lt; 60 THEN &quot;C&quot;&#10;ELSEIF (AVG([general_score])) &lt; 80 THEN &quot;B&quot;&#10;ELSE &quot;A&quot;&#10;END' />
            </column>
            <column caption='Chain id plus chain name' datatype='string' name='[Calculation_81346321460809732]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[chain_name] + &quot; (&quot; + LEFT(LOWER([country]), 2) + &quot;)&quot;' />
            </column>
            <column caption='Vendor id plus vendor name' datatype='string' name='[Calculation_81346321462902789]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vendor_id] + &apos; - &apos; + [vendor_name]' />
            </column>
            <column caption='picker plus vendor' datatype='string' name='[Picker id plus picker name (copy)_81346321467084808]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str([picker_id]) + &apos; - &apos; + [picker_name] + &apos; (&apos; + [vendor_id] + &apos;)&apos;' />
            </column>
