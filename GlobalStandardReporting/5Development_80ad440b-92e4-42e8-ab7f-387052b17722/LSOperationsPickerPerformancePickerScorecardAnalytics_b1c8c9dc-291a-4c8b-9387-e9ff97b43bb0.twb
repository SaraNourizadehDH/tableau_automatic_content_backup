              <calculation class='tableau' formula='SUM([confirmed_orders])' />
            </column>
            <column caption='# GMV Eur' datatype='real' default-format='n&quot;€ &quot;#,##0;-&quot;€ &quot;#,##0' name='[Calculation_1393371555971620871]' role='measure' type='quantitative'>
