            <column caption='Color picker' datatype='string' name='[Calculation_81346321433161728]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF(AVG([general_score])) &lt; 20 THEN &quot;E&quot;&#10;ELSEIF (AVG([general_score])) &lt; 40 THEN &quot;D&quot;&#10;ELSEIF (AVG([general_score])) &lt; 60 THEN &quot;C&quot;&#10;ELSEIF (AVG([general_score])) &lt; 80 THEN &quot;B&quot;&#10;ELSE &quot;A&quot;&#10;END' />
            </column>
