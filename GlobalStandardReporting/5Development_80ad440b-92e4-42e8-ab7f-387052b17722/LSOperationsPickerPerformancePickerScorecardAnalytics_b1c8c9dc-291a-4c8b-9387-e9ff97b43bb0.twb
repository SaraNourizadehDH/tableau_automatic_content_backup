        <zone forceUpdate='true' h='1880' id='40' type-v2='text' w='26765' x='36618' y='31800'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#333333' fontname='Tableau Medium' fontsize='22'>Picker Scorecard Tables</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='35760' hidden-by-user='true' id='161' type-v2='text' w='96838' x='809' y='5760'>
          <formatted-text>
            <run bold='true' fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='12'>Scoring description</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='11'>Score</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Performance comes from </run>
            <run bold='true' fontcolor='#e15759' fontname='Tableau Medium' fontsize='10'>Poor</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> to </run>
            <run bold='true' fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='10'>Outstanding.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>We take into account six different metrics to infer if the picker has good performance or not, in five different levels (poor, bad, regular, good and outstanding).</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>The six metrics are described in the other icon but they are:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Items not delivered</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Partial Orders</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Items replaced from eligible</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Not processed items</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Out of Stock Failed Rate</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Average picking time (in seconds)</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='11'>Performance attribuition</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium'>The performance attribuition follows the  rule:</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'><![CDATA[    WHEN score < 25 THEN "5. Poor Performance"]]></run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>    WHEN </run>
            <run fontcolor='#000000' fontname='Roboto Mono' fontsize='10'>score</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> &lt; 50 THEN &quot;4. Bad Performance&quot;</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>    WHEN </run>
            <run fontcolor='#000000' fontname='Roboto Mono' fontsize='10'>score</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'><![CDATA[ < 75 THEN "3. Regular Performance"]]></run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>    WHEN </run>
            <run fontcolor='#000000' fontname='Roboto Mono' fontsize='10'>score</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'><![CDATA[ < 90 THEN "2. Good Performance"]]></run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>    WHEN </run>
            <run fontcolor='#000000' fontname='Roboto Mono' fontsize='10'>score</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> &gt;= 90 THEN &quot;1. Outstanding Performance&quot;</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='11'>Example</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>In a quick example, of pickers A and B </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>where A:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had not delivered less than 5% of the ordered products</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had delivered less than 7.5% of the orders partial fulfilled</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had replaced more than 20% of items eligible to that</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had more than 5% of the orders not processed</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had less than  2.5% of the orders failed due to Out-of-stock</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had on average less than 200 seconds to pick each item;</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>and B:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had not delivered more than 20% of the ordered products</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had delivered more than 50% of the orders partial fulfilled</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had replaced less than 5% of items eligible to that</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had more than 20% of the orders not processed</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had more than 10% of the orders failed due to Out-of-stock</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had on average more than 800 seconds to each item</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium'>In this case, A will have the rating </run>
            <run bold='true' fontcolor='#4e79a7' fontname='Tableau Medium'>Outstanding</run>
            <run fontcolor='#000000' fontname='Tableau Medium'> and B will be </run>
            <run bold='true' fontcolor='#e15759' fontname='Tableau Medium'>Poor</run>
            <run fontcolor='#000000' fontname='Tableau Medium'>.</run>
            <run>Æ&#10;</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Medium' italic='true'>Click again on the icon in the upper right corner to close this window.</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='dashed' />
            <format attr='border-width' value='1' />
            <format attr='background-color' value='#ffffff' />
          </zone-style>
        </zone>
        <zone h='1400' id='162' type-v2='dashboard-object' w='2574' x='53971' y='2240'>
          <button action='' active-visual-state-index='1'>
            <toggle-action>tabdoc:toggle-button-click-action window-id=&quot;{CDED856F-904F-4628-B0A1-BEC1C8125E97}&quot; zone-id=&quot;162&quot; zone-ids=[172]</toggle-action>
            <button-visual-state>
              <image-path>Image/information.png</image-path>
              <tooltip-text>Click to view the description of the metrics presented in this dashboard sheet.</tooltip-text>
            </button-visual-state>
            <button-visual-state>
              <image-path>Image/information.png</image-path>
              <tooltip-text>Click to view the description of the metrics presented in this dashboard sheet.</tooltip-text>
            </button-visual-state>
          </button>
        </zone>
        <zone h='1400' id='165' type-v2='dashboard-object' w='2574' x='80221' y='1040'>
          <button action='' active-visual-state-index='1'>
            <toggle-action>tabdoc:toggle-button-click-action window-id=&quot;{CDED856F-904F-4628-B0A1-BEC1C8125E97}&quot; zone-id=&quot;165&quot; zone-ids=[161]</toggle-action>
            <button-visual-state>
              <image-path>Image/score.png</image-path>
              <tooltip-text>Click to view the description of the metrics presented in this dashboard sheet.</tooltip-text>
            </button-visual-state>
            <button-visual-state>
              <image-path>Image/score.png</image-path>
              <tooltip-text>Click to view the description of the scores presented in this dashboard sheet.</tooltip-text>
            </button-visual-state>
          </button>
        </zone>
        <zone forceUpdate='true' h='41280' hidden-by-user='true' id='172' type-v2='text' w='97721' x='662' y='9200'>
          <formatted-text>
            <run bold='true' fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='12'>Filters and Metrics description</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='11'>Filters</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Granularity - </run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Defines the time interval for data analysis (daily, weekly, monthly, quarterly).</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Local Date </run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Filters data according to a specific local date or date range.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Date</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> - Selects specific dates within the selected range (Local Date filter)</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Vendor App -</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> Filters data based on the picking application used (Pelican or Godroid).</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Store Type L1 </run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>First-level classification of the store type.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Chain IDs Filter -</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> Allows filtering of Chains using a list of Chain IDs separated by commas or spaces.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Chain Name</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> - Allows filtering chains selecting their names</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Vendor IDs Filter -</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> Allows filtering of Vendors using a list of Vendor IDs separated by commas or spaces.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Chain Vendor</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> - Allows filtering vendors selecting their names</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>-</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> Picker Id </run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Selects pickers according to their ids</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Acc Manager -</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> Account manager of the vendors</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Performance category</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> - Filters the pickers only for their performance category (poor, bad, regular, good or outstanding)</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='11'>Metrics</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>We take into account six different metrics to infer if the picker has good performance or not, in five different levels (</run>
            <run bold='true' fontcolor='#e15759' fontname='Tableau Medium' fontsize='10'>poor</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>, </run>
            <run bold='true' fontcolor='#ff9d9a' fontname='Tableau Medium' fontsize='10'>bad</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>, </run>
            <run bold='true' fontcolor='#d4a6c8' fontname='Tableau Medium' fontsize='10'>regular</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>, </run>
            <run bold='true' fontcolor='#a0cbe8' fontname='Tableau Medium' fontsize='10'>good</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> and </run>
            <run bold='true' fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='10'>outstanding</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>).</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>They are:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Items not delivered</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Partial Orders</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Items replaced from eligible</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Not processed items</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Out of Stock Failed Rate</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Average picking time (in seconds)</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>All of them are calculated at the picker level. Aggregations using this table or dashboard can be problematic. Granularity filter already aggregates the metrics properly.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Items not delivered</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>   Percentage of ordered items not delivered to the user due to OOS of Confirmed Orders or OOS Failed Orders. </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Æ   </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Formula</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: Unfulfilled item calculations based on different order statuses and items from OOS failed orders, divided by the total relevant ordered items.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Partial Orders</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>   Percentage of orders that were delivered partially (with less products than ordered)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Æ   </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Formula</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: Number of Partial Fulfilled Orders / Confirmed Orders.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Items replaced from eligible</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>   Percentage of items eligible for replacement that were effectively replaced.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Æ   </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Formula</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: Number of replaced items / Eligible for replacement items</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' italic='true'>   Note: Eligible for replacements items are those that were In Cart but Not Sold + Not found items + Failed items due to OOS</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Not processed items</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>   Percentage of items that have status of not processed</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Æ   </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Formula</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: Not processed items / Qty ordered</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Out of Stock Failed Rate</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>   Percentage of orders failed due to out-of-stock (OOS) issues. </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Æ   </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Formula</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: OOS Failed Orders / Total Orders.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Average picking time (in seconds)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>   Average time in seconds that picker takes to pick each item of the orders.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Æ   </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Formula</run>
            <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: All picking time (in seconds) / Qty delivered</run>
            <run>Æ&#10;&#10;</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Medium' italic='true'>Click again on the icon in the upper right corner to close this window.</run>
            <run fontalignment='1'>Æ&#10;&#10;&#10;</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='dashed' />
            <format attr='border-width' value='1' />
            <format attr='background-color' value='#ffffff' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='2850' minheight='2850' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='178' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='99360' id='177' param='vert' type-v2='layout-flow' w='98824' x='588' y='320'>
                <zone forceUpdate='true' h='3120' id='13' type-v2='text' w='53750' x='368' y='1160'>
                  <formatted-text>
                    <run fontcolor='#476fa2' fontname='Tableau Bold' fontsize='36'>Pickers Performance Scorecard</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='35760' id='161' type-v2='text' w='96838' x='809' y='5760'>
                  <formatted-text>
                    <run bold='true' fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='12'>Scoring description</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='11'>Score</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Performance comes from </run>
                    <run bold='true' fontcolor='#e15759' fontname='Tableau Medium' fontsize='10'>Poor</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> to </run>
                    <run bold='true' fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='10'>Outstanding.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>We take into account six different metrics to infer if the picker has good performance or not, in five different levels (poor, bad, regular, good and outstanding).</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>The six metrics are described in the other icon but they are:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Items not delivered</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Partial Orders</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Items replaced from eligible</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Not processed items</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Out of Stock Failed Rate</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Average picking time (in seconds)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='11'>Performance attribuition</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>The performance attribuition follows the  rule:</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'><![CDATA[    WHEN score < 25 THEN "5. Poor Performance"]]></run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>    WHEN </run>
                    <run fontcolor='#000000' fontname='Roboto Mono' fontsize='10'>score</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> &lt; 50 THEN &quot;4. Bad Performance&quot;</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>    WHEN </run>
                    <run fontcolor='#000000' fontname='Roboto Mono' fontsize='10'>score</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'><![CDATA[ < 75 THEN "3. Regular Performance"]]></run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>    WHEN </run>
                    <run fontcolor='#000000' fontname='Roboto Mono' fontsize='10'>score</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'><![CDATA[ < 90 THEN "2. Good Performance"]]></run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>    WHEN </run>
                    <run fontcolor='#000000' fontname='Roboto Mono' fontsize='10'>score</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> &gt;= 90 THEN &quot;1. Outstanding Performance&quot;</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='11'>Example</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>In a quick example, of pickers A and B </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>where A:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had not delivered less than 5% of the ordered products</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had delivered less than 7.5% of the orders partial fulfilled</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had replaced more than 20% of items eligible to that</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had more than 5% of the orders not processed</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had less than  2.5% of the orders failed due to Out-of-stock</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had on average less than 200 seconds to pick each item;</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>and B:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had not delivered more than 20% of the ordered products</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had delivered more than 50% of the orders partial fulfilled</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had replaced less than 5% of items eligible to that</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had more than 20% of the orders not processed</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had more than 10% of the orders failed due to Out-of-stock</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Had on average more than 800 seconds to each item</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>In this case, A will have the rating </run>
                    <run bold='true' fontcolor='#4e79a7' fontname='Tableau Medium'>Outstanding</run>
                    <run fontcolor='#000000' fontname='Tableau Medium'> and B will be </run>
                    <run bold='true' fontcolor='#e15759' fontname='Tableau Medium'>Poor</run>
                    <run fontcolor='#000000' fontname='Tableau Medium'>.</run>
                    <run>Æ&#10;</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#000000' fontname='Tableau Medium' italic='true'>Click again on the icon in the upper right corner to close this window.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='dashed' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#ffffff' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='41280' id='172' type-v2='text' w='97721' x='662' y='9200'>
                  <formatted-text>
                    <run bold='true' fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='12'>Filters and Metrics description</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='11'>Filters</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Granularity - </run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Defines the time interval for data analysis (daily, weekly, monthly, quarterly).</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Local Date </run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Filters data according to a specific local date or date range.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Date</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> - Selects specific dates within the selected range (Local Date filter)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Vendor App -</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> Filters data based on the picking application used (Pelican or Godroid).</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Store Type L1 </run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='8'>First-level classification of the store type.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Chain IDs Filter -</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> Allows filtering of Chains using a list of Chain IDs separated by commas or spaces.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Chain Name</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> - Allows filtering chains selecting their names</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Vendor IDs Filter -</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> Allows filtering of Vendors using a list of Vendor IDs separated by commas or spaces.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Chain Vendor</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> - Allows filtering vendors selecting their names</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>-</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> Picker Id </run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Selects pickers according to their ids</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Acc Manager -</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> Account manager of the vendors</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Performance category</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> - Filters the pickers only for their performance category (poor, bad, regular, good or outstanding)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='11'>Metrics</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>We take into account six different metrics to infer if the picker has good performance or not, in five different levels (</run>
                    <run bold='true' fontcolor='#e15759' fontname='Tableau Medium' fontsize='10'>poor</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>, </run>
                    <run bold='true' fontcolor='#ff9d9a' fontname='Tableau Medium' fontsize='10'>bad</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>, </run>
                    <run bold='true' fontcolor='#d4a6c8' fontname='Tableau Medium' fontsize='10'>regular</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>, </run>
                    <run bold='true' fontcolor='#a0cbe8' fontname='Tableau Medium' fontsize='10'>good</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'> and </run>
                    <run bold='true' fontcolor='#4e79a7' fontname='Tableau Medium' fontsize='10'>outstanding</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>).</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>They are:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Items not delivered</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Partial Orders</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Items replaced from eligible</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Not processed items</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Out of Stock Failed Rate</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Average picking time (in seconds)</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>All of them are calculated at the picker level. Aggregations using this table or dashboard can be problematic. Granularity filter already aggregates the metrics properly.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Items not delivered</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>   Percentage of ordered items not delivered to the user due to OOS of Confirmed Orders or OOS Failed Orders. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Æ   </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Formula</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: Unfulfilled item calculations based on different order statuses and items from OOS failed orders, divided by the total relevant ordered items.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Partial Orders</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>   Percentage of orders that were delivered partially (with less products than ordered)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Æ   </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Formula</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: Number of Partial Fulfilled Orders / Confirmed Orders.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Items replaced from eligible</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>   Percentage of items eligible for replacement that were effectively replaced.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Æ   </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Formula</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: Number of replaced items / Eligible for replacement items</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' italic='true'>   Note: Eligible for replacements items are those that were In Cart but Not Sold + Not found items + Failed items due to OOS</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Not processed items</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>   Percentage of items that have status of not processed</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Æ   </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Formula</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: Not processed items / Qty ordered</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- % Out of Stock Failed Rate</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>   Percentage of orders failed due to out-of-stock (OOS) issues. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Æ   </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Formula</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: OOS Failed Orders / Total Orders.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>- Average picking time (in seconds)</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>   Average time in seconds that picker takes to pick each item of the orders.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Æ   </run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>Formula</run>
                    <run fontcolor='#000000' fontname='Tableau Medium' fontsize='10'>: All picking time (in seconds) / Qty delivered</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#000000' fontname='Tableau Medium' italic='true'>Click again on the icon in the upper right corner to close this window.</run>
                    <run fontalignment='1'>Æ&#10;&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='dashed' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#ffffff' />
                  </zone-style>
                </zone>
