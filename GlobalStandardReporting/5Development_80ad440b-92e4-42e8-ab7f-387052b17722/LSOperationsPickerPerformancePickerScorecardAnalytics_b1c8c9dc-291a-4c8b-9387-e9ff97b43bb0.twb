    <window class='dashboard' maximized='true' name='Picker Scorecard' tab-color='#4f779a'>
      <viewpoints>
        <viewpoint name='Line plot'>
          <zoom type='entire-view' />
        </viewpoint>
        <viewpoint name='Per country'>
          <zoom type='fit-width' />
        </viewpoint>
        <viewpoint name='Per entity'>
          <zoom type='entire-view' />
          <highlight field='[federated.0cjl9o30f6b2yz1g985d30obxvt3].[none:performance_category:nk]'>
            <bucket-selection />
          </highlight>
        </viewpoint>
        <viewpoint name='Table view chain'>
          <zoom type='fit-width' />
        </viewpoint>
