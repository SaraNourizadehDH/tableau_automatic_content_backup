      <aliases enabled='yes' />
      <column caption='Job Error %' datatype='real' default-format='p0.0%' name='[Calculation_1931762786072416257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([error_job_count])/SUM([total_jobs_sent])' />
      </column>
      <column caption='Product Available in Catalog Vendor' datatype='integer' name='[Calculation_195343657202266112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [available_in_catalog_vendor]=1 THEN ( [global_entity_id]+[vendor_id]+[code_final])END)' />
      </column>
      <column caption='Product Available in Catalog Vendor %' datatype='real' default-format='p0%' name='[Calculation_195343657203011585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_195343657202266112]/[Calculation_661184741832527872]' />
      </column>
      <column caption='Product Available in Catalog Chain' datatype='integer' name='[Calculation_195343657203752962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [available_in_catalog_chain]=1 THEN ( [global_entity_id]+[vendor_id]+[code_final])END)' />
      </column>
      <column caption='Product Available in Catalog Chain %' datatype='real' default-format='p0%' name='[Calculation_195343657203900419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_195343657203752962]/[Calculation_661184741832527872]' />
      </column>
      <column caption='Available in PIM' datatype='integer' name='[Calculation_195343657205452804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [available_in_pim]=1 OR [available_in_pim_barcode]=1 THEN ( [global_entity_id]+[vendor_id]+[code_final])END)' />
      </column>
      <column caption='Available in PIM %' datatype='real' default-format='p0%' name='[Calculation_195343657205669893]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_195343657205452804]/[Calculation_661184741832527872]' />
      </column>
      <column caption='Product Shared via SFTP' datatype='integer' name='[Calculation_195343657207058438]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [product_shared]=1 THEN ( [global_entity_id]+[vendor_id]+[code_final])END)' />
      </column>
      <column caption='Product Shared via SFTP %' datatype='real' default-format='p0%' name='[Calculation_195343657207427079]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_195343657207058438]/[Calculation_661184741832527872]' />
      </column>
      <column caption='Chain_SKU_Cnt' datatype='integer' name='[Calculation_195343657316581385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( [global_entity_id]+[chain_name_platform]+[code_final])' />
      </column>
      <column caption='KPI' datatype='string' name='[Calculation_1972858135808778240]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Click for Document&quot;' />
      </column>
      <column caption='Vendor_SKU_Cnt' datatype='integer' name='[Calculation_661184741832527872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( [global_entity_id]+[vendor_id]+[code_final])' />
      </column>
      <column caption=' Total SKU Count (vendor)' datatype='integer' name='[Calculation_661184741880512513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [vendor_id],[global_entity_id]: COUNTD( [global_entity_id]+[vendor_id]+[code_final])}' />
      </column>
      <column caption='Total Vendor Product Count (Available + Opportunity ) Entity Level' datatype='integer' name='[Calculation_661184741883891714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE[management_entity]: SUM([Calculation_661184741880512513])}' />
      </column>
      <column caption='Total Chain Level Product Count (Available + Opportunity ) ' datatype='integer' name='[Calculation_661184741889843203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],[chain_name_platform]: COUNTD( [global_entity_id]+[chain_name_platform]+[code_final])}' />
      </column>
      <column caption='AAA Vendor Flag' datatype='string' name='[Calculation_661184741893697540]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [is_aaa_vendor] WHEN TRUE THEN &apos;AAA Vendor&apos; ELSE &apos;NON AAA Vendor&apos; END' />
      </column>
      <column caption='Final Bucket' datatype='string' name='[Calculation_661184741899079685]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [bucket] WHEN &quot;Product Updates&quot; THEN &quot;3.Product Shared &amp; Listed - Already Assigned&quot;&#13;&#10;                WHEN &quot;Add a Product flow&quot; THEN &quot;1.Product Shared &amp; Not Listed at vendor- To be assigned to Vendor&quot;&#13;&#10;                WHEN &quot;New Content Creation&quot; THEN &quot;2.Product Shared &amp; Not Listed- New Content Creation&quot;&#13;&#10;                WHEN &quot;Add a product flow- Assignment from chain&quot; THEN &quot;1.Product Shared &amp; Not Listed at vendor- To be assigned to Vendor&quot;&#13;&#10;                WHEN &quot;Products Not shared&quot; THEN &quot;4.Products Not shared &amp; Assigned&quot;&#13;&#10;                WHEN &quot;OTHERS&quot; THEN &quot;OTHERS&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Vendor Product Count (Available + Opportunity ) Country Level' datatype='integer' name='[Calculation_846676751925166080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [country]: SUM([Calculation_661184741880512513])}' />
      </column>
