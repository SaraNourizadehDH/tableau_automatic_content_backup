          <datasource-dependencies datasource='federated.1vohhcu15y0x24118cft005j7ysr'>
            <column caption='PO lines created distribution' datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_po_lines]) / TOTAL(SUM([total_po_lines]))'>
                <table-calc ordering-type='ColumnInPane' />
              </calculation>
            </column>
            <column caption='Lines with recent PO, %' datatype='real' default-format='p0.0%' name='[Calculation_604889784840876034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([skus_with_prev_po]) / SUM([total_po_lines])' />
            </column>
            <column caption='Category' datatype='string' name='[Calculation_604889784842072067]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([category_level_zero] = &apos;Fresh&apos; OR  [category_level_zero] = &apos;Ultra Fresh&apos;) THEN &#13;&#10;    [category_level_zero]&#13;&#10;ELSE &#13;&#10;    &apos;AMBIENT&apos; &#13;&#10;END' />
            </column>
            <column caption='Lines with recent PO failed, % from all lines' datatype='real' default-format='p0%' name='[Lines with recent PO failed, % (copy)_604889784847212551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([skus_with_prev_po_failed])/SUM([total_po_lines])' />
            </column>
            <column caption='Lines with recent PO failed, %' datatype='real' default-format='p0.0%' name='[Lines with recent PO, % (copy)_604889784846643206]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([skus_with_prev_po_failed])/SUM([skus_with_prev_po])' />
            </column>
            <column caption='PO lines created distribution (copy)' datatype='real' default-format='p0.00%' name='[PO lines created distribution (copy)_1390767920149594114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM([total_po_lines])) / WINDOW_SUM(SUM([total_po_lines]))'>
                <table-calc ordering-type='ColumnInPane' />
