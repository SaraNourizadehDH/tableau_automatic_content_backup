    <worksheet name='1. PO adjustments IDP'>
      <repository-location id='1_POadjustmentsIDP' path='/t/GlobalStandardReporting/workbooks/DM-Operations-SCM-IDPrecearchtemp' revision='' site='GlobalStandardReporting' />
      <layout-options>
        <title>
          <formatted-text>
            <run>IDP PO adjustments, depending on prev. POs</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='idp_po_creation_tmp (rl_dmart)' name='federated.1vohhcu15y0x24118cft005j7ysr' />
          </datasources>
          <datasource-dependencies datasource='federated.1vohhcu15y0x24118cft005j7ysr'>
            <column caption='Adjusted PO lines, without  recent PO %' datatype='real' name='[Adjusted PO lines, with recent PO % (copy)_802766694156435457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - SUM([total_matched_idp_po_lines_with_no_prev_po])/ SUM([idp_po_lines_with_no_prev_po])' />
            </column>
            <column caption='Adjusted PO lines, with recent PO failed %' datatype='real' name='[Adjusted PO lines, with recent PO % (copy)_802766694163181570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - SUM([total_matched_idp_po_lines_with_prev_po_failed])/ SUM([idp_po_lines_with_prev_po_failed])' />
            </column>
            <column caption='Adjusted PO lines, with recent PO NOT failed %' datatype='real' name='[Adjusted PO lines, with recent PO failed % (copy)_802766694163415043]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - SUM([total_matched_idp_po_lines_with_no_prev_po_failed])/ SUM([idp_po_lines_with_no_prev_po_failed])' />
            </column>
            <column caption='IDP adoption' datatype='real' default-format='p0%' name='[Calculation_1335317350086881280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([idp_po_lines]) / SUM([total_po_lines])' />
            </column>
            <column caption='Category' datatype='string' name='[Calculation_604889784842072067]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([category_level_zero] = &apos;Fresh&apos; OR  [category_level_zero] = &apos;Ultra Fresh&apos;) THEN &#13;&#10;    [category_level_zero]&#13;&#10;ELSE &#13;&#10;    &apos;AMBIENT&apos; &#13;&#10;END' />
            </column>
            <column caption='Adjusted PO lines, with recent PO %' datatype='real' name='[Changed PO lines, % (copy)_802766694155988992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - SUM([total_matched_idp_po_lines_with_prev_po])/ SUM([idp_po_lines_with_prev_po])' />
            </column>
            <column caption='Category Level Zero' datatype='string' name='[category_level_zero]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Idp Po Lines' datatype='integer' name='[idp_po_lines]' role='measure' type='quantitative' />
            <column datatype='integer' name='[idp_po_lines_with_no_prev_po]' role='measure' type='quantitative' />
            <column datatype='integer' name='[idp_po_lines_with_no_prev_po_failed]' role='measure' type='quantitative' />
            <column datatype='integer' name='[idp_po_lines_with_prev_po]' role='measure' type='quantitative' />
            <column datatype='integer' name='[idp_po_lines_with_prev_po_failed]' role='measure' type='quantitative' />
            <column caption='Is Dc' datatype='boolean' name='[is_dc]' role='dimension' type='nominal' />
