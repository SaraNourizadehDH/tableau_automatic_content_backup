      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1vohhcu15y0x24118cft005j7ysr].[pcto:sum:total_po_lines:qk]&quot;' value='Distribution of PO Lines' />
          <alias key='&quot;[federated.1vohhcu15y0x24118cft005j7ysr].[usr:Adjusted PO lines, with recent PO \% (copy)_802766694156435457:qk]&quot;' value='Adjusted PO lines, WITHOUT  recent PO %' />
          <alias key='&quot;[federated.1vohhcu15y0x24118cft005j7ysr].[usr:PO lines created distribution (copy)_1390767920149594114:qk]&quot;' value='PO lines created distribution rolling' />
        </aliases>
      </column>
      <column caption='Adjusted PO lines, without  recent PO %' datatype='real' name='[Adjusted PO lines, with recent PO % (copy)_802766694156435457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([total_matched_idp_po_lines_with_no_prev_po])/ SUM([idp_po_lines_with_no_prev_po])' />
      </column>
      <column caption='Adjusted PO lines, with recent PO failed %' datatype='real' name='[Adjusted PO lines, with recent PO % (copy)_802766694163181570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([total_matched_idp_po_lines_with_prev_po_failed])/ SUM([idp_po_lines_with_prev_po_failed])' />
      </column>
      <column caption='Adjusted PO lines, with recent PO NOT failed %' datatype='real' name='[Adjusted PO lines, with recent PO failed % (copy)_802766694163415043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([total_matched_idp_po_lines_with_no_prev_po_failed])/ SUM([idp_po_lines_with_no_prev_po_failed])' />
      </column>
      <column caption='PO lines created distribution' datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_po_lines]) / TOTAL(SUM([total_po_lines]))'>
          <table-calc ordering-type='ColumnInPane' />
        </calculation>
      </column>
      <column caption='IDP adoption' datatype='real' default-format='p0%' name='[Calculation_1335317350086881280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([idp_po_lines]) / SUM([total_po_lines])' />
      </column>
      <column caption='Changed PO lines, %' datatype='real' name='[Calculation_1335317350087720961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([total_matched_idp_po_lines])/ SUM([idp_po_lines])' />
      </column>
      <column caption='Hour Group' datatype='string' name='[Calculation_1390767920152313861]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [creation_hour] &lt;=12 THEN &apos;00 - 12&apos; ELSE &apos;12+&apos; END' />
      </column>
      <column caption='Lines with recent PO, %' datatype='real' default-format='p0.0%' name='[Calculation_604889784840876034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([skus_with_prev_po]) / SUM([total_po_lines])' />
      </column>
      <column caption='Category' datatype='string' name='[Calculation_604889784842072067]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([category_level_zero] = &apos;Fresh&apos; OR  [category_level_zero] = &apos;Ultra Fresh&apos;) THEN &#13;&#10;    [category_level_zero]&#13;&#10;ELSE &#13;&#10;    &apos;AMBIENT&apos; &#13;&#10;END' />
      </column>
      <column caption='Calculation1' datatype='string' name='[Calculation_604889784842862596]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[category_level_zero]' />
      </column>
      <column caption='Adjusted PO lines, with recent PO %' datatype='real' name='[Changed PO lines, % (copy)_802766694155988992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - SUM([total_matched_idp_po_lines_with_prev_po])/ SUM([idp_po_lines_with_prev_po])' />
      </column>
      <column caption='Lines with recent PO failed, % from all lines' datatype='real' default-format='p0%' name='[Lines with recent PO failed, % (copy)_604889784847212551]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([skus_with_prev_po_failed])/SUM([total_po_lines])' />
      </column>
      <column caption='Lines with recent PO failed, %' datatype='real' default-format='p0.0%' name='[Lines with recent PO, % (copy)_604889784846643206]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([skus_with_prev_po_failed])/SUM([skus_with_prev_po])' />
      </column>
      <column caption='PO lines created distribution (copy)' datatype='real' default-format='p0.00%' name='[PO lines created distribution (copy)_1390767920149594114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([total_po_lines])) / WINDOW_SUM(SUM([total_po_lines]))'>
          <table-calc ordering-type='ColumnInPane' />
        </calculation>
      </column>
