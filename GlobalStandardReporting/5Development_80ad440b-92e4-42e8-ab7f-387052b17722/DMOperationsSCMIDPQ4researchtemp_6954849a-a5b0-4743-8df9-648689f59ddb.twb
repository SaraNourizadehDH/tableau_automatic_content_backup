    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Info'>
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98000' id='3' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run bold='true' fontcolor='#333333'>The aim of the report is to show the accuracy of IDP model.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>Business owner: Nikhil Goel</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>Data owner: Tanya Ovchinnikova</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>Updated: daily</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>Source: fulfillment-dwh-production.rl_dmart.idp_forecast_performance_group</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#333333' fontsize='10'>Metrics</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>Data restriction: active, not stale skus with 100% of availability at the date of metric calculation.</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#333333'>BIAS</run>
              <run fontcolor='#333333'> - shows, whether we in general tend to over or under forecast. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>= predicted qty / sold qty</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333'>WAPE</run>
              <run fontcolor='#333333'> - shows the scale of forecast error comparing to the sales</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>= absolute value(sold qty - predicted qty) / sold qty</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333'>WAPE rolling </run>
              <run fontcolor='#333333'>- takes into account error on weekly level, not for each day separately. Will be always less the ordinary WAPE</run>
              <run>Æ&#10;</run>
              <run fontcolor='#333333'>= absolute value(sold qty weekly - predicted qty weekly) / sold qty weekly</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#333333'>Forecast factor application, %</run>
              <run fontcolor='#333333'> shows for what share of sku-days for active skus forecast factor was applicated</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#333333'>Skus 100 % available</run>
              <run fontcolor='#333333'> - shows, for what share of all sellable skus our metrics were valid as lonfg as we take into account only skus with 1005 AVAILABILITY.</run>
              <run>

Metric calculation in details 
</run>
              <run auto-url='true' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/document/d/1EovqeIE_Uy7MWc1-gzFvEus4O-ogIlN44LDj53BI3uM/edit?usp=sharing&amp;quot;'>https://docs.google.com/document/d/1EovqeIE_Uy7MWc1-gzFvEus4O-ogIlN44LDj53BI3uM/edit?usp=sharing</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='296' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='295' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone forceUpdate='true' h='98000' id='3' type-v2='text' w='98400' x='800' y='1000'>
                  <formatted-text>
                    <run bold='true' fontcolor='#333333'>The aim of the report is to show the accuracy of IDP model.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333'>Business owner: Nikhil Goel</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333'>Data owner: Tanya Ovchinnikova</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333'>Updated: daily</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333'>Source: fulfillment-dwh-production.rl_dmart.idp_forecast_performance_group</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='10'>Metrics</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333'>Data restriction: active, not stale skus with 100% of availability at the date of metric calculation.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#333333'>BIAS</run>
                    <run fontcolor='#333333'> - shows, whether we in general tend to over or under forecast. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333'>= predicted qty / sold qty</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333'>WAPE</run>
                    <run fontcolor='#333333'> - shows the scale of forecast error comparing to the sales</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333'>= absolute value(sold qty - predicted qty) / sold qty</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333'>WAPE rolling </run>
                    <run fontcolor='#333333'>- takes into account error on weekly level, not for each day separately. Will be always less the ordinary WAPE</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333'>= absolute value(sold qty weekly - predicted qty weekly) / sold qty weekly</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#333333'>Forecast factor application, %</run>
                    <run fontcolor='#333333'> shows for what share of sku-days for active skus forecast factor was applicated</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#333333'>Skus 100 % available</run>
                    <run fontcolor='#333333'> - shows, for what share of all sellable skus our metrics were valid as lonfg as we take into account only skus with 1005 AVAILABILITY.</run>
                    <run>

Metric calculation in details 
</run>
                    <run auto-url='true' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/document/d/1EovqeIE_Uy7MWc1-gzFvEus4O-ogIlN44LDj53BI3uM/edit?usp=sharing&amp;quot;'>https://docs.google.com/document/d/1EovqeIE_Uy7MWc1-gzFvEus4O-ogIlN44LDj53BI3uM/edit?usp=sharing</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{3675261C-5246-4E88-8547-609377C7E4D6}' />
    </dashboard>
  </dashboards>
