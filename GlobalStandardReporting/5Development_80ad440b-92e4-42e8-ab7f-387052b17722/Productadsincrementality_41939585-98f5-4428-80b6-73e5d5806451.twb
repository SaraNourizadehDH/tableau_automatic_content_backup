      <aliases enabled='yes' />
      <column caption='Total_sales_SKU' datatype='integer' name='[Calculation_30540087393394689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [product_sku] : SUM([all_orders])}' />
      </column>
      <column caption='Calculation2' datatype='integer' name='[Calculation_30540087395598338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(&apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='total_impressions_sku' datatype='integer' name='[Calculation_30540087397961732]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [product_sku]:SUM([product_ad_impression])}' />
      </column>
      <column caption='Calculation3' datatype='real' name='[Calculation_30540087465566213]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([all_orders])/SUM([product_ad_impression])' />
      </column>
      <column caption='CTR' datatype='real' name='[Calculation_3135912767297048576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4346536639634788352])/sum([impressions])' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_3135912767341649921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([product_sku])' />
      </column>
      <column caption='total ATC' datatype='integer' name='[Calculation_4346536639634788352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[direct_and_others] +[banners]+[swimlanes]+[product_ads]' />
      </column>
