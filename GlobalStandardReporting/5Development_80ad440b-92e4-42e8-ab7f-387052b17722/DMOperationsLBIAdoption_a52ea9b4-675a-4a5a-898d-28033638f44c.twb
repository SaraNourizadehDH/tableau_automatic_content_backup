              <calculation class='tableau' formula='COUNT(&#13;&#10;IF [LBI adoption, Store level (copy)_1147010596979413000] &gt;= 0.8&#13;&#10;THEN  [warehouse_id] ELSE NULL END&#13;&#10;)' />
