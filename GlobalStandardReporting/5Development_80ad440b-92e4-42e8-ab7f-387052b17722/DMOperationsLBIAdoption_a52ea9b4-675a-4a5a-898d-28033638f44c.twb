    <worksheet name='LBIv2 adoption impact region level (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='12'>Metric Change on Region Level</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dmart_ops_lbi_adoption_impact_group (rl_dmart)' name='federated.071u9zk0kb4zpb13phtge0aumpiy' />
            <datasource caption='dmart_ops_lbi_country_comparison (rl_dmart)' name='federated.0zuo9s31i78saz1frgpcq00gg9mh' />
          </datasources>
          <datasource-dependencies datasource='federated.071u9zk0kb4zpb13phtge0aumpiy'>
            <column caption='     Diff in % Spoilage,  control' datatype='real' default-format='p0.0%' name='[     Diff in % Spoilage, revenue  (copy)_717761197319798787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([% Spoilage, revenue (copy)_717761197319122945]) - LOOKUP(ZN([% Spoilage, revenue (copy)_717761197319122945]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='     Diff in Picking Time control' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[     Diff in Picking Time (copy)_717761197320052740]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Picking time (copy)_717761197319651330]) - LOOKUP(ZN([Picking time (copy)_717761197319651330]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='     Diff. in % PFR control' datatype='real' default-format='p0.0%' name='[     Diff. in % PFR  (copy)_717761197533036549]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([% PFR (copy)_717761197318979584]) - LOOKUP(ZN([% PFR (copy)_717761197318979584]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='% PFR control' datatype='real' default-format='p0.00%' name='[% PFR (copy)_717761197318979584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partial_orders_control])/SUM([successful_orders_control])' />
            </column>
            <column caption='% Spoilage,  control' datatype='real' name='[% Spoilage, revenue (copy)_717761197319122945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(-[spoilage_eur_control])/ SUM([total_retail_revenue_control])' />
            </column>
            <column caption='     Diff in % Spoilage ' datatype='real' default-format='p0.0%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_5755600323984990270]) - LOOKUP(ZN([Calculation_5755600323984990270]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='     Diff. in % PFR ' datatype='real' default-format='p0.0%' name='[Calculation2]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_969681363449167875]) - LOOKUP(ZN([Calculation_969681363449167875]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='     Diff in Picking Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation3]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([Calculation_252483122685562880]) - LOOKUP(ZN([Calculation_252483122685562880]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='FIFO adherance level' datatype='string' name='[Calculation_1524749953363070977]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [fifo_adherance] &gt; 0.5 THEN &apos;&gt; 50%&apos; ELSE &apos;&lt;= 50%&apos; &#13;&#10;END' />
            </column>
            <column caption='Picking time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_252483122685562880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([picking_time_s_nom]) / SUM([picking_time_s_denom])' />
            </column>
            <column caption='% Spoilage' datatype='real' name='[Calculation_5755600323984990270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([spoilage_eur])/ SUM([total_retail_revenue])' />
            </column>
            <column caption='% PFR' datatype='real' default-format='p0.00%' name='[Calculation_969681363449167875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([partial_orders])/SUM([successful_orders])' />
            </column>
            <column caption='Picking time control' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Picking time (copy)_717761197319651330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([picking_time_s_nom_control]) / SUM([picking_time_s_denom_control])' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
