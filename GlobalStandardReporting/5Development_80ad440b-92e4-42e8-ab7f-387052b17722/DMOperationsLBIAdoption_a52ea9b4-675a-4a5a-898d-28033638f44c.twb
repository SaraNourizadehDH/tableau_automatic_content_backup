        <column caption='Franchise Flag' datatype='string' name='[Calculation_5582774756275769371]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF CONTAINS([warehouse_name], &quot;Franchise&quot;)&#10;OR ([country] = &apos;Turkey&apos; AND CONTAINS([warehouse_name], &quot;FR&quot;))&#10;THEN &apos;true&apos; ELSE &apos;false&apos; &#10;END' />
