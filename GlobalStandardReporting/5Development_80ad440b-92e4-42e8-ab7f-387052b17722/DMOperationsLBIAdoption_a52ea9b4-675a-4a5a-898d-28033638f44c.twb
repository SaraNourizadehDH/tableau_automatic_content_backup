      <aliases enabled='yes' />
      <column caption='# Country total' datatype='integer' default-format='n#,##0;-#,##0' name='[# Country improved metric (copy)_404761024586895361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;[country])' />
      </column>
      <column caption='# Country improved metric' datatype='integer' default-format='n#,##0;-#,##0' name='[# Stores improved metric (copy)_404761024585822208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF  [final_controlled_change] &lt;0&#13;&#10;THEN [country] ELSE NULL end&#13;&#10;)' />
      </column>
      <column caption='# Stores improved metric' datatype='integer' default-format='n#,##0;-#,##0' name='[% Stores improved metric (copy)_717761197619056654]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([warehouses_improved_vs_control])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0zuo9s31i78saz1frgpcq00gg9mh].[sum:final_controlled_change:qk]&quot;' value='Net Improvement' />
        </aliases>
      </column>
      <column caption='Net Improvement %' datatype='real' name='[Calculation_3766557409306234886]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([final_controlled_change]) / SUM([value_before_rollout])' />
      </column>
      <column caption='% Skus on multiple locations' datatype='real' name='[Calculation_3766557409573761031]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='[sku_multiple_locations_qty]/[sku_with_location_qty]' />
      </column>
      <column caption='%  Countries improved metric' datatype='real' default-format='p0%' name='[Calculation_404761024586960898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[# Stores improved metric (copy)_404761024585822208]/[# Country improved metric (copy)_404761024586895361]' />
      </column>
      <column caption='LBIv2 first rollout' datatype='string' name='[Calculation_4083638970575654917]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([lbiv2_start_week_min])' />
      </column>
      <column caption='% Stores with full comparison period' datatype='real' name='[Calculation_5582774696522772543]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([warehouses_with_full_comparison_period])/SUM([total_warehouses])' />
      </column>
      <column caption='% Stores improved metric' datatype='real' default-format='p0%' name='[Calculation_717761197616853004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[% Stores improved metric (copy)_717761197619056654]/[Calculation_717761197617188877]' />
      </column>
      <column caption='# Stores Total' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_717761197617188877]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_warehouses])' />
      </column>
