          <alias key='&quot;[federated.071u9zk0kb4zpb13phtge0aumpiy].[usr:Calculation2:qk:2]&quot;' value='     Diff. in % PFR' />
          <alias key='&quot;[federated.071u9zk0kb4zpb13phtge0aumpiy].[usr:Calculation3:qk:2]&quot;' value='     Diff in Picking Time ' />
