          <alias key='&quot;[federated.1jjs9790e8io7b1agtbas1njs3uh].[sum:proper_lbi_adopeted_dmart:qk]&quot;' value='# Proper LBI Adopted Dmarts' />
          <alias key='&quot;[federated.1jjs9790e8io7b1agtbas1njs3uh].[usr:Calculation_1312306766931734532:qk]&quot;' value='% LBI Started Dmarts' />
          <alias key='&quot;[federated.1jjs9790e8io7b1agtbas1njs3uh].[usr:Calculation_1312306766931894277:qk]&quot;' value='% Proper LBI Adopted Dmarts' />
          <alias key='&quot;[federated.1jjs9790e8io7b1agtbas1njs3uh].[usr:Calculation_5909778301494931456:qk]&quot;' value='% LBI Adoption' />
          <alias key='&quot;[federated.1jjs9790e8io7b1agtbas1njs3uh].[usr:Calculation_5909778301501853697:qk]&quot;' value='%SKUs with location' />
        </aliases>
      </column>
      <column caption='Adoption_rate' datatype='real' name='[Calculation_1312306766923702273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[active_sku_count_w_location]/[active_sku_count]' />
      </column>
      <column caption='LBI_adopted_dmarts_perc' datatype='real' name='[Calculation_1312306766931734532]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([lbi_adopeted_dmarts])/SUM([total_dmarts])' />
      </column>
      <column caption='proper_lbi_adopted_dmarts_perc' datatype='real' name='[Calculation_1312306766931894277]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([proper_lbi_adopeted_dmart])/SUM([total_dmarts])' />
      </column>
      <column caption='Geography_column' datatype='string' name='[Calculation_1312306766963294215]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[proper_lbi_adopted_dmarts_perc Parameter] WHEN &apos;Global&apos; THEN &apos;Global&apos;&#10;WHEN &apos;Regions&apos; THEN [Region]&#10;WHEN &apos;Country&apos; THEN [country] END' />
      </column>
      <column caption='Latest_date' datatype='date' name='[Calculation_1312306766977314826]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([static_day])' />
      </column>
      <column caption='is_latest_date' datatype='boolean' name='[Calculation_1312306766977527819]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[static_day] = {MAX([static_day])}' />
      </column>
      <column caption='Latest_refresh_date' datatype='date' name='[Calculation_238409314097803266]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([refresh_date])' />
      </column>
      <column caption='%_skus_fixed' datatype='real' name='[Calculation_5018065527720632320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//IF {FIXED [Warehouse Id],[Static Day]: [%_skus_with_loc]} &lt; {FIXED [Warehouse Id],[Static Day]:[LBI_ADOPTION]} THEN {FIXED [Warehouse Id],[Static Day]:[LBI_ADOPTION]} ELSE { FIXED [Warehouse Id],[Static Day]: [%_skus_with_loc]}  END&#10;&#10;&#10;IF {FIXED [warehouse_id],[static_day]: [Calculation_5909778301501853697]} &lt; {FIXED [warehouse_id],[static_day]:[Calculation_5909778301494931456]} THEN {FIXED [warehouse_id],[static_day]:[Calculation_5909778301494931456]} ELSE { FIXED [warehouse_id],[static_day]: [Calculation_5909778301501853697]}  END' />
      </column>
      <column caption='CF' datatype='integer' name='[Calculation_5518739166616846337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([active_sku_count_w_location])/SUM([active_sku_count]) &lt; 0.5 THEN 1 ELSE 2 END' />
      </column>
      <column caption='LBI_ADOPTION' datatype='real' name='[Calculation_5909778301494931456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_sku_count_w_location])/SUM([active_sku_count])' />
      </column>
      <column caption='%_skus_with_loc' datatype='real' name='[Calculation_5909778301501853697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sku_with_loc])/SUM([sku_qty])' />
      </column>
      <column caption='Color_locs_more_than_50_skus' datatype='integer' name='[Calculation_6560126179920015360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [locs_more_than_50_sku] &gt; 0 THEN 1 ELSE 0 END' />
      </column>
      <column caption='User_Entitlement' datatype='boolean' name='[Calculation_6866793171625394178]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Metric_column' datatype='real' name='[Geography_column (copy)_1312306767212367884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Geography_Selector (copy)] WHEN &apos;# LBI Started Dmarts&apos; THEN SUM([lbi_adopeted_dmarts])&#10;WHEN &apos;# Proper LBI Adopted Dmarts&apos; THEN SUM([proper_lbi_adopeted_dmart])&#10;WHEN &apos;% Proper LBI Adopted Dmarts&apos; THEN SUM([proper_lbi_adopeted_dmart])/SUM([total_dmarts])&#10;WHEN &apos;% LBI Started Dmarts&apos; THEN SUM([lbi_adopeted_dmarts])/SUM([total_dmarts]) END' />
      </column>
      <column caption='LBI_ADOPTION_colors' datatype='integer' name='[LBI_ADOPTION (copy)_3041055654805221376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([sku_with_loc_lbi])/SUM([sku_qty]) &gt;= 0.8 THEN 1&#10;ELSEIF SUM([sku_with_loc_lbi])/SUM([sku_qty]) &gt; 0.6 AND SUM([sku_with_loc_lbi])/SUM([sku_qty]) &lt; 0.8 THEN 2&#10;ELSE 3&#10;END' />
      </column>
      <column caption='Region1' datatype='string' name='[Region]' role='dimension' type='nominal' />
      <_.fcp.ObjectModelTableType.true...column caption='an_lbi_adoption_base_v3' datatype='table' name='[__tableau_internal_object_id__].[an_lbi_adoption_base_v3_803AB629A8EB44B4877847F8C762D6EA]' role='measure' type='quantitative' />
