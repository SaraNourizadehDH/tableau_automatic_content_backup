      <datasource-dependencies datasource='Parameters'>
        <column caption='Geography_Selector' datatype='string' name='[proper_lbi_adopted_dmarts_perc Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Regions&quot;'>
          <calculation class='tableau' formula='&quot;Regions&quot;' />
          <members>
            <member value='&quot;Global&quot;' />
            <member value='&quot;Regions&quot;' />
            <member value='&quot;Management Entity&quot;' />
            <member value='&quot;Country&quot;' />
