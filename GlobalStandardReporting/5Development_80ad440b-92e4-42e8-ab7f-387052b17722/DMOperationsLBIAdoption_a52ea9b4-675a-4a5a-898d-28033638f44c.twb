      <column caption='     Diff in % Spoilage ' datatype='real' default-format='p0.0%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_5755600323984990270]) - LOOKUP(ZN([Calculation_5755600323984990270]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='     Diff. in % PFR ' datatype='real' default-format='p0.0%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_969681363449167875]) - LOOKUP(ZN([Calculation_969681363449167875]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='     Diff in Picking Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_252483122685562880]) - LOOKUP(ZN([Calculation_252483122685562880]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='    Diff in Picking Time' datatype='real' name='[Calculation4]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_252483122685562880]) - LOOKUP(ZN([Calculation_252483122685562880]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='FIFO adherance level' datatype='string' name='[Calculation_1524749953363070977]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [fifo_adherance] &gt; 0.5 THEN &apos;&gt; 50%&apos; ELSE &apos;&lt;= 50%&apos; &#13;&#10;END' />
      </column>
      <column caption='LBI storage level' datatype='string' name='[Calculation_1524749953363943428]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [storage_density] &gt;= 7 THEN &apos;cell&apos; ELSE &apos;shelf&apos; END' />
      </column>
      <column caption='% Skus w. Mult.  Locations' datatype='real' default-format='p0%' name='[Calculation_1524749953365413895]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sku_multiple_locations_qty 1])/ SUM([sku_with_location_qty 1])' />
      </column>
      <column caption='Picking time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_252483122685562880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([picking_time_s_nom]) / SUM([picking_time_s_denom])' />
      </column>
      <column caption='% Spoilage' datatype='real' name='[Calculation_5755600323984990270]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([spoilage_eur])/ SUM([total_retail_revenue])' />
      </column>
      <column caption='Full Period Flag' datatype='boolean' name='[Calculation_6532541636590788698]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [weeks_total] = 24 THEn TRUE ELSE FALSE END' />
      </column>
      <column caption='Warehouses' datatype='integer' name='[Calculation_717761197541859334]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([warehouse_name])' />
      </column>
      <column caption='    Diff in Picking Time final' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_717761197568835591]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation3]-[     Diff in Picking Time (copy)_717761197320052740]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='    Diff in % Spoilage, final ' datatype='real' default-format='p0.0%' name='[Calculation_717761197569589256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation1]-[     Diff in % Spoilage, revenue  (copy)_717761197319798787]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='    Diff. in % PFR final' datatype='real' default-format='p0.0%' name='[Calculation_717761197570056201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation2]-[     Diff. in % PFR  (copy)_717761197533036549]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% PFR' datatype='real' default-format='p0.00%' name='[Calculation_969681363449167875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([partial_orders])/SUM([successful_orders])' />
      </column>
      <column caption='Picking time control' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Picking time (copy)_717761197319651330]' role='measure' type='quantitative'>
