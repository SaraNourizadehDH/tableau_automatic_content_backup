      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1jjs9790e8io7b1agtbas1njs3uh].[sum:Calculation_5018065527720632320:qk]&quot;' value='% SKU with Location' />
          <alias key='&quot;[federated.1jjs9790e8io7b1agtbas1njs3uh].[sum:lbi_adopeted_dmarts:qk]&quot;' value='# LBI Started Dmarts' />
