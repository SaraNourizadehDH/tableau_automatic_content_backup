      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.15wl4690t36t2n19mbwoh0gmiznp].[diff:usr:Calculation_252483122685562880:qk]&quot;' value='    Diff in Picking time' />
          <alias key='&quot;[federated.15wl4690t36t2n19mbwoh0gmiznp].[diff:usr:Calculation_5755600323984990270:qk]&quot;' value='     Diff in % Spoilage, revenue' />
          <alias key='&quot;[federated.15wl4690t36t2n19mbwoh0gmiznp].[diff:usr:Calculation_969681363449167875:qk]&quot;' value='     Diff. in % PFR' />
        </aliases>
      </column>
      <column caption='     Diff in % Spoilage, revenue ' datatype='real' default-format='p0.0%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_5755600323984990270]) - LOOKUP(ZN([Calculation_5755600323984990270]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='     Diff. in % PFR ' datatype='real' default-format='p0.0%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_969681363449167875]) - LOOKUP(ZN([Calculation_969681363449167875]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='     Diff in Picking Time' datatype='real' name='[Calculation3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_252483122685562880]) - LOOKUP(ZN([Calculation_252483122685562880]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% FIFO adherance, Fresh/Ultra Fresh' datatype='real' name='[Calculation_1524749953362673664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ff_sku_multiple_expiry_locations_qty]) / SUM([ff_sku_multiple_expiration_dates_qty])' />
      </column>
      <column caption='FIFO adherance level' datatype='string' name='[Calculation_1524749953363070977]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [fifo_adherance] &gt; 0.5 THEN &apos;&gt; 50%&apos; ELSE &apos;&lt;= 50%&apos; &#13;&#10;END' />
      </column>
      <column caption='LBI storage level' datatype='string' name='[Calculation_1524749953363943428]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [storage_density] &gt;= 7 THEN &apos;cell&apos; ELSE &apos;shelf&apos; END' />
      </column>
      <column caption='% Skus w. Mult.  Locations' datatype='real' default-format='p0%' name='[Calculation_1524749953365413895]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sku_multiple_locations_qty])/ SUM([sku_with_location_qty])' />
      </column>
      <column caption='weeks after rollout' datatype='integer' name='[Calculation_1524749953367617546]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNT(IF [week_offset] &gt; 0 THEN 1 ELSE NULL END)' />
      </column>
      <column caption='Picking time diff' datatype='real' name='[Calculation_1524749953383903247]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Picking time (copy) (copy)_1524749953382498316]-[Picking time after (copy)_1524749953382965261]' />
      </column>
      <column caption='Picking time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_252483122685562880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([picking_time_s_nom]) / SUM([picking_time_s_denom])' />
      </column>
      <column caption='Rollout Timing' datatype='string' name='[Calculation_252483122685984770]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [week_offset] &gt;= 1 THEN &apos;after rollout&apos;&#13;&#10;ELSE &apos;before rollout&apos;&#13;&#10;END' />
      </column>
      <column caption='LBIv2 Start Week' datatype='string' name='[Calculation_5582774696246001726]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([lbiv2_start_week])' />
      </column>
      <column caption='% Spoilage, revenue' datatype='real' name='[Calculation_5755600323984990270]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([spoilage_eur]) / SUM([total_retail_revenue])' />
      </column>
      <column caption='% PFR' datatype='real' default-format='p0.00%' name='[Calculation_969681363449167875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([partial_orders])/SUM([successful_orders])' />
      </column>
      <column caption='Picking time after' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Picking time (copy) (copy)_1524749953382498316]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [week_offset]&gt; 0 THEN [picking_time_s_nom] ELSE NULL END&#13;&#10;) / &#13;&#10;SUM(&#13;&#10;IF [week_offset]&gt; 0 THEN [picking_time_s_denom] ELSE NULL END&#13;&#10;)' />
      </column>
      <column caption='Picking time before' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Picking time after (copy)_1524749953382965261]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [week_offset] &lt;0 THEN [picking_time_s_nom] ELSE NULL END&#13;&#10;) / &#13;&#10;SUM(&#13;&#10;IF [week_offset]&gt; 0 THEN [picking_time_s_denom] ELSE NULL END&#13;&#10;)' />
      </column>
