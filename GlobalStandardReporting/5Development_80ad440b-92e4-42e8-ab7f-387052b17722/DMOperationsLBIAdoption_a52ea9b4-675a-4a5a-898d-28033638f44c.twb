              <calculation class='tableau' formula='[static_day] = {MAX([static_day])}' />
            </column>
            <column caption='%_skus_fixed' datatype='real' name='[Calculation_5018065527720632320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//IF {FIXED [Warehouse Id],[Static Day]: [%_skus_with_loc]} &lt; {FIXED [Warehouse Id],[Static Day]:[LBI_ADOPTION]} THEN {FIXED [Warehouse Id],[Static Day]:[LBI_ADOPTION]} ELSE { FIXED [Warehouse Id],[Static Day]: [%_skus_with_loc]}  END&#10;&#10;&#10;IF {FIXED [warehouse_id],[static_day]: [Calculation_5909778301501853697]} &lt; {FIXED [warehouse_id],[static_day]:[Calculation_5909778301494931456]} THEN {FIXED [warehouse_id],[static_day]:[Calculation_5909778301494931456]} ELSE { FIXED [warehouse_id],[static_day]: [Calculation_5909778301501853697]}  END' />
            </column>
            <column caption='LBI_ADOPTION' datatype='real' name='[Calculation_5909778301494931456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_sku_count_w_location])/SUM([active_sku_count])' />
            </column>
            <column caption='%_skus_with_loc' datatype='real' name='[Calculation_5909778301501853697]' role='measure' type='quantitative'>
