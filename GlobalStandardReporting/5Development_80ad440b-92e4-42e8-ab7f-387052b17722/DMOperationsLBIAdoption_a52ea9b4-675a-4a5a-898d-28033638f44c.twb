            <column caption='% Skus w. expiration dates on diff locations,  from skus w. mult. exp dates' datatype='real' default-format='p0%' name='[Sku w. multimple expiration dates, % from skus w. exp dates (copy)_1147010596964114434]' role='measure' type='quantitative'>
