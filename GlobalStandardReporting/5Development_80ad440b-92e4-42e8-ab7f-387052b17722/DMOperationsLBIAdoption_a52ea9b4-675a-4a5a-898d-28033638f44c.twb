    <worksheet name='LBIv2. T - warehouse metrics'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>WAREHOUSE METRICS</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dmart_ops_lbi_metrics_warehouse (rl_dmart)' name='federated.00rgo9f0u79dnr1b8p53h1faa6nj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Geography_Selector' datatype='string' name='[proper_lbi_adopted_dmarts_perc Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Regions&quot;'>
              <calculation class='tableau' formula='&quot;Regions&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.00rgo9f0u79dnr1b8p53h1faa6nj'>
            <column caption='# Skus Multiple Locations' datatype='integer' default-format='n#,##0;-#,##0' name='[# Skus Multiple Expiration Dates (copy)_1147010597587873820]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sku_multiple_locations_qty])' />
            </column>
            <column caption='# Skus Multiple Expiration Dates F/UF' datatype='integer' default-format='n#,##0;-#,##0' name='[# Skus Multiple Expiration Dates (copy)_252483122775064579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ff_sku_multiple_expiration_dates_qty])' />
            </column>
            <column caption='# Skus Multiple Expiry Locations F/UF' datatype='integer' default-format='n#,##0;-#,##0' name='[# Skus Multiple Expiry Locations (copy)_252483122775195652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ff_sku_multiple_expiry_locations_qty])' />
            </column>
            <column caption='% Skus With Location' datatype='real' default-format='p0%' name='[% LBI adoption (copy)_1147010597234585625]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sku_with_location_qty]) / [Calculation_1147010596982386700]' />
            </column>
            <column caption='% Skus w. Expiration Dates on diff locations,  from skus w. mult. exp dates F/UF' datatype='real' default-format='p0%' name='[% Skus w. expiration dates on diff locations,  from skus w. mult. exp dates (copy)_969681363445755906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Skus Multiple Expiry Locations (copy)_252483122775195652]/[# Skus Multiple Expiration Dates (copy)_252483122775064579]' />
            </column>
            <column caption='% Skus w. Expiration Date, from total skus' datatype='real' default-format='p0%' name='[Calculation_1147010596962504704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1147010597015158805] / [Calculation_1147010596982386700]' />
            </column>
            <column caption='# Locations per rack, attr' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1147010596967333893]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[location_qty]/[rack_qty]' />
            </column>
            <column caption='# Skus Total' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1147010596982386700]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sku_qty])' />
            </column>
            <column caption='Geography' datatype='string' name='[Calculation_1147010597007462417]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[proper_lbi_adopted_dmarts_perc Parameter] WHEN &apos;Global&apos; THEN &apos;&apos;&#13;&#10;WHEN &apos;Regions&apos; THEN [region_ops]&#13;&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#13;&#10;WHEN &apos;Country&apos; THEN [country] END' />
            </column>
            <column caption='# Locations with &gt; 50 Skus' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1147010597010386963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([location_more_than_50_sku_qty])' />
            </column>
            <column caption='# Skus Missed Dimensions' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1147010597012611092]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sku_missed_dimension_qty])' />
            </column>
            <column caption='# Skus With Expiration Date' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1147010597015158805]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sku_with_expiration_date_qty])' />
            </column>
            <column caption='# Skus Multiple Expiration Dates' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1147010597015330838]' role='measure' type='quantitative'>
