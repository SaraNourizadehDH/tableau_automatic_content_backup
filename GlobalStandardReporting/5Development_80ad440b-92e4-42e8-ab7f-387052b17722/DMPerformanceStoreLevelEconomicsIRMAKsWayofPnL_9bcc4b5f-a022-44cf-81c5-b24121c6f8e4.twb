      <column caption='Age on Report Month' datatype='integer' datatype-customized='true' name='[Age (copy)_1413356282243506177]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;month&apos;,[warehouse_activation_month], DATETRUNC(&apos;month&apos;,[report_month])) &lt;1 THEN NULL ELSE DATEDIFF(&apos;month&apos;,[warehouse_activation_month], DATETRUNC(&apos;month&apos;,[report_month])) END' />
      </column>
      <column caption='Age RM' datatype='string' name='[Age CM STR (copy)_1413356282249400323]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Age RM: &apos; + STR([Age (copy)_1413356282243506177])' />
      </column>
      <column caption='Age on Report Month (copy)' datatype='integer' datatype-customized='true' name='[Age on Report Month (copy)_281193502729490437]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[warehouse_activation_month], DATETRUNC(&apos;month&apos;,[report_month]))' />
      </column>
      <column caption='BEP  chart' datatype='real' name='[BEP  (copy)_4357232707367899153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [BEP (calculated) (copy)_946318913710604295] &lt; 0 THEN 0 ELSE [BEP (calculated) (copy)_946318913710604295] END' />
      </column>
      <column caption='Contribution Margin for BEP (calculated)' datatype='real' name='[BEP (calculated) (copy)_249386852226015232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 9] WHEN &quot;Dmart + Platform BEP&quot; THEN [Contribution Margin for BEP (copy)_946318913709813764] ELSE [Calculation_946318913709223939] END' />
      </column>
      <column caption='Dmarts + Platform BEP (calculated)' datatype='real' name='[BEP (calculated) (copy)_946318913710604295]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;    -SUM([Business Contribution Margin for BEP (copy)_946318913709928453])/(SUM([Contribution Margin for BEP (copy)_946318913709813764])/SUM([orders_per_warehouse])) &gt; 0&#13;&#10;    THEN -SUM([Business Contribution Margin for BEP (copy)_946318913709928453])/(SUM([Contribution Margin for BEP (copy)_946318913709813764])/SUM([orders_per_warehouse]))&#13;&#10;    ELSE 0&#13;&#10;END' />
      </column>
      <column caption='BEP Shape ' datatype='string' name='[BEP Shape (copy)_2217882080294146051]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_946318913716477963] &gt;0 THEN &apos;BEP&apos; ELSE &apos;Negative Contribution Margin&apos; end' />
        <aliases>
          <alias key='&quot;bad&quot;' value='Current BEP vs. Orders' />
          <alias key='&quot;good&quot;' value='Contribution Margin &lt;  0' />
        </aliases>
      </column>
      <column caption='▶  Business Gross Profit' datatype='real' name='[Business Contribution Margin (P) (copy)_1561623194794426379]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2793568834131140611] + 1' />
      </column>
      <column caption='Gross Profit Excl. NRV as % of GMV  ' datatype='real' default-format='p0.0%' name='[Business Contribution Margin as % of GMV   (copy)_792070626085203998]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Contribution Margin (P) (copy)_1561623194792509447])/SUM([gmv_per_warehouse])' />
      </column>
      <column caption='Store Fixed Costs for BEP' datatype='real' name='[Business Contribution Margin for BEP (copy)_946318913709928453]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4357232707341844492]+[shopper_costs_per_warehouse]/2+[shrinkage_per_warehouse]/2' />
      </column>
      <column caption='Business Contribution Margin for BEP p/o' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Business Contribution Margin p/o  (copy)_249386852229623810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Contribution Margin for BEP (copy)_946318913709813764])/SUM([orders_per_warehouse])' />
      </column>
      <column caption='PnL View Filter' datatype='string' name='[Calculation_1248130422422564864]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 10]' />
      </column>
      <column caption='Age CM' datatype='integer' datatype-customized='true' name='[Calculation_1413356282236669952]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[warehouse_activation_month], DATETRUNC(&apos;month&apos;,TODAY()))' />
      </column>
      <column caption='Age CM STR' datatype='string' name='[Calculation_1413356282248732674]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 10]&#13;&#10;WHEN &quot;Included&quot; THEN &apos;Age: &apos; + STR([Calculation_1413356282236669952]) + &apos; Months&apos;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column aggregation='CountD' caption='Placeholder' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1413356282254610437]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;&apos;' />
      </column>
      <column caption='placeholder' datatype='integer' name='[Calculation_1413356282256334867]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='DOS warehouse level' datatype='real' name='[Calculation_1515179840892362752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE [global_entity_id],[Calculation_3033315139138555904] : AVG([daily_orders_per_warehouse])}' />
      </column>
      <column caption='Country' datatype='string' name='[Calculation_1558034416085479424]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[country_name]' />
      </column>
      <column caption='Active Dmarts' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1558034416087855105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([warehouse_name])' />
      </column>
      <column caption='Real Delivery + Semi variable cost' datatype='real' name='[Calculation_1561623194787848192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-SUM([real_delivery_cost_eur]+[real_semi_variable_cost_eur])' />
      </column>
      <column caption='Delivery Services (P)' datatype='real' name='[Calculation_1561623194789908482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 13]&#13;&#10;    WHEN &quot;IC Charged&quot; THEN [ic_logistics_per_warehouse]&#13;&#10;    WHEN &quot;Proxy&quot; THEN -[real_delivery_cost_eur]-[real_semi_variable_cost_eur]&#13;&#10;END' />
      </column>
      <column caption='KPIs X' datatype='string' name='[Calculation_1764425946990964737]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;Current Store Age&apos; THEN STR([Calculation_1413356282236669952])&#10;WHEN &apos;Store reporting age&apos; THEN STR([Age (copy)_1413356282243506177])&#10;WHEN &apos;Report Month&apos; THEN STR(YEAR([report_month]))+&apos;-&apos;+STR(MONTH([report_month]))&#10;WHEN &apos;Daily Orders per Store (bins)&apos; THEN STR([Calculation_6965731686021513222])&#10;END' />
      </column>
      <column caption='Parameter Switch' datatype='string' name='[Calculation_1764425946997059586]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4] &#10;WHEN 1 THEN &apos;Segment&apos;&#10;WHEN 2 THEN &apos;Entity&apos;&#10;WHEN 3 THEN &apos;Country&apos;&#10;WHEN 4 THEN &apos;Store&apos;&#10;END' />
      </column>
      <column caption='BEP View' datatype='string' name='[Calculation_2217882080293744641]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 9]' />
      </column>
      <column caption='Date' datatype='date' datatype-customized='true' name='[Calculation_2372834111297499136]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 5]&#10;WHEN &apos;1&apos; THEN [report_month]&#10;WHEN &apos;2&apos; THEN DATETRUNC(&apos;quarter&apos;,[report_month])&#10;WHEN &apos;3&apos; THEN DATETRUNC(&apos;year&apos;,[report_month])&#10;END)' />
      </column>
      <column caption='BEP calc test' datatype='real' name='[Calculation_249386852228763649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-SUM([Business Contribution Margin for BEP (copy)_946318913709928453])/[Retail Revenue p/o (copy)_792070626081906699]' />
      </column>
      <column caption='▶  Total Dmart Revenue' datatype='real' name='[Calculation_2793568834130046978]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[retail_revenue_per_warehouse] + [vouchers_per_warehouse] + [delivery_fee_per_warehouse] + [non_margin_revenue_per_warehouse] + [service_fee_revenue_per_warehouse] + [other_revenues_per_warehouse]' />
      </column>
      <column caption='▶  Gross Profit' datatype='real' name='[Calculation_2793568834131140611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Gross Profit (copy)_2793568834132049926] + [nrv_adjustment_per_warehouse]' />
      </column>
      <column caption='Total Costs exl. NRV' datatype='real' name='[Calculation_2793568834131390468]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[cogs_per_warehouse] + [back_margin_per_warehouse] + [shrinkage_per_warehouse] + [packaging_costs_per_warehouse] + [other_cost_of_sales_per_warehouse] + [shopper_costs_per_warehouse] + [dc_cost_per_warehouse] + [ic_logistics_per_warehouse] + [ic_commission_per_warehouse]' />
      </column>
      <column caption='▶  Product Margin' datatype='real' name='[Calculation_2793568834139103239]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2793568834130046978] + [cogs_per_warehouse] + [back_margin_per_warehouse] + [shrinkage_per_warehouse] + [packaging_costs_per_warehouse]' />
      </column>
      <column caption='Row L1' datatype='string' name='[Calculation_2793568834146287625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='BEP Shape' datatype='string' name='[Calculation_281193502991073286]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_946318913710108678] &gt;0 THEN &apos;good&apos; ELSE &apos;bad&apos; end' />
        <aliases>
          <alias key='&quot;bad&quot;' value='Dmart + Platform CM &lt; 0' />
          <alias key='&quot;good&quot;' value='Current BEP' />
        </aliases>
      </column>
      <column caption='Warehouse Name' datatype='string' name='[Calculation_3033315139138555904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[warehouse_name]' />
      </column>
      <column caption='StoreAge Bin CM' datatype='string' name='[Calculation_4357232707314745345]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF&#10;DATEDIFF(&apos;month&apos;,[warehouse_activation_month], DATETRUNC(&apos;month&apos;,TODAY())) &lt;= 3 THEN &apos;3&apos;&#10;&#10;ELSEIF DATEDIFF(&apos;month&apos;,[warehouse_activation_month], DATETRUNC(&apos;month&apos;,TODAY())) &lt;= 6 &#10;AND DATEDIFF(&apos;month&apos;,[warehouse_activation_month], DATETRUNC(&apos;month&apos;,TODAY())) &gt; 3 &#10;THEN &apos;4-6&apos;&#10;&#10;ELSEIF DATEDIFF(&apos;month&apos;,[warehouse_activation_month], DATETRUNC(&apos;month&apos;,TODAY())) &lt;= 12 &#10;AND DATEDIFF(&apos;month&apos;,[warehouse_activation_month], DATETRUNC(&apos;month&apos;,TODAY())) &gt; 6 &#10;THEN &apos;7-12&apos;&#10;&#10;ELSEIF DATEDIFF(&apos;month&apos;,[warehouse_activation_month], DATETRUNC(&apos;month&apos;,TODAY())) &lt;= 12 &#10;THEN &apos;0-12&apos;&#10;&#10;ELSEIF DATEDIFF(&apos;month&apos;,[warehouse_activation_month], DATETRUNC(&apos;month&apos;,TODAY())) &lt;= 24 &#10;AND DATEDIFF(&apos;month&apos;,[warehouse_activation_month], DATETRUNC(&apos;month&apos;,TODAY())) &gt; 12 &#10;THEN &apos;13-24&apos;&#10;&#10;ELSEIF DATEDIFF(&apos;month&apos;,[warehouse_activation_month], DATETRUNC(&apos;month&apos;,TODAY())) &gt; 24&#10;THEN &apos;+24&apos;&#10;&#10;END' />
      </column>
      <column caption='View Style Table' datatype='string' name='[Calculation_4357232707333062660]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 6]' />
      </column>
      <column caption='placeholder x' datatype='integer' name='[Calculation_4357232707340853258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Store Fixed Costs' datatype='real' name='[Calculation_4357232707341844492]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[other_dmart_non_personnel_costs_per_warehouse] + [other_dmart_personnel_costs_per_warehouse] + [other_dmart_overheads_per_warehouse] + [other_cost_of_sales_per_warehouse]' />
      </column>
      <column caption='BEP ' datatype='real' name='[Calculation_4357232707344285710]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [BEP (calculated) (copy)_946318913710604295] &lt; 0 THEN NULL ELSE [BEP (calculated) (copy)_946318913710604295] END' />
      </column>
      <column caption='bep trend' datatype='integer' name='[Calculation_4357232707354464272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [BEP (calculated) (copy)_946318913710604295] &lt; 0 THEN 0 ELSE 1 END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_478226026396393472]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='_Space_1' datatype='integer' name='[Calculation_562387060169220114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(&quot;&quot;)' />
      </column>
      <column caption='12 by 12 ' datatype='string' name='[Calculation_6965731686018940931]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1413356282236669952] &lt;= 12 THEN &apos;0-12&apos;&#10;ELSEIF [Calculation_1413356282236669952] &gt; 12 AND [Calculation_1413356282236669952] &lt;=24 THEN &apos;13-24&apos;&#10;ELSEIF [Calculation_1413356282236669952] &gt; 24 AND [Calculation_1413356282236669952] &lt;=36 THEN &apos;25-36&apos;&#10;ELSEIF [Calculation_1413356282236669952] &gt;36 THEN &apos;36+&apos;&#10;END' />
      </column>
      <column caption='DOS 1 ' datatype='string' name='[Calculation_6965731686021513222]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF {FIXED [global_entity_id],[warehouse_name]: AVG([daily_orders_per_warehouse])} &lt;= 100 THEN &apos;0-100&apos;&#10;ELSEIF {FIXED [global_entity_id],[warehouse_name]: AVG([daily_orders_per_warehouse])} &gt;100 AND {FIXED [global_entity_id],[warehouse_name]: AVG([daily_orders_per_warehouse])} &lt;=200 THEN &apos;101-200&apos;&#10;ELSEIF {FIXED [global_entity_id],[warehouse_name]: AVG([daily_orders_per_warehouse])} &gt;200 AND {FIXED [global_entity_id],[warehouse_name]: AVG([daily_orders_per_warehouse])} &lt;=300 THEN &apos;201-300&apos;&#10;ELSEIF {FIXED [global_entity_id],[warehouse_name]: AVG([daily_orders_per_warehouse])} &gt;300 AND {FIXED [global_entity_id],[warehouse_name]: AVG([daily_orders_per_warehouse])}&lt;=400 THEN &apos;301-400&apos;&#10;ELSEIF {FIXED [global_entity_id],[warehouse_name]: AVG([daily_orders_per_warehouse])} &gt;400 THEN &apos;+400&apos; END' />
      </column>
      <column caption='Header Group Summary - Activation' datatype='string' name='[Calculation_6965731686022975497]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;WHEN &apos;Current age: by 12 months&apos; THEN  [Calculation_6965731686018940931]&#10;WHEN &apos;Current age: by 6 months&apos; THEN [12 by 12  (copy)_6965731686019735556]&#10;WHEN &apos;Current age: by 3 months&apos; THEN [6 by 6  (copy)_6965731686020300805]&#10;WHEN &apos;D/O/S: 0-200; 201-300; +300&apos; THEN  [DOS 2 (copy)_6965731686021971976]&#10;WHEN &apos;D/O/S: 0-100; 101-200; 201-300; +300&apos; THEN [DOS 1  (copy)_6965731686021865479]&#10;WHEN &apos;D/O/S: 0-100; 101-200; 201-300; 301-400; +400&apos; THEN [Calculation_6965731686021513222]&#10;END' />
      </column>
      <column caption='KPI Correlation X Axis' datatype='real' name='[Calculation_792070626057347072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE&#13;&#10;&#13;&#10;[Parameters].[Parameter 11]&#13;&#10;&#13;&#10;WHEN &apos;Orders&apos; THEN SUM([orders_per_warehouse])&#13;&#10;WHEN &apos;Daily Orders per Store&apos; THEN AVG([daily_orders_per_warehouse])&#13;&#10;WHEN &apos;GMV&apos; THEN SUM([gmv_per_warehouse])&#13;&#10;WHEN &apos;Retail Revenue&apos; THEN SUM([retail_revenue_per_warehouse])&#13;&#10;WHEN &apos;Delivery Fee&apos; THEN SUM([delivery_fee_per_warehouse])&#13;&#10;WHEN &apos;Non Margin Revenue&apos; THEN SUM([non_margin_revenue_per_warehouse])&#13;&#10;WHEN &apos;Vouchers&apos; THEN SUM([vouchers_per_warehouse])&#13;&#10;WHEN &apos;Total Revenue&apos; THEN SUM([Calculation_2793568834123399168])&#13;&#10;WHEN &apos;Gross Income Tax&apos; THEN SUM([gross_income_tax_per_warehouse])&#13;&#10;WHEN &apos;COGS&apos; THEN SUM([cogs_per_warehouse])&#13;&#10;WHEN &apos;Back Margin&apos; THEN SUM([back_margin_per_warehouse])&#13;&#10;WHEN &apos;Shrinkage&apos; THEN SUM([shrinkage_per_warehouse])&#13;&#10;WHEN &apos;Packaging Costs&apos; THEN SUM([packaging_costs_per_warehouse])&#13;&#10;WHEN &apos;Product Margin&apos; THEN SUM([product_margin_per_warehouse])&#13;&#10;WHEN &apos;IC Commission&apos; THEN SUM([ic_commission_per_warehouse])&#13;&#10;WHEN &apos;IC Delivery Services&apos; THEN SUM([Calculation_1561623194789908482])&#13;&#10;WHEN &apos;Shopper Costs&apos; THEN SUM([shopper_costs_per_warehouse])&#13;&#10;WHEN &apos;Distribution Center Costs&apos; THEN SUM([w_dc_per_warehouse])&#13;&#10;WHEN &apos;Contribution Margin&apos; THEN SUM([Delivery Costs (copy)_1561623194791464966])&#13;&#10;WHEN &apos;Store Fixed Costs&apos; THEN SUM([Calculation_4357232707341844492])&#13;&#10;WHEN &apos;Gross Profit&apos; THEN SUM([Contribution Margin (P) (copy)_1561623194792509447])&#13;&#10;WHEN &apos;Take In Revenue&apos; THEN SUM([Contribution Margin (P) (copy)_1561623194792943624])&#13;&#10;WHEN &apos;Delivery Costs (platform)&apos; THEN SUM([Delivery Services (copy)_1561623194790735875])&#13;&#10;WHEN &apos;Payment Costs (platform)&apos; THEN SUM([payment_costs_per_warehouse])&#13;&#10;WHEN &apos;Delivery Accident Costs (platform)&apos; THEN SUM([delivery_accident_costs_per_warehouse])&#13;&#10;WHEN &apos;Semi Variable Costs (platform)&apos; THEN SUM([Delivery Costs (copy)_1561623194791079940])&#13;&#10;WHEN &apos;Other Non Specific Costs (platform)&apos; THEN SUM([other_non_specific_costs_per_warehouse])&#13;&#10;WHEN &apos;GP Platform&apos; THEN SUM([Take In Revenue (P) (copy)_1561623194793361417])&#13;&#10;WHEN &apos;Business Contribution Margin&apos; THEN SUM([Contribution Margin (P) (copy)_1561623194793902090])&#13;&#10;WHEN &apos;Business Gross Profit Excl. Nrv&apos; THEN SUM([Business Contribution Margin (P) (copy)_1561623194794426379])&#13;&#10;WHEN &apos;Retail Revenue p/o&apos; THEN SUM([retail_revenue_per_warehouse])/SUM([orders_per_warehouse])&#13;&#10;WHEN &apos;Delivery Fee p/o&apos; THEN SUM([delivery_fee_per_warehouse])/SUM([orders_per_warehouse])&#13;&#10;WHEN &apos;Packaging Costs p/o&apos; THEN SUM([packaging_costs_per_warehouse])/SUM([orders_per_warehouse])&#13;&#10;WHEN &apos;Shopper Costs p/o&apos; THEN SUM([shopper_costs_per_warehouse])/SUM([orders_per_warehouse])&#13;&#10;WHEN &apos;Gross Profit Platform p/o&apos; THEN SUM([Take In Revenue (P) (copy)_1561623194793361417])/SUM([orders_per_warehouse])&#13;&#10;WHEN &apos;Contribution Margin p/o&apos; THEN SUM([Delivery Costs (copy)_1561623194791464966])/SUM([orders_per_warehouse])&#13;&#10;WHEN &apos;Business Contribution Margin p/o&apos; THEN SUM([Contribution Margin (P) (copy)_1561623194793902090])/SUM([orders_per_warehouse])&#13;&#10;WHEN &apos;Gross Profit Excl. NRV p/o&apos; THEN SUM([Contribution Margin (P) (copy)_1561623194792509447])/SUM([orders_per_warehouse])&#13;&#10;WHEN &apos;Business Gross Profit Excl. NRV p/o&apos; THEN SUM([Business Contribution Margin (P) (copy)_1561623194794426379])/SUM([orders_per_warehouse])&#13;&#10;WHEN &apos;Total Revenue as % of RR&apos; THEN SUM([Calculation_2793568834123399168])/SUM([retail_revenue_per_warehouse])&#13;&#10;WHEN &apos;Gross Income Tax as % of RR&apos; THEN SUM([gross_income_tax_per_warehouse])/SUM([retail_revenue_per_warehouse])&#13;&#10;WHEN &apos;COGS as % of RR&apos; THEN SUM([cogs_per_warehouse])/SUM([retail_revenue_per_warehouse])&#13;&#10;WHEN &apos;Delivery Fee as % of RR&apos; THEN SUM([delivery_fee_per_warehouse])/SUM([retail_revenue_per_warehouse])&#13;&#10;WHEN &apos;Non Margin Revenue as % of RR&apos; THEN SUM([non_margin_revenue_per_warehouse])/SUM([retail_revenue_per_warehouse])&#13;&#10;WHEN &apos;Vouchers as % of RR&apos; THEN SUM([vouchers_per_warehouse])/SUM([retail_revenue_per_warehouse])&#13;&#10;WHEN &apos;FB Margin as % of RR&apos; THEN [Total Revenue as % of RR (copy)_792070626083598356]&#13;&#10;WHEN &apos;Shrinkage as % of RR&apos; THEN SUM([shrinkage_per_warehouse])/SUM([retail_revenue_per_warehouse])&#13;&#10;WHEN &apos;Product Margin as % of RR&apos; THEN SUM([product_margin_per_warehouse])/SUM([retail_revenue_per_warehouse])&#13;&#10;WHEN &apos;IC Commission as % of RR&apos; THEN SUM([ic_commission_per_warehouse])/SUM([retail_revenue_per_warehouse])&#13;&#10;WHEN &apos;IC Delivery Services as % of RR&apos; THEN SUM([Calculation_1561623194789908482])/SUM([retail_revenue_per_warehouse])&#13;&#10;WHEN &apos;Shopper Costs as % of RR&apos; THEN SUM([shopper_costs_per_warehouse])/SUM([retail_revenue_per_warehouse])&#13;&#10;WHEN &apos;Distribution Center Costs as % of RR&apos; THEN SUM([w_dc_per_warehouse])/SUM([retail_revenue_per_warehouse])&#13;&#10;WHEN &apos;Store Fixed Costs as % of RR&apos; THEN SUM([Calculation_4357232707341844492])/SUM([retail_revenue_per_warehouse])&#13;&#10;WHEN &apos;Contribution Margin as % of GMV&apos; THEN SUM([Delivery Costs (copy)_1561623194791464966])/SUM([gmv_per_warehouse])&#13;&#10;WHEN &apos;Business Contribution as % of GMV&apos; THEN SUM([Contribution Margin (P) (copy)_1561623194793902090])/SUM([gmv_per_warehouse])&#13;&#10;WHEN &apos;Gross Profit as % of GMV&apos; THEN SUM([Contribution Margin (P) (copy)_1561623194792509447])/SUM([gmv_per_warehouse])&#13;&#10;WHEN &apos;Business Gross Profit Excl NRV as % of GMV&apos; THEN SUM([Business Contribution Margin (P) (copy)_1561623194794426379])/SUM([gmv_per_warehouse])&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Retail Revenue p/o' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_792070626076684292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([retail_revenue_per_warehouse])/SUM([orders_per_warehouse])' />
      </column>
      <column caption='Total Revenue as % of RR' datatype='real' default-format='p0.0%' name='[Calculation_792070626082684942]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2793568834123399168])/SUM([retail_revenue_per_warehouse])' />
      </column>
      <column caption='City' datatype='string' name='[Calculation_792070626151239717]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6] &#13;&#10;    WHEN &quot;Country/City/Store&quot; THEN [city]&#13;&#10;    ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Granularity' datatype='string' name='[Calculation_792070626154037287]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 12]&#13;&#10;    WHEN &quot;Segment&quot; THEN [segment]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [Management Entity ]&#13;&#10;    WHEN &quot;Country&quot; THEN [Calculation_1558034416085479424]&#13;&#10;    WHEN &quot;City&quot; THEN [city]&#13;&#10;    WHEN &quot;Store Name&quot; THEN [Calculation_3033315139138555904]&#13;&#10;END' />
      </column>
      <column caption='Contribution Margin for BEP' datatype='real' name='[Calculation_946318913709223939]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Delivery Costs (copy)_1561623194791464966]-[shopper_costs_per_warehouse]/2-[shrinkage_per_warehouse]/2' />
      </column>
      <column caption='Dmarts BEP (calculated)' datatype='real' name='[Calculation_946318913710108678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;    -SUM([Business Contribution Margin for BEP (copy)_946318913709928453])/(SUM([Calculation_946318913709223939])/SUM([orders_per_warehouse])) &gt; 0&#13;&#10;    THEN -SUM([Business Contribution Margin for BEP (copy)_946318913709928453])/(SUM([Calculation_946318913709223939])/SUM([orders_per_warehouse]))&#13;&#10;    ELSE 0&#13;&#10;END' />
      </column>
      <column caption='BEP (calculated)' datatype='real' name='[Calculation_946318913716477963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 9] WHEN &quot;Dmart + Platform BEP&quot; THEN [BEP (calculated) (copy)_946318913710604295] ELSE [Calculation_946318913710108678] END' />
      </column>
      <column caption='Color BEP KPI Evolution' datatype='string' name='[Color BEP Chart (copy)_946318913722175503]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Color BEP Chart (copy)_946318913722126350]&#13;&#10;    WHEN &quot;Segment&quot; THEN [segment]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [Management Entity ]&#13;&#10;    WHEN &quot;Country&quot; THEN [Calculation_1558034416085479424]&#13;&#10;    WHEN &quot;City&quot; THEN [city]&#13;&#10;    WHEN &quot;Store Name&quot; THEN [Calculation_3033315139138555904]&#13;&#10;END' />
      </column>
      <column caption='Color BEP KPI Correlation' datatype='string' name='[Color BEP KPI Evolution (copy)_946318913722912785]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Color KPI Evolution (copy)_946318913722867728]&#13;&#10;    WHEN &quot;Segment&quot; THEN [segment]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [Management Entity ]&#13;&#10;    WHEN &quot;Country&quot; THEN [Calculation_1558034416085479424]&#13;&#10;    WHEN &quot;City&quot; THEN [city]&#13;&#10;    WHEN &quot;Store Name&quot; THEN [Calculation_3033315139138555904]&#13;&#10;END' />
      </column>
      <column caption='Take In Revenue (P)' datatype='real' name='[Contribution Margin (P) (copy)_1561623194792943624]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 13]&#13;&#10;    WHEN &quot;IC Charged&quot; THEN [take_in_revenue_per_warehouse]&#13;&#10;    WHEN &quot;Proxy&quot; THEN [take_in_revenue_per_warehouse]-(-[ic_logistics_per_warehouse])+(-[Calculation_1561623194789908482])&#13;&#10;END' />
      </column>
      <column caption='Business Contribution Margin (P)' datatype='real' name='[Contribution Margin (P) (copy)_1561623194793902090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 13]&#13;&#10;    WHEN &quot;IC Charged&quot; THEN [business_contribution_margin_per_warehouse]&#13;&#10;    WHEN &quot;Proxy&quot; THEN [Delivery Costs (copy)_1561623194791464966]+[Take In Revenue (P) (copy)_1561623194793361417]&#13;&#10;END' />
      </column>
      <column caption='Business Contribution Margin as % of GMV  ' datatype='real' default-format='p0.0%' name='[Contribution Margin as % of GMV   (copy)_792070626085105693]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Contribution Margin (P) (copy)_1561623194793902090])/SUM([gmv_per_warehouse])' />
      </column>
      <column caption='Business Contribution Margin for BEP' datatype='real' name='[Contribution Margin for BEP (copy)_946318913709813764]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Delivery Costs (copy)_1561623194791464966]+[Take In Revenue (P) (copy)_1561623194793361417]-[shopper_costs_per_warehouse]/2-[shrinkage_per_warehouse]/2' />
      </column>
      <column caption='Contribution Margin for BEP p/o' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Contribution Margin p/o  (copy)_249386852230283268]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_946318913709223939])/SUM([orders_per_warehouse])' />
      </column>
      <column caption='Country (copy)' datatype='string' name='[Country (copy)_4357232707334451205]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='tableau' formula='[country_name]' />
      </column>
      <column caption='DOS 2' datatype='string' name='[DOS 1  (copy)_6965731686021865479]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF {FIXED [global_entity_id],[warehouse_name]: AVG([daily_orders_per_warehouse])} &lt;= 100 THEN &apos;0-100&apos;&#10;ELSEIF {FIXED [global_entity_id],[warehouse_name]: AVG([daily_orders_per_warehouse])} &gt;100 AND {FIXED [global_entity_id],[warehouse_name]: AVG([daily_orders_per_warehouse])} &lt;=200 THEN &apos;101-200&apos;&#10;ELSEIF {FIXED [global_entity_id],[warehouse_name]: AVG([daily_orders_per_warehouse])}&gt;200 AND {FIXED [global_entity_id],[warehouse_name]: AVG([daily_orders_per_warehouse])} &lt;=300 THEN &apos;201-300&apos;&#10;ELSEIF {FIXED [global_entity_id],[warehouse_name]: AVG([daily_orders_per_warehouse])} &gt;300 THEN &apos;+300&apos; END' />
      </column>
      <column caption='DOS 3' datatype='string' name='[DOS 2 (copy)_6965731686021971976]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF {FIXED [global_entity_id],[warehouse_name]: AVG([daily_orders_per_warehouse])} &lt;= 200 THEN &apos;0-200&apos;&#10;ELSEIF {FIXED [global_entity_id],[warehouse_name]: AVG([daily_orders_per_warehouse])} &gt;200 AND {FIXED [global_entity_id],[warehouse_name]: AVG([daily_orders_per_warehouse])} &lt;=300 THEN &apos;201-300&apos;&#10;ELSEIF {FIXED [global_entity_id],[warehouse_name]: AVG([daily_orders_per_warehouse])}&gt;300 THEN &apos;+300&apos; END' />
      </column>
      <column caption='Semi Variable Costs (P)' datatype='real' name='[Delivery Costs (copy)_1561623194791079940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 13]&#13;&#10;    WHEN &quot;IC Charged&quot; THEN [semi_variable_costs_per_warehouse]&#13;&#10;    WHEN &quot;Proxy&quot; THEN -[real_semi_variable_cost_eur]&#13;&#10;END' />
      </column>
      <column caption='Contribution Margin (P)' datatype='real' name='[Delivery Costs (copy)_1561623194791464966]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 13]&#13;&#10;    WHEN &quot;IC Charged&quot; THEN [contribution_margin_per_warehouse]&#13;&#10;    WHEN &quot;Proxy&quot; THEN [contribution_margin_per_warehouse]-[ic_logistics_per_warehouse]+[Calculation_1561623194789908482]&#13;&#10;END' />
      </column>
      <column caption='Delivery Costs (P)' datatype='real' name='[Delivery Services (copy)_1561623194790735875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 13]&#13;&#10;    WHEN &quot;IC Charged&quot; THEN [delivery_costs_per_warehouse]&#13;&#10;    WHEN &quot;Proxy&quot; THEN -[real_delivery_cost_eur]&#13;&#10;END' />
      </column>
      <column caption='Color BEP Chart' datatype='string' name='[Granularity  (copy)_946318913720684557]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Granularity Summary PnL (copy)_946318913720631308]&#13;&#10;    WHEN &quot;Segment&quot; THEN [segment]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [Management Entity ]&#13;&#10;    WHEN &quot;Country&quot; THEN [Calculation_1558034416085479424]&#13;&#10;    WHEN &quot;City&quot; THEN [city]&#13;&#10;    WHEN &quot;Store Name&quot; THEN [Calculation_3033315139138555904]&#13;&#10;END' />
      </column>
      <column caption='Granularity ' datatype='string' name='[Granularity (copy)_792070626170282028]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Granularity (copy)_792070626170023979]&#13;&#10;    WHEN &quot;None&quot; THEN NULL&#13;&#10;    WHEN &quot;Segment&quot; THEN [segment]&#13;&#10;    WHEN &quot;Management Entity&quot; THEN [Management Entity ]&#13;&#10;    WHEN &quot;Country&quot; THEN [Calculation_1558034416085479424]&#13;&#10;    WHEN &quot;City&quot; THEN [city]&#13;&#10;    WHEN &quot;Store Name&quot; THEN [Calculation_3033315139138555904]&#13;&#10;END' />
      </column>
      <column caption='▶  Gross Profit excl. NRV' datatype='real' name='[Gross Profit (copy)_2793568834132049926]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2793568834139103239] + [other_cost_of_sales_per_warehouse] + [shopper_costs_per_warehouse] + [store_cost_per_warehouse] + [dc_cost_per_warehouse] + [ic_logistics_per_warehouse] + [ic_commission_per_warehouse]' />
      </column>
      <column caption='Business Gross Profit Excl. NRV as % of GMV   ' datatype='real' default-format='p0.0%' name='[Gross Profit Excl. NRV as % of GMV   (copy)_792070626085347359]' role='measure' type='quantitative'>
