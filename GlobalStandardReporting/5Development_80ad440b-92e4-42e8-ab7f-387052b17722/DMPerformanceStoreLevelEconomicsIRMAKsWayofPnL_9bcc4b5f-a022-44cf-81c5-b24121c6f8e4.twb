      <datasource-dependencies datasource='Parameters'>
        <column alias='Monthly' caption='Date' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
          <calculation class='tableau' formula='&quot;1&quot;' />
          <aliases>
            <alias key='&quot;1&quot;' value='Monthly' />
            <alias key='&quot;2&quot;' value='Quarterly' />
            <alias key='&quot;3&quot;' value='Yearly' />
