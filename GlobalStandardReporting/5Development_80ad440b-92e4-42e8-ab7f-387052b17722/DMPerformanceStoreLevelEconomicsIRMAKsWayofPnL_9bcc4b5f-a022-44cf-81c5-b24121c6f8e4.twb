  <worksheets>
    <worksheet name='PnL per Store view'>
      <table>
        <view>
          <datasources>
            <datasource caption='dmarts_profitability' name='federated.0d0elck1b9rg281gmsag50pcjdz4' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Date' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='Monthly' />
                <alias key='&quot;2&quot;' value='Quarterly' />
                <alias key='&quot;3&quot;' value='Yearly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0d0elck1b9rg281gmsag50pcjdz4'>
            <column caption=' ----&gt;  P&amp;L' datatype='integer' name='[ --&gt;  KPIs (copy)_4446249149949718530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption=' --&gt;  Dmart  Costs &amp; Revenues' datatype='integer' name='[ ❷ P&amp;L (copy)_2124713905596493830]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption=' --&gt;  Platform  Related Costs &amp; Revenues' datatype='integer' name='[--&gt; Dmart  P&amp;L (copy)_2124713905596772359]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption='Age on Report Month' datatype='integer' datatype-customized='true' name='[Age (copy)_1413356282243506177]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;month&apos;,[warehouse_activation_month], DATETRUNC(&apos;month&apos;,[report_month])) &lt;1 THEN NULL ELSE DATEDIFF(&apos;month&apos;,[warehouse_activation_month], DATETRUNC(&apos;month&apos;,[report_month])) END' />
            </column>
            <column caption='▶  Business Gross Profit' datatype='real' name='[Business Contribution Margin (P) (copy)_1561623194794426379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2793568834131140611] + 1' />
            </column>
            <column caption='Age CM' datatype='integer' datatype-customized='true' name='[Calculation_1413356282236669952]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[warehouse_activation_month], DATETRUNC(&apos;month&apos;,TODAY()))' />
            </column>
            <column caption='Country' datatype='string' name='[Calculation_1558034416085479424]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_name]' />
            </column>
            <column caption='Date' datatype='date' datatype-customized='true' name='[Calculation_2372834111297499136]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 5]&#10;WHEN &apos;1&apos; THEN [report_month]&#10;WHEN &apos;2&apos; THEN DATETRUNC(&apos;quarter&apos;,[report_month])&#10;WHEN &apos;3&apos; THEN DATETRUNC(&apos;year&apos;,[report_month])&#10;END)' />
            </column>
            <column caption='▶  Total Dmart Revenue' datatype='real' name='[Calculation_2793568834130046978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[retail_revenue_per_warehouse] + [vouchers_per_warehouse] + [delivery_fee_per_warehouse] + [non_margin_revenue_per_warehouse] + [service_fee_revenue_per_warehouse] + [other_revenues_per_warehouse]' />
            </column>
            <column caption='▶  Gross Profit' datatype='real' name='[Calculation_2793568834131140611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Gross Profit (copy)_2793568834132049926] + [nrv_adjustment_per_warehouse]' />
            </column>
            <column caption='▶  Product Margin' datatype='real' name='[Calculation_2793568834139103239]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2793568834130046978] + [cogs_per_warehouse] + [back_margin_per_warehouse] + [shrinkage_per_warehouse] + [packaging_costs_per_warehouse]' />
            </column>
            <column caption='Row L1' datatype='string' name='[Calculation_2793568834146287625]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
            <column caption='Warehouse Name' datatype='string' name='[Calculation_3033315139138555904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[warehouse_name]' />
            </column>
            <column caption='_Space_1' datatype='integer' name='[Calculation_562387060169220114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(&quot;&quot;)' />
            </column>
            <column caption='Retail Revenue p/o' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_792070626076684292]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([retail_revenue_per_warehouse])/SUM([orders_per_warehouse])' />
            </column>
            <column caption='▶  Gross Profit excl. NRV' datatype='real' name='[Gross Profit (copy)_2793568834132049926]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2793568834139103239] + [other_cost_of_sales_per_warehouse] + [shopper_costs_per_warehouse] + [store_cost_per_warehouse] + [dc_cost_per_warehouse] + [ic_logistics_per_warehouse] + [ic_commission_per_warehouse]' />
            </column>
            <column datatype='string' name='[Management Entity ]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[management_entity]' new-bin='true'>
                <bin default-name='false' value='&quot;EU Non Pandora&quot;'>
                  <value>&quot;DH Greece&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;EU Pandora&quot;'>
                  <value>&quot;DH Austria&quot;</value>
                  <value>&quot;DH CEE&quot;</value>
                  <value>&quot;DH Nordics&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Delivery Fee p/o ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Retail Revenue p/o (copy)_792070626077728774]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_per_warehouse])/SUM([orders_per_warehouse])' />
            </column>
            <column caption='Packaging Costs p/o ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Retail Revenue p/o (copy)_792070626081271815]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([packaging_costs_per_warehouse])/SUM([orders_per_warehouse])' />
            </column>
            <column caption='Shopper Costs p/o ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Retail Revenue p/o (copy)_792070626081447944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shopper_costs_per_warehouse])/SUM([orders_per_warehouse])' />
            </column>
            <column caption='Delivery Fee as % of RR ' datatype='real' default-format='p0.0%' name='[Total Revenue as % of RR (copy)_792070626083221521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_per_warehouse])/SUM([retail_revenue_per_warehouse])' />
            </column>
            <column caption='Vouchers as % of RR ' datatype='real' default-format='p0.0%' name='[Total Revenue as % of RR (copy)_792070626083401746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vouchers_per_warehouse])/SUM([retail_revenue_per_warehouse])' />
            </column>
            <column caption='Non Margin Revenue as % of RR ' datatype='real' default-format='p0.0%' name='[Total Revenue as % of RR (copy)_792070626083524627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([non_margin_revenue_per_warehouse])/SUM([retail_revenue_per_warehouse])' />
            </column>
            <column caption='F+B Margin as % of RR' datatype='real' default-format='p0.0%' name='[Total Revenue as % of RR (copy)_792070626083598356]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([retail_revenue_per_warehouse]+[cogs_per_warehouse]+[back_margin_per_warehouse])/SUM([retail_revenue_per_warehouse])' />
            </column>
            <column caption='Shrinkage as % of RR ' datatype='real' default-format='p0.0%' name='[Total Revenue as % of RR (copy)_792070626083893269]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shrinkage_per_warehouse])/SUM([retail_revenue_per_warehouse])' />
            </column>
            <column caption='IC Commission as % of RR ' datatype='real' default-format='p0.0%' name='[Total Revenue as % of RR (copy)_792070626084073495]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ic_commission_per_warehouse])/SUM([retail_revenue_per_warehouse])' />
            </column>
            <column caption='Shopper Costs as % of RR ' datatype='real' default-format='p0.0%' name='[Total Revenue as % of RR (copy)_792070626084331545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([shopper_costs_per_warehouse])/SUM([retail_revenue_per_warehouse])' />
            </column>
