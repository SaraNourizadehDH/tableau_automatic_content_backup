          <datasource-dependencies datasource='federated.02x5z430h96nho1a70w960d0tcrc'>
            <column caption='Bias effective' datatype='real' default-format='p0%' name='[Bias  baseline (copy)_1040331538717097991]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([predicted_qty_effective_filtered]) / SUM([sold_qty_filtered])' />
