            <column caption='Closed_Tickets' datatype='boolean' name='[Calculation_1263259719035416578]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [status]&#13;&#10;when &quot;Closed&quot; then true&#13;&#10;else false&#13;&#10;end' />
            </column>
            <column caption='Closed_Cases' datatype='integer' name='[Calculation_1263259719036239875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [Calculation_1263259719035416578]= True then [cases] end)' />
