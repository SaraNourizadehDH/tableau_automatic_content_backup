      <column caption='Users with Access' datatype='integer' name='[Active Users (copy 2)_1062356985802657803]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_permission_set] THEN [ownerid] END)' />
      </column>
      <column caption='Active Users (copy)' datatype='integer' name='[Active Users (copy)_1062356985800589321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [logins] &gt; 0 THEN [ownerid] END)' />
      </column>
      <column caption='created_date_flag' datatype='boolean' name='[Calculation_1008032315023286272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [iso_date] = DATE([createddate]) THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Active Users' datatype='integer' name='[Calculation_1062356985735409664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [logins] &gt; 0 THEN [ownerid] END)' />
      </column>
      <column caption='Day' datatype='datetime' name='[Calculation_501095881571323904]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;,[iso_date])' />
      </column>
      <column caption='Action Items Created' datatype='integer' name='[Calculation_501095881571758083]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_1008032315023286272] THEN [action_item_id] END)' />
      </column>
      <column caption='In Progress' datatype='integer' name='[Calculation_501095881574121480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Status__c] = &apos;In Progress&apos; THEN [action_item_id] END)' />
      </column>
      <column caption='Time' datatype='datetime' name='[Calculation_970877618072694786]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='If [Parameters].[Parameter 1] = &apos;Day&apos; THEN [Calculation_501095881571323904]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN [Day (copy) (copy)_501095881571438594]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos; THEN [Day (copy)_501095881571430401]&#10;END' />
      </column>
      <column caption='User Logins' datatype='integer' name='[Calculation_970877618073501699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL({FIXED [ownerid],[Calculation_501095881571323904]:MAX([logins])}) THEN 0&#10;ELSE ({FIXED [ownerid],[Calculation_501095881571323904]:MAX([logins])})&#10;END' />
      </column>
      <column caption='Successful' datatype='integer' name='[Completed (copy)_1062356985807011852]' role='measure' type='quantitative'>
