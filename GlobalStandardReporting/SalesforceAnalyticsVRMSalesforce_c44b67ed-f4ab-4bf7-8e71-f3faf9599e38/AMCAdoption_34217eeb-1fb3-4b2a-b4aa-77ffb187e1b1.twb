            </column>
            <column caption='Time' datatype='datetime' name='[Calculation_970877618072694786]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='If [Parameters].[Parameter 1] = &apos;Day&apos; THEN [Calculation_501095881571323904]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; THEN [Day (copy) (copy)_501095881571438594]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos; THEN [Day (copy)_501095881571430401]&#10;END' />
            </column>
            <column caption='User Logins' datatype='integer' name='[Calculation_970877618073501699]' role='measure' type='quantitative'>
