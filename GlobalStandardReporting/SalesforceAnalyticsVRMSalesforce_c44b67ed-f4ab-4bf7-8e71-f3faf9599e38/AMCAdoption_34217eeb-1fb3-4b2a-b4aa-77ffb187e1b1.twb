          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Param' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
            <column caption='Granularity Level' datatype='string' name='[Time Param (copy)_1062356985736065025]' param-domain-type='list' role='measure' type='nominal' value='&quot;Sub Entity&quot;'>
              <calculation class='tableau' formula='&quot;Sub Entity&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15ot6ae1ki8i9k1b6jozc0blgv2t'>
            <column caption='% Expired' datatype='real' name='[% Completed (copy)_1062356985738346502]' role='measure' type='quantitative'>
