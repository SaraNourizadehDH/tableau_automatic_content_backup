            </column>
            <column caption='% Completed' datatype='real' name='[% In Progress (copy)_1062356985738211333]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[In Progress AIs (copy)_501095881574391817]/[Action_Items_Created (copy)_1062356985737506819]' />
            </column>
            <column caption='Total Action Items' datatype='integer' name='[Action_Items_Created (copy)_1062356985737506819]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([action_item_id])' />
            </column>
            <column caption='created_date_flag' datatype='boolean' name='[Calculation_1008032315023286272]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [iso_date] = DATE([createddate]) THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Active Users' datatype='integer' name='[Calculation_1062356985735409664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [logins] &gt; 0 THEN [ownerid] END)' />
            </column>
            <column caption='Day' datatype='datetime' name='[Calculation_501095881571323904]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;,[iso_date])' />
            </column>
            <column caption='Action Items Created' datatype='integer' name='[Calculation_501095881571758083]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_1008032315023286272] THEN [action_item_id] END)' />
            </column>
            <column caption='In Progress' datatype='integer' name='[Calculation_501095881574121480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Status__c] = &apos;In Progress&apos; THEN [action_item_id] END)' />
            </column>
            <column caption='User Logins' datatype='integer' name='[Calculation_970877618073501699]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL({FIXED [ownerid],[Calculation_501095881571323904]:MAX([logins])}) THEN 0&#10;ELSE ({FIXED [ownerid],[Calculation_501095881571323904]:MAX([logins])})&#10;END' />
            </column>
            <column caption='Week' datatype='datetime' name='[Day (copy) (copy)_501095881571438594]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;,[iso_date])' />
            </column>
            <column caption='Month' datatype='datetime' name='[Day (copy)_501095881571430401]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[iso_date])' />
            </column>
            <column caption='% In Progress' datatype='real' name='[In Progress (copy)_1062356985737871364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_501095881574121480]/[Action_Items_Created (copy)_1062356985737506819]' />
            </column>
            <column caption='Completed' datatype='integer' name='[In Progress AIs (copy)_501095881574391817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Status__c] = &apos;Successful&apos; OR [Status__c] = &apos;Not Successful&apos; THEN [action_item_id] END)' />
            </column>
            <column caption='Expired' datatype='integer' name='[In Progress AIs (copy)_501095881574670346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Root_Cause__c] = &apos;Expired&apos; THEN [action_item_id] END)' />
