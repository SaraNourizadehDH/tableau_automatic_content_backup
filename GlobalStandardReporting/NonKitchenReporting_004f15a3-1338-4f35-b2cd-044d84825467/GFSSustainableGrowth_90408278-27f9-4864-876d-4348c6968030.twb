    <worksheet name='Country_stacked_orders_absolute'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Country Growth - GFS Acquisitions Customers Orders vs Returning Customers Orders
</run>
            <run fontsize='9'>(drill up and down by pressing + or -)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='BQ Connection' name='federated.0q40u1w026pl4o199a6of02u6k9v' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='View Percent' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Absolute&quot;'>
              <calculation class='tableau' formula='&quot;Absolute&quot;' />
            </column>
            <column caption='Benchmark Parameter' datatype='string' name='[top_10_restaurants Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;All Restaurants&quot;'>
              <calculation class='tableau' formula='&quot;All Restaurants&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0q40u1w026pl4o199a6of02u6k9v'>
            <column caption='Benchmark Acquisition' datatype='integer' name='[Calculation1 (copy)_2223230121262833673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if([Parameters].[top_10_restaurants Parameter]=&apos;Top 10 Percent&apos;) then&#10;sum(if [top_10_restaurants]=&apos;Yes&apos; THEN [orders_gfs_brand_acquisition] END)&#10;ELSE &#10;if([Parameters].[top_10_restaurants Parameter]=&apos;Key Accounts&apos;) then&#10;sum(if [key_accounts]=&apos;Yes&apos; THEN [orders_gfs_brand_acquisition] END)&#10;ELSE &#10;if([Parameters].[top_10_restaurants Parameter]=&apos;All Restaurants&apos;) then&#10;sum(if [all_restaurants]=&apos;Yes&apos; THEN [orders_gfs_brand_acquisition] END)&#10;END END END' />
            </column>
            <column caption='GFS Returning Customer' datatype='integer' name='[Calculation1 (copy)_2223230121268228106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [vertical_type]=&apos;GFS&apos; THEN [orders_gfs_brand_returning_customer] END)' />
            </column>
            <column caption='Benchmark Returning Customer' datatype='integer' name='[Calculation2 (copy)_2223230121273180171]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if([Parameters].[top_10_restaurants Parameter]=&apos;Top 10 Percent&apos;) then&#10;sum(if [top_10_restaurants]=&apos;Yes&apos; THEN [orders_gfs_brand_returning_customer] END)&#10;ELSE &#10;if([Parameters].[top_10_restaurants Parameter]=&apos;Key Accounts&apos;) then&#10;sum(if [key_accounts]=&apos;Yes&apos; THEN [orders_gfs_brand_returning_customer] END)&#10;ELSE &#10;if([Parameters].[top_10_restaurants Parameter]=&apos;All Restaurants&apos;) then&#10;sum(if [all_restaurants]=&apos;Yes&apos; THEN [orders_gfs_brand_returning_customer] END)&#10;END END END' />
            </column>
            <column caption='GFS Acquisition' datatype='integer' name='[Calculation_2223230121262338056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [vertical_type]=&apos;GFS&apos; THEN [orders_gfs_brand_acquisition] END)' />
            </column>
            <column caption='country_general' datatype='string' name='[Calculation_398920438387331074]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country]' />
            </column>
            <column caption='vertical_type general' datatype='string' name='[Calculation_398920438387425283]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[vertical_type]' />
            </column>
            <column caption='Report Period' datatype='date' datatype-customized='true' default-format='*dd MMM yyyy' name='[Calculation_4250412900119760896]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='Share Of Orders Returning Customers' datatype='real' default-format='p0.0%' name='[Calculation_4700280280905957381]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_gfs_brand_returning_customer]) / (SUM([orders_gfs_brand_acquisition]) + SUM([orders_gfs_brand_returning_customer]))' />
            </column>
            <column caption='View Percent' datatype='string' name='[Calculation_4700280280906620935]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2]' />
            </column>
            <column caption='Share Of Orders Returning Customers (Non-GFS) ' datatype='real' default-format='p0.0%' name='[Share Of Orders Returning Customers (GFS) (copy)_2223230121620357135]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation2 (copy)_2223230121273180171]&#10;/&#10; ([Calculation1 (copy)_2223230121262833673] + &#10; [Calculation2 (copy)_2223230121273180171])' />
            </column>
