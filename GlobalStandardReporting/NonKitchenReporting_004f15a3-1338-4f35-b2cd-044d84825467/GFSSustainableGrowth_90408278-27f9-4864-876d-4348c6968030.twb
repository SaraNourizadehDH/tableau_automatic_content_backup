                    <formatted-text>
                      <run bold='true' fontcolor='#4e79a7' underline='true'>Benchmarks:</run>
                      <run>Æ&#10;</run>
                      <run bold='true'>Top 10 Percent</run>
                      <run> - top 10 percent platform excl. KA by the number of orders.
</run>
                      <run bold='true'>Key Accounts</run>
                      <run> - only key accounts. &#10;</run>
                      <run bold='true'>All Restaurants</run>
                      <run> - All platform restaurants&#10;</run>
