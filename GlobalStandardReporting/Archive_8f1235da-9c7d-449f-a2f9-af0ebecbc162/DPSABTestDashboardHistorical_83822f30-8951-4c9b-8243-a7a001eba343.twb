          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='# Sessions' caption='Choose Metrics CVR' datatype='string' datatype-customized='true' name='[Choose Metrics (copy)_3027122641026084868]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total Sessions&quot;'>
              <calculation class='tableau' formula='&quot;Total Sessions&quot;' />
              <aliases>
                <alias key='&quot;Total Sessions&quot;' value='# Sessions' />
                <alias key='&quot;Total Users&quot;' value='# Users' />
              </aliases>
            </column>
            <column caption='Show Original-cvr' datatype='string' name='[Show Original (copy)_1824872698418741251]' param-domain-type='list' role='measure' type='nominal' value='&quot;True&quot;'>
              <calculation class='tableau' formula='&quot;True&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1p54svq183ik2q18yso2g1r8ztdq'>
            <column caption='Customer Tag' datatype='string' name='[Calculation_2923891743236423687]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([customer_tag]) THEN &apos;Null&apos;&#10;ELSE [customer_tag]&#10;END' />
            </column>
            <column caption='Zones ID/Zones Name' datatype='string' name='[Calculation_2923891743525847051]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[zones_id] + &apos; (&apos;+ [zones_name] + &apos; )&apos;' />
            </column>
            <column caption='KPI view filter' datatype='string' name='[Calculation_3027122641063067659]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Choose Metrics (copy)_3027122641026084868]' />
            </column>
            <column caption='User Entitlements' datatype='boolean' name='[Calculation_561964822781247488]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[username]= USERNAME()' />
            </column>
            <column caption='CVR (Abs)' datatype='real' default-format='p0.00%' name='[Calculation_6340646115994644505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE MAX([_level])&#10;&#10;WHEN &apos;All&apos; THEN SUM([transaction_no_count]) / SUM([session_id_count])&#10;WHEN &apos;Vendor Target Group&apos; THEN SUM([transaction_no_count])/ SUM([shop_menu_no_count])&#10;END' />
            </column>
            <column caption='Show Original' datatype='boolean' name='[Calculation_6340646115996811293]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Show Original (copy)_1824872698418741251]&#10;&#10;WHEN &apos;False&apos; THEN ([variant] != &apos;Original&apos;) AND NOT(ISNULL([variant]))&#10;WHEN &apos;True&apos; THEN ([created_date] != &apos;1999&apos;)&#10;END' />
