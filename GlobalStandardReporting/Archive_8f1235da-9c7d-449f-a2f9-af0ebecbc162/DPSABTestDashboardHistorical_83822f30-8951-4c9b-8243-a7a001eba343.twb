        <objects>
          <object caption='Custom SQL Query' id='_55E7F71F048741A7A379EE753F42C470'>
            <properties context=''>
              <relation connection='bigquery.1uuvv0e1ae2v250zj3vwd1iqs4ch' name='Custom SQL Query' type='text'>SELECT DISTINCT test_name
  , variant
  , SAFE_DIVIDE (SUM(users_count_per_test) OVER (PARTITION BY test_name, variant), 
    SUM(users_count_per_test) OVER (PARTITION BY test_name)) AS user_share
FROM `fulfillment-dwh-production.rl.dps_ab_test_dashboard_cvr_v2`
WHERE _level = &apos;All&apos;</relation>
            </properties>
          </object>
