    <worksheet name='D2-CVR-Overview'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Overview</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='D2-CVR-Overview' path='/t/GlobalStandardReporting/workbooks/DPSABTestDashboard-V2' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='dps_ab_tests_dashboard_cvr_v2' name='federated.1p54svq183ik2q18yso2g1r8ztdq' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose Absolute/Delta ' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Absolute&quot;'>
              <calculation class='tableau' formula='&quot;Absolute&quot;' />
              <aliases>
                <alias key='&quot;Delta&quot;' value='(%) Delta' />
              </aliases>
            </column>
            <column caption='Show Original-cvr' datatype='string' name='[Show Original (copy)_1824872698418741251]' param-domain-type='list' role='measure' type='nominal' value='&quot;True&quot;'>
              <calculation class='tableau' formula='&quot;True&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1p54svq183ik2q18yso2g1r8ztdq'>
            <column caption='Total Sessions(Abs)' datatype='integer' name='[CVR (copy)_3027122641022816256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([session_id_count])' />
            </column>
            <column caption='mCVR2 (Abs)' datatype='real' name='[CVR (copy)_6340646115994927130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE MAX([_level])&#10;&#10;WHEN &apos;All&apos; THEN SUM([list_menu_count]) / SUM([shop_list_no_count])&#10;WHEN &apos;Vendor Target Group&apos; THEN NULL&#10;END' />
            </column>
            <column caption='Total Sessions (Delta)' datatype='real' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((ZN([CVR (copy)_3027122641022816256]) - LOOKUP(ZN([CVR (copy)_3027122641022816256])))/LOOKUP(ZN([CVR (copy)_3027122641022816256])))*100'>
                <table-calc ordering-type='Field' tc-options='Fixed'>
                  <order field='[federated.1p54svq183ik2q18yso2g1r8ztdq].[none:variant:nk]' />
                  <order field='[federated.1p54svq183ik2q18yso2g1r8ztdq].[none:variation_share:ok]' />
                  <address />
                </table-calc>
              </calculation>
            </column>
            <column caption='Total Users (Delta)' datatype='real' name='[Calculation2]' role='measure' type='quantitative'>
