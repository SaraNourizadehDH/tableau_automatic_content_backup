      <aliases enabled='yes' />
      <column caption='Exclude uncomputabe values' datatype='string' name='[Calculation_-8668021870586642431]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE[Parameters].[Distance bin size (copy 2)]&#13;&#10;WHEN TRUE THEN IF isnull([Select Distance Type (copy)_8655637045657489416]) THEN &apos;exclude&apos; ELSE &apos;include&apos; END&#13;&#10;ELSE &apos;include&apos;&#13;&#10;END' />
      </column>
      <column caption='Total Distance Manhattan Km' datatype='real' name='[Calculation_8655637045041090560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[pickup_distance_manhattan_km]+[dropoff_distance_manhattan_km]' />
      </column>
      <column caption='% Acceptance Rate' datatype='real' name='[Calculation_8655637045042163713]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(COUNT(IF [is_courier_accepted]= TRUE THEN [delivery_id] ELSE NULL END))/&#13;&#10;(COUNT(IF[is_courier_notified]= TRUE THEN [delivery_id] ELSE NULL END ))' />
      </column>
      <column caption='Cancelled Orders' datatype='integer' name='[Calculation_8655637045269938178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_order_cancelled]= TRUE THEN [Calculation_8655637045743763467] ELSE NULL END)' />
      </column>
      <column caption='# Gross Orders' datatype='integer' name='[Calculation_8655637045270257668]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Cancelled Orders (copy)_8655637045270114307]+ [Calculation_8655637045269938178]' />
      </column>
      <column caption='Total Distance Manhattan Km (manual bin)' datatype='real' name='[Calculation_8655637045644939270]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ROUND([Calculation_8655637045041090560]/[Parameters].[Toggle (copy)],0)*[Parameters].[Toggle (copy)] &lt;= [Parameters].[Distance bin size (copy)]&#13;&#10;THEN ROUND([Calculation_8655637045041090560]/[Parameters].[Toggle (copy)],0)*[Parameters].[Toggle (copy)] ELSE NULL END' />
      </column>
      <column caption='Pickup Distance Manhattan (manual bin)' datatype='real' name='[Calculation_8655637045658423305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ROUND([pickup_distance_manhattan_km]/[Parameters].[Toggle (copy)],0)*[Parameters].[Toggle (copy)] &lt;= [Parameters].[Distance bin size (copy)]&#13;&#10;THEN ROUND([pickup_distance_manhattan_km]/[Parameters].[Toggle (copy)],0)*[Parameters].[Toggle (copy)] ELSE NULL END' />
      </column>
      <column caption='Order_id_country' datatype='string' name='[Calculation_8655637045743763467]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([order_id]) + [country_code]' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_935904323059499008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Completed Orders' datatype='integer' name='[Cancelled Orders (copy)_8655637045270114307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_order_completed]= TRUE THEN [Calculation_8655637045743763467] ELSE NULL END)' />
      </column>
      <column aggregation='None' caption='Dropoff Distance Manhattan Km (bin)' datatype='integer' name='[Dropoff Distance Manhattan Km (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='-1' formula='[dropoff_distance_manhattan_km]' peg='0' size='0.1' />
      </column>
      <column caption='Include zero in &amp;Acceptance Rate' datatype='boolean' name='[Exclude uncomputabe values (copy)_6441273404564299776]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Toggle (copy 2)]' />
      </column>
      <column caption='Delivery_id_country' datatype='string' name='[Order_id_country (copy)_-8668021870572756989]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='tableau' formula='STR([delivery_id]) + [country_code]' />
      </column>
      <column caption='Dropoff Distance Manhattan (manual bin)' datatype='real' name='[Pickup Distance Manhattan (manual bin) (copy)_8655637045658726410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ROUND([dropoff_distance_manhattan_km]/[Parameters].[Toggle (copy)],0)*[Parameters].[Toggle (copy)] &lt;= [Parameters].[Distance bin size (copy)]&#13;&#10;THEN ROUND([dropoff_distance_manhattan_km]/[Parameters].[Toggle (copy)],0)*[Parameters].[Toggle (copy)] ELSE NULL END' />
      </column>
      <column aggregation='None' caption='Pickup Distance Manhattan Km (bin)' datatype='integer' name='[Pickup Distance Manhattan Km (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='-1' formula='[pickup_distance_manhattan_km]' peg='0' size='0.1' />
      </column>
      <column caption='Select Distance Type' datatype='real' name='[Select Distance Type (copy)_8655637045657489416]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Select View: (copy)_1801932498194444288]&#13;&#10;WHEN &apos;Total&apos; THEN [Calculation_8655637045644939270]&#13;&#10;WHEN &apos;Dropoff&apos; THEN [Pickup Distance Manhattan (manual bin) (copy)_8655637045658726410]&#13;&#10;WHEN &apos;Pickup&apos; THEN [Calculation_8655637045658423305]&#13;&#10;END' />
      </column>
