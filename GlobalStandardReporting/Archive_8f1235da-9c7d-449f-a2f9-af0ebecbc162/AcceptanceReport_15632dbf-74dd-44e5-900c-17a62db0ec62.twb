      <column caption='Select Distance Type' datatype='string' name='[Calculation_1801932499169955842]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Select View: (copy)_1801932498194444288]' />
      </column>
      <column caption='Timeframe' datatype='date' name='[Calculation_2226467133872500736]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[report_date]' />
      </column>
      <column caption='Dropoff Distance Manhattan (km)' datatype='real' name='[Calculation_3476919711942578176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dropoff_distance_manhattan_km_sum])/SUM([dropoff_distance_manhattan_km_count])' />
      </column>
      <column caption='Total Distance' datatype='real' name='[Calculation_3476919712298528769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[dropoff_distance_manhattan_km_avg] + [pickup_distance_manhattan_km_avg]' />
      </column>
      <column caption='Date comparison' datatype='string' name='[Calculation_3695273884031221760]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [report_date] &lt; TODAY() THEN&#10;(IF [report_date] &gt;= DATEADD(&apos;day&apos;, -1, TODAY()) THEN &quot;Yesterday&quot;&#10;ELSEIF [report_date] = DATEADD(&apos;day&apos;, -8, TODAY()) THEN &quot;Yesterday -7&quot; END)&#10;END' />
      </column>
      <column caption='Dimension - Batch | Contract' datatype='string' name='[Calculation_4935100831229128704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE   [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;Contract Type&apos;  then [contract_type]&#10;WHEN &apos;Batch Number&apos; then [batch_number]&#10;&#10;END' />
      </column>
      <column caption='% Acceptance Rate' datatype='real' name='[Calculation_5634214300828966913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([courier_accepted])/SUM([courier_notified])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_935904323060563970]' role='dimension' type='nominal'>
