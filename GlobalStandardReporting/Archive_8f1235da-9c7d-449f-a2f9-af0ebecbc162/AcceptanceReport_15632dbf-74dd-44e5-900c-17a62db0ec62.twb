      <aliases enabled='yes' />
      <column caption='% Not Directly Accepted' datatype='real' name='[% Directly Accepted (copy)_5989224617357668358]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([not_directly_accepted]) / (SUM([not_directly_accepted]) + SUM([directly_accepted]))' />
      </column>
      <column caption='% Notified 3x' datatype='real' name='[% Notified 2x (copy)_5303621944818483201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([notified_3]) / SUM([not_directly_accepted])' />
      </column>
      <column caption='% Notified +5x' datatype='real' name='[% Notified 3x (copy) (copy)_5303621944819810307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([notified_5_plus]) / SUM([not_directly_accepted])' />
      </column>
      <column caption='% Notified 4x' datatype='real' name='[% Notified 3x (copy)_5303621944819785730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([notified_4]) / SUM([not_directly_accepted])' />
      </column>
      <column caption='Select Distance Type' datatype='string' name='[Calculation_1801932499173998595]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Select View: (copy)_1801932498194444288]' />
      </column>
      <column caption='% Orders Failed to Assign' datatype='real' name='[Calculation_3695273884302921730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_failed_to_assign])/SUM([gross_orders])' />
      </column>
      <column caption='Toggle' datatype='string' name='[Calculation_3695273884305739779]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2]' />
      </column>
      <column caption='Date comparison' datatype='string' name='[Calculation_3695273884367765508]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [report_date] &lt; TODAY() THEN&#10;(IF [report_date] &gt;= DATEADD(&apos;day&apos;, -1, TODAY()) THEN &quot;Yesterday&quot;&#10;ELSEIF [report_date] = DATEADD(&apos;day&apos;, -8, TODAY()) THEN &quot;Yesterday -7&quot; END)&#10;END' />
      </column>
      <column caption='% Courier Decline' datatype='real' name='[Calculation_425027277964918784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([courier_decline]) / SUM([courier_notified])' />
      </column>
      <column caption='% Notified 2x' datatype='real' name='[Calculation_5303621944817213440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([notified_2]) / SUM([not_directly_accepted])' />
      </column>
      <column caption='% Acceptance Rate' datatype='real' name='[Calculation_5303621945273696260]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([courier_accepted]) / SUM([courier_notified])' />
      </column>
      <column caption='% Directly Accepted' datatype='real' name='[Calculation_5989224617230794755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([directly_accepted]) / (SUM([not_directly_accepted]) + SUM([directly_accepted]))' />
      </column>
      <column caption='Total Distance' datatype='real' name='[Calculation_5989224617282158596]' role='measure' type='quantitative'>
