      </column>
      <column caption='HC RR cluster enum' datatype='integer' name='[Calculation_167688776868212741]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Issue Type Filter (copy)_167688776866496514] = [Parameters].[Parameter 2]&#10;AND [resolution_type] = &apos;Helpcenter_session&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [Issue Type Filter (copy)_167688776874319894] = [Parameters].[Parameter 5]&#10;AND [Automation Filter (copy)_167688776874639384] = [Parameters].[Has HC Automation (copy)_167688776873906197]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;AND [has_reorder_30D]&#10;THEN  [num_orders]&#10;END' />
      </column>
      <column caption='HC RR cluster' datatype='real' name='[Calculation_167688776868438023]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_167688776868212741])/SUM([HC RR cluster enum (copy)_167688776868380678])' />
      </column>
      <column caption='HC &amp; Bot RR cluster enum' datatype='integer' name='[Calculation_167688776900055067]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Issue Type Filter (copy)_167688776866496514] = [Parameters].[Parameter 2]&#10;AND [resolution_type] = &apos;HC session &amp; Bot contact&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;AND [has_reorder_30D] &#10;THEN [num_orders] END' />
      </column>
      <column caption='HC &amp; Bot RR cluster' datatype='real' name='[Calculation_167688776900399133]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_167688776900055067])&#10;/SUM([HC &amp; Bot RR cluster enum (copy)_167688776900263964])' />
      </column>
      <column caption='Agent &amp; HC RR cluster enum' datatype='integer' name='[Calculation_167688776901193758]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Issue Type Filter (copy)_167688776866496514] = [Parameters].[Parameter 2]&#10;AND [resolution_type] = &apos;Agent contact &amp; HC session&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;AND [has_reorder_30D] &#10;THEN [num_orders] END' />
      </column>
