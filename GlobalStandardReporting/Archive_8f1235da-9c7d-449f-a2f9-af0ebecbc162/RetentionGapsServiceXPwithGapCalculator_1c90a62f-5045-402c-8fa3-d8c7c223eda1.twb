      </column>
      <column caption='HC clean orders' datatype='integer' name='[Calculation_167688776969445435]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Helpcenter_session&apos;&#10;AND [Issue Type Filter (copy)_167688776874319894] = [Parameters].[Parameter 5]&#10;AND [Automation Filter (copy)_167688776874639384] = [Parameters].[Has HC Automation (copy)_167688776873906197]&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;AND [is_clean_order]&#10;THEN  [num_orders]&#10;END' />
      </column>
      <column caption='% Agent &amp; Bot clean orders' datatype='real' name='[Calculation_167688776970702912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Agent clean orders  (copy)_167688776970326077])&#10;/ SUM([Agent Contact RR- den (copy)_793548381300547623])' />
      </column>
      <column caption='Metric' datatype='real' hidden='true' name='[Calculation_176344133173145619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;Retention&apos; then [Calculation_793548382308692030] ELSEIF [Parameters].[Parameter 3] = &apos;GMV&apos; then [Calculation_341781047897264135] end' />
      </column>
      <column caption='Top Segment' datatype='string' hidden='true' name='[Calculation_176344133179826196]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Issue Type Set] then [issue_type] END' />
      </column>
      <column caption='Dimension 1' datatype='string' name='[Calculation_176344133189578775]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Order Experience&apos;&#10;then [ranked_order_experience]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Issue Type&apos;&#10;then [issue_type]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Resolution Type&apos;&#10;then [resolution_type]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;CCR Cluster&apos;&#10;then [contact_reason_cluster]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Customer Segment&apos;&#10;then [activity_segment]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Has HC Automation&apos;&#10;then STR([has_automation])&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Management Entity&apos;&#10;then [management_entity_group]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Country&apos;&#10;then [country]&#10;end' />
      </column>
      <column caption='Day count' datatype='integer' name='[Calculation_1795810380089200643]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([created_date])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_187321657555673088]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='remove last 30 days' datatype='boolean' name='[Calculation_2659586743313412096]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[created_date] &lt; DATEADD(&apos;day&apos;, -30, TODAY())' />
      </column>
      <column caption='Sealmess Avg gmv' datatype='real' name='[Calculation_341781047843500032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [ranked_order_experience] = &apos;Seamless&apos;&#10;AND ISNULL([issue_type])&#10;then [gmv_eur] end)/&#10;SUM(if [ranked_order_experience] = &apos;Seamless&apos;&#10;AND ISNULL([issue_type])&#10;then [num_orders] end)' />
      </column>
      <column caption='Avg Gmv' datatype='real' name='[Calculation_341781047897264135]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_eur])/SUM([num_orders])' />
      </column>
      <column caption='% clean orders' datatype='real' name='[Calculation_394416869330538504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [is_clean_order] then [num_orders] end)/SUM([num_orders])' />
      </column>
      <column caption='Selected sheet' datatype='string' name='[Calculation_394416869335863316]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Retention&apos; THEN &#10;&apos;retention&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;GMV&apos; THEN &apos;gmv&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Avg GMV 30D&apos; THEN &apos;avg gmv 30d&apos; &#10;ELSEIF [Parameters].[Parameter 3] = &apos;Avg Reorders 30D&apos; THEN &apos;avg reorders 30d&apos;&#10;end' />
      </column>
      <column caption='Ratio' datatype='real' hidden='true' name='[Calculation_394416869339807767]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Selected Benchmark (copy)_793548382278152251])/SUM([Selected Benchmark 0rders (copy)_793548382278971452])' />
      </column>
      <column caption='Seamless clean orders' datatype='integer' name='[Calculation_394416869343952920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [ranked_order_experience] = &apos;Seamless&apos; and [is_clean_order] then [num_orders] end' />
      </column>
      <column caption='% Seamless clean orders' datatype='real' name='[Calculation_394416869344112665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_394416869343952920])/SUM([Calculation_793548381281579008])' />
      </column>
      <column caption='% Agent clean orders' datatype='real' name='[Calculation_394416869346557979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Seamless clean orders (copy)_394416869346471962])/SUM([Seamless Retention Rate - den (copy)_793548381283442691])' />
      </column>
      <column caption='Quarter' datatype='string' name='[Calculation_4790493016517701632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([created_date])) + &apos;-Q&apos; + STR(QUARTER([created_date]))' />
      </column>
      <column caption='Empty field' datatype='string' name='[Calculation_705094844684230659]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;&apos;' />
      </column>
      <column caption='Retention Gap (HC&lt;&gt;Seamless)' datatype='real' default-format='p0.00%' name='[Calculation_705094844689399812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_793548381290123272] - [Calculation_793548381283262466]' />
      </column>
      <column caption='Avg reorders 30D' datatype='real' name='[Calculation_724657352805212207]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reorders_30D])/SUM([num_orders])' />
      </column>
      <column caption='Seamless Retention Rate - den' datatype='integer' name='[Calculation_793548381281579008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [ranked_order_experience] = &apos;Seamless&apos; &#10;AND ISNULL([issue_type])&#10;then [num_orders] end' />
      </column>
      <column caption='Seamless Retention Rate - enum' datatype='integer' name='[Calculation_793548381282525185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [has_reorder_30D]&#10;AND [ranked_order_experience] = &apos;Seamless&apos;&#10;AND ISNULL([issue_type])&#10;then [num_orders] end' />
      </column>
      <column caption='Seamless Retention Rate' datatype='real' name='[Calculation_793548381283262466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_793548381282525185])/SUM([Calculation_793548381281579008])' />
      </column>
      <column caption='Agent Contact Retention Rate' datatype='real' name='[Calculation_793548381284024325]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Agent Contact RR- den (copy)_793548381283962884])/SUM([Seamless Retention Rate - den (copy)_793548381283442691])' />
      </column>
      <column caption='HC RR - enum' datatype='integer' name='[Calculation_793548381289693190]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Helpcenter_session&apos;&#10;AND [Issue Type Filter (copy)_167688776874319894] = [Parameters].[Parameter 5]&#10;AND [Automation Filter (copy)_167688776874639384] = [Parameters].[Has HC Automation (copy)_167688776873906197]&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;AND [has_reorder_30D]&#10;THEN  [num_orders]&#10;END' />
      </column>
      <column caption='Helpcenter Session Retention Rate' datatype='real' name='[Calculation_793548381290123272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_793548381289693190])/SUM([HC RR - enum (copy)_793548381290057735])' />
      </column>
      <column caption='Bot Contact Retention Rate' datatype='real' name='[Calculation_793548381291073551]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Bot Contact - den  (copy)_793548381290967053])/SUM([HC RR - den (copy)_793548381290864652])' />
      </column>
      <column caption='Agent &amp; HC Retention Rate' datatype='real' name='[Calculation_793548381301383212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Agent &amp; HC RR- den (copy)_793548381301297195])/&#10;SUM([Agent &amp; Bot Contact RR- den  (copy)_793548381301178410])' />
      </column>
      <column caption='HC &amp; Bot Contact Retention Rate' datatype='real' name='[Calculation_793548381303762994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([HC &amp; Bot Contact RR- den (copy)_793548381303676977])/&#10;SUM([Agent &amp; HC RR- den (copy)_793548381303504944])' />
      </column>
      <column caption='Selected Benchmark' datatype='real' name='[Calculation_793548381304094771]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Seamless Order&apos;&#10;then [Calculation_793548381283262466]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;HC Session&apos;&#10;then [Calculation_793548381290123272]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Agent Contact&apos;&#10;then [Calculation_793548381284024325]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Bot Contact&apos;&#10;then [Calculation_793548381291073551]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;HC Session &amp; Bot Contact&apos;&#10;then [Calculation_793548381303762994]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Agent Contact &amp; Bot Contact&apos;&#10;then [Agent Contact Retention Rate (copy)_793548381300772905]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Agent Contact &amp; HC Session&apos;&#10;then [Calculation_793548381301383212]&#10;end' />
      </column>
      <column caption='Issue Type Filter' datatype='string' name='[Calculation_793548382262435895]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Issue Type Parameter] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSE [issue_type] end' />
      </column>
      <column caption='Retention gap color' datatype='string' name='[Calculation_793548382299721789]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Retention Gap (copy)_202802780638093312] &gt;= 0 then &apos;green&apos;&#10;ELSEIF [Retention Gap (copy)_202802780638093312] &lt; 0 then &apos;red&apos; end' />
      </column>
      <column caption='Retention rate' datatype='real' name='[Calculation_793548382308692030]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [has_reorder_30D] then [num_orders] end)/ sum([num_orders])' />
      </column>
      <column caption='Is Compensated (non-null)' datatype='boolean' name='[Calculation_955466819114151937]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([is_compensated], FALSE)' />
      </column>
      <column caption='Clean orders Color cluster' datatype='string' name='[Clean orders Color (copy)_1387882802094145537]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Selected Experience Clean 0rders (copy)_176344133168873490] &lt; 0.50 then &apos;red&apos; &#10;ELSEIF [Selected Benchmark Clean 0rders (copy)_176344133167878161] &gt;= 0.50 &#10;and [Selected Benchmark Clean 0rders (copy)_176344133167878161] &lt; 0.70 then &apos;orange&apos;&#10;else&#10;&apos;green&apos; end' />
      </column>
      <column caption='Dimension 2' datatype='string' hidden='true' name='[Dimension 1 (copy)_176344133190414361]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Dimension 1 (copy)_176344133183406102] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSEIF [Parameters].[Dimension 1 (copy)_176344133183406102] = &apos;Order Experience&apos;&#10;then [ranked_order_experience]&#10;ELSEIF [Parameters].[Dimension 1 (copy)_176344133183406102] = &apos;Issue Type&apos;&#10;then [issue_type]&#10;ELSEIF [Parameters].[Dimension 1 (copy)_176344133183406102] = &apos;Resolution Type&apos;&#10;then [resolution_type]&#10;ELSEIF [Parameters].[Dimension 1 (copy)_176344133183406102] = &apos;CCR Cluster&apos;&#10;then [contact_reason_cluster]&#10;ELSEIF [Parameters].[Dimension 1 (copy)_176344133183406102] = &apos;Customer Segment&apos;&#10;then [activity_segment]&#10;ELSEIF [Parameters].[Dimension 1 (copy)_176344133183406102] = &apos;Has HC Automation&apos;&#10;then STR([has_automation])&#10;ELSEIF [Parameters].[Dimension 1 (copy)_176344133183406102] = &apos;Management Entity&apos;&#10;then [management_entity_group]&#10;ELSEIF [Parameters].[Dimension 1 (copy)_176344133183406102] = &apos;Country&apos;&#10;then [country]&#10;end' />
      </column>
