          <datasource-dependencies datasource='federated.18y3noj0cfigjg1fhi1tw04rko3j'>
            <column caption='Agent &amp; Bot Contact RR- enum' datatype='integer' name='[Agent &amp; Bot Contact RR- den  (copy)_793548381300699176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Agent contact &amp; Bot contact&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;AND [has_reorder_30D] &#10;THEN [num_orders] END' />
            </column>
            <column caption='Agent &amp; HC RR- den' datatype='integer' name='[Agent &amp; Bot Contact RR- den  (copy)_793548381301178410]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Agent contact &amp; HC session&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;THEN [num_orders] END' />
            </column>
            <column caption='Agent &amp; HC RR- enum' datatype='integer' name='[Agent &amp; HC RR- den (copy)_793548381301297195]' role='measure' type='quantitative'>
