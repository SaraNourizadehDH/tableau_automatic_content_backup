      <column caption='Bot Contact Avg reorders 30D' datatype='real' name='[Bot Contact Avg gmv 30D (copy)_724657352732528669]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Bot_contact&apos; &#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [reorders_30D] end)/&#10;SUM(IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Bot_contact&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [num_orders] end)' />
      </column>
      <column caption='Bot Contact Avg gmv cluster 30D' datatype='real' name='[Bot Contact Avg gmv cluster (copy)_724657352714428423]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Issue Type Filter (copy)_167688776866496514] = [Parameters].[Parameter 2]&#10;AND [resolution_type] = &apos;Bot_contact&apos; &#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [gmv_30D_eur] end)/&#10;SUM(IF [Issue Type Filter (copy)_167688776866496514] = [Parameters].[Parameter 2]&#10;AND [resolution_type] = &apos;Bot_contact&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [num_orders] end)' />
      </column>
      <column caption='Bot Contact Avg reorders 30D cluster' datatype='real' name='[Bot Contact Avg gmv cluster 30D (copy)_724657352732696606]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Issue Type Filter (copy)_167688776866496514] = [Parameters].[Parameter 2]&#10;AND [resolution_type] = &apos;Bot_contact&apos; &#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [reorders_30D] end)/&#10;SUM(IF [Issue Type Filter (copy)_167688776866496514] = [Parameters].[Parameter 2]&#10;AND [resolution_type] = &apos;Bot_contact&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [num_orders] end)' />
