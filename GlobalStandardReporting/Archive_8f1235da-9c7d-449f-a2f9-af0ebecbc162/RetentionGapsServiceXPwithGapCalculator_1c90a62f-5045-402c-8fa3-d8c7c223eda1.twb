            <column caption='Seamless HC Filter' datatype='string' name='[Automation Filter (copy)_167688776874639384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Has HC Automation (copy)_167688776873906197] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSE [hc_experience] end' />
            </column>
            <column caption='p2p chat filter' datatype='string' name='[Automation Filter (copy)_167688776950128677]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 6] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSE STR([has_customer_p2p_chat]) end' />
            </column>
            <column caption='Bot Contact Avg reorders 30D' datatype='real' name='[Bot Contact Avg gmv 30D (copy)_724657352732528669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Bot_contact&apos; &#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [reorders_30D] end)/&#10;SUM(IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Bot_contact&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [num_orders] end)' />
            </column>
            <column caption='Date ' datatype='string' name='[Calculation_149111428220166144]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &apos;Daily&apos; then STR([created_date])&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Weekly&apos; then [week]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Monthly&apos; then [month]&#10;end' />
            </column>
            <column caption='Selected sheet' datatype='string' name='[Calculation_394416869335863316]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Retention&apos; THEN &#10;&apos;retention&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;GMV&apos; THEN &apos;gmv&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Avg GMV 30D&apos; THEN &apos;avg gmv 30d&apos; &#10;ELSEIF [Parameters].[Parameter 3] = &apos;Avg Reorders 30D&apos; THEN &apos;avg reorders 30d&apos;&#10;end' />
            </column>
            <column caption='Issue Type Filter' datatype='string' name='[Calculation_793548382262435895]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Issue Type Parameter] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSE [issue_type] end' />
            </column>
            <column caption='Is Compensated (non-null)' datatype='boolean' name='[Calculation_955466819114151937]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([is_compensated], FALSE)' />
            </column>
            <column caption='HC &amp; Bot contact Avg reorders 30D' datatype='real' name='[HC &amp; Bot contact Avg gmv  30D (copy)_724657352731770908]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;HC session &amp; Bot contact&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [reorders_30D] end)/&#10;SUM(IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;HC session &amp; Bot contact&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;THEN [num_orders] end)' />
            </column>
            <column caption='HC Avg reorders 30D' datatype='real' name='[HC Avg gmv 30D (copy)_724657352730992666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Helpcenter_session&apos;&#10;AND [Issue Type Filter (copy)_167688776874319894] = [Parameters].[Parameter 5]&#10;AND [Automation Filter (copy)_167688776874639384] = [Parameters].[Has HC Automation (copy)_167688776873906197]&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [reorders_30D] end)/&#10;SUM(IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Helpcenter_session&apos;&#10;AND [Issue Type Filter (copy)_167688776874319894] = [Parameters].[Parameter 5]&#10;AND [Automation Filter (copy)_167688776874639384] = [Parameters].[Has HC Automation (copy)_167688776873906197]&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;THEN [num_orders] end)' />
            </column>
            <column caption='Automation Filter' datatype='string' name='[Issue Type Filter (copy)_167688776874319894]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 5] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSE STR([has_automation]) end' />
            </column>
            <column caption='Non-Sealmess Avg reorders 30D' datatype='real' name='[Non-Sealmess Avg gmv 30D (copy)_724657352730796056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [ranked_order_experience] &lt;&gt; &apos;Seamless&apos; &#10;and [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [Issue Type Filter (copy)_167688776874319894] = [Parameters].[Parameter 5]&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [reorders_30D] end)/&#10;SUM(if [ranked_order_experience] &lt;&gt; &apos;Seamless&apos;&#10;and [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [Issue Type Filter (copy)_167688776874319894] = [Parameters].[Parameter 5]&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [num_orders] end)' />
            </column>
            <column caption='Sealmess Avg Reorders 30D' datatype='real' name='[Sealmess Avg gmv 30D (copy)_724657352730243094]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [ranked_order_experience] = &apos;Seamless&apos;&#10;AND ISNULL([issue_type])&#10;then [reorders_30D] end)/&#10;SUM(if [ranked_order_experience] = &apos;Seamless&apos;&#10;AND ISNULL([issue_type])&#10;then [num_orders] end)' />
            </column>
            <column caption='Selected Benchmark Avg reorders 30D' datatype='real' name='[Selected Benchmark GMV 30D (copy)_724657352795361318]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Seamless Order&apos;&#10;then [Sealmess Avg gmv 30D (copy)_724657352730243094]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;HC Session&apos;&#10;then [HC Avg gmv 30D (copy)_724657352730992666]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Agent Contact&apos;&#10;then [Agent Contact Avg gmv 30D (copy)_724657352733274144]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Bot Contact&apos;&#10;then [Bot Contact Avg gmv 30D (copy)_724657352732528669]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;HC Session &amp; Bot Contact&apos;&#10;then [HC &amp; Bot contact Avg gmv  30D (copy)_724657352731770908]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Agent Contact &amp; Bot Contact&apos;&#10;then [Agent &amp; Bot Contact Avg gmv  (copy)_724657352733683747]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Agent Contact &amp; HC Session&apos;&#10;then [Agent &amp; HC Avg gmv 30D (copy)_724657352733429793]&#10;end' />
            </column>
            <column caption='Selected Experience Avg reorders 30D' datatype='real' name='[Selected Experience GMV 30D (copy)_724657352796016681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Selected Experience 1 (copy)_793548382261686325] = &apos;Non-Seamless Order&apos;&#10;then [Non-Sealmess Avg gmv 30D (copy)_724657352730796056]&#10;ELSEIF [Parameters].[Selected Experience 1 (copy)_793548382261686325] = &apos;HC Session&apos;&#10;then [HC Avg gmv 30D (copy)_724657352730992666]&#10;ELSEIF [Parameters].[Selected Experience 1 (copy)_793548382261686325] = &apos;Agent Contact&apos;&#10;then [Agent Contact Avg gmv 30D (copy)_724657352733274144]&#10;ELSEIF [Parameters].[Selected Experience 1 (copy)_793548382261686325] = &apos;Bot Contact&apos;&#10;then [Bot Contact Avg gmv 30D (copy)_724657352732528669]&#10;ELSEIF [Parameters].[Selected Experience 1 (copy)_793548382261686325] = &apos;HC Session &amp; Bot Contact&apos;&#10;then [HC &amp; Bot contact Avg gmv  30D (copy)_724657352731770908]&#10;ELSEIF [Parameters].[Selected Experience 1 (copy)_793548382261686325] = &apos;Agent Contact &amp; Bot Contact&apos;&#10;then [Agent &amp; Bot Contact Avg gmv  (copy)_724657352733683747]&#10;ELSEIF [Parameters].[Selected Experience 1 (copy)_793548382261686325] = &apos;Agent Contact &amp; HC Session&apos;&#10;then [Agent &amp; HC Avg gmv 30D (copy)_724657352733429793]&#10;end' />
            </column>
            <column caption='Customer Segment' datatype='string' name='[activity_segment]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='Not Available' />
                <alias key='&quot;A&quot;' value='A - High Orders / High CVR   ' />
                <alias key='&quot;B&quot;' value='B - High Orders / Low CVR' />
                <alias key='&quot;C&quot;' value='C - Low Orders / High CVR' />
                <alias key='&quot;D&quot;' value='D - Low Orders / Low CVR' />
