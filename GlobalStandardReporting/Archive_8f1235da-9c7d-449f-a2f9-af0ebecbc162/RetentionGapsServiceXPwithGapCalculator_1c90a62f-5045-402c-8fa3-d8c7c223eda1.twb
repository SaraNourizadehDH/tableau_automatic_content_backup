      </column>
      <column caption='Clean orders Color' datatype='string' name='[Calculation_1387882802093043712]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Selected Benchmark Clean 0rders (copy)_176344133094699009] &lt; 0.50 then &apos;red&apos; &#10;ELSEIF [Selected Benchmark 0rders (copy)_176344133094182912] &gt;= 0.50 &#10;and [Selected Benchmark 0rders (copy)_176344133094182912] &lt; 0.70 then &apos;orange&apos;&#10;else&#10;&apos;green&apos; end' />
      </column>
      <column caption='Estim Uplift  HC orders (annual)' datatype='real' name='[Calculation_1483654629871759360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//# of extra orders with reorders w/30d caused by retention uplift&#13;&#10;[Parameters].[Parameter 9] * SUM([HC RR - enum (copy)_793548381290057735])&#13;&#10;/&#13;&#10;[Calculation_793548381290123272]&#13;&#10;/&#13;&#10;[Calculation_1795810380089200643] * 365&#13;&#10;&#13;&#10;//Example: 1.5% * (440 510 /  89%)' />
      </column>
      <column caption='Date ' datatype='string' name='[Calculation_149111428220166144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &apos;Daily&apos; then STR([created_date])&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Weekly&apos; then [week]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Monthly&apos; then [month]&#10;end' />
      </column>
      <column caption='Agent RR cluster enum' datatype='integer' name='[Calculation_149111428223565825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 2] = [Issue Type Filter (copy)_167688776866496514] &#10;AND [resolution_type] = &apos;Agent_contact&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;AND [has_reorder_30D] &#10;then [num_orders] end' />
      </column>
      <column caption='Agent RR cluster' datatype='real' name='[Calculation_149111428224344068]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_149111428223565825])&#10;/SUM([Agent RR cluster enum (copy)_149111428224077827])' />
      </column>
      <column caption='Bot RR cluster den' datatype='integer' name='[Calculation_167688776866058240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Issue Type Filter (copy)_167688776866496514] = [Parameters].[Parameter 2]&#10;AND [resolution_type] = &apos;Bot_contact&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;THEN  [num_orders]&#10;END' />
