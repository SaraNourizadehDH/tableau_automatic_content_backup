    <worksheet name='Retention Estimates Totals'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>Estimated </run>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>annual</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'> uplift in orders is </run>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'><![CDATA[<[federated.18y3noj0cfigjg1fhi1tw04rko3j].[usr:Calculation_1483654629871759360:qk]>]]></run>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>Æ </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>(</run>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'><![CDATA[<[federated.18y3noj0cfigjg1fhi1tw04rko3j].[usr:% Uplift HC clean Orders (of all) (copy)_1483654629904809992:qk]>]]></run>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'> of all orders) </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>with  </run>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'><![CDATA[<[federated.18y3noj0cfigjg1fhi1tw04rko3j].[usr:Estim Uplift  HC clean orders (copy)_1483654629882703873:qk]>]]></run>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'> Euro of GMV </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'>(</run>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'><![CDATA[<[federated.18y3noj0cfigjg1fhi1tw04rko3j].[usr:% Uplift Num Orders (of all) (copy)_705094844676558848:qk]>]]></run>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Regular' fontsize='12'> of total GMV)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Service Retention Gap XP' name='federated.18y3noj0cfigjg1fhi1tw04rko3j' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Is Seamless HC session' datatype='string' name='[Has HC Automation (copy)_167688776873906197]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Selected Issue Type' datatype='string' name='[Issue Type Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Has HC Automation' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;false&quot;' value='False' />
                <alias key='&quot;true&quot;' value='True' />
              </aliases>
            </column>
            <column caption='Has Customer P2P Chat' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;false&quot;' value='False' />
                <alias key='&quot;true&quot;' value='True' />
              </aliases>
            </column>
            <column caption='Has Compensation Issued' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;false&quot;' value='False' />
                <alias key='&quot;true&quot;' value='True' />
              </aliases>
            </column>
            <column caption='Estimated Gap to close' datatype='real' default-format='p0.00%' name='[Parameter 9]' param-domain-type='range' role='measure' type='quantitative' value='0.010000000000000012'>
              <calculation class='tableau' formula='0.010000000000000012' />
              <range granularity='0.005' max='100.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18y3noj0cfigjg1fhi1tw04rko3j'>
            <column caption='% Uplift Num Orders (of all)' datatype='real' default-format='p0.0000%' name='[% Uplift HC clean Orders (of all) (copy)_1483654629904809992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(MAX([Num Orders (copy)_1483654629898842115]) + ([Calculation_1483654629871759360])/365 * [Calculation_1795810380089200643])&#13;&#10;/&#13;&#10;MAX([Num Orders (copy)_1483654629898842115]) - 1' />
            </column>
            <column caption='% Uplift GMV (of all)' datatype='real' default-format='p0.0000%' name='[% Uplift Num Orders (of all) (copy)_705094844676558848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(MAX({FIXED:SUM([gmv_eur])}) + ([Estim Uplift  HC clean orders (copy)_1483654629882703873]/365 * [Calculation_1795810380089200643]))&#13;&#10;/&#13;&#10;MAX({FIXED:SUM([gmv_eur])}) - 1' />
            </column>
            <column caption='Seamless HC Filter' datatype='string' name='[Automation Filter (copy)_167688776874639384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Has HC Automation (copy)_167688776873906197] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSE [hc_experience] end' />
            </column>
            <column caption='p2p chat filter' datatype='string' name='[Automation Filter (copy)_167688776950128677]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 6] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSE STR([has_customer_p2p_chat]) end' />
            </column>
            <column caption='Estim Uplift  HC orders (annual)' datatype='real' name='[Calculation_1483654629871759360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//# of extra orders with reorders w/30d caused by retention uplift&#13;&#10;[Parameters].[Parameter 9] * SUM([HC RR - enum (copy)_793548381290057735])&#13;&#10;/&#13;&#10;[Calculation_793548381290123272]&#13;&#10;/&#13;&#10;[Calculation_1795810380089200643] * 365&#13;&#10;&#13;&#10;//Example: 1.5% * (440 510 /  89%)' />
            </column>
            <column caption='Day count' datatype='integer' name='[Calculation_1795810380089200643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([created_date])' />
            </column>
            <column caption='Empty field' datatype='string' name='[Calculation_705094844684230659]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;&apos;' />
            </column>
            <column caption='HC RR - enum' datatype='integer' name='[Calculation_793548381289693190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Helpcenter_session&apos;&#10;AND [Issue Type Filter (copy)_167688776874319894] = [Parameters].[Parameter 5]&#10;AND [Automation Filter (copy)_167688776874639384] = [Parameters].[Has HC Automation (copy)_167688776873906197]&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;AND [has_reorder_30D]&#10;THEN  [num_orders]&#10;END' />
            </column>
            <column caption='Helpcenter Session Retention Rate' datatype='real' name='[Calculation_793548381290123272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_793548381289693190])/SUM([HC RR - enum (copy)_793548381290057735])' />
            </column>
            <column caption='Issue Type Filter' datatype='string' name='[Calculation_793548382262435895]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Issue Type Parameter] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSE [issue_type] end' />
            </column>
            <column caption='Is Compensated (non-null)' datatype='boolean' name='[Calculation_955466819114151937]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([is_compensated], FALSE)' />
            </column>
            <column caption='Estim Uplift  HC GMV (annual)' datatype='real' name='[Estim Uplift  HC clean orders (copy)_1483654629882703873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1483654629871759360]&#13;&#10;*&#13;&#10;[Sealmess Avg gmv (copy)_341781047845916674])' />
            </column>
            <column caption='HC RR - den' datatype='integer' name='[HC RR - enum (copy)_793548381290057735]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Helpcenter_session&apos;&#10;AND [Issue Type Filter (copy)_167688776874319894] = [Parameters].[Parameter 5]&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [Automation Filter (copy)_167688776874639384] = [Parameters].[Has HC Automation (copy)_167688776873906197]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;THEN [num_orders]&#10;END' />
            </column>
            <column caption='Automation Filter' datatype='string' name='[Issue Type Filter (copy)_167688776874319894]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 5] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSE STR([has_automation]) end' />
            </column>
            <column caption='Management Entity Group (copy)' datatype='string' name='[Management Entity Group (copy)_1483654629889376258]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[management_entity_group]' />
            </column>
            <column caption='Num Orders (all)' datatype='integer' name='[Num Orders (copy)_1483654629898842115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : SUM([num_orders])}' />
            </column>
            <column caption='HC Avg gmv ' datatype='real' name='[Sealmess Avg gmv (copy)_341781047845916674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Helpcenter_session&apos;&#10;AND [Issue Type Filter (copy)_167688776874319894] = [Parameters].[Parameter 5]&#10;AND [Automation Filter (copy)_167688776874639384] = [Parameters].[Has HC Automation (copy)_167688776873906197]&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [gmv_eur] end)/&#10;SUM(IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Helpcenter_session&apos;&#10;AND [Issue Type Filter (copy)_167688776874319894] = [Parameters].[Parameter 5]&#10;AND [Automation Filter (copy)_167688776874639384] = [Parameters].[Has HC Automation (copy)_167688776873906197]&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;THEN [num_orders] end)' />
            </column>
            <column caption='Customer Segment' datatype='string' name='[activity_segment]' role='dimension' type='nominal'>
              <aliases>
