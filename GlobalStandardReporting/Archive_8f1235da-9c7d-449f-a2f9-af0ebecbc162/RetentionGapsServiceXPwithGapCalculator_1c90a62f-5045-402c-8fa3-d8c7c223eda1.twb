            </column>
            <column caption='HC &amp; Bot Contact RR- den' datatype='integer' name='[Agent &amp; HC RR- den (copy)_793548381303504944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;HC session &amp; Bot contact&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;THEN [num_orders] END' />
            </column>
            <column caption='Agent Contact RR- enum' datatype='integer' name='[Agent Contact RR- den (copy)_793548381283962884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter] &#10;AND [resolution_type] = &apos;Agent_contact&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;AND [has_reorder_30D] &#10;THEN [num_orders] END' />
            </column>
            <column caption='Agent &amp; Bot Contact RR- den ' datatype='integer' name='[Agent Contact RR- den (copy)_793548381300547623]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Agent contact &amp; Bot contact&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;THEN [num_orders] END' />
            </column>
            <column caption='Agent &amp; Bot Contact Retention Rate' datatype='real' name='[Agent Contact Retention Rate (copy)_793548381300772905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Agent &amp; Bot Contact RR- den  (copy)_793548381300699176])/SUM([Agent Contact RR- den (copy)_793548381300547623])' />
            </column>
            <column caption='Seamless HC Filter' datatype='string' name='[Automation Filter (copy)_167688776874639384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Has HC Automation (copy)_167688776873906197] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSE [hc_experience] end' />
            </column>
            <column caption='p2p chat filter' datatype='string' name='[Automation Filter (copy)_167688776950128677]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 6] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSE STR([has_customer_p2p_chat]) end' />
            </column>
            <column caption='Bot Contact - enum' datatype='integer' name='[Bot Contact - den  (copy)_793548381290967053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Bot_contact&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;AND [has_reorder_30D] &#10;THEN  [num_orders]&#10;END' />
            </column>
            <column caption='Selected sheet' datatype='string' name='[Calculation_394416869335863316]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Retention&apos; THEN &#10;&apos;retention&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;GMV&apos; THEN &apos;gmv&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Avg GMV 30D&apos; THEN &apos;avg gmv 30d&apos; &#10;ELSEIF [Parameters].[Parameter 3] = &apos;Avg Reorders 30D&apos; THEN &apos;avg reorders 30d&apos;&#10;end' />
            </column>
            <column caption='Quarter' datatype='string' name='[Calculation_4790493016517701632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([created_date])) + &apos;-Q&apos; + STR(QUARTER([created_date]))' />
            </column>
            <column caption='Seamless Retention Rate - den' datatype='integer' name='[Calculation_793548381281579008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [ranked_order_experience] = &apos;Seamless&apos; &#10;AND ISNULL([issue_type])&#10;then [num_orders] end' />
            </column>
            <column caption='Seamless Retention Rate - enum' datatype='integer' name='[Calculation_793548381282525185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [has_reorder_30D]&#10;AND [ranked_order_experience] = &apos;Seamless&apos;&#10;AND ISNULL([issue_type])&#10;then [num_orders] end' />
            </column>
            <column caption='Seamless Retention Rate' datatype='real' name='[Calculation_793548381283262466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_793548381282525185])/SUM([Calculation_793548381281579008])' />
            </column>
            <column caption='Agent Contact Retention Rate' datatype='real' name='[Calculation_793548381284024325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Agent Contact RR- den (copy)_793548381283962884])/SUM([Seamless Retention Rate - den (copy)_793548381283442691])' />
            </column>
            <column caption='HC RR - enum' datatype='integer' name='[Calculation_793548381289693190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Helpcenter_session&apos;&#10;AND [Issue Type Filter (copy)_167688776874319894] = [Parameters].[Parameter 5]&#10;AND [Automation Filter (copy)_167688776874639384] = [Parameters].[Has HC Automation (copy)_167688776873906197]&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;AND [has_reorder_30D]&#10;THEN  [num_orders]&#10;END' />
            </column>
            <column caption='Helpcenter Session Retention Rate' datatype='real' name='[Calculation_793548381290123272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_793548381289693190])/SUM([HC RR - enum (copy)_793548381290057735])' />
            </column>
            <column caption='Bot Contact Retention Rate' datatype='real' name='[Calculation_793548381291073551]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Bot Contact - den  (copy)_793548381290967053])/SUM([HC RR - den (copy)_793548381290864652])' />
            </column>
            <column caption='Agent &amp; HC Retention Rate' datatype='real' name='[Calculation_793548381301383212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Agent &amp; HC RR- den (copy)_793548381301297195])/&#10;SUM([Agent &amp; Bot Contact RR- den  (copy)_793548381301178410])' />
            </column>
            <column caption='HC &amp; Bot Contact Retention Rate' datatype='real' name='[Calculation_793548381303762994]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([HC &amp; Bot Contact RR- den (copy)_793548381303676977])/&#10;SUM([Agent &amp; HC RR- den (copy)_793548381303504944])' />
            </column>
            <column caption='Selected Benchmark' datatype='real' name='[Calculation_793548381304094771]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Seamless Order&apos;&#10;then [Calculation_793548381283262466]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;HC Session&apos;&#10;then [Calculation_793548381290123272]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Agent Contact&apos;&#10;then [Calculation_793548381284024325]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Bot Contact&apos;&#10;then [Calculation_793548381291073551]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;HC Session &amp; Bot Contact&apos;&#10;then [Calculation_793548381303762994]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Agent Contact &amp; Bot Contact&apos;&#10;then [Agent Contact Retention Rate (copy)_793548381300772905]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Agent Contact &amp; HC Session&apos;&#10;then [Calculation_793548381301383212]&#10;end' />
            </column>
            <column caption='Issue Type Filter' datatype='string' name='[Calculation_793548382262435895]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Issue Type Parameter] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSE [issue_type] end' />
            </column>
            <column caption='Is Compensated (non-null)' datatype='boolean' name='[Calculation_955466819114151937]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([is_compensated], FALSE)' />
            </column>
            <column caption='HC &amp; Bot Contact RR- enum' datatype='integer' name='[HC &amp; Bot Contact RR- den (copy)_793548381303676977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;HC session &amp; Bot contact&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;AND [has_reorder_30D] &#10;THEN [num_orders] END' />
            </column>
            <column caption='Bot Contact - den ' datatype='integer' name='[HC RR - den (copy)_793548381290864652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Bot_contact&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;THEN  [num_orders]&#10;END' />
            </column>
            <column caption='HC RR - den' datatype='integer' name='[HC RR - enum (copy)_793548381290057735]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Helpcenter_session&apos;&#10;AND [Issue Type Filter (copy)_167688776874319894] = [Parameters].[Parameter 5]&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [Automation Filter (copy)_167688776874639384] = [Parameters].[Has HC Automation (copy)_167688776873906197]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;THEN [num_orders]&#10;END' />
