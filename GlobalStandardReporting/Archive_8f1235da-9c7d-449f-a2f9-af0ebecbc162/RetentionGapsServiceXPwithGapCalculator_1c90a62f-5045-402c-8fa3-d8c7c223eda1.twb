            <column caption='Agent &amp; Bot Contact Retention Rate' datatype='real' name='[Agent Contact Retention Rate (copy)_793548381300772905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Agent &amp; Bot Contact RR- den  (copy)_793548381300699176])/SUM([Agent Contact RR- den (copy)_793548381300547623])' />
            </column>
            <column caption='Seamless HC Filter' datatype='string' name='[Automation Filter (copy)_167688776874639384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Has HC Automation (copy)_167688776873906197] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSE [hc_experience] end' />
            </column>
