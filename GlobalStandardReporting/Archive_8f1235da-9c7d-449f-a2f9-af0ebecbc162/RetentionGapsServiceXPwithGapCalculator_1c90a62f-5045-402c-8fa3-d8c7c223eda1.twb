    <worksheet name='gmv difference'>
      <table>
        <view>
          <datasources>
            <datasource caption='Service Retention Gap XP' name='federated.18y3noj0cfigjg1fhi1tw04rko3j' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Is Seamless HC session' datatype='string' name='[Has HC Automation (copy)_167688776873906197]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Selected Issue Type' datatype='string' name='[Issue Type Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Benchmark' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;HC Session &amp; Bot Contact&quot;'>
              <calculation class='tableau' formula='&quot;HC Session &amp; Bot Contact&quot;' />
            </column>
            <column caption='Metric Type' datatype='string' datatype-customized='true' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Retention&quot;'>
              <calculation class='tableau' formula='&quot;Retention&quot;' />
            </column>
            <column caption='Date' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
              <aliases>
                <alias key='&quot;Daily&quot;' value='Date' />
                <alias key='&quot;Weekly&quot;' value='Week' />
              </aliases>
            </column>
            <column caption='Has HC Automation' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;false&quot;' value='False' />
                <alias key='&quot;true&quot;' value='True' />
              </aliases>
            </column>
            <column caption='Has Customer P2P Chat' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;false&quot;' value='False' />
                <alias key='&quot;true&quot;' value='True' />
              </aliases>
            </column>
            <column caption='Has Compensation Issued' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;false&quot;' value='False' />
                <alias key='&quot;true&quot;' value='True' />
              </aliases>
            </column>
            <column caption='Selected Experience' datatype='string' name='[Selected Experience 1 (copy)_793548382261686325]' param-domain-type='list' role='measure' type='nominal' value='&quot;HC Session&quot;'>
              <calculation class='tableau' formula='&quot;HC Session&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18y3noj0cfigjg1fhi1tw04rko3j'>
            <column caption='Agent &amp; HC Avg gmv' datatype='real' name='[Agent &amp; Bot Contact Avg gmv  (copy)_394416869331550222]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter] &#10;AND [resolution_type] = &apos;Agent contact &amp; HC session&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [gmv_eur] end)/&#10;SUM(if [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter] &#10;AND [resolution_type] = &apos;Agent contact &amp; HC session&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [num_orders] end)' />
            </column>
            <column caption='Bot Contact Avg gmv ' datatype='real' name='[Agent Contact Avg gmv  (copy)_394416869248761857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Bot_contact&apos; &#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [gmv_eur] end)/&#10;SUM(IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Bot_contact&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [num_orders] end)' />
            </column>
            <column caption='Agent &amp; Bot Contact Avg gmv ' datatype='real' name='[Agent Contact Avg gmv  (copy)_394416869331423245]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter] &#10;AND [resolution_type] = &apos;Agent contact &amp; Bot contact&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [gmv_eur] end)/&#10;SUM(if [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter] &#10;AND [resolution_type] = &apos;Agent contact &amp; Bot contact&apos;&#10;AND [Automation Filter (copy)_167688776950128677] = [Parameters].[Parameter 6]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [num_orders] end)' />
            </column>
            <column caption='Seamless HC Filter' datatype='string' name='[Automation Filter (copy)_167688776874639384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Has HC Automation (copy)_167688776873906197] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSE [hc_experience] end' />
            </column>
            <column caption='p2p chat filter' datatype='string' name='[Automation Filter (copy)_167688776950128677]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 6] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSE STR([has_customer_p2p_chat]) end' />
            </column>
            <column caption='Date ' datatype='string' name='[Calculation_149111428220166144]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &apos;Daily&apos; then STR([created_date])&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Weekly&apos; then [week]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Monthly&apos; then [month]&#10;end' />
            </column>
            <column caption='Sealmess Avg gmv' datatype='real' name='[Calculation_341781047843500032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [ranked_order_experience] = &apos;Seamless&apos;&#10;AND ISNULL([issue_type])&#10;then [gmv_eur] end)/&#10;SUM(if [ranked_order_experience] = &apos;Seamless&apos;&#10;AND ISNULL([issue_type])&#10;then [num_orders] end)' />
            </column>
            <column caption='Selected sheet' datatype='string' name='[Calculation_394416869335863316]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Retention&apos; THEN &#10;&apos;retention&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;GMV&apos; THEN &apos;gmv&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Avg GMV 30D&apos; THEN &apos;avg gmv 30d&apos; &#10;ELSEIF [Parameters].[Parameter 3] = &apos;Avg Reorders 30D&apos; THEN &apos;avg reorders 30d&apos;&#10;end' />
            </column>
            <column caption='Issue Type Filter' datatype='string' name='[Calculation_793548382262435895]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Issue Type Parameter] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSE [issue_type] end' />
            </column>
            <column caption='Is Compensated (non-null)' datatype='boolean' name='[Calculation_955466819114151937]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([is_compensated], FALSE)' />
            </column>
            <column caption='HC &amp; Bot contact Avg gmv ' datatype='real' name='[HC Avg gmv  (copy)_394416869332393999]' role='measure' type='quantitative'>
