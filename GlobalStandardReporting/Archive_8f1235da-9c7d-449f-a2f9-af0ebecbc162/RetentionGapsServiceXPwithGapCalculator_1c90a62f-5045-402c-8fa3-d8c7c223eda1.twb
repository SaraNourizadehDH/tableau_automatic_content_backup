            <column caption='reorders 30D diff color' datatype='string' name='[gmv diff color 30D (copy)_724657352799232044]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [gmv difference 30d (copy)_724657352798007339] &gt;= 0 then &apos;green&apos;&#10;ELSEIF [gmv difference 30d (copy)_724657352798007339] &lt; 0 then &apos;red&apos; end' />
            </column>
