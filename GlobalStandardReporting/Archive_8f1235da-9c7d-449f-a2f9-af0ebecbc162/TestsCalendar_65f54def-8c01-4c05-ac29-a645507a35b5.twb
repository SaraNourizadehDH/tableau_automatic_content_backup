      <aliases enabled='yes' />
      <column caption='FLGPO' datatype='real' default-format='n&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[CM1 (copy)_1007117474830692353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1007117474830098432]-AVG([dh_incentives])' />
      </column>
      <column caption='GPO' datatype='real' default-format='n&quot;€&quot;#,##0.00;-&quot;€&quot;#,##0.00' name='[Calculation_1007117474830098432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([cf])+AVG([vf])-AVG([cpo])' />
      </column>
      <column caption='GPO %' datatype='real' default-format='p0.0%' name='[Calculation_1007117474831208451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1007117474830098432]/AVG([gbv])' />
      </column>
      <column caption='Utilization' datatype='string' name='[Calculation_1923599998739296268]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM(IF [Calculation_1950340157111693320] THEN [variation_share (Custom SQL Query2)] ELSE 0 END)&gt;0 THEN &apos;Testing&apos; ELSE &apos;Free&apos; END' />
      </column>
      <column caption='Slot utilized' datatype='real' default-format='n#,##0.00&quot;%&quot;;-#,##0.00&quot;%&quot;' name='[Calculation_1923599998739349518]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM(IF [Calculation_1950340157111693320] THEN ROUND([variation_share (Custom SQL Query2)],2) ELSE 0 END))' />
      </column>
      <column caption='Status' datatype='boolean' name='[Calculation_1950340157111693320]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([end_date]) OR [end_date] &gt; [Parameters].[Next 30 days (copy)_2093610893228855302]' />
        <aliases>
          <alias key='false' value='Deactivated' />
          <alias key='true' value='Live' />
        </aliases>
      </column>
      <column caption='Detail ' datatype='string' name='[Calculation_2093610893223813120]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &apos;None&apos; THEN &apos;&apos;&#13;&#10;    WHEN &apos;City&apos; THEN [city_name]&#13;&#10;    WHEN &apos;Block&apos; THEN STR([block_id (Custom SQL Query)])&#13;&#10;    WHEN &apos;Zone&apos; THEN [zone_name]&#13;&#10;    WHEN &apos;Parent&apos; THEN [vendor_vertical_parent]&#13;&#10;    WHEN &apos;Name&apos; THEN [name]&#13;&#10;END' />
      </column>
      <column caption='Today + 30' datatype='date' name='[Calculation_2093610893227163652]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY() + 30' />
      </column>
      <column caption='Length' datatype='real' name='[Calculation_352688162164596738]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ATTR(IF [end_date] - [Parameters].[Next 30 days (copy)_2093610893228855302] &gt; 90 THEN DATEADD(&apos;day&apos;,90,[Parameters].[Next 30 days (copy)_2093610893228855302]) - [start_date] &#13;&#10;ELSE &#13;&#10;IFNULL(&#13;&#10;[end_date]-[start_date],&#13;&#10;MAX([Parameters].[Next 30 days (copy)_2093610893228855302]+1,[start_date])-[start_date])&#13;&#10;END)' />
      </column>
      <column caption='Format' datatype='string' name='[Calculation_352688162209132564]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD([name]) = 0 THEN &quot;No test&quot;&#13;&#10;ELSEIF NOT MIN([is_targeted]) THEN &quot;Overlapping&quot;&#13;&#10;ELSEIF COUNTD([name]) &gt; 0 THEN &quot;Targeted&quot;&#13;&#10;ELSE &quot;N/A&quot;&#13;&#10;END' />
      </column>
      <column caption='Subdetail ' datatype='string' name='[Detail  (copy)_2093610893224476674]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Detail (copy)_2093610893224443905]&#13;&#10;    WHEN &apos;None&apos; THEN &apos;&apos;&#13;&#10;    WHEN &apos;City&apos; THEN [city_name]&#13;&#10;    WHEN &apos;Block&apos; THEN STR([block_id (Custom SQL Query)])&#13;&#10;    WHEN &apos;Zone&apos; THEN [zone_name]&#13;&#10;    WHEN &apos;Parent&apos; THEN [vendor_vertical_parent]&#13;&#10;    WHEN &apos;Name&apos; THEN [name]&#13;&#10;END' />
      </column>
      <column caption='Customer Fees %' datatype='real' default-format='p0.0%' name='[FLGPO % (copy)_1007117474831503364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([cf])/AVG([gbv])' />
      </column>
      <column caption='FLGPO %' datatype='real' default-format='p0.0%' name='[FLGPO (copy)_1007117474831077378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[CM1 (copy)_1007117474830692353]/AVG([gbv])' />
      </column>
      <column caption='Other Feature ' datatype='string' name='[Other Feature (group)]' role='dimension' type='nominal'>
