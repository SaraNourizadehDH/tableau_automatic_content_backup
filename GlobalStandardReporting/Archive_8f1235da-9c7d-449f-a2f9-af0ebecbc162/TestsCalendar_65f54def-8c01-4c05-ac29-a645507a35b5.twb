    <datasource caption='pricing_calendar' inline='true' name='federated.0jdho9p1jj2z8718is2d419dv26i' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0sqw3k20558c9912uba7510tbb9e'>
            <connection CATALOG='logistics-data-storage-staging' EXECCATALOG='logistics-customer-staging' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='10' bq-large-fetch-rows='' bq-project-fetch-rows='2000' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='logistics-data-storage-staging' schema='long_term_pricing' server-oauth='server-custom' username='laurent.broering@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <relation type='collection'>
          <relation connection='bigquery.0sqw3k20558c9912uba7510tbb9e' name='Custom SQL Query' type='text'>with&#13;&#10;blocks as (&#13;&#10;  select&#13;&#10;    co.region,&#13;&#10;    p.entity_id,&#13;&#10;    co.country_code,&#13;&#10;    ci.id city_id,&#13;&#10;    ci.name city_name,&#13;&#10;    st_clusterdbscan(zo.shape,0,1) over (partition by entity_id, co.country_code order by zo.id) + 1 block_id,&#13;&#10;    zo.id zone_id,&#13;&#10;    zo.name zone_name,&#13;&#10;    st_centroid(zo.shape) coordinates,&#13;&#10;  from `fulfillment-dwh-production.cl.countries` co&#13;&#10;  left join unnest(co.platforms) p&#13;&#10;  left join unnest(co.cities) ci&#13;&#10;  left join unnest(ci.zones) zo&#13;&#10;  inner join `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` g on p.entity_id = g.global_entity_id&#13;&#10;  where true&#13;&#10;    and ci.is_active&#13;&#10;    and zo.is_active&#13;&#10;    and g.is_reporting_enabled&#13;&#10;    -- and p.entity_id = &apos;PY_BO&apos;&#13;&#10;)&#13;&#10;, vendor_vertical_parent as (&#13;&#10;  select&#13;&#10;    content.global_entity_id entity_id,&#13;&#10;    content.vendor_id,&#13;&#10;    initcap(content.vertical_parent) vertical_parent,&#13;&#10;  from `fulfillment-dwh-production.curated_data_shared_data_stream.vendor_stream` s&#13;&#10;  qualify row_number() over (partition by s.content.global_entity_id, s.content.vendor_id order by s.content.timestamp desc) = 1)&#13;&#10;SELECT&#13;&#10;  o.region,&#13;&#10;  o.entity_id,&#13;&#10;  INITCAP(ifnull(v.vertical_parent, o.vendor_vertical_parent)) vendor_vertical_parent,&#13;&#10;  o.city_name,&#13;&#10;  b.block_id,&#13;&#10;  INITCAP(o.zone_name) zone_name,&#13;&#10;  AVG(o.gfv_eur) AS gbv,&#13;&#10;  AVG(o.dps_travel_time) dps_travel_time,&#13;&#10;  AVG(o.dps_travel_time_fee_local) dps_travel_time_fee_local,&#13;&#10;  AVG(IFNULL(o.delivery_fee_eur, 0)) AS delivery_fee_eur,&#13;&#10;  AVG(IFNULL(o.service_fee_eur, 0)) AS service_fee_eur,&#13;&#10;  AVG(IFNULL(o.mov_customer_fee_eur, 0)) AS mov_customer_fee_eur,&#13;&#10;  AVG(IFNULL(o.delivery_fee_eur, 0) + IFNULL(o.service_fee_eur, 0) + IFNULL(o.mov_customer_fee_eur, 0)) AS cf,&#13;&#10;  AVG(IFNULL(o.commission_eur, 0) + IFNULL(o.joker_vendor_fee_eur, 0)) AS vf,&#13;&#10;  AVG(IFNULL(o.voucher_dh_eur, 0) + IFNULL(o.discount_dh_eur, 0)) AS dh_incentives,&#13;&#10;  AVG(IFNULL(o.voucher_other_eur, 0) + IFNULL(o.discount_other_eur, 0)) AS other_incentives,&#13;&#10;  AVG(IFNULL(o.delivery_costs_eur, 0)) AS cpo,&#13;&#10;  COUNT(DISTINCT o.platform_order_code) orders,&#13;&#10;FROM blocks b&#13;&#10;left join `fulfillment-dwh-production.cl.dps_sessions_mapped_to_orders` o using(entity_id, country_code, zone_id)&#13;&#10;left join vendor_vertical_parent v using (entity_id, vendor_id) &#13;&#10;WHERE TRUE&#13;&#10;  AND o.created_date BETWEEN CURRENT_DATE() - 29 AND CURRENT_DATE() - 2&#13;&#10;  AND o.is_sent&#13;&#10;  AND o.is_own_delivery&#13;&#10;  AND o.entity_id IS NOT NULL&#13;&#10;  AND (o.vendor_vertical_parent IS NOT NULL OR o.entity_id = &apos;HS_SA&apos;)&#13;&#10;  AND o.city_name IS NOT NULL&#13;&#10;  AND o.zone_name IS NOT NULL&#13;&#10;  AND o.region IS NOT NULL&#13;&#10;  -- and b.zone_name = &apos;Potosi&apos;&#13;&#10;GROUP BY 1,2,3,4,5,6</relation>
          <relation join='left' type='join'>
            <clause type='join'>
              <expression op='AND'>
                <expression op='='>
                  <expression op='[pricing_calendar].[name]' />
                  <expression op='[total_share].[test_name]' />
                </expression>
                <expression op='='>
                  <expression op='[pricing_calendar].[entity_id]' />
                  <expression op='[total_share].[entity_id]' />
                </expression>
              </expression>
            </clause>
            <relation connection='bigquery.0sqw3k20558c9912uba7510tbb9e' name='pricing_calendar' table='[logistics-data-storage-staging.long_term_pricing].[pricing_calendar]' type='table' />
            <relation connection='bigquery.0sqw3k20558c9912uba7510tbb9e' name='total_share' type='text'>SELECT&#13;&#10;    entity_id,&#13;&#10;    test_name,&#13;&#10;    SUM(cast(variation_share as numeric)) variation_share,&#13;&#10;FROM `fulfillment-dwh-production.cl.dps_experiment_setups`&#13;&#10;WHERE priority = 1&#13;&#10;    -- and test_name= &apos;PA_20230911_L_B0_P_Elasticity_Market_High_2&apos;&#13;&#10;GROUP BY 1,2</relation>
          </relation>
        </relation>
