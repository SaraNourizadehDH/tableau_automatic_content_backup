              </aliases>
            </column>
            <column caption='Detail ' datatype='string' name='[Calculation_2093610893223813120]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &apos;None&apos; THEN &apos;&apos;&#13;&#10;    WHEN &apos;City&apos; THEN [city_name]&#13;&#10;    WHEN &apos;Block&apos; THEN STR([block_id (Custom SQL Query)])&#13;&#10;    WHEN &apos;Zone&apos; THEN [zone_name]&#13;&#10;    WHEN &apos;Parent&apos; THEN [vendor_vertical_parent]&#13;&#10;    WHEN &apos;Name&apos; THEN [name]&#13;&#10;END' />
            </column>
            <column caption='Today + 30' datatype='date' name='[Calculation_2093610893227163652]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY() + 30' />
            </column>
            <column caption='Length' datatype='real' name='[Calculation_352688162164596738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR(IF [end_date] - [Parameters].[Next 30 days (copy)_2093610893228855302] &gt; 90 THEN DATEADD(&apos;day&apos;,90,[Parameters].[Next 30 days (copy)_2093610893228855302]) - [start_date] &#13;&#10;ELSE &#13;&#10;IFNULL(&#13;&#10;[end_date]-[start_date],&#13;&#10;MAX([Parameters].[Next 30 days (copy)_2093610893228855302]+1,[start_date])-[start_date])&#13;&#10;END)' />
            </column>
            <column caption='Format' datatype='string' name='[Calculation_352688162209132564]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF COUNTD([name]) = 0 THEN &quot;No test&quot;&#13;&#10;ELSEIF NOT MIN([is_targeted]) THEN &quot;Overlapping&quot;&#13;&#10;ELSEIF COUNTD([name]) &gt; 0 THEN &quot;Targeted&quot;&#13;&#10;ELSE &quot;N/A&quot;&#13;&#10;END' />
            </column>
            <column caption='Subdetail ' datatype='string' name='[Detail  (copy)_2093610893224476674]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Detail (copy)_2093610893224443905]&#13;&#10;    WHEN &apos;None&apos; THEN &apos;&apos;&#13;&#10;    WHEN &apos;City&apos; THEN [city_name]&#13;&#10;    WHEN &apos;Block&apos; THEN STR([block_id (Custom SQL Query)])&#13;&#10;    WHEN &apos;Zone&apos; THEN [zone_name]&#13;&#10;    WHEN &apos;Parent&apos; THEN [vendor_vertical_parent]&#13;&#10;    WHEN &apos;Name&apos; THEN [name]&#13;&#10;END' />
