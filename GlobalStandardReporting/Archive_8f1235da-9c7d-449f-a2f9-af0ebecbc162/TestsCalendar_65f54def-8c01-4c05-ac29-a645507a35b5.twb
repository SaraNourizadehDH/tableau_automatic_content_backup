        <column caption='Length' datatype='real' name='[Calculation_352688162164596738]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='ATTR(IF [end_date] - [Parameters].[Next 30 days (copy)_2093610893228855302] &gt; 90 THEN DATEADD(&apos;day&apos;,90,[Parameters].[Next 30 days (copy)_2093610893228855302]) - [start_date] &#13;&#10;ELSE &#13;&#10;IFNULL(&#13;&#10;[end_date]-[start_date],&#13;&#10;MAX([Parameters].[Next 30 days (copy)_2093610893228855302]+1,[start_date])-[start_date])&#13;&#10;END)' />
