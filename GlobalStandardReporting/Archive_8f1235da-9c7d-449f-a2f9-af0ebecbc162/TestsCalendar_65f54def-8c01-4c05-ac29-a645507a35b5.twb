          <datasource-dependencies datasource='federated.0jdho9p1jj2z8718is2d419dv26i'>
            <column caption='Status' datatype='boolean' name='[Calculation_1950340157111693320]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ISNULL([end_date]) OR [end_date] &gt; [Parameters].[Next 30 days (copy)_2093610893228855302]' />
