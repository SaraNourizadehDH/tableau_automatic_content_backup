      <column caption='Live Test Name ' datatype='string' default-format='n#,##0.00&quot;%&quot;;-#,##0.00&quot;%&quot;' name='[Slot utilized (copy)_1007117474835062789]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1950340157111693320] THEN [name] END' />
