          <calculation class='tableau' formula='ISNULL([end_date]) OR [end_date] &gt; [Parameters].[Next 30 days (copy)_2093610893228855302]' />
          <aliases>
            <alias key='false' value='Deactivated' />
            <alias key='true' value='Live' />
