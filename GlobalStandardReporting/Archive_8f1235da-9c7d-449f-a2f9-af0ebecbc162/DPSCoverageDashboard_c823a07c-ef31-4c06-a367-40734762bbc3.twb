      <column caption='Vertical Type Grouped' datatype='string' name='[Calculation_1608207294295465984]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF lower([vertical_type]) = &apos;restaurants&apos; THEN &apos;Restaurants&apos;&#10;  ELSEIF lower([vertical_type]) = &apos;darkstores&apos; THEN &apos;Darkstores&apos;&#10;  ELSEIF lower([vertical_type]) = &apos;groceries&apos; THEN &apos;Groceries&apos;&#10;  ELSEIF (lower([vertical_type])= &apos;coffee&apos; OR lower([vertical_type]) = &apos;bakery&apos;) THEN &apos;Coffee&amp; Bakery&apos;&#10;  ELSEIF (lower([vertical_type]) = &apos;pharmacies&apos; OR lower([vertical_type]) = &apos;health_supplements&apos; OR lower([vertical_type]) = &apos;health_and_wellness&apos;) THEN &apos;Pharmacies&amp; Health&apos;&#10;  ELSEIF (lower([vertical_type]) = &apos;pets&apos;) THEN &apos;Pets&apos;&#10;  ELSEIF (lower([vertical_type]) = &apos;shops&apos; OR lower([vertical_type]) = &apos;supermarkets&apos; or lower([vertical_type]) = &apos;kiosk&apos;) THEN &apos;Shops&amp; Supermarkets&apos;&#10;  ELSE &apos;Others&apos;&#10;END' />
      </column>
