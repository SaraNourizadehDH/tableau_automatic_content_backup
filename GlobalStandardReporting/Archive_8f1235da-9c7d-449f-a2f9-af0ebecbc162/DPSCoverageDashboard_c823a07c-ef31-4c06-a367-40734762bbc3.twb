    <worksheet name='Main Metrics'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Master Metrics</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dps_variable_df_report (rl)' name='federated.0injiai1w6e0310zwnul50kh3vcd' />
          </datasources>
          <datasource-dependencies datasource='federated.0injiai1w6e0310zwnul50kh3vcd'>
            <column caption='Avg Small Order Fee (Eur)' datatype='real' name='[Avg Service Fee (Eur) (copy)_315814982522494979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([small_order_fee_eur])/SUM([total_orders])' />
            </column>
            <column caption='current_week' datatype='boolean' name='[Calculation_440508373061595137]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[week_start_week] = &apos;Current&apos;' />
            </column>
            <column caption='Total Revenue per Order (Eur)' datatype='real' name='[Calculation_5114681832448286723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([revenue_eur])/SUM([total_orders])' />
            </column>
            <column caption='Fee Revenue per Order (Eur)' datatype='real' name='[Calculation_5114681832449064964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fee_revenue_eur])/SUM([total_orders])' />
            </column>
            <column caption='Avg Delivery Fee (Eur)' datatype='real' name='[Calculation_5114681832449445893]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_eur])/SUM([total_orders])' />
            </column>
            <column caption='Total OD orders' datatype='integer' name='[Calculation_5114681832449646598]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_own_delivery] WHEN TRUE THEN [total_orders] END' />
            </column>
            <column caption='Avg Service Fee (Eur)' datatype='real' name='[Calculation_5114681832449753095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([service_fee_eur])/SUM([total_orders])' />
            </column>
            <column caption='Avg Surge Fee (Eur)' datatype='real' name='[Calculation_5114681832450404360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([surge_fee_eur])/SUM([total_orders])' />
            </column>
            <column caption='Profit per Order (Eur) - OD only' datatype='real' name='[Calculation_5114681832450920457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([profit_eur_OD])/SUM([Calculation_5114681832449646598])' />
            </column>
            <column caption='Cost per Order (Eur) - OD only' datatype='real' name='[Calculation_5114681832451936266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([costs_eur_OD])/SUM([Calculation_5114681832449646598])' />
            </column>
            <column caption='% of Profitable Orders - OD only' datatype='real' name='[Calculation_5114681832475176971]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([profitable_orders])/SUM([Calculation_5114681832449646598])' />
            </column>
            <column caption='Avg Delvery Fee / Avg Food Value' datatype='real' name='[Calculation_5114681832476000268]' role='measure' type='quantitative'>
