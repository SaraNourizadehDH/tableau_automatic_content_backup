              <calculation class='tableau' formula='[week_start_week] = &apos;Current&apos;' />
            </column>
            <column caption='% of Multi Vertical Customers' datatype='real' name='[Calculation_5114681832440410112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customers_more_than_1_vertical])/SUM([total_customers])' />
            </column>
            <column caption='% of DPS DFs in “customer paid” DFs' datatype='real' name='[Calculation_5114681832446431233]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dps_be_same_df])/SUM([total_orders])' />
            </column>
            <column caption='Avg Surge Fee (Eur)' datatype='real' name='[Calculation_5114681832450404360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([surge_fee_eur])/SUM([total_orders])' />
            </column>
            <column caption='Total Vendors VD' datatype='integer' name='[Calculation_5114681832478183437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [is_own_delivery] WHEN FALSE THEN  [total_vendors (_dps_product_metrics)] END' />
            </column>
            <column caption='% VD Vendors without DPS' datatype='real' name='[Calculation_5114681832478425102]' role='measure' type='quantitative'>
