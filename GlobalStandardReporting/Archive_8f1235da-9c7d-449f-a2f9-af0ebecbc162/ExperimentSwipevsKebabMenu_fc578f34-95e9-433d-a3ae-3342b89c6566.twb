          <datasource-dependencies datasource='federated.0vg9gty0jlgoxv1anoide144u8d9'>
            <column caption='Date' datatype='string' name='[Calculation_693061775437230082]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date]))+&quot;-W&quot;+STR(ISOWEEK([created_date]))&#10;END' />
            </column>
            <column caption='Successful Orders' datatype='integer' name='[Calculation_693061775476678660]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders] - [failed_orders]' />
            </column>
            <column caption='% Metric Numerator' datatype='integer' name='[Calculation_693061775494160390]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;Food Is Ready Adoption %&quot; THEN [food_is_ready_orders]&#10;WHEN &quot;Stacked Food Is Ready Adoption %&quot; THEN [stacked_food_is_ready_orders]&#10;WHEN &quot;Vendor Fail Rate&quot; THEN [vendor_failed_orders]&#10;WHEN &quot;Vendor Late % (&gt;10)&quot; THEN [vendor_late_10_orders]&#10;END' />
            </column>
            <column caption='% Metric Denominator' datatype='integer' name='[Calculation_693061775494680583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;Food Is Ready Adoption %&quot; THEN [Calculation_693061775476678660]&#10;WHEN &quot;Stacked Food Is Ready Adoption %&quot; THEN [Successful Orders (copy)_328410950523617282]&#10;WHEN &quot;Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;Vendor Late % (&gt;10)&quot; THEN [vendor_late_orders]&#10;END' />
            </column>
            <column caption='% Metric' datatype='real' name='[Offline Duration % (copy)_212795146002759682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_693061775494160390])/SUM([Calculation_693061775494680583])' />
            </column>
            <column caption='Stacked Successful Orders' datatype='integer' name='[Successful Orders (copy)_328410950523617282]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[stacked_orders] - [stacked_failed_orders]' />
            </column>
            <column caption='% Metric Divergence' datatype='real' name='[Vendor Fail Rate Divergence Variant A (Pre vs Post Rollouts) (copy)_212795146105204847]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (SUM(IF [experiment_group] != &apos;Baseline&apos; THEN [Calculation_693061775494160390] END)/SUM(IF [experiment_group] != &apos;Baseline&apos; THEN [Calculation_693061775494680583] END)) &#10;    /&#10;    (SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [Calculation_693061775494160390] END)/SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [Calculation_693061775494680583] END))&#10;)&#10;- 1' />
            </column>
