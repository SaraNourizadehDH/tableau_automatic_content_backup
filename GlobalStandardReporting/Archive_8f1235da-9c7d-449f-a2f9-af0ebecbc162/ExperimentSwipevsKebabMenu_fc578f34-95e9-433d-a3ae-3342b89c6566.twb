      <column caption='Parameters' datatype='string' name='[Calculation_693061775434362881]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [experiment_group]&#10;WHEN &quot;Baseline&quot; THEN &quot;Swipe Feature Enabled; Kebab Menu Feature Disabled&quot;&#10;WHEN &quot;Variant A&quot; THEN &quot;Swipe Feature Disabled; Kebab Menu Feature Enabled&quot;&#10;END' />
