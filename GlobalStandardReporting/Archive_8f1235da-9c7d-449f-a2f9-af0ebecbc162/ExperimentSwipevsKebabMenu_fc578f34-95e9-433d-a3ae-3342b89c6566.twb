          <datasource-dependencies datasource='Parameters'>
            <column caption='% Metric' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Food Is Ready Adoption \%&quot;'>
              <calculation class='tableau' formula='&quot;Food Is Ready Adoption %&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vg9gty0jlgoxv1anoide144u8d9'>
            <column caption='Analysis Timespan (Pre-Rollout)' datatype='string' name='[Calculation_418201462828920833]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [experiment_name] = &apos;LATAM|APAC|EU-PA|UY|PY|NI|SG|MM|SE|GR|CY&apos; AND [created_date] &gt;= DATE(&apos;2022-08-29&apos;) AND [created_date] &lt;= DATE(&apos;2022-09-25&apos;) THEN &quot;W35-W38&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
            </column>
            <column caption='Analysis Timespan (Post-Rollout)' datatype='string' name='[Calculation_418201462836531203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [experiment_name] = &apos;LATAM|APAC|EU-PA|UY|PY|NI|SG|MM|SE|GR|CY&apos; AND [created_date] &gt;= DATE(&apos;2022-10-03&apos;) AND [created_date] &lt;= DATE(&apos;2022-10-30&apos;) THEN &quot;W40-W43&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
            </column>
            <column caption='Successful Orders' datatype='integer' name='[Calculation_693061775476678660]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[orders] - [failed_orders]' />
            </column>
            <column caption='% Metric Numerator' datatype='integer' name='[Calculation_693061775494160390]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;Food Is Ready Adoption %&quot; THEN [food_is_ready_orders]&#10;WHEN &quot;Stacked Food Is Ready Adoption %&quot; THEN [stacked_food_is_ready_orders]&#10;WHEN &quot;Vendor Fail Rate&quot; THEN [vendor_failed_orders]&#10;WHEN &quot;Vendor Late % (&gt;10)&quot; THEN [vendor_late_10_orders]&#10;END' />
            </column>
            <column caption='% Metric Denominator' datatype='integer' name='[Calculation_693061775494680583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &quot;Food Is Ready Adoption %&quot; THEN [Calculation_693061775476678660]&#10;WHEN &quot;Stacked Food Is Ready Adoption %&quot; THEN [Successful Orders (copy)_328410950523617282]&#10;WHEN &quot;Vendor Fail Rate&quot; THEN [orders]&#10;WHEN &quot;Vendor Late % (&gt;10)&quot; THEN [vendor_late_orders]&#10;END' />
