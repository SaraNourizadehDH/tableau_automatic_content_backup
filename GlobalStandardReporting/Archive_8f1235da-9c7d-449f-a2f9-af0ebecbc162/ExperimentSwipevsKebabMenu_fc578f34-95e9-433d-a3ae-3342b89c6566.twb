        <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [food_is_ready_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [Calculation_693061775476678660] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [food_is_ready_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [Calculation_693061775476678660] END)&#10;    })&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [food_is_ready_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [Calculation_693061775476678660] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [food_is_ready_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [Calculation_693061775476678660] END)&#10;    })&#10;)' />
