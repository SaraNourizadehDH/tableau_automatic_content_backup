    <worksheet name='Food Is Ready Clicked Events Vendor %'>
      <table>
        <view>
          <datasources>
            <datasource caption='food_is_ready_kebab_menu_experiment' name='federated.0vg9gty0jlgoxv1anoide144u8d9' />
          </datasources>
          <datasource-dependencies datasource='federated.0vg9gty0jlgoxv1anoide144u8d9'>
            <column caption='Food Is Ready Clicked Events Vendors %' datatype='real' name='[Calculation_171277580578361354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_food_is_ready_clicked_vendors]) / SUM([vendors])' />
            </column>
            <column caption='Analysis Timespan (Pre-Rollout)' datatype='string' name='[Calculation_418201462828920833]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [experiment_name] = &apos;LATAM|APAC|EU-PA|UY|PY|NI|SG|MM|SE|GR|CY&apos; AND [created_date] &gt;= DATE(&apos;2022-08-29&apos;) AND [created_date] &lt;= DATE(&apos;2022-09-25&apos;) THEN &quot;W35-W38&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
            </column>
            <column caption='Analysis Timespan (Post-Rollout)' datatype='string' name='[Calculation_418201462836531203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [experiment_name] = &apos;LATAM|APAC|EU-PA|UY|PY|NI|SG|MM|SE|GR|CY&apos; AND [created_date] &gt;= DATE(&apos;2022-10-03&apos;) AND [created_date] &lt;= DATE(&apos;2022-10-30&apos;) THEN &quot;W40-W43&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
            </column>
            <column caption='Rollout Phase' datatype='string' name='[Calculation_4848195386618671104]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_418201462836531203] = &apos;N/A&apos; THEN &quot;Pre&quot;&#10;ELSEIF [Calculation_418201462828920833] = &apos;N/A&apos; THEN &quot;Post&quot;&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_693061775437230082]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date]))+&quot;-W&quot;+STR(ISOWEEK([created_date]))&#10;END' />
            </column>
