      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Migrated Data' id='Migrated Data'>
            <properties context=''>
              <relation connection='bigquery.02nj9q60vu3l8d10tg3nm1rrfl0d' name='Custom_SQL_Query' type='text'>SELECT `freshdesk_report`.`created_date` AS `created_date`,&#13;
  `freshdesk_report`.`report_week` AS `report_week`,
  `freshdesk_report`.`region` AS `region`,&#13;
  `freshdesk_report`.`country_name` AS `country_name`,&#13;
  `freshdesk_report`.`type` AS `type`,&#13;
  `freshdesk_report`.`source` AS `source`,&#13;
  `freshdesk_report`.`agent` AS `agent`,&#13;
  `freshdesk_report`.`survey_result` AS `survey_result`,&#13;
  `freshdesk_report`.`resolution_status` AS `resolution_status`,&#13;
  `freshdesk_report`.`status` AS `status`,&#13;
  `freshdesk_report`.`first_response_status` AS `first_response_status`&#13;
FROM `fulfillment-dwh-production.rl`.`freshdesk_report` `freshdesk_report`&#13;
WHERE `freshdesk_report`.`type` IN (&apos;Apps &amp; Tools&apos;, &apos;Article Feedback&apos;, &apos;Benefits&apos;, &apos;Cancelled Order&apos;, &apos;Cash Collection&apos;, &apos;Contracts and Documents&apos;, &apos;Equipment &amp; Deposit&apos;, &apos;Insurance&apos;, &apos;My Shift&apos;, &#13;
&apos;News and Update&apos;, &apos;Other&apos;, &apos;Payroll&apos;, &apos;Performance&apos;, &apos;Personal Details&apos;, &apos;Recruiting&apos;, &apos;Refer A Friend&apos;, &apos;Sickness &amp; Vacation&apos;)</relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
