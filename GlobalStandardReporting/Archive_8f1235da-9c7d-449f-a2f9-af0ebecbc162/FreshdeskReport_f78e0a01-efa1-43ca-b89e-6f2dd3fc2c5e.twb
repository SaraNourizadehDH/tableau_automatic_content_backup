        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.02nj9q60vu3l8d10tg3nm1rrfl0d' name='Custom_SQL_Query' type='text'>SELECT `freshdesk_report`.`created_date` AS `created_date`,&#13;
  `freshdesk_report`.`report_week` AS `report_week`,
