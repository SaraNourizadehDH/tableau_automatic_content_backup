      <column caption='regression - slope numerator' datatype='real' name='[denominator (copy)_2540733914644353031]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([week_in_cohort])*[Avg Order Frequency (cumulative orders / cohort size) (copy)_2540733914640244738]*COUNT([week_in_cohort])-(SUM([week_in_cohort])*[Avg Order Frequency (cumulative orders / cohort size) (copy)_2540733914640244738])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Global Entity Id (Tableau Gsr Entitlements Global Entity Id)' datatype='string' name='[global_entity_id (tableau_gsr_entitlements_global_entity_id)]' role='dimension' type='nominal' />
      <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
      <column caption='Management Entity Group' datatype='string' name='[management_entity_group]' role='dimension' type='nominal' />
      <column caption='Policy' datatype='string' name='[policy]' role='dimension' type='nominal' />
      <column caption='regression - y intercept numerator' datatype='real' name='[regression - slope numerator (copy)_2540733914644774921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([week_in_cohort]^2)*[Avg Order Frequency (cumulative orders / cohort size) (copy)_2540733914640244738]-(SUM([week_in_cohort])*[Avg Order Frequency (cumulative orders / cohort size) (copy)_2540733914640244738]*SUM([week_in_cohort]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='regression - y intercept ' datatype='real' name='[regression - y intercept (copy) (copy)_2540733914645114892]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[regression - slope numerator (copy)_2540733914644774921] / [Calculation_2540733914644185094]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='regression - slope' datatype='real' name='[regression - y intercept (copy)_2540733914645106699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[denominator (copy)_2540733914644353031] / [Calculation_2540733914644185094]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='regression - equation -&gt; replace the source data by the subset of using the 2 points' datatype='real' name='[regression - y intercept numerator (copy)_2540733914645463053]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{[regression - y intercept (copy)_2540733914645106699]}*[week_in_cohort]+{[regression - y intercept (copy) (copy)_2540733914645114892]}' />
      </column>
      <column caption='Sum Gmv Eur' datatype='real' name='[sum_gmv_eur]' role='measure' type='quantitative' />
      <column caption='Treatment' datatype='string' name='[treatment]' role='dimension' type='nominal' />
      <column caption='Username' datatype='string' name='[username]' role='dimension' type='nominal' />
      <column caption='Variant' datatype='string' name='[variant]' role='dimension' type='nominal' />
      <column aggregation='Sum' caption='Week In Cohort' datatype='integer' name='[week_in_cohort]' role='dimension' type='quantitative' />
