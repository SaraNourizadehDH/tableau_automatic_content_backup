      <aliases enabled='yes' />
      <column caption='# Reference Period Orders (1)' datatype='integer' name='[# Reference Period Orders (copy)_3133168370754293760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='# Order Frequency Checkpoint 1 Test' datatype='real' name='[# Reorders Checkpoint 1 (copy)_3877247465283809293]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(If [customer_group] = &apos;test&apos; THEN [reorders_checkpoint_1] ELSE 0 END)&#10;/ SUM([Cohort Customers (copy)_3877247465256046595])' />
      </column>
      <column caption='# Order Frequency Checkpoint 1 Control' datatype='real' name='[# Reorders Checkpoint 1 Test (copy)_3877247465283911694]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(If [customer_group] = &apos;control&apos; THEN [reorders_checkpoint_1] ELSE 0 END)&#10;/ SUM([Cohort Customers Test (copy)_3877247465256128516])' />
      </column>
      <column caption='# Reorders Checkpoint 2 Test' datatype='real' name='[# Reorders Checkpoint 2 (copy)_3877247465284001807]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(If [customer_group] = &apos;test&apos; THEN [reorders_checkpoint_2] ELSE 0 END)&#10;/ SUM([Cohort Customers (copy)_3877247465256046595])' />
      </column>
      <column caption='# Reorders Checkpoint 2 Control' datatype='real' name='[# Reorders Checkpoint 2 Test (copy)_3877247465284091920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(If [customer_group] = &apos;control&apos; THEN [reorders_checkpoint_2] ELSE 0 END)&#10;/ SUM([Cohort Customers Test (copy)_3877247465256128516])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.17yth810bgpil111fqo5a0a178pn].[sum:sum_redeemed_comp_eur_observation_period:qk]&quot;' value='€ Cost (Observation Period)' />
          <alias key='&quot;[federated.1ec0tdb0xuk2c813l8kwl03i71i0].[min:actuals_aov_l2m:qk]&quot;' value='€ Actuals AOV L2M' />
        </aliases>
      </column>
      <column caption='# Reorders Observation Period Test' datatype='integer' name='[Calculation_3877247465255759873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [customer_group] = &apos;test&apos; THEN [reorders_observation_period] ELSE 0 END' />
      </column>
      <column caption='Order Frequency Test' datatype='real' name='[Calculation_3877247465256202245]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3877247465255759873]) / SUM([Cohort Customers (copy)_3877247465256046595])' />
      </column>
      <column caption='# Actual Incremental Orders (8w)' datatype='real' name='[Calculation_3877247465256402951]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_3877247465256202245] - [Order Frequency Test (copy)_3877247465256284166])&#10;* SUM([Cohort Customers (copy)_3877247465256046595])' />
      </column>
      <column caption='Reorder Rate' datatype='real' name='[Calculation_3877247465257484298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reorder_customers]) / SUM([cohort_customers])' />
      </column>
      <column caption='€ GMV per Customer over Observation Period' datatype='real' name='[Calculation_3877247465257738251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_gmv_eur_observation_period])/ SUM([cohort_customers])' />
      </column>
      <column caption='€ Avg. Order Value' datatype='real' name='[Calculation_3877247465257971724]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_gmv_eur_observation_period]) / SUM([reorders_observation_period])' />
      </column>
      <column caption='Checkpoints Delta OF (slope)' datatype='real' name='[Calculation_3877247465284136977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([# Reorders Checkpoint 2 (copy)_3877247465284001807] - [# Reorders Checkpoint 2 Test (copy)_3877247465284091920])&#10;- ([# Reorders Checkpoint 1 (copy)_3877247465283809293] - [# Reorders Checkpoint 1 Test (copy)_3877247465283911694])' />
      </column>
      <column caption='Checkpoint Difference Y2' datatype='real' name='[Calculation_3877247465290498066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[# Reorders Checkpoint 2 (copy)_3877247465284001807] - [# Reorders Checkpoint 2 Test (copy)_3877247465284091920]' />
      </column>
      <column caption='Order Frequency Difference Slope' datatype='real' name='[Calculation_3877247465291264020]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_3877247465290498066] - [Checkpoint Difference Y2 (copy)_3877247465290649619]) / 2' />
      </column>
      <column caption='# Forecasted Incremental Orders (44w)' datatype='real' name='[Calculation_3877247465292410901]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF&#10;([Calculation_3877247465291264020]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;) &lt; 0&#10;THEN 0&#10;ELSE &#10;([Calculation_3877247465291264020]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;)&#10;END' />
      </column>
      <column caption='# Actual Test Orders (8w)' datatype='real' name='[Calculation_3877247465293217814]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3877247465256202245] * SUM([Cohort Customers (copy)_3877247465256046595])' />
      </column>
      <column caption='# Forecasted Test Orders (44w)' datatype='real' name='[Calculation_3877247465314074648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Order Frequency Difference Slope (copy)_3877247465313918999] * SUM([Cohort Customers (copy)_3877247465256046595]) * 44' />
      </column>
      <column caption='Profit ROI' datatype='real' name='[Calculation_3877247465316470812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[federated.1ec0tdb0xuk2c813l8kwl03i71i0].[Calculation_3877247465315819547] / &#10;SUM([sum_redeemed_comp_eur_observation_period])&#10;-1' />
      </column>
      <column caption='Avg. Incremental GMV' datatype='real' name='[Calculation_3877247465320603679]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([€ GMV Observation Period (copy)_3877247465320390685]) / SUM([Cohort Customers (copy)_3877247465256046595]))&#10;- (SUM([€ GMV Observation Period Test (copy)_3877247465320497182]) / SUM([Cohort Customers Test (copy)_3877247465256128516]))' />
      </column>
      <column caption='Marketing ROI' datatype='real' name='[Calculation_3877247465320845344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_3877247465320603679] * SUM([Cohort Customers (copy)_3877247465256046595]))&#10;/ SUM([sum_redeemed_comp_eur_observation_period])' />
      </column>
      <column caption='Is Profit ROI positive' datatype='boolean' name='[Calculation_3877247465322987553]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3877247465316470812] &gt; 0 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_525373095218610184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Checkpoint Difference Y1' datatype='real' name='[Checkpoint Difference Y2 (copy)_3877247465290649619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[# Reorders Checkpoint 1 (copy)_3877247465283809293] - [# Reorders Checkpoint 1 Test (copy)_3877247465283911694]' />
      </column>
      <column caption='# Cohort Customers Test' datatype='integer' name='[Cohort Customers (copy)_3877247465256046595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [customer_group] = &apos;test&apos; THEN [cohort_customers] ELSE 0 END' />
      </column>
      <column caption='# Cohort Customers Control' datatype='integer' name='[Cohort Customers Test (copy)_3877247465256128516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [customer_group] = &apos;control&apos; THEN [cohort_customers] ELSE 0 END' />
      </column>
      <column caption='Is Marketing ROI positive' datatype='boolean' name='[Is Profit ROI positive (copy)_3877247465323200546]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3877247465320845344] &gt; 0 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Order Frequency' datatype='real' name='[Order Frequency Control (copy)_3877247465257005065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reorders_observation_period]) / SUM([cohort_customers])' />
      </column>
      <column caption='Order Frequency Test Slope' datatype='real' name='[Order Frequency Difference Slope (copy)_3877247465313918999]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([# Reorders Checkpoint 2 (copy)_3877247465284001807] - [# Reorders Checkpoint 1 (copy)_3877247465283809293]) / 2' />
      </column>
      <column caption='Order Frequency Control' datatype='real' name='[Order Frequency Test (copy)_3877247465256284166]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Reorders Observation Period Test (copy)_3877247465255972866]) / SUM([Cohort Customers Test (copy)_3877247465256128516])' />
