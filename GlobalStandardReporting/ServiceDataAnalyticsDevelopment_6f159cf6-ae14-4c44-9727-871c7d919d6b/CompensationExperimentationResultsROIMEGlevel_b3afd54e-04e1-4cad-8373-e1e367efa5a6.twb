    <worksheet name='Profit Components'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Medium' italic='true'>Components</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='compensation_impact_experiment_week (rl_gcc_service)' name='federated.17yth810bgpil111fqo5a0a178pn' />
            <datasource caption='compensation_cohort_analysis (rl_gcc_service)' name='federated.1pnqs9m1x802n111p06yr06100jr' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Target Profit' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;7\%&quot;'>
              <calculation class='tableau' formula='&quot;7%&quot;' />
            </column>
            <column caption='Entity Granularity' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.17yth810bgpil111fqo5a0a178pn'>
            <column caption='# Actual Incremental Orders (8w) GEID' datatype='real' name='[# Actual Incremental Orders (8w) (copy)_6631761597670416394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [global_entity_id], [quarter] :&#10;([Calculation_3877247465256202245] - [Order Frequency Test (copy)_3877247465256284166])&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;}' />
            </column>
            <column caption='# Forecasted Incremental Orders (44w) GEID' datatype='real' name='[# Forecasted Incremental Orders (44w) (copy)_6631761597670592523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [quarter] :&#10;&#10;IF&#10;([Calculation_3877247465291264020]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;) &lt; 0&#10;THEN 0&#10;ELSE &#10;([Calculation_3877247465291264020]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;)&#10;END&#10;}' />
            </column>
            <column caption='# Order Frequency Checkpoint 2 Control' datatype='real' name='[# Order Frequency Checkpoint 1 Control (copy)_6631761597603303424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(If [customer_group] = &apos;control&apos; THEN [reorders_checkpoint_2] ELSE 0 END)&#10;/ SUM([Cohort Customers Test (copy)_3877247465256128516])' />
            </column>
            <column caption='# Order Frequency Checkpoint 2 Test' datatype='real' name='[# Order Frequency Checkpoint 1 Test (copy)_6631761597603311617]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(If [customer_group] = &apos;test&apos; THEN [reorders_checkpoint_2] ELSE 0 END)&#10;/ SUM([Cohort Customers (copy)_3877247465256046595])' />
            </column>
            <column caption='# Order Frequency Checkpoint 1 Test' datatype='real' name='[# Reorders Checkpoint 1 (copy)_3877247465283809293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(If [customer_group] = &apos;test&apos; THEN [reorders_checkpoint_1] ELSE 0 END)&#10;/ SUM([Cohort Customers (copy)_3877247465256046595])' />
            </column>
            <column caption='# Order Frequency Checkpoint 1 Control' datatype='real' name='[# Reorders Checkpoint 1 Test (copy)_3877247465283911694]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(If [customer_group] = &apos;control&apos; THEN [reorders_checkpoint_1] ELSE 0 END)&#10;/ SUM([Cohort Customers Test (copy)_3877247465256128516])' />
            </column>
            <column caption='# Reorders Checkpoint 2 Test' datatype='real' name='[# Reorders Checkpoint 2 (copy)_3877247465284001807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(If [customer_group] = &apos;test&apos; THEN [reorders_checkpoint_2] ELSE 0 END)&#10;/ SUM([Cohort Customers (copy)_3877247465256046595])' />
            </column>
            <column caption='Avg. Incremental GMV GEID' datatype='real' name='[Avg. Incremental GMV (copy)_6631761599105007642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [quarter], [global_entity_id] :&#10;(SUM([€ GMV Observation Period (copy)_3877247465320390685]) / SUM([Cohort Customers (copy)_3877247465256046595]))&#10;- (SUM([€ GMV Observation Period Test (copy)_3877247465320497182]) / SUM([Cohort Customers Test (copy)_3877247465256128516]))&#10;}' />
            </column>
            <column caption='# Reorders Observation Period Test' datatype='integer' name='[Calculation_3877247465255759873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [customer_group] = &apos;test&apos; THEN [reorders_observation_period] ELSE 0 END' />
            </column>
            <column caption='Order Frequency Test' datatype='real' name='[Calculation_3877247465256202245]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_3877247465255759873]) / SUM([Cohort Customers (copy)_3877247465256046595])' />
            </column>
            <column caption='€ Avg. Order Value' datatype='real' name='[Calculation_3877247465257971724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_gmv_eur_observation_period]) / SUM([reorders_observation_period])' />
            </column>
            <column caption='Checkpoint Difference Y2' datatype='real' name='[Calculation_3877247465290498066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Order Frequency Checkpoint 1 Test (copy)_6631761597603311617] - [# Order Frequency Checkpoint 1 Control (copy)_6631761597603303424]' />
            </column>
            <column caption='Order Frequency Difference Slope' datatype='real' name='[Calculation_3877247465291264020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_3877247465290498066] - [Checkpoint Difference Y2 (copy)_3877247465290649619]) / 2' />
            </column>
            <column caption='# Forecasted Incremental Orders (44w)' datatype='real' name='[Calculation_3877247465292410901]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF&#10;([Calculation_3877247465291264020]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;) &lt; 0&#10;THEN 0&#10;ELSE &#10;([Calculation_3877247465291264020]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;)&#10;END' />
            </column>
            <column caption='# Actual Test Orders (8w)' datatype='real' name='[Calculation_3877247465293217814]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3877247465256202245] * SUM([Cohort Customers (copy)_3877247465256046595])' />
            </column>
            <column caption='# Forecasted Test Orders (44w)' datatype='real' name='[Calculation_3877247465314074648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Order Frequency Difference Slope (copy)_3877247465313918999] * SUM([Cohort Customers (copy)_3877247465256046595]) * 44' />
            </column>
            <column caption='% Target Profit' datatype='real' name='[Calculation_6631761597666430984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;  WHEN &apos;5%&apos;&#10;    THEN 0.05&#10;  WHEN &apos;6%&apos;&#10;    THEN 0.06&#10;  WHEN &apos;7%&apos;&#10;    THEN 0.07&#10;  WHEN &apos;8%&apos;&#10;    THEN 0.08&#10;  WHEN &apos;9%&apos;&#10;    THEN 0.09&#10;  WHEN &apos;10%&apos;&#10;    THEN 0.1&#10;&#10;END' />
            </column>
            <column caption='€ Profit' datatype='real' name='[Calculation_6631761597667368969]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Incremental Orders Target Profit (copy)_6631761599112548382]&#10;&#10;&#10;+ IFNULL([Calculation_3877247465292410901],0) * [€ Avg. Order Value (copy)_6631761599114432543] * [Calculation_6631761597666430984]' />
            </column>
            <column caption='Entity Granularity' datatype='string' name='[Calculation_6631761599051235350]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Management Entity&apos; THEN [management_entity_group]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Global Entity Id&apos; THEN [global_entity_id]&#10;END' />
            </column>
            <column caption='Incremental Orders Target Profit' datatype='real' name='[Calculation_6631761599096475672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg. Incremental GMV (copy)_6631761599105007642]&#10; * [Calculation_6631761597666430984]' />
            </column>
            <column caption='Checkpoint Difference Y1' datatype='real' name='[Checkpoint Difference Y2 (copy)_3877247465290649619]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Reorders Checkpoint 1 (copy)_3877247465283809293] - [# Reorders Checkpoint 1 Test (copy)_3877247465283911694]' />
            </column>
            <column caption='# Cohort Customers Test' datatype='integer' name='[Cohort Customers (copy)_3877247465256046595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [customer_group] = &apos;test&apos; THEN [cohort_customers] ELSE 0 END' />
            </column>
            <column caption='# Cohort Customers Control' datatype='integer' name='[Cohort Customers Test (copy)_3877247465256128516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [customer_group] = &apos;control&apos; THEN [cohort_customers] ELSE 0 END' />
            </column>
            <column caption='Incremental Orders Profit' datatype='real' name='[Incremental Orders Target Profit (copy)_6631761599112548382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN([Calculation_6631761599096475672]) * SUM([Cohort Customers (copy)_3877247465256046595])' />
            </column>
            <column caption='Order Frequency Test Slope' datatype='real' name='[Order Frequency Difference Slope (copy)_3877247465313918999]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([# Reorders Checkpoint 2 (copy)_3877247465284001807] - [# Reorders Checkpoint 1 (copy)_3877247465283809293]) / 2' />
            </column>
            <column caption='Order Frequency Control' datatype='real' name='[Order Frequency Test (copy)_3877247465256284166]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Reorders Observation Period Test (copy)_3877247465255972866]) / SUM([Cohort Customers Test (copy)_3877247465256128516])' />
            </column>
            <column caption='Profit ROI (real AOV)' datatype='real' name='[Profit ROI (copy)_6631761597682597905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6631761597667368969] / &#10;SUM([sum_redeemed_comp_eur_observation_period])&#10;-1' />
            </column>
            <column caption='# Reorders Observation Period Control' datatype='integer' name='[Reorders Observation Period Test (copy)_3877247465255972866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [customer_group] = &apos;control&apos; THEN [reorders_observation_period] ELSE 0 END' />
