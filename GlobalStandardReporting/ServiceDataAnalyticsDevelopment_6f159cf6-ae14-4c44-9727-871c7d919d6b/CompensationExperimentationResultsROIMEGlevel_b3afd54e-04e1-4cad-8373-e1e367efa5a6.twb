          <datasource-dependencies datasource='federated.17yth810bgpil111fqo5a0a178pn'>
            <column caption='Avg. Incremental GMV' datatype='real' name='[Calculation_3877247465320603679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([€ GMV Observation Period (copy)_3877247465320390685]) / SUM([Cohort Customers (copy)_3877247465256046595]))&#10;- (SUM([€ GMV Observation Period Test (copy)_3877247465320497182]) / SUM([Cohort Customers Test (copy)_3877247465256128516]))' />
            </column>
            <column caption='Marketing ROI' datatype='real' name='[Calculation_3877247465320845344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_3877247465320603679] * SUM([Cohort Customers (copy)_3877247465256046595]))&#10;/ SUM([sum_redeemed_comp_eur_observation_period])' />
            </column>
            <column caption='Entity Granularity' datatype='string' name='[Calculation_6631761599051235350]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Management Entity&apos; THEN [management_entity_group]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Global Entity Id&apos; THEN [global_entity_id]&#10;END' />
