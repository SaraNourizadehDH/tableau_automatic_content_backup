      <aliases enabled='yes' />
      <column caption='% Redemptions' datatype='real' name='[% Seamless Orders (copy) (copy)_3892658213230592002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_redeemed_compensation_orders]) / SUM([count_compensated_orders]) * 100' />
      </column>
      <column caption='% Compensated Orders' datatype='real' name='[% Seamless Orders (copy)_3892658213230583809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_compensated_orders]) / SUM([Calculation_2250885042458046464]) * 100' />
      </column>
      <column caption='Checkpoint 1' datatype='real' name='[Avg Order Frequency (copy)_2540733914642198533]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(ZN([Avg Order Frequency (cumulative orders / cohort size) (copy)_2540733914640244738]),4)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg Order Frequency' datatype='real' name='[Avg Order Frequency (cumulative orders / cohort size) (copy)_2540733914640244738]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM([Avg. Orders per Customer (copy)_2540733914625966080])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cumulative orders / cohort size' datatype='real' name='[Avg. Orders per Customer (copy)_2540733914625966080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_reorders]) / SUM([Count Customers (copy)_2540733914626953217])&#10;&#10;// chose if only reorders or all orders' />
      </column>
      <column caption='All Orders' datatype='integer' name='[Calculation_2250885042458046464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Count Reference Orders (copy)_3133168370754555905] + [count_reorders]' />
      </column>
      <column caption='Cohort KPI' datatype='real' name='[Calculation_2250885042458337281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;# Orders&apos; THEN SUM([Calculation_2250885042458046464])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;# Customers with Orders&apos; THEN SUM([count_customers])&#10;// ELSEIF [Parameters].[Cohort KPI] = &apos;Order Frequency&apos; THEN [Order Frequency to Date]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Avg. Orders per Customer&apos;  THEN [Calculation_3877247467407200291]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Avg. Order Value&apos;  THEN [Calculation_3892658213230350336]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% Seamless Orders&apos; THEN [Calculation_2250885042458853378]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% Compensated Orders&apos; THEN [% Seamless Orders (copy)_3892658213230583809]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;# Compensated Orders&apos; THEN SUM([count_compensated_orders])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% Redemptions&apos; THEN [% Seamless Orders (copy) (copy)_3892658213230592002]&#10;END' />
      </column>
      <column caption='% Seamless Orders' datatype='real' name='[Calculation_2250885042458853378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_seamless_orders]) / SUM([Calculation_2250885042458046464]) * 100' />
      </column>
      <column caption='regression - denominator' datatype='real' name='[Calculation_2540733914644185094]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([week_in_cohort]^2)*COUNT([week_in_cohort])-(SUM([week_in_cohort])*SUM([week_in_cohort]))' />
      </column>
      <column caption='Is under 8 weeks in cohort' datatype='boolean' name='[Calculation_3133168370754822146]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [week_in_cohort] &lt; 8 THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Avg. Orders per Customer' datatype='real' name='[Calculation_3877247467407200291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2250885042458046464]) / SUM([count_customers])' />
      </column>
      <column caption='Avg. Order Value' datatype='real' name='[Calculation_3892658213230350336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sum_gmv_eur]) / sum([Calculation_2250885042458046464])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_525373095218610184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Cumulative KPI' datatype='real' name='[Cohort KPI (copy)_658370006829776896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Cohort KPI (copy)_658370006830690307] = &apos;# Reorders&apos; THEN SUM([count_reorders])&#10;ELSEIF [Parameters].[Cohort KPI (copy)_658370006830690307] = &apos;Avg. Orders per Customer&apos; THEN [Calculation_3877247467407200291]&#10;ELSEIF [Parameters].[Cohort KPI (copy)_658370006830690307] = &apos;# Seamless Orders&apos; THEN SUM([count_seamless_orders])&#10;ELSEIF [Parameters].[Cohort KPI (copy)_658370006830690307] = &apos;# Compensated Orders&apos; THEN SUM([count_compensated_orders])&#10;END' />
      </column>
      <column caption='Initial Size of the Cohort (=Customers count week 0 on cohort level)' datatype='integer' name='[Count Customers (copy)_2540733914626953217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id], [customer_group], [policy], [customer_cohort]: MAX([count_customers])}&#10;//' />
