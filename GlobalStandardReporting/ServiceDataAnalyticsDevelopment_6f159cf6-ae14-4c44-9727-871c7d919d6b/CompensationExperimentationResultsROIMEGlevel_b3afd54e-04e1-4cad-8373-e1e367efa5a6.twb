      <aliases enabled='yes' />
      <column caption='# Actual Incremental Orders (8w) GEID' datatype='real' name='[# Actual Incremental Orders (8w) (copy)_6631761597670416394]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED  [global_entity_id], [quarter] :&#10;([Calculation_3877247465256202245] - [Order Frequency Test (copy)_3877247465256284166])&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;}' />
      </column>
      <column caption='# Forecasted Incremental Orders (44w) GEID' datatype='real' name='[# Forecasted Incremental Orders (44w) (copy)_6631761597670592523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [quarter] :&#10;&#10;IF&#10;([Calculation_3877247465291264020]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;) &lt; 0&#10;THEN 0&#10;ELSE &#10;([Calculation_3877247465291264020]&#10;* SUM([Cohort Customers (copy)_3877247465256046595])&#10;* 44 // duration of year - duration of observation period (8w)&#10;)&#10;END&#10;}' />
      </column>
      <column caption='# Order Frequency Checkpoint 2 Control' datatype='real' name='[# Order Frequency Checkpoint 1 Control (copy)_6631761597603303424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(If [customer_group] = &apos;control&apos; THEN [reorders_checkpoint_2] ELSE 0 END)&#10;/ SUM([Cohort Customers Test (copy)_3877247465256128516])' />
      </column>
      <column caption='# Order Frequency Checkpoint 2 Test' datatype='real' name='[# Order Frequency Checkpoint 1 Test (copy)_6631761597603311617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(If [customer_group] = &apos;test&apos; THEN [reorders_checkpoint_2] ELSE 0 END)&#10;/ SUM([Cohort Customers (copy)_3877247465256046595])' />
