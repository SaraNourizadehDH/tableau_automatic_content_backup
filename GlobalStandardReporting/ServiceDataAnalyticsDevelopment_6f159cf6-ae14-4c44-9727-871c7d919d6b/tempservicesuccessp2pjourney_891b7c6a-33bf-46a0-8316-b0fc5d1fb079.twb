      <column caption='30 day reorder rate' datatype='real' name='[7 day reorder rate (copy) (copy)_2852678532006920202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reorders_30_day])/SUM([total_orders])' />
      </column>
