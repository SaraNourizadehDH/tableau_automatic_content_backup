        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0agucmm0quhxdv1599nz005aggr9' name='Custom SQL Query' type='text'>SELECT 
  FORMAT_DATE(&apos;%G-%V&apos;, p.order_date) AS week
  , FORMAT_DATE(&apos;%Y-%m&apos;, p.order_date) AS month
  , cc.management_entity_group
  , cc.common_name AS country
  , cc.brand
  , p.is_p2p_chat_served
  , p.has_agent_chat
  , COUNT(DISTINCT order_id) total_orders 
  , COUNT(DISTINCT CASE WHEN p.has_reorder_7_days IS TRUE THEN order_id END) AS reorders_7_day
  , COUNT(DISTINCT CASE WHEN p.has_reorder_14_days IS TRUE THEN order_id END) AS reorders_14_day
  , COUNT(DISTINCT CASE WHEN p.has_reorder_30_days IS TRUE THEN order_id END) AS reorders_30_day
FROM `logistics-data-storage-staging.sandbox_rutuja.user_journey_p2p_chat_dataset` p
LEFT JOIN `fulfillment-dwh-production.cl_gcc_service.countries` cc 
  ON p.global_entity_id = cc.global_entity_id
WHERE has_reorder_7_days IS NOT NULL
GROUP BY 1,2,3,4,5,6, 7
ORDER BY 1, 6 DESC</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0agucmm0quhxdv1599nz005aggr9' name='Custom SQL Query' type='text'>SELECT 
  FORMAT_DATE(&apos;%G-%V&apos;, p.order_date) AS week
