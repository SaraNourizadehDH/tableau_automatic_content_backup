            <column aggregation='Attribute' caption='% Seamless Sessions Current' datatype='real' name='[Deflection rate Current (copy)_640214839339683844]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [sessions_seamless]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [sessions_resolution_page_reached]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [sessions_seamless]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [sessions_resolution_page_reached]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [sessions_seamless]&#10;    ELSE 0 END&#10;    )&#10;&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [sessions_resolution_page_reached]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;end' />
