              <calculation class='tableau' formula='IF [Calculation_604537941450858509] &lt; 0&#13;&#10;THEN &quot;▼&quot;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='Sessions Multiple Leaves Visited Positive % Diff' datatype='string' name='[Self-service rate Positive % Diff (copy)_604537941451362319]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_604537941450858509] &gt; 0&#13;&#10;THEN &quot;▲&quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
