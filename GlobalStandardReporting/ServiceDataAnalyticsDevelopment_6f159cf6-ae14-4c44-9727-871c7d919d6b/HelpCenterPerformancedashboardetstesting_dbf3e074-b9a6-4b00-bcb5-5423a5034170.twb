      <table>
        <view>
          <datasources>
            <datasource caption='helpcenter_performance_v2 (rl_gcc_service)' name='federated.02bkitl1pw2xn511wpal70fzb11v' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.02bkitl1pw2xn511wpal70fzb11v'>
            <column caption='Deflection rate' datatype='real' name='[Calculation_242350015077761028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_deflected])/SUM([sessions_resolution_page_reached])' />
            </column>
            <column caption='Deflection rate % chg' datatype='real' name='[Calculation_604537941448466440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Self-service rate current (copy)_604537941447983110]) - SUM([Deflection rate current (copy)_604537941448286215]))/&#10;SUM([Deflection rate current (copy)_604537941448286215])' />
            </column>
            <column caption='is_max_week' datatype='boolean' name='[Calculation_672443783518289922]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [week]: MAX([date])} = {FIXED: MAX([date])}' />
            </column>
            <column caption='Date ' datatype='string' name='[Calculation_905786523632222210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Day&quot; THEN STR([date])&#13;&#10;WHEN &quot;Week&quot; THEN [week]&#13;&#10;WHEN &quot;Month&quot; THEN [month]&#13;&#10;END' />
            </column>
            <column caption='Date Range' datatype='date' name='[Date (copy)_4079416897935040523]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[date]' />
            </column>
            <column aggregation='Attribute' caption='Deflection rate Previous' datatype='real' name='[Deflection rate current (copy)_604537941448286215]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [sessions_deflected]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [sessions_resolution_page_reached]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [sessions_deflected]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [sessions_resolution_page_reached]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [sessions_deflected]&#10;    ELSE 0 END&#10;    )&#10;&#10;    /&#10;     SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [sessions_resolution_page_reached]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;end' />
            </column>
            <column caption='Deflection rate Negative % Diff' datatype='string' name='[Self-service rate Negative % Diff (copy)_604537941448876041]' role='measure' type='nominal'>
