      <column caption='Self-service CSAT Negative % Diff ' datatype='string' name='[% Active Sessions Negative % Diff  (copy)_352899259486584854]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_593138204842291203] &lt; 0&#13;&#10;THEN &quot;▼&quot;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='Self-service CSAT Positive % Diff ' datatype='string' name='[% Active Sessions Positive % Diff (copy)_352899259486683159]' role='measure' type='nominal'>
