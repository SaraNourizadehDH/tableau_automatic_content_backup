            </column>
            <column caption='MBR_Self-service rate chg4wk' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Self-service rate % chg (copy)_966585075940265989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Self-service rate current (copy)_1196268657548656642]-[Self-service rate previous (copy)_966585075937570817]' />
