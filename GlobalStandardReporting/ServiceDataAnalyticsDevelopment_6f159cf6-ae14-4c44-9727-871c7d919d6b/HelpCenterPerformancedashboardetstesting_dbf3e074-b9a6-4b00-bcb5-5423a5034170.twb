          <datasource-dependencies datasource='federated.02bkitl1pw2xn511wpal70fzb11v'>
            <column caption='HC index' datatype='real' name='[Calculation_242350015076208642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0.5*((SUM([sessions_deflected])+SUM([sessions_automated]))/SUM([sessions_resolution_page_reached]))+&#10;0.5*(SUM([count_ss_csat_4_5_resolution_sessions])/SUM([count_ss_responses_resolution_sessions]))' />
            </column>
            <column aggregation='Attribute' caption='HC index current' datatype='real' name='[Calculation_242350015105675284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;{ EXCLUDE [Calculation_905786523632222210]:&#10;    0.5*((SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [sessions_deflected]&#10;    ELSE 0 END&#10;    )&#10;+ &#10; SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [sessions_automated]&#10;    ELSE 0 END&#10;    ))&#10;&#10;/ SUM(IF [Calculation_672443783518289922]&#10;    THEN [sessions_resolution_page_reached]&#10;    ELSE 0 END&#10;    ))&#10;+&#10;0.5*(SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [count_ss_csat_4_5_resolution_sessions]&#10;    ELSE 0 END&#10;    )&#10;&#10;/ SUM(IF [Calculation_672443783518289922]&#10;    THEN [count_ss_responses_resolution_sessions]&#10;    ELSE 0 END&#10;    ))&#10;&#10;}&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;{ EXCLUDE [Calculation_905786523632222210]:&#10;    0.5*((SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [sessions_deflected]&#10;    ELSE 0 END&#10;    )&#10;+ &#10; SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [sessions_automated]&#10;    ELSE 0 END&#10;    ))&#10;&#10;/ SUM(IF [is_max_month (copy)_352899259462545410]&#10;    THEN [sessions_resolution_page_reached]&#10;    ELSE 0 END&#10;    ))&#10;+&#10;0.5*(SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [count_ss_csat_4_5_resolution_sessions]&#10;    ELSE 0 END&#10;    )&#10;&#10;/ SUM(IF [is_max_month (copy)_352899259462545410]&#10;    THEN [count_ss_responses_resolution_sessions]&#10;    ELSE 0 END&#10;    ))&#10;&#10;}&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;{ EXCLUDE [Calculation_905786523632222210]:&#10;    0.5*((SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [sessions_deflected]&#10;    ELSE 0 END&#10;    )&#10;+ &#10; SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [sessions_automated]&#10;    ELSE 0 END&#10;    ))&#10;&#10;/ SUM(IF [is_max_week (copy)_352899259461615616]&#10;    THEN [sessions_resolution_page_reached]&#10;    ELSE 0 END&#10;    ))&#10;+&#10;0.5*(SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [count_ss_csat_4_5_resolution_sessions]&#10;    ELSE 0 END&#10;    )&#10;&#10;/ SUM(IF [is_max_week (copy)_352899259461615616]&#10;    THEN [count_ss_responses_resolution_sessions]&#10;    ELSE 0 END&#10;    ))&#10;&#10;}&#10;end' />
            </column>
            <column caption='HC index % chg' datatype='real' name='[Calculation_242350015111041047]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_242350015105675284])-SUM([HC index current (copy)_242350015110500373]))/SUM([HC index current (copy)_242350015110500373])' />
            </column>
            <column caption='HC Index Negative % Diff' datatype='string' name='[Calculation_242350015111241752]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_242350015111041047] &lt; 0&#10;THEN &quot;▼&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='is_max_week' datatype='boolean' name='[Calculation_672443783518289922]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [week]: MAX([date])} = {FIXED: MAX([date])}' />
            </column>
            <column caption='Date ' datatype='string' name='[Calculation_905786523632222210]' role='dimension' type='nominal'>
