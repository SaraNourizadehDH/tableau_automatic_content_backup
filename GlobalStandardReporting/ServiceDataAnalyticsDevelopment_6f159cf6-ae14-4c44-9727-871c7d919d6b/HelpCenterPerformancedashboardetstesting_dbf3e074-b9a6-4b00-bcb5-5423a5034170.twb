          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension 2' datatype='string' name='[Dimension 1 (copy)_554646451864190976]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total&quot;'>
              <calculation class='tableau' formula='&quot;Total&quot;' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.02bkitl1pw2xn511wpal70fzb11v'>
            <column caption='Self-service rate' datatype='real' name='[Calculation_242350015074242560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([sessions_deflected])+SUM([sessions_automated]))/SUM([sessions_resolution_page_reached])' />
            </column>
            <column caption='Self-service CSAT' datatype='real' name='[Calculation_242350015074979841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_ss_csat_4_5_resolution_sessions])/SUM([count_ss_responses_resolution_sessions])' />
            </column>
            <column caption='HC index' datatype='real' name='[Calculation_242350015076208642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0.5*((SUM([sessions_deflected])+SUM([sessions_automated]))/SUM([sessions_resolution_page_reached]))+&#10;0.5*(SUM([count_ss_csat_4_5_resolution_sessions])/SUM([count_ss_responses_resolution_sessions]))' />
            </column>
            <column caption='% Sessions Multiple Leaves Visited' datatype='real' name='[Calculation_242350015077523459]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_multiple_leaves_visited])/SUM([sessions_leaf_reached])' />
            </column>
            <column caption='Deflection rate' datatype='real' name='[Calculation_242350015077761028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_deflected])/SUM([sessions_resolution_page_reached])' />
            </column>
            <column caption='Automation rate' datatype='real' name='[Calculation_242350015078002693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_automated])/SUM([sessions_resolution_page_reached])' />
            </column>
            <column caption='% Issues through HC' datatype='real' name='[Calculation_242350015078113286]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([helpcenter_contacts])/SUM([all_contacts])' />
            </column>
            <column caption='Automation CSAT' datatype='real' name='[Calculation_242350015078273031]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_ss_csat_4_5_automated_sessions])/SUM([count_ss_responses_automated_sessions])' />
            </column>
            <column caption='% Active sessions' datatype='real' name='[Calculation_242350015078531080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_active])/SUM([sessions])' />
            </column>
            <column caption='Active sessions per order' datatype='real' name='[Calculation_242350015078617097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_active])/SUM([gross_orders])' />
            </column>
            <column caption='Active sessions per unique visitor' datatype='real' name='[Calculation_242350015078752266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_active])/SUM([unique_stakeholders_daily])' />
            </column>
            <column caption='Unique visitors per order' datatype='real' name='[Calculation_242350015078940683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unique_stakeholders_daily])/SUM([gross_orders])' />
            </column>
            <column caption='Chat contact rate (HC)' datatype='real' name='[Calculation_242350015079006220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_chat_created])/SUM([sessions_resolution_page_reached])' />
            </column>
            <column caption='After-Contact CSAT' datatype='real' name='[Calculation_242350015079157773]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_ac_csat_4_5])/SUM([count_ac_responses])' />
            </column>
            <column caption='After-Contact CSAT RR' datatype='real' name='[Calculation_242350015079268366]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_ac_responses])/SUM([sessions_contact_created])' />
            </column>
            <column caption='Self-service CSAT RR' datatype='real' name='[Calculation_242350015079530511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_ss_responses_resolution_sessions])/(SUM([sessions_deflected]) + SUM([sessions_automated]))' />
            </column>
            <column caption='Contact rate' datatype='real' name='[Calculation_242350015079809040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([contacts_created])/SUM([gross_orders])' />
            </column>
            <column caption='Avg leaf visit rate' datatype='real' name='[Calculation_242350015079927825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([leaves_visited])/SUM([sessions_leaf_reached])' />
            </column>
            <column caption='Avg contacts per sessions with contact' datatype='real' name='[Calculation_242350015079997458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([contacts_created])/SUM([sessions_contact_created])' />
            </column>
            <column caption='Avg contacts per active sessions' datatype='real' name='[Calculation_242350015080165395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([contacts_created])/SUM([sessions_active])' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Calculation_637892676227432448]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10; WHEN &apos;Total&apos; then &apos;Total&apos;&#10; WHEN &apos;Management Entity&apos; then [management_entity]&#10; WHEN &apos;Brand&apos; then [brand]&#10; WHEN &apos;Country&apos; then [country]&#10; WHEN &apos;Contact Center&apos; then [contact_center]&#10; WHEN &apos;Vertical&apos; then [vertical]&#10; WHEN &apos;Delivery Type&apos; then [delivery_type]&#10; WHEN &apos;App Version&apos; then [app_version]&#10;END' />
            </column>
            <column caption='Date ' datatype='string' name='[Calculation_905786523632222210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Day&quot; THEN STR([date])&#13;&#10;WHEN &quot;Week&quot; THEN [week]&#13;&#10;WHEN &quot;Month&quot; THEN [month]&#13;&#10;END' />
            </column>
            <column caption='Date Range' datatype='date' name='[Date (copy)_4079416897935040523]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[date]' />
