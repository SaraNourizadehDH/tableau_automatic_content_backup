      <column aggregation='Attribute' caption='Automation CSAT Previous' datatype='real' name='[Automation CSAT Current (copy)_4079416897926111239]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [count_ss_csat_4_5_automated_sessions]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [count_ss_responses_automated_sessions]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [count_ss_csat_4_5_automated_sessions]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [count_ss_responses_automated_sessions]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [count_ss_csat_4_5_automated_sessions]&#10;    ELSE 0 END&#10;    )&#10;&#10;    /&#10;     SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [count_ss_responses_automated_sessions]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;end' />
      </column>
      <column caption='Automation CSAT % Chg' datatype='real' name='[Automation rate % Chg (copy)_4079416897926479880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Automation rate Current (copy)_4079416897925865478])-SUM([Automation CSAT Current (copy)_4079416897926111239]))/SUM([Automation CSAT Current (copy)_4079416897926111239])' />
      </column>
      <column aggregation='Attribute' caption='Automation rate Previous' datatype='real' name='[Automation rate Current (copy)_4079416897923969025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [sessions_automated]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [sessions_resolution_page_reached]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [sessions_automated]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [sessions_resolution_page_reached]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [sessions_automated]&#10;    ELSE 0 END&#10;    )&#10;&#10;    /&#10;     SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [sessions_resolution_page_reached]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;end' />
      </column>
      <column aggregation='Attribute' caption='Automation CSAT Current' datatype='real' name='[Automation rate Current (copy)_4079416897925865478]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [count_ss_csat_4_5_automated_sessions]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [count_ss_responses_automated_sessions]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [count_ss_csat_4_5_automated_sessions]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [count_ss_responses_automated_sessions]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [count_ss_csat_4_5_automated_sessions]&#10;    ELSE 0 END&#10;    )&#10;&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [count_ss_responses_automated_sessions]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;end' />
      </column>
      <column caption='Automation CSAT Negative % Diff' datatype='string' name='[Automation rate Negative % Diff (copy)_4079416897926836233]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Automation rate % Chg (copy)_4079416897926479880] &lt; 0&#13;&#10;THEN &quot;▼&quot;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='Automation CSAT Positive % Diff' datatype='string' name='[Automation rate Positive % Diff (copy)_4079416897926918154]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Automation rate % Chg (copy)_4079416897926479880] &gt; 0&#13;&#10;THEN &quot;▲&quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='Self-service rate' datatype='real' name='[Calculation_242350015074242560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([sessions_deflected])+SUM([sessions_automated]))/SUM([sessions_resolution_page_reached])' />
      </column>
      <column caption='Self-service CSAT' datatype='real' name='[Calculation_242350015074979841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_ss_csat_4_5_resolution_sessions])/SUM([count_ss_responses_resolution_sessions])' />
      </column>
      <column caption='HC index' datatype='real' name='[Calculation_242350015076208642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.5*((SUM([sessions_deflected])+SUM([sessions_automated]))/SUM([sessions_resolution_page_reached]))+&#10;0.5*(SUM([count_ss_csat_4_5_resolution_sessions])/SUM([count_ss_responses_resolution_sessions]))' />
      </column>
      <column caption='% Sessions Multiple Leaves Visited' datatype='real' name='[Calculation_242350015077523459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions_multiple_leaves_visited])/SUM([sessions_leaf_reached])' />
      </column>
      <column caption='Deflection rate' datatype='real' name='[Calculation_242350015077761028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions_deflected])/SUM([sessions_resolution_page_reached])' />
      </column>
      <column caption='Automation rate' datatype='real' name='[Calculation_242350015078002693]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions_automated])/SUM([sessions_resolution_page_reached])' />
      </column>
      <column caption='% Issues through HC' datatype='real' name='[Calculation_242350015078113286]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([helpcenter_contacts])/SUM([all_contacts])' />
      </column>
      <column caption='Automation CSAT' datatype='real' name='[Calculation_242350015078273031]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_ss_csat_4_5_automated_sessions])/SUM([count_ss_responses_automated_sessions])' />
      </column>
      <column caption='% Active sessions' datatype='real' name='[Calculation_242350015078531080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions_active])/SUM([sessions])' />
      </column>
      <column caption='Active sessions per order' datatype='real' name='[Calculation_242350015078617097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions_active])/SUM([gross_orders])' />
      </column>
      <column caption='Active sessions per unique visitor' datatype='real' name='[Calculation_242350015078752266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions_active])/SUM([unique_stakeholders_daily])' />
      </column>
      <column caption='Unique visitors per order' datatype='real' name='[Calculation_242350015078940683]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unique_stakeholders_daily])/SUM([gross_orders])' />
      </column>
      <column caption='Chat contact rate (HC)' datatype='real' name='[Calculation_242350015079006220]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions_chat_created])/SUM([sessions_resolution_page_reached])' />
      </column>
      <column caption='After-Contact CSAT' datatype='real' name='[Calculation_242350015079157773]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_ac_csat_4_5])/SUM([count_ac_responses])' />
      </column>
      <column caption='After-Contact CSAT RR' datatype='real' name='[Calculation_242350015079268366]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_ac_responses])/SUM([sessions_contact_created])' />
      </column>
      <column caption='Self-service CSAT RR' datatype='real' name='[Calculation_242350015079530511]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_ss_responses_resolution_sessions])/(SUM([sessions_deflected]) + SUM([sessions_automated]))' />
      </column>
      <column caption='Contact rate' datatype='real' name='[Calculation_242350015079809040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([contacts_created])/SUM([gross_orders])' />
      </column>
      <column caption='Avg leaf visit rate' datatype='real' name='[Calculation_242350015079927825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([leaves_visited])/SUM([sessions_leaf_reached])' />
      </column>
      <column caption='Avg contacts per sessions with contact' datatype='real' name='[Calculation_242350015079997458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([contacts_created])/SUM([sessions_contact_created])' />
      </column>
      <column caption='Avg contacts per active sessions' datatype='real' name='[Calculation_242350015080165395]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([contacts_created])/SUM([sessions_active])' />
      </column>
      <column aggregation='Attribute' caption='HC index current' datatype='real' name='[Calculation_242350015105675284]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;{ EXCLUDE [Calculation_905786523632222210]:&#10;    0.5*((SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [sessions_deflected]&#10;    ELSE 0 END&#10;    )&#10;+ &#10; SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [sessions_automated]&#10;    ELSE 0 END&#10;    ))&#10;&#10;/ SUM(IF [Calculation_672443783518289922]&#10;    THEN [sessions_resolution_page_reached]&#10;    ELSE 0 END&#10;    ))&#10;+&#10;0.5*(SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [count_ss_csat_4_5_resolution_sessions]&#10;    ELSE 0 END&#10;    )&#10;&#10;/ SUM(IF [Calculation_672443783518289922]&#10;    THEN [count_ss_responses_resolution_sessions]&#10;    ELSE 0 END&#10;    ))&#10;&#10;}&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;{ EXCLUDE [Calculation_905786523632222210]:&#10;    0.5*((SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [sessions_deflected]&#10;    ELSE 0 END&#10;    )&#10;+ &#10; SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [sessions_automated]&#10;    ELSE 0 END&#10;    ))&#10;&#10;/ SUM(IF [is_max_month (copy)_352899259462545410]&#10;    THEN [sessions_resolution_page_reached]&#10;    ELSE 0 END&#10;    ))&#10;+&#10;0.5*(SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [count_ss_csat_4_5_resolution_sessions]&#10;    ELSE 0 END&#10;    )&#10;&#10;/ SUM(IF [is_max_month (copy)_352899259462545410]&#10;    THEN [count_ss_responses_resolution_sessions]&#10;    ELSE 0 END&#10;    ))&#10;&#10;}&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;{ EXCLUDE [Calculation_905786523632222210]:&#10;    0.5*((SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [sessions_deflected]&#10;    ELSE 0 END&#10;    )&#10;+ &#10; SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [sessions_automated]&#10;    ELSE 0 END&#10;    ))&#10;&#10;/ SUM(IF [is_max_week (copy)_352899259461615616]&#10;    THEN [sessions_resolution_page_reached]&#10;    ELSE 0 END&#10;    ))&#10;+&#10;0.5*(SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [count_ss_csat_4_5_resolution_sessions]&#10;    ELSE 0 END&#10;    )&#10;&#10;/ SUM(IF [is_max_week (copy)_352899259461615616]&#10;    THEN [count_ss_responses_resolution_sessions]&#10;    ELSE 0 END&#10;    ))&#10;&#10;}&#10;end' />
      </column>
      <column caption='HC index % chg' datatype='real' name='[Calculation_242350015111041047]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_242350015105675284])-SUM([HC index current (copy)_242350015110500373]))/SUM([HC index current (copy)_242350015110500373])' />
      </column>
      <column caption='HC Index Negative % Diff' datatype='string' name='[Calculation_242350015111241752]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_242350015111041047] &lt; 0&#10;THEN &quot;▼&quot;&#10;ELSE &apos;&apos;&#10;END' />
      </column>
      <column caption='Automation rate % Chg' datatype='real' name='[Calculation_4079416897924206594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Deflection rate Current (copy)_4079416897923801088])-SUM([Automation rate Current (copy)_4079416897923969025]))/SUM([Automation rate Current (copy)_4079416897923969025])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_4079416897986650124]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Numerator' datatype='integer' name='[Calculation_4079416898008281103]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;Contacts Created&apos;&#10;then [contacts_created]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Chats Created&apos;&#10;then [chats_created]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Active Sessions&apos;&#10;then [sessions_active]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Cases Created&apos;&#10;then [cases_created]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Valid Chats&apos;&#10;then [valid_chats]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Valid Contacts&apos;&#10;then [valid_contacts_created]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Unique Visitors&apos;&#10;then [unique_stakeholders_daily]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Sessions Leaf Reached&apos;&#10;then [sessions_leaf_reached]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Deflected Sessions&apos;&#10;then [sessions_deflected]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Automated Sessions&apos;&#10;then [sessions_automated]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Sessions with Multiple Leaves Visited&apos;&#10;then [sessions_multiple_leaves_visited]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Leaves Visited&apos;&#10;then [leaves_visited]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Sessions with Orders&apos;&#10;then [sessions_with_order]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Sessions Resolution Page Visited&apos;&#10;then [sessions_resolution_page_reached]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;HC Active Sessions + Contacts Created&apos;&#10;then [Calculation_472174336448868352]&#10;END' />
      </column>
      <column caption='Custom Metric' datatype='real' name='[Calculation_4079416898010177553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4079416898008281103])/SUM([Numerator (copy)_4079416898009600016])' />
      </column>
      <column caption='HC Active Sessions + Contacts Created' datatype='integer' name='[Calculation_472174336448868352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[sessions_active] + [contacts_created]' />
      </column>
      <column aggregation='Attribute' caption='Self-service CSAT current' datatype='real' name='[Calculation_593138204841836545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [count_ss_csat_4_5_resolution_sessions]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [count_ss_responses_resolution_sessions]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [count_ss_csat_4_5_resolution_sessions]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [count_ss_responses_resolution_sessions]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;  {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [count_ss_csat_4_5_resolution_sessions]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [count_ss_responses_resolution_sessions]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;end' />
      </column>
      <column caption='Self-service CSAT % chg' datatype='real' name='[Calculation_593138204842291203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_593138204841836545])-SUM([Self-service CSAT current (copy)_593138204842172418]))/SUM([Self-service CSAT current (copy)_593138204842172418])' />
      </column>
      <column caption='Deflection rate % chg' datatype='real' name='[Calculation_604537941448466440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Self-service rate current (copy)_604537941447983110]) - SUM([Deflection rate current (copy)_604537941448286215]))/&#10;SUM([Deflection rate current (copy)_604537941448286215])' />
      </column>
      <column caption='Sessions Multiple Leaves Visited % Chg' datatype='real' name='[Calculation_604537941450858509]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Deflection rate Current (copy)_604537941450485771]) - SUM([Sessions Multiple Leaves Visited Current (copy)_604537941450731532]))/&#10;SUM([Sessions Multiple Leaves Visited Current (copy)_604537941450731532])' />
      </column>
      <column caption='Dimension 1' datatype='string' name='[Calculation_637892676227432448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10; WHEN &apos;Total&apos; then &apos;Total&apos;&#10; WHEN &apos;Management Entity&apos; then [management_entity]&#10; WHEN &apos;Brand&apos; then [brand]&#10; WHEN &apos;Country&apos; then [country]&#10; WHEN &apos;Contact Center&apos; then [contact_center]&#10; WHEN &apos;Vertical&apos; then [vertical]&#10; WHEN &apos;Delivery Type&apos; then [delivery_type]&#10; WHEN &apos;App Version&apos; then [app_version]&#10;END' />
      </column>
      <column caption='is_max_week' datatype='boolean' name='[Calculation_672443783518289922]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [week]: MAX([date])} = {FIXED: MAX([date])}' />
      </column>
      <column caption='Date ' datatype='string' name='[Calculation_905786523632222210]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Day&quot; THEN STR([date])&#13;&#10;WHEN &quot;Week&quot; THEN [week]&#13;&#10;WHEN &quot;Month&quot; THEN [month]&#13;&#10;END' />
      </column>
      <column caption='Date Range' datatype='date' name='[Date (copy)_4079416897935040523]' role='dimension' type='ordinal'>
