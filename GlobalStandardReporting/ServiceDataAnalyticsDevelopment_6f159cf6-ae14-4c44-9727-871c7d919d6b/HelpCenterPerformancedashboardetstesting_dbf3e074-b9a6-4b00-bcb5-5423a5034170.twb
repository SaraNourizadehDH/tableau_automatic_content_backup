            <column-instance column='[Calculation_242350015074979841]' derivation='User' name='[usr:Calculation_242350015074979841:qk]' pivot='key' type='quantitative' />
            <column-instance column='[MBR_Self-service CSAT 4wk (copy)_1196268657631928327]' derivation='User' name='[usr:MBR_Self-service CSAT 4wk (copy)_1196268657631928327:qk]' pivot='key' type='quantitative' />
            <column-instance column='[MBR_Self-service rate 4wk (copy)_1196268657631707142]' derivation='User' name='[usr:MBR_Self-service rate 4wk (copy)_1196268657631707142:qk]' pivot='key' type='quantitative' />
            <column-instance column='[MBR_Self-service rate reporting week (copy)_1196268657631354885]' derivation='User' name='[usr:MBR_Self-service rate reporting week (copy)_1196268657631354885:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[version]' role='dimension' type='nominal' />
            <column caption='Week' datatype='string' name='[week]' role='dimension' type='nominal' />
