    <worksheet name='MBR_CSAT'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Tableau Book' fontsize='18'>Self-service rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='helpcenter_performance_v2 (rl_gcc_service)' name='federated.02bkitl1pw2xn511wpal70fzb11v' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.02bkitl1pw2xn511wpal70fzb11v'>
            <column caption='Self-service CSAT' datatype='real' name='[Calculation_242350015074979841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_ss_csat_4_5_resolution_sessions])/SUM([count_ss_responses_resolution_sessions])' />
            </column>
            <column caption='is_max_week' datatype='boolean' name='[Calculation_672443783518289922]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [week]: MAX([date])} = {FIXED: MAX([date])}' />
            </column>
            <column caption='Date ' datatype='string' name='[Calculation_905786523632222210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Day&quot; THEN STR([date])&#13;&#10;WHEN &quot;Week&quot; THEN [week]&#13;&#10;WHEN &quot;Month&quot; THEN [month]&#13;&#10;END' />
            </column>
            <column caption='MBR_Self-service CSAT 12wk' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[MBR_Self-service CSAT 4wk (copy)_1196268657631928327]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then 100*&#10;    (SUM(&#10;    IF [is_max_week (copy)_1224134679962812417]&#10;    THEN [count_ss_csat_4_5_resolution_sessions]&#10;    ELSE 0 END&#10;    ))&#10;&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_1224134679962812417]&#10;    THEN [count_ss_responses_resolution_sessions]&#10;    ELSE 0 END&#10;    )&#10;end' />
            </column>
            <column caption='MBR_Self-service CSAT 4wk' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[MBR_Self-service rate 4wk (copy)_1196268657631707142]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then 100*&#10;    (SUM(&#10;    IF [MBR_is_reporting_week_minus_12 (copy)_1196268657547894785]&#10;    THEN [count_ss_csat_4_5_resolution_sessions]&#10;    ELSE 0 END&#10;    ))&#10;&#10;    /&#10;     SUM(&#10;    IF [MBR_is_reporting_week_minus_12 (copy)_1196268657547894785]&#10;    THEN [count_ss_responses_resolution_sessions]&#10;    ELSE 0 END&#10;    )&#10;end' />
            </column>
            <column caption='MBR_Self-service CSAT reporting week' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[MBR_Self-service rate reporting week (copy)_1196268657631354885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#13;&#10;then 100*&#13;&#10;    (SUM(&#13;&#10;    IF [is_max_week (copy)_1224134679969902598]&#13;&#10;    THEN [count_ss_csat_4_5_resolution_sessions]&#13;&#10;    ELSE 0 END&#13;&#10;    ))&#13;&#10;&#13;&#10;    /&#13;&#10;     SUM(&#13;&#10;    IF [is_max_week (copy)_1224134679969902598]&#13;&#10;    THEN [count_ss_responses_resolution_sessions]&#13;&#10;    ELSE 0 END&#13;&#10;    )&#13;&#10;end' />
            </column>
            <column caption='MBR_is_reporting_week_minus_4' datatype='boolean' name='[MBR_is_reporting_week_minus_12 (copy)_1196268657547894785]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [week]: MAX(DATEADD(&apos;day&apos;, 3*7, [date]))} = {FIXED [is_max_week (copy)_1224134679969902598], [Calculation_672443783518289922]: MAX([date])}' />
            </column>
            <column caption='MBR_is_reporting_timeframe' datatype='boolean' name='[MBR_is_reporting_week_minus_12 (copy)_1196268657558528004]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [week]: MAX(DATEADD(&apos;day&apos;, 11*7, [date]))} &gt;= {FIXED [Calculation_672443783518289922], [is_max_week (copy)_1224134679969902598]: MAX([date])}&#13;&#10;&#13;&#10;AND &#13;&#10;&#13;&#10;((NOT [Calculation_672443783518289922]) OR [is_max_week (copy)_1224134679969902598])' />
            </column>
            <column datatype='integer' name='[count_ss_csat_4_5_resolution_sessions]' role='measure' type='quantitative' />
            <column datatype='integer' name='[count_ss_responses_resolution_sessions]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Helpcenter' datatype='string' name='[helpcenter]' role='dimension' type='nominal' />
            <column caption='MBR_is_reporting_week_minus_12' datatype='boolean' name='[is_max_week (copy)_1224134679962812417]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [week]: MAX(DATEADD(&apos;day&apos;, 11*7, [date]))} = {FIXED [is_max_week (copy)_1224134679969902598], [Calculation_672443783518289922]: MAX([date])}' />
            </column>
            <column caption='MBR_is_reporting_week' datatype='boolean' name='[is_max_week (copy)_1224134679969902598]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// yesterday was sunday&#13;&#10;IF {FIXED: DATENAME(&quot;weekday&quot;,MAX([date]), &quot;Monday&quot;)} = &quot;Sunday&quot;&#13;&#10;// so the max week is our reporting week&#13;&#10;THEN [Calculation_672443783518289922]&#13;&#10;// otherwise the week before is our reporting week&#13;&#10;ELSE [is_max_week (copy)_672443783520116739]&#13;&#10;END' />
            </column>
            <column caption='is_max_week_minus_one' datatype='boolean' name='[is_max_week (copy)_672443783520116739]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT [Calculation_672443783518289922]&#13;&#10;AND&#13;&#10;{FIXED [week]: MAX([date])} = {FIXED [Calculation_672443783518289922]: MAX([date])}' />
            </column>
            <column caption='Month' datatype='string' name='[month]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_905786523632222210]' derivation='None' name='[none:Calculation_905786523632222210:nk]' pivot='key' type='nominal' />
            <column-instance column='[MBR_is_reporting_week_minus_12 (copy)_1196268657558528004]' derivation='None' name='[none:MBR_is_reporting_week_minus_12 (copy)_1196268657558528004:nk]' pivot='key' type='nominal' />
            <column-instance column='[helpcenter]' derivation='None' name='[none:helpcenter:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column-instance column='[version]' derivation='None' name='[none:version:nk]' pivot='key' type='nominal' />
