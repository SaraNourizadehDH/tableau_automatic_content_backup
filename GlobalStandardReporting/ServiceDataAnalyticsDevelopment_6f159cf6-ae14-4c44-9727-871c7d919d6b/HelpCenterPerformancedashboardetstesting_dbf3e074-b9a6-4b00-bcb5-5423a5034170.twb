      </column>
      <column caption='is_max_date' datatype='boolean' name='[is_max_month (copy)_352899259462545410]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;,[date]) = &#10;&#10;{MAX(DATETRUNC(&apos;day&apos;,[date]))}' />
