            </column>
            <column caption='MBR_Self-service rate Positive % Diff12wk' datatype='string' name='[Self-service rate Positive % Diff4wk (copy)_1224134679964213253]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Self-service rate % chg4wk (copy)_1224134679963394051] &gt; 0&#13;&#10;THEN &quot;▲&quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
            </column>
            <column caption='MBR_Self-service rate reporting week' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Self-service rate current (copy)_1196268657548656642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#13;&#10;then 100*&#13;&#10;    (SUM(&#13;&#10;    IF [is_max_week (copy)_1224134679969902598]&#13;&#10;    THEN [sessions_deflected]&#13;&#10;    ELSE 0 END&#13;&#10;    )&#13;&#10;+&#13;&#10;    SUM(&#13;&#10;    IF [is_max_week (copy)_1224134679969902598]&#13;&#10;    THEN [sessions_automated]&#13;&#10;    ELSE 0 END&#13;&#10;    ))&#13;&#10;&#13;&#10;    /&#13;&#10;     SUM(&#13;&#10;    IF [is_max_week (copy)_1224134679969902598]&#13;&#10;    THEN [sessions_resolution_page_reached]&#13;&#10;    ELSE 0 END&#13;&#10;    )&#13;&#10;end' />
            </column>
            <column caption='MBR_Self-service rate 12wk' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Self-service rate prev4wk (copy)_1224134679962931202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then 100*&#10;    (SUM(&#10;    IF [is_max_week (copy)_1224134679962812417]&#10;    THEN [sessions_deflected]&#10;    ELSE 0 END&#10;    )&#10;+&#10;    SUM(&#10;    IF [is_max_week (copy)_1224134679962812417]&#10;    THEN [sessions_automated]&#10;    ELSE 0 END&#10;    ))&#10;&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_1224134679962812417]&#10;    THEN [sessions_resolution_page_reached]&#10;    ELSE 0 END&#10;    )&#10;end' />
            </column>
            <column caption='MBR_Self-service rate 4wk' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Self-service rate previous (copy)_966585075937570817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then 100*&#10;    (SUM(&#10;    IF [MBR_is_reporting_week_minus_12 (copy)_1196268657547894785]&#10;    THEN [sessions_deflected]&#10;    ELSE 0 END&#10;    )&#10;+&#10;    SUM(&#10;    IF [MBR_is_reporting_week_minus_12 (copy)_1196268657547894785]&#10;    THEN [sessions_automated]&#10;    ELSE 0 END&#10;    ))&#10;&#10;    /&#10;     SUM(&#10;    IF [MBR_is_reporting_week_minus_12 (copy)_1196268657547894785]&#10;    THEN [sessions_resolution_page_reached]&#10;    ELSE 0 END&#10;    )&#10;end' />
