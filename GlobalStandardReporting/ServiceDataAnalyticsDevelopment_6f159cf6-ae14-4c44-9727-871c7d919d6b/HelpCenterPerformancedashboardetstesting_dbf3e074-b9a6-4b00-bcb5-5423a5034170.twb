      <table>
        <view>
          <datasources>
            <datasource caption='helpcenter_performance_v2 (rl_gcc_service)' name='federated.02bkitl1pw2xn511wpal70fzb11v' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.02bkitl1pw2xn511wpal70fzb11v'>
            <column caption='% Issues through HC' datatype='real' name='[Calculation_242350015078113286]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([helpcenter_contacts])/SUM([all_contacts])' />
            </column>
            <column caption='is_max_week' datatype='boolean' name='[Calculation_672443783518289922]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [week]: MAX([date])} = {FIXED: MAX([date])}' />
            </column>
            <column caption='Date ' datatype='string' name='[Calculation_905786523632222210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Day&quot; THEN STR([date])&#13;&#10;WHEN &quot;Week&quot; THEN [week]&#13;&#10;WHEN &quot;Month&quot; THEN [month]&#13;&#10;END' />
            </column>
            <column caption='Date Range' datatype='date' name='[Date (copy)_4079416897935040523]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[date]' />
            </column>
            <column aggregation='Attribute' caption='HC Reach Current' datatype='real' name='[Deflection rate Current (copy)_604537941452804112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [helpcenter_contacts]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Calculation_672443783518289922]&#10;    THEN [all_contacts]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [helpcenter_contacts]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_month (copy)_352899259462545410]&#10;    THEN [all_contacts]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [helpcenter_contacts]&#10;    ELSE 0 END&#10;    )&#10;&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_352899259461615616]&#10;    THEN [all_contacts]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;end' />
            </column>
            <column caption='HC reach Negative % Diff' datatype='string' name='[HC Index Negative % Diff (copy)_604537941453926419]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [HC index % chg (copy)_604537941453676562] &lt; 0&#10;THEN &quot;▼&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='HC reach Positive % Diff' datatype='string' name='[HC Index Positive % Diff (copy)_604537941454028820]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [HC index % chg (copy)_604537941453676562] &gt; 0&#10;THEN &quot;▲&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column aggregation='Attribute' caption='HC Reach Previous' datatype='real' name='[HC Reach Current (copy)_604537941453344785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Week&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [helpcenter_contacts]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_week (copy)_672443783520116739]&#10;    THEN [all_contacts]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Day&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [helpcenter_contacts]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_date (copy)_352899259463598083]&#10;    THEN [all_contacts]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos;&#10;then &#10;    {EXCLUDE [Calculation_905786523632222210]: &#10;    SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [helpcenter_contacts]&#10;    ELSE 0 END&#10;    )&#10;&#10;    /&#10;     SUM(&#10;    IF [is_max_week_minus_one (copy)_352899259461959681]&#10;    THEN [all_contacts]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;end' />
            </column>
            <column caption='HC Reach % chg' datatype='real' name='[HC index % chg (copy)_604537941453676562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Deflection rate Current (copy)_604537941452804112])-SUM([HC Reach Current (copy)_604537941453344785]))/SUM([HC Reach Current (copy)_604537941453344785])' />
            </column>
