          <datasource-dependencies datasource='federated.02bkitl1pw2xn511wpal70fzb11v'>
            <column caption='% Sessions Multiple Leaves Visited' datatype='real' name='[Calculation_242350015077523459]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_multiple_leaves_visited])/SUM([sessions_leaf_reached])' />
            </column>
            <column caption='Sessions Multiple Leaves Visited % Chg' datatype='real' name='[Calculation_604537941450858509]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Deflection rate Current (copy)_604537941450485771]) - SUM([Sessions Multiple Leaves Visited Current (copy)_604537941450731532]))/&#10;SUM([Sessions Multiple Leaves Visited Current (copy)_604537941450731532])' />
