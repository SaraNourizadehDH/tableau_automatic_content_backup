    <worksheet name='Task Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt; | </run>
            <run fontsize='9'><![CDATA[Top <[Parameters].[Parameter 2]> tasks]]></run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run>FYI, context filters were added so that the Top N trend could show relevant scripts that were top across selected time period, not just on individual days.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='airflow_task_metrics (rl)' name='federated.19akidj10cyp1z14zj6hu1t8f8w6' />
            <datasource caption='airflow_dag_metrics (rl)' name='federated.1kbi4y617v8rdh13n354m1ugkloc' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
            <column caption='Show Top N' datatype='integer' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
              <range max='20' min='1' />
            </column>
            <column caption='Show Task Avg. Duration above threshold ( in seconds )' datatype='integer' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='1300'>
              <calculation class='tableau' formula='1300' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.19akidj10cyp1z14zj6hu1t8f8w6'>
            <column caption='Show Avg. Task Duration &gt; User Input Threshold' datatype='string' name='[Avg. Task Duration &gt; User Input Threshold ? (copy)_6765954755689963521]' role='measure' type='nominal'>
              <calculation class='tableau' formula='If WINDOW_SUM([Calculation_2364108397916737536]) &gt; 0 THEN &apos;Display&apos; ELSE &apos;Hide&apos; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Avg. Task Duration &gt; User Input Threshold ?' datatype='integer' name='[Calculation_2364108397916737536]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='If AVG([duration_seconds]) &gt; [Parameters].[Parameter 4] THEN 1 ELSE 0 END' />
            </column>
            <column caption='Report Date (Relative)' datatype='date' name='[Calculation_3179048786417369090]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='Task Category' datatype='string' name='[Calculation_3179048786439520259]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3179048786439860228] = &apos;create&apos; OR [Calculation_3179048786439860228] = &apos;partitions&apos;&#10;    THEN &apos;Curation&apos;&#10;ELSEIF [Calculation_3179048786439860228] = &apos;metadata&apos; OR [Calculation_3179048786439860228] = &apos;policy&apos; OR [Calculation_3179048786439860228] = &apos;child&apos; OR [Calculation_3179048786439860228] = &apos;update&apos;&#10;    THEN &apos;Post-execution&apos;&#10;ELSEIF [Calculation_3179048786439860228] = &apos;check&apos; OR [Calculation_3179048786439860228] = &apos;min&apos; OR [Calculation_3179048786439860228] = &apos;parent&apos; OR [Calculation_3179048786439860228] = &apos;sensor&apos; OR [Calculation_3179048786439860228] = &apos;start&apos; OR [Calculation_3179048786439860228] = &apos;last&apos;&#10;    THEN &apos;Pre-execution&apos;&#10;ELSEIF [Calculation_3179048786439860228] = &apos;ge&apos; OR [Calculation_3179048786439860228] = &apos;end&apos;&#10;    THEN &apos;Great Expectations&apos;&#10;ELSE &apos;Others&apos;&#10;END' />
            </column>
            <column caption='Task first word' datatype='string' name='[Calculation_3179048786439860228]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='SPLIT([task_id], &apos;-&apos;, 1)' />
            </column>
            <column caption='Time Granularity' datatype='string' name='[Calculation_5192157820140343302]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Day&apos; THEN STR([report_date])&#10;    WHEN &apos;Week&apos; THEN [week]&#10;    WHEN &apos;Month&apos; THEN [month]&#10;    WHEN &apos;Quarter&apos; THEN [quarter]&#10;END' />
            </column>
            <column-instance column='[dag_id]' derivation='Attribute' name='[attr:dag_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[dag_owner]' derivation='Attribute' name='[attr:dag_owner:nk]' pivot='key' type='nominal' />
