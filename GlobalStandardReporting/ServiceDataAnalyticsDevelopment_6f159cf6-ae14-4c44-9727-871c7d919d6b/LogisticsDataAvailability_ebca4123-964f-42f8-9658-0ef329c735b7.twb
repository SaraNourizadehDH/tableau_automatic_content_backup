    <worksheet name='DAG Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Medium' fontsize='10'>Performance Trend | </run>
            <run fontcolor='#074080' fontname='Tableau Medium' fontsize='10'>All Tasks </run>
            <run fontname='Tableau Medium' fontsize='10'>vs </run>
            <run fontcolor='#f28e2b' fontname='Tableau Medium' fontsize='10'>Critical Tasks</run>
            <run fontname='Tableau Medium' fontsize='10'> vs </run>
            <run fontcolor='#800002' fontname='Tableau Medium' fontsize='10'>Failures</run>
            <run fontsize='9'> (&quot;critical tasks&quot; and &quot;failures&quot; applies to shared layer DAGs only)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='airflow_dag_metrics (rl)' name='federated.1kbi4y617v8rdh13n354m1ugkloc' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1kbi4y617v8rdh13n354m1ugkloc'>
            <column caption='Report Date (Relative)' datatype='date' name='[Calculation_5940318301553917952]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='Time Granularity' datatype='string' name='[Calculation_5940318301555900417]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Day&apos; THEN STR([report_date])&#10;    WHEN &apos;Week&apos; THEN [week]&#10;    WHEN &apos;Month&apos; THEN [month]&#10;    WHEN &apos;Quarter&apos; THEN [quarter]&#10;END' />
            </column>
            <column caption='Duration (mins) (Critical Tasks only)' datatype='real' name='[Calculation_5940318301556617218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [dag_critical_success] = 1 THEN [dag_critical_duration_min] END)&#10;/&#10;SUM([dag_critical_success])' />
            </column>
            <column caption='Duration (mins) (Successful runs)' datatype='real' name='[DAG Critical Duration (mins) (copy)_5940318301557362691]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [dag_success] = 1 THEN [dag_duration_min] END)&#10;/&#10;SUM([dag_success])' />
            </column>
            <column caption='Dag Critical Duration Min' datatype='integer' name='[dag_critical_duration_min]' role='measure' type='quantitative' />
            <column caption='Dag Critical Failure' datatype='integer' default-format='N' name='[dag_critical_failure]' role='measure' type='quantitative' />
            <column caption='Dag Critical Success' datatype='integer' default-format='N' name='[dag_critical_success]' role='measure' type='quantitative' />
