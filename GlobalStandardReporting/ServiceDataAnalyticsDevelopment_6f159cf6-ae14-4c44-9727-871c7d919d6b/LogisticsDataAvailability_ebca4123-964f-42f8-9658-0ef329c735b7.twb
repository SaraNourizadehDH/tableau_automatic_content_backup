    <worksheet name='EU Availability'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Tableau Medium' fontsize='8'>Available by</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='airflow_dag_metrics (rl)' name='federated.1kbi4y617v8rdh13n354m1ugkloc' />
          </datasources>
          <datasource-dependencies datasource='federated.1kbi4y617v8rdh13n354m1ugkloc'>
            <column caption='Shared Layer' datatype='string' name='[Airflow DAG]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[dag_id]' default='&quot;All Others&quot;' new-bin='true'>
                <bin default-name='false' value='&quot;Logistics (curated_data_shared)&quot;'>
                  <value>&quot;curated-data-common&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Service (curated_data_shared_gcc_service)&quot;'>
                  <value>&quot;curated-data-service-cl&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Avg. Availability by (Local)' datatype='datetime' default-format='*hh:mm AM/PM' name='[Avg. Availability by (UTC) (copy)_5940318301784109065]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='CASE MAX([region])&#10;    WHEN &apos;APAC&apos; THEN DATEADD(&apos;hour&apos;, 8, [Calculation_5940318301561204743])&#10;    WHEN &apos;EU&apos; THEN DATEADD(&apos;hour&apos;, 2, [Calculation_5940318301561204743])&#10;    WHEN &apos;AMR&apos; THEN DATEADD(&apos;hour&apos;, -3, [Calculation_5940318301561204743])&#10;END' />
            </column>
            <column caption='Report Date (Relative)' datatype='date' name='[Calculation_5940318301553917952]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='Duration (mins) (Critical Tasks only)' datatype='real' name='[Calculation_5940318301556617218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [dag_critical_success] = 1 THEN [dag_critical_duration_min] END)&#10;/&#10;SUM([dag_critical_success])' />
            </column>
            <column caption='Avg. Availability by (UTC)' datatype='datetime' name='[Calculation_5940318301561204743]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;minute&apos;&#10;  , INT([Calculation_5940318301556617218])&#10;  , MIN([Calculation_5940318301566218248]) // MIN() ok as we will be displaying hh:mm only&#10;)' />
            </column>
            <column caption='Scheduled Start At' datatype='datetime' name='[Calculation_5940318301566218248]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [region]&#10;    WHEN &apos;APAC&apos; THEN DATEADD(&apos;hour&apos;, 12, [execution_date_id])&#10;    WHEN &apos;EU&apos; THEN DATEADD(&apos;hour&apos;, 6, [execution_date_id])&#10;    WHEN &apos;AMR&apos; THEN DATEADD(&apos;hour&apos;, 6, [execution_date_id])&#10;END' />
            </column>
            <column caption='Is Shared DAG' datatype='boolean' name='[Calculation_5940318301787680778]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Airflow DAG] &lt;&gt; &apos;All Others&apos;' />
            </column>
            <column caption='Is Available &lt; 9AM' datatype='boolean' name='[Calculation_5940318301793239051]' role='measure' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [Avg. Availability by (UTC) (copy)_5940318301784109065]) &lt; 9' />
            </column>
            <column caption='Local Availability' datatype='real' default-format='*hh:mm AM/PM' name='[Calculation_904308760616382464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [dag_critical_success] = 1&#10;    THEN DATEDIFF(&apos;second&apos;, DATETRUNC(&apos;day&apos;, [end_at_critical_local]), [end_at_critical_local]) / 86400&#10;END' />
            </column>
            <column-instance column='[Calculation_904308760616382464]' derivation='Avg' name='[avg:Calculation_904308760616382464:qk]' pivot='key' type='quantitative' />
            <column caption='Dag Critical Duration Min' datatype='integer' name='[dag_critical_duration_min]' role='measure' type='quantitative' />
            <column caption='Dag Critical Success' datatype='integer' default-format='N' name='[dag_critical_success]' role='measure' type='quantitative' />
            <column caption='Dag Id' datatype='string' name='[dag_id]' role='dimension' type='nominal' />
            <column caption='End At Critical Local' datatype='datetime' name='[end_at_critical_local]' role='dimension' type='ordinal' />
            <column caption='Execution Date Id' datatype='datetime' name='[execution_date_id]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_5940318301553917952]' derivation='None' name='[none:Calculation_5940318301553917952:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_5940318301787680778]' derivation='None' name='[none:Calculation_5940318301787680778:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_date]' derivation='None' name='[none:report_date:qk]' pivot='key' type='quantitative' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='N/A' />
              </aliases>
            </column>
            <column caption='Report Date' datatype='date' name='[report_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_5940318301793239051]' derivation='User' name='[usr:Calculation_5940318301793239051:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1kbi4y617v8rdh13n354m1ugkloc].[Airflow DAG]' context='true' filter-group='11'>
            <groupfilter function='member' level='[Airflow DAG]' member='&quot;Logistics (curated_data_shared)&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='relative-date' column='[federated.1kbi4y617v8rdh13n354m1ugkloc].[none:Calculation_5940318301553917952:qk]' filter-group='27' first-period='0' include-future='true' include-null='false' last-period='0' period-type-v2='month'>
            <target field='[federated.1kbi4y617v8rdh13n354m1ugkloc].[none:Calculation_5940318301553917952:qk]' />
          </filter>
          <filter class='categorical' column='[federated.1kbi4y617v8rdh13n354m1ugkloc].[none:Calculation_5940318301787680778:nk]' context='true' filter-group='9'>
            <groupfilter function='member' level='[none:Calculation_5940318301787680778:nk]' member='true' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1kbi4y617v8rdh13n354m1ugkloc].[none:region:nk]' filter-group='5'>
            <groupfilter function='member' level='[none:region:nk]' member='&quot;EU&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='quantitative' column='[federated.1kbi4y617v8rdh13n354m1ugkloc].[none:report_date:qk]' filter-group='3' included-values='all'>
            <target field='[federated.1kbi4y617v8rdh13n354m1ugkloc].[none:report_date:qk]' />
          </filter>
          <slices>
            <column>[federated.1kbi4y617v8rdh13n354m1ugkloc].[Airflow DAG]</column>
            <column>[federated.1kbi4y617v8rdh13n354m1ugkloc].[none:Calculation_5940318301787680778:nk]</column>
            <column>[federated.1kbi4y617v8rdh13n354m1ugkloc].[none:report_date:qk]</column>
            <column>[federated.1kbi4y617v8rdh13n354m1ugkloc].[none:Calculation_5940318301553917952:qk]</column>
            <column>[federated.1kbi4y617v8rdh13n354m1ugkloc].[none:region:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='width' field='[federated.1kbi4y617v8rdh13n354m1ugkloc].[none:region:nk]' value='195' />
