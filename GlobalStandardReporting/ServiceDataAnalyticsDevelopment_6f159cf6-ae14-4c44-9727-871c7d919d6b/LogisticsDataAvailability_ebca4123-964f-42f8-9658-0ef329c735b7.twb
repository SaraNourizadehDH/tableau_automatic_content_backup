  <worksheets>
    <worksheet name=' DAG : Top N DAGs'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Top &lt;</run>
            <run>[Parameters].[Show Top N (copy)_5433030003168493568]</run>
            <run>&gt; DAGs</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run>FYI, context filters were added so that the Top N trend could show relevant scripts that were top across selected time period, not just on individual days.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='airflow_task_metrics (rl)' name='federated.19akidj10cyp1z14zj6hu1t8f8w6' />
            <datasource caption='airflow_dag_metrics (rl)' name='federated.1kbi4y617v8rdh13n354m1ugkloc' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Show Top N by Failures' datatype='integer' name='[Show Top N (copy)_5433030003168493568]' param-domain-type='range' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
              <range max='100' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.19akidj10cyp1z14zj6hu1t8f8w6'>
            <column caption='Report Date (Relative)' datatype='date' name='[Calculation_3179048786417369090]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='Rank Task Failures' datatype='integer' name='[Calculation_5148951382870638593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_UNIQUE(SUM([failure_ind]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Show Top N By Task Failures' datatype='string' name='[Calculation_5148951382870839298]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_5148951382870638593] &lt;= [Parameters].[Show Top N (copy)_5433030003168493568] &#10;THEN &apos;Show&apos;&#10;ELSE &apos;Other&apos;&#10;END'>
                <table-calc ordering-type='Rows' />
