    <worksheet name='EU Trend'>
      <table>
        <view>
          <datasources>
            <datasource caption='airflow_dag_metrics (rl)' name='federated.1kbi4y617v8rdh13n354m1ugkloc' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1kbi4y617v8rdh13n354m1ugkloc'>
            <column caption='Shared Layer' datatype='string' name='[Airflow DAG]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[dag_id]' default='&quot;All Others&quot;' new-bin='true'>
                <bin default-name='false' value='&quot;Logistics (curated_data_shared)&quot;'>
                  <value>&quot;curated-data-common&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;Service (curated_data_shared_gcc_service)&quot;'>
                  <value>&quot;curated-data-service-cl&quot;</value>
                </bin>
              </calculation>
            </column>
            <column caption='Incident Report URL' datatype='string' name='[Calculation_3179048786377474048]' role='measure' type='nominal'>
              <calculation class='tableau' formula='MIN([incident_report])' />
            </column>
            <column caption='Report Date (Relative)' datatype='date' name='[Calculation_5940318301553917952]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_date]' />
            </column>
            <column caption='Time Granularity' datatype='string' name='[Calculation_5940318301555900417]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Day&apos; THEN STR([report_date])&#10;    WHEN &apos;Week&apos; THEN [week]&#10;    WHEN &apos;Month&apos; THEN [month]&#10;    WHEN &apos;Quarter&apos; THEN [quarter]&#10;END' />
            </column>
            <column caption='Is Shared DAG' datatype='boolean' name='[Calculation_5940318301787680778]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Airflow DAG] &lt;&gt; &apos;All Others&apos;' />
            </column>
            <column caption='Local Availability' datatype='real' default-format='*hh:mm AM/PM' name='[Calculation_904308760616382464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [dag_critical_success] = 1&#10;    THEN DATEDIFF(&apos;second&apos;, DATETRUNC(&apos;day&apos;, [end_at_critical_local]), [end_at_critical_local]) / 86400&#10;END' />
            </column>
            <column-instance column='[Calculation_904308760616382464]' derivation='Avg' name='[avg:Calculation_904308760616382464:qk]' pivot='key' type='quantitative' />
            <column caption='Dag Critical Failure' datatype='integer' default-format='N' name='[dag_critical_failure]' role='measure' type='quantitative' />
            <column caption='Dag Critical Success' datatype='integer' default-format='N' name='[dag_critical_success]' role='measure' type='quantitative' />
            <column caption='Dag Id' datatype='string' name='[dag_id]' role='dimension' type='nominal' />
            <column caption='End At Critical Local' datatype='datetime' name='[end_at_critical_local]' role='dimension' type='ordinal' />
            <column caption='Incident Report' datatype='string' name='[incident_report]' role='dimension' type='nominal' />
            <column-instance column='[dag_critical_failure]' derivation='Max' name='[max:dag_critical_failure:qk]' pivot='key' type='quantitative' />
            <column-instance column='[dag_critical_success]' derivation='Max' name='[max:dag_critical_success:qk]' pivot='key' type='quantitative' />
            <column caption='Month' datatype='string' name='[month]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_5940318301553917952]' derivation='None' name='[none:Calculation_5940318301553917952:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_5940318301555900417]' derivation='None' name='[none:Calculation_5940318301555900417:nk]' pivot='key' type='nominal' />
