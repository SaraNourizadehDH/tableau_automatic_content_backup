    <worksheet name='% Markup (Latest Price vs Benchmark) per Country'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#e15759'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#499894' fontsize='10'>Please note: </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#499894' fontsize='10'>The &quot;Listed Price&quot; here is calculated on-the-fly across the filtered range of Order Dates (e.g. 1 June to 1 July), but the &quot;Benchmark&quot; is pre-calculated across the entire available range of Order Dates from the database (e.g. 1 May to 31 July). Therefore, when the filter of Order Dates is adjusted, the chart is updated automatically.</run>
          </formatted-text>
        </title>
      </layout-options>
