    <worksheet name='Top N Perspectives by KVIs with Markup'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#d61f26'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_ls_item_price_mena (local_shops_analytics)' name='federated.0knh8kk0z3fes21fryx6s0yxzxh5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Benchmark Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dmart Weighted Average of Sold Prices&quot;'>
              <calculation class='tableau' formula='&quot;Dmart Weighted Average of Sold Prices&quot;' />
            </column>
            <column caption='Perspective' datatype='string' name='[Parameter 2 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
            <column caption='Top N Perspectives by &quot;# Total Active SKU&quot;' datatype='integer' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='10000'>
              <calculation class='tableau' formula='10000' />
              <range granularity='1' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0knh8kk0z3fes21fryx6s0yxzxh5'>
            <column caption='Count of Global Product ID' datatype='integer' name='[Calculation_2565433372397506560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([global_product_id])' />
            </column>
            <column caption='Perspective 1' datatype='string' name='[Calculation_382665295505428480]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF     [Parameters].[Parameter 2 1] IN (&apos;Vertical&apos;,&#10;                         &apos;Vertical ▸ Country&apos;,&#10;                         &apos;Vertical ▸ Country ▸ Chain&apos;) &#10;THEN [mena_vertical]&#10;ELSEIF [Parameters].[Parameter 2 1] IN (&apos;Country&apos;,&#10;                         &apos;Country ▸ City&apos;, &apos;Country ▸ Chain&apos;,  &#10;                         &apos;Country ▸ Vertical&apos;,  &#10;                         &apos;Country ▸ Vertical ▸ Chain&apos;)  &#10;THEN [country_name]&#10;ELSEIF  [Parameters].[Parameter 2 1] = &apos;Region&apos; THEN &apos;MENA&apos;&#10;ELSEIF  [Parameters].[Parameter 2 1] IN (&apos;Chain&apos;,&apos;Chain ▸ Country&apos;) THEN [Chain_Name]&#10;ELSEIF  [Parameters].[Parameter 2 1] IN (&apos;Vendor&apos;) THEN [Local_Shop_Vendor_Name]&#10;ELSEIF [Parameters].[Parameter 2 1] in (&apos;PIM Level 1 ▸ Level 2&apos;) then [pim_level_one_name]&#10;END' />
            </column>
            <column caption='Below Benchmark Flag' datatype='boolean' name='[Calculation_382665296199548930]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;25th Percentile of Listed Prices&quot; then [below_25pct]&#10;WHEN &quot;50th Percentile of Listed Prices&quot; then [below_50pct]&#10;WHEN &quot;75th Percentile of Listed Prices&quot; then [below_75pct]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [below_25pct_vertical]&#10;WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [below_50pct_vertical]&#10;WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [below_75pct_vertical]&#10;WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [below_wtd_avg]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [below_dm_wtd_avg]&#10;end' />
            </column>
            <column caption='Chain ID' datatype='string' name='[Chain_ID]' role='dimension' type='nominal' />
            <column caption='Chain Name' datatype='string' name='[Chain_Name]' role='dimension' type='nominal' />
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='% SKU (above benchmark)' datatype='real' name='[Count of Global Product ID (above benchmark) (copy)_6367526943144947713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Count of Global Product ID (copy)_6367526943144394752] / [Calculation_2565433372397506560]' />
            </column>
            <column caption='Count of Global Product ID (above benchmark)' datatype='integer' name='[Count of Global Product ID (copy)_6367526943144394752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [Calculation_382665296199548930] = false then [global_product_id] end)' />
            </column>
            <column caption='Local Shop Vendor Name' datatype='string' name='[Local_Shop_Vendor_Name]' role='dimension' type='nominal' />
            <column caption='Perspective 2' datatype='string' name='[Perspective 1 (copy)_6733585198477860865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF     [Parameters].[Parameter 2 1] in (&apos;Vertical ▸ Country&apos; , &apos;Chain ▸ Country&apos; ,&#10;                         &apos;Vertical ▸ Country ▸ Chain&apos;)&#10;THEN [country_name]&#10;ELSEIF [Parameters].[Parameter 2 1] IN (&apos;Country ▸ Vertical&apos;,&apos;Country ▸ Vertical ▸ Chain&apos;&#10;                         )&#10;THEN [mena_vertical]&#10;ELSEIF [Parameters].[Parameter 2 1] IN ( &#10;                         &apos;Country ▸ City&apos;&#10;                         )&#10;THEN [City]&#10;ELSEIF [Parameters].[Parameter 2 1] IN ( &#10;                         &apos;Country ▸ Chain&apos;,&#10;                         &apos;Vertical ▸ Chain&apos;&#10;                         )&#10;THEN [Chain_Name]&#10;&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Country&apos; THEN [global_entity_id]&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Vertical&apos; THEN &apos;All&apos;&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Region&apos; THEN &apos;All&apos;&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Chain&apos; THEN [Chain_ID]&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Vendor&apos; THEN [vendor_id]&#10;ELSEIF [Parameters].[Parameter 2 1] in (&apos;PIM Level 1 ▸ Level 2&apos;) then [pim_level_two_name]&#10;END' />
            </column>
            <column caption='Below 25Pct' datatype='boolean' name='[below_25pct]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[below_25pct_vertical]' role='dimension' type='nominal' />
            <column caption='Below 50Pct' datatype='boolean' name='[below_50pct]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[below_50pct_vertical]' role='dimension' type='nominal' />
            <column caption='Below 75Pct' datatype='boolean' name='[below_75pct]' role='dimension' type='nominal' />
