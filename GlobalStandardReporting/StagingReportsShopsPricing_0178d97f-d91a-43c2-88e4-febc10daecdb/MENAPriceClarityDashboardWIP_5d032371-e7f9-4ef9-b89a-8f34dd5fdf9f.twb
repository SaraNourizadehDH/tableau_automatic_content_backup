                <zone forceUpdate='true' h='2433' id='11' type-v2='text' w='81440' x='606' y='2767'>
                  <formatted-text>
                    <run fontcolor='#d61f26'>Please see the </run>
                    <run bold='true' fontcolor='#d61f26'>Time Series</run>
                    <run fontcolor='#d61f26'> chart for the trend of prices, each dot in the</run>
                    <run bold='true' fontcolor='#d61f26'> # of orders vs Weighted Avg Price</run>
                    <run fontcolor='#d61f26'> represents orders from one particular month.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#d61f26'>Select </run>
                    <run bold='true' fontcolor='#d61f26'>one Benchmark Type,</run>
                    <run fontcolor='#d61f26'>Æ </run>
                    <run fontcolor='#d61f26' fontname='Tableau Semibold'>one Country Name, one City &amp; one Master ID </run>
                    <run fontcolor='#d61f26'>to view the Time Series &amp; the Details table. </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#d61f26'>If you select </run>
                    <run bold='true' fontcolor='#d61f26'>Product Name </run>
                    <run fontcolor='#d61f26'>to view the </run>
                    <run bold='true' fontcolor='#d61f26'>Details Table</run>
                    <run fontcolor='#d61f26'>, please note that one Master ID can have mulitple Product Names due to the Catalog set-up.</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
