            <column caption='Perspective 2' datatype='string' name='[Perspective 1 (copy)_6733585198477860865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF     [Parameters].[Parameter 2 1] in (&apos;Vertical ▸ Country&apos; , &apos;Chain ▸ Country&apos; ,&#10;                         &apos;Vertical ▸ Country ▸ Chain&apos;)&#10;THEN [country_name]&#10;ELSEIF [Parameters].[Parameter 2 1] IN (&apos;Country ▸ Vertical&apos;,&apos;Country ▸ Vertical ▸ Chain&apos;&#10;                         )&#10;THEN [mena_vertical]&#10;ELSEIF [Parameters].[Parameter 2 1] IN ( &#10;                         &apos;Country ▸ City&apos;&#10;                         )&#10;THEN [City]&#10;ELSEIF [Parameters].[Parameter 2 1] IN ( &#10;                         &apos;Country ▸ Chain&apos;,&#10;                         &apos;Vertical ▸ Chain&apos;&#10;                         )&#10;THEN [Chain_Name]&#10;&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Country&apos; THEN [global_entity_id]&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Vertical&apos; THEN &apos;All&apos;&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Region&apos; THEN &apos;All&apos;&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Chain&apos; THEN [Chain_ID]&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Vendor&apos; THEN [vendor_id]&#10;ELSEIF [Parameters].[Parameter 2 1] in (&apos;PIM Level 1 ▸ Level 2&apos;) then [pim_level_two_name]&#10;END' />
            </column>
            <column caption='Below 25Pct' datatype='boolean' name='[below_25pct]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[below_25pct_vertical]' role='dimension' type='nominal' />
