          <datasource-dependencies datasource='federated.0svw0ya0k72xbm10bcz401tz7j0v'>
            <column caption='# Active SKU Above Benchmark' datatype='integer' name='[# Active SKU Below Benchmark (copy)_2014516435463454720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;25th Percentile of Listed Prices&quot; then [count_item_above_25pct]&#10;WHEN &quot;50th Percentile of Listed Prices&quot; then [count_item_above_50pct]&#10;WHEN &quot;75th Percentile of Listed Prices&quot; then [count_item_above_75pct]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [count_item_above_25pct_vertical]&#10;WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [count_item_above_50pct_vertical]&#10;WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [count_item_above_75pct_vertical]&#10;WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [count_item_above_wtd_avg_5pct]&#10;when &quot;Dmart Weighted Average of Sold Prices&quot; then [count_item_above_dm_wtd_avg_5pct]&#10;end' />
