    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' lock-updates='true' name='[MENA] Price Details'>
      <repository-location id='MENAPriceDetails' path='/t/GlobalStandardReporting/workbooks/MENAPriceClarityDashboardWIP' revision='' site='GlobalStandardReporting' />
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#f5f5f6' />
        </style-rule>
      </style>
      <size maxheight='3000' maxwidth='1320' minheight='3000' minwidth='1320' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='tbl_ls_sold_price_order_mena (local_shops_analytics)' name='federated.02804j007juni11h5g54619bcz1o' />
        <datasource caption='tableau_ls_item_price_mena (local_shops_analytics)' name='federated.0knh8kk0z3fes21fryx6s0yxzxh5' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Benchmark Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dmart Weighted Average of Sold Prices&quot;'>
          <calculation class='tableau' formula='&quot;Dmart Weighted Average of Sold Prices&quot;' />
          <members>
            <member value='&quot;25th Percentile of Listed Prices&quot;' />
            <member value='&quot;50th Percentile of Listed Prices&quot;' />
            <member value='&quot;75th Percentile of Listed Prices&quot;' />
            <member value='&quot;(Weighted Average + 5\% markup) of Sold Prices&quot;' />
            <member value='&quot;Dmart Weighted Average of Sold Prices&quot;' />
            <member value='&quot;[By Vertical] 25th Percentile of Listed Prices&quot;' />
            <member value='&quot;[By Vertical] 50th Percentile of Listed Prices&quot;' />
            <member value='&quot;[By Vertical] 75th Percentile of Listed Prices&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.02804j007juni11h5g54619bcz1o'>
        <column caption='Country Name' datatype='string' name='[Country_Name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
        <column caption='Master Id' datatype='integer' name='[master_id]' role='dimension' type='ordinal' />
