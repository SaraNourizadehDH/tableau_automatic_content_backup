            <column caption='Below Dm Wtd Avg' datatype='boolean' name='[below_dm_wtd_avg]' role='dimension' type='nominal' />
            <column caption='Below Wtd Avg' datatype='boolean' name='[below_wtd_avg]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Of Listed Price' datatype='date' name='[date_of_listed_price]' role='dimension' type='ordinal' />
