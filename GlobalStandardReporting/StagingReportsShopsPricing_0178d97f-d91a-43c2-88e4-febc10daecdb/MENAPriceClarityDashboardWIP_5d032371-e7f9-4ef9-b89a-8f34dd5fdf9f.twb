          <datasources>
            <datasource caption='tableau_ls_item_price_mena (local_shops_analytics)' name='federated.0knh8kk0z3fes21fryx6s0yxzxh5' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Benchmark Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dmart Weighted Average of Sold Prices&quot;'>
              <calculation class='tableau' formula='&quot;Dmart Weighted Average of Sold Prices&quot;' />
            </column>
            <column caption='Perspective' datatype='string' name='[Parameter 2 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
            <column caption='Top N Perspectives by &quot;# Total Active SKU&quot;' datatype='integer' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='10000'>
              <calculation class='tableau' formula='10000' />
              <range granularity='1' min='1' />
            </column>
