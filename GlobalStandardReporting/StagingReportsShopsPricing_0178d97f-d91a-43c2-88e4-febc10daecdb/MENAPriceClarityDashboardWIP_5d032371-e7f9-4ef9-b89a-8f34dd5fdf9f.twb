      <table>
        <view>
          <datasources>
            <datasource caption='tableau_ls_item_price_mena (local_shops_analytics)' name='federated.0knh8kk0z3fes21fryx6s0yxzxh5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Benchmark Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dmart Weighted Average of Sold Prices&quot;'>
              <calculation class='tableau' formula='&quot;Dmart Weighted Average of Sold Prices&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0knh8kk0z3fes21fryx6s0yxzxh5'>
            <column datatype='string' name='[Barcodes]' role='dimension' type='nominal' />
            <column caption='Listed Price Date' datatype='date' name='[Calculation_2211408171349479424]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(DATETRUNC(&apos;day&apos;, [date_of_listed_price]))' />
            </column>
            <column caption='Month' datatype='date' name='[Calculation_2211408171378167810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(DATETRUNC(&apos;month&apos;,[Calculation_2211408171349479424]))' />
            </column>
            <column caption='Benchmark Price' datatype='real' name='[Calculation_2211408171395112963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;25th Percentile of Listed Prices&quot; then [pct25_price]&#10;WHEN &quot;50th Percentile of Listed Prices&quot; then [med_price]&#10;WHEN &quot;75th Percentile of Listed Prices&quot; then [pct75_price]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [pct25_price_vertical]&#10;WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [med_price_vertical]&#10;WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [pct75_price_vertical]&#10;WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [shops_wtd_avg_price_lc]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [dmart_wtd_avg_price_lc]&#10;end' />
            </column>
            <column caption='Last Sold Price LC (time series)' datatype='real' name='[Calculation_2211408171734286342]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [last_sold_date] = [Calculation_2211408171735625735] then [last_sold_price_lc] end' />
            </column>
            <column caption='Last Sold Date (Max)' datatype='date' name='[Calculation_2211408171735625735]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id], [City],[master_id],[Calculation_2211408171378167810]: max([last_sold_date])}' />
            </column>
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Product Name' datatype='string' name='[Product_Name]' role='dimension' type='nominal' />
            <column-instance column='[best_price_lc]' derivation='Attribute' name='[attr:best_price_lc:qk]' pivot='key' type='quantitative' />
            <column caption='Price of Best Selling Item LC' datatype='real' name='[best_price_lc]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Of Listed Price' datatype='date' name='[date_of_listed_price]' role='dimension' type='ordinal' />
            <column caption='Dmart Wtd Avg Price Lc' datatype='real' name='[dmart_wtd_avg_price_lc]' role='measure' type='quantitative' />
