            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Benchmark Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dmart Weighted Average of Sold Prices&quot;'>
              <calculation class='tableau' formula='&quot;Dmart Weighted Average of Sold Prices&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0svw0ya0k72xbm10bcz401tz7j0v'>
            <column caption='# Total Active SKU*' datatype='integer' name='[# Active SKU Below Benchmark (copy)_1553038196279808011]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;25th Percentile of Listed Prices&quot; then [total]&#10;WHEN &quot;50th Percentile of Listed Prices&quot; then [total]&#10;WHEN &quot;75th Percentile of Listed Prices&quot; then [total]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [total]&#10;WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [total]&#10;WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [total]&#10;WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then ([total] - [count_item_without_wtd_avg])&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then ([total] - [count_item_without_dm_wtd_avg])&#10;end' />
            </column>
            <column caption='% Active SKU Below (Dmart Weighted Avg + 5% markup)' datatype='real' name='[% Active SKU Below (Weighted Avg + 5% markup) (copy)_793829822748823552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_item_below_dm_wtd_avg_5pct])/sum([count_item_above_dm_wtd_avg_5pct]+[count_item_below_dm_wtd_avg_5pct])' />
            </column>
            <column caption='% Active SKU Below 25Pct by vertical' datatype='real' name='[% Active SKU Below 25Pct (copy)_1297670075677745155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_item_below_25pct_vertical])/sum([total])' />
            </column>
            <column caption='% Active SKU Below 50Pct' datatype='real' name='[% Active SKU Below 25Pct (copy)_1553038196197724161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_item_below_50pct])/sum([total])' />
            </column>
            <column caption='% Active SKU Below 75Pct by vertical' datatype='real' name='[% Active SKU Below 25Pct by vertical (copy)_1297670075677904900]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_item_below_75pct_vertical])/sum([total])' />
            </column>
            <column caption='% Active SKU Below 75Pct' datatype='real' name='[% Active SKU Below 50Pct (copy)_1553038196199620611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_item_below_75pct])/sum([total])' />
            </column>
            <column caption='% Active SKU Below (Weighted Avg + 5% markup)' datatype='real' name='[% Active SKU Below 75Pct (copy)_1553038196199809028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_item_below_wtd_avg_5pct])/sum([count_item_above_wtd_avg_5pct]+[count_item_below_wtd_avg_5pct])' />
            </column>
            <column caption='% Active SKU Below 50Pct by vertical' datatype='real' name='[% Active SKU Below 75Pct by vertical (copy)_1297670075678228485]' role='measure' type='quantitative'>
