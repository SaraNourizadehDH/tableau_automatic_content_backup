            <format attr='text-format' field='[federated.0svw0ya0k72xbm10bcz401tz7j0v].[usr:Calculation_1553038196198420482:qk]' value='p0%' />
            <format attr='font-weight' field='[federated.0svw0ya0k72xbm10bcz401tz7j0v].[none:country_name:nk]' value='bold' />
            <format attr='font-weight' field='[federated.0svw0ya0k72xbm10bcz401tz7j0v].[none:Calculation_1989324462610870274:nk]' value='bold' />
          </style-rule>
          <style-rule element='table'>
            <format attr='background-color' value='#f5f5f5' />
          </style-rule>
          <style-rule element='title'>
            <format attr='background-color' value='#f5f5f5' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
