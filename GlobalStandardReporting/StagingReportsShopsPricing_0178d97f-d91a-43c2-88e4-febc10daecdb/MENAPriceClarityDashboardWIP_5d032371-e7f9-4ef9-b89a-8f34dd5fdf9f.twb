    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='[For Central team] List of SKUs with markup'>
      <repository-location id='ForCentralteamListofSKUswithmarkup' path='/t/GlobalStandardReporting/workbooks/MENAPriceClarityDashboardWIP' revision='' site='GlobalStandardReporting' />
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#f5f5f6' />
        </style-rule>
      </style>
      <size maxheight='2000' maxwidth='1320' minheight='2000' minwidth='1320' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='tableau_ls_item_price_mena (local_shops_analytics)' name='federated.0knh8kk0z3fes21fryx6s0yxzxh5' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Benchmark Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dmart Weighted Average of Sold Prices&quot;'>
          <calculation class='tableau' formula='&quot;Dmart Weighted Average of Sold Prices&quot;' />
          <members>
            <member value='&quot;25th Percentile of Listed Prices&quot;' />
            <member value='&quot;50th Percentile of Listed Prices&quot;' />
            <member value='&quot;75th Percentile of Listed Prices&quot;' />
            <member value='&quot;(Weighted Average + 5\% markup) of Sold Prices&quot;' />
            <member value='&quot;Dmart Weighted Average of Sold Prices&quot;' />
            <member value='&quot;[By Vertical] 25th Percentile of Listed Prices&quot;' />
            <member value='&quot;[By Vertical] 50th Percentile of Listed Prices&quot;' />
            <member value='&quot;[By Vertical] 75th Percentile of Listed Prices&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0knh8kk0z3fes21fryx6s0yxzxh5'>
        <column caption='Item Role' datatype='string' name='[item_role]' role='dimension' type='nominal' />
        <column-instance column='[item_role]' derivation='None' name='[none:item_role:nk]' pivot='key' type='nominal' />
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='99200' id='626' param='horz' type-v2='layout-flow' w='98788' x='606' y='400'>
            <zone h='99200' id='286' type-v2='layout-basic' w='98788' x='606' y='400'>
              <zone h='95302' id='23' param='vert' type-v2='layout-flow' w='98788' x='606' y='4298'>
                <zone fixed-size='50' h='2500' id='26' is-fixed='true' param='horz' type-v2='layout-flow' w='98788' x='606' y='4298'>
                  <zone fixed-size='540' h='2500' id='759' is-fixed='true' name='Return (2)' show-title='false' w='40720' x='606' y='4298'>
                    <layout-cache cell-count-h='1' type-h='cell' type-w='cell' />
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
