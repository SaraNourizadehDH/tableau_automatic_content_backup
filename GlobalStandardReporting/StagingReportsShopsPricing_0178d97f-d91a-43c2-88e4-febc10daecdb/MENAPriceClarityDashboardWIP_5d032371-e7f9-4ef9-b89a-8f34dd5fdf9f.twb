      <column caption='Benchmark Price' datatype='real' name='[Calculation_2211408171395112963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;25th Percentile of Listed Prices&quot; then [pct25_price]&#10;WHEN &quot;50th Percentile of Listed Prices&quot; then [med_price]&#10;WHEN &quot;75th Percentile of Listed Prices&quot; then [pct75_price]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [pct25_price_vertical]&#10;WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [med_price_vertical]&#10;WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [pct75_price_vertical]&#10;WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [shops_wtd_avg_price_lc]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [dmart_wtd_avg_price_lc]&#10;end' />
      </column>
      <column caption='Markup %' datatype='real' name='[Calculation_2211408171397038085]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(&#10;case [Parameters].[Parameter 1]&#10;when &quot;25th Percentile of Listed Prices&quot; then [Markup % (copy)_1297670074872569856]&#10;WHEN &quot;50th Percentile of Listed Prices&quot; then [Markup % (copy)_1297670074872569856]&#10;WHEN &quot;75th Percentile of Listed Prices&quot; then [Markup % (copy)_1297670074872569856]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [Markup % (copy)_1297670074872569856]&#10;WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [Markup % (copy)_1297670074872569856]&#10;WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [Markup % (copy)_1297670074872569856]&#10;WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [Markup % (listed price) (copy)_1297670074872692737]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [Markup % (copy)_1297670074872569856]&#10;end, 0)' />
      </column>
      <column caption='Last Sold Price LC (time series)' datatype='real' name='[Calculation_2211408171734286342]' role='measure' type='quantitative'>
