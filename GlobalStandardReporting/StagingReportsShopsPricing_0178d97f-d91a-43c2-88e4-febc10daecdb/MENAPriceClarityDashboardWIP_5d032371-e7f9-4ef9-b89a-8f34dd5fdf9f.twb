              <calculation class='tableau' formula='[Count of Global Product ID (copy)_6367526943144394752] / [Calculation_2565433372397506560]' />
            </column>
            <column caption='Markup % (only SKUs above benchmark)' datatype='real' name='[Calculation_1873990070250577920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Calculation_382665296199548930] when FALSE then [Calculation_2211408171397038085] END' />
            </column>
            <column caption='Benchmark Price' datatype='real' name='[Calculation_2211408171395112963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;25th Percentile of Listed Prices&quot; then [pct25_price]&#10;WHEN &quot;50th Percentile of Listed Prices&quot; then [med_price]&#10;WHEN &quot;75th Percentile of Listed Prices&quot; then [pct75_price]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [pct25_price_vertical]&#10;WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [med_price_vertical]&#10;WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [pct75_price_vertical]&#10;WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [shops_wtd_avg_price_lc]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [dmart_wtd_avg_price_lc]&#10;end' />
            </column>
            <column caption='Markup %' datatype='real' name='[Calculation_2211408171397038085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(&#10;case [Parameters].[Parameter 1]&#10;when &quot;25th Percentile of Listed Prices&quot; then [Markup % (copy)_1297670074872569856]&#10;WHEN &quot;50th Percentile of Listed Prices&quot; then [Markup % (copy)_1297670074872569856]&#10;WHEN &quot;75th Percentile of Listed Prices&quot; then [Markup % (copy)_1297670074872569856]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [Markup % (copy)_1297670074872569856]&#10;WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [Markup % (copy)_1297670074872569856]&#10;WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [Markup % (copy)_1297670074872569856]&#10;WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [Markup % (listed price) (copy)_1297670074872692737]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [Markup % (copy)_1297670074872569856]&#10;end, 0)' />
            </column>
            <column caption='Count of Global Product ID' datatype='integer' name='[Calculation_2565433372397506560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([global_product_id])' />
            </column>
            <column caption='Perspective 1' datatype='string' name='[Calculation_382665295505428480]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF     [Parameters].[Parameter 2 1] IN (&apos;Vertical&apos;,&#10;                         &apos;Vertical ▸ Country&apos;,&#10;                         &apos;Vertical ▸ Country ▸ Chain&apos;) &#10;THEN [mena_vertical]&#10;ELSEIF [Parameters].[Parameter 2 1] IN (&apos;Country&apos;,&#10;                         &apos;Country ▸ City&apos;, &apos;Country ▸ Chain&apos;,  &#10;                         &apos;Country ▸ Vertical&apos;,  &#10;                         &apos;Country ▸ Vertical ▸ Chain&apos;)  &#10;THEN [country_name]&#10;ELSEIF  [Parameters].[Parameter 2 1] = &apos;Region&apos; THEN &apos;MENA&apos;&#10;ELSEIF  [Parameters].[Parameter 2 1] IN (&apos;Chain&apos;,&apos;Chain ▸ Country&apos;) THEN [Chain_Name]&#10;ELSEIF  [Parameters].[Parameter 2 1] IN (&apos;Vendor&apos;) THEN [Local_Shop_Vendor_Name]&#10;ELSEIF [Parameters].[Parameter 2 1] in (&apos;PIM Level 1 ▸ Level 2&apos;) then [pim_level_one_name]&#10;END' />
            </column>
            <column caption='Below Benchmark Flag' datatype='boolean' name='[Calculation_382665296199548930]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;25th Percentile of Listed Prices&quot; then [below_25pct]&#10;WHEN &quot;50th Percentile of Listed Prices&quot; then [below_50pct]&#10;WHEN &quot;75th Percentile of Listed Prices&quot; then [below_75pct]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [below_25pct_vertical]&#10;WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [below_50pct_vertical]&#10;WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [below_75pct_vertical]&#10;WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [below_wtd_avg]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [below_dm_wtd_avg]&#10;end' />
            </column>
            <column caption='Entity ID+Chain ID+Chain Name' datatype='string' name='[Calculation_598838056941690880]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]+&quot;-&quot;+[Chain_ID]+&quot;-&quot;+[Chain_Name]' />
