              <zone fixed-size='79' forceUpdate='true' h='4350' id='279' is-fixed='true' type-v2='text' w='98636' x='682' y='16100'>
                <formatted-text>
                  <run fontcolor='#d61f26'> Please select the ranking parameter that you need.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#d61f26'>Click on </run>
                  <run bold='true' fontcolor='#d61f26'>[+] </run>
                  <run fontcolor='#d61f26'>over the field labels to zoom in/out t</run>
                  <run bold='true' fontcolor='#d61f26'>he Chain/Vendor and PIM Level 1/2 Categories</run>
                  <run fontcolor='#d61f26'>.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#d61f26'>Click on one cell, and you will be redirected to the </run>
                  <run bold='true' fontcolor='#d61f26'>Vendor View (List of SKUs) </run>
                  <run fontcolor='#d61f26'>page filtered by the Chain, Vendor, PIM Level 1/2, &quot;Date of Listed Price&quot; in the cell that you clicked on.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#d61f26'>Clicking on the selected cell again (when you see the hand icon hovering the cell) will </run>
                  <run bold='true' fontcolor='#d61f26'>deselect</run>
                  <run fontcolor='#d61f26'> the cell, and clear  the </run>
                  <run bold='true' fontcolor='#d61f26'>Vendor View (List of SKUs) </run>
                  <run fontcolor='#d61f26'>page.</run>
                </formatted-text>
