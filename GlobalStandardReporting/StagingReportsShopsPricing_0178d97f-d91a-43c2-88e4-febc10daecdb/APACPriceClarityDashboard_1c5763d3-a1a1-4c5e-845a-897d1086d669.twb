      <column caption='# Active SKU Below Benchmark' datatype='integer' name='[% Active SKU Below Benchmark (copy)_1553038196276400138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;25th Percentile of Listed Prices&quot; then [count_item_below_25pct]&#10;WHEN &quot;50th Percentile of Listed Prices&quot; then [count_item_below_50pct]&#10;WHEN &quot;75th Percentile of Listed Prices&quot; then [count_item_below_75pct]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [count_item_below_25pct_vertical]&#10;WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [count_item_below_50pct_vertical]&#10;WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [count_item_below_75pct_vertical]&#10;WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [count_item_below_wtd_avg_5pct]&#10;when &quot;Dmart Weighted Average of Sold Prices&quot; then [count_item_below_dm_wtd_avg_5pct]&#10;end' />
      </column>
      <column caption='% Active SKU Above Benchmark' datatype='real' name='[% Active SKU Below Benchmark (copy)_3059210798403952640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;25th Percentile of Listed Prices&quot; then 1-[Calculation_1553038196194746368]&#10;WHEN &quot;50th Percentile of Listed Prices&quot; then 1-[% Active SKU Below 25Pct (copy)_1553038196197724161]&#10;WHEN &quot;75th Percentile of Listed Prices&quot; then 1-[% Active SKU Below 50Pct (copy)_1553038196199620611]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then 1-[% Active SKU Below 25Pct (copy)_1150177187784769541]&#10;WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then 1-[% Active SKU Below 25Pct by vertical (copy)_1150177187785441286]&#10;WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then 1-[% Active SKU Below 50Pct by vertical (copy)_1150177187785662471]&#10;WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then 1-[% Active SKU Below 75Pct (copy)_1553038196199809028]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then 1-[% Active SKU Below (Weighted Avg + 5% markup) (copy)_793829822748823552]&#10;end' />
      </column>
      <column caption='% Markup (Latest Price vs Benchmark)' datatype='real' name='[% Markup Price vs Benchmark (copy)_5689453706186297344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([LOD Best Selling Qty (copy)_5093078658187988996] - [Calculation_3831015230577049602])/[Calculation_3831015230577049602]' />
      </column>
      <column caption='% active SKU&apos;s latest price 5% above benchmark' datatype='real' name='[% active SKU&apos;s latest price above benchmark (copy)_1989324462606860288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[CNTD Global Product ID (Latest Price above benchmark) (copy)_1989324462606983169]/COUNTD([global_product_id])' />
      </column>
      <column caption='% active SKU&apos;s latest price above benchmark' datatype='real' name='[% active SKU&apos;s price above benchmark (copy)_5093078658189844487]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[CNTD Master ID (Price above benchmark) (copy)_5093078658189520901]/COUNTD([global_product_id])' />
      </column>
      <column caption='LOD Best Selling Qty' datatype='real' name='[Benchmark (Weighted Average Price) (copy)_3831015230582169604]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id], [City],[master_id]: MAX([Qty])}' />
      </column>
      <column caption='(fail fast) Best Selling Price (&lt;Parameters.Benchmark Type&gt;)' datatype='real' name='[Best Selling Qty (copy)_3831015230583197701]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Qty] = [Benchmark (Weighted Average Price) (copy)_3831015230582169604] then [Price] END' />
      </column>
      <column caption='CNTD Global Product ID (Latest Price 5% above benchmark)' datatype='integer' name='[CNTD Global Product ID (Latest Price above benchmark) (copy)_1989324462606983169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if ([LOD Best Selling Qty (copy)_5093078658187988996] - [Calculation_3831015230577049602])/ [Calculation_3831015230577049602] &gt; 0.05 then [global_product_id] end)' />
      </column>
      <column caption='CNTD Global Product ID (Latest Price above benchmark)' datatype='integer' name='[CNTD Master ID (Price above benchmark) (copy)_5093078658189520901]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [LOD Best Selling Qty (copy)_5093078658187988996] &gt; [Calculation_3831015230577049602] then [global_product_id] end)' />
      </column>
      <column caption='% Active SKU Below 25Pct' datatype='real' name='[Calculation_1553038196194746368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([count_item_below_25pct])/sum([total])' />
      </column>
      <column caption='% Active SKU Below Benchmark' datatype='real' default-format='p0.00%' name='[Calculation_1553038196198420482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;25th Percentile of Listed Prices&quot; then [Calculation_1553038196194746368]&#10;WHEN &quot;50th Percentile of Listed Prices&quot; then [% Active SKU Below 25Pct (copy)_1553038196197724161]&#10;WHEN &quot;75th Percentile of Listed Prices&quot; then [% Active SKU Below 50Pct (copy)_1553038196199620611]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [% Active SKU Below 25Pct (copy)_1150177187784769541]&#10;WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [% Active SKU Below 25Pct by vertical (copy)_1150177187785441286]&#10;WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [% Active SKU Below 50Pct by vertical (copy)_1150177187785662471]&#10;WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [% Active SKU Below 75Pct (copy)_1553038196199809028]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [% Active SKU Below (Weighted Avg + 5% markup) (copy)_793829822748823552]&#10;end' />
      </column>
      <column caption='Persp #1' datatype='string' name='[Calculation_1553038196263419910]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF     [Parameters].[Parameter 2 1] IN (&apos;Vertical&apos;,&#10;                         &apos;Vertical ▸ Country&apos;,&#10;                         &apos;Vertical ▸ Country ▸ Chain&apos;) &#10;THEN [vertical_type]&#10;ELSEIF [Parameters].[Parameter 2 1] IN (&apos;Country&apos;,&#10;                         &apos;Country ▸ City&apos;, &apos;Country ▸ Chain&apos;,  &#10;                         &apos;Country ▸ Vertical&apos;,  &#10;                         &apos;Country ▸ Vertical ▸ Chain&apos;)  &#10;THEN [country_name]&#10;ELSEIF  [Parameters].[Parameter 2 1] = &apos;Region&apos; THEN &apos;APAC&apos;&#10;ELSEIF  [Parameters].[Parameter 2 1] IN (&apos;Chain&apos;,&apos;Chain ▸ Country&apos;) THEN [Catalog_Chain_Name]&#10;ELSEIF [Parameters].[Parameter 2 1] in (&apos;PIM Level 1 ▸ Level 2&apos;) then [pim_level_one_name]&#10;END' />
      </column>
      <column caption='Persp #2' datatype='string' name='[Calculation_1553038196265345033]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF     [Parameters].[Parameter 2 1] in (&apos;Vertical ▸ Country&apos; , &apos;Chain ▸ Country&apos; ,&#10;                         &apos;Vertical ▸ Country ▸ Chain&apos;)&#10;THEN [country_name]&#10;ELSEIF [Parameters].[Parameter 2 1] IN (&apos;Country ▸ Vertical&apos;,&apos;Country ▸ Vertical ▸ Chain&apos;&#10;                         )&#10;THEN [vertical_type]&#10;ELSEIF [Parameters].[Parameter 2 1] IN ( &#10;                         &apos;Country ▸ City&apos;&#10;                         )&#10;THEN [City]&#10;ELSEIF [Parameters].[Parameter 2 1] IN ( &#10;                         &apos;Country ▸ Chain&apos;,&#10;                         &apos;Vertical ▸ Chain&apos;&#10;                         )&#10;THEN [Catalog_Chain_Name]&#10;&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Country&apos; THEN &apos;All&apos;&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Vertical&apos; THEN &apos;All&apos;&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Region&apos; THEN &apos;All&apos;&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Chain&apos; THEN &apos;All&apos;&#10;ELSEIF [Parameters].[Parameter 2 1] in (&apos;PIM Level 1 ▸ Level 2&apos;) then [pim_level_two_name]&#10;END' />
      </column>
      <column caption='Region' datatype='string' name='[Calculation_1989324462610870274]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Asia&quot;' />
      </column>
      <column caption='Quarter' datatype='string' name='[Calculation_2316187263679893504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(Year([date_of_listed_price]))+&quot;-Q&quot;+str(QUARTER([date_of_listed_price]))' />
