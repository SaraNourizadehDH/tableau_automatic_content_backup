      <column caption='# of SKU' datatype='integer' name='[Calculation_1150177186797015042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([global_product_id])' />
      </column>
      <column caption='Perspective 1' datatype='string' name='[Calculation_1251015598688698368]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF     [Parameters].[Parameter 2 1] IN (&apos;Vertical&apos;,&#10;                         &apos;Vertical ▸ Country&apos;,&#10;                         &apos;Vertical ▸ Country ▸ Chain&apos;) &#10;THEN [vertical_type]&#10;ELSEIF [Parameters].[Parameter 2 1] IN (&apos;Country&apos;,&#10;                         &apos;Country ▸ City&apos;, &apos;Country ▸ Chain&apos;,  &#10;                         &apos;Country ▸ Vertical&apos;,  &#10;                         &apos;Country ▸ Vertical ▸ Chain&apos;)  &#10;THEN [country_name]&#10;ELSEIF  [Parameters].[Parameter 2 1] = &apos;Region&apos; THEN &apos;APAC&apos;&#10;ELSEIF  [Parameters].[Parameter 2 1] IN (&apos;Chain&apos;,&apos;Chain ▸ Country&apos;) THEN [Chain_Name]&#10;ELSEIF [Parameters].[Parameter 2 1] in (&apos;PIM Level 1 ▸ Level 2&apos;) then [pim_level_one_name]&#10;END' />
      </column>
      <column caption='Listed Price Date' datatype='date' name='[Calculation_2211408171349479424]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date(DATETRUNC(&apos;day&apos;, [date_of_listed_price]))' />
      </column>
      <column caption='Last Sold Date' datatype='date' name='[Calculation_2211408171349684225]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date(DATETRUNC(&apos;day&apos;, [last_sold_date]))' />
      </column>
      <column caption='Month' datatype='date' name='[Calculation_2211408171378167810]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date(DATETRUNC(&apos;month&apos;,[Calculation_2211408171349479424]))' />
      </column>
      <column caption='Benchmark Price' datatype='real' name='[Calculation_2211408171395112963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;25th Percentile of Listed Prices&quot; then [pct25_price]&#10;WHEN &quot;50th Percentile of Listed Prices&quot; then [med_price]&#10;WHEN &quot;75th Percentile of Listed Prices&quot; then [pct75_price]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [pct25_price_vertical]&#10;WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [med_price_vertical]&#10;WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [pct75_price_vertical]&#10;WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [weighted_avg_price_lc]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [wtd_avg_price_lc]&#10;end' />
      </column>
      <column caption='Markup %' datatype='real' name='[Calculation_2211408171397038085]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;25th Percentile of Listed Prices&quot; then [Markup % (copy)_1150177186776944641]&#10;WHEN &quot;50th Percentile of Listed Prices&quot; then [Markup % (copy)_1150177186776944641]&#10;WHEN &quot;75th Percentile of Listed Prices&quot; then [Markup % (copy)_1150177186776944641]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [Markup % (copy)_1150177186776944641]&#10;WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [Markup % (copy)_1150177186776944641]&#10;WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [Markup % (copy)_1150177186776944641]&#10;WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [Markup % (copy)_1150177186775449600]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [Markup % (copy)_1150177186776944641]&#10;end' />
      </column>
      <column caption='Last Sold Price LC (time series)' datatype='real' name='[Calculation_2211408171734286342]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_2211408171349684225] = [Calculation_2211408171735625735] then [last_sold_price_lc] end' />
      </column>
      <column caption='Last Sold Date (Max)' datatype='date' name='[Calculation_2211408171735625735]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id], [City],[master_id],[Calculation_2211408171378167810]: max([Calculation_2211408171349684225])}' />
      </column>
      <column caption='Below Benchmark Flag' datatype='boolean' name='[Calculation_2556285435107262464]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;25th Percentile of Listed Prices&quot; then [below_25pct]&#10;WHEN &quot;50th Percentile of Listed Prices&quot; then [below_50pct]&#10;WHEN &quot;75th Percentile of Listed Prices&quot; then [below_75pct]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [below_25pct_vertical]&#10;WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [below_50pct_vertical]&#10;WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [below_75pct_vertical]&#10;WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [below_wtd_avg]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [below_dm_wtd_avg]&#10;end' />
      </column>
      <column caption='Benchmark (Weighted Average Listed Price)' datatype='real' name='[Calculation_3831015230577049602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id], [City],[master_id]: sum([Price]*[Qty])/sum([Qty])}' />
      </column>
      <column caption='% Markup Price vs Benchmark' datatype='real' name='[Calculation_3831015230580518915]' role='measure' type='quantitative'>
