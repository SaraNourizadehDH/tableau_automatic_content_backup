      <table>
        <view>
          <datasources>
            <datasource caption='ls_listed_price_apac_vendor_cat' name='federated.1vs9nw113iqmz5127d8m30myocm7 (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Benchmark Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;[By Vertical] 25th Percentile of Listed Prices&quot;'>
              <calculation class='tableau' formula='&quot;[By Vertical] 25th Percentile of Listed Prices&quot;' />
            </column>
            <column caption='Rank By Calculated Amount (Assortment View):' datatype='string' name='[Rank By Calculated Amount (Vendor View): (copy)_2730659141063684098]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Active SKU Below Benchmark&quot;'>
              <calculation class='tableau' formula='&quot;% Active SKU Below Benchmark&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vs9nw113iqmz5127d8m30myocm7 (copy)'>
            <column caption='# Total Active SKU*' datatype='integer' name='[# Active SKU Below Benchmark (copy)_1553038196279808011]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;25th Percentile of Listed Prices&quot; then [total]&#10;WHEN &quot;50th Percentile of Listed Prices&quot; then [total]&#10;WHEN &quot;75th Percentile of Listed Prices&quot; then [total]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [total]&#10;WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [total]&#10;WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [total]&#10;WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then ([total] - [count_item_without_wtd_avg])&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then ([total] - [count_item_without_dm_wtd_avg])&#10;end' />
            </column>
            <column caption='% Active SKU Below (Dmart Weighted Avg)' datatype='real' name='[% Active SKU Below (Weighted Avg + 5% markup) (copy)_793829822748823552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_item_below_dm_wtd_avg_5pct])/sum([count_item_above_dm_wtd_avg_5pct]+[count_item_below_dm_wtd_avg_5pct])' />
            </column>
            <column caption='% Active SKU Below 25Pct by vertical' datatype='real' name='[% Active SKU Below 25Pct (copy)_1150177187784769541]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_item_below_25pct_vertical])/sum([total])' />
            </column>
            <column caption='% Active SKU Below 50Pct' datatype='real' name='[% Active SKU Below 25Pct (copy)_1553038196197724161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_item_below_50pct])/sum([total])' />
            </column>
            <column caption='% Active SKU Below 50Pct by vertical' datatype='real' name='[% Active SKU Below 25Pct by vertical (copy)_1150177187785441286]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_item_below_50pct_vertical])/sum([total])' />
            </column>
            <column caption='% Active SKU Below 75Pct' datatype='real' name='[% Active SKU Below 50Pct (copy)_1553038196199620611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_item_below_75pct])/sum([total])' />
            </column>
            <column caption='% Active SKU Below 75Pct by vertical' datatype='real' name='[% Active SKU Below 50Pct by vertical (copy)_1150177187785662471]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_item_below_75pct_vertical])/sum([total])' />
            </column>
            <column caption='% Active SKU Below (Weighted Avg + 5% markup)' datatype='real' name='[% Active SKU Below 75Pct (copy)_1553038196199809028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_item_below_wtd_avg_5pct])/sum([count_item_above_wtd_avg_5pct]+[count_item_below_wtd_avg_5pct])' />
            </column>
            <column caption='% Active SKU Below 25Pct' datatype='real' name='[Calculation_1553038196194746368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([count_item_below_25pct])/sum([total])' />
            </column>
            <column caption='% Active SKU Below Benchmark' datatype='real' default-format='p0.00%' name='[Calculation_1553038196198420482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;25th Percentile of Listed Prices&quot; then [Calculation_1553038196194746368]&#10;WHEN &quot;50th Percentile of Listed Prices&quot; then [% Active SKU Below 25Pct (copy)_1553038196197724161]&#10;WHEN &quot;75th Percentile of Listed Prices&quot; then [% Active SKU Below 50Pct (copy)_1553038196199620611]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [% Active SKU Below 25Pct (copy)_1150177187784769541]&#10;WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [% Active SKU Below 25Pct by vertical (copy)_1150177187785441286]&#10;WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [% Active SKU Below 50Pct by vertical (copy)_1150177187785662471]&#10;WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [% Active SKU Below 75Pct (copy)_1553038196199809028]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [% Active SKU Below (Weighted Avg + 5% markup) (copy)_793829822748823552]&#10;end' />
            </column>
            <column caption='# of L2 Categories listed' datatype='integer' name='[Calculation_458804232750358528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([pim_level_two_name])' />
            </column>
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Salesforce Vendor Name' datatype='string' name='[Local_Shop_Vendor_Name]' role='dimension' type='nominal' />
