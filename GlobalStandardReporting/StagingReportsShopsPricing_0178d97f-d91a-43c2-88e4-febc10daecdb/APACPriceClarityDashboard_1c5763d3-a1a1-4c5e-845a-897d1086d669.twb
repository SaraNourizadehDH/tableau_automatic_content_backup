      </column>
      <column caption='Rank By Absolute Amount (Vendor View):' datatype='integer' name='[Calculation_458804234246348831]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;# Total Active SKU&apos;  THEN [# Active SKU Below Benchmark (copy)_1553038196279808011]&#10;//WHEN &apos;# L2 Categories listed&apos; then [# of L2 Categories listed]&#10;//when &apos;% Active SKU Below Benchmark&apos; then [% Active SKU Below Benchmark]&#10;when &apos;# Monthly Price Updates&apos; then [MTD_Price_Update_Count (copy)_458804233552117778]&#10;when &apos;# Monthly Order Count&apos; then [Calculation_458804233551650833]&#10;end' />
