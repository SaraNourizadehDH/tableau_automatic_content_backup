            <column caption='Count Item Below Dm Wtd Avg 5Pct' datatype='integer' name='[count_item_below_dm_wtd_avg_5pct]' role='measure' type='quantitative' />
            <column caption='Count Item Below Wtd Avg 5Pct' datatype='integer' name='[count_item_below_wtd_avg_5pct]' role='measure' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[Calculation_1989324462610870274]' derivation='None' name='[none:Calculation_1989324462610870274:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
