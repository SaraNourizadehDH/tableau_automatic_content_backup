    <worksheet name='SKU Distribution'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#d61f26'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_ls_item_price_apac' name='federated.121uy961ejpozi16d9sgx0sdudhf (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Benchmark Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;[By Vertical] 25th Percentile of Listed Prices&quot;'>
              <calculation class='tableau' formula='&quot;[By Vertical] 25th Percentile of Listed Prices&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.121uy961ejpozi16d9sgx0sdudhf (copy)'>
            <column datatype='string' name='[Barcodes]' role='dimension' type='nominal' />
            <column caption='# of SKU' datatype='integer' name='[Calculation_1150177186797015042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([global_product_id])' />
            </column>
            <column caption='Benchmark Price' datatype='real' name='[Calculation_2211408171395112963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;25th Percentile of Listed Prices&quot; then [pct25_price]&#10;WHEN &quot;50th Percentile of Listed Prices&quot; then [med_price]&#10;WHEN &quot;75th Percentile of Listed Prices&quot; then [pct75_price]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [pct25_price_vertical]&#10;WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [med_price_vertical]&#10;WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [pct75_price_vertical]&#10;WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [weighted_avg_price_lc]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [wtd_avg_price_lc]&#10;end' />
            </column>
            <column caption='Markup %' datatype='real' name='[Calculation_2211408171397038085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;25th Percentile of Listed Prices&quot; then [Markup % (copy)_1150177186776944641]&#10;WHEN &quot;50th Percentile of Listed Prices&quot; then [Markup % (copy)_1150177186776944641]&#10;WHEN &quot;75th Percentile of Listed Prices&quot; then [Markup % (copy)_1150177186776944641]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [Markup % (copy)_1150177186776944641]&#10;WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [Markup % (copy)_1150177186776944641]&#10;WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [Markup % (copy)_1150177186776944641]&#10;WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [Markup % (copy)_1150177186775449600]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [Markup % (copy)_1150177186776944641]&#10;end' />
            </column>
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Local Shop Vendor Name' datatype='string' name='[Local_Shop_Vendor_Name]' role='dimension' type='nominal' />
            <column caption='Markup % (sold price)' datatype='real' name='[Markup % (copy)_1150177186775449600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([last_sold_price_lc] - [Calculation_2211408171395112963])/[Calculation_2211408171395112963]' />
            </column>
            <column caption='Markup % (listed price)' datatype='real' name='[Markup % (copy)_1150177186776944641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Price_Local] - [Calculation_2211408171395112963])/[Calculation_2211408171395112963]' />
            </column>
            <column caption='Listed Price LC' datatype='real' name='[Price_Local]' role='measure' type='quantitative' />
            <column caption='Product Name' datatype='string' name='[Product_Name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2211408171397038085]' derivation='Avg' name='[avg:Calculation_2211408171397038085:qk]' pivot='key' type='quantitative' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date Of Listed Price' datatype='date' name='[date_of_listed_price]' role='dimension' type='ordinal' />
            <column caption='Global Product Id' datatype='string' name='[global_product_id]' role='dimension' type='nominal' />
            <column caption='Last Sold Price LC' datatype='real' name='[last_sold_price_lc]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Master ID' datatype='integer' name='[master_id]' role='dimension' type='ordinal' />
            <column caption='Median Listed Price LC' datatype='real' name='[med_price]' role='measure' type='quantitative' />
            <column datatype='real' name='[med_price_vertical]' role='measure' type='quantitative' />
            <column-instance column='[Barcodes]' derivation='None' name='[none:Barcodes:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2211408171397038085]' derivation='None' name='[none:Calculation_2211408171397038085:qk]' pivot='key' type='quantitative' />
