            </column>
            <column caption='Rank By Calculated Amount (Assortment View):' datatype='real' name='[Rank By Calculated Amount (Vendor View): (copy)_2730659141064032260]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Rank By Calculated Amount (Vendor View): (copy)_2730659141063684098]&#10;//WHEN &apos;# Active SKU&apos;  THEN [# Total Active SKU*]&#10;WHEN &apos;# L2 Categories listed&apos; then [Calculation_458804232750358528]&#10;when &apos;% Active SKU Below Benchmark&apos; then [Calculation_1553038196198420482]&#10;//when &apos;Monthly Price Updates&apos; then [Monthly Price Update Count]&#10;//when &apos;Monthly Order Count&apos; then [Monthly Order Count]&#10;end' />
            </column>
