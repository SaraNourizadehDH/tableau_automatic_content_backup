            <column caption='% Active SKU Below Benchmark' datatype='real' default-format='p0.00%' name='[Calculation_1553038196198420482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;25th Percentile of Listed Prices&quot; then [Calculation_1553038196194746368]&#10;WHEN &quot;50th Percentile of Listed Prices&quot; then [% Active SKU Below 25Pct (copy)_1553038196197724161]&#10;WHEN &quot;75th Percentile of Listed Prices&quot; then [% Active SKU Below 50Pct (copy)_1553038196199620611]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [% Active SKU Below 25Pct (copy)_1150177187784769541]&#10;WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [% Active SKU Below 25Pct by vertical (copy)_1150177187785441286]&#10;WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [% Active SKU Below 50Pct by vertical (copy)_1150177187785662471]&#10;WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [% Active SKU Below 75Pct (copy)_1553038196199809028]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [% Active SKU Below (Weighted Avg + 5% markup) (copy)_793829822748823552]&#10;end' />
            </column>
            <column caption='Persp #1' datatype='string' name='[Calculation_1553038196263419910]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF     [Parameters].[Parameter 2 1] IN (&apos;Vertical&apos;,&#10;                         &apos;Vertical ▸ Country&apos;,&#10;                         &apos;Vertical ▸ Country ▸ Chain&apos;) &#10;THEN [vertical_type]&#10;ELSEIF [Parameters].[Parameter 2 1] IN (&apos;Country&apos;,&#10;                         &apos;Country ▸ City&apos;, &apos;Country ▸ Chain&apos;,  &#10;                         &apos;Country ▸ Vertical&apos;,  &#10;                         &apos;Country ▸ Vertical ▸ Chain&apos;)  &#10;THEN [country_name]&#10;ELSEIF  [Parameters].[Parameter 2 1] = &apos;Region&apos; THEN &apos;APAC&apos;&#10;ELSEIF  [Parameters].[Parameter 2 1] IN (&apos;Chain&apos;,&apos;Chain ▸ Country&apos;) THEN [Catalog_Chain_Name]&#10;ELSEIF [Parameters].[Parameter 2 1] in (&apos;PIM Level 1 ▸ Level 2&apos;) then [pim_level_one_name]&#10;END' />
            </column>
            <column caption='Persp #2' datatype='string' name='[Calculation_1553038196265345033]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF     [Parameters].[Parameter 2 1] in (&apos;Vertical ▸ Country&apos; , &apos;Chain ▸ Country&apos; ,&#10;                         &apos;Vertical ▸ Country ▸ Chain&apos;)&#10;THEN [country_name]&#10;ELSEIF [Parameters].[Parameter 2 1] IN (&apos;Country ▸ Vertical&apos;,&apos;Country ▸ Vertical ▸ Chain&apos;&#10;                         )&#10;THEN [vertical_type]&#10;ELSEIF [Parameters].[Parameter 2 1] IN ( &#10;                         &apos;Country ▸ City&apos;&#10;                         )&#10;THEN [City]&#10;ELSEIF [Parameters].[Parameter 2 1] IN ( &#10;                         &apos;Country ▸ Chain&apos;,&#10;                         &apos;Vertical ▸ Chain&apos;&#10;                         )&#10;THEN [Catalog_Chain_Name]&#10;&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Country&apos; THEN &apos;All&apos;&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Vertical&apos; THEN &apos;All&apos;&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Region&apos; THEN &apos;All&apos;&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Chain&apos; THEN &apos;All&apos;&#10;ELSEIF [Parameters].[Parameter 2 1] in (&apos;PIM Level 1 ▸ Level 2&apos;) then [pim_level_two_name]&#10;END' />
