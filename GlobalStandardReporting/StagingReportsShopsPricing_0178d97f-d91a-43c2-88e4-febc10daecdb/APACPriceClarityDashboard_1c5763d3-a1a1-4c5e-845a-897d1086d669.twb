              <zone forceUpdate='true' h='5000' id='11' type-v2='text' w='81440' x='606' y='4300'>
                <formatted-text>
                  <run fontcolor='#d61f26'>Please see the </run>
                  <run bold='true' fontcolor='#d61f26'>Glossary</run>
                  <run fontcolor='#d61f26'> tab for the definition of the metrics.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#d61f26'>Select </run>
                  <run fontcolor='#d61f26' fontname='Tableau Semibold'>Benchmark Type </run>
                  <run fontcolor='#d61f26'>to view metrics using different benchmarks. </run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#d61f26'>Shortlist </run>
                  <run bold='true' fontcolor='#d61f26'>the Chain or Vendor</run>
                  <run fontcolor='#d61f26'> with the Catalog or Salesforce Chain/Vendor filters, or select the </run>
                  <run bold='true' fontcolor='#d61f26'>Account Manager.</run>
                  <run fontcolor='#d61f26'>Æ </run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#d61f26'>There are </run>
                  <run bold='true' fontcolor='#d61f26'>2 tables</run>
                  <run fontcolor='#d61f26'>: Vendors/Categories ranked by the Calculated Amount, and ranked by the Absolute Amount.</run>
