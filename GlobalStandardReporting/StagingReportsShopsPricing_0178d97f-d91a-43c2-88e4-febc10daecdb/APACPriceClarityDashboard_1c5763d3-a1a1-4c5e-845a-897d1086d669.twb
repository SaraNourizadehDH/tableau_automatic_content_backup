    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='[APAC] Price Clarity - Assortment View'>
      <repository-location id='APACPriceClarity-AssortmentView' path='/t/GlobalStandardReporting/workbooks/APACPriceClarityDashboardWIP' revision='' site='GlobalStandardReporting' />
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#f5f5f6' />
        </style-rule>
      </style>
      <size maxheight='2000' maxwidth='1320' minheight='2000' minwidth='1320' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='ls_listed_price_apac_vendor_cat' name='federated.1vs9nw113iqmz5127d8m30myocm7 (copy)' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Benchmark Type' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;[By Vertical] 25th Percentile of Listed Prices&quot;'>
          <calculation class='tableau' formula='&quot;[By Vertical] 25th Percentile of Listed Prices&quot;' />
          <members>
            <member value='&quot;25th Percentile of Listed Prices&quot;' />
            <member value='&quot;50th Percentile of Listed Prices&quot;' />
            <member value='&quot;75th Percentile of Listed Prices&quot;' />
            <member value='&quot;(Weighted Average + 5\% markup) of Sold Prices&quot;' />
            <member value='&quot;Dmart Weighted Average of Sold Prices&quot;' />
            <member value='&quot;[By Vertical] 25th Percentile of Listed Prices&quot;' />
            <member value='&quot;[By Vertical] 50th Percentile of Listed Prices&quot;' />
            <member value='&quot;[By Vertical] 75th Percentile of Listed Prices&quot;' />
          </members>
        </column>
        <column caption='Rank By Absolute Amount (Assortment View):' datatype='string' name='[Rank By Absolute Amount (Vendor View): (copy)_2730659141063516161]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Total Active SKU&quot;'>
          <calculation class='tableau' formula='&quot;# Total Active SKU&quot;' />
          <members>
            <member value='&quot;\# Total Active SKU&quot;' />
            <member value='&quot;\# Monthly Price Updates&quot;' />
            <member value='&quot;\# Monthly Order Count&quot;' />
          </members>
        </column>
        <column caption='Rank By Calculated Amount (Assortment View):' datatype='string' name='[Rank By Calculated Amount (Vendor View): (copy)_2730659141063684098]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Active SKU Below Benchmark&quot;'>
          <calculation class='tableau' formula='&quot;% Active SKU Below Benchmark&quot;' />
          <members>
            <member value='&quot;\% Active SKU Below Benchmark&quot;' />
            <member value='&quot;\# L2 Categories listed&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1vs9nw113iqmz5127d8m30myocm7 (copy)'>
        <column caption='% Active SKU Below Benchmark' datatype='real' default-format='p0.00%' name='[Calculation_1553038196198420482]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &quot;25th Percentile of Listed Prices&quot; then [Calculation_1553038196194746368]&#10;WHEN &quot;50th Percentile of Listed Prices&quot; then [% Active SKU Below 25Pct (copy)_1553038196197724161]&#10;WHEN &quot;75th Percentile of Listed Prices&quot; then [% Active SKU Below 50Pct (copy)_1553038196199620611]&#10;when &quot;[By Vertical] 25th Percentile of Listed Prices&quot; then [% Active SKU Below 25Pct (copy)_1150177187784769541]&#10;WHEN &quot;[By Vertical] 50th Percentile of Listed Prices&quot; then [% Active SKU Below 25Pct by vertical (copy)_1150177187785441286]&#10;WHEN &quot;[By Vertical] 75th Percentile of Listed Prices&quot; then [% Active SKU Below 50Pct by vertical (copy)_1150177187785662471]&#10;WHEN &quot;(Weighted Average + 5% markup) of Sold Prices&quot; then [% Active SKU Below 75Pct (copy)_1553038196199809028]&#10;WHEN &quot;Dmart Weighted Average of Sold Prices&quot; then [% Active SKU Below (Weighted Avg + 5% markup) (copy)_793829822748823552]&#10;end' />
        </column>
        <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
        <column caption='Salesforce Vendor Name' datatype='string' name='[Local_Shop_Vendor_Name]' role='dimension' type='nominal' />
        <column caption='Pim Level One Name (c)' datatype='string' name='[Pim Level One Name (copy)_458804233185075210]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='[pim_level_one_name]' />
        </column>
        <column caption='Pim Level Two Name (c)' datatype='string' name='[Pim Level Two Name (copy)_458804233185366027]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='[pim_level_two_name]' />
        </column>
        <column caption='Account Manager' datatype='string' name='[account_manager]' role='dimension' type='nominal' />
        <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column caption='Date Of Listed Price' datatype='date' name='[date_of_listed_price]' role='dimension' type='ordinal' />
        <column-instance column='[City]' derivation='None' name='[none:City:nk]' pivot='key' type='nominal' />
