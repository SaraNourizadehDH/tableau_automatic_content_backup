            </column>
            <column caption='Item Role' datatype='string' name='[Calculation_1199716722519269394]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [GMV Cumulative (copy)_1199716722512764945] &lt;= 0.25 then &quot;KVI&quot;&#10;ELSEIF [GMV Cumulative (copy)_1199716722512764945] &lt;= 0.65 then &quot;Mass&quot;&#10;Else &quot;Long Tail&quot;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Total Order Count' datatype='integer' name='[Calculation_185632754484436992]' role='measure' type='quantitative'>
