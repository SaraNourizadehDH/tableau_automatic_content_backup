          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1x8so6t02mqxs21bty7g0094fpur'>
            <column caption='Warning Message' datatype='string' name='[Calculation_1199716723486441493]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Weightage of Customer Frequency Normalized (copy)_1199716723482640404] + [Parameters].[Weightage of GMV Normalized (copy)_1199716723482423315] + [Parameters].[Parameter 2] = 1&#10;&#10;          THEN &apos;All good! The weightage added up to 1.&apos;&#10;&#10;          ELSE &apos;Weightage must add up to 1.  Please make adjustments.&apos;&#10;&#10;          END' />
