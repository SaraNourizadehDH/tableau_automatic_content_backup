    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Item Role Dashboard'>
      <repository-location id='ItemRoleDashboard' path='/t/GlobalStandardReporting/workbooks/ItemRole' revision='' site='GlobalStandardReporting' />
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#f5f5f6' />
        </style-rule>
        <style-rule element='parameter-ctrl-title'>
          <format attr='text-align' value='auto' />
        </style-rule>
      </style>
      <size maxheight='2000' maxwidth='1320' minheight='2000' minwidth='1320' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='item_role_export (local_shops_analytics)' name='federated.1x8so6t02mqxs21bty7g0094fpur' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Weightage of GMV Normalized' datatype='real' default-format='p0%' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='0.4'>
          <calculation class='tableau' formula='0.4' />
          <range max='1.0' min='0.0' />
        </column>
        <column caption='Weightage of Basket Penetration Normalized' datatype='real' default-format='p0%' name='[Weightage of Customer Frequency Normalized (copy)_1199716723482640404]' param-domain-type='range' role='measure' type='quantitative' value='0.4'>
          <calculation class='tableau' formula='0.4' />
          <range max='1.0' min='0.0' />
        </column>
        <column caption='Weightage of Customer Frequency Normalized' datatype='real' default-format='p0%' name='[Weightage of GMV Normalized (copy)_1199716723482423315]' param-domain-type='range' role='measure' type='quantitative' value='0.2'>
          <calculation class='tableau' formula='0.2' />
          <range max='1.0' min='0.0' />
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1x8so6t02mqxs21bty7g0094fpur'>
        <column caption='Customer Frequency' datatype='real' name='[Calculation_1199716722448654338]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='{ FIXED [master_id]: sum([order_count]) / sum([customer_count]) }' />
        </column>
        <column-instance column='[Calculation_1199716722448654338]' derivation='Attribute' name='[attr:Calculation_1199716722448654338:qk]' pivot='key' type='quantitative' />
        <column caption='City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
        <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column caption='Customer Count' datatype='integer' name='[customer_count]' role='measure' type='quantitative' />
        <column-instance column='[city_name]' derivation='None' name='[none:city_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[zone_name]' derivation='None' name='[none:zone_name:nk]' pivot='key' type='nominal' />
        <column-instance column='[customer_count]' derivation='Sum' name='[sum:customer_count:qk]' pivot='key' type='quantitative' />
        <column caption='Zone Name' datatype='string' name='[zone_name]' role='dimension' type='nominal' />
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='95350' id='23' param='vert' type-v2='layout-flow' w='98788' x='606' y='4250'>
            <zone fixed-size='415' h='20750' id='26' is-fixed='true' param='horz' type-v2='layout-flow' w='98788' x='606' y='4250'>
              <zone forceUpdate='true' h='20750' id='11' type-v2='text' w='98788' x='606' y='4250'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Quick Guide:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>1. Please select the </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Country, City, and Zone(s) </run>
                  <run fontcolor='#000000' fontsize='10'>where you want to check the </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Item Roles</run>
                  <run fontcolor='#000000' fontsize='10'>. The data comes from only the </run>
                  <run bold='true' fontcolor='#d61f26' fontsize='10'>Supermarket</run>
                  <run fontcolor='#000000' fontsize='10'> vertical.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>2. The list is </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>updated</run>
                  <run fontcolor='#000000' fontsize='10'>Æ </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>dynamically </run>
                  <run fontcolor='#000000' fontsize='10'>based on the selected Country, City, and Zone(s).</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>3. The data is available for the </run>
                  <run bold='true' fontcolor='#d61f26' fontsize='10'>7 markets in Talabat</run>
                  <run fontcolor='#d61f26' fontsize='10'>, </run>
                  <run bold='true' fontcolor='#d61f26' fontsize='10'>over Q1 2023</run>
                  <run fontcolor='#000000' fontsize='10'>.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>4.</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'> Basket Penetration </run>
                  <run fontcolor='#000000' fontsize='10'>= # of Orders for the SKU / # of Total Orders in the selected Country, City and Zone(s).</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>5. </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Customer Frequency</run>
                  <run fontcolor='#000000' fontsize='10'> = # of Orders / # of Customers for each SKU.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>6. </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Normalization</run>
                  <run fontcolor='#000000' fontsize='10'> of </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>GMV, Basket Penetration and Customer Frequency</run>
                  <run fontcolor='#000000' fontsize='10'> for the calculation of the KVI Score: </run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>     The </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Normalized</run>
                  <run fontcolor='#000000' fontsize='10'> values are the Z-Score of </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>GMV, Basket Penetration and Customer Frequency, </run>
                  <run fontcolor='#000000' fontsize='10'>assuming a normal distribution of the metrics. </run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>     When more or fewer </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Country, City, or Zone(s)</run>
                  <run fontcolor='#000000' fontsize='10'> are selected, the population of the normal distribution changes, then the </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Normalized</run>
                  <run fontcolor='#000000' fontsize='10'> values will change.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>7. </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>KVI Score</run>
                  <run fontcolor='#000000' fontsize='10'> = </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>40%</run>
                  <run fontcolor='#000000' fontsize='10'> x GMV Normalized + </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>40%</run>
                  <run fontcolor='#000000' fontsize='10'> x Basket Penetration Normalized + </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>20%</run>
                  <run fontcolor='#000000' fontsize='10'> x Customer Frequency Normalized as suggested by </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Talabat</run>
                  <run fontcolor='#000000' fontsize='10'>, </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Æ </run>
                  <run fontcolor='#000000' fontsize='10'>the </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>weightage</run>
                  <run fontcolor='#000000' fontsize='10'> can be </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>adjusted</run>
                  <run fontcolor='#000000' fontsize='10'> for your own analysis.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>8. All the products (at the </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Master ID</run>
                  <run fontcolor='#000000' fontsize='10'> level) are sorted in the </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>descending</run>
                  <run fontcolor='#000000' fontsize='10'> order based on the </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>KVI Score. </run>
                  <run fontcolor='#000000' fontsize='10'>Then:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'><![CDATA[- When the Cumulative GMV % (or Running Total of GMV %) <= 25%, a product is ]]></run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>KVI</run>
                  <run fontcolor='#000000' fontsize='10'>. </run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'><![CDATA[- When the Cumulative GMV % (or Running Total of GMV %) > 25% and <= 65%, a product is ]]></run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Mass</run>
                  <run fontcolor='#000000' fontsize='10'>.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'><![CDATA[-  When the Cumulative GMV % (or Running Total of GMV %) > 65% and <= 100%, a product is ]]></run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Long Tail</run>
                  <run fontcolor='#000000' fontsize='10'>.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>Again, when more or fewer </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Country, City, or Zone(s)</run>
                  <run fontcolor='#000000' fontsize='10'> are selected, the population with KVI Score &amp; Cumulative GMV % changes, then the item segmentation outputs will change.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#000000' fontsize='10'> For any question, comment or feedback, feel free to:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>1. Head to the &quot;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Business Requirements Document</run>
                  <run fontcolor='#000000' fontsize='10'>&quot; tab and comment in the google sheet.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>2. or contact our team </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>shops_commercial_central@deliveryhero.com</run>
                  <run fontcolor='#000000' fontsize='10'>! </run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>Thank you!</run>
                </formatted-text>
