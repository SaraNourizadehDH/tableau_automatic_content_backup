            </column>
            <column caption='GMV Normalized ' datatype='real' name='[Calculation_1199716722486038534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2768728615662690306] - [Calculation_1199716722479890436]) / [Average GMV (copy)_1199716722484117509]&#10;// Z Score' />
            </column>
            <column caption='KVI Score' datatype='real' name='[Calculation_1199716722491064333]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2] * [Calculation_1199716722486038534] + [Parameters].[Weightage of Customer Frequency Normalized (copy)_1199716723482640404] * [GMV Normalized  (copy)_1199716722489401353] + [Parameters].[Weightage of GMV Normalized (copy)_1199716723482423315] * [BP Normalized (copy)_1199716722490707980]' />
            </column>
            <column caption='GMV  %' datatype='real' name='[Calculation_1199716722505125903]' role='measure' type='quantitative'>
