      <aliases enabled='yes' />
      <column caption='GMV STDEV' datatype='real' name='[Average GMV (copy)_1199716722484117509]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed: STDEV([total_gmv])}' />
      </column>
      <column caption='CF Average' datatype='real' name='[BP Average (copy)_1199716722490290186]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : avg([Calculation_1199716722448654338])}' />
      </column>
      <column caption='Customer Frequency Normalized' datatype='real' name='[BP Normalized (copy)_1199716722490707980]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( [Calculation_1199716722448654338]- [BP Average (copy)_1199716722490290186]) / [BP STDEV (copy)_1199716722490462219]&#10;// Z Score' />
      </column>
      <column caption='CF STDEV' datatype='real' name='[BP STDEV (copy)_1199716722490462219]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : STDEV([Calculation_1199716722448654338])}' />
      </column>
      <column caption='Basket Peneration' datatype='real' name='[Calculation_1199716722436558848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [master_id] : sum([order_count]) } / [Calculation_185632754484436992]' />
      </column>
      <column caption='Order Count - Sum LOD' datatype='integer' name='[Calculation_1199716722447933441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : sum([order_count])}' />
      </column>
      <column caption='Customer Frequency' datatype='real' name='[Calculation_1199716722448654338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [master_id]: sum([order_count]) / sum([customer_count]) }' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_1199716722449022979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_gmv]' />
      </column>
      <column caption='GMV Average' datatype='real' name='[Calculation_1199716722479890436]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed : avg([total_gmv])}' />
      </column>
      <column caption='GMV Normalized ' datatype='real' name='[Calculation_1199716722486038534]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_2768728615662690306] - [Calculation_1199716722479890436]) / [Average GMV (copy)_1199716722484117509]&#10;// Z Score' />
      </column>
      <column caption='KVI Score' datatype='real' name='[Calculation_1199716722491064333]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2] * [Calculation_1199716722486038534] + [Parameters].[Weightage of Customer Frequency Normalized (copy)_1199716723482640404] * [GMV Normalized  (copy)_1199716722489401353] + [Parameters].[Weightage of GMV Normalized (copy)_1199716723482423315] * [BP Normalized (copy)_1199716722490707980]' />
      </column>
      <column caption='GMV Cumulative' datatype='real' name='[Calculation_1199716722496909326]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(sum([total_gmv]) , FIRST(), 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='GMV  %' datatype='real' name='[Calculation_1199716722505125903]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_gmv] / [Sum of Order Count LOD (copy)_1199716722509090832]' />
      </column>
      <column caption='Item Role' datatype='string' name='[Calculation_1199716722519269394]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [GMV Cumulative (copy)_1199716722512764945] &lt;= 0.25 then &quot;KVI&quot;&#10;ELSEIF [GMV Cumulative (copy)_1199716722512764945] &lt;= 0.65 then &quot;Mass&quot;&#10;Else &quot;Long Tail&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Warning Message' datatype='string' name='[Calculation_1199716723486441493]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Weightage of Customer Frequency Normalized (copy)_1199716723482640404] + [Parameters].[Weightage of GMV Normalized (copy)_1199716723482423315] + [Parameters].[Parameter 2] = 1&#10;&#10;          THEN &apos;All good! The weightage added up to 1.&apos;&#10;&#10;          ELSE &apos;Weightage must add up to 1.  Please make adjustments.&apos;&#10;&#10;          END' />
      </column>
      <column caption='Location' datatype='string' name='[Calculation_1327436001968033792]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[country_name] + [city_name] + [zone_name]' />
      </column>
      <column caption='Total Order Count' datatype='integer' name='[Calculation_185632754484436992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : sum([order_count])}' />
      </column>
      <column caption='Product Name *' datatype='string' name='[Calculation_2768728615661608961]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [master_id]: max([product_name]) }' />
      </column>
      <column caption='GMV Eur' datatype='real' name='[Calculation_2768728615662690306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [master_id]: sum([total_gmv])}' />
      </column>
      <column caption='BP Average' datatype='real' name='[GMV Average (copy)_1199716722488975367]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : avg([Calculation_1199716722436558848])}' />
      </column>
      <column caption='GMV Cumulative %' datatype='real' name='[GMV Cumulative (copy)_1199716722512764945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(sum([Calculation_1199716722505125903]) , FIRST(), 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Basket Penetration Normalized' datatype='real' name='[GMV Normalized  (copy)_1199716722489401353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1199716722436558848] - [GMV Average (copy)_1199716722488975367]) / [GMV STDEV (copy)_1199716722489233416]&#10;// Z Score' />
      </column>
      <column caption='BP STDEV' datatype='real' name='[GMV STDEV (copy)_1199716722489233416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : STDEV([Calculation_1199716722436558848])}' />
      </column>
      <column datatype='string' name='[Master ID (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[master_id]' new-bin='true' />
      </column>
      <column caption='Brand Name *' datatype='string' name='[Product Name * (copy)_1327436002288050177]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [master_id]: max([brand_name]) }' />
      </column>
      <column caption='Master Product Code *' datatype='string' name='[Product Name * (copy)_1327436004829032450]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [master_id]: max([master_code]) }' />
      </column>
      <column caption='GMV - Sum LOD' datatype='real' name='[Sum of Order Count LOD (copy)_1199716722509090832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : sum([total_gmv])}' />
      </column>
