            </column>
            <column caption='GMV Eur' datatype='real' name='[Calculation_2768728615662690306]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [master_id]: sum([total_gmv])}' />
            </column>
            <column caption='BP Average' datatype='real' name='[GMV Average (copy)_1199716722488975367]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED : avg([Calculation_1199716722436558848])}' />
            </column>
            <column caption='GMV Cumulative %' datatype='real' name='[GMV Cumulative (copy)_1199716722512764945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_SUM(sum([Calculation_1199716722505125903]) , FIRST(), 0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Basket Penetration Normalized' datatype='real' name='[GMV Normalized  (copy)_1199716722489401353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1199716722436558848] - [GMV Average (copy)_1199716722488975367]) / [GMV STDEV (copy)_1199716722489233416]&#10;// Z Score' />
            </column>
            <column caption='BP STDEV' datatype='real' name='[GMV STDEV (copy)_1199716722489233416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED : STDEV([Calculation_1199716722436558848])}' />
            </column>
            <column datatype='string' name='[Master ID (group)]' role='dimension' type='nominal'>
