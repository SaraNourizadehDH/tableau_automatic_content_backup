          <datasource-dependencies datasource='federated.1x8so6t02mqxs21bty7g0094fpur'>
            <column caption='GMV STDEV' datatype='real' name='[Average GMV (copy)_1199716722484117509]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed: STDEV([total_gmv])}' />
            </column>
            <column caption='CF Average' datatype='real' name='[BP Average (copy)_1199716722490290186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED : avg([Calculation_1199716722448654338])}' />
            </column>
            <column caption='Customer Frequency Normalized' datatype='real' name='[BP Normalized (copy)_1199716722490707980]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( [Calculation_1199716722448654338]- [BP Average (copy)_1199716722490290186]) / [BP STDEV (copy)_1199716722490462219]&#10;// Z Score' />
            </column>
            <column caption='CF STDEV' datatype='real' name='[BP STDEV (copy)_1199716722490462219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED : STDEV([Calculation_1199716722448654338])}' />
            </column>
            <column caption='Basket Peneration' datatype='real' name='[Calculation_1199716722436558848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [master_id] : sum([order_count]) } / [Calculation_185632754484436992]' />
            </column>
            <column caption='Customer Frequency' datatype='real' name='[Calculation_1199716722448654338]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [master_id]: sum([order_count]) / sum([customer_count]) }' />
            </column>
            <column caption='GMV Average' datatype='real' name='[Calculation_1199716722479890436]' role='measure' type='quantitative'>
