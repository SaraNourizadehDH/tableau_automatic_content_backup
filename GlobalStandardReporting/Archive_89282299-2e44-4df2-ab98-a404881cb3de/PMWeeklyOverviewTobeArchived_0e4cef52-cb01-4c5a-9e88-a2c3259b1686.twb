      <column caption='Acquisitions Cal Week Prior' datatype='real' name='[Acquisitions Cal Week Current (copy)_1348828105479655427]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_1348828105479147521] = &apos;Full Prior&apos; THEN [Calculation_2263832909930299392] END)' />
      </column>
      <column caption='Acquisitions Cal Week Prior Year' datatype='real' name='[Acquisitions Cal Week Prior (copy)_1878001062040834050]' role='measure' type='quantitative'>
