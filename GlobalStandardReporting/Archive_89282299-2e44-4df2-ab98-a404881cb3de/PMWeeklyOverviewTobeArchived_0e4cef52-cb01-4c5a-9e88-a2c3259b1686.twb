      <column caption='Cost Eur %' datatype='real' name='[Cost Week Current % (copy)_785878144468754435]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([costs_eur])/sum({ FIXED [Calculation_810366474598916096],[country]:SUM([costs_eur])})' />
      </column>
      <column caption='Cost Month Current' datatype='real' name='[Cost Week Current (copy)_1511520647269433346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Week Type (copy)_649362788404613129] = &apos;Month Current&apos; THEN [costs_eur] END)' />
      </column>
      <column caption='Cost Week Prior' datatype='real' name='[Cost Week Current (copy)_1575133986792005633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_810366474603941891] = &apos;Full Prior&apos; THEN [costs_eur] END)' />
      </column>
      <column caption='Cost Eur Switch ' datatype='real' name='[Cost Week Current Switch (copy)_785878144469245956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;Absolute&apos; THEN SUM([costs_eur])&#13;&#10;    WHEN &apos;Relative&apos; THEN [Cost Week Current % (copy)_785878144468754435]*100&#13;&#10;END' />
      </column>
      <column caption='Cost Week Prior Year' datatype='real' name='[Cost Week Prior (copy)_649362788400476161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_810366474603941891] = &apos;Full Prior Year&apos; THEN [costs_eur] END)' />
      </column>
      <column caption='Cost Month Prior Year' datatype='real' name='[Cost Week Prior Year (copy)_1511520647269539843]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Week Type (copy)_649362788404613129] = &apos;Month Prior Year&apos; THEN [costs_eur] END)' />
      </column>
      <column caption='Cost YoY %' datatype='real' name='[Cost WoW % (copy)_649362788400660483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1575133986791641088]/[Cost Week Prior (copy)_649362788400476161]-1' />
      </column>
      <column caption='Cost YoY Color' datatype='string' name='[Cost WoW Color (copy)_649362788400762884]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Cost WoW % (copy)_649362788400660483] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
      </column>
      <column caption='New Sessions Web Week Current' datatype='integer' name='[Installs Week Current (copy)_1878001062070374419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [platform_type] = &apos;Web&apos; AND [Calculation_810366474603941891] = &apos;Full Current&apos; THEN [new_sessions] END)' />
      </column>
      <column caption='Max Date' datatype='date' name='[Min Date (copy)_1511520647275405318]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([date])' />
      </column>
      <column caption='Acquisitions Month Current' datatype='real' name='[Orders Month Current (copy)_1878001062033481728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Week Type (copy)_649362788404613129] = &apos;Month Current&apos; THEN [acquisitions_calibration_ios14fix] END)' />
      </column>
      <column caption='Acquisitions Month Prior Year' datatype='real' name='[Orders Month Prior Year (copy)_1878001062033584129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Week Type (copy)_649362788404613129] = &apos;Month Prior Year&apos; THEN [acquisitions_calibration_ios14fix] END)' />
      </column>
      <column caption='Voucher Acquisition  WoW Shape' datatype='string' name='[Orders Voucher Shape (copy)_3212403595963330571]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_810366474624004118] &lt; 0 then &apos;negative&apos; else &apos;positive&apos; end' />
      </column>
      <column caption='Partial Month Filter' datatype='integer' datatype-customized='true' name='[Partial Week Filter (copy)_1406530471339966464]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='INT([date] &lt; DATETRUNC(&apos;month&apos;, TODAY()))' />
      </column>
      <column caption='Month Type' datatype='string' name='[Week Type (copy)_649362788404613129]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [date] &lt; DATETRUNC(&apos;month&apos;, TODAY()) OR [date] &gt;= DATETRUNC(&apos;month&apos;, TODAY())&#13;&#10;    WHEN [date] &gt;= DATEADD(&apos;month&apos;, 0, DATETRUNC(&apos;month&apos;, TODAY())) THEN &apos;Month Current&apos;&#13;&#10;    WHEN [date] &gt;= DATEADD(&apos;month&apos;, -12, DATETRUNC(&apos;month&apos;, TODAY())) AND [date] &lt; DATEADD(&apos;month&apos;, -11, DATETRUNC(&apos;week&apos;, TODAY())) THEN &apos;Month Prior Year&apos;&#13;&#10;END' />
      </column>
