                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone h='10286' id='1373' type-v2='text' w='21670' x='22112' y='88571'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='7'>Channel</run>
                    <run fontsize='7'>: </run>
                    <run fontcolor='#00000099' fontname='Benton Sans,Arial,Helvetica,sans-serif' fontsize='7'>Present only Performance Marketing data excluding RMO and Influencer subchannels, unless stated differently. </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Benton Sans Book' fontsize='7'>Channel</run>
                    <run fontcolor='#1b1b1b' fontname='Benton Sans Book' fontsize='7'>: App, Dispaly, Paid Social, SEM, SEO</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='10286' id='811' type-v2='text' w='21668' x='43782' y='88571'>
                  <formatted-text>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Benton Sans Book' fontsize='6'>NFV Share: </run>
                    <run fontcolor='#1b1b1b' fontname='Benton Sans Book' fontsize='6'>Share of NFV acquisitions.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Benton Sans Book' fontsize='6'>Installs: </run>
                    <run fontcolor='#1b1b1b' fontname='Benton Sans Book' fontsize='6'>Total app installs according to Adjust tracking</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Benton Sans Book' fontsize='6'>New Sessions: </run>
                    <run fontcolor='#1b1b1b' fontname='Benton Sans Book' fontsize='6'>Total sessions coming from new users based on Google Analytics data</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#1b1b1b' fontname='Benton Sans Book' fontsize='6'>aCVR: </run>
                    <run fontcolor='#1b1b1b' fontname='Benton Sans Book' fontsize='6'>Acquisitions CVR = Acquisitions / (Installs + New sessions)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#ffffff' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
