                  <value>&quot;OTHER AUTOCOMP&quot;</value>
                  <value>&quot;OTHER CAMPAIGNS&quot;</value>
                  <value>&quot;OTHER CUSTOMERCOMPENSATION&quot;</value>
                  <value>&quot;OTHER DELIVERY FEE&quot;</value>
                  <value>&quot;OTHER LOYALTY&quot;</value>
                  <value>&quot;OTHER OTHER&quot;</value>
                  <value>&quot;OTHER PR&quot;</value>
                  <value>&quot;OTHER SUBSCRIPTION&quot;</value>
                  <value>&quot;OTHER SUBSIDIES&quot;</value>
                  <value>&quot;OTHER VOUCHERS&quot;</value>
                  <value>&quot;PAIDSOCIAL BRA&quot;</value>
                  <value>&quot;PAIDSOCIAL RMO&quot;</value>
                  <value>&quot;REFERRAL &quot;</value>
                  <value>&quot;RESTAURANTMARKETING VENDOR BRANDING&quot;</value>
                  <value>&quot;REVENUES &quot;</value>
                  <value>&quot;RIDERS &quot;</value>
                  <value>&quot;SOCIALMEDIA ENGAGEMENTNOTPROMOTED&quot;</value>
                  <value>&quot;SOCIALMEDIA ENGAGEMENTPROMOTED&quot;</value>
