      <aliases enabled='yes' />
      <column caption='downloads share Color' datatype='string' name='[Acq WoW Color (copy)_4344988530634154011]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF zn(sum(dh_app_downloads)) &lt;  zn(sum(comp_downloads)) THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
      </column>
      <column caption='Start Date' datatype='string' name='[Calculation_2373889596536709121]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Start Date&apos; +&apos;:&apos; +&apos; &apos;+ str(date(DATETRUNC(&apos;day&apos;, [report_week])))' />
      </column>
      <column caption='downloads_share' datatype='real' name='[Calculation_4344988530570551320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([dh_app_downloads])) / zn(sum([comp_downloads]))' />
      </column>
      <column caption='Calendar week for filtering' datatype='date' name='[Calculation_4348225507491082241]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{max([report_week])}' />
      </column>
      <column caption='Last Week Filter' datatype='boolean' name='[Calculation_4348225507491762178]' role='dimension' type='nominal'>
