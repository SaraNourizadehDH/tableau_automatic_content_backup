      </column>
      <column caption='Acquisitions Calibration % ' datatype='real' name='[Acquisitions Cal Week Current % (copy)_785878144466849792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([acquisitions_calibration_ios14fix])/sum({ FIXED [Calculation_810366474598916096],[country]:sum([acquisitions_calibration_ios14fix])})' />
