            <column caption='Subchannel' datatype='string' name='[subchannel]' role='dimension' type='nominal' />
            <column-instance column='[NFV Cost WoW % (copy)_1878001062043590671]' derivation='User' name='[usr:NFV Cost WoW % (copy)_1878001062043590671:qk]' pivot='key' type='quantitative' />
            <column-instance column='[NFV Cost WoW Color (copy)_1878001062043295757]' derivation='User' name='[usr:NFV Cost WoW Color (copy)_1878001062043295757:nk]' pivot='key' type='nominal' />
