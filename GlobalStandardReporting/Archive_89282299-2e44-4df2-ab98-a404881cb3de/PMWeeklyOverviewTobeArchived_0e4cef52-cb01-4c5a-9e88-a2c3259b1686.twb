      </column>
      <column caption='Cost WoW Color' datatype='string' name='[Calculation_649362788395008000]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1575133986792124418] &lt; 0 THEN &apos;Negative&apos; ELSE &apos;Positive&apos; END' />
