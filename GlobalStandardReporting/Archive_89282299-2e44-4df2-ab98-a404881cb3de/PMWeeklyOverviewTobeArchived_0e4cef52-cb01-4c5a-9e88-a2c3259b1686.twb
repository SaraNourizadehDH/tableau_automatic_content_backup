                  <value>&quot;AFFILIATE &quot;</value>
                  <value>&quot;APP BRA&quot;</value>
                  <value>&quot;APP RMO&quot;</value>
                  <value>&quot;BRAND APPDIRECT&quot;</value>
                  <value>&quot;BRAND OUTDOOR&quot;</value>
                  <value>&quot;BRAND PR&quot;</value>
                  <value>&quot;BRAND RADIO&quot;</value>
                  <value>&quot;BRAND TV MEDIA&quot;</value>
                  <value>&quot;BRAND TV PRODUCTION&quot;</value>
                  <value>&quot;BRAND WEBDIRECT&quot;</value>
                  <value>&quot;COOP &quot;</value>
                  <value>&quot;CRM BRA&quot;</value>
                  <value>&quot;CRM RMA&quot;</value>
                  <value>&quot;DISPLAY BRA&quot;</value>
                  <value>&quot;DISPLAY RMO&quot;</value>
                  <value>&quot;FLYERS &quot;</value>
