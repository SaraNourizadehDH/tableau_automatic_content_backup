            <column caption='Segment' datatype='string' name='[Calculation_810366474598916096]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [country]&#13;&#10;    WHEN IN(&apos;Argentina&apos;,&apos;Bolivia&apos;,&apos;Chile&apos;,&apos;Colombia&apos;, &apos;Costa Rica&apos;,&apos;Dominican Republic&apos;, &apos;Ecuador&apos;, &apos;El Salvador&apos;, &apos;Guatemala&apos;, &apos;Panama&apos;,&apos;Paraguay&apos;, &apos;Peru&apos;, &apos;Uruguay&apos;,&apos;Venezuela&apos;,&apos;Honduras&apos;,&apos;Nicaragua&apos;) THEN &apos;America&apos;&#13;&#10;    WHEN IN(&apos;Bangladesh&apos;,&apos;Cambodia&apos;,&apos;Hong Kong&apos;,&apos;Japan&apos;,&apos;Laos&apos;,&apos;Malaysia&apos;,&apos;Myanmar&apos;,&apos;Pakistan&apos;,&apos;Philippines&apos;,&apos;Singapore&apos;,&apos;South Korea&apos;,&apos;Taiwan&apos;,&apos;Thailand&apos;) THEN &apos;Asia&apos;&#13;&#10;    WHEN IN(&apos;Austria&apos;,&apos;Bosnia and Herzegovina&apos;,&apos;Bulgaria&apos;,&apos;Croatia&apos;,&apos;Cyprus&apos;,&apos;Czech Republic&apos;,&apos;Denmark&apos;,&apos;Finland&apos;,&apos;Germany&apos;,&apos;Greece&apos;, &apos;greece&apos;,&apos;Hungary&apos;,&apos;Montenegro&apos;,&apos;Norway&apos;,&apos;Romania&apos;,&apos;Serbia&apos;,&apos;Slovakia&apos;,&apos;Sweden&apos;,&apos;Turkey&apos;) THEN &apos;Europe&apos;&#13;&#10;    WHEN IN(&apos;Bahrain&apos;,&apos;Egypt&apos;, &apos;Iraq&apos;, &apos;Jordan&apos;,&apos;Kuwait&apos;,&apos;Oman&apos;,&apos;Qatar&apos;,&apos;Saudi Arabia&apos;,&apos;United Arab Emirates&apos;) THEN &apos;MENA&apos;&#13;&#10;END' />
            </column>
            <column caption='Week Type' datatype='string' name='[Calculation_810366474603941891]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date] &lt; DATETRUNC(&apos;week&apos;, TODAY())&#13;&#10;    WHEN [date] &gt;= DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())) THEN &apos;Full Current&apos;&#13;&#10;    WHEN [date] &gt;= DATEADD(&apos;week&apos;, -2, DATETRUNC(&apos;week&apos;, TODAY())) THEN &apos;Full Prior&apos;&#13;&#10;    WHEN [date] &gt;= DATEADD(&apos;week&apos;, -53, DATETRUNC(&apos;week&apos;, TODAY())) AND [date] &lt; DATEADD(&apos;week&apos;, -52, DATETRUNC(&apos;week&apos;, TODAY())) THEN &apos;Full Prior Year&apos;&#13;&#10;END' />
            </column>
            <column caption='Acquisitions Cal Week Current' datatype='real' name='[Calculation_810366474616291336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_810366474603941891] = &apos;Full Current&apos; THEN [acquisitions_calibration_ios14fix] END)' />
            </column>
            <column caption='Acquisitions With Vouchers Cal Week Current' datatype='real' name='[Calculation_810366474623488020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_810366474603941891] = &apos;Full Current&apos; THEN [acquisitions_with_voucher] END)' />
            </column>
