    <worksheet name='NFV CPA MENA'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontsize='8'>QC</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bima_tableau_mkt_l2_report_detailed+ (rl_mkt)' name='federated.0j3gwkc0djco5q1200slc1htftg0' />
            <datasource caption='bima_tableau_mkt_vertical_orders+ (rl_mkt)' name='federated.0wufi330r7hmse19q93ww18txltj' />
          </datasources>
          <datasource-dependencies datasource='federated.0wufi330r7hmse19q93ww18txltj'>
            <column caption='Week Type' datatype='string' name='[Calculation_1348828105479147521]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [order_date] &lt; DATETRUNC(&apos;week&apos;, TODAY())&#13;&#10;    WHEN [order_date] &gt;= DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;week&apos;, TODAY())) THEN &apos;Full Current&apos;&#13;&#10;    WHEN [order_date] &gt;= DATEADD(&apos;week&apos;, -2, DATETRUNC(&apos;week&apos;, TODAY())) THEN &apos;Full Prior&apos;&#13;&#10;    WHEN [order_date] &gt;= DATEADD(&apos;week&apos;, -52, DATETRUNC(&apos;week&apos;, TODAY())) AND [order_date] &lt; DATEADD(&apos;week&apos;, -51, DATETRUNC(&apos;week&apos;, TODAY())) THEN &apos;Full Prior Year&apos;&#13;&#10;END' />
            </column>
            <column caption='Acquisitions Cal Week Current' datatype='real' name='[Calculation_1348828105479528450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_1348828105479147521] = &apos;Full Current&apos; THEN [Calculation_2263832909930299392] END)' />
            </column>
            <column caption='NFV Cost Week Current' datatype='real' name='[Calculation_1348828105480175624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_1348828105479147521] = &apos;Full Current&apos; AND [actual_vertical] != &apos;Restaurant / Food&apos; THEN [cost_eur] END)' />
            </column>
            <column caption='CPA NFV Cal Week Current' datatype='real' name='[Calculation_1348828105481408523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1348828105480175624]/[Calculation_1348828105479528450]' />
            </column>
            <column caption='Attr' datatype='integer' name='[Calculation_1348828105484398610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Acquisitions Calibration' datatype='real' name='[Calculation_2263832909930299392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[acquisitions]' />
            </column>
            <column caption='Acquisitions' datatype='real' name='[acquisitions]' role='measure' type='quantitative' />
            <column caption='Actual Vertical' datatype='string' name='[actual_vertical]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1348828105484398610]' derivation='Attribute' name='[attr:Calculation_1348828105484398610:qk]' pivot='key' type='quantitative' />
            <column caption='Cost Eur' datatype='real' name='[cost_eur]' role='measure' type='quantitative' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
