            <column caption='NFV Acquisitions Cal Week Current' datatype='real' name='[NFV Acquisitions Cal (copy)_1260444970644381697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([actual_vertical] != &apos;Restaurant / Food&apos; AND [Calculation_1348828105479147521] = &apos;Full Current&apos;, [Calculation_2263832909930299392], 0))' />
            </column>
            <column caption='NFV Acquisitions Cal Share Week Current' datatype='real' name='[NFV Acquisitions Cal Share (copy)_1260444970646597635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[NFV Acquisitions Cal (copy)_1260444970644381697]/sum(IF [Calculation_1348828105479147521] = &apos;Full Current&apos; THEN [Calculation_2263832909930299392] ELSE 0 END)' />
            </column>
            <column caption='Acquisitions' datatype='real' name='[acquisitions]' role='measure' type='quantitative' />
