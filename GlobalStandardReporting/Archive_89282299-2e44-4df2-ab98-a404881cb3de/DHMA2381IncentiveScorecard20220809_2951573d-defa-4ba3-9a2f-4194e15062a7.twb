            <column-instance column='[cnt_orders_lever]' derivation='Sum' name='[sum:cnt_orders_lever:qk]' pivot='key' type='quantitative' />
            <column-instance column='[cnt_orders_total]' derivation='Sum' name='[sum:cnt_orders_total:qk]' pivot='key' type='quantitative' />
