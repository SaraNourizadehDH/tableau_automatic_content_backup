            <column-instance column='[year_month]' derivation='None' name='[none:year_month:nk]' pivot='key' type='nominal' />
            <column aggregation='Sum' caption='AOV Quartiles' datatype='integer' name='[qrtl_AOV_gmv_eur]' role='dimension' type='ordinal'>
              <aliases>
                <alias key='1' value='AOV (Qrtl1) (lowest 25%)' />
                <alias key='2' value='AOV (Qrtl2)' />
