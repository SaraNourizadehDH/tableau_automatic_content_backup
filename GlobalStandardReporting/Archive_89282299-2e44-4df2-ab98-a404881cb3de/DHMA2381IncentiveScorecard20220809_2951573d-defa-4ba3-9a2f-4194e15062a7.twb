    <worksheet name='Lever Descriptions'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Glossary</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='DHMA-2381_output_magnitude_table (Match_Lists)' name='federated.19gbgwp0i5ao6b17um42w0e8tdt1' />
          </datasources>
          <datasource-dependencies datasource='federated.19gbgwp0i5ao6b17um42w0e8tdt1'>
            <column caption='Lever Description' datatype='string' name='[Calculation_1260726424058695681]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [lever]&#13;&#10;WHEN &quot;flag_stacked_carc&quot; THEN &quot;Customers who combined at least 2 different CARC incentives in the same order.&quot;&#13;&#10;WHEN &quot;flag_stacked_dh_carc&quot; THEN &quot;Customers who combined at least 2 different DH-funded CARC incentives in the same order.&quot;&#13;&#10;WHEN &quot;flag_ml_unhealthy_60pct&quot; THEN &quot;Unprofitable customers who have persistently been part of the lowest 25% Quartile in FLGP (=fully loaded gross profit) for the 6 months prior to the incentivized order.&quot;&#13;&#10;WHEN &quot;flag_high_reorder_prob_flag_90&quot; THEN &quot;Existing customers whose predicted purchase probability was greater than 90% one day before the incentivized order happened.&quot;&#13;&#10;WHEN &quot;flag_high_reorder_prob_flag_95&quot; THEN &quot;Existing customers whose predicted purchase probability was greater than 95% one day before the incentivized order happened.&quot;&#13;&#10;WHEN &quot;flag_pre_order_fraud_detection&quot; THEN &quot;New customer incentive fraud detected based on a set of deterministic rules (e.g. suspicious email address, unvalidated phone number, app activity).&quot;&#13;&#10;WHEN &quot;flag_post_order_fraud_detection&quot; THEN &quot;Incentivized orders from unique customers (as per analytical_customer_id) to whom at least 3 different registered accounts (customer_account_id) can be matched based on the customer’s name and at least one additional data point out of email, phone or delivery address.&quot;&#13;&#10;ELSE &quot;NA&quot;&#13;&#10;END' />
            </column>
            <column caption='Lever Names' datatype='string' name='[Calculation_449797077866934272]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [lever] &#13;&#10;    WHEN &apos;flag_high_reorder_prob_flag_90&apos; THEN &apos;Returning customers (&gt;90% reorder prob.)&apos;&#13;&#10;    WHEN &apos;flag_high_reorder_prob_flag_95&apos; THEN &apos;Returning customers (&gt;95% reorder prob.)&apos;&#13;&#10;    WHEN &apos;flag_ml_unhealthy_60pct&apos; THEN &apos;Unhealthy Customers&apos;&#13;&#10;    WHEN &apos;flag_post_order_fraud_detection&apos; THEN &apos;Fraudsters (post-order detection)&apos;&#13;&#10;    WHEN &apos;flag_pre_order_fraud_detection&apos; THEN &apos;Fraudsters (pre-order detection)&apos;&#13;&#10;    WHEN &apos;flag_stacked_all&apos; THEN &apos;Customers using stacked incentives (All)&apos;&#13;&#10;    WHEN &apos;flag_stacked_carc&apos; THEN &apos;Customers using stacked incentives (CARC only)&apos;&#13;&#10;    WHEN &apos;flag_stacked_dh_carc&apos; THEN &apos;Customers using stacked incentives (DH CARC only)&apos;&#13;&#10;    WHEN &apos;flag_total_customer_base&apos; THEN &apos;Total&apos;&#13;&#10;    ELSE &apos;&lt;pls add me in [Lever Names]&gt;&apos;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;Fraudsters (post-order detection)&quot;' value='Fraudsters (Multiple account users)' />
                <alias key='&quot;Fraudsters (pre-order detection)&quot;' value='Fraudsters (NC incentive fraud detection)' />
              </aliases>
            </column>
            <column caption='Lever' datatype='string' name='[lever]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;flag_high_reorder_prob_flag_90&quot;' value='Returning customers (&gt;90% reorder prob.)' />
                <alias key='&quot;flag_high_reorder_prob_flag_95&quot;' value='Returning customers (&gt;95% reorder prob.)' />
                <alias key='&quot;flag_ml_unhealthy_60pct&quot;' value='Unhealthy Customers' />
                <alias key='&quot;flag_post_order_fraud_detection&quot;' value='Fraudsters (Multiple account users)' />
                <alias key='&quot;flag_pre_order_fraud_detection&quot;' value='Fraudsters (NC incentive fraud detection)' />
                <alias key='&quot;flag_stacked_all&quot;' value='Customers using stacked incentives (All)' />
