  <worksheets>
    <worksheet name='Customer Profiles'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#555555' fontsize='9'>Fig. 7 - </run>
            <run bold='true' fontcolor='#555555' fontsize='9'>Customer Characteristics</run>
            <run fontcolor='#555555' fontsize='9'><![CDATA[ of <[Parameters].[Parameter 1]>]]></run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontsize='8' italic='true'>AIR%</run>
            <run fontsize='8' italic='true'> = Average Incentivization Rate defined as cumulated incentive spend over cumulated GMV by customer</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8' italic='true'>AOV</run>
            <run fontsize='8' italic='true'> = Average Order Value calculated as  cumulated GMV over lifetime order count by customer binned in quartiles</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='DHMA-2381_output_magnitude_table (Match_Lists)' name='federated.19gbgwp0i5ao6b17um42w0e8tdt1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.19gbgwp0i5ao6b17um42w0e8tdt1].[Calculation_449797077866934272]' caption='Lever Parameter' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Returning customers (&gt;95\% reorder prob.)&quot;'>
              <calculation class='tableau' formula='&quot;Returning customers (&gt;95% reorder prob.)&quot;' />
              <aliases>
                <alias key='&quot;Fraudsters (post-order detection)&quot;' value='Fraudsters (Multiple account users)' />
                <alias key='&quot;Fraudsters (pre-order detection)&quot;' value='Fraudsters (NC incentive fraud detection)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.19gbgwp0i5ao6b17um42w0e8tdt1'>
            <column caption='Lever Names' datatype='string' name='[Calculation_449797077866934272]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [lever] &#13;&#10;    WHEN &apos;flag_high_reorder_prob_flag_90&apos; THEN &apos;Returning customers (&gt;90% reorder prob.)&apos;&#13;&#10;    WHEN &apos;flag_high_reorder_prob_flag_95&apos; THEN &apos;Returning customers (&gt;95% reorder prob.)&apos;&#13;&#10;    WHEN &apos;flag_ml_unhealthy_60pct&apos; THEN &apos;Unhealthy Customers&apos;&#13;&#10;    WHEN &apos;flag_post_order_fraud_detection&apos; THEN &apos;Fraudsters (post-order detection)&apos;&#13;&#10;    WHEN &apos;flag_pre_order_fraud_detection&apos; THEN &apos;Fraudsters (pre-order detection)&apos;&#13;&#10;    WHEN &apos;flag_stacked_all&apos; THEN &apos;Customers using stacked incentives (All)&apos;&#13;&#10;    WHEN &apos;flag_stacked_carc&apos; THEN &apos;Customers using stacked incentives (CARC only)&apos;&#13;&#10;    WHEN &apos;flag_stacked_dh_carc&apos; THEN &apos;Customers using stacked incentives (DH CARC only)&apos;&#13;&#10;    WHEN &apos;flag_total_customer_base&apos; THEN &apos;Total&apos;&#13;&#10;    ELSE &apos;&lt;pls add me in [Lever Names]&gt;&apos;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;Fraudsters (post-order detection)&quot;' value='Fraudsters (Multiple account users)' />
                <alias key='&quot;Fraudsters (pre-order detection)&quot;' value='Fraudsters (NC incentive fraud detection)' />
              </aliases>
            </column>
            <column caption='Lever Filter' datatype='boolean' name='[Calculation_449797077868605442]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_449797077866934272] = [Parameters].[Parameter 1]' />
            </column>
            <column caption='%Orders' datatype='real' default-format='p0%' name='[Calculation_87538781089198081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cnt_orders_lever]) / SUM([cnt_orders_total])' />
            </column>
            <column caption='AIR%' datatype='string' name='[all_time_AIR_all_vert_bins]' role='dimension' type='nominal' />
            <column caption='Lifetime Orders' datatype='string' name='[all_time_lifetime_order_bins]' role='dimension' type='nominal' />
            <column caption='Cnt Orders w/ Issue' datatype='integer' name='[cnt_orders_lever]' role='measure' type='quantitative' />
            <column caption='Cnt Orders Total' datatype='integer' name='[cnt_orders_total]' role='measure' type='quantitative' />
            <column caption='Lever' datatype='string' name='[lever]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;flag_high_reorder_prob_flag_90&quot;' value='Returning customers (&gt;90% reorder prob.)' />
                <alias key='&quot;flag_high_reorder_prob_flag_95&quot;' value='Returning customers (&gt;95% reorder prob.)' />
                <alias key='&quot;flag_ml_unhealthy_60pct&quot;' value='Unhealthy Customers' />
                <alias key='&quot;flag_post_order_fraud_detection&quot;' value='Fraudsters (Multiple account users)' />
                <alias key='&quot;flag_pre_order_fraud_detection&quot;' value='Fraudsters (NC incentive fraud detection)' />
                <alias key='&quot;flag_stacked_all&quot;' value='Customers using stacked incentives (All)' />
                <alias key='&quot;flag_stacked_carc&quot;' value='Customers using stacked incentives (CARC only)' />
                <alias key='&quot;flag_stacked_dh_carc&quot;' value='Customers using stacked incentives (DH CARC only)' />
              </aliases>
            </column>
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_449797077868605442]' derivation='None' name='[none:Calculation_449797077868605442:nk]' pivot='key' type='nominal' />
            <column-instance column='[all_time_AIR_all_vert_bins]' derivation='None' name='[none:all_time_AIR_all_vert_bins:nk]' pivot='key' type='nominal' />
            <column-instance column='[all_time_lifetime_order_bins]' derivation='None' name='[none:all_time_lifetime_order_bins:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
