      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:employment:nk]' palette='green_orange_cyan_yellow_10_0' type='palette'>
            <map to='#3ca8bc'>
              <bucket>&quot;Retired&quot;</bucket>
            </map>
            <map to='#4e9f50'>
              <bucket>&quot;Don&apos;t know / No answer&quot;</bucket>
            </map>
            <map to='#87d180'>
              <bucket>&quot;Employed&quot;</bucket>
            </map>
            <map to='#94a323'>
              <bucket>&quot;Unemployed&quot;</bucket>
            </map>
            <map to='#98d9e4'>
              <bucket>&quot;Student&quot;</bucket>
            </map>
            <map to='#ef8a0c'>
              <bucket>&quot;Full-time homemaker&quot;</bucket>
            </map>
            <map to='#fcc66d'>
              <bucket>&quot;Other&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:marital_status:nk]' palette='tableau-20' type='palette'>
            <map to='#1f77b4'>
              <bucket>&quot;Divorced/Separated&quot;</bucket>
            </map>
            <map to='#2ca02c'>
              <bucket>&quot;Prefer not to say&quot;</bucket>
            </map>
            <map to='#98df8a'>
              <bucket>&quot;Single&quot;</bucket>
            </map>
            <map to='#aec7e8'>
              <bucket>&quot;In a relationship&quot;</bucket>
            </map>
            <map to='#d62728'>
              <bucket>&quot;Widowed&quot;</bucket>
            </map>
            <map to='#eedbbd'>
              <bucket>%null%</bucket>
            </map>
            <map to='#ff7f0e'>
              <bucket>&quot;Living with my partner&quot;</bucket>
            </map>
            <map to='#ffbb78'>
              <bucket>&quot;Married&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:gender:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;Female&quot;</bucket>
            </map>
            <map to='#76b7b2'>
              <bucket>&quot;Other&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;Prefer not to say&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;Male&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:kids:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;Do not have kids&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;Have Kids&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <filter class='categorical' column='[Age Group Set]' filter-group='2'>
        <groupfilter function='level-members' level='[age_group]' user:ui-enumeration='all' user:ui-marker='enumerate' />
      </filter>
      <filter class='categorical' column='[Employment Set]' filter-group='2' />
