            <column caption='Restaurant Loyalty_Proper' datatype='string' name='[Calculation_356065874486497302]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([restaurant_loyalty] , &quot; &quot;)&#13;&#10;THEN&#13;&#10;  UPPER( LEFT([restaurant_loyalty], 1) ) &#13;&#10;  +  LOWER( LEFT(&#13;&#10;          RIGHT([restaurant_loyalty]&#13;&#10;             , LEN([restaurant_loyalty]) - 1&#13;&#10;             )&#13;&#10;          ,FIND([restaurant_loyalty],&quot; &quot;) - 2&#13;&#10;          )&#13;&#10;       )&#13;&#10;  + &quot; &quot; &#13;&#10;  + UPPER(&#13;&#10;      LEFT(&#13;&#10;        RIGHT([restaurant_loyalty]&#13;&#10;           , LEN([restaurant_loyalty] )&#13;&#10;           - FIND([restaurant_loyalty],&quot; &quot;)&#13;&#10;           )&#13;&#10;        , 1&#13;&#10;        )&#13;&#10;      )&#13;&#10;  + LOWER(&#13;&#10;      RIGHT([restaurant_loyalty]&#13;&#10;        , LEN([restaurant_loyalty])&#13;&#10;         - FIND([restaurant_loyalty] ,&quot; &quot;) - 1&#13;&#10;        )&#13;&#10;      )&#13;&#10;ELSE&#13;&#10;  UPPER( LEFT([restaurant_loyalty] ,1) ) &#13;&#10;  +  LOWER( RIGHT([restaurant_loyalty]&#13;&#10;           , LEN([restaurant_loyalty] ) - 1&#13;&#10;           )&#13;&#10;       )&#13;&#10;END' />
