              <calculation class='tableau' formula='IF CONTAINS([awareness_foodplatform] , &quot; &quot;)&#13;&#10;THEN&#13;&#10;  UPPER( LEFT( [awareness_foodplatform], 1) ) &#13;&#10;  +  LOWER( LEFT(&#13;&#10;          RIGHT([awareness_foodplatform]&#13;&#10;             , LEN( [awareness_foodplatform] ) - 1&#13;&#10;             )&#13;&#10;          ,FIND( [awareness_foodplatform],&quot; &quot;) - 2&#13;&#10;          )&#13;&#10;       )&#13;&#10;  + &quot; &quot; &#13;&#10;  + UPPER(&#13;&#10;      LEFT(&#13;&#10;        RIGHT( [awareness_foodplatform]&#13;&#10;           , LEN( [awareness_foodplatform] )&#13;&#10;           - FIND([awareness_foodplatform],&quot; &quot;)&#13;&#10;           )&#13;&#10;        , 1&#13;&#10;        )&#13;&#10;      )&#13;&#10;  + LOWER(&#13;&#10;      RIGHT( [awareness_foodplatform]&#13;&#10;        , LEN([awareness_foodplatform] )&#13;&#10;         - FIND([awareness_foodplatform] ,&quot; &quot;) - 1&#13;&#10;        )&#13;&#10;      )&#13;&#10;ELSE&#13;&#10;  UPPER( LEFT( [awareness_foodplatform] ,1) ) &#13;&#10;  +  LOWER( RIGHT( [awareness_foodplatform]&#13;&#10;           , LEN( [awareness_foodplatform]) - 1&#13;&#10;           )&#13;&#10;       )&#13;&#10;END' />
