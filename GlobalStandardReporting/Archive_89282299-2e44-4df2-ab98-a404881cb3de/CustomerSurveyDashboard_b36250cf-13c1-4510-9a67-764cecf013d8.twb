      <aliases enabled='yes' />
      <column caption='User_entitlement' datatype='boolean' name='[Calculation_1049057282560045058]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='AverageWeight' datatype='real' name='[Calculation_356065874476933127]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([weight])' />
      </column>
      <column caption='Base' datatype='integer' name='[Calculation_356065874477182985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([external_id])' />
      </column>
      <column caption='Usage%' datatype='real' name='[Calculation_356065874477305866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_356065874477182985]*[Calculation_356065874476933127]' />
      </column>
      <column caption='Activities_Proper' datatype='string' name='[Calculation_356065874477740043]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([activities_new] , &quot; &quot;)&#13;&#10;THEN&#13;&#10;  UPPER( LEFT( [activities_new], 1) ) &#13;&#10;  +  LOWER( LEFT(&#13;&#10;          RIGHT( [activities_new]&#13;&#10;             , LEN( [activities_new] ) - 1&#13;&#10;             )&#13;&#10;          ,FIND( [activities_new],&quot; &quot;) - 2&#13;&#10;          )&#13;&#10;       )&#13;&#10;  + &quot; &quot; &#13;&#10;  + UPPER(&#13;&#10;      LEFT(&#13;&#10;        RIGHT( [activities_new]&#13;&#10;           , LEN( [activities_new] )&#13;&#10;           - FIND([activities_new],&quot; &quot;)&#13;&#10;           )&#13;&#10;        , 1&#13;&#10;        )&#13;&#10;      )&#13;&#10;  + LOWER(&#13;&#10;      RIGHT( [activities_new]&#13;&#10;        , LEN( [activities_new] )&#13;&#10;         - FIND( [activities_new] ,&quot; &quot;) - 1&#13;&#10;        )&#13;&#10;      )&#13;&#10;ELSE&#13;&#10;  UPPER( LEFT( [activities_new] ,1) ) &#13;&#10;  +  LOWER( RIGHT( [activities_new]&#13;&#10;           , LEN( [activities_new]) - 1&#13;&#10;           )&#13;&#10;       )&#13;&#10;END' />
      </column>
      <column caption='Lifestyle Attributes_Proper' datatype='string' name='[Calculation_356065874478432269]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([lifestyle_attributes_new] , &quot; &quot;)&#13;&#10;THEN&#13;&#10;  UPPER( LEFT( [lifestyle_attributes_new], 1) ) &#13;&#10;  +  LOWER( LEFT(&#13;&#10;          RIGHT([lifestyle_attributes_new]&#13;&#10;             , LEN( [lifestyle_attributes_new] ) - 1&#13;&#10;             )&#13;&#10;          ,FIND( [lifestyle_attributes_new],&quot; &quot;) - 2&#13;&#10;          )&#13;&#10;       )&#13;&#10;  + &quot; &quot; &#13;&#10;  + UPPER(&#13;&#10;      LEFT(&#13;&#10;        RIGHT( [lifestyle_attributes_new]&#13;&#10;           , LEN( [lifestyle_attributes_new] )&#13;&#10;           - FIND([lifestyle_attributes_new],&quot; &quot;)&#13;&#10;           )&#13;&#10;        , 1&#13;&#10;        )&#13;&#10;      )&#13;&#10;  + LOWER(&#13;&#10;      RIGHT( [lifestyle_attributes_new]&#13;&#10;        , LEN( [lifestyle_attributes_new] )&#13;&#10;         - FIND( [lifestyle_attributes_new] ,&quot; &quot;) - 1&#13;&#10;        )&#13;&#10;      )&#13;&#10;ELSE&#13;&#10;  UPPER( LEFT( [lifestyle_attributes_new] ,1) ) &#13;&#10;  +  LOWER( RIGHT( [lifestyle_attributes_new]&#13;&#10;           , LEN( [lifestyle_attributes_new]) - 1&#13;&#10;           )&#13;&#10;       )&#13;&#10;END' />
      </column>
      <column caption='Lifestyle Events_Proper' datatype='string' name='[Calculation_356065874478940174]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([lifestyle_events_new] , &quot; &quot;)&#13;&#10;THEN&#13;&#10;  UPPER( LEFT( [lifestyle_events_new], 1) ) &#13;&#10;  +  LOWER( LEFT(&#13;&#10;          RIGHT([lifestyle_events_new]&#13;&#10;             , LEN( [lifestyle_events_new] ) - 1&#13;&#10;             )&#13;&#10;          ,FIND( [lifestyle_events_new],&quot; &quot;) - 2&#13;&#10;          )&#13;&#10;       )&#13;&#10;  + &quot; &quot; &#13;&#10;  + UPPER(&#13;&#10;      LEFT(&#13;&#10;        RIGHT( [lifestyle_events_new]&#13;&#10;           , LEN( [lifestyle_events_new] )&#13;&#10;           - FIND([lifestyle_events_new],&quot; &quot;)&#13;&#10;           )&#13;&#10;        , 1&#13;&#10;        )&#13;&#10;      )&#13;&#10;  + LOWER(&#13;&#10;      RIGHT( [lifestyle_events_new]&#13;&#10;        , LEN( [lifestyle_events_new] )&#13;&#10;         - FIND( [lifestyle_events_new] ,&quot; &quot;) - 1&#13;&#10;        )&#13;&#10;      )&#13;&#10;ELSE&#13;&#10;  UPPER( LEFT( [lifestyle_events_new] ,1) ) &#13;&#10;  +  LOWER( RIGHT( [lifestyle_events_new]&#13;&#10;           , LEN( [lifestyle_events_new]) - 1&#13;&#10;           )&#13;&#10;       )&#13;&#10;END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_778841290031845377]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
