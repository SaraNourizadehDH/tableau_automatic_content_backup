            <column caption='Activities_Proper' datatype='string' name='[Calculation_356065874477740043]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([activities_new] , &quot; &quot;)&#13;&#10;THEN&#13;&#10;  UPPER( LEFT( [activities_new], 1) ) &#13;&#10;  +  LOWER( LEFT(&#13;&#10;          RIGHT( [activities_new]&#13;&#10;             , LEN( [activities_new] ) - 1&#13;&#10;             )&#13;&#10;          ,FIND( [activities_new],&quot; &quot;) - 2&#13;&#10;          )&#13;&#10;       )&#13;&#10;  + &quot; &quot; &#13;&#10;  + UPPER(&#13;&#10;      LEFT(&#13;&#10;        RIGHT( [activities_new]&#13;&#10;           , LEN( [activities_new] )&#13;&#10;           - FIND([activities_new],&quot; &quot;)&#13;&#10;           )&#13;&#10;        , 1&#13;&#10;        )&#13;&#10;      )&#13;&#10;  + LOWER(&#13;&#10;      RIGHT( [activities_new]&#13;&#10;        , LEN( [activities_new] )&#13;&#10;         - FIND( [activities_new] ,&quot; &quot;) - 1&#13;&#10;        )&#13;&#10;      )&#13;&#10;ELSE&#13;&#10;  UPPER( LEFT( [activities_new] ,1) ) &#13;&#10;  +  LOWER( RIGHT( [activities_new]&#13;&#10;           , LEN( [activities_new]) - 1&#13;&#10;           )&#13;&#10;       )&#13;&#10;END' />
