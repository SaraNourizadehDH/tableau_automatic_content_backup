      <column caption='Awareness Foodplatform_Proper' datatype='string' name='[Calculation_356065874484342799]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([awareness_foodplatform] , &quot; &quot;)&#13;&#10;THEN&#13;&#10;  UPPER( LEFT( [awareness_foodplatform], 1) ) &#13;&#10;  +  LOWER( LEFT(&#13;&#10;          RIGHT([awareness_foodplatform]&#13;&#10;             , LEN( [awareness_foodplatform] ) - 1&#13;&#10;             )&#13;&#10;          ,FIND( [awareness_foodplatform],&quot; &quot;) - 2&#13;&#10;          )&#13;&#10;       )&#13;&#10;  + &quot; &quot; &#13;&#10;  + UPPER(&#13;&#10;      LEFT(&#13;&#10;        RIGHT( [awareness_foodplatform]&#13;&#10;           , LEN( [awareness_foodplatform] )&#13;&#10;           - FIND([awareness_foodplatform],&quot; &quot;)&#13;&#10;           )&#13;&#10;        , 1&#13;&#10;        )&#13;&#10;      )&#13;&#10;  + LOWER(&#13;&#10;      RIGHT( [awareness_foodplatform]&#13;&#10;        , LEN([awareness_foodplatform] )&#13;&#10;         - FIND([awareness_foodplatform] ,&quot; &quot;) - 1&#13;&#10;        )&#13;&#10;      )&#13;&#10;ELSE&#13;&#10;  UPPER( LEFT( [awareness_foodplatform] ,1) ) &#13;&#10;  +  LOWER( RIGHT( [awareness_foodplatform]&#13;&#10;           , LEN( [awareness_foodplatform]) - 1&#13;&#10;           )&#13;&#10;       )&#13;&#10;END' />
      </column>
      <column caption='Preference Foodplatform_Proper' datatype='string' name='[Calculation_356065874484776976]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([preference_foodplatform] , &quot; &quot;)&#13;&#10;THEN&#13;&#10;  UPPER( LEFT( [preference_foodplatform], 1) ) &#13;&#10;  +  LOWER( LEFT(&#13;&#10;          RIGHT([preference_foodplatform]&#13;&#10;             , LEN( [preference_foodplatform]) - 1&#13;&#10;             )&#13;&#10;          ,FIND( [preference_foodplatform],&quot; &quot;) - 2&#13;&#10;          )&#13;&#10;       )&#13;&#10;  + &quot; &quot; &#13;&#10;  + UPPER(&#13;&#10;      LEFT(&#13;&#10;        RIGHT( [preference_foodplatform]&#13;&#10;           , LEN( [preference_foodplatform] )&#13;&#10;           - FIND([preference_foodplatform],&quot; &quot;)&#13;&#10;           )&#13;&#10;        , 1&#13;&#10;        )&#13;&#10;      )&#13;&#10;  + LOWER(&#13;&#10;      RIGHT( [preference_foodplatform]&#13;&#10;        , LEN([preference_foodplatform] )&#13;&#10;         - FIND([preference_foodplatform] ,&quot; &quot;) - 1&#13;&#10;        )&#13;&#10;      )&#13;&#10;ELSE&#13;&#10;  UPPER( LEFT( [preference_foodplatform] ,1) ) &#13;&#10;  +  LOWER( RIGHT( [preference_foodplatform]&#13;&#10;           , LEN( [preference_foodplatform]) - 1&#13;&#10;           )&#13;&#10;       )&#13;&#10;END' />
      </column>
      <column caption='Reasons Ordering_Proper' datatype='string' name='[Calculation_356065874485182482]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([reasons_ordering] , &quot; &quot;)&#13;&#10;THEN&#13;&#10;  UPPER( LEFT( [reasons_ordering] , 1) ) &#13;&#10;  +  LOWER( LEFT(&#13;&#10;          RIGHT([reasons_ordering] &#13;&#10;             , LEN( [reasons_ordering] ) - 1&#13;&#10;             )&#13;&#10;          ,FIND([reasons_ordering] ,&quot; &quot;) - 2&#13;&#10;          )&#13;&#10;       )&#13;&#10;  + &quot; &quot; &#13;&#10;  + UPPER(&#13;&#10;      LEFT(&#13;&#10;        RIGHT( [reasons_ordering] &#13;&#10;           , LEN([reasons_ordering]  )&#13;&#10;           - FIND([reasons_ordering] ,&quot; &quot;)&#13;&#10;           )&#13;&#10;        , 1&#13;&#10;        )&#13;&#10;      )&#13;&#10;  + LOWER(&#13;&#10;      RIGHT( [reasons_ordering] &#13;&#10;        , LEN([reasons_ordering] )&#13;&#10;         - FIND([reasons_ordering]  ,&quot; &quot;) - 1&#13;&#10;        )&#13;&#10;      )&#13;&#10;ELSE&#13;&#10;  UPPER( LEFT([reasons_ordering]  ,1) ) &#13;&#10;  +  LOWER( RIGHT( [reasons_ordering] &#13;&#10;           , LEN( [reasons_ordering] ) - 1&#13;&#10;           )&#13;&#10;       )&#13;&#10;END' />
      </column>
      <column caption='Situations Ordering_Proper' datatype='string' name='[Calculation_356065874485587987]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([situations_ordering], &quot; &quot;)&#13;&#10;THEN&#13;&#10;  UPPER( LEFT( [situations_ordering] , 1) ) &#13;&#10;  +  LOWER( LEFT(&#13;&#10;          RIGHT([situations_ordering]&#13;&#10;             , LEN( [situations_ordering] ) - 1&#13;&#10;             )&#13;&#10;          ,FIND([situations_ordering],&quot; &quot;) - 2&#13;&#10;          )&#13;&#10;       )&#13;&#10;  + &quot; &quot; &#13;&#10;  + UPPER(&#13;&#10;      LEFT(&#13;&#10;        RIGHT([situations_ordering]&#13;&#10;           , LEN([situations_ordering]  )&#13;&#10;           - FIND([situations_ordering] ,&quot; &quot;)&#13;&#10;           )&#13;&#10;        , 1&#13;&#10;        )&#13;&#10;      )&#13;&#10;  + LOWER(&#13;&#10;      RIGHT( [situations_ordering]&#13;&#10;        , LEN([situations_ordering])&#13;&#10;         - FIND([situations_ordering] ,&quot; &quot;) - 1&#13;&#10;        )&#13;&#10;      )&#13;&#10;ELSE&#13;&#10;  UPPER( LEFT([situations_ordering]  ,1) ) &#13;&#10;  +  LOWER( RIGHT( [situations_ordering]&#13;&#10;           , LEN( [situations_ordering]) - 1&#13;&#10;           )&#13;&#10;       )&#13;&#10;END' />
