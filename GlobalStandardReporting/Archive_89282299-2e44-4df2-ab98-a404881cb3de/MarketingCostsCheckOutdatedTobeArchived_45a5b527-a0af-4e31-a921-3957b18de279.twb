              <calculation class='tableau' formula='&quot;month&quot;' />
            </column>
            <column alias='EUR' caption='Currency' datatype='string' name='[Costs Lc Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;1&quot;'>
              <calculation class='tableau' formula='&quot;1&quot;' />
              <aliases>
                <alias key='&quot;1&quot;' value='EUR' />
