      <aliases enabled='yes' />
      <column caption='% DT&lt;20 Last Week' datatype='real' name='[% DT&lt;20 (copy)_1008384133555863554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dt_below_20_count (copy)_1008384133560885256]) / SUM([DT (min) - noaggr Last Week (copy)_1008384133557149700])' />
      </column>
      <column caption='% DT&gt;45' datatype='real' name='[% DT&lt;20 (copy)_124411961062793253]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([dt_over_45_count] )/ sum([dt_denominator])' />
      </column>
      <column caption='% DT&lt;20 Last 2nd Week' datatype='real' name='[% DT&lt;20 Last Week (copy)_274367767260770309]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dt_below_20_count Last Week (copy)_274367767260549123]) / SUM([DT_dn - noaggr Last Week (copy)_274367767260688388])' />
      </column>
      <column caption='% DT&lt;20 Last Year' datatype='real' name='[% DT&lt;20 Last Week (copy)_274367767264448524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dt_below_20_count Last Week (copy)_274367767262965767]) / SUM([DT_dn - noaggr Last Week (copy) (copy)_274367767264210955])' />
      </column>
      <column caption='% DT&gt;45 Last Week' datatype='real' name='[% DT&gt;45 (copy)_1008384133559083015]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([DT&gt;45-last 7 days (copy)_1008384133558784006])/ sum([DT (min) - noaggr Last Week (copy)_1008384133557149700])' />
      </column>
      <column caption='% Fail Last 2nd Week ' datatype='real' name='[% Fail Last Week (copy)_190558588691832849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Orders Last 2nd Week (copy)_190558588690202638] / ([Orders Last 2nd Week (copy)_190558588690202638]+[Orders Last Week (copy)_190558588684312585])' />
      </column>
      <column caption='% Fail Last Year' datatype='real' name='[% Fail Last Week (copy)_2689493433106481186]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Orders Cancelled Last Week (copy)_2689493433104244768] / ([Orders Cancelled Last Week (copy)_2689493433104244768]+[Orders This Year (copy)_2689493433083793424])' />
      </column>
      <column caption='% DT&lt;20' datatype='real' name='[% Fail Orders (copy)_124411961056088097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([dt_below_20_count] )/ sum([dt_denominator])' />
      </column>
