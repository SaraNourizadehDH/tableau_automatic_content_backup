    <worksheet name='D1-Orders/LI'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='12'>Weekly Actuals</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Weekly Flash Summary' name='federated.00zjx00070138x1ed0q571uibk3t' />
          </datasources>
          <datasource-dependencies datasource='federated.00zjx00070138x1ed0q571uibk3t'>
            <column caption='Orders Last Week' datatype='integer' name='[Calculation_190558588682829832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF DATETRUNC(&apos;week&apos;, [report_date]) = DATETRUNC(&apos;week&apos;, TODAY()-7)&#10;THEN [orders_completed]&#10;ELSE NULL&#10;END)' />
            </column>
            <column caption='Logistics Index Last Week' datatype='real' name='[Calculation_190558588701970458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[DT (min) - aggr (copy)_190558588688683020] / [UTR_AVG_last 7 days (copy)_190558588698546200]' />
            </column>
            <column caption='working_hours_rooster-fixed country' datatype='real' name='[Calculation_240027805594386433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [report_date],[region], [country_code] : MAX([working_hours_rooster])}' />
            </column>
            <column caption='UTR Rooster - all' datatype='real' hidden='true' name='[Calculation_240027805595758594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_completed]) / sum( [Calculation_240027805594386433])' />
            </column>
            <column caption='Logistics Index' datatype='real' hidden='true' name='[Calculation_240027805629247492]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[DT (min) (copy)_124411960998801412] / [Calculation_240027805595758594]' />
            </column>
            <column caption='DT (min) - aggr' datatype='real' name='[DT (min) (copy)_124411960998801412]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dt_numerator])/ sum([dt_denominator])' />
            </column>
            <column caption='DT (min) - aggr Last Week' datatype='real' name='[DT (min) - aggr (copy)_190558588688683020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//sum([dt_numerator])/ sum([dt_denominator])&#10;&#10;sum(&#10;IF DATETRUNC(&apos;week&apos;, [report_date]) = DATETRUNC(&apos;week&apos;, TODAY()-7)&#10;THEN [dt_numerator] ELSE NULL END)&#10;/ &#10;sum(&#10;IF DATETRUNC(&apos;week&apos;, [report_date]) = DATETRUNC(&apos;week&apos;, TODAY()-7)&#10;THEN [dt_denominator] ELSE NULL END)' />
            </column>
