              <zone forceUpdate='true' h='36129' id='636' type-v2='text' w='98900' x='550' y='61290'>
                <formatted-text>
                  <run bold='true' fontsize='8'>Weekly Actuals</run>
                  <run fontsize='8'>: The last completed Calendar Week.</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontsize='8'>YoY</run>
                  <run fontsize='8'>: The last completed Calendar Week of this Year compared with the same Calendar Week in the last year.</run>
