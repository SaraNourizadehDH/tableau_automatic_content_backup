    <worksheet name='D-2-UTR-L5W-AM'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='8'>L5W Trend</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Weekly Flash Summary' name='federated.00zjx00070138x1ed0q571uibk3t' />
          </datasources>
          <datasource-dependencies datasource='federated.00zjx00070138x1ed0q571uibk3t'>
            <column caption='UTR_Rooster_by_row' datatype='real' name='[Calculation_129548881185751071]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[utr_dn (copy)_129548881184604190]/[UTR Rooster - all (copy)_129548881182015517]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='working_hours_rooster-fixed country' datatype='real' name='[Calculation_240027805594386433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED  [report_date],[region], [country_code] : MAX([working_hours_rooster])}' />
            </column>
            <column caption='Last 5 Week Filter' datatype='string' name='[Calculation_240027805958582278 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;([report_date] &gt;= DATETRUNC(&apos;week&apos;, TODAY()-35)&#10;AND &#10;[report_date] &lt; DATETRUNC(&apos;week&apos;, TODAY())&#10;)&#10;THEN &quot;LAST 5 WEEK&quot;&#10;else &quot;OTHERS&quot; end' />
            </column>
