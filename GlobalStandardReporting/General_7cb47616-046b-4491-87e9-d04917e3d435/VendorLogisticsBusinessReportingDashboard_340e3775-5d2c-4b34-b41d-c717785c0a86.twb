              <calculation class='tableau' formula='(SUM([unreachable_duration])/SUM([slot_duration]))*100' />
            </column>
            <column caption='% Offline Duration' datatype='real' name='[Calculation_3682748248562880527]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([offline_duration])/SUM([slot_duration]))*100' />
            </column>
            <column caption='% Busy Reason Offline Duration' datatype='real' name='[Calculation_3682748248574197780]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([busy_duration])/SUM([slot_duration]))*100' />
            </column>
            <column caption='% Check-In Offline Reason Duration' datatype='real' name='[Calculation_3682748248574287893]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([checkin_duration])/SUM([slot_duration])*100' />
