            <column caption='Avg. Riders Acceptance Time (Seconds)' datatype='real' name='[Calculation_1413285882235817988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_accepting_time])/[Calculation_1253126618084159507]' />
            </column>
            <column caption='Avg. Dropoff Distance (Meters)' datatype='real' name='[Calculation_1413285882238054405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dropoff_distance])/ [Calculation_1253126618084159507]' />
            </column>
            <column caption='Avg. Pickup Distance (Meters)' datatype='real' name='[Calculation_1413285882238332934]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pickup_distance])/[Calculation_1253126618084159507]' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_1413285882279669768]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Daily&apos; THEN STR([created_date])&#10;WHEN &apos;Weekly&apos; THEN [Calculation_1413285882282614793]&#10;WHEN &apos;Monthly&apos; THEN [Created Date Week (copy)_1413285882285731850]&#10;WHEN &apos;Quarterly&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;,[created_date])))&#10;END' />
            </column>
            <column caption='Created Date Week' datatype='string' name='[Calculation_1413285882282614793]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;&apos; &#10;+ STR(YEAR([created_date]))&#10;+ &apos;-&apos; &#10;+ IF( WEEK([created_date]) - 1 &gt; 9) THEN STR(WEEK([created_date]) - 1)&#10;ELSE   &apos;0&apos; +  STR(WEEK([created_date]) - 1)&#10;END' />
            </column>
            <column caption='# Stacked Deliveries Orders' datatype='integer' name='[Calculation_148900286419791872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([stacked_deliveries_cnt])' />
            </column>
            <column caption='_is today?' datatype='boolean' name='[Calculation_2235826142795612160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_date] = DATE(TODAY())' />
            </column>
            <column caption='% Preorder Order Shares' datatype='real' name='[Calculation_3682748248509022208]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([preorder_cnt])/ [Calculation_1253126618084159507])*100' />
            </column>
            <column caption='% Preorder Failed Rate' datatype='real' name='[Calculation_3682748248509173761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([preorder_fail_cnt])/ SUM([preorder_cnt]))*100' />
            </column>
            <column caption='% Preorder Vendor Failed' datatype='real' name='[Calculation_3682748248509456386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([preorder_vendor_fail_ct])/SUM([preorder_cnt]))*100' />
