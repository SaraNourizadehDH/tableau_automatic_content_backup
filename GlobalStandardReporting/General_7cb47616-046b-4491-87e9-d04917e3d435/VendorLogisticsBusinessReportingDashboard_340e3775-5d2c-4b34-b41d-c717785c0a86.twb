            <column caption='% Client Reasons Offline Duration' datatype='real' name='[Calculation_3682748248574685207]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([client_offline_duration])/SUM([slot_duration]))*100' />
