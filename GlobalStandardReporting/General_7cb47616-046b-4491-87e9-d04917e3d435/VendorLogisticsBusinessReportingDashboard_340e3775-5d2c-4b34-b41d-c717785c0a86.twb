            <column caption='    % Vendor &apos;Live Order&apos; Contact Rate' datatype='real' name='[Calculation_7034270779507986437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([live_order_incoming_contacts])/SUM([orders_received_ct])' />
            </column>
            <column caption='    % Food Is Ready Usage' datatype='real' name='[Calculation_7034270779508686854]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([order_food_is_ready_clicked_ct])/SUM([od_orders_accepted_ct])' />
            </column>
            <column caption='    % Late Orders with Vendor Late Over 10' datatype='real' name='[Calculation_7034270779509358599]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_10_count])/SUM([vendor_late_cnt])' />
