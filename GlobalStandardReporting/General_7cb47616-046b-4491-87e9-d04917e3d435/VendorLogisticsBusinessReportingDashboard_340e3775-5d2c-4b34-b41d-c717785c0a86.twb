ime (Seconds)&apos; THEN [Calculation_128915565329920004]&#10;WHEN &apos;Avg. Pickup Distance&apos; THEN [Calculation_128915565329334275]&#10;WHEN &apos;Avg. Dropoff Distance&apos; THEN [Calculation_128915565328687105]&#10;WHEN &apos;% Offline Duration&apos; THEN [Calculation_128915565332938763]&#10;WHEN &apos;% Offline Special Day Duration&apos; THEN [Calculation_128915565336543244]&#10;WHEN &apos;% Offline Unreachable Duration&apos; THEN [Calculation_128915565332721674]&#10;WHEN &apos;Vendors with Orders&apos; THEN [Calculation_141581928416874497]&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_128915565480652817]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Daily&apos; THEN STR([created_date])&#10;WHEN &apos;Weekly&apos; THEN [Calculation_128915565481050130]&#10;WHEN &apos;Monthly&apos; THEN [Calculation_128915565482999827]&#10;WHEN &apos;Quarterly&apos; THEN STR(DATE(DATETRUNC(&apos;quarter&apos;,[created_date])))&#10;END' />
            </column>
            <column caption='Created Date Week' datatype='string' name='[Calculation_128915565481050130]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;&apos; &#10;+ STR(YEAR([created_date]))&#10;+ &apos;-&apos; &#10;+ IF( WEEK([created_date]) &gt; 9) THEN STR(WEEK([created_date]))&#10;ELSE   &apos;0&apos; +  STR(WEEK([created_date]))&#10;END' />
            </column>
            <column caption='Created Date Month' datatype='string' name='[Calculation_128915565482999827]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;&apos; &#10;+  STR(YEAR([created_date]))&#10;+ &apos;-&apos; &#10;+  IF( MONTH([created_date]) &gt; 9) THEN STR(MONTH([created_date]))&#10;ELSE   &apos;0&apos; +  STR(MONTH([created_date]))&#10;END' />
            </column>
            <column caption='Platform Vendor' datatype='string' name='[Calculation_131871041718714368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[entity_id] + STR([vendor_code])' />
            </column>
            <column caption='# Vendors with Orders' datatype='integer' name='[Calculation_141581928416874497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [orders_received_ct] &gt; 0 THEN [Calculation_131871041718714368] END)' />
            </column>
            <column caption='_is today?' datatype='boolean' name='[Calculation_2235826142796382209]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_date] =  DATE(TODAY())' />
            </column>
            <column caption='_lookup_date' datatype='date' name='[Calculation_2235826142800584706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOOKUP(MIN([created_date]),0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='_prev_date_chosen_metrics' datatype='real' name='[Calculation_579486641951064064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOOKUP([Calculation_128915565340053520],-1)'>
                <table-calc ordering-field='[federated.00ypnok05nyjnl13hhkrj0k9dyjl].[Calculation_128915565480652817]' ordering-type='Field' />
