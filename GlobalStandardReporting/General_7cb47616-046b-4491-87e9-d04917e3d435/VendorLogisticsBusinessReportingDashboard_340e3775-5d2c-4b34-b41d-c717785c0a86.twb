                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='_final chosen metrics' datatype='real' name='[Calculation_579486641992855554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF( [Parameters].[Choose Date Granularity (copy 2)])&#10;THEN [Calculation_579486641987399681]&#10;ELSE [Calculation_128915565340053520]&#10;END'>
