            <column caption='% Special Days Offline Duration' datatype='real' name='[Calculation_3682748248600870948]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([special_day])/SUM([slot_duration]))*100' />
            </column>
            <column caption='    % Rider Map Usage' datatype='real' name='[Calculation_473159462285238272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// rider map is only availabled for accepted OWN Delivery orders that are not DIRECT POS&#10;SUM([rider_map_clicked_orders_ct]) &#10;/ [Calculation_521925002014121984] // this is limited to OD DIRECT POS' />
            </column>
            <column caption='    Food Sitting Time (Seconds)' datatype='real' name='[Calculation_473159462287704066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// food sitting time is actual pick-up time - food is ready time&#10;SUM([total_food_sitting_time]) / SUM([order_food_is_ready_clicked_ct])' />
            </column>
            <column caption='_order_base_rider_map_calc' datatype='integer' name='[Calculation_521925002014121984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// this gives us all order for which we could potentially click on rider map&#10;// od_pos covers only the direct pos orders&#10;( SUM([od_orders_accepted_ct]) - SUM([od_pos_orders_ct]) )' />
            </column>
            <column caption='Avg. Vendor Late Time (Seconds)' datatype='real' name='[Calculation_5860871990286118923]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_time])/SUM([vendor_late_cnt])' />
            </column>
            <column caption='    % Device delivered by OBS' datatype='real' default-format='p0.00%' name='[Calculation_7034270779505901568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([obs_device_deliveries])/SUM([all_device_deliveries])' />
            </column>
            <column caption='    % Self Activated Vendors' datatype='real' name='[Calculation_7034270779506356225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([self_activated_vendors_ct])/SUM([activated_vendors_ct])' />
            </column>
            <column caption='    % New Vendor&apos;s Fail-rate ' datatype='real' name='[Calculation_7034270779507253251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( [new_vendor_order_failed_ct])/SUM([new_vendor_orders_received_ct])' />
            </column>
            <column caption='    New Vendors&apos; NPS' datatype='real' name='[Calculation_7034270779507683332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([new_nps_score_sum])/SUM([new_nps_vendors_cnt])' />
