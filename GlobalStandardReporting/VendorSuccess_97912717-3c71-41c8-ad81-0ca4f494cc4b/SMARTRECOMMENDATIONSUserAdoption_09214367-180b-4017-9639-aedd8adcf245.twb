    <worksheet name='Recommended Users Engagement #'>
      <table>
        <view>
          <datasources>
            <datasource caption='growth_vendor_smart_recommendation_user_engagement (pa_staging)' name='federated.0ekej5d1fccrer1gljqfs10dhwqd' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Recommended Product' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Any (Adtech/Ops)&quot;'>
              <calculation class='tableau' formula='&quot;Any (Adtech/Ops)&quot;' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ekej5d1fccrer1gljqfs10dhwqd'>
            <column caption='Date Granularity Check' datatype='boolean' name='[Calculation_2937965479316484152]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date_granularity] = [Parameters].[Parameter 2]' />
            </column>
            <column caption='Recommended Product' datatype='boolean' name='[Calculation_823877296720322561]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Any (Adtech/Ops)&quot; THEN [recommended]&#10;WHEN &quot;Adtech&quot; THEN [adtech_recommended]&#10;WHEN &quot;Adtech - CPC&quot; THEN [cpc_recommended]&#10;WHEN &quot;Adtech - CPC Top Up&quot; THEN [cpc_top_up_recommended]&#10;WHEN &quot;Adtech - VFD&quot; THEN [vfd_recommended]&#10;WHEN &quot;Adtech - Joker&quot; THEN [joker_recommended]&#10;WHEN &quot;Adtech - Targeted Deals&quot; THEN [targeted_deals_recommended]&#10;WHEN &quot;Ops&quot; THEN [ops_recommended]&#10;WHEN &quot;Ops - Fail Rate&quot; THEN [fail_rate_recommended]&#10;WHEN &quot;Ops - Offline Rate&quot; THEN [offline_rate_recommended]&#10;WHEN &quot;Ops - Avoidable Wait Time&quot; THEN [avoidable_wait_time_recommended]&#10;WHEN &quot;Ops - Menu Score&quot; THEN [menu_score_recommended]&#10;WHEN &quot;Ops - Ratings&quot; THEN [ratings_recommended]&#10;WHEN &quot;Ops - Contact Rate&quot; THEN [contact_rate_recommended]&#10;END' />
            </column>
            <column caption='Recommended Product Card Clicks' datatype='integer' name='[Calculation_823877296728477711]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Any (Adtech/Ops)&quot; THEN [reco_card_clicks]&#10;WHEN &quot;Adtech&quot; THEN [reco_adtech_card_clicks]&#10;WHEN &quot;Adtech - CPC&quot; THEN [reco_cpc_card_clicks]&#10;WHEN &quot;Adtech - CPC Top Up&quot; THEN [reco_cpc_top_up_card_clicks]&#10;WHEN &quot;Adtech - VFD&quot; THEN [reco_vfd_card_clicks]&#10;WHEN &quot;Adtech - Joker&quot; THEN [reco_joker_card_clicks]&#10;WHEN &quot;Adtech - Targeted Deals&quot; THEN [reco_targeted_deals_card_clicks]&#10;WHEN &quot;Ops&quot; THEN [reco_ops_card_clicks]&#10;WHEN &quot;Ops - Fail Rate&quot; THEN [reco_fail_rate_card_clicks]&#10;WHEN &quot;Ops - Offline Rate&quot; THEN [reco_offline_rate_card_clicks]&#10;WHEN &quot;Ops - Avoidable Wait Time&quot; THEN [reco_avoidable_wait_time_card_clicks]&#10;WHEN &quot;Ops - Online Markup&quot; THEN [reco_online_markup_card_clicks]&#10;WHEN &quot;Ops - Menu Score&quot; THEN [reco_menu_score_card_clicks]&#10;WHEN &quot;Ops - Ratings&quot; THEN [reco_ratings_accept_clicks]&#10;WHEN &quot;Ops - Contact Rate&quot; THEN [reco_contact_rate_card_clicks]&#10;END' />
            </column>
            <column caption='Avg. Recommended Product Accept Clicked Users' datatype='real' name='[Recommended Product Accept Clicked Users (copy)_823877296759623700]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ INCLUDE [created_date], [date_granularity] : COUNTD(IF [Calculation_823877296720322561] = TRUE AND [Recommended Product Card Clicked (copy)_823877296730451985] &gt; 0 THEN [user_id] END) })' />
            </column>
            <column caption='Recommended Product Accept Clicks' datatype='integer' name='[Recommended Product Card Clicked (copy)_823877296730451985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Any (Adtech/Ops)&quot; THEN [reco_accept_clicks]&#10;WHEN &quot;Adtech&quot; THEN [reco_adtech_accept_clicks]&#10;WHEN &quot;Adtech - CPC&quot; THEN [reco_cpc_accept_clicks]&#10;WHEN &quot;Adtech - CPC Top Up&quot; THEN [reco_cpc_top_up_accept_clicks]&#10;WHEN &quot;Adtech - VFD&quot; THEN [reco_vfd_accept_clicks]&#10;WHEN &quot;Adtech - Joker&quot; THEN [reco_joker_accept_clicks]&#10;WHEN &quot;Adtech - Targeted Deals&quot; THEN [reco_targeted_deals_accept_clicks]&#10;WHEN &quot;Ops&quot; THEN [reco_ops_accept_clicks]&#10;WHEN &quot;Ops - Fail Rate&quot; THEN [reco_fail_rate_accept_clicks]&#10;WHEN &quot;Ops - Offline Rate&quot; THEN [reco_offline_rate_accept_clicks]&#10;WHEN &quot;Ops - Avoidable Wait Time&quot; THEN [reco_avoidable_wait_time_accept_clicks]&#10;WHEN &quot;Ops - Online Markup&quot; THEN [reco_online_markup_accept_clicks]&#10;WHEN &quot;Ops - Menu Score&quot; THEN [reco_menu_score_accept_clicks]&#10;WHEN &quot;Ops - Ratings&quot; THEN [reco_ratings_accept_clicks]&#10;WHEN &quot;Ops - Contact Rate&quot; THEN [reco_contact_rate_accept_clicks]&#10;END' />
            </column>
            <column caption='Avg. Recommended Product Card Clicked Users' datatype='real' name='[Recommended Product Card Clicked Users (copy)_823877296759623702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ INCLUDE [created_date], [date_granularity] : COUNTD(IF [Calculation_823877296720322561] = TRUE AND [Calculation_823877296728477711] &gt; 0 THEN [user_id] END) })' />
            </column>
            <column caption='Avg. Recommended Product See All Clicked Users' datatype='real' name='[Recommended Product See All Clicked Users (copy)_823877296759623704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ INCLUDE [created_date], [date_granularity] : COUNTD(IF [Calculation_823877296720322561] = TRUE AND [reco_see_all_clicks] &gt; 0 THEN [user_id] END) })' />
            </column>
            <column caption='Avg. Recommended Product Users' datatype='real' name='[Recommended Product Users (copy)_823877296759623706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ INCLUDE [created_date], [date_granularity] : COUNTD(IF [Calculation_823877296720322561] = TRUE THEN [user_id] END) })' />
            </column>
            <column caption='Avg. Recommended Product Widget Viewed Users' datatype='real' name='[Recommended Product Widget Viewed Users (copy)_823877296759623708]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ INCLUDE [created_date], [date_granularity] : COUNTD(IF [Calculation_823877296720322561] = TRUE AND [reco_widget_views] &gt; 0 THEN [user_id] END) })' />
            </column>
            <column caption='Avg. Users Engaging with Portal' datatype='real' name='[Total Users (copy)_255649687436029954]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ INCLUDE [created_date], [date_granularity] : COUNTD([user_id]) })' />
            </column>
