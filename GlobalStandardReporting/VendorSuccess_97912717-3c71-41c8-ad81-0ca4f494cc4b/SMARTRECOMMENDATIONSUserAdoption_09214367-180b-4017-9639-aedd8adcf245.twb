              <calculation class='tableau' formula='[Adtech Recommended Users (copy)_255649687453225030] / [Total Users (copy)_255649687436029954]' />
            </column>
            <column caption='Avg. Adtech Recommended Users' datatype='real' name='[Adtech Recommended Users (copy)_255649687453225030]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ INCLUDE [created_date], [date_granularity] : COUNTD(IF [adtech_recommended] = TRUE THEN [user_id] END) })' />
