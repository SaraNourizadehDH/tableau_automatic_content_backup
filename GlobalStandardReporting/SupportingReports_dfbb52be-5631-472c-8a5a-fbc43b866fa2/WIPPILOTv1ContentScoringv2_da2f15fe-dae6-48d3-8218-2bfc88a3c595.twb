              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Global&apos; THEN  AVG([global_completeness_score_aggregated])&#10;WHEN &apos;Region&apos; THEN AVG([region_completeness_score_aggregated])&#10;WHEN &apos;Country&apos; THEN AVG([country_completeness_score_aggregated])&#10;WHEN &apos;Global - Product Type&apos; THEN AVG([prod_type_completeness_score_aggregated])&#10;WHEN &apos;Country - Product Type&apos; THEN AVG([country_product_completeness_score_aggregated])&#10;WHEN &apos;Management Entity&apos; THEN AVG([mgmt_entity_completeness_score_aggregated])&#10;// ELSE [Total Cust Count (vendor level)]&#10;END' />
