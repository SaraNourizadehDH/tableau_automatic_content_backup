      <aliases enabled='yes' />
      <column caption='% Page with case option' datatype='real' default-format='n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;' name='[% Page with chat option (copy)_4333025820962111491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([page_with_case_option_ind])&#10;/ [Calculation_5834835555274731520] * 100' />
      </column>
      <column caption='% Page with automation option ' datatype='real' default-format='n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;' name='[% Page with chat option (copy)_4333025820962414596]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([page_with_automation_option_ind])&#10;/ [Calculation_5834835555274731520] * 100' />
      </column>
      <column caption='Days live' datatype='integer' name='[Calculation_3522729730657087488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[created_date], [delete_date])' />
      </column>
      <column caption='% Seamless Sessions' datatype='real' default-format='p0.0%' name='[Calculation_3916653955264995329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_seamless_sessions])/ SUM([num_sessions_resolution_page_reached]) * 100' />
      </column>
      <column caption='% Sessions Multiple leaves visited' datatype='real' default-format='p0.0%' name='[Calculation_3916653955265593346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_sessions_with_multiple_leaves_visited])/ SUM([num_sessions_resolution_page_reached]) * 100' />
      </column>
      <column caption='Automation Rate' datatype='real' default-format='p0.0%' name='[Calculation_3916653955284992003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_automated_sessions])/ SUM([num_sessions_resolution_page_reached])* 100' />
      </column>
      <column caption='Self-service Rate' datatype='real' default-format='p0.0%' name='[Calculation_3916653955285491716]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM([num_deflected_sessions])+SUM([num_automated_sessions]))&#10;/SUM([num_sessions_resolution_page_reached]))*100' />
      </column>
      <column caption='Template 1' datatype='string' name='[Calculation_3916653956671012871]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF[Parameters].[num_self_served_sessions Parameter] = [template_version] THEN [template_version] END' />
      </column>
      <column caption='% Page with chat option' datatype='real' default-format='n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;' name='[Calculation_4333025820959809537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([page_with_chat_option_ind])&#10;/ [Calculation_5834835555274731520] * 100' />
      </column>
      <column caption='Information 2' datatype='string' name='[Calculation_4333025821011132421]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;information&apos;' />
      </column>
      <column caption='Self service CSAT' datatype='real' default-format='p0.0%' name='[Calculation_4383691312178511873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_ssf_csat_responses_45]) / SUM([num_ssf_csat_responses])* 100' />
      </column>
      <column caption='Dimension 1 ' datatype='string' name='[Calculation_5671650437212774401]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;  WHEN &apos;Country&apos; THEN [country]&#10;  WHEN &apos;Brand&apos; THEN [brand]&#10;  WHEN &apos;Page ID&apos; THEN [page_id]&#10;  WHEN &apos;Template Name&apos; THEN [template_name]&#10;  WHEN &apos;Revision Number&apos; THEN [revision_number]&#10;  WHEN &apos;Global&apos; THEN [Calculation_5671650437212823554]&#10;  WHEN &apos;CCR&apos; THEN [deflection_id]&#10;END' />
