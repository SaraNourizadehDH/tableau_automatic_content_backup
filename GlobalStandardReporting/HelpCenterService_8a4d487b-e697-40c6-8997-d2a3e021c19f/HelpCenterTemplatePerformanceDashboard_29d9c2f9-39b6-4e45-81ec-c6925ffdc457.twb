    <worksheet name='Timeline'>
      <table>
        <view>
          <datasources>
            <datasource caption='helpcenter_template_performance_dataset (rl)' name='federated.10ryu7301f8qqh11oxzle1l88ixm' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Number of sessions&quot;'>
              <calculation class='tableau' formula='&quot;Number of sessions&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.10ryu7301f8qqh11oxzle1l88ixm'>
            <column caption='Days live' datatype='integer' name='[Calculation_3522729730657087488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[created_date], [delete_date])' />
            </column>
            <column caption='% Seamless Sessions' datatype='real' default-format='p0.0%' name='[Calculation_3916653955264995329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_seamless_sessions])/ SUM([num_sessions_resolution_page_reached]) * 100' />
            </column>
            <column caption='% Sessions Multiple leaves visited' datatype='real' default-format='p0.0%' name='[Calculation_3916653955265593346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_with_multiple_leaves_visited])/ SUM([num_sessions_resolution_page_reached]) * 100' />
            </column>
            <column caption='Automation Rate' datatype='real' default-format='p0.0%' name='[Calculation_3916653955284992003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_automated_sessions])/ SUM([num_sessions_resolution_page_reached])* 100' />
            </column>
            <column caption='Self-service Rate' datatype='real' default-format='p0.0%' name='[Calculation_3916653955285491716]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([num_deflected_sessions])+SUM([num_automated_sessions]))&#10;/SUM([num_sessions_resolution_page_reached]))*100' />
            </column>
            <column caption='Self service CSAT' datatype='real' default-format='p0.0%' name='[Calculation_4383691312178511873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_ssf_csat_responses_45]) / SUM([num_ssf_csat_responses])* 100' />
            </column>
            <column caption='Date' datatype='date' name='[Calculation_590886371918618625]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[created_date]' />
            </column>
            <column caption='KPI' datatype='real' name='[Calculation_590886371926323203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &apos;Number of sessions&apos; THEN SUM([num_sessions])&#10;  WHEN &apos;Number of seamless sessions&apos; THEN SUM([num_seamless_sessions])&#10;  WHEN &apos;% Seamless sessions&apos; THEN [Calculation_3916653955264995329]&#10;  WHEN &apos;Automation Rate&apos; THEN [Calculation_3916653955284992003]&#10;  WHEN &apos;% Sessions with Multiple leaves visited &apos; THEN [Calculation_3916653955265593346]&#10;  WHEN &apos;Self Service CSAT&apos; THEN [Calculation_4383691312178511873]&#10;  WHEN &apos;Self Service Rate&apos; THEN [Calculation_3916653955285491716]&#10;END' />
            </column>
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column datatype='date' name='[delete_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_590886371918618625]' derivation='None' name='[none:Calculation_590886371918618625:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[created_date]' derivation='None' name='[none:created_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[created_date]' derivation='None' name='[none:created_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[revision_number]' derivation='None' name='[none:revision_number:nk]' pivot='key' type='nominal' />
            <column-instance column='[template_name]' derivation='None' name='[none:template_name:nk]' pivot='key' type='nominal' />
            <column caption='Num Automated Sessions' datatype='integer' name='[num_automated_sessions]' role='measure' type='quantitative' />
            <column caption='Num Deflected Sessions' datatype='integer' name='[num_deflected_sessions]' role='measure' type='quantitative' />
            <column caption='Num Seamless Sessions' datatype='integer' name='[num_seamless_sessions]' role='measure' type='quantitative' />
            <column caption='Num Sessions' datatype='integer' name='[num_sessions]' role='measure' type='quantitative' />
            <column datatype='integer' name='[num_sessions_resolution_page_reached]' role='measure' type='quantitative' />
            <column caption='Num Sessions With Multiple Leaves Visited' datatype='integer' name='[num_sessions_with_multiple_leaves_visited]' role='measure' type='quantitative' />
            <column caption='Num Ssf Csat Responses' datatype='integer' name='[num_ssf_csat_responses]' role='measure' type='quantitative' />
            <column caption='Num Ssf Csat Responses 45' datatype='integer' name='[num_ssf_csat_responses_45]' role='measure' type='quantitative' />
            <column caption='Revision Number' datatype='string' datatype-customized='true' name='[revision_number]' role='dimension' type='nominal' />
