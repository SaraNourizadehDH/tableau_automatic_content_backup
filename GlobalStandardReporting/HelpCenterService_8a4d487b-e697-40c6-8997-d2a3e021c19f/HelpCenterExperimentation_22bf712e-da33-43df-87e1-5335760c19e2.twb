      <layout-options>
        <title>
          <formatted-text>
            <run>% Self service CSAT</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='helpcenter_customer_experiments' name='federated.0e0hayn1fe5dmo11xipn30csudp5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Participants' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Participants only&quot;'>
              <calculation class='tableau' formula='&quot;Participants only&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0e0hayn1fe5dmo11xipn30csudp5'>
            <column caption='% Smart suggestions displayed' datatype='real' default-format='p0.0%' name='[% Contact rate (copy)_1000643570514165762]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_smart_suggestions_displayed]) / SUM([num_sessions])' />
            </column>
            <column caption='% Contact rate' datatype='real' default-format='p0.0%' name='[% Leaf rating (copy)_145241107890761742]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_contact_created]) / SUM([num_sessions])' />
            </column>
            <column caption='% Smart suggestions top result chosen' datatype='real' default-format='p0.0%' name='[% Smart suggestions clicked (copy)_1000643570514673668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_smart_suggestions_top_result_clicked]) / SUM([num_sessions_smart_suggestions_clicked])' />
            </column>
            <column caption='% Smart suggestions clicked' datatype='real' default-format='p0.0%' name='[% Smart suggestions displayed (copy)_1000643570514550787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_smart_suggestions_clicked]) / SUM([num_sessions_smart_suggestions_displayed])' />
            </column>
            <column caption='participation_filter' datatype='boolean' name='[Calculation_0562974373892096]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3] = &apos;All assigned users&apos;&#13;&#10;&#13;&#10;OR [Parameters].[Parameter 3] = &apos;Participants only&apos; AND [is_participant]&#13;&#10;&#13;&#10;OR [Parameters].[Parameter 3] = &apos;Non-participants only&apos; AND NOT [is_participant]' />
            </column>
            <column caption='Management Entity' datatype='string' name='[Calculation_0562974461218823]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[management_entity_group]' />
            </column>
            <column caption='contact_rate_2_std' datatype='real' name='[Calculation_145241107892752401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='2 * SQRT(SUM([num_sessions]) * [% Leaf rating (copy)_145241107890761742] * (1-[% Leaf rating (copy)_145241107890761742])) / SUM([num_sessions])' />
            </column>
            <column caption='contact_rate_lower' datatype='real' default-format='p0.0%' name='[Calculation_145241107893309458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([% Leaf rating (copy)_145241107890761742] - [Calculation_145241107892752401], 0)' />
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Contact center' datatype='string' name='[contact_center]' role='dimension' type='nominal' />
            <column caption='contact_rate_upper' datatype='real' default-format='p0.0%' name='[contact_rate_lower (copy)_145241107893440531]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN([% Leaf rating (copy)_145241107890761742] + [Calculation_145241107892752401], 1)' />
            </column>
