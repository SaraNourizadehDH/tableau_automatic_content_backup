      <column caption='ac_csat_2_std' datatype='real' name='[ss_csat_2_std (copy)_540713461829132288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='2 * SQRT(SUM([num_after_contact_csat_responses]) * [% Self service CSAT 4&amp;5 (copy)_0562974391910402] * (1-[% Self service CSAT 4&amp;5 (copy)_0562974391910402])) / SUM([num_after_contact_csat_responses])' />
      </column>
      <column caption='ac_csat_lower' datatype='real' default-format='p0.0%' name='[ss_csat_lower (copy)_540713461829132289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([% Self service CSAT 4&amp;5 (copy)_0562974391910402] - [ss_csat_2_std (copy)_540713461829132288], 0)' />
      </column>
      <column caption='ac_csat_upper' datatype='real' default-format='p0.0%' name='[ss_csat_upper (copy)_540713461829132290]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([% Self service CSAT 4&amp;5 (copy)_0562974391910402] + [ss_csat_2_std (copy)_540713461829132288], 1)' />
      </column>
