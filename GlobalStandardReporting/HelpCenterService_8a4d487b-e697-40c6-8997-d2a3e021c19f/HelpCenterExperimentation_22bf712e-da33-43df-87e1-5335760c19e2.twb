    <worksheet name='fullscreen_summary'>
      <layout-options>
        <title>
          <formatted-text>
            <run>% Self service CSAT</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='helpcenter_customer_experiments' name='federated.0e0hayn1fe5dmo11xipn30csudp5' />
          </datasources>
          <datasource-dependencies datasource='federated.0e0hayn1fe5dmo11xipn30csudp5'>
            <column caption='# Avg. chat handling time min (first contact)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# Avg. handling time min (first contact) (copy)_1166995311927230464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([sum_first_chat_handling_time_sec]) / SUM([num_sessions_first_contact_is_chat])) / 60' />
            </column>
            <column caption='% After contact CSAT trigger rate' datatype='real' default-format='p0.0%' name='[% AC CSAT response rate (copy)_682858342738841603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_chats_with_survey_trigger]) / SUM([num_chats_created])' />
            </column>
            <column caption='% Contact rate (Active sessions)' datatype='real' default-format='p0.0%' name='[% Contact rate (copy)_603552787172208640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_contact_created]) / SUM([num_sessions_active])' />
            </column>
            <column caption='% Contact rate' datatype='real' default-format='p0.0%' name='[% Leaf rating (copy)_145241107890761742]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_contact_created]) / SUM([num_sessions])' />
            </column>
            <column caption='% After contact CSAT' datatype='real' default-format='p0.0%' name='[% Self service CSAT 4&amp;5 (copy)_0562974391910402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_after_contact_csat_4_5]) / SUM([num_after_contact_csat_responses])' />
            </column>
            <column caption='% Self service CSAT' datatype='real' default-format='p0.0%' name='[Calculation_145241107885936641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_self_service_csat_4_5]) / SUM([num_self_service_csat_responses])' />
            </column>
            <column caption='contact_rate_2_std' datatype='real' name='[Calculation_145241107892752401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='2 * SQRT(SUM([num_sessions]) * [% Leaf rating (copy)_145241107890761742] * (1-[% Leaf rating (copy)_145241107890761742])) / SUM([num_sessions])' />
            </column>
            <column caption='contact_rate_lower' datatype='real' default-format='p0.0%' name='[Calculation_145241107893309458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([% Leaf rating (copy)_145241107890761742] - [Calculation_145241107892752401], 0)' />
            </column>
            <column caption='ss_csat_2_std' datatype='real' name='[contact_rate_2_std (copy)_1399493608349614081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='2 * SQRT(SUM([num_self_service_csat_responses]) * [Calculation_145241107885936641] * (1-[Calculation_145241107885936641])) / SUM([num_self_service_csat_responses])' />
            </column>
            <column caption='contact_rate_active_2_std ' datatype='real' name='[contact_rate_2_std (copy)_603552787172667393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='2 * SQRT(SUM([num_sessions_active]) * [% Contact rate (copy)_603552787172208640] * (1-[% Contact rate (copy)_603552787172208640])) / SUM([num_sessions_active])' />
            </column>
            <column caption='trigger_rate_2_std' datatype='real' name='[contact_rate_2_std (copy)_682858342740688904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='2 * SQRT(SUM([num_chats_created]) * [% AC CSAT response rate (copy)_682858342738841603] * (1-[% AC CSAT response rate (copy)_682858342738841603])) / SUM([num_chats_created])' />
            </column>
            <column caption='ss_csat_lower' datatype='real' default-format='p0.0%' name='[contact_rate_lower (copy)_1399493608349806594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([Calculation_145241107885936641] - [contact_rate_2_std (copy)_1399493608349614081], 0)' />
            </column>
            <column caption='contact_rate_upper' datatype='real' default-format='p0.0%' name='[contact_rate_lower (copy)_145241107893440531]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN([% Leaf rating (copy)_145241107890761742] + [Calculation_145241107892752401], 1)' />
            </column>
            <column caption='contact_rate_active_lower' datatype='real' default-format='p0.0%' name='[contact_rate_lower (copy)_603552787173027842]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([% Contact rate (copy)_603552787172208640] - [contact_rate_2_std (copy)_603552787172667393], 0)' />
            </column>
            <column caption='trigger_rate_upper' datatype='real' default-format='p0.0%' name='[contact_rate_lower (copy)_682858342740688905]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN([% AC CSAT response rate (copy)_682858342738841603] + [contact_rate_2_std (copy)_682858342740688904], 1)' />
            </column>
            <column caption='ss_csat_upper' datatype='real' default-format='p0.0%' name='[contact_rate_upper (copy)_1399493608349941763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN([Calculation_145241107885936641] + [contact_rate_2_std (copy)_1399493608349614081], 1)' />
            </column>
            <column caption='contact_rate_active_upper' datatype='real' default-format='p0.0%' name='[contact_rate_upper (copy)_603552787173855235]' role='measure' type='quantitative'>
