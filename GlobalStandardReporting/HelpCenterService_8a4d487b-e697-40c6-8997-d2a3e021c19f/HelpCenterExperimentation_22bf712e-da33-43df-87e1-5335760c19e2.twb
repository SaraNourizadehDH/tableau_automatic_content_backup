        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &quot;Daily&quot; THEN STR([created_date])&#13;&#10;    WHEN &quot;Weekly&quot; THEN [week]&#13;&#10;    WHEN &quot;Monthly&quot; THEN [month]&#13;&#10;END' />
