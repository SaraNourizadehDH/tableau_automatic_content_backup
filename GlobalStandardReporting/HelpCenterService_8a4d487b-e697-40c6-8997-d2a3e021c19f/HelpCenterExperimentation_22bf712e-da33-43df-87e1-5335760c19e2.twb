    <worksheet name='Drill down_'>
      <layout-options>
        <title>
          <formatted-text>
            <run># Sessions</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='helpcenter_customer_experiments' name='federated.0e0hayn1fe5dmo11xipn30csudp5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
              <calculation class='tableau' formula='&quot;None&quot;' />
            </column>
            <column caption='Participants' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Participants only&quot;'>
              <calculation class='tableau' formula='&quot;Participants only&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0e0hayn1fe5dmo11xipn30csudp5'>
            <column caption='# Avg. chats when chat created' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[# Avg. contacts when contacting (copy)_1028791093779607552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_chats_created]) / SUM([num_sessions_chat_created])' />
            </column>
            <column caption='# Avg. session duration min' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# Avg. contacts when contacting (copy)_145241107888742408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([sum_session_duration_sec]) / SUM([num_sessions])) / 60' />
            </column>
            <column caption='# Avg. leaves visited when leaf reached' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# Avg. session duration min (copy)_0562974403661828]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_leaves_visited]) / SUM([num_sessions_leaf_reached])' />
            </column>
            <column caption='# Avg. handling time min (first contact)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# Avg. session duration min (copy)_0562974444003333]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([sum_first_contact_handling_time_sec]) / SUM([num_sessions_contact_created])) / 60' />
            </column>
            <column caption='% Chats out of contacts created' datatype='real' default-format='p0.0%' name='[% Active sessions (copy)_0562974403067907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_chats_created]) / SUM(IFNULL([num_chats_created], 0) + IFNULL([num_cases_created], 0))' />
            </column>
            <column caption='% Self service CSAT response rate' datatype='real' default-format='p0.00%' name='[% Active sessions (copy)_145241107886538754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_self_service_csat_responses]) / SUM([num_sessions] - [num_sessions_contact_created])' />
            </column>
            <column caption='% Leaf reached out of active' datatype='real' default-format='p0.0%' name='[% Active sessions (copy)_145241107886956548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_leaf_reached]) / SUM([num_sessions_active])' />
            </column>
            <column caption='% Contact rate' datatype='real' default-format='p0.0%' name='[% Leaf rating (copy)_145241107890761742]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_contact_created]) / SUM([num_sessions])' />
            </column>
            <column caption='% Leaf rating positive' datatype='real' default-format='p0.0%' name='[% Leaf rating response rate (copy)_145241107889258506]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_positive_last_leaf_rating]) / SUM([num_sessions_last_leaf_rating_available])' />
            </column>
            <column caption='% Contact created when leaf reached' datatype='real' default-format='p0.0%' name='[% Leaf reached out of active (copy)_145241107887230982]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_contact_created]) / SUM([num_sessions_leaf_reached])' />
            </column>
            <column caption='% Multiple leaves visited' datatype='real' default-format='p0.0%' name='[% Leaf reached out of active (copy)_145241107889926155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_multiple_leaves_reached]) / SUM([num_sessions_leaf_reached])' />
            </column>
            <column caption='% After contact CSAT' datatype='real' default-format='p0.0%' name='[% Self service CSAT 4&amp;5 (copy)_0562974391910402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_after_contact_csat_4_5]) / SUM([num_after_contact_csat_responses])' />
            </column>
            <column caption='% AC CSAT response rate' datatype='real' default-format='p0.0%' name='[% Self service CSAT response rate (copy)_0562974391758849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_after_contact_csat_responses]) / SUM([num_sessions_contact_created])' />
            </column>
            <column caption='# Avg. contacts when contacting' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[% Self service CSAT response rate (copy)_145241107887874055]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_cases_created] + [num_chats_created]) / SUM([num_sessions_contact_created])' />
            </column>
            <column caption='% Leaf rating response rate' datatype='real' default-format='p0.0%' name='[% Self service CSAT response rate (copy)_145241107889082377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_last_leaf_rating_available]) / SUM([num_sessions_leaf_reached])' />
            </column>
            <column caption='participation_filter' datatype='boolean' name='[Calculation_0562974373892096]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3] = &apos;All assigned users&apos;&#13;&#10;&#13;&#10;OR [Parameters].[Parameter 3] = &apos;Participants only&apos; AND [is_participant]&#13;&#10;&#13;&#10;OR [Parameters].[Parameter 3] = &apos;Non-participants only&apos; AND NOT [is_participant]' />
            </column>
            <column caption='Management Entity' datatype='string' name='[Calculation_0562974461218823]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[management_entity_group]' />
            </column>
            <column caption='% Active sessions' datatype='real' default-format='p0.0%' name='[Calculation_145241107885080576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_sessions_active]) / SUM([num_sessions])' />
            </column>
            <column caption='% Self service CSAT' datatype='real' default-format='p0.0%' name='[Calculation_145241107885936641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_self_service_csat_4_5]) / SUM([num_self_service_csat_responses])' />
            </column>
            <column caption='contact_rate_2_std' datatype='real' name='[Calculation_145241107892752401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='2 * SQRT(SUM([num_sessions]) * [% Leaf rating (copy)_145241107890761742] * (1-[% Leaf rating (copy)_145241107890761742])) / SUM([num_sessions])' />
            </column>
            <column caption='contact_rate_lower' datatype='real' default-format='p0.0%' name='[Calculation_145241107893309458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([% Leaf rating (copy)_145241107890761742] - [Calculation_145241107892752401], 0)' />
            </column>
            <column caption='dimension' datatype='string' name='[Calculation_145241107910094870]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;None&apos; THEN &apos;All&apos;&#13;&#10;    WHEN &apos;Device&apos; THEN [device_type]&#13;&#10;    WHEN &apos;Entity&apos; THEN [global_entity_id]&#13;&#10;    WHEN &apos;Order status&apos; THEN [first_order_status]&#13;&#10;    WHEN &apos;Time between order and session&apos; THEN [time_between_order_and_session_group]&#13;&#10;    WHEN &apos;# Leaves visited&apos; THEN [num_leaves_visited_group]&#13;&#10;END' />
            </column>
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Contact center' datatype='string' name='[contact_center]' role='dimension' type='nominal' />
            <column caption='contact_rate_upper' datatype='real' default-format='p0.0%' name='[contact_rate_lower (copy)_145241107893440531]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN([% Leaf rating (copy)_145241107890761742] + [Calculation_145241107892752401], 1)' />
            </column>
