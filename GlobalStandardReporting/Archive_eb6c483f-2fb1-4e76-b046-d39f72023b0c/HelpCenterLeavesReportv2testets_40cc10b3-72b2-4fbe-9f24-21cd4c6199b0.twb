      <column caption='% visits with automation displayed' datatype='real' name='[% visits with chat displayed (copy)_719309331527413762]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_visits_automation_displayed])/SUM([num_visits])' />
