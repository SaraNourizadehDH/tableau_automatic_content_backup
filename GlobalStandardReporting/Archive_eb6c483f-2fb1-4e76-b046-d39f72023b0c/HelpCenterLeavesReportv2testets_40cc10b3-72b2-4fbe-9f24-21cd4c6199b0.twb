      <table>
        <view>
          <datasources>
            <datasource caption='helpcenter_leaves_report_v2 (rl_gcc_service)' name='federated.1qbnboa1z108qt1fet1g516ouskb' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='# Metric' datatype='string' name='[% Metrics (copy)_540643090412601348]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Leaf Visits&quot;'>
              <calculation class='tableau' formula='&quot;# Leaf Visits&quot;' />
            </column>
            <column caption='Dimension 2' datatype='string' name='[Dimension (copy)_91901608488980481]' param-domain-type='list' role='measure' type='nominal' value='&quot;Management Entity&quot;'>
              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
            </column>
            <column caption='Dimension' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Page ID L1&quot;'>
              <calculation class='tableau' formula='&quot;Page ID L1&quot;' />
            </column>
            <column caption='Segments' datatype='integer' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='6'>
              <calculation class='tableau' formula='6' />
              <range max='25' min='1' />
            </column>
            <column caption='% Metric' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Leaf Chat Rate&quot;'>
              <calculation class='tableau' formula='&quot;Leaf Chat Rate&quot;' />
            </column>
            <column caption='Order by ' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Denominator descending&quot;'>
              <calculation class='tableau' formula='&quot;Denominator descending&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1qbnboa1z108qt1fet1g516ouskb'>
            <column caption='% Metrics denom' datatype='integer' name='[% Metrics (copy)_540643090406105089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;% Leaf Visits&apos;                            THEN [num_visits]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Leaf Chat Rate&apos;                       THEN [num_visits]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Leaf Deflection Rate&apos;                 THEN [num_visits]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Leaf Automation Rate&apos;                 THEN [num_visits]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Misclassified Chats&apos;                THEN [num_valid_chats_created]  &#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Visits with Chat Displayed&apos;         THEN [num_visits]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Visits with Case Displayed&apos;         THEN [num_visits]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Visits with Automation Displayed&apos;  THEN [num_visits]   &#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Visits with Chat Created&apos;           THEN [num_visits_chat_displayed]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Visits with Case Created&apos;           THEN [num_visits_case_displayed]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Automation Request&apos;                 THEN [num_visits_automation_displayed]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Automation Success&apos;                 THEN [num_automation_requests]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Fallback Chats from Automation&apos;     THEN [num_visits_automation_displayed]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Fallback Contacts from Automation&apos;  THEN [num_visits_automation_displayed]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Visits with Leaf Rating&apos;            THEN [num_visits]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Positive Leaf Rating&apos;               THEN [num_leaf_ratings]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Negative Leaf Rating&apos;               THEN [num_leaf_ratings]&#10;END' />
            </column>
            <column caption=' # Metrics' datatype='real' name='[% Metrics (copy)_540643090414092293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[% Metrics (copy)_540643090412601348] = &apos;# Leaf Visits&apos;                            THEN SUM([num_visits])&#10;ELSEIF [Parameters].[% Metrics (copy)_540643090412601348] = &apos;Avg Navigation Length&apos;                THEN [Calculation_719309331528949769]&#10;ELSEIF [Parameters].[% Metrics (copy)_540643090412601348] = &apos;# Deflected Visits&apos;                   THEN SUM([num_deflected_visits])&#10;ELSEIF [Parameters].[% Metrics (copy)_540643090412601348] = &apos;# Chats Created&apos;                      THEN SUM([num_chats_created])&#10;ELSEIF [Parameters].[% Metrics (copy)_540643090412601348] = &apos;# Misclassified Chats&apos;                THEN SUM([num_misclassified_chats])  &#10;ELSEIF [Parameters].[% Metrics (copy)_540643090412601348] = &apos;# Valid Chats Created&apos;                THEN SUM([num_valid_chats_created])&#10;ELSEIF [Parameters].[% Metrics (copy)_540643090412601348] = &apos;# Automation Requests&apos;                THEN SUM([num_automation_requests])&#10;ELSEIF [Parameters].[% Metrics (copy)_540643090412601348] = &apos;# Successful Automations&apos;             THEN SUM([num_successful_automations])  &#10;ELSEIF [Parameters].[% Metrics (copy)_540643090412601348] = &apos;# Case Created&apos;                       THEN SUM([num_cases_created])&#10;ELSEIF [Parameters].[% Metrics (copy)_540643090412601348] = &apos;# Visits with Chat Displayed&apos;         THEN SUM([num_visits_chat_displayed])&#10;ELSEIF [Parameters].[% Metrics (copy)_540643090412601348] = &apos;# Visits with Case Displayed&apos;         THEN SUM([num_visits_case_displayed])&#10;ELSEIF [Parameters].[% Metrics (copy)_540643090412601348] = &apos;# Visits with Automation Displayed&apos;   THEN SUM([num_visits_automation_displayed])&#10;ELSEIF [Parameters].[% Metrics (copy)_540643090412601348] = &apos;# Positive Ratings&apos;                   THEN SUM([num_positive_leaf_ratings])&#10;ELSEIF [Parameters].[% Metrics (copy)_540643090412601348] = &apos;# Ratings&apos;                            THEN SUM([num_leaf_ratings])&#10;ELSEIF [Parameters].[% Metrics (copy)_540643090412601348] = &apos;# Contacts Created&apos;                   THEN SUM([num_contacts_created])&#10;END' />
            </column>
            <column caption='% Metrics enum' datatype='integer' name='[% Metrics denom (copy)_540643090406850562]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;% Leaf Visits&apos;                            THEN [num_visits]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Leaf Chat Rate&apos;                       THEN [num_chats_created]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Leaf Deflection Rate&apos;                 THEN [num_deflected_visits]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Leaf Automation Rate&apos;                 THEN [num_successful_automations]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Misclassified Chats&apos;                THEN [num_misclassified_chats]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Visits with Chat Displayed&apos;         THEN [num_visits_chat_displayed]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Visits with Case Displayed&apos;         THEN [num_visits_case_displayed]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Visits with Automation Displayed&apos;  THEN [num_visits_automation_displayed]  &#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Visits with Chat Created&apos;           THEN [num_chats_created]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Visits with Case Created&apos;           THEN [num_cases_created]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Automation Request&apos;                 THEN [num_automation_requests]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Automation Success&apos;                 THEN [num_successful_automations]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Fallback Chats from Automation&apos;     THEN [num_fallback_chats_from_automation]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Fallback Contacts from Automation&apos;  THEN [num_fallback_contacts_from_automation]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Visits with Leaf Rating&apos;            THEN [num_leaf_ratings]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Positive Leaf Rating&apos;               THEN [num_positive_leaf_ratings]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Negative Leaf Rating&apos;               THEN ([num_leaf_ratings] - [num_positive_leaf_ratings])&#10;END' />
            </column>
            <column caption='% Negative Leaf Rating' datatype='real' name='[% Positive Leaf Rating (copy)_633389102715629571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_leaf_ratings] - [num_positive_leaf_ratings])/SUM([num_leaf_ratings])' />
            </column>
            <column caption='% fallback chats from automations' datatype='real' name='[% automation request (copy)_719309331528491014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_fallback_chats_from_automation])/SUM([num_visits_automation_displayed])' />
            </column>
            <column caption='% fallback contacts from automations' datatype='real' name='[% fallback chats from automations (copy)_719309331528564743]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_fallback_contacts_from_automation])/SUM([num_visits_automation_displayed])' />
            </column>
            <column caption='% automation request' datatype='real' name='[% visits with automation displayed (copy)_719309331527741444]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_automation_requests])/SUM([num_visits_automation_displayed])' />
            </column>
            <column caption='% automation success' datatype='real' name='[% visits with automation request (copy)_719309331527892997]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_successful_automations])/SUM([num_automation_requests])' />
            </column>
            <column caption='% visits with case created' datatype='real' name='[% visits with chat created (copy)_719309331527651331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_cases_created_from_displayed])/SUM([num_visits_case_displayed])' />
            </column>
            <column caption='% visits with chat displayed' datatype='real' name='[% visits with chat created (copy)_719309331532234769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_visits_chat_displayed])/SUM([num_visits])' />
            </column>
            <column caption='% visits with case displayed' datatype='real' name='[% visits with chat displayed (copy)_719309331527348225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_visits_case_displayed])/SUM([num_visits])' />
            </column>
            <column caption='% visits with automation displayed' datatype='real' name='[% visits with chat displayed (copy)_719309331527413762]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_visits_automation_displayed])/SUM([num_visits])' />
            </column>
            <column caption='Segment' datatype='string' name='[Calculation_195906614595137540]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Top N Segment] THEN [Calculation_523332376516284417] ELSE &apos;Other&apos; END' />
            </column>
            <column caption='Dimension' datatype='string' name='[Calculation_523332376516284417]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF     [Parameters].[Parameter 1] = &apos;All&apos;                         THEN  &apos;All&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Management Entity&apos;           THEN [management_entity]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Country&apos;                     THEN [country]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Order Status&apos;                THEN [order_status]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Delivery Type&apos;               THEN [delivery_type]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Vertical&apos;                    THEN [vertical_type]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Page ID&apos;                     THEN [page_id]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Brand&apos;                       THEN [brand]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Page ID L1&apos;                  THEN SPLIT([page_id], &apos;.&apos;, 1)&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Helpcenter&apos;                  THEN [helpcenter]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Flow Version&apos;                THEN [flow_version]&#10;END' />
            </column>
            <column caption='Page ID L1' datatype='string' name='[Calculation_523332376562647043]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL(&#10;SPLIT([page_id], &apos;.&apos;, 1),[page_id])' />
            </column>
            <column caption='Order by ' datatype='real' name='[Calculation_540643090407792643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 5] = &apos;Num Visits descending &apos; then SUM([num_visits])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Denominator descending&apos; then SUM([% Metrics (copy)_540643090406105089])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;Numerator descending&apos; then SUM([% Metrics denom (copy)_540643090406850562])&#10;ELSEIF [Parameters].[Parameter 5] = &apos;# Metric descending&apos; then [% Metrics (copy)_540643090414092293]&#10;ELSEIF [Parameters].[Parameter 5] = &apos;% Metric descending&apos; then IFNULL(SUM([% Metrics denom (copy)_540643090406850562]) / SUM([% Metrics (copy)_540643090406105089]),0)&#10;end' />
            </column>
            <column caption='% visits with chat created' datatype='real' name='[Calculation_719309331527196672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_chats_created_from_displayed])/SUM([num_visits_chat_displayed])' />
            </column>
            <column caption='Leaf Deflection rate' datatype='real' name='[Calculation_719309331528794120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_deflected_visits])/SUM([num_visits])' />
            </column>
            <column caption='Avg Navigation Length' datatype='real' name='[Calculation_719309331528949769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_length_nav])/SUM([num_visits])' />
            </column>
            <column caption='% misclassified chats' datatype='real' name='[Calculation_719309331529068554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_misclassified_chats])/SUM([num_valid_chats_created])' />
            </column>
            <column caption='% Positive Leaf Rating' datatype='real' name='[Calculation_719309331529166859]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_positive_leaf_ratings])/SUM([num_leaf_ratings])' />
            </column>
            <column caption='% Leaf Ratings' datatype='real' name='[Calculation_719309331529306124]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_leaf_ratings])/SUM([num_visits])' />
            </column>
            <column caption='Leaf Chat Rate' datatype='real' name='[Calculation_719309331529408525]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_chats_created])/SUM([num_visits])' />
            </column>
            <column caption='% Leaf Visits' datatype='real' name='[Calculation_719309331531444240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_visits])/TOTAL(SUM([num_visits]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='% Metrics' datatype='real' name='[Calculation_91901608471764992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;% Leaf Visits&apos;                            THEN [Calculation_719309331531444240]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Leaf Chat Rate&apos;                       THEN [Calculation_719309331529408525]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Leaf Deflection Rate&apos;                 THEN [Calculation_719309331528794120]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Leaf Automation Rate&apos;                 THEN [Leaf Chat Rate (copy)_719309331529531406]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Misclassified Chats&apos;                THEN [Calculation_719309331529068554]   &#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Visits with Chat Displayed&apos;         THEN [% visits with chat created (copy)_719309331532234769]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Visits with Case Displayed&apos;         THEN [% visits with chat displayed (copy)_719309331527348225]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Visits with Automation Displayed&apos;  THEN [% visits with chat displayed (copy)_719309331527413762]    &#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Visits with Chat Created&apos;           THEN [Calculation_719309331527196672]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Visits with Case Created&apos;           THEN [% visits with chat created (copy)_719309331527651331]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Automation Request&apos;                 THEN [% visits with automation displayed (copy)_719309331527741444]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Automation Success&apos;                 THEN [% visits with automation request (copy)_719309331527892997]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Fallback Chats from Automation&apos;     THEN [% automation request (copy)_719309331528491014]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Fallback Contacts from Automation&apos;  THEN [% fallback chats from automations (copy)_719309331528564743]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Visits with Leaf Rating&apos;            THEN [Calculation_719309331529306124]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Positive Leaf Rating&apos;               THEN [Calculation_719309331529166859]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;% Negative Leaf Rating&apos;               THEN [% Positive Leaf Rating (copy)_633389102715629571]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
