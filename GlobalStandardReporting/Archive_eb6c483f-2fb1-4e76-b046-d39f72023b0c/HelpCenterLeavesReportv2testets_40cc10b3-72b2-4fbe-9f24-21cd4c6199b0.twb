              <calculation class='tableau' formula='IF     [Parameters].[Dimension (copy)_91901608488980481] = &apos;All&apos;                         THEN  &apos;All&apos;&#10;ELSEIF [Parameters].[Dimension (copy)_91901608488980481] = &apos;Management Entity&apos;           THEN [management_entity]&#10;ELSEIF [Parameters].[Dimension (copy)_91901608488980481] = &apos;Country&apos;                     THEN [country]&#10;ELSEIF [Parameters].[Dimension (copy)_91901608488980481] = &apos;Order Status&apos;                THEN [order_status]&#10;ELSEIF [Parameters].[Dimension (copy)_91901608488980481] = &apos;Delivery Type&apos;               THEN [delivery_type]&#10;ELSEIF [Parameters].[Dimension (copy)_91901608488980481] = &apos;Vertical&apos;                    THEN [vertical_type]&#10;ELSEIF [Parameters].[Dimension (copy)_91901608488980481] = &apos;Page ID&apos;                     THEN [page_id]&#10;ELSEIF [Parameters].[Dimension (copy)_91901608488980481] = &apos;Brand&apos;                       THEN [brand]&#10;ELSEIF [Parameters].[Dimension (copy)_91901608488980481] = &apos;Page ID L1&apos;                  THEN SPLIT([page_id], &apos;.&apos;, 1)&#10;ELSEIF [Parameters].[Dimension (copy)_91901608488980481] = &apos;Helpcenter&apos;                  THEN [helpcenter]&#10;ELSEIF [Parameters].[Dimension (copy)_91901608488980481] = &apos;Flow Version&apos;                THEN [flow_version]&#10;ELSEIF [Parameters].[Dimension (copy)_91901608488980481] = &apos;Leaf Feedback&apos;               THEN [leaf_feedback]&#10;END' />
            </column>
            <column caption='Leaf Automation Rate' datatype='real' name='[Leaf Chat Rate (copy)_719309331529531406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_successful_automations])/SUM([num_visits])' />
