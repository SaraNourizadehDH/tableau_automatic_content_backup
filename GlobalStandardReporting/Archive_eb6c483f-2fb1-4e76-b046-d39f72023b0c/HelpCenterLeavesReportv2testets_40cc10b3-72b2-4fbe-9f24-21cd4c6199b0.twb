      </column>
      <column caption='first leaf' datatype='string' name='[Calculation_135882081328906250]' role='measure' type='nominal'>
        <calculation class='tableau' formula='WINDOW_MAX(MAX([Calculation_504684669271171074]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Flow Size Win Per Target' datatype='real' name='[Calculation_1393019708783566857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//Percentage per Target&#13;&#10;WINDOW_MAX([Calculation_1490329120836378])'>
          <table-calc ordering-field='[federated.1omtiyz0yo0k40148cwhg1lk2vd4].[Path (bin)]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Flow Size' datatype='real' name='[Calculation_1490329120836378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([num_sessions])/TOTAL(SUM([num_sessions]))'>
          <table-calc ordering-field='[federated.1omtiyz0yo0k40148cwhg1lk2vd4].[first_order_status]' ordering-type='Field' />
        </calculation>
      </column>
      <column aggregation='Sum' caption='Path' datatype='integer' hidden='true' name='[Calculation_2615535859664650240]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Table_Name]={MIN([Table_Name])} THEN 0&#13;&#10;ELSE 97&#13;&#10;END' />
      </column>
      <column caption='t' datatype='real' name='[Calculation_2615535859665072129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF INDEX()&lt;50 THEN (INDEX()-25)/4 &#10;ELSE (74-INDEX())/4&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_303641163177926659]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Source-Target' datatype='string' name='[Calculation_318066755906916354]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[first_order_status]+ &apos;-&apos; +[page_name] + &apos;-&apos; + [Calculation_504684669271171074] + &apos;-&apos; + [Calculation_504684669272629253] + &apos;-&apos; + [Second Leaf  (copy)_135882081359413259]' />
      </column>
      <column caption='max date' datatype='boolean' name='[Calculation_363736067865624576]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date] = { FIXED : MAX([date])}' />
      </column>
      <column caption='N1 Position' datatype='real' hidden='true' name='[Calculation_4020329132355237]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX() /(SIZE()+1)'>
          <table-calc ordering-type='Field'>
            <order field='[federated.1omtiyz0yo0k40148cwhg1lk2vd4].[page_name]' />
            <order field='[federated.1omtiyz0yo0k40148cwhg1lk2vd4].[first_order_status]' />
          </table-calc>
        </calculation>
      </column>
      <column caption='Color Select' datatype='string' name='[Calculation_4385098675941498881]' role='measure' type='nominal'>
        <calculation class='tableau' formula='WINDOW_MAX(MAX(&#13;&#10;IIF([Parameters].[Parameter 3 1]=&apos;Source&apos;,[Calculation_504684669271171074],[Calculation_504684669272629253])&#13;&#10;))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='First Leaf' datatype='string' name='[Calculation_504684669271171074]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISNULL([page_2]) then &apos;Session ended&apos;&#10;ELSEIF [Parameters].[Parameter 6] = &apos;Page ID L1&apos; then [Calculation_90705340811563010]&#10;ELSE [page_2] end' />
      </column>
      <column caption='Second Leaf ' datatype='string' name='[Calculation_504684669272629253]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_504684669271171074] &lt;&gt; &apos;Session ended&apos; and &#10;ISNULL([page_3]) then &apos;Session ended&apos;&#10;ELSEIF [Parameters].[Parameter 6] = &apos;Page ID L1&apos; then [Page ID L1 2 (copy)_90705340811669507]&#10;else [page_3] end' />
