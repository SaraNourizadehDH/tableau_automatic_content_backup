            <column caption='Automatable Session Rate enum' datatype='integer' name='[Automation Rate enum (copy)_2391763313374937123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [automation_type] != &apos;NULL&apos; THEN [sessions] ELSE 0 END' />
            </column>
            <column caption='Automation Reach Rate enum' datatype='integer' name='[Automation Rate enum (copy)_2391763313380876337]' role='measure' type='quantitative'>
