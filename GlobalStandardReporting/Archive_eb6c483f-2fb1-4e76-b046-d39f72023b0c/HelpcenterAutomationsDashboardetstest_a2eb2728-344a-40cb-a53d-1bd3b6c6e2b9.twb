            <column caption='Date KPI' datatype='string' name='[Calculation_153052040905207809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &quot;Day&quot; THEN str([date])&#10;WHEN &quot;Week&quot; THEN [week]&#10;END' />
            </column>
            <column caption='is_max_date' datatype='boolean' name='[Calculation_2391763313319788544]' role='dimension' type='nominal'>
