          <datasource-dependencies datasource='federated.0plwugn101j4ax1c5d2w517589dz'>
            <column caption='% Automation Reach Rate ' datatype='real' default-format='p0.0%' name='[% Automation Rate (copy)_2391763313380876339]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Automation Rate enum (copy)_2391763313380876337])/SUM([Automation Rate den (copy)_2391763313380876338])' />
            </column>
            <column aggregation='Attribute' caption='% Change Automation Reach Rate' datatype='real' default-format='p0.0%' name='[% Change Automation Rate (copy)_2391763313380876341]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Automation Rate Current (copy)_2391763313380876340]-[Automation Rate Prevous (copy)_2391763313380876335])/[Automation Rate Prevous (copy)_2391763313380876335]' />
            </column>
            <column aggregation='Attribute' caption='Automation Reach Rate Current' datatype='real' name='[Automation Rate Current (copy)_2391763313380876340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &apos;Day&apos;&#10;THEN&#10;{EXCLUDE [Calculation_153052040905207809]: &#10;    SUM(&#10;    IF [Calculation_2391763313319788544]&#10;    THEN [Automation Rate enum (copy)_2391763313380876337]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [Calculation_2391763313319788544]&#10;    THEN [Automation Rate den (copy)_2391763313380876338]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;WHEN &apos;Week&apos;&#10;THEN&#10;{EXCLUDE [Calculation_153052040905207809]: &#10;    SUM(&#10;    IF [is_max_date (copy)_153052040911065090]&#10;    THEN [Automation Rate enum (copy)_2391763313380876337]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_date (copy)_153052040911065090]&#10;    THEN [Automation Rate den (copy)_2391763313380876338]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;END' />
