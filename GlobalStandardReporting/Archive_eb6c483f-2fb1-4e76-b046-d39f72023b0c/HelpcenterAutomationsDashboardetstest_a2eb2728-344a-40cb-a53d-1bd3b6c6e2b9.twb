            <column aggregation='Attribute' caption='Automation Reach Rate Negative Change' datatype='string' name='[Automation Rate Negative Change (copy)_2391763313380876342]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [% Change Automation Rate (copy)_2391763313380876341] &lt; 0&#10;THEN &quot;▼&quot;&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column aggregation='Attribute' caption='Automation Reach Rate Positive Change' datatype='string' name='[Automation Rate Positive tive Change  (copy)_2391763313380876336]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [% Change Automation Rate (copy)_2391763313380876341] &gt; 0&#10;THEN &quot;▲&quot;&#10;ELSE &quot;&quot;&#10;END' />
            </column>
            <column aggregation='Attribute' caption='Automation Reach Rate Prevous' datatype='real' name='[Automation Rate Prevous (copy)_2391763313380876335]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &apos;Day&apos;&#10;THEN&#10;{EXCLUDE [Calculation_153052040905207809]: &#10;    SUM(&#10;    IF [is_max_date (copy)_2391763313370615836]&#10;    THEN [Automation Rate enum (copy)_2391763313380876337]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_date (copy)_2391763313370615836]&#10;    THEN [Automation Rate den (copy)_2391763313380876338]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;WHEN &apos;Week&apos;&#10;THEN&#10;{EXCLUDE [Calculation_153052040905207809]: &#10;    SUM(&#10;    IF [is_max_date_minus_one (copy)_153052040911478788]&#10;    THEN [Automation Rate enum (copy)_2391763313380876337]&#10;    ELSE 0 END&#10;    )&#10;    /&#10;     SUM(&#10;    IF [is_max_date_minus_one (copy)_153052040911478788]&#10;    THEN [Automation Rate den (copy)_2391763313380876338]&#10;    ELSE 0 END&#10;    )&#10;    }&#10;END' />
