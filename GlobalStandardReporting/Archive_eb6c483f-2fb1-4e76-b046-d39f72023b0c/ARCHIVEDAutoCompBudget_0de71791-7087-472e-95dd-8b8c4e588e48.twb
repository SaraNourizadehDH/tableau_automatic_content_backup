              <calculation class='tableau' formula='IF      [Parameters].[Parameter 7] = &apos;Space Spent (local)&apos;              THEN SUM([Space Budget (local)  (copy)_449867392967315476])&#10;ELSEIF  [Parameters].[Parameter 7] = &apos;Space Remaining (local)&apos;                THEN [Entity Remaining (Local)  (copy)_449867392967790613]&#10;ELSEIF  [Parameters].[Parameter 7] = &apos;Space Spent (%)&apos;                        THEN [Entity Spent (%) (copy)_449867392968097815]*100&#10;ELSEIF  [Parameters].[Parameter 7] = &apos;Space Remaining (%)&apos;                    THEN [Space Remaining (%) (copy 2)_1529464674173517825]*100&#10;ELSEIF  [Parameters].[Parameter 7] = &apos;Experiment Spent (local)&apos;               THEN SUM([Space Spent (local) (copy)_449867393008406558])&#10;ELSEIF  [Parameters].[Parameter 7] = &apos;Experiment % of Space Budget Spent&apos;     THEN [Space Spent (%) (copy)_449867393010802720]*100&#10;ELSEIF  [Parameters].[Parameter 7] = &apos;Experiment % of Entity Budget Spent&apos;    THEN [Experiment Percent of Space Budget (%) (copy)_4290734191507070996]*100&#10;ELSEIF  [Parameters].[Parameter 7] = &apos;Space Budget (local)&apos;                   THEN [Entity Budget (local) (copy)_449867392964550672]&#10;//ELSEIF  [Parameters].[KPI] = &apos;Entity Budget (local)&apos;                THEN MAX([Entity Budget (local)])&#10;//ELSEIF  [Parameters].[KPI] = &apos;Space 7 day Avg. Spend (%)&apos;           THEN [Space 7 day Avg. Spend (%)]*100 &#10;END' />
