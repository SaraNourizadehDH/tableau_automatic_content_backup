              <calculation class='tableau' formula='STR(YEAR([event_date (_autocomp_budget_dashboard_entity)])) + &apos;-&apos; + STR(MONTH([event_date (_autocomp_budget_dashboard_entity)]))' />
            </column>
            <column caption='Entity Budget (local) (copy)' datatype='real' name='[Entity Budget (local) (copy)_4290734191497293837]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id] :&#10;        MAX (IF [event_date (_autocomp_budget_dashboard_entity)] = {FIXED [global_entity_id] : MAX ([event_date (_autocomp_budget_dashboard_entity)]) } THEN [budget_local (_autocomp_budget_dashboard_entity)] END)&#10;}' />
            </column>
            <column caption='Space Budget (local)' datatype='real' name='[Entity Budget (local) (copy)_449867392964550672]' role='measure' type='quantitative'>
