      <table>
        <view>
          <datasources>
            <datasource caption='Autocomp Budget Metrics' name='federated.1gfpefz0uf2a1018bbwbf1iodw8p' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1gfpefz0uf2a1018bbwbf1iodw8p'>
            <column caption='Entity Spent (local)' datatype='real' name='[Budget (EUR) (copy)_4014818340685115394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [event_date (_autocomp_budget_dashboard_entity)] : MAX([monthly_spend_in_entity_local]) }' />
            </column>
            <column caption='Entity Budget (EUR)' datatype='real' name='[Budget (local) (copy)_4014818340684931073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [event_date (_autocomp_budget_dashboard_entity)] : MAX([budget_eur (_autocomp_budget_dashboard_entity)]) }' />
            </column>
            <column caption='Entity Budget (local)' datatype='real' name='[Calculation_4014818340683816960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [event_date (_autocomp_budget_dashboard_entity)] : MAX([budget_local (_autocomp_budget_dashboard_entity)]) }' />
            </column>
            <column caption='Date Range ' datatype='date' name='[Date  (copy)_449867392899121152]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[event_date (_autocomp_budget_dashboard_entity)]' />
            </column>
            <column caption='Month' datatype='string' name='[Date  (copy)_449867392941813767]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([event_date (_autocomp_budget_dashboard_entity)])) + &apos;-&apos; + STR(MONTH([event_date (_autocomp_budget_dashboard_entity)]))' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Granularity Level (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF      [Parameters].[Parameter 5]=&apos;Daily&apos;   then STR([event_date (_autocomp_budget_dashboard_entity)])&#10;ELSEIF  [Parameters].[Parameter 5]=&apos;Weekly&apos;  then [Month (copy)_449867392943083528]&#10;ELSEIF  [Parameters].[Parameter 5]=&apos;Monthly&apos; then [Date  (copy)_449867392941813767]&#10;&#10;//ELSEIF  [Parameters].[Date Granularity]=&apos;Weekly&apos; then  STR(WEEK([Date ]))&#10;//ELSEIF  [Parameters].[Date Granularity]=&apos;Monthly&apos; then STR(MONTH([Date ]))&#10;&#13;&#10;END' />
            </column>
            <column caption='Week' datatype='string' name='[Month (copy)_449867392943083528]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([event_date (_autocomp_budget_dashboard_entity)])) + &apos;-&apos; + STR(WEEK([event_date (_autocomp_budget_dashboard_entity)]))' />
            </column>
            <column caption='Day Spend in Experiment (local)' datatype='real' default-format='n#,##0;-#,##0' name='[Monthly Spend in Space (local) (copy)_449867392936960006]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [event_date (_autocomp_budget_dashboard_entity)], [space_id], [experiment_id] : MAX([day_spend_local (_autocomp_budget_dashboard_experiments)]) }' />
            </column>
            <column caption='Entity 7 day Avg. Spend (%)' datatype='real' default-format='p0.00%' name='[Remaining (%) (copy)_4014818340687929350]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ FIXED [global_entity_id], [event_date (_autocomp_budget_dashboard_entity)] : MAX([moving_avg_spend_percent (_autocomp_budget_dashboard_entity)]) })' />
            </column>
            <column caption='Entity Remaining (local)' datatype='real' name='[Spent (Local) (copy)_4014818340686004227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [event_date (_autocomp_budget_dashboard_entity)] : MAX([remaining_local]) }' />
            </column>
            <column caption='Entity Remaining (%)' datatype='real' default-format='p0.00%' name='[Spent (Local) (copy)_4014818340687626245]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [global_entity_id], [event_date (_autocomp_budget_dashboard_entity)] : MAX([Spent (Local) (copy)_4014818340686004227]) })&#10;/&#10;SUM({ FIXED [global_entity_id], [event_date (_autocomp_budget_dashboard_entity)] : MAX([Calculation_4014818340683816960]) })' />
            </column>
