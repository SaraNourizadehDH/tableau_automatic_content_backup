      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Calculation_5042342791967703042]) - LOOKUP(ZN([Calculation_5042342791967703042]), FIRST())) / ABS(LOOKUP(ZN([Calculation_5042342791967703042]), FIRST()))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='Cumulative Orders per Customer' datatype='real' name='[Calculation_1039205643780755456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_observation_period_cumulative_orders])/[Calculation_979814423483441152]' />
      </column>
