      <column caption='Significance checks (copy 2)' datatype='string' name='[Significance checks (copy 2)_622904146460733440]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [variant_id] = &apos;B&apos; AND [p_value_vs_c] &lt;= 0.05 THEN &apos;B vs. C, p-value = &apos; + STR(ROUND([p_value_vs_c],2)) + &quot;&#10;&quot; ELSE &apos;&apos; END' />
