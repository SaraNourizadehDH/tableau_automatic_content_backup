      </column>
      <column caption='Significance checks' datatype='string' name='[Calculation_1856538578383765505]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF&#10;LEN(IF [variant_id] = &apos;A&apos; AND [p_value_vs_b] &lt;= 0.05 THEN &apos;A vs. B, p-value = &apos;  + STR(ROUND([p_value_vs_b],2)) ELSE &apos;&apos; END + &quot;&#10;&quot; +&#10;IF [variant_id] = &apos;A&apos; AND [p_value_vs_c] &lt;= 0.05 THEN &apos;A vs. C, p-value = &apos;  + STR(ROUND([p_value_vs_c],2)) ELSE &apos;&apos; END + &quot;&#10;&quot; +&#10;IF [variant_id] = &apos;A&apos; AND [p_value_vs_d] &lt;= 0.05 THEN &apos;A vs. D, p-value = &apos;  + STR(ROUND([p_value_vs_d],2)) ELSE &apos;&apos; END + &quot;&#10;&quot; +&#10;IF [variant_id] = &apos;B&apos; AND [p_value_vs_c] &lt;= 0.05 THEN &apos;B vs. C, p-value = &apos;  + STR(ROUND([p_value_vs_c],2)) ELSE &apos;&apos; END + &quot;&#10;&quot; +&#10;IF [variant_id] = &apos;B&apos; AND [p_value_vs_d] &lt;= 0.05 THEN &apos;B vs. D, p-value = &apos;  + STR(ROUND([p_value_vs_d],2)) ELSE &apos;&apos; END + &quot;&#10;&quot; +&#10;IF [variant_id] = &apos;C&apos; AND [p_value_vs_d] &lt;= 0.05 THEN &apos;C vs. D, p-value = &apos;  + STR(ROUND([p_value_vs_d],2)) ELSE &apos;&apos; END)&#10;&lt; 5&#10;THEN &apos;no significant results&apos;&#10;ELSE&#10;IF [variant_id] = &apos;A&apos; AND [p_value_vs_b] &lt;= 0.05 THEN &apos;A vs. B, p-value = &apos; + STR(ROUND([p_value_vs_b],2)) + &quot;&#10;&quot;  ELSE &apos;&apos; END + &#10;IF [variant_id] = &apos;A&apos; AND [p_value_vs_c] &lt;= 0.05 THEN &apos;A vs. C, p-value = &apos; + STR(ROUND([p_value_vs_c],2)) + &quot;&#10;&quot;  ELSE &apos;&apos; END + &#10;IF [variant_id] = &apos;A&apos; AND [p_value_vs_d] &lt;= 0.05 THEN &apos;A vs. D, p-value = &apos; + STR(ROUND([p_value_vs_d],2)) + &quot;&#10;&quot; ELSE &apos;&apos; END +&#10;IF [variant_id] = &apos;B&apos; AND [p_value_vs_c] &lt;= 0.05 THEN &apos;B vs. C, p-value = &apos; + STR(ROUND([p_value_vs_c],2)) + &quot;&#10;&quot; ELSE &apos;&apos; END +&#10;IF [variant_id] = &apos;B&apos; AND [p_value_vs_d] &lt;= 0.05 THEN &apos;B vs. D, p-value = &apos; + STR(ROUND([p_value_vs_d],2)) + &quot;&#10;&quot; ELSE &apos;&apos; END +&#10;IF [variant_id] = &apos;C&apos; AND [p_value_vs_d] &lt;= 0.05 THEN &apos;C vs. D, p-value = &apos;  + STR(ROUND([p_value_vs_d],2)) ELSE &apos;&apos; END&#10;END' />
      </column>
      <column caption='Lower Bound' datatype='real' name='[Calculation_1856538578663661571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [variant_id] = &apos;A&apos; THEN [lower_bound_a]&#10;ELSEIF [variant_id] = &apos;B&apos; THEN [lower_bound_b]&#10;ELSEIF [variant_id] = &apos;C&apos; THEN [lower_bound_c]&#10;END' />
      </column>
      <column caption='Alpha Tooltip' datatype='string' name='[Calculation_265712398065946625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Alpha is the upper threshold of P-Value, above which the result is considered insignificant&quot;' />
      </column>
      <column caption='Definitions' datatype='string' name='[Calculation_2956120639389638656]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4] WHEN &apos;# Cumulative Orders per Customer&apos; THEN &apos;Orders that customers placed after receiving compensation, within observation period&apos;&#10;WHEN &apos;Avg. Customer Order Value&apos; THEN &quot;Avg. of each customer&apos;s GMV over number of orders placed after receiving compensation, within observation period&quot;&#10;WHEN &apos;Avg. Compensation Value&apos; THEN &apos;Sum of compensation value divided by all orders (including first compensated order), within observation period&apos;&#10;WHEN &apos;Avg. Redeemed Value&apos; THEN &apos;Sum of redeemed compensation value divided by all orders (including first compensated order), within observation period&apos;&#10;WHEN &apos;# Compensated Orders per Customer&apos; THEN &apos;Count of compensated orders (including first compensated order) divided by count of customers, within observation period&apos;&#10;WHEN &apos;Redemption Rate&apos; THEN &apos;Count of redeemed compensations divided by all orders (including first compensated order), within observation period&apos;&#10;WHEN &apos;# Compensated Orders per Customer&apos; THEN &apos;Count of compensated orders (including first compensated order) divided by count of customers, within observation period&apos;&#10;WHEN &apos;GMV per Customer&apos; THEN &apos;Extrapolated GMV divided by customer count&apos;&#10;WHEN &apos;Cost per Customer&apos; THEN &apos;Extrapolated cost divided by customer count&apos;&#10;WHEN &apos;Policy ROI&apos; THEN &apos;GMV per Customer / Cost per Customer&apos;&#10;END' />
      </column>
      <column caption='Avg Order Value' datatype='real' name='[Calculation_356628828440616960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([customer_avg_order_value])' />
      </column>
      <column caption='Cohort date' datatype='date' name='[Calculation_367043401533747200]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(STR(INT(LEFT([customer_cohort], 4))) + &apos;-01-01&apos;) + ((INT(RIGHT([customer_cohort], 2))&#13;&#10; - 1) * 7)' />
      </column>
      <column caption='GMV per customer' datatype='real' name='[Calculation_4893161054279983104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sum_gmv_eur_incl_voucher_observation_period]) / [Calculation_979814423483441152]' />
      </column>
      <column caption='Policy ROI' datatype='real' name='[Calculation_5042342791967703042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4893161054279983104] / [GMV per customer (copy)_4893161054288830465]' />
      </column>
      <column caption='Lighbulb' datatype='integer' name='[Calculation_5042342792298475529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='is_current_cohort_month' datatype='boolean' name='[Calculation_716916805630935040]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_367043401533747200] &gt;= DATE(DATETRUNC(&apos;month&apos;, TODAY()))' />
      </column>
      <column caption='Percent_or_count_sample metric' datatype='real' name='[Calculation_781937535711784961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&apos;1&apos; THEN [proportion_of_sample_cumulative]*100&#13;&#10;ELSE [count_customers_cumulative]&#13;&#10;END' />
      </column>
      <column caption='# Customers' datatype='integer' name='[Calculation_979814423483441152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_customers])' />
      </column>
      <column caption='% Customers' datatype='real' name='[Calculation_979814423483887617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_979814423483441152]/WINDOW_SUM([Calculation_979814423483441152])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cost per Customer' datatype='real' name='[GMV per customer (copy)_4893161054288830465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_redeemed_compensation_value_eur]) / [Calculation_979814423483441152]' />
      </column>
      <column caption='Upper Bound' datatype='real' name='[Lower Bound (copy)_1856538578663825412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [variant_id] = &apos;A&apos; THEN [upper_bound_a]&#10;ELSEIF [variant_id] = &apos;B&apos; THEN [upper_bound_b]&#10;ELSEIF [variant_id] = &apos;C&apos; THEN [upper_bound_c]&#10;END' />
