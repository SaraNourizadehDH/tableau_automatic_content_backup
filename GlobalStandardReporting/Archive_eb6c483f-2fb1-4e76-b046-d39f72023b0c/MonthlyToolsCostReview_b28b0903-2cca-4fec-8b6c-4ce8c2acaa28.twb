              <calculation class='tableau' formula='&quot;Tools&quot;' />
            </column>
            <column caption='Select Row 2' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
              <calculation class='tableau' formula='&quot;None&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c6vx5u1ny5s721631qpr1b9n2s1'>
            <column caption='Row 1' datatype='string' name='[Calculation_59813467665080320]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Management Entities&apos; THEN [Calculation_6077044780835811336]&#10;WHEN &apos;Tools&apos; THEN [Calculation_6077044780832759809]&#10;WHEN &apos;Countries&apos; THEN [Calculation_6077044780836864009]&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Row 2' datatype='string' name='[Calculation_59813467666022402]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Management Entities&apos; THEN [Calculation_6077044780835811336]&#10;WHEN &apos;Tools&apos; THEN [Calculation_6077044780832759809]&#10;WHEN &apos;Countries&apos; THEN [Calculation_6077044780836864009]&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Union_Tools' datatype='string' name='[Calculation_6077044780832759809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL(IFNULL([Tool],[tool]),[Tool (Budget 2021)])' />
            </column>
            <column caption='Union_Month' datatype='date' datatype-customized='true' name='[Calculation_6077044780833566724]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IIF([Calculation_6077044780861718542] in (&apos;2020&apos;),date(&apos;2020-&apos; + iif( IFNULL(IFNULL([month (ACCRUALS DATA SOURCE)],[month]),[Month])&lt; &apos;10&apos;, &apos;0&apos;,&apos;&apos;) + str(IFNULL(IFNULL([month (ACCRUALS DATA SOURCE)],[month]),[Month])) + &apos;-01&apos;),date(&apos;2021-&apos; + iif( IFNULL(IFNULL([month (ACCRUALS DATA SOURCE)],[month]),[Month])&lt; &apos;10&apos;, &apos;0&apos;,&apos;&apos;) + str(IFNULL(IFNULL([month (ACCRUALS DATA SOURCE)],[month]),[Month])) + &apos;-01&apos;))' />
            </column>
            <column caption='Union_TotalCosts' datatype='integer' datatype-customized='true' name='[Calculation_6077044780834623495]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(sum([Calculation_89790548794425355]),0) + IFNULL(sum([allocated_user_cost (ACCRUALS DATA SOURCE)]),0)' />
            </column>
            <column caption='Union_ManagementEntity' datatype='string' name='[Calculation_6077044780835811336]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ifnull(IFNULL([management_entity_group],[management entity]),[Management Entity])' />
            </column>
            <column caption='Union_Country' datatype='string' name='[Calculation_6077044780836864009]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL(IFNULL([country],[country (ACCRUALS DATA SOURCE)]),[Country])' />
            </column>
            <column caption='Union_Year' datatype='string' datatype-customized='true' name='[Calculation_6077044780861718542]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL(IFNULL([year (ACCRUALS DATA SOURCE)],[year]),[Year])' />
            </column>
            <column caption='salesforce_cost' datatype='integer' datatype-customized='true' name='[Calculation_6077044780873015311]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(IIF([tool]=&quot;Salesforce Restricted&quot;,[allocated_users]*20,0))' />
            </column>
            <column caption='TOTAL COSTS' datatype='integer' datatype-customized='true' name='[Calculation_89790548794425355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(IIF([currency]=&quot;USD&quot;,([allocated_user_cost]+[allocated_other_cost]+[Calculation_6077044780873015311])*0.83,[allocated_user_cost]+[allocated_other_cost]+[Calculation_6077044780873015311]))*1' />
            </column>
