        <view>
          <datasources>
            <datasource caption='Tootls ICI report' name='federated.1gwzmx61sdflpj18466z808f1s7o' />
          </datasources>
          <datasource-dependencies datasource='federated.1gwzmx61sdflpj18466z808f1s7o'>
