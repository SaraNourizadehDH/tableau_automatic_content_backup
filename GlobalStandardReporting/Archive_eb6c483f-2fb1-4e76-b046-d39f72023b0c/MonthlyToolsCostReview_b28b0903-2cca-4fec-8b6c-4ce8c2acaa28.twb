        <relation join='full' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[ACCRUALS DATA SOURCE].[Description of service]' />
              <expression op='[Budget 2021].[Type]' />
            </expression>
          </clause>
          <relation join='full' type='join'>
            <clause type='join'>
              <expression op='='>
                <expression op='[Custom SQL Query].[tool]' />
                <expression op='[ACCRUALS DATA SOURCE].[Tool]' />
              </expression>
            </clause>
            <relation connection='redshift.1mt9n2h0v6x71r10ro0j50chh0gb' name='Custom SQL Query' type='text'>SELECT * &#10;FROM (&#10;SELECT *,&#10;ROW_NUMBER() OVER(PARTITION BY global_entity_id, DATE_TRUNC(&apos;month&apos;,report_generated_at), tool ORDER BY report_generated_at ASC) as rk,&#10;CASE WHEN TO_CHAR(report_generated_at,&apos;MM&apos;) in (&apos;02&apos;,&apos;03&apos;,&apos;04&apos;,&apos;05&apos;,&apos;06&apos;,&apos;07&apos;,&apos;08&apos;,&apos;09&apos;,&apos;10&apos;,&apos;11&apos;,&apos;12&apos;) THEN TO_CHAR(report_generated_at,&apos;MM&apos;) -1 &#10;ELSE 12 END as month,&#10;CASE WHEN TO_CHAR(report_generated_at,&apos;MM&apos;) in (&apos;01&apos;) THEN TO_CHAR(report_generated_at,&apos;YYYY&apos;) -1&#10;ELSE TO_CHAR(report_generated_at,&apos;YYYY&apos;) -0 END as year&#10;FROM bl_global_ccn.tools_ici_report)&#10;WHERE rk = 1&#10;ORDER BY global_entity_id, report_generated_at</relation>
            <relation connection='google-sheets.0qnh8nu08yf55a141d1b50rq3stx' name='ACCRUALS DATA SOURCE' table='[&apos;ACCRUALS DATA SOURCE$&apos;]' type='table'>
