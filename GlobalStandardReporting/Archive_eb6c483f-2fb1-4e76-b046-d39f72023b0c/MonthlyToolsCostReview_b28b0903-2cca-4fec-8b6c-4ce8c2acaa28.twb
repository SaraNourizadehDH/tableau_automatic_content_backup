              <calculation class='tableau' formula='IFNULL(IFNULL([year (ACCRUALS DATA SOURCE)],[year]),[Year])' />
            </column>
            <column caption='salesforce_cost' datatype='integer' datatype-customized='true' name='[Calculation_6077044780873015311]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(IIF([tool]=&quot;Salesforce Restricted&quot;,[allocated_users]*20,0))' />
            </column>
            <column caption='TOTAL COSTS' datatype='integer' datatype-customized='true' name='[Calculation_89790548794425355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(IIF([currency]=&quot;USD&quot;,([allocated_user_cost]+[allocated_other_cost]+[Calculation_6077044780873015311])*0.83,[allocated_user_cost]+[allocated_other_cost]+[Calculation_6077044780873015311]))*1' />
