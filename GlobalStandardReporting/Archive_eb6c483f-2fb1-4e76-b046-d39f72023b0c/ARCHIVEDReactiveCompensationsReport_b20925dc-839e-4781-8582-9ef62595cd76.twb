      <aliases enabled='yes' />
      <column caption='% Comp Service (in decimals)' datatype='real' name='[% Comp Service (copy)_3218103453814288396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3218103453718548482]) / SUM([Count Events (copy)_3218103453727436806]) * 100' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Count Events (copy)_3218103453727436806]) / TOTAL(SUM([Count Events (copy)_3218103453727436806]))'>
          <table-calc ordering-type='ColumnInPane' />
        </calculation>
      </column>
      <column caption='Global' datatype='string' name='[Calculation_1335739553774792704]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Global&apos;' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_3218103453715247104]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Management Entity Group&apos; THEN [management_entity_group]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Global Entity Id&apos; THEN [global_entity_id]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Global&apos; THEN [Calculation_1335739553774792704]&#10;END' />
      </column>
      <column caption='Count Events Comp Service' datatype='integer' name='[Calculation_3218103453718548482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_issued_through_comp_service] = True THEN [Count Events (copy)_3218103453727436806] ELSE 0 END' />
      </column>
      <column caption='% Comp Service' datatype='real' name='[Calculation_3218103453718765571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_3218103453718548482]) / SUM([Count Events (copy)_3218103453727436806])' />
      </column>
      <column caption='Light Bulb' datatype='integer' name='[Calculation_3218103453750390791]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Choose metric' datatype='real' name='[Calculation_3218103453811195915]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;% events through Comp Service&apos; THEN [% Comp Service (copy)_3218103453814288396]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;# events through Comp Service&apos; THEN SUM([Calculation_3218103453718548482])&#10;ELSEIF [Parameters].[Parameter 2] = &apos;# all events&apos; THEN SUM([count_events])&#10;END' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_4061121013662527488]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Count Events (ifnull)' datatype='integer' name='[Count Events (copy)_3218103453727436806]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([count_events], 0)' />
      </column>
      <column caption='Origin ' datatype='string' name='[Origin (copy)_3218103453803577354]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[origin]' />
      </column>
