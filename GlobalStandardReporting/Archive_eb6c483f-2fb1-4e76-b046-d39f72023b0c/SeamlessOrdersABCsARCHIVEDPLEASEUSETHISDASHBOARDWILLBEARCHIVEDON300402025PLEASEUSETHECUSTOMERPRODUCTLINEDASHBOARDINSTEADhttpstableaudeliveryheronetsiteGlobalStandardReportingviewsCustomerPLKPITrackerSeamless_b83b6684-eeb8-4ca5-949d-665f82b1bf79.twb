      <column caption='Metric avg pane down' datatype='real' name='[Metric avg down (copy)_699183910165192719]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_535224713484959745])'>
          <table-calc ordering-type='Rows' />
