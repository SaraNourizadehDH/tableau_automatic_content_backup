            <column caption='datediff &gt;= 14 days' datatype='string' name='[datediff &gt;= 30 days (copy)_1281555602047197280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;,[created_date],today()) &gt; 28 THEN &apos;in&apos; // 28 days to allow each day of prior 14 days to complete cohort&#13;&#10;ELSE &apos;out&apos; &#13;&#10;END' />
