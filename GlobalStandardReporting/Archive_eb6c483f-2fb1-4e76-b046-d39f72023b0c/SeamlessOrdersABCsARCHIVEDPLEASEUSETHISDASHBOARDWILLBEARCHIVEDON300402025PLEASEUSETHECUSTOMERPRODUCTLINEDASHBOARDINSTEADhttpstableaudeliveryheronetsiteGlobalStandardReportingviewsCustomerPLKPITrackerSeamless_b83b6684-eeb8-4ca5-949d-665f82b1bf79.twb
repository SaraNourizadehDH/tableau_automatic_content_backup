      <aliases enabled='yes' />
      <column caption='% Order Not on Time' datatype='real' default-format='p0.0%' name='[% Order On Time (copy)_80220372158709760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose Chart Type (copy)]&#13;&#10;    WHEN &apos;All Orders&apos; THEN SUM(ZN([ranked_orders_not_on_time])) / SUM(ZN([orders_all]))&#13;&#10;    WHEN &apos;Related Orders&apos; THEN SUM(ZN([orders_not_on_time])) / SUM(ZN([orders_on_time_base]))&#13;&#10;END' />
      </column>
      <column caption='% Contacts' datatype='real' default-format='p0.00%' name='[% contacts (copy)_699183909442281479]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose Chart Type (copy)]&#13;&#10;    WHEN &apos;All Orders&apos; THEN SUM(ZN([ranked_orders_contacts])) / SUM(ZN([orders_all]))&#10;    WHEN &apos;Related Orders&apos; THEN SUM(ZN([orders_contacts])) / SUM(ZN([orders_service_base]))&#13;&#10;END' />
      </column>
      <column caption='% Fail Rate' datatype='real' name='[% failed (copy)_699183909438423043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([cancellations_logistics]))&#13;&#10;/&#13;&#10;(CASE [Parameters].[Choose Chart Type (copy)]&#13;&#10; WHEN &apos;All Orders&apos; THEN SUM(ZN([orders_all]))&#13;&#10; WHEN &apos;Related Orders&apos; THEN SUM(ZN([orders_cancellations_base]))&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='% Order On Time' datatype='real' default-format='p0.0%' name='[% on-time (copy)_699183909441871876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose Chart Type (copy)]&#13;&#10;    WHEN &apos;All Orders&apos; THEN SUM(ZN([ranked_orders_on_time])) / SUM(ZN([orders_all]))&#13;&#10;    WHEN &apos;Related Orders&apos; THEN SUM(ZN([orders_on_time])) / SUM(ZN([orders_on_time_base]))&#13;&#10;END' />
      </column>
      <column caption='% Service ABC' datatype='real' default-format='p0.00%' name='[% service ABC (copy)_699183909442412552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose Chart Type (copy)]&#13;&#10; WHEN &apos;All Orders&apos; THEN SUM(ZN([Sessions (MENA-adjusted) (copy)_1381760664253026304]) + ZN([ranked_orders_contacts]))/ SUM(ZN([orders_all]))&#13;&#10; WHEN &apos;Related Orders&apos; THEN (SUM(ZN([Calculation_6881289173896183808]) + ZN([orders_contacts]))) / SUM(ZN([orders_service_base]))&#13;&#10;END' />
      </column>
      <column caption='% Sessions' datatype='real' default-format='p0.00%' name='[% sessions (copy)_699183909442158598]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose Chart Type (copy)]&#13;&#10; WHEN &apos;All Orders&apos; THEN SUM(ZN([Sessions (MENA-adjusted) (copy)_1381760664253026304])) / sum(ZN([orders_all]))&#13;&#10; WHEN &apos;Related Orders&apos; THEN SUM(ZN([Calculation_6881289173896183808])) /sum(ZN([orders_service_base]))&#13;&#10;END' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1jbdp9i0boo3cg12fgxcb0trnkks].[usr:Calculation_535224713484959745:qk]:1&quot;' value='Global ' />
        </aliases>
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_1177550627071528960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='datediff &gt;= 30 days' datatype='string' name='[Calculation_1281555602017796142]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;,[created_date],today()) &gt; 60 THEN &apos;in&apos; // 60 days to allow each day of prior 30 days to complete cohort&#13;&#10;ELSE &apos;out&apos; &#13;&#10;END' />
      </column>
      <column caption='Dimensions' datatype='string' name='[Calculation_1281555602018029615]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#10;    WHEN &apos;Country&apos; THEN [country_name]&#10;    WHEN &apos;Region&apos; THEN [region]&#10;    WHEN &apos;Brand&apos; THEN [brand]&#10;    WHEN &apos;Global&apos; THEN [Calculation_218987585835782147]&#10;    WHEN &apos;Vertical&apos; THEN [vertical]&#13;&#10;END' />
      </column>
      <column caption='pct RR 7d' datatype='real' name='[Calculation_1281555602019471415]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//SUM([cnt_RR_7d])&#13;&#10;//&#13;&#10;//SUM([sample_size_total_orders])&#13;&#10;&#13;&#10;SUM(IF [Parameters].[Parameter 8] = &apos;including replacement orders&apos; THEN [next_7_all_order_freq]&#13;&#10;ELSEIF [Parameters].[Parameter 8] = &apos;excluding replacement orders&apos; THEN [next_7_all_order_freq_without_replacement]&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(IF [Parameters].[Parameter 8] = &apos;including replacement orders&apos; THEN [orders_all]&#13;&#10;ELSEIF [Parameters].[Parameter 8] = &apos;excluding replacement orders&apos; THEN [count_orders_without_replacement]&#13;&#10;END)' />
      </column>
      <column caption='DT filter - data accuracy' datatype='string' name='[Calculation_1281555602714873970]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [brand] = &apos;Foodora&apos; THEN &apos;in&apos; // data accuracy + completeness reliable since MAY 2020&#13;&#10;ELSEIF [brand] = &apos;Foodpanda&apos; THEN &apos;in&apos; // data accuracy + completeness reliable since MAY 2020&#13;&#10;ELSEIF [brand] = &apos;eFood&apos; AND [created_date] &gt;= #2020-09-01# THEN &apos;in&apos; // data accuracy + completeness reliable since&#13;&#10;ELSEIF [brand] = &apos;HungerStation&apos; AND [created_date] &gt;= #2020-08-01# THEN &apos;in&apos; // data accuracy + completeness reliable since MAY 2020&#13;&#10;ELSEIF [brand] = &apos;PedidosYa&apos; AND [created_date] &gt;= #2020-08-01# THEN &apos;in&apos; // data accuracy + completeness reliable since MAY 2020&#13;&#10;ELSEIF [brand] = &apos;Talabat&apos; AND [created_date] &gt;= #2020-09-01# THEN &apos;in&apos; // data accuracy + completeness reliable since MAY 2020&#13;&#10;ELSEIF [brand] = &apos;Yemeksepeti&apos; AND [created_date] &gt;= #2020-09-01# THEN &apos;in&apos; // data accuracy + completeness reliable since SEPT 2020&#13;&#10;ELSEIF [brand] = &apos;Yogiyo&apos; AND [created_date] &gt;= #2020-09-01# THEN &apos;in&apos; // data accuracy + completeness reliable since SEPT 2020&#13;&#10;ELSEIF [created_date] &gt;= #2020-09-01# THEN &apos;in&apos;&#13;&#10;ELSE &apos;out&apos;&#13;&#10;END' />
      </column>
      <column caption='Global' datatype='string' name='[Calculation_218987585835782147]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Global&apos;' />
      </column>
      <column caption='AO NPS' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_218987586093641732]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IFNULL([after_order_nps_score],0))&#10;/&#10;SUM(IFNULL([after_order_nps_responses],1))' />
      </column>
      <column caption='SUM sample size total' datatype='integer' name='[Calculation_400820371892604933]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 8] = &apos;including replacement orders&apos; THEN [orders_all]&#13;&#10;    ELSEIF [Parameters].[Parameter 8] = &apos;excluding replacement orders&apos; THEN [count_orders_without_replacement]&#13;&#10;    END)' />
      </column>
      <column caption='Delivery or Delay Bucket' datatype='string' name='[Calculation_4425490355789381632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3 1]&#10;    WHEN &apos;Delivery Time Bucket&apos; THEN [delivery_time_bucket]&#10;    WHEN &apos;Order Delay Bucket&apos; THEN [order_delay_bucket]&#10;END' />
      </column>
      <column caption='% Difference in [Re-] Order Activity' datatype='real' default-format='p0.0%' name='[Calculation_4425490355812274178]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([RR period - pct RR (copy)_4425490355809660929]) - LOOKUP(ZN([RR period - pct RR (copy)_4425490355809660929]), -1)) / ABS(LOOKUP(ZN([RR period - pct RR (copy)_4425490355809660929]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Select Measure' datatype='string' name='[Calculation_469500265844801537]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 7] = &apos;is seamless&apos; THEN [Is Seamless (copy)_1049198043531091968]&#13;&#10;ELSEIF [Parameters].[Parameter 7] = &apos;order experience&apos; THEN [kpi_order_experience]&#13;&#10;ELSEIF [Parameters].[Parameter 7] = &apos;top level order experience&apos; THEN [ranked_order_experience]&#13;&#10;END' />
      </column>
      <column caption='Time Period' datatype='string' name='[Calculation_535224713482752000]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;Month&apos; THEN [month]&#10;    WHEN &apos;Week&apos; THEN [week]&#10;    WHEN &apos;Day&apos; THEN STR([created_date])&#13;&#10;    WHEN &apos;Quarter&apos; THEN [quarter]&#10;END' />
      </column>
      <column caption='Selected Metric' datatype='real' default-format='p0.00%' name='[Calculation_535224713484959745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;% Service ABC&apos; THEN [% service ABC (copy)_699183909442412552]&#10;    WHEN &apos;% Contacts&apos; THEN [% contacts (copy)_699183909442281479]&#10;    WHEN &apos;% Sessions&apos; THEN [% sessions (copy)_699183909442158598]&#13;&#10;    WHEN &apos;% Fail Rate&apos; THEN [% failed (copy)_699183909438423043]&#13;&#10;    WHEN &apos;% Order On Time&apos; THEN [% on-time (copy)_699183909441871876]&#13;&#10;    WHEN &apos;% Order Seamless&apos; THEN [Calculation_699183909443137545]&#10;END' />
      </column>
      <column caption='Chart Selection' datatype='string' name='[Calculation_535224713511047170]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Global&apos; THEN [Parameters].[Parameter 3]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Seamless Distribution&apos; THEN [Parameters].[Parameter 3]&#10;ELSE &apos;Regional&apos;&#10;END' />
      </column>
      <column caption='DT filter - RR period' datatype='string' name='[Calculation_685110134434267136]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 6] = &apos;7 days&apos; THEN [datediff &gt;= 14 days (copy)_1281555602048245858]&#13;&#10;ELSEIF [Parameters].[Parameter 6] = &apos;14 days&apos; THEN [datediff &gt;= 30 days (copy)_1281555602047197280]&#13;&#10;ELSEIF [Parameters].[Parameter 6] = &apos;30 days&apos; THEN [Calculation_1281555602017796142]&#13;&#10;END' />
      </column>
      <column caption='RR period - pct RR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_685110134434738177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF     [Parameters].[Parameter 6] = &apos;7 days&apos;  THEN [Calculation_1281555602019471415]&#13;&#10;ELSEIF [Parameters].[Parameter 6] = &apos;14 days&apos; THEN [pct RR 7d (copy)_1281555602019524664]&#13;&#10;ELSEIF [Parameters].[Parameter 6] = &apos;30 days&apos; THEN [pct RR 14d (copy)_1281555602019594297]&#13;&#10;END' />
      </column>
      <column caption='Sessions (MENA-adjusted)' datatype='real' name='[Calculation_6881289173896183808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [region] = &apos;MENA&apos; AND [created_date] &lt;= #28-NOV-21#&#10;    THEN [orders_sessions] * 2&#10;ELSEIF [region] = &apos;MENA&apos; AND [created_date] &lt;= #05-DEC-21#&#10;    THEN [orders_sessions] * 1.5&#10;ELSE [orders_sessions]&#10;END' />
      </column>
      <column caption='% Order Seamless' datatype='real' default-format='p0.0%' name='[Calculation_699183909443137545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([seamless_orders]))&#13;&#10;/&#13;&#10;SUM(ZN([orders_all]))' />
      </column>
      <column caption='Dimension (A)' datatype='string' name='[Calculation_699183910148870156]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose Chart Type (copy 2)] &#13;&#10;WHEN  &apos;Region&apos; THEN [region]&#13;&#10;WHEN  &apos;Brand&apos; THEN [brand]&#13;&#10;WHEN &apos;Country Name&apos; THEN [country_name]&#13;&#10;WHEN &apos;Country Code&apos; THEN [country_code]&#13;&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#13;&#10;WHEN &apos;None&apos; THEN &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='Metric avg down' datatype='real' name='[Calculation_699183910165061646]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_535224713484959745])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Metric Average - Row' datatype='real' name='[Calculation_699183910166229009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_535224713484959745])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Metric Average - Column Pane ' datatype='real' name='[Calculation_699183910166409234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// This is the WIN_AVG() calculated by PANE DOWN&#13;&#10;[Metric avg down (copy)_699183910165192719]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Metric Average - Column' datatype='real' name='[Calculation_699183910166581267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// This is the WIN_AVG() calculated by TABLE DOWN&#13;&#10;[Calculation_699183910165061646]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Metric Difference' datatype='real' name='[Calculation_699183910166802452]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_535224713484959745] - [Metric avg pane down (copy)_699183910165274640]) / [Metric avg pane down (copy)_699183910165274640]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Chart Selection Split by' datatype='string' name='[Chart Selection (copy)_1025976291080482816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;  WHEN &apos;Region&apos; THEN [region]&#13;&#10;  WHEN &apos;Management Entity&apos; THEN [management_entity]&#13;&#10;  WHEN &apos;Brand&apos; THEN [brand]&#13;&#10;  WHEN &apos;Country Name&apos; THEN [country_name]&#10;&#10;END' />
      </column>
      <column caption='Dimension (B)' datatype='string' name='[Dimension (A) (copy)_699183910149398541]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Choose Dimension (A) (copy)_699183910148706315] &#13;&#10;WHEN  &apos;Region&apos; THEN [region]&#13;&#10;WHEN  &apos;Brand&apos; THEN [brand]&#13;&#10;WHEN &apos;Country Name&apos; THEN [country_name]&#13;&#10;WHEN &apos;Country Code&apos; THEN [country_code]&#13;&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#13;&#10;WHEN &apos;None&apos; THEN &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='Is Seamless' datatype='string' name='[Is Seamless (copy)_1049198043531091968]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_seamless] THEN &apos;seamless&apos; ELSE &apos;non seamless&apos; END' />
      </column>
      <column caption='KPI Order Experience Bool' datatype='boolean' name='[KPI Order Experience (copy)_1049198043538812929]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([kpi_order_experience]) THEN FALSE ELSE TRUE END' />
      </column>
      <column datatype='string' name='[Management Entity (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[management_entity]' default='&quot;Exclusions&quot;' new-bin='true'>
          <bin default-name='false' value='&quot;Inclusions&quot;'>
            <value>&quot;DH Europe&quot;</value>
            <value>&quot;DH Greece&quot;</value>
            <value>&quot;Foodpanda APAC&quot;</value>
            <value>&quot;HungerStation&quot;</value>
