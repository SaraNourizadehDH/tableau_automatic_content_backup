      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/SeamlessOrdersABCs/DeliveryTimeandDelayImpact?rev=' id='DeliveryTimeandDelayImpact' path='/t/GlobalStandardReporting/workbooks/SeamlessOrdersABCs' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1100' maxwidth='1900' minheight='1000' minwidth='1800' sizing-mode='range' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='seamless_orders_abc' name='federated.1jbdp9i0boo3cg12fgxcb0trnkks' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Dimensions' datatype='string' name='[Parameter 1 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Global&quot;'>
          <calculation class='tableau' formula='&quot;Global&quot;' />
          <members>
            <member value='&quot;Global&quot;' />
            <member value='&quot;Region&quot;' />
            <member value='&quot;Brand&quot;' />
            <member value='&quot;Country&quot;' />
            <member value='&quot;Vertical&quot;' />
          </members>
        </column>
        <column caption='Choose Time Period' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
          <calculation class='tableau' formula='&quot;Week&quot;' />
          <members>
            <member value='&quot;Quarter&quot;' />
            <member value='&quot;Month&quot;' />
            <member value='&quot;Week&quot;' />
            <member value='&quot;Day&quot;' />
          </members>
        </column>
        <column caption='Delivery-Delay Parameter' datatype='string' name='[Parameter 3 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Order Delay Bucket&quot;'>
          <calculation class='tableau' formula='&quot;Order Delay Bucket&quot;' />
          <members>
            <member value='&quot;Delivery Time Bucket&quot;' />
            <member value='&quot;Order Delay Bucket&quot;' />
          </members>
        </column>
        <column caption='RR period' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;14 days&quot;'>
          <calculation class='tableau' formula='&quot;14 days&quot;' />
          <members>
            <member value='&quot;7 days&quot;' />
            <member value='&quot;14 days&quot;' />
            <member value='&quot;30 days&quot;' />
          </members>
        </column>
        <column caption='Replacement orders' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;excluding replacement orders&quot;'>
          <calculation class='tableau' formula='&quot;excluding replacement orders&quot;' />
          <members>
            <member value='&quot;including replacement orders&quot;' />
            <member value='&quot;excluding replacement orders&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1jbdp9i0boo3cg12fgxcb0trnkks'>
        <column caption='SUM sample size total' datatype='integer' name='[Calculation_400820371892604933]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='SUM(IF [Parameters].[Parameter 8] = &apos;including replacement orders&apos; THEN [orders_all]&#13;&#10;    ELSEIF [Parameters].[Parameter 8] = &apos;excluding replacement orders&apos; THEN [count_orders_without_replacement]&#13;&#10;    END)' />
