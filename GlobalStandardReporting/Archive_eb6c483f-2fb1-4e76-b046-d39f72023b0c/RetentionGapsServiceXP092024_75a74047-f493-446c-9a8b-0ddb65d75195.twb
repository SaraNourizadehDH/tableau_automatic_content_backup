            <column caption='Seamless clean orders' datatype='integer' name='[Calculation_394416869343952920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [ranked_order_experience] = &apos;Seamless&apos; and [is_clean_order] then [num_orders] end' />
