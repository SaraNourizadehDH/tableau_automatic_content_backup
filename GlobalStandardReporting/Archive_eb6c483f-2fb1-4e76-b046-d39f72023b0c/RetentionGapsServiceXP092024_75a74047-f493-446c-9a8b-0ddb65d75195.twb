            <run fontcolor='#000000' fontname='Tableau Regular' fontsize='9'>Issue type Breakdown</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Service Retention Gap XP' name='federated.18y3noj0cfigjg1fhi1tw04rko3j' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Exploit Results' datatype='string' name='[Automation Type (copy)_423408789382352901]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Show Top N CCR' datatype='integer' name='[CCR group Parameter]' param-domain-type='range' role='measure' type='quantitative' value='5'>
              <calculation class='tableau' formula='5' />
              <range max='20' min='1' />
            </column>
            <column caption='Automation Type' datatype='string' name='[Compensation Type (copy)_423408789382205444]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Selected Issue Type' datatype='string' name='[Issue Type Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Metric Type' datatype='string' datatype-customized='true' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Avg GMV 30D&quot;'>
              <calculation class='tableau' formula='&quot;Avg GMV 30D&quot;' />
            </column>
            <column alias='Week' caption='Date' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
              <aliases>
                <alias key='&quot;Daily&quot;' value='Date' />
                <alias key='&quot;Weekly&quot;' value='Week' />
              </aliases>
            </column>
            <column caption='Dimension 1' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;Automation Type&quot;'>
              <calculation class='tableau' formula='&quot;Automation Type&quot;' />
            </column>
            <column caption='Compensation Type' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Automation Request Outcome' datatype='string' name='[Parameter 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Selected Experience' datatype='string' name='[Selected Experience 1 (copy)_793548382261686325]' param-domain-type='list' role='measure' type='nominal' value='&quot;Non-Seamless Orders with Service XP&quot;'>
              <calculation class='tableau' formula='&quot;Non-Seamless Orders with Service XP&quot;' />
              <aliases>
                <alias key='&quot;Agent Contact &amp; HC Session&quot;' value='Agent Contact &amp; HC Session' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18y3noj0cfigjg1fhi1tw04rko3j'>
            <column caption='Agent &amp; HC RR- den' datatype='integer' name='[Agent &amp; Bot Contact RR- den  (copy)_793548381301178410]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Multiple&apos;&#10;AND [compensation filter (copy)_423408789382168579] = [Parameters].[Compensation Type (copy)_423408789382205444]&#10;AND [Automation type filter (copy)_423408789382639622] = [Parameters].[Automation Type (copy)_423408789382352901]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;THEN [num_orders] END' />
            </column>
            <column caption='Agent &amp; HC Avg gmv 30D' datatype='real' name='[Agent &amp; HC Avg gmv (copy)_724657352715075596]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter] &#10;AND [resolution_type] = &apos;Multiple&apos;&#10;AND [compensation filter (copy)_423408789382168579] = [Parameters].[Compensation Type (copy)_423408789382205444]&#10;AND [Automation type filter (copy)_152207650986303489] = [Parameters].[Parameter 9]&#10;AND [Automation type filter (copy)_423408789382639622] = [Parameters].[Automation Type (copy)_423408789382352901]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [gmv_30D_eur] end)/&#10;SUM(if [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter] &#10;AND [resolution_type] = &apos;Multiple&apos;&#10;AND [compensation filter (copy)_423408789382168579] = [Parameters].[Compensation Type (copy)_423408789382205444]&#10;AND [Automation type filter (copy)_152207650986303489] = [Parameters].[Parameter 9]&#10;AND [Automation type filter (copy)_423408789382639622] = [Parameters].[Automation Type (copy)_423408789382352901]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [num_orders] end)' />
            </column>
            <column caption='Agent Contact Avg gmv 30D' datatype='real' name='[Agent Contact Avg gmv  (copy)_724657352714764298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter] &#10;AND [resolution_type] = &apos;Agent_contact&apos;&#10;AND [Automation type filter (copy)_423408789382639622] = [Parameters].[Automation Type (copy)_423408789382352901]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [gmv_30D_eur] end)/&#10;SUM(if [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter] &#10;AND [resolution_type] = &apos;Agent_contact&apos;&#10;AND [Automation type filter (copy)_423408789382639622] = [Parameters].[Automation Type (copy)_423408789382352901]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;then [num_orders] end)' />
            </column>
            <column caption='Exploit result - not null' datatype='string' name='[Automation type - not null  (copy)_423408789381935106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([exploit_results], &apos;None&apos;)' />
            </column>
            <column caption='Automation Request Outcome Filter' datatype='string' name='[Automation type filter (copy)_152207650986303489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 9] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSE [Calculation_152207650984800256] end' />
            </column>
            <column caption='Exploit result filter' datatype='string' name='[Automation type filter (copy)_423408789382639622]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Automation Type (copy)_423408789382352901] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSE [Automation type - not null  (copy)_423408789381935106] end' />
            </column>
            <column caption='Date ' datatype='string' name='[Calculation_149111428220166144]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 4] = &apos;Daily&apos; then STR([created_date])&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Weekly&apos; then [week]&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Monthly&apos; then [month]&#10;end' />
            </column>
            <column caption='Automation Request Outcome' datatype='string' name='[Calculation_152207650984800256]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if NOT ISNULL([automation_type]) AND NOT [has_automation]&#10;then &apos;Fail&apos;&#10;ELSEIF NOT ISNULL([automation_type]) and [has_automation]&#10;then &apos;Success&apos;&#10;ELSE &apos;No Automation Request&apos;&#10;end' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Calculation_176344133189578775]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 7] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Order Experience&apos;&#10;then [ranked_order_experience]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Issue Type&apos;&#10;then [issue_type]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Resolution Type&apos;&#10;then [resolution_type]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;CCR Cluster&apos;&#10;then [contact_reason_cluster]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Customer Segment&apos;&#10;then [activity_segment]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Automation Type&apos;&#10;then [Calculation_423408789381861377]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Automation Request Outcome&apos;&#10;then [Calculation_152207650984800256]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Compensation Type&apos;&#10;then [Calculation_423408789381660672]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Management Entity&apos;&#10;then [management_entity_group]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Country&apos;&#10;then [country]&#10;end' />
            </column>
            <column caption='remove last 30 days' datatype='boolean' name='[Calculation_2659586743313412096]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_date] &lt; DATEADD(&apos;day&apos;, -30, TODAY())' />
            </column>
            <column caption='Selected sheet' datatype='string' name='[Calculation_394416869335863316]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Retention&apos; THEN &#10;&apos;retention&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;GMV&apos; THEN &apos;gmv&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Avg GMV 30D&apos; THEN &apos;avg gmv 30d&apos; &#10;ELSEIF [Parameters].[Parameter 3] = &apos;Avg Reorders 30D&apos; THEN &apos;avg reorders 30d&apos;&#10;end' />
            </column>
            <column caption='Compensation type - not null' datatype='string' name='[Calculation_423408789381660672]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([compensation_type], &apos;None&apos;)' />
            </column>
            <column caption='Automation type - not null ' datatype='string' name='[Calculation_423408789381861377]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([automation_type], &apos;None&apos;)' />
            </column>
            <column caption='Issue Type Filter' datatype='string' name='[Calculation_793548382262435895]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Issue Type Parameter] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSE [issue_type] end' />
            </column>
            <column caption='Date range' datatype='date' name='[Created Date (copy)_392939112520462336]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[created_date]' />
