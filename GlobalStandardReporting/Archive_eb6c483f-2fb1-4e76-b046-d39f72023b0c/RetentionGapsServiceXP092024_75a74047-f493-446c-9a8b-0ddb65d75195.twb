            <column caption='Proactive compensation reorder 30d' datatype='real' name='[Proactive compensation Avg gmv  (copy)_584693951681961985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [ranked_order_experience] &lt;&gt; &apos;Seamless&apos; &#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;AND [compensation_category] = &apos;Proactive&apos;&#10;AND ISNULL([resolution_type])&#10;then [reorders_30D] end)/&#10;SUM(if [ranked_order_experience] &lt;&gt; &apos;Seamless&apos;&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;AND [compensation_category] = &apos;Proactive&apos;&#10;AND ISNULL([resolution_type])&#10;then [num_orders] end)' />
