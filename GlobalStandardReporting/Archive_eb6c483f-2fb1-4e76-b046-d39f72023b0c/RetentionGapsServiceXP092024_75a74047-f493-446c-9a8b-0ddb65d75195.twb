      </column>
      <column caption='Metric' datatype='real' name='[Calculation_176344133173145619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 3] = &apos;Retention&apos; then [Calculation_793548382308692030] ELSEIF [Parameters].[Parameter 3] = &apos;GMV&apos; then [Calculation_341781047897264135] end' />
      </column>
      <column caption='Top Segment' datatype='string' name='[Calculation_176344133179826196]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Issue Type Set] then [issue_type] END' />
      </column>
      <column caption='Dimension 1' datatype='string' name='[Calculation_176344133189578775]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 7] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Order Experience&apos;&#10;then [ranked_order_experience]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Issue Type&apos;&#10;then [issue_type]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Resolution Type&apos;&#10;then [resolution_type]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;CCR Cluster&apos;&#10;then [contact_reason_cluster]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Customer Segment&apos;&#10;then [activity_segment]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Automation Type&apos;&#10;then [Calculation_423408789381861377]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Automation Request Outcome&apos;&#10;then [Calculation_152207650984800256]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Compensation Type&apos;&#10;then [Calculation_423408789381660672]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Management Entity&apos;&#10;then [management_entity_group]&#10;ELSEIF [Parameters].[Parameter 7] = &apos;Country&apos;&#10;then [country]&#10;end' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_187321657555673088]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='remove last 30 days' datatype='boolean' name='[Calculation_2659586743313412096]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[created_date] &lt; DATEADD(&apos;day&apos;, -30, TODAY())' />
      </column>
      <column caption='Sealmess Avg gmv' datatype='real' name='[Calculation_341781047843500032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [ranked_order_experience] = &apos;Seamless&apos;&#10;AND ISNULL([issue_type])&#10;then [gmv_eur] end)/&#10;SUM(if [ranked_order_experience] = &apos;Seamless&apos;&#10;AND ISNULL([issue_type])&#10;then [num_orders] end)' />
      </column>
      <column caption='Avg Gmv' datatype='real' name='[Calculation_341781047897264135]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gmv_eur])/SUM([num_orders])' />
      </column>
      <column caption='% clean orders' datatype='real' name='[Calculation_394416869330538504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [is_clean_order] then [num_orders] end)/SUM([num_orders])' />
      </column>
      <column caption='Selected sheet' datatype='string' name='[Calculation_394416869335863316]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Retention&apos; THEN &#10;&apos;retention&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;GMV&apos; THEN &apos;gmv&apos;&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Avg GMV 30D&apos; THEN &apos;avg gmv 30d&apos; &#10;ELSEIF [Parameters].[Parameter 3] = &apos;Avg Reorders 30D&apos; THEN &apos;avg reorders 30d&apos;&#10;end' />
      </column>
      <column caption='Ratio' datatype='real' name='[Calculation_394416869339807767]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Selected Benchmark (copy)_793548382278152251])/SUM([Selected Benchmark 0rders (copy)_793548382278971452])' />
      </column>
      <column caption='Seamless clean orders' datatype='integer' name='[Calculation_394416869343952920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [ranked_order_experience] = &apos;Seamless&apos; and [is_clean_order] then [num_orders] end' />
      </column>
      <column caption='% Seamless clean orders' datatype='real' name='[Calculation_394416869344112665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_394416869343952920])/SUM([Calculation_793548381281579008])' />
      </column>
      <column caption='% Agent clean orders' datatype='real' name='[Calculation_394416869346557979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Seamless clean orders (copy)_394416869346471962])/SUM([Seamless Retention Rate - den (copy)_793548381283442691])' />
      </column>
      <column caption='Compensation type - not null' datatype='string' name='[Calculation_423408789381660672]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([compensation_type], &apos;None&apos;)' />
      </column>
      <column caption='Automation type - not null ' datatype='string' name='[Calculation_423408789381861377]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([automation_type], &apos;None&apos;)' />
      </column>
      <column caption='Quarter' datatype='string' name='[Calculation_4790493016517701632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([created_date])) + &apos;-Q&apos; + STR(QUARTER([created_date]))' />
      </column>
      <column caption='Avg reorders 30D' datatype='real' name='[Calculation_724657352805212207]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reorders_30D])/SUM([num_orders])' />
      </column>
      <column caption='Seamless Retention Rate - den' datatype='integer' name='[Calculation_793548381281579008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [ranked_order_experience] = &apos;Seamless&apos; &#10;AND ISNULL([issue_type])&#10;then [num_orders] end' />
      </column>
      <column caption='Issue Type Filter' datatype='string' name='[Calculation_793548382262435895]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Issue Type Parameter] = &apos;All&apos;&#10;then &apos;All&apos;&#10;ELSE [issue_type] end' />
      </column>
      <column caption='Retention rate' datatype='real' name='[Calculation_793548382308692030]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [has_reorder_30D] then [num_orders] end)/ sum([num_orders])' />
      </column>
      <column caption='Agent Contact - share of orders' datatype='real' name='[Calculation_934989564760252419]' role='measure' type='quantitative'>
