              <calculation class='tableau' formula='SUM([Agent &amp; Bot clean orders (copy)_167688776970469438])&#10;/ SUM([Agent &amp; Bot Contact RR- den  (copy)_793548381301178410])' />
            </column>
            <column caption='% HC clean orders ' datatype='real' name='[% Bot clean orders (copy)_167688776969580604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_167688776969445435])/SUM([HC RR - enum (copy)_793548381290057735])' />
            </column>
            <column caption='% Proactive clean orders' datatype='real' name='[% HC clean orders  (copy)_152207651022925828]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Proactive flow - den  (copy)_152207651022106626])/SUM([Non-Seamless Retention Rate - den (copy)_584693951682527236])' />
            </column>
            <column caption='% Non-Seamless clean orders without service xp' datatype='real' name='[% Non-Seamless clean orders (copy)_152207651023200262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Non-seamless without service xp -den (copy)_152207651023101957])/SUM([Proactive flow - den  (copy)_584693951684829194])' />
            </column>
            <column caption='% Non-Seamless clean orders' datatype='real' name='[% Seamless clean orders (copy)_182888427716907018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Seamless clean orders (copy)_182888427716620296])/SUM([Seamless Retention Rate - den (copy)_182888427714875392])' />
            </column>
            <column caption='Agent &amp; HC RR- den' datatype='integer' name='[Agent &amp; Bot Contact RR- den  (copy)_793548381301178410]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Multiple&apos;&#10;AND [compensation filter (copy)_423408789382168579] = [Parameters].[Compensation Type (copy)_423408789382205444]&#10;AND [Automation type filter (copy)_423408789382639622] = [Parameters].[Automation Type (copy)_423408789382352901]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;THEN [num_orders] END' />
            </column>
            <column caption='Agent &amp; HC clean orders' datatype='integer' name='[Agent &amp; Bot clean orders (copy)_167688776970469438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_793548382262435895] = [Parameters].[Issue Type Parameter]&#10;AND [resolution_type] = &apos;Multiple&apos;&#10;AND [compensation filter (copy)_423408789382168579] = [Parameters].[Compensation Type (copy)_423408789382205444]&#10;AND [Automation type filter (copy)_423408789382639622] = [Parameters].[Automation Type (copy)_423408789382352901]&#10;AND [p2p chat filter (copy)_955466819114586115] = [Parameters].[Parameter 8]&#10;AND [Automation type filter (copy)_152207650986303489] = [Parameters].[Parameter 9]&#10;AND [is_clean_order] then [num_orders] end' />
            </column>
