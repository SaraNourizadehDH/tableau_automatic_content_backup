            </column>
            <column caption='Top N Segment' datatype='string' name='[Top Segment (copy)_2036260411441516544]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Dimension 1 Set] then IFNULL([Calculation_176344133189578775], &apos;None&apos;) ELSE &apos;Other&apos; &#10;END' />
