      </column>
      <column caption='Clean orders Color cluster' datatype='string' name='[Clean orders Color (copy)_1387882802094145537]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Selected Experience Clean 0rders (copy)_176344133168873490] &lt; 0.50 then &apos;red&apos; &#10;ELSEIF [Selected Benchmark Clean 0rders (copy)_176344133167878161] &gt;= 0.50 &#10;and [Selected Benchmark Clean 0rders (copy)_176344133167878161] &lt; 0.70 then &apos;orange&apos;&#10;else&#10;&apos;green&apos; end' />
      </column>
