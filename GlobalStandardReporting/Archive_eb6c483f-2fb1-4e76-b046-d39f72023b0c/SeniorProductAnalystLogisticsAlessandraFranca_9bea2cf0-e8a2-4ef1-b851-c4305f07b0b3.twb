            <column datatype='datetime' name='[order_placed_at]' role='dimension' type='ordinal' />
            <column datatype='real' name='[order_value_eur]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3821937602705195023]' derivation='User' name='[pcto:usr:Calculation_3821937602705195023:qk:14]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.1eco6k810i5fm916pmgs319szkzw].[Calculation_3821937602679005194]' ordering-type='Field' type='PctTotal' />
