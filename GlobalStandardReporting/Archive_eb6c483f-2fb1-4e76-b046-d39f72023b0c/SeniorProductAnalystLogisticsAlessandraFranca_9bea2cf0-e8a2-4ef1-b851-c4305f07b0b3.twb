            <column-instance column='[order_placed_at]' derivation='None' name='[none:order_placed_at:ok]' pivot='key' type='ordinal' />
            <column-instance column='[vertical (copy)_5172524909858377731]' derivation='None' name='[none:vertical (copy)_5172524909858377731:nk]' pivot='key' type='nominal' />
