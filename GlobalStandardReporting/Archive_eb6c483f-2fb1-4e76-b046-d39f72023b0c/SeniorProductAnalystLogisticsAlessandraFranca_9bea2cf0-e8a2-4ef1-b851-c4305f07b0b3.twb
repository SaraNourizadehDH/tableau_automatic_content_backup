      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1eco6k810i5fm916pmgs319szkzw].[sum:chat_missed (copy)_5172524910063865873:qk]&quot;' value='Chat Missed' />
          <alias key='&quot;[federated.1eco6k810i5fm916pmgs319szkzw].[sum:chat_served (copy)_5172524910063755280:qk]&quot;' value='Chat Served' />
        </aliases>
      </column>
      <column caption='Promissed Delivery Timestamp' datatype='datetime' name='[Calculation_3116420573991632897]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;second&apos;, [promised_delivery_time], [order_placed_at])' />
      </column>
      <column caption='Is Cancelled Late?' datatype='string' name='[Calculation_3116420573992271874]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_cancelled] = TRUE and [cancelled_at] &gt; [Calculation_3116420573991632897] then &apos;Cancellation after delay&apos;&#10;ELSEIF [is_cancelled] = TRUE and [cancelled_at] &lt; [Calculation_3116420573991632897] then &apos;Cancellation before delay&apos;&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Report Date' datatype='string' name='[Calculation_3821937602659532800]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;2023-09-12&apos;' />
      </column>
      <column caption='Time breakdown' datatype='integer' name='[Calculation_3821937602668388355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// This calculated field is used in combination with the parameter.&#10;// Adapting horizontal cohort based on time breakdown&#10;case [Parameters].[Parameter 1]&#10;when &apos;Month&apos; then DATEPART(&apos;month&apos;,[order_placed_at])&#10;when &apos;Week&apos; then WEEK([order_placed_at])&#10;when &apos;Day&apos; then DAY([order_placed_at])&#10;END' />
      </column>
      <column caption='Issues Accessment' datatype='string' name='[Calculation_3821937602679005194]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_cancelled] = TRUE and [is_late] = TRUE AND [has_contact] = TRUE THEN &apos;Cancelled, late and contact&apos;&#10;ELSEIF [is_cancelled] = TRUE and [is_late] = TRUE AND [has_contact] = FALSE THEN &apos;Cancelled and late&apos;&#10;ELSEIF [is_cancelled] = TRUE and ([is_late] = FALSE OR ISNULL([is_late])) AND [has_contact] = TRUE THEN &apos;Cancelled and contact&apos;&#10;ELSEIF [is_cancelled] = FALSE and [is_late] = TRUE AND [has_contact] = TRUE THEN &apos;Late and contact&apos;&#10;ELSEIF [is_cancelled] = TRUE and ([is_late] = FALSE OR ISNULL([is_late]))  AND [has_contact] = FALSE THEN &apos;Cancelled&apos;&#10;ELSEIF [is_cancelled] = FALSE and [is_late] = TRUE AND [has_contact] = FALSE THEN &apos;Late&apos;&#10;ELSEIF [is_cancelled] = FALSE and ([is_late] = FALSE OR ISNULL([is_late]))  AND [has_contact] = TRUE THEN &apos;Contact&apos;&#10;ELSE &apos;Seamless Order&apos;&#10;END' />
      </column>
      <column caption='KPI Base' datatype='real' name='[Calculation_3821937602705195023]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;   WHEN &apos;Order Count&apos; THEN COUNTD([enc_order_id])&#10;   WHEN &apos;Order Value&apos; THEN SUM([order_value_eur])&#10;END' />
      </column>
      <column caption='Time to Cancel' datatype='integer' name='[Calculation_5172524909735084033]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF ISNULL([cancelled_at]) THEN NULL&#10;ELSE DATEDIFF(&apos;hour&apos;, [order_placed_at], [cancelled_at])&#10;END' />
      </column>
      <column caption='Cancellation [Hour]' datatype='integer' name='[Calculation_5172524909738258434]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [cancelled_at])' />
      </column>
      <column caption='Average Ticket' datatype='real' name='[Calculation_5172524909991645194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_value_eur])/COUNTD([enc_order_id])' />
      </column>
      <column caption='Delayed Median' datatype='real' name='[Calculation_5172524910056624140]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([is_cancelled] = FALSE AND [actual_delivery_duration_secs] &gt; [promised_delivery_time]) &#10;    THEN [actual_delivery_duration_secs] - [promised_delivery_time]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='Service Rate' datatype='real' name='[Calculation_5172524910064341010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([chat_served])/(SUM([chat_served])+SUM([chat_missed]))' />
      </column>
