      <repository-location id='LateDeliveriesExplore' path='/t/GlobalStandardReporting/workbooks/SeniorProductAnalystLogistics-AlessandraFranca' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1500' maxwidth='1400' minheight='1500' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='Custom SQL (DH Case Study)' name='federated.1eco6k810i5fm916pmgs319szkzw' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Time breakdown [Order Placed Cohort]' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
          <calculation class='tableau' formula='&quot;Week&quot;' />
          <members>
            <member value='&quot;Month&quot;' />
            <member value='&quot;Week&quot;' />
            <member value='&quot;Day&quot;' />
          </members>
        </column>
        <column caption='KPI Base' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Order Count&quot;'>
          <calculation class='tableau' formula='&quot;Order Count&quot;' />
          <members>
            <member value='&quot;Order Count&quot;' />
            <member value='&quot;Order Value&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1eco6k810i5fm916pmgs319szkzw'>
        <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
