      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL (DH Case Study)' id='_0882156BD07B410CA80BBB97F256A886'>
            <properties context=''>
              <relation connection='bigquery.13ynaay0ex7riv1254er00kf428g' name='Custom SQL Query' type='text'>with median_delayed as (
    SELECT
        country_code,
        median_delayed_sec
    FROM (
          SELECT
            country_code,
            PERCENTILE_CONT(
                (CASE WHEN d.delivery_status = &apos;completed&apos; AND d.actual_delivery_duration_secs &gt;&gt; d.promised_delivery_time THEN d.actual_delivery_duration_secs - d.promised_delivery_time
                ELSE NULL END),0.5) over(partition by country_code) AS median_delayed_sec,
          FROM `dh-interview-case-study.logistics_data_analytics.deliveries` AS d)
    GROUP BY 1,2)

SELECT 
  *,
  CASE 
    WHEN is_cancelled = TRUE OR has_contact = TRUE OR is_late = TRUE THEN FALSE
    ELSE TRUE END AS is_seamless
FROM (
    SELECT
    o.enc_order_id,
    o.country_code,
    o.vertical,
      CASE
        WHEN o.country_code = &apos;TH&apos; THEN DATETIME(o.order_placed_at, &apos;Asia/Bangkok&apos;)
        ELSE DATETIME(o.order_placed_at,&apos;Asia/Kuala_Lumpur&apos;)  END AS order_placed_at,
    o.status,
    o.order_value as order_value_local_currency,
    CASE
        WHEN o.country_code = &apos;MY&apos; THEN o.order_value/4.8907
        WHEN o.country_code = &apos;TH&apos; THEN o.order_value/36.632
        ELSE NULL END as order_value_eur,
    CASE
        WHEN o.country_code = &apos;TH&apos; THEN DATETIME(c.cancelled_at, &apos;Asia/Bangkok&apos;)
        ELSE DATETIME(c.cancelled_at,&apos;Asia/Kuala_Lumpur&apos;) END AS cancelled_at,
    c.cancellation_owner,
    d.promised_delivery_time,
    d.actual_delivery_duration_secs,
    d.delivery_status,
    CASE
        WHEN o.country_code = &apos;TH&apos; THEN DATETIME(ct.creation_timestamp, &apos;Asia/Bangkok&apos;)
        ELSE DATETIME(ct.creation_timestamp,&apos;Asia/Kuala_Lumpur&apos;)  END AS contacted_at,
    ct.contact_reason,
    ct.served_chat_ind as chat_served,
    ct.missed_chat_ind as chat_missed,
    CASE
      WHEN c.enc_order_id IS NOT NULL THEN TRUE
      WHEN o.status = &apos;CANCELLED&apos; THEN TRUE
      WHEN d.delivery_status = &apos;cancelled&apos; THEN TRUE
      ELSE FALSE END AS is_cancelled,
    CASE
      WHEN ct.enc_order_id IS NOT NULL THEN TRUE
      ELSE FALSE END AS has_contact,
    CASE
      WHEN d.promised_delivery_time IS NULL THEN NULL
      WHEN d.actual_delivery_duration_secs &gt;&gt; (d.promised_delivery_time + median_delayed_sec) THEN TRUE
      ELSE FALSE END AS is_late
  FROM `dh-interview-case-study.logistics_data_analytics.orders` AS o
  LEFT JOIN `dh-interview-case-study.logistics_data_analytics.deliveries` AS d ON d.enc_order_id = o.enc_order_id AND d.country_code = o.country_code
  LEFT JOIN `dh-interview-case-study.logistics_data_analytics.cancellations` AS c on c.enc_order_id = o.enc_order_id AND c.country_code = o.country_code
  LEFT JOIN `dh-interview-case-study.logistics_data_analytics.contacts` AS ct on ct.enc_order_id = o.enc_order_id AND ct.country_code = o.country_code
  LEFT JOIN median_delayed m ON m.country_code = o.country_code)</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
