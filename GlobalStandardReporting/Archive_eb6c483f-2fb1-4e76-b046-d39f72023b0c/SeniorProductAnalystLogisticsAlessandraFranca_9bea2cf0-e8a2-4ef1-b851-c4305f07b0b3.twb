            <column-instance column='[vertical (copy)_5172524909858377731]' derivation='None' name='[none:vertical (copy)_5172524909858377731:nk]' pivot='key' type='nominal' />
            <column-instance column='[vertical]' derivation='None' name='[none:vertical:nk]' pivot='key' type='nominal' />
            <column datatype='datetime' name='[order_placed_at]' role='dimension' type='ordinal' />
            <column datatype='real' name='[order_value_eur]' role='measure' type='quantitative' />
