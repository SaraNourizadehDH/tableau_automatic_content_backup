    <worksheet name='Reasons for Issues - Vertical'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL (DH Case Study)' name='federated.1eco6k810i5fm916pmgs319szkzw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time breakdown [Order Placed Cohort]' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Week&quot;'>
              <calculation class='tableau' formula='&quot;Week&quot;' />
            </column>
            <column caption='KPI Base' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Order Count&quot;'>
              <calculation class='tableau' formula='&quot;Order Count&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1eco6k810i5fm916pmgs319szkzw'>
            <column caption='Time breakdown' datatype='integer' name='[Calculation_3821937602668388355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// This calculated field is used in combination with the parameter.&#10;// Adapting horizontal cohort based on time breakdown&#10;case [Parameters].[Parameter 1]&#10;when &apos;Month&apos; then DATEPART(&apos;month&apos;,[order_placed_at])&#10;when &apos;Week&apos; then WEEK([order_placed_at])&#10;when &apos;Day&apos; then DAY([order_placed_at])&#10;END' />
            </column>
            <column caption='Issues Accessment' datatype='string' name='[Calculation_3821937602679005194]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_cancelled] = TRUE and [is_late] = TRUE AND [has_contact] = TRUE THEN &apos;Cancelled, late and contact&apos;&#10;ELSEIF [is_cancelled] = TRUE and [is_late] = TRUE AND [has_contact] = FALSE THEN &apos;Cancelled and late&apos;&#10;ELSEIF [is_cancelled] = TRUE and ([is_late] = FALSE OR ISNULL([is_late])) AND [has_contact] = TRUE THEN &apos;Cancelled and contact&apos;&#10;ELSEIF [is_cancelled] = FALSE and [is_late] = TRUE AND [has_contact] = TRUE THEN &apos;Late and contact&apos;&#10;ELSEIF [is_cancelled] = TRUE and ([is_late] = FALSE OR ISNULL([is_late]))  AND [has_contact] = FALSE THEN &apos;Cancelled&apos;&#10;ELSEIF [is_cancelled] = FALSE and [is_late] = TRUE AND [has_contact] = FALSE THEN &apos;Late&apos;&#10;ELSEIF [is_cancelled] = FALSE and ([is_late] = FALSE OR ISNULL([is_late]))  AND [has_contact] = TRUE THEN &apos;Contact&apos;&#10;ELSE &apos;Seamless Order&apos;&#10;END' />
            </column>
            <column caption='KPI Base' datatype='real' name='[Calculation_3821937602705195023]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;   WHEN &apos;Order Count&apos; THEN COUNTD([enc_order_id])&#10;   WHEN &apos;Order Value&apos; THEN SUM([order_value_eur])&#10;END' />
            </column>
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[enc_order_id (copy)_3821937602663677953]' derivation='CountD' name='[ctd:enc_order_id (copy)_3821937602663677953:qk]' pivot='key' type='quantitative' />
            <column aggregation='CountD' caption='[Count] enc_order_id' datatype='string' default-role='measure' default-type='quantitative' name='[enc_order_id (copy)_3821937602663677953]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[enc_order_id]' />
            </column>
            <column datatype='string' name='[enc_order_id]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[has_contact]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_cancelled]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_late]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_seamless]' role='dimension' type='nominal'>
              <aliases>
                <alias key='false' value='Order is not Seamless' />
                <alias key='true' value='Order is Seamless' />
              </aliases>
            </column>
            <column-instance column='[order_placed_at]' derivation='Month' name='[mn:order_placed_at:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_3821937602668388355]' derivation='None' name='[none:Calculation_3821937602668388355:ok]' pivot='key' type='ordinal' />
