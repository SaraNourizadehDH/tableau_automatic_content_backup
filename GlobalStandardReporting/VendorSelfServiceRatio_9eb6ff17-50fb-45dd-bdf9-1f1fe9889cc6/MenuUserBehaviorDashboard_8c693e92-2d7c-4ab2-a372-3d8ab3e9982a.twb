            </column>
            <column caption='Previous Date' datatype='datetime' name='[Calculation_6057271171727650823]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Dimension B (copy)] = &quot;Monthly&quot; THEN DATEADD(&apos;month&apos;, -1, [Calculation_6057271171717185540])&#10;ELSEIF [Parameters].[Dimension B (copy)] = &quot;Weekly&quot; THEN DATEADD(&apos;week&apos;, -1, [Calculation_6057271171717185540])&#10;ELSEIF [Parameters].[Dimension B (copy)] = &quot;Daily&quot; THEN DATEADD(&apos;day&apos;, -1, [Calculation_6057271171717185540])&#10;END' />
