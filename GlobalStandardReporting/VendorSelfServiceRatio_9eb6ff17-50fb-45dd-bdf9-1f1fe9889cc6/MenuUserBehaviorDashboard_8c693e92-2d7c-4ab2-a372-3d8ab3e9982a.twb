      <aliases enabled='yes' />
      <column caption='#Menu Add Publish' datatype='integer' name='[#Menu Delete Publish (copy)_3619416397020954627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [event_name] = &apos;menu_element_publish&apos; AND [operation_type] = &apos;Add&apos; THEN [distinct_user_count] ELSE 0 END&#10;)' />
      </column>
      <column caption='#Availability Off/On Publish' datatype='integer' name='[#Menu Edit Publish (copy)_3619416397019881473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [event_name] = &apos;menu_element_availability_on/off_success&apos; AND [operation_type] = &apos;Availability&apos; THEN [distinct_user_count] ELSE 0 END&#10;)' />
      </column>
      <column caption='#Menu Delete Publish' datatype='integer' name='[#Menu Edit Publish (copy)_3619416397020819458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [event_name] = &apos;menu_element_delete&apos; AND [operation_type] = &apos;Delete&apos; THEN [distinct_user_count] ELSE 0 END&#10;)' />
      </column>
      <column caption='#menu_element_validation_error_display' datatype='integer' name='[#Menu Edit Publish (copy)_5959036403461365762]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [event_name] = &apos;menu_element_validation_error_display&apos;  THEN [distinct_user_count] ELSE 0 END&#10;)' />
      </column>
      <column caption='#Menu Edit Publish or Delete' datatype='integer' name='[#Menu Edit Publish (copy)_5959036403462377476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [event_name] = &apos;menu_element_publish&apos; OR [event_name] = &apos;menu_element_delete&apos; THEN [distinct_user_count] ELSE 0 END&#10;)' />
      </column>
      <column caption='#menu_element_error_display' datatype='integer' name='[#menu_element_validation_error_display (copy)_5959036403461529603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [event_name] = &apos;menu_element_error_display&apos;  THEN [distinct_user_count] ELSE 0 END&#10;)' />
      </column>
      <column caption='%menu_element_publish_enable' datatype='real' default-format='p0.00%' name='[%menu_element_display (copy)_793126155302232067]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [event_name] = &apos;menu_element_publish_enable&apos; THEN [distinct_user_count] ELSE 0 END&#10;)&#10;/&#10;SUM(&#10;    IF [event_name] = &apos;menu_element_display&apos; THEN [distinct_user_count] ELSE 0 END&#10;)' />
      </column>
      <column caption='%menu_element_add_or_edit_click' datatype='real' default-format='p0.00%' name='[%menu_element_display (copy)_793126155316211719]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [event_name] = &apos;menu_element_edit&apos;  OR [event_name] = &apos;menu_element_add&apos; OR [event_name] = &apos;menu_element_delete&apos;  THEN [distinct_user_count] ELSE 0 END&#10;)&#10;/&#10;SUM(&#10;    IF [event_name] = &apos;menu_display&apos; THEN [distinct_user_count] ELSE 0 END&#10;)' />
      </column>
      <column caption='%menu_element_publish_validation_error' datatype='real' default-format='p0.00%' name='[%menu_element_publish (copy)_5959036403458822144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [event_name] = &apos;menu_element_validation_error_display&apos; THEN [distinct_user_count] ELSE 0 END&#10;)&#10;/&#10;SUM(&#10;    IF [event_name] = &apos;menu_element_publish&apos; OR [event_name] = &apos;menu_element_delete&apos; THEN [distinct_user_count] ELSE 0 END&#10;&#10;)' />
      </column>
      <column caption='%menu_element_success_display' datatype='real' default-format='p0.00%' name='[%menu_element_publish (copy)_793126155314003974]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [event_name] = &apos;menu_element_success_display&apos; THEN [distinct_user_count] ELSE 0 END&#10;)&#10;/&#10;SUM(&#10;    IF [event_name] = &apos;menu_element_publish&apos; OR [event_name] = &apos;menu_element_delete&apos; THEN [distinct_user_count] ELSE 0 END&#10;)' />
      </column>
      <column caption='%menu_element_publish' datatype='real' default-format='p0.00%' name='[%menu_element_publish_enable (copy)_793126155313823748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [event_name] = &apos;menu_element_publish&apos; OR [event_name] = &apos;menu_element_delete&apos; THEN [distinct_user_count] ELSE 0 END&#10;)&#10;/&#10;SUM(&#10;    IF [event_name] = &apos;menu_element_display&apos; THEN [distinct_user_count] ELSE 0 END&#10;)' />
      </column>
      <column caption='%menu_element_publish_error' datatype='real' default-format='p0.00%' name='[%menu_element_publish_validation_error (copy)_5959036403459227649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [event_name] = &apos;menu_element_error_display&apos; THEN [distinct_user_count] ELSE 0 END&#10;)&#10;/&#10;SUM(&#10;    IF [event_name] = &apos;menu_element_publish&apos; OR [event_name] = &apos;menu_element_delete&apos; THEN [distinct_user_count] ELSE 0 END&#10;&#10;)' />
      </column>
      <column caption='Menu Display Adoption' datatype='real' default-format='p0.00%' name='[Calculation_4329225918438473728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [event_name] = &apos;menu_display&apos; THEN [distinct_user_count] ELSE 0 END&#10;)&#10;/&#10;SUM(&#10;    IF [event_name] = &apos;session_start&apos; THEN [distinct_user_count] ELSE 0 END&#10;)' />
      </column>
      <column caption='Event Names' datatype='string' name='[Calculation_5376172097563201536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [event_name]&#10;    WHEN &quot;session_start&quot; THEN &quot;session start&quot;&#10;    WHEN &quot;menu_display&quot; THEN &quot;menu display&quot;&#10;    WHEN &quot;menu_element_edit&quot; THEN &quot;menu change group edit&quot;&#10;    WHEN &quot;menu_element_add&quot; THEN &quot;menu change group add&quot;&#10;    WHEN &quot;menu_element_delete&quot; THEN &quot;menu change group delete&quot;&#10;    WHEN &quot;mene_element_display&quot; THEN &quot;mene change group display&quot;&#10;    WHEN &quot;menu_element_publish_enable&quot; THEN &quot;menu change group publish enable&quot;&#10;    WHEN &quot;menu_element_publish&quot; THEN &quot;menu change group publish&quot;&#10;    WHEN &quot;menu_element_success_display&quot; THEN &quot;menu change group success display&quot;&#10;    WHEN &quot;menu_element_validation_error_display&quot; THEN &quot;menu change group validation error display&quot;&#10;    WHEN &quot;menu_element_error_display&quot; THEN &quot;menu change group_error display&quot;&#10;    WHEN &quot;menu_element_availability_toggle_off&quot; THEN &quot;menu change group_availability toggle off&quot;&#10;    WHEN &quot;menu_element_unavailability_reason_display&quot; THEN &quot;menu change group_unavailability reason display&quot;&#10;    WHEN &quot;menu_element_availability_on/off_success&quot; THEN &quot;menu change group availability on/off success&quot;&#10;    ELSE [event_name]  // default to original if no match&#10;END' />
      </column>
      <column caption='Dimension A' datatype='string' name='[Calculation_6057271171715489793]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[#Menu Add Publish Parameter]&#10;WHEN &quot;Region&quot; THEN [region]&#10;WHEN &quot;Brand Name&quot; THEN [brand]&#10;WHEN &quot;Entity ID&quot; THEN [entity_id]&#10;WHEN &quot;Country Name&quot; THEN [country_name]&#10;WHEN &quot;Client Name&quot; THEN [client_name]&#10;WHEN &quot;(All)&quot; THEN &quot;(All)&quot;&#10;END' />
      </column>
      <column caption='Current Date' datatype='date' name='[Calculation_6057271171717185540]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='//IF [Date Granularity] = &quot;Monthly&quot; THEN  {MAX(IF [Time Granularity] = &quot;monthly&quot; THEN [Date] ELSE NULL END)}&#10;//ELSEIF [Date Granularity]= &quot;Weekly&quot; THEN  {MAX(IF [Time Granularity] = &quot;weekly&quot; THEN [Date] ELSE NULL END)}&#10;//ELSEIF [Date Granularity] = &quot;Daily&quot; THEN  {MAX(IF [Time Granularity] = &quot;daily&quot; THEN [Date] ELSE NULL END)}&#10;//END&#10;{FIXED: MAX([date])}' />
      </column>
      <column caption='_Previous Date_filter' datatype='boolean' name='[Calculation_6057271171721895941]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//IF [Date Granularity] = &quot;Monthly&quot; THEN  {FIXED: MAX(IF [Time Granularity] = &quot;monthly&quot; THEN (IF [Date] &gt;= [Current Date] THEN NULL ELSE [Date] END) ELSE NULL END)}&#10;//ELSEIF [Date Granularity] = &quot;Daily&quot; THEN  {FIXED: MAX(IF [Time Granularity] = &quot;daily&quot; THEN (IF [Date] &gt;= [Current Date] THEN NULL ELSE [Date] END) ELSE NULL END)}&#10;//ELSEIF [Date Granularity] = &quot;Weekly&quot; THEN  {FIXED: MAX(IF [Time Granularity] = &quot;weekly&quot; THEN (IF [Date] &gt;= [Current Date] THEN NULL ELSE [Date] END) ELSE NULL END)}&#10;&#10;//END&#10;&#10;&#10;IF [Parameters].[Dimension B (copy)] = &quot;Monthly&quot; THEN [time_granularity] = &quot;monthly&quot; AND DATEDIFF(&apos;month&apos;, [date], [Calculation_6057271171717185540]) IN (0,1)&#10;ELSEIF [Parameters].[Dimension B (copy)] = &quot;Weekly&quot; THEN [time_granularity] = &quot;weekly&quot; AND DATEDIFF(&apos;week&apos;, [date], [Calculation_6057271171717185540]) IN (0,1)&#10;ELSEIF [Parameters].[Dimension B (copy)] = &quot;Daily&quot; THEN [time_granularity] = &quot;daily&quot; AND DATEDIFF(&apos;day&apos;, [date], [Calculation_6057271171717185540]) IN (0,1)&#10;END' />
      </column>
      <column caption='Previous Date' datatype='datetime' name='[Calculation_6057271171727650823]' role='dimension' type='ordinal'>
