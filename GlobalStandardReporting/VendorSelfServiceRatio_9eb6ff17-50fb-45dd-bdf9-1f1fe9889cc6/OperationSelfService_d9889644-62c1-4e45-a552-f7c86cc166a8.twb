      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_A7B6F1AF73504CFEBD16C4AFFD5C6241'>
            <properties context=''>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Custom SQL Query].[global_entity_id]' />
                    <expression op='[_growth_tableau_user_entitlements].[global_entity_id]' />
                  </expression>
                </clause>
                <relation connection='bigquery.1segw0v0dsod4y14mfakj1qa0lio' name='Custom SQL Query' type='text'>-- provide the change logs in salesforce
WITH sf_contact_change AS (
    SELECT
        PARSE_DATE(&apos;%Y-%m-%d&apos;, FORMAT_DATE(&apos;%Y-%m-%d&apos; ,DATE_TRUNC(createddate, DAY))) request_date
        ,global_entity_id
        ,createdbyid
        ,field
        ,COUNT(*) total_changes
        ,&apos;Contact Details&apos; change_category
    FROM `fulfillment-dwh-production.curated_data_shared_salesforce.contact_history`
    WHERE TRUE
        AND field IN (&apos;Email&apos;, &apos;MobilePhone&apos;, &apos;Phone&apos;)
    GROUP BY 1,2,3,4
)
, sf_bank_change AS (
    SELECT
      PARSE_DATE(&apos;%Y-%m-%d&apos;, FORMAT_DATE(&apos;%Y-%m-%d&apos; ,DATE_TRUNC(createddate, DAY))) request_date
      ,global_entity_id
      ,createdbyid
      ,field
      ,COUNT(*) total_changes
      ,&apos;Bank Details&apos; change_category
    FROM `fulfillment-dwh-production.curated_data_shared_salesforce.bank_detail_history_metrics` 
    WHERE TRUE
    GROUP BY 1,2,3,4
)
, total_changes_union AS (
    SELECT * FROM sf_contact_change
    UNION ALL
    SELECT * FROM sf_bank_change
)
-- provides the change request origin in salesforce
, case_origin_id AS (
  SELECT 
    content.origin
    ,content.modified_salesforce_user_id
    ,global_entity_id
    ,content.action
    ,COUNT(*)
  FROM `fulfillment-dwh-production.curated_data_shared_data_stream.salesforce_vendor_case_stream`
  GROUP BY 1,2,3,4
)
, entity AS (
    SELECT 
    management_entity
    ,segment
    ,global_entity_id
    ,brand
    ,country_name
    FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities`
)
SELECT
  request_date
  ,total_changes_union.global_entity_id
  ,management_entity
  ,segment
  ,brand
  ,country_name
  ,field
  ,total_changes
  ,change_category
  ,origin
  ,CASE
    WHEN origin IN (&apos;Facebook&apos;, &apos;Twitter&apos;, &apos;Social Media&apos;, &apos;Instagram&apos;) THEN &apos;Social Media&apos;
    WHEN origin IN (&apos;Call Center&apos;, &apos;Customer Care&apos;, &apos;Chat&apos;, &apos;Helpcenter&apos;, &apos;GodroidHelpcenter&apos;, &apos;VendorHelpcenter&apos;) THEN &apos;Help Center&apos;
    WHEN origin IN (&apos;Chat&apos;, &apos;Freshchat&apos;) THEN &apos;Chat&apos;
    WHEN origin IN (&apos;Phone&apos;) THEN &apos;Phone&apos;
    WHEN origin IN (&apos;Sales&apos;) THEN &apos;Sales Person&apos;
    WHEN origin IN (&apos;VendorPortal&apos;) THEN &apos;Vendor Portal&apos;
    WHEN origin IN (&apos;Email&apos;) THEN &apos;Email&apos;
    ELSE &apos;Others&apos;
  END origin_category
  ,CASE
      WHEN origin = &apos;VendorPortal&apos; THEN &apos;Portal Self-Service&apos;
      ELSE &apos;Non-Portal&apos;
  END change_type
  ,action
FROM total_changes_union
  LEFT JOIN case_origin_id
    ON total_changes_union.createdbyid = case_origin_id.modified_salesforce_user_id
  LEFT JOIN entity
    ON total_changes_union.global_entity_id = entity.global_entity_id
WHERE request_date &gt;&gt;= &apos;2022-12-01&apos;</relation>
                <relation connection='bigquery.1segw0v0dsod4y14mfakj1qa0lio' name='_growth_tableau_user_entitlements' table='[fulfillment-dwh-production.rl_vendor].[_growth_tableau_user_entitlements]' type='table' />
              </relation>
            </properties>
            <properties context='extract'>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Custom SQL Query].[global_entity_id]' />
                    <expression op='[_growth_tableau_user_entitlements].[global_entity_id]' />
                  </expression>
                </clause>
                <relation name='Custom SQL Query' table='[Extract].[Custom SQL Query]' type='table' />
                <relation name='_growth_tableau_user_entitlements' table='[Extract].[_growth_tableau_user_entitlements]' type='table' />
              </relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
