      <aliases enabled='yes' />
      <column caption='% Restaurant Tab Clicks' datatype='real' name='[% Contact Details Tab Clicks (copy)_5057190569790656512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([account_settings_users_restaurant_tab_clicked])/SUM([account_settings_users_page_loaded])' />
      </column>
      <column caption='% Delivery Area Tab Clicks ' datatype='real' name='[% Restaurant Tab Clicks (copy) (copy)_5057190569790951425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([account_settings_users_delivery_area_tab_clicked])/SUM([account_settings_users_page_loaded])' />
      </column>
      <column caption='Contact Update Success %' datatype='real' name='[Calculation_1379297792102572032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([users_contact_success])/SUM([users_contact_save_button_clicked])' />
      </column>
      <column caption='Bank Update Success %' datatype='real' name='[Calculation_1379297792111165442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([users_bank_success])/SUM([users_bank_clicked_save_button])' />
      </column>
      <column caption='Bank Update Fail %' datatype='real' name='[Calculation_1379297792112410627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([users_bank_fail])/SUM([users_bank_clicked_save_button])' />
      </column>
      <column caption='Contact Update Fail %' datatype='real' name='[Calculation_1379297792123011076]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([users_contact_fail])/SUM([users_contact_save_button_clicked])' />
      </column>
      <column caption='Plugin Penetration %' datatype='real' name='[Calculation_1379297792136335366]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([account_settings_users_page_loaded])/SUM([total_portal_users])' />
      </column>
      <column caption='% Bank Details Tab Clicks' datatype='real' name='[Calculation_2137943223262801920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([account_settings_users_billing_tab_clicked])/SUM([account_settings_users_page_loaded])' />
      </column>
      <column caption='% Contact Details Tab Clicks' datatype='real' name='[Calculation_2137943223263080449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([account_settings_users_contact_tab_clicked])/SUM([account_settings_users_page_loaded])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_2677882564481806336]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='Last Month?' datatype='boolean' name='[Calculation_5659828494343004160]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,{MAX(DATETRUNC(&apos;month&apos;,[period]))},DATETRUNC(&apos;month&apos;,[period])) = -1' />
      </column>
      <column caption='Contact OR Branch Contact Updated Success' datatype='integer' name='[Calculation_5800636358411784194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[users_contact_success] + [users_branch_contact_success]' />
      </column>
      <column caption='Branch Contact Update Fail %' datatype='real' default-format='p0.00%' name='[Calculation_589197544320417792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([users_branch_contact_fail])/sum([users_branch_contact_save_clicked])' />
      </column>
      <column caption='Branch Contact Update Success %' datatype='real' default-format='p0.00%' name='[Contact Update Success % (copy)_933089579452784640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([users_branch_contact_success])/SUM([users_branch_contact_save_clicked])' />
      </column>
      <column caption='Previous Month?' datatype='boolean' name='[Last Month? (copy)_5659828494351065089]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,{MAX(DATETRUNC(&apos;month&apos;,[period]))},DATETRUNC(&apos;month&apos;,[period])) = -2' />
      </column>
      <column caption='This Month?' datatype='boolean' name='[Last Month? (copy)_5800636358398431233]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,{MAX(DATETRUNC(&apos;month&apos;,[period]))},DATETRUNC(&apos;month&apos;,[period])) = 0' />
      </column>
