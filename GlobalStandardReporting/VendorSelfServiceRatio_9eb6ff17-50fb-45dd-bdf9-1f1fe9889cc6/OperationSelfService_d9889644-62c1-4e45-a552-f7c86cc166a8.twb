  <datasources>
    <datasource caption='Salesforce Bank Details Change Requests by Origin' inline='true' name='federated.0abe2761jr1hke1eo0fnq102umdp' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.05lkpa71kgu0uq1dry9nz01f9sib'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhh-ncr-live' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='rl_vendor' server-oauth='' username='dilys.ong@foodpanda.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[Custom SQL Query].[global_entity_id]' />
              <expression op='[_growth_tableau_user_entitlements].[global_entity_id]' />
            </expression>
          </clause>
          <relation connection='bigquery.05lkpa71kgu0uq1dry9nz01f9sib' name='Custom SQL Query' type='text'>WITH sf_bank_change AS (
    SELECT
      PARSE_DATE(&apos;%Y-%m-%d&apos;, FORMAT_DATE(&apos;%Y-%m-%d&apos; ,DATE_TRUNC(createddate, DAY))) request_date
      ,global_entity_id
      ,createdbyid
      ,COUNT(*) total_bank_details_change_requests
      ,COUNT(CASE WHEN field = &apos;Bank_Account_Owner__c&apos; THEN id END) bank_details_account_owner_change
      ,COUNT(CASE WHEN field = &apos;Name&apos; THEN id END) bank_details_name_change
    FROM `fulfillment-dwh-production.curated_data_shared_salesforce.bank_detail_history_metrics` 
    WHERE TRUE
    --   AND global_entity_id = &apos;FP_PH&apos;
    --   AND FORMAT_DATE(&apos;%Y-%m-%d&apos; ,DATE_TRUNC(createddate, DAY)) &gt;&gt;= &apos;2022-03-01&apos;
    GROUP BY 1,2,3
)
, case_origin_id AS (
  SELECT 
    content.origin
    ,content.modified_salesforce_user_id
    ,global_entity_id
    ,content.action
    ,COUNT(*)
  FROM `fulfillment-dwh-production.curated_data_shared_data_stream.salesforce_vendor_case_stream`
  -- WHERE content.origin = &apos;VendorPortal&apos;
  GROUP BY 1,2,3,4
)
, entity AS (
    SELECT 
    management_entity
    ,segment
    ,global_entity_id
    ,brand
    ,country_name
    FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities`
)

SELECT
  request_date
  ,sf_bank_change.global_entity_id
  ,management_entity
  ,segment
  ,brand
  ,country_name
  ,createdbyid
  ,total_bank_details_change_requests
  ,bank_details_account_owner_change
  ,bank_details_name_change
  ,origin
  ,CASE
      WHEN origin = &apos;VendorPortal&apos; THEN &apos;Portal Self-Service&apos;
      ELSE &apos;Non-Portal&apos;
  END change_type
  ,action
FROM sf_bank_change
  LEFT JOIN case_origin_id
    ON sf_bank_change.createdbyid = case_origin_id.modified_salesforce_user_id
  LEFT JOIN entity
    ON sf_bank_change.global_entity_id = entity.global_entity_id
WHERE request_date &gt;&gt;= &apos;2023-01-01&apos;</relation>
          <relation connection='bigquery.05lkpa71kgu0uq1dry9nz01f9sib' name='_growth_tableau_user_entitlements' table='[fulfillment-dwh-production.rl_vendor].[_growth_tableau_user_entitlements]' type='table' />
        </_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
