          <relation connection='bigquery.1xnj8zt0l5j6ka16ha2hc0ktg3oq' name='Custom SQL Query' type='text'>with sessions as
(SELECT fielddate,user_id,global_entity_id,
MAX(CASE WHEN new_event in (&apos;stngs_account_settings___page_load&apos;,&apos;stngs_account_settings_delivery_areas_selection__page_load&apos;, &apos;stngs_account_settings_confirmation_modal__page_load&apos;  )  THEN TRUE ELSE FALSE END) is_settings_page_loaded,
MAX(CASE WHEN new_event= &apos;stngs_account_settings.main__billing_and_payment_tab_open&apos; THEN TRUE ELSE FALSE END) is_billing_tab_clicked,
MAX(CASE WHEN new_event in (&apos;stngs_account_settings__contact_details_tab_open&apos;, &apos;stngs_account_settings_confirmation_modal_contact_details_tab_open&apos;) THEN TRUE ELSE FALSE END) is_contact_tab_clicked,
MAX(CASE WHEN new_event in (&apos;stngs_account_settings__delivery_areas_tab_open&apos;, &apos;stngs_account_settings_delivery_areas_selection_delivery_areas_tab_open&apos;) THEN TRUE ELSE FALSE END) is_delivery_area_tab_clicked,
MAX(CASE WHEN new_event =&apos;stngs_account_settings.main__restaurant_details_tab_open&apos; THEN TRUE ELSE FALSE END) is_restaurant_tab_clicked,
---------tab details------------
MAX(CASE WHEN new_event in (&apos;stngs_individual_contact_details___page_load&apos;,&apos;stngs_individual_contact_details_confirmation_modal__page_load&apos;)
THEN TRUE ELSE FALSE END) is_contact_details_page_loaded,
MAX(CASE WHEN new_event in (&apos;stngs_individual_contact_details__save_changes_button_tap&apos;,&apos;stngs_individual_contact_details_confirmation_modal_save_changes_button_tap&apos;) THEN TRUE ELSE FALSE END) is_contact_save_button_clicked,
MAX(CASE WHEN new_event in (&apos;stngs_individual_contact_details__confirmation_modal_modal_open&apos;,&apos;stngs_individual_contact_details_confirmation_modal_confirmation_modal_modal_open&apos;) THEN TRUE ELSE FALSE END) is_contact_confirmation_modal_loaded,
MAX(CASE WHEN new_event in (&apos;stngs_individual_contact_details_confirmation_modal_confirm_button_tap&apos;,&apos;stngs_individual_contact_details__confirm_button_tap&apos;) THEN TRUE ELSE FALSE END) is_contact_confirmation_button_clicked,
MAX(CASE WHEN new_event in (&apos;stngs_individual_contact_details_confirmation_modal_form_submission_success_success&apos;, &apos;stngs_individual_contact_details__form_submission_success_success&apos;)
THEN TRUE ELSE FALSE END) is_contact_update_success,
MAX(CASE WHEN new_event in (&apos;stngs_individual_contact_details_confirmation_modal_form_submission_failed_failed&apos;, &apos;stngs_individual_contact_details__form_submission_failed_failed&apos;)
THEN TRUE ELSE FALSE END) is_contact_update_fail,
MAX(CASE WHEN new_event in (&apos;stngs_individual_contact_details__reset_button_tap&apos;, &apos;stngs_individual_contact_details_confirmation_modal_reset_button_tap&apos;) THEN TRUE ELSE FALSE END) is_contact_reset_button_clicked,
MAX(CASE WHEN new_event in (&apos;stngs_branch_contact_details___page_load&apos;, &apos;stngs_branch_contact_details_confirmation_modal__page_load&apos;) THEN TRUE ELSE FALSE END) is_branch_contact_edit_button_clicked, --?
MAX(CASE WHEN new_event in (&apos;stngs_branch_contact_details__save_changes_button_tap&apos;, &apos;stngs_branch_contact_details_confirmation_modal_save_changes_button_tap&apos;) THEN TRUE ELSE FALSE END) is_branch_contact_save_button_clicked,
MAX(CASE WHEN new_event in (&apos;stngs_branch_contact_details__confirmation_modal_modal_open&apos;, &apos;stngs_branch_contact_details_confirmation_modal_confirmation_modal_modal_open&apos;) THEN TRUE ELSE FALSE END) is_branch_contact_confirmation_modal_loaded, 
MAX(CASE WHEN new_event in (&apos;stngs_branch_contact_details_confirmation_modal_confirm_button_tap&apos;, &apos;stngs_branch_contact_details__confirm_button_tap&apos;) THEN TRUE ELSE FALSE END) is_branch_contact_confirmation_button_clicked,
MAX(CASE WHEN new_event in (&apos;stngs_branch_contact_details_confirmation_modal_form_submission_success_success&apos;, &apos;stngs_branch_contact_details__form_submission_success_success&apos;) THEN TRUE ELSE FALSE END) is_branch_contact_update_success,
MAX(CASE WHEN new_event in (&apos;stngs_branch_contact_details_confirmation_modal_form_submission_failed_request_fail&apos;, &apos;stngs_branch_contact_details__form_submission_failed_failed&apos;) THEN TRUE ELSE FALSE END) is_branch_contact_update_fail,
MAX(CASE WHEN new_event in (&apos;stngs_branch_contact_details__reset_button_tap&apos;, &apos;stngs_branch_contact_details_confirmation_modal_reset_button_tap&apos;) THEN TRUE ELSE FALSE END) is_branch_contact_reset_button_clicked,
MAX(CASE WHEN new_event in (&apos;stngs_billing_and_payment__update_bank_details_button_tap&apos;, &apos;stngs_billing_and_payment_confirmation_modal_update_bank_details_button_tap&apos;) THEN TRUE ELSE FALSE END) is_bank_details_edit_button_clicked,
MAX(CASE WHEN new_event in (&apos;stngs_update_bank_details___page_load&apos;, &apos;stngs_update_bank_details_confirmation_modal__page_load&apos;) THEN TRUE ELSE FALSE END) is_bank_details_page_loaded,
MAX(CASE WHEN new_event in (&apos;stngs_billing_and_payment__save_bank_details_button_tap&apos;, &apos;stngs_billing_and_payment_confirmation_modal_save_bank_details_button_tap&apos;) THEN TRUE ELSE FALSE END) is_bank_save_button_clicked,
MAX(CASE WHEN new_event in (&apos;stngs_update_bank_details__confirmation_modal_modal_open&apos;, &apos;stngs_update_bank_details_confirmation_modal_confirmation_modal_modal_open&apos;) THEN TRUE ELSE FALSE END) is_bank_confirmation_loaded,
MAX(CASE WHEN new_event in (&apos;stngs_update_bank_details_confirmation_modal_confirm_button_tap&apos;) THEN TRUE ELSE FALSE END) is_bank_confirmation_clicked,
MAX(CASE WHEN new_event in (&apos;stngs_update_bank_details_confirmation_modal_form_submission_success_request_success&apos;, &apos;stngs_update_bank_details__form_submission_success_request_success&apos;) THEN TRUE ELSE FALSE END) is_bank_update_success,
MAX(CASE WHEN new_event in (&apos;stngs_update_bank_details_confirmation_modal_form_submission_failed_request_fail&apos;, &apos;stngs_update_bank_details__form_submission_failed_request_fail&apos;) THEN TRUE ELSE FALSE END) is_bank_update_fail,
MAX(CASE WHEN new_event in (&apos;stngs_billing_and_payment__reset_bank_details_button_tap&apos;, &apos;stngs_billing_and_payment_confirmation_modal_reset_bank_details_button_tap&apos;) THEN TRUE ELSE FALSE END) is_bank_reset_button_clicked,
FROM `fulfillment-dwh-production.cl_sales_revenue.vp_ga_stngs_fct_table` 
WHERE fielddate &gt;&gt;= &apos;2023-06-01&apos;
group by 1,2,3)

, entity AS (
