MAX(CASE WHEN new_event in (&apos;stngs_update_bank_details__confirmation_modal_modal_open&apos;, &apos;stngs_update_bank_details_confirmation_modal_confirmation_modal_modal_open&apos;) THEN TRUE ELSE FALSE END) is_bank_confirmation_loaded,
MAX(CASE WHEN new_event in (&apos;stngs_update_bank_details_confirmation_modal_confirm_button_tap&apos;) THEN TRUE ELSE FALSE END) is_bank_confirmation_clicked,
MAX(CASE WHEN new_event in (&apos;stngs_update_bank_details_confirmation_modal_form_submission_success_request_success&apos;, &apos;stngs_update_bank_details__form_submission_success_request_success&apos;) THEN TRUE ELSE FALSE END) is_bank_update_success,
MAX(CASE WHEN new_event in (&apos;stngs_update_bank_details_confirmation_modal_form_submission_failed_request_fail&apos;, &apos;stngs_update_bank_details__form_submission_failed_request_fail&apos;) THEN TRUE ELSE FALSE END) is_bank_update_fail,
MAX(CASE WHEN new_event in (&apos;stngs_billing_and_payment__reset_bank_details_button_tap&apos;, &apos;stngs_billing_and_payment_confirmation_modal_reset_bank_details_button_tap&apos;) THEN TRUE ELSE FALSE END) is_bank_reset_button_clicked,
FROM `fulfillment-dwh-production.cl_sales_revenue.vp_ga_stngs_fct_table` 
WHERE fielddate &gt;&gt;= &apos;2023-06-01&apos;
group by 1,2,3,4) as q
left join (SELECT 
concat(global_entity_id,&quot;;&quot;,vendor_id) as vendor_id,
vertical_type,
max(case when cast(delivery_types AS string) like &quot;%platform_delivery%&quot; then &apos;platform_delivery&apos;
      when cast(delivery_types AS string)  like &quot;%vendor_delivery%&quot; then &apos;vendor_delivery&apos;
      end) delivery_types,
max(case when cast(delivery_types AS string)  like &quot;%pickup%&quot; then &apos;pickup&apos;
      else null end) is_pickup
FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.vendors`,
unnest(delivery_types) as delivery_types
where concat(global_entity_id,&quot;;&quot;,vendor_id) is not null
group by 1,2) as v on q.selected_vendor_id_param=v.vendor_id
where is_settings_page_loaded is true)

, entity AS (
    SELECT 
        management_entity
        ,segment
        ,global_entity_id
        ,brand
        ,country_name
    FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities`
    WHERE is_platform_online = TRUE
),

daily AS (
    SELECT 
        fielddate period
        ,&apos;Daily&apos; time_interval
        ,global_entity_id
        ,vertical_type,delivery_types,is_pickup
        ,COUNT(DISTINCT user_id) total_portal_users
        ,COUNT(DISTINCT CASE WHEN is_settings_page_loaded = TRUE THEN user_id END) account_settings_users_page_loaded
        ,COUNT(DISTINCT CASE WHEN is_billing_tab_clicked = TRUE THEN user_id END) account_settings_users_billing_tab_clicked
        ,COUNT(DISTINCT CASE WHEN is_contact_tab_clicked = TRUE THEN user_id END) account_settings_users_contact_tab_clicked
