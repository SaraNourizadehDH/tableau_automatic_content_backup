          <relation connection='bigquery.0ahh3ut1w35dot150enyk1ggjh5i' name='Custom SQL Query' type='text'>-- provide the change logs in salesforce
WITH sf_contact_change AS (
    SELECT
        PARSE_DATE(&apos;%Y-%m-%d&apos;, FORMAT_DATE(&apos;%Y-%m-%d&apos; ,DATE_TRUNC(createddate, DAY))) request_date
        ,global_entity_id
        ,createdbyid
        ,COUNT(*) total_contact_details_changes
        ,COUNT(CASE WHEN field = &apos;FirstName&apos; THEN id END) first_name_changes
        ,COUNT(CASE WHEN field = &apos;LastName&apos; THEN id END) last_name_changes
        ,COUNT(CASE WHEN field = &apos;MiddleName&apos; THEN id END) middle_name_changes
        ,COUNT(CASE WHEN field = &apos;Salutation&apos; THEN id END) salutation_changes
        ,COUNT(CASE WHEN field = &apos;Email&apos; THEN id END) email_changes
        ,COUNT(CASE WHEN field = &apos;MobilePhone&apos; THEN id END) mobile_phone_changes
        ,COUNT(CASE WHEN field = &apos;Phone&apos; THEN id END) phone_changes
        ,COUNT(CASE WHEN field = &apos;OtherPhone&apos; THEN id END) other_phone_changes
    FROM `fulfillment-dwh-production.curated_data_shared_salesforce.contact_history`
    WHERE TRUE
        -- AND global_entity_id = &apos;FP_PH&apos;
        -- AND FORMAT_DATE(&apos;%Y-%m-%d&apos; ,DATE_TRUNC(createddate, DAY)) &gt;&gt;= &apos;2022-03-01&apos;
        AND field NOT IN (&apos;Owner&apos;, &apos;created&apos;, &apos;contactCreatedFromLead&apos;, &apos;Contact_Role__c&apos;, &apos;Account&apos;)
    GROUP BY 1,2,3
)
-- provides the change request origin in salesforce
, case_origin_id AS (
  SELECT 
    content.origin
    ,content.modified_salesforce_user_id
    ,global_entity_id
    ,content.action
    ,COUNT(*)
  FROM `fulfillment-dwh-production.curated_data_shared_data_stream.salesforce_vendor_case_stream`
  GROUP BY 1,2,3,4
)
, entity AS (
    SELECT 
    management_entity
    ,segment
    ,global_entity_id
    ,brand
    ,country_name
    FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities`
)
SELECT
  request_date
  ,sf_contact_change.global_entity_id
  ,createdbyid
  ,total_contact_details_changes
  ,first_name_changes
  ,last_name_changes
  ,middle_name_changes
  ,salutation_changes
  ,email_changes
  ,mobile_phone_changes
  ,phone_changes
  ,other_phone_changes
  ,origin
  ,CASE
      WHEN origin = &apos;VendorPortal&apos; THEN &apos;Portal Self-Service&apos;
      ELSE &apos;Non-Portal&apos;
  END change_type
  ,action
FROM sf_contact_change
  LEFT JOIN case_origin_id
    ON sf_contact_change.createdbyid = case_origin_id.modified_salesforce_user_id
  LEFT JOIN entity
    ON sf_contact_change.global_entity_id = entity.global_entity_id
WHERE request_date &gt;&gt;= &apos;2022-12-01&apos;</relation>
