      <aliases enabled='yes' />
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_2677882564482162691]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='This Month?' datatype='boolean' name='[Calculation_5800636358422966275]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,{MAX(DATETRUNC(&apos;month&apos;,[request_date]))},DATETRUNC(&apos;month&apos;,[request_date])) = 0' />
      </column>
      <column caption='Self-Service Changes' datatype='integer' name='[Calculation_6906058955837067264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [change_type] = &apos;Portal Self-Service&apos; THEN [total_changes]ELSE 0 END)' />
      </column>
      <column caption='% Self-Service' datatype='real' name='[Calculation_6906058955838066689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6906058955837067264]/SUM([total_changes])' />
      </column>
