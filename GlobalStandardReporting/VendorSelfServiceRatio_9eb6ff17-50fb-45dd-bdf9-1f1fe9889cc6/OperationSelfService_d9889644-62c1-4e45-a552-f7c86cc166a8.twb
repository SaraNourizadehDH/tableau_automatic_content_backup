SELECT
    entity.management_entity
    ,entity.segment
    ,entity.brand
    ,entity.country_name
    ,RANK() OVER (PARTITION BY 
        union_sessions.time_interval
        ,entity.management_entity
        ,entity.segment
        ,union_sessions.global_entity_id
        ,entity.brand
        ,entity.country_name ORDER BY period) period_rank
    ,union_sessions.*
FROM (
    SELECT * FROM daily
    UNION ALL
    SELECT * FROM weekly
    UNION ALL
    SELECT * FROM monthly
    UNION ALL
    SELECT * FROM quarterly
) union_sessions
LEFT JOIN entity
    ON union_sessions.global_entity_id = entity.global_entity_id</relation>
          <relation connection='bigquery.1xnj8zt0l5j6ka16ha2hc0ktg3oq' name='_growth_tableau_user_entitlements' table='[fulfillment-dwh-production.rl_vendor].[_growth_tableau_user_entitlements]' type='table' />
