              <aliases>
                <alias key='1' value='Day' />
                <alias key='2' value='Week' />
                <alias key='3' value='Month' />
                <alias key='4' value='Quarter' />
              </aliases>
            </column>
            <column caption='VSSR Split By' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;By Brand Name&quot;'>
              <calculation class='tableau' formula='&quot;By Brand Name&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13fe70h0a2apnh0zxekb012m7vjy'>
            <column caption='% Non-Automation - Vendor Changes' datatype='real' name='[# Non-Automation - Vendor Changes (copy)_399131548562259977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [automation_group] = &apos;NON-AUTOMATION&apos; AND [persona] = &apos;vendor&apos; THEN [events] ELSE 0 END)&#10;/&#10;SUM(IF [automation_group] = &apos;NON-AUTOMATION&apos; THEN [events] ELSE 0 END)' />
            </column>
            <column caption='# Non-Automation - Vendor Changes' datatype='integer' name='[# Non-Automation Changes (copy)_399131548562173960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [automation_group] = &apos;NON-AUTOMATION&apos; AND [persona] = &apos;vendor&apos; THEN [events] ELSE 0 END)' />
            </column>
            <column caption='Line Dimension' datatype='string' name='[Calculation_2823616272723992577]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;  WHEN &apos;Overall&apos; THEN &apos;Overall&apos;&#10;  WHEN &apos;By Operation Type&apos; THEN [operation_type]&#10;  WHEN &apos;By Offline Reason&apos; THEN [offline_reason]&#10;  WHEN &apos;By Brand Name&apos; THEN [brand_name]&#10;END' />
            </column>
            <column caption='# Non-Automation Changes' datatype='integer' name='[Calculation_399131548561588230]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [automation_group] = &apos;NON-AUTOMATION&apos; THEN [events] ELSE 0 END)' />
            </column>
            <column caption='TG - VSSR Evolution' datatype='string' name='[Calculation_399131548573265934]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN 1 THEN STR([created_date])&#10;  WHEN 2 THEN [created_week]&#10;  WHEN 3 THEN [created_month]&#10;  WHEN 4 THEN [created_quarter]&#10;END' />
