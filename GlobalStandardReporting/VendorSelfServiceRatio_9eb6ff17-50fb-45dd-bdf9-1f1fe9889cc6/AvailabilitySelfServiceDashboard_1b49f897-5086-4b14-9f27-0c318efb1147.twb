    <worksheet name='Custom Tabular View'>
      <table>
        <view>
          <datasources>
            <datasource caption='growth_availability_vssr+ (rl_vendor)' name='federated.13fe70h0a2apnh0zxekb012m7vjy' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Events - Dimension B' datatype='string' name='[Events - Dimension A (copy)_399131548576399377]' param-domain-type='list' role='measure' type='nominal' value='&quot;Offline Reason&quot;'>
              <calculation class='tableau' formula='&quot;Offline Reason&quot;' />
            </column>
            <column alias='Week' caption='Time Granularity - VSSR Evolution' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='Day' />
                <alias key='2' value='Week' />
                <alias key='3' value='Month' />
                <alias key='4' value='Quarter' />
              </aliases>
            </column>
            <column caption='Events - Dimension A' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Persona&quot;'>
              <calculation class='tableau' formula='&quot;Persona&quot;' />
            </column>
            <column caption='Events Table Metric' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;\# Events&quot;'>
              <calculation class='tableau' formula='&quot;# Events&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.13fe70h0a2apnh0zxekb012m7vjy'>
            <column caption='% Non-Automation - Vendor Changes' datatype='real' name='[# Non-Automation - Vendor Changes (copy)_399131548562259977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [automation_group] = &apos;NON-AUTOMATION&apos; AND [persona] = &apos;vendor&apos; THEN [events] ELSE 0 END)&#10;/&#10;SUM(IF [automation_group] = &apos;NON-AUTOMATION&apos; THEN [events] ELSE 0 END)' />
            </column>
            <column caption='TG - VSSR Evolution' datatype='string' name='[Calculation_399131548573265934]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN 1 THEN STR([created_date])&#10;  WHEN 2 THEN [created_week]&#10;  WHEN 3 THEN [created_month]&#10;  WHEN 4 THEN [created_quarter]&#10;END' />
            </column>
            <column caption='Dimension A' datatype='string' name='[Calculation_399131548575666191]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;  WHEN &apos;Overall&apos; THEN &apos;&apos;&#10;  WHEN &apos;Region&apos; THEN [region]&#10;  WHEN &apos;Country Name&apos; THEN [country_name]&#10;  WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;  WHEN &apos;Entity ID&apos; THEN [entity_id]&#10;  WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;  WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;  WHEN &apos;Client Name&apos; THEN [client_name]&#10;  WHEN &apos;POS Integration Type&apos; THEN [pos_integration_type]&#10;  WHEN &apos;Automation Group&apos; THEN [automation_group]&#10;  WHEN &apos;Persona&apos; THEN [persona]&#10;  WHEN &apos;Operation Type&apos; THEN [operation_type]&#10;  WHEN &apos;Offline Reason&apos; THEN [offline_reason]&#10;END' />
            </column>
            <column caption='Table Metric' datatype='real' name='[Calculation_399131548576874514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;  WHEN &apos;# Events&apos; THEN -SUM([events])&#10;  WHEN &apos;% Vendor Self-Service Ratio (VSSR)&apos; THEN [# Non-Automation - Vendor Changes (copy)_399131548562259977]&#10;END' />
            </column>
            <column caption='Table Metric KPI - To Display' datatype='string' name='[Calculation_399131548577447957]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
            </column>
            <column caption='Table Metric abs' datatype='real' name='[Calculation_399131548580270102]' role='measure' type='quantitative'>
