  <worksheets>
    <worksheet name='Price Analysis Per Category - Noon App'>
      <repository-location id='PriceAnalysisPerCategory-NoonApp' path='/t/GlobalStandardReporting/workbooks/Tableau_mapping_Noon_App_16099242379630' revision='' site='GlobalStandardReporting' />
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Price Analysis Per Category - Noon App</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='good_noon_app_matches (Tableau_Report_Noon_App_Matching)' name='federated.1bwl1al17vmtkx19ma37w1vaqf2j' />
          </datasources>
          <datasource-dependencies datasource='federated.1bwl1al17vmtkx19ma37w1vaqf2j'>
            <column caption='% difference' datatype='real' default-format='C1031%' name='[Calculation_91901645143265280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg([dh_price_lc])/avg([Noon_price])-1' />
            </column>
            <column caption='price difference' datatype='real' datatype-customized='true' name='[Calculation_91901645144489985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg([dh_price_lc])-avg([Noon_price])' />
            </column>
            <column caption='Color Coding ' datatype='string' name='[Calculation_91901645145444354]' role='measure' type='nominal'>
