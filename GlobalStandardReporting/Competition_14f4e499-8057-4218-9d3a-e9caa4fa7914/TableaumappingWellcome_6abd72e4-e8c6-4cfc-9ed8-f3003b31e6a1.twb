  <worksheets>
    <worksheet name='Price Analysis Per Category - Wellcome (2)'>
      <repository-location id='PriceAnalysisPerCategory-Wellcome2' path='/t/GlobalStandardReporting/workbooks/Tableau_mapping_Wellcome' revision='' site='GlobalStandardReporting' />
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Price Analysis Per Category - Wellcome</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='wellcome_Matched (Tableau_report_Wellcome_mapping)' name='federated.0dssca603is3wm1d2ndcd1cfqmsq' />
          </datasources>
          <datasource-dependencies datasource='federated.0dssca603is3wm1d2ndcd1cfqmsq'>
            <column caption='Price difference' datatype='real' name='[Calculation_62909661623050242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg([dh_price_lc])-avg([wellcome_price])' />
            </column>
            <column caption='%  Difference' datatype='real' name='[Calculation_62909661623250947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg([dh_price_lc])/avg([wellcome_price])-1' />
            </column>
            <column caption='color coding' datatype='string' name='[Calculation_62909661659410436]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ([Calculation_62909661623050242]) &gt; 0 THEN &apos;Expensive&apos; &#10;ELSEIF ([Calculation_62909661623050242]) = 0 THEN &apos;Equal Price&apos; &#10;ELSE &apos;Cheaper&apos; END' />
            </column>
            <column-instance column='[dh_price_lc]' derivation='Avg' name='[avg:dh_price_lc:qk]' pivot='key' type='quantitative' />
            <column-instance column='[wellcome_price]' derivation='Avg' name='[avg:wellcome_price:qk]' pivot='key' type='quantitative' />
            <column caption='Dh Brand Name' datatype='string' name='[dh_brand_name]' role='dimension' type='nominal' />
            <column caption='Dh Category Lvl1 Reporting' datatype='string' name='[dh_category_lvl1_reporting]' role='dimension' type='nominal' />
            <column caption='Dh Category Lvl2 Reporting' datatype='string' name='[dh_category_lvl2_reporting]' role='dimension' type='nominal' />
            <column caption='Dh Price Lc' datatype='real' name='[dh_price_lc]' role='measure' type='quantitative' />
