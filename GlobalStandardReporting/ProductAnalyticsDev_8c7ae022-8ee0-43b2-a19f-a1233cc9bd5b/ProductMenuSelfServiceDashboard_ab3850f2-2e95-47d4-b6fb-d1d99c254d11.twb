            <column caption='Key Account Sub Category' datatype='string' name='[key_account_sub_category]' role='dimension' type='nominal' />
            <column datatype='date' name='[month_start_date]' role='dimension' type='ordinal' />
            <column-instance column='[brand_name]' derivation='None' name='[none:brand_name:nk]' pivot='key' type='nominal' />
