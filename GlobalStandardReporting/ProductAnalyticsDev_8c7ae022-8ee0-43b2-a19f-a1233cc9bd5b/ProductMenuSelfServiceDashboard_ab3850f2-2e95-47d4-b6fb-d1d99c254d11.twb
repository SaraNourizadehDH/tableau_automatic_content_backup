      <column caption='NonAutomation - Change Count' datatype='integer' name='[Calculation_2503016233852715008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_automation] = FALSE THEN [change_count] ELSE 0 END' />
      </column>
      <column caption='Automation - Platform' datatype='integer' name='[Calculation_3009389771621724160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_automation] = TRUE AND [author_group] = &quot;PLATFORM&quot; THEN [change_count] ELSE 0 END)' />
