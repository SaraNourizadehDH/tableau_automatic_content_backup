      <column caption='% Vendor Self Service Change WOW' datatype='real' name='[% Total Change WOW (copy)_3009389771962355724]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy 4)_5870582853879967750]&#10;WHEN &quot;Weekly&quot;&#10;// weekly calculation&#10;THEN &#10;    (SUM(IF ([Calculation_3009389771949772806] = [Calculation_4789507836007063552]) THEN [Calculation_3009389771962531853] ELSE 0 END)&#10;    /&#10;    SUM(IF ([Calculation_3009389771949772806] = [Calculation_4789507836007063552]) THEN [Calculation_2503016233852715008] ELSE 0 END))&#10;/&#10;    (SUM(IF ([Calculation_3009389771949772806] = ([Calculation_4789507836007063552] - 1 )) THEN [Calculation_3009389771962531853] ELSE 0 END)&#10;    /&#10;    SUM(IF ([Calculation_3009389771949772806] = ([Calculation_4789507836007063552] - 1 )) THEN [Calculation_2503016233852715008] ELSE 0 END))&#10;-1&#10;&#10;WHEN &quot;Monthly&quot;&#10;//monthly calculation&#10;THEN &#10;    (SUM(IF MONTH([month_start_date]) = [Calculation_4789507836007063552] THEN [Calculation_3009389771962531853] ELSE 0 END)&#10;    /&#10;    SUM(IF MONTH([month_start_date]) = ([Calculation_4789507836007063552] ) THEN [Calculation_2503016233852715008] ELSE 0 END))&#10;/&#10;    (SUM(IF MONTH([month_start_date]) = ([Calculation_4789507836007063552] - 1 ) THEN [Calculation_3009389771962531853] ELSE 0 END)&#10;    /&#10;    SUM(IF MONTH([month_start_date]) = ([Calculation_4789507836007063552] - 1 ) THEN [Calculation_2503016233852715008] ELSE 0 END))&#10;-1&#10;&#10;WHEN &quot;Quarterly&quot;&#10;//quarterly calculaton&#10;THEN &#10;    (SUM(IF QUARTER([quarter_start_date]) = [Calculation_4789507836007063552] THEN [Calculation_3009389771962531853] ELSE 0 END)&#10;    /&#10;    SUM(IF QUARTER([quarter_start_date]) = ([Calculation_4789507836007063552] ) THEN [Calculation_2503016233852715008] ELSE 0 END))&#10;/&#10;    (SUM(IF QUARTER([quarter_start_date]) = ([Calculation_4789507836007063552] - 1 ) THEN [Calculation_3009389771962531853] ELSE 0 END)&#10;    /&#10;    SUM(IF QUARTER([quarter_start_date]) = ([Calculation_4789507836007063552] - 1 ) THEN [Calculation_2503016233852715008] ELSE 0 END))&#10;-1&#10;END' />
      </column>
      <column caption='% VSSR - Update' datatype='real' name='[% VSSR - Availability  (copy)_4789507836076019715]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_self_service] = TRUE AND [operation_type] = &quot;Update&quot; THEN [change_count] ELSE 0 END)&#10;/&#10;SUM(IF [is_automation] = FALSE AND [operation_type] = &quot;Update&quot; THEN [change_count] ELSE 0 END)' />
      </column>
      <column caption='% VSSR - Create / Delete' datatype='real' name='[% VSSR - Update (copy)_4789507836078120964]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_self_service] = TRUE AND [operation_type] = &quot;Create / Delete&quot; THEN [change_count] ELSE 0 END)&#10;/&#10;SUM(IF [is_automation] = FALSE AND [operation_type] = &quot;Create / Delete&quot; THEN [change_count] ELSE 0 END)' />
      </column>
      <column caption='% VSSR - Availability ' datatype='real' name='[% Vendor Self Service (copy)_4789507836073525250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_self_service] = TRUE AND [operation_type] = &quot;Availability&quot; THEN [change_count] ELSE 0 END)&#10;/&#10;SUM(IF [is_automation] = FALSE AND [operation_type] = &quot;Availability&quot; THEN [change_count] ELSE 0 END)' />
