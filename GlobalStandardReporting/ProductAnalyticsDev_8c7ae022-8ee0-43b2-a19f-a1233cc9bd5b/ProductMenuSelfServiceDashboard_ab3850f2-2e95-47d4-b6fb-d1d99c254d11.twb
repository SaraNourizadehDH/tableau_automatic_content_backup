      <aliases enabled='yes' />
      <column caption='% Self Service Vendors' datatype='real' name='[Calculation_2503016233920741382]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([self_service_vendors])/ SUM([non_automation_vendors])' />
      </column>
      <column caption='_text_previous_week' datatype='string' name='[Calculation_2503016233937555463]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Weekly&quot; THEN  &quot;vs prior Week - CW&quot; + STR([Calculation_4789507836026777601]-1)&#10;WHEN &quot;Monthly&quot; THEN &quot;vs prior Month - M&quot;+STR([Calculation_4789507836026777601]-1)&#10;WHEN &quot;Quarterly&quot; THEN &quot;vs prior Quarter - Q&quot;+STR([Calculation_4789507836026777601]-1)&#10;END' />
      </column>
      <column caption='_text_Current Period' datatype='string' name='[Calculation_2503016233938456584]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Weekly&quot; THEN &apos;CW &apos;+STR([Calculation_4789507836026777601])&#10;WHEN &quot;Monthly&quot; THEN &apos;M &apos;+STR([Calculation_4789507836026777601])&#10;WHEN &quot;Quarterly&quot; THEN &apos;Q &apos;+STR([Calculation_4789507836026777601])&#10;END' />
      </column>
      <column caption='_date_filter' datatype='boolean' name='[Calculation_3009389772623286289]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Weekly&quot; THEN [date_granular] = &quot;Weekly&quot;&#10;WHEN &quot;Monthly&quot; THEN [date_granular] = &quot;Monthly&quot;&#10;WHEN &quot;Quarterly&quot; THEN [date_granular] = &quot;Quarterly&quot;&#10;WHEN &quot;Daily&quot; THEN [date_granular] = &quot;Daily&quot;&#10;END' />
      </column>
      <column caption='Self Service Vendors' datatype='integer' name='[Calculation_3009389772625805330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([self_service_vendors])' />
      </column>
      <column caption='Iso Week' datatype='integer' name='[Calculation_3009389773255036947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WEEK([created_date])' />
      </column>
      <column caption='_is_current period' datatype='boolean' name='[Calculation_3009389773260333076]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Weekly&quot; THEN ([Calculation_3009389773255036947] = [Calculation_4789507836026777601]) &#10;WHEN &quot;Monthly&quot; THEN (MONTH([created_date])=[Calculation_4789507836026777601])&#10;WHEN &quot;Quarterly&quot; THEN (QUARTER([created_date]) = [Calculation_4789507836026777601])&#10;END' />
      </column>
      <column caption='% Self Service Vendors WOW Change' datatype='real' name='[Calculation_3009389773266300950]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Weekly&quot;&#10;// weekly calculation&#10;THEN &#10;    (SUM(IF ([Calculation_3009389773255036947] = [Calculation_4789507836026777601]) THEN [self_service_vendors] ELSE 0 END)&#10;    /&#10;    SUM(IF ([Calculation_3009389773255036947] = [Calculation_4789507836026777601]) THEN [non_automation_vendors] ELSE 0 END))&#10;/&#10;    (SUM(IF ([Calculation_3009389773255036947] = ([Calculation_4789507836026777601] - 1 )) THEN [self_service_vendors] ELSE 0 END)&#10;    /&#10;    SUM(IF ([Calculation_3009389773255036947] = ([Calculation_4789507836026777601] - 1 )) THEN [non_automation_vendors] ELSE 0 END))&#10;-1&#10;&#10;WHEN &quot;Monthly&quot;&#10;//monthly calculation&#10;THEN &#10;    (SUM(IF MONTH([created_date]) = [Calculation_4789507836026777601] THEN [self_service_vendors] ELSE 0 END)&#10;    /&#10;    SUM(IF MONTH([created_date]) = ([Calculation_4789507836026777601] ) THEN [non_automation_vendors] ELSE 0 END))&#10;/&#10;    (SUM(IF MONTH([created_date]) = ([Calculation_4789507836026777601] - 1 ) THEN [self_service_vendors] ELSE 0 END)&#10;    /&#10;    SUM(IF MONTH([created_date]) = ([Calculation_4789507836026777601] - 1 ) THEN [non_automation_vendors] ELSE 0 END))&#10;-1&#10;&#10;WHEN &quot;Quarterly&quot;&#10;//quarterly calculaton&#10;THEN &#10;    (SUM(IF QUARTER([created_date]) = [Calculation_4789507836026777601] THEN [self_service_vendors] ELSE 0 END)&#10;    /&#10;    SUM(IF QUARTER([created_date]) = ([Calculation_4789507836026777601] ) THEN [non_automation_vendors] ELSE 0 END))&#10;/&#10;    (SUM(IF QUARTER([created_date]) = ([Calculation_4789507836026777601] - 1 ) THEN [self_service_vendors] ELSE 0 END)&#10;    /&#10;    SUM(IF QUARTER([created_date]) = ([Calculation_4789507836026777601] - 1 ) THEN [non_automation_vendors] ELSE 0 END))&#10;-1&#10;END' />
      </column>
      <column caption='Is Self Serivce Vendors WOW Change Positive?' datatype='boolean' name='[Calculation_3009389773267750935]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_3009389773266300950] &gt; 0' />
      </column>
      <column caption='_is_product_or_vendor_view' datatype='boolean' name='[Calculation_3009389773271777304]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)]&#10;WHEN &quot;Product&quot; THEN TRUE&#10;ELSE FALSE &#10;END' />
      </column>
      <column caption='Select Dimension' datatype='string' name='[Calculation_3009389773274329114]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;(All)&quot; THEN &quot;(All)&quot;&#10;WHEN &quot;Region&quot; THEN [region]&#10;WHEN &quot;Brand Name&quot; THEN [brand_name]&#10;WHEN &quot;Country&quot; THEN [country_name]&#10;WHEN &quot;Entity ID&quot; THEN [entity_id]&#10;WHEN &quot;Vertical Type&quot; THEN [vertical_type]&#10;WHEN &quot;Vendor Grade&quot; THEN [vendor_grade]&#10;WHEN &quot;Is New Vendor&quot; THEN STR([is_new_vendor])&#10;WHEN &quot;Key Account Sub Category&quot; THEN [key_account_sub_category]&#10;WHEN &quot;Change Group&quot; THEN [change_group]&#10;WHEN &quot;Operation Type&quot; THEN [operation_type]&#10;WHEN &quot;Change Type&quot; THEN [Calculation_3993566973380747267]&#10;END' />
      </column>
      <column caption='# Total Vendors WOW Change' datatype='real' name='[Calculation_3993566973326049280]' role='measure' type='quantitative'>
