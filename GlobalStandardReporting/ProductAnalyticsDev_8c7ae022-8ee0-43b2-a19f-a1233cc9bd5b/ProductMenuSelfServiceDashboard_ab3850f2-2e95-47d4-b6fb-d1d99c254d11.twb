      <column caption='_include_automation' datatype='boolean' name='[Calculation_201676883816726528]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy 2)]&#10;WHEN &quot;No&quot; THEN [is_automation] = FALSE&#10;WHEN &quot;Yes&quot; THEN 1 = 1&#10;END' />
      </column>
      <column caption='_LB_dimension' datatype='string' name='[Calculation_201676883911561217]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Click the + or - near the Header of Dimension A to adjust granular as desired&quot;' />
