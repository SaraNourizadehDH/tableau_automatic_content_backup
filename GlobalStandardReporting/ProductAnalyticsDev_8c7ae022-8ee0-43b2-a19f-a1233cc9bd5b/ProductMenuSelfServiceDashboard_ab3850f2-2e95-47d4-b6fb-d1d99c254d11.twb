    <worksheet name='% VSSR Change WOW'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='growth_vendor_menu_product_changes_report (van)' name='federated.12bdacs17b5ecp1bon2x2157ycv3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Comparison Interval' datatype='string' name='[Date Granularity (copy 4)_5870582853879967750]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.12bdacs17b5ecp1bon2x2157ycv3'>
            <column caption='% Vendor Self Service Change WOW' datatype='real' name='[% Total Change WOW (copy)_3009389771962355724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy 4)_5870582853879967750]&#10;WHEN &quot;Weekly&quot;&#10;// weekly calculation&#10;THEN &#10;    (SUM(IF ([Calculation_3009389771949772806] = [Calculation_4789507836007063552]) THEN [Calculation_3009389771962531853] ELSE 0 END)&#10;    /&#10;    SUM(IF ([Calculation_3009389771949772806] = [Calculation_4789507836007063552]) THEN [Calculation_2503016233852715008] ELSE 0 END))&#10;/&#10;    (SUM(IF ([Calculation_3009389771949772806] = ([Calculation_4789507836007063552] - 1 )) THEN [Calculation_3009389771962531853] ELSE 0 END)&#10;    /&#10;    SUM(IF ([Calculation_3009389771949772806] = ([Calculation_4789507836007063552] - 1 )) THEN [Calculation_2503016233852715008] ELSE 0 END))&#10;-1&#10;&#10;WHEN &quot;Monthly&quot;&#10;//monthly calculation&#10;THEN &#10;    (SUM(IF MONTH([month_start_date]) = [Calculation_4789507836007063552] THEN [Calculation_3009389771962531853] ELSE 0 END)&#10;    /&#10;    SUM(IF MONTH([month_start_date]) = ([Calculation_4789507836007063552] ) THEN [Calculation_2503016233852715008] ELSE 0 END))&#10;/&#10;    (SUM(IF MONTH([month_start_date]) = ([Calculation_4789507836007063552] - 1 ) THEN [Calculation_3009389771962531853] ELSE 0 END)&#10;    /&#10;    SUM(IF MONTH([month_start_date]) = ([Calculation_4789507836007063552] - 1 ) THEN [Calculation_2503016233852715008] ELSE 0 END))&#10;-1&#10;&#10;WHEN &quot;Quarterly&quot;&#10;//quarterly calculaton&#10;THEN &#10;    (SUM(IF QUARTER([quarter_start_date]) = [Calculation_4789507836007063552] THEN [Calculation_3009389771962531853] ELSE 0 END)&#10;    /&#10;    SUM(IF QUARTER([quarter_start_date]) = ([Calculation_4789507836007063552] ) THEN [Calculation_2503016233852715008] ELSE 0 END))&#10;/&#10;    (SUM(IF QUARTER([quarter_start_date]) = ([Calculation_4789507836007063552] - 1 ) THEN [Calculation_3009389771962531853] ELSE 0 END)&#10;    /&#10;    SUM(IF QUARTER([quarter_start_date]) = ([Calculation_4789507836007063552] - 1 ) THEN [Calculation_2503016233852715008] ELSE 0 END))&#10;-1&#10;END' />
            </column>
            <column caption='NonAutomation - Change Count' datatype='integer' name='[Calculation_2503016233852715008]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_automation] = FALSE THEN [change_count] ELSE 0 END' />
            </column>
            <column caption='ISO WEEK' datatype='integer' name='[Calculation_3009389771949772806]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WEEK([created_date] - 1)' />
            </column>
            <column caption='Vendor Self Service Change' datatype='integer' name='[Calculation_3009389771962531853]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_self_service] = TRUE THEN [change_count] ELSE 0 END' />
            </column>
            <column caption='Is % VSSR Change WOW Positive' datatype='boolean' name='[Calculation_3009389771963531278]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[% Total Change WOW (copy)_3009389771962355724] &gt; 0' />
            </column>
            <column caption='_shown_date' datatype='integer' name='[Calculation_4789507836007063552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy 4)_5870582853879967750]&#10;WHEN &quot;Weekly&quot; THEN {FIXED: MAX([Calculation_3009389771949772806])} - 1&#10;WHEN &quot;Monthly&quot; THEN {FIXED: MAX(MONTH([month_start_date]))}&#10;WHEN &quot;Quarterly&quot; THEN {FIXED: MAX(QUARTER([quarter_start_date]))}&#10;END' />
            </column>
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Change Count' datatype='integer' name='[change_count]' role='measure' type='quantitative' />
            <column caption='Change Group' datatype='string' name='[change_group]' role='dimension' type='nominal' />
            <column caption='Change type' datatype='string' name='[change_type]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='Entity Id' datatype='string' name='[entity_id]' role='dimension' type='nominal' />
            <column caption='Is Automation' datatype='boolean' name='[is_automation]' role='dimension' type='nominal' />
