        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy 4)_5870582853879967750]&#10;WHEN &quot;Weekly&quot; THEN {FIXED: MAX([Calculation_3009389771949772806])} - 1&#10;WHEN &quot;Monthly&quot; THEN {FIXED: MAX(MONTH([month_start_date]))}&#10;WHEN &quot;Quarterly&quot; THEN {FIXED: MAX(QUARTER([quarter_start_date]))}&#10;END' />
