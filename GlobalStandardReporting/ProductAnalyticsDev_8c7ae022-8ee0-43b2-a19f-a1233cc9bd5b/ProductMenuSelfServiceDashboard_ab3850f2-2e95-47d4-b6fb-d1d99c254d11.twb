      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='11'>&lt;Sheet Name&gt; - &lt;</run>
            <run fontalignment='1' fontsize='11'>[federated.12bdacs17b5ecp1bon2x2157ycv3].[none:Calculation_3009389771952943112:nk]</run>
            <run fontalignment='1' fontsize='11'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='growth_vendor_menu_product_changes_report (van)' name='federated.12bdacs17b5ecp1bon2x2157ycv3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Comparison Interval' datatype='string' name='[Date Granularity (copy 4)_5870582853879967750]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.12bdacs17b5ecp1bon2x2157ycv3'>
            <column caption='% Vendor Self Service' datatype='real' name='[Automation - Product Changes (copy)_3009389771882319874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_self_service] = TRUE THEN [change_count] ELSE 0 END)&#10;/&#10;SUM(IF [is_automation] = FALSE THEN [change_count] ELSE 0 END)' />
            </column>
            <column caption='ISO WEEK' datatype='integer' name='[Calculation_3009389771949772806]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WEEK([created_date] - 1)' />
            </column>
            <column caption='is_currentperiod' datatype='boolean' name='[Calculation_3009389771950366727]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy 4)_5870582853879967750]&#10;WHEN &quot;Weekly&quot; THEN ([Calculation_3009389771949772806] = [Calculation_4789507836007063552])&#10;WHEN &quot;Monthly&quot; THEN (MONTH([month_start_date])=[Calculation_4789507836007063552])&#10;WHEN &quot;Quarterly&quot; THEN (QUARTER([quarter_start_date]) = [Calculation_4789507836007063552])&#10;END' />
            </column>
            <column caption='_text Current Period' datatype='string' name='[Calculation_3009389771952943112]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy 4)_5870582853879967750]&#10;WHEN &quot;Weekly&quot; THEN &apos;CW &apos;+STR([Calculation_4789507836007063552])&#10;WHEN &quot;Monthly&quot; THEN &apos;M &apos;+STR([Calculation_4789507836007063552])&#10;WHEN &quot;Quarterly&quot; THEN &apos;Q &apos;+STR([Calculation_4789507836007063552])&#10;END' />
            </column>
            <column caption='_shown_date' datatype='integer' name='[Calculation_4789507836007063552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy 4)_5870582853879967750]&#10;WHEN &quot;Weekly&quot; THEN {FIXED: MAX([Calculation_3009389771949772806])} - 1&#10;WHEN &quot;Monthly&quot; THEN {FIXED: MAX(MONTH([month_start_date]))}&#10;WHEN &quot;Quarterly&quot; THEN {FIXED: MAX(QUARTER([quarter_start_date]))}&#10;END' />
            </column>
            <column caption='Change Type' datatype='string' name='[Calculation_5870582853151772672]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [change_type]&#10;WHEN &apos;Product Availability Enable&apos; THEN &apos;Availability Enable&apos;&#10; WHEN &apos;Product Availability Disable&apos; THEN &apos;Availability Disable&apos;&#10; WHEN &apos;Product Create&apos; THEN &apos;Create&apos;&#10; WHEN &apos;Product Delete&apos; THEN &apos;Delete&apos;&#10; WHEN &apos;Product Price Update&apos; THEN &apos;Price Update&apos;&#10; WHEN &apos;Product Name Update&apos; THEN &apos;Name Update&apos;&#10; WHEN &apos;Product Description Update&apos; THEN &apos;Description Update&apos;&#10; WHEN &apos;Product Image Update&apos; THEN &apos;Image Update&apos;&#10;END' />
            </column>
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Change Count' datatype='integer' name='[change_count]' role='measure' type='quantitative' />
