      <table>
        <view>
          <datasources>
            <datasource caption='growth_vendor_menu_product_changes_report (van)' name='federated.12bdacs17b5ecp1bon2x2157ycv3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' hidden='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column caption='Select Dimension' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;(All)&quot;'>
              <calculation class='tableau' formula='&quot;(All)&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.12bdacs17b5ecp1bon2x2157ycv3'>
            <column caption='% Vendor Self Service' datatype='real' name='[Automation - Product Changes (copy)_3009389771882319874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_self_service] = TRUE THEN [change_count] ELSE 0 END)&#10;/&#10;SUM(IF [is_automation] = FALSE THEN [change_count] ELSE 0 END)' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_3009389771921014788]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN STR([created_date])&#10;WHEN &quot;Weekly&quot; THEN [created_week]&#10;WHEN &quot;Monthly&quot; THEN [created_month]&#10;WHEN &quot;Quarterly&quot; THEN [created_quarter]&#10;END' />
            </column>
            <column caption='Select Dimension' datatype='string' name='[Calculation_3009389771985465360]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &quot;Region&quot; THEN [region]&#10;WHEN &quot;Brand Name&quot; THEN [brand_name]&#10;WHEN &quot;Country&quot; THEN [country_name]&#10;WHEN &quot;Entity ID&quot; THEN [entity_id]&#10;WHEN &quot;Vertical Type&quot; THEN [vertical_type]&#10;WHEN &quot;Vendor Grade&quot; THEN [vendor_grade]&#10;WHEN &quot;Is New Vendor&quot; THEN STR([is_new_vendor])&#10;WHEN &quot;Key Account Sub Category&quot; THEN [key_account_sub_category]&#10;WHEN &quot;Change Group&quot; THEN [change_group]&#10;WHEN &quot;Operation Type&quot; THEN [operation_type]&#10;WHEN &quot;Change Type&quot; THEN [Calculation_5870582853151772672]&#10;WHEN &quot;(All)&quot; THEN &quot;(All)&quot;&#10;END' />
            </column>
            <column caption='Change Type' datatype='string' name='[Calculation_5870582853151772672]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [change_type]&#10;WHEN &apos;Product Availability Enable&apos; THEN &apos;Availability Enable&apos;&#10; WHEN &apos;Product Availability Disable&apos; THEN &apos;Availability Disable&apos;&#10; WHEN &apos;Product Create&apos; THEN &apos;Create&apos;&#10; WHEN &apos;Product Delete&apos; THEN &apos;Delete&apos;&#10; WHEN &apos;Product Price Update&apos; THEN &apos;Price Update&apos;&#10; WHEN &apos;Product Name Update&apos; THEN &apos;Name Update&apos;&#10; WHEN &apos;Product Description Update&apos; THEN &apos;Description Update&apos;&#10; WHEN &apos;Product Image Update&apos; THEN &apos;Image Update&apos;&#10;END' />
