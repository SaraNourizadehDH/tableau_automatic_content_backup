      <column caption='Date' datatype='string' name='[Calculation_3009389771921014788]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Daily&quot; THEN STR([created_date])&#10;WHEN &quot;Weekly&quot; THEN [created_week]&#10;WHEN &quot;Monthly&quot; THEN [created_month]&#10;WHEN &quot;Quarterly&quot; THEN [created_quarter]&#10;END' />
      </column>
      <column caption='ISO WEEK' datatype='integer' name='[Calculation_3009389771949772806]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WEEK([created_date] - 1)' />
      </column>
      <column caption='is_currentperiod' datatype='boolean' name='[Calculation_3009389771950366727]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy 4)_5870582853879967750]&#10;WHEN &quot;Weekly&quot; THEN ([Calculation_3009389771949772806] = [Calculation_4789507836007063552])&#10;WHEN &quot;Monthly&quot; THEN (MONTH([month_start_date])=[Calculation_4789507836007063552])&#10;WHEN &quot;Quarterly&quot; THEN (QUARTER([quarter_start_date]) = [Calculation_4789507836007063552])&#10;END' />
      </column>
      <column caption='_text Current Period' datatype='string' name='[Calculation_3009389771952943112]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy 4)_5870582853879967750]&#10;WHEN &quot;Weekly&quot; THEN &apos;CW &apos;+STR([Calculation_4789507836007063552])&#10;WHEN &quot;Monthly&quot; THEN &apos;M &apos;+STR([Calculation_4789507836007063552])&#10;WHEN &quot;Quarterly&quot; THEN &apos;Q &apos;+STR([Calculation_4789507836007063552])&#10;END' />
      </column>
      <column caption='_text Previous Period' datatype='string' name='[Calculation_3009389771955302409]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy 4)_5870582853879967750]&#10;WHEN &quot;Weekly&quot; THEN  &quot;vs prior Week - CW&quot; + STR([Calculation_4789507836007063552]-1)&#10;WHEN &quot;Monthly&quot; THEN &quot;vs prior Month - M&quot;+STR([Calculation_4789507836007063552]-1)&#10;WHEN &quot;Quarterly&quot; THEN &quot;vs prior Quarter - Q&quot;+STR([Calculation_4789507836007063552]-1)&#10;END' />
      </column>
      <column caption='% Total Change WOW' datatype='real' name='[Calculation_3009389771956314122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy 4)_5870582853879967750]&#10;WHEN &quot;Weekly&quot; THEN &#10;    (SUM(IF [Calculation_3009389771949772806] = [Calculation_4789507836007063552] THEN [change_count] ELSE 0 END)&#10;    /&#10;    SUM(IF [Calculation_3009389771949772806] = ([Calculation_4789507836007063552] - 1) THEN [change_count] ELSE 0 END)&#10;    - 1&#10;    )&#10;WHEN &quot;Monthly&quot; THEN &#10;    (SUM(IF MONTH([month_start_date]) = [Calculation_4789507836007063552] THEN [change_count] ELSE 0 END)&#10;    /&#10;    SUM(IF MONTH([month_start_date]) = ([Calculation_4789507836007063552] - 1) THEN [change_count] ELSE 0 END)&#10;    - 1&#10;    )&#10;WHEN &quot;Quarterly&quot; THEN &#10;    (SUM(IF QUARTER([quarter_start_date]) = [Calculation_4789507836007063552] THEN [change_count] ELSE 0 END)&#10;    /&#10;    SUM(IF QUARTER([quarter_start_date]) = ([Calculation_4789507836007063552] - 1) THEN [change_count] ELSE 0 END)&#10;    - 1&#10;    )&#10;END' />
      </column>
      <column caption='Is % Total Change WOW Positive' datatype='boolean' name='[Calculation_3009389771959509003]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_3009389771956314122] &gt; 0' />
