              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Weekly&quot; THEN [date_granular] = &quot;Weekly&quot;&#10;WHEN &quot;Monthly&quot; THEN [date_granular] = &quot;Monthly&quot;&#10;WHEN &quot;Quarterly&quot; THEN [date_granular] = &quot;Quarterly&quot;&#10;WHEN &quot;Daily&quot; THEN [date_granular] = &quot;Daily&quot;&#10;END' />
