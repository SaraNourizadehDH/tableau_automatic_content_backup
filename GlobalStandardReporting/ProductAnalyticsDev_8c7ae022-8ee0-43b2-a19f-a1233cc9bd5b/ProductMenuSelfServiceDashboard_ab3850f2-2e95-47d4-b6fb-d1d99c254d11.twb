    <worksheet name='Vendor % SS by Change Type'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontsize='12'>% SSV - Operation Type - &lt;</run>
            <run fontalignment='1' fontcolor='#000000' fontsize='12'>[federated.1q6k51t0yg682j108jbgs0zbdlvo].[none:Calculation_2503016233938456584:nk]</run>
            <run fontalignment='1' fontcolor='#000000' fontsize='12'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='growth_vendor_menu_product_changes_vendor (van)' name='federated.1q6k51t0yg682j108jbgs0zbdlvo' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' hidden='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1q6k51t0yg682j108jbgs0zbdlvo'>
            <column caption='% Self Service Vendors' datatype='real' name='[Calculation_2503016233920741382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([self_service_vendors])/ SUM([non_automation_vendors])' />
            </column>
            <column caption='_text_Current Period' datatype='string' name='[Calculation_2503016233938456584]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Weekly&quot; THEN &apos;CW &apos;+STR([Calculation_4789507836026777601])&#10;WHEN &quot;Monthly&quot; THEN &apos;M &apos;+STR([Calculation_4789507836026777601])&#10;WHEN &quot;Quarterly&quot; THEN &apos;Q &apos;+STR([Calculation_4789507836026777601])&#10;END' />
            </column>
            <column caption='_date_filter' datatype='boolean' name='[Calculation_3009389772623286289]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Weekly&quot; THEN [date_granular] = &quot;Weekly&quot;&#10;WHEN &quot;Monthly&quot; THEN [date_granular] = &quot;Monthly&quot;&#10;WHEN &quot;Quarterly&quot; THEN [date_granular] = &quot;Quarterly&quot;&#10;WHEN &quot;Daily&quot; THEN [date_granular] = &quot;Daily&quot;&#10;END' />
            </column>
            <column caption='Iso Week' datatype='integer' name='[Calculation_3009389773255036947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WEEK([created_date])' />
            </column>
            <column caption='_is_current period' datatype='boolean' name='[Calculation_3009389773260333076]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Weekly&quot; THEN ([Calculation_3009389773255036947] = [Calculation_4789507836026777601]) &#10;WHEN &quot;Monthly&quot; THEN (MONTH([created_date])=[Calculation_4789507836026777601])&#10;WHEN &quot;Quarterly&quot; THEN (QUARTER([created_date]) = [Calculation_4789507836026777601])&#10;END' />
            </column>
            <column caption='Change Type' datatype='string' name='[Calculation_3993566973380747267]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [change_type]&#10;WHEN &apos;Product Availability Enable&apos; THEN &apos;Availability Enable&apos;&#10; WHEN &apos;Product Availability Disable&apos; THEN &apos;Availability Disable&apos;&#10; WHEN &apos;Product Create&apos; THEN &apos;Create&apos;&#10; WHEN &apos;Product Delete&apos; THEN &apos;Delete&apos;&#10; WHEN &apos;Product Price Update&apos; THEN &apos;Price Update&apos;&#10; WHEN &apos;Product Name Update&apos; THEN &apos;Name Update&apos;&#10; WHEN &apos;Product Description Update&apos; THEN &apos;Description Update&apos;&#10; WHEN &apos;Product Image Update&apos; THEN &apos;Image Update&apos;&#10;END' />
            </column>
            <column aggregation='Sum' caption='_shown_date' datatype='integer' name='[Calculation_4789507836026777601]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Weekly&quot; THEN {FIXED: MAX([Calculation_3009389773255036947])} - 1&#10;WHEN &quot;Monthly&quot; THEN {FIXED: MAX(MONTH([created_date]))}&#10;WHEN &quot;Quarterly&quot; THEN {FIXED: MAX(QUARTER([created_date]))}&#10;END' />
            </column>
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Change Group' datatype='string' name='[change_group]' role='dimension' type='nominal' />
            <column caption='Change type' datatype='string' name='[change_type]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Created Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='Date Granular' datatype='string' name='[date_granular]' role='dimension' type='nominal' />
            <column caption='Entity Id' datatype='string' name='[entity_id]' role='dimension' type='nominal' />
            <column caption='Is New Vendor' datatype='boolean' name='[is_new_vendor]' role='dimension' type='nominal' />
            <column caption='Key Account Sub Category' datatype='string' name='[key_account_sub_category]' role='dimension' type='nominal' />
            <column caption='Non Automation Vendors' datatype='integer' name='[non_automation_vendors]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2503016233938456584]' derivation='None' name='[none:Calculation_2503016233938456584:nk]' pivot='key' type='nominal' />
