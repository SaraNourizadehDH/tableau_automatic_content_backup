            <column caption='WINDOW_AVG(sum([adopted_Menu_Management_vendors_cnt])/SUM([to...' datatype='real' name='[Calculation_1892848891491573802]' role='measure' type='quantitative' user:unnamed='Plugins adoption - Menu'>
              <calculation class='tableau' formula='WINDOW_AVG(sum([adopted_Menu_Management_vendors_cnt])/SUM([total_vendors_cnt]), -10, -1)'>
