                <zone forceUpdate='true' h='9438' id='53' type-v2='text' w='94784' x='4683' y='14375'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='16'>Overall High Band Vendor Adoption across Portal</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='10'>Usage Notes:</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='10'>1. View can be toggled via Parameter Selection above</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='10'> - Entity Granularity: Brand &amp; Country</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='10'> - Period Granularity: Day, Week, Month &amp; Quarter showing last 8 periods </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='10'>2. Metrics toggled accordingly via Measure Value filter</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='10'>3. Dates indicate the start of period, with Monday being first day of week</run>
                  </formatted-text>
