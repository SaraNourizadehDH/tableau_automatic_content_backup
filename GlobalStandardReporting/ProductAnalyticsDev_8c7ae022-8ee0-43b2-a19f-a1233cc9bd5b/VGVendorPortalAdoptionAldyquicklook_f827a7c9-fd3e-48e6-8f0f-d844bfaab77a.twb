          <datasource-dependencies datasource='federated.03h5af71wbdr8k15hgeg01rdz1k4'>
            <column caption='sum([adopted_Dashboard_vendors_cnt])/SUM([total_vendors_cnt])' datatype='real' name='[Calculation_1892848891490869279]' role='measure' type='quantitative' user:unnamed='Plugins adoption - Dashboard'>
              <calculation class='tableau' formula='sum([adopted_Dashboard_vendors_cnt])/SUM([total_vendors_cnt])' />
            </column>
            <column caption='WINDOW_AVG(sum([adopted_Dashboard_vendors_cnt])/SUM([total_ve...' datatype='real' name='[Calculation_1892848891490902048]' role='measure' type='quantitative' user:unnamed='Plugins adoption - Dashboard'>
              <calculation class='tableau' formula='WINDOW_AVG(sum([adopted_Dashboard_vendors_cnt])/SUM([total_vendors_cnt]), -10, -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='full period' datatype='boolean' name='[Calculation_1892848891493031981]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [period_granularity]&#10;when &apos;week&apos; then DATEDIFF(&apos;week&apos;,[fielddate],TODAY(),&apos;Monday&apos;)&gt;=1&#10;when &apos;month&apos; then DATEDIFF(&apos;month&apos;,[fielddate],TODAY(),&apos;Monday&apos;)&gt;=1&#10;when &apos;quarter&apos; then DATEDIFF(&apos;quarter&apos;,[fielddate],TODAY(),&apos;Monday&apos;)&gt;=1&#10;when &apos;day&apos; then TRUE&#10;else FALSE &#10;end' />
            </column>
