          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date to:' datatype='date' name='[Date from: (copy)_4345903316476108801]' param-domain-type='any' role='measure' type='quantitative' value='#2025-01-01#'>
              <calculation class='tableau' formula='#2025-01-01#' />
            </column>
            <column caption='Plugin' datatype='string' name='[Entity Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Date from:' datatype='date' name='[Metrics Type (copy)]' param-domain-type='any' role='measure' type='quantitative' value='#2023-04-01#'>
              <calculation class='tableau' formula='#2023-04-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0bhf3tl1uyrkwv15u3xzn1dqhas9'>
            <column caption='Date Adopted' datatype='date' name='[Calculation_1704893978662621197]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;week&apos;,1,[fielddate]))' />
            </column>
            <column caption='Last Date Flag' datatype='boolean' name='[Calculation_1704893978663010319]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [period_granularity]&#10;when &apos;week&apos; then DATEDIFF(&apos;week&apos;,[fielddate],TODAY(),&apos;Monday&apos;)&lt;=1&#10;when &apos;month&apos; then DATEDIFF(&apos;month&apos;,[fielddate],TODAY(),&apos;Monday&apos;)&lt;=1&#10;when &apos;quarter&apos; then DATEDIFF(&apos;quarter&apos;,[fielddate],TODAY(),&apos;Monday&apos;)&lt;=1&#10;when &apos;day&apos; then TRUE&#10;else FALSE &#10;end' />
            </column>
            <column caption='SUM([Id Retained Cnt])/SUM([Id Base Cnt])' datatype='real' name='[Calculation_3387692124175204352]' role='measure' type='quantitative' user:unnamed='Retention - [WIP]'>
              <calculation class='tableau' formula='SUM([id_retained_cnt])/SUM([id_base_cnt])' />
            </column>
            <column caption='Date Range flag' datatype='boolean' name='[Calculation_4345903316488552453]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[fielddate]&gt;=[Parameters].[Metrics Type (copy)]&#10;and &#10;[fielddate]&lt;=[Parameters].[Date from: (copy)_4345903316476108801]' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
