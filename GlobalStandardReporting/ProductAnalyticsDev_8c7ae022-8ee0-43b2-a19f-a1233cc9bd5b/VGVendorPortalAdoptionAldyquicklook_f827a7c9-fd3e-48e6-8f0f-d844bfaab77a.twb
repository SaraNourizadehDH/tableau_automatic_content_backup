          <datasource-dependencies datasource='federated.03d3zlk1rme5ti1gvqfej1tijtev'>
            <column caption='full period' datatype='boolean' name='[Calculation_1892848891494105135]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1 1]&#10;when &apos;week&apos; then DATEDIFF(&apos;week&apos;,[period_start],TODAY(),&apos;Monday&apos;)&gt;=1&#10;when &apos;month&apos; then DATEDIFF(&apos;month&apos;,[period_start],TODAY(),&apos;Monday&apos;)&gt;=1&#10;when &apos;quarter&apos; then DATEDIFF(&apos;quarter&apos;,[period_start],TODAY(),&apos;Monday&apos;)&gt;=1&#10;when &apos;day&apos; then TRUE&#10;else FALSE &#10;end' />
            </column>
            <column caption='Adoption Metric' datatype='integer' name='[Calculation_267964198090346497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Plugin (copy)_267964198089814016]&#10;WHEN &apos;All&apos; THEN [adopted_vendors]&#10;WHEN &apos;Not internal only&apos; then [adopted_not_internally_vendors]&#10;WHEN &apos;Internal only&apos; then [adopted_internally_vendors]&#10;END' />
            </column>
            <column caption='Date Range flag' datatype='boolean' name='[Calculation_4345903316476272642]' role='dimension' type='nominal'>
