      <aliases enabled='yes' />
      <column caption='% Adopted Web Vendors / Active Vendors' datatype='real' name='[% Adopted Mobile Vendors / Active Vendors (copy)_90494241501388807]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([adopted_web_vendor])/SUM([active_vendors])' />
      </column>
      <column caption='% Adopted App Vendors / Active Vendors' datatype='real' name='[% Adopted Mobile Vendors / Active Vendors (copy)_90494241501970440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([adopted_app_vendor])/SUM([active_vendors])' />
      </column>
      <column caption='% Adopted Mobile Vendors / Active Vendors' datatype='real' name='[% Adopted Vendors / Active Vendors (copy)_90494241501184004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([adopted_mobile_vendor])/SUM([active_vendors])' />
      </column>
      <column caption='full period' datatype='boolean' name='[Calculation_1892848891494105135]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1 1]&#10;when &apos;week&apos; then DATEDIFF(&apos;week&apos;,[period_start],TODAY(),&apos;Monday&apos;)&gt;=1&#10;when &apos;month&apos; then DATEDIFF(&apos;month&apos;,[period_start],TODAY(),&apos;Monday&apos;)&gt;=1&#10;when &apos;quarter&apos; then DATEDIFF(&apos;quarter&apos;,[period_start],TODAY(),&apos;Monday&apos;)&gt;=1&#10;when &apos;day&apos; then TRUE&#10;else FALSE &#10;end' />
      </column>
      <column caption='Adoption Metric' datatype='integer' name='[Calculation_267964198090346497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Plugin (copy)_267964198089814016]&#10;WHEN &apos;All&apos; THEN [adopted_vendors]&#10;WHEN &apos;Not internal only&apos; then [adopted_not_internally_vendors]&#10;WHEN &apos;Internal only&apos; then [adopted_internally_vendors]&#10;END' />
      </column>
      <column caption='Meta - creation date' datatype='string' name='[Calculation_4085538957603450880]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Creation date:&quot;' />
      </column>
      <column caption='Date Range flag' datatype='boolean' name='[Calculation_4345903316476272642]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[period_start]&gt;=[Parameters].[Metrics Type (copy)]&#10;and &#10;[period_start]&lt;=[Parameters].[Date from: (copy)_4345903316476108801]' />
      </column>
      <column caption='User Entitlement ' datatype='boolean' name='[Calculation_7000704925879029763]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Entity Selector' datatype='string' name='[Calculation_90494241496219649]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2 1] = &apos;Management Entity&apos; THEN [management_entity]&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Country&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Brand&apos; THEN [entity_name]&#10;END' />
      </column>
      <column caption='% Adopted Vendors / Active Vendors' datatype='real' name='[Calculation_90494241496743938]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_267964198090346497])/SUM([active_vendors])' />
      </column>
      <column caption='Date' datatype='date' name='[Calculation_90494241525981193]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(IF NOT ISNULL( DATEPARSE ( &quot;yyyy-MM-dd&quot;, [time_period] )  ) THEN DATEPARSE ( &quot;yyyy-MM-dd&quot;, [time_period] )   ELSEIF NOT ISNULL ( DATEPARSE ( &quot;yyyy-&apos;W&apos;MM&quot;, [time_period] )  ) THEN DATEPARSE ( &quot;yyyy-&apos;W&apos;MM&quot;, [time_period] )   END)' />
      </column>
      <column caption='Start Date' datatype='datetime' name='[Calculation_90494241527001098]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1 1] = &apos;week&apos; THEN DATEADD(&apos;week&apos;,-8,DATETRUNC(&apos;week&apos;,TODAY(),&apos;monday&apos;))&#10;ELSEIF [Parameters].[Parameter 1 1] = &apos;month&apos; THEN DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY(),&apos;monday&apos;))&#10;ELSEIF [Parameters].[Parameter 1 1] = &apos;quarter&apos; THEN DATEADD(&apos;quarter&apos;,-6,DATETRUNC(&apos;quarter&apos;,TODAY(),&apos;monday&apos;))&#10;END' />
      </column>
      <column caption='Date Filter' datatype='boolean' name='[Calculation_90494241527070731]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF[Calculation_90494241525981193]&gt; [Calculation_90494241527001098] THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Report Date' datatype='string' name='[Calculation_90494241527742476]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAX(IF [period_granularity]=&apos;day&apos; THEN [time_period] END)' />
      </column>
      <column caption='Meta - created by' datatype='string' name='[Meta - creation date (copy)_4085538957605011457]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Created by:&quot;' />
      </column>
