      <aliases enabled='yes' />
      <column caption='Date Adopted' datatype='date' name='[Calculation_1704893978662621197]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;week&apos;,1,[fielddate]))' />
      </column>
      <column caption='Last Date' datatype='date' name='[Calculation_1704893978662903822]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed [period_granularity]: max([fielddate])}' />
      </column>
      <column caption='Last Date Flag' datatype='boolean' name='[Calculation_1704893978663010319]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [period_granularity]&#10;when &apos;week&apos; then DATEDIFF(&apos;week&apos;,[fielddate],TODAY(),&apos;Monday&apos;)&lt;=1&#10;when &apos;month&apos; then DATEDIFF(&apos;month&apos;,[fielddate],TODAY(),&apos;Monday&apos;)&lt;=1&#10;when &apos;quarter&apos; then DATEDIFF(&apos;quarter&apos;,[fielddate],TODAY(),&apos;Monday&apos;)&lt;=1&#10;when &apos;day&apos; then TRUE&#10;else FALSE &#10;end' />
      </column>
      <column caption='Date Range flag' datatype='boolean' name='[Calculation_4345903316488552453]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[fielddate]&gt;=[Parameters].[Metrics Type (copy)]&#10;and &#10;[fielddate]&lt;=[Parameters].[Date from: (copy)_4345903316476108801]' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_4345903316495802375]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Meta - Created by' datatype='string' name='[Calculation_4345903316497162248]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Created by:&apos;' />
      </column>
      <column caption='Last Date Flag - Active' datatype='boolean' name='[Last Date Flag (copy)_1704893978663845904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [period_granularity]&#10;when &apos;week&apos; then DATEDIFF(&apos;week&apos;,[Calculation_1704893978662621197],TODAY(),&apos;Monday&apos;)=1&#10;when &apos;month&apos; then DATEDIFF(&apos;month&apos;,[Calculation_1704893978662621197],TODAY(),&apos;Monday&apos;)=1&#10;when &apos;quarter&apos; then DATEDIFF(&apos;quarter&apos;,[Calculation_1704893978662621197],TODAY(),&apos;Monday&apos;)=1&#10;when &apos;day&apos; then TRUE&#10;else FALSE &#10;end' />
      </column>
      <column caption='Meta - Creation date' datatype='string' name='[Meta - Created by (copy)_4345903316497223689]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Creation date:&apos;' />
      </column>
