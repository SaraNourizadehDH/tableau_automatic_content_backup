      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='14'>% Adopted Mobile Vendors / Active Vendors</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vp_adoption_rl' name='federated.03d3zlk1rme5ti1gvqfej1tijtev' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date to:' datatype='date' name='[Date from: (copy)_4345903316476108801]' param-domain-type='any' role='measure' type='quantitative' value='#2025-01-01#'>
              <calculation class='tableau' formula='#2025-01-01#' />
            </column>
            <column caption='Date from:' datatype='date' name='[Metrics Type (copy)]' param-domain-type='any' role='measure' type='quantitative' value='#2023-04-01#'>
              <calculation class='tableau' formula='#2023-04-01#' />
            </column>
            <column alias='Week' caption='Period Granularity' datatype='string' name='[Parameter 1 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;quarter&quot;' value='Quarter' />
                <alias key='&quot;week&quot;' value='Week' />
              </aliases>
            </column>
            <column caption='Entity Granularity' datatype='string' name='[Parameter 2 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand&quot;'>
              <calculation class='tableau' formula='&quot;Brand&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03d3zlk1rme5ti1gvqfej1tijtev'>
            <column caption='% Adopted Mobile Vendors / Active Vendors' datatype='real' name='[% Adopted Vendors / Active Vendors (copy)_90494241501184004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([adopted_mobile_vendor])/SUM([active_vendors])' />
            </column>
            <column caption='full period' datatype='boolean' name='[Calculation_1892848891494105135]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1 1]&#10;when &apos;week&apos; then DATEDIFF(&apos;week&apos;,[period_start],TODAY(),&apos;Monday&apos;)&gt;=1&#10;when &apos;month&apos; then DATEDIFF(&apos;month&apos;,[period_start],TODAY(),&apos;Monday&apos;)&gt;=1&#10;when &apos;quarter&apos; then DATEDIFF(&apos;quarter&apos;,[period_start],TODAY(),&apos;Monday&apos;)&gt;=1&#10;when &apos;day&apos; then TRUE&#10;else FALSE &#10;end' />
            </column>
            <column caption='Date Range flag' datatype='boolean' name='[Calculation_4345903316476272642]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[period_start]&gt;=[Parameters].[Metrics Type (copy)]&#10;and &#10;[period_start]&lt;=[Parameters].[Date from: (copy)_4345903316476108801]' />
            </column>
            <column caption='Entity Selector' datatype='string' name='[Calculation_90494241496219649]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2 1] = &apos;Management Entity&apos; THEN [management_entity]&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Country&apos; THEN [country_name]&#10;ELSEIF [Parameters].[Parameter 2 1] = &apos;Brand&apos; THEN [entity_name]&#10;END' />
            </column>
            <column caption='Active Vendors' datatype='integer' name='[active_vendors]' role='measure' type='quantitative' />
            <column caption='Adopted Mobile (App + mWeb) Vendor' datatype='integer' name='[adopted_mobile_vendor]' role='measure' type='quantitative' />
            <column caption='Chain Status' datatype='string' name='[chain_status]' role='dimension' type='nominal' />
            <column caption='Country' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Brand' datatype='string' name='[entity_name]' role='dimension' type='nominal' />
            <column caption='Is Key Account' datatype='boolean' name='[is_key_account]' role='dimension' type='nominal' />
