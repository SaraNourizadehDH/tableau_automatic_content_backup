        <calculation class='tableau' formula='CASE [Parameters].[Entity Granularity (copy)]&#10;    WHEN &apos;All&apos; then [adopted_vendors_cnt]&#10;    WHEN &apos;Dashboard&apos; THEN [adopted_Dashboard_vendors_cnt]&#10;    WHEN &apos;Reports&apos; THEN [adopted_Reports_vendors_cnt]&#10;    WHEN &apos;Menu_Management&apos; THEN [adopted_Menu_Management_vendors_cnt]&#10;    WHEN &apos;Item_Management&apos; THEN [adopted_Item_Management_vendors_cnt]&#10;    WHEN &apos;Opening_Times&apos; THEN [adopted_Opening_Times_vendors_cnt]&#10;    WHEN &apos;Onboarding&apos; THEN [adopted_Onboarding_vendors_cnt]&#10;    WHEN &apos;Settings&apos; THEN [adopted_Settings_vendors_cnt]&#10;    WHEN &apos;Finance&apos; THEN [adopted_Finance_vendors_cnt]&#10;    WHEN &apos;Orders&apos; THEN [adopted_Orders_vendors_cnt]&#10;    WHEN &apos;Reviews&apos; THEN [adopted_Reviews_vendors_cnt]&#10;    WHEN &apos;Help_Center&apos; THEN [adopted_Help_Center_vendors_cnt]&#10;    WHEN &apos;Invoices&apos; THEN [adopted_Invoices_vendors_cnt]&#10;    WHEN &apos;Logout&apos; THEN [adopted_Logout_vendors_cnt]&#10;    WHEN &apos;User_Management_System&apos; THEN [adopted_User_Management_System_vendors_cnt]&#10;    WHEN &apos;Notification&apos; THEN [adopted_Notification_vendors_cnt]&#10;    WHEN &apos;University&apos; THEN [adopted_University_vendors_cnt]&#10;    WHEN &apos;Commercial&apos; THEN [adopted_Commercial_vendors_cnt]&#10;    WHEN &apos;Vendor_Performance&apos; THEN [adopted_Vendor_Performance_vendors_cnt]&#10;    WHEN &apos;Coverage_Areas&apos; THEN [adopted_Coverage_Areas_vendors_cnt]&#10;    WHEN &apos;Store_Management&apos; THEN [adopted_Store_Management_vendors_cnt]&#10;    WHEN &apos;Store_Integrations&apos; THEN [adopted_Store_Integrations_vendors_cnt]&#10;    WHEN &apos;Store_Promotions&apos; THEN [adopted_Store_Promotions_vendors_cnt]&#10;    WHEN &apos;Partner_Central&apos; THEN [adopted_Partner_Central_vendors_cnt]&#10;    WHEN &apos;Advance_Reports&apos; THEN [adopted_Advance_Reports_vendors_cnt]&#10;    WHEN &apos;Merchant&apos; THEN [adopted_Merchant_vendors_cnt]&#10;    WHEN &apos;Vendor_Availability&apos; THEN [adopted_Vendor_Availability_vendors_cnt]&#10;    WHEN &apos;Online_Help&apos; THEN [adopted_Online_Help_vendors_cnt]&#10;    WHEN &apos;Vendor_Info&apos; THEN [adopted_Vendor_Info_vendors_cnt]&#10;    WHEN &apos;Cpc&apos; THEN [adopted_Cpc_vendors_cnt]&#10;    WHEN &apos;Joker&apos; THEN [adopted_Joker_vendors_cnt]&#10;    WHEN &apos;Vfd&apos; THEN [adopted_Vfd_vendors_cnt]&#10;    else 0 end' />
      </column>
      <column caption='full period' datatype='boolean' name='[Calculation_1892848891493031981]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [period_granularity]&#10;when &apos;week&apos; then DATEDIFF(&apos;week&apos;,[fielddate],TODAY(),&apos;Monday&apos;)&gt;=1&#10;when &apos;month&apos; then DATEDIFF(&apos;month&apos;,[fielddate],TODAY(),&apos;Monday&apos;)&gt;=1&#10;when &apos;quarter&apos; then DATEDIFF(&apos;quarter&apos;,[fielddate],TODAY(),&apos;Monday&apos;)&gt;=1&#10;when &apos;day&apos; then TRUE&#10;else FALSE &#10;end' />
