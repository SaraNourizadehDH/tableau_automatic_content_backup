      <aliases enabled='yes' />
      <column caption='% Accounts with Emails' datatype='real' name='[# Accounts with Emails (copy)_2159194589196902401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6277384604241465346]/[Calculation_6277384604234383361]' />
      </column>
      <column caption='# Accounts with Book-able' datatype='integer' name='[# Accounts with Login-able (copy)_2159194589221052423]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF ISNULL([mobile_phone]) = FALSE &#10;AND ISNULL([email]) = FALSE &#10;AND [is_twilio_valid] = TRUE&#10;AND [has_loginable_role] = TRUE&#10;AND [has_bookable_role] = TRUE&#10;THEN [Calculation_6277384604233269248] ELSE NULL END)' />
      </column>
      <column caption='% Accounts with Mobile Phone' datatype='real' name='[# Accounts with Mobile Phone (copy)_2159194589197729794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6277384604242444291]/ [Calculation_6277384604234383361]' />
      </column>
      <column caption='# Accounts with Twilio Validated' datatype='integer' name='[# Accounts with Mobile Phone (copy)_2159194589200568323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF ISNULL([mobile_phone]) = FALSE &#10;AND ISNULL([email]) = FALSE &#10;AND [is_twilio_valid] = TRUE&#10;THEN [Calculation_6277384604233269248] ELSE NULL END)' />
      </column>
      <column caption='# User with Mobile Phone' datatype='integer' name='[# Accounts with Mobile Phone (copy)_6277384604244594692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF ISNULL([mobile_phone]) = FALSE THEN [user_id] ELSE NULL END)' />
      </column>
      <column caption='# Accounts with Login-able' datatype='integer' name='[# Accounts with Twilio Validated (copy)_2159194589217587205]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF ISNULL([mobile_phone]) = FALSE &#10;AND ISNULL([email]) = FALSE &#10;AND [is_twilio_valid] = TRUE&#10;AND [has_loginable_role] = TRUE&#10;THEN [Calculation_6277384604233269248] ELSE NULL END)' />
      </column>
      <column caption='# Owner with Same Phone SF/UMS - Accounts' datatype='integer' name='[# Owner Discrepancy SF/UMS (copy)_6277384604272414730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD&#10;(IF ([contact_role] = &apos;Owner&apos; OR [ums_role] = &apos;OWNER&apos;) &#10;AND ISNULL([mobile_phone]) = FALSE&#10;AND ISNULL([email]) = FALSE&#10;AND ([is_ums_phone] = TRUE AND [is_salesforce_phone] = TRUE)&#10;THEN [Calculation_6277384604233269248]&#10;ELSE NULL END&#10;)' />
      </column>
      <column caption='# Owner Discrepancy SF/UMS - Accounts' datatype='integer' name='[# Owner Role with Loginable - Accounts (copy)_6277384604269506569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD&#10;(IF ([contact_role] = &apos;Owner&apos; OR [ums_role] = &apos;OWNER&apos;) &#10;AND ISNULL([mobile_phone]) = FALSE&#10;AND ISNULL([email]) = FALSE&#10;AND (([is_ums_phone] = TRUE AND [is_salesforce_phone] = FALSE)&#10;OR ([is_ums_phone] = FALSE AND [is_salesforce_phone] = TRUE))&#10;THEN [Calculation_6277384604233269248]&#10;ELSE NULL END&#10;)' />
      </column>
      <column caption='# Owner Role with Bookable - Accounts' datatype='integer' name='[# Owner Role with Loginable - Accounts (copy)_6277384604273893387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD&#10;(IF ([contact_role] = &apos;Owner&apos; OR [ums_role] = &apos;OWNER&apos;) &#10;AND ISNULL([mobile_phone]) = FALSE&#10;AND ISNULL([email]) = FALSE&#10;AND [has_bookable_role] = TRUE&#10;THEN [Calculation_6277384604233269248]&#10;ELSE NULL END&#10;)' />
      </column>
      <column caption='# Owner Role with Loginable - Accounts' datatype='integer' name='[# Owner Role with Phone - Accounts (copy)_6277384604268625928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD&#10;(IF ([contact_role] = &apos;Owner&apos; OR [ums_role] = &apos;OWNER&apos;) &#10;AND ISNULL([mobile_phone]) = FALSE&#10;AND ISNULL([email]) = FALSE&#10;AND [has_loginable_role] = TRUE&#10;THEN [Calculation_6277384604233269248]&#10;ELSE NULL END&#10;)' />
      </column>
      <column caption='# UMS Owner with Phone - Account' datatype='integer' name='[# Salesforce Owner with Phone - Account (copy)_6277384604266795015]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD&#10;(IF [ums_role] = &apos;OWNER&apos;&#10;AND ISNULL([mobile_phone]) = FALSE&#10;AND ISNULL([email]) = FALSE&#10;THEN [Calculation_6277384604233269248]&#10;ELSE NULL END&#10;)' />
