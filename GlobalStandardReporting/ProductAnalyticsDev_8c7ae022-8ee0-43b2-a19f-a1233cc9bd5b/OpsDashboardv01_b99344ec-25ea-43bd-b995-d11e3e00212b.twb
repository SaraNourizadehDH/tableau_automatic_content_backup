      <aliases enabled='yes' />
      <column caption='# Auto-Accept Configured Failed Orders' datatype='integer' name='[% Auto-Accept Configured Fail Rate (copy)_4002503800465469460]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_auto_accept_configured] AND [order_status] != &apos;completed&apos; THEN [orders] ELSE 0 END)' />
      </column>
      <column caption='# Auto-Accept Configured Orders' datatype='integer' name='[% Auto-Accept Configured Orders (copy)_4002503800466137110]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_auto_accept_configured] THEN [orders] ELSE 0 END)' />
      </column>
      <column caption='# Auto-Accept Configured Orders Auto-Accepted' datatype='integer' name='[% Auto-Accept Configured Orders Auto-Accepted? (copy)_4002503800466214935]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_auto_accept_configured] AND [is_order_auto_accepted] THEN [orders] ELSE 0 END)' />
      </column>
