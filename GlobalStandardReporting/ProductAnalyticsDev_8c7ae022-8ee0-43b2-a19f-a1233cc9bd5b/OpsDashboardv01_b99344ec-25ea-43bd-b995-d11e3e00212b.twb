    <worksheet name='Summary #'>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_ops_dashboard_order_attributes (jeetendra_manjunath)' name='federated.0h4ojdc11i4lzt10wpqhw0ga7osm' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Orders - Summary - Dimension A' datatype='string' name='[Orders - Fails - Dimension A (copy)_5909004253175435302]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column caption='Orders - Summary - Dimension B' datatype='string' name='[Orders - Summary - Dimension A (copy)_5909004253175570471]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
            <column alias='Week' caption='Orders - Summary - Time Granularity' datatype='integer' datatype-customized='true' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='2'>
              <calculation class='tableau' formula='2' />
              <aliases>
                <alias key='1' value='Day' />
                <alias key='2' value='Week' />
                <alias key='3' value='Month' />
              </aliases>
            </column>
            <column caption='Orders - Summary - View As' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% of all orders&quot;'>
              <calculation class='tableau' formula='&quot;% of all orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0h4ojdc11i4lzt10wpqhw0ga7osm'>
            <column caption='# Auto-Accept Configured Failed Orders' datatype='integer' name='[% Auto-Accept Configured Fail Rate (copy)_4002503800465469460]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_auto_accept_configured] AND [order_status] != &apos;completed&apos; THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='# Auto-Accept Configured Orders' datatype='integer' name='[% Auto-Accept Configured Orders (copy)_4002503800466137110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_auto_accept_configured] THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='# Auto-Accept Configured Orders Auto-Accepted' datatype='integer' name='[% Auto-Accept Configured Orders Auto-Accepted? (copy)_4002503800466214935]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_auto_accept_configured] AND [is_order_auto_accepted] THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='# Auto-Accept Configured Vendor Failed Orders' datatype='integer' name='[% Auto-Accept Configured Vendor Fail Rate (copy)_4002503800466038805]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_auto_accept_configured] AND [is_cancelled_by_vendor] THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='# Direct + GO POS Orders' datatype='integer' name='[% Direct + GO POS Orders (copy)_4002503800466333720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF STARTSWITH([application_client_name], &quot;GO&quot;) AND [application_integration_type] = &apos;DIRECT&apos; THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='# Direct POS Orders' datatype='integer' name='[% Direct POS Orders (copy)_4002503800466411545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [application_integration_type] = &apos;DIRECT&apos; THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='# Go Client Orders' datatype='integer' name='[% Go Client Orders (copy)_4002503800466509850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF STARTSWITH([application_client_name], &quot;GO&quot;) THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='# GoWEB Orders' datatype='integer' name='[% GoWEB Orders (copy)_4002503800466653212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [application_client_name] = &apos;GOWEB&apos; THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='# GoWIN Orders' datatype='integer' name='[% GoWIN Orders (copy)_4002503800466710557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [application_client_name] = &apos;GOWIN&apos; THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='# Godroid Orders' datatype='integer' name='[% Godroid Orders (copy)_4002503800466575387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [application_client_name] = &apos;GODROID&apos; THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='# Indirect POS Orders' datatype='integer' name='[% Indirect POS Orders (copy)_4002503800466821150]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [application_integration_type] = &apos;INDIRECT&apos; THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='# NGT Orders' datatype='integer' name='[% NGT Orders (copy)_4002503800466882591]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_ngt_device] = TRUE THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='# Own Delivery Orders' datatype='integer' name='[% Own Delivery Orders (copy)_4002503800466939936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [delivery_type] = &apos;OWN_DELIVERY&apos; THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='# POS Orders' datatype='integer' name='[% POS Orders (copy)_4002503800467079202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF NOT ISNULL([application_integration_type]) THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='# Pickup Orders' datatype='integer' name='[% Pickup Orders (copy)_4002503800467021857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [delivery_type] = &apos;PICKUP&apos; THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='# Pre-Orders' datatype='integer' name='[% Pre-Orders (copy)_4002503800467173411]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_preorder] THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='# Pre-Orders Failed Orders' datatype='integer' name='[% Pre-Orders Fail Rate (copy)_4002503800467226660]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_preorder] AND [order_status] != &apos;completed&apos; THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='# Pre-Orders Vendor Failed Orders' datatype='integer' name='[% Pre-Orders Vendor Fail Rate (copy)_4002503800467324965]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_preorder] AND [is_cancelled_by_vendor] THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='# Seamless Orders' datatype='integer' name='[% Seamless Orders (copy)_4002503800467537959]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_seamless_order] THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='# Vendor Delivery Orders' datatype='integer' name='[% Vendor Delivery Orders (copy)_4002503800467386406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [delivery_type] = &apos;VENDOR_DELIVERY&apos; THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='Avg. Vendor Late Time (mins)' datatype='real' name='[Avg. At Vendor Time Cleaned (copy)_5909004253172211745]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([vendor_late_sum])&#10;/&#10;SUM([vendor_late_count]))&#10;/&#10;60' />
            </column>
            <column caption='Avg. At Vendor Time Cleaned (mins)' datatype='real' name='[Avg. Estimated Prep Time (copy)_5909004253172052000]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([at_vendor_time_cleaned_sum])&#10;/&#10;sum([at_vendor_time_cleaned_count]))&#10;/&#10;60' />
            </column>
            <column caption='Avg. Estimated Prep Time (mins)' datatype='real' name='[Avg. Response Time (copy)_5909004253171912735]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([preparation_time])&#10;/&#10;sum([orders]))&#10;/&#10;60' />
            </column>
            <column caption='Summary - Is view absolute numbers?' datatype='boolean' name='[Calculation_4002503800463990803]' role='dimension' type='nominal'>
