      <column caption='% Pre-Orders Vendor Fail Rate' datatype='real' name='[% Pre-Orders Fail Rate (copy)_5909004253148061718]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_preorder] AND [is_cancelled_by_vendor] THEN [orders] ELSE 0 END)&#10;/&#10;SUM(IF [is_preorder] THEN [orders] ELSE 0 END)' />
      </column>
      <column caption='# Pre-Orders Vendor Failed Orders' datatype='integer' name='[% Pre-Orders Vendor Fail Rate (copy)_4002503800467324965]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_preorder] AND [is_cancelled_by_vendor] THEN [orders] ELSE 0 END)' />
      </column>
      <column caption='# Seamless Orders' datatype='integer' name='[% Seamless Orders (copy)_4002503800467537959]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_seamless_order] THEN [orders] ELSE 0 END)' />
      </column>
      <column caption='% Pickup Orders' datatype='real' name='[% VD Orders (copy)_5909004253147426834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [delivery_type] = &apos;PICKUP&apos; THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='# Vendor Delivery Orders' datatype='integer' name='[% Vendor Delivery Orders (copy)_4002503800467386406]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [delivery_type] = &apos;VENDOR_DELIVERY&apos; THEN [orders] ELSE 0 END)' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0h4ojdc11i4lzt10wpqhw0ga7osm].[sum:Calculation_5909004253173100578:qk]&quot;' value=' ' />
          <alias key='&quot;[federated.0h4ojdc11i4lzt10wpqhw0ga7osm].[sum:Line Break 1 (copy)_5909004253173157923:qk]&quot;' value='  ' />
          <alias key='&quot;[federated.0h4ojdc11i4lzt10wpqhw0ga7osm].[sum:Line Break 2 (copy)_5909004253173207076:qk]&quot;' value='   ' />
          <alias key='&quot;[federated.0h4ojdc11i4lzt10wpqhw0ga7osm].[sum:Line Break 3 (copy)_5909004253173231653:qk]&quot;' value='    ' />
          <alias key='&quot;[federated.0h4ojdc11i4lzt10wpqhw0ga7osm].[sum:Line Break 4 (copy)_5909004253484453932:qk]&quot;' value='     ' />
          <alias key='&quot;[federated.0h4ojdc11i4lzt10wpqhw0ga7osm].[sum:Line Break 5 (copy)_4002503800118476804:qk]&quot;' value='      ' />
          <alias key='&quot;[federated.0h4ojdc11i4lzt10wpqhw0ga7osm].[sum:orders:qk]&quot;' value='# Orders' />
        </aliases>
      </column>
      <column caption='Avg. Vendor Late Time (mins)' datatype='real' name='[Avg. At Vendor Time Cleaned (copy)_5909004253172211745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([vendor_late_sum])&#10;/&#10;SUM([vendor_late_count]))&#10;/&#10;60' />
      </column>
      <column caption='Avg. At Vendor Time Cleaned (mins)' datatype='real' name='[Avg. Estimated Prep Time (copy)_5909004253172052000]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([at_vendor_time_cleaned_sum])&#10;/&#10;sum([at_vendor_time_cleaned_count]))&#10;/&#10;60' />
      </column>
      <column caption='Avg. Estimated Prep Time (mins)' datatype='real' name='[Avg. Response Time (copy)_5909004253171912735]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([preparation_time])&#10;/&#10;sum([orders]))&#10;/&#10;60' />
      </column>
      <column caption='Order Growth sub-text (prior CW)' datatype='string' name='[Calculation_4002503800111595520]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos; vs. prior CW (CW &apos; + STR(WEEK(TODAY()) - 2) + &apos;)&apos;' />
      </column>
      <column caption='Order Growth subtext - cw' datatype='string' name='[Calculation_4002503800112287745]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;CW &apos; + STR(WEEK(TODAY()) - 1)' />
      </column>
      <column caption='Is prev. CW?' datatype='boolean' name='[Calculation_4002503800113766402]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='([Calculation_5909004253490094125] = (WEEK(TODAY()) - 1))' />
      </column>
      <column caption='% Seamless Orders' datatype='real' name='[Calculation_4002503800118296579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_seamless_order] THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='LB - KPI charts' datatype='string' name='[Calculation_4002503800119246854]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Summaries to the right are based on orders in previous calendar week&apos;' />
      </column>
      <column caption='Time Granularity - Fails' datatype='string' name='[Calculation_4002503800172343312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Orders - Summary - Time Granularity (copy)_4002503800169734156]&#10;  WHEN 1 THEN STR([created_date_local])&#10;  WHEN 2 THEN STR(YEAR([created_date_local])) + &apos;-&apos; + STR(WEEK([created_date_local]))&#10;  WHEN 3 THEN STR(YEAR([created_date_local])) + &apos;-&apos; + STR(MONTH([created_date_local]))&#10;END' />
      </column>
      <column caption='Summary - Is view absolute numbers?' datatype='boolean' name='[Calculation_4002503800463990803]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4] = &apos;# of orders&apos;' />
      </column>
      <column caption='% Vendor Failed Orders' datatype='real' name='[Calculation_5909004253107978240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_cancelled_by_vendor] = TRUE THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% Overall Failed Orders' datatype='real' name='[Calculation_5909004253121785857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] != &apos;completed&apos; THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='Dimension A' datatype='string' name='[Calculation_5909004253127929859]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Entity ID&apos; THEN [entity_id]&#10;WHEN &apos;Cancellation Owner&apos; THEN [cancellation_owner]&#10;WHEN &apos;Cancellation Reason&apos; THEN [cancellation_reason]&#10;WHEN &apos;Cancellation Stage&apos; THEN [cancellation_stage]&#10;WHEN &apos;Cancellation Source&apos; THEN [cancellation_source]&#10;WHEN &apos;Is Upcoming Order Cancelled?&apos; THEN STR([cancellation_is_upcoming_order])&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Transmission Flow&apos; THEN [transmission_flow]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;WHEN &apos;Delivery Type&apos; THEN [delivery_type]&#10;WHEN &apos;Client&apos; THEN [application_client_name]&#10;WHEN &apos;POS Integration Type&apos; THEN [application_integration_type]&#10;WHEN &apos;Is Preorder?&apos; THEN STR([is_preorder])&#10;WHEN &apos;Is Auto-Accept Configured?&apos; THEN STR([is_auto_accept_configured])&#10;END' />
      </column>
      <column caption='Orders - Fails - Table Metric' datatype='real' name='[Calculation_5909004253129814021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;% of all orders&apos;&#10;THEN&#10;(SUM([orders])&#10;/&#10;SUM({EXCLUDE [Calculation_5909004253127929859], [Orders - Fails - Dim A (copy)_5909004253129601028]: SUM([orders])}))&#10;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% of failed orders&apos;&#10;THEN&#10;(SUM([orders])&#10;/&#10;SUM({EXCLUDE [Calculation_5909004253127929859], [Orders - Fails - Dim A (copy)_5909004253129601028]: SUM(IF [order_status] != &apos;completed&apos; THEN [orders] ELSE 0 END)}))&#10;END' />
      </column>
      <column caption='# Orders' datatype='integer' name='[Calculation_5909004253145391110]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])' />
      </column>
      <column caption='% NGT Orders' datatype='real' name='[Calculation_5909004253145460743]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_ngt_device] = TRUE THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% Go Client Orders' datatype='real' name='[Calculation_5909004253145722888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF STARTSWITH([application_client_name], &quot;GO&quot;) THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% Godroid Orders' datatype='real' name='[Calculation_5909004253145964553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [application_client_name] = &apos;GODROID&apos; THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% POS Orders' datatype='real' name='[Calculation_5909004253146415116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF NOT ISNULL([application_integration_type]) THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% Direct POS Orders' datatype='real' name='[Calculation_5909004253146644493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [application_integration_type] = &apos;DIRECT&apos; THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% Direct + GO POS Orders' datatype='real' name='[Calculation_5909004253146906639]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF STARTSWITH([application_client_name], &quot;GO&quot;) AND [application_integration_type] = &apos;DIRECT&apos; THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% Own Delivery Orders' datatype='real' name='[Calculation_5909004253147164688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [delivery_type] = &apos;OWN_DELIVERY&apos; THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% Pre-Orders' datatype='real' name='[Calculation_5909004253147652115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_preorder] THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% Auto-Accept Configured Orders' datatype='real' name='[Calculation_5909004253168537626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_auto_accept_configured] THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='Avg. Response Time (seconds)' datatype='real' name='[Calculation_5909004253171650590]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([response_time])&#10;/&#10;sum([orders])' />
      </column>
      <column caption='Line Break 1' datatype='integer' name='[Calculation_5909004253173100578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='% Auto-Accept Configured Orders Auto-Accepted' datatype='real' name='[Calculation_5909004253483978795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_auto_accept_configured] AND [is_order_auto_accepted] THEN [orders] ELSE 0 END)&#10;/&#10;SUM(IF [is_auto_accept_configured] THEN [orders] ELSE 0 END)' />
      </column>
      <column caption='ISO Week' datatype='integer' name='[Calculation_5909004253490094125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WEEK([created_date_local])' />
      </column>
      <column caption='% Order Growth WoW' datatype='real' name='[Calculation_5909004253505216558]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='(SUM(IF [Calculation_5909004253490094125] = (WEEK(TODAY()) - 1) THEN [orders] ELSE 0 END)&#10;/&#10;SUM(IF [Calculation_5909004253490094125] = (WEEK(TODAY()) - 2) THEN [orders] ELSE 0 END))&#10;- 1' />
      </column>
      <column caption='Is % Order Growth WoW Positive?' datatype='boolean' name='[Calculation_5909004253507874863]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_5909004253505216558] &gt; 0' />
      </column>
      <column caption='Created Date Local - Months' datatype='date' name='[Created Date Local - Weeks (copy)_4002503800172236815]' role='dimension' type='quantitative' user:agg-type='Month-Trunc' user:base-field='created_date_local' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [created_date_local]))' scope-isolation='false' />
      </column>
      <column datatype='date' name='[Created Date Local - Weeks]' role='dimension' type='quantitative' user:agg-type='Week-Trunc' user:base-field='created_date_local' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [created_date_local]))' />
      </column>
      <column caption='LB - Summary' datatype='string' name='[LB - KPI charts (copy)_4002503800121962503]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Select the KPIs to display in the table below.&apos;' />
      </column>
      <column caption='LB - Filters' datatype='string' name='[LB - KPI charts (copy)_4002503800179150866]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Select a category to show more filters&apos;' />
      </column>
      <column caption='Line Break 2' datatype='integer' name='[Line Break 1 (copy)_5909004253173157923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='Line Break 3' datatype='integer' name='[Line Break 2 (copy)_5909004253173207076]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
