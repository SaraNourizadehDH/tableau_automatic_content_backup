        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='Line Break 6' datatype='integer' name='[Line Break 5 (copy)_4002503800118476804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='Dimension B' datatype='string' name='[Orders - Fails - Dim A (copy)_5909004253129601028]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Orders - Fails - Dimension A (copy)_5909004253127778306]&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Entity ID&apos; THEN [entity_id]&#10;WHEN &apos;Cancellation Owner&apos; THEN [cancellation_owner]&#10;WHEN &apos;Cancellation Reason&apos; THEN [cancellation_reason]&#10;WHEN &apos;Cancellation Stage&apos; THEN [cancellation_stage]&#10;WHEN &apos;Cancellation Source&apos; THEN [cancellation_source]&#10;WHEN &apos;Is Upcoming Order Cancelled?&apos; THEN STR([cancellation_is_upcoming_order])&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Transmission Flow&apos; THEN [transmission_flow]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;WHEN &apos;Delivery Type&apos; THEN [delivery_type]&#10;WHEN &apos;Client&apos; THEN [application_client_name]&#10;WHEN &apos;POS Integration Type&apos; THEN [application_integration_type]&#10;WHEN &apos;Is Preorder?&apos; THEN STR([is_preorder])&#10;WHEN &apos;Is Auto-Accept Configured?&apos; THEN STR([is_auto_accept_configured])&#10;END' />
      </column>
      <column caption='Dimension A ' datatype='string' name='[Orders - Fails - Dim A (copy)_5909004253175627816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Orders - Fails - Dimension A (copy)_5909004253175435302]&#10;WHEN &apos;All&apos; THEN &apos;&apos;&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Entity ID&apos; THEN [entity_id]&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Transmission Flow&apos; THEN [transmission_flow]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;WHEN &apos;Delivery Type&apos; THEN [delivery_type]&#10;WHEN &apos;Client&apos; THEN [application_client_name]&#10;WHEN &apos;POS Integration Type&apos; THEN [application_integration_type]&#10;WHEN &apos;Is Preorder?&apos; THEN STR([is_preorder])&#10;WHEN &apos;Is Auto-Accept Configured?&apos; THEN STR([is_auto_accept_configured])&#10;END' />
      </column>
      <column caption='Dimension B ' datatype='string' name='[Orders - Summary - Dim A (copy)_5909004253175709737]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Orders - Summary - Dimension A (copy)_5909004253175570471]&#10;WHEN &apos;All&apos; THEN &apos;&apos;&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Entity ID&apos; THEN [entity_id]&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Transmission Flow&apos; THEN [transmission_flow]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;WHEN &apos;Delivery Type&apos; THEN [delivery_type]&#10;WHEN &apos;Client&apos; THEN [application_client_name]&#10;WHEN &apos;POS Integration Type&apos; THEN [application_integration_type]&#10;WHEN &apos;Is Preorder?&apos; THEN STR([is_preorder])&#10;WHEN &apos;Is Auto-Accept Configured?&apos; THEN STR([is_auto_accept_configured])&#10;END' />
      </column>
      <column caption='Time Granularity - Summary' datatype='string' name='[Time Granularity - Fails (copy)_4002503800173506577]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;  WHEN 1 THEN STR([created_date_local])&#10;  WHEN 2 THEN STR(YEAR([created_date_local])) + &apos;-&apos; + STR(WEEK([created_date_local]))&#10;  WHEN 3 THEN STR(YEAR([created_date_local])) + &apos;-&apos; + STR(MONTH([created_date_local]))&#10;END' />
