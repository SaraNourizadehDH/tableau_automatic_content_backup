    <worksheet name='Outlier Percentages Across Cohorts'>
      <table>
        <view>
          <datasources>
            <datasource caption='smart_reco_active_vendor_cohorts_combined' name='federated.01pvh4o1l62u35178xytk07s2lmw' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
              <calculation class='tableau' formula='&quot;Orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.01pvh4o1l62u35178xytk07s2lmw'>
            <column caption='Selected Metric Z-Score' datatype='real' name='[Calculation_5274067032692543488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_5524790868239200259] - [Impressions Z-Score (copy)_5274067032697421830]) &#10;/ &#10;[Impressions AVG per Cohort (copy)_5274067032697516039]' />
            </column>
            <column caption='Selected Metric Outliers' datatype='string' name='[Calculation_5274067032695562242]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ABS([Calculation_5274067032692543488]) &gt; 2 THEN &quot;Outlier&quot; ELSE &quot;Normal&quot; END' />
            </column>
            <column aggregation='Sum' caption='Selected Metric Outliers per Cohort' datatype='integer' name='[Calculation_5274067032695693315]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [entity_id], [cohort_id], [cohort_type]: COUNTD(IF [Calculation_5274067032695562242] = &apos;Outlier&apos; THEN [vendor_code] END)}' />
            </column>
            <column aggregation='Sum' caption='Vendors per Cohort' datatype='integer' name='[Calculation_5274067032696307716]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [cohort_id], [entity_id], [cohort_type]: COUNTD([vendor_code])}' />
            </column>
            <column aggregation='Sum' caption='Selected Metric Outliers Percentage per Cohort' datatype='real' name='[Calculation_5274067032696602629]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Calculation_5274067032695693315] / [Calculation_5274067032696307716]' />
            </column>
            <column caption='Selected Metric' datatype='real' name='[Calculation_5524790868239200259]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Orders&quot; THEN IFNULL([total_orders], 0)&#10;WHEN &quot;GMV (Successful Orders)&quot; THEN IFNULL([successful_orders_gmv], 0)&#10;WHEN &quot;Impressions&quot; THEN IFNULL([impressions], 0)&#10;WHEN &quot;CVR&quot; THEN IFNULL([cvr], 0)&#10;WHEN &quot;New Customer Orders&quot; THEN IFNULL([new_customer_orders], 0)&#10;WHEN &quot;Retention Rate&quot; THEN IFNULL([retention_rate], 0)&#10;END' />
            </column>
            <column aggregation='Sum' caption='Selected Metric STDEV per Cohort' datatype='real' name='[Impressions AVG per Cohort (copy)_5274067032697516039]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [entity_id], [cohort_id], [cohort_type] : STDEV([Calculation_5524790868239200259]) }' />
            </column>
            <column aggregation='Sum' caption='Selected Metric AVG per Cohort' datatype='real' name='[Impressions Z-Score (copy)_5274067032697421830]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [entity_id], [cohort_id], [cohort_type] : AVG([Calculation_5524790868239200259]) }' />
            </column>
