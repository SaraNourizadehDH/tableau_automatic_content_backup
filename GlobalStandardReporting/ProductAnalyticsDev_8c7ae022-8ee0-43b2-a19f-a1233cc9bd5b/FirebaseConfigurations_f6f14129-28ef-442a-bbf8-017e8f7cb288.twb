      <column caption='Dimension A' datatype='string' name='[Calculation_1134344188016398343]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Entity ID&apos; THEN [entity_id]&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;&#10;WHEN &apos;Client&apos; THEN [client_name]&#10;WHEN &apos;POS Integration Type&apos; THEN [pos_integration_type]&#10;&#10;//Transmission flow&#10;//WHEN &apos;Delivery Type&apos; THEN [Delivery Type]&#10;//WHEN &apos;Is Preorder?&apos; THEN STR([Is Preorder])&#10;//WHEN &apos;Is Auto-Accept Configured?&apos; THEN STR([is_auto_accept_configured])&#10;&#10;END' />
      </column>
      <column caption='Dimension B' datatype='string' name='[Calculation_1134344188016865288]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Orders - Fails - Dimension A (copy)_5909004253127778306]&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Entity ID&apos; THEN [entity_id]&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;&#10;WHEN &apos;Client&apos; THEN [client_name]&#10;WHEN &apos;POS Integration Type&apos; THEN [pos_integration_type]&#10;&#10;//Transmission flow&#10;//WHEN &apos;Delivery Type&apos; THEN [Delivery Type]&#10;//WHEN &apos;Is Preorder?&apos; THEN STR([Is Preorder])&#10;//WHEN &apos;Is Auto-Accept Configured?&apos; THEN STR([is_auto_accept_configured])&#10;&#10;END' />
      </column>
      <column caption='info button' datatype='string' name='[Calculation_1313291885395673088]' role='dimension' type='nominal'>
