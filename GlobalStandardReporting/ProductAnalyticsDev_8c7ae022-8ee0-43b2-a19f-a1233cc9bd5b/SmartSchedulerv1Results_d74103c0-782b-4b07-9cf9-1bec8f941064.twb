      <column caption='NO_STAFF' datatype='boolean' name='[SAT_HOURS (copy)_219409750243438594]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS([reason], &apos;NO_STAFF&apos;)' />
