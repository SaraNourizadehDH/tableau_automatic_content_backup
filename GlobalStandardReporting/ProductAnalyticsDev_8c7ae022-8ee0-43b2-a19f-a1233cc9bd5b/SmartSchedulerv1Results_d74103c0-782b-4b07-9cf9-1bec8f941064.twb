      <column caption='SAT_HOURS' datatype='boolean' name='[Calculation_219409750243299328]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS([reason], &apos;SAT_HOURS&apos;)' />
      </column>
      <column caption='# Orders - Delta Divergence' datatype='real' name='[Calculation_219409750256844806]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;SUM(IF [experiment_group] = &apos;Pilot&apos; AND [Calculation_219409750257115143] = &apos;Post&apos; THEN [total_orders] ELSE 0 END)&#10;/&#10;SUM(IF [experiment_group] = &apos;Control&apos; AND [Calculation_219409750257115143] = &apos;Post&apos; THEN [total_orders] ELSE 0 END)&#10;)&#10;-&#10;(&#10;SUM(IF [experiment_group] = &apos;Pilot&apos; AND [Calculation_219409750257115143] = &apos;Pre&apos; THEN [total_orders] ELSE 0 END)&#10;/&#10;SUM(IF [experiment_group] = &apos;Control&apos; AND [Calculation_219409750257115143] = &apos;Pre&apos; THEN [total_orders] ELSE 0 END)&#10;)' />
      </column>
      <column caption='Rollout Phase' datatype='string' name='[Calculation_219409750257115143]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [entity_id]&#10;  WHEN IN (&apos;FP_BD&apos;, &apos;FP_MY&apos;)&#10;    THEN IF [created_date_local] &lt;= DATE(&apos;2024-09-18&apos;) THEN &apos;Pre&apos; ELSE &apos;Post&apos; END&#10;  WHEN &apos;FP_PH&apos;&#10;    THEN IF [created_date_local] &lt;= DATE(&apos;2024-09-04&apos;) THEN &apos;Pre&apos; ELSE &apos;Post&apos; END&#10;END' />
      </column>
      <column caption='# All Contacts - Delta Divergence' datatype='real' name='[Calculation_219409750271582217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;SUM(IF [experiment_group] = &apos;Pilot&apos; AND [Calculation_219409750257115143] = &apos;Post&apos; THEN [all_contacts] ELSE 0 END)&#10;/&#10;SUM(IF [experiment_group] = &apos;Control&apos; AND [Calculation_219409750257115143] = &apos;Post&apos; THEN [all_contacts] ELSE 0 END)&#10;)&#10;-&#10;(&#10;SUM(IF [experiment_group] = &apos;Pilot&apos; AND [Calculation_219409750257115143] = &apos;Pre&apos; THEN [all_contacts] ELSE 0 END)&#10;/&#10;SUM(IF [experiment_group] = &apos;Control&apos; AND [Calculation_219409750257115143] = &apos;Pre&apos; THEN [all_contacts] ELSE 0 END)&#10;)' />
      </column>
      <column caption='Blank 1' datatype='integer' name='[Calculation_219409750272888844]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INT(&apos;&apos;)' />
      </column>
      <column caption='% Offline Duration' datatype='real' name='[Calculation_219409750274179086]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([offline_duration])&#10;/&#10;SUM([slot_duration])' />
      </column>
      <column caption='% Order Uplift' datatype='real' name='[Calculation_219409750283239442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 &#10;-&#10;(&#10;SUM(IF [Calculation_219409750257115143] = &apos;Post&apos; THEN [total_orders] ELSE 0 END)&#10;/&#10;SUM(IF [Calculation_219409750257115143] = &apos;Pre&apos; THEN [total_orders] ELSE 0 END)&#10;)' />
      </column>
      <column caption='Vendor Segment' datatype='string' name='[Calculation_219409750283485203]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_6560970668299730947] &gt; 1&#10;  THEN &apos;Accepted Vendors&apos;&#10;  ELSE MAX([experiment_group])&#10;END' />
      </column>
      <column caption='Unique Vendor' datatype='string' name='[Calculation_6560970668292673536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[entity_id] + [vendor_code]' />
      </column>
      <column caption='Pilot Vendor Count' datatype='integer' name='[Calculation_6560970668295565313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [experiment_group] = &apos;Pilot&apos;&#10;  THEN [Calculation_6560970668292673536]&#10;ELSE NULL&#10;END&#10;)' />
      </column>
      <column caption='All Vendor Count' datatype='integer' name='[Calculation_6560970668299419650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_6560970668292673536])' />
      </column>
      <column caption='Reco Accepted Vendors' datatype='integer' name='[Calculation_6560970668299730947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [changes_submitted] = 1 AND IFNULL([not_interested],0) = 0 and IFNULL([reco_dismissed],0) = 0&#10;  THEN [Calculation_6560970668292673536]&#10;ELSE NULL&#10;END&#10;)' />
      </column>
      <column caption='vFR' datatype='real' name='[Calculation_6560970668302217220]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([total_orders]) - SUM([successful_orders]))&#10;/&#10;SUM([total_orders])' />
