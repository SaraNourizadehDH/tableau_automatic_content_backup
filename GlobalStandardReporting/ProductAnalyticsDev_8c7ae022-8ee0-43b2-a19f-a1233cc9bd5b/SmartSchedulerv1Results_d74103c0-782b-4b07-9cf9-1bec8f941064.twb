    <worksheet name='Delta Divergence'>
      <table>
        <view>
          <datasources>
            <datasource caption='smart_scheduler_table_1 (pa_scheduled_queries)' name='federated.0itp4j41aml27h1g6997z0ps5lfj' />
          </datasources>
          <datasource-dependencies datasource='federated.0itp4j41aml27h1g6997z0ps5lfj'>
            <column caption='# Live Order Contacts - Delta Divergence' datatype='real' name='[# All Contacts - Delta Divergence (copy) (copy)_219409750272536587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(IF [experiment_group] = &apos;Pilot&apos; AND [Calculation_219409750257115143] = &apos;Post&apos; THEN [live_order_contacts] ELSE 0 END)&#10;/&#10;SUM(IF [experiment_group] = &apos;Control&apos; AND [Calculation_219409750257115143] = &apos;Post&apos; THEN [live_order_contacts] ELSE 0 END)&#10;)&#10;-&#10;(&#10;SUM(IF [experiment_group] = &apos;Pilot&apos; AND [Calculation_219409750257115143] = &apos;Pre&apos; THEN [live_order_contacts] ELSE 0 END)&#10;/&#10;SUM(IF [experiment_group] = &apos;Control&apos; AND [Calculation_219409750257115143] = &apos;Pre&apos; THEN [live_order_contacts] ELSE 0 END)&#10;)' />
            </column>
            <column caption='# Vendor Contacts - Delta Divergence' datatype='real' name='[# All Contacts - Delta Divergence (copy)_219409750272491530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(IF [experiment_group] = &apos;Pilot&apos; AND [Calculation_219409750257115143] = &apos;Post&apos; THEN [vendor_contacts] ELSE 0 END)&#10;/&#10;SUM(IF [experiment_group] = &apos;Control&apos; AND [Calculation_219409750257115143] = &apos;Post&apos; THEN [vendor_contacts] ELSE 0 END)&#10;)&#10;-&#10;(&#10;SUM(IF [experiment_group] = &apos;Pilot&apos; AND [Calculation_219409750257115143] = &apos;Pre&apos; THEN [vendor_contacts] ELSE 0 END)&#10;/&#10;SUM(IF [experiment_group] = &apos;Control&apos; AND [Calculation_219409750257115143] = &apos;Pre&apos; THEN [vendor_contacts] ELSE 0 END)&#10;)' />
            </column>
            <column caption='%VFR - Delta Divergence' datatype='real' name='[# Orders - Delta Divergence (copy)_219409750257868808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(&#10;SUM(IF [experiment_group] = &apos;Pilot&apos; AND [Calculation_219409750257115143] = &apos;Post&apos; THEN ([total_orders] - [successful_orders]) ELSE 0 END)&#10;/&#10;SUM(IF [experiment_group] = &apos;Pilot&apos; AND [Calculation_219409750257115143] = &apos;Post&apos; THEN ([total_orders]) ELSE 0 END)&#10;)&#10;/&#10;(&#10;SUM(IF [experiment_group] = &apos;Control&apos; AND [Calculation_219409750257115143] = &apos;Post&apos; THEN [total_orders] - [successful_orders] ELSE 0 END)&#10;/&#10;SUM(IF [experiment_group] = &apos;Control&apos; AND [Calculation_219409750257115143] = &apos;Post&apos; THEN [total_orders] ELSE 0 END)&#10;)&#10;)&#10;-&#10;(&#10;(&#10;SUM(IF [experiment_group] = &apos;Pilot&apos; AND [Calculation_219409750257115143] = &apos;Pre&apos; THEN [total_orders] - [successful_orders] ELSE 0 END)&#10;/&#10;SUM(IF [experiment_group] = &apos;Pilot&apos; AND [Calculation_219409750257115143] = &apos;Pre&apos; THEN [total_orders] ELSE 0 END)&#10;)&#10;/&#10;(&#10;SUM(IF [experiment_group] = &apos;Control&apos; AND [Calculation_219409750257115143] = &apos;Pre&apos; THEN [total_orders] - [successful_orders] ELSE 0 END)&#10;/&#10;SUM(IF [experiment_group] = &apos;Control&apos; AND [Calculation_219409750257115143] = &apos;Pre&apos; THEN [total_orders] ELSE 0 END)&#10;)&#10;)' />
            </column>
            <column caption='Schedule Duration - Delta Divergence' datatype='real' name='[# Orders - Delta Divergence (copy)_219409750280921104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(IF [experiment_group] = &apos;Pilot&apos; AND [Calculation_219409750257115143] = &apos;Post&apos; THEN [slot_duration] ELSE 0 END)&#10;/&#10;SUM(IF [experiment_group] = &apos;Control&apos; AND [Calculation_219409750257115143] = &apos;Post&apos; THEN [slot_duration] ELSE 0 END)&#10;)&#10;-&#10;(&#10;SUM(IF [experiment_group] = &apos;Pilot&apos; AND [Calculation_219409750257115143] = &apos;Pre&apos; THEN [slot_duration] ELSE 0 END)&#10;/&#10;SUM(IF [experiment_group] = &apos;Control&apos; AND [Calculation_219409750257115143] = &apos;Pre&apos; THEN [slot_duration] ELSE 0 END)&#10;)' />
            </column>
            <column caption='Blank 2' datatype='integer' name='[Blank 1 (copy)_219409750280830991]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='INT(&apos;&apos;)' />
            </column>
            <column caption='# Orders - Delta Divergence' datatype='real' name='[Calculation_219409750256844806]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;SUM(IF [experiment_group] = &apos;Pilot&apos; AND [Calculation_219409750257115143] = &apos;Post&apos; THEN [total_orders] ELSE 0 END)&#10;/&#10;SUM(IF [experiment_group] = &apos;Control&apos; AND [Calculation_219409750257115143] = &apos;Post&apos; THEN [total_orders] ELSE 0 END)&#10;)&#10;-&#10;(&#10;SUM(IF [experiment_group] = &apos;Pilot&apos; AND [Calculation_219409750257115143] = &apos;Pre&apos; THEN [total_orders] ELSE 0 END)&#10;/&#10;SUM(IF [experiment_group] = &apos;Control&apos; AND [Calculation_219409750257115143] = &apos;Pre&apos; THEN [total_orders] ELSE 0 END)&#10;)' />
            </column>
            <column caption='Rollout Phase' datatype='string' name='[Calculation_219409750257115143]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [entity_id]&#10;  WHEN IN (&apos;FP_BD&apos;, &apos;FP_MY&apos;)&#10;    THEN IF [created_date_local] &lt;= DATE(&apos;2024-09-18&apos;) THEN &apos;Pre&apos; ELSE &apos;Post&apos; END&#10;  WHEN &apos;FP_PH&apos;&#10;    THEN IF [created_date_local] &lt;= DATE(&apos;2024-09-04&apos;) THEN &apos;Pre&apos; ELSE &apos;Post&apos; END&#10;END' />
            </column>
            <column caption='# All Contacts - Delta Divergence' datatype='real' name='[Calculation_219409750271582217]' role='measure' type='quantitative'>
