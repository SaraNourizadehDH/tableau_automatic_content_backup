      <table>
        <view>
          <datasources>
            <datasource caption='order billing + user entitlement' name='federated.0hr6f8u087m4kg1bqrbfm17yze5s' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Date Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column alias='Variant A' caption='Select Variant' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Variant A&quot;'>
              <calculation class='tableau' formula='&quot;Variant A&quot;' />
              <aliases>
                <alias key='&quot;Variant A&quot;' value='Variant A' />
              </aliases>
            </column>
            <column caption='Select Metric' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Billing Inquiries Contact - Clicked Orders&quot;'>
              <calculation class='tableau' formula='&quot;% Billing Inquiries Contact - Clicked Orders&quot;' />
              <aliases>
                <alias key='&quot;\# Orders&quot;' value='# Orders' />
                <alias key='&quot;\% Contact Rate&quot;' value='% Contact Rate' />
                <alias key='&quot;\% Order Billing Contact Rate&quot;' value='% Billing Inquiries Contact Rate' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hr6f8u087m4kg1bqrbfm17yze5s'>
            <column caption='%  Billing Contact Rate   ' datatype='real' default-format='p0.000%' name='[%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_4565524149296615449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([billing_contacts])&#10;    /&#10;    SUM([orders])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_4565524149295542293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Contact Rate (copy)_7010697278586339343]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([all_contacts])/SUM([orders])' />
            </column>
            <column caption='% Vendor Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Fail Rate (copy)_4565524149295779862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_contacts])/SUM([orders])' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_4868320897008328704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Plugin Clicked Vendors' datatype='real' name='[Calculation_1031605822665142272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([plugin_clicked_vendors])/SUM([vendors])' />
            </column>
            <column caption='% Order Detail Clicked Vendors' datatype='real' name='[Calculation_1031605822684499979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_details_clicked_vendors])/SUM([vendors])' />
            </column>
            <column caption='% Download Order Report Vendors' datatype='real' name='[Calculation_1031605823045521424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([download_orders_clicked_vendors])/SUM([vendors])' />
            </column>
            <column caption='% Rider Contact Rate' datatype='real' name='[Calculation_2434195638697463808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_contacts])/SUM([orders])' />
            </column>
            <column caption='% Customer Contact Rate' datatype='real' name='[Calculation_2434195638697549825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_contacts])/SUM([orders])' />
            </column>
            <column caption='% Order Detail Clicked Orders' datatype='real' name='[Calculation_3612942477643784192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([clicked_orders])/SUM([orders])' />
            </column>
            <column caption='Metrics' datatype='real' name='[Calculation_3902369094159556608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN [% Vendor Fail Rate (copy)_4868320897008328704]&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN [% Item Unavailable Fail Rate (copy)_4565524149295542293]&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN[% Vendor Contact Rate (copy)_7010697278586339343]&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN [% Vendor Fail Rate (copy)_4565524149295779862]&#10;WHEN &quot;% Rider Contact Rate&quot; THEN [Calculation_2434195638697463808]&#10;WHEN &quot;% Customer Contact Rate&quot; THEN [Calculation_2434195638697549825]&#10;WHEN &quot;% Order Billing Contact Rate&quot; THEN [%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_4565524149296615449]&#10;WHEN &quot;% Billing Inquiries Contact - Clicked Orders&quot; THEN [Calculation_823243982809722880]&#10;&#10;// % Vendors&#10;WHEN &apos;% Download Order Report Vendors&apos; THEN [Calculation_1031605823045521424]&#10;WHEN &apos;% Order Detail Clicks Vendors&apos; THEN [Calculation_1031605822684499979]&#10;WHEN &apos;% Oder Plugin Clicks Vendors&apos; THEN [Calculation_1031605822665142272]&#10;WHEN &apos;% Order Detail Clicked Orders&apos; THEN [Calculation_3612942477643784192]&#10;&#10;//int value&#10;WHEN &apos;# Orders&apos; THEN SUM([orders])&#10;WHEN &apos;# Billing Inquiries Contacts&apos; THEN SUM([billing_contacts])&#10;WHEN &apos;# Order Plugin Clicks&apos; THEN SUM([plugin_clicks])&#10;&#10;WHEN &apos;Billing Inquiry Contact Cost Est (EUR)&apos; THEN SUM([billing_contacts_cost_eur_est])&#10;WHEN &apos;Billing Inquiry Clicked Order Contact Cost Est (EUR)&apos; THEN SUM([billing_contacts_clicked_order_cost_eur_est])&#10;&#10;END' />
            </column>
            <column caption='Metrics (∆)' datatype='real' name='[Calculation_3902369094162780161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(   // varient A&#10;    (SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [Calculation_3902369094162980866] END)&#10;      / [Calculation_3902369094168502277]&#10;     ) &#10;    &#10;/&#10;  // Baseline&#10;    (SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [Calculation_3902369094162980866] END)&#10;    /[Calculation_3902369094168055812]&#10;    )&#10;)&#10;- 1' />
            </column>
            <column caption='∆  Metrics Numerator' datatype='integer' name='[Calculation_3902369094162980866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN [failed_orders]&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN [vendor_failed_orders]&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN [all_contacts]&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN [vendor_contacts]&#10;WHEN &quot;% Rider Contact Rate&quot; THEN [rider_contacts]&#10;WHEN &quot;% Customer Contact Rate&quot; THEN [customer_contacts]&#10;WHEN &quot;% Order Billing Contact Rate&quot; THEN [billing_contacts]&#10;WHEN &quot;% Billing Inquiries Contact - Clicked Orders&quot; THEN [billing_contacts_clicked_orders]&#10;&#10;//%vendors&#10;WHEN &apos;% Download Order Report Vendors&apos; THEN [download_orders_clicked_vendors]&#10;WHEN &apos;% Order Detail Clicks Vendors&apos; THEN [order_details_clicked_vendors]&#10;WHEN &apos;% Oder Plugin Clicks Vendors&apos; THEN [plugin_clicked_vendors]&#10;WHEN &apos;% Order Detail Clicked Orders&apos; THEN [clicked_orders]&#10;&#10;&#10;END' />
            </column>
            <column caption='∆  Metrics Denominator - Baseline' datatype='integer' name='[Calculation_3902369094168055812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Customer Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% No Response Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Item Unavailable Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Rider Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Customer Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Order Billing Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Billing Inquiries Contact - Clicked Orders&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [clicked_orders] END)&#10;//&#10;WHEN &quot;% Download Order Report Vendors&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [vendors] END)&#10;WHEN &quot;% Order Detail Clicks Vendors&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [vendors] END)&#10;WHEN &quot;% Oder Plugin Clicks Vendors&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [vendors] END)&#10;WHEN &quot;% Order Detail Clicked Orders&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;//int&#10;WHEN &apos;# Billing Inquiries Contacts&apos; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [billing_contacts] END)&#10;WHEN &apos;# Order Plugin Clicks&apos; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [plugin_clicks] END)&#10;END' />
            </column>
            <column caption='∆  Metrics Denominator - Variant A' datatype='integer' name='[Calculation_3902369094168502277]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Customer Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% No Response Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Item Unavailable Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Rider Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Customer Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Order Billing Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Billing Inquiries Contact - Clicked Orders&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [clicked_orders] END)&#10;&#10;// %vendors&#10;WHEN &quot;% Download Order Report Vendors&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [vendors] END)&#10;WHEN &quot;% Order Detail Clicks Vendors&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [vendors] END)&#10;WHEN &quot;% Oder Plugin Clicks Vendors&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [vendors] END)&#10;WHEN &quot;% Order Detail Clicked Orders&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;&#10;//int&#10;WHEN &apos;# Billing Inquiries Contacts&apos; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [billing_contacts] END)&#10;WHEN &apos;# Order Plugin Clicks&apos; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [plugin_clicks] END)&#10;&#10;END' />
            </column>
            <column caption='_int_metrics' datatype='string' name='[Calculation_4047962031569936392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 4]' />
            </column>
            <column caption='_granularity_filter' datatype='boolean' name='[Calculation_4565524148946161665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &quot;Daily&quot; THEN [date_type] = &quot;Daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [date_type] = &quot;Weekly&quot;&#10;&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_4565524148946345986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date_local]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date_local]))+&quot;-W&quot;+STR([weeks])&#10;END' />
            </column>
            <column caption='% Billing Contact Rate - Clicked Orders' datatype='real' name='[Calculation_823243982809722880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([billing_contacts_clicked_orders])/SUM([clicked_orders])' />
            </column>
            <column caption='Variants filter' datatype='boolean' name='[Variants (copy)_1879126963555889156]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;&#10;WHEN &quot;Variant A&quot; THEN [experiment_group] IN (&quot;Variant A&quot;, &quot;Baseline&quot;)&#10;WHEN &quot;Variant B&quot; THEN [experiment_group] IN (&quot;Variant B&quot;, &quot;Baseline&quot;)&#10;&#10;END' />
