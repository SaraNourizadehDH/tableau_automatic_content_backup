      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000'>Order Billing v3</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' value='center' />
          <format attr='wrap' value='on' />
        </style-rule>
        <style-rule element='parameter-ctrl'>
          <format attr='background-color' value='#ffffff' />
          <format attr='border-width' value='0' />
          <format attr='border-style' value='none' />
        </style-rule>
        <style-rule element='parameter-ctrl-title'>
          <format attr='text-align' value='left' />
        </style-rule>
      </style>
      <size maxheight='1400' maxwidth='1300' minheight='1400' minwidth='1300' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='order billing + user entitlement' name='federated.0hr6f8u087m4kg1bqrbfm17yze5s' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Select Date Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
          <calculation class='tableau' formula='&quot;Weekly&quot;' />
          <members>
            <member value='&quot;Daily&quot;' />
            <member value='&quot;Weekly&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.0hr6f8u087m4kg1bqrbfm17yze5s'>
        <column caption='Date' datatype='string' name='[Calculation_4565524148946345986]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date_local]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date_local]))+&quot;-W&quot;+STR([weeks])&#10;END' />
        </column>
        <column caption='Entity Id' datatype='string' name='[entity_id]' role='dimension' type='nominal' />
        <column caption='Experiment' datatype='string' name='[experiment]' role='dimension' type='nominal' />
