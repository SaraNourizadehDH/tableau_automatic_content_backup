        <calculation class='tableau' formula='(   // varient A&#10;    (SUM(IF [experiment_group] = [Parameters].[Parameter 2] THEN [customer_contacts] END)&#10;      / SUM(IF [experiment_group] = [Parameters].[Parameter 2] THEN [orders] END) &#10;     ) &#10;    &#10;/&#10;  // Baseline&#10;    (SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [customer_contacts] END)&#10;    / SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END) &#10;    )&#10;)&#10;- 1' />
