        <calculation class='tableau' formula='(&#10;    (&#10;    SUM({ INCLUDE [date_type]:&#10;     &#10;        SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [seconds_to_autoaccept] END)&#10;        })&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;     &#10;        SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;        })&#10;    )&#10;    &#10;    -&#10;    &#10;    (&#10;         SUM({ INCLUDE [date_type]:&#10;            SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [seconds_to_autoaccept] END)&#10;            })&#10;        /&#10;         SUM({ INCLUDE [date_type]:&#10;            SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;            })&#10;    )&#10;&#10;)&#10;&#10;-&#10;&#10;(&#10;    (&#10;    SUM({ INCLUDE [date_type]:&#10;     &#10;        SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [seconds_to_autoaccept] END)&#10;        })&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;     &#10;        SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;        })&#10;    )&#10;    &#10;    -&#10;    &#10;    (&#10;         SUM({ INCLUDE [date_type]:&#10;            SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [seconds_to_autoaccept] END)&#10;            })&#10;        /&#10;         SUM({ INCLUDE [date_type]:&#10;            SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;            })&#10;    )&#10;&#10;)' />
      </column>
      <column caption='%On Time  Orders (Pre - Post ∆ Divergence)' datatype='real' name='[Calculation_2434195638724280358]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    (&#10;    SUM({ INCLUDE [date_type]:&#10;     &#10;        SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [on_time_order] END)&#10;        })&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;     &#10;        SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;        })&#10;    )&#10;    &#10;    -&#10;    &#10;    (&#10;         SUM({ INCLUDE [date_type]:&#10;            SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [on_time_order] END)&#10;            })&#10;        /&#10;         SUM({ INCLUDE [date_type]:&#10;            SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;            })&#10;    )&#10;&#10;)&#10;&#10;-&#10;&#10;(&#10;    (&#10;    SUM({ INCLUDE [date_type]:&#10;     &#10;        SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [on_time_order] END)&#10;        })&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;     &#10;        SUM(IF [experiment_group] = [Parameters].[Parameter 2] AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;        })&#10;    )&#10;    &#10;    -&#10;    &#10;    (&#10;         SUM({ INCLUDE [date_type]:&#10;            SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [on_time_order] END)&#10;            })&#10;        /&#10;         SUM({ INCLUDE [date_type]:&#10;            SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;            })&#10;    )&#10;&#10;)' />
