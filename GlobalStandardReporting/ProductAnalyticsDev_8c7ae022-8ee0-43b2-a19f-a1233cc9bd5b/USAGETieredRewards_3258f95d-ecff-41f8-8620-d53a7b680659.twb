    <worksheet name='Goals Missed # of Vendors'>
      <table>
        <view>
          <datasources>
            <datasource caption='growth_vendor_tiered_rewards_movement' name='federated.0z5nel31gqc4sz1guvsti1ccxndv' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Vendor Engagement Type' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Targeted Vendors&quot;'>
              <calculation class='tableau' formula='&quot;Targeted Vendors&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0z5nel31gqc4sz1guvsti1ccxndv'>
            <column caption='# Missed Vendors: Price Parity' datatype='integer' name='[# Missed Vendors: Ratings and Reviews (copy)_1403574982694535199]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Goal Hit: Vendor Delay Rate (copy)_1403574982379364373] = FALSE THEN [Calculation_4495859117641125890] END)' />
            </column>
            <column caption='OneWeb Engaged Vendor Code' datatype='string' name='[Calculation_1050816465683890181]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [oneweb_events] &gt; 0 THEN [vendor_code] END' />
            </column>
            <column caption='# Missed Vendors: Customer Contact Rate' datatype='integer' name='[Calculation_294493205101588519]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Current Score: Customer Contact Rate (copy)_294493205079191566] = FALSE THEN [Calculation_4495859117641125890] END)' />
            </column>
            <column caption='Target Tier (from Previous Tier)' datatype='string' name='[Calculation_294493205105606704]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [previous_tier]&#10;WHEN &apos;NONE&apos; THEN &apos;STARTER&apos;&#10;WHEN &apos;STARTER&apos; THEN &apos;ADVANCED&apos;&#10;WHEN &apos;ADVANCED&apos; THEN &apos;EXPERT&apos;&#10;WHEN &apos;EXPERT&apos; THEN &apos;EXPERT&apos;&#10;END' />
            </column>
            <column caption='Unique Vendor Code' datatype='string' name='[Calculation_4495859117641125890]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &quot;Targeted Vendors&quot; THEN [vendor_code]&#10;WHEN &quot;Vendors Engaged with OneWeb&quot; THEN [Calculation_1050816465683890181]&#10;WHEN &quot;Vendors Engaged with Rewards&quot; THEN [Portal Engaged Vendor Code (copy)_1050816465684070406]&#10;WHEN &quot;Single Vendors Engaged with Rewards&quot; THEN [Rewards Engaged Vendor Code (copy)_1050816465684197383]&#10;END' />
            </column>
            <column caption='Goal Hit: Customer Contact Rate' datatype='boolean' name='[Current Score: Customer Contact Rate (copy)_294493205079191566]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Tier Threshold: Customer Contact Rate (copy)_1403574982372605953] &gt; 0&#10;THEN (&#10;    IF [metric_value_customer_contact_rate] &lt;= [Tier Threshold: Customer Contact Rate (copy)_1403574982372605953]&#10;        THEN TRUE&#10;    ELSEIF [metric_value_customer_contact_rate] &gt; [Tier Threshold: Customer Contact Rate (copy)_1403574982372605953]&#10;        THEN FALSE&#10;    END&#10;)&#10;END' />
