    <worksheet name='Interaction Breakdown: Vendors (%) (Goals - Tiers)'>
      <table>
        <view>
          <datasources>
            <datasource caption='growth_vendor_tiered_rewards_engagement' name='federated.03xqotj1etxqj518ocyvl0n4n3lx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Value Type' datatype='string' name='[Interaction Level (copy)_5448722283260039190]' param-domain-type='list' role='measure' type='nominal' value='&quot;Percentages (\%)&quot;'>
              <calculation class='tableau' formula='&quot;Percentages (%)&quot;' />
            </column>
            <column caption='Baseline Vendor Group' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Targeted Vendors&quot;'>
              <calculation class='tableau' formula='&quot;Targeted Vendors&quot;' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
            <column caption='Events with Further Granularity' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Goals - Tier&quot;'>
              <calculation class='tableau' formula='&quot;Goals - Tier&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03xqotj1etxqj518ocyvl0n4n3lx'>
            <column caption='Total Targeted Vendors' datatype='integer' name='[Calculation_2259399644860182615]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_code])' />
            </column>
            <column caption='Events with Further Granularity' datatype='string' name='[Calculation_2259399644869091417]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 4]' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_2344545861120446492]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Day&quot; THEN STR(DATE([created_date]))&#10;WHEN &quot;Week&quot; THEN STR(YEAR([created_date]))+&quot;-W&quot;+STR(DATEPART(&apos;week&apos;,[created_date],&apos;monday&apos;))&#10;WHEN &quot;Month&quot; THEN STR(YEAR([created_date]))+&quot;-M&quot;+STR(MONTH([created_date]))&#10;END' />
            </column>
            <column caption='Selected Vendor Group' datatype='integer' name='[Calculation_2676967800380604416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Targeted Vendors&quot; THEN [Calculation_2259399644860182615]&#10;WHEN &quot;Vendors Engaged with OneWeb&quot; THEN [Total Vendors Engaged with Rewards (copy)_2004312946861740033]&#10;WHEN &quot;Vendors Engaged with Rewards&quot; THEN [Total Rewards Related Events per Vendor (copy)_2676967800383885315]&#10;END' />
            </column>
            <column caption='OneWeb Events' datatype='integer' name='[Calculation_3321264038371299330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF[client_name] = &quot;ONEWEB&quot; THEN [events] END' />
            </column>
            <column caption='Value Type' datatype='string' name='[Calculation_5448722283261169687]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Interaction Level (copy)_5448722283260039190]' />
            </column>
            <column caption='Goals - Tier: Advanced # Vendors' datatype='integer' name='[Goals - Tier # Vendors (copy)_315181657579511935]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [rewards_goals_tier_click_advanced_tier_events] &gt; 0 THEN [vendor_code] END)' />
            </column>
            <column caption='Goals - Tier: Advanced % Vendors' datatype='real' name='[Goals - Tier % Vendors (copy)_315181657579511936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Goals - Tier # Vendors (copy)_315181657579511935]/[Calculation_2676967800380604416]' />
            </column>
            <column caption='Goals - Tier: Expert # Vendors' datatype='integer' name='[Goals - Tier: Advanced # Vendors (copy)_315181657579954305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [rewards_goals_tier_click_expert_tier_events] &gt; 0 THEN [vendor_code] END)' />
            </column>
            <column caption='Goals - Tier: Expert % Vendors' datatype='real' name='[Goals - Tier: Advanced % Vendors (copy)_315181657579954306]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Goals - Tier: Advanced # Vendors (copy)_315181657579954305]/[Calculation_2676967800380604416]' />
            </column>
            <column caption='Goals - Tier: Starter # Vendors' datatype='integer' name='[Goals - Tier: Expert # Vendors (copy)_315181657581215875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [rewards_goals_tier_click_starter_tier_events] &gt; 0 THEN [vendor_code] END)' />
            </column>
            <column caption='Goals - Tier: Starter % Vendors' datatype='real' name='[Goals - Tier: Expert % Vendors (copy)_315181657581215876]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Goals - Tier: Expert # Vendors (copy)_315181657581215875]/[Calculation_2676967800380604416]' />
