              <calculation class='tableau' formula='COUNTD([vendor_code])' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_2344545861120446492]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Day&quot; THEN STR(DATE([created_date]))&#10;WHEN &quot;Week&quot; THEN STR(YEAR([created_date]))+&quot;-W&quot;+STR(DATEPART(&apos;week&apos;,[created_date],&apos;monday&apos;))&#10;WHEN &quot;Month&quot; THEN STR(YEAR([created_date]))+&quot;-M&quot;+STR(MONTH([created_date]))&#10;END' />
            </column>
            <column caption='Selected Vendor Group' datatype='integer' name='[Calculation_2676967800380604416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &quot;Targeted Vendors&quot; THEN [Calculation_2259399644860182615]&#10;WHEN &quot;Vendors Engaged with OneWeb&quot; THEN [Total Vendors Engaged with Rewards (copy)_2004312946861740033]&#10;WHEN &quot;Vendors Engaged with Rewards&quot; THEN [Total Rewards Related Events per Vendor (copy)_2676967800383885315]&#10;END' />
            </column>
            <column caption='OneWeb Events' datatype='integer' name='[Calculation_3321264038371299330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF[client_name] = &quot;ONEWEB&quot; THEN [events] END' />
            </column>
            <column caption='Rewards Adoption Rate' datatype='real' name='[Rewards Adoption Rate (Target Group) (copy)_2781817229218062341]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total Rewards Related Events per Vendor (copy)_2676967800383885315] / [Calculation_2259399644860182615]' />
            </column>
            <column caption='Total Vendors Engaged with Rewards' datatype='integer' name='[Total Rewards Related Events per Vendor (copy)_2676967800383885315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [tiered_rewards_events] &gt; 0 THEN [vendor_code] END)' />
            </column>
            <column caption='Total Vendors Engaged with OneWeb' datatype='integer' name='[Total Vendors Engaged with Rewards (copy)_2004312946861740033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_3321264038371299330] &gt; 0 THEN [vendor_code] END)' />
            </column>
