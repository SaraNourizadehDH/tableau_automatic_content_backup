      <column caption='Lifetime Engagement' datatype='integer' name='[Calculation_1422644907478499334]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [entity_id], [vendor_code]: SUM([tiered_rewards_events])}' />
      </column>
      <column caption='Engagement Type' datatype='string' name='[Calculation_1422644907478736903]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1422644907478499334] &gt; 0 THEN &quot;Engaged&quot; ELSE &quot;Unengaged&quot; END' />
      </column>
      <column caption='Total Targeted Vendors' datatype='integer' name='[Calculation_2259399644860182615]' role='measure' type='quantitative'>
