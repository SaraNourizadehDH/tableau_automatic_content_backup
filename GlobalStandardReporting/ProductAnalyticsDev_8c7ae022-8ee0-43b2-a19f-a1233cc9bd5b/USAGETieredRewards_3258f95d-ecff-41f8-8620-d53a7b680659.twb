    <worksheet name='Engagement Funnel: Vendors'>
      <table>
        <view>
          <datasources>
            <datasource caption='growth_vendor_tiered_rewards_engagement' name='federated.03xqotj1etxqj518ocyvl0n4n3lx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.03xqotj1etxqj518ocyvl0n4n3lx'>
            <column caption='Date' datatype='string' name='[Calculation_2344545861120446492]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Day&quot; THEN STR(DATE([created_date]))&#10;WHEN &quot;Week&quot; THEN STR(YEAR([created_date]))+&quot;-W&quot;+STR(DATEPART(&apos;week&apos;,[created_date],&apos;monday&apos;))&#10;WHEN &quot;Month&quot; THEN STR(YEAR([created_date]))+&quot;-M&quot;+STR(MONTH([created_date]))&#10;END' />
            </column>
            <column caption='OneWeb Events' datatype='integer' name='[Calculation_3321264038371299330]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF[client_name] = &quot;ONEWEB&quot; THEN [events] END' />
            </column>
            <column caption='Single Vendor Engagement Events' datatype='integer' name='[Calculation_5144236682153877514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[rewards_single_vendor_page_display_events]' />
            </column>
            <column caption='Total Targeted Vendors (Avg.)' datatype='real' name='[Total Vendors (copy)_5144236682149908480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [region], [entity_id]: AVG({ FIXED [Calculation_2344545861120446492], [region], [entity_id]: COUNTD([vendor_code])})}' />
            </column>
            <column caption='Total Vendors Engaged with OneWeb (Avg.)' datatype='real' name='[Total Vendors Engaged with Portal (copy)_5144236682153029634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [region], [entity_id]: AVG({ FIXED [Calculation_2344545861120446492], [region], [entity_id]: COUNTD(IF [Calculation_3321264038371299330] &gt; 0 THEN [vendor_code] END)})}' />
            </column>
            <column caption='Total Single Vendors Engaged with Rewards (Avg.)' datatype='real' name='[Total Vendors Engaged with Rewards (Avg.) (copy)_5144236682156380172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [region], [entity_id]: AVG({ FIXED [Calculation_2344545861120446492], [region], [entity_id]: COUNTD(IF [Calculation_5144236682153877514] &gt; 0 THEN [vendor_code] END)})}' />
            </column>
            <column caption='Total Vendors Engaged with Rewards (Avg.)' datatype='real' name='[Total Vendors Engaged with Rewards (copy)_5144236682153127939]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [region], [entity_id]: AVG({ FIXED [Calculation_2344545861120446492], [region], [entity_id]: COUNTD(IF [tiered_rewards_events] &gt; 0 THEN [vendor_code] END)})}' />
            </column>
            <column caption='Client Name' datatype='string' name='[client_name]' role='dimension' type='nominal' />
            <column caption='Date Range' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='Entity Id' datatype='string' name='[entity_id]' role='dimension' type='nominal' />
            <column caption='Events' datatype='integer' name='[events]' role='measure' type='quantitative' />
            <column caption='Zombie Vendor' datatype='boolean' name='[is_zombie]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2344545861120446492]' derivation='None' name='[none:Calculation_2344545861120446492:nk]' pivot='key' type='nominal' />
            <column-instance column='[created_date]' derivation='None' name='[none:created_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[entity_id]' derivation='None' name='[none:entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_zombie]' derivation='None' name='[none:is_zombie:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_grade]' derivation='None' name='[none:vendor_grade:nk]' pivot='key' type='nominal' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Single Vendor Page Events' datatype='integer' name='[rewards_single_vendor_page_display_events]' role='measure' type='quantitative' />
            <column-instance column='[Total Vendors (copy)_5144236682149908480]' derivation='Sum' name='[sum:Total Vendors (copy)_5144236682149908480:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Total Vendors Engaged with Portal (copy)_5144236682153029634]' derivation='Sum' name='[sum:Total Vendors Engaged with Portal (copy)_5144236682153029634:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Total Vendors Engaged with Rewards (Avg.) (copy)_5144236682156380172]' derivation='Sum' name='[sum:Total Vendors Engaged with Rewards (Avg.) (copy)_5144236682156380172:qk]' pivot='key' type='quantitative' />
