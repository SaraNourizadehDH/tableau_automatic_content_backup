      <column caption='# Metric Divergence' datatype='real' name='[% Metric Divergence (copy)_441634252866859030]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    (SUM(IF [experiment_group] != &apos;Baseline&apos; THEN [% Metric Numerator (copy)_441634252867358746] END)) &#10;    /&#10;    (SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [% Metric Numerator (copy)_441634252867358746] END))&#10;)&#10;- 1' />
