    <worksheet name='Overall Experiment Post - Pre'>
      <table>
        <view>
          <datasources>
            <datasource caption='Checkin UI Analysis' name='federated.0vg9gty0jlgoxv1anoide144u8d9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Variant' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Variant A&quot;'>
              <calculation class='tableau' formula='&quot;Variant A&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vg9gty0jlgoxv1anoide144u8d9'>
            <column caption='Offline Duration % (Post ∆ - Pre ∆)' datatype='real' name='[Calculation_337277410517303297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [slot_offline_seconds] END)&#10;    /&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [slot_schedule_seconds] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [slot_offline_seconds] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [slot_schedule_seconds] END)&#10;    })&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [slot_offline_seconds] END)&#10;    /&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [slot_schedule_seconds] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [slot_offline_seconds] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [slot_schedule_seconds] END)&#10;    })&#10;)' />
            </column>
            <column caption='Post ∆ - Pre ∆ Tag' datatype='string' name='[Calculation_337277410518667266]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Post ∆ - Pre ∆&quot;' />
            </column>
            <column caption='Timespan' datatype='boolean' name='[Calculation_396387155265060867]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_418201462836531203] != &quot;N/A&quot; OR [Calculation_418201462828920833] != &quot;N/A&quot; THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Analysis Timespan (Pre-Rollout)' datatype='string' name='[Calculation_418201462828920833]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [experiment_name] = &apos;APAC-TH|MY|PH|TW|SG|HK|PK|BD|MM|KH|LA&apos; AND [created_date] &lt; DATE(&apos;2023-08-29&apos;) THEN &apos;W33-W34&apos;&#10;ELSEIF [experiment_name] = &apos;EU-DE|HU|DK&apos; AND [created_date] &lt; DATE(&apos;2023-08-29&apos;) THEN &apos;W33-W34&apos;&#10;ELSEIF [experiment_name] = &apos;MENA-AE|SA|JO&apos; AND [created_date] &lt;  DATE(&apos;2023-08-29&apos;) THEN &apos;W33-W34&apos;&#10;ELSEIF [experiment_name] = &apos;LATAM-AR|CL&apos; AND [created_date] &lt; DATE(&apos;2023-08-29&apos;) THEN &apos;W33-W34&apos;&#10;ELSE &quot;N/A&quot;&#10;END' />
            </column>
            <column caption='Analysis Timespan (Post-Rollout)' datatype='string' name='[Calculation_418201462836531203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [experiment_name] = &apos;APAC-TH|MY|PH|TW|SG|HK|PK|BD|MM|KH|LA&apos; AND [created_date] &gt;= DATE(&apos;2023-08-29&apos;) THEN &quot;W35 - now&quot;&#10;ELSEIF [experiment_name] = &apos;EU-DE|HU|DK&apos; AND [created_date] &gt;= DATE(&apos;2023-08-29&apos;) THEN &quot;W35 - now&quot;&#10;ELSEIF [experiment_name] = &apos;MENA-AE|SA|JO&apos; AND [created_date] &gt;= DATE(&apos;2023-08-29&apos;) THEN &quot;W35 - now&quot;&#10;ELSEIF [experiment_name] = &apos;LATAM-AR|CL&apos; AND [created_date] &gt;= DATE(&apos;2023-08-29&apos;) THEN &quot;W35 - now&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
            </column>
            <column caption='Variant' datatype='boolean' name='[Calculation_4848195386621218820]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] = [experiment_group]&#10;OR [experiment_group] = &quot;Baseline&quot;' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_693061775437230082]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date]))+&quot;-W&quot;+STR(WEEK([created_date]))&#10;END' />
            </column>
            <column caption='Check In Offline Duration % (Post ∆ - Pre ∆)' datatype='real' name='[Offline Duration % (Post ∆ - Pre ∆) (copy)_2534259953176182789]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [check_in_offline_seconds] END)&#10;    /&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [slot_schedule_seconds] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [check_in_offline_seconds] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [slot_schedule_seconds] END)&#10;    })&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [check_in_offline_seconds] END)&#10;    /&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [slot_schedule_seconds] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [check_in_offline_seconds] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [slot_schedule_seconds] END)&#10;    })&#10;)' />
            </column>
            <column caption='Vendor Fail Rate (Post ∆ - Pre ∆)' datatype='real' name='[Offline Duration % (Post ∆ - Pre ∆) (copy)_337277410519207941]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [vendor_failed_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [orders] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [vendor_failed_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [orders] END)&#10;    })&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [vendor_failed_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [orders] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [vendor_failed_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [orders] END)&#10;    })&#10;)' />
            </column>
            <column caption='Fail Rate % (Post ∆ - Pre ∆)' datatype='real' name='[Offline Duration % (Post ∆ - Pre ∆) (copy)_4270397629165129756]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [failed_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [orders] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [failed_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [orders] END)&#10;    })&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [failed_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [orders] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [failed_orders] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [orders] END)&#10;    })&#10;)' />
