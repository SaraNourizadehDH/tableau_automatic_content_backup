          <datasource-dependencies datasource='Parameters'>
            <column caption='# Metric' datatype='string' name='[% Metric (copy)_441634252866924569]' param-domain-type='list' role='measure' type='nominal' value='&quot;Successful Orders&quot;'>
              <calculation class='tableau' formula='&quot;Successful Orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vg9gty0jlgoxv1anoide144u8d9'>
            <column caption='# Metric' datatype='integer' name='[% Metric (copy)_441634252866859025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([% Metric Numerator (copy)_441634252867358746])' />
            </column>
            <column caption='# Metric Divergence' datatype='real' name='[% Metric Divergence (copy)_441634252866859030]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    (SUM(IF [experiment_group] != &apos;Baseline&apos; THEN [% Metric Numerator (copy)_441634252867358746] END)) &#10;    /&#10;    (SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [% Metric Numerator (copy)_441634252867358746] END))&#10;)&#10;- 1' />
