      <table>
        <view>
          <datasources>
            <datasource caption='Checkin UI Analysis' name='federated.0vg9gty0jlgoxv1anoide144u8d9' />
          </datasources>
          <datasource-dependencies datasource='federated.0vg9gty0jlgoxv1anoide144u8d9'>
            <column caption='Vendor Fail Rate Delta' datatype='real' name='[Calculation_1018658009087778817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// varient A&#10;    (SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [vendor_failed_orders] END)&#10;      / SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END) &#10;     ) &#10;    &#10;/&#10;  // Baseline&#10;    (SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [vendor_failed_orders]  END)&#10;    / SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END) &#10;    )&#10;- 1' />
            </column>
            <column caption='Vendor Fail Rate %' datatype='real' name='[Calculation_4848195386620370947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_693061775437230082]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date]))+&quot;-W&quot;+STR(WEEK([created_date]))&#10;END' />
