      <column caption='Post-Rollout Timespan' datatype='string' name='[Analysis Timespan (Post-Rollout) (copy)_203858272671715331]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [experiment_name] = &apos;APAC-TH|MY|PH|TW|SG|HK|PK|BD|MM|KH|LA&apos; THEN &quot;W35 - now&quot;&#10;ELSEIF [experiment_name] = &apos;EU-DE|HU|DK&apos; THEN &quot;W35 - now&quot;&#10;ELSEIF [experiment_name] = &apos;MENA-AE|SA|JO&apos; THEN &quot;W35 - now&quot;&#10;ELSEIF [experiment_name] = &apos;LATAM-AR|CL&apos; THEN &quot;W35 - now&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
