      <column caption='Pre-Rollout Timespan' datatype='string' name='[Analysis Timespan (Pre-Rollout) (copy)_203858272671973380]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [experiment_name] = &apos;APAC-TH|MY|PH|TW|SG|HK|PK|BD|MM|KH|LA&apos; THEN &quot;W33 - W34&quot;&#10;ELSEIF [experiment_name] = &apos;EU-DE|HU|DK&apos; THEN &quot;W33 - W34&quot;&#10;ELSEIF [experiment_name] = &apos;MENA-AE|SA|JO&apos; THEN &quot;W33 - W34&quot;&#10;ELSEIF [experiment_name] = &apos;LATAM-AR|CL&apos; THEN &quot;W33 - W34&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
      </column>
      <column caption='Baseline Post (# Metric)' datatype='integer' name='[Baseline Post Rollout 28D (% Metric) (copy)_441634252866859029]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ FIXED [experiment_name], [region], [entity_id], [vendor_grade], [is_zombie_vendor], [is_new_vendor], [date_type], [Calculation_693061775437230082]:&#10;SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [% Metric Numerator (copy)_441634252867358746] END)&#10;})' />
      </column>
      <column caption='Baseline Pre (# Metric)' datatype='integer' name='[Baseline Pre Rollout 28D (% Metric) (copy)_441634252866859031]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ FIXED [experiment_name], [region], [entity_id], [vendor_grade], [is_zombie_vendor], [is_new_vendor], [date_type], [Calculation_693061775437230082]:&#10;SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [% Metric Numerator (copy)_441634252867358746] END)&#10;})' />
      </column>
      <column caption='Vendor Fail Rate Delta' datatype='real' name='[Calculation_1018658009087778817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// varient A&#10;    (SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [vendor_failed_orders] END)&#10;      / SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END) &#10;     ) &#10;    &#10;/&#10;  // Baseline&#10;    (SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [vendor_failed_orders]  END)&#10;    / SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END) &#10;    )&#10;- 1' />
      </column>
      <column caption='Checkin Clicked %' datatype='real' name='[Calculation_171277580578361354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([checkin_clicked_vendors]) / SUM([vendors])' />
      </column>
      <column caption='Inventory' datatype='integer' name='[Calculation_203858272667717633]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [experiment_name]&#10;WHEN &apos;APAC-TH|MY|PH|TW|SG|HK|PK|BD|MM|KH|LA&apos; THEN 209900&#10;WHEN &apos;MENA-AE|SA|JO&apos; THEN 42360&#10;WHEN &quot;LATAM-AR|CL&quot; THEN 16630&#10;WHEN &apos;EU-DE|HU|DK&apos; THEN 3660&#10;END' />
      </column>
      <column caption='Checkin Display %' datatype='real' name='[Calculation_2534259952908324864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[checkin_displayed_vendors]/[vendors]' />
