      </column>
      <column caption='Offline Duration %' datatype='real' name='[Calculation_2534259953135198212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([slot_offline_seconds])/SUM([slot_schedule_seconds])' />
      </column>
      <column caption='Pre-Post Checker' datatype='string' name='[Calculation_337277410516295680]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF RIGHT([Rollout Phase (copy)_396387155264122882], 3) = &quot;Pre&quot; THEN &quot;Pre&quot;&#10;ELSEIF RIGHT([Rollout Phase (copy)_396387155264122882], 4) = &quot;Post&quot; THEN &quot;Post&quot;&#10;END' />
      </column>
      <column caption='Offline Duration % (Post ∆ - Pre ∆)' datatype='real' name='[Calculation_337277410517303297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [slot_offline_seconds] END)&#10;    /&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [slot_schedule_seconds] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [slot_offline_seconds] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462836531203] != &apos;N/A&apos; THEN [slot_schedule_seconds] END)&#10;    })&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [slot_offline_seconds] END)&#10;    /&#10;    SUM(IF [experiment_group] != &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [slot_schedule_seconds] END)&#10;    })&#10;    -&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [slot_offline_seconds] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [Calculation_418201462828920833] != &apos;N/A&apos; THEN [slot_schedule_seconds] END)&#10;    })&#10;)' />
      </column>
      <column caption='Post ∆ - Pre ∆ Tag' datatype='string' name='[Calculation_337277410518667266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Post ∆ - Pre ∆&quot;' />
      </column>
      <column caption='Timespan' datatype='boolean' name='[Calculation_396387155265060867]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_418201462836531203] != &quot;N/A&quot; OR [Calculation_418201462828920833] != &quot;N/A&quot; THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='Analysis Timespan (Pre-Rollout)' datatype='string' name='[Calculation_418201462828920833]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [experiment_name] = &apos;APAC-TH|MY|PH|TW|SG|HK|PK|BD|MM|KH|LA&apos; AND [created_date] &lt; DATE(&apos;2023-08-29&apos;) THEN &apos;W33-W34&apos;&#10;ELSEIF [experiment_name] = &apos;EU-DE|HU|DK&apos; AND [created_date] &lt; DATE(&apos;2023-08-29&apos;) THEN &apos;W33-W34&apos;&#10;ELSEIF [experiment_name] = &apos;MENA-AE|SA|JO&apos; AND [created_date] &lt;  DATE(&apos;2023-08-29&apos;) THEN &apos;W33-W34&apos;&#10;ELSEIF [experiment_name] = &apos;LATAM-AR|CL&apos; AND [created_date] &lt; DATE(&apos;2023-08-29&apos;) THEN &apos;W33-W34&apos;&#10;ELSE &quot;N/A&quot;&#10;END' />
      </column>
      <column caption='Analysis Timespan (Post-Rollout)' datatype='string' name='[Calculation_418201462836531203]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [experiment_name] = &apos;APAC-TH|MY|PH|TW|SG|HK|PK|BD|MM|KH|LA&apos; AND [created_date] &gt;= DATE(&apos;2023-08-29&apos;) THEN &quot;W35 - now&quot;&#10;ELSEIF [experiment_name] = &apos;EU-DE|HU|DK&apos; AND [created_date] &gt;= DATE(&apos;2023-08-29&apos;) THEN &quot;W35 - now&quot;&#10;ELSEIF [experiment_name] = &apos;MENA-AE|SA|JO&apos; AND [created_date] &gt;= DATE(&apos;2023-08-29&apos;) THEN &quot;W35 - now&quot;&#10;ELSEIF [experiment_name] = &apos;LATAM-AR|CL&apos; AND [created_date] &gt;= DATE(&apos;2023-08-29&apos;) THEN &quot;W35 - now&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
      </column>
      <column caption='Rollout Phase' datatype='string' name='[Calculation_4848195386618671104]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_418201462836531203] = &apos;N/A&apos; THEN &quot;Pre&quot;&#10;ELSEIF [Calculation_418201462828920833] = &apos;N/A&apos; THEN &quot;Post&quot;&#10;END' />
      </column>
      <column caption='Vendor Fail Rate %' datatype='real' name='[Calculation_4848195386620370947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
      </column>
      <column caption='Variant' datatype='boolean' name='[Calculation_4848195386621218820]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = [experiment_group]&#10;OR [experiment_group] = &quot;Baseline&quot;' />
      </column>
      <column caption='Delta Phase' datatype='string' name='[Calculation_4848195386623766534]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4848195386618671104] = &quot;Post&quot; THEN &quot;Post ∆ (&quot; + [Parameters].[Parameter 1] + &quot; - Baseline)&quot;&#10;ELSEIF [Calculation_4848195386618671104] = &quot;Pre&quot; THEN &quot;Pre ∆ (&quot; + [Parameters].[Parameter 1] + &quot; - Baseline)&quot;&#10;END' />
      </column>
      <column caption='Days Till/Since Rollout' datatype='integer' name='[Calculation_485825823130701828]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [rollout_date], [created_date])' />
      </column>
      <column caption='_user_entitlement' datatype='boolean' name='[Calculation_693061775433273344]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Parameters' datatype='string' name='[Calculation_693061775434362881]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [experiment_group]&#10;WHEN &quot;Baseline&quot; THEN &quot;soundType:chime,beforeOpeningTimeIntervalSeconds:270,afterOpeningTimeIntervalSeconds:60, version: original_design&quot;&#10;WHEN &quot;Variant A&quot; THEN &quot;soundType:chime,beforeOpeningTimeIntervalSeconds:270,afterOpeningTimeIntervalSeconds:60, version: overlay_specified_time_ripple_effect&quot;&#10;END' />
      </column>
      <column caption='Date' datatype='string' name='[Calculation_693061775437230082]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date]))+&quot;-W&quot;+STR(WEEK([created_date]))&#10;END' />
      </column>
      <column caption='Successful Orders' datatype='integer' name='[Calculation_693061775476678660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[orders] - [failed_orders]' />
      </column>
      <column caption='% Metric Numerator' datatype='integer' name='[Calculation_693061775494160390]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Offline Duration %&apos; THEN [slot_offline_seconds]&#10;WHEN &apos;Checkin Offline Duration %&apos; THEN [check_in_offline_seconds]&#10;WHEN &apos;Early Checkin %&apos; THEN [checkin_ontime]&#10;WHEN &apos;Checkin Clicked Vendor %&apos; THEN [checkin_clicked_vendors]&#10;WHEN &apos;First Order Fail Rate %&apos; THEN [first_orders_failed_count]&#10;WHEN &apos;First Order Vendor Fail Rate %&apos; THEN [first_orders_vendor_failed_count]&#10;WHEN &apos;Fail Rate %&apos; THEN [failed_orders]&#10;WHEN &apos;Vendor Fail Rate %&apos; THEN [vendor_failed_orders]&#10;END' />
      </column>
      <column caption='% Metric Denominator' datatype='integer' name='[Calculation_693061775494680583]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;WHEN &apos;Offline Duration %&apos; THEN [slot_schedule_seconds]&#10;WHEN &apos;Checkin Offline Duration %&apos; THEN [slot_schedule_seconds]&#10;WHEN &apos;Early Checkin %&apos; THEN [slots_count]&#10;WHEN &apos;Checkin Clicked Vendor %&apos; THEN [vendors]&#10;WHEN &apos;First Order Fail Rate %&apos; THEN [first_orders_count]&#10;WHEN &apos;First Order Vendor Fail Rate %&apos; THEN [first_orders_count]&#10;WHEN &apos;Fail Rate %&apos; THEN [orders]&#10;WHEN &apos;Vendor Fail Rate %&apos; THEN [orders]&#10;END' />
      </column>
      <column caption='Target Inventory' datatype='real' name='[Inventory (copy)_203858272668831746]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [experiment_name]&#10;WHEN &apos;APAC-TH|MY|PH|TW|SG|HK|PK|BD|MM|KH|LA&apos; THEN&#10;    CASE [experiment_group]&#10;    WHEN &quot;Baseline&quot; THEN 0.5&#10;    WHEN &quot;Variant A&quot; THEN 0.5&#10;    END&#10;WHEN &apos;EU-DE|HU|DK&apos; THEN&#10;    CASE [experiment_group]&#10;    WHEN &quot;Baseline&quot; THEN 0.5&#10;    WHEN &quot;Variant A&quot; THEN 0.5&#10;    END&#10;WHEN &apos;MENA-AE|SA|JO&apos; THEN&#10;    CASE [experiment_group]&#10;    WHEN &quot;Baseline&quot; THEN 0.5&#10;    WHEN &quot;Variant A&quot; THEN 0.5&#10;    END&#10;WHEN &apos;LATAM-AR|CL&apos; THEN&#10;    CASE [experiment_group]&#10;    WHEN &quot;Baseline&quot; THEN 0.5&#10;    WHEN &quot;Variant A&quot; THEN 0.5&#10;    END&#10;END' />
      </column>
