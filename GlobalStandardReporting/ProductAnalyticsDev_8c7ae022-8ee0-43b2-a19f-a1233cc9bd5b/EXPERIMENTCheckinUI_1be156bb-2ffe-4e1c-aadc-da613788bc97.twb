    <worksheet name='Vendor Fail Rate %'>
      <repository-location id='VendorFailRate' path='/t/GlobalStandardReporting/workbooks/EXPERIMENTCheckinUI' revision='' site='GlobalStandardReporting' />
      <layout-options>
        <title>
          <formatted-text>
            <run>Vendor Fail Rate %</run>
