    <worksheet name='Overall Experiment Stats ∆ Post'>
      <table>
        <view>
          <datasources>
            <datasource caption='Checkin UI Analysis' name='federated.0vg9gty0jlgoxv1anoide144u8d9' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Variant' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Variant A&quot;'>
              <calculation class='tableau' formula='&quot;Variant A&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0vg9gty0jlgoxv1anoide144u8d9'>
            <column caption='Checkin Clicked %' datatype='real' name='[Calculation_171277580578361354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([checkin_clicked_vendors]) / SUM([vendors])' />
            </column>
            <column caption='Offline Duration %' datatype='real' name='[Calculation_2534259953135198212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([slot_offline_seconds])/SUM([slot_schedule_seconds])' />
            </column>
            <column caption='Timespan' datatype='boolean' name='[Calculation_396387155265060867]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_418201462836531203] != &quot;N/A&quot; OR [Calculation_418201462828920833] != &quot;N/A&quot; THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='Analysis Timespan (Pre-Rollout)' datatype='string' name='[Calculation_418201462828920833]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [experiment_name] = &apos;APAC-TH|MY|PH|TW|SG|HK|PK|BD|MM|KH|LA&apos; AND [created_date] &lt; DATE(&apos;2023-08-29&apos;) THEN &apos;W33-W34&apos;&#10;ELSEIF [experiment_name] = &apos;EU-DE|HU|DK&apos; AND [created_date] &lt; DATE(&apos;2023-08-29&apos;) THEN &apos;W33-W34&apos;&#10;ELSEIF [experiment_name] = &apos;MENA-AE|SA|JO&apos; AND [created_date] &lt;  DATE(&apos;2023-08-29&apos;) THEN &apos;W33-W34&apos;&#10;ELSEIF [experiment_name] = &apos;LATAM-AR|CL&apos; AND [created_date] &lt; DATE(&apos;2023-08-29&apos;) THEN &apos;W33-W34&apos;&#10;ELSE &quot;N/A&quot;&#10;END' />
            </column>
            <column caption='Analysis Timespan (Post-Rollout)' datatype='string' name='[Calculation_418201462836531203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [experiment_name] = &apos;APAC-TH|MY|PH|TW|SG|HK|PK|BD|MM|KH|LA&apos; AND [created_date] &gt;= DATE(&apos;2023-08-29&apos;) THEN &quot;W35 - now&quot;&#10;ELSEIF [experiment_name] = &apos;EU-DE|HU|DK&apos; AND [created_date] &gt;= DATE(&apos;2023-08-29&apos;) THEN &quot;W35 - now&quot;&#10;ELSEIF [experiment_name] = &apos;MENA-AE|SA|JO&apos; AND [created_date] &gt;= DATE(&apos;2023-08-29&apos;) THEN &quot;W35 - now&quot;&#10;ELSEIF [experiment_name] = &apos;LATAM-AR|CL&apos; AND [created_date] &gt;= DATE(&apos;2023-08-29&apos;) THEN &quot;W35 - now&quot;&#10;ELSE &quot;N/A&quot;&#10;END' />
            </column>
            <column caption='Rollout Phase' datatype='string' name='[Calculation_4848195386618671104]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_418201462836531203] = &apos;N/A&apos; THEN &quot;Pre&quot;&#10;ELSEIF [Calculation_418201462828920833] = &apos;N/A&apos; THEN &quot;Post&quot;&#10;END' />
            </column>
            <column caption='Vendor Fail Rate %' datatype='real' name='[Calculation_4848195386620370947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='Variant' datatype='boolean' name='[Calculation_4848195386621218820]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] = [experiment_group]&#10;OR [experiment_group] = &quot;Baseline&quot;' />
            </column>
            <column caption='Delta Phase' datatype='string' name='[Calculation_4848195386623766534]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_4848195386618671104] = &quot;Post&quot; THEN &quot;Post ∆ (&quot; + [Parameters].[Parameter 1] + &quot; - Baseline)&quot;&#10;ELSEIF [Calculation_4848195386618671104] = &quot;Pre&quot; THEN &quot;Pre ∆ (&quot; + [Parameters].[Parameter 1] + &quot; - Baseline)&quot;&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_693061775437230082]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date]))+&quot;-W&quot;+STR(WEEK([created_date]))&#10;END' />
            </column>
            <column caption='Fail Rate %' datatype='real' name='[Offline Duration % (copy)_4270397629165129757]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])/SUM([orders])' />
            </column>
            <column caption='Early Check In %' datatype='real' name='[Offline Duration % (copy)_4270397629165367328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([checkin_ontime])/SUM([slots_count])' />
            </column>
            <column caption='First Order Fail Rate %' datatype='real' name='[Offline Duration % (copy)_4270397629165895719]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([first_orders_failed_count])/SUM([first_orders_count])' />
            </column>
            <column caption='First Order Vendor Fail Rate %' datatype='real' name='[Offline Duration % (copy)_4270397629166194730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([first_orders_vendor_failed_count])/SUM([first_orders_count])' />
            </column>
            <column caption='Check In Offline Duration %' datatype='real' name='[Offline Duration % (copy)_4767552806835666945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([check_in_offline_seconds])/SUM([slot_schedule_seconds])' />
            </column>
            <column caption='Check In Offline Seconds' datatype='integer' name='[check_in_offline_seconds]' role='measure' type='quantitative' />
            <column caption='Checkin Clicked Vendors' datatype='integer' name='[checkin_clicked_vendors]' role='measure' type='quantitative' />
