    <worksheet name='LB - Deflection Rate'>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_ops_dashboard_contacts (jeetendra_manjunath)' name='federated.0g8vfx80hlpjlq1bq42xo1gg5mwj' />
          </datasources>
          <datasource-dependencies datasource='federated.0g8vfx80hlpjlq1bq42xo1gg5mwj'>
            <column caption='LB - Deflection Rate' datatype='string' name='[LB - First/Last Leaf (copy)_5354357754479972352]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;% Deflection Rate: % of sessions that do not generate contacts.&#10;% Live-order Sessions: % of sessions that can be mapped to a Contact Reason for &quot;Live Order Inquiry by Restaurant&quot;.&#10;This is mapped based on first and last leaf visited, and based on contacts created as part of this session.&apos;' />
