      <column caption='# A+ Vendors' datatype='integer' name='[% A+ Vendors (copy)_3407465708912492590]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [vendor_grade] IN (&apos;A&apos;, &apos;AA&apos;, &apos;AAA&apos;) THEN [active_vendors] ELSE 0 END)' />
