    <worksheet name='Summary - Combo Chart'>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_ops_dashboard_order_attributes (jeetendra_manjunath)' name='federated.0h4ojdc11i4lzt10wpqhw0ga7osm' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Day' caption='Orders - Summary - Time Granularity' datatype='integer' datatype-customized='true' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Day' />
                <alias key='2' value='Week' />
                <alias key='3' value='Month' />
              </aliases>
            </column>
            <column caption='Orders - Summary - KPI to View' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Seamless Orders&quot;'>
              <calculation class='tableau' formula='&quot;% Seamless Orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0h4ojdc11i4lzt10wpqhw0ga7osm'>
            <column caption='Summary - KPI to view' datatype='string' name='[Calculation_105553119548923904]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 7]' />
            </column>
            <column caption='% Orders with Vendor Late &gt; 10 mins' datatype='real' name='[Calculation_105553119564967937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_late_over_10_count])&#10;/&#10;SUM([vendor_late_count])' />
            </column>
            <column caption='Summary - Metric' datatype='real' name='[Calculation_108297500359520261]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;  WHEN &apos;% Go Client Orders&apos;&#10;    THEN [Calculation_5909004253145722888]&#10;  WHEN &apos;% POS Orders&apos;&#10;    THEN [Calculation_5909004253146415116]&#10;  WHEN &apos;% OD Orders&apos;&#10;    THEN [Calculation_5909004253147164688]&#10;  WHEN &apos;% Orders with Vendor Late &gt;10 mins&apos;&#10;    THEN [Calculation_105553119564967937]&#10;  WHEN &apos;% Auto-Accept Configured Orders&apos;&#10;    THEN [Calculation_5909004253168537626]&#10;  WHEN &apos;% Orders Auto-Accepted&apos;&#10;    THEN [Calculation_5909004253483978795]&#10;  WHEN &apos;% Seamless Orders&apos;&#10;    THEN [Calculation_4002503800118296579]&#10;END' />
            </column>
            <column caption='% Seamless Orders' datatype='real' name='[Calculation_4002503800118296579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_seamless_order] THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
            </column>
            <column caption='% Go Client Orders' datatype='real' name='[Calculation_5909004253145722888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF STARTSWITH([application_client_name], &quot;GO&quot;) THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
            </column>
            <column caption='% POS Orders' datatype='real' name='[Calculation_5909004253146415116]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF NOT ISNULL([application_integration_type]) THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
            </column>
            <column caption='% Own Delivery Orders' datatype='real' name='[Calculation_5909004253147164688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [delivery_type] = &apos;OWN_DELIVERY&apos; THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
            </column>
            <column caption='% Auto-Accept Configured Orders' datatype='real' name='[Calculation_5909004253168537626]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_auto_accept_configured] THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
            </column>
            <column caption='% Auto-Accept Configured Orders Auto-Accepted' datatype='real' name='[Calculation_5909004253483978795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_auto_accept_configured] AND [is_order_auto_accepted] THEN [orders] ELSE 0 END)&#10;/&#10;SUM(IF [is_auto_accept_configured] THEN [orders] ELSE 0 END)' />
            </column>
            <column caption='Time Granularity - Summary' datatype='string' name='[Time Granularity - Fails (copy)_4002503800173506577]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;  WHEN 1 THEN STR([created_date_local])&#10;  WHEN 2 THEN [order_week]&#10;  WHEN 3 THEN [order_month]&#10;END' />
            </column>
            <column caption='Application Client Name' datatype='string' name='[application_client_name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='NA' />
