      <table>
        <view>
          <datasources>
            <datasource caption='vendor_ops_dashboard_order_attributes (jeetendra_manjunath)' name='federated.0h4ojdc11i4lzt10wpqhw0ga7osm' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Day' caption='Orders - Fails - Time Granularity' datatype='integer' datatype-customized='true' name='[Orders - Summary - Time Granularity (copy)_4002503800169734156]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Day' />
                <alias key='2' value='Week' />
                <alias key='3' value='Month' />
              </aliases>
            </column>
            <column caption='Orders - Fails - View As' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Overall \%FR&quot;'>
              <calculation class='tableau' formula='&quot;Overall %FR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0h4ojdc11i4lzt10wpqhw0ga7osm'>
            <column caption='Fails - View As' datatype='boolean' name='[Calculation_108297500356395012]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 6]&#10;when &apos;Overall %FR&apos;&#10;then TRUE&#10;else false&#10;end' />
            </column>
            <column caption='Time Granularity - Fails' datatype='string' name='[Calculation_4002503800172343312]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Orders - Summary - Time Granularity (copy)_4002503800169734156]&#10;  WHEN 1 THEN STR([created_date_local])&#10;  WHEN 2 THEN [order_week]&#10;  WHEN 3 THEN [order_month]&#10;END' />
            </column>
            <column caption='% Vendor Failed Orders' datatype='real' name='[Calculation_5909004253107978240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [is_cancelled_by_vendor] = TRUE THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
            </column>
            <column caption='% Overall Failed Orders' datatype='real' name='[Calculation_5909004253121785857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [order_status] != &apos;completed&apos; THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
            </column>
