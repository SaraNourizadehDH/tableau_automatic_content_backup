    <worksheet name='Contact Rate'>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_ops_dashboard_contacts (jeetendra_manjunath)' name='federated.0g8vfx80hlpjlq1bq42xo1gg5mwj' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Day' caption='Contacts - Contact Rate - Time Granularity' datatype='integer' datatype-customized='true' name='[Orders - Summary - Time Granularity (copy)_4002503800803131437]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Day' />
                <alias key='2' value='Week' />
                <alias key='3' value='Month' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0g8vfx80hlpjlq1bq42xo1gg5mwj'>
            <column caption='% Non-Live-Order Contact Rate' datatype='real' name='[% Live-Order Contact Rate (copy)_4002503800800309291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF NOT [Calculation_4002503800579801128] THEN [vendor_contacts] ELSE 0 END)&#10;/&#10;SUM([orders])' />
            </column>
            <column caption='% Inaccurate Order Rate' datatype='real' name='[Calculation_3407465708714491906]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([inaccurate_order_contacts])&#10;/&#10;SUM([orders])' />
            </column>
            <column caption='% Food Quality Contact Rate' datatype='real' name='[Calculation_3407465708714680324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([food_quality_contacts])&#10;/&#10;SUM([orders])' />
            </column>
            <column caption='Is Live Order Contact?' datatype='boolean' name='[Calculation_4002503800579801128]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [contact_reason_l1] = &apos;Live order inquiries by restaurant&apos; AND [vendor_contacts] &gt; 0 and NOT ISNULL([vendor_contacts])&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
              <aliases>
                <alias key='false' value='Non-Live-Order' />
                <alias key='true' value='Live-Order' />
              </aliases>
            </column>
            <column caption='# Vendor Contacts' datatype='integer' name='[Calculation_4002503800799858729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_contacts])' />
            </column>
            <column caption='% Live-Order Contact Rate' datatype='real' name='[Calculation_4002503800799952938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_4002503800579801128] THEN [vendor_contacts] ELSE 0 END)&#10;/&#10;SUM([orders])' />
            </column>
            <column caption='% Vendor Contact Rate' datatype='real' name='[Calculation_4002503800800882732]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_contacts])&#10;/&#10;SUM([orders])' />
            </column>
            <column caption='Time Granularity - Contact Rate' datatype='string' name='[Calculation_4002503800804085807]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Orders - Summary - Time Granularity (copy)_4002503800803131437]&#10;  WHEN 1 THEN STR([created_date_local])&#10;  WHEN 2 THEN [created_week]&#10;  WHEN 3 THEN [created_month]&#10;END' />
            </column>
            <column caption='% Overall Contact Rate' datatype='real' name='[Calculation_5700571980811313152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[% Live-Order Contact Rate (copy)_4002503800800309291] + [Calculation_4002503800799952938]' />
            </column>
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Contact Reason L1' datatype='string' name='[contact_reason_l1]' role='dimension' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Created Date Local' datatype='date' name='[created_date_local]' role='dimension' type='ordinal' />
            <column caption='Created Month' datatype='string' name='[created_month]' role='dimension' type='nominal' />
            <column caption='Created Week' datatype='string' name='[created_week]' role='dimension' type='nominal' />
            <column caption='Entity Id' datatype='string' name='[entity_id]' role='dimension' type='nominal' />
            <column datatype='integer' name='[food_quality_contacts]' role='measure' type='quantitative' />
            <column datatype='integer' name='[inaccurate_order_contacts]' role='measure' type='quantitative' />
            <column caption='Is New Vendor' datatype='boolean' name='[is_new_vendor]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='(Missing)' />
              </aliases>
            </column>
            <column caption='Is Zombie Vendor' datatype='boolean' name='[is_zombie_vendor]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='(Missing)' />
              </aliases>
            </column>
            <column-instance column='[Calculation_4002503800804085807]' derivation='None' name='[none:Calculation_4002503800804085807:nk]' pivot='key' type='nominal' />
            <column-instance column='[brand_name]' derivation='None' name='[none:brand_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
