              <calculation class='tableau' formula='&quot;Overall&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1xhbgo30jlfcdo1dpetsh091u9ig'>
            <column caption='% Monitor Offline Duration' datatype='real' name='[% Availability Offline Duration (copy)_3407465708894244898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monitor_offline_duration_seconds])&#10;/&#10;SUM([schedule_duration_seconds])' />
            </column>
            <column caption='% Client Offline Duration' datatype='real' name='[% Availability Offline Duration (copy)_3407465708894302243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([client_offline_duration_seconds])&#10;/&#10;SUM([schedule_duration_seconds])' />
            </column>
            <column caption='% Platform Offline Duration' datatype='real' name='[% Availability Offline Duration (copy)_3407465708894355492]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([platform_offline_duration_seconds])&#10;/&#10;SUM([schedule_duration_seconds])' />
            </column>
            <column caption='% Vendor Portal Offline Duration' datatype='real' name='[% Availability Offline Duration (copy)_3407465708894429221]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([portal_offline_duration_seconds])&#10;/&#10;SUM([schedule_duration_seconds])' />
            </column>
