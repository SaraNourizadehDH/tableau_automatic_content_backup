      <column caption='Avg. Vendor Late Time (mins)' datatype='real' name='[Avg. At Vendor Time Cleaned (copy)_5909004253172211745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([vendor_late_sum])&#10;/&#10;SUM([vendor_late_count]))&#10;/&#10;60' />
      </column>
      <column caption='Avg. At Vendor Time Cleaned (mins)' datatype='real' name='[Avg. Estimated Prep Time (copy)_5909004253172052000]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([at_vendor_time_cleaned_sum])&#10;/&#10;sum([at_vendor_time_cleaned_count]))&#10;/&#10;60' />
      </column>
      <column caption='Avg. Actual Prep Time (assumed; mins)' datatype='real' name='[Avg. Response Time (copy)_5909004253171912735]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([assumed_actual_preparation_time_minutes])&#10;/&#10;sum(IF ISNULL([assumed_actual_preparation_time_minutes]) THEN NULL ELSE [orders] END))' />
      </column>
      <column caption='Summary - KPI to view' datatype='string' name='[Calculation_105553119548923904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 7]' />
      </column>
      <column caption='% Orders with Vendor Late &gt; 10 mins' datatype='real' name='[Calculation_105553119564967937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_late_over_10_count])&#10;/&#10;SUM([vendor_late_count])' />
      </column>
      <column aggregation='Attribute' caption='# Orders (fail reason)' datatype='integer' name='[Calculation_108297500352925697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [cancellation_reason]: SUM([orders])}' />
      </column>
      <column caption='% Failed Orders (reason - Vendor)' datatype='real' name='[Calculation_108297500353216514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_cancelled_by_vendor] then [orders] end)&#10;/&#10;SUM([Calculation_108297500353691651])' />
      </column>
      <column aggregation='Attribute' caption='# Orders (fixed)' datatype='integer' name='[Calculation_108297500353691651]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE  [cancellation_reason], [is_cancelled_by_vendor], [cancellation_owner], [cancellation_source], [cancellation_stage], [Calculation_108297500367986697]: SUM([orders])}' />
      </column>
      <column caption='Fails - View As' datatype='boolean' name='[Calculation_108297500356395012]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 6]&#10;when &apos;Overall %FR&apos;&#10;then TRUE&#10;else false&#10;end' />
      </column>
      <column caption='Summary - Metric' datatype='real' name='[Calculation_108297500359520261]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#10;  WHEN &apos;% Go Client Orders&apos;&#10;    THEN [Calculation_5909004253145722888]&#10;  WHEN &apos;% POS Orders&apos;&#10;    THEN [Calculation_5909004253146415116]&#10;  WHEN &apos;% OD Orders&apos;&#10;    THEN [Calculation_5909004253147164688]&#10;  WHEN &apos;% Orders with Vendor Late &gt;10 mins&apos;&#10;    THEN [Calculation_105553119564967937]&#10;  WHEN &apos;% Auto-Accept Configured Orders&apos;&#10;    THEN [Calculation_5909004253168537626]&#10;  WHEN &apos;% Orders Auto-Accepted&apos;&#10;    THEN [Calculation_5909004253483978795]&#10;  WHEN &apos;% Seamless Orders&apos;&#10;    THEN [Calculation_4002503800118296579]&#10;END' />
      </column>
      <column caption='Vendor Fail Reasons' datatype='string' name='[Calculation_108297500367986697]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [cancellation_owner] = &apos;VENDOR&apos;&#10;THEN [cancellation_reason]&#10;END' />
      </column>
      <column caption='% Food Is Ready Clicked Orders' datatype='real' name='[Calculation_1471832665979830272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [food_is_ready_clicked] AND [order_status] = &apos;completed&apos; THEN [orders] ELSE 0 END)&#10;/&#10;SUM(IF [order_status] = &apos;completed&apos; THEN [orders] ELSE 0 END)' />
      </column>
      <column caption='_is_load_extract' datatype='boolean' name='[Calculation_356628815435759616]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 14]' />
      </column>
      <column caption='_user_entitlement' datatype='boolean' name='[Calculation_357754714977263616]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column aggregation='Sum' caption='_week_check' datatype='integer' name='[Calculation_390828023698386944]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='WEEK([created_date_local])' />
      </column>
      <column caption='Order Growth sub-text (prior CW)' datatype='string' name='[Calculation_4002503800111595520]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos; vs. prior week (CW &apos; + STR(WEEK(TODAY()) - 3) + &apos;)&apos;' />
      </column>
      <column caption='Order Growth subtext - CW' datatype='string' name='[Calculation_4002503800112287745]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;CW &apos; + STR(WEEK(TODAY()) - 2)' />
      </column>
      <column caption='Is prev. CW?' datatype='boolean' name='[Calculation_4002503800113766402]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='([Calculation_5909004253490094125] = (WEEK(TODAY()) - 2))' />
      </column>
      <column caption='% Seamless Orders' datatype='real' name='[Calculation_4002503800118296579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_seamless_order] THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='LB - KPI charts' datatype='string' name='[Calculation_4002503800119246854]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Summaries to the right are based on orders in previous calendar week&apos;' />
      </column>
      <column caption='Time Granularity - Fails' datatype='string' name='[Calculation_4002503800172343312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Orders - Summary - Time Granularity (copy)_4002503800169734156]&#10;  WHEN 1 THEN STR([created_date_local])&#10;  WHEN 2 THEN [order_week]&#10;  WHEN 3 THEN [order_month]&#10;END' />
      </column>
      <column caption='Summary - Is view absolute numbers?' datatype='boolean' name='[Calculation_4002503800463990803]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4] = &apos;# of orders&apos;' />
      </column>
      <column caption='Dummy' datatype='integer' name='[Calculation_4002503800829812792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Note: Seamless Orders' datatype='string' name='[Calculation_4125578743250997248]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_105553119548923904] = &apos;% Seamless Orders&apos;&#10;THEN &apos;Note: Orders with Inaccurate Order, Food Quality, and VD Delay Contacts are considered as Non-Seamless.&apos;&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='LB - Fails Dimensions Expand' datatype='string' name='[Calculation_4139933968544010243]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Click the + or - sign near the header of Dimension A to adjust granulary as desired.&apos;' />
      </column>
      <column caption='% Vendor Failed Orders' datatype='real' name='[Calculation_5909004253107978240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_cancelled_by_vendor] = TRUE THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% Overall Failed Orders' datatype='real' name='[Calculation_5909004253121785857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] != &apos;completed&apos; THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='Dimension A' datatype='string' name='[Calculation_5909004253127929859]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Entity ID&apos; THEN [entity_id]&#10;WHEN &apos;Cancellation Owner&apos; THEN [cancellation_owner]&#10;WHEN &apos;Cancellation Reason&apos; THEN [cancellation_reason]&#10;WHEN &apos;Cancellation Stage&apos; THEN [cancellation_stage]&#10;WHEN &apos;Cancellation Source&apos; THEN [cancellation_source]&#10;WHEN &apos;Is Upcoming Order Cancelled?&apos; THEN STR([cancellation_is_upcoming_order])&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Transmission Flow&apos; THEN [transmission_flow]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;WHEN &apos;Delivery Type&apos; THEN [delivery_type]&#10;WHEN &apos;Client&apos; THEN [application_client_name]&#10;WHEN &apos;POS Integration Type&apos; THEN [application_integration_type]&#10;WHEN &apos;Is Preorder?&apos; THEN STR([is_preorder])&#10;WHEN &apos;Is Auto-Accept Configured?&apos; THEN STR([is_auto_accept_configured])&#10;END' />
      </column>
      <column caption='Orders - Fails - Table Metric' datatype='real' name='[Calculation_5909004253129814021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;% of all orders&apos;&#10;THEN&#10;(SUM([orders])&#10;/&#10;SUM({EXCLUDE [Calculation_5909004253127929859], [Orders - Fails - Dim A (copy)_5909004253129601028]: SUM([orders])}))&#10;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% of failed orders&apos;&#10;THEN&#10;(SUM([orders])&#10;/&#10;SUM({EXCLUDE [Calculation_5909004253127929859], [Orders - Fails - Dim A (copy)_5909004253129601028]: SUM(IF [order_status] != &apos;completed&apos; THEN [orders] ELSE 0 END)}))&#10;END' />
      </column>
      <column caption='# Orders' datatype='integer' name='[Calculation_5909004253145391110]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders])' />
      </column>
      <column caption='% NGT Orders' datatype='real' name='[Calculation_5909004253145460743]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_ngt_device] = TRUE THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% Go Client Orders' datatype='real' name='[Calculation_5909004253145722888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF STARTSWITH([application_client_name], &quot;GO&quot;) THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% Godroid Orders' datatype='real' name='[Calculation_5909004253145964553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [application_client_name] = &apos;GODROID&apos; THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% POS Orders' datatype='real' name='[Calculation_5909004253146415116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF NOT ISNULL([application_integration_type]) THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% Direct POS Orders' datatype='real' name='[Calculation_5909004253146644493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [application_integration_type] = &apos;DIRECT&apos; THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% Direct + GO POS Orders' datatype='real' name='[Calculation_5909004253146906639]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF STARTSWITH([application_client_name], &quot;GO&quot;) AND [application_integration_type] = &apos;DIRECT&apos; THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% Own Delivery Orders' datatype='real' name='[Calculation_5909004253147164688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [delivery_type] = &apos;OWN_DELIVERY&apos; THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% Pre-Orders' datatype='real' name='[Calculation_5909004253147652115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_preorder] THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% Auto-Accept Configured Orders' datatype='real' name='[Calculation_5909004253168537626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_auto_accept_configured] THEN [orders] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='Avg. Acceptance Response Time (seconds)' datatype='real' name='[Calculation_5909004253171650590]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &apos;completed&apos; THEN [response_time] END)&#10;/&#10;sum(IF [order_status] = &apos;completed&apos; THEN [response_time_count] END)' />
      </column>
      <column caption='Line Break 1' datatype='integer' name='[Calculation_5909004253173100578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='% Auto-Accept Configured Orders Auto-Accepted' datatype='real' name='[Calculation_5909004253483978795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_auto_accept_configured] AND [is_order_auto_accepted] THEN [orders] ELSE 0 END)&#10;/&#10;SUM(IF [is_auto_accept_configured] THEN [orders] ELSE 0 END)' />
      </column>
      <column caption='ISO Week' datatype='integer' name='[Calculation_5909004253490094125]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='WEEK([created_date_local]) - 1' />
      </column>
      <column caption='% Order Growth WoW' datatype='real' name='[Calculation_5909004253505216558]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='(SUM(IF [Calculation_5909004253490094125] = (WEEK(TODAY()) - 2) THEN [orders] ELSE 0 END)&#10;/&#10;SUM(IF [Calculation_5909004253490094125] = (WEEK(TODAY()) - 3) THEN [orders] ELSE 0 END))&#10;- 1' />
      </column>
      <column caption='Is % Order Growth WoW Positive?' datatype='boolean' name='[Calculation_5909004253507874863]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_5909004253505216558] &gt; 0' />
      </column>
      <column caption='# Vendor Failed Orders' datatype='integer' name='[Calculation_849069275432022020]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_cancelled_by_vendor] THEN [orders] ELSE 0 END)' />
      </column>
      <column caption='Created Date Local - Months' datatype='date' name='[Created Date Local - Weeks (copy)_4002503800172236815]' role='dimension' type='quantitative' user:agg-type='Month-Trunc' user:base-field='created_date_local' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [created_date_local]))' scope-isolation='false' />
      </column>
      <column datatype='date' name='[Created Date Local - Weeks]' role='dimension' type='quantitative' user:agg-type='Week-Trunc' user:base-field='created_date_local' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [created_date_local]))' />
      </column>
      <column caption='Is % vFR Growth WoW Positive?' datatype='boolean' name='[Is % Order Growth WoW Positive? (copy)_849069275434741765]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[% Order Growth WoW (copy)_849069275431292930] &gt; 0' />
      </column>
      <column caption='LB - Order Summary Dimensions Expand' datatype='string' name='[LB - Fails Dimensions Expand (copy)_4139933968544223236]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Click the + or - sign near the header of Dimension A to adjust granulary as desired.&apos;' />
      </column>
      <column caption='LB - Summary' datatype='string' name='[LB - KPI charts (copy)_4002503800121962503]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Select the KPIs to display in the table below.&apos;' />
      </column>
      <column caption='LB - Filters' datatype='string' name='[LB - KPI charts (copy)_4002503800179150866]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Select a category to show more filters.&apos;' />
      </column>
      <column caption='Line Break 2' datatype='integer' name='[Line Break 1 (copy)_5909004253173157923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='Line Break 3' datatype='integer' name='[Line Break 2 (copy)_5909004253173207076]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='Line Break 4' datatype='integer' name='[Line Break 3 (copy)_5909004253173231653]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='Line Break 5' datatype='integer' name='[Line Break 4 (copy)_5909004253484453932]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='Line Break 6' datatype='integer' name='[Line Break 5 (copy)_4002503800118476804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='Line Break 7' datatype='integer' name='[Line Break 6 (copy)_1471832665981153286]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(NULL)' />
      </column>
      <column caption='Dimension B' datatype='string' name='[Orders - Fails - Dim A (copy)_5909004253129601028]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Orders - Fails - Dimension A (copy)_5909004253127778306]&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Entity ID&apos; THEN [entity_id]&#10;WHEN &apos;Cancellation Owner&apos; THEN [cancellation_owner]&#10;WHEN &apos;Cancellation Reason&apos; THEN [cancellation_reason]&#10;WHEN &apos;Cancellation Stage&apos; THEN [cancellation_stage]&#10;WHEN &apos;Cancellation Source&apos; THEN [cancellation_source]&#10;WHEN &apos;Is Upcoming Order Cancelled?&apos; THEN STR([cancellation_is_upcoming_order])&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Transmission Flow&apos; THEN [transmission_flow]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;WHEN &apos;Delivery Type&apos; THEN [delivery_type]&#10;WHEN &apos;Client&apos; THEN [application_client_name]&#10;WHEN &apos;POS Integration Type&apos; THEN [application_integration_type]&#10;WHEN &apos;Is Preorder?&apos; THEN STR([is_preorder])&#10;WHEN &apos;Is Auto-Accept Configured?&apos; THEN STR([is_auto_accept_configured])&#10;END' />
      </column>
      <column caption='Dimension A ' datatype='string' name='[Orders - Fails - Dim A (copy)_5909004253175627816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Orders - Fails - Dimension A (copy)_5909004253175435302]&#10;WHEN &apos;All&apos; THEN &apos;&apos;&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Entity ID&apos; THEN [entity_id]&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Transmission Flow&apos; THEN [transmission_flow]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;WHEN &apos;Delivery Type&apos; THEN [delivery_type]&#10;WHEN &apos;Client&apos; THEN [application_client_name]&#10;WHEN &apos;POS Integration Type&apos; THEN [application_integration_type]&#10;WHEN &apos;Is Preorder?&apos; THEN STR([is_preorder])&#10;WHEN &apos;Is Auto-Accept Configured?&apos; THEN STR([is_auto_accept_configured])&#10;END' />
      </column>
      <column caption='Dimension B ' datatype='string' name='[Orders - Summary - Dim A (copy)_5909004253175709737]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Orders - Summary - Dimension A (copy)_5909004253175570471]&#10;WHEN &apos;All&apos; THEN &apos;&apos;&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Entity ID&apos; THEN [entity_id]&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Transmission Flow&apos; THEN [transmission_flow]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;WHEN &apos;Delivery Type&apos; THEN [delivery_type]&#10;WHEN &apos;Client&apos; THEN [application_client_name]&#10;WHEN &apos;POS Integration Type&apos; THEN [application_integration_type]&#10;WHEN &apos;Is Preorder?&apos; THEN STR([is_preorder])&#10;WHEN &apos;Is Auto-Accept Configured?&apos; THEN STR([is_auto_accept_configured])&#10;END' />
      </column>
      <column caption='Time Granularity - Summary' datatype='string' name='[Time Granularity - Fails (copy)_4002503800173506577]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;  WHEN 1 THEN STR([created_date_local])&#10;  WHEN 2 THEN [order_week]&#10;  WHEN 3 THEN [order_month]&#10;END' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='vendor_ops_dashboard_order_attributes' datatype='table' name='[__tableau_internal_object_id__].[vendor_ops_dashboard_order_attributes_C91377F824734E8C99B921AC9205284E]' role='measure' type='quantitative' />
      <column caption='Access Group' datatype='string' name='[access_group]' role='dimension' type='nominal' />
      <column caption='Application Client Name' datatype='string' name='[application_client_name]' role='dimension' type='nominal'>
        <aliases>
          <alias key='%null%' value='NA' />
        </aliases>
      </column>
      <column caption='Application Client Wrapper Type' datatype='string' name='[application_client_wrapper_type]' role='dimension' type='nominal' />
      <column caption='Application Integration Type' datatype='string' name='[application_integration_type]' role='dimension' type='nominal'>
        <aliases>
          <alias key='%null%' value='Non-POS' />
        </aliases>
      </column>
      <column caption='Actual Prep Time (assumed, in minutes)' datatype='real' name='[assumed_actual_preparation_time_minutes]' role='measure' type='quantitative' />
