    <worksheet name='Fails Table'>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_ops_dashboard_order_attributes (jeetendra_manjunath)' name='federated.0h4ojdc11i4lzt10wpqhw0ga7osm' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Orders - Fails - Dimension B' datatype='string' name='[Orders - Fails - Dimension A (copy)_5909004253127778306]' param-domain-type='list' role='measure' type='nominal' value='&quot;Cancellation Reason&quot;'>
              <calculation class='tableau' formula='&quot;Cancellation Reason&quot;' />
            </column>
            <column alias='Day' caption='Orders - Fails - Time Granularity' datatype='integer' datatype-customized='true' name='[Orders - Summary - Time Granularity (copy)_4002503800169734156]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Day' />
                <alias key='2' value='Week' />
                <alias key='3' value='Month' />
              </aliases>
            </column>
            <column caption='Orders - Fails - Dimension A' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Cancellation Owner&quot;'>
              <calculation class='tableau' formula='&quot;Cancellation Owner&quot;' />
            </column>
            <column caption='Fails Table - View As' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% of all orders&quot;'>
              <calculation class='tableau' formula='&quot;% of all orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0h4ojdc11i4lzt10wpqhw0ga7osm'>
            <column caption='Time Granularity - Fails' datatype='string' name='[Calculation_4002503800172343312]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Orders - Summary - Time Granularity (copy)_4002503800169734156]&#10;  WHEN 1 THEN STR([created_date_local])&#10;  WHEN 2 THEN [order_week]&#10;  WHEN 3 THEN [order_month]&#10;END' />
            </column>
            <column caption='Dimension A' datatype='string' name='[Calculation_5909004253127929859]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Entity ID&apos; THEN [entity_id]&#10;WHEN &apos;Cancellation Owner&apos; THEN [cancellation_owner]&#10;WHEN &apos;Cancellation Reason&apos; THEN [cancellation_reason]&#10;WHEN &apos;Cancellation Stage&apos; THEN [cancellation_stage]&#10;WHEN &apos;Cancellation Source&apos; THEN [cancellation_source]&#10;WHEN &apos;Is Upcoming Order Cancelled?&apos; THEN STR([cancellation_is_upcoming_order])&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Transmission Flow&apos; THEN [transmission_flow]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;WHEN &apos;Delivery Type&apos; THEN [delivery_type]&#10;WHEN &apos;Client&apos; THEN [application_client_name]&#10;WHEN &apos;POS Integration Type&apos; THEN [application_integration_type]&#10;WHEN &apos;Is Preorder?&apos; THEN STR([is_preorder])&#10;WHEN &apos;Is Auto-Accept Configured?&apos; THEN STR([is_auto_accept_configured])&#10;END' />
            </column>
            <column caption='Orders - Fails - Table Metric' datatype='real' name='[Calculation_5909004253129814021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;% of all orders&apos;&#10;THEN&#10;(SUM([orders])&#10;/&#10;SUM({EXCLUDE [Calculation_5909004253127929859], [Orders - Fails - Dim A (copy)_5909004253129601028]: SUM([orders])}))&#10;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;% of failed orders&apos;&#10;THEN&#10;(SUM([orders])&#10;/&#10;SUM({EXCLUDE [Calculation_5909004253127929859], [Orders - Fails - Dim A (copy)_5909004253129601028]: SUM(IF [order_status] != &apos;completed&apos; THEN [orders] ELSE 0 END)}))&#10;END' />
            </column>
            <column caption='Dimension B' datatype='string' name='[Orders - Fails - Dim A (copy)_5909004253129601028]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Orders - Fails - Dimension A (copy)_5909004253127778306]&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Entity ID&apos; THEN [entity_id]&#10;WHEN &apos;Cancellation Owner&apos; THEN [cancellation_owner]&#10;WHEN &apos;Cancellation Reason&apos; THEN [cancellation_reason]&#10;WHEN &apos;Cancellation Stage&apos; THEN [cancellation_stage]&#10;WHEN &apos;Cancellation Source&apos; THEN [cancellation_source]&#10;WHEN &apos;Is Upcoming Order Cancelled?&apos; THEN STR([cancellation_is_upcoming_order])&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Transmission Flow&apos; THEN [transmission_flow]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;WHEN &apos;Delivery Type&apos; THEN [delivery_type]&#10;WHEN &apos;Client&apos; THEN [application_client_name]&#10;WHEN &apos;POS Integration Type&apos; THEN [application_integration_type]&#10;WHEN &apos;Is Preorder?&apos; THEN STR([is_preorder])&#10;WHEN &apos;Is Auto-Accept Configured?&apos; THEN STR([is_auto_accept_configured])&#10;END' />
            </column>
