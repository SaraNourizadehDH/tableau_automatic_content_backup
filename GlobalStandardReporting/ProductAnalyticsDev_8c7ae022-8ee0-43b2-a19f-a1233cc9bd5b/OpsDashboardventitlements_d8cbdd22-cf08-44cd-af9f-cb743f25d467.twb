      </column>
      <column caption='% A+ Vendors' datatype='real' name='[Calculation_3407465708892131352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [vendor_grade] IN (&apos;A&apos;, &apos;AA&apos;, &apos;AAA&apos;) THEN [active_vendors] END)&#10;/&#10;SUM([active_vendors])' />
      </column>
      <column caption='% GO Vendors' datatype='real' name='[Calculation_3407465708892438553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF STARTSWITH([client_name], &apos;GO&apos;) THEN [active_vendors] END)&#10;/&#10;SUM([active_vendors])' />
      </column>
      <column caption='% Chain Vendors' datatype='real' name='[Calculation_3407465708892983323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_chain] THEN [active_vendors] END)&#10;/&#10;SUM([active_vendors])' />
      </column>
      <column caption='% GoDroid Vendors' datatype='real' name='[Calculation_3407465708893417500]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [client_name] = &apos;GODROID&apos; THEN [active_vendors] END)&#10;/&#10;SUM([active_vendors])' />
      </column>
      <column caption='% Offline Duration' datatype='real' name='[Calculation_3407465708893913119]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([offline_duration_seconds])&#10;/&#10;SUM([schedule_duration_seconds])' />
      </column>
      <column caption='Schedule Duration (mins)' datatype='real' name='[Calculation_3407465708894568487]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([schedule_duration_seconds])/60' />
      </column>
      <column caption='Offline Duration - View As - Is Overall?' datatype='boolean' name='[Calculation_3407465708897202217]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 10] = &apos;Overall&apos;' />
      </column>
      <column caption='# Vendors with Orders' datatype='integer' name='[Calculation_3407465708911640618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF NOT [is_zombie_vendor] THEN [active_vendors] ELSE 0 END)' />
      </column>
      <column caption='_is_load_extract' datatype='boolean' name='[Calculation_356628815436005378]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 14]' />
      </column>
      <column caption='LB - KPI Boxes' datatype='string' name='[Calculation_4125578743254020097]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;KPIs are based on current configurations available in Vendor Management.&apos;' />
      </column>
      <column caption='% Self-Activated Vendors' datatype='real' name='[Calculation_4569183314817720320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([self_activated_vendors])&#10;/&#10;SUM([all_activated_vendors])' />
      </column>
      <column caption='% OBS Shipment Share' datatype='real' name='[Calculation_4569183314817822721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([obs_shipments])&#10;/&#10;SUM([all_shipments])' />
      </column>
      <column caption='Dimension A' datatype='string' name='[Calculation_4569183314820792329]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Orders - Summary - Dimension A (copy)_4569183314820435974]&#10;WHEN &apos;All&apos; THEN &apos;&apos;&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Entity ID&apos; THEN [entity_id]&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Client&apos; THEN [client_name]&#10;WHEN &apos;POS Integration Type&apos; THEN [pos_integration_type]&#10;END' />
      </column>
      <column caption='Table Metric' datatype='real' name='[Calculation_4569183314821480460]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 13]&#10;WHEN &apos;% OBS Shipment Share&apos;&#10;  THEN [Calculation_4569183314817822721]&#10;WHEN &apos;# All Device Shipments&apos;&#10;  THEN SUM([all_shipments])&#10;WHEN &apos;# OBS Shipments&apos;&#10;  THEN SUM([obs_shipments])&#10;WHEN &apos;# Activated Vendors&apos;&#10;  THEN [Calculation_4569183314822651917]&#10;WHEN &apos;# Self Activated Vendors&apos;&#10;  THEN SUM([self_activated_vendors])&#10;WHEN &apos;% Self-Activated Vendors&apos;&#10;  THEN [Calculation_4569183314817720320]&#10;END' />
      </column>
      <column caption='# All Activated Vendors' datatype='integer' name='[Calculation_4569183314822651917]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([all_activated_vendors])' />
      </column>
      <column caption='Table Metric to Display' datatype='string' name='[Calculation_4569183314832293903]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 13]' />
      </column>
      <column caption='Dimension - Attributes Dist.' datatype='string' name='[Calculation_5037698410324606976]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 12]&#10;WHEN &apos;GO Client&apos;&#10;  THEN [client_name]&#10;WHEN &apos;POS&apos;&#10;  THEN [pos_integration_type]&#10;WHEN &apos;Vendor Grade&apos;&#10;  THEN [vendor_grade]&#10;WHEN &apos;Vertical Type - grouped&apos;&#10;  THEN [vertical_food]&#10;WHEN &apos;New/Old Vendors&apos;&#10;  THEN IF [is_new_vendor]&#10;         THEN &apos;New Vendors&apos;&#10;       ELSE &apos;Existing Vendors&apos;&#10;       END&#10;WHEN &apos;Vendors with Orders&apos;&#10;  THEN IF [is_zombie_vendor]&#10;         THEN &apos;Vendors with Orders&apos;&#10;       ELSEIF NOT [is_zombie_vendor]&#10;         THEN &apos;Vendors without Orders&apos;&#10;       ELSE &apos;Others&apos;&#10;       END&#10;END' />
      </column>
      <column caption='_user_entitlement' datatype='boolean' name='[Calculation_528047075899461632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Time Granularity - Offline' datatype='string' name='[Calculation_622693022042456065]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Orders - Fails - Time Granularity (copy)_622693022042365952]&#10;  WHEN 1 THEN STR([created_date_local])&#10;  WHEN 2 THEN [created_week]&#10;  WHEN 3 THEN [created_month]&#10;END' />
      </column>
      <column caption='Dimension B' datatype='string' name='[Dimension A (copy)_4569183314820993034]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Lifecycle - Dimension A (copy)_4569183314820587527]&#10;WHEN &apos;All&apos; THEN &apos;&apos;&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Entity ID&apos; THEN [entity_id]&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Client&apos; THEN [client_name]&#10;WHEN &apos;POS Integration Type&apos; THEN [pos_integration_type]&#10;END' />
      </column>
      <column caption='LB - Distribution Percentages' datatype='string' name='[LB - Geography expand (copy)_5037698410337579011]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Distribution percentages are out of Region/Entity displayed&apos;' />
      </column>
      <column caption='LB - Geography expand' datatype='string' name='[LB - KPI Boxes (copy)_5037698410336346114]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Click on the + sign (appears when you hover to the right) to expand from Regional view to an Entity-level view&apos;' />
      </column>
      <column caption='LB - Client/POS Filter Callout' datatype='string' name='[LB - KPI Boxes (copy)_6929210254454796289]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;For % Offline Rate, the filters for Client Name and POS Integration Type will filter based on a vendor&apos;s current Client and POS data (historical filter is not possible currently, but is being worked upon).&quot;' />
      </column>
      <column caption='Time Granularity - Lifecycle' datatype='string' name='[Time Granularity - Offline (copy)_4569183314817966082]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Orders - Fails - Time Granularity (copy)_4569183314818117635]&#10;  WHEN 1 THEN STR([created_date_local])&#10;  WHEN 2 THEN [created_week]&#10;  WHEN 3 THEN [created_month]&#10;END' />
      </column>
