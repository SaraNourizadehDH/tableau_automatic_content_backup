              <calculation class='tableau' formula='SUM([offline_duration_seconds])&#10;/&#10;SUM([schedule_duration_seconds])' />
            </column>
            <column caption='Schedule Duration (mins)' datatype='real' name='[Calculation_3407465708894568487]' role='measure' type='quantitative'>
