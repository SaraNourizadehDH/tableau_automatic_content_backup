            <column caption='% Deflection Rate' datatype='real' name='[Calculation_3407465708729344010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF NOT [has_contacts] THEN [sessions] END)&#10;/&#10;SUM([sessions])' />
