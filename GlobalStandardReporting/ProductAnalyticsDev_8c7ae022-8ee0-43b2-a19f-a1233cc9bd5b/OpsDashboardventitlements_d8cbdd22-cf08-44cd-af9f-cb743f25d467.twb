      <aliases enabled='yes' />
      <column caption='% Non-Live-Order Contact Rate' datatype='real' name='[% Live-Order Contact Rate (copy)_4002503800800309291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF NOT [Calculation_4002503800579801128] THEN [vendor_contacts] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='CR Table Metric (for added precision)' datatype='real' name='[CR Table Metric (copy)_3407465708727283719]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;&#10;WHEN &apos;# Contacts&apos; THEN -1 * SUM([vendor_contacts])&#10;&#10;WHEN &apos;% Contacts&apos; THEN &#10;SUM([vendor_contacts]) / SUM({ EXCLUDE [Calculation_4002503800820092977], [contact_reason_l1], [contact_reason_l2], [contact_reason_l3]: SUM([vendor_contacts])})&#10;&#10;WHEN &apos;% Contact Rate&apos; THEN [Calculation_3407465708722020357]&#10;END' />
      </column>
      <column caption='_user_entittlement' datatype='boolean' name='[Calculation_2314498377687216128]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
      </column>
      <column caption='% Contacts from HC Sessions' datatype='real' name='[Calculation_3407465708670005249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions_contacts])&#10;/&#10;SUM([vendor_contacts])' />
      </column>
      <column caption='% Inaccurate Order Rate' datatype='real' name='[Calculation_3407465708714491906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([inaccurate_order_contacts])&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% Late Delivery Contact Rate (VD)' datatype='real' name='[Calculation_3407465708714569731]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vd_delay_contacts])&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% Food Quality Contact Rate' datatype='real' name='[Calculation_3407465708714680324]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([food_quality_contacts])&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% Contact Rate - Table' datatype='real' name='[Calculation_3407465708722020357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([all_contacts])&#10;/&#10;(CASE [Parameters].[Orders - Summary - Dimension A (copy)_4002503800819843120]&#10;WHEN IN (&apos;All&apos;, &apos;Region&apos;, &apos;Country&apos;, &apos;Brand Name&apos;, &apos;Entity ID&apos;, &apos;Vertical Type&apos;) &#10;THEN SUM({ FIXED [Time Granularity - Contact Rate (copy)_4002503800821403700], [Calculation_4002503800820092977]: SUM([orders])})&#10;ELSE SUM({ FIXED [Time Granularity - Contact Rate (copy)_4002503800821403700]: SUM([orders])})&#10;END)' />
      </column>
      <column caption='KPI to Display - CR' datatype='string' name='[Calculation_3407465708727005190]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 5]' />
      </column>
      <column caption='% Deflection Rate' datatype='real' name='[Calculation_3407465708729344010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF NOT [has_contacts] THEN [sessions] END)&#10;/&#10;SUM([sessions])' />
      </column>
      <column caption='% Live Order Sessions' datatype='real' name='[Calculation_3407465708730466315]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_live_order_session] THEN [sessions] ELSE 0 END)&#10;/&#10;SUM([sessions])' />
      </column>
      <column caption='First/Last Leaves' datatype='string' name='[Calculation_3407465708733546509]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &apos;First Leaf&apos;&#10;THEN [first_leaf_visited]&#10;ELSE [last_leaf_visited]&#10;END' />
        <aliases>
          <alias key='%null%' value='NA' />
        </aliases>
      </column>
      <column caption='Top N Leaves Filter' datatype='string' name='[Calculation_3407465708735385616]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Top N Leaves]&#10;THEN &apos;Top &apos; + str([Parameters].[Parameter 9]) + &apos; Leaves&apos;&#10;ELSE &apos;Others&apos;&#10;END' />
      </column>
      <column caption='% Sessions (leaves)' datatype='real' name='[Calculation_3407465708736266257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions])&#10;/&#10;SUM({ EXCLUDE [Calculation_4139933968174755840]: SUM([sessions])})' />
      </column>
      <column caption='Avg. Session Duration (mins)' datatype='real' name='[Calculation_3407465708737699858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([session_duration_seconds])/60)&#10;/&#10;SUM([sessions])' />
      </column>
      <column caption='Avg. # of Nodes Visited' datatype='real' name='[Calculation_3407465708738351124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nodes_visited])&#10;/&#10;SUM([sessions])' />
      </column>
      <column caption='_is_load_extract' datatype='boolean' name='[Calculation_356628815435857921]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 14]' />
      </column>
      <column caption='Is Live Order Contact?' datatype='boolean' name='[Calculation_4002503800579801128]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [contact_reason_l1] = &apos;Live order inquiries by restaurant&apos; AND [vendor_contacts] &gt; 0 and NOT ISNULL([vendor_contacts])&#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
        <aliases>
          <alias key='false' value='Non-Live-Order' />
          <alias key='true' value='Live-Order' />
        </aliases>
      </column>
      <column caption='# Vendor Contacts' datatype='integer' name='[Calculation_4002503800799858729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_contacts])' />
      </column>
      <column caption='% Live-Order Contact Rate' datatype='real' name='[Calculation_4002503800799952938]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_4002503800579801128] THEN [vendor_contacts] ELSE 0 END)&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='% Vendor Contact Rate' datatype='real' name='[Calculation_4002503800800882732]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_contacts])&#10;/&#10;SUM([orders])' />
      </column>
      <column caption='Time Granularity - Contact Rate' datatype='string' name='[Calculation_4002503800804085807]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Orders - Summary - Time Granularity (copy)_4002503800803131437]&#10;  WHEN 1 THEN STR([created_date_local])&#10;  WHEN 2 THEN [created_week]&#10;  WHEN 3 THEN [created_month]&#10;END' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_4002503800820092977]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Orders - Summary - Dimension A (copy)_4002503800819843120]&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Brand Name&apos; THEN [brand_name]&#10;WHEN &apos;Country&apos; THEN [country_name]&#10;WHEN &apos;Entity ID&apos; THEN [entity_id]&#10;WHEN &apos;Stakeholder Entry Point&apos; THEN [stakeholder_entry_point]&#10;WHEN &apos;Channel&apos; THEN [channel]&#10;WHEN &apos;Vertical Type&apos; THEN [vertical_type]&#10;WHEN &apos;Vendor Grade&apos; THEN [vendor_grade]&#10;WHEN &apos;Stakeholder&apos; THEN [stakeholder]&#10;ELSE &apos;All&apos;&#10;END' />
      </column>
      <column caption='CR Table Metric' datatype='real' name='[Calculation_4002503800820768819]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;&#10;WHEN &apos;# Contacts&apos; THEN -1 * SUM([vendor_contacts])&#10;&#10;WHEN &apos;% Contacts&apos; THEN &#10;SUM([vendor_contacts]) / SUM({ EXCLUDE [Calculation_4002503800820092977], [contact_reason_l1], [contact_reason_l2], [contact_reason_l3]: SUM([vendor_contacts])})&#10;&#10;WHEN &apos;% Contact Rate&apos; THEN [Calculation_3407465708722020357]&#10;END' />
      </column>
      <column caption='LB - Contacts Overview' datatype='string' name='[Calculation_4125578743255252994]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Summaries based on the last 14 days.&apos;' />
      </column>
      <column caption='Note: Decimal precision' datatype='string' name='[Calculation_4125578743255998467]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;% Contact Rate&apos;&#10;THEN &apos;Note: Hover to see higher decimal precision in the tooltip.&apos;&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='LB - Contact Rate' datatype='string' name='[Calculation_4125578743257055236]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Contact Rate is calculated as # Contacts / # Orders for given time period.&#10;Live-Order and Non-Live Order Contact Rates are calculated based on Vendor contacts.&apos;' />
      </column>
      <column caption='Session CR' datatype='string' name='[Calculation_4139933968174755840]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &apos;First Leaf&apos;&#10;THEN&#10;CASE [Parameters].[Parameter 11]&#10;WHEN &apos;CR1&apos; THEN [first_leaf_reason_l1]&#10;WHEN &apos;CR2&apos; THEN [first_leaf_reason_l2]&#10;WHEN &apos;CR3&apos; THEN [first_leaf_reason_l3]&#10;END&#10;ELSE&#10;CASE [Parameters].[Parameter 11]&#10;WHEN &apos;CR1&apos; THEN [last_leaf_reason_l1]&#10;WHEN &apos;CR2&apos; THEN [last_leaf_reason_l2]&#10;WHEN &apos;CR3&apos; THEN [last_leaf_reason_l3]&#10;END&#10;END' />
        <aliases>
          <alias key='%null%' value='NA' />
        </aliases>
      </column>
      <column caption='% Overall Contact Rate' datatype='real' name='[Calculation_5700571980811313152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[% Live-Order Contact Rate (copy)_4002503800800309291] + [Calculation_4002503800799952938]' />
      </column>
      <column caption='First/Last Nodes' datatype='string' name='[First/Last Leaves (copy)_3407465708734083087]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &apos;First Leaf&apos;&#10;THEN [first_node_visited]&#10;ELSE [last_node_visited]&#10;END' />
        <aliases>
          <alias key='%null%' value='NA' />
        </aliases>
      </column>
      <column caption='LB - CR Expand' datatype='string' name='[LB - Contact Rate (copy)_4125578743427964934]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Click on the + or - signs near the headers of Contact Reason L1 or L2 to expand or collapse granularity.&apos;' />
      </column>
      <column caption='LB - NA Session reason' datatype='string' name='[LB - Contact Rate (copy)_6929210254432980992]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;&quot;NA&quot; represents sessions where the vendor did not click on any leaf (that could be mapped to a CR). Possibly, they were browsing through the different topics in the Help Center.&apos;' />
      </column>
      <column caption='LB - First/Last Leaf' datatype='string' name='[LB - Contacts Overview (copy)_4125578743259267077]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;First Leaf: The first leaf visited by Vendors during an HC session&#10;Last Leaf: The final leaf visited by Vendors before ending an HC session&apos;' />
      </column>
      <column caption='LB - Deflection Rate' datatype='string' name='[LB - First/Last Leaf (copy)_5354357754479972352]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;% Deflection Rate: % of sessions that do not generate contacts.&#10;% Live-order Sessions: % of sessions that can be mapped to a Contact Reason for &quot;Live Order Inquiry by Restaurant&quot;.&#10;This is mapped based on first and last leaf visited, and based on contacts created as part of this session.&apos;' />
      </column>
      <column caption='Time Granularity - Sessions Combo' datatype='string' name='[Time Granularity - CR Reasons (copy)_3407465708729020424]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Contacts - Contact Rate - Time Granularity (copy)_3407465708729118729]&#10;  WHEN 1 THEN STR([created_date_local])&#10;  WHEN 2 THEN [created_week]&#10;  WHEN 3 THEN [created_month]&#10;END' />
      </column>
      <column caption='Time Granularity - CR Reasons' datatype='string' name='[Time Granularity - Contact Rate (copy)_4002503800821403700]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Contacts - Contact Rate - Time Granularity (copy)_4002503800821420085]&#10;  WHEN 1 THEN STR([created_date_local])&#10;  WHEN 2 THEN [created_week]&#10;  WHEN 3 THEN [created_month]&#10;END' />
      </column>
