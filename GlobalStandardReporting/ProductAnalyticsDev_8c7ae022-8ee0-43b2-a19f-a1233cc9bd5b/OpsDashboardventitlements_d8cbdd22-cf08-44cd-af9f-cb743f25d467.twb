              <calculation class='tableau' formula='SUM([sessions])&#10;/&#10;SUM({ EXCLUDE [Calculation_4139933968174755840]: SUM([sessions])})' />
            </column>
            <column caption='Session CR' datatype='string' name='[Calculation_4139933968174755840]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 8] = &apos;First Leaf&apos;&#10;THEN&#10;CASE [Parameters].[Parameter 11]&#10;WHEN &apos;CR1&apos; THEN [first_leaf_reason_l1]&#10;WHEN &apos;CR2&apos; THEN [first_leaf_reason_l2]&#10;WHEN &apos;CR3&apos; THEN [first_leaf_reason_l3]&#10;END&#10;ELSE&#10;CASE [Parameters].[Parameter 11]&#10;WHEN &apos;CR1&apos; THEN [last_leaf_reason_l1]&#10;WHEN &apos;CR2&apos; THEN [last_leaf_reason_l2]&#10;WHEN &apos;CR3&apos; THEN [last_leaf_reason_l3]&#10;END&#10;END' />
