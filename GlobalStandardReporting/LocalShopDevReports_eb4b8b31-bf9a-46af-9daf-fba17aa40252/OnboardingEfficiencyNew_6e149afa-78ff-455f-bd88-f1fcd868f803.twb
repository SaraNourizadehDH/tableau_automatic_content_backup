      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0z2kmpb1abxjmn0zvgfcu13hpmez].[avg:CC_Avg_days:qk]&quot;' value='CC Average Time (Days)' />
          <alias key='&quot;[federated.0z2kmpb1abxjmn0zvgfcu13hpmez].[avg:MPC_Avg_days:qk]&quot;' value='MPC Average Time (Days)' />
          <alias key='&quot;[federated.0z2kmpb1abxjmn0zvgfcu13hpmez].[usr:Calculation_599823219067293697:qk]&quot;' value='CC Successful Cases' />
          <alias key='&quot;[federated.0z2kmpb1abxjmn0zvgfcu13hpmez].[usr:CC_successful_cases (copy)_599823219071967234:qk]&quot;' value='MPC Successful Cases' />
        </aliases>
      </column>
      <column caption='MPC_successful_cases' datatype='integer' name='[CC_successful_cases (copy)_599823219071967234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([mpc_nr_sucessful_cases])' />
      </column>
      <column caption='% Master Product Created' datatype='real' name='[Calculation_1127870273956610050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_master_products_created])/ SUM([nr_master_products_requested])' />
      </column>
      <column caption='Vendor FTE Ratio (Overall)' datatype='real' name='[Calculation_1203305564206051350]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_457396869836697607]/[Onboarded Vendors (copy)_457396869838823432]' />
      </column>
      <column caption='FTEs_agg_monthly' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1269170709546049541]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([nr_users_monthly])' />
      </column>
      <column caption='Vendor FTE Ratio' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1269170709546188806]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;[Parameters].[Parameter 1] = &apos;Monthly&apos; THEN [Calculation_457396869836697607]/[Calculation_1269170709546049541]&#13;&#10;ELSEIF &#13;&#10;[Parameters].[Parameter 1] = &apos;Weekly&apos; THEN [Calculation_457396869836697607]/[Calculation_1269170709751341063]&#13;&#10;END' />
      </column>
      <column caption='FTEs_agg_weekly' datatype='real' name='[Calculation_1269170709751341063]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([nr_users_weekly])' />
      </column>
      <column caption='FTEs_agg_week_month' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1269170709769310217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;[Parameters].[Parameter 1] = &apos;Monthly&apos; THEN [Calculation_1269170709546049541]&#13;&#10;ELSEIF &#13;&#10;[Parameters].[Parameter 1] = &apos;Weekly&apos; THEN [Calculation_1269170709751341063]&#13;&#10;END' />
      </column>
      <column caption='Flawless Onboarding Accounts' datatype='integer' name='[Calculation_1672805823950176258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [flawless_onboarding_check]=1 THEN [account_id] END)' />
      </column>
      <column caption='%Flawless Onboarding Accounts' datatype='real' name='[Calculation_1672805823951794179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1672805823950176258]/[Calculation_457396869836697607]' />
      </column>
      <column caption='Total_distinct_agents' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1926696255741906944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD([country__c]) &gt; 1 AND COUNTD([management_entity])&gt; 1  THEN&#13;&#10;AVG([nr_total_users])&#13;&#10;ELSEIF COUNTD([management_entity]) = 1 AND COUNTD([country__c]) &gt; 1 THEN&#13;&#10;AVG([nr_users_me])&#13;&#10;ELSE&#13;&#10;AVG([nr_users_country])&#13;&#10;END' />
      </column>
      <column caption='Vendor Per Agent (Country)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1926696255747104770]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_457396869836697607]/[Calculation_1926696255741906944]' />
      </column>
      <column caption='Truncated Date' datatype='date' name='[Calculation_457396869835522048]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='Date(closed_date)' />
      </column>
      <column caption='Truncated Date (Days)' datatype='date' name='[Calculation_457396869835714561]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;day&apos;, [Calculation_457396869835522048]))' />
      </column>
      <column caption='Truncated Date (Months)' datatype='date' name='[Calculation_457396869835812866]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [Calculation_457396869835522048]))' />
      </column>
      <column caption='Truncated Date (Quarter)' datatype='date' name='[Calculation_457396869835890691]' role='dimension' type='ordinal'>
