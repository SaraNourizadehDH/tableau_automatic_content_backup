    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Menu Processing Overview Tab'>
      <repository-location id='MenuProcessingOverviewTab' path='/t/GlobalStandardReporting/workbooks/OnboardingEfficiencyNew' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='wrap' id='dash-text_1874' value='auto' />
        </style-rule>
        <style-rule element='parameter-ctrl'>
          <format attr='font-weight' value='bold' />
        </style-rule>
      </style>
      <size maxheight='1700' maxwidth='1500' minheight='1700' minwidth='1500' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='qcls_salesforce_vendor_onboarding_data_mp (dev_dmart)' name='federated.0z2kmpb1abxjmn0zvgfcu13hpmez' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
          <calculation class='tableau' formula='&quot;Weekly&quot;' />
          <members>
            <member value='&quot;Weekly&quot;' />
            <member value='&quot;Monthly&quot;' />
          </members>
