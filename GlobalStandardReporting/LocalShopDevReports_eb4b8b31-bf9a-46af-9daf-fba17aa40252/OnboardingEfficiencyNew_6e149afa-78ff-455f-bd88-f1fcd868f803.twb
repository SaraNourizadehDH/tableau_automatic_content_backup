    <worksheet name='Case Level-Master Product On Hold Time'>
      <table>
        <view>
          <datasources>
            <datasource caption='_qcls_salesforce_vendor_onboarding_data_case_level (dev_dmart)' name='federated.0nz0l2v1uaovju1e6yta4052f6nu' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0nz0l2v1uaovju1e6yta4052f6nu'>
            <column caption='Avg life of cases in Stage (in Days) On Hold' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Avg life of cases in Stage (in Days) (copy)_1597089069663133703]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM (IF [stage]= &apos;On Hold&apos; Then([stage_duration_hour])/24 END )/sum([Calculation_1597089069362610176])' />
            </column>
            <column aggregation='Attribute' caption='Total Case Count - All Stages' datatype='integer' name='[Calculation_1597089069362610176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE [stage]:COUNTD([case_id])}' />
            </column>
            <column caption='Truncated Date' datatype='date' name='[Calculation_1700108908309581824]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='Date([closedate])' />
