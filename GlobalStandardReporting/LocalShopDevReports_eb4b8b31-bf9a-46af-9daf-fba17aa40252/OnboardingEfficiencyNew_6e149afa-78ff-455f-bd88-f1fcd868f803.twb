      </column>
      <column caption='Truncated Date (Weekd numbers)' datatype='date' name='[Calculation_457396869835960324]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [Calculation_457396869835522048]))' />
      </column>
      <column caption='Report Date' datatype='date' name='[Calculation_457396869836034053]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF &#13;&#10;[Parameters].[Parameter 1] = &apos;Daily&apos; then [Calculation_457396869835714561]&#13;&#10;ELSEIF &#13;&#10;[Parameters].[Parameter 1] = &apos;Weekly&apos; then [closed_date_w]&#13;&#10;ELSEIF &#13;&#10;[Parameters].[Parameter 1] = &apos;Monthly&apos; then [closed_date_m]&#13;&#10;END' />
      </column>
      <column caption='Report Date (range)' datatype='date' name='[Calculation_457396869836124166]' role='dimension' type='ordinal'>
