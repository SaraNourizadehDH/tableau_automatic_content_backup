    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Glossary'>
      <repository-location id='Glossary' path='/t/GlobalStandardReporting/workbooks/OnboardingEfficiencyNew' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_169' value='left' />
          <format attr='text-orientation' id='dash-text_169' value='0' />
          <format attr='vertical-align' id='dash-text_169' value='top' />
          <format attr='vertical-align' id='dash-text_161' value='top' />
        </style-rule>
      </style>
      <size maxheight='1700' maxwidth='1500' minheight='1700' minwidth='1500' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='94117' id='5' param='vert' type-v2='layout-flow' w='26867' x='533' y='5412'>
            <zone forceUpdate='true' h='29118' id='22' type-v2='text' w='26867' x='533' y='5412'>
              <formatted-text>
                <run bold='true' fontcolor='#aa0000' fontsize='11'>Filters</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000'>Report Date (range)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Date range filter based on &apos;Closed date&apos; from case type Catalog creation or Master Product Creation for Onboarding Vendor.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000'>Date Granularity</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Filtering data based on Date Granularity</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000'>Business Type</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Filter to get data on different Business Types i.e. New Business, Win Back etc</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000'>Management Entity</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Filter to get different management Entity</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000'>Country</run>
                <run fontcolor='#000000'>Æ </run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Filter to get country</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000'>Vertical Segement</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Filter to get different Verticals</run>
                <run>Æ&#10;&#10;</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone forceUpdate='true' h='4941' id='6' type-v2='text' w='98934' x='533' y='471'>
            <formatted-text>
              <run bold='true' fontcolor='#aa0000' fontsize='12'>GLOSSARY</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='94117' id='21' param='horz' type-v2='layout-flow' w='36033' x='63434' y='5412'>
            <zone forceUpdate='true' h='94117' id='161' type-v2='text' w='36033' x='63434' y='5412'>
              <formatted-text>
                <run bold='true' fontcolor='#aa0000' fontsize='10'>Catalog Creation &amp; Master Product Cases Overview</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='10'>Catalog Creation Scorecard</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='8'>#Onboarded Vendors</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows the number of Onboarded Vendors on &apos;Closed Won&apos; opportunity from Shop Setup to Catalog Creation or Master Product Creation type.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='8'>#Catalog Creation Cases</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows the total number of Catalog Creation cases</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='8'>%Closed Successfully</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows the percentage of catalog creation cases which are closed successfully.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='8'>#Agents</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows the total distinct agents involved in the catalog creation cases</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='8'>Cases Per Agent Ratio</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows the ratio of Total cases/distinct agents  involved in the catalog creation cases</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='8'>Average Resolution Time (Days)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows the average resolution time for catalog creation cases</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='8'>Average On Hold Time (Days)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows the average On Hold time for catalog creation cases</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='8'>Average Case Size For Catalog Creation</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows the size of the catalog creation cases by taking the summation of nr_available_products_for_assignment and nr_master_products_requested</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='8'>Average Listed SKUs</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows the average of listed SKUs for Catalog Creation cases and listed skus for master products created when are_missing_products_go_live_critical column is &apos;Yes-Wait for Master Product Creation&apos;.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='8'>% Listed Products Out of Requested</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows the % of listed products out of requested</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>(Summation of assigned products/Total Case size)</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='10'>Catalog Creation Cases Overview</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows the overview of  #successful catalog creation cases and the average resolution time</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='10'>Catalog Creation Cases (Stages in Days)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows the average number of days at each stage for catalog creation cases</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='10'>Catalog Creation Cases Please Correct Errors Reasons Overview</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows different Please correct error reasons and the total number of cases</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='10'>Catalog Creation Cases On-Hold Reasons Overview</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows different On-Hold reasons and the total number of cases</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='10'>Catalog Creation Cases Root Causes Reasons Overview</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows different Root causes reasons and the total number of cases</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='10'>Master Product Creation Scorecard</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='8'>#Master Product Creation Cases</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows the total number of master product Creation cases</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='8'>%Closed Successfully</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows the percentage of master product creation cases which are closed successfully.</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='8'>#Agents</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows the total distinct agents involved in the master product creation cases</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='8'>Cases Per Agent Ratio</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows the ratio of Total cases/distinct agents  involved in the master product  creation cases</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='8'>Average Resolution Time (Days)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows the average resolution time for master product creation cases</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='8'>Average On Hold Time (Days)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows the average On Hold time for master product creation cases</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='8'>Average New Master Product Requested</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows the average number of new master product requested </run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='8'>%Master Products Created</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>i.e. Master Products Created/Master Products Requested</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='10'>Master Product Creation Cases Overview</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows the overview of  #successful master product creation cases and the average resolution time</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='10'>Master Product Creation Cases (Stages in Days)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows the average number of days at each stage for master product creation cases</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='10'>Master Product Creation Cases Please Correct Errors Reasons Overview</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows different Please correct error reasons and the total number of cases</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='10'>Master Product  Cases On-Hold Reasons Overview</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows different On-Hold reasons and the total number of cases</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='10'>Master Product  Cases Root Causes Reasons Overview</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='8'>It shows different Root causes reasons and the total number of cases</run>
                <run>Æ&#10;</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone h='94117' id='168' param='horz' type-v2='layout-flow' w='36034' x='27400' y='5412'>
            <zone forceUpdate='true' h='94117' id='169' type-v2='text' w='36034' x='27400' y='5412'>
              <formatted-text>
                <run bold='true' fontcolor='#aa0000' fontsize='11'>Menu Processing Overview</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='11'>Scorecard</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000'>#Onboarded Vendors</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>It shows the number of Onboarded Vendors on &apos;Closed Won&apos; opportunity from Shop Setup to Catalog Creation or Master Product Creation type.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000'>Average Menu Processing Phase (Days)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>It shows Average time in days to complete Menu Processing Phase</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>(i.e. close successfully Shops Set Up, Catalog Creation and Master Product creation cases)</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000'># Agents</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>It shows the total distinct agents working on Onboarding cases (Overall)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>(i.e.  Shops Set Up, Catalog Creation, Master Prodcut Creation Cases)</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000'>Vendor Per Agent Ratio</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>It shows the Ratio of Onboarded vendors per agent</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>(Onboarded Vendors/Agents)</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000'>%Flawless Onboardings</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>It shows the percentage of flawless onboardings.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Flawless Account = An account having no unsuccessful cases in its journey.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>Not Flawless Account = An account having one or more unsuccessful cases in its journey.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000'>%Vendors Required Master Products</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>It shows the % of Vendors with new Master Product Creation to be created when the catalog requirement is &apos;Initiate Master Product Creation for vendors.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000'>%Go-live Critical Master Product Accounts</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>It shows the % of Vendors when  </run>
                <run bold='true' fontcolor='#000000'>are_missing_products_go_live_critical</run>
                <run fontcolor='#000000'> column is &apos;Yes- Wait for Master Product Creation&apos; for master product creation cases</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000'>Average Listed SKUs</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>It shows the average of listed SKUs for Catalog Creation cases and listed skus for master products created when are_missing_products_go_live_critical column is &apos;Yes-Wait for Master Product Creation&apos;.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000'>Average Master Products Requested</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>It shows the average number of master products requested.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000'>% Master Products Created</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>i.e Master Products Created/Master Products Requested</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000' fontsize='11'>Charts</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000'>Menu Processing Overview</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>It shows the overview of Menu Processing phase (Onboarded Vendors and Average Menu Processing Days).</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true' fontcolor='#aa0000'>Onboarded Vendors Vs Vendor Per Agents Ratio</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000'>It shows the overview of onboarded vendors and vendors per agent ratio for a specific country on monthly and weekly view.</run>
                <run>Æ&#10;&#10;</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
