      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (dev_dmart)' name='federated.0d3dsez09r0q5v1afz7x91sa61cq' />
          </datasources>
          <datasource-dependencies datasource='federated.0d3dsez09r0q5v1afz7x91sa61cq'>
            <column caption='LS_CVR' datatype='real' default-format='p0.0%' name='[Calculation_1288029505961353216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ls_completed_orders])/SUM([ls_sessions])' />
            </column>
            <column caption='HB CVR' datatype='real' default-format='p0.0%' name='[Calculation_1288029505966780418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hb_completed_orders])/SUM([hb_sessions])' />
            </column>
            <column caption='CVR opportunity' datatype='string' name='[Calculation_1288029505967869955]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if ([Calculation_1288029505966780418]&lt;0.1 )&#13;&#10;THEN &quot;Opportunity&quot;&#13;&#10;ELSEIF ISNULL([Calculation_1288029505966780418]) &#13;&#10;THEN &quot;NULL&quot;&#13;&#10;ELSE &quot;Above Target&quot;&#13;&#10;END' />
            </column>
            <column caption='Coverage Opportunity' datatype='string' name='[Calculation_197313991405350913]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ([health_vendors]&lt;[coverage_target])&#13;&#10;THEN &quot;Opportunity&quot;&#13;&#10;ELSEIF ISNULL([health_vendors]) &#13;&#10;THEN &quot;NULL&quot;&#13;&#10;ELSE &quot;Above Target&quot;&#13;&#10;END' />
            </column>
            <column caption='H&amp;B MAU Share' datatype='real' default-format='p0.00%' name='[Calculation_2016768272141369344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hb_mau])/SUM([platform_mau])' />
            </column>
            <column caption='LS MAU Share' datatype='real' default-format='p0.00%' name='[Calculation_2016768272142041089]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ls_mau])/SUM([platform_mau])' />
            </column>
            <column caption='LS Active vendor per platform 1K MAU' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2016768272143458306]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ls_active_vendors])/SUM([platform_mau]))*1000' />
            </column>
            <column caption='LS Online vendor per platform 1K MAU' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2016768272144318467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ls_online_vendors])/SUM([platform_mau]))*1000' />
            </column>
            <column caption='HB Online vendor per platform 1K MAU' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2016768272146370565]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ls_health_online_vendors])/SUM([platform_mau]))*1000' />
            </column>
            <column caption='HB Vendor Reorder Rate 3 Months' datatype='real' default-format='p0.00%' name='[Calculation_2016768272147558406]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hb_vendor_retention_third_month])/SUM([trial_cohort_size_vendor])' />
            </column>
            <column caption='HB Reorder Rate 1 Month' datatype='real' default-format='p0.00%' name='[Calculation_2016768272148537351]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hb_retention_first_month])/SUM([trial_cohort_size])' />
            </column>
            <column caption='HB Reorder Rate 3 Month' datatype='real' default-format='p0.00%' name='[Calculation_2016768272148901896]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hb_retention_third_month])/SUM([trial_cohort_size])' />
            </column>
            <column caption='HB Active vendor per platform 1k MAU' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2016768272361570313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([hb_active_vendors])/SUM([platform_mau]))*1000' />
            </column>
            <column caption='HB Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_2016768272371503114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hb_failed_orders])/SUM([hb_total_orders])' />
            </column>
            <column caption='HB Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_2016768272371884043]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hb_vendor_failed_orders])/SUM([hb_total_orders])' />
            </column>
            <column caption='HB Vendor Fail Rate OOS' datatype='real' default-format='p0.00%' name='[Calculation_2016768272372592652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hb_vendor_failed_due_to_out_of_stock_orders])/SUM([hb_total_orders])' />
            </column>
            <column caption='HB Voucher % of GMV' datatype='real' default-format='p0.00%' name='[Calculation_2016768272374341645]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hb_vouchers])/SUM([hb_gmv])' />
            </column>
            <column caption='HB FDF %' datatype='real' default-format='p0.00%' name='[Calculation_2016768272374747150]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([hb_fdf_orders])/SUM([hb_completed_orders])' />
            </column>
            <column caption='Dmart Active vendor per platform 100k MAU' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2016768272376184847]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([dmarts_active_vendors])/SUM([platform_mau]))*100000' />
