      <datasource-dependencies datasource='federated.0d3dsez09r0q5v1afz7x91sa61cq'>
        <column caption='CVR opportunity' datatype='string' name='[Calculation_1288029505967869955]' role='measure' type='nominal'>
          <calculation class='tableau' formula='if ([Calculation_1288029505966780418]&lt;0.1 )&#13;&#10;THEN &quot;Opportunity&quot;&#13;&#10;ELSEIF ISNULL([Calculation_1288029505966780418]) &#13;&#10;THEN &quot;NULL&quot;&#13;&#10;ELSE &quot;Above Target&quot;&#13;&#10;END' />
        </column>
        <column caption='Coverage Opportunity' datatype='string' name='[Calculation_197313991405350913]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='if ([health_vendors]&lt;[coverage_target])&#13;&#10;THEN &quot;Opportunity&quot;&#13;&#10;ELSEIF ISNULL([health_vendors]) &#13;&#10;THEN &quot;NULL&quot;&#13;&#10;ELSE &quot;Above Target&quot;&#13;&#10;END' />
        </column>
        <column caption='Operation Quality Opportunity' datatype='string' name='[Calculation_2016768274529275927]' role='measure' type='nominal'>
          <calculation class='tableau' formula='if ([Calculation_2016768272371884043]&lt;AVG([HB_Vendor_Fail_Rate__target]) ) &#13;&#10;THEN &quot;Opportunity&quot;&#13;&#10;ELSEIF ISNULL([Calculation_2016768272371884043]) &#13;&#10;THEN &quot;NULL&quot;&#13;&#10;ELSE &quot;Above Target&quot;&#13;&#10;END' />
        </column>
        <column caption='ReOrder Rate Opportunity ' datatype='string' name='[Calculation_2016768274530828312]' role='measure' type='nominal'>
          <calculation class='tableau' formula='if ([Calculation_2016768272147558406]&lt;AVG([HB_Vendor_Reorder_Rate_3_Months__target]) ) &#13;&#10;THEN &quot;Opportunity&quot;&#13;&#10;ELSEIF ISNULL([Calculation_2016768272147558406]) &#13;&#10;THEN &quot;NULL&quot;&#13;&#10;ELSE &quot;Above Target&quot;&#13;&#10;END' />
        </column>
        <column caption='Incentives opportunity' datatype='string' name='[Calculation_2016768274868834331]' role='measure' type='nominal'>
          <calculation class='tableau' formula='if ([Calculation_2016768272374747150]&lt;AVG([HB_FDF____target]) )&#13;&#10;OR ([Calculation_2016768272374341645]&lt;AVG([HB_Voucher___of_GMV__target]) )  &#13;&#10;THEN &quot;Opportunity&quot;&#13;&#10;ELSEIF ISNULL([Calculation_2016768272374747150]) &#13;&#10;AND ISNULL([Calculation_2016768272374341645])&#13;&#10;THEN &quot;NULL&quot;&#13;&#10;ELSE &quot;Above Target&quot;&#13;&#10;END' />
        </column>
        <column caption='MAU Opportunity' datatype='string' name='[Calculation_2016768274869825565]' role='measure' type='nominal'>
