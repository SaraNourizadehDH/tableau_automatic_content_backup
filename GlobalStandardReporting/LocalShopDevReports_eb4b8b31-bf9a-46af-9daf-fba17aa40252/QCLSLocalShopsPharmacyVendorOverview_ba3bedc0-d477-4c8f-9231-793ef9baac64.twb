    <worksheet name='Summary'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#d61f26'>Opportunity City Count Summary</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_qcls_pharmacy_opp_summary (dev_dmart)' name='federated.14fpos00vzk9621f7howk1lc9dly' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Region' caption='Parameter-Summary Granularity' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Segment&quot;'>
              <calculation class='tableau' formula='&quot;Segment&quot;' />
              <aliases>
                <alias key='&quot;Country Name&quot;' value='Country' />
                <alias key='&quot;Segment&quot;' value='Region' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.14fpos00vzk9621f7howk1lc9dly'>
            <column caption='CVR Opportunity %' datatype='real' default-format='p0.0%' name='[Calculation_1288029505965912065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cvr_opportunity_cnt])/SUM([total_cnt])' />
            </column>
            <column caption='Coverage Opportunity %' datatype='real' default-format='p0.0%' name='[Calculation_197313991394099200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([coverage_opportunity_cnt])/SUM([total_cnt])' />
            </column>
            <column caption='Granularity' datatype='string' name='[Calculation_2016768274905362462]' role='dimension' type='nominal'>
