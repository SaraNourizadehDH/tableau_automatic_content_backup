            </column>
            <column caption='Operation Quality Opportunity' datatype='string' name='[Calculation_2016768274529275927]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if ([Calculation_2016768272371884043]&lt;AVG([HB_Vendor_Fail_Rate__target]) ) &#13;&#10;THEN &quot;Opportunity&quot;&#13;&#10;ELSEIF ISNULL([Calculation_2016768272371884043]) &#13;&#10;THEN &quot;NULL&quot;&#13;&#10;ELSE &quot;Above Target&quot;&#13;&#10;END' />
            </column>
            <column caption='ReOrder Rate Opportunity ' datatype='string' name='[Calculation_2016768274530828312]' role='measure' type='nominal'>
