          <calculation class='tableau' formula='if ([health_vendors]&lt;[coverage_target])&#13;&#10;THEN &quot;Opportunity&quot;&#13;&#10;ELSEIF ISNULL([health_vendors]) &#13;&#10;THEN &quot;NULL&quot;&#13;&#10;ELSE &quot;Above Target&quot;&#13;&#10;END' />
        </column>
        <column caption='Operation Quality Opportunity' datatype='string' name='[Calculation_2016768274529275927]' role='measure' type='nominal'>
