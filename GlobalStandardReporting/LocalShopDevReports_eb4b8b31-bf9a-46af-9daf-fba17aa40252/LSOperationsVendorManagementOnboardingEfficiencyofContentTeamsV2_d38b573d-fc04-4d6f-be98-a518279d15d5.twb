      <aliases enabled='yes' />
      <column caption='% Master Product Created' datatype='real' name='[% listed of Requested (copy)_4797248458942914565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[(SKUs) Master Product Requested (copy)_848998955717881873]/[(SKUs) Listed SKUs (copy)_848998955717509135]' />
      </column>
      <column caption='% available of Requested' datatype='real' name='[% listed of Requested (copy)_848998957078065176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_848998955718201362]/[Calculation_848998955608973322]' />
      </column>
      <column caption='(SKUs) Master Product Requested' datatype='real' name='[(SKUs) Listed SKUs (copy)_848998955717509135]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10; {FIXED [account_id]: &#10;  MAX([mpc_requested])&#10; }&#10;)' />
      </column>
      <column caption='(SKUs) Master Product Created' datatype='real' name='[(SKUs) Master Product Requested (copy)_848998955717881873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10; {FIXED [account_id]: &#10;  MAX([mpc_created])&#10; }&#10;)' />
      </column>
      <column caption='(SKUs) Master Product Rejected' datatype='real' name='[(SKUs) Master Product Requested (copy)_848998957071699990]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10; {FIXED [account_id]: &#10;  MAX([mpc_rejected])&#10; }&#10;)' />
      </column>
      <column caption='(SKUs) Vendor Products - Format' datatype='real' name='[(SKUs) Vendor Products (copy)_848998957104693274]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_848998955608973322] &gt;= 1000000000 THEN [Calculation_848998955608973322] / 1000000000&#10;ELSEIF [Calculation_848998955608973322] &gt;= 1000000 THEN [Calculation_848998955608973322] / 1000000&#10;ELSEIF [Calculation_848998955608973322] &gt;= 1000 THEN [Calculation_848998955608973322] / 1000&#10;ELSE [Calculation_848998955608973322]&#10;END' />
      </column>
      <column caption='(SKUs) Available SKUs - Format' datatype='real' name='[(SKUs) Vendor Products - Format (copy) (copy)_848998957108113437]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_848998955718201362] &gt;= 1000000000 THEN [Calculation_848998955718201362] / 1000000000&#10;ELSEIF [Calculation_848998955718201362] &gt;= 1000000 THEN [Calculation_848998955718201362] / 1000000&#10;ELSEIF [Calculation_848998955718201362] &gt;= 1000 THEN [Calculation_848998955718201362] / 1000&#10;ELSE [Calculation_848998955718201362]&#10;END' />
      </column>
      <column caption='(SKUs) Vendor Products - Suffix' datatype='string' name='[(SKUs) Vendor Products - Format (copy)_848998957105037339]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_848998955608973322] &gt;= 1000000000 THEN &quot;B&quot;&#10;ELSEIF [Calculation_848998955608973322] &gt;= 1000000 THEN &quot;M&quot;&#10;ELSEIF [Calculation_848998955608973322] &gt;= 1000 THEN &quot;K&quot;&#10;ELSE &quot;&quot;&#10;END' />
      </column>
      <column caption='(SKUs) Listed SKUs - Format' datatype='real' name='[(SKUs) Vendor Products - Format (copy)_848998957108101148]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Case Size (SKUs) (copy)_848998955676180493] &gt;= 1000000000 THEN [Case Size (SKUs) (copy)_848998955676180493] / 1000000000&#10;ELSEIF [Case Size (SKUs) (copy)_848998955676180493] &gt;= 1000000 THEN [Case Size (SKUs) (copy)_848998955676180493] / 1000000&#10;ELSEIF [Case Size (SKUs) (copy)_848998955676180493] &gt;= 1000 THEN [Case Size (SKUs) (copy)_848998955676180493] / 1000&#10;ELSE [Case Size (SKUs) (copy)_848998955676180493]&#10;END' />
      </column>
      <column caption='(SKUs) Available SKUs - Suffix' datatype='string' name='[(SKUs) Vendor Products - Suffix (copy) (copy)_848998957108133919]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_848998955718201362] &gt;= 1000000000 THEN &quot;B&quot;&#10;ELSEIF [Calculation_848998955718201362] &gt;= 1000000 THEN &quot;M&quot;&#10;ELSEIF [Calculation_848998955718201362] &gt;= 1000 THEN &quot;K&quot;&#10;ELSE &quot;&quot;&#10;END' />
      </column>
      <column caption='(SKUs) Listed SKUs - Suffix' datatype='string' name='[(SKUs) Vendor Products - Suffix (copy)_848998957108125726]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Case Size (SKUs) (copy)_848998955676180493] &gt;= 1000000000 THEN &quot;B&quot;&#10;ELSEIF [Case Size (SKUs) (copy)_848998955676180493] &gt;= 1000000 THEN &quot;M&quot;&#10;ELSEIF [Case Size (SKUs) (copy)_848998955676180493] &gt;= 1000 THEN &quot;K&quot;&#10;ELSE &quot;&quot;&#10;END' />
      </column>
      <column caption='Agent Count per Status' datatype='integer' name='[Agent Count (copy)_848998955644170251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([case_status_owner])' />
      </column>
      <column caption='Agent Count per Status - Master Product Only' datatype='integer' name='[Agent Count per Status (copy 2)_4797248458956992519]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( &#10;CASE [case_type] &#10;WHEN &apos;Master Product Creation&apos; THEN [case_status_owner]&#10;ELSE NULL&#10;END&#10;)' />
      </column>
      <column caption='COUNTRY - Deep Dive' datatype='string' name='[COUNTRY (copy)_4797248458570170371]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='tableau' formula='[country]' />
      </column>
      <column caption='Res. Filter Calculation' datatype='boolean' name='[Calculation_104849493578358788]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [case_type] = &quot;Catalog Change&quot; THEN FALSE END' />
      </column>
      <column caption='Inbound Source' datatype='string' name='[Calculation_104849493741494277]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER([updated_origin])' />
      </column>
      <column caption='Date Range' datatype='date' name='[Calculation_1345520811867156480]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([closeddate])' />
      </column>
      <column caption='Agent Count' datatype='integer' name='[Calculation_1345520811875160065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([agent_id])' />
      </column>
      <column caption='Accounts Count' datatype='integer' name='[Calculation_1345520811875565570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([account_id])' />
      </column>
      <column caption='Case per Agent' datatype='real' name='[Calculation_1345520811876814851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6488701954770616320]/[Agent Count (copy)_848998955644170251]' />
      </column>
      <column caption='Successful Cases' datatype='integer' name='[Calculation_1345520811879030788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_case_successful] THEN [case_id] END)' />
      </column>
      <column caption='Successful Cases (%)' datatype='real' name='[Calculation_1345520811879690245]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1345520811879030788]/[Calculation_6488701954770616320]' />
      </column>
      <column caption='Case Resolution time (days)' datatype='real' name='[Calculation_1345520811883655174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(([status_age_hrs])/24)/[Calculation_6488701954770616320]' />
      </column>
      <column caption='On Hold %' datatype='real' name='[Calculation_1345520812172894217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Case Count (copy)_1345520812168544264]/[Calculation_6488701954770616320]' />
      </column>
      <column caption='Closed Date Parameter' datatype='date' name='[Calculation_1345520812179525642]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;    WHEN &apos;month&apos; THEN [closed_date_m]&#10;    WHEN &apos;week&apos; THEN [closed_date_w]&#10;END' />
      </column>
      <column caption='Cases per Res. Time Granularity' datatype='string' name='[Calculation_1345520812189917196]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10; WHEN &apos;date&apos; THEN &#10;       str(DATEPART(&apos;day&apos;,[Calculation_1345520812179525642])) + &quot; &quot; + &#10;       str(DATENAME(&apos;month&apos;,[Calculation_1345520812179525642])) + &quot;, &quot; +      &#10;       str(DATEPART(&apos;year&apos;,[Calculation_1345520812179525642]))&#10; WHEN &apos;case type&apos; THEN [case_type]&#10;END' />
      </column>
      <column caption='Case Type (CAPS)' datatype='string' name='[Calculation_1345520812389130261]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER([case_type])' />
      </column>
      <column caption='Cases Received' datatype='integer' name='[Calculation_6488701954770616320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([case_id])' />
      </column>
      <column caption='SKU Calculation Check - 1' datatype='integer' name='[Calculation_721913005810827264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF // The final SKUs in catalog is more than the Vendor Request&#10;[Case Size (SKUs) (copy)_848998955676180493] &gt; [Calculation_848998955608973322]&#10;&#10;OR(// Master products were requested though all the vendor requests were available in PIM&#10;[Calculation_848998955718201362] = [Calculation_848998955608973322] AND [(SKUs) Listed SKUs (copy)_848998955717509135] &gt; 0)&#10;&#10;OR(// Master Product Requested and Created not adding up&#10;[(SKUs) Listed SKUs (copy)_848998955717509135] &lt;&gt; [(SKUs) Master Product Requested (copy)_848998955717881873]+[(SKUs) Master Product Requested (copy)_848998957071699990])&#10;&#10;OR(// No SKUs were available via PIM and No Master Products were requested&#10;[Calculation_848998955718201362] = 0 AND [(SKUs) Listed SKUs (copy)_848998955717509135] = 0 )&#10;&#10;OR(// Suspected duplicate&#10;[Calculation_848998955718201362] = [(SKUs) Listed SKUs (copy)_848998955717509135] AND [Calculation_848998955718201362] &gt; 0 )&#10;&#10;THEN 1 ELSE 0 END' />
      </column>
      <column caption='Placeholder - Vendor Products' datatype='integer' name='[Calculation_721913005876453381]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(0)' />
      </column>
      <column caption='Seamlessly Onboarded Accounts' datatype='integer' name='[Calculation_848998955096240128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10; {FIXED [account_id]: &#10;   IF [Calculation_6488701954770616320] = [Calculation_1345520811879030788] AND [Calculation_848998955103809538] = 0&#10;   THEN [Calculation_1345520811875565570] ELSE 0 END&#10; }&#10;)' />
      </column>
      <column caption='Seamless Onboarding Check' datatype='integer' name='[Calculation_848998955103809538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;   CASE [status]&#10;     WHEN &apos;On Hold&apos; THEN 1&#10;     WHEN &apos;Please Correct Errors&apos; THEN 1&#10;     WHEN &apos;Quality Gate Issue&apos; THEN 1&#10;     WHEN &apos;Master Product Issue&apos; THEN 1&#10;     ELSE 0&#10;   END&#10;)' />
      </column>
      <column caption='(SKUs) Vendor Products' datatype='real' name='[Calculation_848998955608973322]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;{FIXED [account_id]: &#10;   MAX([vendor_products])&#10; }&#10;)' />
      </column>
      <column caption='(SKUs) Available SKUs' datatype='real' name='[Calculation_848998955718201362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10; {FIXED [account_id]: &#10; MAX([available_products])&#10; }&#10;)' />
      </column>
      <column caption='% listed of Requested' datatype='real' name='[Calculation_848998957077946391]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Case Size (SKUs) (copy)_848998955676180493]/[Calculation_848998955608973322]' />
      </column>
      <column caption='On Hold Case Count ' datatype='integer' name='[Case Count (copy)_1345520812168544264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;CASE [status]&#10;WHEN &apos;On Hold&apos; THEN [case_id]&#10;ELSE NULL &#10;END&#10;)' />
      </column>
      <column caption='Case Resolution time (days per 100 SKUs) ' datatype='real' name='[Case Resolution time (days) (copy 2)_848998955719753747]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;CASE [case_type]&#10;WHEN &apos;Master Product Creation&apos; THEN [status_age_hrs]&#10;ELSE NULL&#10;END&#10;)&#10;/[(SKUs) Master Product Requested (copy)_848998955717881873]/24' />
      </column>
      <column caption='Status Resolution time (days) ' datatype='real' name='[Case Resolution time (days) (copy)_1345520812595216406]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([status_age_hrs])/[Calculation_6488701954770616320]/24' />
      </column>
