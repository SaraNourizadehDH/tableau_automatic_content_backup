      <size maxheight='2300' maxwidth='1400' minheight='2300' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource caption='_qcls_content_teams_efficiency (dev_dmart)' name='federated.096etha1gsodhb14wricf0yc1xnw' />
      </datasources>
      <datasource-dependencies datasource='federated.096etha1gsodhb14wricf0yc1xnw'>
        <column caption='COUNTRY - Deep Dive' datatype='string' name='[COUNTRY (copy)_4797248458570170371]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
          <calculation class='tableau' formula='[country]' />
        </column>
        <column caption='Date Range' datatype='date' name='[Calculation_1345520811867156480]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='DATE([closeddate])' />
        </column>
        <column caption='SANITY CHECK' datatype='string' name='[SKU Calculation Check - 1 (copy)_721913005875388420]' role='measure' type='nominal'>
          <calculation class='tableau' formula='IF // The final SKUs in catalog is more than the Vendor Request&#10;[Case Size (SKUs) (copy)_848998955676180493] &gt; [Calculation_848998955608973322]&#10;THEN &quot;Listed SKUs too High&quot;&#10;&#10;ELSEIF (// Not all PIM SKUs were listed&#10;[Case Size (SKUs) (copy)_848998955676180493] &lt; [Calculation_848998955718201362] &#10;  OR [(SKUs) Master Product Requested (copy)_848998955717881873] &gt; [Case Size (SKUs) (copy)_848998955676180493] )&#10;  &#10;THEN &quot;Listed SKUs too Low&quot;&#10;&#10;ELSEIF (// Master products were requested though all the vendor requests were available in PIM&#10;[Calculation_848998955718201362] = [Calculation_848998955608973322] AND [(SKUs) Listed SKUs (copy)_848998955717509135] &gt; 0)&#10;THEN &quot;Master Products Request Error&quot;&#10;&#10;ELSEIF (// Master products were requested though all the vendor requests were available in PIM&#10;[Calculation_848998955718201362] + [(SKUs) Master Product Requested (copy)_848998955717881873] &lt; [Case Size (SKUs) (copy)_848998955676180493])&#10;THEN &quot;Rejection Ignored&quot;&#10;&#10;ELSEIF(// Master Product Requested and Created not adding up&#10;[(SKUs) Listed SKUs (copy)_848998955717509135] &lt;&gt; [(SKUs) Master Product Requested (copy)_848998955717881873]+[(SKUs) Master Product Requested (copy)_848998957071699990])&#10;THEN &quot;Master Products Mismatch&quot;&#10;&#10;ELSEIF(// Cases where the Master Product requests seem unnecessary&#10;[Calculation_848998955718201362] = [(SKUs) Listed SKUs (copy)_848998955717509135] AND [Calculation_848998955718201362] &gt; 0&#10;OR [(SKUs) Master Product Requested (copy)_848998955717881873] + [Calculation_848998955718201362] &gt; [Case Size (SKUs) (copy)_848998955676180493] )&#10;THEN &quot;Suspected Duplicate&quot;&#10;&#10;ELSEIF(// No SKUs were available via PIM and No Master Products were requested&#10;[Calculation_848998955718201362] = 0 AND [(SKUs) Listed SKUs (copy)_848998955717509135] = 0 )&#10;THEN &quot;Empty Account&quot; &#10;&#10;ELSE &quot;Good&quot; END' />
        </column>
        <column caption='GRID ID' datatype='string' name='[grid_id]' role='dimension' type='nominal' />
        <column caption='Is Case Successful' datatype='boolean' name='[is_case_successful]' role='dimension' type='nominal' />
        <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
        <column-instance column='[COUNTRY (copy)_4797248458570170371]' derivation='None' name='[none:COUNTRY (copy)_4797248458570170371:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_1345520811867156480]' derivation='None' name='[none:Calculation_1345520811867156480:qk]' pivot='key' type='quantitative' />
        <column-instance column='[grid_id]' derivation='None' name='[none:grid_id:nk]' pivot='key' type='nominal' />
        <column-instance column='[is_case_successful]' derivation='None' name='[none:is_case_successful:nk]' pivot='key' type='nominal' />
        <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
        <column-instance column='[SKU Calculation Check - 1 (copy)_721913005875388420]' derivation='User' name='[usr:SKU Calculation Check - 1 (copy)_721913005875388420:nk]' pivot='key' type='nominal' />
      </datasource-dependencies>
