              <calculation class='tableau' formula='COUNTD([case_status_owner])' />
            </column>
            <column caption='Inbound Source' datatype='string' name='[Calculation_104849493741494277]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='UPPER([updated_origin])' />
