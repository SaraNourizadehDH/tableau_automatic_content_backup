            <column caption='Seamless Onboarding Check' datatype='integer' name='[Calculation_848998955103809538]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;   CASE [status]&#10;     WHEN &apos;On Hold&apos; THEN 1&#10;     WHEN &apos;Please Correct Errors&apos; THEN 1&#10;     WHEN &apos;Quality Gate Issue&apos; THEN 1&#10;     WHEN &apos;Master Product Issue&apos; THEN 1&#10;     ELSE 0&#10;   END&#10;)' />
            </column>
