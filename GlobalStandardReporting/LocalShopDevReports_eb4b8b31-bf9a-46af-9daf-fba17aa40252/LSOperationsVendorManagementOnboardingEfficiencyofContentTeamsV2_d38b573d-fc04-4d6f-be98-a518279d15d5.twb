    <worksheet name='Case Resolution Time'>
      <table>
        <view>
          <datasources>
            <datasource caption='_qcls_content_teams_efficiency (dev_dmart)' name='federated.096etha1gsodhb14wricf0yc1xnw' />
          </datasources>
          <datasource-dependencies datasource='federated.096etha1gsodhb14wricf0yc1xnw'>
            <column caption='Inbound Source' datatype='string' name='[Calculation_104849493741494277]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='UPPER([updated_origin])' />
            </column>
            <column caption='Date Range' datatype='date' name='[Calculation_1345520811867156480]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([closeddate])' />
            </column>
            <column caption='Successful Cases' datatype='integer' name='[Calculation_1345520811879030788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_case_successful] THEN [case_id] END)' />
            </column>
            <column caption='Case Resolution time (days)' datatype='real' name='[Calculation_1345520811883655174]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(([status_age_hrs])/24)/[Calculation_6488701954770616320]' />
