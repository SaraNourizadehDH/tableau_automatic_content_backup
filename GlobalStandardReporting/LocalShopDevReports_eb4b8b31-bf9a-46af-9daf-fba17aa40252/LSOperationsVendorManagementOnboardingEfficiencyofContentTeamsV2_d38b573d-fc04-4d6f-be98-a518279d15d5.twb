    <worksheet name='CHART: Volume of Work - Case Type (Case Count)'>
      <table>
        <view>
          <datasources>
            <datasource caption='_qcls_content_teams_efficiency (dev_dmart)' name='federated.096etha1gsodhb14wricf0yc1xnw' />
          </datasources>
          <datasource-dependencies datasource='federated.096etha1gsodhb14wricf0yc1xnw'>
            <column caption='Agent Count per Status' datatype='integer' name='[Agent Count (copy)_848998955644170251]' role='measure' type='quantitative'>
