    <worksheet name='Comparision_New'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#d3293d' fontsize='14'><![CDATA[<[Parameters].[Parameter 2]> Level Performance]]></run>
            <run fontalignment='1'>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query- Vendor Level' name='federated.0d3dsez09r0q5v1afz7x91sa61cq (copy 2)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Parameter Dimension' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country&quot;'>
              <calculation class='tableau' formula='&quot;Country&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0d3dsez09r0q5v1afz7x91sa61cq (copy 2)'>
            <column caption='Inactive Vendor % - All Time' datatype='real' default-format='p0.0%' name='[Calculation_664280987660955649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-([Calculation_664280987664453635]/ [Calculation_664280987664351234])' />
            </column>
            <column caption='New Online Vendors' datatype='integer' name='[Calculation_664280987664351234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_code]+[global_entity_id])' />
            </column>
            <column caption='Active Vendor Count' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_664280987664453635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( CASE [inactive_till_date] WHEN 0 THEN [vendor_code]+[global_entity_id] END)' />
            </column>
            <column caption='Vendor Fail Rate- All time' datatype='real' default-format='p0.0%' name='[Calculation_664280987665313796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nr_failed_vendor_opd_till_date])/SUM([nr_opd_till_date])' />
            </column>
            <column caption='Granularity' datatype='string' name='[Calculation_664280987688251397]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Management Entity&quot; THEN [management_entity]&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;Country&quot; THEN [country]&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;Shop Type&quot; THEN [shop_type]&#13;&#10;END' />
            </column>
            <column caption='ABV- All Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_664280987689799686]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_gmv_eur_till_date])/SUM([nr_completed_opd_till_date])' />
            </column>
            <column caption='ABS- All Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_664280987690401799]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_quantity_till_date])/SUM([nr_completed_opd_till_date])' />
            </column>
            <column caption='Inactive Vendor % - 30 Day' datatype='real' default-format='p0.0%' name='[Calculation_664280987692285960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNTD( CASE [nr_completed_opd_30_day]  WHEN 0 THEN [vendor_code]+[global_entity_id] END))/(COUNTD([vendor_code]+[global_entity_id]))' />
            </column>
            <column caption='Inactive Vendor %- 60 Day' datatype='real' default-format='p0.0%' name='[Calculation_664280987692650505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(COUNTD( CASE [inactive_0_60_day] WHEN 0 THEN [vendor_code] END)/[Calculation_664280987664351234])' />
            </column>
            <column caption='Vendor Fail Rate %- 30 Day' datatype='real' default-format='p0.0%' name='[Calculation_862439329752391687]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([nr_failed_vendor_opd_30_day (Custom SQL Query)])/SUM([nr_opd_30_day (Custom SQL Query)]))' />
            </column>
            <column caption='Completed Orders- 30 Day' datatype='integer' name='[Calculation_862439329752674312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nr_completed_opd_30_day])' />
            </column>
            <column caption='GMV- 30 Day' datatype='integer' name='[Calculation_862439329752752137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_gmv_eur_30_day (Custom SQL Query)])' />
            </column>
            <column caption='ABS- 30 Day' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_862439329752993802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_quantity_30_day (Custom SQL Query)])/SUM([nr_completed_opd_30_day])' />
            </column>
            <column caption='ABV- 30 Day' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_862439329753063435]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_gmv_eur_30_day (Custom SQL Query)])/SUM([nr_completed_opd_30_day])' />
            </column>
            <column caption='Completed Orders- 60 Day' datatype='integer' name='[Calculation_862439329753153548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nr_completed_opd_0_60_day])' />
            </column>
            <column caption='GMV- 60 Day' datatype='integer' name='[Calculation_862439329753255949]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_gmv_eur_30_day (Custom SQL Query)])+SUM([total_gmv_eur_30_60_day (Custom SQL Query)])' />
            </column>
            <column caption='Vendor Fail Rate %- 60 Day' datatype='real' default-format='p0.0%' name='[Calculation_862439329753366542]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([nr_failed_vendor_opd_30_day (Custom SQL Query)])+SUM([nr_failed_vendor_opd_30_60_day (Custom SQL Query)]))/(SUM([nr_opd_30_day (Custom SQL Query)])+SUM([nr_opd_30_60_day (Custom SQL Query)])))' />
            </column>
            <column caption='ABS- 60 Day' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_862439329753591823]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_quantity_30_day (Custom SQL Query)])+SUM([total_quantity_30_60_day (Custom SQL Query)]))/SUM([nr_completed_opd_0_60_day])' />
            </column>
            <column caption='ABV- 60 Day' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_862439329753640976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_gmv_eur_30_day (Custom SQL Query)])+SUM([total_gmv_eur_30_60_day (Custom SQL Query)]))/SUM([nr_completed_opd_0_60_day])' />
            </column>
            <column caption='Account Type' datatype='string' name='[account_type (Custom SQL Query)]' role='dimension' type='nominal' />
            <column caption='Acquisition Source' datatype='string' name='[acquisition_source (Custom SQL Query)]' role='dimension' type='nominal' />
            <column caption='Activation Week' datatype='date' name='[activation_week (Custom SQL Query)]' role='dimension' type='ordinal' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Inactive 60 Day' datatype='integer' default-format='n#,##0;-#,##0' name='[inactive_0_60_day]' role='dimension' type='ordinal'>
              <aliases>
                <alias key='0' value='ACTIVE' />
