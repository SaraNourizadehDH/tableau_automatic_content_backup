    <worksheet name='Chain_Metrics'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='12'>Chain Level Performance</run>
            <run fontalignment='1'>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query- Vendor Level' name='federated.0d3dsez09r0q5v1afz7x91sa61cq (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.0d3dsez09r0q5v1afz7x91sa61cq (copy 2)'>
            <column caption='New Vendors' datatype='integer' name='[Calculation_1388797596494045184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_code])' />
            </column>
            <column caption='Inactive Vendor Count- All Time' datatype='integer' name='[Calculation_1388797596500381697]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD( CASE [inactive_till_date] WHEN 1 THEN [vendor_code] END)' />
            </column>
            <column caption='Zombie (Last 30 days) %' datatype='real' default-format='p0.0%' name='[Calculation_1685190749785415683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNTD( CASE [zombie_flag]  WHEN 1 THEN [vendor_code]+[global_entity_id] END))/(COUNTD([vendor_code]+[global_entity_id]))' />
            </column>
            <column caption='Average Vendor Per Chain' datatype='real' name='[Calculation_1685190751516741639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([chain_vendor_count])' />
            </column>
            <column caption='Inactive Vendor % - All Time' datatype='real' default-format='p0.0%' name='[Calculation_664280987660955649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-([Calculation_664280987664453635]/ [Calculation_664280987664351234])' />
            </column>
            <column caption='New Online Vendors' datatype='integer' name='[Calculation_664280987664351234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_code]+[global_entity_id])' />
            </column>
            <column caption='Active Vendor Count' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_664280987664453635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( CASE [inactive_till_date] WHEN 0 THEN [vendor_code]+[global_entity_id] END)' />
            </column>
            <column caption='Inactive Vendor % - 30 Day' datatype='real' default-format='p0.0%' name='[Calculation_664280987692285960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNTD( CASE [nr_completed_opd_30_day]  WHEN 0 THEN [vendor_code]+[global_entity_id] END))/(COUNTD([vendor_code]+[global_entity_id]))' />
            </column>
            <column caption='Inactive Vendor %- 60 Day' datatype='real' default-format='p0.0%' name='[Calculation_664280987692650505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(COUNTD( CASE [inactive_0_60_day] WHEN 0 THEN [vendor_code] END)/[Calculation_664280987664351234])' />
            </column>
            <column caption='ABS 60 Day' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[abs_0_60_day]' role='measure' type='quantitative' />
            <column caption='ABS 30 Day' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[abs_30_day]' role='measure' type='quantitative' />
            <column caption='ABV 60 Day' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[abv_0_60_day]' role='measure' type='quantitative' />
            <column caption='ABV 30 Day' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[abv_30_day]' role='measure' type='quantitative' />
            <column caption='Account Type' datatype='string' name='[account_type (Custom SQL Query)]' role='dimension' type='nominal' />
            <column caption='Acquisition Source' datatype='string' name='[acquisition_source (Custom SQL Query)]' role='dimension' type='nominal' />
            <column caption='Activation Week' datatype='date' name='[activation_week (Custom SQL Query)]' role='dimension' type='ordinal' />
            <column-instance column='[abs_0_60_day]' derivation='Avg' name='[avg:abs_0_60_day:qk]' pivot='key' type='quantitative' />
            <column-instance column='[abs_30_day]' derivation='Avg' name='[avg:abs_30_day:qk]' pivot='key' type='quantitative' />
            <column-instance column='[abv_0_60_day]' derivation='Avg' name='[avg:abv_0_60_day:qk]' pivot='key' type='quantitative' />
