      <column caption='New Vendors' datatype='integer' name='[Calculation_1388797596494045184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([vendor_code])' />
      </column>
      <column caption='Inactive Vendor Count- All Time' datatype='integer' name='[Calculation_1388797596500381697]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD( CASE [inactive_till_date] WHEN 1 THEN [vendor_code] END)' />
      </column>
      <column caption='Inactive Vendor %' datatype='real' default-format='p0.0%' name='[Calculation_1388797596500807682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1388797596500381697]/[Calculation_1388797596494045184]' />
      </column>
      <column caption='Online After QA Gates' datatype='integer' name='[Calculation_1388797596832968708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( CASE [qa_gate_issue] WHEN 1 THEN [vendor_code] END)' />
      </column>
      <column caption='Online under SKU Threshold' datatype='integer' name='[Calculation_1388797596833320965]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( CASE [online_under_threshold] WHEN 1 THEN [vendor_code] END)' />
      </column>
      <column caption='Seamless Onboarding' datatype='integer' name='[Calculation_1388797596833693702]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( CASE [qa_gate_issue] WHEN 0 THEN [vendor_code] END)' />
      </column>
      <column caption='Seamless Onboarding  Inactive Count' datatype='integer' name='[Calculation_1388797596835000329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [qa_gate_issue]&lt;&gt;1 AND [inactive_till_date]=1 THEN [vendor_code] END)' />
      </column>
      <column caption='Seamless Onboarding Inactive %' datatype='real' default-format='p0.0%' name='[Calculation_1388797596835958794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1388797596835000329]/[Calculation_1388797596833693702]' />
      </column>
      <column caption='Online After QA Gate Inactive Count' datatype='integer' name='[Calculation_1388797596836282379]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [qa_gate_issue]=1 AND [inactive_till_date]=1 THEN [vendor_code] END)' />
      </column>
      <column caption='Online After QA Gate Inactive %' datatype='real' default-format='p0.0%' name='[Calculation_1388797596836397068]' role='measure' type='quantitative'>
