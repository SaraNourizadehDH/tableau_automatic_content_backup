      <column caption='Metric' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_664280989030600714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&quot;Active Vendor Count&quot; THEN [Calculation_664280987664453635]&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;New Online Vendors&quot; THEN [Calculation_664280987664351234]&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;Inactive Vendor %- 30 Day&quot; THEN (COUNTD( CASE [nr_completed_opd_30_day]  WHEN 0 THEN [vendor_code]+[global_entity_id] END))/(COUNTD([vendor_code]+[global_entity_id]))*100&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;Completed Orders- 30 Day&quot; THEN SUM([nr_completed_opd_30_day])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;GMV- 30 Day&quot; THEN SUM([total_gmv_eur_30_day (Custom SQL Query)])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;Vendor Fail Rate %- 30 Day&quot; THEN (SUM([nr_failed_vendor_opd_30_day (Custom SQL Query)])/SUM([nr_opd_30_day (Custom SQL Query)]))*100&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;ABS- 30 Day&quot; THEN SUM([total_quantity_30_day (Custom SQL Query)])/SUM([nr_completed_opd_30_day])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;ABV- 30 Day&quot; THEN SUM([total_gmv_eur_30_day (Custom SQL Query)])/SUM([nr_completed_opd_30_day])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;Inactive Vendor %- 60 Day&quot; THEN (COUNTD( CASE [nr_completed_opd_0_60_day]  WHEN 0 THEN [vendor_code]+[global_entity_id] END))/(COUNTD([vendor_code]+[global_entity_id]))*100&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;Completed Orders- 60 Day&quot; THEN SUM([nr_completed_opd_0_60_day])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;GMV- 60 Day&quot; THEN SUM([total_gmv_eur_30_day (Custom SQL Query)])+SUM([total_gmv_eur_30_60_day (Custom SQL Query)])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;Vendor Fail Rate %- 60 Day&quot; THEN ((SUM([nr_failed_vendor_opd_30_day (Custom SQL Query)])+SUM([nr_failed_vendor_opd_30_60_day (Custom SQL Query)]))/(SUM([nr_opd_30_day (Custom SQL Query)])+SUM([nr_opd_30_60_day (Custom SQL Query)])))*100&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;ABS- 60 Day&quot; THEN (SUM([total_quantity_30_day (Custom SQL Query)])+SUM([total_quantity_30_60_day (Custom SQL Query)]))/SUM([nr_completed_opd_0_60_day])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;ABV- 60 Day&quot; THEN (SUM([total_gmv_eur_30_day (Custom SQL Query)])+SUM([total_gmv_eur_30_60_day (Custom SQL Query)]))/SUM([nr_completed_opd_0_60_day])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;Inactive Vendor %- All Time&quot; THEN (1 - ([Calculation_664280987664453635])/[Calculation_664280987664351234])*100&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;Completed Orders- All Time&quot; THEN SUM([nr_completed_opd_till_date])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;GMV- All Time&quot; THEN SUM([total_gmv_eur_till_date])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;Vendor Fail Rate %- All Time&quot; THEN (SUM([nr_failed_vendor_opd_till_date])/SUM([nr_opd_till_date]))*100&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;ABS- All Time&quot; THEN SUM([total_quantity_till_date])/SUM([nr_completed_opd_till_date])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;ABV- All Time&quot; THEN SUM([total_gmv_eur_till_date])/SUM([nr_completed_opd_till_date])&#13;&#10;END' />
      </column>
