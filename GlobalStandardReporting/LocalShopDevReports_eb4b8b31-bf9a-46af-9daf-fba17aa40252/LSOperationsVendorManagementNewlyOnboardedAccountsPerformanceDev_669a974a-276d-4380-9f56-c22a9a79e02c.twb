    <worksheet name='Vendor Level View'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#d3293d' fontsize='14'>Vendor Level Performance</run>
            <run fontalignment='1'>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query- Vendor Level' name='federated.0d3dsez09r0q5v1afz7x91sa61cq (copy 2)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Month' caption='Parameter- Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;week&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0d3dsez09r0q5v1afz7x91sa61cq (copy 2)'>
            <column caption='Offline Rate- All Time' datatype='real' default-format='p0.0%' name='[Calculation_1685190749792296964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(SUM([nr_online_days_till_date])/SUM([nr_total_days]))' />
            </column>
            <column caption='Offline Rate - 30 Day' datatype='real' default-format='p0.0%' name='[Calculation_1685190749799337989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(SUM([nr_online_days_30_day])/31)' />
            </column>
            <column caption='Offline Rate- 60 Day' datatype='real' default-format='p0.0%' name='[Calculation_1685190750405853190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(SUM([nr_online_days_30_60_day]+[nr_online_days_30_60_day])/62)' />
            </column>
            <column caption='ABS 60 Day' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[abs_0_60_day]' role='measure' type='quantitative' />
            <column caption='ABS 30 Day' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[abs_30_day]' role='measure' type='quantitative' />
            <column caption='ABV 60 Day' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[abv_0_60_day]' role='measure' type='quantitative' />
            <column caption='ABV 30 Day' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[abv_30_day]' role='measure' type='quantitative' />
            <column caption='Account Type' datatype='string' name='[account_type (Custom SQL Query)]' role='dimension' type='nominal' />
            <column caption='Acquisition Source' datatype='string' name='[acquisition_source (Custom SQL Query)]' role='dimension' type='nominal' />
            <column caption='Activation Week' datatype='date' name='[activation_week (Custom SQL Query)]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='real' name='[assigned_sku_threshold__c]' role='dimension' type='ordinal' />
