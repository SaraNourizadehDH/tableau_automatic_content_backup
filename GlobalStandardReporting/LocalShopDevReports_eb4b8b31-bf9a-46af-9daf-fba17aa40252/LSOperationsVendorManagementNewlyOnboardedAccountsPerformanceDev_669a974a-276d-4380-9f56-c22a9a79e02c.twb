    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='KPI Glossary'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#e15759'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='http://ip-172-31-0-74:8901/t/GlobalStandardReporting/workbooks/LS-Operations-VendorManagement-NewlyOnboardedAccounts-PerformanceDev/KPIGlossary?rev=' id='KPIGlossary' path='/t/GlobalStandardReporting/workbooks/LS-Operations-VendorManagement-NewlyOnboardedAccounts-PerformanceDev' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1654' maxwidth='1169' minheight='1654' minwidth='1169' preset-index='13' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='16' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='99032' id='19' param='vert' type-v2='layout-flow' w='98632' x='684' y='484'>
            <zone h='2540' id='20' type-v2='title' w='98632' x='684' y='484'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone forceUpdate='true' h='58283' id='343' type-v2='text' w='98632' x='684' y='3024'>
              <formatted-text>
                <run fontcolor='#000000' fontname='Arial' fontsize='14'>KPI Formula</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#d61f26' fontname='Arial' fontsize='11' underline='true'>Sheet : High Level Performance</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>Average Order 30 days = </run>
                <run fontcolor='#000000' fontname='Arial'>Total number of orders by vendors in a cohort in 30 days of going online/Total Vendor Count of the cohort</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>Average Vendor Fail Rate 30 days  = </run>
                <run fontcolor='#000000' fontname='Arial'>Number of Vendor Failed orders by vendors in a cohort in 30 days of going online / Total number of orders by vendors in a cohort in 30 days of going online</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>Average Order 30 to 60 days  = </run>
                <run fontcolor='#000000' fontname='Arial'>Total number of orders by vendors in a cohort in 30 to 60 days of going online/Total Vendor Count of the cohort</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>Average Vendor Fail Rate 30 to 60 days   = </run>
                <run fontcolor='#000000' fontname='Arial'>Number of Vendor Failed orders by vendors in a cohort in 30 to 60 days of going online / Total number of orders by vendors in a cohort in 30 to 60 days of going online</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>InactiveVendor % 60 days  = </run>
                <run fontcolor='#000000' fontname='Arial'>Count of all vendors of the cohort with zero completed orders in 60 days from going online/Count of all vendors of the cohort</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>InactiveVendor % 30 day = </run>
                <run fontcolor='#000000' fontname='Arial'>Count of all vendors of the which have zero completed orders from date of activation till 30 days</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>New Online Vendors = </run>
                <run fontcolor='#000000' fontname='Arial'>The count of total vendor went online for the first time in that week.  </run>
                <run>Æ&#10;&#10;&#10;</run>
                <run fontcolor='#d61f26' fontname='Arial' fontsize='11' underline='true'>Sheet : Cohort Performance Development</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>New Online Vendors = </run>
                <run fontcolor='#000000' fontname='Arial'>Total Number vendors that went online in the activation period selected</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>Active Vendor Count = </run>
                <run fontcolor='#000000' fontname='Arial' italic='true'>Count of </run>
                <run fontcolor='#000000' fontname='Arial'>Vendor with atleast one order in week/month 30 days prior to activation date</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>InactiveVendor % = </run>
                <run fontcolor='#000000' fontname='Arial'>Count of all vendors of the cohort which have 0 orders week/month 30 days prior to corresponding transaction date for each cohort</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>Completed Orders  = </run>
                <run fontcolor='#000000' fontname='Arial'>Total number of orders by vendors in a cohort in 30 to 60 days of going online/Total Vendor Count of the cohort</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>Vendor Fail Rate  = </run>
                <run fontcolor='#000000' fontname='Arial'>Number of Vendor Failed orders/Total Orders by vendors in a cohort in the transaction period</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>GMV  = </run>
                <run fontcolor='#000000' fontname='Arial'>Total GMV in euro generated </run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>ABV  = </run>
                <run fontcolor='#000000' fontname='Arial' italic='true'>(Average Basket Value).</run>
                <run fontcolor='#000000' fontname='Arial'>Total GMV/Successful Orders </run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>ABS = </run>
                <run fontcolor='#000000' fontname='Arial' italic='true'>(Average Basket Size).</run>
                <run fontcolor='#000000' fontname='Arial'>Total Delivered Quantity/Successful Orders</run>
                <run>Æ&#10;&#10;&#10;</run>
                <run fontcolor='#d61f26' fontname='Arial' fontsize='11' underline='true'>Sheet : Performance Comparision</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>New Online Vendors = </run>
                <run fontcolor='#000000' fontname='Arial'>Total Number vendors that went online in the activation period selected</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>Active Vendor Count = </run>
                <run fontcolor='#000000' fontname='Arial' italic='true'>Count of </run>
                <run fontcolor='#000000' fontname='Arial'>Vendor with atleast one order in week/month 30 days prior to activation date</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>InactiveVendor % All Time = </run>
                <run fontcolor='#000000' fontname='Arial'>Count of all vendors of the which have zero completed orders from date of activation till date </run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>InactiveVendor % 30 day = </run>
                <run fontcolor='#000000' fontname='Arial'>Count of all vendors of the which have zero completed orders from date of activation till 30 days </run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>InactiveVendor % 60 day = </run>
                <run fontcolor='#000000' fontname='Arial'>Count of all vendors of the which have zero completed orders from date of activation till 60 days </run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>Vendor Fail Rate- All Time  = </run>
                <run fontcolor='#000000' fontname='Arial'>Number of Vendor Failed orders/Total Orders by vendors from date of activation till date </run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>GMV- All Time  = </run>
                <run fontcolor='#000000' fontname='Arial'>Total GMV in euro generated  from date of activation till date</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>ABV - All Time = </run>
                <run fontcolor='#000000' fontname='Arial' italic='true'>(Average Basket Value).</run>
                <run fontcolor='#000000' fontname='Arial'>Total GMV/Successful Orders  (from date of activation till date)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>ABS - All Time= </run>
                <run fontcolor='#000000' fontname='Arial' italic='true'>(Average Basket Size).</run>
                <run fontcolor='#000000' fontname='Arial'>Total Delivered Quantity/Successful Orders ( from date of activation till date)</run>
                <run>Æ&#10;&#10;&#10;</run>
                <run fontcolor='#d61f26' fontname='Arial' fontsize='11' underline='true'>Sheet : Vendor Level</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>Inactive All Time = </run>
                <run fontcolor='#000000' fontname='Arial'>Flag for vendor which have zero completed orders from date of activation till date </run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>Inactive 30 day = </run>
                <run fontcolor='#000000' fontname='Arial'>Flag for vendor which have zero completed orders from date of activation till 30 days</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>Vendor Fail Rate- 30 day  = </run>
                <run fontcolor='#000000' fontname='Arial'>Number of Vendor Failed orders/Total Orders by vendors from date of activation till 30 days </run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>GMV- 30 Day  = </run>
                <run fontcolor='#000000' fontname='Arial'>Total GMV in euro generated  from date of activation till 30 days</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>ABV - 30 Day = </run>
                <run fontcolor='#000000' fontname='Arial' italic='true'>(Average Basket Value).</run>
                <run fontcolor='#000000' fontname='Arial'>Total GMV/Successful Orders  (from date of activation till 30 days)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>ABS - 30 Day= </run>
                <run fontcolor='#000000' fontname='Arial' italic='true'>(Average Basket Size).</run>
                <run fontcolor='#000000' fontname='Arial'>Total Delivered Quantity/Successful Orders ( from date of activation till 30 days)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>Partial Rate 30 day = </run>
                <run fontcolor='#000000' fontname='Arial'>Partial Orders/ Total Orders (from date of activation till 30 days)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>Inactive 60 day = </run>
                <run fontcolor='#000000' fontname='Arial'>Flag for vendor which have zero completed orders from date of activation till 60 days</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>Vendor Fail Rate- 60 day  = </run>
                <run fontcolor='#000000' fontname='Arial'>Number of Vendor Failed orders/Total Orders by vendors from date of activation till 60 days </run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>GMV- 60 Day  = </run>
                <run fontcolor='#000000' fontname='Arial'>Total GMV in euro generated  from date of activation till 60 days</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>ABV - 60 Day = </run>
                <run fontcolor='#000000' fontname='Arial' italic='true'>(Average Basket Value).</run>
                <run fontcolor='#000000' fontname='Arial'>Total GMV/Successful Orders  (from date of activation till 60 days)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>ABS - 60 Day= </run>
                <run fontcolor='#000000' fontname='Arial' italic='true'>(Average Basket Size).</run>
                <run fontcolor='#000000' fontname='Arial'>Total Delivered Quantity/Successful Orders ( from date of activation till 60 days)</run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>Partial Rate 60 day = </run>
                <run fontcolor='#000000' fontname='Arial'>Partial Orders/ Total Orders (from date of activation till 60 days)</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000' fontname='Arial' fontsize='14'>Filters</run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>Acquisition Source </run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Arial' fontsize='8'>Classified as SSU( Self Sign Up) and other sources based on the accountsource in the Salesforce Account information of the vendor </run>
                <run>Æ&#10;</run>
                <run fontcolor='#ff0000' fontname='Arial' italic='true'>Account Type</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Arial' fontsize='8'>Filter based on based on the key_account_sub_category (Large Chain, Local Hero , National KA)  in the Salesforce Account information of the vendor</run>
                <run>Æ&#10;</run>
