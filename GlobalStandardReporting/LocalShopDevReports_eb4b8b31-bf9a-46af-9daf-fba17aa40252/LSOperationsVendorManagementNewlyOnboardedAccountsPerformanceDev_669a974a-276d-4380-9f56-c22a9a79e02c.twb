    <worksheet name='QA_Gates_Metrics'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='12'>QA Vendors Performance Comparision</run>
            <run fontalignment='1'>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query- Vendor Level' name='federated.0d3dsez09r0q5v1afz7x91sa61cq (copy 2)' />
          </datasources>
          <datasource-dependencies datasource='federated.0d3dsez09r0q5v1afz7x91sa61cq (copy 2)'>
            <column caption='New Vendors' datatype='integer' name='[Calculation_1388797596494045184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_code])' />
            </column>
            <column caption='Inactive Vendor Count- All Time' datatype='integer' name='[Calculation_1388797596500381697]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='COUNTD( CASE [inactive_till_date] WHEN 1 THEN [vendor_code] END)' />
            </column>
            <column caption='Vendor Sub Classification' datatype='string' name='[Calculation_1685190747982249984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [qa_gate_issue]=0 THEN &quot;Seamless Onboarding&quot; &#13;&#10;ELSEIF [qa_gate_issue]=1 AND [online_under_threshold]=0 THEN &quot;Stopped at QA Gates passed above threshold&quot; &#13;&#10;ELSEIF [qa_gate_issue]=1 AND [online_under_threshold]=1 THEN &quot;Stopped at QA Gates passed under threshold&quot; &#13;&#10;END' />
            </column>
            <column caption='Vendor Classification' datatype='string' name='[Calculation_1685190747988287490]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [qa_gate_issue]=0 THEN &quot;Seamless Onboarding&quot; &#13;&#10;ELSEIF [qa_gate_issue]=1 THEN &quot;Stopped at QA Gates&quot; END' />
            </column>
            <column caption='Zombie (Last 30 days) %' datatype='real' default-format='p0.0%' name='[Calculation_1685190749785415683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNTD( CASE [zombie_flag]  WHEN 1 THEN [vendor_code]+[global_entity_id] END))/(COUNTD([vendor_code]+[global_entity_id]))' />
            </column>
            <column caption='Inactive Vendor % - All Time' datatype='real' default-format='p0.0%' name='[Calculation_664280987660955649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-([Calculation_664280987664453635]/ [Calculation_664280987664351234])' />
            </column>
            <column caption='New Online Vendors' datatype='integer' name='[Calculation_664280987664351234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([vendor_code]+[global_entity_id])' />
            </column>
            <column caption='Active Vendor Count' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_664280987664453635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( CASE [inactive_till_date] WHEN 0 THEN [vendor_code]+[global_entity_id] END)' />
            </column>
            <column caption='Inactive Vendor % - 30 Day' datatype='real' default-format='p0.0%' name='[Calculation_664280987692285960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNTD( CASE [nr_completed_opd_30_day]  WHEN 0 THEN [vendor_code]+[global_entity_id] END))/(COUNTD([vendor_code]+[global_entity_id]))' />
            </column>
            <column caption='Inactive Vendor %- 60 Day' datatype='real' default-format='p0.0%' name='[Calculation_664280987692650505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(COUNTD( CASE [inactive_0_60_day] WHEN 0 THEN [vendor_code] END)/[Calculation_664280987664351234])' />
            </column>
            <column caption='ABS 60 Day' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[abs_0_60_day]' role='measure' type='quantitative' />
            <column caption='ABS 30 Day' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[abs_30_day]' role='measure' type='quantitative' />
            <column caption='ABV 60 Day' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[abv_0_60_day]' role='measure' type='quantitative' />
            <column caption='ABV 30 Day' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[abv_30_day]' role='measure' type='quantitative' />
            <column caption='Account Type' datatype='string' name='[account_type (Custom SQL Query)]' role='dimension' type='nominal' />
            <column caption='Acquisition Source' datatype='string' name='[acquisition_source (Custom SQL Query)]' role='dimension' type='nominal' />
            <column caption='Activation Week' datatype='date' name='[activation_week (Custom SQL Query)]' role='dimension' type='ordinal' />
            <column-instance column='[abs_0_60_day]' derivation='Avg' name='[avg:abs_0_60_day:qk]' pivot='key' type='quantitative' />
            <column-instance column='[abs_30_day]' derivation='Avg' name='[avg:abs_30_day:qk]' pivot='key' type='quantitative' />
            <column-instance column='[abv_0_60_day]' derivation='Avg' name='[avg:abv_0_60_day:qk]' pivot='key' type='quantitative' />
            <column-instance column='[abv_30_day]' derivation='Avg' name='[avg:abv_30_day:qk]' pivot='key' type='quantitative' />
            <column-instance column='[fr_0_60_day]' derivation='Avg' name='[avg:fr_0_60_day:qk]' pivot='key' type='quantitative' />
            <column-instance column='[fr_30_day]' derivation='Avg' name='[avg:fr_30_day:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Vendor Fail Rate 60 Day' datatype='real' default-format='p0.0%' name='[fr_0_60_day]' role='measure' type='quantitative' />
            <column caption='Vendor Fail Rate 30 day' datatype='real' default-format='p0.0%' name='[fr_30_day]' role='measure' type='quantitative' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Inactive 60 Day' datatype='integer' default-format='n#,##0;-#,##0' name='[inactive_0_60_day]' role='dimension' type='ordinal'>
              <aliases>
                <alias key='0' value='ACTIVE' />
                <alias key='1' value='INACTIVE' />
              </aliases>
            </column>
            <column aggregation='Sum' caption='Inactive All Time' datatype='integer' name='[inactive_till_date]' role='dimension' type='ordinal'>
              <aliases>
                <alias key='0' value='ACTIVE' />
                <alias key='1' value='INACTIVE' />
              </aliases>
            </column>
            <column datatype='boolean' name='[is_pelican_vendor]' role='dimension' type='nominal' />
            <column datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1685190747982249984]' derivation='None' name='[none:Calculation_1685190747982249984:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1685190747988287490]' derivation='None' name='[none:Calculation_1685190747988287490:nk]' pivot='key' type='nominal' />
            <column-instance column='[account_type (Custom SQL Query)]' derivation='None' name='[none:account_type (Custom SQL Query):nk]' pivot='key' type='nominal' />
            <column-instance column='[acquisition_source (Custom SQL Query)]' derivation='None' name='[none:acquisition_source (Custom SQL Query):nk]' pivot='key' type='nominal' />
            <column-instance column='[activation_week (Custom SQL Query)]' derivation='None' name='[none:activation_week (Custom SQL Query):qk]' pivot='key' type='quantitative' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_pelican_vendor]' derivation='None' name='[none:is_pelican_vendor:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[shop_type]' derivation='None' name='[none:shop_type:nk]' pivot='key' type='nominal' />
            <column caption='Completed Orders 60 Day' datatype='integer' name='[nr_completed_opd_0_60_day]' role='measure' type='quantitative' />
            <column caption='Completed Orders 30 Day' datatype='integer' name='[nr_completed_opd_30_day]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Online Under Threshold Flag' datatype='integer' name='[online_under_threshold]' role='dimension' type='ordinal'>
              <aliases>
                <alias key='0' value='Above Threshold' />
                <alias key='1' value='Under Threshold' />
              </aliases>
            </column>
            <column aggregation='Sum' caption='QA Gates Flag' datatype='integer' name='[qa_gate_issue]' role='dimension' type='ordinal'>
              <aliases>
                <alias key='0' value='Seamless Onboarding' />
                <alias key='1' value='Stopped at QA Gates' />
              </aliases>
            </column>
            <column caption='Shop Type' datatype='string' name='[shop_type]' role='dimension' type='nominal' />
            <column-instance column='[nr_completed_opd_0_60_day]' derivation='Sum' name='[sum:nr_completed_opd_0_60_day:qk]' pivot='key' type='quantitative' />
            <column-instance column='[nr_completed_opd_30_day]' derivation='Sum' name='[sum:nr_completed_opd_30_day:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1388797596494045184]' derivation='User' name='[usr:Calculation_1388797596494045184:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1388797596500381697]' derivation='User' name='[usr:Calculation_1388797596500381697:qk]' pivot='key' type='quantitative' />
