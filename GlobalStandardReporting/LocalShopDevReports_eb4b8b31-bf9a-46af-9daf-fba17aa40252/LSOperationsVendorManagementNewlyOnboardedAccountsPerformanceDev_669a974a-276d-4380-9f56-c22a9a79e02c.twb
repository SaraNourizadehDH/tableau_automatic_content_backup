            <column caption='Avg_OPD_30_Days' datatype='real' default-format='n0.0;-0.0' name='[Calculation_1217379293266825216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([nr_completed_opd_30_day])/SUM([active_cnt_30_day]))' />
            </column>
            <column caption='Avg_FR_30_Days' datatype='real' default-format='p0.00%' name='[Calculation_1217379293267685377]' role='measure' type='quantitative'>
