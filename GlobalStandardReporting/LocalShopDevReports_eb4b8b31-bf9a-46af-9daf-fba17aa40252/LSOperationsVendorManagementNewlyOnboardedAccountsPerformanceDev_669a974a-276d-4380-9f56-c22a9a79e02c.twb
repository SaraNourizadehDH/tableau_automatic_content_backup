    <worksheet name='Zombie_60_Day'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#d3293d'>Vendor Inactive % Upto 30 Days from being online *</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='8'>* For Cohorts in which vendors are  not 60 days old yet, vendor inactive % refers to percentage of vendors have NOT completed 1 successful order till date</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
