            <column caption='Chain Size' datatype='string' name='[chain_class]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Big-Chain&quot;' value='1.Large Chain (+100 outlets)' />
                <alias key='&quot;Medium-Chain&quot;' value='2.Medium Chain (11-99 outlets)' />
                <alias key='&quot;Non-Chain&quot;' value='4.Non-Chain' />
