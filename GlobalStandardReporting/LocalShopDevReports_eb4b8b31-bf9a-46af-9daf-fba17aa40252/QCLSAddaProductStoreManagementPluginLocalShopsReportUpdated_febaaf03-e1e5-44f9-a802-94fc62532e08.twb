        <zone forceUpdate='true' h='97250' id='7' type-v2='text' w='57364' x='42718' y='1583'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='11'>Item level view by Vendor</run>
            <run>Æ&#10;&#10;</run>
