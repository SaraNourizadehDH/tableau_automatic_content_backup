        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Week&apos; THEN [order_week]&#10;WHEN &apos;Month&apos; THEN [order_month]&#10;END' />
      </column>
      <column caption='Metric Field' datatype='real' name='[Added Time Period (copy)_3408873094385651716]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#10;WHEN &apos;Orders&apos; THEN SUM([count_orders_productsadded])&#10;WHEN &apos;Orders %&apos; THEN [Calculation_3408873094381494275]&#10;WHEN &apos;Orders GMV Euro&apos; THEN SUM([orders_gmv_age])&#10;WHEN &apos;Orders GMV %&apos; THEN ROUND(((SUM([orders_gmv_age])/SUM([total_gmv_eur])) * 100), 1)&#10;WHEN &apos;Products GMV Euro&apos; THEN SUM([item_gmv_tppe_wqtycondition])&#10;WHEN &apos;Products GMV %&apos; THEN ROUND((SUM([item_gmv_tppe_wqtycondition])/SUM([orders_gbv_age]) * 100), 1)&#10;END' />
      </column>
      <column caption='Orders Per Product Added' datatype='real' name='[Calculation_2988560589537992704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_orders_productsadded])/SUM([Calculation_76561217511526401])' />
      </column>
      <column caption='GMV per Order ' datatype='real' name='[Calculation_2988560589538222081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_gmv_age])/SUM([count_orders_productsadded])' />
      </column>
      <column caption='GBV per Product' datatype='real' name='[Calculation_2988560589541265410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([item_gmv_tppe_wqtycondition])/SUM([Calculation_76561217511526401])' />
      </column>
      <column caption='Added Period' datatype='date' name='[Calculation_3408873094379716609]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Week&apos; THEN [added_week]&#10;WHEN &apos;Month&apos; THEN [added_month]&#10;END' />
      </column>
      <column caption='Orders %' datatype='real' default-format='p0.00%' name='[Calculation_3408873094381494275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([count_orders_productsadded])/SUM([total_orders])' />
      </column>
      <column caption='Total Orders LOD' datatype='integer' name='[Calculation_3609353661307125779]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id], [vertical_type], [order_week], [order_month] : MAX([total_orders])}' />
      </column>
      <column caption='Corrected Products Added' datatype='integer' name='[Calculation_76561217511526401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [order_rank] = 1 THEN [products_added] END' />
      </column>
      <column caption='Orders GMV %' datatype='real' name='[Calculation_76561217526296578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_gmv_age])/SUM([total_gmv_eur])' />
      </column>
      <column caption='Product GBV % of Orders' datatype='real' name='[Calculation_76561217530314755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([item_gmv_tppe_wqtycondition])/SUM([orders_gbv_age])' />
      </column>
      <column caption='Product GBV % - Total' datatype='real' name='[Calculation_810999800566935552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([item_gmv_tppe_wqtycondition])/SUM([total_gmv_eur])' />
      </column>
      <column caption='Orders wParameter' datatype='integer' name='[Calculation_810999800822722562]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Orders&apos; THEN [count_orders_productsadded] ELSE NULL END' />
      </column>
      <column caption='Orders % wParameter' datatype='real' name='[Calculation_810999800823021571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Orders %&apos; THEN [Calculation_3408873094381494275] ELSE NULL END' />
      </column>
      <column caption='Orders GMV Euro wParameter' datatype='real' name='[Calculation_810999800823611396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Orders GMV Euro&apos; THEN [orders_gmv_age] ELSE NULL END' />
      </column>
      <column caption='Orders GMV % wParameter' datatype='real' name='[Calculation_810999800824025093]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Orders GMV %&apos; THEN [Calculation_76561217526296578] ELSE NULL END' />
      </column>
      <column caption='Products GBV Euro wParameter' datatype='real' name='[Calculation_810999800824926214]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Products GBV Euro&apos; THEN [item_gmv_tppe_wqtycondition] ELSE NULL END' />
      </column>
      <column caption='Products GBV % - Orders wParameter' datatype='real' name='[Calculation_810999800825102343]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Products GBV % Orders&apos; THEN [Calculation_76561217530314755] ELSE NULL END' />
      </column>
      <column caption='Order Time Diff' datatype='integer' name='[Order Period (copy)_4067172696270143488]' role='dimension' type='ordinal'>
