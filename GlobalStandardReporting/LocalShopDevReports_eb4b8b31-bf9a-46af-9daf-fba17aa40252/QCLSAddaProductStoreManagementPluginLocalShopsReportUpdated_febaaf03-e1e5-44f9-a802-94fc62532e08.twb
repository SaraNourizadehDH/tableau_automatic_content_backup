        </zone>
        <zone fixed-size='527' forceUpdate='true' h='70917' id='187' is-fixed='true' type-v2='text' w='41009' x='1139' y='1583'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='11'>High Level Impact - Table View</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#555555' fontsize='10' underline='true'>Disclaimer</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ff0000' italic='true'>Underestimation Issue</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>The reported values here might be underestimated. There are cases in which the skuID/product information is missing(NULL) in the orders data. Hence, certain orders which contain some of the plugin added products might not be considered. The extent of this varies across entity. </run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#ff0000' italic='true'>Summary for March 2023 (Entity - % of orders with SKU Id missing)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>DH Europe - 0.01%</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>Foodpanda APAC - 0.05%</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>Hungerstation - 77%</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>Pedidosya - 61.6%</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>Talabat - 31.3%</run>
            <run>Æ&#10;&#10;&#10;</run>
            <run bold='true' fontcolor='#555555' fontsize='10' underline='true'>Metrics</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#ff0000' italic='true'>Orders</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'># of orders containing the products added by the plugin</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#ff0000' italic='true'>% of Total Orders</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'># of orders containing the products added by the plugin/Total number of orders by the vendors who added the respective products</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#ff0000' italic='true'>Orders GMV Euro</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>GMV generated from the all the orders containing the products added by the plugin</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#ff0000' italic='true'>Orders GMV %</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>GMV generated from the all the orders containing the products added by the plugin/Total GMV generated by the vendors who added the respective products</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#ff0000' italic='true'>Product GBV Euro</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>GBV(Gross Basket Value) of the products added by the plugin</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#ff0000' italic='true'>Product GBV % - Orders</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>GBV from the products added by the plugin/Total GBV of the orders containing the products added by the plugin</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#ff0000' italic='true'>Product GBV % - Total</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>GBV from the products added by the plugin/Total GBV of all of the orders from the vendors who added the respective products</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#ff0000' italic='true'>Orders per Product</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'># of orders containing the products added by the plugin/Number of products added by the plugin</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#ff0000' italic='true'>GBV per product</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000'>GBV of the products added by the plugin/Number of products added by the plugin</run>
            <run>Æ&#10;</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='4' />
          </zone-style>
        </zone>
      </zones>
