            <column-instance column='[creation_month]' derivation='None' name='[none:creation_month:ok]' pivot='key' type='ordinal' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Updated Date' datatype='date' name='[updated_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1894608131364012035]' derivation='User' name='[usr:Calculation_1894608131364012035:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Id' datatype='string' name='[vendor_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <computed-sort column='[federated.05leigg0eyyzo712zjza804yj5hv].[none:Calculation_1894608131360649216:nk]' direction='DESC' using='[federated.05leigg0eyyzo712zjza804yj5hv].[usr:Calculation_1894608131364012035:qk]' />
