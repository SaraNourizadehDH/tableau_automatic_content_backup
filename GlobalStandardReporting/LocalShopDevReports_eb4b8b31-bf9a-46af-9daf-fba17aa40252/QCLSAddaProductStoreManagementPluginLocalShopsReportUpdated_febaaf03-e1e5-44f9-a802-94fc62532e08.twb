              <calculation class='tableau' formula='SUM([count_orders_productsadded])/SUM([Calculation_76561217511526401])' />
            </column>
            <column caption='GBV per Product' datatype='real' name='[Calculation_2988560589541265410]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([item_gmv_tppe_wqtycondition])/SUM([Calculation_76561217511526401])' />
            </column>
            <column caption='Added Period' datatype='date' name='[Calculation_3408873094379716609]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Week&apos; THEN [added_week]&#10;WHEN &apos;Month&apos; THEN [added_month]&#10;END' />
            </column>
            <column caption='Orders %' datatype='real' default-format='p0.00%' name='[Calculation_3408873094381494275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_orders_productsadded])/SUM([total_orders])' />
            </column>
            <column caption='Total Orders LOD' datatype='integer' name='[Calculation_3609353661307125779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id], [vertical_type], [order_week], [order_month] : MAX([total_orders])}' />
            </column>
            <column caption='Corrected Products Added' datatype='integer' name='[Calculation_76561217511526401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [order_rank] = 1 THEN [products_added] END' />
            </column>
            <column caption='Orders GMV %' datatype='real' name='[Calculation_76561217526296578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_gmv_age])/SUM([total_gmv_eur])' />
            </column>
            <column caption='Product GBV % of Orders' datatype='real' name='[Calculation_76561217530314755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([item_gmv_tppe_wqtycondition])/SUM([orders_gbv_age])' />
            </column>
            <column caption='Product GBV % - Total' datatype='real' name='[Calculation_810999800566935552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([item_gmv_tppe_wqtycondition])/SUM([total_gmv_eur])' />
            </column>
