              <calculation class='tableau' formula='&quot;Management Entity&quot;' />
              <aliases>
                <alias key='&quot;Country Name&quot;' value='Country Name' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.05leigg0eyyzo712zjza804yj5hv'>
            <column caption='Stacked color parameter' datatype='string' name='[Calculation_1894608131360649216]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Management Entity&apos; THEN [management_entity]&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Global Entity Id&apos; THEN [global_entity_id]&#10;WHEN &apos;Country Name&apos; THEN [country_name]&#10;END' />
            </column>
            <column caption='Products per vendor' datatype='real' name='[Calculation_1894608131364012035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([global_catalog_id])/COUNTD([vendor_id]+[global_entity_id])' />
            </column>
            <column caption='Added On' datatype='date' default-format='*dd-MMM-yy' name='[Calculation_246923981825085443]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[updated_date]' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
