  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='KPI Glossary'>
      <repository-location id='KPIGlossary' path='/t/GlobalStandardReporting/workbooks/TimetoGOActive-New' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='2200' maxwidth='1500' minheight='2200' minwidth='1500' preset-index='17' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='99272' id='3' param='vert' type-v2='layout-flow' w='98934' x='533' y='364'>
            <zone fixed-size='687' h='31227' id='5' is-fixed='true' param='horz' type-v2='layout-flow' w='98934' x='533' y='364'>
              <zone fixed-size='527' forceUpdate='true' h='31227' id='6' is-fixed='true' type-v2='text' w='35666' x='533' y='364'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='15'>KPI Glossary</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='11'>Filters</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff0000' italic='true'>Go Active Date Range</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='8'>Active Timestamp is used to filter the data.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff0000' italic='true'>Geographical Filters</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='8'>Filters for Region and Country</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff0000' italic='true'>Is Acceptable Sequence</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='8'>True:</run>
                  <run fontcolor='#000000' fontsize='8'> Account Journey  starts from the status &apos;New&apos; and ends at &apos;Active&apos; status from salesforce and it has atleast </run>
                  <run bold='true' fontcolor='#000000' fontsize='8'>6 steps</run>
                  <run fontcolor='#000000' fontsize='8'> in the journey.</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='8'>False: </run>
                  <run fontcolor='#000000' fontsize='8'>Account Journey doesnt follow the acceptable sequence</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff0000' italic='true'>Is Complete Sequence</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='8'>True: Account Journey is following a sequencial order of status Journey ONLY.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontname='Roboto' fontsize='8' italic='true'><![CDATA[New < Negotiation < Collecting Documents < Quality Check < Menu processing < Onboarding < Active]]></run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontname='Roboto' fontsize='8'>False: </run>
                  <run fontcolor='#000000' fontsize='8'>Account Journey is not following the sequential order of status journey</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff0000' italic='true'>Is Outlier</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='8'>True</run>
                  <run fontcolor='#000000' fontsize='8'><![CDATA[: Account Creation to Active Days <1 day OR > 60days]]></run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='8'>False</run>
                  <run fontcolor='#000000' fontsize='8'>: Account Creation to Active Days are between 1-60 days</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff0000' italic='true'>Is Correct Start</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='8'>True:</run>
                  <run fontcolor='#000000' fontsize='8'> Account Journey Sequence is correct i.e &apos;New&apos; is the first status </run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='8'>False:</run>
                  <run fontcolor='#000000' fontsize='8'> Account Journey Sequence is not correct</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff0000' italic='true'>Key Account Type</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='8'>Filter based on the key _account_sub_category in the Salesforce  Account Information of the  vendor</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff0000' italic='true'>Store level Filters</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='8'>Filter for store level type I and II</run>
                  <run>Æ&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='31227' id='93' type-v2='text' w='63268' x='36199' y='364'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='11'>Scorecard</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff0000' italic='true'>Avg. Onboarding Days (from Created to Active)</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='8'>Average number of Vendor Accounts from Account Creation Timestamp to Active Timestamp.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff0000' italic='true'>Avg. Onboarding Days (from QC to Active)</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='8'>Average number of Vendor Accounts from Quality Check Timestamp to Active Timestamp.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff0000' italic='true'>#Online Vendors</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='8'>Number of &apos;Active&apos; status of Salesforce Vendor Accounts</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff0000' italic='true'>#Reactivated Vendors</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='8'>Number of Win-back Vendor Accounts (Active &gt;1)</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='11'>Barcharts</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff0000' italic='true'>Quality Check to Active</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='8'>It shows Average number of days for vendor accounts to take from Quality Check to Active Journey Region and country  level wise.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff0000' italic='true'>Created to Active</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='8'>It shows Average number of days for vendor accounts to take from Account Creation to Active Journey Region and country level wise.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='11'>Onboarding Jouney timeline (in days) - High Level View</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='8'>It shows Average number of days status journey from New to Active for Vendor Accounts on a high level.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='11'>Onboarding Jouney timeline (in days) - Detailed View</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='8'>It gives the detailed level summary of Vendor Accounts and all its status journey.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
