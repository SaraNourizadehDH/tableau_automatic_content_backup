          <formatted-text>
            <run fontcolor='#e15759'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='http://ip-172-31-0-203:8905/t/GlobalStandardReporting/workbooks/QCLSNewlyOnboardedAccounts-PerformanceUpdated/KPIGlossary?rev=' id='KPIGlossary' path='/t/GlobalStandardReporting/workbooks/QCLSNewlyOnboardedAccounts-PerformanceUpdated' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1654' maxwidth='1169' minheight='1654' minwidth='1169' preset-index='13' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='16' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='99032' id='19' param='vert' type-v2='layout-flow' w='98632' x='684' y='484'>
            <zone h='3507' id='20' type-v2='title' w='98632' x='684' y='484'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='93531' id='3' type-v2='text' w='98375' x='1027' y='3386'>
          <formatted-text>
            <run bold='true' fontcolor='#d61f26' fontsize='12' underline='true'>Sheet : High Level Performance </run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Arial' fontsize='11'>KPI Formula</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#ff0000' fontname='Arial' italic='true'>Average Order 30 days = </run>
            <run fontcolor='#000000' fontname='Arial'>Total number of orders by vendors in a cohort in 30 days of going online/Total Vendor Count of the cohort</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#ff0000' fontname='Arial' italic='true'>Average Vendor Fail Rate 30 days  = </run>
            <run fontcolor='#000000' fontname='Arial'>Number of Vendor Failed orders by vendors in a cohort in 30 days of going online / Total number of orders by vendors in a cohort in 30 days of going online</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#ff0000' fontname='Arial' italic='true'>Average Order 30 to 60 days  = </run>
            <run fontcolor='#000000' fontname='Arial'>Total number of orders by vendors in a cohort in 30 to 60 days of going online/Total Vendor Count of the cohort</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#ff0000' fontname='Arial' italic='true'>Average Vendor Fail Rate 30 to 60 days   =  </run>
            <run fontcolor='#000000' fontname='Arial'>Number of Vendor Failed orders by vendors in a cohort in 30 to 60 days of going online / Total number of orders by vendors in a cohort in 30 to 60 days of going online</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#ff0000' fontname='Arial' italic='true'>InactiveVendor % 60 days  = </run>
            <run fontcolor='#000000' fontname='Arial'>Count of all vendors of the cohort with zero completed orders in 60 days from going online/Count of all vendors of the cohort    </run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#ff0000' fontname='Arial' italic='true'>Total Vendor Count in Cohort = </run>
            <run fontcolor='#000000' fontname='Arial'>The count of total vendor went online for the first time in that week.  </run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Arial' fontsize='11'>Filters</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#ff0000' fontname='Arial' italic='true'>Acquisition Source </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Arial' fontsize='8'>Classified as SSU( Self Sign Up) and Cold Lead ( Remaining sources) based on the accountsource in the Salesforce Account information of the vendor </run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#ff0000' fontname='Arial' italic='true'>Account Type</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Arial' fontsize='8'>Filter based on based on the key_account_sub_category  in the Salesforce Account information of the vendor</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#ff0000' fontname='Arial' italic='true'>Shop Type l1 and Shop Type l2</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Arial' fontsize='8'>Filter based on based on the shoptye l1 and shoptype l2 in the vendor logs table</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#ff0000' fontname='Arial' italic='true'>Region, Country &amp; Management Entity</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Arial' fontsize='8'>Self explanatory demographic filters</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#ff0000' fontname='Arial' italic='true'>Is_Pelican</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Arial' fontsize='8'>Pelican Vendor classification based on flag in vendor logs table</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#d61f26' fontsize='12' underline='true'>Sheet : Cohort Performance Development</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#ff0000' fontname='Arial' italic='true'>Total Vendor Count = </run>
            <run fontcolor='#000000' fontname='Arial'>Total Number vendors that went online in the activation period</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#ff0000' fontname='Arial' italic='true'>Active Vendor Count = </run>
            <run fontcolor='#000000' fontname='Arial' italic='true'>Count of </run>
            <run fontcolor='#000000' fontname='Arial'>Vendor with atleast one order in week/month 30 days prior to activation date</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#ff0000' fontname='Arial' italic='true'>InactiveVendor %  = </run>
            <run fontcolor='#000000' fontname='Arial'>Count of all vendors of the cohort which have 0 orders week/month 30 days prior to corresponding transaction date for each cohort </run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#ff0000' fontname='Arial' italic='true'>Completed Orders  = </run>
            <run fontcolor='#000000' fontname='Arial'>Total number of orders by vendors in a cohort in 30 to 60 days of going online/Total Vendor Count of the cohort</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#ff0000' fontname='Arial' italic='true'>Vendor Fail Rate  = </run>
            <run fontcolor='#000000' fontname='Arial'>Number of Vendor Failed orders/Total Orders by vendors in a cohort in the transaction period </run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#ff0000' fontname='Arial' italic='true'>GMV  =  </run>
            <run fontcolor='#000000' fontname='Arial'>Total GMV in euro generated by the cohort in the corresponding transaction date</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#ff0000' fontname='Arial' italic='true'>ABV  =  </run>
            <run fontcolor='#000000' fontname='Arial' italic='true'>(Average Basket Value).</run>
            <run fontcolor='#000000' fontname='Arial'>Total GMV/Successful Orders by the cohort in the corresponding transaction period </run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#ff0000' fontname='Arial' italic='true'>ABS = </run>
            <run fontcolor='#000000' fontname='Arial' italic='true'>(Average Basket Size).</run>
            <run fontcolor='#000000' fontname='Arial'>Total Delivered Quantity/Successful Orders by the cohort in the corresponding transaction period   </run>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='4' />
          </zone-style>
        </zone>
      </zones>
