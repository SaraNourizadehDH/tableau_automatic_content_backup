          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Week' caption='Parameter- Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;month&quot;' value='Month' />
                <alias key='&quot;week&quot;' value='Week' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0d3dsez09r0q5v1afz7x91sa61cq (copy)'>
            <column caption='Vendor Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_1344606019874197504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nr_failed_orders_vendor])/SUM([nr_failed_orders_vendor]+[nr_completed_orders])' />
            </column>
            <column caption='Inactive Vendor %' datatype='real' default-format='p0.0%' name='[Calculation_1344606019874656257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (SUM([active_vendor_cnt])/SUM([vendor_cnt]))' />
            </column>
            <column caption='ABV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1344606019875229698]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_gmv_eur])/SUM([nr_completed_orders])' />
            </column>
            <column caption='ABS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1344606019875713027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_quantity])/SUM([nr_completed_orders])' />
            </column>
            <column caption='Activation Period' datatype='date' name='[Calculation_1735856239448576000]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1],[activation_period]))+1' />
            </column>
            <column caption='Transaction Period' datatype='date' default-format='*mmmm dd, yyyy' name='[Calculation_1735856239448854529]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 1],[transaction_period]))+1' />
            </column>
