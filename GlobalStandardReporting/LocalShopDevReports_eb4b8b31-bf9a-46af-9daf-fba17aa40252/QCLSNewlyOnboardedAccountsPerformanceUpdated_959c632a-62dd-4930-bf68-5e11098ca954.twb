      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0d3dsez09r0q5v1afz7x91sa61cq (copy)].[sum:nr_completed_OPD_30_60_Day:qk]&quot;' value='Fail Rate' />
          <alias key='&quot;[federated.0d3dsez09r0q5v1afz7x91sa61cq (copy)].[sum:nr_completed_OPD_30_Day:qk]&quot;' value='Orders' />
          <alias key='&quot;[federated.0d3dsez09r0q5v1afz7x91sa61cq (copy)].[sum:vendor_cnt:qk]&quot;' value='New Online Vendors' />
          <alias key='&quot;[federated.0d3dsez09r0q5v1afz7x91sa61cq (copy)].[sum:VENDOR_CNT:qk]&quot;' value='Vendor Count' />
        </aliases>
      </column>
      <column caption='Granularity' datatype='string' name='[Calculation_1047086940403052544]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Management Entity&quot; THEN [management_entity]&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;Country&quot; THEN [country]&#13;&#10;ELSEIF [Parameters].[Parameter 2]=&quot;Shop Type&quot; THEN [shop_type]&#13;&#10;END' />
      </column>
      <column caption='Metric ' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1047086942494535682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&quot;Active Vendor Count&quot; THEN SUM([active_vendor_cnt])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;New Online Vendors&quot; THEN SUM([vendor_cnt])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;Completed Orders&quot; THEN SUM([nr_completed_orders])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;Inactive Vendor %&quot; THEN 1 - (SUM([active_vendor_cnt])/SUM([vendor_cnt]))&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;GMV&quot; THEN SUM([total_gmv_eur])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;Vendor Fail Rate&quot; THEN SUM([nr_failed_orders_vendor])/SUM([nr_failed_orders_vendor]+[nr_completed_orders])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;ABS&quot; THEN SUM([total_quantity])/SUM([nr_completed_orders])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&quot;ABV&quot; THEN SUM([total_gmv_eur])/SUM([nr_completed_orders])&#13;&#10;END' />
      </column>
      <column caption='Vendor Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_1344606019874197504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nr_failed_orders_vendor])/SUM([nr_failed_orders_vendor]+[nr_completed_orders])' />
      </column>
      <column caption='Inactive Vendor %' datatype='real' default-format='p0.0%' name='[Calculation_1344606019874656257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - (SUM([active_vendor_cnt])/SUM([vendor_cnt]))' />
      </column>
      <column caption='ABV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1344606019875229698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_gmv_eur])/SUM([nr_completed_orders])' />
      </column>
      <column caption='ABS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1344606019875713027]' role='measure' type='quantitative'>
