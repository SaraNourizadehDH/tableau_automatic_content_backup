    <datasource caption='Custom SQL Query+ (cl_intl_markets)' inline='true' name='federated.1ftyuq910noz5i15rsdvz1k0ztc3' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0k1lirz05mpl3f104yhns0izs8ae'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhub-intl-markets' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='cl_intl_markets' server-oauth='' username='tugce.usta@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[Custom SQL Query].[global_entity_id]' />
              <expression op='[gsr_entitlements_performance_global_entity_id].[global_entity_id]' />
            </expression>
          </clause>
          <relation connection='bigquery.0k1lirz05mpl3f104yhns0izs8ae' name='Custom SQL Query' type='text'><![CDATA[WITH actuals as (
  SELECT
    global_entity_id,
    CAST(placed_date_local AS DATE) as order_date,
    SUM(successful_orders) as orders,
    SUM(CASE WHEN is_acquisition IS TRUE THEN successful_orders END) AS acquisitions,
    SUM(value.gmv_local) as gmv,
    SUM(value.gmv_local) / SUM(successful_orders) AS aov
FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.agg_orders_daily`
WHERE placed_date_local >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -30 MONTH),MONTH)
GROUP BY 1,2
)

SELECT Segment,management_entity,sub_entity
,fc.*,  orders , acquisitions, aov, gmv
FROM int-per-data-team.forecasting.forecasting_models_daily fc
LEFT JOIN actuals a 
  ON fc.global_entity_id = a.global_entity_id AND fc.ds = a.order_date
INNER JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` ent 
  ON ent.global_entity_id = fc.global_entity_id
WHERE is_reporting_enabled
  AND ds << CURRENT_DATE()
  AND ds >> '2022-06-01']]></relation>
          <relation connection='bigquery.0k1lirz05mpl3f104yhns0izs8ae' name='gsr_entitlements_performance_global_entity_id' table='[fulfillment-dwh-production.cl_intl_markets].[gsr_entitlements_performance_global_entity_id]' type='table' />
        </_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation join='inner' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[Custom SQL Query].[global_entity_id]' />
              <expression op='[gsr_entitlements_performance_global_entity_id].[global_entity_id]' />
            </expression>
          </clause>
          <relation connection='bigquery.0k1lirz05mpl3f104yhns0izs8ae' name='Custom SQL Query' type='text'><![CDATA[WITH actuals as (
  SELECT
    global_entity_id,
    CAST(placed_date_local AS DATE) as order_date,
    SUM(successful_orders) as orders,
    SUM(CASE WHEN is_acquisition IS TRUE THEN successful_orders END) AS acquisitions,
    SUM(value.gmv_local) as gmv,
    SUM(value.gmv_local) / SUM(successful_orders) AS aov
FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.agg_orders_daily`
WHERE placed_date_local >>= DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -30 MONTH),MONTH)
GROUP BY 1,2
)

SELECT Segment,management_entity,sub_entity
,fc.*,  orders , acquisitions, aov, gmv
FROM int-per-data-team.forecasting.forecasting_models_daily fc
