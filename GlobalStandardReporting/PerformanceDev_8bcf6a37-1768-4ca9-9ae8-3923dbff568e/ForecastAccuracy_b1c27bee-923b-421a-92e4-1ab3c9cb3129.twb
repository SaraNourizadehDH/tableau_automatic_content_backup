    <worksheet name='graph'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (cl_intl_markets)' name='federated.1ftyuq910noz5i15rsdvz1k0ztc3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='1 week (7d)' caption='Rolling (Following) N Days' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='7'>
              <calculation class='tableau' formula='7' />
              <aliases>
                <alias key='1' value='1 day' />
                <alias key='7' value='1 week (7d)' />
                <alias key='28' value='4 weeks (28d)' />
                <alias key='30' value='30 days' />
                <alias key='31' value='31 days' />
                <alias key='84' value='12 weeks (84d)' />
                <alias key='168' value='24 weeks (168d)' />
              </aliases>
            </column>
            <column alias='Orders' caption='Regressand' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;orders&quot;'>
              <calculation class='tableau' formula='&quot;orders&quot;' />
              <aliases>
                <alias key='&quot;acquisitions&quot;' value='Acquisitions' />
                <alias key='&quot;aov&quot;' value='AOV LC' />
                <alias key='&quot;gmv&quot;' value='GMV LC' />
                <alias key='&quot;orders&quot;' value='Orders' />
              </aliases>
              <desc>
                <formatted-text>
                  <run>Use AOV only on entity+date level. AOV is not usable for run rate or running N dates calculations.</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='View' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Sub Entity&quot;'>
              <calculation class='tableau' formula='&quot;Sub Entity&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ftyuq910noz5i15rsdvz1k0ztc3'>
            <column caption='GMV' datatype='real' name='[AOV (copy)_5393342072626700311]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [forecast_model] = &apos;A&apos; THEN [gmv] END' />
            </column>
            <column caption='Target Date - Model Date' datatype='integer' name='[Calculation_293437702375575552]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [forecast_date], ds)' />
            </column>
            <column caption='Model Date In Following N Days' datatype='boolean' name='[Calculation_293437702376075265]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_293437702375575552] &gt;= 0 AND [Calculation_293437702375575552] &lt; [Parameters].[Parameter 1] THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Today - Model Date' datatype='integer' name='[Calculation_293437702378496004]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [forecast_date], TODAY())' />
            </column>
            <column caption='Model Date In Last N Days' datatype='boolean' name='[Calculation_293437702378971141]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_293437702378496004] &lt; [Parameters].[Parameter 1] THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Model A: Order' datatype='real' name='[Calculation_5393342072213123073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [forecast_model] = &apos;A&apos; THEN [ord_yhat] END' />
            </column>
            <column caption='actual date filter' datatype='boolean' name='[Calculation_5393342072280641544]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[ds]&gt;= [forecast_date] and ds &lt; TODAY()' />
            </column>
            <column caption='Regressand Model A' datatype='real' name='[Calculation_5393342072624799754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [Calculation_5393342072213123073]&#10;WHEN &apos;acquisitions&apos;     THEN [Model A: Order (copy)_5393342072625405963]&#10;WHEN &apos;aov&apos;              THEN [Model A: Acq (copy)_5393342072625479692]&#10;WHEN &apos;gmv&apos;              THEN [Model A: AOV (copy)_5393342072625582093]&#10;ELSE FLOAT(NULL)&#10;END' />
            </column>
            <column caption='View' datatype='string' name='[Calculation_939493147422867456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3]=&apos;Segment&apos; THEN [Segment]&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Management Entity&apos; THEN [management_entity]&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Sub Entity&apos; THEN [sub_entity]&#10;END' />
            </column>
            <column caption='Error Model B %' datatype='real' default-format='p0.0%' name='[Error Model A % (copy)_5393342072265932807]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS(SUM([Regressand Model A (copy)_5393342072626036754]) / SUM([Regressand Model A (copy)_5393342072626286611]) - 1 )' />
            </column>
            <column caption='Error Model A %' datatype='real' default-format='p0.0%' name='[Error Model A (copy)_5393342072265818118]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS(SUM([Calculation_5393342072624799754]) / SUM([Regressand Model A (copy)_5393342072626286611]) - 1 )' />
            </column>
            <column caption='Model A: GMV' datatype='real' name='[Model A: AOV (copy)_5393342072625582093]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [forecast_model] = &apos;A&apos; THEN [ord_yhat] * [aov_yhat] END' />
            </column>
            <column caption='Model B: AOV' datatype='real' name='[Model A: AOV (copy)_5393342072625680400]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [forecast_model] = &apos;B&apos; THEN [aov_yhat] END' />
            </column>
            <column caption='Model A: AOV' datatype='real' name='[Model A: Acq (copy)_5393342072625479692]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [forecast_model] = &apos;A&apos; THEN [aov_yhat] END' />
            </column>
            <column caption='Model B: Acq ' datatype='real' name='[Model A: Acq (copy)_5393342072625680401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [forecast_model] = &apos;B&apos; THEN [acq_yhat] END' />
            </column>
            <column caption='Model B: GMV' datatype='real' name='[Model A: GMV (copy)_5393342072625680399]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [forecast_model] = &apos;B&apos; THEN [ord_yhat] * [aov_yhat] END' />
            </column>
            <column caption='Model B:  Order ' datatype='real' name='[Model A: Order (copy)_5393342072213393410]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [forecast_model] = &apos;B&apos; THEN [ord_yhat] END' />
            </column>
            <column caption='Orders' datatype='integer' name='[Model A: Order (copy)_5393342072263417859]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [forecast_model] = &apos;A&apos; THEN [orders] END' />
            </column>
            <column caption='Model A: Acq' datatype='real' name='[Model A: Order (copy)_5393342072625405963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [forecast_model] = &apos;A&apos; THEN [acq_yhat] END' />
            </column>
            <column caption='Acquisitions' datatype='integer' name='[Orders (copy) (copy)_5393342072626401301]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [forecast_model] = &apos;A&apos; THEN [acquisitions] END' />
            </column>
            <column caption='AOV' datatype='real' name='[Orders (copy)_5393342072626384916]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [forecast_model] = &apos;A&apos; THEN [aov] END' />
            </column>
            <column caption='Regressand Model B' datatype='real' name='[Regressand Model A (copy)_5393342072626036754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [Model A: Order (copy)_5393342072213393410]&#10;WHEN &apos;acquisitions&apos;     THEN [Model A: Acq (copy)_5393342072625680401]&#10;WHEN &apos;aov&apos;              THEN [Model A: AOV (copy)_5393342072625680400]&#10;WHEN &apos;gmv&apos;              THEN [Model A: GMV (copy)_5393342072625680399]&#10;ELSE FLOAT(NULL)&#10;END' />
            </column>
            <column caption='Actuals' datatype='real' name='[Regressand Model A (copy)_5393342072626286611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;orders&apos;           THEN [Model A: Order (copy)_5393342072263417859]&#10;WHEN &apos;acquisitions&apos;     THEN [Orders (copy) (copy)_5393342072626401301]&#10;WHEN &apos;aov&apos;              THEN [Orders (copy)_5393342072626384916]&#10;WHEN &apos;gmv&apos;              THEN [AOV (copy)_5393342072626700311]&#10;ELSE FLOAT(NULL)&#10;END' />
            </column>
