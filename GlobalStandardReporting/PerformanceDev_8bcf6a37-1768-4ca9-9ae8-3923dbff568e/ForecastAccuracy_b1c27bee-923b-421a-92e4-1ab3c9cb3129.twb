INNER JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` ent 
  ON ent.global_entity_id = fc.global_entity_id
WHERE is_reporting_enabled
  AND ds << CURRENT_DATE()
  AND ds >> '2022-06-01']]></relation>
