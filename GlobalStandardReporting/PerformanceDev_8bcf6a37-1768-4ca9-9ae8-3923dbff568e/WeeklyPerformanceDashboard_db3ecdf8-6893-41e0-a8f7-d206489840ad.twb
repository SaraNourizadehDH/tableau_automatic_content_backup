            <column aggregation='Avg' caption='value_num' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_4800837264253149190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [metric_name]&#10;WHEN    &apos;sessions&apos;  THEN     [value]/1000&#10;WHEN    &apos;orders_successful&apos;  THEN     [value]/1000&#10;WHEN    &apos;orders&apos;  THEN     [value]/1000&#10;WHEN    &apos;sessions_w_order&apos;  THEN     [value]/1000&#10;WHEN    &apos;active_customers&apos;  THEN     [value]/1000&#10;WHEN    &apos;active_customers_qc&apos;  THEN     [value]/1000&#10;WHEN    &apos;acquisitions&apos;  THEN     [value]/1000&#10;WHEN    &apos;gmv_eur&apos;  THEN     [value]/1000&#10;WHEN    &apos;orders_aov&apos;  THEN     [value]&#10;WHEN    &apos;avg_delivery_time&apos;  THEN     [value]&#10;WHEN    &apos;nps_ao&apos;  THEN     [value]*100&#10;WHEN    &apos;logistics_index&apos; THEN [value]&#10;WHEN    &apos;frequency&apos; THEN [value]&#10;ELSE NULL&#10;END' />
            </column>
            <column aggregation='Avg' caption='value_pct' datatype='real' default-format='p0.0%' name='[Calculation_4800837264253227015]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [metric_name]&#10;WHEN    &apos;sessions_cvr&apos;  THEN     [value]&#10;WHEN    &apos;orders_fail_rate&apos;  THEN     [value]&#10;WHEN    &apos;orders_higher_4over5_rate&apos;  THEN     [value]&#10;WHEN    &apos;delivery_fee_rate_afv_od&apos;  THEN     [value]&#10;WHEN    &apos;customer_fee_afv_rate_od&apos;  THEN   [value]&#10;WHEN    &apos;extreme_delay_orders_rate&apos;  THEN     [value]&#10;WHEN    &apos;seamless_orders_rate&apos;  THEN     [value]&#10;ELSE NULL&#10;END' />
            </column>
            <column aggregation='Avg' caption='value_num_lw' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_4800837264253296648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [metric_name]&#10;WHEN    &apos;sessions&apos;  THEN     [value_comparison]/1000&#10;WHEN    &apos;orders_successful&apos;  THEN     [value_comparison]/1000&#10;WHEN    &apos;active_customers&apos;  THEN     [value_comparison]/1000&#10;WHEN    &apos;active_customers_qc&apos;  THEN     [value_comparison]/1000&#10;WHEN    &apos;acquisitions&apos;  THEN     [value_comparison]/1000&#10;WHEN    &apos;gmv_eur&apos;  THEN     [value_comparison]/1000&#10;WHEN    &apos;orders_aov&apos;  THEN     [value_comparison]&#10;WHEN    &apos;avg_delivery_time&apos;  THEN     [value_comparison]&#10;WHEN    &apos;nps_ao&apos;  THEN     [value_comparison]*100&#10;WHEN    &apos;logistics_index&apos; THEN [value_comparison]&#10;WHEN    &apos;frequency&apos; THEN [value_comparison]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='value_pct_lw' datatype='real' default-format='p0.0%' name='[Calculation_4800837264253386761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [metric_name]&#10;WHEN    &apos;sessions_cvr&apos;  THEN     [value_comparison]&#10;WHEN    &apos;orders_fail_rate&apos;  THEN     [value_comparison]&#10;WHEN    &apos;orders_higher_4over5_rate&apos;  THEN     [value_comparison]&#10;WHEN    &apos;delivery_fee_rate_afv_od&apos;  THEN     [value_comparison]&#10;WHEN    &apos;customer_fee_afv_rate_od&apos;  THEN     [value_comparison]&#10;WHEN    &apos;extreme_delay_orders_rate&apos;  THEN     [value_comparison]&#10;WHEN    &apos;seamless_orders_rate&apos;  THEN     [value_comparison]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Wow num' datatype='real' default-format='p0.0%' name='[Calculation_4800837264253476874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG([Calculation_4800837264253149190])/AVG([Calculation_4800837264253296648]))-1' />
            </column>
            <column caption='WoW ppt' datatype='real' default-format='n#,##0.0&quot;ppt&quot;;-#,##0.0&quot;ppt&quot;' name='[Calculation_4800837264253550603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG([Calculation_4800837264253227015])-AVG([Calculation_4800837264253386761]))*100' />
            </column>
            <column caption='is_wow_pos_num' datatype='string' name='[Calculation_4800837264253796365]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE MAX([metric_name])&#10;WHEN &apos;logistics_index&apos; THEN&#10;        IF &#10;        [Calculation_4800837264253476874]&lt;0&#10;        THEN &apos;Positive&apos;&#10;        ELSEIF [Calculation_4800837264253476874]&gt;0&#10;        THEN &apos;Negative&apos;&#10;        ELSE &apos;Notr&apos;&#10;        END&#10;WHEN  &apos;avg_delivery_time&apos;  THEN&#10;        IF &#10;        [Calculation_4800837264253476874]&lt;0&#10;        THEN &apos;Positive&apos;&#10;        ELSEIF [Calculation_4800837264253476874] &gt;0&#10;        THEN &apos;Negative&apos;&#10;        ELSE &apos;Notr&apos;&#10;        END&#10;&#10;WHEN  &apos;extreme_delay_orders_rate&apos;  THEN&#10;        IF &#10;        [Calculation_4800837264253476874]&lt;0&#10;        THEN &apos;Positive&apos;&#10;        ELSEIF [Calculation_4800837264253476874] &gt;0&#10;        THEN &apos;Negative&apos;&#10;        ELSE &apos;Notr&apos;&#10;        END&#10;&#10;ELSE &#10;        IF &#10;        [Calculation_4800837264253476874]&gt;0&#10;        THEN &apos;Positive&apos;&#10;        ELSEIF [Calculation_4800837264253476874] &lt;0&#10;        THEN &apos;Negative&apos;&#10;        ELSE &apos;Notr&apos;&#10;        END&#10;END' />
            </column>
            <column caption='is_wow_pos_pct' datatype='string' name='[Calculation_4800837264253874190]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE MAX([metric_name])&#10;&#10;WHEN &apos;orders_fail_rate&apos; THEN&#10;        IF &#10;        [Calculation_4800837264253550603]&lt;0&#10;        THEN &apos;Positive&apos;&#10;        ELSEIF [Calculation_4800837264253550603] &gt;0&#10;        THEN &apos;Negative&apos;&#10;        ELSE &apos;Notr&apos;&#10;        END&#10;WHEN  &apos;extreme_delay_orders_rate&apos;  THEN&#10;        IF &#10;        [Calculation_4800837264253550603]&lt;0&#10;        THEN &apos;Positive&apos;&#10;        ELSEIF [Calculation_4800837264253550603] &gt;0&#10;        THEN &apos;Negative&apos;&#10;        ELSE &apos;Notr&apos;&#10;        END&#10;&#10;ELSE&#10;        IF &#10;        [Calculation_4800837264253550603]&gt;0&#10;        THEN &apos;Positive&apos;&#10;        ELSEIF  [Calculation_4800837264253550603] &lt;0&#10;        THEN &apos;Negative&apos;&#10;        ELSE &apos;Notr&apos;&#10;        END&#10;END' />
            </column>
            <column caption='Metric Title' datatype='string' name='[Calculation_4800837264257228816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [metric_name]&#10;WHEN    &apos;sessions&apos;  THEN   &apos;Sessions (K)&apos;&#10;WHEN    &apos;sessions_cvr&apos;  THEN   &apos;CVR&apos;&#10;WHEN    &apos;orders_successful&apos;  THEN   &apos;Orders (K)&apos;&#10;WHEN    &apos;orders_fail_rate&apos;  THEN   &apos;Fail rate %&apos;&#10;WHEN    &apos;orders_higher_4over5_rate&apos;  THEN   &apos;4/5 rated orders %&apos;&#10;WHEN    &apos;active_customers&apos;  THEN   &apos;Active Customers (K)&apos;&#10;WHEN    &apos;active_customers_qc&apos;  THEN   &apos;QC Active Customers (K)&apos;&#10;WHEN    &apos;acquisitions&apos;  THEN   &apos;Acquisitions (K)&apos;&#10;WHEN    &apos;gmv_eur&apos;  THEN   &apos;GMV (K)&apos;&#10;WHEN    &apos;orders_aov&apos;  THEN   &apos;AOV&apos;&#10;WHEN    &apos;delivery_fee_rate_afv_od&apos;  THEN   &apos;DF as % of AFV&apos;&#10;WHEN    &apos;customer_fee_afv_rate_od&apos;  THEN   &apos;CF as % of AFV&apos;&#10;WHEN    &apos;avg_delivery_time&apos;  THEN   &apos;Delivery Time (min)&apos;&#10;WHEN    &apos;extreme_delay_orders_rate&apos;  THEN   &apos;Orders late &gt;10min %&apos;&#10;WHEN    &apos;seamless_orders_rate&apos;  THEN   &apos;Seamless Orders %&apos;&#10;WHEN    &apos;nps_ao&apos;  THEN   &apos;AO NPS&apos;&#10;WHEN    &apos;logistics_index&apos; THEN &apos;Logistics Index&apos;&#10;WHEN    &apos;frequency&apos; THEN &apos;Frequency&apos;&#10;END' />
            </column>
            <column caption='Metric Rank' datatype='real' name='[Calculation_4800837264258215954]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Calculation_4800837264257228816]&#10;&#10;WHEN  &apos;Sessions (K)&apos;  THEN  1&#10;WHEN  &apos;CVR&apos;  THEN  2&#10;WHEN  &apos;Orders (K)&apos;  THEN  3&#10;WHEN  &apos;AOV&apos;  THEN  4&#10;WHEN  &apos;GMV (K)&apos;  THEN  5&#10;WHEN  &apos;DF as % of AFV&apos;  THEN  6&#10;WHEN  &apos;CF as % of AFV&apos;  THEN  7&#10;WHEN  &apos;Acquisitions (K)&apos;  THEN  8&#10;WHEN  &apos;Active Customers (K)&apos;  THEN  9&#10;WHEN  &apos;QC Active Customers (K)&apos;  THEN  9.5&#10;WHEN  &apos;Frequency&apos; THEN 10&#10;WHEN  &apos;Fail rate %&apos;  THEN  11&#10;WHEN  &apos;Delivery Time (min)&apos;  THEN  12&#10;WHEN  &apos;Logistics Index&apos;  THEN  13&#10;WHEN  &apos;Seamless Orders %&apos;  THEN  14&#10;WHEN  &apos;Orders late &gt;10min %&apos;  THEN  15&#10;WHEN  &apos;4/5 rated orders %&apos;  THEN  16&#10;WHEN  &apos;AO NPS&apos;  THEN  17&#10;END' />
            </column>
