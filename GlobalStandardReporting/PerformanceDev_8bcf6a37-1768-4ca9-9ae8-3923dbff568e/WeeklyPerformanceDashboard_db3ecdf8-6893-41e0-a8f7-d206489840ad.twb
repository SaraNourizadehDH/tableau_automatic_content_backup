          <datasource-dependencies datasource='federated.0m1zu3a09ta8wp18u8q621rkmvba'>
            <column caption='attr' datatype='integer' name='[Calculation_2486127794698092547]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='Exclude Greece-Mena' datatype='boolean' name='[Calculation_2946620857246326784]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;([country_code]=&apos;GR&apos; AND [segment]=&apos;MENA&apos;) THEN TRUE &#10;ELSE FALSE &#10;END' />
            </column>
            <column caption='Countrycode-Metric' datatype='string' name='[Calculation_3352507724808916992]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_code]+&apos;-&apos;+[metric_name]' />
            </column>
            <column caption='Exclude nulls ' datatype='boolean' name='[Calculation_4679310391262748673]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    ISNULL(SUM([dh_comp_ratio])) AND ISNULL(SUM([dh_comp_ratio_lw])) THEN TRUE &#10;    ELSE FALSE &#10;    END' />
            </column>
            <column caption='WoW comparison' datatype='string' name='[Calculation_600667667026292736]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [dh_comp_ratio] &gt; [dh_comp_ratio_lw] THEN &apos;Positive&apos; &#10;ELSEIF [dh_comp_ratio] &lt; [dh_comp_ratio_lw] THEN &apos;Negative&apos;&#10;ELSE &apos;No change&apos;&#10;END' />
            </column>
            <column caption='Latest Top Competitor' datatype='string' name='[Calculation_6123347439521812483]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF NOT ISNULL(MAX([top_comp_name_latest_week])) THEN MAX([top_comp_name_latest_week]) ELSE MAX([top_comp_name]) END' />
            </column>
            <column caption='Exclude Oman-Instashop ' datatype='boolean' name='[Exclude Greece-Mena (copy)_2946620857247129601]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;([country_code]=&apos;OM&apos; AND [dh_brand]=&apos;InstaShop&apos;) THEN TRUE &#10;ELSE FALSE &#10;END' />
