            <column caption='is_wow_pos_pct' datatype='string' name='[is_wow_pos_num (copy)_1179309844795580431]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE MAX([metric_name])&#10;&#10;WHEN &apos;orders_fail_rate&apos; THEN&#10;        IF &#10;        [Calculation_1179309844706361350]&lt;0&#10;        THEN &apos;Positive&apos;&#10;        ELSEIF [Calculation_1179309844706361350] &gt;0&#10;        THEN &apos;Negative&apos;&#10;        ELSE &apos;Notr&apos;&#10;        END&#10;WHEN  &apos;extreme_delay_orders_rate&apos;  THEN&#10;        IF &#10;        [Calculation_1179309844706361350]&lt;0&#10;        THEN &apos;Positive&apos;&#10;        ELSEIF [Calculation_1179309844706361350] &gt;0&#10;        THEN &apos;Negative&apos;&#10;        ELSE &apos;Notr&apos;&#10;        END&#10;&#10;ELSE&#10;        IF &#10;        [Calculation_1179309844706361350]&gt;0&#10;        THEN &apos;Positive&apos;&#10;        ELSEIF  [Calculation_1179309844706361350] &lt;0&#10;        THEN &apos;Negative&apos;&#10;        ELSE &apos;Notr&apos;&#10;        END&#10;END' />
            </column>
