            <column caption='DH Brand' datatype='string' name='[dh_brand]' role='dimension' type='nominal' />
            <column caption='Dh Comp Ratio' datatype='real' default-format='n#,##0.0&quot;x&quot;;-#,##0.0&quot;x&quot;' name='[dh_comp_ratio]' role='measure' type='quantitative' />
            <column caption='Dh Comp Ratio Lw' datatype='real' name='[dh_comp_ratio_lw]' role='measure' type='quantitative' />
