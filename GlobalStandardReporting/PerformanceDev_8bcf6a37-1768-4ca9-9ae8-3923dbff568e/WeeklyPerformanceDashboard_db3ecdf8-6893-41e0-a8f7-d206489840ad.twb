            <column caption='Metric Rank' datatype='real' name='[Calculation_4800837264258215954]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Calculation_4800837264257228816]&#10;&#10;WHEN  &apos;Sessions (K)&apos;  THEN  1&#10;WHEN  &apos;CVR&apos;  THEN  2&#10;WHEN  &apos;Orders (K)&apos;  THEN  3&#10;WHEN  &apos;AOV&apos;  THEN  4&#10;WHEN  &apos;GMV (K)&apos;  THEN  5&#10;WHEN  &apos;DF as % of AFV&apos;  THEN  6&#10;WHEN  &apos;CF as % of AFV&apos;  THEN  7&#10;WHEN  &apos;Acquisitions (K)&apos;  THEN  8&#10;WHEN  &apos;Active Customers (K)&apos;  THEN  9&#10;WHEN  &apos;QC Active Customers (K)&apos;  THEN  9.5&#10;WHEN  &apos;Frequency&apos; THEN 10&#10;WHEN  &apos;Fail rate %&apos;  THEN  11&#10;WHEN  &apos;Delivery Time (min)&apos;  THEN  12&#10;WHEN  &apos;Logistics Index&apos;  THEN  13&#10;WHEN  &apos;Seamless Orders %&apos;  THEN  14&#10;WHEN  &apos;Orders late &gt;10min %&apos;  THEN  15&#10;WHEN  &apos;4/5 rated orders %&apos;  THEN  16&#10;WHEN  &apos;AO NPS&apos;  THEN  17&#10;END' />
