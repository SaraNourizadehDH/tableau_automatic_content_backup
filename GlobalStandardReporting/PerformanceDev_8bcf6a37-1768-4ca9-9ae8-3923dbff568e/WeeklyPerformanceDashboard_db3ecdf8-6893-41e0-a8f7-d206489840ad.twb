        <calculation class='tableau' formula='CASE MAX([metric_name])&#10;&#10;WHEN &apos;orders_fail_rate&apos; THEN&#10;        IF &#10;        [Calculation_6724929836658286600]&lt;0&#10;        THEN &apos;Positive&apos;&#10;        ELSEIF [Calculation_6724929836658286600] &gt;0&#10;        THEN &apos;Negative&apos;&#10;        ELSE &apos;Notr&apos;&#10;        END&#10;WHEN  &apos;extreme_delay_orders_rate&apos;  THEN&#10;        IF &#10;        [Calculation_6724929836658286600]&lt;0&#10;        THEN &apos;Positive&apos;&#10;        ELSEIF [Calculation_6724929836658286600] &gt;0&#10;        THEN &apos;Negative&apos;&#10;        ELSE &apos;Notr&apos;&#10;        END&#10;&#10;ELSE&#10;        IF &#10;        [Calculation_6724929836658286600]&gt;0&#10;        THEN &apos;Positive&apos;&#10;        ELSEIF  [Calculation_6724929836658286600] &lt;0&#10;        THEN &apos;Negative&apos;&#10;        ELSE &apos;Notr&apos;&#10;        END&#10;END' />
