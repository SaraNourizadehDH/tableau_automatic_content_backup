              <calculation class='tableau' formula='CASE [metric_name]&#10;WHEN    &apos;sessions&apos;  THEN   &apos;Sessions (K)&apos;&#10;WHEN    &apos;sessions_cvr&apos;  THEN   &apos;CVR&apos;&#10;WHEN    &apos;orders_successful&apos;  THEN   &apos;Orders (K)&apos;&#10;WHEN    &apos;orders_fail_rate&apos;  THEN   &apos;Fail rate %&apos;&#10;WHEN    &apos;orders_higher_4over5_rate&apos;  THEN   &apos;4/5 rated orders %&apos;&#10;WHEN    &apos;active_customers&apos;  THEN   &apos;Active Customers (K)&apos;&#10;WHEN    &apos;active_customers_qc&apos;  THEN   &apos;QC Active Customers (K)&apos;&#10;WHEN    &apos;acquisitions&apos;  THEN   &apos;Acquisitions (K)&apos;&#10;WHEN    &apos;gmv_eur&apos;  THEN   &apos;GMV (K)&apos;&#10;WHEN    &apos;orders_aov&apos;  THEN   &apos;AOV&apos;&#10;WHEN    &apos;delivery_fee_rate_afv_od&apos;  THEN   &apos;DF as % of AFV&apos;&#10;WHEN    &apos;customer_fee_afv_rate_od&apos;  THEN   &apos;CF as % of AFV&apos;&#10;WHEN    &apos;avg_delivery_time&apos;  THEN   &apos;Delivery Time (min)&apos;&#10;WHEN    &apos;extreme_delay_orders_rate&apos;  THEN   &apos;Orders late &gt;10min %&apos;&#10;WHEN    &apos;seamless_orders_rate&apos;  THEN   &apos;Seamless Orders %&apos;&#10;WHEN    &apos;nps_ao&apos;  THEN   &apos;AO NPS&apos;&#10;WHEN    &apos;logistics_index&apos; THEN &apos;Logistics Index&apos;&#10;WHEN    &apos;frequency&apos; THEN &apos;Frequency&apos;&#10;END' />
            </column>
