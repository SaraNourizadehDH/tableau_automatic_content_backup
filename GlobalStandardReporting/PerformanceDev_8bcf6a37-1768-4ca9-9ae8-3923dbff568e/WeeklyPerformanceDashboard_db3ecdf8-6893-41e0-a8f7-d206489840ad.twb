                  <zone h='7223' id='518' mode='checkdropdown' name='Group Total (2)' param='[federated.0tcyee016vgnku138dtn31486qih].[none:cw_report_week:nk]' type-v2='filter' values='database' w='13421' x='35000' y='9444'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
