      <column caption='Metric Name - Glovo Filter' datatype='string' name='[Metric Name (copy)_2473461423849857024]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[metric_name]' />
      </column>
      <column caption='WoW num' datatype='real' default-format='p0.0%' name='[WoW ppt (copy)_1179309844711378953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(AVG([value_2_pct (copy)_1179309844710420488])/AVG([value_num (copy)_1179309844711550986]))-1' />
      </column>
