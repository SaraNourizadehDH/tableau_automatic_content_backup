      <table>
        <view>
          <datasources>
            <datasource caption='weekly_performance_competition (cl_intl_markets)' name='federated.00z8tts0kuzyua1dmpm4z0l0e0ky' />
          </datasources>
          <datasource-dependencies datasource='federated.00z8tts0kuzyua1dmpm4z0l0e0ky'>
            <column caption='cnt_country' datatype='integer' name='[Calculation_2282480644085043200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([country_name])' />
            </column>
            <column caption='#of countries DH leading WAU' datatype='integer' name='[Calculation_2282480644088680451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [is_dh_leading_au] THEN [country_code] END)' />
            </column>
            <column caption='Exclude DK duplication' datatype='boolean' name='[Calculation_2838323354594529280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_code]=&apos;DK&apos; AND  ISNULL([global_entity_id]) THEN TRUE END' />
            </column>
            <column caption='Exclude Greece Mena' datatype='boolean' name='[Calculation_3311905008293171200]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;([country_code]=&apos;GR&apos; AND [segment]=&apos;MENA&apos;) THEN TRUE &#10;ELSE FALSE &#10;END' />
            </column>
            <column caption='Exclude nulls - D' datatype='boolean' name='[Exclude nulls - BI (copy)_4679310391265153027]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([d_dh_comp_ratio]) THEN TRUE&#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Total Country_d' datatype='integer' name='[Total Country_bi (copy)_6123347439520083970]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF NOT ISNULL([dh_downloads]) THEN [country_code] ELSE NULL END)' />
            </column>
            <column-instance column='[report_week]' derivation='Attribute' name='[attr:report_week:ok]' pivot='key' type='ordinal' />
            <column caption='#of countries DH leading BI' datatype='integer' name='[cnt_country_dh_leading_au (copy)_2282480644088901636]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [is_dh_leading_bi] THEN [country_code] END)' />
            </column>
            <column caption='#of countries DH leading D.' datatype='integer' name='[cnt_country_dh_leading_bi (copy)_2282480644088954885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( IF [is_dh_leading_downloads] THEN [country_code] END)' />
            </column>
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
