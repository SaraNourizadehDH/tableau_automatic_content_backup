            <column caption='Cw Report Week' datatype='string' name='[cw_report_week]' role='dimension' type='nominal' />
            <column caption='Iso Date' datatype='date' default-format='*dd.mm.yyyy' name='[iso_date]' role='dimension' type='ordinal' />
