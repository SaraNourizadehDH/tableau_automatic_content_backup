              <calculation class='tableau' formula='CASE [metric_name]&#10;WHEN    &apos;sessions&apos;  THEN     [value]/1000&#10;WHEN    &apos;orders_successful&apos;  THEN     [value]/1000&#10;WHEN    &apos;orders&apos;  THEN     [value]/1000&#10;WHEN    &apos;sessions_w_order&apos;  THEN     [value]/1000&#10;WHEN    &apos;active_customers&apos;  THEN     [value]/1000&#10;WHEN    &apos;active_customers_qc&apos;  THEN     [value]/1000&#10;WHEN    &apos;acquisitions&apos;  THEN     [value]/1000&#10;WHEN    &apos;gmv_eur&apos;  THEN     [value]/1000&#10;WHEN    &apos;orders_aov&apos;  THEN     [value]&#10;WHEN    &apos;avg_delivery_time&apos;  THEN     [value]&#10;WHEN    &apos;nps_ao&apos;  THEN     [value]*100&#10;WHEN    &apos;logistics_index&apos; THEN [value]&#10;WHEN    &apos;frequency&apos; THEN [value]&#10;ELSE NULL&#10;END' />
