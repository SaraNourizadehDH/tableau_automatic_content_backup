      <aliases enabled='yes' />
      <column caption='Share of Top 3 Product in GFV' datatype='real' name='[Calculation_1234197467407687680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(iif([item_rank] &lt; 4, [line_item_total], null))&#10;/&#10;SUM([line_item_total])' />
      </column>
      <column caption='username_check' datatype='boolean' name='[Calculation_4762204826516078592]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Item Unit Price' datatype='real' name='[Calculation_5524931634366959616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([line_item_total]) / sum([item_quantity])' />
      </column>
      <column caption='Share of Top 5 Product in GFV' datatype='real' name='[Share of Top 3 Product in GFV (copy)_1234197467408359425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(iif([item_rank] &lt; 6, [line_item_total], null))&#10;/&#10;SUM([line_item_total])' />
      </column>
