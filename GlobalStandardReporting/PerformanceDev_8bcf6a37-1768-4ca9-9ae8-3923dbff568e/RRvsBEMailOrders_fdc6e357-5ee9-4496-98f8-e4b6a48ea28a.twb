      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (acl_intl_markets)' name='federated.0yee7540z9lbyx1gnvyix1w4kheg' />
          </datasources>
          <datasource-dependencies datasource='federated.0yee7540z9lbyx1gnvyix1w4kheg'>
            <column caption='BE vs Actual Orders' datatype='real' default-format='p0.0%' name='[BE vs Actual GMV (copy)_619878324787838976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_be_prev_1]) / SUM([orders_act_prev_1]) - 1' />
            </column>
            <column caption='ATTR' datatype='integer' name='[Calculation_6541830355874918400]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='M - 1 Orders' datatype='string' name='[M - 1 (copy)_619878324791021572]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ABS([RR vs Actual GMV (copy)_619878324790710273]) &lt; ABS([BE vs Actual GMV (copy)_619878324787838976]) THEN &apos;RR&apos;&#10;ELSEIF ABS([BE vs Actual GMV (copy)_619878324787838976]) &lt; ABS([RR vs Actual GMV (copy)_619878324790710273]) THEN &apos;BE&apos;&#10;END' />
            </column>
            <column caption='M - 2 Orders' datatype='string' name='[M - 2 (copy)_619878324791021571]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;ABS(&#10;    (SUM([orders_rr_prev_2]) / SUM([orders_act_prev_2]) - 1) &#10;    ) &#10;&lt; &#10;ABS(&#10;    (SUM([orders_be_prev_2]) / SUM([orders_act_prev_2]) - 1)&#10;    ) THEN &apos;RR&apos;&#10;&#10;ELSEIF ABS(&#10;    (SUM([orders_be_prev_2]) / SUM([orders_act_prev_2]) - 1)&#10;    ) &#10;&lt; ABS(&#10;    (SUM([orders_rr_prev_2]) / SUM([orders_act_prev_2]) - 1)&#10;    ) THEN &apos;BE&apos;&#10;END' />
            </column>
            <column caption='M - 3 Orders' datatype='string' name='[M - 3 (copy)_619878324791021570]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;ABS(&#10;    (SUM([orders_rr_prev_3]) / SUM([orders_act_prev_3]) - 1) &#10;    ) &#10;&lt; &#10;ABS(&#10;    (SUM([orders_be_prev_3]) / SUM([orders_act_prev_3]) - 1)&#10;    ) THEN &apos;RR&apos;&#10;&#10;ELSEIF ABS(&#10;    (SUM([orders_be_prev_3]) / SUM([orders_act_prev_3]) - 1)&#10;    ) &#10;&lt; ABS(&#10;    (SUM([orders_rr_prev_3]) / SUM([orders_act_prev_3]) - 1)&#10;    ) THEN &apos;BE&apos;&#10;END' />
            </column>
            <column caption='M - 4 Orders' datatype='string' name='[M - 4 (copy)_619878324791021573]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#10;ABS(&#10;    (SUM([orders_rr_prev_4]) / SUM([orders_act_prev_4]) - 1) &#10;    ) &#10;&lt; &#10;ABS(&#10;    (SUM([orders_be_prev_4]) / SUM([orders_act_prev_4]) - 1)&#10;    ) THEN &apos;RR&apos;&#10;&#10;ELSEIF ABS(&#10;    (SUM([orders_be_prev_4]) / SUM([orders_act_prev_4]) - 1)&#10;    ) &#10;&lt; ABS(&#10;    (SUM([orders_rr_prev_4]) / SUM([orders_act_prev_4]) - 1)&#10;    ) THEN &apos;BE&apos;&#10;END' />
            </column>
            <column caption='RR vs Actual Orders' datatype='real' default-format='p0.0%' name='[RR vs Actual GMV (copy)_619878324790710273]' role='measure' type='quantitative'>
