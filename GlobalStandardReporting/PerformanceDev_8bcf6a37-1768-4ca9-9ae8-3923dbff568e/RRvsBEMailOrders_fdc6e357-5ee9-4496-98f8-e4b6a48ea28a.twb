      </filter>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_627F8415799E49B5B7862D5E51B974AD'>
            <properties context=''>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Custom SQL Query].[global_entity_id]' />
                    <expression op='[gsr_entitlements_performance_global_entity_id].[global_entity_id]' />
                  </expression>
                </clause>
                <relation connection='bigquery.0egwu9f06io1xi1gnw5iv1v4y9bd' name='Custom SQL Query' type='text'><![CDATA[/*
THIS MONTH = August 08
RR insert_date July 3rd, Report_Month 2024-07-01
BE 06, Report_Month = 2024-07-01
Actuals Report_Month = 2024-07-01

RR insert_date August LATEST, Report_Month 2024-08-01, 2024-09-01
*/


WITH historical_rr AS ( --RR insert_date July 3rd, Report_Month 2024-07-01
SELECT  
    global_entity_id, 
    DATE_TRUNC(CURRENT_DATE, MONTH) as reporting_month,
    DATE(insert_date) as rr_date,   
    DATE_TRUNC(order_date, MONTH) as order_month,
    SUM(orders)+SUM(COALESCE(orders_c2c,0)) orders_rr,
    SUM(gmv_eur)+SUM(COALESCE(gmv_c2c_eur,0)) as gmv_eur_rr
FROM  `fulfillment-dwh-production.cl_intl_markets.historical_runrates` r
WHERE EXTRACT(day FROM insert_date) = 3
  AND DATE_TRUNC(insert_date, MONTH) = DATE_TRUNC(order_date, MONTH) 
  AND DATE_TRUNC(insert_date, MONTH) >> DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH), MONTH)
  AND DATE_TRUNC(insert_date, MONTH) << DATE_TRUNC(CURRENT_DATE, MONTH)
GROUP BY 1,2,3,4
ORDER BY 1,2,3,4
),
historical_be AS ( 
SELECT   
  be.global_entity_id,
  be_version as be_version_str,
  CAST(SPLIT(be_version, 'Best Estimate ')[offset(1)] AS INT) as be_version,
  target_month as order_month,
  EXTRACT(ISOYEAR FROM (DATE_ADD(target_month, INTERVAL -1 MONTH)))*100 + EXTRACT(MONTH FROM (DATE_ADD(target_month, INTERVAL -1 MONTH))) AS yearmonth_1,
  EXTRACT(ISOYEAR FROM (DATE_ADD(target_month, INTERVAL -2 MONTH)))*100 + EXTRACT(MONTH FROM (DATE_ADD(target_month, INTERVAL -2 MONTH))) AS yearmonth_2,
  SUM(successful_orders) as orders_be_history,
  SUM(amt_gmv_eur) as gmv_eur_be_history,
FROM  `fulfillment-dwh-production.cl_intl_markets.lucanet_be_historical` be
WHERE 
  target_month >> DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH), MONTH)
  AND target_month << DATE_TRUNC(CURRENT_DATE, MONTH)
GROUP BY 1,2,3,4
ORDER BY 1,2,3
),
be_1 AS (
SELECT * 
FROM historical_be
WHERE be_version = yearmonth_1
),
be_2 AS (
SELECT * 
FROM historical_be
WHERE be_version = yearmonth_2
),
targets as (
SELECT  
    bud.global_entity_id,
    target_month as order_month,
    SUM(successful_orders) as orders_target,
    SUM(amt_gmv_eur) as gmv_eur_target,
FROM `fulfillment-dwh-production.cl_intl_markets.lucanet_targets` bud
WHERE target_month >> DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -6 MONTH), MONTH)
  AND target_month << DATE_TRUNC(CURRENT_DATE, MONTH)
GROUP BY 1,2
ORDER BY 1,2
),
actuals_wo_c2c as (
SELECT
global_entity_id,
DATE_TRUNC(placed_date_local, MONTH) as order_month,
SUM(successful_orders ) as orders_act,
SUM(value.gmv_eur) as gmv_eur_act
FROM `fulfillment-dwh-production.curated_data_shared_coredata_business.agg_orders_daily` 
WHERE 
  DATE_TRUNC(placed_date_local, MONTH) << DATE_TRUNC(CURRENT_DATE, MONTH) 
  AND DATE_TRUNC(placed_date_local, MONTH) >>=  DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL -12 MONTH), MONTH)
GROUP BY 1,2
),
future_latest_rr AS ( 
SELECT  
    global_entity_id, 
    DATE(insert_date) as insert_date_latest,   
    DATE_TRUNC(order_date, MONTH) as order_month,
    SUM(orders)+SUM(COALESCE(orders_c2c,0)) orders_rr_latest,
    SUM(gmv_eur)+SUM(COALESCE(gmv_c2c_eur,0)) as gmv_eur_rr_latest
FROM  `fulfillment-dwh-production.cl_intl_markets.historical_runrates` r
WHERE DATE_TRUNC(order_date,MONTH) >>= DATE_TRUNC(CURRENT_DATE, MONTH)
AND DATE_TRUNC(order_date,MONTH) << DATE_TRUNC(DATE_ADD(CURRENT_DATE, INTERVAL 3 MONTH), MONTH)
AND DATE(insert_date) = (SELECT MAX(DATE(insert_date)) FROM `fulfillment-dwh-production.cl_intl_markets.historical_runrates` )
GROUP BY 1,2,3
ORDER BY 1,2,3
),
main_df as (

SELECT 
rr_hist.global_entity_id,
rr_hist.reporting_month,
rr_hist.rr_date,
rr_hist.order_month as order_month,

rr_hist.orders_rr,	
COALESCE(be_1.orders_be_history,be_2.orders_be_history,orders_target) as orders_be,
orders_act,

rr_hist.gmv_eur_rr,
COALESCE(be_1.gmv_eur_be_history,be_2.gmv_eur_be_history,gmv_eur_target) as gmv_eur_be,
gmv_eur_act,

COALESCE(be_1.be_version_str,be_2.be_version_str,'Target') as be_version,
FROM historical_rr rr_hist
LEFT JOIN be_1 
  ON rr_hist.global_entity_id = be_1.global_entity_id
  AND rr_hist.order_month = be_1.order_month
LEFT JOIN be_2
  ON rr_hist.global_entity_id = be_2.global_entity_id
  AND rr_hist.order_month = be_2.order_month  
LEFT JOIN targets trg
  ON rr_hist.global_entity_id = trg.global_entity_id
  AND rr_hist.order_month = trg.order_month    
LEFT JOIN actuals_wo_c2c act
  ON rr_hist.global_entity_id = act.global_entity_id
  AND rr_hist.order_month = act.order_month    

), construct AS(
SELECT 
DISTINCT global_entity_id,reporting_month, sub_entity, management_entity, segment
FROM main_df
INNER JOIN `fulfillment-dwh-production.curated_data_shared_coredata.global_entities` USING(global_entity_id)
WHERE is_reporting_enabled
)
SELECT 
c.global_entity_id,
c.reporting_month,
c.sub_entity, 
c.management_entity, 
c.segment,
prev_1.rr_date as rr_date_prev_1,
prev_1.order_month as order_month_prev_1,
prev_1.orders_rr as orders_rr_prev_1,
prev_1.orders_be as orders_be_prev_1,
prev_1.orders_act as orders_act_prev_1,
prev_1.gmv_eur_rr as gmv_eur_rr_prev_1,
prev_1.gmv_eur_be as gmv_eur_be_prev_1,
prev_1.gmv_eur_act as gmv_eur_act_prev_1,
prev_1.be_version as be_version_prev_1,

prev_2.rr_date as rr_date_prev_2,
prev_2.order_month as order_month_prev_2,
prev_2.orders_rr as orders_rr_prev_2,
prev_2.orders_be as orders_be_prev_2,
prev_2.orders_act as orders_act_prev_2,
prev_2.gmv_eur_rr as gmv_eur_rr_prev_2,
prev_2.gmv_eur_be as gmv_eur_be_prev_2,
prev_2.gmv_eur_act as gmv_eur_act_prev_2,
prev_2.be_version as be_version_prev_2,

prev_3.rr_date as rr_date_prev_3,
prev_3.order_month as order_month_prev_3,
prev_3.orders_rr as orders_rr_prev_3,
prev_3.orders_be as orders_be_prev_3,
prev_3.orders_act as orders_act_prev_3,
prev_3.gmv_eur_rr as gmv_eur_rr_prev_3,
prev_3.gmv_eur_be as gmv_eur_be_prev_3,
prev_3.gmv_eur_act as gmv_eur_act_prev_3,
prev_3.be_version as be_version_prev_3,


prev_4.rr_date as rr_date_prev_4,
prev_4.order_month as order_month_prev_4,
prev_4.orders_rr as orders_rr_prev_4,
prev_4.orders_be as orders_be_prev_4,
prev_4.orders_act as orders_act_prev_4,
prev_4.gmv_eur_rr as gmv_eur_rr_prev_4,
prev_4.gmv_eur_be as gmv_eur_be_prev_4,
prev_4.gmv_eur_act as gmv_eur_act_prev_4,
prev_4.be_version as be_version_prev_4,

rrl_1.insert_date_latest,
rrl_1.orders_rr_latest as orders_rr_current,
rrl_1.gmv_eur_rr_latest as gmv_eur_rr_current,
rrl_2.orders_rr_latest as orders_rr_next,
rrl_2.gmv_eur_rr_latest as gmv_eur_rr_next,
rrl_2.order_month as order_month_next


FROM construct c

LEFT JOIN main_df prev_1
  ON c.global_entity_id = prev_1.global_entity_id
  AND c.reporting_month = DATE_ADD(prev_1.order_month,INTERVAL 1 MONTH) 

LEFT JOIN main_df prev_2 
  ON c.global_entity_id = prev_2.global_entity_id
  AND c.reporting_month = DATE_ADD(prev_2.order_month,INTERVAL 2 MONTH) 

LEFT JOIN main_df prev_3 
  ON c.global_entity_id = prev_3.global_entity_id
  AND c.reporting_month = DATE_ADD(prev_3.order_month,INTERVAL 3 MONTH) 

LEFT JOIN main_df prev_4
  ON c.global_entity_id = prev_4.global_entity_id
  AND c.reporting_month = DATE_ADD(prev_4.order_month,INTERVAL 4 MONTH)

LEFT JOIN future_latest_rr rrl_1
  ON c.global_entity_id = rrl_1.global_entity_id
  AND c.reporting_month = rrl_1.order_month   

LEFT JOIN future_latest_rr rrl_2
  ON c.global_entity_id = rrl_2.global_entity_id
  AND c.reporting_month = DATE_ADD(rrl_2.order_month,INTERVAL -1 MONTH) 
 
ORDER BY 1,2]]></relation>
                <relation connection='bigquery.0egwu9f06io1xi1gnw5iv1v4y9bd' name='gsr_entitlements_performance_global_entity_id' table='[fulfillment-dwh-production.cl_intl_markets].[gsr_entitlements_performance_global_entity_id]' type='table' />
              </relation>
            </properties>
