      </column>
      <column caption='Rank Active Freq' datatype='integer' name='[Calculation_5752433761348333571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(SUM([active_frequency]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
