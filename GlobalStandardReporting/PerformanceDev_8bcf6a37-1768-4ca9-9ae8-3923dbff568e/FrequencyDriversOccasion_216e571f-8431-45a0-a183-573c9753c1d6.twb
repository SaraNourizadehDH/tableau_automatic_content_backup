      <column caption='Perc Active Freq YoY (PP)' datatype='real' default-format='c#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Calculation_5752433761312739328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([perc_active_freq] -[perc_active_freq_yoy])*100' />
      </column>
      <column caption='Active Frequency YoY (%)' datatype='real' default-format='p0.00%' name='[Calculation_5752433761331220481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([active_frequency] / [active_frequency_yoy]) - 1' />
      </column>
      <column caption='Active Frequency Base YoY (%)' datatype='real' default-format='p0.00%' name='[Calculation_5752433761332609026]' role='measure' type='quantitative'>
