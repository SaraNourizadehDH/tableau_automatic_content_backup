      <aliases enabled='yes' />
      <column caption='Short Month' datatype='string' name='[Calculation_2799479763728957440]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(DATENAME(&apos;month&apos;, [report_month]), 3) + &quot;&apos;&quot; + RIGHT(STR(YEAR([report_month])), 2)' />
      </column>
      <column caption='Q3&apos;24 Data' datatype='real' name='[Calculation_2799479763732946945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MONTH([report_month]) IN (7,8,9) AND YEAR([report_month]) = 2024 THEN [category_share]&#10;END' />
      </column>
      <column caption='Q3&apos;24 Avg' datatype='real' name='[Calculation_2799479763733684227]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF MONTH([report_month]) IN (7, 8, 9) AND YEAR([report_month]) = 2024 THEN [category_share] END)' />
      </column>
      <column caption='Q3&apos;24 Avg (Fixed)' datatype='real' name='[Calculation_2799479763737149444]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [sub_entity]: &#10;  AVG(IF MONTH([report_month]) IN (7, 8, 9) AND YEAR([report_month]) = 2024 THEN [category_share] END)&#10;}' />
      </column>
      <column caption='Countries' datatype='integer' name='[Calculation_3718354824811589632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([sub_entity])' />
      </column>
      <column caption='categorisation rank' datatype='integer' name='[Calculation_3718354824813105153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [current_categorisation]&#10;WHEN &apos;Very strong leadership&apos; THEN 1&#10;WHEN &apos;Strong Leadership&apos; THEN 2&#10;WHEN &apos;Leadership&apos; THEN 3&#10;WHEN &apos;Head to Head&apos; THEN 4&#10;WHEN &apos;Lagging&apos; THEN 5&#10;ELSE 6&#10;END' />
      </column>
      <column caption='Sub Entity Competitor Color' datatype='string' name='[Calculation_3718354824818962434]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [current_momentum] = &quot;Bad&quot; THEN &quot;Red&quot;&#10;ELSEIF [current_momentum] = &quot;Good&quot; THEN &quot;Green&quot;&#10;ELSE &quot;No Color&quot;&#10;END' />
      </column>
      <column caption='Sub Entity - Competitor' datatype='string' name='[Calculation_3718354824820658179]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[sub_entity] + &apos;-&apos; + [top_competitor]' />
      </column>
      <column caption='Text Color for Sub Entity Competitor' datatype='string' name='[Calculation_3718354824823857156]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [current_momentum] = &quot;Bad&quot; THEN &quot;Red&quot;&#10;ELSEIF [current_momentum] = &quot;Good&quot; THEN &quot;Green&quot;&#10;ELSE &quot;No Color&quot;&#10;END' />
      </column>
      <column caption='ATTR' datatype='integer' name='[Calculation_4174485025275133952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ATTR(1)' />
      </column>
      <column caption='Placeholder' datatype='string' name='[Calculation_6291247218630176768]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_6291247218642759681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ATTR(1)' />
      </column>
      <column caption='Current categorisation color' datatype='string' name='[Calculation_6291247218653024259]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [current_categorisation] = &quot;Very strong leadership&quot; THEN &quot;&lt;font color=&apos;purple&apos;&gt;Very strong leadership&lt;/font&gt;&quot;&#10;ELSEIF [current_categorisation] = &quot;Strong leadership&quot; THEN &quot;&lt;font color=&apos;teal&apos;&gt;Strong leadership&lt;/font&gt;&quot;&#10;ELSEIF [current_categorisation] = &quot;Leadership&quot; THEN &quot;&lt;font color=&apos;green&apos;&gt;Leadership&lt;/font&gt;&quot;&#10;ELSEIF [current_categorisation] = &quot;Head to head&quot; THEN &quot;&lt;font color=&apos;orange&apos;&gt;Head to head&lt;/font&gt;&quot;&#10;ELSEIF [current_categorisation] = &quot;Lagging&quot; THEN &quot;&lt;font color=&apos;red&apos;&gt;Lagging&lt;/font&gt;&quot;&#10;ELSE [current_categorisation]&#10;END' />
      </column>
      <column caption='Current Categorisation Dummy' datatype='string' name='[Calculation_6291247218657304580]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[current_categorisation]' />
      </column>
      <column caption='Q3&apos;24 avg' datatype='real' name='[Q3_24_avg_category_share]' role='measure' type='quantitative' />
