          <relation connection='bigquery.1hagmfp0t4qyx3135dpge15eyvkd' name='Custom SQL Query' type='text'><![CDATA[--main cuisine
WITH vendor_cuisine AS (
 SELECT
        c.global_entity_id,
        c.vendor_id,
        m.category_name_english AS category_name_english,
        m.category_group_global category_group_global,
        ROW_NUMBER() OVER (PARTITION BY c.global_entity_id, c.vendor_id) as rn
    FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.vendors` c
    LEFT JOIN UNNEST (c.categories) m on m.is_main_category IS TRUE
),

city_view AS(

SELECT 
    vkpim.global_entity_id
  , v.location.city as city
  , e.segment AS segment
  , e.management_entity AS management_entity
  , e.sub_entity as sub_entity
  , vkpim.report_month
  , v_c.category_group_global AS category_group_global
  , v_c.category_name_english
  , vd.key_account_category
  , COUNT(DISTINCT CASE WHEN vkpim.is_online IS TRUE THEN vkpim.vendor_id END) AS vendors_online
  , SUM(value.gbv_eur) AS gbv
  , SUM(successful_orders) AS orders
FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.agg_vendor_kpis_monthly` AS vkpim
LEFT JOIN vendor_cuisine   v_c
   ON vkpim.global_entity_id = v_c.global_entity_id
  AND	vkpim.vendor_id	= v_c.vendor_id
  AND v_c.rn = 1
INNER JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` AS e
  ON vkpim.global_entity_id = e.global_entity_id
  AND	e.is_platform_online IS TRUE
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.vendors`  v ON v.global_entity_id = vkpim.global_entity_id AND v.vendor_id = vkpim.vendor_id
LEFT JOIN `fulfillment-dwh-production.cl_intl_markets.vendor_dimensions` vd ON vd.global_entity_id = vkpim.global_entity_id AND vd.vendor_id = vkpim.vendor_id
WHERE report_month >>= DATE_ADD(DATE_TRUNC(CURRENT_DATE(),MONTH), INTERVAL - 6 MONTH)
AND report_month <<  DATE_TRUNC(CURRENT_DATE(),MONTH)
GROUP BY 1,2,3,4,5,6,7,8,9
),

country_view AS

(
SELECT 
    vkpim.global_entity_id
  , CONCAT('Entity - ', e.sub_entity) as city
  , e.segment AS segment
  , e.management_entity AS management_entity
  , e.sub_entity as sub_entity
  , vkpim.report_month
  , v_c.category_group_global AS category_group_global
  , v_c.category_name_english
  , vd.key_account_category
  , COUNT(DISTINCT CASE WHEN vkpim.is_online IS TRUE THEN vkpim.vendor_id END) AS vendors_online
  , SUM(value.gbv_eur) AS gbv
  , SUM(successful_orders) AS orders,
FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.agg_vendor_kpis_monthly` AS vkpim
LEFT JOIN vendor_cuisine   v_c
   ON vkpim.global_entity_id = v_c.global_entity_id
  AND	vkpim.vendor_id	= v_c.vendor_id
  AND v_c.rn = 1
INNER JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` AS e
  ON vkpim.global_entity_id = e.global_entity_id
  AND	e.is_platform_online IS TRUE
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.vendors`  v ON v.global_entity_id = vkpim.global_entity_id AND v.vendor_id = vkpim.vendor_id
LEFT JOIN `fulfillment-dwh-production.cl_intl_markets.vendor_dimensions` vd ON vd.global_entity_id = vkpim.global_entity_id AND vd.vendor_id = vkpim.vendor_id
WHERE report_month >>= DATE_ADD(DATE_TRUNC(CURRENT_DATE(),MONTH), INTERVAL -6 MONTH)
AND report_month <<  DATE_TRUNC(CURRENT_DATE(),MONTH)
GROUP BY 1,2,3,4,5,6,7,8,9


)
SELECT * 
FROM city_view
UNION ALL
SELECT * 
FROM country_view]]></relation>
