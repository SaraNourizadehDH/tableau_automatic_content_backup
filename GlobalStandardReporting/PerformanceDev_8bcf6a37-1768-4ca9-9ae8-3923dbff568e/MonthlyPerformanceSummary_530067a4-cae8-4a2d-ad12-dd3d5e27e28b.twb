      <table>
        <view>
          <datasources>
            <datasource caption='monthly_performance_email_report_dh (cl_intl_markets)' name='federated.1lgglwz0gt85qa1g0900k1piruz9' />
          </datasources>
          <datasource-dependencies datasource='federated.1lgglwz0gt85qa1g0900k1piruz9'>
            <column caption='L6M' datatype='boolean' name='[Calculation_4733142507334287363]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_month], {MAX([report_month])}) &lt;= 5' />
            </column>
            <column caption='percent' datatype='string' name='[Calculation_639792655681626114]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [metric_name] in  (&#10;&apos;sessions_cvr&apos;,&apos;seamless_order_share&apos;,&apos;failed_orders_share&apos;,&apos;markup_rate&apos;,&apos;customer_contact_rate&apos;,&apos;pp_gmv_share&apos;,&apos;ka_gap&apos;,&apos;active_customers_qc_share&apos;,&apos;subs_gmv_share&apos;,&apos;dm_availability_score&apos;&#10;) THEN &apos;%&apos;&#10;ELSE &apos;&apos; END' />
            </column>
            <column-instance column='[Calculation_639792655681626114]' derivation='Attribute' name='[attr:Calculation_639792655681626114:nk]' pivot='key' type='nominal' />
            <column caption='Metric Name' datatype='string' name='[metric_name]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;acquisitions&quot;' value='Acquisitions' />
