            <column caption='percent / pp' datatype='string' name='[percent (copy)_4733142507573424132]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [metric_name] IN (&#10;    &apos;sessions_cvr&apos;, &apos;seamless_order_share&apos;, &apos;failed_orders_share&apos;, &#10;    &apos;markup_rate&apos;, &apos;customer_contact_rate&apos;, &apos;pp_gmv_share&apos;, &#10;    &apos;ka_gap&apos;, &apos;active_customers_qc_share&apos;, &apos;subs_gmv_share&apos;, &#10;    &apos;dm_availability_score&apos;&#10;) &#10;AND NOT ISNULL([value_YoY]) THEN &apos;pp&apos;&#10;&#10;ELSE&#10;    IF NOT [metric_name] IN (&#10;        &apos;sessions_cvr&apos;, &apos;seamless_order_share&apos;, &apos;failed_orders_share&apos;, &#10;        &apos;markup_rate&apos;, &apos;customer_contact_rate&apos;, &apos;pp_gmv_share&apos;, &#10;        &apos;ka_gap&apos;, &apos;active_customers_qc_share&apos;, &apos;subs_gmv_share&apos;, &#10;        &apos;dm_availability_score&apos;&#10;    )&#10;    AND NOT ISNULL([value_YoY]) THEN &apos;%&apos;&#10;&#10;    ELSE &apos;&apos;&#10;    END&#10;END' />
            </column>
            <column caption='Report Month' datatype='date' default-format='*MMMM-YY' name='[report_month]' role='dimension' type='ordinal' />
