          <datasource-dependencies datasource='federated.1lgglwz0gt85qa1g0900k1piruz9'>
            <column caption='value YoY color' datatype='real' name='[Calculation_4010033292460044288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [metric_name] in (&apos;failed_orders_share&apos;,&apos;avg_delivery_time&apos;)&#10;THEN [value_YoY]*-1 ELSE [value_YoY] END' />
            </column>
            <column caption='max month' datatype='boolean' name='[Calculation_4733142507333459968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEPART(&apos;month&apos;, [report_month]) = DATEPART(&apos;month&apos;, {MAX([report_month])}) AND&#10;DATEPART(&apos;year&apos;, [report_month]) = DATEPART(&apos;year&apos;, {MAX([report_month])})' />
            </column>
            <column caption='Value - Decimal ' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5551953216306569218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [metric_name] in  (&#10;&apos;sessions_cvr&apos;,&apos;seamless_order_share&apos;,&#10;&apos;failed_orders_share&apos;,&#10;&apos;markup_rate&apos;,&apos;customer_contact_rate&apos;,&#10;&apos;pp_gmv_share&apos;,&apos;ka_gap&apos;,&apos;active_customers_qc_share&apos;,&#10;&apos;subs_gmv_share&apos;,&apos;dm_availability_score&apos;,&apos;avg_delivery_time&apos;&#10;) THEN [value] ELSE NULL END' />
            </column>
            <column caption='percent' datatype='string' name='[Calculation_639792655681626114]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [metric_name] in  (&#10;&apos;sessions_cvr&apos;,&apos;seamless_order_share&apos;,&apos;failed_orders_share&apos;,&apos;markup_rate&apos;,&apos;customer_contact_rate&apos;,&apos;pp_gmv_share&apos;,&apos;ka_gap&apos;,&apos;active_customers_qc_share&apos;,&apos;subs_gmv_share&apos;,&apos;dm_availability_score&apos;&#10;) THEN &apos;%&apos;&#10;ELSE &apos;&apos; END' />
            </column>
            <column caption='Value - Actual' datatype='real' default-format='n#,##0;-#,##0' name='[Value - Decimal  (copy)_5551953216307261444]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [metric_name] in  (&#10;&apos;sessions_cvr&apos;,&apos;seamless_order_share&apos;,&#10;&apos;failed_orders_share&apos;,&#10;&apos;markup_rate&apos;,&apos;customer_contact_rate&apos;,&#10;&apos;pp_gmv_share&apos;,&apos;ka_gap&apos;,&apos;active_customers_qc_share&apos;,&#10;&apos;subs_gmv_share&apos;,&apos;dm_availability_score&apos;,&apos;avg_delivery_time&apos;&#10;) THEN NULL ELSE [value] END' />
