      <column caption='&lt;2.7 Aff IndexQC' datatype='string' name='[&lt;2.7 Aff Index (copy)_357825086531600389]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF (([avg_unit_price]*[confirmed_orders])/[confirmed_orders])/[meal_food_basket_cost_lc]/[qc_index]*100 &lt;2.7 THEN [vendor_id] ELSE NULL END' />
      </column>
      <column caption='&lt;2.7 Aff Index Products' datatype='string' name='[&lt;2.7 Aff Index (copy)_6913658766666747913]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF (([avg_unit_price]*[confirmed_orders])/[confirmed_orders])/[meal_food_basket_cost_lc]/[qc_index]*100 &lt;2.7 THEN [id] ELSE NULL END' />
      </column>
      <column caption='&lt;2.7 Aff Index Products qc' datatype='string' name='[&lt;2.7 Aff Index Products (copy)_357825086531600388]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF (([avg_unit_price]*[confirmed_orders])/[confirmed_orders])/[meal_food_basket_cost_lc]/[qc_index]*100 &lt;2.7 THEN [id] ELSE NULL END' />
      </column>
      <column caption='Aff Index Buckets QC' datatype='string' name='[Aff Index Buckets (copy)_357825086536925196]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [Calculation_1199787111362129923] &lt;= 1 THEN &apos;0-1&apos;&#10;ELSEIF [Calculation_1199787111362129923] &gt; 1 AND [Calculation_1199787111362129923] &lt;= 2 THEN &apos;1-2x&apos;&#10;ELSEIF [Calculation_1199787111362129923] &gt; 2 AND [Calculation_1199787111362129923] &lt;= 3 THEN  &apos;2-3x&apos;&#10;ELSEIF [Calculation_1199787111362129923] &gt; 3 AND [Calculation_1199787111362129923] &lt;= 4 THEN  &apos;3-4x&apos;&#10;ELSEIF [Calculation_1199787111362129923] &gt; 4 AND [Calculation_1199787111362129923] &lt;= 5 THEN   &apos;5-6x&apos;&#10;ELSEIF [Calculation_1199787111362129923] &gt; 5 AND [Calculation_1199787111362129923] &lt;= 6 THEN  &apos;7-8x&apos;&#10;ELSE &apos;8x +&apos; END' />
      </column>
      <column caption='Aff Index Buckets count' datatype='integer' name='[Aff Index Buckets (copy)_6913658766661169156]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='If AVG([food_basket_index]) &lt;= 1 THEN COUNT([vendor_id])&#10;ELSEIF AVG([food_basket_index]) &gt; 1 AND AVG([food_basket_index]) &lt;= 2 THEN COUNT([vendor_id])&#10;ELSEIF AVG([food_basket_index]) &gt; 2 AND AVG([food_basket_index]) &lt;= 3 THEN  COUNT([vendor_id])&#10;ELSEIF AVG([food_basket_index]) &gt; 3 AND AVG([food_basket_index]) &lt;= 4 THEN  COUNT([vendor_id])&#10;ELSEIF AVG([food_basket_index]) &gt; 4 AND AVG([food_basket_index]) &lt;= 5 THEN  COUNT([vendor_id])&#10;ELSEIF AVG([food_basket_index]) &gt; 5 AND AVG([food_basket_index]) &lt;= 6 THEN  COUNT([vendor_id])&#10;ELSE COUNT([vendor_id]) END' />
      </column>
      <column caption='Affordability Index ' datatype='real' name='[Affordability Index QC (copy)_1199787111356616706]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1199787111351414784]/AVG([meal_food_basket_cost_lc])' />
      </column>
      <column caption='Main Dish Avg. Weighted' datatype='real' name='[Calculation_1199787111351414784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([avg_unit_price]*[confirmed_orders])/SUM([confirmed_orders])' />
      </column>
      <column caption='Affordability Index QC' datatype='real' name='[Calculation_1199787111355981825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1199787111351414784]/(AVG([meal_food_basket_cost_lc])/AVG([qc_index])*100)' />
      </column>
      <column caption='Food Basket Index 1 QC' datatype='real' name='[Calculation_1199787111362129923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([avg_unit_price]*[confirmed_orders])/[confirmed_orders])/[meal_food_basket_cost_lc]/[qc_index]*100' />
      </column>
      <column caption='Food Basket Index 1 no QC' datatype='real' name='[Calculation_1199787111362162692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([avg_unit_price]*[confirmed_orders])/[confirmed_orders])/[meal_food_basket_cost_lc]' />
      </column>
      <column caption='Food Basket index qc' datatype='real' name='[Calculation_357825086527918081]' role='measure' type='quantitative'>
