      <column caption='QC Index Prices Filter' datatype='string' name='[Calculation_357825086529097731]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='Home Cooked Meals / QC Price Indes' datatype='real' name='[Calculation_6913658766638555136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([meal_food_basket_cost_lc]) / AVG([qc_index]) *100' />
