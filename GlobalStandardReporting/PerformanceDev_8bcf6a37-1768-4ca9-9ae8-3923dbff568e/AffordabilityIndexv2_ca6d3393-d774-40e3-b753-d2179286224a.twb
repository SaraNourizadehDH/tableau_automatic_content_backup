      </column>
      <column caption='Meal Food Basket Cost QC' datatype='real' name='[Calculation_357825086528196610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[meal_food_basket_cost_lc]/[qc_index] * 100' />
