                <zone fixed-size='59' h='1283' id='121' is-fixed='true' param='horz' type-v2='layout-flow' w='98934' x='533' y='98543'>
                  <zone fixed-size='623' forceUpdate='true' h='1283' id='120' is-fixed='true' type-v2='text' w='42066' x='533' y='98543'>
                    <formatted-text>
                      <run fontcolor='#555555' italic='true'>-Rank shows the performance of weeks. L7-10W shows the average performance between W-7 and W-10.</run>
                      <run>Æ&#10;</run>
                      <run fontcolor='#555555' italic='true'>-Countries with an * are focus countries.</run>
