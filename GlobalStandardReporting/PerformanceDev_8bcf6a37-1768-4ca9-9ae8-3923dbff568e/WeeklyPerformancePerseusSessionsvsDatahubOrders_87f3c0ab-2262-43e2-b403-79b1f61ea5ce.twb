      <column caption='is_wow_pos_num' datatype='string' name='[Calculation_6724929836658384905]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [metric_name]&#10;WHEN &apos;logistics_index&apos; THEN&#10;        IF &#10;        [value_wow_pct]&lt;0&#10;        THEN &apos;Positive&apos;&#10;        ELSEIF [value_wow_pct] &gt;0&#10;        THEN &apos;Negative&apos;&#10;        ELSE &apos;Notr&apos;&#10;        END&#10;WHEN  &apos;avg_delivery_time&apos;  THEN&#10;        IF &#10;        [value_wow_pct]&lt;0&#10;        THEN &apos;Positive&apos;&#10;        ELSEIF [value_wow_pct] &gt;0&#10;        THEN &apos;Negative&apos;&#10;        ELSE &apos;Notr&apos;&#10;        END&#10;&#10;WHEN  &apos;extreme_delay_orders_rate&apos;  THEN&#10;        IF &#10;        [value_wow_pct]&lt;0&#10;        THEN &apos;Positive&apos;&#10;        ELSEIF [value_wow_pct] &gt;0&#10;        THEN &apos;Negative&apos;&#10;        ELSE &apos;Notr&apos;&#10;        END&#10;&#10;ELSE &#10;        IF &#10;        [value_wow_pct]&gt;0&#10;        THEN &apos;Positive&apos;&#10;        ELSEIF [value_wow_pct] &lt;0&#10;        THEN &apos;Negative&apos;&#10;        ELSE &apos;Notr&apos;&#10;        END&#10;END' />
      </column>
      <column caption='is_wow_pos_pct' datatype='string' name='[Calculation_6724929836658454538]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [metric_name]&#10;&#10;WHEN &apos;orders_fail_rate&apos; THEN&#10;        IF &#10;        [value_wow_pct]&lt;0&#10;        THEN &apos;Positive&apos;&#10;        ELSEIF [value_wow_pct] &gt;0&#10;        THEN &apos;Negative&apos;&#10;        ELSE &apos;Notr&apos;&#10;        END&#10;WHEN  &apos;extreme_delay_orders_rate&apos;  THEN&#10;        IF &#10;        [value_wow_pct]&lt;0&#10;        THEN &apos;Positive&apos;&#10;        ELSEIF [value_wow_pct] &gt;0&#10;        THEN &apos;Negative&apos;&#10;        ELSE &apos;Notr&apos;&#10;        END&#10;&#10;ELSE&#10;        IF &#10;        [Calculation_6724929836658286600]&gt;0&#10;        THEN &apos;Positive&apos;&#10;        ELSEIF  [Calculation_6724929836658286600] &lt;0&#10;        THEN &apos;Negative&apos;&#10;        ELSE &apos;Notr&apos;&#10;        END&#10;END' />
