            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Metric Name' datatype='string' name='[metric_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_4800837264257228816]' derivation='None' name='[none:Calculation_4800837264257228816:nk]' pivot='key' type='nominal' />
