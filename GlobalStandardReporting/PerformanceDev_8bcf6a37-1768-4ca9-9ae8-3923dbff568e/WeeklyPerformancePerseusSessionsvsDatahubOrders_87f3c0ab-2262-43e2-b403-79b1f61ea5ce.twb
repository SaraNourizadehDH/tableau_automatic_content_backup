                  <zone h='9778' id='380' is-centered='0' is-scaled='1' param='Image/Delivery-Hero-Logo.png' type-v2='bitmap' w='8130' x='444' y='889'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
