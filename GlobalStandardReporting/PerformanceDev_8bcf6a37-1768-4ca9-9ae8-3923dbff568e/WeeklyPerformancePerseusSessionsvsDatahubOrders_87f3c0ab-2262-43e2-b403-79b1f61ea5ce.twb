              <zone forceUpdate='true' h='7889' id='203' type-v2='text' w='98666' x='667' y='91222'>
                <formatted-text>
                  <run bold='true' fontcolor='#333333' fontsize='8' italic='true'>Brand Interest:</run>
                  <run bold='true' fontsize='8' italic='true'>Æ </run>
                  <run fontcolor='#000000a8' fontsize='8' italic='true'>Total Google search interest, i.e. the indexed number of search queries on Google Search (incl. Play Store). This is a proxy for how often users have searched for the respective brands. This data is based on &quot;exact match&quot; of users&apos; searches with a set of keywords provided by Delivery Hero.</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#333333' fontsize='8' italic='true'>Downloads:</run>
                  <run fontcolor='#333333' fontsize='8' italic='true'>Æ </run>
                  <run fontsize='8' italic='true'>Android and iOS app download </run>
                  <run fontsize='8' italic='true' underline='true'>estimations</run>
                  <run fontsize='8' italic='true'> from Data.Ai for all competitors.</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#333333' fontsize='8' italic='true'>Weekly Active Users: </run>
                  <run fontsize='8' italic='true'>Data.ai </run>
                  <run fontsize='8' italic='true' underline='true'>estimations</run>
                  <run fontsize='8' italic='true'> for weekly  android and ios active app users</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='0' />
