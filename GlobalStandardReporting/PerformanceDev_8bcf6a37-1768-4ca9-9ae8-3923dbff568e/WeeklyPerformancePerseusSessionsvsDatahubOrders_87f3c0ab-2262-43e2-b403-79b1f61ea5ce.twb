    <worksheet name='EU-W (3)'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='weekly_performance_mgmt_entity (cl_intl_markets)' name='federated.0ys7zw11p52vsb10nbrzs156gjsp' />
          </datasources>
          <datasource-dependencies datasource='federated.0ys7zw11p52vsb10nbrzs156gjsp'>
            <column caption='attr' datatype='integer' name='[Calculation_1179309844473151490]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='value_pct' datatype='real' default-format='p0.0%' name='[Calculation_1179309844703178755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [metric_name]&#10;WHEN    &apos;sessions_cvr&apos;  THEN     [value]&#10;WHEN    &apos;orders_fail_rate&apos;  THEN     [value]&#10;WHEN    &apos;orders_higher_4over5_rate&apos;  THEN     [value]+0.00001&#10;WHEN    &apos;delivery_fee_rate_afv_od&apos;  THEN     [value]&#10;WHEN    &apos;customer_fee_afv_rate_od&apos;  THEN   [value]&#10;WHEN    &apos;extreme_delay_orders_rate&apos;  THEN     [value]&#10;WHEN    &apos;seamless_orders_rate&apos;  THEN     [value]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='WoW ppt' datatype='real' default-format='n#,##0.0&quot;p.p&quot;;-#,##0.0&quot;p.p&quot;' name='[Calculation_1179309844706361350]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1179309844703178755]-[value_2_pct (copy)_1179309844706263045])*100' />
            </column>
            <column caption='Metric Title' datatype='string' name='[Calculation_1179309844723359755]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [metric_name]&#10;WHEN    &apos;sessions&apos;  THEN   &apos;Sessions (K)&apos;&#10;WHEN    &apos;sessions_cvr&apos;  THEN   &apos;CVR&apos;&#10;WHEN    &apos;orders_successful&apos;  THEN   &apos;Orders (K)&apos;&#10;WHEN    &apos;orders_fail_rate&apos;  THEN   &apos;Fail Rate %&apos;&#10;WHEN    &apos;orders_higher_4over5_rate&apos;  THEN   &apos;4/5 rated orders %&apos;&#10;WHEN    &apos;active_customers&apos;  THEN   &apos;Active Customers (K)&apos;&#10;WHEN    &apos;active_customers_qc&apos;  THEN   &apos;QC Active Customers (K)&apos;&#10;WHEN    &apos;acquisitions&apos;  THEN   &apos;Acquisitions (K)&apos;&#10;WHEN    &apos;gmv_eur&apos;  THEN   &apos;GMV (K)&apos;&#10;WHEN    &apos;orders_aov&apos;  THEN   &apos;AOV&apos;&#10;WHEN    &apos;delivery_fee_rate_afv_od&apos;  THEN   &apos;DF as % of AFV&apos;&#10;WHEN    &apos;customer_fee_afv_rate_od&apos;  THEN   &apos;CF as % of AFV&apos;&#10;WHEN    &apos;avg_delivery_time&apos;  THEN   &apos;Delivery Time (min)&apos;&#10;WHEN    &apos;extreme_delay_orders_rate&apos;  THEN   &apos;Extreme delays %&apos;&#10;WHEN    &apos;seamless_orders_rate&apos;  THEN   &apos;Seamless Orders %&apos;&#10;WHEN    &apos;nps_ao&apos;  THEN   &apos;AO NPS&apos;&#10;WHEN    &apos;logistics_index&apos; THEN &apos;Logistics Index&apos;&#10;WHEN    &apos;frequency&apos; THEN &apos;Frequency&apos;&#10;END' />
            </column>
            <column caption='is_wow_pos_num' datatype='string' name='[Calculation_1179309844788531214]' role='dimension' type='nominal'>
