                  </zone>
                  <zone forceUpdate='true' h='9778' id='381' type-v2='text' w='10703' x='88853' y='889'>
                    <formatted-text>
                      <run bold='true' fontcolor='#ffffff' fontsize='10' italic='true'>Ask us anything on Slack: #data-hub-intl-markets</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='0' />
                      <format attr='margin-left' value='2' />
                      <format attr='background-color' value='#d61f26' />
                    </zone-style>
                  </zone>
                </zone>
              </zone>
              <zone forceUpdate='true' h='12333' id='199' type-v2='text' w='35412' x='444' y='86778'>
                <formatted-text>
                  <run bold='true' fontsize='8' italic='true'>Notes:</run>
                  <run>Æ&#10;</run>
                  <run fontsize='8' italic='true'>- All monetary values are in Euro.</run>
                  <run>Æ&#10;</run>
                  <run fontsize='8' italic='true'>- Fail rate includes cancellations.</run>
                  <run>Æ&#10;</run>
                  <run fontsize='8' italic='true'>- Group total shows the total represented in the tables. Example: Sessions is excluded for Woowa.</run>
                  <run>Æ&#10;</run>
                  <run fontsize='8' italic='true'>- Only OD metrics: DF, CF, Delivery time, Logistics Index, Seamless Orders %, Extreme delayed orders %</run>
                  <run>Æ&#10;</run>
                  <run fontsize='8' italic='true'>- (CF) Customer Fees: Delivery Fee + Service Fee + Minimum Order Fee</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='12333' id='305' type-v2='text' w='41642' x='35856' y='86778'>
                <formatted-text>
                  <run fontsize='8' italic='true'>- Extreme delays: OD orders that were late more than 60 minutes compared to promised delivery time</run>
                  <run>Æ&#10;</run>
                  <run fontsize='8' italic='true'>- Seamless Orders: % of PD orders which had no cancellations, no delays, no HC sessions and contact</run>
                  <run>Æ&#10;</run>
                  <run fontsize='8' italic='true'>- Logistics Index: Delivery Time/ UTR</run>
                  <run>Æ&#10;</run>
                  <run fontsize='8' italic='true'>- 4/5 rated orders: Share of 4/5 and above rated orders in total rated orders. Converted rating has been used to normalise platform differences</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='12333' id='425' type-v2='text' w='22058' x='77498' y='86778'>
                <formatted-text>
                  <run bold='true' fontsize='8'>Important note about Glovo data:</run>
                  <run>Æ&#10;</run>
                  <run fontsize='8'>*Glovo values are pending validation. Historicals and rest of the values are being processed.</run>
                  <run>Æ&#10;</run>
                  <run fontsize='8'>**</run>
                  <run bold='true' fontsize='8' underline='true'>Glovo values are not added to DH total.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
