            <column-instance column='[Calculation_6352679179907317760]' derivation='Sum' name='[sum:Calculation_6352679179907317760:qk]' pivot='key' type='quantitative' />
            <column-instance column='[WoW ppt (copy)_1179309844711378953]' derivation='Sum' name='[sum:WoW ppt (copy)_1179309844711378953:qk]' pivot='key' type='quantitative' />
            <column-instance column='[value_2_pct (copy)_1179309844706263045]' derivation='Sum' name='[sum:value_2_pct (copy)_1179309844706263045:qk]' pivot='key' type='quantitative' />
