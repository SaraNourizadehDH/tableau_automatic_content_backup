              <calculation class='tableau' formula='SUM([failed_orders])&#10;/&#10;(&#10;    SUM([successful_orders])&#10;    +&#10;    SUM([failed_orders])&#10;)' />
            </column>
            <column caption='Reorder Rate 30D' datatype='real' default-format='p0.0%' name='[Calculation_170362744565043202]' role='measure' type='quantitative'>
