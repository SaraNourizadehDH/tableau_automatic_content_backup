            <column caption='MOV corrected' datatype='real' name='[Calculation_180425479079682057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  &#13;&#10;    [source] = &apos;Wolt&apos;&#13;&#10;THEN&#13;&#10;    IF &#13;&#10;        [country] &lt;&gt; &quot;SE&quot;&#13;&#10;    THEN&#13;&#10;        (CASE [country]&#13;&#10;        WHEN&#13;&#10;            &quot;CZ&quot;&#13;&#10;        THEN&#13;&#10;            [mov] -10&#13;&#10;        WHEN&#13;&#10;            &quot;FI&quot;&#13;&#10;        THEN&#13;&#10;            [mov] -0.8&#13;&#10;        WHEN&#13;&#10;            &quot;NO&quot;&#13;&#10;        THEN&#13;&#10;            [mov] -7&#13;&#10;        WHEN &#13;&#10;            &quot;DK&quot;&#13;&#10;        THEN&#13;&#10;            [mov] -5&#13;&#10;        WHEN &#13;&#10;            &quot;SK&quot;&#13;&#10;        THEN&#13;&#10;            [mov] -0.25&#13;&#10;        WHEN&#13;&#10;            &quot;HU&quot;&#13;&#10;           THEN&#13;&#10;            IF RIGHT(STR([mov]),2) = &apos;10&apos; THEN [mov]-110&#13;&#10;ELSE [mov] - 99 END&#13;&#10;        END)&#13;&#10;    ELSE &#13;&#10;        (IF &#13;&#10;            [delivery_type] = &quot;OD&quot;&#13;&#10;        THEN&#13;&#10;            [mov]-7.5&#13;&#10;        ELSE    &#13;&#10;            [mov]&#13;&#10;        END)&#13;&#10;    END&#13;&#10;ELSE    &#13;&#10;    [mov_local]&#13;&#10;END' />
            </column>
            <column caption='MOV Comp' datatype='real' name='[Calculation_539024602136993802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [source] &lt;&gt; &apos;DH&apos; THEN [Calculation_180425479075635207] END' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_539024602137309197]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='MOV Difference' datatype='real' name='[Calculation_539024602138914830]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([MOV Comp (copy)_539024602137133067]) - AVG([Calculation_539024602136993802])' />
            </column>
            <column caption='MOV Difference Shape' datatype='string' name='[Calculation_539024602194771983]' role='measure' type='nominal'>
