    <worksheet name='OV - AA - Downloads All'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>App Downloads (&lt;</run>
            <run fontalignment='1'>[Parameters].[Parameter 3]</run>
            <run fontalignment='1'>&gt;) (&lt;</run>
            <run fontalignment='1'>[Parameters].[Parameter 1 1]</run>
            <run fontalignment='1'>&gt;)&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fulfillment-dwh-production.curated_data_shared_intl_markets.ci_central_kpis' name='federated.1yjdo8c07whtlf16prnji0m332o0' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Percentages' caption='sw_abs_percent_switch' datatype='integer' name='[Parameter 1 1]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Percentages' />
                <alias key='2' value='Absolute Values' />
              </aliases>
            </column>
            <column alias='All' caption='iOs / Android / All' datatype='integer' name='[Parameter 3]' param-domain-type='list' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
              <aliases>
                <alias key='1' value='iOS' />
                <alias key='2' value='Android' />
                <alias key='3' value='All' />
              </aliases>
            </column>
            <column caption='actuals' datatype='string' name='[Parameter 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;Acquisitions&quot;'>
              <calculation class='tableau' formula='&quot;Acquisitions&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1yjdo8c07whtlf16prnji0m332o0'>
            <column caption='AA-Downloads_data_availability' datatype='string' name='[Calculation_1164602736863920128]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([appannie_ios_all_downloads (copy)] &gt; 0 AND [appannie_and_all_downloads] &gt; 0 AND [appannie_ios_all_downloads] &gt; 0) THEN &apos;Unified&apos;&#10;ELSEIF ([appannie_ios_all_downloads (copy)] &gt; 0 AND [appannie_and_all_downloads] &gt; 0) THEN &apos;Android&apos;&#10;ELSEIF ([appannie_ios_all_downloads (copy)] &gt; 0 AND [appannie_ios_all_downloads] &gt; 0) THEN &apos;iOs&apos;&#10;END' />
            </column>
            <column caption='entity_type_filter' datatype='string' name='[Calculation_1839087133215158272]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF&#10;    [country_code] IN (&apos;ES&apos;, &apos;PT&apos;, &apos;IT&apos;, &apos;SI&apos;, &apos;PL&apos;, &apos;RO&apos;, &apos;BA&apos;, &apos;ME&apos;, &apos;BG&apos;, &apos;HR&apos;, &apos;RS&apos;, &apos;UA&apos;, &apos;GE&apos;, &apos;AM&apos;, &apos;MD&apos;, &apos;AD&apos;, &apos;KZ&apos;, &apos;KG&apos;, &apos;TN&apos;, &apos;MA&apos;, &apos;UG&apos;, &apos;KE&apos;, &apos;CI&apos;, &apos;NG&apos;, &apos;GH&apos;) THEN &apos;Glovo Markets&apos;&#10;ELSEIF &#10;    LEFT([management_entity_group], 7) = &apos;Other -&apos; THEN &apos;Non DH/Glovo Markets&apos;&#10;ELSE&#10;    &apos;DH Markets&apos;&#10;END' />
            </column>
            <column caption='SW_switch_label_sign' datatype='string' name='[Calculation_2292050799309238274]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 1 1] = 1, &apos;%&apos;, &apos;&apos;)' />
            </column>
            <column caption='dh_actuals_switch_sign' datatype='string' name='[Calculation_231935399999803392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='iif([Parameters].[Parameter 9] = &apos;Voucher Orders %&apos;, &apos;%&apos;, &apos;&apos;)' />
            </column>
            <column caption='Competitor Colors' datatype='string' name='[Calculation_3600065008323088384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([is_dh_brand], &apos;Delivery Hero&apos;, [brand_display_name])' />
            </column>
            <column caption='dh_orders_parameter' datatype='real' name='[Calculation_4005600041928175616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(&#10;iif([appannie_downloads_confidence_flag] = 5, NULL,&#10;iif([Parameters].[Parameter 9] = &apos;Successful Orders&apos;, [dh_orders],&#10;iif([Parameters].[Parameter 9] = &apos;Acquisitions&apos;, [dh_acquisitions],&#10;iif([Parameters].[Parameter 9] = &apos;Voucher Orders&apos;, [dh_voucher_orders],&#10;iif([Parameters].[Parameter 9] = &apos;Voucher Orders %&apos;, [dh_voucher_order_ratio]*100,&#10; NULL))))))' />
            </column>
            <column caption='Primary Competitors' datatype='string' name='[Calculation_4081176112623828992]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='iif([is_primary_competitor], &apos;Top Competitors&apos; , &apos;Others&apos;)' />
            </column>
            <column caption='appannie_downloads_confidence_flag_disclaimer' datatype='string' name='[Calculation_5104056175524900865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF(ISNULL([appannie_downloads_confidence_flag]), &apos;&apos;,&#10;IIF([appannie_downloads_confidence_flag] = 1, &apos;&apos;,&#10;IIF([appannie_downloads_confidence_flag] = 2, &apos;Warning: Analyses showed data.ai download estimates do not correlate with actual download trends. Please be careful when using this data.&apos;,&#10;IIF([appannie_downloads_confidence_flag] = 3, &apos;Warning: Analyses showed data.ai download numbers correlate with paid downloads, rather than total downloads (organic + paid).&apos;, &#10;IIF([appannie_downloads_confidence_flag] = 4, &apos;Warning: Analyses showed data.ai download numbers correlate with organic (unpaid) downloads, rather than total downloads (organic + paid).&apos;, &#10;IIF([appannie_downloads_confidence_flag] = 5, &apos;Warning: Analyses showed data.ai download estimates do not correlate with actual download trends. This metric is therefore not shown.&apos;, &#10;&apos;&apos;))))))' />
            </column>
            <column caption='iOs / And / All' datatype='string' name='[Calculation_5741596974407430144]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 3] = 1, &apos;iOs&apos;, IIF([Parameters].[Parameter 3] = 2, &apos;Android&apos;, &apos;All&apos;))' />
            </column>
            <column caption='Report Month (Last 13 Months)' datatype='date' name='[Report Month (copy)]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IIF([granularity] = &apos;Monthly&apos;,&#10;IIF(DATEDIFF(&apos;month&apos;, [report_date], TODAY()) &lt; 14, [report_date], NULL),&#10;IIF(DATEDIFF(&apos;week&apos;, [report_date], TODAY()) &lt; 21, [report_date], NULL)&#10;)' />
            </column>
            <column caption='appannie_switch_all_downloads' datatype='real' name='[appannie_all_downloads (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MAX([appannie_downloads_confidence_flag]) = 5 THEN NULL&#10;&#10;ELSEIF [Parameters].[Parameter 1 1] = 2 AND [Parameters].[Parameter 3] = 3&#10;    THEN&#10;        MAX([appannie_ios_all_downloads (copy)])&#10;ELSEIF [Parameters].[Parameter 1 1] = 2 AND [Parameters].[Parameter 3] = 1&#10;    THEN &#10;        MAX([appannie_ios_all_downloads])&#10;ELSEIF [Parameters].[Parameter 1 1] = 2 AND [Parameters].[Parameter 3] = 2&#10;    THEN &#10;        MAX([appannie_and_all_downloads])&#10;ELSEIF [Parameters].[Parameter 1 1] = 1 AND [Parameters].[Parameter 3] = 3&#10;    THEN &#10;        ROUND((SUM([appannie_ios_all_downloads (copy)]) / &#10;            SUM({EXCLUDE  [Calculation_3600065008323088384], [competitor_google], [Calculation_1164602736863920128] : SUM([appannie_ios_all_downloads (copy)])}))*100, 1)&#10;ELSEIF [Parameters].[Parameter 1 1] = 1 AND [Parameters].[Parameter 3] = 1&#10;    THEN &#10;        ROUND((SUM([appannie_ios_all_downloads]) / &#10;            SUM({EXCLUDE  [Calculation_3600065008323088384], [competitor_google], [Calculation_1164602736863920128] : SUM([appannie_ios_all_downloads])}))*100, 1)&#10;ELSEIF [Parameters].[Parameter 1 1] = 1 AND [Parameters].[Parameter 3] = 2&#10;    THEN &#10;        ROUND((SUM([appannie_and_all_downloads]) / &#10;            SUM({EXCLUDE  [Calculation_3600065008323088384], [competitor_google], [Calculation_1164602736863920128] : SUM([appannie_and_all_downloads])}))*100, 1)&#10;END' />
            </column>
            <column caption='Appannie And All Downloads' datatype='integer' name='[appannie_and_all_downloads]' role='measure' type='quantitative' />
            <column datatype='integer' name='[appannie_downloads_confidence_flag]' role='measure' type='quantitative' />
            <column caption='appannie_all_downloads' datatype='integer' name='[appannie_ios_all_downloads (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(ISNULL([appannie_ios_all_downloads]), 0, [appannie_ios_all_downloads]) + IIF(ISNULL([appannie_and_all_downloads]), 0, [appannie_and_all_downloads])' />
            </column>
            <column caption='Appannie Ios All Downloads' datatype='integer' name='[appannie_ios_all_downloads]' role='measure' type='quantitative' />
            <column caption='appannie_switch_all_downloads_formatted' datatype='real' name='[appannie_switch_all_downloads (copy 2)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1 1] = 1 &#10;THEN &#10;    FLOAT(LEFT(STR([appannie_all_downloads (copy 2)]), LEN(STR([appannie_all_downloads (copy 2)]))))&#10;ELSE&#10;    [appannie_all_downloads (copy 2)]&#10;END' />
            </column>
            <column-instance column='[Calculation_231935399999803392]' derivation='Attribute' name='[attr:Calculation_231935399999803392:nk]' pivot='key' type='nominal' />
            <column caption='Brand Display Name' datatype='string' name='[brand_display_name]' role='dimension' type='nominal' />
            <column caption='Business Model' datatype='string' name='[business_model]' role='dimension' type='nominal' />
            <column datatype='string' name='[business_model_vertical]' role='dimension' type='nominal' />
            <column caption='Competitor Google' datatype='string' name='[competitor_google]' role='dimension' type='nominal' />
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Dh Acquisitions' datatype='integer' name='[dh_acquisitions]' role='measure' type='quantitative' />
            <column caption='Dh Orders' datatype='integer' name='[dh_orders]' role='measure' type='quantitative' />
            <column caption='Dh Voucher Order Ratio' datatype='real' name='[dh_voucher_order_ratio]' role='measure' type='quantitative' />
            <column caption='Dh Voucher Orders' datatype='integer' name='[dh_voucher_orders]' role='measure' type='quantitative' />
            <column caption='Display Date' datatype='string' name='[display_date]' role='dimension' type='nominal' />
            <column caption='Granularity' datatype='string' name='[granularity]' role='dimension' type='nominal' />
            <column caption='Is Dh Brand' datatype='boolean' name='[is_dh_brand]' role='dimension' type='nominal' />
            <column caption='Is Primary Competitor' datatype='boolean' name='[is_primary_competitor]' role='dimension' type='nominal' />
