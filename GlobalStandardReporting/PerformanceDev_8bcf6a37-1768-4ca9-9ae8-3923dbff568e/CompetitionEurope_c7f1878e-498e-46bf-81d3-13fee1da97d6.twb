  <actions>
    <action caption='Auto Deselect Gap from Back' name='[Action10_0DB308484CAA4FC1A5AF8B7BABE31512]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Gap Vendors' type='sheet' worksheet='Back' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Pickup Difference,Cities by population difference,Cities coverage by population,MOV Chart,MOV Chart +-,Pickup,Open-close time' />
        <param name='special-fields' value='all' />
        <param name='target' value='Competition Tracker' />
      </command>
    </action>
    <action caption='Filter1' name='[Action12_1B57A7F6CEB14F78AB144BF2578EA8B7]'>
