            </column>
            <column caption='TRUE' datatype='boolean' name='[Calculation_1203305547530788893]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='TRUE' />
            </column>
            <column caption='one' datatype='integer' name='[Calculation_1203305547531870240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='&quot;MOV&quot;' datatype='string' name='[Calculation_1203305547537784865]' role='dimension' type='nominal' user:unnamed='Gap Vendors'>
              <calculation class='tableau' formula='&quot;MOV&quot;' />
            </column>
            <column caption='City Category' datatype='string' name='[Calculation_1203305547575844900]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [City Set]&#13;&#10;THEN &quot;Top &quot; + str([Parameters].[Parameter 2]) + &quot; Cities&quot;&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END' />
            </column>
            <column caption='City ' datatype='string' name='[Calculation_1203305547577634853]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 14]=&quot;Collapse&quot; THEN&#13;&#10;IF [City Set]&#13;&#10;THEN  [City]&#13;&#10;ELSE &quot;Others&quot; END&#13;&#10;ELSE [City] END' />
            </column>
            <column caption='MOV corrected' datatype='real' name='[Calculation_180425479079682057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  &#13;&#10;    [source] = &apos;Wolt&apos;&#13;&#10;THEN&#13;&#10;    IF &#13;&#10;        [country] &lt;&gt; &quot;SE&quot;&#13;&#10;    THEN&#13;&#10;        (CASE [country]&#13;&#10;        WHEN&#13;&#10;            &quot;CZ&quot;&#13;&#10;        THEN&#13;&#10;            [mov] -10&#13;&#10;        WHEN&#13;&#10;            &quot;FI&quot;&#13;&#10;        THEN&#13;&#10;            [mov] -0.8&#13;&#10;        WHEN&#13;&#10;            &quot;NO&quot;&#13;&#10;        THEN&#13;&#10;            [mov] -7&#13;&#10;        WHEN &#13;&#10;            &quot;DK&quot;&#13;&#10;        THEN&#13;&#10;            [mov] -5&#13;&#10;        WHEN &#13;&#10;            &quot;SK&quot;&#13;&#10;        THEN&#13;&#10;            [mov] -0.25&#13;&#10;        WHEN&#13;&#10;            &quot;HU&quot;&#13;&#10;           THEN&#13;&#10;            IF RIGHT(STR([mov]),2) = &apos;10&apos; THEN [mov]-110&#13;&#10;ELSE [mov] - 99 END&#13;&#10;        END)&#13;&#10;    ELSE &#13;&#10;        (IF &#13;&#10;            [delivery_type] = &quot;OD&quot;&#13;&#10;        THEN&#13;&#10;            [mov]-7.5&#13;&#10;        ELSE    &#13;&#10;            [mov]&#13;&#10;        END)&#13;&#10;    END&#13;&#10;ELSE    &#13;&#10;    [mov_local]&#13;&#10;END' />
            </column>
            <column caption='Addressable Gap' datatype='integer' name='[Calculation_180425479344361483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [gap_vendor] = TRUE&#13;&#10;AND [addressable_gap_vendor] = &quot;Addressable&quot;&#13;&#10;AND [source]&lt;&gt;&quot;DH&quot;&#13;&#10;THEN 1&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Vendor' datatype='string' name='[Calculation_500181055992668161]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [lead_id] = NULL THEN &quot;DH-&quot;+[vendor_id]&#13;&#10;ELSE &quot;Comp-&quot;+[lead_id] END' />
            </column>
            <column caption='Gap' datatype='integer' name='[Calculation_773211777473142784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [gap_vendor] = TRUE&#13;&#10;AND [source]&lt;&gt; &quot;DH&quot;&#13;&#10;THEN 1 ElSE NULL END' />
            </column>
            <column caption='# of Reviews' datatype='string' name='[Calculation_773211777474039809]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [review_count] = 0 THEN &quot;0&quot;&#13;&#10;ELSEIF [review_count] &gt;= 500 THEN &quot;500&quot;&#13;&#10;ELSEIF [review_count] &gt;= 200 THEN &quot;200&quot;&#13;&#10;ELSEIF [review_count] &gt;= 100 THEN &quot;100&quot;&#13;&#10;ELSEIF [review_count] &gt;= 50 THEN &quot;50&quot;&#13;&#10;ELSEIF [review_count] &gt;= 20 THEN &quot;20&quot;&#13;&#10;ELSEIF [review_count] &gt;= 10 THEN &quot;10&quot;&#13;&#10;ELSE &quot;0&quot; END' />
            </column>
