    <worksheet name='Top Cities based on Reviews'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Top &lt;</run>
            <run fontalignment='1'>[Parameters].[Parameter 2]</run>
            <run fontalignment='1'>&gt; Gap Cities</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='scraping_vendors_europe (geolocation)' name='federated.0f1ijzw1mtuprj192xuxd190dpu6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Expand/Collapse' datatype='string' name='[Parameter 14]' param-domain-type='list' role='measure' type='nominal' value='&quot;Collapse&quot;'>
              <calculation class='tableau' formula='&quot;Collapse&quot;' />
            </column>
            <column caption='Top N Cities' datatype='real' datatype-customized='true' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='10.'>
              <calculation class='tableau' formula='10.' />
              <range granularity='1.0' max='20.0' min='1.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0f1ijzw1mtuprj192xuxd190dpu6'>
            <column caption='# Vendors' datatype='integer' name='[# Vendors Comp (copy)_180425478653558784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([source])' />
            </column>
            <column caption='TRUE' datatype='boolean' name='[Calculation_1203305547530788893]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='TRUE' />
            </column>
            <column caption='one' datatype='integer' name='[Calculation_1203305547531870240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='City Category' datatype='string' name='[Calculation_1203305547575844900]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [City Set]&#13;&#10;THEN &quot;Top &quot; + str([Parameters].[Parameter 2]) + &quot; Cities&quot;&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END' />
            </column>
            <column caption='City ' datatype='string' name='[Calculation_1203305547577634853]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 14]=&quot;Collapse&quot; THEN&#13;&#10;IF [City Set]&#13;&#10;THEN  [City]&#13;&#10;ELSE &quot;Others&quot; END&#13;&#10;ELSE [City] END' />
            </column>
            <column caption='Gap' datatype='integer' name='[Calculation_773211777473142784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [gap_vendor] = TRUE&#13;&#10;AND [source]&lt;&gt; &quot;DH&quot;&#13;&#10;THEN 1 ElSE NULL END' />
            </column>
            <column caption='Reviews &gt;=200' datatype='integer' name='[Calculation_860469027983011847]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [review_count] &gt;= 200 THEN [source] END)' />
            </column>
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Ratings &gt;4 % of Total' datatype='real' name='[Ratings &gt;4 (copy)_860469027985817613]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [review_count] &gt;= 4 THEN [source] END)/[# Vendors Comp (copy)_180425478653558784]' />
            </column>
            <column caption='Ratings &gt;4' datatype='integer' name='[Reviews &gt;200 (copy)_860469027985502220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [review_count] &gt;= 4 THEN [source] END)' />
            </column>
            <column caption='Reviews &gt;=200 &amp; Rating &gt;= 4 % of Total' datatype='real' name='[Reviews &gt;=200 &amp; Rating &gt;= 4 (copy)_860469027986853904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [review_count] &gt;= 200 AND&#13;&#10;[restaurant_rating]&gt;=4 THEN [source] END)/[# Vendors Comp (copy)_180425478653558784]' />
            </column>
            <column caption='Reviews &gt;=200 &amp; Rating &gt;= 4' datatype='integer' name='[Reviews &gt;=200 (copy)_860469027986661390]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [review_count] &gt;= 200 AND&#13;&#10;[restaurant_rating]&gt;=4 THEN [source] END)' />
            </column>
            <column caption='Reviews &gt;=200 % of Total' datatype='real' name='[Reviews Greater Than 200 (copy)_860469027984998410]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [review_count] &gt;= 200 THEN [source] END)/[# Vendors Comp (copy)_180425478653558784]' />
            </column>
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column caption='Gap Vendor' datatype='boolean' name='[gap_vendor]' role='dimension' type='nominal' />
