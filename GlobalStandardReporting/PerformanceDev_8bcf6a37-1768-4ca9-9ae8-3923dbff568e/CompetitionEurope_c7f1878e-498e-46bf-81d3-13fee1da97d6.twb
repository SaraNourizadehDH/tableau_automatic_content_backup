          <datasource-dependencies datasource='federated.0f1ijzw1mtuprj192xuxd190dpu6'>
            <column caption='# Vendors' datatype='integer' name='[# Vendors Comp (copy)_180425478653558784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([source])' />
            </column>
            <column caption='MOV - Occurence  City' datatype='integer' name='[Calculation_180425479075020805]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id],[Calculation_720013007576825862],[source],[Calculation_180425479079682057] : COUNT([mov_local])}' />
            </column>
            <column caption='MOV per City' datatype='real' name='[Calculation_180425479075635207]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_180425479075962888] = [Calculation_180425479075020805] THEN&#13;&#10;[Calculation_180425479079682057] END' />
            </column>
            <column caption='MOV max occurence per City' datatype='integer' name='[Calculation_180425479075962888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id],[City],[source]:MAX&#13;&#10;([Calculation_180425479075020805])}' />
            </column>
            <column caption='MOV corrected' datatype='real' name='[Calculation_180425479079682057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  &#13;&#10;    [source] = &apos;Wolt&apos;&#13;&#10;THEN&#13;&#10;    IF &#13;&#10;        [country] &lt;&gt; &quot;SE&quot;&#13;&#10;    THEN&#13;&#10;        (CASE [country]&#13;&#10;        WHEN&#13;&#10;            &quot;CZ&quot;&#13;&#10;        THEN&#13;&#10;            [mov] -10&#13;&#10;        WHEN&#13;&#10;            &quot;FI&quot;&#13;&#10;        THEN&#13;&#10;            [mov] -0.8&#13;&#10;        WHEN&#13;&#10;            &quot;NO&quot;&#13;&#10;        THEN&#13;&#10;            [mov] -7&#13;&#10;        WHEN &#13;&#10;            &quot;DK&quot;&#13;&#10;        THEN&#13;&#10;            [mov] -5&#13;&#10;        WHEN &#13;&#10;            &quot;SK&quot;&#13;&#10;        THEN&#13;&#10;            [mov] -0.25&#13;&#10;        WHEN&#13;&#10;            &quot;HU&quot;&#13;&#10;           THEN&#13;&#10;            IF RIGHT(STR([mov]),2) = &apos;10&apos; THEN [mov]-110&#13;&#10;ELSE [mov] - 99 END&#13;&#10;        END)&#13;&#10;    ELSE &#13;&#10;        (IF &#13;&#10;            [delivery_type] = &quot;OD&quot;&#13;&#10;        THEN&#13;&#10;            [mov]-7.5&#13;&#10;        ELSE    &#13;&#10;            [mov]&#13;&#10;        END)&#13;&#10;    END&#13;&#10;ELSE    &#13;&#10;    [mov_local]&#13;&#10;END' />
            </column>
            <column caption='City Name' datatype='string' name='[Calculation_720013007576825862]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='UPPER(LEFT ([City],1)) + LOWER(RIGHT([City],LEN([City])-1))' />
            </column>
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column-instance column='[Calculation_180425479075635207]' derivation='Avg' name='[avg:Calculation_180425479075635207:qk]' pivot='key' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
