    <worksheet name='Country Summary Difference'>
      <table>
        <view>
          <datasources>
            <datasource caption='scraping_vendors_europe (geolocation)' name='federated.0f1ijzw1mtuprj192xuxd190dpu6' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Rating Threshold' datatype='integer' name='[Parameter 5]' param-domain-type='range' role='measure' type='quantitative' value='4'>
              <calculation class='tableau' formula='4' />
              <range granularity='1' max='5' min='0' />
            </column>
            <column caption='Review Threshold' datatype='integer' name='[Parameter 8]' param-domain-type='list' role='measure' type='quantitative' value='50'>
              <calculation class='tableau' formula='50' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0f1ijzw1mtuprj192xuxd190dpu6'>
            <column caption='# Vendors' datatype='integer' name='[# Vendors Comp (copy)_180425478653558784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([source])' />
            </column>
            <column caption='Non-Addressable Gap' datatype='integer' name='[Addressable Gap Vendor (copy)_180425479345430540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [gap_vendor] = TRUE&#13;&#10;AND [addressable_gap_vendor] = &quot;Non Addressable&quot;&#13;&#10;AND [source]&lt;&gt;&quot;DH&quot;&#13;&#10;THEN 1&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Addressable Gap' datatype='integer' name='[Calculation_180425479344361483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [gap_vendor] = TRUE&#13;&#10;AND [addressable_gap_vendor] = &quot;Addressable&quot;&#13;&#10;AND [source]&lt;&gt;&quot;DH&quot;&#13;&#10;THEN 1&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='     % OD Vendors' datatype='real' name='[Calculation_191684479087165441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [delivery_type] = &quot;OD&quot; THEN 1  ELSE 0 END)&#13;&#10;/[# Vendors Comp (copy)_180425478653558784]' />
            </column>
            <column caption='Capital Flag' datatype='boolean' name='[Calculation_191684479107710979]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;    LOWER([City]) IN &#13;&#10;(&apos;prague&apos;,&#13;&#10;&apos;wien&apos;,&#13;&#10;&apos;vienna&apos;,&#13;&#10;&apos;copenhagen&apos;,&#13;&#10;&apos;stockholm&apos;,&#13;&#10;&apos;oslo&apos;,&#13;&#10;&apos;oslo west&apos;,&#13;&#10;&apos;oslo east&apos;,&#13;&#10;&apos;bratislava&apos;,&#13;&#10;&apos;budapest&apos;,&#13;&#10;&apos;helsinki&apos;)&#13;&#10;THEN&#13;&#10;    TRUE&#13;&#10;ELSE &#13;&#10;    FALSE&#13;&#10;END' />
            </column>
            <column caption='# Vendors Capital' datatype='integer' name='[Calculation_191684479108616196]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF [Calculation_191684479107710979] = TRUE THEN [source] ELSE NULL END)' />
            </column>
            <column caption='     % OD Capital' datatype='real' name='[Calculation_191684479112515591]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [delivery_type] = &quot;OD&quot; AND [Calculation_191684479107710979] = TRUE&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END)/[Calculation_191684479108616196]' />
            </column>
            <column caption='# Cities' datatype='integer' name='[Calculation_191684479113162760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_720013007576825862])' />
            </column>
            <column caption='      % of Good Rating' datatype='real' name='[Calculation_191684479114792971]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [restaurant_rating] &gt; [Parameters].[Parameter 5] &#13;&#10;AND [review_count] &gt;= [Parameters].[Parameter 8]&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END)/[# Vendors Comp (copy)_180425478653558784]' />
            </column>
            <column caption='Gap Capital' datatype='integer' name='[Calculation_191684479116832783]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [Calculation_191684479107710979] = TRUE &#13;&#10;THEN [Calculation_773211777473142784]&#13;&#10;END' />
            </column>
            <column caption='     % OD Gap' datatype='real' name='[Calculation_191684479117008912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [delivery_type] = &quot;OD&quot;&#13;&#10;THEN [Calculation_773211777473142784] END)/SUM([Calculation_773211777473142784])' />
            </column>
            <column caption='Vendor Difference' datatype='integer' name='[Calculation_539024602073329664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_5612540681477255168]) - SUM([Calculation_5612540681477500929])' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_539024602137309197]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='# Vendors DH' datatype='integer' name='[Calculation_5612540681477255168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [source] = &apos;DH&apos; THEN 1 ELSE 0 END' />
            </column>
            <column caption='# Vendors Comp' datatype='integer' name='[Calculation_5612540681477500929]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF source != &apos;DH&apos; THEN 1 ELSE 0 END' />
            </column>
            <column caption='City Difference' datatype='integer' name='[Calculation_705094840518184960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [source] =&quot;DH&quot; THEN [City]END)&#13;&#10;- COUNTD(IF [source] &lt;&gt;&quot;DH&quot; THEN [City]END)' />
            </column>
            <column caption='City Name' datatype='string' name='[Calculation_720013007576825862]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='UPPER(LEFT ([City],1)) + LOWER(RIGHT([City],LEN([City])-1))' />
            </column>
            <column caption='Gap' datatype='integer' name='[Calculation_773211777473142784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [gap_vendor] = TRUE&#13;&#10;AND [source]&lt;&gt; &quot;DH&quot;&#13;&#10;THEN 1 ElSE NULL END' />
            </column>
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Addressable Gap Vendor' datatype='string' name='[addressable_gap_vendor]' role='dimension' type='nominal' />
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column caption='Gap Vendor' datatype='boolean' name='[gap_vendor]' role='dimension' type='nominal' />
