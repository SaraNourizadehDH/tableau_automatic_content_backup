    <worksheet name='Logistics-MetricSelector1'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold' fontsize='12'>&lt;</run>
            <run fontname='Tableau Bold' fontsize='12'>[Parameters].[Parameter 4]</run>
            <run fontname='Tableau Bold' fontsize='12'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='unified_view_customer (rl_intl_markets)' name='federated.1fb23vr1es555v121h0a60dlxyo1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Overview Metric Selector 1' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;GMV (EUR)&quot;'>
              <calculation class='tableau' formula='&quot;GMV (EUR)&quot;' />
            </column>
            <column caption='Logistics Metric Selector 1' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% OD Orders&quot;'>
              <calculation class='tableau' formula='&quot;% OD Orders&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fb23vr1es555v121h0a60dlxyo1'>
            <column caption='% Failed OD Orders (Platform)' datatype='real' name='[% Failed OD Orders (Customer) (copy)_1278107537100795912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_failed_orders_platform]) / (sum([od_failed_orders]) + sum([od_successful_orders]))' />
            </column>
            <column caption='% Failed OD Orders (Logistics)' datatype='real' name='[% Failed OD Orders (Platform) (copy)_1278107537100886025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_failed_orders_transport]) / (sum([od_failed_orders]) + sum([od_successful_orders]))' />
            </column>
            <column caption='% Failed OD Orders (Vendor)' datatype='real' name='[% Failed OD Orders (Platform) (copy)_1278107537101082634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_failed_orders_vendor]) / (sum([od_failed_orders]) + sum([od_successful_orders]))' />
            </column>
            <column caption='% Failed OD Orders (Customer)' datatype='real' name='[% Failed OD Orders (copy)_1278107537100660743]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_failed_orders_customer]) / (sum([od_failed_orders]) + sum([od_successful_orders]))' />
            </column>
            <column caption='Orders with &gt;10 mins delay' datatype='real' name='[Calculation_1278107537084432389]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_late_by_10_mins]) / SUM([orders_w_dt_available])' />
            </column>
            <column caption='% Failed OD Orders' datatype='real' name='[Calculation_1278107537100234758]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_failed_orders]) / (sum([od_failed_orders]) + sum([od_successful_orders]))' />
            </column>
            <column caption='% Seamless Orders' datatype='real' name='[Calculation_1422926416657588227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_seamless_orders]) / sum([total_gcc_orders])' />
            </column>
            <column caption='% OD Orders' datatype='real' name='[Calculation_4792955941137625098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_successful_orders]) / sum([successful_orders])' />
            </column>
            <column caption='% Failed Orders' datatype='real' name='[Calculation_4792955941137887243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders]) / (SUM([successful_orders]) + SUM([failed_orders]))' />
            </column>
            <column caption='Logistics Metrics (Parameter1)' datatype='real' name='[Overview Metrics (Parameter1) (copy)_1278107537128820753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 5] = &apos;% OD Orders&apos;, ROUND([Calculation_4792955941137625098]*100,2),&#10;IIF([Parameters].[Parameter 5] = &apos;% Seamless Orders&apos;, ROUND([Calculation_1422926416657588227]*100,2),&#10;IIF([Parameters].[Parameter 5] = &apos;% Orders w/&gt;10mins delay&apos;, ROUND([Calculation_1278107537084432389]*100,2),&#10;IIF([Parameters].[Parameter 5] = &apos;% Failed Orders&apos;, ROUND([Calculation_4792955941137887243]*100,2),&#10;IIF([Parameters].[Parameter 5] = &apos;% Failed OD Orders&apos;, ROUND([Calculation_1278107537100234758]*100,2),&#10;IIF([Parameters].[Parameter 5] = &apos;% Failed OD Orders (Logistics)&apos;, ROUND([% Failed OD Orders (Platform) (copy)_1278107537100886025]*100,2),&#10;IIF([Parameters].[Parameter 5] = &apos;% Failed OD Orders (Platform)&apos;, ROUND([% Failed OD Orders (Customer) (copy)_1278107537100795912]*100,2),&#10;IIF([Parameters].[Parameter 5] = &apos;% Failed OD Orders (Customer)&apos;, ROUND([% Failed OD Orders (copy)_1278107537100660743]*100,2),&#10;IIF([Parameters].[Parameter 5] = &apos;% Failed OD Orders (Vendor)&apos;, ROUND([% Failed OD Orders (Platform) (copy)_1278107537101082634]*100,2),&#10;NULL&#10;)))))))))' />
            </column>
            <column caption='Failed Orders' datatype='integer' name='[failed_orders]' role='measure' type='quantitative' />
            <column datatype='boolean' name='[is_last_12_months]' role='dimension' type='nominal' />
            <column-instance column='[is_last_12_months]' derivation='None' name='[none:is_last_12_months:nk]' pivot='key' type='nominal' />
            <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
            <column-instance column='[sub_entity]' derivation='None' name='[none:sub_entity:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[od_failed_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[od_failed_orders_customer]' role='measure' type='quantitative' />
            <column datatype='integer' name='[od_failed_orders_platform]' role='measure' type='quantitative' />
            <column datatype='integer' name='[od_failed_orders_transport]' role='measure' type='quantitative' />
            <column datatype='integer' name='[od_failed_orders_vendor]' role='measure' type='quantitative' />
            <column caption='Successful OD Orders' datatype='integer' name='[od_successful_orders]' role='measure' type='quantitative' />
            <column datatype='real' name='[orders_late_by_10_mins]' role='measure' type='quantitative' />
            <column datatype='real' name='[orders_w_dt_available]' role='measure' type='quantitative' />
            <column caption='Report Month' datatype='date' name='[report_month]' role='dimension' type='ordinal' />
            <column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal' />
            <column caption='Sub-entity' datatype='string' name='[sub_entity]' role='dimension' type='nominal' />
            <column caption='Successful Orders' datatype='integer' name='[successful_orders]' role='measure' type='quantitative' />
            <column-instance column='[report_month]' derivation='Month-Trunc' name='[tmn:report_month:ok]' pivot='key' type='ordinal' />
            <column datatype='integer' name='[total_gcc_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_seamless_orders]' role='measure' type='quantitative' />
            <column-instance column='[Overview Metrics (Parameter1) (copy)_1278107537128820753]' derivation='User' name='[usr:Overview Metrics (Parameter1) (copy)_1278107537128820753:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1fb23vr1es555v121h0a60dlxyo1].[none:is_last_12_months:nk]' filter-group='4'>
            <groupfilter function='member' level='[none:is_last_12_months:nk]' member='true' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
