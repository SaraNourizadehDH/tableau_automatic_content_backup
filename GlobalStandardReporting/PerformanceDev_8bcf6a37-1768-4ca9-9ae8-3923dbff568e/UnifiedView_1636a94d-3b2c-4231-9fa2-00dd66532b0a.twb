            </column>
            <column caption='MoM_Acquisition Velocity' datatype='real' name='[Acquisition Velocity (copy)_791718763783225346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(([Addressable Population (copy)_4792955941129351172]) &gt; MAX([cumulative_acquisitions]), &#10;SUM([acquisitions]) / (([Addressable Population (copy)_4792955941129351172]) - MAX([cumulative_acquisitions])),&#10;SUM([acquisitions]) / (MAX([population]) - MAX([cumulative_acquisitions]))&#10;)&#10;-&#10;IIF(([Addressable Population (copy)_4792955941129351172]) &gt; MAX([cumulative_acquisitions_lm]), &#10;SUM([acquisitions_lm]) / (([Addressable Population (copy)_4792955941129351172]) - MAX([cumulative_acquisitions_lm])),&#10;SUM([acquisitions_lm]) / (MAX([population]) - MAX([cumulative_acquisitions_lm]))&#10;)' />
            </column>
