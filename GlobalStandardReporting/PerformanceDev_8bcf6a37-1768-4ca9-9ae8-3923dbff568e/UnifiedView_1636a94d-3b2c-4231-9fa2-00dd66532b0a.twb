    <worksheet name='strategic_market_ov'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold'>Country View</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='unified_view_customer (rl_intl_markets)' name='federated.1fb23vr1es555v121h0a60dlxyo1' />
          </datasources>
          <datasource-dependencies datasource='federated.1fb23vr1es555v121h0a60dlxyo1'>
            <column caption='Frequency (Yearly)' datatype='real' name='[AOV (EUR) (Yearly) (copy)_5940810898891128834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Calculation_5940810898890256384], [global_entity_id] : AVG([successful_orders] / [active_customers])}' />
            </column>
            <column caption='Addressable Population' datatype='real' datatype-customized='true' name='[Addressable Population (copy)_4792955941129351172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [country_code] : MAX([addressable_population])})' />
            </column>
            <column caption='Acquisition Velocity' datatype='real' name='[Calculation_4792955941135241223]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(([Addressable Population (copy)_4792955941129351172]) &gt; MAX([cumulative_acquisitions]), &#10;SUM([acquisitions]) / (([Addressable Population (copy)_4792955941129351172]) - MAX([cumulative_acquisitions])),&#10;SUM([acquisitions]) / (MAX([population]) - MAX([cumulative_acquisitions]))&#10;)' />
            </column>
            <column caption='Frequency' datatype='real' name='[Calculation_4792955941136257033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders]) / SUM([active_customers])' />
            </column>
            <column aggregation='Sum' caption='Report_Year' datatype='integer' name='[Calculation_5940810898890256384]' role='dimension' type='ordinal'>
