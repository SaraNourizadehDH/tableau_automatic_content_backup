    <worksheet name='OrderCuts-Table_MoM'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Order Cuts</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='unified_view_customer (rl_intl_markets)' name='federated.1fb23vr1es555v121h0a60dlxyo1' />
          </datasources>
          <datasource-dependencies datasource='federated.1fb23vr1es555v121h0a60dlxyo1'>
            <column caption='MoM_% OD Orders' datatype='real' name='[% OD Orders (copy)_106679036810448903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([od_successful_orders]) / sum([successful_orders])) - (sum([od_successful_orders_lm]) / sum([successful_orders_lm]))' />
            </column>
            <column caption='MoM_AFV (EUR) ' datatype='real' name='[AFV (EUR) (copy)_106679036813000715]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(sum([gbv_eur])&#10;/&#10;sum([successful_orders]))&#10;&#10;/&#10;&#10;(sum([gbv_eur_lm])&#10;/&#10;sum([successful_orders_lm]))&#10;)&#10;-1' />
            </column>
            <column caption='MoM_AOV (EUR)' datatype='real' name='[AOV (EUR) (copy)_106679036813291532]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(sum([gmv_eur])&#10;/&#10;sum([successful_orders]))&#10;&#10;/&#10;&#10;(sum([gmv_eur_lm])&#10;/&#10;sum([successful_orders_lm]))&#10;)&#10;-1' />
            </column>
            <column caption='AFV (EUR)' datatype='real' name='[AOV (copy)_880242624986058753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gbv_eur])&#10;/&#10;sum([successful_orders])' />
            </column>
            <column caption='MoM_Android Successful Orders' datatype='real' name='[Android Successful Orders (copy)_791718763831750679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([android_successful_orders]) / SUM([android_successful_orders_lm])) - 1' />
            </column>
            <column caption='MoM_CVR' datatype='real' name='[CVR (copy)_392516875958378505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([sessions_w_order]) / SUM([sessions]))&#10;-&#10;(SUM([sessions_w_order_lm]) / SUM([sessions_lm]))' />
            </column>
            <column caption='MoM_GMV (EUR)' datatype='real' name='[Calculation_106679036781535232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gmv_eur]) / SUM([gmv_eur_lm])) - 1' />
            </column>
            <column caption='ATTR' datatype='integer' name='[Calculation_3280731595824279557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_363947213370679296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_w_order]) / SUM([sessions])' />
            </column>
            <column caption='% OD Orders' datatype='real' name='[Calculation_4792955941137625098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_successful_orders]) / sum([successful_orders])' />
            </column>
            <column caption='AOV (EUR)' datatype='real' name='[Calculation_880242624985968640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_eur])&#10;/&#10;sum([successful_orders])' />
            </column>
            <column caption='MoM_GFV (EUR)' datatype='real' name='[GFV (EUR) (copy)_106679036813627405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gbv_eur]) / SUM([gbv_eur_lm]))-1' />
            </column>
            <column caption='MoM_Successful Orders' datatype='real' name='[MoM_GMV Pickup (EUR) (copy)_106679036809158661]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([successful_orders]) / SUM([successful_orders_lm])) - 1' />
            </column>
            <column caption='MoM_Sessions' datatype='real' name='[Sessions (copy)_392516875957538824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([sessions]) / SUM([sessions_lm])) -1' />
            </column>
            <column caption='MoM_Web &amp; Other Successful Orders' datatype='real' name='[Web &amp; Other Successful Orders (copy)_791718763832492059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([web_other_successful_orders]) / sum([web_other_successful_orders_lm])) - 1' />
