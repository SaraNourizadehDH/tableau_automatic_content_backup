    <worksheet name='Overview-MetricSelector4'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold' fontsize='12'>&lt;</run>
            <run fontname='Tableau Bold' fontsize='12'>[Parameters].[Overview Metric Selector 3 (copy)_6801913217248804871]</run>
            <run fontname='Tableau Bold' fontsize='12'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='unified_view_customer (rl_intl_markets)' name='federated.1fb23vr1es555v121h0a60dlxyo1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Overview Metric Selector 4' datatype='string' name='[Overview Metric Selector 3 (copy)_6801913217248804871]' param-domain-type='list' role='measure' type='nominal' value='&quot;Active Customers&quot;'>
              <calculation class='tableau' formula='&quot;Active Customers&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fb23vr1es555v121h0a60dlxyo1'>
            <column caption='Avg. Delivery Time' datatype='real' name='[Calculation_1278107537045630977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_delivery_time]) / SUM([orders_w_dt_available])' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_1278107537045811202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_delivered_utr_denominator]) / SUM([rider_hours])' />
            </column>
            <column caption='Logistics Index' datatype='real' name='[Calculation_1278107537045897219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1278107537045630977] / [Calculation_1278107537045811202]' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_363947213370679296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_w_order]) / SUM([sessions])' />
            </column>
            <column caption='% Failed Orders' datatype='real' name='[Calculation_4792955941137887243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders]) / (SUM([successful_orders]) + SUM([failed_orders]))' />
            </column>
            <column caption='KA Order Share' datatype='real' name='[Calculation_6483072436288430080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ka_successful_orders])&#10;/&#10;SUM([successful_orders])' />
            </column>
            <column caption='Commission Rate' datatype='real' name='[Calculation_6483072436301348865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_commission_eur])&#10;/&#10;SUM([commissionable_value_eur])' />
            </column>
            <column caption='FLGPO' datatype='real' name='[Calculation_6483072436301590530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgpo_eur])&#10;/&#10;SUM([orders_profitability])' />
            </column>
            <column caption='GPO' datatype='real' name='[FLGPO (copy)_6483072436301721603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gpo_eur])&#10;/&#10;SUM([orders_profitability])' />
            </column>
            <column caption='Overview Metrics (Parameter4)' datatype='real' name='[Overview Metrics (Parameter3) (copy)_6801913217246609412]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Overview Metric Selector 3 (copy)_6801913217248804871] = &apos;Acquisitions&apos;, SUM([acquisitions]),&#10;IIF([Parameters].[Overview Metric Selector 3 (copy)_6801913217248804871] = &apos;Active Customers&apos;, SUM([active_customers]),&#10;IIF([Parameters].[Overview Metric Selector 3 (copy)_6801913217248804871] = &apos;% Failed Orders&apos;, ROUND([Calculation_4792955941137887243]*100,2),&#10;IIF([Parameters].[Overview Metric Selector 3 (copy)_6801913217248804871] = &apos;Avg. Delivery Time&apos;, [Calculation_1278107537045630977],&#10;IIF([Parameters].[Overview Metric Selector 3 (copy)_6801913217248804871] = &apos;Logistics Index&apos;, [Calculation_1278107537045897219],&#10;IIF([Parameters].[Overview Metric Selector 3 (copy)_6801913217248804871] = &apos;KA Order Share (%)&apos;, ROUND([Calculation_6483072436288430080]*100,2),&#10;IIF([Parameters].[Overview Metric Selector 3 (copy)_6801913217248804871] = &apos;Online Restaurants&apos;, SUM([online_restaurants]),&#10;IIF([Parameters].[Overview Metric Selector 3 (copy)_6801913217248804871] = &apos;Sessions&apos;, SUM([sessions]),&#10;IIF([Parameters].[Overview Metric Selector 3 (copy)_6801913217248804871] = &apos;CVR (%)&apos;, ROUND([Calculation_363947213370679296]*100,2),&#10;IIF([Parameters].[Overview Metric Selector 3 (copy)_6801913217248804871] = &apos;Commission Rate&apos;, ROUND([Calculation_6483072436301348865]*100,2),&#10;IIF([Parameters].[Overview Metric Selector 3 (copy)_6801913217248804871] = &apos;Take-in (EUR)&apos;, SUM([take_in_eur]),&#10;IIF([Parameters].[Overview Metric Selector 3 (copy)_6801913217248804871] = &apos;Total Costs (EUR)&apos;, SUM([total_cpo_eur]),&#10;IIF([Parameters].[Overview Metric Selector 3 (copy)_6801913217248804871] = &apos;GPO&apos;, [FLGPO (copy)_6483072436301721603],&#10;IIF([Parameters].[Overview Metric Selector 3 (copy)_6801913217248804871] = &apos;FLGPO&apos;, [Calculation_6483072436301590530], NULL&#10;))))))))))))))' />
            </column>
            <column caption='[Target] Overview Metrics (Parameter4)' datatype='real' name='[[Target]] Overview Metrics (Parameter3) (copy)_66991067253530627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Overview Metric Selector 3 (copy)_6801913217248804871] = &apos;Acquisitions&apos;, SUM([budget_acquisitions]),&#10;IIF([Parameters].[Overview Metric Selector 3 (copy)_6801913217248804871] = &apos;Active Customers&apos;, SUM([budget_active_users]),&#10;IIF([Parameters].[Overview Metric Selector 3 (copy)_6801913217248804871] = &apos;Online Restaurants&apos;, SUM([budget_restaurants_online]),&#10;IIF([Parameters].[Overview Metric Selector 3 (copy)_6801913217248804871] = &apos;% OD Orders&apos;, ROUND((SUM([budget_od_successful_orders])/SUM([budget_successful_orders]))*100,2),&#10; NULL&#10;))))' />
            </column>
