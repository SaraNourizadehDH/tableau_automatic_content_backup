    <worksheet name='OrderCuts-Table_YoY'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Order Cuts</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='unified_view_customer (rl_intl_markets)' name='federated.1fb23vr1es555v121h0a60dlxyo1' />
          </datasources>
          <datasource-dependencies datasource='federated.1fb23vr1es555v121h0a60dlxyo1'>
            <column caption='ATTR' datatype='integer' name='[Calculation_3280731595824279557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='YoY_% OD Orders' datatype='real' name='[MoM_% OD Orders (copy)_106679036827607054]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([od_successful_orders]) / sum([successful_orders])) - (sum([od_successful_orders_ly]) / sum([successful_orders_ly]))' />
            </column>
            <column caption='YoY_AFV (EUR)' datatype='real' name='[MoM_AFV (EUR)  (copy)_106679036827607055]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(sum([gbv_eur])&#10;/&#10;sum([successful_orders]))&#10;&#10;/&#10;&#10;(sum([gbv_eur_ly])&#10;/&#10;sum([successful_orders_ly]))&#10;)&#10;-1' />
            </column>
            <column caption='YoY_AOV (EUR)' datatype='real' name='[MoM_AOV (EUR) (copy)_106679036827607056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(sum([gmv_eur])&#10;/&#10;sum([successful_orders]))&#10;&#10;/&#10;&#10;(sum([gmv_eur_ly])&#10;/&#10;sum([successful_orders_ly]))&#10;)&#10;-1' />
            </column>
            <column caption='YoY_Android Successful Orders' datatype='real' name='[MoM_Android Successful Orders (copy)_791718763831914520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([android_successful_orders]) / SUM([android_successful_orders_ly])) - 1' />
            </column>
            <column caption='YoY_CVR' datatype='real' name='[MoM_CVR (copy)_392516875964538904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([sessions_w_order]) / SUM([sessions]))&#10;-&#10;(SUM([sessions_w_order_ly]) / SUM([sessions_ly]))' />
            </column>
            <column caption='YoY_GFV (EUR)' datatype='real' name='[MoM_GFV (EUR) (copy)_106679036827607061]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gbv_eur]) / SUM([gbv_eur_ly]))-1' />
            </column>
            <column caption='YoY_GMV (EUR)' datatype='real' name='[MoM_GMV (EUR) (copy)_106679036827607057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gmv_eur]) / SUM([gmv_eur_ly])) - 1' />
            </column>
            <column caption='YoY_Sessions' datatype='real' name='[MoM_Sessions (copy)_392516875964309527]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([sessions]) / SUM([sessions_ly])) -1' />
            </column>
            <column caption='YoY_Successful Orders' datatype='real' name='[MoM_Successful Orders (copy)_106679036827607064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([successful_orders]) / SUM([successful_orders_ly])) - 1' />
            </column>
            <column caption='YoY_Web &amp; Other Successful Orders' datatype='real' name='[MoM_Web &amp; Other Successful Orders (copy)_791718763832602652]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([web_other_successful_orders]) / sum([web_other_successful_orders_ly])) - 1' />
            </column>
            <column caption='YoY_iOS Successful Orders' datatype='real' name='[MoM_iOS Successful Orders (copy)_791718763832393754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([ios_successful_orders]) / sum([ios_successful_orders_ly])) -1' />
            </column>
            <column caption='MoM_Web &amp; Other Successful Orders' datatype='real' name='[Web &amp; Other Successful Orders (copy)_791718763832492059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([web_other_successful_orders]) / sum([web_other_successful_orders_lm])) - 1' />
            </column>
            <column caption='Android Successful Orders' datatype='integer' name='[android_successful_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[android_successful_orders_ly]' role='measure' type='quantitative' />
