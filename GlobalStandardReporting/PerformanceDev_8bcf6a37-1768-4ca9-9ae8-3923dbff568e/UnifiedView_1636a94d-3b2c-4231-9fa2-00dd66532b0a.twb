        <title>
          <formatted-text>
            <run>Order Cuts</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='unified_view_customer (rl_intl_markets)' name='federated.1fb23vr1es555v121h0a60dlxyo1' />
          </datasources>
          <datasource-dependencies datasource='federated.1fb23vr1es555v121h0a60dlxyo1'>
            <column caption='MoM_% of Pickup Restaurants' datatype='real' name='[% of Pickup Restaurants (copy)_392516876024078390]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([online_pickup_vendors]) / SUM([online_vendors]))&#10;-&#10;(SUM([online_pickup_vendors_lm]) / SUM([online_vendors_lm]))' />
            </column>
            <column caption='MoM_AFV (EUR) ' datatype='real' name='[AFV (EUR) (copy)_106679036813000715]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(sum([gbv_eur])&#10;/&#10;sum([successful_orders]))&#10;&#10;/&#10;&#10;(sum([gbv_eur_lm])&#10;/&#10;sum([successful_orders_lm]))&#10;)&#10;-1' />
            </column>
            <column caption='AFV (EUR)' datatype='real' name='[AOV (copy)_880242624986058753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gbv_eur])&#10;/&#10;sum([successful_orders])' />
            </column>
            <column caption='ATTR' datatype='integer' name='[Calculation_3280731595824279557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='NCR as % of GMV' datatype='real' name='[Calculation_3604709333263839232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ncr_ln_local]) / SUM([gmv_ln_local])' />
            </column>
            <column caption='VFD as % of GMV' datatype='real' name='[Calculation_3604709333263986689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([other_incentives_amount_eur]) / SUM([gmv_eur])' />
            </column>
            <column caption='% of Pickup Restaurants' datatype='real' name='[Calculation_3604709333264420866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([online_pickup_vendors]) / SUM([online_vendors])' />
            </column>
            <column caption='MoM_NCR as % of GMV' datatype='real' name='[NCR as % of GMV (copy)_392516876024385592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ncr_ln_local]) / SUM([gmv_ln_local]))&#10;-&#10;(SUM([ncr_ln_local_lm]) / SUM([gmv_ln_local_lm]))' />
            </column>
            <column caption='MoM_New Vendors' datatype='real' name='[New Vendors (copy)_392516876022214708]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([new_online_vendors]) / SUM([new_online_vendors_lm])) - 1' />
            </column>
            <column caption='MoM_VFD as % of GMV' datatype='real' name='[VFD as % of GMV (copy)_392516876024766522]' role='measure' type='quantitative'>
