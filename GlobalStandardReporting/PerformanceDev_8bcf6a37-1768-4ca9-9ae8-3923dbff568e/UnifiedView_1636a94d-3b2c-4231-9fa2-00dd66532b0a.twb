              <calculation class='tableau' formula='(&#10;(SUM([reactivated_customers]) / SUM([cumulative_acquisitions]))&#10;-&#10;(SUM([reactivated_customers_lm]) / SUM([cumulative_acquisitions_lm]))&#10;)' />
            </column>
