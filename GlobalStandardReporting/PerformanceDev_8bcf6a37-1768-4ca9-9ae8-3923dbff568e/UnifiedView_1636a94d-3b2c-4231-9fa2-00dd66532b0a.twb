    <worksheet name='Logistics_2_MoM'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Order Cuts</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='unified_view_customer (rl_intl_markets)' name='federated.1fb23vr1es555v121h0a60dlxyo1' />
          </datasources>
          <datasource-dependencies datasource='federated.1fb23vr1es555v121h0a60dlxyo1'>
            <column caption='MoM_% Stacked Order' datatype='real' name='[% Stacked Order (copy)_729935005755908098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([successful_stacked_orders]) / SUM([od_successful_orders]))&#10;-&#10;(SUM([successful_stacked_orders_lm]) / SUM([od_successful_orders_lm]))' />
            </column>
            <column caption='MoM_Avg. Delivery Time' datatype='real' name='[Avg. Delivery Time (copy)_392516875948363779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM([actual_delivery_time]) / SUM([orders_w_dt_available]))&#10;&#10;/&#10;&#10;(SUM([actual_delivery_time_lm]) / SUM([orders_w_dt_available_lm]))&#10;&#10;)&#10;&#10;-1' />
            </column>
            <column caption='MoM_CPO (EUR)' datatype='real' name='[CPO (EUR) (copy)_729935005756563462]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM([total_cpo_eur]) / SUM([od_successful_orders]))&#10;/&#10;(SUM([total_cpo_eur_lm]) / SUM([od_successful_orders_lm]))&#10;)&#10;-1' />
            </column>
            <column caption='MoM_CSAT Score' datatype='real' name='[CSAT Score (copy)_729935005756321796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(sum([total_csat_score]) / sum([csat_responses]))&#10;/&#10;(sum([total_csat_score_lm]) / sum([csat_responses_lm]))&#10;)&#10;-1' />
            </column>
            <column caption='Avg. Delivery Time' datatype='real' name='[Calculation_1278107537045630977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_delivery_time]) / SUM([orders_w_dt_available])' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_1278107537045811202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_delivered_utr_denominator]) / SUM([rider_hours])' />
            </column>
            <column caption='Logistics Index' datatype='real' name='[Calculation_1278107537045897219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1278107537045630977] / [Calculation_1278107537045811202]' />
            </column>
            <column caption='CSAT Score' datatype='real' name='[Calculation_1278107537105006603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_csat_score]) / sum([csat_responses])' />
            </column>
            <column caption='CPO (EUR)' datatype='real' name='[Calculation_1278107537127419917]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_cpo_eur]) / SUM([od_successful_orders])' />
            </column>
            <column caption='% Stacked Order' datatype='real' name='[Calculation_1278107537127784462]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_stacked_orders]) / SUM([od_successful_orders])' />
            </column>
            <column caption='ATTR' datatype='integer' name='[Calculation_3280731595824279557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='MoM_Logistics Index' datatype='real' name='[Logistics Index (copy)_392516875950563332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;([Calculation_1278107537045630977] / [Calculation_1278107537045811202])&#10;&#10;/&#10;&#10;((SUM([actual_delivery_time_lm]) / SUM([orders_w_dt_available_lm])) / [UTR (copy)_392516875951353861])&#10;)&#10;-1' />
            </column>
            <column caption='MoM_Total Costs (EUR)' datatype='real' name='[Total Costs (EUR) (copy)_392516875958997004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_cpo_eur]) / SUM([total_cpo_eur_lm])) -1' />
            </column>
            <column caption='UTR_lm' datatype='real' name='[UTR (copy)_392516875951353861]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_delivered_utr_denominator_lm]) / SUM([rider_hours_lm])' />
            </column>
            <column caption='MoM_UTR' datatype='real' name='[UTR (copy)_729935005744582656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM([orders_delivered_utr_denominator]) / SUM([rider_hours]))&#10;/&#10;[UTR (copy)_392516875951353861]&#10;)&#10;-1' />
            </column>
