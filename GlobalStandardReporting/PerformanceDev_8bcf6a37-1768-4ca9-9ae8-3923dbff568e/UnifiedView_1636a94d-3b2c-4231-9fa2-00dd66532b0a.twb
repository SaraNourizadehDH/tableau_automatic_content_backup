          </datasources>
          <datasource-dependencies datasource='federated.1fb23vr1es555v121h0a60dlxyo1'>
            <column caption='% Failed OD Orders (Platform)' datatype='real' name='[% Failed OD Orders (Customer) (copy)_1278107537100795912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_failed_orders_platform]) / (sum([od_failed_orders]) + sum([od_successful_orders]))' />
            </column>
            <column caption='% Failed OD Orders (Logistics)' datatype='real' name='[% Failed OD Orders (Platform) (copy)_1278107537100886025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_failed_orders_transport]) / (sum([od_failed_orders]) + sum([od_successful_orders]))' />
            </column>
            <column caption='% Failed OD Orders (Vendor)' datatype='real' name='[% Failed OD Orders (Platform) (copy)_1278107537101082634]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_failed_orders_vendor]) / (sum([od_failed_orders]) + sum([od_successful_orders]))' />
            </column>
            <column caption='% Failed OD Orders (Customer)' datatype='real' name='[% Failed OD Orders (copy)_1278107537100660743]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_failed_orders_customer]) / (sum([od_failed_orders]) + sum([od_successful_orders]))' />
            </column>
            <column caption='Orders with &gt;10 mins delay' datatype='real' name='[Calculation_1278107537084432389]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_late_by_10_mins]) / SUM([orders_w_dt_available])' />
            </column>
            <column caption='% Failed OD Orders' datatype='real' name='[Calculation_1278107537100234758]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_failed_orders]) / (sum([od_failed_orders]) + sum([od_successful_orders]))' />
            </column>
            <column caption='% Seamless Orders' datatype='real' name='[Calculation_1422926416657588227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_seamless_orders]) / sum([total_gcc_orders])' />
            </column>
            <column caption='ATTR' datatype='integer' name='[Calculation_3280731595824279557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='% OD Orders' datatype='real' name='[Calculation_4792955941137625098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_successful_orders]) / sum([successful_orders])' />
            </column>
            <column caption='% Failed Orders' datatype='real' name='[Calculation_4792955941137887243]' role='measure' type='quantitative'>
