            <column caption='MoM_% Failed OD Orders (Customer)' datatype='real' name='[% Failed OD Orders (Customer) (copy)_135741329612906502]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([od_failed_orders_customer]) / (sum([od_failed_orders]) + sum([od_successful_orders])))&#10;-&#10;(sum([od_failed_orders_customer_lm]) / (sum([od_failed_orders_lm]) + sum([od_successful_orders_lm])))' />
