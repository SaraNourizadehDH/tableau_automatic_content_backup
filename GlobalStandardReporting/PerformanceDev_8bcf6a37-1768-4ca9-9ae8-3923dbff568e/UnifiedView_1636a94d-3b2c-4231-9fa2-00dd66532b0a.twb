            <column caption='Vendors Metric Selector3' datatype='string' name='[Vendors Metric Selector2 (copy)_3604709333265920003]' param-domain-type='list' role='measure' type='nominal' value='&quot;New Vendors&quot;'>
              <calculation class='tableau' formula='&quot;New Vendors&quot;' />
            </column>
