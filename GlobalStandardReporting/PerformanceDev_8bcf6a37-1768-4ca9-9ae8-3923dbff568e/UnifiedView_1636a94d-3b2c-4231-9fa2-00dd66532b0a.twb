    <worksheet name='Vendor_2'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Order Cuts</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='unified_view_customer (rl_intl_markets)' name='federated.1fb23vr1es555v121h0a60dlxyo1' />
          </datasources>
          <datasource-dependencies datasource='federated.1fb23vr1es555v121h0a60dlxyo1'>
            <column caption='AFV (EUR)' datatype='real' name='[AOV (copy)_880242624986058753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gbv_eur])&#10;/&#10;sum([successful_orders])' />
            </column>
            <column caption='ATTR' datatype='integer' name='[Calculation_3280731595824279557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='NCR as % of GMV' datatype='real' name='[Calculation_3604709333263839232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ncr_ln_local]) / SUM([gmv_ln_local])' />
            </column>
            <column caption='VFD as % of GMV' datatype='real' name='[Calculation_3604709333263986689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([other_incentives_amount_eur]) / SUM([gmv_eur])' />
            </column>
            <column caption='% of Pickup Restaurants' datatype='real' name='[Calculation_3604709333264420866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([online_pickup_vendors]) / SUM([online_vendors])' />
            </column>
            <column caption='% of Key Accounts' datatype='real' name='[Calculation_4937282237825011713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ka_online_food_vendors]) / sum([online_restaurants])' />
            </column>
            <column caption='% of Local Hero' datatype='real' name='[Calculation_4937282237836836866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ka_local_hero_online_food_vendors]) / SUM([online_restaurants])' />
            </column>
            <column caption='% of Large Chain' datatype='real' name='[Calculation_4937282237837279236]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ka_large_chain_online_food_vendors]) / sum([online_restaurants])' />
            </column>
            <column caption='% of Global KA' datatype='real' name='[Calculation_4937282237837680645]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([ka_global_ka_online_food_vendors]) / sum([online_restaurants])' />
            </column>
            <column caption='% of National KA' datatype='real' name='[KA Local Hero Share (copy)_4937282237837037571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ka_national_ka_online_food_vendors]) / SUM([online_restaurants])' />
            </column>
            <column caption='GFV (EUR)' datatype='real' name='[gbv_eur]' role='measure' type='quantitative' />
            <column caption='GMV (EUR)' datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[gmv_ln_local]' role='measure' type='quantitative' />
