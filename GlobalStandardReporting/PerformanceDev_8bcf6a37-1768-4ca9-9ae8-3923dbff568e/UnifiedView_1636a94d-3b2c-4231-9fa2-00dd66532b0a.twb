          <datasource-dependencies datasource='federated.1fb23vr1es555v121h0a60dlxyo1'>
            <column caption='MoM_% of Almost Churned Customers' datatype='real' name='[% of Almost Churned Customers (copy)_791718763787276304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM([almost_churned_customers]) / SUM([cumulative_acquisitions]))&#10;-&#10;(SUM([almost_churned_customers_lm]) / SUM([cumulative_acquisitions_lm]))&#10;)' />
            </column>
            <column caption='MoM_% of New Inactive Customers' datatype='real' name='[% of New Inactive Customers (copy)_791718763794812946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM([new_inactive_customers]) / SUM([cumulative_acquisitions]))&#10;-&#10;(SUM([new_inactive_customers_lm]) / SUM([cumulative_acquisitions_lm]))&#10;)' />
