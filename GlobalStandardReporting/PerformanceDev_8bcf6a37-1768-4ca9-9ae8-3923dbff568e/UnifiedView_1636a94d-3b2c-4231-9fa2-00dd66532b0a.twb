              <calculation class='tableau' formula='&quot;Acquisitions&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fb23vr1es555v121h0a60dlxyo1'>
            <column caption='Avg. Delivery Time' datatype='real' name='[Calculation_1278107537045630977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_delivery_time]) / SUM([orders_w_dt_available])' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_1278107537045811202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_delivered_utr_denominator]) / SUM([rider_hours])' />
            </column>
            <column caption='Logistics Index' datatype='real' name='[Calculation_1278107537045897219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1278107537045630977] / [Calculation_1278107537045811202]' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_363947213370679296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_w_order]) / SUM([sessions])' />
            </column>
            <column caption='% OD Orders' datatype='real' name='[Calculation_4792955941137625098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_successful_orders]) / sum([successful_orders])' />
            </column>
            <column caption='% Failed Orders' datatype='real' name='[Calculation_4792955941137887243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders]) / (SUM([successful_orders]) + SUM([failed_orders]))' />
            </column>
            <column caption='KA Order Share' datatype='real' name='[Calculation_6483072436288430080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ka_successful_orders])&#10;/&#10;SUM([successful_orders])' />
            </column>
            <column caption='Commission Rate' datatype='real' name='[Calculation_6483072436301348865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_commission_eur])&#10;/&#10;SUM([commissionable_value_eur])' />
            </column>
            <column caption='FLGPO' datatype='real' name='[Calculation_6483072436301590530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgpo_eur])&#10;/&#10;SUM([orders_profitability])' />
