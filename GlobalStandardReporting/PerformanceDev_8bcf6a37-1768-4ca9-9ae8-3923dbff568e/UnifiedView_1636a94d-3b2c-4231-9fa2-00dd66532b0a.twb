                    <run auto-url='true' fontsize='8' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/spreadsheets/d/1pu2VJh5vvGPIyiBK-Bhoux0uTWEIqOmtTv1dJlbGOG8/edit?pli=1#gid=2133127172&amp;quot;'>https://docs.google.com/spreadsheets/d/1pu2VJh5vvGPIyiBK-Bhoux0uTWEIqOmtTv1dJlbGOG8/edit?pli=1#gid=2133127172</run>
                    <run>Æ&#10;</run>
                    <run fontsize='8'>All monetary values are in EURO</run>
                    <run>Æ&#10;</run>
