              <calculation class='tableau' formula='(sum([od_failed_orders]) / (sum([od_failed_orders]) + sum([od_successful_orders])))&#10;-&#10;(sum([od_failed_orders_lm]) / (sum([od_failed_orders_lm]) + sum([od_successful_orders_lm])))' />
            </column>
            <column caption='MoM_% Failed Orders' datatype='real' name='[% Failed Orders (copy)_392516875948040194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([failed_orders]) / (SUM([successful_orders]) + SUM([failed_orders])))&#10;-&#10;(SUM([failed_orders_lm]) / (SUM([successful_orders_lm]) + SUM([failed_orders_lm])))' />
            </column>
            <column caption='MoM_% OD Orders' datatype='real' name='[% OD Orders (copy)_106679036810448903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([od_successful_orders]) / sum([successful_orders])) - (sum([od_successful_orders_lm]) / sum([successful_orders_lm]))' />
            </column>
            <column caption='MoM_% Seamless Orders' datatype='real' name='[% Seamless Orders (copy)_135741329594429440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([total_seamless_orders]) / sum([total_gcc_orders]))&#10;&#10;-&#10;&#10;(sum([total_seamless_orders_lm]) / sum([total_gcc_orders_lm]))' />
            </column>
            <column caption='Orders with &gt;10 mins delay' datatype='real' name='[Calculation_1278107537084432389]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_late_by_10_mins]) / SUM([orders_w_dt_available])' />
            </column>
            <column caption='% Failed OD Orders' datatype='real' name='[Calculation_1278107537100234758]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_failed_orders]) / (sum([od_failed_orders]) + sum([od_successful_orders]))' />
            </column>
            <column caption='% Seamless Orders' datatype='real' name='[Calculation_1422926416657588227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_seamless_orders]) / sum([total_gcc_orders])' />
            </column>
            <column caption='ATTR' datatype='integer' name='[Calculation_3280731595824279557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='% OD Orders' datatype='real' name='[Calculation_4792955941137625098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_successful_orders]) / sum([successful_orders])' />
            </column>
            <column caption='% Failed Orders' datatype='real' name='[Calculation_4792955941137887243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders]) / (SUM([successful_orders]) + SUM([failed_orders]))' />
            </column>
            <column caption='MoM_Orders with &gt;10 mins delay' datatype='real' name='[Orders with &gt;10 mins delay (copy)_135741329594732546]' role='measure' type='quantitative'>
