    <worksheet name='Overall_Perf_2_MoM'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Order Cuts</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='unified_view_customer (rl_intl_markets)' name='federated.1fb23vr1es555v121h0a60dlxyo1' />
          </datasources>
          <datasource-dependencies datasource='federated.1fb23vr1es555v121h0a60dlxyo1'>
            <column caption='MoM_% Failed Orders' datatype='real' name='[% Failed Orders (copy)_392516875948040194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([failed_orders]) / (SUM([successful_orders]) + SUM([failed_orders])))&#10;-&#10;(SUM([failed_orders_lm]) / (SUM([successful_orders_lm]) + SUM([failed_orders_lm])))' />
            </column>
            <column caption='MoM_Acquisitions' datatype='real' name='[Acquisitions (copy)_392516875947425792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([acquisitions]) / SUM([acquisitions_lm])) - 1' />
            </column>
            <column caption='MoM_Active Customers' datatype='real' name='[Active Customers (copy)_392516875947839489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([active_customers]) / SUM([active_customers_lm])) - 1' />
            </column>
            <column caption='MoM_Avg. Delivery Time' datatype='real' name='[Avg. Delivery Time (copy)_392516875948363779]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM([actual_delivery_time]) / SUM([orders_w_dt_available]))&#10;&#10;/&#10;&#10;(SUM([actual_delivery_time_lm]) / SUM([orders_w_dt_available_lm]))&#10;&#10;)&#10;&#10;-1' />
            </column>
            <column caption='MoM_CVR' datatype='real' name='[CVR (copy)_392516875958378505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([sessions_w_order]) / SUM([sessions]))&#10;-&#10;(SUM([sessions_w_order_lm]) / SUM([sessions_lm]))' />
            </column>
            <column caption='Avg. Delivery Time' datatype='real' name='[Calculation_1278107537045630977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_delivery_time]) / SUM([orders_w_dt_available])' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_1278107537045811202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_delivered_utr_denominator]) / SUM([rider_hours])' />
            </column>
            <column caption='Logistics Index' datatype='real' name='[Calculation_1278107537045897219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1278107537045630977] / [Calculation_1278107537045811202]' />
            </column>
            <column caption='ATTR' datatype='integer' name='[Calculation_3280731595824279557]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_363947213370679296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_w_order]) / SUM([sessions])' />
            </column>
            <column caption='% Failed Orders' datatype='real' name='[Calculation_4792955941137887243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders]) / (SUM([successful_orders]) + SUM([failed_orders]))' />
            </column>
            <column caption='KA Order Share' datatype='real' name='[Calculation_6483072436288430080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ka_successful_orders])&#10;/&#10;SUM([successful_orders])' />
            </column>
            <column caption='Commission Rate' datatype='real' name='[Calculation_6483072436301348865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_commission_eur])&#10;/&#10;SUM([commissionable_value_eur])' />
            </column>
            <column caption='FLGPO' datatype='real' name='[Calculation_6483072436301590530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgpo_eur])&#10;/&#10;SUM([orders_profitability])' />
            </column>
            <column caption='MoM_Commission Rate' datatype='real' name='[Commission Rate (copy)_392516875958730762]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([amt_commission_eur])&#10;/&#10;SUM([commissionable_value_eur]))&#10;&#10;-&#10;&#10;(SUM([amt_commission_eur_lm])&#10;/&#10;SUM([commissionable_value_eur_lm]))' />
            </column>
            <column caption='MoM_FLGPO' datatype='real' name='[FLGPO (copy)_392516875959877646]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM([flgpo_eur])&#10;/&#10;SUM([orders_profitability]))&#10;/&#10;(SUM([flgpo_eur_lm])&#10;/&#10;SUM([orders_profitability_lm]))&#10;)&#10;-1' />
            </column>
            <column caption='GPO' datatype='real' name='[FLGPO (copy)_6483072436301721603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gpo_eur])&#10;/&#10;SUM([orders_profitability])' />
            </column>
            <column caption='MoM_GPO' datatype='real' name='[GPO (copy)_392516875959169037]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM([gpo_eur])&#10;/&#10;SUM([orders_profitability]))&#10;&#10;/&#10;&#10;(SUM([gpo_eur_lm])&#10;/&#10;SUM([orders_profitability_lm]))&#10;)&#10;-1' />
            </column>
            <column caption='MoM_KA Order Share' datatype='real' name='[KA Order Share (copy)_392516875956985862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;(SUM([ka_successful_orders])&#10;/&#10;SUM([successful_orders]))&#10;&#10;-&#10;&#10;SUM([ka_successful_orders_lm])&#10;/&#10;SUM([successful_orders_lm])&#10;)' />
            </column>
            <column caption='MoM_Logistics Index' datatype='real' name='[Logistics Index (copy)_392516875950563332]' role='measure' type='quantitative'>
