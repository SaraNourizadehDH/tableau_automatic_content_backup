    <worksheet name='CustomerBaseEvo-MetricSelector1'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold' fontsize='12'>&lt;</run>
            <run fontname='Tableau Bold' fontsize='12'>[Parameters].[Parameter 1]</run>
            <run fontname='Tableau Bold' fontsize='12'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='unified_view_customer (rl_intl_markets)' name='federated.1fb23vr1es555v121h0a60dlxyo1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Customer Base Metric Selector1' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Penetration (\%)&quot;'>
              <calculation class='tableau' formula='&quot;Penetration (%)&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1fb23vr1es555v121h0a60dlxyo1'>
            <column caption='% of Reactivated Customers' datatype='real' name='[% of Almost Churned Customers (copy)_1095148769752227840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reactivated_customers]) / SUM([cumulative_acquisitions])' />
            </column>
            <column caption='% of New Inactive Customers' datatype='real' name='[% of Almost Churned Customers (copy)_880242624993705986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([new_inactive_customers]) / SUM([cumulative_acquisitions])' />
            </column>
            <column caption='% of Reordering Customers (M6)' datatype='real' name='[% of Reordering Customers (M1) (copy) (copy)_3280731595788988418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([c6_users]) / SUM([c6_acquisitions])' />
            </column>
            <column caption='% of Reordering Customers (M3)' datatype='real' name='[% of Reordering Customers (M1) (copy)_3280731595788980225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([c3_users]) / SUM([c3_acquisitions])' />
            </column>
            <column caption='Addressable Population' datatype='real' datatype-customized='true' name='[Addressable Population (copy)_4792955941129351172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [country_code] : MAX([addressable_population])})' />
            </column>
            <column caption='% of Almost Churned Customers' datatype='real' name='[Calculation_1422926416649543681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([almost_churned_customers]) / SUM([cumulative_acquisitions])' />
            </column>
            <column caption='Customer Base Metrics (Parameter1)' datatype='real' name='[Calculation_2466424526476967937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Parameters].[Parameter 1] = &apos;Penetration (%)&apos;, ROUND([Calculation_4792955941130321925] * 100, 2),&#10;IIF([Parameters].[Parameter 1] = &apos;Acquisitions&apos;, SUM([acquisitions]),&#10;IIF([Parameters].[Parameter 1] = &apos;Acquisition Velocity (%)&apos;, ROUND([Calculation_4792955941135241223] * 100, 2),&#10;IIF([Parameters].[Parameter 1] = &apos;Active Customers&apos;, SUM([active_customers]),&#10;IIF([Parameters].[Parameter 1] = &apos;Activity Rate (%)&apos;, ROUND([Calculation_4792955941131755526]*100,2),&#10;IIF([Parameters].[Parameter 1] = &apos;Frequency&apos;, [Calculation_4792955941136257033],&#10;IIF([Parameters].[Parameter 1] = &apos;% of Reordering Customers (M1) (%)&apos;, ROUND([Calculation_3280731595788832768]*100,2),&#10;IIF([Parameters].[Parameter 1] = &apos;% of Reordering Customers (M3) (%)&apos;, ROUND([% of Reordering Customers (M1) (copy)_3280731595788980225]*100,2),&#10;IIF([Parameters].[Parameter 1] = &apos;% of Reordering Customers (M6) (%)&apos;, ROUND([% of Reordering Customers (M1) (copy) (copy)_3280731595788988418]*100,2),&#10;IIF([Parameters].[Parameter 1] = &apos;% of Reactivated Customers (%)&apos;, ROUND([% of Almost Churned Customers (copy)_1095148769752227840]*100,2),&#10;IIF([Parameters].[Parameter 1] = &apos;% of Almost Churned Customers (%)&apos;, ROUND([Calculation_1422926416649543681]*100, 2),&#10;IIF([Parameters].[Parameter 1] = &apos;% of New Inactive Customers (%)&apos;, ROUND([% of Almost Churned Customers (copy)_880242624993705986]*100, 2),&#10;IIF([Parameters].[Parameter 1] = &apos;Orders / Month / Addressable Pop.&apos;, [Calculation_4792955941136019464], NULL&#10;)))))))))))))' />
            </column>
            <column caption='% of Reordering Customers (M1)' datatype='real' name='[Calculation_3280731595788832768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([c1_users]) / SUM([c1_acquisitions])' />
            </column>
            <column caption='Penetration' datatype='real' name='[Calculation_4792955941130321925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([cumulative_acquisitions]) / [Addressable Population (copy)_4792955941129351172]' />
            </column>
            <column caption='Activity Rate' datatype='real' name='[Calculation_4792955941131755526]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([active_customers]) / sum([cumulative_acquisitions])' />
            </column>
            <column caption='Acquisition Velocity' datatype='real' name='[Calculation_4792955941135241223]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(([Addressable Population (copy)_4792955941129351172]) &gt; MAX([cumulative_acquisitions]), &#10;SUM([acquisitions]) / (([Addressable Population (copy)_4792955941129351172]) - MAX([cumulative_acquisitions])),&#10;SUM([acquisitions]) / (MAX([population]) - MAX([cumulative_acquisitions]))&#10;)' />
            </column>
            <column caption='Orders / Month / Addressable Pop.' datatype='real' name='[Calculation_4792955941136019464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(([Addressable Population (copy)_4792955941129351172]) &gt; MAX([cumulative_acquisitions]), &#10;SUM([successful_orders]) / ([Addressable Population (copy)_4792955941129351172]),&#10;SUM([successful_orders]) / (MAX([population]))&#10;)' />
            </column>
            <column caption='Frequency' datatype='real' name='[Calculation_4792955941136257033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders]) / SUM([active_customers])' />
            </column>
            <column caption='Acquisitions' datatype='integer' name='[acquisitions]' role='measure' type='quantitative' />
            <column caption='Active Customers' datatype='integer' name='[active_customers]' role='measure' type='quantitative' />
            <column aggregation='CountD' caption='Addressable Population Raw' datatype='real' datatype-customized='true' name='[addressable_population]' role='measure' type='quantitative' />
            <column caption='Almost Churned Customers' datatype='integer' name='[almost_churned_customers]' role='measure' type='quantitative' />
            <column datatype='integer' name='[c1_acquisitions]' role='measure' type='quantitative' />
            <column datatype='integer' name='[c1_users]' role='measure' type='quantitative' />
            <column datatype='integer' name='[c3_acquisitions]' role='measure' type='quantitative' />
            <column datatype='integer' name='[c3_users]' role='measure' type='quantitative' />
            <column datatype='integer' name='[c6_acquisitions]' role='measure' type='quantitative' />
            <column datatype='integer' name='[c6_users]' role='measure' type='quantitative' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Cumulative Acquisitions' datatype='integer' name='[cumulative_acquisitions]' role='measure' type='quantitative' />
            <column datatype='boolean' name='[is_last_12_months]' role='dimension' type='nominal' />
            <column caption='New Inactive Customers' datatype='integer' name='[new_inactive_customers]' role='measure' type='quantitative' />
            <column-instance column='[is_last_12_months]' derivation='None' name='[none:is_last_12_months:nk]' pivot='key' type='nominal' />
            <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
            <column-instance column='[sub_entity]' derivation='None' name='[none:sub_entity:nk]' pivot='key' type='nominal' />
            <column aggregation='CountD' caption='Population' datatype='real' datatype-customized='true' name='[population]' role='measure' type='quantitative' />
            <column caption='Reactivated Customers' datatype='integer' name='[reactivated_customers]' role='measure' type='quantitative' />
            <column caption='Report Month' datatype='date' name='[report_month]' role='dimension' type='ordinal' />
            <column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal' />
            <column caption='Sub-entity' datatype='string' name='[sub_entity]' role='dimension' type='nominal' />
            <column caption='Successful Orders' datatype='integer' name='[successful_orders]' role='measure' type='quantitative' />
            <column-instance column='[report_month]' derivation='Month-Trunc' name='[tmn:report_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_2466424526476967937]' derivation='User' name='[usr:Calculation_2466424526476967937:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1fb23vr1es555v121h0a60dlxyo1].[none:is_last_12_months:nk]' filter-group='4'>
            <groupfilter function='member' level='[none:is_last_12_months:nk]' member='true' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
