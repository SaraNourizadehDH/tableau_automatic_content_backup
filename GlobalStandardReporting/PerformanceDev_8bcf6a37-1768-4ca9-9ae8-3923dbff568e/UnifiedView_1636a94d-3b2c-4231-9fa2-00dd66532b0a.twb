            <datasource caption='unified_view_customer (rl_intl_markets)' name='federated.1fb23vr1es555v121h0a60dlxyo1' />
          </datasources>
          <datasource-dependencies datasource='federated.1fb23vr1es555v121h0a60dlxyo1'>
            <column caption='Addressable Population' datatype='real' datatype-customized='true' name='[Addressable Population (copy)_4792955941129351172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({FIXED [country_code] : MAX([addressable_population])})' />
            </column>
            <column caption='Blank_3' datatype='real' datatype-customized='true' name='[Blank_1 (copy) (copy)_4792955940474044418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(null)' />
            </column>
            <column caption='Blank_2' datatype='real' datatype-customized='true' name='[Blank_1 (copy)_4792955940474036225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(null)' />
            </column>
            <column caption='Avg. Delivery Time' datatype='real' name='[Calculation_1278107537045630977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_delivery_time]) / SUM([orders_w_dt_available])' />
            </column>
            <column caption='UTR' datatype='real' name='[Calculation_1278107537045811202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_delivered_utr_denominator]) / SUM([rider_hours])' />
            </column>
            <column caption='Logistics Index' datatype='real' name='[Calculation_1278107537045897219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1278107537045630977] / [Calculation_1278107537045811202]' />
            </column>
            <column caption='% of Almost Churned Customers' datatype='real' name='[Calculation_1422926416649543681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([almost_churned_customers]) / SUM([cumulative_acquisitions])' />
            </column>
            <column caption='% Seamless Orders' datatype='real' name='[Calculation_1422926416657588227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_seamless_orders]) / sum([total_gcc_orders])' />
            </column>
            <column caption='% D+S Fee / AFV (OD)' datatype='real' name='[Calculation_1422926416658300932]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([od_sf_eur]) + SUM([od_df_eur]))&#10;/&#10;SUM([od_gbv_eur])' />
            </column>
            <column caption='Avg. Food Rating' datatype='real' name='[Calculation_1422926416880652293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_converted_rating]) / sum([rated_orders])' />
            </column>
            <column caption='Orders with poor rating' datatype='real' name='[Calculation_1422926416882114566]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_with_poor_rating]) / sum([rated_orders])' />
            </column>
            <column caption='NPS Pickup' datatype='real' name='[Calculation_1422926416955162631]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([nps_pu_promoters]) / SUM([nps_pu_responses]))&#10;-&#10;(SUM([nps_pu_detractors]) / SUM([nps_pu_responses]))) * 100' />
            </column>
            <column caption='Blank_1' datatype='real' datatype-customized='true' name='[Calculation_4792955940473978880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(null)' />
            </column>
            <column caption='Penetration' datatype='real' name='[Calculation_4792955941130321925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([cumulative_acquisitions]) / [Addressable Population (copy)_4792955941129351172]' />
            </column>
            <column caption='Activity Rate' datatype='real' name='[Calculation_4792955941131755526]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([active_customers]) / sum([cumulative_acquisitions])' />
            </column>
            <column caption='Acquisition Velocity' datatype='real' name='[Calculation_4792955941135241223]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(([Addressable Population (copy)_4792955941129351172]) &gt; MAX([cumulative_acquisitions]), &#10;SUM([acquisitions]) / (([Addressable Population (copy)_4792955941129351172]) - MAX([cumulative_acquisitions])),&#10;SUM([acquisitions]) / (MAX([population]) - MAX([cumulative_acquisitions]))&#10;)' />
            </column>
            <column caption='Orders / Month / Addressable Pop.' datatype='real' name='[Calculation_4792955941136019464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(([Addressable Population (copy)_4792955941129351172]) &gt; MAX([cumulative_acquisitions]), &#10;SUM([successful_orders]) / ([Addressable Population (copy)_4792955941129351172]),&#10;SUM([successful_orders]) / (MAX([population]))&#10;)' />
            </column>
            <column caption='Frequency' datatype='real' name='[Calculation_4792955941136257033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders]) / SUM([active_customers])' />
            </column>
            <column caption='% OD Orders' datatype='real' name='[Calculation_4792955941137625098]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_successful_orders]) / sum([successful_orders])' />
            </column>
            <column caption='% Failed Orders' datatype='real' name='[Calculation_4792955941137887243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders]) / (SUM([successful_orders]) + SUM([failed_orders]))' />
            </column>
            <column caption='% Discounted Orders' datatype='real' name='[Calculation_4792955941138612236]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([discounted_successful_orders]) / sum([successful_orders])' />
            </column>
            <column caption='NPS Overall' datatype='real' name='[NPS Dmart (copy)_1422926416955723787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([nps_ao_promoters]) / SUM([nps_ao_responses]))&#10;-&#10;(SUM([nps_ao_detractors]) / SUM([nps_ao_responses]))) * 100' />
            </column>
            <column caption='NPS Food' datatype='real' name='[NPS Pickup (copy)_1422926416955375624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([nps_food_promoters]) / SUM([nps_food_responses]))&#10;-&#10;(SUM([nps_food_detractors]) / SUM([nps_food_responses]))) * 100' />
            </column>
            <column caption='NPS Dmart' datatype='real' name='[NPS Pickup (copy)_1422926416955494409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([nps_dmart_promoters]) / SUM([nps_dmart_responses]))&#10;-&#10;(SUM([nps_dmart_detractors]) / SUM([nps_dmart_responses]))) * 100' />
            </column>
            <column caption='NPS Local Store' datatype='real' name='[NPS Pickup (copy)_1422926416955605002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([nps_lc_promoters]) / SUM([nps_lc_responses]))&#10;-&#10;(SUM([nps_lc_detractors]) / SUM([nps_lc_responses]))) * 100' />
            </column>
