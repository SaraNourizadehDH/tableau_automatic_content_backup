      <aliases enabled='yes' />
      <column caption='AA-Downloads_data_availability' datatype='string' name='[Calculation_1164602736863920128]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([appannie_ios_all_downloads (copy)] &gt; 0 AND [appannie_and_all_downloads] &gt; 0 AND [appannie_ios_all_downloads] &gt; 0) THEN &apos;Unified&apos;&#10;ELSEIF ([appannie_ios_all_downloads (copy)] &gt; 0 AND [appannie_and_all_downloads] &gt; 0) THEN &apos;Android&apos;&#10;ELSEIF ([appannie_ios_all_downloads (copy)] &gt; 0 AND [appannie_ios_all_downloads] &gt; 0) THEN &apos;iOs&apos;&#10;END' />
      </column>
      <column caption='FB_IG_SoV Switch' datatype='integer' name='[Calculation_130322931310997504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(&#10;IIF([Parameters].[Parameter 10] = &apos;Facebook&apos;, [fb_reached],&#10;IIF([Parameters].[Parameter 10] = &apos;Instagram&apos;, [ig_reached],[fb_ig_reached])))' />
      </column>
      <column caption='user_filter' datatype='boolean' name='[Calculation_1393723376942686208]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
      </column>
      <column caption='entity_type_filter' datatype='string' name='[Calculation_1839087133215158272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF&#10;    [country_code] IN (&apos;ES&apos;, &apos;PT&apos;, &apos;IT&apos;, &apos;SI&apos;, &apos;PL&apos;, &apos;RO&apos;, &apos;BA&apos;, &apos;ME&apos;, &apos;BG&apos;, &apos;HR&apos;, &apos;RS&apos;, &apos;UA&apos;, &apos;GE&apos;, &apos;AM&apos;, &apos;MD&apos;, &apos;AD&apos;, &apos;KZ&apos;, &apos;KG&apos;, &apos;TN&apos;, &apos;MA&apos;, &apos;UG&apos;, &apos;KE&apos;, &apos;CI&apos;, &apos;NG&apos;, &apos;GH&apos;) THEN &apos;Glovo Markets&apos;&#10;ELSEIF &#10;    LEFT([management_entity_group], 7) = &apos;Other -&apos; THEN &apos;Non DH/Glovo Markets&apos;&#10;ELSE&#10;    &apos;DH Markets&apos;&#10;END' />
      </column>
      <column caption='SW_switch_label_sign' datatype='string' name='[Calculation_2292050799309238274]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 1 1] = 1, &apos;%&apos;, &apos;&apos;)' />
      </column>
      <column caption='dh_actuals_switch_sign' datatype='string' name='[Calculation_231935399999803392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='iif([Parameters].[Parameter 9] = &apos;Voucher Orders %&apos;, &apos;%&apos;, &apos;&apos;)' />
      </column>
      <column caption='Month/Quarter Switch' datatype='string' name='[Calculation_253749702624894977]' role='dimension' type='nominal'>
