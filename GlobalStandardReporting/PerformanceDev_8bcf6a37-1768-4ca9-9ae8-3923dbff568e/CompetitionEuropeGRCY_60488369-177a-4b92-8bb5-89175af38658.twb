    <worksheet name='Pickup'>
      <table>
        <view>
          <datasources>
            <datasource caption='scraping_vendors_europe (geolocation)' name='federated.0f1ijzw1mtuprj192xuxd190dpu6' />
          </datasources>
          <datasource-dependencies datasource='federated.0f1ijzw1mtuprj192xuxd190dpu6'>
            <column caption='# Vendors' datatype='integer' name='[# Vendors Comp (copy)_180425478653558784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([source])' />
            </column>
            <column caption='Pickup Comp' datatype='integer' name='[Calculation_1203305547490619394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [is_pickup] = TRUE THEN [Calculation_5612540681477500929] END' />
            </column>
            <column caption='Pickup % Comp' datatype='real' name='[Calculation_1203305547492749327]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1203305547490619394])/SUM([Calculation_5612540681477500929])' />
            </column>
            <column caption='MAX(15,15)' datatype='integer' name='[Calculation_1203305547558051875]' role='measure' type='quantitative' user:unnamed='Pickup'>
              <calculation class='tableau' formula='MAX(15,15)' />
            </column>
            <column caption='# Vendors Comp' datatype='integer' name='[Calculation_5612540681477500929]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF source != &apos;DH&apos; THEN 1 ELSE 0 END' />
            </column>
            <column caption='City Name' datatype='string' name='[Calculation_720013007576825862]' role='dimension' type='nominal'>
