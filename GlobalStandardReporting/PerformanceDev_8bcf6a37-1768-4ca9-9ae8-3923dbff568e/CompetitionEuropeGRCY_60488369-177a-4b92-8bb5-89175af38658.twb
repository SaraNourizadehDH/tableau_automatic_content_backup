  <worksheets>
    <worksheet name='Cities by source'>
      <table>
        <view>
          <datasources>
            <datasource caption='scraping_vendors_europe (geolocation)' name='federated.0f1ijzw1mtuprj192xuxd190dpu6' />
          </datasources>
          <datasource-dependencies datasource='federated.0f1ijzw1mtuprj192xuxd190dpu6'>
            <column caption='# Vendors' datatype='integer' name='[# Vendors Comp (copy)_180425478653558784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([source])' />
            </column>
            <column caption='Population Buckets' datatype='string' name='[Calculation_773211777478057986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [mapped_population] &lt; 25000 THEN &quot;0-25K&quot;&#13;&#10;ELSEIF [mapped_population] &lt; 50000 THEN &quot;25-50K&quot;&#13;&#10;ELSEIF [mapped_population] &lt; 75000 THEN &quot;50-75K&quot;&#13;&#10;ELSEIF [mapped_population] &lt; 100000 THEN &quot;75-100K&quot;&#13;&#10;ELSEIF [mapped_population] &lt; 125000 THEN &quot;100-125K&quot;&#13;&#10;ELSEIF [mapped_population] &lt; 150000 THEN &quot;125-150K&quot;&#13;&#10;ELSEIF [mapped_population] &lt; 175000 THEN &quot;150-175K&quot;&#13;&#10;ELSEIF [mapped_population] &lt; 200000 THEN &quot;175-200K&quot;&#13;&#10;ELSEIF [mapped_population] &gt;=200000 THEN &quot;&gt;=200K&quot;&#13;&#10;ELSE &quot;NA&quot; END' />
            </column>
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Delivery Type' datatype='string' name='[delivery_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column datatype='boolean' name='[is_online]' role='dimension' type='nominal' />
            <column datatype='real' name='[mapped_population]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_773211777478057986]' derivation='None' name='[none:Calculation_773211777478057986:nk]' pivot='key' type='nominal' />
            <column-instance column='[City]' derivation='None' name='[none:City:nk]' pivot='key' type='nominal' />
            <column-instance column='[delivery_type]' derivation='None' name='[none:delivery_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_online]' derivation='None' name='[none:is_online:nk]' pivot='key' type='nominal' />
            <column-instance column='[source]' derivation='None' name='[none:source:nk]' pivot='key' type='nominal' />
            <column-instance column='[vertical]' derivation='None' name='[none:vertical:nk]' pivot='key' type='nominal' />
            <column caption='Source' datatype='string' name='[source]' role='dimension' type='nominal' />
            <column-instance column='[# Vendors Comp (copy)_180425478653558784]' derivation='User' name='[usr:# Vendors Comp (copy)_180425478653558784:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[vertical]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0f1ijzw1mtuprj192xuxd190dpu6].[Tooltip (Population Buckets,Source)]'>
