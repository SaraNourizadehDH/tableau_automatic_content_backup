  QUALIFY ROW_NUMBER() OVER(PARTITION BY lg_vendors.global_entity_id, lg_vendors.code ORDER BY  dps_mov_config_date DESC, vendor_config.priority ASC, pricing_config.mov_config.minimum_order_value_local ASC) = 1) as mov_data
