            <column caption='one' datatype='integer' name='[Calculation_1203305547531870240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='City Category' datatype='string' name='[Calculation_1203305547575844900]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [City Set]&#13;&#10;THEN &quot;Top &quot; + str([Parameters].[Parameter 2]) + &quot; Cities&quot;&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END' />
            </column>
            <column caption='City ' datatype='string' name='[Calculation_1203305547577634853]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 14]=&quot;Collapse&quot; THEN&#13;&#10;IF [City Set]&#13;&#10;THEN  [City]&#13;&#10;ELSE &quot;Others&quot; END&#13;&#10;ELSE [City] END' />
            </column>
            <column caption='MOV corrected' datatype='real' name='[Calculation_180425479079682057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[mov_new]' />
            </column>
            <column caption='City Name' datatype='string' name='[Calculation_720013007576825862]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='UPPER(LEFT ([City],1)) + LOWER(RIGHT([City],LEN([City])-1))' />
            </column>
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='MOV - Occurence Country' datatype='integer' name='[MOV - Occurence (copy)_191684479125721106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [global_entity_id],[source],[Calculation_180425479079682057] : COUNT([mov_new])}' />
            </column>
            <column caption='MOV max occurence per Country' datatype='integer' name='[MOV max occurence per City (copy)_191684479125721108]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id],[source]:MAX&#13;&#10;([MOV - Occurence (copy)_191684479125721106])}' />
            </column>
            <column caption='MOV per Country' datatype='real' name='[MOV per City (copy)_191684479125721107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [MOV max occurence per City (copy)_191684479125721108] = [MOV - Occurence (copy)_191684479125721106] THEN&#13;&#10;[Calculation_180425479079682057] END' />
            </column>
            <column-instance column='[MOV per City (copy)_191684479125721107]' derivation='Avg' name='[avg:MOV per City (copy)_191684479125721107:qk]' pivot='key' type='quantitative' />
