      lower(country_code) as country_code,
      city_id,
      SUM(population) as population
    FROM
      int-per-data-team.test_dataset.population_by_logistics_city_zones as z
    INNER JOIN
      fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities as e
    ON
      z.entity_id = e.global_entity_id
    GROUP BY
      1,2
    ORDER BY
      1) as population_data
  ON
    zones_to_locations.city_id = population_data.city_id
  AND
    zones_to_locations.country_code = population_data.country_code

)
--Final output
SELECT
  overall_data.*,
  mov_local,
  mov_new,
  mov_sf.service_fee as sf,
  subscription
FROM
  (SELECT
    DISTINCT
    w.* EXCEPT(country_code,zone_name,city,delivery_polygon),
    ge.global_entity_id,
    w.city as scraped_city,
    UPPER(w.country_code)as country,
    CASE 
