      <column caption='nps_group_type_label' datatype='string' name='[Calculation_5068519941432397826]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 11] = &apos;1&apos; AND [Parameters].[Parameter 12] = &apos;1&apos;, &apos;Detractor Score:&apos;,&#10;IIF([Parameters].[Parameter 11] = &apos;2&apos; AND [Parameters].[Parameter 12] = &apos;1&apos;, &apos;Promoter Score:&apos;, &#10;&#10;IIF([Parameters].[Parameter 11] = &apos;1&apos; AND [Parameters].[Parameter 12] = &apos;2&apos;, &apos;Detractor Score (Food):&apos;,&#10;IIF([Parameters].[Parameter 11] = &apos;2&apos; AND [Parameters].[Parameter 12] = &apos;2&apos;, &apos;Promoter Score (Food):&apos;, &#10;&#10;IIF([Parameters].[Parameter 11] = &apos;1&apos; AND [Parameters].[Parameter 12] = &apos;3&apos;, &apos;Detractor Score (QC):&apos;,&#10;IIF([Parameters].[Parameter 11] = &apos;2&apos; AND [Parameters].[Parameter 12] = &apos;3&apos;, &apos;Promoter Score (QC):&apos;, &#10;&#10;&#10;NULL))))))' />
      </column>
      <column caption='appannie_downloads_confidence_flag_disclaimer' datatype='string' name='[Calculation_5104056175524900865]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF(ISNULL([appannie_downloads_confidence_flag]), &apos;&apos;,&#10;IIF([appannie_downloads_confidence_flag] = 1, &apos;&apos;,&#10;IIF([appannie_downloads_confidence_flag] = 2, &apos;Warning: Analyses showed data.ai download estimates do not correlate with actual download trends. Please be careful when using this data.&apos;,&#10;IIF([appannie_downloads_confidence_flag] = 3, &apos;Warning: Analyses showed data.ai download numbers correlate with paid downloads, rather than total downloads (organic + paid).&apos;, &#10;IIF([appannie_downloads_confidence_flag] = 4, &apos;Warning: Analyses showed data.ai download numbers correlate with organic (unpaid) downloads, rather than total downloads (organic + paid).&apos;, &#10;IIF([appannie_downloads_confidence_flag] = 5, &apos;Warning: Analyses showed data.ai download estimates do not correlate with actual download trends. This metric is therefore not shown.&apos;, &#10;&apos;&apos;))))))' />
