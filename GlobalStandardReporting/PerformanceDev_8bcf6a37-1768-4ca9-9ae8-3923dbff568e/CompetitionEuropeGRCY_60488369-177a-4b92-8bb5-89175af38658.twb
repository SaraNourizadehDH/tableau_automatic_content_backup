  FROM `fulfillment-dwh-production.pandata_curated.lg_vendors` AS lg_vendors
  LEFT JOIN UNNEST(lg_vendors.dps) AS dps
         ON dps.is_active
  LEFT JOIN UNNEST(dps.vendor_config) AS vendor_config
  LEFT JOIN UNNEST(vendor_config.pricing_config) AS pricing_config
  WHERE lg_vendors.global_entity_id IN (SELECT global_entity_id FROM `fulfillment-dwh-production.pandata_report.regional_eu__countries` WHERE global_entity_id IN ("EF_GR","FY_CY"))
    AND vendor_config.priority is NOT NULL
