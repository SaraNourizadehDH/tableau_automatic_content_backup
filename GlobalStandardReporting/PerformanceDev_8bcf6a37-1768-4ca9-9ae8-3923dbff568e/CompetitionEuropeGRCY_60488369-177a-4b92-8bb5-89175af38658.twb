      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_6C47D01EBC3B4143AFA40374FEF3D4D1'>
            <properties context=''>
              <relation connection='bigquery.1uspse41ewsa4f1bktvay1deqf5v' name='Custom SQL Query' type='text'><![CDATA[WITH vendor_data as (
  SELECT
    * EXCEPT(country),
    country as country_code,
    CONCAT('POINT(', longitude, ' ', latitude, ')') AS location,
  FROM
    int-per-data-team.geolocation.scraping_vendors_europe),

mov_sf as (
  SELECT 
    sl.country_code,
    sl.lead_id,
    SAFE_DIVIDE(SAFE_CAST(JSON_EXTRACT_SCALAR(json_extract_array(json_extract_scalar(source_specific_extra, "$.price_ranges"))[offset(0)], '$.max') AS FLOAT64),100) AS mov_new,
    SAFE_CAST(JSON_VALUE(source_specific_extra, '$.min_order_value') AS FLOAT64)-SAFE_DIVIDE(SAFE_CAST(JSON_EXTRACT_SCALAR(json_extract_array(json_extract_scalar(source_specific_extra, "$.price_ranges"))[offset(0)], '$.max') AS FLOAT64),100) as service_fee,
    json_value(source_specific_extra, '$.Wolt_plus') as subscription
  FROM 
    fulfillment-dwh-production.curated_data_shared_sales_revenue.sales_lead as sl
  WHERE 
    sl.lead_source="wolt"),

countries AS (
  SELECT
    region
    , country_code
    , country_name
    , ci.id AS city_id
    , ci.name AS city_name
    , z.id AS zone_id
    , z.name AS zone_name
    , z.shape AS zone_shape
  FROM
    fulfillment-dwh-production.curated_data_shared.countries
    LEFT JOIN UNNEST(cities) ci
    LEFT JOIN UNNEST(zones) z ON z.city_id = ci.id
    WHERE z.is_active),
 distinct_locations AS (
  SELECT DISTINCT
    location
    , country_code
  FROM vendor_data
-- Zones to Locations -- The purpose is to assign each set of location points to a the shape that delimits a zone. This way every Wolt vendor can be assigned to DH zones.
), zones_to_locations AS (
  SELECT
    c.region
    , c.country_code
    , c.country_name
    , c.city_id
    , c.city_name
    , c.zone_id
    , c.zone_name
    , d.location
  FROM distinct_locations d
  LEFT JOIN countries c ON d.country_code = c.country_code
    AND ST_CONTAINS(zone_shape, ST_GEOGFROMTEXT(location))
), aggregate_zones AS (
  SELECT
    region
    , zones_to_locations.country_code
    , zones_to_locations.city_id
    , city_name
    , location
    , zones_to_locations.zone_id AS id
    ,zone_name AS name
    ,population as mapped_population
  FROM zones_to_locations
  LEFT JOIN
    (SELECT  
      lower(country_code) as country_code,
      city_id,
      SUM(population) as population
    FROM
      int-per-data-team.test_dataset.population_by_logistics_city_zones as z
    INNER JOIN
      fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities as e
    ON
      z.entity_id = e.global_entity_id
    GROUP BY
      1,2
    ORDER BY
      1) as population_data
  ON
    zones_to_locations.city_id = population_data.city_id
  AND
    zones_to_locations.country_code = population_data.country_code

)
--Final output
SELECT
  overall_data.*,
  mov_local,
  mov_new,
  mov_sf.service_fee as sf,
  subscription
FROM
  (SELECT
    DISTINCT
    w.* EXCEPT(country_code,zone_name,city,delivery_polygon),
    ge.global_entity_id,
    w.city as scraped_city,
    UPPER(w.country_code)as country,
    CASE 
      WHEN z.city_name IS NULL THEN city
    ELSE
      z.city_name
    END as City,
    CASE 
      WHEN z.city_name IS NULL THEN extra_pop
    ELSE
      z.mapped_population
    END as mapped_population,
    sf.sf_status
  FROM vendor_data w
  LEFT JOIN aggregate_zones z ON w.country_code = z.country_code
    AND w.location = z.location
  LEFT JOIN
    (SELECT DISTINCT a.country_code,a.city_name,a.mapped_population as extra_pop
    FROM aggregate_zones a) as p
  ON
    w.country_code = p.country_code
  AND
    w.city = p.city_name
  LEFT JOIN
    (SELECT 
      *
    FROM
      fulfillment-dwh-production.curated_data_shared_sales_revenue.sales_lead_salesforce_match
    WHERE
      sf_status IS NOT NULL) as sf
  ON
    w.lead_id = sf.lead_id
  AND
    w.country_code = sf.country_code
  LEFT JOIN
    (SELECT 
      *
    FROM 
      `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities`
    WHERE
      lower(country_code) IN ('gr','cy')
    AND
      is_reporting_enabled IS TRUE
    AND
      global_entity_id <<>> "IN_GR") as ge
  ON
    w.country_code = lower(ge.country_code)
  WHERE
    w.country_code IN ('gr','cy')) as overall_data
LEFT JOIN
  (SELECT
    lg_vendors.global_entity_id,
    lg_vendors.code AS vendor_code,
    pricing_config.mov_config.minimum_order_value_local AS mov_local,
    vendor_config.priority,
    COALESCE(vendor_config.updated_at_utc, vendor_config.created_at_utc) AS dps_mov_config_date
  FROM `fulfillment-dwh-production.pandata_curated.lg_vendors` AS lg_vendors
  LEFT JOIN UNNEST(lg_vendors.dps) AS dps
         ON dps.is_active
  LEFT JOIN UNNEST(dps.vendor_config) AS vendor_config
  LEFT JOIN UNNEST(vendor_config.pricing_config) AS pricing_config
  WHERE lg_vendors.global_entity_id IN (SELECT global_entity_id FROM `fulfillment-dwh-production.pandata_report.regional_eu__countries` WHERE global_entity_id IN ("EF_GR","FY_CY"))
    AND vendor_config.priority is NOT NULL
    AND pricing_config.mov_config.minimum_order_value_local <<>> 0
    AND pricing_config.mov_config.minimum_order_value_local IS NOT NULL
  QUALIFY ROW_NUMBER() OVER(PARTITION BY lg_vendors.global_entity_id, lg_vendors.code ORDER BY  dps_mov_config_date DESC, vendor_config.priority ASC, pricing_config.mov_config.minimum_order_value_local ASC) = 1) as mov_data
ON
  overall_data.global_entity_id = mov_data.global_entity_id
AND
  overall_data.vendor_id = mov_data.vendor_code
LEFT JOIN
  mov_sf
ON
  lower(overall_data.country) = mov_sf.country_code
AND
  overall_data.lead_id = mov_sf.lead_id]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
