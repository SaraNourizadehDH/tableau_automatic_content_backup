      <aliases enabled='yes' />
      <column caption='     % OD Gap Capital' datatype='real' name='[     % OD Gap (copy)_191684479117475857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [delivery_type] = &quot;OD&quot; AND [Calculation_191684479107710979] = TRUE&#13;&#10;THEN [Calculation_773211777473142784] END)/SUM([Calculation_191684479116832783])' />
      </column>
      <column caption='# Vendors' datatype='integer' name='[# Vendors Comp (copy)_180425478653558784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([source])' />
      </column>
      <column caption='Non-Addressable Gap' datatype='integer' name='[Addressable Gap Vendor (copy)_180425479345430540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [gap_vendor] = TRUE&#13;&#10;AND [addressable_gap_vendor] = &quot;Non Addressable&quot;&#13;&#10;AND [source]&lt;&gt;&quot;DH&quot;&#13;&#10;THEN 1&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Min Order Value' datatype='real' name='[Calculation_1045679581026168832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[mov_new]' />
      </column>
      <column caption='Ratings' datatype='string' name='[Calculation_1100567175693897728]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [restaurant_rating] &lt;1  Then &quot;&lt;1 or &#13;&#10;Unrated&quot;&#13;&#10;ELSEIF [restaurant_rating] &lt;2 Then &quot;&lt;2&quot;&#13;&#10;ELSEIF [restaurant_rating] &lt;3 Then &quot;&lt;3&quot;&#13;&#10;ELSEIF [restaurant_rating] &lt;4 Then &quot;&lt;4&quot;&#13;&#10;ELSEIF [restaurant_rating] &lt;=5 Then &quot;&lt;=5&quot;&#13;&#10;ELSE &quot;&lt;1 or Unrated&quot;END' />
      </column>
      <column caption='Pickup Comp' datatype='integer' name='[Calculation_1203305547490619394]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [is_pickup] = TRUE THEN [Calculation_5612540681477500929] END' />
      </column>
      <column caption='Pickup DH' datatype='integer' name='[Calculation_1203305547490791427]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [is_pickup] = TRUE THEN [Calculation_5612540681477255168] END' />
      </column>
      <column caption='Pickup % DH' datatype='real' name='[Calculation_1203305547492532238]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1203305547490791427])/SUM([Calculation_5612540681477255168])' />
      </column>
      <column caption='Pickup % Comp' datatype='real' name='[Calculation_1203305547492749327]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1203305547490619394])/SUM([Calculation_5612540681477500929])' />
      </column>
      <column caption='Pickup % difference' datatype='real' name='[Calculation_1203305547493142547]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1203305547492532238] - [Calculation_1203305547492749327]' />
      </column>
      <column caption='Pickup % Shape' datatype='string' name='[Calculation_1203305547493478420]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1203305547493142547] &lt; 0  THEN  &quot;Down&quot;&#13;&#10;ELSEIF [Calculation_1203305547493142547] &gt;0 THEN &quot;Up&quot; &#13;&#10;ELSEIF [Calculation_1203305547493142547] =  0 THEN &quot;Flat&quot;&#13;&#10;END' />
      </column>
      <column caption='Pickup Absolute Difference' datatype='integer' name='[Calculation_1203305547495038998]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1203305547490791427]) - SUM([Calculation_1203305547490619394])' />
      </column>
      <column caption='TRUE' datatype='boolean' name='[Calculation_1203305547530788893]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRUE' />
      </column>
      <column caption='FALSE' datatype='boolean' name='[Calculation_1203305547530821662]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='FALSE' />
      </column>
      <column caption='one' datatype='integer' name='[Calculation_1203305547531870240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='City Category' datatype='string' name='[Calculation_1203305547575844900]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [City Set]&#13;&#10;THEN &quot;Top &quot; + str([Parameters].[Parameter 2]) + &quot; Cities&quot;&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END' />
      </column>
      <column caption='City ' datatype='string' name='[Calculation_1203305547577634853]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 14]=&quot;Collapse&quot; THEN&#13;&#10;IF [City Set]&#13;&#10;THEN  [City]&#13;&#10;ELSE &quot;Others&quot; END&#13;&#10;ELSE [City] END' />
      </column>
      <column caption='Addressable Gap % of Total' datatype='real' name='[Calculation_1426796677237616640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_180425479344361483])/SUM([Calculation_5612540681477500929])' />
      </column>
      <column caption='MOV - Occurence  City' datatype='integer' name='[Calculation_180425479075020805]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id],[Calculation_720013007576825862],[source],[Calculation_180425479079682057] : COUNT([mov_new])}' />
      </column>
      <column caption='MOV per City' datatype='real' name='[Calculation_180425479075635207]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_180425479075962888] = [Calculation_180425479075020805] THEN&#13;&#10;[Calculation_180425479079682057] END' />
      </column>
      <column caption='MOV max occurence per City' datatype='integer' name='[Calculation_180425479075962888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id],[City],[source]:MAX&#13;&#10;([Calculation_180425479075020805])}' />
