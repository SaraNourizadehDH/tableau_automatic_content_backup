    END as mapped_population,
    sf.sf_status
  FROM vendor_data w
  LEFT JOIN aggregate_zones z ON w.country_code = z.country_code
    AND w.location = z.location
  LEFT JOIN
    (SELECT DISTINCT a.country_code,a.city_name,a.mapped_population as extra_pop
    FROM aggregate_zones a) as p
  ON
    w.country_code = p.country_code
  AND
