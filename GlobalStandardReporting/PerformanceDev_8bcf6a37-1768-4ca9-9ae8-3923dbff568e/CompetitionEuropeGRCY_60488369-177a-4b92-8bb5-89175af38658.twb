      <table>
        <view>
          <datasources>
            <datasource caption='scraping_vendors_europe (geolocation)' name='federated.0f1ijzw1mtuprj192xuxd190dpu6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Expand/Collapse' datatype='string' name='[Parameter 14]' param-domain-type='list' role='measure' type='nominal' value='&quot;Collapse&quot;'>
              <calculation class='tableau' formula='&quot;Collapse&quot;' />
            </column>
            <column caption='Top N Cities' datatype='real' datatype-customized='true' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='10.'>
              <calculation class='tableau' formula='10.' />
              <range granularity='1.0' max='20.0' min='1.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0f1ijzw1mtuprj192xuxd190dpu6'>
            <column caption='# Vendors' datatype='integer' name='[# Vendors Comp (copy)_180425478653558784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([source])' />
            </column>
            <column caption='TRUE' datatype='boolean' name='[Calculation_1203305547530788893]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='TRUE' />
