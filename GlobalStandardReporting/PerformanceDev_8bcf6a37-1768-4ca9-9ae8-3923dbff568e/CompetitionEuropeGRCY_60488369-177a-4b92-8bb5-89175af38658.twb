      <column caption='nps_detractor_score' datatype='real' name='[Calculation_2936206254657896448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-ROUND(((MAX([nps_detractors])/MAX([nps_responses])) * 100), 0)' />
      </column>
      <column caption='nps_score_group_type_switch' datatype='real' name='[Calculation_2936206254658232321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MAX([Parameters].[Parameter 11]) = &apos;1&apos; AND MAX([Parameters].[Parameter 12]) = &apos;1&apos; THEN [Calculation_2936206254657896448]&#10;ELSEIF MAX([Parameters].[Parameter 11]) = &apos;2&apos; AND MAX([Parameters].[Parameter 12]) = &apos;1&apos; THEN [Calculation_5068519941430898688]&#10;&#10;ELSEIF MAX([Parameters].[Parameter 11]) = &apos;1&apos; AND MAX([Parameters].[Parameter 12]) = &apos;2&apos; THEN [Calculation_3137108987735433219]&#10;ELSEIF MAX([Parameters].[Parameter 11]) = &apos;2&apos; AND MAX([Parameters].[Parameter 12]) = &apos;2&apos; THEN [Calculation_3137108987735638021]&#10;&#10;ELSEIF MAX([Parameters].[Parameter 11]) = &apos;1&apos; AND MAX([Parameters].[Parameter 12]) = &apos;3&apos; THEN [Calculation_3137108987735552004]&#10;ELSEIF MAX([Parameters].[Parameter 11]) = &apos;2&apos; AND MAX([Parameters].[Parameter 12]) = &apos;3&apos; THEN [Calculation_3137108987735805958]&#10;&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='nps_score_type_qc_food_switch' datatype='real' name='[Calculation_3137108987711451136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 12] = &apos;1&apos;, [nps_score],&#10;IIF([Parameters].[Parameter 12] = &apos;2&apos;, [nps_score_food],&#10;IIF([Parameters].[Parameter 12] = &apos;3&apos;, [nps_score_qcommerce],&#10;NULL)))' />
      </column>
      <column caption='nps_responses_type_qc_food_label' datatype='integer' name='[Calculation_3137108987712868353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 12] = &apos;1&apos;, [nps_responses],&#10;IIF([Parameters].[Parameter 12] = &apos;2&apos;, [nps_responses_food],&#10;IIF([Parameters].[Parameter 12] = &apos;3&apos;, [nps_responses_qcommerce],&#10;NULL)))' />
      </column>
      <column caption='nps_detractor_food_score' datatype='real' name='[Calculation_3137108987735433219]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-ROUND(((MAX([nps_detractors_food])/MAX([nps_responses_food])) * 100), 0)' />
      </column>
      <column caption='nps_detractor_qc_score' datatype='real' name='[Calculation_3137108987735552004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-ROUND(((MAX([nps_detractors_qcommerce])/MAX([nps_responses_qcommerce])) * 100), 0)' />
      </column>
      <column caption='nps_promoter_food_score' datatype='real' name='[Calculation_3137108987735638021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(((MAX([nps_promoters_food])/MAX([nps_responses_food])) * 100), 0)' />
      </column>
      <column caption='nps_promoter_qc_score' datatype='real' name='[Calculation_3137108987735805958]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(((MAX([nps_promoters_qcommerce])/MAX([nps_responses_qcommerce])) * 100), 0)' />
      </column>
      <column caption='Competitor Colors' datatype='string' name='[Calculation_3600065008323088384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([is_dh_brand], &apos;Delivery Hero&apos;, [brand_display_name])' />
      </column>
      <column caption='dh_orders_parameter' datatype='real' name='[Calculation_4005600041928175616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(&#10;iif([appannie_downloads_confidence_flag] = 5, NULL,&#10;iif([Parameters].[Parameter 9] = &apos;Successful Orders&apos;, [dh_orders],&#10;iif([Parameters].[Parameter 9] = &apos;Acquisitions&apos;, [dh_acquisitions],&#10;iif([Parameters].[Parameter 9] = &apos;Voucher Orders&apos;, [dh_voucher_orders],&#10;iif([Parameters].[Parameter 9] = &apos;Voucher Orders %&apos;, [dh_voucher_order_ratio]*100,&#10; NULL))))))' />
      </column>
      <column caption='Primary Competitors' datatype='string' name='[Calculation_4081176112623828992]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='iif([is_primary_competitor], &apos;Top Competitors&apos; , &apos;Others&apos;)' />
      </column>
      <column caption='nps_promoter_score' datatype='real' name='[Calculation_5068519941430898688]' role='measure' type='quantitative'>
