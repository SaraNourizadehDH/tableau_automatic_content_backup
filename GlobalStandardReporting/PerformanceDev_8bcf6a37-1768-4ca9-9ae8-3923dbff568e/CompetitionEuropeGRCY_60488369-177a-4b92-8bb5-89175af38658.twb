        <calculation class='tableau' formula='IF [Parameters].[Parameter 1 1] = 2 &#10;    THEN &#10;        MAX([appannie_est_cumulative_download_ios])&#10;ELSE &#10;        ROUND((SUM([appannie_est_cumulative_download_ios]) / &#10;            SUM({EXCLUDE  [Calculation_3600065008323088384], [competitor_google], [Calculation_5741596974407430144] : SUM([appannie_est_cumulative_download_ios])}))*100, 1)&#10;END' />
