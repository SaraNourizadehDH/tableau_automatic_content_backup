              <calculation class='tableau' formula='SUM([restaurant_failure_dmarts]) /  (SUM([failed_orders_dmarts]) + SUM([successful_orders_dmarts]))' />
            </column>
            <column caption='DH Failure Dmarts' datatype='real' name='[Fail Rate Dmart (copy)_5588474609111191562]' role='measure' type='quantitative'>
