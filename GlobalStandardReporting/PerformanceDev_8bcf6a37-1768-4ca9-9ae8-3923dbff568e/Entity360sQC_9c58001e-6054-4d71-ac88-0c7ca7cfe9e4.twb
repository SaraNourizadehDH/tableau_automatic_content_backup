      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_5D34EFB45A194B22AC073544D5F0DDE4'>
            <properties context=''>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Custom SQL Query].[global_entity_id]' />
                    <expression op='[gsr_entitlements_performance_global_entity_id].[global_entity_id]' />
                  </expression>
                </clause>
                <relation connection='bigquery.0s0pr6b0kgpt961gn9r7y0dlh7tk' name='Custom SQL Query' type='text'><![CDATA[SELECT
        cm.global_entity_id,
        segment,
        vertical,
        cm.sub_entity,
        cm.management_entity,
       first_order_month AS report_month,
       SUM(CASE WHEN month_number = 1 THEN return_customers END) as users_1,
       SUM(CASE WHEN month_number = 0 THEN acquisition_customers END) AS acquisitions_0,
       SUM(CASE WHEN month_number = 1 THEN acquisition_customers END) AS acquisitions_1,
       SUM(CASE WHEN month_number = 1 THEN orders END) AS orders_1,
       
       
    FROM `fulfillment-dwh-production.cl_intl_markets.cohorts_monthly_platform` cm
    INNER JOIN `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities` ent USING (global_entity_id)
    WHERE is_reporting_enabled
    AND cm.first_order_month << DATE_TRUNC(DATE_ADD(current_date, INTERVAL -1 MONTH),MONTH)
    GROUP BY 1,2,3,4,5,6]]></relation>
                <relation connection='bigquery.0s0pr6b0kgpt961gn9r7y0dlh7tk' name='gsr_entitlements_performance_global_entity_id' table='[fulfillment-dwh-production.cl_intl_markets].[gsr_entitlements_performance_global_entity_id]' type='table' />
              </relation>
            </properties>
            <properties context='extract'>
              <relation join='inner' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Custom SQL Query].[global_entity_id]' />
                    <expression op='[gsr_entitlements_performance_global_entity_id].[global_entity_id]' />
                  </expression>
                </clause>
                <relation name='Custom SQL Query' table='[Extract].[Custom SQL Query]' type='table' />
                <relation name='gsr_entitlements_performance_global_entity_id' table='[Extract].[gsr_entitlements_performance_global_entity_id]' type='table' />
              </relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
