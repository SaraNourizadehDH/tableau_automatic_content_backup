      <column caption='Avg Delivery Time Dmarts' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Delivery Time (copy)_5588474609132736533]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_delivery_time_in_mins_dmarts])/ SUM([count_delivery_time_dmarts])' />
      </column>
      <column caption='Avg Delivery Time LS OD' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg Delivery Time Dmarts (copy)_5588474609132900374]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sum_delivery_time_in_mins_ls])/ SUM([count_delivery_time_ls])' />
      </column>
      <column caption='NPS Dmarts' datatype='real' name='[Calculation_2259329322643218432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([nps_promoters_dmarts]) - SUM([nps_detractors_dmarts])) / SUM([nps_responses_dmarts]) * 100' />
      </column>
      <column caption='Order Share OD LS' datatype='real' default-format='p0.0%' name='[Calculation_5588474609056264192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_orders_ls_od])/ SUM([orders])' />
      </column>
      <column caption='username filter' datatype='boolean' name='[Calculation_5588474609061761028]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='Customer Share LS OD' datatype='real' default-format='p0.0%' name='[Calculation_5588474609063878663]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_customers_od_ls])/ SUM([active_customers])' />
      </column>
      <column caption='Fail Rate Dmarts' datatype='real' default-format='p0.0%' name='[Calculation_5588474609110757385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders_dmarts]) / (SUM([successful_orders_dmarts]) + SUM([failed_orders_dmarts]))' />
      </column>
      <column caption='Delay&gt;10 min % Dmarts' datatype='real' default-format='p0.0%' name='[Calculation_5588474609121439761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_delivery_delay_late_10_mins_dmarts]) / SUM([count_delivery_time_dmarts])' />
      </column>
      <column caption='Customer Share Dmart' datatype='real' default-format='p0.0%' name='[Customer Share LS OD (copy)_5588474609064013832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([active_customers_dmarts])/ SUM([active_customers])' />
      </column>
      <column caption='Vendor Failure Dmarts ' datatype='real' name='[DH Failure Dmarts (copy)_5588474609111412747]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([restaurant_failure_dmarts]) /  (SUM([failed_orders_dmarts]) + SUM([successful_orders_dmarts]))' />
      </column>
      <column caption='DH Failure LS OD' datatype='real' name='[DH Failure Dmarts (copy)_5588474609111691279]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dh_failure_od_ls]) /  (SUM([failed_orders_od_ls]) + SUM([successful_orders_ls_od]))' />
      </column>
