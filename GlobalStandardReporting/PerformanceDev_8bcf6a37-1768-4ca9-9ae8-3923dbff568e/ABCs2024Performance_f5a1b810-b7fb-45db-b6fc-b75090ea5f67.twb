    <worksheet name='Target calculation - ECB'>
      <table>
        <view>
          <datasources>
            <datasource caption='fullfilment - abcs_kpis_quarterly+ (cl_intl_markets)' name='federated.1g5agjt1kscdg118a9mt11noi15e' />
          </datasources>
          <datasource-dependencies datasource='federated.1g5agjt1kscdg118a9mt11noi15e'>
            <column caption='Vs Targets progress pct - capped' datatype='real' name='[Calculation_1022317139093299200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_3978015506158739457] &gt; 1.5 THEN 1.5&#10;ELSEIF [Calculation_3978015506158739457] &lt; -0.5 THEN -0.5&#10;ELSE [Calculation_3978015506158739457]&#10;END' />
            </column>
            <column caption='Quarter' datatype='string' name='[Calculation_2800464912448356368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([report_quarter])) +&quot; - &quot;  + &quot;Q&quot; + STR(QUARTER([report_quarter]) )' />
            </column>
            <column caption='vs Targets Progress (aggr)' datatype='real' default-format='p0.00%' name='[Calculation_3978015506158739457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_3978015506159583234], [management_entity], [Calculation_2800464912448356368] : AVG( [vs_targets_pct]) }&#10;// To aggregate: 1-women in tech and % women in mgmt, 2- glovo acquired local heroes and acquired KAs' />
            </column>
            <column caption='[helper]Commitment targets progression aggregation' datatype='string' name='[Calculation_3978015506159583234]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [metric_name]&#10;WHEN &apos;women_in_mgmt&apos; THEN &apos;women_pct&apos;&#10;WHEN &apos;women_in_tech&apos; THEN &apos;women_pct&apos;&#10;WHEN &apos;glovo_key_account_gap_lh&apos; THEN &apos;GV_comp&apos;&#10;WHEN &apos;glovo_key_account_gap_ta&apos; THEN &apos;GV_comp&apos;&#10;WHEN &apos;glovo_content_quality_score_images&apos; THEN &apos;GV_img&apos;&#10;WHEN &apos;glovo_incremental_orders_funnel_improvement&apos; THEN &apos;GV_img&apos;&#10;ELSE [metric_name]&#10;END' />
            </column>
            <column caption='Vs Targets progress pct -2' datatype='real' default-format='p0%' name='[Calculation_4013340596932653056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [report_quarter] &lt; DATETRUNC(&apos;quarter&apos; , TODAY()) THEN [Calculation_1022317139093299200] END' />
            </column>
            <column caption='ATTR(1)' datatype='integer' name='[Calculation_733734904000356353]' role='measure' type='quantitative' user:unnamed='Target calculation -BRS'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='vs Targets progress coloring' datatype='string' name='[Calculation_733734904007434242]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF AVG([Calculation_4013340596932653056]) &gt; 1 THEN &apos;Over Performing&apos;&#10;ELSEIF AVG([Calculation_4013340596932653056]) &gt;= 0.80 THEN &apos;Performing&apos;&#10;ELSEIF AVG([Calculation_4013340596932653056]) &lt; 0.80 THEN &apos;Under performing&apos;&#10;ELSEIF ISNULL(MAX([Calculation_4013340596932653056])) THEN &apos;No data&apos;&#10;ELSE &apos;Not performing&apos;&#10;END' />
            </column>
            <column caption='Management Entity -filter' datatype='string' name='[Management Entity (copy)_4688247244968304641]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [management_entity]&#10;WHEN &apos;Central&apos; THEN &apos; DH Total&apos;&#10;WHEN &apos;DH&apos; THEN &apos; DH Total&apos;&#10;ELSE [management_entity]&#10;END' />
              <aliases>
                <alias key='&quot;DH&quot;' value='DH Total' />
              </aliases>
            </column>
            <column-instance column='[Calculation_4013340596932653056]' derivation='Avg' name='[avg:Calculation_4013340596932653056:qk]' pivot='key' type='quantitative' />
