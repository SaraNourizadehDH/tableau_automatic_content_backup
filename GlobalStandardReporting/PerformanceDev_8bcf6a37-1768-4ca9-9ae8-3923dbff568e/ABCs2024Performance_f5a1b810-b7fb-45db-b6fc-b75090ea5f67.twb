            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Entity' caption='Detail Level' datatype='boolean' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
              <aliases>
                <alias key='false' value='Entity' />
                <alias key='true' value='Central' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1g5agjt1kscdg118a9mt11noi15e'>
            <column caption='Commitment level' datatype='string' name='[Calculation_1805450897349017600]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [abc_entity_level]&#10;WHEN &quot;Only Management Entity&quot; THEN &quot;Entity Specific&quot;&#10;WHEN &quot;All&quot; THEN &quot;Global&quot;&#10;END' />
            </column>
            <column caption='Value - quarterly' datatype='real' name='[Calculation_2800464912445710345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  DATETRUNC(&apos;quarter&apos; , TODAY()) &lt;&gt; [report_quarter] THEN  [value] ELSE NULL END' />
            </column>
            <column caption='Value - abs' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2800464912446218250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#10;IF [metric_pct_or_abs] = &apos;abs&apos; AND DATETRUNC(&apos;quarter&apos; , TODAY()) &lt;&gt; [report_quarter] THEN [Calculation_2800464912445710345]/[divide_by] END&#10;)' />
            </column>
            <column caption='ATTR(1)' datatype='integer' name='[Calculation_2800464912446648333]' role='measure' type='quantitative' user:unnamed='Sheet 9'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='ATTR(1)' datatype='integer' name='[Calculation_2800464912446664719]' role='measure' type='quantitative' user:unnamed='Sheet 9'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='Quarter' datatype='string' name='[Calculation_2800464912448356368]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(YEAR([report_quarter])) +&quot; - &quot;  + &quot;Q&quot; + STR(QUARTER([report_quarter]) )' />
            </column>
            <column caption='is value&gt;0' datatype='boolean' name='[Calculation_2800464912451203090]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_2800464912445710345]&gt;0' />
            </column>
            <column caption='Detail Level Filter' datatype='boolean' name='[Calculation_2800464912455811091]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] THEN [management_entity] = &apos;DH&apos; ELSE TRUE END' />
            </column>
            <column caption='is included in vs Target' datatype='boolean' name='[Calculation_2995456702583107584]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;    [target_value]&gt;0 AND [Calculation_2800464912445710345] &gt;0 THEN TRUE &#10;     ELSE FALSE&#10;END' />
            </column>
            <column caption='meid_sort' datatype='integer' name='[Calculation_4013340597009326081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [management_entity]&#10;WHEN &apos;DH&apos; THEN 1&#10;WHEN &apos;Talabat&apos; THEN 2&#10;WHEN &apos;HungerStation&apos; THEN 3&#10;WHEN &apos;DH Europe&apos; THEN 4&#10;WHEN &apos;DH Greece&apos; THEN 5&#10;WHEN &apos;Glovo&apos; THEN 6&#10;WHEN &apos;PedidosYa&apos; THEN 7&#10;WHEN &apos;Woowa&apos; THEN 8&#10;WHEN &apos;Foodpanda APAC&apos; THEN 9&#10;ELSE 100&#10;END' />
            </column>
            <column caption='null' datatype='boolean' name='[Calculation_4013340597018296329]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='null' />
            </column>
            <column caption='Management Entity -filter' datatype='string' name='[Management Entity (copy)_4688247244968304641]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [management_entity]&#10;WHEN &apos;Central&apos; THEN &apos; DH Total&apos;&#10;WHEN &apos;DH&apos; THEN &apos; DH Total&apos;&#10;ELSE [management_entity]&#10;END' />
              <aliases>
