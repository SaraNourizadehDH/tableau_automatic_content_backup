    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Summary - One pager'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/ABCs2024/Summary-Onepager?rev=' id='Summary-Onepager' path='/t/GlobalStandardReporting/workbooks/ABCs2024' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_52' value='bottom' />
          <format attr='text-align' id='dash-text_52' value='center' />
          <format attr='vertical-align' id='dash-text_22' value='bottom' />
          <format attr='vertical-align' id='dash-text_35' value='bottom' />
          <format attr='vertical-align' id='dash-text_47' value='bottom' />
          <format attr='vertical-align' id='dash-text_63' value='bottom' />
          <format attr='vertical-align' id='dash-text_78' value='bottom' />
          <format attr='vertical-align' id='dash-text_27' value='bottom' />
          <format attr='vertical-align' id='dash-text_40' value='bottom' />
          <format attr='vertical-align' id='dash-text_68' value='bottom' />
          <format attr='vertical-align' id='dash-text_83' value='bottom' />
          <format attr='vertical-align' id='dash-text_57' value='bottom' />
          <format attr='vertical-align' id='dash-text_73' value='bottom' />
          <format attr='vertical-align' id='dash-text_88' value='bottom' />
          <format attr='vertical-align' id='dash-text_94' value='bottom' />
          <format attr='vertical-align' id='dash-text_101' value='bottom' />
          <format attr='vertical-align' id='dash-text_106' value='bottom' />
          <format attr='text-orientation' id='dash-text_18' value='-90' />
          <format attr='text-align' id='dash-text_18' value='center' />
        </style-rule>
      </style>
      <size maxheight='1100' maxwidth='1400' minheight='1100' minwidth='1400' sizing-mode='fixed' />
      <datasources>
        <datasource caption='fullfilment - abcs_kpis_quarterly+ (cl_intl_markets)' name='federated.1g5agjt1kscdg118a9mt11noi15e' />
      </datasources>
      <datasource-dependencies datasource='federated.1g5agjt1kscdg118a9mt11noi15e'>
        <column caption='Quarter' datatype='string' name='[Calculation_2800464912448356368]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='STR(YEAR([report_quarter])) +&quot; - &quot;  + &quot;Q&quot; + STR(QUARTER([report_quarter]) )' />
        </column>
        <column caption='Management Entity -filter' datatype='string' name='[Management Entity (copy)_4688247244968304641]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [management_entity]&#10;WHEN &apos;Central&apos; THEN &apos; DH Total&apos;&#10;WHEN &apos;DH&apos; THEN &apos; DH Total&apos;&#10;ELSE [management_entity]&#10;END' />
          <aliases>
            <alias key='&quot;DH&quot;' value='DH Total' />
          </aliases>
        </column>
        <column-instance column='[Calculation_2800464912448356368]' derivation='None' name='[none:Calculation_2800464912448356368:nk]' pivot='key' type='nominal' />
        <column-instance column='[Management Entity (copy)_4688247244968304641]' derivation='None' name='[none:Management Entity (copy)_4688247244968304641:nk]' pivot='key' type='nominal' />
