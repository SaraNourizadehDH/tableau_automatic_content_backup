            <column caption='Metric Sort Rank' datatype='integer' name='[metric_sort_rank]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1805450897349017600]' derivation='None' name='[none:Calculation_1805450897349017600:nk]' pivot='key' type='nominal' />
