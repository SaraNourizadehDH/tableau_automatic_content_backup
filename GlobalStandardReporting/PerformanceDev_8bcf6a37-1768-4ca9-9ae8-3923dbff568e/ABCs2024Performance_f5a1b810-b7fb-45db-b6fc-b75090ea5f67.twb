      <aliases enabled='yes' />
      <column caption='KPI - pct vs abs' datatype='string' name='[Calculation_1740430159354433536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LOWER([metric_pct_or_abs])' />
      </column>
      <column caption='Detail Level Filter' datatype='boolean' name='[Calculation_2800464912414384128]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] THEN [management_entity]=&apos;DH&apos; ELSE TRUE END' />
      </column>
      <column caption='Value Weighted' datatype='real' name='[Calculation_2800464912436207620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([value]*[value_weight])/([value_weight])' />
      </column>
      <column caption='is sum values &gt; 0' datatype='boolean' name='[Calculation_2800464912438325254]' role='measure' type='nominal'>
        <calculation class='tableau' formula='sum([value])&gt;0' />
      </column>
      <column caption='is_current month' datatype='boolean' name='[Calculation_3204311185175048192]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [report_month] = DATETRUNC ( &apos;month&apos;, TODAY()) &#10;THEN TRUE&#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='user filter' datatype='boolean' name='[Calculation_3415628511899152386]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username]=USERNAME()' />
      </column>
      <column caption='meid_sort' datatype='integer' name='[Calculation_4013340597011083266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [management_entity]&#10;WHEN &apos;DH&apos; THEN 1&#10;WHEN &apos;DH Europe&apos; THEN 2&#10;WHEN &apos;Foodora excl. Turkey&apos; THEN 3&#10;WHEN &apos;Yemeksepeti&apos; THEN 4&#10;WHEN &apos;DH Greece&apos; THEN 5&#10;WHEN &apos;Foodpanda APAC&apos; THEN 6&#10;WHEN &apos;Talabat&apos; THEN 7&#10;WHEN &apos;HungerStation&apos; THEN 8&#10;WHEN &apos;Woowa&apos; THEN 9&#10;WHEN &apos;Glovo&apos; THEN 10&#10;ELSE 100&#10;END' />
      </column>
      <column caption='Management Entity Filter' datatype='string' name='[Calculation_4688247244968706050]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [management_entity]&#10;WHEN &apos;Central&apos; THEN &apos;DH Total&apos;&#10;WHEN &apos;DH&apos; THEN &apos;DH Total&apos;&#10;ELSE [management_entity]&#10;END' />
      </column>
      <column caption='Commitment level' datatype='string' name='[Calculation_5114189248906739717]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [abc_entity_level]&#10;WHEN &quot;Only Management Entity&quot; THEN &quot;Entity Specific&quot;&#10;WHEN &quot;All&quot; THEN &quot;Global&quot;&#10;END' />
      </column>
      <column caption='is meid=geid' datatype='boolean' name='[Calculation_5401645544830287886]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[management_entity] = [global_entity_id]' />
      </column>
      <column caption='quarter_string' datatype='string' name='[Calculation_5570600928685535234]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([report_month])) +&quot; - &quot;  + &quot;Q&quot; + STR(QUARTER([report_month]) )' />
      </column>
      <column caption='is_available_only_quarterly' datatype='boolean' name='[Calculation_5570600928685621251]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//IF { FIXED [quarter_string], [Global Entity Id], [Commitment Message] : COUNTD([Value]) } &lt; 2 THEN TRUE&#10;//ELSE FALSE&#10;//END&#10;&#10;&#10;IF str([report_month]) = &apos;2024-07-01&apos; THEN FALSE&#10;ELSEIF&#10;{ FIXED [Calculation_5570600928685535234], [management_entity], [commitment_message] : COUNTD([value]) } &lt; 2 &#10;THEN TRUE&#10;ELSE&#10; FALSE&#10;END' />
      </column>
      <column caption='Value -pct ' datatype='real' default-format='p0.0%' name='[Value (copy)_6255851734724009984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;IF [Calculation_1740430159354433536] = &apos;pct&apos;  THEN &#10;    [Calculation_2800464912436207620]&#10;ELSE NULL&#10;END&#10;)' />
      </column>
      <column caption='Value -abs  ' datatype='real' default-format='N' name='[Value - try -pct  (copy)_6255851734725029893]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;IF [Calculation_1740430159354433536] = &apos;abs&apos; THEN &#10;    [Calculation_2800464912436207620]/[divide_by]&#10;ELSE NULL&#10;END&#10;)' />
      </column>
