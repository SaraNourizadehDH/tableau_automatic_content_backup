            <column-instance column='[Calculation_2800464912448356368]' derivation='None' name='[none:Calculation_2800464912448356368:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2800464912451203090]' derivation='None' name='[none:Calculation_2800464912451203090:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2800464912455811091]' derivation='None' name='[none:Calculation_2800464912455811091:nk]' pivot='key' type='nominal' />
