          <datasource-dependencies datasource='federated.1e31fnc1p64uyq1f1g51g0uwxvy8'>
            <column caption='Open Rate' datatype='real' name='[Calculation_2198108466931019776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([offline_duration])/SUM([online_duration])' />
            </column>
            <column caption='CVR' datatype='real' name='[Calculation_2198108466944061441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transactions])/SUM([sessions])' />
            </column>
            <column caption='AFV' datatype='real' name='[Calculation_2198108466953146372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_eur])/SUM([successful_orders])' />
            </column>
            <column caption='Fail Rate' datatype='real' name='[Calculation_2198108466953338885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])/SUM([total_orders])' />
            </column>
            <column caption='Rating' datatype='real' name='[Calculation_3020507980846514180]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [country_name] = &apos;Turkey&apos; THEN [rating]/2 ELSE rating END' />
