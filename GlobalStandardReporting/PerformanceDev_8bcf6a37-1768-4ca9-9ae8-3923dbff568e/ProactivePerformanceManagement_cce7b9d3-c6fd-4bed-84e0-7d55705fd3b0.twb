        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1fidtlj0a583a41asqtlx16uca82' name='Custom SQL Query' type='text'>SELECT
    global_entity_id,
    report_month,
    metric_name,
    value
  FROM  `int-per-data-team.rl_intl_markets.ppm_metrics`
    unpivot(value for metric_name in (acquisitions,
                    sessions,
                    sessions_cvr,
                    mcvr4_num,
                    mcvr4_denum,
                    utr,
                    seamless_order_share,
                    m1_churn_vendors,
                    active_customers_qc_share,
                    csat_score,
                    failed_orders_od,
                    branding_kpis_bpi,
                    downloads,
                    mau,
                    zombie_f90,
                    ka_gap,
                    riders_churned_share
                                ))
WHERE is_reporting_enabled</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
