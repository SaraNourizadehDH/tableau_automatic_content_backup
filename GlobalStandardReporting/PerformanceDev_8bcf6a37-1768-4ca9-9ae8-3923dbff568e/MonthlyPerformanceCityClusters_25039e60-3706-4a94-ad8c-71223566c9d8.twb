        <calculation class='tableau' formula='SUM([other_non_specific_costs_eur_od])/SUM([orders_profit])' />
      </column>
      <column caption='Payment CPO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4363284401708122144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([payment_costs_eur_od])/SUM([orders_profit])' />
