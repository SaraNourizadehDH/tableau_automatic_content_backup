        <calculation class='tableau' formula='SUM([gpo_eur_od])/SUM([orders_profit])' />
      </column>
      <column caption='Delivery CPO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4363284401713999915]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-SUM([delivery_cpo_eur_od])/SUM([orders_profit])' />
