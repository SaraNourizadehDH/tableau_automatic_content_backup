rders (copy)_5936799883499143190]) = &apos;Green&apos; AND ([Calculation_5936799883499638809] = &apos;Red&apos; OR [Calculation_5936799883499638809] = &apos;Gray&apos;) AND ATTR([Calculation_730568349432700932]) = &apos;Yes&apos; THEN &apos;Cluster 2&apos; ELSEIF&#10;([Calculation_5936799883155025920] = &apos;Red&apos; OR [Calculation_5936799883155025920] = &apos;Gray&apos;)   AND ATTR([Color Orders (copy)_5936799883499143190]) = &apos;Green&apos; AND ([Calculation_5936799883499638809] = &apos;Red&apos; OR [Calculation_5936799883499638809] = &apos;Gray&apos;) AND (ATTR([Calculation_730568349432700932]) = &apos;No&apos;  OR ATTR([Color FLGPO (copy)_5936799883500085276]) = &apos;Gray&apos;) THEN &apos;Cluster 2&apos; ELSEIF&#10;([Calculation_5936799883155025920] = &apos;Red&apos; OR [Calculation_5936799883155025920] = &apos;Gray&apos;)   AND (ATTR([Color Orders (copy)_5936799883499143190]) = &apos;Red&apos; OR ATTR([Color Orders (copy)_5936799883499143190]) = &apos;Gray&apos;) AND [Calculation_5936799883499638809] = &apos;Green&apos; AND ATTR([Calculation_730568349432700932]) = &apos;Yes&apos; THEN &apos;Cluster 1&apos; ELSEIF&#10;([Calculation_5936799883155025920] = &apos;Red&apos; OR [Calculation_5936799883155025920] = &apos;Gray&apos;)   AND (ATTR([Color Orders (copy)_5936799883499143190]) = &apos;Red&apos; OR ATTR([Color Orders (copy)_5936799883499143190]) = &apos;Gray&apos;) AND [Calculation_5936799883499638809] = &apos;Green&apos; AND (ATTR([Calculation_730568349432700932]) = &apos;No&apos;  OR ATTR([Color FLGPO (copy)_5936799883500085276]) = &apos;Gray&apos;) THEN &apos;Cluster 1&apos; ELSEIF&#10;([Calculation_5936799883155025920] = &apos;Red&apos; OR [Calculation_5936799883155025920] = &apos;Gray&apos;)   AND (ATTR([Color Orders (copy)_5936799883499143190]) = &apos;Red&apos; OR ATTR([Color Orders (copy)_5936799883499143190]) = &apos;Gray&apos;) AND (ATTR([Color Orders (copy)_5936799883499143190]) = &apos;Red&apos; OR ATTR([Color Orders (copy)_5936799883499143190]) = &apos;Gray&apos;) AND ATTR([Calculation_730568349432700932]) = &apos;Yes&apos; THEN &apos;Cluster 3&apos; ELSEIF&#10;([Calculation_5936799883155025920] = &apos;Red&apos; OR [Calculation_5936799883155025920] = &apos;Gray&apos;)   AND (ATTR([Color Orders (copy)_5936799883499143190]) = &apos;Red&apos; OR ATTR([Color Orders (copy)_5936799883499143190]) = &apos;Gray&apos;) AND (ATTR([Color Orders (copy)_5936799883499143190]) = &apos;Red&apos; OR ATTR([Color Orders (copy)_5936799883499143190]) = &apos;Gray&apos;) AND (ATTR([Calculation_730568349432700932]) = &apos;No&apos;  OR ATTR([Color FLGPO (copy)_5936799883500085276]) = &apos;Gray&apos;) THEN &apos;Cluster 3&apos; ELSE &#10;&apos;NA&apos; END' />
