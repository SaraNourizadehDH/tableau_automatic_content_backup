              <calculation class='tableau' formula='50.' />
            </column>
            <column caption='Order Market Share %' datatype='real' default-format='n#,##0&quot; %&quot;;-#,##0&quot; %&quot;' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='10.'>
              <calculation class='tableau' formula='10.' />
            </column>
            <column caption='Brand Interest %' datatype='real' default-format='n#,##0&quot; %&quot;;-#,##0&quot; %&quot;' name='[Parameter 7]' param-domain-type='any' role='measure' type='quantitative' value='30.'>
              <calculation class='tableau' formula='30.' />
