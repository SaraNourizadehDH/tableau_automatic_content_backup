    <worksheet name='City-Level Deep-Dive'>
      <table>
        <view>
          <datasources>
            <datasource caption='cross_okr_clusters (cl_intl_markets)' name='federated.1ev7ovq12jb9161feju3m0tyks80' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Order YoY% Thr.' datatype='integer' datatype-customized='true' default-format='n#,##0&quot; %&quot;;-#,##0&quot; %&quot;' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='-10'>
              <calculation class='tableau' formula='-10' />
            </column>
            <column caption='Orders / addr pop' datatype='integer' datatype-customized='true' default-format='n#,##0&quot;%&quot;;-#,##0&quot;%&quot;' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='5'>
              <calculation class='tableau' formula='5' />
            </column>
            <column caption='FLGPO (EUR)' datatype='real' default-format='C1031%' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='0.'>
              <calculation class='tableau' formula='0.' />
            </column>
            <column caption='NPS Threshold' datatype='real' default-format='n#,##0&quot; %&quot;;-#,##0&quot; %&quot;' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='50.'>
              <calculation class='tableau' formula='50.' />
            </column>
            <column caption='Order Market Share %' datatype='real' default-format='n#,##0&quot; %&quot;;-#,##0&quot; %&quot;' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='10.'>
              <calculation class='tableau' formula='10.' />
            </column>
            <column caption='Brand Interest %' datatype='real' default-format='n#,##0&quot; %&quot;;-#,##0&quot; %&quot;' name='[Parameter 7]' param-domain-type='any' role='measure' type='quantitative' value='30.'>
              <calculation class='tableau' formula='30.' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ev7ovq12jb9161feju3m0tyks80'>
            <column caption='Above FLGPO OD Threshold?' datatype='string' name='[Above Market Penetration Threshold? (copy)_4410149976057712642]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_4363284401698955264] &gt; [Parameters].[Parameter 3] THEN &apos;Yes&apos; &#10;ELSEIF ISNULL([Parameters].[Parameter 3]) THEN &apos;N/A&apos; &#10;ELSE &apos;No&apos; END' />
            </column>
            <column caption='Above Brand Interest Threshold?' datatype='string' name='[Above Market Penetration Threshold? (copy)_4410149976058028035]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [brand_interest_ratio]*100 &gt; [Parameters].[Parameter 7] THEN &apos;Yes&apos; &#10;ELSEIF ISNULL([brand_interest_ratio]) THEN &apos;N/A&apos; &#10;ELSE &apos;No&apos; END' />
            </column>
            <column caption='Above Market Penetration Threshold?' datatype='string' name='[Above Orders YoY Threshold? (copy)_4410149976057241601]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Orders Pop (copy)_1614540487542411275]*100 &gt; [Parameters].[Parameter 2] THEN &apos;Yes&apos; &#10;ELSEIF ISNULL([Orders Pop (copy)_1614540487542411275]) THEN &apos;N/A&apos; &#10;ELSE &apos;No&apos; END' />
            </column>
            <column caption='Sessions / 1000 Pop. ' datatype='real' name='[Active Vendors / 1000 Pop. (copy)_1093108130316386305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1000*MAX([sessions])/MAX([population])' />
            </column>
            <column caption='Addressable Market %' datatype='real' default-format='p0.0%' name='[Addressable Market (copy)_4363284401710125091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/ (SUM([population]) * (SUM([orders])/SUM([customers])))' />
            </column>
            <column caption='Above Orders YoY Threshold?' datatype='string' name='[Are we leading? (copy)_4410149976056803328]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_5936799883157467138]*100 &gt; [Parameters].[Parameter 1] THEN &apos;Yes&apos; &#10;ELSEIF ISNULL([Calculation_5936799883157467138]) THEN &apos;N/A&apos; &#10;ELSE &apos;No&apos; END' />
            </column>
            <column caption='Active Vendors / 1000 Pop.' datatype='real' name='[Calculation_1093108130312749056]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1000*MAX([active_vendors])/MAX([population])' />
            </column>
            <column caption='OD Share % ' datatype='real' name='[Calculation_1738389519104368641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[successful_orders_od] / [orders]' />
            </column>
            <column caption='Total CPO' datatype='real' name='[Calculation_2695122957106065417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_cpo_eur_od]+[total_cpo_eur_mp]) / SUM([orders_profit])' />
            </column>
            <column caption='Sorting Nulls' datatype='string' name='[Calculation_4166111192530644996]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([city]) = TRUE THEN &apos;Nulls&apos; ELSE &apos;Not Nulls&apos; END' />
            </column>
            <column caption='FLGPO OD (EUR)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4363284401698955264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgpo_eur_od])/SUM([orders_profit])' />
            </column>
            <column caption='AFV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4363284401704042498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cv_eur])/SUM([orders])' />
            </column>
            <column caption='GPO OD as % of AFV' datatype='real' default-format='p0.0%' name='[Calculation_4363284401704079363]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gpo_eur_od])/SUM([orders_profit])) / [Calculation_4363284401704042498]' />
            </column>
            <column caption='Sessions/Users' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4363284401704538117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions])/SUM([users])' />
            </column>
            <column caption='CVR %' datatype='real' default-format='p0.0%' name='[Calculation_4363284401704591366]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([transactions])/SUM([sessions])' />
            </column>
            <column caption='Seamless Orders %' datatype='real' default-format='p0.0%' name='[Calculation_4363284401704648711]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([seamless_orders])/SUM([orders_gcc])' />
            </column>
            <column caption='Reorder Rate %' datatype='real' default-format='p0.0%' name='[Calculation_4363284401704734728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([orders])-SUM([acquisitions])) / SUM([orders])' />
            </column>
            <column caption='% open time vendors' datatype='real' default-format='p0.0%' name='[Calculation_4363284401705512977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([open_time_vendors])' />
            </column>
            <column caption='% of QC orders' datatype='real' default-format='p0.0%' name='[Calculation_4363284401705762834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_qc])/SUM([orders])' />
            </column>
            <column caption='QC reorder rate' datatype='real' default-format='p0.0%' name='[Calculation_4363284401705828371]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([successful_orders_qc]) - SUM([acquisitions_qcommerce])) / SUM([successful_orders_qc])' />
            </column>
            <column caption='QC penetration' datatype='real' default-format='p0.0%' name='[Calculation_4363284401706020884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customers_qc])/SUM([customers])' />
            </column>
            <column caption='% of orders LS ' datatype='real' default-format='p0.0%' name='[Calculation_4363284401706086421]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_ls])/SUM([orders])' />
            </column>
            <column caption='promotion rate DH %' datatype='real' default-format='p0.0%' name='[Calculation_4363284401706156054]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([voucher_dh_eur]) + SUM([discount_dh_eur])) / (SUM([gmv_eur_profit_od]) + SUM([gmv_eur_profit_mp]))' />
            </column>
            <column caption='Commission Rate' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4363284401707020312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_eur])/(SUM([gmv_eur_profit_od]) + SUM([gmv_eur_profit_mp]))' />
            </column>
            <column caption='Frequency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4363284401707151385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM([customers])' />
            </column>
            <column caption='Delivery Fee per order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4363284401707315226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_eur])/SUM([orders])' />
            </column>
            <column caption='CPH' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4363284401707667484]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([costs_eur])/SUM([rider_hours])' />
            </column>
            <column caption='UTR' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4363284401707716637]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_delivered_logistics])/ SUM([rider_hours])' />
            </column>
            <column caption='GPO OD' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4363284401713877034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gpo_eur_od])/SUM([orders_profit])' />
            </column>
            <column caption='Delivery CPO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4363284401713999915]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-SUM([delivery_cpo_eur_od])/SUM([orders_profit])' />
            </column>
            <column caption='Orders YoY %' datatype='real' default-format='p0.0%' name='[Calculation_5936799883157467138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM([orders_yoy]) - 1' />
            </column>
            <column caption='City Competed?' datatype='string' name='[Calculation_730568349432700932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[market_share]*100 &gt; [Parameters].[Parameter 6] THEN &apos;Yes&apos;&#10;ELSEIF [nps]*100 &gt; [Parameters].[Parameter 4] THEN &apos;Yes&apos; &#10;ELSEIF [brand_interest_ratio]*100 &gt; [Parameters].[Parameter 7] THEN &apos;Yes&apos; &#10;ELSEIF ISNULL([market_share]) AND ISNULL([nps]) AND ISNULL([brand_interest_ratio]) THEN &apos;N/A&apos;&#10;ELSE &apos;No&apos; &#10;END' />
            </column>
            <column caption='Delivery Fee as % GMV' datatype='real' default-format='p0.0%' name='[Delivery Fee per order (copy)_4363284401707388955]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_eur])/(SUM([gmv_eur_profit_od]) + SUM([gmv_eur_profit_mp]))' />
            </column>
            <column caption='FLGPO MP (EUR) ' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[FLGPO OD (EUR) (copy)_1738389519376265218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([flgpo_eur_mp])/SUM([orders_profit_mp])' />
            </column>
            <column caption='FLGPO MP as % of AFV  ' datatype='real' default-format='p0.0%' name='[FLGPO OD as % of AFV  (copy)_1738389519376404483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([flgpo_eur_mp])/SUM([orders_profit]) / [Calculation_4363284401704042498])' />
            </column>
            <column caption='GPO MP' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[GPO OD (copy)_1738389519376928773]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gpo_eur_mp])/SUM([orders_profit_mp])' />
            </column>
            <column caption='GPO MP as % of AFV ' datatype='real' default-format='p0.0%' name='[GPO OD as % of AFV (copy)_1738389519376928772]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gpo_eur_mp])/SUM([orders_profit_mp])) / [Calculation_4363284401704042498]' />
            </column>
            <column caption='FLGPO OD as % of AFV ' datatype='real' default-format='p0.0%' name='[GPO as % of AFV (copy)_4363284401704181764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([flgpo_eur_od])/SUM([orders_profit]) / [Calculation_4363284401704042498])' />
            </column>
            <column caption='Orders Pop Fixed' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Orders Pop (copy)_1614540487542411275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [orders_pop] &gt; 1 THEN 1 ELSE [orders_pop] END' />
            </column>
            <column caption='Percentile Confirmed Orders' datatype='string' default-role='measure' default-type='quantitative' name='[Percentile Potential Orders (copy)_1440870412753461248]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [orders]&lt;={FIXED [country_name],[report_month] :PERCENTILE([orders],.1)} THEN &quot;&lt;10th&quot; ELSEIF&#10;&#10;[orders]&lt;={FIXED [country_name],[report_month] :PERCENTILE([orders],.2)} THEN &quot;&gt;10-20th&quot; ELSEIF&#10;&#10;[orders]&lt;={FIXED [country_name],[report_month] :PERCENTILE([orders],.3)} THEN &quot;&gt;20-30th&quot; ELSEIF&#10;&#10;[orders]&lt;={FIXED [country_name],[report_month] :PERCENTILE([orders],.4)} THEN &quot;&gt;30-40th&quot; ELSEIF&#10;&#10;[orders]&lt;={FIXED [country_name],[report_month] :PERCENTILE([orders],.5)} THEN &quot;&gt;40-50th&quot; ELSEIF&#10;&#10;[orders]&lt;={FIXED [country_name],[report_month] :PERCENTILE([orders],.6)} THEN &quot;&gt;50-60th&quot; ELSEIF&#10;&#10;[orders]&lt;={FIXED [country_name],[report_month] :PERCENTILE([orders],.7)} THEN &quot;&gt;60-70th&quot; ELSEIF&#10;&#10;[orders]&lt;={FIXED [country_name],[report_month] :PERCENTILE([orders],.8)} THEN &quot;&gt;70-80th&quot; ELSEIF&#10;&#10;[orders]&lt;={FIXED [country_name],[report_month] :PERCENTILE([orders],.9)} THEN &quot;&gt;80-90th&quot; ELSEIF&#10;&#10;[orders]&lt;={FIXED [country_name],[report_month] :PERCENTILE([orders],1)} THEN &quot;&gt;90th&quot; END' />
            </column>
