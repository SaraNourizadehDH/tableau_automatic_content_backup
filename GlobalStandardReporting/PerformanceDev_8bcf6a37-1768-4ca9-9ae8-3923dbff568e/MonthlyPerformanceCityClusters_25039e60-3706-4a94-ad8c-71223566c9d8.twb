      <column caption='Acquisition Customers for Calc' datatype='integer' name='[Calculation_4410149976420196379]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM(IIF([month_number]=0, [customers],0)))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Reorder Rate' datatype='real' name='[Calculation_4410149976420237340]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [month_number] = 0 THEN NULL ELSE [return_customers] END)&#10;&#9;/&#10;&#9;[Calculation_4410149976420196379]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='FLGPO / GMV Margin' datatype='real' default-format='p0.0%' name='[Calculation_4410149976422293533]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([flgpo_eur])/SUM([gmv_eur])' />
