90]) = &apos;Gray&apos;) AND ATTR([Calculation_730568349432700932]) = &apos;Yes&apos; THEN &apos;Cluster 3&apos; ELSEIF&#10;([Calculation_5936799883155025920] = &apos;Red&apos; OR [Calculation_5936799883155025920] = &apos;Gray&apos;)   AND (ATTR([Color Orders (copy)_5936799883499143190]) = &apos;Red&apos; OR ATTR([Color Orders (copy)_5936799883499143190]) = &apos;Gray&apos;) AND (ATTR([Color Orders (copy)_5936799883499143190]) = &apos;Red&apos; OR ATTR([Color Orders (copy)_5936799883499143190]) = &apos;Gray&apos;) AND (ATTR([Calculation_730568349432700932]) = &apos;No&apos;  OR ATTR([Color FLGPO (copy)_5936799883500085276]) = &apos;Gray&apos;) THEN &apos;Cluster 3&apos; ELSE &#10;&apos;NA&apos; END' />
            </column>
            <column caption='Clusters Group' datatype='string' name='[Calculation_5936799883870842917]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_5936799883502088223] = &apos;Cluster 1&apos; THEN &apos;Continue current strategy and operations&apos;&#10;ELSEIF [Calculation_5936799883502088223] = &apos;Cluster 2&apos; THEN &apos;Focus on growth&apos;&#10;ELSEIF [Calculation_5936799883502088223] = &apos;Cluster 3&apos; THEN &apos;Focus on profitability&apos;&#10;ELSE &apos;NA&apos;&#10;END' />
            </column>
            <column caption='SUM(1)' datatype='integer' name='[Calculation_6263240493031931907]' role='measure' type='quantitative' user:unnamed='Line Chart Cluster Evolution'>
              <calculation class='tableau' formula='SUM(1)' />
            </column>
            <column caption='SUM(1)' datatype='integer' name='[Calculation_6263240493031981061]' role='measure' type='quantitative' user:unnamed='Line Chart Cluster Evolution'>
              <calculation class='tableau' formula='SUM(1)' />
            </column>
            <column caption='City Competed?' datatype='string' name='[Calculation_730568349432700932]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;[market_share]*100 &gt; [Parameters].[Parameter 6] THEN &apos;Yes&apos;&#10;ELSEIF [nps]*100 &gt; [Parameters].[Parameter 4] THEN &apos;Yes&apos; &#10;ELSEIF [brand_interest_ratio]*100 &gt; [Parameters].[Parameter 7] THEN &apos;Yes&apos; &#10;ELSEIF ISNULL([market_share]) AND ISNULL([nps]) AND ISNULL([brand_interest_ratio]) THEN &apos;N/A&apos;&#10;ELSE &apos;No&apos; &#10;END' />
            </column>
            <column caption='Color NPS' datatype='string' name='[Color FLGPO (copy)_5936799883500085276]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [nps] &lt; [Parameters].[Parameter 4] THEN &apos;Red&apos;&#10;ELSEIF ISNULL([nps]) THEN &apos;Gray&apos;&#10; ELSE &apos;Green&apos; END' />
            </column>
            <column caption='Color Orders / addr pop' datatype='string' name='[Color Orders (copy)_5936799883499143190]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [orders_pop]*100 &lt; [Parameters].[Parameter 2] THEN &apos;Red&apos;&#10;ELSEIF ISNULL([orders_pop]) THEN &apos;Gray&apos;&#10; ELSE &apos;Green&apos; END' />
            </column>
            <column caption='Orders Pop Fixed' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Orders Pop (copy)_1614540487542411275]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [orders_pop] &gt; 1 THEN 1 ELSE [orders_pop] END' />
            </column>
            <column caption='Percentile Confirmed Orders' datatype='string' default-role='measure' default-type='quantitative' name='[Percentile Potential Orders (copy)_1440870412753461248]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [orders]&lt;={FIXED [country_name],[report_month] :PERCENTILE([orders],.1)} THEN &quot;&lt;10th&quot; ELSEIF&#10;&#10;[orders]&lt;={FIXED [country_name],[report_month] :PERCENTILE([orders],.2)} THEN &quot;&gt;10-20th&quot; ELSEIF&#10;&#10;[orders]&lt;={FIXED [country_name],[report_month] :PERCENTILE([orders],.3)} THEN &quot;&gt;20-30th&quot; ELSEIF&#10;&#10;[orders]&lt;={FIXED [country_name],[report_month] :PERCENTILE([orders],.4)} THEN &quot;&gt;30-40th&quot; ELSEIF&#10;&#10;[orders]&lt;={FIXED [country_name],[report_month] :PERCENTILE([orders],.5)} THEN &quot;&gt;40-50th&quot; ELSEIF&#10;&#10;[orders]&lt;={FIXED [country_name],[report_month] :PERCENTILE([orders],.6)} THEN &quot;&gt;50-60th&quot; ELSEIF&#10;&#10;[orders]&lt;={FIXED [country_name],[report_month] :PERCENTILE([orders],.7)} THEN &quot;&gt;60-70th&quot; ELSEIF&#10;&#10;[orders]&lt;={FIXED [country_name],[report_month] :PERCENTILE([orders],.8)} THEN &quot;&gt;70-80th&quot; ELSEIF&#10;&#10;[orders]&lt;={FIXED [country_name],[report_month] :PERCENTILE([orders],.9)} THEN &quot;&gt;80-90th&quot; ELSEIF&#10;&#10;[orders]&lt;={FIXED [country_name],[report_month] :PERCENTILE([orders],1)} THEN &quot;&gt;90th&quot; END' />
            </column>
            <column caption='Y Axis Metric' datatype='real' name='[X Axis Metric (copy)_5936799883868512291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[X Axis Metric (copy)_5936799883868864548]&#10;WHEN &apos;1&apos; THEN [Calculation_5936799883157467138]*100&#10;WHEN &apos;2&apos; THEN ATTR([orders_pop])*100&#10;WHEN &apos;3&apos; THEN [Calculation_4363284401698955264]&#10;WHEN &apos;4&apos; THEN ATTR([nps])*100&#10;END' />
            </column>
            <column caption='Brand Interest Ratio' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[brand_interest_ratio]' role='measure' type='quantitative' />
