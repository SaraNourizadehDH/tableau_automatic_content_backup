      <aliases enabled='yes' />
      <column caption='KPI - pct vs abs' datatype='string' name='[Calculation_1740430159354433536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LOWER([metric_pct_or_abs])' />
      </column>
      <column caption='DH All' datatype='string' name='[Calculation_2238007595143811076]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;DH Platform&apos;' />
      </column>
      <column caption='Date Granularity' datatype='string' name='[Calculation_2238007595145101317]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
      </column>
      <column caption='Detail Level Filter' datatype='boolean' name='[Calculation_2800464912414384128]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] THEN [management_entity]=&apos;DH&apos; ELSE [management_entity]&lt;&gt;&apos;DH&apos; END' />
      </column>
      <column caption='Value Weighted' datatype='real' name='[Calculation_2800464912436207620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([value]*[value_weight])/([value_weight])' />
      </column>
      <column caption='is sum values &gt; 0' datatype='boolean' name='[Calculation_2800464912438325254]' role='measure' type='nominal'>
        <calculation class='tableau' formula='sum([value])&gt;0' />
      </column>
      <column caption='Value -pct ' datatype='real' default-format='p0.0%' name='[Value (copy)_6255851734724009984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;IF [Calculation_1740430159354433536] = &apos;pct&apos;  THEN &#10;    ROUND([Calculation_2800464912436207620], [rounding])&#10;ELSE NULL&#10;END&#10;)' />
      </column>
      <column caption='Value -abs  ' datatype='real' default-format='N' name='[Value - try -pct  (copy)_6255851734725029893]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;IF [Calculation_1740430159354433536] = &apos;abs&apos; THEN &#10;    ROUND([Calculation_2800464912436207620]/[divide_by],[rounding]) &#10;ELSE NULL&#10;END&#10;)' />
      </column>
      <column caption='Value -abs  - 2 no round' datatype='real' default-format='n#,##0;-#,##0' name='[Value -abs   (copy)_2800464912440885255]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [Calculation_1740430159354433536] = &apos;abs&apos; AND [metric_name] = &apos;cpg_advertisers&apos; THEN &#10;    ROUND([Calculation_2800464912436207620]/[divide_by],[rounding]) &#10;ELSE NULL&#10;END&#10;)' />
      </column>
