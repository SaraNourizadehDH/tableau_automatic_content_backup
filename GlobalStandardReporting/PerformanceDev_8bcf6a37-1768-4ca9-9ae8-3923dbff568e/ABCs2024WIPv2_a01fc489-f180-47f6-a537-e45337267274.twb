            <column caption='KPI - pct vs abs' datatype='string' name='[Calculation_1740430159354433536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LOWER([metric_pct_or_abs])' />
            </column>
            <column caption='Value Weighted' datatype='real' name='[Calculation_2800464912436207620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([value]*[value_weight])/([value_weight])' />
            </column>
            <column caption='is sum values &gt; 0' datatype='boolean' name='[Calculation_2800464912438325254]' role='measure' type='nominal'>
