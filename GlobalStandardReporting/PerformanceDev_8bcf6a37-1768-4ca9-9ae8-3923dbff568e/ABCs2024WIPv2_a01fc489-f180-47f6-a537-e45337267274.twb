      <aliases enabled='yes' />
      <column caption='Value - quarterly' datatype='real' name='[Calculation_2800464912445710345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[value]*[value_weight]/[value_weight]' />
      </column>
      <column caption='Value - abs' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2800464912446218250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;IF [metric_pct_or_abs] = &apos;abs&apos; THEN [Calculation_2800464912445710345] END&#10;)' />
      </column>
      <column caption='Quarter' datatype='string' name='[Calculation_2800464912448356368]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([report_quarter])) +&quot; - &quot;  + &quot;Q&quot; + STR(QUARTER([report_quarter]) )' />
      </column>
      <column caption='is value&gt;0' datatype='boolean' name='[Calculation_2800464912451203090]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_2800464912445710345]&gt;0' />
      </column>
      <column caption='Detail Level Filter' datatype='boolean' name='[Calculation_2800464912455811091]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] THEN [management_entity] = &apos;DH&apos; ELSE TRUE END' />
      </column>
      <column caption='is included in vs Target' datatype='boolean' name='[Calculation_2995456702583107584]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;    [target_value]&gt;0 AND value &gt;0 THEN TRUE &#10;     ELSE FALSE&#10;END' />
      </column>
      <column caption='vs Target - abs' datatype='real' default-format='p0.0%' name='[Calculation_5401645544776384522]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2800464912446218250] / [Target Value (copy)_2800464912461668372] -1' />
      </column>
      <column caption='is vs Target positive ' datatype='boolean' name='[Calculation_5401645544776708108]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[value] &gt; [target_value]' />
      </column>
      <column caption='Target Value - abs' datatype='real' name='[Target Value (copy)_2800464912461668372]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;IF [metric_pct_or_abs] = &apos;abs&apos; THEN [target_value] END&#10;)' />
      </column>
      <column caption='Target Value - pct' datatype='real' default-format='p0.0%' name='[Target Value - abs (copy)_2800464912461832213]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;IF [metric_pct_or_abs] = &apos;pct&apos; THEN [target_value] END&#10;)' />
      </column>
      <column caption='Value -pct' datatype='real' default-format='p0.0%' name='[Value - abs (copy)_2800464912446320651]' role='measure' type='quantitative'>
