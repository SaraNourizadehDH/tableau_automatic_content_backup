    <worksheet name='Big Bets - Seamless Delivery'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_performance_call' name='federated.1o39sqk195y5x71bd9y4d1gvvfkn' />
          </datasources>
          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='Logistics Index' datatype='real' name='[Calculation_1456351588992905283]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143393374331] /[Calculation_3478397397341298689]' />
            </column>
            <column caption='UTR Exact' datatype='real' name='[Calculation_3478397397341298689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_delivered]) / sum([rider_hours])' />
            </column>
            <column caption='MoM UTR Exact' datatype='real' default-format='p0.0%' name='[Calculation_3478397397341749250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3478397397341298689] / (sum([orders_delivered_mom]) / sum([rider_hours_mom])) - 1' />
            </column>
            <column caption='Hard Fail Rate OD' datatype='real' default-format='p0.0%' name='[Calculation_3704844076327120904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders_od]) /(sum([successful_orders_od]) + sum([failed_orders_od]))' />
            </column>
            <column caption='MoM Hard Fail Rate OD' datatype='real' default-format='p0.0%' name='[Calculation_3704844076329992202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3704844076327120904] / (sum([failed_orders_od_mom]) /(sum([successful_orders_od_mom]) + sum([failed_orders_od_mom]))) - 1' />
            </column>
            <column caption='Restaurant Failure MoM' datatype='real' default-format='p0.0%' name='[Calculation_5552023601059934238]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurant_failure])/SUM([restaurant_failure_mom]) - 1' />
            </column>
            <column caption='&quot;Seamless delivery&quot;' datatype='string' name='[Calculation_6175631400228864004]' role='dimension' type='nominal' user:unnamed='Seamless Delivery'>
              <calculation class='tableau' formula='&quot;Seamless delivery&quot;' />
            </column>
            <column caption='Avg DT MOM' datatype='real' name='[Calculation_6479624335829762048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(sum_delivery_time_in_mins_mom) / SUM([total_orders_log_mom])' />
            </column>
            <column caption='UTR EXACT MOM' datatype='real' name='[Calculation_6479624335830134787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_delivered_mom]) / sum([rider_hours_mom])' />
            </column>
            <column caption='OD Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143298539523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_orders_od]) / sum([orders])' />
            </column>
            <column caption='OD Share MoM' datatype='real' name='[Calculation_6734148143298875396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_orders_od_mom]) / sum([orders_mom])' />
            </column>
            <column caption='MoM OD Share' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Calculation_6734148143299354630]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6734148143298539523]*100) - ([Calculation_6734148143298875396]*100)' />
            </column>
            <column caption='MoM' datatype='string' name='[Calculation_6734148143346507829]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;MoM&quot;' />
            </column>
            <column caption='Hard Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_6734148143378624614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders]) / (sum([orders])+sum([failed_orders]))' />
            </column>
            <column caption='Dh Failure Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143382536295]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dh_failure]) / (SUM([orders]) + SUM([failed_orders]))' />
            </column>
            <column caption='MoM Dh Failure Share OD' datatype='real' default-format='p0.0%' name='[Calculation_6734148143382966376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143382536295] /  &#10;(&#10;sum([dh_failure_mom]) / (SUM([orders_mom]) + SUM([failed_orders_mom])) &#10;) - 1' />
            </column>
            <column caption='Other Failure Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143384105069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([other_failure]) / (SUM(orders)+SUM([failed_orders]))' />
            </column>
            <column caption='MoM Other Failure Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143384301678]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143384105069] / (sum([other_failure_mom]) / (SUM(orders_mom)+SUM([failed_orders_mom]))) - 1' />
            </column>
            <column caption='Acceptance Rate' datatype='real' default-format='p0.0%' name='[Calculation_6734148143385440371]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([accepted]) / sum([offered])' />
            </column>
            <column caption='MoM Acceptance Rate' datatype='real' default-format='p0.0%' name='[Calculation_6734148143385690228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143385440371] / (sum([accepted_mom]) / sum([offered_mom])) - 1' />
            </column>
            <column caption='Online Payment Order Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143386165366]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_payment_online]) / sum([orders])' />
            </column>
            <column caption='MoM Online Payment Order Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143386505335]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143386165366] / (sum([orders_payment_online_mom]) / sum([orders_mom])) - 1' />
            </column>
            <column caption='Avg Delivery Time' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143393374331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(sum_delivery_time_in_mins) / SUM([count_delivery_time])' />
            </column>
            <column caption='Delay Over 10 Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143398027391]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([is_delivery_delay_late_10_mins]) / SUM([total_orders_log])' />
            </column>
            <column caption='MoM Delay over 10 Share' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Calculation_6734148143400177792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6734148143398027391] *100) - ((sum([is_delivery_delay_late_10_mins_mom]) / sum([total_orders_log_mom]))*100)' />
            </column>
            <column caption='Avg Delivery Distance' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143400939650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_delivery_distance_km]) / sum([count_delivery_distance])' />
            </column>
            <column caption='MoM Avg Delivery Distance' datatype='real' default-format='p0.0%' name='[Calculation_6734148143401341059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143400939650] / (sum([sum_delivery_distance_km_mom]) / sum([count_delivery_distance_mom])) - 1' />
            </column>
            <column caption='MoM Hard Fail Rate' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Calculation_6734148143660716215]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6734148143378624614]*100) - (sum([failed_orders_mom]) / (sum([orders_mom])+sum([failed_orders_mom]))*100)' />
            </column>
            <column caption='MoM Avg Delivery Time' datatype='real' default-format='p0.0%' name='[Calculation_6734148143661973689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143393374331] / (sum([sum_delivery_time_in_mins_mom]) / sum([count_delivery_time_mom])) -1' />
            </column>
            <column caption='Hard Fail Rate Local Stores' datatype='real' default-format='p0.0%' name='[Hard Fail Rate (copy) (copy) (copy) (copy)_3792382734026858507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders_ls]) / (sum([successful_orders_ls])+sum([failed_orders_ls]))' />
            </column>
            <column caption='Hard Fail Rate OD Dmarts' datatype='real' default-format='p0.0%' name='[Hard Fail Rate (copy) (copy) (copy)_3792382734026842122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders_od_dmarts]) / (sum([successful_orders_od_dmarts])+sum([failed_orders_od_dmarts]))' />
            </column>
            <column caption='Hard Fail Rate MP' datatype='real' default-format='p0.0%' name='[Hard Fail Rate (copy)_3792382734026780680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders_mp]) / (sum([successful_orders_mp])+sum([failed_orders_mp]))' />
            </column>
            <column caption='Logistics Index MoM' datatype='real' default-format='p0.0%' name='[Logistics Index (copy)_1456351588993310788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1456351588992905283]) / ([Calculation_6479624335829762048]/[Calculation_6479624335830134787]) -1' />
            </column>
            <column caption='MoM Hard Fail Rate LS' datatype='real' default-format='p0.0%' name='[MoM Hard Fail Rate DS (copy 3)_3792382734041796624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Hard Fail Rate (copy) (copy) (copy) (copy)_3792382734026858507]*100 -&#10; (sum([failed_orders_ls_mom]) / (sum([successful_orders_ls_mom])+sum([failed_orders_ls_mom])) *100)' />
