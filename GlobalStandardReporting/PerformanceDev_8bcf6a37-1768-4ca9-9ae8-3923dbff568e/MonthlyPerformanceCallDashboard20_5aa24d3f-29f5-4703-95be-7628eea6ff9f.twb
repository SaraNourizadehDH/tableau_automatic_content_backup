    <worksheet name='Big Bets - Seamless Delivery YoY'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_performance_call' name='federated.1o39sqk195y5x71bd9y4d1gvvfkn' />
          </datasources>
          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='Avg DT YOY' datatype='real' name='[Avg DT MOM (copy)_6479624335829856257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(sum_delivery_time_in_mins_yoy) / SUM([total_orders_log_yoy])' />
            </column>
            <column caption='Logistics Index' datatype='real' name='[Calculation_1456351588992905283]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143393374331] /[Calculation_3478397397341298689]' />
            </column>
            <column caption='UTR Exact' datatype='real' name='[Calculation_3478397397341298689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_delivered]) / sum([rider_hours])' />
            </column>
            <column caption='YoY UTR Exact' datatype='real' default-format='p0.0%' name='[Calculation_3478397397342019587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3478397397341298689] / (sum([orders_delivered_yoy]) / sum([rider_hours_yoy])) - 1' />
            </column>
            <column caption='Hard Fail Rate OD' datatype='real' default-format='p0.0%' name='[Calculation_3704844076327120904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders_od]) /(sum([successful_orders_od]) + sum([failed_orders_od]))' />
            </column>
            <column caption='YoY Hard Fail Rate OD' datatype='real' default-format='p0.0%' name='[Calculation_3704844076330749963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3704844076327120904] / (sum([failed_orders_od_yoy]) /(sum([successful_orders_od_yoy]) + sum([failed_orders_od_yoy]))) - 1' />
            </column>
            <column caption='YoY DH Failure Share OD' datatype='real' default-format='p0.0%' name='[Calculation_3704844076332695567]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143382536295] /  &#10;(&#10;sum([dh_failure_yoy]) / (SUM([orders_yoy]) + SUM([failed_orders_yoy])) &#10;) - 1' />
            </column>
            <column caption='&quot;Seamless delivery&quot;' datatype='string' name='[Calculation_6175631400228864004]' role='dimension' type='nominal' user:unnamed='Seamless Delivery'>
              <calculation class='tableau' formula='&quot;Seamless delivery&quot;' />
            </column>
            <column caption='OD Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143298539523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_orders_od]) / sum([orders])' />
            </column>
            <column caption='OD Share YoY' datatype='real' name='[Calculation_6734148143299194885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_orders_od_yoy]) / sum([orders_yoy])' />
            </column>
            <column caption='YoY OD Share' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Calculation_6734148143299448839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6734148143298539523]*100) - ([Calculation_6734148143299194885]*100)' />
            </column>
            <column caption='Hard Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_6734148143378624614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders]) / (sum([orders])+sum([failed_orders]))' />
            </column>
            <column caption='Dh Failure Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143382536295]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dh_failure]) / (SUM([orders]) + SUM([failed_orders]))' />
            </column>
            <column caption='Other Failure Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143384105069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([other_failure]) / (SUM(orders)+SUM([failed_orders]))' />
            </column>
            <column caption='YoY Other Failure Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143384481903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143384105069] / (sum([other_failure_yoy]) / (SUM(orders_yoy)+SUM([failed_orders_yoy]))) - 1' />
            </column>
            <column caption='Acceptance Rate' datatype='real' default-format='p0.0%' name='[Calculation_6734148143385440371]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([accepted]) / sum([offered])' />
            </column>
            <column caption='YoY Acceptance Rate' datatype='real' default-format='p0.0%' name='[Calculation_6734148143385923701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143385440371] / (sum([accepted_yoy]) / sum([offered_yoy])) - 1' />
            </column>
            <column caption='Online Payment Order Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143386165366]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_payment_online]) / sum([orders])' />
            </column>
            <column caption='YoY Online Payment Order Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143386763384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143386165366] / (sum([orders_payment_online_yoy]) / sum([orders_yoy])) - 1' />
            </column>
            <column caption='Avg Delivery Time' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143393374331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(sum_delivery_time_in_mins) / SUM([count_delivery_time])' />
            </column>
            <column caption='Delay Over 10 Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143398027391]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([is_delivery_delay_late_10_mins]) / SUM([total_orders_log])' />
            </column>
            <column caption='YoY Delay over 10 Share' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Calculation_6734148143400542337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6734148143398027391]*100) - (sum([is_delivery_delay_late_10_mins_yoy]) / sum([total_orders_log_yoy])*100)' />
            </column>
            <column caption='Avg Delivery Distance' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143400939650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_delivery_distance_km]) / sum([count_delivery_distance])' />
            </column>
            <column caption='YoY Avg Delivery Distance' datatype='real' default-format='p0.0%' name='[Calculation_6734148143401750660]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143400939650] / (sum([sum_delivery_distance_km_yoy]) / sum([count_delivery_distance_yoy])) - 1' />
            </column>
            <column caption='YoY Hard Fail Rate' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Calculation_6734148143660953784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6734148143378624614]*100) - (sum([failed_orders_yoy]) / (sum([orders_yoy])+sum([failed_orders_yoy]))*100)' />
            </column>
            <column caption='YoY Avg Delivery Time' datatype='real' default-format='p0.0%' name='[Calculation_6734148143662792890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143393374331] / (sum([sum_delivery_time_in_mins_yoy]) / sum([count_delivery_time_yoy])) -1' />
            </column>
            <column caption='YoY' datatype='string' name='[Calculation_6734148144005718231]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;YoY&quot;' />
            </column>
            <column caption='Hard Fail Rate Local Stores' datatype='real' default-format='p0.0%' name='[Hard Fail Rate (copy) (copy) (copy) (copy)_3792382734026858507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders_ls]) / (sum([successful_orders_ls])+sum([failed_orders_ls]))' />
            </column>
            <column caption='Hard Fail Rate OD Dmarts' datatype='real' default-format='p0.0%' name='[Hard Fail Rate (copy) (copy) (copy)_3792382734026842122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders_od_dmarts]) / (sum([successful_orders_od_dmarts])+sum([failed_orders_od_dmarts]))' />
            </column>
            <column caption='Hard Fail Rate MP' datatype='real' default-format='p0.0%' name='[Hard Fail Rate (copy)_3792382734026780680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders_mp]) / (sum([successful_orders_mp])+sum([failed_orders_mp]))' />
            </column>
            <column caption='Logistics Index YoY' datatype='real' default-format='p0.0%' name='[Logistics Index (copy) (copy)_1456351588993347653]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1456351588992905283]) / ([Avg DT MOM (copy)_6479624335829856257]/[UTR EXACT MOM (copy)_6479624335830208516]) -1' />
            </column>
            <column caption='YoY Hard Fail Rate MP' datatype='real' default-format='p0.0%' name='[MoM Hard Fail Rate MP (copy)_3792382734043279378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Hard Fail Rate (copy)_3792382734026780680] / (sum([failed_orders_mp_yoy]) / (sum([successful_orders_mp_yoy])+sum([failed_orders_mp_yoy]))) - 1' />
            </column>
            <column caption='YoY Hard Fail Rate LS' datatype='real' default-format='p0.0%' name='[MoM Hard Fail Rate OD Restaurant (copy)_3792382734043324436]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Hard Fail Rate (copy) (copy) (copy) (copy)_3792382734026858507]*100 -&#10; (sum([failed_orders_ls_yoy]) / (sum([successful_orders_ls_yoy])+sum([failed_orders_ls_yoy])) *100)' />
            </column>
            <column caption='Orders Delayed &gt; 45m ' datatype='real' default-format='p0.0%' name='[Orders Delayed &gt; 10m (copy)_1456351588991729725]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(is_delivery_delay_late_45_mins) / SUM([total_orders_log])' />
            </column>
            <column caption='Orders Delayed &gt; 45m YoY' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Orders Delayed &gt; 10m YoY (copy)_1456351588991729727]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Orders Delayed &gt; 10m (copy)_1456351588991729725]*100) - (SUM(is_delivery_delay_late_45_mins_yoy) / SUM([total_orders_log_yoy])*100)' />
            </column>
            <column caption='Orders Delayed &lt; 20 m' datatype='real' default-format='p0.0%' name='[Orders Delayed &gt; 45m  (copy)_1456351588992401472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_delivery_time_less_20_m]) / SUM([count_delivery_time 1])' />
            </column>
            <column caption='Orders Delayed &lt; 20m YoY' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Orders Delayed &gt; 45m YoY (copy)_1456351588992401474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Orders Delayed &gt; 45m  (copy)_1456351588992401472]*100) - (SUM([sum_delivery_time_less_20_m_yoy]) / SUM([count_delivery_time_mom 1])*100)' />
            </column>
            <column caption='Restaurant Failure YoY' datatype='real' default-format='p0.0%' name='[Restaurant Failure MoM (copy)_5552023601060024351]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurant_failure])/SUM([restaurant_failure_yoy]) - 1' />
            </column>
            <column caption='UTR EXACT YOY' datatype='real' name='[UTR EXACT MOM (copy)_6479624335830208516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_delivered_yoy]) / sum([rider_hours_yoy])' />
