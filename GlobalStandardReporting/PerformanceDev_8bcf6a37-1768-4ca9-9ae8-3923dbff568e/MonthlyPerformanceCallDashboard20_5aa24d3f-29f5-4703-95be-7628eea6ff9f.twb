    <worksheet name='ALL MoM (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_performance_call' name='federated.1o39sqk195y5x71bd9y4d1gvvfkn' />
          </datasources>
          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='ABV MoM Dmarts' datatype='real' default-format='p0.0%' name='[ABV (copy)_6175631400285098057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gbv_eur_dmarts])/SUM(successful_orders_dmarts))&#10;/ &#10;(SUM([gbv_eur_dmarts_mom])/SUM([successful_orders_dmarts_mom])) -1' />
            </column>
            <column caption='Avg DF/AFV MoM - OD' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[Avg DF/AFV (copy)_6343601566267502596]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6343601566266662914] *100)&#10;- &#10;&#10;(((SUM([amt_delivery_fee_eur_profit_mom_od]) + SUM([service_fee_eur_profit_od_mom]))/ (SUM([gfv_eur_profit_od_mom]) ))*100)' />
            </column>
            <column caption='QC Orders Share MoM %' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Calculation_1015983964494499845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2593510442291662850] * 100) - ([qc_order_share (copy)_2593510442333446151]*100)' />
            </column>
            <column caption='blank' datatype='real' name='[Calculation_1108518874172026880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(NULL)' />
            </column>
            <column caption='Pickup Orders MoM' datatype='real' default-format='p0.0%' name='[Calculation_128422982422917120]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_pickup]) / SUM([successful_orders_pickup_mom]) - 1' />
            </column>
            <column caption='CARC' datatype='real' name='[Calculation_1395834461065924611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-1 * SUM([lucc_carc_eur])' />
            </column>
            <column caption='CARC MOM' datatype='real' default-format='p0.0%' name='[Calculation_1395834461066510340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1395834461065924611] / (-1 * SUM([lucc_carc_eur_mom])) -1' />
            </column>
            <column caption='Total CPO as % AOV MoM' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Calculation_1456351588657405955]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(([Calculation_6175631400257261585] / [Calculation_2889129578632097802]) * 100)&#10;&#10;- (([Total CPO (EUR) (copy)_1015983964518019106] / ((sum([amt_gmv_eur_profit_mom]) / sum([orders_succ_profit_mom])))) * 100)' />
            </column>
            <column caption='Logistics Index' datatype='real' name='[Calculation_1456351588992905283]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143393374331] /[Calculation_3478397397341298689]' />
            </column>
            <column caption='Frequency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1602014871802343424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM([active_customers])' />
            </column>
            <column caption='&quot;Growing&quot;' datatype='string' name='[Calculation_1602014871803613187]' role='dimension' type='nominal' user:unnamed='Growing'>
              <calculation class='tableau' formula='&quot;Growing&quot;' />
            </column>
            <column caption='NPS AO Food' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1602014871812845574]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ao_nps_promoters_food])-SUM([ao_nps_detractors_food])) / SUM([ao_nps_responses_food])*100' />
            </column>
            <column caption='dmarts orders share' datatype='real' default-format='p0.0%' name='[Calculation_1602014871821447181]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(successful_orders_dmarts)/SUM([orders])' />
            </column>
            <column caption='LS order share' datatype='real' default-format='p0.0%' name='[Calculation_1602014871822528527]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_ls])/SUM([orders])' />
            </column>
            <column caption='QC Orders Share' datatype='real' default-format='p0.0%' name='[Calculation_2593510442291662850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(successful_orders_qc)/SUM([orders])' />
            </column>
            <column caption='Orders Dmarts MoM %' datatype='real' default-format='p0.0%' name='[Calculation_2593510442334281737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_dmarts])/SUM([successful_orders_dmarts_mom]) - 1' />
            </column>
            <column caption='Brand Preference MoM' datatype='real' name='[Calculation_2889129578624602112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG([brand_preference]) - AVG([brand_preference_mom])) * 100' />
            </column>
            <column caption='TOM MoM' datatype='real' name='[Calculation_2889129578626064386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG([top_of_mind]*100)) - (AVG([top_of_mind_mom]*100))' />
            </column>
            <column caption='AOV profitability' datatype='real' name='[Calculation_2889129578632097802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_gmv_eur_profit])/SUM([orders_succ_profit])' />
            </column>
            <column caption='UTR Exact' datatype='real' name='[Calculation_3478397397341298689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_delivered]) / sum([rider_hours])' />
            </column>
            <column caption='MoM UTR Exact' datatype='real' default-format='p0.0%' name='[Calculation_3478397397341749250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3478397397341298689] / (sum([orders_delivered_mom]) / sum([rider_hours_mom])) - 1' />
            </column>
            <column caption='Retention 1 Month' datatype='real' default-format='p0.0%' name='[Calculation_3704844076316794883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([c1_users]) / sum([c1_acquisitions])' />
            </column>
            <column caption='MoM Frequency ' datatype='real' default-format='p0.0%' name='[Calculation_5552023601044103176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1602014871802343424]/[Frequency (copy)_6175631400268054555] - 1' />
            </column>
            <column caption='NPS AO MoM DIFF' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5552023601049825303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143635775639] &#10;- (( sum([ao_nps_promoters_mom]) - sum([ao_nps_detractors_mom]) ) / sum([ao_nps_responses_mom]) * 100)' />
            </column>
            <column caption='Take Rate (EUR)' datatype='real' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[Calculation_6175631400253345801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(take_in_cpo_eur)' />
            </column>
            <column caption='Total CPO (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6175631400257261585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_cpo_eur]) / SUM([orders_succ_profit])' />
            </column>
            <column caption='Avg DF/AFV Inc SF - OD' datatype='real' default-format='p0.0%' name='[Calculation_6343601566266662914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([amt_delivery_fee_eur_profit_od]) + SUM([service_fee_eur_profit_od]))/ (SUM([gfv_eur_profit_od]) )' />
            </column>
            <column caption='Avg DT MOM' datatype='real' name='[Calculation_6479624335829762048]' role='measure' type='quantitative'>
