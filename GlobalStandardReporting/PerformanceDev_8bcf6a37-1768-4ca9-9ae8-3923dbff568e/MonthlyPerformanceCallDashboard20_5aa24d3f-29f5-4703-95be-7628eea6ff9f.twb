          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='QC Orders Share MoM %' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Calculation_1015983964494499845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2593510442291662850] * 100) - ([qc_order_share (copy)_2593510442333446151]*100)' />
            </column>
            <column caption='QC Orders Share' datatype='real' default-format='p0.0%' name='[Calculation_2593510442291662850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(successful_orders_qc)/SUM([orders])' />
            </column>
            <column caption='VFI % GMV' datatype='real' default-format='p0.0%' name='[Calculation_3692459156842242079]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_funded_incentives_eur])/SUM([gmv_eur])' />
            </column>
            <column caption='NPS AO MoM DIFF' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_5552023601049825303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143635775639] &#10;- (( sum([ao_nps_promoters_mom]) - sum([ao_nps_detractors_mom]) ) / sum([ao_nps_responses_mom]) * 100)' />
            </column>
            <column caption='ATTR' datatype='integer' name='[Calculation_557250127735005184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='CVR Total' datatype='real' default-format='p0.00%' name='[Calculation_6734148143630839943]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_76631562432221200] / [Calculation_76631562431836175]' />
            </column>
            <column caption='NPS AO' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_6734148143635775639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( sum([ao_nps_promoters]) - sum([ao_nps_detractors]) ) / sum([ao_nps_responses]) * 100' />
            </column>
            <column caption='Sessions Perseus' datatype='real' default-format='n#,##0,K;-#,##0,K' name='[Calculation_76631562431836175]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions])' />
            </column>
            <column caption='Transactions total' datatype='real' default-format='n#,##0,K;-#,##0,K' name='[Calculation_76631562432221200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_w_order])' />
            </column>
            <column caption='GMV per Dmart Store (active)' datatype='real' name='[Calculation_924223132964265985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur_dmarts])/SUM([dmarts_active])' />
            </column>
            <column caption='GMV per Dmart Store MoM' datatype='real' default-format='p0.0%' name='[GMV per Dmart Store (active) (copy)_924223132964847618]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gmv_eur_dmarts])/SUM([dmarts_active]) )&#10;/&#10;&#10; (SUM([gmv_eur_dmarts_mom])/SUM([dmarts_active_mom])) -1' />
            </column>
            <column caption='GMV per Dmart Store YoY' datatype='real' default-format='p0.0%' name='[GMV per Dmart Store MoM (copy)_924223132965244931]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gmv_eur_dmarts])/SUM([dmarts_active]) )&#10;/&#10;&#10; (SUM([gmv_eur_dmarts_yoy])/SUM([dmarts_active_yoy]))&#10;-1' />
            </column>
            <column caption='Seamless order share' datatype='real' default-format='p0.0%' name='[LS order share (copy)_107734565630611458]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([seamless_orders])&#10;/&#10;SUM(IIF([global_entity_id] = &apos;BM_KR&apos;, 0, [orders_gcc]))' />
            </column>
            <column caption='MoM CVR Total ' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[MoM CVR Total (copy)_6175631400281047101]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143630839943]*100 -  &#10;((sum([sessions_w_order_mom])) &#10;/ (sum(sessions_mom))*100)' />
