    <worksheet name='Ambition - Caring YoY'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_performance_call' name='federated.1o39sqk195y5x71bd9y4d1gvvfkn' />
          </datasources>
          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='NPS AO Food' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1602014871812845574]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ao_nps_promoters_food])-SUM([ao_nps_detractors_food])) / SUM([ao_nps_responses_food])*100' />
            </column>
            <column caption='&quot;Caring&quot;' datatype='string' name='[Calculation_6175631400228622336]' role='dimension' type='nominal' user:unnamed='Caring'>
              <calculation class='tableau' formula='&quot;Caring&quot;' />
            </column>
            <column caption='NPS AO' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_6734148143635775639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( sum([ao_nps_promoters]) - sum([ao_nps_detractors]) ) / sum([ao_nps_responses]) * 100' />
            </column>
            <column caption='NPS AO Pickup' datatype='real' default-format='n#,##0;-#,##0' name='[NPS AO Food (copy)_1456351588655882240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(nps_ao_promoters_pickup)-SUM(nps_ao_detractors_pickup)) / SUM(nps_responses_pickup)*100' />
            </column>
            <column caption='NPS AO Dmarts' datatype='real' default-format='n#,##0;-#,##0' name='[NPS AO Food (copy)_1602014871813451783]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ao_nps_promoters_dmarts])-SUM([ao_nps_detractors_dmarts])) / SUM([ao_nps_responses_dmarts])*100' />
            </column>
            <column caption='NPS AO Local Stores' datatype='real' default-format='n#,##0;-#,##0' name='[NPS AO Food (copy)_1602014871813959688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ao_nps_promoters_ls])-SUM([ao_nps_detractors_ls])) / SUM([ao_nps_responses_ls])*100' />
            </column>
            <column caption='NPS AO YoY DIFF ' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[NPS AO MoM DIFF (copy)_5552023601050329113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143635775639] - (( sum([ao_nps_promoters_yoy]) - sum([ao_nps_detractors_yoy]) ) / sum([ao_nps_responses_yoy]) * 100)' />
            </column>
            <column caption='NPS YoY Diff Dmarts' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[NPS MOM Diff Dmarts (copy)_6175631400275320879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[NPS AO Food (copy)_1602014871813451783]- (  (SUM([ao_nps_promoters_dmarts_yoy])-SUM([ao_nps_detractors_dmarts_yoy]))/SUM([ao_nps_responses_dmarts_yoy]))*100' />
            </column>
            <column caption='NPS YOY Diff Food' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[NPS MOM Diff Food (copy)_6175631400275320877]' role='measure' type='quantitative'>
