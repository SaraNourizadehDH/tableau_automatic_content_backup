          <format attr='text-align' id='dash-text_24' value='center' />
          <format attr='text-align' id='dash-text_25' value='center' />
          <format attr='vertical-align' id='dash-text_25' value='center' />
          <format attr='text-align' id='dash-text_26' value='center' />
          <format attr='vertical-align' id='dash-text_26' value='center' />
          <format attr='text-orientation' id='dash-text_1372' value='0' />
        </style-rule>
      </style>
