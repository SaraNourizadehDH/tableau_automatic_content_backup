            <column caption='Restaurants Zombies LS  YoY' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Restaurants Zombies LS  MoM (copy)_1456351589004054609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1456351589003157583]*100) &#10;- &#10;(SUM([restaurants_online_zombies_ls_yoy]) / SUM([restaurants_online_ls_yoy]) * 100)' />
