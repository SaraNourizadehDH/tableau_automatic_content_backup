            <column caption='QC Acq Share YoY' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[QC Acq Share MoM (copy)_4168011130378207239]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( (SUM([acquisition_qc])/SUM([acquisitions])) *100  )  -&#10;( (SUM([acquisition_qc_yoy])/SUM([acquisitions_yoy])) *100  )' />
