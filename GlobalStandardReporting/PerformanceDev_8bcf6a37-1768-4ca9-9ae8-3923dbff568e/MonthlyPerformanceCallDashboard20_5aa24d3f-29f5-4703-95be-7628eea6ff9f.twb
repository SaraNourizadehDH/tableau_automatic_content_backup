    <worksheet name='Big Best - Preffered App'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_performance_call' name='federated.1o39sqk195y5x71bd9y4d1gvvfkn' />
          </datasources>
          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='MoM Sessions New' datatype='real' default-format='p0.0%' name='[Calculation_1456351588989349944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_new])/SUM([sessions_new_mom]) - 1' />
            </column>
            <column caption='&quot;Preffered App&quot;' datatype='string' name='[Calculation_6175631400228798467]' role='dimension' type='nominal' user:unnamed='Preffered App'>
              <calculation class='tableau' formula='&quot;Preffered App&quot;' />
              <aliases>
                <alias key='&quot;Preffered App&quot;' value='Preferred App' />
              </aliases>
            </column>
            <column caption='App Rating Gap MoM' datatype='real' default-format='n#,##0.0&quot; &quot;;-#,##0.0&quot; &quot;' name='[Calculation_6175631400280150075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(zn([app_rating_gap 1]))-AVG(zn([app_rating_gap_mom 1]))' />
            </column>
            <column caption='MoM' datatype='string' name='[Calculation_6734148143346507829]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;MoM&quot;' />
            </column>
            <column caption='MoM Sessions' datatype='real' default-format='p0.0%' name='[Calculation_6734148143402066053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_76631562431836175] / SUM([sessions_mom]) - 1' />
            </column>
            <column caption='CVR Total' datatype='real' default-format='p0.00%' name='[Calculation_6734148143630839943]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_76631562432221200] / [Calculation_76631562431836175]' />
            </column>
            <column caption='mWeb CR' datatype='real' default-format='p0.00%' name='[Calculation_6734148143632101514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_76631562433687572] / [Calculation_76631562433929237]' />
            </column>
            <column caption='MoM mWeb CR' datatype='real' default-format='p0.0%' name='[Calculation_6734148143632396427]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143632101514] / ((sum([transactions_mweb_new_mom])+sum([transactions_mweb_returning_mom])) / (sum([sessions_mweb_new_mom])+sum([sessions_mweb_returning_mom]))) - 1' />
            </column>
            <column caption='Android CR' datatype='real' default-format='p0.00%' name='[Calculation_6734148143633481872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_76631562432958481] / [Calculation_76631562434183191]' />
            </column>
            <column caption='MoM Android CR' datatype='real' default-format='p0.0%' name='[Calculation_6734148143633690769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143633481872] / ((sum([transactions_android_new_mom])+sum([transactions_android_returning_mom])) / (sum([sessions_android_new_mom])+sum([sessions_android_returning_mom]))) - 1' />
            </column>
            <column caption='Web CR' datatype='real' default-format='p0.00%' name='[Calculation_6734148143634051219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_76631562433470483] / [Calculation_76631562434359320]' />
            </column>
            <column caption='MoM Web CR' datatype='real' default-format='p0.0%' name='[Calculation_6734148143634415764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143634051219] / ((sum([transactions_web_new_mom])+sum([transactions_web_returning_mom])) / (sum([sessions_web_new_mom])+sum([sessions_web_returning_mom]))) - 1' />
            </column>
            <column caption='MoM Transactions' datatype='real' default-format='p0.0%' name='[Calculation_6734148143663681725]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_76631562432221200] / (sum([transactions_new_mom])+ sum([transactions_returning_mom])) - 1' />
            </column>
            <column caption='Sessions Perseus' datatype='real' default-format='n#,##0,K;-#,##0,K' name='[Calculation_76631562431836175]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions])' />
            </column>
            <column caption='Transactions total' datatype='real' default-format='n#,##0,K;-#,##0,K' name='[Calculation_76631562432221200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_w_order])' />
            </column>
            <column caption='Transactions Android total' datatype='integer' name='[Calculation_76631562432958481]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([transactions_android_new]) + sum([transactions_android_returning])' />
            </column>
            <column caption='Transactions Web total' datatype='integer' name='[Calculation_76631562433470483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([transactions_web_new]) + sum([transactions_web_returning])' />
            </column>
            <column caption='Transactions mWeb total' datatype='integer' name='[Calculation_76631562433687572]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([transactions_mweb_new]) + sum([transactions_mweb_returning])' />
            </column>
            <column caption='Sessions mWeb total' datatype='integer' name='[Calculation_76631562433929237]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(sessions_mweb_new) + sum([sessions_mweb_returning])' />
            </column>
            <column caption='Sessions Android total' datatype='integer' name='[Calculation_76631562434183191]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sessions_android_new]) + sum([sessions_android_returning])' />
            </column>
            <column caption='App Downloads Gap MoM' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Google Search MoM  (copy)_6175631400271769633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([app_downloads_gap 1])-AVG([app_downloads_gap_mom 1])' />
            </column>
            <column caption='MoM CVR Total ' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[MoM CVR Total (copy)_6175631400281047101]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143630839943]*100 -  &#10;((sum([sessions_w_order_mom])) &#10;/ (sum(sessions_mom))*100)' />
