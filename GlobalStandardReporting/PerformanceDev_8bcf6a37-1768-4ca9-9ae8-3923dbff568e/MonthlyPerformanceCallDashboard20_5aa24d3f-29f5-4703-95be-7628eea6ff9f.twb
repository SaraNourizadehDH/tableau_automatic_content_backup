    <worksheet name='KPIs 1'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Performance Call October</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_performance_call' name='federated.1o39sqk195y5x71bd9y4d1gvvfkn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Report Month' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Show Last 6 Months&quot;'>
              <calculation class='tableau' formula='&quot;Show Last 6 Months&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='Today' datatype='date' name='[Calculation_1256222833217327105]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED 1: MAX([report_month])}' />
            </column>
            <column caption='Today - 6 months' datatype='datetime' name='[Calculation_1256222833217957890]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='dateadd(&apos;month&apos;,-6,[Calculation_1256222833217327105])' />
            </column>
            <column caption='Frequency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1602014871802343424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM([active_customers])' />
            </column>
            <column caption='YoY MP Orders' datatype='real' name='[Calculation_2563462981804417024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_mp])&#10;/ &#10;SUM([successful_orders_mp_yoy]) -1' />
            </column>
            <column caption='YoY OD Orders ' datatype='real' name='[Calculation_2563462981806374921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_orders_od]) / sum([successful_orders_od_yoy]) -1' />
            </column>
            <column caption='MP Share' datatype='real' name='[Calculation_2563462981808001036]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_947866991700873216] / sum([orders])' />
            </column>
            <column caption='&quot;Growth&quot;' datatype='string' name='[Calculation_2889129578901049374]' role='dimension' type='nominal' user:unnamed='KPIs 1'>
              <calculation class='tableau' formula='&quot;Growth&quot;' />
              <aliases>
                <alias key='&quot;Growth&quot;' value='Growing' />
              </aliases>
            </column>
            <column caption='Retention 1 Month' datatype='real' default-format='p0.0%' name='[Calculation_3704844076316794883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([c1_users]) / sum([c1_acquisitions])' />
            </column>
            <column caption='Retention 3 Month' datatype='real' default-format='p0.0%' name='[Calculation_3704844076317609988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([c3_users]) / sum([c3_acquisitions])' />
            </column>
            <column caption='Retention 6 Month' datatype='real' default-format='p0.0%' name='[Calculation_3704844076317929477]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([c6_users]) / sum([c6_acquisitions])' />
            </column>
            <column caption='Retention 12 Month' datatype='real' default-format='p0.0%' name='[Calculation_3704844076318117894]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([c12_users]) / sum([c12_acquisitions])' />
            </column>
            <column caption='Show Last Month' datatype='boolean' name='[Calculation_4436890073515819018]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4]=&apos;Show Last 6 Months&apos; &#10;THEN ([report_month] &gt; [Calculation_1256222833217957890] AND [report_month] &lt;= [Calculation_1256222833217327105])&#10;&#10;&#10;ELSEIF  [Parameters].[Parameter 4] = &apos;Show All&apos; THEN [report_month]&lt;=[Calculation_1256222833217327105]&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Show Last 3 Months&apos; &#10;THEN ([report_month] &gt; [Today - 6 months (copy)_924223132951281664] AND [report_month] &lt;= [Calculation_1256222833217327105])&#10;&#10;&#10;END' />
            </column>
            <column caption='MP Customers Penetration' datatype='real' name='[Calculation_6713248568403345416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customers_returned_mp])/ sum([active_customers])' />
            </column>
            <column caption='OD Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143298539523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_orders_od]) / sum([orders])' />
            </column>
            <column caption='Kitchens Share' datatype='real' default-format='p0.00%' name='[Calculation_6734148143303421966]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([kitchen_orders]) / sum([orders])' />
            </column>
            <column caption='Activity Rate' datatype='real' default-format='p0.00%' name='[Calculation_6734148143340744744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([active_customers]) / sum([customer_base])' />
            </column>
            <column caption='CPA (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143347580985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([marketing_costs_eur]) / sum([marketing_acquisitions])' />
            </column>
            <column caption='CPA SEO (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143348572220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cost_eur_seo]) / sum([marketing_acquisitions_seo])' />
            </column>
            <column caption='CPA SEM (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143349682239]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cost_eur_sem]) / sum([marketing_acquisitions_sem])' />
            </column>
            <column caption='CPA Brand (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143350669378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cost_eur_brand]) / sum([marketing_acquisitions_brand] )' />
            </column>
            <column caption='CPA Dis (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143351406661]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cost_eur_dis]) / sum([marketing_acquisitions_dis])' />
            </column>
            <column caption='CPA Other Organic (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143352254536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cost_eur_other_organic]) / sum([marketing_acquisitions_other_organic])' />
            </column>
            <column caption='CPA Other Unorganic (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143353266251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cost_eur_other_unorganic]) / sum([marketing_acquisitions_other_unorganic])' />
            </column>
            <column caption='YoY Orders' datatype='real' default-format='p0.0%' name='[Calculation_6734148143646089383]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders] ) / sum([orders_yoy]) - 1' />
            </column>
            <column caption='YoY Acquisitions' datatype='real' default-format='p0.0%' name='[Calculation_6734148143650046122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([acquisitions]) / sum([acquisitions_yoy]) - 1' />
            </column>
            <column caption='Active Customers Net Change' datatype='real' default-format='n#,##0,K;-#,##0,K' name='[Calculation_6734148143692689607]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([acquisitions]) +  sum([reactivated_customers]) - sum([new_inactive_customers])' />
            </column>
            <column caption='Retention 1M Prev. Year' datatype='real' name='[Calculation_6850889832204816384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([yoy_c1_users]) / sum([yoy_c1_acquisitions])' />
            </column>
            <column caption='Retention 3M Prev. Year' datatype='real' name='[Calculation_6850889832205647873]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([yoy_c3_users]) / sum([yoy_c3_acquisitions])' />
            </column>
            <column caption='Retention 6M Prev. Year' datatype='real' name='[Calculation_6850889832205856770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([yoy_c6_users]) / sum([yoy_c6_acquisitions])' />
            </column>
            <column caption='Retention 12M Prev. Year' datatype='real' name='[Calculation_6850889832205987843]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([yoy_c12_users]) / sum([yoy_c12_acquisitions])' />
            </column>
            <column caption='Acq. Remaining' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_76631628630822912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([acquisitions]) &#10;-sum([marketing_acquisitions_dis]) &#10;-sum([marketing_acquisitions_brand])&#10;-sum([marketing_acquisitions_other_organic]) &#10;-sum([marketing_acquisitions_other_unorganic])&#10;-sum([marketing_acquisitions_sem])&#10;-sum([marketing_acquisitions_seo])' />
            </column>
