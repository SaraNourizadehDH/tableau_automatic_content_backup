    <worksheet name='Big Best - Choice MoM'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_performance_call' name='federated.1o39sqk195y5x71bd9y4d1gvvfkn' />
          </datasources>
          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='Restaurants New Online Food MoM' datatype='real' default-format='p0.0%' name='[Calculation_1456351588662693895]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_new_online_food])/SUM([restaurants_new_online_food_mom]) - 1' />
            </column>
            <column caption='Res Orders 0 30 Food MoM' datatype='real' default-format='p0.0%' name='[Calculation_1456351588703916054]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([res_orders_0_30_food])/SUM([res_orders_0_30_food_mom]) - 1' />
            </column>
            <column caption='New Res Orders 0 30 Food MoM' datatype='real' name='[Calculation_1456351588705091612]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([new_res_orders_0_30_food])/SUM([new_res_orders_0_30_food_mom])-1' />
            </column>
            <column caption='MoM Recovered Churn Food' datatype='real' default-format='p0.0%' name='[Calculation_1456351588715180069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_recovered_churn_food])/SUM([restaurants_recovered_churn_food_mom]) - 1' />
            </column>
            <column caption='Res above 30 orders MoM' datatype='real' default-format='p0.0%' name='[Calculation_1456351588976701489]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_online_over_30_orders_food]) / SUM(restaurants_online_over_30_orders_food_mom) - 1' />
            </column>
            <column caption='Placeholder' datatype='integer' default-format='*#,#' name='[Calculation_5552023600766189569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='GFS top brands MoM' datatype='real' default-format='p0.0%' name='[Calculation_5552023601071812643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfs_top_15_brands])/SUM([gfs_top_15_brands_mom]) - 1' />
            </column>
            <column caption='Rating GFS Above 4 Share' datatype='real' default-format='p0.0%' name='[Calculation_5552023601086197829]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rating_gfs_above_4_vendor_share])/SUM([restaurants_online_gfs])' />
            </column>
            <column caption='&quot;Choice&quot;' datatype='string' name='[Calculation_6175631400228700161]' role='dimension' type='nominal' user:unnamed='Choice'>
              <calculation class='tableau' formula='&quot;Choice&quot;' />
            </column>
            <column caption='MoM' datatype='string' name='[Calculation_6734148143346507829]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;MoM&quot;' />
            </column>
            <column caption='MoM Res Online' datatype='real' default-format='p0.0%' name='[Calculation_6734148143359610963]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([restaurants_online]) / sum([restaurants_online_mom]) - 1' />
            </column>
            <column caption='Restaurants Online MP' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_717409348940955649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_online_mp])' />
            </column>
            <column caption='MoM Res Online MP' datatype='real' default-format='p0.0%' name='[Calculation_727190604386279427]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_717409348940955649] / (SUM([restaurants_online_mp_mom])) - 1' />
            </column>
            <column caption='MoM Res Online OD' datatype='real' default-format='p0.0%' name='[Calculation_727190604386795524]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([restaurants_online_od]) / sum([restaurants_online_od_mom]) - 1' />
            </column>
            <column caption='MoM New Res Orders 0 Food' datatype='real' default-format='p0.0%' name='[MoM New Res Orders 0 (copy)_1456351588971290668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([new_res_orders_0_food]) / sum([new_res_orders_0_food_mom] ) - 1' />
            </column>
            <column caption='MoM Order Share Top 10 Food Share' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[MoM Order Share Top 10 (copy)_1456351588664889360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Order Share Top 10 (copy)_1456351588664115215] / (sum([top10_successful_orders_food_mom])/sum([successful_orders_food_mom])) - 1' />
            </column>
            <column caption='MoM Orders Per Online Restaurant Food' datatype='real' default-format='p0.0%' name='[MoM Orders Per Restaurant (copy)_1456351588665942035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Orders Per Restaurant (copy)_1456351588665651218] / (sum([successful_orders_food_mom]) / sum([restaurants_online_food_mom])) - 1' />
            </column>
            <column caption='MoM Res Online Food' datatype='real' default-format='p0.0%' name='[MoM Res Online (copy)_1456351588712734752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([restaurants_online_food]) / sum([restaurants_online_food_mom]) - 1' />
            </column>
            <column caption='MoM Res Active' datatype='real' default-format='p0.0%' name='[MoM Res Online (copy)_5739204457315827728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([restaurants_active]) / sum([restaurants_active_mom]) - 1' />
            </column>
            <column caption='MoM Res Active Food ' datatype='real' default-format='p0.0%' name='[MoM Res Online Food (copy)_5739204457317224465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([restaurants_active_food]) / sum([restaurants_active_food_mom]) - 1' />
            </column>
            <column caption='MoM Res Online MP Food' datatype='real' default-format='p0.0%' name='[MoM Res Online MP (copy)_1456351588712734753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_online_food_mp]) / SUM([restaurants_online_food_mp_mom]) - 1' />
            </column>
            <column caption='MoM Res Online OD Food' datatype='real' default-format='p0.0%' name='[MoM Res Online OD (copy)_1456351588712734754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_online_food_od]) / SUM([restaurants_online_food_od_mom]) - 1' />
            </column>
            <column caption='New Restos / Restos Online mom' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[New Restos / Restos Online (copy)_4168011130731221006]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([restaurants_new_online_food])/SUM([restaurants_online_food])*100) - (SUM([restaurants_new_online_food_mom])/SUM([restaurants_online_food_mom])*100)' />
            </column>
            <column caption='Order Share Top 10 Food Share' datatype='real' default-format='p0.0%' name='[Order Share Top 10 (copy)_1456351588664115215]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([top_10_successful_orders_food]) / sum([successful_orders_food])' />
            </column>
            <column caption='Orders Per Restaurant Food' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Orders Per Restaurant (copy)_1456351588665651218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_orders_food]) / sum([restaurants_online_food])' />
            </column>
            <column caption='Pickup Orders Share MoM' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Pickup Orders Share (copy)_2889129578628423688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([successful_orders_pickup]) / SUM([orders]) * 100)&#10;-&#10;(SUM([successful_orders_pickup_mom]) / SUM([orders_mom]) * 100)' />
            </column>
            <column caption='Rating GFS MoM' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Rating GFS (copy)_5552023601086541894]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_5552023601086197829]*100) - (SUM([rating_gfs_above_4_vendor_share_mom])/SUM([restaurants_online_gfs_mom])*100 )' />
            </column>
            <column caption='Res Orders 0 Food MoM' datatype='real' default-format='p0.0%' name='[Res Orders 0 Food YoY (copy)_1456351588970745899]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([res_orders_0_food])/SUM([res_orders_0_food_mom]) - 1' />
            </column>
            <column caption='Restaurants Net Development Food' datatype='integer' name='[Restaurants Net Development (copy)_1456351588662341638]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([restaurants_new_online_food]) + sum([restaurants_recovered_churn_food]) - sum([restaurants_churned_food])' />
            </column>
            <column caption='MoM Restaurants Net Development Food ' datatype='real' name='[Restaurants Net Development Food (copy)_1456351588715683879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Restaurants Net Development (copy)_1456351588662341638] / (sum([restaurants_new_online_food_mom]) + sum([restaurants_recovered_churn_food_mom]) - sum([restaurants_recovered_churn_food_mom])) - 1' />
            </column>
            <column caption='Restaurants New Online Food OD MoM ' datatype='real' default-format='p0.0%' name='[Restaurants New Online Food MoM (copy)_1456351588663078921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_new_online_food_od])/SUM([restaurants_new_online_food_od_mom]) - 1' />
            </column>
            <column caption='Restaurants New Online Food MP MoM ' datatype='real' default-format='p0.0%' name='[Restaurants New Online Food OD MoM  (copy)_1456351588663431179]' role='measure' type='quantitative'>
