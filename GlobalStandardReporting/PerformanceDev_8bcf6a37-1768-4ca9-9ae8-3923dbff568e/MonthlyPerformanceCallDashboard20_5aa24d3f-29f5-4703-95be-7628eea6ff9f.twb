          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Benchmark 2 KPI Selector' datatype='string' name='[Cltv 10Year Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Acq as \% of active customers&quot;'>
              <calculation class='tableau' formula='&quot;Acq as % of active customers&quot;' />
              <aliases>
                <alias key='&quot;Frequency YoY growth&quot;' value='Frequency' />
                <alias key='&quot;VFI as \% of total incentivesR&quot;' value='VFI as % of total incentives' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1nobfm00uv50sc13lsr2b1gd6xv6'>
            <column caption='Acq. as % Active Customers' datatype='real' name='[Calculation_4503388531359424515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((SUM([acquisitions])/SUM([active_customers])) - (SUM([acquisitions_prev])/SUM([active_customers_prev]))) *100' />
            </column>
            <column caption='Benchmarking 2 Filter' datatype='string' name='[Calculation_4503388531367600143]' role='dimension' type='nominal'>
