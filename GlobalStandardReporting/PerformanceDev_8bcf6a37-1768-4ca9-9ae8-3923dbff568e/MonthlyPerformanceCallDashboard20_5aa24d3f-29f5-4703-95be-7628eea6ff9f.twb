            </zone-style>
          </zone>
          <zone forceUpdate='true' h='2287' id='108' type-v2='text' w='50858' x='571' y='4499'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#ca011d' fontsize='11'>Overview</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f5f5f5' />
            </zone-style>
          </zone>
          <zone h='78500' id='109' type-v2='empty' w='3715' x='47714' y='6786'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#d4d4d4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='2287' id='110' type-v2='text' w='48000' x='51429' y='4499'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#ca011d' fontsize='11'>Q - Commerce</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f5f5f5' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='68214' id='111' type-v2='text' w='48000' x='51429' y='6786'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='10'>Orders QC:  </run>
              <run fontcolor='#000000' fontsize='10'>   Total QC orders = Dmarts + LS + Deliver Anything (couriers)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Orders Dmarts:  </run>
              <run fontcolor='#000000' fontsize='10'>   Total Dmart orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Orders Local Stores:   </run>
              <run fontcolor='#000000' fontsize='10'>    Total LS orders = OD + VD</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Order Share QC: </run>
              <run fontcolor='#000000' fontsize='10'>       Order share QC</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Order Share Dmarts:   </run>
              <run fontcolor='#000000' fontsize='10'>     Order Share: Dmarts of total orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Order Share Local Stores:</run>
              <run fontcolor='#000000' fontsize='10'>      Order Share: Local Stores of total orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Order Share Courier:   </run>
              <run fontcolor='#000000' fontsize='10'>    Order share Deliver anything of total orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>GMV  QC:</run>
              <run fontcolor='#000000' fontsize='10'>        GMV Quick commerce</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>GMV  Dmarts:  </run>
              <run fontcolor='#000000' fontsize='10'>      GMV: Dmarts</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>GMV  Local Stores: </run>
              <run fontcolor='#000000' fontsize='10'>     GMV: Local Stores</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>GMV  Courier:  </run>
              <run fontcolor='#000000' fontsize='10'>     GMV: Courier</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Acquisition Share  QC:  </run>
              <run fontcolor='#000000' fontsize='10'>    Acquisitions from QC / total acquisitions</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Acquisitions  Dmarts: </run>
              <run fontcolor='#000000' fontsize='10'>      Acquisitions from Dmarts</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Acquisitions  Local Stores:</run>
              <run fontcolor='#000000' fontsize='10'>     Acquisitions from LS</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Acquisitions  Courier: </run>
              <run fontcolor='#000000' fontsize='10'>     Acquisitions from Deliver anything</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Active Customers  Dmarts</run>
              <run fontcolor='#000000' fontsize='10'>:       Monthly active customers for Dmarts</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Active Customers  Local Stores:</run>
              <run fontcolor='#000000' fontsize='10'>     Monthly active customers for LS</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>QC Trials: </run>
              <run fontcolor='#000000' fontsize='10'>      Count of orders if this is the first order of a customer from a qcommerce vendor according to our Analytical Customer ID definition</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>QC Adoption </run>
              <run fontcolor='#000000' fontsize='10'>        Share of QC active customers</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Online Vendors Dmarts   </run>
              <run fontcolor='#000000' fontsize='10'>    Number of online Dmart vendors</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Active Vendors Dmarts </run>
              <run fontcolor='#000000' fontsize='10'>      Number of active Dmart vendors where atleast 1 order was placed</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>New Online Vendors Dmarts: </run>
              <run fontcolor='#000000' fontsize='10'>     New Dmarts added in current month and were online</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Online Vendors Local Stores:  </run>
              <run fontcolor='#000000' fontsize='10'>      Number of LS online</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Active Vendors Local Stores: </run>
              <run fontcolor='#000000' fontsize='10'>       Number of LS active where atleast 1 order was placed</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>New Online Vendors Local Stores: </run>
              <run fontcolor='#000000' fontsize='10'>       New LS added in current month and were online</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Zombies Local Stores: </run>
              <run fontcolor='#000000' fontsize='10'>      Number of online Local stores where 0 order was placed</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Recovered Churn Local Stores:    </run>
              <run fontcolor='#000000' fontsize='10'>   Number of local stores which were recovered in the current month but were churned in previous month</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>OD Dmarts Customers Penetration:  </run>
              <run fontcolor='#000000' fontsize='10'>      Share of dmarts customers that returned in the specific month</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>OD Vertical Customers Penetration: </run>
              <run fontcolor='#000000' fontsize='10'>     Share of QC (OD) customers that returned in the specific month exluding dmarts</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>ABV Dmarts</run>
              <run fontcolor='#000000' fontsize='10'>:     Average basket value for Dmarts</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>ABV LS: </run>
              <run fontcolor='#000000' fontsize='10'>    Average basket value for LS</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Dmarts Avg Delivery Fee (EUR) Inc SF - OD</run>
              <run fontcolor='#000000' fontsize='10'>:      Dmarts Avg DF</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Avg. DT Dmarts:</run>
              <run fontcolor='#000000' fontsize='10'>     Average DT for DMarts</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Avg. DT LS: </run>
              <run fontcolor='#000000' fontsize='10'>    Average DT for LS</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>NPS AO Dmarts:</run>
              <run fontcolor='#000000' fontsize='10'>      NPS after order dmarts</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>NPS AO Local Stores:</run>
              <run fontcolor='#000000' fontsize='10'>        NPS after order local stores</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Hard Fail Rate OD Dmarts:  </run>
              <run fontcolor='#000000' fontsize='10'>     Share of failed dmart orders over total dmart orders </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Hard Fail Rate Local Stores</run>
              <run fontcolor='#000000' fontsize='10'>:        Share of failed local store orders over total local store orders </run>
              <run>Æ&#10;&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>LS Assortment Quality Score: (</run>
              <run fontcolor='#000000' fontsize='10'>shop_details_loaded</run>
              <run fontcolor='#202124' fontsize='10'>Æ </run>
              <run fontcolor='#3c4043' fontsize='10'>*</run>
              <run fontcolor='#202124' fontsize='10'>Æ </run>
              <run fontcolor='#000000' fontsize='10'>AQS) / (shop_details_loaded)</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
