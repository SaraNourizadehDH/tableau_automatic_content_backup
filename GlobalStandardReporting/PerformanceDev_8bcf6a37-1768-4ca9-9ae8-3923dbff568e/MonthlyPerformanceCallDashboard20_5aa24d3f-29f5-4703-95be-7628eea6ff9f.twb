    <worksheet name='Delivery Fee YoY Evolution'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_performance_call' name='federated.1o39sqk195y5x71bd9y4d1gvvfkn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Benchmark 1 KPI Selector' datatype='string' name='[Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Frequency&quot;'>
              <calculation class='tableau' formula='&quot;Frequency&quot;' />
              <aliases>
                <alias key='&quot;\% QC acquisition share (dmart + ls) . What \% of customers place their first order with QC&quot;' value='% QC acquisition share' />
                <alias key='&quot;\% QC adoption (\% of people who had reordered)&quot;' value='% QC adoption' />
                <alias key='&quot;\% YoY evolution - Payment CPO&quot;' value='% YoY evolution - Payment CPO' />
                <alias key='&quot;\% YoY evolution - Rider CPO&quot;' value='% YoY evolution - Rider CPO' />
                <alias key='&quot;\% YoY evolution Total CPO&quot;' value='% YoY evolution - Total CPO' />
                <alias key='&quot;AFFORDABILITY&quot;' value='=====         AFFORDABILITY                =====' />
                <alias key='&quot;CARING&quot;' value='=====           CARING                 =====' />
                <alias key='&quot;CHOICE&quot;' value='=====         CHOICE               =====' />
                <alias key='&quot;GROWING&quot;' value='=====         GROWING                =====' />
                <alias key='&quot;LEADING&quot;' value='=====         LEADING                =====' />
                <alias key='&quot;NPS trend - Dmarts&quot;' value='NPS trend - Dmarts' />
                <alias key='&quot;NPS trend - Local Stores&quot;' value='NPS trend - Local Stores' />
                <alias key='&quot;NPS trend - Restaurants&quot;' value='NPS trend - Restaurants' />
                <alias key='&quot;Preferece&quot;' value='% Preferece' />
                <alias key='&quot;PREFFERED APP&quot;' value='=====         PREFFERED APP                =====' />
                <alias key='&quot;PROFITABILITY&quot;' value='=====         PROFITABILITY                =====' />
                <alias key='&quot;Q-COMMERCE&quot;' value='=====         Q-COMMERCE                =====' />
                <alias key='&quot;SEAMLESS DELIVERY&quot;' value='=====         SEAMLESS DELIVERY                =====' />
                <alias key='&quot;Take rate&quot;' value='Take rate as % AOV' />
                <alias key='&quot;TOM&quot;' value='% TOM' />
                <alias key='&quot;YoY evolution&quot;' value='Delivery Fee YoY evolution' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='Benchmark 1 Filter KPI' datatype='string' name='[Calculation_4168011130365161472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter]' />
            </column>
            <column caption='Avg Delivery Fee (EUR) inc. SF - OD' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143335637023]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([amt_delivery_fee_eur_profit_od]) + SUM([service_fee_eur_profit_od])) / sum([orders_succ_profit_od])' />
            </column>
            <column caption='YoY Avg Delivery Fee' datatype='real' default-format='p0.0%' name='[Calculation_6734148143678001345]' role='measure' type='quantitative'>
