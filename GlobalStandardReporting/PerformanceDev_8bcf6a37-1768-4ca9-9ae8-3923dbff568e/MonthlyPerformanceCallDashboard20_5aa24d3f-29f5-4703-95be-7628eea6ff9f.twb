            <column caption='YoY mWeb CR' datatype='real' default-format='p0.0%' name='[Calculation_6734148143632605324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143632101514] / ((sum([transactions_mweb_new_yoy])+sum([transactions_mweb_returning_yoy])) / (sum([sessions_mweb_new_yoy])+sum([sessions_mweb_returning_yoy]))) - 1' />
