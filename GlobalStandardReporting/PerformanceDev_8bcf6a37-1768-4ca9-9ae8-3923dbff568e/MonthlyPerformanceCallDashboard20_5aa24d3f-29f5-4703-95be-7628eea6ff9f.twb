          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='ABV MoM Dmarts' datatype='real' default-format='p0.0%' name='[ABV (copy)_6175631400285098057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gbv_eur_dmarts])/SUM(successful_orders_dmarts))&#10;/ &#10;(SUM([gbv_eur_dmarts_mom])/SUM([successful_orders_dmarts_mom])) -1' />
            </column>
            <column caption='ABV MoM LS' datatype='real' default-format='p0.0%' name='[ABV MoM (copy)_5552023601113915466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gbv_eur_ls])/SUM([successful_orders_ls])) / (SUM([gbv_eur_ls_mom])/SUM([successful_orders_ls_mom])) -1' />
            </column>
            <column caption='Comm Rate LS' datatype='real' default-format='p0.0%' name='[Calculation_5552023601116442701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(commission_eur_profit_ls)/SUM([commissionable_value_eur_profit_ls])' />
            </column>
            <column caption='&quot;Q-Commerce&quot;' datatype='string' name='[Calculation_6175631400228909061]' role='dimension' type='nominal' user:unnamed='Q-Commerce'>
              <calculation class='tableau' formula='&quot;Q-Commerce&quot;' />
            </column>
            <column caption='MoM' datatype='string' name='[Calculation_6734148143346507829]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;MoM&quot;' />
            </column>
            <column caption='Comm Rate LS MoM' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Comm Rate LS (copy)_5552023601116794958]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5552023601116442701]*100 - (SUM(commission_eur_profit_ls_mom)/SUM([commissionable_value_eur_profit_ls_mom])*100)' />
            </column>
            <column caption='Comm Rate Dmart' datatype='real' default-format='p0.0%' name='[Comm Rate LS (copy)_5739204457031225347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([commission_eur_profit_dmart])/SUM([commissionable_value_eur_profit_dmart])' />
            </column>
            <column caption='Comm Rate Dmart MoM ' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Comm Rate LS MoM (copy)_5739204457351368730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Comm Rate LS (copy)_5739204457031225347]*100 - (SUM([commission_eur_profit_dmart_mom])/SUM([commissionable_value_eur_profit_dmart_mom])*100)' />
            </column>
            <column caption='MoM OD Dmarts Avg Delivery Fee (EUR)' datatype='real' default-format='p0.0%' name='[MoM OD DS Avg Delivery Fee (EUR) (copy)_5739204457350344728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[OD Restaurant Avg Delivery Fee (EUR) (copy)_2563462981842276438] / &#10;(((sum([amt_delivery_fee_eur_profit_mom_od_dmarts]) &#10;    + sum ([service_fee_eur_profit_od_dmarts_mom]))) &#10;&#10;    / sum([orders_succ_profit_mom_od_dmarts])) - 1' />
            </column>
            <column caption='OD Dmarts Avg Delivery Fee  (EUR) Inc SF' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[OD Restaurant Avg Delivery Fee (EUR) (copy)_2563462981842276438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((sum([amt_delivery_fee_eur_profit_od_dmarts])+sum([service_fee_eur_profit_od_dmarts]))) / sum([orders_succ_profit_od_dmarts])' />
