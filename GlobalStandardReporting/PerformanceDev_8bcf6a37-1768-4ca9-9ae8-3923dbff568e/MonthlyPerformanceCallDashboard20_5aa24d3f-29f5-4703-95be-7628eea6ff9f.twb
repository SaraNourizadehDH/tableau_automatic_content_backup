    <worksheet name='Big Bets - Q-Commerce YoY'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_performance_call' name='federated.1o39sqk195y5x71bd9y4d1gvvfkn' />
          </datasources>
          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='ABV YoY Dmarts' datatype='real' default-format='p0.0%' name='[ABV MoM (copy)_6175631400285311050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gbv_eur_dmarts])/SUM(successful_orders_dmarts)) / (SUM([gbv_eur_dmarts_yoy])/SUM(successful_orders_dmarts_yoy)) -1' />
            </column>
            <column caption='ABV YoY LS' datatype='real' default-format='p0.0%' name='[ABV YoY (copy)_5552023601113915467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gbv_eur_ls])/SUM([successful_orders_ls])) / (SUM([gbv_eur_ls_yoy])/SUM([successful_orders_ls_yoy])) -1' />
            </column>
            <column caption='Avg. DT LS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg. DT Dmarts (copy)_1456351589002207310]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_delivery_time_in_mins_ls])/ SUM([count_delivery_time_ls])' />
            </column>
            <column caption='Avg. DT Dmarts YoY' datatype='real' default-format='p0.0%' name='[Avg. DT Dmarts MoM (copy)_1456351589002027083]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1456351589001543753] / (SUM([sum_delivery_time_in_mins_dmarts_yoy])/SUM([count_delivery_time_dmarts_yoy])) - 1' />
            </column>
            <column caption='Avg. DT ls YoY ' datatype='real' default-format='p0.0%' name='[Avg. DT Dmarts YoY (copy)_1456351589002207309]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg. DT Dmarts (copy)_1456351589002207310] / (SUM([sum_delivery_time_in_mins_ls_yoy])/SUM([count_delivery_time_ls_yoy])) - 1' />
            </column>
            <column caption='Avg. DT Dmarts' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1456351589001543753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_delivery_time_in_mins_dmarts])/ SUM([count_delivery_time_dmarts])' />
            </column>
            <column caption='Restaurants Zombies LS ' datatype='real' default-format='p0.0%' name='[Calculation_1456351589003157583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_online_zombies_ls])/ SUM([restaurants_online_ls])' />
            </column>
            <column caption='dmarts orders share' datatype='real' default-format='p0.0%' name='[Calculation_1602014871821447181]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(successful_orders_dmarts)/SUM([orders])' />
            </column>
            <column caption='LS order share' datatype='real' default-format='p0.0%' name='[Calculation_1602014871822528527]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_ls])/SUM([orders])' />
            </column>
            <column caption='YoY OD NV Share' datatype='real' name='[Calculation_2563462981811609627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2563462981808230414]  / [Calculation_2563462981810188312] -1' />
            </column>
            <column caption='Comm Rate LS' datatype='real' default-format='p0.0%' name='[Calculation_5552023601116442701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(commission_eur_profit_ls)/SUM([commissionable_value_eur_profit_ls])' />
            </column>
            <column caption='&quot;Q-Commerce&quot;' datatype='string' name='[Calculation_6175631400228909061]' role='dimension' type='nominal' user:unnamed='Q-Commerce'>
              <calculation class='tableau' formula='&quot;Q-Commerce&quot;' />
            </column>
            <column caption='YoY' datatype='string' name='[Calculation_6734148144005718231]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;YoY&quot;' />
            </column>
            <column caption='Comm Rate LS YoY' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Comm Rate LS MoM (copy)_5552023601117007951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5552023601116442701]*100 - (SUM(commission_eur_profit_ls_yoy)/SUM([commissionable_value_eur_profit_ls_yoy])*100)' />
            </column>
            <column caption='LS order share YoY' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[LS order share MoM (copy)_6175631400285876300]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1602014871822528527]*100) - (SUM([successful_orders_ls_yoy])/SUM([orders_yoy])*100)' />
            </column>
            <column caption='OD Dmarts Customers Penetration' datatype='real' name='[MP Customers Penetration (copy)_6713248568405684234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customers_returned_od_darkstore])/ sum([active_customers])' />
            </column>
            <column caption='OD Vertical Customers Penetration' datatype='real' name='[MP Customers Penetration (copy)_6713248568405798923]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customers_returned_od_vertical])/ sum([active_customers])' />
            </column>
            <column caption='YoY OD DS Customers Penetration' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[MoM OD DS Customers Penetration (copy)_6713248568407158801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([MP Customers Penetration (copy)_6713248568405684234]*100) -&#10;&#10;(sum([customers_returned_od_darkstore_yoy])/ sum([active_customers_yoy])) * 100' />
            </column>
            <column caption='YoY OD NV Customers Penetration' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[MoM OD NV Customers Penetration (copy)_6713248568407191570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([MP Customers Penetration (copy)_6713248568405798923]*100) - &#10;(sum([customers_returned_od_vertical_yoy])/ sum([active_customers_yoy])) * 100' />
            </column>
            <column caption='Order Per dmart per day YoY' datatype='real' default-format='p0.0%' name='[Order Per dmart per day MoM (copy)_6175631400284934216]' role='measure' type='quantitative'>
