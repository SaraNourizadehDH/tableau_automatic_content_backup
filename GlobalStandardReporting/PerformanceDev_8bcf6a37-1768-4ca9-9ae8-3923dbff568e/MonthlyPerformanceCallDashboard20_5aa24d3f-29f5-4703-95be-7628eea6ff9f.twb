    <worksheet name='Ambition - Growth YoY'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_performance_call' name='federated.1o39sqk195y5x71bd9y4d1gvvfkn' />
          </datasources>
          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='Frequency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1602014871802343424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM([active_customers])' />
            </column>
            <column caption='&quot;Growing&quot;' datatype='string' name='[Calculation_1602014871803613187]' role='dimension' type='nominal' user:unnamed='Growing'>
              <calculation class='tableau' formula='&quot;Growing&quot;' />
            </column>
            <column caption='YoY MP Orders' datatype='real' name='[Calculation_2563462981804417024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_mp])&#10;/ &#10;SUM([successful_orders_mp_yoy]) -1' />
            </column>
            <column caption='YoY OD Orders ' datatype='real' name='[Calculation_2563462981806374921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_orders_od]) / sum([successful_orders_od_yoy]) -1' />
            </column>
            <column caption='MP Share' datatype='real' name='[Calculation_2563462981808001036]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_947866991700873216] / sum([orders])' />
            </column>
            <column caption='Mp Share YoY' datatype='real' name='[Calculation_2563462981809721365]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_mp_yoy])&#10;/ sum([orders_yoy])' />
            </column>
            <column caption='YoY MP Share' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Calculation_2563462981813403679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2563462981808001036]*100)-([Calculation_2563462981809721365]*100)' />
            </column>
            <column caption='Placeholder' datatype='integer' default-format='*#,#' name='[Calculation_5552023600766189569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='placeholder reorder rate' datatype='integer' default-format='*#,#' name='[Calculation_5552023601045925898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='MP Customers Penetration' datatype='real' name='[Calculation_6713248568403345416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customers_returned_mp])/ sum([active_customers])' />
            </column>
            <column caption='OD Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143298539523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_orders_od]) / sum([orders])' />
            </column>
            <column caption='OD Share YoY' datatype='real' name='[Calculation_6734148143299194885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_orders_od_yoy]) / sum([orders_yoy])' />
            </column>
            <column caption='YoY OD Share' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Calculation_6734148143299448839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6734148143298539523]*100) - ([Calculation_6734148143299194885]*100)' />
            </column>
            <column caption='Kitchens Share' datatype='real' default-format='p0.00%' name='[Calculation_6734148143303421966]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([kitchen_orders]) / sum([orders])' />
            </column>
            <column caption='YoY Kitchen Share' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Calculation_6734148143304056848]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6734148143303421966]*100) - (sum([kitchen_orders_yoy])/sum([orders_yoy])*100)' />
            </column>
            <column caption='YoY GMV' datatype='real' default-format='p0.00%' name='[Calculation_6734148143304790034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_eur]) / sum([gmv_eur_yoy]) - 1' />
            </column>
            <column caption='Activity Rate' datatype='real' default-format='p0.00%' name='[Calculation_6734148143340744744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([active_customers]) / sum([customer_base])' />
            </column>
            <column caption='CPA (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143347580985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([marketing_costs_eur]) / sum([marketing_acquisitions])' />
            </column>
            <column caption='YoY CPA' datatype='real' default-format='p0.0%' name='[Calculation_6734148143348346939]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143347580985] / (sum([marketing_costs_eur_yoy])/sum([marketing_acquisitions_yoy])) -1' />
            </column>
            <column caption='CPA SEO (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143348572220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cost_eur_seo]) / sum([marketing_acquisitions_seo])' />
            </column>
            <column caption='YoY CPA SEO' datatype='real' default-format='p0.0%' name='[Calculation_6734148143349346366]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143348572220] / (sum([cost_eur_seo_yoy])/sum([marketing_acquisitions__seo_yoy])) - 1' />
            </column>
            <column caption='CPA SEM (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143349682239]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cost_eur_sem]) / sum([marketing_acquisitions_sem])' />
            </column>
            <column caption='YoY CPA SEM' datatype='real' default-format='p0.0%' name='[Calculation_6734148143350313025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143349682239] / (sum([cost_eur_sem_yoy]) / sum([marketing_acquisitions__sem_yoy])) - 1' />
            </column>
            <column caption='CPA Brand (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143350669378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cost_eur_brand]) / sum([marketing_acquisitions_brand] )' />
            </column>
            <column caption='YoY CPA Brand' datatype='real' default-format='p0.0%' name='[Calculation_6734148143351164996]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143350669378] / (sum([cost_eur_brand_yoy]) / sum([marketing_acquisitions__brand_yoy])) -1' />
            </column>
            <column caption='CPA Dis (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143351406661]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cost_eur_dis]) / sum([marketing_acquisitions_dis])' />
            </column>
            <column caption='YoY CPA Dis' datatype='real' default-format='p0.0%' name='[Calculation_6734148143352000583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143351406661] / (sum([cost_eur_dis_yoy]) / sum([marketing_acquisitions__dis_yoy])) - 1' />
            </column>
            <column caption='CPA Other Organic (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143352254536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cost_eur_other_organic]) / sum([marketing_acquisitions_other_organic])' />
            </column>
            <column caption='YoY CPA Other Organic' datatype='real' default-format='p0.0%' name='[Calculation_6734148143352782922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143352254536] / (sum([cost_eur_other_organic_yoy]) / sum( [marketing_acquisitions_other_organic_yoy])) - 1' />
            </column>
            <column caption='CPA Other Unorganic (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143353266251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([cost_eur_other_unorganic]) / sum([marketing_acquisitions_other_unorganic])' />
            </column>
            <column caption='YoY CPA Other Unorganic' datatype='real' default-format='p0.0%' name='[Calculation_6734148143353806925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143353266251] / (sum([cost_eur_other_unorganic_yoy]) / sum([marketing_acquisitions_other_unorganic_yoy])) -1' />
            </column>
            <column caption='YoY Orders' datatype='real' default-format='p0.0%' name='[Calculation_6734148143646089383]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders] ) / sum([orders_yoy]) - 1' />
            </column>
            <column caption='YoY Acquisitions' datatype='real' default-format='p0.0%' name='[Calculation_6734148143650046122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([acquisitions]) / sum([acquisitions_yoy]) - 1' />
            </column>
            <column caption='YoY Active Customers' datatype='real' default-format='p0.0%' name='[Calculation_6734148143650435244]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([active_customers]) / sum([active_customers_yoy]) - 1' />
            </column>
            <column caption='YoY Reactivated Customers' datatype='real' default-format='p0.0%' name='[Calculation_6734148143650799790]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([reactivated_customers]) / sum([reactivated_customers_yoy]) - 1' />
            </column>
            <column caption='YoY Retained Customers' datatype='real' default-format='p0.0%' name='[Calculation_6734148143651172528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([retained_customers]) / sum([retained_customers_yoy]) - 1' />
            </column>
            <column caption='YoY Inactive Customers' datatype='real' default-format='p0.00%' name='[Calculation_6734148143651602610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([new_inactive_customers]) / sum([inactive_customers_yoy]) - 1' />
            </column>
            <column caption='YoY Activity Rate' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Calculation_6734148143669178559]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6734148143340744744]*100) - (sum([active_customers_yoy])/sum([customer_base_yoy])*100)' />
            </column>
            <column caption='Active Customers Net Change YoY' datatype='real' default-format='n#,##0,,.00M;-#,##0,,.00M' name='[Calculation_6734148143692570822]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143692689607] / (sum([acquisitions_yoy]) +  sum([reactivated_customers_yoy]) - sum([new_inactive_customers]))' />
            </column>
            <column caption='Active Customers Net Change' datatype='real' default-format='n#,##0,K;-#,##0,K' name='[Calculation_6734148143692689607]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([acquisitions]) +  sum([reactivated_customers]) - sum([new_inactive_customers])' />
            </column>
            <column caption='YoY' datatype='string' name='[Calculation_6734148144005718231]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;YoY&quot;' />
            </column>
            <column caption='Acq. Remaining' datatype='real' default-format='n#,##0,.0K;-#,##0,.0K' name='[Calculation_76631628630822912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([acquisitions]) &#10;-sum([marketing_acquisitions_dis]) &#10;-sum([marketing_acquisitions_brand])&#10;-sum([marketing_acquisitions_other_organic]) &#10;-sum([marketing_acquisitions_other_unorganic])&#10;-sum([marketing_acquisitions_sem])&#10;-sum([marketing_acquisitions_seo])' />
            </column>
            <column caption='Acq. Remaining yoy' datatype='real' name='[Calculation_76631628655570948]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([marketing_acquisitions_yoy]) &#10;-sum([marketing_acquisitions__dis_yoy]) &#10;-sum([marketing_acquisitions__brand_yoy])&#10;-sum([marketing_acquisitions_other_organic_yoy]) &#10;-sum([marketing_acquisitions_other_unorganic_yoy])&#10;-sum([marketing_acquisitions__sem_yoy])&#10;-sum([marketing_acquisitions__seo_yoy])' />
            </column>
            <column caption='YoY Acq. Remaining' datatype='real' default-format='p0.0%' name='[Calculation_76631628656435206]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_76631628630822912] / [Calculation_76631628655570948] - 1' />
            </column>
            <column caption='CLTV Multiplier' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_76631630382411785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( sum([total_cltv]) / sum([cltv_acquisitions]) ) / [Calculation_6734148143347580985]' />
            </column>
            <column caption='YoY CLTV Multiplier' datatype='real' default-format='p0.00%' name='[Calculation_76631630384500747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_76631630382411785] / (( sum([total_cltv_yoy]) / sum([cltv_acquisitions_yoy]) ) / (sum([marketing_costs_eur_yoy]) / sum([marketing_acquisitions_yoy])) ) - 1' />
            </column>
            <column caption='Orders MP ' datatype='real' name='[Calculation_947866991700873216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_mp])' />
            </column>
            <column caption='Frequency Last Year' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Frequency Last Month (copy)_6175631400272388130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_yoy])/SUM([active_customers_yoy])' />
            </column>
            <column caption='OD Restaurant Customers Penetration' datatype='real' name='[MP Customers Penetration (copy)_6713248568405417993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customers_returned_od_restaurant])/ sum([active_customers])' />
            </column>
            <column caption='Yoy Frequency  ' datatype='real' name='[MoM Frequency  (copy)_5552023601044234249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1602014871802343424]/[Frequency Last Month (copy)_6175631400272388130] - 1' />
            </column>
            <column caption='YoY MP Active Customers' datatype='real' default-format='p0.0%' name='[MoM MP Active Customers (copy)_6713248568398839815]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customers_total_mp]) / sum([customers_total_mp_yoy]) - 1' />
            </column>
            <column caption='YoY MP Customers Penetration' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[MoM MP Customers Penetration (copy)_6713248568407134224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6713248568403345416]*100)- (sum([customers_returned_mp_yoy])/ sum([active_customers_yoy])*100)' />
            </column>
            <column caption='YoY OD Restaurant Active Customers' datatype='real' default-format='p0.0%' name='[MoM OD Restaurant Active Customers (copy)_6713248568398712836]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customers_total_od_restaurant]) / sum([customers_total_od_restaurant_yoy]) - 1' />
            </column>
            <column caption='YoY OD Restaurant Customers Penetration' datatype='real' name='[MoM OD Restaurant Customers Penetration (copy)_6713248568407191571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([MP Customers Penetration (copy)_6713248568405417993]*100) - (sum([customers_returned_od_restaurant_yoy])/ sum([active_customers_yoy])*100)' />
            </column>
