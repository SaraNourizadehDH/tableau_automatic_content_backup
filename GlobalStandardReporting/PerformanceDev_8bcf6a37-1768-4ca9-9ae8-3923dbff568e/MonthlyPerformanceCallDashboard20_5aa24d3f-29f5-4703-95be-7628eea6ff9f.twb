      <table>
        <view>
          <datasources>
            <datasource caption='tableau_performance_call' name='federated.1o39sqk195y5x71bd9y4d1gvvfkn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Report Month' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Show Last 6 Months&quot;'>
              <calculation class='tableau' formula='&quot;Show Last 6 Months&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='Avg. DT LS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg. DT Dmarts (copy)_1456351589002207310]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_delivery_time_in_mins_ls])/ SUM([count_delivery_time_ls])' />
            </column>
            <column caption='Today' datatype='date' name='[Calculation_1256222833217327105]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED 1: MAX([report_month])}' />
            </column>
            <column caption='Today - 6 months' datatype='datetime' name='[Calculation_1256222833217957890]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='dateadd(&apos;month&apos;,-6,[Calculation_1256222833217327105])' />
            </column>
            <column caption='Avg. DT Dmarts' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1456351589001543753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_delivery_time_in_mins_dmarts])/ SUM([count_delivery_time_dmarts])' />
            </column>
            <column caption='&quot;Ops&quot;' datatype='string' name='[Calculation_2940920957490683912]' role='dimension' type='nominal' user:unnamed='Q-Commerce-Growth (3)'>
              <calculation class='tableau' formula='&quot;Ops&quot;' />
            </column>
            <column caption='Show Last Month' datatype='boolean' name='[Calculation_4436890073515819018]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4]=&apos;Show Last 6 Months&apos; &#10;THEN ([report_month] &gt; [Calculation_1256222833217957890] AND [report_month] &lt;= [Calculation_1256222833217327105])&#10;&#10;&#10;ELSEIF  [Parameters].[Parameter 4] = &apos;Show All&apos; THEN [report_month]&lt;=[Calculation_1256222833217327105]&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Show Last 3 Months&apos; &#10;THEN ([report_month] &gt; [Today - 6 months (copy)_924223132951281664] AND [report_month] &lt;= [Calculation_1256222833217327105])&#10;&#10;&#10;END' />
            </column>
            <column caption='Hard Fail Rate Local Stores' datatype='real' default-format='p0.0%' name='[Hard Fail Rate (copy) (copy) (copy) (copy)_3792382734026858507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders_ls]) / (sum([successful_orders_ls])+sum([failed_orders_ls]))' />
            </column>
            <column caption='Hard Fail Rate OD Dmarts' datatype='real' default-format='p0.0%' name='[Hard Fail Rate (copy) (copy) (copy)_3792382734026842122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders_od_dmarts]) / (sum([successful_orders_od_dmarts])+sum([failed_orders_od_dmarts]))' />
            </column>
            <column caption='NPS AO Dmarts' datatype='real' default-format='n#,##0;-#,##0' name='[NPS AO Food (copy)_1602014871813451783]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ao_nps_promoters_dmarts])-SUM([ao_nps_detractors_dmarts])) / SUM([ao_nps_responses_dmarts])*100' />
            </column>
            <column caption='NPS AO Local Stores' datatype='real' default-format='n#,##0;-#,##0' name='[NPS AO Food (copy)_1602014871813959688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ao_nps_promoters_ls])-SUM([ao_nps_detractors_ls])) / SUM([ao_nps_responses_ls])*100' />
            </column>
            <column caption='Today - 3 months ' datatype='datetime' name='[Today - 6 months (copy)_924223132951281664]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='dateadd(&apos;month&apos;,-3,[Calculation_1256222833217327105])' />
