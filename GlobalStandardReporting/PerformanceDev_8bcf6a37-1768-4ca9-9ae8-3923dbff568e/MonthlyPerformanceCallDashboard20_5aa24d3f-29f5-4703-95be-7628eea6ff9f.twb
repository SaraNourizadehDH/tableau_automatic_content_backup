      <table>
        <view>
          <datasources>
            <datasource caption='tableau_performance_call' name='federated.1o39sqk195y5x71bd9y4d1gvvfkn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Report Month' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Show Last 6 Months&quot;'>
              <calculation class='tableau' formula='&quot;Show Last 6 Months&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='ABV ls' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[ABV (copy)_5552023601113915468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_eur_ls])/SUM([successful_orders_ls])' />
            </column>
            <column caption='Avg. DT LS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg. DT Dmarts (copy)_1456351589002207310]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_delivery_time_in_mins_ls])/ SUM([count_delivery_time_ls])' />
            </column>
            <column caption='Today' datatype='date' name='[Calculation_1256222833217327105]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED 1: MAX([report_month])}' />
            </column>
            <column caption='Today - 6 months' datatype='datetime' name='[Calculation_1256222833217957890]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='dateadd(&apos;month&apos;,-6,[Calculation_1256222833217327105])' />
            </column>
            <column caption='Avg. DT Dmarts' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1456351589001543753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_delivery_time_in_mins_dmarts])/ SUM([count_delivery_time_dmarts])' />
            </column>
            <column caption='Restaurants Zombies LS ' datatype='real' default-format='p0.0%' name='[Calculation_1456351589003157583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_online_zombies_ls])/ SUM([restaurants_online_ls])' />
            </column>
            <column caption='dmarts orders share' datatype='real' default-format='p0.0%' name='[Calculation_1602014871821447181]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(successful_orders_dmarts)/SUM([orders])' />
            </column>
            <column caption='ABV Dmarts' datatype='real' name='[Calculation_1602014871821803534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_eur_dmarts])/SUM([successful_orders_dmarts])' />
            </column>
            <column caption='LS order share' datatype='real' default-format='p0.0%' name='[Calculation_1602014871822528527]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_ls])/SUM([orders])' />
            </column>
            <column caption='QC Orders Share' datatype='real' default-format='p0.0%' name='[Calculation_2593510442291662850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(successful_orders_qc)/SUM([orders])' />
            </column>
            <column caption='QC Orders' datatype='real' name='[Calculation_3480156641277386752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_qc])' />
            </column>
            <column caption='QC GMV' datatype='real' name='[Calculation_3480156641277583361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur_qc])' />
            </column>
            <column caption='Show Last Month' datatype='boolean' name='[Calculation_4436890073515819018]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4]=&apos;Show Last 6 Months&apos; &#10;THEN ([report_month] &gt; [Calculation_1256222833217957890] AND [report_month] &lt;= [Calculation_1256222833217327105])&#10;&#10;&#10;ELSEIF  [Parameters].[Parameter 4] = &apos;Show All&apos; THEN [report_month]&lt;=[Calculation_1256222833217327105]&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Show Last 3 Months&apos; &#10;THEN ([report_month] &gt; [Today - 6 months (copy)_924223132951281664] AND [report_month] &lt;= [Calculation_1256222833217327105])&#10;&#10;&#10;END' />
            </column>
            <column caption='QC Customer Share' datatype='real' default-format='p0.0%' name='[Calculation_6340505378463969281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_customers_qc]) / SUM([active_customers])' />
            </column>
            <column caption='QC Acq Share' datatype='real' default-format='p0.0%' name='[Dmart Acq Share (copy)_4168011130377797637]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([acquisition_qc])/SUM([acquisitions]))' />
            </column>
            <column caption='Hard Fail Rate Local Stores' datatype='real' default-format='p0.0%' name='[Hard Fail Rate (copy) (copy) (copy) (copy)_3792382734026858507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders_ls]) / (sum([successful_orders_ls])+sum([failed_orders_ls]))' />
            </column>
            <column caption='Hard Fail Rate OD Dmarts' datatype='real' default-format='p0.0%' name='[Hard Fail Rate (copy) (copy) (copy)_3792382734026842122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders_od_dmarts]) / (sum([successful_orders_od_dmarts])+sum([failed_orders_od_dmarts]))' />
            </column>
            <column caption='Courier order share' datatype='real' default-format='p0.0%' name='[LS order share (copy)_1015983964491059202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_courier])/SUM([orders])' />
            </column>
            <column caption='OD Dmarts Customers Penetration' datatype='real' name='[MP Customers Penetration (copy)_6713248568405684234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customers_returned_od_darkstore])/ sum([active_customers])' />
            </column>
            <column caption='OD Vertical Customers Penetration' datatype='real' name='[MP Customers Penetration (copy)_6713248568405798923]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customers_returned_od_vertical])/ sum([active_customers])' />
            </column>
            <column caption='NPS AO Dmarts' datatype='real' default-format='n#,##0;-#,##0' name='[NPS AO Food (copy)_1602014871813451783]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ao_nps_promoters_dmarts])-SUM([ao_nps_detractors_dmarts])) / SUM([ao_nps_responses_dmarts])*100' />
            </column>
            <column caption='NPS AO Local Stores' datatype='real' default-format='n#,##0;-#,##0' name='[NPS AO Food (copy)_1602014871813959688]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ao_nps_promoters_ls])-SUM([ao_nps_detractors_ls])) / SUM([ao_nps_responses_ls])*100' />
            </column>
            <column caption='OD Dmarts Avg Delivery Fee  (EUR) Inc SF' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[OD Restaurant Avg Delivery Fee (EUR) (copy)_2563462981842276438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((sum([amt_delivery_fee_eur_profit_od_dmarts])+sum([service_fee_eur_profit_od_dmarts]))) / sum([orders_succ_profit_od_dmarts])' />
