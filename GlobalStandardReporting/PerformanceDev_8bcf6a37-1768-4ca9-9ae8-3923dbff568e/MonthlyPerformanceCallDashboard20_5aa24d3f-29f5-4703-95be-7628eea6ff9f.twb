    <worksheet name='KPIs 6'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Performance Call October</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_performance_call' name='federated.1o39sqk195y5x71bd9y4d1gvvfkn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Report Month' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Show Last 6 Months&quot;'>
              <calculation class='tableau' formula='&quot;Show Last 6 Months&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='Today' datatype='date' name='[Calculation_1256222833217327105]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED 1: MAX([report_month])}' />
            </column>
            <column caption='Today - 6 months' datatype='datetime' name='[Calculation_1256222833217957890]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='dateadd(&apos;month&apos;,-6,[Calculation_1256222833217327105])' />
            </column>
            <column caption='Logistics Index' datatype='real' name='[Calculation_1456351588992905283]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143393374331] /[Calculation_3478397397341298689]' />
            </column>
            <column caption='&quot;Seamless Delivery&quot;' datatype='string' name='[Calculation_2889129578910089252]' role='dimension' type='nominal' user:unnamed='KPIs 6'>
              <calculation class='tableau' formula='&quot;Seamless Delivery&quot;' />
            </column>
            <column caption='UTR Exact' datatype='real' name='[Calculation_3478397397341298689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_delivered]) / sum([rider_hours])' />
            </column>
            <column caption='Restaurant Failure Share' datatype='real' default-format='p0.0%' name='[Calculation_3704844076322729991]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([restaurant_failure]) / (SUM([orders]) + SUM([failed_orders]))' />
            </column>
            <column caption='Hard Fail Rate OD' datatype='real' default-format='p0.0%' name='[Calculation_3704844076327120904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders_od]) /(sum([successful_orders_od]) + sum([failed_orders_od]))' />
            </column>
            <column caption='Show Last Month' datatype='boolean' name='[Calculation_4436890073515819018]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4]=&apos;Show Last 6 Months&apos; &#10;THEN ([report_month] &gt; [Calculation_1256222833217957890] AND [report_month] &lt;= [Calculation_1256222833217327105])&#10;&#10;&#10;ELSEIF  [Parameters].[Parameter 4] = &apos;Show All&apos; THEN [report_month]&lt;=[Calculation_1256222833217327105]&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Show Last 3 Months&apos; &#10;THEN ([report_month] &gt; [Today - 6 months (copy)_924223132951281664] AND [report_month] &lt;= [Calculation_1256222833217327105])&#10;&#10;&#10;END' />
            </column>
            <column caption='OD Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143298539523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_orders_od]) / sum([orders])' />
            </column>
            <column caption='Hard Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_6734148143378624614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders]) / (sum([orders])+sum([failed_orders]))' />
            </column>
            <column caption='Dh Failure Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143382536295]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([dh_failure]) / (SUM([orders]) + SUM([failed_orders]))' />
            </column>
            <column caption='Other Failure Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143384105069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([other_failure]) / (SUM(orders)+SUM([failed_orders]))' />
            </column>
            <column caption='Acceptance Rate' datatype='real' default-format='p0.0%' name='[Calculation_6734148143385440371]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([accepted]) / sum([offered])' />
            </column>
            <column caption='Online Payment Order Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143386165366]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_payment_online]) / sum([orders])' />
            </column>
            <column caption='Avg Delivery Time' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143393374331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(sum_delivery_time_in_mins) / SUM([count_delivery_time])' />
            </column>
            <column caption='Delay Over 10 Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143398027391]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([is_delivery_delay_late_10_mins]) / SUM([total_orders_log])' />
            </column>
            <column caption='Avg Delivery Distance' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143400939650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_delivery_distance_km]) / sum([count_delivery_distance])' />
            </column>
            <column caption='Hard Fail Rate Local Stores' datatype='real' default-format='p0.0%' name='[Hard Fail Rate (copy) (copy) (copy) (copy)_3792382734026858507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders_ls]) / (sum([successful_orders_ls])+sum([failed_orders_ls]))' />
            </column>
            <column caption='Hard Fail Rate OD Dmarts' datatype='real' default-format='p0.0%' name='[Hard Fail Rate (copy) (copy) (copy)_3792382734026842122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders_od_dmarts]) / (sum([successful_orders_od_dmarts])+sum([failed_orders_od_dmarts]))' />
            </column>
            <column caption='Hard Fail Rate MP' datatype='real' default-format='p0.0%' name='[Hard Fail Rate (copy)_3792382734026780680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders_mp]) / (sum([successful_orders_mp])+sum([failed_orders_mp]))' />
            </column>
            <column caption='Orders Delayed &gt; 45m ' datatype='real' default-format='p0.0%' name='[Orders Delayed &gt; 10m (copy)_1456351588991729725]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(is_delivery_delay_late_45_mins) / SUM([total_orders_log])' />
            </column>
            <column caption='Today - 3 months ' datatype='datetime' name='[Today - 6 months (copy)_924223132951281664]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='dateadd(&apos;month&apos;,-3,[Calculation_1256222833217327105])' />
            </column>
            <column datatype='integer' name='[accepted]' role='measure' type='quantitative' />
            <column caption='Count Delivery Distance' datatype='real' name='[count_delivery_distance]' role='measure' type='quantitative' />
            <column datatype='real' name='[count_delivery_time]' role='measure' type='quantitative' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Dh Failure' datatype='real' name='[dh_failure]' role='measure' type='quantitative' />
            <column datatype='real' name='[failed_orders]' role='measure' type='quantitative' />
            <column datatype='real' name='[failed_orders_ls]' role='measure' type='quantitative' />
            <column datatype='real' name='[failed_orders_od]' role='measure' type='quantitative' />
            <column datatype='real' name='[failed_orders_od_dmarts]' role='measure' type='quantitative' />
            <column datatype='real' name='[is_delivery_delay_late_10_mins]' role='measure' type='quantitative' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2889129578910089252]' derivation='None' name='[none:Calculation_2889129578910089252:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4436890073515819018]' derivation='None' name='[none:Calculation_4436890073515819018:nk]' pivot='key' type='nominal' />
