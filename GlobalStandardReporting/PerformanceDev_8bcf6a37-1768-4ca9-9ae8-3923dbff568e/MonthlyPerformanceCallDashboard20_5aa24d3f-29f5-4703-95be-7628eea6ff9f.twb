      <column caption='ABV ls' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[ABV (copy)_5552023601113915468]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gbv_eur_ls])/SUM([successful_orders_ls])' />
      </column>
      <column caption='ABV MoM Dmarts' datatype='real' default-format='p0.0%' name='[ABV (copy)_6175631400285098057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([gbv_eur_dmarts])/SUM(successful_orders_dmarts))&#10;/ &#10;(SUM([gbv_eur_dmarts_mom])/SUM([successful_orders_dmarts_mom])) -1' />
      </column>
      <column caption='ABV MoM LS' datatype='real' default-format='p0.0%' name='[ABV MoM (copy)_5552023601113915466]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([gbv_eur_ls])/SUM([successful_orders_ls])) / (SUM([gbv_eur_ls_mom])/SUM([successful_orders_ls_mom])) -1' />
      </column>
      <column caption='ABV YoY Dmarts' datatype='real' default-format='p0.0%' name='[ABV MoM (copy)_6175631400285311050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([gbv_eur_dmarts])/SUM(successful_orders_dmarts)) / (SUM([gbv_eur_dmarts_yoy])/SUM(successful_orders_dmarts_yoy)) -1' />
      </column>
      <column caption='ABV YoY LS' datatype='real' default-format='p0.0%' name='[ABV YoY (copy)_5552023601113915467]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([gbv_eur_ls])/SUM([successful_orders_ls])) / (SUM([gbv_eur_ls_yoy])/SUM([successful_orders_ls_yoy])) -1' />
      </column>
