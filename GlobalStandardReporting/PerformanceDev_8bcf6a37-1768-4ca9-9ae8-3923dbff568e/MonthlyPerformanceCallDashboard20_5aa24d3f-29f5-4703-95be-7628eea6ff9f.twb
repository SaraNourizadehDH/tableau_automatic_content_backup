    <worksheet name='Big Best - Choice YoY'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_performance_call' name='federated.1o39sqk195y5x71bd9y4d1gvvfkn' />
          </datasources>
          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='YoY Restaurants Online Food' datatype='real' default-format='p0%' name='[Calculation_4168011130370625538]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_online_food])/SUM([restaurants_online_food_yoy])-1' />
            </column>
            <column caption='Placeholder' datatype='integer' default-format='*#,#' name='[Calculation_5552023600766189569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='placeholder reorder rate' datatype='integer' default-format='*#,#' name='[Calculation_5552023601045925898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Rating GFS Above 4 Share' datatype='real' default-format='p0.0%' name='[Calculation_5552023601086197829]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rating_gfs_above_4_vendor_share])/SUM([restaurants_online_gfs])' />
            </column>
            <column caption='&quot;Choice&quot;' datatype='string' name='[Calculation_6175631400228700161]' role='dimension' type='nominal' user:unnamed='Choice'>
              <calculation class='tableau' formula='&quot;Choice&quot;' />
            </column>
            <column caption='YoY Res Online' datatype='real' default-format='p0.0%' name='[Calculation_6734148143359873108]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([restaurants_online]) / sum([restaurants_online_yoy]) -1' />
            </column>
            <column caption='YoY' datatype='string' name='[Calculation_6734148144005718231]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;YoY&quot;' />
            </column>
            <column caption='Restaurants Online MP' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_717409348940955649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_online_mp])' />
            </column>
            <column caption='YoY Res Online MP' datatype='real' default-format='p0.0%' name='[Calculation_727190604387561478]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_717409348940955649] / SUM([restaurants_online_mp_yoy]) - 1' />
            </column>
            <column caption='YoY Res Online OD' datatype='real' default-format='p0.0%' name='[Calculation_727190604387897351]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([restaurants_online_od]) / sum([restaurants_online_od_yoy]) - 1' />
            </column>
            <column caption='GFS top brands YoY' datatype='real' default-format='p0.0%' name='[GFS top brands MoM (copy)_5552023601071939620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gfs_top_15_brands])/SUM([gfs_top_15_brands_yoy]) - 1' />
            </column>
