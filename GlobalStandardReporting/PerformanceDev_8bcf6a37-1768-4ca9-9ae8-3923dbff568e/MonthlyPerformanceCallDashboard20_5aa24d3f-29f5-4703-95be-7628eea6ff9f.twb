    <worksheet name='ALL'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_performance_call' name='federated.1o39sqk195y5x71bd9y4d1gvvfkn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Report Month' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Show Last 6 Months&quot;'>
              <calculation class='tableau' formula='&quot;Show Last 6 Months&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='blank' datatype='real' name='[Calculation_1108518874172026880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(NULL)' />
            </column>
            <column caption='Today' datatype='date' name='[Calculation_1256222833217327105]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED 1: MAX([report_month])}' />
            </column>
            <column caption='Today - 6 months' datatype='datetime' name='[Calculation_1256222833217957890]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='dateadd(&apos;month&apos;,-6,[Calculation_1256222833217327105])' />
            </column>
            <column caption='CARC' datatype='real' name='[Calculation_1395834461065924611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-1 * SUM([lucc_carc_eur])' />
            </column>
            <column caption='Logistics Index' datatype='real' name='[Calculation_1456351588992905283]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143393374331] /[Calculation_3478397397341298689]' />
            </column>
            <column caption='Frequency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1602014871802343424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM([active_customers])' />
            </column>
            <column caption='NPS AO Food' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1602014871812845574]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ao_nps_promoters_food])-SUM([ao_nps_detractors_food])) / SUM([ao_nps_responses_food])*100' />
            </column>
            <column caption='Resto Zombie Share' datatype='real' default-format='p0.0%' name='[Calculation_1602014871814529033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(restaurants_online_zombies_food)/SUM([restaurants_online_food])' />
            </column>
            <column caption='dmarts orders share' datatype='real' default-format='p0.0%' name='[Calculation_1602014871821447181]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(successful_orders_dmarts)/SUM([orders])' />
            </column>
            <column caption='ABV Dmarts' datatype='real' name='[Calculation_1602014871821803534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gbv_eur_dmarts])/SUM([successful_orders_dmarts])' />
            </column>
            <column caption='LS order share' datatype='real' default-format='p0.0%' name='[Calculation_1602014871822528527]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_ls])/SUM([orders])' />
            </column>
            <column caption='QC Orders Share' datatype='real' default-format='p0.0%' name='[Calculation_2593510442291662850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(successful_orders_qc)/SUM([orders])' />
            </column>
            <column caption='Restaurants Online Below 30 Share' datatype='real' default-format='p0.0%' name='[Calculation_2889129578627411972]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(restaurants_online_below_30_orders_food) / SUM([restaurants_online_food])' />
            </column>
            <column caption='AOV profitability' datatype='real' name='[Calculation_2889129578632097802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_gmv_eur_profit])/SUM([orders_succ_profit])' />
            </column>
            <column caption='TakeRate as % AOV' datatype='real' default-format='p0.0%' name='[Calculation_2889129578632638476]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Take Rate (EUR) (copy)_2889129578632396811]/[Calculation_2889129578632097802]' />
            </column>
            <column caption='UTR Exact' datatype='real' name='[Calculation_3478397397341298689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_delivered]) / sum([rider_hours])' />
            </column>
            <column caption='NCR % GMV' datatype='real' default-format='p0.0%' name='[Calculation_3692459156829249542]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([lucc_ncr_eur])/SUM(zn([gmv_eur]))' />
            </column>
            <column caption='VFI % GMV' datatype='real' default-format='p0.0%' name='[Calculation_3692459156842242079]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_funded_incentives_eur])/SUM([gmv_eur])' />
            </column>
            <column caption='Retention 1 Month' datatype='real' default-format='p0.0%' name='[Calculation_3704844076316794883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([c1_users]) / sum([c1_acquisitions])' />
            </column>
            <column caption='Show Last Month' datatype='boolean' name='[Calculation_4436890073515819018]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4]=&apos;Show Last 6 Months&apos; &#10;THEN ([report_month] &gt; [Calculation_1256222833217957890] AND [report_month] &lt;= [Calculation_1256222833217327105])&#10;&#10;&#10;ELSEIF  [Parameters].[Parameter 4] = &apos;Show All&apos; THEN [report_month]&lt;=[Calculation_1256222833217327105]&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Show Last 3 Months&apos; &#10;THEN ([report_month] &gt; [Today - 6 months (copy)_924223132951281664] AND [report_month] &lt;= [Calculation_1256222833217327105])&#10;&#10;&#10;END' />
            </column>
            <column caption='Take Rate (EUR)' datatype='real' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[Calculation_6175631400253345801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(take_in_cpo_eur)' />
            </column>
            <column caption='Total CPO (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6175631400257261585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_cpo_eur]) / SUM([orders_succ_profit])' />
            </column>
            <column caption='GP % GMV Inc NCR' datatype='real' default-format='p0.0%' name='[Calculation_6175631400260841497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gpo_eur_profit]) + SUM([lucc_ncr_eur]))/SUM([amt_gmv_eur_profit])' />
            </column>
            <column caption='FLGP as % GMV Inc NCR' datatype='real' default-format='p0.0%' name='[Calculation_6175631400261918746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([flgpo_eur_profit]) + SUM([lucc_ncr_eur]))/SUM([amt_gmv_eur_profit])' />
            </column>
            <column caption='QC Customer Share' datatype='real' default-format='p0.0%' name='[Calculation_6340505378463969281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_customers_qc]) / SUM([active_customers])' />
            </column>
            <column caption='Avg DF/AFV Inc SF - OD' datatype='real' default-format='p0.0%' name='[Calculation_6343601566266662914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([amt_delivery_fee_eur_profit_od]) + SUM([service_fee_eur_profit_od]))/ (SUM([gfv_eur_profit_od]) )' />
            </column>
            <column caption='OD Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143298539523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_orders_od]) / sum([orders])' />
            </column>
            <column caption='AOV (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143334748190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_eur]) / sum([orders])' />
            </column>
            <column caption='Avg Delivery Fee (EUR) inc. SF - OD' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143335637023]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([amt_delivery_fee_eur_profit_od]) + SUM([service_fee_eur_profit_od])) / sum([orders_succ_profit_od])' />
            </column>
            <column caption='Activity Rate' datatype='real' default-format='p0.00%' name='[Calculation_6734148143340744744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([active_customers]) / sum([customer_base])' />
            </column>
            <column caption='Hard Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_6734148143378624614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders]) / (sum([orders])+sum([failed_orders]))' />
            </column>
            <column caption='Avg Delivery Time' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143393374331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(sum_delivery_time_in_mins) / SUM([count_delivery_time])' />
            </column>
            <column caption='Delay Over 10 Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143398027391]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([is_delivery_delay_late_10_mins]) / SUM([total_orders_log])' />
            </column>
            <column caption='CVR Total' datatype='real' default-format='p0.00%' name='[Calculation_6734148143630839943]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_76631562432221200] / [Calculation_76631562431836175]' />
            </column>
            <column caption='NPS AO' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_6734148143635775639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( sum([ao_nps_promoters]) - sum([ao_nps_detractors]) ) / sum([ao_nps_responses]) * 100' />
            </column>
            <column caption='Sessions Perseus' datatype='real' default-format='n#,##0,K;-#,##0,K' name='[Calculation_76631562431836175]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions])' />
            </column>
            <column caption='Transactions total' datatype='real' default-format='n#,##0,K;-#,##0,K' name='[Calculation_76631562432221200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sessions_w_order])' />
            </column>
            <column caption='FLGPO Inc NCR' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[FLGPO OD (copy)_4428445832284151812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([flgpo_eur_profit]) + SUM([lucc_ncr_eur]))/SUM([orders_succ_profit])' />
            </column>
            <column caption='GPO Inc NCR' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[GPO OD (copy)_1500120912056442882]' role='measure' type='quantitative'>
