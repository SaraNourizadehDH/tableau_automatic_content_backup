          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='Restaurants Zombies LS ' datatype='real' default-format='p0.0%' name='[Calculation_1456351589003157583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_online_zombies_ls])/ SUM([restaurants_online_ls])' />
            </column>
            <column caption='Restaurants New Online LS MoM' datatype='real' default-format='p0.0%' name='[Calculation_1456351589023412307]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_new_online_ls])/SUM([restaurants_new_online_ls_mom]) -1' />
            </column>
            <column caption='Recovered Churn LS MoM' datatype='real' default-format='p0.0%' name='[Calculation_1456351589024518231]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_recovered_churn_ls])/SUM([restaurants_recovered_churn_ls_mom]) - 1' />
            </column>
            <column caption='Restaurants Online LS MoM' datatype='real' default-format='p0.0%' name='[Calculation_2889129578641219607]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_online_ls])/SUM([restaurants_online_ls_mom]) - 1' />
            </column>
            <column caption='&quot;Q-Commerce&quot;' datatype='string' name='[Calculation_6175631400228909061]' role='dimension' type='nominal' user:unnamed='Q-Commerce'>
              <calculation class='tableau' formula='&quot;Q-Commerce&quot;' />
            </column>
            <column caption='Dmarts Online MoM' datatype='real' default-format='p0.0%' name='[Calculation_6175631400283824194]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dmarts_online])/SUM([dmarts_online_mom])-1' />
            </column>
            <column caption='MoM' datatype='string' name='[Calculation_6734148143346507829]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;MoM&quot;' />
            </column>
            <column caption='LS Active MoM ' datatype='real' default-format='p0.0%' name='[Dmarts Active MoM (copy)_5739204457357705247]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(restaurants_active_ls)/SUM([restaurants_active_ls_mom])-1' />
            </column>
            <column caption='Dmarts Active MoM' datatype='real' default-format='p0.0%' name='[Dmarts Online MoM (copy)_5739204457357193244]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dmarts_active])/SUM([dmarts_active_mom])-1' />
            </column>
            <column caption='OD Dmarts Customers Penetration' datatype='real' name='[MP Customers Penetration (copy)_6713248568405684234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customers_returned_od_darkstore])/ sum([active_customers])' />
            </column>
            <column caption='OD Vertical Customers Penetration' datatype='real' name='[MP Customers Penetration (copy)_6713248568405798923]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customers_returned_od_vertical])/ sum([active_customers])' />
            </column>
            <column caption='MoM OD DS Customers Penetration' datatype='real' name='[OD DS Customers Penetration (copy)_6713248568406507533]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([MP Customers Penetration (copy)_6713248568405684234] * 100) - &#10;(sum([customers_returned_od_darkstore_mom])/ sum([active_customers_mom]))  * 100' />
            </column>
            <column caption='MoM OD NV Customers Penetration' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[OD NV Customers Penetration (copy)_6713248568406700046]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([MP Customers Penetration (copy)_6713248568405798923]*100) -&#10;(sum([customers_returned_od_vertical_mom])/ sum([active_customers_mom]))  * 100' />
            </column>
            <column caption='Report Month (copy)' datatype='date' default-format='*MMM-YY' name='[Report Month (copy)_6551893070657155072]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_month]' />
            </column>
            <column caption='Restaurants New Online Dmart MoM ' datatype='real' default-format='p0.0%' name='[Restaurants New Online LS MoM (copy)_1015983964506058782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_new_online_dmart])/SUM([restaurants_new_online_dmart_mom]) -1' />
            </column>
