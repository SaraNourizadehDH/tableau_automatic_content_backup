    <worksheet name='KPIs 2 MoMMM'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Performance Call October</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_performance_call' name='federated.1o39sqk195y5x71bd9y4d1gvvfkn' />
          </datasources>
          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='OD Restaurant AOV (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AOV (EUR) (copy) (copy 2)_2563462981837709382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(gmv_eur_od_food) / sum(successful_orders_od_food)' />
            </column>
            <column caption='MP AOV (EUR) ' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AOV (EUR) (copy)_2563462981837672516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_eur_mp]) / sum([successful_orders_mp])' />
            </column>
            <column caption='AOV profitability' datatype='real' name='[Calculation_2889129578632097802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_gmv_eur_profit])/SUM([orders_succ_profit])' />
            </column>
            <column caption='&quot;Affordability&quot;' datatype='string' name='[Calculation_2889129578907181088]' role='dimension' type='nominal' user:unnamed='KPIs 2'>
              <calculation class='tableau' formula='&quot;Affordability&quot;' />
            </column>
            <column caption='MP Commission Rate' datatype='real' default-format='p0.00%' name='[Calculation_2952602200977977350]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(sum([amt_commission_eur_profit_mp]),0) / zn(sum(commissionable_value_eur_mp))' />
            </column>
            <column caption='placeholder reorder rate' datatype='integer' default-format='*#,#' name='[Calculation_5552023601045925898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='placeholder affordability' datatype='integer' default-format='*#,#' name='[Calculation_5552023601078083633]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Take Rate (EUR)' datatype='real' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[Calculation_6175631400253345801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(take_in_cpo_eur)' />
            </column>
            <column caption='OD Commission Rate' datatype='real' default-format='p0.00%' name='[Calculation_6734148143309099032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(sum([amt_commission_eur_profit_od]),0) / zn(sum(commissionable_value_eur_od))' />
            </column>
            <column caption='MoM OD Commission Rate' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Calculation_6734148143309283353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6734148143309099032]*100) - (IFNULL(sum([amt_commission_eur_profit_mom_od]),0) / zn(sum(commissionable_value_eur_od_mom))*100)' />
            </column>
            <column caption='MoM MP Commission Rate' datatype='real' default-format='p0.0%' name='[Calculation_6734148143333548060]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2952602200977977350]*100) - (&#10;IFNULL(sum([amt_commission_eur_profit_mom_mp]),0) / zn(sum(commissionable_value_eur_mp_mom))&#10;&#10;*100)' />
