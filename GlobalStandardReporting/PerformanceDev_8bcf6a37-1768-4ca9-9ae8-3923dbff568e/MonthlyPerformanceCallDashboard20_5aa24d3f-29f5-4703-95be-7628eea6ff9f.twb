              <calculation class='tableau' formula='[Hard Fail Rate (copy) (copy) (copy)_3792382734026842122]*100 -&#10; (sum([failed_orders_od_dmarts_mom]) / (sum([successful_orders_od_dmarts_mom])+sum([failed_orders_od_dmarts_mom])) *100)' />
            </column>
            <column caption='Orders Delayed &gt; 45m ' datatype='real' default-format='p0.0%' name='[Orders Delayed &gt; 10m (copy)_1456351588991729725]' role='measure' type='quantitative'>
