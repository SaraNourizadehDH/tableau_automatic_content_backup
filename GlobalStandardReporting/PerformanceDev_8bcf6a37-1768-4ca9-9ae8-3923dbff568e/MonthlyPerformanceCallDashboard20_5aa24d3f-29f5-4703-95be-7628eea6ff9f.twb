            <column caption='NPS AO Dmarts' datatype='real' default-format='n#,##0;-#,##0' name='[NPS AO Food (copy)_1602014871813451783]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ao_nps_promoters_dmarts])-SUM([ao_nps_detractors_dmarts])) / SUM([ao_nps_responses_dmarts])*100' />
