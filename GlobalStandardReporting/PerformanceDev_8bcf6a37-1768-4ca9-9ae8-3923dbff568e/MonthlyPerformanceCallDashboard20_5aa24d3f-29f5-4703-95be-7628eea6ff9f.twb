    <worksheet name='q_commerce_choice_yoy'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_performance_call' name='federated.1o39sqk195y5x71bd9y4d1gvvfkn' />
          </datasources>
          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='Restaurants Zombies LS ' datatype='real' default-format='p0.0%' name='[Calculation_1456351589003157583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_online_zombies_ls])/ SUM([restaurants_online_ls])' />
            </column>
            <column caption='&quot;Q-Commerce&quot;' datatype='string' name='[Calculation_6175631400228909061]' role='dimension' type='nominal' user:unnamed='Q-Commerce'>
              <calculation class='tableau' formula='&quot;Q-Commerce&quot;' />
            </column>
            <column caption='YoY' datatype='string' name='[Calculation_6734148144005718231]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;YoY&quot;' />
            </column>
            <column caption='Ls Active YoY ' datatype='real' default-format='p0.0%' name='[Dmarts Active YoY  (copy)_5739204457357705248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(restaurants_active_ls)/SUM([restaurants_active_ls_yoy])-1' />
            </column>
            <column caption='Dmarts Online YoY' datatype='real' default-format='p0.0%' name='[Dmarts Online MoM (copy)_6175631400283942979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dmarts_online])/SUM([dmarts_online_yoy])-1' />
            </column>
            <column caption='Dmarts Active YoY ' datatype='real' default-format='p0.0%' name='[Dmarts Online YoY (copy)_5739204457357193245]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dmarts_active])/SUM([dmarts_active_yoy])-1' />
            </column>
            <column caption='OD Dmarts Customers Penetration' datatype='real' name='[MP Customers Penetration (copy)_6713248568405684234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customers_returned_od_darkstore])/ sum([active_customers])' />
            </column>
            <column caption='OD Vertical Customers Penetration' datatype='real' name='[MP Customers Penetration (copy)_6713248568405798923]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customers_returned_od_vertical])/ sum([active_customers])' />
            </column>
            <column caption='YoY OD DS Customers Penetration' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[MoM OD DS Customers Penetration (copy)_6713248568407158801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([MP Customers Penetration (copy)_6713248568405684234]*100) -&#10;&#10;(sum([customers_returned_od_darkstore_yoy])/ sum([active_customers_yoy])) * 100' />
            </column>
            <column caption='YoY OD NV Customers Penetration' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[MoM OD NV Customers Penetration (copy)_6713248568407191570]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([MP Customers Penetration (copy)_6713248568405798923]*100) - &#10;(sum([customers_returned_od_vertical_yoy])/ sum([active_customers_yoy])) * 100' />
            </column>
            <column caption='Recovered Churn LS YoY' datatype='real' default-format='p0.0%' name='[Recovered Churn LS MoM (copy)_1456351589024653400]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_recovered_churn_ls])/SUM([restaurants_recovered_churn_ls_yoy]) - 1' />
            </column>
            <column caption='Report Month (copy)' datatype='date' default-format='*MMM-YY' name='[Report Month (copy)_6551893070657155072]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[report_month]' />
            </column>
            <column caption='Restaurants New Online Dmart YoY' datatype='real' default-format='p0.0%' name='[Restaurants New Online Dmart MoM  (copy)_1015983964506431519]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_new_online_dmart])/SUM([restaurants_new_online_dmart_yoy]) -1' />
            </column>
            <column caption='Restaurants New Online LS YoY' datatype='real' default-format='p0.0%' name='[Restaurants New Online LS MoM (copy)_1456351589023543380]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_new_online_ls])/SUM([restaurants_new_online_ls_yoy])-1' />
            </column>
            <column caption='Restaurants Online LS YoY' datatype='real' default-format='p0.0%' name='[Restaurants Online LS MoM (copy)_2889129578641424408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_online_ls])&#10;/SUM([restaurants_online_ls_yoy]) &#10;- 1' />
            </column>
            <column caption='Restaurants Zombies LS  YoY' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Restaurants Zombies LS  MoM (copy)_1456351589004054609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1456351589003157583]*100) &#10;- &#10;(SUM([restaurants_online_zombies_ls_yoy]) / SUM([restaurants_online_ls_yoy]) * 100)' />
            </column>
