    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='KPI Definitions'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/PerformanceCallABCs/KPIDefinitions?rev=' id='KPIDefinitions' path='/t/GlobalStandardReporting/workbooks/PerformanceCallABCs' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#ffffff' />
        </style-rule>
        <style-rule element='dash-title'>
          <format attr='color' value='#ffffff' />
          <format attr='text-align' value='center' />
          <format attr='background-color' value='#d8232a' />
        </style-rule>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_100' value='center' />
          <format attr='text-orientation' id='dash-text_268' value='-90' />
          <format attr='text-orientation' id='dash-text_269' value='-90' />
          <format attr='text-orientation' id='dash-text_270' value='-90' />
          <format attr='text-align' id='dash-text_268' value='center' />
          <format attr='text-align' id='dash-text_269' value='center' />
          <format attr='vertical-align' id='dash-text_269' value='center' />
          <format attr='text-align' id='dash-text_270' value='center' />
          <format attr='vertical-align' id='dash-text_270' value='center' />
        </style-rule>
      </style>
      <size maxheight='1400' maxwidth='1400' minheight='1400' minwidth='1400' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone fixed-size='47' h='3928' id='103' is-fixed='true' type-v2='title' w='98858' x='571' y='571'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='78500' id='104' type-v2='text' w='47143' x='571' y='6786'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='10'>Orders:</run>
              <run fontcolor='#000000' fontsize='10'> Total orders = Food + QC</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Orders Dmarts:</run>
              <run fontcolor='#000000' fontsize='10'>  Dmart orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Orders Local Stores: </run>
              <run fontcolor='#000000' fontsize='10'>   Local store orders = OD +VD</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Orders Pick-up: </run>
              <run fontcolor='#000000' fontsize='10'>Pick-up orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Orders Courier:</run>
              <run fontcolor='#000000' fontsize='10'> Deliver anything orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>GMV:   </run>
              <run fontcolor='#000000' fontsize='10'> Total GMV -&gt; customer paid amount</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>CARC: </run>
              <run fontcolor='#000000' fontsize='10'>  Platform customer acquisition and retention cost from Lucanet</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Acquisitions: </run>
              <run fontcolor='#000000' fontsize='10'>  Total acquisitions platform </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Active Customers:</run>
              <run fontcolor='#000000' fontsize='10'>   Total unique active customers on the platform</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Frequency: </run>
              <run fontcolor='#000000' fontsize='10'> Total orders/ active customer</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Activity Rate:</run>
              <run fontcolor='#000000' fontsize='10'>  Active customers / cumulative customer base</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Reorder Rate 1 Month: </run>
              <run fontcolor='#000000' fontsize='10'>  % customers who placed atleast 1 order after 1 month of acquisition</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>TOM: </run>
              <run fontcolor='#000000' fontsize='10'>   Top of mind : brand is the first brand a consumer mentions when prompted for a food delivery brand</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Preference: </run>
              <run fontcolor='#000000' fontsize='10'>Brand preference: these are the set of delivery brands within a category that consumers prefer to use. Brand Preference is measured by asking consumers which delivery brands they prefer to use within a particular category.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>NPS AO food:  </run>
              <run fontcolor='#000000' fontsize='10'>  NPS score of customers after food order is placed</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>NPS AO:</run>
              <run fontcolor='#000000' fontsize='10'> NPS score of customers after any order is placed (food + QC)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Online Vendors:</run>
              <run fontcolor='#000000' fontsize='10'> Total online vendors</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Active Vendors: </run>
              <run fontcolor='#000000' fontsize='10'>Vendors who received atleast 1 order</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Online Restaurants:</run>
              <run fontcolor='#000000' fontsize='10'> Total online food restos</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Active Restaurants: </run>
              <run fontcolor='#000000' fontsize='10'>Food restos who received atleast 1 order</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>New Online Restaurants:</run>
              <run fontcolor='#000000' fontsize='10'> Food restos which were online</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>% Online Restos &lt; 30 Orders: </run>
              <run fontcolor='#000000' fontsize='10'><![CDATA[   Online restos <30 orders in 1 month]]></run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>% Pickup Orders:  </run>
              <run fontcolor='#000000' fontsize='10'>  PU orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>% Zombie Vendors: </run>
              <run fontcolor='#000000' fontsize='10'>  % of vendors with 0 orders in a month = Food + Dmarts + LS</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>% Zombie Restaurants: </run>
              <run fontcolor='#000000' fontsize='10'>  % of food restos 0 orders in 1 month</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>TakeRate Inc NCR as % AOV: </run>
              <run fontcolor='#000000' fontsize='10'> Platform take rate as per LN inc. NCR</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>VFI % GMV:</run>
              <run fontcolor='#000000' fontsize='10'>  Vendor funded incentives (discounts + vouchers)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>NCR % GMV:  </run>
              <run fontcolor='#000000' fontsize='10'>Platform NCR revenue as per LN</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Total CPO as % AOV: </run>
              <run fontcolor='#000000' fontsize='10'>Total Platform CPO as per LN</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>GP % GMV Inc NCR: </run>
              <run fontcolor='#000000' fontsize='10'>  Total Platform GP margin</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>FLGP as % GMV Inc NCR:</run>
              <run fontcolor='#000000' fontsize='10'>  Total Platform FLGP margin</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Avg DF+SF as % of AFV - OD: </run>
              <run fontcolor='#000000' fontsize='10'>OD DF+SF as % of AFV as per logistics dashboard for platform</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>OD Food CR %:   </run>
              <run fontcolor='#000000' fontsize='10'>OD restos CR (sales definition) as per LN</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>MP Food CR %: </run>
              <run fontcolor='#000000' fontsize='10'>  OD restos CR (sales definition) as per LN</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Sessions:</run>
              <run fontcolor='#000000' fontsize='10'>   Total number of sessions recorded</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Downloads:</run>
              <run fontcolor='#000000' fontsize='10'>  Total Downloads</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>% OD Share:</run>
              <run fontcolor='#000000' fontsize='10'> OD share = Food + Dmarts + OD LS + Delivery anything</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>% Seamless Orders: </run>
              <run fontcolor='#000000' fontsize='10'> Share of orders which are not cancelled or delayed and doesn&apos;t have contact center interaction.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>% Hard Fail Rate: </run>
              <run fontcolor='#000000' fontsize='10'>  Share of failed orders over total orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>% Orders &gt; 10 min late:</run>
              <run fontcolor='#000000' fontsize='10'> Share of successful orders which have been delivered more than 10 mins later compared to the promised delivery time. -Only OD</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>CVR Total: </run>
              <run fontcolor='#000000' fontsize='10'> Conversion Rate : Total customers who got converted from downloading the app to placing an order.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Avg Delivery Time: </run>
              <run fontcolor='#000000' fontsize='10'> Avg of actual delivery time</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>UTR:</run>
              <run fontcolor='#000000' fontsize='10'>    Number of orders per rider hours</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Order Share: Dmarts: </run>
              <run fontcolor='#000000' fontsize='10'>   Order share of Dmarts of total orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Online Vendors Dmarts: </run>
              <run fontcolor='#000000' fontsize='10'> Number of Dmarts online</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>ABV Dmarts:</run>
              <run fontcolor='#000000' fontsize='10'> Average basket value of Dmarts</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Order Share: Local Stores: </run>
              <run fontcolor='#000000' fontsize='10'> Order share - Local stores</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Online Vendors Local Stores:</run>
              <run fontcolor='#000000' fontsize='10'>    Number of Local stores online</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Order Share: QC:</run>
              <run fontcolor='#000000' fontsize='10'>    QC = Dmarts + LS + Deliver Anything</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>NPS AO Dmarts:</run>
              <run fontcolor='#000000' fontsize='10'>  NPS After order Dmars</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>QC Customer Share:</run>
              <run fontcolor='#000000' fontsize='10'>    Share of QC active customers</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>AOV (EUR):  </run>
              <run fontcolor='#000000' fontsize='10'>Average order value = Total GMV/ total orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Avg Delivery Fee (EUR) inc. SF - OD:</run>
              <run fontcolor='#000000' fontsize='10'>    avg DF + SF for OD only</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>Total CPO (EUR):</run>
              <run fontcolor='#000000' fontsize='10'>    Total Platform CPO as per LN</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>GPO Inc NCR:  </run>
              <run fontcolor='#000000' fontsize='10'>  Platform GPO</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='10'>FLGPO Inc NCR:</run>
              <run fontcolor='#000000' fontsize='10'>  Platform FLGPO</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='0' />
            </zone-style>
          </zone>
