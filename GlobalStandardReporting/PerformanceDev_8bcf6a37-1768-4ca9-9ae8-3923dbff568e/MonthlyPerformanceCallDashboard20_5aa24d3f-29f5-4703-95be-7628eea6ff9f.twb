    <worksheet name='Q-Commerce-Choice'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_performance_call' name='federated.1o39sqk195y5x71bd9y4d1gvvfkn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Report Month' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Show Last 6 Months&quot;'>
              <calculation class='tableau' formula='&quot;Show Last 6 Months&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='Today' datatype='date' name='[Calculation_1256222833217327105]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED 1: MAX([report_month])}' />
            </column>
            <column caption='Today - 6 months' datatype='datetime' name='[Calculation_1256222833217957890]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='dateadd(&apos;month&apos;,-6,[Calculation_1256222833217327105])' />
            </column>
            <column caption='Restaurants Zombies LS ' datatype='real' default-format='p0.0%' name='[Calculation_1456351589003157583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_online_zombies_ls])/ SUM([restaurants_online_ls])' />
            </column>
            <column caption='&quot;Choice&quot;' datatype='string' name='[Calculation_2940920957493207052]' role='dimension' type='nominal' user:unnamed='Q-Commerce-Choise'>
              <calculation class='tableau' formula='&quot;Choice&quot;' />
            </column>
            <column caption='Show Last Month' datatype='boolean' name='[Calculation_4436890073515819018]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4]=&apos;Show Last 6 Months&apos; &#10;THEN ([report_month] &gt; [Calculation_1256222833217957890] AND [report_month] &lt;= [Calculation_1256222833217327105])&#10;&#10;&#10;ELSEIF  [Parameters].[Parameter 4] = &apos;Show All&apos; THEN [report_month]&lt;=[Calculation_1256222833217327105]&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Show Last 3 Months&apos; &#10;THEN ([report_month] &gt; [Today - 6 months (copy)_924223132951281664] AND [report_month] &lt;= [Calculation_1256222833217327105])&#10;&#10;&#10;END' />
            </column>
            <column caption='OD Dmarts Customers Penetration' datatype='real' name='[MP Customers Penetration (copy)_6713248568405684234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customers_returned_od_darkstore])/ sum([active_customers])' />
            </column>
            <column caption='OD Vertical Customers Penetration' datatype='real' name='[MP Customers Penetration (copy)_6713248568405798923]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([customers_returned_od_vertical])/ sum([active_customers])' />
            </column>
            <column caption='Today - 3 months ' datatype='datetime' name='[Today - 6 months (copy)_924223132951281664]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='dateadd(&apos;month&apos;,-3,[Calculation_1256222833217327105])' />
            </column>
            <column datatype='real' name='[active_customers]' role='measure' type='quantitative' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[dmarts_active]' role='measure' type='quantitative' />
            <column datatype='real' name='[dmarts_online]' role='measure' type='quantitative' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2940920957493207052]' derivation='None' name='[none:Calculation_2940920957493207052:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4436890073515819018]' derivation='None' name='[none:Calculation_4436890073515819018:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
