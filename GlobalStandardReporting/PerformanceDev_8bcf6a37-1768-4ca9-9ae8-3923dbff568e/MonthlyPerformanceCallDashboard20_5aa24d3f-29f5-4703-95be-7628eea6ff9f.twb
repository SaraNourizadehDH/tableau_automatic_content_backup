            <column caption='Avg. DT Dmarts MoM' datatype='real' default-format='p0.0%' name='[Avg. DT Dmarts (copy)_1456351589001773130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1456351589001543753] / (SUM([sum_delivery_time_in_mins_dmarts_mom])/SUM([count_delivery_time_dmarts_mom])) - 1' />
            </column>
            <column caption='Avg. DT LS' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg. DT Dmarts (copy)_1456351589002207310]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sum_delivery_time_in_mins_ls])/ SUM([count_delivery_time_ls])' />
            </column>
            <column caption='Avg. DT ls MoM ' datatype='real' default-format='p0.0%' name='[Avg. DT Dmarts MoM (copy)_1456351589002207308]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg. DT Dmarts (copy)_1456351589002207310] / (SUM([sum_delivery_time_in_mins_ls_mom])/SUM([count_delivery_time_ls_mom])) - 1' />
            </column>
