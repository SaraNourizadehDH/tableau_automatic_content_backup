      </connection>
      <aliases enabled='yes' />
      <column caption='username filter' datatype='boolean' name='[Calculation_4503388531351437312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username (gsr_entitlements_performance_global_entity_id1)] = USERNAME()' />
      </column>
      <column caption='Orders per 1000 pop' datatype='real' default-format='p0%' name='[Calculation_4503388531351834625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(1000* SUM([orders]) / SUM([population.population])) / (1000* SUM([orders_prev]) / SUM([population.population])) - 1' />
      </column>
      <column caption='Frequency' datatype='real' default-format='p0%' name='[Calculation_4503388531359203330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([orders])/SUM([active_customers])) / (SUM([orders_prev])/SUM([active_customers_prev])) - 1' />
      </column>
      <column caption='Acq. as % Active Customers' datatype='real' name='[Calculation_4503388531359424515]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM([acquisitions])/SUM([active_customers])) - (SUM([acquisitions_prev])/SUM([active_customers_prev]))) *100' />
      </column>
      <column caption='New Vendors / Vendors Online' datatype='real' name='[Calculation_4503388531359670276]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([new_online])/SUM([online_vendors])) / (SUM([new_online_prev])/SUM([online_vendors_prev])) - 1' />
      </column>
      <column caption='Active customers per 1 mil pop' datatype='real' name='[Calculation_4503388531359944709]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(1000000 * SUM([active_customers]) / SUM([population.population])) / (1000000 * SUM([active_customers_prev]) / SUM([population.population])) - 1' />
      </column>
      <column caption='DF as % AFV' datatype='real' name='[Calculation_4503388531361353735]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(((SUM([delivery_fee_eur])/SUM([orders]))/ (SUM([gbv_eur])/SUM([orders]))) - ((SUM([delivery_fee_eur_prev])/SUM([orders_prev]))/ (SUM([gbv_eur_prev])/SUM([orders_prev])))) * 100' />
      </column>
      <column caption='VFI as % of Total Incentives' datatype='real' name='[Calculation_4503388531361595400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM([vendor_incentives])/(SUM([vendor_incentives])+SUM([dh_incentives]))) - &#10;(SUM([vendor_incentives_prev])/(SUM([vendor_incentives_prev])+SUM([dh_incentives_prev])))) * 100' />
      </column>
      <column caption='Rider CPO as % AOV' datatype='real' name='[Calculation_4503388531362025482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(((SUM([delivery_costs_eur])/SUM([orders])) / (SUM([gmv_eur])/SUM([orders]))) - &#10;((SUM([delivery_costs_eur_prev])/SUM([orders_prev])) / (SUM([gmv_eur_prev])/SUM([orders_prev])))) *100' />
      </column>
      <column caption='GPO' datatype='real' name='[Calculation_4503388531362496525]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS((SUM([gpo_eur])/SUM([orders]))) - ABS((SUM([gpo_eur_prev])/SUM([orders_prev])))' />
      </column>
      <column caption='FLGPO' datatype='real' name='[Calculation_4503388531362598926]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS((SUM([flgpo_eur])/SUM([orders]))) - ABS((SUM([flgpo_eur_prev])/SUM([orders_prev])))' />
      </column>
      <column caption='Benchmarking 2 Filter' datatype='string' name='[Calculation_4503388531367600143]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Cltv 10Year Parameter]' />
      </column>
      <column caption='AFV (EUR)' datatype='real' name='[Calculation_5561734474101157890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS((SUM([gbv_eur])/SUM([orders]))) - ABS((SUM([gbv_eur_prev])/SUM([orders_prev])))' />
      </column>
      <column caption='Total CPO as % AOV ' datatype='real' name='[Rider CPO as % AOV (copy) (copy)_4503388531362304012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(((SUM([total_costs_eur])/SUM([orders])) / (SUM([gmv_eur])/SUM([orders]))) - &#10;((SUM([total_costs_eur_prev])/SUM([orders_prev])) / (SUM([gmv_eur_prev])/SUM([orders_prev])))) * 100' />
      </column>
      <column caption='Payment CPO as % AOV ' datatype='real' name='[Rider CPO as % AOV (copy)_4503388531362291723]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(((SUM([payment_cost_eur])/SUM([orders])) / (SUM([gmv_eur])/SUM([orders]))) - &#10;((SUM([payment_cost_eur])/SUM([orders_prev])) / (SUM([gmv_eur_prev])/SUM([orders_prev])))) * 100' />
      </column>
