    <worksheet name='KPIs 3'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Performance Call October</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_performance_call' name='federated.1o39sqk195y5x71bd9y4d1gvvfkn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Report Month' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Show Last 6 Months&quot;'>
              <calculation class='tableau' formula='&quot;Show Last 6 Months&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='Today' datatype='date' name='[Calculation_1256222833217327105]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED 1: MAX([report_month])}' />
            </column>
            <column caption='Today - 6 months' datatype='datetime' name='[Calculation_1256222833217957890]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='dateadd(&apos;month&apos;,-6,[Calculation_1256222833217327105])' />
            </column>
            <column caption='Pickup Orders Share' datatype='real' default-format='p0.0%' name='[Calculation_2889129578628173831]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_pickup]) / SUM([orders])' />
            </column>
            <column caption='&quot;Choice&quot;' datatype='string' name='[Calculation_2889129578908639266]' role='dimension' type='nominal' user:unnamed='KPIs 3'>
              <calculation class='tableau' formula='&quot;Choice&quot;' />
            </column>
            <column caption='YoY Restaurants Online Food' datatype='real' default-format='p0%' name='[Calculation_4168011130370625538]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_online_food])/SUM([restaurants_online_food_yoy])-1' />
            </column>
            <column caption='New Restos / Restos Online' datatype='real' default-format='p0%' name='[Calculation_4168011130722177036]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_new_online_food])/SUM([restaurants_online_food])' />
            </column>
            <column caption='Show Last Month' datatype='boolean' name='[Calculation_4436890073515819018]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4]=&apos;Show Last 6 Months&apos; &#10;THEN ([report_month] &gt; [Calculation_1256222833217957890] AND [report_month] &lt;= [Calculation_1256222833217327105])&#10;&#10;&#10;ELSEIF  [Parameters].[Parameter 4] = &apos;Show All&apos; THEN [report_month]&lt;=[Calculation_1256222833217327105]&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Show Last 3 Months&apos; &#10;THEN ([report_month] &gt; [Today - 6 months (copy)_924223132951281664] AND [report_month] &lt;= [Calculation_1256222833217327105])&#10;&#10;&#10;END' />
            </column>
            <column caption='Rating GFS Above 4 Share' datatype='real' default-format='p0.0%' name='[Calculation_5552023601086197829]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rating_gfs_above_4_vendor_share])/SUM([restaurants_online_gfs])' />
            </column>
            <column caption='OD Restaurants Online' datatype='integer' name='[Calculation_618682004337061888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(restaurants_online_od)' />
            </column>
            <column caption='YoY Res Online' datatype='real' default-format='p0.0%' name='[Calculation_6734148143359873108]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([restaurants_online]) / sum([restaurants_online_yoy]) -1' />
            </column>
            <column caption='Restaurants Online MP' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_717409348940955649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_online_mp])' />
            </column>
            <column caption='YoY Res Online MP' datatype='real' default-format='p0.0%' name='[Calculation_727190604387561478]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_717409348940955649] / SUM([restaurants_online_mp_yoy]) - 1' />
            </column>
            <column caption='OD Restaurants Online YoY' datatype='integer' name='[OD Restaurants Online (copy)_618682004339654658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(restaurants_online_od_yoy)' />
            </column>
            <column caption='Order Share Top 10 Food Share' datatype='real' default-format='p0.0%' name='[Order Share Top 10 (copy)_1456351588664115215]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([top_10_successful_orders_food]) / sum([successful_orders_food])' />
            </column>
            <column caption='Orders Per Restaurant Food' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Orders Per Restaurant (copy)_1456351588665651218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_orders_food]) / sum([restaurants_online_food])' />
            </column>
            <column caption='placeholder' datatype='integer' default-format='*#,#' name='[Reorder Rate 1 Month (copy) (copy)_6175631400269967390]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Restaurants Net Development Food' datatype='integer' name='[Restaurants Net Development (copy)_1456351588662341638]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([restaurants_new_online_food]) + sum([restaurants_recovered_churn_food]) - sum([restaurants_churned_food])' />
            </column>
            <column caption='Today - 3 months ' datatype='datetime' name='[Today - 6 months (copy)_924223132951281664]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='dateadd(&apos;month&apos;,-3,[Calculation_1256222833217327105])' />
            </column>
            <column caption='YoY OD Restaurants Online' datatype='real' default-format='p0.0%' name='[YoY Restaurant Online Dh (copy)_618682004338962433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_618682004337061888] / [OD Restaurants Online (copy)_618682004339654658] - 1' />
            </column>
            <column caption='YoY Restaurants Online Food OD' datatype='real' default-format='p0%' name='[YoY Restaurants Online Food (copy)_1456351588708372510]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_online_food_od])/SUM([restaurants_online_food_od_yoy])-1' />
            </column>
            <column caption='YoY Restaurants Online Food MP' datatype='real' default-format='p0%' name='[YoY Restaurants Online Food OD (copy)_1456351588708515871]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([restaurants_online_food_mp])/SUM([restaurants_online_food_mp_yoy])-1' />
            </column>
