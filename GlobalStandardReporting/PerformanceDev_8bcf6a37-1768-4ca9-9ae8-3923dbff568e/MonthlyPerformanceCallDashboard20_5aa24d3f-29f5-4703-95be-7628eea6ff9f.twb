          <datasources>
            <datasource caption='BigQuery' name='federated.1nobfm00uv50sc13lsr2b1gd6xv6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Benchmark 2 KPI Selector' datatype='string' name='[Cltv 10Year Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Acq as \% of active customers&quot;'>
              <calculation class='tableau' formula='&quot;Acq as % of active customers&quot;' />
              <aliases>
                <alias key='&quot;Frequency YoY growth&quot;' value='Frequency' />
                <alias key='&quot;VFI as \% of total incentivesR&quot;' value='VFI as % of total incentives' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1nobfm00uv50sc13lsr2b1gd6xv6'>
            <column caption='DF as % AFV' datatype='real' name='[Calculation_4503388531361353735]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(((SUM([delivery_fee_eur])/SUM([orders]))/ (SUM([gbv_eur])/SUM([orders]))) - ((SUM([delivery_fee_eur_prev])/SUM([orders_prev]))/ (SUM([gbv_eur_prev])/SUM([orders_prev])))) * 100' />
            </column>
            <column caption='Benchmarking 2 Filter' datatype='string' name='[Calculation_4503388531367600143]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Cltv 10Year Parameter]' />
            </column>
            <column caption='Country Name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Delivery Fee Eur' datatype='real' name='[delivery_fee_eur]' role='measure' type='quantitative' />
            <column caption='Delivery Fee Eur Prev' datatype='real' name='[delivery_fee_eur_prev]' role='measure' type='quantitative' />
            <column datatype='real' name='[gbv_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[gbv_eur_prev]' role='measure' type='quantitative' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
