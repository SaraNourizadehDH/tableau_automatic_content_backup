            <column caption='ABV YoY Dmarts' datatype='real' default-format='p0.0%' name='[ABV MoM (copy)_6175631400285311050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gbv_eur_dmarts])/SUM(successful_orders_dmarts)) / (SUM([gbv_eur_dmarts_yoy])/SUM(successful_orders_dmarts_yoy)) -1' />
