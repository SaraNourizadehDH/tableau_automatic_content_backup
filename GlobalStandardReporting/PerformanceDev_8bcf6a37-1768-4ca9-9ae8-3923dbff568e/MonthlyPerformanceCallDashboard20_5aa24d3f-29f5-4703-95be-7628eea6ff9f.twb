            <column caption='Orders Delayed &gt; 45m MoM ' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Orders Delayed &gt; 10m MoM (copy)_1456351588991729726]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Orders Delayed &gt; 10m (copy)_1456351588991729725]*100) - (SUM(is_delivery_delay_late_45_mins_mom) / SUM([total_orders_log_mom])*100)' />
