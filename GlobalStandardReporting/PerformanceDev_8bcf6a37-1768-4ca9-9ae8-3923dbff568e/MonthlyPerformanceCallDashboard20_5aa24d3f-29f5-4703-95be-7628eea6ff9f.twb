    <worksheet name='ALL YoY'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_performance_call' name='federated.1o39sqk195y5x71bd9y4d1gvvfkn' />
          </datasources>
          <datasource-dependencies datasource='federated.1o39sqk195y5x71bd9y4d1gvvfkn'>
            <column caption='ABV YoY Dmarts' datatype='real' default-format='p0.0%' name='[ABV MoM (copy)_6175631400285311050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([gbv_eur_dmarts])/SUM(successful_orders_dmarts)) / (SUM([gbv_eur_dmarts_yoy])/SUM(successful_orders_dmarts_yoy)) -1' />
            </column>
            <column caption='Avg DF/AFV YoY - OD' datatype='real' default-format='n#,##0.0&quot;pp&quot;;-#,##0.0&quot;pp&quot;' name='[Avg DF/AFV MoM (copy)_6343601566267678725]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6343601566266662914] *100)&#10;- &#10;&#10;(((SUM([amt_delivery_fee_eur_profit_yoy_od]) + SUM([service_fee_eur_profit_od_yoy]))/ (SUM([gfv_eur_profit_od_yoy]) ))*100)' />
            </column>
            <column caption='Avg DT YOY' datatype='real' name='[Avg DT MOM (copy)_6479624335829856257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(sum_delivery_time_in_mins_yoy) / SUM([total_orders_log_yoy])' />
            </column>
            <column caption='Brand Preference YoY' datatype='real' name='[Brand Preference MoM (copy)_2889129578624757761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG([brand_preference]) - AVG([brand_preference_yoy])) * 100' />
            </column>
            <column caption='CARC YOY' datatype='real' default-format='p0.0%' name='[CARC MOM (copy)_1395834461066665989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1395834461065924611] / (-1 * SUM([lucc_carc_eur_yoy])) -1' />
            </column>
            <column caption='blank' datatype='real' name='[Calculation_1108518874172026880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(NULL)' />
            </column>
            <column caption='CARC' datatype='real' name='[Calculation_1395834461065924611]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-1 * SUM([lucc_carc_eur])' />
            </column>
            <column caption='Logistics Index' datatype='real' name='[Calculation_1456351588992905283]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143393374331] /[Calculation_3478397397341298689]' />
            </column>
            <column caption='Frequency' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1602014871802343424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders])/SUM([active_customers])' />
            </column>
            <column caption='&quot;Growing&quot;' datatype='string' name='[Calculation_1602014871803613187]' role='dimension' type='nominal' user:unnamed='Growing'>
              <calculation class='tableau' formula='&quot;Growing&quot;' />
            </column>
            <column caption='NPS AO Food' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1602014871812845574]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ao_nps_promoters_food])-SUM([ao_nps_detractors_food])) / SUM([ao_nps_responses_food])*100' />
            </column>
            <column caption='dmarts orders share' datatype='real' default-format='p0.0%' name='[Calculation_1602014871821447181]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(successful_orders_dmarts)/SUM([orders])' />
            </column>
            <column caption='LS order share' datatype='real' default-format='p0.0%' name='[Calculation_1602014871822528527]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders_ls])/SUM([orders])' />
            </column>
            <column caption='QC Orders Share' datatype='real' default-format='p0.0%' name='[Calculation_2593510442291662850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(successful_orders_qc)/SUM([orders])' />
            </column>
            <column caption='AOV profitability' datatype='real' name='[Calculation_2889129578632097802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([amt_gmv_eur_profit])/SUM([orders_succ_profit])' />
            </column>
            <column caption='UTR Exact' datatype='real' name='[Calculation_3478397397341298689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders_delivered]) / sum([rider_hours])' />
            </column>
            <column caption='YoY UTR Exact' datatype='real' default-format='p0.0%' name='[Calculation_3478397397342019587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3478397397341298689] / (sum([orders_delivered_yoy]) / sum([rider_hours_yoy])) - 1' />
            </column>
            <column caption='Retention 1 Month' datatype='real' default-format='p0.0%' name='[Calculation_3704844076316794883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([c1_users]) / sum([c1_acquisitions])' />
            </column>
            <column caption='diff reorder rate 1m' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Calculation_4099471936256364544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3704844076316794883]*100 - [Calculation_6850889832204816384]*100' />
            </column>
            <column caption='YoY Frequency' datatype='real' default-format='p0.0%' name='[Calculation_4168011130366849025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1602014871802343424]/[Frequency Last Month (copy)_6175631400272388130] - 1' />
            </column>
            <column caption='Take Rate (EUR)' datatype='real' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[Calculation_6175631400253345801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(take_in_cpo_eur)' />
            </column>
            <column caption='Total CPO (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6175631400257261585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_cpo_eur]) / SUM([orders_succ_profit])' />
            </column>
            <column caption='QC Customer Share' datatype='real' default-format='p0.0%' name='[Calculation_6340505378463969281]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([active_customers_qc]) / SUM([active_customers])' />
            </column>
            <column caption='Avg DF/AFV Inc SF - OD' datatype='real' default-format='p0.0%' name='[Calculation_6343601566266662914]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([amt_delivery_fee_eur_profit_od]) + SUM([service_fee_eur_profit_od]))/ (SUM([gfv_eur_profit_od]) )' />
            </column>
            <column caption='OD Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143298539523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_orders_od]) / sum([orders])' />
            </column>
            <column caption='OD Share YoY' datatype='real' name='[Calculation_6734148143299194885]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([successful_orders_od_yoy]) / sum([orders_yoy])' />
            </column>
            <column caption='YoY OD Share' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Calculation_6734148143299448839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6734148143298539523]*100) - ([Calculation_6734148143299194885]*100)' />
            </column>
            <column caption='YoY GMV' datatype='real' default-format='p0.00%' name='[Calculation_6734148143304790034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_eur]) / sum([gmv_eur_yoy]) - 1' />
            </column>
            <column caption='AOV (EUR)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143334748190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gmv_eur]) / sum([orders])' />
            </column>
            <column caption='Avg Delivery Fee (EUR) inc. SF - OD' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143335637023]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([amt_delivery_fee_eur_profit_od]) + SUM([service_fee_eur_profit_od])) / sum([orders_succ_profit_od])' />
            </column>
            <column caption='YoY AOV' datatype='real' default-format='p0.0%' name='[Calculation_6734148143337496613]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143334748190] / (sum([gmv_eur_yoy]) / sum([orders_yoy])) - 1' />
            </column>
            <column caption='Activity Rate' datatype='real' default-format='p0.00%' name='[Calculation_6734148143340744744]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([active_customers]) / sum([customer_base])' />
            </column>
            <column caption='Hard Fail Rate' datatype='real' default-format='p0.0%' name='[Calculation_6734148143378624614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([failed_orders]) / (sum([orders])+sum([failed_orders]))' />
            </column>
            <column caption='Avg Delivery Time' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143393374331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(sum_delivery_time_in_mins) / SUM([count_delivery_time])' />
            </column>
            <column caption='Delay Over 10 Share' datatype='real' default-format='p0.0%' name='[Calculation_6734148143398027391]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([is_delivery_delay_late_10_mins]) / SUM([total_orders_log])' />
            </column>
            <column caption='YoY Delay over 10 Share' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Calculation_6734148143400542337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6734148143398027391]*100) - (sum([is_delivery_delay_late_10_mins_yoy]) / sum([total_orders_log_yoy])*100)' />
            </column>
            <column caption='YoY Sessions' datatype='real' default-format='p0.0%' name='[Calculation_6734148143402225798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_76631562431836175] / sum([sessions_yoy]) - 1' />
            </column>
            <column caption='CVR Total' datatype='real' default-format='p0.00%' name='[Calculation_6734148143630839943]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_76631562432221200] / [Calculation_76631562431836175]' />
            </column>
            <column caption='NPS AO' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_6734148143635775639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( sum([ao_nps_promoters]) - sum([ao_nps_detractors]) ) / sum([ao_nps_responses]) * 100' />
            </column>
            <column caption='YoY Orders' datatype='real' default-format='p0.0%' name='[Calculation_6734148143646089383]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders] ) / sum([orders_yoy]) - 1' />
            </column>
            <column caption='YoY Acquisitions' datatype='real' default-format='p0.0%' name='[Calculation_6734148143650046122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([acquisitions]) / sum([acquisitions_yoy]) - 1' />
            </column>
            <column caption='YoY Active Customers' datatype='real' default-format='p0.0%' name='[Calculation_6734148143650435244]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([active_customers]) / sum([active_customers_yoy]) - 1' />
            </column>
            <column caption='YoY Hard Fail Rate' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Calculation_6734148143660953784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6734148143378624614]*100) - (sum([failed_orders_yoy]) / (sum([orders_yoy])+sum([failed_orders_yoy]))*100)' />
            </column>
            <column caption='YoY Avg Delivery Time' datatype='real' default-format='p0.0%' name='[Calculation_6734148143662792890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143393374331] / (sum([sum_delivery_time_in_mins_yoy]) / sum([count_delivery_time_yoy])) -1' />
            </column>
            <column caption='YoY Activity Rate' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[Calculation_6734148143669178559]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6734148143340744744]*100) - (sum([active_customers_yoy])/sum([customer_base_yoy])*100)' />
            </column>
            <column caption='YoY Avg Delivery Fee' datatype='real' default-format='p0.0%' name='[Calculation_6734148143678001345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6734148143335637023] / ((sum([amt_delivery_fee_eur_profit_yoy_od]) + sum([service_fee_eur_profit_od_yoy])) / sum([orders_succ_profit_yoy_od])) - 1' />
