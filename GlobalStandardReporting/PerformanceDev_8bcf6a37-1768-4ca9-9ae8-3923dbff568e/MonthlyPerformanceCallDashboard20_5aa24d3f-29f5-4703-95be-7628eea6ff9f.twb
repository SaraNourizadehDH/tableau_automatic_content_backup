              <calculation class='tableau' formula='{ FIXED 1: MAX([report_month])}' />
            </column>
            <column caption='Today - 6 months' datatype='datetime' name='[Calculation_1256222833217957890]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='dateadd(&apos;month&apos;,-6,[Calculation_1256222833217327105])' />
            </column>
            <column caption='NPS AO Food' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_1602014871812845574]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([ao_nps_promoters_food])-SUM([ao_nps_detractors_food])) / SUM([ao_nps_responses_food])*100' />
            </column>
            <column caption='&quot;Caring&quot;' datatype='string' name='[Calculation_2889129578911608870]' role='dimension' type='nominal' user:unnamed='KPIs 9'>
              <calculation class='tableau' formula='&quot;Caring&quot;' />
            </column>
            <column caption='Show Last Month' datatype='boolean' name='[Calculation_4436890073515819018]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4]=&apos;Show Last 6 Months&apos; &#10;THEN ([report_month] &gt; [Calculation_1256222833217957890] AND [report_month] &lt;= [Calculation_1256222833217327105])&#10;&#10;&#10;ELSEIF  [Parameters].[Parameter 4] = &apos;Show All&apos; THEN [report_month]&lt;=[Calculation_1256222833217327105]&#10;&#10;&#10;ELSEIF [Parameters].[Parameter 4]=&apos;Show Last 3 Months&apos; &#10;THEN ([report_month] &gt; [Today - 6 months (copy)_924223132951281664] AND [report_month] &lt;= [Calculation_1256222833217327105])&#10;&#10;&#10;END' />
            </column>
            <column caption='NPS AO' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_6734148143635775639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( sum([ao_nps_promoters]) - sum([ao_nps_detractors]) ) / sum([ao_nps_responses]) * 100' />
            </column>
            <column caption='NPS AC' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_6734148143636480152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([nps_ac_promoters]) - sum([nps_ac_detractors])) / sum([nps_ac_responses]) * 100' />
            </column>
            <column caption='OD NPS AO' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[MP NPS AO  (copy)_1465077261703487497]' role='measure' type='quantitative'>
