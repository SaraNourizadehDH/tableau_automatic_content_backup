            <column caption='Report Month' datatype='date' default-format='*MMM-YY' name='[report_month]' role='dimension' type='ordinal' />
            <column datatype='real' name='[restaurants_active_ls]' role='measure' type='quantitative' />
            <column datatype='real' name='[restaurants_new_online_dmart]' role='measure' type='quantitative' />
