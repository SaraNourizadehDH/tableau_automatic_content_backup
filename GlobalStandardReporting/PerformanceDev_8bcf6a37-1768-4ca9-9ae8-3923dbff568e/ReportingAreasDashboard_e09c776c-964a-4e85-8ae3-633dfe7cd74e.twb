            </column>
            <column caption='Unique Area Id' datatype='string' name='[Calculation_4483826029350322177]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[global_entity_id]+IFNULL([reporting_area_id], &apos;Null&apos;)' />
            </column>
            <column caption='fail rate' datatype='real' default-format='p0.0%' name='[Calculation_4483826029352075266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])/(SUM([failed_orders]) + SUM([successful_orders]))' />
