          <datasource-dependencies datasource='federated.1wh5r9m1esot7y1esvbtb034wwd7'>
            <column caption='% Has Reporting Area (Local Shops)' datatype='real' default-format='p0.0%' name='[% Has Reporting Area (Dmarts) (copy)_4483826029362999305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF NOT ISNULL([reporting_area_id]) THEN [vendors_online_local_shops] END)&#10;/&#10;SUM([vendors_online_local_shops])' />
            </column>
            <column caption='Vendors Without Areas' datatype='integer' name='[% Has Reporting Area (copy)_4483826029361602566]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF ISNULL([reporting_area_id]) THEN [vendors_online] END)' />
            </column>
            <column caption='% Has Reporting Area (Dmarts)' datatype='real' default-format='p0.0%' name='[% Has Reporting Area (copy)_4483826029362843656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF NOT ISNULL([reporting_area_id]) THEN [vendor_online_dmarts] END)&#10;/&#10;SUM([vendor_online_dmarts])' />
            </column>
            <column caption='% of orders per reporting Area' datatype='real' default-format='p0.0%' name='[% of GMV per reporting Area (copy)_4483826029751009295]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([successful_orders]) / SUM({FIXED [global_entity_id] : SUM([successful_orders])})' />
            </column>
            <column caption='attr' datatype='integer' name='[Calculation_126663759378698240]' role='measure' type='quantitative'>
