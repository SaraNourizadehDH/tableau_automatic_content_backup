    <worksheet name='top200byorder'>
      <layout-options>
        <title>
          <formatted-text>
            <run># of Customers by Brand x Months Since Last Order</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (adhoc)' name='federated.00x1tu41f1gu4x11j6r7h0lx4eyc' />
          </datasources>
          <datasource-dependencies datasource='federated.00x1tu41f1gu4x11j6r7h0lx4eyc'>
            <column aggregation='Sum' caption='Brand Order Contribution' datatype='real' name='[Calculation_22869843850084352]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[brand_successful_orders] / [total_successful_orders]' />
            </column>
            <column caption='% of Churn' datatype='real' name='[Calculation_22869843850846209]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[churn_customers] / {FIXED  [global_entity_id], [Months Since Last Order (copy)_4370743502611525632]: SUM([churn_customers])}' />
            </column>
            <column caption='Rating' datatype='real' default-format='p0.0%' name='[Calculation_3549610569135955969]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([converted_rating]) / SUM([total_orders_with_rating])' />
            </column>
            <column caption='ATTR1' datatype='integer' name='[Calculation_579979192097181697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='Index' datatype='integer' name='[Calculation_856317250543738880]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='% of Customers Ordered' datatype='real' default-format='p0.0%' name='[Calculation_856317250585042945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF(SUM([customers_engaged_platform]) &gt; 0, SUM([customers_engaged_brand]) / SUM([customers_engaged_platform]), NULL)' />
            </column>
            <column caption='% of Churn / % of Customers Ordered' datatype='real' name='[Calculation_856317250841251842]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_22869843850846209]) / ([Calculation_856317250585042945])' />
            </column>
            <column caption='Months Since Last Order (Buckets)' datatype='string' name='[Months Since Last Order (copy)_4370743502611525632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[months_since_last_order_buckets]' />
            </column>
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column aggregation='Sum' datatype='integer' name='[brand_order_contribution_rank]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[brand_successful_orders]' role='measure' type='quantitative' />
