      <column caption='% of Customers Ordered (copy)' datatype='real' default-format='p0.00%' name='[% of Customers Ordered (copy)_3549610569110728704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([customers_engaged_platform] &gt; 0, [customers_engaged_brand] / [customers_engaged_platform], NULL)' />
