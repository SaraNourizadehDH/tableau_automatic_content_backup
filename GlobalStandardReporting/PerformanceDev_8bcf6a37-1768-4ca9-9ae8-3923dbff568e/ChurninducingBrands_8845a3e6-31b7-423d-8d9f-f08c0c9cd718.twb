      </column>
      <column caption='% of Churn' datatype='real' name='[Calculation_22869843850846209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[churn_customers] / {FIXED  [global_entity_id], [Months Since Last Order (copy)_4370743502611525632]: SUM([churn_customers])}' />
      </column>
      <column caption='GEID,MSLO Churn' datatype='integer' name='[Calculation_22869843854356482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED  [global_entity_id], [Months Since Last Order (copy)_4370743502611525632]: SUM([churn_customers])}' />
