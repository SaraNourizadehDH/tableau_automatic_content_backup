              <calculation class='tableau' formula='AVG(&#10;IF [Calculation_1740430159354433536] = &apos;pct&apos; THEN &#10;    [Value (copy)_1562889816399269896] - [Value cluster avg (copy)_1562889816399765513]&#10;ELSE NULL&#10;END&#10;)*100' />
