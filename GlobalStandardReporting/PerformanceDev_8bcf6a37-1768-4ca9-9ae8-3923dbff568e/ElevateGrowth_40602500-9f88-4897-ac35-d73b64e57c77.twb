              <calculation class='tableau' formula='AVG(&#10;IF [Calculation_1740430159354433536] = &apos;abs&apos; AND [Report Month Actuals] THEN &#10;    [Value_static (Comparison) (copy)_105271658458472451]&#10;ELSE NULL&#10;END&#10;)' />
