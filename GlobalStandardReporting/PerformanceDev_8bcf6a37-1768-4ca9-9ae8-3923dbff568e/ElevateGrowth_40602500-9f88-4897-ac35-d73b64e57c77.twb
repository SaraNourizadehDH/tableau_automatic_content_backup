              <calculation class='tableau' formula='AVG(IF &#10;    [Calculation_1740430159354433536] = &apos;abs&apos; &#10;    THEN &#10;    [Value cluster avg (copy)_1562889816399765513]&#10;ELSE NULL&#10;END)' />
