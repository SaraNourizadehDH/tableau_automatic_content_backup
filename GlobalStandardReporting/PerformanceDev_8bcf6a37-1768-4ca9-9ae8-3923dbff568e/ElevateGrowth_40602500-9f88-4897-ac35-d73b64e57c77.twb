      <table>
        <view>
          <datasources>
            <datasource caption='elevate_kpis (cl_intl_markets)' name='federated.0nhasin0yvjnnj1evs54902qn7bn' />
          </datasources>
          <datasource-dependencies datasource='federated.0nhasin0yvjnnj1evs54902qn7bn'>
            <column caption='BIC vs Value  - pct' datatype='real' default-format='n#,##0&quot; pp&quot;;-#,##0&quot; pp&quot;' name='[BIC vs Value  - abs (copy)_6255851734859055140]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Best in Cluster (copy)_6255851734731124759] - [Value (copy)_6255851734724009984])*100' />
            </column>
            <column caption='Best in Cluster - abs' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Best in Cluster (copy) (copy)_6255851734731145240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#10;IF [Calculation_1740430159354433536] = &apos;abs&apos; THEN &#10;    IF [Calculation_1740430159355129857] = &apos;max&apos; THEN [Value (copy)_1562889816397103110]&#10;    ELSEIF [Calculation_1740430159355129857] =&apos;min&apos; THEN [Value -max in cluster (copy)_1562889816402735115]&#10;    ELSE NULL&#10;    END&#10;ELSE NULL&#10;END&#10;)' />
            </column>
            <column caption='Best in Cluster - pct' datatype='real' default-format='p0.0%' name='[Best in Cluster (copy)_6255851734731124759]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#10;IF [Calculation_1740430159354433536] = &apos;pct&apos; THEN &#10;    IF [Calculation_1740430159355129857] = &apos;max&apos; THEN [Value (copy)_1562889816397103110]&#10;    ELSEIF [Calculation_1740430159355129857] =&apos;min&apos; THEN [Value -max in cluster (copy)_1562889816402735115]&#10;    ELSE NULL&#10;    END&#10;ELSE NULL&#10;END&#10;)' />
            </column>
            <column caption='variable type_rank' datatype='integer' name='[Calculation_1562889816339324928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [metric_variable_type]&#10;WHEN &apos;Input variable&apos; THEN 2&#10;WHEN &apos;Output variable&apos; THEN 1&#10;ELSE 3&#10;END' />
            </column>
            <column caption='Value' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1562889816340148226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Value_static (Comparison) (copy)_105271658458472451])' />
            </column>
            <column caption='KPI - pct vs abs' datatype='string' name='[Calculation_1740430159354433536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LOWER([metric_pct_or_abs])' />
            </column>
            <column caption='KPI -  best min or max' datatype='string' name='[Calculation_1740430159355129857]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LOWER( [best_in_class_max_or_min] )' />
            </column>
            <column caption='has_bic' datatype='boolean' name='[Calculation_1740430159370211331]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE  [metric_title]&#10;WHEN &apos;Lunch time order %&apos; THEN  FALSE&#10;WHEN &apos;Dinner time order %&apos; THEN  FALSE&#10;WHEN &apos;Lunch vs dinner order ratio&apos; THEN  FALSE&#10;WHEN &apos;Weekday orders %&apos; THEN  FALSE&#10;WHEN &apos;Weekend orders %&apos; THEN  FALSE&#10;WHEN &apos;Weekday vs weekend order ratio&apos; THEN  FALSE&#10;ELSE TRUE      &#10;END' />
            </column>
            <column caption='BIC country name_2' datatype='string' name='[Calculation_1740430159375024136]' role='measure' type='nominal'>
              <calculation class='tableau' formula='MAX(CASE [Calculation_1740430159355129857]&#10;WHEN &apos;max&apos; THEN [max_bic_country_name]&#10;WHEN &apos;min&apos; THEN [min_bic_country_name]&#10;ELSE &apos;&apos;&#10;END)' />
            </column>
            <column caption='Stepped Coloring of Cluster Rank' datatype='integer' name='[Calculation_419256995638173696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_6255851734728310806] ) THEN -1&#10;ELSE&#10;INT([Calculation_6255851734728310806]*100/10)&#10;END' />
            </column>
            <column caption='Lever Rank' datatype='integer' name='[Calculation_5481232598533533696]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [metric_lever]&#10;WHEN &apos;Acquisitions&apos; THEN 0&#10;WHEN &apos;Churn&apos; THEN 1&#10;WHEN &apos;Reactivation&apos; THEN 2&#10;WHEN &apos;Basket Level Affordability&apos; THEN 3&#10;WHEN &apos;Customer Fee Affordability&apos; THEN 4&#10;WHEN &apos;Choice - quality restaurants&apos; THEN 5&#10;WHEN &apos;Quick-commerce&apos; THEN 6&#10;WHEN &apos;Occasions&apos; THEN 7&#10;&#10;WHEN &apos;OD %&apos; THEN 9&#10;WHEN &apos;App score&apos; THEN 10&#10;END' />
            </column>
            <column caption='Coloring: Cluster Rank' datatype='real' default-format='p0%' name='[Calculation_6255851734728310806]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  &#10;    //BIC = max values&#10;    MAX([Calculation_1740430159370211331]) AND MAX([Calculation_1740430159355129857]) =&apos;max&apos;&#10;THEN&#10;    IF &#10;        [Calculation_1562889816340148226] &lt; AVG([Cluster Max (copy)_1415115456055713792])&#10;        THEN 0&#10;    ELSEIF&#10;        [Calculation_1562889816340148226] &gt; AVG([Cluster_percentile_25 (copy)_1415115456083398658])&#10;        THEN 1&#10;    ELSE //Color coding only between .25 and .75 percentile. &#10;        ( [Calculation_1562889816340148226] - AVG([Cluster Max (copy)_1415115456055713792]) ) &#10;        / &#10;        (AVG([Cluster_percentile_25 (copy)_1415115456083398658]) - AVG([Cluster Max (copy)_1415115456055713792]) )    &#10;    END&#10;&#10;&#10;ELSEIF &#10;    //BIC = min values&#10;    MAX([Calculation_1740430159370211331]) AND MAX([Calculation_1740430159355129857]) =&apos;min&apos;&#10;THEN &#10;    IF &#10;        [Calculation_1562889816340148226] &lt; AVG([Cluster Max (copy)_1415115456055713792])&#10;        THEN 1&#10;    ELSEIF&#10;        [Calculation_1562889816340148226] &gt; AVG([Cluster_percentile_25 (copy)_1415115456083398658])&#10;        THEN 0&#10;    ELSE //Color coding only between .25 and .75 percentile. &#10;        1 -&#10;            ( &#10;             [Calculation_1562889816340148226] - AVG([Cluster Max (copy)_1415115456055713792]) &#10;             ) &#10;                / &#10;            (&#10;                AVG([Cluster_percentile_25 (copy)_1415115456083398658]) - AVG([Cluster Max (copy)_1415115456055713792]) &#10;             )    &#10;    END&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='ATTR(1)' datatype='integer' name='[Calculation_6255851734750130208]' role='measure' type='quantitative' user:unnamed='Cluster check (3)'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='ATTR(1)' datatype='integer' name='[Calculation_6255851734750150690]' role='measure' type='quantitative' user:unnamed='Cluster check (3)'>
              <calculation class='tableau' formula='ATTR(1)' />
