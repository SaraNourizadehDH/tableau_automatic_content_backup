            <column caption='Comparison Time Value vs Value  - abs' datatype='real' default-format='p0.0%' name='[BIC vs Value  - abs (copy)_1819595002340757511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Value - try -pct  (copy)_6255851734725029893]/ [Calculation_1819595002339733509]-1' />
            </column>
            <column caption='Comparison Time Value vs Value  - pct ' datatype='real' default-format='n#,##0.0&quot; pp&quot;;-#,##0.0&quot; pp&quot;' name='[BIC vs Value  - pct (copy)_1819595002340913160]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Value (copy)_6255851734724009984] - [Comparison Value - Abs (copy)_1819595002339901446])*100' />
            </column>
            <column caption='variable type_rank' datatype='integer' name='[Calculation_1562889816339324928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [metric_variable_type]&#10;WHEN &apos;Input variable&apos; THEN 2&#10;WHEN &apos;Output variable&apos; THEN 1&#10;ELSE 3&#10;END' />
            </column>
            <column caption='Value' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1562889816340148226]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Value_static (Comparison) (copy)_105271658458472451])' />
            </column>
            <column caption='KPI - pct vs abs' datatype='string' name='[Calculation_1740430159354433536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LOWER([metric_pct_or_abs])' />
            </column>
            <column caption='KPI -  best min or max' datatype='string' name='[Calculation_1740430159355129857]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LOWER( [best_in_class_max_or_min] )' />
            </column>
            <column caption='has_bic' datatype='boolean' name='[Calculation_1740430159370211331]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE  [metric_title]&#10;WHEN &apos;Lunch time order %&apos; THEN  FALSE&#10;WHEN &apos;Dinner time order %&apos; THEN  FALSE&#10;WHEN &apos;Lunch vs dinner order ratio&apos; THEN  FALSE&#10;WHEN &apos;Weekday orders %&apos; THEN  FALSE&#10;WHEN &apos;Weekend orders %&apos; THEN  FALSE&#10;WHEN &apos;Weekday vs weekend order ratio&apos; THEN  FALSE&#10;ELSE TRUE      &#10;END' />
            </column>
            <column caption='BIC country name_2' datatype='string' name='[Calculation_1740430159375024136]' role='measure' type='nominal'>
              <calculation class='tableau' formula='MAX(CASE [Calculation_1740430159355129857]&#10;WHEN &apos;max&apos; THEN [max_bic_country_name]&#10;WHEN &apos;min&apos; THEN [min_bic_country_name]&#10;ELSE &apos;&apos;&#10;END)' />
            </column>
            <column caption='Comparison Value' datatype='real' name='[Calculation_1819595002335842305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Value_static (copy)_105271658457784321])' />
            </column>
            <column caption='Comparison Value - Abs' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1819595002339733509]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#10;IF [Calculation_1740430159354433536] = &apos;abs&apos; AND [Report Month Set] THEN &#10;    [Value_static (copy)_105271658457784321]&#10;ELSE NULL&#10;END&#10;)' />
            </column>
            <column caption='Trend Direction (Positive/Negative)' datatype='string' name='[Calculation_1819595002341187593]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF MAX([Calculation_1740430159370211331]) THEN&#10;    IF ABS([Calculation_1562889816340148226]/[Calculation_1819595002335842305]-1) &gt;= 0.05 THEN //Minimum change should be 5% to have trend definition&#10;        IF MAX([Calculation_1740430159355129857]) = &quot;min&quot; THEN&#10;            IF [Calculation_1562889816340148226] &lt; [Calculation_1819595002335842305]  THEN &quot;Positive&quot;&#10;            ELSEIF [Calculation_1562889816340148226] &gt; [Calculation_1819595002335842305] THEN &quot;Negative&quot;&#10;            ELSE NULL END&#10;        ELSEIF MAX([Calculation_1740430159355129857]) = &quot;max&quot; THEN&#10;            IF [Calculation_1562889816340148226] &gt; [Calculation_1819595002335842305] THEN &quot;Positive&quot;&#10;            ELSEIF [Calculation_1562889816340148226] &lt; [Calculation_1819595002335842305] THEN &quot;Negative&quot;&#10;            ELSE NULL END&#10;        END&#10;    ELSE &quot;Stable&quot;&#10;    END&#10;ELSE NULL&#10;END' />
            </column>
