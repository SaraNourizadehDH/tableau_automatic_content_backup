              <calculation class='tableau' formula='{FIXED [country_cluster], [metric_name], [report_month] :  PERCENTILE([Value_static (Comparison) (copy)_105271658458472451], 0.75)&#10;}' />
            </column>
            <column caption='Comparison Value - Pct' datatype='real' default-format='p0.0%' name='[Comparison Value - Abs (copy)_1819595002339901446]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#10;IF [Calculation_1740430159354433536] = &apos;pct&apos; AND [Report Month Set] THEN &#10;    [Value_static (copy)_105271658457784321]&#10;ELSE NULL&#10;END&#10;)' />
