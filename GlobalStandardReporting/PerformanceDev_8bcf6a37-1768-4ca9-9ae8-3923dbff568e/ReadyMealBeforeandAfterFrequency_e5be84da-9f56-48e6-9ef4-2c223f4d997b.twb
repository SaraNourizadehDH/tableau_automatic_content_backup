      <column caption='Control Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_794603916416876544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([control_orders])/SUM([control_customers])' />
      </column>
      <column caption='RM Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_794603916416991233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([rm_orders])/SUM([rm_customers])' />
      </column>
      <column aggregation='Sum' caption='Period filter' datatype='integer' name='[Calculation_794603916419506178]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='ABS([period_rm_orders])' />
      </column>
      <column caption='Before/After first RMO' datatype='string' name='[Calculation_794603916421955587]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [period_rm_orders] &lt; 0 THEN &apos;Before&apos; ELSE &apos;After&apos; END' />
      </column>
