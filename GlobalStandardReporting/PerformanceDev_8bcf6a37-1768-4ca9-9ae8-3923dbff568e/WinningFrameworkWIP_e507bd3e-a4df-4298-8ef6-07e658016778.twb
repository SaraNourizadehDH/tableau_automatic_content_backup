              <calculation class='tableau' formula='[comp_common_city_n_of_vendors]/[total_vendors_comp]' />
            </column>
            <column caption='Vendors with item parity' datatype='integer' name='[Calculation_1786451358436474880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([federated.1uiybbs1kdbj241frbeaa14n9jqz].[n_vendors_with_different_items]))' />
            </column>
            <column caption='% Vendors with item parity' datatype='real' default-format='p0%' name='[Calculation_1786451358436896769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1786451358436474880]/SUM([n_of_common_vendors])' />
            </column>
            <column caption='% DH Common City Vendors over total DH Vendors' datatype='real' default-format='p0%' name='[Calculation_4489033346627878917]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[dh_common_city_n_of_vendors]/[total_vendors_dh]' />
            </column>
            <column caption='Field last 3 months' datatype='boolean' name='[Calculation_4489033346679836681]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_month], TODAY()) &lt;= 3 &#10;AND DATEPART(&apos;month&apos;, TODAY()) != DATEPART(&apos;month&apos;, [report_month])' />
            </column>
            <column caption='of common cities, # of vendors in DH but not in compn ' datatype='integer' name='[Calculation_746401319224729604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([dh_common_city_n_of_vendors] - [n_of_common_vendors]) &gt; 0 &#10;THEN [dh_common_city_n_of_vendors] - [n_of_common_vendors]&#10;ELSE 0 END' />
