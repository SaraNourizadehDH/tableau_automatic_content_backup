      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/WinningFrameworkWIP/CountryLevelView?rev=' id='CountryLevelView' path='/t/GlobalStandardReporting/workbooks/WinningFrameworkWIP' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-orientation' id='dash-text_31' value='-90' />
          <format attr='text-orientation' id='dash-text_32' value='-90' />
          <format attr='text-orientation' id='dash-text_33' value='-90' />
