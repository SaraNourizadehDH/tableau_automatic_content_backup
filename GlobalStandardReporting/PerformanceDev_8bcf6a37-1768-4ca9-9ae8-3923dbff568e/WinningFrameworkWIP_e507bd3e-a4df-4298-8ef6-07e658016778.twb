          <datasource-dependencies datasource='federated.1jjm14z1w7txxc1431k640655935'>
            <column caption='% Comp Common City Vendors over total Comp Vendors' datatype='real' default-format='p0%' name='[% DH Common City Vendors over total DH Vendors (copy)_5641954855495147526]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[comp_common_city_n_of_vendors]/[total_vendors_comp]' />
            </column>
            <column caption='Last 3 Months' datatype='boolean' name='[Calculation_5641954855490854914]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_month], TODAY()) &lt;= 3 &#10;AND DATEPART(&apos;month&apos;, TODAY()) != DATEPART(&apos;month&apos;, [report_month])' />
            </column>
            <column caption='% DH Common City Vendors over total DH Vendors' datatype='real' default-format='p0%' name='[Calculation_5641954855494938629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[dh_common_city_n_of_vendors]/[total_vendors_dh]' />
            </column>
            <column caption='% Comp Only Rating 4 5 Restaus' datatype='real' default-format='p0%' name='[Calculation_5641954855495634951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[comp_only_rating_4_5_restaus] / [common_cities_gap_to_competitor_n_of_vendors]' />
            </column>
            <column caption='of common cities, # of vendors in DH but not in Comp' datatype='integer' name='[Calculation_5641954855496085512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ([dh_common_city_n_of_vendors] - [n_of_common_vendors]) &gt; 0 &#10;THEN [dh_common_city_n_of_vendors] - [n_of_common_vendors]&#10;ELSE 0 END' />
            </column>
            <column caption='Vendors with item parity' datatype='integer' name='[Calculation_5641954855496466441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([federated.1uiybbs1kdbj241frbeaa14n9jqz].[n_vendors_with_different_items]))' />
            </column>
            <column caption='% Vendors swith item parity' datatype='real' default-format='p0%' name='[Calculation_5641954855496638475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5641954855496466441]/SUM([n_of_common_vendors])' />
