      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/WinningFrameworkWIP/APPENDIX?rev=' id='APPENDIX' path='/t/GlobalStandardReporting/workbooks/WinningFrameworkWIP' revision='' site='GlobalStandardReporting' />
      <style>
        <style-rule element='dash-text'>
          <format attr='text-orientation' id='dash-text_31' value='-90' />
