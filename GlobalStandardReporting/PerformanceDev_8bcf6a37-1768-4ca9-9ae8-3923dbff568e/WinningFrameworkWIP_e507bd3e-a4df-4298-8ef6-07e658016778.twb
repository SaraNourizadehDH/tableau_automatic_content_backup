        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_month], TODAY()) &lt;= 3 &#10;AND DATEPART(&apos;month&apos;, TODAY()) != DATEPART(&apos;month&apos;, [report_month])' />
