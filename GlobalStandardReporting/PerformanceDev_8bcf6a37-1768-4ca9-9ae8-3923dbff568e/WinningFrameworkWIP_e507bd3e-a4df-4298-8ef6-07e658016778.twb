    <worksheet name='Geolocation'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#d82128' fontname='Tableau Bold' fontsize='18'>GEOLOCATION</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='geolocation' name='federated.1soqx0d09vba56167p1j30in0pmz' />
            <datasource caption='Logistics' name='federated.1xkbt0i1uh7flu10wryqh17t87w5' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Approach' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Geolocation&quot;'>
              <calculation class='tableau' formula='&quot;Geolocation&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1soqx0d09vba56167p1j30in0pmz'>
            <column caption='CALC CITIES' datatype='real' default-format='n&quot;x &quot;#,##0.00;-&quot;x &quot;#,##0.00' name='[Calculation_2854367411973365760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([dh_n_of_cities]/[comp_n_of_cities])' />
            </column>
            <column caption='Common Cities Gmv Eur New' datatype='real' default-format='c&quot;€ &quot;#,##0,K;-&quot;€ &quot;#,##0,K' name='[Calculation_2854367411980234761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([common_cities_gmv_eur])=TRUE THEN [total_gmv_of_country] ELSE [common_cities_gmv_eur] END' />
            </column>
            <column caption='N of vendors in cities where DH does not operate' datatype='integer' name='[Calculation_3292201733257592832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_vendors_comp] - [comp_common_city_n_of_vendors]' />
            </column>
            <column caption='DH GMV Contribution from common cities' datatype='real' default-format='p0%' name='[Calculation_3292201733258616833]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2854367411980234761] / [total_gmv_of_country]' />
            </column>
            <column caption='blank1' datatype='real' datatype-customized='true' name='[Calculation_3292201733259313155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(NULL)' />
            </column>
            <column caption='DH of common cities % vendors of total vendors' datatype='real' default-format='p0%' name='[Calculation_3292201733262585862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[dh_common_city_n_of_vendors] / [total_vendors_dh]' />
            </column>
            <column caption='Comp of common cities % vendors of total vendors' datatype='real' default-format='p0%' name='[Calculation_3292201733262868487]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[comp_common_city_n_of_vendors] / [total_vendors_comp]' />
            </column>
            <column caption='N of cities where DH does not operate and comp does' datatype='integer' name='[Calculation_3292201733264343049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[comp_n_of_cities] - [n_of_common_cities]' />
            </column>
            <column caption='Of gap, % of 4/5 rating' datatype='real' default-format='p0%' name='[Calculation_3292201733265408010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[comp_only_rating_4_5_restaus]/[common_cities_gap_to_competitor_n_of_vendors]' />
            </column>
            <column caption='blank2' datatype='real' datatype-customized='true' name='[Calculation_3292201733266272267]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(NULL)' />
            </column>
            <column caption='Logistics True' datatype='boolean' name='[Calculation_3292201733292036119]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Logistics&apos; THEN TRUE ELSE FALSE END' />
            </column>
            <column caption='blank3' datatype='real' datatype-customized='true' name='[blank2 (copy)_2854367411977220097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(NULL)' />
            </column>
            <column caption='Gap To Competitor N Of Vendors' datatype='integer' name='[common_cities_gap_to_competitor_n_of_vendors]' role='measure' type='quantitative' />
            <column caption='Common Cities Gmv Eur' datatype='real' default-format='c&quot;€ &quot;#,##0,K;-&quot;€ &quot;#,##0,K' name='[common_cities_gmv_eur]' role='measure' type='quantitative' />
