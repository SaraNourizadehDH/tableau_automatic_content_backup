          </datasources>
          <datasource-dependencies datasource='federated.0f6t3l10t4lahr1881dhf0vax26e'>
            <column caption='Vendors with item parity' datatype='integer' name='[Calculation_1786451358436474880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([federated.1uiybbs1kdbj241frbeaa14n9jqz].[n_vendors_with_different_items]))' />
            </column>
            <column caption='% Vendors with item parity' datatype='real' default-format='p0%' name='[Calculation_1786451358436896769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1786451358436474880]/SUM([n_of_common_vendors])' />
            </column>
            <column-instance column='[Calculation_1786451358436896769]' derivation='User' name='[diff:usr:Calculation_1786451358436896769:qk]' pivot='key' type='quantitative'>
              <table-calc diff-options='Relative' ordering-type='Rows' type='Difference'>
                <address>
                  <value>-1</value>
                </address>
              </table-calc>
            </column-instance>
            <column caption='N Of Common Vendors' datatype='integer' name='[n_of_common_vendors]' role='measure' type='quantitative' />
            <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
            <column-instance column='[sub_entity]' derivation='None' name='[none:sub_entity:nk]' pivot='key' type='nominal' />
            <column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal' />
            <column caption='Sub Entity' datatype='string' name='[sub_entity]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1jjm14z1w7txxc1431k640655935'>
            <column caption='% Comp Common City Vendors over total Comp Vendors' datatype='real' default-format='p0%' name='[% DH Common City Vendors over total DH Vendors (copy)_5641954855495147526]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[comp_common_city_n_of_vendors]/[total_vendors_comp]' />
            </column>
            <column caption='Last 3 Months' datatype='boolean' name='[Calculation_5641954855490854914]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_month], TODAY()) &lt;= 3 &#10;AND DATEPART(&apos;month&apos;, TODAY()) != DATEPART(&apos;month&apos;, [report_month])' />
            </column>
            <column caption='Field last 2 months MoM' datatype='boolean' name='[Calculation_5641954855494369284]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_month], TODAY()) &lt;= 2&#10;AND DATEPART(&apos;month&apos;, TODAY()) != DATEPART(&apos;month&apos;, [report_month])' />
            </column>
            <column caption='% DH Common City Vendors over total DH Vendors' datatype='real' default-format='p0%' name='[Calculation_5641954855494938629]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[dh_common_city_n_of_vendors]/[total_vendors_dh]' />
            </column>
            <column caption='% Comp Only Rating 4 5 Restaus' datatype='real' default-format='p0%' name='[Calculation_5641954855495634951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[comp_only_rating_4_5_restaus] / [common_cities_gap_to_competitor_n_of_vendors]' />
