          <datasource-dependencies datasource='federated.0f6t3l10t4lahr1881dhf0vax26e'>
            <column caption='% GMV Share' datatype='real' default-format='p0.0%' name='[Calculation_1750844783811768334]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2694208164210040834]/[total_gmv_of_country]' />
            </column>
            <column caption='Common Cities GMV Eur Fix' datatype='real' default-format='c&quot;€ &quot;#,##0,K;-&quot;€ &quot;#,##0,K' name='[Calculation_2694208164210040834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([common_cities_gmv_eur],[total_gmv_of_country])' />
            </column>
            <column caption='blank1' datatype='real' name='[Calculation_4489033346620727296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(NULL)' />
            </column>
            <column caption='Field last 3 months' datatype='boolean' name='[Calculation_4489033346679836681]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [report_month], TODAY()) &lt;= 3 &#10;AND DATEPART(&apos;month&apos;, TODAY()) != DATEPART(&apos;month&apos;, [report_month])' />
            </column>
            <column caption='blank2' datatype='real' name='[blank1 (copy)_4489033346623721475]' role='measure' type='quantitative'>
