      <column caption='CALC CITIES' datatype='real' default-format='n&quot;x &quot;#,##0.00;-&quot;x &quot;#,##0.00' name='[Calculation_2854367411978227714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([dh_n_of_cities] / [comp_n_of_cities])' />
      </column>
      <column caption='Common Cities Gmv Eur New' datatype='real' default-format='c&quot;€ &quot;#,##0,K;-&quot;€ &quot;#,##0,K' name='[Calculation_2854367411978924037]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([common_cities_gmv_eur]) = TRUE THEN [total_gmv_of_country] ELSE [common_cities_gmv_eur] END' />
      </column>
      <column caption='N of cities where DH does not operate and comp does' datatype='integer' name='[Calculation_3292201733282398220]' role='measure' type='quantitative'>
