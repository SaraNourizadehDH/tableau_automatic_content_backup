        </style-rule>
      </style>
      <size maxheight='900' maxwidth='1900' minheight='800' minwidth='1520' sizing-mode='range' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98222' id='142' param='horz' type-v2='layout-flow' w='99158' x='421' y='889'>
            <zone h='98222' id='29' type-v2='layout-basic' w='99158' x='421' y='889'>
              <zone forceUpdate='true' h='8887' id='3' type-v2='text' w='81612' x='7540' y='889'>
                <formatted-text>
                  <run fontcolor='#ffffff' fontname='Tableau Bold' fontsize='14'>WINNING FRAMEWORK  |  APPENDIX</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='0' />
                  <format attr='background-color' value='#d61f26' />
                </zone-style>
              </zone>
              <zone h='8887' id='6' is-scaled='1' param='Image/Delivery-Hero-Logo.png' type-v2='bitmap' w='7119' x='421' y='889'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='0' />
                  <format attr='background-color' value='#d61f26' />
                </zone-style>
              </zone>
              <zone h='8887' id='109' type-v2='text' w='10427' x='89152' y='889'>
                <formatted-text>
                  <run fontcolor='#ffffff' fontname='Tableau Bold' italic='true'>Ask us anything on Slack: #data-hub-intl-markets</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='0' />
                  <format attr='background-color' value='#d82128' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='89335' id='115' type-v2='text' w='99158' x='421' y='9776'>
                <formatted-text>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Winning Framework</run>
                  <run fontcolor='#000000' fontsize='10'> presents different diverse metrics, comparing to the performance of competitors,  for each entity on a monthly basis.</run>
                  <run>Æ&#10;&#10;</run>
                  <run fontcolor='#000000' fontsize='10'>The report counts with </run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>two main tabs</run>
                  <run fontcolor='#000000' fontsize='10'> as listed below:</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>(1) </run>
                  <run bold='true' fontcolor='#000000' fontsize='10' underline='true'>Main Monthly:</run>
                  <run fontcolor='#000000' fontsize='10'> Entity level view for different metrics based on the following topics: </run>
                  <run fontcolor='#000000' fontsize='10' italic='true'>orders performance, affordability, delivery and quallity support</run>
                  <run fontcolor='#000000' fontsize='10'>. </run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>(2) </run>
                  <run bold='true' fontcolor='#000000' fontsize='10' underline='true'>City Breakdown:</run>
                  <run fontcolor='#000000' fontsize='10'> WIP</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#d61f26' fontsize='10'>_______________________________________________________________________________________________________________________________________________________</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#ffffff' fontsize='6'>g</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#d61f26' fontsize='16'>Æ                                                                                                           </run>
                  <run bold='true' fontcolor='#ffffff' fontsize='16'>K</run>
                  <run bold='true' fontcolor='#d61f26' fontsize='16'>        METRICS</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#d61f26' fontsize='10'>_______________________________________________________________________________________________________________________________________________________</run>
                  <run>Æ&#10;&#10;&#10;</run>
                  <run bold='true' fontcolor='#d61f26' fontsize='12' underline='true'>GEOGRAPHICAL COVERAGE </run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#d61f26' fontsize='10'>1. % Avg D+S Fee / AFV</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Definition:</run>
                  <run fontcolor='#000000' fontsize='10'>  Avg percentage of Delivery&amp;Service Fee over average food value (AFV).</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Data Source:</run>
                  <run fontcolor='#000000' fontsize='10'> Central DWH</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Comments: </run>
                  <run fontcolor='#000000' fontsize='10'>This metric has been calculated considering successful orders only.</run>
                  <run>Æ&#10;&#10;&#10;</run>
                  <run bold='true' fontcolor='#d61f26' fontsize='12' underline='true'>CHOICE COVERAGE</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#d61f26' fontsize='10'>13. % Orders Below 3 out of 5 Rating</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Definition:</run>
                  <run fontcolor='#000000' fontsize='10'>  Successful orders below 3 out of 5 ranking / Successful orders</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Data Source:</run>
                  <run fontcolor='#000000' fontsize='10'> CDHW - </run>
                  <run fontcolor='#000000' fontsize='10' italic='true'>ratings</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Comments: </run>
                  <run fontcolor='#000000' fontsize='10'>Converted rating 0.6 (normalized 0 to 1).</run>
                  <run>Æ&#10;&#10;&#10;</run>
                  <run bold='true' fontcolor='#d61f26' fontsize='12' underline='true'>MARK-UPS</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#d61f26' fontsize='10'>19. Total Vendors</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Definition:</run>
                  <run fontcolor='#000000' fontsize='10'>  Total Vendors online in the platform</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Data Source:</run>
                  <run fontcolor='#000000' fontsize='10'> CDHW - </run>
                  <run fontcolor='#000000' fontsize='10' italic='true'>Agg_vendors_kpi_monthly</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Comments: -</run>
                  <run>Æ&#10;&#10;&#10;</run>
                  <run bold='true' fontcolor='#d61f26' fontsize='12' underline='true'>PREFERENCE</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#d61f26' fontsize='10'>22. % Restos Zombies</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Definition:</run>
                  <run fontcolor='#000000' fontsize='10'>  # Restos Zombies /  # Restos</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Data Source:</run>
                  <run fontcolor='#000000' fontsize='10'> CDHW - </run>
                  <run fontcolor='#000000' fontsize='10' italic='true'>Agg_vendors_kpi_monthly</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#000000' fontsize='10'>Comments: </run>
                  <run fontcolor='#000000' fontsize='10'>Restaurants online with no orders (zombies)</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
