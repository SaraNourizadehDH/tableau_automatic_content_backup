                <zone h='12333' id='637' type-v2='text' w='45668' x='48234' y='83222'>
                  <formatted-text>
                    <run bold='true' fontcolor='#e00012' fontsize='8'>Automatic BEs</run>
                    <run fontsize='8'> represent </run>
                    <run bold='true' fontsize='8'>BE -2 months</run>
                    <run fontsize='8'> before the RR date. </run>
                    <run>Æ&#10;</run>
                    <run fontsize='8'>On the 25th of each month,  BEs change to BE -1 month before the RR date.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='8'>RR Date : 24-Nov-22 ----&gt; BE09-22            RR Date : 25-Nov-22 ----&gt; BE10-22</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontsize='8'>*If you don&apos;t see any data, you can select the lates BE from BE Selection. There might be delays in the pipeline.</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone h='3556' id='587' type-v2='text' w='98888' x='556' y='95555'>
                  <formatted-text>
                    <run fontcolor='#555555' fontsize='8'>*Latest BE will automatically update when it is pushed through the pipeline.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
