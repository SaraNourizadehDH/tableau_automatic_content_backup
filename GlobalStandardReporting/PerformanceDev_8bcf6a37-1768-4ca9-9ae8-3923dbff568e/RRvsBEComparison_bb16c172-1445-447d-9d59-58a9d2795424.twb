                    <formatted-text>
                      <run fontcolor='#1d1c1d' fontname='Tableau Bold'>It shows the </run>
                      <run fontcolor='#ca031e' fontname='Tableau Bold'>average</run>
                      <run fontcolor='#1d1c1d' fontname='Tableau Bold'> absolute error of historic RR&apos;s per day of the month.</run>
