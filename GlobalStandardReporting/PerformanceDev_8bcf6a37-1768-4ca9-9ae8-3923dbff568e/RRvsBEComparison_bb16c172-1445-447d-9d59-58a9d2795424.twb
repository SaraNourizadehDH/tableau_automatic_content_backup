            <column-instance column='[Calculation_569705394148429831]' derivation='None' name='[none:Calculation_569705394148429831:nk]' pivot='key' type='nominal' />
            <column-instance column='[RR Date for Actuals (copy)_192528923233714182]' derivation='None' name='[none:RR Date for Actuals (copy)_192528923233714182:ok]' pivot='key' type='ordinal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
