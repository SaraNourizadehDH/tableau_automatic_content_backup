            <column datatype='real' name='[gmv_eur_rr]' role='measure' type='quantitative' />
            <column caption='RR Date' datatype='date' default-format='*DD-MMM-YY' name='[insert_date]' role='dimension' type='ordinal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_134193230810370048]' derivation='None' name='[none:Calculation_134193230810370048:nk]' pivot='key' type='nominal' />
