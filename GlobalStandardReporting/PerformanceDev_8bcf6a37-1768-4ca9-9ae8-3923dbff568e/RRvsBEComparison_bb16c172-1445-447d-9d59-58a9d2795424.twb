      <datasource-dependencies datasource='federated.15ddb0w0za99081dsoic70kviopl'>
        <column caption='RR Date for Actuals' datatype='date' default-format='*DD-MMM-YY' name='[Calculation_192528923224834052]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='IF YEAR([insert_date]) * 100 + MONTH([insert_date]) &lt; &#10;YEAR(NOW()) * 100 + MONTH(NOW()) THEN [insert_date] END' />
        </column>
        <column caption='Segment ' datatype='string' name='[Calculation_569705394148429831]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IF global_entity_id = &apos;BM_KR&apos; OR global_entity_id = &apos;BM_VN&apos; &#10;THEN [management_entity] &#10;ELSEIF [segment] = &apos;Asia&apos; THEN &apos;APAC&apos;&#10;ELSE [segment] END' />
        </column>
        <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
        <column-instance column='[Calculation_192528923224834052]' derivation='None' name='[none:Calculation_192528923224834052:ok]' pivot='key' type='ordinal' />
