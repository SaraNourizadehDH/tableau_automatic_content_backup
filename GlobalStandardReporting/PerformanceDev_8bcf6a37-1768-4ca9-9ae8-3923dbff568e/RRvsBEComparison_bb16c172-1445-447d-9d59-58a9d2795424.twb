            <run fontcolor='#8b0000' fontsize='8'>Please Check </run>
            <run bold='true' fontcolor='#8b0000' fontsize='8'>&quot;Metric&quot; </run>
            <run fontcolor='#8b0000' fontsize='8'>and </run>
            <run bold='true' fontcolor='#8b0000' fontsize='8'>&quot;BE or Target&quot; </run>
            <run fontcolor='#8b0000' fontsize='8'>Fields!</run>
            <run>Æ&#10;</run>
            <run fontsize='8'>BEs represent </run>
            <run bold='true' fontsize='8'>BE -2 months</run>
            <run fontsize='8'> before the RR date. </run>
            <run>Æ&#10;</run>
            <run fontsize='8'>On the 25th of each month,  BEs change to BE -1 month before the RR date.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>RR Date : 24-Nov-22 ----&gt; BE09-22</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='8'>RR Date : 25-Nov-22 ----&gt; BE10-22</run>
            <run>Æ&#10;</run>
          </formatted-text>
