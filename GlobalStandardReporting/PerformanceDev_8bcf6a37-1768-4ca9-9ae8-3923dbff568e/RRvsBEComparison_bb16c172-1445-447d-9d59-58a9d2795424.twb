    <worksheet name='daily_rr_vs_actuals'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='11'>RR vs</run>
            <run bold='true' fontalignment='1' fontcolor='#e00012' fontsize='11'>Æ  </run>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='11'>Actuals - </run>
            <run bold='true' fontalignment='1' fontcolor='#e70000' fontsize='11'>&lt;[Parameters].[Parameter 4]&gt; </run>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='11'>View</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#e00012' fontsize='11'>&lt;[Parameters].[Parameter 1]&gt; </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rl_intl_markets.rr_vs_be' name='federated.15ddb0w0za99081dsoic70kviopl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric Selection' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
              <calculation class='tableau' formula='&quot;Orders&quot;' />
            </column>
            <column caption='View Selection' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Segment&quot;'>
              <calculation class='tableau' formula='&quot;Segment&quot;' />
            </column>
            <column caption='BE Selection' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Automatic&quot;'>
              <calculation class='tableau' formula='&quot;Automatic&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15ddb0w0za99081dsoic70kviopl'>
            <column caption='Error BE % ' datatype='real' default-format='p0.0%' name='[Accuracy % (copy)_192528923156213763]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS((([Calculation_192528923154817026]) - ([BE / Target (copy)_547539234153992192])) / ([BE / Target (copy)_547539234153992192]))' />
            </column>
            <column caption='BE GMV' datatype='real' name='[Acquisitions BE  (copy)_3882595503168704515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur_be_history])' />
            </column>
            <column caption='Actuals Param' datatype='real' name='[BE / Target (copy)_547539234153992192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Orders&apos; THEN SUM([orders_act])&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Acquisitions&apos; THEN SUM([acquisitions_act])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;GMV&apos; THEN SUM([gmv_eur_act])&#10;END' />
            </column>
            <column caption='View' datatype='string' name='[Calculation_134193230810370048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Management Entity&apos; THEN [management_entity]&#10;ELSEIF  [Parameters].[Parameter 4] = &apos;Sub Entity&apos; THEN [sub_entity]&#10;ELSEIF  [Parameters].[Parameter 4] = &apos;Segment&apos; THEN [Calculation_569705394148429831]&#10;END' />
            </column>
            <column caption='BE' datatype='real' name='[Calculation_192528923154817026]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Orders&apos; THEN [Calculation_3882595503167410176]&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Acquisitions&apos; THEN [Orders BE (copy)_3882595503168528386]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;GMV&apos; THEN [Acquisitions BE  (copy)_3882595503168704515]&#10;END' />
            </column>
            <column caption='RR Date for Actuals' datatype='date' default-format='*DD-MMM-YY' name='[Calculation_192528923224834052]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF YEAR([insert_date]) * 100 + MONTH([insert_date]) &lt; &#10;YEAR(NOW()) * 100 + MONTH(NOW()) THEN [insert_date] END' />
            </column>
            <column caption='RR' datatype='real' name='[Calculation_2965972231955030017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Orders&apos; THEN SUM([orders_rr])&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Acquisitions&apos; THEN SUM([acquisitions_rr])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;GMV&apos; THEN SUM([gmv_eur_rr])&#10;END' />
            </column>
            <column caption='Calculation1' datatype='string' name='[Calculation_3005660203866497026]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column caption='be filter' datatype='boolean' name='[Calculation_3136686823426162688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Automatic&apos; AND [day]&gt;= 25  THEN STR([yearmonth_1]) = STR([be_version])&#10;ELSEIF  [Parameters].[Parameter 5] = &apos;Automatic&apos; AND [day]&lt; 25  THEN STR([yearmonth_2]) = STR([be_version])&#10;ELSEIF  [Parameters].[Parameter 5] != &apos;Automatic&apos; THEN [Parameters].[Parameter 5] = [be_version]  &#10;END' />
            </column>
            <column caption='BE Orders' datatype='real' name='[Calculation_3882595503167410176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_be_history])' />
            </column>
            <column caption='ATTR' datatype='integer' name='[Calculation_443323111275876362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='RR Date Actual Equal' datatype='boolean' name='[Calculation_547539234158522370]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(YEAR([insert_date])*100 + MONTH([insert_date]) )  = &#10;(YEAR([report_month])*100 + MONTH([report_month]) )' />
            </column>
            <column caption='Error %' datatype='real' default-format='p0.0%' name='[Calculation_547539234162618372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS((([Calculation_2965972231955030017]) - ([BE / Target (copy)_547539234153992192])) / ([BE / Target (copy)_547539234153992192]))' />
            </column>
            <column caption='Complete Month' datatype='boolean' name='[Calculation_547539234174255109]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([report_month]) * 100 + MONTH([report_month]) &#10;&lt; &#10;YEAR(NOW()) * 100 + MONTH (NOW())' />
            </column>
            <column caption='Segment ' datatype='string' name='[Calculation_569705394148429831]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF global_entity_id = &apos;BM_KR&apos; OR global_entity_id = &apos;BM_VN&apos; &#10;THEN [management_entity] &#10;ELSEIF [segment] = &apos;Asia&apos; THEN &apos;APAC&apos;&#10;ELSE [segment] END' />
            </column>
            <column caption='BE Acquisitions ' datatype='real' name='[Orders BE (copy)_3882595503168528386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acquisitions_be_history])' />
            </column>
            <column caption='RR Month for Actuals ' datatype='date' default-format='*MMM-YY' name='[RR Date for Actuals (copy)_192528923233714182]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF YEAR([report_month]) * 100 + MONTH([report_month]) &#10;&lt; &#10;YEAR(NOW()) * 100 + MONTH(NOW()) THEN [report_month] END' />
            </column>
            <column datatype='real' name='[acquisitions_act]' role='measure' type='quantitative' />
            <column datatype='real' name='[acquisitions_be_history]' role='measure' type='quantitative' />
            <column datatype='real' name='[acquisitions_rr]' role='measure' type='quantitative' />
            <column-instance column='[be_version]' derivation='Attribute' name='[attr:be_version:nk]' pivot='key' type='nominal' />
