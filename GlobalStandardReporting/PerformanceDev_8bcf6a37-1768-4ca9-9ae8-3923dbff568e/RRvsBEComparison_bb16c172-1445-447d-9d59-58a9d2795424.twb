              <calculation class='tableau' formula='&quot;Orders&quot;' />
            </column>
            <column caption='View Selection' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Segment&quot;'>
              <calculation class='tableau' formula='&quot;Segment&quot;' />
            </column>
            <column caption='BE Selection' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Automatic&quot;'>
              <calculation class='tableau' formula='&quot;Automatic&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15ddb0w0za99081dsoic70kviopl'>
            <column caption='ATTR GMV' datatype='integer' name='[ATTR (copy) (copy)_4988369954039451649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='ATTR Acq' datatype='integer' name='[ATTR (copy)_4988369954039439360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='RR vs Actual % Orders' datatype='real' default-format='p0.0%' name='[Accuracy % (copy)_547539234176147463]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS((SUM([orders_rr]) - SUM([orders_act])) / SUM([orders_act]))' />
            </column>
            <column caption='BE vs Actuals % Acq' datatype='real' default-format='p0.0%' name='[Accuracy % Acq (copy)_192528923514085385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS((([Orders BE (copy)_3882595503168528386]) - SUM([acquisitions_act])) / SUM([acquisitions_act]))' />
            </column>
            <column caption='RR vs Actual % GMV' datatype='real' default-format='p0.0%' name='[Accuracy % Acq (copy)_547539234177658889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS((SUM([gmv_eur_rr]) - SUM([gmv_eur_act])) / SUM([gmv_eur_act]))' />
            </column>
            <column caption='BE vs Actuals % GMV ' datatype='real' default-format='p0.0%' name='[Accuracy % GMV (copy)_192528923514195978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS((([Acquisitions BE  (copy)_3882595503168704515]) - SUM([gmv_eur_act])) / SUM([gmv_eur_act]))' />
            </column>
            <column caption='BE vs Actuals % Orders ' datatype='real' default-format='p0.0%' name='[Accuracy % Orders (copy)_192528923514261515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS((([Calculation_3882595503167410176]) - SUM([orders_act])) / SUM([orders_act]))' />
            </column>
            <column caption='RR vs Actual % Acq' datatype='real' default-format='p0.0%' name='[Accuracy % Orders (copy)_547539234177056776]' role='measure' type='quantitative'>
