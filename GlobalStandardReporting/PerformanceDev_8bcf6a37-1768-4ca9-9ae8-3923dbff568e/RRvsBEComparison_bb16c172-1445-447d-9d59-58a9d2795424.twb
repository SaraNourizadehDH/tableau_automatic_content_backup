                  <zone forceUpdate='true' h='9845' id='535' type-v2='text' w='20232' x='76814' y='4933'>
                    <formatted-text>
                      <run bold='true' fontsize='8'>Please Note</run>
                      <run>Æ&#10;</run>
                      <run fontsize='8'>* Woowa Inc. C2C Orders</run>
                      <run>Æ&#10;</run>
                      <run fontsize='8'>* MENA BE + RR&apos;s exclude Lebanon</run>
                      <run>Æ&#10;</run>
                      <run fontsize='8'>* Europe Exc. Glovo</run>
                      <run>Æ&#10;</run>
                      <run fontsize='8'>*APAC Exc. Tabsquare</run>
                      <run>Æ&#10;</run>
                      <run fontsize='8'>**UAE numbers Exc. Zomato (it will be fixed after December)</run>
                      <run>Æ&#10;</run>
