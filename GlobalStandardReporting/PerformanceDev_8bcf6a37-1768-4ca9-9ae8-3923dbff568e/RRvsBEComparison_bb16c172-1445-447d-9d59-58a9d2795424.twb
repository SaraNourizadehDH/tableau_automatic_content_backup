            </column>
            <column caption='View' datatype='string' name='[Calculation_134193230810370048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Management Entity&apos; THEN [management_entity]&#10;ELSEIF  [Parameters].[Parameter 4] = &apos;Sub Entity&apos; THEN [sub_entity]&#10;ELSEIF  [Parameters].[Parameter 4] = &apos;Segment&apos; THEN [Calculation_569705394148429831]&#10;END' />
            </column>
            <column caption='RR Date for Actuals' datatype='date' default-format='*DD-MMM-YY' name='[Calculation_192528923224834052]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF YEAR([insert_date]) * 100 + MONTH([insert_date]) &lt; &#10;YEAR(NOW()) * 100 + MONTH(NOW()) THEN [insert_date] END' />
            </column>
            <column caption='Calculation1' datatype='string' name='[Calculation_3005660203866497026]' role='dimension' type='nominal'>
