    <worksheet name='error_order (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontname='Tableau Bold' fontsize='11'>Orders</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='rl_intl_markets.rr_vs_be' name='federated.15ddb0w0za99081dsoic70kviopl' />
          </datasources>
          <datasource-dependencies datasource='federated.15ddb0w0za99081dsoic70kviopl'>
            <column caption='RR vs Actual % Orders' datatype='real' default-format='p0.0%' name='[Accuracy % (copy)_547539234176147463]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS((SUM([orders_rr]) - SUM([orders_act])) / SUM([orders_act]))' />
            </column>
            <column caption='BE vs Actuals % Acq' datatype='real' default-format='p0.0%' name='[Accuracy % Acq (copy)_192528923514085385]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS((([Orders BE (copy)_3882595503168528386]) - SUM([acquisitions_act])) / SUM([acquisitions_act]))' />
            </column>
            <column caption='RR vs Actual % GMV' datatype='real' default-format='p0.0%' name='[Accuracy % Acq (copy)_547539234177658889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS((SUM([gmv_eur_rr]) - SUM([gmv_eur_act])) / SUM([gmv_eur_act]))' />
            </column>
            <column caption='BE vs Actuals % GMV ' datatype='real' default-format='p0.0%' name='[Accuracy % GMV (copy)_192528923514195978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS((([Acquisitions BE  (copy)_3882595503168704515]) - SUM([gmv_eur_act])) / SUM([gmv_eur_act]))' />
            </column>
            <column caption='BE vs Actuals % Orders ' datatype='real' default-format='p0.0%' name='[Accuracy % Orders (copy)_192528923514261515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS((([Calculation_3882595503167410176]) - SUM([orders_act])) / SUM([orders_act]))' />
            </column>
            <column caption='RR vs Actual % Acq' datatype='real' default-format='p0.0%' name='[Accuracy % Orders (copy)_547539234177056776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS((SUM([acquisitions_rr]) - SUM([acquisitions_act])) / SUM([acquisitions_act]))' />
            </column>
            <column caption='BE GMV' datatype='real' name='[Acquisitions BE  (copy)_3882595503168704515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur_be_history])' />
            </column>
            <column caption='RR Date for Actuals' datatype='date' default-format='*DD-MMM-YY' name='[Calculation_192528923224834052]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF YEAR([insert_date]) * 100 + MONTH([insert_date]) &lt; &#10;YEAR(NOW()) * 100 + MONTH(NOW()) THEN [insert_date] END' />
            </column>
            <column caption='BE Orders' datatype='real' name='[Calculation_3882595503167410176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_be_history])' />
            </column>
            <column caption='RR Date Actual Equal' datatype='boolean' name='[Calculation_547539234158522370]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(YEAR([insert_date])*100 + MONTH([insert_date]) )  = &#10;(YEAR([report_month])*100 + MONTH([report_month]) )' />
            </column>
            <column caption='Complete Month' datatype='boolean' name='[Calculation_547539234174255109]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([report_month]) * 100 + MONTH([report_month]) &#10;&lt; &#10;YEAR(NOW()) * 100 + MONTH (NOW())' />
            </column>
            <column caption='Segment ' datatype='string' name='[Calculation_569705394148429831]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF global_entity_id = &apos;BM_KR&apos; OR global_entity_id = &apos;BM_VN&apos; &#10;THEN [management_entity] &#10;ELSEIF [segment] = &apos;Asia&apos; THEN &apos;APAC&apos;&#10;ELSE [segment] END' />
            </column>
            <column caption='BE Acquisitions ' datatype='real' name='[Orders BE (copy)_3882595503168528386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acquisitions_be_history])' />
            </column>
