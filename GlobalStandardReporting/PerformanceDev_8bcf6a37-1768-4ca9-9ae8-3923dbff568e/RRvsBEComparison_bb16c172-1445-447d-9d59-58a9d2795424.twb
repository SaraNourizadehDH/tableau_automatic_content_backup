      <table>
        <view>
          <datasources>
            <datasource caption='rl_intl_markets.rr_vs_be' name='federated.15ddb0w0za99081dsoic70kviopl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric Selection' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Orders&quot;'>
              <calculation class='tableau' formula='&quot;Orders&quot;' />
            </column>
            <column caption='BE / Target' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Target&quot;'>
              <calculation class='tableau' formula='&quot;Target&quot;' />
            </column>
            <column caption='View Selection' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Segment&quot;'>
              <calculation class='tableau' formula='&quot;Segment&quot;' />
            </column>
            <column caption='BE Selection' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Automatic&quot;'>
              <calculation class='tableau' formula='&quot;Automatic&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.15ddb0w0za99081dsoic70kviopl'>
            <column caption='BE GMV' datatype='real' name='[Acquisitions BE  (copy)_3882595503168704515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_eur_be_history])' />
            </column>
            <column caption='View' datatype='string' name='[Calculation_134193230810370048]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Management Entity&apos; THEN [management_entity]&#10;ELSEIF  [Parameters].[Parameter 4] = &apos;Sub Entity&apos; THEN [sub_entity]&#10;ELSEIF  [Parameters].[Parameter 4] = &apos;Segment&apos; THEN [Calculation_569705394148429831]&#10;END' />
            </column>
            <column caption='Report Date Filter' datatype='boolean' name='[Calculation_192528923148214272]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([report_month]) * 100 + MONTH([report_month]) = YEAR([insert_date]) * 100 + MONTH ([insert_date])' />
            </column>
            <column caption='RR' datatype='real' name='[Calculation_2965972231955030017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Orders&apos; THEN SUM([orders_rr])&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Acquisitions&apos; THEN SUM([acquisitions_rr])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;GMV&apos; THEN SUM([gmv_eur_rr])&#10;END' />
            </column>
            <column caption='Calculation1' datatype='string' name='[Calculation_3005660203866497026]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column caption='be filter' datatype='boolean' name='[Calculation_3136686823426162688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 5] = &apos;Automatic&apos; AND [day]&gt;= 25  THEN STR([yearmonth_1]) = STR([be_version])&#10;ELSEIF  [Parameters].[Parameter 5] = &apos;Automatic&apos; AND [day]&lt; 25  THEN STR([yearmonth_2]) = STR([be_version])&#10;ELSEIF  [Parameters].[Parameter 5] != &apos;Automatic&apos; THEN [Parameters].[Parameter 5] = [be_version]  &#10;END' />
            </column>
            <column caption='BE Orders' datatype='real' name='[Calculation_3882595503167410176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_be_history])' />
            </column>
            <column caption='ATTR' datatype='integer' name='[Calculation_443323111275876362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ATTR(1)' />
            </column>
            <column caption='Segment ' datatype='string' name='[Calculation_569705394148429831]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF global_entity_id = &apos;BM_KR&apos; OR global_entity_id = &apos;BM_VN&apos; &#10;THEN [management_entity] &#10;ELSEIF [segment] = &apos;Asia&apos; THEN &apos;APAC&apos;&#10;ELSE [segment] END' />
            </column>
            <column caption='BE Acquisitions ' datatype='real' name='[Orders BE (copy)_3882595503168528386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([acquisitions_be_history])' />
            </column>
            <column caption='BE / Target' datatype='real' name='[RR (copy)_2965972231956267010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Orders&apos; AND [Parameters].[Parameter 2] = &apos;BE&apos; THEN [Calculation_3882595503167410176]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Orders&apos; AND [Parameters].[Parameter 2] = &apos;Target&apos; THEN SUM([orders_target])&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Acquisitions&apos; AND [Parameters].[Parameter 2] = &apos;BE&apos; THEN [Orders BE (copy)_3882595503168528386]&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Acquisitions&apos; AND [Parameters].[Parameter 2] = &apos;Target&apos; THEN SUM([acquisitions_target])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;GMV&apos; AND [Parameters].[Parameter 2] = &apos;BE&apos; THEN [Acquisitions BE  (copy)_3882595503168704515]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;GMV&apos; AND [Parameters].[Parameter 2] = &apos;Target&apos; THEN SUM([gmv_eur_target])&#10;END' />
            </column>
            <column caption='RR vs BE Param' datatype='real' name='[RR (copy)_2965972231956561923]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Orders&apos; AND [Parameters].[Parameter 2] = &apos;BE&apos; THEN (SUM([orders_rr])-([Calculation_3882595503167410176]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Orders&apos; AND [Parameters].[Parameter 2] = &apos;Target&apos; THEN (SUM([orders_rr])-SUM([orders_target]))&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Acquisitions&apos; AND [Parameters].[Parameter 2] = &apos;BE&apos;  THEN (SUM([acquisitions_rr])-([Orders BE (copy)_3882595503168528386]))&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Acquisitions&apos; AND [Parameters].[Parameter 2] = &apos;Target&apos;  THEN (SUM([acquisitions_rr])-SUM([acquisitions_target]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;GMV&apos; AND [Parameters].[Parameter 2] = &apos;BE&apos;  THEN (SUM([gmv_eur_rr])-([Acquisitions BE  (copy)_3882595503168704515]))&#10;ELSEIF [Parameters].[Parameter 1] = &apos;GMV&apos; AND [Parameters].[Parameter 2] = &apos;Target&apos;  THEN (SUM([gmv_eur_rr])-SUM([gmv_eur_target]))&#10;END' />
            </column>
            <column caption='RR vs BE Param %' datatype='real' default-format='p0.0%' name='[RR vs BE Param (copy)_2965972231957381125]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Orders&apos; AND [Parameters].[Parameter 2]=&apos;BE&apos; THEN (SUM([orders_rr])-([Calculation_3882595503167410176]))/([Calculation_3882595503167410176])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Orders&apos; AND [Parameters].[Parameter 2]=&apos;Target&apos; THEN (SUM([orders_rr])-SUM([orders_target]))/SUM([orders_target])&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Acquisitions&apos; AND [Parameters].[Parameter 2]=&apos;BE&apos;  THEN (SUM([acquisitions_rr])-([Orders BE (copy)_3882595503168528386]))/([Orders BE (copy)_3882595503168528386])&#10;ELSEIF  [Parameters].[Parameter 1] = &apos;Acquisitions&apos; AND [Parameters].[Parameter 2]=&apos;Target&apos;  THEN (SUM([acquisitions_rr])-SUM([acquisitions_target]))/SUM([acquisitions_target])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;GMV&apos; AND [Parameters].[Parameter 2]=&apos;BE&apos;  THEN (SUM([gmv_eur_rr])-([Acquisitions BE  (copy)_3882595503168704515]))/([Acquisitions BE  (copy)_3882595503168704515])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;GMV&apos; AND [Parameters].[Parameter 2]=&apos;Target&apos;  THEN (SUM([gmv_eur_rr])-SUM([gmv_eur_target]))/SUM([gmv_eur_target])&#10;&#10;END' />
            </column>
