      <table>
        <view>
          <datasources>
            <datasource caption='monthly_full_conversion_funnel' name='federated.1tv7slr0j3czcv154i95t01ns4um' />
          </datasources>
          <datasource-dependencies datasource='federated.1tv7slr0j3czcv154i95t01ns4um'>
            <column caption='% Carousel Clicked &apos;Join&apos;' datatype='real' name='[Calculation_2760214045322539014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([carousel_join_clicked])/SUM([plugin_loaded])' />
            </column>
            <column caption='% Carousel Clicked &apos;Confirm&apos;' datatype='real' name='[Calculation_2760214045323005959]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([carousel_modal_loaded])/SUM([carousel_join_clicked])' />
            </column>
            <column caption='% Carousel Booking Success' datatype='real' name='[Calculation_2760214045323325448]' role='measure' type='quantitative'>
