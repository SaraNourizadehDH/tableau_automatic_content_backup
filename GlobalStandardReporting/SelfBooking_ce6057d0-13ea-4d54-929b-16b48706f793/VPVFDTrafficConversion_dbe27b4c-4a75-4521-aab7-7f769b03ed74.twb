        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.044rky30z5xaf010f1zpm0xnuev5' name='Custom SQL Query' type='text'>SELECT
  *
  , RANK() OVER (PARTITION BY global_entity_id ORDER BY report_month DESC) rank_month

  -- MONTH OVER MONTH LAG
  , LAG(portal_logins, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_1m_portal
  , LAG(plugin_loaded, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_1m_plugin
  , LAG(form_loaded, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_1m_form_loaded
  , LAG(carousel_modal_loaded, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_1m_carousel_modal_loaded
  , LAG(form_success, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_1m_form_success
  , LAG(carousel_join_success, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_1m_carousel_success
  , LAG(any_vfd_success, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_1m_any_vfd_success
  , LAG(any_vfd_success_deal, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_1m_any_vfd_success_deals
  , LAG(click_cancel_discount, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_1m_click_cancel_discount
  , LAG(cancel_discount_success, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_1m_cancel_discount_success
  , LAG(click_edit_discount, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_1m_click_edit_discount
  , LAG(edit_discount_success, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_1m_edit_discount_success

  -- 2 MONTH OVER MONTH LAG
  , LAG(portal_logins, 2) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_2m_portal
  , LAG(plugin_loaded, 2) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_2m_plugin
  , LAG(form_loaded, 2) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_2m_form_loaded
  , LAG(carousel_modal_loaded, 2) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_2m_carousel_modal_loaded
  , LAG(form_success, 2) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_2m_form_success
  , LAG(carousel_join_success, 2) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_2m_carousel_success
  , LAG(any_vfd_success, 2) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_2m_any_vfd_success
  , LAG(any_vfd_success_deal, 2) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_2m_any_vfd_success_deals
  , LAG(click_cancel_discount, 2) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_2m_click_cancel_discount
  , LAG(cancel_discount_success, 2) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_2m_cancel_discount_success
  , LAG(click_edit_discount, 2) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_2m_click_edit_discount
  , LAG(edit_discount_success, 2) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_2m_edit_discount_success

  -- 3 MONTH OVER MONTH LAG
  , LAG(portal_logins, 3) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_3m_portal
  , LAG(plugin_loaded, 3) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_3m_plugin
  , LAG(form_loaded, 3) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_3m_form_loaded
  , LAG(carousel_modal_loaded, 3) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_3m_carousel_modal_loaded
  , LAG(form_success, 3) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_3m_form_success
  , LAG(carousel_join_success, 3) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_3m_carousel_success
  , LAG(any_vfd_success, 3) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_3m_any_vfd_success
  , LAG(any_vfd_success_deal, 3) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY report_month) lag_3m_any_vfd_success_deals
FROM (
  -- SELECT * FROM `dhh-ncr-stg.dev_sales_revenue.vp_vfd_plugin_monthly_users`
  -- UNION ALL
  -- SELECT * FROM `dhh-ncr-stg.dev_sales_revenue.vp_vfd_plugin_monthly_sessions`

  SELECT * FROM `fulfillment-dwh-production.cl_vendor.vp_vfd_monthly_users`
  UNION ALL
  SELECT * FROM `fulfillment-dwh-production.cl_vendor.vp_vfd_monthly_sessions`
)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
