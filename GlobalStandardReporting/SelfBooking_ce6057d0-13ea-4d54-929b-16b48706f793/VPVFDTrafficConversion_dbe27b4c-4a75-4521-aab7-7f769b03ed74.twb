    <worksheet name='Monthly Report (Form CvR)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Tableau Bold' fontsize='12'>Summary Form Traffic (MoM∆)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='monthly_full_conversion_funnel' name='federated.1tv7slr0j3czcv154i95t01ns4um' />
            <datasource caption='daily_full_conversion_funnel' name='federated.1tv7slr0j3czcv154i95t01ns4um (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Report Entity Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Regional&quot;'>
              <calculation class='tableau' formula='&quot;Regional&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1tv7slr0j3czcv154i95t01ns4um'>
            <column caption='% Form User CvR (Lag 1)' datatype='real' name='[% Form User CvR (copy)_908179071142948877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([lag_1m_form_success])/SUM([lag_1m_form_loaded])' />
            </column>
            <column caption='% Form Loaded' datatype='real' name='[Calculation_2760214045309468672]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([form_loaded])/SUM([plugin_loaded])' />
            </column>
            <column caption='% Form User CvR' datatype='real' name='[Calculation_2760214045313753092]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([form_success])/SUM([form_loaded])' />
            </column>
            <column caption='Report Entity Level' datatype='string' name='[Calculation_5041146521527234568]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Global&apos; THEN [Calculation_5041146521527312393]&#10;WHEN &apos;Regional&apos; THEN [report_entity]&#10;WHEN &apos;Country&apos; THEN [sub_entity]&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Global Granularity' datatype='string' name='[Calculation_5041146521527312393]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Global&apos;' />
            </column>
            <column caption='Region-Country' datatype='string' name='[Calculation_5041146521527480330]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[management_entity] + &apos; - &apos; + [country_name]' />
            </column>
            <column caption='MoM %∆ Form Loaded' datatype='real' name='[Calculation_908179071136387078]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([form_loaded])/SUM([lag_1m_form_loaded])-1' />
            </column>
            <column caption='MoM pp∆ %Form Loaded' datatype='real' name='[Calculation_908179071137083400]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2760214045309468672] - [Calculation_908179071138320393]) * 100' />
            </column>
            <column caption='% Form Loaded (Lag 1)' datatype='real' name='[Calculation_908179071138320393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([lag_1m_form_loaded])/SUM([lag_1m_plugin])' />
            </column>
            <column caption='MoM %∆ Form Booking' datatype='real' name='[MoM %∆ Form Loaded Users (copy)_908179071136907271]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([form_success])/SUM([lag_1m_form_success])-1' />
            </column>
            <column caption='MoM pp∆ %Form CvR' datatype='real' name='[MoM pp∆ %Form Loaded (copy)_908179071142387723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2760214045313753092] - [% Form User CvR (copy)_908179071142948877])*100' />
            </column>
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Form Loaded' datatype='integer' name='[form_loaded]' role='measure' type='quantitative' />
            <column caption='Form Bookings' datatype='integer' name='[form_success]' role='measure' type='quantitative' />
            <column datatype='integer' name='[lag_1m_form_loaded]' role='measure' type='quantitative' />
            <column datatype='integer' name='[lag_1m_form_success]' role='measure' type='quantitative' />
            <column caption='Plugin Loads (Lag 1)' datatype='integer' name='[lag_1m_plugin]' role='measure' type='quantitative' />
            <column datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column datatype='string' name='[metric_type]' role='dimension' type='nominal' />
            <column-instance column='[report_month]' derivation='MY' name='[my:report_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_5041146521527234568]' derivation='None' name='[none:Calculation_5041146521527234568:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5041146521527480330]' derivation='None' name='[none:Calculation_5041146521527480330:nk]' pivot='key' type='nominal' />
