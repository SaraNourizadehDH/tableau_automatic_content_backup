    <worksheet name='Monthly Report (Carousel CvR) (Chart)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Tableau Bold' fontsize='12'>Monthly Carousel Traffic &amp; Bookings</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='monthly_full_conversion_funnel' name='federated.1tv7slr0j3czcv154i95t01ns4um' />
          </datasources>
          <datasource-dependencies datasource='federated.1tv7slr0j3czcv154i95t01ns4um'>
            <column caption='% Carousel Modal Loaded' datatype='real' name='[Calculation_2760214045322219525]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([carousel_modal_loaded])/SUM([plugin_loaded])' />
            </column>
            <column caption='% Carousel User CvR' datatype='real' name='[Calculation_2760214045325099017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([carousel_join_success])/SUM([carousel_modal_loaded])' />
            </column>
            <column caption='Is Latest Month?' datatype='boolean' name='[Calculation_5041146521524338690]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,{MAX(DATETRUNC(&apos;month&apos;,[report_month]))},DATETRUNC(&apos;month&apos;,[report_month])) = 0' />
            </column>
            <column caption='Region-Country' datatype='string' name='[Calculation_5041146521527480330]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[management_entity] + &apos; - &apos; + [country_name]' />
            </column>
            <column caption='Carousel Bookings' datatype='integer' name='[carousel_join_success]' role='measure' type='quantitative' />
            <column caption='Carousel Modal Loaded' datatype='integer' name='[carousel_modal_loaded]' role='measure' type='quantitative' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[management_entity]' role='dimension' type='nominal' />
