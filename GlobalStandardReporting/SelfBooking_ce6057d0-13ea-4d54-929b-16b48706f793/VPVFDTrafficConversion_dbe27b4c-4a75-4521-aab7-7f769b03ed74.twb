    <worksheet name='Monthly Report (Cancellation)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Tableau Bold' fontsize='12'>Summary Cancellation Traffic (MoM∆)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='monthly_full_conversion_funnel' name='federated.1tv7slr0j3czcv154i95t01ns4um' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Report Entity Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Regional&quot;'>
              <calculation class='tableau' formula='&quot;Regional&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1tv7slr0j3czcv154i95t01ns4um'>
            <column caption='% Cancelled Success (Lag 1)' datatype='real' name='[% Cancelled Success (copy)_2242440829593001990]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([lag_1m_cancel_discount_success])/SUM([lag_1m_click_cancel_discount])' />
            </column>
            <column caption='% Cancelled Success' datatype='real' name='[% Click Cancel Discounts (copy)_2242440829590175746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cancel_discount_success])/SUM([click_cancel_discount])' />
            </column>
            <column caption='% Click Cancel Discounts (Lag 1)' datatype='real' name='[% Click Cancel Discounts (copy)_2242440829593305095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([lag_1m_click_cancel_discount])/SUM([lag_1m_plugin])' />
            </column>
            <column caption='% Click Cancel Discounts' datatype='real' name='[Calculation_2242440829583884289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([click_cancel_discount])/SUM([plugin_loaded])' />
            </column>
            <column caption='MoM %∆ Clicked Cancel' datatype='real' name='[Calculation_2242440829592223747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([click_cancel_discount])/SUM([lag_1m_click_cancel_discount])-1' />
            </column>
            <column caption='MoM %∆ Cancel Success' datatype='real' name='[Calculation_2242440829592670212]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cancel_discount_success])/SUM([lag_1m_cancel_discount_success])-1' />
            </column>
            <column caption='MoM pp∆ % Cancel Success' datatype='real' name='[Calculation_2242440829593534472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([% Click Cancel Discounts (copy)_2242440829590175746] - [% Cancelled Success (copy)_2242440829593001990])*100' />
            </column>
            <column caption='Report Entity Level' datatype='string' name='[Calculation_5041146521527234568]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Global&apos; THEN [Calculation_5041146521527312393]&#10;WHEN &apos;Regional&apos; THEN [report_entity]&#10;WHEN &apos;Country&apos; THEN [sub_entity]&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Global Granularity' datatype='string' name='[Calculation_5041146521527312393]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Global&apos;' />
            </column>
            <column caption='Region-Country' datatype='string' name='[Calculation_5041146521527480330]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[management_entity] + &apos; - &apos; + [country_name]' />
            </column>
            <column caption='MoM pp∆ % Click Cancel' datatype='real' name='[MoM pp∆ % Cancel Success (copy)_2242440829593890825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2242440829583884289]- [% Click Cancel Discounts (copy)_2242440829593305095])*100' />
            </column>
            <column caption='Cancel Discount Success' datatype='integer' name='[cancel_discount_success]' role='measure' type='quantitative' />
