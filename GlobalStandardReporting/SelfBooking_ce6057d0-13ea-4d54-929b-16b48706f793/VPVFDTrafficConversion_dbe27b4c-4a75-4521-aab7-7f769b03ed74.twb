    <worksheet name='Monthly Report (Traffic + Adoption) (Chart)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Tableau Bold' fontsize='12'>Monthly Portal &amp; Plugin Traffic</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='monthly_full_conversion_funnel' name='federated.1tv7slr0j3czcv154i95t01ns4um' />
          </datasources>
          <datasource-dependencies datasource='federated.1tv7slr0j3czcv154i95t01ns4um'>
            <column caption='% Product Cancellations' datatype='real' name='[Calculation_2242440829595439114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([cancel_discount_success])/SUM([plugin_loaded])' />
            </column>
            <column caption='% Plugin Adoption' datatype='real' name='[Calculation_3445394509451509760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([plugin_loaded])/SUM([portal_logins])' />
            </column>
            <column caption='% Product CvR' datatype='real' name='[Calculation_5041146521523195904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([any_vfd_success])/SUM([plugin_loaded])' />
            </column>
            <column caption='Is Latest Month?' datatype='boolean' name='[Calculation_5041146521524338690]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,{MAX(DATETRUNC(&apos;month&apos;,[report_month]))},DATETRUNC(&apos;month&apos;,[report_month])) = 0' />
            </column>
            <column caption='Region-Country' datatype='string' name='[Calculation_5041146521527480330]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[management_entity] + &apos; - &apos; + [country_name]' />
            </column>
            <column caption='Total Bookings' datatype='integer' name='[any_vfd_success]' role='measure' type='quantitative' />
            <column caption='Cancel Discount Success' datatype='integer' name='[cancel_discount_success]' role='measure' type='quantitative' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column datatype='string' name='[metric_type]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_5041146521524338690]' derivation='None' name='[none:Calculation_5041146521524338690:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5041146521527480330]' derivation='None' name='[none:Calculation_5041146521527480330:nk]' pivot='key' type='nominal' />
            <column-instance column='[metric_type]' derivation='None' name='[none:metric_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[outlet_segment]' derivation='None' name='[none:outlet_segment:nk]' pivot='key' type='nominal' />
            <column-instance column='[report_entity]' derivation='None' name='[none:report_entity:nk]' pivot='key' type='nominal' />
            <column caption='Outlet Segments' datatype='string' name='[outlet_segment]' role='dimension' type='nominal'>
              <aliases>
