            <column caption='Select Report Entity Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Regional&quot;'>
              <calculation class='tableau' formula='&quot;Regional&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1tv7slr0j3czcv154i95t01ns4um'>
            <column caption='% Click Join &gt; Click Confirm' datatype='real' name='[Calculation_4876342867542736898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([carousel_confirm_discount])/SUM([carousel_join_clicked])' />
            </column>
            <column caption='% Click Confirm &gt; Booking Success' datatype='real' name='[Calculation_4876342867543257091]' role='measure' type='quantitative'>
