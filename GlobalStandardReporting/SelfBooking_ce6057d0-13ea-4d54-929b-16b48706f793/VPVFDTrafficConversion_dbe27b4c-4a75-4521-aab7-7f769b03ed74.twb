      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_D67CB1768FFC4EC88440A5460D0B60CF'>
            <properties context=''>
              <relation connection='bigquery.044rky30z5xaf010f1zpm0xnuev5 (copy)' name='Custom SQL Query' type='text'>SELECT
  *
  , RANK() OVER (PARTITION BY global_entity_id ORDER BY event_date DESC) rank_event_date

  -- MONTH OVER MONTH LAG
  , LAG(portal_logins, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1d_portal
  , LAG(plugin_loaded, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1d_plugin
  , LAG(form_loaded, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1d_form_loaded
  , LAG(carousel_modal_loaded, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1d_carousel_modal_loaded
  , LAG(form_success, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1d_form_success
  , LAG(carousel_join_success, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1d_carousel_success
  , LAG(any_vfd_success, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1d_any_vfd_success
  , LAG(any_vfd_success_deal, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1d_any_vfd_success_deals
  , LAG(click_cancel_discount, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1d_click_cancel_discount
  , LAG(cancel_discount_success, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1d_cancel_discount_success
  , LAG(click_edit_discount, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1d_click_edit_discount
  , LAG(edit_discount_success, 1) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1d_edit_discount_success

  -- 2 MONTH OVER MONTH LAG
  , LAG(portal_logins, 7) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1w_portal
  , LAG(plugin_loaded, 7) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1w_plugin
  , LAG(form_loaded, 7) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1w_form_loaded
  , LAG(carousel_modal_loaded, 7) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1w_carousel_modal_loaded
  , LAG(form_success, 7) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1w_form_success
  , LAG(carousel_join_success, 7) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1w_carousel_success
  , LAG(any_vfd_success, 7) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1w_any_vfd_success
  , LAG(any_vfd_success_deal, 7) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1w_any_vfd_success_deals
  , LAG(click_cancel_discount, 7) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1w_click_cancel_discount
  , LAG(cancel_discount_success, 7) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1w_cancel_discount_success
  , LAG(click_edit_discount, 7) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1w_click_edit_discount
  , LAG(edit_discount_success, 7) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1w_edit_discount_success

  -- 3 MONTH OVER MONTH LAG
  , LAG(portal_logins, 30) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1m_portal
  , LAG(plugin_loaded, 30) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1m_plugin
  , LAG(form_loaded, 30) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1m_form_loaded
  , LAG(carousel_modal_loaded, 30) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1m_carousel_modal_loaded
  , LAG(form_success, 30) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1m_form_success
  , LAG(carousel_join_success, 30) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1m_carousel_success
  , LAG(any_vfd_success, 30) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1m_any_vfd_success
  , LAG(any_vfd_success_deal, 30) OVER (PARTITION BY metric_type, outlet_segment, global_entity_id ORDER BY event_date) lag_1m_any_vfd_success_deals
FROM (
  -- SELECT * FROM `dhh-ncr-stg.dev_sales_revenue.vp_vfd_plugin_daily_users`
  -- UNION ALL
  -- SELECT * FROM `dhh-ncr-stg.dev_sales_revenue.vp_vfd_plugin_daily_sessions`

  SELECT * FROM `fulfillment-dwh-production.cl_vendor.vp_vfd_daily_users`
  UNION ALL
  SELECT * FROM `fulfillment-dwh-production.cl_vendor.vp_vfd_daily_sessions`
)</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
