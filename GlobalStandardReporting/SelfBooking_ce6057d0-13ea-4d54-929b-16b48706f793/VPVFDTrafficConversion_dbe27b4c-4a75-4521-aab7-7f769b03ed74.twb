    <worksheet name='Monthly Report (Traffic + Adoption)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Tableau Bold' fontsize='12'>Summary Portal &amp; Plugin Traffic (MoM∆)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='monthly_full_conversion_funnel' name='federated.1tv7slr0j3czcv154i95t01ns4um' />
            <datasource caption='daily_full_conversion_funnel' name='federated.1tv7slr0j3czcv154i95t01ns4um (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Report Entity Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Regional&quot;'>
              <calculation class='tableau' formula='&quot;Regional&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1tv7slr0j3czcv154i95t01ns4um'>
            <column caption='% Plugin Adoption (Lag 1)' datatype='real' name='[% Plugin Adoption (copy)_5041146521525428228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([lag_1m_plugin])/SUM([lag_1m_portal])' />
            </column>
            <column caption='% Plugin Adoption' datatype='real' name='[Calculation_3445394509451509760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([plugin_loaded])/SUM([portal_logins])' />
            </column>
            <column caption='% Product CvR' datatype='real' name='[Calculation_5041146521523195904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([any_vfd_success])/SUM([plugin_loaded])' />
            </column>
            <column caption='MoM %∆ Plugin' datatype='real' name='[Calculation_5041146521523531777]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([plugin_loaded])/SUM([lag_1m_plugin]))-1' />
            </column>
            <column caption='Report Entity Level' datatype='string' name='[Calculation_5041146521527234568]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Global&apos; THEN [Calculation_5041146521527312393]&#10;WHEN &apos;Regional&apos; THEN [report_entity]&#10;WHEN &apos;Country&apos; THEN [sub_entity]&#10;ELSE &apos;&apos;&#10;END' />
            </column>
            <column caption='Global Granularity' datatype='string' name='[Calculation_5041146521527312393]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;Global&apos;' />
            </column>
            <column caption='Region-Country' datatype='string' name='[Calculation_5041146521527480330]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[management_entity] + &apos; - &apos; + [country_name]' />
            </column>
            <column caption='MoM %∆ Booking' datatype='real' name='[MoM% Plugin Loaded Users (copy)_5041146521524760579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([any_vfd_success])/SUM([lag_1m_any_vfd_success])-1' />
            </column>
            <column caption='MoM pp∆ Plugin Adoption' datatype='real' name='[MoM% Plugin Loaded Users (copy)_5041146521525678085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_3445394509451509760] - [% Plugin Adoption (copy)_5041146521525428228]) * 100' />
            </column>
            <column caption='MoM pp∆ Plugin CvR' datatype='real' name='[MoM%∆ Plugin Adoption (copy)_5041146521526583302]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_5041146521523195904] - [Product CvR % (copy)_5041146521526665223])*100' />
            </column>
            <column caption='% Product CvR (Lag 1)' datatype='real' name='[Product CvR % (copy)_5041146521526665223]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([lag_1m_any_vfd_success])/SUM([lag_1m_plugin])' />
            </column>
            <column caption='Total Bookings' datatype='integer' name='[any_vfd_success]' role='measure' type='quantitative' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[lag_1m_any_vfd_success]' role='measure' type='quantitative' />
            <column caption='Plugin Loads (Lag 1)' datatype='integer' name='[lag_1m_plugin]' role='measure' type='quantitative' />
            <column caption='Portal Logins (Lag 1)' datatype='integer' name='[lag_1m_portal]' role='measure' type='quantitative' />
            <column datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column datatype='string' name='[metric_type]' role='dimension' type='nominal' />
            <column-instance column='[report_month]' derivation='MY' name='[my:report_month:ok]' pivot='key' type='ordinal' />
