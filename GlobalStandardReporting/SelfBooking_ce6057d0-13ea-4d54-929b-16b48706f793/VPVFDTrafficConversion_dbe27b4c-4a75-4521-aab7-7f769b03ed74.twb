    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Daily User Traffic'>
      <repository-location id='DailyUserTraffic' path='/t/GlobalStandardReporting/workbooks/VPVFD-TrafficConversion' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1900' maxwidth='1440' minheight='1900' minwidth='1440' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='monthly_full_conversion_funnel' name='federated.1tv7slr0j3czcv154i95t01ns4um' />
        <datasource caption='daily_full_conversion_funnel' name='federated.1tv7slr0j3czcv154i95t01ns4um (copy)' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Select Report Entity Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Regional&quot;'>
          <calculation class='tableau' formula='&quot;Regional&quot;' />
          <members>
            <member value='&quot;Global&quot;' />
            <member value='&quot;Regional&quot;' />
            <member value='&quot;Country&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1tv7slr0j3czcv154i95t01ns4um'>
        <column datatype='string' name='[metric_type]' role='dimension' type='nominal' />
        <column-instance column='[report_month]' derivation='MY' name='[my:report_month:ok]' pivot='key' type='ordinal' />
        <column-instance column='[metric_type]' derivation='None' name='[none:metric_type:nk]' pivot='key' type='nominal' />
        <column-instance column='[outlet_segment]' derivation='None' name='[none:outlet_segment:nk]' pivot='key' type='nominal' />
        <column caption='Outlet Segments' datatype='string' name='[outlet_segment]' role='dimension' type='nominal'>
          <aliases>
            <alias key='&quot;chain_outlet_users&quot;' value='Chain Outlet Users' />
            <alias key='&quot;few_outlet_users&quot;' value='Few Outlet Users' />
            <alias key='&quot;single_outlet_users&quot;' value='Single Outlet Users' />
          </aliases>
        </column>
        <column caption='Report Month' datatype='date' name='[report_month]' role='dimension' type='ordinal' />
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1tv7slr0j3czcv154i95t01ns4um (copy)'>
        <column caption='Report Entity Level' datatype='string' name='[Calculation_3445394509530705937]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEn &apos;Global&apos; THEN [Calculation_3445394509531926546]&#10;WHEN &apos;Regional&apos; THEN [report_entity]&#10;WHEN &apos;Country&apos; THEN [sub_entity]&#10;ELSE &apos;&apos;&#10;END' />
        </column>
        <column datatype='date' name='[event_date]' role='dimension' type='ordinal' />
        <column datatype='string' name='[metric_type]' role='dimension' type='nominal' />
        <column-instance column='[Calculation_3445394509530705937]' derivation='None' name='[none:Calculation_3445394509530705937:nk]' pivot='key' type='nominal' />
        <column-instance column='[metric_type]' derivation='None' name='[none:metric_type:nk]' pivot='key' type='nominal' />
        <column-instance column='[event_date]' derivation='Week-Trunc' name='[twk:event_date:qk]' pivot='key' type='quantitative' />
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
