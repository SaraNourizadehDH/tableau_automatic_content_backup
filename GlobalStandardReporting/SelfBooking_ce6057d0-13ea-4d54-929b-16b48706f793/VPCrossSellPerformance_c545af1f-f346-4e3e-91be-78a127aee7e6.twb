        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1g8qwb11pvq98s1ejo5qw1b1srfh' name='Custom SQL Query' type='text'><![CDATA[WITH entity AS (
  SELECT
    management_entity
    ,segment
    ,country_name
    ,brand
    ,global_entity_id
    ,is_platform_online
  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities`
  WHERE is_platform_online = TRUE
)

, cpc_booking_sessions AS (
  SELECT
    session_date
    ,ga_export_name
    ,session_id
    ,user_id
    ,device.device_category
    ,MAX(CASE WHEN cust.index=3 THEN SPLIT(cust.value,';')[SAFE_OFFSET(1)] END) vendor_id
    ,MAX(CASE WHEN cust.index=3 THEN SPLIT(cust.value,';')[SAFE_OFFSET(0)] END) global_entity_id
    FROM `fulfillment-dwh-production.cl_sales_revenue.vp_ga_sessions`
      LEFT JOIN UNNEST(hits) AS hits
      LEFT JOIN UNNEST(hits.custom_dimensions) cust
  WHERE TRUE
      AND session_date >>= '2023-01-01'
      AND hits.event_info.event_action = 'booking_created' 
      AND hits.event_info.event_category = 'cpc_booking' 
      AND hits.event_info.event_label <<>> 'featured_products'
  GROUP BY 1,2,3,4,5
)

, cpc_clicked_ref AS (
  SELECT
    session_date
    ,ga_export_name
    ,session_id
    ,user_id
    ,device.device_category
    ,MAX(traffic_source.source) traffic_source
    ,MAX(CASE WHEN cust.index=3 THEN SPLIT(cust.value,';')[SAFE_OFFSET(1)] END) vendor_id
    ,MAX(CASE WHEN cust.index=3 THEN SPLIT(cust.value,';')[SAFE_OFFSET(0)] END) global_entity_id
    FROM `fulfillment-dwh-production.cl_sales_revenue.vp_ga_sessions`
      LEFT JOIN UNNEST(hits) AS hits
      LEFT JOIN UNNEST(hits.custom_dimensions) cust
  WHERE TRUE
      AND session_date >>= '2023-01-01'
      AND traffic_source.source = 'cpc_success_page' 
      AND hits.event_info.event_category = 'current_vfd' 
      AND hits.event_info.event_action = 'page_loaded'
  GROUP BY 1,2,3,4,5
)

, vfd_booking_success AS (
  SELECT
    session_date
    ,ga_export_name
    ,session_id
    ,user_id
    ,device.device_category
    ,MAX(CASE WHEN cust.index=3 THEN SPLIT(cust.value,';')[SAFE_OFFSET(1)] END) vendor_id
    ,MAX(CASE WHEN cust.index=3 THEN SPLIT(cust.value,';')[SAFE_OFFSET(0)] END) global_entity_id
    ,MAX(CASE WHEN cust.index=19 THEN cust.value END) deal_id
    FROM `fulfillment-dwh-production.cl_sales_revenue.vp_ga_sessions`
      LEFT JOIN UNNEST(hits) AS hits
      LEFT JOIN UNNEST(hits.custom_dimensions) cust
  WHERE TRUE
      AND session_date >>= '2023-01-01'
      AND hits.event_info.event_category IN ('create_vfd', 'join_vfd' )
      AND hits.event_info.event_action = 'succeeded'
  GROUP BY 1,2,3,4,5
)

, agg_ga_sessions AS (
  SELECT
    cpc_bk.session_date
    ,cpc_bk.session_id
    ,cpc_bk.user_id
    ,cpc_bk.vendor_id
    ,cpc_bk.global_entity_id
    ,cpc_bk.device_category
    ,cpc_ref.traffic_source
    ,vfd_bk.vendor_id vfd_vendor_id
    ,vfd_bk.deal_id vfd_deal_id
  FROM cpc_booking_sessions cpc_bk
    LEFT JOIN cpc_clicked_ref cpc_ref
      ON cpc_bk.session_id = cpc_ref.session_id
    LEFT JOIN vfd_booking_success vfd_bk
      ON cpc_ref.session_id = vfd_bk.session_id
)

, incentive AS (
  SELECT
    customer_incentive_id
    ,vendor_id
    ,global_entity_id
    ,SUM(all_orders) all_orders
    ,SUM(inct_amount_total_eur) inct_amount_total_eur
    ,SUM(all_gfv_eur) all_gfv_eur
  FROM `dhh-ncr-stg.dev_sales_revenue.stg_daily_incentives_level_performance`
  GROUP BY 1,2,3
)

, vfd_utilisation AS (
  SELECT
    ses.session_date
    ,ses.session_id
    ,ses.user_id
    ,ses.vendor_id
    ,ses.global_entity_id
    ,ses.traffic_source
    ,ses.vfd_deal_id
    ,inct.inct_amount_total_eur
    ,inct.all_orders
    ,inct.all_gfv_eur
  FROM agg_ga_sessions ses
    LEFT JOIN incentive inct
      ON ses.vfd_deal_id = inct.customer_incentive_id
      AND ses.global_entity_id = inct.global_entity_id
)

SELECT
  DATE_TRUNC(session_date, MONTH) session_month
  ,global_entity_id
  ,CASE WHEN entity.global_entity_id = 'YS_TR' THEN 'Yemeksepeti' ELSE management_entity END report_entity
  ,country_name
  ,COUNT(DISTINCT user_id) users_w_cpc_booking
  ,COUNT(DISTINCT CASE WHEN traffic_source IS NOT NULL THEN user_id END) users_w_cpc_ref_link_click
  ,COUNT(DISTINCT CASE WHEN vfd_deal_id IS NOT NULL THEN user_id END) users_w_vfd_booking
  ,COALESCE(SUM(inct_amount_total_eur), 0) vfd_eur
  ,COALESCE(SUM(all_gfv_eur), 0) gfv_eur
  ,COALESCE(SUM(all_orders), 0) num_orders
FROM vfd_utilisation
  LEFT JOIN entity USING (global_entity_id)
WHERE global_entity_id IN (SELECT global_entity_id FROM entity)
GROUP BY 1,2,3,4]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
