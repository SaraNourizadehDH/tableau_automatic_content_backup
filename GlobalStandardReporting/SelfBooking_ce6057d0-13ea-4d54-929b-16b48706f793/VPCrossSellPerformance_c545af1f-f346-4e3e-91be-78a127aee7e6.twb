      <column caption='CTR %' datatype='real' name='[Calculation_1840846399847915523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([users_w_cpc_ref_link_click])/SUM([users_w_cpc_booking])' />
