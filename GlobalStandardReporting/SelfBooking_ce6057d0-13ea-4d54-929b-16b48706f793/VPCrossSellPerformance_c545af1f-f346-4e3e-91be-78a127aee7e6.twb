            <column-instance column='[users_w_cpc_ref_link_click]' derivation='Sum' name='[sum:users_w_cpc_ref_link_click:qk]' pivot='key' type='quantitative' />
            <column-instance column='[users_w_vfd_booking]' derivation='Sum' name='[sum:users_w_vfd_booking:qk]' pivot='key' type='quantitative' />
            <column-instance column='[vfd_eur]' derivation='Sum' name='[sum:vfd_eur:qk]' pivot='key' type='quantitative' />
            <column-instance column='[session_month]' derivation='Month-Trunc' name='[tmn:session_month:ok]' pivot='key' type='ordinal' />
            <column caption='# Users w CPC Booking' datatype='integer' name='[users_w_cpc_booking]' role='measure' type='quantitative' />
            <column caption='# Users w CPC Ref Link' datatype='integer' name='[users_w_cpc_ref_link_click]' role='measure' type='quantitative' />
            <column caption='# Users w VFD Booking' datatype='integer' name='[users_w_vfd_booking]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1840846399847915523]' derivation='User' name='[usr:Calculation_1840846399847915523:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1840846399848493060]' derivation='User' name='[usr:Calculation_1840846399848493060:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1840846399848919045]' derivation='User' name='[usr:Calculation_1840846399848919045:qk]' pivot='key' type='quantitative' />
            <column caption='€ VFD' datatype='real' name='[vfd_eur]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1owyjcv1jpws4u16yw4930gyhrju].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1owyjcv1jpws4u16yw4930gyhrju].[sum:users_w_cpc_booking:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1owyjcv1jpws4u16yw4930gyhrju].[sum:users_w_cpc_ref_link_click:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1owyjcv1jpws4u16yw4930gyhrju].[sum:users_w_vfd_booking:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1owyjcv1jpws4u16yw4930gyhrju].[usr:Calculation_1840846399847915523:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1owyjcv1jpws4u16yw4930gyhrju].[usr:Calculation_1840846399848493060:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1owyjcv1jpws4u16yw4930gyhrju].[sum:num_orders:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1owyjcv1jpws4u16yw4930gyhrju].[sum:vfd_eur:qk]&quot;' />
