        </connection>
      </extract>
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' _.fcp.SchemaViewerObjectModel.true...common-percentage='1' _.fcp.SchemaViewerObjectModel.true...user-set-layout-v2='true' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;Singapore&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_2D98136ECA874E1C9C884539F581F653'>
            <properties context=''>
              <relation connection='bigquery.1ivtlo20j14xb211ub5m70ft37xl' name='Custom SQL Query' type='text'><![CDATA[WITH entity AS (
  SELECT
    management_entity
    ,segment
    ,country_name
    ,brand
    ,global_entity_id
    ,is_platform_online
  FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.global_entities`
    WHERE is_platform_online = TRUE
)

, vfd_ref_link AS (
  SELECT 
    session_id
    ,session_date
    ,user_id
    ,visit_start_time
    ,device.device_category
    ,MAX(CASE WHEN cust.index = 3 THEN cust.value END) AS vendor_id
    ,MAX(CASE WHEN cust.index = 3 THEN SPLIT(cust.value, ';')[OFFSET(0)] END) AS global_entity_id
    ,MAX(CASE WHEN hits.event_info.event_category = 'create_vfd' AND hits.event_info.event_label = 'create_vfd' AND hits.event_info.event_action = 'succeeded' THEN 1 ELSE 0 END) is_vfd_form_success
    ,MAX(CASE WHEN hits.event_info.event_category = 'join_vfd' AND hits.event_info.event_label = 'join_campaign' AND hits.event_info.event_action = 'succeeded' THEN 1 ELSE 0 END) is_vfd_campaign_success
    ,MAX(CASE WHEN (hits.event_info.event_category = 'create_vfd' OR hits.event_info.event_category = 'join_vfd') AND hits.event_info.event_action = 'clicked_xsell_button' THEN 1 ELSE 0 END) is_clicked_xsell_button
  FROM `fulfillment-dwh-production.cl_sales_revenue.vp_ga_sessions`
    LEFT JOIN UNNEST(hits) as hits
    LEFT JOIN UNNEST(hits.custom_dimensions) AS cust
  WHERE session_date >>= '2023-01-01'
    AND ga_export_name = 'Web'
  GROUP BY 1,2,3,4,5
)

, vfd_ctr_link AS (
  SELECT
    DATE_TRUNC(session_date, MONTH) session_month
    , CASE WHEN global_entity_id = 'YS_TR' THEN 'Yemeksepeti' ELSE management_entity END report_entity
    , country_name
    , global_entity_id
    , COUNT(DISTINCT CASE WHEN is_vfd_form_success = 1 OR is_vfd_campaign_success = 1 THEN user_id END) vfd_booking_success
    , COUNT(DISTINCT CASE WHEN is_clicked_xsell_button = 1 THEN user_id END) vfd_clicked_cpc_ref_link
  FROM vfd_ref_link
    LEFT JOIN entity USING (global_entity_id)
  WHERE global_entity_id IN (SELECT global_entity_id FROM entity)
  GROUP BY 1,2,3,4
)

, cross_link_sessions AS (
  SELECT 
    session_id
    ,session_date
    ,user_id
    ,visit_start_time
    ,device.device_category
    ,SPLIT((SELECT value FROM UNNEST(hits.custom_dimensions) WHERE index = 3 LIMIT 1), ';')[safe_offset(1)] as vendor_id
    ,SPLIT((SELECT value FROM UNNEST(hits.custom_dimensions) WHERE index = 3 LIMIT 1), ';')[offset(0)] as global_entity_id
    ,MAX(DATE_ADD(visit_start_time, interval hits.time millisecond)) as booking_created_dttm
    ,MAX(CASE WHEN hits.event_info.event_category = 'create_vfd' AND hits.event_info.event_label = 'create_vfd' AND hits.event_info.event_action = 'succeeded' THEN 1 ELSE 0 END) is_vfd_form_success
    ,MAX(CASE WHEN hits.event_info.event_category = 'join_vfd' AND hits.event_info.event_label = 'join_campaign' AND hits.event_info.event_action = 'succeeded' THEN 1 ELSE 0 END) is_vfd_campaign_success
    ,MAX(CASE WHEN (hits.event_info.event_category = 'create_vfd' OR hits.event_info.event_category = 'join_vfd') AND hits.event_info.event_action = 'clicked_xsell_button' THEN 1 ELSE 0 END) is_clicked_xsell_button
  FROM `fulfillment-dwh-production.cl_sales_revenue.vp_ga_sessions`
    LEFT JOIN UNNEST(hits) as hits
  WHERE session_date >>= '2023-01-01'
    AND ga_export_name = 'Web'
    AND ((hits.event_info.event_category = 'create_vfd' AND hits.event_info.event_label = 'create_vfd' AND hits.event_info.event_action = 'succeeded')
    OR (hits.event_info.event_category = 'join_vfd' AND hits.event_info.event_label = 'join_campaign' AND hits.event_info.event_action = 'succeeded')
    OR ((hits.event_info.event_category = 'create_vfd' OR hits.event_info.event_category = 'join_vfd') AND hits.event_info.event_action = 'clicked_xsell_button'))
  GROUP BY 1,2,3,4,5,6,7
  HAVING is_clicked_xsell_button >> 0 and (is_vfd_campaign_success + is_vfd_form_success) >> 0
)

-- getting vendor first booking info
, cpc_campaigns AS (
  SELECT 
    vendor_id
    ,MIN(created_date) first_created_date
    ,MAX(date_month) last_active_campaign_date
  FROM `dhh-ncr-live.analytics.ad_tech_il_cpc` 
  GROUP BY 1
)

-- getting cpc bookings
, cpc_bookings as (
  SELECT 
    DISTINCT session_date, user_id, session_id
    ,SPLIT((SELECT value FROM UNNEST(hits.custom_dimensions) WHERE index = 3 LIMIT 1), ';')[offset(0)] global_entity_id
    ,SPLIT((SELECT value FROM UNNEST(hits.custom_dimensions) WHERE index = 3 LIMIT 1), ';')[safe_offset(1)] vendor_id
    ,DATE_ADD(visit_start_time, interval hits.time millisecond) booking_created_dttm
    ,REPLACE(
        JSON_EXTRACT(
          (SELECT cust.value FROM UNNEST(hits.custom_dimensions) cust WHERE cust.index = 198), '$.campaignId'), '"', ''
    ) campaign_id
  FROM `fulfillment-dwh-production.cl_sales_revenue.vp_ga_sessions` ga
  LEFT JOIN unnest(ga.hits) as hits
    WHERE session_date >>= '2023-01-01'
      AND hits.event_info.event_action ='booking_created' 
      AND hits.event_info.event_category = 'cpc_booking'
      AND hits.event_info.event_label <<>> 'featured_products'
)

, cpc_performance AS (
  SELECT 
    booking_id
    ,SUM(cpc_revenue) cpc_revenue_eur
    ,SUM(budget_excl_canceled) budget_eur
    ,SUM(budget_local_currency_excl_canceled) budget_local
  FROM `dhh-ncr-live.analytics.ad_tech_il_cpc` 
    WHERE date_month >>= '2023-01-01'
      AND booking_source = 'self_booking'
  GROUP BY 1
)

, bookings AS (
  SELECT
    DISTINCT booking.id booking_id
    ,vendor.vendor_code
    ,booking.campaign_service_id campaign_id
    ,vendor.entity_id global_entity_id
    ,booking.created_at booking_created_dttm
  FROM `fulfillment-dwh-production.dl_sales_revenue.hannibal_app_data_bookings` booking
    JOIN `fulfillment-dwh-production.dl_sales_revenue.hannibal_app_data_vendors` vendor 
      ON vendor.id = booking.vendor_id
  WHERE booking.billing_type = 'CPC'
    AND date(booking.created_at) >>= '2023-01-01'
)

, campaign_to_booking_link AS (
  SELECT
    DISTINCT cpc.campaign_id
    ,COALESCE(FIRST_VALUE(book_time.booking_id) OVER (PARTITION BY cpc.vendor_id ORDER BY book_time.booking_created_dttm) ,book_camp.booking_id) booking_id
  FROM cpc_bookings cpc
    LEFT JOIN bookings book_camp
      ON book_camp.campaign_id = cpc.campaign_id
    LEFT JOIN bookings book_time
      ON book_time.vendor_code = cpc.vendor_id and date_add(book_time.booking_created_dttm, interval 1 minute) >>= cpc.booking_created_dttm
)

, cpc_revenue_metrics as (
  SELECT 
    events.session_date
    ,events.session_id
    ,events.vendor_id
    ,events.user_id
    ,perf.*
  FROM cpc_bookings events 
    LEFT JOIN campaign_to_booking_link link 
      ON link.campaign_id = events.campaign_id 
    LEFT JOIN cpc_performance perf 
      ON perf.booking_id = link.booking_id
)

-- finding closest session to cpc booking session 
-- first_value needed to deduplicate vfd sessions, for example when vfd session was 2023-08-01 and 2023-08-02 and cpc booking was 2023-03-03 - otherwise we would receive two rows
, cpc_booking_to_vfd_session AS (
  SELECT 
    DISTINCT cpc.*
    ,FIRST_VALUE(xsell.session_id) OVER (PARTITION BY cpc.user_id, cpc.session_id ORDER BY xsell.booking_created_dttm) vfd_session_id
    ,FIRST_VALUE(xsell.booking_created_dttm) OVER (PARTITION BY cpc.user_id, cpc.session_id order by xsell.booking_created_dttm) vfd_booking_created_dttm
    --  any other values about the vfd session
  FROM cpc_bookings cpc 
    JOIN cross_link_sessions xsell
      ON xsell.user_id = cpc.user_id 
      AND date_diff(cpc.booking_created_dttm, xsell.booking_created_dttm, day) <<= 3
      AND cpc.booking_created_dttm >> xsell.booking_created_dttm -- to exclude sessions where cpc booking happend earlier than vfd
)

, referral_revenue_metrics AS (
  -- final agg with revenue metrics
  SELECT 
    management_entity
    ,brand
    ,CASE WHEN global_entity_id = 'YS_TR' THEN 'Yemeksepeti' ELSE management_entity END report_entity
    ,country_name
    ,cpc.session_date
    ,cpc.user_id
    ,cpc.session_id
    ,cpc.global_entity_id
    ,cpc.vendor_id
    ,DATE(cpc.booking_created_dttm) cpc_booking_date
    ,cpc.campaign_id
    ,cpc.vfd_session_id
    ,cpc.vfd_booking_created_dttm
    ,DATE(cpc.vfd_booking_created_dttm) vfd_booking_date
    ,DATE_DIFF(booking_created_dttm, cpc.vfd_booking_created_dttm, DAY) days_to_booking
    ,CASE WHEN camp.first_created_date << date(booking_created_dttm) THEN 'oldie' ELSE 'newbie' END user_type
    ,CASE WHEN camp.last_active_campaign_date = date_trunc(date(booking_created_dttm), month) THEN 'active campaign' else 'no active campaign' END is_active_campaign
    ,revenue.cpc_revenue_eur
    ,revenue.budget_eur
    ,revenue.booking_id
    ,CASE WHEN cpc.session_id = cpc.vfd_session_id THEN TRUE ELSE FALSE END is_same_sessions
  FROM cpc_booking_to_vfd_session cpc 
    LEFT JOIN cpc_campaigns camp 
      ON camp.vendor_id = cpc.vendor_id
    LEFT JOIN cpc_revenue_metrics revenue
      ON revenue.session_date = cpc.session_date 
      AND revenue.user_id = cpc.user_id
      AND revenue.session_id = cpc.session_id
      AND revenue.vendor_id = cpc.vendor_id
    LEFT JOIN entity USING(global_entity_id)
)

, dedup_cpc_bookings AS (
  SELECT
    session_date
    , global_entity_id
    , report_entity
    , country_name
    , vendor_id
    , booking_id
    -- , campaign_id
    , MAX(cpc_booking_date) cpc_booking_date
    , MAX(cpc_revenue_eur) cpc_revenue_eur
    , MAX(budget_eur) budget_eur
  FROM referral_revenue_metrics
  WHERE is_same_sessions = TRUE
  GROUP BY 1,2,3,4,5,6
)

, agg_cpc_revenue AS (
  SELECT
    DATE_TRUNC(session_date, MONTH) session_month
    , global_entity_id
    , report_entity
    , country_name
    , COUNT(DISTINCT vendor_id) num_vendors
    , COUNT(DISTINCT CASE WHEN booking_id IS NOT NULL THEN vendor_id END) num_vendors_w_bookings
    , COUNT(DISTINCT booking_id) num_bookings
    , SUM(budget_eur) budget_eur
    , SUM(cpc_revenue_eur) cpc_revenue_eur
  FROM dedup_cpc_bookings
  GROUP BY 1,2,3,4
)

SELECT
  ref.*
  ,rev.num_bookings
  ,rev.num_vendors
  ,rev.num_vendors_w_bookings
  ,rev.budget_eur
  ,rev.cpc_revenue_eur
FROM vfd_ctr_link ref
  LEFT JOIN agg_cpc_revenue rev
    ON ref.session_month = rev.session_month
    AND ref.global_entity_id = rev.global_entity_id]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='CPC Referrals to VFD'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#1b1b1b' fontname='Tableau Bold'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cpc_to_vfd_cross_sell' name='federated.1owyjcv1jpws4u16yw4930gyhrju' />
          </datasources>
          <datasource-dependencies datasource='federated.1owyjcv1jpws4u16yw4930gyhrju'>
            <column caption='CTR %' datatype='real' name='[Calculation_1840846399847915523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([users_w_cpc_ref_link_click])/SUM([users_w_cpc_booking])' />
            </column>
            <column caption='CvR %' datatype='real' name='[Calculation_1840846399848493060]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([users_w_vfd_booking])/SUM([users_w_cpc_ref_link_click])' />
            </column>
            <column caption='Discount Depth %' datatype='real' name='[Calculation_1840846399848919045]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vfd_eur])/SUM([gfv_eur])' />
            </column>
            <column caption='€ GFV' datatype='real' name='[gfv_eur]' role='measure' type='quantitative' />
            <column-instance column='[report_entity]' derivation='None' name='[none:report_entity:nk]' pivot='key' type='nominal' />
            <column caption='# Orders' datatype='integer' name='[num_orders]' role='measure' type='quantitative' />
            <column caption='Entity' datatype='string' name='[report_entity]' role='dimension' type='nominal' />
            <column datatype='date' name='[session_month]' role='dimension' type='ordinal' />
            <column-instance column='[gfv_eur]' derivation='Sum' name='[sum:gfv_eur:qk]' pivot='key' type='quantitative' />
            <column-instance column='[num_orders]' derivation='Sum' name='[sum:num_orders:qk]' pivot='key' type='quantitative' />
