            </groupfilter>
          </filter>
          <manual-sort column='[federated.1owyjcv1jpws4u16yw4930gyhrju].[:Measure Names]' direction='ASC'>
            <dictionary>
              <bucket>&quot;[federated.1owyjcv1jpws4u16yw4930gyhrju].[sum:users_w_cpc_booking:qk]&quot;</bucket>
              <bucket>&quot;[federated.1owyjcv1jpws4u16yw4930gyhrju].[sum:users_w_cpc_ref_link_click:qk]&quot;</bucket>
              <bucket>&quot;[federated.1owyjcv1jpws4u16yw4930gyhrju].[sum:users_w_vfd_booking:qk]&quot;</bucket>
              <bucket>&quot;[federated.1owyjcv1jpws4u16yw4930gyhrju].[usr:Calculation_1840846399847915523:qk]&quot;</bucket>
              <bucket>&quot;[federated.1owyjcv1jpws4u16yw4930gyhrju].[usr:Calculation_1840846399848493060:qk]&quot;</bucket>
              <bucket>&quot;[federated.1owyjcv1jpws4u16yw4930gyhrju].[sum:num_orders:qk]&quot;</bucket>
              <bucket>&quot;[federated.1owyjcv1jpws4u16yw4930gyhrju].[sum:vfd_eur:qk]&quot;</bucket>
              <bucket>&quot;[federated.1owyjcv1jpws4u16yw4930gyhrju].[sum:gfv_eur:qk]&quot;</bucket>
              <bucket>&quot;[federated.1owyjcv1jpws4u16yw4930gyhrju].[usr:Calculation_1840846399848919045:qk]&quot;</bucket>
            </dictionary>
          </manual-sort>
          <filter class='categorical' column='[federated.1owyjcv1jpws4u16yw4930gyhrju].[none:report_entity:nk]'>
            <groupfilter function='union' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:report_entity:nk]' member='&quot;DH Europe&quot;' />
              <groupfilter function='member' level='[none:report_entity:nk]' member='&quot;Foodpanda APAC&quot;' />
              <groupfilter from='&quot;Pedidosya&quot;' function='range' level='[none:report_entity:nk]' to='&quot;Yemeksepeti&quot;' />
            </groupfilter>
          </filter>
