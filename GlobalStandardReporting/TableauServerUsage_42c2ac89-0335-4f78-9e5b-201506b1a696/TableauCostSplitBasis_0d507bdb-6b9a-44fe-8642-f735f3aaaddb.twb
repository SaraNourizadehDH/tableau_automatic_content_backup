            <column-instance column='[last_action_at]' derivation='None' name='[none:last_action_at:qk]' pivot='key' type='quantitative' />
            <column-instance column='[site_name]' derivation='None' name='[none:site_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[site_role]' derivation='None' name='[none:site_role:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[number_of_sites]' role='measure' type='quantitative' />
            <column caption='Site' datatype='string' name='[site_name]' role='dimension' type='nominal' />
            <column caption='Site Role' datatype='string' name='[site_role]' role='dimension' type='nominal' />
            <column caption='User Email' datatype='string' name='[user_email]' role='dimension' type='nominal' />
            <column aggregation='Sum' datatype='integer' name='[user_id]' role='dimension' type='ordinal' />
            <column caption='User Name' datatype='string' name='[user_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation3]' derivation='User' name='[usr:Calculation3:qk:1]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' />
            </column-instance>
            <column-instance column='[Calculation_1997205713472479233]' derivation='User' name='[usr:Calculation_1997205713472479233:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
