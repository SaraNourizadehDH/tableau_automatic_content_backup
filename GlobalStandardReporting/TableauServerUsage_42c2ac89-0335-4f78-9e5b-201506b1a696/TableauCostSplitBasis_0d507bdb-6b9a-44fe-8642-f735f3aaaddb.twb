            <column caption='Distinct Group Entities' datatype='integer' name='[Calculation_792211364007579648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [user_name] : COUNTD([Calculation_65935555062837249]) }' />
            </column>
            <column caption='Step 2: Entity from Email' datatype='string' name='[Calculation_830703059044323333]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1450510933865627652] = &apos;foodpanda.de&apos; THEN &apos;I-1001-1051, Delivery Hero Germany GmbH&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;pandamarket.de&apos; THEN &apos;I-1001-1052, Delivery Hero Stores GmbH&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;pandalogistics.de&apos; THEN &apos;I-1001-1053, Delivery Hero Logistics GmbH&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodpanda.bg&apos; THEN &apos;I-1001-1101, Foodpanda Bulgaria EOOD&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;deliveryhero.at&apos; OR [Calculation_1450510933865627652] = &apos;foodora.at&apos; THEN &apos;I-1001-1301, Mjam GmbH&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodpanda.hu&apos; THEN &apos;I-1001-1541, Viala Kft (Netpincer)&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodpanda.ro&apos; OR [Calculation_1450510933865627652] = &apos;hipmenu.ro&apos; THEN &apos;I-1001-1581, Foodpanda RO SRL&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodora.no&apos; THEN &apos;I-1001-1601, Foodora Norway AS&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodoramarket.no&apos; THEN &apos;I-1001-1601, Foodora Norway AS&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodora.se&apos; THEN &apos;I-1001-2006, Foodora Sweden&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodora.fi&apos; OR [Calculation_1450510933865627652] = &apos;deliveryhero.fi&apos; THEN &apos;I-1001-2101, Foodora Finland&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foody.com.cy&apos; THEN &apos;I-1001-2804, Delivery Hero (Cyprus) Ltd&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodpanda.hk&apos; THEN &apos;I-1001-3007, Foodpanda Hong Kong&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;deliveryhero.co.kr&apos; THEN &apos;I-1001-3202, RGP Korea Ltd. (Yogiyo)&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodpanda.com.bd&apos; THEN &apos;I-1001-3301, Foodpanda Bangladesh Ltd.&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodpanda.co.th&apos; THEN &apos;I-1001-3601, FOODPANDA (Thailand) Co. Ltd.&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodpanda.tw&apos; THEN &apos;I-1001-3701, Foodpanda Taiwan Co. Ltd.&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodpanda.sg&apos; THEN &apos;I-1001-3801, Foodpanda Singapore Pte. Ltd.&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodpanda.com&apos; THEN &apos;I-1001-3803, Delivery Hero APAC&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodpanda.ph&apos; THEN &apos;I-1001-4001, Food Panda Philippines Inc.&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodpanda.pk&apos; THEN &apos;I-1001-4102, R-SC Internet Services Pakistan (PVT) Limited&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodpanda.my&apos; THEN &apos;I-1001-4201, Foodpanda Malaysia Sdn. Bhd.&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodpanda.la&apos; THEN &apos;I-1001-4301, Delivery Hero (Laos) Co.&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodpanda.com.mm&apos; THEN &apos;I-1001-4311, Delivery Hero (Myanmar) Co. Ltd.&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodpanda.com.kh&apos; THEN &apos;I-1001-4321, Delivery Hero (Cambodia) Co. Ltd.&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodpanda.sk&apos; THEN &apos;I-1001-2421, Delivery Hero Slovakia s.r.o.&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodpanda.co.jp&apos; THEN &apos;I-1001-4601, Delivery Hero Japan Co. Ltd.&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodora.ca&apos; THEN &apos;I-1001-6902, Foodora Inc.&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;ifood.jo&apos; THEN &apos;I-1001-8301, Talabat General Trading and Contracting Company W.L.L&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodora.com&apos; THEN &apos;Delivery Hero SE&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;honestfoodcompany.de&apos; THEN &apos;I-1001-1048, Delivery Hero HF Kitchens GmbH&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;hungry.dk&apos; THEN &apos;I-1001-2203, Hungry DK&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;woowahan.com&apos; THEN &apos;I-1001-3206, Woowa Brothers Corp&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;vn.woowahan.com&apos; THEN &apos;I-1001-4701, Woowa Brothers Vietnam Co Ltd&apos;&#10;&#10;ELSE&#10;    CASE [Calculation_830703059044827142]&#10;        WHEN &apos;pauza&apos; THEN &apos;I-1001-1521, OZON Media d.o.o. (Croatia)&apos;&#10;        WHEN &apos;netpincer&apos; THEN &apos;I-1001-1541, Viala Kft (Netpincer)&apos;&#10;        WHEN &apos;donesi&apos; THEN &apos;I-1001-1621, Donesi FP Serbia&apos;&#10;        WHEN &apos;onlinepizza&apos; THEN &apos;I-1001-2006, Foodora Sweden&apos;&#10;        WHEN &apos;damejidlo&apos; THEN &apos;I-1001-2402, damejidlo.cz&apos;&#10;        WHEN &apos;e-food&apos; THEN &apos;I-1001-2502, Online Delivery Promotion of Internet Service SA (e-food)&apos;&#10;        WHEN &apos;rgpkorea&apos; THEN &apos;I-1001-3202, RGP Korea Ltd. (Yogiyo)&apos;&#10;        WHEN &apos;clickdelivery&apos; THEN &apos;I-1001-6302, Inversiones CMR SAS&apos;&#10;        WHEN &apos;domicilios&apos; THEN &apos;I-1001-6302, Inversiones CMR SAS&apos;&#10;        WHEN &apos;appetito24&apos; THEN &apos;I-1001-6501, Appetito 24 Panama&apos;&#10;        WHEN &apos;pedidosja&apos; THEN &apos;I-1001-6702, PedidosYa Uruguay (ARAVO)&apos;&#10;        WHEN &apos;pedidosya&apos; THEN &apos;I-1001-6702, PedidosYa Uruguay (ARAVO)&apos;&#10;        WHEN &apos;hungerstation&apos; THEN &apos;I-1001-8005, Hungerstation LLC&apos;&#10;        WHEN &apos;otlob&apos; THEN &apos;I-1001-8122, Otlob for Restaurants Reservations Services S.A.E.&apos;&#10;        WHEN &apos;talabat&apos; THEN &apos;I-1001-8001, Talabat Dubai&apos;&#10;        WHEN &apos;trycarriage&apos; THEN &apos;I-1001-8502, Carriage&apos;&#10;        WHEN &apos;yemeksepeti&apos; THEN &apos;I-1001-8701, Yemeksepeti&apos;&#10;        WHEN &apos;pizzaportal&apos; THEN &apos;Restaurant Partner Polska Sp. Z o.o.&apos;&#10;        WHEN &apos;foodora&apos; THEN &apos;Delivery Hero SE&apos;&#10;        WHEN &apos;foodpanda&apos; THEN &apos;Delivery Hero SE&apos;&#10;        ELSE NULL&#10;    END&#10;END' />
            </column>
            <column caption='Step 1b: Email Domain Beginning' datatype='string' name='[Calculation_830703059044827142]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='SPLIT([Calculation_1450510933865627652],&apos;.&apos;,1)' />
            </column>
            <column caption='Step 6: Entity from Group/Site' datatype='string' name='[Calculation_830703059050893320]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL(&#10;    // 1) first check for Otlob &amp; Appetito24 as they can generally only be split by email&#10;    CASE [Calculation_830703059044827142]&#10;        WHEN &apos;appetito24&apos; THEN &apos;I-1001-6501, Appetito 24 Panama&apos;&#10;        WHEN &apos;otlob&apos; THEN &apos;I-1001-8122, Otlob for Restaurants Reservations Services S.A.E.&apos;&#10;        ELSE NULL&#10;    END,&#10;&#10;    // 2) Then fallback to getting the entity from permission groups&#10;    IFNULL(IF [Calculation_792211364007579648] = 1 THEN {FIXED [user_name] : MAX([Calculation_65935555062837249]) } END,&#10;&#10;        // 4) Then if we cannot get an entity from the email, fallback to Site&#10;        IF ISNULL([Calculation_830703059044323333]) THEN &#10;            IF [number_of_sites] = 1 THEN [Entity (copy)]&#10;            ELSE &apos;Delivery Hero SE&apos;  // 5) Final fallback is to assign the user to central&#10;            END&#10;&#10;        // 3) Finally fill in the entity from the user&apos;s email address&#10;        ELSE [Calculation_830703059044323333]&#10;        END&#10;    )&#10;)' />
            </column>
            <column caption='Step 5: Entity from Site' datatype='string' name='[Entity (copy)]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [site_name]&#10;    WHEN &apos;pandora&apos; THEN &apos;Delivery Hero SE&apos;&#10;    WHEN &apos;Global Standard Reporting&apos; THEN &apos;Delivery Hero SE&apos;&#10;    WHEN &apos;HR&apos; THEN &apos;Delivery Hero SE&apos;&#10;    WHEN &apos;HonestFood&apos; THEN &apos;Delivery Hero SE&apos;&#10;    WHEN &apos;Internal IT&apos; THEN &apos;Delivery Hero SE&apos;&#10;    WHEN &apos;9cookies&apos; THEN &apos;Delivery Hero SE&apos;&#10;    WHEN &apos;holding-rnd&apos; THEN &apos;Delivery Hero SE&apos;&#10;    WHEN &apos;Delivery Hero MENA&apos; THEN &apos;I-1001-8001, Talabat Dubai&apos;&#10;    WHEN &apos;ClickDelivery&apos; THEN &apos;I-1001-6302, Inversiones CMR SAS&apos;&#10;    WHEN &apos;Korea&apos; THEN &apos;I-1001-3202, RGP Korea Ltd. (Yogiyo)&apos;&#10;    WHEN &apos;PedidosYa&apos; THEN &apos;I-1001-6702, PedidosYa Uruguay (ARAVO)&apos;&#10;    WHEN &apos;Austria&apos; THEN &apos;I-1001-1301, Mjam GmbH&apos;&#10;    WHEN &apos;PizzaPortal Poland&apos; THEN &apos;Restaurant Partner Polska Sp. Z o.o.&apos;&#10;    WHEN &apos;Finance_Innovation&apos; THEN &apos;Delivery Hero SE&apos;&#10;    WHEN &apos;BPO&apos; THEN &apos;Delivery Hero SE&apos;&#10;    WHEN &apos;HonestFood&apos; THEN &apos;I-1001-1048, Delivery Hero HF Kitchens GmbH&apos;&#10;    ELSE [site_name]&#10;END' />
            </column>
            <column datatype='string' name='[group_name]' role='dimension' type='nominal' />
            <column datatype='datetime' name='[last_action_at]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1616721905200844800]' derivation='None' name='[none:Calculation_1616721905200844800:nk]' pivot='key' type='nominal' />
