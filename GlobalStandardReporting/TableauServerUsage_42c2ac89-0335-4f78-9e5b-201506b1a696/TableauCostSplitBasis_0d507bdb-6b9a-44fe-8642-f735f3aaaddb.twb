quot;GR_Country_Argentina&quot; THEN &apos;I-1001-6001, PedidosYa Argentina&apos;&#10;    WHEN &quot;PY_AR&quot; THEN &apos;I-1001-6001, PedidosYa Argentina&apos;&#10;    WHEN &quot;GR_Country_Bolivia&quot; THEN &apos;I-1001-6151, PedidosYa Bolivia&apos;&#10;    WHEN &quot;PY_BO&quot; THEN &apos;I-1001-6151, PedidosYa Bolivia&apos;&#10;    WHEN &quot;GR_Country_Chile&quot; THEN &apos;I-1001-6201, PedidosYa Chile&apos;&#10;    WHEN &quot;PY_CL&quot; THEN &apos;I-1001-6201, PedidosYa Chile&apos;&#10;    WHEN &quot;GR_Country_Colombia&quot; THEN &apos;I-1001-6302, Inversiones CMR SAS&apos;&#10;WHEN &quot;GR_Country_Costa_Rica&quot; THEN &apos;I-1001-6506, GlovoApp Costa Rica Ltda&apos;&#10;WHEN &quot;PY_CR&quot; THEN &apos;I-1001-6506, GlovoApp Costa Rica Ltda&apos;&#10;WHEN &quot;GR_Country_Ecuador&quot; THEN &apos;I-1001-6402, GlovoApp Ecuador SA&apos;&#10;WHEN &quot;PY_EC&quot; THEN &apos;I-1001-6402, GlovoApp Ecuador SA&apos;&#10;WHEN &quot;GR_Country_El_Salvador&quot; THEN &apos;I-1001-6411, Delivery Hero El Salvador Sociedad Anónima de Capital Variable&apos;&#10;WHEN &quot;PY_SV&quot; THEN &apos;I-1001-6411, Delivery Hero El Salvador Sociedad Anónima de Capital Variable&apos;&#10;WHEN &quot;GR_Country_Guatemala&quot; THEN &apos;I-1001-6421, GlovoApp Guatemala SA&apos;&#10;WHEN &quot;PY_GT&quot; THEN &apos;I-1001-6421, GlovoApp Guatemala SA&apos;&#10;WHEN &quot;GR_Country_Honduras&quot; THEN &apos;I-1001-6431, GlovoApp Honduras SA&apos;&#10;WHEN &quot;PY_HN&quot; THEN &apos;I-1001-6431, GlovoApp Honduras SA&apos;&#10;WHEN &quot;GR_Country_Nicaragua&quot; THEN &apos;I-1001-6481, Delivery Hero Nicaragua S. A.&apos;&#10;WHEN &quot;GR_Country_Perú&quot; THEN &apos;I-1001-6603, GlovoApp Peru SAC&apos;&#10;WHEN &quot;PY_PE&quot; THEN &apos;I-1001-6603, GlovoApp Peru SAC&apos;&#10;&#10;&#10;    WHEN &quot;GR_Country_Panamá&quot; THEN &apos;I-1001-6501, Appetito 24 Panama&apos;&#10;    WHEN &quot;PY_PA&quot; THEN &apos;I-1001-6501, Appetito 24 Panama&apos;&#10;    WHEN &q