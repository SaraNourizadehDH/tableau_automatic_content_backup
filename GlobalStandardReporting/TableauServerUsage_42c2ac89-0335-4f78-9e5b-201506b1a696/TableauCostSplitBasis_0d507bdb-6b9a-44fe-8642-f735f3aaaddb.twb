            </column>
            <column caption='Step 2: Entity from Email' datatype='string' name='[Calculation_830703059044323333]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1450510933865627652] = &apos;foodpanda.de&apos; THEN &apos;I-1001-1051, Delivery Hero Germany GmbH&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;pandamarket.de&apos; THEN &apos;I-1001-1052, Delivery Hero Stores GmbH&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;pandalogistics.de&apos; THEN &apos;I-1001-1053, Delivery Hero Logistics GmbH&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodpanda.bg&apos; THEN &apos;I-1001-1101, Foodpanda Bulgaria EOOD&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;deliveryhero.at&apos; OR [Calculation_1450510933865627652] = &apos;foodora.at&apos; THEN &apos;I-1001-1301, Mjam GmbH&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodpanda.hu&apos; THEN &apos;I-1001-1541, Viala Kft (Netpincer)&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodpanda.ro&apos; OR [Calculation_1450510933865627652] = &apos;hipmenu.ro&apos; THEN &apos;I-1001-1581, Foodpanda RO SRL&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodora.no&apos; THEN &apos;I-1001-1601, Foodora Norway AS&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodoramarket.no&apos; THEN &apos;I-1001-1601, Foodora Norway AS&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodora.se&apos; THEN &apos;I-1001-2006, Foodora Sweden&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodora.fi&apos; OR [Calculation_1450510933865627652] = &apos;deliveryhero.fi&apos; THEN &apos;I-1001-2101, Foodora Finland&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foody.com.cy&apos; THEN &apos;I-1001-2804, Delivery Hero (Cyprus) Ltd&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;foodpanda.hk&apos; THEN &apos;I-1001-3007, Foodpanda Hong Kong&apos;&#10;ELSEIF [Calculation_1450510933865627652] = &apos;deliveryhero.co.kr&apos; THEN &apos;I-1001-3202, RGP Korea Ltd. (Yogiyo)&apos;&#10;ELSEIF [Calculation_145051