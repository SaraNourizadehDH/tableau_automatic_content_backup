    <worksheet name='User Breakdown'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/TableauCostSplitBasis_16686324916320/UserBreakdown?rev=' id='UserBreakdown' path='/t/GlobalStandardReporting/workbooks/TableauCostSplitBasis_16686324916320' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='system_users+ (workgroup)' name='postgres.42047.368827094906' />
          </datasources>
          <datasource-dependencies datasource='postgres.42047.368827094906'>
            <column caption='Step 1: Email Domain' datatype='string' name='[Calculation_1450510933865627652]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='split([Calculation_4136697034377449472], &apos;@&apos;, 2)' />
            </column>
            <column caption='Entity' datatype='string' name='[Calculation_1616721905200844800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_830703059050893320] = &apos;WTF&apos; THEN &apos;Delivery Hero SE&apos; ELSE [Calculation_830703059050893320] END' />
            </column>
            <column caption='Email, User Name' datatype='string' name='[Calculation_4136697034377449472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([user_email], [user_name])' />
            </column>
            <column caption='Ext Users' datatype='boolean' name='[Calculation_5561875219789852673]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CONTAINS([user_email], &quot;.ext&quot;)' />
            </column>
            <column caption='Step 3: Group Entity Base' datatype='string' name='[Calculation_65935555059900416]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [group_name] = &quot;gsr_logistics_enduser&quot; &#10;    OR [group_name] = &quot;gsr_logistics_pandora_enduser&quot; &#10;    OR [group_name] = &quot;gsr_rps_enduser&quot; &#10;    OR [group_name] = &quot;Foodora AM (SE)&quot;&#10;    OR [group_name] = &quot;gsr_darkstores_management_enduser&quot;&#10;    THEN NULL&#10;ELSEIF SPLIT([group_name], &apos;_&apos;, 1) = &quot;gsr&quot; AND SPLIT([group_name], &apos;_&apos;, 3) = &quot;management&quot;&#10;    THEN SPLIT([group_name], &apos;_&apos;, 4) + &quot;_&quot; + SPLIT([group_name], &apos;_&apos;, 5)&#10;ELSEIF SPLIT([group_name], &apos;_&apos;, 1) = &quot;gsr&quot; THEN SPLIT([group_name], &apos;_&apos;, 3) + &quot;_&quot; + SPLIT([group_name], &apos;_&apos;, 4)&#10;ELSEIF SPLIT([group_name], &apos;(&apos;, 2) != &quot;&quot; THEN SPLIT([group_name], &apos;(&apos;, 2)&#10;ELSE [group_name]&#10;END' />
            </column>
            <column caption='Step 4: Entity from Group' datatype='string' name='[Calculation_65935555062837249]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Calculation_65935555059900416]&#10;    WHEN &quot;developer_&quot; THEN &quot;Delivery Hero SE&quot;&#10;    WHEN &quot;enduser_&quot; THEN &quot;Delivery Hero SE&quot;&#10;    WHEN &quot;non_bi&quot; THEN &quot;Delivery Hero SE&quot;&#10;    WHEN &quot;relations_enduser&quot; THEN &quot;Delivery Hero SE&quot;&#10;    //WHEN &quot;foodora_enduser&quot; THEN &quot;Delivery Hero SE&quot;&#10;    //WHEN &quot;pandora_enduser&quot; THEN &quot;Delivery Hero SE&quot;&#10;    WHEN &quot;BG)&quot; THEN &apos;I-1001-1101, Foodpanda Bulgaria EOOD&apos;&#10;    WHEN &quot;Foodpanda Bulgaria&quot; THEN &apos;I-1001-1101, Foodpanda Bulgaria EOOD&apos;&#10;    WHEN &quot;Foodpanda BG&quot; THEN &apos;I-1001-1101, Foodpanda Bulgaria EOOD&apos;&#10;    WHEN &quot;AT)&quot; THEN &apos;I-1001-1301, Mjam GmbH&apos;&#10;    WHEN &quot;DE/AT)&quot; THEN &apos;I-1001-1301, Mjam GmbH&apos;&#10;    WHEN &quot;mjam_enduser&quot; THEN &apos;I-1001-1301, Mjam GmbH&apos;&#10;    WHEN &quot;foodora_austria&quot; THEN &apos;I-1001-1301, Mjam GmbH&apos;&#10;    WHEN &quot;Foodora Austria&quot; THEN &apos;I-1001-1301, Mjam GmbH&apos;&#10;    WHEN &quot;Foodora AT&quot; THEN &apos;I-1001-1301, Mjam GmbH&apos;&#10;    WHEN &quot;Mjam AT&quot; THEN &apos;I-1001-1301, Mjam GmbH&apos;&#10;    WHEN &quot;pauza_enduser&quot; THEN &apos;I-1001-1521, OZON Media d.o.o. (Croatia)&apos;&#10;    WHEN &quot;netpincer_enduser&quot; THEN &apos;I-1001-1541, Viala Kft (Netpincer)&apos;&#10;    WHEN &quot;RO)&quot; THEN &apos;I-1001-1581, Foodpanda RO SRL&apos;&#10;    WHEN &quot;Foodpanda Romania&quot; THEN &apos;I-1001-1581, Foodpanda RO SRL&apos;&#10;    WHEN &quot;Foodpanda RO&quot; THEN &apos;I-1001-1581, Foodpanda RO SRL&apos;&#10;    WHEN &quot;NO)&quot; THEN &apos;I-1001-1601, Foodora Norway AS&apos;&#10;    WHEN &quot;Foodora Norway&quot; THEN &apos;I-1001-1601, Foodora Norway AS&apos;&#10;    WHEN &quot;Foodora NO&quot; THEN &apos;I-1001-1601, Foodo