    <worksheet name='What is the Exact Load Time For Views?'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='11'>What is the summed load time for each view?</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='WhatistheExtactLoadTimeForViews3' path='/t/GlobalStandardReporting/workbooks/TableauWorkbookPerformance' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='Monitor Requests And Users [BigQuery]' name='federated.160t60t0m8mpbh1d0jkf21sww4j0' />
          </datasources>
          <datasource-dependencies datasource='federated.160t60t0m8mpbh1d0jkf21sww4j0'>
            <column caption='Workbook: View' datatype='string' name='[Calculation_2811935050505338880]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[workbook_name] + &quot;: &quot; + [view_name]' />
            </column>
            <column caption='created_at_local' datatype='datetime' name='[Calculation_7431203204157460]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[created_at]+[tz_offset_days]' />
            </column>
            <column caption='Elapsed Time (mins)' datatype='real' name='[Elapsed Time (s) (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[sum_elapsed_time_sec]/60' />
            </column>
            <column caption='FIXED count of loads by View' datatype='integer' name='[FIXED count of loads by Workbook (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [site_name], [request_type], [view_name]: COUNTD([Calculation_7431203204157460])}' />
            </column>
            <column-instance column='[sum_elapsed_time_sec]' derivation='Avg' name='[avg:sum_elapsed_time_sec:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_7431203204157460]' derivation='Count' name='[cnt:Calculation_7431203204157460:qk]' pivot='key' type='quantitative' />
            <column datatype='datetime' name='[created_at]' role='dimension' type='ordinal' />
            <column-instance column='[sum_elapsed_time_sec]' derivation='Median' name='[med:sum_elapsed_time_sec:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2811935050505338880]' derivation='None' name='[none:Calculation_2811935050505338880:nk]' pivot='key' type='nominal' />
            <column-instance column='[FIXED count of loads by Workbook (copy)]' derivation='None' name='[none:FIXED count of loads by Workbook (copy):qk]' pivot='key' type='quantitative' />
            <column-instance column='[project_name]' derivation='None' name='[none:project_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[request_type]' derivation='None' name='[none:request_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[site_name]' derivation='None' name='[none:site_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[view_name]' derivation='None' name='[none:view_name:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[project_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[request_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[site_name]' role='dimension' type='nominal' />
            <column-instance column='[Elapsed Time (s) (copy)]' derivation='Sum' name='[sum:Elapsed Time (s) (copy):qk]' pivot='key' type='quantitative' />
            <column-instance column='[sum_elapsed_time_sec]' derivation='Sum' name='[sum:sum_elapsed_time_sec:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[sum_elapsed_time_sec]' role='measure' type='quantitative' />
            <column datatype='real' name='[tz_offset_days]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-8.0/24' />
            </column>
            <column datatype='string' name='[view_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[workbook_name]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <computed-sort column='[federated.160t60t0m8mpbh1d0jkf21sww4j0].[none:Calculation_2811935050505338880:nk]' direction='DESC' using='[federated.160t60t0m8mpbh1d0jkf21sww4j0].[sum:Elapsed Time (s) (copy):qk]' />
          <filter class='quantitative' column='[federated.160t60t0m8mpbh1d0jkf21sww4j0].[none:FIXED count of loads by Workbook (copy):qk]' included-values='in-range'>
            <min>50</min>
