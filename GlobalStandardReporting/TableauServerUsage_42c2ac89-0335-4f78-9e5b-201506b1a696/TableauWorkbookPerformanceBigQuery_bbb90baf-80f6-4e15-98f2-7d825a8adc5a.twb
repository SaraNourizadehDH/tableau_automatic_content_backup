      </connection>
      <aliases enabled='yes' />
      <column caption='FIXED count of loads by Workbook' datatype='integer' name='[Calculation_217932016337526785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [site_name], [request_type], [workbook_name]: COUNTD([Calculation_7431203204157460])}' />
      </column>
      <column caption='Workbook: View' datatype='string' name='[Calculation_2811935050505338880]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[workbook_name] + &quot;: &quot; + [view_name]' />
      </column>
      <column caption='Dimension' datatype='string' name='[Calculation_3238158534987485185]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &quot;Site&quot; THEN [site_name]&#10;    WHEN &quot;Project&quot; THEN [project_name]&#10;    WHEN &quot;Workbook&quot; THEN [workbook_name]&#10;    WHEN &quot;Server&quot; THEN &quot;Server&quot;&#10;    WHEN &quot;Email Domain&quot; THEN [email_domain]&#10;END' />
      </column>
      <column caption='Site: Project' datatype='string' name='[Calculation_3238158534988193794]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [site_name]&#10;    WHEN &quot;Global Standard Reporting&quot; THEN &quot;GSR&quot;&#10;    WHEN &quot;Delivery Hero MENA&quot; THEN &quot;MENA&quot;&#10;    ELSE [site_name]&#10;END&#10; + &quot;: &quot; + [project_name]' />
      </column>
      <column caption='Date String' datatype='string' name='[Calculation_3248713825600491523]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&apos;Total Views Loaded : &apos; + STR(MIN(DATE([created_at]))) + &apos; - &apos; + STR(MAX(DATE([created_at])))' />
      </column>
      <column caption='Chosen KPI' datatype='real' name='[Calculation_571323870678073344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;    WHEN &quot;Elapsed Time (mins)&quot; THEN SUM([Elapsed Time (s) (copy)])&#10;    WHEN &quot;Number of Requests&quot; THEN SUM([Calculation_571323870678437889])&#10;    WHEN &quot;Avg. Elapsed Time (s)&quot; THEN AVG([sum_elapsed_time_sec])&#10;END' />
      </column>
      <column caption='Number of Requests' datatype='integer' name='[Calculation_571323870678437889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Count of Views' datatype='integer' name='[Calculation_5909848649513701376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Calculation_7431203204157460])' />
      </column>
      <column caption='created_at_local' datatype='datetime' name='[Calculation_7431203204157460]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[created_at]+[tz_offset_days]' />
      </column>
      <column caption='Date String 2' datatype='string' name='[Date String (copy)]' role='measure' type='nominal'>
