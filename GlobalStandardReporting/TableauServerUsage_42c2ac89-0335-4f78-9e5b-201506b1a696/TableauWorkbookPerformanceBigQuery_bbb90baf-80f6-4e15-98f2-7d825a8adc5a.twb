    <datasource caption='Monitor Requests And Users [BigQuery]' inline='true' name='federated.160t60t0m8mpbh1d0jkf21sww4j0' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0qeb31y0p2l2sy17quine1hxuveq'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhub-govops' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='cl_govops' server-oauth='server-custom' username='marta.massarotti@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0qeb31y0p2l2sy17quine1hxuveq' name='Custom SQL Query' type='text'><![CDATA[WITH clean_http_requests AS (
  SELECT
      h.site_id,
      h.user_id,
      bqutil.fn.cw_split_part_delimstr_idx(h.currentsheet, '/', 1) AS workbook_,
      bqutil.fn.cw_split_part_delimstr_idx(h.currentsheet, '/', 2) AS view_,
      h.vizql_session,
      CASE
        WHEN h.action = 'bootstrapSession'
         OR h.controller LIKE '%ensure-layout-for-sheet' THEN 'Load View'
        WHEN h.action = 'vudcsv'
         OR h.controller LIKE '%export-%' THEN 'Data Export'
        WHEN h.action = 'viewData'
         OR h.controller LIKE '%get-show-data%' THEN 'View Data'
        WHEN h.controller LIKE '%filter%'
         OR h.controller LIKE '%parameter%'
         OR h.controller LIKE '%keep-only-or-exclude' THEN 'Filter'
        WHEN h.controller LIKE '%level-drill-up-down' THEN 'Drill Up/Down'
        WHEN h.controller LIKE '%tooltip%' THEN 'Render Tooltip'
        WHEN h.controller LIKE '%select%' THEN 'Select'
        WHEN h.controller LIKE '%sort%' THEN 'Sort'
        WHEN h.action = 'publish' THEN 'Publish'
        ELSE CAST(NULL as STRING)
      END AS request_type,
      -- SPLIT_PART(h.controller, '/', 7)
      TIMESTAMP_DIFF(h.completed_at, h.created_at, SECOND) AS elapsed_time_sec,
      datetime(h.created_at, 'UTC') AS created_at
    FROM
      fulfillment-dwh-production.cl_govops.tableau__http_requests AS h
    WHERE h.site_id <<>> 0
), project_hierarchy AS (
  SELECT
      coalesce(p3.id, p2.id, p1.id, p0.id) AS project_id,
      concat(p0.name, CASE
        WHEN p1.name IS NOT NULL THEN concat(': ', p1.name)
        ELSE ''
      END, CASE
        WHEN p2.name IS NOT NULL THEN concat(': ', p2.name)
        ELSE ''
      END, CASE
        WHEN p3.name IS NOT NULL THEN concat(': ', p3.name)
        ELSE ''
      END) AS project_name
    FROM
      fulfillment-dwh-production.cl_govops.tableau_projects AS p0
      INNER JOIN fulfillment-dwh-production.cl_govops.tableau_projects AS p1 ON p1.parent_project_id = p0.id
      INNER JOIN fulfillment-dwh-production.cl_govops.tableau_projects AS p2 ON p2.parent_project_id = p1.id
      INNER JOIN fulfillment-dwh-production.cl_govops.tableau_projects AS p3 ON p3.parent_project_id = p2.id
    WHERE p0.parent_project_id IS NULL
  UNION DISTINCT
  SELECT
      coalesce(p2.id, p1.id, p0.id) AS project_id,
      concat(p0.name, CASE
        WHEN p1.name IS NOT NULL THEN concat(': ', p1.name)
        ELSE ''
      END, CASE
        WHEN p2.name IS NOT NULL THEN concat(': ', p2.name)
        ELSE ''
      END) AS project_name
    FROM
      fulfillment-dwh-production.cl_govops.tableau_projects AS p0
      INNER JOIN fulfillment-dwh-production.cl_govops.tableau_projects AS p1 ON p1.parent_project_id = p0.id
      INNER JOIN fulfillment-dwh-production.cl_govops.tableau_projects AS p2 ON p2.parent_project_id = p1.id
    WHERE p0.parent_project_id IS NULL
  UNION DISTINCT
  SELECT
      coalesce(p1.id, p0.id) AS project_id,
      concat(p0.name, CASE
        WHEN p1.name IS NOT NULL THEN concat(': ', p1.name)
        ELSE ''
      END) AS project_name
    FROM
      fulfillment-dwh-production.cl_govops.tableau_projects AS p0
      INNER JOIN fulfillment-dwh-production.cl_govops.tableau_projects AS p1 ON p1.parent_project_id = p0.id
    WHERE p0.parent_project_id IS NULL
  UNION DISTINCT
  SELECT
      p.id AS project_id,
      p.name AS project_name
    FROM
      fulfillment-dwh-production.cl_govops.tableau_projects AS p
    WHERE p.parent_project_id IS NULL
)
SELECT
    -- These seem to be timeouts, not necessarily to do with being slow requests
    h.vizql_session,
    s.name AS site_name,
    p.project_name,
    w.name AS workbook_name,
    v.name AS view_name,
    h.request_type,
    h.created_at,
    bqutil.fn.cw_split_part_delimstr_idx(email, '@', 2) AS email_domain,
    sum(h.elapsed_time_sec) AS sum_elapsed_time_sec
  FROM
    clean_http_requests AS h
    INNER JOIN fulfillment-dwh-production.cl_govops.tableau_sites AS s ON s.id = h.site_id
    INNER JOIN fulfillment-dwh-production.cl_govops.tableau_views AS v ON replace(v.repository_url, '/sheets', '') = concat(h.workbook_, '/', h.view_)
     AND v.site_id = h.site_id
    INNER JOIN fulfillment-dwh-production.cl_govops.tableau_workbooks AS w ON w.id = v.workbook_id
    INNER JOIN project_hierarchy AS p ON p.project_id = w.project_id
    LEFT OUTER JOIN fulfillment-dwh-production.cl_govops.tableau_users AS u ON u.id = h.user_id
    LEFT OUTER JOIN fulfillment-dwh-production.cl_govops.tableau_system_users AS su ON su.id = u.system_user_id
  WHERE h.request_type IS NOT NULL
  GROUP BY 1, 2, 3, 4, 5, 6, 7, 8

-- remove noise]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0qeb31y0p2l2sy17quine1hxuveq' name='Custom SQL Query' type='text'><![CDATA[WITH clean_http_requests AS (
  SELECT
