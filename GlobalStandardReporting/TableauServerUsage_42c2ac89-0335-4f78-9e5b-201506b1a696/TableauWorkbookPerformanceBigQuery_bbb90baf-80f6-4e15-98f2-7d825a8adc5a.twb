              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;    WHEN &quot;Site&quot; THEN [site_name]&#10;    WHEN &quot;Project&quot; THEN [project_name]&#10;    WHEN &quot;Workbook&quot; THEN [workbook_name]&#10;    WHEN &quot;Server&quot; THEN &quot;Server&quot;&#10;    WHEN &quot;Email Domain&quot; THEN [email_domain]&#10;END' />
