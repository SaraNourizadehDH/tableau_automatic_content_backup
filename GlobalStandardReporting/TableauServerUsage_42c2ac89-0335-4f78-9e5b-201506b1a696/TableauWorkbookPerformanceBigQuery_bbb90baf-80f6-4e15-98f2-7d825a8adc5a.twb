            <column-instance column='[sum_elapsed_time_sec]' derivation='Sum' name='[pcto:sum:sum_elapsed_time_sec:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
            </column-instance>
