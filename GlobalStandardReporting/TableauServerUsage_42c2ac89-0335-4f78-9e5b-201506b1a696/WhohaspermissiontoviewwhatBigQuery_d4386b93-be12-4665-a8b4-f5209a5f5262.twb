              <relation connection='bigquery.1vdaa5d1orgmml0zyftvm0jvemed' name='Custom SQL Query' type='text'><![CDATA[WITH project_hierarchy AS (
  SELECT
      p3.id AS project_id,
      p0.name AS project_name,
      concat(p0.name, CASE
        WHEN p1.name IS NOT NULL THEN concat(': ', p1.name)
