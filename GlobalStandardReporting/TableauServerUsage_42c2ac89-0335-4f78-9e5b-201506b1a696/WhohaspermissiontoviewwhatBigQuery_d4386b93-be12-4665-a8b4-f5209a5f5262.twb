        ELSE ''
      END, CASE
        WHEN p3.name IS NOT NULL THEN concat(': ', p3.name)
        ELSE ''
      END) AS project_name_detail
    FROM
      fulfillment-dwh-production.cl_govops.tableau_projects AS p0
      INNER JOIN fulfillment-dwh-production.cl_govops.tableau_projects AS p1 ON p1.parent_project_id = p0.id
      INNER JOIN fulfillment-dwh-production.cl_govops.tableau_projects AS p2 ON p2.parent_project_id = p1.id
      INNER JOIN fulfillment-dwh-production.cl_govops.tableau_projects AS p3 ON p3.parent_project_id = p2.id
    WHERE p0.parent_project_id IS NULL
  UNION DISTINCT
  SELECT
      p2.id AS project_id,
      p0.name AS project_name,
      concat(p0.name, CASE
        WHEN p1.name IS NOT NULL THEN concat(': ', p1.name)
        ELSE ''
      END, CASE
        WHEN p2.name IS NOT NULL THEN concat(': ', p2.name)
        ELSE ''
      END) AS project_name_detail
    FROM
      fulfillment-dwh-production.cl_govops.tableau_projects AS p0
      INNER JOIN fulfillment-dwh-production.cl_govops.tableau_projects AS p1 ON p1.parent_project_id = p0.id
      INNER JOIN fulfillment-dwh-production.cl_govops.tableau_projects AS p2 ON p2.parent_project_id = p1.id
    WHERE p0.parent_project_id IS NULL
  UNION DISTINCT
  SELECT
      p1.id AS project_id,
      p0.name AS project_name,
      concat(p0.name, CASE
        WHEN p1.name IS NOT NULL THEN concat(': ', p1.name)
        ELSE ''
      END) AS project_name_detail
    FROM
      fulfillment-dwh-production.cl_govops.tableau_projects AS p0
      INNER JOIN fulfillment-dwh-production.cl_govops.tableau_projects AS p1 ON p1.parent_project_id = p0.id
    WHERE p0.parent_project_id IS NULL
  UNION DISTINCT
  SELECT
      p.id AS project_id,
      p.name AS project_name,
      p.name AS project_name_detail
    FROM
      fulfillment-dwh-production.cl_govops.tableau_projects AS p
    WHERE p.parent_project_id IS NULL
)
SELECT
    su.name AS user_name,
    su.friendly_name AS user_display_name,
    su.email AS user_email,
    bqutil.fn.cw_split_part_delimstr_idx(su.email, '@', 2) AS email_domain,
    s.name AS site_name,
    g.name AS group_name,
    h.project_name,
    h.project_name_detail,
    pr.reason AS permission_reason,
    CASE
      WHEN su.admin_level = 10 THEN 'Server Administrator'
      ELSE l.name
    END AS site_role,
    -- WHEN u.admin_level = 5 THEN 'Site Administrator'
    -- WHEN u.publisher_tristate >> 0 THEN 'Publisher'
    -- WHEN u.publisher_tristate = 0 THEN l.name
    u.login_at AS last_login_at
  FROM
    fulfillment-dwh-production.cl_govops.tableau_users AS u
    INNER JOIN -- LEFT JOIN _users uu on uu.id = u.id
    fulfillment-dwh-production.cl_govops.tableau_system_users AS su ON su.id = u.system_user_id
    INNER JOIN fulfillment-dwh-production.cl_govops.tableau_group_users AS gu ON u.id = gu.user_id
    INNER JOIN fulfillment-dwh-production.cl_govops.tableau_groups AS g ON gu.group_id = g.id
    INNER JOIN fulfillment-dwh-production.cl_govops.tableau_sites AS s ON s.id = u.site_id
    INNER JOIN fulfillment-dwh-production.cl_govops.tableau_permissions_templates AS pt ON pt.grantee_id = g.id
     AND pt.grantee_type = 'Group'
    LEFT OUTER JOIN fulfillment-dwh-production.dl_govops.tableau_permission_reasons AS pr ON pr.precedence = pt.permission
    LEFT OUTER JOIN fulfillment-dwh-production.cl_govops.tableau_site_roles AS l ON l.id = u.site_role_id
    INNER JOIN fulfillment-dwh-production.cl_govops.tableau_projects AS p ON p.id = pt.container_id
     AND pt.container_type = 'Project'
    INNER JOIN project_hierarchy AS h ON h.project_id = p.id
  WHERE true
   AND pt.capability_id = 1
   AND pt.template_type = 'Workbook'
   AND pt.permission NOT IN(
    -- LEFT JOIN licensing_roles l on l.id = u.licensing_role_id
    --  'read'
    --  Not interested in Data Sources
    2, 4
  )
   AND l.name <<>> 'Unlicensed'

--  Not disallowed]]></relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
