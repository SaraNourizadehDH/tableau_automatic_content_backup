      <aliases enabled='yes' />
      <column caption='Last Login' datatype='datetime' name='[Calculation_1450510933857951744]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([site_login_at])' />
      </column>
      <column caption='User Check' datatype='string' name='[Calculation_1997205713439838208]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF TODAY() - [Last Login (copy)] &gt; 90 THEN &quot;Inactive 90+ days&quot; ELSE &quot;Active or created in last 90 days&quot; END' />
      </column>
      <column caption='Distinct Users' datatype='integer' name='[Calculation_1997205713472479233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([user_id])' />
      </column>
      <column caption='Last Action' datatype='datetime' name='[Last Login (copy)]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX(IFNULL([site_login_at],[site_access_created_at]))' />
      </column>
      <column caption='Number of Sites with Access' datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_BD6C47CA90914BAC84F06787341C1912]' role='measure' type='quantitative' />
      <column datatype='string' name='[site_name]' role='dimension' type='nominal' />
      <group name='[User Filter 1]' name-style='unqualified' user:ui-builder='identity-set'>
        <groupfilter function='intersection'>
          <groupfilter function='level-members' level='[site_name]' />
          <groupfilter function='union'>
            <groupfilter expression='false' function='filter'>
              <groupfilter function='level-members' level='[site_name]' />
            </groupfilter>
            <groupfilter expression='ISMEMBEROF(&apos;All Users&apos;)' function='filter'>
              <groupfilter function='union'>
                <groupfilter function='member' level='[site_name]' member='&quot;Austria&quot;' />
                <groupfilter function='member' level='[site_name]' member='&quot;BPO&quot;' />
                <groupfilter function='member' level='[site_name]' member='&quot;Default&quot;' />
                <groupfilter function='member' level='[site_name]' member='&quot;Delivery Hero MENA&quot;' />
                <groupfilter function='member' level='[site_name]' member='&quot;Delivery Hero MENA HR&quot;' />
                <groupfilter function='member' level='[site_name]' member='&quot;Global Standard Reporting&quot;' />
                <groupfilter function='member' level='[site_name]' member='&quot;HonestFood&quot;' />
                <groupfilter function='member' level='[site_name]' member='&quot;HR&quot;' />
                <groupfilter function='member' level='[site_name]' member='&quot;pandora&quot;' />
                <groupfilter function='member' level='[site_name]' member='&quot;PedidosYa&quot;' />
                <groupfilter function='member' level='[site_name]' member='&quot;TabSquare&quot;' />
                <groupfilter function='member' level='[site_name]' member='&quot;Woowa&quot;' />
              </groupfilter>
            </groupfilter>
          </groupfilter>
        </groupfilter>
      </group>
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
