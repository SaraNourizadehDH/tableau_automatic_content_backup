      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1hsjr420yr3jb719hn5u61q416l7'>
            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dhub-govops' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='fulfillment-dwh-production' schema='cl_govops' server-oauth='server-custom' username='marta.massarotti@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1hsjr420yr3jb719hn5u61q416l7' name='Custom SQL Query' type='text'>SELECT
    su.id AS user_id,
    su.name AS user_name,
    su.email AS user_email,
    bqutil.fn.cw_split_part_delimstr_idx(su.email, &apos;@&apos;, 2) AS email_domain,
    su.friendly_name AS display_name,
    s.name AS site_name,
    su.created_at AS user_created_at,
    u.created_at AS site_access_created_at,
    u.login_at AS site_login_at,
    CASE
      WHEN su.admin_level = 10 THEN &apos;Server Administrator&apos;
      WHEN l.name = &apos;SiteAdministrator&apos; THEN &apos;Site Administrator&apos;
      WHEN l.name = &apos;Publisher&apos; THEN &apos;Explorer (can publish&apos;
      WHEN l.name = &apos;Interactor&apos; THEN &apos;Explorer&apos;
      WHEN l.name = &apos;BasicUser&apos; THEN &apos;Viewer&apos;
      ELSE l.name
    END AS site_role
  FROM
    fulfillment-dwh-production.cl_govops.tableau_users AS u
    LEFT OUTER JOIN fulfillment-dwh-production.cl_govops.tableau_system_users AS su ON su.id = u.system_user_id
    LEFT OUTER JOIN fulfillment-dwh-production.cl_govops.tableau_sites AS s ON s.id = u.site_id
    LEFT OUTER JOIN fulfillment-dwh-production.cl_govops.tableau_site_roles AS l ON l.id = u.site_role_id</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1hsjr420yr3jb719hn5u61q416l7' name='Custom SQL Query' type='text'>SELECT
    su.id AS user_id,
    su.name AS user_name,
    su.email AS user_email,
    bqutil.fn.cw_split_part_delimstr_idx(su.email, &apos;@&apos;, 2) AS email_domain,
    su.friendly_name AS display_name,
    s.name AS site_name,
    su.created_at AS user_created_at,
    u.created_at AS site_access_created_at,
    u.login_at AS site_login_at,
    CASE
      WHEN su.admin_level = 10 THEN &apos;Server Administrator&apos;
      WHEN l.name = &apos;SiteAdministrator&apos; THEN &apos;Site Administrator&apos;
      WHEN l.name = &apos;Publisher&apos; THEN &apos;Explorer (can publish&apos;
      WHEN l.name = &apos;Interactor&apos; THEN &apos;Explorer&apos;
      WHEN l.name = &apos;BasicUser&apos; THEN &apos;Viewer&apos;
      ELSE l.name
    END AS site_role
  FROM
    fulfillment-dwh-production.cl_govops.tableau_users AS u
    LEFT OUTER JOIN fulfillment-dwh-production.cl_govops.tableau_system_users AS su ON su.id = u.system_user_id
    LEFT OUTER JOIN fulfillment-dwh-production.cl_govops.tableau_sites AS s ON s.id = u.site_id
    LEFT OUTER JOIN fulfillment-dwh-production.cl_govops.tableau_site_roles AS l ON l.id = u.site_role_id</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
