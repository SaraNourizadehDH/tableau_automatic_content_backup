      <aliases enabled='yes' />
      <column caption='Business Type  ' datatype='string' name='[Business_Type__C (copy)_1523061140593635330]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[business_type__c]' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Case ID (copy)_862157915137114113] / TOTAL([Case ID (copy)_862157915137114113])'>
          <table-calc ordering-field='[federated.1vpuep51mqf3z01ead8dr0oncvjm].[specific_cause]' ordering-type='Field' />
        </calculation>
      </column>
      <column datatype='integer' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Case ID (copy)_862157915137114113]) - LOOKUP(ZN([Case ID (copy)_862157915137114113]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Attribute Type' datatype='string' name='[Calculation_1376412677722722306]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Business_Type__C Parameter]&#13;&#10;WHEN &quot;Global Entity ID&quot; THEN [global_entity_id]&#13;&#10;WHEN &quot;Country ID&quot; THEN  [Calculation_223772647828922377]&#13;&#10;WHEN &quot;Business Type&quot; THEN [business_type__c]&#13;&#10;WHEN &quot;Central Job Role&quot; THEN [central_job_role__c]&#13;&#10;WHEN &quot;Vertical&quot; THEN [vertical__c]&#13;&#10;WHEN &quot;Account Source&quot; THEN [account_source]&#13;&#10;WHEN &quot;Account Type&quot; THEN [account_type]&#13;&#10;WHEN &quot;Key Account Sub Category&quot; THEN [key_account_sub_category__c]&#13;&#10;WHEN &quot;Key Vip Account&quot; THEN [key_vip_account__c]&#13;&#10;WHEN &quot;Vertical Segment&quot; THEN [vertical_segment__c]&#13;&#10;WHEN &quot;Platform&quot; THEN [platform__c]&#13;&#10;END' />
      </column>
      <column caption='Total Cases Root Cause' datatype='integer' name='[Calculation_1921911202463973377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{Fixed[root_cause],[Report Date (copy)_223772647836516364]: countd([caseid])}' />
      </column>
      <column caption='QC rejection %' datatype='real' name='[Calculation_223772647822938112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_closed_unsuccess])/sum([total_closed_cases])' />
      </column>
      <column caption='Truncated Date (Day)' datatype='date' name='[Calculation_223772647827116035]' role='dimension' type='ordinal'>
