            <column caption='Total Closed Cases  ' datatype='real' name='[Calculation_223772647830769675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_closed_cases])' />
            </column>
            <column caption='Report Date  ' datatype='date' datatype-customized='true' name='[Report Date (copy)_223772647836516364]' role='dimension' type='ordinal'>
