            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vpuep51mqf3z01ead8dr0oncvjm'>
            <column caption='Attribute Type' datatype='string' name='[Calculation_1376412677722722306]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Business_Type__C Parameter]&#13;&#10;WHEN &quot;Global Entity ID&quot; THEN [global_entity_id]&#13;&#10;WHEN &quot;Country ID&quot; THEN  [Calculation_223772647828922377]&#13;&#10;WHEN &quot;Business Type&quot; THEN [business_type__c]&#13;&#10;WHEN &quot;Central Job Role&quot; THEN [central_job_role__c]&#13;&#10;WHEN &quot;Vertical&quot; THEN [vertical__c]&#13;&#10;WHEN &quot;Account Source&quot; THEN [account_source]&#13;&#10;WHEN &quot;Account Type&quot; THEN [account_type]&#13;&#10;WHEN &quot;Key Account Sub Category&quot; THEN [key_account_sub_category__c]&#13;&#10;WHEN &quot;Key Vip Account&quot; THEN [key_vip_account__c]&#13;&#10;WHEN &quot;Vertical Segment&quot; THEN [vertical_segment__c]&#13;&#10;WHEN &quot;Platform&quot; THEN [platform__c]&#13;&#10;END' />
            </column>
            <column caption='Truncated Date (Day)' datatype='date' name='[Calculation_223772647827116035]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;day&apos;, [case_created]))' />
            </column>
            <column caption='Truncated Date (Month)' datatype='date' name='[Calculation_223772647827292164]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [case_created]))' />
            </column>
            <column caption='Truncated Date (Quarter)' datatype='date' name='[Calculation_223772647827439621]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;quarter&apos;, [case_created]))' />
            </column>
            <column caption='Truncated Date (Week number)' datatype='date' name='[Calculation_223772647827668998]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [case_created]))' />
            </column>
            <column caption='Report Date (Range)' datatype='date' name='[Calculation_223772647828168712]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF &#13;&#10;[Parameters].[QC rejection % Parameter] = &apos;Daily&apos; then [Calculation_223772647827116035]&#13;&#10;ELSEIF &#13;&#10;[Parameters].[QC rejection % Parameter] = &apos;Weekly&apos; then [Calculation_223772647827668998] &#13;&#10;ELSEIF &#13;&#10;[Parameters].[QC rejection % Parameter] = &apos;Monthly&apos; then [Calculation_223772647827292164]&#13;&#10;ELSEIF &#13;&#10;[Parameters].[QC rejection % Parameter] = &apos;Quarterly&apos; then [Calculation_223772647827439621]&#13;&#10;ELSEIF &#13;&#10;[Parameters].[QC rejection % Parameter] = &apos;Yearly&apos; then [Truncated Date (Week number) (copy)_223772647827857415]&#13;&#10;END' />
            </column>
            <column caption='Country ID' datatype='string' name='[Calculation_223772647828922377]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='right([global_entity_id],2)' />
            </column>
            <column caption='Total Closed Unsuccess Cases' datatype='real' name='[Calculation_223772647830622218]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_closed_unsuccess])' />
