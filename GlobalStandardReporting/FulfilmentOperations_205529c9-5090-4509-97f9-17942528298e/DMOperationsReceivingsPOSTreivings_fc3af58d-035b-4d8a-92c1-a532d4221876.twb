          <members>
            <member value='&quot;Daily&quot;' />
            <member value='&quot;Weekly&quot;' />
            <member value='&quot;Monthly&quot;' />
            <member value='&quot;Quarterly&quot;' />
          </members>
        </column>
        <column caption='Select KPI ST' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Avg RVG T per SKU(sec)&quot;'>
          <calculation class='tableau' formula='&quot;Avg RVG T per SKU(sec)&quot;' />
          <members>
            <member value='&quot;Avg RVG T per SKU(sec)&quot;' />
            <member value='&quot;Avg RVG T per PO/ST(min)&quot;' />
            <member value='&quot;Avg RVG T per Unit(sec)&quot;' />
            <member value='&quot;Total \#PO/ST&quot;' />
