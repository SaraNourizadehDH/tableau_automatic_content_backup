      <aliases enabled='yes' />
      <column caption='Bulk RVG Flag Started' datatype='integer' name='[%SKUs with Bulk Receivings (copy)_1726145348037070850]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if sum(IF [Bulk_flag] = &apos;Bulk&apos; THEN [total_st_po_received] ELSE 0 END) &gt; 10 then 1 else 0 END' />
      </column>
      <column caption='Avg RVG Time Per PO/ST(min)' datatype='real' name='[Avg Receiving Time Per SKU (copy)_3001719573302689794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([receiving_time_s])/sum([total_st_po_received])/60' />
      </column>
      <column caption='Multi-RVG Flag Started' datatype='integer' name='[Bulk RVG Flag Started (copy)_1726145348039012355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if sum(IF [is_multi_receiving] THEN [total_st_po_received] ELSE 0 END) &gt; 10 then 1 else 0 END' />
      </column>
      <column caption='Bulk Expiry RVG Flag Started' datatype='integer' name='[Bulk RVG Flag Started (copy)_1726145348041900036]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if sum(IF [Bulk_flag] = &apos;Bulk&apos; and [bulk_expiry_flag] = &apos;Yes&apos; then [total_st_po_received] ELSE 0 END) &gt; 10 then 1 else 0 END' />
      </column>
      <column caption='Bulk flag' datatype='string' name='[Bulk_flag]' role='dimension' type='nominal' />
      <column caption='LastUpdatedDate' datatype='date' name='[Calculation_1726145347959545856]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='max([received_date])' />
      </column>
      <column caption='%SKUs with Bulk Receivings' datatype='real' name='[Calculation_1726145347979833345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*sum(IF [Bulk_flag] = &apos;Bulk&apos; THEN [unique_SKUs] ELSE 0 END)&#10;/ sum([unique_SKUs])' />
      </column>
      <column caption='Avg RVG Time Per SKU(sec)' datatype='real' name='[Calculation_3001719573301923840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([receiving_time_s])/sum([unique_SKUs])' />
      </column>
      <column caption='Avg RVG Time Per Unit(sec)' datatype='real' name='[Calculation_3001719573302292481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([receiving_time_s])/sum([total_received_qty])' />
      </column>
      <column caption='Total PO/ST' datatype='integer' name='[Calculation_3001719573303365635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_st_po_received])' />
      </column>
      <column caption='Units RVD Per SKU' datatype='real' name='[Calculation_3001719573303496708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_received_qty])/sum([unique_SKUs])' />
      </column>
      <column caption='Dynamic Date' datatype='date' name='[Calculation_3001719573306318855]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Daily&apos; THEN DATETRUNC(&apos;day&apos;, [received_date]) &#10;WHEN &apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;, [received_date])&#10;WHEN &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;, [received_date])  &#10;WHEN &apos;Quarterly&apos; THEN DATETRUNC(&apos;quarter&apos;, [received_date]) &#10;END)' />
      </column>
      <column caption='Dynamic KPI Select' datatype='real' name='[Calculation_3001719573309591560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;Avg RVG T per SKU(sec)&apos; then [Calculation_3001719573301923840]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg RVG T per PO/ST(min)&apos; then [Avg Receiving Time Per SKU (copy)_3001719573302689794]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Avg RVG T per Unit(sec)&apos; then [Calculation_3001719573302292481]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Total #PO/ST&apos; then [Calculation_3001719573303365635]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Total SKUs RVD&apos; then [Total PO/ST (copy)_3001719573303734277]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Units RVD Per SKU&apos; then [Calculation_3001719573303496708]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Total Units RVD&apos; then [Total SKUs Received (copy)_3001719573303926790]&#10;ELSEIF [Parameters].[Parameter 2] = &apos;%SKUs w Bulk RVGs&apos; then [Calculation_1726145347979833345]&#10;end' />
      </column>
      <column caption='Total SKUs RVD' datatype='integer' name='[Total PO/ST (copy)_3001719573303734277]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([unique_SKUs])' />
      </column>
      <column caption='Total Units RVD' datatype='integer' name='[Total SKUs Received (copy)_3001719573303926790]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_received_qty])' />
      </column>
