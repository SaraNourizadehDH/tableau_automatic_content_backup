        <objects>
          <object caption='tableau_cycle_count_random' id='tableau_cycle_count_random_A0D6D2C0E2964B5996B1AD9648CAD32A'>
            <properties context=''>
              <relation connection='bigquery.01ix5mh0fb2f9f16y1r230zn7gok' name='Custom SQL Query' type='text'>SELECT &#13;
ccr.*,&#13;
required_sku_count_im_update&#13;

FROM `fulfillment-dwh-production.rl_dmart`.`tableau_cycle_count_random` ccr&#13;
LEFT JOIN (&#13;
        SELECT &#13;
          warehouse_id&#13;
          , date_trunc(DATE(required_sku_count_updated_at)+1, WEEK(MONDAY)) cc_week&#13;
          , required_sku_count required_sku_count_im_update&#13;
        FROM `fulfillment-dwh-production.dl_dmart.inventory_management_tool_cycle_count_warehouse_kpis`&#13;
        ) im ON im.cc_week = ccr.cc_week&#13;
              AND im.warehouse_id = ccr.warehouse_id</relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
