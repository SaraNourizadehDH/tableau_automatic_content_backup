  <dashboards>
    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='KPI Definition'>
      <repository-location derived-from='http://ip-172-31-0-74:8271/t/GlobalStandardReporting/workbooks/DarkStores-RandomCycleCount_16432696183140/KPIDefinition?rev=' id='KPIDefinition' path='/t/GlobalStandardReporting/workbooks/DM-Operations-InventoryManagement-RandomCycleCountresultsold' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='900' maxwidth='1500' minheight='900' minwidth='1500' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='70667' id='3' type-v2='text' w='96200' x='1533' y='1556'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='10'>Owner: Tanya Ovchinnikova</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>Update for : today-1 day</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>Datiled info and comprehensive analitics on all cycle count strategies can be found in DM - Inventory Management - Cycle Count deep dive</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='16'>KPI Definitions</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='14'>Random Results</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='10'>Only  Batched, completed the same week when a cycle count started, are considered</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>CC Week :</run>
            <run fontcolor='#000000' fontsize='10'> Cycle count started date is considered</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>Distinct SKUs Counted: </run>
            <run fontcolor='#000000' fontsize='10'>sum of distinct SKUs counted during the cycle count</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>Share of Assortments:</run>
            <run fontcolor='#000000' fontsize='10'> sum of distinct SKUs counted during the batch counts / sum of distinct SKUs that are active or not active but has &gt; 0 on hand quantity.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>Discrepancy </run>
            <run fontcolor='#000000' fontsize='10'>: sum of on hand qty - sum of units counted</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>SKU Defect Rate</run>
            <run fontcolor='#000000' fontsize='10'>: number of SKUs with discrepancies / Distinct SKUs Counted</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>Item Level Defect Rate (Gross):</run>
            <run fontcolor='#000000' fontsize='10'> Absolute(discrepancies)/ sum of on hand qty of counted SKUs</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>Item Level Defect Rate (Net): </run>
            <run fontcolor='#000000' fontsize='10'>discrepancies/ sum of on hand qty of counted SKUs</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>Avg SKU Defect rate</run>
            <run fontcolor='#000000' fontsize='10'>: Avg SKU defect rate for the last 4 weeks skipping the last week. </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>Required SKUs:</run>
            <run fontcolor='#000000' fontsize='10'> sum of skus required to be counted during a week.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10'>   Note! From the 2nd week of April 2023 the required SKUs are calculated and presented in IM</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='10'>   Details on the logic of counting in confluence </run>
            <run auto-url='true' fontcolor='#4996b2' fontsize='10' hyperlink='tabdoc:load-url url=&amp;quot;https://confluence.deliveryhero.com/display/GBU/Dark+Stores+-+Random+Cycle+Count&amp;quot;'>https://confluence.deliveryhero.com/display/GBU/Dark+Stores+-+Random+Cycle+Count</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>Gap </run>
            <run fontcolor='#000000' fontsize='10'>: difference between skus counted and required skus to be counted</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>Compliance : </run>
            <run fontcolor='#000000' fontsize='10'>If Gap &gt; 0 then store is compliant </run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontsize='10'>Central Notes : comments generated based on the gap in SKUs counted</run>
            <run>Æ&#10;&#10;&#10;&#10;</run>
          </formatted-text>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='46' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='98222' id='45' param='vert' type-v2='layout-flow' w='98934' x='533' y='889'>
                <zone forceUpdate='true' h='70667' id='3' type-v2='text' w='96200' x='1533' y='1556'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Owner: Tanya Ovchinnikova</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Update for : today-1 day</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Datiled info and comprehensive analitics on all cycle count strategies can be found in DM - Inventory Management - Cycle Count deep dive</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>KPI Definitions</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='14'>Random Results</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='10'>Only  Batched, completed the same week when a cycle count started, are considered</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>CC Week :</run>
                    <run fontcolor='#000000' fontsize='10'> Cycle count started date is considered</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Distinct SKUs Counted: </run>
                    <run fontcolor='#000000' fontsize='10'>sum of distinct SKUs counted during the cycle count</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Share of Assortments:</run>
                    <run fontcolor='#000000' fontsize='10'> sum of distinct SKUs counted during the batch counts / sum of distinct SKUs that are active or not active but has &gt; 0 on hand quantity.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Discrepancy </run>
                    <run fontcolor='#000000' fontsize='10'>: sum of on hand qty - sum of units counted</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>SKU Defect Rate</run>
                    <run fontcolor='#000000' fontsize='10'>: number of SKUs with discrepancies / Distinct SKUs Counted</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Item Level Defect Rate (Gross):</run>
                    <run fontcolor='#000000' fontsize='10'> Absolute(discrepancies)/ sum of on hand qty of counted SKUs</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Item Level Defect Rate (Net): </run>
                    <run fontcolor='#000000' fontsize='10'>discrepancies/ sum of on hand qty of counted SKUs</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Avg SKU Defect rate</run>
                    <run fontcolor='#000000' fontsize='10'>: Avg SKU defect rate for the last 4 weeks skipping the last week. </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Required SKUs:</run>
                    <run fontcolor='#000000' fontsize='10'> sum of skus required to be counted during a week.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='10'>   Note! From the 2nd week of April 2023 the required SKUs are calculated and presented in IM</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='10'>   Details on the logic of counting in confluence </run>
                    <run auto-url='true' fontcolor='#4996b2' fontsize='10' hyperlink='tabdoc:load-url url=&amp;quot;https://confluence.deliveryhero.com/display/GBU/Dark+Stores+-+Random+Cycle+Count&amp;quot;'>https://confluence.deliveryhero.com/display/GBU/Dark+Stores+-+Random+Cycle+Count</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Gap </run>
                    <run fontcolor='#000000' fontsize='10'>: difference between skus counted and required skus to be counted</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='10'>Compliance : </run>
                    <run fontcolor='#000000' fontsize='10'>If Gap &gt; 0 then store is compliant </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontsize='10'>Central Notes : comments generated based on the gap in SKUs counted</run>
                    <run>Æ&#10;&#10;&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{BB82DC83-364C-4572-8D55-3D620E614AC6}' />
    </dashboard>
