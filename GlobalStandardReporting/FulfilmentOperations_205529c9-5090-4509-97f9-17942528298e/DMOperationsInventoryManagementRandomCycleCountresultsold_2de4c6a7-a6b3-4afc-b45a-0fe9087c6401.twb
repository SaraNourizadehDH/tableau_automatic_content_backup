      <column caption='Item Level Defect Rate (Gross)' datatype='real' name='[Calculation_1432074369530474497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([abs_unit_discrepancy_ww])/SUM([on_hand_qty_ww])' />
      </column>
      <column caption='SKU Defect Rate - l4w' datatype='real' name='[Calculation_1432074369532399619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([sku_defect_rate_wk2])&#10;+SUM([sku_defect_rate_wk3])&#10;+SUM([sku_defect_rate_wk4])&#10;+SUM([sku_defect_rate_wk5])) / 4' />
      </column>
      <column caption='SKU Defect Rate ' datatype='real' name='[Calculation_1432074369536335876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([sku_defect_rate])' />
      </column>
