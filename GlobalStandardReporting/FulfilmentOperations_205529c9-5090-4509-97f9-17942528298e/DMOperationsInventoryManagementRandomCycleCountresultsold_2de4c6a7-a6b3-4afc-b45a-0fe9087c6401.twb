            <connection CATALOG='fulfillment-dwh-production' EXECCATALOG='dh-darkstores-live' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='DataHub Production' schema='curated_data_shared_govops' server-oauth='server-custom' username='tatiana.ovchinnikova@deliveryhero.com' workgroup-auth-mode='prompt' />
          </named-connection>
