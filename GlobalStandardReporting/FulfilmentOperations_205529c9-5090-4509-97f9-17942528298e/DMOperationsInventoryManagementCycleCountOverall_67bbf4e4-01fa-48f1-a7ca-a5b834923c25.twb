    <worksheet name='View 2'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff'>Cycle Count Results View</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_cycle_count_report (rl_dmart)' name='federated.0qq36yr1yk17ex11pi1oz1jhcacc' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='English' caption='Category Language' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;English&quot;'>
              <calculation class='tableau' formula='&quot;English&quot;' />
              <aliases>
                <alias key='&quot;English&quot;' value='English' />
              </aliases>
            </column>
            <column alias='Monthly' caption='Date Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Local&quot;'>
              <calculation class='tableau' formula='&quot;Local&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qq36yr1yk17ex11pi1oz1jhcacc'>
            <column caption='Date Count Completed' datatype='date' name='[Batch Date Completed (copy)_2399644559427919884]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 2], [cc_completed_at_date]))' />
            </column>
            <column caption='Batches Completed' datatype='integer' name='[Calculation_2399644559421739017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([batch_id])' />
            </column>
            <column caption='Total Adjustment Value' datatype='real' name='[Calculation_2399644559722954767]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Local&apos; THEN [total_adjustment_local_currency]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Euro&apos; THEN [total_adjustment_euro] END' />
            </column>
            <column caption='is_defect' datatype='boolean' name='[Calculation_4170333262463623169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [picker_final_count] != [on_hand_qty] then TRUE ELSE FALSE END' />
            </column>
            <column caption='SKU Defect Rate' datatype='real' name='[Calculation_4170333262463983618]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [Calculation_4170333262463623169] WHEN TRUE THEN [product_id] END)/COUNTD([product_id])' />
            </column>
            <column caption='Item Level Defect Rate (Net)' datatype='real' name='[Calculation_4170333262464962563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([on_hand_qty])-SUM([picker_final_count]))/sum([on_hand_qty])' />
            </column>
            <column caption='SKU Category' datatype='string' name='[Calculation_4170333264210554889]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;English&apos; THEN [category_parent_english]&#10;ELSE [category_parent_local] END' />
            </column>
            <column caption='Unit Discrepancy (Abs.)' datatype='integer' name='[Calculation_4170333264576876558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS([discrepancy])' />
            </column>
            <column caption='SKUs Counted' datatype='integer' name='[Calculation_4170333264920129552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([sku_id])' />
            </column>
            <column caption='Complete Time Period - Cycle Count' datatype='string' name='[Complete Time Period - Batch (copy)_2399644559427592203]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF MAX([Batch Date Completed (copy)_2399644559427919884]) &lt; DATETRUNC([Parameters].[Parameter 2], TOTAL(MAX([Batch Date Completed (copy)_2399644559427919884])))&#10;THEN &apos;Yes&apos; ELSE &apos;No&apos; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Item Level Defect Rate (Gross)' datatype='real' name='[Unit Defect Rate  (copy)_545920762773131264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_4170333264576876558])/sum([on_hand_qty])' />
            </column>
            <column caption='Batch Id' datatype='string' name='[batch_id]' role='dimension' type='nominal' />
            <column caption='Category Parent English' datatype='string' name='[category_parent_english]' role='dimension' type='nominal' />
            <column caption='Category Parent Local' datatype='string' name='[category_parent_local]' role='dimension' type='nominal' />
            <column caption='Cc Completed At Date' datatype='date' name='[cc_completed_at_date]' role='dimension' type='ordinal' />
