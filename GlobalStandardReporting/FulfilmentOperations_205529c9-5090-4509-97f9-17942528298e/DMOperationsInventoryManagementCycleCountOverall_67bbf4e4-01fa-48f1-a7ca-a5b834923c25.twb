      <column caption='SKUs in all Stores (Country Level) - with CC' datatype='integer' name='[SKU in Warehouse (Count Level) (copy)_545920762859921422]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({FIXED [country], [store_name]: &#10;MAX(if [batch_completed_at_date]= {FIXED [batch_id]: MAX([batch_completed_at_date])} then [warehouse_skus] END)&#10;})' />
