          <alias key='&quot;[federated.0qq36yr1yk17ex11pi1oz1jhcacc].[usr:Calculation_4170333262744092680:qk]&quot;' value='Counts Defect Rate (Only for SKU Level)' />
          <alias key='&quot;[federated.0qq36yr1yk17ex11pi1oz1jhcacc].[usr:Calculation_4170333264920129552:qk]&quot;' value='Distinct SKUs Counted' />
          <alias key='&quot;[federated.0qq36yr1yk17ex11pi1oz1jhcacc].[usr:Central Notes (copy)_545920763215085595:qk:1]&quot;' value='Central Notes' />
        </aliases>
      </column>
      <column caption='Date Count Completed' datatype='date' name='[Batch Date Completed (copy)_2399644559427919884]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 2], [cc_completed_at_date]))' />
      </column>
      <column caption='Date Batch Completed' datatype='date' name='[Calculation_2399644558023360512]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 2], [batch_completed_at_date]))' />
      </column>
      <column caption='Complete Time Period - Batch' datatype='string' name='[Calculation_2399644559037530118]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MAX([Calculation_2399644558023360512]) &lt; DATETRUNC([Parameters].[Parameter 2], TOTAL(MAX([Calculation_2399644558023360512])))&#10;THEN &apos;Yes&apos; ELSE &apos;No&apos; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Country*' datatype='string' name='[Calculation_2399644559091195911]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[country]' />
      </column>
      <column caption='Batches Completed' datatype='integer' name='[Calculation_2399644559421739017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([batch_id])' />
      </column>
      <column caption='Total Adjustment Value' datatype='real' name='[Calculation_2399644559722954767]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 3] = &apos;Local&apos; THEN [total_adjustment_local_currency]&#10;ELSEIF [Parameters].[Parameter 3] = &apos;Euro&apos; THEN [total_adjustment_euro] END' />
      </column>
      <column caption='is_defect' datatype='boolean' name='[Calculation_4170333262463623169]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [picker_final_count] != [on_hand_qty] then TRUE ELSE FALSE END' />
      </column>
      <column caption='SKU Defect Rate' datatype='real' name='[Calculation_4170333262463983618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(CASE [Calculation_4170333262463623169] WHEN TRUE THEN [product_id] END)/COUNTD([product_id])' />
      </column>
      <column caption='Item Level Defect Rate (Net)' datatype='real' name='[Calculation_4170333262464962563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([on_hand_qty])-SUM([picker_final_count]))/sum([on_hand_qty])' />
      </column>
      <column caption='Counts Defect Rate' datatype='real' name='[Calculation_4170333262744092680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_product_defect] = TRUE THEN [cycle_count_id] END)/COUNTD([cycle_count_id])' />
      </column>
      <column caption='SKU Category' datatype='string' name='[Calculation_4170333264210554889]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;English&apos; THEN [category_parent_english]&#10;ELSE [category_parent_local] END' />
      </column>
      <column caption='SKU Sub Category' datatype='string' name='[Calculation_4170333264210939914]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;English&apos; THEN [category_english]&#10;ELSE [category_local] END' />
      </column>
      <column caption='SKUs in all Stores (Batch Level)' datatype='integer' name='[Calculation_4170333264279437323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [batch_completed_at_date]= {FIXED  [batch_id]: MAX([batch_completed_at_date])} then [warehouse_skus] END' />
      </column>
      <column caption='Unit Discrepancy (Abs.)' datatype='integer' name='[Calculation_4170333264576876558]' role='measure' type='quantitative'>
