      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0qq36yr1yk17ex11pi1oz1jhcacc].[sum:Calculation_4170333264576876558:qk]&quot;' value='Unit    Discrepancy    (Abs.)' />
