      <column caption='SKU Defect Rate l4w' datatype='real' name='[Calculation_5821043302225956864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_4170333262463983618],-4,0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Distinct SKU test' datatype='integer' name='[Calculation_6439866055891599360]' role='measure' type='quantitative'>
