                <zone forceUpdate='true' h='20858' id='11' type-v2='text' w='98978' x='511' y='30213'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ffffff' fontsize='14'>Cycle Count Results &amp; Batch Results</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Batches Completed</run>
                    <run fontcolor='#ffffff' fontsize='10'>: sum of completed batches</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Distinct SKUs Counted</run>
                    <run fontcolor='#ffffff' fontsize='10'>: sum of distinct SKUs counted during the batch or cycle count</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Share of Assortments</run>
                    <run fontcolor='#ffffff' fontsize='10'>: sum of distinct SKUs counted during  the batch or cycle count / sum of distinct SKUs that are active or not active but has &gt; 0 on hand quantity.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontsize='10'>The denominator is from the date the batch or cycle count was completed</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Total Units</run>
                    <run fontcolor='#ffffff' fontsize='10'>: sum of on hand qty of targeted SKUs</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>SKU Defect Rate</run>
                    <run fontcolor='#ffffff' fontsize='10'>: count of SKUs with discrepancies / sum of total SKUs counted</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Item Level Defect Rate (Net)</run>
                    <run fontcolor='#ffffff' fontsize='10'>:  (sum of on hand qty of targeted SKUs - sum of units counted  of targeted SKUs)/ sum of on hand qty of trageted SKUs</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Item Level Defect Rate (Gross)</run>
                    <run fontcolor='#ffffff' fontsize='10'>: Absolute(sum of on hand qty of trageted SKUs- sum of units counted  of targeted SKUs)/ sum of on hand qty of trageted SKUs</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Units Discrepancy (Net)</run>
                    <run fontcolor='#ffffff' fontsize='10'>: sum of on hand qty of trageted SKUs - total units counted</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Units Discrepancy (Abs)</run>
                    <run fontcolor='#ffffff' fontsize='10'>: sum of absolute units discrepancy</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Total Adjustments (Units)</run>
                    <run fontcolor='#ffffff' fontsize='10'>: sum of stock adjustments triggered by the cycle count</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Total Adjustments (Value)</run>
                    <run fontcolor='#ffffff' fontsize='10'>: sum of all adjustments per SKU * SKU&apos;s WAC in Euro or local currency</run>
                    <run>Æ&#10;&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#555555' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='18286' id='5' type-v2='text' w='98978' x='511' y='51071'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ffffff' fontsize='14'>Category/SKU Overview</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Batches Completed</run>
                    <run fontcolor='#ffffff' fontsize='10'>: number of times SKU was included in a completed batch</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Total Units</run>
                    <run fontcolor='#ffffff' fontsize='10'>: sum of on hand qty of trageted SKUs</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Counts Defect Rate</run>
                    <run fontcolor='#ffffff' fontsize='10'>: number of batch counts in which the SKU had differences / number of batch counts for the SKU</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Item Level Defect Rate (Net)</run>
                    <run fontcolor='#ffffff' fontsize='10'>:  (sum of on hand qty of trageted SKUs- sum of units counted  of targeted SKUs)/ sum of on hand qty of trageted SKUs</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Item Level Defect Rate (Gross)</run>
                    <run fontcolor='#ffffff' fontsize='10'>: Absolute(sum of on hand qty of trageted SKUs- sum of units counted  of targeted SKUs)/ sum of on hand qty of trageted SKUs</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Units Discrepancy (Net)</run>
                    <run fontcolor='#ffffff' fontsize='10'>: sum of on hand qty of trageted SKUs- total units counted</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Units Discrepancy (Abs)</run>
                    <run fontcolor='#ffffff' fontsize='10'>: sum of absolute units discrepancy</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Total Adjustments (Units)</run>
                    <run fontcolor='#ffffff' fontsize='10'>: sum of stock adjustments triggered by the cycle count</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Total Adjustments (Value)</run>
                    <run fontcolor='#ffffff' fontsize='10'>: sum of all adjustments of the SKU * the SKU&apos;s WAC in Euro or local currency</run>
                    <run>Æ&#10;&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#555555' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='27607' id='189' type-v2='text' w='98978' x='511' y='69357'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ffffff' fontsize='14'>Random Results</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>SKU Defect Rate</run>
                    <run fontcolor='#ffffff' fontsize='10'>: number of batch counts in which the SKU had differences / number of batch counts for the SKU</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Item Level Defect Rate (Gross)</run>
                    <run fontcolor='#ffffff' fontsize='10'>: Absolute(sum of on hand qty of targeted SKUs- sum of units counted  of targeted SKUs)/ sum of on hand qty of trageted SKUs</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Distinct SKUs Counted</run>
                    <run fontcolor='#ffffff' fontsize='10'>: sum of distinct SKUs counted during the batch or cycle count</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Required SKUs</run>
                    <run fontcolor='#ffffff' fontsize='10'>: sum of skus required to be counted based on Cochran&apos;s Formula</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Æ  </run>
                    <run bold='true' fontcolor='#ffffff' fontsize='11'> N = (Z² * p * q )/ e²</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontsize='10'>Æ           </run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>N </run>
                    <run fontcolor='#ffffff' fontsize='10'>= Sample size</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontsize='10'>Æ       </run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>    Z </run>
                    <run fontcolor='#ffffff' fontsize='10'>= Z score (based on confidence level) fixed at 1.96 aka 95% CL</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontsize='10'>Æ           </run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>p</run>
                    <run fontcolor='#ffffff' fontsize='10'> = Variability ( estimated proportion of an attribute that is present in the population) Avg SKU Defect rate for the last 4 weeks or a variability of 50%</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontsize='10'>Æ      </run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>     q</run>
                    <run fontcolor='#ffffff' fontsize='10'> = 1 - p</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontsize='10'>Æ           </run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>e </run>
                    <run fontcolor='#ffffff' fontsize='10'>= Margin of error </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Required SKUs (Adj)</run>
                    <run fontcolor='#ffffff' fontsize='10'><![CDATA[: Adjusted sample size for cases where population is significantly low (e.g. <400)]]></run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Æ  </run>
                    <run bold='true' fontcolor='#ffffff' fontsize='11'> N = n/(1+((n-1 )/ P))</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontsize='10'>Æ           </run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>n </run>
                    <run fontcolor='#ffffff' fontsize='10'>= Required SKUs</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontsize='10'>Æ       </run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>    P </run>
                    <run fontcolor='#ffffff' fontsize='10'>= Population size (Active SKUs per warehouse)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Gap </run>
                    <run fontcolor='#ffffff' fontsize='10'>: difference between skus counted and required skus to be counted</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Statistical Accuracy </run>
                    <run fontcolor='#ffffff' fontsize='10'>:  1 - margin of error genrated from counted SKUs</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#ffffff' fontsize='10'>(Note: Margin of error here is calculated by replacing </run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>N</run>
                    <run fontcolor='#ffffff' fontsize='10'> with the distinct SKUs counted and solving for </run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>e </run>
                    <run fontcolor='#ffffff' fontsize='10'>using the formula above)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Central Notes </run>
                    <run fontcolor='#ffffff' fontsize='10'>: comments generated based on the gap in SKUs counted</run>
                    <run>Æ&#10;&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
                <format attr='background-color' value='#666666' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{8AD4F223-809B-4D79-B69D-2F6CDA69E094}' />
    </dashboard>
  </dashboards>
