    <worksheet name='View 4'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_cycle_count_report (rl_dmart)' name='federated.0qq36yr1yk17ex11pi1oz1jhcacc' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Date Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qq36yr1yk17ex11pi1oz1jhcacc'>
            <column caption='Date Batch Completed' datatype='date' name='[Calculation_2399644558023360512]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATETRUNC([Parameters].[Parameter 2], [batch_completed_at_date]))' />
            </column>
            <column caption='Complete Time Period - Batch' datatype='string' name='[Calculation_2399644559037530118]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF MAX([Calculation_2399644558023360512]) &lt; DATETRUNC([Parameters].[Parameter 2], TOTAL(MAX([Calculation_2399644558023360512])))&#10;THEN &apos;Yes&apos; ELSE &apos;No&apos; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='is_defect' datatype='boolean' name='[Calculation_4170333262463623169]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [picker_final_count] != [on_hand_qty] then TRUE ELSE FALSE END' />
            </column>
            <column caption='SKU Defect Rate' datatype='real' name='[Calculation_4170333262463983618]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [Calculation_4170333262463623169] WHEN TRUE THEN [product_id] END)/COUNTD([product_id])' />
            </column>
            <column caption='Unit Discrepancy (Abs.)' datatype='integer' name='[Calculation_4170333264576876558]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS([discrepancy])' />
            </column>
            <column caption='SKUs Counted' datatype='integer' name='[Calculation_4170333264920129552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([sku_id])' />
            </column>
            <column caption='Week Batch Completed' datatype='date' name='[Calculation_545920762874077202]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [batch_completed_at_date]))' />
            </column>
            <column caption='Required SKU Counts' datatype='real' name='[Calculation_545920763170115604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SQUARE(1.96)*[SKU Defect Rate l4w (adj) (copy)_1615455298004508687] *(1-[SKU Defect Rate l4w (adj) (copy)_1615455298004508687] ))/SQUARE(0.05)' />
            </column>
            <column caption='Cycle Count Significance' datatype='boolean' name='[Calculation_545920763199176729]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_4170333264920129552]-[Calculation_545920763170115604] &gt;= 0 THEN True&#10;ELSE False END' />
            </column>
            <column caption='Central Notes' datatype='integer' datatype-customized='true' name='[Central Notes (copy)_545920763215085595]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='INT(IF [Calculation_545920763199176729] &#10;THEN &quot;OK&quot; ELSE &quot;Please Explain...&quot; END)' />
            </column>
            <column caption='Store Name*' datatype='string' name='[Country* (copy)_545920762875469843]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='[store_name]' />
            </column>
            <column caption='SKU Defect Rate l4w (temp)' datatype='real' name='[SKU Defect Rate l4w (adj) (copy)_1615455298004508687]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(0.5)' />
            </column>
            <column caption='SKUs Counted Statistical Accuracy' datatype='real' name='[SKUs Counted Margin of Error (Statistical Accuracy) (copy)_545920763176587287]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(SQRT((SQUARE(1.96)*[SKU Defect Rate l4w (adj) (copy)_1615455298004508687]*(1-[SKU Defect Rate l4w (adj) (copy)_1615455298004508687]))/([Calculation_4170333264920129552])))' />
            </column>
            <column caption='SKUs in all Stores (Store Level)' datatype='integer' name='[SKUs in all Stores (Store Level) (copy)_1615455297077460998]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [batch_completed_at_date]= {FIXED [batch_id]: MAX([batch_completed_at_date])} then [warehouse_skus] END' />
