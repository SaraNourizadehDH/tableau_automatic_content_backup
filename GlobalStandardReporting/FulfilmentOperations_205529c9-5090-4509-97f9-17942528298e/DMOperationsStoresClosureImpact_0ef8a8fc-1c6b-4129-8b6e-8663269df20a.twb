      <column caption='Metric' datatype='real' name='[Calculation_2004735197318619139]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Scheduled Hours&quot; THEN SUM([avg_scheduled_hours]) &#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Offline Hours&quot; THEN SUM([total_offline_minutes])/60&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Lost Orders&quot; THEN SUM([lost_orders])&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Lost GMV&quot; THEN SUM([lost_gmv])&#10;ELSEIF  [Parameters].[Parameter 1] = &quot;Lost GMV %&quot;  THEN SUM([lost_gmv])/sum([last_30_gmv])*100&#10;ELSE 0 END' />
      </column>
