    <worksheet name='Purchase Order Related (Comparison)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='18'><![CDATA[<[Parameters].[p_comparison - Orders Related KPIs (copy)_2122251000566169641]>]]></run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#b4b4b4' fontsize='10'><![CDATA[<[federated.14fmp3m0u0tkz31ff8n6f1gg6c4i].[attr:d_comparison - KPIs - Orders Related - KPIs Descriptions (copy)_2122251000585138224:nk]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_store_performance_report (rl_dmart)' name='federated.14fmp3m0u0tkz31ff8n6f1gg6c4i' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='A Country' caption='p_comparison - What would you like to compare' datatype='string' name='[KPI Switcher - 2 (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;country&quot;'>
              <calculation class='tableau' formula='&quot;country&quot;' />
              <aliases>
                <alias key='&quot;country&quot;' value='A Country' />
                <alias key='&quot;warehouse&quot;' value='A Warehouse' />
              </aliases>
            </column>
            <column alias='Monthly' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.14fmp3m0u0tkz31ff8n6f1gg6c4i].[Country* (copy)_3974356351466971139]' caption='p_comparison - Selected Country' datatype='string' name='[Time Aggregation (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Costa Rica&quot;'>
              <calculation class='tableau' formula='&quot;Costa Rica&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.14fmp3m0u0tkz31ff8n6f1gg6c4i].[warehouse_name]' caption='p_comparison - Selected Warehouse' datatype='string' name='[country_selected (copy)_2122250999810654213]' param-domain-type='list' role='measure' type='nominal' value='&quot;AR_3_Belgrano&quot;'>
              <calculation class='tableau' formula='&quot;AR_3_Belgrano&quot;' />
            </column>
            <column caption='p_comparison - KPIs - Purchase Order Related' datatype='string' name='[p_comparison - Orders Related KPIs (copy)_2122251000566169641]' param-domain-type='list' role='measure' type='nominal' value='&quot;POs received&quot;'>
              <calculation class='tableau' formula='&quot;POs received&quot;' />
              <aliases>
                <alias key='&quot;Avg. Receiving Time/PO&quot;' value='Avg. Receiving Time / PO' />
                <alias key='&quot;Avg. Receiving Time/SKU&quot;' value='Receiving Time / SKU' />
                <alias key='&quot;Avg. SKUs/PO&quot;' value='SKUs / PO' />
                <alias key='&quot;Units Counted&quot;' value='Units Counted (from Cicle Count)' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.14fmp3m0u0tkz31ff8n6f1gg6c4i'>
            <column caption='Avg. Daily Successful Order Qty' datatype='real' name='[Avg. Daily Successful order (copy)_4752001314040172546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED[warehouse_id],[Calculation_6745055255008800768]:(sum([order_qty_delivered])/countd([static_day]))}' />
            </column>
            <column caption='Receiving Specific Hour (h)' datatype='real' name='[Calculation_1038150109110513674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[receiving_time_specific_hour_s]/3600' />
            </column>
            <column caption='Complete Time Period' datatype='boolean' name='[Calculation_1038150110095208477]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[static_day] &lt; {MAX(DATETRUNC([Parameters].[Parameter 1],[static_day]))}' />
            </column>
            <column caption='Avg. SKUs/PO' datatype='real' name='[Calculation_131941420227903494]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([purchase_order_skus])/SUM([purchase_orders]))' />
            </column>
            <column caption='Avg. Receiving Time/SKU [m]' datatype='real' name='[Calculation_131941420228218887]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([Calculation_1038150109110513674])*60/sum([purchase_order_skus]))' />
            </column>
            <column caption='d_comparison - X-Axis' datatype='string' name='[Calculation_2122250999791771649]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[KPI Switcher - 2 (copy)]&#10;WHEN &apos;country&apos; THEN [Country* (copy)_3974356351466971139] &#10;ELSE STR([Calculation_2122250999881494535]) &#10;END' />
            </column>
            <column caption='m_comparison - Color Filter' datatype='integer' name='[Calculation_2122250999811817478]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[KPI Switcher - 2 (copy)]&#10;    WHEN &quot;country&quot;&#10;        THEN &#10;            IF [Country* (copy)_3974356351466971139] = [Parameters].[Time Aggregation (copy)] &#10;                THEN 1 &#10;                ELSE 0&#10;            END&#10;    ELSE&#10;             IF [Calculation_2122250999881494535] = [Parameters].[country_selected (copy)_2122250999810654213]&#10;                THEN 1 &#10;                ELSE 0&#10;            END&#10;END' />
            </column>
            <column caption='d_comparison - Warehouse Name' datatype='string' name='[Calculation_2122250999881494535]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[KPI Switcher - 2 (copy)] = &quot;warehouse&quot; THEN [warehouse_name] ELSE NULL END' />
            </column>
            <column caption='RANK([m_comparison - KPIs - Purchase Order Related])' datatype='integer' name='[Calculation_2122251000588193845]' role='measure' type='quantitative' user:unnamed='Purchase Order Related (Comparison)'>
              <calculation class='tableau' formula='RANK([m_comparison - Orders Related KPI (copy)_2122251000566448170])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='RANK([m_comparison - KPIs - Purchase Order Related])' datatype='integer' name='[Calculation_2122251000589230135]' role='measure' type='quantitative' user:unnamed='Purchase Order Related (Comparison)'>
              <calculation class='tableau' formula='RANK([m_comparison - Orders Related KPI (copy)_2122251000566448170])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Total Unit Counted' datatype='real' name='[Calculation_321796297260433422]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn([units_counted])+zn([final_count])' />
            </column>
            <column caption='Is Preorder' datatype='boolean' name='[Calculation_3349200418215763968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [preorders] &gt; 1 THEN TRUE &#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Country*' datatype='string' name='[Calculation_4217198858826571776]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([country],[country])' />
            </column>
            <column caption='Region*' datatype='string' name='[Calculation_4217198858827358209]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([region],[region])' />
            </column>
            <column caption='Avg. PO Receiving Time (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4397694676588900371]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1038150109110513674]) * 60 / sum([purchase_orders])' />
            </column>
            <column caption='Date' datatype='datetime' default-format='*YY-MM-DD' name='[Calculation_5305803324295176197]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;day&apos; THEN DATETRUNC(&apos;day&apos;, [static_day]) &#10;WHEN &apos;week&apos; THEN DATETRUNC(&apos;week&apos;, [static_day])&#10;WHEN &apos;month&apos; THEN DATETRUNC(&apos;month&apos;, [static_day])  &#10;WHEN &apos;quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [static_day]) &#10;END' />
            </column>
            <column caption='Month of Date' datatype='date' name='[Calculation_6745055255008800768]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[Calculation_5305803324295176197]))' />
            </column>
            <column caption='Avg. Daily Successful Order' datatype='real' name='[Calculation_6745055255009910787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED[warehouse_id],[Calculation_6745055255008800768]:(sum([successful_orders])/countd([static_day]))}' />
            </column>
            <column caption='Is Avg. Daily Success Order &gt;300' datatype='string' name='[Calculation_6745055255009955844]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Calculation_6745055255009910787] &gt;= 300 THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
            </column>
            <column caption='Country 2' datatype='string' name='[Country* (copy)_3974356351466971139]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <calculation class='tableau' formula='IFNULL([country],[country])' />
            </column>
            <column caption='Is Avg. Daily Success Order Qty &gt;2800' datatype='string' name='[Is Avg. Daily Success order &gt;300 (copy)_4752001314039861248]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Avg. Daily Successful order (copy)_4752001314040172546] &gt;= 2800 THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
            </column>
            <column caption='Is Stacked Delivery' datatype='boolean' name='[Is Preorder (copy)_4976618371942137859]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [stacked_orders] &gt; 1 THEN TRUE &#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Is Manual Dispatching' datatype='boolean' name='[Is Stacked Delivery (copy)_4976618371942670340]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [manual_dispatching] &gt; 1 THEN TRUE &#10;ELSE FALSE&#10;END' />
            </column>
            <column-instance column='[d_comparison - KPIs - Orders Related - KPI&apos;s Tooltip Text (copy)_2122251000585302065]' derivation='Attribute' name='[attr:d_comparison - KPIs - Orders Related - KPI&apos;s Tooltip Text (copy)_2122251000585302065:nk]' pivot='key' type='nominal' />
            <column-instance column='[d_comparison - KPIs - Orders Related - KPIs Descriptions (copy)_2122251000585138224]' derivation='Attribute' name='[attr:d_comparison - KPIs - Orders Related - KPIs Descriptions (copy)_2122251000585138224:nk]' pivot='key' type='nominal' />
            <column-instance column='[m_comparison - KPIs - Orders Related - KPIs Share or vs AVG (copy)_2122251000584151084]' derivation='Attribute' name='[attr:m_comparison - KPIs - Orders Related - KPIs Share or vs AVG (copy)_2122251000584151084:qk]' pivot='key' type='quantitative' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='d_comparison - KPIs - Purchase Order Related - KPI&apos;s Tooltip Text' datatype='string' name='[d_comparison - KPIs - Orders Related - KPI&apos;s Tooltip Text (copy)_2122251000585302065]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [d_comparison - KPIs - Orders Related - KPIs Sufix (copy)_2122251000584929326] = &quot;%&quot; OR [d_comparison - KPIs - Orders Related - KPIs Sufix (copy)_2122251000584929326] = &quot; &quot; THEN &quot;This value / total AVG&quot; ELSE &quot;Share&quot; END' />
            </column>
            <column caption='d_comparison - KPIs - Purchase Order Related - KPIs Descriptions' datatype='string' name='[d_comparison - KPIs - Orders Related - KPIs Descriptions (copy)_2122251000585138224]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[p_comparison - Orders Related KPIs (copy)_2122251000566169641]&#10;    &#10;    WHEN &quot;POs received&quot;&#10;    THEN &quot;Number of purchase orders received&quot;&#10;&#10;    WHEN &quot;Avg. SKUs/PO&quot;&#10;    THEN &quot;Average number of SKUs per purchase order&quot;&#10;&#10;    WHEN &quot;Avg. Receiving Time/SKU&quot;&#10;    THEN &quot;Average time for a picker to receive a SKU&quot;&#10;&#10;    WHEN &quot;Avg. Receiving Time/PO&quot;&#10;    THEN &quot;Average time for a picker to receive a PO&quot;&#10;&#10;    WHEN &quot;Units Counted&quot;&#10;    THEN &quot;Number of units counted in cycle counts&quot;&#10;&#10;END' />
            </column>
            <column caption='d_comparison - KPIs - Purchase Order Related - KPIs Sufix' datatype='string' default-format='N' name='[d_comparison - KPIs - Orders Related - KPIs Sufix (copy)_2122251000584929326]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[p_comparison - Orders Related KPIs (copy)_2122251000566169641]&#10;&#10;    WHEN &quot;Late Orders&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Partial Fulfilment Rate %&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Fulfilment Time Breach %&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Avg. Basket Size&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Modified Orders&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Avg. SKUs/PO&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Avg. Receiving Time/SKU&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Avg. Receiving Time/PO&quot;&#10;    THEN &quot; &quot;&#10;&#10;END' />
            </column>
            <column caption='Final Count' datatype='real' name='[final_count]' role='measure' type='quantitative' />
            <column caption='m_comparison - KPIs - Purchase Order Related - KPIs Share or vs AVG' datatype='real' default-format='p0.0%' name='[m_comparison - KPIs - Orders Related - KPIs Share or vs AVG (copy)_2122251000584151084]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [d_comparison - KPIs - Orders Related - KPIs Sufix (copy)_2122251000584929326] = &quot;%&quot; OR [d_comparison - KPIs - Orders Related - KPIs Sufix (copy)_2122251000584929326] = &quot; &quot;THEN&#10;{ INCLUDE  [Calculation_2122250999791771649] : [m_comparison - Orders Related KPI (copy)_2122251000566448170] } &#10;/&#10;{ EXCLUDE  [Calculation_2122250999791771649] : [m_comparison - Orders Related KPI (copy)_2122251000566448170] } -1&#10;ELSE&#10;{ INCLUDE  [Calculation_2122250999791771649] : [m_comparison - Orders Related KPI (copy)_2122251000566448170] } &#10;/&#10;{ EXCLUDE  [Calculation_2122250999791771649] : [m_comparison - Orders Related KPI (copy)_2122251000566448170] }&#10;END' />
            </column>
            <column caption='m_comparison - KPIs - Purchase Order Related - KPIs Share or vs AVG for Line' datatype='real' default-format='p0.0%' name='[m_comparison - KPIs - Orders Related - KPIs Share or vs AVG for Line  (copy)_2122251000584159277]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [d_comparison - KPIs - Orders Related - KPIs Sufix (copy)_2122251000584929326] = &quot;%&quot; OR [d_comparison - KPIs - Orders Related - KPIs Sufix (copy)_2122251000584929326] = &quot; &quot;THEN&#10;{ INCLUDE  [Calculation_2122250999791771649] : [m_comparison - Orders Related KPI (copy)_2122251000566448170] } &#10;/&#10;{ EXCLUDE  [Calculation_2122250999791771649] : [m_comparison - Orders Related KPI (copy)_2122251000566448170] } -1&#10;END' />
            </column>
            <column caption='m_comparison - KPIs - Purchase Order Related' datatype='real' default-format='N' name='[m_comparison - Orders Related KPI (copy)_2122251000566448170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[p_comparison - Orders Related KPIs (copy)_2122251000566169641]&#10;&#10;    WHEN &quot;POs received&quot;&#10;    THEN SUM([purchase_orders])&#10;&#10;    WHEN &quot;Avg. SKUs/PO&quot;&#10;    THEN ROUND([Calculation_131941420227903494],2)&#10;&#10;    WHEN &quot;Avg. Receiving Time/PO&quot;&#10;    THEN ROUND([Calculation_4397694676588900371],2)&#10;&#10;    WHEN &quot;Avg. Receiving Time/SKU&quot;&#10;    THEN ROUND([Calculation_131941420228218887],2)&#10;&#10;    WHEN &quot;Units Counted&quot;&#10;    THEN SUM([Calculation_321796297260433422])&#10;&#10;END' />
            </column>
