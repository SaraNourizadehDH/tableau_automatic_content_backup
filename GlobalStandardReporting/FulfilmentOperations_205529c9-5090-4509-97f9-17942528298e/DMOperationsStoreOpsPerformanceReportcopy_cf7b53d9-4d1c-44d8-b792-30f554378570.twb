            </column>
            <column caption='Avg. Picking Time (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4397694676585279502]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([picking_time_s])/sum([picking_time_count]) / 60' />
            </column>
            <column caption='Avg. Packaging Time (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4397694676585443343]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([packaging_time_s])/sum([packaging_time_count]) / 60' />
