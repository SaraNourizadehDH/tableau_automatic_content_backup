            <column caption='m_comparison - KPIs - Full3' datatype='real' name='[m_comparison - KPIs - Full2 (copy)_3974356351624507468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[p_comparison - KPIs - Full2 (copy)_3974356351624400971]&#10;&#10;    WHEN &quot;Orders&quot;&#10;    THEN SUM([orders])&#10;&#10;    WHEN &quot;Successful Orders&quot;&#10;    THEN SUM([successful_orders])&#10;&#10;    WHEN &quot;Late Orders&quot;&#10;    THEN ROUND(([% Orders Delivered &lt; 20m (copy)_4976618371944071176] * 100),2)&#10;&#10;    WHEN &quot;Partial Fulfilment Rate %&quot;&#10;    THEN ROUND(([Calculation_4217198863434866694] * 100),2)&#10;&#10;    WHEN &quot;Fail Rate&quot;&#10;    THEN ROUND(([Calculation_4397694676583907339] * 100), 2)&#10;&#10;    WHEN &quot;Fulfilment Time Breach %&quot;&#10;    THEN ROUND(((SUM(IF [fulfillment_time_s] &gt; 120 THEN [successful_orders] END) / SUM([successful_orders]))*100),2)&#10;&#10;    WHEN &quot;Handled Externally&quot;&#10;    THEN SUM([orders_handled_externally])&#10;&#10;    WHEN &quot;Modified Orders&quot;&#10;    THEN ROUND(([Calculation_4397694676583690250] * 100),2)&#10;&#10;    WHEN &quot;Total Items&quot;&#10;    THEN SUM([order_qty])&#10;&#10;    WHEN &quot;Avg. Basket Size&quot;&#10;    THEN ROUND([Calculation_4397694676580687876], 2)&#10;    WHEN &quot;POs received&quot;&#10;    THEN SUM([purchase_orders])&#10;&#10;    WHEN &quot;Avg. SKUs/PO&quot;&#10;    THEN ROUND([Calculation_131941420227903494],2)&#10;&#10;    WHEN &quot;Avg. Receiving Time/PO&quot;&#10;    THEN ROUND([Calculation_4397694676588900371],2)&#10;&#10;    WHEN &quot;Avg. Receiving Time/SKU&quot;&#10;    THEN ROUND([Calculation_131941420228218887],2)&#10;&#10;    WHEN &quot;Units Counted&quot;&#10;    THEN SUM([Calculation_321796297260433422])&#10;&#10;    WHEN &quot;Put-away time/ SKU (s)&quot;&#10;    THEN ROUND([Put-away time Corr./ SKU (m) (copy)_171559011643076609], 0)&#10;&#10;    WHEN &quot;Put-away time Corr&quot;&#10;    THEN ROUND(SUM([putaway_time_corr]), 0)&#10;&#10;    WHEN &quot;Put-away time Corr./ SKU (s)&quot;&#10;    THEN ROUND([Calculation_171559011641389056], 0)&#10;&#10;    WHEN &quot;Put-away time Corr./ Batch (m)&quot;&#10;    THEN ROUND([Put-away time Corr./ Unit (s) (copy)_2148287410332180481], 2)&#10;&#10;    WHEN &quot;Put-away time Corr./ Unit (s)&quot;&#10;    THEN ROUND([Put-away time Corr./ SKU (s) (copy)_2148287410331680768], 0)&#10;&#10;    WHEN &quot;% Batches with Putaway time/SKU &gt;10mins&quot;&#10;    THEN ROUND([Put-away time Corr./ SKU (s) (copy)_2148287410333822978] * 100, 2)&#10;&#10;    WHEN &quot;Putaway Batch Count&quot;&#10;    THEN ROUND(SUM([putaway_batch_count]), 0)&#10;&#10;    WHEN &quot;SKU Put-away per Batch&quot;&#10;    THEN ROUND([Calculation_171559011643678722], 0)&#10;&#10;    WHEN &quot;Putaway Units per Batch&quot;&#10;    THEN ROUND([SKU Put-away per Batch (copy)_171559011643969539], 0)&#10;&#10;    WHEN &quot;Evaluated Shifts&quot;&#10;    THEN SUM([shifts])&#10;&#10;    WHEN &quot;No- Clock Out Shifts&quot;&#10;    THEN ROUND(SUM([Calculation_2923821344461168644]),2)&#10;&#10;    WHEN &quot;No- Clock Out Shifts (%)&quot;&#10;    THEN ROUND((SUM([Calculation_2923821344461168644])/SUM([shifts])) * 100, 2)&#10;&#10;    WHEN &quot;Overtime&quot;&#10;    THEN ROUND(SUM([non_clock_out_hours]), 2)&#10;&#10;    WHEN &quot;Overtime (%)&quot;&#10;    THEN ROUND((SUM([non_clock_out_hours])/SUM([worked_hours])) * 100, 2)&#10;&#10;    WHEN &quot;Hours Worked&quot;&#10;    THEN ROUND(SUM([Calculation_4397694676603695132]),1)&#10;&#10;    WHEN &quot;Scheduled Hours&quot;&#10;    THEN ROUND(SUM([Calculation_2923821344460640259]),1)&#10;&#10;    WHEN &quot;Attendance (%)&quot;&#10;    THEN ROUND((SUM([Calculation_4397694676603695132]) / SUM([Calculation_2923821344460640259])) * 100, 2)&#10;&#10;    WHEN &quot;Order UTR&quot;&#10;    THEN ROUND([Calculation_4397694676590141461], 1)&#10;&#10;    WHEN &quot;Item UTR&quot;&#10;    THEN ROUND([Calculation_131941420225449989], 1)&#10;&#10;    //WHEN &quot;Picker Est. CPO&quot;&#10;    //THEN [Est. CPO]&#10;&#10;    WHEN &quot;Hours Worked Prep. Orders&quot;&#10;    THEN ROUND(SUM([Calculation_1038150109110329353]), 1)&#10;&#10;    //WHEN &quot;Occupancy (%)&quot;&#10;    //THEN ([Hours Worked Receiving] + picki&#10;&#10;    WHEN &quot;Picking Occupancy&quot;&#10;    THEN ROUND([Calculation_4397694676600127512] * 100, 1)&#10;&#10;    WHEN &quot;Receiving Occupancy&quot;&#10;    THEN ROUND([Calculation_4397694676601073690] * 100, 1)&#10;&#10;    WHEN &quot;Counting Occupancy&quot;&#10;    THEN ROUND([Receiving Occupancy (copy)_1038150110178754595] * 100, 1)&#10;&#10;    WHEN &quot;Hours Worked Receiving&quot;&#10;    THEN ROUND(SUM([Calculation_4397694676600827929]), 1)&#10;&#10;    WHEN &quot;Idle Time&quot;&#10;    THEN ROUND([Calculation_321796297201594378] * 100, 1)&#10;&#10;    WHEN &quot;Store Transfers&quot;&#10;    THEN SUM([src_store_transfer])&#10;&#10;    WHEN &quot;Store Transfer SKUs&quot;&#10;    THEN SUM([src_st_sku_count])&#10;&#10;    WHEN &quot;Avg. SKUs/ST&quot;&#10;    THEN ROUND([Avg. SKUs/PO (copy)_2301550524240506882], 1)&#10;&#10;    WHEN &quot;Avg. Items/SKU/ST&quot;&#10;    THEN ROUND([Avg. Items/SKU/PO (copy)_2301550524241768451], 1)&#10;&#10;    WHEN &quot;Avg. ST Time (m)&quot;&#10;    THEN ROUND([Calculation_2301550524232114176], 1)&#10;&#10;    WHEN &quot;ST Time (m) / SKU&quot;&#10;    THEN ROUND([Calculation_2301550524237299713], 1)&#10;&#10;    WHEN &quot;Transmission Time&quot;&#10;    THEN ROUND([Calculation_4397694676584493068], 3)&#10;&#10;    WHEN &quot;Hold Time&quot;&#10;    THEN ROUND([Calculation_3349200418291077122], 2)&#10;&#10;    WHEN &quot;Assignment Time&quot;&#10;    THEN ROUND([Calculation_4397694676584882189], 2)&#10;&#10;    WHEN &quot;Picking Time&quot;&#10;    THEN ROUND([Calculation_4397694676585279502], 2)&#10;&#10;    WHEN &quot;Avg. Picking Time per Item&quot;&#10;    THEN ROUND([Calculation_4397694676582125575], 2)&#10;&#10;    WHEN &quot;Packaging Time&quot;&#10;    THEN ROUND([Calculation_4397694676585443343], 2)&#10;&#10;    WHEN &quot;Order Prep. Time&quot;&#10;    THEN ROUND([Calculation_321796296914194437], 2)&#10;&#10;    WHEN &quot;Orders Prep. Time Breach&quot;&#10;    THEN ROUND([Calculation_4397694676581859334], 2)&#10;&#10;    WHEN &quot;Order Fulfillment Time&quot;&#10;    THEN ROUND(AVG([fulfillment_time_s]) / 60, 2)&#10;&#10;    WHEN &quot;Dispatching Time&quot;&#10;    THEN ROUND([Calculation_1128503551076577295], 2)&#10;&#10;    WHEN &quot;Drive Time&quot;&#10;    THEN ROUND([Calculation_4329929583180603393], 2)&#10;&#10;    WHEN &quot;Receiving Time&quot;&#10;    THEN ROUND([Calculation_131941420228218887], 2)&#10;&#10;    WHEN &quot;Receiving Time per Item&quot;&#10;    THEN ROUND([Calculation_1038150109587812378] / 60, 3)&#10;&#10;    WHEN &quot;Driver Waiting Time&quot;&#10;    THEN ROUND(SUM([driver_waiting_time_s]), 0)&#10;&#10;    WHEN &quot;Prep Time Est&quot;&#10;    THEN ROUND([Avg. Transmission Time (m) (copy)_4544835757590638592], 2)&#10;&#10;    WHEN &quot;Prep Time Buffer&quot;&#10;    THEN ROUND([Avg. Prep Time (m)  (copy)_4544835757590904833], 2)&#10;&#10;END' />
            </column>
