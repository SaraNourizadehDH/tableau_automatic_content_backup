            </column>
            <column caption='Is Preorder' datatype='boolean' name='[Calculation_3349200418215763968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [preorders] &gt; 1 THEN TRUE &#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='WINDOW_AVG([m_comparison - KPIs - Put_away], -6, 0)' datatype='real' name='[Calculation_3974356351602036793]' role='measure' type='quantitative' user:unnamed='Put_away (Time)'>
              <calculation class='tableau' formula='WINDOW_AVG([m_comparison - KPIs - Times Related (copy)_2122251000662261852], -6, 0)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='ROUND(WINDOW_AVG([m_comparison - KPIs - Put_away], -6, 0),2)' datatype='real' name='[Calculation_3974356351602155578]' role='measure' type='quantitative' user:unnamed='Put_away (Time)'>
              <calculation class='tableau' formula='ROUND(WINDOW_AVG([m_comparison - KPIs - Times Related (copy)_2122251000662261852], -6, 0),2)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Country*' datatype='string' name='[Calculation_4217198858826571776]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([country],[country])' />
            </column>
            <column caption='Region*' datatype='string' name='[Calculation_4217198858827358209]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([region],[region])' />
