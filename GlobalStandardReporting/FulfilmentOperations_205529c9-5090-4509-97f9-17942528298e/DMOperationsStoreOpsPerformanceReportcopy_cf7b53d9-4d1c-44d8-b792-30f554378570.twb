            <column-instance column='[d_comparison - KPIs - Times Related - KPIs Descriptions (copy)_2122251000662544480]' derivation='Attribute' name='[attr:d_comparison - KPIs - Times Related - KPIs Descriptions (copy)_2122251000662544480:nk]' pivot='key' type='nominal' />
            <column-instance column='[m_comparison - KPIs - Times Related - KPIs Share or vs AVG (copy)_2122251000662274141]' derivation='Attribute' name='[attr:m_comparison - KPIs - Times Related - KPIs Share or vs AVG (copy)_2122251000662274141:qk]' pivot='key' type='quantitative' />
            <column caption='City' datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='d_comparison - KPIs - Put_away - KPI&apos;s Tooltip Text' datatype='string' name='[d_comparison - KPIs - Times Related - KPI&apos;s Tooltip Text (copy)_2122251000662532191]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [d_comparison - KPIs - Times Related - KPIs Sufix (copy)_2122251000662556769] = &quot;%&quot; OR [d_comparison - KPIs - Times Related - KPIs Sufix (copy)_2122251000662556769] = &quot; &quot; THEN &quot;This value / total AVG&quot; ELSE &quot;Share&quot; END' />
            </column>
            <column caption='d_comparison - KPIs - Put_away - KPIs Descriptions' datatype='string' name='[d_comparison - KPIs - Times Related - KPIs Descriptions (copy)_2122251000662544480]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[p_comparison - KPIs - Times Related (copy)_2122251000661557339]&#10;&#10;    WHEN &quot;Put-away time/ SKU (s)&quot;&#10;    THEN &quot;Average put-away time per SKU in seconds&quot;&#10;&#10;    WHEN &quot;Put-away time Corr&quot;&#10;    THEN &quot;If for a batch put-away time/ SKU is more then 10 minutes it&apos;s considered as 10 minutes&quot;&#10;&#10;    WHEN &quot;Put-away time Corr./ SKU (s)&quot;&#10;    THEN &quot;Average put-away time corr. per SKU in seconds&quot;&#10;&#10;    WHEN &quot;Put-away time Corr./ Batch (m)&quot;&#10;    THEN &quot;Average put-away time corr. per out-away batch in minutes&quot;&#10;&#10;    WHEN &quot;Put-away time Corr./ Unit (s)&quot;&#10;    THEN &quot;Average put-away time corr. per unit in seconds&quot;&#10;&#10;    WHEN &quot;% Batches with Putaway time/SKU &gt;10mins&quot;&#10;    THEN &quot;% of put-away batches where put-away time / SKU is greated than 10 minutes&quot;&#10;&#10;    WHEN &quot;Putaway Batch Count&quot;&#10;    THEN &quot;Total number of put-away batched&quot;&#10;&#10;    WHEN &quot;SKU Put-away per Batch&quot;&#10;    THEN &quot;Number of SKU per batch&quot;&#10;&#10;    WHEN &quot;Putaway Units per Batch&quot;&#10;    THEN &quot;Total Quantity of SKUs per batch&quot;&#10;&#10;END' />
            </column>
            <column caption='d_comparison - KPIs - Put_away - KPIs Sufix' datatype='string' default-format='N' name='[d_comparison - KPIs - Times Related - KPIs Sufix (copy)_2122251000662556769]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[p_comparison - KPIs - Times Related (copy)_2122251000661557339]&#10;&#10;    WHEN &quot;Put-away time/ SKU (s)&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Put-away time Corr&quot;&#10;    THEN &quot;&quot;&#10;&#10;    WHEN &quot;Put-away time Corr./ SKU (s)&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Put-away time Corr./ Batch (m)&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Put-away time Corr./ Unit (s)&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;% Batches with Putaway time/SKU &gt;10mins&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Putaway Batch Count&quot;&#10;    THEN &quot;&quot;&#10;&#10;    WHEN &quot;SKU Put-away per Batch&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Putaway Units per Batch&quot;&#10;    THEN &quot; &quot;&#10;&#10;END' />
