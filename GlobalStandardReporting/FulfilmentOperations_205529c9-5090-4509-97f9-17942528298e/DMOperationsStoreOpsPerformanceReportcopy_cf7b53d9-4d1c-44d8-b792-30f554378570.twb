            <column-instance column='[Calculation_131941420225449989]' derivation='User' name='[usr:Calculation_131941420225449989:qk]' pivot='key' type='quantitative' />
            <column caption='Warehouse Id' datatype='string' name='[warehouse_id]' role='dimension' type='nominal' />
