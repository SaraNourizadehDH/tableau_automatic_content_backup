            <column caption='Is Avg. Daily Success Order &gt;300' datatype='string' name='[Calculation_6745055255009955844]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Calculation_6745055255009910787] &gt;= 300 THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
