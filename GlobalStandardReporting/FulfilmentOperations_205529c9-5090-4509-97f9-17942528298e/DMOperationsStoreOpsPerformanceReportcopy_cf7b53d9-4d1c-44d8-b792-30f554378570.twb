              <calculation class='tableau' formula='CASE [Parameters].[Country Selected (copy)]&#10;&#10;    WHEN &quot;Late Orders&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Partial Fulfilment Rate %&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Fulfilment Time Breach %&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Avg. Basket Size&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Modified Orders&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Avg. SKUs/PO&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Avg. Receiving Time/SKU&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Fail Rate&quot;&#10;    THEN &quot;%&quot;&#10;&#10;END' />
