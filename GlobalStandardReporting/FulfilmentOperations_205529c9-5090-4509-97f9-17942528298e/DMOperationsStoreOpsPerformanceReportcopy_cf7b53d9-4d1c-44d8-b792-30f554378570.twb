t; &quot;&#10;&#10;    WHEN &quot;Putaway Units per Batch&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Late Orders&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Partial Fulfilment Rate %&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Fulfilment Time Breach %&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Avg. Basket Size&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Modified Orders&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Avg. SKUs/PO&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Avg. Receiving Time/SKU&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Attendance (%)&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Order UTR&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Item UTR&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Picking Occupancy&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Receiving Occupancy&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Counting Occupancy&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;No- Clock Out Shifts (%)&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Overtime (%)&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Idle Time&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Late Orders&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Partial Fulfilment Rate %&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Fulfilment Time Breach %&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Avg. Basket Size&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Modified Orders&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Avg. SKUs/PO&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Avg. Receiving Time/SKU&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Attendance (%)&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Order UTR&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Item UTR&quot;&#10;    THEN &q