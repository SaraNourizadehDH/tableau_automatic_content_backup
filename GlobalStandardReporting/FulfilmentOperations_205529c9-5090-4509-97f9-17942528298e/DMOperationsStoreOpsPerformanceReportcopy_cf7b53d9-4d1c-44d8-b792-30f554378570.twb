    <worksheet name='Occupancy-1'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ffffff'>Occupancy Time Breakdown</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_store_performance_report (rl_dmart)' name='federated.14fmp3m0u0tkz31ff8n6f1gg6c4i' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Monthly' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;month&quot;'>
              <calculation class='tableau' formula='&quot;month&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;month&quot;' value='Monthly' />
                <alias key='&quot;quarter&quot;' value='Quarterly' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column caption='X-Axis' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Dates&quot;'>
              <calculation class='tableau' formula='&quot;Dates&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.14fmp3m0u0tkz31ff8n6f1gg6c4i'>
            <column caption='Avg. Daily Successful Order Qty' datatype='real' name='[Avg. Daily Successful order (copy)_4752001314040172546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED[warehouse_id],[Calculation_6745055255008800768]:(sum([order_qty_delivered])/countd([static_day]))}' />
            </column>
            <column caption='Picking + Packaging Time Specific Hour S' datatype='integer' name='[Calculation_1038150109105209345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn([picking_time_specific_hour_s]) + zn([packaging_time_specific_hour_s])' />
            </column>
            <column caption='Picking + Packaging Time Specific Hour (h)' datatype='real' name='[Calculation_1038150109110329353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1038150109105209345]/3600' />
            </column>
            <column caption='Receiving Specific Hour (h)' datatype='real' name='[Calculation_1038150109110513674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[receiving_time_specific_hour_s]/3600' />
            </column>
            <column caption='Others/Idle Time (h)' datatype='real' name='[Calculation_1038150109110603787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF sum([worked_hours])&lt;&#10;(zn(sum([Calculation_1038150109110329353]))&#10;+zn(sum([Calculation_1038150109110513674]))&#10;+zn(sum([Calculation_1038150109578072088])))&#10;THEN 0 ELSE&#10;sum([worked_hours])-&#10;(zn(sum([Calculation_1038150109110329353]))&#10;+zn(sum([Calculation_1038150109110513674]))&#10;+zn(sum([Calculation_1038150109578072088])))&#10;END' />
            </column>
            <column caption='Cycle Count Time (h)' datatype='real' name='[Calculation_1038150109578072088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[cycle_count_sku_time_s_corr]/3600' />
            </column>
            <column caption='Complete Time Period' datatype='boolean' name='[Calculation_1038150110095208477]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[static_day] &lt; {MAX(DATETRUNC([Parameters].[Parameter 1],[static_day]))}' />
            </column>
            <column caption='Global Entity ID' datatype='string' name='[Calculation_1666191126083334144]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([global_entity_id], [global_entity_id])' />
            </column>
            <column caption='Rooster Roll Out Filter' datatype='string' name='[Calculation_2923821344459988994]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {fixed [warehouse_name], [Calculation_5305803324295176197], [country]: SUM([worked_hours])} &gt; 0 THEN &apos;Rolled Out&apos; &#10;ELSE &apos;Not Rolled Out&apos;&#10;END' />
            </column>
            <column caption='Other/Idle Time (%)' datatype='real' name='[Calculation_321796297201594378]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1038150109110603787]/&#10;(zn([Calculation_1038150109110603787])+zn(SUM([Calculation_1038150109110513674]))&#10;+zn(sum([Calculation_1038150109110329353]))&#10;+zn(sum([Calculation_1038150109578072088])))' />
            </column>
            <column caption='Is Preorder' datatype='boolean' name='[Calculation_3349200418215763968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [preorders] &gt; 1 THEN TRUE &#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Country*' datatype='string' name='[Calculation_4217198858826571776]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([country],[country])' />
            </column>
            <column caption='Region*' datatype='string' name='[Calculation_4217198858827358209]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([region],[region])' />
            </column>
            <column caption='X-Axis' datatype='string' name='[Calculation_4217198860592680963]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5] &#10;WHEN &apos;Countries&apos; THEN [Calculation_4217198858826571776] &#10;WHEN &apos;Stores&apos; THEN [warehouse_name] &#10;WHEN &apos;Regions&apos; THEN [Calculation_4217198858827358209]&#10;ELSE STR(DATE([Calculation_5305803324295176197])) END' />
            </column>
            <column caption='Date' datatype='datetime' default-format='*YY-MM-DD' name='[Calculation_5305803324295176197]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;day&apos; THEN DATETRUNC(&apos;day&apos;, [static_day]) &#10;WHEN &apos;week&apos; THEN DATETRUNC(&apos;week&apos;, [static_day])&#10;WHEN &apos;month&apos; THEN DATETRUNC(&apos;month&apos;, [static_day])  &#10;WHEN &apos;quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [static_day]) &#10;END' />
            </column>
            <column caption='Month of Date' datatype='date' name='[Calculation_6745055255008800768]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[Calculation_5305803324295176197]))' />
            </column>
            <column caption='Avg. Daily Successful Order' datatype='real' name='[Calculation_6745055255009910787]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED[warehouse_id],[Calculation_6745055255008800768]:(sum([successful_orders])/countd([static_day]))}' />
            </column>
            <column caption='Is Avg. Daily Success Order &gt;300' datatype='string' name='[Calculation_6745055255009955844]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Calculation_6745055255009910787] &gt;= 300 THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
            </column>
            <column caption='Is Avg. Daily Success Order Qty &gt;2800' datatype='string' name='[Is Avg. Daily Success order &gt;300 (copy)_4752001314039861248]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Avg. Daily Successful order (copy)_4752001314040172546] &gt;= 2800 THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
            </column>
            <column caption='Is Stacked Delivery' datatype='boolean' name='[Is Preorder (copy)_4976618371942137859]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [stacked_orders] &gt; 1 THEN TRUE &#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Is Manual Dispatching' datatype='boolean' name='[Is Stacked Delivery (copy)_4976618371942670340]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [manual_dispatching] &gt; 1 THEN TRUE &#10;ELSE FALSE&#10;END' />
            </column>
            <column caption='Receiving Time (%) ' datatype='real' name='[Other/Idle Time (%) (copy)_321796297202089995]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1038150109110513674])/&#10;(zn([Calculation_1038150109110603787])+zn(SUM([Calculation_1038150109110513674]))&#10;+zn(sum([Calculation_1038150109110329353]))&#10;+zn(sum([Calculation_1038150109578072088])))' />
            </column>
            <column caption='Picking + Packaging Time (%) ' datatype='real' name='[Other/Idle Time (%) (copy)_321796297202212876]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1038150109110329353])/&#10;(zn([Calculation_1038150109110603787])+zn(SUM([Calculation_1038150109110513674]))&#10;+zn(sum([Calculation_1038150109110329353]))&#10;+zn(sum([Calculation_1038150109578072088])))' />
