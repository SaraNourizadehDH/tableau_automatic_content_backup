      </column>
      <column caption='d_comparison - KPIs - Store Transfer - KPIs Descriptions' datatype='string' name='[d_comparison - KPIs - Shifts Related - KPIs Descriptions (copy)_2122251000634597451]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[p_comparison - KPIs - Shifts Related (copy)_2122251000633499718]&#10;&#10;    WHEN &quot;Evaluated Shifts&quot;&#10;    THEN &quot;Successful shifts&quot;&#10;&#10;    WHEN &quot;No- Clock Out Shifts (%)&quot;&#10;    THEN &quot;Number of shifts that have time between clock-in and clock-out is longer than 15h / number of shifts&quot;&#10;&#10;    WHEN &quot;Hours Worked&quot;&#10;    THEN &quot;Hours worked by the picker. Calculated by the time dif between the picker clock-in and clock-out&quot;&#10;&#10;    WHEN &quot;Scheduled Hours&quot;&#10;    THEN &quot;Hours scheduled for the particular shift&quot;&#10;&#10;    WHEN &quot;Attendance (%)&quot;&#10;    THEN &quot;Hours worked / hours scheduled - can be higher than 100% in cases when due to being late for the shift or doing overtime the picker is working during hours he was not scheduled to work&quot;&#10;&#10;    WHEN &quot;Order UTR&quot;&#10;    THEN &quot;Number of orders picked / Hours Worked&quot;&#10;&#10;    WHEN &quot;Item UTR&quot;&#10;    THEN &quot;Number of items picked / Hours Worked&quot;&#10;&#10;    WHEN &quot;Picker Est. CPO&quot;&#10;    THEN &quot;Picker Labor Cost / Number of Orders&quot;&#10;&#10;    WHEN &quot;Hours Worked Prep. Orders&quot;&#10;    THEN &quot;The sum of the Picking Time and Packing Time&quot;&#10;&#10;    //WHEN &quot;Occupancy (%)&quot;&#10;    //THEN &quot;&quot;&#10;&#10;    WHEN &quot;Picking Occupancy&quot;&#10;    THEN &quot;Hours Worked Picking / Hours Worked&quot;&#10;&#10;    WHEN &quot;Receiving Occupancy&quot;&#10;    THEN &quot;Hours Worked Receiving / Hours Worked&quot;&#10;&#10;    WHEN &quot;Counting Occupancy&quot;&#10;    THEN &quot;Hours Worked Counting / Hours Worked&quot;&#10;&#10;    WHEN &quot;Hours Worked Receiving&quot;&#10;    THEN &quot;The sum of the Receiving Time (for POs) [m] / 60&quot;&#10;&#10;    WHEN &quot;Store Transfers&quot;&#10;    THEN &quot;How many ST were originated there&quot;&#10;&#10;    WHEN &quot;Store Transfer SKUs&quot;&#10;    THEN &quot;Total ST SKU count at origin warehouse&quot;&#10;&#10;    WHEN &quot;Avg. SKUs/ST&quot;&#10;    THEN &quot;Avg SKU count per ST at origin warehouse&quot;&#10;&#10;    WHEN &quot;Avg. Items/SKU/ST&quot;&#10;    THEN &quot;Avg SKU Quantity per SKU per ST at origin warehouse&quot;&#10;&#10;    WHEN &quot;Avg. ST Time (m)&quot;&#10;    THEN &quot;Avg Time taken per ST at destination warehouse&quot;&#10;&#10;    WHEN &quot;ST Time (m) / SKU&quot;&#10;    THEN &quot;Avg ST Time taken per SKU at destination warehouse&quot;&#10;&#10;END' />
      </column>
      <column caption='d_comparison - KPIs - Store Transfer - KPIs Sufix' datatype='string' default-format='N' name='[d_comparison - KPIs - Shifts Related - KPIs Sufix (copy)_2122251000634605644]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[p_comparison - KPIs - Shifts Related (copy)_2122251000633499718]&#10;&#10;    WHEN &quot;Late Orders&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Partial Fulfilment Rate %&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Fulfilment Time Breach %&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Avg. Basket Size&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Modified Orders&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Avg. SKUs/PO&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Avg. Receiving Time/SKU&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Attendance (%)&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Order UTR&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Item UTR&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Picking Occupancy&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Receiving Occupancy&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Counting Occupancy&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Avg. SKUs/ST&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Avg. Items/SKU/ST&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Avg. ST Time (m)&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;ST Time (m) / SKU&quot;&#10;    THEN &quot; &quot;&#10;&#10;END' />
      </column>
      <column caption='d_comparison - KPIs - Times Related - KPI&apos;s Tooltip Text' datatype='string' name='[d_comparison - KPIs - Store Transfer - KPI&apos;s Tooltip Text (copy)_2122251000643027027]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [d_comparison - KPIs - Store Transfer - KPIs Sufix (copy)_2122251000643047509] = &quot;%&quot; OR [d_comparison - KPIs - Store Transfer - KPIs Sufix (copy)_2122251000643047509] = &quot; &quot; THEN &quot;This value / total AVG&quot; ELSE &quot;Share&quot; END' />
      </column>
      <column caption='d_comparison - KPIs - Times Related - KPIs Descriptions' datatype='string' name='[d_comparison - KPIs - Store Transfer - KPIs Descriptions (copy)_2122251000643035220]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[p_comparison - KPIs - Store Transfer (copy)_2122251000641425487]&#10;&#10;    WHEN &quot;Store Transfers&quot;&#10;    THEN &quot;How many ST were originated there&quot;&#10;&#10;    WHEN &quot;Store Transfer SKUs&quot;&#10;    THEN &quot;Total ST SKU count at origin warehouse&quot;&#10;&#10;    WHEN &quot;Avg. SKUs/ST&quot;&#10;    THEN &quot;Avg SKU count per ST at origin warehouse&quot;&#10;&#10;    WHEN &quot;Avg. Items/SKU/ST&quot;&#10;    THEN &quot;Avg SKU Quantity per SKU per ST at origin warehouse&quot;&#10;&#10;    WHEN &quot;Avg. ST Time (m)&quot;&#10;    THEN &quot;Avg Time taken per ST at destination warehouse&quot;&#10;&#10;    WHEN &quot;ST Time (m) / SKU&quot;&#10;    THEN &quot;Avg ST Time taken per SKU at destination warehouse&quot;&#10;&#10;    WHEN &quot;Transmission Time&quot;&#10;    THEN &quot;Time diff. [m]: order placed to order in Shopper Management&quot;&#10;&#10;    WHEN &quot;Hold Time&quot;&#10;    THEN &quot;Time diff. [m]: order in Shopper Management to order available in Pelican (for assignment)&quot;&#10;&#10;    WHEN &quot;Assignment Time&quot;&#10;    THEN &quot;Time diff. [m]: order in Pelican to order started to be picked by a picker&quot;&#10;&#10;    WHEN &quot;Picking Time&quot;&#10;    THEN &quot;Time diff. [m]: order started to checkout confirmed&quot;&#10;&#10;    WHEN &quot;Avg. Picking Time per Item&quot;&#10;    THEN &quot;Avg  time in seconds it takes for picker to put 1 item in basket.&quot;&#10;&#10;    WHEN &quot;Packaging Time&quot;&#10;    THEN &quot;Time diff. in [m]: checkout confirmed to ready for pickup&quot;&#10;&#10;    WHEN &quot;Order Prep. Time&quot;&#10;    THEN &quot;Picking time and packing time&quot;&#10;&#10;    WHEN &quot;Orders Prep. Time Breach&quot;&#10;    THEN &quot;Breached Orders / Total Orders&quot;&#10;&#10;    WHEN &quot;Order Fulfillment Time&quot;&#10;    THEN &quot;Time diff. in [m]: order in Pelican to ready to pickup&quot;&#10;&#10;    WHEN &quot;Dispatching Time&quot;&#10;    THEN &quot;Time diff. in [m]: order ready for pickup to order pickup by rider&quot;&#10;&#10;    WHEN &quot;Drive Time&quot;&#10;    THEN &quot;Time diff. in [m]: order pickup to order drop off by rider&quot;&#10;&#10;    WHEN &quot;Receiving Time&quot;&#10;    THEN &quot;Time diff. in [m]: purchase order started to purchase order finished&quot;&#10;&#10;    WHEN &quot;Receiving Time per Item&quot;&#10;    THEN &quot;Time diff. in [m]: purchase order started to purchase order finished per Item&quot;&#10;&#10;    WHEN &quot;Driver Waiting Time&quot;&#10;    THEN &quot;Time diff. in [s]: rider near pickup to order pickup&quot;&#10;&#10;    WHEN &quot;Prep Time Est&quot;&#10;    THEN &quot;(Estimated Prep Time / Estimated Prep Time Count) / 60&quot;&#10;&#10;    WHEN &quot;Prep Time Buffer&quot;&#10;    THEN &quot;(Estimated Prep Buffer / Estimated Prep Buffer Count) / 60&quot;&#10;&#10;END' />
      </column>
      <column caption='d_comparison - KPIs - Times Related - KPIs Sufix' datatype='string' default-format='N' name='[d_comparison - KPIs - Store Transfer - KPIs Sufix (copy)_2122251000643047509]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[p_comparison - KPIs - Store Transfer (copy)_2122251000641425487]&#10;&#10;    WHEN &quot;Transmission Time&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Hold Time&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Assignment Time&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Picking Time&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Avg. Picking Time per Item&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Packaging Time&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Order Prep. Time&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Orders Prep. Time Breach&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    //WHEN &quot;Order Fulfillment Time&quot;&#10;    //THEN ROUND(SUM([Fulfillment Time S]) / 60, 2)&#10;&#10;    WHEN &quot;Dispatching Time&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Drive Time&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Receiving Time&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Receiving Time per Item&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Order Fulfillment Time&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Prep Time Est&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Prep Time Buffer&quot;&#10;    THEN &quot; &quot;&#10;&#10;END' />
      </column>
      <column caption='d_comparison - KPIs - Put_away - KPI&apos;s Tooltip Text' datatype='string' name='[d_comparison - KPIs - Times Related - KPI&apos;s Tooltip Text (copy)_2122251000662532191]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [d_comparison - KPIs - Times Related - KPIs Sufix (copy)_2122251000662556769] = &quot;%&quot; OR [d_comparison - KPIs - Times Related - KPIs Sufix (copy)_2122251000662556769] = &quot; &quot; THEN &quot;This value / total AVG&quot; ELSE &quot;Share&quot; END' />
      </column>
      <column caption='d_comparison - KPIs - Put_away - KPIs Descriptions' datatype='string' name='[d_comparison - KPIs - Times Related - KPIs Descriptions (copy)_2122251000662544480]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[p_comparison - KPIs - Times Related (copy)_2122251000661557339]&#10;&#10;    WHEN &quot;Put-away time/ SKU (s)&quot;&#10;    THEN &quot;Average put-away time per SKU in seconds&quot;&#10;&#10;    WHEN &quot;Put-away time Corr&quot;&#10;    THEN &quot;If for a batch put-away time/ SKU is more then 10 minutes it&apos;s considered as 10 minutes&quot;&#10;&#10;    WHEN &quot;Put-away time Corr./ SKU (s)&quot;&#10;    THEN &quot;Average put-away time corr. per SKU in seconds&quot;&#10;&#10;    WHEN &quot;Put-away time Corr./ Batch (m)&quot;&#10;    THEN &quot;Average put-away time corr. per out-away batch in minutes&quot;&#10;&#10;    WHEN &quot;Put-away time Corr./ Unit (s)&quot;&#10;    THEN &quot;Average put-away time corr. per unit in seconds&quot;&#10;&#10;    WHEN &quot;% Batches with Putaway time/SKU &gt;10mins&quot;&#10;    THEN &quot;% of put-away batches where put-away time / SKU is greated than 10 minutes&quot;&#10;&#10;    WHEN &quot;Putaway Batch Count&quot;&#10;    THEN &quot;Total number of put-away batched&quot;&#10;&#10;    WHEN &quot;SKU Put-away per Batch&quot;&#10;    THEN &quot;Number of SKU per batch&quot;&#10;&#10;    WHEN &quot;Putaway Units per Batch&quot;&#10;    THEN &quot;Total Quantity of SKUs per batch&quot;&#10;&#10;END' />
      </column>
      <column caption='d_comparison - KPIs - Put_away - KPIs Sufix' datatype='string' default-format='N' name='[d_comparison - KPIs - Times Related - KPIs Sufix (copy)_2122251000662556769]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[p_comparison - KPIs - Times Related (copy)_2122251000661557339]&#10;&#10;    WHEN &quot;Put-away time/ SKU (s)&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Put-away time Corr&quot;&#10;    THEN &quot;&quot;&#10;&#10;    WHEN &quot;Put-away time Corr./ SKU (s)&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Put-away time Corr./ Batch (m)&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Put-away time Corr./ Unit (s)&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;% Batches with Putaway time/SKU &gt;10mins&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Putaway Batch Count&quot;&#10;    THEN &quot;&quot;&#10;&#10;    WHEN &quot;SKU Put-away per Batch&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Putaway Units per Batch&quot;&#10;    THEN &quot; &quot;&#10;&#10;END' />
      </column>
      <column caption='d_comparison - X-Axis coor' datatype='string' name='[d_comparison - X-Axis (copy)_3974356351620010051]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[p_comparison - What would you like to compare (copy)_3974356351622127689]&#10;WHEN &apos;country&apos; THEN [Calculation_4217198858826571776] &#10;ELSE [warehouse_name]&#10;END' />
      </column>
