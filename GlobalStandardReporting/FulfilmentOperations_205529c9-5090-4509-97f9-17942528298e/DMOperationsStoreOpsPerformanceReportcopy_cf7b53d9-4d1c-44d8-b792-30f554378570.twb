                <alias key='&quot;No- Clock Out Shifts&quot;' value='No Clock Out Shifts' />
                <alias key='&quot;No- Clock Out Shifts (\%)&quot;' value='No Clock Out Shifts (%)' />
                <alias key='&quot;Order Fulfillment Time&quot;' value='Orders Fulfillment Time' />
