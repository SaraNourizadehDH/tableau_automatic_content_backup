      <aliases enabled='yes' />
      <column caption='% Orders Late &gt; 10m ' datatype='real' name='[% Orders Delivered &lt; 20m (copy)_4976618371944071176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([delayed_order_10]) / SUM([successful_orders]))' />
      </column>
      <column caption='% Rider Late &gt; 10m' datatype='real' name='[% Vendor Late &gt; 10m  (copy)_4976618371944706058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([rider_late_10]) / SUM([successful_orders]))' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.14fmp3m0u0tkz31ff8n6f1gg6c4i].[win:usr:Calculation_2122251000118030359:qk:20]&quot;' value='Last 6M AVG' />
        </aliases>
      </column>
      <column caption='Preorder % ' datatype='real' name='[Attendance % (copy)_4976618371941453826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([preorders]) / SUM([successful_orders]))' />
      </column>
      <column caption='Avg. Actual Delivery Time - Logistics (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg. Assignment Time (m) (copy)_4976618371941134337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_delivery_time_s])/SUM([actual_delivery_time_count]) / 60' />
      </column>
      <column caption='Avg. Basket Size, skus' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg. Basket Size (copy)_5003851037555732483]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1092685896280797185] / [Calculation_1092685896280903682]' />
      </column>
      <column caption='Avg. Daily Successful Order Qty' datatype='real' name='[Avg. Daily Successful order (copy)_4752001314040172546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED[warehouse_id],[Calculation_6745055255008800768]:(sum([order_qty_delivered])/countd([static_day]))}' />
      </column>
      <column caption='Avg. Items/SKU/ST' datatype='real' name='[Avg. Items/SKU/PO (copy)_2301550524241768451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([src_st_received_qty])/SUM([src_st_sku_count])' />
      </column>
      <column caption='Avg. Prep Time per Sku (s)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg. Packaging Time per Sku (s)  (copy)_5003851037553713154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([picking_time_s] + [packaging_time_s]) / [Calculation_1092685896280797185])' />
      </column>
      <column caption='Avg. Fulfilment Time (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg. Picking Time (m) (copy)_800514849058553856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([fulfillment_time_s])/sum([fulfillment_time_count]) / 60' />
      </column>
      <column caption='Avg. Picking Time per Sku (s)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg. Picking Time per Item (s) (copy)_5003851037552472064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([picking_time_s]) / SUM([order_skus_delivered]))' />
      </column>
      <column caption='Items with picking time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg. Picking Time per Item (s) (copy)_776307991244857344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [picking_time_s] &gt; 0 then [order_qty_delivered] ELSE NULL END' />
      </column>
      <column caption='Avg. Packaging Time per Sku (s)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg. Picking Time per Sku (s) (copy)_5003851037553065985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([packaging_time_s]) / SUM([order_skus_delivered]))' />
      </column>
      <column caption='Avg. Prep Time Buffer (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg. Prep Time (m)  (copy)_4544835757590904833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([estimated_prep_buffer_s])/ sum([estimated_prep_buffer_count]) / 60' />
      </column>
      <column caption='Avg. SKUs/ST' datatype='real' name='[Avg. SKUs/PO (copy)_2301550524240506882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([src_st_sku_count])/SUM([src_store_transfer])' />
      </column>
      <column caption='Avg. Est. Prep Time (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg. Transmission Time (m) (copy)_4544835757590638592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([estimated_prep_time_s])/ sum([estimated_prep_time_count]) / 60' />
      </column>
      <column caption='Day Order Distribution Percentage' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([successful_orders]) / TOTAL(SUM([successful_orders]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='integer' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK([Calculation_2122251000118030359])'>
          <table-calc ordering-field='[federated.14fmp3m0u0tkz31ff8n6f1gg6c4i].[none:Calculation_2122250999791771649:nk]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Day POs Distribution Percentage' datatype='real' default-format='p0.00%' name='[Calculation3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([purchase_orders]) / TOTAL(SUM([purchase_orders]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Picking + Packaging Time Specific Hour S' datatype='integer' name='[Calculation_1038150109105209345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn([picking_time_specific_hour_s]) + zn([packaging_time_specific_hour_s])' />
      </column>
      <column caption='Picking + Packaging Time Specific Hour (h)' datatype='real' name='[Calculation_1038150109110329353]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1038150109105209345]/3600' />
      </column>
      <column caption='Receiving Specific Hour (h)' datatype='real' name='[Calculation_1038150109110513674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[receiving_time_specific_hour_s]/3600' />
      </column>
      <column caption='Others/Idle Time (h)' datatype='real' name='[Calculation_1038150109110603787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF sum([worked_hours])&lt;&#10;(zn(sum([Calculation_1038150109110329353]))&#10;+zn(sum([Calculation_1038150109110513674]))&#10;+zn(sum([Calculation_1038150109578072088])))&#10;THEN 0 ELSE&#10;sum([worked_hours])-&#10;(zn(sum([Calculation_1038150109110329353]))&#10;+zn(sum([Calculation_1038150109110513674]))&#10;+zn(sum([Calculation_1038150109578072088])))&#10;END' />
      </column>
      <column caption='Successful Orders by Day' datatype='integer' name='[Calculation_1038150109138878479]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ fixed [static_day],[warehouse_name],[warehouse_id]: SUM([successful_orders])}' />
      </column>
      <column caption='Hour Order Distribution Percentage' datatype='real' name='[Calculation_1038150109139165200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([successful_orders])/sum([Calculation_1038150109138878479])' />
      </column>
      <column caption='Avg. Items/SKU/PO' datatype='real' name='[Calculation_1038150109409185813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([purchase_order_items])/SUM([purchase_order_skus])' />
      </column>
      <column caption='Cycle Count Time (h)' datatype='real' name='[Calculation_1038150109578072088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[cycle_count_sku_time_s_corr]/3600' />
      </column>
      <column caption='Avg. Count Time/Unit' datatype='real' name='[Calculation_1038150109583142937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cycle_count_sku_time_s_corr])/sum([units_counted])' />
      </column>
      <column caption='Receiving Time / SKU' datatype='real' name='[Calculation_1038150109587812378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1038150109110513674])*60/SUM([purchase_order_skus])' />
      </column>
      <column caption='Est. CPO' datatype='real' name='[Calculation_1038150109757132827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Picker Estimated CPO LC (copy)_1038150109575553047])/SUM([successful_orders])' />
      </column>
      <column caption='Idle Time (%)' datatype='real' name='[Calculation_1038150109794246684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1038150109110603787]/sum([worked_hours])' />
      </column>
      <column caption='Complete Time Period' datatype='boolean' name='[Calculation_1038150110095208477]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[static_day] &lt; {MAX(DATETRUNC([Parameters].[Parameter 1],[static_day]))}' />
      </column>
      <column caption='Items picked' datatype='real' name='[Calculation_1092685896280666112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([order_qty_picked])' />
      </column>
      <column caption='Skus Picked' datatype='integer' name='[Calculation_1092685896280797185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([order_skus_picked])' />
      </column>
      <column caption='Orders picked' datatype='integer' name='[Calculation_1092685896280903682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([picked_orders])' />
      </column>
      <column caption='Dispatching Time [m]' datatype='real' name='[Calculation_1128503551076577295]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([store_dispatch_time_s])/SUM([store_dispatch_time_count])/ 60' />
      </column>
      <column caption='Item UTR' datatype='real' name='[Calculation_131941420225449989]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([Order Qty Delivered (copy)_223772612442640384])/SUM([worked_hours]))' />
      </column>
      <column caption='Avg. SKUs/PO' datatype='real' name='[Calculation_131941420227903494]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([purchase_order_skus])/SUM([purchase_orders]))' />
      </column>
      <column caption='Avg. Receiving Time/SKU [m]' datatype='real' name='[Calculation_131941420228218887]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([Calculation_1038150109110513674])*60/sum([purchase_order_skus]))' />
      </column>
      <column caption='Global Entity ID' datatype='string' name='[Calculation_1666191126083334144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([global_entity_id], [global_entity_id])' />
      </column>
      <column caption='Put-away time Corr./ SKU (s)' datatype='real' name='[Calculation_171559011641389056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([putaway_time_corr])/(sum([sku_qty]))' />
      </column>
      <column caption='SKU Put-away per Batch' datatype='real' name='[Calculation_171559011643678722]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sku_qty])/sum([putaway_batch_count])' />
      </column>
      <column caption='d_comparison - X-Axis' datatype='string' name='[Calculation_2122250999791771649]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[KPI Switcher - 2 (copy)]&#10;WHEN &apos;country&apos; THEN [Country* (copy)_3974356351466971139] &#10;ELSE STR([Calculation_2122250999881494535]) &#10;END' />
      </column>
      <column caption='m_comparison - Color Filter' datatype='integer' name='[Calculation_2122250999811817478]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[KPI Switcher - 2 (copy)]&#10;    WHEN &quot;country&quot;&#10;        THEN &#10;            IF [Country* (copy)_3974356351466971139] = [Parameters].[Time Aggregation (copy)] &#10;                THEN 1 &#10;                ELSE 0&#10;            END&#10;    ELSE&#10;             IF [Calculation_2122250999881494535] = [Parameters].[country_selected (copy)_2122250999810654213]&#10;                THEN 1 &#10;                ELSE 0&#10;            END&#10;END' />
      </column>
      <column caption='d_comparison - Warehouse Name' datatype='string' name='[Calculation_2122250999881494535]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[KPI Switcher - 2 (copy)] = &quot;warehouse&quot; THEN [warehouse_name] ELSE NULL END' />
      </column>
      <column caption='m_comparison - KPIs - Orders Related - KPIs Share or vs AVG' datatype='real' default-format='p0.0%' name='[Calculation_2122250999926050827]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Orders Related KPI (copy)_2122251000131711001] = &quot;%&quot; OR [Orders Related KPI (copy)_2122251000131711001] = &quot; &quot;THEN&#10;{ INCLUDE  [Calculation_2122250999791771649] : [Calculation_2122251000118030359] } &#10;/&#10;{ EXCLUDE  [Calculation_2122250999791771649] : [Calculation_2122251000118030359] } -1&#10;ELSE&#10;{ INCLUDE  [Calculation_2122250999791771649] : [Calculation_2122251000118030359] } &#10;/&#10;{ EXCLUDE  [Calculation_2122250999791771649] : [Calculation_2122251000118030359] }&#10;END' />
      </column>
      <column caption='m_comparison - KPIs - Orders Related' datatype='real' default-format='N' name='[Calculation_2122251000118030359]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Country Selected (copy)]&#10;&#10;    WHEN &quot;Orders&quot;&#10;    THEN SUM([orders])&#10;&#10;    WHEN &quot;Successful Orders&quot;&#10;    THEN SUM([successful_orders])&#10;&#10;    WHEN &quot;Late Orders&quot;&#10;    THEN ROUND(([% Orders Delivered &lt; 20m (copy)_4976618371944071176] * 100),2)&#10;&#10;    WHEN &quot;Partial Fulfilment Rate %&quot;&#10;    THEN ROUND(([Calculation_4217198863434866694] * 100),2)&#10;&#10;    WHEN &quot;Fail Rate&quot;&#10;    THEN ROUND(([Calculation_4397694676583907339] * 100), 2)&#10;&#10;    WHEN &quot;Fulfilment Time Breach %&quot;&#10;    THEN ROUND(((SUM(IF [fulfillment_time_s] &gt; 120 THEN [successful_orders] END) / SUM([successful_orders]))*100),2)&#10;&#10;    WHEN &quot;Handled Externally&quot;&#10;    THEN SUM([orders_handled_externally])&#10;&#10;    WHEN &quot;Modified Orders&quot;&#10;    THEN ROUND(([Calculation_4397694676583690250] * 100),2)&#10;&#10;    WHEN &quot;Total Items&quot;&#10;    THEN SUM([order_qty])&#10;&#10;    WHEN &quot;Avg. Basket Size&quot;&#10;    THEN ROUND([Calculation_4397694676580687876], 2)&#13;&#10;    &#13;&#10;    WHEN &quot;Stacked orders, %&quot;&#13;&#10;    THEN ROUND([Preorder %  (copy)_4976618371943280645] * 100, 1)&#10;&#10;END' />
      </column>
      <column caption='d_comparison - KPIs - Orders Related - KPI&apos;s Tooltip Text' datatype='string' name='[Calculation_2122251000161189923]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [Orders Related KPI (copy)_2122251000131711001] = &quot;%&quot; OR [Orders Related KPI (copy)_2122251000131711001] = &quot; &quot; THEN &quot;This value / total AVG&quot; ELSE &quot;Share&quot; END' />
      </column>
      <column caption='d_comparison - KPIs - Orders Related - KPIs Descriptions' datatype='string' name='[Calculation_2122251000477499428]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Country Selected (copy)]&#10;    &#10;    WHEN &quot;Orders&quot;&#10;    THEN &quot;Total orders&quot;&#10;&#10;    WHEN &quot;Successful Orders&quot;&#10;    THEN &quot;Orders where is_sent = TRUE&quot;&#10;&#10;    WHEN &quot;Late Orders&quot;&#10;    THEN &quot;Orders with driver waiting time &gt; 0 minute&quot;&#10;&#10;    WHEN &quot;Partial Fulfilment Rate %&quot;&#10;    THEN &quot;Number of orders with units delivered &lt; units ordered / successful orders&quot;&#10;&#10;    WHEN &quot;Fulfilment Time Breach %&quot;&#10;    THEN &quot;Orders with fulfilment_time_s &gt; 120 / successful orders&quot;&#10;&#10;    WHEN &quot;Handled Externally&quot;&#10;    THEN &quot;Orders handled outside of Pelican&quot;&#10;&#10;    WHEN &quot;Modified Orders&quot;&#10;    THEN &quot;Where qty_returned &gt; 0, order is not cancelled and order was succesfful &quot;&#10;&#10;    WHEN &quot;Total Items&quot;&#10;    THEN &quot;Sum of all items ordered.&quot;&#10;&#10;    WHEN &quot;Avg. Basket Size&quot;&#10;    THEN &quot;Total Items / Orders&quot;&#10;&#10;    WHEN &quot;Fail Rate&quot;&#10;    THEN &quot;Failed Orders / Total Orders&quot;&#10;&#10;END' />
      </column>
      <column caption='Avg. ST Time (m)' datatype='real' name='[Calculation_2301550524232114176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([dest_reciveing_time_s])/(60 * sum([dest_store_transfer]))' />
      </column>
      <column caption='ST Time (m) / SKU' datatype='real' name='[Calculation_2301550524237299713]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([dest_reciveing_time_s])/(60*sum(dest_st_sku_count))' />
      </column>
      <column caption='User Entitlements' datatype='boolean' name='[Calculation_2666412512335089664]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='USERNAME() = [username]' />
      </column>
      <column caption='Rooster Roll Out Filter' datatype='string' name='[Calculation_2923821344459988994]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF {fixed [warehouse_name], [Calculation_5305803324295176197], [country]: SUM([worked_hours])} &gt; 0 THEN &apos;Rolled Out&apos; &#10;ELSE &apos;Not Rolled Out&apos;&#10;END' />
      </column>
      <column caption='Scheduled Hours*' datatype='real' name='[Calculation_2923821344460640259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([planned_hours])' />
      </column>
      <column caption='No Clock-Out Shifts' datatype='integer' name='[Calculation_2923821344461168644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([no_clock_out_shifts])' />
      </column>
      <column caption='Total POs Received ' datatype='real' name='[Calculation_2923821344462135302]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([purchase_orders])' />
      </column>
      <column caption='% No Clock Out Shifts' datatype='real' name='[Calculation_2923821344463708167]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([Calculation_2923821344461168644]) / SUM([evaluated_shifts]))' />
      </column>
      <column caption='Stores with Rooster' datatype='integer' name='[Calculation_321796296592310274]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_rooster] THEN [warehouse_id] END)' />
      </column>
      <column caption='Avg. Order Prep. Time (m)' datatype='real' name='[Calculation_321796296914194437]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn([Calculation_4397694676585279502]) + zn([Calculation_4397694676585443343])' />
      </column>
      <column caption='Country.' datatype='string' name='[Calculation_321796296945565703]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_4217198858826571776]' />
      </column>
      <column caption='Region.' datatype='string' name='[Calculation_321796296945758216]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_4217198858827358209]' />
      </column>
      <column caption='Warehouse Name.' datatype='string' name='[Calculation_321796296945803273]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[warehouse_name]' />
      </column>
      <column caption='Other/Idle Time (%)' datatype='real' name='[Calculation_321796297201594378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1038150109110603787]/&#10;(zn([Calculation_1038150109110603787])+zn(SUM([Calculation_1038150109110513674]))&#10;+zn(sum([Calculation_1038150109110329353]))&#10;+zn(sum([Calculation_1038150109578072088])))' />
      </column>
      <column caption='Total Unit Counted' datatype='real' name='[Calculation_321796297260433422]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn([units_counted])+zn([final_count])' />
      </column>
      <column caption='No Show Rate (%)' datatype='real' name='[Calculation_321796297289252882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([no_show_shifts]))/zn(sum([shifts]))' />
      </column>
      <column caption='Store is Live' datatype='string' name='[Calculation_321796297291317267]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM(IF [is_active] THEN 1 ELSE 0 END) &gt; 0 THEN &apos;Yes&apos;&#10;ELSE &apos;No&apos; END' />
      </column>
      <column caption='Is Preorder' datatype='boolean' name='[Calculation_3349200418215763968]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [preorders] &gt; 1 THEN TRUE &#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Avg. Hold Time (m)' datatype='real' name='[Calculation_3349200418291077122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([hold_time_s])/SUM([hold_time_count])/ 60' />
      </column>
      <column caption='d_time - Region Filter Selected' datatype='boolean' name='[Calculation_3974356351515721737]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF TOTAL( COUNTD( [Calculation_4217198858827358209] ) ) = SUM( { FIXED : COUNTD( [Calculation_4217198858827358209] ) } ) THEN TRUE ELSE FALSE END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='WINDOW_AVG([m_comparison - KPIs - Orders Related], -6, 0)' datatype='real' name='[Calculation_3974356351539744787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_2122251000118030359], -6, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='m_comparison - KPIs - Full1' datatype='real' name='[Calculation_3974356351614799936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[p_comparison - KPIs - Store Transfer (copy)]&#10;&#10;    WHEN &quot;Orders&quot;&#10;    THEN SUM([orders])&#10;&#10;    WHEN &quot;Successful Orders&quot;&#10;    THEN SUM([successful_orders])&#10;&#10;    WHEN &quot;Late Orders&quot;&#10;    THEN ROUND(([% Orders Delivered &lt; 20m (copy)_4976618371944071176] * 100),2)&#10;&#10;    WHEN &quot;Partial Fulfilment Rate %&quot;&#10;    THEN ROUND(([Calculation_4217198863434866694] * 100),2)&#10;&#10;    WHEN &quot;Fail Rate&quot;&#10;    THEN ROUND(([Calculation_4397694676583907339] * 100), 2)&#10;&#10;    WHEN &quot;Fulfilment Time Breach %&quot;&#10;    THEN ROUND(((SUM(IF [fulfillment_time_s] &gt; 120 THEN [successful_orders] END) / SUM([successful_orders]))*100),2)&#10;&#10;    WHEN &quot;Handled Externally&quot;&#10;    THEN SUM([orders_handled_externally])&#10;&#10;    WHEN &quot;Modified Orders&quot;&#10;    THEN ROUND(([Calculation_4397694676583690250] * 100),2)&#10;&#10;    WHEN &quot;Total Items&quot;&#10;    THEN SUM([order_qty])&#10;&#10;    WHEN &quot;Avg. Basket Size&quot;&#10;    THEN ROUND([Calculation_4397694676580687876], 2)&#10;    WHEN &quot;POs received&quot;&#10;    THEN SUM([purchase_orders])&#10;&#10;    WHEN &quot;Avg. SKUs/PO&quot;&#10;    THEN ROUND([Calculation_131941420227903494],2)&#10;&#10;    WHEN &quot;Avg. Receiving Time/PO&quot;&#10;    THEN ROUND([Calculation_4397694676588900371],2)&#10;&#10;    WHEN &quot;Avg. Receiving Time/SKU&quot;&#10;    THEN ROUND([Calculation_131941420228218887],2)&#10;&#10;    WHEN &quot;Units Counted&quot;&#10;    THEN SUM([Calculation_321796297260433422])&#10;&#10;    WHEN &quot;Put-away time/ SKU (s)&quot;&#10;    THEN ROUND([Put-away time Corr./ SKU (m) (copy)_171559011643076609], 0)&#10;&#10;    WHEN &quot;Put-away time Corr&quot;&#10;    THEN ROUND(SUM([putaway_time_corr]), 0)&#10;&#10;    WHEN &quot;Put-away time Corr./ SKU (s)&quot;&#10;    THEN ROUND([Calculation_171559011641389056], 0)&#10;&#10;    WHEN &quot;Put-away time Corr./ Batch (m)&quot;&#10;    THEN ROUND([Put-away time Corr./ Unit (s) (copy)_2148287410332180481], 2)&#10;&#10;    WHEN &quot;Put-away time Corr./ Unit (s)&quot;&#10;    THEN ROUND([Put-away time Corr./ SKU (s) (copy)_2148287410331680768], 0)&#10;&#10;    WHEN &quot;% Batches with Putaway time/SKU &gt;10mins&quot;&#10;    THEN ROUND([Put-away time Corr./ SKU (s) (copy)_2148287410333822978] * 100, 2)&#10;&#10;    WHEN &quot;Putaway Batch Count&quot;&#10;    THEN ROUND(SUM([putaway_batch_count]), 0)&#10;&#10;    WHEN &quot;SKU Put-away per Batch&quot;&#10;    THEN ROUND([Calculation_171559011643678722], 0)&#10;&#10;    WHEN &quot;Putaway Units per Batch&quot;&#10;    THEN ROUND([SKU Put-away per Batch (copy)_171559011643969539], 0)&#10;&#10;    WHEN &quot;Evaluated Shifts&quot;&#10;    THEN SUM([shifts])&#10;&#10;    WHEN &quot;No- Clock Out Shifts&quot;&#10;    THEN ROUND(SUM([Calculation_2923821344461168644]),2)&#10;&#10;    WHEN &quot;No- Clock Out Shifts (%)&quot;&#10;    THEN ROUND((SUM([Calculation_2923821344461168644])/SUM([shifts])) * 100, 2)&#10;&#10;    WHEN &quot;Overtime&quot;&#10;    THEN ROUND(SUM([non_clock_out_hours]), 2)&#10;&#10;    WHEN &quot;Overtime (%)&quot;&#10;    THEN ROUND((SUM([non_clock_out_hours])/SUM([worked_hours])) * 100, 2)&#10;&#10;    WHEN &quot;Hours Worked&quot;&#10;    THEN ROUND(SUM([Calculation_4397694676603695132]),1)&#10;&#10;    WHEN &quot;Scheduled Hours&quot;&#10;    THEN ROUND(SUM([Calculation_2923821344460640259]),1)&#10;&#10;    WHEN &quot;Attendance (%)&quot;&#10;    THEN ROUND((SUM([Calculation_4397694676603695132]) / SUM([Calculation_2923821344460640259])) * 100, 2)&#10;&#10;    WHEN &quot;Order UTR&quot;&#10;    THEN ROUND([Calculation_4397694676590141461], 1)&#10;&#10;    WHEN &quot;Item UTR&quot;&#10;    THEN ROUND([Calculation_131941420225449989], 1)&#10;&#10;    //WHEN &quot;Picker Est. CPO&quot;&#10;    //THEN [Est. CPO]&#10;&#10;    WHEN &quot;Hours Worked Prep. Orders&quot;&#10;    THEN ROUND(SUM([Calculation_1038150109110329353]), 1)&#10;&#10;    //WHEN &quot;Occupancy (%)&quot;&#10;    //THEN ([Hours Worked Receiving] + picki&#10;&#10;    WHEN &quot;Picking Occupancy&quot;&#10;    THEN ROUND([Calculation_4397694676600127512] * 100, 1)&#10;&#10;    WHEN &quot;Receiving Occupancy&quot;&#10;    THEN ROUND([Calculation_4397694676601073690] * 100, 1)&#10;&#10;    WHEN &quot;Counting Occupancy&quot;&#10;    THEN ROUND([Receiving Occupancy (copy)_1038150110178754595] * 100, 1)&#10;&#10;    WHEN &quot;Hours Worked Receiving&quot;&#10;    THEN ROUND(SUM([Calculation_4397694676600827929]), 1)&#10;&#10;    WHEN &quot;Idle Time&quot;&#10;    THEN ROUND([Calculation_321796297201594378] * 100, 1)&#10;&#10;    WHEN &quot;Store Transfers&quot;&#10;    THEN SUM([src_store_transfer])&#10;&#10;    WHEN &quot;Store Transfer SKUs&quot;&#10;    THEN SUM([src_st_sku_count])&#10;&#10;    WHEN &quot;Avg. SKUs/ST&quot;&#10;    THEN ROUND([Avg. SKUs/PO (copy)_2301550524240506882], 1)&#10;&#10;    WHEN &quot;Avg. Items/SKU/ST&quot;&#10;    THEN ROUND([Avg. Items/SKU/PO (copy)_2301550524241768451], 1)&#10;&#10;    WHEN &quot;Avg. ST Time (m)&quot;&#10;    THEN ROUND([Calculation_2301550524232114176], 1)&#10;&#10;    WHEN &quot;ST Time (m) / SKU&quot;&#10;    THEN ROUND([Calculation_2301550524237299713], 1)&#10;&#10;    WHEN &quot;Transmission Time&quot;&#10;    THEN ROUND([Calculation_4397694676584493068], 3)&#10;&#10;    WHEN &quot;Hold Time&quot;&#10;    THEN ROUND([Calculation_3349200418291077122], 2)&#10;&#10;    WHEN &quot;Assignment Time&quot;&#10;    THEN ROUND([Calculation_4397694676584882189], 2)&#10;&#10;    WHEN &quot;Picking Time&quot;&#10;    THEN ROUND([Calculation_4397694676585279502], 2)&#10;&#10;    WHEN &quot;Avg. Picking Time per Item&quot;&#10;    THEN ROUND([Calculation_4397694676582125575], 2)&#10;&#10;    WHEN &quot;Packaging Time&quot;&#10;    THEN ROUND([Calculation_4397694676585443343], 2)&#10;&#10;    WHEN &quot;Order Prep. Time&quot;&#10;    THEN ROUND([Calculation_321796296914194437], 2)&#10;&#10;    WHEN &quot;Orders Prep. Time Breach&quot;&#10;    THEN ROUND([Calculation_4397694676581859334], 2)&#10;&#10;    WHEN &quot;Order Fulfillment Time&quot;&#10;    THEN ROUND(AVG([fulfillment_time_s]) / 60, 2)&#10;&#10;    WHEN &quot;Dispatching Time&quot;&#10;    THEN ROUND([Calculation_1128503551076577295], 2)&#10;&#10;    WHEN &quot;Drive Time&quot;&#10;    THEN ROUND([Calculation_4329929583180603393], 2)&#10;&#10;    WHEN &quot;Receiving Time&quot;&#10;    THEN ROUND([Calculation_131941420228218887], 2)&#10;&#10;    WHEN &quot;Receiving Time per Item&quot;&#10;    THEN ROUND([Calculation_1038150109587812378] / 60, 3)&#10;&#10;    WHEN &quot;Driver Waiting Time&quot;&#10;    THEN ROUND(SUM([driver_waiting_time_s]), 0)&#10;&#10;    WHEN &quot;Prep Time Est&quot;&#10;    THEN ROUND([Avg. Transmission Time (m) (copy)_4544835757590638592], 2)&#10;&#10;    WHEN &quot;Prep Time Buffer&quot;&#10;    THEN ROUND([Avg. Prep Time (m)  (copy)_4544835757590904833], 2)&#10;&#10;END' />
      </column>
      <column caption='Country*' datatype='string' name='[Calculation_4217198858826571776]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([country],[country])' />
      </column>
      <column caption='Region*' datatype='string' name='[Calculation_4217198858827358209]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([region],[region])' />
      </column>
      <column caption='X-Axis' datatype='string' name='[Calculation_4217198860592680963]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5] &#10;WHEN &apos;Countries&apos; THEN [Calculation_4217198858826571776] &#10;WHEN &apos;Stores&apos; THEN [warehouse_name] &#10;WHEN &apos;Regions&apos; THEN [Calculation_4217198858827358209]&#10;ELSE STR(DATE([Calculation_5305803324295176197])) END' />
      </column>
      <column caption='Partial Fulfilment Rate (%)' datatype='real' name='[Calculation_4217198863434866694]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([partial_orders])/sum([successful_orders]))' />
      </column>
      <column caption='Avg. Rider Delivery Time (m)' datatype='real' name='[Calculation_4329929583180603393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([rider_delivery_time_s]) / sum([rider_delivery_time_count]) / 60' />
      </column>
      <column caption='Avg. Basket Size, items' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4397694676580687876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1092685896280666112]/ [Calculation_1092685896280903682]' />
      </column>
      <column caption='Breach %' datatype='real' name='[Calculation_4397694676581859334]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([breached_orders]) / [Calculation_1092685896280903682]' />
      </column>
      <column caption='Avg. Picking Time per Item (s)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4397694676582125575]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([picking_time_s]) / SUM([Avg. Picking Time per Item (s) (copy)_776307991244857344]))' />
      </column>
      <column caption='% Orders Handled Externally' datatype='real' name='[Calculation_4397694676583247881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders_handled_externally])&#10;&#10;/ SUM([orders])' />
      </column>
      <column caption='% Modified Orders' datatype='real' name='[Calculation_4397694676583690250]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([modified_orders])&#10;&#10;/ SUM([orders])' />
      </column>
      <column caption='Fail Rate' datatype='real' name='[Calculation_4397694676583907339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([failed_orders]) / SUM([orders])' />
      </column>
      <column caption='Avg. Transmission Time (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4397694676584493068]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([transmission_time_s])/ sum([transmission_time_count]) / 60' />
      </column>
      <column caption='Avg. Assignment Time (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4397694676584882189]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([assignment_time_s])/SUM([assignment_time_count]) / 60' />
      </column>
      <column caption='Avg. Picking Time (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4397694676585279502]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([picking_time_s])/sum([picking_time_count]) / 60' />
      </column>
      <column caption='Avg. Packaging Time (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4397694676585443343]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([packaging_time_s])/sum([packaging_time_count]) / 60' />
      </column>
      <column caption='Avg. Dispatching Time (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4397694676585627664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([store_dispatch_time_s])/ sum([store_dispatch_time_count]) / 60' />
      </column>
      <column caption='PO Basket Size' datatype='real' name='[Calculation_4397694676588236818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[purchase_order_items] / [Calculation_2923821344462135302]' />
      </column>
      <column caption='Avg. PO Receiving Time (m)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4397694676588900371]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1038150109110513674]) * 60 / sum([purchase_orders])' />
      </column>
      <column caption='% POs Handled Externally' datatype='real' name='[Calculation_4397694676589264916]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pos_handled_externally]) / SUM([Calculation_2923821344462135302])' />
      </column>
      <column caption='Order UTR' datatype='real' name='[Calculation_4397694676590141461]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_1092685896280903682]/ SUM([worked_hours]))' />
      </column>
      <column caption='Picking Occupancy' datatype='real' name='[Calculation_4397694676600127512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN((SUM([picking_time_specific_hour_s])+SUM([packaging_time_specific_hour_s]))/3600/ SUM([worked_hours]))' />
      </column>
      <column caption='Hours Worked Receiving' datatype='real' name='[Calculation_4397694676600827929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(([receiving_time_specific_hour_s] / 60) / 60)' />
      </column>
      <column caption='Receiving Occupancy' datatype='real' name='[Calculation_4397694676601073690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([Calculation_4397694676600827929]) / SUM([worked_hours]))' />
      </column>
      <column caption='Hours Worked' datatype='real' name='[Calculation_4397694676603695132]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([worked_hours])' />
      </column>
      <column caption='Items delivered' datatype='real' name='[Calculation_45036042471067648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_qty_delivered])' />
      </column>
      <column caption='KPI 1' datatype='real' default-format='N' name='[Calculation_497084855893405697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#10;WHEN &apos;Successful Orders&apos; then SUM([successful_orders])&#13;&#10;WHEN &apos;Orders Picked&apos; then [Calculation_1092685896280903682]&#10;WHEN &apos;Items Delivered&apos; then [Calculation_45036042471067648]&#13;&#10;WHEN &apos;Items Picked&apos; then [Calculation_1092685896280666112]&#10;WHEN &apos;AVG Basket Size&apos; then [Calculation_4397694676580687876]&#10;WHEN &apos;AVG Order Prep. Time [m]&apos; then [Calculation_321796296914194437]&#10;WHEN &apos;AVG Picking Time per Item [s]&apos; then [Calculation_4397694676582125575]&#10;WHEN &apos;% Orders Handled Externally&apos; then [Calculation_4397694676583247881]&#10;WHEN &apos;% Modified Orders&apos; then [Calculation_4397694676583690250]&#10;WHEN &apos;Failed Rate&apos; then [Calculation_4397694676583907339]&#10;WHEN &apos;AVG Transmission Time [m]&apos; then [Calculation_4397694676584493068]&#10;WHEN &apos;AVG Assignment Time [m]&apos; then [Calculation_4397694676584882189]&#10;WHEN &apos;AVG Picking Time [m]&apos; then [Calculation_4397694676585279502]&#10;WHEN &apos;AVG Packaging Time [m]&apos; then [Calculation_4397694676585443343]&#10;WHEN &apos;AVG Dispatching Time [m]&apos; then [Calculation_4397694676585627664]&#10;WHEN &apos;AVG Delivery Time [m]&apos; then [Calculation_4329929583180603393]&#10;WHEN &apos;Total PO&apos; then SUM([Calculation_2923821344462135302])&#10;WHEN &apos;Total PO Items&apos; then SUM([purchase_order_items])&#10;WHEN &apos;PO Basket Size&apos; then SUM([Calculation_4397694676588236818])&#10;WHEN &apos;AVG PO Receiving Time [m]&apos; then [Calculation_4397694676588900371]&#10;WHEN &apos;% POs Handled Externally&apos; then [Calculation_4397694676589264916]&#10;WHEN &apos;Hours Worked&apos; then SUM([Calculation_4397694676603695132])&#10;WHEN &apos;Hours Scheduled&apos; then SUM([Calculation_2923821344460640259])&#10;WHEN &apos;Overtime&apos; then SUM([non_clock_out_hours])&#10;WHEN &apos;Picking Occupancy&apos; then [Calculation_4397694676600127512]&#10;WHEN &apos;Hours Worked Receiving&apos; then SUM([Calculation_4397694676600827929])&#10;WHEN &apos;Receiving Occupancy&apos; then [Calculation_4397694676601073690]&#10;WHEN &apos;Hours Worked Prep. Orders (Picking + Packing)&apos; then SUM([Calculation_1038150109110329353])&#10;WHEN &apos;Idle Time&apos; then [Calculation_1038150109110603787]&#10;WHEN &apos;Idle Time %&apos; then [Calculation_1038150109794246684]&#10;WHEN &apos;Hour Order Distribution Percentage&apos; then [Calculation_1038150109139165200]&#10;WHEN &apos;Day Order Distribution Percentage&apos; then [Calculation1]&#10;WHEN &apos;Hour POs Distribution Percentage&apos; then [Hour Order Distribution Percentage (copy)_1038150109405794324]&#10;WHEN &apos;Day POs Distribution Percentage&apos; then [Calculation3]&#10;WHEN &apos;Picker Order UTR&apos; then [Calculation_4397694676590141461]&#10;WHEN &apos;Picker Item UTR&apos; then [Calculation_131941420225449989]&#10;WHEN &apos;Picker Est. CPO&apos; then [Calculation_1038150109757132827]&#10;WHEN &apos;Order Prep. Time Breach %&apos; THEN [Calculation_4397694676581859334]&#10;WHEN &apos;POs Received&apos; THEN SUM([purchase_orders])&#10;WHEN &apos;AVG SKUs/PO&apos; THEN [Calculation_131941420227903494]&#10;WHEN &apos;AVG Receiving Time/SKU&apos; THEN [Calculation_131941420228218887]&#10;WHEN &apos;Units Counted&apos; THEN SUM([Calculation_321796297260433422])&#10;WHEN &apos;AVG Prep Time [m]&apos; THEN [Avg. Transmission Time (m) (copy)_4544835757590638592]&#10;WHEN &apos;AVG Prep Time Buffer [m]&apos; THEN [Avg. Prep Time (m)  (copy)_4544835757590904833]&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg. Pick Up Distance' datatype='real' name='[Calculation_4976618371940003840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pickup_distance_s])/SUM([pickup_distance_count])' />
      </column>
      <column caption='Avg. Items per Sku per Order' datatype='real' name='[Calculation_5003851037556137988]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1092685896280666112]/[Calculation_1092685896280797185]' />
      </column>
      <column caption='Date' datatype='datetime' default-format='*YY-MM-DD' name='[Calculation_5305803324295176197]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;day&apos; THEN DATETRUNC(&apos;day&apos;, [static_day]) &#10;WHEN &apos;week&apos; THEN DATETRUNC(&apos;week&apos;, [static_day])&#10;WHEN &apos;month&apos; THEN DATETRUNC(&apos;month&apos;, [static_day])  &#10;WHEN &apos;quarter&apos; THEN DATETRUNC(&apos;quarter&apos;, [static_day]) &#10;END' />
      </column>
      <column caption='Attendance %' datatype='real' name='[Calculation_5305803324307316745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([worked_hours]) / SUM([planned_hours]))' />
      </column>
      <column caption='Found Rate %' datatype='real' name='[Calculation_5737797094515257344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([order_skus_delivered])/sum([order_skus_ordered])' />
      </column>
      <column caption='Jitter' datatype='integer' name='[Calculation_6731333380011696130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='index()%[Parameters].[p_comparison - KPIs - Put_away (copy)]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Month of Date' datatype='date' name='[Calculation_6745055255008800768]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[Calculation_5305803324295176197]))' />
      </column>
      <column caption='Checking the parameter with month of Date column' datatype='string' name='[Calculation_6745055255009599490]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [Parameters].[Parameter 7] = [Calculation_6745055255008800768] THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
      </column>
      <column caption='Avg. Daily Successful Order' datatype='real' name='[Calculation_6745055255009910787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED[warehouse_id],[Calculation_6745055255008800768]:(sum([successful_orders])/countd([static_day]))}' />
      </column>
      <column caption='Is Avg. Daily Success Order &gt;300' datatype='string' name='[Calculation_6745055255009955844]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [Calculation_6745055255009910787] &gt;= 300 THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
      </column>
      <column caption='Country 2' datatype='string' name='[Country* (copy)_3974356351466971139]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='tableau' formula='IFNULL([country],[country])' />
      </column>
      <column caption='Hour POs Distribution Percentage' datatype='real' name='[Hour Order Distribution Percentage (copy)_1038150109405794324]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([purchase_orders])/sum([Successful Orders by Day (copy)_1038150109405679635])' />
      </column>
      <column caption='Is Avg. Daily Success Order Qty &gt;2800' datatype='string' name='[Is Avg. Daily Success order &gt;300 (copy)_4752001314039861248]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If [Avg. Daily Successful order (copy)_4752001314040172546] &gt;= 2800 THEN &apos;Yes&apos; ELSE &apos;No&apos; END' />
      </column>
      <column caption='Is Stacked Delivery' datatype='boolean' name='[Is Preorder (copy)_4976618371942137859]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [stacked_orders] &gt; 1 THEN TRUE &#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='Is Manual Dispatching' datatype='boolean' name='[Is Stacked Delivery (copy)_4976618371942670340]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [manual_dispatching] &gt; 1 THEN TRUE &#10;ELSE FALSE&#10;END' />
      </column>
      <column caption='KPI 2' datatype='real' default-format='N' name='[KPI 1 (copy)_321796298686779414]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[KPI Switcher - 1 (copy)_321796298686890007]&#10;WHEN &apos;Successful Orders&apos; then SUM([successful_orders])&#10;WHEN &apos;Total Items&apos; then SUM([order_qty])&#10;WHEN &apos;AVG Basket Size&apos; then [Calculation_4397694676580687876]&#10;WHEN &apos;AVG Order Prep. Time [m]&apos; then [Calculation_321796296914194437]&#10;WHEN &apos;Breach %&apos; then [Calculation_4397694676581859334]&#10;WHEN &apos;AVG Picking Time per Item [s]&apos; then [Calculation_4397694676582125575]&#10;WHEN &apos;% Orders Handled Externally&apos; then [Calculation_4397694676583247881]&#10;WHEN &apos;% Modified Orders&apos; then [Calculation_4397694676583690250]&#10;WHEN &apos;Failed Rate&apos; then [Calculation_4397694676583907339]&#10;WHEN &apos;AVG Transmission Time [m]&apos; then [Calculation_4397694676584493068]&#10;WHEN &apos;AVG Assignment Time [m]&apos; then [Calculation_4397694676584882189]&#10;WHEN &apos;AVG Picking Time [m]&apos; then [Calculation_4397694676585279502]&#10;WHEN &apos;AVG Packaging Time [m]&apos; then [Calculation_4397694676585443343]&#10;WHEN &apos;AVG Dispatching Time [m]&apos; then [Calculation_4397694676585627664]&#10;WHEN &apos;AVG Delivery Time [m]&apos; then [Calculation_4329929583180603393]&#10;WHEN &apos;Total PO&apos; then SUM([Calculation_2923821344462135302])&#10;WHEN &apos;Total PO Items&apos; then SUM([purchase_order_items])&#10;WHEN &apos;PO Basket Size&apos; then SUM([Calculation_4397694676588236818])&#10;WHEN &apos;AVG PO Receiving Time [m]&apos; then [Calculation_4397694676588900371]&#10;WHEN &apos;% POs Handled Externally&apos; then [Calculation_4397694676589264916]&#10;WHEN &apos;Hours Worked&apos; then SUM([Calculation_4397694676603695132])&#10;WHEN &apos;Hours Scheduled&apos; then SUM([Calculation_2923821344460640259])&#10;WHEN &apos;Overtime&apos; then SUM([non_clock_out_hours])&#10;WHEN &apos;Picking Occupancy&apos; then [Calculation_4397694676600127512]&#10;WHEN &apos;Hours Worked Receiving&apos; then SUM([Calculation_4397694676600827929])&#10;WHEN &apos;Receiving Occupancy&apos; then [Calculation_4397694676601073690]&#10;WHEN &apos;Hours Worked Prep. Orders (Picking + Packing)&apos; then SUM([Calculation_1038150109110329353])&#10;WHEN &apos;Idle Time&apos; then [Calculation_1038150109110603787]&#10;WHEN &apos;Idle Time %&apos; then [Calculation_1038150109794246684]&#10;WHEN &apos;Hour Order Distribution Percentage&apos; then [Calculation_1038150109139165200]&#10;WHEN &apos;Day Order Distribution Percentage&apos; then [Calculation1]&#10;WHEN &apos;Hour POs Distribution Percentage&apos; then [Hour Order Distribution Percentage (copy)_1038150109405794324]&#10;WHEN &apos;Day POs Distribution Percentage&apos; then [Calculation3]&#10;WHEN &apos;Picker Order UTR&apos; then [Calculation_4397694676590141461]&#10;WHEN &apos;Picker Item UTR&apos; then [Calculation_131941420225449989]&#10;WHEN &apos;Picker Est. CPO&apos; then [Calculation_1038150109757132827]&#10;WHEN &apos;Order Prep. Time Breach %&apos; THEN [Calculation_4397694676581859334]&#10;WHEN &apos;POs Received&apos; THEN SUM([purchase_orders])&#10;WHEN &apos;AVG SKUs/PO&apos; THEN [Calculation_131941420227903494]&#10;WHEN &apos;AVG Receiving Time/SKU&apos; THEN [Calculation_131941420228218887]&#10;WHEN &apos;Units Counted&apos; THEN SUM([Calculation_321796297260433422])&#10;WHEN &apos;AVG Prep Time [m]&apos; THEN [Avg. Transmission Time (m) (copy)_4544835757590638592]&#10;WHEN &apos;AVG Prep Time Buffer [m]&apos; THEN [Avg. Prep Time (m)  (copy)_4544835757590904833]&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Delivery Time KPI ' datatype='real' default-format='N' name='[KPI 2 (copy)_4544835757598314498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Deep Dive KPI Switcher - 1 (copy)_321796298680541204]&#10;WHEN &apos;AVG Prep Time [m]&apos; THEN [Avg. Transmission Time (m) (copy)_4544835757590638592]&#10;WHEN &apos;AVG Prep Time Buffer [m]&apos; THEN [Avg. Prep Time (m)  (copy)_4544835757590904833]&#10;WHEN &apos;AVG Pick Up Distance&apos; THEN [Calculation_4976618371940003840]&#10;WHEN &apos;AVG Actual Delivery Time - Logistics&apos; THEN [Avg. Assignment Time (m) (copy)_4976618371941134337]&#10;WHEN &apos;Preorder %&apos; THEN [Attendance % (copy)_4976618371941453826]&#10;WHEN &apos;Stacked Order %&apos; THEN [Preorder %  (copy)_4976618371943280645]&#10;WHEN &apos;Manual Dispatching %&apos; THEN [Preorder %  (copy)_4976618371943452678]&#10;WHEN &apos;% Orders Delivered &lt; 20m&apos; THEN [Preorder %  (copy)_4976618371943714823]&#10;WHEN &apos;% Orders Late &gt; 10m&apos; THEN [% Orders Delivered &lt; 20m (copy)_4976618371944071176]&#10;WHEN &apos;% Rider Late &gt; 10m&apos; THEN [% Vendor Late &gt; 10m  (copy)_4976618371944706058]&#10;END' />
      </column>
      <column caption='Items picked (with work hours)' datatype='real' name='[Order Qty Delivered (copy)_223772612442640384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [worked_hours] &gt; 0 THEN [order_qty_picked] ELSE NULL END' />
      </column>
      <column caption='d_comparison - KPIs - Orders Related - KPIs Sufix' datatype='string' default-format='N' name='[Orders Related KPI (copy)_2122251000131711001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Country Selected (copy)]&#10;&#10;    WHEN &quot;Late Orders&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Partial Fulfilment Rate %&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Fulfilment Time Breach %&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Avg. Basket Size&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Modified Orders&quot;&#10;    THEN &quot;%&quot;&#10;&#10;    WHEN &quot;Avg. SKUs/PO&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Avg. Receiving Time/SKU&quot;&#10;    THEN &quot; &quot;&#10;&#10;    WHEN &quot;Fail Rate&quot;&#10;    THEN &quot;%&quot;&#10;&#10;END' />
      </column>
      <column caption='Receiving Time (%) ' datatype='real' name='[Other/Idle Time (%) (copy)_321796297202089995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1038150109110513674])/&#10;(zn([Calculation_1038150109110603787])+zn(SUM([Calculation_1038150109110513674]))&#10;+zn(sum([Calculation_1038150109110329353]))&#10;+zn(sum([Calculation_1038150109578072088])))' />
      </column>
      <column caption='Picking + Packaging Time (%) ' datatype='real' name='[Other/Idle Time (%) (copy)_321796297202212876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1038150109110329353])/&#10;(zn([Calculation_1038150109110603787])+zn(SUM([Calculation_1038150109110513674]))&#10;+zn(sum([Calculation_1038150109110329353]))&#10;+zn(sum([Calculation_1038150109578072088])))' />
      </column>
      <column caption='Cycle Count Time (%)' datatype='real' name='[Other/Idle Time (%) (copy)_321796297202389005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1038150109578072088])/&#10;(zn([Calculation_1038150109110603787])+zn(SUM([Calculation_1038150109110513674]))&#10;+zn(sum([Calculation_1038150109110329353]))&#10;+zn(sum([Calculation_1038150109578072088])))' />
      </column>
      <column caption='Estimated Picker Cost Euro' datatype='real' name='[Picker Estimated CPO LC (copy)_1038150109575553047]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[worked_hours]*[hourly_rate_euro]' />
      </column>
      <column caption='Stacked Order %  ' datatype='real' name='[Preorder %  (copy)_4976618371943280645]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([stacked_orders]) / SUM([successful_orders]))' />
      </column>
      <column caption='Manual Dispatching %' datatype='real' name='[Preorder %  (copy)_4976618371943452678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([manual_dispatching]) / SUM([successful_orders]))' />
      </column>
      <column caption='% Orders Delivered &lt; 20m' datatype='real' name='[Preorder %  (copy)_4976618371943714823]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([order_delivered_below_20]) / SUM([successful_orders]))' />
      </column>
      <column caption='Put-away time/ SKU (s)' datatype='real' name='[Put-away time Corr./ SKU (m) (copy)_171559011643076609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([putaway_time])/(sum([sku_qty]))' />
      </column>
      <column caption='Put-away time Corr./ Unit (s)' datatype='real' name='[Put-away time Corr./ SKU (s) (copy)_2148287410331680768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([putaway_time_corr])/(sum(putaway_qty))' />
      </column>
      <column caption='% Batches with Putaway time/SKU &gt;10mins' datatype='real' name='[Put-away time Corr./ SKU (s) (copy)_2148287410333822978]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([putaway_batch_count_10m])/(sum([putaway_batch_count]))' />
      </column>
      <column caption='Put-away time Corr./ Batch(m)' datatype='real' name='[Put-away time Corr./ Unit (s) (copy)_2148287410332180481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([putaway_time_corr])/(sum([putaway_batch_count])*60)' />
      </column>
      <column caption='Put-away time/ SKU (m)' datatype='real' name='[Put-away time/ SKU (s) (copy)_6731333380005322753]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND((sum([putaway_time])/(sum([sku_qty]))/60),1)' />
      </column>
      <column caption='Counting Occupancy' datatype='real' name='[Receiving Occupancy (copy)_1038150110178754595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([Calculation_1038150109578072088]) / SUM([worked_hours]))' />
      </column>
      <column caption='Putaway Units per Batch' datatype='real' name='[SKU Put-away per Batch (copy)_171559011643969539]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([putaway_qty])/sum([putaway_batch_count])' />
      </column>
      <column caption='Live Stores' datatype='integer' name='[Stores with Rooster (copy)_321796296592498691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_active] THEN [warehouse_id] END)' />
      </column>
      <column caption='POs by Day ' datatype='real' name='[Successful Orders by Day (copy)_1038150109405679635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ fixed [static_day],[warehouse_name],[warehouse_id]: SUM([purchase_orders])}' />
      </column>
      <column caption='granular_date' datatype='string' name='[X-Axis (copy)_3974356351455825921]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATE([Calculation_5305803324295176197]))' />
      </column>
      <column caption='X-Axis v2' datatype='string' name='[X-Axis (copy)_3974356351647137875]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[X-Axis (copy)_3974356351647285332]&#10;WHEN &apos;Countries&apos; THEN [Calculation_4217198858826571776] &#10;WHEN &apos;Stores&apos; THEN [warehouse_name] &#10;ELSE [Calculation_4217198858827358209] END' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='edu_tableau_store_performance_report' datatype='table' name='[__tableau_internal_object_id__].[edu_tableau_store_performance_report_2A2D4D24D1294F648BB248A38AB71B6F]' role='measure' type='quantitative' />
