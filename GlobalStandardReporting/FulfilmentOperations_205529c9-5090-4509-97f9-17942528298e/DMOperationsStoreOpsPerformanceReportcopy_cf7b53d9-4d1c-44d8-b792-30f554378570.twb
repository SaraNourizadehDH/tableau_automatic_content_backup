              <calculation class='tableau' formula='sum([sku_qty])/sum([putaway_batch_count])' />
            </column>
            <column caption='d_comparison - X-Axis' datatype='string' name='[Calculation_2122250999791771649]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[KPI Switcher - 2 (copy)]&#10;WHEN &apos;country&apos; THEN [Country* (copy)_3974356351466971139] &#10;ELSE STR([Calculation_2122250999881494535]) &#10;END' />
            </column>
            <column caption='m_comparison - Color Filter' datatype='integer' name='[Calculation_2122250999811817478]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[KPI Switcher - 2 (copy)]&#10;    WHEN &quot;country&quot;&#10;        THEN &#10;            IF [Country* (copy)_3974356351466971139] = [Parameters].[Time Aggregation (copy)] &#10;                THEN 1 &#10;                ELSE 0&#10;            END&#10;    ELSE&#10;             IF [Calculation_2122250999881494535] = [Parameters].[country_selected (copy)_2122250999810654213]&#10;                THEN 1 &#10;                ELSE 0&#10;            END&#10;END' />
            </column>
            <column caption='d_comparison - Warehouse Name' datatype='string' name='[Calculation_2122250999881494535]' role='dimension' type='nominal'>
