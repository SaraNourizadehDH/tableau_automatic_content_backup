    <dashboard name='KPI Definitions'>
      <repository-location derived-from='http://ip-172-31-0-203:8670/t/GlobalStandardReporting/workbooks/DarkStores-FulfillmentTimesReportHourlydev/KPIDefinitions_1?rev=' id='KPIDefinitions' path='/t/GlobalStandardReporting/workbooks/DM-Operations-StoreOpsPerformanceReport_copy' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1068' maxwidth='1566' minheight='1068' minwidth='1566' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98502' id='3' type-v2='text' w='46004' x='511' y='749'>
            <formatted-text>
              <run bold='true' fontcolor='#ffffff' fontsize='15'>KPI Definitions</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='12'>Times:</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Æ </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Transmission Time</run>
              <run fontcolor='#ffffff' fontsize='10'> - time diff. [m]: order placed to order in Shopper Management</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Hold Time</run>
              <run fontcolor='#ffffff' fontsize='10'> - </run>
              <run fontcolor='#ffffff' fontname='Benton Sans Book' fontsize='10'>time diff. [m]: order in Shopper Management to order available in Pelican (for assignment)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Assignment Time</run>
              <run fontcolor='#ffffff' fontsize='10'> - time diff. [m]: order in Pelican to order started by a picker</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Picking Time</run>
              <run fontcolor='#ffffff' fontsize='10'> - time diff. [m]: order started to picking the last item</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Picking Time per Item</run>
              <run fontcolor='#ffffff' fontsize='10'> [s] : avg  time in seconds it takes for picker to put 1 item in basket.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Packaging Time</run>
              <run fontcolor='#ffffff' fontsize='10'> - time diff. in [m]: checkout confirmed to ready for pickup</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Order Prep. Time </run>
              <run fontcolor='#ffffff' fontsize='10'>- picking time and packing time</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Order Fulfillment Time </run>
              <run fontcolor='#ffffff' fontsize='10'>- time diff. in [m]: order in Pelican to ready to pickup</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Dispatching Time</run>
              <run fontcolor='#ffffff' fontsize='10'> - time diff. in [m]: order ready for pickup to order pickup by rider</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Drive Time</run>
              <run fontcolor='#ffffff' fontsize='10'> - time diff. in [m]: order pickup to order drop off by rider</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Receiving Time</run>
              <run fontcolor='#ffffff' fontsize='10'> - time diff. in [s]: purchase order started to purchase order finished</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Driver Waiting Time</run>
              <run fontcolor='#ffffff' fontsize='10'> - time diff. in [s]: rider near pickup to order pickup</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='12'>Order Related:</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Orders</run>
              <run fontcolor='#ffffff' fontsize='10'> - total orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Successful Orders</run>
              <run fontcolor='#ffffff' fontsize='10'> - orders where is_sent = TRUE</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Late Orders</run>
              <run fontcolor='#ffffff' fontsize='10'> - orders with driver waiting time &gt; 0 minute</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Partial Fulfilment Rate %</run>
              <run fontcolor='#ffffff' fontsize='10'><![CDATA[ - number of orders with units delivered < units ordered / successful orders]]></run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Fulfilment Time Breach %</run>
              <run fontcolor='#ffffff' fontsize='10'> - orders with fulfilment_time_s &gt; 120 / successful orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Handled Externally</run>
              <run fontcolor='#ffffff' fontsize='10'> - orders handled outside of Pelican</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Modified Orders</run>
              <run fontcolor='#ffffff' fontsize='10'> - where qty_returned &gt; 0, order is not cancelled and order was succesfful</run>
              <run fontcolor='#ffffff'>Æ </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Total Items</run>
              <run fontcolor='#ffffff' fontsize='10'> - Sum of all items ordered.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Basket Size</run>
              <run fontcolor='#ffffff' fontsize='10'> -  Total Items / Orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Hour Order Distribution Percentage</run>
              <run fontcolor='#ffffff' fontsize='10'> - orders in that specific hour interval / total orders in the day</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Day Order Distribution Percentage</run>
              <run fontcolor='#ffffff' fontsize='10'> - orders in that specific hour interval / total orders in the week for that hour interval</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Is Avg. Daily Order &gt; 300 - </run>
              <run fontcolor='#ffffff' fontsize='10'>If avg. daily successful order for month of date per warehouse is &gt;=300 then True else False</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Is Avg. Daily Order Qty &gt; 2800 - </run>
              <run fontcolor='#ffffff' fontsize='10'>If avg. daily order qty delivred for month of date per warehouse is &gt;=300 then True else False</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='12'>Purchase Order Related:</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>POs received</run>
              <run fontcolor='#ffffff' fontsize='10'> - number of purchase orders received</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. SKUs/PO</run>
              <run fontcolor='#ffffff' fontsize='10'> - average number of SKUs per purchase order</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Receiving Time/SKU</run>
              <run fontcolor='#ffffff' fontsize='10'> - average time for a picker to receive a SKU</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Hour POs Distribution Percentage</run>
              <run fontcolor='#ffffff' fontsize='10'> - number of POs in that specific hour interval / total POs in the day</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Day POs Distribution Percentage</run>
              <run fontcolor='#ffffff' fontsize='10'> - number of POs in that specific hour interval / total POs in the week for that hour interval</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#555555' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='85441' id='127' type-v2='text' w='52974' x='46515' y='13810'>
            <formatted-text>
              <run bold='true' fontcolor='#ffffff' fontsize='12'>Cycle Count Related:</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Units counted</run>
              <run fontcolor='#ffffff' fontsize='10'> - number of units counted in cycle counts</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='12'>Shifts Related:</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Evaluated Shifts</run>
              <run fontcolor='#ffffff' fontsize='10'> - successful shifts</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>No- Clock Out Shifts (%)</run>
              <run fontcolor='#ffffff' fontsize='10'> - number of shifts that have time between clock-in and clock-out is longer than 15h / number of shifts</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Hours Worked</run>
              <run fontcolor='#ffffff' fontsize='10'> - hours worked by the picker. Calculated by the time dif between the picker clock-in and clock-out</run>
              <run>Æ&#10;</run>
              <run fontcolor='#ffffff' fontsize='10' italic='true'>In cases where shift is longer than 15h (when picker forgets to clock out) we calculate the working hours by adding the scheduled shift duration to the clock in time of the picker.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Scheduled Hours</run>
              <run fontcolor='#ffffff' fontsize='10'> - hours scheduled for the particular shift</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Attendance (%) </run>
              <run fontcolor='#ffffff' fontsize='10'>- hours worked / hours scheduled - can be higher than 100% in cases when due to being late for the shift or doing overtime the picker is working during hours he was not scheduled to work.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Order UTR</run>
              <run fontcolor='#ffffff' fontsize='10'> - Number of orders picked / Hours Worked</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Item UTR</run>
              <run fontcolor='#ffffff' fontsize='10'> - Number of items picked / Hours Worked </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Picker Est. CPO</run>
              <run fontcolor='#ffffff' fontsize='10'> - Picker Labor Cost / Number of Orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Hours Worked Prep. Orders</run>
              <run fontcolor='#ffffff' fontsize='10'> - the sum of the Picking Time and Packing Time</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Occupancy (%)</run>
              <run fontcolor='#ffffff' fontsize='10'> - Hours Worked Picking, Receiving, and Counting / Hours Worked</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Picking Occupancy</run>
              <run fontcolor='#ffffff' fontsize='10'> - Hours Worked Picking / Hours Worked</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Receiving Occupancy</run>
              <run fontcolor='#ffffff' fontsize='10'> - Hours Worked Receiving / Hours Worked</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Counting Occupancy </run>
              <run fontcolor='#ffffff' fontsize='10'>- Hours Worked Counting / Hours Worked</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Hours Worked Receiving</run>
              <run fontcolor='#ffffff' fontsize='10'> - the sum of the Receiving Time (for POs) [m] / 60</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='12'>Store Transfer Related:</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Store Transfers</run>
              <run fontcolor='#ffffff' fontsize='10'> - How many ST were originated there</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Store Transfer SKUs</run>
              <run fontcolor='#ffffff' fontsize='10'> - Total ST SKU count at origin warehouse</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. SKUs/ST</run>
              <run fontcolor='#ffffff' fontsize='10'> - Avg SKU count per ST at origin warehouse</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Items/SKU/ST</run>
              <run fontcolor='#ffffff' fontsize='10'> - Avg SKU Quantity per SKU per ST at origin warehouse</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. ST Time (m)</run>
              <run fontcolor='#ffffff' fontsize='10'> - Avg Time taken per ST at destination warehouse </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>ST Time (m) / SKU</run>
              <run fontcolor='#ffffff' fontsize='10'> - Avg ST Time taken per SKU at destination warehouse </run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='12'>Put-away Related:</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Put-away time/ SKU (s)</run>
              <run fontcolor='#ffffff' fontsize='10'> - Average put-away time per SKU in seconds</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Put-away time Corr. </run>
              <run fontcolor='#ffffff' fontsize='10'>- If for a batch put-away time/ SKU is more then 10 minutes it&apos;s considered as 10 minutes</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Put-away time Corr./ SKU (s) </run>
              <run fontcolor='#ffffff' fontsize='10'>- Average put-away time corr. per SKU in seconds</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Put-away time Corr./ Batch (m) </run>
              <run fontcolor='#ffffff' fontsize='10'>- Average put-away time corr. per out-away batch in minutes</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Put-away time Corr./ Unit (s) </run>
              <run fontcolor='#ffffff' fontsize='10'>- Average put-away time corr. per unit in seconds</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>% Batches with Putaway time/SKU &gt;10mins</run>
              <run fontcolor='#ffffff' fontsize='10'> - % of put-away batches where put-away time / SKU is greated than 10 minutes</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Putaway Batch Count</run>
              <run fontcolor='#ffffff' fontsize='10'> - Total number of put-away batched</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>SKU Put-away per Batch</run>
              <run fontcolor='#ffffff' fontsize='10'> - Number of SKU per batch</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#ffffff' fontsize='10'>Putaway Units per Batch</run>
              <run fontcolor='#ffffff' fontsize='10'> - Total Quantity of SKUs per batch</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#555555' />
            </zone-style>
          </zone>
          <zone h='13061' id='132' param='horz' type-v2='layout-flow' w='52974' x='46515' y='749'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='background-color' value='#555555' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
            <format attr='background-color' value='#555555' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='1196' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='1195' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone forceUpdate='true' h='98502' id='3' type-v2='text' w='46004' x='511' y='749'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ffffff' fontsize='15'>KPI Definitions</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='12'>Times:</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Æ </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Transmission Time</run>
                    <run fontcolor='#ffffff' fontsize='10'> - time diff. [m]: order placed to order in Shopper Management</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Hold Time</run>
                    <run fontcolor='#ffffff' fontsize='10'> - </run>
                    <run fontcolor='#ffffff' fontname='Benton Sans Book' fontsize='10'>time diff. [m]: order in Shopper Management to order available in Pelican (for assignment)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Assignment Time</run>
                    <run fontcolor='#ffffff' fontsize='10'> - time diff. [m]: order in Pelican to order started by a picker</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Picking Time</run>
                    <run fontcolor='#ffffff' fontsize='10'> - time diff. [m]: order started to picking the last item</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Picking Time per Item</run>
                    <run fontcolor='#ffffff' fontsize='10'> [s] : avg  time in seconds it takes for picker to put 1 item in basket.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Packaging Time</run>
                    <run fontcolor='#ffffff' fontsize='10'> - time diff. in [m]: checkout confirmed to ready for pickup</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Order Prep. Time </run>
                    <run fontcolor='#ffffff' fontsize='10'>- picking time and packing time</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Order Fulfillment Time </run>
                    <run fontcolor='#ffffff' fontsize='10'>- time diff. in [m]: order in Pelican to ready to pickup</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Dispatching Time</run>
                    <run fontcolor='#ffffff' fontsize='10'> - time diff. in [m]: order ready for pickup to order pickup by rider</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Drive Time</run>
                    <run fontcolor='#ffffff' fontsize='10'> - time diff. in [m]: order pickup to order drop off by rider</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Receiving Time</run>
                    <run fontcolor='#ffffff' fontsize='10'> - time diff. in [s]: purchase order started to purchase order finished</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Driver Waiting Time</run>
                    <run fontcolor='#ffffff' fontsize='10'> - time diff. in [s]: rider near pickup to order pickup</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='12'>Order Related:</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Orders</run>
                    <run fontcolor='#ffffff' fontsize='10'> - total orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Successful Orders</run>
                    <run fontcolor='#ffffff' fontsize='10'> - orders where is_sent = TRUE</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Late Orders</run>
                    <run fontcolor='#ffffff' fontsize='10'> - orders with driver waiting time &gt; 0 minute</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Partial Fulfilment Rate %</run>
                    <run fontcolor='#ffffff' fontsize='10'><![CDATA[ - number of orders with units delivered < units ordered / successful orders]]></run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Fulfilment Time Breach %</run>
                    <run fontcolor='#ffffff' fontsize='10'> - orders with fulfilment_time_s &gt; 120 / successful orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Handled Externally</run>
                    <run fontcolor='#ffffff' fontsize='10'> - orders handled outside of Pelican</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Modified Orders</run>
                    <run fontcolor='#ffffff' fontsize='10'> - where qty_returned &gt; 0, order is not cancelled and order was succesfful</run>
                    <run fontcolor='#ffffff'>Æ </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Total Items</run>
                    <run fontcolor='#ffffff' fontsize='10'> - Sum of all items ordered.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Basket Size</run>
                    <run fontcolor='#ffffff' fontsize='10'> -  Total Items / Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Hour Order Distribution Percentage</run>
                    <run fontcolor='#ffffff' fontsize='10'> - orders in that specific hour interval / total orders in the day</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Day Order Distribution Percentage</run>
                    <run fontcolor='#ffffff' fontsize='10'> - orders in that specific hour interval / total orders in the week for that hour interval</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Is Avg. Daily Order &gt; 300 - </run>
                    <run fontcolor='#ffffff' fontsize='10'>If avg. daily successful order for month of date per warehouse is &gt;=300 then True else False</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Is Avg. Daily Order Qty &gt; 2800 - </run>
                    <run fontcolor='#ffffff' fontsize='10'>If avg. daily order qty delivred for month of date per warehouse is &gt;=300 then True else False</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='12'>Purchase Order Related:</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>POs received</run>
                    <run fontcolor='#ffffff' fontsize='10'> - number of purchase orders received</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. SKUs/PO</run>
                    <run fontcolor='#ffffff' fontsize='10'> - average number of SKUs per purchase order</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Avg. Receiving Time/SKU</run>
                    <run fontcolor='#ffffff' fontsize='10'> - average time for a picker to receive a SKU</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Hour POs Distribution Percentage</run>
                    <run fontcolor='#ffffff' fontsize='10'> - number of POs in that specific hour interval / total POs in the day</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Day POs Distribution Percentage</run>
                    <run fontcolor='#ffffff' fontsize='10'> - number of POs in that specific hour interval / total POs in the week for that hour interval</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#555555' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='85441' id='127' type-v2='text' w='52974' x='46515' y='13810'>
                  <formatted-text>
                    <run bold='true' fontcolor='#ffffff' fontsize='12'>Cycle Count Related:</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#ffffff' fontsize='10'>Units counted</run>
                    <run fontcolor='#ffffff' fontsize='10'> - number of units counted in cycle counts</run>
                    <run>Æ&#10;&#10;</run>
