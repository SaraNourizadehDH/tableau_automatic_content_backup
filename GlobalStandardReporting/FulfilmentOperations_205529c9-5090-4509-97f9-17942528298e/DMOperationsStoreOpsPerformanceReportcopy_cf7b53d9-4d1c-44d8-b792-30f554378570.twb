      <column caption='Count Receiving Time' datatype='real' name='[count_receiving_time]' role='measure' type='quantitative' />
      <column caption='Count Starting Time' datatype='real' name='[count_starting_time]' role='measure' type='quantitative' />
      <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
