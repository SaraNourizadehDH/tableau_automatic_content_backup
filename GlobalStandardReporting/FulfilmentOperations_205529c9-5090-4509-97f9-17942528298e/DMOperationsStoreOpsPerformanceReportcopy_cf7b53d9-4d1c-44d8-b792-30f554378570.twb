            <column alias='A Warehouse' caption='p_comparison - What would you like to correlate' datatype='string' name='[p_comparison - What would you like to compare (copy)_3974356351622127689]' param-domain-type='list' role='measure' type='nominal' value='&quot;warehouse&quot;'>
              <calculation class='tableau' formula='&quot;warehouse&quot;' />
              <aliases>
