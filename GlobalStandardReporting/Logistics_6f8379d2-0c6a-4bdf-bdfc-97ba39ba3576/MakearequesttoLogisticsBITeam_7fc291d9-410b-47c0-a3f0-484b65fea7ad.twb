      </column>
      <column alias='Reaction Time' caption='Choose Measure' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Reaction Time&quot;'>
        <calculation class='tableau' formula='&quot;Reaction Time&quot;' />
        <aliases>
          <alias key='&quot;At Customer Time&quot;' value='At Customer Time' />
          <alias key='&quot;At Vendor Time&quot;' value='At Vendor Time' />
          <alias key='&quot;Reaction Time&quot;' value='Reaction Time' />
          <alias key='&quot;To Customer Time&quot;' value='To Customer Time' />
          <alias key='&quot;To Vendor Time&quot;' value='To Vendor Time' />
        </aliases>
        <members>
          <member alias='Reaction Time' value='&quot;Reaction Time&quot;' />
          <member alias='To Vendor Time' value='&quot;To Vendor Time&quot;' />
          <member alias='At Vendor Time' value='&quot;At Vendor Time&quot;' />
          <member alias='To Customer Time' value='&quot;To Customer Time&quot;' />
          <member alias='At Customer Time' value='&quot;At Customer Time&quot;' />
          <member value='&quot;Rider Effective DT&quot;' />
          <member value='&quot;Idle Time&quot;' />
        </members>
      </column>
      <column caption='Switch' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Absolute Values&quot;'>
        <calculation class='tableau' formula='&quot;Absolute Values&quot;' />
        <members>
          <member value='&quot;Absolute Values&quot;' />
          <member value='&quot;Percentage Values&quot;' />
        </members>
      </column>
      <column caption='Choose Timings' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Reaction Time&quot;'>
        <calculation class='tableau' formula='&quot;Reaction Time&quot;' />
        <members>
          <member value='&quot;Reaction Time&quot;' />
          <member value='&quot;To Vendor Time&quot;' />
          <member value='&quot;At Vendor Time&quot;' />
          <member value='&quot;To Customer Time&quot;' />
          <member value='&quot;At Customer Time&quot;' />
          <member value='&quot;Idle Time&quot;' />
          <member value='&quot;Rider Effective Time&quot;' />
        </members>
      </column>
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[Parameter 3]' type='palette'>
