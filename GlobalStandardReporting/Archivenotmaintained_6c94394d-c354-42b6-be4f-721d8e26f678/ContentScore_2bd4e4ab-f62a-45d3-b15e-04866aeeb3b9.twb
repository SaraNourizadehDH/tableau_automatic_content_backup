      <column caption='Dimension ' datatype='string' name='[Calculation_518969534262710274]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Region&apos; THEN [region]&#10;WHEN &apos;Country&apos; THEN [global_entity_id]&#10;WHEN &apos;Product Type&apos; THEN [Product Type (copy)_3736791480071950336]&#10;WHEN &apos;Code&apos; THEN [code]&#10;END' />
      </column>
      <column caption='latest date filter' datatype='boolean' name='[Calculation_7027515439267237888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, [written_at],TODAY()) &lt;=7 THEN TRUE&#10;ELSE FALSE END' />
