    <worksheet name='ref skus'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' underline='true'>Inefficiency by Category</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_optimization_scores_rationalizer_store_v2' name='federated.010rk66132xq971f6gqq80zez27o' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.010rk66132xq971f6gqq80zez27o'>
            <column caption='GPV (6 Months)' datatype='real' name='[Calculation_150026164713431040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN &apos;Euro&apos; THEN [gmv_eur] ELSE [gmv_lc] END' />
            </column>
            <column caption='Total Mature SKUs' datatype='integer' name='[Calculation_2934658151588007936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [warehouse_sku_maturity] = &apos;mature_sku&apos; &#10;THEN ([sku]+[warehouse_id]) ELSE NULL END&#10;)' />
            </column>
            <column caption='Total Efficient SKUs' datatype='integer' name='[Calculation_2934658151588261889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [sku_efficiency] = &quot;efficient_sku&quot;&#10;AND [warehouse_sku_maturity] = &apos;mature_sku&apos;&#10;THEN ([sku]+[warehouse_id]) ELSE NULL END&#10;)' />
            </column>
            <column caption='Efficiency %' datatype='real' name='[Calculation_2934658151588564994]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [sku_efficiency] = &apos;efficient_sku&apos; &#10;AND [warehouse_sku_maturity] = &apos;mature_sku&apos;&#10;THEN ([sku]+[warehouse_id]) ELSE NULL END)&#10;/ COUNTD(IF [warehouse_sku_maturity] = &apos;mature_sku&apos; &#10;THEN ([sku]+[warehouse_id]) ELSE NULL END&#10;)' />
            </column>
            <column caption='Slow Mover SKUs' datatype='integer' name='[Calculation_2934658151591305219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [sku_efficiency] = &quot;slow_mover&quot;&#10;AND [avg_monthly_availability] = 1&#10;AND [warehouse_sku_maturity] = &apos;mature_sku&apos;&#10;THEN ([sku]+[warehouse_id])  ELSE NULL END&#10;)' />
            </column>
            <column caption='Slow Movers Book Value' datatype='real' name='[Calculation_2934658151591452676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [sku_efficiency] = &quot;slow_mover&quot; &#10;AND [avg_monthly_availability] = 1&#10;AND [warehouse_sku_maturity] = &apos;mature_sku&apos;&#10;THEN [last_day_book_value]ELSE 0 END&#10;)' />
            </column>
            <column caption='Slow Movers SKU Share %' datatype='real' name='[Calculation_2934658151591833605]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [sku_efficiency] = &quot;slow_mover&quot;&#10;AND [avg_monthly_availability] = 1&#10;AND [warehouse_sku_maturity] = &apos;mature_sku&apos;&#10;THEN ([sku]+[warehouse_id])  ELSE NULL END&#10;)&#10;/ COUNTD(IF [warehouse_sku_maturity] = &apos;mature_sku&apos; &#10;THEN ([sku]+[warehouse_id]) ELSE NULL END&#10;)' />
            </column>
            <column caption='Slow Movers Book Value Share %' datatype='real' name='[Calculation_2934658151592534022]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [sku_efficiency] = &quot;slow_mover&quot;&#10;AND [avg_monthly_availability] = 1&#10;AND [warehouse_sku_maturity] = &apos;mature_sku&apos;&#10;THEN [last_day_book_value] ELSE 0 END)&#10;/ &#10;SUM(IF [warehouse_sku_maturity] = &apos;mature_sku&apos;&#10;THEN [last_day_book_value]ELSE 0 END)' />
            </column>
            <column caption='Zero Movers SKUs' datatype='integer' name='[Calculation_2934658151594115079]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [sku_efficiency] = &quot;zero_mover&quot;&#10;AND [avg_monthly_availability] = 1&#10;AND [warehouse_sku_maturity] = &apos;mature_sku&apos;&#10;THEN ([sku]+[warehouse_id]) ELSE NULL END&#10;)' />
            </column>
            <column caption='Zero Movers Book Value' datatype='real' name='[Calculation_2934658151594262536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [sku_efficiency] = &quot;zero_mover&quot;&#10;AND [avg_monthly_availability] = 1&#10;AND [warehouse_sku_maturity] = &apos;mature_sku&apos;&#10;THEN [last_day_book_value] ELSE 0 END&#10;)' />
            </column>
            <column caption='Zero Movers SKU Share %' datatype='real' name='[Calculation_2934658151594606602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [sku_efficiency] = &quot;zero_mover&quot;&#10;AND [avg_monthly_availability] = 1&#10;AND [warehouse_sku_maturity] = &apos;mature_sku&apos;&#10;THEN ([sku]+[warehouse_id]) ELSE NULL END)&#10;/ COUNTD(IF [warehouse_sku_maturity] = &apos;mature_sku&apos; &#10;THEN ([sku]+[warehouse_id]) ELSE NULL END&#10;)' />
            </column>
            <column caption='Zero Movers Book Value Share %' datatype='real' name='[Calculation_2934658151594737675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [sku_efficiency] = &quot;zero_mover&quot;&#10;AND [avg_monthly_availability] = 1&#10;AND [warehouse_sku_maturity] = &apos;mature_sku&apos;&#10;THEN [last_day_book_value] ELSE 0 END)&#10;/ SUM(IF [warehouse_sku_maturity] = &apos;mature_sku&apos;&#10;THEN [last_day_book_value] ELSE 0 END)' />
            </column>
            <column caption='Front Margin %' datatype='real' name='[Calculation_2980186753056079875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(zn([total_sku_sales_eur_l6Mon]) - zn([cogs_eur]))/zn([total_sku_sales_eur_l6Mon])' />
            </column>
            <column caption='Total Inefficient Book Value Share %' datatype='real' name='[Calculation_3041618642746871808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [sku_efficiency] IN (&apos;zero_mover&apos; , &apos;slow_mover&apos;)&#10;AND [avg_monthly_availability] = 1&#10;AND [warehouse_sku_maturity] = &apos;mature_sku&apos; &#10;THEN [last_day_book_value] ELSE 0 END)&#10;/ SUM(IF [warehouse_sku_maturity] = &apos;mature_sku&apos;&#10;THEN [last_day_book_value] ELSE 0 END)' />
            </column>
            <column caption='Total Inefficient SKU Share %' datatype='real' name='[Calculation_3041618642747150337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [sku_efficiency] IN (&apos;zero_mover&apos; , &apos;slow_mover&apos;)&#10;AND [avg_monthly_availability]= 1&#10;AND [warehouse_sku_maturity] = &apos;mature_sku&apos; &#10;THEN ([sku]+[warehouse_id]) ELSE NULL END)&#10;/ COUNTD(IF [warehouse_sku_maturity] = &apos;mature_sku&apos; &#10;THEN ([sku]+[warehouse_id]) ELSE NULL END&#10;)' />
            </column>
            <column caption='Last Complete Month GMV (eur)' datatype='real' name='[Calculation_3428576376515690505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [warehouse_sku_maturity] = &apos;mature_sku&apos; AND&#10;([sku_efficiency] IN (&quot;slow_mover&quot;, &quot;zero_mover&quot;)&#10;AND [avg_monthly_availability] = 1)&#10;OR &#10;[sku_efficiency] = &apos;efficient_sku&apos;&#10;THEN [monthly_gmv] ELSE 0 END&#10;)' />
            </column>
            <column caption='Last Complete Month Stock Value (eur)' datatype='integer' name='[Calculation_3428576376517558283]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [warehouse_sku_maturity] = &apos;mature_sku&apos; AND&#10;([sku_efficiency] IN (&quot;slow_mover&quot;, &quot;zero_mover&quot;)&#10;AND [avg_monthly_availability] = 1)&#10;OR &#10;[sku_efficiency] = &apos;efficient_sku&apos;&#10;THEN [last_day_eur_stock_value] ELSE 0 END&#10;)' />
            </column>
            <column caption='Count SKU' datatype='integer' name='[Calculation_6017512849218912256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(([sku]))' />
            </column>
            <column caption='prep Filter BP profit' datatype='real' name='[Calculation_6060367414477520906]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [global_entity_id], [warehouse_id], [sku]: SUM([Calculation_150026164713431040])*SUM([SKU_age])*AVG([Calculation_2980186753056079875])}' />
            </column>
            <column caption='Recommended Status***' datatype='string' name='[Calculation_6282943693679767552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;([is_lt_zr] &#10;AND [SKU_age] &gt;= 90&#10;AND [warehouse_sku_maturity] &lt;&gt; &apos;probation_sku&apos;)&#10;&#10;OR&#10;&#10;({ FIXED [global_entity_id], [warehouse_id], [sku]: AVG([availability])}&#10; &gt; { FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_availability])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([SKU_age])}&#10;&gt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_days_in_assortment])} &#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: IFNULL(SUM([monthly_gmv]),0)}&#10;&lt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_monthly_gpv])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Customer Risk Score (L3) (copy)_827043916914118676])}&#10;&lt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_importance_customer])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Calculation_827043916911669251])}&#10; &lt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_importance_revenue])} &#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: IFNULL(AVG([avg_monthly_availability]),0)}&#10;&gt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_availability_1m])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Calculation_6060367414477520906])}&#10;&gt;&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_monthly_profit])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([units_velocity_kpi])} &#10;&lt;&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_unit_velocity])}&#10;AND [sku_efficiency] IN (&apos;zero_mover&apos;, &apos;slow_mover&apos;)&#10;AND [SKU_age] &gt;= 90&#10;AND [warehouse_sku_maturity] &lt;&gt; &apos;probation_sku&apos;&#10;AND [region] = &apos;Asia&apos;)&#10;&#10;OR&#10;&#10;({ FIXED [global_entity_id], [warehouse_id], [sku]: AVG([availability])}&#10; &gt; { FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_availability])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([SKU_age])}&#10;&gt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_days_in_assortment])} &#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Customer Risk Score (L3) (copy)_827043916914118676])}&#10;&lt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_importance_customer])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Calculation_827043916911669251])}&#10; &lt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_importance_revenue])} &#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: IFNULL(AVG([avg_monthly_availability]),0)}&#10;&gt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_availability_1m])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: IFNULL(SUM([monthly_gmv]),0)}&#10;&lt; &#10;[gpv_threshold]&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([units_velocity_kpi])} &#10;&lt;&#10;[uv_threshold]&#10;AND [sku_efficiency] IN (&apos;zero_mover&apos;, &apos;slow_mover&apos;)&#10;AND [SKU_age] &gt;= 90&#10;AND [warehouse_sku_maturity] &lt;&gt; &apos;probation_sku&apos;&#10;AND [region] &lt;&gt; &apos;Asia&apos;)&#10;THEN &apos;DISCONTINUED&apos; &#10;ELSE &apos;NO CHANGES&apos; END' />
            </column>
            <column caption='Max Business Risk Score (L1)' datatype='real' name='[Calculation_827043916911169536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [warehouse_id], [category_level_one]: MAX([business_kpi]) }' />
            </column>
            <column caption='Business Risk Score (L1)' datatype='real' name='[Calculation_827043916911669251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([business_kpi]/[Calculation_827043916911169536])*100' />
            </column>
            <column caption='Customer Risk Score (L3-Basket)' datatype='real' name='[Customer Risk Score (L3) (copy)_827043916914118676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//IF NOT ISNULL([Sku Category3 Trips Fraction Basket]/[Max Cat 3 Trip Fraction Basket]) THEN ([Sku Category3 Trips Fraction Basket]/[Max Cat 3 Trip Fraction Basket])*100 ELSE 0 END&#10;IF NOT ISNULL([sku_category3_trips_fraction_basket]/[Max Cat 3 Trip Fraction (copy)_827043916913201163]) THEN ([sku_category3_trips_fraction_basket]/[Max Cat 3 Trip Fraction (copy)_827043916913201163])*100 ELSE 0 END' />
            </column>
