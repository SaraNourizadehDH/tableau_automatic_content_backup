      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/WIPAssortmentRationalizationReportWarehouse/SKUImportanceDistribution?rev=' id='SKUImportanceDistribution' path='/t/GlobalStandardReporting/workbooks/StgAssortmentRationalizerReport-L3_17496316160820' revision='' site='GlobalStandardReporting' />
