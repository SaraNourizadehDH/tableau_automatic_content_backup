    <worksheet name='Metrics - Warehouse Pivot'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' underline='true'>Rationalizer Table</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_optimization_scores_rationalizer_store_v2' name='federated.010rk66132xq971f6gqq80zez27o' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.010rk66132xq971f6gqq80zez27o'>
            <column caption='row' datatype='integer' name='[Calculation_1030057733118898176]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='GPV (6 Months)' datatype='real' name='[Calculation_150026164713431040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN &apos;Euro&apos; THEN [gmv_eur] ELSE [gmv_lc] END' />
            </column>
            <column caption='Front Margin %' datatype='real' name='[Calculation_2980186753056079875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(zn([total_sku_sales_eur_l6Mon]) - zn([cogs_eur]))/zn([total_sku_sales_eur_l6Mon])' />
            </column>
            <column caption='#distinct warehouses' datatype='integer' name='[Calculation_5380746028031094853]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [sku]: &#10;COUNTD(&#10;IF &#10;([management_entity] IN (&apos;Foodpanda APAC&apos;, &apos;DH Europe&apos;)&#10;AND [warehouse_sku_maturity] &lt;&gt; &apos;probation_sku&apos; &#10;AND NOT REGEXP_MATCH([sku_efficiency], &apos;la_zero_mover|la_slow_mover&apos;) &#10;)&#10;OR&#10;(&#10;NOT REGEXP_MATCH([management_entity], &apos;Foodpanda APAC|DH Europe&apos;) &#10;AND [warehouse_sku_maturity] &lt;&gt; &apos;probation_sku&apos;)&#10;THEN [warehouse_id] &#10;ELSE NULL END)}' />
            </column>
            <column caption='#distinct warehouses to be discontinued' datatype='integer' name='[Calculation_5380746028031209542]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [sku]: COUNTD(&#10;IF [Calculation_6282943693679767552] = &apos;DISCONTINUED&apos; THEN [warehouse_id] ELSE NULL END)}' />
            </column>
            <column caption='%Warehouses to be discontinued' datatype='real' name='[Calculation_5380746028031303751]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5380746028031209542]/[Calculation_5380746028031094853]' />
            </column>
            <column caption='prep Filter BP profit' datatype='real' name='[Calculation_6060367414477520906]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [global_entity_id], [warehouse_id], [sku]: SUM([Calculation_150026164713431040])*SUM([SKU_age])*AVG([Calculation_2980186753056079875])}' />
            </column>
            <column caption='Has Active Promotion' datatype='string' name='[Calculation_6171761142282182656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [has_promotion] &gt; 0 then &quot;Yes&quot; &#10;ELSEIF ISNULL([has_promotion]) THEN &quot;No&quot;&#10;ELSE &quot;No&quot; END' />
            </column>
            <column caption='Recommended Status***' datatype='string' name='[Calculation_6282943693679767552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;([is_lt_zr] &#10;AND [SKU_age] &gt;= 90&#10;AND [warehouse_sku_maturity] &lt;&gt; &apos;probation_sku&apos;)&#10;&#10;OR&#10;&#10;({ FIXED [global_entity_id], [warehouse_id], [sku]: AVG([availability])}&#10; &gt; { FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_availability])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([SKU_age])}&#10;&gt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_days_in_assortment])} &#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: IFNULL(SUM([monthly_gmv]),0)}&#10;&lt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_monthly_gpv])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Customer Risk Score (L3) (copy)_827043916914118676])}&#10;&lt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_importance_customer])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Calculation_827043916911669251])}&#10; &lt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_importance_revenue])} &#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: IFNULL(AVG([avg_monthly_availability]),0)}&#10;&gt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_availability_1m])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Calculation_6060367414477520906])}&#10;&gt;&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_monthly_profit])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([units_velocity_kpi])} &#10;&lt;&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_unit_velocity])}&#10;AND [sku_efficiency] IN (&apos;zero_mover&apos;, &apos;slow_mover&apos;)&#10;AND [SKU_age] &gt;= 90&#10;AND [warehouse_sku_maturity] &lt;&gt; &apos;probation_sku&apos;&#10;AND [region] = &apos;Asia&apos;)&#10;&#10;OR&#10;&#10;({ FIXED [global_entity_id], [warehouse_id], [sku]: AVG([availability])}&#10; &gt; { FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_availability])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([SKU_age])}&#10;&gt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_days_in_assortment])} &#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Customer Risk Score (L3) (copy)_827043916914118676])}&#10;&lt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_importance_customer])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Calculation_827043916911669251])}&#10; &lt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_importance_revenue])} &#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: IFNULL(AVG([avg_monthly_availability]),0)}&#10;&gt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_availability_1m])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: IFNULL(SUM([monthly_gmv]),0)}&#10;&lt; &#10;[gpv_threshold]&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([units_velocity_kpi])} &#10;&lt;&#10;[uv_threshold]&#10;AND [sku_efficiency] IN (&apos;zero_mover&apos;, &apos;slow_mover&apos;)&#10;AND [SKU_age] &gt;= 90&#10;AND [warehouse_sku_maturity] &lt;&gt; &apos;probation_sku&apos;&#10;AND [region] &lt;&gt; &apos;Asia&apos;)&#10;THEN &apos;DISCONTINUED&apos; &#10;ELSE &apos;NO CHANGES&apos; END' />
            </column>
            <column caption='Max Business Risk Score (L1)' datatype='real' name='[Calculation_827043916911169536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [warehouse_id], [category_level_one]: MAX([business_kpi]) }' />
            </column>
            <column caption='Business Risk Score (L1)' datatype='real' name='[Calculation_827043916911669251]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([business_kpi]/[Calculation_827043916911169536])*100' />
            </column>
            <column caption='Long Term Zero Mover' datatype='datetime' name='[Calculation_8598497592503623686]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [is_lt_zr] THEN [first_time_lt_zero_mover]ELSE NULL END' />
            </column>
            <column caption='Customer Risk Score (L3-Basket)' datatype='real' name='[Customer Risk Score (L3) (copy)_827043916914118676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//IF NOT ISNULL([Sku Category3 Trips Fraction Basket]/[Max Cat 3 Trip Fraction Basket]) THEN ([Sku Category3 Trips Fraction Basket]/[Max Cat 3 Trip Fraction Basket])*100 ELSE 0 END&#10;IF NOT ISNULL([sku_category3_trips_fraction_basket]/[Max Cat 3 Trip Fraction (copy)_827043916913201163]) THEN ([sku_category3_trips_fraction_basket]/[Max Cat 3 Trip Fraction (copy)_827043916913201163])*100 ELSE 0 END' />
            </column>
            <column caption='Max Cat 3 Trip Fraction Basket' datatype='real' name='[Max Cat 3 Trip Fraction (copy)_827043916913201163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [global_entity_id], [warehouse_id], [category_level_one], [category_level_two], [category_level_three]: MAX([sku_category3_trips_fraction_basket]) }' />
            </column>
