      </column>
      <column caption='Zero Movers Book Value Share %' datatype='real' name='[Calculation_2934658151594737675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [sku_efficiency] = &quot;zero_mover&quot;&#10;AND [avg_monthly_availability] = 1&#10;AND [warehouse_sku_maturity] = &apos;mature_sku&apos;&#10;THEN [last_day_book_value] ELSE 0 END)&#10;/ SUM(IF [warehouse_sku_maturity] = &apos;mature_sku&apos;&#10;THEN [last_day_book_value] ELSE 0 END)' />
