            <column caption='GPV - L2 Category Threshold' datatype='real' name='[gpv_threshold]' role='measure' type='quantitative' />
            <column caption='Is Long Term Zero Mover**' datatype='boolean' name='[is_lt_zr]' role='dimension' type='nominal' />
