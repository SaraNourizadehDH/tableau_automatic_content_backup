    <worksheet name='Inefficiency - Store'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' underline='true'>Efficiency by Store</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='_tableau_optimization_scores_rationalizer_store_v2' name='federated.010rk66132xq971f6gqq80zez27o' />
          </datasources>
          <datasource-dependencies datasource='federated.010rk66132xq971f6gqq80zez27o'>
            <column caption='Total Inefficient Book Value' datatype='real' name='[Calculation_2386626381328953344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(IF [sku_efficiency] IN (&apos;zero_mover&apos; , &apos;slow_mover&apos;)&#10;AND [avg_monthly_availability] = 1&#10;AND [warehouse_sku_maturity] = &apos;mature_sku&apos; &#10;THEN [last_day_book_value] ELSE 0 END)' />
            </column>
            <column caption='Total Inefficient SKU' datatype='integer' name='[Calculation_2386626381329367041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [sku_efficiency] IN (&apos;zero_mover&apos; , &apos;slow_mover&apos;)&#10;AND [avg_monthly_availability]= 1&#10;AND [warehouse_sku_maturity] = &apos;mature_sku&apos; &#10;THEN ([sku]+[warehouse_id]) ELSE NULL END)' />
            </column>
            <column caption='Total Mature SKUs' datatype='integer' name='[Calculation_2934658151588007936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [warehouse_sku_maturity] = &apos;mature_sku&apos; &#10;THEN ([sku]+[warehouse_id]) ELSE NULL END&#10;)' />
            </column>
            <column caption='Total Efficient SKUs' datatype='integer' name='[Calculation_2934658151588261889]' role='measure' type='quantitative'>
