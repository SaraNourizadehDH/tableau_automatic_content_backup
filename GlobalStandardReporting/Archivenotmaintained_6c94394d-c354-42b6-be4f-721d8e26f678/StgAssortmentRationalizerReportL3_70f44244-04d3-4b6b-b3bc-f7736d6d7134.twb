      </connection>
      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.010rk66132xq971f6gqq80zez27o].[cum:sum:monthly_gmv:qk]&quot;' value='Monthly Gmv (Last Complete Month) ' />
          <alias key='&quot;[federated.010rk66132xq971f6gqq80zez27o].[cum:usr:Calculation_6017512849218912256:qk]&quot;' value='Count SKU+Warehouse' />
          <alias key='&quot;[federated.010rk66132xq971f6gqq80zez27o].[max:gpv_threshold:qk]&quot;' value='GPV  L3 Category Threshold' />
          <alias key='&quot;[federated.010rk66132xq971f6gqq80zez27o].[max:uv_threshold:qk]&quot;' value='Unit Velocity L3 Category Threshold ' />
          <alias key='&quot;[federated.010rk66132xq971f6gqq80zez27o].[pcto:sum:last_day_book_value:qk]&quot;' value='% Book Value (Last Day) ' />
          <alias key='&quot;[federated.010rk66132xq971f6gqq80zez27o].[pcto:sum:monthly_gmv:qk]&quot;' value='% Monthly Gmv (Last Complete Month)' />
          <alias key='&quot;[federated.010rk66132xq971f6gqq80zez27o].[pcto:usr:Calculation_6017512849218912256:qk]&quot;' value='%CountD SKU+Warehouse' />
          <alias key='&quot;[federated.010rk66132xq971f6gqq80zez27o].[sum:Calculation_155233515938582529:qk]&quot;' value='Combined Importance' />
          <alias key='&quot;[federated.010rk66132xq971f6gqq80zez27o].[sum:Calculation_827043916911669251:qk]&quot;' value='Importance to Revenue' />
          <alias key='&quot;[federated.010rk66132xq971f6gqq80zez27o].[sum:Customer Risk Score (L3) (copy)_827043916914118676:qk]&quot;' value='Importance to Customers' />
        </aliases>
      </column>
      <column caption='L Indicator' datatype='string' name='[Business Risk Score (copy)_2071233676042940420]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2071233676040642560] &gt;= 1000 THEN &apos;L3&apos;&#10;ELSEIF [Calculation_2071233676040642560] &lt; 1000 AND [Calculation_2071233676040642560] &gt;= 100 THEN &apos;L2&apos;&#10;ELSE &apos;L1&apos; END' />
      </column>
      <column caption='row' datatype='integer' name='[Calculation_1030057733118898176]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='GPV (6 Months)' datatype='real' name='[Calculation_150026164713431040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN &apos;Euro&apos; THEN [gmv_eur] ELSE [gmv_lc] END' />
      </column>
      <column caption='Combined Score (B1+C3B)' datatype='real' name='[Calculation_155233515938582529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(0.5*[Calculation_827043916911669251]) + (0.5*[Customer Risk Score (L3) (copy)_827043916914118676])' />
      </column>
      <column caption='Avg Sales Price' datatype='real' name='[Calculation_155233515939696643]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2] WHEN &apos;Euro&apos; THEN [avg_price_eur] ELSE [avg_price_lc] END' />
      </column>
      <column caption='SKUs by Country, Category 1' datatype='integer' name='[Calculation_2071233676040642560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id],[category_level_one]: COUNTD([sku])}' />
      </column>
      <column caption='New Listed SKUs estimation' datatype='integer' name='[Calculation_2181712598907838464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sku_listed])-[Calculation_4870150469168902146]' />
      </column>
      <column caption='Efficiency Uplift' datatype='real' name='[Calculation_2181712598908313601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4870150469169201156]-MAX([Calculation_4870150469169000451])' />
      </column>
      <column caption='Discontinued Book Value' datatype='real' name='[Calculation_2181712598908768258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_6282943693679767552] = &apos;DISCONTINUED&apos; THEN ([last_day_book_value]) ELSE NULL END' />
      </column>
      <column caption='Discontinued GPV' datatype='real' name='[Calculation_2181712598909112323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_6282943693679767552] = &apos;DISCONTINUED&apos; THEN ([monthly_gmv]) ELSE NULL END' />
      </column>
      <column caption='Country GPV Share (%)' datatype='real' name='[Calculation_2181712598909292548]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id], [warehouse_id], [sku]: SUM([monthly_gmv])}&#10;/&#10;{FIXED [global_entity_id]: SUM([monthly_gmv])}' />
      </column>
      <column caption='Total Inefficient Book Value' datatype='real' name='[Calculation_2386626381328953344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [sku_efficiency] IN (&apos;zero_mover&apos; , &apos;slow_mover&apos;)&#10;AND [avg_monthly_availability] = 1&#10;AND [warehouse_sku_maturity] = &apos;mature_sku&apos; &#10;THEN [last_day_book_value] ELSE 0 END)' />
      </column>
      <column caption='Total Inefficient SKU' datatype='integer' name='[Calculation_2386626381329367041]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [sku_efficiency] IN (&apos;zero_mover&apos; , &apos;slow_mover&apos;)&#10;AND [avg_monthly_availability]= 1&#10;AND [warehouse_sku_maturity] = &apos;mature_sku&apos; &#10;THEN ([sku]+[warehouse_id]) ELSE NULL END)' />
      </column>
      <column caption='Days on Hand' datatype='real' name='[Calculation_2467198605335392256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([book_value])/SUM([cogs_eur])' />
      </column>
      <column caption='% Spoilage' datatype='real' name='[Calculation_2467198605335437313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([shrinkage_eur_expired])/SUM([gmv_eur])' />
