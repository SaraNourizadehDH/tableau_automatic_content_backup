      <column caption='Front Margin Euro' datatype='real' name='[Calculation_2980186753055137792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_sku_sales_eur_l6Mon]) - sum([cogs_eur])' />
      </column>
      <column caption='Front Margin' datatype='real' name='[Calculation_2980186753055703042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE  [Parameters].[Parameter 2] WHEN &apos;Euro&apos; THEN [Calculation_2980186753055137792] ELSE [Front Margin Euro (copy)_2980186753055342593] END' />
      </column>
      <column caption='Front Margin %' datatype='real' name='[Calculation_2980186753056079875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(zn([total_sku_sales_eur_l6Mon]) - zn([cogs_eur]))/zn([total_sku_sales_eur_l6Mon])' />
      </column>
      <column caption='Total Inefficient Book Value Share %' datatype='real' name='[Calculation_3041618642746871808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [sku_efficiency] IN (&apos;zero_mover&apos; , &apos;slow_mover&apos;)&#10;AND [avg_monthly_availability] = 1&#10;AND [warehouse_sku_maturity] = &apos;mature_sku&apos; &#10;THEN [last_day_book_value] ELSE 0 END)&#10;/ SUM(IF [warehouse_sku_maturity] = &apos;mature_sku&apos;&#10;THEN [last_day_book_value] ELSE 0 END)' />
      </column>
      <column caption='Total Inefficient SKU Share %' datatype='real' name='[Calculation_3041618642747150337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [sku_efficiency] IN (&apos;zero_mover&apos; , &apos;slow_mover&apos;)&#10;AND [avg_monthly_availability]= 1&#10;AND [warehouse_sku_maturity] = &apos;mature_sku&apos; &#10;THEN ([sku]+[warehouse_id]) ELSE NULL END)&#10;/ COUNTD(IF [warehouse_sku_maturity] = &apos;mature_sku&apos; &#10;THEN ([sku]+[warehouse_id]) ELSE NULL END&#10;)' />
      </column>
      <column caption='Availability - Inefficient Filter' datatype='real' name='[Calculation_3428576376509087745]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF ([sku_efficiency] =&apos;slow_mover&apos; OR [sku_efficiency] = &apos;zero_mover&apos;)&#10;THEN [avg_monthly_availability]&#10;ELSE 1 END' />
      </column>
      <column caption='Last Complete Month GMV (eur)' datatype='real' name='[Calculation_3428576376515690505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [warehouse_sku_maturity] = &apos;mature_sku&apos; AND&#10;([sku_efficiency] IN (&quot;slow_mover&quot;, &quot;zero_mover&quot;)&#10;AND [avg_monthly_availability] = 1)&#10;OR &#10;[sku_efficiency] = &apos;efficient_sku&apos;&#10;THEN [monthly_gmv] ELSE 0 END&#10;)' />
      </column>
      <column caption='Total Mature and Available SKUs ' datatype='integer' name='[Calculation_3428576376516288522]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [warehouse_sku_maturity] = &apos;mature_sku&apos; AND&#10;([sku_efficiency] IN (&quot;slow_mover&quot;, &quot;zero_mover&quot;)&#10;AND [avg_monthly_availability] = 1)&#10;OR &#10;[sku_efficiency] = &apos;efficient_sku&apos;&#10;THEN ([sku]+[warehouse_id]) ELSE NULL END&#10;)' />
      </column>
      <column caption='Last Complete Month Stock Value (eur)' datatype='integer' name='[Calculation_3428576376517558283]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [warehouse_sku_maturity] = &apos;mature_sku&apos; AND&#10;([sku_efficiency] IN (&quot;slow_mover&quot;, &quot;zero_mover&quot;)&#10;AND [avg_monthly_availability] = 1)&#10;OR &#10;[sku_efficiency] = &apos;efficient_sku&apos;&#10;THEN [last_day_eur_stock_value] ELSE 0 END&#10;)' />
      </column>
      <column caption='Recommended to be Discontinued' datatype='integer' name='[Calculation_3502744983770841088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(IF [Calculation_6282943693679767552] = &apos;DISCONTINUED&apos; THEN 1 ELSE 0 END, 0)' />
      </column>
      <column caption='GPV Share (Discontinue)' datatype='real' name='[Calculation_3620401577256173605]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2181712598909112323])/SUM([monthly_gmv])' />
      </column>
      <column caption='test' datatype='real' name='[Calculation_4051480502312116230]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Calculation_150026164713431040])}' />
      </column>
      <column caption='Monthly Avg GPV (6 Months)' datatype='real' name='[Calculation_4051480502314319881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='({FIXED [global_entity_id], [warehouse_id], [sku]: SUM([gmv_eur])}/&#10;(IF [SKU_age] &lt; 180 THEN [SKU_age] ELSE 180 END))*30' />
      </column>
      <column caption='Efficiency Diff - WH' datatype='real' name='[Calculation_4368069479813562369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_4870150469169201156]-MAX([Calculation_4870150469169000451]))' />
      </column>
      <column caption='Efficiency Diff - L2' datatype='real' name='[Calculation_4368069479814258690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4870150469178728456]-[Calculation_4870150469174730758]' />
      </column>
      <column caption='SKU Discontinued' datatype='string' name='[Calculation_4870150469168775169]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_6282943693679767552] = &apos;DISCONTINUED&apos; THEN ([sku]) ELSE NULL END' />
      </column>
      <column caption='Recommended to discontinue SKUs' datatype='integer' name='[Calculation_4870150469168902146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_4870150469168775169])' />
      </column>
      <column caption='Current Efficiency ' datatype='real' name='[Calculation_4870150469169000451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [warehouse_id], [month]: SUM([efficient_movers]) }&#10;&#10;/&#10;({ FIXED [global_entity_id], [warehouse_id], [month]: SUM([efficient_movers]) } +&#10;{ FIXED [global_entity_id], [warehouse_id], [month]: SUM([slow_movers]) } +&#10;{ FIXED [global_entity_id], [warehouse_id], [month]: SUM([zero_movers]) }&#10;)' />
      </column>
      <column caption='New Efficiency Estimation' datatype='real' name='[Calculation_4870150469169201156]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_6539437828433346611])/(SUM([Calculation_6539437828433764404])-COUNTD([Calculation_4870150469168775169]))' />
      </column>
      <column caption='Current Efficiency - L2' datatype='real' name='[Calculation_4870150469174730758]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [category_level_two], [month]: SUM([efficient_movers (_assortment_performance_category_efficiency)]) }&#10;&#10;/&#10;({FIXED [global_entity_id], [category_level_two], [month]: SUM([efficiency_denom_not_weighted]) }&#10;)' />
      </column>
      <column caption='Efficiency Estimation - L2' datatype='real' name='[Calculation_4870150469178728456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [category_level_two], [month]: SUM([efficient_movers (_assortment_performance_category_efficiency)]) }&#10;&#10;/&#10;({FIXED [global_entity_id], [category_level_two], [month]: SUM([efficiency_denom_not_weighted]) }&#10; - &#10;{ FIXED [global_entity_id], [category_level_two]: ([Calculation_4870150469168902146]) }&#10;)' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_5106026452671475715]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='#distinct warehouses' datatype='integer' name='[Calculation_5380746028031094853]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [sku]: &#10;COUNTD(&#10;IF &#10;([management_entity] IN (&apos;Foodpanda APAC&apos;, &apos;DH Europe&apos;)&#10;AND [warehouse_sku_maturity] &lt;&gt; &apos;probation_sku&apos; &#10;AND NOT REGEXP_MATCH([sku_efficiency], &apos;la_zero_mover|la_slow_mover&apos;) &#10;)&#10;OR&#10;(&#10;NOT REGEXP_MATCH([management_entity], &apos;Foodpanda APAC|DH Europe&apos;) &#10;AND [warehouse_sku_maturity] &lt;&gt; &apos;probation_sku&apos;)&#10;THEN [warehouse_id] &#10;ELSE NULL END)}' />
      </column>
      <column caption='#distinct warehouses to be discontinued' datatype='integer' name='[Calculation_5380746028031209542]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [sku]: COUNTD(&#10;IF [Calculation_6282943693679767552] = &apos;DISCONTINUED&apos; THEN [warehouse_id] ELSE NULL END)}' />
      </column>
      <column caption='%Warehouses to be discontinued' datatype='real' name='[Calculation_5380746028031303751]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5380746028031209542]/[Calculation_5380746028031094853]' />
      </column>
      <column caption='category combined' datatype='string' name='[Calculation_5385601477152006144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[category_level_one] + [category_level_two] + [category_level_three]' />
      </column>
      <column caption='% Book Value (Discontinue)' datatype='real' name='[Calculation_5774388837850296323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [global_entity_id], [warehouse_id]:SUM([Calculation_2181712598908768258])}&#10;/&#10;{FIXED [global_entity_id], [warehouse_id]:SUM([last_day_book_value])}' />
      </column>
      <column caption='LN GMV' datatype='real' name='[Calculation_594052938969104384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LN([Calculation_150026164713431040])' />
      </column>
      <column caption='Count SKU' datatype='integer' name='[Calculation_6017512849218912256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(([sku]))' />
      </column>
      <column caption='Filter BP Availability' datatype='integer' name='[Calculation_6060367414424797184]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF &#10;{ FIXED [global_entity_id], [warehouse_id], [sku]: AVG([availability])}&#10; &gt; { FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_availability])}&#10; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Filter BP Days in Assortment' datatype='integer' name='[Calculation_6060367414425468929]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([SKU_age])}&#10;&gt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_days_in_assortment])} THEN 1 ELSE 0 END' />
      </column>
      <column caption='Filter BP velocity' datatype='integer' name='[Calculation_6060367414425919490]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([units_velocity_kpi])} &#10;&lt;&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_unit_velocity])} THEN 1 ELSE 0 END' />
      </column>
      <column caption='Filter BP importance revenue' datatype='integer' name='[Calculation_6060367414426415107]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Calculation_827043916911669251])}&#10; &lt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_importance_revenue])} THEN 1 ELSE 0 END' />
      </column>
      <column caption='Filter BP importance customer' datatype='integer' name='[Calculation_6060367414426816516]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Customer Risk Score (L3) (copy)_827043916914118676])}&#10;&lt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_importance_customer])} THEN 1 ELSE 0 END' />
      </column>
      <column caption='Filter BP GPV' datatype='integer' name='[Calculation_6060367414476107783]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Calculation_150026164713431040])}&#10;&lt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_monthly_gpv])} THEN 1 ELSE 0 END' />
      </column>
      <column caption='Filter BP monthly availability' datatype='integer' name='[Calculation_6060367414476693513]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([avg_monthly_availability])}&#10;&gt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_availability_1m])} THEN 1 ELSE 0 END' />
      </column>
      <column caption='prep Filter BP profit' datatype='real' name='[Calculation_6060367414477520906]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [global_entity_id], [warehouse_id], [sku]: SUM([Calculation_150026164713431040])*SUM([SKU_age])*AVG([Calculation_2980186753056079875])}' />
      </column>
      <column caption='Filter BP profit' datatype='integer' name='[Calculation_6060367414477877259]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Calculation_6060367414477520906])}&#10;&gt;&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_monthly_profit])} THEN 1 ELSE 0 END' />
      </column>
      <column caption='Has Active Promotion' datatype='string' name='[Calculation_6171761142282182656]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [has_promotion] &gt; 0 then &quot;Yes&quot; &#10;ELSEIF ISNULL([has_promotion]) THEN &quot;No&quot;&#10;ELSE &quot;No&quot; END' />
      </column>
      <column caption='Recommended Status***' datatype='string' name='[Calculation_6282943693679767552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;([is_lt_zr] &#10;AND [SKU_age] &gt;= 90&#10;AND [warehouse_sku_maturity] &lt;&gt; &apos;probation_sku&apos;)&#10;&#10;OR&#10;&#10;({ FIXED [global_entity_id], [warehouse_id], [sku]: AVG([availability])}&#10; &gt; { FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_availability])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([SKU_age])}&#10;&gt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_days_in_assortment])} &#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: IFNULL(SUM([monthly_gmv]),0)}&#10;&lt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_monthly_gpv])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Customer Risk Score (L3) (copy)_827043916914118676])}&#10;&lt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_importance_customer])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Calculation_827043916911669251])}&#10; &lt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_importance_revenue])} &#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: IFNULL(AVG([avg_monthly_availability]),0)}&#10;&gt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_availability_1m])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Calculation_6060367414477520906])}&#10;&gt;&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_monthly_profit])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([units_velocity_kpi])} &#10;&lt;&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_unit_velocity])}&#10;AND [sku_efficiency] IN (&apos;zero_mover&apos;, &apos;slow_mover&apos;)&#10;AND [SKU_age] &gt;= 90&#10;AND [warehouse_sku_maturity] &lt;&gt; &apos;probation_sku&apos;&#10;AND [region] = &apos;Asia&apos;)&#10;&#10;OR&#10;&#10;({ FIXED [global_entity_id], [warehouse_id], [sku]: AVG([availability])}&#10; &gt; { FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_availability])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([SKU_age])}&#10;&gt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_days_in_assortment])} &#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Customer Risk Score (L3) (copy)_827043916914118676])}&#10;&lt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_importance_customer])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Calculation_827043916911669251])}&#10; &lt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_importance_revenue])} &#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: IFNULL(AVG([avg_monthly_availability]),0)}&#10;&gt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_availability_1m])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: IFNULL(SUM([monthly_gmv]),0)}&#10;&lt; &#10;[gpv_threshold]&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([units_velocity_kpi])} &#10;&lt;&#10;[uv_threshold]&#10;AND [sku_efficiency] IN (&apos;zero_mover&apos;, &apos;slow_mover&apos;)&#10;AND [SKU_age] &gt;= 90&#10;AND [warehouse_sku_maturity] &lt;&gt; &apos;probation_sku&apos;&#10;AND [region] &lt;&gt; &apos;Asia&apos;)&#10;THEN &apos;DISCONTINUED&apos; &#10;ELSE &apos;NO CHANGES&apos; END' />
      </column>
      <column caption='Num - New Efficiency' datatype='integer' name='[Calculation_6539437828433346611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [warehouse_id], [month]: SUM([efficient_movers]) }' />
      </column>
      <column caption='Den 1 - New Efficiency' datatype='integer' name='[Calculation_6539437828433764404]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [warehouse_id], [month]: SUM([efficient_movers]) } +&#10;{ FIXED [global_entity_id], [warehouse_id], [month]: SUM([slow_movers]) } +&#10;{ FIXED [global_entity_id], [warehouse_id], [month]: SUM([zero_movers]) }' />
      </column>
      <column caption='Efficiency' datatype='string' name='[Calculation_690317448315715632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_lt_zr] THEN &quot;lt_zero_mover&quot;&#10;ELSE [sku_efficiency] END' />
      </column>
      <column caption='Max Business Risk Score (L1)' datatype='real' name='[Calculation_827043916911169536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [warehouse_id], [category_level_one]: MAX([business_kpi]) }' />
      </column>
      <column caption='Business Risk Score (L1)' datatype='real' name='[Calculation_827043916911669251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([business_kpi]/[Calculation_827043916911169536])*100' />
      </column>
      <column caption='Long Term Zero Mover' datatype='datetime' name='[Calculation_8598497592503623686]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [is_lt_zr] THEN [first_time_lt_zero_mover]ELSE NULL END' />
      </column>
      <column caption='On Hand Quantity' datatype='real' name='[Calculation_870320694093910016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[on_hand_qty]/[total_days]' />
      </column>
      <column caption='Customer Risk Score (L3-Basket)' datatype='real' name='[Customer Risk Score (L3) (copy)_827043916914118676]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//IF NOT ISNULL([Sku Category3 Trips Fraction Basket]/[Max Cat 3 Trip Fraction Basket]) THEN ([Sku Category3 Trips Fraction Basket]/[Max Cat 3 Trip Fraction Basket])*100 ELSE 0 END&#10;IF NOT ISNULL([sku_category3_trips_fraction_basket]/[Max Cat 3 Trip Fraction (copy)_827043916913201163]) THEN ([sku_category3_trips_fraction_basket]/[Max Cat 3 Trip Fraction (copy)_827043916913201163])*100 ELSE 0 END' />
      </column>
      <column caption='Filter BP GPV V2' datatype='integer' name='[Filter BP GPV (copy)_4263149643302989847]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Calculation_150026164713431040])}&#10;&lt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku], [category_level_two]: AVG([gpv_threshold])} THEN 1 ELSE 0 END' />
      </column>
      <column caption='Filter BP velocity V2' datatype='integer' name='[Filter BP velocity (copy)_4263149643302703126]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([units_velocity_kpi])} &#10;&lt;&#10;{FIXED [global_entity_id], [warehouse_id], [sku], [category_level_two]: AVG([uv_threshold])} THEN 1 ELSE 0 END' />
      </column>
      <column caption='Front Margin LC' datatype='real' name='[Front Margin Euro (copy)_2980186753055342593]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_sku_sales_lc_l6Mon]) - sum([cogs_lc])' />
      </column>
      <column caption='Max Cat 3 Trip Fraction Basket' datatype='real' name='[Max Cat 3 Trip Fraction (copy)_827043916913201163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [global_entity_id], [warehouse_id], [category_level_one], [category_level_two], [category_level_three]: MAX([sku_category3_trips_fraction_basket]) }' />
      </column>
      <column caption='NEW Recommended Status***' datatype='string' name='[Recommended Status*** (copy)_4263149643301191701]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;([is_lt_zr] &#10;AND [SKU_age] &gt;= 90&#10;AND [warehouse_sku_maturity] &lt;&gt; &apos;probation_sku&apos;)&#10;OR&#10;({ FIXED [global_entity_id], [warehouse_id], [sku]: AVG([availability])}&#10; &gt; { FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_availability])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([SKU_age])}&#10;&gt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_days_in_assortment])} &#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Customer Risk Score (L3) (copy)_827043916914118676])}&#10;&lt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_importance_customer])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Calculation_827043916911669251])}&#10; &lt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_importance_revenue])} &#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([avg_monthly_availability])}&#10;&gt; &#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([bp_availability_1m])}&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([Calculation_150026164713431040])}&#10;&lt; &#10;[gpv_threshold]&#10;AND&#10;{FIXED [global_entity_id], [warehouse_id], [sku]: AVG([units_velocity_kpi])} &#10;&lt;&#10;[uv_threshold]&#10;AND [sku_efficiency] IN (&apos;zero_mover&apos;, &apos;slow_mover&apos;)&#10;AND [SKU_age] &gt;= 90&#10;AND [warehouse_sku_maturity] &lt;&gt; &apos;probation_sku&apos;)&#10;THEN &apos;DISCONTINUED&apos; ELSE &apos;NO CHANGES&apos; END' />
