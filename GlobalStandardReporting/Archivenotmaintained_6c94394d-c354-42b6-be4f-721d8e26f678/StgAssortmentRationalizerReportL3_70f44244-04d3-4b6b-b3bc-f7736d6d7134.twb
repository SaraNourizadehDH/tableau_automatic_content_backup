    <dashboard name='Definitions'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/GlobalStandardReporting/workbooks/WIPAssortmentRationalizationReportWarehouse/KPIDefinitions?rev=' id='Definitions' path='/t/GlobalStandardReporting/workbooks/StgAssortmentRationalizerReport-L3_17496316160820' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='86250' id='3' param='vert' type-v2='layout-flow' w='98400' x='800' y='12750'>
            <zone fixed-size='290' forceUpdate='true' h='37250' id='11' is-fixed='true' type-v2='text' w='98400' x='800' y='12750'>
              <formatted-text>
                <run fontcolor='#000000' fontsize='10'>For rationalizer ways of working and methodology please refer to the following deck:</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='14'>Metrics Definition </run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='10'>The main metrics used in the methodology are the importances, that can be shortly described as:</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='10'>Importance to Business</run>
                <run fontcolor='#000000' fontsize='10'>: 0.5 * Unit Velocity + 0.5 * Sales Velocity</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='10'>Where </run>
                <run bold='true' fontcolor='#000000' fontsize='10'>Unit Velocity</run>
                <run fontcolor='#000000' fontsize='10'> is units sold per store per week for a specific product</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='10'> and </run>
                <run bold='true' fontcolor='#000000' fontsize='10'>Sales Velocity</run>
                <run fontcolor='#000000' fontsize='10'> is sales amount per store per week for a specific product</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='10'>Importance to Customers</run>
                <run fontcolor='#000000' fontsize='10'>: Sum of (Customer total basket count for each item / Customer basket count for the Level 3 Category) * Customer total baskets</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='10'>The sum value of each product is then divided with the max value in the product&apos;s Level 3 Category</run>
                <run>Æ&#10;</run>
                <run>Æ&#10;</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone forceUpdate='true' h='11750' id='5' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Tableau Semibold' fontsize='14'>Assortment Rationalizer</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone h='11875' id='518' name='Importances' w='66500' x='900' y='25250'>
          <layout-cache minheight='0' type-h='scalable' type-w='fixed' />
        </zone>
        <zone h='6875' id='519' name='Playbook' w='33300' x='1000' y='17250'>
          <layout-cache minheight='0' type-h='scalable' type-w='fixed' />
        </zone>
      </zones>
