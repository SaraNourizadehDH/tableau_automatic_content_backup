            </column>
            <column caption='Last Complete Month GMV (eur)' datatype='real' name='[Calculation_3428576376515690505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF [warehouse_sku_maturity] = &apos;mature_sku&apos; AND&#10;([sku_efficiency] IN (&quot;slow_mover&quot;, &quot;zero_mover&quot;)&#10;AND [avg_monthly_availability] = 1)&#10;OR &#10;[sku_efficiency] = &apos;efficient_sku&apos;&#10;THEN [monthly_gmv] ELSE 0 END&#10;)' />
