            <column datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='total FM eur' datatype='real' name='[total_FM_eur]' role='measure' type='quantitative' />
            <column caption='total FM local' datatype='real' name='[total_FM_local]' role='measure' type='quantitative' />
            <column caption='Totatl MOV (€)' datatype='real' name='[total_MOV_eur]' role='measure' type='quantitative' />
            <column caption='Total MOV (local)' datatype='real' name='[total_MOV_local]' role='measure' type='quantitative' />
            <column caption='Total Delivery Fee (€)' datatype='real' name='[total_delivery_fee_eur]' role='measure' type='quantitative' />
