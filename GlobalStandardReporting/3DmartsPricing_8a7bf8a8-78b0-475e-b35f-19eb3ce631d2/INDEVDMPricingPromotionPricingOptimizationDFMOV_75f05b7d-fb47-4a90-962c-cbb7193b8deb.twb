              <calculation class='tableau' formula='[Calculation_3922564954722885649] / [Calculation_3922564954718486537]' />
            </column>
            <column caption='# of CM1(proxy) Negative Orders' datatype='integer' name='[Calculation_3922564954722885649]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_3922564954721566734] &lt; 0 THEN ([global_entity_id] + [order_id]) END)' />
            </column>
