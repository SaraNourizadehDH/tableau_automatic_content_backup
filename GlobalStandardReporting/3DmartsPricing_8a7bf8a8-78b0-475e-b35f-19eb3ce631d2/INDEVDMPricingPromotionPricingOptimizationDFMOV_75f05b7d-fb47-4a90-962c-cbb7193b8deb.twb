            <column caption='Realized Fees' datatype='real' name='[Calculation_3922564954716975112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_3922564954716758023]) + SUM([Calculation_3922564954716094469]) + SUM([Service Fee (copy)_6269292184075546626])) / [Calculation_3922564954718486537]' />
