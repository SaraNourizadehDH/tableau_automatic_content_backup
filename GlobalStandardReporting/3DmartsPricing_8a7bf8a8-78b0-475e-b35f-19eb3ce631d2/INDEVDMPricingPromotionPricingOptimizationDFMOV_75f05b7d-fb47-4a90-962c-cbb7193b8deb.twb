            <column caption='Travel Time Tiers' datatype='string' name='[Basket Value Tiers (copy)_3924816753043324928]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [travel_time_in_minutes] &lt; [Parameters].[Basket Value Tier 1 (copy)_3924816753044770817] THEN &apos; &lt; &apos; + STR([Parameters].[Basket Value Tier 1 (copy)_3924816753044770817])&#10;ELSEIF [travel_time_in_minutes] &lt; [Parameters].[Basket Value Tier 2 (copy)_3924816753044770818] THEN STR([Parameters].[Basket Value Tier 1 (copy)_3924816753044770817]) + &apos; - &apos; + STR([Parameters].[Basket Value Tier 2 (copy)_3924816753044770818])&#10;ELSEIF [travel_time_in_minutes] &lt; [Parameters].[Basket Value Tier 3 (copy)_3924816753044770819] THEN STR([Parameters].[Basket Value Tier 2 (copy)_3924816753044770818]) +  &apos; - &apos; + STR([Parameters].[Basket Value Tier 3 (copy)_3924816753044770819])&#10;ELSEIF [travel_time_in_minutes] &lt; [Parameters].[Basket Value Tier 4 (copy)_3924816753044770825] THEN STR([Parameters].[Basket Value Tier 3 (copy)_3924816753044770819]) +  &apos; - &apos; + STR([Parameters].[Basket Value Tier 4 (copy)_3924816753044770825])&#10;ELSEIF [travel_time_in_minutes] &lt; [Parameters].[Basket Value Tier 5 (copy)_3924816753044770824] THEN STR([Parameters].[Basket Value Tier 4 (copy)_3924816753044770825]) +  &apos; - &apos; + STR([Parameters].[Basket Value Tier 5 (copy)_3924816753044770824])&#10;ELSEIF [travel_time_in_minutes] &lt; [Parameters].[Basket Value Tier 6 (copy)_3924816753044770823] THEN STR([Parameters].[Basket Value Tier 5 (copy)_3924816753044770824]) +  &apos; - &apos; + STR([Parameters].[Basket Value Tier 6 (copy)_3924816753044770823])&#10;ELSEIF [travel_time_in_minutes] &lt; [Parameters].[Basket Value Tier 7 (copy)_3924816753044770822] THEN STR([Parameters].[Basket Value Tier 6 (copy)_3924816753044770823]) +  &apos; - &apos; + STR([Parameters].[Basket Value Tier 7 (copy)_3924816753044770822])&#10;ELSEIF [travel_time_in_minutes] &lt; [Parameters].[Basket Value Tier 8 (copy)_3924816753044770820] THEN STR([Parameters].[Basket Value Tier 7 (copy)_3924816753044770822]) +  &apos; - &apos; + STR([Parameters].[Basket Value Tier 8 (copy)_3924816753044770820])&#10;ELSEIF [travel_time_in_minutes] &lt; [Parameters].[Basket Value Tier 9 (copy)_3924816753044770821] THEN STR([Parameters].[Basket Value Tier 8 (copy)_3924816753044770820]) +  &apos; - &apos; + STR([Parameters].[Basket Value Tier 9 (copy)_3924816753044770821])&#10;ELSE STR(MAX( MAX( MAX( MAX( MAX( MAX( MAX( MAX([Parameters].[Basket Value Tier 1 (copy)_3924816753044770817],[Parameters].[Basket Value Tier 2 (copy)_3924816753044770818]) ,[Parameters].[Basket Value Tier 3 (copy)_3924816753044770819]), [Parameters].[Basket Value Tier 4 (copy)_3924816753044770825]), [Parameters].[Basket Value Tier 5 (copy)_3924816753044770824]), [Parameters].[Basket Value Tier 6 (copy)_3924816753044770823]), [Parameters].[Basket Value Tier 7 (copy)_3924816753044770822]), [Parameters].[Basket Value Tier 8 (copy)_3924816753044770820]), [Parameters].[Basket Value Tier 9 (copy)_3924816753044770821])) + &apos; +&apos;&#10;END' />
            </column>
            <column caption='Metric' datatype='real' name='[Calculation_1782581075873734656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Tier 6 (copy)]&#10;    WHEN &apos;Avg CM1 (proxy)&apos; THEN [Calculation_3922564954721710095]&#10;    WHEN &apos;Avg Delivery Cost&apos; THEN [Calculation_3922564954719973389]&#10;    WHEN &apos;Avg Delivery Fee&apos; THEN [Calculation_3922564954719408138]&#10;    WHEN &apos;Avg Service Fee&apos; THEN [Calculation_3922564954719514635]&#10;    WHEN &apos;Avg MOV Fee&apos; THEN [Avg Service Fee (copy)_6269292184075653123]&#10;    WHEN &apos;Realized Fees&apos; THEN [Calculation_3922564954716975112]&#10;    WHEN &apos;% of CM1 (proxy) Negative Orders&apos; THEN [Calculation_3922564954722615312]&#10;    WHEN &apos;% of Low CM1 (proxy) Orders&apos; THEN [% of CM1 Negative Orders (copy)_3922564954723942419]&#10;    WHEN &apos;% of Subs. Orders&apos; THEN [% of CM1 (proxy) Negative Orders (copy)_3181793164104642560]&#10;    WHEN &apos;% of Free Delivery Orders due to Subs.&apos; THEN [% Subscription Orders (copy)_3181793164105756675]&#10;    WHEN &apos;% of Free Delivery Orders due to New Customer&apos; THEN [% of Free Delivery Orders due to Subs. (copy)_3181793164119494665]&#10;END' />
            </column>
            <column caption='GBV' datatype='real' name='[Calculation_3922564954714505220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Euro&apos; THEN [GBV_eur]&#10;WHEN &apos;Local&apos; THEN [GBV_local]&#10;END' />
            </column>
            <column caption='Delivery Fee' datatype='real' name='[Calculation_3922564954716094469]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;Euro&apos; THEN [delivery_fee_eur]&#10;    WHEN &apos;Local&apos; THEN [delivery_fee_local]&#10;END' />
            </column>
            <column caption='Delivery Costs' datatype='real' name='[Calculation_3922564954716377094]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;    WHEN &apos;Euro&apos; THEN [delivery_costs_eur]&#10;    WHEN &apos;Local&apos; THEN [delivery_costs_local]&#10;END' />
            </column>
