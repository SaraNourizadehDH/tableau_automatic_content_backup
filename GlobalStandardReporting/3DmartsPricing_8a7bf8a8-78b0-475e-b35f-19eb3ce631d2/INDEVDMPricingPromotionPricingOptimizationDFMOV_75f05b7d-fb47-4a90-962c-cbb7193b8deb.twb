    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Metric Definitions'>
      <repository-location derived-from='http://ip-172-31-0-94:8935/t/GlobalStandardReporting/workbooks/INDEVDM-PricingPromotion-PricingOptimizationDFMOV/MetricDefinitions?rev=' id='MetricDefinitions' path='/t/GlobalStandardReporting/workbooks/INDEVDM-PricingPromotion-PricingOptimizationDFMOV' revision='' site='GlobalStandardReporting' />
      <style />
      <size maxheight='1200' maxwidth='1400' minheight='1200' minwidth='1400' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='78405' id='3' type-v2='text' w='98858' x='571' y='20928'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Orders</run>
              <run fontcolor='#000000' fontsize='16'> = Sent(confirmed) Orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>% of Free Delivery Orders</run>
              <run fontcolor='#000000' fontsize='16'> = % of orders in which no Delivery Fee was charged</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>% of BBDF Free Orders</run>
              <run fontcolor='#000000' fontsize='16'> = % of orders in which no Delivery Fee was charged </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>only</run>
              <run fontcolor='#000000' fontsize='16'> due to Free Delivery Basket Amount is reached</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>% of Free Delivery Orders due to New Customer</run>
              <run fontcolor='#000000' fontsize='16'> = % of orders in which no Delivery Fee was charged </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>only</run>
              <run fontcolor='#000000' fontsize='16'> due to New Customer status</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>% of Free Delivery Orders due to Subs.</run>
              <run fontcolor='#000000' fontsize='16'> = % of orders in which no Delivery Fee was charged </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>only</run>
              <run fontcolor='#000000' fontsize='16'> due to Subscription Member Status </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>% of Free Delivery Orders Others</run>
              <run fontcolor='#000000' fontsize='16'> = % of orders in which no Delivery Fee was charged</run>
              <run fontcolor='#000000' fontsize='16' underline='true'> by any other reason but the cases above (BBDF, New Customer, Subscription)</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>% of Subs. Orders </run>
              <run fontcolor='#000000' fontsize='16'> = % of orders with any type of Subscription</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>ABV</run>
              <run fontcolor='#000000' fontsize='16'> = Average Basket Value </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Avg MOV</run>
              <run fontcolor='#000000' fontsize='16'> = Total Sum of MOV / Orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Avg MOV / Avg Price per item</run>
              <run fontcolor='#000000' fontsize='16'> = How many avg price items does the Avg MOV represents </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Warehouse Framework Compliance %</run>
              <run fontcolor='#000000' fontsize='16'> = % of Warehouses that are &quot;OK&quot; accourding to Framework MOV*</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='16'>Æ      </run>
              <run fontcolor='#000000' fontsize='14' italic='true'>Warehouse Framework MOV : IF Avg Daily Orders &gt; 400 &amp; Avg Listed SKUs &gt; 2500 Then 3 Else 2</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='14' italic='true'> Warehouse Complaince: IF Avg MOV / Avg Price per Item &gt;= Warehouse Framework MOV Then &quot;OK&quot; Else &quot;NotOkey&quot;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Avg Delivery Fee</run>
              <run fontcolor='#000000' fontsize='16'>  (VAT included) = Total DF Revenue /Orders </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Avg Service Fee</run>
              <run fontcolor='#000000' fontsize='16'> (VAT included) = Total SF Revenue / Orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Realized Fees</run>
              <run fontcolor='#000000' fontsize='16'> (VAT excluded) = (Delivery Fee + Sevice Fee + MOV Fee) / Orders</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Nominal Fees</run>
              <run fontcolor='#000000' fontsize='16'> (VAT included) =Nominal DF + Avg Service Fee </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='16'>Æ     </run>
              <run fontcolor='#000000' fontsize='14' italic='true'>Service Fee is always nominal as customers can’t elude it whenever it’s configured on the setup.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Realized Fees / ABV</run>
              <run fontcolor='#000000' fontsize='16'>   (VAT excluded) = (Avg Delivery Fee + Avg Service Fee) / ABV</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Nominal Fees / ABV</run>
              <run fontcolor='#000000' fontsize='16'> (VAT included) = (Nominal DF + Avg Service Fee ) / ABV</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Realized Fees vs Food</run>
              <run fontcolor='#000000' fontsize='16'> = Dmarts Realized Fees / Food Realized Fees</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='16'>Æ     </run>
              <run fontcolor='#000000' fontsize='14' italic='true'>The Benchmarks of Food(Restaurants) &amp; Local Shops Data is taken into account only where Dmarts operate(city) at the given date.</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Daily Orders</run>
              <run fontcolor='#000000' fontsize='16'> = Avg Daily Orders </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Nominal DF</run>
              <run fontcolor='#000000' fontsize='16'> = Total DF Revenue / (Orders - Free Orders). </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='14'> Nominal DF represents the DF are entitled to pay as for Delivery Fee without considering any free order.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Front Margin + Back Margin </run>
              <run fontcolor='#000000' fontsize='16'>= GBV Net + Total Supplier Funding - Cost of Goods Sold</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Profit(CM1 proxy )</run>
              <run fontcolor='#000000' fontsize='16'>(VAT excluded) = Avg. Front Margin + Avg Delivery Fee + Avg Service Fee + Avg MOV Fee - Delivery CPO</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Delivery Cost Per Order</run>
              <run fontcolor='#000000' fontsize='16'> = Delivery related costs</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>% of CM1 (proxy) Negative Orders </run>
              <run fontcolor='#000000' fontsize='16'><![CDATA[(VAT excluded)= Total # of Orders w. negative CM1(<0) / Total # of Orders]]></run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'> Low CM1 (proxy) Orders </run>
              <run fontcolor='#000000' fontsize='16'><![CDATA[(VAT excluded)= Orders w. (CM1 (proxy) / Basket Value ) < 5% ]]></run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
              <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>% of Low CM1 (proxy) Orders </run>
              <run fontcolor='#000000' fontsize='16'>(VAT excluded)= Total # of Orders w. Low CM1 / Total # of Orders</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
              <run>Æ&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='20261' id='6' type-v2='text' w='98858' x='571' y='667'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='20'>Delivery Fee Dashboard - Metric Definitions</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#c60018' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='274' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='98666' id='273' param='vert' type-v2='layout-flow' w='98858' x='571' y='667'>
                <zone forceUpdate='true' h='20261' id='6' type-v2='text' w='98858' x='571' y='667'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='20'>Delivery Fee Dashboard - Metric Definitions</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                    <format attr='background-color' value='#c60018' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='78405' id='3' type-v2='text' w='98858' x='571' y='20928'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Orders</run>
                    <run fontcolor='#000000' fontsize='16'> = Sent(confirmed) Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>% of Free Delivery Orders</run>
                    <run fontcolor='#000000' fontsize='16'> = % of orders in which no Delivery Fee was charged</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>% of BBDF Free Orders</run>
                    <run fontcolor='#000000' fontsize='16'> = % of orders in which no Delivery Fee was charged </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>only</run>
                    <run fontcolor='#000000' fontsize='16'> due to Free Delivery Basket Amount is reached</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>% of Free Delivery Orders due to New Customer</run>
                    <run fontcolor='#000000' fontsize='16'> = % of orders in which no Delivery Fee was charged </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>only</run>
                    <run fontcolor='#000000' fontsize='16'> due to New Customer status</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>% of Free Delivery Orders due to Subs.</run>
                    <run fontcolor='#000000' fontsize='16'> = % of orders in which no Delivery Fee was charged </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>only</run>
                    <run fontcolor='#000000' fontsize='16'> due to Subscription Member Status </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>% of Free Delivery Orders Others</run>
                    <run fontcolor='#000000' fontsize='16'> = % of orders in which no Delivery Fee was charged</run>
                    <run fontcolor='#000000' fontsize='16' underline='true'> by any other reason but the cases above (BBDF, New Customer, Subscription)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>% of Subs. Orders </run>
                    <run fontcolor='#000000' fontsize='16'> = % of orders with any type of Subscription</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>ABV</run>
                    <run fontcolor='#000000' fontsize='16'> = Average Basket Value </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Avg MOV</run>
                    <run fontcolor='#000000' fontsize='16'> = Total Sum of MOV / Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Avg MOV / Avg Price per item</run>
                    <run fontcolor='#000000' fontsize='16'> = How many avg price items does the Avg MOV represents </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Warehouse Framework Compliance %</run>
                    <run fontcolor='#000000' fontsize='16'> = % of Warehouses that are &quot;OK&quot; accourding to Framework MOV*</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='16'>Æ      </run>
                    <run fontcolor='#000000' fontsize='14' italic='true'>Warehouse Framework MOV : IF Avg Daily Orders &gt; 400 &amp; Avg Listed SKUs &gt; 2500 Then 3 Else 2</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='14' italic='true'> Warehouse Complaince: IF Avg MOV / Avg Price per Item &gt;= Warehouse Framework MOV Then &quot;OK&quot; Else &quot;NotOkey&quot;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Avg Delivery Fee</run>
                    <run fontcolor='#000000' fontsize='16'>  (VAT included) = Total DF Revenue /Orders </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Avg Service Fee</run>
                    <run fontcolor='#000000' fontsize='16'> (VAT included) = Total SF Revenue / Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Realized Fees</run>
                    <run fontcolor='#000000' fontsize='16'> (VAT excluded) = (Delivery Fee + Sevice Fee + MOV Fee) / Orders</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Nominal Fees</run>
                    <run fontcolor='#000000' fontsize='16'> (VAT included) =Nominal DF + Avg Service Fee </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='16'>Æ     </run>
                    <run fontcolor='#000000' fontsize='14' italic='true'>Service Fee is always nominal as customers can’t elude it whenever it’s configured on the setup.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Realized Fees / ABV</run>
                    <run fontcolor='#000000' fontsize='16'>   (VAT excluded) = (Avg Delivery Fee + Avg Service Fee) / ABV</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Nominal Fees / ABV</run>
                    <run fontcolor='#000000' fontsize='16'> (VAT included) = (Nominal DF + Avg Service Fee ) / ABV</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Realized Fees vs Food</run>
                    <run fontcolor='#000000' fontsize='16'> = Dmarts Realized Fees / Food Realized Fees</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='16'>Æ     </run>
                    <run fontcolor='#000000' fontsize='14' italic='true'>The Benchmarks of Food(Restaurants) &amp; Local Shops Data is taken into account only where Dmarts operate(city) at the given date.</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Daily Orders</run>
                    <run fontcolor='#000000' fontsize='16'> = Avg Daily Orders </run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Nominal DF</run>
                    <run fontcolor='#000000' fontsize='16'> = Total DF Revenue / (Orders - Free Orders). </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='14'> Nominal DF represents the DF are entitled to pay as for Delivery Fee without considering any free order.</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Front Margin + Back Margin </run>
                    <run fontcolor='#000000' fontsize='16'>= GBV Net + Total Supplier Funding - Cost of Goods Sold</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Profit(CM1 proxy )</run>
                    <run fontcolor='#000000' fontsize='16'>(VAT excluded) = Avg. Front Margin + Avg Delivery Fee + Avg Service Fee + Avg MOV Fee - Delivery CPO</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>Delivery Cost Per Order</run>
                    <run fontcolor='#000000' fontsize='16'> = Delivery related costs</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>% of CM1 (proxy) Negative Orders </run>
                    <run fontcolor='#000000' fontsize='16'><![CDATA[(VAT excluded)= Total # of Orders w. negative CM1(<0) / Total # of Orders]]></run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'> Low CM1 (proxy) Orders </run>
                    <run fontcolor='#000000' fontsize='16'><![CDATA[(VAT excluded)= Orders w. (CM1 (proxy) / Basket Value ) < 5% ]]></run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontsize='16'>- </run>
                    <run bold='true' fontcolor='#000000' fontsize='16' underline='true'>% of Low CM1 (proxy) Orders </run>
                    <run fontcolor='#000000' fontsize='16'>(VAT excluded)= Total # of Orders w. Low CM1 / Total # of Orders</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{D85D3279-F055-456A-A0F7-7413C7C0517C}' />
    </dashboard>
