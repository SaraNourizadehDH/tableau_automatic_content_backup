    <worksheet name='Two Dim Exploraion'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='16'>Delivery Fee Dashboard</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='http://ip-172-31-0-94:8935/t/GlobalStandardReporting/workbooks/INDEVDM-PricingPromotion-PricingOptimizationDFMOV/TwoDimExploraion?rev=' id='TwoDimExploraion' path='/t/GlobalStandardReporting/workbooks/INDEVDM-PricingPromotion-PricingOptimizationDFMOV' revision='' site='GlobalStandardReporting' />
      <table>
        <view>
          <datasources>
            <datasource caption='delivery_fee_report' name='federated.10zjs3d0l09jrc1h3kfcw1lpq1um' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension 2' datatype='string' name='[Dimension 1 (copy)_5149725486602563587]' param-domain-type='list' role='measure' type='nominal' value='&quot;Country Name&quot;'>
              <calculation class='tableau' formula='&quot;Country Name&quot;' />
            </column>
            <column caption='Dimension 1' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Euro&quot;'>
              <calculation class='tableau' formula='&quot;Euro&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.10zjs3d0l09jrc1h3kfcw1lpq1um'>
            <column caption='% of BBDF Free Orders' datatype='real' name='[% of Free Delivery Orders (copy)_406449893525852161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_free_delivery_orders_due_to_bbdf]) / SUM([num_of_realized_orders])' />
            </column>
            <column caption='% of Subs. Orders' datatype='real' name='[% of Free Delivery Orders due to Subs. (copy)_3181793164114780166]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_subscription_orders]) / SUM([num_of_realized_orders])' />
            </column>
            <column caption='% of Free Delivery Orders due to New Customer' datatype='real' name='[% of Subs. Orders (copy)_3181793164122337290]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_free_delivery_orders_due_to_newCustomer]) / SUM([num_of_realized_orders])' />
            </column>
            <column caption='Avg. Front Margin' datatype='real' name='[ABV (copy)_6015964740810686465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GBV (copy)_6015964740810403840]) / SUM([num_of_realized_orders])' />
            </column>
            <column caption='Avg Service Fee' datatype='real' name='[Avg Delivery Fee (copy)_5804225181154492419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GBV (copy)_5804225181154336770]) / SUM([num_of_realized_orders])' />
            </column>
            <column caption='Realized Fees' datatype='real' name='[Avg Delivery Fee (copy)_5804225181154865156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([realized_fees_eur_wo_taxes])) / SUM([num_of_realized_orders])' />
            </column>
            <column caption='Avg Delivery Fee' datatype='real' name='[Avg Delivery Fee (€) (copy)_5149725486627549197]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GMV (copy)_5149725486626390026]) / SUM([num_of_realized_orders])' />
            </column>
            <column caption='Delivery Cost per Order' datatype='real' name='[Avg Service Fee (copy)_5804225181160632328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GMV (copy)_5804225181160370183]) / SUM([num_of_realized_orders])' />
            </column>
            <column caption='Avg MOV Fee' datatype='real' name='[Avg Service Fee (copy)_6269292184073601024]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Total Service Fee (copy)_6269292184073740289]) / SUM([num_of_realized_orders])' />
            </column>
            <column caption='Nominal Fees' datatype='real' name='[Calculation_1931833150795575296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5804225181095231488] + [Avg Delivery Fee (copy)_5804225181154492419]' />
            </column>
            <column caption='Dmarts vs Food Index' datatype='real' name='[Calculation_2273614155834785797]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg Delivery Fee (copy)_5804225181154865156] / [Realized Fees (DF+SF) (copy)_2273614155804741632]' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_244531392623730692]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[region]' />
            </column>
            <column caption='% of Free Delivery Orders due to Subs.' datatype='real' name='[Calculation_3181793164114661381]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_free_delivery_orders_due_to_subscription]) / SUM([num_of_realized_orders])' />
            </column>
            <column caption='Dimension 1  ' datatype='string' name='[Calculation_5149725486600437760]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;Region&apos; THEN [Calculation_244531392623730692]&#10;WHEN &apos;Global Entity Id&apos; THEN [global_entity_id]&#10;WHEN &apos;Country Name&apos; THEN [country_name]&#10;WHEN &apos;City&apos; THEN [city]&#10;WHEN &apos;Warehouse Id&apos; THEN [warehouse_id]&#10;WHEN &apos;Warehouse Name&apos; THEN [warehouse_name]&#10;END' />
            </column>
            <column caption='ABV' datatype='real' name='[Calculation_5149725486611517446]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_5149725486625869832]) / SUM([num_of_realized_orders])' />
            </column>
            <column caption='GBV' datatype='real' name='[Calculation_5149725486625869832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Euro&apos; THEN [GBV_eur]&#10;WHEN &apos;Local&apos; THEN [GBV_local]&#10;END' />
            </column>
            <column caption='% of Free Delivery Orders' datatype='real' name='[Calculation_5149725486627090444]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_free_delivery_orders]) / SUM([num_of_realized_orders])' />
            </column>
            <column caption='Avg. Price per Item' datatype='real' name='[Calculation_5149725486628769806]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_5149725486625869832]) / SUM([num_of_items_sold])' />
            </column>
            <column caption='CM1 2' datatype='real' name='[Calculation_5154792018526670874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total_cm1_eur_wo_taxes])/sum([num_of_realized_orders])' />
            </column>
            <column caption='Avg MOV' datatype='real' name='[Calculation_535858037808017408]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Total Delivery Fee (copy)_5149725486626803723]) / SUM([num_of_realized_orders])' />
            </column>
            <column caption='% of Free Delivery - Others' datatype='real' name='[Calculation_5367094518653345801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_free_delivery_orders_others]) / SUM([num_of_realized_orders])' />
            </column>
            <column caption='Nominal DF' datatype='real' name='[Calculation_5804225181095231488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GMV (copy)_5149725486626390026])/ (SUM([num_of_realized_orders]) - SUM([num_of_free_delivery_orders]))' />
            </column>
            <column caption='Realized Fees / ABV' datatype='real' name='[Calculation_5804225181095690241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg Delivery Fee (copy)_5804225181154865156] / [Calculation_5149725486611517446]' />
            </column>
            <column caption='Nominal Fees / ABV' datatype='real' name='[Calculation_5804225181155422213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1931833150795575296] / [Calculation_5149725486611517446]' />
            </column>
            <column caption='Avg MOV / Avg Price per Item' datatype='real' name='[Calculation_5804225181155958790]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_535858037808017408] / [Calculation_5149725486628769806]' />
            </column>
            <column caption='Profit (CM1 proxy)' datatype='real' name='[Calculation_5804225181161463817]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg Delivery Fee (copy)_5804225181154865156] + [ABV (copy)_6015964740810686465] - [Avg Service Fee (copy)_5804225181160632328]' />
            </column>
            <column caption='Avg Listed SKUs' datatype='real' name='[Calculation_7025333976887554049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([listed_sku_count])' />
            </column>
            <column caption='Warehouse Framework Compliance %' datatype='real' name='[Calculation_7025333976893325315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Compliance (copy)_7025333976893841412]) / [Calculation_7025333976899538951]' />
            </column>
            <column caption='# of Warehouses' datatype='integer' name='[Calculation_7025333976899538951]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([warehouse_id])' />
            </column>
            <column caption='Daily Orders' datatype='real' name='[Calculation_980588518380171264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([num_of_realized_orders]) / COUNTD([local_date])' />
            </column>
            <column caption='Warehouse Framework Compliance' datatype='integer' name='[Compliance (copy)_7025333976893841412]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF {INCLUDE [warehouse_name]: [Calculation_5804225181155958790]} &gt;= [Framework MOV (copy)_7025333976895451142] THEN 1 Else 0 END' />
            </column>
            <column caption='Dimension 2  ' datatype='string' name='[Dimension 1 (copy)_5149725486602629124]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Dimension 1 (copy)_5149725486602563587]&#10;WHEN &apos;Region&apos; THEN [Calculation_244531392623730692]&#10;WHEN &apos;Global Entity Id&apos; THEN [global_entity_id]&#10;WHEN &apos;Country Name&apos; THEN [country_name]&#10;WHEN &apos;City&apos; THEN [city]&#10;WHEN &apos;Warehouse Id&apos; THEN [warehouse_id]&#10;WHEN &apos;Warehouse Name&apos; THEN [warehouse_name]&#10;END' />
            </column>
            <column caption='Dmarts vs Local Shops Index' datatype='real' name='[Dmarts vs Food Index (copy)_2273614155834929158]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Avg Delivery Fee (copy)_5804225181154865156] / [Realized Fees - Food (copy)_2273614155834519556]' />
            </column>
            <column caption='Local Shops Total Fees' datatype='real' name='[Food Total Fees (copy)_2273614155807141890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Euro&apos; THEN [ls_city_level_total_fees_eur]&#10;WHEN &apos;Local&apos; THEN [ls_city_level_total_fees_local]&#10;END' />
            </column>
            <column caption='Warehouse Framework' datatype='integer' name='[Framework MOV (copy)_7025333976895451142]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF {FIXED [warehouse_name]: [Calculation_980588518380171264]}  &gt; 400 AND {FIXED [warehouse_name]: [Calculation_7025333976887554049]} &gt; 2500 THEN 3 ELSE 2 END' />
            </column>
