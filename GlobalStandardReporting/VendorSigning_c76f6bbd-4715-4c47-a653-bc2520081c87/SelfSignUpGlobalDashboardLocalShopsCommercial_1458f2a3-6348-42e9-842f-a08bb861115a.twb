              <calculation class='tableau' formula='IF [new_account_source] in (&apos;SSU - Self Sign Up&apos;, &apos;SSU - Inbound&apos;) &#10;THEN &apos;SSU&apos; ELSE &apos;Non SSU&apos; end' />
            </column>
            <column caption='Churned Vendors' datatype='integer' name='[Calculation_2785546749610319872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [active_vendor_flag] = 0 and [Calculation_5458362815909191684] = &apos;Sep&apos; then [online_vendor_id] end)' />
            </column>
            <column caption='Coalesced_region' datatype='string' name='[Calculation_5458362749351235590]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([region]) then [online_region] else [region] end' />
            </column>
            <column caption='Coalesced_month_number' datatype='string' name='[Calculation_5458362749354627079]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if isnull([time_period_number]) then str([month_number]) else str([time_period_number]) end' />
            </column>
            <column caption='Online Month' datatype='string' name='[Calculation_5458362815909191684]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_5458362749354627079] = &apos;1&apos; then &quot;Jan&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;2&apos; then &quot;Feb&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;3&apos; then &quot;Mar&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;4&apos; then &quot;Apr&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;5&apos; then &quot;May&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;6&apos; then &quot;Jun&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;7&apos; then &quot;Jul&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;8&apos; then &quot;Aug&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;9&apos; then &quot;Sep&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;10&apos; then &quot;Oct&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;11&apos; then &quot;Nov&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;12&apos; then &quot;Dec&quot; &#10;else &apos;null&apos; end' />
            </column>
            <column datatype='integer' name='[active_vendor_flag]' role='measure' type='quantitative' />
