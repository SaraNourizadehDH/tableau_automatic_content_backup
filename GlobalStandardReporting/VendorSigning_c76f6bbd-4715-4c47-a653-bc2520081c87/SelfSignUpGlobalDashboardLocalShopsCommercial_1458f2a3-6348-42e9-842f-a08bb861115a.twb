os;,&#10;&apos;mother_and_baby&apos;,&#10;&apos;optics&apos;,&#10;&apos;services&apos;,&#10;&apos;snacks_and_sweets&apos;,&#10;&apos;specialty_and_ethnic&apos;,&#10;&apos;sports_and_lifestyle&apos;,&#10;&apos;stationery_and_books&apos;,&#10;&apos;wet_market&apos;,&#10;&apos;Supermarket&apos;,&#10;&apos;Tobacco&apos;,&#10;&apos;Vehicles&apos;) THEN &apos;De-prioritised Vertical segment&apos;&#10;ELSE [drop_reason__c]&#10;END' />
            </column>
