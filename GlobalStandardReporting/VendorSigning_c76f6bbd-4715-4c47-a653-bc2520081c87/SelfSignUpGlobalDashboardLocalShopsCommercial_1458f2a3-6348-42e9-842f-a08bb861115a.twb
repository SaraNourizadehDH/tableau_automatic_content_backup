              <calculation class='tableau' formula='IF ([company_code__c] IN (&apos;FP&apos;) and [account_country_code__c] IN (&apos;TR&apos;)) THEN &apos;Turkey&apos;&#10;ELSEIF ([geid] in (&apos;FP_TR&apos;)) THEN &apos;Turkey&apos;&#10;ELSEIF CONTAINS([geid], &quot;PY_&quot;) THEN &apos;PY&apos;&#10;ELSEIF CONTAINS([geid], &quot;AP_&quot;) THEN &apos;PY&apos;&#10;ELSEIF CONTAINS([geid], &quot;FP_&quot;) THEN &apos;FP&apos;&#10;ELSE [company_code__c] END' />
