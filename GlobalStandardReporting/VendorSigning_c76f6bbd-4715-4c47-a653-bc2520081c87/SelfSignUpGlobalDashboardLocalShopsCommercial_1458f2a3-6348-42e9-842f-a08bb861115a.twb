          <filter class='categorical' column='[federated.1ff5ivv0jt9orh1276xc50ihj6al].[none:Calculation_1380423710063509504:nk]' filter-group='13'>
            <groupfilter from='&quot;FP&quot;' function='range' level='[none:Calculation_1380423710063509504:nk]' to='&quot;Turkey&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
