          <datasource-dependencies datasource='federated.1ff5ivv0jt9orh1276xc50ihj6al'>
            <column caption='Defaulter_vendors' datatype='integer' name='[CR_Diff_from_floor (copy)_808747988157243393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if avg([Calculation_7010063933470740481]) &lt; max([floor_app]) then COUNTD([online_vendor_id]) else 0 end' />
            </column>
            <column caption='Active_vendor_id' datatype='string' name='[Calculation_1380423710091706370]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [active_vendor_flag] = 1 then [online_vendor_id] end' />
            </column>
            <column caption='Zombie %' datatype='real' name='[Calculation_5458362815867432960]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='((COUNTD([online_vendor_id]) - COUNTD([Calculation_1380423710091706370]))/COUNTD([online_vendor_id]) )' />
            </column>
            <column caption='Commission_rate' datatype='real' name='[Calculation_7010063933470740481]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([sum_amt_commission_eur]/[sum_amt_commission_base_eur])' />
