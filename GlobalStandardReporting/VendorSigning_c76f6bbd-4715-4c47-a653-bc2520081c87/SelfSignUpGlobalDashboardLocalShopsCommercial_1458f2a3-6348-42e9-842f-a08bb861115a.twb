      <column caption='Account Source Category' datatype='string' name='[Account Source new (copy)_5458362749706637322]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [new_account_source] in (&apos;SSU - Self Sign Up&apos;, &apos;SSU - Inbound&apos;) &#10;THEN &apos;SSU&apos; ELSE &apos;Non SSU&apos; end' />
      </column>
      <column caption='Defaulter_vendors' datatype='integer' name='[CR_Diff_from_floor (copy)_808747988157243393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if avg([Calculation_7010063933470740481]) &lt; max([floor_app]) then COUNTD([online_vendor_id]) else 0 end' />
      </column>
      <column caption='New_Company_Code__C' datatype='string' name='[Calculation_1380423710063509504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ([company_code__c] IN (&apos;FP&apos;) and [account_country_code__c] IN (&apos;TR&apos;)) THEN &apos;Turkey&apos;&#10;ELSEIF ([geid] in (&apos;FP_TR&apos;)) THEN &apos;Turkey&apos;&#10;ELSEIF CONTAINS([geid], &quot;PY_&quot;) THEN &apos;PY&apos;&#10;ELSEIF CONTAINS([geid], &quot;AP_&quot;) THEN &apos;PY&apos;&#10;ELSEIF CONTAINS([geid], &quot;FP_&quot;) THEN &apos;FP&apos;&#10;ELSE [company_code__c] END' />
      </column>
      <column caption='SSU_Grid__C' datatype='string' name='[Calculation_1380423710064967681]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_814236796821438464] in (&apos;SSU - Self Sign Up&apos;) then [grid__c] end' />
      </column>
      <column caption='Active_vendor_id' datatype='string' name='[Calculation_1380423710091706370]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [active_vendor_flag] = 1 then [online_vendor_id] end' />
      </column>
      <column caption='Calculation1' datatype='string' name='[Calculation_1380423711065133061]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([drop_reason__c] , &quot;Number of Restaurants&quot;) THEN &quot;Number of Restaurants != 1&quot;&#10;ELSEIF CONTAINS([drop_reason__c] , &quot;ACRA&quot;) THEN &quot;ACRA not Registered&quot;&#10;ELSEIF  CONTAINS([drop_reason__c] , &quot;Address - Coordinates&quot;) THEN &quot;Address - Coordinates not found&quot;&#10;ELSEIF CONTAINS([drop_reason__c],&quot;Address - Other&quot;) then &quot;Address - Other&quot;&#10;ELSEIF CONTAINS([drop_reason__c], &quot;Contract Details&quot;) then &quot;Contract Details&quot;&#10;ELSEIF CONTAINS([drop_reason__c], &quot;Duplicate&quot;) then &quot;Duplicate&quot;&#10;ELSEIF CONTAINS([drop_reason__c], &quot;Manual Conversion&quot;) then &quot;Manual Conversion&quot;&#10;ELSEIF CONTAINS([drop_reason__c], &quot;SSU ENABLED&quot;) then &quot;SSU ENABLED BUT MULTIBRANCH REQUEST&quot;&#10;ELSEIF CONTAINS([drop_reason__c], &quot;Web To Lead&quot;) then &quot;Web To Lead&quot;&#10;ELSEIF CONTAINS([drop_reason__c], &quot;Out of Zone&quot;) then &quot;Out of Zone&quot;&#10;&#10;ELSE &quot;OTHERS&quot;&#10;END' />
      </column>
      <column caption='Management Entity' datatype='string' name='[Calculation_1380423712459329542]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([geid], &quot;AP_&quot;) THEN &quot;LATAM&quot;&#10;ELSEIF CONTAINS([geid], &quot;PY_&quot;) THEN &quot;LATAM&quot;&#10;ELSEIF CONTAINS([geid], &quot;_TR&quot;) THEN &quot;Turkey&quot;&#10;ELSEIF CONTAINS([geid], &quot;FP_&quot;) THEN &quot;APAC&quot;&#10;ELSEIF CONTAINS([geid], &quot;TB_&quot;) THEN &quot;Talabat&quot;&#10;END' />
      </column>
      <column caption='Leads_count' datatype='integer' name='[Calculation_1808476744690843649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED geid,&#10;    segment,&#10;    management_entity,&#10;    sub_entity,&#10;    current_step__c,&#10;    drop_reason__c,&#10;    drop_from_ssu_process__c,&#10;    createddate,&#10;    Lead_source,&#10;    account_status__c,&#10;    number_of_outlets,&#10;    vertical__c,&#10;    vertical_segment__c,&#10;    lead_status,&#10;    op_signed,&#10;    op_closed_won : MAX([leads])}' />
      </column>
      <column caption='Net Take Rate (Eur)' datatype='real' name='[Calculation_2076300189348851712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_2887088855897726984]) + SUM([Calculation_2887088855898894346]))/ SUM([Calculation_2887088855894585349])' />
      </column>
      <column caption='Commission per Order' datatype='real' name='[Calculation_2076300189351084033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_2887088855897726984])/SUM([Calculation_2887088855894585349])' />
      </column>
      <column caption='Churned Vendors' datatype='integer' name='[Calculation_2785546749610319872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [active_vendor_flag] = 0 and [Calculation_5458362815909191684] = &apos;Sep&apos; then [online_vendor_id] end)' />
      </column>
      <column caption='current_step__c_names' datatype='string' name='[Calculation_2887088855842390017]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([op_signed]) = FALSE then &apos;7.Signed&apos;&#10;ELSEIF [current_step__c] IN (&apos;step-1&apos;) THEN &apos;1.Landing Page&apos;&#10;ELSEIF [current_step__c] IN (&apos;step-2&apos;) THEN &apos;2.Business Detail&apos;&#10;ELSEIF [current_step__c] IN (&apos;step-3&apos;) THEN &apos;3.Operational Details&apos;&#10;ELSEIF [current_step__c] IN (&apos;step-4&apos;) THEN &apos;4.Bank Details&apos;&#10;ELSEIF [current_step__c] IN (&apos;step-5&apos;) THEN &apos;5.Editorial Details&apos;&#10;ELSE &apos;6.Completed SSU&apos; END' />
      </column>
      <column caption='drop_reason__c_names' datatype='string' name='[Calculation_2887088855872839683]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([drop_reason__c] , &quot;Number of Restaurants&quot;) THEN &quot;Number of Restaurants != 1&quot;&#10;ELSEIF CONTAINS([drop_reason__c], &quot;Non-prioritised Business Segment&quot;) THEN &quot;Non-prioritised Business Segment&quot;&#10;ELSEIF CONTAINS([drop_reason__c] , &quot;ACRA&quot;) THEN &quot;ACRA not Registered&quot;&#10;ELSEIF  CONTAINS([drop_reason__c] , &quot;Address - Coordinates&quot;) THEN &quot;Address - Coordinates not found&quot;&#10;ELSEIF CONTAINS([drop_reason__c],&quot;Address - Other&quot;) then &quot;Address - Other&quot;&#10;ELSEIF CONTAINS([drop_reason__c], &quot;Contract Details&quot;) then &quot;Contract Details&quot;&#10;ELSEIF CONTAINS([drop_reason__c], &quot;Duplicate&quot;) then &quot;Duplicate&quot;&#10;ELSEIF CONTAINS([drop_reason__c], &quot;Manual Conversion&quot;) then &quot;Manual Conversion&quot;&#10;ELSEIF CONTAINS([drop_reason__c], &quot;SSU ENABLED&quot;) then &quot;SSU ENABLED BUT MULTIBRANCH REQUEST&quot;&#10;ELSEIF CONTAINS([drop_reason__c], &quot;Web To Lead&quot;) then &quot;Web To Lead&quot;&#10;ELSEIF CONTAINS([drop_reason__c], &quot;Out of Zone&quot;) then &quot;Out of Zone&quot;&#10;ELSEIF [drop_reason__c] IN (&apos;Bakery&apos;,&#10;&apos;Beauty&apos;,&#10;&apos;Butchery&apos;,&#10;&apos;Confectionery&apos;,&#10;&apos;Convenience&apos;,&#10;&apos;Cosmetics&apos;,&#10;&apos;Delicatessen&apos;,&#10;&apos;Drinks&apos;,&#10;&apos;Electronics&apos;,&#10;&apos;Fashion&apos;,&#10;&apos;Fishery&apos;,&#10;&apos;Flowers&apos;,&#10;&apos;Games&apos;,&#10;&apos;Groceries&apos;,&#10;&apos;Healthcare &amp; Beauty&apos;,&#10;&apos;Home &amp; Gifts&apos;,&#10;&apos;Party Supplies&apos;,&#10;&apos;Pets&apos;,&#10;&apos;Pharmacy&apos;,&#10;&apos;flowers_and_plants&apos;,&#10;&apos;fruits_and_vegetables&apos;,&#10;&apos;health_and_wellness&apos;,&#10;&apos;just_for_adults&apos;,&#10;&apos;kiosks&apos;,&#10;&apos;luggage_and_travel_accessories&apos;,&#10;&apos;mini_market&apos;,&#10;&apos;mother_and_baby&apos;,&#10;&apos;optics&apos;,&#10;&apos;services&apos;,&#10;&apos;snacks_and_sweets&apos;,&#10;&apos;specialty_and_ethnic&apos;,&#10;&apos;sports_and_lifestyle&apos;,&#10;&apos;stationery_and_books&apos;,&#10;&apos;wet_market&apos;,&#10;&apos;Supermarket&apos;,&#10;&apos;Tobacco&apos;,&#10;&apos;Vehicles&apos;) THEN &apos;De-prioritised Vertical segment&apos;&#10;ELSE [drop_reason__c]&#10;END' />
      </column>
      <column caption='Month' datatype='string' name='[Calculation_2887088855884918788]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [createddate] = 1 then &quot;Jan&quot;&#10;elseif [createddate] = 2 then &quot;Feb&quot;&#10;elseif [createddate] = 3 then &quot;Mar&quot;&#10;elseif [createddate] = 4 then &quot;Apr&quot;&#10;elseif [createddate] = 5 then &quot;May&quot;&#10;elseif [createddate] = 6 then &quot;Jun&quot;&#10;elseif [createddate] = 7 then &quot;Jul&quot;&#10;elseif [createddate] = 8 then &quot;Aug&quot;&#10;elseif [createddate] = 9 then &quot;Sep&quot;&#10;elseif [createddate] = 10 then &quot;Oct&quot;&#10;elseif [createddate] = 11 then &quot;Nov&quot;&#10;elseif [createddate] = 12 then &quot;Dec&quot; &#10;else &apos;null&apos; end' />
      </column>
      <column caption='# Successful Orders' datatype='integer' name='[Calculation_2887088855894585349]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [vendor_id], [month_number], [global_entity_id]: MAX([successful_order_count])}' />
      </column>
      <column caption='Total GMV (Eur)' datatype='real' name='[Calculation_2887088855895216134]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [vendor_id], [month_number], [global_entity_id]: MAX([amt_gmv_eur])}' />
      </column>
      <column caption='Total GBV (Eur)' datatype='real' name='[Calculation_2887088855895433223]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [vendor_id], [month_number], [global_entity_id]: MAX([amt_gbv_eur])}' />
      </column>
      <column caption='Commission (Eur)' datatype='real' name='[Calculation_2887088855897726984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [vendor_id], [month_number], [global_entity_id]: MAX([sum_commission])}' />
      </column>
      <column caption='Commission Base (Eur)' datatype='real' name='[Calculation_2887088855897939977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [vendor_id], [month_number], [global_entity_id]: MAX([sum_commission_base])}' />
      </column>
      <column caption='Delivery Fee (Eur)' datatype='real' name='[Calculation_2887088855898894346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [vendor_id], [month_number], [global_entity_id]: MAX([sum_delivery_fee_eur])}' />
      </column>
      <column caption='Avg. DF' datatype='real' name='[Calculation_2887088855899381771]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_2887088855898894346]) / SUM([Calculation_2887088855894585349])' />
      </column>
      <column caption='Qty. Sold (agg.)' datatype='integer' name='[Calculation_2887088855906131981]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [vendor_id], [month_number], [global_entity_id]: MAX([qty_sold])}' />
      </column>
      <column caption='Coalesced_GID' datatype='string' name='[Calculation_3606327782265520128]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ISNULL([online_global_entity_id]) then [global_entity_id] else [online_global_entity_id] end' />
      </column>
      <column caption='Coalesced_region' datatype='string' name='[Calculation_5458362749351235590]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if isnull([region]) then [online_region] else [region] end' />
      </column>
      <column caption='Coalesced_month_number' datatype='string' name='[Calculation_5458362749354627079]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if isnull([time_period_number]) then str([month_number]) else str([time_period_number]) end' />
      </column>
      <column caption='Account Source new' datatype='string' name='[Calculation_5458362749691916296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [account_source] in (&apos;automated leadgen&apos;, &apos;inbound&apos;, &apos;own research&apos;, &apos;self sign up&apos;) &#10;THEN [account_source] ELSE &apos;all others&apos; end' />
      </column>
      <column caption='CR_Diff_from_floor' datatype='real' name='[Calculation_5458362750128816139]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg([Calculation_7010063933470740481]) - max([floor_app])' />
      </column>
      <column caption='Zombie %' datatype='real' name='[Calculation_5458362815867432960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((COUNTD([online_vendor_id]) - COUNTD([Calculation_1380423710091706370]))/COUNTD([online_vendor_id]) )' />
      </column>
      <column caption='SSU Acq.%' datatype='real' name='[Calculation_5458362815874064385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_1380423710064967681])/COUNTD([grid__c])&#10;//#if [Main Account Source] in (&apos;SSU - Self Sign Up&apos;, &apos;SSU - Inbound&apos;) then [Grid__C] end)/COUNTD([Grid__C])' />
      </column>
      <column caption='Online Month' datatype='string' name='[Calculation_5458362815909191684]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_5458362749354627079] = &apos;1&apos; then &quot;Jan&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;2&apos; then &quot;Feb&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;3&apos; then &quot;Mar&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;4&apos; then &quot;Apr&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;5&apos; then &quot;May&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;6&apos; then &quot;Jun&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;7&apos; then &quot;Jul&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;8&apos; then &quot;Aug&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;9&apos; then &quot;Sep&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;10&apos; then &quot;Oct&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;11&apos; then &quot;Nov&quot;&#10;elseif [Calculation_5458362749354627079] = &apos;12&apos; then &quot;Dec&quot; &#10;else &apos;null&apos; end' />
      </column>
      <column caption='Go-live Year' datatype='string' name='[Calculation_5458362815909969925]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [go_live_year_number] = 2019 then &quot;2019&quot;&#10;elseif [go_live_year_number] = 2020 then &quot;2020&quot;&#10;elseif [go_live_year_number] = 2021 then &quot;2021&quot;&#10;elseif [go_live_year_number] = 2022 then &quot;2022&quot;&#10;else &apos;before 2019&apos;&#10;end' />
      </column>
      <column caption='Commission_rate' datatype='real' name='[Calculation_7010063933470740481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([sum_amt_commission_eur]/[sum_amt_commission_base_eur])' />
      </column>
      <column caption='Avg_ABS' datatype='real' name='[Calculation_7010063933504868354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2887088855906131981])/SUM([Calculation_2887088855894585349])' />
      </column>
      <column caption='Avg_delivery_fee' datatype='real' name='[Calculation_7010063934968184836]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([sum_delivery_fee_eur])/[successful_order_count]' />
      </column>
      <column caption='Avg_ABV' datatype='real' name='[Calculation_808747988108812288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2887088855895433223])/sum([Calculation_2887088855894585349])' />
      </column>
      <column caption='Main Account Source' datatype='string' name='[Calculation_814236796821438464]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [new_account_source] in (&quot;Busqueda Propia&quot;) then &quot;Own Research&quot;&#10;else [new_account_source] end' />
      </column>
      <column caption='Churned Vendors %' datatype='real' name='[Churned Vendors (copy)_2785546749612429313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [active_vendor_flag] = 0 and [Calculation_5458362815909191684] = &apos;Sep&apos; then [online_vendor_id] end)/COUNTD([online_vendor_id])' />
      </column>
      <column caption='SSU Pen.%' datatype='real' name='[SSU Acq.% (copy)_5458362815878156290]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [new_account_source] in (&apos;SSU - Self Sign Up&apos;) then [online_vendor_id] end)/COUNTD([online_vendor_id])' />
      </column>
