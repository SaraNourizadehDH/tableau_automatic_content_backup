    <worksheet name='5.Drop-off Reason'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Tableau Medium' fontsize='12'>SSU DROP OFF REASON (Absolute)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ssu_pim_table (local_shops_analytics)' name='federated.1ff5ivv0jt9orh1276xc50ihj6al' />
          </datasources>
          <datasource-dependencies datasource='federated.1ff5ivv0jt9orh1276xc50ihj6al'>
            <column caption='New_Company_Code__C' datatype='string' name='[Calculation_1380423710063509504]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ([company_code__c] IN (&apos;FP&apos;) and [account_country_code__c] IN (&apos;TR&apos;)) THEN &apos;Turkey&apos;&#10;ELSEIF ([geid] in (&apos;FP_TR&apos;)) THEN &apos;Turkey&apos;&#10;ELSEIF CONTAINS([geid], &quot;PY_&quot;) THEN &apos;PY&apos;&#10;ELSEIF CONTAINS([geid], &quot;AP_&quot;) THEN &apos;PY&apos;&#10;ELSEIF CONTAINS([geid], &quot;FP_&quot;) THEN &apos;FP&apos;&#10;ELSE [company_code__c] END' />
            </column>
            <column caption='Management Entity' datatype='string' name='[Calculation_1380423712459329542]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([geid], &quot;AP_&quot;) THEN &quot;LATAM&quot;&#10;ELSEIF CONTAINS([geid], &quot;PY_&quot;) THEN &quot;LATAM&quot;&#10;ELSEIF CONTAINS([geid], &quot;_TR&quot;) THEN &quot;Turkey&quot;&#10;ELSEIF CONTAINS([geid], &quot;FP_&quot;) THEN &quot;APAC&quot;&#10;ELSEIF CONTAINS([geid], &quot;TB_&quot;) THEN &quot;Talabat&quot;&#10;END' />
            </column>
            <column caption='drop_reason__c_names' datatype='string' name='[Calculation_2887088855872839683]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([drop_reason__c] , &quot;Number of Restaurants&quot;) THEN &quot;Number of Restaurants != 1&quot;&#10;ELSEIF CONTAINS([drop_reason__c], &quot;Non-prioritised Business Segment&quot;) THEN &quot;Non-prioritised Business Segment&quot;&#10;ELSEIF CONTAINS([drop_reason__c] , &quot;ACRA&quot;) THEN &quot;ACRA not Registered&quot;&#10;ELSEIF  CONTAINS([drop_reason__c] , &quot;Address - Coordinates&quot;) THEN &quot;Address - Coordinates not found&quot;&#10;ELSEIF CONTAINS([drop_reason__c],&quot;Address - Other&quot;) then &quot;Address - Other&quot;&#10;ELSEIF CONTAINS([drop_reason__c], &quot;Contract Details&quot;) then &quot;Contract Details&quot;&#10;ELSEIF CONTAINS([drop_reason__c], &quot;Duplicate&quot;) then &quot;Duplicate&quot;&#10;ELSEIF CONTAINS([drop_reason__c], &quot;Manual Conversion&quot;) then &quot;Manual Conversion&quot;&#10;ELSEIF CONTAINS([drop_reason__c], &quot;SSU ENABLED&quot;) then &quot;SSU ENABLED BUT MULTIBRANCH REQUEST&quot;&#10;ELSEIF CONTAINS([drop_reason__c], &quot;Web To Lead&quot;) then &quot;Web To Lead&quot;&#10;ELSEIF CONTAINS([drop_reason__c], &quot;Out of Zone&quot;) then &quot;Out of Zone&quot;&#10;ELSEIF [drop_reason__c] IN (&apos;Bakery&apos;,&#10;&apos;Beauty&apos;,&#10;&apos;Butchery&apos;,&#10;&apos;Confectionery&apos;,&#10;&apos;Convenience&apos;,&#10;&apos;Cosmetics&apos;,&#10;&apos;Delicatessen&apos;,&#10;&apos;Drinks&apos;,&#10;&apos;Electronics&apos;,&#10;&apos;Fashion&apos;,&#10;&apos;Fishery&apos;,&#10;&apos;Flowers&apos;,&#10;&apos;Games&apos;,&#10;&apos;Groceries&apos;,&#10;&apos;Healthcare &amp; Beauty&apos;,&#10;&apos;Home &amp; Gifts&apos;,&#10;&apos;Party Supplies&apos;,&#10;&apos;Pets&apos;,&#10;&apos;Pharmacy&apos;,&#10;&apos;flowers_and_plants&apos;,&#10;&apos;fruits_and_vegetables&apos;,&#10;&apos;health_and_wellness&apos;,&#10;&apos;just_for_adults&apos;,&#10;&apos;kiosks&apos;,&#10;&apos;luggage_and_travel_accessories&apos;,&#10;&apos;mini_market&apos;,&#10;&apos;mother_and_baby&apos;,&#10;&apos;optics&apos;,&#10;&apos;services&apos;,&#10;&apos;snacks_and_sweets&apos;,&#10;&apos;specialty_and_ethnic&apos;,&#10;&apos;sports_and_lifestyle&apos;,&#10;&apos;stationery_and_books&apos;,&#10;&apos;wet_market&apos;,&#10;&apos;Supermarket&apos;,&#10;&apos;Tobacco&apos;,&#10;&apos;Vehicles&apos;) THEN &apos;De-prioritised Vertical segment&apos;&#10;ELSE [drop_reason__c]&#10;END' />
            </column>
            <column caption='Account_Country_Code__C' datatype='string' name='[account_country_code__c]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Company_Code__C' datatype='string' name='[company_code__c]' role='dimension' type='nominal' />
            <column-instance column='[lead_id]' derivation='CountD' name='[ctd:lead_id:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[drop_reason__c]' role='dimension' type='nominal' />
            <column datatype='string' name='[geid]' role='dimension' type='nominal' />
            <column datatype='string' name='[lead_id]' role='dimension' type='nominal' />
