    <worksheet name='Summary View'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#800002' fontname='Tableau Medium'>SUMMARY VIEW</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tiering_final_table (local_shops_analytics)' name='federated.1bneztc16otxb41fd8u7p01z0n4b' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI Parameter' datatype='string' name='[Global Entity Id Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;GMV (Euro)&quot;'>
              <calculation class='tableau' formula='&quot;GMV (Euro)&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1bneztc16otxb41fd8u7p01z0n4b'>
            <column caption='% Online Duration' datatype='real' name='[Calculation_2235052096386441217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (sum([sum_offline_duration])/ sum([sum_scheduled_duration]))' />
            </column>
            <column caption='KPI Calculation' datatype='real' name='[Calculation_2235052096535863303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Global Entity Id Parameter] = &apos;Order count&apos; THEN sum([successful_order_count])&#10;ELSEIF [Parameters].[Global Entity Id Parameter] = &apos;GMV (Euro)&apos; THEN SUM([sum_gmv])&#10;ELSEIF [Parameters].[Global Entity Id Parameter] = &apos;ABV (Euro)&apos; THEN (SUM([sum_gmv])/SUM([successful_order_count]))&#10;ELSEIF [Parameters].[Global Entity Id Parameter] = &apos;Total SKUs&apos; THEN SUM([all_sku])&#10;ELSEIF [Parameters].[Global Entity Id Parameter] = &apos;Active SKUs&apos; THEN sum([active_sku])&#10;ELSEIF [Parameters].[Global Entity Id Parameter] = &apos;Commission (Euro)&apos; THEN SUM([commission])&#10;ELSEIF [Parameters].[Global Entity Id Parameter] = &apos;Commission Base (Euro)&apos; THEN SUM([commission_base])&#10;ELSEIF [Parameters].[Global Entity Id Parameter] = &apos;Commission (%)&apos; THEN SUM([commission])/SUM([commission_base])&#10;ELSEIF [Parameters].[Global Entity Id Parameter] = &apos;NPS %&apos; THEN (SUM([nps_promoters])/SUM([nps_responses]) - SUM([nps_detractors])/SUM([nps_responses]))&#10;ELSEIF [Parameters].[Global Entity Id Parameter] = &apos;Delivery Fee (Euro)&apos; THEN SUM([sum_delivery_fee])&#10;ELSEIF [Parameters].[Global Entity Id Parameter] = &apos;Voucher DH Fee (Euro)&apos; THEN SUM([sum_voucher_dh_fee])&#10;ELSEIF [Parameters].[Global Entity Id Parameter] = &apos;Total Sessions (Platform)&apos; THEN SUM([total_sessions])&#10;ELSEIF [Parameters].[Global Entity Id Parameter] = &apos;Total Sessions (Local Shops)&apos; THEN SUM([total_sessions_localshops])&#10;ELSEIF [Parameters].[Global Entity Id Parameter] = &apos;Total Transactions (Local Shops)&apos; THEN SUM([total_transactions_local_shops])&#10;ELSEIF [Parameters].[Global Entity Id Parameter] = &apos;Conversion (%)&apos; THEN ([Calculation_5161617798210772992])&#10;ELSEIF [Parameters].[Global Entity Id Parameter] = &apos;Online Duration (%)&apos; THEN ([Calculation_2235052096386441217])&#10;ELSEIF [Parameters].[Global Entity Id Parameter] = &apos;Net Take-in/o&apos; THEN [Calculation_6185271920131031041]&#10;END' />
            </column>
            <column caption='Conversion (%)' datatype='real' name='[Calculation_5161617798210772992]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_transactions_local_shops]) / SUM([total_sessions_localshops])' />
            </column>
            <column caption='Tier Classification' datatype='string' name='[Calculation_6068741277258530816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If [Vendor Count] &gt; 1 AND [key_account_category] IN (&apos;Global KA&apos;, &apos;National KA&apos;) THEN &apos;TIER 1&apos;&#10;ELSEIF  [Vendor Count] &gt; 1 AND NOT [key_account_category] IN (&apos;Global KA&apos;, &apos;National KA&apos;) AND [active_sku] &gt;= 10000 THEN &apos;TIER 1&apos;&#10;ELSEIF  [Vendor Count] &gt; 1 AND NOT [key_account_category] IN (&apos;Global KA&apos;, &apos;National KA&apos;) AND ([active_sku] &lt; 10000 OR ISNULL([active_sku]) = TRUE) THEN &apos;TIER 2&apos;&#10;ELSEIF  ([Vendor Count] &lt;= 1 OR ISNULL([Vendor Count]) = TRUE OR STR([Vendor Count]) IN (&apos;&apos;, &apos; &apos;)) AND [SFTP/API Flag] IN (&apos;SFTP/API&apos;) AND [key_account_category] IN (&apos;Global KA&apos;, &apos;National KA&apos;) THEN &apos;TIER 1&apos;&#10;ELSEIF  ([Vendor Count] &lt;= 1 OR ISNULL([Vendor Count]) = TRUE  OR STR([Vendor Count]) IN (&apos;&apos;, &apos; &apos;)) AND [SFTP/API Flag] IN (&apos;SFTP/API&apos;) AND NOT [key_account_category] IN (&apos;Global KA&apos;, &apos;National KA&apos;) AND [active_sku] &gt;= 10000 THEN &apos;TIER 1&apos;&#10;ELSEIF  ([Vendor Count] &lt;= 1 OR ISNULL([Vendor Count]) = TRUE  OR STR([Vendor Count]) IN (&apos;&apos;, &apos; &apos;)) AND [SFTP/API Flag] IN (&apos;SFTP/API&apos;) AND NOT [key_account_category] IN (&apos;Global KA&apos;, &apos;National KA&apos;) AND ([active_sku] &lt; 10000 OR ISNULL([active_sku]) = TRUE) THEN &apos;TIER 2&apos;&#10;ELSEIF  ([Vendor Count] &lt;= 1 OR ISNULL([Vendor Count]) = TRUE  OR STR([Vendor Count]) IN (&apos;&apos;, &apos; &apos;)) AND [SFTP/API Flag] IN (&apos;SFTP/API&apos;) AND [key_account_category] IN (&apos;Global KA&apos;, &apos;National KA&apos;) AND ([active_sku] &lt; 10000 OR ISNULL([active_sku]) = TRUE) THEN &apos;TIER 2&apos;&#10;ELSEIF  ([Vendor Count] &lt;= 1 OR ISNULL([Vendor Count]) = TRUE  OR STR([Vendor Count]) IN (&apos;&apos;, &apos; &apos;)) AND NOT [SFTP/API Flag] IN (&apos;SFTP/API&apos;) AND [Key Account / LB Flag] IN (&apos;KA/LB&apos;) AND [key_account_category] IN (&apos;Global KA&apos;, &apos;National KA&apos;) THEN &apos;TIER 1&apos;&#10;ELSEIF  ([Vendor Count] &lt;= 1 OR ISNULL([Vendor Count]) = TRUE  OR STR([Vendor Count]) IN (&apos;&apos;, &apos; &apos;)) AND NOT [SFTP/API Flag] IN (&apos;SFTP/API&apos;) AND [Key Account / LB Flag] IN (&apos;KA/LB&apos;) AND NOT [key_account_category] IN (&apos;Global KA&apos;, &apos;National KA&apos;) AND [active_sku] &gt;= 10000 THEN &apos;TIER 1&apos;&#10;ELSEIF  ([Vendor Count] &lt;= 1 OR ISNULL([Vendor Count]) = TRUE  OR STR([Vendor Count]) IN (&apos;&apos;, &apos; &apos;)) AND NOT [SFTP/API Flag] IN (&apos;SFTP/API&apos;) AND [Key Account / LB Flag] IN (&apos;KA/LB&apos;) AND NOT [key_account_category] IN (&apos;Global KA&apos;, &apos;National KA&apos;) AND ([active_sku] &lt; 10000 OR ISNULL([active_sku]) = TRUE) THEN &apos;TIER 2&apos;&#10;ELSEIF  ([Vendor Count] &lt;= 1 OR ISNULL([Vendor Count]) = TRUE OR STR([Vendor Count]) IN (&apos;&apos;, &apos; &apos;)) AND NOT [SFTP/API Flag] IN (&apos;SFTP/API&apos;) AND [Key Account / LB Flag] IN (&apos;KA/LB&apos;) AND [key_account_category] IN (&apos;Global KA&apos;, &apos;National KA&apos;) AND ([active_sku] &lt; 10000 OR ISNULL([active_sku]) = TRUE) THEN &apos;TIER 2&apos;&#10;ELSEIF  ([Vendor Count] &lt;= 1 OR ISNULL([Vendor Count]) = TRUE OR STR([Vendor Count]) IN (&apos;&apos;, &apos; &apos;)) AND NOT [SFTP/API Flag] IN (&apos;SFTP/API&apos;) AND NOT [Key Account / LB Flag] IN (&apos;KA/LB&apos;) THEN &apos;TIER 3&apos;&#10;ELSE &apos;NULL&apos;&#10;END' />
            </column>
            <column caption='Net Take-in (Total)' datatype='real' name='[Calculation_6185271920131031041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([commission]) + SUM([sum_delivery_fee]) - SUM([sum_voucher_dh_fee])) / SUM([successful_order_count])' />
            </column>
            <column datatype='string' name='[Key Account / LB Flag]' role='dimension' type='nominal' />
            <column datatype='string' name='[SFTP/API Flag]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Vendor Count]' role='measure' type='quantitative' />
            <column caption='Active Sku' datatype='integer' name='[active_sku]' role='measure' type='quantitative' />
            <column caption='All Sku' datatype='integer' name='[all_sku]' role='measure' type='quantitative' />
            <column caption='Commission' datatype='real' name='[commission]' role='measure' type='quantitative' />
            <column caption='Commission Base' datatype='real' name='[commission_base]' role='measure' type='quantitative' />
            <column datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[vendor_id]' derivation='CountD' name='[ctd:vendor_id:qk]' pivot='key' type='quantitative' />
            <column caption='Global Entity Id' datatype='string' name='[global_entity_id]' role='dimension' type='nominal' />
            <column caption='Key Account Category' datatype='string' name='[key_account_category]' role='dimension' type='nominal' />
            <column caption='Management Entity' datatype='string' name='[management_entity]' role='dimension' type='nominal' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[month]' derivation='MY' name='[my:month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_6068741277258530816]' derivation='None' name='[none:Calculation_6068741277258530816:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_name]' derivation='None' name='[none:country_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[global_entity_id]' derivation='None' name='[none:global_entity_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[management_entity]' derivation='None' name='[none:management_entity:nk]' pivot='key' type='nominal' />
            <column-instance column='[vertical_type]' derivation='None' name='[none:vertical_type:nk]' pivot='key' type='nominal' />
            <column caption='Nps Detractors' datatype='integer' name='[nps_detractors]' role='measure' type='quantitative' />
            <column caption='Nps Promoters' datatype='integer' name='[nps_promoters]' role='measure' type='quantitative' />
