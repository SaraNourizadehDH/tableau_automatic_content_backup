              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='17273' id='5' is-scaled='1' param='Image/DH-LOGO-01 (1).jpeg' type-v2='bitmap' w='19201' x='651' y='1140'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='17273' id='6' type-v2='text' w='79497' x='19852' y='1140'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#c90032' fontname='Tableau Medium' fontsize='36'>TIERING DASHBOARD</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run bold='true' fontalignment='1' fontcolor='#555555' fontname='Tableau Medium' fontsize='12' italic='true'>TIER BASED CATEGORISATION FOR EFFECTIVE VENDOR MANAGEMENT AND PERFORMANCE MEASUREMENT</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='73784' id='11' type-v2='text' w='47844' x='51505' y='25076'>
            <formatted-text>
              <run bold='true' fontcolor='#c90032'> # Online Vendors </run>
              <run bold='true'>: </run>
              <run>Number of vendors currently online on the platform
</run>
              <run bold='true' fontcolor='#c90032'> # Active Vendors (last 90 days)</run>
              <run bold='true'> : </run>
              <run>Number of vendors who made atleast one sale in the last 90  days
</run>
              <run bold='true' fontcolor='#c90032'> # Successful Orders</run>
              <run bold='true'> : </run>
              <run>Number of successful (sent) orders
</run>
              <run bold='true' fontcolor='#c90032'> % Orders</run>
              <run bold='true'> : </run>
              <run>Order share by tiers&#10;</run>
              <run bold='true' fontcolor='#c90032'> # Active SKUs</run>
              <run bold='true'> : </run>
              <run>Number of active SKUs that are available for the customers to buy
</run>
              <run bold='true' fontcolor='#c90032'> Total No. Of SKUs</run>
              <run bold='true'> : </run>
              <run>Number of SKUs that are on the vednor catalog
</run>
              <run bold='true' fontcolor='#c90032'> Commission </run>
              <run bold='true'>: </run>
              <run>Commission charged in total&#10;</run>
              <run bold='true' fontcolor='#c90032'> Commission Base </run>
              <run bold='true'>: </run>
              <run>The base on which the commission is charged
</run>
              <run bold='true' fontcolor='#c90032'> Commission (%)</run>
              <run fontcolor='#c90032'>Æ </run>
              <run>: The percentage of revenue or sales charged as a fee or commission.  Formula: (Commission Amount / Total Revenue) * 100
</run>
              <run bold='true' fontcolor='#c90032'> Detractors - NPS</run>
              <run bold='true'>:</run>
              <run> Number of respondents with scores 0 to 6 on the NPS scale. Formula: Count   of detractor responses
</run>
              <run bold='true' fontcolor='#c90032'> Promoters - NPS</run>
              <run bold='true'>:</run>
              <run> Number of respondents with scores 9 to 10 on the NPS scale. Formula:  Count of promoter responses
</run>
              <run bold='true' fontcolor='#c90032'> Responses - NPS</run>
              <run bold='true'>:</run>
              <run> Total number of survey responses received for calculating NPS. Formula:  Count of all survey responses
</run>
              <run bold='true' fontcolor='#c90032'> NPS Score</run>
              <run>: Net Promoter Score calculated by subtracting the percentage of detractors from  the percentage of promoters. Formula: (Promoters - Detractors) / Responses * 100
</run>
              <run bold='true' fontcolor='#c90032'> Vendor Fail Rate</run>
              <run>: Share of failed orders due to vendors in total orders. Formula: (Failed  Orders by Vendors / Total Orders) * 100
</run>
              <run bold='true' fontcolor='#c90032'> Delivery Fee</run>
              <run>: The fee charged for the delivery of goods or services.
</run>
              <run bold='true' fontcolor='#c90032'> ABV (Average Basket Value)</run>
              <run>: The average value of each order placed. Formula: Total GMV /  Total Successful Orders
</run>
              <run bold='true' fontcolor='#c90032'> GMV (Gross Merchandise Value)</run>
              <run>: The total value of all products sold on Local Shops.
</run>
              <run bold='true' fontcolor='#c90032'> Net Take-in / o:</run>
              <run> Net revenue earned by the marketplace per order placed. Formula: Net  Revenue / Total Orders
</run>
              <run bold='true' fontcolor='#c90032'> Offline Duration</run>
              <run>: The duration in which a service or system is not accessible or unavailable.
</run>
              <run bold='true' fontcolor='#c90032'> Scheduled Duration</run>
              <run>: The planned or expected duration for a particular event or activity.
</run>
              <run bold='true' fontcolor='#c90032'> % Online Duration</run>
              <run>: The percentage of time during which a service or system is accessible or  available.
</run>
              <run bold='true' fontcolor='#c90032'> Total Transactions (Local Shops)</run>
              <run>: The overall number of transactions recorded for local shops.
</run>
              <run bold='true' fontcolor='#c90032'> Total No. of Sessions (Local Shops) </run>
              <run>: The total number of interactions or sessions recorded.
</run>
              <run bold='true' fontcolor='#c90032'> % Conversion</run>
              <run> :The percentage of successful conversions or desired outcomes from total i    nteractions. Formula: (Successful Conversions / Total Interactions) * 100</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='6663' id='20' type-v2='text' w='50854' x='651' y='18413'>
            <formatted-text>
              <run bold='true' fontcolor='#c90032' fontsize='15' underline='true'>Tiering Framework</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='6663' id='21' type-v2='text' w='47844' x='51505' y='18413'>
            <formatted-text>
              <run bold='true' fontcolor='#c90032' fontsize='15' underline='true'>KPI Definition</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
