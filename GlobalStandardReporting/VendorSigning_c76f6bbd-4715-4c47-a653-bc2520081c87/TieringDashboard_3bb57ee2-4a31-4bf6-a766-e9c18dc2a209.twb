            <column caption='Sum Delivery Fee' datatype='real' name='[sum_delivery_fee]' role='measure' type='quantitative' />
            <column caption='Sum Gmv' datatype='real' name='[sum_gmv]' role='measure' type='quantitative' />
            <column caption='Sum Offline Duration' datatype='integer' name='[sum_offline_duration]' role='measure' type='quantitative' />
            <column caption='Sum Scheduled Duration' datatype='integer' name='[sum_scheduled_duration]' role='measure' type='quantitative' />
            <column datatype='real' name='[sum_voucher_dh_fee]' role='measure' type='quantitative' />
            <column caption='Total Sessions' datatype='integer' name='[total_sessions]' role='measure' type='quantitative' />
            <column caption='Total Sessions Localshops' datatype='integer' name='[total_sessions_localshops]' role='measure' type='quantitative' />
            <column caption='Total Transactions Local Shops' datatype='integer' name='[total_transactions_local_shops]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2235052096535863303]' derivation='User' name='[usr:Calculation_2235052096535863303:qk]' pivot='key' type='quantitative' />
