          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='C1-2 Y Midline' datatype='real' name='[Calculation_1221882918444765184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Y coordinate of the midpoint line.&#13;&#10;// Calc will give us the top of the curve, so we&apos;ll move down half to get to the midline.&#13;&#10;[Calculation_8950329121202785] + (([Calculation_5790329121624550] - [Calculation_8950329121202785])*ATTR([Calculation_633600195921932290]))-[Calculation_1490329120836378 1]/2'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='C3-4 X Midline Next' datatype='real' name='[Calculation_1221882918446968834 1 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Get the next X value.&#13;&#10;[Calculation_987695734025609216 1 1]+[Calculation_987695734030151684]' />
      </column>
      <column caption='C4-5 X Midline Next' datatype='real' name='[Calculation_1221882918446968834 1 2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Get the next X value.&#13;&#10;[Calculation_987695734025609216 1 2]+[Calculation_987695734030151684]' />
      </column>
