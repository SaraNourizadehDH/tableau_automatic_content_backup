            <column caption='Curve Y Next' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Sigmoid Y (copy) (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Calculate the Y coordinate based on the curve&apos;s formula, using the next point (to the right).&#13;&#10;CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Sigmoid&quot; THEN&#13;&#10;    1/(1+EXP(-[Sigmoid X Previous (copy)]))&#13;&#10;&#13;&#10;WHEN &quot;Sine&quot; THEN&#13;&#10;    (SIN([Sigmoid X Previous (copy)]) + 1)/2&#13;&#10;&#13;&#10;WHEN &quot;Cubic&quot; THEN&#13;&#10;    (IF [Sigmoid X Previous (copy)]*2 &lt;= 1 THEN &#13;&#10;        ([Sigmoid X Previous (copy)]*2)*([Sigmoid X Previous (copy)]*2)*([Sigmoid X Previous (copy)]*2) &#13;&#10;    ELSE &#13;&#10;        ((([Sigmoid X Previous (copy)]*2)-2)*(([Sigmoid X Previous (copy)]*2)-2)*(([Sigmoid X Previous (copy)]*2)-2))+2 &#13;&#10;    END) / 2&#13;&#10;END' />
