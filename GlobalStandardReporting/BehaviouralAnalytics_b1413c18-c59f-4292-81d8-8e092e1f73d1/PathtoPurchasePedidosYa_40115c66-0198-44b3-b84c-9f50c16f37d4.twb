      <table>
        <view>
          <datasources>
            <datasource caption='PY-General-User-Path' name='federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Whitespace' datatype='real' name='[Parameter 1 1]' param-domain-type='range' role='measure' type='quantitative' value='0.615807903951976'>
              <calculation class='tableau' formula='0.615807903951976' />
              <range max='1.0' min='0.0' />
            </column>
            <column caption='Squish Ratio' datatype='real' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='0.48405797101449283'>
              <calculation class='tableau' formula='0.48405797101449283' />
            </column>
            <column caption='Curve Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Sigmoid&quot;'>
              <calculation class='tableau' formula='&quot;Sigmoid&quot;' />
            </column>
            <column caption='Max Points' datatype='integer' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='50'>
              <calculation class='tableau' formula='50' />
              <desc>
                <formatted-text>
                  <run>This is a static value</run>
                </formatted-text>
              </desc>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)'>
            <column caption='C2-3 Y Midline' datatype='real' name='[Calculation_1221882918444765184 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Y coordinate of the midpoint line.&#13;&#10;// Calc will give us the top of the curve, so we&apos;ll move down half to get to the midline.&#13;&#10;[Calculation_5790329121624550] + (([Calculation_5790329121624550 1] - [Calculation_5790329121624550])*ATTR([Calculation_633600195921932290]))-[Flow Size 1 (copy)]/2'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='C2-3 X Midline Next' datatype='real' name='[Calculation_1221882918446968834 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Get the next X value.&#13;&#10;[Calculation_987695734025609216 1]+[Calculation_987695734030151684]' />
            </column>
            <column caption='N3 Index' datatype='integer' name='[Calculation_2320329132122533 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Separate index calc for Step 1 so it can be computed differently.&#13;&#10;INDEX()'>
                <table-calc ordering-type='Field'>
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[Step 2]' />
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[Step 1]' />
                </table-calc>
              </calculation>
            </column>
            <column caption='N2 Index' datatype='integer' name='[Calculation_2320329132122533]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Separate index calc for Step 1 so it can be computed differently.&#13;&#10;INDEX()'>
                <table-calc ordering-type='Field'>
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[step_2]' />
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[step_1]' />
                </table-calc>
              </calculation>
            </column>
            <column caption='month' datatype='string' name='[Calculation_365284190685270017]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, [partition_date])) &#10;&#9;+ STR(&quot;-&quot;) &#10;&#9;+ IF DATEPART(&apos;month&apos;, [partition_date]) &lt; 10 THEN STR(&quot;0&quot;) ELSE STR(&quot;&quot;) END&#10;&#9;+ STR(DATEPART(&apos;month&apos;, [partition_date]))' />
            </column>
            <column caption='N3 Position' datatype='real' name='[Calculation_4020329132355237 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Position of each bar on step 2&#13;&#10;RUNNING_SUM([Flow Size 1 (copy) 1]) - [Flow Size 1 (copy) 1] + [Calculation_2320329132122533 1]*[N1 Whitespace (copy) 1] - [N1 Whitespace (copy) 1]/2'>
                <table-calc ordering-type='Field'>
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[step_2]' />
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[step_1]' />
                </table-calc>
              </calculation>
            </column>
            <column caption='N2 Position' datatype='real' name='[Calculation_4020329132355237]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Position of each bar on step 2&#13;&#10;RUNNING_SUM([Flow Size 1 (copy)]) - [Flow Size 1 (copy)] + [Calculation_2320329132122533]*[N1 Whitespace (copy)] - [N1 Whitespace (copy)]/2'>
                <table-calc ordering-type='Field'>
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[step_2]' />
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[step_1]' />
                </table-calc>
              </calculation>
            </column>
            <column caption='C2-3 Slope Avg' datatype='real' name='[Calculation_487514725147701266 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Average of the slopes connected to the current point.&#13;&#10;([Calculation_738871858447269888 1]+[Slope Next (copy) 1])/2'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='N3 Position Max' datatype='real' name='[Calculation_5790329121624550 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Top of each bar on step 2&#13;&#10;[Calculation_4020329132355237 1]+[Flow Size 1 (copy) 1]'>
                <table-calc ordering-type='Field'>
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[Step 2]' />
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[Step 1]' />
                </table-calc>
              </calculation>
            </column>
            <column caption='N2 Position Max' datatype='real' name='[Calculation_5790329121624550]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Top of each bar on step 2&#13;&#10;[Calculation_4020329132355237]+[Flow Size 1 (copy)]'>
                <table-calc ordering-type='Field'>
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[Step 2]' />
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[Step 1]' />
                </table-calc>
              </calculation>
            </column>
            <column caption='Curve Y' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_633600195921932290]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Calculate the Y coordinate based on the curve&apos;s formula, using the primary point.&#13;&#10;CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Sigmoid&quot; THEN&#13;&#10;    1/(1+EXP(-[Calculation_987695734030811141]))&#13;&#10;&#13;&#10;WHEN &quot;Sine&quot; THEN&#13;&#10;    (SIN([Calculation_987695734030811141]) + 1)/2&#13;&#10;&#13;&#10;WHEN &quot;Cubic&quot; THEN&#13;&#10;    (IF [Calculation_987695734030811141]*2 &lt;= 1 THEN &#13;&#10;        ([Calculation_987695734030811141]*2)*([Calculation_987695734030811141]*2)*([Calculation_987695734030811141]*2) &#13;&#10;    ELSE &#13;&#10;        ((([Calculation_987695734030811141]*2)-2)*(([Calculation_987695734030811141]*2)-2)*(([Calculation_987695734030811141]*2)-2))+2 &#13;&#10;    END) / 2&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='C2-3 Slope Next' datatype='real' name='[Calculation_738871858447269888 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Slope of a line perpendicular to the line from the current point to the next.&#13;&#10;IF ROUND([Y Previous (copy) 1]-[Calculation_1221882918444765184 1],8) = 0 THEN&#13;&#10;    // Slope is 0&#13;&#10;    0&#13;&#10;ELSE&#13;&#10;    -1/(([Y Previous (copy) 1]-[Calculation_1221882918444765184 1])/(ATTR([Calculation_1221882918446968834 1])-ATTR([Calculation_987695734025609216 1])))&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='C2-3 X Top' datatype='real' name='[Calculation_738871858451017731 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// X coordinate for the top parallel line.&#13;&#10;ATTR([Calculation_987695734025609216 1])+[Flow Size 1 (copy)]/2*COS(RADIANS([Calculation_738871858459418636 1]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='C2-3 X Final' datatype='real' name='[Calculation_738871858454740996 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Final X value.&#13;&#10;IF ATTR([Path])=1 OR ATTR([Path])=50 THEN&#13;&#10;    // Address math precision issues and set to the standard start and end.&#13;&#10;    ATTR([Calculation_987695734025609216 1])&#13;&#10;ELSE&#13;&#10;    CASE ATTR([Line])&#13;&#10;    WHEN &quot;Bottom&quot; THEN [X Top Parallel (copy) 1]&#13;&#10;    WHEN &quot;Midline&quot; THEN ATTR([Calculation_987695734025609216 1])&#13;&#10;    WHEN &quot;Top&quot; THEN [Calculation_738871858451017731 1]&#13;&#10;    END&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='C2-3 Angle Top' datatype='real' name='[Calculation_738871858459418636 1]' role='measure' type='quantitative'>
