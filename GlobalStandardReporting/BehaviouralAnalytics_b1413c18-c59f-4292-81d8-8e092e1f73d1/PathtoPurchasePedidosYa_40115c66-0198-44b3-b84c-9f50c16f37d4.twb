        <calculation class='tableau' formula='// Calculate the Y coordinate based on the curve&apos;s formula, using the previous point (to the left).&#13;&#10;CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Sigmoid&quot; THEN&#13;&#10;    1/(1+EXP(-[Sigmoid X (copy)]))&#13;&#10;&#13;&#10;WHEN &quot;Sine&quot; THEN&#13;&#10;    (SIN([Sigmoid X (copy)]) + 1)/2&#13;&#10;&#13;&#10;WHEN &quot;Cubic&quot; THEN&#13;&#10;    (IF [Sigmoid X (copy)]*2 &lt;= 1 THEN &#13;&#10;        ([Sigmoid X (copy)]*2)*([Sigmoid X (copy)]*2)*([Sigmoid X (copy)]*2) &#13;&#10;    ELSE &#13;&#10;        ((([Sigmoid X (copy)]*2)-2)*(([Sigmoid X (copy)]*2)-2)*(([Sigmoid X (copy)]*2)-2))+2 &#13;&#10;    END) / 2&#13;&#10;END' />
      </column>
      <column caption='C3-4 Slope Previous' datatype='real' name='[Slope Next (copy) 1 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Slope of a line perpendicular to the line from the current point to the previous.&#13;&#10;IF ROUND([Calculation_1221882918444765184 1 1]-[Y (copy) 1 1],8) = 0 THEN&#13;&#10;    // Slope is 0&#13;&#10;    0&#13;&#10;ELSE&#13;&#10;    -1/(([Calculation_1221882918444765184 1 1]-[Y (copy) 1 1])/(ATTR([Calculation_987695734025609216 1 1])-ATTR([Next X (copy) 1 1])))&#13;&#10;END'>
