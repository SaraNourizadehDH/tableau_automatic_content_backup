        <calculation class='tableau' formula='// We want to evenly distribute the spacing...&#13;&#10;// ...so that the flows stay the same size...&#13;&#10;// ...regardless of the number of bars on each side.&#13;&#10;// Separate calc for Step 1 so it can be computed differently.&#13;&#10;[Parameters].[Parameter 1 1]/SIZE()'>
