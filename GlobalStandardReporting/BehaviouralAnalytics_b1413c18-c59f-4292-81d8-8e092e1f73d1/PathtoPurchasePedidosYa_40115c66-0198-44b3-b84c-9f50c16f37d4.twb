      <aliases enabled='yes' />
      <column caption='C3-4 Y Midline' datatype='real' name='[Calculation_1221882918444765184 1 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Y coordinate of the midpoint line.&#13;&#10;// Calc will give us the top of the curve, so we&apos;ll move down half to get to the midline.&#13;&#10;[Calculation_5790329121624550 1] + (([Calculation_5790329121624550 1 1] - [Calculation_5790329121624550 1])*ATTR([Calculation_633600195921932290]))-[Flow Size 1 (copy) 1]/2'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='C4-5 Y Midline' datatype='real' name='[Calculation_1221882918444765184 1 2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Y coordinate of the midpoint line.&#13;&#10;// Calc will give us the top of the curve, so we&apos;ll move down half to get to the midline.&#13;&#10;[Calculation_5790329121624550 1 1] + (([Calculation_5790329121624550 1 1 1] - [Calculation_5790329121624550 1 1])*ATTR([Calculation_633600195921932290]))-[Flow Size 1 (copy) 1 1]/2'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='C2-3 Y Midline' datatype='real' name='[Calculation_1221882918444765184 1]' role='measure' type='quantitative'>
