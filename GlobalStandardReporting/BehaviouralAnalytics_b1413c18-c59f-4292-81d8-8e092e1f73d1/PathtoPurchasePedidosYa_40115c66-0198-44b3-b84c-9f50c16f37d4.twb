            <column caption='Curve X Previous' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Sigmoid X (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Get the previous point (to the left). Note: Primary point is Path-1 so - 1 = Pa&#13;&#10;// Space our points out evenly across the correct range in order to produce a smooth curve.&#13;&#10;CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Sigmoid&quot; THEN  ([Path]-2)*(12/([Calculation_987695734025916417]-1))-6    // -6 to 6&#13;&#10;WHEN &quot;Sine&quot; THEN     ([Path]-2)*(3/([Calculation_987695734025916417]-1))-1.5   // -1.5 to 1.5&#13;&#10;ELSE                 ([Path]-2)/([Calculation_987695734025916417]-1)           // 0 to 1&#13;&#10;END' />
            </column>
            <column caption='Curve X Next' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Sigmoid X Previous (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Get the previous point (to the left). Note: Primary point is Path-1 so + 1 = Path&#13;&#10;// Space our points out evenly across the correct range in order to produce a smooth curve.&#13;&#10;CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Sigmoid&quot; THEN  ([Path])*(12/([Calculation_987695734025916417]-1))-6    // -6 to 6&#13;&#10;WHEN &quot;Sine&quot; THEN     ([Path])*(3/([Calculation_987695734025916417]-1))-1.5   // -1.5 to 1.5&#13;&#10;ELSE                 ([Path])/([Calculation_987695734025916417]-1)           // 0 to 1&#13;&#10;END' />
            </column>
            <column caption='Curve Y Next' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Sigmoid Y (copy) (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Calculate the Y coordinate based on the curve&apos;s formula, using the next point (to the right).&#13;&#10;CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Sigmoid&quot; THEN&#13;&#10;    1/(1+EXP(-[Sigmoid X Previous (copy)]))&#13;&#10;&#13;&#10;WHEN &quot;Sine&quot; THEN&#13;&#10;    (SIN([Sigmoid X Previous (copy)]) + 1)/2&#13;&#10;&#13;&#10;WHEN &quot;Cubic&quot; THEN&#13;&#10;    (IF [Sigmoid X Previous (copy)]*2 &lt;= 1 THEN &#13;&#10;        ([Sigmoid X Previous (copy)]*2)*([Sigmoid X Previous (copy)]*2)*([Sigmoid X Previous (copy)]*2) &#13;&#10;    ELSE &#13;&#10;        ((([Sigmoid X Previous (copy)]*2)-2)*(([Sigmoid X Previous (copy)]*2)-2)*(([Sigmoid X Previous (copy)]*2)-2))+2 &#13;&#10;    END) / 2&#13;&#10;END' />
