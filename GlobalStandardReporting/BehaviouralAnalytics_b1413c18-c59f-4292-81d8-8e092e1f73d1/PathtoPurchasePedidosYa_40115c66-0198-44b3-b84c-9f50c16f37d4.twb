            <column caption='C2-3 Y Final' datatype='real' name='[X Final (copy) 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Final Y value.&#13;&#10;IF ISNULL(ATTR([step_2])) OR ATTR([step_2])=&quot;&quot; OR ISNULL(ATTR([step_3])) OR ATTR([step_3])=&quot;&quot; THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    CASE ATTR([Line])&#13;&#10;    WHEN &quot;Bottom&quot; THEN [Y Top Parallel (copy) 1]&#13;&#10;    WHEN &quot;Midline&quot; THEN [Calculation_1221882918444765184 1]&#13;&#10;    WHEN &quot;Top&quot; THEN [X Parallel (copy) 1]&#13;&#10;    END&#13;&#10;END'>
