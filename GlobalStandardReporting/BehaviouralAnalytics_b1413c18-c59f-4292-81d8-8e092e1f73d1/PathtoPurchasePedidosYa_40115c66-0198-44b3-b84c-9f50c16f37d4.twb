            <column datatype='string' name='[Step 2]' role='dimension' type='nominal' />
            <column caption='C1-2 Angle Bottom' datatype='real' name='[Top Angle (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Angle, in degrees, based on the slope, to get the bottom curve.&#13;&#10;// Just need to swing the top around 180 degrees.&#13;&#10;180+[Calculation_738871858459418636]'>
                <table-calc ordering-type='Rows' />
