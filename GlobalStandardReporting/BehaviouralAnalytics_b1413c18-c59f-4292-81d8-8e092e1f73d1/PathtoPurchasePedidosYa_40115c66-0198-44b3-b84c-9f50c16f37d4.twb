      <column caption='N1 Flow Size' datatype='real' name='[Calculation_1490329120836378 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// We want the scale to always be 0 to 1.&#13;&#10;// Thus, we must adjust the flow size to account for...&#13;&#10;// ...the number of whitespaces.&#13;&#10;// Separate calc so it can be computed differently&#13;&#10;(SUM([nr_users])*(1 - SIZE()*[Calculation_604889763570143232]))/TOTAL(SUM([nr_users]))'>
