              <calculation class='tableau' formula='// Equal spacing along the X axis.&#13;&#10;([Path]-1)*[Calculation_987695734030151684]' />
            </column>
            <column caption='Max Densification Points' datatype='integer' datatype-customized='true' name='[Calculation_987695734025916417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Maximum number of points in our denisification data.&#13;&#10;[Parameters].[Parameter 4]' />
            </column>
            <column caption='X Spacing' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_987695734030151684]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Spacing between our x coordinates.&#13;&#10;// Squish ratio allows for fine-tune adjustments when sheets are not perfectly square on a dashboard.&#13;&#10;[Parameters].[Parameter 1]/([Calculation_987695734025916417]-1)' />
            </column>
            <column caption='Curve X' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_987695734030811141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Fake X point to feed into our curve formula (to get y).&#13;&#10;// Space our points out evenly across the correct range in order to produce a smooth curve.&#13;&#10;CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Sigmoid&quot; THEN  ([Path]-1)*(12/([Calculation_987695734025916417]-1))-6    // -6 to 6&#13;&#10;WHEN &quot;Sine&quot; THEN     ([Path]-1)*(3/([Calculation_987695734025916417]-1))-1.5   // -1.5 to 1.5&#13;&#10;ELSE                 ([Path]-1)/([Calculation_987695734025916417]-1)           // 0 to 1&#13;&#10;END' />
            </column>
            <column caption='N3 Flow Size' datatype='real' name='[Flow Size 1 (copy) 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// We want the scale to always be 0 to 1.&#13;&#10;// Thus, we must adjust the flow size to account for...&#13;&#10;// ...the number of whitespaces.&#13;&#10;// Separate calc so it can be computed differently&#13;&#10;(SUM([nr_users])*(1 - SIZE()*[N1 Whitespace (copy) 1]))/TOTAL(SUM([nr_users]))'>
                <table-calc ordering-type='Field'>
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[step_1]' />
