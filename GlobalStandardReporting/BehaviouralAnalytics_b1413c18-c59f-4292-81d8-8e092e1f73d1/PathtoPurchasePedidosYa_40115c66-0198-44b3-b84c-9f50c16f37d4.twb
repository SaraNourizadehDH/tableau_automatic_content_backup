            </column>
            <column caption='C1-2 Y Final' datatype='real' name='[X Final (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Final Y value.&#13;&#10;IF ISNULL(ATTR([step_1])) OR ATTR([step_1])=&quot;&quot; OR ISNULL(ATTR([step_2])) OR ATTR([step_2])=&quot;&quot; THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    CASE ATTR([Line])&#13;&#10;    WHEN &quot;Bottom&quot; THEN [Y Top Parallel (copy)]&#13;&#10;    WHEN &quot;Midline&quot; THEN [Calculation_1221882918444765184]&#13;&#10;    WHEN &quot;Top&quot; THEN [X Parallel (copy)]&#13;&#10;    END&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='C1-2 Y Top' datatype='real' name='[X Parallel (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Y coordinate for the parallel line.&#13;&#10;// Radius in our trig is [N1 Flow Size]/2&#13;&#10;IF [Calculation_738871858459418636] = 180 OR [Calculation_738871858459418636] = 360 THEN&#13;&#10;    // This is a horizontal line.&#13;&#10;    [Calculation_1221882918444765184]+[Calculation_1490329120836378 1]/2&#13;&#10;ELSE&#13;&#10;    [Calculation_1221882918444765184]+[Calculation_1490329120836378 1]/2*SIN(RADIANS([Calculation_738871858459418636]))&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='C1-2 X Bottom' datatype='real' name='[X Top Parallel (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// X coordinate for the bottom parallel line.&#13;&#10;ATTR([Calculation_987695734025609216])+[Calculation_1490329120836378 1]/2*COS(RADIANS([Top Angle (copy)]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='C1-2 Y Midline Previous' datatype='real' name='[Y (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Y coordinate for the previous point on the midpoint line.&#13;&#10;// Calc will give us the top of the curve, so we&apos;ll move down half to get to the midline.&#13;&#10;[Calculation_8950329121202785] + (([Calculation_5790329121624550] - [Calculation_8950329121202785])*ATTR([Sigmoid Y (copy)]))-[Calculation_1490329120836378 1]/2'>
