              <calculation class='tableau' formula='// Y coordinate for the parallel line.&#13;&#10;// Radius in our trig is [N1 Flow Size]/2&#13;&#10;IF [Top Angle (copy) 1 2] = 180 OR [Top Angle (copy) 1 2] = 360 THEN&#13;&#10;    // This is a horizontal line.&#13;&#10;    [Calculation_1221882918444765184 1 2]-[Flow Size 1 (copy) 1 1]/2&#13;&#10;ELSE&#13;&#10;    [Calculation_1221882918444765184 1 2]+[Flow Size 1 (copy) 1 1]/2*SIN(RADIANS([Top Angle (copy) 1 2]))&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
