              <calculation class='tableau' formula='// Get the previous point (to the left). Note: Primary point is Path-1 so + 1 = Path&#13;&#10;// Space our points out evenly across the correct range in order to produce a smooth curve.&#13;&#10;CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Sigmoid&quot; THEN  ([Path])*(12/([Calculation_987695734025916417]-1))-6    // -6 to 6&#13;&#10;WHEN &quot;Sine&quot; THEN     ([Path])*(3/([Calculation_987695734025916417]-1))-1.5   // -1.5 to 1.5&#13;&#10;ELSE                 ([Path])/([Calculation_987695734025916417]-1)           // 0 to 1&#13;&#10;END' />
