    <worksheet name='flow_s1 (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Tableau Bold' fontsize='20'>Equal Width Method</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PY-General-User-Path' name='federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Whitespace' datatype='real' name='[Parameter 1 1]' param-domain-type='range' role='measure' type='quantitative' value='0.615807903951976'>
              <calculation class='tableau' formula='0.615807903951976' />
              <range max='1.0' min='0.0' />
            </column>
            <column caption='Squish Ratio' datatype='real' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='0.48405797101449283'>
              <calculation class='tableau' formula='0.48405797101449283' />
            </column>
            <column caption='Curve Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Sigmoid&quot;'>
              <calculation class='tableau' formula='&quot;Sigmoid&quot;' />
            </column>
            <column caption='Max Points' datatype='integer' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='50'>
              <calculation class='tableau' formula='50' />
              <desc>
                <formatted-text>
                  <run>This is a static value</run>
                </formatted-text>
              </desc>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)'>
            <column caption='C1-2 Y Midline' datatype='real' name='[Calculation_1221882918444765184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Y coordinate of the midpoint line.&#13;&#10;// Calc will give us the top of the curve, so we&apos;ll move down half to get to the midline.&#13;&#10;[Calculation_8950329121202785] + (([Calculation_5790329121624550] - [Calculation_8950329121202785])*ATTR([Calculation_633600195921932290]))-[Calculation_1490329120836378 1]/2'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='C1-2 X Midline Next' datatype='real' name='[Calculation_1221882918446968834]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Get the next X value.&#13;&#10;[Calculation_987695734025609216]+[Calculation_987695734030151684]' />
            </column>
            <column caption='N1 Flow Size' datatype='real' name='[Calculation_1490329120836378 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// We want the scale to always be 0 to 1.&#13;&#10;// Thus, we must adjust the flow size to account for...&#13;&#10;// ...the number of whitespaces.&#13;&#10;// Separate calc so it can be computed differently&#13;&#10;(SUM([nr_users])*(1 - SIZE()*[Calculation_604889763570143232]))/TOTAL(SUM([nr_users]))'>
                <table-calc ordering-type='Field'>
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[step_1]' />
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[step_2]' />
                </table-calc>
              </calculation>
            </column>
            <column caption='N2 Index' datatype='integer' name='[Calculation_2320329132122533]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Separate index calc for Step 1 so it can be computed differently.&#13;&#10;INDEX()'>
                <table-calc ordering-type='Field'>
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[step_2]' />
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[step_1]' />
                </table-calc>
              </calculation>
            </column>
            <column caption='month' datatype='string' name='[Calculation_365284190685270017]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;year&apos;, [partition_date])) &#10;&#9;+ STR(&quot;-&quot;) &#10;&#9;+ IF DATEPART(&apos;month&apos;, [partition_date]) &lt; 10 THEN STR(&quot;0&quot;) ELSE STR(&quot;&quot;) END&#10;&#9;+ STR(DATEPART(&apos;month&apos;, [partition_date]))' />
            </column>
            <column caption='N2 Position' datatype='real' name='[Calculation_4020329132355237]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Position of each bar on step 2&#13;&#10;RUNNING_SUM([Flow Size 1 (copy)]) - [Flow Size 1 (copy)] + [Calculation_2320329132122533]*[N1 Whitespace (copy)] - [N1 Whitespace (copy)]/2'>
                <table-calc ordering-type='Field'>
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[step_2]' />
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[step_1]' />
                </table-calc>
              </calculation>
            </column>
            <column caption='C1-2 Slope Avg' datatype='real' name='[Calculation_487514725147701266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Average of the slopes connected to the current point.&#13;&#10;([Calculation_738871858447269888]+[Slope Next (copy)])/2'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='N2 Position Max' datatype='real' name='[Calculation_5790329121624550]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Top of each bar on step 2&#13;&#10;[Calculation_4020329132355237]+[Flow Size 1 (copy)]'>
                <table-calc ordering-type='Field'>
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[Step 2]' />
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[Step 1]' />
                </table-calc>
              </calculation>
            </column>
            <column caption='N1 Whitespace' datatype='real' name='[Calculation_604889763570143232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// We want to evenly distribute the spacing...&#13;&#10;// ...so that the flows stay the same size...&#13;&#10;// ...regardless of the number of bars on each side.&#13;&#10;// Separate calc for Step 1 so it can be computed differently.&#13;&#10;[Parameters].[Parameter 1 1]/SIZE()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Curve Y' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_633600195921932290]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Calculate the Y coordinate based on the curve&apos;s formula, using the primary point.&#13;&#10;CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Sigmoid&quot; THEN&#13;&#10;    1/(1+EXP(-[Calculation_987695734030811141]))&#13;&#10;&#13;&#10;WHEN &quot;Sine&quot; THEN&#13;&#10;    (SIN([Calculation_987695734030811141]) + 1)/2&#13;&#10;&#13;&#10;WHEN &quot;Cubic&quot; THEN&#13;&#10;    (IF [Calculation_987695734030811141]*2 &lt;= 1 THEN &#13;&#10;        ([Calculation_987695734030811141]*2)*([Calculation_987695734030811141]*2)*([Calculation_987695734030811141]*2) &#13;&#10;    ELSE &#13;&#10;        ((([Calculation_987695734030811141]*2)-2)*(([Calculation_987695734030811141]*2)-2)*(([Calculation_987695734030811141]*2)-2))+2 &#13;&#10;    END) / 2&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='C1-2 Slope Next' datatype='real' name='[Calculation_738871858447269888]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Slope of a line perpendicular to the line from the current point to the next.&#13;&#10;IF ROUND([Y Previous (copy)]-[Calculation_1221882918444765184],8) = 0 THEN&#13;&#10;    // Slope is 0&#13;&#10;    0&#13;&#10;ELSE&#13;&#10;    -1/(([Y Previous (copy)]-[Calculation_1221882918444765184])/(ATTR([Calculation_1221882918446968834])-ATTR([Calculation_987695734025609216])))&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='C1-2 X Top' datatype='real' name='[Calculation_738871858451017731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// X coordinate for the top parallel line.&#13;&#10;ATTR([Calculation_987695734025609216])+[Calculation_1490329120836378 1]/2*COS(RADIANS([Calculation_738871858459418636]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='C1-2 X Final' datatype='real' name='[Calculation_738871858454740996]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Final X value.&#13;&#10;IF ATTR([Path])=1 OR ATTR([Path])=50 THEN&#13;&#10;    // Address math precision issues and set to the standard start and end.&#13;&#10;    ATTR([Calculation_987695734025609216])&#13;&#10;ELSE&#13;&#10;    CASE ATTR([Line])&#13;&#10;    WHEN &quot;Bottom&quot; THEN [X Top Parallel (copy)]&#13;&#10;    WHEN &quot;Midline&quot; THEN ATTR([Calculation_987695734025609216])&#13;&#10;    WHEN &quot;Top&quot; THEN [Calculation_738871858451017731]&#13;&#10;    END&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='C1-2 Angle Top' datatype='real' name='[Calculation_738871858459418636]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Angle, in degrees, based on the slope, to get the top curve.&#13;&#10;180+DEGREES(ATAN([Calculation_487514725147701266]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Path Order' datatype='integer' name='[Calculation_738871858468892686]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Order of the points along the polygon.&#13;&#10;IF [Line]=&quot;Bottom&quot; THEN&#13;&#10;    // Order by the path.&#13;&#10;    [Path]&#13;&#10;ELSE&#13;&#10;    // Circling back to the beginning, so move backwards.&#13;&#10;    [Calculation_987695734025916417]*2-[Path]+1&#13;&#10;END' />
            </column>
            <column caption='N1 Position' datatype='real' name='[Calculation_7670329132300220]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Position of each bar on step 1&#13;&#10;RUNNING_SUM([Calculation_1490329120836378 1]) - [Calculation_1490329120836378 1] + [Calculation_8260329132018285]*[Calculation_604889763570143232] - [Calculation_604889763570143232]/2'>
                <table-calc ordering-type='Field'>
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[step_1]' />
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[step_2]' />
                </table-calc>
              </calculation>
            </column>
            <column caption='step_1_color' datatype='string' name='[Calculation_772437741685911552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [step_1]&#10;  WHEN &apos;category_page&apos; THEN &apos;Category Interaction&apos;&#10;  WHEN &apos;dmart_visited&apos; THEN &apos;Visiting Dmart&apos;&#10;  WHEN &apos;add_cart&apos; THEN &apos;Adding Item to Cart&apos;&#10;  WHEN &apos;product_details_page&apos; THEN &apos;PDP&apos;&#10;  WHEN &apos;search_clicked&apos; THEN &apos;Search Interaction&apos;&#10;  WHEN &apos;qc_hs&apos; THEN &apos;QC Homescreen&apos;&#10;  WHEN &apos;swimlane_interaction&apos; THEN &apos;Swimlane Interaction&apos;&#10;  WHEN &apos;banner_clicked&apos; THEN &apos;Banner Interaction&apos;&#10;  ELSE NULL&#10;END' />
            </column>
            <column caption='N1 Index' datatype='integer' name='[Calculation_8260329132018285]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Separate index calc for Step 1 so it can be computed differently.&#13;&#10;INDEX()'>
                <table-calc ordering-type='Field'>
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[step_1]' />
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[step_2]' />
                </table-calc>
              </calculation>
            </column>
            <column caption='N1 Position Max' datatype='real' name='[Calculation_8950329121202785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Top of each bar on step 1&#13;&#10;[Calculation_7670329132300220]+[Calculation_1490329120836378 1]'>
                <table-calc ordering-type='Field'>
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[Step 1]' />
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[Step 2]' />
                </table-calc>
              </calculation>
            </column>
            <column caption='C1-2 X Midline' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_987695734025609216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Equal spacing along the X axis.&#13;&#10;([Path]-1)*[Calculation_987695734030151684]' />
            </column>
            <column caption='Max Densification Points' datatype='integer' datatype-customized='true' name='[Calculation_987695734025916417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Maximum number of points in our denisification data.&#13;&#10;[Parameters].[Parameter 4]' />
            </column>
            <column caption='X Spacing' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_987695734030151684]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Spacing between our x coordinates.&#13;&#10;// Squish ratio allows for fine-tune adjustments when sheets are not perfectly square on a dashboard.&#13;&#10;[Parameters].[Parameter 1]/([Calculation_987695734025916417]-1)' />
            </column>
            <column caption='Curve X' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_987695734030811141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Fake X point to feed into our curve formula (to get y).&#13;&#10;// Space our points out evenly across the correct range in order to produce a smooth curve.&#13;&#10;CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Sigmoid&quot; THEN  ([Path]-1)*(12/([Calculation_987695734025916417]-1))-6    // -6 to 6&#13;&#10;WHEN &quot;Sine&quot; THEN     ([Path]-1)*(3/([Calculation_987695734025916417]-1))-1.5   // -1.5 to 1.5&#13;&#10;ELSE                 ([Path]-1)/([Calculation_987695734025916417]-1)           // 0 to 1&#13;&#10;END' />
            </column>
            <column caption='N2 Flow Size' datatype='real' name='[Flow Size 1 (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// We want the scale to always be 0 to 1.&#13;&#10;// Thus, we must adjust the flow size to account for...&#13;&#10;// ...the number of whitespaces.&#13;&#10;// Separate calc so it can be computed differently&#13;&#10;(SUM([nr_users])*(1 - SIZE()*[N1 Whitespace (copy)]))/TOTAL(SUM([nr_users]))'>
                <table-calc ordering-type='Field'>
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[step_1]' />
                  <order field='[federated.1htca5s0ze74ij10v1t1x1uscpu1 (copy)].[step_2]' />
                </table-calc>
              </calculation>
            </column>
            <column datatype='string' name='[Line]' role='dimension' type='nominal' />
            <column caption='N2 Whitespace' datatype='real' name='[N1 Whitespace (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// We want to evenly distribute the spacing...&#13;&#10;// ...so that the flows stay the same size...&#13;&#10;// ...regardless of the number of bars on each side.&#13;&#10;// Separate calc for Step 2 so it can be computed differently.&#13;&#10;[Parameters].[Parameter 1 1]/SIZE()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='C1-2 X Midline Previous' datatype='real' name='[Next X (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Get the previous X value.&#13;&#10;[Calculation_987695734025609216]-[Calculation_987695734030151684]' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[Path]' role='dimension' type='ordinal' />
            <column caption='Curve X Previous' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Sigmoid X (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Get the previous point (to the left). Note: Primary point is Path-1 so - 1 = Pa&#13;&#10;// Space our points out evenly across the correct range in order to produce a smooth curve.&#13;&#10;CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Sigmoid&quot; THEN  ([Path]-2)*(12/([Calculation_987695734025916417]-1))-6    // -6 to 6&#13;&#10;WHEN &quot;Sine&quot; THEN     ([Path]-2)*(3/([Calculation_987695734025916417]-1))-1.5   // -1.5 to 1.5&#13;&#10;ELSE                 ([Path]-2)/([Calculation_987695734025916417]-1)           // 0 to 1&#13;&#10;END' />
            </column>
            <column caption='Curve X Next' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Sigmoid X Previous (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Get the previous point (to the left). Note: Primary point is Path-1 so + 1 = Path&#13;&#10;// Space our points out evenly across the correct range in order to produce a smooth curve.&#13;&#10;CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Sigmoid&quot; THEN  ([Path])*(12/([Calculation_987695734025916417]-1))-6    // -6 to 6&#13;&#10;WHEN &quot;Sine&quot; THEN     ([Path])*(3/([Calculation_987695734025916417]-1))-1.5   // -1.5 to 1.5&#13;&#10;ELSE                 ([Path])/([Calculation_987695734025916417]-1)           // 0 to 1&#13;&#10;END' />
            </column>
            <column caption='Curve Y Next' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Sigmoid Y (copy) (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Calculate the Y coordinate based on the curve&apos;s formula, using the next point (to the right).&#13;&#10;CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Sigmoid&quot; THEN&#13;&#10;    1/(1+EXP(-[Sigmoid X Previous (copy)]))&#13;&#10;&#13;&#10;WHEN &quot;Sine&quot; THEN&#13;&#10;    (SIN([Sigmoid X Previous (copy)]) + 1)/2&#13;&#10;&#13;&#10;WHEN &quot;Cubic&quot; THEN&#13;&#10;    (IF [Sigmoid X Previous (copy)]*2 &lt;= 1 THEN &#13;&#10;        ([Sigmoid X Previous (copy)]*2)*([Sigmoid X Previous (copy)]*2)*([Sigmoid X Previous (copy)]*2) &#13;&#10;    ELSE &#13;&#10;        ((([Sigmoid X Previous (copy)]*2)-2)*(([Sigmoid X Previous (copy)]*2)-2)*(([Sigmoid X Previous (copy)]*2)-2))+2 &#13;&#10;    END) / 2&#13;&#10;END' />
            </column>
            <column caption='Curve Y Previous' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Sigmoid Y (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Calculate the Y coordinate based on the curve&apos;s formula, using the previous point (to the left).&#13;&#10;CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &quot;Sigmoid&quot; THEN&#13;&#10;    1/(1+EXP(-[Sigmoid X (copy)]))&#13;&#10;&#13;&#10;WHEN &quot;Sine&quot; THEN&#13;&#10;    (SIN([Sigmoid X (copy)]) + 1)/2&#13;&#10;&#13;&#10;WHEN &quot;Cubic&quot; THEN&#13;&#10;    (IF [Sigmoid X (copy)]*2 &lt;= 1 THEN &#13;&#10;        ([Sigmoid X (copy)]*2)*([Sigmoid X (copy)]*2)*([Sigmoid X (copy)]*2) &#13;&#10;    ELSE &#13;&#10;        ((([Sigmoid X (copy)]*2)-2)*(([Sigmoid X (copy)]*2)-2)*(([Sigmoid X (copy)]*2)-2))+2 &#13;&#10;    END) / 2&#13;&#10;END' />
            </column>
            <column caption='C1-2 Slope Previous' datatype='real' name='[Slope Next (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Slope of a line perpendicular to the line from the current point to the previous.&#13;&#10;IF ROUND([Calculation_1221882918444765184]-[Y (copy)],8) = 0 THEN&#13;&#10;    // Slope is 0&#13;&#10;    0&#13;&#10;ELSE&#13;&#10;    -1/(([Calculation_1221882918444765184]-[Y (copy)])/(ATTR([Calculation_987695734025609216])-ATTR([Next X (copy)])))&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
