            <column caption='Select Metric G' datatype='string' folder-name='Test Details Dash' name='[Select Metric D (copy) (copy)_697213567139344403]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Offline Duration&quot;'>
              <calculation class='tableau' formula='&quot;% Offline Duration&quot;' />
              <aliases>
                <alias key='&quot;\# Fail Orders Closed&quot;' value='... # Failed Orders Closed' />
