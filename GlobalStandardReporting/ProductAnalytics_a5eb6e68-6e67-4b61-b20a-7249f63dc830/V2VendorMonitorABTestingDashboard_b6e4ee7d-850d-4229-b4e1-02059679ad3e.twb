            <column caption='% Outside Delivery Area Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy) (copy)_2771261912663171073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_outside_delivery_area_ct])&#10;/ SUM([total_orders])' />
            </column>
            <column caption='% Technical Problem Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_2771261912663158784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_technical_problem_ct])&#10;/ SUM([total_orders])' />
            </column>
            <column caption='% Unreachable Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_697213567095914498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_unreachable])&#10;/ SUM([total_orders])' />
            </column>
            <column caption='% Closed Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_697213567096041475]' role='measure' type='quantitative'>
