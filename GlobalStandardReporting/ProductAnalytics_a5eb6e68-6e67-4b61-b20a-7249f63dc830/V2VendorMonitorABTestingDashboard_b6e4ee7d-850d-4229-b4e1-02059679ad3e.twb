          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vm_ab_testing_tool (annie)' name='federated.19p33o81p5jsf318cxv890gl3h6s' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Weekly' caption='Select Date Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;week&quot;'>
              <calculation class='tableau' formula='&quot;week&quot;' />
              <aliases>
                <alias key='&quot;day&quot;' value='Daily' />
                <alias key='&quot;week&quot;' value='Weekly' />
              </aliases>
            </column>
            <column alias='Line Charts' caption='Select View' datatype='string' folder-name='Test Details Dash' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Line Charts&quot;'>
              <calculation class='tableau' formula='&quot;Line Charts&quot;' />
              <aliases>
                <alias key='&quot;Line Charts&quot;' value='Line Charts' />
              </aliases>
            </column>
            <column caption='Select Metric E' datatype='string' folder-name='Test Details Dash' name='[Select Metric C (copy)_697213567136849935]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Vendor Fail Rate&quot;'>
              <calculation class='tableau' formula='&quot;% Vendor Fail Rate&quot;' />
              <aliases>
                <alias key='&quot;\# Fail Orders Closed&quot;' value='... # Failed Orders Closed' />
                <alias key='&quot;\# Fail Orders Item Unavailable&quot;' value='... # Failed Orders Item Unavailable' />
                <alias key='&quot;\# Fail Orders No Response&quot;' value='... # Failed Orders No Response' />
                <alias key='&quot;\# Fail Orders Too Busy&quot;' value='... # Failed Orders Too Busy' />
                <alias key='&quot;\# Fail Orders Unknown&quot;' value='... # Failed Orders Unknown' />
                <alias key='&quot;\# Fail Orders Unreachable&quot;' value='... # Failed Orders Unreachable' />
                <alias key='&quot;\# Fail Orders Vendor&quot;' value='# Failed Orders Vendor' />
                <alias key='&quot;\# Orders&quot;' value='# Total Orders' />
                <alias key='&quot;\# Vendors&quot;' value='# Total Vendors' />
                <alias key='&quot;\% Closed Fail Rate&quot;' value='... % Closed Fail Rate' />
                <alias key='&quot;\% Item Unavailable Fail Rate&quot;' value='... % Item Unavailable Fail Rate' />
                <alias key='&quot;\% No Response Fail Rate&quot;' value='... % No Response Fail Rate' />
                <alias key='&quot;\% Too Busy Fail Rate&quot;' value='... % Too Busy Fail Rate' />
                <alias key='&quot;\% Unknown Fail Rate&quot;' value='... % Unknown Fail Rate' />
                <alias key='&quot;\% Unreachable Fail Rate&quot;' value='... % Unreachable Fail Rate' />
                <alias key='&quot;Average At Vendor Time Cleaned&quot;' value='Avg At Vendor Time Cleaned Min' />
                <alias key='&quot;Slots Duration Mins&quot;' value='Schedule Duration Mins' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.19p33o81p5jsf318cxv890gl3h6s'>
            <column caption='% No Response Fail Rate' datatype='real' default-format='p0.00%' name='[% Closed Fail Rate (copy)_697213567096147972]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_no_response])&#10;/ SUM([total_orders])' />
            </column>
            <column caption='% Outside Delivery Area Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy) (copy)_2771261912663171073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_outside_delivery_area_ct])&#10;/ SUM([total_orders])' />
            </column>
            <column caption='% Technical Problem Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_2771261912663158784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_technical_problem_ct])&#10;/ SUM([total_orders])' />
            </column>
            <column caption='% Unreachable Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_697213567095914498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_unreachable])&#10;/ SUM([total_orders])' />
            </column>
            <column caption='% Closed Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_697213567096041475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_closed])&#10;/ SUM([total_orders])' />
            </column>
            <column caption='% Too Busy Fail Rate' datatype='real' default-format='p0.00%' name='[% No Response Fail Rate (copy)_697213567096266757]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_too_busy])&#10;/ SUM([total_orders])' />
            </column>
            <column caption='% Unknown Fail Rate' datatype='real' default-format='p0.00%' name='[% Too Busy Fail Rate (copy)_697213567096385542]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_reason_unknown])&#10;/ SUM([total_orders])' />
            </column>
            <column caption='% Item Unavailable Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_697213567095623681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_item_unavailable])&#10;/ SUM([total_orders])' />
            </column>
            <column caption='% Vendor Late Over 15 Min' datatype='real' default-format='p0.00%' name='[% Vendor Late Over 10 Min (copy)_2072922487415074816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_vendor_late_over_15]) &#10;/ SUM([count_vendor_late_orders])' />
            </column>
            <column caption='_line chart vs. tabular' datatype='string' name='[Calculation_1661687575146024960]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
            </column>
            <column caption='_Metric D View' datatype='string' datatype-customized='true' name='[Calculation_1661687575163449347]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Select Metric C (copy)_697213567136849935]' />
            </column>
            <column caption='# Vendors' datatype='integer' name='[Calculation_1661687575479619592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;day&apos; THEN [vendors]&#10;ELSE INT(NULL)&#10;END' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_697213567095422976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_vendor])&#10;/ SUM([total_orders])' />
            </column>
            <column caption='Avg At Vendor Time Cleaned Min' datatype='real' default-format='n#,##0.00&quot; &quot;;-#,##0.00&quot; &quot;' name='[Calculation_697213567103930376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([sum_at_vendor_time_cleaned])&#10;/ SUM([count_at_vendor_time_cleaned_orders]))/60' />
            </column>
            <column caption='% Offline Duration' datatype='real' default-format='p0.00%' name='[Calculation_697213567104634890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([offline_duration_mins])/SUM([slots_duration_mins])' />
            </column>
            <column caption='% Vendor Late Over 10 Min' datatype='real' default-format='p0.00%' name='[Calculation_697213567151595544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([count_vendor_late_over_10]) &#10;/ SUM([count_vendor_late_orders])' />
            </column>
            <column caption='[Subtable] Date Level Filter' datatype='boolean' name='[Calculation_697213567186141211]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &apos;day&apos; THEN [subtable] = &apos;kpis daily&apos;&#10;WHEN &apos;week&apos; THEN [subtable] = &apos;kpis weekly&apos;&#10;END' />
            </column>
            <column caption='Metric E' datatype='real' name='[Metric C (copy)_697213567148757014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Select Metric C (copy)_697213567136849935]&#10;WHEN &apos;# Vendors&apos; THEN SUM([Calculation_1661687575479619592])&#10;WHEN &apos;# Actioned Vendors&apos; THEN SUM([actioned_vendors])&#10;WHEN &apos;# Successful Orders&apos; THEN SUM([successful_orders])&#10;WHEN &apos;% Offline Duration&apos; THEN [Calculation_697213567104634890]&#10;WHEN &apos;% Vendor Fail Rate&apos; THEN [Calculation_697213567095422976]&#10;WHEN &apos;% Vendor Late Over 10 Min&apos; THEN [Calculation_697213567151595544]&#10;WHEN &apos;% Vendor Late Over 15 Min&apos; THEN [% Vendor Late Over 10 Min (copy)_2072922487415074816]&#10;WHEN &apos;% Item Unavailable Fail Rate&apos; THEN [% Vendor Fail Rate (copy)_697213567095623681]&#10;WHEN &apos;% Unreachable Fail Rate&apos; THEN [% Item Unavailable Fail Rate (copy)_697213567095914498]&#10;WHEN &apos;% Too Busy Fail Rate&apos; THEN [% No Response Fail Rate (copy)_697213567096266757]&#10;WHEN &apos;% No Response Fail Rate&apos; THEN [% Closed Fail Rate (copy)_697213567096147972]&#10;WHEN &apos;% Closed Fail Rate&apos; THEN [% Item Unavailable Fail Rate (copy)_697213567096041475]&#10;WHEN &apos;% Unknown Fail Rate&apos; THEN [% Too Busy Fail Rate (copy)_697213567096385542]&#10;WHEN &apos;% Outside Delivery Area Fail Rate&apos; THEN [% Item Unavailable Fail Rate (copy) (copy)_2771261912663171073]&#10;WHEN &apos;% Technical Problem Fail Rate&apos; THEN [% Item Unavailable Fail Rate (copy)_2771261912663158784]&#10;WHEN &apos;Slots Duration Mins&apos; THEN SUM([slots_duration_mins])&#10;WHEN &apos;Offline Duration Mins&apos; THEN SUM([offline_duration_mins])&#10;WHEN &apos;Average At Vendor Time Cleaned&apos; THEN [Calculation_697213567103930376]&#10;WHEN &apos;# Orders&apos; THEN SUM([total_orders])&#10;WHEN &apos;# Fail Orders Vendor&apos; THEN SUM([fail_orders_vendor])&#10;WHEN &apos;# Fail Orders Unreachable&apos; THEN SUM([fail_orders_unreachable])&#10;WHEN &apos;# Fail Orders Too Busy&apos; THEN SUM([fail_orders_too_busy])&#10;WHEN &apos;# Fail Orders Item Unavailable&apos; THEN SUM([fail_orders_item_unavailable])&#10;WHEN &apos;# Fail Orders No Response&apos; THEN SUM([fail_orders_no_response])&#10;WHEN &apos;# Fail Orders Closed&apos; THEN SUM([fail_orders_closed])&#10;WHEN &apos;# Fail Orders Unknown&apos; THEN SUM([fail_orders_reason_unknown])&#10;END' />
            </column>
