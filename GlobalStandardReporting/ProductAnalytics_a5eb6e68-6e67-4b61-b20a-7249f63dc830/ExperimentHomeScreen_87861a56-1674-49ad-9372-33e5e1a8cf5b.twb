          <datasource-dependencies datasource='federated.0hr6f8u087m4kg1bqrbfm17yze5s'>
            <column caption='% Offline Duration' datatype='real' default-format='p0.000%' name='[%  Live Order Inquiries Contact Rate    (copy)_4868320897011572743]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([offline_duration])&#10;    /&#10;    SUM([schedule_duration])' />
            </column>
            <column caption='Closed Fail Rate Delta' datatype='real' name='[Calculation_138133844993904643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(   // varient A&#10;    (SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [closed_failed_vendor] END)&#10;      / SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END) &#10;     ) &#10;    &#10;/&#10;  // Baseline&#10;    (SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [closed_failed_vendor] END)&#10;    / SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END) &#10;    )&#10;)&#10;- 1' />
            </column>
            <column caption='Offline Duration Hours' datatype='real' name='[Calculation_1688498016992112640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[offline_duration]/3600' />
            </column>
            <column caption='_granularity_filter' datatype='boolean' name='[Calculation_4565524148946161665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &quot;Daily&quot; THEN [date_type] = &quot;Daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [date_type] = &quot;Weekly&quot;&#10;&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_4565524148946345986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date_local]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date_local]))+&quot;-W&quot;+STR([weeks])&#10;END' />
            </column>
            <column caption='_view_charts_or_tab' datatype='string' name='[Calculation_4565524149402353741]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
            </column>
            <column caption='% Offline Duration Delta' datatype='real' name='[Fail Rate Delta (copy) (copy) (copy) (copy) (copy) (copy)_1736700606762700805]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(   // varient A&#10;    (SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [offline_duration] END)&#10;      / SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [schedule_duration] END) &#10;     ) &#10;    &#10;/&#10;  // Baseline&#10;    (SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [offline_duration] END)&#10;    / SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [schedule_duration] END) &#10;    )&#10;)&#10;- 1' />
