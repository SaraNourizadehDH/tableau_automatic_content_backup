            <column caption='%  Check in Duration (∆ Divergence)' datatype='real' name='[% Offline Duration (∆ Divergence) (copy)_133419188892143616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Variant A&apos; AND [rollout_phase] = &apos;POST&apos; THEN [check_in_required_duration] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Variant A&apos; AND [rollout_phase] = &apos;POST&apos; THEN [schedule_duration] END)&#10;    })&#10;&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [check_in_required_duration] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [schedule_duration] END)&#10;    })&#10;&#10;    - 1&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Variant A&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [check_in_required_duration] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Variant A&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [schedule_duration] END)&#10;    })&#10;    /&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [check_in_required_duration] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [schedule_duration] END)&#10;    })&#10;    - 1&#10;)' />
            </column>
            <column caption='% Item Unavailable Fail Rate (∆ Divergence)' datatype='real' name='[% Unreachable Fail Rate (∆ Divergence) (copy)_2146317098877333509]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Variant A&apos; AND [rollout_phase] = &apos;POST&apos; THEN [item_unavailable_failed_vendor] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Variant A&apos; AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [item_unavailable_failed_vendor] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    - 1&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Variant A&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [item_unavailable_failed_vendor] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Variant A&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    /&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [item_unavailable_failed_vendor] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    - 1&#10;)' />
            </column>
            <column caption='% Vendor Contact Rate (∆ Divergence)' datatype='real' name='[% Vendor Fail Rate (∆ Divergence) (copy) (copy)_4565524149078888456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Variant A&apos; AND [rollout_phase] = &apos;POST&apos; THEN [vendor_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Variant A&apos; AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [vendor_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    - 1&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Variant A&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [vendor_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Variant A&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    /&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [vendor_contacts] END)&#10;    /&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    - 1&#10;)' />
            </column>
            <column caption='_granularity_filter' datatype='boolean' name='[Calculation_4565524148946161665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &quot;Daily&quot; THEN [date_type] = &quot;Daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [date_type] = &quot;Weekly&quot;&#10;&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_4565524148946345986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date_local]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date_local]))+&quot;-W&quot;+STR([weeks])&#10;END' />
