    <worksheet name='Pre Variant-Baseline % Point Diff (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='edit_button_experiment+ (Multiple Connections)' name='federated.0hr6f8u087m4kg1bqrbfm17yze5s' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Date Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hr6f8u087m4kg1bqrbfm17yze5s'>
            <column caption='Orders (∆ Divergence)' datatype='real' name='[%  Simple Flow Orders (∆ Divergence) (copy)_4565524149299990563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#10;    SUM({ INCLUDE [date_type]:&#10; &#10;    SUM(IF [experiment_group] = &apos;Variant A&apos; AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    /&#10;&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;POST&apos; THEN [orders] END)&#10;    })&#10;&#10;    - 1&#10;)&#10;-&#10;(&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Variant A&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    /&#10;    SUM({ INCLUDE [date_type]:&#10;    SUM(IF [experiment_group] = &apos;Baseline&apos; AND [rollout_phase] = &apos;PRE&apos; THEN [orders] END)&#10;    })&#10;    - 1&#10;)' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_4565524149295542293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% What&apos;s New Vendor Adoption' datatype='real' name='[% MAS Vendor Adoption (copy) (copy) (copy)_1953717865382309899]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_vendors_clicked_what_is_new]) / SUM ([vendors])' />
            </column>
            <column caption='% Performance Vendor Adoption' datatype='real' name='[% MAS Vendor Adoption (copy) (copy)_1953717865382301706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_vendors_clicked_performance]) / SUM ([vendors])' />
            </column>
            <column caption='% Help Center Vendor Adoption' datatype='real' name='[% MAS Vendor Adoption (copy)_1953717865382289417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_vendors_clicked_help_center]) / SUM ([vendors])' />
            </column>
            <column caption='% Vendor Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Fail Rate (copy)_4565524149295779862]' role='measure' type='quantitative'>
