              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% What&apos;s New Vendor Adoption' datatype='real' name='[% MAS Vendor Adoption (copy) (copy) (copy)_1953717865382309899]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_vendors_clicked_what_is_new]) / SUM ([vendors])' />
            </column>
            <column caption='% Performance Vendor Adoption' datatype='real' name='[% MAS Vendor Adoption (copy) (copy)_1953717865382301706]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_vendors_clicked_performance]) / SUM ([vendors])' />
            </column>
            <column caption='% Help Center Vendor Adoption' datatype='real' name='[% MAS Vendor Adoption (copy)_1953717865382289417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_vendors_clicked_help_center]) / SUM ([vendors])' />
            </column>
            <column caption='% Vendor Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Fail Rate (copy)_4565524149295779862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_contacts])/SUM([orders])' />
            </column>
            <column caption='% MAS Vendor Adoption' datatype='real' name='[Calculation_1953717865332408320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([total_vendors_clicked_mas]) / SUM ([vendors])' />
            </column>
            <column caption='_granularity_filter' datatype='boolean' name='[Calculation_4565524148946161665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &quot;Daily&quot; THEN [date_type] = &quot;Daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [date_type] = &quot;Weekly&quot;&#10;&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_4565524148946345986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date_local]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date_local]))+&quot;-W&quot;+STR([weeks])&#10;END' />
            </column>
            <column caption='% Item Unavailable Fail Rate' datatype='real' name='[Item Unavailable Fail Rate Delta (copy)_2146317098869211140]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([item_unavailable_failed_vendor])&#10;      / SUM([orders])' />
            </column>
            <column caption='% Points Adoption ' datatype='real' name='[Points Delta (copy)_1953717865384857616]' role='measure' type='quantitative'>
