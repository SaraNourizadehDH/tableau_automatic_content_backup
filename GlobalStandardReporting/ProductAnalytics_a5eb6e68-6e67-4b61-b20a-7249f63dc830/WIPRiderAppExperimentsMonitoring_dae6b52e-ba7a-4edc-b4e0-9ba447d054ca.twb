        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='RiderApp_experiments_monitoring' name='federated.1aonq3h0tdx1pd172xt9419kf7qn' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='95 %' caption='Confidence Level' datatype='integer' name='[Granularity (copy)]' param-domain-type='list' role='measure' type='quantitative' value='95'>
              <calculation class='tableau' formula='95' />
              <aliases>
                <alias key='75' value='75 %' />
                <alias key='80' value='80 %' />
                <alias key='90' value='90 %' />
                <alias key='95' value='95 %' />
                <alias key='99' value='99 %' />
              </aliases>
            </column>
            <column caption='Metric' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Acceptance rate,\%&quot;'>
              <calculation class='tableau' formula='&quot;Acceptance rate,%&quot;' />
              <aliases>
                <alias key='&quot;Average rider accepting time (wo auto-accept)&quot;' value='Average rider accepting time (wo auto-accept)' />
              </aliases>
            </column>
            <column caption='Granularity' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1aonq3h0tdx1pd172xt9419kf7qn'>
            <column caption='Acceptance rate, % (wo auto-accepted deliveries)' datatype='real' default-format='p0.00%' name='[Acceptance rate, % (copy)_4066046833544024065]' role='measure' type='quantitative' visual-totals='Avg'>
              <calculation class='tableau' formula='SUM([rider_accepted_count_wo_auto_accept])/SUM([rider_notified_count_wo_auto_accept])' />
            </column>
            <column caption='Average rider accepting time (wo auto-accepted deliveries)  (minutes)' datatype='real' name='[Average time at customer (minutes) (copy)_4066046833542934528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([rider_accepting_time_wo_auto_accept_sum])/SUM([rider_accepting_time_wo_auto_accept_count]))/60' />
            </column>
            <column caption='Metric' datatype='real' name='[Calculation_1213509034655973379]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Acceptance rate,%&apos; &#10;THEN [Calculation_153122428265914369]&#10;ELSEIF [Parameters].[Parameter 1]= &apos;% of the late shifts (delay 5+ minutes)&apos; &#10;THEN [Calculation_153122428279980036]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time to start the shift&apos; &#10;THEN [Calculation_153122428279578627]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average effective delivery time&apos; &#10;THEN [Calculation_153122428285046796]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% of the unexcused no shows&apos; &#10;THEN [Calculation_153122428286054413]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average rider reaction time&apos; &#10;THEN [Calculation_153122428280696837]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time to vendor&apos; &#10;THEN [Calculation_153122428280696837]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time at vendor&apos;&#10;THEN [Calculation_153122428283719689]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time to customer&apos;&#10;THEN [Calculation_153122428284289034]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time at customer&apos;&#10;THEN [Calculation_153122428284579851]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Idle time,%&apos; &#10;THEN [Calculation_153122428296929295]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% of the start working errors&apos; &#10;THEN [Calculation_153122428281843718]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% of completed deliveries&apos; &#10;THEN [Calculation_153122428295172110]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average rider accepting time (wo auto-accept)&apos;&#10;THEN [Average time at customer (minutes) (copy)_4066046833542934528]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Acceptance rate, % (wo auto-accept)&apos;&#10;THEN [Acceptance rate, % (copy)_4066046833544024065]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Completed Deliveries&apos;&#10;THEN SUM([completed_deliveries])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Number of riders&apos;&#10;THEN [Calculation_153122428278726658]&#10;END' />
            </column>
            <column caption='Acceptance rate, %' datatype='real' default-format='p0.00%' name='[Calculation_153122428265914369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_accepted])/SUM([rider_notified])' />
            </column>
            <column caption='Number of riders' datatype='integer' name='[Calculation_153122428278726658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(STR([rider_id]) + [country_code])' />
            </column>
            <column caption='Average time  to start the shift (seconds)' datatype='real' name='[Calculation_153122428279578627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([to_start_shift_sum])/SUM([to_start_shift_count])' />
            </column>
            <column caption='% of the late shifts (delay more than 5 minutes)' datatype='real' name='[Calculation_153122428279980036]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([late_shifts_5])/SUM([shifts_done])' />
            </column>
            <column caption='Average rider reaction time (seconds)' datatype='real' name='[Calculation_153122428280696837]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([reaction_time_sec_sum])/SUM([reaction_time_sec_count])' />
            </column>
            <column caption='% of start working errors' datatype='real' name='[Calculation_153122428281843718]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([start_working_errors])/SUM([start_working_clicks])' />
            </column>
            <column caption='Average time at vendor (minutes)' datatype='real' name='[Calculation_153122428283719689]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([at_vendor_time_sum])/SUM([at_vendor_time_count]))/60' />
            </column>
            <column caption='Average time to customer (minutes)' datatype='real' name='[Calculation_153122428284289034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([to_customer_time_sum])/SUM([to_customer_time_count]))/60' />
            </column>
            <column caption='Average time at customer (minutes)' datatype='real' name='[Calculation_153122428284579851]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([at_customer_time_sum])/SUM([at_customer_time_count]))/60' />
            </column>
            <column caption='Average effective delivery time (minutes)' datatype='real' name='[Calculation_153122428285046796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([effective_delivery_time_sum])/SUM([effective_delivery_time_count]))/60' />
            </column>
            <column caption='% of unexcused no shows' datatype='real' name='[Calculation_153122428286054413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([unexcused_no_shows])/SUM([all_shifts])' />
            </column>
            <column caption='% of completed delieveries' datatype='real' name='[Calculation_153122428295172110]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([completed_deliveries])/SUM([rider_accepted])' />
            </column>
            <column caption='Idle time, %' datatype='real' name='[Calculation_153122428296929295]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - (SUM([transition_busy_time])/SUM([transition_working_time]))' />
            </column>
            <column caption='Viz name' datatype='string' name='[Calculation_3425550508507922433]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Acceptance rate,%&apos; &#10;THEN &apos;Dynamics of the acceptance rate, %&apos; &#10;ELSEIF [Parameters].[Parameter 1]= &apos;% of the late shifts (delay 5+ minutes)&apos; &#10;THEN &apos;Dynamics of the % of the late shifts (delay 5+ minutes)&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time to start the shift&apos; &#10;THEN &apos;Dynamics of the average time to start the shift (seconds)&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average effective delivery time&apos; &#10;THEN &apos;Dynamics of the average effective delivery time (minutes)&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% of the unexcused no shows&apos; &#10;THEN &apos;Dynamics of the % of the unexcused no shows&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average rider reaction time&apos; &#10;THEN &apos;Dynamics of the average rider reaction time (seconds)&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time to vendor&apos; &#10;THEN &apos;Dynamics of the average time to vendor (minutes)&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time at vendor&apos;&#10;THEN &apos;Dynamics of the average time at vendor (minutes)&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time to customer&apos;&#10;THEN &apos;Dynamics of the average time to customer (minutes)&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average time at customer&apos;&#10;THEN &apos;Dynamics of the average time at customer (minutes)&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Idle time,%&apos; &#10;THEN &apos;Dynamics of the idle time, %&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% of the start working errors&apos; &#10;THEN  &apos;Dynamics of the % of start worling errors&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;% of completed deliveries&apos; &#10;THEN &apos;Dynamics of the % of completed deliveries&apos;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Average rider accepting time (wo auto-accept)&apos;&#10;THEN &apos;Dynamics of the average rider accepting time (wo auto-accepted deliveries)&apos; &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Acceptance rate, % (wo auto-accept)&apos;&#10;THEN &apos;Dynamics of the acceptance rate, % (wo auto-accepted deliveries)&apos; &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Completed Deliveries&apos;&#10;THEN &apos;Dynamics of the completed deliveries&apos; &#10;ELSEIF [Parameters].[Parameter 1] = &apos;Number of riders&apos;&#10;THEN &apos;Dynamics of the number of riders&apos; &#10; END' />
            </column>
            <column aggregation='Count' caption='Date' datatype='date' datatype-customized='true' name='[Calculation_439030637345693706]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF [Parameters].[Parameter 2] = &apos;Daily&apos; &#10;THEN DATETRUNC(&apos;day&apos;,[report_date])&#10;ELSE DATETRUNC(&apos;week&apos;,[report_date]) END)' />
            </column>
            <column caption='Metric Average' datatype='real' name='[Calculation_6700652616567758849]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ INCLUDE [rider_id], [Calculation_439030637345693706]: [Calculation_1213509034655973379]})' />
            </column>
            <column caption='CI - Upper' datatype='real' name='[Calculation_6700652616568844291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6700652616567758849] + [Calculation_6700652616618758151] * [Metric Average (copy)_6700652616568528898]' />
            </column>
            <column caption='CI - Width' datatype='real' name='[Calculation_6700652616570720261]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6700652616568844291] - [Upper CI (copy)_6700652616568999940]' />
            </column>
            <column caption='z-statistic' datatype='real' name='[Calculation_6700652616618758151]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Granularity (copy)]&#10;WHEN 75 THEN 1.15&#10;WHEN 80 THEN 1.28&#10;WHEN 90 THEN 1.65&#10;WHEN 95 THEN 1.96&#10;WHEN 99 THEN 2.58&#10;END' />
            </column>
            <column caption='UPPER(REPLACE([Viz name], &quot;Dynamics of the&quot;, &quot;&quot;))' datatype='string' name='[Calculation_6700652616621445134]' role='dimension' type='nominal' user:unnamed='CI'>
              <calculation class='tableau' formula='UPPER(REPLACE([Calculation_3425550508507922433], &quot;Dynamics of the&quot;, &quot;&quot;))' />
            </column>
            <column caption='Metric Standard Error' datatype='real' name='[Metric Average (copy)_6700652616568528898]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='STDEV({ INCLUDE [rider_id], [Calculation_439030637345693706]: [Calculation_1213509034655973379]}) / SQRT(COUNT({ INCLUDE [rider_id], [Calculation_439030637345693706]: [Calculation_1213509034655973379]}))' />
            </column>
            <column caption='CI - Lower' datatype='real' name='[Upper CI (copy)_6700652616568999940]' role='measure' type='quantitative'>
