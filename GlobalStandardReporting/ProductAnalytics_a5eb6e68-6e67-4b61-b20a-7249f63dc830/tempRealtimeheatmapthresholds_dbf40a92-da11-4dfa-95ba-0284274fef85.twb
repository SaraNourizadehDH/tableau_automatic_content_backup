      <column caption='Values' datatype='integer' name='[Calculation_3899413637498740736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(STR([h3_index]) + STR([ts]))' />
      </column>
      <column caption='Demand level' datatype='string' name='[Calculation_3899413637500977153]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [zone_demand_percentile] &gt; [Parameters].[Parameter 2] THEN &apos;Very high demand&apos;&#10;ELSEIF [zone_demand_percentile] &gt; [Parameters].[Parameter 3] THEN &apos;High demand&apos;&#10;ELSEIF [zone_demand_percentile] &gt; [Parameters].[Parameter 4] THEN &apos;Moderate demand&apos;&#10;ELSE &apos;Low demand&apos; END' />
      </column>
      <column caption='Orders per rider' datatype='real' name='[Calculation_3899413637505208323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND([demand_per_rider],1)' />
      </column>
      <column caption='Demand level without moderate' datatype='string' name='[Calculation_3899413637507010565]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [zone_demand_percentile] &gt; 0.6 THEN &apos;Very high demand&apos;&#10;ELSEIF [zone_demand_percentile] &gt; 0 AND [zone_demand_percentile] &lt;= 0.6 THEN &apos;Moderate demand&apos;&#10;ELSE &apos;Low demand&apos; END' />
      </column>
      <column caption='Hour' datatype='integer' name='[Calculation_3899413637510500360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;,[ts])' />
      </column>
      <column caption='Demand level before filtering' datatype='string' name='[Calculation_4032832776495951872]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [zone_demand_percentile1] &gt; [Parameters].[Parameter 2] THEN &apos;Very high demand&apos;&#10;ELSEIF [zone_demand_percentile1] &gt; [Parameters].[Parameter 3] THEN &apos;High demand&apos;&#10;ELSEIF [zone_demand_percentile1] &gt; [Parameters].[Parameter 4]  THEN &apos;Moderate demand&apos;&#10;ELSE &apos;Low demand&apos; END' />
      </column>
      <column caption='Metric value' datatype='string' name='[Calculation_4032832776496676865]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Demand level before filtering&apos; THEN [Calculation_4032832776495951872]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Demand level after filtering&apos; THEN [Calculation_3899413637500977153] END' />
      </column>
