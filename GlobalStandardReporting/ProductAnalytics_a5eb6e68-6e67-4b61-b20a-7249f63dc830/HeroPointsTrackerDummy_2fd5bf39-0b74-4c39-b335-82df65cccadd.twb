      <column caption='Vendor Fail Rate' datatype='real' name='[Calculation_567946199669641216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([vendor_failed_orders])/2/SUM([orders])' />
      </column>
      <column caption='Total Points per Vendor' datatype='integer' name='[Calculation_567946199677792258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [vendor]: SUM([points])}' />
      </column>
      <column caption='Points Buckets' datatype='string' name='[Calculation_567946199677911043]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_567946199677792258] &lt;= 100 THEN &quot;0-100&quot;&#10;ELSEIF [Calculation_567946199677792258] &lt;= 500 THEN &quot;100-500&quot;&#10;ELSEIF [Calculation_567946199677792258] &lt;= 1000 THEN &quot;500-1000&quot;&#10;ELSEIF [Calculation_567946199677792258] &lt;= 5000 THEN &quot;1000-5000&quot;&#10;ELSEIF [Calculation_567946199677792258] &lt;= 10000 THEN &quot;5000-10000&quot;&#10;ELSEIF [Calculation_567946199677792258] &gt; 10000 THEN &quot;10000+&quot;&#10;END' />
      </column>
      <column caption='Checkin %' datatype='real' name='[Calculation_567946199680417796]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [pre_schedule_checkins] &gt; 0 THEN [vendor] END)/COUNTD([vendor])' />
      </column>
      <column caption='Points Percentile' datatype='string' name='[Calculation_567946199681667078]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_567946199677792258] &lt;= {FIXED : PERCENTILE([Calculation_567946199677792258], 0.5)} THEN &quot;0-50th&quot;&#10;ELSEIF [Calculation_567946199677792258] &lt;= {FIXED : PERCENTILE([Calculation_567946199677792258], 0.75)} THEN &quot;50-75th&quot;&#10;ELSEIF [Calculation_567946199677792258] &lt;= {FIXED : PERCENTILE([Calculation_567946199677792258], 0.95)} THEN &quot;75-95th&quot;&#10;ELSEIF [Calculation_567946199677792258] &lt;= {FIXED : PERCENTILE([Calculation_567946199677792258], 0.99)} THEN &quot;95-99th&quot;&#10;ELSEIF [Calculation_567946199677792258] &gt; {FIXED : PERCENTILE([Calculation_567946199677792258], 0.99)} THEN &quot;99-100th&quot;&#10;END' />
      </column>
      <column caption='Total Vendors' datatype='integer' name='[Calculation_567946199681908743]' role='measure' type='quantitative'>
