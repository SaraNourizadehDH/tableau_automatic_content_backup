    <worksheet name='Client Users Trend - GoDroid'>
      <table>
        <view>
          <datasources>
            <datasource caption='rps_gsr_client_dashboard_overview (rl)' name='federated.0nurclp1jtjeqy109scev0jxwtvf' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='Date granularity' datatype='string' datatype-customized='true' name='[Date Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;daily&quot;'>
              <calculation class='tableau' formula='&quot;daily&quot;' />
              <aliases>
                <alias key='&quot;daily&quot;' value='Daily' />
                <alias key='&quot;monthly&quot;' value='Monthly' />
                <alias key='&quot;weekly&quot;' value='Weekly' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0nurclp1jtjeqy109scev0jxwtvf'>
            <column caption='% Avg Daily GoDroid Users - Total' datatype='real' default-format='p0.00%' name='[# Avg Daily GoDroid Users - Total (copy)_2257781168742641665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5999005858155995137]/([Calculation1])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='# Avg Daily GoDroid Users - Total' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='TOTAL([Calculation_5999005858155995137])'>
                <table-calc ordering-type='Columns' />
              </calculation>
            </column>
            <column caption='NOT TODAY' datatype='boolean' name='[Calculation_2791035547604377600]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_date] &lt;&gt; TODAY()' />
            </column>
            <column caption='t-dimension' datatype='string' name='[Calculation_3549118028959612934]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Parameter] &#10;    WHEN &apos;daily&apos;&#10;        THEN STR([created_date])&#10;    WHEN &apos;weekly&apos;&#10;        THEN [created_week]&#10;    WHEN &apos;monthly&apos;&#10;        THEN [created_month]&#10;END' />
            </column>
            <column caption='# Avg Daily GoDroid Users' datatype='real' name='[Calculation_5999005858155995137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Date Parameter] = &apos;daily&apos;&#10;    THEN SUM([users_godroid_ct])&#10;ELSEIF [Parameters].[Date Parameter] = &apos;weekly&apos;&#10;    THEN SUM([users_godroid_ct])/7&#10;ELSEIF [Parameters].[Date Parameter] = &apos;monthly&apos;&#10;    THEN SUM([users_godroid_ct])/30&#10;END' />
            </column>
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Client version' datatype='string' name='[client_version]' role='dimension' type='nominal' />
            <column aggregation='None' caption='Country name' datatype='string' name='[country_name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date' datatype='date' name='[created_date]' role='dimension' type='ordinal' />
            <column caption='Created Month' datatype='string' name='[created_month]' role='dimension' type='nominal' />
            <column caption='Created Week' datatype='string' name='[created_week]' role='dimension' type='nominal' />
