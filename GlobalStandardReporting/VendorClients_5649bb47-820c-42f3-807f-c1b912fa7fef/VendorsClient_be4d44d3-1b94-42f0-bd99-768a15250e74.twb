          <datasource-dependencies datasource='federated.0nurclp1jtjeqy109scev0jxwtvf'>
            <column caption='# Avg Daily GoWin Users (Regional dimension)' datatype='real' name='[# Avg Daily GoDroid Users (Regional dimension) (copy)_4253720258343600130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([users_gowin_ct])/(DATEDIFF(&apos;day&apos;, MIN([created_date]), TODAY()))' />
            </column>
            <column caption='# Avg Daily GoDroid Users (Regional dimension)' datatype='real' name='[# Avg Daily GoDroid Users (copy)_4253720258343170048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([users_godroid_ct])/(DATEDIFF(&apos;day&apos;, MIN([created_date]), TODAY()))' />
