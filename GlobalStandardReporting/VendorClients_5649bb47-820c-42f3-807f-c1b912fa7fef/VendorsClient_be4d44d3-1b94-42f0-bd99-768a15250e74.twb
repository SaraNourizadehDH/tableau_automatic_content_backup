              <calculation class='tableau' formula='SUM([sound_selection_default_event_ct])/SUM([sound_selection_event_ct])' />
            </column>
            <column caption='% Sound volume changes (Medium)' datatype='real' name='[% Sound volume changes (High) (copy)_136374685820846081]' role='measure' type='quantitative'>
