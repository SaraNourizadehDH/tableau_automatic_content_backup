            <column caption='# Avg Daily GoWeb Users' datatype='real' name='[# GoDroid Users (copy)_488148032988585984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Date Parameter] = &apos;daily&apos;&#10;    THEN SUM([users_goweb_ct])&#10;ELSEIF [Parameters].[Date Parameter] = &apos;weekly&apos;&#10;    THEN SUM([users_goweb_ct])/7&#10;ELSEIF [Parameters].[Date Parameter] = &apos;monthly&apos; OR [Calculation_3340474687916752898] = &apos;regional dimension&apos;&#10;    THEN SUM([users_goweb_ct])/30&#10;END' />
            </column>
            <column caption='% GoWin Users' datatype='real' name='[% GoDroid Users (copy)_4236409551182319617]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5999005858156158978]/[Calculation_5999005858155798528]' />
            </column>
            <column caption='% GoWeb Users' datatype='real' name='[% GoWin Users (copy)_488148032989143042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# GoDroid Users (copy)_488148032988585984]/[Calculation_5999005858155798528]' />
            </column>
            <column caption='NOT TODAY' datatype='boolean' name='[Calculation_2791035547604377600]' role='dimension' type='nominal'>
