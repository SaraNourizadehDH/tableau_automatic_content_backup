              <calculation class='tableau' formula='SUM([vendor_unavailable_today_event_ct])/SUM([vendor_unavailable_event_ct])' />
            </column>
            <column caption='% Vendors having Unavailability for today' datatype='real' name='[% Vendors having Unavailability (copy)_1299007077525254148]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_unavailable_today_vendor_code_ct])/SUM([vendor_code_ct])' />
            </column>
            <column caption='% Vendors having Unavailability' datatype='real' name='[Calculation_1299007077525172227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_unavailable_vendor_id_ct])/SUM([vendor_code_ct])' />
            </column>
            <column caption='% Fail-rate (Product Unavailability)' datatype='real' name='[Calculation_1441011194073264130]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_product_unavailable_ct])/SUM([orders_ct])' />
            </column>
            <column caption='% Fail-rate (Selected)' datatype='real' name='[Calculation_1700390386918477824]' role='measure' type='quantitative'>
