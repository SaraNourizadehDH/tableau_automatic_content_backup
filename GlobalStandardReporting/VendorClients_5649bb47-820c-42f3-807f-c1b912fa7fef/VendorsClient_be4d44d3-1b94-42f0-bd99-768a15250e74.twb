            </column>
            <column caption='% Mixed Users' datatype='real' name='[Calculation_2791035547606155265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5999005858156642307]/[Calculation_5999005858155798528]' />
            </column>
            <column caption='_dimension_selector' datatype='string' name='[Calculation_3340474687916752898]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Date granularity (copy)_3340474687913746432]' />
            </column>
            <column caption='t-dimension' datatype='string' name='[Calculation_3549118028959612934]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Parameter] &#10;    WHEN &apos;daily&apos;&#10;        THEN STR([created_date])&#10;    WHEN &apos;weekly&apos;&#10;        THEN [created_week]&#10;    WHEN &apos;monthly&apos;&#10;        THEN [created_month]&#10;END' />
            </column>
            <column caption='% GoDroid Users' datatype='real' name='[Calculation_4236409551182204928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5999005858155995137]/[Calculation_5999005858155798528]' />
