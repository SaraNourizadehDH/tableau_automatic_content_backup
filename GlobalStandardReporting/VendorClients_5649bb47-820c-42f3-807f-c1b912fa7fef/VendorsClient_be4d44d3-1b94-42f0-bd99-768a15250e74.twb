      <column caption='% Fail-rate (Selected)' datatype='real' name='[Calculation_1700390386918477824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[%  Fail-rate (Selected) Parameter]&#10;    WHEN &apos;% Fail-rate&apos;&#10;        THEN [Calculation_2336805307756494860]&#10;    WHEN &apos;% Vendor Fail-rate&apos;&#10;        THEN [Calculation_2336805307739029507]&#10;    WHEN &apos;% Fail-rate (Too busy)&apos;&#10;        THEN [Calculation_2336805307737513986]&#10;    WHEN &apos;% Fail-rate (Closed)&apos;&#10;        THEN [Calculation_2336805307737243648]&#10;    WHEN &apos;% Fail-rate (No Response)&apos;&#10;        THEN [Calculation_2336805307737427969]&#10;END' />
      </column>
      <column caption='% Fail-rate (Closed)' datatype='real' name='[Calculation_2336805307737243648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_orders_closed_ct])/SUM([orders_ct])' />
      </column>
      <column caption='% Fail-rate (No Response)' datatype='real' name='[Calculation_2336805307737427969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_orders_no_response_ct])/SUM([orders_ct])' />
