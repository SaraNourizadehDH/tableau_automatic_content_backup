    <worksheet name='The Worst Entities with % Login fail-rate'>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gsr_client_dashboard_events (rl)' name='federated.1uub2471ffcv1q1elqh0g0puszky' />
          </datasources>
          <datasource-dependencies datasource='federated.1uub2471ffcv1q1elqh0g0puszky'>
            <column caption='% Vendor Fail-rate' datatype='real' name='[Calculation_2336805307739029507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_vendor_ct])/SUM([orders_ct])' />
            </column>
            <column caption='% Login fail-rate' datatype='real' name='[Calculation_2336805307752656900]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([login_failed_event_ct])/SUM([login_started_event_ct])' />
            </column>
            <column caption='% Login Fail-rate (Already Logged-in)' datatype='real' name='[Calculation_2336805307754082309]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([login_failed_already_loggedin_event_ct])/SUM([login_started_event_ct])' />
            </column>
            <column caption='% Login Fail-rate (Auth)' datatype='real' name='[Calculation_2336805307754336262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([login_failed_auth_event_ct])/SUM([login_started_event_ct])' />
            </column>
            <column caption='% Login Fail-rate (Manual)' datatype='real' name='[Calculation_2336805307754434567]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([login_failed_manual_event_ct])/SUM([login_started_event_ct])' />
            </column>
            <column caption='% Login Fail-rate (Token)' datatype='real' name='[Calculation_2336805307754643465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([login_failed_token_event_ct])/SUM([login_started_event_ct])' />
            </column>
            <column caption='% Login Fail-rate (UUID)' datatype='real' name='[Calculation_2336805307754741770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([login_failed_uuid_event_ct])/SUM([login_started_event_ct])' />
            </column>
            <column caption='% Fail-rate' datatype='real' name='[Calculation_2336805307756494860]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_ct])/SUM([orders_ct])' />
            </column>
            <column caption='# Users' datatype='integer' name='[Calculation_2336805307760644109]' role='measure' type='quantitative'>
