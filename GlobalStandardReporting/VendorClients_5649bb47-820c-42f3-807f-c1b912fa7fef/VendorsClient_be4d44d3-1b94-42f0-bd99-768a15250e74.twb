      <aliases enabled='yes' />
      <column caption='# Orders (Client Response Time)' datatype='integer' name='[# Orders (copy)_1752815098866380813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[order_ct]' />
      </column>
      <column caption='# Orders (Client Dispatch Time)' datatype='integer' name='[# Orders (copy)_1752815098866737166]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[order_ct]' />
      </column>
      <column caption='% Neutral Acceptance Orders ' datatype='real' default-format='p0.00%' name='[% Quick Acceptance Orders (copy)_671036378543169540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([neutral_acceptance_order_screen_ct])/SUM([quick_acceptance_order_screen_ct]+[neutral_acceptance_order_screen_ct])' />
      </column>
      <column caption='% Running Share (Neutral Acceptance Orders) ' datatype='real' default-format='p0.00%' name='[% Running Share (Quick Acceptance Orders) (copy)_671036378538979329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([neutral_acceptance_order_screen_ct]))/TOTAL(SUM([neutral_acceptance_order_screen_ct]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Quick Acceptance Orders' datatype='real' default-format='p0.00%' name='[% Running Share (Quick Acceptance Orders) (copy)_671036378542936067]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([quick_acceptance_order_screen_ct])/SUM([quick_acceptance_order_screen_ct]+[neutral_acceptance_order_screen_ct])' />
      </column>
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0fv8n3r0yulzzc10rpi6o0npb964].[usr:\% Quick Acceptance Orders (copy)_671036378543169540:qk]&quot;' value='Neutral Acceptance' />
          <alias key='&quot;[federated.0fv8n3r0yulzzc10rpi6o0npb964].[usr:\% Running Share (Quick Acceptance Orders) (copy)_671036378542936067:qk]&quot;' value='Quick Acceptance' />
        </aliases>
      </column>
      <column caption='% Running share # Orders' datatype='real' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([order_ct]))/TOTAL(SUM([order_ct]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Vendor Fail-rate' datatype='real' name='[Calculation_1693423886812717065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_order_vendor_ct])/SUM([order_ct])' />
      </column>
      <column caption='% Reconciled Orders (Customer Dialog)' datatype='real' name='[Calculation_1875608531744489472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reconciled_order_customer_dialog_ct])/SUM([reconciled_order_ct])' />
      </column>
      <column caption='% Reconciled Orders (Partial Acceptance)' datatype='real' name='[Calculation_1875608531745243137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reconciled_order_partial_acceptance_ct])/SUM([reconciled_order_ct])' />
      </column>
      <column caption='% Reconciled Orders saved' datatype='real' name='[Calculation_1875608531759284227]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reconciled_order_saved_ct])&#10;/SUM([reconciled_order_ct])' />
      </column>
      <column caption='% Reconciled Orders saved (Partial Acceptance)' datatype='real' name='[Calculation_1875608531759558660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reconciled_order_saved_partial_acceptance_ct])/SUM([reconciled_order_partial_acceptance_ct])' />
      </column>
      <column caption='% Reconciled Orders saved (Customer Dialog)' datatype='real' name='[Calculation_1875608531759726597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([reconciled_order_saved_customer_dialog_ct])&#10;/SUM([reconciled_order_customer_dialog_ct])' />
      </column>
      <column caption='_dimension selector' datatype='string' name='[Calculation_1875608531764727814]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Date granularity (copy)_3340474687913746432]' />
      </column>
      <column caption='Cohort Week' datatype='string' name='[Calculation_1985031912757637126]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Day &apos;&#10;+ STR([_week_num_after_first_test_order] * 7) &#10;+ &apos; - &apos;&#10;+ STR([_week_num_after_first_test_order] * 7 + 7)' />
      </column>
      <column caption='_First Test Order Week NOT current week' datatype='boolean' name='[Calculation_1985031912759234567]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[first_test_order_week] &lt;&gt;&#10;    (&#10;    STR(STR(YEAR(TODAY()))&#10;    + &apos;-&apos;&#10;    + STR(WEEK(TODAY())))&#10;    )' />
      </column>
      <column caption='NOT TODAY' datatype='boolean' name='[Calculation_3549118028895698944]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[created_date_local] &lt;&gt; TODAY()' />
      </column>
      <column caption='% Fail-rate (Product Unavailability)' datatype='real' name='[Calculation_3549118028896870401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_order_product_unavailable_ct])/SUM([order_ct])' />
      </column>
      <column caption='t-dimension' datatype='string' name='[Calculation_3549118028974149639]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Date Parameter] &#10;    WHEN &apos;daily&apos;&#10;        THEN STR([created_date_local])&#10;    WHEN &apos;weekly&apos;&#10;        THEN [created_week]&#10;    WHEN &apos;monthly&apos;&#10;        THEN [created_month]&#10;END' />
      </column>
      <column caption='% Fail-rate' datatype='real' name='[Calculation_3549118028978610184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_order_ct])/SUM([order_ct])' />
      </column>
      <column caption='% Fail-rate (Too Busy)' datatype='real' name='[Calculation_3549118028978946057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([fail_order_too_busy_ct])/SUM([order_ct])' />
      </column>
      <column caption='User Entitlement' datatype='boolean' name='[Calculation_5094134168205426689]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[username] = USERNAME()' />
      </column>
      <column caption='% Running Share (Quick Acceptance Orders)' datatype='real' default-format='p0.00%' name='[Calculation_671036378528141312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([quick_acceptance_order_screen_ct]))/TOTAL(SUM([quick_acceptance_order_screen_ct]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Is Quick Acceptance Order' datatype='boolean' name='[Calculation_671036378547982343]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[quick_acceptance_order_screen_ct]&gt;0' />
      </column>
      <column aggregation='None' caption='Client Dispatch Time (seconds) - bin' datatype='integer' name='[Client Dispatch Time (second) (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='1' formula='[dispatch_time_bin]' peg='0' size='60' />
      </column>
      <column aggregation='None' caption='Client Response Time (seconds) (bin)' datatype='integer' name='[Client Response Time (seconds) (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[response_time_client_bin]' peg='0' size='5' />
      </column>
      <column caption='Avg Acceptance Time (seconds)' datatype='real' name='[Client Response Time (seconds) (copy)_2817634919957106688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([response_time_client_bin]*[order_ct])/SUM([order_ct])' />
      </column>
      <column caption='_First Test Order Week (only for NULL filter)' datatype='string' name='[First Test Order Week (copy)_1693423887284862995]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[first_test_order_week]' />
      </column>
      <column caption='NOT FIRST WEEK (For Test Order Cohort)' datatype='boolean' name='[NOT TODAY (copy)_1299007077480239106]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX() &lt;&gt; 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
