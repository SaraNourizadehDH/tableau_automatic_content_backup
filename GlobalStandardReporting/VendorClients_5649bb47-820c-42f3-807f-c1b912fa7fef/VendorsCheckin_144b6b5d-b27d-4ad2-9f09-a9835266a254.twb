    <worksheet name='Vendor Usage Table (Regional dimension)'>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gsr_checkin_dashboard (rl)' name='federated.0tbgmki0rs4ql614x8iem0lpd7ez' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Dimension A' datatype='string' name='[% Vendor Fail-rate - No Response (Working Hours Check-in enabled) Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
              <calculation class='tableau' formula='&quot;Region&quot;' />
            </column>
            <column caption='Choose Dimension to show' datatype='string' name='[Date Granularity (copy 2)]' param-domain-type='list' role='measure' type='nominal' value='&quot;Regional dimensions&quot;'>
              <calculation class='tableau' formula='&quot;Regional dimensions&quot;' />
            </column>
            <column caption='Dimension B' datatype='string' name='[Dimension A (copy)_1007750811965001745]' param-domain-type='list' role='measure' type='nominal' value='&quot;Brand Name&quot;'>
              <calculation class='tableau' formula='&quot;Brand Name&quot;' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0tbgmki0rs4ql614x8iem0lpd7ez'>
            <column caption='# Avg Daily Vendors having Check-in displayed (Regional)' datatype='real' name='[# Avg Daily Vendors (Regional) (copy)_1007750811994042395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_using_checkin_ct])&#10;/(DATEDIFF(&apos;day&apos;, MIN([created_date_local]), TODAY()))' />
            </column>
            <column caption='# Avg Daily Vendors opened (Regional)' datatype='real' name='[# Avg Daily Vendors (Regional) (copy)_957859375526252579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_opened_ct])&#10;/(DATEDIFF(&apos;day&apos;, MIN([created_date_local]), TODAY()))' />
            </column>
            <column caption='# Avg Daily Vendors clicking Check-in before schedule (Regional) ' datatype='real' name='[# Avg Daily Vendors clicking Check-in (Regional)  (copy)_957859375498022937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendors_using_checkin_clicked_before_schedule_ct])&#10;/(DATEDIFF(&apos;day&apos;, MIN([created_date_local]), TODAY()))' />
            </column>
            <column caption='# Avg Daily Vendors clicking Check-in before schedule' datatype='real' name='[# Avg Daily Vendors clicking Check-in (copy)_1007750812698853416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Daily&apos;&#10;    THEN SUM([vendors_using_checkin_clicked_before_schedule_ct])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos;&#10;    THEN SUM([vendors_using_checkin_clicked_before_schedule_ct])/7&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos;&#10;    THEN SUM([vendors_using_checkin_clicked_before_schedule_ct])/30&#10;END' />
            </column>
