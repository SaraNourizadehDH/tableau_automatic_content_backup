    <worksheet name='Check-in Trend'>
      <table>
        <view>
          <datasources>
            <datasource caption='vendor_gsr_checkin_dashboard (rl)' name='federated.0tbgmki0rs4ql614x8iem0lpd7ez' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Choose % Fail-rate to show' datatype='string' name='[Date Granularity (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Vendor Fail-rate&quot;'>
              <calculation class='tableau' formula='&quot;% Vendor Fail-rate&quot;' />
            </column>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Daily&quot;'>
              <calculation class='tableau' formula='&quot;Daily&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0tbgmki0rs4ql614x8iem0lpd7ez'>
            <column caption='# Avg Daily Vendors (Working Hours Check-in enabled) ' datatype='real' name='[# Avg Daily Vendors (Not enabled) (copy)_1007750811958853643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Daily&apos;&#10;    THEN SUM([vendors_enabled_ct])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos;&#10;    THEN SUM([vendors_enabled_ct])/7&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos;&#10;    THEN SUM([vendors_enabled_ct])/30&#10;END' />
            </column>
            <column caption='% First Order Vendor Fails (Working Hours Check-in enabled)' datatype='real' name='[% First Order Vendor Fails (Not enabled) (copy)_1007750812285399079]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([first_orders_vendor_fail_enabled_ct])&#10;/SUM([first_orders_enabled_ct])' />
            </column>
            <column caption='% Vendor Fail-rate - No Response (Working Hours Check-in enabled)' datatype='real' name='[% Vendor Fail-rate (Closed) (Working Hours Check-in enabled) (copy)_1007750811936669698]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_no_response_enabled_ct])&#10;/SUM([orders_working_hours_check_in_enabled_ct])' />
            </column>
            <column caption='% Vendor Fail-rate - Unreachable (Working Hours Check-in enabled)' datatype='real' name='[% Vendor Fail-rate (No Response) (Working Hours Check-in enabled) (copy) (copy)_1007750811936772099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_unreachable_ct_enabled_ct])&#10;/SUM([orders_working_hours_check_in_enabled_ct])' />
            </column>
            <column caption='% Vendor Fail-rate - Closed (Not enabled)' datatype='real' name='[% Vendor Fail-rate (Not enabled) (copy)_1007750811941404677]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_closed_not_enabled_ct])&#10;/SUM([orders_not_enabled_ct])' />
            </column>
            <column caption='% Vendor Fail-rate - Closed (Working Hours Check-in enabled)' datatype='real' name='[% Vendor Fail-rate (Working Hours Check-in enabled) (copy)_1007750811936198657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_closed_enabled_ct])&#10;/SUM([orders_working_hours_check_in_enabled_ct])' />
            </column>
            <column caption='% Vendor Fail-rate - No response (Not enabled)' datatype='real' name='[% Vendor Fail-rate - Closed (Not enabled) (copy)_1007750811941605382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_no_response_not_enabled_ct])&#10;/SUM([orders_not_enabled_ct])' />
            </column>
            <column caption='% Vendor Fail-rate - Unreachable (Not enabled) ' datatype='real' name='[% Vendor Fail-rate - No response (Not enabled) (copy)_1007750811954446344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_unreachable_not_enabled_ct])&#10;/SUM([orders_not_enabled_ct])' />
            </column>
            <column caption='# Avg Daily Vendors' datatype='real' name='[Calculation_1007750811957743625]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Daily&apos;&#10;    THEN SUM([vendors_ct])&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Weekly&apos;&#10;    THEN SUM([vendors_ct])/7&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Monthly&apos;&#10;    THEN SUM([vendors_ct])/30&#10;END' />
            </column>
            <column caption='% Orders (Working Hours Check-in enabled)' datatype='real' name='[Calculation_1007750811964436496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([orders_working_hours_check_in_enabled_ct])&#10;/SUM([orders_ct])' />
            </column>
            <column caption='Selected Fail-rate (Not enabled)' datatype='real' name='[Calculation_1007750811969437717]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)]&#10;    WHEN &apos;% Vendor Fail-rate&apos;&#10;        THEN [Calculation_4465037580698292227]&#10;    WHEN &apos;% Vendor Fail-rate (Closed)&apos;&#10;        THEN [% Vendor Fail-rate (Not enabled) (copy)_1007750811941404677]&#10;    WHEN &apos;% Vendor Fail-rate (No Response)&apos;&#10;        THEN [% Vendor Fail-rate - Closed (Not enabled) (copy)_1007750811941605382]&#10;    WHEN &apos;% Vendor Fail-rate (Unreachable)&apos;&#10;        THEN [% Vendor Fail-rate - No response (Not enabled) (copy)_1007750811954446344]&#10;    WHEN &apos;% First Order Vendor Fails&apos;&#10;        THEN [Calculation_1007750812285165606]&#10;END' />
            </column>
            <column caption='% Avg Daily Vendors (Working Hours Check-in enabled)' datatype='real' name='[Calculation_1007750811973431320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[# Avg Daily Vendors (Not enabled) (copy)_1007750811958853643]&#10;/[Calculation_1007750811957743625]' />
            </column>
            <column caption='% First Order Vendor Fails (Not enabled)' datatype='real' name='[Calculation_1007750812285165606]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([first_orders_vendor_fail_not_enabled_ct])&#10;/SUM([first_orders_not_enabled_ct])' />
            </column>
            <column caption='t-dimension' datatype='string' name='[Calculation_4465037580369698816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;    WHEN &apos;Daily&apos;&#10;        THEN STR([created_date_local])&#10;    WHEN &apos;Weekly&apos;&#10;        THEN [created_week]&#10;    WHEN &apos;Monthly&apos;&#10;        THEN [created_month]&#10;END' />
            </column>
            <column caption='% Vendor Fail-rate' datatype='real' name='[Calculation_4465037580369952769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_vendor_ct])/SUM([orders_ct])' />
            </column>
            <column caption='% Vendor Fail-rate (Not enabled)' datatype='real' name='[Calculation_4465037580698292227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_vendor_not_enabled_ct])&#10;/SUM([orders_not_enabled_ct])' />
            </column>
            <column caption='% Vendor Fail-rate (Working Hours Check-in enabled)' datatype='real' name='[Calculation_4465037580698640388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([fail_orders_working_hours_check_in_enabled_ct])&#10;/SUM([orders_working_hours_check_in_enabled_ct])' />
            </column>
            <column caption='Selected Fail-rate (Working Hours Check-in enabled)' datatype='real' name='[Selected Fail-rate (Not enabled) (copy)_1007750811969998871]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Date Granularity (copy)]&#10;    WHEN &apos;% Vendor Fail-rate&apos;&#10;        THEN [Calculation_4465037580698640388]&#10;    WHEN &apos;% Vendor Fail-rate (Closed)&apos;&#10;        THEN [% Vendor Fail-rate (Working Hours Check-in enabled) (copy)_1007750811936198657]&#10;    WHEN &apos;% Vendor Fail-rate (No Response)&apos;&#10;        THEN [% Vendor Fail-rate (Closed) (Working Hours Check-in enabled) (copy)_1007750811936669698]&#10;    WHEN &apos;% Vendor Fail-rate (Unreachable)&apos;&#10;        THEN [% Vendor Fail-rate (No Response) (Working Hours Check-in enabled) (copy) (copy)_1007750811936772099]&#10;    WHEN &apos;% First Order Vendor Fails&apos;&#10;        THEN [% First Order Vendor Fails (Not enabled) (copy)_1007750812285399079]&#10;END' />
            </column>
            <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
            <column caption='Client' datatype='string' name='[client_name]' role='dimension' type='nominal' />
            <column caption='Client Version' datatype='string' name='[client_version]' role='dimension' type='nominal' />
