      <datasource-dependencies datasource='Parameters'>
        <column caption='Dimension A' datatype='string' name='[% Vendor Fail-rate - No Response (Working Hours Check-in enabled) Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
          <calculation class='tableau' formula='&quot;Region&quot;' />
        </column>
        <column caption='Choose bin size (before schedule)' datatype='integer' name='[Choose % Fail-rate to show (copy)]' param-domain-type='range' role='measure' type='quantitative' value='1'>
          <calculation class='tableau' formula='1' />
