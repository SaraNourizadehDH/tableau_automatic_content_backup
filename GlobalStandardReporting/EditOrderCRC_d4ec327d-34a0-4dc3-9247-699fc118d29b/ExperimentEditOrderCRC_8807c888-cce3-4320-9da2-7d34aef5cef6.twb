      </column>
      <column caption='Metrics' datatype='real' name='[Calculation_3902369094159556608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN [% Vendor Fail Rate (copy)_4868320897008328704]&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN [% Item Unavailable Fail Rate (copy)_4565524149295542293]&#10;WHEN &quot;% No Response Fail Rate&quot; THEN [Calculation_1984680089613533184]&#10;WHEN &quot;% Item Unavailable Fail Rate&quot; THEN [% Fail Rate (copy)_6233263382032949250]&#10;WHEN &quot;% Too Busy Fail Rate&quot; THEN [% Fail Rate (copy)_6233263382032949250]&#10;WHEN &quot;% Late Delivery Fail Rate&quot; THEN [% Bad Weather Fail Rate (copy)_6233263382037168140]&#10;WHEN &quot;% Outside Delivery Area Fail Rate&quot; THEN [% Fail Rate (copy)_6233263382033616901]&#10;WHEN &quot;% No Courier Fail Rate&quot; THEN [% Fail Rate (copy)_6233263382037962767]&#10;WHEN &quot;% Bad Weather Fail Rate&quot; THEN [% Fail Rate (copy)_6233263382035787784]&#10;&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN[% Vendor Contact Rate (copy)_7010697278586339343]&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN [% Vendor Fail Rate (copy)_4565524149295779862]&#10;WHEN &quot;% Rider Contact Rate&quot; THEN [Calculation_2434195638697463808]&#10;WHEN &quot;% Customer Contact Rate&quot; THEN [Calculation_2434195638697549825]&#10;&#10;WHEN &quot;% Live Order Inquiries Contact Rate&quot; THEN [%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_4565524149296615449]&#10;WHEN &quot;% Order Cancellation Contact Rate&quot; THEN [% Vendor Contact Rate (copy)_4565524149296021527]&#10;WHEN &quot;% Product Unavailable Contact Rate&quot; THEN [%  Post Delivery Contact Rate (∆ Divergence) (copy)_4565524149296287768]&#10;&#10;&#10;END' />
      </column>
      <column caption='Metrics (∆)' datatype='real' name='[Calculation_3902369094162780161]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(   // varient A&#10;    (SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [Calculation_3902369094162980866] END)&#10;      / [Calculation_3902369094168502277]&#10;     ) &#10;    &#10;/&#10;  // Baseline&#10;    (SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [Calculation_3902369094162980866] END)&#10;    /[Calculation_3902369094168055812]&#10;    )&#10;)&#10;- 1' />
      </column>
      <column caption='∆  Metrics Numerator' datatype='integer' name='[Calculation_3902369094162980866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN [failed_orders]&#10;WHEN &quot;% Customer Fail Rate&quot; THEN [customer_failed_orders]&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN [vendor_failed_orders]&#10;WHEN &quot;% No Response Fail Rate&quot; THEN [no_response_failed_vendor]&#10;WHEN &quot;% Item Unavailable Fail Rate&quot; THEN [item_unavailable_vendor_failed_orders]&#10;WHEN &quot;% Too Busy Fail Rate&quot; THEN [too_busy_failed_orders]&#10;WHEN &quot;% Late Delivery Fail Rate&quot; THEN [late_delivery_failed_orders]&#10;WHEN &quot;% Outside Delivery Area Fail Rate&quot; THEN [outside_delivery_area_failed_orders]&#10;WHEN &quot;% No Courier Fail Rate&quot; THEN [no_courier_failed_orders]&#10;WHEN &quot;% Bad Weather Fail Rate&quot; THEN [bad_weather_failed_orders]&#10;&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN [vendor_customer_contacts]&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN [vendor_contacts]&#10;WHEN &quot;% Rider Contact Rate&quot; THEN [rider_contacts]&#10;WHEN &quot;% Customer Contact Rate&quot; THEN [customer_contacts]&#10;WHEN &quot;% Live Order Inquiries Contact Rate&quot; THEN [live_order_inquiries_contacts]&#10;&#10;END' />
