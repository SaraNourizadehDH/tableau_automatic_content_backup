    <worksheet name='Metrics Line Chart + Delta'>
      <layout-options>
        <title>
          <formatted-text>
            <run>&lt;</run>
            <run>[Parameters].[Parameter 4]</run>
            <run>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='edit_order_crc + user entitlement' name='federated.0hr6f8u087m4kg1bqrbfm17yze5s' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Date Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column alias='Variant A' caption='Select Variant' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Variant A&quot;'>
              <calculation class='tableau' formula='&quot;Variant A&quot;' />
              <aliases>
                <alias key='&quot;Variant A&quot;' value='Variant A' />
              </aliases>
            </column>
            <column caption='Select Metric' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;\% Fail Rate&quot;'>
              <calculation class='tableau' formula='&quot;% Fail Rate&quot;' />
              <aliases>
                <alias key='&quot;...&quot;' value='..' />
                <alias key='&quot;\# Orders&quot;' value='# Orders' />
                <alias key='&quot;\% Contact Rate&quot;' value='% Contact Rate' />
                <alias key='&quot;\% Item Unavailable Fail Rate&quot;' value='% Item Unavailable Fail Rate' />
                <alias key='&quot;\% Vendor Fail Rate&quot;' value='% Vendor Fail Rate' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hr6f8u087m4kg1bqrbfm17yze5s'>
            <column caption='%  Live Order Inquiries Contact Rate   ' datatype='real' default-format='p0.000%' name='[%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_4565524149296615449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([live_order_inquiries_contacts])&#10;    /&#10;    SUM([orders])' />
            </column>
            <column caption='% Product Unavailable Contact Rate' datatype='real' default-format='p0.000%' name='[%  Post Delivery Contact Rate (∆ Divergence) (copy)_4565524149296287768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([product_unavailable_contacts])&#10;    /&#10;    SUM([orders])' />
            </column>
            <column caption='% Late Delivery Fail Rate' datatype='real' default-format='p0.00%' name='[% Bad Weather Fail Rate (copy)_6233263382037168140]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([late_delivery_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Too Busy Fail Rate' datatype='real' default-format='p0.00%' name='[% Fail Rate (copy)_6233263382032949250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([too_busy_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Outside Delivery Area Fail Rate' datatype='real' default-format='p0.00%' name='[% Fail Rate (copy)_6233263382033616901]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([outside_delivery_area_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Bad Weather Fail Rate' datatype='real' default-format='p0.00%' name='[% Fail Rate (copy)_6233263382035787784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bad_weather_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% No Courier Fail Rate' datatype='real' default-format='p0.00%' name='[% Fail Rate (copy)_6233263382037962767]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_courier_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_4565524149295542293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Order Cancellation Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Contact Rate (copy)_4565524149296021527]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_cancellation_contacts])/SUM([orders])' />
            </column>
            <column caption='% Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Contact Rate (copy)_7010697278586339343]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_customer_contacts])/SUM([orders])' />
            </column>
            <column caption='% Vendor Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Fail Rate (copy)_4565524149295779862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_contacts])/SUM([orders])' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_4868320897008328704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])/SUM([orders])' />
            </column>
            <column caption='% No Response Fail Rate' datatype='real' name='[Calculation_1984680089613533184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_response_failed_vendor])/SUM([orders])' />
            </column>
            <column caption='% Rider Contact Rate' datatype='real' name='[Calculation_2434195638697463808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_contacts])/SUM([orders])' />
            </column>
            <column caption='% Customer Contact Rate' datatype='real' name='[Calculation_2434195638697549825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_contacts])/SUM([orders])' />
            </column>
            <column caption='Metrics' datatype='real' name='[Calculation_3902369094159556608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN [% Vendor Fail Rate (copy)_4868320897008328704]&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN [% Item Unavailable Fail Rate (copy)_4565524149295542293]&#10;WHEN &quot;% No Response Fail Rate&quot; THEN [Calculation_1984680089613533184]&#10;WHEN &quot;% Item Unavailable Fail Rate&quot; THEN [% Fail Rate (copy)_6233263382032949250]&#10;WHEN &quot;% Too Busy Fail Rate&quot; THEN [% Fail Rate (copy)_6233263382032949250]&#10;WHEN &quot;% Late Delivery Fail Rate&quot; THEN [% Bad Weather Fail Rate (copy)_6233263382037168140]&#10;WHEN &quot;% Outside Delivery Area Fail Rate&quot; THEN [% Fail Rate (copy)_6233263382033616901]&#10;WHEN &quot;% No Courier Fail Rate&quot; THEN [% Fail Rate (copy)_6233263382037962767]&#10;WHEN &quot;% Bad Weather Fail Rate&quot; THEN [% Fail Rate (copy)_6233263382035787784]&#10;&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN[% Vendor Contact Rate (copy)_7010697278586339343]&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN [% Vendor Fail Rate (copy)_4565524149295779862]&#10;WHEN &quot;% Rider Contact Rate&quot; THEN [Calculation_2434195638697463808]&#10;WHEN &quot;% Customer Contact Rate&quot; THEN [Calculation_2434195638697549825]&#10;&#10;WHEN &quot;% Live Order Inquiries Contact Rate&quot; THEN [%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_4565524149296615449]&#10;WHEN &quot;% Order Cancellation Contact Rate&quot; THEN [% Vendor Contact Rate (copy)_4565524149296021527]&#10;WHEN &quot;% Product Unavailable Contact Rate&quot; THEN [%  Post Delivery Contact Rate (∆ Divergence) (copy)_4565524149296287768]&#10;&#10;&#10;END' />
            </column>
            <column caption='Metrics (∆)' datatype='real' name='[Calculation_3902369094162780161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(   // varient A&#10;    (SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [Calculation_3902369094162980866] END)&#10;      / [Calculation_3902369094168502277]&#10;     ) &#10;    &#10;/&#10;  // Baseline&#10;    (SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [Calculation_3902369094162980866] END)&#10;    /[Calculation_3902369094168055812]&#10;    )&#10;)&#10;- 1' />
            </column>
            <column caption='∆  Metrics Numerator' datatype='integer' name='[Calculation_3902369094162980866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN [failed_orders]&#10;WHEN &quot;% Customer Fail Rate&quot; THEN [customer_failed_orders]&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN [vendor_failed_orders]&#10;WHEN &quot;% No Response Fail Rate&quot; THEN [no_response_failed_vendor]&#10;WHEN &quot;% Item Unavailable Fail Rate&quot; THEN [item_unavailable_vendor_failed_orders]&#10;WHEN &quot;% Too Busy Fail Rate&quot; THEN [too_busy_failed_orders]&#10;WHEN &quot;% Late Delivery Fail Rate&quot; THEN [late_delivery_failed_orders]&#10;WHEN &quot;% Outside Delivery Area Fail Rate&quot; THEN [outside_delivery_area_failed_orders]&#10;WHEN &quot;% No Courier Fail Rate&quot; THEN [no_courier_failed_orders]&#10;WHEN &quot;% Bad Weather Fail Rate&quot; THEN [bad_weather_failed_orders]&#10;&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN [vendor_customer_contacts]&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN [vendor_contacts]&#10;WHEN &quot;% Rider Contact Rate&quot; THEN [rider_contacts]&#10;WHEN &quot;% Customer Contact Rate&quot; THEN [customer_contacts]&#10;WHEN &quot;% Live Order Inquiries Contact Rate&quot; THEN [live_order_inquiries_contacts]&#10;&#10;END' />
            </column>
            <column caption='∆  Metrics Denominator - Baseline' datatype='integer' name='[Calculation_3902369094168055812]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% No Response Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Item Unavailable Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Late Delivery Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Outside Delivery Area Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% No Courier Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Bad Weather Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Too Busy Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Rider Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Customer Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;WHEN &quot;% Live Order Inquiries Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Order Cancellation Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;% Product Unavailable Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;END' />
            </column>
            <column caption='∆  Metrics Denominator - Variant A' datatype='integer' name='[Calculation_3902369094168502277]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#10;// based on total orders&#10;WHEN &quot;% Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Vendor Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% No Response Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Item Unavailable Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Late Delivery Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Outside Delivery Area Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% No Courier Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Bad Weather Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Too Busy Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;&#10;// contacts&#10;WHEN &quot;% Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Vendor Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Rider Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Customer Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;&#10;WHEN &quot;% Live Order Inquiries Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Order Cancellation Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;WHEN &quot;% Product Unavailable Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Variant A&apos; THEN [orders] END)&#10;&#10;END' />
            </column>
            <column caption='_granularity_filter' datatype='boolean' name='[Calculation_4565524148946161665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &quot;Daily&quot; THEN [date_type] = &quot;Daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [date_type] = &quot;Weekly&quot;&#10;&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_4565524148946345986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date_local]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date_local]))+&quot;-W&quot;+STR([weeks])&#10;END' />
            </column>
            <column caption='Total Contacts' datatype='integer' name='[Calculation_5552234670860488709]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[vendor_contacts]+[rider_contacts]+[customer_contacts]' />
            </column>
            <column caption='Variants filter' datatype='boolean' name='[Variants (copy)_1879126963555889156]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;&#10;WHEN &quot;Variant A&quot; THEN [experiment_group] IN (&quot;Variant A&quot;, &quot;Baseline&quot;)&#10;WHEN &quot;Variant B&quot; THEN [experiment_group] IN (&quot;Variant B&quot;, &quot;Baseline&quot;)&#10;&#10;END' />
            </column>
