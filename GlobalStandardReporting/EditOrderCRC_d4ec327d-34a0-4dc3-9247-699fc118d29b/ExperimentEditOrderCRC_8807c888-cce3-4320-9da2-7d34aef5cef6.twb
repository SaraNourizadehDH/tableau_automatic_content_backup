      <column caption='∆  Metrics Numerator' datatype='integer' name='[Metrics (copy)_4565524149414187091]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4 1]&#10;&#10;// based on total orders&#10;WHEN &quot;Item Unavailable Fail Rate&quot; THEN [item_unavailable_vendor_failed_orders]&#10;WHEN &quot;Vendor Fail Rate&quot; THEN [vendor_failed_orders]&#10;WHEN &quot;No Response Fail Rate&quot; THEN [no_response_vendor_failed_orders]&#10;&#10;// based on the item unavailable funnel&#10;WHEN &quot;Simple Flow&quot; THEN [simple_flow_orders]&#10;WHEN &quot;Call Customer&quot; THEN [call_customer_orders]&#10;WHEN &quot;Call Customer Accept Failed Orders&quot; THEN [call_customer_accept_failed_orders]&#10;WHEN &quot;Call Customer Accepted Orders&quot; THEN [call_customer_accepted_orders]&#10;WHEN &quot;Call Customer Declined Orders&quot; THEN [call_customer_declined_orders]&#10;WHEN &quot;Call Customer Dismissed Orders&quot; THEN [call_customer_dismissed_orders]&#10;WHEN &quot;Call Customer Dismissed Completed Orders&quot; THEN [call_customer_dismissed_completed_orders]&#10;WHEN &quot;Call Customer No Action Orders&quot; THEN [call_customer_no_action_orders]&#10;WHEN &quot;Not Reconciled Failed Agent Other Orders&quot; THEN [not_reconciled_failed_agent_other_orders]&#10;&#10;// save rate&#10;WHEN &quot;Save Rate&quot; THEN [call_customer_accepted_orders]&#10;&#10;// Contacts&#10;WHEN &quot;Contact Rate&quot; THEN [Calculation_7010697278586179598]&#10;WHEN &quot;Vendor Contact Rate&quot; THEN [vendor_contacts]&#10;WHEN &quot;Customer Contact Rate&quot; THEN [customer_contacts]&#10;WHEN &quot;Live Order Contact Rate&quot; THEN [live_order_inquiries_contacts]&#10;WHEN &quot;Order Cancellation Contact Rate&quot; THEN [order_cancellation_contacts]&#10;WHEN &quot;Product Unavailable Contact Rate&quot; THEN [product_unavailable_vendor_contacts]&#10;&#10;WHEN &quot;Offline Duration&quot; THEN [offline_duration]&#10;&#10;END' />
