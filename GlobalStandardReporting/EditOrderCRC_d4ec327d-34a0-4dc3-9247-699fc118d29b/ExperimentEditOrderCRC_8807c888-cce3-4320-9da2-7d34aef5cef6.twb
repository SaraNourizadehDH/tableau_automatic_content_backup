    <worksheet name='Post Variant-Baseline % Point Diff'>
      <table>
        <view>
          <datasources>
            <datasource caption='edit_order_crc + user entitlement' name='federated.0hr6f8u087m4kg1bqrbfm17yze5s' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Date Level' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
            <column alias='Variant A' caption='Select Variant' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Variant A&quot;'>
              <calculation class='tableau' formula='&quot;Variant A&quot;' />
              <aliases>
                <alias key='&quot;Variant A&quot;' value='Variant A' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0hr6f8u087m4kg1bqrbfm17yze5s'>
            <column caption='%  Live Order Inquiries Contact Rate   ' datatype='real' default-format='p0.000%' name='[%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_4565524149296615449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([live_order_inquiries_contacts])&#10;    /&#10;    SUM([orders])' />
            </column>
            <column caption='% Product Unavailable Contact Rate' datatype='real' default-format='p0.000%' name='[%  Post Delivery Contact Rate (∆ Divergence) (copy)_4565524149296287768]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([product_unavailable_contacts])&#10;    /&#10;    SUM([orders])' />
            </column>
            <column caption='% Late Delivery Fail Rate' datatype='real' default-format='p0.00%' name='[% Bad Weather Fail Rate (copy)_6233263382037168140]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([late_delivery_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Too Busy Fail Rate' datatype='real' default-format='p0.00%' name='[% Fail Rate (copy)_6233263382032949250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([too_busy_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Outside Delivery Area Fail Rate' datatype='real' default-format='p0.00%' name='[% Fail Rate (copy)_6233263382033616901]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([outside_delivery_area_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Bad Weather Fail Rate' datatype='real' default-format='p0.00%' name='[% Fail Rate (copy)_6233263382035787784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bad_weather_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% No Courier Fail Rate' datatype='real' default-format='p0.00%' name='[% Fail Rate (copy)_6233263382037962767]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_courier_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Vendor Fail Rate' datatype='real' default-format='p0.00%' name='[% Item Unavailable Fail Rate (copy)_4565524149295542293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='% Order Cancellation Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Contact Rate (copy)_4565524149296021527]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([order_cancellation_contacts])/SUM([orders])' />
            </column>
            <column caption='% Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Contact Rate (copy)_7010697278586339343]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_customer_contacts])/SUM([orders])' />
            </column>
            <column caption='% Vendor Contact Rate' datatype='real' default-format='p0.000%' name='[% Vendor Fail Rate (copy)_4565524149295779862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vendor_contacts])/SUM([orders])' />
            </column>
            <column caption='% Fail Rate' datatype='real' default-format='p0.00%' name='[% Vendor Fail Rate (copy)_4868320897008328704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([failed_orders])/SUM([orders])' />
            </column>
            <column caption='% No Response Fail Rate' datatype='real' name='[Calculation_1984680089613533184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([no_response_failed_vendor])/SUM([orders])' />
            </column>
            <column caption='% Rider Contact Rate' datatype='real' name='[Calculation_2434195638697463808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rider_contacts])/SUM([orders])' />
            </column>
            <column caption='% Customer Contact Rate' datatype='real' name='[Calculation_2434195638697549825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([customer_contacts])/SUM([orders])' />
            </column>
            <column caption='_granularity_filter' datatype='boolean' name='[Calculation_4565524148946161665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;&#10;WHEN &quot;Daily&quot; THEN [date_type] = &quot;Daily&quot;&#10;WHEN &quot;Weekly&quot; THEN [date_type] = &quot;Weekly&quot;&#10;&#10;END' />
            </column>
            <column caption='Date' datatype='string' name='[Calculation_4565524148946345986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [date_type]&#10;WHEN &quot;Daily&quot; THEN STR(DATE([created_date_local]))&#10;WHEN &quot;Weekly&quot; THEN STR(YEAR([created_date_local]))+&quot;-W&quot;+STR([weeks])&#10;END' />
            </column>
            <column caption='% Item Unavailable Fail Rate' datatype='real' default-format='p0.00%' name='[Calculation_4565524149076819972]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([item_unavailable_vendor_failed_orders])/SUM([orders])' />
            </column>
            <column caption='_line_break 1' datatype='integer' name='[Calculation_7010697278612394003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(NULL)' />
              <aliases>
                <alias key='%null%' value='  ' />
              </aliases>
            </column>
            <column caption='Pre Tag ∆  (copy)' datatype='string' name='[Pre Tag ∆  (copy)_6003016862510194688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Post ∆ (Variant-Baseline)&quot;' />
