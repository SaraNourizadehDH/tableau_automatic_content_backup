      <column caption='Metrics' datatype='real' name='[Calculation_4565524149410283601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4 1]&#10;// based on total orders&#10;WHEN &quot;Item Unavailable Fail Rate&quot; THEN [Calculation_4565524149076819972]&#10;WHEN &quot;Vendor Fail Rate&quot; THEN [% Item Unavailable Fail Rate (copy)_4565524149295542293]&#10;WHEN &quot;No Response Fail Rate&quot; THEN [% Item Unavailable Fail Rate (copy)_4604719552921489411]&#10;&#10;// based on the item unavailable funnel&#10;WHEN &quot;Simple Flow&quot; THEN [   % Call Customer Declined Orders (copy) (copy) (copy)_4565524149346566214]&#10;WHEN &quot;Call Customer Accept Failed Orders&quot; THEN [Calculation_4565524149345865793]&#10;WHEN &quot;Call Customer Accepted Orders&quot; THEN [   % Call Customer Accept Failed Orders (copy)_4565524149346148418]&#10;WHEN &quot;Call Customer Declined Orders&quot; THEN [   % Call Customer Accepted Orders (copy)_4565524149346275395]&#10;WHEN &quot;Call Customer Dismissed Orders&quot; THEN [   % Call Customer Declined Orders (copy)_4565524149346545732]&#10;WHEN &quot;Call Customer No Action Orders&quot; THEN [   % Call Customer Declined Orders (copy) (copy)_4565524149346558021]&#10;WHEN &quot;Not Reconciled Failed Agent Other Orders&quot; THEN [   % Simple Flow Orders (copy)_4565524149347012679]&#10;&#10;// save rate&#10;WHEN &quot;Save Rate&quot; THEN [Calculation_7010697278100475906]&#10;WHEN &quot;Call Customer Dismissed Completed Orders&quot; THEN [% Call Customer Dismissed Orders  (copy)_7010697278492770313]&#10;WHEN &quot;Contact Rate&quot; THEN [% Vendor Contact Rate (copy)_7010697278586339343]&#10;WHEN &quot;Call Customer&quot; THEN [%  Call Customer Accepted Orders  (copy)_7010697278789357608]&#10;&#10;// contacts&#10;WHEN &quot;Contact Rate&quot; THEN [% Vendor Contact Rate (copy)_7010697278586339343]&#10;WHEN &quot;Vendor Contact Rate&quot; THEN [% Vendor Fail Rate (copy)_4565524149295779862]&#10;WHEN &quot;Customer Contact Rate&quot; THEN [% Vendor Contact Rate (copy)_4565524149296021527]&#10;WHEN &quot;Live Order Contact Rate&quot; THEN [%  Live Order Inquiries Contact Rate (∆ Divergence) (copy)_4565524149296615449]&#10;WHEN &quot;Product Unavailable Contact Rate&quot; THEN [% Order Cancellation Contact Rate (copy)_4604719552926384140]&#10;WHEN &quot;Order Cancellation Contact Rate&quot; THEN [% Contact Rate (copy)_4604719552925519881]&#10;&#10;WHEN &quot;Offline Duration&quot; THEN [Calculation_4604719552927608848]&#10;END' />
      </column>
