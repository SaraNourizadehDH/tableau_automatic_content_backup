      <column caption='∆  Metrics Denominator - Baseline' datatype='integer' name='[∆  Metrics Denominator Variant (copy)_4565524149416140887]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4 1]&#10;// based on total orders&#10;WHEN &quot;Item Unavailable Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;Vendor Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;No Response Fail Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;// based on the item unavailable funnel&#10;WHEN &quot;Simple Flow&quot; THEN SUM([Funnel Total (copy)_4565524149417381977])&#10;WHEN &quot;Call Customer&quot; THEN SUM([Funnel Total (copy)_4565524149417381977])&#10;WHEN &quot;Call Customer Accept Failed Orders&quot; THEN SUM([Funnel Total (copy)_4565524149417381977])&#10;WHEN &quot;Call Customer Accepted Orders&quot; THEN SUM([Funnel Total (copy)_4565524149417381977])&#10;WHEN &quot;Call Customer Declined Orders&quot; THEN SUM([Funnel Total (copy)_4565524149417381977])&#10;WHEN &quot;Call Customer Dismissed Orders&quot; THEN SUM([Funnel Total (copy)_4565524149417381977])&#10;WHEN &quot;Call Customer Dismissed Completed Orders&quot; THEN SUM([Funnel Total (copy)_4565524149417381977])&#10;WHEN &quot;Call Customer No Action Orders&quot; THEN SUM([Funnel Total (copy)_4565524149417381977])&#10;WHEN &quot;Not Reconciled Failed Agent Other Orders&quot; THEN SUM([Funnel Total (copy)_4565524149417381977])&#10;&#10;// save rate&#10;WHEN &quot;Save Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [call_customer_orders] END)&#10;&#10;// Contacts&#10;WHEN &quot;Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;Vendor Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;Customer Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;Live Order Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;Product Unavailable Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;WHEN &quot;Order Cancellation Contact Rate&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;WHEN &quot;Offline Duration&quot; THEN SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END)&#10;&#10;END' />
      </column>
