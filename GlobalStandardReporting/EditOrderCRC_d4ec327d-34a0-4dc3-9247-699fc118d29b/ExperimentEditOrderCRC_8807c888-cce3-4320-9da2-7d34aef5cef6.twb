      <column caption='Fail Rate Delta' datatype='real' name='[Calculation_138133844993904643]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(   // varient A&#10;    (SUM(IF [experiment_group] = [Parameters].[Parameter 2] THEN [failed_orders] END)&#10;      / SUM(IF [experiment_group] = [Parameters].[Parameter 2] THEN [orders] END) &#10;     ) &#10;    &#10;/&#10;  // Baseline&#10;    (SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [failed_orders] END)&#10;    / SUM(IF [experiment_group] = &apos;Baseline&apos; THEN [orders] END) &#10;    )&#10;)&#10;- 1' />
