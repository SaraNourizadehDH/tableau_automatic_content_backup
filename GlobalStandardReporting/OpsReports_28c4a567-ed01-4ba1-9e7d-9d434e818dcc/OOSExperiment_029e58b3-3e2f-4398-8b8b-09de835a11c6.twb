        </calculation>
      </column>
      <column caption='1 top' datatype='boolean' name='[Calculation_917889930473394184]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_917889930473201671]&lt;=3'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Pelican_y_Tier' datatype='string' name='[Calculation_917889931550347295]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [is_pelican] &#13;&#10;when TRUE then [Calculation_917889930189365249]&#13;&#10;ELSE &quot;Godroid&quot; END' />
      </column>
      <column caption='% non integrated catalog' datatype='integer' name='[Calculation_917889932562104354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(countd([Calculation_2353130836056907833])-countd([Global_vendor_id_SFTP (copy)_2353130830701535245]))' />
      </column>
      <column caption='ponderated fail rate' datatype='real' name='[Calculation_917889932957974563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2353130835655344173]*SUM([Calculation_2353130835669901360])' />
      </column>
      <column caption='SFTP_y_Tier' datatype='string' name='[Catalog_y_Tier (copy)_917889931560562721]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [# Catalog Vendors (copy)_2353130836055945271] &#13;&#10;when &quot;SFTP&quot; then [Calculation_917889930189365249]&#13;&#10;ELSE &quot;no SFTP&quot; END' />
        <aliases>
          <alias key='&quot;no catalog&quot;' value='Non integr.' />
          <alias key='&quot;no SFTP&quot;' value='Non SFTP Integ.' />
        </aliases>
      </column>
      <column caption='Failed Orders Logistics (%)' datatype='real' name='[Failed Orders (%) (copy)_2353130831076614176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([transport_failed_orders])/SUM([total_orders])' />
      </column>
      <column caption='Failed Orders Vendor (%)' datatype='real' name='[Failed Orders Logistics (%) (copy)_2353130831076786209]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Failed Orders Vendor (%) (copy)_917889931537559581])/SUM([total_orders])' />
      </column>
      <column caption='vendor_failed_orders' datatype='integer' name='[Failed Orders Vendor (%) (copy)_917889931537559581]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Failure Owner (%) (copy)_2353130835787022385] == &quot;VENDOR&quot; THEN 1 ELSE 0 end' />
      </column>
      <column caption='Failure Owner' datatype='string' default-role='measure' default-type='quantitative' name='[Failure Owner (%) (copy)_2353130835787022385]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [failure_owner] &#13;&#10;when &quot;CUSTOMER&quot; then &quot;CUSTOMER&quot;&#13;&#10;when  &quot;VENDOR&quot; THEN &quot;VENDOR&quot;&#13;&#10;WHEN  &quot;TRANSPORT&quot; THEN &quot;TRANSPORT&quot;&#13;&#10;WHEN   &quot;PLATFORM&quot; THEN  &quot;PLATFORM&quot;&#13;&#10;ELSE NULL END' />
        <aliases>
          <alias key='&quot;CUSTOMER&quot;' value='Customer' />
          <alias key='&quot;PLATFORM&quot;' value='Platform' />
          <alias key='&quot;TRANSPORT&quot;' value='Logistics' />
          <alias key='&quot;VENDOR&quot;' value='Vendor' />
        </aliases>
      </column>
      <column caption='Partial Fulfillment (GMV)' datatype='real' name='[Gbv Gross Of Vat - Partial Orders (copy)_1721782475298459649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gbv_gross_of_vat_2])/sum([gbv_gross_of_vat_2_including_not_send])' />
