      <column caption='NULL 3' datatype='integer' name='[NULL 2 (copy)_2353130830726746133]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
      </column>
      <column caption='NULL 4' datatype='integer' name='[NULL 3 (copy)_2353130830727102486]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
      </column>
      <column caption='NULL 5' datatype='integer' name='[NULL 4 (copy)_2353130832800972840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF FALSE THEN 0 ELSE NULL END' />
      </column>
      <column caption='ABV Ratio' datatype='real' name='[OOS Failed Ratio (copy)_323696228726181899]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(CASE [Calculation_323696228717281284] WHEN &quot;Treatment&quot; Then [Gbv Gross Of Vat 2 (copy)_1721782475298234368] END)/&#13;&#10;SUM(CASE [Calculation_323696228717281284] WHEN &quot;Treatment&quot; Then [confirmed_orders] END))/&#13;&#10;(SUM(CASE [Calculation_323696228717281284] WHEN &quot;Control&quot; Then [Gbv Gross Of Vat 2 (copy)_1721782475298234368] END)/&#13;&#10;SUM(CASE [Calculation_323696228717281284] WHEN &quot;Control&quot; Then [confirmed_orders] END))' />
      </column>
