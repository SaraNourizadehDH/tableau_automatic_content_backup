      <column caption='Slot' datatype='string' name='[Calculation_323696229727088653]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [daily_average] &gt;= 0 AND [daily_average] &lt; 4 THEN &quot;0-4&quot;&#13;&#10;ELSEIF [daily_average] &gt;= 4 AND [daily_average] &lt; 8 THEN &quot;4-8&quot; &#13;&#10;ELSEIF [daily_average] &gt;= 8 AND [daily_average] &lt; 12 THEN &quot;8-12&quot; &#13;&#10;ELSEIF [daily_average] &gt;= 12 AND [daily_average] &lt; 16 THEN &quot;12-16&quot; &#13;&#10;ELSEIF [daily_average] &gt;= 16 AND [daily_average] &lt; 20 THEN &quot;16-20&quot; &#13;&#10;ELSEIF [daily_average] &gt;= 20 AND [daily_average] &lt;= 24 THEN &quot;20-24&quot; END' />
      </column>
      <column caption='In cart Weekly Feb' datatype='real' name='[Calculation_323696229730164750]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([in_cart_monthly]/28/7)' />
      </column>
      <column caption='Conversion Rate' datatype='real' name='[Calculation_323696229733584911]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sold_weekly])/sum([nro_times_added_cart])' />
      </column>
      <column caption='[Previous Week] Conversion Rate' datatype='real' name='[Calculation_323696229734010896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sold_previous_week])/sum([previous_week_nro_times_added_cart])' />
      </column>
      <column caption='[Feb weekly avg.] Conversion Rate' datatype='real' name='[Calculation_323696229735763985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sold_monthly_feb])/sum([nro_times_added_cart_feb])' />
      </column>
