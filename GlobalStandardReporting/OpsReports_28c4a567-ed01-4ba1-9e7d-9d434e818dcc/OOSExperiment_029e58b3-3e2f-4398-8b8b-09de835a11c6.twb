        <calculation class='tableau' formula='IF [ls3_update_month] == 1 THEN [Calculation_2353130828590903298] end' />
      </column>
      <column caption='% LS3 vendors' datatype='real' name='[Calculation_2353130832769175591]' role='measure' type='quantitative'>
