            <column caption='Previous Week Nro Times Added Cart' datatype='integer' name='[previous_week_nro_times_added_cart]' role='measure' type='quantitative' />
            <column datatype='real' name='[sold_monthly_feb]' role='measure' type='quantitative' />
            <column datatype='integer' name='[sold_previous_week]' role='measure' type='quantitative' />
            <column datatype='integer' name='[sold_weekly]' role='measure' type='quantitative' />
            <column-instance column='[sold_monthly_feb]' derivation='Sum' name='[sum:sold_monthly_feb:qk]' pivot='key' type='quantitative' />
