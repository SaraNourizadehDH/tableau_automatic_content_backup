      </column>
      <column caption='Date - period' datatype='date' name='[Calculation_1654228486825398273]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#13;&#10;WHEN &quot;Weekly&quot; THEN [report_week]&#13;&#10;WHEN &quot;Monthly&quot; THEN [report_month]&#13;&#10;WHEN &quot;Quarterly&quot; THEN [report_quarter]&#13;&#10;END' />
      </column>
      <column caption='Avg. Items per order' datatype='real' name='[Calculation_1654228488433889282]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [confirmed_orders]=1 then [qty_sold] else 0 end)/SUM([confirmed_orders])' />
      </column>
      <column caption='Calculation2' datatype='real' name='[Calculation_1654228490767110147]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2797016889827160065] = MAX([Calculation_2797016889846480898]) then [country_name] else NULL end' />
