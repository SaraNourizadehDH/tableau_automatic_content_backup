              <calculation class='tableau' formula='SUM([Gbv Gross Of Vat 2 (copy)_1721782475298234368])/SUM([confirmed_orders])' />
            </column>
            <column caption='Failure Owner (%)' datatype='real' name='[Calculation_2353130835655344173]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([Failure Owner (%) (copy)_2353130835787022385]) / SUM( { EXCLUDE  [Failure Owner (%) (copy)_2353130835787022385] : SUM([Calculation_2353130835669901360]) } )' />
            </column>
            <column caption='1' datatype='integer' name='[Calculation_2353130835669901360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='Failure Reason' datatype='string' name='[Calculation_2353130836038262835]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='replace([failure_reason], &apos;_&apos;, &apos; &apos;)' />
            </column>
            <column caption='OOS Fail Rate' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_2797016889827160065]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2353130836038262835] = &quot;ITEM UNAVAILABLE&quot; and [Failure Owner (%) (copy)_2353130835787022385] = &apos;VENDOR&apos; then &apos;OOS Fail Rate&apos; ELSE NULL END' />
            </column>
            <column caption='experimental_group_curated' datatype='string' name='[Calculation_323696228717281284]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [experimental_group]&#13;&#10;WHEN &quot;C&quot; THEN &quot;Control&quot;&#13;&#10;WHEN &quot;T&quot; THEN &quot;Treatment&quot;&#13;&#10;ELSE &quot;Out Exp.&quot;&#13;&#10;END' />
            </column>
            <column caption='Sent Orders Ratio' datatype='real' name='[Calculation_323696228721029126]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [Calculation_323696228717281284] WHEN &quot;Treatment&quot; then [confirmed_orders] END)/&#13;&#10;SUM(CASE [Calculation_323696228717281284] WHEN &quot;Control&quot; THEN [confirmed_orders] END)' />
            </column>
            <column caption='Avg. Items per Order Ratio' datatype='real' name='[Calculation_323696228721340423]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg(CASE [Calculation_323696228717281284] WHEN &quot;Treatment&quot; then [qty_sold] END)/&#13;&#10;avg(CASE [Calculation_323696228717281284] WHEN &quot;Control&quot; then [qty_sold] END)' />
            </column>
            <column caption='Vendor Fail Rate Ratio' datatype='real' name='[Calculation_323696228722827272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(CASE [Calculation_323696228717281284] WHEN &quot;Treatment&quot; Then [Failed Orders Vendor (%) (copy)_917889931537559581] END)/&#13;&#10;SUM(CASE [Calculation_323696228717281284] WHEN &quot;Treatment&quot; Then [total_orders] END))/&#13;&#10;(SUM(CASE [Calculation_323696228717281284] WHEN &quot;Control&quot; Then [Failed Orders Vendor (%) (copy)_917889931537559581] END)/&#13;&#10;SUM(CASE [Calculation_323696228717281284] WHEN &quot;Control&quot; Then [total_orders] END))' />
            </column>
            <column caption='vendor_failed_orders' datatype='integer' name='[Failed Orders Vendor (%) (copy)_917889931537559581]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Failure Owner (%) (copy)_2353130835787022385] == &quot;VENDOR&quot; THEN 1 ELSE 0 end' />
            </column>
            <column caption='Failure Owner' datatype='string' default-role='measure' default-type='quantitative' name='[Failure Owner (%) (copy)_2353130835787022385]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [failure_owner] &#13;&#10;when &quot;CUSTOMER&quot; then &quot;CUSTOMER&quot;&#13;&#10;when  &quot;VENDOR&quot; THEN &quot;VENDOR&quot;&#13;&#10;WHEN  &quot;TRANSPORT&quot; THEN &quot;TRANSPORT&quot;&#13;&#10;WHEN   &quot;PLATFORM&quot; THEN  &quot;PLATFORM&quot;&#13;&#10;ELSE NULL END' />
              <aliases>
                <alias key='&quot;CUSTOMER&quot;' value='Customer' />
                <alias key='&quot;PLATFORM&quot;' value='Platform' />
                <alias key='&quot;TRANSPORT&quot;' value='Logistics' />
                <alias key='&quot;VENDOR&quot;' value='Vendor' />
              </aliases>
            </column>
            <column caption='Gbv Gross Of Vat - sent Orders' datatype='real' name='[Gbv Gross Of Vat 2 (copy)_1721782475298234368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [confirmed_orders]&#13;&#10;when 1 then [gbv_gross_of_vat_2] else 0&#13;&#10;END' />
            </column>
            <column caption='ABV Ratio' datatype='real' name='[OOS Failed Ratio (copy)_323696228726181899]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(CASE [Calculation_323696228717281284] WHEN &quot;Treatment&quot; Then [Gbv Gross Of Vat 2 (copy)_1721782475298234368] END)/&#13;&#10;SUM(CASE [Calculation_323696228717281284] WHEN &quot;Treatment&quot; Then [confirmed_orders] END))/&#13;&#10;(SUM(CASE [Calculation_323696228717281284] WHEN &quot;Control&quot; Then [Gbv Gross Of Vat 2 (copy)_1721782475298234368] END)/&#13;&#10;SUM(CASE [Calculation_323696228717281284] WHEN &quot;Control&quot; Then [confirmed_orders] END))' />
            </column>
            <column caption='Region ' datatype='string' name='[POS orders (copy)_1856327511277821954]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [region] &#13;&#10;WHEN &apos;MENA&apos; then [management_entity]&#13;&#10;else [region]&#13;&#10;END' />
            </column>
            <column caption='Total Orders Ratio' datatype='real' name='[Total Orders (copy)_323696228720152581]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [Calculation_323696228717281284] WHEN &quot;Treatment&quot; then [total_orders] END)/&#13;&#10;SUM(CASE [Calculation_323696228717281284] WHEN &quot;Control&quot; THEN [total_orders] END)' />
            </column>
            <column caption='GBV Ratio' datatype='real' name='[Total Orders Ratio (copy)_323696228726968332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [Calculation_323696228717281284] WHEN &quot;Treatment&quot; then [Gbv Gross Of Vat 2 (copy)_1721782475298234368] END)/&#13;&#10;SUM(CASE [Calculation_323696228717281284] WHEN &quot;Control&quot; THEN [Gbv Gross Of Vat 2 (copy)_1721782475298234368] END)' />
            </column>
            <column caption='OOS Failed Ratio' datatype='real' name='[Vendor Fail Rate Ratio (copy)_323696228723539977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNT(CASE [Calculation_323696228717281284] WHEN &quot;Treatment&quot; Then [Calculation_2797016889827160065] END)/&#13;&#10;SUM(CASE [Calculation_323696228717281284] WHEN &quot;Treatment&quot; Then [total_orders] END))/&#13;&#10;(COUNT(CASE [Calculation_323696228717281284] WHEN &quot;Control&quot; Then [Calculation_2797016889827160065] END)/&#13;&#10;SUM(CASE [Calculation_323696228717281284] WHEN &quot;Control&quot; Then [total_orders] END))' />
            </column>
            <column caption='PF Ratio' datatype='real' name='[Vendor Fail Rate Ratio (copy)_323696228724592650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(CASE [Calculation_323696228717281284] WHEN &quot;Treatment&quot; Then [is_partially_fulfilled] END)/&#13;&#10;SUM(CASE [Calculation_323696228717281284] WHEN &quot;Treatment&quot; Then (CASE [is_pelican] WHEN TRUE THEN [confirmed_orders] ELSE 0 END) END))/&#13;&#10;(SUM(CASE [Calculation_323696228717281284] WHEN &quot;Control&quot; Then [is_partially_fulfilled] END)/&#13;&#10;SUM(CASE [Calculation_323696228717281284] WHEN &quot;Control&quot; Then (CASE [is_pelican] WHEN TRUE THEN [confirmed_orders] ELSE 0 END) END))' />
            </column>
