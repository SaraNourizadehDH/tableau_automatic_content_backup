      </column>
      <column caption='Failure Owner (%)' datatype='real' name='[Calculation_2353130835655344173]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Failure Owner (%) (copy)_2353130835787022385]) / SUM( { EXCLUDE  [Failure Owner (%) (copy)_2353130835787022385] : SUM([Calculation_2353130835669901360]) } )' />
      </column>
      <column caption='item_unavailable' datatype='real' name='[Calculation_2353130835664744495]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(CASE [failure_reason] when &quot;ITEM_UNAVAILABLE&quot; then 1 else 0 end)/sum( { EXCLUDE [failure_owner] : count([failure_owner]) } )' />
      </column>
      <column caption='1' datatype='integer' name='[Calculation_2353130835669901360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Failure Reason' datatype='string' name='[Calculation_2353130836038262835]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='replace([failure_reason], &apos;_&apos;, &apos; &apos;)' />
      </column>
      <column caption='failure_reason_percentage' datatype='real' name='[Calculation_2353130836048289845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2353130835669901360])/sum({EXCLUDE [Calculation_2353130836038262835]: SUM([Calculation_2353130835669901360])})' />
      </column>
      <column caption='SFTP Vendors' datatype='integer' name='[Calculation_2353130836055408694]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([Calculation_2353130830678937611])' />
      </column>
      <column caption='Global_vendorId_discrete' datatype='string' name='[Calculation_2353130836056907833]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[global_entity_id]+[platform_vendor_id]' />
      </column>
      <column caption='Fill Rate' datatype='real' name='[Calculation_2396196510254292995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Gbv Gross Of Vat 2 (copy)_1721782475298234368]/[all_gmv]' />
      </column>
      <column caption='Items OOS in PF Order' datatype='integer' name='[Calculation_2542000550323851264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [is_sent]&#13;&#10;WHEN True then [qty_ordered]-[qty_sold]&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Rate Items OOS in a PF Order' datatype='real' name='[Calculation_2542000550324420609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_2542000550323851264])/sum([partial_orders])' />
      </column>
      <column caption='OOS Fail Rate' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_2797016889827160065]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2353130836038262835] = &quot;ITEM UNAVAILABLE&quot; and [Failure Owner (%) (copy)_2353130835787022385] = &apos;VENDOR&apos; then &apos;OOS Fail Rate&apos; ELSE NULL END' />
      </column>
      <column caption='OOS Fail Rate  (%)' datatype='real' name='[Calculation_2797016889846480898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Calculation_2797016889827160065])/sum([total_orders])' />
      </column>
      <column caption='Partial Fulfillment Orders Count' datatype='integer' name='[Calculation_323696227235770369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_partially_fulfilled])' />
      </column>
      <column caption='placed_at_MY' datatype='datetime' name='[Calculation_323696227248377858]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATEADD(&apos;hour&apos;, 7, [order_placed_at])' />
      </column>
      <column caption='Ratio Orders Treatment Control' datatype='real' name='[Calculation_323696228711616515]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(CASE [experimental_group] WHEN &quot;Treatment&quot; THEN [total_orders] else 0 end)/&#13;&#10;sum(CASE [experimental_group] WHEN &quot;Control&quot; THEN [total_orders] else 0 end)' />
      </column>
      <column caption='experimental_group_curated' datatype='string' name='[Calculation_323696228717281284]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [experimental_group]&#13;&#10;WHEN &quot;C&quot; THEN &quot;Control&quot;&#13;&#10;WHEN &quot;T&quot; THEN &quot;Treatment&quot;&#13;&#10;ELSE &quot;Out Exp.&quot;&#13;&#10;END' />
      </column>
      <column caption='Sent Orders Ratio' datatype='real' name='[Calculation_323696228721029126]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(CASE [Calculation_323696228717281284] WHEN &quot;Treatment&quot; then [confirmed_orders] END)/&#13;&#10;SUM(CASE [Calculation_323696228717281284] WHEN &quot;Control&quot; THEN [confirmed_orders] END)' />
      </column>
      <column caption='Avg. Items per Order Ratio' datatype='real' name='[Calculation_323696228721340423]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg(CASE [Calculation_323696228717281284] WHEN &quot;Treatment&quot; then [qty_sold] END)/&#13;&#10;avg(CASE [Calculation_323696228717281284] WHEN &quot;Control&quot; then [qty_sold] END)' />
      </column>
      <column caption='Vendor Fail Rate Ratio' datatype='real' name='[Calculation_323696228722827272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(CASE [Calculation_323696228717281284] WHEN &quot;Treatment&quot; Then [Failed Orders Vendor (%) (copy)_917889931537559581] END)/&#13;&#10;SUM(CASE [Calculation_323696228717281284] WHEN &quot;Treatment&quot; Then [total_orders] END))/&#13;&#10;(SUM(CASE [Calculation_323696228717281284] WHEN &quot;Control&quot; Then [Failed Orders Vendor (%) (copy)_917889931537559581] END)/&#13;&#10;SUM(CASE [Calculation_323696228717281284] WHEN &quot;Control&quot; Then [total_orders] END))' />
      </column>
      <column caption='GMV Loss OOS' datatype='real' name='[Calculation_539024584589996032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gbv_loss_oos_orders])+sum([partial_fulfilled_gmv_loss])' />
      </column>
      <column caption='Tiers' datatype='string' name='[Calculation_917889930189365249]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [store_type_l2]&#13;&#10;WHEN &apos;Groceries&apos; then &apos;Tier 1&apos;&#13;&#10;WHEN &apos;Supermarket&apos; then &apos;Tier 1&apos;&#13;&#10;WHEN &apos;Confectionery&apos; then &apos;Tier 2&apos;&#13;&#10;WHEN &apos;Convenience&apos; then &apos;Tier 2&apos;&#13;&#10;WHEN &apos;Drinks&apos; then &apos;Tier 2&apos;&#13;&#10;WHEN &apos;Health &amp; Wellness&apos; then &apos;Tier 2&apos;&#13;&#10;WHEN &apos;Health Supplements&apos; then &apos;Tier 2&apos;&#13;&#10;WHEN &apos;Party Supplies&apos; then &apos;Tier 2&apos;&#13;&#10;WHEN &apos;Pharmacies&apos; then &apos;Tier 2&apos;&#13;&#10;WHEN &apos;Snacks &amp; Sweets&apos; then &apos;Tier 2&apos;&#13;&#10;WHEN &apos;Beauty&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Cosmetics&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Delicatessen&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Electronics&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Fashion&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Flowers&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Games&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Home &amp; Gifts&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Just For Adults&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Kiosks&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Mother &amp; Baby&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Optics&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Pets&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Sports &amp; Lifestyle&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Stationery&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Stationery &amp; Books&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Tobacco&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Toys&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Bakery&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Butchery&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Cross Vertical&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Fishery&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Street Food&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Vehicles&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN NULL then &apos;Tier 3&apos;&#13;&#10;ELSE Null&#13;&#10;END' />
      </column>
      <column caption='index' datatype='integer' name='[Calculation_917889930460004354]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='1 Rank' datatype='integer' name='[Calculation_917889930473201671]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Calculation_2353130835669901360]),&apos;desc&apos;)'>
