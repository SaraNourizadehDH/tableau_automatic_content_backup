      <group caption='Others' name='[Set 1]' name-style='unqualified' user:ui-builder='lasso-group'>
        <groupfilter function='crossjoin'>
          <groupfilter function='empty-level' member='[failure_reason]' />
          <groupfilter function='empty-level' member='[Calculation_2353130836038262835]' />
        </groupfilter>
      </group>
      <group caption='failure_reason_space Set' name='[failure_reason_space Set]' name-style='unqualified' user:ui-builder='filter-group'>
        <groupfilter count='[Parameters].[failure_reason_space Parameter]' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
          <groupfilter direction='DESC' expression='COUNT([Failure Owner (%) (copy)_2353130835787022385])' function='order' user:ui-marker='order'>
            <groupfilter function='level-members' level='[Calculation_2353130836038262835]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </groupfilter>
        </groupfilter>
      </group>
      <drill-paths>
        <drill-path name='Chain Name, Vendor Name'>
          <field>[chain_name]</field>
          <field>[vendor_name]</field>
        </drill-path>
      </drill-paths>
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-aliased-fields='true' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[yr:report_month:ok]' type='palette'>
            <map to='#4e79a7'>
              <bucket>2021</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>2022</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:failure_owner:nk]&#10;[:Measure Names]' type='palette'>
            <map-pri to='multiordinal_blue_10_0'>
              <bucket>&quot;FULFILMENT&quot;</bucket>
            </map-pri>
            <map-pri to='multiordinal_gold_10_0'>
              <bucket>&quot;VENDOR&quot;</bucket>
            </map-pri>
            <map-pri to='multiordinal_gray_10_0'>
              <bucket>&quot;PLATFORM&quot;</bucket>
            </map-pri>
            <map-pri to='multiordinal_orange_10_0'>
              <bucket>%null%</bucket>
            </map-pri>
            <map-pri to='multiordinal_red_10_0'>
              <bucket>&quot;TRANSPORT&quot;</bucket>
            </map-pri>
            <map-pri to='multiordinal_teal_10_0'>
              <bucket>&quot;CUSTOMER&quot;</bucket>
            </map-pri>
          </encoding>
          <encoding attr='color' field='[none:failure_reason:nk]' type='palette'>
            <map to='#499894'>
              <bucket>&quot;COURIER_UNREACHABLE&quot;</bucket>
            </map>
            <map to='#499894'>
              <bucket>&quot;OUTSIDE_SERVICE_HOURS&quot;</bucket>
            </map>
            <map to='#4e79a7'>
              <bucket>&quot;ADDRESS_INCOMPLETE_MISSTATED&quot;</bucket>
            </map>
            <map to='#4e79a7'>
