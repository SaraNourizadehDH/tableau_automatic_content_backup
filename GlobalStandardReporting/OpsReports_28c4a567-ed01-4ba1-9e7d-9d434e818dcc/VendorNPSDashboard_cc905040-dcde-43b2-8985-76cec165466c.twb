              <calculation class='tableau' formula='CASE [store_type_l2]&#13;&#10;WHEN &apos;Groceries&apos; then &apos;Tier 1&apos;&#13;&#10;WHEN &apos;Supermarket&apos; then &apos;Tier 1&apos;&#13;&#10;WHEN &apos;Confectionery&apos; then &apos;Tier 2&apos;&#13;&#10;WHEN &apos;Convenience&apos; then &apos;Tier 2&apos;&#13;&#10;WHEN &apos;Drinks&apos; then &apos;Tier 2&apos;&#13;&#10;WHEN &apos;Health &amp; Wellness&apos; then &apos;Tier 2&apos;&#13;&#10;WHEN &apos;Health Supplements&apos; then &apos;Tier 2&apos;&#13;&#10;WHEN &apos;Party Supplies&apos; then &apos;Tier 2&apos;&#13;&#10;WHEN &apos;Pharmacies&apos; then &apos;Tier 2&apos;&#13;&#10;WHEN &apos;Snacks &amp; Sweets&apos; then &apos;Tier 2&apos;&#13;&#10;WHEN &apos;Beauty&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Cosmetics&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Delicatessen&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Electronics&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Fashion&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Flowers&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Games&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Home &amp; Gifts&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Just For Adults&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Kiosks&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Mother &amp; Baby&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Optics&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Pets&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Sports &amp; Lifestyle&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Stationery&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Stationery &amp; Books&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Tobacco&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Toys&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Bakery&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Butchery&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Cross Vertical&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Fishery&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Street Food&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN &apos;Vehicles&apos; then &apos;Tier 3&apos;&#13;&#10;WHEN NULL then &apos;Tier 3&apos;&#13;&#10;ELSE &apos;Tier 3&apos;&#13;&#10;END' />
