              <calculation class='tableau' formula='#2025-01-01#' />
            </column>
            <column caption='P_Date_Type' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;월별&quot;'>
              <calculation class='tableau' formula='&quot;월별&quot;' />
            </column>
            <column caption='P_End_Date' datatype='date' default-format='*yyyy-MM-dd' name='[매개 변수 2]' param-domain-type='any' role='measure' type='quantitative' value='#2025-04-08#'>
              <calculation class='tableau' formula='#2025-04-08#' />
            </column>
            <column caption='P_합계/일평균' datatype='string' name='[매개 변수 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;합계&quot;'>
              <calculation class='tableau' formula='&quot;합계&quot;' />
            </column>
            <column caption='P_사용자/채널4' datatype='string' name='[매개 변수 4 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;사용자별&quot;'>
              <calculation class='tableau' formula='&quot;사용자별&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.06zwgvs1brlccr14yg2oi0d7fn9z'>
            <column caption='C_FCR대상고객상담인입수' datatype='real' name='[C_고객상담인입수(복사본)_916764001347473413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 3] = &apos;합계&apos;&#13;&#10;THEN &#13;&#10;SUM({ FIXED [part_date], [base_dt_type], [lv1_svc_cd], [lv2_svc_cd], [cs_cust_div_cd], [cs_cate_lv1_nm], [cs_cate_lv2_nm], [cs_ch_cd]: MIN([fcr_bound_cnt])})&#13;&#10;ELSE SUM({ FIXED [part_date], [base_dt_type], [lv1_svc_cd], [lv2_svc_cd], [cs_cust_div_cd], [cs_cate_lv1_nm], [cs_cate_lv2_nm], [cs_ch_cd]: MIN([fcr_bound_cnt])}) / [Calculation_439101031524237312]&#13;&#10;END' />
            </column>
            <column caption='C_관점전환_Depth2' datatype='string' name='[C_관점전환1_Depth1_업주/전화(복사본)_249949845021360132]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 4 1]&#13;&#10;WHEN &apos;사용자별&apos;&#13;&#10;THEN [Calculation_1465640267661090818]&#13;&#10;ELSE [Calculation_1465640267661160451]&#13;&#10;END' />
            </column>
            <column caption='C_고객상담인입수' datatype='real' name='[Calculation_101893943572717569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 3] = &apos;합계&apos;&#13;&#10;THEN &#13;&#10;SUM({ FIXED [part_date], [base_dt_type], [lv1_svc_cd], [lv2_svc_cd], [cs_cust_div_cd], [cs_cate_lv1_nm], [cs_cate_lv2_nm], [cs_ch_cd]: MIN([cs_bound_cnt])})&#13;&#10;ELSE SUM({ FIXED [part_date], [base_dt_type], [lv1_svc_cd], [lv2_svc_cd], [cs_cust_div_cd], [cs_cate_lv1_nm], [cs_cate_lv2_nm], [cs_ch_cd]: MIN([cs_bound_cnt])}) / [Calculation_439101031524237312]&#13;&#10;END' />
            </column>
            <column caption='cs_ch_nm' datatype='string' name='[Calculation_1465640267661090818]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [cs_ch_cd]&#13;&#10;WHEN &apos;In&apos; THEN &apos;전화&apos;&#13;&#10;WHEN &apos;Chat&apos; THEN &apos;채팅&apos;&#13;&#10;END' />
            </column>
            <column caption='cs_cust_div_nm' datatype='string' name='[Calculation_1465640267661160451]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [cs_cust_div_cd]&#13;&#10;WHEN &apos;Cust&apos; THEN &apos;고객&apos;&#13;&#10;WHEN &apos;Owner&apos; THEN &apos;업주&apos;&#13;&#10;END' />
            </column>
            <column caption='C_관점전환_Depth1' datatype='string' name='[Calculation_249949845021097987]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 4 1]&#13;&#10;WHEN &apos;사용자별&apos;&#13;&#10;THEN [Calculation_1465640267661160451]&#13;&#10;ELSE [Calculation_1465640267661090818]&#13;&#10;END' />
            </column>
            <column caption='C_분모_평균용' datatype='integer' name='[Calculation_439101031524237312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX({FIXED [part_date], [base_dt_type]:  MAX([date_cnt])})' />
            </column>
            <column caption='상담 인입건' datatype='real' name='[Calculation_689613697356759108]' role='measure' type='quantitative' user:unnamed='3-2-1. 채팅/업주 첫고객 문의 처리율 KPI_상단'>
              <calculation class='tableau' formula='//상담 인입건&#13;&#10;[Calculation_101893943572717569]' />
            </column>
            <column caption='첫 고객문의 처리율(FCR)' datatype='real' name='[Calculation_804455490725670935]' role='measure' type='quantitative' user:unnamed='3-2-1. 채팅/업주 첫고객 문의 처리율 KPI_상단'>
              <calculation class='tableau' formula='//첫 고객문의 처리율(FCR)&#13;&#10;[Calculation_916764001348624398]' />
            </column>
            <column caption='F_Date_Type' datatype='boolean' name='[Calculation_804455490726842394]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; &#13;&#10;THEN &#13;&#10;[base_dt_type] = &apos;M&apos; AND&#13;&#10;DATETRUNC(&apos;month&apos;,[part_date]) = DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;주별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;W&apos; AND&#13;&#10;DATETRUNC(&apos;iso-week&apos;,[part_date]) = DATETRUNC(&apos;iso-week&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;일별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;D&apos; AND&#13;&#10;DATETRUNC(&apos;day&apos;,[Parameters].[P_End_Date(복사본)_1465640267664707590])&lt;=DATETRUNC(&apos;day&apos;,[part_date]) AND &#13;&#10;DATETRUNC(&apos;day&apos;,[part_date]) &lt;= DATETRUNC(&apos;day&apos;,[Parameters].[매개 변수 2])&#13;&#10;END' />
            </column>
            <column caption='C_첫고객 문의 처리율' datatype='real' name='[Calculation_916764001348624398]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[C_고객상담인입수(복사본)_916764001347473413] / [Calculation_101893943572717569]' />
            </column>
            <column caption='F_관점전환_KPI_2' datatype='boolean' name='[F_관점전환_KPI_1(복사본)_2044352824049823744]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 4 1]&#13;&#10;WHEN &quot;사용자별&quot; THEN [Calculation_249949845021097987] = &quot;고객&quot;&#13;&#10;ELSE [Calculation_249949845021097987] = &quot;채팅&quot;&#13;&#10;END' />
            </column>
            <column caption='F_관점전환_KPI_2-1' datatype='boolean' name='[F_관점전환_KPI_1-1(복사본)_2044352824049823745]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 4 1]&#13;&#10;WHEN &quot;사용자별&quot; THEN [C_관점전환1_Depth1_업주/전화(복사본)_249949845021360132] = &quot;전화&quot;&#13;&#10;ELSE [C_관점전환1_Depth1_업주/전화(복사본)_249949845021360132] = &quot;업주&quot;&#13;&#10;END' />
            </column>
