    <worksheet name='8-1. 도급사별만족도_전화/고객(라인)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='11'>Æ  </run>
            <run bold='true' fontcolor='#4588d3' fontsize='11'>고객</run>
            <run bold='true' fontsize='11'> 상담만족도(전화) | </run>
            <run bold='true' fontcolor='#4588d3' fontsize='11'><![CDATA[<[sqlproxy.07lo21j1kjaglp10n2wgh077s805].[none:C_문의유형_title_전화업주(복사본)_1169247055102640128 1:nk]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='6_3_CS_상담품질(고객만족도)' name='sqlproxy.07lo21j1kjaglp10n2wgh077s805' />
            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='P_Start_Date' datatype='date' default-format='*yyyy-MM-dd' name='[P_End_Date(복사본)_1465640267664707590]' param-domain-type='any' role='measure' type='quantitative' value='#2025-01-01#'>
              <calculation class='tableau' formula='#2025-01-01#' />
            </column>
            <column caption='P_도급사_전화(고객)_고객만족도' datatype='string' name='[P_서비스유형_전화(고객)(복사본)_1315051093167026242]' param-domain-type='any' role='measure' type='nominal' value='&quot;전체&quot;'>
              <calculation class='tableau' formula='&quot;전체&quot;' />
            </column>
            <column caption='P_Date_Type' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;월별&quot;'>
              <calculation class='tableau' formula='&quot;월별&quot;' />
            </column>
            <column caption='P_End_Date' datatype='date' default-format='*yyyy-MM-dd' name='[매개 변수 2]' param-domain-type='any' role='measure' type='quantitative' value='#2025-04-08#'>
              <calculation class='tableau' formula='#2025-04-08#' />
            </column>
            <column caption='P_합계/일평균' datatype='string' name='[매개 변수 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;합계&quot;'>
              <calculation class='tableau' formula='&quot;합계&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.07lo21j1kjaglp10n2wgh077s805'>
            <column caption='C_도급사별_title_전화고객' datatype='string' name='[C_문의유형_title_전화업주(복사본)_1169247055102640128 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[P_서비스유형_전화(고객)(복사본)_1315051093167026242] = &quot;전체&quot; THEN &quot;전체&quot; ELSE [Calculation_1315051093163081778] END' />
            </column>
            <column caption='ZN([C_고객만족도])' datatype='real' name='[Calculation_1315051093111648265]' role='measure' type='quantitative' user:unnamed='시트 25'>
              <calculation class='tableau' formula='ZN([Calculation_195625110385020938])' />
            </column>
            <column caption='도급사' datatype='string' name='[Calculation_1315051093163081778]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[cs_agency_nm]' />
            </column>
            <column caption='cs_ch_nm' datatype='string' name='[Calculation_1465640267661090818]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [cs_ch_cd]&#13;&#10;WHEN &apos;In&apos; THEN &apos;전화&apos;&#13;&#10;WHEN &apos;Chat&apos; THEN &apos;채팅&apos;&#13;&#10;END' />
            </column>
            <column caption='cs_cust_div_nm' datatype='string' name='[Calculation_1465640267661160451]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [cs_cust_div_cd]&#13;&#10;WHEN &apos;Cust&apos; THEN &apos;고객&apos;&#13;&#10;WHEN &apos;Owner&apos; THEN &apos;업주&apos;&#13;&#10;END' />
            </column>
            <column caption='F_Date_Type_트렌드' datatype='boolean' name='[Calculation_1465640267664797703]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; &#13;&#10;THEN &#13;&#10;[base_dt_type] = &apos;M&apos; AND&#13;&#10;DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-12,[Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;month&apos;,[part_date]) AND&#13;&#10;DATETRUNC(&apos;month&apos;,[part_date]) &lt;= DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;주별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;W&apos; AND&#13;&#10;DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-11,[Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;iso-week&apos;,[part_date]) AND &#13;&#10;DATETRUNC(&apos;iso-week&apos;,[part_date]) &lt;= DATETRUNC(&apos;iso-week&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;일별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;D&apos; AND&#13;&#10;DATETRUNC(&apos;day&apos;,[Parameters].[P_End_Date(복사본)_1465640267664707590])&lt;=DATETRUNC(&apos;day&apos;,[part_date]) AND &#13;&#10;DATETRUNC(&apos;day&apos;,[part_date]) &lt;= DATETRUNC(&apos;day&apos;,[Parameters].[매개 변수 2])&#13;&#10;END' />
            </column>
            <column caption='C_설문답변수' datatype='real' name='[Calculation_195625110383087624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 3] = &apos;합계&apos;&#13;&#10;THEN &#13;&#10;SUM({ FIXED [part_date], [base_dt_type], [lv1_svc_cd], [lv2_svc_cd], [cs_cust_div_cd], [cs_agency_nm], [cs_ch_cd]: MIN([score_cnt])})&#13;&#10;ELSE SUM({ FIXED [part_date], [base_dt_type], [lv1_svc_cd], [lv2_svc_cd], [cs_cust_div_cd], [cs_agency_nm], [cs_ch_cd]: MIN([score_cnt])}) / [Calculation_439101031524237312]&#13;&#10;END' />
            </column>
            <column caption='C_4점이상 답변수' datatype='real' name='[Calculation_195625110384836617]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 3] = &apos;합계&apos;&#13;&#10;THEN &#13;&#10;SUM({ FIXED [part_date], [lv1_svc_cd], [lv2_svc_cd], [cs_cust_div_cd], [base_dt_type], [cs_agency_nm], [cs_ch_cd]: MIN([over4_score_cnt])})&#13;&#10;ELSE SUM({ FIXED [part_date], [lv1_svc_cd], [lv2_svc_cd], [cs_cust_div_cd], [base_dt_type], [cs_agency_nm], [cs_ch_cd]: MIN([over4_score_cnt])}) / [Calculation_439101031524237312]&#13;&#10;END' />
            </column>
            <column caption='C_고객만족도' datatype='real' name='[Calculation_195625110385020938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_195625110384836617] / [Calculation_195625110383087624]' />
            </column>
            <column caption='C_분모_평균용' datatype='integer' name='[Calculation_439101031524237312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX({FIXED [part_date], [base_dt_type]:  MAX([date_cnt])})' />
            </column>
            <column caption='C_Date_Axis' datatype='datetime' name='[Calculation_55450634679939073]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;일별&apos; THEN DATETRUNC(&apos;day&apos;, DATE([part_date]))&#13;&#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;iso-week&apos;, DATE([part_date]))&#13;&#10;WHEN &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;, DATE([part_date]))&#13;&#10;END' />
            </column>
            <column caption='C_Date_Label' datatype='string' name='[Calculation_55450634683031554]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;    THEN MID(STR([part_date]),6,2) + &quot;/&quot; + MID(STR([part_date]),9,2)&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;주별&apos; &#13;&#10;&#13;&#10;    THEN MID(STR([part_date]),6,2)+ &quot;/&quot; + MID(STR([part_date]),9,2)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;월별&apos; &#13;&#10;&#13;&#10;    THEN &quot;`&quot; + MID(STR([part_date]),3,2)+ &quot;.&quot; + MID(STR([part_date]),6,2)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='날짜' datatype='string' name='[Calculation_86412885685723151]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_55450634683031554]' />
            </column>
            <column caption='F_도급사별 만족도_전화고객' datatype='boolean' name='[F_유형별처리_전화업주(복사본)_231091024416190473 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1465640267661160451] = &quot;고객&quot;&#13;&#10;AND &#13;&#10;[Calculation_1465640267661090818] = &quot;전화&quot;' />
            </column>
            <column caption='TF_도급사 선택_전화고객' datatype='boolean' name='[TF_유형선택_전화업주(복사본)_1169247055103856643 1]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1315051093163081778] = [Parameters].[P_서비스유형_전화(고객)(복사본)_1315051093167026242]&#13;&#10;or&#13;&#10;[Parameters].[P_서비스유형_전화(고객)(복사본)_1315051093167026242] = &quot;전체&quot;' />
            </column>
            <column-instance column='[Calculation_86412885685723151]' derivation='Attribute' name='[attr:Calculation_86412885685723151:nk]' pivot='key' type='nominal' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[base_dt_type]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[cs_agency_nm]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[cs_ch_cd]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[cs_cust_div_cd]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[date_cnt]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[lv1_svc_cd]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[lv2_svc_cd]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column-instance column='[C_문의유형_title_전화업주(복사본)_1169247055102640128 1]' derivation='None' name='[none:C_문의유형_title_전화업주(복사본)_1169247055102640128 1:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1315051093163081778]' derivation='None' name='[none:Calculation_1315051093163081778:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1465640267664797703]' derivation='None' name='[none:Calculation_1465640267664797703:nk]' pivot='key' type='nominal' />
            <column-instance column='[F_유형별처리_전화업주(복사본)_231091024416190473 1]' derivation='None' name='[none:F_유형별처리_전화업주(복사본)_231091024416190473 1:nk]' pivot='key' type='nominal' />
            <column-instance column='[TF_유형선택_전화업주(복사본)_1169247055103856643 1]' derivation='None' name='[none:TF_유형선택_전화업주(복사본)_1169247055103856643 1:nk]' pivot='key' type='nominal' />
            <column-instance column='[cs_ch_cd]' derivation='None' name='[none:cs_ch_cd:nk]' pivot='key' type='nominal' />
