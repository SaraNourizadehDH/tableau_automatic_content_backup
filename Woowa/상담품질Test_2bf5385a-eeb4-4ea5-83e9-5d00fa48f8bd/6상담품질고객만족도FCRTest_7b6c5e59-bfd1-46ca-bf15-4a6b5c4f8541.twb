            </column>
            <column caption='P_도급사_전화(업주)_고객만족도' datatype='string' name='[P_서비스유형_전화(업주)(복사본)_1315051093167026244]' param-domain-type='any' role='measure' type='nominal' value='&quot;전체&quot;'>
