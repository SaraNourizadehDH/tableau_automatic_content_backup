              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; &#13;&#10;THEN &#13;&#10;[base_dt_type] = &apos;M&apos; AND&#13;&#10;DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-12,[Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;month&apos;,[part_date]) AND&#13;&#10;DATETRUNC(&apos;month&apos;,[part_date]) &lt;= DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;주별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;W&apos; AND&#13;&#10;DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-11,[Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;iso-week&apos;,[part_date]) AND &#13;&#10;DATETRUNC(&apos;iso-week&apos;,[part_date]) &lt;= DATETRUNC(&apos;iso-week&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;일별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;D&apos; AND&#13;&#10;DATETRUNC(&apos;day&apos;,[Parameters].[P_End_Date(복사본)_1465640267664707590])&lt;=DATETRUNC(&apos;day&apos;,[part_date]) AND &#13;&#10;DATETRUNC(&apos;day&apos;,[part_date]) &lt;= DATETRUNC(&apos;day&apos;,[Parameters].[매개 변수 2])&#13;&#10;END' />
            </column>
            <column caption='C_설문답변수' datatype='real' name='[Calculation_195625110383087624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 3] = &apos;합계&apos;&#13;&#10;THEN &#13;&#10;SUM({ FIXED [part_date], [base_dt_type], [lv1_svc_cd], [lv2_svc_cd], [cs_cust_div_cd], [cs_agency_nm], [cs_ch_cd]: MIN([score_cnt])})&#13;&#10;ELSE SUM({ FIXED [part_date], [base_dt_type], [lv1_svc_cd], [lv2_svc_cd], [cs_cust_div_cd], [cs_agency_nm], [cs_ch_cd]: MIN([score_cnt])}) / [Calculation_439101031524237312]&#13;&#10;END' />
            </column>
            <column caption='C_4점이상 답변수' datatype='real' name='[Calculation_195625110384836617]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 3] = &apos;합계&apos;&#13;&#10;THEN &#13;&#10;SUM({ FIXED [part_date], [lv1_svc_cd], [lv2_svc_cd], [cs_cust_div_cd], [base_dt_type], [cs_agency_nm], [cs_ch_cd]: MIN([over4_score_cnt])})&#13;&#10;ELSE SUM({ FIXED [part_date], [lv1_svc_cd], [lv2_svc_cd], [cs_cust_div_cd], [base_dt_type], [cs_agency_nm], [cs_ch_cd]: MIN([over4_score_cnt])}) / [Calculation_439101031524237312]&#13;&#10;END' />
            </column>
            <column caption='C_고객만족도' datatype='real' name='[Calculation_195625110385020938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_195625110384836617] / [Calculation_195625110383087624]' />
            </column>
            <column caption='C_분모_평균용' datatype='integer' name='[Calculation_439101031524237312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX({FIXED [part_date], [base_dt_type]:  MAX([date_cnt])})' />
            </column>
            <column caption='C_Date_Axis' datatype='datetime' name='[Calculation_55450634679939073]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;일별&apos; THEN DATETRUNC(&apos;day&apos;, DATE([part_date]))&#13;&#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;iso-week&apos;, DATE([part_date]))&#13;&#10;WHEN &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;, DATE([part_date]))&#13;&#10;END' />
            </column>
            <column caption='C_Date_Label' datatype='string' name='[Calculation_55450634683031554]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;    THEN MID(STR([part_date]),6,2) + &quot;/&quot; + MID(STR([part_date]),9,2)&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;주별&apos; &#13;&#10;&#13;&#10;    THEN MID(STR([part_date]),6,2)+ &quot;/&quot; + MID(STR([part_date]),9,2)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;월별&apos; &#13;&#10;&#13;&#10;    THEN &quot;`&quot; + MID(STR([part_date]),3,2)+ &quot;.&quot; + MID(STR([part_date]),6,2)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='날짜' datatype='string' name='[Calculation_86412885685723151]' role='dimension' type='nominal'>
