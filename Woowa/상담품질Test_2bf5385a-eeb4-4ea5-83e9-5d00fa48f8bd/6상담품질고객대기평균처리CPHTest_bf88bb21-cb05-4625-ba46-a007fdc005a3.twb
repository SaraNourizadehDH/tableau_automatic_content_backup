          <datasource-dependencies datasource='Parameters'>
            <column caption='P_사용자/채널2' datatype='string' name='[P_사용자/채널(복사본)_555631605623648256]' param-domain-type='list' role='measure' type='nominal' value='&quot;사용자별&quot;'>
              <calculation class='tableau' formula='&quot;사용자별&quot;' />
            </column>
            <column caption='P_Start_Date' datatype='date' name='[매개 변수 1]' param-domain-type='any' role='measure' type='quantitative' value='#2025-04-01#'>
              <calculation class='tableau' formula='#2025-04-01#' />
            </column>
            <column caption='P_End_Date' datatype='date' name='[매개 변수 2]' param-domain-type='any' role='measure' type='quantitative' value='#2025-04-16#'>
              <calculation class='tableau' formula='#2025-04-16#' />
            </column>
            <column caption='P_합계/일평균' datatype='string' name='[매개 변수 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;합계&quot;'>
              <calculation class='tableau' formula='&quot;합계&quot;' />
            </column>
            <column caption='P_Date_Type' datatype='string' name='[매개 변수 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;일별&quot;'>
              <calculation class='tableau' formula='&quot;일별&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.012kaq90564mq217a2kir0hz1ixh'>
            <column caption='C_관점전환_Depth1-1' datatype='string' name='[C_관점전환_Depth1(복사본)_891994202795163652]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[P_사용자/채널(복사본)_555631605623648256]&#13;&#10;WHEN &apos;사용자별&apos;&#13;&#10;THEN [Calculation_665969863396368392]&#13;&#10;ELSE [Calculation_665969863396323335]&#13;&#10;END' />
            </column>
            <column caption='C_관점전환_Depth2-1' datatype='string' name='[C_관점전환_Depth2(복사본)_891994202795163651]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[P_사용자/채널(복사본)_555631605623648256]&#13;&#10;WHEN &apos;사용자별&apos;&#13;&#10;THEN [Calculation_665969863396323335]&#13;&#10;ELSE [Calculation_665969863396368392]&#13;&#10;END' />
            </column>
            <column caption='상담 응대건' datatype='real' name='[Calculation_251075683683729435]' role='measure' type='quantitative' user:unnamed='4-5.KPI_업주/전화_하단'>
              <calculation class='tableau' formula='// 상담 응대건 &#13;&#10;[Calculation_891994202808274958]' />
            </column>
            <column caption='F_Date_Type' datatype='boolean' name='[Calculation_453174719756541967]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 5]&#13;&#10;WHEN &apos;월별&apos; &#13;&#10;THEN &#13;&#10;[base_dt_type] = &apos;M&apos; AND&#13;&#10;DATETRUNC(&apos;month&apos;,[part_date]) = DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;주별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;W&apos; AND&#13;&#10;DATETRUNC(&apos;iso-week&apos;,[part_date]) = DATETRUNC(&apos;iso-week&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;일별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;D&apos; AND&#13;&#10;DATETRUNC(&apos;day&apos;,[Parameters].[매개 변수 1])&lt;=DATETRUNC(&apos;day&apos;,[part_date]) AND &#13;&#10;DATETRUNC(&apos;day&apos;,[part_date]) &lt;= DATETRUNC(&apos;day&apos;,[Parameters].[매개 변수 2])&#13;&#10;END' />
            </column>
            <column caption='평균처리시간     (AHT)' datatype='real' name='[Calculation_453174719780888629]' role='measure' type='quantitative' user:unnamed='4-5.KPI_업주/전화_하단'>
              <calculation class='tableau' formula='//평균처리시간     (AHT)&#13;&#10;[Calculation_891994202805895179]' />
            </column>
            <column caption='cs_ch_nm' datatype='string' name='[Calculation_665969863396323335]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [cs_ch_cd]&#13;&#10;WHEN &apos;In&apos; THEN &apos;전화&apos;&#13;&#10;WHEN &apos;Chat&apos; THEN &apos;채팅&apos;&#13;&#10;END' />
            </column>
            <column caption='cs_cust_div_nm' datatype='string' name='[Calculation_665969863396368392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [cs_cust_div_cd]&#13;&#10;WHEN &apos;Cust&apos; THEN &apos;고객&apos;&#13;&#10;WHEN &apos;Owner&apos; THEN &apos;업주&apos;&#13;&#10;END' />
            </column>
            <column caption='C_분모_평균용' datatype='integer' name='[Calculation_665969863396528139]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX({FIXED [part_date], [base_dt_type]:  MAX([date_cnt])})' />
            </column>
            <column caption='C_평균처리시간' datatype='real' name='[Calculation_891994202805895179]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([call_time_sscnt]) + sum([acwt_sscnt])) / sum([csagent_resp_cnt])' />
            </column>
            <column caption='C_상담원응대수' datatype='real' name='[Calculation_891994202808274958]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 4]&#13;&#10;WHEN &apos;합계&apos;&#13;&#10;THEN&#13;&#10;SUM([csagent_resp_cnt])&#13;&#10;ELSE&#13;&#10;SUM([csagent_resp_cnt]) / [Calculation_665969863396528139]&#13;&#10;END' />
            </column>
            <column caption='상담원응대수' datatype='real' name='[Calculation_891994202812071962]' role='measure' type='quantitative' user:unnamed='4-1.KPI_업주/전화_하단'>
              <calculation class='tableau' formula='// 상담원응대수 &#13;&#10;[Calculation_891994202808274958]' />
            </column>
            <column caption='F_관점전환2_고객/채팅2' datatype='boolean' name='[F_관점전환2_고객/채팅(복사본)_891994202795016194]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[P_사용자/채널(복사본)_555631605623648256]&#13;&#10;WHEN &apos;사용자별&apos; &#13;&#10;THEN [Calculation_665969863396368392] = &apos;고객&apos;&#13;&#10;ELSE [Calculation_665969863396323335] = &apos;채팅&apos;&#13;&#10;END' />
            </column>
