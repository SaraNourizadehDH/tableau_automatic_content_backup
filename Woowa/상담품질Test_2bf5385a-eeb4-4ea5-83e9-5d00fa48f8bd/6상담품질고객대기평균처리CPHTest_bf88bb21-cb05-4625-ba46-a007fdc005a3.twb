      <column caption='C_관점전환_Title_트렌드_1' datatype='string' name='[Calculation_995014110410117125]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3]&#13;&#10;WHEN &apos;사용자별&apos; THEN &apos;업주 대기시간&apos;&#13;&#10;ELSE &apos;전화 대기시간&apos;&#13;&#10;END' />
