            <column caption='F_cs_agency_전화(CPH)' datatype='boolean' name='[Calculation_1341509741571121174]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [Parameters].[P_Highlighter_고객대기시간_전화고객(복사본)_1341509741558886404]=  [cs_agency_nm] THEN [Parameters].[P_Highlighter_고객대기시간_전화고객(복사본)_1341509741558886404] = [cs_agency_nm]&#13;&#10;ELSEIF [Parameters].[P_Highlighter_고객대기시간_전화고객(복사본)_1341509741558886404] = &apos;전체&apos; THEN TRUE &#13;&#10;END' />
