            <column caption='C_CPH(전화)_Color_TRUE' datatype='real' name='[Calculation_1341509741562109967]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[P_cost/work(복사본)_1215690429116178432] = &apos;cost&apos; &#13;&#10;    THEN SUM(IF [Parameters].[P_Highlighter_고객대기시간_전화고객(복사본)_1341509741558886404] = [cs_agency_nm] THEN [csagent_resp_cnt] END)&#13;&#10;         / [Calculation_340866199121735854]&#13;&#10;ELSE &#13;&#10; SUM(IF [Parameters].[P_Highlighter_고객대기시간_전화고객(복사본)_1341509741558886404] = [cs_agency_nm] THEN [csagent_resp_cnt] END)&#13;&#10;         / [Calculation_340866199121551533]&#13;&#10;END' />
