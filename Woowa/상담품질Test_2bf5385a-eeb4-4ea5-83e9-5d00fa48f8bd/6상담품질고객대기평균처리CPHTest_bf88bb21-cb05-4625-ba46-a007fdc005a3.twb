              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 4]&#13;&#10;WHEN &apos;합계&apos;&#13;&#10;THEN&#13;&#10;sum([csagent_bsns_proc_time_sscnt])&#13;&#10;ELSE&#13;&#10;sum([csagent_bsns_proc_time_sscnt]) / [Calculation_340866199104028826]&#13;&#10;END' />
