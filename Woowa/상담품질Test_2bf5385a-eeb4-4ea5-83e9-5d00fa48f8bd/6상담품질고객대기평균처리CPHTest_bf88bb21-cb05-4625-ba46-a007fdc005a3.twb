              <calculation class='tableau' formula='SUM([csagent_resp_cnt]) &#13;&#10;/ &#13;&#10;CASE [Parameters].[P_cost/work(복사본)_1215690429116178432]&#13;&#10;    WHEN &apos;cost&apos; THEN [Calculation_340866199121735854]&#13;&#10;    WHEN &apos;work&apos; THEN [Calculation_340866199121551533]&#13;&#10;END' />
