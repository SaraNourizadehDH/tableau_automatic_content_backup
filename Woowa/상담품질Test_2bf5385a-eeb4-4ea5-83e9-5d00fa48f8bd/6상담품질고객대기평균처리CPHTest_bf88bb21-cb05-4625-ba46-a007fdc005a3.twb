          <datasource-dependencies datasource='sqlproxy.012kaq90564mq217a2kir0hz1ixh'>
            <column caption='C_관점전환_Depth2' datatype='string' name='[C_관점전환1_Depth1_업주/전화(복사본)_249949845021360132]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3]&#13;&#10;WHEN &apos;사용자별&apos;&#13;&#10;THEN [Calculation_665969863396323335]&#13;&#10;ELSE [Calculation_665969863396368392]&#13;&#10;END' />
            </column>
            <column caption='상담 문의건' datatype='real' name='[Calculation_1065382790917824513]' role='measure' type='quantitative' user:unnamed='1-1.KPI_업주/전화_하단'>
              <calculation class='tableau' formula='//상담 문의건&#13;&#10;ZN([Calculation_665969863424729100])' />
            </column>
            <column caption='F_관점전환1_업주/전화' datatype='boolean' name='[Calculation_249949845020635138]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3]&#13;&#10;WHEN &apos;사용자별&apos; &#13;&#10;THEN [Calculation_665969863396368392] = &apos;업주&apos;&#13;&#10;ELSE [Calculation_665969863396323335] = &apos;전화&apos;&#13;&#10;END' />
            </column>
            <column caption='C_관점전환_Depth1' datatype='string' name='[Calculation_249949845021097987]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3]&#13;&#10;WHEN &apos;사용자별&apos;&#13;&#10;THEN [Calculation_665969863396368392]&#13;&#10;ELSE [Calculation_665969863396323335]&#13;&#10;END' />
            </column>
            <column caption='대기시간' datatype='real' name='[Calculation_345369799072382991]' role='measure' type='quantitative' user:unnamed='1-1.KPI_업주/전화_하단'>
              <calculation class='tableau' formula='// 대기시간&#13;&#10;ZN([Calculation_665969863424905229])' />
            </column>
            <column caption='F_Date_Type' datatype='boolean' name='[Calculation_453174719756541967]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 5]&#13;&#10;WHEN &apos;월별&apos; &#13;&#10;THEN &#13;&#10;[base_dt_type] = &apos;M&apos; AND&#13;&#10;DATETRUNC(&apos;month&apos;,[part_date]) = DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;주별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;W&apos; AND&#13;&#10;DATETRUNC(&apos;iso-week&apos;,[part_date]) = DATETRUNC(&apos;iso-week&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;일별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;D&apos; AND&#13;&#10;DATETRUNC(&apos;day&apos;,[Parameters].[매개 변수 1])&lt;=DATETRUNC(&apos;day&apos;,[part_date]) AND &#13;&#10;DATETRUNC(&apos;day&apos;,[part_date]) &lt;= DATETRUNC(&apos;day&apos;,[Parameters].[매개 변수 2])&#13;&#10;END' />
            </column>
            <column caption='평균대기시간     (CWT)' datatype='real' name='[Calculation_453174719779143716]' role='measure' type='quantitative' user:unnamed='1-1.KPI_업주/전화_하단'>
              <calculation class='tableau' formula='//평균대기시간     (CWT)&#13;&#10;ZN([Calculation_665969863424905229])' />
            </column>
            <column caption='cs_ch_nm' datatype='string' name='[Calculation_665969863396323335]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [cs_ch_cd]&#13;&#10;WHEN &apos;In&apos; THEN &apos;전화&apos;&#13;&#10;WHEN &apos;Chat&apos; THEN &apos;채팅&apos;&#13;&#10;END' />
            </column>
            <column caption='cs_cust_div_nm' datatype='string' name='[Calculation_665969863396368392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [cs_cust_div_cd]&#13;&#10;WHEN &apos;Cust&apos; THEN &apos;고객&apos;&#13;&#10;WHEN &apos;Owner&apos; THEN &apos;업주&apos;&#13;&#10;END' />
            </column>
            <column caption='C_분모_평균용' datatype='integer' name='[Calculation_665969863396528139]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX({FIXED [part_date], [base_dt_type]:  MAX([date_cnt])})' />
            </column>
            <column caption='C_상담원연결요청수' datatype='real' name='[Calculation_665969863424729100]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 4]&#13;&#10;WHEN &apos;합계&apos;&#13;&#10;THEN&#13;&#10;SUM([csagent_connect_req_cnt])&#13;&#10;ELSE&#13;&#10;SUM([csagent_connect_req_cnt]) / [Calculation_665969863396528139]&#13;&#10;END' />
            </column>
            <column caption='C_고객대기시간' datatype='real' name='[Calculation_665969863424905229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//합계와 일평균 값이 같음&#13;&#10;SUM([frt_sscnt]) / SUM([csagent_connect_req_cnt])' />
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[base_dt_type]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[cs_ch_cd]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[cs_cust_div_cd]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[csagent_connect_req_cnt]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[date_cnt]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
