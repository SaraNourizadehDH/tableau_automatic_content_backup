      <aliases enabled='yes' />
      <column caption='cs_ch_nm' datatype='string' name='[Calculation_1465640267661090818]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [cs_ch_cd]&#13;&#10;WHEN &apos;In&apos; THEN &apos;전화&apos;&#13;&#10;WHEN &apos;Chat&apos; THEN &apos;채팅&apos;&#13;&#10;END' />
      </column>
      <column caption='cs_cust_div_nm' datatype='string' name='[Calculation_1465640267661160451]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [cs_cust_div_cd]&#13;&#10;WHEN &apos;Cust&apos; THEN &apos;고객&apos;&#13;&#10;WHEN &apos;Owner&apos; THEN &apos;업주&apos;&#13;&#10;END' />
      </column>
      <column caption='lv1_svc_nm' datatype='string' name='[Calculation_1465640267661209604]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [lv1_svc_cd]&#13;&#10;WHEN &apos;FD&apos; THEN &apos;푸드&apos;&#13;&#10;WHEN &apos;CM&apos; THEN &apos;커머스&apos;&#13;&#10;END' />
      </column>
      <column caption='lv2_svc_nm' datatype='string' name='[Calculation_1465640267661250565]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [lv2_svc_cd]&#13;&#10;WHEN &apos;FDMP&apos; THEN &apos;가게배달&apos;&#13;&#10;WHEN &apos;FDOD&apos; THEN &apos;배민배달&apos;&#13;&#10;WHEN &apos;CMBS&apos; THEN &apos;장보기쇼핑&apos;&#13;&#10;WHEN &apos;CMBM&apos; THEN &apos;B마트&apos;&#13;&#10;WHEN &apos;CMBR&apos; THEN &apos;배민상회&apos;&#13;&#10;END' />
      </column>
      <column caption='F_Date_Type_트렌드' datatype='boolean' name='[Calculation_1465640267664797703]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 5]&#13;&#10;WHEN &apos;월별&apos; &#13;&#10;THEN &#13;&#10;[base_dt_type] = &apos;M&apos; AND&#13;&#10;DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-12,[Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;month&apos;,[part_date]) AND&#13;&#10;DATETRUNC(&apos;month&apos;,[part_date]) &lt;= DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;주별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;W&apos; AND&#13;&#10;DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-11,[Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;iso-week&apos;,[part_date]) AND &#13;&#10;DATETRUNC(&apos;iso-week&apos;,[part_date]) &lt;= DATETRUNC(&apos;iso-week&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;일별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;D&apos; AND&#13;&#10;DATETRUNC(&apos;day&apos;,[Parameters].[매개 변수 1])&lt;=DATETRUNC(&apos;day&apos;,[part_date]) AND &#13;&#10;DATETRUNC(&apos;day&apos;,[part_date]) &lt;= DATETRUNC(&apos;day&apos;,[Parameters].[매개 변수 2])&#13;&#10;END' />
      </column>
      <column caption='C_날짜_일별_경고문구 (&gt;30)' datatype='string' name='[Calculation_1465640267666030600]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 5] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[매개 변수 1], [Parameters].[매개 변수 2]) &gt; 30&#13;&#10;    THEN &apos;※ 기간을 31일 이내로 입력하세요.&apos;&#13;&#10;    ELSEIF [Parameters].[매개 변수 1] &gt; [Parameters].[매개 변수 2]&#13;&#10;    THEN &apos;※ 시작일이 종료일보다 큽니다.&apos;&#13;&#10;    ELSE &apos;&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='C_분모_평균용' datatype='integer' name='[Calculation_439101031524237312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX({FIXED [part_date], [base_dt_type]:  MAX([date_cnt])})' />
      </column>
      <column caption='C_FCR대상고객상담인입수' datatype='real' name='[Calculation_453174719754256393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 4] = &apos;합계&apos;&#13;&#10;THEN &#13;&#10;SUM({ FIXED [part_date], [base_dt_type], [lv1_svc_cd], [lv2_svc_cd], [cs_cust_div_cd], [cs_cate_lv1_nm], [cs_cate_lv2_nm], [cs_ch_cd]: MIN([fcr_bound_cnt])})&#13;&#10;ELSE SUM({ FIXED [part_date], [base_dt_type], [lv1_svc_cd], [lv2_svc_cd], [cs_cust_div_cd], [cs_cate_lv1_nm], [cs_cate_lv2_nm], [cs_ch_cd]: MIN([fcr_bound_cnt])}) / [Calculation_439101031524237312]&#13;&#10;END' />
      </column>
      <column caption='C_고객상담인입수' datatype='real' name='[Calculation_453174719754694666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 4] = &apos;합계&apos;&#13;&#10;THEN &#13;&#10;SUM({ FIXED [part_date], [base_dt_type], [lv1_svc_cd], [lv2_svc_cd], [cs_cust_div_cd], [cs_cate_lv1_nm], [cs_cate_lv2_nm], [cs_ch_cd]: MIN([cs_bound_cnt])})&#13;&#10;ELSE SUM({ FIXED [part_date], [base_dt_type], [lv1_svc_cd], [lv2_svc_cd], [cs_cust_div_cd], [cs_cate_lv1_nm], [cs_cate_lv2_nm], [cs_ch_cd]: MIN([cs_bound_cnt])}) / [Calculation_439101031524237312]&#13;&#10;END' />
      </column>
      <column caption='C_Date_Axis' datatype='datetime' name='[Calculation_55450634679939073]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 5]&#13;&#10;WHEN &apos;일별&apos; THEN DATETRUNC(&apos;day&apos;, DATE([part_date]))&#13;&#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;iso-week&apos;, DATE([part_date]))&#13;&#10;WHEN &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;, DATE([part_date]))&#13;&#10;END' />
      </column>
      <column caption='C_Date_Label' datatype='string' name='[Calculation_55450634683031554]' role='dimension' type='nominal'>
