      <table>
        <view>
          <datasources>
            <datasource caption='6_2_CS_상담품질(CPH)' name='sqlproxy.19pbg9j13gikxd16v9wpr130fe85' />
            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='P_Start_Date' datatype='date' name='[매개 변수 1]' param-domain-type='any' role='measure' type='quantitative' value='#2025-04-01#'>
              <calculation class='tableau' formula='#2025-04-01#' />
            </column>
            <column caption='P_End_Date' datatype='date' name='[매개 변수 2]' param-domain-type='any' role='measure' type='quantitative' value='#2025-04-16#'>
              <calculation class='tableau' formula='#2025-04-16#' />
            </column>
            <column caption='P_Date_Type' datatype='string' name='[매개 변수 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;일별&quot;'>
              <calculation class='tableau' formula='&quot;일별&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.19pbg9j13gikxd16v9wpr130fe85'>
            <column caption='F_Date_Type_트렌드' datatype='boolean' name='[Calculation_665969863395962883]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 5]&#13;&#10;WHEN &apos;월별&apos; &#13;&#10;THEN &#13;&#10;[base_dt_type] = &apos;M&apos; AND&#13;&#10;DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-12,[Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;month&apos;,[part_date]) AND&#13;&#10;DATETRUNC(&apos;month&apos;,[part_date]) &lt;= DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;주별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;W&apos; AND&#13;&#10;DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-11,[Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;iso-week&apos;,[part_date]) AND &#13;&#10;DATETRUNC(&apos;iso-week&apos;,[part_date]) &lt;= DATETRUNC(&apos;iso-week&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;일별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;D&apos; AND&#13;&#10;DATETRUNC(&apos;day&apos;,[Parameters].[매개 변수 1])&lt;=DATETRUNC(&apos;day&apos;,[part_date]) AND &#13;&#10;DATETRUNC(&apos;day&apos;,[part_date]) &lt;= DATETRUNC(&apos;day&apos;,[Parameters].[매개 변수 2])&#13;&#10;END' />
            </column>
            <column caption='C_Date_Label' datatype='string' name='[Calculation_665969863396081669]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 5] = &apos;일별&apos;&#13;&#10;    THEN MID(STR([part_date]),6,2) + &quot;/&quot; + MID(STR([part_date]),9,2)&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 5] = &apos;주별&apos; &#13;&#10;&#13;&#10;    THEN MID(STR([part_date]),6,2)+ &quot;/&quot; + MID(STR([part_date]),9,2)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 5] = &apos;월별&apos; &#13;&#10;&#13;&#10;    THEN &quot;`&quot; + MID(STR([part_date]),3,2)+ &quot;.&quot; + MID(STR([part_date]),6,2)&#13;&#10;&#13;&#10;END' />
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[base_dt_type]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[cs_agency_nm]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[cs_ch_cd]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[lv1_svc_cd]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column-instance column='[Calculation_665969863395962883]' derivation='None' name='[none:Calculation_665969863395962883:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_665969863396081669]' derivation='None' name='[none:Calculation_665969863396081669:nk]' pivot='key' type='nominal' />
            <column-instance column='[cs_agency_nm]' derivation='None' name='[none:cs_agency_nm:nk]' pivot='key' type='nominal' />
            <column-instance column='[cs_ch_cd]' derivation='None' name='[none:cs_ch_cd:nk]' pivot='key' type='nominal' />
            <column-instance column='[lv1_svc_cd]' derivation='None' name='[none:lv1_svc_cd:nk]' pivot='key' type='nominal' />
            <column-instance column='[part_date]' derivation='None' name='[none:part_date:ok]' pivot='key' type='ordinal' />
            <column aggregation='Year' datatype='date' default-type='ordinal' layered='true' name='[part_date]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
          </datasource-dependencies>
