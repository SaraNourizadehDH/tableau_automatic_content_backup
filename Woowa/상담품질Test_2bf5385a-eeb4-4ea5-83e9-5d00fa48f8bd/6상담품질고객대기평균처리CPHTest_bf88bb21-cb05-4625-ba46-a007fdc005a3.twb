            <column caption='총업무처리시간_Work' datatype='real' name='[Calculation_1307169797345669143]' role='measure' type='quantitative' user:unnamed='0_엑셀다운로드_CPH'>
              <calculation class='tableau' formula='//총업무처리시간_Work&#13;&#10;[C_cost_상담원업무처리시간(복사본)_340866199130538167]' />
            </column>
            <column caption='part_date' datatype='string' name='[Calculation_1307169797349736474]' role='dimension' type='nominal' user:unnamed='0_엑셀다운로드_CPH'>
              <calculation class='tableau' formula='//part_date&#13;&#10;[Calculation_665969863396081669]' />
            </column>
            <column caption='C_시간당 상담 처리수(work)' datatype='real' name='[Calculation_340866199103389847]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([csagent_resp_cnt])&#13;&#10;/&#13;&#10;(sum([idle_time_incld_csagent_bsns_proc_time_sscnt]) / 3600)' />
            </column>
            <column caption='C_시간당 상담 처리수(cost)' datatype='real' name='[Calculation_340866199103602840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([csagent_resp_cnt]) / sum([csagent_bsns_proc_time_sscnt])' />
            </column>
            <column caption='C_분모_평균용(CPH)' datatype='integer' name='[Calculation_340866199104028826]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX({FIXED [part_date], [base_dt_type]:  MAX([date_cnt])})' />
            </column>
            <column caption='C_상담원응대수(CPH)' datatype='real' name='[Calculation_340866199104311451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 4]&#13;&#10;WHEN &apos;합계&apos;&#13;&#10;THEN&#13;&#10;SUM([csagent_resp_cnt])&#13;&#10;ELSE&#13;&#10;SUM([csagent_resp_cnt]) / [Calculation_340866199104028826]&#13;&#10;END' />
            </column>
            <column caption='C_cost_상담원업무처리시간' datatype='real' name='[Calculation_340866199130349750]' role='measure' type='quantitative'>
