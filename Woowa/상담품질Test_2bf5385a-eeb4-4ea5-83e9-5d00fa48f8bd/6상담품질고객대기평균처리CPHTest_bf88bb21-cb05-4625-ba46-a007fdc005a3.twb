      <column caption='F_Date_Type_트렌드' datatype='boolean' name='[Calculation_665969863395962883]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 5]&#13;&#10;WHEN &apos;월별&apos; &#13;&#10;THEN &#13;&#10;[base_dt_type] = &apos;M&apos; AND&#13;&#10;DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-12,[Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;month&apos;,[part_date]) AND&#13;&#10;DATETRUNC(&apos;month&apos;,[part_date]) &lt;= DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;주별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;W&apos; AND&#13;&#10;DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-11,[Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;iso-week&apos;,[part_date]) AND &#13;&#10;DATETRUNC(&apos;iso-week&apos;,[part_date]) &lt;= DATETRUNC(&apos;iso-week&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;일별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;D&apos; AND&#13;&#10;DATETRUNC(&apos;day&apos;,[Parameters].[매개 변수 1])&lt;=DATETRUNC(&apos;day&apos;,[part_date]) AND &#13;&#10;DATETRUNC(&apos;day&apos;,[part_date]) &lt;= DATETRUNC(&apos;day&apos;,[Parameters].[매개 변수 2])&#13;&#10;END' />
      </column>
      <column caption='C_날짜_일별_경고문구 (&gt;30)' datatype='string' name='[Calculation_665969863396028420]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 5] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[매개 변수 1], [Parameters].[매개 변수 2]) &gt; 30&#13;&#10;    THEN &apos;※ 기간을 31일 이내로 입력하세요.&apos;&#13;&#10;    ELSEIF [Parameters].[매개 변수 1] &gt; [Parameters].[매개 변수 2]&#13;&#10;    THEN &apos;※ 시작일이 종료일보다 큽니다.&apos;&#13;&#10;    ELSE &apos;&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='C_Date_Label' datatype='string' name='[Calculation_665969863396081669]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 5] = &apos;일별&apos;&#13;&#10;    THEN MID(STR([part_date]),6,2) + &quot;/&quot; + MID(STR([part_date]),9,2)&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 5] = &apos;주별&apos; &#13;&#10;&#13;&#10;    THEN MID(STR([part_date]),6,2)+ &quot;/&quot; + MID(STR([part_date]),9,2)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 5] = &apos;월별&apos; &#13;&#10;&#13;&#10;    THEN &quot;`&quot; + MID(STR([part_date]),3,2)+ &quot;.&quot; + MID(STR([part_date]),6,2)&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='C_Date_Axis' datatype='datetime' name='[Calculation_665969863396274182]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 5]&#13;&#10;WHEN &apos;일별&apos; THEN DATETRUNC(&apos;day&apos;, DATE([part_date]))&#13;&#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;iso-week&apos;, DATE([part_date]))&#13;&#10;WHEN &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;, DATE([part_date]))&#13;&#10;END' />
      </column>
      <column caption='cs_ch_nm' datatype='string' name='[Calculation_665969863396323335]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [cs_ch_cd]&#13;&#10;WHEN &apos;In&apos; THEN &apos;전화&apos;&#13;&#10;WHEN &apos;Chat&apos; THEN &apos;채팅&apos;&#13;&#10;END' />
      </column>
      <column caption='cs_cust_div_nm' datatype='string' name='[Calculation_665969863396368392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [cs_cust_div_cd]&#13;&#10;WHEN &apos;Cust&apos; THEN &apos;고객&apos;&#13;&#10;WHEN &apos;Owner&apos; THEN &apos;업주&apos;&#13;&#10;END' />
      </column>
      <column caption='lv1_svc_nm' datatype='string' name='[Calculation_665969863396425737]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [lv1_svc_cd]&#13;&#10;WHEN &apos;FD&apos; THEN &apos;푸드&apos;&#13;&#10;WHEN &apos;CM&apos; THEN &apos;커머스&apos;&#13;&#10;END' />
      </column>
      <column caption='lv2_svc_nm' datatype='string' name='[Calculation_665969863396474890]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [lv2_svc_cd]&#13;&#10;WHEN &apos;FDMP&apos; THEN &apos;가게배달&apos;&#13;&#10;WHEN &apos;FDOD&apos; THEN &apos;배민배달&apos;&#13;&#10;WHEN &apos;CMBS&apos; THEN &apos;장보기쇼핑&apos;&#13;&#10;WHEN &apos;CMBM&apos; THEN &apos;B마트&apos;&#13;&#10;WHEN &apos;CMBR&apos; THEN &apos;배민상회&apos;&#13;&#10;END' />
      </column>
      <column caption='C_분모_평균용' datatype='integer' name='[Calculation_665969863396528139]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX({FIXED [part_date], [base_dt_type]:  MAX([date_cnt])})' />
      </column>
      <column caption='C_상담원연결요청수' datatype='real' name='[Calculation_665969863424729100]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 4]&#13;&#10;WHEN &apos;합계&apos;&#13;&#10;THEN&#13;&#10;SUM([csagent_connect_req_cnt])&#13;&#10;ELSE&#13;&#10;SUM([csagent_connect_req_cnt]) / [Calculation_665969863396528139]&#13;&#10;END' />
      </column>
      <column caption='C_고객대기시간' datatype='real' name='[Calculation_665969863424905229]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//합계와 일평균 값이 같음&#13;&#10;SUM([frt_sscnt]) / SUM([csagent_connect_req_cnt])' />
      </column>
      <column caption='C_고객대기시간_고객' datatype='real' name='[Calculation_665969863436615715]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_665969863396368392] = &apos;고객&apos; THEN [frt_sscnt] END) &#13;&#10;/ &#13;&#10;SUM(IF [Calculation_665969863396368392] = &apos;고객&apos; THEN [csagent_connect_req_cnt] END)' />
      </column>
      <column caption='C_고객대기시간_전화/업주' datatype='real' name='[Calculation_665969863437180967]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3]&#13;&#10;WHEN &apos;사용자별&apos;&#13;&#10;THEN [C_고객대기시간_고객(복사본)_665969863436988453]&#13;&#10;ELSE [C_고객대기시간_고객(복사본)_665969863436832804]&#13;&#10;END' />
      </column>
      <column caption='날짜' datatype='string' name='[Calculation_665969863438757936]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//날짜&#13;&#10;[Calculation_665969863396081669]' />
      </column>
      <column caption='C_평균통화시간' datatype='real' name='[Calculation_891994202801790982]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([call_time_sscnt])/sum([csagent_resp_cnt])' />
      </column>
      <column caption='C_평균처리시간' datatype='real' name='[Calculation_891994202805895179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([call_time_sscnt]) + sum([acwt_sscnt])) / sum([csagent_resp_cnt])' />
      </column>
      <column caption='C_상담원응대수' datatype='real' name='[Calculation_891994202808274958]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 4]&#13;&#10;WHEN &apos;합계&apos;&#13;&#10;THEN&#13;&#10;SUM([csagent_resp_cnt])&#13;&#10;ELSE&#13;&#10;SUM([csagent_resp_cnt]) / [Calculation_665969863396528139]&#13;&#10;END' />
      </column>
      <column caption='C_평균처리시간_전화/업주' datatype='real' name='[Calculation_891994202823106596]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[P_사용자/채널(복사본)_555631605623648256]&#13;&#10;WHEN &apos;사용자별&apos;&#13;&#10;THEN [C_평균처리시간_업주(복사본)_891994202821955618]&#13;&#10;ELSE [C_평균처리시간(복사본)_891994202821316640]&#13;&#10;END' />
      </column>
      <column caption='C_관점전환_Label_1' datatype='string' name='[Calculation_995014110406647808]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3]&#13;&#10;WHEN &apos;사용자별&apos;&#13;&#10;THEN &apos;업주  |  전화&apos;&#13;&#10;ELSE &apos;전화  |  업주&apos;&#13;&#10;END' />
