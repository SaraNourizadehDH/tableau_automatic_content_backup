            </column>
            <column caption='P_사용자/채널' datatype='string' name='[매개 변수 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;사용자별&quot;'>
              <calculation class='tableau' formula='&quot;사용자별&quot;' />
            </column>
            <column caption='P_Date_Type' datatype='string' name='[매개 변수 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;일별&quot;'>
              <calculation class='tableau' formula='&quot;일별&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.012kaq90564mq217a2kir0hz1ixh'>
            <column caption='C_관점전환_Depth2' datatype='string' name='[C_관점전환1_Depth1_업주/전화(복사본)_249949845021360132]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3]&#13;&#10;WHEN &apos;사용자별&apos;&#13;&#10;THEN [Calculation_665969863396323335]&#13;&#10;ELSE [Calculation_665969863396368392]&#13;&#10;END' />
            </column>
            <column caption='F_관점전환1_업주/전화' datatype='boolean' name='[Calculation_249949845020635138]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3]&#13;&#10;WHEN &apos;사용자별&apos; &#13;&#10;THEN [Calculation_665969863396368392] = &apos;업주&apos;&#13;&#10;ELSE [Calculation_665969863396323335] = &apos;전화&apos;&#13;&#10;END' />
            </column>
            <column caption='F_Date_Type_트렌드' datatype='boolean' name='[Calculation_665969863395962883]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 5]&#13;&#10;WHEN &apos;월별&apos; &#13;&#10;THEN &#13;&#10;[base_dt_type] = &apos;M&apos; AND&#13;&#10;DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-12,[Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;month&apos;,[part_date]) AND&#13;&#10;DATETRUNC(&apos;month&apos;,[part_date]) &lt;= DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;주별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;W&apos; AND&#13;&#10;DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-11,[Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;iso-week&apos;,[part_date]) AND &#13;&#10;DATETRUNC(&apos;iso-week&apos;,[part_date]) &lt;= DATETRUNC(&apos;iso-week&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;일별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;D&apos; AND&#13;&#10;DATETRUNC(&apos;day&apos;,[Parameters].[매개 변수 1])&lt;=DATETRUNC(&apos;day&apos;,[part_date]) AND &#13;&#10;DATETRUNC(&apos;day&apos;,[part_date]) &lt;= DATETRUNC(&apos;day&apos;,[Parameters].[매개 변수 2])&#13;&#10;END' />
            </column>
            <column caption='C_Date_Label' datatype='string' name='[Calculation_665969863396081669]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 5] = &apos;일별&apos;&#13;&#10;    THEN MID(STR([part_date]),6,2) + &quot;/&quot; + MID(STR([part_date]),9,2)&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 5] = &apos;주별&apos; &#13;&#10;&#13;&#10;    THEN MID(STR([part_date]),6,2)+ &quot;/&quot; + MID(STR([part_date]),9,2)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 5] = &apos;월별&apos; &#13;&#10;&#13;&#10;    THEN &quot;`&quot; + MID(STR([part_date]),3,2)+ &quot;.&quot; + MID(STR([part_date]),6,2)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='C_Date_Axis' datatype='datetime' name='[Calculation_665969863396274182]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 5]&#13;&#10;WHEN &apos;일별&apos; THEN DATETRUNC(&apos;day&apos;, DATE([part_date]))&#13;&#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;iso-week&apos;, DATE([part_date]))&#13;&#10;WHEN &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;, DATE([part_date]))&#13;&#10;END' />
            </column>
            <column caption='cs_ch_nm' datatype='string' name='[Calculation_665969863396323335]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [cs_ch_cd]&#13;&#10;WHEN &apos;In&apos; THEN &apos;전화&apos;&#13;&#10;WHEN &apos;Chat&apos; THEN &apos;채팅&apos;&#13;&#10;END' />
            </column>
            <column caption='cs_cust_div_nm' datatype='string' name='[Calculation_665969863396368392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [cs_cust_div_cd]&#13;&#10;WHEN &apos;Cust&apos; THEN &apos;고객&apos;&#13;&#10;WHEN &apos;Owner&apos; THEN &apos;업주&apos;&#13;&#10;END' />
            </column>
            <column caption='C_고객대기시간' datatype='real' name='[Calculation_665969863424905229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//합계와 일평균 값이 같음&#13;&#10;SUM([frt_sscnt]) / SUM([csagent_connect_req_cnt])' />
            </column>
            <column caption='C_관점전환_Title_트렌드_1' datatype='string' name='[Calculation_995014110410117125]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3]&#13;&#10;WHEN &apos;사용자별&apos; THEN &apos;업주 대기시간&apos;&#13;&#10;ELSE &apos;전화 대기시간&apos;&#13;&#10;END' />
            </column>
