    <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.01vpg4n1yk3zas1g96l9h10r0ri1' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[WITH
  dlvry_tip
    AS (
    SELECT base_dt
         , CASE WHEN SUBSTR(svc_cd, 1, 7) = 'S010101' THEN '푸드'
                WHEN SUBSTR(svc_cd, 1, 7) = 'S010102' THEN '커머스' END svc_type    
         , CASE WHEN svc_cd = 'S01010101' THEN '배민'
                WHEN svc_cd = 'S01010102' THEN '배민1'
                WHEN svc_cd = 'S01010201' THEN 'B마트'
                WHEN svc_cd = 'S01010202' THEN '배민스토어' END svc_nm 
         , is_stod        
         , SUM(delivery_cost) AS dlvry_tip
         , SUM(ord_cnt)       AS ord_cnt
    FROM   cl_epm.order_dd_fact
    WHERE  base_dt >>= CAST(IF(
                                DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                                DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                                DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month))) AS VARCHAR)
    AND    base_dt  << CAST(DATE(NOW() AT TIME ZONE 'Asia/Seoul') AS VARCHAR)
    AND    svc_cd IN ('S01010101', 'S01010102', 'S01010201', 'S01010202')
    GROUP BY 1, 2, 3, 4
    )
    
SELECT DATE(t1.base_dt) AS base_dt
     , 'D' AS base_dt_type
     , t1.svc_type
     , t1.svc_nm
     , t1.is_stod
     , SUM(t1.dlvry_tip)   AS dlvry_tip
     , SUM(t1.ord_cnt)     AS ord_cnt
FROM   dlvry_tip t1

GROUP BY 1, 3, 4, 5
UNION ALL

SELECT DATE_TRUNC('week', DATE(t1.base_dt)) AS base_dt
     , 'W' AS base_dt_type
     , t1.svc_type
     , t1.svc_nm
     , t1.is_stod     
     , SUM(t1.dlvry_tip)   AS dlvry_tip
     , SUM(t1.ord_cnt)     AS ord_cnt
FROM   dlvry_tip t1

GROUP BY 1, 3, 4, 5
UNION ALL

SELECT DATE_TRUNC('month', DATE(t1.base_dt)) AS base_dt
     , 'M' AS base_dt_type
     , t1.svc_type
     , t1.svc_nm
     , t1.is_stod   -- 알뜰배달 여부 (0:한집, 1:알뜰)      
     , SUM(t1.dlvry_tip)   AS dlvry_tip  -- 배달팁
     , SUM(t1.ord_cnt)     AS ord_cnt    -- 주문수 (평균배달팁 = 배달팁 / 주문수)
FROM   dlvry_tip t1

GROUP BY 1, 3, 4, 5]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
    <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='athena.01vpg4n1yk3zas1g96l9h10r0ri1' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[WITH
  dlvry_tip
    AS (
    SELECT base_dt
         , CASE WHEN SUBSTR(svc_cd, 1, 7) = 'S010101' THEN '푸드'
                WHEN SUBSTR(svc_cd, 1, 7) = 'S010102' THEN '커머스' END svc_type    
         , CASE WHEN svc_cd = 'S01010101' THEN '배민'
                WHEN svc_cd = 'S01010102' THEN '배민1'
                WHEN svc_cd = 'S01010201' THEN 'B마트'
                WHEN svc_cd = 'S01010202' THEN '배민스토어' END svc_nm 
         , is_stod        
         , SUM(delivery_cost) AS dlvry_tip
         , SUM(ord_cnt)       AS ord_cnt
    FROM   cl_epm.order_dd_fact
    WHERE  base_dt >>= CAST(IF(
                                DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                                DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                                DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month))) AS VARCHAR)
    AND    base_dt  << CAST(DATE(NOW() AT TIME ZONE 'Asia/Seoul') AS VARCHAR)
    AND    svc_cd IN ('S01010101', 'S01010102', 'S01010201', 'S01010202')
    GROUP BY 1, 2, 3, 4
    )
    
SELECT DATE(t1.base_dt) AS base_dt
     , 'D' AS base_dt_type
     , t1.svc_type
     , t1.svc_nm
     , t1.is_stod
     , SUM(t1.dlvry_tip)   AS dlvry_tip
     , SUM(t1.ord_cnt)     AS ord_cnt
FROM   dlvry_tip t1

GROUP BY 1, 3, 4, 5
UNION ALL

SELECT DATE_TRUNC('week', DATE(t1.base_dt)) AS base_dt
     , 'W' AS base_dt_type
     , t1.svc_type
     , t1.svc_nm
     , t1.is_stod     
     , SUM(t1.dlvry_tip)   AS dlvry_tip
     , SUM(t1.ord_cnt)     AS ord_cnt
FROM   dlvry_tip t1

GROUP BY 1, 3, 4, 5
UNION ALL

SELECT DATE_TRUNC('month', DATE(t1.base_dt)) AS base_dt
     , 'M' AS base_dt_type
     , t1.svc_type
     , t1.svc_nm
     , t1.is_stod   -- 알뜰배달 여부 (0:한집, 1:알뜰)      
     , SUM(t1.dlvry_tip)   AS dlvry_tip  -- 배달팁
     , SUM(t1.ord_cnt)     AS ord_cnt    -- 주문수 (평균배달팁 = 배달팁 / 주문수)
FROM   dlvry_tip t1

GROUP BY 1, 3, 4, 5]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
