    <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.1yxo6kc10yb04m10wlzbq1og0he9' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[WITH
  date_list
    AS (
    SELECT CAST(base_dt AS VARCHAR) AS date_cd
         , CAST(ww_end_dt AS VARCHAR) AS weekend_dt
         , CAST(mm_end_dt AS VARCHAR) AS monthend_dt
         , CAST(LEAST(DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' day, mm_end_dt) AS VARCHAR) AS mm_endpoint_dt
         , CAST(LEAST(DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' day, ww_end_dt) AS VARCHAR) AS ww_endpoint_dt         
         , row_number() OVER (PARTITION BY mm_end_dt ORDER BY base_dt desc) AS rn
    FROM   cl_common.date_master
    WHERE  base_dt >>= IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)))
    AND    base_dt  << DATE(NOW() AT TIME ZONE 'Asia/Seoul')),

  seller_list
    AS (
    WITH 
      daily
        AS (
        SELECT DISTINCT
               acm.part_date AS base_dt
             , acm.shop_owner_no AS seller_id
             , acm.shop_no
             , SUBSTR(smd.svc_cd, 1,9) AS svc_cd
        FROM   sbadcenter_hist.ad_campaign_master acm
               JOIN cl_epm.advertisement_inventory_service_mapping_dim smd
               ON acm.ad_inventory_id = smd.ad_inv_id
               AND smd.svc_cd IS NOT NULL AND smd.svc_cd <<>> ''
               AND smd.is_del = '0'
               
        WHERE  acm.part_date >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
        AND    acm.part_date  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
        
        AND    acm.is_test = 0
        AND    acm.is_test_shop = 0
        AND    acm.is_test_seller = 0
        AND    acm.is_test_dsm = 0
        AND    acm.shop_status = 'OPEN'
        AND    acm.is_ad_active = 1
        
        UNION ALL
        SELECT DISTINCT
               acm.part_date AS base_dt
             , acm.shop_owner_no AS seller_id
             , acm.shop_no
             , SUBSTR(smd.svc_cd, 1,7) AS svc_cd
        FROM   sbadcenter_hist.ad_campaign_master acm
               JOIN cl_epm.advertisement_inventory_service_mapping_dim smd
               ON acm.ad_inventory_id = smd.ad_inv_id
               AND smd.svc_cd IS NOT NULL AND smd.svc_cd <<>> ''
               AND smd.is_del = '0'
    
        WHERE  acm.part_date >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
        AND    acm.part_date  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
        
        AND    acm.is_test = 0
        AND    acm.is_test_shop = 0
        AND    acm.is_test_seller = 0
        AND    acm.is_test_dsm = 0
        AND    acm.shop_status = 'OPEN'
        AND    acm.is_ad_active = 1)

    SELECT base_dt
         , 'D' AS base_dt_type
         , seller_id
         , shop_no
         , svc_cd
    FROM   daily
    
    UNION ALL
    SELECT DISTINCT CAST(DATE_TRUNC('week', DATE(base_dt)) AS VARCHAR) AS base_dt
         , 'W' AS base_dt_type
         , seller_id
         , shop_no
         , svc_cd
    FROM   daily d
           JOIN date_list dl
           ON   d.base_dt IN (SELECT DISTINCT(ww_endpoint_dt) FROM date_list)

    UNION ALL
    SELECT DISTINCT CAST(DATE_TRUNC('month', DATE(base_dt)) AS VARCHAR) AS base_dt
         , 'M' AS base_dt_type
         , seller_id
         , shop_no
         , svc_cd
    FROM   daily d
           JOIN date_list dl
           ON   d.base_dt IN (SELECT DISTINCT(mm_endpoint_dt) FROM date_list)
    ),       
    
  food
    AS (
    WITH
      ord
        AS (
        SELECT part_date AS ord_dt
             , CAST(DATE_TRUNC('month', DATE(part_date)) AS VARCHAR) AS mmord_dt
             , CAST(DATE_TRUNC('week',  DATE(part_date)) AS VARCHAR) AS wword_dt
             , shop_no
             , COUNT(DISTINCT ord_no) AS ord_cnt
        FROM   sborder_mart.order_master
        WHERE  part_date >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
        AND    part_date  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
        
        AND    is_closed = 1
        AND    is_test = 0
        GROUP BY part_date
               , shop_no
        ),
        
      daily
        AS (
        SELECT sl.base_dt
             , 'D' AS base_dt_type        
             , sl.svc_cd
             , sl.seller_id
             , SUM(COALESCE(o.ord_cnt,0)) AS ord_cnt
        FROM   seller_list sl
               LEFT JOIN ord o
               ON sl.shop_no = o.shop_no
               AND sl.base_dt = o.ord_dt
        WHERE  sl.svc_cd = 'S010101'
        AND    sl.base_dt_type = 'D'
        GROUP BY sl.base_dt
               , sl.svc_cd
               , sl.seller_id               

        UNION ALL
        SELECT sl.base_dt
             , 'D' AS base_dt_type        
             , sl.svc_cd
             , sl.seller_id
             , SUM(COALESCE(o.ord_cnt,0)) AS ord_cnt
        FROM   seller_list sl
               LEFT JOIN ord o
               ON sl.shop_no = o.shop_no
               AND sl.base_dt = o.ord_dt
        WHERE  sl.svc_cd <<>> 'S010101'
        AND    sl.base_dt_type = 'D'        
        GROUP BY sl.base_dt
               , sl.svc_cd
               , sl.seller_id
        ),

      weekly
        AS (
        SELECT sl.base_dt
             , 'W' AS base_dt_type
             , sl.svc_cd
             , sl.seller_id
             , SUM(COALESCE(o.ord_cnt,0)) AS ord_cnt
        FROM   seller_list sl
               LEFT JOIN ord o
               ON sl.shop_no = o.shop_no
               AND sl.base_dt = o.wword_dt
        WHERE  sl.svc_cd = 'S010101'
        AND    sl.base_dt_type = 'W'
        GROUP BY sl.base_dt
               , sl.svc_cd
               , sl.seller_id               

        UNION ALL
        SELECT sl.base_dt
             , 'W' AS base_dt_type        
             , sl.svc_cd
             , sl.seller_id
             , SUM(COALESCE(o.ord_cnt,0)) AS ord_cnt
        FROM   seller_list sl
               LEFT JOIN ord o
               ON sl.shop_no = o.shop_no
               AND sl.base_dt = o.wword_dt
        WHERE  sl.svc_cd <<>> 'S010101'
        AND    sl.base_dt_type = 'W'        
        GROUP BY sl.base_dt
               , sl.svc_cd
               , sl.seller_id
        ),       

      monthly
        AS (
        SELECT sl.base_dt
             , 'M' AS base_dt_type
             , sl.svc_cd
             , sl.seller_id
             , SUM(COALESCE(o.ord_cnt,0)) AS ord_cnt
        FROM   seller_list sl
               LEFT JOIN ord o
               ON sl.shop_no = o.shop_no
               AND sl.base_dt = o.mmord_dt
        WHERE  sl.svc_cd <<>> 'S010101'
        AND    sl.base_dt_type = 'M'        
        GROUP BY sl.base_dt
               , sl.svc_cd
               , sl.seller_id
        )
        
    SELECT * FROM   daily
    UNION ALL
    SELECT * FROM   weekly
    UNION ALL
    SELECT * FROM   monthly
    ),



  comm_seller
    AS (
      WITH
        bmart
          AS (
          SELECT part_date AS base_dt
               , 'S01010201' AS svc_cd
               , shop_id     AS seller_id
               , COUNT(DISTINCT ord_no) AS ord_cnt
               , now() AS created_at
          FROM   market_bi.market_order_master
          WHERE  part_date >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
          AND    part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
          AND    is_test_order = 0
          AND    is_closed = 1
          AND    is_return = 0
          GROUP BY part_date
                 , shop_id),
      
        seller_status
          AS (
          SELECT branch_id
               , final_open_yn
               , base_dt AS status_from_dt
               , COALESCE(CAST(DATE(LEAD(base_dt) OVER (PARTITION BY branch_id ORDER BY base_dt ASC))  - interval '1' day AS VARCHAR), '9999-12-31') AS status_to_dt
          FROM (
                   SELECT DISTINCT
                          base_dt
                        , branch_id
                        , FIRST_VALUE(open_yn) OVER (PARTITION BY base_dt, branch_id ORDER BY updated_at DESC) AS final_open_yn
                   FROM  (
                             SELECT DISTINCT
                                    CAST(DATE(sa.updated_at + interval '9' hour) AS VARCHAR) AS base_dt
                                  , sa.updated_at
                                  , sa.id AS branch_id
                                  , IF(aml_status IN ('CDD_CONFIRMED', 'EDD_CONFIRMED') AND open_status = 'OPEN' AND enter_status = 'COMPLETED', 1, 0) AS open_yn
                             FROM   cmplf_seller.seller_audit sa
                             WHERE  DATE(sa.updated_at + interval '9' hour) >>= DATE'2023-02-14'
                             AND  store_type != 'HEADQUARTER'
                             UNION ALL
                             SELECT CAST(DATE(created_at + interval '9' hour) AS VARCHAR) AS base_dt
                                  , created_at AS updated_at
                                  , id AS branch_id
                                  , 1 AS open_yn
                             FROM   cmplf_seller.seller
                             WHERE  DATE(created_at + interval '9' hour) << DATE'2023-02-14'
                             AND  store_type != 'HEADQUARTER'
                             UNION ALL
                             SELECT CAST(DATE(updated_at + interval '9' hour) AS VARCHAR) AS base_dt
                                  , updated_at
                                  , id AS branch_id
                                  , IF(aml_status IN ('CDD_CONFIRMED', 'EDD_CONFIRMED') AND open_status = 'OPEN' AND enter_status = 'COMPLETED', 1, 0) AS open_yn
                             FROM   cmplf_seller.seller
                             WHERE  DATE(updated_at + interval '9' hour) << DATE'2023-02-14'
                             AND  store_type != 'HEADQUARTER'
                         ))),
      
        seller_status_history
          AS (
          SELECT DISTINCT
                 CAST(d.base_dt AS VARCHAR) AS base_dt
               , s.branch_id
               , s.final_open_yn
          FROM   cl_common.date_master d
                 JOIN seller_status s
                 ON CAST(d.base_dt AS VARCHAR) >>= s.status_from_dt
                 AND CAST(d.base_dt AS VARCHAR) <<= s.status_to_dt),
      
        store_fr_gen
          AS (
          SELECT ssh.base_dt
               , 'S01010202' AS svc_cd
               , s.headquarter_id AS seller_id
               , SUM(COALESCE(om.ord_cnt,0)) AS ord_cnt
               , now() AS created_at
          FROM (
                SELECT DISTINCT
                       base_dt AS base_dt
                     , branch_id
                FROM   seller_status_history
                WHERE  base_dt >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
                AND  base_dt << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                AND  final_open_yn = 1
               ) ssh
      
               JOIN cmplf_seller.seller s
               ON ssh.branch_id = s.id
      
               JOIN dsdw.commerce_seller_master sm
               ON ssh.branch_id = sm.branch_id
               AND sm.is_test = 0
      
               LEFT JOIN (
                          SELECT part_date AS ord_dt
                               , branch_id
                               , COUNT(DISTINCT ord_no) AS ord_cnt
                          FROM   dsdw.commerce_order_master
                          WHERE  part_date >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
                          AND    part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                          AND    is_closed = 1
                          AND    is_test_order = 0
                          AND    is_return = 0
                          GROUP BY part_date
                                 , branch_id
                         ) om
               ON ssh.base_dt = om.ord_dt
               AND ssh.branch_id = om.branch_id
      
          GROUP BY ssh.base_dt
                 , s.headquarter_id),
      
        store_fc
          AS (
          SELECT om.part_date AS base_dt
               , 'S01010202' AS svc_cd
               , hfss.settlement_target_id AS seller_id
               , COUNT(DISTINCT om.ord_no) AS ord_cnt
               , now() AS created_at
          FROM   dsdw.commerce_order_master om
                 JOIN cmplf_order.order_product op
                 ON om.ord_no = op.order_no
      
                 JOIN cmplf_product.health_food_seller_settlement hfss
                 ON hfss.product_id = op.product_id
      
                 JOIN cmplf_seller.seller s
                 ON hfss.settlement_target_id = s.id
      
          WHERE  om.is_closed = 1
          AND    om.is_return = 0
          AND    om.is_test_order = 0
          AND    om.part_date >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
          AND    om.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
      
          GROUP BY om.part_date
                 , hfss.settlement_target_id),
      
        directfm
          AS (
          SELECT s.part_date AS base_dt
               , 'S01010203' AS svc_cd
               , s.seller_id
               , COUNT(DISTINCT om.ord_no) AS ord_cnt
               , now() AS created_at
          FROM  (
                 SELECT DISTINCT
                        s.part_date
                      , s.seller_id
                 FROM   dsdw.directfm_seller_master_snap_daily s
                 WHERE  s.seller_status = 'ACTIVE'
                 AND    s.is_test = 0
                 AND    s.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
                 AND    s.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                ) s
                 LEFT JOIN dsdw.directfm_ord_info om
                 ON s.seller_id = om.seller_id
                 AND s.part_date = om.part_date
                 AND om.is_cmplt_ord = 1
                 AND om.is_test = 0
                 AND om.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
                 AND om.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
      
          GROUP BY s.part_date
                 , s.seller_id),
      
        brs
          AS (
          SELECT s.part_date AS base_dt
               , 'S01010204' AS svc_cd
               , s.seller_id
               , SUM(COALESCE(om.ord_cnt,0)) AS ord_cnt
               , now() AS created_at
          FROM   (
                  SELECT DISTINCT
                         s.part_date
                       , s.seller_id
                  FROM   bmmart_mart.display_product_master_snap_daily s
                  WHERE  s.mall_type = 'MART'
                  AND    s.is_disp = 1
                  AND    s.is_del = 0
                  AND    s.is_test = 0
                  AND    s.is_disabled = 0
      
                  AND    s.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
                  AND    s.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                ) s
                 LEFT JOIN (
                            SELECT oii.part_date
                                 , oii.seller_id
                                 , COUNT(DISTINCT oii.ord_id) as ord_cnt
                            FROM   bmmart_mart.order_item_info oii
                                   JOIN bmmart_mart.order_info oi
                                   ON oii.ord_id = oi.ord_id
                                   AND oi.mall_type = 'MART'
                                   AND oi.is_cmplt_ord = 1
                                   AND oi.is_test = 0
                                   AND oi.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
                                   AND oi.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                            WHERE  oii.item_qty * oii.item_price >> 0
                            AND    oii.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
                            AND    oii.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
      
                            GROUP BY 1,2
                          ) om
                 ON s.seller_id = om.seller_id
                 AND s.part_date = om.part_date
      
      
          GROUP BY s.part_date
                 , s.seller_id),
      
        hypmrkt
          AS (
          SELECT s.part_date AS base_dt
               , 'S01010206' AS svc_cd
               , s.seller_id
               , SUM(COALESCE(om.ord_cnt,0)) AS ord_cnt
               , now() AS created_at
          FROM   (
                  SELECT DISTINCT
                         s.part_date
                       , s.seller_id
                  FROM   bmmart_mart.display_product_master_snap_daily s
                  WHERE  s.mall_type = 'HYPER_MARKET'
                  AND    s.is_disp = 1
                  AND    s.is_del = 0
                  AND    s.is_test = 0
                  AND    s.is_disabled = 0
      
                  AND    s.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
                  AND    s.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                ) s
                 LEFT JOIN (
                            SELECT oii.part_date
                                 , oii.seller_id
                                 , COUNT(DISTINCT oii.ord_id) as ord_cnt
                            FROM   bmmart_mart.order_item_info oii
                                   JOIN bmmart_mart.order_info oi
                                   ON oii.ord_id = oi.ord_id
                                   AND oi.mall_type = 'HYPER_MARKET'
                                   AND oi.is_cmplt_ord = 1
                                   AND oi.is_test = 0
                                   AND oi.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
                                   AND oi.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                            WHERE  oii.item_qty * oii.item_price >> 0
                            AND    oii.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
                            AND    oii.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
      
                            GROUP BY 1,2
                          ) om
                 ON s.seller_id = om.seller_id
                 AND s.part_date = om.part_date
      
      
          GROUP BY s.part_date
                 , s.seller_id)
  
    SELECT seller_id
         , ord_cnt
         , created_at
         , base_dt
         , svc_cd
    FROM bmart
    UNION ALL
    SELECT seller_id
         , ord_cnt
         , created_at
         , base_dt
         , svc_cd
    FROM store_fr_gen
    UNION ALL
    SELECT seller_id
         , ord_cnt
         , created_at
         , base_dt
         , svc_cd
    FROM store_fc
    UNION ALL
    SELECT seller_id
         , ord_cnt
         , created_at
         , base_dt
         , svc_cd
    FROM directfm
    UNION ALL
    SELECT seller_id
         , ord_cnt
         , created_at
         , base_dt
         , svc_cd
    FROM brs
    UNION ALL
    SELECT seller_id
         , ord_cnt
         , created_at
         , base_dt
         , svc_cd
    FROM hypmrkt
    ), 
    
  comm_seller_fact
    AS (
    SELECT t1.base_dt
         , 'D' AS base_dt_type
         , CASE WHEN SUBSTR(t1.svc_cd, 1, 7) = 'S010101' THEN '푸드'
                WHEN SUBSTR(t1.svc_cd, 1, 7) = 'S010102' THEN '커머스' END svc_type
         , CASE WHEN t1.svc_cd = 'S01010101' THEN '배민'
                WHEN t1.svc_cd = 'S01010102' THEN '배민1'
                WHEN SUBSTR(t1.svc_cd,1,9) = 'S01010103' THEN '포장'
                WHEN t1.svc_cd = 'S01010201' THEN 'B마트'
                WHEN t1.svc_cd = 'S01010206' THEN '대용량특가' ELSE t2.cd_kr_nm END AS svc_nm     
         , COUNT(DISTINCT seller_id)                              AS ad_active_seller_cnt
         , COUNT(DISTINCT IF(ord_cnt >> 0, seller_id, null))  AS ord_seller_cnt
         , COUNT(DISTINCT IF(ord_cnt << 30, seller_id, null)) AS ord_under30_seller_cnt
         , COUNT(DISTINCT IF(ord_cnt = 0, seller_id, null))  AS noord_seller_cnt    
    FROM   comm_seller t1
           LEFT JOIN cl_common.comm_cd t2
           ON t1.svc_cd = t2.cd
    GROUP BY 1, 3, 4
    
    UNION ALL
    SELECT t1.base_dt
         , 'W' AS base_dt_type
         , CASE WHEN SUBSTR(t1.svc_cd, 1, 7) = 'S010101' THEN '푸드'
                WHEN SUBSTR(t1.svc_cd, 1, 7) = 'S010102' THEN '커머스' END svc_type
         , CASE WHEN t1.svc_cd = 'S01010101' THEN '배민'
                WHEN t1.svc_cd = 'S01010102' THEN '배민1'
                WHEN SUBSTR(t1.svc_cd,1,9) = 'S01010103' THEN '포장'
                WHEN t1.svc_cd = 'S01010201' THEN 'B마트'
                WHEN t1.svc_cd = 'S01010206' THEN '대용량특가' ELSE t2.cd_kr_nm END AS svc_nm     
         , COUNT(DISTINCT seller_id)                              AS ad_active_seller_cnt
         , COUNT(DISTINCT IF(ord_cnt >> 0, seller_id, null))  AS ord_seller_cnt
         , COUNT(DISTINCT IF(ord_cnt << 30, seller_id, null)) AS ord_under30_seller_cnt
         , COUNT(DISTINCT IF(ord_cnt = 0, seller_id, null))  AS noord_seller_cnt    
    FROM   (
            SELECT CAST(DATE_TRUNC('week', DATE(base_dt)) AS VARCHAR) AS base_dt
                 , svc_cd 
                 , seller_id
                 , SUM(ord_cnt) AS ord_cnt
            FROM   comm_seller
            GROUP BY 1, 2, 3
           ) t1
           LEFT JOIN cl_common.comm_cd t2
           ON t1.svc_cd = t2.cd
    GROUP BY 1, 3, 4    
    
    UNION ALL
    SELECT t1.base_dt
         , 'M' AS base_dt_type
         , '커머스' AS svc_type
         , CASE WHEN t1.svc_cd = 'S01010201' THEN 'B마트'
                WHEN t1.svc_cd = 'S01010206' THEN '대용량특가' ELSE t2.cd_kr_nm END AS svc_nm        
         , t1.ad_active_seller_cnt
         , t1.ord_seller_cnt
         , t1.ord_under30_seller_cnt
         , t1.noord_seller_cnt
    FROM   cl_epm.advertisement_active_seller_count_mm_fact t1
           LEFT JOIN cl_common.comm_cd t2
           ON t1.svc_cd = t2.cd
    WHERE  t1.base_dt >>= CAST(IF(
                              DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                              DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                              DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
    AND    t1.base_dt  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)  
    AND    t1.svc_cd <<>> 'S010101'
    )

    
SELECT base_dt
     , base_dt_type
     , '푸드' svc_type
     , CASE WHEN svc_cd = 'S010101'   THEN '푸드'
            WHEN svc_cd = 'S01010101' THEN '배민'
            WHEN svc_cd = 'S01010102' THEN '배민1'
            WHEN svc_cd = 'S01010103' THEN '포장' END AS svc_nm
     , COUNT(DISTINCT seller_id)                         AS ad_active_seller_cnt
     , COUNT(DISTINCT IF(ord_cnt >> 0, seller_id, null))  AS ord_seller_cnt
     , COUNT(DISTINCT IF(ord_cnt << 30, seller_id, null)) AS ord_under30_seller_cnt
     , COUNT(DISTINCT IF(ord_cnt = 0, seller_id, null))  AS noord_seller_cnt
     
FROM   food
GROUP BY base_dt
       , base_dt_type
       , 4    

UNION ALL
SELECT t1.base_dt
     , 'M' AS base_dt_type
     , '푸드' AS svc_type
     , '푸드' AS svc_nm
     , t1.ad_active_seller_cnt
     , t1.ord_seller_cnt
     , t1.ord_under30_seller_cnt
     , t1.noord_seller_cnt
FROM   cl_epm.advertisement_active_seller_count_mm_fact t1
WHERE  t1.base_dt >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
AND    t1.base_dt  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)  
AND    t1.svc_cd = 'S010101'

UNION ALL

SELECT base_dt
     , base_dt_type
     , '커머스' AS svc_type
     , '커머스' AS svc_nm
     , SUM(ad_active_seller_cnt)   AS ad_active_seller_cnt
     , SUM(ord_seller_cnt)         AS ord_seller_cnt
     , SUM(ord_under30_seller_cnt) AS ord_under30_seller_cnt
     , SUM(noord_seller_cnt)       AS noord_seller_cnt         
FROM   comm_seller_fact 
GROUP BY base_dt
       , base_dt_type
       
UNION ALL
SELECT *
FROM   comm_seller_fact]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
    <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='athena.1yxo6kc10yb04m10wlzbq1og0he9' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[WITH
  date_list
    AS (
    SELECT CAST(base_dt AS VARCHAR) AS date_cd
         , CAST(ww_end_dt AS VARCHAR) AS weekend_dt
         , CAST(mm_end_dt AS VARCHAR) AS monthend_dt
         , CAST(LEAST(DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' day, mm_end_dt) AS VARCHAR) AS mm_endpoint_dt
         , CAST(LEAST(DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' day, ww_end_dt) AS VARCHAR) AS ww_endpoint_dt         
         , row_number() OVER (PARTITION BY mm_end_dt ORDER BY base_dt desc) AS rn
    FROM   cl_common.date_master
    WHERE  base_dt >>= IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)))
    AND    base_dt  << DATE(NOW() AT TIME ZONE 'Asia/Seoul')),

  seller_list
    AS (
    WITH 
      daily
        AS (
        SELECT DISTINCT
               acm.part_date AS base_dt
             , acm.shop_owner_no AS seller_id
             , acm.shop_no
             , SUBSTR(smd.svc_cd, 1,9) AS svc_cd
        FROM   sbadcenter_hist.ad_campaign_master acm
               JOIN cl_epm.advertisement_inventory_service_mapping_dim smd
               ON acm.ad_inventory_id = smd.ad_inv_id
               AND smd.svc_cd IS NOT NULL AND smd.svc_cd <<>> ''
               AND smd.is_del = '0'
               
        WHERE  acm.part_date >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
        AND    acm.part_date  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
        
        AND    acm.is_test = 0
        AND    acm.is_test_shop = 0
        AND    acm.is_test_seller = 0
        AND    acm.is_test_dsm = 0
        AND    acm.shop_status = 'OPEN'
        AND    acm.is_ad_active = 1
        
        UNION ALL
        SELECT DISTINCT
               acm.part_date AS base_dt
             , acm.shop_owner_no AS seller_id
             , acm.shop_no
             , SUBSTR(smd.svc_cd, 1,7) AS svc_cd
        FROM   sbadcenter_hist.ad_campaign_master acm
               JOIN cl_epm.advertisement_inventory_service_mapping_dim smd
               ON acm.ad_inventory_id = smd.ad_inv_id
               AND smd.svc_cd IS NOT NULL AND smd.svc_cd <<>> ''
               AND smd.is_del = '0'
    
        WHERE  acm.part_date >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
        AND    acm.part_date  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
        
        AND    acm.is_test = 0
        AND    acm.is_test_shop = 0
        AND    acm.is_test_seller = 0
        AND    acm.is_test_dsm = 0
        AND    acm.shop_status = 'OPEN'
        AND    acm.is_ad_active = 1)

    SELECT base_dt
         , 'D' AS base_dt_type
         , seller_id
         , shop_no
         , svc_cd
    FROM   daily
    
    UNION ALL
    SELECT DISTINCT CAST(DATE_TRUNC('week', DATE(base_dt)) AS VARCHAR) AS base_dt
         , 'W' AS base_dt_type
         , seller_id
         , shop_no
         , svc_cd
    FROM   daily d
           JOIN date_list dl
           ON   d.base_dt IN (SELECT DISTINCT(ww_endpoint_dt) FROM date_list)

    UNION ALL
    SELECT DISTINCT CAST(DATE_TRUNC('month', DATE(base_dt)) AS VARCHAR) AS base_dt
         , 'M' AS base_dt_type
         , seller_id
         , shop_no
         , svc_cd
    FROM   daily d
           JOIN date_list dl
           ON   d.base_dt IN (SELECT DISTINCT(mm_endpoint_dt) FROM date_list)
    ),       
    
  food
    AS (
    WITH
      ord
        AS (
        SELECT part_date AS ord_dt
             , CAST(DATE_TRUNC('month', DATE(part_date)) AS VARCHAR) AS mmord_dt
             , CAST(DATE_TRUNC('week',  DATE(part_date)) AS VARCHAR) AS wword_dt
             , shop_no
             , COUNT(DISTINCT ord_no) AS ord_cnt
        FROM   sborder_mart.order_master
        WHERE  part_date >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
        AND    part_date  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
        
        AND    is_closed = 1
        AND    is_test = 0
        GROUP BY part_date
               , shop_no
        ),
        
      daily
        AS (
        SELECT sl.base_dt
             , 'D' AS base_dt_type        
             , sl.svc_cd
             , sl.seller_id
             , SUM(COALESCE(o.ord_cnt,0)) AS ord_cnt
        FROM   seller_list sl
               LEFT JOIN ord o
               ON sl.shop_no = o.shop_no
               AND sl.base_dt = o.ord_dt
        WHERE  sl.svc_cd = 'S010101'
        AND    sl.base_dt_type = 'D'
        GROUP BY sl.base_dt
               , sl.svc_cd
               , sl.seller_id               

        UNION ALL
        SELECT sl.base_dt
             , 'D' AS base_dt_type        
             , sl.svc_cd
             , sl.seller_id
             , SUM(COALESCE(o.ord_cnt,0)) AS ord_cnt
        FROM   seller_list sl
               LEFT JOIN ord o
               ON sl.shop_no = o.shop_no
               AND sl.base_dt = o.ord_dt
        WHERE  sl.svc_cd <<>> 'S010101'
        AND    sl.base_dt_type = 'D'        
        GROUP BY sl.base_dt
               , sl.svc_cd
               , sl.seller_id
        ),

      weekly
        AS (
        SELECT sl.base_dt
             , 'W' AS base_dt_type
             , sl.svc_cd
             , sl.seller_id
             , SUM(COALESCE(o.ord_cnt,0)) AS ord_cnt
        FROM   seller_list sl
               LEFT JOIN ord o
               ON sl.shop_no = o.shop_no
               AND sl.base_dt = o.wword_dt
        WHERE  sl.svc_cd = 'S010101'
        AND    sl.base_dt_type = 'W'
        GROUP BY sl.base_dt
               , sl.svc_cd
               , sl.seller_id               

        UNION ALL
        SELECT sl.base_dt
             , 'W' AS base_dt_type        
             , sl.svc_cd
             , sl.seller_id
             , SUM(COALESCE(o.ord_cnt,0)) AS ord_cnt
        FROM   seller_list sl
               LEFT JOIN ord o
               ON sl.shop_no = o.shop_no
               AND sl.base_dt = o.wword_dt
        WHERE  sl.svc_cd <<>> 'S010101'
        AND    sl.base_dt_type = 'W'        
        GROUP BY sl.base_dt
               , sl.svc_cd
               , sl.seller_id
        ),       

      monthly
        AS (
        SELECT sl.base_dt
             , 'M' AS base_dt_type
             , sl.svc_cd
             , sl.seller_id
             , SUM(COALESCE(o.ord_cnt,0)) AS ord_cnt
        FROM   seller_list sl
               LEFT JOIN ord o
               ON sl.shop_no = o.shop_no
               AND sl.base_dt = o.mmord_dt
        WHERE  sl.svc_cd <<>> 'S010101'
        AND    sl.base_dt_type = 'M'        
        GROUP BY sl.base_dt
               , sl.svc_cd
               , sl.seller_id
        )
        
    SELECT * FROM   daily
    UNION ALL
    SELECT * FROM   weekly
    UNION ALL
    SELECT * FROM   monthly
    ),



  comm_seller
    AS (
      WITH
        bmart
          AS (
          SELECT part_date AS base_dt
               , 'S01010201' AS svc_cd
               , shop_id     AS seller_id
               , COUNT(DISTINCT ord_no) AS ord_cnt
               , now() AS created_at
          FROM   market_bi.market_order_master
          WHERE  part_date >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
          AND    part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
          AND    is_test_order = 0
          AND    is_closed = 1
          AND    is_return = 0
          GROUP BY part_date
                 , shop_id),
      
        seller_status
          AS (
          SELECT branch_id
               , final_open_yn
               , base_dt AS status_from_dt
               , COALESCE(CAST(DATE(LEAD(base_dt) OVER (PARTITION BY branch_id ORDER BY base_dt ASC))  - interval '1' day AS VARCHAR), '9999-12-31') AS status_to_dt
          FROM (
                   SELECT DISTINCT
                          base_dt
                        , branch_id
                        , FIRST_VALUE(open_yn) OVER (PARTITION BY base_dt, branch_id ORDER BY updated_at DESC) AS final_open_yn
                   FROM  (
                             SELECT DISTINCT
                                    CAST(DATE(sa.updated_at + interval '9' hour) AS VARCHAR) AS base_dt
                                  , sa.updated_at
                                  , sa.id AS branch_id
                                  , IF(aml_status IN ('CDD_CONFIRMED', 'EDD_CONFIRMED') AND open_status = 'OPEN' AND enter_status = 'COMPLETED', 1, 0) AS open_yn
                             FROM   cmplf_seller.seller_audit sa
                             WHERE  DATE(sa.updated_at + interval '9' hour) >>= DATE'2023-02-14'
                             AND  store_type != 'HEADQUARTER'
                             UNION ALL
                             SELECT CAST(DATE(created_at + interval '9' hour) AS VARCHAR) AS base_dt
                                  , created_at AS updated_at
                                  , id AS branch_id
                                  , 1 AS open_yn
                             FROM   cmplf_seller.seller
                             WHERE  DATE(created_at + interval '9' hour) << DATE'2023-02-14'
                             AND  store_type != 'HEADQUARTER'
                             UNION ALL
                             SELECT CAST(DATE(updated_at + interval '9' hour) AS VARCHAR) AS base_dt
                                  , updated_at
                                  , id AS branch_id
                                  , IF(aml_status IN ('CDD_CONFIRMED', 'EDD_CONFIRMED') AND open_status = 'OPEN' AND enter_status = 'COMPLETED', 1, 0) AS open_yn
                             FROM   cmplf_seller.seller
                             WHERE  DATE(updated_at + interval '9' hour) << DATE'2023-02-14'
                             AND  store_type != 'HEADQUARTER'
                         ))),
      
        seller_status_history
          AS (
          SELECT DISTINCT
                 CAST(d.base_dt AS VARCHAR) AS base_dt
               , s.branch_id
               , s.final_open_yn
          FROM   cl_common.date_master d
                 JOIN seller_status s
                 ON CAST(d.base_dt AS VARCHAR) >>= s.status_from_dt
                 AND CAST(d.base_dt AS VARCHAR) <<= s.status_to_dt),
      
        store_fr_gen
          AS (
          SELECT ssh.base_dt
               , 'S01010202' AS svc_cd
               , s.headquarter_id AS seller_id
               , SUM(COALESCE(om.ord_cnt,0)) AS ord_cnt
               , now() AS created_at
          FROM (
                SELECT DISTINCT
                       base_dt AS base_dt
                     , branch_id
                FROM   seller_status_history
                WHERE  base_dt >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
                AND  base_dt << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                AND  final_open_yn = 1
               ) ssh
      
               JOIN cmplf_seller.seller s
               ON ssh.branch_id = s.id
      
               JOIN dsdw.commerce_seller_master sm
               ON ssh.branch_id = sm.branch_id
               AND sm.is_test = 0
      
               LEFT JOIN (
                          SELECT part_date AS ord_dt
                               , branch_id
                               , COUNT(DISTINCT ord_no) AS ord_cnt
                          FROM   dsdw.commerce_order_master
                          WHERE  part_date >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
                          AND    part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                          AND    is_closed = 1
                          AND    is_test_order = 0
                          AND    is_return = 0
                          GROUP BY part_date
                                 , branch_id
                         ) om
               ON ssh.base_dt = om.ord_dt
               AND ssh.branch_id = om.branch_id
      
          GROUP BY ssh.base_dt
                 , s.headquarter_id),
      
        store_fc
          AS (
          SELECT om.part_date AS base_dt
               , 'S01010202' AS svc_cd
               , hfss.settlement_target_id AS seller_id
               , COUNT(DISTINCT om.ord_no) AS ord_cnt
               , now() AS created_at
          FROM   dsdw.commerce_order_master om
                 JOIN cmplf_order.order_product op
                 ON om.ord_no = op.order_no
      
                 JOIN cmplf_product.health_food_seller_settlement hfss
                 ON hfss.product_id = op.product_id
      
                 JOIN cmplf_seller.seller s
                 ON hfss.settlement_target_id = s.id
      
          WHERE  om.is_closed = 1
          AND    om.is_return = 0
          AND    om.is_test_order = 0
          AND    om.part_date >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
          AND    om.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
      
          GROUP BY om.part_date
                 , hfss.settlement_target_id),
      
        directfm
          AS (
          SELECT s.part_date AS base_dt
               , 'S01010203' AS svc_cd
               , s.seller_id
               , COUNT(DISTINCT om.ord_no) AS ord_cnt
               , now() AS created_at
          FROM  (
                 SELECT DISTINCT
                        s.part_date
                      , s.seller_id
                 FROM   dsdw.directfm_seller_master_snap_daily s
                 WHERE  s.seller_status = 'ACTIVE'
                 AND    s.is_test = 0
                 AND    s.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
                 AND    s.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                ) s
                 LEFT JOIN dsdw.directfm_ord_info om
                 ON s.seller_id = om.seller_id
                 AND s.part_date = om.part_date
                 AND om.is_cmplt_ord = 1
                 AND om.is_test = 0
                 AND om.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
                 AND om.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
      
          GROUP BY s.part_date
                 , s.seller_id),
      
        brs
          AS (
          SELECT s.part_date AS base_dt
               , 'S01010204' AS svc_cd
               , s.seller_id
               , SUM(COALESCE(om.ord_cnt,0)) AS ord_cnt
               , now() AS created_at
          FROM   (
                  SELECT DISTINCT
                         s.part_date
                       , s.seller_id
                  FROM   bmmart_mart.display_product_master_snap_daily s
                  WHERE  s.mall_type = 'MART'
                  AND    s.is_disp = 1
                  AND    s.is_del = 0
                  AND    s.is_test = 0
                  AND    s.is_disabled = 0
      
                  AND    s.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
                  AND    s.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                ) s
                 LEFT JOIN (
                            SELECT oii.part_date
                                 , oii.seller_id
                                 , COUNT(DISTINCT oii.ord_id) as ord_cnt
                            FROM   bmmart_mart.order_item_info oii
                                   JOIN bmmart_mart.order_info oi
                                   ON oii.ord_id = oi.ord_id
                                   AND oi.mall_type = 'MART'
                                   AND oi.is_cmplt_ord = 1
                                   AND oi.is_test = 0
                                   AND oi.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
                                   AND oi.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                            WHERE  oii.item_qty * oii.item_price >> 0
                            AND    oii.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
                            AND    oii.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
      
                            GROUP BY 1,2
                          ) om
                 ON s.seller_id = om.seller_id
                 AND s.part_date = om.part_date
      
      
          GROUP BY s.part_date
                 , s.seller_id),
      
        hypmrkt
          AS (
          SELECT s.part_date AS base_dt
               , 'S01010206' AS svc_cd
               , s.seller_id
               , SUM(COALESCE(om.ord_cnt,0)) AS ord_cnt
               , now() AS created_at
          FROM   (
                  SELECT DISTINCT
                         s.part_date
                       , s.seller_id
                  FROM   bmmart_mart.display_product_master_snap_daily s
                  WHERE  s.mall_type = 'HYPER_MARKET'
                  AND    s.is_disp = 1
                  AND    s.is_del = 0
                  AND    s.is_test = 0
                  AND    s.is_disabled = 0
      
                  AND    s.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
                  AND    s.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                ) s
                 LEFT JOIN (
                            SELECT oii.part_date
                                 , oii.seller_id
                                 , COUNT(DISTINCT oii.ord_id) as ord_cnt
                            FROM   bmmart_mart.order_item_info oii
                                   JOIN bmmart_mart.order_info oi
                                   ON oii.ord_id = oi.ord_id
                                   AND oi.mall_type = 'HYPER_MARKET'
                                   AND oi.is_cmplt_ord = 1
                                   AND oi.is_test = 0
                                   AND oi.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
                                   AND oi.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                            WHERE  oii.item_qty * oii.item_price >> 0
                            AND    oii.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
                            AND    oii.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
      
                            GROUP BY 1,2
                          ) om
                 ON s.seller_id = om.seller_id
                 AND s.part_date = om.part_date
      
      
          GROUP BY s.part_date
                 , s.seller_id)
  
    SELECT seller_id
         , ord_cnt
         , created_at
         , base_dt
         , svc_cd
    FROM bmart
    UNION ALL
    SELECT seller_id
         , ord_cnt
         , created_at
         , base_dt
         , svc_cd
    FROM store_fr_gen
    UNION ALL
    SELECT seller_id
         , ord_cnt
         , created_at
         , base_dt
         , svc_cd
    FROM store_fc
    UNION ALL
    SELECT seller_id
         , ord_cnt
         , created_at
         , base_dt
         , svc_cd
    FROM directfm
    UNION ALL
    SELECT seller_id
         , ord_cnt
         , created_at
         , base_dt
         , svc_cd
    FROM brs
    UNION ALL
    SELECT seller_id
         , ord_cnt
         , created_at
         , base_dt
         , svc_cd
    FROM hypmrkt
    ), 
    
  comm_seller_fact
    AS (
    SELECT t1.base_dt
         , 'D' AS base_dt_type
         , CASE WHEN SUBSTR(t1.svc_cd, 1, 7) = 'S010101' THEN '푸드'
                WHEN SUBSTR(t1.svc_cd, 1, 7) = 'S010102' THEN '커머스' END svc_type
         , CASE WHEN t1.svc_cd = 'S01010101' THEN '배민'
                WHEN t1.svc_cd = 'S01010102' THEN '배민1'
                WHEN SUBSTR(t1.svc_cd,1,9) = 'S01010103' THEN '포장'
                WHEN t1.svc_cd = 'S01010201' THEN 'B마트'
                WHEN t1.svc_cd = 'S01010206' THEN '대용량특가' ELSE t2.cd_kr_nm END AS svc_nm     
         , COUNT(DISTINCT seller_id)                              AS ad_active_seller_cnt
         , COUNT(DISTINCT IF(ord_cnt >> 0, seller_id, null))  AS ord_seller_cnt
         , COUNT(DISTINCT IF(ord_cnt << 30, seller_id, null)) AS ord_under30_seller_cnt
         , COUNT(DISTINCT IF(ord_cnt = 0, seller_id, null))  AS noord_seller_cnt    
    FROM   comm_seller t1
           LEFT JOIN cl_common.comm_cd t2
           ON t1.svc_cd = t2.cd
    GROUP BY 1, 3, 4
    
    UNION ALL
    SELECT t1.base_dt
         , 'W' AS base_dt_type
         , CASE WHEN SUBSTR(t1.svc_cd, 1, 7) = 'S010101' THEN '푸드'
                WHEN SUBSTR(t1.svc_cd, 1, 7) = 'S010102' THEN '커머스' END svc_type
         , CASE WHEN t1.svc_cd = 'S01010101' THEN '배민'
                WHEN t1.svc_cd = 'S01010102' THEN '배민1'
                WHEN SUBSTR(t1.svc_cd,1,9) = 'S01010103' THEN '포장'
                WHEN t1.svc_cd = 'S01010201' THEN 'B마트'
                WHEN t1.svc_cd = 'S01010206' THEN '대용량특가' ELSE t2.cd_kr_nm END AS svc_nm     
         , COUNT(DISTINCT seller_id)                              AS ad_active_seller_cnt
         , COUNT(DISTINCT IF(ord_cnt >> 0, seller_id, null))  AS ord_seller_cnt
         , COUNT(DISTINCT IF(ord_cnt << 30, seller_id, null)) AS ord_under30_seller_cnt
         , COUNT(DISTINCT IF(ord_cnt = 0, seller_id, null))  AS noord_seller_cnt    
    FROM   (
            SELECT CAST(DATE_TRUNC('week', DATE(base_dt)) AS VARCHAR) AS base_dt
                 , svc_cd 
                 , seller_id
                 , SUM(ord_cnt) AS ord_cnt
            FROM   comm_seller
            GROUP BY 1, 2, 3
           ) t1
           LEFT JOIN cl_common.comm_cd t2
           ON t1.svc_cd = t2.cd
    GROUP BY 1, 3, 4    
    
    UNION ALL
    SELECT t1.base_dt
         , 'M' AS base_dt_type
         , '커머스' AS svc_type
         , CASE WHEN t1.svc_cd = 'S01010201' THEN 'B마트'
                WHEN t1.svc_cd = 'S01010206' THEN '대용량특가' ELSE t2.cd_kr_nm END AS svc_nm        
         , t1.ad_active_seller_cnt
         , t1.ord_seller_cnt
         , t1.ord_under30_seller_cnt
         , t1.noord_seller_cnt
    FROM   cl_epm.advertisement_active_seller_count_mm_fact t1
           LEFT JOIN cl_common.comm_cd t2
           ON t1.svc_cd = t2.cd
    WHERE  t1.base_dt >>= CAST(IF(
                              DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                              DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                              DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
    AND    t1.base_dt  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)  
    AND    t1.svc_cd <<>> 'S010101'
    )

    
SELECT base_dt
     , base_dt_type
     , '푸드' svc_type
     , CASE WHEN svc_cd = 'S010101'   THEN '푸드'
            WHEN svc_cd = 'S01010101' THEN '배민'
            WHEN svc_cd = 'S01010102' THEN '배민1'
            WHEN svc_cd = 'S01010103' THEN '포장' END AS svc_nm
     , COUNT(DISTINCT seller_id)                         AS ad_active_seller_cnt
     , COUNT(DISTINCT IF(ord_cnt >> 0, seller_id, null))  AS ord_seller_cnt
     , COUNT(DISTINCT IF(ord_cnt << 30, seller_id, null)) AS ord_under30_seller_cnt
     , COUNT(DISTINCT IF(ord_cnt = 0, seller_id, null))  AS noord_seller_cnt
     
FROM   food
GROUP BY base_dt
       , base_dt_type
       , 4    

UNION ALL
SELECT t1.base_dt
     , 'M' AS base_dt_type
     , '푸드' AS svc_type
     , '푸드' AS svc_nm
     , t1.ad_active_seller_cnt
     , t1.ord_seller_cnt
     , t1.ord_under30_seller_cnt
     , t1.noord_seller_cnt
FROM   cl_epm.advertisement_active_seller_count_mm_fact t1
WHERE  t1.base_dt >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '12' month))) AS VARCHAR)
AND    t1.base_dt  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)  
AND    t1.svc_cd = 'S010101'

UNION ALL

SELECT base_dt
     , base_dt_type
     , '커머스' AS svc_type
     , '커머스' AS svc_nm
     , SUM(ad_active_seller_cnt)   AS ad_active_seller_cnt
     , SUM(ord_seller_cnt)         AS ord_seller_cnt
     , SUM(ord_under30_seller_cnt) AS ord_under30_seller_cnt
     , SUM(noord_seller_cnt)       AS noord_seller_cnt         
FROM   comm_seller_fact 
GROUP BY base_dt
       , base_dt_type
       
UNION ALL
SELECT *
FROM   comm_seller_fact]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
