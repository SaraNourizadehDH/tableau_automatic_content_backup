      <column caption='항목이름' datatype='string' name='[Calculation_4167729642805325829]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [owner_service_group]&#10;WHEN &apos;BAEMIN_ONLY&apos; THEN &apos;배민&apos;&#10;WHEN &apos;BAERA_ONLY&apos;  THEN &apos;배라&apos;&#10;WHEN &apos;BAEMIN_1_ONLY&apos;  THEN &apos;배민1&apos;&#10;WHEN &apos;TAKEOUT_ONLY&apos; THEN &apos;포장방문 ONLY&apos;&#10;WHEN &apos;BAEMIN_BAEMIN_1&apos; THEN &apos;배민&amp;배민1&apos;&#10;ELSE NULL&#10;END' />
        <aliases>
          <alias key='&quot;포장방문 ONLY&quot;' value='포장 ONLY' />
