      <column caption='조회 기간 제한' datatype='boolean' name='[Calculation_4167729642812874764]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;주별&apos; THEN [std_cd] = &apos;W&apos;&#10;            AND DATE([std_dt]) &gt;= DATEADD(&apos;week&apos;, -108, DATETRUNC(&apos;week&apos;, [Calculation_4167729642804957187], &apos;monday&apos;))&#10;&#10;WHEN &apos;월별&apos; THEN [std_cd] = &apos;M&apos;&#10;            AND DATE([std_dt]) &gt;= DATEADD(&apos;month&apos;, -24, DATETRUNC(&apos;month&apos;, [Calculation_4167729642804957187]))&#10;END' />
      </column>
