    <worksheet name='(광고업주수) 광고 수 배민1별도차트'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#556476' fontsize='10'>배민1 광고 수</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location id='1_' path='/workbooks/___16185401274710' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='전사KPI_상세광고수' name='sqlproxy.1prfzxq1130y3j1crbhlc0vra1sx' />
            <datasource caption='전사KPI_상세광고업주수' name='sqlproxy.1wk7syf1h0k3b812zxnfj17i3awa' />
            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='조회 기간 구분값' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;주별&quot;'>
              <calculation class='tableau' formula='&quot;주별&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.1prfzxq1130y3j1crbhlc0vra1sx'>
            <column caption='to_dt' datatype='datetime' name='[Calculation_1398578822715441154]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;, -1, TODAY())' />
            </column>
            <column caption='조회 기간 값' datatype='integer' name='[Calculation_1398578822727815180]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_1398578822728695822],[cnt_ad_end],0)' />
            </column>
            <column caption='조회 기간 값 NULL 처리' datatype='integer' name='[Calculation_1398578822727893005]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_1398578822727815180]!=0, [Calculation_1398578822727815180], NULL)' />
            </column>
            <column caption='조회 기간 제한' datatype='boolean' name='[Calculation_1398578822728695822]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;주별&apos; THEN [std_cd] = &apos;W&apos;&#10;            AND DATE([std_dt]) &gt;= DATEADD(&apos;week&apos;, -108, DATETRUNC(&apos;week&apos;, [Calculation_1398578822715441154], &apos;monday&apos;))&#10;&#10;WHEN &apos;월별&apos; THEN [std_cd] = &apos;M&apos;&#10;            AND DATE([std_dt]) &gt;= DATEADD(&apos;month&apos;, -24, DATETRUNC(&apos;month&apos;, [Calculation_1398578822715441154]))&#10;END' />
            </column>
            <column caption='std_dt(date)' datatype='date' name='[Calculation_267260530367639552]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([std_dt])' />
            </column>
            <column caption='일자 필터' datatype='date' name='[Calculation_79798186081599488]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([std_dt])' />
            </column>
            <column caption='lv2_항목이름' datatype='string' name='[Calculation_96686685967376388]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [ad_inventory_lv2_group] = &quot;BAERA&quot; THEN &quot;배라&quot;&#10;ELSEIF [ad_inventory_lv2_group] = &quot;BAEMIN&quot; THEN &quot;배민&quot;&#10;ELSEIF [ad_inventory_lv2_group] = &quot;LISTING&quot; THEN &quot;리스팅&quot;&#10;ELSEIF [ad_inventory_lv2_group] = &quot;OPEN_LIST&quot; THEN &quot;오픈리스트&quot;&#10;ELSEIF [ad_inventory_lv2_group] = &quot;TAKEOUT&quot; THEN &quot;포장방문&quot;&#10;ELSEIF [ad_inventory_lv2_group] = &quot;SOLO&quot; THEN &quot;1인분&quot;&#10;ELSEIF [ad_inventory_lv2_group] = &quot;OPEN_SERVICE&quot; THEN &quot;오픈서비스&quot;&#10;ELSEIF [ad_inventory_lv2_group] = &quot;BAEMIN_1&quot; THEN &quot;배민1&quot;&#10;END' />
              <aliases>
                <alias key='&quot;포장방문&quot;' value='포장' />
              </aliases>
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[ad_inventory_lv2_group]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[cnt_ad_end]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
