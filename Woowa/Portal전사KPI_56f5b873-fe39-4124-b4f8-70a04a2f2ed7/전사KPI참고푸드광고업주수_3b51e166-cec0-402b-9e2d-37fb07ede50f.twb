      </column>
      <column caption='현재 구간 조회' datatype='boolean' name='[Calculation_4167729642805547014]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;주별&apos; THEN [std_cd] = &apos;W&apos;&#10;            AND DATE(std_dt) = DATETRUNC(&apos;week&apos;, [Calculation_4167729642804957187], &apos;monday&apos;)&#10;&#10;WHEN &apos;월별&apos; THEN [std_cd] = &apos;M&apos;&#10;            AND DATE(std_dt) = DATETRUNC(&apos;month&apos;, [Calculation_4167729642804957187])&#10;END' />
      </column>
      <column caption='현재 구간 값' datatype='integer' name='[Calculation_4167729642805751815]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_4167729642805547014], [cnt_owner_end], 0)' />
      </column>
      <column caption='이전 구간 조회' datatype='boolean' name='[Calculation_4167729642806951944]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;주별&apos; THEN [std_cd] = &apos;W&apos;&#10;            AND DATE(std_dt) = DATEADD(&apos;day&apos;, -7, DATETRUNC(&apos;week&apos;, [Calculation_4167729642804957187],&apos;monday&apos;))&#10;&#10;WHEN &apos;월별&apos; THEN [std_cd] = &apos;M&apos;&#10;            AND DATE(std_dt) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;, [Calculation_4167729642804957187])))&#10;END' />
      </column>
      <column caption='이전 구간 값' datatype='integer' name='[Calculation_4167729642807095305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_4167729642806951944],[cnt_owner_end],0)' />
      </column>
      <column caption='이전 구간대비 증감률' datatype='real' default-format='*▲ 0.00%; ▼ 0.00%' name='[Calculation_4167729642807300106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_4167729642805751815]) - SUM([Calculation_4167729642807095305]))/SUM([Calculation_4167729642807095305])' />
      </column>
      <column caption='구간대비 증감률 범례' datatype='string' name='[Calculation_4167729642809286667]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1] &#10;WHEN &apos;주별&apos; THEN &apos;vs. 지난주&apos;&#10;ELSE &apos;vs. 지난달&apos;&#10;END' />
