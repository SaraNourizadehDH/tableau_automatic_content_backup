            <column aggregation='Count' caption='현재 구간 조회(전화주문)' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_183099506360647681]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;주별&apos; THEN &#10;(CASE [Parameters].[매개 변수 3] &#10; WHEN &apos;전화주문 제외&apos; &#10; THEN [std_cd] = &apos;W&apos; AND [svc_cd] != &apos;CALL&apos;&#10;            AND DATE([std_dt]) = DATETRUNC(&apos;week&apos;, [Calculation_321796301139771406], &apos;monday&apos;)&#10; ELSE [std_cd] = &apos;W&apos;&#10;            AND DATE([std_dt]) = DATETRUNC(&apos;week&apos;, [Calculation_321796301139771406], &apos;monday&apos;)&#10; END&#10;)&#10;WHEN &apos;월별&apos; THEN &#10;(CASE [Parameters].[매개 변수 3] &#10; WHEN &apos;전화주문 제외&apos; &#10; THEN [std_cd] = &apos;M&apos; AND [svc_cd] != &apos;CALL&apos;&#10;            AND DATE([std_dt]) = DATETRUNC(&apos;month&apos;, [Calculation_321796301139771406])&#10; ELSE [std_cd] = &apos;M&apos;&#10;            AND DATE([std_dt]) = DATETRUNC(&apos;month&apos;, [Calculation_321796301139771406])&#10;END&#10;)&#10;END' />
            </column>
            <column aggregation='Count' caption='이전 구간 조회(전화주문)' datatype='boolean' default-type='nominal' layered='true' name='[Calculation_183099506361434115]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;주별&apos; THEN &#10;(CASE [Parameters].[매개 변수 3] &#10; WHEN &apos;전화주문 제외&apos; &#10; THEN [std_cd] = &apos;W&apos;&#10;            AND DATE([std_dt]) = DATEADD(&apos;day&apos;, -7, DATETRUNC(&apos;week&apos;, [Calculation_321796301139771406],&apos;monday&apos;))&#10; ELSE [std_cd] = &apos;W&apos;&#10;            AND DATE([std_dt]) = DATEADD(&apos;day&apos;, -7, DATETRUNC(&apos;week&apos;, [Calculation_321796301139771406],&apos;monday&apos;))&#10; END&#10;)&#10;WHEN &apos;월별&apos; THEN &#10;(CASE [Parameters].[매개 변수 3] &#10; WHEN &apos;전화주문 제외&apos; &#10; THEN [std_cd] = &apos;M&apos;&#10;            AND DATE([std_dt]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;, [Calculation_321796301139771406])))&#10; ELSE [std_cd] = &apos;M&apos;&#10;            AND DATE([std_dt]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;, [Calculation_321796301139771406])))&#10; END&#10;)&#10;END' />
            </column>
            <column aggregation='Sum' caption='현재 구간 경과일수' datatype='integer' default-type='quantitative' layered='true' name='[Calculation_183099506398511154]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1] &#10;WHEN &apos;주별&apos; THEN&#10;DATEDIFF(&apos;day&apos;, &#10;DATETRUNC(&apos;week&apos;, [Calculation_321796301139771406], &apos;monday&apos;), [Calculation_321796301139771406]) + 1&#10;ELSE&#10;DATEDIFF(&apos;day&apos;, &#10;DATETRUNC(&apos;month&apos;, [Calculation_321796301139771406]), [Calculation_321796301139771406]) + 1&#10;END' />
            </column>
            <column aggregation='Count' caption='조회 기간 구분 범례' datatype='string' default-type='nominal' layered='true' name='[Calculation_183099506404122687]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
