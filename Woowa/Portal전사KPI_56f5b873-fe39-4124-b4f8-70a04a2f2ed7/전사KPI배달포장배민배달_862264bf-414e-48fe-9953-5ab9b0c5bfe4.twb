            <attributes>
              <attribute datatype='integer' name='field-type'>2</attribute>
              <attribute datatype='string' name='formula'>&quot;CASE [svc_cd]
WHEN &apos;BAEMIN&apos; THEN &apos;배민배달&apos;
WHEN &apos;BAERA&apos; THEN &apos;배민1배달&apos;
WHEN &apos;CALL&apos; THEN &apos;배민배달&apos;
WHEN &apos;TAKEOUT&apos; THEN &apos;포장방문&apos;
WHEN &apos;DIRECTFARM&apos; THEN &apos;배민배달&apos;
WHEN &apos;ALL&apos; THEN &apos;전체&apos;
END&quot;</attribute>
