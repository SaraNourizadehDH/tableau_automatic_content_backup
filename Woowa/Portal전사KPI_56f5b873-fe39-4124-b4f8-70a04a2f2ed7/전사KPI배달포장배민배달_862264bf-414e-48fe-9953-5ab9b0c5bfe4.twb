            </column>
            <column aggregation='Count' caption='포장배달 유형(배민,전화)' datatype='string' default-type='nominal' layered='true' name='[Calculation_3116490994477694985 1]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='CASE [svc_cd]&#10;WHEN &apos;BAEMIN&apos; THEN &apos;배민배달&apos;&#10;WHEN &apos;BAERA&apos; THEN &apos;배민1배달&apos;&#10;WHEN &apos;CALL&apos; THEN &apos;배민배달&apos;&#10;WHEN &apos;TAKEOUT&apos; THEN &apos;포장방문&apos;&#10;WHEN &apos;DIRECTFARM&apos; THEN &apos;전국별미&apos;&#10;WHEN &apos;ALL&apos; THEN &apos;전체&apos;&#10;END' />
