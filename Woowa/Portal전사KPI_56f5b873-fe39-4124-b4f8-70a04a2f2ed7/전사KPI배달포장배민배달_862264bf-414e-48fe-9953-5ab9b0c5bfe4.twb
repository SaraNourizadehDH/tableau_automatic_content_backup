              <calculation class='tableau' formula='((SUM([Calculation_1056094152352641028])/[Calculation_183099506398511154])/(SUM([(주문자수)현재 구간 값(복사본)_1056094152352849925])/[계산1(복사본)_183099506400100408])) - 1' />
