            <column aggregation='Sum' caption='(GMV)이전 구간 값' datatype='integer' default-type='quantitative' layered='true' name='[(GMV)현재 구간 값(복사본)_531354426937806890]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default'>
