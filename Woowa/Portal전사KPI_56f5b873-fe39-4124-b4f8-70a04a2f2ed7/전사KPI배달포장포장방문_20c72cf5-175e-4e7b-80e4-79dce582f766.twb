 THEN [std_cd] = &apos;W&apos; AND [svc_cd] != &apos;CALL&apos;
            AND DATE([std_dt]) = DATETRUNC(&apos;week&apos;, [Calculation_321796301139771406], &apos;monday&apos;)
 ELSE [std_cd] = &apos;W&apos;
            AND DATE([std_dt]) = DATETRUNC(&apos;week&apos;, [Calculation_321796301139771406], &apos;monday&apos;)
 END
)
WHEN &apos;월별&apos; THEN 
(CASE [Parameters].[매개 변수 3] 
 WHEN &apos;전화주문 제외&apos; 
 THEN [std_cd] = &apos;M&apos; AND [svc_cd] != &apos;CALL&apos;
            AND DATE([std_dt]) = DATETRUNC(&apos;month&apos;, [Calculation_321796301139771406])
 ELSE [std_cd] = &apos;M&apos;
            AND DATE([std_dt]) = DATETRUNC(&apos;month&apos;, [Calculation_321796301139771406])
END
)
END&quot;</attribute>
