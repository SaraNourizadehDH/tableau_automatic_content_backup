              <calculation class='tableau' formula='IIF( (SUM([Calculation_1056094152352641028]))/(SUM([(주문자수)현재 구간 값(복사본)_1056094152352849925])) &lt;= 1, &#10;     (SUM([Calculation_1056094152352641028]))/(SUM([(주문자수)현재 구간 값(복사본)_1056094152352849925])),&#10;     1)' />
