      <column caption='현재 구간 조회' datatype='boolean' name='[Calculation_183099506360647681]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#10;WHEN &apos;주별&apos; THEN [std_cd] = &apos;W&apos;&#10;            AND DATE([std_dt]) = DATETRUNC(&apos;week&apos;, [Calculation_321796301139771406], &apos;monday&apos;)&#10;&#10;WHEN &apos;월별&apos; THEN [std_cd] = &apos;M&apos;&#10;            AND DATE([std_dt]) = DATETRUNC(&apos;month&apos;, [Calculation_321796301139771406])&#10;END' />
      </column>
      <column caption='이전 구간 조회' datatype='boolean' name='[Calculation_183099506361434115]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#10;WHEN &apos;주별&apos; THEN [std_cd] = &apos;W&apos;&#10;            AND DATE([std_dt]) = DATEADD(&apos;day&apos;, -7, DATETRUNC(&apos;week&apos;, [Calculation_321796301139771406],&apos;monday&apos;))&#10;&#10;WHEN &apos;월별&apos; THEN [std_cd] = &apos;M&apos;&#10;            AND DATE([std_dt]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;, [Calculation_321796301139771406])))&#10;END' />
      </column>
      <column caption='(방문자수)현재 구간 값' datatype='integer' name='[Calculation_183099506361790468]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_183099506360647681], [uniq_visit_mem_cnt], 0)' />
      </column>
