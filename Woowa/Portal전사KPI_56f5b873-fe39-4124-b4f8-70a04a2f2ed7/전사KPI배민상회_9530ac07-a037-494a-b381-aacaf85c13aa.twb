  <worksheets>
    <worksheet name='(카드)목표거래액'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#556476'>| 거래액 </run>
            <run fontcolor='#556476' fontsize='10'>(배송비제외)</run>
            <run bold='true' fontcolor='#556476'>Æ  </run>
            <run fontcolor='#556476' fontsize='10'><![CDATA[<[Parameters].[매개 변수 1]> 거래액 트렌드]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='전사KPI_배민상회' name='sqlproxy.0xyb3zt1rq0tyg12ntt0x1hnnlmw(복사본)' />
            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='조회 기간 구분값' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;주별&quot;'>
              <calculation class='tableau' formula='&quot;주별&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0xyb3zt1rq0tyg12ntt0x1hnnlmw(복사본)'>
            <column caption='조회 기간 구분 범례' datatype='string' name='[Calculation_153122441067118592]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1] &#10;WHEN &apos;주별&apos; THEN &apos;주&apos;&#10;ELSE &apos;달&apos;&#10;END' />
            </column>
            <column caption='날짜_weekstd' datatype='date' name='[Calculation_153122441068986370]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;,[날짜]))' />
            </column>
            <column caption='날짜_monthstd' datatype='date' name='[Calculation_153122441070030851]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[날짜]))' />
            </column>
            <column caption='to_dt' datatype='datetime' name='[Calculation_153122441071673349]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;, -1, today())' />
            </column>
            <column caption='구간조회_현재' datatype='boolean' name='[Calculation_153122441074237449]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;주별&apos; THEN DATE([Calculation_153122441068986370]) = DATETRUNC(&apos;week&apos;, [Calculation_153122441071673349])&#10;&#10;WHEN &apos;월별&apos; THEN DATE([Calculation_153122441070030851]) = DATETRUNC(&apos;month&apos;, [Calculation_153122441071673349])&#10;END' />
            </column>
            <column caption='조회 기간 제한' datatype='boolean' name='[Calculation_153122441074503690]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;주별&apos; THEN DATE([날짜]) &gt;= DATEADD(&apos;week&apos;, -108, DATETRUNC(&apos;week&apos;, [Calculation_153122441071673349]))&#10;                AND DATE([날짜]) &lt; DATEADD(&apos;week&apos;, 1, DATETRUNC(&apos;week&apos;, [Calculation_153122441071673349]))&#10;WHEN &apos;월별&apos; THEN DATE([날짜]) &gt;= DATEADD(&apos;month&apos;, -24, DATETRUNC(&apos;month&apos;, [Calculation_153122441071673349]))&#10;                AND DATE([날짜]) &lt; DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Calculation_153122441071673349]))&#10;END' />
            </column>
            <column caption='조회 기간 NULL 처리' datatype='date' name='[Calculation_153122441076269067]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IIF([Calculation_153122441074503690],DATE([Calculation_153122441114771507]),NULL)' />
            </column>
            <column caption='(거래액)식재료_전체' datatype='integer' name='[Calculation_153122441083334670]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[식재료_쌀]+[가공식재료]+[신선식재료]' />
            </column>
            <column caption='(거래액)비품_전체' datatype='integer' name='[Calculation_153122441083469839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([비품]+[제조거점형])+[비품 1]' />
            </column>
            <column caption='(거래액)배송비제외' datatype='integer' name='[Calculation_153122441085796369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_153122441083334670]+[Calculation_153122441083469839]' />
            </column>
            <column caption='(거래액)현재구간 값_배송비제외' datatype='integer' name='[Calculation_153122441093513243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_153122441074237449], [Calculation_153122441085796369], 0)' />
            </column>
            <column caption='(거래액)조회기간 값' datatype='integer' name='[Calculation_153122441096429600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_153122441074503690], [Calculation_153122441085796369], NULL)' />
            </column>
            <column caption='날짜_트렌드' datatype='date' name='[Calculation_153122441114771507]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;주별&apos; THEN [Calculation_153122441068986370]&#10;ELSE [Calculation_153122441070030851]&#10;END' />
            </column>
            <column caption='(목표_거래액)조회기간 값' datatype='real' name='[Calculation_289848896820318209]' role='measure' type='quantitative'>
