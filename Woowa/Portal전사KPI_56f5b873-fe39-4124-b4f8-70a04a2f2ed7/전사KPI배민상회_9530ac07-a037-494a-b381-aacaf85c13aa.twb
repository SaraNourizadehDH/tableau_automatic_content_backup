              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[날짜]))' />
            </column>
            <column caption='to_dt' datatype='datetime' name='[Calculation_153122441071673349]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;, -1, today())' />
            </column>
            <column caption='조회 기간 제한' datatype='boolean' name='[Calculation_153122441074503690]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;주별&apos; THEN DATE([날짜]) &gt;= DATEADD(&apos;week&apos;, -108, DATETRUNC(&apos;week&apos;, [Calculation_153122441071673349]))&#10;                AND DATE([날짜]) &lt; DATEADD(&apos;week&apos;, 1, DATETRUNC(&apos;week&apos;, [Calculation_153122441071673349]))&#10;WHEN &apos;월별&apos; THEN DATE([날짜]) &gt;= DATEADD(&apos;month&apos;, -24, DATETRUNC(&apos;month&apos;, [Calculation_153122441071673349]))&#10;                AND DATE([날짜]) &lt; DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Calculation_153122441071673349]))&#10;END' />
            </column>
            <column caption='조회 기간 NULL 처리' datatype='date' name='[Calculation_153122441076269067]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IIF([Calculation_153122441074503690],DATE([Calculation_153122441114771507]),NULL)' />
