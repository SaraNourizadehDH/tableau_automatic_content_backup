            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[noti_time_interval]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[std_cd]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='date' datatype-customized='true' default-type='ordinal' layered='true' name='[std_dt]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
            <column-instance column='[Calculation_217157981093613596]' derivation='Sum' name='[sum:Calculation_217157981093613596:qk]' pivot='key' type='quantitative' />
            <column-instance column='[(배달준수율)이전 구간대비 현재 증감(복사본)_217157981094866975]' derivation='User' name='[usr:(배달준수율)이전 구간대비 현재 증감(복사본)_217157981094866975:qk]' pivot='key' type='quantitative' />
