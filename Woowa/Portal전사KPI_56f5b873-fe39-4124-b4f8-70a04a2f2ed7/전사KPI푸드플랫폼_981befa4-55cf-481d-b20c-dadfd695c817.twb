            <column caption='조회 기간 구분 범례' datatype='string' name='[Calculation_1056094152521760802]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2] &#10;WHEN &apos;주별&apos; THEN &apos;주&apos;&#10;ELSE &apos;달&apos;&#10;END' />
            </column>
            <column caption='이전 구간 조회' datatype='boolean' name='[Calculation_269582695683551235]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#10;WHEN &apos;주별&apos; THEN [std_cd] = &apos;W&apos;&#10;            AND DATE(std_dt) = DATEADD(&apos;day&apos;, -7, DATETRUNC(&apos;week&apos;, [Calculation_321796301139771406],&apos;monday&apos;))&#10;&#10;WHEN &apos;월별&apos; THEN [std_cd] = &apos;M&apos;&#10;            AND DATE(std_dt) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;, [Calculation_321796301139771406])))&#10;END' />
            </column>
            <column caption='현재 구간 조회' datatype='boolean' name='[Calculation_269582695683670020]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#10;WHEN &apos;주별&apos; THEN [std_cd] = &apos;W&apos;&#10;            AND DATE(std_dt) = DATETRUNC(&apos;week&apos;, [Calculation_321796301139771406], &apos;monday&apos;)&#10;&#10;WHEN &apos;월별&apos; THEN [std_cd] = &apos;M&apos;&#10;            AND DATE(std_dt) = DATETRUNC(&apos;month&apos;, [Calculation_321796301139771406])&#10;END' />
            </column>
            <column caption='조회 기간 제한' datatype='boolean' name='[Calculation_269582695683829765]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#10;WHEN &apos;주별&apos; THEN [std_cd] = &apos;W&apos;&#10;            AND DATE([std_dt]) &gt;= DATEADD(&apos;week&apos;, -108, DATETRUNC(&apos;week&apos;, [Calculation_321796301139771406], &apos;monday&apos;))&#10;&#10;WHEN &apos;월별&apos; THEN [std_cd] = &apos;M&apos;&#10;            AND DATE([std_dt]) &gt;= DATEADD(&apos;month&apos;, -24, DATETRUNC(&apos;month&apos;, [Calculation_321796301139771406]))&#10;END' />
            </column>
            <column caption='(평균배달시간)현재 구간 값' datatype='real' name='[Calculation_269582695683932166]' role='measure' type='quantitative'>
