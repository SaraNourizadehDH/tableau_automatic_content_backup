    <worksheet name='(배달포장)배달품질지표-준수율(그외)'>
      <table>
        <view>
          <datasources>
            <datasource caption='전사KPI_배민1품질지수(배달기준)' name='sqlproxy.1mrmm0q0y16svh1dumoz108osebf' />
            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='조회 기간 구분값' datatype='string' name='[매개 변수 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;월별&quot;'>
              <calculation class='tableau' formula='&quot;월별&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.1mrmm0q0y16svh1dumoz108osebf'>
            <column caption='(배달준수율)이전 구간대비 현재 증감-' datatype='real' name='[(배달준수율)이전 구간대비 현재 증감(복사본)_217157981094866975]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_217157981094363166] &lt; 0 , [Calculation_217157981094363166], NULL)' />
            </column>
            <column caption='(배달준수율)이전 구간대비 현재 증감+' datatype='real' name='[(배달준수율)이전 구간대비 현재 증감-(복사본)_217157981094965280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_217157981094363166] &gt;= 0 , [Calculation_217157981094363166], NULL)' />
            </column>
            <column caption='(배달준수율)이전 구간 값' datatype='real' name='[(배달준수율)현재 구간 값(복사본)_217157981093822493]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_217157981058949120], [fast_ok_dlvry_cnt]/[all_dlvry_cnt], NULL)' />
            </column>
            <column caption='이전 구간 조회' datatype='boolean' name='[Calculation_217157981058949120]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#10;WHEN &apos;주별&apos; THEN [std_cd] = &apos;W&apos;&#10;            AND DATE(std_dt) = DATEADD(&apos;day&apos;, -7, DATETRUNC(&apos;week&apos;, [Calculation_321796301139771406],&apos;monday&apos;))&#10;&#10;WHEN &apos;월별&apos; THEN [std_cd] = &apos;M&apos;&#10;            AND DATE(std_dt) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;, [Calculation_321796301139771406])))&#10;END' />
            </column>
            <column caption='구간대비 차이 범례' datatype='string' name='[Calculation_217157981082734615]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#10;WHEN &apos;주별&apos; THEN &apos;지난주&apos;&#10;ELSE &apos;지난달&apos;&#10;END' />
            </column>
            <column caption='(배달준수율)현재 구간 값' datatype='real' name='[Calculation_217157981093613596]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([이전 구간 조회(복사본)_217157981059301377], [fast_ok_dlvry_cnt]/[all_dlvry_cnt], NULL)' />
            </column>
            <column caption='(배달준수율)이전 구간대비 현재 증감' datatype='real' name='[Calculation_217157981094363166]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_217157981093613596]) - sum([(배달준수율)현재 구간 값(복사본)_217157981093822493])' />
            </column>
            <column caption='to_dt' datatype='datetime' name='[Calculation_321796301139771406]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;, -1, today())' />
            </column>
            <column caption='배라배달 유형' datatype='string' name='[Calculation_79587090674855939]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [fast_free_delivery_type]&#10;WHEN &apos;핵심지역 외&apos; THEN &apos;핵심지 외 일반지역&apos;&#10;ELSE [fast_free_delivery_type]&#10;END' />
            </column>
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[all_dlvry_cnt]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[fast_free_delivery_type]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[fast_ok_dlvry_cnt]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column-instance column='[Calculation_217157981082734615]' derivation='None' name='[none:Calculation_217157981082734615:nk]' pivot='key' type='nominal' />
