              <calculation class='tableau' formula='CASE [fast_free_delivery_type]&#10;WHEN &apos;핵심지역 외&apos; THEN &apos;핵심지 외 일반지역&apos;&#10;ELSE [fast_free_delivery_type]&#10;END' />
            </column>
            <column caption='안내시간분포(차트용)' datatype='string' name='[Calculation_952229883342454810]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [noti_time_interval] = &quot;20분이상 30분미만&quot;&#10;THEN &quot;20분이상&#10;30분미만&quot;&#10;ELSEIF [noti_time_interval] = &quot;30분이상 40분미만&quot;&#10;THEN &quot;30분이상&#10;40분미만&quot;&#10;ELSEIF [noti_time_interval] = &quot;40분이상 50분미만&quot;&#10;THEN &quot;40분이상&#10;50분미만&quot;&#10;ELSEIF [noti_time_interval] = &quot;50분이상 60분미만&quot;&#10;THEN &quot;50분이상&#10;60분미만&quot;&#10;ELSE [noti_time_interval]&#10;END' />
