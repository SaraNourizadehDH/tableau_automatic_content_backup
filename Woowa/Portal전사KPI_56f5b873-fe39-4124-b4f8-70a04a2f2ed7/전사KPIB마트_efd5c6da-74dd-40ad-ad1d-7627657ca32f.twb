      <column caption='현재 구간 경과일수' datatype='integer' name='[Calculation_183099506398511154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2] &#10;WHEN &apos;주별&apos; THEN&#10;DATEDIFF(&apos;day&apos;, &#10;DATETRUNC(&apos;week&apos;, [Calculation_321796301139771406], &apos;monday&apos;), [Calculation_321796301139771406]) + 1&#10;ELSE&#10;DATEDIFF(&apos;day&apos;, &#10;DATETRUNC(&apos;month&apos;, [Calculation_321796301139771406]), [Calculation_321796301139771406]) + 1&#10;END' />
