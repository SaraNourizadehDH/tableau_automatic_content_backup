      <column caption='rt' datatype='real' name='[Calculation_2131539653037252609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([cnt]) / attr({fixed [Calculation_4286652811929604096]: sum(if [검수 구분]==&apos;1-1) 탐지&apos; then [cnt] else 0 END)})' />
      </column>
      <column caption='조회조건 계산식' datatype='datetime' default-format='*MM/dd' name='[Calculation_4286652811929604096]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 3]==&apos;일별&apos; THEN [part_date]&#10;ELSEIF [Parameters].[매개 변수 3]==&apos;주별&apos; THEN DATETRUNC(&apos;week&apos;, [part_date], &apos;monday&apos;)&#10;ELSEIF [Parameters].[매개 변수 3]==&apos;월별&apos; THEN DATETRUNC(&apos;month&apos;, [part_date])&#10;END' />
      </column>
      <column caption='조회기간 계산식' datatype='boolean' name='[Calculation_4286652811929821185]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[part_date]&gt;=[Parameters].[매개 변수 1] and [part_date]&lt;=[Parameters].[조회 기간 (시작일)(복사본)_5701838627163226112]' />
      </column>
      <column caption='총합계' datatype='integer' name='[Calculation_4859243283564236800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='attr({fixed [검수 구분], [gubun], [날짜 구분] : sum(if [Calculation_4286652811929821185] then [cnt] else 0 END)})' />
      </column>
      <column caption='평균' datatype='real' name='[Calculation_4859243283564314625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='round(attr({fixed [검수 구분], [gubun], [날짜 구분] : sum(if [Calculation_4286652811929821185] then cnt else 0 end)/COUNTD(if [Calculation_4286652811929821185] then [Calculation_4286652811929604096] else NULL end) }),1 )' />
      </column>
      <column caption='end_date' datatype='date' name='[Calculation_4917086392055132160]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY()' />
      </column>
      <column caption='start_date' datatype='date' name='[Calculation_4917086392055181313]' role='dimension' type='ordinal'>
