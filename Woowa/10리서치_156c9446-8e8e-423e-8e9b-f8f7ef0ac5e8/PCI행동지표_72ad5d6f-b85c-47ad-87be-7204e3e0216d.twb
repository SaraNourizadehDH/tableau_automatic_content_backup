      <column caption='카운트' datatype='integer' name='[Calculation_1999176074146680840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ INCLUDE [Calculation_5694590673198256132],[평가앱 (주관식)] : COUNTD([PANELNO_평가앱 (주관식)])})' />
      </column>
      <column caption='구성비율' datatype='real' name='[Calculation_1999176074148757514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ INCLUDE [Calculation_5694590673198256132],[평가앱 (주관식)] : COUNTD([PANELNO_평가앱 (주관식)])}) /SUM({ FIXED [Calculation_5694590673198256132],[평가앱 (주관식)] : COUNTD([PANELNO_평가앱 (주관식)])})' />
      </column>
      <column caption='First Month of Quarter' datatype='string' name='[Calculation_2462202401271889920]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF contains([분기], &quot;Q1&quot;) then &quot;January&quot;&#10;elseif contains([분기], &quot;Q2&quot;) then &quot;April&quot;&#10;elseif contains([분기], &quot;Q3&quot;) then &quot;July&quot;&#10;else &quot;October&quot; END' />
      </column>
      <column caption='Date Field' datatype='date' name='[Calculation_2462202401272348673]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(left([분기],4)+&#10;CASE RIGHT([분기],1)&#10;WHEN &apos;1&apos; THEN &apos;-01-01&apos;&#10;WHEN &apos;2&apos; THEN &apos;-04-01&apos;&#10;WHEN &apos;3&apos; THEN &apos;-07-01&apos;&#10;WHEN &apos;4&apos; THEN &apos;-10-01&apos;&#10;END&#10;)' />
      </column>
      <column caption='메뉴/가게 탐색' datatype='real' name='[Calculation_2462202401272942594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*SUM(IF [Task1_만족도] &gt;=5 AND NOT ISNULL([Task1_만족도] ) AND [Task1_성공여부] = &apos;성공&apos;  THEN 1 ELSE 0 END) / &#10;COUNTD(IF NOT ISNULL([Task1_만족도] ) AND [Task1_성공여부] = &apos;성공&apos;  THEN [PANELNO_평가앱] ELSE NULL END)' />
      </column>
      <column caption='긍/부정' datatype='string' name='[Calculation_376120984622682113]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE LEFT([Code Cate(복사본)_376120984622612480],3) WHEN &apos;◆긍정&apos; THEN &apos;긍정&apos;&#10;                     WHEN &apos;◆부정&apos; THEN &apos;부정&apos;&#10; END' />
      </column>
      <column caption='만족도' datatype='string' name='[Calculation_5694590673179377665]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [DIVISION] &lt;&gt; &apos;SUPRQ_Q8&apos; AND [Q_Value]&gt;=5 THEN &apos;만족&apos;&#10;ELSEIF [DIVISION] &lt;&gt; &apos;SUPRQ_Q8&apos; AND [Q_Value] = 4  THEN &apos;보통&apos;&#10;ELSEIF [DIVISION] &lt;&gt; &apos;SUPRQ_Q8&apos; AND[Q_Value] &lt; 4  THEN &apos;불만족&apos;&#10;ELSEIF [DIVISION] = &apos;SUPRQ_Q8&apos; AND [Q_Value] &gt;= 9  THEN &apos;추천&apos;&#10;ELSEIF [DIVISION] = &apos;SUPRQ_Q8&apos; AND [Q_Value] IN (7,8) THEN &apos;중립&apos;&#10;ELSEIF [DIVISION] = &apos;SUPRQ_Q8&apos; AND[Q_Value] &lt;=6   THEN &apos;비추천&apos;&#10;END' />
      </column>
      <column caption='Date ' datatype='date' name='[Calculation_5694590673198256132]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(left([분기 (주관식)],4)+&#10;CASE RIGHT([분기 (주관식)],1)&#10;WHEN &apos;1&apos; THEN &apos;-01-01&apos;&#10;WHEN &apos;2&apos; THEN &apos;-04-01&apos;&#10;WHEN &apos;3&apos; THEN &apos;-07-01&apos;&#10;WHEN &apos;4&apos; THEN &apos;-10-01&apos;&#10;END&#10;)' />
      </column>
