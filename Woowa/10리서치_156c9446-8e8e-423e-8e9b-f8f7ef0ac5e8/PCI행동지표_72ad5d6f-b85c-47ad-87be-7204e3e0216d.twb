    <worksheet name='주관식긍정요약'>
      <table>
        <view>
          <datasources>
            <datasource caption='Flat_Data(배달PCI조사_Dataset)' name='federated.04c3rvw1eym8sj1ga0qvv1keuo0h' />
          </datasources>
          <datasource-dependencies datasource='federated.04c3rvw1eym8sj1ga0qvv1keuo0h'>
            <column caption='긍/부정' datatype='string' name='[Calculation_376120984622682113]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE LEFT([Code Cate(복사본)_376120984622612480],3) WHEN &apos;◆긍정&apos; THEN &apos;긍정&apos;&#10;                     WHEN &apos;◆부정&apos; THEN &apos;부정&apos;&#10; END' />
            </column>
            <column caption='만족도' datatype='string' name='[Calculation_5694590673179377665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [DIVISION] &lt;&gt; &apos;SUPRQ_Q8&apos; AND [Q_Value]&gt;=5 THEN &apos;만족&apos;&#10;ELSEIF [DIVISION] &lt;&gt; &apos;SUPRQ_Q8&apos; AND [Q_Value] = 4  THEN &apos;보통&apos;&#10;ELSEIF [DIVISION] &lt;&gt; &apos;SUPRQ_Q8&apos; AND[Q_Value] &lt; 4  THEN &apos;불만족&apos;&#10;ELSEIF [DIVISION] = &apos;SUPRQ_Q8&apos; AND [Q_Value] &gt;= 9  THEN &apos;추천&apos;&#10;ELSEIF [DIVISION] = &apos;SUPRQ_Q8&apos; AND [Q_Value] IN (7,8) THEN &apos;중립&apos;&#10;ELSEIF [DIVISION] = &apos;SUPRQ_Q8&apos; AND[Q_Value] &lt;=6   THEN &apos;비추천&apos;&#10;END' />
            </column>
            <column caption='Date ' datatype='date' name='[Calculation_5694590673198256132]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(left([분기 (주관식)],4)+&#10;CASE RIGHT([분기 (주관식)],1)&#10;WHEN &apos;1&apos; THEN &apos;-01-01&apos;&#10;WHEN &apos;2&apos; THEN &apos;-04-01&apos;&#10;WHEN &apos;3&apos; THEN &apos;-07-01&apos;&#10;WHEN &apos;4&apos; THEN &apos;-10-01&apos;&#10;END&#10;)' />
