      <column caption='First Month of Quarter' datatype='string' name='[Calculation_2462202401271889920]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF contains([분기], &quot;Q1&quot;) then &quot;January&quot;&#10;elseif contains([분기], &quot;Q2&quot;) then &quot;April&quot;&#10;elseif contains([분기], &quot;Q3&quot;) then &quot;July&quot;&#10;else &quot;October&quot; END' />
      </column>
      <column caption='Date Field' datatype='date' name='[Calculation_2462202401272348673]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(left([분기],4)+&#10;CASE RIGHT([분기],1)&#10;WHEN &apos;1&apos; THEN &apos;-01-01&apos;&#10;WHEN &apos;2&apos; THEN &apos;-04-01&apos;&#10;WHEN &apos;3&apos; THEN &apos;-07-01&apos;&#10;WHEN &apos;4&apos; THEN &apos;-10-01&apos;&#10;END&#10;)' />
      </column>
      <column caption='Date Field_2' datatype='date' name='[Calculation_530861844589203456]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(left([분기 (PCI태도지표)],4)+&#10;CASE RIGHT([분기 (PCI태도지표)],1)&#10;WHEN &apos;1&apos; THEN &apos;-01-01&apos;&#10;WHEN &apos;2&apos; THEN &apos;-04-01&apos;&#10;WHEN &apos;3&apos; THEN &apos;-07-01&apos;&#10;WHEN &apos;4&apos; THEN &apos;-10-01&apos;&#10;END&#10;)' />
      </column>
      <column caption='First Month of Quater_1' datatype='string' name='[Calculation_808959091139002369]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF contains([분기 (PCI인식지표)], &quot;Q1&quot;) then &quot;January&quot;&#10;elseif contains([분기 (PCI인식지표)], &quot;Q2&quot;) then &quot;April&quot;&#10;elseif contains([분기 (PCI인식지표)], &quot;Q3&quot;) then &quot;July&quot;&#10;else &quot;October&quot; END' />
      </column>
      <column caption='Data Field_1' datatype='date' name='[Calculation_808959091139248131]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(left([분기 (PCI인식지표)],4)+&#10;CASE RIGHT([분기 (PCI인식지표)],1)&#10;WHEN &apos;1&apos; THEN &apos;-01-01&apos;&#10;WHEN &apos;2&apos; THEN &apos;-04-01&apos;&#10;WHEN &apos;3&apos; THEN &apos;-07-01&apos;&#10;WHEN &apos;4&apos; THEN &apos;-10-01&apos;&#10;END&#10;)' />
