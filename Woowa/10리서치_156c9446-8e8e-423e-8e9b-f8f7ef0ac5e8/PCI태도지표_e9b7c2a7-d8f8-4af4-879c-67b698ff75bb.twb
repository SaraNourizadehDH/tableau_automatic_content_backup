      <column caption='태도지표' datatype='real' name='[Calculation_1094093277338087444]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IFNULL([디자인매력도(복사본)_1094093277312802832],0)+IFNULL([사용편의성(복사본)(복사본)(복사본)(복사본)_1094093277312036879],0)+IFNULL([디자인매력도(복사본)_194851091121549312],0))/&#10;( IF ISNULL([디자인매력도(복사본)_1094093277312802832]) THEN 0 ELSE 1 END +&#10;  IF ISNULL([사용편의성(복사본)(복사본)(복사본)(복사본)_1094093277312036879])THEN 0 ELSE 1 END +&#10;  IF ISNULL([디자인매력도(복사본)_194851091121549312])THEN 0 ELSE 1 END )' />
