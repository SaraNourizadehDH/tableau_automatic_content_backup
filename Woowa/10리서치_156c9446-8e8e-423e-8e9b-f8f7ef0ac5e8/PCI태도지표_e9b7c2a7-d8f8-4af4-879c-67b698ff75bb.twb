      <column caption='PCI점수' datatype='real' name='[Calculation_1094093277362409495]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( [Calculation_1094093277333827603] + [Calculation_1094093277338087444] ) /2' />
