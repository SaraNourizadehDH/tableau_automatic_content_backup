      <column caption='행동지표' datatype='real' name='[Calculation_1094093277333827603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(IFNULL([Calculation_2462202401272942594],0)+IFNULL([메뉴/가게 탐색(복사본)_2462202401273700355],0)+IFNULL([리뷰 탐색(복사본)_2462202401273872388],0)+IFNULL([장바구니 확인/추가(복사본)_2462202401281253381],0)+IFNULL([장바구니 확인/추가(복사본)(2 복사본)_2462202401281294344],0)+IFNULL([장바구니 확인/추가(복사본)(3 복사본)_2462202401281306633],0)+IFNULL([장바구니 확인/추가(복사본)(복사본)_2462202401281261574],0)+IFNULL([장바구니 확인/추가(복사본)(복사본)(복사본)_2462202401281286151],0)+IFNULL([리뷰 작성(복사본)_2462202401281724426],0))/&#10;( IF ISNULL([Calculation_2462202401272942594]) THEN 0 ELSE 1 END +&#10;  IF ISNULL([메뉴/가게 탐색(복사본)_2462202401273700355]) THEN 0 ELSE 1 END +&#10;  IF ISNULL([리뷰 탐색(복사본)_2462202401273872388]) THEN 0 ELSE 1 END +&#10;  IF ISNULL([장바구니 확인/추가(복사본)_2462202401281253381]) THEN 0 ELSE 1 END +&#10;  IF ISNULL([장바구니 확인/추가(복사본)(2 복사본)_2462202401281294344]) THEN 0 ELSE 1 END +&#10;  IF ISNULL([장바구니 확인/추가(복사본)(3 복사본)_2462202401281306633])THEN 0 ELSE 1 END +&#10;  IF ISNULL([장바구니 확인/추가(복사본)(복사본)_2462202401281261574])THEN 0 ELSE 1 END +&#10;  IF ISNULL([장바구니 확인/추가(복사본)(복사본)(복사본)_2462202401281286151])THEN 0 ELSE 1 END +&#10;  IF ISNULL([리뷰 작성(복사본)_2462202401281724426])THEN 0 ELSE 1 END )' />
      </column>
      <column caption='NPS점수' datatype='real' name='[Calculation_1094093277362409495]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*SUM(IF [NPS]  &gt;=9 AND NOT ISNULL([NPS] ) THEN 1 ELSE 0 END) / &#10;COUNTD(IF NOT ISNULL([NPS] ) THEN [PANELNO_분기] ELSE NULL END)&#10;- 100*SUM(IF [NPS] &lt;=6 AND NOT ISNULL([NPS] ) THEN 1 ELSE 0 END) / &#10;COUNTD(IF NOT ISNULL([NPS] ) THEN [PANELNO_분기] ELSE NULL END)' />
      </column>
      <column caption='카운트' datatype='integer' name='[Calculation_1999176074146680840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ INCLUDE [Calculation_5694590673198256132],[평가앱 (주관식)] : COUNT([PANELNO_분기 (주관식)])})' />
      </column>
      <column caption='구성비율' datatype='real' name='[Calculation_1999176074148757514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ INCLUDE [Calculation_5694590673198256132],[평가앱 (주관식)]: COUNTD([PANELNO_분기 (주관식)])}) /SUM({ FIXED [Calculation_5694590673198256132],[평가앱 (주관식)] : COUNTD([PANELNO_분기 (주관식)])})' />
      </column>
      <column caption='First Month of Quarter' datatype='string' name='[Calculation_2462202401271889920]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF contains([분기], &quot;Q1&quot;) then &quot;January&quot;&#10;elseif contains([분기], &quot;Q2&quot;) then &quot;April&quot;&#10;elseif contains([분기], &quot;Q3&quot;) then &quot;July&quot;&#10;else &quot;October&quot; END' />
      </column>
      <column caption='Date Field' datatype='date' name='[Calculation_2462202401272348673]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(left([분기],4)+&#10;CASE RIGHT([분기],1)&#10;WHEN &apos;1&apos; THEN &apos;-01-01&apos;&#10;WHEN &apos;2&apos; THEN &apos;-04-01&apos;&#10;WHEN &apos;3&apos; THEN &apos;-07-01&apos;&#10;WHEN &apos;4&apos; THEN &apos;-10-01&apos;&#10;END&#10;)' />
      </column>
      <column caption='저렴한 가격' datatype='real' name='[Calculation_2462202401272942594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100*SUM(IF [Q13] &gt;=5 AND NOT ISNULL([Q13] ) THEN 1 ELSE 0 END) / &#10;COUNTD(IF NOT ISNULL([Q13] ) THEN [PANELNO_분기] ELSE NULL END)' />
      </column>
      <column caption='총수' datatype='integer' name='[Calculation_316026038116646914]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='TOTAL(COUNTD([PANELNO_분기 (주관식)]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='긍/부정' datatype='string' name='[Calculation_376120984622682113]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE LEFT([Code Cate(복사본)_376120984622612480],3) WHEN &apos;◆긍정&apos; THEN &apos;긍정&apos;&#10;                     WHEN &apos;◆부정&apos; THEN &apos;부정&apos;&#10; END' />
      </column>
      <column caption='NPS추천' datatype='string' name='[Calculation_544442979281043457]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [NPS]&gt;=9 then &quot;추천&quot;&#10;elseif [NPS]&lt;=6 then &quot;비추천&quot;&#10;else &quot;중립&quot; END' />
      </column>
      <column caption='Date ' datatype='date' name='[Calculation_5694590673198256132]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(left([분기 (주관식)],4)+&#10;CASE RIGHT([분기 (주관식)],1)&#10;WHEN &apos;1&apos; THEN &apos;-01-01&apos;&#10;WHEN &apos;2&apos; THEN &apos;-04-01&apos;&#10;WHEN &apos;3&apos; THEN &apos;-07-01&apos;&#10;WHEN &apos;4&apos; THEN &apos;-10-01&apos;&#10;END&#10;)' />
      </column>
      <column caption='부정요약' datatype='string' name='[Code Cate(긍부정)(복사본)_2708563379267035137]' role='dimension' type='nominal'>
