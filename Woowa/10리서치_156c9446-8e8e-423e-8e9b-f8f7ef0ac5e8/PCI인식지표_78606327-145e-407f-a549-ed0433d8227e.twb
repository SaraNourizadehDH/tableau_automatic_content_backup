      <column caption='CodeCate(부정)' datatype='string' name='[CodeCate(복사본)_690035913163153413]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE LEFT([division],3) WHEN &apos;◆긍정&apos; THEN NULL&#10;                        WHEN &apos;◆부정&apos; THEN [division]&#10; END' />
