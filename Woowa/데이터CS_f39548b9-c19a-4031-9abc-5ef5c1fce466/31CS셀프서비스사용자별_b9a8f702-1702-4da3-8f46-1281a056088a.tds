    SELECT  
          CASE 
              WHEN svc_cd IN ('S01010101','S01010102','S0101010301','S0101010302','S0101010303') THEN 'FD' 
              WHEN svc_cd IN ('S01010201','S01010202','S01010203','S01010204','S01010206') THEN 'CM'
              ELSE 'ETC'
          END AS lv1_svc_cd,
          CASE 
              WHEN svc_cd IN ('S01010101','S0101010301','S0101010302','S0101010303') THEN 'FDMP'
              WHEN svc_cd = 'S01010102' THEN 'FDOD'
              WHEN svc_cd = 'S01010201' THEN 'CMBM'
              WHEN svc_cd = 'S01010202' THEN 'CMBS'
              WHEN svc_cd = 'S01010203' THEN 'CMDF'
              WHEN svc_cd = 'S01010204' THEN 'CMBR'
              WHEN svc_cd = 'S01010206' THEN 'CMHM'
              ELSE 'ETC'
          END AS lv2_svc_cd,
          SUM(try_ord_cnt) AS try_ord_cnt,
          base_dt AS part_date
    FROM cl_epm.order_dd_fact
    WHERE CAST(base_dt  AS VARCHAR) >>= CAST(IF(
                                        DATE(DATE_TRUNC('week',  DATE(NOW() + interval '9' hour) - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '24' month)),
                                        DATE(DATE_TRUNC('week',  DATE(NOW() + interval '9' hour) - interval '24' month)),
                                        DATE(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '24' month))) AS VARCHAR)
                    AND CAST(base_dt  AS VARCHAR) << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    GROUP BY 1, 2, base_dt
),
agent_cnt AS (
    SELECT
        part_date,
        cs_cust_div_cd,
        svc_cd,
        SUM(cs_slfsvc_req_cnt) AS inbound_cnt
    FROM temp.cs_slfsvc_ch_stat
    WHERE cs_slfsvc_ch_cd = 'AGENT_INB'
      AND CAST(part_date AS VARCHAR) >>= CAST(IF(
                                        DATE(DATE_TRUNC('week',  DATE(NOW() + interval '9' hour) - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '24' month)),
                                        DATE(DATE_TRUNC('week',  DATE(NOW() + interval '9' hour) - interval '24' month)),
                                        DATE(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '24' month))) AS VARCHAR)
          AND CAST(part_date AS VARCHAR) << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    GROUP BY part_date, cs_cust_div_cd, svc_cd
)

-- 💡 일별
SELECT
      'D' AS base_dt_type,
      stat.cs_cust_div_cd,
      stat.svc_div_nm,
      stat.svc_cd,
      svc.svc_nm,
      COALESCE(ord.try_ord_cnt, 0) AS try_ord_cnt,
      SUM(stat.cs_slfsvc_req_cnt) AS cs_slfsvc_req_cnt,
      SUM(stat.cs_slfsvc_proc_cnt) AS cs_slfsvc_proc_cnt,
      COALESCE(agent_cnt.inbound_cnt, 0) AS inbound_cnt,
      DATE_TRUNC('day', DATE(stat.part_date)) AS part_date,
      count(distinct stat.part_date) as date_cnt
FROM cl_bis.cs_slfsvc_ch_stat stat
LEFT JOIN agent_cnt
    ON agent_cnt.part_date = stat.part_date
   AND agent_cnt.cs_cust_div_cd = stat.cs_cust_div_cd
   AND agent_cnt.svc_cd = stat.svc_cd
LEFT JOIN cl_common.svc_cd_master svc
    ON svc.svc_cd = stat.svc_cd
LEFT JOIN ord_cnt ord
    ON ord.lv2_svc_cd = stat.svc_cd
   AND ord.part_date = stat.part_date
WHERE CAST(stat.part_date  AS VARCHAR) >>= CAST(IF(
                                        DATE(DATE_TRUNC('week',  DATE(NOW() + interval '9' hour) - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '24' month)),
                                        DATE(DATE_TRUNC('week',  DATE(NOW() + interval '9' hour) - interval '24' month)),
                                        DATE(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '24' month))) AS VARCHAR)
      AND CAST(stat.part_date  AS VARCHAR) << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
  AND stat.cs_slfsvc_ch_cd <<>> 'AGENT_INB'
GROUP BY 1, 2, 3, 4, 5, 10, 6, 9

UNION ALL

-- 💡 주별
SELECT
      'W' AS base_dt_type,
      stat.cs_cust_div_cd,
      stat.svc_div_nm,
      stat.svc_cd,
      svc.svc_nm,
      COALESCE(ord.try_ord_cnt, 0) AS try_ord_cnt,
      SUM(stat.cs_slfsvc_req_cnt) AS cs_slfsvc_req_cnt,
      SUM(stat.cs_slfsvc_proc_cnt) AS cs_slfsvc_proc_cnt,
      COALESCE(agent_cnt.inbound_cnt, 0) AS inbound_cnt,
      DATE_TRUNC('week', DATE(stat.part_date)) AS part_date,
      count(distinct stat.part_date) as date_cnt
FROM cl_bis.cs_slfsvc_ch_stat stat
LEFT JOIN agent_cnt
    ON agent_cnt.part_date = stat.part_date
   AND agent_cnt.cs_cust_div_cd = stat.cs_cust_div_cd
   AND agent_cnt.svc_cd = stat.svc_cd
LEFT JOIN cl_common.svc_cd_master svc
    ON svc.svc_cd = stat.svc_cd
LEFT JOIN ord_cnt ord
    ON ord.lv2_svc_cd = stat.svc_cd
   AND ord.part_date = stat.part_date
WHERE CAST(stat.part_date  AS VARCHAR) >>= CAST(IF(
                                        DATE(DATE_TRUNC('week',  DATE(NOW() + interval '9' hour) - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '24' month)),
                                        DATE(DATE_TRUNC('week',  DATE(NOW() + interval '9' hour) - interval '24' month)),
                                        DATE(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '24' month))) AS VARCHAR)
      AND CAST(stat.part_date  AS VARCHAR) << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
  AND stat.cs_slfsvc_ch_cd <<>> 'AGENT_INB'
GROUP BY 1, 2, 3, 4, 5, 10, 6, 9

UNION ALL

-- 💡 월별
SELECT
      'M' AS base_dt_type,
      stat.cs_cust_div_cd,
      stat.svc_div_nm,
      stat.svc_cd,
      svc.svc_nm,
      COALESCE(ord.try_ord_cnt, 0) AS try_ord_cnt,
      SUM(stat.cs_slfsvc_req_cnt) AS cs_slfsvc_req_cnt,
      SUM(stat.cs_slfsvc_proc_cnt) AS cs_slfsvc_proc_cnt,
      COALESCE(agent_cnt.inbound_cnt, 0) AS inbound_cnt,
      DATE_TRUNC('month', DATE(stat.part_date)) AS part_date,
      count(distinct stat.part_date) as date_cnt
FROM cl_bis.cs_slfsvc_ch_stat stat
LEFT JOIN agent_cnt
    ON agent_cnt.part_date = stat.part_date
   AND agent_cnt.cs_cust_div_cd = stat.cs_cust_div_cd
   AND agent_cnt.svc_cd = stat.svc_cd
LEFT JOIN cl_common.svc_cd_master svc
    ON svc.svc_cd = stat.svc_cd
LEFT JOIN ord_cnt ord
    ON ord.lv2_svc_cd = stat.svc_cd
   AND ord.part_date = stat.part_date
WHERE CAST(stat.part_date  AS VARCHAR) >>= CAST(IF(
                                        DATE(DATE_TRUNC('week',  DATE(NOW() + interval '9' hour) - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '24' month)),
                                        DATE(DATE_TRUNC('week',  DATE(NOW() + interval '9' hour) - interval '24' month)),
                                        DATE(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '24' month))) AS VARCHAR)
      AND CAST(stat.part_date  AS VARCHAR) << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
  AND stat.cs_slfsvc_ch_cd <<>> 'AGENT_INB'
GROUP BY 1, 2, 3, 4, 5, 10, 6, 9

ORDER BY part_date, svc_cd]]></relation>
        </properties>
        <properties context='extract'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </properties>
      </object>
    </objects>
  </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
</datasource>
