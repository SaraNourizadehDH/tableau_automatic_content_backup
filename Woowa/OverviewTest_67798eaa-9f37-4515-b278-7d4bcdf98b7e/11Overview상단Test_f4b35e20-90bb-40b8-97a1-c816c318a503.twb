              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN STR(MID(STR([Parameters].[매개 변수 2]),6,2)) + &quot;/&quot; + &#13;&#10;STR(MID(STR([Parameters].[매개 변수 2]),9,2)) + [C_주차(복사본)_2647835107879677976]&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN STR(MONTH(DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])))&#13;&#10;+ &apos;월 W&apos; +&#13;&#10;STR(&#13;&#10;WEEK(DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2]))&#13;&#10;-&#13;&#10;ISOWEEK(DATETRUNC(&apos;month&apos;, DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])))&#13;&#10;)&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN STR(MONTH([Parameters].[매개 변수 2])) + &apos;월&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='C_요일' datatype='string' name='[C_주차(복사본)_2647835107879677976]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE DATEPART(&apos;iso-weekday&apos;, [Parameters].[매개 변수 2])&#13;&#10;WHEN 1 THEN &apos;(월)&apos;&#13;&#10;WHEN 2 THEN &apos;(화)&apos;&#13;&#10;WHEN 3 THEN &apos;(수)&apos;&#13;&#10;WHEN 4 THEN &apos;(목)&apos;&#13;&#10;WHEN 5 THEN &apos;(금)&apos;&#13;&#10;WHEN 6 THEN &apos;(토)&apos;&#13;&#10;WHEN 7 THEN &apos;(일)&apos;&#13;&#10;END' />
            </column>
