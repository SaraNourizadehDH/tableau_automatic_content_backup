            <column alias='Show Last 6 Months' caption='Report Month' datatype='integer' name='[매개 변수 1]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='Show Last 6 Months' />
                <alias key='2' value='Show All' />
              </aliases>
            </column>
