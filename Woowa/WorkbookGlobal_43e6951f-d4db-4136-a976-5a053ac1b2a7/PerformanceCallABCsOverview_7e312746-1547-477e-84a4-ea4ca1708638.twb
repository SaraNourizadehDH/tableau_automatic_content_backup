            </column>
            <column caption='F_Report_Month' datatype='boolean' name='[Calculation_2549318898530152450]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN 1 THEN [Calculation_2549318898529034241]&gt;=DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) &#13;&#10;or [Calculation_2549318898529034241]=DATEADD(&apos;month&apos;,-13,DATETRUNC(&apos;month&apos;,TODAY()))&#13;&#10;WHEN 2 THEN [Calculation_2549318898529034241]&gt;=DATEADD(&apos;month&apos;,-13,DATETRUNC(&apos;month&apos;,TODAY()))&#13;&#10;END' />
            </column>
            <column caption='Order Share: QC' datatype='real' name='[Calculation_2549318898533810225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[cm_ord_cnt_rate]' />
            </column>
            <column caption='Order Share: Dmarts' datatype='real' name='[Calculation_2549318898533851186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[bmr_ord_cnt_rate]' />
            </column>
            <column caption='Online Vendors Dmarts' datatype='integer' name='[Calculation_2549318898533888051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[ad_active_bmr_seller_cnt]' />
            </column>
            <column caption='ABV Dmarts' datatype='real' name='[Calculation_2549318898533933108]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bmr_apv])/SUM([sqlproxy.19vq7qx01i3a3b1dqc88q0fblq4e].[eur_krw_fx_rate])' />
