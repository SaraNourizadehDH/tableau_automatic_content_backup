            <column caption='F_Report_Month' datatype='boolean' name='[Calculation_2549318898530152450]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN 1 THEN [Calculation_2549318898529034241]&gt;=DATEADD(&apos;month&apos;,-6,DATETRUNC(&apos;month&apos;,TODAY())) &#13;&#10;or [Calculation_2549318898529034241]=DATEADD(&apos;month&apos;,-13,DATETRUNC(&apos;month&apos;,TODAY()))&#13;&#10;WHEN 2 THEN [Calculation_2549318898529034241]&gt;=DATEADD(&apos;month&apos;,-13,DATETRUNC(&apos;month&apos;,TODAY()))&#13;&#10;END' />
            </column>
