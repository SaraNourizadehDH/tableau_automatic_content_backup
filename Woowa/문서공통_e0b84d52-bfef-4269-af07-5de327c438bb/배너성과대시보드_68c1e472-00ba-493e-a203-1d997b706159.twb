          <datasource-dependencies datasource='Parameters'>
            <column caption='조회기간 구분' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;일별&quot;'>
              <calculation class='tableau' formula='&quot;일별&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0sbkbei1w5n9fs14hcdao0pg2irh'>
            <column caption='std_dt' datatype='datetime' name='[Calculation_2643050074335297537]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos; THEN DATE([log_dt])&#13;&#10; ELSEIF [Parameters].[매개 변수 1] = &apos;주별&apos; THEN DATETRUNC(&apos;week&apos;, DATE([log_dt]), &apos;monday&apos;)&#13;&#10; ELSEIF [Parameters].[매개 변수 1] = &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;, DATE([log_dt]))&#13;&#10;END' />
            </column>
            <column caption='배너명' datatype='string' name='[Calculation_2643050074335424515]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[creative_id] + &apos; / &apos; + [admin_name]' />
            </column>
            <column caption='노출 수' datatype='integer' name='[Calculation_2643050074335662085]' role='measure' type='quantitative'>
