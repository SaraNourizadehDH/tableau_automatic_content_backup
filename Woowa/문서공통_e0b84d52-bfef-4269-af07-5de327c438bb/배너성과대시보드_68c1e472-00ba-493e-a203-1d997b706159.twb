            <column caption='클릭 수' datatype='integer' name='[Calculation_2643050074335895561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [banner_event] = &apos;clk&apos; THEN [log_cnt] ELSE 0 END)' />
            </column>
            <column caption='클릭 회원 수' datatype='integer' name='[Calculation_2643050074335981579]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [banner_event] = &apos;clk&apos; THEN [mem_cnt] ELSE 0 END)' />
            </column>
