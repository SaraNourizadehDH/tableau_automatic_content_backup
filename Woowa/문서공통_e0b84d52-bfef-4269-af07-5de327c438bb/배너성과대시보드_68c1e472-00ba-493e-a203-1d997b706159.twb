      <column caption='std_dt' datatype='datetime' name='[Calculation_2643050074339385361]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos; THEN DATE([log_dt])&#13;&#10; ELSEIF [Parameters].[매개 변수 1] = &apos;주별&apos; THEN DATETRUNC(&apos;week&apos;, DATE([log_dt]), &apos;monday&apos;)&#13;&#10; ELSEIF [Parameters].[매개 변수 1] = &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;, DATE([log_dt]))&#13;&#10;END' />
      </column>
      <column caption='주요 서비스' datatype='string' name='[Calculation_2643050074339495954]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [service] IN (&apos;배민&apos;, &apos;배민1&apos;, &apos;B마트&apos;, &apos;배민스토어&apos;, &apos;선물하기&apos;, &apos;제휴&apos;, &apos;포장&apos;, &apos;푸드&apos;, &apos;전국별미&apos;) THEN [service]&#13;&#10; ELSEIF [service] IN (&apos;쇼핑라이브&apos;, &apos;배쇼라&apos;) THEN &apos;쇼핑라이브&apos;&#13;&#10; ELSE &apos;기타&apos; END' />
      </column>
      <column caption='노출 수' datatype='integer' name='[Calculation_2643050074339672084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [banner_event] = &apos;imp&apos; THEN [log_cnt] ELSE 0 END)' />
      </column>
      <column caption='노출 회원 수' datatype='integer' name='[Calculation_2643050074339762198]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [banner_event] = &apos;imp&apos; THEN [mem_cnt] ELSE 0 END)' />
      </column>
      <column caption='클릭 수' datatype='integer' name='[Calculation_2643050074339831832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [banner_event] = &apos;clk&apos; THEN [log_cnt] ELSE 0 END)' />
      </column>
      <column caption='클릭 회원 수' datatype='integer' name='[Calculation_2643050074339897370]' role='measure' type='quantitative'>
