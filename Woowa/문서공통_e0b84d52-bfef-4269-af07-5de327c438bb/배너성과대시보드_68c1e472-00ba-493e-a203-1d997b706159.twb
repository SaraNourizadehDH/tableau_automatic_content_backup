      <datasource-dependencies datasource='sqlproxy.0sbkbei1w5n9fs14hcdao0pg2irh'>
        <column caption='std_dt' datatype='datetime' name='[Calculation_2643050074335297537]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos; THEN DATE([log_dt])&#13;&#10; ELSEIF [Parameters].[매개 변수 1] = &apos;주별&apos; THEN DATETRUNC(&apos;week&apos;, DATE([log_dt]), &apos;monday&apos;)&#13;&#10; ELSEIF [Parameters].[매개 변수 1] = &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;, DATE([log_dt]))&#13;&#10;END' />
        </column>
