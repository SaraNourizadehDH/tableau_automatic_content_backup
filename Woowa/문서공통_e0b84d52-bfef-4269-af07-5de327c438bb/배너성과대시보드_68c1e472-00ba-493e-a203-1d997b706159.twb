      <datasource-dependencies datasource='Parameters'>
        <column caption='조회기간 구분' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;일별&quot;'>
          <calculation class='tableau' formula='&quot;일별&quot;' />
          <members>
            <member value='&quot;일별&quot;' />
            <member value='&quot;주별&quot;' />
            <member value='&quot;월별&quot;' />
