            </column>
            <column caption='c_조직' datatype='string' name='[Calculation_884183320036839425]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [조직 (그룹)]&#10;WHEN &apos;전체&apos; THEN &apos;전체&apos;&#10;WHEN &apos;결제정산프로덕트실&apos; THEN &apos;결제정산프로덕트실&apos;&#10;WHEN &apos;기술경영실&apos; THEN &apos;기술경영실&apos;&#10;WHEN &apos;데이터서비스실&apos; THEN &apos;데이터서비스실&apos;&#10;WHEN &apos;딜리버리플랫폼실&apos; THEN &apos;딜리버리플랫폼실&apos;&#10;WHEN &apos;외식업솔루션센터&apos; THEN &apos;외식업솔루션센터&apos;&#10;WHEN &apos;만화경셀&apos; THEN &apos;만화경셀&apos;&#10;WHEN &apos;채널연계플랫폼실&apos; THEN &apos;채널연계플랫폼실&apos;&#10;WHEN &apos;물류플랫폼실&apos; THEN &apos;물류플랫폼실&apos;&#10;WHEN &apos;배민상회서비스실&apos; THEN &apos;배민상회서비스실&apos;&#10;WHEN &apos;배민커머스서비스실&apos; THEN &apos;배민커머스서비스실&apos;&#10;WHEN &apos;배민푸드서비스실&apos; THEN &apos;배민푸드서비스실&apos;&#10;WHEN &apos;셀러서비스실&apos; THEN &apos;셀러서비스실&apos;&#10;WHEN &apos;코어프로덕트실&apos; THEN &apos;코어프로덕트실&apos;&#10;WHEN &apos;기타&apos; THEN &apos;기타&apos;&#10;END' />
            </column>
            <column-instance column='[가중평균(복사본)_2584784743722700801]' derivation='Min' name='[min:가중평균(복사본)_2584784743722700801:qk]' pivot='key' type='quantitative' />
