            <column caption='가중평균-목표' datatype='real' name='[Calculation_1516727947180908545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[가중치 커버리지_FIXED(복사본)(복사본)_1238982513749778433]-MIN([가중평균(복사본)_2584784743722700801])' />
