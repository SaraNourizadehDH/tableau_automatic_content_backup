            <column caption='과제_커버리지_가중치' datatype='real' name='[가중치 커버리지_FIXED(복사본)(복사본)_1238982513749778433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL(SUM([수행과제])/SUM([인입과제])) = FALSE THEN (SUM([가중치 커버리지_FIXED(복사본)_1238982513749413888]*[가중치(복사본)_1452622021223542792])/SUM([가중치(복사본)_1452622021223542792])) END' />
