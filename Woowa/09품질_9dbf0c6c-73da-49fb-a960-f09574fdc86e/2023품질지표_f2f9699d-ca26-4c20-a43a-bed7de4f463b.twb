        <calculation class='tableau' formula='CASE [조직 (그룹)]&#13;&#10;WHEN &apos;배민푸드서비스실&apos; THEN 0.16&#13;&#10;WHEN &apos;코어프로덕트실&apos; THEN 0.16&#13;&#10;WHEN &apos;배민커머스서비스실&apos; THEN 0.16&#13;&#10;WHEN &apos;결제정산프로덕트실&apos; THEN 0.11&#13;&#10;WHEN &apos;딜리버리플랫폼실&apos; THEN 0.11&#13;&#10;WHEN &apos;셀러서비스실&apos; THEN 0.09&#13;&#10;WHEN &apos;채널연계플랫폼실&apos; THEN 0.08&#13;&#10;WHEN &apos;물류플랫폼실&apos; THEN 0.05&#13;&#10;WHEN &apos;배민상회서비스실&apos; THEN 0.04&#13;&#10;WHEN &apos;데이터서비스실&apos; THEN 0.03&#13;&#10;WHEN &apos;만화경셀&apos; THEN 0.02&#13;&#10;END' />
