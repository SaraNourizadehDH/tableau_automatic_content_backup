              <calculation class='tableau' formula='{FIXED [조직 (그룹)],[연],[월]: IF ISNULL(SUM([수행과제])/SUM([인입과제])) = FALSE THEN (SUM([수행과제])/SUM([인입과제])) ELSE NULL END}' />
            </column>
            <column aggregation='Sum' caption='가중치_수정' datatype='real' name='[가중치(복사본)_1452622021223542792]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [조직 (그룹)],[연],[월]: MAX(&#10;IF ([수행과제])=0 OR ([인입과제]) = 0 THEN 0 &#10;ELSEIF [조직 (그룹)] = &apos;배민푸드서비스실&apos; THEN 0.16&#10;ELSEIF [조직 (그룹)] = &apos;코어프로덕트실&apos; THEN 0.16&#10;ELSEIF [조직 (그룹)] = &apos;배민커머스서비스실&apos; THEN 0.16&#10;ELSEIF [조직 (그룹)] = &apos;결제정산프로덕트실&apos; THEN 0.11&#10;ELSEIF [조직 (그룹)] = &apos;딜리버리플랫폼실&apos; THEN 0.11&#10;ELSEIF [조직 (그룹)] = &apos;셀러서비스실&apos; THEN 0.09&#10;ELSEIF [조직 (그룹)] = &apos;채널연계플랫폼실&apos; THEN 0.08&#10;ELSEIF [조직 (그룹)] = &apos;물류플랫폼실&apos; THEN 0.05&#10;ELSEIF [조직 (그룹)] = &apos;배민상회서비스실&apos; THEN 0.04&#10;ELSEIF [조직 (그룹)] = &apos;데이터서비스실&apos; THEN 0.03&#10;ELSEIF [조직 (그룹)] = &apos;만화경셀&apos; THEN 0.02&#10;END) &#10;}' />
