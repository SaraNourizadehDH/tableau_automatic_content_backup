  <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
  <semantic-values>
    <semantic-value key='[Country].[Name]' value='&quot;대한민국&quot;' />
  </semantic-values>
  <default-sorts>
    <manual-sort column='[none:value_div_nm:nk]' direction='ASC'>
      <dictionary>
        <bucket>&quot;그로스&quot;</bucket>
        <bucket>&quot;푸드&quot;</bucket>
        <bucket>&quot;배달커머스&quot;</bucket>
      </dictionary>
    </manual-sort>
  </default-sorts>
  <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    <objects>
      <object caption='사용자 지정 SQL 쿼리' id='_724E081D61B1481BA5B8B685EA0556AF'>
        <properties context=''>
          <relation connection='athena.160zjll0cvmltw145msq80jgbdar(복사본)' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[WITH 
  integ_kpi
    AS (
    SELECT value_id
         , value
         , base_dur_cd
         , part_date
    FROM   vl_ceorpt.plf_kpi_aggr
    WHERE part_date >>= CAST(DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') - interval '2' year AS VARCHAR)
    AND   part_date <<= CAST(DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') AS VARCHAR)
    UNION ALL
    SELECT value_id
         , value
         , base_dur_cd
         , part_date
    FROM  vl_ceorpt.food_kpi_aggr
    WHERE part_date >>= CAST(DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') - interval '2' year AS VARCHAR)
    AND   part_date <<= CAST(DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') AS VARCHAR)
    UNION ALL
    SELECT value_id
         , value
         , base_dur_cd
         , part_date
    FROM  vl_ceorpt.commerce_kpi_aggr
    WHERE part_date >>= CAST(DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') - interval '2' year AS VARCHAR)
    AND   part_date <<= CAST(DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') AS VARCHAR)

    UNION ALL
    SELECT value_id
         , CAST(IF(value NOT LIKE '0.%' , NULL, value) AS DOUBLE) value
         , base_dur_cd
         , part_date
    FROM   gsheet.competitive_response_fact_daily
    WHERE part_date >>= CAST(DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') - interval '2' year AS VARCHAR)
    AND   part_date <<= CAST(DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') AS VARCHAR)

    UNION ALL
    SELECT value_id
         , CAST(IF(value NOT LIKE '0.%' , NULL, value) AS DOUBLE) value
         , base_dur_cd
         , part_date
    FROM   gsheet.competitive_response_fact_weekly
    WHERE part_date >>= CAST(DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') - interval '2' year AS VARCHAR)
    AND   part_date <<= CAST(DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') AS VARCHAR)
    
    UNION ALL
    SELECT value_id
         , CAST(IF(value NOT LIKE '0.%' , NULL, value) AS DOUBLE) value
         , base_dur_cd
         , part_date
    FROM   gsheet.competitive_response_fact_monthly
    WHERE part_date >>= CAST(DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') - interval '2' year AS VARCHAR)
    AND   part_date <<= CAST(DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') AS VARCHAR)    
    
  ),


-- 일별
  daily 
    AS (
    SELECT t1.part_date
         , t1.base_dur_cd
         , t1.value_id
         , t1.value
         , t2.value AS comp1_value -- vs.전일
         , t3.value AS comp2_value -- vs.전주동요일
    FROM   integ_kpi t1
           LEFT JOIN integ_kpi t2
           ON t1.base_dur_cd = 'D'
           AND t2.base_dur_cd = 'D'
           AND CAST(DATE_ADD('day', -1, DATE(t1.part_date)) AS VARCHAR) = t2.part_date
           AND t1.value_id = t2.value_id
           LEFT JOIN integ_kpi t3
           ON t1.base_dur_cd = 'D'
           AND t3.base_dur_cd = 'D'
           AND CAST(DATE_ADD('day', -7, DATE(t1.part_date)) AS VARCHAR) = t3.part_date
           AND t1.value_id = t3.value_id
    WHERE t1.base_dur_cd = 'D'
    ),
    
  weekly 
    AS (
    SELECT t1.part_date
         , t1.base_dur_cd
         , t1.value_id
         , t1.value
         , t2.value AS comp1_value -- vs.전주
         , NULL     AS comp2_value -- 사용X
    FROM   integ_kpi t1
           LEFT JOIN integ_kpi t2
           ON t1.base_dur_cd = 'W'
           AND t2.base_dur_cd = 'W'
           AND CAST(DATE_ADD('week', -1, DATE(t1.part_date)) AS VARCHAR) = t2.part_date
           AND t1.value_id = t2.value_id
    WHERE t1.base_dur_cd = 'W'
    ),
    
  monthly
    AS (
    SELECT t1.part_date
         , t1.base_dur_cd
         , t1.value_id
         , t1.value
         , t2.value AS comp1_value -- vs.전월
         , t3.value AS comp2_value -- vs.전년 동월
    FROM   integ_kpi t1
           LEFT JOIN integ_kpi t2
           ON t1.base_dur_cd = 'M'
           AND t2.base_dur_cd = 'M'
           AND CAST(DATE_ADD('month', -1, DATE(t1.part_date)) AS VARCHAR) = t2.part_date
           AND t1.value_id = t2.value_id
           LEFT JOIN integ_kpi t3
           ON t1.base_dur_cd = 'M'
           AND t3.base_dur_cd = 'M'
           AND CAST(DATE_ADD('year', -1, DATE(t1.part_date)) AS VARCHAR) = t3.part_date
           AND t1.value_id = t3.value_id
    WHERE t1.base_dur_cd = 'M'
    )


SELECT t1.*
     , t2.part_date
     , t2.base_dur_cd
     , t2.value
     , t2.comp1_value
     , t2.comp2_value
     , CASE WHEN t1.display_unit = '%' THEN ROUND(t2.value * 100, 2)
            WHEN t2.value % 1 = 0 THEN CAST(t2.value AS BIGINT) -- 정수
            ELSE ROUND(t2.value, 1) -- 소수
       END AS adjusted_value         
FROM   gsheet.kpi_viz_info t1
       LEFT JOIN (
                  SELECT * FROM daily
                  UNION ALL
                  SELECT * FROM weekly
                  UNION ALL
                  SELECT * FROM monthly
                 ) t2
       ON t1.value_id = t2.value_id]]></relation>
        </properties>
        <properties context='extract'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </properties>
      </object>
    </objects>
  </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
</datasource>
