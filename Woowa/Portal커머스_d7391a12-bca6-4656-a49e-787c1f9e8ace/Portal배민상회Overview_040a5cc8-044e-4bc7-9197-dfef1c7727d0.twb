      <column caption='C_color' datatype='string' name='[Calculation_696932078033563655]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM( {FIXED [subject], [base_dt]: SUM([value])} ) &gt; [Calculation_696932078033444870]  then &apos;R&apos; else &apos;NON&apos; end' />
