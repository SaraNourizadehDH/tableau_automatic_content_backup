      <column caption='C_날짜_일별_경고문구 (&gt;30)' datatype='string' name='[Calculation_1020909778353016832]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[매개 변수 3], [Parameters].[매개 변수 2]) &gt;= 30&#13;&#10;    THEN &apos;※ 최대 30일까지 조회 가능합니다.&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='C_기준일' datatype='date' name='[Calculation_1034139099733237760]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY()-1' />
