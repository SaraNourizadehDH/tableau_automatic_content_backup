      <column caption='C_증감color_전년' datatype='string' name='[C_증감color(복사본)_2494994229530763279]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MIN([subject]) = &apos;쿠폰사용금액&apos;&#13;&#10;THEN (IF [C_전주대비값(복사본)_2494994229530677262] &lt; 0 THEN &apos;B&apos; ELSE &apos;R&apos; END)&#13;&#10;&#13;&#10;ELSE (IF [C_전주대비값(복사본)_2494994229530677262] &lt; 0 THEN &apos;R&apos; ELSE &apos;B&apos; END)&#13;&#10;&#13;&#10;END' />
