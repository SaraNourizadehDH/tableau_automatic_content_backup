        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[매개 변수 3], [Parameters].[매개 변수 2]) &lt; 8&#13;&#10;    THEN TRUE&#13;&#10;    ELSE FALSE&#13;&#10;    END&#13;&#10;ELSE TRUE&#13;&#10;END' />
