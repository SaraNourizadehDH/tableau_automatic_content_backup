      <column caption='C_max_date_value' datatype='real' name='[Calculation_696932078033444870]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({fixed [subject]: SUM(IF [base_dt] = [Calculation_696932078033358853] then [value] END)})' />
