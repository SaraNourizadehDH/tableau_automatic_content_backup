          <datasource-dependencies datasource='sqlproxy.0exkgwn0v93x121b127k11m8tftc'>
            <column caption='C_DATE' datatype='date' name='[Calculation_1798625111156187141]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([last_date])' />
            </column>
            <column caption='FC명' datatype='string' name='[Calculation_1798625111734673423]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Parameters].[매개 변수 1 3] = 1,[center_nm],&apos;전체FC&apos;)' />
            </column>
            <column caption='GPV' datatype='integer' name='[Calculation_1798625111740342288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sale_amt])' />
            </column>
            <column caption='Gross상품매출' datatype='integer' name='[Calculation_1798625111740780561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vat_excld_sale_amt])' />
            </column>
            <column caption='당월 평균 매입단가' datatype='integer' name='[Calculation_2120069540178292741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX( IIF([vat_excld_curmm_accum_prchs_uprice]=0, [vat_excld_prev_mm_avg_prchs_uprice], [vat_excld_curmm_accum_prchs_uprice]))' />
            </column>
            <column caption='폐기원가' datatype='integer' name='[Calculation_2120069540178403334]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[dscd_cprice]' />
            </column>
            <column caption='총 상품마진' datatype='integer' name='[Calculation_2120069540179537928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1798625111740780561]-SUM([Calculation_2120069540181856266])' />
            </column>
            <column caption='상품매출원가' datatype='integer' name='[Calculation_2120069540181856266]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[product_prchs_cprice]' />
            </column>
            <column caption='F_월별' datatype='boolean' name='[Calculation_2120069540238270475]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[매개 변수 3 1] = &apos;월별&apos;' />
            </column>
            <column caption='INDEX()' datatype='integer' name='[Calculation_2120069540248330253]' role='measure' type='quantitative' user:unnamed='3_다운로드용시트 월별'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='F_Date_Type' datatype='boolean' name='[Calculation_2364108342577373186]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3 1]&#13;&#10;WHEN &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2]) &lt;= [Calculation_1798625111156187141] and [Calculation_1798625111156187141] &lt; DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2]))&#13;&#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;iso-week&apos;,[Parameters].[매개 변수 2]) &lt;= [Calculation_1798625111156187141] and [Calculation_1798625111156187141] &lt; DATEADD(&apos;week&apos;,1,DATETRUNC(&apos;iso-week&apos;,[Parameters].[매개 변수 2]))&#13;&#10;//WHEN &apos;일별&apos; THEN [P_Start_Date]&lt;=[C_DATE] and [C_DATE] &lt;= [P_End_Date 1] AND (DATEADD(&apos;day&apos;, -30, [P_End_Date 1]) &lt;= [C_DATE])&#13;&#10;END' />
            </column>
            <column caption='LV1' datatype='string' name='[Calculation_2364108342616854547]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[cat1_nm]' />
            </column>
            <column caption='LV3' datatype='string' name='[Calculation_2364108342617096213]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[cat3_nm]' />
            </column>
            <column caption='LV4' datatype='string' name='[Calculation_2364108342617128982]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[cat4_nm]' />
            </column>
            <column caption='SKU code' datatype='string' name='[Calculation_2364108342617411607]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[product_cd]' />
            </column>
            <column caption='SKU명' datatype='string' name='[Calculation_2364108342617497624]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[product_nm]' />
            </column>
            <column caption='월' datatype='string' name='[Calculation_2595199298031775746]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(MONTH([Calculation_1798625111156187141]))+&apos;월&apos;' />
            </column>
            <column caption='과세여부' datatype='string' name='[Calculation_2595199298033545220]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [is_taxable]&#13;&#10;WHEN 0 THEN &apos;비과세&apos;&#13;&#10;WHEN 1 THEN &apos;과세&apos;&#13;&#10;END' />
            </column>
            <column caption='판매수량' datatype='integer' name='[Calculation_2595199298035892229]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[sale_product_cnt]' />
            </column>
            <column caption='판매가(VAT제외)' datatype='real' name='[Calculation_2595199298036080647]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([vat_excld_sale_amt])/SUM([sale_product_cnt])' />
            </column>
            <column caption='전월 평균 매입단가' datatype='integer' name='[Calculation_2595199298037608456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX([vat_excld_prev_mm_avg_prchs_uprice])' />
            </column>
            <column caption='정렬필드 상품마진' datatype='integer' name='[Calculation_2849371207330811909]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 4]&#13;&#10;WHEN 1 THEN MIN(1)&#13;&#10;WHEN 2 THEN RANK_UNIQUE(SUM(IFNULL([Calculation_2595199298035892229],0))*[Calculation_2849371207331090438],&apos;desc&apos;)&#13;&#10;WHEN 3 THEN RANK_UNIQUE(IFNULL([판매가(VAT제외)(복사본)_2120069540177870852],0)*[Calculation_2849371207331090438],&apos;desc&apos;)&#13;&#10;WHEN 4 THEN RANK_UNIQUE(IFNULL([Calculation_2595199298036080647],0)*[Calculation_2849371207331090438],&apos;desc&apos;)&#13;&#10;WHEN 5 THEN RANK_UNIQUE(IFNULL([Calculation_1798625111740342288],0)*[Calculation_2849371207331090438],&apos;desc&apos;)&#13;&#10;WHEN 6 THEN RANK_UNIQUE(IFNULL([Calculation_1798625111740780561],0)*[Calculation_2849371207331090438],&apos;desc&apos;)&#13;&#10;WHEN 7 THEN RANK_UNIQUE(IFNULL([Calculation_2595199298037608456],0)*[Calculation_2849371207331090438],&apos;desc&apos;)&#13;&#10;WHEN 8 THEN RANK_UNIQUE(IFNULL([Calculation_2120069540178292741],0)*[Calculation_2849371207331090438],&apos;desc&apos;)&#13;&#10;WHEN 9 THEN RANK_UNIQUE(IFNULL([당월 상품마진(복사본)_1509550315996758016],0)*[Calculation_2849371207331090438],&apos;desc&apos;)&#13;&#10;WHEN 10 THEN RANK_UNIQUE(SUM(IFNULL([Calculation_2120069540181856266],0))*[Calculation_2849371207331090438],&apos;desc&apos;)&#13;&#10;WHEN 11 THEN RANK_UNIQUE(SUM(IFNULL([Calculation_2120069540178403334],0))*[Calculation_2849371207331090438],&apos;desc&apos;)&#13;&#10;WHEN 12 THEN RANK_UNIQUE(IFNULL([Calculation_2120069540179537928],0)*[Calculation_2849371207331090438],&apos;desc&apos;)&#13;&#10;WHEN 13 THEN RANK_UNIQUE(IFNULL([상품마진(복사본)_2120069540179685385],0)*[Calculation_2849371207331090438],&apos;desc&apos;)&#13;&#10;WHEN 14 THEN RANK_UNIQUE(IFNULL([총 상품마진(복사본)_1509550315997065218],0)*[Calculation_2849371207331090438],&apos;desc&apos;)&#13;&#10;WHEN 15 THEN RANK_UNIQUE(IFNULL([총 상품마진율(복사본)_802203699495559170],0)*[Calculation_2849371207331090438],&apos;desc&apos;)&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='C_asc/desc' datatype='integer' name='[Calculation_2849371207331090438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 5]&#13;&#10;WHEN 0 THEN -1 //asc&#13;&#10;WHEN 1 THEN 1 //desc&#13;&#10;END' />
            </column>
