            <column-instance column='[svc_cd]' derivation='None' name='[none:svc_cd:nk]' pivot='key' type='nominal' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[svc_cd]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
