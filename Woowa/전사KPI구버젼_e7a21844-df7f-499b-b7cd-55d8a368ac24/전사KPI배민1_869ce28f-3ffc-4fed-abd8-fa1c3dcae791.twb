              <calculation class='tableau' formula='((SUM([Calculation_531354426937544745])/[Calculation_183099506398511154])/(SUM([(GMV)현재 구간 값(복사본)_531354426937806890])/[계산1(복사본)_183099506400100408])) - 1' />
