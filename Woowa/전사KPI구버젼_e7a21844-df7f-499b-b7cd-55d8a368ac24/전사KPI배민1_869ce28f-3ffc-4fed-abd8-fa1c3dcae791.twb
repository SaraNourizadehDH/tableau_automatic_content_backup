      <column caption='(평균배달시간)이전 구간대비 현재 증감' datatype='real' name='[Calculation_217157981073817616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_217157981059710978]-[(평균배달시간)현재 구간 값(복사본)_217157981072125964]' />
      </column>
      <column caption='(평균배달시간)이전 구간대비 현재 증감-' datatype='real' name='[Calculation_217157981073977361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF( sum([Calculation_217157981073817616]) &lt; 0, sum([Calculation_217157981073817616]) , NULL)' />
      </column>
      <column caption='조회 기간 제한' datatype='boolean' name='[Calculation_217157981077897234]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#10;WHEN &apos;주별&apos; THEN [std_cd] = &apos;W&apos;&#10;            AND DATE([std_dt]) &gt;= DATEADD(&apos;week&apos;, -108, DATETRUNC(&apos;week&apos;, [Calculation_321796301139771406], &apos;monday&apos;))&#10;&#10;WHEN &apos;월별&apos; THEN [std_cd] = &apos;M&apos;&#10;            AND DATE([std_dt]) &gt;= DATEADD(&apos;month&apos;, -24, DATETRUNC(&apos;month&apos;, [Calculation_321796301139771406]))&#10;END' />
      </column>
      <column caption='구간대비 차이 범례' datatype='string' name='[Calculation_217157981082734615]' role='dimension' type='nominal'>
