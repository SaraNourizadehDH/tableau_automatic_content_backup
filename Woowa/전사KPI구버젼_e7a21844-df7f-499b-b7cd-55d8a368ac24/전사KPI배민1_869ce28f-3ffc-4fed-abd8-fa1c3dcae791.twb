    <worksheet name='기간 표시기7'>
      <table>
        <view>
          <datasources>
            <datasource caption='전사KPI_전사지표(전화주문수포함)' name='sqlproxy.1n6txe113xakq411bze0y0idhfo8' />
            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='조회 기간 구분값' datatype='string' name='[매개 변수 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;주별&quot;'>
              <calculation class='tableau' formula='&quot;주별&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.1n6txe113xakq411bze0y0idhfo8'>
            <column caption='(버튼)전체' datatype='string' name='[Calculation_212443275807653892]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;전체&quot;' />
            </column>
            <column caption='to_dt' datatype='datetime' name='[Calculation_321796301139771406]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;, -1, today())' />
            </column>
            <column caption='구간조회_시작날짜' datatype='datetime' name='[Calculation_75013115917979649]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;week&apos;, [Calculation_321796301139771406], &apos;monday&apos;)&#10;ELSE DATETRUNC(&apos;month&apos;, [Calculation_321796301139771406])&#10;END' />
            </column>
            <column-instance column='[Calculation_321796301139771406]' derivation='None' name='[none:Calculation_321796301139771406:ok]' pivot='key' type='ordinal' />
