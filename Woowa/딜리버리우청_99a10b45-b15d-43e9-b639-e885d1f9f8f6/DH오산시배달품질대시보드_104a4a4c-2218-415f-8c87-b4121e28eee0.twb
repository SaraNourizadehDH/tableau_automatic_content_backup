    <worksheet name='RD_일별_고객'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Nanum Gothic'>고객향 지표</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='results-20211110-084231 (results-20211110-084231)' name='federated.1icvjqr1i48obj1aplxoe1vyfu73' />
          </datasources>
          <datasource-dependencies datasource='federated.1icvjqr1i48obj1aplxoe1vyfu73'>
            <column caption='서비스타입' datatype='string' name='[Calculation_113364091363057670]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if left([platform_order_code (dongwoo_dh_delivery_quality_update)],1)=&quot;T&quot; then &quot;배민1&quot; else &quot;B마트&quot; end' />
            </column>
            <column caption='Deliveries Created At (Dongwoo Dh Delivery Quality Update)' datatype='datetime' name='[deliveries_created_at (dongwoo_dh_delivery_quality_update)]' role='dimension' type='ordinal' />
            <column caption='Deliveries Rider Dropped Off At (Dongwoo Dh Delivery Quality Update)' datatype='datetime' name='[deliveries_rider_dropped_off_at (dongwoo_dh_delivery_quality_update)]' role='dimension' type='ordinal' />
            <column caption='Delivery Id (Dongwoo Dh Delivery Quality Update)' datatype='integer' name='[delivery_id (dongwoo_dh_delivery_quality_update)]' role='dimension' type='ordinal' />
            <column caption='20분 이내 배달비중' datatype='real' name='[dh_20분 이내 배달비중(복사본)_113364091335401473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF  [dh_배달시간(복사본)_113364091335081984] &lt;=20&#10;THEN [delivery_id (dongwoo_dh_delivery_quality_update)]&#10;ELSE NULL END)/COUNTD([delivery_id (dongwoo_dh_delivery_quality_update)])' />
            </column>
            <column caption='40분 이내 배달비중 ' datatype='real' name='[dh_40분 이내 배달비중 (복사본)_113364091335483394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF  [dh_배달시간(복사본)_113364091335081984] &lt;=40&#10;THEN [delivery_id (dongwoo_dh_delivery_quality_update)]&#10;ELSE NULL END)/COUNTD([delivery_id (dongwoo_dh_delivery_quality_update)])' />
            </column>
            <column caption='60분 초과비중' datatype='real' name='[dh_60분 초과비중(복사본)_113364091335684099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [dh_배달시간(복사본)_113364091335081984] &gt;60&#10;THEN [delivery_id (dongwoo_dh_delivery_quality_update)]&#10;ELSE NULL END)/COUNTD([delivery_id (dongwoo_dh_delivery_quality_update)])' />
            </column>
            <column caption='배달시간' datatype='real' name='[dh_배달시간(복사본)_113364091335081984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;second&apos;,[deliveries_created_at (dongwoo_dh_delivery_quality_update)],[deliveries_rider_dropped_off_at (dongwoo_dh_delivery_quality_update)])/60.00' />
