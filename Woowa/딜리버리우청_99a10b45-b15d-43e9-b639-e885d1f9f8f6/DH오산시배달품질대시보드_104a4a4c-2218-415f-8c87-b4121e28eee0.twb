              <calculation class='tableau' formula='if left([platform_order_code (dongwoo_dh_delivery_quality_update)],1)=&quot;T&quot; then &quot;배민1&quot; else &quot;B마트&quot; end' />
            </column>
            <column caption='픽업시간' datatype='real' name='[Calculation_147563298520125440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='datediff(&apos;second&apos;,[deliveries_rider_accepted_at (dongwoo_dh_delivery_quality_update)],[deliveries_rider_picked_up_at (dongwoo_dh_delivery_quality_update)])/60.00' />
