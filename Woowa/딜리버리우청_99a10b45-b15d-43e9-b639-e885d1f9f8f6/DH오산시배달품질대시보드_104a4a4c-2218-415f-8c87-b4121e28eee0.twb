      <column caption='픽업예정시각+10분 초과율' datatype='real' name='[Calculation_109212333275500548]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - countd(&#10;if (datediff(&apos;second&apos;,[updated_scheduled_pickup_at (dongwoo_dh_delivery_quality_update)],[deliveries_rider_picked_up_at (dongwoo_dh_delivery_quality_update)])/60.00)&lt;=10&#10;then [order_id (dongwoo_dh_delivery_quality_update)] else null end)/ countd([order_id (dongwoo_dh_delivery_quality_update)])' />
      </column>
      <column caption='픽업예정시각+20분 초과율' datatype='real' name='[Calculation_109212333276950533]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1- countd(&#10;if (datediff(&apos;second&apos;,[updated_scheduled_pickup_at (dongwoo_dh_delivery_quality_update)],[deliveries_rider_picked_up_at (dongwoo_dh_delivery_quality_update)])/60.00)&lt;=20&#10;then [order_id (dongwoo_dh_delivery_quality_update)] else null end)/ countd([order_id (dongwoo_dh_delivery_quality_update)])' />
      </column>
      <column caption='날짜 비교' datatype='string' name='[Calculation_1097189474713403392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF date([created_date_kst]) = today() - 2 THEN &quot;전일&quot; &#13;&#10;ELSEIF  date([created_date_kst]) = (today()-1) - 7 THEN &quot;전주 동요일&quot; ELSE &quot;기준일&quot; END' />
      </column>
      <column caption='운영일 비교 (전주 동요일 비교)' datatype='boolean' name='[Calculation_1097189474716512267]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATE([created_date_kst])= today()-1 OR DATE([created_date_kst]) = today()-8 OR DATE([created_date_kst]) = today()-2' />
      </column>
      <column caption='전달시간' datatype='real' name='[Calculation_113364091336359940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='datediff(&apos;second&apos;,[deliveries_rider_picked_up_at (dongwoo_dh_delivery_quality_update)],[deliveries_rider_dropped_off_at (dongwoo_dh_delivery_quality_update)])/60.00' />
      </column>
      <column caption='서비스타입' datatype='string' name='[Calculation_113364091363057670]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if left([platform_order_code (dongwoo_dh_delivery_quality_update)],1)=&quot;T&quot; then &quot;배민1&quot; else &quot;B마트&quot; end' />
      </column>
      <column caption='라이더 당 배달건수' datatype='real' name='[Calculation_144537408144117760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_450922955392258048]/[Calculation_99008867186094082]' />
      </column>
      <column caption='픽업시간' datatype='real' name='[Calculation_147563298520125440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='datediff(&apos;second&apos;,[deliveries_rider_accepted_at (dongwoo_dh_delivery_quality_update)],[deliveries_rider_picked_up_at (dongwoo_dh_delivery_quality_update)])/60.00' />
      </column>
      <column caption='배달거리(m)' datatype='real' name='[Calculation_162692554710872065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[dropoff_distance_manhattan (dongwoo_dh_delivery_quality_update)]*1000' />
      </column>
      <column caption='조리시간 15분 이상 비중' datatype='real' name='[Calculation_163959218764853248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [est_prep_time (dongwoo_dh_delivery_quality_update)] &gt; 15 then [delivery_id (dongwoo_dh_delivery_quality_update)] else null end) / countd([delivery_id (dongwoo_dh_delivery_quality_update)])' />
      </column>
      <column caption='픽업예정시각 픽업율' datatype='real' name='[Calculation_172896046459244544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [updated_scheduled_pickup_at (dongwoo_dh_delivery_quality_update)]&gt;[deliveries_rider_picked_up_at (dongwoo_dh_delivery_quality_update)]&#10;THEN [delivery_id (dongwoo_dh_delivery_quality_update)]&#10;ELSE NULL END)/COUNTD([delivery_id (dongwoo_dh_delivery_quality_update)])' />
      </column>
      <column caption='배달거리(전달거리)' datatype='real' name='[Calculation_177821879014629376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[dropoff_distance_manhattan (dongwoo_dh_delivery_quality_update)]/1.3' />
      </column>
      <column caption='dh_픽업시간' datatype='real' name='[Calculation_177821879014744065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='datediff(&apos;second&apos;,[deliveries_rider_accepted_at (dongwoo_dh_delivery_quality_update)],[deliveries_rider_near_restaurant_at (dongwoo_dh_delivery_quality_update)])/60.00' />
      </column>
      <column caption='고객안내시간' datatype='real' name='[Calculation_2214645170376204288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;second&apos;,[order_placed_at (dongwoo_dh_delivery_quality_update)], [promised_delivery_time (dongwoo_dh_delivery_quality_update)])/60.00' />
      </column>
      <column aggregation='Sum' caption='Hour KST' datatype='integer' name='[Calculation_3166030578197172224]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;,[created_date_kst])' />
      </column>
      <column caption='dh_배달시간' datatype='real' name='[Calculation_3166030578197368833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;second&apos;,[deliveries_created_at (dongwoo_dh_delivery_quality_update)],[deliveries_rider_near_customer_at (dongwoo_dh_delivery_quality_update)])/60.00' />
      </column>
      <column caption='dh_60분 초과비중' datatype='real' name='[Calculation_3166030578207133701]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF  [Calculation_3166030578197368833] &gt;60&#10;THEN [delivery_id (dongwoo_dh_delivery_quality_update)]&#10;ELSE NULL END)/COUNTD([delivery_id (dongwoo_dh_delivery_quality_update)])' />
      </column>
      <column caption='배달건수' datatype='integer' name='[Calculation_450922955392258048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([order_id (dongwoo_dh_delivery_quality_update)])' />
      </column>
      <column caption='조리완료예정시각' datatype='datetime' name='[Calculation_450922955436515329]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='IF [est_prep_time (dongwoo_dh_delivery_quality_update)]&lt; 15 then DATEADD(&apos;minute&apos;, [est_prep_time (dongwoo_dh_delivery_quality_update)], [deliveries_rider_accepted_at (dongwoo_dh_delivery_quality_update)])&#10;ELSE&#10;DATEADD(&apos;minute&apos;, [est_prep_time (dongwoo_dh_delivery_quality_update)], [vendor_accepted_at (dongwoo_dh_delivery_quality_update)])&#10;END' />
      </column>
      <column caption='조리완료예정시각 픽업율' datatype='real' name='[Calculation_450922955437264898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_450922955436515329]&gt;[deliveries_rider_picked_up_at (dongwoo_dh_delivery_quality_update)]&#10;THEN [delivery_id (dongwoo_dh_delivery_quality_update)]&#10;ELSE NULL END)/COUNTD([delivery_id (dongwoo_dh_delivery_quality_update)])' />
      </column>
      <column caption='고안시 준수율' datatype='real' name='[Calculation_629518808271826944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [promised_delivery_time (dongwoo_dh_delivery_quality_update)] &lt; [deliveries_rider_dropped_off_at (dongwoo_dh_delivery_quality_update)] THEN 0&#10;ELSE 1 END) / COUNT(1)' />
      </column>
      <column caption='평균고객안내시간' datatype='real' name='[Calculation_629518808274321409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;second&apos;, [deliveries_created_at (dongwoo_dh_delivery_quality_update)], [promised_delivery_time (dongwoo_dh_delivery_quality_update)])/60.00' />
      </column>
      <column caption='주문 ~ 픽업' datatype='real' name='[Calculation_629518808276492292]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='datediff(&apos;second&apos;,[deliveries_created_at (dongwoo_dh_delivery_quality_update)],[deliveries_rider_picked_up_at (dongwoo_dh_delivery_quality_update)])/60.00' />
      </column>
      <column caption='이번주 미완성 데이터는 미포함' datatype='string' name='[Calculation_704320817320169472]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if datepart(&apos;week&apos;,[created_date_kst])=datepart(&apos;week&apos;,today()) then &quot;이번주 미완성 데이터&quot; else &quot;저번주까지의 데이터&quot; END' />
      </column>
      <column caption='장기미배차 비중' datatype='real' name='[Calculation_99008867185352704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(&#10;if datediff(&apos;second&apos;,[created_at (dongwoo_dh_delivery_quality_update)],[deliveries_rider_accepted_at (dongwoo_dh_delivery_quality_update)])/60.00 &gt; 30&#10;then [delivery_id (dongwoo_dh_delivery_quality_update)] else null end) /&#10;countd([delivery_id (dongwoo_dh_delivery_quality_update)])' />
