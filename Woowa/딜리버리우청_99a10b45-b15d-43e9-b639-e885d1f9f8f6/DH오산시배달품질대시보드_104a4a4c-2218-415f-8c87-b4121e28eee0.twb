            <column-instance column='[dropoff_distance_manhattan (dongwoo_dh_delivery_quality_update)]' derivation='Avg' name='[avg:dropoff_distance_manhattan (dongwoo_dh_delivery_quality_update):qk]' pivot='key' type='quantitative' />
            <column-instance column='[est_prep_time (dongwoo_dh_delivery_quality_update)]' derivation='Avg' name='[avg:est_prep_time (dongwoo_dh_delivery_quality_update):qk]' pivot='key' type='quantitative' />
