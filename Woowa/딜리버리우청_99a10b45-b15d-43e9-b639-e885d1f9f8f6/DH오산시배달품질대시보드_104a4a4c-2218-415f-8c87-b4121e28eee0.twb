          <datasource-dependencies datasource='federated.1icvjqr1i48obj1aplxoe1vyfu73'>
            <column caption='픽업예정시각+10분 초과율' datatype='real' name='[Calculation_109212333275500548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - countd(&#10;if (datediff(&apos;second&apos;,[updated_scheduled_pickup_at (dongwoo_dh_delivery_quality_update)],[deliveries_rider_picked_up_at (dongwoo_dh_delivery_quality_update)])/60.00)&lt;=10&#10;then [order_id (dongwoo_dh_delivery_quality_update)] else null end)/ countd([order_id (dongwoo_dh_delivery_quality_update)])' />
            </column>
            <column caption='픽업예정시각+20분 초과율' datatype='real' name='[Calculation_109212333276950533]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1- countd(&#10;if (datediff(&apos;second&apos;,[updated_scheduled_pickup_at (dongwoo_dh_delivery_quality_update)],[deliveries_rider_picked_up_at (dongwoo_dh_delivery_quality_update)])/60.00)&lt;=20&#10;then [order_id (dongwoo_dh_delivery_quality_update)] else null end)/ countd([order_id (dongwoo_dh_delivery_quality_update)])' />
            </column>
            <column caption='날짜 비교' datatype='string' name='[Calculation_1097189474713403392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF date([created_date_kst]) = today() - 2 THEN &quot;전일&quot; &#13;&#10;ELSEIF  date([created_date_kst]) = (today()-1) - 7 THEN &quot;전주 동요일&quot; ELSE &quot;기준일&quot; END' />
            </column>
            <column caption='운영일 비교 (전주 동요일 비교)' datatype='boolean' name='[Calculation_1097189474716512267]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATE([created_date_kst])= today()-1 OR DATE([created_date_kst]) = today()-8 OR DATE([created_date_kst]) = today()-2' />
            </column>
            <column caption='서비스타입' datatype='string' name='[Calculation_113364091363057670]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if left([platform_order_code (dongwoo_dh_delivery_quality_update)],1)=&quot;T&quot; then &quot;배민1&quot; else &quot;B마트&quot; end' />
            </column>
            <column caption='픽업시간' datatype='real' name='[Calculation_147563298520125440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='datediff(&apos;second&apos;,[deliveries_rider_accepted_at (dongwoo_dh_delivery_quality_update)],[deliveries_rider_picked_up_at (dongwoo_dh_delivery_quality_update)])/60.00' />
            </column>
