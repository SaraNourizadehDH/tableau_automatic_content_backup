            <column caption='픽업예정시각+10분 초과율' datatype='real' name='[Calculation_109212333275500548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - countd(&#10;if (datediff(&apos;second&apos;,[updated_scheduled_pickup_at (dongwoo_dh_delivery_quality_update)],[deliveries_rider_picked_up_at (dongwoo_dh_delivery_quality_update)])/60.00)&lt;=10&#10;then [order_id (dongwoo_dh_delivery_quality_update)] else null end)/ countd([order_id (dongwoo_dh_delivery_quality_update)])' />
            </column>
            <column caption='픽업예정시각+20분 초과율' datatype='real' name='[Calculation_109212333276950533]' role='measure' type='quantitative'>
