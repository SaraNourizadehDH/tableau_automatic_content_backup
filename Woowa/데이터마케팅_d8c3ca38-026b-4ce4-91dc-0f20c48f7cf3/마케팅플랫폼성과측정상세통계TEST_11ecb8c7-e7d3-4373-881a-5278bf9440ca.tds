    <relation connection='athena.0ncnk4w1qyiinx1b6sk9i0vhn0b4' name='사용자 지정 SQL 쿼리' type='text'>with date_cal&#10;as (&#10;    select &#10;            base_dt&#10;          , dow&#10;          , CONCAT(CAST(CAST(wom AS INT) AS VARCHAR), &apos;주&apos;) AS ww&#10;    from (&#10;                select&#10;                       CEIL((CAST(SUBSTR(CAST(base_dt as varchar), -2, 2) AS INTEGER) + 7.0 - DAY_OF_WEEK(base_dt)) / 7) AS wom&#10;                     , * &#10;                from cl_common.date_master&#10;                where cast(base_dt as varchar) &gt;&gt;= &apos;2024-01-01&apos;&#10;                and  cast(base_dt as varchar) &lt;&lt; &apos;2024-12-30&apos;&#10;        )&#10;    )&#10;&#10;select &#10; base_ym&#9; as &quot;기준년월&quot;&#10;,date_cal.ww as &quot;주차&quot; -- 계산값&#10;,part_date&#9;as &quot;발송일자&quot;&#10;,dow_nm&#9;as &quot;발송요일&quot; --요일이름&#10;,mkt_ch_cd&#9;as &quot;채널&quot; --마케팅채널코드&#10;,mkt_scen_id&#9;as &quot;시나리오ID&quot; -- 마케팅시나리오ID&#10;,mkt_scen_nm&#9;as &quot;캠페인명&quot; --마케팅시나리오이름&#10;--,mkt_action_id&#9;as &quot;액션ID&quot; --마케팅행동ID&#10;--,mkt_action_nm&#9;as &quot;액션명&quot; --마케팅행동이름&#10;,mkt_cate_lv1_nm&#9;as &quot;사업유형&quot; --마케팅카테고리1레벨이름&#10;,mkt_cate_lv2_nm&#9;as &quot;서비스유형&quot; --마케팅카테고리2레벨이름&#10;,mkt_cate_lv3_nm&#9;as &quot;캠페인유형&quot; --마케팅카테고리3레벨이름&#10;,mkt_cate_lv4_nm&#9;as &quot;타겟유형&quot; --마케팅카테고리4레벨이름&#10;,buds_seg_nm&#9;as &quot;대상자&quot; --BUDS세그먼트이름&#10;,expected_send_cnt&#9;as &quot;예상발송수&quot; --예상발신수&#10;,send_cnt&#9;as &quot;발송수&quot; --발신수&#10;,open_cnt&#9;as &quot;오픈수&quot;&#10;,open_rate&#9;as &quot;CTR&quot; --오픈율&#10;,base_ord_cnt&#9;as &quot;주문전환수&quot;&#10;,cvr&#9;as &quot;주문CVR&quot; --주문전환율&#10;,food_ord_cnt as &quot;푸드통합주문수&quot;&#10;,mp_ord_cnt  as &quot;배민주문수&quot;&#10;,od_ord_cnt as &quot;배민1주문수&quot;&#10;,takeout_ord_cnt as &quot;포장주문수&quot;&#10;,commerce_ord_cnt as  &quot;커머스통합주문수&quot;&#10;,bmart_ord_cnt&#9;as  &quot;B마트주문수&quot;&#10;,bms_ord_cnt as  &quot;배민스토어주문수&quot;&#10;,hypmrkt_ord_cnt as  &quot;대용량특가주문수&quot;&#10;,directfm_ord_cnt&#9;as  &quot;전국별미주문수&quot;&#10;,dvc_push_optout_change_cnt&#9;as &quot;푸시OFF수&quot; --디바이스수신미동의변경수&#10;,dvc_push_optout_change_rate&#9;as &quot;푸시OFF율&quot; --디바이스수신미동의변경률&#10;,sms_optout_change_cnt&#9;as &quot;SMS수신OFF수&quot; --SMS수신미동의변경수&#10;,sms_optout_change_rate&#9;as &quot;SMS수신OFF율&quot; --SMS수신미동의변경률&#10;,bmclub_mbrshp_subs_cnt&#9;as &quot;멤버십전환수&quot; --배민클럽멤버십구독수&#10;,bmclub_mbrshp_subs_cvr&#9;as &quot;멤버십전환율&quot; --배민클럽멤버십구독전환율&#10;,msg_title&#9;as &quot;타이틀&quot; --메시지제목&#10;,msg_cont&#9;as &quot;본문&quot;--메시지내용&#10;&#10;from temp.mktplf_scen_det_stat_daily_0925 a&#10;left join date_cal&#10;on a.part_date = cast(date_cal.base_dt as varchar)&#10;order by part_date,mkt_scen_id</relation>
