      </column>
      <column caption='% diff of 푸드업주수' datatype='real' name='[Calculation_770115584764911630]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN&#13;&#10;(ZN(SUM([food_seller_cnt])) - LOOKUP(ZN(SUM([food_seller_cnt])), -1)) / ABS(LOOKUP(ZN(SUM([food_seller_cnt])), -1))&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN &#13;&#10;(ZN(SUM([food_seller_cnt])) - LOOKUP(ZN(SUM([food_seller_cnt])), -1)) / ABS(LOOKUP(ZN(SUM([food_seller_cnt])), -1))&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN&#13;&#10;(ZN(SUM([food_seller_cnt])) - LOOKUP(ZN(SUM([food_seller_cnt])), -7)) / ABS(LOOKUP(ZN(SUM([food_seller_cnt])), -7))&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% diff of 배민(mp) 이용률' datatype='real' name='[Calculation_770115584766722070]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN&#13;&#10;(ZN([Calculation_770115584762949637]) - LOOKUP(ZN([Calculation_770115584762949637]), -1))&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN &#13;&#10;(ZN([Calculation_770115584762949637]) - LOOKUP(ZN([Calculation_770115584762949637]), -1))&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN&#13;&#10;(ZN([Calculation_770115584762949637]) - LOOKUP(ZN([Calculation_770115584762949637]), -7))&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='F_Last' datatype='boolean' name='[Calculation_770115584771260445]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST() = 0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='신규+재가입업주수' datatype='integer' name='[Calculation_770115584773517344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[new_seller_cnt] + [rejoin_seller_cnt]' />
      </column>
      <column caption='순증업주수_ABS' datatype='integer' name='[Calculation_770115584789622819]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS([net_increase_seller_cnt])' />
      </column>
      <column caption='F_Date_Clsf' datatype='boolean' name='[Calculation_770115584789880868]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN&#13;&#10;[std_cd] = &apos;D&apos; &#13;&#10;AND DATETRUNC(&apos;day&apos;,[Calculation_770115584761483268]) &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;day&apos;, [Calculation_770115584761483268]) &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;day&apos;, -14,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN &#13;&#10;[std_cd] = &apos;W&apos; &#13;&#10;AND DATETRUNC(&apos;iso-week&apos;,[Calculation_770115584761483268]) &lt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;iso-week&apos;, [Calculation_770115584761483268]) &gt;= DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, -11,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN [std_cd] = &apos;M&apos;&#13;&#10;AND DATETRUNC(&apos;month&apos;,[Calculation_770115584761483268]) &lt;= DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;month&apos;, [Calculation_770115584761483268]) &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -12,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='리스팅 업주당 광고수' datatype='real' name='[Calculation_770115584791113765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([listing_cnt]) / SUM([listing_seller_cnt])' />
