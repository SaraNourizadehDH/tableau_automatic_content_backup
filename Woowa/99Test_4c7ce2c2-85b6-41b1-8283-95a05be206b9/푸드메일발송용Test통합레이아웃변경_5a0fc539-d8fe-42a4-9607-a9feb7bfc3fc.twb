        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN&#13;&#10;[std_cd] = &apos;D&apos; &#13;&#10;AND DATETRUNC(&apos;day&apos;,[Calculation_93168266838556674]) &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;day&apos;, [Calculation_93168266838556674]) &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;day&apos;, -7,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN &#13;&#10;[std_cd] = &apos;W&apos; &#13;&#10;AND DATETRUNC(&apos;iso-week&apos;,[Calculation_93168266838556674]) &lt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;iso-week&apos;, [Calculation_93168266838556674]) &gt;= DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, -5,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN [std_cd] = &apos;M&apos;&#13;&#10;AND DATETRUNC(&apos;month&apos;,[Calculation_93168266838556674]) &lt;= DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;month&apos;, [Calculation_93168266838556674]) &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -5,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='C_Date_Label' datatype='string' name='[Calculation_93168266838904837]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[매개 변수 1]&#13;&#10;when &apos;일별&apos;&#13;&#10;then if len(str(DATEPART(&apos;month&apos;,[Calculation_93168266838556674]))) = 1&#13;&#10;     then MID(STR([Calculation_93168266838556674]),7,1)+&quot;월 &quot;&#13;&#10;&#13;&#10;     else MID(STR([Calculation_93168266838556674]),6,2)+&quot;월 &quot;&#13;&#10;     end&#13;&#10;     +&#13;&#10;     if len(str(DATEPART(&apos;day&apos;,[Calculation_93168266838556674]))) = 1&#13;&#10;     then MID(STR([Calculation_93168266838556674]),10,1)+&quot;일&quot;&#13;&#10;&#13;&#10;     else MID(STR([Calculation_93168266838556674]),9,2)+&quot;일&quot;&#13;&#10;     end&#13;&#10;     &#13;&#10;when &apos;주별&apos;&#13;&#10;then [week_nm]&#13;&#10;&#13;&#10;when &apos;월별&apos;&#13;&#10;then  &#13;&#10;IF len(str(DATEPART(&apos;month&apos;,[Calculation_93168266838556674]))) = 2&#13;&#10;then MID(STR([Calculation_93168266838556674]),3,2)+&quot;년 &quot;+MID(STR([Calculation_93168266838556674]),6,2) + &apos;월&apos;&#13;&#10;ELSE MID(STR([Calculation_93168266838556674]),3,2)+&quot;년 &quot;+MID(STR([Calculation_93168266838556674]),7,1) + &apos;월&apos;&#13;&#10;&#13;&#10;END&#13;&#10;END' />
      </column>
      <column caption='C_Trend_Label_Short' datatype='string' name='[Calculation_93168266839064582]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[매개 변수 1]&#13;&#10;when &apos;일별&apos;&#13;&#10;then &apos;최근 8일 트렌드&apos;&#13;&#10;when &apos;주별&apos;&#13;&#10;then &apos;최근 6주 트렌드&apos;&#13;&#10;when &apos;월별&apos;&#13;&#10;then &apos;최근 6개월 트렌드&apos;&#13;&#10;END' />
      </column>
