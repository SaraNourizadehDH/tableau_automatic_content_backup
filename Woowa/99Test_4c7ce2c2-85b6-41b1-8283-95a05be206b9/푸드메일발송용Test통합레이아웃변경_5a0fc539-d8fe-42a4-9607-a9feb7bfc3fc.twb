              <calculation class='tableau' formula='&quot;월별&quot;' />
            </column>
            <column caption='p_Date' datatype='date' default-format='*yyyy-mm-dd' name='[매개 변수 2]' param-domain-type='any' role='measure' type='quantitative' value='#2023-07-10#'>
              <calculation class='tableau' formula='#2023-07-10#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0slj80c0pofq5s13yppyl1xkqdac'>
            <column caption='C_Date' datatype='date' name='[Calculation_93168266838556674]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([base_dt])' />
            </column>
            <column caption='F_Date_Clsf' datatype='boolean' name='[Calculation_93168266838765571]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN&#13;&#10;[std_cd] = &apos;D&apos; &#13;&#10;AND DATETRUNC(&apos;day&apos;,[Calculation_93168266838556674]) &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;day&apos;, [Calculation_93168266838556674]) &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;day&apos;, -14,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN &#13;&#10;[std_cd] = &apos;W&apos; &#13;&#10;AND DATETRUNC(&apos;iso-week&apos;,[Calculation_93168266838556674]) &lt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;iso-week&apos;, [Calculation_93168266838556674]) &gt;= DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, -11,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN [std_cd] = &apos;M&apos;&#13;&#10;AND DATETRUNC(&apos;month&apos;,[Calculation_93168266838556674]) &lt;= DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;month&apos;, [Calculation_93168266838556674]) &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -12,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='C_Date_Label' datatype='string' name='[Calculation_93168266838904837]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[매개 변수 1]&#13;&#10;when &apos;일별&apos;&#13;&#10;then if len(str(DATEPART(&apos;month&apos;,[Calculation_93168266838556674]))) = 1&#13;&#10;     then MID(STR([Calculation_93168266838556674]),7,1)+&quot;월 &quot;&#13;&#10;&#13;&#10;     else MID(STR([Calculation_93168266838556674]),6,2)+&quot;월 &quot;&#13;&#10;     end&#13;&#10;     +&#13;&#10;     if len(str(DATEPART(&apos;day&apos;,[Calculation_93168266838556674]))) = 1&#13;&#10;     then MID(STR([Calculation_93168266838556674]),10,1)+&quot;일&quot;&#13;&#10;&#13;&#10;     else MID(STR([Calculation_93168266838556674]),9,2)+&quot;일&quot;&#13;&#10;     end&#13;&#10;     &#13;&#10;when &apos;주별&apos;&#13;&#10;then [week_nm]&#13;&#10;&#13;&#10;when &apos;월별&apos;&#13;&#10;then  &#13;&#10;IF len(str(DATEPART(&apos;month&apos;,[Calculation_93168266838556674]))) = 2&#13;&#10;then MID(STR([Calculation_93168266838556674]),3,2)+&quot;년 &quot;+MID(STR([Calculation_93168266838556674]),6,2) + &apos;월&apos;&#13;&#10;ELSE MID(STR([Calculation_93168266838556674]),3,2)+&quot;년 &quot;+MID(STR([Calculation_93168266838556674]),7,1) + &apos;월&apos;&#13;&#10;&#13;&#10;END&#13;&#10;END' />
            </column>
            <column caption='Base Dt' datatype='date' name='[base_dt]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_93168266838556674]' derivation='Min' name='[min:Calculation_93168266838556674:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_93168266838765571]' derivation='None' name='[none:Calculation_93168266838765571:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_93168266838904837]' derivation='None' name='[none:Calculation_93168266838904837:nk]' pivot='key' type='nominal' />
            <column-instance column='[피벗 필드명]' derivation='None' name='[none:피벗 필드명:nk]' pivot='key' type='nominal' />
