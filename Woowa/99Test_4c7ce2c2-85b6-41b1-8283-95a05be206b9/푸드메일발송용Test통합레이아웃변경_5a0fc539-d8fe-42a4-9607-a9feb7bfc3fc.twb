    <worksheet name='1_MainText'>
      <table>
        <view>
          <datasources>
            <datasource caption='푸드_Summary' name='sqlproxy.0plehck0gb1la1109gdm7102vr0n' />
            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p_Date_Type' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;월별&quot;'>
              <calculation class='tableau' formula='&quot;월별&quot;' />
            </column>
            <column caption='p_Date' datatype='date' default-format='*yyyy-mm-dd' name='[매개 변수 2]' param-domain-type='any' role='measure' type='quantitative' value='#2023-07-10#'>
              <calculation class='tableau' formula='#2023-07-10#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0plehck0gb1la1109gdm7102vr0n'>
            <column caption='배민1 내 한집배달 비중%' datatype='real' name='[Calculation_247135072755965952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bm1_only]) / SUM([bm1_ord])' />
            </column>
            <column caption='배민1 주문 비중%' datatype='real' name='[Calculation_247135072757624835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bm1_ord]) / SUM([ord_cnt])' />
            </column>
            <column caption='배민 과금 GFV 비중%' datatype='real' name='[Calculation_247135072758251524]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([seller_paid_ad_ord_gpv]) / SUM([gfv])' />
            </column>
            <column caption='푸드 AFV' datatype='real' name='[Calculation_247135072758546437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gfv])/sum([ord_cnt])' />
            </column>
            <column caption='오픈리스트 GFV%_MP' datatype='real' name='[Calculation_348747540062318606]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([openlist_gpv]) / SUM([bm_gfv])' />
            </column>
            <column caption='F_Date_clsf' datatype='boolean' name='[Calculation_488922077101375490]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN&#13;&#10;[std_cd] = &apos;D&apos; &#13;&#10;AND DATETRUNC(&apos;day&apos;,[Calculation_488922077102366723]) &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;day&apos;, [Calculation_488922077102366723]) &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;day&apos;, -14,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN &#13;&#10;[std_cd] = &apos;W&apos; &#13;&#10;AND DATETRUNC(&apos;iso-week&apos;,[Calculation_488922077102366723]) &lt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;iso-week&apos;, [Calculation_488922077102366723]) &gt;= DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, -11,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN [std_cd] = &apos;M&apos;&#13;&#10;AND DATETRUNC(&apos;month&apos;,[Calculation_488922077102366723]) &lt;= DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;month&apos;, [Calculation_488922077102366723]) &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -12,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='C_Date' datatype='date' default-format='*m&quot;월&quot; d&quot;일&quot;' name='[Calculation_488922077102366723]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([base_dt])' />
            </column>
            <column caption='C_Date_Label' datatype='string' name='[Calculation_488922077104840708]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[매개 변수 1]&#13;&#10;when &apos;일별&apos;&#13;&#10;then if len(str(DATEPART(&apos;month&apos;,[Calculation_488922077102366723]))) = 1&#13;&#10;     then MID(STR([Calculation_488922077102366723]),7,1)+&quot;월 &quot;&#13;&#10;&#13;&#10;     else MID(STR([Calculation_488922077102366723]),6,2)+&quot;월 &quot;&#13;&#10;     end&#13;&#10;     +&#13;&#10;     if len(str(DATEPART(&apos;day&apos;,[Calculation_488922077102366723]))) = 1&#13;&#10;     then MID(STR([Calculation_488922077102366723]),10,1)+&quot;일&quot;&#13;&#10;&#13;&#10;     else MID(STR([Calculation_488922077102366723]),9,2)+&quot;일&quot;&#13;&#10;     end&#13;&#10;     &#13;&#10;when &apos;주별&apos;&#13;&#10;then [week_nm]&#13;&#10;when &apos;월별&apos;&#13;&#10;then  &#13;&#10;IF len(str(DATEPART(&apos;month&apos;,[Calculation_488922077102366723]))) = 2&#13;&#10;then MID(STR([Calculation_488922077102366723]),3,2)+&quot;년 &quot;+MID(STR([Calculation_488922077102366723]),6,2) + &apos;월&apos;&#13;&#10;ELSE MID(STR([Calculation_488922077102366723]),3,2)+&quot;년 &quot;+MID(STR([Calculation_488922077102366723]),7,1) + &apos;월&apos;&#13;&#10;&#13;&#10;END&#13;&#10;END' />
            </column>
            <column caption='푸드주문 전환율' datatype='real' name='[Calculation_891431294474018819]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([food_ord_mem_cnt]) / SUM([visit_cnt])' />
            </column>
            <column caption='C_매출액+리스팅(프차)' datatype='real' name='[Calculation_949415148210302976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([매출액]) + sum([리스팅(프차)])' />
            </column>
            <column caption='C_배민GFV-오픈리스트GFV' datatype='integer' name='[Calculation_949415148212580353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([bm_gfv]) - sum([openlist_gpv])' />
            </column>
            <column caption='배민MP(오픈리스트 제외)Take-rate' datatype='real' name='[Calculation_949415148213452802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_949415148210302976] / [Calculation_949415148212580353]' />
