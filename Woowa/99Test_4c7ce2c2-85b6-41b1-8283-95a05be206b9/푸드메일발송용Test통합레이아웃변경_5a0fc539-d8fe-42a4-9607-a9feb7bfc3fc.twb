            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[bm1_multi]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[bm1_multi_paid_ord]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
