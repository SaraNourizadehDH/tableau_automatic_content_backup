    <worksheet name='Button'>
      <table>
        <view>
          <datasources>
            <datasource caption='푸드_Summary' name='sqlproxy.0plehck0gb1la1109gdm7102vr0n' />
            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p_Date_Type' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;월별&quot;'>
              <calculation class='tableau' formula='&quot;월별&quot;' />
            </column>
            <column caption='p_Date' datatype='date' default-format='*yyyy-mm-dd' name='[매개 변수 2]' param-domain-type='any' role='measure' type='quantitative' value='#2023-07-10#'>
              <calculation class='tableau' formula='#2023-07-10#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0plehck0gb1la1109gdm7102vr0n'>
            <column caption='Date_Text_Label_NEW' datatype='string' name='[C_Date_Label(복사본)_548876250991837188]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Calculation_488922077100130304]&#13;&#10;when &apos;일별&apos;&#13;&#10;then if len(str(DATEPART(&apos;month&apos;,[Parameters].[매개 변수 2]))) = 1&#13;&#10;     then MID(STR([Parameters].[매개 변수 2]),7,1)+&quot;월 &quot;&#13;&#10;&#13;&#10;     else MID(STR([Parameters].[매개 변수 2]),6,2)+&quot;월 &quot;&#13;&#10;     end&#13;&#10;     +&#13;&#10;     if len(str(DATEPART(&apos;day&apos;,[Parameters].[매개 변수 2]))) = 1&#13;&#10;     then MID(STR([Parameters].[매개 변수 2]),10,1)+&quot;일&quot;&#13;&#10;&#13;&#10;     else MID(STR([Parameters].[매개 변수 2]),9,2)+&quot;일&quot;&#13;&#10;     end&#13;&#10;     &#13;&#10;when &apos;주별&apos;&#13;&#10;then [week_nm]&#13;&#10;when &apos;월별&apos;&#13;&#10;then  &#13;&#10;IF len(str(DATEPART(&apos;month&apos;,[Parameters].[매개 변수 2]))) = 2&#13;&#10;then MID(STR([Parameters].[매개 변수 2]),3,2)+&quot;년 &quot;+MID(STR([Parameters].[매개 변수 2]),6,2) + &apos;월&apos;&#13;&#10;ELSE MID(STR([Parameters].[매개 변수 2]),3,2)+&quot;년 &quot;+MID(STR([Parameters].[매개 변수 2]),7,1) + &apos;월&apos;&#13;&#10;&#13;&#10;END&#13;&#10;END' />
            </column>
            <column caption='c_button' datatype='string' name='[Calculation_488922077100130304]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [std_cd]&#13;&#10;when  &apos;D&apos; then &apos;일별&apos;&#13;&#10;when &apos;W&apos; then &apos;주별&apos;&#13;&#10;when &apos;M&apos; then &apos;월별&apos;&#13;&#10;END' />
            </column>
            <column caption='F_Button_Date' datatype='boolean' name='[Calculation_488922077100568577]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[매개 변수 1]=[Calculation_488922077100130304]' />
            </column>
            <column caption='C_Date' datatype='date' default-format='*m&quot;월&quot; d&quot;일&quot;' name='[Calculation_488922077102366723]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([base_dt])' />
            </column>
            <column caption='C_True' datatype='boolean' name='[Calculation_804174051974664192]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='TRUE' />
            </column>
            <column caption='C_False' datatype='boolean' name='[Calculation_804174051974696961]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='FALSE' />
            </column>
            <column caption='Date_Text_Label' datatype='string' name='[Calculation_909164218359459840]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Calculation_488922077100130304]&#13;&#10;WHEN &apos;월별&apos; THEN REPLACE(MID(str([Parameters].[매개 변수 2]),3,5),&apos;-&apos;,&apos;/&apos;)&#13;&#10;WHEN &apos;주별&apos; &#13;&#10;THEN&#13;&#10;IF DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2]) = DATETRUNC(&apos;iso-week&apos;,[Calculation_488922077102366723])&#13;&#10;THEN [week_nm] END&#13;&#10;WHEN &apos;일별&apos; THEN REPLACE(MID(str([Parameters].[매개 변수 2]),6,5),&apos;-&apos;,&apos;/&apos;)&#13;&#10;END' />
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[base_dt]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column-instance column='[C_Date_Label(복사본)_548876250991837188]' derivation='None' name='[none:C_Date_Label(복사본)_548876250991837188:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_488922077100130304]' derivation='None' name='[none:Calculation_488922077100130304:nk]' pivot='key' type='nominal' />
