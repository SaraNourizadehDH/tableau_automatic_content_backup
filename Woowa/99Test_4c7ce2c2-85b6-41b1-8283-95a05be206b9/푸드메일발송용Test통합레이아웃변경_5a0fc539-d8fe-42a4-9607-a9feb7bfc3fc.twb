        <calculation class='tableau' formula='SUM(if [rgn_area_cat] =&apos;서울&apos; or [rgn_area_cat] = &apos;수도권&apos; then [bm1_ord] END)&#13;&#10;/ &#13;&#10;SUM(if [rgn_area_cat] =&apos;서울&apos; or [rgn_area_cat] = &apos;수도권&apos; then [ord_cnt] END)' />
