      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.10qjlsp08vq8ui13woh2n0luy1a6].[ctd:고객 이름:qk]&quot;' value='고객 이름' />
        </aliases>
      </column>
      <column caption='배송 기간(실제)' datatype='integer' name='[Calculation_1724597218012655617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[주문 날짜],[배송 날짜])' />
      </column>
      <column caption='배송 기간(예약)' datatype='integer' name='[Calculation_1724597218012704770]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE  [배송 형태]&#13;&#10;WHEN &quot;당일&quot; THEN 0&#13;&#10;WHEN &quot;1등급&quot; THEN 1&#13;&#10;WHEN &quot;2등급&quot; THEN 3&#13;&#10;WHEN &quot;표준 등급&quot; THEN 6&#13;&#10;END' />
      </column>
      <column caption='주문별 수익' datatype='real' default-format='C1042%' name='[Calculation_1724597218013069316]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([수익])/COUNTD([주문 ID])' />
      </column>
      <column caption='목표를 초과한 매출?' datatype='string' name='[Calculation_1724597218013474822]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF Sum([매출])&gt;SUM([federated.00iyqtr0v7mi8r18qte8s0wb90u3].[매출 목표])&#13;&#10;THEN &quot;목표 초과&quot;&#13;&#10;ELSE &quot;목표 미만&quot; &#13;&#10;END' />
      </column>
      <column caption='매출 예측' datatype='real' default-format='C1042%' name='[Calculation_1724597218015350793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[매출]*(1-[Parameters].[Parameter 3])*(1+[Parameters].[Parameter 4])' />
      </column>
      <column caption='고객별 매출' datatype='real' default-format='C1042%' name='[Calculation_1724597218015416330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([매출])/COUNTD([고객 이름])' />
      </column>
      <column caption='주문의 수익성?' datatype='boolean' name='[Calculation_1724597218015641612]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [주문 ID]:SUM([수익])}&gt;0&#13;&#10;// 주문 수준에서 수익 계산' />
        <aliases>
          <alias key='false' value='수익성 없음' />
          <alias key='true' value='수익성 있음' />
        </aliases>
      </column>
      <column caption='표준 등급' datatype='string' name='[Calculation_1827617081372209155]' role='dimension' type='nominal'>
