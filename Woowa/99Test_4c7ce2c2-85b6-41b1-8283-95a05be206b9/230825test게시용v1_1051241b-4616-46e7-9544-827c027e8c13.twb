            <column caption='Rgn_Gubun' datatype='string' name='[Rgn1 Nm(복사본)_1745426387183116288]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [rgn1_nm] = &apos;서울특별시&apos; then &apos;서울&apos; &#13;&#10;ELSEIF [rgn1_nm] in (&apos;경기도&apos;,&apos;인천광역시&apos;) then &apos;경인&apos; &#13;&#10;ELSEIF [rgn1_nm] in (&apos;부산광역시&apos;, &apos;대구광역시&apos;, &apos;울산광역시&apos;, &apos;대전광역시&apos;, &apos;광주광역시&apos;) then &apos;광역시&apos;&#13;&#10;ELSE &apos;지방&apos; END' />
            </column>
            <column caption='주문서비스' datatype='string' name='[Svc Gubun(복사본)_638385299741036547]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  [svc_gubun] = &apos;배민&apos; then &apos;배민&apos;&#13;&#10;ELSEIF [svc_gubun] = &apos;배민1&apos; then &apos;한집배달&apos;&#13;&#10;ELSEIF [svc_gubun] = &apos;STOD&apos; then &apos;알뜰배달&apos;&#13;&#10;ELSEIF [svc_gubun] = &apos;포장&apos; then &apos;포장&apos;&#13;&#10;ELSE &apos;ETC&apos; END' />
            </column>
            <column caption='쿠폰사용수' datatype='integer' name='[cupn_cnt]' role='measure' type='quantitative' />
            <column caption='중분류' datatype='string' name='[division1]' role='dimension' type='nominal' />
            <column caption='일자' datatype='date' name='[dt]' role='dimension' type='ordinal' />
            <column datatype='string' name='[mkt_yn]' role='dimension' type='nominal' />
            <column-instance column='[division1]' derivation='None' name='[none:division1:nk]' pivot='key' type='nominal' />
