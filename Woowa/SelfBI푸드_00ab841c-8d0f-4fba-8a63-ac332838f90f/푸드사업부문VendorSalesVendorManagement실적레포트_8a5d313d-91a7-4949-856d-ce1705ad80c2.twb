      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;South Korea&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column caption='p_지역' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;전체&quot;'>
          <calculation class='tableau' formula='&quot;전체&quot;' />
          <aliases>
            <alias key='&quot;경인&quot;' value='경기/인천' />
          </aliases>
        </column>
        <column alias='월' caption='p_monthly_weekly' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;monthly&quot;'>
          <calculation class='tableau' formula='&quot;monthly&quot;' />
          <aliases>
            <alias key='&quot;monthly&quot;' value='월' />
            <alias key='&quot;weekly&quot;' value='주' />
          </aliases>
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_52FB3873AFC94506A9BA552A9F3AD9BC'>
            <properties context=''>
              <relation connection='athena.0vtoik50kql9qk1edx5bg1gfadt0' name='Custom SQL Query' type='text'>with cpe_t as (
    select
        date_cd,
        rgn_gubun,
        sum(cpe_owner) as cpe_owner,
        sum(bmonly_owner) as bmonly_owner,
        sum(cpeonly_owner) as cpeonly_owner,
        sum(bmonly_od_owner) as bmonly_od_owner,
        sum(cpeonly_od_owner) as cpeonly_od_owner,
        sum(case when ka_gubun = &apos;y&apos; then cpe_owner end) as ka_cpe_owner
    from vl_food.cpe_kpi_master_t
    group by 1,2
)

, base as (
    select
        t1.std_dt,
        cast(t1.std_dt as date) as std_date,        
        t1.region,
        sum(t1.total_plat_owner) as total_plat_owner,
        sum(t1.new_re_plat_owner) as new_re_plat_owner,
        sum(t1.exit_plat_owner) as exit_plat_owner,
		max(t2.cpe_owner) as cpe_owner --cpe 업주수      
    from vl_food.owner_kpi_master_t t1
    	left join cpe_t t2 on t1.std_dt = t2.date_cd and t2.rgn_gubun = t1.region
    group by 1,2,3
)

, flagged as (
    select
        *,
        case when std_date = last_day_of_month(std_date) then &apos;monthly&apos;
             when day_of_week(std_date) = 7 then &apos;weekly&apos;
             else null
        end as flag,
        month(cast(std_dt as date)) as this_month
    from base
    where
        cast(std_dt as date) = last_day_of_month(cast(std_dt as date))
        or day_of_week(cast(std_dt as date)) = 7
)

, lagged as (
    select
        *,
        lag(std_dt) over (partition by region, flag order by std_date) as prev_dt,
        lag(total_plat_owner) over (partition by region, flag order by std_date) as prev_total_plat_owner,
        lag(new_re_plat_owner) over (partition by region, flag order by std_date) as prev_new_re_plat_owner,
        lag(exit_plat_owner) over (partition by region, flag order by std_date) as prev_exit_plat_owner,
        lag(cpe_owner) over (partition by region, flag order by std_date) as prev_cpe_owner,
        lag(this_month) over (partition by region, flag order by std_date) as prev_month
    from flagged
)

, month_end_base as (
    select
        region,
        std_dt,
        total_plat_owner as month_end_total_plat_owner,
        new_re_plat_owner as month_end_new_re_plat_owner,
        exit_plat_owner as month_end_exit_plat_owner,
        cpe_owner as month_end_cpe_owner,        
        cast(std_dt as date) as std_date
    from base
    where cast(std_dt as date) = last_day_of_month(cast(std_dt as date))
)

, last_month_max_dt as (
    select
        max(std_dt) as last_dt
    from base
    where std_dt &gt;&gt;= cast(date_trunc(&apos;month&apos;, date_add(&apos;month&apos;, -1, (select max(std_date) from base))) as varchar)
)

select
    l.std_dt,
    l.region,
    l.flag,
    l.prev_dt,
    
    l.total_plat_owner,
    l.new_re_plat_owner,
	l.exit_plat_owner,
	l.cpe_owner,
    
    l.prev_total_plat_owner,
    l.prev_new_re_plat_owner,
    l.prev_exit_plat_owner,
    l.prev_cpe_owner,
    
    case
        -- 마지막달의 monthly diff: 월말이면 전달 말일, 아니면 전달 동일일자와 비교
        when l.flag = &apos;monthly&apos; and l.std_dt = (select last_dt from last_month_max_dt) then
            l.total_plat_owner -
            coalesce((
                select max(t2.total_plat_owner)
                from base t2
                where t2.region = l.region
                  and t2.std_dt = (
                        case when cast(l.std_dt as date) = last_day_of_month(cast(l.std_dt as date))
                             then cast(last_day_of_month(date_add(&apos;month&apos;, -1, l.std_date)) as varchar)
                             else cast(date_add(&apos;month&apos;, -1, l.std_date) as varchar)
                        end
                    )
            ), 0)
        -- 이전달 monthly diff는 기존 방식(전달 월말과 비교)
        when l.flag = &apos;monthly&apos; then l.total_plat_owner - coalesce(l.prev_total_plat_owner, 0)
        -- weekly: 전주와 월이 다르면 전월 말일 데이터 더해서 diff
        when l.flag = &apos;weekly&apos; and l.this_month != l.prev_month then
            l.total_plat_owner -
            coalesce(l.prev_total_plat_owner, 0) +
            coalesce((
                select max(m.month_end_total_plat_owner)
                from month_end_base m
                where m.region = l.region
                  and m.std_date = last_day_of_month(date_add(&apos;month&apos;, -1, l.std_date))
            ), 0)
        -- weekly: 전주와 월이 같으면 일반 diff
        when l.flag = &apos;weekly&apos; then l.total_plat_owner - coalesce(l.prev_total_plat_owner, 0)
        else null
    end as total_plat_owner_diff,
    
    case
        -- 마지막달의 monthly diff: 월말이면 전달 말일, 아니면 전달 동일일자와 비교
        when l.flag = &apos;monthly&apos; and l.std_dt = (select last_dt from last_month_max_dt) then
            l.new_re_plat_owner -
            coalesce((
                select max(t2.new_re_plat_owner)
                from base t2
                where t2.region = l.region
                  and t2.std_dt = (
                        case when cast(l.std_dt as date) = last_day_of_month(cast(l.std_dt as date))
                             then cast(last_day_of_month(date_add(&apos;month&apos;, -1, l.std_date)) as varchar)
                             else cast(date_add(&apos;month&apos;, -1, l.std_date) as varchar)
                        end
                    )
            ), 0)
        -- 이전달 monthly diff는 기존 방식(전달 월말과 비교)
        when l.flag = &apos;monthly&apos; then l.new_re_plat_owner - coalesce(l.prev_new_re_plat_owner, 0)
        
        -- weekly: 전주와 월이 다르면 전월 말일 데이터 더해서 diff
        when l.flag = &apos;weekly&apos; and l.this_month != l.prev_month then
            l.new_re_plat_owner -
            coalesce(l.prev_new_re_plat_owner, 0) +
            coalesce((
                select max(m.month_end_new_re_plat_owner)
                from month_end_base m
                where m.region = l.region
                  and m.std_date = last_day_of_month(date_add(&apos;month&apos;, -1, l.std_date))
            ), 0)
        -- weekly: 전주와 월이 같으면 일반 diff
        when l.flag = &apos;weekly&apos; then l.new_re_plat_owner - coalesce(l.prev_new_re_plat_owner, 0)
        else null
    end as new_re_plat_owner_diff,
    
    case
        -- 마지막달의 monthly diff: 월말이면 전달 말일, 아니면 전달 동일일자와 비교
        when l.flag = &apos;monthly&apos; and l.std_dt = (select last_dt from last_month_max_dt) then
            l.exit_plat_owner -
            coalesce((
                select max(t2.exit_plat_owner)
                from base t2
                where t2.region = l.region
                  and t2.std_dt = (
                        case when cast(l.std_dt as date) = last_day_of_month(cast(l.std_dt as date))
                             then cast(last_day_of_month(date_add(&apos;month&apos;, -1, l.std_date)) as varchar)
                             else cast(date_add(&apos;month&apos;, -1, l.std_date) as varchar)
                        end
                    )
            ), 0)
        -- 이전달 monthly diff는 기존 방식(전달 월말과 비교)
        when l.flag = &apos;monthly&apos; then l.exit_plat_owner - coalesce(l.prev_exit_plat_owner, 0)
        
        -- weekly: 전주와 월이 다르면 전월 말일 데이터 더해서 diff
        when l.flag = &apos;weekly&apos; and l.this_month != l.prev_month then
            l.exit_plat_owner -
            coalesce(l.prev_exit_plat_owner, 0) +
            coalesce((
                select max(m.month_end_exit_plat_owner)
                from month_end_base m
                where m.region = l.region
                  and m.std_date = last_day_of_month(date_add(&apos;month&apos;, -1, l.std_date))
            ), 0)
        -- weekly: 전주와 월이 같으면 일반 diff
        when l.flag = &apos;weekly&apos; then l.exit_plat_owner - coalesce(l.prev_exit_plat_owner, 0)
        else null
    end as exit_plat_owner_diff,    

    case
        -- 마지막달의 monthly diff: 월말이면 전달 말일, 아니면 전달 동일일자와 비교
        when l.flag = &apos;monthly&apos; and l.std_dt = (select last_dt from last_month_max_dt) then
            l.cpe_owner -
            coalesce((
                select max(t2.cpe_owner)
                from base t2
                where t2.region = l.region
                  and t2.std_dt = (
                        case when cast(l.std_dt as date) = last_day_of_month(cast(l.std_dt as date))
                             then cast(last_day_of_month(date_add(&apos;month&apos;, -1, l.std_date)) as varchar)
                             else cast(date_add(&apos;month&apos;, -1, l.std_date) as varchar)
                        end
                    )
            ), 0)
        -- 이전달 monthly diff는 기존 방식(전달 월말과 비교)
        when l.flag = &apos;monthly&apos; then l.cpe_owner - coalesce(l.prev_cpe_owner, 0)
        
        -- weekly: 전주와 월이 다르면 전월 말일 데이터 더해서 diff
        when l.flag = &apos;weekly&apos; and l.this_month != l.prev_month then
            l.cpe_owner -
            coalesce(l.prev_cpe_owner, 0) +
            coalesce((
                select max(m.month_end_cpe_owner)
                from month_end_base m
                where m.region = l.region
                  and m.std_date = last_day_of_month(date_add(&apos;month&apos;, -1, l.std_date))
            ), 0)
        -- weekly: 전주와 월이 같으면 일반 diff
        when l.flag = &apos;weekly&apos; then l.cpe_owner - coalesce(l.prev_cpe_owner, 0)
        else null
    end as cpe_owner_diff    
from lagged l
where l.flag is not null</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
