            <column caption='vs % (total_palt_owner)' datatype='real' name='[c_diff (copy)_726486943316795411]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='( sum([total_plat_owner]) - lookup(sum([total_plat_owner]), -1) ) /&#10;lookup(sum([total_plat_owner]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[flag]' role='dimension' type='nominal' />
