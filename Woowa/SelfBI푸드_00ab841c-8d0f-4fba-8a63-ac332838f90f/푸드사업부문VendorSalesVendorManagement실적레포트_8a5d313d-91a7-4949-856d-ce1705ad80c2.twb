      <table>
        <view>
          <datasources>
            <datasource caption='플랫폼업주수' name='federated.1x8b8bt156y2d41aejodk15w91zl' />
            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p_지역' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;전체&quot;'>
              <calculation class='tableau' formula='&quot;전체&quot;' />
              <aliases>
                <alias key='&quot;경인&quot;' value='경기/인천' />
              </aliases>
            </column>
            <column alias='월' caption='p_monthly_weekly' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;monthly&quot;'>
              <calculation class='tableau' formula='&quot;monthly&quot;' />
              <aliases>
                <alias key='&quot;monthly&quot;' value='월' />
                <alias key='&quot;weekly&quot;' value='주' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1x8b8bt156y2d41aejodk15w91zl'>
            <column caption='c_지역' datatype='boolean' name='[Calculation_690669253036969998]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;전체&apos; then 1=1&#10;when &apos;서울&apos; then region = &apos;서울&apos;&#10;when &apos;경인&apos; then region = &apos;경인&apos;&#10;when &apos;지방광역시&apos; then region = &apos;지방광역시&apos;&#10;when &apos;지방도시&apos; then region = &apos;지방도시&apos;&#10;end' />
            </column>
            <column caption='c_rank (total_plat_owner)' datatype='integer' name='[Calculation_690669253049778204]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='rank(sum([total_plat_owner]), &apos;desc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='c_std_dt_date' datatype='date' name='[Calculation_690669253052588061]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date([std_dt])' />
            </column>
            <column caption='period' datatype='datetime' name='[Calculation_690669253197705263]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 2]&#10;when &apos;monthly&apos; then datetrunc(&apos;month&apos;, [Calculation_690669253052588061])&#10;when &apos;weekly&apos; then datetrunc(&apos;week&apos;,[Calculation_690669253052588061])&#10;end' />
            </column>
            <column caption='latest_period_start_date' datatype='datetime' name='[Calculation_690669253198131248]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 2]&#10;when &apos;monthly&apos; then datetrunc(&apos;month&apos;,{max([Calculation_690669253052588061])})&#10;when &apos;weekly&apos; then datetrunc(&apos;week&apos;, {max([Calculation_690669253052588061])})&#10;end' />
            </column>
            <column caption='filter lastest 12 periods' datatype='boolean' name='[Calculation_690669253198450737]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &apos;monthly&apos; THEN&#10;    DATEDIFF(&apos;month&apos;, [Calculation_690669253197705263], [Calculation_690669253198131248]) &lt; 12&#10;    AND DATEDIFF(&apos;month&apos;, [Calculation_690669253197705263], [Calculation_690669253198131248]) &gt;= 0&#10;ELSE&#10;    DATEDIFF(&apos;week&apos;, [Calculation_690669253197705263], [Calculation_690669253198131248]) &lt; 12&#10;    AND DATEDIFF(&apos;week&apos;, [Calculation_690669253197705263], [Calculation_690669253198131248]) &gt;= 0&#10;END' />
            </column>
            <column caption='c_std_dt' datatype='string' name='[Calculation_726486943105159168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 2]&#10;when &apos;monthly&apos; then mid([std_dt],3,2)+&apos;.&apos;+ str(month(date([std_dt])))+&apos;월&apos;&#10;when &apos;weekly&apos; then &#10;&#10;(if week(date([std_dt])) - week(datetrunc(&apos;month&apos;,date([std_dt]))) = 0 then str(month(date([std_dt]))-1)+&apos;월&apos; + &apos;5주&apos;&#10; else str(month(date([std_dt])))+&apos;월&apos; + str(week(date([std_dt])) - week(datetrunc(&apos;month&apos;,date([std_dt]))))+&apos;주&apos;&#10; end)&#10;end' />
            </column>
            <column caption='c_monthly_weekly_t|f' datatype='boolean' name='[Calculation_726486943767527457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 2] = [flag]' />
            </column>
            <column-instance column='[std_dt]' derivation='Attribute' name='[attr:std_dt:nk]' pivot='key' type='nominal' />
            <column caption='c_exit_plat_owner' datatype='integer' name='[c_new_re_plat_owner (copy)_690669253011570689]' role='measure' type='quantitative'>
