    <relation connection='athena.0bxxo8g12vray117f4skf03cmpfc' name='사용자 지정 SQL 쿼리' type='text'>--2. 지역별 주문수&#13;&#10;with d_week as &#13;&#10;(  select b.date_cd                                                         as base_dt&#13;&#10;        , concat(a.month_nm, &apos; &apos;,cast(a.month_week_row as varchar),&apos;주차&apos;)  as week_nm&#13;&#10;     from (&#13;&#10;            select row_number () over (partition by monthstart_dt order by date_cd) as month_week_row&#13;&#10;                 , year_nm&#13;&#10;                 , month_nm  &#13;&#10;                 , weekstart_dt&#13;&#10;              from sbbi.dim_date_cd&#13;&#10;             where week_nm = &apos;목&apos;&#13;&#10;         ) a&#13;&#10;    join sbbi.dim_date_cd b on a.weekstart_dt = b.weekstart_dt&#13;&#10;) &#13;&#10;, d_food as&#13;&#10;(&#13;&#10;    select t1.base_dt&#13;&#10;         , d2.week_nm&#13;&#10;         , d1.rgn_area_cat&#13;&#10;         , sum(t1.ord_cnt)      as ord_cnt&#13;&#10;         , sum(case when substring(t1.svc_cd,1,9) = &apos;S01010102&apos; then t1.ord_cnt else 0 end) as bm1_ord&#13;&#10;      from cl_food.order_dd_fact  t1&#13;&#10;      join cl_epm.region_area_dim d1 on substring(t1.deliv_rgn3_cd,1,2) = d1.rgn1_cd&#13;&#10; left join d_week                 d2 on t1.base_dt = d2.base_dt&#13;&#10;     where t1.base_dt &gt;&gt;= &apos;2022-01-01&apos;&#13;&#10;  group by 1, 2, 3&#13;&#10;)&#13;&#10;    select &apos;D&apos;              as std_cd&#13;&#10;         , date(base_dt)    as base_dt&#13;&#10;         , week_nm          as week_nm&#13;&#10;         , rgn_area_cat     as rgn_area_cat&#13;&#10;         , sum(ord_cnt)     as ord_cnt          --푸드주문수&#13;&#10;         , sum(bm1_ord)     as bm1_ord          --배민1_주문수&#13;&#10;      from d_food&#13;&#10;  group by 2, 3, 4&#13;&#10;&#13;&#10; union all&#13;&#10;    select &apos;W&apos;              as std_cd&#13;&#10;         , date_trunc(&apos;week&apos;, date(base_dt))      as base_dt&#13;&#10;         , week_nm           as week_nm&#13;&#10;         , rgn_area_cat      as rgn_area_cat&#13;&#10;         , sum(ord_cnt)      as ord_cnt          --푸드주문수&#13;&#10;         , sum(bm1_ord)      as bm1_ord          --배민1_주문수&#13;&#10;      from d_food&#13;&#10;  group by 2, 3, 4&#13;&#10; &#13;&#10; union all&#13;&#10;    select &apos;M&apos;              as std_cd&#13;&#10;         , date_trunc(&apos;month&apos;, date(base_dt))      as base_dt&#13;&#10;         , week_nm           as week_nm&#13;&#10;         , rgn_area_cat      as rgn_area_cat&#13;&#10;         , sum(ord_cnt)      as ord_cnt          --푸드주문수&#13;&#10;         , sum(bm1_ord)      as bm1_ord          --배민1_주문수&#13;&#10;      from d_food&#13;&#10;  group by 2, 3, 4</relation>
