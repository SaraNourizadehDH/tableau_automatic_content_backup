              <calculation class='tableau' formula='sum(If [주차구분]=&apos;5주전&apos; and ([CPE구분]=&quot;CPEONLY&quot; or [CPE구분]=&quot;배민&amp;CPE&quot;&#13;&#10;   or [CPE구분]=&quot;배민1+배민&amp;CPE&quot;&#13;&#10;   or [CPE구분]=&quot;포장&amp;CPE&quot;&#13;&#10;   or [CPE구분]=&quot;배민1&amp;CPE&quot; ) then [업주수] else 0 END)' />
