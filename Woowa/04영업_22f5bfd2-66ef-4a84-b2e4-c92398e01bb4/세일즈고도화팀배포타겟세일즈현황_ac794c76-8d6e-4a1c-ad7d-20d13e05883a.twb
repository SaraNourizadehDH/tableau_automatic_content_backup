            <column caption='팀' datatype='string' name='[Calculation_130041474548473856]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [부서]=&quot;가게경쟁력팀&quot; then &quot;가게경쟁력팀&quot;&#13;&#10;elseif [디비전]=&quot;경인협력사운영파트&quot; or [디비전]=&quot;서울협력사운영파트&quot;&#13;&#10;then &quot;수도권영업팀&quot;&#13;&#10;elseif [디비전]=&quot;중부협력사운영파트&quot; or [디비전]=&quot;영남협력사운영파트&quot;&#13;&#10;then &quot;지방영업팀&quot;&#13;&#10;else [디비전] END' />
            </column>
            <column caption='컨택여부_yn' datatype='string' name='[Calculation_1386827243472556032]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if (str([1차 시도날짜])&lt;&gt;&quot;&quot; or STR([(최신) 컨택일])&lt;&gt;&quot;&quot;) then &quot;Y&quot; else &quot;N&quot; END' />
            </column>
            <column caption='성공여부_yn' datatype='string' name='[Calculation_1386827243476570113]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1386827243472556032]=&quot;Y&quot; and ([미션 상태]= &quot;세일즈 성공(계약서 작성)&quot; or &#13;&#10;([미션 상태]= &quot;실적 달성&quot; and [(시스템용)세일즈 성공]=true&#13;&#10;)) then &quot;Y&quot; else &quot;N&quot; END' />
            </column>
            <column caption='채널구분' datatype='string' name='[Calculation_1386827243543834626]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [레코드 유형 ID]=&quot;0125j000001NIAxAAO&quot; then &quot;DSM&quot; &#13;&#10;elseif  [레코드 유형 ID]=&quot;0125j000001NIAyAAO&quot; then &quot;OS&quot; else &quot;직영&quot; END' />
