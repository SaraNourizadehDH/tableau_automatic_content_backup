      <column caption='컨택완료 중 유효여부' datatype='string' name='[컨택여부(복사본)_426997594586136599]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [1차 시도날짜(복사본)_426997594582515730]&lt;&gt;&quot;&quot; AND [유효 여부]=&quot;유효&quot; then &quot;유효&quot; &#13;&#10;elseIF [1차 시도날짜(복사본)_426997594582515730]&lt;&gt;&quot;&quot; AND [유효 여부]=&quot;비유효&quot; THEN &quot;비유효&quot; END' />
