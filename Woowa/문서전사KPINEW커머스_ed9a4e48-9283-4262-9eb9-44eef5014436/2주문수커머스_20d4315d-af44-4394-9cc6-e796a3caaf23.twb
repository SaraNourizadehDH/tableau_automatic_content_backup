              <calculation class='tableau' formula='IF [Calculation_4356669722024435810] = &apos;배달커머스&apos; THEN [comm_svc_nm]&#13;&#10;ELSEIF [Calculation_4356669722024435810] = &apos;기타커머스&apos; THEN [comm_svc_nm]&#13;&#10;ELSEIF [Calculation_4356669722024435810] = &apos;B2B커머스&apos; THEN [comm_svc_nm]&#13;&#10;/*B2B*/&#13;&#10;ELSEIF [Calculation_4356669722024435810] = &apos;B2B 커머스&apos; THEN  [comm_svc_nm]&#13;&#10;ELSE &apos; &apos;&#13;&#10;END' />
