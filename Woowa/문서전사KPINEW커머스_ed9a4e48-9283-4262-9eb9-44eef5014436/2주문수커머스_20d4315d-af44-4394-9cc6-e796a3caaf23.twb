              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR(DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2 1 1]))&#13;&#10;    AND MONTH([base_dt]) = MONTH(DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2 1 1]))&#13;&#10;    AND DAY([base_dt]) &lt;= DAY([Parameters].[매개 변수 2 1 1])&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2 1 1])))&#13;&#10;    AND [base_dt] &lt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2 1 1]))&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = DATETRUNC(&apos;day&apos;, DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2 1 1]))&#13;&#10;&#13;&#10;&#13;&#10;END' />
