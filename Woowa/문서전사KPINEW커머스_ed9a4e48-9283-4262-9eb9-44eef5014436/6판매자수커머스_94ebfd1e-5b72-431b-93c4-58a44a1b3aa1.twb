      <column caption='F_당기_조회기간' datatype='boolean' name='[Calculation_1519401947912773634]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([Calculation_1519401947913138181]) = YEAR([Parameters].[매개 변수 2])&#13;&#10;    AND MONTH([Calculation_1519401947913138181]) = MONTH([Parameters].[매개 변수 2])&#13;&#10;    AND DAY([Calculation_1519401947913138181]) &lt;= DAY([Parameters].[매개 변수 2])&#13;&#10;    AND [base_dt_type] = &apos;M&apos;&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [Calculation_1519401947913138181] &gt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])&#13;&#10;    AND [Calculation_1519401947913138181] &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])&#13;&#10;    AND [base_dt_type] = &apos;W&apos;&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [Calculation_1519401947913138181] = [Parameters].[매개 변수 2]&#13;&#10;    AND [base_dt_type] = &apos;D&apos;&#13;&#10;&#13;&#10;END' />
