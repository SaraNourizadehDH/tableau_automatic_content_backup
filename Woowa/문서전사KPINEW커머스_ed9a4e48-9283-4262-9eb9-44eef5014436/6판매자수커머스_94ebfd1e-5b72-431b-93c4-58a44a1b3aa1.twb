              <calculation class='tableau' formula='AVG(&#13;&#10;IF [Calculation_1519401947912871940]&#13;&#10;THEN [noord_seller_cnt]&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;AVG(&#13;&#10;IF [Calculation_1519401947912871940]&#13;&#10;THEN [ad_active_seller_cnt]&#13;&#10;END&#13;&#10;)' />
