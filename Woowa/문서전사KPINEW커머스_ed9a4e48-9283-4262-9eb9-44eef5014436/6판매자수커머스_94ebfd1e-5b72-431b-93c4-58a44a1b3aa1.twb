        <calculation class='tableau' formula='IF [comm_svc_div_lv1_nm] = &apos;커머스&apos; THEN &apos;판매자수 총계&apos;&#13;&#10;/*B2C 커머스*/&#13;&#10;ELSEIF [comm_svc_div_lv1_nm] = &apos;B2C커머스&apos; AND [comm_svc_div_lv2_nm] = &apos;기타커머스&apos;&#13;&#10;        THEN&#13;&#10;        IF ([comm_svc_div_lv2_nm] = &apos;기타커머스&apos; AND [comm_svc_nm] != &apos;커머스&apos;)&#13;&#10;        THEN &apos;기타커머스&apos;&#13;&#10;        ELSE &apos;B2C 커머스&apos;&#13;&#10;        END&#13;&#10;ELSEIF [comm_svc_div_lv1_nm] = &apos;B2C커머스&apos; AND [comm_svc_div_lv2_nm] = &apos;배달커머스&apos;&#13;&#10;        THEN&#13;&#10;        IF ([comm_svc_div_lv2_nm] = &apos;배달커머스&apos; AND [comm_svc_nm] != &apos;커머스&apos;)&#13;&#10;        THEN &apos;배달커머스&apos;&#13;&#10;        ELSE &apos;B2C 커머스&apos;&#13;&#10;        END&#13;&#10;/*B2B 커머스, comm_svc_nm이 &apos;커머스&apos;인 항목 화면에서 Null 필터링 */&#13;&#10;ELSEIF [comm_svc_div_lv1_nm] = &apos;B2B커머스&apos; AND [comm_svc_div_lv2_nm] = &apos;B2B커머스&apos;&#13;&#10;        THEN&#13;&#10;        IF [comm_svc_nm] != &apos;커머스&apos;&#13;&#10;        THEN &apos;B2B 커머스&apos;&#13;&#10;        END&#13;&#10;END' />
      </column>
      <column caption='C_date' datatype='string' name='[Calculation_959829705840447488]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if &#13;&#10;[Parameters].[매개 변수 1] = &apos;일별&apos; THEN IF [Calculation_1519401947912773634] then &apos;기준일&apos;&#13;&#10;                            ELSEIF  [Calculation_1519401947912871940] then &apos;전주동기&apos;&#13;&#10;                            ELSEIF  [Calculation_1519401947912835075] then &apos;전년동기&apos;&#13;&#10;                            END&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;[Parameters].[매개 변수 1] = &apos;주별&apos; THEN IF [Calculation_1519401947912773634] then &apos;이번주&apos;&#13;&#10;                            ELSEIF  [Calculation_1519401947912871940] then &apos;전주동기&apos;&#13;&#10;                            ELSEIF  [Calculation_1519401947912835075] then &apos;전년동기&apos;&#13;&#10;                            END&#13;&#10;ELSEIF &#13;&#10;[Parameters].[매개 변수 1] = &apos;월별&apos; THEN IF [Calculation_1519401947912773634] then &apos;이번달&apos;&#13;&#10;                            ELSEIF  [Calculation_1519401947912871940] then &apos;전월동기&apos;&#13;&#10;                            ELSEIF  [Calculation_1519401947912835075] then &apos;전년동기&apos;&#13;&#10;                            END&#13;&#10;&#13;&#10;&#13;&#10;ELSE &apos;기타&apos;&#13;&#10;&#13;&#10;END' />
      </column>
