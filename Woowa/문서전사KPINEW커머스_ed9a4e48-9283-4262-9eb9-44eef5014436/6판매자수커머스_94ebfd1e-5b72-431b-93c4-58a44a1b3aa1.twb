            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[sqlproxy.0n0d9iw0ov8zky10c9ao21jo1wzn].[Calculation_1519401947912601601]' _.fcp.RefreshableParameterRanges.true...source-field='[sqlproxy.0n0d9iw0ov8zky10c9ao21jo1wzn].[Calculation_1519401947913138181]' caption='P_End_Date_Only' datatype='date' name='[매개 변수 2]' param-domain-type='range' role='measure' type='quantitative' value='#2024-07-03#'>
              <calculation class='tableau' formula='#2024-07-03#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0n0d9iw0ov8zky10c9ao21jo1wzn'>
            <column caption='C_DEPTH1-2(미주문 판매자수)' datatype='string' name='[C_DEPTH1-2(판매자수)(복사본)_1259600556733571075]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [comm_svc_div_lv1_nm] = &apos;커머스&apos; THEN &apos;미주문 판매자수 총계&apos;&#13;&#10;/*B2C 커머스*/&#13;&#10;ELSEIF [comm_svc_div_lv1_nm] = &apos;B2C커머스&apos; AND [comm_svc_div_lv2_nm] = &apos;기타커머스&apos;&#13;&#10;        THEN&#13;&#10;        IF ([comm_svc_div_lv2_nm] = &apos;기타커머스&apos; AND [comm_svc_nm] != &apos;커머스&apos;)&#13;&#10;        THEN &apos;기타커머스&apos;&#13;&#10;        ELSE &apos;B2C 커머스&apos;&#13;&#10;        END&#13;&#10;ELSEIF [comm_svc_div_lv1_nm] = &apos;B2C커머스&apos; AND [comm_svc_div_lv2_nm] = &apos;배달커머스&apos;&#13;&#10;        THEN&#13;&#10;        IF ([comm_svc_div_lv2_nm] = &apos;배달커머스&apos; AND [comm_svc_nm] != &apos;커머스&apos;)&#13;&#10;        THEN &apos;배달커머스&apos;&#13;&#10;        ELSE &apos;B2C 커머스&apos;&#13;&#10;        END&#13;&#10;/*B2B 커머스, comm_svc_nm이 &apos;커머스&apos;인 항목 화면에서 Null 필터링 */&#13;&#10;ELSEIF [comm_svc_div_lv1_nm] = &apos;B2B커머스&apos; AND [comm_svc_div_lv2_nm] = &apos;B2B커머스&apos;&#13;&#10;        THEN&#13;&#10;        IF [comm_svc_nm] != &apos;커머스&apos;&#13;&#10;        THEN &apos;B2B 커머스&apos;&#13;&#10;        END&#13;&#10;END' />
            </column>
            <column caption='C_DEPTH2-2(미주문 판매자수)' datatype='string' name='[C_DEPTH2-2(판매자수)(복사본)_1259600556733571073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_4356669722024435810] = &apos;배달커머스&apos; THEN [comm_svc_nm]&#13;&#10;ELSEIF [Calculation_4356669722024435810] = &apos;기타커머스&apos; THEN [comm_svc_nm]&#13;&#10;ELSEIF [Calculation_4356669722024435810] = &apos;B2B커머스&apos; THEN [comm_svc_nm]&#13;&#10;/*B2B*/&#13;&#10;ELSEIF [Calculation_4356669722024435810] = &apos;B2B 커머스&apos; THEN  [comm_svc_nm]&#13;&#10;ELSE &apos; &apos;&#13;&#10;END' />
            </column>
