              <calculation class='tableau' formula='IF [comm_svc_div_lv1_nm] = &apos;커머스&apos; THEN &apos;판매자수 총계&apos;&#13;&#10;/*B2C 커머스*/&#13;&#10;ELSEIF [comm_svc_div_lv1_nm] = &apos;B2C커머스&apos; &#13;&#10;        THEN &apos;B2C 커머스&apos;&#13;&#10;END' />
