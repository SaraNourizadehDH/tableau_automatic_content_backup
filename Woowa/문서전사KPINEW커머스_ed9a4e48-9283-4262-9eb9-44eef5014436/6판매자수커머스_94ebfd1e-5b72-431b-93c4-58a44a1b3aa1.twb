              <calculation class='tableau' formula='IF [comm_svc_div_lv1_nm] = &apos;커머스&apos; THEN &apos;판매자수 총계&apos;&#13;&#10;/*B2C 커머스*/&#13;&#10;ELSEIF [comm_svc_div_lv1_nm] = &apos;B2C커머스&apos; AND [comm_svc_div_lv2_nm] = &apos;기타커머스&apos;&#13;&#10;        THEN&#13;&#10;        IF ([comm_svc_div_lv2_nm] = &apos;기타커머스&apos; AND [comm_svc_nm] != &apos;커머스&apos;)&#13;&#10;        THEN &apos;기타커머스&apos;&#13;&#10;        ELSE &apos;B2C 커머스&apos;&#13;&#10;        END&#13;&#10;ELSEIF [comm_svc_div_lv1_nm] = &apos;B2C커머스&apos; AND [comm_svc_div_lv2_nm] = &apos;배달커머스&apos;&#13;&#10;        THEN&#13;&#10;        IF ([comm_svc_div_lv2_nm] = &apos;배달커머스&apos; AND [comm_svc_nm] != &apos;커머스&apos;)&#13;&#10;        THEN &apos;배달커머스&apos;&#13;&#10;        ELSE &apos;B2C 커머스&apos;&#13;&#10;        END&#13;&#10;/*B2B 커머스, comm_svc_nm이 &apos;커머스&apos;인 항목 화면에서 Null 필터링 */&#13;&#10;ELSEIF [comm_svc_div_lv1_nm] = &apos;B2B커머스&apos; AND [comm_svc_div_lv2_nm] = &apos;B2B커머스&apos;&#13;&#10;        THEN&#13;&#10;        IF [comm_svc_nm] != &apos;커머스&apos;&#13;&#10;        THEN &apos;B2B 커머스&apos;&#13;&#10;        END&#13;&#10;END' />
