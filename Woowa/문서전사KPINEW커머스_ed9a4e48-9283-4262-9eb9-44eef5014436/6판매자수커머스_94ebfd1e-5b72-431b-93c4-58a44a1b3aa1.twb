              <calculation class='tableau' formula='(&#13;&#10;ISNULL([C_당월_판매자수(복사본)_3305360675489116189]) AND&#13;&#10;ISNULL([C_전년동기_미주문판매자수(복사본)_3305360675491102758]) AND&#13;&#10;ISNULL([C_전년동기_판매자수(복사본)_3305360675489116185])&#13;&#10;)&#13;&#10;OR&#13;&#10;(&#13;&#10;[C_당월_판매자수(복사본)_3305360675489116189] = 0 AND&#13;&#10;[C_전년동기_미주문판매자수(복사본)_3305360675491102758] = 0 AND&#13;&#10;[C_전년동기_판매자수(복사본)_3305360675489116185] = 0&#13;&#10;)' />
