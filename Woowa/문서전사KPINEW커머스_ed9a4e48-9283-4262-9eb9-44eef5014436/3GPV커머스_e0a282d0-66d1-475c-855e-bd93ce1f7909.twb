      <column caption='C_Date' datatype='string' name='[Calculation_137922773480939520]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if &#13;&#10;[Parameters].[매개 변수 1] = &apos;일별&apos; THEN IF [Calculation_2298524691184156673] then &apos;기준일&apos;&#13;&#10;                            ELSEIF  [Calculation_2298524691184508931] then &apos;전주동기&apos;&#13;&#10;                            ELSEIF  [Calculation_2298524691184451586] then &apos;전년동기&apos;&#13;&#10;                            END&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;[Parameters].[매개 변수 1] = &apos;주별&apos; THEN IF [Calculation_2298524691184156673] then &apos;이번주&apos;&#13;&#10;                            ELSEIF  [Calculation_2298524691184508931] then &apos;전주동기&apos;&#13;&#10;                            ELSEIF  [Calculation_2298524691184451586] then &apos;전년동기&apos;&#13;&#10;                            END&#13;&#10;ELSEIF &#13;&#10;[Parameters].[매개 변수 1] = &apos;월별&apos; THEN IF [Calculation_2298524691184156673] then &apos;이번달&apos;&#13;&#10;                            ELSEIF  [Calculation_2298524691184508931] then &apos;전월동기&apos;&#13;&#10;                            ELSEIF  [Calculation_2298524691184451586] then &apos;전년동기&apos;&#13;&#10;                            END&#13;&#10;&#13;&#10;&#13;&#10;ELSE &apos;기타&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='C_od_gpv_ratio' datatype='real' name='[Calculation_1821143134318350336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([od_gpv]) / sum([gpv])' />
      </column>
      <column caption='C_pickup_gpv_ratio' datatype='real' name='[Calculation_1821143134323953667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([pickup_gpv]) / SUM([gpv])' />
      </column>
      <column caption='C_기준일' datatype='date' name='[Calculation_2298524691184066560]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY()-1' />
      </column>
      <column caption='F_당기_조회기간' datatype='boolean' name='[Calculation_2298524691184156673]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR([Parameters].[매개 변수 2])&#13;&#10;    AND MONTH([base_dt]) = MONTH([Parameters].[매개 변수 2])&#13;&#10;    AND DAY([base_dt]) &lt;= DAY([Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] &gt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])&#13;&#10;    AND [base_dt] &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = [Parameters].[매개 변수 2]&#13;&#10;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='F_전년동기_조회기간' datatype='boolean' name='[Calculation_2298524691184451586]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR(DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND MONTH([base_dt]) = MONTH(DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND DAY([base_dt]) &lt;= DAY([Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])))&#13;&#10;    AND [base_dt] &lt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = DATETRUNC(&apos;day&apos;, DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='F_전동기_조회기간' datatype='boolean' name='[Calculation_2298524691184508931]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR(DATEADD(&apos;month&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND MONTH([base_dt]) = MONTH(DATEADD(&apos;month&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND DAY([base_dt]) &lt;= DAY([Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;iso-week&apos;, -1, DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])))&#13;&#10;    AND [base_dt] &lt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;iso-week&apos;,-1, [Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = DATETRUNC(&apos;day&apos;, DATEADD(&apos;iso-week&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='C_Date_Label_당기' datatype='string' name='[Calculation_2298524691186315268]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;일별&apos; THEN &apos;기준일&apos;&#13;&#10;WHEN &apos;주별&apos; THEN &apos;이번주&apos;&#13;&#10;WHEN &apos;월별&apos; THEN &apos;이번달&apos;&#13;&#10;END' />
      </column>
      <column caption='C_Date_Label_전동기' datatype='string' name='[Calculation_2298524691186466821]' role='dimension' type='nominal'>
