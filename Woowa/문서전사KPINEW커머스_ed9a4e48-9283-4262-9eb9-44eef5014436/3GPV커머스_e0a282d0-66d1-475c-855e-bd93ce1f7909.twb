      <column caption='C_DEPTH1(건단가)' datatype='string' name='[C_DEPTH1(복사본)_4356669722040332399]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [comm_svc_div_lv1_nm] = &apos;커머스&apos; THEN &apos;커머스 건단가&apos;&#13;&#10;/*B2C 커머스*/&#13;&#10;ELSEIF [comm_svc_div_lv1_nm] = &apos;B2C커머스&apos; AND [comm_svc_div_lv2_nm] = &apos;기타커머스&apos;&#13;&#10;        THEN&#13;&#10;        IF ([comm_svc_div_lv2_nm] = &apos;기타커머스&apos; AND [comm_svc_nm] != &apos;커머스&apos;)&#13;&#10;        THEN &apos;기타커머스&apos;&#13;&#10;        ELSE &apos;B2C 커머스&apos;&#13;&#10;        END&#13;&#10;ELSEIF [comm_svc_div_lv1_nm] = &apos;B2C커머스&apos; AND [comm_svc_div_lv2_nm] = &apos;배달커머스&apos;&#13;&#10;        THEN&#13;&#10;        IF ([comm_svc_div_lv2_nm] = &apos;배달커머스&apos; AND [comm_svc_nm] != &apos;커머스&apos;)&#13;&#10;        THEN &apos;배달커머스&apos;&#13;&#10;        ELSE &apos;B2C 커머스&apos;&#13;&#10;        END&#13;&#10;/*B2B 커머스, comm_svc_nm이 &apos;커머스&apos;인 항목 화면에서 필터링 */&#13;&#10;ELSEIF [comm_svc_div_lv1_nm] = &apos;B2B커머스&apos; AND [comm_svc_div_lv2_nm] = &apos;B2B커머스&apos;&#13;&#10;        THEN&#13;&#10;        IF [comm_svc_nm] != &apos;커머스&apos;&#13;&#10;        THEN &apos;B2B 커머스&apos;&#13;&#10;        END&#13;&#10;END' />
      </column>
      <column caption='C_DEPTH2(GPV)' datatype='string' name='[C_DEPTH2(복사본)_4356669722040332400]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4356669722024435810] = &apos;배달커머스&apos; THEN [comm_svc_nm]&#13;&#10;ELSEIF [Calculation_4356669722024435810] = &apos;기타커머스&apos; THEN [comm_svc_nm]&#13;&#10;ELSEIF [Calculation_4356669722024435810] = &apos;B2B커머스&apos; THEN [comm_svc_nm]&#13;&#10;/*B2B*/&#13;&#10;ELSEIF [Calculation_4356669722024435810] = &apos;B2B 커머스&apos; THEN  [comm_svc_nm]&#13;&#10;ELSE &apos; &apos;&#13;&#10;END' />
      </column>
      <column caption='C_당기(od_gpv)_B마트(도구설명)' datatype='integer' name='[C_당기(od_gpv)_B마트(복사본)_4356669721949208581]' role='measure' type='quantitative'>
