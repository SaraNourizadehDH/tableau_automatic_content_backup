    <worksheet name='2-1_OD GPV_배달커머스_라인차트'>
      <table>
        <view>
          <datasources>
            <datasource caption='3_전사KPI_NEW_커머스_GPV' name='sqlproxy.1mcsn1w1yl8sed1cihwrg1lwysx8' />
            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='P_Date_Type' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;일별&quot;'>
              <calculation class='tableau' formula='&quot;일별&quot;' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...source-field='[sqlproxy.1mcsn1w1yl8sed1cihwrg1lwysx8].[base_dt]' caption='P_End_Date_Only' datatype='date' name='[매개 변수 2]' param-domain-type='range' role='measure' type='quantitative' value='#2024-06-30#'>
              <calculation class='tableau' formula='#2024-06-30#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.1mcsn1w1yl8sed1cihwrg1lwysx8'>
            <column caption='C_Date' datatype='string' name='[Calculation_137922773480939520]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if &#13;&#10;[Parameters].[매개 변수 1] = &apos;일별&apos; THEN IF [Calculation_2298524691184156673] then &apos;기준일&apos;&#13;&#10;                            ELSEIF  [Calculation_2298524691184508931] then &apos;전주동기&apos;&#13;&#10;                            ELSEIF  [Calculation_2298524691184451586] then &apos;전년동기&apos;&#13;&#10;                            END&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;[Parameters].[매개 변수 1] = &apos;주별&apos; THEN IF [Calculation_2298524691184156673] then &apos;이번주&apos;&#13;&#10;                            ELSEIF  [Calculation_2298524691184508931] then &apos;전주동기&apos;&#13;&#10;                            ELSEIF  [Calculation_2298524691184451586] then &apos;전년동기&apos;&#13;&#10;                            END&#13;&#10;ELSEIF &#13;&#10;[Parameters].[매개 변수 1] = &apos;월별&apos; THEN IF [Calculation_2298524691184156673] then &apos;이번달&apos;&#13;&#10;                            ELSEIF  [Calculation_2298524691184508931] then &apos;전월동기&apos;&#13;&#10;                            ELSEIF  [Calculation_2298524691184451586] then &apos;전년동기&apos;&#13;&#10;                            END&#13;&#10;&#13;&#10;&#13;&#10;ELSE &apos;기타&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='C_od_gpv_ratio' datatype='real' name='[Calculation_1821143134318350336]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([od_gpv]) / sum([gpv])' />
            </column>
            <column caption='F_당기_조회기간' datatype='boolean' name='[Calculation_2298524691184156673]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR([Parameters].[매개 변수 2])&#13;&#10;    AND MONTH([base_dt]) = MONTH([Parameters].[매개 변수 2])&#13;&#10;    AND DAY([base_dt]) &lt;= DAY([Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] &gt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])&#13;&#10;    AND [base_dt] &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = [Parameters].[매개 변수 2]&#13;&#10;&#13;&#10;&#13;&#10;END' />
