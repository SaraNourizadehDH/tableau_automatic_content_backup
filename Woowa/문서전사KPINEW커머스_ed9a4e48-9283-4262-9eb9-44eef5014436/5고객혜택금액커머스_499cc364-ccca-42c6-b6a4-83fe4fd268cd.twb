              <calculation class='tableau' formula='AVG(&#13;&#10;IF [Calculation_3851985076381909009]&#13;&#10;THEN [benefit_ord_cnt]&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;AVG(&#13;&#10;IF [Calculation_3851985076381909009]&#13;&#10;THEN [ord_cnt]&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='C_Date' datatype='string' name='[Calculation_137922773480939520]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if &#13;&#10;[Parameters].[매개 변수 1] = &apos;일별&apos; THEN IF [Calculation_3851985076381884432] then &apos;기준일&apos;&#13;&#10;                            ELSEIF  [Calculation_3851985076381966354] then &apos;전주동기&apos;&#13;&#10;                            ELSEIF  [Calculation_3851985076381909009] then &apos;전년동기&apos;&#13;&#10;                            END&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;[Parameters].[매개 변수 1] = &apos;주별&apos; THEN IF [Calculation_3851985076381884432] then &apos;이번주&apos;&#13;&#10;                            ELSEIF  [Calculation_3851985076381966354] then &apos;전주동기&apos;&#13;&#10;                            ELSEIF  [Calculation_3851985076381909009] then &apos;전년동기&apos;&#13;&#10;                            END&#13;&#10;ELSEIF &#13;&#10;[Parameters].[매개 변수 1] = &apos;월별&apos; THEN IF [Calculation_3851985076381884432] then &apos;이번달&apos;&#13;&#10;                            ELSEIF  [Calculation_3851985076381966354] then &apos;전월동기&apos;&#13;&#10;                            ELSEIF  [Calculation_3851985076381909009] then &apos;전년동기&apos;&#13;&#10;                            END&#13;&#10;&#13;&#10;&#13;&#10;ELSE &apos;기타&apos;&#13;&#10;&#13;&#10;END' />
