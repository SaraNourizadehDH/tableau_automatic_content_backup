            <column caption='F_당기_조회기간' datatype='boolean' name='[Calculation_3851985076381884432]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR([Parameters].[매개 변수 2])&#13;&#10;    AND MONTH([base_dt]) = MONTH([Parameters].[매개 변수 2])&#13;&#10;    AND DAY([base_dt]) &lt;= DAY([Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] &gt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])&#13;&#10;    AND [base_dt] &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = [Parameters].[매개 변수 2]&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='F_전년동기_조회기간' datatype='boolean' name='[Calculation_3851985076381909009]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR(DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND MONTH([base_dt]) = MONTH(DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND DAY([base_dt]) &lt;= DAY([Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])))&#13;&#10;    AND [base_dt] &lt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = DATETRUNC(&apos;day&apos;, DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='F_전동기_조회기간' datatype='boolean' name='[Calculation_3851985076381966354]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR(DATEADD(&apos;month&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND MONTH([base_dt]) = MONTH(DATEADD(&apos;month&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND DAY([base_dt]) &lt;= DAY([Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;iso-week&apos;, -1, DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])))&#13;&#10;    AND [base_dt] &lt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;iso-week&apos;,-1, [Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = DATETRUNC(&apos;day&apos;, DATEADD(&apos;iso-week&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='C_DEPTH1(고객혜택적용주문수)' datatype='string' name='[Calculation_4748201415254388736]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [comm_svc_div_lv1_nm] = &apos;커머스&apos; THEN &apos;커머스&apos;&#13;&#10;/*B2C 커머스*/&#13;&#10;ELSEIF [comm_svc_div_lv1_nm] = &apos;B2C커머스&apos; AND [comm_svc_div_lv2_nm] = &apos;기타커머스&apos;&#13;&#10;        THEN&#13;&#10;        IF ([comm_svc_div_lv2_nm] = &apos;기타커머스&apos; AND [comm_svc_nm] != &apos;커머스&apos;)&#13;&#10;        THEN &apos;기타커머스&apos;&#13;&#10;        ELSE &apos;B2C 커머스&apos;&#13;&#10;        END&#13;&#10;ELSEIF [comm_svc_div_lv1_nm] = &apos;B2C커머스&apos; AND [comm_svc_div_lv2_nm] = &apos;배달커머스&apos;&#13;&#10;        THEN&#13;&#10;        IF ([comm_svc_div_lv2_nm] = &apos;배달커머스&apos; AND [comm_svc_nm] != &apos;커머스&apos;)&#13;&#10;        THEN &apos;배달커머스&apos;&#13;&#10;        ELSE &apos;B2C 커머스&apos;&#13;&#10;        END&#13;&#10;/*B2B 커머스, comm_svc_nm이 &apos;커머스&apos;인 항목 화면에서 필터링 */&#13;&#10;ELSEIF [comm_svc_div_lv1_nm] = &apos;B2B커머스&apos; AND [comm_svc_div_lv2_nm] = &apos;B2B커머스&apos;&#13;&#10;        THEN&#13;&#10;        IF [comm_svc_nm] != &apos;커머스&apos;&#13;&#10;        THEN &apos;B2B 커머스&apos;&#13;&#10;        END&#13;&#10;END' />
            </column>
            <column caption='C_DEPTH2(고객혜택적용주문수)' datatype='string' name='[Calculation_4748201415254499330]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_4748201415254388736] = &apos;배달커머스&apos; THEN [comm_svc_nm]&#13;&#10;ELSEIF [Calculation_4748201415254388736] = &apos;기타커머스&apos; THEN [comm_svc_nm]&#13;&#10;ELSEIF [Calculation_4748201415254388736] = &apos;B2B커머스&apos; THEN [comm_svc_nm]&#13;&#10;/*B2B*/&#13;&#10;ELSEIF [Calculation_4748201415254388736] = &apos;B2B 커머스&apos; THEN  [comm_svc_nm]&#13;&#10;ELSE &apos; &apos;&#13;&#10;END' />
            </column>
            <column aggregation='Year' datatype='date' default-type='ordinal' layered='true' name='[base_dt]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[benefit_ord_cnt]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[comm_svc_div_lv1_nm]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[comm_svc_div_lv2_nm]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[comm_svc_nm]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column-instance column='[Calculation_4748201415254388736]' derivation='None' name='[none:Calculation_4748201415254388736:nk]' pivot='key' type='nominal' />
