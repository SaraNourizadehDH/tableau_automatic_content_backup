      <column caption='C_전년동기' datatype='real' name='[C_전동기(복사본)_2494994229530484749]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({fixed [subject]: SUM(IF [C_전동기조건(복사본)_2494994229529309196] then [value] END)})' />
      </column>
      <column caption='C_전년동기조건' datatype='boolean' name='[C_전동기조건(복사본)_2494994229529309196]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR(DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND MONTH([base_dt]) = MONTH(DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND DAY([base_dt]) = 1&#13;&#10;    AND [base_dt_type] = &apos;M&apos;&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] = DATETRUNC(&apos;day&apos;, DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2])))&#13;&#10;    AND [base_dt_type] = &apos;W&apos;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = DATETRUNC(&apos;day&apos;, DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND [base_dt_type] = &apos;D&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='C_전년대비값' datatype='real' name='[C_전주대비값(복사본)_2494994229530677262]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_2494994229508874240]-[C_전동기(복사본)_2494994229530484749])/[C_전동기(복사본)_2494994229530484749]' />
      </column>
      <column caption='C_증감color_전년' datatype='string' name='[C_증감color(복사본)_2494994229530763279]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MIN([subject]) = &apos;쿠폰사용금액&apos;&#13;&#10;THEN (IF [C_전주대비값(복사본)_2494994229530677262] &lt; 0 THEN &apos;B&apos; ELSE &apos;R&apos; END)&#13;&#10;&#13;&#10;ELSE (IF [C_전주대비값(복사본)_2494994229530677262] &lt; 0 THEN &apos;R&apos; ELSE &apos;B&apos; END)&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='C_증감color_전' datatype='string' name='[C_증감color_reverse(복사본)_2494994229518598150]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MIN([subject]) = &apos;쿠폰사용금액&apos;&#13;&#10;THEN (IF [Calculation_2494994229511512067] &lt; 0 THEN &apos;B&apos; ELSE &apos;R&apos; END)&#13;&#10;&#13;&#10;ELSE (IF [Calculation_2494994229511512067] &lt; 0 THEN &apos;R&apos; ELSE &apos;B&apos; END)&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='C_기준일' datatype='date' name='[Calculation_1034139099733237760]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY()-1' />
      </column>
      <column caption='F_조회기간' datatype='boolean' name='[Calculation_2308094844431867904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &quot;월별&quot;&#13;&#10;THEN DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -12, [Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;month&apos;, [base_dt])&#13;&#10;AND DATETRUNC(&apos;month&apos;, [base_dt]) &lt;= DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2])&#13;&#10;AND [base_dt_type] = &apos;M&apos;&#13;&#10;&#13;&#10;WHEN &quot;주별&quot;&#13;&#10;THEN DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;week&apos;, -11, [Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;iso-week&apos;, [base_dt])&#13;&#10;AND DATETRUNC(&apos;iso-week&apos;, [base_dt]) &lt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])&#13;&#10;AND [base_dt_type] = &apos;W&apos;&#13;&#10;&#13;&#10;WHEN &quot;일별&quot;&#13;&#10;THEN DATETRUNC(&apos;day&apos;, DATEADD(&apos;day&apos;, -13, [Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;day&apos;, [base_dt])&#13;&#10;AND DATETRUNC(&apos;day&apos;, [base_dt]) &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])&#13;&#10;AND [base_dt_type] = &apos;D&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='C_날짜' datatype='string' name='[Calculation_2308094844436115457]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN &quot;&apos;&quot;+RIGHT(STR(YEAR([base_dt])),2)+&apos;.&apos;+STR(MONTH([base_dt]))&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN STR(MONTH([base_dt]))+&apos;/&apos;+STR(DAY([base_dt]))&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN STR(MONTH([base_dt]))+&apos;/&apos;+STR(DAY([base_dt]))&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='C_당기' datatype='real' name='[Calculation_2494994229508874240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({fixed [subject]: SUM(IF [Calculation_2494994229514571781] then [value] END)})' />
