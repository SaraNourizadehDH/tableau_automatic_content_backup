      <column caption='C_전동기조건' datatype='boolean' name='[Calculation_2494994229509238785]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR(DATEADD(&apos;month&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND MONTH([base_dt]) = MONTH(DATEADD(&apos;month&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND DAY([base_dt]) = 1&#13;&#10;    AND [base_dt_type] = &apos;M&apos;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] = DATETRUNC(&apos;day&apos;, DATEADD(&apos;iso-week&apos;, -1, DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])))&#13;&#10;    AND [base_dt_type] = &apos;W&apos;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = DATETRUNC(&apos;day&apos;, DATEADD(&apos;iso-week&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND [base_dt_type] = &apos;D&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='C_전동기' datatype='real' name='[Calculation_2494994229510877186]' role='measure' type='quantitative'>
