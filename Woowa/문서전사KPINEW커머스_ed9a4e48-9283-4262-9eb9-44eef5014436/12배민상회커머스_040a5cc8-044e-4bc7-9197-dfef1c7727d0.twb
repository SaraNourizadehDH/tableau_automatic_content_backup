      <column caption='C_전주대비값' datatype='real' name='[Calculation_2494994229511512067]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_2494994229508874240]-[Calculation_2494994229510877186])/[Calculation_2494994229510877186]' />
      </column>
      <column caption='C_당기조건' datatype='boolean' name='[Calculation_2494994229514571781]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR([Parameters].[매개 변수 2])&#13;&#10;    AND MONTH([base_dt]) = MONTH([Parameters].[매개 변수 2])&#13;&#10;    AND DAY([base_dt]) = 1&#13;&#10;    AND [base_dt_type] = &apos;M&apos;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] &gt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])&#13;&#10;    AND [base_dt] &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])&#13;&#10;    AND [base_dt_type] = &apos;W&apos;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = [Parameters].[매개 변수 2]&#13;&#10;    AND [base_dt_type] = &apos;D&apos;&#13;&#10;&#13;&#10;END' />
      </column>
