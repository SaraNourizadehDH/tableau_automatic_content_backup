      <object-graph>
        <objects>
          <object caption='사용자 지정 SQL 쿼리' id='_EE66E081725B43A9A6CF80BFECF4E518'>
            <properties context=''>
              <relation connection='athena.1ch4idt1ylmsac19nngs31wuo8pe' name='사용자 지정 SQL 쿼리' type='text'>with base as&#10;(&#10;    select t1.*&#10;         , t2.shop_name as shop_nm&#10;         , t2.rgn1_nm&#10;         , t2.rgn2_nm&#10;         , t2.rgn3_nm&#10;         , t2.created_dt&#10;    from&#10;    (&#10;        select * &#10;        from analytics.review_recommend_ranking_score_shop_monitoring&#10;        where part_date &gt;&gt;= cast(date_add(&apos;day&apos;, -7, &lt;[Parameters].[매개 변수 1]&gt;) as varchar)&#10;        and part_date &lt;&lt;= cast(&lt;[Parameters].[매개 변수 1]&gt; as varchar)&#10;    ) t1&#10;    join&#10;    (&#10;        select shop_no, shop_name, sm.rgn1_cd, sm.rgn2_cd, sm.rgn3_cd, rgn.rgn1_nm, rgn.rgn2_nm, rgn.rgn3_nm&#10;             , cast(date(created_at + interval &apos;9&apos; hour) as varchar) as created_dt&#10;        from sbstore_mart.shop_master sm&#10;        join sbbi.dim_rgn_cd rgn&#10;        on sm.rgn3_cd = rgn.rgn3_cd&#10;    ) t2&#10;    on t1.shop_no = t2.shop_no&#10;)&#10;&#10;select * from&#10;(&#10;    select * from&#10;    (&#10;        select &apos;D&apos; as gubun&#10;             , base.part_date&#10;             , base.shop_no&#10;             , base.shop_nm&#10;             , base.rgn1_nm&#10;             , base.rgn2_nm&#10;             , base.rgn3_nm&#10;             , base.rvw_cnt&#10;             , created_dt&#10;             , date_diff(&apos;day&apos;, date(created_dt), date(base.part_date)) as diff&#10;             , base.avg_top_rvw_score as today_avg_top_rvw_score&#10;             , daily.avg_top_rvw_score as before_avg_top_rvw_score&#10;             , round( (base.avg_top_rvw_score - daily.avg_top_rvw_score) / daily.avg_top_rvw_score, 3) as top_rvw_change_ratio&#10;             , if(abs( (base.avg_top_rvw_score - daily.avg_top_rvw_score)  / daily.avg_top_rvw_score) &gt;&gt;= 0.3, 1, 0) as is_top_rvw_change_over&#10;             , base.avg_btm_rvw_score as today_avg_btm_rvw_score&#10;             , daily.avg_btm_rvw_score as before_avg_btm_rvw_score&#10;             , round( (base.avg_btm_rvw_score - daily.avg_btm_rvw_score) / daily.avg_btm_rvw_score, 3) as btm_rvw_change_ratio&#10;             , if(abs( (base.avg_btm_rvw_score - daily.avg_btm_rvw_score) / daily.avg_btm_rvw_score) &gt;&gt;= 0.3, 1, 0) as is_btm_rvw_change_over&#10;        from base&#10;        join&#10;        (&#10;            select * &#10;            from analytics.review_recommend_ranking_score_shop_monitoring&#10;            where part_date &gt;&gt; cast(date_add(&apos;day&apos;, -8, &lt;[Parameters].[매개 변수 1]&gt;) as varchar)&#10;            and part_date &lt;&lt;= cast(&lt;[Parameters].[매개 변수 1]&gt; as varchar)&#10;        ) daily&#10;        on base.shop_no = daily.shop_no and base.part_date = cast(date_add(&apos;day&apos;, 1, date(daily.part_date)) as varchar)&#10;    )&#10;    where (is_top_rvw_change_over = 1 or is_btm_rvw_change_over = 1)&#10;&#10;    union all&#10;&#10;&#10;    select * from&#10;    (&#10;        select &apos;W&apos; as gubun&#10;             , base.part_date&#10;             , base.shop_no&#10;             , base.shop_nm&#10;             , base.rgn1_nm&#10;             , base.rgn2_nm&#10;             , base.rgn3_nm&#10;             , base.rvw_cnt&#10;             , created_dt&#10;             , date_diff(&apos;day&apos;, date(created_dt), date(base.part_date)) as diff&#10;             , base.avg_top_rvw_score as today_avg_top_rvw_score&#10;             , weekly.avg_top_rvw_score as before_avg_top_rvw_score&#10;             , round( (base.avg_top_rvw_score - weekly.avg_top_rvw_score) / weekly.avg_top_rvw_score, 3) as top_rvw_change_ratio&#10;             , if(abs( (base.avg_top_rvw_score - weekly.avg_top_rvw_score) / weekly.avg_top_rvw_score) &gt;&gt;= 0.3, 1, 0) as is_top_rvw_change_over&#10;             , base.avg_btm_rvw_score as today_avg_btm_rvw_score&#10;             , weekly.avg_btm_rvw_score as before_avg_btm_rvw_score&#10;             , round( (base.avg_btm_rvw_score - weekly.avg_btm_rvw_score) / weekly.avg_btm_rvw_score, 3) as btm_rvw_change_ratio&#10;             , if(abs( (base.avg_btm_rvw_score - weekly.avg_btm_rvw_score) / weekly.avg_btm_rvw_score) &gt;&gt;= 0.3, 1, 0) as is_btm_rvw_change_over&#10;        from base&#10;        join&#10;        (&#10;            select * &#10;            from analytics.review_recommend_ranking_score_shop_monitoring&#10;            where part_date &gt;&gt; cast(date_add(&apos;day&apos;, -15, &lt;[Parameters].[매개 변수 1]&gt;) as varchar)&#10;            and part_date &lt;&lt;= cast(date_add(&apos;day&apos;, -7, &lt;[Parameters].[매개 변수 1]&gt;) as varchar)&#10;        ) weekly&#10;        on base.shop_no = weekly.shop_no and base.part_date = cast(date_add(&apos;day&apos;, 7, date(weekly.part_date)) as varchar)&#10;    )&#10;    where (is_top_rvw_change_over = 1 or is_btm_rvw_change_over = 1)&#10;&#10;    union all&#10;&#10;    select * from&#10;    (&#10;        select &apos;M&apos; as gubun&#10;             , base.part_date&#10;             , base.shop_no&#10;             , base.shop_nm&#10;             , base.rgn1_nm&#10;             , base.rgn2_nm&#10;             , base.rgn3_nm&#10;             , base.rvw_cnt&#10;             , created_dt&#10;             , date_diff(&apos;day&apos;, date(created_dt), date(base.part_date)) as diff&#10;             , base.avg_top_rvw_score as today_avg_top_rvw_score&#10;             , monthly.avg_top_rvw_score as before_avg_top_rvw_score&#10;             , round( (base.avg_top_rvw_score - monthly.avg_top_rvw_score) / monthly.avg_top_rvw_score, 3) as top_rvw_change_ratio&#10;             , if(abs( (base.avg_top_rvw_score - monthly.avg_top_rvw_score) / monthly.avg_top_rvw_score) &gt;&gt;= 0.3, 1, 0) as is_top_rvw_change_over&#10;             , base.avg_btm_rvw_score as today_avg_btm_rvw_score&#10;             , monthly.avg_btm_rvw_score as before_avg_btm_rvw_score&#10;             , round( (base.avg_btm_rvw_score - monthly.avg_btm_rvw_score) / monthly.avg_btm_rvw_score, 3) as btm_rvw_change_ratio&#10;             , if(abs( (base.avg_btm_rvw_score - monthly.avg_btm_rvw_score) / monthly.avg_btm_rvw_score) &gt;&gt;= 0.3, 1, 0) as is_btm_rvw_change_over&#10;        from base&#10;        join&#10;        (&#10;            select * &#10;            from analytics.review_recommend_ranking_score_shop_monitoring&#10;            where part_date &gt;&gt; cast(date_add(&apos;day&apos;, -61, &lt;[Parameters].[매개 변수 1]&gt;) as varchar)&#10;            and part_date &lt;&lt;= cast(date_add(&apos;day&apos;, -30, &lt;[Parameters].[매개 변수 1]&gt;) as varchar)&#10;        ) monthly&#10;        on base.shop_no = monthly.shop_no and base.part_date = cast(date_add(&apos;day&apos;, 30, date(monthly.part_date)) as varchar)&#10;    )&#10;    where (is_top_rvw_change_over = 1 or is_btm_rvw_change_over = 1)&#10;&#10;)</relation>
            </properties>
          </object>
        </objects>
      </object-graph>
    </datasource>
  </datasources>
