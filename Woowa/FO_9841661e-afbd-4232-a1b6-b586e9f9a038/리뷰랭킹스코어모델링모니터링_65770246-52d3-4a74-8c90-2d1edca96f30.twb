      <datasource-dependencies datasource='Parameters'>
        <column caption='기준일' datatype='date' default-format='*yyyy. mm. dd' name='[매개 변수 1]' param-domain-type='any' role='measure' type='quantitative' value='#2023-04-02#'>
          <calculation class='tableau' formula='#2023-04-02#' />
