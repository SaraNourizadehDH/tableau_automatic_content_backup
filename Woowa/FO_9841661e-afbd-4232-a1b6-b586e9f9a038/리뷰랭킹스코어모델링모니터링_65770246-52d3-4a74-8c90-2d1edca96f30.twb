      <object-graph>
        <objects>
          <object caption='사용자 지정 SQL 쿼리' id='_7F0EA3C151CD42DB9809F11397FA1F40'>
            <properties context=''>
              <relation connection='athena.1lkgzuz0vkkv091ddkdk51si7sgd' name='사용자 지정 SQL 쿼리' type='text'>with base as&#10;(&#10;    select * from analytics.review_recommend_ranking_score&#10;    WHERE part_date &gt;&gt; CAST(&lt;[Parameters].[매개 변수 1]&gt; - interval &apos;7&apos; day as VARCHAR)&#10;    AND  part_date &lt;&lt;= CAST(&lt;[Parameters].[매개 변수 1]&gt; AS VARCHAR)&#10;    &#10;)&#10;&#10;, mlcs_rvwr as&#10;(&#10;    select * from analytics.review_recommend_ranking_score_mem_monitoring&#10;    where part_date &gt;&gt; CAST(&lt;[Parameters].[매개 변수 1]&gt; - interval &apos;7&apos; day as VARCHAR)&#10;    AND  part_date &lt;&lt;= CAST(&lt;[Parameters].[매개 변수 1]&gt; AS VARCHAR)&#10;    AND is_mlcs_rvwr = 1&#10;)&#10;&#10;, mlcs_agg as&#10;(&#10;    select bs.part_date&#10;         , count(distinct ml.mem_no) as mlcs_rvwr_cnt&#10;         , count(distinct bs.review_id) as mlcs_rvwr_write_rvw_cnt&#10;         , round(avg(bs.review_score), 2) as mlcs_rvwr_write_all_avg_rvw_score&#10;         , round(avg(if(bs.rating = 1, bs.review_score)), 2) as mlcs_rvwr_write_1_avg_rvw_score&#10;    from base bs&#10;    join mlcs_rvwr ml&#10;    on bs.part_date = ml.part_date and bs.mem_no = ml.mem_no&#10;    group by bs.part_date&#10;&#10;)&#10;&#10;, takedown_rvw AS&#10;(&#10;    SELECT target_id as review_id&#10;         , cast(date(created_at) as varchar) as part_date&#10;    FROM sbreview.complain a&#10;    WHERE cast(date(created_at) as varchar) &gt;&gt;  CAST(&lt;[Parameters].[매개 변수 1]&gt; - interval &apos;7&apos; day as VARCHAR)&#10;      AND cast(date(created_at) as varchar) &lt;&lt;= CAST(&lt;[Parameters].[매개 변수 1]&gt; AS VARCHAR)&#10;      AND target_type = &apos;REVIEW&apos;&#10;      AND status &lt;&lt;&gt;&gt; &apos;CANCEL&apos;&#10;)&#10;&#10;, takedown_agg as&#10;(&#10;    select bs.part_date&#10;         , count(distinct bs.review_id) as takedown_rvw_cnt&#10;         , round(avg(bs.review_score), 2) as takedown_avg_rvw_score&#10;    from base bs&#10;    join takedown_rvw td&#10;    on bs.part_date = td.part_date and bs.review_id = td.review_id&#10;    group by bs.part_date&#10;)&#10;&#10;, rating_1_rvw as&#10;(&#10;    select bs.part_date&#10;         , bs.shop_no&#10;         , bs.review_id&#10;         , bs.rating&#10;         , bs.review_text&#10;         , bs.ceo_contents&#10;         , bs.review_score&#10;    from base bs&#10;    join&#10;    (&#10;        select part_date&#10;             , shop_no&#10;             , high_score_rvw_list&#10;             , json_extract_scalar(cast(k as json), &apos;$.Review_Id&apos;) as review_id&#10;             , json_extract_scalar(cast(k as json), &apos;$.Ranking&apos;) as ranking&#10;        from analytics.review_recommend_ranking_score_shop_monitoring&#10;        cross join unnest(high_score_rvw_list) as t(k)&#10;        WHERE part_date &gt;&gt; CAST(&lt;[Parameters].[매개 변수 1]&gt; - interval &apos;7&apos; day as VARCHAR)&#10;        AND  part_date &lt;&lt;= CAST(&lt;[Parameters].[매개 변수 1]&gt; AS VARCHAR)&#10;    ) hr&#10;    on bs.shop_no = hr.shop_no and bs.review_id = hr.review_id and bs.rating = 1 and cast(ranking as int) &lt;&lt;= 30&#10;)&#10;&#10;, rating_1_agg as&#10;(&#10;    select part_date&#10;         , count(distinct shop_no) as rating_1_rvw_shop_cnt&#10;         , count(distinct review_id) as rating_1_rvw_cnt&#10;    from rating_1_rvw&#10;    group by part_date&#10;    &#10;)&#10;&#10;select bs.part_date&#10;     , coalesce(mlcs_rvwr_cnt, 0) as mlcs_rvwr_cnt&#10;     , coalesce(mlcs_rvwr_write_rvw_cnt, 0) as mlcs_rvwr_write_rvw_cnt&#10;     , coalesce(mlcs_rvwr_write_all_avg_rvw_score, 0) as mlcs_rvwr_write_all_avg_rvw_score&#10;     , coalesce(mlcs_rvwr_write_1_avg_rvw_score, 0) as mlcs_rvwr_write_1_avg_rvw_score&#10;     , coalesce(takedown_rvw_cnt, 0) as takedown_rvw_cnt&#10;     , coalesce(takedown_avg_rvw_score, 0) as takedown_avg_rvw_score&#10;     , coalesce(rating_1_rvw_shop_cnt, 0) as rating_1_rvw_shop_cnt&#10;     , coalesce(rating_1_rvw_cnt, 0) as rating_1_rvw_cnt&#10;     , coalesce(rating_1_rvw_shop_cnt, 0) * 1e0 / bs.shop_cnt as rating_1_rvw_shop_ratio&#10;from&#10;(&#10;    select part_date&#10;         , count(distinct shop_no) as shop_cnt&#10;    from base&#10;    group by part_date&#10;) bs&#10;left join mlcs_agg ml&#10;on bs.part_date = ml.part_date&#10;left join takedown_agg td&#10;on bs.part_date = td.part_date&#10;left join rating_1_agg r1&#10;on bs.part_date = r1.part_date</relation>
            </properties>
          </object>
        </objects>
      </object-graph>
    </datasource>
