      <aliases enabled='yes' />
      <column caption='리뷰 그룹' datatype='string' name='[Calculation_2596747440239525888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_top_rvw_change_over] = 1&#10;THEN &apos;상위리뷰&apos;&#10;ELSE &apos;하위리뷰&apos;&#10;END' />
      </column>
      <column aggregation='Sum' caption='rvw_cnt_condition' datatype='integer' name='[Calculation_2596747440242982914]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [rvw_cnt] &gt;= [Parameters].[매개 변수 2]&#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column aggregation='Sum' caption='shop_open_condition' datatype='integer' name='[Calculation_2596747440243617795]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [diff] &gt;= [Parameters].[매개 변수 3]&#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='지역' datatype='string' name='[Calculation_2596747440260608004]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='rgn1_nm + &quot; &quot; + rgn2_nm' />
      </column>
      <column caption='일자' datatype='string' name='[Calculation_2596747440260927493]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str([part_date])' />
      </column>
      <column aggregation='Sum' caption='누적 리뷰수' datatype='integer' name='[Calculation_2596747440261562374]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[rvw_cnt]' />
      </column>
      <column aggregation='Sum' caption='기준일 스코어' datatype='real' name='[Calculation_2596747440261775367]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [is_top_rvw_change_over] = 1&#10;THEN [today_avg_top_rvw_score]&#10;ELSE [today_avg_btm_rvw_score]&#10;END' />
      </column>
      <column aggregation='Sum' caption='이전 스코어' datatype='real' name='[Calculation_2596747440262090760]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [is_top_rvw_change_over] = 1&#10;THEN [before_avg_top_rvw_score]&#10;ELSE [before_avg_btm_rvw_score]&#10;END' />
      </column>
      <column aggregation='Sum' caption='변동비' datatype='real' default-format='p0.0%' name='[Calculation_2596747440262287369]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [is_top_rvw_change_over] = 1&#10;THEN [top_rvw_change_ratio]&#10;ELSE [btm_rvw_change_ratio]&#10;END' />
      </column>
      <column caption='가게 생성일자' datatype='string' name='[Calculation_2596747440262729738]' role='dimension' type='nominal'>
