            <column caption='배민MP(오픈리스트 제외)Take-rate' datatype='real' name='[Calculation_949415148213452802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([listing_amt])/SUM([baemin_mp_except_listing_gpv])' />
