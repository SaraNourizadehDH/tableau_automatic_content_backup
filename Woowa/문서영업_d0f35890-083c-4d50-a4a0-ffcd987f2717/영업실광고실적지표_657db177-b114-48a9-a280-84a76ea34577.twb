              <calculation class='tableau' formula='[rgn1_nm]' />
            </column>
            <column aggregation='User' caption='CTR' datatype='real' default-type='quantitative' layered='true' name='[Calculation_5228327339460685824]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='sum([click_cnt]) / sum([imp_cnt])' />
            </column>
            <column aggregation='User' caption='CVR' datatype='real' default-type='quantitative' layered='true' name='[Calculation_5228327339461611521]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='sum([ord_cnt]) / sum([click_cnt])' />
