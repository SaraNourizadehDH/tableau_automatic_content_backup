      <column caption='part_date_recent_14days' datatype='boolean' name='[Calculation_3287346290801459231]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[part_date] &gt;= (dateadd(&apos;day&apos;, -15, today()))&#10;and [part_date] &lt; today()' />
      </column>
