              <calculation class='tableau' formula='if [ad_inventory_id] in (&apos;3&apos;,&apos;4&apos;) then &apos;리스팅&apos;&#10;ELSEIF [ad_inventory_id] = &apos;1&apos; then &apos;오픈리스트&apos;&#10;ELSEIF [ad_inventory_id] = &apos;6&apos; then &apos;포장주문&apos;&#10;ELSEIF [ad_inventory_id] in (&apos;7&apos;,&apos;14&apos;) then &apos;배민1&apos;&#10;ELSE &apos;&apos;&#10;END' />
