    <worksheet name='상품별광고수'>
      <layout-options>
        <title>
          <formatted-text>
            <run>상품별 광고수</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='영업실_광고실적시트_지역별' name='sqlproxy.0usvf840s63mh4167r5qn1jj1ihg' />
            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='일별' caption='조회 기간 구분값' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;일&quot;'>
              <calculation class='tableau' formula='&quot;일&quot;' />
              <aliases>
                <alias key='&quot;월&quot;' value='월별' />
                <alias key='&quot;일&quot;' value='일별' />
                <alias key='&quot;주&quot;' value='주별' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0usvf840s63mh4167r5qn1jj1ihg'>
            <column caption='구간대비 차이 범례' datatype='string' name='[Calculation_579486646491828228]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[매개 변수 1]&#10;when &apos;일&apos; then &apos;어제&apos;&#10;when &apos;주&apos; then &apos;지난주&apos;&#10;when &apos;월&apos; then &apos;지난달&apos;&#10;END' />
            </column>
            <column caption='현재 구간 조회' datatype='boolean' name='[Calculation_579486646492631045]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;일&apos; THEN [std_cd] = &apos;D&apos;&#10;            AND DATE([part_date]) = DATEADD(&apos;day&apos;,-1,TODAY())&#10;&#10;WHEN &apos;주&apos; THEN [std_cd] = &apos;W&apos;&#10;            AND DATE([part_date]) = DATE(DATEADD(&apos;day&apos;,1,DATETRUNC(&apos;week&apos;,DATEADD(&apos;day&apos;,-1,TODAY()))))&#10;&#10;WHEN &apos;월&apos; THEN [std_cd] = &apos;M&apos;&#10;            AND DATE([part_date]) = DATE(DATETRUNC(&apos;month&apos;,DATEADD(&apos;day&apos;,-1,TODAY())))&#10;END' />
            </column>
            <column caption='광고수_현재구간값' datatype='integer' name='[Calculation_579486646493999111]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='iif([Calculation_579486646492631045], [ad_campaign_cnt], 0)' />
            </column>
            <column caption='광고수_이전구간값' datatype='integer' name='[Calculation_579486646494187528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([현재 구간 조회(복사본)_579486646493290502], [ad_campaign_cnt], 0)' />
            </column>
