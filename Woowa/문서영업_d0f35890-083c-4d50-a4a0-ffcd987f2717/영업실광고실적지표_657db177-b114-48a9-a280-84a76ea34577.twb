            <column caption='f_조회월선택(복사본)' datatype='boolean' name='[f_조회월선택(복사본)_1173821050062307328]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[매개 변수 2]&#13;&#10;when 1 then [part_date] = DATETRUNC( &apos;month&apos;, DATEADD(&apos;day&apos;,-1,TODAY()) )&#13;&#10;when 2 then [part_date] = DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,  DATEADD(&apos;day&apos;,-1,TODAY())) )&#13;&#10;when 3 then [part_date] = DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,  DATEADD(&apos;day&apos;,-1,TODAY())) )&#10;when 4 then [part_date] = DATEADD(&apos;month&apos;,-3,DATETRUNC(&apos;month&apos;,  DATEADD(&apos;day&apos;,-1,TODAY())) )&#10;when 5 then [part_date] = DATEADD(&apos;month&apos;,-4,DATETRUNC(&apos;month&apos;,  DATEADD(&apos;day&apos;,-1,TODAY())) )&#13;&#10;end' />
            </column>
