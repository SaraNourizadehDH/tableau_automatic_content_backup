          <datasource-dependencies datasource='sqlproxy.1h9ymur0spevxd16na9a31d1u0i5'>
            <column aggregation='Count' caption='협력사명 NULL 제거용' datatype='string' default-type='nominal' layered='true' name='[Calculation_1722767611427811329]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
