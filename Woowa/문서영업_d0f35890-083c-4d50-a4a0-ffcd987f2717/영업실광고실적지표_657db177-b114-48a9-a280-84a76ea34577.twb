  <column aggregation='Count' caption='f_조회월선택' datatype='boolean' default-type='nominal' name='[Calculation_202380529181937665]' pivot='key' role='dimension' type='nominal' user-datatype='boolean' visual-totals='Default'>
    <calculation class='tableau' formula='case [Parameters].[매개 변수 2]&\#13;&\#10;when 1 then [part_date] = DATETRUNC( &apos;month&apos;, DATEADD(&apos;day&apos;,-1,TODAY()) )&\#13;&\#10;when 2 then [part_date] = DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,  DATEADD(&apos;day&apos;,-1,TODAY())) )&\#13;&\#10;when 3 then [part_date] = DATEADD(&apos;month&apos;,-2,DATETRUNC(&apos;month&apos;,  DATEADD(&apos;day&apos;,-1,TODAY())) )&\#13;&\#10;end' />
  </column>
  <column aggregation='Count' caption='광고상품' datatype='string' default-type='nominal' name='[Calculation_2909677220205834241]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='if [ad_inventory_id] in (&apos;3&apos;,&apos;4&apos;) then &apos;리스팅&apos;&\#10;ELSEIF [ad_inventory_id] = &apos;1&apos; then &apos;오픈리스트&apos;&\#10;ELSEIF [ad_inventory_id] = &apos;6&apos; then &apos;포장주문&apos;&\#10;ELSEIF [ad_inventory_id] in (&apos;7&apos;,&apos;14&apos;) then &apos;배민1&apos;&\#10;ELSE &apos;&apos;&\#10;END' />
  </column>
  <column aggregation='User' caption='CTR' datatype='real' default-type='quantitative' name='[Calculation_5228327339460685824]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='sum([click_cnt]) / sum([imp_cnt])' />
  </column>
  <column aggregation='User' caption='CVR' datatype='real' default-type='quantitative' name='[Calculation_5228327339461611521]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default'>
    <calculation class='tableau' formula='sum([ord_cnt]) / sum([click_cnt])' />
  </column>
  <column aggregation='Count' caption='카테고리명' datatype='string' default-type='nominal' name='[Calculation_5228327339467894786]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
    <calculation class='tableau' formula='replace(replace([shop_category],&apos;BAEMIN_1_&apos;,&apos;&apos;),&apos;RIDERS_&apos;,&apos;&apos;)' />
