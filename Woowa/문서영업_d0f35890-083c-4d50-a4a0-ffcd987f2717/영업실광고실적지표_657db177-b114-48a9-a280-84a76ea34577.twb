          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='이번달' caption='조회월 선택' datatype='integer' name='[매개 변수 2]' param-domain-type='list' role='measure' type='quantitative' value='1'>
              <calculation class='tableau' formula='1' />
              <aliases>
                <alias key='1' value='이번달' />
                <alias key='2' value='1개월 전' />
                <alias key='3' value='2개월 전' />
