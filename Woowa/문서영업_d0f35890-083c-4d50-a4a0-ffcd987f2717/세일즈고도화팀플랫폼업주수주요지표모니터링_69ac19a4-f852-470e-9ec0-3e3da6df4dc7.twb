      <column caption='워터마크' datatype='string' name='[Calculation_1215690474359271424]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Published by 세일즈고도화팀&quot;' />
      </column>
      <column caption='channel' datatype='string' name='[Calculation_161566683476209664]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [part]=&apos;서울협력사운영파트&apos; or [part]=&apos;경인협력사운영파트&apos; &#13;&#10;   or [part]=&apos;중부협력사운영파트&apos; or [part]=&apos;영남협력사운영파트&apos; then&#13;&#10;&apos;DSM&apos; else [part] END' />
      </column>
      <column caption='현재 전체 업주수' datatype='integer' name='[Calculation_161566683477823489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [std_dt]= today()-1 then [Total_owner] else 0 END' />
      </column>
      <column caption='서울운영파트 (텍스트)' datatype='string' name='[Calculation_161566683496480782]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;서울협력사운영파트&quot;' />
      </column>
      <column caption='신규업주 목표' datatype='real' datatype-customized='true' name='[Calculation_161566683497295887]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum({fixed [monthend_dt],[dsm_name],[rgn1_nm],[rgn2_nm] : MAX([New_owner_goal])})' />
      </column>
      <column caption='기준일' datatype='date' name='[Calculation_161566683498373136]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='max([std_dt])' />
      </column>
      <column caption='전전주 대비 전주 신규 업주수 ' datatype='integer' name='[Calculation_161566683499536403]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[현재 신규 업주수(복사본)_161566683499282449]-[전주 신규 업주수(복사본)_161566683537756188]' />
      </column>
      <column caption='전주 대비 전체 업주수 비율 (채널합계)' datatype='real' name='[Calculation_384776347994607622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([전주 대비 전체 업주수(복사본)_384776347994976263])/sum([전주 전체 업주수(복사본)_384776347993960452])' />
      </column>
      <column caption='신규 달성률' datatype='real' name='[Calculation_670473441739194368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([현재 전체 업주수(복사본)_161566683486486532])/[Calculation_161566683497295887]' />
      </column>
      <column caption='리스팅 광고 이용율(전체업주)' datatype='real' name='[Calculation_670473441739698177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_LIST_owner])/sum([Total_owner])' />
      </column>
      <column caption='현재 리스팅 이용률(전체)' datatype='real' name='[Calculation_670473441741152259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [std_dt]=today()-1 then [total_LIST_owner] else 0 end) /&#13;&#10;sum(if [std_dt]=today()-1 then [Total_owner] else 0 end)' />
      </column>
      <column caption='OD 이용율(전체업주)' datatype='real' name='[Calculation_670473441744183301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [bm1_open]&lt;&gt;&quot;미오픈&quot; then [total_OD_owner] else 0 end)&#13;&#10;/ sum(if [bm1_open]&lt;&gt;&quot;미오픈&quot; then [Total_owner] else 0 end)' />
      </column>
      <column caption='한집&amp;알뜰배달 이용율(신규)' datatype='real' name='[Calculation_670473441756766217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [stod_gubun]&lt;&gt;&quot;미오픈&quot; and [OD_detail]=&quot;한집&amp;알뜰배달&quot; then [new_OD_owner] else 0 end)&#13;&#10;/ sum(if [stod_gubun]&lt;&gt;&quot;미오픈&quot; then [new_OD_owner]  else 0 end)' />
      </column>
      <column caption='한집배달 이용율(신규)' datatype='real' name='[Calculation_670473441759162379]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [OD_detail]=&quot;한집only&quot; or [OD_detail]=&quot;한집&amp;알뜰배달&quot; and [bm1_open]&lt;&gt;&quot;미오픈&quot;   then [new_OD_owner] else 0 end)&#13;&#10;/ sum(if [bm1_open]&lt;&gt;&quot;미오픈&quot; then [new_owner] else 0 end)' />
      </column>
      <column caption='유료상품이용율(신규)' datatype='real' name='[Calculation_670473441761210383]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [PAID_AD]=&quot;O&quot;  then [new_owner] else 0 end)&#13;&#10;/ sum( [new_owner])' />
      </column>
      <column caption='전국 달성률 이하 (색상)' datatype='boolean' name='[Calculation_729583187109531659]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_670473441739194368] &lt; min([신규 달성률(복사본)_729583187109240842]) then false&#13;&#10;else true end' />
      </column>
      <column caption='zoro point' datatype='spatial' name='[Calculation_729583187110264844]' role='measure' type='nominal'>
