          <datasource-dependencies datasource='federated.13gh24d1srsjsg1a5vc540ap605c'>
            <column caption='신규업주 목표' datatype='real' datatype-customized='true' name='[Calculation_161566683497295887]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum({fixed [monthend_dt],[dsm_name],[rgn1_nm],[rgn2_nm] : MAX([New_owner_goal])})' />
            </column>
            <column caption='신규 달성률' datatype='real' name='[Calculation_670473441739194368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([현재 전체 업주수(복사본)_161566683486486532])/[Calculation_161566683497295887]' />
