            <column caption='channel' datatype='string' name='[Calculation_161566683476209664]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [part]=&apos;서울협력사운영파트&apos; or [part]=&apos;경인협력사운영파트&apos; &#13;&#10;   or [part]=&apos;중부협력사운영파트&apos; or [part]=&apos;영남협력사운영파트&apos; then&#13;&#10;&apos;DSM&apos; else [part] END' />
