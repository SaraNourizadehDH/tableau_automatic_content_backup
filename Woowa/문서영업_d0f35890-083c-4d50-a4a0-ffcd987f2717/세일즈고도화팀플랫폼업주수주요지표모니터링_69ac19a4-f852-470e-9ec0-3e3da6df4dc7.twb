            <column caption='현재 OD 이용율(신규업주)' datatype='real' name='[OD 이용율(신규업주)(복사본)_729583187056836608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [std_dt]=today()-1 and [bm1_open]&lt;&gt;&quot;미오픈&quot; then [new_OD_owner] else 0 end)&#13;&#10;/ sum(if  [std_dt]=today()-1 and [bm1_open]&lt;&gt;&quot;미오픈&quot; then [new_owner] else 0 end)' />
