              <calculation class='tableau' formula='sum(if ([std_dt]=today()-1 and [stod_gubun]&lt;&gt;&quot;미오픈&quot; and [OD_detail]=&quot;알뜰only&quot;)or ([std_dt]=today()-1 and [stod_gubun]&lt;&gt;&quot;미오픈&quot; and [OD_detail]=&quot;한집&amp;알뜰배달&quot;) then [new_OD_owner] else 0 end)&#13;&#10;/ sum(if [std_dt]=today()-1 and [stod_gubun]&lt;&gt;&quot;미오픈&quot; then [new_OD_owner] else 0 end)' />
