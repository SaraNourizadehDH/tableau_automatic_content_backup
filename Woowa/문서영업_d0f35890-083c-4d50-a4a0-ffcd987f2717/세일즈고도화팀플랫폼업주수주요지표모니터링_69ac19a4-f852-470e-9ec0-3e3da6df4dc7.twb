              <calculation class='tableau' formula='sum(if  [std_dt]=today()-1 and [PAID_AD]=&quot;O&quot;  then [new_owner] else 0 end)&#13;&#10;/ sum( if [std_dt]=today()-1 then [new_owner] else 0 END)' />
            </column>
