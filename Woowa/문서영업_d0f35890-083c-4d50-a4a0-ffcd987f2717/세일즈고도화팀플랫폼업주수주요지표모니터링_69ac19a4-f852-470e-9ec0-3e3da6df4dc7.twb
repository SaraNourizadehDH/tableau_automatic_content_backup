            <column datatype='date' name='[monthend_dt]' role='dimension' type='ordinal' />
            <column caption='new LIST owner' datatype='integer' name='[new_LIST_owner]' role='measure' type='quantitative' />
            <column caption='new OD owner' datatype='integer' name='[new_OD_owner]' role='measure' type='quantitative' />
            <column caption='New Owner' datatype='integer' name='[new_owner]' role='measure' type='quantitative' />
            <column-instance column='[rgn1_nm]' derivation='None' name='[none:rgn1_nm:nk]' pivot='key' type='nominal' />
