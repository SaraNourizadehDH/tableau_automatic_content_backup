    <worksheet name='담당자별 컨택률'>
      <table>
        <view>
          <datasources>
            <datasource caption='타겟별 일일현황([태블로] KA_RAW)' name='federated.10pyl2h13pevs51c73zkt05u97jq' />
          </datasources>
          <datasource-dependencies datasource='federated.10pyl2h13pevs51c73zkt05u97jq'>
            <column caption='담당자별 최종컨택일 경과' datatype='string' name='[Calculation_1269733672873639943]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED  [키값]: today()-MAX([최종컨택일 (태블로용)])&lt;3 } then &apos;3일 미만&apos; &#13;&#10;elseif {FIXED  [키값]: today()-MAX([최종컨택일 (태블로용)])&gt;=3 and today()-MAX([최종컨택일 (태블로용)])&lt;7}&#13;&#10;then &apos;1주 미만&apos; &#13;&#10;elseif {FIXED  [키값]:  today()-MAX([최종컨택일 (태블로용)])&gt;=7 and  today()-MAX([최종컨택일 (태블로용)])&lt;14}&#13;&#10;then &apos;1주 이상 2주 미만&apos;&#13;&#10;elseif {FIXED  [키값]:  today()-MAX([최종컨택일 (태블로용)])&gt;=14}&#13;&#10;then &apos;2주 이상&apos; &#13;&#10;END' />
              <aliases>
                <alias key='%null%' value='미컨택' />
              </aliases>
            </column>
            <column caption='담당자별 컨택율' datatype='string' name='[Calculation_1269733672880214024]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;({FIXED  [키값] : sum(if [컨택수]&gt;0 then 1 else 0 end)}/&#13;&#10;{FIXED  [키값] : count([사업자번호])})=0 then &apos;0%&apos;&#13;&#10;ELSEIF &#13;&#10;({FIXED  [키값] : sum(if [컨택수]&gt;0 then 1 else 0 end)}/&#13;&#10; {FIXED  [키값] : count([사업자번호])})&gt;0 and&#13;&#10;({FIXED  [키값] : sum(if [컨택수]&gt;0 then 1 else 0 end)}/&#13;&#10;{FIXED  [키값] : count([사업자번호])})&lt;0.3&#13;&#10;then &apos;30% 미만&apos;&#13;&#10;ELSEIF &#13;&#10;({FIXED  [키값] : sum(if [컨택수]&gt;0 then 1 else 0 end)}/&#13;&#10;{FIXED  [키값] : count([사업자번호])})&gt;=0.3 and&#13;&#10;({FIXED  [키값] : sum(if [컨택수]&gt;0 then 1 else 0 end)}/&#13;&#10;{FIXED  [키값] : count([사업자번호])})&lt;0.7&#13;&#10;then &apos;70% 미만&apos;&#13;&#10;ELSEIF &#13;&#10;({FIXED  [키값] : sum(if [컨택수]&gt;0 then 1 else 0 end)}/&#13;&#10;{FIXED [키값] : count([사업자번호])})&gt;=0.7 &#13;&#10;then &apos;70% 이상&apos;&#13;&#10;END' />
            </column>
            <column-instance column='[Calculation_1269733672880214024]' derivation='Count' name='[cnt:Calculation_1269733672880214024:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1269733672880214024]' derivation='None' name='[none:Calculation_1269733672880214024:nk]' pivot='key' type='nominal' />
