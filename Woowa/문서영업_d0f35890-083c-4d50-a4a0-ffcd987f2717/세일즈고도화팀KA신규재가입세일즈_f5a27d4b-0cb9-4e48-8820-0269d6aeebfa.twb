              <calculation class='tableau' formula='IF {FIXED  [키값]: SUM([컨택수])=0 } then &apos;월 컨택 0회&apos; &#13;&#10;elseif {FIXED  [키값]: SUM([컨택수])&gt;=0 and SUM([컨택수])&lt;10}&#13;&#10;then &apos;월 컨택 10회 미만&apos; &#13;&#10;elseif {FIXED  [키값]: SUM([컨택수])&gt;=10 and SUM([컨택수])&lt;30}&#13;&#10;then &apos;월 컨택 30회 미만&apos;&#13;&#10;elseif {FIXED  [키값]: SUM([컨택수])&gt;=30 }&#13;&#10;then &apos;월 컨택 30회 이상&apos; END' />
            </column>
            <column caption='담당자별 최종컨택일 경과' datatype='string' name='[Calculation_1269733672873639943]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF {FIXED  [키값]: today()-MAX([최종컨택일 (태블로용)])&lt;3 } then &apos;3일 미만&apos; &#13;&#10;elseif {FIXED  [키값]: today()-MAX([최종컨택일 (태블로용)])&gt;=3 and today()-MAX([최종컨택일 (태블로용)])&lt;7}&#13;&#10;then &apos;1주 미만&apos; &#13;&#10;elseif {FIXED  [키값]:  today()-MAX([최종컨택일 (태블로용)])&gt;=7 and  today()-MAX([최종컨택일 (태블로용)])&lt;14}&#13;&#10;then &apos;1주 이상 2주 미만&apos;&#13;&#10;elseif {FIXED  [키값]:  today()-MAX([최종컨택일 (태블로용)])&gt;=14}&#13;&#10;then &apos;2주 이상&apos; &#13;&#10;END' />
              <aliases>
                <alias key='%null%' value='미컨택' />
              </aliases>
