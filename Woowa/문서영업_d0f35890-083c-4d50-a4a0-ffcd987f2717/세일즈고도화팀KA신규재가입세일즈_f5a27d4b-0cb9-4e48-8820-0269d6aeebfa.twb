      <column caption='컨택회차_성공건' datatype='string' name='[Calculation_1846757374312828942]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if[(누적) 컨택회차]=1 and [미션 상태]=&apos;성공&apos; &#13;&#10;then &apos;1회차&apos;&#13;&#10;elseif [(누적) 컨택회차]=2 and [미션 상태]=&apos;성공&apos; &#13;&#10;then &apos;2회차&apos;&#13;&#10;elseif [(누적) 컨택회차]=3 and [미션 상태]=&apos;성공&apos; &#13;&#10;then &apos;3회차&apos;&#13;&#10;elseif [(누적) 컨택회차]&gt;3 and  [(누적) 컨택회차]&lt;=5 and [미션 상태]=&apos;성공&apos; &#13;&#10;then &apos;5회차 이하&apos;&#13;&#10;elseif [(누적) 컨택회차]&gt;5 and  [(누적) 컨택회차]&lt;=10 and [미션 상태]=&apos;성공&apos; &#13;&#10;then &apos;10회차 이하&apos; END' />
      </column>
      <column caption='최종 컨택일 경과 현황' datatype='string' name='[Calculation_1846757374322737172]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [컨택 경과일]=0 AND [미션 상태]&lt;&gt;&apos;성공&apos;&#13;&#10;THEN &apos;미컨택&apos;&#13;&#10;elseif [컨택 경과일]&gt;0 and [컨택 경과일]&lt;3 AND [미션 상태]&lt;&gt;&apos;성공&apos;&#13;&#10;THEN &apos;3일 미만&apos;&#13;&#10;ELSEIF[컨택 경과일]&gt;=3 AND [컨택 경과일]&lt;=7 AND [미션 상태]&lt;&gt;&apos;성공&apos;&#13;&#10;THEN &apos;3일 이상 1주 미만&apos;&#13;&#10;ELSEIF [컨택 경과일]&gt;7 AND [컨택 경과일]&lt;=14 AND [미션 상태]&lt;&gt;&apos;성공&apos;&#13;&#10;THEN &apos;1주 이상 2주 미만&apos;&#13;&#10;ELSEIF [컨택 경과일]&gt;14 AND  [미션 상태]&lt;&gt;&apos;성공&apos;&#13;&#10;THEN &apos;2주이상&apos;&#13;&#10; END' />
      </column>
      <column caption='KA 컨택 대비 계약률' datatype='real' name='[Calculation_1846757374348828702]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [운영월] :[Calculation_1846757374276444165]/[Calculation_1846757374274600962]}' />
      </column>
      <column caption='컨택 대비 계약률 색상' datatype='boolean' name='[Calculation_1846757374349115423]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_1846757374284832777]&lt;min([Calculation_1846757374348828702]) then FALSE else true end' />
