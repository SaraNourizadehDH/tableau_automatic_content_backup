            <column caption='비유효 타겟수' datatype='integer' name='[Calculation_1846757374262026241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( if [유효성 여부]=&quot;비유효&quot; then 1 else 0 end )' />
