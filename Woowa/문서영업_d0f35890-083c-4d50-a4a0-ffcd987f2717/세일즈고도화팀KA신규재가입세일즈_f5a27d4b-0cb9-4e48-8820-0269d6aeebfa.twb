        <title>
          <formatted-text>
            <run bold='true' fontcolor='#778899' fontsize='8'>전일 활동인원 비율</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='타겟별 일일현황([태블로] KA_RAW)' name='federated.10pyl2h13pevs51c73zkt05u97jq' />
          </datasources>
          <datasource-dependencies datasource='federated.10pyl2h13pevs51c73zkt05u97jq'>
            <column caption='당월 활동인원' datatype='integer' name='[Calculation_1601311194938662912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if{INCLUDE   [키값]: sum(컨택수)}&gt;0 then 1 else 0 END)' />
            </column>
            <column caption='전일 활동인원' datatype='integer' name='[Calculation_1601311194945048580]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if{INCLUDE   [키값]: max([최종컨택일 (태블로용)])}=TODAY()-1 then 1 else 0 END)' />
            </column>
            <column caption='전일 활동인원 비율' datatype='real' name='[Calculation_1601311194945458181]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1601311194945048580]/(COUNTD([키값]))' />
            </column>
            <column-instance column='[키값]' derivation='CountD' name='[ctd:키값:qk]' pivot='key' type='quantitative' />
            <column-instance column='[타입구분]' derivation='None' name='[none:타입구분:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1601311194938662912]' derivation='User' name='[usr:Calculation_1601311194938662912:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1601311194945048580]' derivation='User' name='[usr:Calculation_1601311194945048580:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1601311194945458181]' derivation='User' name='[usr:Calculation_1601311194945458181:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[최종컨택일 (태블로용)]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[컨택수]' role='measure' type='quantitative' />
            <column datatype='string' name='[키값]' role='dimension' type='nominal' />
            <column datatype='string' name='[타입구분]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <manual-sort column='[federated.10pyl2h13pevs51c73zkt05u97jq].[:Measure Names]' direction='ASC'>
            <dictionary>
              <bucket>&quot;[federated.10pyl2h13pevs51c73zkt05u97jq].[ctd:키값:qk]&quot;</bucket>
              <bucket>&quot;[federated.10pyl2h13pevs51c73zkt05u97jq].[usr:Calculation_1601311194938662912:qk]&quot;</bucket>
            </dictionary>
          </manual-sort>
