      <column caption='수기성공' datatype='integer' name='[Calculation_1846757374276444165]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if(ISNULL([(최신) 컨택일]))=false &#13;&#10;   and [미션 상태]=&quot;성공&quot; then 1 else 0 END)' />
      </column>
      <column caption='라이브' datatype='integer' name='[Calculation_1846757374276898822]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if([라이브 여부])=&apos;Y&apos; then 1 else 0 END)' />
