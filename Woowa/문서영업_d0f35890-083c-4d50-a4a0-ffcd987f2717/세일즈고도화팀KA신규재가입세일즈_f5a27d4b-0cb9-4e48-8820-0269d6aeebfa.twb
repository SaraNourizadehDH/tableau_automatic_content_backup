      <column caption='비유효 타겟수' datatype='integer' name='[Calculation_1846757374262026241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( if [유효성 여부]=&quot;비유효&quot; then 1 else 0 end )' />
      </column>
      <column caption='컨택완료' datatype='integer' name='[Calculation_1846757374274600962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [미션 상태]=&apos;컨택-보류&apos;or  [미션 상태]=&apos;실패&apos; or  [미션 상태]=&apos;성공&apos; then 1 else 0 END)' />
