      <column caption='이전 구간 조회' datatype='boolean' name='[Calculation_1398578822715211777]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;주별&apos; THEN [std_cd] = &apos;W&apos;&#10;            AND DATE(std_dt) = DATEADD(&apos;day&apos;, -7, DATETRUNC(&apos;week&apos;, [Calculation_1398578822715441154],&apos;monday&apos;))&#10;&#10;WHEN &apos;월별&apos; THEN [std_cd] = &apos;M&apos;&#10;            AND DATE(std_dt) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;, [Calculation_1398578822715441154])))&#10;END' />
      </column>
      <column caption='to_dt' datatype='datetime' name='[Calculation_1398578822715441154]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;day&apos;, -1, TODAY())' />
      </column>
      <column caption='이전 구간 값' datatype='integer' name='[Calculation_1398578822715715587]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_1398578822715211777],[cnt_ad_end],0)' />
      </column>
      <column caption='현재 구간 조회' datatype='boolean' name='[Calculation_1398578822716047364]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;주별&apos; THEN [std_cd] = &apos;W&apos;&#10;            AND DATE(std_dt) = DATETRUNC(&apos;week&apos;, [Calculation_1398578822715441154], &apos;monday&apos;)&#10;&#10;WHEN &apos;월별&apos; THEN [std_cd] = &apos;M&apos;&#10;            AND DATE(std_dt) = DATETRUNC(&apos;month&apos;, [Calculation_1398578822715441154])&#10;END' />
      </column>
      <column caption='이전 구간대비 증감률-' datatype='real' name='[Calculation_1398578822716231685]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_1398578822716354566] &lt; 0, [Calculation_1398578822716354566], NULL)' />
      </column>
      <column caption='이전 구간대비 증감률' datatype='real' name='[Calculation_1398578822716354566]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1398578822716510215]) - SUM([Calculation_1398578822715715587]))/SUM([Calculation_1398578822715715587])' />
      </column>
      <column caption='현재 구간 값' datatype='integer' name='[Calculation_1398578822716510215]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_1398578822716047364], [cnt_ad_end], 0)' />
