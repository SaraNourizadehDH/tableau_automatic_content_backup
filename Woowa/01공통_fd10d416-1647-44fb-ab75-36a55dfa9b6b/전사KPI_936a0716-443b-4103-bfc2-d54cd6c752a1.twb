        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;주별&apos; THEN [std_cd] = &apos;W&apos;&#10;            AND DATE(std_dt) = DATEADD(&apos;day&apos;, -7, DATETRUNC(&apos;week&apos;, [Calculation_321796301139771406],&apos;monday&apos;))&#10;&#10;WHEN &apos;월별&apos; THEN [std_cd] = &apos;M&apos;&#10;            AND DATE(std_dt) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;, [Calculation_321796301139771406])))&#10;END' />
      </column>
