            <column-instance column='[Calculation_96686685967376388]' derivation='None' name='[none:Calculation_96686685967376388:nk]' pivot='key' type='nominal' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[std_cd]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[std_dt]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
