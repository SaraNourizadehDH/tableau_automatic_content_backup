        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1] &#10;WHEN &apos;주별&apos; THEN&#10;7&#10;ELSE&#10;DATEDIFF(&apos;day&apos;, &#10;DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, [Calculation_153122441071673349])), &#10;DATETRUNC(&apos;month&apos;, [Calculation_153122441071673349]) -1 ) + 1&#10;END' />
