      <column caption='구간대비 차이 범례' datatype='string' name='[Calculation_459859763602173954]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;주별&apos; THEN &apos;지난주&apos;&#10;ELSE &apos;지난달&apos;&#10;END' />
      </column>
      <column caption='이전 구간 조회' datatype='boolean' name='[Calculation_459859763602448387]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;주별&apos; THEN [std_cd] = &apos;W&apos;&#10;            AND DATE(std_dt) = DATEADD(&apos;day&apos;, -7, DATETRUNC(&apos;week&apos;, [Calculation_459859763602092033],&apos;monday&apos;))&#10;&#10;WHEN &apos;월별&apos; THEN [std_cd] = &apos;M&apos;&#10;            AND DATE(std_dt) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;, [Calculation_459859763602092033])))&#10;END' />
      </column>
      <column caption='조회 기간 구분 범례' datatype='string' name='[Calculation_459859763602558980]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1] &#10;WHEN &apos;주별&apos; THEN &apos;주&apos;&#10;ELSE &apos;달&apos;&#10;END' />
      </column>
      <column caption='조회 기간 제한' datatype='boolean' name='[Calculation_459859763602632709]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;주별&apos; THEN [std_cd] = &apos;W&apos;&#10;            AND DATE([std_dt]) &gt;= DATEADD(&apos;week&apos;, -108, DATETRUNC(&apos;week&apos;, [Calculation_459859763602092033], &apos;monday&apos;))&#10;&#10;WHEN &apos;월별&apos; THEN [std_cd] = &apos;M&apos;&#10;            AND DATE([std_dt]) &gt;= DATEADD(&apos;month&apos;, -24, DATETRUNC(&apos;month&apos;, [Calculation_459859763602092033]))&#10;END' />
      </column>
      <column caption='조회 기간 제한 NULL 처리' datatype='date' name='[Calculation_459859763602714630]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IIF([Calculation_459859763602632709],DATE([std_dt]),null)' />
      </column>
      <column caption='현재 구간 조회' datatype='boolean' name='[Calculation_459859763602792455]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;주별&apos; THEN [std_cd] = &apos;W&apos;&#10;            AND DATE(std_dt) = DATETRUNC(&apos;week&apos;, [Calculation_459859763602092033], &apos;monday&apos;)&#10;&#10;WHEN &apos;월별&apos; THEN [std_cd] = &apos;M&apos;&#10;            AND DATE(std_dt) = DATETRUNC(&apos;month&apos;, [Calculation_459859763602092033])&#10;END' />
      </column>
