          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#556476' fontname='Tableau Medium' fontsize='14'>&quot;</run>
            <run bold='true' fontalignment='1' fontcolor='#6394be' fontname='Tableau Medium' fontsize='10'>Æ </run>
            <run bold='true' fontalignment='1' fontcolor='#6394be' fontname='Tableau Medium' fontsize='12'>왼쪽</run>
            <run bold='true' fontalignment='1' fontcolor='#556476' fontname='Tableau Medium' fontsize='10'>의 차트에서 </run>
            <run bold='true' fontalignment='1' fontcolor='#6394be' fontname='Tableau Medium' fontsize='12'>채널별 비중을 확인</run>
            <run bold='true' fontalignment='1' fontcolor='#556476' fontname='Tableau Medium' fontsize='10'>하고 싶은 기간의 </run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#6394be' fontname='Tableau Medium' fontsize='11'>그래프 막대를 선</run>
