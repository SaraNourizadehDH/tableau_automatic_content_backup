      <column caption='조회 기간 제한' datatype='boolean' name='[Calculation_468092947456176130]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;주별&apos; THEN &#10;      DATE([(전체)기간]) &gt;= MAX(DATE(&apos;2020-01-01&apos;), &#13;&#10;                         DATEADD(&apos;week&apos;, -108, DATETRUNC(&apos;week&apos;, [Calculation_468092947455332353], &apos;monday&apos;)))&#13;&#10;                     AND DATE([(전체)기간]) &lt; DATETRUNC(&apos;week&apos;, [Calculation_468092947455332353], &apos;monday&apos;)&#13;&#10;WHEN &apos;월별&apos; THEN &#10;      DATE([(전체)기간]) &gt;= MAX(DATE(&apos;2020-01-01&apos;), &#13;&#10;                         DATEADD(&apos;month&apos;, -24, DATETRUNC(&apos;month&apos;, [Calculation_468092947455332353])))&#13;&#10;                     AND DATE([(전체)기간]) &lt;  DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Calculation_468092947455332353]))&#13;&#10;END' />
      </column>
      <column caption='조회 기간 제한 NULL 처리' datatype='date' name='[Calculation_468092947458359299]' role='dimension' type='ordinal'>
