        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;주별&apos; THEN DATE(DATETRUNC(&apos;week&apos;,[(유상상세)기간],&apos;monday&apos;))&#13;&#10;ELSE DATE(DATETRUNC(&apos;month&apos;,[(유상상세)기간])) &#13;&#10;END' />
