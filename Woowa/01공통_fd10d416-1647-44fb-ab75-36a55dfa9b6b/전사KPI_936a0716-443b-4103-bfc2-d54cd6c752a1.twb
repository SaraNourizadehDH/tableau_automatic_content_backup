              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;주별&apos; THEN &#10;      DATE([(유상상세)기간]) &gt;= MAX(DATE(&apos;2020-01-01&apos;), &#13;&#10;                         DATEADD(&apos;week&apos;, -108, DATETRUNC(&apos;week&apos;, [Calculation_468092947455332353], &apos;monday&apos;)))&#13;&#10;                     AND DATE([(유상상세)기간]) &lt; DATETRUNC(&apos;week&apos;, [Calculation_468092947455332353], &apos;monday&apos;)&#13;&#10;WHEN &apos;월별&apos; THEN &#10;      DATE([(유상상세)기간]) &gt;= MAX(DATE(&apos;2020-01-01&apos;), &#13;&#10;                         DATEADD(&apos;month&apos;, -24, DATETRUNC(&apos;month&apos;, [Calculation_468092947455332353])))&#13;&#10;                     AND DATE([(유상상세)기간]) &lt;  DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Calculation_468092947455332353]))&#13;&#10;END' />
            </column>
            <column caption='계약설치철거_구분' datatype='string' name='[Calculation_902408836309753870]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [(유상상세)계약구분] = &apos;신규계약&apos; OR&#13;&#10;   [(유상상세)계약구분] = &apos;유상전환&apos; OR&#13;&#10;   [(유상상세)계약구분] = &apos;장기전환&apos; OR&#13;&#10;   [(유상상세)계약구분] = &apos;재렌탈&apos;&#13;&#10; THEN &apos;계약수&apos;&#13;&#10;ELSEIF [(유상상세)계약구분] = &apos;설치&apos;&#13;&#10; THEN &apos;설치수&apos;&#13;&#10;ELSEIF [(유상상세)계약구분] = &apos;철거&apos;&#13;&#10; THEN &apos;철거수&apos;&#13;&#10;END' />
            </column>
