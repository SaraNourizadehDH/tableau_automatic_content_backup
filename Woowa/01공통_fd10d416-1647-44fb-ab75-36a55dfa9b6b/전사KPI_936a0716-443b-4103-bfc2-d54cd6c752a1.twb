        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;주별&apos; THEN &#10;      DATE([(모델별)기간]) &gt;= MAX(DATE(&apos;2020-01-01&apos;), &#10;                         DATEADD(&apos;week&apos;, -108, DATETRUNC(&apos;week&apos;, [Calculation_468092947455332353], &apos;monday&apos;)))&#10;                     AND DATE([(모델별)기간]) &lt; DATETRUNC(&apos;week&apos;, [Calculation_468092947455332353], &apos;monday&apos;)&#10;WHEN &apos;월별&apos; THEN &#10;      DATE([(모델별)기간]) &gt;= MAX(DATE(&apos;2020-01-01&apos;), &#10;                         DATEADD(&apos;month&apos;, -24, DATETRUNC(&apos;month&apos;, [Calculation_468092947455332353])))&#10;                     AND DATE([(모델별)기간]) &lt;  DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Calculation_468092947455332353]))&#10;END' />
