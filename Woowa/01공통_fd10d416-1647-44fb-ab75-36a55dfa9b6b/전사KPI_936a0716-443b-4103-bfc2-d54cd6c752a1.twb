      <column caption='실적구분_계정(범례용)' datatype='string' name='[Calculation_4358710401515601924]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [(약정별)실적구분]&#10;WHEN &apos;전체&apos; THEN &apos;전체 계정수&apos;&#10;ELSE &apos;유상 계정수&apos;&#10;END' />
      </column>
      <column caption='to_dt' datatype='datetime' name='[Calculation_468092947455332353]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;day&apos;,-1,TODAY())' />
      </column>
      <column caption='조회 기간 제한' datatype='boolean' name='[Calculation_468092947456176130]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;주별&apos; THEN &#10;      DATE([(약정별)기간]) &gt;= MAX(DATE(&apos;2020-01-01&apos;), &#13;&#10;                         DATEADD(&apos;week&apos;, -108, DATETRUNC(&apos;week&apos;, [Calculation_468092947455332353], &apos;monday&apos;)))&#13;&#10;                     AND DATE([(약정별)기간]) &lt; DATETRUNC(&apos;week&apos;, [Calculation_468092947455332353], &apos;monday&apos;)&#13;&#10;WHEN &apos;월별&apos; THEN &#10;      DATE([(약정별)기간]) &gt;= MAX(DATE(&apos;2020-01-01&apos;), &#13;&#10;                         DATEADD(&apos;month&apos;, -24, DATETRUNC(&apos;month&apos;, [Calculation_468092947455332353])))&#13;&#10;                     AND DATE([(약정별)기간]) &lt;  DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Calculation_468092947455332353]))&#13;&#10;END' />
      </column>
      <column caption='조회 기간 제한 NULL 처리' datatype='date' name='[Calculation_468092947458359299]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IIF([Calculation_468092947456176130],DATE([(약정별)기간]),NULL)' />
      </column>
      <column caption='(계정수)조회 기간 값' datatype='integer' name='[Calculation_887772140750721029]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1] &#10;WHEN &apos;주별&apos; THEN IIF([(약정별)구분] = &apos;W&apos; AND [Calculation_468092947456176130],[(약정별)계정수],NULL) &#10;ELSE IIF([(약정별)구분] = &apos;M&apos; AND [Calculation_468092947456176130],[(약정별)계정수],NULL) &#10;END' />
      </column>
      <column caption='조회 일자' datatype='date' name='[Calculation_990791933993320448]' role='dimension' type='ordinal'>
