            <column aggregation='Year' caption='기간' datatype='date' default-type='ordinal' layered='true' name='[(유상상세)기간]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
            <column caption='(계약수)조회 기간 값' datatype='integer' name='[Calculation_4358710401502580736]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1] &#10;WHEN &apos;주별&apos; THEN IIF([(유상상세)구분] = &apos;W&apos; AND [Calculation_468092947456176130],[(유상상세)계약수],NULL)&#10;ELSE IIF([(유상상세)구분] = &apos;M&apos; AND [Calculation_468092947456176130],[(유상상세)계약수],NULL) &#10;END' />
            </column>
            <column caption='to_dt' datatype='datetime' name='[Calculation_468092947455332353]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;,-1,TODAY())' />
