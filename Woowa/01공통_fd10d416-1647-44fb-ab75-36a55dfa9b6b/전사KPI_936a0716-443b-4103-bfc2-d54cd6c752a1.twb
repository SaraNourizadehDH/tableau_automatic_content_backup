            <datasource caption='전사KPI_로봇_모델별 계정수 상세' name='sqlproxy.00o7il1070glyh10fqb250i7520r' />
            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='조회 기간 구분값' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;주별&quot;'>
              <calculation class='tableau' formula='&quot;주별&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.00o7il1070glyh10fqb250i7520r'>
            <column aggregation='Year' caption='기간' datatype='date' default-type='ordinal' layered='true' name='[(모델별)기간]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
            <column caption='조회 일자' datatype='date' name='[Calculation_990791933993320448]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;주별&apos; THEN DATE(DATETRUNC(&apos;week&apos;,[(모델별)기간],&apos;monday&apos;))&#13;&#10;ELSE DATE(DATETRUNC(&apos;month&apos;,[(모델별)기간])) &#13;&#10;END' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.05ezjln0nsjk3b11q010v1pp35ys'>
            <column aggregation='Count' caption='계약구분' datatype='string' default-type='nominal' layered='true' name='[(유상상세)계약구분]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[(유상상세)계약수]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
