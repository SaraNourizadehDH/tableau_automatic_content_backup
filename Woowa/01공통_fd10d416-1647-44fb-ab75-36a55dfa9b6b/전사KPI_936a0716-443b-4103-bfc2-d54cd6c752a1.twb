      <column caption='조회 기간 제한' datatype='boolean' name='[Calculation_153122441074503690]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;주별&apos; THEN DATE([일자]) &gt;= MAX(DATE(&apos;2020-01-01&apos;), &#10;                                   DATEADD(&apos;week&apos;, -108, DATETRUNC(&apos;week&apos;, [Calculation_153122441071673349], &apos;monday&apos;)))&#10;                AND DATE([일자]) &lt; DATETRUNC(&apos;week&apos;, [Calculation_153122441071673349], &apos;monday&apos;)&#10;WHEN &apos;월별&apos; THEN DATE([일자]) &gt;= MAX(DATE(&apos;2020-01-01&apos;), &#10;                                   DATEADD(&apos;month&apos;, -24, DATETRUNC(&apos;month&apos;, [Calculation_153122441071673349])))&#10;                AND DATE([일자]) &lt;  DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Calculation_153122441071673349]))&#10;END' />
      </column>
      <column caption='Install유형(차트)' datatype='string' name='[Calculation_4624704266211160065]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [피벗 필드명]&#10;WHEN &apos;(Install수 - 전체) 일 실적&apos; THEN &apos;Install전체&apos;&#10;WHEN &apos;(Install수 - Organic) 일 실적&apos; THEN &apos;Organic전체&apos;&#10;WHEN &apos;(Install수 - Paid) 일 실적&apos; THEN &apos;Paid전체&apos;&#10;WHEN &apos;(Install수 - Paid - Google) 일 실적&apos; THEN &apos;Google&apos;&#10;WHEN &apos;(Install수 - Paid - Facebook) 일 실적&apos; THEN &apos;Facebook&apos; &#10;WHEN &apos;(Install수 - Paid - 기타) 일 실적&apos; THEN &apos;기타&apos;&#10;WHEN &apos;(Install수 - Paid - Moloco) 일 실적&apos; THEN &apos;Moloco&apos;&#10;WHEN &apos;(Install수 - Paid - Criteo) 일 실적&apos; THEN &apos;Criteo&apos;&#10;WHEN &apos;(Install수 - Paid - Naver) 일 실적&apos; THEN &apos;Naver&apos;&#10;WHEN &apos;(Install수 - Paid - Unknown) 일 실적&apos; THEN &apos;Unknown&apos;&#10;END' />
      </column>
      <column caption='조회 기간 제한(상세)' datatype='boolean' name='[Calculation_56435790979977234]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1] &#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;week&apos;,[조회 기간 제한(복사본)_749075339216879625],&apos;monday&apos;) = [Parameters].[조회 일자 매개 변수]&#10;WHEN &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;,[조회 기간 제한(복사본)_749075339216879625]) = [Parameters].[조회 일자 매개 변수]&#10;END' />
      </column>
      <_.fcp.ObjectModelTableType.true...column aggregation='Count' caption='만화경-21년만화경KPI&gt;대시보드용' datatype='table' default-type='quantitative' layered='true' name='[__tableau_internal_object_id__].[만화경-21년만화경KPI&gt;대시보드용_F60BF546AFA04FED90E1161141CAF7BA]' pivot='key' role='measure' type='quantitative' user-datatype='table' visual-totals='Default' />
