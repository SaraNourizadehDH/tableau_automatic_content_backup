        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;주별&apos; THEN DATE([일자]) &gt;= MAX(DATE(&apos;2020-01-01&apos;), &#10;                                   DATEADD(&apos;week&apos;, -108, DATETRUNC(&apos;week&apos;, [Calculation_153122441071673349], &apos;monday&apos;)))&#10;                AND DATE([일자]) &lt; DATETRUNC(&apos;week&apos;, [Calculation_153122441071673349], &apos;monday&apos;)&#10;&#10;WHEN &apos;월별&apos; THEN DATE([일자]) &gt;= MAX(DATE(&apos;2020-01-01&apos;), &#10;                                   DATEADD(&apos;month&apos;, -24, DATETRUNC(&apos;month&apos;, [Calculation_153122441071673349])))&#10;                AND DATE([일자]) &lt;  DATETRUNC(&apos;month&apos;, [Calculation_153122441071673349])&#10;END' />
