            <column caption='C_Date_Label' datatype='string' name='[Calculation_488922077104840708]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[매개 변수 1]&#13;&#10;when &apos;일별&apos;&#13;&#10;then if len(str(DATEPART(&apos;month&apos;,[Calculation_488922077102366723]))) = 1&#13;&#10;     then MID(STR([Calculation_488922077102366723]),7,1)+&quot;월 &quot;&#13;&#10;&#13;&#10;     else MID(STR([Calculation_488922077102366723]),6,2)+&quot;월 &quot;&#13;&#10;     end&#13;&#10;     +&#13;&#10;     if len(str(DATEPART(&apos;day&apos;,[Calculation_488922077102366723]))) = 1&#13;&#10;     then MID(STR([Calculation_488922077102366723]),10,1)+&quot;일&quot;&#13;&#10;&#13;&#10;     else MID(STR([Calculation_488922077102366723]),9,2)+&quot;일&quot;&#13;&#10;     end&#13;&#10;     &#13;&#10;when &apos;주별&apos;&#13;&#10;then [week_nm]&#13;&#10;when &apos;월별&apos;&#13;&#10;then  &#13;&#10;IF len(str(DATEPART(&apos;month&apos;,[Calculation_488922077102366723]))) = 2&#13;&#10;then MID(STR([Calculation_488922077102366723]),3,2)+&quot;년 &quot;+MID(STR([Calculation_488922077102366723]),6,2) + &apos;월&apos;&#13;&#10;ELSE MID(STR([Calculation_488922077102366723]),3,2)+&quot;년 &quot;+MID(STR([Calculation_488922077102366723]),7,1) + &apos;월&apos;&#13;&#10;&#13;&#10;END&#13;&#10;END' />
            </column>
            <column caption='F_Last' datatype='boolean' name='[Calculation_891431294473654274]' role='measure' type='nominal'>
