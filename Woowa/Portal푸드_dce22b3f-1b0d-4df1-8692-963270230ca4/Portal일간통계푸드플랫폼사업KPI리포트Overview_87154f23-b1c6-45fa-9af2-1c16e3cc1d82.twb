          <datasource-dependencies datasource='Parameters'>
            <column caption='P_Date_Type' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;일별&quot;'>
              <calculation class='tableau' formula='&quot;일별&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[sqlproxy.0plehck0gb1la1109gdm7102vr0n].[Calculation_931400745007603720]' caption='P_End_Date_Only' datatype='date' default-format='*yyyy-mm-dd' name='[매개 변수 2]' param-domain-type='any' role='measure' type='quantitative' value='#2025-09-14#'>
              <calculation class='tableau' formula='#2025-09-14#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0plehck0gb1la1109gdm7102vr0n'>
            <column caption='C_Date_Label_Weekday' datatype='string' name='[C_Date_Label (copy)_1947525423392215040]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[매개 변수 1]&#13;&#10;when &apos;일별&apos;&#13;&#10;then if len(str(DATEPART(&apos;month&apos;,[Calculation_488922077102366723]))) = 1&#13;&#10;     then MID(STR([Calculation_488922077102366723]),7,1)&#13;&#10;     else MID(STR([Calculation_488922077102366723]),6,2)&#13;&#10;     end&#13;&#10;     +&quot;/&quot;+&#13;&#10;     if len(str(DATEPART(&apos;day&apos;,[Calculation_488922077102366723]))) = 1&#13;&#10;     then MID(STR([Calculation_488922077102366723]),10,1)&#13;&#10;     else MID(STR([Calculation_488922077102366723]),9,2)&#13;&#10;     end&#13;&#10;     +&#13;&#10;     CHAR(10)&#13;&#10;     +&#13;&#10;     &quot;(&quot;+&#13;&#10;     CASE STR(DATEPART(&apos;weekday&apos;,[Calculation_488922077102366723]))&#13;&#10;     WHEN &apos;1&apos; THEN &quot;일&quot;&#13;&#10;     WHEN &apos;2&apos; THEN &quot;월&quot;&#13;&#10;     WHEN &apos;3&apos; THEN &quot;화&quot;&#13;&#10;     WHEN &apos;4&apos; THEN &quot;수&quot;&#13;&#10;     WHEN &apos;5&apos; THEN &quot;목&quot;&#13;&#10;     WHEN &apos;6&apos; THEN &quot;금&quot;&#13;&#10;     WHEN &apos;7&apos; THEN &quot;토&quot;&#13;&#10;     END&#13;&#10;     +&quot;)&quot;&#13;&#10;     &#13;&#10;when &apos;주별&apos;&#13;&#10;then [week_nm]&#13;&#10;when &apos;월별&apos;&#13;&#10;then  &#13;&#10;IF len(str(DATEPART(&apos;month&apos;,[Calculation_488922077102366723]))) = 2&#13;&#10;then MID(STR([Calculation_488922077102366723]),3,2)+&quot;년 &quot;+MID(STR([Calculation_488922077102366723]),6,2) + &apos;월&apos;&#13;&#10;ELSE MID(STR([Calculation_488922077102366723]),3,2)+&quot;년 &quot;+MID(STR([Calculation_488922077102366723]),7,1) + &apos;월&apos;&#13;&#10;&#13;&#10;END&#13;&#10;END' />
            </column>
            <column caption='배민1 내 한집배달 비중%' datatype='real' name='[Calculation_247135072755965952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bm1_only]) / SUM([bm1_ord])' />
            </column>
            <column caption='배민1 주문 비중' datatype='real' name='[Calculation_247135072757624835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([bm1_ord]) / SUM([ord_cnt])' />
            </column>
            <column caption='푸드 AFV' datatype='real' name='[Calculation_247135072758546437]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([gfv])/sum([ord_cnt])' />
            </column>
            <column caption='오픈리스트 GFV 비중' datatype='real' name='[Calculation_348747540062318606]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([openlist_gpv]) / SUM([bm_gfv])' />
            </column>
