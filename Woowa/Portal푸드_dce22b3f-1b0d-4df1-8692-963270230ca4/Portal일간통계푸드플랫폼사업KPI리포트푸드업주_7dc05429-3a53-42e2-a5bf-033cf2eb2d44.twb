          <datasource-dependencies datasource='sqlproxy.135wpmn1olar8j16lgtvg1is39ih'>
            <column caption='C_Date_Label_Weekday' datatype='string' name='[C_Date_Label (copy)_1947525423392215040]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[매개 변수 1]&#13;&#10;when &apos;일별&apos;&#13;&#10;then if len(str(DATEPART(&apos;month&apos;,[Calculation_1047368442541178880]))) = 1&#13;&#10;     then MID(STR([Calculation_1047368442541178880]),7,1)&#13;&#10;     else MID(STR([Calculation_1047368442541178880]),6,2)&#13;&#10;     end&#13;&#10;     +&quot;/&quot;+&#13;&#10;     if len(str(DATEPART(&apos;day&apos;,[Calculation_1047368442541178880]))) = 1&#13;&#10;     then MID(STR([Calculation_1047368442541178880]),10,1)&#13;&#10;     else MID(STR([Calculation_1047368442541178880]),9,2)&#13;&#10;     end&#13;&#10;     +&#13;&#10;     &quot;(&quot;+&#13;&#10;     CASE STR(DATEPART(&apos;weekday&apos;,[Calculation_1047368442541178880]))&#13;&#10;     WHEN &apos;1&apos; THEN &quot;일&quot;&#13;&#10;     WHEN &apos;2&apos; THEN &quot;월&quot;&#13;&#10;     WHEN &apos;3&apos; THEN &quot;화&quot;&#13;&#10;     WHEN &apos;4&apos; THEN &quot;수&quot;&#13;&#10;     WHEN &apos;5&apos; THEN &quot;목&quot;&#13;&#10;     WHEN &apos;6&apos; THEN &quot;금&quot;&#13;&#10;     WHEN &apos;7&apos; THEN &quot;토&quot;&#13;&#10;     END&#13;&#10;     +&quot;)&quot;&#13;&#10;     &#13;&#10;when &apos;주별&apos;&#13;&#10;then [week_nm]&#13;&#10;when &apos;월별&apos;&#13;&#10;then  &#13;&#10;IF len(str(DATEPART(&apos;month&apos;,[Calculation_1047368442541178880]))) = 2&#13;&#10;then MID(STR([Calculation_1047368442541178880]),3,2)+&quot;년 &quot;+MID(STR([Calculation_1047368442541178880]),6,2) + &apos;월&apos;&#13;&#10;ELSE MID(STR([Calculation_1047368442541178880]),3,2)+&quot;년 &quot;+MID(STR([Calculation_1047368442541178880]),7,1) + &apos;월&apos;&#13;&#10;&#13;&#10;END&#13;&#10;END' />
            </column>
            <column caption='C_Date' datatype='date' name='[Calculation_1047368442541178880]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([part_date])' />
            </column>
            <column caption='F_Date_Clsf_Short _NEW' datatype='boolean' name='[F_Date_Clsf_Short (copy)_1947525423394787329]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN&#13;&#10;[std_cd] = &apos;D&apos; &#13;&#10;AND DATETRUNC(&apos;day&apos;,[Calculation_1047368442541178880]) &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;day&apos;, [Calculation_1047368442541178880]) &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;day&apos;, -7,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN &#13;&#10;[std_cd] = &apos;W&apos; &#13;&#10;AND DATETRUNC(&apos;iso-week&apos;,[Calculation_1047368442541178880]) &lt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;iso-week&apos;, [Calculation_1047368442541178880]) &gt;= DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, -5,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN [std_cd] = &apos;M&apos;&#13;&#10;AND DATETRUNC(&apos;month&apos;,[Calculation_1047368442541178880]) &lt;= DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;month&apos;, [Calculation_1047368442541178880]) &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -5,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;END&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;/*&#13;&#10;CASE [p_Date_Type]&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN&#13;&#10;//[std_cd] = &apos;D&apos; &#13;&#10;DATETRUNC(&apos;day&apos;,[C_Date]) &lt;= DATETRUNC(&apos;day&apos;, [p_Date])  &#13;&#10;AND DATETRUNC(&apos;day&apos;, [C_Date]) &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;day&apos;, -7,[p_Date]))&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN &#13;&#10;     IF DATETRUNC(&apos;iso-week&apos;, [p_Date]) = DATETRUNC(&apos;iso-week&apos;, [C_MAX(c_date)])&#13;&#10;     THEN DATETRUNC(&apos;iso-week&apos;, [C_Date]) &gt;= DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, -5,[C_MAX(c_date)]))&#13;&#10;          AND //주 마지막일&#13;&#10;          ([C_매주_마지막일] = [C_Date] OR [C_Date] = [C_MAX(c_date)])&#13;&#10;     ELSEIF DATETRUNC(&apos;iso-week&apos;, [p_Date]) &gt; DATETRUNC(&apos;iso-week&apos;, [C_MAX(c_date)])&#13;&#10;     THEN DATETRUNC(&apos;iso-week&apos;, [C_Date]) &gt;= DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, -5,[C_MAX(c_date)]))&#13;&#10;          AND //주 마지막일&#13;&#10;          ([C_매주_마지막일] = [C_Date] OR [C_Date] = [C_MAX(c_date)])&#13;&#10;ELSE&#13;&#10;DATETRUNC(&apos;iso-week&apos;,[C_Date]) &lt;= DATETRUNC(&apos;iso-week&apos;, [p_Date])  &#13;&#10;AND DATETRUNC(&apos;iso-week&apos;, [C_Date]) &gt;= DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, -5,[p_Date]))&#13;&#10;AND //주 마지막일&#13;&#10;[C_매주_마지막일] = [C_Date]&#13;&#10;END&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN &#13;&#10;    IF DATETRUNC(&apos;month&apos;, [p_Date]) = DATETRUNC(&apos;month&apos;, [C_MAX(c_date)])&#13;&#10;    THEN DATETRUNC(&apos;month&apos;, [C_Date]) &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -5,[C_MAX(c_date)]))&#13;&#10;          AND //주 마지막일&#13;&#10;          ([C_매월_마지막일] = [C_Date] OR [C_Date] = [C_MAX(c_date)])&#13;&#10;    ELSEIF DATETRUNC(&apos;month&apos;, [p_Date]) &gt; DATETRUNC(&apos;month&apos;, [C_MAX(c_date)])&#13;&#10;    THEN DATETRUNC(&apos;month&apos;, [C_Date]) &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -5,[C_MAX(c_date)]))&#13;&#10;          AND //주 마지막일&#13;&#10;          ([C_매월_마지막일] = [C_Date] OR [C_Date] = [C_MAX(c_date)])&#13;&#10;ELSE  &#13;&#10;DATETRUNC(&apos;month&apos;,[C_Date]) &lt;= DATETRUNC(&apos;month&apos;, [p_Date])  &#13;&#10;AND DATETRUNC(&apos;month&apos;, [C_Date]) &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -5,[p_Date]))&#13;&#10;AND //월 마지막일 &#13;&#10;[C_매월_마지막일] = [C_Date]&#13;&#10;END&#13;&#10;END*/' />
            </column>
