      <column caption='C_Date_Label_Weekday' datatype='string' name='[C_Date_Label (copy)_1947525423392215040]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[매개 변수 1]&#13;&#10;when &apos;일별&apos;&#13;&#10;then if len(str(DATEPART(&apos;month&apos;,[Calculation_1047368442541178880]))) = 1&#13;&#10;     then MID(STR([Calculation_1047368442541178880]),7,1)&#13;&#10;     else MID(STR([Calculation_1047368442541178880]),6,2)&#13;&#10;     end&#13;&#10;     +&quot;/&quot;+&#13;&#10;     if len(str(DATEPART(&apos;day&apos;,[Calculation_1047368442541178880]))) = 1&#13;&#10;     then MID(STR([Calculation_1047368442541178880]),10,1)&#13;&#10;     else MID(STR([Calculation_1047368442541178880]),9,2)&#13;&#10;     end&#13;&#10;     +&#13;&#10;     &quot;(&quot;+&#13;&#10;     CASE STR(DATEPART(&apos;weekday&apos;,[Calculation_1047368442541178880]))&#13;&#10;     WHEN &apos;1&apos; THEN &quot;일&quot;&#13;&#10;     WHEN &apos;2&apos; THEN &quot;월&quot;&#13;&#10;     WHEN &apos;3&apos; THEN &quot;화&quot;&#13;&#10;     WHEN &apos;4&apos; THEN &quot;수&quot;&#13;&#10;     WHEN &apos;5&apos; THEN &quot;목&quot;&#13;&#10;     WHEN &apos;6&apos; THEN &quot;금&quot;&#13;&#10;     WHEN &apos;7&apos; THEN &quot;토&quot;&#13;&#10;     END&#13;&#10;     +&quot;)&quot;&#13;&#10;     &#13;&#10;when &apos;주별&apos;&#13;&#10;then [week_nm]&#13;&#10;when &apos;월별&apos;&#13;&#10;then  &#13;&#10;IF len(str(DATEPART(&apos;month&apos;,[Calculation_1047368442541178880]))) = 2&#13;&#10;then MID(STR([Calculation_1047368442541178880]),3,2)+&quot;년 &quot;+MID(STR([Calculation_1047368442541178880]),6,2) + &apos;월&apos;&#13;&#10;ELSE MID(STR([Calculation_1047368442541178880]),3,2)+&quot;년 &quot;+MID(STR([Calculation_1047368442541178880]),7,1) + &apos;월&apos;&#13;&#10;&#13;&#10;END&#13;&#10;END' />
      </column>
