        <calculation class='tableau' formula='case [Parameters].[매개 변수 1]&#13;&#10;when &apos;일별&apos;&#13;&#10;then &apos;최근 15일 트렌드&apos;&#13;&#10;when &apos;주별&apos;&#13;&#10;then &apos;최근 12주 트렌드&apos;&#13;&#10;when &apos;월별&apos;&#13;&#10;then &apos;최근 13개월 트렌드&apos;&#13;&#10;END' />
