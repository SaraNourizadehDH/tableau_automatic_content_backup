      <column caption='C_Date_Label_Weekday' datatype='string' name='[C_Date_Label (copy)_1947525423392215040]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[매개 변수 1]&#13;&#10;when &apos;일별&apos;&#13;&#10;then if len(str(DATEPART(&apos;month&apos;,[Calculation_268245696444727299]))) = 1&#13;&#10;     then MID(STR([Calculation_268245696444727299]),7,1)&#13;&#10;     else MID(STR([Calculation_268245696444727299]),6,2)&#13;&#10;     end&#13;&#10;     +&quot;/&quot;+&#13;&#10;     if len(str(DATEPART(&apos;day&apos;,[Calculation_268245696444727299]))) = 1&#13;&#10;     then MID(STR([Calculation_268245696444727299]),10,1)&#13;&#10;     else MID(STR([Calculation_268245696444727299]),9,2)&#13;&#10;     end&#13;&#10;     +&#13;&#10;     &quot;(&quot;+&#13;&#10;     CASE STR(DATEPART(&apos;weekday&apos;,[Calculation_268245696444727299]))&#13;&#10;     WHEN &apos;1&apos; THEN &quot;일&quot;&#13;&#10;     WHEN &apos;2&apos; THEN &quot;월&quot;&#13;&#10;     WHEN &apos;3&apos; THEN &quot;화&quot;&#13;&#10;     WHEN &apos;4&apos; THEN &quot;수&quot;&#13;&#10;     WHEN &apos;5&apos; THEN &quot;목&quot;&#13;&#10;     WHEN &apos;6&apos; THEN &quot;금&quot;&#13;&#10;     WHEN &apos;7&apos; THEN &quot;토&quot;&#13;&#10;     END&#13;&#10;     +&quot;)&quot;&#13;&#10;     &#13;&#10;when &apos;주별&apos;&#13;&#10;then [week_nm]&#13;&#10;when &apos;월별&apos;&#13;&#10;then  &#13;&#10;IF len(str(DATEPART(&apos;month&apos;,[Calculation_268245696444727299]))) = 2&#13;&#10;then MID(STR([Calculation_268245696444727299]),3,2)+&quot;년 &quot;+MID(STR([Calculation_268245696444727299]),6,2) + &apos;월&apos;&#13;&#10;ELSE MID(STR([Calculation_268245696444727299]),3,2)+&quot;년 &quot;+MID(STR([Calculation_268245696444727299]),7,1) + &apos;월&apos;&#13;&#10;&#13;&#10;END&#13;&#10;END' />
      </column>
      <column caption='C_Date_Label_Weekday(Resizing)' datatype='string' name='[C_Date_Label_Weekday(복사본)_1443966677936713728]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[매개 변수 1]&#13;&#10;when &apos;일별&apos;&#13;&#10;then if len(str(DATEPART(&apos;month&apos;,[Calculation_268245696444727299]))) = 1&#13;&#10;     then MID(STR([Calculation_268245696444727299]),7,1)&#13;&#10;     else MID(STR([Calculation_268245696444727299]),6,2)&#13;&#10;     end&#13;&#10;     +&quot;/&quot;+&#13;&#10;     if len(str(DATEPART(&apos;day&apos;,[Calculation_268245696444727299]))) = 1&#13;&#10;     then MID(STR([Calculation_268245696444727299]),10,1)&#13;&#10;     else MID(STR([Calculation_268245696444727299]),9,2)&#13;&#10;     end&#13;&#10;     +&#13;&#10;     CHAR(10)&#13;&#10;     +&#13;&#10;     &quot;(&quot;+&#13;&#10;     CASE STR(DATEPART(&apos;weekday&apos;,[Calculation_268245696444727299]))&#13;&#10;     WHEN &apos;1&apos; THEN &quot;일&quot;&#13;&#10;     WHEN &apos;2&apos; THEN &quot;월&quot;&#13;&#10;     WHEN &apos;3&apos; THEN &quot;화&quot;&#13;&#10;     WHEN &apos;4&apos; THEN &quot;수&quot;&#13;&#10;     WHEN &apos;5&apos; THEN &quot;목&quot;&#13;&#10;     WHEN &apos;6&apos; THEN &quot;금&quot;&#13;&#10;     WHEN &apos;7&apos; THEN &quot;토&quot;&#13;&#10;     END&#13;&#10;     +&quot;)&quot;&#13;&#10;     &#13;&#10;when &apos;주별&apos;&#13;&#10;then [week_nm]&#13;&#10;when &apos;월별&apos;&#13;&#10;then  &#13;&#10;IF len(str(DATEPART(&apos;month&apos;,[Calculation_268245696444727299]))) = 2&#13;&#10;then MID(STR([Calculation_268245696444727299]),3,2)+&quot;년 &quot;+MID(STR([Calculation_268245696444727299]),6,2) + &apos;월&apos;&#13;&#10;ELSE MID(STR([Calculation_268245696444727299]),3,2)+&quot;년 &quot;+MID(STR([Calculation_268245696444727299]),7,1) + &apos;월&apos;&#13;&#10;&#13;&#10;END&#13;&#10;END' />
      </column>
      <column caption='주문수_증감' datatype='real' name='[Calculation_1608911028555849730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN&#13;&#10;(ZN(SUM([ord_cnt])) - LOOKUP(ZN(SUM([ord_cnt])), -1)) / ABS(LOOKUP(ZN(SUM([ord_cnt])), -1))&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN &#13;&#10;(ZN(SUM([ord_cnt])) - LOOKUP(ZN(SUM([ord_cnt])), -1)) / ABS(LOOKUP(ZN(SUM([ord_cnt])), -1))&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN&#13;&#10;(ZN(SUM([ord_cnt])) - LOOKUP(ZN(SUM([ord_cnt])), -7)) / ABS(LOOKUP(ZN(SUM([ord_cnt])), -7))&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='F_Date_clsf_short_증감' datatype='boolean' name='[Calculation_1608911028560490501]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN&#13;&#10;[std_cd] = &apos;D&apos; &#13;&#10;AND DATETRUNC(&apos;day&apos;,[Calculation_268245696444727299]) &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])&#13;&#10;AND DATETRUNC(&apos;day&apos;, [Calculation_268245696444727299]) &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;day&apos;, -14,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN &#13;&#10;[std_cd] = &apos;W&apos; &#13;&#10;AND DATETRUNC(&apos;iso-week&apos;,[Calculation_268245696444727299]) &lt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;iso-week&apos;, [Calculation_268245696444727299]) &gt;= DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, -6,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN [std_cd] = &apos;M&apos;&#13;&#10;AND DATETRUNC(&apos;month&apos;,[Calculation_268245696444727299]) &lt;= DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;month&apos;, [Calculation_268245696444727299]) &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -6,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='C_LAST' datatype='integer' name='[Calculation_1608911028560875526]' role='measure' type='ordinal'>
