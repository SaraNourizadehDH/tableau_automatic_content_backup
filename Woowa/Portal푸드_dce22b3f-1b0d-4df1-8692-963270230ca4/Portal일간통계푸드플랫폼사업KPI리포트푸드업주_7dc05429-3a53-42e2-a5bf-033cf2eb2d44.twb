              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN&#13;&#10;[std_cd] = &apos;D&apos; &#13;&#10;AND &#13;&#10;    IF [Calculation_1642406548691226637] &lt; [Parameters].[매개 변수 2]&#13;&#10;    THEN DATETRUNC(&apos;day&apos;, [Calculation_1047368442541178880]) &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;day&apos;, -7,[Calculation_1642406548691226637]))&#13;&#10;         AND [Calculation_1047368442541178880] &lt;= [Calculation_1642406548691226637]&#13;&#10;    ELSE&#13;&#10;         DATETRUNC(&apos;day&apos;,[Calculation_1047368442541178880]) &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])  &#13;&#10;         AND DATETRUNC(&apos;day&apos;, [Calculation_1047368442541178880]) &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;day&apos;, -7,[Parameters].[매개 변수 2]))&#13;&#10;    END&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN &#13;&#10;[std_cd] = &apos;D&apos; &#13;&#10;AND&#13;&#10;     IF [Calculation_1642406548691226637] &lt; [Parameters].[매개 변수 2]&#13;&#10;     THEN [Calculation_1047368442541178880] &gt;= DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, -5,[Calculation_1642406548691226637])) // 최대일자보다 큰날짜 선택하면&#13;&#10;          AND [Calculation_1047368442541178880] &lt;= [Calculation_1642406548691226637]&#13;&#10;          AND //주 마지막일&#13;&#10;          ([C_매월_마지막일 (copy)_1947525423397199877] = [Calculation_1047368442541178880] OR [Calculation_1642406548691226637] = [Calculation_1047368442541178880])&#13;&#10;     ELSEIF DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2]) = DATETRUNC(&apos;iso-week&apos;, [Calculation_1642406548691226637]) //최대일자의 주차 = 찍은날짜와 같은 주차&#13;&#10;     THEN DATETRUNC(&apos;iso-week&apos;, [Calculation_1047368442541178880]) &gt;= DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, -5,[Parameters].[매개 변수 2])) // 5주전~주마지막일, 선택일&#13;&#10;          AND DATETRUNC(&apos;iso-week&apos;, [Calculation_1047368442541178880]) &lt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])&#13;&#10;          AND //주 마지막일&#13;&#10;          ([C_매월_마지막일 (copy)_1947525423397199877] = [Calculation_1047368442541178880] OR [Parameters].[매개 변수 2] = [Calculation_1047368442541178880])     &#13;&#10;    ELSE&#13;&#10;        [Calculation_1047368442541178880] &lt;= [Parameters].[매개 변수 2]&#13;&#10;        AND DATETRUNC(&apos;iso-week&apos;, [Calculation_1047368442541178880]) &gt;= DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, -5,[Parameters].[매개 변수 2]))&#13;&#10;        AND //주 마지막일&#13;&#10;        ([C_매월_마지막일 (copy)_1947525423397199877] = [Calculation_1047368442541178880] OR [Parameters].[매개 변수 2] = [Calculation_1047368442541178880])&#13;&#10;    END&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN &#13;&#10;[std_cd] = &apos;D&apos;&#13;&#10;AND&#13;&#10;    IF [Calculation_1642406548691226637] &lt; [Parameters].[매개 변수 2]&#13;&#10;     THEN [Calculation_1047368442541178880] &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -5,[Calculation_1642406548691226637])) // 최대일자보다 큰날짜 선택하면&#13;&#10;          AND [Calculation_1047368442541178880] &lt;= [Calculation_1642406548691226637]&#13;&#10;          AND //월 마지막일&#13;&#10;          ([Calculation_1947525423396868100] = [Calculation_1047368442541178880] OR [Calculation_1642406548691226637] = [Calculation_1047368442541178880])&#13;&#10;     ELSEIF DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2]) = DATETRUNC(&apos;month&apos;, [Calculation_1642406548691226637]) //최대일자의 월 = 찍은날짜와 같은 월&#13;&#10;     THEN DATETRUNC(&apos;month&apos;, [Calculation_1047368442541178880]) &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -5,[Parameters].[매개 변수 2])) // 5개월전~월마지막일, 선택일&#13;&#10;          AND DATETRUNC(&apos;month&apos;, [Calculation_1047368442541178880]) &lt;= DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2])&#13;&#10;          AND //월 마지막일&#13;&#10;          ([Calculation_1947525423396868100] = [Calculation_1047368442541178880] OR [Parameters]