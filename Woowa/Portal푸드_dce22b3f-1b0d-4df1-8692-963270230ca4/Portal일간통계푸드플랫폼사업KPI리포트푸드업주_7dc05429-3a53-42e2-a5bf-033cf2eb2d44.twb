      <column caption='Date_Text_Label_NEW' datatype='string' hidden='true' name='[C_Date_Label(복사본)_548876250991837188]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Calculation_821625503114539009]&#13;&#10;when &apos;일별&apos;&#13;&#10;then if len(str(DATEPART(&apos;month&apos;,[Parameters].[매개 변수 2]))) = 1&#13;&#10;     then MID(STR([Parameters].[매개 변수 2]),7,1)+&quot;월 &quot;&#13;&#10;&#13;&#10;     else MID(STR([Parameters].[매개 변수 2]),6,2)+&quot;월 &quot;&#13;&#10;     end&#13;&#10;     +&#13;&#10;     if len(str(DATEPART(&apos;day&apos;,[Parameters].[매개 변수 2]))) = 1&#13;&#10;     then MID(STR([Parameters].[매개 변수 2]),10,1)+&quot;일&quot;&#13;&#10;&#13;&#10;     else MID(STR([Parameters].[매개 변수 2]),9,2)+&quot;일&quot;&#13;&#10;     end&#13;&#10;     &#13;&#10;when &apos;주별&apos;&#13;&#10;then [week_nm]&#13;&#10;when &apos;월별&apos;&#13;&#10;then  &#13;&#10;IF len(str(DATEPART(&apos;month&apos;,[Parameters].[매개 변수 2]))) = 2&#13;&#10;then MID(STR([Parameters].[매개 변수 2]),3,2)+&quot;년 &quot;+MID(STR([Parameters].[매개 변수 2]),6,2) + &apos;월&apos;&#13;&#10;ELSE MID(STR([Parameters].[매개 변수 2]),3,2)+&quot;년 &quot;+MID(STR([Parameters].[매개 변수 2]),7,1) + &apos;월&apos;&#13;&#10;&#13;&#10;END&#13;&#10;END' />
      </column>
      <column caption='C_Date_Label_Treemap' datatype='string' name='[Calculation_1099722786090483714]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[p_Date_Type (copy)_2063211643064430614] &#13;&#10;WHEN &apos;주별&apos;&#13;&#10;then [week_nm]&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;then MID(STR(DATEPART(&apos;year&apos;, [Calculation_672725240686514184])),3,2) +&apos;년 &apos;+ STR(DATEPART(&apos;month&apos;, [Calculation_672725240686514184])) +&apos;월&apos;&#13;&#10;END' />
      </column>
      <column caption='F_Date_Clsf_Treemap' datatype='boolean' name='[Calculation_190277139104415759]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[p_Date_Type (copy)_2063211643064430614]&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN &#13;&#10;[std_cd] = &apos;W&apos; &#13;&#10;AND DATETRUNC(&apos;iso-week&apos;,[Calculation_672725240686514184]) = DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])  &#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN [std_cd] = &apos;M&apos;&#13;&#10;AND DATETRUNC(&apos;month&apos;,[Calculation_672725240686514184]) = DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2])  &#13;&#10;END' />
      </column>
      <column caption='c_Visit_Label_Member' datatype='string' name='[Calculation_672725240677638146]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[p_Date_Type (copy)_2063211643064430614]&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN &apos;DAU&apos;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN &apos;WAU&apos;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN &apos;MAU&apos;&#13;&#10;END' />
      </column>
      <column caption='F_Current_Date' datatype='boolean' hidden='true' name='[Calculation_672725240686039047]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN&#13;&#10;[std_cd] =&apos;W&apos;&#13;&#10;AND&#13;&#10;[Calculation_672725240686514184] = {FIXED : MAX(DATETRUNC(&apos;iso-week&apos;, [Calculation_672725240686514184]))}&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN&#13;&#10;[std_cd] =&apos;M&apos;&#13;&#10;AND&#13;&#10;[Calculation_672725240686514184] = {FIXED : MAX(DATETRUNC(&apos;month&apos;, [Calculation_672725240686514184]))}&#13;&#10;END' />
      </column>
      <column caption='C_Date' datatype='date' name='[Calculation_672725240686514184]' role='dimension' type='ordinal'>
