        <calculation class='tableau' formula='CASE [Parameters].[p_Date_Type (copy)_2063211643064430614] &#13;&#10;WHEN &apos;주별&apos;&#13;&#10;then [week_nm]&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;then MID(STR(DATEPART(&apos;year&apos;, [Calculation_672725240686514184])),3,2) +&apos;년 &apos;+ STR(DATEPART(&apos;month&apos;, [Calculation_672725240686514184])) +&apos;월&apos;&#13;&#10;END' />
