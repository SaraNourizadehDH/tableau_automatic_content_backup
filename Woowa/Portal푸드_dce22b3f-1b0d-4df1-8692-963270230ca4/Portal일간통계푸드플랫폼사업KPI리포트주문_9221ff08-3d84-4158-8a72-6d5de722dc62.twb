          <datasource-dependencies datasource='sqlproxy.0plehck0gb1la1109gdm7102vr0n'>
            <column caption='C_Date_Label_Weekday(Resizing)' datatype='string' name='[C_Date_Label_Weekday(복사본)_1443966677936713728]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[매개 변수 1]&#13;&#10;when &apos;일별&apos;&#13;&#10;then if len(str(DATEPART(&apos;month&apos;,[Calculation_488922077102366723]))) = 1&#13;&#10;     then MID(STR([Calculation_488922077102366723]),7,1)&#13;&#10;     else MID(STR([Calculation_488922077102366723]),6,2)&#13;&#10;     end&#13;&#10;     +&quot;/&quot;+&#13;&#10;     if len(str(DATEPART(&apos;day&apos;,[Calculation_488922077102366723]))) = 1&#13;&#10;     then MID(STR([Calculation_488922077102366723]),10,1)&#13;&#10;     else MID(STR([Calculation_488922077102366723]),9,2)&#13;&#10;     end&#13;&#10;     +&#13;&#10;     CHAR(10)&#13;&#10;     +&#13;&#10;     &quot;(&quot;+&#13;&#10;     CASE STR(DATEPART(&apos;weekday&apos;,[Calculation_488922077102366723]))&#13;&#10;     WHEN &apos;1&apos; THEN &quot;일&quot;&#13;&#10;     WHEN &apos;2&apos; THEN &quot;월&quot;&#13;&#10;     WHEN &apos;3&apos; THEN &quot;화&quot;&#13;&#10;     WHEN &apos;4&apos; THEN &quot;수&quot;&#13;&#10;     WHEN &apos;5&apos; THEN &quot;목&quot;&#13;&#10;     WHEN &apos;6&apos; THEN &quot;금&quot;&#13;&#10;     WHEN &apos;7&apos; THEN &quot;토&quot;&#13;&#10;     END&#13;&#10;     +&quot;)&quot;&#13;&#10;     &#13;&#10;when &apos;주별&apos;&#13;&#10;then [week_nm]&#13;&#10;when &apos;월별&apos;&#13;&#10;then  &#13;&#10;IF len(str(DATEPART(&apos;month&apos;,[Calculation_488922077102366723]))) = 2&#13;&#10;then MID(STR([Calculation_488922077102366723]),3,2)+&quot;년 &quot;+MID(STR([Calculation_488922077102366723]),6,2) + &apos;월&apos;&#13;&#10;ELSE MID(STR([Calculation_488922077102366723]),3,2)+&quot;년 &quot;+MID(STR([Calculation_488922077102366723]),7,1) + &apos;월&apos;&#13;&#10;&#13;&#10;END&#13;&#10;END' />
            </column>
            <column caption='F_Date_Clsf_Short' datatype='boolean' name='[Calculation_348747540008550403]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN&#13;&#10;[std_cd] = &apos;D&apos; &#13;&#10;AND DATETRUNC(&apos;day&apos;,[Calculation_488922077102366723]) &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;day&apos;, [Calculation_488922077102366723]) &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;day&apos;, -7,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN &#13;&#10;[std_cd] = &apos;W&apos; &#13;&#10;AND DATETRUNC(&apos;iso-week&apos;,[Calculation_488922077102366723]) &lt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;iso-week&apos;, [Calculation_488922077102366723]) &gt;= DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, -5,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN [std_cd] = &apos;M&apos;&#13;&#10;AND DATETRUNC(&apos;month&apos;,[Calculation_488922077102366723]) &lt;= DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;month&apos;, [Calculation_488922077102366723]) &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -5,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='푸드 Paid 비중%' datatype='real' name='[Calculation_348747540008775684]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([paid_ord_cnt]) / SUM([ord_cnt])' />
            </column>
            <column caption='배민(MP) Paid 비중%' datatype='real' name='[Calculation_348747540009115653]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([bm_paid_ord]) / sum([bm_ord])' />
