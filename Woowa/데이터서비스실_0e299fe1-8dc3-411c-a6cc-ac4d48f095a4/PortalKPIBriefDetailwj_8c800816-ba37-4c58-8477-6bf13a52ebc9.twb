              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;일별&apos; then iif([base_dur_cd]=&apos;D&apos; and datepart(&apos;day&apos;,[base_dt(복사본)_65020761998073886])%10=0, datepart(&apos;day&apos;,[base_dt(복사본)_65020761998073886]),null)&#10;WHEN &apos;주별&apos; THEN 1&#10;WHEN &apos;월별&apos; THEN iif([base_dur_cd]=&apos;M&apos; and datepart(&apos;month&apos;,[base_dt(복사본)_65020761998073886])%3=0, datepart(&apos;month&apos;,[base_dt(복사본)_65020761998073886]),null)&#10;END' />
