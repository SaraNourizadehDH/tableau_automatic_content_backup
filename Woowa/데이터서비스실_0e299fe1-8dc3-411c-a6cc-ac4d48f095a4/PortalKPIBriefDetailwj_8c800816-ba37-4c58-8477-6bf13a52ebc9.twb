      <column caption='C_x_axis' datatype='boolean' name='[Calculation_4088001851997872128]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//이번 기간 틀&#10;CASE [Parameters].[매개 변수 1]&#10;//&apos;일별&apos;&#10;when &apos;일별&apos; then&#10;[base_dt(복사본)_65020761998073886] &gt;= DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2 1 1])&#10;and&#10;[base_dt(복사본)_65020761998073886] &lt; DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2 1 1])) //틀&#10;//[base_dt] &lt;= DATETRUNC(&apos;day&apos;,[P_End_Date_Only])) //표시&#10;&#10;//&apos;주별&apos; -&gt; iso-week 시작일자가 월초보다 작아서 전월이면? 어떻게 하지?&#10;when &apos;주별&apos; then&#10;[base_dt(복사본)_65020761998073886] &gt;= DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2 1 1])&#10;and&#10;[base_dt(복사본)_65020761998073886] &lt;  DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2 1 1])) //틀&#10;&#10;//&apos;월별&apos;&#10;when &apos;월별&apos; then&#10;[base_dt(복사본)_65020761998073886] &gt;= DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2 1 1])&#10;and&#10;[base_dt(복사본)_65020761998073886] &lt;  DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2 1 1])) //틀&#10;&#10;END' />
      </column>
