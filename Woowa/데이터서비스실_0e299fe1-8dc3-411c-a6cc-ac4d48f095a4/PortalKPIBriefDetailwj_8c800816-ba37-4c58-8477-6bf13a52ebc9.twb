      <column caption='C_안내문구' datatype='string' name='[Calculation_3124301899927339017]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([F_당기_조회기간_앞값(복사본)_3124301899926814728]=0 and ([Parameters].[매개 변수 1] = &apos;주별&apos; or [Parameters].[매개 변수 1] = &apos;월별&apos;),&#10;&apos;이번 &apos;+[Calculation_3124301899932536843]+&apos; 데이터는 준비중입니다.&apos;,null)' />
