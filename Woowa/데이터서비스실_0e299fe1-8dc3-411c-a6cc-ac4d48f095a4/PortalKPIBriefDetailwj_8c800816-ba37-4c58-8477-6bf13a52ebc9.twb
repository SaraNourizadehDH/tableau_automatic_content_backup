        <calculation class='tableau' formula='IF &#10;([C_x_axis_일별틀(복사본)_4088001852004302851] or [f_당기_일(복사본)_4088001852022698002]) then &apos;당기&apos;&#10;ELSEIF &#10;([f_당월(복사본)_4088001852004421636] or [f_당기_월(복사본)_4088001852024950804]) then &apos;전기&apos;&#10;ELSEIF ([f_전월(복사본)_4088001852004487173] or [f_전년동기_일(복사본)_4088001852025151509]) then &apos;전기2&apos;&#10;END' />
