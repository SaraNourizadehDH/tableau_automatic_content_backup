        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos; AND DATEPART(&apos;day&apos;, [Calculation_1176846918537703426]) IN (1, 10, 20, 30)&#10;THEN&#10;    [Calculation_1176846918537703426]&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;주별&apos; then [Calculation_1176846918537703426]&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;월별&apos; and DATEPART(&apos;month&apos;, [Calculation_1176846918537703426]) in (3,6,9,12)&#10;THEN [Calculation_1176846918537703426]&#10;&#10;END' />
