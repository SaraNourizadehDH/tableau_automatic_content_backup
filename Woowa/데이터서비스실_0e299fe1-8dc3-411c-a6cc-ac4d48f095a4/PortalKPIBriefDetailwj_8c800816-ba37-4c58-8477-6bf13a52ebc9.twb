    <worksheet name='t1_1_간격_월'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Woowa/workbooks/PortalKPIBriefDetail_wj/t1_1___1?rev=' id='243517' path='/t/Woowa/workbooks/PortalKPIBriefDetail_wj' revision='' site='Woowa' />
      <layout-options>
        <caption>
          <formatted-text>
            <run>1) 축 간격 변경 검토 -  권장: 축 표기 자동 유지. 속도 이슈 발생 
      예) 일: 10일 간격 / 주: ? /월: 3개월 간격

   문제: 파라미터 변경에 따라 간격 조정 불가. 
   해결방법1: 차트를 세벌로 만들어주면 가능.
      예) 트렌트 차트 개수 x 3 (일/주/월)
   단점: 너무 많은 차트 수. 속도 이슈

  해결방법2: 축 날짜 표시를 제어하려면 축을 불연속형으로 변경하고
               축 표시용 시트를 추가하면 가능.
  단점: 트렌드 차트별로 한벌씩 추가됨. 속도 이슈

2) 누적 차트로 변경 검토 - 권장: 현재 뷰 유지하거나 조회기간을 줄이기
   문제: 대시보드에 배치시 당기값과 전기값 비교 힘듬. 같은라인에 표시되는 수준
   해결방법1: 조회기간을 줄이면 y축 비교불가 완화
   단점: 전기말일과의 비교 불가
   
3) 일자별 누적 비교시 앱 특성상 요일/휴일 등에 영향을 많이 받아 단순히 같은 날짜 비교가 좋지 않을 수 있음. 
  흐름으로 파악해야 할듯</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='DailyKPIs' name='sqlproxy.1ojdpa6162o0bh1f9zs2s0eja8sq' />
            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='P_Date_Type' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;일별&quot;'>
              <calculation class='tableau' formula='&quot;일별&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[sqlproxy.1ojdpa6162o0bh1f9zs2s0eja8sq].[Calculation_3656359971500007427]' caption='P_End_Date_Only' datatype='date' name='[매개 변수 2 1 1]' param-domain-type='any' role='measure' type='quantitative' value='#2025-06-26#'>
              <calculation class='tableau' formula='#2025-06-26#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.1ojdpa6162o0bh1f9zs2s0eja8sq'>
            <column caption='f_당기_일' datatype='boolean' name='[C_x_axis_일별틀(복사본)_4088001852004302851]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;when &apos;일별&apos; then&#10;(&#10;[base_dur_cd] = &apos;D&apos;&#10;and&#10;[base_dt(복사본)_65020761998073886] &gt;= DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2 1 1])&#10;and&#10;//[base_dt] &lt; DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[P_End_Date_Only]))&#10;[base_dt(복사본)_65020761998073886] &lt;= DATETRUNC(&apos;day&apos;,[Parameters].[매개 변수 2 1 1])&#10;)&#10;//)&#10;END' />
            </column>
            <column caption='C_x_axis_월별틀' datatype='boolean' name='[C_x_axis_일별틀(복사본)_4088001852029800471]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([f_당기_일(복사본)_4088001852022698002])&#10;or&#10;([f_당기_월(복사본)_4088001852024950804])&#10;or&#10;([f_전년동기_일(복사본)_4088001852025151509])' />
            </column>
            <column caption='C_컬러' datatype='string' name='[C_일별 컬러(복사본)_4088001852043427866]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;([C_x_axis_일별틀(복사본)_4088001852004302851] or [f_당기_일(복사본)_4088001852022698002]) then &apos;당기&apos;&#10;ELSEIF &#10;([f_당월(복사본)_4088001852004421636] or [f_당기_월(복사본)_4088001852024950804]) then &apos;전기&apos;&#10;ELSEIF ([f_전월(복사본)_4088001852004487173] or [f_전년동기_일(복사본)_4088001852025151509]) then &apos;전기2&apos;&#10;END' />
            </column>
            <column caption='C_Date_Label' datatype='datetime' default-format='*yy/mm/dd' name='[Calculation_1176846918537703426]' role='dimension' type='ordinal'>
