      <column caption='F_Date_현기간' datatype='boolean' name='[Calculation_1029354007451627522]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;when &apos;일별&apos; then&#10;[base_dur_cd] = &apos;D&apos; //AND DATETRUNC(&apos;day&apos;, [base_dt]) = DATETRUNC(&apos;day&apos;, TODAY()-1)&#10;and&#10;[base_dt(복사본)_65020761998073886] = [Parameters].[매개 변수 2 1 1]&#10;&#10;when &apos;주별&apos; then&#10;[base_dur_cd] = &apos;W&apos;&#10;and&#10;[base_dt(복사본)_65020761998073886] = DATETRUNC(&apos;iso-week&apos;,[Parameters].[매개 변수 2 1 1])&#10;&#10;when &apos;월별&apos; then&#10;[base_dur_cd] = &apos;M&apos;&#10;and&#10;[base_dt(복사본)_65020761998073886] = DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2 1 1])&#10;&#10;end' />
      </column>
      <column caption='F_트렌드' datatype='boolean' name='[Calculation_1176846918536708097]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;일별&apos;&#10;THEN&#10;DATETRUNC(&apos;day&apos;, [base_dt(복사본)_65020761998073886]) &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;day&apos;, -29, [Parameters].[매개 변수 2 1 1]))&#10;AND&#10;DATETRUNC(&apos;day&apos;, [base_dt(복사본)_65020761998073886]) &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2 1 1])&#10;AND [base_dur_cd] = &apos;D&apos;&#10;&#10;WHEN &apos;주별&apos;&#10;THEN DATETRUNC(&apos;iso-week&apos;, [base_dt(복사본)_65020761998073886]) &gt;= DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -11, [Parameters].[매개 변수 2 1 1]))&#10;AND&#10;DATETRUNC(&apos;iso-week&apos;, [base_dt(복사본)_65020761998073886]) &lt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2 1 1]) &#10;AND [base_dur_cd] = &apos;W&apos;&#10;&#10;WHEN &apos;월별&apos;&#10;THEN DATETRUNC(&apos;month&apos;, [base_dt(복사본)_65020761998073886]) &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -12, [Parameters].[매개 변수 2 1 1]))&#10;AND&#10;DATETRUNC(&apos;month&apos;, [base_dt(복사본)_65020761998073886]) &lt;= DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2 1 1]) &#10;AND [base_dur_cd] = &apos;M&apos;&#10;END' />
      </column>
      <column caption='C_Date_Label' datatype='datetime' default-format='*yy/mm/dd' name='[Calculation_1176846918537703426]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;일별&apos;&#10;THEN DATETRUNC(&apos;day&apos;, [base_dt(복사본)_65020761998073886])&#10;WHEN &apos;주별&apos;&#10;THEN DATETRUNC(&apos;iso-week&apos;, [base_dt(복사본)_65020761998073886])&#10;WHEN &apos;월별&apos;&#10;THEN DATETRUNC(&apos;month&apos;, [base_dt(복사본)_65020761998073886])&#10;END' />
