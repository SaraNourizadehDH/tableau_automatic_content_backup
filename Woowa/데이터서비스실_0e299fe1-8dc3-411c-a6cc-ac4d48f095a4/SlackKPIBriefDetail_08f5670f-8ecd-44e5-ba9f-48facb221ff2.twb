              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;일별&apos;&#10;THEN NULL&#10;&#10;WHEN &apos;주별&apos;&#10;THEN NULL&#10;&#10;WHEN &apos;월별&apos;&#10;THEN DATETRUNC(&apos;month&apos;, [base_dt(복사본)_65020761998073886]) &gt;= MAKEDATE(DATEPART(&apos;year&apos;, [Parameters].[매개 변수 2 1 1]) - 1, 1, 1)&#10;AND&#10;DATETRUNC(&apos;month&apos;, [base_dt(복사본)_65020761998073886]) &lt;= MAKEDATE(DATEPART(&apos;year&apos;, [Parameters].[매개 변수 2 1 1]) - 1, 12, 31)&#10;AND [base_dur_cd] = &apos;M&apos;&#10;END' />
