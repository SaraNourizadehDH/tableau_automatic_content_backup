        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;&#10;WHEN &apos;일별&apos; //전일대비&#10;THEN [base_dt(복사본)_65020761998073886] = DATEADD(&apos;iso-week&apos;,-1,DATETRUNC(&apos;day&apos;,[Parameters].[매개 변수 2 1 1]))&#10;and [base_dur_cd] = &apos;D&apos;&#10;&#10;END' />
