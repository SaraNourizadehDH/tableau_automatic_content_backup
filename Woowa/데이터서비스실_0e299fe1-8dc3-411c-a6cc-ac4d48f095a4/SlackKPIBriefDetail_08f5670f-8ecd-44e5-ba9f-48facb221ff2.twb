              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;일별&apos;&#10;THEN&#10;DATETRUNC(&apos;day&apos;, [base_dt(복사본)_65020761998073886]) &gt;= DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;week&apos;, 0, DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2 1 1])))&#10;AND&#10;DATETRUNC(&apos;day&apos;, [base_dt(복사본)_65020761998073886]) &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2 1 1])&#10;AND [base_dur_cd] = &apos;D&apos;&#10;&#10;WHEN &apos;주별&apos;&#10;THEN DATETRUNC(&apos;day&apos;, [base_dt(복사본)_65020761998073886]) &gt;= DATEADD(&apos;day&apos;, -7, MAKEDATE(DATEPART(&apos;year&apos;, [Parameters].[매개 변수 2 1 1]), 1, 1))&#10;AND&#10;DATETRUNC(&apos;month&apos;, [base_dt(복사본)_65020761998073886]) &lt;= IF [Parameters].[매개 변수 2 1 1] + 1 = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 1, [Parameters].[매개 변수 2 1 1])) &#10;                                    THEN [Parameters].[매개 변수 2 1 1] ELSE DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Parameters].[매개 변수 2 1 1])) END&#10;AND [base_dur_cd] = &apos;W&apos;&#10;&#10;WHEN &apos;월별&apos;&#10;THEN DATETRUNC(&apos;month&apos;, [base_dt(복사본)_65020761998073886]) &gt;= MAKEDATE(DATEPART(&apos;year&apos;, [Parameters].[매개 변수 2 1 1]), 1, 1)&#10;AND&#10;DATETRUNC(&apos;month&apos;, [base_dt(복사본)_65020761998073886]) &lt;= IF [Parameters].[매개 변수 2 1 1] + 1 = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 1, [Parameters].[매개 변수 2 1 1])) &#10;                                    THEN [Parameters].[매개 변수 2 1 1] ELSE DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Parameters].[매개 변수 2 1 1])) END&#10;AND [base_dur_cd] = &apos;M&apos;&#10;END' />
            </column>
            <column caption='F_트렌드_요일_주집계_월집계_전기' datatype='boolean' name='[F_트렌드_요일_일자_월집계_전기(복사본)_4039658527039877154]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;일별&apos;&#10;THEN&#10;DATETRUNC(&apos;day&apos;, [base_dt(복사본)_65020761998073886]) &gt;= DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2 1 1])))&#10;AND&#10;DATETRUNC(&apos;day&apos;, [base_dt(복사본)_65020761998073886]) &lt; DATETRUNC(&apos;iso-week&apos;, DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2 1 1]))&#10;AND [base_dur_cd] = &apos;D&apos;&#10;&#10;WHEN &apos;주별&apos;&#10;THEN DATETRUNC(&apos;day&apos;, [base_dt(복사본)_65020761998073886]) &gt;= DATEADD(&apos;day&apos;, -7, MAKEDATE(DATEPART(&apos;year&apos;, [Parameters].[매개 변수 2 1 1]) - 1, 1, 1))&#10;AND&#10;DATETRUNC(&apos;day&apos;, [base_dt(복사본)_65020761998073886]) &lt;= DATEADD(&apos;day&apos;, 7, MAKEDATE(DATEPART(&apos;year&apos;, [Parameters].[매개 변수 2 1 1]) - 1, 12, 31))&#10;AND [base_dur_cd] = &apos;W&apos;&#10;&#10;WHEN &apos;월별&apos;&#10;THEN DATETRUNC(&apos;month&apos;, [base_dt(복사본)_65020761998073886]) &gt;= MAKEDATE(DATEPART(&apos;year&apos;, [Parameters].[매개 변수 2 1 1]) - 1, 1, 1)&#10;AND&#10;DATETRUNC(&apos;month&apos;, [base_dt(복사본)_65020761998073886]) &lt;= MAKEDATE(DATEPART(&apos;year&apos;, [Parameters].[매개 변수 2 1 1]) - 1, 12, 31)&#10;AND [base_dur_cd] = &apos;M&apos;&#10;END' />
