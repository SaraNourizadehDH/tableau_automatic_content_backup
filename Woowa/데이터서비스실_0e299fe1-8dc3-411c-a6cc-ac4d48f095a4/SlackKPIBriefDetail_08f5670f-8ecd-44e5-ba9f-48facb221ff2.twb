            <column caption='C_chart_title' datatype='string' name='[Calculation_4039658527080419375]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [value_id]&#10;  WHEN &quot;FD_MS_004&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 2개월 배민M/S 트렌드&quot; //type1&#10;      WHEN &quot;주별&quot; THEN &quot;최근 15주 배민M/S 트렌드&quot; //type4&#10;      WHEN &quot;월별&quot; THEN &quot;전년 ~ 당월 배민M/S 트렌드&quot;  //type6&#10;    END&#10;  WHEN &quot;PF_CUST_001&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 2개월 DAU / 주문전환율 트렌드&quot; //type1&#10;      WHEN &quot;주별&quot; THEN &quot;최근 15주 WAU / 주문전환율 트렌드&quot; //type4&#10;      WHEN &quot;월별&quot; THEN &quot;전년 ~ 당월 MAU / 주문전환율 트렌드&quot;  //type6&#10;    END&#10;  WHEN &quot;PF_CUST_003&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 3주 요일별 주문전환율 트렌드&quot; //type2&#10;      WHEN &quot;주별&quot; THEN &quot;최근 15주 주문전환율 트렌드&quot; //type4&#10;      WHEN &quot;월별&quot; THEN &quot;전년 동월 대비 주문전환율 비교&quot; //type7&#10;    END&#10;  WHEN &quot;PF_CUST_005&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 2개월 배민클럽 구독회원수 트렌드&quot; //type1&#10;      WHEN &quot;주별&quot; THEN &quot;최근 15주 배민클럽 구독회원수 트렌드&quot; //type4&#10;      WHEN &quot;월별&quot; THEN &quot;전년 ~ 당월 배민클럽 구독회원수 트렌드&quot;  //type6&#10;    END&#10;  WHEN &quot;PF_CUST_006&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 2개월 배민클럽 구독 / 미구독 푸드 주문회원수 트렌드&quot; //type1&#10;      WHEN &quot;주별&quot; THEN &quot;최근 15주 배민클럽 구독 / 미구독 푸드 주문회원수 트렌드&quot; //type4&#10;      WHEN &quot;월별&quot; THEN &quot;전년 ~ 당월 배민클럽 구독 / 미구독 푸드 주문회원수 트렌드&quot;  //type6&#10;    END&#10;  WHEN &quot;FD_ORD_001&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 3주 요일별 푸드 주문수 트렌드&quot; //type2&#10;      WHEN &quot;주별&quot; THEN &quot;전년 동주차 대비 푸드 주문수 비교&quot; //type5&#10;      WHEN &quot;월별&quot; THEN &quot;전년 동월 대비 푸드 주문수 비교&quot; //type7&#10;    END&#10;  WHEN &quot;FD_ORD_002&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 2개월 OD Share 트렌드&quot; //type1&#10;      WHEN &quot;주별&quot; THEN &quot;최근 15주 OD Share 트렌드&quot; //type4&#10;      WHEN &quot;월별&quot; THEN &quot;전년 ~ 당월 OD Share 트렌드&quot;  //type6&#10;    END&#10;  WHEN &quot;FD_ORD_014&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 2개월 MFO 주문수 / MFO Share 트렌드&quot; //type1&#10;      WHEN &quot;주별&quot; THEN &quot;최근 15주 MFO 주문수 / MFO Share 트렌드&quot; //type4&#10;      WHEN &quot;월별&quot; THEN &quot;전년 ~ 당월 MFO 주문수 / MFO Share 트렌드&quot;  //type6&#10;    END&#10;  WHEN &quot;FD_DLRY_007&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 2개월 푸드 60분 초과율 트렌드&quot; //type1&#10;      WHEN &quot;주별&quot; THEN &quot;최근 15주 푸드 60분 초과율 트렌드&quot; //type4&#10;      WHEN &quot;월별&quot; THEN &quot;전년 동월 대비 푸드 60분 초과율 비교&quot; //type7&#10;    END&#10;  WHEN &quot;CM_ORD_003&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 3주 요일별 커머스 주문수 트렌드&quot; //type2&#10;      WHEN &quot;주별&quot; THEN &quot;전년 동주차 대비 커머스 주문수 비교&quot; //type5&#10;      WHEN &quot;월별&quot; THEN &quot;전년 동월 대비 커머스 주문수 비교&quot; //type7&#10;    END&#10;  WHEN &quot;CM_CUST_001&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 2개월 커머스UV / 주문전환율 트렌드&quot; //type1&#10;      WHEN &quot;주별&quot; THEN &quot;최근 15주 커머스UV / 주문전환율 트렌드&quot; //type4&#10;      WHEN &quot;월별&quot; THEN &quot;전년 ~ 당월 커머스UV / 주문전환율 트렌드&quot;  //type6&#10;    END&#10;  WHEN &quot;CM_CUST_004&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 3주 요일별 커머스 신규회원수 트렌드&quot; //type2&#10;      WHEN &quot;주별&quot; THEN &quot;전년 동주차 대비 커머스 신규회원수 비교&quot; //type5&#10;      WHEN &quot;월별&quot; THEN &quot;전년 동월 대비 커머스 신규회원수 비교&quot; //type7&#10;    END&#10;  WHEN &quot;CM_DLVRY_003&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 2개월 커머스 60분 초과율 트렌드&quot; //type1&#10;      WHEN &quot;주별&quot; THEN &quot;최근 15주 커머스 60분 초과율 트렌드&quot; //type4&#10;      WHEN &quot;월별&quot; THEN &quot;전년 동월 대비 커머스 60분 초과율 비교&quot; //type7&#10;    END&#10;  ELSE &quot;차트 1 제목 없음&quot;&#10;END' />
