        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;일별&apos;&#10;THEN&#10;DATETRUNC(&apos;day&apos;, [base_dt(복사본)_65020761998073886]) &gt;= DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;week&apos;, -2, DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2 1 1])))&#10;AND&#10;DATETRUNC(&apos;day&apos;, [base_dt(복사본)_65020761998073886]) &lt;  DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;week&apos;, -1, DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2 1 1])))&#10;AND [base_dur_cd] = &apos;D&apos;&#10;&#10;WHEN &apos;주별&apos;&#10;//THEN DATETRUNC(&apos;iso-week&apos;, [base_dt]) &gt;= DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -11, [P_End_Date_Only]))&#10;//AND&#10;//DATETRUNC(&apos;iso-week&apos;, [base_dt]) &lt;= DATETRUNC(&apos;iso-week&apos;, [P_End_Date_Only]) &#10;//AND [base_dur_cd] = &apos;W&apos;&#10;THEN NULL AND [base_dur_cd] = &apos;W&apos;&#10;&#10;WHEN &apos;월별&apos;&#10;//THEN DATETRUNC(&apos;month&apos;, [base_dt]) &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -12, [P_End_Date_Only]))&#10;//AND&#10;//DATETRUNC(&apos;month&apos;, [base_dt]) &lt;= DATETRUNC(&apos;month&apos;, [P_End_Date_Only]) &#10;//AND [base_dur_cd] = &apos;M&apos;&#10;THEN NULL AND [base_dur_cd] = &apos;M&apos;&#10;END' />
