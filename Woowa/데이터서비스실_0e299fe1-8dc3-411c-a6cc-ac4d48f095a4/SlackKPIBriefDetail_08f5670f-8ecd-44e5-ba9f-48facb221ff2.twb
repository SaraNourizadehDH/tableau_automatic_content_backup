            <column caption='C_당기 C_value(툴팁)' datatype='real' name='[C_당기 GPV(복사본)_1176846918641344574]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(IF [C_당기(복사본)_5916885504130863113] THEN [DAU(복사본)_3262717216502108175] END)' />
            </column>
            <column caption='F_당기_조회기간_앞값' datatype='boolean' name='[C_당기(복사본)_5916885504130863113]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;&#10;WHEN &apos;월별&apos;&#10;THEN [base_dt(복사본)_65020761998073886] = IF [Parameters].[매개 변수 2 1 1] + 1 = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 1, [Parameters].[매개 변수 2 1 1])) &#10;                 THEN [Parameters].[매개 변수 2 1 1] ELSE DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Parameters].[매개 변수 2 1 1])) END&#10;AND [base_dur_cd] = &apos;M&apos;&#10;&#10;WHEN &apos;주별&apos;&#10;//THEN [base_dt] = DATETRUNC(&apos;iso-week&apos;,[P_End_Date_Only])&#10;THEN [base_dt(복사본)_65020761998073886] = IF [Parameters].[매개 변수 2 1 1] + 1 = DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, 1, [Parameters].[매개 변수 2 1 1])) &#10;                 THEN [Parameters].[매개 변수 2 1 1] ELSE DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, -1, [Parameters].[매개 변수 2 1 1])) END&#10;AND [base_dur_cd] = &apos;W&apos;&#10;&#10;WHEN &apos;일별&apos;&#10;THEN [base_dt(복사본)_65020761998073886] = [Parameters].[매개 변수 2 1 1]&#10;AND [base_dur_cd] = &apos;D&apos;&#10;&#10;END' />
            </column>
            <column caption='C_전동기 C_value' datatype='real' name='[C_전동기 DAU(복사본)_3262717216502218774]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(IF [C_전동기(복사본)_5916885504132362251] THEN [DAU(복사본)_3262717216502108175] END)' />
            </column>
            <column caption='F_전동기_조회기간_앞값' datatype='boolean' name='[C_전동기(복사본)_5916885504132362251]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;&#10;WHEN &apos;월별&apos;&#10;//THEN [base_dt] = DATEADD(&apos;month&apos;,-1,DATETRUNC(&apos;month&apos;,[P_End_Date_Only]))&#10;THEN [base_dt(복사본)_65020761998073886] = IF [Parameters].[매개 변수 2 1 1] + 1 = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 1, [Parameters].[매개 변수 2 1 1])) &#10;                 THEN DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Parameters].[매개 변수 2 1 1]))&#10;                 ELSE DATEADD(&apos;month&apos;, -2, DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2 1 1]))&#10;                 END&#10;and [base_dur_cd] = &apos;M&apos;&#10;&#10;WHEN &apos;주별&apos;&#10;//THEN [base_dt] = DATEADD(&apos;iso-week&apos;,-1,DATETRUNC(&apos;iso-week&apos;,[P_End_Date_Only]))&#10;THEN [base_dt(복사본)_65020761998073886] = IF [Parameters].[매개 변수 2 1 1] + 1 = DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, 1, [Parameters].[매개 변수 2 1 1])) &#10;                 THEN DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, -1, [Parameters].[매개 변수 2 1 1]))&#10;                 ELSE DATEADD(&apos;iso-week&apos;, -2, DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2 1 1]))&#10;                 END&#10;and [base_dur_cd] = &apos;W&apos;&#10;&#10;&#10;&#10;WHEN &apos;일별&apos;&#10;THEN [base_dt(복사본)_65020761998073886] = DATEADD(&apos;day&apos;,-1,DATETRUNC(&apos;day&apos;,[Parameters].[매개 변수 2 1 1]))&#10;and [base_dur_cd] = &apos;D&apos;&#10;&#10;END' />
            </column>
            <column caption='C_전동기대비 C_value 증감' datatype='real' name='[C_전동기대비 DAU 증감(복사본)_3262717216502226967]' role='measure' type='quantitative'>
