            <column caption='P_Date_Type' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;일별&quot;'>
              <calculation class='tableau' formula='&quot;일별&quot;' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[sqlproxy.1ojdpa6162o0bh1f9zs2s0eja8sq].[Calculation_3656359971500007427]' caption='P_End_Date_Only' datatype='date' name='[매개 변수 2 1 1]' param-domain-type='any' role='measure' type='quantitative' value='#2025-07-23#'>
              <calculation class='tableau' formula='#2025-07-23#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.1ojdpa6162o0bh1f9zs2s0eja8sq'>
            <column caption='C_Date_Display_요일_주집계_월집계' datatype='string' name='[C_Date_Display_요일_일자_월집계(복사본)_4039658527042392105]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos; THEN [C_x_axis_월(복사본)_4039658526327476234]&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;주별&apos; THEN [C_x_axis_월(복사본)_4039658527042916394]&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;월별&apos; // and DATEPART(&apos;month&apos;, [C_Date_Label]) in (3,6,9,12)&#10;THEN [Calculation_4039658526327312393]&#10;END' />
            </column>
            <column caption='C_x_axis_요일' datatype='string' name='[C_x_axis_월(복사본)_4039658526327476234]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE DATEPART(&apos;weekday&apos;, [Calculation_1176846918537703426])&#10;WHEN 1 THEN &quot;일요일&quot;&#10;WHEN 2 THEN &quot;월요일&quot;&#10;WHEN 3 THEN &quot;화요일&quot;&#10;WHEN 4 THEN &quot;수요일&quot;&#10;WHEN 5 THEN &quot;목요일&quot;&#10;WHEN 6 THEN &quot;금요일&quot;&#10;WHEN 7 THEN &quot;토요일&quot;&#10;END' />
            </column>
            <column caption='C_x_axis_주차' datatype='string' name='[C_x_axis_월(복사본)_4039658527042916394]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([ww_seq])+&quot;주차&quot;' />
            </column>
            <column caption='C_이번주 value2' datatype='real' name='[C_이번주 value(복사본)_4039658527041069095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(IF [F_트렌드_요일_일자_월집계_당기(복사본)_4039658527039877153] THEN [value] END)' />
            </column>
            <column caption='C_이번주 value2(툴팁)' datatype='real' name='[C_이번주 value(툴팁)(복사본)_4039658527041069091]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(IF [F_트렌드_요일_일자_월집계_당기(복사본)_4039658527039877153] THEN [value] END)' />
            </column>
            <column caption='C_전전주 value2' datatype='real' name='[C_전전주 value(복사본)_4039658527041069092]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(IF [F_트렌드_요일_일자_월집계_전기2(복사본)_4039658527039877152] THEN [value] END)' />
            </column>
            <column caption='C_전전주 value2(툴팁)' datatype='real' name='[C_전전주 value(툴팁)(복사본)_4039658527041069094]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(IF [F_트렌드_요일_일자_월집계_전기2(복사본)_4039658527039877152] THEN [value] END)' />
            </column>
            <column caption='C_전주 value2' datatype='real' name='[C_전주 value(복사본)_4039658527041069093]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(IF [F_트렌드_요일_일자_월집계_전기(복사본)_4039658527039877154] THEN [value] END)' />
            </column>
            <column caption='C_전주 value2(툴팁)' datatype='real' name='[C_전주 value(툴팁)(복사본)_4039658527041069096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(IF [F_트렌드_요일_일자_월집계_전기(복사본)_4039658527039877154] THEN [value] END)' />
            </column>
            <column caption='C_Date_Label' datatype='datetime' default-format='*yy/mm/dd' name='[Calculation_1176846918537703426]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;일별&apos;&#10;THEN DATETRUNC(&apos;day&apos;, [base_dt(복사본)_65020761998073886])&#10;WHEN &apos;주별&apos;&#10;THEN DATETRUNC(&apos;iso-week&apos;, [base_dt(복사본)_65020761998073886])&#10;WHEN &apos;월별&apos;&#10;THEN DATETRUNC(&apos;month&apos;, [base_dt(복사본)_65020761998073886])&#10;END' />
            </column>
            <column caption='max(date)' datatype='date' name='[Calculation_3656359971500007427]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{fixed:MAX([base_dt(복사본)_65020761998073886])}' />
            </column>
            <column caption='C_x_axis_월' datatype='string' name='[Calculation_4039658526327312393]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE DATEPART(&apos;month&apos;, [Calculation_1176846918537703426])&#10;WHEN 1 THEN &quot;1월&quot;&#10;WHEN 2 THEN &quot;2월&quot;&#10;WHEN 3 THEN &quot;3월&quot;&#10;WHEN 4 THEN &quot;4월&quot;&#10;WHEN 5 THEN &quot;5월&quot;&#10;WHEN 6 THEN &quot;6월&quot;&#10;WHEN 7 THEN &quot;7월&quot;&#10;WHEN 8 THEN &quot;8월&quot;&#10;WHEN 9 THEN &quot;9월&quot;&#10;WHEN 10 THEN &quot;10월&quot;&#10;WHEN 11 THEN &quot;11월&quot;&#10;WHEN 12 THEN &quot;12월&quot;&#10;END' />
            </column>
            <column caption='C_value_div_nm' datatype='string' name='[Calculation_4948963433798164480]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [value_div_nm] &#10;WHEN &apos;그로스&apos; THEN &apos;a&apos;&#10;WHEN &apos;푸드&apos; THEN &apos;b&apos;&#10;WHEN &apos;커머스&apos; THEN &apos;c&apos;&#10;END' />
            </column>
            <column caption='F_트렌드_요일_주집계_월집계' datatype='boolean' name='[F_트렌드_요일_일자_월별집계(복사본)_4039658527038996511]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;일별&apos; //최근 3주 비교&#10;THEN  &#10;DATETRUNC(&apos;day&apos;, [base_dt(복사본)_65020761998073886]) &gt;= DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;week&apos;, -2, DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2 1 1])))&#10;AND&#10;DATETRUNC(&apos;day&apos;, [base_dt(복사본)_65020761998073886]) &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2 1 1])&#10;AND [base_dur_cd] = &apos;D&apos;&#10;&#10;WHEN &apos;주별&apos; //전년 1월부터 비교&#10;THEN DATETRUNC(&apos;day&apos;, [base_dt(복사본)_65020761998073886]) &gt;= DATEADD(&apos;day&apos;, -7, MAKEDATE(DATEPART(&apos;year&apos;, [Parameters].[매개 변수 2 1 1]) - 1, 1, 1))&#10;AND&#10;DATETRUNC(&apos;month&apos;, [base_dt(복사본)_65020761998073886]) &lt;= IF [Parameters].[매개 변수 2 1 1] + 1 = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 1, [Parameters].[매개 변수 2 1 1])) &#10;                                    THEN [Parameters].[매개 변수 2 1 1] ELSE DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Parameters].[매개 변수 2 1 1])) END&#10;AND [base_dur_cd] = &apos;W&apos;&#10;&#10;WHEN &apos;월별&apos; //전년 1월부터 비교&#10;THEN DATETRUNC(&apos;month&apos;, [base_dt(복사본)_65020761998073886]) &gt;= MAKEDATE(DATEPART(&apos;year&apos;, [Parameters].[매개 변수 2 1 1]) - 1, 1, 1)&#10;AND&#10;DATETRUNC(&apos;month&apos;, [base_dt(복사본)_65020761998073886]) &lt;= IF [Parameters].[매개 변수 2 1 1] + 1 = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 1, [Parameters].[매개 변수 2 1 1])) &#10;                                    THEN [Parameters].[매개 변수 2 1 1] ELSE DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Parameters].[매개 변수 2 1 1])) END&#10;AND [base_dur_cd] = &apos;M&apos;&#10;END' />
