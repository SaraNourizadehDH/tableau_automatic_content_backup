      <column caption='C_전주 value(툴팁)' datatype='real' name='[C_전주 value(복사본)_121949062664036360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(IF [F_트렌드_최근3주_3주전(복사본)_121949062637768706] THEN [value] END)' />
      </column>
      <column caption='C_전달 value' datatype='real' hidden='true' name='[C_전주 value(복사본)_121949062668582928]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(IF [F_트렌드_최근3주_전주(복사본)_121949062667722765] THEN [value] END)' />
      </column>
      <column caption='C_전주 value2' datatype='real' name='[C_전주 value(복사본)_4039658527041069093]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(IF [F_트렌드_요일_일자_월집계_전기(복사본)_4039658527039877154] THEN [value] END)' />
      </column>
      <column caption='C_전주 value2(툴팁)' datatype='real' name='[C_전주 value(툴팁)(복사본)_4039658527041069096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(IF [F_트렌드_요일_일자_월집계_전기(복사본)_4039658527039877154] THEN [value] END)' />
      </column>
      <column caption='F_Date_현기간' datatype='boolean' name='[Calculation_1029354007451627522]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;when &apos;일별&apos; then&#10;[base_dur_cd] = &apos;D&apos; //AND DATETRUNC(&apos;day&apos;, [base_dt]) = DATETRUNC(&apos;day&apos;, TODAY()-1)&#10;and&#10;[base_dt(복사본)_65020761998073886] = [Parameters].[매개 변수 2 1 1]&#10;&#10;when &apos;주별&apos; then&#10;[base_dur_cd] = &apos;W&apos;&#10;and&#10;//[base_dt] = DATETRUNC(&apos;iso-week&apos;,[P_End_Date_Only])&#10;[base_dt(복사본)_65020761998073886] = IF [Parameters].[매개 변수 2 1 1] + 1 = DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, 1, [Parameters].[매개 변수 2 1 1])) &#10;            THEN [Parameters].[매개 변수 2 1 1] ELSE DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, -1, [Parameters].[매개 변수 2 1 1])) END&#10;&#10;when &apos;월별&apos; then&#10;[base_dur_cd] = &apos;M&apos;&#10;and&#10;//[base_dt] = DATETRUNC(&apos;month&apos;,[P_End_Date_Only])&#10;[base_dt(복사본)_65020761998073886] = IF [Parameters].[매개 변수 2 1 1] + 1 = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 1, [Parameters].[매개 변수 2 1 1])) &#10;            THEN [Parameters].[매개 변수 2 1 1] ELSE DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Parameters].[매개 변수 2 1 1])) END&#10;&#10;end' />
      </column>
      <column caption='F_트렌드_최근2개월' datatype='boolean' name='[Calculation_1176846918536708097]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;일별&apos;&#10;THEN&#10;DATETRUNC(&apos;day&apos;, [base_dt(복사본)_65020761998073886]) &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;month&apos;, -2, [Parameters].[매개 변수 2 1 1]))&#10;AND&#10;DATETRUNC(&apos;day&apos;, [base_dt(복사본)_65020761998073886]) &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2 1 1])&#10;AND [base_dur_cd] = &apos;D&apos;&#10;&#10;WHEN &apos;주별&apos;&#10;THEN DATETRUNC(&apos;iso-week&apos;, [base_dt(복사본)_65020761998073886]) &gt;= DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -15, [Parameters].[매개 변수 2 1 1]))&#10;AND&#10;DATETRUNC(&apos;iso-week&apos;, [base_dt(복사본)_65020761998073886]) &lt;= MIN(DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2 1 1]) + 6,  // 이번 주 일요일&#10;                                   [Parameters].[매개 변수 2 1 1]) - 6&#10;AND [base_dur_cd] = &apos;W&apos;&#10;&#10;WHEN &apos;월별&apos;&#10;THEN DATETRUNC(&apos;month&apos;, [base_dt(복사본)_65020761998073886]) &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -24, [Parameters].[매개 변수 2 1 1]))&#10;AND&#10;DATETRUNC(&apos;month&apos;, [base_dt(복사본)_65020761998073886]) &lt;= IF [Parameters].[매개 변수 2 1 1] + 1 = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 1, [Parameters].[매개 변수 2 1 1])) &#10;                                    THEN [Parameters].[매개 변수 2 1 1] ELSE DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Parameters].[매개 변수 2 1 1])) END&#10;AND [base_dur_cd] = &apos;M&apos;&#10;END' />
      </column>
      <column caption='C_Date_Label' datatype='datetime' default-format='*yy/mm/dd' name='[Calculation_1176846918537703426]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;일별&apos;&#10;THEN DATETRUNC(&apos;day&apos;, [base_dt(복사본)_65020761998073886])&#10;WHEN &apos;주별&apos;&#10;THEN DATETRUNC(&apos;iso-week&apos;, [base_dt(복사본)_65020761998073886])&#10;WHEN &apos;월별&apos;&#10;THEN DATETRUNC(&apos;month&apos;, [base_dt(복사본)_65020761998073886])&#10;END' />
      </column>
      <column caption='C_전동기대비_Label' datatype='string' name='[Calculation_1176846918554660880]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;일별&apos;&#10;THEN &apos;DoD&apos;&#10;WHEN &apos;주별&apos;&#10;THEN &apos;WoW&apos;&#10;WHEN &apos;월별&apos;&#10;THEN &apos;MoM&apos;&#10;END' />
      </column>
      <column caption='C_value_커머스UV' datatype='real' name='[Calculation_121949062679834646]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(value_id = &apos;CM_CUST_001&apos;, [DAU(복사본)_3262717216502108175],NULL)' />
      </column>
      <column caption='C_안내문구' datatype='string' name='[Calculation_3124301899927339017]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([F_당기_조회기간_앞값(복사본)_3124301899926814728]=0 and ([Parameters].[매개 변수 1] = &apos;주별&apos; or [Parameters].[매개 변수 1] = &apos;월별&apos;),&#10;&apos;이번 &apos;+[Calculation_3124301899932536843]+&apos; 데이터는 준비중입니다.&apos;,&apos;%&apos;)' />
      </column>
      <column caption='c_dur_nm' datatype='string' name='[Calculation_3124301899932536843]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE  [Parameters].[매개 변수 1]&#10;WHEN &apos;일별&apos; THEN &apos;일&apos;&#10;WHEN &apos;주별&apos; THEN &apos;주&apos;&#10;WHEN &apos;월별&apos; THEN &apos;달&apos;&#10;END' />
      </column>
      <column caption='sorting' datatype='string' hidden='true' name='[Calculation_3656359971492577280]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [value_div_nm]&#10;when &apos;그로스&apos; then &apos;a&apos;&#10;when &apos;푸드&apos; then &apos;b&apos;&#10;when &apos;배달커머스&apos; then &apos;c&apos;&#10;END&#10;+&#10;right(&#10;&apos;00&apos;+str([rn])&#10;,3)' />
      </column>
      <column caption='max(date)' datatype='date' name='[Calculation_3656359971500007427]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed:MAX([base_dt(복사본)_65020761998073886])}' />
      </column>
      <column caption='C_x_axis_월' datatype='string' name='[Calculation_4039658526327312393]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE DATEPART(&apos;month&apos;, [Calculation_1176846918537703426])&#10;WHEN 1 THEN &quot;1월&quot;&#10;WHEN 2 THEN &quot;2월&quot;&#10;WHEN 3 THEN &quot;3월&quot;&#10;WHEN 4 THEN &quot;4월&quot;&#10;WHEN 5 THEN &quot;5월&quot;&#10;WHEN 6 THEN &quot;6월&quot;&#10;WHEN 7 THEN &quot;7월&quot;&#10;WHEN 8 THEN &quot;8월&quot;&#10;WHEN 9 THEN &quot;9월&quot;&#10;WHEN 10 THEN &quot;10월&quot;&#10;WHEN 11 THEN &quot;11월&quot;&#10;WHEN 12 THEN &quot;12월&quot;&#10;END' />
      </column>
      <column caption='C_x_axis_일자' datatype='string' name='[Calculation_4039658526329180172]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATEPART(&apos;month&apos;, [Calculation_1176846918537703426])) + &quot;.&quot; +&#10;STR(DATEPART(&apos;day&apos;, [Calculation_1176846918537703426])) + &quot;(&quot; +&#10;CASE DATEPART(&apos;weekday&apos;, [Calculation_1176846918537703426])&#10;    WHEN 1 THEN &quot;일&quot;&#10;    WHEN 2 THEN &quot;월&quot;&#10;    WHEN 3 THEN &quot;화&quot;&#10;    WHEN 4 THEN &quot;수&quot;&#10;    WHEN 5 THEN &quot;목&quot;&#10;    WHEN 6 THEN &quot;금&quot;&#10;    WHEN 7 THEN &quot;토&quot;&#10;END + &quot;)&quot;' />
      </column>
      <column caption='C_value_MFO주문수' datatype='real' name='[Calculation_4039658527020810267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(value_id = &apos;FD_ORD_014&apos;, [DAU(복사본)_3262717216502108175],NULL)' />
      </column>
      <column caption='C_chart_title' datatype='string' name='[Calculation_4039658527080419375]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [value_id]&#10;  WHEN &quot;FD_MS_004&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 2개월 배민M/S 트렌드&quot; //type1&#10;      WHEN &quot;주별&quot; THEN &quot;최근 15주 배민M/S 트렌드&quot; //type4&#10;      WHEN &quot;월별&quot; THEN &quot;전년 ~ 당월 배민M/S 트렌드&quot;  //type6&#10;    END&#10;  WHEN &quot;PF_CUST_001&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 2개월 DAU / 주문전환율 트렌드&quot; //type1&#10;      WHEN &quot;주별&quot; THEN &quot;최근 15주 WAU / 주문전환율 트렌드&quot; //type4&#10;      WHEN &quot;월별&quot; THEN &quot;전년 ~ 당월 MAU / 주문전환율 트렌드&quot;  //type6&#10;    END&#10;  WHEN &quot;PF_CUST_003&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 3주 요일별 주문전환율 트렌드&quot; //type2&#10;      WHEN &quot;주별&quot; THEN &quot;최근 15주 주문전환율 트렌드&quot; //type4&#10;      WHEN &quot;월별&quot; THEN &quot;전년 동월 대비 주문전환율 비교&quot; //type7&#10;    END&#10;  WHEN &quot;PF_CUST_005&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 2개월 배민클럽 구독회원수 트렌드&quot; //type1&#10;      WHEN &quot;주별&quot; THEN &quot;최근 15주 배민클럽 구독회원수 트렌드&quot; //type4&#10;      WHEN &quot;월별&quot; THEN &quot;전년 ~ 당월 배민클럽 구독회원수 트렌드&quot;  //type6&#10;    END&#10;  WHEN &quot;PF_CUST_006&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 2개월 배민클럽 구독 / 미구독 푸드 주문회원수 트렌드&quot; //type1&#10;      WHEN &quot;주별&quot; THEN &quot;최근 15주 배민클럽 구독 / 미구독 푸드 주문회원수 트렌드&quot; //type4&#10;      WHEN &quot;월별&quot; THEN &quot;전년 ~ 당월 배민클럽 구독 / 미구독 푸드 주문회원수 트렌드&quot;  //type6&#10;    END&#10;  WHEN &quot;FD_ORD_001&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 3주 요일별 푸드 주문수 트렌드&quot; //type2&#10;      WHEN &quot;주별&quot; THEN &quot;전년 동주차 대비 푸드 주문수 비교&quot; //type5&#10;      WHEN &quot;월별&quot; THEN &quot;전년 동월 대비 푸드 주문수 비교&quot; //type7&#10;    END&#10;  WHEN &quot;FD_ORD_002&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 2개월 OD Share 트렌드&quot; //type1&#10;      WHEN &quot;주별&quot; THEN &quot;최근 15주 OD Share 트렌드&quot; //type4&#10;      WHEN &quot;월별&quot; THEN &quot;전년 ~ 당월 OD Share 트렌드&quot;  //type6&#10;    END&#10;  WHEN &quot;FD_ORD_014&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 2개월 MFO 주문수 / MFO Share 트렌드&quot; //type1&#10;      WHEN &quot;주별&quot; THEN &quot;최근 15주 MFO 주문수 / MFO Share 트렌드&quot; //type4&#10;      WHEN &quot;월별&quot; THEN &quot;전년 ~ 당월 MFO 주문수 / MFO Share 트렌드&quot;  //type6&#10;    END&#10;  WHEN &quot;FD_DLRY_007&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 2개월 푸드 60분 초과율 트렌드&quot; //type1&#10;      WHEN &quot;주별&quot; THEN &quot;최근 15주 푸드 60분 초과율 트렌드&quot; //type4&#10;      WHEN &quot;월별&quot; THEN &quot;전년 동월 대비 푸드 60분 초과율 비교&quot; //type7&#10;    END&#10;  WHEN &quot;CM_ORD_003&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 3주 요일별 커머스 주문수 트렌드&quot; //type2&#10;      WHEN &quot;주별&quot; THEN &quot;전년 동주차 대비 커머스 주문수 비교&quot; //type5&#10;      WHEN &quot;월별&quot; THEN &quot;전년 동월 대비 커머스 주문수 비교&quot; //type7&#10;    END&#10;  WHEN &quot;CM_CUST_001&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 2개월 커머스UV / 주문전환율 트렌드&quot; //type1&#10;      WHEN &quot;주별&quot; THEN &quot;최근 15주 커머스UV / 주문전환율 트렌드&quot; //type4&#10;      WHEN &quot;월별&quot; THEN &quot;전년 ~ 당월 커머스UV / 주문전환율 트렌드&quot;  //type6&#10;    END&#10;  WHEN &quot;CM_CUST_004&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 3주 요일별 커머스 신규회원수 트렌드&quot; //type2&#10;      WHEN &quot;주별&quot; THEN &quot;전년 동주차 대비 커머스 신규회원수 비교&quot; //type5&#10;      WHEN &quot;월별&quot; THEN &quot;전년 동월 대비 커머스 신규회원수 비교&quot; //type7&#10;    END&#10;  WHEN &quot;CM_DLVRY_003&quot; THEN&#10;    CASE [Parameters].[매개 변수 1]&#10;      WHEN &quot;일별&quot; THEN &quot;최근 2개월 커머스 60분 초과율 트렌드&quot; //type1&#10;      WHEN &quot;주별&quot; THEN &quot;최근 15주 커머스 60분 초과율 트렌드&quot; //type4&#10;      WHEN &quot;월별&quot; THEN &quot;전년 동월 대비 커머스 60분 초과율 비교&quot; //type7&#10;    END&#10;  ELSE &quot;차트 1 제목 없음&quot;&#10;END' />
      </column>
      <column caption='C_X_axis' datatype='integer' name='[Calculation_4088001852023320595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;일별&apos; THEN iif([base_dur_cd]=&apos;D&apos;,DATEPART(&apos;day&apos;, [base_dt(복사본)_65020761998073886]),null)&#10;WHEN &apos;주별&apos; THEN 1&#10;WHEN &apos;월별&apos; THEN 1 //iif([base_dur_cd]=&apos;M&apos;,DATEPART(&apos;month&apos;, [base_dt]),null)&#10;END' />
      </column>
      <column caption='C_Date_Display_일자집계' datatype='datetime' name='[Calculation_4088001852100571188]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos; AND DATEPART(&apos;weekday&apos;, [Calculation_1176846918537703426]) IN (2)&#10;THEN&#10;    [Calculation_1176846918537703426]&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;주별&apos; then [Calculation_1176846918537703426]&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;월별&apos; // and DATEPART(&apos;month&apos;, [C_Date_Label]) in (3,6,9,12)&#10;THEN [Calculation_1176846918537703426]&#10;&#10;END' />
      </column>
      <column caption='C_value_div_nm' datatype='string' name='[Calculation_4948963433798164480]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [value_div_nm] &#10;WHEN &apos;그로스&apos; THEN &apos;a&apos;&#10;WHEN &apos;푸드&apos; THEN &apos;b&apos;&#10;WHEN &apos;커머스&apos; THEN &apos;c&apos;&#10;END' />
      </column>
      <column caption='C_div_rn' datatype='string' name='[Calculation_4955718833574600719]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_4948963433798164480]+&#10;right(&apos;00&apos;+[rn],3)' />
