          <datasource-dependencies datasource='sqlproxy.1ojdpa6162o0bh1f9zs2s0eja8sq'>
            <column caption='C_Date_Display_2개월일자_15주주간_작년월비교' datatype='string' name='[C_Date_Display_요일_일자_월집계(복사본)_4039658526382280722]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos; THEN [Calculation_4039658526329180172]&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;주별&apos; THEN [Calculation_4039658526329180172]&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;월별&apos; // and DATEPART(&apos;month&apos;, [C_Date_Label]) in (3,6,9,12)&#10;THEN [Calculation_4039658526327312393]&#10;END' />
            </column>
