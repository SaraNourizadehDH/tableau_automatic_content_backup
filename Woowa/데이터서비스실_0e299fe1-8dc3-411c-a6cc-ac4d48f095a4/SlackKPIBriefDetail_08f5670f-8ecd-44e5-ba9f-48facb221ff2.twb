              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN &apos;일별&apos;&#10;THEN&#10;DATETRUNC(&apos;day&apos;, [base_dt(복사본)_65020761998073886]) &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;month&apos;, -2, [Parameters].[매개 변수 2 1 1]))&#10;AND&#10;DATETRUNC(&apos;day&apos;, [base_dt(복사본)_65020761998073886]) &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2 1 1])&#10;AND [base_dur_cd] = &apos;D&apos;&#10;&#10;WHEN &apos;주별&apos;&#10;THEN DATETRUNC(&apos;iso-week&apos;, [base_dt(복사본)_65020761998073886]) &gt;= DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -15, [Parameters].[매개 변수 2 1 1]))&#10;AND&#10;DATETRUNC(&apos;iso-week&apos;, [base_dt(복사본)_65020761998073886]) &lt;= MIN(DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2 1 1]) + 6,  // 이번 주 일요일&#10;                                   [Parameters].[매개 변수 2 1 1]) - 6&#10;AND [base_dur_cd] = &apos;W&apos;&#10;&#10;WHEN &apos;월별&apos;&#10;THEN DATETRUNC(&apos;month&apos;, [base_dt(복사본)_65020761998073886]) &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -24, [Parameters].[매개 변수 2 1 1]))&#10;AND&#10;DATETRUNC(&apos;month&apos;, [base_dt(복사본)_65020761998073886]) &lt;= IF [Parameters].[매개 변수 2 1 1] + 1 = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, 1, [Parameters].[매개 변수 2 1 1])) &#10;                                    THEN [Parameters].[매개 변수 2 1 1] ELSE DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -1, [Parameters].[매개 변수 2 1 1])) END&#10;AND [base_dur_cd] = &apos;M&apos;&#10;END' />
