        <calculation class='tableau' formula='{fixed [task_end_date(복사본)_309481802883883011],[dag_id],[task_id] :&#10;max([created_at(복사본)_385620782460129291])} = [created_at(복사본)_385620782460129291]' />
      </column>
      <column caption='가이드_배치관리' datatype='string' name='[Calculation_5559482651831353344]' role='dimension' type='nominal'>
