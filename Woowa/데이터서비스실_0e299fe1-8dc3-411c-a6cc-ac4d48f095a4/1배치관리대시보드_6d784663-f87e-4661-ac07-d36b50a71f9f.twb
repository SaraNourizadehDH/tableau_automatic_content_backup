        <calculation class='tableau' formula='{fixed [dag_id],[task_id]: &#10;avg(&#10;if [기간필터_대시보드2(복사본)_561472277231382531] = &apos;Y&apos; then [runminute] &#10;else null end&#10;)&#10;}' />
