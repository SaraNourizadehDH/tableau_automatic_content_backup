      <column caption='기간필터_기간매개변수' datatype='string' name='[Calculation_307722581846908930]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if date([created_at(복사본)_385620782460129291])&gt;=[Parameters].[매개 변수 1] and date([created_at(복사본)_385620782460129291]) &lt;=[Parameters].[매개 변수 2] then &apos;Y&apos; else &apos;N&apos; end' />
      </column>
      <column caption='batch count' datatype='integer' name='[Calculation_307722581847625731]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count([id])' />
      </column>
      <column caption='task_end_date' datatype='datetime' name='[Calculation_309481802881769472]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[created_at(복사본)_385620782460129291]' />
      </column>
      <column caption='count' datatype='integer' name='[Calculation_309481802902241285]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 4] = &apos;batch count&apos; then [Calculation_307722581847625731]&#10;ELSEIF [Parameters].[매개 변수 4] = &apos;task count&apos; then [배치 수(복사본)_309481802896318468]&#10;ELSEIF [Parameters].[매개 변수 4] = &apos;dag count&apos; then [task count(복사본)_309481802902900742]&#10;END' />
      </column>
      <column caption='이슈 유형' datatype='string' name='[Calculation_309481802909573130]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [status] = &apos;failure&apos; then &apos;오류&apos;&#10;elseif [killed_task] &gt;= 1 then &apos;리소스 부족&apos;&#10;END' />
      </column>
      <column caption='관리 DAG 구분' datatype='string' name='[Calculation_309481802924445710]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if CONTAINS([dag_id],&apos;dataeng&apos;) = true then &apos;Y&apos;&#10;else &apos;N&apos;&#10;end' />
      </column>
      <column caption='당일' datatype='date' name='[Calculation_385620782452604928]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date(now())' />
      </column>
      <column caption='dag_start_date' datatype='datetime' name='[Calculation_385620782459432969]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{ include [dag_id]: min([task_end_date(복사본)_309481802882899969]) }' />
      </column>
      <column caption='task kill yn' datatype='string' name='[Calculation_385620786304495628]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [killed_task] &gt; 0 then &apos;Y&apos; else &apos;N&apos; end' />
      </column>
      <column caption='배치소요 30%증가 임계치(연)' datatype='real' name='[Calculation_400679690333810691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[배치소요(일주일평균)(분)(복사본)_400679690330042369]*1.3' />
      </column>
      <column caption='배치 소요시간 30%증가 여부' datatype='boolean' name='[Calculation_400679690333941764]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[배치소요(당일)(복사본)_385620722177081368]&#10;&gt;[Calculation_400679690333810691]' />
