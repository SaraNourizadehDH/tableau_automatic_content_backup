      </column>
      <column caption='전월 지연시간' datatype='boolean' name='[Calculation_400679690357223438]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//20분&#10;if [Calculation_400679690352173068] - [dag 종료시간(전월)(복사본)_400679690357055501]&#10;&gt;= 20 * 60 &#10;then true else false end' />
      </column>
      <column caption='dag 종료시간(평균) hms' datatype='datetime' name='[Calculation_400679690358620175]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='maketime(int(avg([dag 시작시간(복사본)_400679690351673354])/3600),&#10;int(avg([dag 시작시간(복사본)_400679690351673354])%3600/60),&#10;int(avg([dag 시작시간(복사본)_400679690351673354])%3600%60))' />
      </column>
