      <column caption='task_start_ss' datatype='integer' name='[Calculation_400679690348314630]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;,[task_end_date(복사본)_309481802882899969])*60*60&#10;+&#10;DATEPART(&apos;minute&apos;,[task_end_date(복사본)_309481802882899969])*60&#10;+&#10;DATEPART(&apos;second&apos;, [task_end_date(복사본)_309481802882899969])' />
      </column>
      <column caption='dag 종료시간(전월)' datatype='real' name='[Calculation_400679690352173068]' role='measure' type='quantitative'>
