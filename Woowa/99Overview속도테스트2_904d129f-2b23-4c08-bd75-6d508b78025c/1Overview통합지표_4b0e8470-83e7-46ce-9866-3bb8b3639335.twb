    <worksheet name='6-2-1. 고객상담만족도_라인_고객'>
      <table>
        <view>
          <datasources>
            <datasource caption='1_CS_Overview' name='sqlproxy.0ca8e600xtjhxi14opje40l5aua7' />
            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='P_Date_Type' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;주별&quot;'>
              <calculation class='tableau' formula='&quot;주별&quot;' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...source-field='[sqlproxy.0ca8e600xtjhxi14opje40l5aua7].[part_date]' caption='P_End_Date_Only' datatype='date' name='[매개 변수 2]' param-domain-type='range' role='measure' type='quantitative' value='#2025-02-12#'>
              <calculation class='tableau' formula='#2025-02-12#' />
            </column>
            <column caption='P_합계/일평균' datatype='string' name='[매개 변수 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;합계&quot;'>
              <calculation class='tableau' formula='&quot;합계&quot;' />
            </column>
            <column caption='P_SVC_LV1' datatype='string' name='[매개 변수 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;ALL&quot;'>
              <calculation class='tableau' formula='&quot;ALL&quot;' />
            </column>
            <column caption='P_SVC_LV2' datatype='string' name='[매개 변수 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;ALL&quot;'>
              <calculation class='tableau' formula='&quot;ALL&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0ca8e600xtjhxi14opje40l5aua7'>
            <column caption='C_고객상담만족도(0-5점)' datatype='real' name='[C_당기_고객상담만족도(복사본)_3372070286368923725]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3]&#13;&#10;WHEN &apos;일평균&apos;&#13;&#10;THEN (SUM({ FIXED [base_dt_type], [part_date], [lv1_svc_cd], [lv2_svc_cd], [cs_ch_cd], [cs_cust_div_cd] : MIN([sum_score])})/[Calculation_4099683100082352142])&#13;&#10;    /&#13;&#10;    (SUM({ FIXED [base_dt_type], [part_date], [lv1_svc_cd], [lv2_svc_cd], [cs_ch_cd], [cs_cust_div_cd] : MIN([score_cnt])})/[Calculation_4099683100082352142])&#13;&#10;&#13;&#10;WHEN &apos;합계&apos;&#13;&#10;THEN SUM({ FIXED [base_dt_type], [part_date], [lv1_svc_cd], [lv2_svc_cd], [cs_ch_cd], [cs_cust_div_cd] : MIN([sum_score])})&#13;&#10;    /&#13;&#10;    SUM({ FIXED [base_dt_type], [part_date], [lv1_svc_cd], [lv2_svc_cd], [cs_ch_cd], [cs_cust_div_cd] : MIN([score_cnt])})&#13;&#10;END' />
            </column>
            <column caption='F_SVC_LV1' datatype='boolean' name='[Calculation_1186417029114380290]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 6] = &apos;ALL&apos; THEN TRUE&#13;&#10;ELSE [Parameters].[매개 변수 6] = [lv1_svc_cd] &#13;&#10;END' />
            </column>
            <column caption='cs_ch_nm' datatype='string' name='[Calculation_3274116992349745157]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [cs_ch_cd]&#13;&#10;WHEN &apos;In&apos; THEN &apos;전화&apos;&#13;&#10;WHEN &apos;Chat&apos; THEN &apos;채팅&apos;&#13;&#10;END' />
            </column>
            <column caption='F_조회기간' datatype='boolean' name='[Calculation_3388395833563369523]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos; AND [base_dt_type] = &apos;D&apos;&#13;&#10;THEN DATETRUNC(&apos;day&apos;, DATEADD(&apos;day&apos;, -14, [Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;day&apos;, [part_date])&#13;&#10;AND DATETRUNC(&apos;day&apos;, [part_date]) &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;주별&apos; AND [base_dt_type] = &apos;W&apos;&#13;&#10;THEN DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, -11, [Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;day&apos;, [part_date])&#13;&#10;AND DATETRUNC(&apos;day&apos;, [part_date]) &lt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;월별&apos; AND [base_dt_type] = &apos;M&apos;&#13;&#10;THEN DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -12, [Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;day&apos;, [part_date])&#13;&#10;AND DATETRUNC(&apos;day&apos;, [part_date]) &lt;= DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='C_일평균_분모' datatype='integer' name='[Calculation_4099683100082352142]' role='measure' type='ordinal'>
