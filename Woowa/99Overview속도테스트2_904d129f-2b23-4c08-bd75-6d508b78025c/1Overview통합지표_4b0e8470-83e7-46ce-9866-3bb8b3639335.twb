              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3]&#13;&#10;WHEN &apos;일평균&apos;&#13;&#10;THEN SUM({ FIXED [base_dt_type], [part_date], [lv1_svc_cd], [Calculation_3274116992349745157], [cs_cust_div_cd] : MIN([slfsvc_req_cnt])})&#13;&#10;    /&#13;&#10;    [Calculation_4099683100082352142]&#13;&#10;&#13;&#10;WHEN &apos;합계&apos;&#13;&#10;THEN SUM({ FIXED [base_dt_type], [part_date], [lv1_svc_cd], [Calculation_3274116992349745157], [cs_cust_div_cd] : MIN([slfsvc_req_cnt])})&#13;&#10;END' />
