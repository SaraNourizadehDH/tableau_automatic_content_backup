          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0ca8e600xtjhxi14opje40l5aua7'>
            <column caption='C_시도주문수' datatype='real' name='[C_당기_시도주문수(복사본)_3388395833569447988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3]&#13;&#10;WHEN &apos;일평균&apos;&#13;&#10;THEN (&#13;&#10;    SUM({ FIXED [base_dt_type], [part_date], [lv1_svc_cd], [lv2_svc_cd], [dlvry_mgmt_type_cd], [is_stod] : MIN([try_ord_cnt])})&#13;&#10;    /&#13;&#10;    [Calculation_4099683100082352142]&#13;&#10;)&#13;&#10;WHEN &apos;합계&apos;&#13;&#10;THEN SUM({ FIXED [base_dt_type], [part_date], [lv1_svc_cd], [lv2_svc_cd], [dlvry_mgmt_type_cd], [is_stod] : MIN([try_ord_cnt])})&#13;&#10;END' />
            </column>
            <column caption='C_취소주문수' datatype='real' name='[C_시도주문수(복사본)_5051912947685937164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3]&#13;&#10;WHEN &apos;일평균&apos;&#13;&#10;THEN (&#13;&#10;    SUM({ FIXED [base_dt_type], [part_date], [lv1_svc_cd], [lv2_svc_cd], [dlvry_mgmt_type_cd], [is_stod] : MIN([cancel_ord_cnt])})&#13;&#10;    /&#13;&#10;    [Calculation_4099683100082352142]&#13;&#10;)&#13;&#10;WHEN &apos;합계&apos;&#13;&#10;THEN SUM({ FIXED [base_dt_type], [part_date], [lv1_svc_cd], [lv2_svc_cd], [dlvry_mgmt_type_cd], [is_stod] : MIN([cancel_ord_cnt])})&#13;&#10;END' />
            </column>
            <column caption='F_SVC_LV1' datatype='boolean' name='[Calculation_1186417029114380290]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 6] = &apos;ALL&apos; THEN TRUE&#13;&#10;ELSE [Parameters].[매개 변수 6] = [lv1_svc_cd] &#13;&#10;END' />
            </column>
            <column caption='F_조회기간' datatype='boolean' name='[Calculation_3388395833563369523]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos; AND [base_dt_type] = &apos;D&apos;&#13;&#10;THEN DATETRUNC(&apos;day&apos;, DATEADD(&apos;day&apos;, -14, [Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;day&apos;, [part_date])&#13;&#10;AND DATETRUNC(&apos;day&apos;, [part_date]) &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;주별&apos; AND [base_dt_type] = &apos;W&apos;&#13;&#10;THEN DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, -11, [Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;day&apos;, [part_date])&#13;&#10;AND DATETRUNC(&apos;day&apos;, [part_date]) &lt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;월별&apos; AND [base_dt_type] = &apos;M&apos;&#13;&#10;THEN DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -12, [Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;day&apos;, [part_date])&#13;&#10;AND DATETRUNC(&apos;day&apos;, [part_date]) &lt;= DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='C_일평균_분모' datatype='integer' name='[Calculation_4099683100082352142]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX({ FIXED [part_date], [base_dt_type] : MAX([date_cnt]) })' />
            </column>
            <column caption='C_주문취소율' datatype='real' name='[Calculation_5051912947686125581]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[C_시도주문수(복사본)_5051912947685937164]/[C_당기_시도주문수(복사본)_3388395833569447988]' />
