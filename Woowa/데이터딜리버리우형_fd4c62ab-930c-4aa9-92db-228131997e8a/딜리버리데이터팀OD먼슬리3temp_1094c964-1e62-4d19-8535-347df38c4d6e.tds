    <relation connection='athena.045i3hl1ev2hxo16dnwjo1gvxztt' name='사용자 지정 SQL 쿼리' type='text'>WITH&#10;-- 데이터 조회 기간&#10;date_range as (&#10;    select format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;12&apos; month, &apos;yyyy-MM-dd&apos;) as start_date_str&#10;        , format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;1&apos; day, &apos;yyyy-MM-dd&apos;) as end_date_str&#10;        , format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;0&apos; day, &apos;yyyy-MM-dd&apos;) as end_date_str_plus1&#10;)&#10;&#10;, date_dim as (&#10;    select date&#10;        , date_key&#10;        , date_base&#10;        , first_day_of_week&#10;        , first_day_of_month as part_key&#10;        -- , date as part_key&#10;    from deliverydata.date_dim&#10;    inner join date_range on date between start_date_str and end_date_str_plus1&#10;)&#10;&#10;, dlv_hist as (&#10;    select rider_latitude, rider_longitude, rider_id as rider_no&#10;        , created_date as alloc_date&#10;        , concat_ws(&apos;_&apos;, delivery_business_day, delivery_sn) as dlvry_id&#10;        , row_number() over (partition by delivery_business_day, delivery_sn, rider_id order by last_modified_date desc) as row_num&#10;    from sbtasty.delivery_history&#10;    inner join date_range on delivery_business_day between replace(start_date_str,&apos;-&apos;,&apos;&apos;) and replace(end_date_str,&apos;-&apos;,&apos;&apos;)&#10;    where type=&apos;DELIVERY_ALLOCATE_CONFIRMATION&apos;&#10;)&#10;&#10;, dlv_hist2 as (&#10;    select *&#10;    from dlv_hist&#10;    where row_num=1&#10;)&#10;&#10;-- 배차취소 --&#10;, cancel as (&#10;    select concat(business_day,&apos;_&apos;,sn) as dlvry_id&#10;        , count(1) as cnt_cancel&#10;        , sum(case when type=&apos;UNABLE_TO_LOAD&apos; then 1 else 0 end) as cnt_cancel_unable_to_load&#10;        , sum(case when type=&apos;DELAY_IN_PICKUP_PREPARATION&apos; then 1 else 0 end) as cnt_cancel_delay_in_pickup_preparation&#10;        , sum(case when type=&apos;CLICK_MISTAKE&apos; then 1 else 0 end) as cnt_cancel_click_mistake&#10;        , sum(case when type=&apos;DELIVERY_METHOD_BREAKDOWN&apos; then 1 else 0 end) as cnt_cancel_delivery_method_breakdown&#10;        , sum(case when type=&apos;WEATHER_PROBLEM&apos; then 1 else 0 end) as cnt_cancel_weather_problem&#10;        , sum(case when type=&apos;RIDER_FEE_COMPLAINTS&apos; then 1 else 0 end) as cnt_cancel_rider_fee_complaints&#10;        , sum(case when type=&apos;RIDER_ACCIDENT&apos; then 1 else 0 end) as cnt_cancel_rider_accident&#10;        , sum(case when type=&apos;UNABLE_TO_FIND_LOCATIONS&apos; then 1 else 0 end) as cnt_cancel_unable_to_find_locations&#10;        , sum(case when type=&apos;ETC&apos; then 1 else 0 end) as cnt_cancel_etc&#10;        -- , array_distinct(array_agg(rider_id) filter (where rider_id is not null)) as agg_rider&#10;    from sbtasty.allocation_cancel&#10;    inner join date_range on part_date between start_date_str and end_date_str_plus1&#10;    group by 1&#10;)&#10;&#10;-- 지급대상 배달료 --&#10;, fee as (&#10;    select dlvry_id&#10;            , sum(case when fee_detail_type = &apos;base&apos; then fee end) as base_fee&#10;            , sum(case when fee_detail_type = &apos;premium&apos; then fee end) as premium_fee&#10;            , sum(case when fee_detail_type = &apos;weather&apos; then fee end) as weather_fee&#10;            , sum(case when fee_detail_type = &apos;area&apos; then fee end) as area_fee&#10;            , sum(case when fee_detail_type = &apos;variable&apos; then fee end) as variable_fee&#10;            , sum(case when fee_detail_type = &apos;manual&apos; then fee end) as manual_fee&#10;            , sum(case when fee_detail_type = &apos;etc&apos; then fee end) as etc_fee&#10;            , sum(fee) as total_fee&#10;    from (&#10;        select dlvry_id&#10;             , case when type = &apos;BASE&apos; then &apos;base&apos;&#10;                    when type = &apos;PREMIUM&apos; then &apos;premium&apos;&#10;                    when (type = &apos;WEATHER&apos; or (type = &apos;VARIABLE_PROMOTION&apos; and regexp_like(displayName, &apos;기상&apos;))) then &apos;weather&apos; -- 기상할증 : 20231220_변프로인해수정&#10;                    when type = &apos;AREA&apos; then &apos;area&apos;&#10;                    when type in (&apos;PROMOTION&apos;, &apos;VARIABLE_PROMOTION&apos;) AND regexp_like(displayName, case when business_day &lt;&lt; &apos;20231201&apos; then &apos;기피|마트&apos; else &apos;지역|마트&apos; end) then &apos;area&apos; -- 딜리버리운영팀에서 기존 설정된 할증들도 12/1 부터 기피|마트 -&gt;&gt; 지역|마트 키워드로 수정 적용되도록 작업 예정&#10;                    when type = &apos;VARIABLE_PROMOTION&apos; and baseFee &lt;&lt;&gt;&gt; maximumFee then &apos;variable&apos;&#10;                    when type = &apos;VARIABLE_PROMOTION&apos; and baseFee = maximumFee then &apos;manual&apos;&#10;                    else &apos;etc&apos; end as fee_detail_type&#10;             , sum(fee) as fee&#10;        from (&#10;            select dlvry_id&#10;                , type&#10;                , fee&#10;                --  , json_format(json_extract(explains, if(type = &apos;PROMOTION&apos;, &apos;$.name&apos;, &apos;$.displayName&apos;))) as displayName&#10;                , coalesce(displayName, name) as displayName&#10;                -- , json_format(json_extract(json_extract(explains, &apos;$.calculateExplain&apos;), &apos;$.baseFee&apos;)) as baseFee&#10;                -- , json_format(json_extract(json_extract(explains, &apos;$.calculateExplain&apos;), &apos;$.maximumFee&apos;)) as maximumFee&#10;                , baseFee&#10;                , maximumFee&#10;                , business_day&#10;            from (&#10;                select concat(business_day, &apos;_&apos;, sn) as dlvry_id&#10;                     , type&#10;                     , explains&#10;                     , json_extract_scalar(explains, &apos;$.displayName&apos;) as displayName&#10;                     , json_extract_scalar(explains, &apos;$.name&apos;) as name&#10;                     , json_extract_scalar(explains, &apos;$.calculateExplain.maximumFee&apos;) as maximumFee&#10;                     , json_extract_scalar(explains, &apos;$.calculateExplain.baseFee&apos;) as baseFee&#10;                     , fee&#10;                     , business_day&#10;                from sbtasty.applied_rider_fee&#10;                inner join date_range on part_date between start_date_str and end_date_str&#10;                where applied = 1&#10;            )&#10;        )&#10;        GROUP BY 1, 2&#10;    )&#10;    group by 1&#10;)&#10;&#10;-- init : 첫 데이터 추출 서브 쿼리로 가장 기본이 되는 데이터 추출 &#10;, init as (&#10;    select *&#10;        , greatest(_consign_reg_diff - start_reg_diff, 0) as consign_start_diff&#10;        -- , least(greatest(date_diff(&apos;second&apos;, reg_date, ai_first_rec_dttm)/60e0 - start_reg_diff, 0), greatest(_consign_reg_diff - start_reg_diff, 0)) as ai_first_rec_time_min&#10;        , date_diff(&apos;second&apos;, expected_pick_dttm, arrived_shop_date) / 60e0 as arrived_pickE_diff&#10;        , date_diff(&apos;second&apos;, coalesce(order_sheet_accepted_at, reg_date), hand_over_date) / 60e0 as hand_reg_diff -- 배민스토어의 경우 주문접수 시점으로 반영 / 나머지는 배달 생성 시점&#10;        , date_diff(&apos;second&apos;, coalesce(order_sheet_accepted_at, reg_date), reg_date) / 60e0 as reg_acc_diff -- 배달생성대기시간 배민스토어 제외 나머지 0&#10;        , date_diff(&apos;second&apos;, coalesce(order_sheet_accepted_at, reg_date), ds_notificated_date) / 60e0 as noti1_reg_diff&#10;        , date_diff(&apos;second&apos;, coalesce(order_sheet_accepted_at, reg_date), consign_date) / 60e0 as consign_reg_diff&#10;        , case when svc in (&apos;bms_sg&apos;, &apos;bms_cm&apos;) then &apos;store&apos;&#10;               when svc in (&apos;bm1_sg&apos;, &apos;bm1_cm&apos;) then &apos;baemin1&apos;&#10;               else svc end svc_grp&#10;    from (&#10;        select *&#10;        from(&#10;            select business_day&#10;                , business_day as part_date&#10;                , ord_no&#10;                , hour(reg_date) as reg_hour&#10;                , pickup_supervisor_zone_id&#10;                , date_format(date_add(&apos;minute&apos;, greatest(if(pick_up_tm_min = &apos;INSTANT&apos;, 0, cast(split_part(pick_up_tm_min, &apos;_&apos;, 2) as int)) - 15, 0), reg_date), &apos;%Y-%m-%d %H:%i:00&apos;) as kor_dttm_key &#10;                , rider_no&#10;                , dlvry_status&#10;                , additional_delivery_detail_id&#10;                , case when order_type=&apos;BERA&apos; and delivery_carry_type=&apos;SINGLE&apos; then &apos;bm1_sg&apos;&#10;                       when order_type=&apos;BERA&apos; and delivery_carry_type=&apos;COMMON&apos; then &apos;bm1_cm&apos;&#10;                       when order_service_type=&apos;MARKET&apos; then &apos;bmart&apos;&#10;                       when order_service_type=&apos;BAEMIN_STORE&apos; and delivery_carry_type=&apos;SINGLE&apos; then &apos;bms_sg&apos;&#10;                       when order_service_type=&apos;BAEMIN_STORE&apos; and delivery_carry_type=&apos;COMMON&apos; then &apos;bms_cm&apos;&#10;                       else &apos;else&apos; end as svc&#10;                , dlvry_id&#10;                , rider_dlvry_fee&#10;                , reg_date&#10;                , coalesce(alloc_date, consign_date) as consign_date&#10;                , pick_up_date&#10;                , hand_over_date&#10;                , min_expected_delivery_time_minute&#10;                , max_expected_delivery_time_minute&#10;                , ds_notificated_date&#10;                , if(pick_up_tm_min = &apos;INSTANT&apos;, 0, cast(split_part(pick_up_tm_min, &apos;_&apos;, 2) as int)) as pick_prep_time&#10;                , greatest(if(pick_up_tm_min = &apos;INSTANT&apos;, 0, cast(split_part(pick_up_tm_min, &apos;_&apos;, 2) as int)) - 15, 0) as start_reg_diff&#10;                , date_add(&apos;minute&apos;, if(pick_up_tm_min = &apos;INSTANT&apos;, 0, cast(split_part(pick_up_tm_min, &apos;_&apos;, 2) as int)), coalesce(pickup_preparation_requested_date, cook_requested_date)) as expected_pick_dttm&#10;                , date_diff(&apos;second&apos;, reg_date, coalesce(alloc_date, consign_date, ds_cancel_date)) / 60e0 as _consign_reg_diff&#10;                , date_diff(&apos;second&apos;, pick_up_date, hand_over_date) / 60e0 as hand_pick_diff&#10;                , date_diff(&apos;second&apos;, coalesce(alloc_date, consign_date), hand_over_date) / 60e0 as hand_consign_diff&#10;                , date_diff(&apos;second&apos;, arrived_shop_date , pick_up_date) / 60e0 as pick_arrived_diff&#10;                , date_diff(&apos;second&apos;, coalesce(alloc_date, consign_date) , pick_up_date) / 60e0 as pick_consign_diff&#10;                , pickup_preparation_requested_date&#10;                , arrived_shop_date&#10;                , shop_no&#10;                , dlvry_distance&#10;                , auto_allocated&#10;                , actual_dlvry_distance&#10;                , part_key&#10;                , rider_delivery_method&#10;            from sbtasty.dlvry2&#10;            inner join date_range on business_day between start_date_str and end_date_str&#10;            left join date_dim on business_day = date&#10;            left join dlv_hist2 using (dlvry_id, rider_no)&#10;            where 1=1&#10;                and additional_delivery_detail_id is null -- recall is null (재배달, 회수배달, 추가배달 제외)&#10;                and agency_id &lt;&lt;&gt;&gt; 13 -- dlv.agency_name not like &apos;%테스트%&apos; (테스트 지점 제외)&#10;        )&#10;        left join (&#10;            select order_id as ord_no&#10;                , origin_order_id&#10;            from sbtasty.bmart_order_relation&#10;            inner join date_range on part_date between start_date_str and end_date_str_plus1&#10;        ) using (ord_no)&#10;        left join (&#10;            select order_no as origin_order_id&#10;                , order_sheet_accepted_at + interval &apos;9&apos; hour as order_sheet_accepted_at&#10;            from cmplf_order.order_sheet&#10;            inner join date_range on part_date between start_date_str and end_date_str_plus1&#10;            where service_type = &apos;BAEMIN_STORE&apos;&#10;                and delivery_type = &apos;QUICK&apos;&#10;        ) using (origin_order_id)&#10;    ) dlv&#10;    left join sbtasty.rider rider&#10;        on dlv.rider_no = rider.rider_id&#10;    left join fee using (dlvry_id)&#10;    left join cancel using (dlvry_id)&#10;)&#10;&#10;, cancel_dlv as (&#10;    select part_key&#10;        , coalesce(svc_grp, &apos;total&apos;) as svc_grp&#10;        , coalesce(svc, &apos;total&apos;) as svc&#10;        , &apos;전체&apos; as rgn&#10;        , &apos;LEVEL_all&apos; as inf_lv_grp&#10;        , 0 as inf_lv&#10;        , count(1) as cnt_cancel_dlv&#10;        , sum(is_consign_start_diff_more_30min) as cancel_consign_start_diff_more_30min&#10;    from (&#10;        select *&#10;            , case when consign_start_diff &gt;&gt;= 30 then 1 else 0 end as is_consign_start_diff_more_30min&#10;        from init&#10;        where dlvry_status = &apos;CANCEL_DELIVERY&apos;&#10;    )&#10;    group by grouping sets ((part_key, svc_grp, svc)&#10;                        , (part_key, svc_grp)&#10;                        , (part_key))&#10;)&#10;&#10;-- AI거절 --&#10;, rej0 as (&#10;    select *&#10;    from(&#10;        select rejected_date&#10;            , concat_ws(&apos;_&apos;, bd, sn) as dlvry_id&#10;            , rider_id&#10;        from sbtasty.auto_allocate_reject&#10;        inner join date_range on part_date between start_date_str and end_date_str&#10;        where rejecter = &apos;RIDER&apos;&#10;            and reason in (&apos;(자동배차 거절)&apos;, &apos;라이더에 의해 취소된 배달&apos;)&#10;    )&#10;    left join (&#10;        select part_key&#10;            , business_day&#10;            , dlvry_id&#10;            , svc_grp&#10;            , svc&#10;        from init&#10;    ) using(dlvry_id)&#10;)&#10;&#10;, rej1 as (&#10;    select *&#10;        , lead(rejected_date) over (partition by business_day, rider_id order by rejected_date) as lead_rejected_date&#10;        , lag(rejected_date) over (partition by business_day, rider_id order by rejected_date) as lag_rejected_date&#10;        -- , lead(svc) over (partition by business_day, rider_id order by rejected_date) as lead_svc&#10;        -- , lag(svc) over (partition by business_day, rider_id order by rejected_date) as lag_svc&#10;    from rej0&#10;)&#10;&#10;, rej2 as (&#10;    select *&#10;        , case when date_diff(&apos;second&apos;, lag_rejected_date, rejected_date) &lt;&lt;= 0 then 0&#10;               when date_diff(&apos;second&apos;, rejected_date, lead_rejected_date) &lt;&lt;= 0 then 1&#10;               else null end as delta&#10;    from rej1&#10;)&#10;&#10;, rej3 as (&#10;    select *&#10;        , sum(case when delta is null then 1 else delta end) over (partition by business_day, rider_id order by rejected_date) as bundle_key&#10;    from rej2&#10;)&#10;&#10;, rej4 as (&#10;    select *&#10;        , array_agg(svc) over (partition by business_day, rider_id, bundle_key) as agg_svc&#10;        -- , count(1) over (partition by business_day, rider_id, bundle_key) as cnt&#10;    from rej3&#10;)&#10;&#10;, rej5 as (&#10;    select *&#10;        -- , cardinality(array_distinct(agg_svc)) as cnt_distinct_svc&#10;        , case when all_match(agg_svc, x -&gt;&gt; x = svc) then &apos;pure&apos;&#10;               when all_match(agg_svc, x -&gt;&gt; x in (&apos;bm1_sg&apos;, &apos;bm1_cm&apos;)) then &apos;integ&apos;&#10;               when all_match(agg_svc, x -&gt;&gt; x in (&apos;bm1_cm&apos;, &apos;bms_cm&apos;)) then &apos;mixed&apos;&#10;               else null end as check_svc&#10;        -- , sum(case when bundle is not null then 1 end) over (partition by business_day, rider_id, bundle) as cnt_bundle&#10;        -- , sum(case when integ is not null then 1 end) over (partition by business_day, rider_id, integ) as cnt_integ&#10;        -- , sum(case when mixed is not null then 1 end) over (partition by business_day, rider_id, mixed) as cnt_mixed&#10;    from rej4&#10;)&#10;&#10;, rej6 as (&#10;    select *&#10;        , sum(case when check_svc = &apos;pure&apos; then 1 end) over (partition by business_day, rider_id, bundle_key) as cnt_bundle&#10;        , sum(case when check_svc = &apos;integ&apos; then 1 end) over (partition by business_day, rider_id, bundle_key, svc) as cnt_integ&#10;        , sum(case when check_svc = &apos;mixed&apos; then 1 end) over (partition by business_day, rider_id, bundle_key, svc) as cnt_mixed&#10;    from rej5&#10;)&#10;&#10;, rej7 as (&#10;    select part_key&#10;        , svc_grp&#10;        , svc&#10;        , dlvry_id&#10;        , count(1) as cnt_total_rej&#10;        , sum(case when cnt_bundle &gt;&gt; 1 then 1e0/cnt_bundle else 0 end) as cnt_bundle_rej&#10;        , sum(case when cnt_bundle = 1 then 1 else 0 end) as cnt_single_rej&#10;        , sum(case when cnt_integ &gt;&gt;= 1 then 1e0/cnt_integ else 0 end) as cnt_integ_rej&#10;        , sum(case when cnt_mixed &gt;&gt;= 1 then 1e0/cnt_mixed else 0 end) as cnt_mixed_rej&#10;        -- , sum(case when delta2 is null and delta is not null then 1e0/cnt_bundle else 1 end) as cnt_rej&#10;    from rej6&#10;    group by 1,2,3,4&#10;)&#10;&#10;, rej8 as (&#10;    select part_key&#10;        , coalesce(svc_grp, &apos;total&apos;) as svc_grp&#10;        , coalesce(svc, &apos;total&apos;) as svc&#10;        , &apos;전체&apos; as rgn&#10;        , &apos;LEVEL_all&apos; as inf_lv_grp&#10;        , 0 as inf_lv&#10;        , sum(cnt_total_rej) as total_rej&#10;        , sum(case when cnt_total_rej &gt;&gt;= 10 then 1 else 0 end) as more10_rej_dlv&#10;        , sum(cnt_bundle_rej) as bundle_rej&#10;        , sum(cnt_single_rej) as single_rej&#10;        , sum(cnt_integ_rej) as integ_rej&#10;        , sum(cnt_mixed_rej) as mixed_rej&#10;    from rej7&#10;    group by grouping sets ((part_key, svc_grp, svc)&#10;                        , (part_key, svc_grp)&#10;                        , (part_key))&#10;)&#10;&#10;, cancel2 as (&#10;    select part_key&#10;        , coalesce(svc_grp, &apos;total&apos;) as svc_grp&#10;        , coalesce(svc, &apos;total&apos;) as svc&#10;        , &apos;전체&apos; as rgn&#10;        , &apos;LEVEL_all&apos; as inf_lv_grp&#10;        , 0 as inf_lv&#10;        , sum(cnt_cancel) as cnt_cancel&#10;        , sum(cnt_cancel_unable_to_load) as cnt_cancel_unable_to_load&#10;        , sum(cnt_cancel_delay_in_pickup_preparation) as cnt_cancel_delay_in_pickup_preparation&#10;        , sum(cnt_cancel_click_mistake) as cnt_cancel_click_mistake&#10;        , sum(cnt_cancel_delivery_method_breakdown) as cnt_cancel_delivery_method_breakdown&#10;        , sum(cnt_cancel_weather_problem) as cnt_cancel_weather_problem&#10;        , sum(cnt_cancel_rider_fee_complaints) as cnt_cancel_rider_fee_complaints&#10;        , sum(cnt_cancel_rider_accident) as cnt_cancel_rider_accident&#10;        , sum(cnt_cancel_unable_to_find_locations) as cnt_cancel_unable_to_find_locations&#10;        , sum(cnt_cancel_etc) as cnt_cancel_etc&#10;        -- , cardinality(array_distinct(flatten(array_agg(case when svc=&apos;bm1_sg&apos; then agg_rider end)))) as num_cancel_rider&#10;    from init&#10;    group by grouping sets ((part_key, svc_grp, svc)&#10;                        , (part_key, svc_grp)&#10;                        , (part_key))&#10;)&#10;&#10;-- init에서 배달품질 및 묶음효율 등의 기본이 되는 필터링 조건 적용 &amp; 추가 컬럼 생성&#10;, base as (&#10;    select *&#10;        -- , lead(pick_up_date) over (partition by business_day, rider_no order by pick_up_date, hand_over_date, consign_date) as lead_pick_up_date&#10;        -- , max(hand_over_date) over (partition by business_day, rider_no order by pick_up_date, hand_over_date, consign_date rows between unbounded preceding and 1 preceding) as lag_max_hand_over_date&#10;        -- , lead(svc) over (partition by business_day, rider_no order by consign_date, pick_up_date, hand_over_date) as lead_svc&#10;        , lead(consign_date) over (partition by business_day, rider_no order by consign_date, pick_up_date, hand_over_date) as lead_consign_date&#10;        -- , lag(svc) over (partition by business_day, rider_no order by consign_date, pick_up_date, hand_over_date) as lag_svc&#10;        , lag(consign_date) over (partition by business_day, rider_no order by consign_date, pick_up_date, hand_over_date) as lag_consign_date&#10;        , case when hand_reg_diff between min_expected_delivery_time_minute and max_expected_delivery_time_minute then 1 end as is_dlv_time_between_expected_dlv_time&#10;        , case when noti1_reg_diff between min_expected_delivery_time_minute and max_expected_delivery_time_minute then 1 end as is_noti_time_between_expected_dlv_time&#10;        , case when hand_reg_diff &gt;&gt; max_expected_delivery_time_minute + 10 then 1 end as is_dlv_time_over_max_expected_dlv_time_plus_10min&#10;        , case when hand_reg_diff &gt;&gt; max_expected_delivery_time_minute + 15 then 1 end as is_dlv_time_over_max_expected_dlv_time_plus_15min&#10;        , case when hand_reg_diff &gt;&gt; max_expected_delivery_time_minute + 20 then 1 end as is_dlv_time_over_max_expected_dlv_time_plus_20min&#10;        , case when hand_reg_diff between noti1_reg_diff - 10 and noti1_reg_diff + 10 then 1 end as is_dlv_time_between_customer_guidance_time_10min&#10;        , case when hand_reg_diff &gt;&gt; noti1_reg_diff + 10 then 1 end as is_dlv_time_over_customer_guidance_time_plus_10min&#10;        , case when hand_reg_diff &gt;&gt; noti1_reg_diff + 20 then 1 end as is_dlv_time_over_customer_guidance_time_plus_20min&#10;        , case when hand_reg_diff &gt;&gt; 60 then 1 end as is_dlv_time_over_60min&#10;        , case when hand_pick_diff &gt;&gt; 30 then 1 end as is_hand_pick_diff_over_30min&#10;        , case when arrived_pickE_diff &gt;&gt; 0 then 1 end as is_arrived_pickE_diff_over_0min&#10;        , case when arrived_pickE_diff &gt;&gt; 10 then 1 end as is_arrived_pickE_diff_over_10min&#10;        , case when pick_arrived_diff &gt;&gt; 5 then 1 end as is_pick_arrived_diff_over_5min&#10;        , case when consign_start_diff &gt;&gt;= 30 then 1 end as is_consign_start_diff_more_30min&#10;        , case when rider_delivery_method = &apos;BIKE&apos; then 1 end as is_bike&#10;    from init&#10;    where dlvry_status = &apos;COMPLETED_DELIVERY&apos;&#10;        and rider_type in (&apos;CROWDSOURCING&apos;, &apos;INDIVIDUAL_OWNER&apos;)&#10;        and rider_dlvry_fee &gt;&gt; 0&#10;)&#10;&#10;, fee2 as (&#10;    select part_key&#10;        , coalesce(svc_grp, &apos;total&apos;) as svc_grp&#10;        , coalesce(svc, &apos;total&apos;) as svc&#10;        , &apos;전체&apos; as rgn&#10;        , &apos;LEVEL_all&apos; as inf_lv_grp&#10;        , 0 as inf_lv&#10;        , sum(base_fee) as base_fee&#10;        , sum(premium_fee) as premium_fee&#10;        , sum(weather_fee) as weather_fee&#10;        , sum(area_fee) as area_fee&#10;        , sum(variable_fee) as variable_fee&#10;        , sum(manual_fee) as manual_fee&#10;        , sum(etc_fee) as etc_fee&#10;        , sum(total_fee) as total_fee&#10;    from base&#10;    group by grouping sets ((part_key, svc_grp, svc)&#10;                        , (part_key, svc_grp)&#10;                        , (part_key))&#10;)&#10;&#10;-- 주문수 --&#10;, cnt_ord as (&#10;    select part_key&#10;        , coalesce(svc_grp, &apos;total&apos;) as svc_grp&#10;        , coalesce(svc, &apos;total&apos;) as svc&#10;        , &apos;전체&apos; as rgn&#10;        , &apos;LEVEL_all&apos; as inf_lv_grp&#10;        , 0 as inf_lv&#10;        , count(1) as cnt_ord&#10;    from init&#10;    where pick_up_date is not null&#10;        and rider_dlvry_fee &gt;&gt; 0&#10;    group by grouping sets ((part_key, svc_grp, svc)&#10;                        , (part_key, svc_grp)&#10;                        , (part_key))&#10;)&#10;&#10;, fee3 as (&#10;    select part_key&#10;        , svc_grp&#10;        , svc&#10;        , rgn&#10;        , inf_lv_grp&#10;        , inf_lv&#10;        , cnt_ord&#10;        , base_fee/cnt_ord as base_fee&#10;        , premium_fee/cnt_ord as premium_fee&#10;        , weather_fee/cnt_ord as weather_fee&#10;        , area_fee/cnt_ord as area_fee&#10;        , variable_fee/cnt_ord as variable_fee&#10;        , manual_fee/cnt_ord as manual_fee&#10;        , etc_fee/cnt_ord as etc_fee&#10;        , total_fee/cnt_ord as total_fee&#10;    from fee2&#10;    join cnt_ord using (part_key, svc_grp, svc, rgn, inf_lv_grp, inf_lv)&#10;)&#10;&#10;, raw as (&#10;    select *&#10;        , case when abs(date_diff(&apos;second&apos;, lag_consign_date, consign_date))&lt;&lt;=1 then 0&#10;               when abs(date_diff(&apos;second&apos;, consign_date, lead_consign_date))&lt;&lt;=1 then 1&#10;               else null end delta&#10;    from base&#10;)&#10;&#10;, raw0 as (&#10;    select *&#10;        , sum(case when delta is null then 1 else delta end) over (partition by business_day, rider_no order by consign_date, pick_up_date, hand_over_date) as bundle_key&#10;    from raw&#10;)&#10;&#10;, raw1 as (&#10;    select *&#10;        , array_agg(svc) over (partition by business_day, rider_no, bundle_key) as agg_svc&#10;        -- , count(1) over (partition by business_day, rider_no, bundle_key) as cnt&#10;    from raw0&#10;)&#10;&#10;, raw2 as (&#10;    select *&#10;        -- , cardinality(array_distinct(agg_svc)) as cnt_distinct_svc&#10;        , case when all_match(agg_svc, x -&gt;&gt; x = svc) then &apos;pure&apos;&#10;               when all_match(agg_svc, x -&gt;&gt; x in (&apos;bm1_sg&apos;, &apos;bm1_cm&apos;)) then &apos;integ&apos;&#10;               when all_match(agg_svc, x -&gt;&gt; x in (&apos;bm1_cm&apos;, &apos;bms_cm&apos;)) then &apos;mixed&apos;&#10;               else null end as check_svc&#10;    from raw1&#10;)&#10;&#10;, raw3 as (&#10;    select *&#10;        -- , case when svc2&lt;&lt;&gt;&gt;&apos;bm1_in&apos; then 1e0*auto_allocated/cnt_bundle else auto_allocated end as conv_cnt&#10;        , sum(case when check_svc = &apos;pure&apos; then 1 end) over (partition by business_day, rider_no, bundle_key) as cnt_bundle&#10;        , sum(case when check_svc = &apos;integ&apos; then 1 end) over (partition by business_day, rider_no, bundle_key, svc) as cnt_integ&#10;        , sum(case when check_svc = &apos;mixed&apos; then 1 end) over (partition by business_day, rider_no, bundle_key, svc) as cnt_mixed&#10;    from raw2&#10;)&#10;&#10;, raw4 as (&#10;    select *&#10;        , case when cnt_bundle &gt;&gt;= 1 then 1e0*auto_allocated/cnt_bundle&#10;               when cnt_integ &gt;&gt;=1 then 1e0*auto_allocated/cnt_integ&#10;               when cnt_mixed &gt;&gt;=1 then 1e0*auto_allocated/cnt_mixed&#10;               else 0 end as conv_cnt&#10;    from raw3&#10;)&#10;&#10;, raw5 as (&#10;    select part_key&#10;        , coalesce(svc_grp, &apos;total&apos;) as svc_grp&#10;        , coalesce(svc, &apos;total&apos;) as svc&#10;        , &apos;전체&apos; as rgn&#10;        , &apos;LEVEL_all&apos; as inf_lv_grp&#10;        , 0 as inf_lv&#10;        -- 배달건수&#10;        , count(1) as cnt_dlv&#10;        -- 운행인원&#10;        -- , count(distinct rider_no) as cnt_active_rider&#10;        , sum(is_bike) as bike&#10;        -- AI배차 수행건수&#10;        , sum(auto_allocated) as cnt_ai_dlv&#10;        , sum(conv_cnt) as conv_cnt&#10;        , sum(case when cnt_bundle = 1 then conv_cnt end) as single_conv_cnt&#10;        , sum(case when cnt_bundle &gt;&gt; 1 then conv_cnt end) as bundle_conv_cnt&#10;        , sum(case when cnt_integ &gt;&gt;= 1 then conv_cnt end) as integ_conv_cnt&#10;        , sum(case when cnt_mixed &gt;&gt;= 1 then conv_cnt end) as mixed_conv_cnt&#10;        -- , sum(is_dlv_time_between_expected_dlv_time) as dlv_time_between_expected_dlv_time&#10;        -- , sum(is_noti_time_between_expected_dlv_time) as noti_time_between_expected_dlv_time&#10;        -- , sum(is_dlv_time_over_max_expected_dlv_time_plus_10min) as dlv_time_over_max_expected_dlv_time_plus_10min&#10;        -- , sum(is_dlv_time_over_max_expected_dlv_time_plus_15min) as dlv_time_over_max_expected_dlv_time_plus_15min&#10;        -- , sum(is_dlv_time_over_max_expected_dlv_time_plus_20min) as dlv_time_over_max_expected_dlv_time_plus_20min&#10;        -- , sum(is_dlv_time_between_customer_guidance_time_10min) as dlv_time_between_customer_guidance_time_10min&#10;        -- , sum(is_dlv_time_over_customer_guidance_time_plus_10min) as dlv_time_over_customer_guidance_time_plus_10min&#10;        -- , sum(is_dlv_time_over_customer_guidance_time_plus_20min) as dlv_time_over_customer_guidance_time_plus_20min&#10;        -- , sum(is_dlv_time_over_60min) as dlv_time_over_60min&#10;        -- , sum(is_dlv_time_over_60min*is_dlv_time_over_max_expected_dlv_time_plus_15min) as damage_to_customer_experience&#10;        -- , sum(is_hand_pick_diff_over_30min) as hand_pick_diff_over_30min&#10;        -- , sum(is_arrived_pickE_diff_over_0min) as arrived_pickE_diff_over_0min&#10;        -- , sum(is_arrived_pickE_diff_over_10min) as arrived_pickE_diff_over_10min&#10;        -- , sum(is_pick_arrived_diff_over_5min) as pick_arrived_diff_over_5min&#10;        -- , sum(is_consign_start_diff_more_30min) as consign_start_diff_more_30min&#10;        -- , sum(hand_reg_diff) as hand_reg_diff&#10;        -- , sum(hand_pick_diff) as hand_pick_diff&#10;        -- , sum(hand_consign_diff) as hand_consign_diff&#10;        -- -- , sum(pick_reg_diff) as pick_reg_diff&#10;        -- , sum(pick_consign_diff) as pick_consign_diff&#10;        -- , sum(consign_reg_diff) as consign_reg_diff&#10;        -- , sum(consign_start_diff) as consign_start_diff&#10;        -- , sum(start_reg_diff) as start_reg_diff&#10;        -- , sum(reg_acc_diff) as reg_acc_diff&#10;    from raw4&#10;    group by grouping sets ((part_key, svc_grp, svc)&#10;                        , (part_key, svc_grp)&#10;                        , (part_key))&#10;)&#10;&#10;, qual as (&#10;    select part_key&#10;        , svc_grp&#10;        , svc&#10;        , rgn&#10;        , inf_lv_grp&#10;        , inf_lv&#10;        , cnt_dlv&#10;        , cnt_ai_dlv&#10;        -- , cnt_active_rider&#10;        -- , 1e0*cnt_dlv/cnt_active_rider as cnt_dlv_per_rider&#10;        , 100e0*cnt_ai_dlv/cnt_dlv as ai_dlv_rate&#10;        , 100e0*(cnt_dlv - cnt_ai_dlv)/cnt_dlv as norm_dlv_rate&#10;        , 100e0*bike/cnt_dlv as bike_rate&#10;        , 100e0*(cnt_dlv-bike)/cnt_dlv as non_bike_rate&#10;        , 100e0*more10_rej_dlv/cnt_dlv as more10_rej_dlv_rate&#10;        , 100e0*conv_cnt/(conv_cnt+single_rej+bundle_rej+integ_rej+mixed_rej) as ai_accept_rate&#10;        , 100e0*single_conv_cnt/(single_conv_cnt+single_rej) as single_ai_accept_rate&#10;        , 100e0*bundle_conv_cnt/(bundle_conv_cnt+bundle_rej) as bundle_ai_accept_rate&#10;        , 100e0*integ_conv_cnt/(integ_conv_cnt+integ_rej) as integ_ai_accept_rate&#10;        , 100e0*mixed_conv_cnt/(mixed_conv_cnt+mixed_rej) as mixed_ai_accept_rate&#10;        , cnt_cancel&#10;        , 100e0*cnt_cancel/(cnt_cancel+cnt_dlv) as cancel_rate&#10;        , 100e0*cnt_cancel_unable_to_load/(cnt_cancel+cnt_dlv) as cancel_unable_to_load_rate&#10;        , 100e0*cnt_cancel_delay_in_pickup_preparation/(cnt_cancel+cnt_dlv) as cancel_delay_in_pickup_preparation_rate&#10;        , 100e0*cnt_cancel_click_mistake/(cnt_cancel+cnt_dlv) as cancel_click_mistake_rate&#10;        , 100e0*cnt_cancel_delivery_method_breakdown/(cnt_cancel+cnt_dlv) as cancel_delivery_method_breakdown_rate&#10;        , 100e0*cnt_cancel_weather_problem/(cnt_cancel+cnt_dlv) as cancel_weather_problem_rate&#10;        , 100e0*cnt_cancel_rider_fee_complaints/(cnt_cancel+cnt_dlv) as cancel_rider_fee_complaints_rate&#10;        , 100e0*cnt_cancel_rider_accident/(cnt_cancel+cnt_dlv) as cancel_rider_accident_rate&#10;        , 100e0*cnt_cancel_unable_to_find_locations/(cnt_cancel+cnt_dlv) as cancel_unable_to_find_locations_rate&#10;        , 100e0*cnt_cancel_etc/(cnt_cancel+cnt_dlv) as cancel_etc_rate&#10;        -- , num_cancel_rider&#10;        -- , cnt_ai_rec_per_dlv&#10;        -- , alloc_30min_cnt_ai_rec_per_dlv&#10;        -- , cnt_ai_rec_per_minute&#10;        -- , alloc_30min_cnt_ai_rec_per_minute&#10;        -- , avg_ai_first_rec_time_min&#10;        -- , 100e0*dlv_time_between_expected_dlv_time/cnt_dlv as dlv_time_between_expected_dlv_time_rate&#10;        -- , 100e0*noti_time_between_expected_dlv_time/cnt_dlv as noti_time_between_expected_dlv_time_rate&#10;        -- , 100e0*(cnt_dlv-noti_time_between_expected_dlv_time)/cnt_dlv as noti_time_not_between_expected_dlv_time_rate&#10;        -- , 100e0*dlv_time_over_max_expected_dlv_time_plus_10min/cnt_dlv as dlv_time_over_max_expected_dlv_time_plus_10min_rate -- &quot;배예시 Max +10분 초과율&quot;&#10;        -- , 100e0*dlv_time_over_max_expected_dlv_time_plus_15min/cnt_dlv as dlv_time_over_max_expected_dlv_time_plus_15min_rate -- &quot;배예시 Max +15분 초과율&quot;&#10;        -- , 100e0*dlv_time_over_max_expected_dlv_time_plus_20min/cnt_dlv as dlv_time_over_max_expected_dlv_time_plus_20min_rate -- &quot;배예시 Max +20분 초과율&quot;&#10;        -- , 100e0*dlv_time_between_customer_guidance_time_10min/cnt_dlv as dlv_time_between_customer_guidance_time_10min_rate -- &quot;고안시 ±10분 준수율&quot;&#10;        -- , 100e0*dlv_time_over_customer_guidance_time_plus_10min/cnt_dlv as dlv_time_over_customer_guidance_time_plus_10min_rate -- &quot;고안시 +10분 초과율&quot;&#10;        -- , 100e0*dlv_time_over_customer_guidance_time_plus_20min/cnt_dlv as dlv_time_over_customer_guidance_time_plus_20min_rate -- &quot;고안시 +20분 초과율&quot;&#10;        -- , 100e0*dlv_time_over_60min/cnt_dlv as dlv_time_over_60min_rate -- &quot;배달시간 60분 초과율&quot;&#10;        -- , 100e0*damage_to_customer_experience/cnt_dlv as damage_to_customer_experience_rate -- 고객경험훼손율&#10;        -- , 100e0*hand_pick_diff_over_30min/cnt_dlv as hand_pick_diff_over_30min_rate -- &quot;픽업 후 전달시간 30분 초과율&quot;&#10;        -- , 100e0*arrived_pickE_diff_over_0min/cnt_dlv as arrived_pickE_diff_over_0min_rate -- &quot;픽업예정시간 지연율&quot;&#10;        -- , 100e0*arrived_pickE_diff_over_10min/cnt_dlv as arrived_pickE_diff_over_10min_rate -- &quot;픽업예정시간 +10분 지연율&quot;&#10;        -- , 100e0*pick_arrived_diff_over_5min/cnt_dlv as pick_arrived_diff_over_5min_rate-- &quot;조리대기 5분 초과율&quot;&#10;        -- , 100e0*consign_start_diff_more_30min/cnt_dlv as consign_start_diff_more_30min_rate-- &quot;장기미배차 30분이상 비율&quot;&#10;        -- , 100e0*(consign_start_diff_more_30min+cancel_consign_start_diff_more_30min)/(cnt_dlv+cnt_cancel_dlv) as consign_start_diff_more_30min_rate2&#10;        -- , 1e0*hand_reg_diff/cnt_dlv as hand_reg_diff&#10;        -- , 1e0*hand_pick_diff/cnt_dlv as hand_pick_diff&#10;        -- , 1e0*hand_consign_diff/cnt_dlv as hand_consign_diff&#10;        -- -- , 1e0*pick_reg_diff/cnt_dlv as pick_reg_diff&#10;        -- , 1e0*pick_consign_diff/cnt_dlv as pick_consign_diff&#10;        -- , 1e0*consign_reg_diff/cnt_dlv as consign_reg_diff&#10;        -- , 1e0*consign_start_diff/cnt_dlv as consign_start_diff&#10;        -- , 1e0*start_reg_diff/cnt_dlv as start_reg_diff&#10;        -- , 1e0*reg_acc_diff/cnt_dlv as reg_acc_diff&#10;    from raw5&#10;    left join rej8 using (part_key, svc_grp, svc, rgn, inf_lv_grp, inf_lv)&#10;    left join cancel2 using (part_key, svc_grp, svc, rgn, inf_lv_grp, inf_lv)&#10;    -- left join rec2 using (part_key, svc_grp, svc, rgn, inf_lv_grp, inf_lv)&#10;    left join cancel_dlv using (part_key, svc_grp, svc, rgn, inf_lv_grp, inf_lv)&#10;)&#10;&#10;, total as (&#10;    select *&#10;    from fee3&#10;    left join qual using (part_key, svc_grp, svc, rgn, inf_lv_grp, inf_lv)&#10;)&#10;&#10;select *&#10;from total&#10;order by case when rgn=&apos;전체&apos; then 2&#10;              when rgn=&apos;서울&apos; then 3&#10;              when rgn=&apos;경기&apos; then 4&#10;              when rgn=&apos;인천&apos; then 5&#10;              when rgn=&apos;지방&apos; then 6&#10;              else 1 end, svc_grp, svc, inf_lv_grp, inf_lv, part_key desc&#10;-- limit 100000</relation>
