    <relation connection='athena.0pjqpi91bsvq831ebryw80g6uceq' name='사용자 지정 SQL 쿼리' type='text'>/*&#10;운행 중 유휴율 : https://wiki.woowa.in/pages/viewpage.action?pageId=776472581&#10;*/&#10;&#10;with &#10;&#10;riders as ( -- 라이더 계정정보&#10;    SELECT a.id as rider_id&#10;         , b.rider_id as rider_no&#10;         , a.delivery_method&#10;         , b.join_channel&#10;         , a.account_status&#10;         , format_datetime(a.join_date AT TIME ZONE &apos;Asia/Seoul&apos;, &apos;yyyy-MM-dd&apos;) as join_date_org -- brms 스키마 데이터는 UTC -&gt;&gt; KST 변경 필요&#10;         , format_datetime(a.first_available_delivery_date AT TIME ZONE &apos;Asia/Seoul&apos;, &apos;yyyy-MM-dd&apos;) as first_available_delivery_date_org&#10;         , format_datetime(date_parse(a.business_start_day, &apos;%Y%m%d&apos;), &apos;yyyy-MM-dd&apos;) as business_start_date_org&#10;         &#10;         , format_datetime(date_trunc(&apos;week&apos;, a.join_date AT TIME ZONE &apos;Asia/Seoul&apos;), &apos;yyyy-MM-dd&apos;) as join_date -- brms 스키마 데이터는 UTC -&gt;&gt; KST 변경 필요&#10;         , format_datetime(date_trunc(&apos;week&apos;, a.first_available_delivery_date AT TIME ZONE &apos;Asia/Seoul&apos;), &apos;yyyy-MM-dd&apos;) as first_available_delivery_date&#10;         , format_datetime(date_trunc(&apos;week&apos;, date_parse(a.business_start_day, &apos;%Y%m%d&apos;)), &apos;yyyy-MM-dd&apos;) as business_start_date&#10;         , format_datetime(date_trunc(&apos;week&apos;, a.retire_date AT TIME ZONE &apos;Asia/Seoul&apos;), &apos;yyyy-MM-dd&apos;) as retire_date&#10;    FROM brms.rider_account a&#10;    LEFT JOIN sbtasty.rider_account b&#10;    ON a.id = b.brms_rider_id&#10;    WHERE 1=1&#10;    AND a.agency_id &lt;&lt;&gt;&gt; 13 -- 테스트 데이터 제외&#10;    AND a.tester &lt;&lt;&gt;&gt; 1 -- 테스트 데이터 제외&#10;    AND a.rider_type in (&apos;CROWDSOURCING&apos;, &apos;INDIVIDUAL_OWNER&apos;) -- 대상 라이더타입 필터링&#10;),&#10;&#10;dlv as (&#10;    select dlv.business_day&#10;        , dlv.rider_no as rider_id&#10;        , dlvry_status&#10;        , additional_delivery_detail_id&#10;        , order_type&#10;        , dlv.dlvry_id&#10;        , rider_dlvry_fee&#10;        , consign_date&#10;        , case when pick_up_date &gt;&gt;= hand_over_date then hand_over_date else pick_up_date end as pick_up_date&#10;        , coalesce(hand_over_date, pick_up_date) as hand_over_date&#10;        , lag(coalesce(hand_over_date, pick_up_date)) OVER (PARTITION BY dlv.business_day, dlv.rider_no ORDER BY consign_date, hand_over_date, dlv.ord_no) as pre_complete_date&#10;        , max(coalesce(hand_over_date, pick_up_date)) OVER (PARTITION BY dlv.business_day, dlv.rider_no ORDER BY consign_date, hand_over_date, dlv.ord_no) as max_complete_date&#10;        , delivery_carry_type&#10;        , dlv.arrived_shop_date&#10;        , auto_allocated&#10;        , dlv.ord_no&#10;        , rider_delivery_method&#10;        , dlv.agency_id&#10;    from sbtasty.dlvry2 dlv&#10;    INNER JOIN riders r&#10;    ON dlv.rider_no = r.rider_no&#10;    where business_day between format_datetime(date_trunc(&apos;week&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;84&apos; day, &apos;yyyy-MM-dd&apos;) and format_datetime(date_trunc(&apos;week&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;1&apos; day, &apos;yyyy-MM-dd&apos;)&#10;    and dlv.agency_name not like &apos;%테스트%&apos;&#10;    and dlv.agency_id &lt;&lt;&gt;&gt; 13&#10;    and dlv.consign_date &lt;&lt;= arrived_shop_date&#10;    and pick_up_date is not null&#10;),&#10;&#10;main_agency as (&#10;    select week, rider_id, operation_time&#10;    from (&#10;        select week, rider_id&#10;            , date_diff(&apos;second&apos;,start_date,end_date) as operation_time&#10;            , row_number() over (partition by week, rider_id order by cnt desc, last_pick_up_date desc) as ranking&#10;        from (&#10;            select format_datetime(date_trunc(&apos;week&apos;, date(business_day)), &apos;yyyy-MM-dd&apos;) as week&#10;                , rider_id&#10;                , agency_id&#10;                -- , agency_name&#10;                , count(1) as cnt&#10;                , max(pick_up_date) as last_pick_up_date&#10;            from dlv&#10;            group by 1,2,3&#10;        )&#10;        left join (&#10;            select format_datetime(date_trunc(&apos;week&apos;, date(date_cd)), &apos;yyyy-MM-dd&apos;) as week&#10;                , agency_id&#10;                , start_date&#10;                , end_date&#10;            from sbtasty.agency_operation_daily&#10;        ) using (week, agency_id)&#10;    )&#10;    where ranking=1&#10;),&#10;&#10;dlv_days as (&#10;    select week, rider_id, active_days&#10;        , 7 as total_days&#10;    from (&#10;        select format_datetime(date_trunc(&apos;week&apos;, date(business_day)), &apos;yyyy-MM-dd&apos;) as week&#10;            , rider_id&#10;            , count(distinct business_day) as active_days&#10;        from dlv&#10;        group by 1,2&#10;    )&#10;),&#10;&#10;dim as (&#10;    select week&#10;        , rider_id&#10;        , operation_time*active_days as active_time&#10;        , operation_time*total_days as total_time&#10;    from dlv_days&#10;    left join main_agency using (week, rider_id)&#10;),&#10;&#10;time as (&#10;    select week&#10;        , sum(active_time) as total_time_wo_non_workdays -- &quot;총 운행가능시간(미운행일제외)&quot;&#10;        , sum(total_time) as total_time_with_non_workdays -- &quot;총 운행가능시간(미운행일포함)&quot;&#10;    from (&#10;        select week, rider_id, active_time, total_time&#10;        from dim&#10;    )&#10;    group by 1&#10;),&#10;&#10;bds as (&#10;    select part_date&#10;        , action_date + interval &apos;9&apos; hour as action_date&#10;        , rider_id&#10;        , rider_status as action&#10;        , 2 as auto_allocated&#10;    from bds.rider_working_log&#10;    where part_date &gt;&gt;= format_datetime(date_trunc(&apos;week&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;21&apos; day, &apos;yyyy-MM-dd&apos;)&#10;        and not(format_datetime(action_date + interval &apos;9&apos; hour, &apos;yyyy-MM-dd&apos;) &gt;&gt; part_date and hour(action_date + interval &apos;9&apos; hour) between 5 and 7)&#10;),&#10;&#10;auto as (&#10;    select part_date&#10;        , created_date as action_date&#10;        , rider_id&#10;        , auto_allocate_status as action&#10;        , case when auto_allocate_status in (&apos;AUTOALLOCATEUSEOFF&apos;) then 0&#10;              when auto_allocate_status in (&apos;AUTOALLOCATEUSEON&apos;, &apos;AUTOALLOCATEON&apos;, &apos;AUTOALLOCATEOFF&apos;) then 1 end as auto_allocated&#10;    from sbtasty.auto_allocate_status_history&#10;    where part_date &gt;&gt;= format_datetime(date_trunc(&apos;week&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;21&apos; day, &apos;yyyy-MM-dd&apos;)&#10;        and not(hour(created_date) between 5 and 7)&#10;),&#10;&#10;base as ( -- 운행시간, 유휴시간 용도&#10;  select business_day as part_date&#10;    , consign_date as ds_allocated_date&#10;    , consign_date as action_date&#10;    , rider_id&#10;    , &apos;consign&apos; as action&#10;    , auto_allocated&#10;    , null as rider_dlvry_fee&#10;    , ord_no&#10;  from dlv&#10;  where pick_up_date is not null -- 배달시간 계산을 위해 조건 추가. hand_over_date가 null인 경우 pick_up_date로 대체하여 사용&#10;  &#10;  UNION ALL&#10;  &#10;  select business_day as part_date&#10;    , consign_date as ds_allocated_date&#10;    , pick_up_date as action_date&#10;    , rider_id&#10;    , &apos;pick_up&apos; as action&#10;    , auto_allocated&#10;    , null as rider_dlvry_fee&#10;    , ord_no&#10;  from dlv&#10;  where pick_up_date is not null -- 배달시간 계산을 위해 조건 추가. hand_over_date가 null인 경우 pick_up_date로 대체하여 사용&#10;  &#10;  UNION ALL&#10;  &#10;  select business_day as part_date&#10;    , consign_date as ds_allocated_date&#10;    , hand_over_date as action_date&#10;    , rider_id&#10;    , &apos;hand_over&apos; as action&#10;    , auto_allocated&#10;    , rider_dlvry_fee&#10;    , ord_no&#10;  from dlv&#10;  where pick_up_date is not null -- 배달시간 계산을 위해 조건 추가. hand_over_date가 null인 경우 pick_up_date로 대체하여 사용&#10;  &#10;  UNION ALL&#10;  &#10;  select part_date&#10;    , null as ds_allocated_date&#10;    , action_date&#10;    , rider_id&#10;    , action&#10;    , auto_allocated&#10;    , null as rider_dlvry_fee&#10;    , &apos;0&apos; as ord_no&#10;  from bds&#10;  &#10;  UNION ALL&#10;  &#10;  select part_date&#10;    , null as ds_allocated_date&#10;    , action_date&#10;    , rider_id&#10;    , action&#10;    , auto_allocated&#10;    , null as rider_dlvry_fee&#10;    , &apos;0&apos; as ord_no&#10;  from auto&#10;),&#10;&#10;base_1 as ( -- 배달시간 용도&#10;      select business_day as part_date&#10;    , dlvry_id&#10;    , consign_date as action_date&#10;    , rider_id&#10;    , &apos;consign&apos; as action&#10;    , auto_allocated&#10;    , null as rider_dlvry_fee&#10;    , ord_no&#10;  from dlv&#10;  where pick_up_date is not null -- 배달시간 계산을 위해 조건 추가. hand_over_date가 null인 경우 pick_up_date로 대체하여 사용&#10;  &#10;  UNION ALL&#10;  &#10;  select business_day as part_date&#10;    , dlvry_id&#10;    , hand_over_date as action_date&#10;    , rider_id&#10;    , &apos;hand_over&apos; as action&#10;    , auto_allocated&#10;    , rider_dlvry_fee&#10;    , ord_no&#10;  from dlv&#10;  where pick_up_date is not null -- 배달시간 계산을 위해 조건 추가. hand_over_date가 null인 경우 pick_up_date로 대체하여 사용&#10;),&#10;&#10;base2 as (&#10;  select *&#10;      , lead(action) over (partition by part_date, rider_id order by action_date, action, ord_no) as lead_action&#10;      , lead(action_date) over (partition by part_date, rider_id order by action_date, action, ord_no) as lead_action_date&#10;      , lead(auto_allocated) over (partition by part_date, rider_id order by action_date, action, ord_no) as lead_auto_allocated&#10;      , sum(case when action=&apos;consign&apos; then 1 when action=&apos;hand_over&apos; then -1 else 0 end) over (partition by part_date, rider_id order by action_date, action, ord_no) as keep&#10;      , sum(case when action=&apos;pick_up&apos; then 1 when action=&apos;hand_over&apos; then -1 else 0 end) over (partition by part_date, rider_id order by action_date, action, ord_no) as pick&#10;  from base&#10;),&#10;&#10;base2_1 as (&#10;  select *&#10;      , lead(action) over (partition by part_date, rider_id order by action_date, action, ord_no) as lead_action&#10;      , lead(action_date) over (partition by part_date, rider_id order by action_date, action, ord_no) as lead_action_date&#10;      , lead(auto_allocated) over (partition by part_date, rider_id order by action_date, action, ord_no) as lead_auto_allocated&#10;  from (&#10;      select *&#10;          , sum(case when action=&apos;consign&apos; then 1 when action=&apos;hand_over&apos; then -1 else 0 end) over (partition by part_date, rider_id order by action_date, action, ord_no) as keep&#10;      from base_1&#10;  )&#10;),&#10;&#10;base3 as (&#10;  select *&#10;      , sum(case when action in (&apos;DELIVERING&apos;, &apos;consign&apos;, &apos;AUTOALLOCATEON&apos;, &apos;READY&apos;) then 1 end) over (partition by part_date, rider_id order by action_date, action, ord_no) as row_num&#10;      , case when auto_allocated=1 or lead_auto_allocated=1 then 1 else 0 end as ai&#10;  from base2&#10;),&#10;&#10;base4 as (&#10;  select *&#10;    , case when hour(lead_action_date) between 5 and 7 then 0&#10;          when hour(action_date) between 5 and 7 then date_diff(&apos;second&apos;, from_iso8601_timestamp(format_datetime(action_date, &apos;yyyy-MM-dd&apos;)||&apos;T09:00:00&apos;), lead_action_date)*1e0&#10;          else date_diff(&apos;second&apos;, action_date, lead_action_date)*1e0 end as diff_time&#10;    , sum(case when row_num=1 and action in (&apos;consign&apos;, &apos;AUTOALLOCATEON&apos;) and lead_action &lt;&lt;&gt;&gt; &apos;DELIVERING&apos; then 1&#10;              when row_num=2 and action=&apos;consign&apos; and lead_action=&apos;consign&apos; and action_date=lead_action_date then 1&#10;              when action=&apos;DELIVERING&apos; then 1&#10;              when row_num&lt;&lt;&gt;&gt;1 and action=&apos;READY&apos; then -1 end) over (partition by part_date, rider_id order by action_date) as onoff&#10;  from base3&#10;  where not(action=&apos;DELIVERING&apos; and lead_action=&apos;DELIVERING&apos;)&#10;    and not(action=&apos;READY&apos; and lead_action=&apos;READY&apos;)&#10;),&#10;&#10;base4_1 as (&#10;  select *&#10;    , case when keep&gt;&gt;=1 then diff_time end as work_time&#10;  from (&#10;      select *&#10;        , date_diff(&apos;second&apos;, action_date, lead_action_date)*1e0 as diff_time&#10;      from base2_1&#10;  )&#10;),&#10;&#10;base5 as ( -- 일별 라이더별 전체 운행시간, 전체 유휴시간&#10;    select part_date&#10;        , rider_id&#10;        , sum(diff_time) as on_time&#10;        , sum(case when keep=0 then diff_time end)*1e0 as idle_time&#10;        , sum(rider_dlvry_fee) as rider_dlvry_fee&#10;    from base4&#10;    where 1=1&#10;    and not(keep=0 and onoff=0)&#10;    group by 1, 2&#10;),&#10;&#10;base5_1 as ( -- 일별 라이더별 배달시간, 배달건수, 총배달건수&#10;    select a.part_date&#10;         , a.rider_id&#10;         , a.work_time&#10;         , b.dlv_cnt&#10;         , sum(dlv_cnt) over (partition by a.part_date, a.rider_id) as total_dlv_cnt&#10;    from (&#10;        select part_date&#10;            , rider_id&#10;            , sum(work_time) as work_time&#10;        from base4_1&#10;        group by 1, 2&#10;    ) a&#10;    left join (&#10;        select part_date&#10;             , rider_id&#10;            , sum(case when action=&apos;hand_over&apos; then 1 end) as dlv_cnt&#10;        from base4_1&#10;        group by 1, 2&#10;    ) b&#10;    on a.part_date = b.part_date&#10;    and a.rider_id = b.rider_id&#10;),&#10;&#10;base6 as (&#10;    select a.part_date&#10;        , a.rider_id&#10;        , a.dlv_cnt&#10;        , a.work_time&#10;        , a.total_dlv_cnt&#10;        , b.idle_time&#10;        , b.on_time&#10;        , b.rider_dlvry_fee&#10;    from base5_1 a&#10;    left join base5 b&#10;    on a.part_date = b.part_date&#10;    and a.rider_id = b.rider_id&#10;),&#10;&#10;final as (&#10;    select week&#10;        , count(distinct rider_id) as on_rider_cnt&#10;        , avg(on_day_cnt) as avg_on_day_cnt&#10;        , avg(work_days_cnt) as avg_work_days_cnt&#10;        , avg(on_time)/3600e0 as avg_on_time&#10;        , avg(idle_time)/3600e0 as avg_idle_time&#10;        , avg(work_time)/3600e0 as avg_work_time&#10;        , sum(on_time) as on_time&#10;        , sum(idle_time) as idle_time&#10;        , sum(work_time) as work_time&#10;        , sum(dlv_cnt)/sum(on_time_org)*3600e0 as utr_with_idle_time&#10;        , sum(rider_dlvry_fee)/sum(on_time_org)*3600e0 as pay_per_hour_with_idle_time&#10;        , sum(rider_dlvry_fee) as rider_dlvry_fee&#10;    from (&#10;        select format_datetime(date_trunc(&apos;week&apos;, date(part_date)), &apos;yyyy-MM-dd&apos;) as week&#10;            , rider_id&#10;            , count(DISTINCT part_date) as on_day_cnt -- 운행일자&#10;            , count(DISTINCT case when dlv_cnt &gt;&gt; 0 then part_date end) as work_days_cnt -- 배달일자&#10;            , sum(work_time+idle_time) as on_time -- &quot;(전체)운행시간_분&quot;&#10;            , sum(idle_time) as idle_time -- &quot;(전체)유휴시간_분&quot;&#10;            , sum(work_time) as work_time -- &quot;(전체)배달시간_분&quot;&#10;            , sum(dlv_cnt) as dlv_cnt&#10;            , sum(work_time+idle_time) as on_time_org&#10;            , sum(rider_dlvry_fee) as rider_dlvry_fee&#10;        from base6&#10;        group by 1, 2&#10;    )&#10;    group by 1&#10;)&#10;&#10;&#10;-- #####################################################################################&#10;-- [FINAL] 최종 결과 취합&#10;-- week | delivery_method | rgn&#10;-- #####################################################################################&#10;&#10;SELECT a.week&#10;&#10;     , 100e0*work_time/total_time_with_non_workdays as avg_work_time_rate -- 평균운행율&#10;     , 100e0*idle_time/on_time as total_idle_time_rate -- 운행중유휴율&#10;     , avg_on_day_cnt -- 운행일수&#10;     , avg_work_days_cnt -- 배달일수&#10;     , avg_on_time -- 주평균운행시간&#10;     , avg_work_time as avg_dlv_time -- 주평균배달시간&#10;     , utr_with_idle_time -- UTR(유휴시간포함)&#10;     , pay_per_hour_with_idle_time -- 시간당수익(유휴시간포함)&#10;     , rider_dlvry_fee/on_rider_cnt as pay_per_week -- 주간수익&#10;FROM final a&#10;left join time b&#10;on a.week = b.week&#10;ORDER BY week DESC</relation>
