        <remote-type>129</remote-type>
        <local-name>[delivery_method]</local-name>
        <parent-name>[사용자 지정 SQL 쿼리]</parent-name>
        <remote-alias>delivery_method</remote-alias>
        <ordinal>2</ordinal>
        <local-type>string</local-type>
        <aggregation>Count</aggregation>
        <width>255</width>
        <contains-null>true</contains-null>
        <collation flag='0' name='binary' />
