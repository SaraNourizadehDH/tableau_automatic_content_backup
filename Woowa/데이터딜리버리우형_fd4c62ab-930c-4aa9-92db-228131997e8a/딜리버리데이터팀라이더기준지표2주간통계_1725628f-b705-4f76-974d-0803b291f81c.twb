          <attribute datatype='string' name='TypeIsVarchar'>&quot;true&quot;</attribute>
        </attributes>
        <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_31EB99B63A8D4D82B5C12917BAD16E7B]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
      </metadata-record>
      <metadata-record class='column'>
        <remote-name>rgn</remote-name>
        <remote-type>129</remote-type>
        <local-name>[rgn]</local-name>
        <parent-name>[사용자 지정 SQL 쿼리]</parent-name>
        <remote-alias>rgn</remote-alias>
        <ordinal>3</ordinal>
        <local-type>string</local-type>
