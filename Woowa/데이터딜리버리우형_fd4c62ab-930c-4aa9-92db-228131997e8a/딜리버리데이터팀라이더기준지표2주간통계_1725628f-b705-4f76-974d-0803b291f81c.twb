  <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
  <semantic-values>
    <semantic-value key='[Country].[Name]' value='&quot;대한민국&quot;' />
  </semantic-values>
  <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    <objects>
      <object caption='사용자 지정 SQL 쿼리' id='_31EB99B63A8D4D82B5C12917BAD16E7B'>
        <properties context=''>
          <relation connection='athena.1a4jox201q60tb13psvyn1ytxrc9' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[/* [FINAL] 최종 데이터 형태 ::

week | delivery_method | rgn | ...

메모리 이슈 때문에 쿼리1과 형태는 같지만 분리하였음
-- 쿼리1 라이더수+VOC : https://redash.woowa.in/queries/33884/source
-- 쿼리2 운행시간 : https://redash.woowa.in/queries/33885/source
-- 쿼리3 VOC카테고리 : https://redash.woowa.in/queries/33886/source

*/


WITH

-- #####################################################################################
-- 2. 활동 라이더의 운행시간 증가
-- 2-1. 활동라이더의 운행시간 증가1-배달수단별
-- https://redash.woowa.in/queries/29995/source#101863
-- #####################################################################################

dlv_method as (
    select week, rider_id, rider_delivery_method
    from(
        select week, rider_id, rider_delivery_method
            , row_number() over (partition by week, rider_id order by cnt desc, last_pick_up_date desc) as ranking
        from(
            select format_datetime(date_trunc('week', date(business_day)), 'yyyy-MM-dd') as week
                , rider_no as rider_id
                , rider_delivery_method
                , count(1) as cnt
                , max(pick_up_date) as last_pick_up_date
            from sbtasty.dlvry2
            where business_day between format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '84' day, 'yyyy-MM-dd') and format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '1' day, 'yyyy-MM-dd')
                and agency_name not like '%테스트%'
                and agency_id <<>> 13
                -- and recall is null
                and hand_over_date is not NULL 
                and consign_date is not NULL
                and pick_up_date is not NULL
            group by 1,2,3
        )
    )
    where ranking=1
),

main_agency as (
    select week, rider_id, operation_time
    from (
        select week, rider_id
            , date_diff('second',start_date,end_date)/60e0 as operation_time
            , row_number() over (partition by week, rider_id order by cnt desc, last_pick_up_date desc) as ranking
        from (
            select format_datetime(date_trunc('week', date(business_day)), 'yyyy-MM-dd') as week
                , rider_no as rider_id
                , agency_id
                -- , agency_name
                , count(1) as cnt
                , max(pick_up_date) as last_pick_up_date
            from sbtasty.dlvry2
            where business_day between format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '84' day, 'yyyy-MM-dd') and format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '1' day, 'yyyy-MM-dd')
                and agency_name not like '%테스트%'
                and agency_id <<>> 13
                -- and recall is null
                and hand_over_date is not NULL 
                and consign_date is not NULL
                and pick_up_date is not NULL
            group by 1,2,3
        )
        left join (
            select format_datetime(date_trunc('week', date(date_cd)), 'yyyy-MM-dd') as week
                , agency_id
                , start_date
                , end_date
            from sbtasty.agency_operation_daily
        ) using (week, agency_id)
    )
    where ranking=1
),

dlv as (
  select format_datetime(date_trunc('week', date(business_day)), 'yyyy-MM-dd') as week
    , business_day as part_date
    , consign_date
    , pick_up_date
    , hand_over_date
    , rider_no as rider_id
    -- , order_service_type
    -- , delivery_carry_type
    , auto_allocated
    , rider_dlvry_fee
    -- , coalesce(coalesce(c.rider_delivery_method, a.rider_delivery_method), b.delivery_method) as rider_delivery_method
    , c.rider_delivery_method
  from sbtasty.dlvry2 a
  left join sbtasty.rider_account b
    on a.rider_no = b.rider_id
  left join dlv_method c
    on a.rider_no = c.rider_id
    and format_datetime(date_trunc('week', date(business_day)), 'yyyy-MM-dd') = c.week
  where business_day between format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '84' day, 'yyyy-MM-dd') and format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '1' day, 'yyyy-MM-dd')
    and a.agency_name not like '%테스트%'
    and a.agency_id <<>> 13
    -- and recall is null
    and hand_over_date is not NULL 
    and consign_date is not NULL
    and pick_up_date is not NULL
    and rider_type in ('CROWDSOURCING', 'INDIVIDUAL_OWNER')
),

dlv_days as (
    select week, rider_id, active_days
        , 7 as total_days
    from (
        select week
            , rider_id
            , count(distinct part_date) as active_days
        from dlv
        group by 1,2
    )
),

dim as (
    select week, rider_id, rider_delivery_method
        , operation_time*active_days as active_time
        , operation_time*total_days as total_time
    from dlv_days
    left join dlv_method using (week, rider_id)
    left join main_agency using (week, rider_id)
),

bds as (
    select week
        , part_date
        , action_date
        , rider_id
        , action
        , auto_allocated
        , rider_delivery_method
    from(
        select format_datetime(date_trunc('week', date(part_date)), 'yyyy-MM-dd') as week
            , part_date
            , action_date + interval '9' hour as action_date
            , rider_id
            , rider_status as action
            , 2 as auto_allocated
        from bds.rider_working_log
        where part_date between format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '84' day, 'yyyy-MM-dd') and format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '1' day, 'yyyy-MM-dd')
            -- and not(format_datetime(action_date + interval '9' hour, 'yyyy-MM-dd') >> part_date and hour(action_date + interval '9' hour) between 2 and 8)
            and not(format_datetime(action_date + interval '9' hour, 'yyyy-MM-dd') >> part_date and hour(action_date + interval '9' hour) between 5 and 7)
    )
    join dim using (week, rider_id)
    
),

auto as (
    select week
        , part_date
        , action_date
        , rider_id
        , action
        , auto_allocated
        , rider_delivery_method
    from(
        select format_datetime(date_trunc('week', date(part_date)), 'yyyy-MM-dd') as week
            , part_date
            , created_date as action_date
            , rider_id
            , auto_allocate_status as action
            , case when auto_allocate_status in ('AUTOALLOCATEUSEOFF') then 0
                   when auto_allocate_status in ('AUTOALLOCATEUSEON', 'AUTOALLOCATEON', 'AUTOALLOCATEOFF') then 1 end as auto_allocated
        from sbtasty.auto_allocate_status_history
        where part_date between format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '84' day, 'yyyy-MM-dd') and format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '1' day, 'yyyy-MM-dd')
            -- and not(hour(created_date) between 2 and 8)
            and not(hour(created_date) between 5 and 7)
    )
    join dim using (week, rider_id)
),

base as (
  select week
    , part_date
    , action_date
    , rider_id
    , action
    , auto_allocated
    , null as rider_dlvry_fee
    , rider_delivery_method
  from bds
  UNION ALL
  select week
    , part_date
    , action_date
    , rider_id
    , action
    , auto_allocated
    , null as rider_dlvry_fee
    , rider_delivery_method
  from auto
  UNION ALL
  select week
    , part_date
    , consign_date as action_date
    , rider_id
    , 'consign' as action
    , auto_allocated
    , null as rider_dlvry_fee
    , rider_delivery_method
  from dlv
  UNION ALL
  select week
    , part_date
    , pick_up_date as action_date
    , rider_id
    , 'pick_up' as action
    , auto_allocated
    , null as rider_dlvry_fee
    , rider_delivery_method
  from dlv
  UNION ALL
  select week
    , part_date
    , hand_over_date as action_date
    , rider_id
    , 'hand_over' as action
    , auto_allocated
    , rider_dlvry_fee
    , rider_delivery_method
  from dlv
),

base2 as (
  select *
      , lead(action) over (partition by part_date, rider_id order by action_date, action) as lead_action
      , lead(action_date) over (partition by part_date, rider_id order by action_date, action) as lead_action_date
      , lead(auto_allocated) over (partition by part_date, rider_id order by action_date, action) as lead_auto_allocated
      , sum(case when action='consign' then 1 when action='hand_over' then -1 else 0 end) over (partition by part_date, rider_id order by action_date, action) as keep
      , sum(case when action='pick_up' then 1 when action='hand_over' then -1 else 0 end) over (partition by part_date, rider_id order by action_date, action) as pick
  from base
),

base3 as (
  select *
      , sum(case when action in ('DELIVERING', 'consign', 'AUTOALLOCATEON', 'READY') then 1 end) over (partition by part_date, rider_id order by action_date, action) as row_num
      , case when auto_allocated=1 or lead_auto_allocated=1 then 1 else 0 end as ai
  from base2
),

base4 as (
  select *
    -- , case when hour(lead_action_date) between 2 and 8 then 0
    --       when hour(action_date) between 2 and 8 then date_diff('second', from_iso8601_timestamp(format_datetime(action_date, 'yyyy-MM-dd')||'T09:00:00'), lead_action_date)/60e0
    --       else date_diff('second', action_date, lead_action_date)/60e0 end as diff_time
    , case when hour(lead_action_date) between 5 and 7 then 0
           when hour(action_date) between 5 and 7 then date_diff('second', from_iso8601_timestamp(format_datetime(action_date, 'yyyy-MM-dd')||'T09:00:00'), lead_action_date)/60e0
           else date_diff('second', action_date, lead_action_date)/60e0 end as diff_time
    -- , case when auto_allocated=1 or lead_auto_allocated=1 then 1 else 0 end as auto
    , sum(case when row_num=1 and action in ('consign', 'AUTOALLOCATEON') and lead_action <<>> 'DELIVERING' then 1
               when row_num=2 and action='consign' and lead_action='consign' and action_date=lead_action_date then 1
               when action='DELIVERING' then 1
               when row_num<<>>1 and action='READY' then -1 end) over (partition by part_date, rider_id order by action_date) as onoff
  from base3
  where not(action='DELIVERING' and lead_action='DELIVERING')
    and not(action='READY' and lead_action='READY')
),

time as (
    select week
        , coalesce(rider_delivery_method, 'ALL') as delivery_method
        , sum(active_time) as total_time_wo_non_workdays -- "총 운행가능시간(미운행일제외)"
        , sum(total_time) as total_time_with_non_workdays -- "총 운행가능시간(미운행일포함)"
    from(
        select week, rider_id, rider_delivery_method, active_time, total_time
        from dim
    )
    group by 1, rollup(rider_delivery_method)
),

ch2_worktime1 as (
    select *
        , 100e0*total_work_time/total_time_with_non_workdays as avg_work_time_rate -- "총 운행시간"/"총 운행가능시간(미운행일포함)" as "평균 운행율"
        , 100e0*total_work_time/total_time_wo_non_workdays as avg_work_time_rate_wo_non_workdays -- "총 운행시간"/"총 운행가능시간(미운행일제외)" as "미운행일 제외 평균 운행율"
    from(
        select week
            , rider_delivery_method as delivery_method
            , 100e0*sum(idle_time)/sum(on_time) as total_idle_time_rate -- "운행중 유휴율"
            , 100e0*sum(ai_idle_time)/sum(ai_on_time) as ai_idle_time_rate -- "(AI)운행중 유휴율"
            , 100e0*sum(norm_idle_time)/sum(norm_on_time) as normal_idle_time_rate -- "(일반)운행중 유휴율"
            , sum(on_time) as total_work_time -- "총 운행시간"
            , sum(on_time)/sum(num_rider)/60e0 as avg_work_time -- "평균 운행시간"
            , sum(dlv_time)/sum(num_rider)/60e0 as avg_dlv_time -- "평균 배달수행시간"
            , sum(num_dlv)/sum(on_time)*60e0 as utr_with_idle_time -- "UTR(유휴시간포함)"
            , sum(pay)/sum(on_time)*60e0 as pay_per_hour_with_idle_time -- "시간당 평균 수익(유휴시간포함)"
            , 100e0*sum(no_pay_time)/sum(on_time) as unpaid_moving_time_ratio -- "무급이동시간 비중"
        from(
            select week
                , part_date
                , coalesce(rider_delivery_method, 'ALL') as rider_delivery_method
                , sum(case when keep=0 then diff_time end) as idle_time
                , sum(case when keep=0 and ai=0 then diff_time end) as norm_idle_time
                , sum(case when keep=0 and ai=1 then diff_time end) as ai_idle_time
                , sum(diff_time) as on_time
                , sum(case when ai=1 then diff_time end) as ai_on_time
                , sum(case when ai=0 then diff_time end) as norm_on_time
                , count(distinct rider_id) as num_rider
                , sum(case when keep>>=1 then diff_time end) as dlv_time
                , sum(case when action='hand_over' then 1 end) as num_dlv
                , sum(rider_dlvry_fee) as pay
                , sum(case when keep>>=1 and pick=0 then diff_time end) as no_pay_time
            from base4
            where not(keep=0 and onoff=0)
            group by 1,2,rollup(rider_delivery_method)
        )
        group by 1,2
    )
    left join time using (week, delivery_method)
),






-- #####################################################################################
-- 2. 활동 라이더의 운행시간 증가
-- 2-2. 활동라이더의 운행시간 증가2-배달수단별
-- https://redash.woowa.in/queries/32992/source#102832
-- #####################################################################################c

raw as (
    select distinct week
        , rider_id
        , part_date as business_day
    from dlv
),

raw2 as (
    select week
        , rider_id
        , business_day
        , lead(business_day) over (partition by week, rider_id order by business_day) as lead_bd
    from raw
),

raw3 as (
    select week
        , rider_id
        , avg(date_diff('day', date(business_day), date(lead_bd))) as dlv_freq
        , count(1) as bd_cnt
    from raw2
    group by 1,2
),

ch2_worktime2 as (
    select week
        , coalesce(rider_delivery_method, 'ALL') as rider_delivery_method
        , avg(dlv_freq) as avg_work_freq -- "평균 배달주기"
        , avg(bd_cnt) as avg_work_days_cnt -- "평균 배달일수"
    from raw3
    left join dlv_method using (week, rider_id)
    group by 1, rollup(rider_delivery_method)
)






-- #####################################################################################
-- [FINAL] 최종 결과 취합
-- week | delivery_method | rgn
-- #####################################################################################

SELECT d.week
     , d.delivery_method
     , 'ALL' as rgn

     , d.total_idle_time_rate
     , d.ai_idle_time_rate
     , d.normal_idle_time_rate
     , d.total_work_time
     , d.avg_work_time
     , d.avg_dlv_time
     , d.utr_with_idle_time
     , d.pay_per_hour_with_idle_time
     , d.unpaid_moving_time_ratio
     , d.avg_work_time_rate
     , d.avg_work_time_rate_wo_non_workdays

     , e.avg_work_freq
     , e.avg_work_days_cnt
FROM ch2_worktime1 d
LEFT JOIN ch2_worktime2 e
    ON d.week = cast(e.week as varchar)
    AND d.delivery_method = e.rider_delivery_method
ORDER BY week DESC, delivery_method]]></relation>
        </properties>
        <properties context='extract'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </properties>
      </object>
    </objects>
  </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
</datasource>
