    <relation connection='athena.1msrdua1wfimtv1ddcxjk0lxbobr' name='사용자 지정 SQL 쿼리' type='text'>/*&#10;v1  링크 : https://redash.woowa.in/queries/35003/source&#10;[FINAL] 최종 데이터 형태 ::&#10;&#10;week | delivery_method | rgn | ...&#10;&#10;메모리 이슈 때문에 쿼리2와 형태는 같지만 분리하였음&#10;-- 쿼리1 라이더수+VOC : https://redash.woowa.in/queries/33884/source&#10;-- 쿼리2 운행시간 : https://redash.woowa.in/queries/33885/source&#10;-- 쿼리3 VOC카테고리 : https://redash.woowa.in/queries/33886/source&#10;&#10;*/&#10;&#10;&#10;WITH&#10;&#10;-- #####################################################################################&#10;-- 1. 활동 라이더 증가&#10;-- 1-1. 라이더기본정보-배달수단별&#10;-- https://redash.woowa.in/queries/33355/source&#10;-- #####################################################################################&#10;&#10;riders as ( -- 라이더 계정정보&#10;    SELECT a.id as rider_id&#10;         , b.rider_id as rider_no&#10;         , a.delivery_method&#10;         , b.join_channel&#10;         , a.account_status&#10;         , format_datetime(a.join_date AT TIME ZONE &apos;Asia/Seoul&apos;, &apos;yyyy-MM-dd&apos;) as join_date_org -- brms 스키마 데이터는 UTC -&gt;&gt; KST 변경 필요&#10;         , format_datetime(a.first_available_delivery_date AT TIME ZONE &apos;Asia/Seoul&apos;, &apos;yyyy-MM-dd&apos;) as first_available_delivery_date_org&#10;         , format_datetime(date_parse(a.business_start_day, &apos;%Y%m%d&apos;), &apos;yyyy-MM-dd&apos;) as business_start_date_org&#10;         , format_datetime(a.retire_date AT TIME ZONE &apos;Asia/Seoul&apos;, &apos;yyyy-MM-dd&apos;) as retire_date_org&#10;    FROM brms.rider_account a&#10;    LEFT JOIN sbtasty.rider_account b&#10;    ON a.id = b.brms_rider_id&#10;    WHERE 1=1&#10;    AND a.agency_id &lt;&lt;&gt;&gt; 13 -- 테스트 데이터 제외&#10;    AND a.tester &lt;&lt;&gt;&gt; 1 -- 테스트 데이터 제외&#10;    AND a.rider_type in (&apos;CROWDSOURCING&apos;, &apos;INDIVIDUAL_OWNER&apos;) -- 대상 라이더타입 필터링&#10;),&#10;&#10;base_week as ( -- 기준년월&#10;    SELECT DISTINCT cast(first_day_of_week as varchar) as base_week&#10;         , cast(first_day_of_week as varchar) as first_day_of_week&#10;         , cast(last_day_of_week as varchar) as last_day_of_week&#10;         , cast(first_day_of_weeks_before_1 as varchar) as first_day_of_weeks_before_1&#10;         , cast(last_day_of_weeks_before_1 as varchar) as last_day_of_weeks_before_1&#10;    FROM deliverydata.date_dim&#10;    WHERE 1=1&#10;    AND date &gt;&gt;= format_datetime(date_trunc(&apos;week&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;84&apos; day, &apos;yyyy-MM-dd&apos;)&#10;    AND date &lt;&lt; format_datetime(date_trunc(&apos;week&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;0&apos; day, &apos;yyyy-MM-dd&apos;)&#10;),&#10;&#10;dlv as ( -- 라이더 배달정보&#10;    SELECT format_datetime(date_trunc(&apos;week&apos;, date(business_day)), &apos;yyyy-MM-dd&apos;) as base_week&#10;         , dlv.rider_no&#10;         , dlvry_id&#10;         , rider_delivery_method&#10;         , auto_allocated&#10;    FROM sbtasty.dlvry2 dlv&#10;    INNER JOIN riders r&#10;    ON dlv.rider_no = r.rider_no&#10;    WHERE 1=1&#10;    and dlv.agency_name not like &apos;%테스트%&apos;&#10;    AND agency_id &lt;&lt;&gt;&gt; 13 -- 테스트 데이터 제외&#10;    AND consign_date &lt;&lt;= arrived_shop_date&#10;    AND business_day &gt;&gt;= format_datetime(date_trunc(&apos;week&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;84&apos; day, &apos;yyyy-MM-dd&apos;)&#10;    AND business_day &lt;&lt; format_datetime(date_trunc(&apos;week&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;0&apos; day, &apos;yyyy-MM-dd&apos;)&#10;),&#10;&#10;dim_mode as ( -- 주이용배차모드&#10;    SELECT base_week&#10;         , rider_no&#10;         , dlv_cnt&#10;         , bike_dlv_cnt&#10;         , ai_dlv_cnt&#10;         , norm_dlv_cnt&#10;         , case when ai_dlv_cnt &gt;&gt;= norm_dlv_cnt then &apos;ai&apos; else &apos;normal&apos; end as main_mode&#10;    FROM (&#10;        SELECT base_week&#10;             , rider_no&#10;             , count(1) as dlv_cnt&#10;             , sum(case when rider_delivery_method = &apos;BIKE&apos; then 1 else 0 end) as bike_dlv_cnt&#10;             , sum(case when auto_allocated = 1 then 1 else 0 end) as ai_dlv_cnt&#10;             , sum(case when auto_allocated = 0 then 1 else 0 end) as norm_dlv_cnt&#10;        FROM dlv&#10;        GROUP BY 1, 2&#10;    ) a&#10;),&#10;&#10;summ1 as (&#10;    SELECT a.base_week as week&#10;         , sum(case when join_date_org &lt;&lt;= last_day_of_week and (retire_date_org is null or retire_date_org &gt;&gt; last_day_of_week) then 1 end) as total_riders_cnt&#10;         , sum(case when join_date_org &lt;&lt;= last_day_of_week and (retire_date_org is null or retire_date_org &gt;&gt; last_day_of_week) and first_available_delivery_date_org &lt;&lt;= last_day_of_week then 1 end) as dlv_avaiable_riders_cnt&#10;         , 100e0*sum(case when join_date_org &lt;&lt;= last_day_of_week and (retire_date_org is null or retire_date_org &gt;&gt; last_day_of_week) and first_available_delivery_date_org &lt;&lt;= last_day_of_week then 1 end)/sum(case when join_date_org &lt;&lt;= last_day_of_week and (retire_date_org is null or retire_date_org &gt;&gt; last_day_of_week) then 1 end) as dlv_available_riders_ratio&#10;         &#10;         , sum(case when join_date_org between first_day_of_week and last_day_of_week then 1 end) as new_join_riders_cnt&#10;         , sum(case when first_available_delivery_date_org between first_day_of_week and last_day_of_week then 1 end) as new_dlv_available_riders_cnt&#10;         , sum(case when retire_date_org between first_day_of_week and last_day_of_week then 1 end) as retire_riders_cnt&#10;         &#10;         , 100e0*sum(case when join_date_org between first_day_of_weeks_before_1 and last_day_of_weeks_before_1&#10;                     and first_available_delivery_date_org between first_day_of_weeks_before_1 and last_day_of_week then 1 end)/sum(case when join_date_org between first_day_of_weeks_before_1 and last_day_of_weeks_before_1 then 1 end) as dlv_available_conv_rate&#10;         , 100e0*sum(case when first_available_delivery_date_org between first_day_of_week and last_day_of_week&#10;                     and business_start_date_org between first_day_of_week and last_day_of_week then 1 end)/sum(case when first_available_delivery_date_org between first_day_of_week and last_day_of_week then 1 end) as first_dlv_conv_rate&#10;    FROM base_week a&#10;    LEFT JOIN riders b&#10;    ON a.last_day_of_week &gt;&gt;= b.join_date_org&#10;    GROUP BY 1&#10;),&#10;&#10;summ2 as (&#10;    select base_week as week&#10;         , count(1) as wau&#10;         , sum(case when bike_dlv_cnt &gt;&gt; 0 then 1 end) as bike_wau&#10;         , sum(case when bike_dlv_cnt = 0 and dlv_cnt &gt;&gt; 0 then 1 end) as etc_wau&#10;         , 100e0*sum(case when main_mode = &apos;ai&apos; then 1 end)/count(1) as ai_main_riders_ratio&#10;         , 100e0*sum(bike_dlv_cnt)/sum(dlv_cnt) as bike_dlv_ratio&#10;    from dim_mode&#10;    group by 1&#10;)&#10;&#10;select *&#10;from summ1&#10;left join summ2&#10;using (week)&#10;ORDER BY week DESC</relation>
