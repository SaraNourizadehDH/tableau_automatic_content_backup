  </extract>
  <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
  <semantic-values>
    <semantic-value key='[Country].[Name]' value='&quot;대한민국&quot;' />
  </semantic-values>
  <object-graph>
    <objects>
      <object caption='사용자 지정 SQL 쿼리' id='_638B4510DF8742249D88F3AE97BDEE4C'>
        <properties context=''>
          <relation connection='athena.1mqozkx1sxltup17dk6a51n3ifh3' name='사용자 지정 SQL 쿼리' type='text'>WITH&#10;riders as ( -- 라이더 계정정보&#10;    SELECT a.id as rider_id&#10;         , b.rider_id as rider_no&#10;         , a.delivery_method&#10;         , b.join_channel&#10;         , a.account_status&#10;         , format_datetime(date_trunc(&apos;month&apos;, a.join_date AT TIME ZONE &apos;Asia/Seoul&apos;), &apos;yyyy-MM-dd&apos;) as join_date -- brms 스키마 데이터는 UTC -&gt;&gt; KST 변경 필요&#10;         , format_datetime(date_trunc(&apos;month&apos;, a.first_available_delivery_date AT TIME ZONE &apos;Asia/Seoul&apos;), &apos;yyyy-MM-dd&apos;) as first_available_delivery_date&#10;         , format_datetime(date_trunc(&apos;month&apos;, date_parse(a.business_start_day, &apos;%Y%m%d&apos;)), &apos;yyyy-MM-dd&apos;) as business_start_date&#10;         , format_datetime(date_trunc(&apos;month&apos;, a.retire_date AT TIME ZONE &apos;Asia/Seoul&apos;), &apos;yyyy-MM-dd&apos;) as retire_date&#10;    FROM brms.rider_account a&#10;    LEFT JOIN sbtasty.rider_account b&#10;    ON a.id = b.brms_rider_id&#10;    WHERE 1=1&#10;    AND a.agency_id &lt;&lt;&gt;&gt; 13 -- 테스트 데이터 제외&#10;    AND a.tester &lt;&lt;&gt;&gt; 1 -- 테스트 데이터 제외&#10;    AND a.rider_type in (&apos;CROWDSOURCING&apos;, &apos;INDIVIDUAL_OWNER&apos;) -- 대상 라이더타입 필터링&#10;),&#10;&#10;dlv as ( -- 라이더 배달정보&#10;    SELECT format_datetime(date_trunc(&apos;month&apos;, date(business_day)), &apos;yyyy-MM-dd&apos;) as base_month&#10;         , rider_no&#10;         , case when regexp_like(coalesce(nm.rgn1_nm, c.rgn1_nm), &apos;서울&apos;) then &apos;서울&apos;&#10;                when regexp_like(coalesce(nm.rgn1_nm, c.rgn1_nm), &apos;경기&apos;) then &apos;경기&apos;&#10;                when regexp_like(coalesce(nm.rgn1_nm, c.rgn1_nm), &apos;인천&apos;) then &apos;인천&apos;&#10;                when coalesce(nm.rgn1_nm, c.rgn1_nm) is not null then &apos;지방&apos; else &apos;NONE&apos; end as rgn&#10;         , rider_delivery_method&#10;         , case when coalesce(order_service_type, order_type) = &apos;BERA&apos; then &apos;BAERA&apos; else coalesce(order_service_type, order_type) end as order_service_type&#10;         , auto_allocated &#10;         , max(pick_up_date) as last_pick_up_date&#10;         , count(1) as dlv_cnt&#10;    FROM sbtasty.dlvry2 a&#10;    LEFT JOIN sbstore_hist.shop_master rgn&#10;        ON a.shop_no = rgn.shop_no&#10;        AND a.business_day = rgn.part_date&#10;    LEFT JOIN sbbi.dim_rgn_cd nm&#10;        ON rgn.rgn3_cd = nm.rgn3_cd&#10;    LEFT JOIN dsdw.commerce_seller_master c&#10;        ON a.shop_no = c.seller_id&#10;        AND a.order_service_type = &apos;BAEMIN_STORE&apos;&#10;    WHERE 1=1&#10;    AND agency_id &lt;&lt;&gt;&gt; 13 -- 테스트 데이터 제외&#10;    AND consign_date is not null&#10;    AND pick_up_date is not null&#10;    AND hand_over_date is not null&#10;    AND business_day &gt;&gt;= format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;16&apos; month, &apos;yyyy-MM-dd&apos;)&#10;    AND business_day &lt;&lt; format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;0&apos; month, &apos;yyyy-MM-dd&apos;)&#10;    GROUP BY 1, 2, 3, 4, 5, 6&#10;),&#10;&#10;base_month as ( -- 기준년월&#10;    SELECT distinct base_month&#10;    FROM dlv&#10;),&#10;&#10;dim_mode as ( -- 주이용배차모드&#10;    SELECT base_month&#10;         , rider_no&#10;         , dlv_cnt&#10;         , ai_dlv_cnt&#10;         , norm_dlv_cnt&#10;         , case when ai_dlv_cnt &gt;&gt;= norm_dlv_cnt then &apos;AI모드&apos; else &apos;일반모드&apos; end as main_mode&#10;    FROM (&#10;        SELECT base_month&#10;             , rider_no&#10;             , sum(dlv_cnt) as dlv_cnt&#10;             , sum(case when auto_allocated = 1 then dlv_cnt else 0 end) as ai_dlv_cnt&#10;             , sum(case when auto_allocated = 0 then dlv_cnt else 0 end) as norm_dlv_cnt&#10;        FROM dlv&#10;        GROUP BY 1, 2&#10;    ) a&#10;),&#10;&#10;dim_svc as ( -- 주이용서비스&#10;    SELECT base_month&#10;         , rider_no&#10;         , order_service_type as main_svc&#10;    FROM (&#10;        SELECT base_month&#10;             , rider_no&#10;             , order_service_type&#10;             , row_number() over (PARTITION BY base_month, rider_no ORDER BY dlv_cnt DESC, last_pick_up_date DESC) as rk&#10;        FROM (&#10;            SELECT base_month&#10;                 , rider_no&#10;                 , order_service_type&#10;                 , max(last_pick_up_date) as last_pick_up_date&#10;                 , sum(dlv_cnt) as dlv_cnt&#10;            FROM dlv&#10;            GROUP BY 1, 2, 3&#10;        ) a&#10;    ) a&#10;    WHERE rk = 1&#10;),&#10;&#10;dim_rgn as ( -- 주이용지역&#10;    SELECT base_month&#10;         , rider_no&#10;         , rgn as main_rgn&#10;    FROM (&#10;        SELECT base_month&#10;             , rider_no&#10;             , rgn&#10;             , row_number() over (PARTITION BY base_month, rider_no ORDER BY dlv_cnt DESC, last_pick_up_date DESC) as rk&#10;        FROM (&#10;            SELECT base_month&#10;                 , rider_no&#10;                 , rgn&#10;                 , max(last_pick_up_date) as last_pick_up_date&#10;                 , sum(dlv_cnt) as dlv_cnt&#10;            FROM dlv&#10;            GROUP BY 1, 2, 3&#10;        ) a&#10;    ) a&#10;    WHERE rk = 1&#10;),&#10;&#10;dim_method as ( -- 주이용배달수단&#10;    SELECT base_month&#10;         , rider_no&#10;         , rider_delivery_method as main_delivery_method&#10;    FROM (&#10;        SELECT base_month&#10;             , rider_no&#10;             , rider_delivery_method&#10;             , row_number() over (PARTITION BY base_month, rider_no ORDER BY dlv_cnt DESC, last_pick_up_date DESC) as rk&#10;        FROM (&#10;            SELECT base_month&#10;                 , rider_no&#10;                 , rider_delivery_method&#10;                 , max(last_pick_up_date) as last_pick_up_date&#10;                 , sum(dlv_cnt) as dlv_cnt&#10;            FROM dlv&#10;            GROUP BY 1, 2, 3&#10;        ) a&#10;    ) a&#10;    WHERE rk = 1&#10;),&#10;&#10;dim as (&#10;    SELECT a.*&#10;         , b.main_svc&#10;         , c.main_rgn&#10;         , d.main_delivery_method&#10;    FROM dim_mode a&#10;    LEFT JOIN dim_svc b&#10;    ON a.base_month = b.base_month&#10;    AND a.rider_no = b.rider_no&#10;    LEFT JOIN dim_rgn c&#10;    ON a.base_month = c.base_month&#10;    AND a.rider_no = c.rider_no&#10;    LEFT JOIN dim_method d&#10;    ON a.base_month = d.base_month&#10;    AND a.rider_no = d.rider_no&#10;),&#10;&#10;full_data as ( --월별 라이더별 정보 최종&#10;    SELECT *&#10;         , lag(rlc) over (PARTITION BY rider_id ORDER BY base_month) as lag_rlc&#10;         , lag(rlc, 2) over (PARTITION BY rider_id ORDER BY base_month) as lag2_rlc&#10;         , lag(rlc, 3) over (PARTITION BY rider_id ORDER BY base_month) as lag3_rlc&#10;    FROM (&#10;        SELECT *&#10;             , case when retire_date = base_month then &apos;탈퇴&apos;&#10;                    when retire_date &lt;&lt; base_month then &apos;기존탈퇴&apos;&#10;                    when lag_dlv_cnt &gt;&gt; 0 AND dlv_cnt &gt;&gt; 0 then &apos;유지&apos;&#10;                    when business_start_date = base_month then &apos;첫배달수행&apos;&#10;                    when business_start_date &lt;&lt; base_month AND dlv_cnt = 0 then &apos;이탈&apos;&#10;                    when lag_dlv_cnt = 0 AND dlv_cnt &gt;&gt; 0 then &apos;복귀&apos;&#10;                    when first_available_delivery_date &lt;&lt;= base_month AND coalesce(business_start_date, &apos;9999-12-31&apos;) &gt;&gt; base_month then &apos;첫배달미수행&apos;&#10;                    when join_date &lt;&lt;= base_month AND coalesce(first_available_delivery_date, &apos;9999-12-31&apos;) &gt;&gt; base_month then &apos;가입&apos;&#10;                    else &apos;미분류&apos; end as rlc&#10;        FROM (&#10;            SELECT *&#10;                 , lag(dlv_cnt) over (PARTITION BY rider_id ORDER BY base_month) as lag_dlv_cnt&#10;                 , lag(dlv_cnt, 2) over (PARTITION BY rider_id ORDER BY base_month) as lag2_dlv_cnt&#10;            FROM (&#10;                SELECT a.base_month&#10;                     , b.*&#10;                     , coalesce(c.dlv_cnt, 0) as dlv_cnt&#10;                     , coalesce(c.ai_dlv_cnt, 0) as ai_dlv_cnt&#10;                     , coalesce(c.norm_dlv_cnt, 0) as norm_dlv_cnt&#10;                     , c.main_mode&#10;                     , c.main_svc&#10;                     , c.main_rgn&#10;                     , coalesce(coalesce(main_delivery_method, b.delivery_method), &apos;NONE&apos;) as main_delivery_method&#10;                FROM base_month a&#10;                LEFT JOIN riders b&#10;                ON a.base_month &gt;&gt;= b.join_date&#10;                LEFT JOIN dim c&#10;                ON a.base_month = c.base_month&#10;                AND b.rider_no = c.rider_no&#10;            ) a&#10;        ) a&#10;    ) a&#10;),&#10;&#10;ch1_rider_basic as (&#10;    SELECT base_month as month -- &quot;기준년월&quot;&#10;        , coalesce(main_delivery_method, &apos;ALL&apos;) as delivery_method -- &quot;배달수단&quot;&#10;&#10;        -- 생애주기 관련 지표&#10;&#10;        , sum(case when rlc = &apos;가입&apos; then 1 end) as join_riders_cnt -- &quot;1.가입 라이더 수&quot; &#10;        , sum(case when rlc = &apos;첫배달미수행&apos; then 1 end) as non_first_dlv_riders_cnt -- &quot;2.첫배달미수행 라이더 수&quot; &#10;        , sum(case when rlc = &apos;첫배달수행&apos; then 1 end) as first_dlv_riders_cnt -- &quot;3.첫배달수행 라이더 수&quot; &#10;        , sum(case when rlc = &apos;유지&apos; then 1 end) as retention_riders_cnt -- &quot;4.유지 라이더 수&quot; &#10;        , sum(case when rlc = &apos;복귀&apos; then 1 end) as return_riders_cnt -- &quot;5.복귀 라이더 수&quot; &#10;        , sum(case when rlc = &apos;이탈&apos; then -1 end) as churn_riders_cnt -- &quot;6.이탈 라이더 수&quot;&#10;        , sum(case when rlc = &apos;탈퇴&apos; then -1 end) as retire_riders_cnt -- &quot;7.탈퇴 라이더 수&quot;&#10;        &#10;        -- , sum(case when rlc = &apos;미분류&apos; then 1 end) as &quot;미분류 라이더 수&quot;&#10;        &#10;        , sum(case when rlc not in (&apos;탈퇴&apos;, &apos;기존탈퇴&apos;) AND join_date = base_month then 1 end) as new_join_riders_cnt -- &quot;신규 가입 라이더 수&quot;&#10;        , sum(case when rlc not in (&apos;탈퇴&apos;, &apos;기존탈퇴&apos;) AND first_available_delivery_date = base_month then 1 end) as new_dlv_available_riders_cnt -- &quot;신규 가입완료 라이더 수&quot;&#10;        , 100e0 * sum(case when rlc not in (&apos;탈퇴&apos;, &apos;기존탈퇴&apos;) AND join_date = base_month AND first_available_delivery_date = base_month then 1 end) / sum(case when rlc not in (&apos;탈퇴&apos;, &apos;기존탈퇴&apos;) AND join_date = base_month then 1 end) as dlv_available_conv_rate -- &quot;가입완료 전환율&quot;&#10;        , 100e0 * sum(case when rlc not in (&apos;탈퇴&apos;, &apos;기존탈퇴&apos;) AND first_available_delivery_date = base_month AND business_start_date = base_month then 1 end) / sum(case when rlc not in (&apos;탈퇴&apos;, &apos;기존탈퇴&apos;) AND first_available_delivery_date = base_month then 1 end) as first_dlv_conv_rate -- &quot;첫배달수행 전환율&quot;&#10;        &#10;        , sum(case when rlc in (&apos;첫배달수행&apos;, &apos;유지&apos;, &apos;복귀&apos;) then 1 end) as active_riders_cnt -- &quot;활동 라이더 수&quot;&#10;        , sum(case when rlc in (&apos;첫배달미수행&apos;, &apos;첫배달수행&apos;, &apos;유지&apos;, &apos;복귀&apos;, &apos;이탈&apos;) then 1 end) as dlv_avaiable_riders_cnt -- &quot;운행가능 라이더 수&quot;&#10;        , sum(case when rlc in (&apos;가입&apos;, &apos;첫배달미수행&apos;, &apos;첫배달수행&apos;, &apos;유지&apos;, &apos;복귀&apos;, &apos;이탈&apos;) then 1 end) as total_riders_cnt -- &quot;전체 라이더 수&quot;&#10;        &#10;        , 100e0 * sum(case when rlc in (&apos;첫배달수행&apos;, &apos;유지&apos;, &apos;복귀&apos;) then 1 end) / sum(case when rlc in (&apos;가입&apos;, &apos;첫배달미수행&apos;, &apos;첫배달수행&apos;, &apos;유지&apos;, &apos;복귀&apos;, &apos;이탈&apos;) then 1 end) as active_riders_ratio -- &quot;활동 라이더 비율&quot;&#10;        , 100e0 * sum(case when rlc in (&apos;첫배달미수행&apos;, &apos;첫배달수행&apos;, &apos;유지&apos;, &apos;복귀&apos;, &apos;이탈&apos;) then 1 end) / sum(case when rlc in (&apos;가입&apos;, &apos;첫배달미수행&apos;, &apos;첫배달수행&apos;, &apos;유지&apos;, &apos;복귀&apos;, &apos;이탈&apos;) then 1 end) as dlv_available_riders_ratio -- &quot;운행가능 라이더 비율&quot;&#10;        &#10;        , 100e0 * sum(case when lag_rlc = &apos;이탈&apos; AND rlc = &apos;복귀&apos; then 1 end) / sum(case when rlc not in (&apos;탈퇴&apos;, &apos;기존탈퇴&apos;) AND lag_rlc = &apos;이탈&apos; then 1 end) as total_return_rate -- &quot;전체 복귀율&quot;&#10;        , 100e0 * sum(case when lag2_rlc in (&apos;첫배달수행&apos;, &apos;유지&apos;, &apos;복귀&apos;) AND lag_rlc = &apos;이탈&apos; AND rlc = &apos;복귀&apos; then 1 end) / sum(case when rlc not in (&apos;탈퇴&apos;, &apos;기존탈퇴&apos;) AND lag2_rlc in (&apos;첫배달수행&apos;, &apos;유지&apos;, &apos;복귀&apos;) AND lag_rlc = &apos;이탈&apos; then 1 end) as churn_1m_return_rate -- &quot;1개월이탈 복귀율&quot;&#10;        , 100e0 * sum(case when lag3_rlc in (&apos;첫배달수행&apos;, &apos;유지&apos;, &apos;복귀&apos;) AND lag2_rlc = &apos;이탈&apos; AND lag_rlc = &apos;이탈&apos; AND rlc = &apos;복귀&apos; then 1 end) / sum(case when rlc not in (&apos;탈퇴&apos;, &apos;기존탈퇴&apos;) AND lag3_rlc in (&apos;첫배달수행&apos;, &apos;유지&apos;, &apos;복귀&apos;) AND lag2_rlc = &apos;이탈&apos; AND lag_rlc = &apos;이탈&apos; then 1 end) as churn_2m_return_rate -- &quot;2개월이탈 복귀율&quot;&#10;        &#10;        , 100e0 * sum(case when lag_rlc in (&apos;유지&apos;, &apos;복귀&apos;, &apos;첫배달수행&apos;) AND rlc = &apos;이탈&apos; then 1 end) / sum(case when rlc not in (&apos;탈퇴&apos;, &apos;기존탈퇴&apos;) AND lag_rlc in (&apos;유지&apos;, &apos;복귀&apos;, &apos;첫배달수행&apos;) then 1 end) as churn_rate -- &quot;이탈율&quot;&#10;        &#10;        , sum(case when rlc in (&apos;첫배달수행&apos;, &apos;유지&apos;, &apos;복귀&apos;) AND main_mode = &apos;AI모드&apos; then 1 end) as ai_main_riders_cnt -- &quot;AI모드 주이용라이더 수&quot;&#10;        , 100e0 * sum(case when rlc in (&apos;첫배달수행&apos;, &apos;유지&apos;, &apos;복귀&apos;) AND main_mode = &apos;AI모드&apos; then 1 end) / sum(case when rlc in (&apos;첫배달수행&apos;, &apos;유지&apos;, &apos;복귀&apos;) then 1 end) as ai_main_riders_ratio -- &quot;AI모드 주이용라이더 비율&quot;&#10;        &#10;    FROM full_data&#10;    WHERE 1=1&#10;    AND base_month &gt;&gt;= format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;12&apos; month, &apos;yyyy-MM-dd&apos;)&#10;    AND base_month &lt;&lt; format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;0&apos; month, &apos;yyyy-MM-dd&apos;)&#10;    AND main_delivery_method &lt;&lt;&gt;&gt; &apos;NONE&apos;&#10;    GROUP BY 1, rollup(main_delivery_method)&#10;),&#10;&#10;&#10;&#10;&#10;&#10;&#10;-- #####################################################################################&#10;-- 1. 활동 라이더 증가&#10;-- 1-2. 활동라이더 증가-AI수락율&#10;-- https://redash.woowa.in/queries/33208/source&#10;-- #####################################################################################&#10;&#10;dlv1 as (&#10;    select substr(business_day,1,8)||&apos;01&apos; as month, business_day, consign_date, pick_up_date, rider_delivery_method, rider_no&#10;        , lag(consign_date) over (partition by a.business_day, delivery_carry_type, rider_no order by consign_date) as lag_consign_date&#10;        , lead(consign_date) over (partition by a.business_day, delivery_carry_type, rider_no order by consign_date) as lead_consign_date&#10;    from sbtasty.dlvry2 a&#10;    left join sbtasty.rider_account b&#10;    on a.rider_no = b.rider_id&#10;    where a.business_day between format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;12&apos; month, &apos;yyyy-MM-dd&apos;) and format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;1&apos; day, &apos;yyyy-MM-dd&apos;)&#10;        -- and dlvry_status = &apos;COMPLETED_DELIVERY&apos;&#10;        -- and additional_delivery_detail_id IS NULL&#10;        and agency_name not like &apos;%테스트%&apos;&#10;        and a.agency_id &lt;&lt;&gt;&gt; 13&#10;        -- and recall is null&#10;        -- and order_type =&apos;BERA&apos;&#10;        and consign_date is not null&#10;        and hand_over_date is not null&#10;        and pick_up_date is not null&#10;        and auto_allocated=1 -- AI만 필터링&#10;        and rider_type in (&apos;CROWDSOURCING&apos;, &apos;INDIVIDUAL_OWNER&apos;)&#10;),&#10;&#10;dlv_method as (&#10;    select month, rider_id, rider_delivery_method&#10;    from(&#10;        select month, rider_id, rider_delivery_method&#10;            , row_number() over (partition by month, rider_id order by cnt desc, last_pick_up_date desc) as ranking&#10;        from(&#10;            select month&#10;                , rider_no as rider_id&#10;                , rider_delivery_method&#10;                , count(1) as cnt&#10;                , max(pick_up_date) as last_pick_up_date&#10;            from dlv1&#10;            group by 1,2,3&#10;        )&#10;    )&#10;    where ranking=1&#10;),&#10;&#10;rej as (&#10;    select month&#10;        , part_date&#10;        , bd&#10;        , rider_id&#10;        , rejected_date&#10;        , rejecter&#10;        , reason&#10;        , coalesce(rider_delivery_method, delivery_method) as rider_delivery_method&#10;    from(&#10;        select substr(part_date,1,8)||&apos;01&apos; as month, *&#10;        from sbtasty.auto_allocate_reject&#10;    )&#10;    left join dlv_method using (month, rider_id)&#10;    left join (&#10;        select rider_id&#10;            , delivery_method&#10;        from sbtasty.rider_account&#10;    ) using (rider_id)&#10;    where part_date between format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;12&apos; month, &apos;yyyy-MM-dd&apos;) and format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;1&apos; day, &apos;yyyy-MM-dd&apos;)&#10;),&#10;&#10;rej2 as (&#10;    select *&#10;        , lead(rejected_date) over (partition by bd, rider_id order by rejected_date) as lead_rejected_date&#10;        , lag(rejected_date) over (partition by bd, rider_id order by rejected_date) as lag_rejected_date&#10;    from rej&#10;    where rejecter = &apos;RIDER&apos; -- SYSTEM 제거 (2023-08-22)&#10;        and reason &lt;&lt;&gt;&gt; &apos;배차 거부&apos;&#10;),&#10;&#10;rej3 as (&#10;    select month&#10;        , part_date&#10;        , bd&#10;        , rider_id&#10;        , rider_delivery_method&#10;        , rejected_date&#10;        , lead_rejected_date&#10;        , lag_rejected_date&#10;        , case when date_diff(&apos;second&apos;, lag_rejected_date, rejected_date) &lt;&lt;= 0 then 0&#10;               when date_diff(&apos;second&apos;, rejected_date, lead_rejected_date) &lt;&lt;= 0 then 1&#10;               else null end as delta&#10;    from rej2&#10;),&#10;&#10;rej4 as (&#10;    select *&#10;        , sum(delta) over (partition by bd, rider_id order by rejected_date) as bundle_key&#10;    from rej3&#10;),&#10;&#10;rej5 as (&#10;    select *&#10;        , case when delta is not null then bundle_key end as bundle&#10;    from rej4&#10;),&#10;&#10;rej6 as (&#10;    select *&#10;        , count(bundle) over (partition by bd, rider_id, bundle) as cnt_bundle&#10;    from rej5&#10;),&#10;&#10;rej7 as (&#10;    select format_datetime(date_trunc(&apos;month&apos;, date(part_date)), &apos;yyyy-MM-dd&apos;) as month&#10;        , coalesce(rider_delivery_method, &apos;ALL&apos;) as rider_delivery_method&#10;        , sum(case when delta is not null then 1e0/cnt_bundle else 0 end) as cnt_bundle_rej&#10;        , sum(case when delta is null then 1 else 0 end) as cnt_single_rej&#10;    from rej6&#10;    group by 1, rollup(rider_delivery_method)&#10;),&#10;&#10;dlv2 as (&#10;    select *&#10;    from(&#10;        select month, business_day, consign_date, lag_consign_date, lead_consign_date&#10;            , rider_no as rider_id&#10;            , case when date_diff(&apos;second&apos;, lag_consign_date, consign_date) &lt;&lt;= 1 then 0&#10;                   when date_diff(&apos;second&apos;, consign_date, lead_consign_date) &lt;&lt;= 1 then 1&#10;                   else null end as delta&#10;        from dlv1&#10;    )&#10;    left join dlv_method using (month, rider_id)&#10;),&#10;&#10;dlv3 as (&#10;    select *&#10;        , sum(delta) over (partition by business_day, rider_id order by consign_date) as bundle_key&#10;    from dlv2&#10;),&#10;&#10;dlv4 as (&#10;    select *&#10;        , case when delta is not null then bundle_key end as bundle&#10;    from dlv3&#10;),&#10;&#10;dlv5 as (&#10;    select *&#10;        , count(bundle) over (partition by business_day, rider_id, bundle) as cnt_bundle&#10;    from dlv4&#10;),&#10;&#10;dlv6 as (&#10;    select month&#10;        , coalesce(rider_delivery_method, &apos;ALL&apos;) as rider_delivery_method&#10;        , sum(case when cnt_bundle &gt;&gt; 0 then 1e0/cnt_bundle else 1e0 end) as cnt_dlv&#10;    from dlv5&#10;    group by 1, rollup(rider_delivery_method)&#10;),&#10;&#10;ch1_ai_acceptance as (&#10;    select month&#10;        , rider_delivery_method&#10;        , cnt_dlv as single_bundle_accept_cnt&#10;        , cnt_single_rej as single_reject_cnt&#10;        , cnt_bundle_rej as bundle_reject_cnt&#10;        , 100e0*cnt_dlv/(cnt_single_rej+cnt_bundle_rej+cnt_dlv) as ai_acceptance_rate -- &quot;AI추천배차 수락율&quot;&#10;    from dlv6&#10;    join rej7 using (month, rider_delivery_method)&#10;),&#10;&#10;&#10;&#10;&#10;&#10;&#10;-- #####################################################################################&#10;-- 3. 라이더 VoC 감소&#10;-- 3-1. CPD-지역별&#10;-- https://redash.woowa.in/queries/33440/source#104044&#10;-- #####################################################################################&#10;&#10;cpd_dlv as ( -- 라이더 배달정보&#10;    SELECT format_datetime(date_trunc(&apos;month&apos;, date(a.business_day)), &apos;yyyy-MM-dd&apos;) as base_month&#10;         , a.rider_no&#10;         , case when regexp_like(coalesce(nm.rgn1_nm, c.rgn1_nm), &apos;서울&apos;) then &apos;서울&apos;&#10;                when regexp_like(coalesce(nm.rgn1_nm, c.rgn1_nm), &apos;경기&apos;) then &apos;경기&apos;&#10;                when regexp_like(coalesce(nm.rgn1_nm, c.rgn1_nm), &apos;인천&apos;) then &apos;인천&apos;&#10;                when coalesce(nm.rgn1_nm, c.rgn1_nm) is not null then &apos;지방&apos; else &apos;NONE&apos; end as rgn&#10;         , order_service_type&#10;         , count(distinct dlvry_id) as dlv_cnt&#10;         , count(d.id) as voc_cnt&#10;    FROM (&#10;        SELECT dlvry_id&#10;             , ord_no&#10;             , rider_no&#10;             , rider_delivery_method&#10;             , shop_no&#10;             , pick_up_date&#10;             , case when coalesce(order_service_type, order_type) = &apos;BERA&apos; then &apos;BAERA&apos; else coalesce(order_service_type, order_type) end as order_service_type&#10;             , business_day&#10;        FROM sbtasty.dlvry2&#10;        WHERE 1=1&#10;        AND agency_id &lt;&lt;&gt;&gt; 13 -- 테스트 데이터 제외&#10;        AND consign_date is not null&#10;        AND pick_up_date is not null&#10;        AND hand_over_date is not null&#10;        AND business_day &gt;&gt;= format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;12&apos; month, &apos;yyyy-MM-dd&apos;)&#10;        AND business_day &lt;&lt; format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;0&apos; month, &apos;yyyy-MM-dd&apos;)&#10;    ) a&#10;    INNER JOIN riders r&#10;    ON a.rider_no = r.rider_no&#10;    LEFT JOIN sbstore_hist.shop_master rgn&#10;        ON a.shop_no = rgn.shop_no&#10;        AND a.business_day = rgn.part_date&#10;    LEFT JOIN sbbi.dim_rgn_cd nm&#10;        ON rgn.rgn3_cd = nm.rgn3_cd&#10;    LEFT JOIN dsdw.commerce_seller_master c&#10;        ON a.shop_no = c.seller_id&#10;        AND a.order_service_type = &apos;BAEMIN_STORE&apos;&#10;    LEFT JOIN (&#10;        SELECT id&#10;             , sn&#10;             , order_id&#10;            --  , case when coalesce(trim(split_part(topic, &apos;→&apos;, 1)), &apos;없음&apos;) in (&apos;배달 중 이슈&apos;, &apos;배달상태 변경&apos;) then concat(&apos;배달 중 이슈 &gt;&gt; &apos;, coalesce(trim(split_part(topic, &apos;→&apos;, 2)), &apos;없음&apos;))&#10;            --         else coalesce(split_part(topic, &apos;→&apos;, 1), &apos;없음&apos;) end as category&#10;        FROM sbtasty.request_guide_record&#10;        WHERE 1=1&#10;        AND part_date &gt;&gt;= format_datetime(date_trunc(&apos;month&apos;, current_timestamp) - interval &apos;12&apos; month, &apos;yyyy-MM-dd&apos;)&#10;        AND part_date &lt;&lt; format_datetime(date_trunc(&apos;month&apos;, current_timestamp) - interval &apos;0&apos; month, &apos;yyyy-MM-dd&apos;)&#10;    ) d&#10;        ON split_part(dlvry_id, &apos;_&apos;, 2) = d.sn&#10;        AND a.ord_no = d.order_id&#10;    GROUP BY 1, 2, 3, 4&#10;),&#10;&#10;cpd_dlvry_all_svc as (&#10;    SELECT base_month&#10;        , coalesce(rgn, &apos;ALL&apos;) as rgn&#10;        , sum(dlv_cnt) as total_dlv_cnt&#10;        , sum(voc_cnt) as total_voc_cnt&#10;        , 100e0 * sum(voc_cnt) / sum(dlv_cnt) as total_cpd_pct&#10;    FROM cpd_dlv&#10;    GROUP BY 1, rollup(rgn)&#10;),&#10;&#10;-- 콜 인바운드 추가 (2023.11.08)&#10;call_inbound as (&#10;    -- part_date로 오늘 새벽 데이터가 짤리는 문제 때문에 그 다음주에 다음날 수치변동이 있을 수 있음&#10;    SELECT format_datetime(case when hour(call_dt  AT TIME ZONE &apos;Asia/Seoul&apos;) &lt;&lt; 7 then date_trunc(&apos;month&apos;, call_dt  AT TIME ZONE &apos;Asia/Seoul&apos; - interval &apos;1&apos; day)&#10;                else date_trunc(&apos;month&apos;, call_dt  AT TIME ZONE &apos;Asia/Seoul&apos;) end, &apos;yyyy-MM-dd&apos;) as base_month&#10;         , &apos;ALL&apos; as rgn&#10;         , count(1) as total_call_in_cnt&#10;    FROM cscallcenter.tb_call&#10;    WHERE 1=1&#10;    AND part_date &gt;&gt;= format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;12&apos; month, &apos;yyyy-MM-dd&apos;)&#10;    AND part_date &lt;&lt; format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) + interval &apos;1&apos; day, &apos;yyyy-MM-dd&apos;)&#10;    AND service_div = &apos;Srv19&apos; -- 배민커넥트 고객센터&#10;    AND bound_type = &apos;In&apos; -- 인바운드. 아웃바운드는 Out&#10;    GROUP BY 1&#10;),&#10;&#10;cpd_dlvry as (&#10;    SELECT a.base_month&#10;        , a.rgn&#10;         &#10;        , max(case when a.order_service_type = &apos;BAERA&apos; then dlvry_cnt end) as baera_dlv_cnt&#10;        , max(case when a.order_service_type = &apos;BAERA&apos; then voc_cnt end) as baera_voc_cnt&#10;        , 100e0 * max(case when a.order_service_type = &apos;BAERA&apos; then voc_cnt end) / max(case when a.order_service_type = &apos;BAERA&apos; then dlvry_cnt end) as baera_cpd_pct&#10;         &#10;        , max(case when a.order_service_type = &apos;MARKET&apos; then dlvry_cnt end) as market_dlv_cnt&#10;        , max(case when a.order_service_type = &apos;MARKET&apos; then voc_cnt end) as market_voc_cnt&#10;        , 100e0 * max(case when a.order_service_type = &apos;MARKET&apos; then voc_cnt end) / max(case when a.order_service_type = &apos;MARKET&apos; then dlvry_cnt end) as market_cpd_pct&#10;         &#10;        , max(case when a.order_service_type = &apos;BAEMIN_STORE&apos; then dlvry_cnt end) as store_dlv_cnt&#10;        , max(case when a.order_service_type = &apos;BAEMIN_STORE&apos; then voc_cnt end) as store_voc_cnt&#10;        , 100e0 * max(case when a.order_service_type = &apos;BAEMIN_STORE&apos; then voc_cnt end) / max(case when a.order_service_type = &apos;BAEMIN_STORE&apos; then dlvry_cnt end) as store_cpd_pct&#10;    FROM (&#10;        SELECT base_month&#10;             , coalesce(order_service_type, &apos;ALL&apos;) as order_service_type&#10;             , coalesce(rgn, &apos;ALL&apos;) as rgn&#10;             , sum(dlv_cnt) as dlvry_cnt&#10;             , sum(voc_cnt) as voc_cnt&#10;             , count(DISTINCT rider_no) as rider_cnt&#10;             , count(DISTINCT case when voc_cnt &gt;&gt; 0 then rider_no end) as voc_rider_cnt&#10;        FROM cpd_dlv&#10;        GROUP BY 1, rollup(order_service_type), rollup(rgn)&#10;    ) a&#10;    WHERE a.rgn &lt;&lt;&gt;&gt; &apos;NONE&apos;&#10;    GROUP BY 1, 2&#10;),&#10;&#10;ch3_cpd1 as (&#10;    SELECT a.base_month as month -- &quot;기준년월&quot;&#10;         , a.rgn -- as &quot;픽업지역&quot;&#10;         &#10;         , a.total_dlv_cnt -- as &quot;(전체) 배달건수&quot;&#10;        --  , a.total_voc_cnt -- as &quot;(전체) voc건수&quot;&#10;         , (a.total_voc_cnt + c.total_call_in_cnt) as total_voc_cnt -- &quot;(전체) voc건수&quot;&#10;        --  , a.total_cpd_pct -- as &quot;(전체) CPD&quot;&#10;         , 100e0* (a.total_voc_cnt + c.total_call_in_cnt) / a.total_dlv_cnt as total_cpd_pct -- &quot;(전체) CPD&quot;&#10;         &#10;         , baera_dlv_cnt -- as &quot;(배민1) 배달건수&quot;&#10;         , baera_voc_cnt -- as &quot;(배민1) voc건수&quot;&#10;         , baera_cpd_pct -- as &quot;(배민1) CPD&quot;&#10;         &#10;         , market_dlv_cnt -- as &quot;(B마트) 배달건수&quot;&#10;         , market_voc_cnt -- as &quot;(B마트) voc건수&quot;&#10;         , market_cpd_pct -- as &quot;(B마트) CPD&quot;&#10;         &#10;         , store_dlv_cnt -- as &quot;(스토어) 배달건수&quot;&#10;         , store_voc_cnt -- as &quot;(스토어) voc건수&quot;&#10;         , store_cpd_pct -- as &quot;(스토어) CPD&quot;&#10;    FROM cpd_dlvry_all_svc a&#10;    LEFT JOIN cpd_dlvry b&#10;    ON a.base_month = b.base_month&#10;    AND a.rgn = b.rgn&#10;    LEFT JOIN call_inbound c&#10;    ON a.base_month = c.base_month&#10;    AND a.rgn = c.rgn&#10;    WHERE 1=1&#10;    AND a.rgn &lt;&lt;&gt;&gt; &apos;NONE&apos;&#10;)&#10;&#10;&#10;&#10;&#10;&#10;&#10;-- #####################################################################################&#10;-- [FINAL] 최종 결과 취합&#10;-- month | delivery_method | rgn | ...&#10;-- #####################################################################################&#10;&#10;SELECT a.month&#10;     , a.delivery_method&#10;     , a.rgn&#10;&#10;     , join_riders_cnt&#10;     , non_first_dlv_riders_cnt&#10;     , first_dlv_riders_cnt&#10;     , retention_riders_cnt&#10;     , return_riders_cnt&#10;     , churn_riders_cnt&#10;     , retire_riders_cnt&#10;     , new_join_riders_cnt&#10;     , new_dlv_available_riders_cnt&#10;     , dlv_available_conv_rate&#10;     , first_dlv_conv_rate&#10;     , active_riders_cnt&#10;     , dlv_avaiable_riders_cnt&#10;     , total_riders_cnt&#10;     , active_riders_ratio&#10;     , dlv_available_riders_ratio&#10;     , total_return_rate&#10;     , churn_1m_return_rate&#10;     , churn_2m_return_rate&#10;     , churn_rate&#10;     , ai_main_riders_cnt&#10;     , ai_main_riders_ratio&#10;&#10;     , c.single_bundle_accept_cnt&#10;     , c.single_reject_cnt&#10;     , c.bundle_reject_cnt&#10;     , c.ai_acceptance_rate&#10;&#10;    --  , d.total_idle_time_rate&#10;    --  , d.ai_idle_time_rate&#10;    --  , d.normal_idle_time_rate&#10;    --  , d.total_work_time&#10;    --  , d.avg_work_time&#10;    --  , d.avg_dlv_time&#10;    --  , d.utr_with_idle_time&#10;    --  , d.pay_per_hour_with_idle_time&#10;    --  , d.unpaid_moving_time_ratio&#10;    --  , d.avg_work_time_rate&#10;    --  , d.avg_work_time_rate_wo_non_workdays&#10;&#10;    --  , e.avg_work_freq&#10;    --  , e.avg_work_days_cnt&#10;&#10;     , f.total_dlv_cnt&#10;     , f.total_voc_cnt&#10;     , f.total_cpd_pct&#10;     , f.baera_dlv_cnt&#10;     , f.baera_voc_cnt&#10;     , f.baera_cpd_pct&#10;     , f.market_dlv_cnt&#10;     , f.market_voc_cnt&#10;     , f.market_cpd_pct&#10;     , f.store_dlv_cnt&#10;     , f.store_voc_cnt&#10;     , f.store_cpd_pct&#10;FROM (&#10;    SELECT DISTINCT base_month as month&#10;         , rider_delivery_method as delivery_method&#10;         , rgn&#10;    FROM dlv&#10;&#10;    union all&#10;&#10;    SELECT DISTINCT base_month as month&#10;         , &apos;ALL&apos; as delivery_method&#10;         , &apos;ALL&apos; as rgn&#10;    FROM dlv&#10;) a&#10;LEFT JOIN ch1_rider_basic b&#10;    ON a.month = b.month&#10;    AND a.delivery_method = b.delivery_method&#10;LEFT JOIN ch1_ai_acceptance c&#10;    ON a.month = c.month&#10;    AND a.delivery_method = c.rider_delivery_method&#10;-- LEFT JOIN ch2_worktime1 d&#10;--     ON a.month = d.month&#10;--     AND a.delivery_method = d.delivery_method&#10;-- LEFT JOIN ch2_worktime2 e&#10;--     ON a.month = cast(e.month as varchar)&#10;--     AND a.delivery_method = e.delivery_method&#10;LEFT JOIN ch3_cpd1 f&#10;    ON a.month = f.month&#10;    AND a.rgn = f.rgn&#10;WHERE 1=1&#10;AND a.month &gt;&gt;= format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;12&apos; month, &apos;yyyy-MM-dd&apos;)&#10;AND a.month &lt;&lt; format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;0&apos; month, &apos;yyyy-MM-dd&apos;)&#10;ORDER BY month DESC, delivery_method</relation>
        </properties>
        <properties context='extract'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </properties>
      </object>
    </objects>
  </object-graph>
</datasource>
