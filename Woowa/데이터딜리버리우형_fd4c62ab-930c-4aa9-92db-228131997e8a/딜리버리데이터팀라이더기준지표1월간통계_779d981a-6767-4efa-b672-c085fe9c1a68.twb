          <object-id>[_638B4510DF8742249D88F3AE97BDEE4C]</object-id>
        </metadata-record>
        <metadata-record class='column'>
          <remote-name>store_cpd_pct</remote-name>
          <remote-type>5</remote-type>
          <local-name>[store_cpd_pct]</local-name>
          <parent-name>[Extract]</parent-name>
          <remote-alias>store_cpd_pct</remote-alias>
          <ordinal>40</ordinal>
          <family>사용자 지정 SQL 쿼리</family>
          <local-type>real</local-type>
          <aggregation>Sum</aggregation>
          <approx-count>42</approx-count>
          <contains-null>true</contains-null>
          <object-id>[_638B4510DF8742249D88F3AE97BDEE4C]</object-id>
