    <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.1gpivur05bqw5e1bagvha1e1xh8o' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[WITH

riders as ( -- 라이더 계정정보
    SELECT a.id as rider_id
         , b.rider_id as rider_no
         , a.delivery_method
         , b.join_channel
         , a.account_status
         , format_datetime(a.join_date AT TIME ZONE 'Asia/Seoul', 'yyyy-MM-dd') as join_date_org -- brms 스키마 데이터는 UTC ->> KST 변경 필요
         , format_datetime(a.first_available_delivery_date AT TIME ZONE 'Asia/Seoul', 'yyyy-MM-dd') as first_available_delivery_date_org
         , format_datetime(date_parse(a.business_start_day, '%Y%m%d'), 'yyyy-MM-dd') as business_start_date_org
         
         , format_datetime(date_trunc('week', a.join_date AT TIME ZONE 'Asia/Seoul'), 'yyyy-MM-dd') as join_date -- brms 스키마 데이터는 UTC ->> KST 변경 필요
         , format_datetime(date_trunc('week', a.first_available_delivery_date AT TIME ZONE 'Asia/Seoul'), 'yyyy-MM-dd') as first_available_delivery_date
         , format_datetime(date_trunc('week', date_parse(a.business_start_day, '%Y%m%d')), 'yyyy-MM-dd') as business_start_date
         , format_datetime(date_trunc('week', a.retire_date AT TIME ZONE 'Asia/Seoul'), 'yyyy-MM-dd') as retire_date
    FROM brms.rider_account a
    LEFT JOIN sbtasty.rider_account b
    ON a.id = b.brms_rider_id
    WHERE 1=1
    AND a.agency_id <<>> 13 -- 테스트 데이터 제외
    AND a.tester <<>> 1 -- 테스트 데이터 제외
    AND a.rider_type in ('CROWDSOURCING', 'INDIVIDUAL_OWNER') -- 대상 라이더타입 필터링
),

dlv as ( -- 라이더 배달정보
    SELECT format_datetime(date_trunc('week', date(business_day)), 'yyyy-MM-dd') as base_week
         , rider_no
         , case when regexp_like(coalesce(nm.rgn1_nm, c.rgn1_nm), '서울') then '서울'
                when regexp_like(coalesce(nm.rgn1_nm, c.rgn1_nm), '경기') then '경기'
                when regexp_like(coalesce(nm.rgn1_nm, c.rgn1_nm), '인천') then '인천'
                when coalesce(nm.rgn1_nm, c.rgn1_nm) is not null then '지방' else 'NONE' end as rgn
         , rider_delivery_method
         , case when coalesce(order_service_type, order_type) = 'BERA' then 'BAERA' else coalesce(order_service_type, order_type) end as order_service_type
         , auto_allocated 
         , max(pick_up_date) as last_pick_up_date
         , count(1) as dlv_cnt
    FROM sbtasty.dlvry2 a
    LEFT JOIN sbstore_hist.shop_master rgn
        ON a.shop_no = rgn.shop_no
        AND a.business_day = rgn.part_date
    LEFT JOIN sbbi.dim_rgn_cd nm
        ON rgn.rgn3_cd = nm.rgn3_cd
    LEFT JOIN dsdw.commerce_seller_master c
        ON a.shop_no = c.seller_id
        AND a.order_service_type = 'BAEMIN_STORE'
    WHERE 1=1
    AND agency_id <<>> 13 -- 테스트 데이터 제외
    AND consign_date is not null
    AND pick_up_date is not null
    AND hand_over_date is not null
    AND business_day >>= format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '112' day, 'yyyy-MM-dd')
    AND business_day << format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '0' day, 'yyyy-MM-dd')
    GROUP BY 1, 2, 3, 4, 5, 6
),

base_week as ( -- 기준년월
    SELECT base_week
        , format_datetime(date(base_week) - interval '3' day, 'yyyy-MM-dd') as start_date -- (2주누적)가입완료율 계산을 위해
        , format_datetime(date(base_week) + interval '6' day, 'yyyy-MM-dd') as end_date
        , format_datetime(date(base_week) - interval '7' day, 'yyyy-MM-dd') as w_1_start_date
        , format_datetime(date(base_week) - interval '1' day, 'yyyy-MM-dd') as w_1_end_date
    FROM (
        SELECT distinct base_week
        FROM dlv
    ) a
),

dim_mode as ( -- 주이용배차모드
    SELECT base_week
         , rider_no
         , dlv_cnt
         , ai_dlv_cnt
         , norm_dlv_cnt
         , case when ai_dlv_cnt >>= norm_dlv_cnt then 'AI모드' else '일반모드' end as main_mode
    FROM (
        SELECT base_week
             , rider_no
             , sum(dlv_cnt) as dlv_cnt
             , sum(case when auto_allocated = 1 then dlv_cnt else 0 end) as ai_dlv_cnt
             , sum(case when auto_allocated = 0 then dlv_cnt else 0 end) as norm_dlv_cnt
        FROM dlv
        GROUP BY 1, 2
    ) a
),

dim_svc as ( -- 주이용서비스
    SELECT base_week
         , rider_no
         , order_service_type as main_svc
    FROM (
        SELECT base_week
             , rider_no
             , order_service_type
             , row_number() over (PARTITION BY base_week, rider_no ORDER BY dlv_cnt DESC, last_pick_up_date DESC) as rk
        FROM (
            SELECT base_week
                 , rider_no
                 , order_service_type
                 , max(last_pick_up_date) as last_pick_up_date
                 , sum(dlv_cnt) as dlv_cnt
            FROM dlv
            GROUP BY 1, 2, 3
        ) a
    ) a
    WHERE rk = 1
),

dim_rgn as ( -- 주이용지역
    SELECT base_week
         , rider_no
         , rgn as main_rgn
    FROM (
        SELECT base_week
             , rider_no
             , rgn
             , row_number() over (PARTITION BY base_week, rider_no ORDER BY dlv_cnt DESC, last_pick_up_date DESC) as rk
        FROM (
            SELECT base_week
                 , rider_no
                 , rgn
                 , max(last_pick_up_date) as last_pick_up_date
                 , sum(dlv_cnt) as dlv_cnt
            FROM dlv
            GROUP BY 1, 2, 3
        ) a
    ) a
    WHERE rk = 1
),

dim_method as ( -- 주이용배달수단
    SELECT base_week
         , rider_no
         , rider_delivery_method as main_delivery_method
    FROM (
        SELECT base_week
             , rider_no
             , rider_delivery_method
             , row_number() over (PARTITION BY base_week, rider_no ORDER BY dlv_cnt DESC, last_pick_up_date DESC) as rk
        FROM (
            SELECT base_week
                 , rider_no
                 , rider_delivery_method
                 , max(last_pick_up_date) as last_pick_up_date
                 , sum(dlv_cnt) as dlv_cnt
            FROM dlv
            GROUP BY 1, 2, 3
        ) a
    ) a
    WHERE rk = 1
),

dim as (
    SELECT a.*
         , b.main_svc
         , c.main_rgn
         , d.main_delivery_method
    FROM dim_mode a
    LEFT JOIN dim_svc b
    ON a.base_week = b.base_week
    AND a.rider_no = b.rider_no
    LEFT JOIN dim_rgn c
    ON a.base_week = c.base_week
    AND a.rider_no = c.rider_no
    LEFT JOIN dim_method d
    ON a.base_week = d.base_week
    AND a.rider_no = d.rider_no
),

full_data as ( --월별 라이더별 정보 최종
    SELECT *
         , lag(rlc) over (PARTITION BY rider_id ORDER BY base_week) as lag_rlc
         , lag(rlc, 2) over (PARTITION BY rider_id ORDER BY base_week) as lag2_rlc
         , lag(rlc, 3) over (PARTITION BY rider_id ORDER BY base_week) as lag3_rlc
    FROM (
        SELECT *
             , case when retire_date = base_week then '탈퇴'
                    when retire_date << base_week then '기존탈퇴'
                    when lag_dlv_cnt >> 0 AND dlv_cnt >> 0 then '유지'
                    when business_start_date = base_week then '첫배달수행'
                    when business_start_date << base_week AND dlv_cnt = 0 then '이탈'
                    when lag_dlv_cnt = 0 AND dlv_cnt >> 0 then '복귀'
                    when first_available_delivery_date <<= base_week AND coalesce(business_start_date, '9999-12-31') >> base_week then '첫배달미수행'
                    when join_date <<= base_week AND coalesce(first_available_delivery_date, '9999-12-31') >> base_week then '가입'
                    else '미분류' end as rlc
        FROM (
            SELECT *
                 , lag(dlv_cnt) over (PARTITION BY rider_id ORDER BY base_week) as lag_dlv_cnt
                 , lag(dlv_cnt, 2) over (PARTITION BY rider_id ORDER BY base_week) as lag2_dlv_cnt
            FROM (
                SELECT a.*
                     , b.*
                     , coalesce(c.dlv_cnt, 0) as dlv_cnt
                     , coalesce(c.ai_dlv_cnt, 0) as ai_dlv_cnt
                     , coalesce(c.norm_dlv_cnt, 0) as norm_dlv_cnt
                     , c.main_mode
                     , c.main_svc
                     , c.main_rgn
                     , coalesce(coalesce(main_delivery_method, b.delivery_method), 'NONE') as main_delivery_method
                FROM base_week a
                LEFT JOIN riders b
                ON a.base_week >>= b.join_date
                LEFT JOIN dim c
                ON a.base_week = c.base_week
                AND b.rider_no = c.rider_no
            ) a
        ) a
    ) a
),

ch1_rider_basic as (
    SELECT base_week as week -- "기준년월"
        , coalesce(main_delivery_method, 'ALL') as delivery_method -- "배달수단"

        -- 생애주기 관련 지표

        , sum(case when rlc = '가입' then 1 end) as join_riders_cnt -- "1.가입 라이더 수" 
        , sum(case when rlc = '첫배달미수행' then 1 end) as non_first_dlv_riders_cnt -- "2.첫배달미수행 라이더 수" 
        , sum(case when rlc = '첫배달수행' then 1 end) as first_dlv_riders_cnt -- "3.첫배달수행 라이더 수" 
        , sum(case when rlc = '유지' then 1 end) as retention_riders_cnt -- "4.유지 라이더 수" 
        , sum(case when rlc = '복귀' then 1 end) as return_riders_cnt -- "5.복귀 라이더 수" 
        , sum(case when rlc = '이탈' then -1 end) as churn_riders_cnt -- "6.이탈 라이더 수"
        , sum(case when rlc = '탈퇴' then -1 end) as retire_riders_cnt -- "7.탈퇴 라이더 수"
        
        -- , sum(case when rlc = '미분류' then 1 end) as "미분류 라이더 수"
        
        , sum(case when rlc not in ('탈퇴', '기존탈퇴') AND join_date = base_week then 1 end) as new_join_riders_cnt -- "신규 가입 라이더 수"
        , sum(case when rlc not in ('탈퇴', '기존탈퇴') AND first_available_delivery_date = base_week then 1 end) as new_dlv_available_riders_cnt -- "신규 가입완료 라이더 수"
        -- , 100e0 * sum(case when rlc not in ('탈퇴', '기존탈퇴') AND join_date = base_week AND first_available_delivery_date = base_week then 1 end) / sum(case when rlc not in ('탈퇴', '기존탈퇴') AND join_date = base_week then 1 end) as dlv_available_conv_rate -- "가입완료 전환율" -- 2주누적 가입완료율로 대체
        , 100e0 * sum(case when rlc not in ('탈퇴', '기존탈퇴') AND join_date_org between w_1_start_date and w_1_end_date AND first_available_delivery_date_org between w_1_start_date and end_date then 1 end) / sum(case when rlc not in ('탈퇴', '기존탈퇴') AND join_date_org between w_1_start_date and w_1_end_date then 1 end) as dlv_available_conv_rate -- "(2주누적)가입완료율"
        , 100e0 * sum(case when rlc not in ('탈퇴', '기존탈퇴') AND first_available_delivery_date = base_week AND business_start_date = base_week then 1 end) / sum(case when rlc not in ('탈퇴', '기존탈퇴') AND first_available_delivery_date = base_week then 1 end) as first_dlv_conv_rate -- "첫배달수행 전환율"
        
        , sum(case when rlc in ('첫배달수행', '유지', '복귀') then 1 end) as active_riders_cnt -- "활동 라이더 수"
        , sum(case when rlc in ('첫배달미수행', '첫배달수행', '유지', '복귀', '이탈') then 1 end) as dlv_avaiable_riders_cnt -- "운행가능 라이더 수"
        , sum(case when rlc in ('가입', '첫배달미수행', '첫배달수행', '유지', '복귀', '이탈') then 1 end) as total_riders_cnt -- "전체 라이더 수"
        
        , 100e0 * sum(case when rlc in ('첫배달수행', '유지', '복귀') then 1 end) / sum(case when rlc in ('가입', '첫배달미수행', '첫배달수행', '유지', '복귀', '이탈') then 1 end) as active_riders_ratio -- "활동 라이더 비율"
        , 100e0 * sum(case when rlc in ('첫배달미수행', '첫배달수행', '유지', '복귀', '이탈') then 1 end) / sum(case when rlc in ('가입', '첫배달미수행', '첫배달수행', '유지', '복귀', '이탈') then 1 end) as dlv_available_riders_ratio -- "운행가능 라이더 비율"
        
        , 100e0 * sum(case when lag_rlc = '이탈' AND rlc = '복귀' then 1 end) / sum(case when rlc not in ('탈퇴', '기존탈퇴') AND lag_rlc = '이탈' then 1 end) as total_return_rate -- "전체 복귀율"
        , 100e0 * sum(case when lag2_rlc in ('첫배달수행', '유지', '복귀') AND lag_rlc = '이탈' AND rlc = '복귀' then 1 end) / sum(case when rlc not in ('탈퇴', '기존탈퇴') AND lag2_rlc in ('첫배달수행', '유지', '복귀') AND lag_rlc = '이탈' then 1 end) as churn_1w_return_rate -- "1주이탈 복귀율"
        , 100e0 * sum(case when lag3_rlc in ('첫배달수행', '유지', '복귀') AND lag2_rlc = '이탈' AND lag_rlc = '이탈' AND rlc = '복귀' then 1 end) / sum(case when rlc not in ('탈퇴', '기존탈퇴') AND lag3_rlc in ('첫배달수행', '유지', '복귀') AND lag2_rlc = '이탈' AND lag_rlc = '이탈' then 1 end) as churn_2w_return_rate -- "2이탈 복귀율"
        
        , 100e0 * sum(case when lag_rlc in ('유지', '복귀', '첫배달수행') AND rlc = '이탈' then 1 end) / sum(case when rlc not in ('탈퇴', '기존탈퇴') AND lag_rlc in ('유지', '복귀', '첫배달수행') then 1 end) as churn_rate -- "이탈율"
        
        , sum(case when rlc in ('첫배달수행', '유지', '복귀') AND main_mode = 'AI모드' then 1 end) as ai_main_riders_cnt -- "AI모드 주이용라이더 수"
        , 100e0 * sum(case when rlc in ('첫배달수행', '유지', '복귀') AND main_mode = 'AI모드' then 1 end) / sum(case when rlc in ('첫배달수행', '유지', '복귀') then 1 end) as ai_main_riders_ratio -- "AI모드 주이용라이더 비율"
        
    FROM full_data
    WHERE 1=1
    AND base_week >>= format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '84' day, 'yyyy-MM-dd')
    AND base_week << format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '0' day, 'yyyy-MM-dd')
    AND main_delivery_method <<>> 'NONE'
    GROUP BY 1, rollup(main_delivery_method)
),






-- #####################################################################################
-- 1. 활동 라이더 증가
-- 1-2. 활동라이더 증가-AI수락율
-- https://redash.woowa.in/queries/33208/source
-- #####################################################################################

dlv1 as (
    select format_datetime(date_trunc('week', date(business_day)), 'yyyy-MM-dd') as week, business_day, consign_date, pick_up_date, rider_delivery_method, rider_no
        , lag(consign_date) over (partition by a.business_day, delivery_carry_type, rider_no order by consign_date) as lag_consign_date
        , lead(consign_date) over (partition by a.business_day, delivery_carry_type, rider_no order by consign_date) as lead_consign_date
    from sbtasty.dlvry2 a
    left join sbtasty.rider_account b
    on a.rider_no = b.rider_id
    where a.business_day between format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '84' day, 'yyyy-MM-dd') and format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '1' day, 'yyyy-MM-dd')
        -- and dlvry_status = 'COMPLETED_DELIVERY'
        -- and additional_delivery_detail_id IS NULL
        and agency_name not like '%테스트%'
        and a.agency_id <<>> 13
        -- and recall is null
        -- and order_type ='BERA'
        and consign_date is not null
        and hand_over_date is not null
        and pick_up_date is not null
        and auto_allocated=1 -- AI만 필터링
        and rider_type in ('CROWDSOURCING', 'INDIVIDUAL_OWNER')
),

dlv_method as (
    select week, rider_id, rider_delivery_method
    from(
        select week, rider_id, rider_delivery_method
            , row_number() over (partition by week, rider_id order by cnt desc, last_pick_up_date desc) as ranking
        from(
            select week
                , rider_no as rider_id
                , rider_delivery_method
                , count(1) as cnt
                , max(pick_up_date) as last_pick_up_date
            from dlv1
            group by 1,2,3
        )
    )
    where ranking=1
),

rej as (
    select week
        , part_date
        , bd
        , rider_id
        , rejected_date
        , rejecter
        , reason
        , coalesce(rider_delivery_method, delivery_method) as rider_delivery_method
    from(
        select format_datetime(date_trunc('week', date(part_date)), 'yyyy-MM-dd') as week, *
        from sbtasty.auto_allocate_reject
    )
    left join dlv_method using (week, rider_id)
    left join (
        select rider_id
            , delivery_method
        from sbtasty.rider_account
    ) using (rider_id)
    where part_date between format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '84' day, 'yyyy-MM-dd') and format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '1' day, 'yyyy-MM-dd')
),

rej2 as (
    select *
        , lead(rejected_date) over (partition by bd, rider_id order by rejected_date) as lead_rejected_date
        , lag(rejected_date) over (partition by bd, rider_id order by rejected_date) as lag_rejected_date
    from rej
    where rejecter = 'RIDER' -- SYSTEM 제거 (2023-08-22)
        and reason <<>> '배차 거부'
),

rej3 as (
    select week
        , part_date
        , bd
        , rider_id
        , rider_delivery_method
        , rejected_date
        , lead_rejected_date
        , lag_rejected_date
        , case when date_diff('second', lag_rejected_date, rejected_date) <<= 0 then 0
               when date_diff('second', rejected_date, lead_rejected_date) <<= 0 then 1
               else null end as delta
    from rej2
),

rej4 as (
    select *
        , sum(delta) over (partition by bd, rider_id order by rejected_date) as bundle_key
    from rej3
),

rej5 as (
    select *
        , case when delta is not null then bundle_key end as bundle
    from rej4
),

rej6 as (
    select *
        , count(bundle) over (partition by bd, rider_id, bundle) as cnt_bundle
    from rej5
),

rej7 as (
    select format_datetime(date_trunc('week', date(part_date)), 'yyyy-MM-dd') as week
        , coalesce(rider_delivery_method, 'ALL') as rider_delivery_method
        , sum(case when delta is not null then 1e0/cnt_bundle else 0 end) as cnt_bundle_rej
        , sum(case when delta is null then 1 else 0 end) as cnt_single_rej
    from rej6
    group by 1, rollup(rider_delivery_method)
),

dlv2 as (
    select *
    from(
        select week, business_day, consign_date, lag_consign_date, lead_consign_date
            , rider_no as rider_id
            , case when date_diff('second', lag_consign_date, consign_date) <<= 1 then 0
                   when date_diff('second', consign_date, lead_consign_date) <<= 1 then 1
                   else null end as delta
        from dlv1
    )
    left join dlv_method using (week, rider_id)
),

dlv3 as (
    select *
        , sum(delta) over (partition by business_day, rider_id order by consign_date) as bundle_key
    from dlv2
),

dlv4 as (
    select *
        , case when delta is not null then bundle_key end as bundle
    from dlv3
),

dlv5 as (
    select *
        , count(bundle) over (partition by business_day, rider_id, bundle) as cnt_bundle
    from dlv4
),

dlv6 as (
    select week
        , coalesce(rider_delivery_method, 'ALL') as rider_delivery_method
        , sum(case when cnt_bundle >> 0 then 1e0/cnt_bundle else 1e0 end) as cnt_dlv
    from dlv5
    group by 1, rollup(rider_delivery_method)
),

ch1_ai_acceptance as (
    select week
        , rider_delivery_method
        , cnt_dlv as single_bundle_accept_cnt
        , cnt_single_rej as single_reject_cnt
        , cnt_bundle_rej as bundle_reject_cnt
        , 100e0*cnt_dlv/(cnt_single_rej+cnt_bundle_rej+cnt_dlv) as ai_acceptance_rate -- "AI추천배차 수락율"
    from dlv6
    join rej7 using (week, rider_delivery_method)
),






-- #####################################################################################
-- 3. 라이더 VoC 감소
-- 3-1. CPD-지역별
-- https://redash.woowa.in/queries/33440/source#104044
-- #####################################################################################

cpd_dlv as ( -- 라이더 배달정보
    SELECT format_datetime(date_trunc('week', date(a.business_day)), 'yyyy-MM-dd') as base_week
         , a.rider_no
         , case when regexp_like(coalesce(nm.rgn1_nm, c.rgn1_nm), '서울') then '서울'
                when regexp_like(coalesce(nm.rgn1_nm, c.rgn1_nm), '경기') then '경기'
                when regexp_like(coalesce(nm.rgn1_nm, c.rgn1_nm), '인천') then '인천'
                when coalesce(nm.rgn1_nm, c.rgn1_nm) is not null then '지방' else 'NONE' end as rgn
         , order_service_type
         , count(distinct dlvry_id) as dlv_cnt
         , count(d.id) as voc_cnt
    FROM (
        SELECT dlvry_id
             , ord_no
             , rider_no
             , rider_delivery_method
             , shop_no
             , pick_up_date
             , case when coalesce(order_service_type, order_type) = 'BERA' then 'BAERA' else coalesce(order_service_type, order_type) end as order_service_type
             , business_day
        FROM sbtasty.dlvry2
        WHERE 1=1
        AND agency_id <<>> 13 -- 테스트 데이터 제외
        AND consign_date is not null
        AND pick_up_date is not null
        AND hand_over_date is not null
        AND business_day >>= format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '84' day, 'yyyy-MM-dd')
        AND business_day << format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '0' day, 'yyyy-MM-dd')
    ) a
    INNER JOIN riders r
    ON a.rider_no = r.rider_no
    LEFT JOIN sbstore_hist.shop_master rgn
        ON a.shop_no = rgn.shop_no
        AND a.business_day = rgn.part_date
    LEFT JOIN sbbi.dim_rgn_cd nm
        ON rgn.rgn3_cd = nm.rgn3_cd
    LEFT JOIN dsdw.commerce_seller_master c
        ON a.shop_no = c.seller_id
        AND a.order_service_type = 'BAEMIN_STORE'
    LEFT JOIN (
        SELECT id
             , sn
             , order_id
            --  , case when coalesce(trim(split_part(topic, '→', 1)), '없음') in ('배달 중 이슈', '배달상태 변경') then concat('배달 중 이슈 >> ', coalesce(trim(split_part(topic, '→', 2)), '없음'))
            --         else coalesce(split_part(topic, '→', 1), '없음') end as category
        FROM sbtasty.request_guide_record
        WHERE 1=1
        AND part_date >>= format_datetime(date_trunc('week', current_timestamp) - interval '84' day, 'yyyy-MM-dd')
        AND part_date << format_datetime(date_trunc('week', current_timestamp) - interval '0' day, 'yyyy-MM-dd')
    ) d
        ON split_part(dlvry_id, '_', 2) = d.sn
        AND a.ord_no = d.order_id
    GROUP BY 1, 2, 3, 4
),

cpd_dlvry_all_svc as (
    SELECT base_week
        , coalesce(rgn, 'ALL') as rgn
        , sum(dlv_cnt) as total_dlv_cnt
        , sum(voc_cnt) as total_voc_cnt
        , 100e0 * sum(voc_cnt) / sum(dlv_cnt) as total_cpd_pct
    FROM cpd_dlv
    GROUP BY 1, rollup(rgn)
),

-- 콜 인바운드 추가 (2023.11.08)
call_inbound as (
    -- part_date로 오늘 새벽 데이터가 짤리는 문제 때문에 그 다음주에 다음날 수치변동이 있을 수 있음
    SELECT format_datetime(case when hour(call_dt  AT TIME ZONE 'Asia/Seoul') << 7 then date_trunc('week', call_dt  AT TIME ZONE 'Asia/Seoul' - interval '1' day)
                else date_trunc('week', call_dt  AT TIME ZONE 'Asia/Seoul') end, 'yyyy-MM-dd') as base_week
         , 'ALL' as rgn
         , count(1) as total_call_in_cnt
    FROM cscallcenter.tb_call
    WHERE 1=1
    AND part_date >>= format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '84' day, 'yyyy-MM-dd')
    AND part_date << format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') + interval '1' day, 'yyyy-MM-dd')
    AND service_div = 'Srv19' -- 배민커넥트 고객센터
    AND bound_type = 'In' -- 인바운드. 아웃바운드는 Out
    GROUP BY 1
),

cpd_dlvry as (
    SELECT a.base_week
        , a.rgn
         
        , max(case when a.order_service_type = 'BAERA' then dlvry_cnt end) as baera_dlv_cnt
        , max(case when a.order_service_type = 'BAERA' then voc_cnt end) as baera_voc_cnt
        , 100e0 * max(case when a.order_service_type = 'BAERA' then voc_cnt end) / max(case when a.order_service_type = 'BAERA' then dlvry_cnt end) as baera_cpd_pct
         
        , max(case when a.order_service_type = 'MARKET' then dlvry_cnt end) as market_dlv_cnt
        , max(case when a.order_service_type = 'MARKET' then voc_cnt end) as market_voc_cnt
        , 100e0 * max(case when a.order_service_type = 'MARKET' then voc_cnt end) / max(case when a.order_service_type = 'MARKET' then dlvry_cnt end) as market_cpd_pct
         
        , max(case when a.order_service_type = 'BAEMIN_STORE' then dlvry_cnt end) as store_dlv_cnt
        , max(case when a.order_service_type = 'BAEMIN_STORE' then voc_cnt end) as store_voc_cnt
        , 100e0 * max(case when a.order_service_type = 'BAEMIN_STORE' then voc_cnt end) / max(case when a.order_service_type = 'BAEMIN_STORE' then dlvry_cnt end) as store_cpd_pct
    FROM (
        SELECT base_week
             , coalesce(order_service_type, 'ALL') as order_service_type
             , coalesce(rgn, 'ALL') as rgn
             , sum(dlv_cnt) as dlvry_cnt
             , sum(voc_cnt) as voc_cnt
             , count(DISTINCT rider_no) as rider_cnt
             , count(DISTINCT case when voc_cnt >> 0 then rider_no end) as voc_rider_cnt
        FROM cpd_dlv
        GROUP BY 1, rollup(order_service_type), rollup(rgn)
    ) a
    WHERE a.rgn <<>> 'NONE'
    GROUP BY 1, 2
),

ch3_cpd1 as (
    SELECT a.base_week as week -- "기준년월"
         , a.rgn -- as "픽업지역"
         
         , a.total_dlv_cnt -- as "(전체) 배달건수"
         , (a.total_voc_cnt + c.total_call_in_cnt) as total_voc_cnt -- "(전체) voc건수"
        --  , a.total_cpd_pct -- as "(전체) CPD"
         , 100e0* (a.total_voc_cnt + c.total_call_in_cnt) / a.total_dlv_cnt as total_cpd_pct -- "(전체) CPD"
         
         , baera_dlv_cnt -- as "(배민1) 배달건수"
         , baera_voc_cnt -- as "(배민1) voc건수"
         , baera_cpd_pct -- as "(배민1) CPD"
         
         , market_dlv_cnt -- as "(B마트) 배달건수"
         , market_voc_cnt -- as "(B마트) voc건수"
         , market_cpd_pct -- as "(B마트) CPD"
         
         , store_dlv_cnt -- as "(스토어) 배달건수"
         , store_voc_cnt -- as "(스토어) voc건수"
         , store_cpd_pct -- as "(스토어) CPD"
    FROM cpd_dlvry_all_svc a
    LEFT JOIN cpd_dlvry b
    ON a.base_week = b.base_week
    AND a.rgn = b.rgn
    LEFT JOIN call_inbound c
    ON a.base_week = c.base_week
    AND a.rgn = c.rgn
    WHERE 1=1
    AND a.rgn <<>> 'NONE'
)






-- #####################################################################################
-- [FINAL] 최종 결과 취합
-- week | delivery_method | rgn | ...
-- #####################################################################################

SELECT a.week
     , a.delivery_method
     , a.rgn

     , join_riders_cnt
     , non_first_dlv_riders_cnt
     , first_dlv_riders_cnt
     , retention_riders_cnt
     , return_riders_cnt
     , churn_riders_cnt
     , retire_riders_cnt
     , new_join_riders_cnt
     , new_dlv_available_riders_cnt
     , dlv_available_conv_rate
     , first_dlv_conv_rate
     , active_riders_cnt
     , dlv_avaiable_riders_cnt
     , total_riders_cnt
     , active_riders_ratio
     , dlv_available_riders_ratio
     , total_return_rate
     , churn_1w_return_rate
     , churn_2w_return_rate
     , churn_rate
     , ai_main_riders_cnt
     , ai_main_riders_ratio

     , c.single_bundle_accept_cnt
     , c.single_reject_cnt
     , c.bundle_reject_cnt
     , c.ai_acceptance_rate

    --  , d.total_idle_time_rate
    --  , d.ai_idle_time_rate
    --  , d.normal_idle_time_rate
    --  , d.total_work_time
    --  , d.avg_work_time
    --  , d.avg_dlv_time
    --  , d.utr_with_idle_time
    --  , d.pay_per_hour_with_idle_time
    --  , d.unpaid_moving_time_ratio
    --  , d.avg_work_time_rate
    --  , d.avg_work_time_rate_wo_non_workdays

    --  , e.avg_work_freq
    --  , e.avg_work_days_cnt

     , f.total_dlv_cnt
     , f.total_voc_cnt
     , f.total_cpd_pct
     , f.baera_dlv_cnt
     , f.baera_voc_cnt
     , f.baera_cpd_pct
     , f.market_dlv_cnt
     , f.market_voc_cnt
     , f.market_cpd_pct
     , f.store_dlv_cnt
     , f.store_voc_cnt
     , f.store_cpd_pct
FROM (
    SELECT DISTINCT base_week as week
         , rider_delivery_method as delivery_method
         , rgn
    FROM dlv

    union all

    SELECT DISTINCT base_week as week
         , 'ALL' as delivery_method
         , 'ALL' as rgn
    FROM dlv
) a
LEFT JOIN ch1_rider_basic b
    ON a.week = b.week
    AND a.delivery_method = b.delivery_method
LEFT JOIN ch1_ai_acceptance c
    ON a.week = c.week
    AND a.delivery_method = c.rider_delivery_method
-- LEFT JOIN ch2_worktime1 d
--     ON a.week = d.week
--     AND a.delivery_method = d.delivery_method
-- LEFT JOIN ch2_worktime2 e
--     ON a.week = cast(e.week as varchar)
--     AND a.delivery_method = e.delivery_method
LEFT JOIN ch3_cpd1 f
    ON a.week = f.week
    AND a.rgn = f.rgn
WHERE 1=1
AND a.week >>= format_datetime(date_trunc('week', current_timestamp) - interval '84' day, 'yyyy-MM-dd')
AND a.week << format_datetime(date_trunc('week', current_timestamp) - interval '0' day, 'yyyy-MM-dd')
ORDER BY week DESC, delivery_method]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
    <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='athena.1gpivur05bqw5e1bagvha1e1xh8o' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[WITH

riders as ( -- 라이더 계정정보
    SELECT a.id as rider_id
         , b.rider_id as rider_no
         , a.delivery_method
         , b.join_channel
         , a.account_status
         , format_datetime(a.join_date AT TIME ZONE 'Asia/Seoul', 'yyyy-MM-dd') as join_date_org -- brms 스키마 데이터는 UTC ->> KST 변경 필요
         , format_datetime(a.first_available_delivery_date AT TIME ZONE 'Asia/Seoul', 'yyyy-MM-dd') as first_available_delivery_date_org
         , format_datetime(date_parse(a.business_start_day, '%Y%m%d'), 'yyyy-MM-dd') as business_start_date_org
         
         , format_datetime(date_trunc('week', a.join_date AT TIME ZONE 'Asia/Seoul'), 'yyyy-MM-dd') as join_date -- brms 스키마 데이터는 UTC ->> KST 변경 필요
         , format_datetime(date_trunc('week', a.first_available_delivery_date AT TIME ZONE 'Asia/Seoul'), 'yyyy-MM-dd') as first_available_delivery_date
         , format_datetime(date_trunc('week', date_parse(a.business_start_day, '%Y%m%d')), 'yyyy-MM-dd') as business_start_date
         , format_datetime(date_trunc('week', a.retire_date AT TIME ZONE 'Asia/Seoul'), 'yyyy-MM-dd') as retire_date
    FROM brms.rider_account a
    LEFT JOIN sbtasty.rider_account b
    ON a.id = b.brms_rider_id
    WHERE 1=1
    AND a.agency_id <<>> 13 -- 테스트 데이터 제외
    AND a.tester <<>> 1 -- 테스트 데이터 제외
    AND a.rider_type in ('CROWDSOURCING', 'INDIVIDUAL_OWNER') -- 대상 라이더타입 필터링
),

dlv as ( -- 라이더 배달정보
    SELECT format_datetime(date_trunc('week', date(business_day)), 'yyyy-MM-dd') as base_week
         , rider_no
         , case when regexp_like(coalesce(nm.rgn1_nm, c.rgn1_nm), '서울') then '서울'
                when regexp_like(coalesce(nm.rgn1_nm, c.rgn1_nm), '경기') then '경기'
                when regexp_like(coalesce(nm.rgn1_nm, c.rgn1_nm), '인천') then '인천'
                when coalesce(nm.rgn1_nm, c.rgn1_nm) is not null then '지방' else 'NONE' end as rgn
         , rider_delivery_method
         , case when coalesce(order_service_type, order_type) = 'BERA' then 'BAERA' else coalesce(order_service_type, order_type) end as order_service_type
         , auto_allocated 
         , max(pick_up_date) as last_pick_up_date
         , count(1) as dlv_cnt
    FROM sbtasty.dlvry2 a
    LEFT JOIN sbstore_hist.shop_master rgn
        ON a.shop_no = rgn.shop_no
        AND a.business_day = rgn.part_date
    LEFT JOIN sbbi.dim_rgn_cd nm
        ON rgn.rgn3_cd = nm.rgn3_cd
    LEFT JOIN dsdw.commerce_seller_master c
        ON a.shop_no = c.seller_id
        AND a.order_service_type = 'BAEMIN_STORE'
    WHERE 1=1
    AND agency_id <<>> 13 -- 테스트 데이터 제외
    AND consign_date is not null
    AND pick_up_date is not null
    AND hand_over_date is not null
    AND business_day >>= format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '112' day, 'yyyy-MM-dd')
    AND business_day << format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '0' day, 'yyyy-MM-dd')
    GROUP BY 1, 2, 3, 4, 5, 6
),

base_week as ( -- 기준년월
    SELECT base_week
        , format_datetime(date(base_week) - interval '3' day, 'yyyy-MM-dd') as start_date -- (2주누적)가입완료율 계산을 위해
        , format_datetime(date(base_week) + interval '6' day, 'yyyy-MM-dd') as end_date
        , format_datetime(date(base_week) - interval '7' day, 'yyyy-MM-dd') as w_1_start_date
        , format_datetime(date(base_week) - interval '1' day, 'yyyy-MM-dd') as w_1_end_date
    FROM (
        SELECT distinct base_week
        FROM dlv
    ) a
),

dim_mode as ( -- 주이용배차모드
    SELECT base_week
         , rider_no
         , dlv_cnt
         , ai_dlv_cnt
         , norm_dlv_cnt
         , case when ai_dlv_cnt >>= norm_dlv_cnt then 'AI모드' else '일반모드' end as main_mode
    FROM (
        SELECT base_week
             , rider_no
             , sum(dlv_cnt) as dlv_cnt
             , sum(case when auto_allocated = 1 then dlv_cnt else 0 end) as ai_dlv_cnt
             , sum(case when auto_allocated = 0 then dlv_cnt else 0 end) as norm_dlv_cnt
        FROM dlv
        GROUP BY 1, 2
    ) a
),

dim_svc as ( -- 주이용서비스
    SELECT base_week
         , rider_no
         , order_service_type as main_svc
    FROM (
        SELECT base_week
             , rider_no
             , order_service_type
             , row_number() over (PARTITION BY base_week, rider_no ORDER BY dlv_cnt DESC, last_pick_up_date DESC) as rk
        FROM (
            SELECT base_week
                 , rider_no
                 , order_service_type
                 , max(last_pick_up_date) as last_pick_up_date
                 , sum(dlv_cnt) as dlv_cnt
            FROM dlv
            GROUP BY 1, 2, 3
        ) a
    ) a
    WHERE rk = 1
),

dim_rgn as ( -- 주이용지역
    SELECT base_week
         , rider_no
         , rgn as main_rgn
    FROM (
        SELECT base_week
             , rider_no
             , rgn
             , row_number() over (PARTITION BY base_week, rider_no ORDER BY dlv_cnt DESC, last_pick_up_date DESC) as rk
        FROM (
            SELECT base_week
                 , rider_no
                 , rgn
                 , max(last_pick_up_date) as last_pick_up_date
                 , sum(dlv_cnt) as dlv_cnt
            FROM dlv
            GROUP BY 1, 2, 3
        ) a
    ) a
    WHERE rk = 1
),

dim_method as ( -- 주이용배달수단
    SELECT base_week
         , rider_no
         , rider_delivery_method as main_delivery_method
    FROM (
        SELECT base_week
             , rider_no
             , rider_delivery_method
             , row_number() over (PARTITION BY base_week, rider_no ORDER BY dlv_cnt DESC, last_pick_up_date DESC) as rk
        FROM (
            SELECT base_week
                 , rider_no
                 , rider_delivery_method
                 , max(last_pick_up_date) as last_pick_up_date
                 , sum(dlv_cnt) as dlv_cnt
            FROM dlv
            GROUP BY 1, 2, 3
        ) a
    ) a
    WHERE rk = 1
),

dim as (
    SELECT a.*
         , b.main_svc
         , c.main_rgn
         , d.main_delivery_method
    FROM dim_mode a
    LEFT JOIN dim_svc b
    ON a.base_week = b.base_week
    AND a.rider_no = b.rider_no
    LEFT JOIN dim_rgn c
    ON a.base_week = c.base_week
    AND a.rider_no = c.rider_no
    LEFT JOIN dim_method d
    ON a.base_week = d.base_week
    AND a.rider_no = d.rider_no
),

full_data as ( --월별 라이더별 정보 최종
    SELECT *
         , lag(rlc) over (PARTITION BY rider_id ORDER BY base_week) as lag_rlc
         , lag(rlc, 2) over (PARTITION BY rider_id ORDER BY base_week) as lag2_rlc
         , lag(rlc, 3) over (PARTITION BY rider_id ORDER BY base_week) as lag3_rlc
    FROM (
        SELECT *
             , case when retire_date = base_week then '탈퇴'
                    when retire_date << base_week then '기존탈퇴'
                    when lag_dlv_cnt >> 0 AND dlv_cnt >> 0 then '유지'
                    when business_start_date = base_week then '첫배달수행'
                    when business_start_date << base_week AND dlv_cnt = 0 then '이탈'
                    when lag_dlv_cnt = 0 AND dlv_cnt >> 0 then '복귀'
                    when first_available_delivery_date <<= base_week AND coalesce(business_start_date, '9999-12-31') >> base_week then '첫배달미수행'
                    when join_date <<= base_week AND coalesce(first_available_delivery_date, '9999-12-31') >> base_week then '가입'
                    else '미분류' end as rlc
        FROM (
            SELECT *
                 , lag(dlv_cnt) over (PARTITION BY rider_id ORDER BY base_week) as lag_dlv_cnt
                 , lag(dlv_cnt, 2) over (PARTITION BY rider_id ORDER BY base_week) as lag2_dlv_cnt
            FROM (
                SELECT a.*
                     , b.*
                     , coalesce(c.dlv_cnt, 0) as dlv_cnt
                     , coalesce(c.ai_dlv_cnt, 0) as ai_dlv_cnt
                     , coalesce(c.norm_dlv_cnt, 0) as norm_dlv_cnt
                     , c.main_mode
                     , c.main_svc
                     , c.main_rgn
                     , coalesce(coalesce(main_delivery_method, b.delivery_method), 'NONE') as main_delivery_method
                FROM base_week a
                LEFT JOIN riders b
                ON a.base_week >>= b.join_date
                LEFT JOIN dim c
                ON a.base_week = c.base_week
                AND b.rider_no = c.rider_no
            ) a
        ) a
    ) a
),

ch1_rider_basic as (
    SELECT base_week as week -- "기준년월"
        , coalesce(main_delivery_method, 'ALL') as delivery_method -- "배달수단"

        -- 생애주기 관련 지표

        , sum(case when rlc = '가입' then 1 end) as join_riders_cnt -- "1.가입 라이더 수" 
        , sum(case when rlc = '첫배달미수행' then 1 end) as non_first_dlv_riders_cnt -- "2.첫배달미수행 라이더 수" 
        , sum(case when rlc = '첫배달수행' then 1 end) as first_dlv_riders_cnt -- "3.첫배달수행 라이더 수" 
        , sum(case when rlc = '유지' then 1 end) as retention_riders_cnt -- "4.유지 라이더 수" 
        , sum(case when rlc = '복귀' then 1 end) as return_riders_cnt -- "5.복귀 라이더 수" 
        , sum(case when rlc = '이탈' then -1 end) as churn_riders_cnt -- "6.이탈 라이더 수"
        , sum(case when rlc = '탈퇴' then -1 end) as retire_riders_cnt -- "7.탈퇴 라이더 수"
        
        -- , sum(case when rlc = '미분류' then 1 end) as "미분류 라이더 수"
        
        , sum(case when rlc not in ('탈퇴', '기존탈퇴') AND join_date = base_week then 1 end) as new_join_riders_cnt -- "신규 가입 라이더 수"
        , sum(case when rlc not in ('탈퇴', '기존탈퇴') AND first_available_delivery_date = base_week then 1 end) as new_dlv_available_riders_cnt -- "신규 가입완료 라이더 수"
        -- , 100e0 * sum(case when rlc not in ('탈퇴', '기존탈퇴') AND join_date = base_week AND first_available_delivery_date = base_week then 1 end) / sum(case when rlc not in ('탈퇴', '기존탈퇴') AND join_date = base_week then 1 end) as dlv_available_conv_rate -- "가입완료 전환율" -- 2주누적 가입완료율로 대체
        , 100e0 * sum(case when rlc not in ('탈퇴', '기존탈퇴') AND join_date_org between w_1_start_date and w_1_end_date AND first_available_delivery_date_org between w_1_start_date and end_date then 1 end) / sum(case when rlc not in ('탈퇴', '기존탈퇴') AND join_date_org between w_1_start_date and w_1_end_date then 1 end) as dlv_available_conv_rate -- "(2주누적)가입완료율"
        , 100e0 * sum(case when rlc not in ('탈퇴', '기존탈퇴') AND first_available_delivery_date = base_week AND business_start_date = base_week then 1 end) / sum(case when rlc not in ('탈퇴', '기존탈퇴') AND first_available_delivery_date = base_week then 1 end) as first_dlv_conv_rate -- "첫배달수행 전환율"
        
        , sum(case when rlc in ('첫배달수행', '유지', '복귀') then 1 end) as active_riders_cnt -- "활동 라이더 수"
        , sum(case when rlc in ('첫배달미수행', '첫배달수행', '유지', '복귀', '이탈') then 1 end) as dlv_avaiable_riders_cnt -- "운행가능 라이더 수"
        , sum(case when rlc in ('가입', '첫배달미수행', '첫배달수행', '유지', '복귀', '이탈') then 1 end) as total_riders_cnt -- "전체 라이더 수"
        
        , 100e0 * sum(case when rlc in ('첫배달수행', '유지', '복귀') then 1 end) / sum(case when rlc in ('가입', '첫배달미수행', '첫배달수행', '유지', '복귀', '이탈') then 1 end) as active_riders_ratio -- "활동 라이더 비율"
        , 100e0 * sum(case when rlc in ('첫배달미수행', '첫배달수행', '유지', '복귀', '이탈') then 1 end) / sum(case when rlc in ('가입', '첫배달미수행', '첫배달수행', '유지', '복귀', '이탈') then 1 end) as dlv_available_riders_ratio -- "운행가능 라이더 비율"
        
        , 100e0 * sum(case when lag_rlc = '이탈' AND rlc = '복귀' then 1 end) / sum(case when rlc not in ('탈퇴', '기존탈퇴') AND lag_rlc = '이탈' then 1 end) as total_return_rate -- "전체 복귀율"
        , 100e0 * sum(case when lag2_rlc in ('첫배달수행', '유지', '복귀') AND lag_rlc = '이탈' AND rlc = '복귀' then 1 end) / sum(case when rlc not in ('탈퇴', '기존탈퇴') AND lag2_rlc in ('첫배달수행', '유지', '복귀') AND lag_rlc = '이탈' then 1 end) as churn_1w_return_rate -- "1주이탈 복귀율"
        , 100e0 * sum(case when lag3_rlc in ('첫배달수행', '유지', '복귀') AND lag2_rlc = '이탈' AND lag_rlc = '이탈' AND rlc = '복귀' then 1 end) / sum(case when rlc not in ('탈퇴', '기존탈퇴') AND lag3_rlc in ('첫배달수행', '유지', '복귀') AND lag2_rlc = '이탈' AND lag_rlc = '이탈' then 1 end) as churn_2w_return_rate -- "2이탈 복귀율"
        
        , 100e0 * sum(case when lag_rlc in ('유지', '복귀', '첫배달수행') AND rlc = '이탈' then 1 end) / sum(case when rlc not in ('탈퇴', '기존탈퇴') AND lag_rlc in ('유지', '복귀', '첫배달수행') then 1 end) as churn_rate -- "이탈율"
        
        , sum(case when rlc in ('첫배달수행', '유지', '복귀') AND main_mode = 'AI모드' then 1 end) as ai_main_riders_cnt -- "AI모드 주이용라이더 수"
        , 100e0 * sum(case when rlc in ('첫배달수행', '유지', '복귀') AND main_mode = 'AI모드' then 1 end) / sum(case when rlc in ('첫배달수행', '유지', '복귀') then 1 end) as ai_main_riders_ratio -- "AI모드 주이용라이더 비율"
        
    FROM full_data
    WHERE 1=1
    AND base_week >>= format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '84' day, 'yyyy-MM-dd')
    AND base_week << format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '0' day, 'yyyy-MM-dd')
    AND main_delivery_method <<>> 'NONE'
    GROUP BY 1, rollup(main_delivery_method)
),






-- #####################################################################################
-- 1. 활동 라이더 증가
-- 1-2. 활동라이더 증가-AI수락율
-- https://redash.woowa.in/queries/33208/source
-- #####################################################################################

dlv1 as (
    select format_datetime(date_trunc('week', date(business_day)), 'yyyy-MM-dd') as week, business_day, consign_date, pick_up_date, rider_delivery_method, rider_no
        , lag(consign_date) over (partition by a.business_day, delivery_carry_type, rider_no order by consign_date) as lag_consign_date
        , lead(consign_date) over (partition by a.business_day, delivery_carry_type, rider_no order by consign_date) as lead_consign_date
    from sbtasty.dlvry2 a
    left join sbtasty.rider_account b
    on a.rider_no = b.rider_id
    where a.business_day between format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '84' day, 'yyyy-MM-dd') and format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '1' day, 'yyyy-MM-dd')
        -- and dlvry_status = 'COMPLETED_DELIVERY'
        -- and additional_delivery_detail_id IS NULL
        and agency_name not like '%테스트%'
        and a.agency_id <<>> 13
        -- and recall is null
        -- and order_type ='BERA'
        and consign_date is not null
        and hand_over_date is not null
        and pick_up_date is not null
        and auto_allocated=1 -- AI만 필터링
        and rider_type in ('CROWDSOURCING', 'INDIVIDUAL_OWNER')
),

dlv_method as (
    select week, rider_id, rider_delivery_method
    from(
        select week, rider_id, rider_delivery_method
            , row_number() over (partition by week, rider_id order by cnt desc, last_pick_up_date desc) as ranking
        from(
            select week
                , rider_no as rider_id
                , rider_delivery_method
                , count(1) as cnt
                , max(pick_up_date) as last_pick_up_date
            from dlv1
            group by 1,2,3
        )
    )
    where ranking=1
),

rej as (
    select week
        , part_date
        , bd
        , rider_id
        , rejected_date
        , rejecter
        , reason
        , coalesce(rider_delivery_method, delivery_method) as rider_delivery_method
    from(
        select format_datetime(date_trunc('week', date(part_date)), 'yyyy-MM-dd') as week, *
        from sbtasty.auto_allocate_reject
    )
    left join dlv_method using (week, rider_id)
    left join (
        select rider_id
            , delivery_method
        from sbtasty.rider_account
    ) using (rider_id)
    where part_date between format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '84' day, 'yyyy-MM-dd') and format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '1' day, 'yyyy-MM-dd')
),

rej2 as (
    select *
        , lead(rejected_date) over (partition by bd, rider_id order by rejected_date) as lead_rejected_date
        , lag(rejected_date) over (partition by bd, rider_id order by rejected_date) as lag_rejected_date
    from rej
    where rejecter = 'RIDER' -- SYSTEM 제거 (2023-08-22)
        and reason <<>> '배차 거부'
),

rej3 as (
    select week
        , part_date
        , bd
        , rider_id
        , rider_delivery_method
        , rejected_date
        , lead_rejected_date
        , lag_rejected_date
        , case when date_diff('second', lag_rejected_date, rejected_date) <<= 0 then 0
               when date_diff('second', rejected_date, lead_rejected_date) <<= 0 then 1
               else null end as delta
    from rej2
),

rej4 as (
    select *
        , sum(delta) over (partition by bd, rider_id order by rejected_date) as bundle_key
    from rej3
),

rej5 as (
    select *
        , case when delta is not null then bundle_key end as bundle
    from rej4
),

rej6 as (
    select *
        , count(bundle) over (partition by bd, rider_id, bundle) as cnt_bundle
    from rej5
),

rej7 as (
    select format_datetime(date_trunc('week', date(part_date)), 'yyyy-MM-dd') as week
        , coalesce(rider_delivery_method, 'ALL') as rider_delivery_method
        , sum(case when delta is not null then 1e0/cnt_bundle else 0 end) as cnt_bundle_rej
        , sum(case when delta is null then 1 else 0 end) as cnt_single_rej
    from rej6
    group by 1, rollup(rider_delivery_method)
),

dlv2 as (
    select *
    from(
        select week, business_day, consign_date, lag_consign_date, lead_consign_date
            , rider_no as rider_id
            , case when date_diff('second', lag_consign_date, consign_date) <<= 1 then 0
                   when date_diff('second', consign_date, lead_consign_date) <<= 1 then 1
                   else null end as delta
        from dlv1
    )
    left join dlv_method using (week, rider_id)
),

dlv3 as (
    select *
        , sum(delta) over (partition by business_day, rider_id order by consign_date) as bundle_key
    from dlv2
),

dlv4 as (
    select *
        , case when delta is not null then bundle_key end as bundle
    from dlv3
),

dlv5 as (
    select *
        , count(bundle) over (partition by business_day, rider_id, bundle) as cnt_bundle
    from dlv4
),

dlv6 as (
    select week
        , coalesce(rider_delivery_method, 'ALL') as rider_delivery_method
        , sum(case when cnt_bundle >> 0 then 1e0/cnt_bundle else 1e0 end) as cnt_dlv
    from dlv5
    group by 1, rollup(rider_delivery_method)
),

ch1_ai_acceptance as (
    select week
        , rider_delivery_method
        , cnt_dlv as single_bundle_accept_cnt
        , cnt_single_rej as single_reject_cnt
        , cnt_bundle_rej as bundle_reject_cnt
        , 100e0*cnt_dlv/(cnt_single_rej+cnt_bundle_rej+cnt_dlv) as ai_acceptance_rate -- "AI추천배차 수락율"
    from dlv6
    join rej7 using (week, rider_delivery_method)
),






-- #####################################################################################
-- 3. 라이더 VoC 감소
-- 3-1. CPD-지역별
-- https://redash.woowa.in/queries/33440/source#104044
-- #####################################################################################

cpd_dlv as ( -- 라이더 배달정보
    SELECT format_datetime(date_trunc('week', date(a.business_day)), 'yyyy-MM-dd') as base_week
         , a.rider_no
         , case when regexp_like(coalesce(nm.rgn1_nm, c.rgn1_nm), '서울') then '서울'
                when regexp_like(coalesce(nm.rgn1_nm, c.rgn1_nm), '경기') then '경기'
                when regexp_like(coalesce(nm.rgn1_nm, c.rgn1_nm), '인천') then '인천'
                when coalesce(nm.rgn1_nm, c.rgn1_nm) is not null then '지방' else 'NONE' end as rgn
         , order_service_type
         , count(distinct dlvry_id) as dlv_cnt
         , count(d.id) as voc_cnt
    FROM (
        SELECT dlvry_id
             , ord_no
             , rider_no
             , rider_delivery_method
             , shop_no
             , pick_up_date
             , case when coalesce(order_service_type, order_type) = 'BERA' then 'BAERA' else coalesce(order_service_type, order_type) end as order_service_type
             , business_day
        FROM sbtasty.dlvry2
        WHERE 1=1
        AND agency_id <<>> 13 -- 테스트 데이터 제외
        AND consign_date is not null
        AND pick_up_date is not null
        AND hand_over_date is not null
        AND business_day >>= format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '84' day, 'yyyy-MM-dd')
        AND business_day << format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '0' day, 'yyyy-MM-dd')
    ) a
    INNER JOIN riders r
    ON a.rider_no = r.rider_no
    LEFT JOIN sbstore_hist.shop_master rgn
        ON a.shop_no = rgn.shop_no
        AND a.business_day = rgn.part_date
    LEFT JOIN sbbi.dim_rgn_cd nm
        ON rgn.rgn3_cd = nm.rgn3_cd
    LEFT JOIN dsdw.commerce_seller_master c
        ON a.shop_no = c.seller_id
        AND a.order_service_type = 'BAEMIN_STORE'
    LEFT JOIN (
        SELECT id
             , sn
             , order_id
            --  , case when coalesce(trim(split_part(topic, '→', 1)), '없음') in ('배달 중 이슈', '배달상태 변경') then concat('배달 중 이슈 >> ', coalesce(trim(split_part(topic, '→', 2)), '없음'))
            --         else coalesce(split_part(topic, '→', 1), '없음') end as category
        FROM sbtasty.request_guide_record
        WHERE 1=1
        AND part_date >>= format_datetime(date_trunc('week', current_timestamp) - interval '84' day, 'yyyy-MM-dd')
        AND part_date << format_datetime(date_trunc('week', current_timestamp) - interval '0' day, 'yyyy-MM-dd')
    ) d
        ON split_part(dlvry_id, '_', 2) = d.sn
        AND a.ord_no = d.order_id
    GROUP BY 1, 2, 3, 4
),

cpd_dlvry_all_svc as (
    SELECT base_week
        , coalesce(rgn, 'ALL') as rgn
        , sum(dlv_cnt) as total_dlv_cnt
        , sum(voc_cnt) as total_voc_cnt
        , 100e0 * sum(voc_cnt) / sum(dlv_cnt) as total_cpd_pct
    FROM cpd_dlv
    GROUP BY 1, rollup(rgn)
),

-- 콜 인바운드 추가 (2023.11.08)
call_inbound as (
    -- part_date로 오늘 새벽 데이터가 짤리는 문제 때문에 그 다음주에 다음날 수치변동이 있을 수 있음
    SELECT format_datetime(case when hour(call_dt  AT TIME ZONE 'Asia/Seoul') << 7 then date_trunc('week', call_dt  AT TIME ZONE 'Asia/Seoul' - interval '1' day)
                else date_trunc('week', call_dt  AT TIME ZONE 'Asia/Seoul') end, 'yyyy-MM-dd') as base_week
         , 'ALL' as rgn
         , count(1) as total_call_in_cnt
    FROM cscallcenter.tb_call
    WHERE 1=1
    AND part_date >>= format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') - interval '84' day, 'yyyy-MM-dd')
    AND part_date << format_datetime(date_trunc('week', current_timestamp AT TIME ZONE 'Asia/Seoul') + interval '1' day, 'yyyy-MM-dd')
    AND service_div = 'Srv19' -- 배민커넥트 고객센터
    AND bound_type = 'In' -- 인바운드. 아웃바운드는 Out
    GROUP BY 1
),

cpd_dlvry as (
    SELECT a.base_week
        , a.rgn
         
        , max(case when a.order_service_type = 'BAERA' then dlvry_cnt end) as baera_dlv_cnt
        , max(case when a.order_service_type = 'BAERA' then voc_cnt end) as baera_voc_cnt
        , 100e0 * max(case when a.order_service_type = 'BAERA' then voc_cnt end) / max(case when a.order_service_type = 'BAERA' then dlvry_cnt end) as baera_cpd_pct
         
        , max(case when a.order_service_type = 'MARKET' then dlvry_cnt end) as market_dlv_cnt
        , max(case when a.order_service_type = 'MARKET' then voc_cnt end) as market_voc_cnt
        , 100e0 * max(case when a.order_service_type = 'MARKET' then voc_cnt end) / max(case when a.order_service_type = 'MARKET' then dlvry_cnt end) as market_cpd_pct
         
        , max(case when a.order_service_type = 'BAEMIN_STORE' then dlvry_cnt end) as store_dlv_cnt
        , max(case when a.order_service_type = 'BAEMIN_STORE' then voc_cnt end) as store_voc_cnt
        , 100e0 * max(case when a.order_service_type = 'BAEMIN_STORE' then voc_cnt end) / max(case when a.order_service_type = 'BAEMIN_STORE' then dlvry_cnt end) as store_cpd_pct
    FROM (
        SELECT base_week
             , coalesce(order_service_type, 'ALL') as order_service_type
             , coalesce(rgn, 'ALL') as rgn
             , sum(dlv_cnt) as dlvry_cnt
             , sum(voc_cnt) as voc_cnt
             , count(DISTINCT rider_no) as rider_cnt
             , count(DISTINCT case when voc_cnt >> 0 then rider_no end) as voc_rider_cnt
        FROM cpd_dlv
        GROUP BY 1, rollup(order_service_type), rollup(rgn)
    ) a
    WHERE a.rgn <<>> 'NONE'
    GROUP BY 1, 2
),

ch3_cpd1 as (
    SELECT a.base_week as week -- "기준년월"
         , a.rgn -- as "픽업지역"
         
         , a.total_dlv_cnt -- as "(전체) 배달건수"
         , (a.total_voc_cnt + c.total_call_in_cnt) as total_voc_cnt -- "(전체) voc건수"
        --  , a.total_cpd_pct -- as "(전체) CPD"
         , 100e0* (a.total_voc_cnt + c.total_call_in_cnt) / a.total_dlv_cnt as total_cpd_pct -- "(전체) CPD"
         
         , baera_dlv_cnt -- as "(배민1) 배달건수"
         , baera_voc_cnt -- as "(배민1) voc건수"
         , baera_cpd_pct -- as "(배민1) CPD"
         
         , market_dlv_cnt -- as "(B마트) 배달건수"
         , market_voc_cnt -- as "(B마트) voc건수"
         , market_cpd_pct -- as "(B마트) CPD"
         
         , store_dlv_cnt -- as "(스토어) 배달건수"
         , store_voc_cnt -- as "(스토어) voc건수"
         , store_cpd_pct -- as "(스토어) CPD"
    FROM cpd_dlvry_all_svc a
    LEFT JOIN cpd_dlvry b
    ON a.base_week = b.base_week
    AND a.rgn = b.rgn
    LEFT JOIN call_inbound c
    ON a.base_week = c.base_week
    AND a.rgn = c.rgn
    WHERE 1=1
    AND a.rgn <<>> 'NONE'
)






-- #####################################################################################
-- [FINAL] 최종 결과 취합
-- week | delivery_method | rgn | ...
-- #####################################################################################

SELECT a.week
     , a.delivery_method
     , a.rgn

     , join_riders_cnt
     , non_first_dlv_riders_cnt
     , first_dlv_riders_cnt
     , retention_riders_cnt
     , return_riders_cnt
     , churn_riders_cnt
     , retire_riders_cnt
     , new_join_riders_cnt
     , new_dlv_available_riders_cnt
     , dlv_available_conv_rate
     , first_dlv_conv_rate
     , active_riders_cnt
     , dlv_avaiable_riders_cnt
     , total_riders_cnt
     , active_riders_ratio
     , dlv_available_riders_ratio
     , total_return_rate
     , churn_1w_return_rate
     , churn_2w_return_rate
     , churn_rate
     , ai_main_riders_cnt
     , ai_main_riders_ratio

     , c.single_bundle_accept_cnt
     , c.single_reject_cnt
     , c.bundle_reject_cnt
     , c.ai_acceptance_rate

    --  , d.total_idle_time_rate
    --  , d.ai_idle_time_rate
    --  , d.normal_idle_time_rate
    --  , d.total_work_time
    --  , d.avg_work_time
    --  , d.avg_dlv_time
    --  , d.utr_with_idle_time
    --  , d.pay_per_hour_with_idle_time
    --  , d.unpaid_moving_time_ratio
    --  , d.avg_work_time_rate
    --  , d.avg_work_time_rate_wo_non_workdays

    --  , e.avg_work_freq
    --  , e.avg_work_days_cnt

     , f.total_dlv_cnt
     , f.total_voc_cnt
     , f.total_cpd_pct
     , f.baera_dlv_cnt
     , f.baera_voc_cnt
     , f.baera_cpd_pct
     , f.market_dlv_cnt
     , f.market_voc_cnt
     , f.market_cpd_pct
     , f.store_dlv_cnt
     , f.store_voc_cnt
     , f.store_cpd_pct
FROM (
    SELECT DISTINCT base_week as week
         , rider_delivery_method as delivery_method
         , rgn
    FROM dlv

    union all

    SELECT DISTINCT base_week as week
         , 'ALL' as delivery_method
         , 'ALL' as rgn
    FROM dlv
) a
LEFT JOIN ch1_rider_basic b
    ON a.week = b.week
    AND a.delivery_method = b.delivery_method
LEFT JOIN ch1_ai_acceptance c
    ON a.week = c.week
    AND a.delivery_method = c.rider_delivery_method
-- LEFT JOIN ch2_worktime1 d
--     ON a.week = d.week
--     AND a.delivery_method = d.delivery_method
-- LEFT JOIN ch2_worktime2 e
--     ON a.week = cast(e.week as varchar)
--     AND a.delivery_method = e.delivery_method
LEFT JOIN ch3_cpd1 f
    ON a.week = f.week
    AND a.rgn = f.rgn
WHERE 1=1
AND a.week >>= format_datetime(date_trunc('week', current_timestamp) - interval '84' day, 'yyyy-MM-dd')
AND a.week << format_datetime(date_trunc('week', current_timestamp) - interval '0' day, 'yyyy-MM-dd')
ORDER BY week DESC, delivery_method]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
