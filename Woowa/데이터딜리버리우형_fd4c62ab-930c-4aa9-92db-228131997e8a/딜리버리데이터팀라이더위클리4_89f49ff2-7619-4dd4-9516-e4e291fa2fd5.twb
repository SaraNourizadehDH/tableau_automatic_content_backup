      <metadata-record class='column'>
        <remote-name>total_cpd_pct</remote-name>
        <remote-type>5</remote-type>
        <local-name>[total_cpd_pct]</local-name>
        <parent-name>[사용자 지정 SQL 쿼리]</parent-name>
