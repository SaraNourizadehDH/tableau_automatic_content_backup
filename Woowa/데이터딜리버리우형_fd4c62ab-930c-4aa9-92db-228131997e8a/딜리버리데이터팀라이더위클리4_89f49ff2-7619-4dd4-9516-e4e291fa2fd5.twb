  <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
  <semantic-values>
    <semantic-value key='[Country].[Name]' value='&quot;대한민국&quot;' />
  </semantic-values>
  <object-graph>
    <objects>
      <object caption='사용자 지정 SQL 쿼리' id='_60BDBEA431D0451195F1FE63B5A99BC9'>
        <properties context=''>
          <relation connection='athena.0pjqpi91bsvq831ebryw80g6uceq' name='사용자 지정 SQL 쿼리' type='text'>-- #####################################################################################&#10;-- 3. 라이더 VoC 감소&#10;-- 3-1. CPD-지역별&#10;-- https://redash.woowa.in/queries/33440/source#104044&#10;-- #####################################################################################&#10;&#10;with&#10;&#10;riders as ( -- 라이더 계정정보&#10;    SELECT a.id as rider_id&#10;         , b.rider_id as rider_no&#10;         , a.delivery_method&#10;         , b.join_channel&#10;         , a.account_status&#10;         , format_datetime(a.join_date AT TIME ZONE &apos;Asia/Seoul&apos;, &apos;yyyy-MM-dd&apos;) as join_date_org -- brms 스키마 데이터는 UTC -&gt;&gt; KST 변경 필요&#10;         , format_datetime(a.first_available_delivery_date AT TIME ZONE &apos;Asia/Seoul&apos;, &apos;yyyy-MM-dd&apos;) as first_available_delivery_date_org&#10;         , format_datetime(date_parse(a.business_start_day, &apos;%Y%m%d&apos;), &apos;yyyy-MM-dd&apos;) as business_start_date_org&#10;         &#10;         , format_datetime(date_trunc(&apos;week&apos;, a.join_date AT TIME ZONE &apos;Asia/Seoul&apos;), &apos;yyyy-MM-dd&apos;) as join_date -- brms 스키마 데이터는 UTC -&gt;&gt; KST 변경 필요&#10;         , format_datetime(date_trunc(&apos;week&apos;, a.first_available_delivery_date AT TIME ZONE &apos;Asia/Seoul&apos;), &apos;yyyy-MM-dd&apos;) as first_available_delivery_date&#10;         , format_datetime(date_trunc(&apos;week&apos;, date_parse(a.business_start_day, &apos;%Y%m%d&apos;)), &apos;yyyy-MM-dd&apos;) as business_start_date&#10;         , format_datetime(date_trunc(&apos;week&apos;, a.retire_date AT TIME ZONE &apos;Asia/Seoul&apos;), &apos;yyyy-MM-dd&apos;) as retire_date&#10;    FROM brms.rider_account a&#10;    LEFT JOIN sbtasty.rider_account b&#10;    ON a.id = b.brms_rider_id&#10;    WHERE 1=1&#10;    AND a.agency_id &lt;&lt;&gt;&gt; 13 -- 테스트 데이터 제외&#10;    AND a.tester &lt;&lt;&gt;&gt; 1 -- 테스트 데이터 제외&#10;    AND a.rider_type in (&apos;CROWDSOURCING&apos;, &apos;INDIVIDUAL_OWNER&apos;) -- 대상 라이더타입 필터링&#10;),&#10;&#10;cpd_dlv as ( -- 라이더 배달정보&#10;    SELECT format_datetime(date_trunc(&apos;week&apos;, date(a.business_day)), &apos;yyyy-MM-dd&apos;) as base_week&#10;         , a.rider_no&#10;         , order_service_type&#10;         , count(distinct dlvry_id) as dlv_cnt&#10;         , count(d.id) as voc_cnt&#10;    FROM (&#10;        SELECT dlvry_id&#10;             , ord_no&#10;             , rider_no&#10;             , rider_delivery_method&#10;             , shop_no&#10;             , pick_up_date&#10;             , case when coalesce(order_service_type, order_type) = &apos;BERA&apos; then &apos;BAERA&apos; else coalesce(order_service_type, order_type) end as order_service_type&#10;             , business_day&#10;        FROM sbtasty.dlvry2&#10;        WHERE 1=1&#10;        and agency_name not like &apos;%테스트%&apos;&#10;        AND agency_id &lt;&lt;&gt;&gt; 13 -- 테스트 데이터 제외&#10;        AND consign_date &lt;&lt;= arrived_shop_date&#10;        AND business_day &gt;&gt;= format_datetime(date_trunc(&apos;week&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;84&apos; day, &apos;yyyy-MM-dd&apos;)&#10;        AND business_day &lt;&lt; format_datetime(date_trunc(&apos;week&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;0&apos; day, &apos;yyyy-MM-dd&apos;)&#10;    ) a&#10;    INNER JOIN riders r&#10;    ON a.rider_no = r.rider_no&#10;    LEFT JOIN (&#10;        SELECT id&#10;             , sn&#10;             , order_id&#10;            --  , case when coalesce(trim(split_part(topic, &apos;→&apos;, 1)), &apos;없음&apos;) in (&apos;배달 중 이슈&apos;, &apos;배달상태 변경&apos;) then concat(&apos;배달 중 이슈 &gt;&gt; &apos;, coalesce(trim(split_part(topic, &apos;→&apos;, 2)), &apos;없음&apos;))&#10;            --         else coalesce(split_part(topic, &apos;→&apos;, 1), &apos;없음&apos;) end as category&#10;        FROM sbtasty.request_guide_record&#10;        WHERE 1=1&#10;        AND part_date &gt;&gt;= format_datetime(date_trunc(&apos;week&apos;, current_timestamp) - interval &apos;84&apos; day, &apos;yyyy-MM-dd&apos;)&#10;        AND part_date &lt;&lt; format_datetime(date_trunc(&apos;week&apos;, current_timestamp) - interval &apos;0&apos; day, &apos;yyyy-MM-dd&apos;)&#10;    ) d&#10;        ON split_part(dlvry_id, &apos;_&apos;, 2) = d.sn&#10;        AND a.ord_no = d.order_id&#10;    GROUP BY 1, 2, 3&#10;),&#10;&#10;cpd_dlvry_all_svc as (&#10;    SELECT base_week as week&#10;        , sum(dlv_cnt) as total_dlv_cnt&#10;        , sum(voc_cnt) as total_voc_cnt&#10;        , 100e0 * sum(voc_cnt) / sum(dlv_cnt) as total_cpd_pct&#10;    FROM cpd_dlv&#10;    GROUP BY 1&#10;),&#10;&#10;-- 콜 인바운드 추가 (2023.11.08)&#10;call_inbound as (&#10;    -- part_date로 오늘 새벽 데이터가 짤리는 문제 때문에 그 다음주에 다음날 수치변동이 있을 수 있음&#10;    SELECT format_datetime(case when hour(call_dt  AT TIME ZONE &apos;Asia/Seoul&apos;) &lt;&lt; 7 then date_trunc(&apos;week&apos;, call_dt  AT TIME ZONE &apos;Asia/Seoul&apos; - interval &apos;1&apos; day)&#10;                else date_trunc(&apos;week&apos;, call_dt  AT TIME ZONE &apos;Asia/Seoul&apos;) end, &apos;yyyy-MM-dd&apos;) as week&#10;         , count(1) as total_call_in_cnt&#10;    FROM cscallcenter.tb_call&#10;    WHERE 1=1&#10;    AND part_date &gt;&gt;= format_datetime(date_trunc(&apos;week&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;84&apos; day, &apos;yyyy-MM-dd&apos;)&#10;    AND part_date &lt;&lt; format_datetime(date_trunc(&apos;week&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) + interval &apos;1&apos; day, &apos;yyyy-MM-dd&apos;)&#10;    AND service_div = &apos;Srv19&apos; -- 배민커넥트 고객센터&#10;    AND bound_type = &apos;In&apos; -- 인바운드. 아웃바운드는 Out&#10;    GROUP BY 1&#10;),&#10;&#10;cpd_dlvry as (&#10;    SELECT a.base_week as week&#10;        , max(case when a.order_service_type = &apos;BAERA&apos; then dlvry_cnt end) as baera_dlv_cnt&#10;        , max(case when a.order_service_type = &apos;BAERA&apos; then voc_cnt end) as baera_voc_cnt&#10;        , 100e0 * max(case when a.order_service_type = &apos;BAERA&apos; then voc_cnt end) / max(case when a.order_service_type = &apos;BAERA&apos; then dlvry_cnt end) as baera_cpd_pct&#10;         &#10;        , max(case when a.order_service_type = &apos;MARKET&apos; then dlvry_cnt end) as market_dlv_cnt&#10;        , max(case when a.order_service_type = &apos;MARKET&apos; then voc_cnt end) as market_voc_cnt&#10;        , 100e0 * max(case when a.order_service_type = &apos;MARKET&apos; then voc_cnt end) / max(case when a.order_service_type = &apos;MARKET&apos; then dlvry_cnt end) as market_cpd_pct&#10;         &#10;        , max(case when a.order_service_type = &apos;BAEMIN_STORE&apos; then dlvry_cnt end) as store_dlv_cnt&#10;        , max(case when a.order_service_type = &apos;BAEMIN_STORE&apos; then voc_cnt end) as store_voc_cnt&#10;        , 100e0 * max(case when a.order_service_type = &apos;BAEMIN_STORE&apos; then voc_cnt end) / max(case when a.order_service_type = &apos;BAEMIN_STORE&apos; then dlvry_cnt end) as store_cpd_pct&#10;    FROM (&#10;        SELECT base_week&#10;             , coalesce(order_service_type, &apos;ALL&apos;) as order_service_type&#10;             , sum(dlv_cnt) as dlvry_cnt&#10;             , sum(voc_cnt) as voc_cnt&#10;             , count(DISTINCT rider_no) as rider_cnt&#10;             , count(DISTINCT case when voc_cnt &gt;&gt; 0 then rider_no end) as voc_rider_cnt&#10;        FROM cpd_dlv&#10;        GROUP BY 1, rollup(order_service_type)&#10;    ) a&#10;    GROUP BY 1&#10;)&#10;&#10;SELECT a.week -- &quot;기준년월&quot;&#10;     , (a.total_voc_cnt + c.total_call_in_cnt) as total_voc_cnt -- &quot;(전체) voc건수&quot; -- 콜포함&#10;     , 100e0* (a.total_voc_cnt + c.total_call_in_cnt) / a.total_dlv_cnt as total_cpd_pct -- &quot;(전체) CPD&quot; -- 콜포함&#10;     , baera_cpd_pct -- as &quot;(배민1) CPD&quot;&#10;     , market_cpd_pct -- as &quot;(B마트) CPD&quot;&#10;     , store_cpd_pct -- as &quot;(스토어) CPD&quot;&#10;FROM cpd_dlvry_all_svc a&#10;LEFT JOIN cpd_dlvry b&#10;ON a.week = b.week&#10;LEFT JOIN call_inbound c&#10;ON a.week = c.week&#10;WHERE 1=1&#10;AND a.week &gt;&gt;= format_datetime(date_trunc(&apos;week&apos;, current_timestamp) - interval &apos;84&apos; day, &apos;yyyy-MM-dd&apos;)&#10;AND a.week &lt;&lt; format_datetime(date_trunc(&apos;week&apos;, current_timestamp) - interval &apos;0&apos; day, &apos;yyyy-MM-dd&apos;)&#10;ORDER BY week DESC</relation>
        </properties>
        <properties context='extract'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </properties>
      </object>
    </objects>
  </object-graph>
</datasource>
