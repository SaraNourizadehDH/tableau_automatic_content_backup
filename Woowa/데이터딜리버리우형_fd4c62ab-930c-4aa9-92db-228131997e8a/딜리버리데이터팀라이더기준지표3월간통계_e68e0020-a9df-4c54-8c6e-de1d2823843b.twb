  <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
  <semantic-values>
    <semantic-value key='[Country].[Name]' value='&quot;대한민국&quot;' />
  </semantic-values>
  <object-graph>
    <objects>
      <object caption='사용자 지정 SQL 쿼리' id='_608FEA4C6FC34D1BA1A3CF7473037BF8'>
        <properties context=''>
          <relation connection='athena.01u9l2h17x2t331ddnovz10t0d8j' name='사용자 지정 SQL 쿼리' type='text'>/* [FINAL] 최종 데이터 형태 ::&#10;&#10;month | voc_category | ...&#10;&#10;VOC유형(voc_category)이 많아서 별도 데이터로 분리하였음&#10;-- 쿼리1 라이더수+VOC : https://redash.woowa.in/queries/33627/source&#10;-- 쿼리2 운행시간 : https://redash.woowa.in/queries/33630/source&#10;-- 쿼리3 VOC카테고리 : https://redash.woowa.in/queries/33629/source&#10;&#10;*/&#10;&#10;&#10;WITH&#10;&#10;-- #####################################################################################&#10;-- 3. 라이더 VoC 감소&#10;-- 3-2. VoC유형별분포&#10;-- https://redash.woowa.in/queries/32956/source#101589&#10;-- #####################################################################################&#10;&#10;&#10;&#10;riders as ( -- 라이더 계정정보&#10;    SELECT a.id as rider_id&#10;         , b.rider_id as rider_no&#10;         , a.delivery_method&#10;         , b.join_channel&#10;         , a.account_status&#10;         , format_datetime(date_trunc(&apos;month&apos;, a.join_date AT TIME ZONE &apos;Asia/Seoul&apos;), &apos;yyyy-MM-dd&apos;) as join_date -- brms 스키마 데이터는 UTC -&gt;&gt; KST 변경 필요&#10;         , format_datetime(date_trunc(&apos;month&apos;, a.first_available_delivery_date AT TIME ZONE &apos;Asia/Seoul&apos;), &apos;yyyy-MM-dd&apos;) as first_available_delivery_date&#10;         , format_datetime(date_trunc(&apos;month&apos;, date_parse(a.business_start_day, &apos;%Y%m%d&apos;)), &apos;yyyy-MM-dd&apos;) as business_start_date&#10;         , format_datetime(date_trunc(&apos;month&apos;, a.retire_date AT TIME ZONE &apos;Asia/Seoul&apos;), &apos;yyyy-MM-dd&apos;) as retire_date&#10;    FROM brms.rider_account a&#10;    LEFT JOIN sbtasty.rider_account b&#10;    ON a.id = b.brms_rider_id&#10;    WHERE 1=1&#10;    AND a.agency_id &lt;&lt;&gt;&gt; 13 -- 테스트 데이터 제외&#10;    AND a.tester &lt;&lt;&gt;&gt; 1 -- 테스트 데이터 제외&#10;    AND a.rider_type in (&apos;CROWDSOURCING&apos;, &apos;INDIVIDUAL_OWNER&apos;) -- 대상 라이더타입 필터링&#10;),&#10;&#10;cpd_voc as ( -- 라이더 배달정보&#10;    SELECT format_datetime(date_trunc(&apos;month&apos;, date(a.business_day)), &apos;yyyy-MM-dd&apos;) as base_month&#10;         , order_service_type&#10;         , category&#10;         , count(1) as voc_cnt&#10;    FROM (&#10;        SELECT dlvry_id&#10;             , ord_no&#10;             , rider_no&#10;             , rider_delivery_method&#10;             , shop_no&#10;             , pick_up_date&#10;             , case when coalesce(order_service_type, order_type) = &apos;BERA&apos; then &apos;BAERA&apos; else coalesce(order_service_type, order_type) end as order_service_type&#10;             , business_day&#10;        FROM sbtasty.dlvry2&#10;        WHERE 1=1&#10;        AND agency_id &lt;&lt;&gt;&gt; 13 -- 테스트 데이터 제외&#10;        AND consign_date is not null&#10;        AND pick_up_date is not null&#10;        AND hand_over_date is not null&#10;        AND business_day &gt;&gt;= format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;12&apos; month, &apos;yyyy-MM-dd&apos;)&#10;        AND business_day &lt;&lt; format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;0&apos; month, &apos;yyyy-MM-dd&apos;)&#10;    ) a&#10;    INNER JOIN riders r&#10;    ON a.rider_no = r.rider_no&#10;    LEFT JOIN sbstore_hist.shop_master rgn&#10;        ON a.shop_no = rgn.shop_no&#10;        AND a.business_day = rgn.part_date&#10;    LEFT JOIN sbbi.dim_rgn_cd nm&#10;        ON rgn.rgn3_cd = nm.rgn3_cd&#10;    LEFT JOIN dsdw.commerce_seller_master c&#10;        ON a.shop_no = c.seller_id&#10;        AND a.order_service_type = &apos;BAEMIN_STORE&apos;&#10;    INNER JOIN (&#10;        SELECT id&#10;             , sn&#10;             , order_id&#10;             , case when coalesce(trim(split_part(topic, &apos;→&apos;, 1)), &apos;없음&apos;) in (&apos;배달 중 이슈&apos;, &apos;배달상태 변경&apos;) then concat(&apos;배달 중 이슈 &gt;&gt; &apos;, coalesce(trim(split_part(topic, &apos;→&apos;, 2)), &apos;없음&apos;))&#10;                    else coalesce(split_part(topic, &apos;→&apos;, 1), &apos;없음&apos;) end as category&#10;        FROM sbtasty.request_guide_record&#10;        WHERE 1=1&#10;        AND part_date &gt;&gt;= format_datetime(date_trunc(&apos;month&apos;, current_timestamp) - interval &apos;12&apos; month, &apos;yyyy-MM-dd&apos;)&#10;        AND part_date &lt;&lt; format_datetime(date_trunc(&apos;month&apos;, current_timestamp) - interval &apos;0&apos; month, &apos;yyyy-MM-dd&apos;)&#10;    ) d&#10;        ON split_part(dlvry_id, &apos;_&apos;, 2) = d.sn&#10;        AND a.ord_no = d.order_id&#10;    GROUP BY 1, 2, 3&#10;)&#10;&#10;SELECT base_month as month -- &quot;기준년월&quot;&#10;    , category as voc_category -- &quot;분류&quot;&#10;    , sum(voc_cnt) as total_voc_cnt -- &quot;voc건수&quot;&#10;    , max(case when order_service_type =&apos;BAERA&apos; then voc_cnt end) as baera_voc_cnt -- &quot;배민1_voc건수&quot;&#10;    , max(case when order_service_type =&apos;MARKET&apos; then voc_cnt end) as market_voc_cnt -- &quot;B마트_voc건수&quot;&#10;    , max(case when order_service_type =&apos;BAEMIN_STORE&apos; then voc_cnt end) as store_voc_cnt -- &quot;배민스토어_voc건수&quot;&#10;FROM cpd_voc&#10;WHERE 1=1&#10;-- AND category &lt;&lt;&gt;&gt; &apos;없음&apos;&#10;GROUP BY 1, 2&#10;ORDER BY month DESC, voc_category</relation>
        </properties>
        <properties context='extract'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </properties>
      </object>
    </objects>
  </object-graph>
</datasource>
