  <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
  <semantic-values>
    <semantic-value key='[Country].[Name]' value='&quot;대한민국&quot;' />
  </semantic-values>
  <object-graph>
    <objects>
      <object caption='사용자 지정 SQL 쿼리' id='_DCA010B6EA984E03B3E8755D6760B3B0'>
        <properties context=''>
          <relation connection='athena.12rg2471h55vi91bajryv0hucp80' name='사용자 지정 SQL 쿼리' type='text'>/* [FINAL] 최종 데이터 형태 ::&#10;&#10;month | delivery_method | rgn | ...&#10;&#10;메모리 이슈 때문에 쿼리1과 형태는 같지만 분리하였음&#10;-- 쿼리1 라이더수+VOC : https://redash.woowa.in/queries/33627/source&#10;-- 쿼리2 운행시간 : https://redash.woowa.in/queries/33630/source&#10;-- 쿼리3 VOC카테고리 : https://redash.woowa.in/queries/33629/source&#10;&#10;*/&#10;&#10;&#10;WITH&#10;&#10;-- #####################################################################################&#10;-- 2. 활동 라이더의 운행시간 증가&#10;-- 2-1. 활동라이더의 운행시간 증가1-배달수단별&#10;-- https://redash.woowa.in/queries/29995/source#101863&#10;-- #####################################################################################&#10;&#10;dlv_method as (&#10;    select month, rider_id, rider_delivery_method&#10;    from(&#10;        select month, rider_id, rider_delivery_method&#10;            , row_number() over (partition by month, rider_id order by cnt desc, last_pick_up_date desc) as ranking&#10;        from(&#10;            select substr(business_day, 1, 8)||&apos;01&apos; as month&#10;                , rider_no as rider_id&#10;                , rider_delivery_method&#10;                , count(1) as cnt&#10;                , max(pick_up_date) as last_pick_up_date&#10;            from sbtasty.dlvry2&#10;            where business_day between format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;12&apos; month, &apos;yyyy-MM-dd&apos;) and format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;1&apos; day, &apos;yyyy-MM-dd&apos;)&#10;                and agency_name not like &apos;%테스트%&apos;&#10;                and agency_id &lt;&lt;&gt;&gt; 13&#10;                -- and recall is null&#10;                and hand_over_date is not NULL &#10;                and consign_date is not NULL&#10;                and pick_up_date is not NULL&#10;            group by 1,2,3&#10;        )&#10;    )&#10;    where ranking=1&#10;),&#10;&#10;main_agency as (&#10;    select month, rider_id, operation_time&#10;    from (&#10;        select month, rider_id&#10;            , date_diff(&apos;second&apos;,start_date,end_date)/60e0 as operation_time&#10;            , row_number() over (partition by month, rider_id order by cnt desc, last_pick_up_date desc) as ranking&#10;        from (&#10;            select substr(business_day, 1, 8)||&apos;01&apos; as month&#10;                , rider_no as rider_id&#10;                , agency_id&#10;                -- , agency_name&#10;                , count(1) as cnt&#10;                , max(pick_up_date) as last_pick_up_date&#10;            from sbtasty.dlvry2&#10;            where business_day between format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;12&apos; month, &apos;yyyy-MM-dd&apos;) and format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;1&apos; day, &apos;yyyy-MM-dd&apos;)&#10;                and agency_name not like &apos;%테스트%&apos;&#10;                and agency_id &lt;&lt;&gt;&gt; 13&#10;                -- and recall is null&#10;                and hand_over_date is not NULL &#10;                and consign_date is not NULL&#10;                and pick_up_date is not NULL&#10;            group by 1,2,3&#10;        )&#10;        left join (&#10;            select substr(date_cd, 1, 8)||&apos;01&apos; as month&#10;                , agency_id&#10;                , start_date&#10;                , end_date&#10;            from sbtasty.agency_operation_daily&#10;        ) using (month, agency_id)&#10;    )&#10;    where ranking=1&#10;),&#10;&#10;dlv as (&#10;  select substr(business_day, 1, 8)||&apos;01&apos; as month&#10;    , business_day as part_date&#10;    , consign_date&#10;    , pick_up_date&#10;    , hand_over_date&#10;    , rider_no as rider_id&#10;    -- , order_service_type&#10;    -- , delivery_carry_type&#10;    , auto_allocated&#10;    , rider_dlvry_fee&#10;    -- , coalesce(coalesce(c.rider_delivery_method, a.rider_delivery_method), b.delivery_method) as rider_delivery_method&#10;    , c.rider_delivery_method&#10;  from sbtasty.dlvry2 a&#10;  left join sbtasty.rider_account b&#10;    on a.rider_no = b.rider_id&#10;  left join dlv_method c&#10;    on a.rider_no = c.rider_id&#10;    and substr(business_day, 1, 8)||&apos;01&apos; = c.month&#10;  where business_day between format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;12&apos; month, &apos;yyyy-MM-dd&apos;) and format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;1&apos; day, &apos;yyyy-MM-dd&apos;)&#10;    and a.agency_name not like &apos;%테스트%&apos;&#10;    and a.agency_id &lt;&lt;&gt;&gt; 13&#10;    -- and recall is null&#10;    and hand_over_date is not NULL &#10;    and consign_date is not NULL&#10;    and pick_up_date is not NULL&#10;    and rider_type in (&apos;CROWDSOURCING&apos;, &apos;INDIVIDUAL_OWNER&apos;)&#10;),&#10;&#10;dlv_days as (&#10;    select month, rider_id, active_days&#10;        , date_diff(&apos;day&apos;, date(month), last_day_of_month(date(month)))+1 as total_days&#10;    from (&#10;        select month&#10;            , rider_id&#10;            , count(distinct part_date) as active_days&#10;        from dlv&#10;        group by 1,2&#10;    )&#10;),&#10;&#10;dim as (&#10;    select month, rider_id, rider_delivery_method&#10;        , operation_time*active_days as active_time&#10;        , operation_time*total_days as total_time&#10;    from dlv_days&#10;    left join dlv_method using (month, rider_id)&#10;    left join main_agency using (month, rider_id)&#10;),&#10;&#10;bds as (&#10;    select month&#10;        , part_date&#10;        , action_date&#10;        , rider_id&#10;        , action&#10;        , auto_allocated&#10;        , rider_delivery_method&#10;    from(&#10;        select substr(part_date, 1, 8)||&apos;01&apos; as month&#10;            , part_date&#10;            , action_date + interval &apos;9&apos; hour as action_date&#10;            , rider_id&#10;            , rider_status as action&#10;            , 2 as auto_allocated&#10;            -- , coalesce(rider_delivery_method, delivery_method) as rider_delivery_method&#10;        from bds.rider_working_log&#10;        where part_date between format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;12&apos; month, &apos;yyyy-MM-dd&apos;) and format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;1&apos; day, &apos;yyyy-MM-dd&apos;)&#10;            -- and not(format_datetime(action_date + interval &apos;9&apos; hour, &apos;yyyy-MM-dd&apos;) &gt;&gt; part_date and hour(action_date + interval &apos;9&apos; hour) between 2 and 8)&#10;            and not(format_datetime(action_date + interval &apos;9&apos; hour, &apos;yyyy-MM-dd&apos;) &gt;&gt; part_date and hour(action_date + interval &apos;9&apos; hour) between 5 and 7)&#10;    )&#10;    join dim using (month, rider_id)&#10;    &#10;),&#10;&#10;auto as (&#10;    select month&#10;        , part_date&#10;        , action_date&#10;        , rider_id&#10;        , action&#10;        , auto_allocated&#10;        , rider_delivery_method&#10;    from(&#10;        select substr(part_date, 1, 8)||&apos;01&apos; as month&#10;            , part_date&#10;            , created_date as action_date&#10;            , rider_id&#10;            , auto_allocate_status as action&#10;            , case when auto_allocate_status in (&apos;AUTOALLOCATEUSEOFF&apos;) then 0&#10;                   when auto_allocate_status in (&apos;AUTOALLOCATEUSEON&apos;, &apos;AUTOALLOCATEON&apos;, &apos;AUTOALLOCATEOFF&apos;) then 1 end as auto_allocated&#10;        from sbtasty.auto_allocate_status_history&#10;        where part_date between format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;12&apos; month, &apos;yyyy-MM-dd&apos;) and format_datetime(date_trunc(&apos;month&apos;, current_timestamp AT TIME ZONE &apos;Asia/Seoul&apos;) - interval &apos;1&apos; day, &apos;yyyy-MM-dd&apos;)&#10;            -- and not(hour(created_date) between 2 and 8)&#10;            and not(hour(created_date) between 5 and 7)&#10;    )&#10;    join dim using (month, rider_id)&#10;),&#10;&#10;base as (&#10;  select month&#10;    , part_date&#10;    , action_date&#10;    , rider_id&#10;    , action&#10;    , auto_allocated&#10;    , null as rider_dlvry_fee&#10;    , rider_delivery_method&#10;  from bds&#10;  UNION ALL&#10;  select month&#10;    , part_date&#10;    , action_date&#10;    , rider_id&#10;    , action&#10;    , auto_allocated&#10;    , null as rider_dlvry_fee&#10;    , rider_delivery_method&#10;  from auto&#10;  UNION ALL&#10;  select month&#10;    , part_date&#10;    , consign_date as action_date&#10;    , rider_id&#10;    , &apos;consign&apos; as action&#10;    , auto_allocated&#10;    , null as rider_dlvry_fee&#10;    , rider_delivery_method&#10;  from dlv&#10;  UNION ALL&#10;  select month&#10;    , part_date&#10;    , pick_up_date as action_date&#10;    , rider_id&#10;    , &apos;pick_up&apos; as action&#10;    , auto_allocated&#10;    , null as rider_dlvry_fee&#10;    , rider_delivery_method&#10;  from dlv&#10;  UNION ALL&#10;  select month&#10;    , part_date&#10;    , hand_over_date as action_date&#10;    , rider_id&#10;    , &apos;hand_over&apos; as action&#10;    , auto_allocated&#10;    , rider_dlvry_fee&#10;    , rider_delivery_method&#10;  from dlv&#10;),&#10;&#10;base2 as (&#10;  select *&#10;      , lead(action) over (partition by part_date, rider_id order by action_date, action) as lead_action&#10;      , lead(action_date) over (partition by part_date, rider_id order by action_date, action) as lead_action_date&#10;      , lead(auto_allocated) over (partition by part_date, rider_id order by action_date, action) as lead_auto_allocated&#10;      , sum(case when action=&apos;consign&apos; then 1 when action=&apos;hand_over&apos; then -1 else 0 end) over (partition by part_date, rider_id order by action_date, action) as keep&#10;      , sum(case when action=&apos;pick_up&apos; then 1 when action=&apos;hand_over&apos; then -1 else 0 end) over (partition by part_date, rider_id order by action_date, action) as pick&#10;  from base&#10;),&#10;&#10;base3 as (&#10;  select *&#10;      , sum(case when action in (&apos;DELIVERING&apos;, &apos;consign&apos;, &apos;AUTOALLOCATEON&apos;, &apos;READY&apos;) then 1 end) over (partition by part_date, rider_id order by action_date, action) as row_num&#10;      , case when auto_allocated=1 or lead_auto_allocated=1 then 1 else 0 end as ai&#10;  from base2&#10;),&#10;&#10;base4 as (&#10;  select *&#10;    -- , case when hour(lead_action_date) between 2 and 8 then 0&#10;    --       when hour(action_date) between 2 and 8 then date_diff(&apos;second&apos;, from_iso8601_timestamp(format_datetime(action_date, &apos;yyyy-MM-dd&apos;)||&apos;T09:00:00&apos;), lead_action_date)/60e0&#10;    --       else date_diff(&apos;second&apos;, action_date, lead_action_date)/60e0 end as diff_time&#10;    , case when hour(lead_action_date) between 5 and 7 then 0&#10;           when hour(action_date) between 5 and 7 then date_diff(&apos;second&apos;, from_iso8601_timestamp(format_datetime(action_date, &apos;yyyy-MM-dd&apos;)||&apos;T09:00:00&apos;), lead_action_date)/60e0&#10;           else date_diff(&apos;second&apos;, action_date, lead_action_date)/60e0 end as diff_time&#10;    , sum(case when row_num=1 and action in (&apos;consign&apos;, &apos;AUTOALLOCATEON&apos;) and lead_action &lt;&lt;&gt;&gt; &apos;DELIVERING&apos; then 1&#10;               when row_num=2 and action=&apos;consign&apos; and lead_action=&apos;consign&apos; and action_date=lead_action_date then 1&#10;               when action=&apos;DELIVERING&apos; then 1&#10;               when row_num&lt;&lt;&gt;&gt;1 and action=&apos;READY&apos; then -1 end) over (partition by part_date, rider_id order by action_date) as onoff&#10;  from base3&#10;  where not(action=&apos;DELIVERING&apos; and lead_action=&apos;DELIVERING&apos;)&#10;    and not(action=&apos;READY&apos; and lead_action=&apos;READY&apos;)&#10;),&#10;&#10;time as (&#10;    select month&#10;        , coalesce(rider_delivery_method, &apos;ALL&apos;) as delivery_method&#10;        , sum(active_time) as total_time_wo_non_workdays -- &quot;총 운행가능시간(미운행일제외)&quot;&#10;        , sum(total_time) as total_time_with_non_workdays -- &quot;총 운행가능시간(미운행일포함)&quot;&#10;    from(&#10;        select month, rider_id, rider_delivery_method, active_time, total_time&#10;        from dim&#10;    )&#10;    group by 1, rollup(rider_delivery_method)&#10;),&#10;&#10;ch2_worktime1 as (&#10;    select *&#10;        , 100e0*total_work_time/total_time_with_non_workdays as avg_work_time_rate -- &quot;총 운행시간&quot;/&quot;총 운행가능시간(미운행일포함)&quot; as &quot;평균 운행율&quot;&#10;        , 100e0*total_work_time/total_time_wo_non_workdays as avg_work_time_rate_wo_non_workdays -- &quot;총 운행시간&quot;/&quot;총 운행가능시간(미운행일제외)&quot; as &quot;미운행일 제외 평균 운행율&quot;&#10;    from(&#10;        select month&#10;            , rider_delivery_method as delivery_method&#10;            , 100e0*sum(idle_time)/sum(on_time) as total_idle_time_rate -- &quot;운행중 유휴율&quot;&#10;            , 100e0*sum(ai_idle_time)/sum(ai_on_time) as ai_idle_time_rate -- &quot;(AI)운행중 유휴율&quot;&#10;            , 100e0*sum(norm_idle_time)/sum(norm_on_time) as normal_idle_time_rate -- &quot;(일반)운행중 유휴율&quot;&#10;            , sum(on_time) as total_work_time -- &quot;총 운행시간&quot;&#10;            , sum(on_time)/sum(num_rider)/60e0 as avg_work_time -- &quot;평균 운행시간&quot;&#10;            , sum(dlv_time)/sum(num_rider)/60e0 as avg_dlv_time -- &quot;평균 배달수행시간&quot;&#10;            , sum(num_dlv)/sum(on_time)*60e0 as utr_with_idle_time -- &quot;UTR(유휴시간포함)&quot;&#10;            , sum(pay)/sum(on_time)*60e0 as pay_per_hour_with_idle_time -- &quot;시간당 평균 수익(유휴시간포함)&quot;&#10;            , 100e0*sum(no_pay_time)/sum(on_time) as unpaid_moving_time_ratio -- &quot;무급이동시간 비중&quot;&#10;        from(&#10;            select month&#10;                , part_date&#10;                , coalesce(rider_delivery_method, &apos;ALL&apos;) as rider_delivery_method&#10;                , sum(case when keep=0 then diff_time end) as idle_time&#10;                , sum(case when keep=0 and ai=0 then diff_time end) as norm_idle_time&#10;                , sum(case when keep=0 and ai=1 then diff_time end) as ai_idle_time&#10;                , sum(diff_time) as on_time&#10;                , sum(case when ai=1 then diff_time end) as ai_on_time&#10;                , sum(case when ai=0 then diff_time end) as norm_on_time&#10;                , count(distinct rider_id) as num_rider&#10;                , sum(case when keep&gt;&gt;=1 then diff_time end) as dlv_time&#10;                , sum(case when action=&apos;hand_over&apos; then 1 end) as num_dlv&#10;                , sum(rider_dlvry_fee) as pay&#10;                , sum(case when keep&gt;&gt;=1 and pick=0 then diff_time end) as no_pay_time&#10;            from base4&#10;            where not(keep=0 and onoff=0)&#10;            group by 1,2,rollup(rider_delivery_method)&#10;        )&#10;        group by 1,2&#10;    )&#10;    left join time using (month, delivery_method)&#10;),&#10;&#10;&#10;&#10;&#10;&#10;&#10;-- #####################################################################################&#10;-- 2. 활동 라이더의 운행시간 증가&#10;-- 2-2. 활동라이더의 운행시간 증가2-배달수단별&#10;-- https://redash.woowa.in/queries/32992/source#102832&#10;-- #####################################################################################c&#10;&#10;raw as (&#10;    select distinct month&#10;        , rider_id&#10;        , part_date as business_day&#10;    from dlv&#10;),&#10;&#10;raw2 as (&#10;    select month&#10;        , rider_id&#10;        , business_day&#10;        , lead(business_day) over (partition by month, rider_id order by business_day) as lead_bd&#10;    from raw&#10;),&#10;&#10;raw3 as (&#10;    select month&#10;        , rider_id&#10;        , avg(date_diff(&apos;day&apos;, date(business_day), date(lead_bd))) as dlv_freq&#10;        , count(1) as bd_cnt&#10;    from raw2&#10;    group by 1,2&#10;),&#10;&#10;ch2_worktime2 as (&#10;    select month&#10;        , coalesce(rider_delivery_method, &apos;ALL&apos;) as rider_delivery_method&#10;        , avg(dlv_freq) as avg_work_freq -- &quot;평균 배달주기&quot;&#10;        , avg(bd_cnt) as avg_work_days_cnt -- &quot;평균 배달일수&quot;&#10;    from raw3&#10;    left join dlv_method using (month, rider_id)&#10;    group by 1, rollup(rider_delivery_method)&#10;)&#10;&#10;&#10;&#10;&#10;&#10;&#10;-- #####################################################################################&#10;-- [FINAL] 최종 결과 취합&#10;-- month | delivery_method | rgn&#10;-- #####################################################################################&#10;&#10;SELECT d.month&#10;     , d.delivery_method&#10;     , &apos;ALL&apos; as rgn&#10;&#10;     , d.total_idle_time_rate&#10;     , d.ai_idle_time_rate&#10;     , d.normal_idle_time_rate&#10;     , d.total_work_time&#10;     , d.avg_work_time&#10;     , d.avg_dlv_time&#10;     , d.utr_with_idle_time&#10;     , d.pay_per_hour_with_idle_time&#10;     , d.unpaid_moving_time_ratio&#10;     , d.avg_work_time_rate&#10;     , d.avg_work_time_rate_wo_non_workdays&#10;&#10;     , e.avg_work_freq&#10;     , e.avg_work_days_cnt&#10;FROM ch2_worktime1 d&#10;LEFT JOIN ch2_worktime2 e&#10;    ON d.month = cast(e.month as varchar)&#10;    AND d.delivery_method = e.rider_delivery_method&#10;ORDER BY month DESC, delivery_method</relation>
        </properties>
        <properties context='extract'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </properties>
      </object>
    </objects>
  </object-graph>
</datasource>
