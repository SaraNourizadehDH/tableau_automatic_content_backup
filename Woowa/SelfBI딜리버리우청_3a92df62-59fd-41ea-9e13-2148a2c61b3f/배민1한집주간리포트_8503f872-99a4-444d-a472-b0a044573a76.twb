          <datasources>
            <datasource caption='재배달 사유 (재배달건 스프레드시트)' name='federated.1mp3w221ljqgd519cqd0j0ly161c' />
          </datasources>
          <datasource-dependencies datasource='federated.1mp3w221ljqgd519cqd0j0ly161c'>
            <column caption='Additional Delivery Reason Type' datatype='string' name='[ADDITIONAL_DELIVERY_REASON_TYPE]' role='dimension' type='nominal' />
            <column caption='재배달사유 한글' datatype='string' name='[Calculation_6195686479478202386]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [ADDITIONAL_DELIVERY_REASON_TYPE] when &apos;OMIT_MENU&apos; then &apos;음식누락&apos;&#10;when &apos;SHOP_ETC&apos; then &apos;업주사유_기타&apos;&#10;when &apos;ABSENCE_CUSTOMER&apos; then &apos;고객부재&apos;&#10;when &apos;WRONG_COOKED_MENU&apos; then &apos;메뉴오조리&apos;&#10;when &apos;WRONG_DELIVERY_MENUITEM&apos; then &apos;오배달&apos;&#10;when &apos;CUSTOMER_ETC&apos; then &apos;고객기타&apos;&#10;when &apos;BAD_PACKED&apos; then &apos;포장불량&apos;&#10;when &apos;FOOD_SIZE&apos; then &apos;과적배달&apos;&#10;else [ADDITIONAL_DELIVERY_REASON_TYPE]END' />
            </column>
            <column caption='Dlvry Cnt' datatype='integer' name='[dlvry_cnt]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_6195686479478202386]' derivation='None' name='[none:Calculation_6195686479478202386:nk]' pivot='key' type='nominal' />
            <column-instance column='[week_date_part]' derivation='None' name='[none:week_date_part:qk]' pivot='key' type='quantitative' />
            <column-instance column='[dlvry_cnt]' derivation='Sum' name='[sum:dlvry_cnt:qk]' pivot='key' type='quantitative' />
            <column-instance column='[week_date_part]' derivation='ISO-Week-Trunc' name='[tiwk:week_date_part:ok]' pivot='key' type='ordinal' />
            <column caption='Week Date Part' datatype='date' name='[week_date_part]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1mp3w221ljqgd519cqd0j0ly161c].[none:Calculation_6195686479478202386:nk]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:Calculation_6195686479478202386:nk]' />
              <groupfilter function='union'>
                <groupfilter function='member' level='[none:Calculation_6195686479478202386:nk]' member='&quot;RETURN_FOODS&quot;' />
