              <calculation class='tableau' formula='case [ds_cancel_reason] when &apos;ADDITIONAL_DELIVERY&apos; then &apos;추가배달&apos;&#10;when &apos;CUSTOMER_REQUEST&apos; then &apos;고객요청&apos;&#10;when &apos;ETC&apos; then &apos;기타&apos;&#10;when &apos;IMPOSSIBLE_DELIVERY&apos; then &apos;배달불가&apos;&#10;when &apos;SHOP_CONDITION&apos; then &apos;업소상황&apos;&#10;when &apos;SHOP_REQUEST&apos; then &apos;가게요청&apos;&#10;when &apos;PAYMENT_CHANGE&apos; then &apos;결제수단변경&apos;&#10;when &apos;INGREDIENT_EXHAUSTION&apos; then &apos;재료소진&apos;&#10;else [ds_cancel_reason] END' />
