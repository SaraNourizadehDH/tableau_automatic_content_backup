          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.118db7p1j2t6m915x0r870u41sd3'>
            <column caption='C_시도 주문건' datatype='real' name='[C_요청건(복사본)_1210060961513668619]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 3] = &apos;합계&apos;&#13;&#10;THEN &#13;&#10;SUM({ FIXED [part_date], [base_dt_type], [svc_cd], [cs_cust_div_cd] : SUM([try_ord_cnt])})&#13;&#10;ELSE SUM({ FIXED [part_date], [base_dt_type], [svc_cd], [cs_cust_div_cd] : SUM([try_ord_cnt])}) / [Calculation_439101031524237312]&#13;&#10;END' />
