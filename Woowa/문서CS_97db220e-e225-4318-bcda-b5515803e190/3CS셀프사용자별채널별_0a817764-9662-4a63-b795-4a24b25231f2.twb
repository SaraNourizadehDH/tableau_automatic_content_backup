          <datasource-dependencies datasource='Parameters'>
            <column caption='P_Start_Date' datatype='date' name='[P_End_Date(복사본)_1465640267664707590]' param-domain-type='any' role='measure' type='quantitative' value='#2025-03-01#'>
              <calculation class='tableau' formula='#2025-03-01#' />
            </column>
            <column caption='P_Date_Type' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;주별&quot;'>
              <calculation class='tableau' formula='&quot;주별&quot;' />
            </column>
            <column caption='P_End_Date' datatype='date' name='[매개 변수 2]' param-domain-type='any' role='measure' type='quantitative' value='#2025-04-01#'>
              <calculation class='tableau' formula='#2025-04-01#' />
            </column>
            <column caption='P_합계/일평균' datatype='string' name='[매개 변수 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;합계&quot;'>
              <calculation class='tableau' formula='&quot;합계&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0037mmg14kz98i1b26mfy1qw0536'>
            <column caption='C_성공률' datatype='real' name='[C_성공률(복사본)_1210060961402785792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 3] = &apos;합계&apos;&#13;&#10;THEN &#13;&#10;AVG({ FIXED [part_date], [base_dt_type], [svc_cd], [cs_cust_div_cd] : AVG([success_rate])})&#13;&#10;ELSE AVG({ FIXED [part_date], [base_dt_type], [svc_cd], [cs_cust_div_cd] : AVG([success_rate])}) / [Calculation_439101031524237312]&#13;&#10;END' />
            </column>
            <column caption='C_처리건' datatype='real' name='[Calculation_1055531198936948740]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 3] = &apos;합계&apos;&#13;&#10;THEN &#13;&#10;SUM({ FIXED [part_date], [base_dt_type], [svc_cd], [cs_cust_div_cd], [cs_slfsvc_ch_cd] : SUM([cs_slfsvc_proc_cnt])})&#13;&#10;ELSE SUM({ FIXED [part_date], [base_dt_type], [svc_cd], [cs_cust_div_cd], [cs_slfsvc_ch_cd] : SUM([cs_slfsvc_proc_cnt])}) / [Calculation_439101031524237312]&#13;&#10;END' />
            </column>
            <column caption='C_처리율' datatype='real' name='[Calculation_1055531198937427973]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 3] = &apos;합계&apos;&#13;&#10;THEN &#13;&#10;AVG({ FIXED [part_date], [base_dt_type], [svc_cd], [cs_cust_div_cd] : AVG([process_rate])})&#13;&#10;ELSE AVG({ FIXED [part_date], [base_dt_type], [svc_cd], [cs_cust_div_cd] : AVG([process_rate])}) / [Calculation_439101031524237312]&#13;&#10;END' />
            </column>
            <column caption='cs_cust_div_nm' datatype='string' name='[Calculation_1055531198938673159]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [cs_cust_div_cd]&#13;&#10;WHEN &quot;Cust&quot; THEN &quot;고객&quot;&#13;&#10;WHEN &quot;Owner&quot; THEN &quot;업주&quot;&#13;&#10;END' />
            </column>
            <column caption='요청건' datatype='real' name='[Calculation_1055531198973112344]' role='measure' type='quantitative' user:unnamed='4_1 IVR 푸드/업주_KPI'>
              <calculation class='tableau' formula='//요청건&#13;&#10;ZN([Calculation_311029885522599937])' />
            </column>
            <column caption='처리건' datatype='real' name='[Calculation_1055531198973145113]' role='measure' type='quantitative' user:unnamed='4_1 IVR 푸드/업주_KPI'>
              <calculation class='tableau' formula='//처리건&#13;&#10;ZN([Calculation_1055531198936948740])' />
            </column>
            <column caption='처리율' datatype='real' name='[Calculation_1055531198984581156]' role='measure' type='quantitative' user:unnamed='4_1 IVR 푸드/업주_KPI'>
              <calculation class='tableau' formula='//처리율&#13;&#10;[Calculation_1055531198937427973]' />
            </column>
            <column caption='성공률' datatype='real' name='[Calculation_1210060961403863047]' role='measure' type='quantitative' user:unnamed='10_1 커머스/고객_KPI'>
              <calculation class='tableau' formula='//성공률&#13;&#10;[C_성공률(복사본)_1210060961402785792]' />
            </column>
            <column caption='C_date_cnt' datatype='integer' name='[Calculation_2055611792632274944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [base_dt_type] = &apos;D&apos; THEN 1&#13;&#10;ELSEIF [base_dt_type] = &apos;W&apos; THEN 7&#13;&#10;ELSEIF [base_dt_type] = &apos;M&apos; THEN &#13;&#10;    DAY(DATE(DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, [part_date]))))&#13;&#10;END' />
            </column>
            <column caption='C_요청건' datatype='real' name='[Calculation_311029885522599937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 3] = &apos;합계&apos;&#13;&#10;THEN &#13;&#10;SUM({ FIXED [part_date], [base_dt_type], [svc_cd], [cs_cust_div_cd], [cs_slfsvc_ch_cd] : SUM([cs_slfsvc_req_cnt])})&#13;&#10;ELSE SUM({ FIXED [part_date], [base_dt_type], [svc_cd], [cs_cust_div_cd], [cs_slfsvc_ch_cd] : SUM([cs_slfsvc_req_cnt])}) / [Calculation_439101031524237312]&#13;&#10;END' />
            </column>
            <column caption='C_분모_평균용' datatype='integer' name='[Calculation_439101031524237312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX({FIXED [part_date], [base_dt_type]:  MAX([Calculation_2055611792632274944])})' />
            </column>
            <column caption='F_Date_Type' datatype='boolean' name='[F_Date_Type_트렌드(복사본)_109212298852294656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; &#13;&#10;THEN &#13;&#10;[base_dt_type] = &apos;M&apos; AND&#13;&#10;DATETRUNC(&apos;month&apos;,[part_date]) = DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;주별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;W&apos; AND&#13;&#10;DATETRUNC(&apos;iso-week&apos;,[part_date]) = DATETRUNC(&apos;iso-week&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;일별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;D&apos; AND&#13;&#10;DATETRUNC(&apos;day&apos;,[Parameters].[P_End_Date(복사본)_1465640267664707590])&lt;=DATETRUNC(&apos;day&apos;,[part_date]) AND &#13;&#10;DATETRUNC(&apos;day&apos;,[part_date]) &lt;= DATETRUNC(&apos;day&apos;,[Parameters].[매개 변수 2])&#13;&#10;END' />
            </column>
            <column caption='F_유형별처리_커머스고객' datatype='boolean' name='[F_유형별처리_푸드업주(복사본)(복사본)_1055531198936014850]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1055531198938673159] = &quot;고객&quot;&#13;&#10;AND &#13;&#10;[svc_div_nm] = &quot;커머스&quot;' />
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[base_dt_type]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[cs_cust_div_cd]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[cs_slfsvc_ch_cd]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[cs_slfsvc_proc_cnt]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[cs_slfsvc_req_cnt]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column-instance column='[F_Date_Type_트렌드(복사본)_109212298852294656]' derivation='None' name='[none:F_Date_Type_트렌드(복사본)_109212298852294656:nk]' pivot='key' type='nominal' />
