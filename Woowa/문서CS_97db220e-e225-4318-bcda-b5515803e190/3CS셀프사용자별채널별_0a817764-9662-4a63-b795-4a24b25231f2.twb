              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;    THEN MID(STR([Calculation_55450634679939073]),6,2) + &quot;/&quot; + MID(STR([Calculation_55450634679939073]),9,2)&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;주별&apos; &#13;&#10;&#13;&#10;    THEN MID(STR([Calculation_55450634679939073]),6,2)+ &quot;/&quot; + MID(STR([Calculation_55450634679939073]),9,2)&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;월별&apos; &#13;&#10;&#13;&#10;    THEN &quot;`&quot; + MID(STR([Calculation_55450634679939073]),3,2)+ &quot;.&quot; + MID(STR([Calculation_55450634679939073]),6,2)&#13;&#10;&#13;&#10;END' />
