            <column caption='요청건' datatype='real' name='[Calculation_1055531198945706002]' role='measure' type='quantitative' user:unnamed='1_2 푸드/업주 막대'>
              <calculation class='tableau' formula='//요청건&#13;&#10;[Calculation_311029885522599937]' />
