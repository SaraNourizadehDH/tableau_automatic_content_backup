            <column caption='INT(NULL)' datatype='integer' name='[Calculation_1055531198994120744]' role='measure' type='quantitative' user:unnamed='4_3 IVR 푸드/업주_건수'>
              <calculation class='tableau' formula='INT(NULL)' />
