            <column caption='요청건' datatype='real' name='[Calculation_1055531198994280489]' role='measure' type='quantitative' user:unnamed='4_3 IVR 푸드/업주_건수'>
              <calculation class='tableau' formula='//요청건&#13;&#10;[Calculation_311029885522599937]' />
            </column>
            <column caption='처리건' datatype='real' name='[Calculation_1055531198994300970]' role='measure' type='quantitative' user:unnamed='4_3 IVR 푸드/업주_건수'>
              <calculation class='tableau' formula='//처리건&#13;&#10;[Calculation_1055531198936948740]' />
            </column>
            <column caption='F_Date_Type_트렌드' datatype='boolean' name='[Calculation_1465640267664797703]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; &#13;&#10;THEN &#13;&#10;[base_dt_type] = &apos;M&apos; AND&#13;&#10;DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-12,[Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;month&apos;,[part_date]) AND&#13;&#10;DATETRUNC(&apos;month&apos;,[part_date]) &lt;= DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;주별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;W&apos; AND&#13;&#10;DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-11,[Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;iso-week&apos;,[part_date]) AND &#13;&#10;DATETRUNC(&apos;iso-week&apos;,[part_date]) &lt;= DATETRUNC(&apos;iso-week&apos;,[Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &apos;일별&apos; &#13;&#10;THEN&#13;&#10;[base_dt_type] = &apos;D&apos; AND&#13;&#10;DATETRUNC(&apos;day&apos;,[Parameters].[P_End_Date(복사본)_1465640267664707590])&lt;=DATETRUNC(&apos;day&apos;,[part_date]) AND &#13;&#10;DATETRUNC(&apos;day&apos;,[part_date]) &lt;= DATETRUNC(&apos;day&apos;,[Parameters].[매개 변수 2])&#13;&#10;END' />
            </column>
            <column caption='C_date_cnt' datatype='integer' name='[Calculation_2055611792632274944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [base_dt_type] = &apos;D&apos; THEN 1&#13;&#10;ELSEIF [base_dt_type] = &apos;W&apos; THEN 7&#13;&#10;ELSEIF [base_dt_type] = &apos;M&apos; THEN &#13;&#10;    DAY(DATE(DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, [part_date]))))&#13;&#10;END' />
            </column>
            <column caption='C_요청건' datatype='real' name='[Calculation_311029885522599937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 3] = &apos;합계&apos;&#13;&#10;THEN &#13;&#10;SUM({ FIXED [part_date], [base_dt_type], [svc_cd], [cs_cust_div_cd], [cs_slfsvc_ch_cd] : SUM([cs_slfsvc_req_cnt])})&#13;&#10;ELSE SUM({ FIXED [part_date], [base_dt_type], [svc_cd], [cs_cust_div_cd], [cs_slfsvc_ch_cd] : SUM([cs_slfsvc_req_cnt])}) / [Calculation_439101031524237312]&#13;&#10;END' />
            </column>
            <column caption='C_분모_평균용' datatype='integer' name='[Calculation_439101031524237312]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX({FIXED [part_date], [base_dt_type]:  MAX([Calculation_2055611792632274944])})' />
