            <column caption='C_LV1' datatype='string' name='[Calculation_1381197777157419059]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;월별&apos;&#13;&#10;THEN &apos;당월&apos;+&apos;&#13;&#10;&apos;&#13;&#10;+&quot;(&apos;&quot;+MID(STR(DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2])), 3, 2)+&apos;.&apos;+MID(STR(DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2])), 6, 2)+&apos;)&apos;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;주별&apos;&#13;&#10;THEN &apos;금주&apos;+&apos;&#13;&#10;&apos;&#13;&#10;+&apos;(&apos;+MID(STR(DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])), 6, 2)+&apos;/&apos;+RIGHT(STR(DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])), 2)+&apos;)&apos;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN &apos;당일&apos;+&apos;&#13;&#10;&apos;&#13;&#10;+&apos;(&apos;+MID(STR(DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])), 6, 2)+&apos;/&apos;+RIGHT(STR(DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])), 2)+&apos;)&apos;&#13;&#10;&#13;&#10;END' />
