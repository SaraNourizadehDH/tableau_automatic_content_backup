              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3]&#13;&#10;WHEN &apos;일평균&apos;&#13;&#10;THEN (&#13;&#10;    SUM({ FIXED [base_dt_type], [part_date], [lv1_svc_cd], [lv2_svc_cd], [dlvry_mgmt_type_cd], [is_stod]&#13;&#10;    : MIN(IF [lv1_svc_cd] = &apos;FD&apos; AND [dlvry_mgmt_type_cd] = &apos;OD&apos; AND [is_stod] = 0 THEN [try_ord_cnt] END)})&#13;&#10;    /&#13;&#10;    [Calculation_4099683100082352142]&#13;&#10;)&#13;&#10;WHEN &apos;합계&apos;&#13;&#10;THEN SUM({ FIXED [base_dt_type], [part_date], [lv1_svc_cd], [lv2_svc_cd], [dlvry_mgmt_type_cd], [is_stod]&#13;&#10;    : MIN(IF [lv1_svc_cd] = &apos;FD&apos; AND [dlvry_mgmt_type_cd] = &apos;OD&apos; AND [is_stod] = 0 THEN [try_ord_cnt] END)})&#13;&#10;END' />
