    <worksheet name='3-1. 주문수_라인차트'>
      <table>
        <view>
          <datasources>
            <datasource caption='1_CS_Overview' name='sqlproxy.0ca8e600xtjhxi14opje40l5aua7' />
            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='P_Date_Type' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;일별&quot;'>
              <calculation class='tableau' formula='&quot;일별&quot;' />
            </column>
            <column caption='P_End_Date_Only' datatype='date' default-format='*yyyy-MM-dd' name='[매개 변수 2]' param-domain-type='any' role='measure' type='quantitative' value='#2025-05-11#'>
              <calculation class='tableau' formula='#2025-05-11#' />
            </column>
            <column caption='P_합계/일평균' datatype='string' name='[매개 변수 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;합계&quot;'>
              <calculation class='tableau' formula='&quot;합계&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0ca8e600xtjhxi14opje40l5aua7'>
            <column caption='C_시도주문수' datatype='real' name='[C_당기_시도주문수(복사본)_3388395833569447988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3]&#13;&#10;WHEN &apos;일평균&apos;&#13;&#10;THEN (&#13;&#10;    SUM({ FIXED [base_dt_type], [part_date], [lv1_svc_cd], [lv2_svc_cd], [dlvry_mgmt_type_cd], [is_stod] : MIN([try_ord_cnt])})&#13;&#10;    /&#13;&#10;    [Calculation_4099683100082352142]&#13;&#10;)&#13;&#10;WHEN &apos;합계&apos;&#13;&#10;THEN SUM({ FIXED [base_dt_type], [part_date], [lv1_svc_cd], [lv2_svc_cd], [dlvry_mgmt_type_cd], [is_stod] : MIN([try_ord_cnt])})&#13;&#10;END' />
            </column>
            <column caption='C_취소주문수' datatype='real' name='[C_시도주문수(복사본)_5051912947685937164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3]&#13;&#10;WHEN &apos;일평균&apos;&#13;&#10;THEN (&#13;&#10;    SUM({ FIXED [base_dt_type], [part_date], [lv1_svc_cd], [lv2_svc_cd], [dlvry_mgmt_type_cd], [is_stod] : MIN([cancel_ord_cnt])})&#13;&#10;    /&#13;&#10;    [Calculation_4099683100082352142]&#13;&#10;)&#13;&#10;WHEN &apos;합계&apos;&#13;&#10;THEN SUM({ FIXED [base_dt_type], [part_date], [lv1_svc_cd], [lv2_svc_cd], [dlvry_mgmt_type_cd], [is_stod] : MIN([cancel_ord_cnt])})&#13;&#10;END' />
            </column>
            <column caption='lv2_svc_nm' datatype='string' name='[Calculation_3274116992347701251]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [lv2_svc_cd]&#13;&#10;WHEN &apos;FDMP&apos; THEN &apos;가게배달&apos;&#13;&#10;WHEN &apos;FDOD&apos; THEN &apos;배민배달&apos;&#13;&#10;WHEN &apos;CMBS&apos; THEN &apos;장보기쇼핑&apos;&#13;&#10;WHEN &apos;CMBM&apos; THEN &apos;B마트&apos;&#13;&#10;WHEN &apos;CMBR&apos; THEN &apos;배민상회&apos;&#13;&#10;END' />
            </column>
            <column caption='lv1_svc_nm' datatype='string' name='[Calculation_3274116992349278212]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [lv1_svc_cd]&#13;&#10;WHEN &apos;FD&apos; THEN &apos;푸드&apos;&#13;&#10;WHEN &apos;CM&apos; THEN &apos;커머스&apos;&#13;&#10;END' />
            </column>
            <column caption='F_조회기간' datatype='boolean' name='[Calculation_3388395833563369523]' role='dimension' type='nominal'>
