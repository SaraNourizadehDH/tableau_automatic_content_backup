          <datasource-dependencies datasource='sqlproxy.0ca8e600xtjhxi14opje40l5aua7'>
            <column caption='C_FCR' datatype='real' name='[C_당기_FCR(복사본)_3372070286337105976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[C_당기_FCR인입(복사본)_3372070286337105975]/[C_당기_고객상담인입수(복사본)_3388395833573048373]' />
            </column>
            <column caption='C_FCR인입' datatype='real' name='[C_당기_FCR인입(복사본)_3372070286337105975]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3]&#13;&#10;WHEN &apos;일평균&apos;&#13;&#10;THEN SUM({ FIXED [base_dt_type], [part_date], [lv1_svc_cd], [lv2_svc_cd], [cs_ch_cd], [cs_cust_div_cd] : MIN([fcr_bound_cnt])})&#13;&#10;    /&#13;&#10;    [Calculation_4099683100082352142]&#13;&#10;&#13;&#10;WHEN &apos;합계&apos;&#13;&#10;THEN SUM({ FIXED [base_dt_type], [part_date], [lv1_svc_cd], [lv2_svc_cd], [cs_ch_cd], [cs_cust_div_cd] : MIN([fcr_bound_cnt])})&#13;&#10;END' />
            </column>
            <column caption='C_고객상담인입수' datatype='real' name='[C_당기_고객상담인입수(복사본)_3388395833573048373]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3]&#13;&#10;WHEN &apos;일평균&apos;&#13;&#10;THEN (&#13;&#10;    SUM({ FIXED [base_dt_type], [part_date], [lv1_svc_cd], [Calculation_3274116992349745157], [cs_cust_div_cd] : MIN([cs_bound_cnt])})&#13;&#10;    /&#13;&#10;    [Calculation_4099683100082352142]&#13;&#10;)&#13;&#10;WHEN &apos;합계&apos;&#13;&#10;THEN SUM({ FIXED [base_dt_type], [part_date], [lv1_svc_cd], [Calculation_3274116992349745157], [cs_cust_div_cd] : MIN([cs_bound_cnt])})&#13;&#10;END' />
            </column>
            <column caption='cs_ch_nm' datatype='string' name='[Calculation_3274116992349745157]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [cs_ch_cd]&#13;&#10;WHEN &apos;In&apos; THEN &apos;전화&apos;&#13;&#10;WHEN &apos;Chat&apos; THEN &apos;채팅&apos;&#13;&#10;END' />
            </column>
            <column caption='F_조회기간' datatype='boolean' name='[Calculation_3388395833563369523]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos; AND [base_dt_type] = &apos;D&apos;&#13;&#10;THEN DATETRUNC(&apos;day&apos;, DATEADD(&apos;day&apos;, -14, [Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;day&apos;, [part_date])&#13;&#10;AND DATETRUNC(&apos;day&apos;, [part_date]) &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;주별&apos; AND [base_dt_type] = &apos;W&apos;&#13;&#10;THEN DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, -11, [Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;day&apos;, [part_date])&#13;&#10;AND DATETRUNC(&apos;day&apos;, [part_date]) &lt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;월별&apos; AND [base_dt_type] = &apos;M&apos;&#13;&#10;THEN DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -12, [Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;day&apos;, [part_date])&#13;&#10;AND DATETRUNC(&apos;day&apos;, [part_date]) &lt;= DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='C_분모_평균용' datatype='integer' name='[Calculation_4099683100082352142]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX({ FIXED [part_date], [base_dt_type] : MAX([date_cnt]) })' />
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[base_dt_type]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
