      <table>
        <view>
          <datasources>
            <datasource caption='1_CS_Overview' name='sqlproxy.0ca8e600xtjhxi14opje40l5aua7' />
            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='P_Date_Type' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;주별&quot;'>
              <calculation class='tableau' formula='&quot;주별&quot;' />
            </column>
            <column caption='P_End_Date_Only' datatype='date' default-format='*yyyy-MM-dd' name='[매개 변수 2]' param-domain-type='any' role='measure' type='quantitative' value='#2025-05-11#'>
              <calculation class='tableau' formula='#2025-05-11#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0ca8e600xtjhxi14opje40l5aua7'>
            <column caption='C_LV2' datatype='string' name='[C_LV1(복사본)_1381197777164329013]' role='dimension' type='nominal'>
