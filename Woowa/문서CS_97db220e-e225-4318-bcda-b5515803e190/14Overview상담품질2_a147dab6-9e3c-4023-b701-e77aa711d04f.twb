          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0ca8e600xtjhxi14opje40l5aua7'>
            <column caption='C_LV2' datatype='string' name='[C_LV1(복사본)_1381197777164329013]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;월별&apos;&#13;&#10;THEN &apos;전월&apos;+&apos;&#13;&#10;&apos;&#13;&#10;+&quot;(&apos;&quot;+MID(STR(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;,-1, [Parameters].[매개 변수 2]))), 3, 2)+&apos;.&apos;+MID(STR(DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;,-1, [Parameters].[매개 변수 2]))), 6, 2)+&apos;)&apos;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;주별&apos;&#13;&#10;THEN &apos;전주&apos;+&apos;&#13;&#10;&apos;&#13;&#10;+&apos;(&apos;+MID(STR(DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;,-1, [Parameters].[매개 변수 2]))), 6, 2)+&apos;/&apos;+RIGHT(STR(DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;,-1, [Parameters].[매개 변수 2]))), 2)+&apos;)&apos;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN &apos;D-1&apos;+&apos;&#13;&#10;&apos;&#13;&#10;+&apos;(&apos;+MID(STR(DATETRUNC(&apos;day&apos;, DATEADD(&apos;day&apos;, -1, [Parameters].[매개 변수 2]))), 6, 2)+&apos;/&apos;+RIGHT(STR(DATETRUNC(&apos;day&apos;, DATEADD(&apos;day&apos;, -1, [Parameters].[매개 변수 2]))), 2)+&apos;)&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='C_LV3' datatype='string' name='[C_LV2(복사본)_1381197777164955703]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;월별&apos;&#13;&#10;THEN &apos;전년동월&apos;+&apos;&#13;&#10;&apos;&#13;&#10;+&quot;(&apos;&quot;+MID(STR(DATETRUNC(&apos;month&apos;, DATEADD(&apos;year&apos;,-1, [Parameters].[매개 변수 2]))), 3, 2)+&apos;.&apos;+MID(STR(DATETRUNC(&apos;month&apos;, DATEADD(&apos;year&apos;,-1, [Parameters].[매개 변수 2]))), 6, 2)+&apos;)&apos;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;주별&apos;&#13;&#10;THEN &apos;2주전&apos;+&apos;&#13;&#10;&apos;&#13;&#10;+&apos;(&apos;+MID(STR(DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;,-2, [Parameters].[매개 변수 2]))), 6, 2)+&apos;/&apos;+RIGHT(STR(DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;,-2, [Parameters].[매개 변수 2]))), 2)+&apos;)&apos;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN &apos;W-1&apos;+&apos;&#13;&#10;&apos;&#13;&#10;+&apos;(&apos;+MID(STR(DATETRUNC(&apos;day&apos;, DATEADD(&apos;iso-week&apos;, -1, [Parameters].[매개 변수 2]))), 6, 2)+&apos;/&apos;+RIGHT(STR(DATETRUNC(&apos;day&apos;, DATEADD(&apos;iso-week&apos;, -1, [Parameters].[매개 변수 2]))), 2)+&apos;)&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='C_LV4' datatype='string' name='[C_LV3(복사본)_1045398130173218816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN &apos;W-2&apos;+&apos;&#13;&#10;&apos;&#13;&#10;+&apos;(&apos;+MID(STR(DATETRUNC(&apos;day&apos;, DATEADD(&apos;iso-week&apos;, -2, [Parameters].[매개 변수 2]))), 6, 2)+&apos;/&apos;+RIGHT(STR(DATETRUNC(&apos;day&apos;, DATEADD(&apos;iso-week&apos;, -2, [Parameters].[매개 변수 2]))), 2)+&apos;)&apos;&#13;&#10;&#13;&#10;ELSE &apos;&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='C_LV1' datatype='string' name='[Calculation_1381197777157419059]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;월별&apos;&#13;&#10;THEN &apos;당월&apos;+&apos;&#13;&#10;&apos;&#13;&#10;+&quot;(&apos;&quot;+MID(STR(DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2])), 3, 2)+&apos;.&apos;+MID(STR(DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2])), 6, 2)+&apos;)&apos;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;주별&apos;&#13;&#10;THEN &apos;금주&apos;+&apos;&#13;&#10;&apos;&#13;&#10;+&apos;(&apos;+MID(STR(DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])), 6, 2)+&apos;/&apos;+RIGHT(STR(DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])), 2)+&apos;)&apos;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN &apos;당일&apos;+&apos;&#13;&#10;&apos;&#13;&#10;+&apos;(&apos;+MID(STR(DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])), 6, 2)+&apos;/&apos;+RIGHT(STR(DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])), 2)+&apos;)&apos;&#13;&#10;&#13;&#10;END' />
