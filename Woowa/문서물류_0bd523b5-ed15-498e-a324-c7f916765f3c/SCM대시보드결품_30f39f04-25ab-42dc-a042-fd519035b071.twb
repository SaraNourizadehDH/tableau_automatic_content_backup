              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#13;&#10;WHEN &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-11,[Parameters].[매개 변수 1])) &lt;= [Calculation_1438055721170837510] and [Calculation_1438055721170837510] &lt; DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Parameters].[매개 변수 1]))&#13;&#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-7,[Parameters].[매개 변수 1])) &lt;= [Calculation_1438055721170837510] and [Calculation_1438055721170837510] &lt; DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,1,[Parameters].[매개 변수 1]))&#13;&#10;WHEN &apos;일별&apos; THEN [Parameters].[매개 변수 4]&lt;=[Calculation_1438055721170837510] and [Calculation_1438055721170837510] &lt;= [Parameters].[매개 변수 1] AND (DATEADD(&apos;day&apos;, -30, [Parameters].[매개 변수 1]) &lt;= [Calculation_1438055721170837510])&#13;&#10;END' />
