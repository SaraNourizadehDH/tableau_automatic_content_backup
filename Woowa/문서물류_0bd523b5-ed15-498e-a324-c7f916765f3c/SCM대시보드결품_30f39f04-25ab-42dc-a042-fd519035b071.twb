      <column caption='Text_Date_Type' datatype='string' name='[Calculation_960955636013899789]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Number]&#13;&#10;WHEN 1 THEN &apos;`&apos; + right(STR(YEAR([Parameters].[매개 변수 1])),2)+ &apos;.&apos;+ MID(str([Parameters].[매개 변수 1]),6,2)&#13;&#10;WHEN 2 THEN STR(ISOWEEK([Parameters].[매개 변수 1])) + &apos;W&apos;&#13;&#10;WHEN 3 THEN REPLACE(MID(str([Parameters].[매개 변수 1]),6,5),&apos;-&apos;,&apos;/&apos;)&#13;&#10;END' />
