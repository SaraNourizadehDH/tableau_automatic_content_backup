          <datasource-dependencies datasource='sqlproxy.0c155pj0u167jy117y3jg0xt80tz'>
            <column caption='C_month' datatype='string' name='[Calculation_1438055721038663684]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;`&apos; + right([year],2)+ &apos;.&apos;+ [month]' />
            </column>
            <column caption='C_date' datatype='date' datatype-customized='true' default-format='*yyyy-mm-dd' name='[Calculation_1438055721170837510]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEPARSE(&apos;yyyy-MM-dd&apos;,[part_dt]))' />
            </column>
            <column caption='C_Date_Type' datatype='string' name='[Calculation_1438055721172049927]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#13;&#10;WHEN &apos;월별&apos; THEN [Calculation_1438055721038663684]&#13;&#10;WHEN &apos;주별&apos; THEN [Calculation_1438055721172455432]&#13;&#10;WHEN &apos;일별&apos; THEN [Calculation_960955636485640309]&#13;&#10;END' />
