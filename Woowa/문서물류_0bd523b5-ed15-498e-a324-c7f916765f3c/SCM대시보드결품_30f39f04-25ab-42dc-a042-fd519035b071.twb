              <calculation class='tableau' formula='IF [Parameters].[매개 변수 2] = &apos;주별&apos;&#13;&#10;THEN &apos;현재 적용 기간 : &apos;&#13;&#10;+ str(ISOWEEK(DATEADD(&apos;week&apos;,-8,[Parameters].[매개 변수 1])))+&apos;W&apos;&#13;&#10;+&apos; ~ &apos;+ str(ISOWEEK(DATEADD(&apos;week&apos;,0,[Parameters].[매개 변수 1])))+&apos;W&apos;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
