      <column caption='C_날짜_일별_경고문구 (&gt;30)' datatype='string' name='[Calculation_185210599060221952]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 2] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[매개 변수 4], [Parameters].[매개 변수 1]) &gt; 30&#13;&#10;    THEN &apos;※ 기간을 31일 이내로 입력하세요.&apos;&#13;&#10;    ELSEIF [Parameters].[매개 변수 4] &gt; [Parameters].[매개 변수 1]&#13;&#10;    THEN &apos;※ 시작일이 종료일보다 큽니다.&apos;&#13;&#10;    ELSE &apos;&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='default_Date_Type' datatype='string' name='[Calculation_223772660601614336]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;일별&apos;' />
      </column>
      <column caption='F_시작일가리기' datatype='boolean' name='[Calculation_260645882189533185]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[매개 변수 2]!=&apos;일별&apos;' />
      </column>
      <column caption='C_Start_date(일별)' datatype='date' name='[Calculation_260645882195365899]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='ATTR(DATE(IF [Calculation_960955636013121547] = &apos;일별&apos; THEN DATEADD(&apos;day&apos;, -13, [Parameters].[매개 변수 1]) ELSE [Parameters].[매개 변수 4] END))' />
      </column>
      <column caption='Text_Date_Type(select)' datatype='string' name='[Calculation_260645882230448151]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_960955636013121547]&#13;&#10;WHEN &apos;월별&apos; THEN &apos;`&apos; + right(STR(YEAR([Parameters].[매개 변수 1])),2)+ &apos;.&apos;+ MID(str([Parameters].[매개 변수 1]),6,2)&#13;&#10;WHEN &apos;주별&apos; THEN STR(ISOWEEK([Parameters].[매개 변수 1])) + &apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN REPLACE(MID(str([Parameters].[매개 변수 1]),6,5),&apos;-&apos;,&apos;/&apos;)&#13;&#10;END' />
      </column>
      <column caption='test' datatype='string' name='[Calculation_421086619633733634]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Number]&#13;&#10;WHEN  1 then &apos;일&apos;&#13;&#10;WHEN  2 then &apos;월&apos;&#13;&#10;WHEN  3 then &apos;화&apos;&#13;&#10;WHEN  4 then &apos;수&apos;&#13;&#10;WHEN  5 then &apos;목&apos;&#13;&#10;WHEN  6 then &apos;금&apos;&#13;&#10;WHEN  7 then &apos;토&apos;&#13;&#10;END' />
      </column>
      <column caption='C_종료일/기준일' datatype='string' name='[Calculation_492862737699188745]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Number]&#13;&#10;when 1 then &apos;기준일&apos;&#13;&#10;when 2 then &apos;기준일&apos;&#13;&#10;when 3 then &apos;종료일&apos;&#13;&#10;END' />
      </column>
      <column caption='C_Date_Type' datatype='string' name='[Calculation_960955636013121547]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Number]&#13;&#10;when 1 then &apos;월별&apos;&#13;&#10;when 2 then &apos;주별&apos;&#13;&#10;when 3 then &apos;일별&apos;&#13;&#10;END' />
      </column>
      <column caption='F_Date_Type' datatype='boolean' name='[Calculation_960955636013400076]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[매개 변수 2]=[Calculation_960955636013121547]' />
