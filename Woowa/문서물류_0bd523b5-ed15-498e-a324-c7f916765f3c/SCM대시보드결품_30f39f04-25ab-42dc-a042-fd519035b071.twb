            <column caption='C_day(휴일포함)' datatype='string' default-format='*mm/dd' name='[Calculation_1438055721172934666]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#13;&#10;WHEN &apos;일별&apos; THEN IF [weekday_nm] IN (&apos;토&apos;,&apos;일&apos;) THEN STR([Calculation_960955636485640309]) + char(10)&#13;&#10;                                                    + IF [holiday_yn]=&apos;1&apos; THEN &apos;(&apos;+[weekday_nm]+&apos;)&apos; + char(10) + [Calculation_191121509543071744]&#13;&#10;                                                      ELSE &apos;(&apos;+[weekday_nm]+&apos;)&apos; + char(10)&#13;&#10;                                                      END + char(10)&#13;&#10;                ELSE STR([Calculation_960955636485640309]) + char(10) +&#13;&#10;                     IF [holiday_yn]=&apos;1&apos; THEN &apos;(&apos;+[weekday_nm]+&apos;)&apos; + char(10) + [Calculation_191121509543071744]&#13;&#10;                                                      ELSE char(10)&#13;&#10;                                                      END + char(10)&#13;&#10;                END&#13;&#10;END' />
