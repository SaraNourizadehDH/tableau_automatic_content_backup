        <calculation class='tableau' formula='CASE [Number]&#13;&#10;when 1 then &apos;Lv 1&apos;&#13;&#10;when 2 then &apos;Lv 2&apos;&#13;&#10;when 3 then &apos;Lv 3&apos;&#13;&#10;when 4 then &apos;Lv 4&apos;&#13;&#10;END' />
