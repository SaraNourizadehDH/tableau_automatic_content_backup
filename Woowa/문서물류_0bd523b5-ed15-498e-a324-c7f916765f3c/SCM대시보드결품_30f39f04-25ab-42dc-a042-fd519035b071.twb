        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#13;&#10;WHEN &apos;월별&apos; THEN [Calculation_1438055721038663684]&#13;&#10;WHEN &apos;주별&apos; THEN [Calculation_1438055721172455432]&#13;&#10;WHEN &apos;일별&apos; THEN [Calculation_960955636485640309]&#13;&#10;END' />
      </column>
      <column caption='F_매출등급' datatype='string' name='[Calculation_1438055721183178772]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [prod_sal_gd]=&apos;S&apos;&#13;&#10;THEN &apos;S&apos;&#13;&#10;ELSEIF [prod_sal_gd]=&apos;A&apos;&#13;&#10;THEN &apos;A&apos;&#13;&#10;ELSE &apos;그 외&apos;&#13;&#10;END' />
      </column>
      <column caption='C_시도' datatype='string' name='[Calculation_1438055721234432059]' role='dimension' semantic-role='[State].[Name]' type='nominal'>
        <calculation class='tableau' formula='CASE [sido_nm]&#13;&#10;WHEN &apos;서울특별시&apos; THEN &apos;서울&apos;&#13;&#10;WHEN &apos;인천광역시&apos; THEN &apos;인천&apos;&#13;&#10;WHEN &apos;대전광역시&apos; THEN &apos;대전&apos;&#13;&#10;WHEN &apos;울산광역시&apos; THEN &apos;울산&apos;&#13;&#10;WHEN &apos;대구광역시&apos; THEN &apos;대구&apos;&#13;&#10;WHEN &apos;부산광역시&apos; THEN &apos;부산&apos;&#13;&#10;WHEN &apos;광주광역시&apos; THEN &apos;광주&apos;&#13;&#10;WHEN &apos;경기도&apos; THEN &apos;경기&apos;&#13;&#10;WHEN &apos;강원도&apos; THEN &apos;강원&apos;&#13;&#10;WHEN &apos;충청남도&apos; THEN &apos;충남&apos;&#13;&#10;WHEN &apos;충청북도&apos; THEN &apos;충북&apos;&#13;&#10;WHEN &apos;경상남도&apos; THEN &apos;경남&apos;&#13;&#10;WHEN &apos;경상북도&apos; THEN &apos;경북&apos;&#13;&#10;WHEN &apos;전라남도&apos; THEN &apos;전남&apos;&#13;&#10;WHEN &apos;전라북도&apos; THEN &apos;전북&apos;&#13;&#10;WHEN &apos;제주특별자치도&apos; THEN &apos;제주&apos;&#13;&#10;WHEN &apos;세종특별자치시&apos; THEN &apos;세종&apos;&#13;&#10;END' />
      </column>
      <column caption='C_구군' datatype='string' name='[Calculation_1438055721234563132]' role='dimension' semantic-role='[County].[Name]' type='nominal'>
        <calculation class='tableau' formula='[gugun_nm]' />
      </column>
      <column caption='C_FC' datatype='string' name='[Calculation_1438055721234673725]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='MID([cntr_nm],1,LEN([cntr_nm])-1)' />
      </column>
      <column caption='시도' datatype='string' name='[Calculation_1487876783373905927]' role='dimension' semantic-role='[State].[Name]' type='nominal'>
        <calculation class='tableau' formula='CASE [sido_nm]&#13;&#10;WHEN &apos;서울특별시&apos; THEN &apos;서울&apos;&#13;&#10;WHEN &apos;인천광역시&apos; THEN &apos;인천&apos;&#13;&#10;WHEN &apos;대전광역시&apos; THEN &apos;대전&apos;&#13;&#10;WHEN &apos;울산광역시&apos; THEN &apos;울산&apos;&#13;&#10;WHEN &apos;대구광역시&apos; THEN &apos;대구&apos;&#13;&#10;WHEN &apos;부산광역시&apos; THEN &apos;부산&apos;&#13;&#10;WHEN &apos;광주광역시&apos; THEN &apos;광주&apos;&#13;&#10;WHEN &apos;경기도&apos; THEN &apos;경기&apos;&#13;&#10;WHEN &apos;강원도&apos; THEN &apos;강원&apos;&#13;&#10;WHEN &apos;충청남도&apos; THEN &apos;충남&apos;&#13;&#10;WHEN &apos;충청북도&apos; THEN &apos;충북&apos;&#13;&#10;WHEN &apos;경상남도&apos; THEN &apos;경남&apos;&#13;&#10;WHEN &apos;경상북도&apos; THEN &apos;경북&apos;&#13;&#10;WHEN &apos;전라남도&apos; THEN &apos;전남&apos;&#13;&#10;WHEN &apos;전라북도&apos; THEN &apos;전북&apos;&#13;&#10;WHEN &apos;제주특별자치도&apos; THEN &apos;제주&apos;&#13;&#10;WHEN &apos;세종특별자치시&apos; THEN &apos;세종&apos;&#13;&#10;END' />
      </column>
      <column caption='시군구' datatype='string' name='[Calculation_1487876783373987848]' role='dimension' semantic-role='[County].[Name]' type='nominal'>
        <calculation class='tableau' formula='[gugun_nm]' />
      </column>
      <column caption='C_TRUE' datatype='boolean' name='[Calculation_1530942451272859863]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRUE' />
      </column>
      <column caption='FC' datatype='string' name='[Calculation_2355382659029581828]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF RIGHT(cntr_nm,1) = &apos;점&apos;&#13;&#10;THEN LEFT([cntr_nm], LEN([cntr_nm])-1)&#13;&#10;ELSE [cntr_nm]&#13;&#10;END' />
      </column>
      <column caption='F_시간대' datatype='string' name='[Calculation_960955636798529692]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[base_tz]+&apos;시&apos;' />
      </column>
      <column caption='F_매출등급(Main용)' datatype='string' name='[F_매출등급(복사본)_1524468476336910336]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [prod_sal_gd]=&apos;S&apos;&#13;&#10;THEN &apos;S&apos;&#13;&#10;ELSEIF [prod_sal_gd]=&apos;A&apos;&#13;&#10;THEN &apos;A&apos;&#13;&#10;ELSE &apos;그 외&apos;&#13;&#10;END' />
      </column>
      <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[cat1_nm]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
      <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[cat2_nm]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
      <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[cat3_nm]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
      <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[cat4_nm]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
