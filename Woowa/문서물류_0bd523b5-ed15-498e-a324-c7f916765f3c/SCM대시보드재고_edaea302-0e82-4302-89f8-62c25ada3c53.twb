            <column caption='C_재고회전일_수량 (FC)' datatype='real' name='[C_재고회전일_수량/금액 (FC)(복사본)_2084040789215698958]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM(if [cntr_clsf] = &apos;FC&apos; then [sal_qty] end) = 0 THEN 0&#13;&#10;ELSE SUM(if [cntr_clsf] = &apos;FC&apos; then [ivtr_qty]+[mvng_ivtr_qty] end)&#13;&#10;    / SUM(if [cntr_clsf] = &apos;FC&apos; then [sal_qty] end)&#13;&#10;END' />
            </column>
            <column caption='C_재고회전일_금액 (전사)' datatype='real' name='[C_재고회전일_수량/금액 (전사)(복사본)(복사본)_2084040789215723538]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([sal_amt]) = 0 THEN 0 ELSE SUM([ivtr_amt]+[mvng_ivtr_amt]) / SUM([sal_amt]) END' />
            </column>
            <column caption='C_재고회전일_수량 (전사)' datatype='real' name='[C_재고회전일_수량/금액 (전사)(복사본)_1093811821109944398]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([sal_qty]) = 0 THEN 0 ELSE SUM([ivtr_qty]+[mvng_ivtr_qty]) / SUM([sal_qty]) END' />
            </column>
            <column caption='C_용적유형' datatype='string' name='[Calculation_1093811820766642179]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE UPPER([strg_type])&#13;&#10;WHEN &apos;COLD&apos; THEN &apos;냉장&apos;&#13;&#10;WHEN &apos;NORMAL&apos; THEN &apos;상온&apos;&#13;&#10;WHEN &apos;REFRIGERATION&apos; THEN &apos;냉동&apos;&#13;&#10;END' />
            </column>
            <column caption='C_재고수량' datatype='real' name='[Calculation_1093811820840165418]' role='measure' type='quantitative'>
