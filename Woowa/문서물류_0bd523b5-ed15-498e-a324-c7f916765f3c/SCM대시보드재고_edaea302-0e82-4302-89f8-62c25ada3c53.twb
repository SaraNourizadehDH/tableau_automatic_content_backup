            <column caption='&apos;1&apos;' datatype='string' name='[Calculation_1093811820854206527]' role='dimension' type='nominal' user:unnamed='5-1.FC별 매출_지도(구군) (2)'>
              <calculation class='tableau' formula='&apos;1&apos;' />
