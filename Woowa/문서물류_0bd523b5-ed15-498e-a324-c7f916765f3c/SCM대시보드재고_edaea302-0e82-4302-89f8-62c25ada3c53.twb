              <calculation class='tableau' formula='CASE [Parameters].[P_재고추이(복사본)_1093811820828688404]&#13;&#10;WHEN &apos;재고수량&apos; THEN [sal_qty]&#13;&#10;WHEN &apos;재고금액&apos; THEN [sal_amt]&#13;&#10;END' />
