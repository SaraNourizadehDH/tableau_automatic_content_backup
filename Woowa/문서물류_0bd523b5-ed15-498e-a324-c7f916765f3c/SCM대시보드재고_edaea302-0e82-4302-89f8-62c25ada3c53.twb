            <column caption='F_용적유형' datatype='boolean' name='[Calculation_1246371257500372993]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 16]=&apos;전체&apos;&#13;&#10;THEN TRUE&#13;&#10;ELSE [Parameters].[매개 변수 16]=[Calculation_1093811820766642179]&#13;&#10;END' />
