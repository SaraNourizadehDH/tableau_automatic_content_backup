              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; THEN &apos;`&apos; + right([year],2)+ &apos;.&apos;+ [month]&#13;&#10;WHEN &apos;주별&apos; THEN STR([week_seq]) + &apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN STR([month]) + &apos;/&apos; + STR([day])&#13;&#10;END' />
