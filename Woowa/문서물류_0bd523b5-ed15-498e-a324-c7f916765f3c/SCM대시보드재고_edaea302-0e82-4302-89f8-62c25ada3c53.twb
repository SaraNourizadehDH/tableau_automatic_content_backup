              <calculation class='tableau' formula='IF SUM(if [cntr_clsf] = &apos;DC&apos; then [stck_ship_amt] end) = 0 THEN 0&#13;&#10;ELSE SUM(if [cntr_clsf] = &apos;DC&apos; then [ivtr_amt]+[mvng_ivtr_amt] end)&#13;&#10;    / SUM(if [cntr_clsf] = &apos;DC&apos; then [stck_ship_amt] end)&#13;&#10;END' />
