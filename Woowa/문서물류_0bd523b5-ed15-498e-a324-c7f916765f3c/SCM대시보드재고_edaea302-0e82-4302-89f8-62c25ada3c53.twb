              <calculation class='tableau' formula='[ivtr_amt]' />
            </column>
            <column caption='C_재고회전일(금액)' datatype='real' name='[C_재고회전일(수량)(복사본)_2084040789216989203]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 14]&#13;&#10;WHEN &apos;전체&apos; THEN [C_재고회전일_수량/금액 (전사)(복사본)(복사본)_2084040789215723538]&#13;&#10;WHEN &apos;FC&apos; THEN [C_재고회전일_수량/금액 (FC)(복사본)(복사본)_2084040789215719441]&#13;&#10;WHEN &apos;DC&apos; THEN [C_재고회전일_수량/금액 (DC)(복사본)(복사본)_2084040789215711248]&#13;&#10;END' />
            </column>
            <column caption='C_재고회전일_금액 (DC)' datatype='real' name='[C_재고회전일_수량/금액 (DC)(복사본)(복사본)_2084040789215711248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM(if [cntr_clsf] = &apos;DC&apos; then [stck_ship_amt] end) = 0 THEN 0&#13;&#10;ELSE SUM(if [cntr_clsf] = &apos;DC&apos; then [ivtr_amt]+[mvng_ivtr_amt] end)&#13;&#10;    / SUM(if [cntr_clsf] = &apos;DC&apos; then [stck_ship_amt] end)&#13;&#10;END' />
