        <calculation class='tableau' formula='[cat4_nm]' />
      </column>
      <column caption='C_prod_sal_gd' datatype='string' name='[Calculation_1123366683048628286]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_1902770910609641494]&#13;&#10;WHEN &apos;S&apos; THEN &apos;S&apos;&#13;&#10;WHEN &apos;A&apos; THEN &apos;A&apos;&#13;&#10;ELSE &apos;그 외&apos;&#13;&#10;END' />
      </column>
      <column caption='C_시도' datatype='string' name='[Calculation_1991716991184982039]' role='dimension' semantic-role='[State].[Name]' type='nominal'>
        <calculation class='tableau' formula='CASE [sido_nm]&#13;&#10;WHEN &apos;서울특별시&apos; THEN &apos;서울&apos;&#13;&#10;WHEN &apos;인천광역시&apos; THEN &apos;인천&apos;&#13;&#10;WHEN &apos;대전광역시&apos; THEN &apos;대전&apos;&#13;&#10;WHEN &apos;울산광역시&apos; THEN &apos;울산&apos;&#13;&#10;WHEN &apos;대구광역시&apos; THEN &apos;대구&apos;&#13;&#10;WHEN &apos;부산광역시&apos; THEN &apos;부산&apos;&#13;&#10;WHEN &apos;광주광역시&apos; THEN &apos;광주&apos;&#13;&#10;WHEN &apos;경기도&apos; THEN &apos;경기&apos;&#13;&#10;WHEN &apos;강원도&apos; THEN &apos;강원&apos;&#13;&#10;WHEN &apos;충청남도&apos; THEN &apos;충남&apos;&#13;&#10;WHEN &apos;충청북도&apos; THEN &apos;충북&apos;&#13;&#10;WHEN &apos;경상남도&apos; THEN &apos;경남&apos;&#13;&#10;WHEN &apos;경상북도&apos; THEN &apos;경북&apos;&#13;&#10;WHEN &apos;전라남도&apos; THEN &apos;전남&apos;&#13;&#10;WHEN &apos;전라북도&apos; THEN &apos;전북&apos;&#13;&#10;WHEN &apos;제주특별자치도&apos; THEN &apos;제주&apos;&#13;&#10;WHEN &apos;세종특별자치시&apos; THEN &apos;세종&apos;&#13;&#10;WHEN NULL then IF [cntr_cd] = &apos;GP001&apos; THEN &apos;경기&apos; &#13;&#10;               ELSEIF [cntr_cd] = &apos;DC003&apos; THEN &apos;경북&apos; END&#13;&#10;END' />
      </column>
      <column caption='C_구군' datatype='string' name='[Calculation_1991716991185023000]' role='dimension' semantic-role='[County].[Name]' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([gugun_nm]) THEN IF [cntr_cd] = &apos;GP001&apos; THEN &apos;의왕시&apos;&#13;&#10;                           ELSEIF [cntr_cd] = &apos;DC003&apos; THEN &apos;칠곡군&apos; END&#13;&#10;ELSE [gugun_nm]&#13;&#10;END' />
      </column>
      <column caption='FC' datatype='string' name='[Calculation_2216334017747750922]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1292533150771916800]' />
