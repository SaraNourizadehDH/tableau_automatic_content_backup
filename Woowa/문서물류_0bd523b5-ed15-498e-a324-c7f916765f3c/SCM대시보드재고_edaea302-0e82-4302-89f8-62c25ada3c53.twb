            <column caption='C_prod_sal_gd' datatype='string' name='[Calculation_1123366683048628286]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Calculation_1902770910609641494]&#13;&#10;WHEN &apos;S&apos; THEN &apos;S&apos;&#13;&#10;WHEN &apos;A&apos; THEN &apos;A&apos;&#13;&#10;ELSE &apos;그 외&apos;&#13;&#10;END' />
            </column>
            <column caption='C_cntr_nm(점제거)' datatype='string' name='[Calculation_1292533150771916800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF RIGHT(cntr_nm,1) = &apos;점&apos;&#13;&#10;THEN LEFT([cntr_nm], LEN([cntr_nm])-1)&#13;&#10;ELSE IF [cntr_nm]= &apos;의왕인천 통합물류센터&apos; THEN &apos;인천기지&apos;&#13;&#10;     ELSE [cntr_nm]&#13;&#10;     END&#13;&#10;END' />
