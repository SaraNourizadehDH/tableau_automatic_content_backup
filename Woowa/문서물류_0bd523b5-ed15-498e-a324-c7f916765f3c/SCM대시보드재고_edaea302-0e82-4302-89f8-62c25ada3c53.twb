            <column caption='F_Date_Type' datatype='boolean' name='[Calculation_153966862638411780]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-11,[Parameters].[매개 변수 2])) &lt;= [Calculation_153966862635016193] and [Calculation_153966862635016193] &lt; DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Parameters].[매개 변수 2]))&#13;&#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-7,[Parameters].[매개 변수 2])) &lt;= [Calculation_153966862635016193] and [Calculation_153966862635016193] &lt; DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,1,[Parameters].[매개 변수 2]))&#13;&#10;WHEN &apos;일별&apos; THEN [Parameters].[P_End_Date(복사본)_827255009348214784]&lt;=[Calculation_153966862635016193] and [Calculation_153966862635016193] &lt;= [Parameters].[매개 변수 2] AND (DATEADD(&apos;day&apos;, -30, [Parameters].[매개 변수 2]) &lt;= [Calculation_153966862635016193])&#13;&#10;END' />
