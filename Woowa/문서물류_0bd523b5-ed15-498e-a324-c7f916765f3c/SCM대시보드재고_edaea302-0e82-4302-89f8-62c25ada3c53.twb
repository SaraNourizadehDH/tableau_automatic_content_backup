      <column caption='*FALSE' datatype='boolean' name='[Calculation_827255010091020495]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='FALSE' />
      </column>
      <column caption='C_Date_Type' datatype='integer' name='[F_Date_Type(복사본)_153966862657732627]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; THEN [C_week(복사본)_153966862637895683]&#13;&#10;WHEN &apos;주별&apos; THEN [Calculation_153966862634762240]&#13;&#10;WHEN &apos;일별&apos; THEN [C_month(복사본)_153966862638620677]&#13;&#10;END' />
      </column>
      <column caption='LV 2' datatype='string' name='[LV 1(복사본)_1093811821107294279]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[cat2_nm]' />
