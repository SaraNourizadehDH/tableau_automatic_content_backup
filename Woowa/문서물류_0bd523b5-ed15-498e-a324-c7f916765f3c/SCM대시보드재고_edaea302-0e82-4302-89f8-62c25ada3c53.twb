      </column>
      <column caption='Text_Date_Type' datatype='string' name='[Calculation_1123366682711617552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_380835707154477058]&#13;&#10;WHEN &apos;월별&apos; THEN &apos;`&apos; + right(STR(YEAR([Parameters].[매개 변수 2])),2)+ &apos;.&apos;+ MID(str([Parameters].[매개 변수 2]),6,2)&#13;&#10;WHEN &apos;주별&apos; THEN STR(ISOWEEK([Parameters].[매개 변수 2])) + &apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN REPLACE(MID(str([Parameters].[매개 변수 2]),6,5),&apos;-&apos;,&apos;/&apos;)&#13;&#10;END' />
      </column>
      <column caption='C_날짜_일별_적용기간 (&gt;30)' datatype='string' name='[Calculation_1292533150779940866]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[P_End_Date(복사본)_827255009348214784], [Parameters].[매개 변수 2]) &gt; 30&#13;&#10;    THEN &apos;현재 적용 기간 : &apos;+ STR(DATEADD(&apos;day&apos;, -30, [Parameters].[매개 변수 2])) +&apos; ~ &apos; + STR([Parameters].[매개 변수 2])&#13;&#10;    ELSE &apos;&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='C_날짜범위경고' datatype='boolean' name='[Calculation_1292533150781136900]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;AND&#13;&#10;(DATEDIFF(&apos;day&apos;, [Parameters].[P_End_Date(복사본)_827255009348214784], [Parameters].[매개 변수 2]) &gt; 30&#13;&#10;OR&#13;&#10;[Parameters].[P_End_Date(복사본)_827255009348214784] &gt; [Parameters].[매개 변수 2])' />
