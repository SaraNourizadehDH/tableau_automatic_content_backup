    <datasource-dependencies datasource='sqlproxy.08sinqd19cter01d0wgvi04vau3h'>
      <column caption='C_용적유형' datatype='string' name='[Calculation_1093811820766642179]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE UPPER([strg_type])&#13;&#10;WHEN &apos;COLD&apos; THEN &apos;냉장&apos;&#13;&#10;WHEN &apos;NORMAL&apos; THEN &apos;상온&apos;&#13;&#10;WHEN &apos;REFRIGERATION&apos; THEN &apos;냉동&apos;&#13;&#10;END' />
