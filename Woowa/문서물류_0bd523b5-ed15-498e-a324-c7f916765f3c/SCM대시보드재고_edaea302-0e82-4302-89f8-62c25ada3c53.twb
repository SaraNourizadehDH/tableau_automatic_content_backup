              <calculation class='tableau' formula='IF SUM(if [cntr_clsf] = &apos;DC&apos; then [stck_ship_qty] end) = 0 THEN 0&#13;&#10;ELSE SUM(if [cntr_clsf] = &apos;DC&apos; then [ivtr_qty]+[mvng_ivtr_qty] end)&#13;&#10;    / SUM(if [cntr_clsf] = &apos;DC&apos; then [stck_ship_qty] end)&#13;&#10;END' />
            </column>
            <column caption='C_재고회전일_금액 (FC)' datatype='real' name='[C_재고회전일_수량/금액 (FC)(복사본)(복사본)_2084040789215719441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM(if [cntr_clsf] = &apos;FC&apos; then [sal_amt] end) = 0 THEN 0&#13;&#10;ELSE SUM(if [cntr_clsf] = &apos;FC&apos; then [ivtr_amt]+[mvng_ivtr_amt] end)&#13;&#10;    / SUM(if [cntr_clsf] = &apos;FC&apos; then [sal_amt] end)&#13;&#10;END' />
