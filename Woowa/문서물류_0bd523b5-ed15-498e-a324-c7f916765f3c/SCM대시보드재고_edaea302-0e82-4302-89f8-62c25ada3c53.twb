    <worksheet name='00.Button_날짜형식'>
      <table>
        <view>
          <datasources>
            <datasource caption='Button재고' name='Clipboard_20230209T155120' />
            <datasource caption='매개 변수' name='Parameters' />
            <datasource caption='API_04_데이터거버넌스팀_SCM대시보드_재고_01' name='sqlproxy.08sinqd19cter01d0wgvi04vau3h' />
          </datasources>
          <datasource-dependencies datasource='Clipboard_20230209T155120'>
            <column caption='*TRUE' datatype='boolean' name='[Calculation_1093811820837802023]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='TRUE' />
            </column>
            <column caption='*FALSE' datatype='boolean' name='[Calculation_1093811820837834792]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='FALSE' />
            </column>
            <column caption='T/F_Date_Type' datatype='boolean' name='[Calculation_1123366682689613825]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = [Calculation_380835707154477058]&#13;&#10;THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
            </column>
            <column caption='Text_Date_Type' datatype='string' name='[Calculation_1123366682711617552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Calculation_380835707154477058]&#13;&#10;WHEN &apos;월별&apos; THEN &apos;`&apos; + right(STR(YEAR([Parameters].[매개 변수 2])),2)+ &apos;.&apos;+ MID(str([Parameters].[매개 변수 2]),6,2)&#13;&#10;WHEN &apos;주별&apos; THEN STR(ISOWEEK([Parameters].[매개 변수 2])) + &apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN REPLACE(MID(str([Parameters].[매개 변수 2]),6,5),&apos;-&apos;,&apos;/&apos;)&#13;&#10;END' />
            </column>
            <column caption='C_종료일/기준일' datatype='string' name='[Calculation_1613696097483440148]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_380835707154477058]=&apos;일별&apos;&#13;&#10;THEN &apos;종료일&apos;&#13;&#10;ELSE &apos;기준일&apos;&#13;&#10;END' />
            </column>
            <column caption='C_Date Type' datatype='string' name='[Calculation_380835707154477058]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Number]&#13;&#10;WHEN 1 THEN &apos;월별&apos;&#13;&#10;WHEN 2 THEN &apos;주별&apos;&#13;&#10;WHEN 3 THEN &apos;일별&apos;&#13;&#10;END' />
            </column>
            <column caption='C_Start_date(일별)' datatype='date' datatype-customized='true' name='[Calculation_409546135760252932]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='ATTR(DATE(IF [Calculation_380835707154477058] = &apos;일별&apos; THEN DATEADD(&apos;day&apos;, -13, [Parameters].[매개 변수 2]) ELSE [Parameters].[P_End_Date(복사본)_827255009348214784] END))' />
