              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 14]&#13;&#10;WHEN &apos;전체&apos; THEN [C_재고회전일_수량/금액 (전사)(복사본)(복사본)_2084040789215723538]&#13;&#10;WHEN &apos;FC&apos; THEN [C_재고회전일_수량/금액 (FC)(복사본)(복사본)_2084040789215719441]&#13;&#10;WHEN &apos;DC&apos; THEN [C_재고회전일_수량/금액 (DC)(복사본)(복사본)_2084040789215711248]&#13;&#10;END' />
