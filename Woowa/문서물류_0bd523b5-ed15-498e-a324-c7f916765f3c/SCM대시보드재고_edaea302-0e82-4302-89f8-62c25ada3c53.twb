            <column caption='C_KPI_재고FC' datatype='real' default-format='*#,##0,,.0;-#,##0,,.0' name='[C_KPI_재고FC(0.0M)(복사본)_2084040789218349076]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[P_재고Category(복사본)_1093811820837126179]&#13;&#10;WHEN &apos;재고수량&apos; THEN SUM([Calculation_1093811820840165418])/countd([Calculation_153966862635016193])&#13;&#10;WHEN &apos;재고금액&apos; THEN SUM([C_재고수량(복사본)_1093811820840300587])/countd([Calculation_153966862635016193])&#13;&#10;WHEN &apos;재고회전일(수량)&apos; THEN [Calculation_2084040789215268876]&#13;&#10;WHEN &apos;재고회전일(금액)&apos; THEN [C_재고회전일(수량)(복사본)_2084040789216989203]&#13;&#10;END' />
