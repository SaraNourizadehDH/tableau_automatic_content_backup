      </column>
      <column caption='*TRUE' datatype='boolean' name='[Calculation_1613696097471070218]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRUE' />
      </column>
      <column caption='C_Date_Type' datatype='string' name='[F_Date_Type(복사본)_153966862657732627]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; THEN &apos;`&apos; + right([year],2)+ &apos;.&apos;+ [month]&#13;&#10;WHEN &apos;주별&apos; THEN STR([week_seq]) + &apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN STR([month]) + &apos;/&apos; + STR([day])&#13;&#10;END' />
      </column>
      <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[cntr_nm]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
