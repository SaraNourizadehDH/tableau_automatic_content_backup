            <column caption='C_Date_Type_Label(휴일포함)' datatype='string' name='[C_Date_Type(복사본)_1123366682773549087]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; THEN &apos;`&apos; + right([year],2)+ &apos;.&apos;+ [month]&#13;&#10;WHEN &apos;주별&apos; THEN [week_seq] + &apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN IF [weekday_nm] IN (&apos;토&apos;,&apos;일&apos;) THEN [month] + &apos;/&apos; + [day] + char(10)&#13;&#10;                                                    + IF [holiday_yn]=&apos;1&apos; THEN &apos;(&apos;+[weekday_nm]+&apos;)&apos; + char(10) + [Calculation_1902770910199037966]&#13;&#10;                                                      ELSE &apos;(&apos;+[weekday_nm]+&apos;)&apos; + char(10)&#13;&#10;                                                      END + char(10)&#13;&#10;                ELSE [month] + &apos;/&apos; + [day] + char(10) +&#13;&#10;                     IF [holiday_yn]=&apos;1&apos; THEN &apos;(&apos;+[weekday_nm]+&apos;)&apos; + char(10) + [Calculation_1902770910199037966]&#13;&#10;                                                      ELSE char(10)&#13;&#10;                                                      END + char(10)&#13;&#10;                END&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='C_KPI_재고(0.0)' datatype='real' default-format='*#,##0.0;-#,##0.0' name='[C_KPI_재고(복사본)_1093811821110255695]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[P_재고FC(복사본)_1093811821112287314]&#13;&#10;WHEN &apos;재고금액&apos; THEN SUM([C_재고수량(복사본)_1093811820840300587])/1000000/countd([Calculation_153966862635016193])&#13;&#10;WHEN &apos;재고회전일(수량)&apos; THEN [Calculation_2084040789215268876]&#13;&#10;WHEN &apos;재고회전일(금액)&apos; THEN [C_재고회전일(수량)(복사본)_2084040789216989203]&#13;&#10;END' />
