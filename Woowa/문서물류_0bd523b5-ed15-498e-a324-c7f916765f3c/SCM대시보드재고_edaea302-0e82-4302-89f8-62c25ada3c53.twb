            <column caption='F_센터구분' datatype='boolean' name='[Calculation_2084040789231443995]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 14]&#13;&#10;WHEN &apos;전체&apos; THEN TRUE&#13;&#10;WHEN &apos;FC&apos; THEN [cntr_clsf] = &apos;FC&apos;&#13;&#10;WHEN &apos;DC&apos; THEN [cntr_clsf] = &apos;DC&apos;&#13;&#10;END' />
            </column>
            <column caption='FC' datatype='string' name='[Calculation_2216334017747750922]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1292533150771916800]' />
