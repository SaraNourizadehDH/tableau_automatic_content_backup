    <connection access_mode='readonly' author-locale='en_US' class='hyper' dbname='extract/ff/2b/{01959A3B-1FEA-45B4-9182-89CF3B829594}/1_전사KPI_NEW_커머스_Overview.hyper' extract-engine='true' schema='Extract' sslmode='' tablename='Extract' update-time='07/08/2024 12:03:13 AM'>
      <_.fcp.ObjectModelEncapsulateLegacy.false...relation name='Extract' table='[Extract].[Extract]' type='table' />
