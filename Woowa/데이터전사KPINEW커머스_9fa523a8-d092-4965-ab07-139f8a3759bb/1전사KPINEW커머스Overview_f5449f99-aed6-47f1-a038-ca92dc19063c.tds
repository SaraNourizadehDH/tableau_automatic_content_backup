    <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.0b9w7cr16qcpu3145blon0ylqsqy' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[WITH
  comm_svc_type
    AS (
    SELECT *
    FROM  (
            VALUES
           ('S01010201', 'B2C커머스', '배달커머스', 'B마트'),
           ('S01010202', 'B2C커머스', '배달커머스', '배민스토어'),
           ('S01010203', 'B2C커머스', '기타커머스', '전국별미'),
           ('S01010204', 'B2B커머스', '기타커머스', '배민상회'),
           ('S01010205', 'B2C커머스', '기타커머스', '배민쇼핑라이브'),
           ('S01010206', 'B2C커머스', '기타커머스', '대용량특가')) AS t (svc_cd, comm_svc_div_lv1_nm, comm_svc_div_lv2_nm, svc_nm)
    ),  

  ord_fact -- 주문 집계
    AS (
    -- 서비스별 일별 집계
    SELECT DATE(t1.base_dt) AS base_dt
         , 'D' AS base_dt_type
         , t2.comm_svc_div_lv1_nm AS comm_svc_div_lv1_nm
         , CASE WHEN t2.comm_svc_div_lv1_nm = 'B2B커머스' THEN t2.comm_svc_div_lv1_nm 
           ELSE t2.comm_svc_div_lv2_nm END AS comm_svc_div_lv2_nm
         , SUM(t1.ord_cnt)  AS ord_cnt
         , SUM(t1.gpv)      AS gpv
         , SUM(t1.seller_funded_cpn_amt + t1.seller_funded_discount_amt + t1.woowa_funded_cpn_amt + t1.woowa_funded_discount_amt) AS customer_benefit_amt
         
    FROM   cl_epm.order_dd_fact t1
           LEFT JOIN comm_svc_type t2 ON t1.svc_cd = t2.svc_cd
    WHERE  t1.base_dt >>=  CAST(DATE(NOW() + interval '9' hour) - interval '30' day AS VARCHAR)
    AND    t1.base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    
    AND    SUBSTR(t1.svc_cd, 1, 7) = 'S010102'
    
    GROUP BY 1, 3, 4
    
    UNION ALL
    -- 서비스별 주별 집계
    SELECT DATE_TRUNC('week', DATE(t1.base_dt)) AS base_dt
         , 'W' AS base_dt_type
         , t2.comm_svc_div_lv1_nm AS comm_svc_div_lv1_nm
         , CASE WHEN t2.comm_svc_div_lv1_nm = 'B2B커머스' THEN t2.comm_svc_div_lv1_nm 
           ELSE t2.comm_svc_div_lv2_nm END AS comm_svc_div_lv2_nm
         , SUM(t1.ord_cnt)  AS ord_cnt
         , SUM(t1.gpv)      AS gpv
         , SUM(t1.seller_funded_cpn_amt + t1.seller_funded_discount_amt + t1.woowa_funded_cpn_amt + t1.woowa_funded_discount_amt) AS customer_benefit_amt
         
    FROM   cl_epm.order_dd_fact t1
           LEFT JOIN comm_svc_type t2 ON t1.svc_cd = t2.svc_cd
    WHERE ((       t1.base_dt >>= CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '8' day) AS VARCHAR)
            AND    t1.base_dt  << CAST(DATE(NOW() + interval '9' hour) - interval '7' day AS VARCHAR)
          )
    OR    (        t1.base_dt >>= CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '1' day) AS VARCHAR)
            AND    t1.base_dt  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
          ))  
    AND    SUBSTR(t1.svc_cd, 1, 7) = 'S010102'
    
    GROUP BY 1, 3, 4
    
    UNION ALL
    -- 서비스별 월별 집계    
    SELECT DATE_TRUNC('month', DATE(base_dt)) AS base_dt
         , 'M' AS base_dt_type
         , t2.comm_svc_div_lv1_nm AS comm_svc_div_lv1_nm
         , CASE WHEN t2.comm_svc_div_lv1_nm = 'B2B커머스' THEN t2.comm_svc_div_lv1_nm 
           ELSE t2.comm_svc_div_lv2_nm END AS comm_svc_div_lv2_nm
         , SUM(t1.ord_cnt)  AS ord_cnt
         , SUM(t1.gpv)      AS gpv
         , SUM(t1.seller_funded_cpn_amt + t1.seller_funded_discount_amt + t1.woowa_funded_cpn_amt + t1.woowa_funded_discount_amt) AS customer_benefit_amt
         
    FROM   cl_epm.order_dd_fact t1
           LEFT JOIN comm_svc_type t2 ON t1.svc_cd = t2.svc_cd
    WHERE ((       t1.base_dt >>= CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day - interval '1' month) AS VARCHAR)
            AND    t1.base_dt  << CAST(DATE(NOW() + interval '9' hour) - interval '1' month AS VARCHAR)
          )
    OR    (        t1.base_dt >>= CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day) AS VARCHAR)
            AND    t1.base_dt  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
          )) 
    AND    SUBSTR(t1.svc_cd, 1, 7) = 'S010102'
    
    GROUP BY 1, 3, 4
    
    UNION ALL
    -- 커머스 일별 집계    
    SELECT DATE(base_dt) AS base_dt
         , 'D' AS base_dt_type
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm         
         , SUM(ord_cnt) AS ord_cnt
         , SUM(gpv)     AS gpv
         , SUM(seller_funded_cpn_amt + seller_funded_discount_amt + woowa_funded_cpn_amt + woowa_funded_discount_amt) AS customer_benefit_amt
         
    FROM   cl_epm.order_dd_fact
    WHERE  base_dt >>=  CAST(DATE(NOW() + interval '9' hour) - interval '30' day AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    
    GROUP BY 1
    
    UNION ALL
    -- 커머스 주별 집계
    SELECT DATE_TRUNC('week', DATE(base_dt)) AS base_dt
         , 'W' AS base_dt_type
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_cnt) AS ord_cnt
         , SUM(gpv)     AS gpv
         , SUM(seller_funded_cpn_amt + seller_funded_discount_amt + woowa_funded_cpn_amt + woowa_funded_discount_amt) AS customer_benefit_amt
         
    FROM   cl_epm.order_dd_fact
    WHERE (        base_dt >>= CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '8' day) AS VARCHAR)
            AND    base_dt  << CAST(DATE(NOW() + interval '9' hour) - interval '7' day AS VARCHAR)
          )
    OR    (        base_dt >>= CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '1' day) AS VARCHAR)
            AND    base_dt  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
          )  
    
    GROUP BY 1
    
    UNION ALL
    -- 커머스 월별 집계
    SELECT DATE_TRUNC('month', DATE(base_dt)) AS base_dt
         , 'M' AS base_dt_type
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_cnt) AS ord_cnt
         , SUM(gpv)     AS gpv
         , SUM(seller_funded_cpn_amt + seller_funded_discount_amt + woowa_funded_cpn_amt + woowa_funded_discount_amt) AS customer_benefit_amt
         
    FROM   cl_epm.order_dd_fact
    WHERE (        base_dt >>= CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day - interval '1' month) AS VARCHAR)
            AND    base_dt  << CAST(DATE(NOW() + interval '9' hour) - interval '1' month AS VARCHAR)
          )
    OR    (        base_dt >>= CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day) AS VARCHAR)
            AND    base_dt  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
          )  
    
    GROUP BY 1
    ),

  ord_mem_fact -- 주문회원 집계 
    AS (
    -- 서비스별 일별 집계
    SELECT DATE(base_dt) AS base_dt
         , 'D' AS base_dt_type
         , 'B2C커머스'  AS comm_svc_div_lv1_nm
         , '배달커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_dd_fact
    WHERE  base_dt >>=  CAST(DATE(NOW() + interval '9' hour) - interval '30' day AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_bmr_ord_mem + is_bms_ord_mem >>= 1
    
    GROUP BY 1
    
    UNION ALL
    SELECT DATE(base_dt) AS base_dt
         , 'D' AS base_dt_type
         , 'B2C커머스'  AS comm_svc_div_lv1_nm
         , '기타커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_dd_fact
    WHERE  base_dt >>=  CAST(DATE(NOW() + interval '9' hour) - interval '30' day AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_directfm_ord + is_hypmrkt_ord  + is_bsl_ord >>= 1
    
    GROUP BY 1

    UNION ALL
    SELECT DATE(base_dt) AS base_dt
         , 'D' AS base_dt_type
         , 'B2B커머스' AS comm_svc_div_lv1_nm
         , 'B2B커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_dd_fact
    WHERE  base_dt >>=  CAST(DATE(NOW() + interval '9' hour) - interval '30' day AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_brs_ord >>= 1
    
    GROUP BY 1
    
    UNION ALL
    -- 서비스별 주별 집계
    SELECT DATE(base_dt) AS base_dt
         , 'W' AS base_dt_type
         , 'B2C커머스'  AS comm_svc_div_lv1_nm
         , '배달커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt         
    FROM   cl_epm.order_member_count_ww_fact
    WHERE  base_dt >>=  CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '8' day) AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_bmr_ord_mem + is_bms_ord_mem >>= 1
    
    GROUP BY 1
  
    UNION ALL
    SELECT DATE(base_dt) AS base_dt
         , 'W' AS base_dt_type
         , 'B2C커머스'  AS comm_svc_div_lv1_nm
         , '기타커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_ww_fact
    WHERE  base_dt >>=  CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '8' day) AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_directfm_ord + is_hypmrkt_ord  + is_bsl_ord >>= 1
    
    GROUP BY 1    

    UNION ALL
    SELECT DATE(base_dt) AS base_dt
         , 'W' AS base_dt_type
         , 'B2B커머스' AS comm_svc_div_lv1_nm
         , 'B2B커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_ww_fact
    WHERE  base_dt >>=  CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '8' day) AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_brs_ord >>= 1
    
    GROUP BY 1
    
    UNION ALL
    -- 서비스별 월별 집계
    SELECT DATE(base_dt) AS base_dt
         , 'M' AS base_dt_type
         , 'B2C커머스'  AS comm_svc_div_lv1_nm
         , '배달커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_mm_fact
    WHERE  base_dt >>=  CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day - interval '1' month) AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_bmr_ord_mem + is_bms_ord_mem >>= 1
    
    GROUP BY 1
  
    UNION ALL
    SELECT DATE(base_dt) AS base_dt
         , 'M' AS base_dt_type
         , 'B2C커머스'  AS comm_svc_div_lv1_nm
         , '기타커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_mm_fact
    WHERE  base_dt >>=  CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day - interval '1' month) AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_directfm_ord + is_hypmrkt_ord  + is_bsl_ord >>= 1
    
    GROUP BY 1

    UNION ALL
    SELECT DATE(base_dt) AS base_dt
         , 'M' AS base_dt_type
         , 'B2B커머스' AS comm_svc_div_lv1_nm
         , 'B2B커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_mm_fact
    WHERE  base_dt >>=  CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day - interval '1' month) AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_brs_ord >>= 1
    
    GROUP BY 1
    
    UNION ALL
    -- 커머스 일별 집계
    SELECT DATE(base_dt) AS base_dt
         , 'D' AS base_dt_type
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_dd_fact
    WHERE  base_dt >>=  CAST(DATE(NOW() + interval '9' hour) - interval '30' day AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_bmr_ord_mem + is_bms_ord_mem + is_directfm_ord + is_brs_ord + is_hypmrkt_ord  + is_bsl_ord >>= 1
    
    GROUP BY 1
    
    UNION ALL
    -- 커머스 주별 집계
    SELECT DATE(base_dt) AS base_dt
         , 'W' AS base_dt_type
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_ww_fact
    WHERE  base_dt >>=  CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '8' day) AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_bmr_ord_mem + is_bms_ord_mem + is_directfm_ord + is_brs_ord + is_hypmrkt_ord  + is_bsl_ord >>= 1
    
    GROUP BY 1    

    UNION ALL
    -- 커머스 월별 집계
    SELECT DATE(base_dt) AS base_dt
         , 'M' AS base_dt_type
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_mm_fact
    WHERE  base_dt >>=  CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day - interval '1' month) AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_bmr_ord_mem + is_bms_ord_mem + is_directfm_ord + is_brs_ord + is_hypmrkt_ord  + is_bsl_ord >>= 1
    
    GROUP BY 1
    ),

  od_avg_dlvry_time_fact -- od 평균 배달시간 집계
    AS (
    -- 커머스 일별 집계
    SELECT DATE(dm.part_date) AS base_dt
         , 'D' AS base_dt_type
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm
         , AVG(dm.delivery_time_minute) AS od_avg_dlvry_time
    FROM   delivery_mart.delivery_master dm
    WHERE  dm.part_date >>=  CAST(DATE(NOW() + interval '9' hour) - interval '30' day AS VARCHAR)
    AND    dm.part_date  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    
    AND    dm.delivery_type = 'OD'
    AND    dm.is_test = 0
    AND    dm.is_closed = 1
    AND    dm.rider_type in ('CROWDSOURCING', 'INDIVIDUAL_OWNER')
    AND    dm.rider_delivery_fee >> 0 
    AND    dm.delivery_order = 1
    AND    dm.agency != 'DH'
    AND    dm.part_svc IN ('BMART', 'BAEMIN_STORE')
    
    GROUP BY 1
    
    UNION ALL
    -- 커머스 주별 집계    
    SELECT DATE_TRUNC('week', DATE(dm.part_date)) AS base_dt
         , 'W' AS base_dt_type
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm
         , AVG(dm.delivery_time_minute) AS od_avg_dlvry_time
    FROM   delivery_mart.delivery_master dm
    WHERE ((        dm.part_date >>= CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '8' day) AS VARCHAR)
             AND    dm.part_date  << CAST(DATE(NOW() + interval '9' hour) - interval '7' day AS VARCHAR)
          )
     OR    (        dm.part_date >>= CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '1' day) AS VARCHAR)
             AND    dm.part_date  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
          ))  
    
    AND    dm.delivery_type = 'OD'
    AND    dm.is_test = 0
    AND    dm.is_closed = 1
    AND    dm.rider_type in ('CROWDSOURCING', 'INDIVIDUAL_OWNER')
    AND    dm.rider_delivery_fee >> 0 
    AND    dm.delivery_order = 1
    AND    dm.agency != 'DH'
    AND    dm.part_svc IN ('BMART', 'BAEMIN_STORE')
    
    GROUP BY 1
    
    UNION ALL
    -- 커머스 월별 집계    
    SELECT DATE_TRUNC('month', DATE(dm.part_date)) AS base_dt
         , 'M' AS base_dt_type
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm
         , AVG(dm.delivery_time_minute) AS od_avg_dlvry_time
    FROM   delivery_mart.delivery_master dm
    WHERE ((        dm.part_date >>= CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day - interval '1' month) AS VARCHAR)
             AND    dm.part_date  << CAST(DATE(NOW() + interval '9' hour) - interval '1' month AS VARCHAR)
          )
     OR    (        dm.part_date >>= CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day) AS VARCHAR)
             AND    dm.part_date  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
          )) 
    
    AND    dm.delivery_type = 'OD'
    AND    dm.is_test = 0
    AND    dm.is_closed = 1
    AND    dm.rider_type in ('CROWDSOURCING', 'INDIVIDUAL_OWNER')
    AND    dm.rider_delivery_fee >> 0 
    AND    dm.delivery_order = 1
    AND    dm.agency != 'DH'
    AND    dm.part_svc IN ('BMART', 'BAEMIN_STORE')
    
    GROUP BY 1
    ),

  comm_seller
    AS (
      WITH
        bmart
          AS (
          SELECT part_date AS base_dt
               , 'S01010201' AS svc_cd
               , shop_id     AS seller_id
               , now() AS created_at
          FROM   market_bi.market_order_master
          WHERE  part_date >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month))) AS VARCHAR)
          AND    part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
          AND    is_test_order = 0
          AND    is_closed = 1
          AND    is_return = 0
          GROUP BY part_date
                 , shop_id),
      
        seller_status
          AS (
          SELECT branch_id
               , final_open_yn
               , base_dt AS status_from_dt
               , COALESCE(CAST(DATE(LEAD(base_dt) OVER (PARTITION BY branch_id ORDER BY base_dt ASC))  - interval '1' day AS VARCHAR), '9999-12-31') AS status_to_dt
          FROM (
                   SELECT DISTINCT
                          base_dt
                        , branch_id
                        , FIRST_VALUE(open_yn) OVER (PARTITION BY base_dt, branch_id ORDER BY updated_at DESC) AS final_open_yn
                   FROM  (
                             SELECT DISTINCT
                                    CAST(DATE(sa.updated_at + interval '9' hour) AS VARCHAR) AS base_dt
                                  , sa.updated_at
                                  , sa.id AS branch_id
                                  , IF(aml_status IN ('CDD_CONFIRMED', 'EDD_CONFIRMED') AND open_status = 'OPEN' AND enter_status = 'COMPLETED', 1, 0) AS open_yn
                             FROM   cmplf_seller.seller_audit sa
                             WHERE  DATE(sa.updated_at + interval '9' hour) >>= DATE'2023-02-14'
                             AND  store_type != 'HEADQUARTER'
                             UNION ALL
                             SELECT CAST(DATE(created_at + interval '9' hour) AS VARCHAR) AS base_dt
                                  , created_at AS updated_at
                                  , id AS branch_id
                                  , 1 AS open_yn
                             FROM   cmplf_seller.seller
                             WHERE  DATE(created_at + interval '9' hour) << DATE'2023-02-14'
                             AND  store_type != 'HEADQUARTER'
                             UNION ALL
                             SELECT CAST(DATE(updated_at + interval '9' hour) AS VARCHAR) AS base_dt
                                  , updated_at
                                  , id AS branch_id
                                  , IF(aml_status IN ('CDD_CONFIRMED', 'EDD_CONFIRMED') AND open_status = 'OPEN' AND enter_status = 'COMPLETED', 1, 0) AS open_yn
                             FROM   cmplf_seller.seller
                             WHERE  DATE(updated_at + interval '9' hour) << DATE'2023-02-14'
                             AND  store_type != 'HEADQUARTER'
                         ))),
      
        seller_status_history
          AS (
          SELECT DISTINCT
                 CAST(d.base_dt AS VARCHAR) AS base_dt
               , s.branch_id
               , s.final_open_yn
          FROM   cl_common.date_master d
                 JOIN seller_status s
                 ON CAST(d.base_dt AS VARCHAR) >>= s.status_from_dt
                 AND CAST(d.base_dt AS VARCHAR) <<= s.status_to_dt),
      
        store_fr_gen
          AS (
          SELECT ssh.base_dt
               , 'S01010202' AS svc_cd
               , s.headquarter_id AS seller_id
               , now() AS created_at
          FROM (
                SELECT DISTINCT
                       base_dt AS base_dt
                     , branch_id
                FROM   seller_status_history
                WHERE  base_dt >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month))) AS VARCHAR)
                AND  base_dt << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                AND  final_open_yn = 1
               ) ssh
      
               JOIN cmplf_seller.seller s
               ON ssh.branch_id = s.id
      
               JOIN dsdw.commerce_seller_master sm
               ON ssh.branch_id = sm.branch_id
               AND sm.is_test = 0
      
          GROUP BY ssh.base_dt
                 , s.headquarter_id),
      
        store_fc
          AS (
          SELECT om.part_date AS base_dt
               , 'S01010202' AS svc_cd
               , hfss.settlement_target_id AS seller_id
               , now() AS created_at
          FROM   dsdw.commerce_order_master om
                 JOIN cmplf_order.order_product op
                 ON om.ord_no = op.order_no
      
                 JOIN cmplf_product.health_food_seller_settlement hfss
                 ON hfss.product_id = op.product_id
      
                 JOIN cmplf_seller.seller s
                 ON hfss.settlement_target_id = s.id
      
          WHERE  om.is_closed = 1
          AND    om.is_return = 0
          AND    om.is_test_order = 0
          AND    om.part_date >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month))) AS VARCHAR)
          AND    om.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
      
          GROUP BY om.part_date
                 , hfss.settlement_target_id),
      
        directfm
          AS (
          SELECT s.part_date AS base_dt
               , 'S01010203' AS svc_cd
               , s.seller_id
               , now() AS created_at
          FROM  (
                 SELECT DISTINCT
                        s.part_date
                      , s.seller_id
                 FROM   dsdw.directfm_seller_master_snap_daily s
                 WHERE  s.seller_status = 'ACTIVE'
                 AND    s.is_test = 0
                 AND    s.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month))) AS VARCHAR)
                 AND    s.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                ) s

      
          GROUP BY s.part_date
                 , s.seller_id),
      
        brs
          AS (
          SELECT s.part_date AS base_dt
               , 'S01010204' AS svc_cd
               , s.seller_id
               , now() AS created_at
          FROM   (
                  SELECT DISTINCT
                         s.part_date
                       , s.seller_id
                  FROM   bmmart_mart.display_product_master_snap_daily s
                  WHERE  s.mall_type = 'MART'
                  AND    s.is_disp = 1
                  AND    s.is_del = 0
                  AND    s.is_test = 0
                  AND    s.is_disabled = 0
      
                  AND    s.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month))) AS VARCHAR)
                  AND    s.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                ) s
      
          GROUP BY s.part_date
                 , s.seller_id),
      
        hypmrkt
          AS (
          SELECT s.part_date AS base_dt
               , 'S01010206' AS svc_cd
               , s.seller_id
               , now() AS created_at
          FROM   (
                  SELECT DISTINCT
                         s.part_date
                       , s.seller_id
                  FROM   bmmart_mart.display_product_master_snap_daily s
                  WHERE  s.mall_type = 'HYPER_MARKET'
                  AND    s.is_disp = 1
                  AND    s.is_del = 0
                  AND    s.is_test = 0
                  AND    s.is_disabled = 0
      
                  AND    s.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month))) AS VARCHAR)
                  AND    s.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                ) s
      
          GROUP BY s.part_date
                 , s.seller_id)
                 
    SELECT seller_id
         , base_dt
         , svc_cd
    FROM bmart
    UNION ALL
    SELECT seller_id
         , base_dt
         , svc_cd
    FROM store_fr_gen
    UNION ALL
    SELECT seller_id
         , base_dt
         , svc_cd
    FROM store_fc
    UNION ALL
    SELECT seller_id
         , base_dt
         , svc_cd
    FROM directfm
    UNION ALL
    SELECT seller_id
         , base_dt
         , svc_cd
    FROM brs
    UNION ALL
    SELECT seller_id
         , base_dt
         , svc_cd
    FROM hypmrkt
    ),

    comm_seller_fact
      AS (
      SELECT DATE(t1.base_dt) AS base_dt
           , 'D' AS base_dt_type
           , t2.comm_svc_div_lv1_nm AS comm_svc_div_lv1_nm
           , CASE WHEN t2.comm_svc_div_lv1_nm = 'B2B커머스' THEN t2.comm_svc_div_lv1_nm 
             ELSE t2.comm_svc_div_lv2_nm END AS comm_svc_div_lv2_nm          
           , COUNT(DISTINCT (t1.svc_cd, t1.seller_id)) AS seller_cnt
      FROM   comm_seller t1
             LEFT JOIN comm_svc_type t2 ON t1.svc_cd = t2.svc_cd
      WHERE  t1.base_dt >>=  CAST(DATE(NOW() + interval '9' hour) - interval '30' day AS VARCHAR)
      AND    t1.base_dt <<=  CAST(DATE(NOW() + interval '9' hour) - interval '1' day AS VARCHAR)
      GROUP BY 1, 3, 4
      
      UNION ALL
      SELECT DATE_TRUNC('week', DATE(t1.base_dt)) AS base_dt
           , 'W' AS base_dt_type
           , t2.comm_svc_div_lv1_nm AS comm_svc_div_lv1_nm
           , CASE WHEN t2.comm_svc_div_lv1_nm = 'B2B커머스' THEN t2.comm_svc_div_lv1_nm 
             ELSE t2.comm_svc_div_lv2_nm END AS comm_svc_div_lv2_nm          
           , COUNT(DISTINCT (t1.svc_cd, t1.seller_id)) AS seller_cnt
      FROM   comm_seller t1
             LEFT JOIN comm_svc_type t2 ON t1.svc_cd = t2.svc_cd
      WHERE  t1.base_dt  >>=  CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '1' day) - interval '7' day AS VARCHAR)
      AND    t1.base_dt  <<=  CAST(DATE(NOW() + interval '9' hour) - interval '1' day AS VARCHAR)
      GROUP BY 1, 3, 4
      
      UNION ALL
      SELECT DATE_TRUNC('month', DATE(t1.base_dt)) AS base_dt
           , 'M' AS base_dt_type
           , t2.comm_svc_div_lv1_nm AS comm_svc_div_lv1_nm
           , CASE WHEN t2.comm_svc_div_lv1_nm = 'B2B커머스' THEN t2.comm_svc_div_lv1_nm 
             ELSE t2.comm_svc_div_lv2_nm END AS comm_svc_div_lv2_nm          
           , COUNT(DISTINCT (t1.svc_cd, t1.seller_id)) AS seller_cnt
      FROM   comm_seller t1
             LEFT JOIN comm_svc_type t2 ON t1.svc_cd = t2.svc_cd
      WHERE  t1.base_dt  >>=  CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day) - interval '1' month AS VARCHAR)
      AND    t1.base_dt  <<=  CAST(DATE(NOW() + interval '9' hour) - interval '1' day AS VARCHAR)
      GROUP BY 1, 3, 4
    ),
    
  seller_fact
    AS (
    -- 서비스별 집계
    SELECT *
    FROM   comm_seller_fact
    
    -- 커머스 집계
    UNION ALL
    SELECT base_dt
         , base_dt_type
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm
         , SUM(seller_cnt) AS seller_cnt
    FROM   comm_seller_fact
    GROUP BY 1, 2
    )    

    
SELECT t1.base_dt  -- 기준일자 (큰 값이 당기일자, 작은값이 전기일자)
     , t1.base_dt_type -- 기준일자 유형 ('D', 'W': 주 시작일, 'M': 월 시작일)
     , t1.comm_svc_div_lv1_nm -- 커머스 서비스 구분 1 레벨 (커머스, B2C커머스, B2B커머스)
     , t1.comm_svc_div_lv2_nm -- 커머스 서비스 구분 2 레벨 (커머스, B2B커머스, 배달, 기타)   ** 커머스 서비스 구분 1레벨 중 <<B2C 커머스>>만 배달과 기타로 나누어집니다.
     , t1.ord_cnt -- 주문수
     , t1.gpv -- gpv
     , t1.customer_benefit_amt -- 고객혜택금액
     , t2.ord_mem_cnt -- 주문회원수
     , t4.seller_cnt -- 판매자수
     , t3.od_avg_dlvry_time -- OD 평균 배달시간

FROM   ord_fact t1
       LEFT JOIN ord_mem_fact t2
       ON t1.base_dt = t2.base_dt
       AND t1.base_dt_type = t2.base_dt_type
       AND t1.comm_svc_div_lv1_nm = t2.comm_svc_div_lv1_nm
       AND t1.comm_svc_div_lv2_nm = t2.comm_svc_div_lv2_nm
       
       LEFT JOIN od_avg_dlvry_time_fact t3
       ON t1.base_dt = t3.base_dt
       AND t1.base_dt_type = t3.base_dt_type
       AND t1.comm_svc_div_lv1_nm = t3.comm_svc_div_lv1_nm
       AND t1.comm_svc_div_lv2_nm = t3.comm_svc_div_lv2_nm       
       
       LEFT JOIN seller_fact t4
       ON t1.base_dt = t4.base_dt
       AND t1.base_dt_type = t4.base_dt_type
       AND t1.comm_svc_div_lv1_nm = t4.comm_svc_div_lv1_nm
       AND t1.comm_svc_div_lv2_nm = t4.comm_svc_div_lv2_nm]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
    <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='athena.0b9w7cr16qcpu3145blon0ylqsqy' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[WITH
  comm_svc_type
    AS (
    SELECT *
    FROM  (
            VALUES
           ('S01010201', 'B2C커머스', '배달커머스', 'B마트'),
           ('S01010202', 'B2C커머스', '배달커머스', '배민스토어'),
           ('S01010203', 'B2C커머스', '기타커머스', '전국별미'),
           ('S01010204', 'B2B커머스', '기타커머스', '배민상회'),
           ('S01010205', 'B2C커머스', '기타커머스', '배민쇼핑라이브'),
           ('S01010206', 'B2C커머스', '기타커머스', '대용량특가')) AS t (svc_cd, comm_svc_div_lv1_nm, comm_svc_div_lv2_nm, svc_nm)
    ),  

  ord_fact -- 주문 집계
    AS (
    -- 서비스별 일별 집계
    SELECT DATE(t1.base_dt) AS base_dt
         , 'D' AS base_dt_type
         , t2.comm_svc_div_lv1_nm AS comm_svc_div_lv1_nm
         , CASE WHEN t2.comm_svc_div_lv1_nm = 'B2B커머스' THEN t2.comm_svc_div_lv1_nm 
           ELSE t2.comm_svc_div_lv2_nm END AS comm_svc_div_lv2_nm
         , SUM(t1.ord_cnt)  AS ord_cnt
         , SUM(t1.gpv)      AS gpv
         , SUM(t1.seller_funded_cpn_amt + t1.seller_funded_discount_amt + t1.woowa_funded_cpn_amt + t1.woowa_funded_discount_amt) AS customer_benefit_amt
         
    FROM   cl_epm.order_dd_fact t1
           LEFT JOIN comm_svc_type t2 ON t1.svc_cd = t2.svc_cd
    WHERE  t1.base_dt >>=  CAST(DATE(NOW() + interval '9' hour) - interval '30' day AS VARCHAR)
    AND    t1.base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    
    AND    SUBSTR(t1.svc_cd, 1, 7) = 'S010102'
    
    GROUP BY 1, 3, 4
    
    UNION ALL
    -- 서비스별 주별 집계
    SELECT DATE_TRUNC('week', DATE(t1.base_dt)) AS base_dt
         , 'W' AS base_dt_type
         , t2.comm_svc_div_lv1_nm AS comm_svc_div_lv1_nm
         , CASE WHEN t2.comm_svc_div_lv1_nm = 'B2B커머스' THEN t2.comm_svc_div_lv1_nm 
           ELSE t2.comm_svc_div_lv2_nm END AS comm_svc_div_lv2_nm
         , SUM(t1.ord_cnt)  AS ord_cnt
         , SUM(t1.gpv)      AS gpv
         , SUM(t1.seller_funded_cpn_amt + t1.seller_funded_discount_amt + t1.woowa_funded_cpn_amt + t1.woowa_funded_discount_amt) AS customer_benefit_amt
         
    FROM   cl_epm.order_dd_fact t1
           LEFT JOIN comm_svc_type t2 ON t1.svc_cd = t2.svc_cd
    WHERE ((       t1.base_dt >>= CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '8' day) AS VARCHAR)
            AND    t1.base_dt  << CAST(DATE(NOW() + interval '9' hour) - interval '7' day AS VARCHAR)
          )
    OR    (        t1.base_dt >>= CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '1' day) AS VARCHAR)
            AND    t1.base_dt  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
          ))  
    AND    SUBSTR(t1.svc_cd, 1, 7) = 'S010102'
    
    GROUP BY 1, 3, 4
    
    UNION ALL
    -- 서비스별 월별 집계    
    SELECT DATE_TRUNC('month', DATE(base_dt)) AS base_dt
         , 'M' AS base_dt_type
         , t2.comm_svc_div_lv1_nm AS comm_svc_div_lv1_nm
         , CASE WHEN t2.comm_svc_div_lv1_nm = 'B2B커머스' THEN t2.comm_svc_div_lv1_nm 
           ELSE t2.comm_svc_div_lv2_nm END AS comm_svc_div_lv2_nm
         , SUM(t1.ord_cnt)  AS ord_cnt
         , SUM(t1.gpv)      AS gpv
         , SUM(t1.seller_funded_cpn_amt + t1.seller_funded_discount_amt + t1.woowa_funded_cpn_amt + t1.woowa_funded_discount_amt) AS customer_benefit_amt
         
    FROM   cl_epm.order_dd_fact t1
           LEFT JOIN comm_svc_type t2 ON t1.svc_cd = t2.svc_cd
    WHERE ((       t1.base_dt >>= CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day - interval '1' month) AS VARCHAR)
            AND    t1.base_dt  << CAST(DATE(NOW() + interval '9' hour) - interval '1' month AS VARCHAR)
          )
    OR    (        t1.base_dt >>= CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day) AS VARCHAR)
            AND    t1.base_dt  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
          )) 
    AND    SUBSTR(t1.svc_cd, 1, 7) = 'S010102'
    
    GROUP BY 1, 3, 4
    
    UNION ALL
    -- 커머스 일별 집계    
    SELECT DATE(base_dt) AS base_dt
         , 'D' AS base_dt_type
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm         
         , SUM(ord_cnt) AS ord_cnt
         , SUM(gpv)     AS gpv
         , SUM(seller_funded_cpn_amt + seller_funded_discount_amt + woowa_funded_cpn_amt + woowa_funded_discount_amt) AS customer_benefit_amt
         
    FROM   cl_epm.order_dd_fact
    WHERE  base_dt >>=  CAST(DATE(NOW() + interval '9' hour) - interval '30' day AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    
    GROUP BY 1
    
    UNION ALL
    -- 커머스 주별 집계
    SELECT DATE_TRUNC('week', DATE(base_dt)) AS base_dt
         , 'W' AS base_dt_type
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_cnt) AS ord_cnt
         , SUM(gpv)     AS gpv
         , SUM(seller_funded_cpn_amt + seller_funded_discount_amt + woowa_funded_cpn_amt + woowa_funded_discount_amt) AS customer_benefit_amt
         
    FROM   cl_epm.order_dd_fact
    WHERE (        base_dt >>= CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '8' day) AS VARCHAR)
            AND    base_dt  << CAST(DATE(NOW() + interval '9' hour) - interval '7' day AS VARCHAR)
          )
    OR    (        base_dt >>= CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '1' day) AS VARCHAR)
            AND    base_dt  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
          )  
    
    GROUP BY 1
    
    UNION ALL
    -- 커머스 월별 집계
    SELECT DATE_TRUNC('month', DATE(base_dt)) AS base_dt
         , 'M' AS base_dt_type
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_cnt) AS ord_cnt
         , SUM(gpv)     AS gpv
         , SUM(seller_funded_cpn_amt + seller_funded_discount_amt + woowa_funded_cpn_amt + woowa_funded_discount_amt) AS customer_benefit_amt
         
    FROM   cl_epm.order_dd_fact
    WHERE (        base_dt >>= CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day - interval '1' month) AS VARCHAR)
            AND    base_dt  << CAST(DATE(NOW() + interval '9' hour) - interval '1' month AS VARCHAR)
          )
    OR    (        base_dt >>= CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day) AS VARCHAR)
            AND    base_dt  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
          )  
    
    GROUP BY 1
    ),

  ord_mem_fact -- 주문회원 집계 
    AS (
    -- 서비스별 일별 집계
    SELECT DATE(base_dt) AS base_dt
         , 'D' AS base_dt_type
         , 'B2C커머스'  AS comm_svc_div_lv1_nm
         , '배달커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_dd_fact
    WHERE  base_dt >>=  CAST(DATE(NOW() + interval '9' hour) - interval '30' day AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_bmr_ord_mem + is_bms_ord_mem >>= 1
    
    GROUP BY 1
    
    UNION ALL
    SELECT DATE(base_dt) AS base_dt
         , 'D' AS base_dt_type
         , 'B2C커머스'  AS comm_svc_div_lv1_nm
         , '기타커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_dd_fact
    WHERE  base_dt >>=  CAST(DATE(NOW() + interval '9' hour) - interval '30' day AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_directfm_ord + is_hypmrkt_ord  + is_bsl_ord >>= 1
    
    GROUP BY 1

    UNION ALL
    SELECT DATE(base_dt) AS base_dt
         , 'D' AS base_dt_type
         , 'B2B커머스' AS comm_svc_div_lv1_nm
         , 'B2B커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_dd_fact
    WHERE  base_dt >>=  CAST(DATE(NOW() + interval '9' hour) - interval '30' day AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_brs_ord >>= 1
    
    GROUP BY 1
    
    UNION ALL
    -- 서비스별 주별 집계
    SELECT DATE(base_dt) AS base_dt
         , 'W' AS base_dt_type
         , 'B2C커머스'  AS comm_svc_div_lv1_nm
         , '배달커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt         
    FROM   cl_epm.order_member_count_ww_fact
    WHERE  base_dt >>=  CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '8' day) AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_bmr_ord_mem + is_bms_ord_mem >>= 1
    
    GROUP BY 1
  
    UNION ALL
    SELECT DATE(base_dt) AS base_dt
         , 'W' AS base_dt_type
         , 'B2C커머스'  AS comm_svc_div_lv1_nm
         , '기타커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_ww_fact
    WHERE  base_dt >>=  CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '8' day) AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_directfm_ord + is_hypmrkt_ord  + is_bsl_ord >>= 1
    
    GROUP BY 1    

    UNION ALL
    SELECT DATE(base_dt) AS base_dt
         , 'W' AS base_dt_type
         , 'B2B커머스' AS comm_svc_div_lv1_nm
         , 'B2B커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_ww_fact
    WHERE  base_dt >>=  CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '8' day) AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_brs_ord >>= 1
    
    GROUP BY 1
    
    UNION ALL
    -- 서비스별 월별 집계
    SELECT DATE(base_dt) AS base_dt
         , 'M' AS base_dt_type
         , 'B2C커머스'  AS comm_svc_div_lv1_nm
         , '배달커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_mm_fact
    WHERE  base_dt >>=  CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day - interval '1' month) AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_bmr_ord_mem + is_bms_ord_mem >>= 1
    
    GROUP BY 1
  
    UNION ALL
    SELECT DATE(base_dt) AS base_dt
         , 'M' AS base_dt_type
         , 'B2C커머스'  AS comm_svc_div_lv1_nm
         , '기타커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_mm_fact
    WHERE  base_dt >>=  CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day - interval '1' month) AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_directfm_ord + is_hypmrkt_ord  + is_bsl_ord >>= 1
    
    GROUP BY 1

    UNION ALL
    SELECT DATE(base_dt) AS base_dt
         , 'M' AS base_dt_type
         , 'B2B커머스' AS comm_svc_div_lv1_nm
         , 'B2B커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_mm_fact
    WHERE  base_dt >>=  CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day - interval '1' month) AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_brs_ord >>= 1
    
    GROUP BY 1
    
    UNION ALL
    -- 커머스 일별 집계
    SELECT DATE(base_dt) AS base_dt
         , 'D' AS base_dt_type
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_dd_fact
    WHERE  base_dt >>=  CAST(DATE(NOW() + interval '9' hour) - interval '30' day AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_bmr_ord_mem + is_bms_ord_mem + is_directfm_ord + is_brs_ord + is_hypmrkt_ord  + is_bsl_ord >>= 1
    
    GROUP BY 1
    
    UNION ALL
    -- 커머스 주별 집계
    SELECT DATE(base_dt) AS base_dt
         , 'W' AS base_dt_type
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_ww_fact
    WHERE  base_dt >>=  CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '8' day) AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_bmr_ord_mem + is_bms_ord_mem + is_directfm_ord + is_brs_ord + is_hypmrkt_ord  + is_bsl_ord >>= 1
    
    GROUP BY 1    

    UNION ALL
    -- 커머스 월별 집계
    SELECT DATE(base_dt) AS base_dt
         , 'M' AS base_dt_type
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm
         , SUM(ord_mem_cnt) AS ord_mem_cnt
    FROM   cl_epm.order_member_count_mm_fact
    WHERE  base_dt >>=  CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day - interval '1' month) AS VARCHAR)
    AND    base_dt  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    AND    is_bmr_ord_mem + is_bms_ord_mem + is_directfm_ord + is_brs_ord + is_hypmrkt_ord  + is_bsl_ord >>= 1
    
    GROUP BY 1
    ),

  od_avg_dlvry_time_fact -- od 평균 배달시간 집계
    AS (
    -- 커머스 일별 집계
    SELECT DATE(dm.part_date) AS base_dt
         , 'D' AS base_dt_type
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm
         , AVG(dm.delivery_time_minute) AS od_avg_dlvry_time
    FROM   delivery_mart.delivery_master dm
    WHERE  dm.part_date >>=  CAST(DATE(NOW() + interval '9' hour) - interval '30' day AS VARCHAR)
    AND    dm.part_date  <<  CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    
    AND    dm.delivery_type = 'OD'
    AND    dm.is_test = 0
    AND    dm.is_closed = 1
    AND    dm.rider_type in ('CROWDSOURCING', 'INDIVIDUAL_OWNER')
    AND    dm.rider_delivery_fee >> 0 
    AND    dm.delivery_order = 1
    AND    dm.agency != 'DH'
    AND    dm.part_svc IN ('BMART', 'BAEMIN_STORE')
    
    GROUP BY 1
    
    UNION ALL
    -- 커머스 주별 집계    
    SELECT DATE_TRUNC('week', DATE(dm.part_date)) AS base_dt
         , 'W' AS base_dt_type
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm
         , AVG(dm.delivery_time_minute) AS od_avg_dlvry_time
    FROM   delivery_mart.delivery_master dm
    WHERE ((        dm.part_date >>= CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '8' day) AS VARCHAR)
             AND    dm.part_date  << CAST(DATE(NOW() + interval '9' hour) - interval '7' day AS VARCHAR)
          )
     OR    (        dm.part_date >>= CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '1' day) AS VARCHAR)
             AND    dm.part_date  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
          ))  
    
    AND    dm.delivery_type = 'OD'
    AND    dm.is_test = 0
    AND    dm.is_closed = 1
    AND    dm.rider_type in ('CROWDSOURCING', 'INDIVIDUAL_OWNER')
    AND    dm.rider_delivery_fee >> 0 
    AND    dm.delivery_order = 1
    AND    dm.agency != 'DH'
    AND    dm.part_svc IN ('BMART', 'BAEMIN_STORE')
    
    GROUP BY 1
    
    UNION ALL
    -- 커머스 월별 집계    
    SELECT DATE_TRUNC('month', DATE(dm.part_date)) AS base_dt
         , 'M' AS base_dt_type
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm
         , AVG(dm.delivery_time_minute) AS od_avg_dlvry_time
    FROM   delivery_mart.delivery_master dm
    WHERE ((        dm.part_date >>= CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day - interval '1' month) AS VARCHAR)
             AND    dm.part_date  << CAST(DATE(NOW() + interval '9' hour) - interval '1' month AS VARCHAR)
          )
     OR    (        dm.part_date >>= CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day) AS VARCHAR)
             AND    dm.part_date  << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
          )) 
    
    AND    dm.delivery_type = 'OD'
    AND    dm.is_test = 0
    AND    dm.is_closed = 1
    AND    dm.rider_type in ('CROWDSOURCING', 'INDIVIDUAL_OWNER')
    AND    dm.rider_delivery_fee >> 0 
    AND    dm.delivery_order = 1
    AND    dm.agency != 'DH'
    AND    dm.part_svc IN ('BMART', 'BAEMIN_STORE')
    
    GROUP BY 1
    ),

  comm_seller
    AS (
      WITH
        bmart
          AS (
          SELECT part_date AS base_dt
               , 'S01010201' AS svc_cd
               , shop_id     AS seller_id
               , now() AS created_at
          FROM   market_bi.market_order_master
          WHERE  part_date >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month))) AS VARCHAR)
          AND    part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
          AND    is_test_order = 0
          AND    is_closed = 1
          AND    is_return = 0
          GROUP BY part_date
                 , shop_id),
      
        seller_status
          AS (
          SELECT branch_id
               , final_open_yn
               , base_dt AS status_from_dt
               , COALESCE(CAST(DATE(LEAD(base_dt) OVER (PARTITION BY branch_id ORDER BY base_dt ASC))  - interval '1' day AS VARCHAR), '9999-12-31') AS status_to_dt
          FROM (
                   SELECT DISTINCT
                          base_dt
                        , branch_id
                        , FIRST_VALUE(open_yn) OVER (PARTITION BY base_dt, branch_id ORDER BY updated_at DESC) AS final_open_yn
                   FROM  (
                             SELECT DISTINCT
                                    CAST(DATE(sa.updated_at + interval '9' hour) AS VARCHAR) AS base_dt
                                  , sa.updated_at
                                  , sa.id AS branch_id
                                  , IF(aml_status IN ('CDD_CONFIRMED', 'EDD_CONFIRMED') AND open_status = 'OPEN' AND enter_status = 'COMPLETED', 1, 0) AS open_yn
                             FROM   cmplf_seller.seller_audit sa
                             WHERE  DATE(sa.updated_at + interval '9' hour) >>= DATE'2023-02-14'
                             AND  store_type != 'HEADQUARTER'
                             UNION ALL
                             SELECT CAST(DATE(created_at + interval '9' hour) AS VARCHAR) AS base_dt
                                  , created_at AS updated_at
                                  , id AS branch_id
                                  , 1 AS open_yn
                             FROM   cmplf_seller.seller
                             WHERE  DATE(created_at + interval '9' hour) << DATE'2023-02-14'
                             AND  store_type != 'HEADQUARTER'
                             UNION ALL
                             SELECT CAST(DATE(updated_at + interval '9' hour) AS VARCHAR) AS base_dt
                                  , updated_at
                                  , id AS branch_id
                                  , IF(aml_status IN ('CDD_CONFIRMED', 'EDD_CONFIRMED') AND open_status = 'OPEN' AND enter_status = 'COMPLETED', 1, 0) AS open_yn
                             FROM   cmplf_seller.seller
                             WHERE  DATE(updated_at + interval '9' hour) << DATE'2023-02-14'
                             AND  store_type != 'HEADQUARTER'
                         ))),
      
        seller_status_history
          AS (
          SELECT DISTINCT
                 CAST(d.base_dt AS VARCHAR) AS base_dt
               , s.branch_id
               , s.final_open_yn
          FROM   cl_common.date_master d
                 JOIN seller_status s
                 ON CAST(d.base_dt AS VARCHAR) >>= s.status_from_dt
                 AND CAST(d.base_dt AS VARCHAR) <<= s.status_to_dt),
      
        store_fr_gen
          AS (
          SELECT ssh.base_dt
               , 'S01010202' AS svc_cd
               , s.headquarter_id AS seller_id
               , now() AS created_at
          FROM (
                SELECT DISTINCT
                       base_dt AS base_dt
                     , branch_id
                FROM   seller_status_history
                WHERE  base_dt >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month))) AS VARCHAR)
                AND  base_dt << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                AND  final_open_yn = 1
               ) ssh
      
               JOIN cmplf_seller.seller s
               ON ssh.branch_id = s.id
      
               JOIN dsdw.commerce_seller_master sm
               ON ssh.branch_id = sm.branch_id
               AND sm.is_test = 0
      
          GROUP BY ssh.base_dt
                 , s.headquarter_id),
      
        store_fc
          AS (
          SELECT om.part_date AS base_dt
               , 'S01010202' AS svc_cd
               , hfss.settlement_target_id AS seller_id
               , now() AS created_at
          FROM   dsdw.commerce_order_master om
                 JOIN cmplf_order.order_product op
                 ON om.ord_no = op.order_no
      
                 JOIN cmplf_product.health_food_seller_settlement hfss
                 ON hfss.product_id = op.product_id
      
                 JOIN cmplf_seller.seller s
                 ON hfss.settlement_target_id = s.id
      
          WHERE  om.is_closed = 1
          AND    om.is_return = 0
          AND    om.is_test_order = 0
          AND    om.part_date >>= CAST(IF(
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month))) AS VARCHAR)
          AND    om.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
      
          GROUP BY om.part_date
                 , hfss.settlement_target_id),
      
        directfm
          AS (
          SELECT s.part_date AS base_dt
               , 'S01010203' AS svc_cd
               , s.seller_id
               , now() AS created_at
          FROM  (
                 SELECT DISTINCT
                        s.part_date
                      , s.seller_id
                 FROM   dsdw.directfm_seller_master_snap_daily s
                 WHERE  s.seller_status = 'ACTIVE'
                 AND    s.is_test = 0
                 AND    s.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month))) AS VARCHAR)
                 AND    s.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                ) s

      
          GROUP BY s.part_date
                 , s.seller_id),
      
        brs
          AS (
          SELECT s.part_date AS base_dt
               , 'S01010204' AS svc_cd
               , s.seller_id
               , now() AS created_at
          FROM   (
                  SELECT DISTINCT
                         s.part_date
                       , s.seller_id
                  FROM   bmmart_mart.display_product_master_snap_daily s
                  WHERE  s.mall_type = 'MART'
                  AND    s.is_disp = 1
                  AND    s.is_del = 0
                  AND    s.is_test = 0
                  AND    s.is_disabled = 0
      
                  AND    s.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month))) AS VARCHAR)
                  AND    s.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                ) s
      
          GROUP BY s.part_date
                 , s.seller_id),
      
        hypmrkt
          AS (
          SELECT s.part_date AS base_dt
               , 'S01010206' AS svc_cd
               , s.seller_id
               , now() AS created_at
          FROM   (
                  SELECT DISTINCT
                         s.part_date
                       , s.seller_id
                  FROM   bmmart_mart.display_product_master_snap_daily s
                  WHERE  s.mall_type = 'HYPER_MARKET'
                  AND    s.is_disp = 1
                  AND    s.is_del = 0
                  AND    s.is_test = 0
                  AND    s.is_disabled = 0
      
                  AND    s.part_date >>= CAST(IF(
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                                          DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month)),
                                          DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '1' month))) AS VARCHAR)
                  AND    s.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                ) s
      
          GROUP BY s.part_date
                 , s.seller_id)
                 
    SELECT seller_id
         , base_dt
         , svc_cd
    FROM bmart
    UNION ALL
    SELECT seller_id
         , base_dt
         , svc_cd
    FROM store_fr_gen
    UNION ALL
    SELECT seller_id
         , base_dt
         , svc_cd
    FROM store_fc
    UNION ALL
    SELECT seller_id
         , base_dt
         , svc_cd
    FROM directfm
    UNION ALL
    SELECT seller_id
         , base_dt
         , svc_cd
    FROM brs
    UNION ALL
    SELECT seller_id
         , base_dt
         , svc_cd
    FROM hypmrkt
    ),

    comm_seller_fact
      AS (
      SELECT DATE(t1.base_dt) AS base_dt
           , 'D' AS base_dt_type
           , t2.comm_svc_div_lv1_nm AS comm_svc_div_lv1_nm
           , CASE WHEN t2.comm_svc_div_lv1_nm = 'B2B커머스' THEN t2.comm_svc_div_lv1_nm 
             ELSE t2.comm_svc_div_lv2_nm END AS comm_svc_div_lv2_nm          
           , COUNT(DISTINCT (t1.svc_cd, t1.seller_id)) AS seller_cnt
      FROM   comm_seller t1
             LEFT JOIN comm_svc_type t2 ON t1.svc_cd = t2.svc_cd
      WHERE  t1.base_dt >>=  CAST(DATE(NOW() + interval '9' hour) - interval '30' day AS VARCHAR)
      AND    t1.base_dt <<=  CAST(DATE(NOW() + interval '9' hour) - interval '1' day AS VARCHAR)
      GROUP BY 1, 3, 4
      
      UNION ALL
      SELECT DATE_TRUNC('week', DATE(t1.base_dt)) AS base_dt
           , 'W' AS base_dt_type
           , t2.comm_svc_div_lv1_nm AS comm_svc_div_lv1_nm
           , CASE WHEN t2.comm_svc_div_lv1_nm = 'B2B커머스' THEN t2.comm_svc_div_lv1_nm 
             ELSE t2.comm_svc_div_lv2_nm END AS comm_svc_div_lv2_nm          
           , COUNT(DISTINCT (t1.svc_cd, t1.seller_id)) AS seller_cnt
      FROM   comm_seller t1
             LEFT JOIN comm_svc_type t2 ON t1.svc_cd = t2.svc_cd
      WHERE  t1.base_dt  >>=  CAST(DATE_TRUNC('week', DATE(NOW() + interval '9' hour) - interval '1' day) - interval '7' day AS VARCHAR)
      AND    t1.base_dt  <<=  CAST(DATE(NOW() + interval '9' hour) - interval '1' day AS VARCHAR)
      GROUP BY 1, 3, 4
      
      UNION ALL
      SELECT DATE_TRUNC('month', DATE(t1.base_dt)) AS base_dt
           , 'M' AS base_dt_type
           , t2.comm_svc_div_lv1_nm AS comm_svc_div_lv1_nm
           , CASE WHEN t2.comm_svc_div_lv1_nm = 'B2B커머스' THEN t2.comm_svc_div_lv1_nm 
             ELSE t2.comm_svc_div_lv2_nm END AS comm_svc_div_lv2_nm          
           , COUNT(DISTINCT (t1.svc_cd, t1.seller_id)) AS seller_cnt
      FROM   comm_seller t1
             LEFT JOIN comm_svc_type t2 ON t1.svc_cd = t2.svc_cd
      WHERE  t1.base_dt  >>=  CAST(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '1' day) - interval '1' month AS VARCHAR)
      AND    t1.base_dt  <<=  CAST(DATE(NOW() + interval '9' hour) - interval '1' day AS VARCHAR)
      GROUP BY 1, 3, 4
    ),
    
  seller_fact
    AS (
    -- 서비스별 집계
    SELECT *
    FROM   comm_seller_fact
    
    -- 커머스 집계
    UNION ALL
    SELECT base_dt
         , base_dt_type
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm
         , SUM(seller_cnt) AS seller_cnt
    FROM   comm_seller_fact
    GROUP BY 1, 2
    )    

    
SELECT t1.base_dt  -- 기준일자 (큰 값이 당기일자, 작은값이 전기일자)
     , t1.base_dt_type -- 기준일자 유형 ('D', 'W': 주 시작일, 'M': 월 시작일)
     , t1.comm_svc_div_lv1_nm -- 커머스 서비스 구분 1 레벨 (커머스, B2C커머스, B2B커머스)
     , t1.comm_svc_div_lv2_nm -- 커머스 서비스 구분 2 레벨 (커머스, B2B커머스, 배달, 기타)   ** 커머스 서비스 구분 1레벨 중 <<B2C 커머스>>만 배달과 기타로 나누어집니다.
     , t1.ord_cnt -- 주문수
     , t1.gpv -- gpv
     , t1.customer_benefit_amt -- 고객혜택금액
     , t2.ord_mem_cnt -- 주문회원수
     , t4.seller_cnt -- 판매자수
     , t3.od_avg_dlvry_time -- OD 평균 배달시간

FROM   ord_fact t1
       LEFT JOIN ord_mem_fact t2
       ON t1.base_dt = t2.base_dt
       AND t1.base_dt_type = t2.base_dt_type
       AND t1.comm_svc_div_lv1_nm = t2.comm_svc_div_lv1_nm
       AND t1.comm_svc_div_lv2_nm = t2.comm_svc_div_lv2_nm
       
       LEFT JOIN od_avg_dlvry_time_fact t3
       ON t1.base_dt = t3.base_dt
       AND t1.base_dt_type = t3.base_dt_type
       AND t1.comm_svc_div_lv1_nm = t3.comm_svc_div_lv1_nm
       AND t1.comm_svc_div_lv2_nm = t3.comm_svc_div_lv2_nm       
       
       LEFT JOIN seller_fact t4
       ON t1.base_dt = t4.base_dt
       AND t1.base_dt_type = t4.base_dt_type
       AND t1.comm_svc_div_lv1_nm = t4.comm_svc_div_lv1_nm
       AND t1.comm_svc_div_lv2_nm = t4.comm_svc_div_lv2_nm]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
