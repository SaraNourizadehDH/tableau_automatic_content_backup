          <remote-alias>base_dt</remote-alias>
          <ordinal>0</ordinal>
          <family>사용자 지정 SQL 쿼리</family>
          <local-type>date</local-type>
          <aggregation>Year</aggregation>
          <approx-count>31</approx-count>
          <contains-null>true</contains-null>
          <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_E59D3E5A9F894F1AAE55DCDF3023D6FA]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
        </metadata-record>
