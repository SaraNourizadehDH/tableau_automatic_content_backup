        <properties context=''>
          <relation connection='athena.1ijcy480z7ags81al8mij0wkmb9m' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[WITH 
  ord_fact
    AS (
    SELECT DATE(part_date) AS base_dt
         , 'D' AS base_dt_type
         , COUNT(DISTINCT ord_no) AS ord_cnt
         , COUNT(DISTINCT IF(cpn_use_amt >> 0, ord_no, NULL)) AS cpn_use_ord_cnt
         , COUNT(DISTINCT IF(cpn_use_amt >> 0 AND is_svc_first_ord = 1, ord_no, NULL)) AS cpn_use_first_ord_cnt
         , COUNT(DISTINCT IF(cpn_use_amt >> 0 AND is_svc_first_ord = 0, ord_no, NULL)) AS cpn_use_nonfirst_ord_cnt
    
         , SUM(ord_amt) AS gpv
         , SUM(IF(cpn_use_amt >> 0, ord_amt, 0)) AS cpn_use_ord_gpv
         , SUM(IF(cpn_use_amt >> 0 AND is_svc_first_ord = 1, ord_amt, 0)) AS cpn_use_first_ord_gpv
         , SUM(IF(cpn_use_amt >> 0 AND is_svc_first_ord = 0, ord_amt, 0)) AS cpn_use_nonfirst_ord_gpv
         
         , SUM(cpn_use_amt) AS cpn_use_amt
         , SUM(company_charge_cpn_amt) AS company_charge_cpn_amt
         , SUM(seller_charge_cpn_amt)  AS seller_charge_cpn_amt
         
         , COUNT(DISTINCT brs_mem_no) AS ord_mem_cnt
         , COUNT(DISTINCT IF(is_svc_first_ord = 1, brs_mem_no)) AS first_ord_mem_cnt
         , COUNT(DISTINCT brs_mem_no) - COUNT(DISTINCT IF(is_svc_first_ord = 1, brs_mem_no)) AS nonfirst_ord_mem_cnt
    
    FROM   cl_epm.ord_cust_benefit_info
    WHERE  part_svc_cd = 'CMBR'
    AND    is_cmplt_ord = 1
    AND    part_date >>= CAST(IF(
                              DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                              DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                              DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month))) AS VARCHAR)
    AND    part_date  << CAST(DATE(NOW() AT TIME ZONE 'Asia/Seoul') AS VARCHAR)

    GROUP BY part_date
    
    UNION ALL
    SELECT DATE_TRUNC('week', DATE(part_date)) AS base_dt
         , 'W' AS base_dt_type
         , COUNT(DISTINCT ord_no) AS ord_cnt
         , COUNT(DISTINCT IF(cpn_use_amt >> 0, ord_no, NULL)) AS cpn_use_ord_cnt
         , COUNT(DISTINCT IF(cpn_use_amt >> 0 AND is_svc_first_ord = 1, ord_no, NULL)) AS cpn_use_first_ord_cnt
         , COUNT(DISTINCT IF(cpn_use_amt >> 0 AND is_svc_first_ord = 0, ord_no, NULL)) AS cpn_use_nonfirst_ord_cnt
    
         , SUM(ord_amt) AS gpv
         , SUM(IF(cpn_use_amt >> 0, ord_amt, 0)) AS cpn_use_ord_gpv
         , SUM(IF(cpn_use_amt >> 0 AND is_svc_first_ord = 1, ord_amt, 0)) AS cpn_use_first_ord_gpv
         , SUM(IF(cpn_use_amt >> 0 AND is_svc_first_ord = 0, ord_amt, 0)) AS cpn_use_nonfirst_ord_gpv
         
         , SUM(cpn_use_amt) AS cpn_use_amt
         , SUM(company_charge_cpn_amt) AS company_charge_cpn_amt
         , SUM(seller_charge_cpn_amt)  AS seller_charge_cpn_amt
         
         , COUNT(DISTINCT brs_mem_no) AS ord_mem_cnt
         , COUNT(DISTINCT IF(is_svc_first_ord = 1, brs_mem_no)) AS first_ord_mem_cnt
         , COUNT(DISTINCT brs_mem_no) - COUNT(DISTINCT IF(is_svc_first_ord = 1, brs_mem_no)) AS nonfirst_ord_mem_cnt
    
    FROM   cl_epm.ord_cust_benefit_info
    WHERE  part_svc_cd = 'CMBR'
    AND    is_cmplt_ord = 1
    AND    part_date >>= CAST(IF(
                              DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                              DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                              DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month))) AS VARCHAR)
    AND    part_date  << CAST(DATE(NOW() AT TIME ZONE 'Asia/Seoul') AS VARCHAR)

    GROUP BY DATE_TRUNC('week', DATE(part_date))
    
    UNION ALL
    SELECT DATE_TRUNC('month', DATE(part_date)) AS base_dt
         , 'M' AS base_dt_type
         , COUNT(DISTINCT ord_no) AS ord_cnt
         , COUNT(DISTINCT IF(cpn_use_amt >> 0, ord_no, NULL)) AS cpn_use_ord_cnt
         , COUNT(DISTINCT IF(cpn_use_amt >> 0 AND is_svc_first_ord = 1, ord_no, NULL)) AS cpn_use_first_ord_cnt
         , COUNT(DISTINCT IF(cpn_use_amt >> 0 AND is_svc_first_ord = 0, ord_no, NULL)) AS cpn_use_nonfirst_ord_cnt
    
         , SUM(ord_amt) AS gpv
         , SUM(IF(cpn_use_amt >> 0, ord_amt, 0)) AS cpn_use_ord_gpv
         , SUM(IF(cpn_use_amt >> 0 AND is_svc_first_ord = 1, ord_amt, 0)) AS cpn_use_first_ord_gpv
         , SUM(IF(cpn_use_amt >> 0 AND is_svc_first_ord = 0, ord_amt, 0)) AS cpn_use_nonfirst_ord_gpv
         
         , SUM(cpn_use_amt) AS cpn_use_amt
         , SUM(company_charge_cpn_amt) AS company_charge_cpn_amt
         , SUM(seller_charge_cpn_amt)  AS seller_charge_cpn_amt
         
         , COUNT(DISTINCT brs_mem_no) AS ord_mem_cnt
         , COUNT(DISTINCT IF(is_svc_first_ord = 1, brs_mem_no)) AS first_ord_mem_cnt
         , COUNT(DISTINCT brs_mem_no) - COUNT(DISTINCT IF(is_svc_first_ord = 1, brs_mem_no)) AS nonfirst_ord_mem_cnt
    
    FROM   cl_epm.ord_cust_benefit_info
    WHERE  part_svc_cd = 'CMBR'
    AND    is_cmplt_ord = 1
    AND    part_date >>= CAST(IF(
                              DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                              DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                              DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month))) AS VARCHAR)
    AND    part_date  << CAST(DATE(NOW() AT TIME ZONE 'Asia/Seoul') AS VARCHAR)

    GROUP BY DATE_TRUNC('month', DATE(part_date))),
    
  seller_info
    AS (
    SELECT s.part_date
         , s.seller_id
         , SUM(COALESCE(om.ord_cnt,0)) AS ord_cnt
    FROM   (
            SELECT DISTINCT
                   s.part_date
                 , s.seller_id
            FROM   bmmart_mart.display_product_master_snap_daily s
            WHERE  s.mall_type = 'MART'
            AND    s.is_disp = 1
            AND    s.is_del = 0
            AND    s.is_test = 0
            AND    s.is_disabled = 0
  
            AND    s.part_date >>= CAST(IF(
                                    DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                                    DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                                    DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month))) AS VARCHAR)
            AND    s.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
          ) s
           LEFT JOIN (
                      SELECT oii.part_date
                           , oii.seller_id
                           , COUNT(DISTINCT oii.ord_id) as ord_cnt
                      FROM   bmmart_mart.order_item_info oii
                             JOIN bmmart_mart.order_info oi
                             ON oii.ord_id = oi.ord_id
                             AND oi.mall_type = 'MART'
                             AND oi.is_cmplt_ord = 1
                             AND oi.is_test = 0
                             AND oi.part_date >>= CAST(IF(
                                    DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                                    DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                                    DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month))) AS VARCHAR)
                             AND oi.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
                      WHERE  oii.item_qty * oii.item_price >> 0
                      AND    oii.part_date >>= CAST(IF(
                                    DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                                    DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                                    DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month))) AS VARCHAR)
                      AND    oii.part_date << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
  
                      GROUP BY 1,2
                    ) om
           ON s.seller_id = om.seller_id
           AND s.part_date = om.part_date
  
  
    GROUP BY s.part_date
           , s.seller_id),
           
  seller_fact
    AS (
    SELECT DATE(part_date) AS base_dt
         , 'D' AS base_dt_type
         , COUNT(DISTINCT seller_id) AS seller_cnt
         , COUNT(DISTINCT IF(ord_cnt >> 0, seller_id, NULL)) AS ord_seller_cnt
         , COUNT(DISTINCT IF(ord_cnt = 0, seller_id, NULL)) AS noord_seller_cnt         
    FROM   seller_info
    GROUP BY part_date
    
    UNION ALL
    SELECT DATE_TRUNC('week', DATE(part_date)) AS base_dt
         , 'W' AS base_dt_type
         , COUNT(DISTINCT seller_id) AS seller_cnt
         , COUNT(DISTINCT IF(ord_cnt >> 0, seller_id, NULL)) AS ord_seller_cnt
         , COUNT(DISTINCT IF(ord_cnt = 0, seller_id, NULL)) AS noord_seller_cnt         
    FROM   seller_info
    GROUP BY DATE_TRUNC('week', DATE(part_date))
    
    UNION ALL
    SELECT DATE_TRUNC('month', DATE(part_date)) AS base_dt
         , 'M' AS base_dt_type
         , COUNT(DISTINCT seller_id) AS seller_cnt
         , COUNT(DISTINCT IF(ord_cnt >> 0, seller_id, NULL)) AS ord_seller_cnt
         , COUNT(DISTINCT IF(ord_cnt = 0, seller_id, NULL)) AS noord_seller_cnt         
    FROM   seller_info
    GROUP BY DATE_TRUNC('month', DATE(part_date)))
    
SELECT t1.base_dt
     , t1.base_dt_type
     , key as subject
     , value as value
     
FROM   ord_fact t1
       LEFT JOIN seller_fact t2 
       ON t1.base_dt = t2.base_dt
       AND t1.base_dt_type = t2.base_dt_type
       
cross join
      unnest(array['주문수','쿠폰사용주문수','쿠폰 사용 최초 주문수','쿠폰 사용 기존 주문수','GPV','쿠폰사용 주문 GPV','쿠폰 사용 최초 주문 GPV','쿠폰 사용 기존 주문 GPV','쿠폰사용금액','회사부담금액','판매자부담금액','주문회원수','최초 주문회원수','기존 주문회원수','판매자수','주문발생 판매자수','주문 미발생 판매자수'],
      array[ord_cnt,cpn_use_ord_cnt,cpn_use_first_ord_cnt,cpn_use_nonfirst_ord_cnt,gpv,cpn_use_ord_gpv,cpn_use_first_ord_gpv,cpn_use_nonfirst_ord_gpv,cpn_use_amt,company_charge_cpn_amt,seller_charge_cpn_amt,ord_mem_cnt,first_ord_mem_cnt,nonfirst_ord_mem_cnt,COALESCE(t2.seller_cnt, 0),COALESCE(t2.ord_seller_cnt, 0),COALESCE(t2.noord_seller_cnt, 0)])
      t2(KEY,VALUE)]]></relation>
        </properties>
        <properties context='extract'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </properties>
      </object>
    </objects>
  </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
</datasource>
