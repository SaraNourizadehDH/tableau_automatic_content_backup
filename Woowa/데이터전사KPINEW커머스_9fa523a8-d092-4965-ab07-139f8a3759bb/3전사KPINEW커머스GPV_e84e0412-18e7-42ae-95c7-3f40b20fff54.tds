    <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.1bhvdsy0md1fq21ghx0ta0zoyb6n' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[WITH
  comm_svc_type
    AS (
    SELECT *
    FROM  (
            VALUES
           ('S01010201', 'B2C커머스', '배달커머스', 'B마트'),
           ('S01010202', 'B2C커머스', '배달커머스', '배민스토어'),
           ('S01010203', 'B2C커머스', '기타커머스', '전국별미'),
           ('S01010204', 'B2B커머스', '기타커머스', '배민상회'),
           ('S01010205', 'B2C커머스', '기타커머스', '배민쇼핑라이브'),
           ('S01010206', 'B2C커머스', '기타커머스', '대용량특가')) AS t (svc_cd, comm_svc_div_lv1_nm, comm_svc_div_lv2_nm, svc_nm)
    ),
    
  ord_fact
    AS (
    SELECT DATE(t1.base_dt) AS base_dt
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm
         , '커머스' AS comm_svc_nm
         
         , SUM(t1.ord_cnt) AS ord_cnt
         , SUM(t1.gpv) AS gpv

         , SUM(IF(t1.deliv_type     IN ('DELIVERY', 'SHIPPING', 'QUICK'), 0, t1.gpv)) AS pickup_gpv
         , SUM(IF(t1.deliv_subj_nm  IN ('OD', 'BAERA'),                   t1.gpv, 0)) AS od_gpv
         
    FROM   cl_epm.order_dd_fact t1
    WHERE  t1.base_dt >>= CAST(IF(
                                    DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                                    DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                                    DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month))) AS VARCHAR)
    AND    t1.base_dt << CAST(DATE(NOW() AT TIME ZONE 'Asia/Seoul') AS VARCHAR)

    AND    SUBSTR(t1.svc_cd, 1, 7) = 'S010102'
    
    GROUP BY 1, 2, 3, 4
    
    UNION ALL
    SELECT DATE(t1.base_dt) AS base_dt
         , t2.comm_svc_div_lv1_nm AS comm_svc_div_lv1_nm
         , CASE WHEN t2.comm_svc_div_lv1_nm = 'B2B커머스' THEN t2.comm_svc_div_lv1_nm 
           ELSE t2.comm_svc_div_lv2_nm END AS comm_svc_div_lv2_nm
         , '커머스' AS comm_svc_nm           

         , SUM(t1.ord_cnt) AS ord_cnt
         , SUM(t1.gpv) AS gpv

         , SUM(IF(t1.deliv_type     IN ('DELIVERY', 'SHIPPING', 'QUICK'), 0, t1.gpv)) AS pickup_gpv
         , SUM(IF(t1.deliv_subj_nm  IN ('OD', 'BAERA'),                   t1.gpv, 0)) AS od_gpv
         
    FROM   cl_epm.order_dd_fact t1
           LEFT JOIN comm_svc_type t2 ON t1.svc_cd = t2.svc_cd    
    WHERE  t1.base_dt >>= CAST(IF(
                                    DATE(DATE_TRUNC('week',  DATE(NOW() + interval '9' hour) - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '24' month)),
                                    DATE(DATE_TRUNC('week',  DATE(NOW() + interval '9' hour) - interval '24' month)),
                                    DATE(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '24' month))) AS VARCHAR)
    AND    t1.base_dt << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    
    AND    SUBSTR(t1.svc_cd, 1, 7) = 'S010102'

    GROUP BY 1, 2, 3, 4
    
    UNION ALL    
    SELECT DATE(t1.base_dt) AS base_dt
         , t2.comm_svc_div_lv1_nm AS comm_svc_div_lv1_nm
         , CASE WHEN t2.comm_svc_div_lv1_nm = 'B2B커머스' THEN t2.comm_svc_div_lv1_nm 
           ELSE t2.comm_svc_div_lv2_nm END AS comm_svc_div_lv2_nm
         , t2.svc_nm AS comm_svc_nm
                
         , SUM(t1.ord_cnt) AS ord_cnt
         , SUM(t1.gpv) AS gpv

         , SUM(IF(t1.deliv_type     IN ('DELIVERY', 'SHIPPING', 'QUICK'), 0, t1.gpv)) AS pickup_gpv
         , SUM(IF(t1.deliv_subj_nm  IN ('OD', 'BAERA'),                   t1.gpv, 0)) AS od_gpv


    FROM   cl_epm.order_dd_fact t1
           LEFT JOIN comm_svc_type t2 ON t1.svc_cd = t2.svc_cd
    WHERE  t1.base_dt >>= CAST(IF(
                                    DATE(DATE_TRUNC('week',  DATE(NOW() + interval '9' hour) - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '24' month)),
                                    DATE(DATE_TRUNC('week',  DATE(NOW() + interval '9' hour) - interval '24' month)),
                                    DATE(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '24' month))) AS VARCHAR)
    AND    t1.base_dt << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    
    AND    SUBSTR(t1.svc_cd, 1, 7) = 'S010102'
    
    GROUP BY 1, 2, 3, 4
    )
    
SELECT base_dt -- 일자
     , DATE_TRUNC('week', base_dt)  AS ww_start_dt -- 일자가 속한 주의 시작일자
     , DATE_TRUNC('month', base_dt) AS mm_start_dt -- 일자가 속한 월의 시작일자
     , comm_svc_div_lv1_nm -- 커머스 서비스 구분 1 레벨 (커머스, B2C커머스, B2B커머스)
     , comm_svc_div_lv2_nm -- 커머스 서비스 구분 2 레벨 (커머스, B2B커머스, 배달, 기타)   ** 커머스 서비스 구분 1레벨 중 <<B2C 커머스>>만 배달과 기타로 나누어집니다. 커머스 서비스 구분 1레벨이 <<B2C 커머스>>외의 값들은 커머스 서비스 구분 1레벨과 같은 값이 들어갑니다.
     , comm_svc_nm -- 서비스 이름  ** 이 값이 커머스인 경우 커머스 총계, 배달인 경우 배달커머스 총계, 기타인 경우 기타커머스 총계, B2B커머스인 경우 B2B커머스 총계값을 의미합니다.
     
     , gpv -- gpv
     , ord_cnt -- 주문수 (평균gpv = gpv/주문수)

     , od_gpv -- OD gpv  
     , od_gpv * 1e0 / gpv AS od_ord_ratio -- OD gpv 비율

     , pickup_gpv -- 픽업 gpv
     , pickup_gpv * 1e0 / gpv AS pickup_gpv_ratio -- 픽업 gpv 비율

FROM   ord_fact]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
    <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='athena.1bhvdsy0md1fq21ghx0ta0zoyb6n' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[WITH
  comm_svc_type
    AS (
    SELECT *
    FROM  (
            VALUES
           ('S01010201', 'B2C커머스', '배달커머스', 'B마트'),
           ('S01010202', 'B2C커머스', '배달커머스', '배민스토어'),
           ('S01010203', 'B2C커머스', '기타커머스', '전국별미'),
           ('S01010204', 'B2B커머스', '기타커머스', '배민상회'),
           ('S01010205', 'B2C커머스', '기타커머스', '배민쇼핑라이브'),
           ('S01010206', 'B2C커머스', '기타커머스', '대용량특가')) AS t (svc_cd, comm_svc_div_lv1_nm, comm_svc_div_lv2_nm, svc_nm)
    ),
    
  ord_fact
    AS (
    SELECT DATE(t1.base_dt) AS base_dt
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm
         , '커머스' AS comm_svc_nm
         
         , SUM(t1.ord_cnt) AS ord_cnt
         , SUM(t1.gpv) AS gpv

         , SUM(IF(t1.deliv_type     IN ('DELIVERY', 'SHIPPING', 'QUICK'), 0, t1.gpv)) AS pickup_gpv
         , SUM(IF(t1.deliv_subj_nm  IN ('OD', 'BAERA'),                   t1.gpv, 0)) AS od_gpv
         
    FROM   cl_epm.order_dd_fact t1
    WHERE  t1.base_dt >>= CAST(IF(
                                    DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                                    DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                                    DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month))) AS VARCHAR)
    AND    t1.base_dt << CAST(DATE(NOW() AT TIME ZONE 'Asia/Seoul') AS VARCHAR)

    AND    SUBSTR(t1.svc_cd, 1, 7) = 'S010102'
    
    GROUP BY 1, 2, 3, 4
    
    UNION ALL
    SELECT DATE(t1.base_dt) AS base_dt
         , t2.comm_svc_div_lv1_nm AS comm_svc_div_lv1_nm
         , CASE WHEN t2.comm_svc_div_lv1_nm = 'B2B커머스' THEN t2.comm_svc_div_lv1_nm 
           ELSE t2.comm_svc_div_lv2_nm END AS comm_svc_div_lv2_nm
         , '커머스' AS comm_svc_nm           

         , SUM(t1.ord_cnt) AS ord_cnt
         , SUM(t1.gpv) AS gpv

         , SUM(IF(t1.deliv_type     IN ('DELIVERY', 'SHIPPING', 'QUICK'), 0, t1.gpv)) AS pickup_gpv
         , SUM(IF(t1.deliv_subj_nm  IN ('OD', 'BAERA'),                   t1.gpv, 0)) AS od_gpv
         
    FROM   cl_epm.order_dd_fact t1
           LEFT JOIN comm_svc_type t2 ON t1.svc_cd = t2.svc_cd    
    WHERE  t1.base_dt >>= CAST(IF(
                                    DATE(DATE_TRUNC('week',  DATE(NOW() + interval '9' hour) - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '24' month)),
                                    DATE(DATE_TRUNC('week',  DATE(NOW() + interval '9' hour) - interval '24' month)),
                                    DATE(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '24' month))) AS VARCHAR)
    AND    t1.base_dt << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    
    AND    SUBSTR(t1.svc_cd, 1, 7) = 'S010102'

    GROUP BY 1, 2, 3, 4
    
    UNION ALL    
    SELECT DATE(t1.base_dt) AS base_dt
         , t2.comm_svc_div_lv1_nm AS comm_svc_div_lv1_nm
         , CASE WHEN t2.comm_svc_div_lv1_nm = 'B2B커머스' THEN t2.comm_svc_div_lv1_nm 
           ELSE t2.comm_svc_div_lv2_nm END AS comm_svc_div_lv2_nm
         , t2.svc_nm AS comm_svc_nm
                
         , SUM(t1.ord_cnt) AS ord_cnt
         , SUM(t1.gpv) AS gpv

         , SUM(IF(t1.deliv_type     IN ('DELIVERY', 'SHIPPING', 'QUICK'), 0, t1.gpv)) AS pickup_gpv
         , SUM(IF(t1.deliv_subj_nm  IN ('OD', 'BAERA'),                   t1.gpv, 0)) AS od_gpv


    FROM   cl_epm.order_dd_fact t1
           LEFT JOIN comm_svc_type t2 ON t1.svc_cd = t2.svc_cd
    WHERE  t1.base_dt >>= CAST(IF(
                                    DATE(DATE_TRUNC('week',  DATE(NOW() + interval '9' hour) - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '24' month)),
                                    DATE(DATE_TRUNC('week',  DATE(NOW() + interval '9' hour) - interval '24' month)),
                                    DATE(DATE_TRUNC('month', DATE(NOW() + interval '9' hour) - interval '24' month))) AS VARCHAR)
    AND    t1.base_dt << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    
    AND    SUBSTR(t1.svc_cd, 1, 7) = 'S010102'
    
    GROUP BY 1, 2, 3, 4
    )
    
SELECT base_dt -- 일자
     , DATE_TRUNC('week', base_dt)  AS ww_start_dt -- 일자가 속한 주의 시작일자
     , DATE_TRUNC('month', base_dt) AS mm_start_dt -- 일자가 속한 월의 시작일자
     , comm_svc_div_lv1_nm -- 커머스 서비스 구분 1 레벨 (커머스, B2C커머스, B2B커머스)
     , comm_svc_div_lv2_nm -- 커머스 서비스 구분 2 레벨 (커머스, B2B커머스, 배달, 기타)   ** 커머스 서비스 구분 1레벨 중 <<B2C 커머스>>만 배달과 기타로 나누어집니다. 커머스 서비스 구분 1레벨이 <<B2C 커머스>>외의 값들은 커머스 서비스 구분 1레벨과 같은 값이 들어갑니다.
     , comm_svc_nm -- 서비스 이름  ** 이 값이 커머스인 경우 커머스 총계, 배달인 경우 배달커머스 총계, 기타인 경우 기타커머스 총계, B2B커머스인 경우 B2B커머스 총계값을 의미합니다.
     
     , gpv -- gpv
     , ord_cnt -- 주문수 (평균gpv = gpv/주문수)

     , od_gpv -- OD gpv  
     , od_gpv * 1e0 / gpv AS od_ord_ratio -- OD gpv 비율

     , pickup_gpv -- 픽업 gpv
     , pickup_gpv * 1e0 / gpv AS pickup_gpv_ratio -- 픽업 gpv 비율

FROM   ord_fact]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
