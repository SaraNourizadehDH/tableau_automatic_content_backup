  <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
  <semantic-values>
    <semantic-value key='[Country].[Name]' value='&quot;대한민국&quot;' />
  </semantic-values>
  <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    <objects>
      <object caption='사용자 지정 SQL 쿼리' id='_D9B2AB915BE748659995525676DC6F04'>
        <properties context=''>
          <relation connection='athena.15kh8ml1bgifkt1fydgfx058mspu' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[WITH
  comm_svc_type
    AS (
    SELECT *
    FROM  (
            VALUES
           ('S01010201', 'B2C커머스', '배달커머스', 'B마트'),
           ('S01010202', 'B2C커머스', '배달커머스', '배민스토어'),
           ('S01010203', 'B2C커머스', '기타커머스', '전국별미'),
           ('S01010204', 'B2B커머스', '기타커머스', '배민상회'),
           ('S01010205', 'B2C커머스', '기타커머스', '배민쇼핑라이브'),
           ('S01010206', 'B2C커머스', '기타커머스', '대용량특가')) AS t (svc_cd, comm_svc_div_lv1_nm, comm_svc_div_lv2_nm, comm_svc_nm)
    ),
    
  ord_fact
    AS (
    SELECT DATE(t1.base_dt) AS base_dt
         , '커머스' AS comm_svc_div_lv1_nm
         , '커머스' AS comm_svc_div_lv2_nm
         , '커머스' AS comm_svc_nm
         
         , SUM(t1.ord_cnt) AS ord_cnt
         , SUM(IF(t1.seller_funded_cpn_amt + t1.seller_funded_discount_amt + t1.woowa_funded_cpn_amt + t1.woowa_funded_discount_amt >> 0, t1.ord_cnt, 0)) AS benefit_ord_cnt

         , SUM(t1.seller_funded_cpn_amt + t1.seller_funded_discount_amt + t1.woowa_funded_cpn_amt + t1.woowa_funded_discount_amt) AS benefit_amt

         , SUM(t1.seller_funded_cpn_amt + t1.woowa_funded_cpn_amt)      AS cpn_use_amt
         , SUM(t1.woowa_funded_cpn_amt)  AS company_charge_cpn_amt
         , SUM(t1.seller_funded_cpn_amt) AS seller_charge_cpn_amt

         , SUM(t1.seller_funded_discount_amt + t1.woowa_funded_discount_amt) AS discount_amt
         , SUM(t1.woowa_funded_discount_amt)  AS company_charge_discount_amt        
         , SUM(t1.seller_funded_discount_amt) AS seller_charge_discount_amt
     
    FROM   cl_epm.order_dd_fact t1
    WHERE  t1.base_dt >>= CAST(IF(
                                    DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                                    DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                                    DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month))) AS VARCHAR)
    AND    t1.base_dt << CAST(DATE(NOW() AT TIME ZONE 'Asia/Seoul') AS VARCHAR)
    AND    SUBSTR(t1.svc_cd, 1, 7) = 'S010102'    

    GROUP BY 1, 2, 3, 4
    
    UNION ALL
    SELECT DATE(t1.base_dt) AS base_dt
         , t2.comm_svc_div_lv1_nm AS comm_svc_div_lv1_nm
         , CASE WHEN t2.comm_svc_div_lv1_nm = 'B2B커머스' THEN t2.comm_svc_div_lv1_nm 
           ELSE t2.comm_svc_div_lv2_nm END AS comm_svc_div_lv2_nm
         , '커머스' AS comm_svc_nm   

         , SUM(t1.ord_cnt) AS ord_cnt
         , SUM(IF(t1.seller_funded_cpn_amt + t1.seller_funded_discount_amt + t1.woowa_funded_cpn_amt + t1.woowa_funded_discount_amt >> 0, t1.ord_cnt, 0)) AS benefit_ord_cnt

         , SUM(t1.seller_funded_cpn_amt + t1.seller_funded_discount_amt + t1.woowa_funded_cpn_amt + t1.woowa_funded_discount_amt) AS benefit_amt

         , SUM(t1.seller_funded_cpn_amt + t1.woowa_funded_cpn_amt)      AS cpn_use_amt
         , SUM(t1.woowa_funded_cpn_amt)  AS company_charge_cpn_amt
         , SUM(t1.seller_funded_cpn_amt) AS seller_charge_cpn_amt

         , SUM(t1.seller_funded_discount_amt + t1.woowa_funded_discount_amt) AS discount_amt
         , SUM(t1.woowa_funded_discount_amt)  AS company_charge_discount_amt        
         , SUM(t1.seller_funded_discount_amt) AS seller_charge_discount_amt

    FROM   cl_epm.order_dd_fact t1
           LEFT JOIN comm_svc_type t2 ON t1.svc_cd = t2.svc_cd    
    WHERE  t1.base_dt >>= CAST(IF(
                                    DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                                    DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                                    DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month))) AS VARCHAR)
    AND    t1.base_dt << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    
    AND    SUBSTR(t1.svc_cd, 1, 7) = 'S010102'

    GROUP BY 1, 2, 3, 4
    
    UNION ALL
    SELECT DATE(t1.base_dt) AS base_dt
         , t2.comm_svc_div_lv1_nm AS comm_svc_div_lv1_nm
         , CASE WHEN t2.comm_svc_div_lv1_nm = 'B2B커머스' THEN t2.comm_svc_div_lv1_nm 
           ELSE t2.comm_svc_div_lv2_nm END AS comm_svc_div_lv2_nm
         , t2.comm_svc_nm
                
         , SUM(t1.ord_cnt) AS ord_cnt
         , SUM(IF(t1.seller_funded_cpn_amt + t1.seller_funded_discount_amt + t1.woowa_funded_cpn_amt + t1.woowa_funded_discount_amt >> 0, t1.ord_cnt, 0)) AS benefit_ord_cnt

         , SUM(t1.seller_funded_cpn_amt + t1.seller_funded_discount_amt + t1.woowa_funded_cpn_amt + t1.woowa_funded_discount_amt) AS benefit_amt

         , SUM(t1.seller_funded_cpn_amt + t1.woowa_funded_cpn_amt)      AS cpn_use_amt
         , SUM(t1.woowa_funded_cpn_amt)  AS company_charge_cpn_amt
         , SUM(t1.seller_funded_cpn_amt) AS seller_charge_cpn_amt

         , SUM(t1.seller_funded_discount_amt + t1.woowa_funded_discount_amt) AS discount_amt
         , SUM(t1.woowa_funded_discount_amt)  AS company_charge_discount_amt        
         , SUM(t1.seller_funded_discount_amt) AS seller_charge_discount_amt

    FROM   cl_epm.order_dd_fact t1
           LEFT JOIN comm_svc_type t2 ON t1.svc_cd = t2.svc_cd
    WHERE  t1.base_dt >>= CAST(IF(
                                    DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)) <<= DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                                    DATE(DATE_TRUNC('week',  DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month)),
                                    DATE(DATE_TRUNC('month', DATE(NOW() AT TIME ZONE 'Asia/Seoul') - interval '24' month))) AS VARCHAR)
    AND    t1.base_dt << CAST(DATE(NOW() + interval '9' hour) AS VARCHAR)
    
    AND    SUBSTR(t1.svc_cd, 1, 7) = 'S010102'
    
    GROUP BY 1, 2, 3, 4
    )
    

SELECT base_dt -- 일자
     , DATE_TRUNC('week', base_dt)  AS ww_start_dt -- 일자가 속한 주의 시작일자
     , DATE_TRUNC('month', base_dt) AS mm_start_dt -- 일자가 속한 월의 시작일자
     , comm_svc_div_lv1_nm -- 커머스 서비스 구분 1 레벨 (커머스, B2C커머스, B2B커머스)
     , comm_svc_div_lv2_nm -- 커머스 서비스 구분 2 레벨 (커머스, B2B커머스, 배달, 기타)   ** 커머스 서비스 구분 1레벨 중 <<B2C 커머스>>만 배달과 기타로 나누어집니다. 커머스 서비스 구분 1레벨이 <<B2B 커머스>>외의 값들은 커머스 서비스 구분 1레벨과 같은 값이 들어갑니다.
     , comm_svc_nm -- 서비스 이름  ** 이 값이 커머스인 경우 커머스 총계, 배달인 경우 배달커머스 총계, 기타인 경우 기타커머스 총계, B2B커머스인 경우 B2B커머스 총계값을 의미합니다.
     , key AS subject_gubun
     
     , ord_cnt          -- 주문수
     , benefit_ord_cnt  -- 고객혜택적용주문수

     , benefit_amt -- 0.고객혜택금액 (=1 + 2)

     , cpn_use_amt            -- 1.쿠폰사용금액 (=1.1 + 1.2)
     , company_charge_cpn_amt -- 1.1.회사부담쿠폰금액
     , seller_charge_cpn_amt  -- 1.2.판매자부담쿠폰금액
     
     , discount_amt                -- 2.할인금액 (=2.1 + 2.2)
     , company_charge_discount_amt -- 2.1.회사부담할인금액
     , seller_charge_discount_amt  -- 2.2.판매자부담할인금액
     
     , benefit_amt * 1e0 / benefit_ord_cnt AS avg_benefit_amt -- 평균고객혜택금액
     
FROM   ord_fact

cross join
      unnest(array['회사부담','판매자부담'],
      array['company_charge_cpn_amt','company_charge_cpn_amt' ])
      t2(KEY,VALUE)]]></relation>
        </properties>
        <properties context='extract'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </properties>
      </object>
    </objects>
  </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
</datasource>
