  <actions>
    <action caption='Show Query' name='[Action1]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Performance Summary' type='sheet'>
        <exclude-sheet name='Query' />
      </source>
      <link caption='Show Query' delimiter=',' escape='\' expression='tsl:Performance%20Summary?%5BPerfData%5D.%5BStart%20Index%5D~s0=&lt;[Start Index]~na&gt;' include-null='true' multi-select='true' url-escape='true' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Timeline,Events' />
        <param name='on-empty' value='none' />
        <param name='target' value='Performance Summary' />
      </command>
    </action>
    <action caption='Highlight1' name='[Action2]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Performance Summary' type='sheet'>
        <exclude-sheet name='Query' />
      </source>
      <command command='tsc:brush'>
        <param name='exclude' value='Query' />
        <param name='field-captions' value='Start Index' />
        <param name='target' value='Performance Summary' />
      </command>
    </action>
    <action caption='Highlight Activity Using Name' name='[Action3]'>
      <activation auto-clear='true' type='on-hover' />
      <source dashboard='Detailed Views' type='sheet' />
      <command command='tsc:brush'>
        <param name='field-captions' value='Activity Name' />
        <param name='target' value='Detailed Views' />
      </command>
    </action>
    <datasources>
      <datasource caption='Timeline' name='PerfData' />
    </datasources>
    <datasource-dependencies datasource='PerfData'>
      <column aggregation='Sum' datatype='integer' name='[Start Index]' role='dimension' type='ordinal' />
    </datasource-dependencies>
  </actions>
  <worksheets>
    <worksheet name='Depth'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='12'>The Depth view shows the high level activities at the top. Activities lower down are spawned by higher level activities</run>
          </formatted-text>
