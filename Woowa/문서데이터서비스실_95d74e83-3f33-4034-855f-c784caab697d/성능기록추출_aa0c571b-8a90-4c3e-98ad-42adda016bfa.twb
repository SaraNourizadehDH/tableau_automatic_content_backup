      <aliases enabled='yes' />
      <column caption='XMLParseContext' datatype='string' name='[Calculation_1488721198621999107]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF Contains([Path], &quot;DataConnection_connect&quot;)&#13;&#10;THEN &quot;Connecting&quot;&#13;&#10;ELSEIF Contains([Path], &quot;DocumentManifestParser&quot;)&#13;&#10;THEN &quot;ManifestReader&quot;&#13;&#10;ELSEIF Contains([Path], &quot;ProgressReporter&quot;)&#13;&#10;THEN &quot;ProgressReporter&quot;&#13;&#10;ELSEIF CONTAINS([Path], &quot;LoadWorkbook&quot;)&#13;&#10;      AND [Event Name] != &quot;Workspace_SetFromDOM&quot;&#13;&#10;      AND CONTAINS([Path], &quot;FbudDOMParser&quot;)&#13;&#10;THEN &quot;LoadWorkbook&quot;&#13;&#10;ELSEIF CONTAINS([Path], &quot;DOMParser&quot;)&#13;&#10;THEN &quot;Unknown&quot;&#13;&#10;END' />
      </column>
      <column caption='IsXMLStringOrFile' datatype='string' name='[Calculation_1488721198623068164]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Path], &quot;ParseString&quot;)&#13;&#10;    OR CONTAINS([Path], &quot;ParseXmlString&quot;)&#13;&#10;THEN &quot;String&quot;&#13;&#10;ELSEIF CONTAINS([Path], &quot;ParseFile&quot;)&#13;&#10;    OR CONTAINS([Path], &quot;ParseXmlFile&quot;)&#13;&#10;THEN &quot;File&quot;&#13;&#10;END' />
      </column>
      <column caption='Activity Name' datatype='string' name='[Calculation_2209578631792095232]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Event Name]&#13;&#10;WHEN &quot;Action&quot; THEN [Action Name]&#13;&#10;WHEN &quot;Command&quot; THEN [Command Name]&#13;&#10;WHEN &quot;command&quot; THEN [Command Name]&#13;&#10;WHEN &quot;Dialog&quot; THEN [Dialog Name]&#13;&#10;WHEN &quot;JobManager&quot; THEN [Job Name]&#13;&#10;WHEN &quot;ProgressReporter&quot; THEN [Task Name]&#13;&#10;WHEN &quot;Task&quot; THEN [Task Name]&#13;&#10;ELSE [Event Name]&#13;&#10;END' />
        <aliases>
          <alias key='&quot;add_cached_abstract_query&quot;' value='Add Abstract Query to Cache' />
          <alias key='&quot;aqc_key_construct&quot;' value='Construct Abstract Query Cache Key' />
          <alias key='&quot;aqc_key_serialize&quot;' value='Serialize Abstract Query Cache Key' />
          <alias key='&quot;bootstrap-session&quot;' value='bootstrap-session (initial view load)' />
          <alias key='&quot;CachingDomParser_GetDom&quot;' value='Get DOM From Cache' />
          <alias key='&quot;data-interpreter&quot;' value='Create worksheet data' />
          <alias key='&quot;ds-connect-data-connection&quot;' value='Connecting to Data Source' />
          <alias key='&quot;ds-load-metadata&quot;' value='Load Connection Metadata' />
          <alias key='&quot;ds-validate&quot;' value='Validate Connection' />
          <alias key='&quot;ec-drop&quot;' value='Remove from external cache' />
          <alias key='&quot;ec-load&quot;' value='Retrieve from external cache' />
          <alias key='&quot;ec-store&quot;' value='Add to external cache' />
          <alias key='&quot;prepare_qs&quot;' value='Prepare Query Batch' />
          <alias key='&quot;process-query-batch&quot;' value='Process Query Batch' />
          <alias key='&quot;VQLSession_CloneAndRecreateData&quot;' value='Clone Session And Recreate Data (found partial match or full match with out of date data)' />
          <alias key='&quot;VQLSession_LoadWorkbookFromDom&quot;' value='Load Workbook from Cached DOM (DOM cache hit)' />
          <alias key='&quot;VQLSession_LoadWorkbookFromFile&quot;' value='Load Workbook From File or Cached DOM (no shared-session match)' />
          <alias key='&quot;VQLSession_LoadWorkbookFromFileOrFromSharedSession&quot;' value='Load Workbook From File Or From Shared Session' />
          <alias key='&quot;WorkbookParser&quot;' value='Generate Workbook Model (i.e. Workbook Doc) from XML DOM' />
          <alias key='&quot;WorkbookParser_SetWorksheetDOM&quot;' value='Generate Worksheet Model (i.e. Worksheet Doc) from XML DOM' />
        </aliases>
      </column>
      <column caption='Elapsed_Inclusive_Exclusive' datatype='string' name='[Calculation_2836423389723029504]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
      </column>
      <column caption='Wait Time' datatype='real' name='[Calculation_3117898366541615104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Elapsed Time] - [Processor Time Inclusive]' />
      </column>
      <column datatype='string' hidden='true' name='[Component]' role='dimension' type='nominal' />
      <column aggregation='Sum' caption='Context Id' datatype='integer' name='[ContextId]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Dashboard]' role='dimension' type='nominal'>
