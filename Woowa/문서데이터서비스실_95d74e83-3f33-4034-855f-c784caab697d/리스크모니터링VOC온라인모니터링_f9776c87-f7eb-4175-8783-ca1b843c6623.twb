          <calculation class='tableau' formula='&quot;&quot;' />
        </column>
        <column alias='내림차순' caption='오름/내림 정렬' datatype='integer' datatype-customized='true' name='[키워드 다중입력(2 복사본)]' param-domain-type='list' role='measure' type='quantitative' value='2'>
          <calculation class='tableau' formula='2' />
          <aliases>
            <alias key='1' value='오름차순' />
            <alias key='2' value='내림차순' />
          </aliases>
