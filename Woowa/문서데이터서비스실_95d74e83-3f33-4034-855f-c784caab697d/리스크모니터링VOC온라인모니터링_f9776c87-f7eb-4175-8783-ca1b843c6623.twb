      <datasource-dependencies datasource='Parameters'>
        <column caption='조회기간 구분값' datatype='string' name='[View Cnt 매개 변수]' param-domain-type='list' role='measure' type='nominal' value='&quot;월별&quot;'>
          <calculation class='tableau' formula='&quot;월별&quot;' />
          <members>
            <member value='&quot;주별&quot;' />
            <member value='&quot;월별&quot;' />
          </members>
        </column>
        <column caption='키워드 다중입력' datatype='string' name='[조회기간 구분값(복사본)]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
          <calculation class='tableau' formula='&quot;&quot;' />
        </column>
        <column alias='내림차순' caption='오름/내림 정렬' datatype='integer' datatype-customized='true' name='[키워드 다중입력(2 복사본)]' param-domain-type='list' role='measure' type='quantitative' value='2'>
          <calculation class='tableau' formula='2' />
          <aliases>
            <alias key='1' value='오름차순' />
            <alias key='2' value='내림차순' />
          </aliases>
          <members>
            <member alias='오름차순' value='1' />
            <member alias='내림차순' value='2' />
          </members>
        </column>
        <column alias='날짜' caption='정렬' datatype='integer' datatype-customized='true' name='[키워드 다중입력(복사본)]' param-domain-type='list' role='measure' type='quantitative' value='1'>
          <calculation class='tableau' formula='1' />
          <aliases>
            <alias key='1' value='날짜' />
            <alias key='2' value='서비스' />
            <alias key='3' value='대상' />
            <alias key='4' value='대분류' />
            <alias key='5' value='중분류' />
            <alias key='6' value='소분류' />
          </aliases>
          <members>
            <member alias='날짜' value='1' />
            <member alias='서비스' value='2' />
            <member alias='대상' value='3' />
            <member alias='대분류' value='4' />
            <member alias='중분류' value='5' />
