      <datasource-dependencies datasource='sqlproxy.173mrl00v6eys21gyckoj1vow872'>
        <column caption='Reg_dt_custom' datatype='datetime' name='[Calculation_118149147270627333]' role='dimension' type='quantitative'>
          <calculation class='tableau' formula='CASE [Parameters].[View Cnt 매개 변수]&#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;week&apos;, [reg_dt])&#10;&#10;WHEN &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;, [reg_dt])&#10;END' />
        </column>
        <column aggregation='Count' caption='Emotion_group' datatype='string' default-type='nominal' layered='true' name='[Emotion (그룹)]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
          <calculation class='categorical-bin' column='[emotion]' new-bin='true'>
            <bin default-name='false' value='&quot;부정&quot;'>
              <value>&quot;부정&quot;</value>
              <value>&quot;불만&quot;</value>
            </bin>
            <bin default-name='false' value='&quot;중립&quot;'>
              <value>&quot;단순&quot;</value>
              <value>&quot;중립&quot;</value>
            </bin>
          </calculation>
        </column>
        <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Service_group]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
          <calculation class='categorical-bin' column='[service]' new-bin='true'>
            <bin default-name='false' value='&quot;B마트&quot;'>
              <value>&quot;B마트&quot;</value>
              <value>&quot;b마트&quot;</value>
            </bin>
            <bin default-name='false' value='&quot;배민1&quot;'>
              <value>&quot;배민1&quot;</value>
              <value>&quot;배민라이더스&quot;</value>
            </bin>
          </calculation>
        </column>
        <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[Target_group]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
          <calculation class='categorical-bin' column='[target]' new-bin='true'>
            <bin default-name='false' value='&quot;고객&quot;'>
              <value>&quot;고객&quot;</value>
              <value>&quot;소비자&quot;</value>
            </bin>
            <bin default-name='false' value='&quot;라이더&quot;'>
