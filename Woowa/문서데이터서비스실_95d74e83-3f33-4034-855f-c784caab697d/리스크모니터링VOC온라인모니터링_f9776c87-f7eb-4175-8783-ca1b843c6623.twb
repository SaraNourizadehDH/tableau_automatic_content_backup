            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='조회기간 구분값' datatype='string' name='[View Cnt 매개 변수]' param-domain-type='list' role='measure' type='nominal' value='&quot;월별&quot;'>
              <calculation class='tableau' formula='&quot;월별&quot;' />
            </column>
            <column caption='키워드 다중입력' datatype='string' name='[조회기간 구분값(복사본)]' param-domain-type='any' role='measure' type='nominal' value='&quot;&quot;'>
              <calculation class='tableau' formula='&quot;&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.173mrl00v6eys21gyckoj1vow872'>
            <column caption='Reg_dt_custom' datatype='datetime' name='[Calculation_118149147270627333]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[View Cnt 매개 변수]&#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;week&apos;, [reg_dt])&#10;&#10;WHEN &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;, [reg_dt])&#10;END' />
            </column>
            <column caption='keyword_search' datatype='boolean' name='[Calculation_140385675257016321]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(CONTAINS([content], SPLIT([Parameters].[조회기간 구분값(복사본)],&apos;,&apos;,1)) and&#10;SPLIT([Parameters].[조회기간 구분값(복사본)],&apos;,&apos;,1)!=&apos;&apos;)&#10;or &#10;(CONTAINS([content], SPLIT([Parameters].[조회기간 구분값(복사본)],&apos;,&apos;,2)) and&#10;SPLIT([Parameters].[조회기간 구분값(복사본)],&apos;,&apos;,2)!=&apos;&apos;)&#10;or&#10;(CONTAINS([content], SPLIT([Parameters].[조회기간 구분값(복사본)],&apos;,&apos;,3)) and&#10;SPLIT([Parameters].[조회기간 구분값(복사본)],&apos;,&apos;,3)!=&apos;&apos;)&#10;or&#10;(CONTAINS([content], SPLIT([Parameters].[조회기간 구분값(복사본)],&apos;,&apos;,4)) and&#10;SPLIT([Parameters].[조회기간 구분값(복사본)],&apos;,&apos;,4)!=&apos;&apos;)&#10;or&#10;(CONTAINS([content], SPLIT([Parameters].[조회기간 구분값(복사본)],&apos;,&apos;,1)))' />
            </column>
            <column caption='1' datatype='integer' name='[Calculation_154459440799617029]' role='measure' type='quantitative' user:unnamed='검색_대상(파이)_온'>
