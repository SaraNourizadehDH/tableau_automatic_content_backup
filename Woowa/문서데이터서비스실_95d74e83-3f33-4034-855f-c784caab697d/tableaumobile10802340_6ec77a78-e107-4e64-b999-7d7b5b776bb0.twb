            AND DATE([std_dt]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;, [Calculation_321796301139771406])))
 ELSE [std_cd] = &apos;M&apos;
            AND DATE([std_dt]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;, [Calculation_321796301139771406])))
 END
)
END&quot;</attribute>
