      </column>
      <column caption='Last 2 years' datatype='boolean' name='[Calculation_7141109233918018]' role='measure' type='nominal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;,ATTR([Calculation_5241109191228142]),TOTAL(MAX([Calculation_5241109191228142])))&lt;=2' scope-isolation='false'>
          <table-calc ordering-type='Rows' />
