    <worksheet name='Customer trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='false' fontalignment='1' fontcolor='#d7d7d7' fontsize='8'>Most Recent Sale </run>
            <run bold='false' fontalignment='1' fontcolor='#d7d7d7' fontsize='8'>&lt;</run>
            <run bold='false' fontalignment='1' fontcolor='#d7d7d7' fontsize='8'>[Sample - Superstore Subset (Excel)].[usr:Last value (copy):qk]</run>
            <run bold='false' fontalignment='1' fontcolor='#d7d7d7' fontsize='8'>&gt;</run>
            <run bold='false' fontalignment='1' fontcolor='#d7d7d7' fontsize='8'>Æ  </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name='Sample - Superstore Subset (Excel)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Month' caption='Period Selection' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly&quot;'>
              <calculation class='tableau' formula='&quot;Monthly&quot;' />
              <aliases>
                <alias key='&quot;Daily&quot;' value='Day' />
                <alias key='&quot;Monthly&quot;' value='Month' />
                <alias key='&quot;Quarterly&quot;' value='Quarter' />
                <alias key='&quot;Weekly&quot;' value='Week' />
                <alias key='&quot;Yearly&quot;' value='Year' />
              </aliases>
            </column>
            <column caption='Measure select' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Sales&quot;'>
              <calculation class='tableau' formula='&quot;Sales&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='Sample - Superstore Subset (Excel)'>
            <column caption='Select Measure' datatype='real' name='[Calculation_1240804110716982]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4]==&apos;Sales&apos; THEN SUM([Sales])&#13;&#10;ELSEIF [Parameters].[Parameter 4]==&apos;Profit&apos; THEN SUM([Profit])&#13;&#10;ELSEIF [Parameters].[Parameter 4]==&apos;Orders&apos; THEN SUM([Quantity ordered new])&#13;&#10;ELSEIF [Parameters].[Parameter 4]==&apos;Discount&apos; THEN (AVG([Discount])*100)&#13;&#10;ELSEIF [Parameters].[Parameter 4]==&apos;Shipping&apos; THEN SUM([Shipping Cost])&#13;&#10;END' />
            </column>
            <column caption='Date' datatype='datetime' default-format='*dd-mmm-yy' name='[Calculation_5241109191228142]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF  [Parameters].[Parameter 3]=&apos;Yearly&apos; THEN DATETRUNC(&apos;year&apos;,[Order Date])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Quarterly&apos; THEN DATETRUNC(&apos;quarter&apos;,[Order Date])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[Order Date])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[Order Date])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Daily&apos; THEN DATETRUNC(&apos;day&apos;,[Order Date])&#13;&#10;END' scope-isolation='false' />
            </column>
            <column datatype='string' name='[Customer Name]' role='dimension' type='nominal' />
            <column aggregation='Avg' datatype='real' default-format='p0.0%' name='[Discount]' role='measure' type='quantitative' />
            <column caption='Last 1 years' datatype='boolean' name='[Last 2 years (copy 2)]' role='measure' type='nominal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;,ATTR([Calculation_5241109191228142]),TOTAL(MAX([Calculation_5241109191228142])))&lt;=1' scope-isolation='false'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
