        <calculation class='tableau' formula='ZN([Calculation_5811109225614049]/[Current Value (copy)])' scope-isolation='false'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Last' datatype='integer' name='[Calculation_4171113133237769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LAST()' scope-isolation='false'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Date' datatype='datetime' default-format='*dd-mmm-yy' name='[Calculation_5241109191228142]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF  [Parameters].[Parameter 3]=&apos;Yearly&apos; THEN DATETRUNC(&apos;year&apos;,[Order Date])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Quarterly&apos; THEN DATETRUNC(&apos;quarter&apos;,[Order Date])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[Order Date])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Weekly&apos; THEN DATETRUNC(&apos;week&apos;,[Order Date])&#13;&#10;ELSEIF [Parameters].[Parameter 3]=&apos;Daily&apos; THEN DATETRUNC(&apos;day&apos;,[Order Date])&#13;&#10;END' scope-isolation='false' />
      </column>
