      <column caption='Current Value' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_5841109194457908]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//IF ISNULL([Current]) then NULL ELSE SUM([Sales]) end&#13;&#10;ZN(LOOKUP(WINDOW_SUM(IIF([Calculation_9381109183949895],ZN(SUM([Sales])),NULL)),0))' scope-isolation='false'>
          <table-calc ordering-type='Rows' />
