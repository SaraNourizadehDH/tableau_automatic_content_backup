          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0xf0xth0eyfcxi18je2dg0jlxylk'>
            <column caption='사장님_value' datatype='real' name='[Calculation_6895433266872922151]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [base] = &apos;owner&apos; then [Pivot Field Values] end' />
            </column>
            <column caption='상태' datatype='string' name='[Calculation_6895433266873397290]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if sum([Calculation_6895433266872922151]) &gt;= sum([사장님_value (copy)_6895433266873184296]) and sum([Calculation_6895433266872922151]) &gt;= sum([지역평균_value (copy)_6895433266873315369]) then &quot;좋아요&quot;&#10;elseif sum([Calculation_6895433266872922151]) &lt; sum([사장님_value (copy)_6895433266873184296]) and sum([Calculation_6895433266872922151]) &lt; sum([지역평균_value (copy)_6895433266873315369]) then &quot;성장이 필요해요&quot;&#10;else &quot;관심이 필요해요&quot;&#10;end' />
