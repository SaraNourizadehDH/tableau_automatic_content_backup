      <size maxheight='900' maxwidth='1300' minheight='900' minwidth='1300' sizing-mode='fixed' />
      <datasources>
        <datasource caption='매개 변수' name='Parameters' />
        <datasource caption='vendor' name='federated.1rcu1mp18yat1c1a3mhce0zxb8b2' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column alias='월간 실적' caption='p_monthly_weekly' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;monthly&quot;'>
          <calculation class='tableau' formula='&quot;monthly&quot;' />
          <aliases>
            <alias key='&quot;monthly&quot;' value='월간 실적' />
            <alias key='&quot;weekly&quot;' value='주간 실적' />
          </aliases>
          <members>
            <member alias='월간 실적' value='&quot;monthly&quot;' />
            <member alias='주간 실적' value='&quot;weekly&quot;' />
          </members>
        </column>
        <column caption='c_대상' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total&quot;'>
          <calculation class='tableau' formula='&quot;Total&quot;' />
          <members>
            <member value='&quot;Total&quot;' />
            <member value='&quot;신규/재가입&quot;' />
            <member value='&quot;이탈&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1rcu1mp18yat1c1a3mhce0zxb8b2'>
        <column caption='c_axis_name' datatype='string' name='[Calculation_6628594990338150426]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;monthly&apos; then right(str(year([Calculation_6628594990193860630])),2) + &quot;년&quot; + str(month([Calculation_6628594990193860630])) + &quot;월&quot;&#10;when &apos;weekly&apos; then  right(str(year([Calculation_6628594990193860630])),2) + &quot;년&quot; + str(month([Calculation_6628594990193860630])) + &quot;월&quot; + str(week([Calculation_6628594990193860630])-week(datetrunc(&apos;month&apos;,[Calculation_6628594990193860630]))+1) + &quot;주&quot;&#10;end' />
        </column>
        <column-instance column='[Calculation_6628594990338150426]' derivation='None' name='[none:Calculation_6628594990338150426:nk]' pivot='key' type='nominal' />
        <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
        <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
