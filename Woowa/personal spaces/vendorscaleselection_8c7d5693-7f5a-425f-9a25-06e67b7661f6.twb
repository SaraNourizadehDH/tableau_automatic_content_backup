      <repository-location id='Only' path='/t/Woowa/workbooks/vendorscale_selection' revision='' site='Woowa' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_28' value='bottom' />
          <format attr='vertical-align' id='dash-text_43' value='bottom' />
