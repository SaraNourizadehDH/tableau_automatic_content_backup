      <column caption='CPC owner' datatype='integer' name='[CPC_owner]' role='measure' type='quantitative' />
      <column caption='플랫폼 업주수' datatype='string' name='[Calculation_6628594989811589123]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;플랫폼 업주수&apos;' />
      </column>
      <column caption='c_recent_total_value' datatype='integer' name='[Calculation_6628594989822324743]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;monthly&apos; then  (if datetrunc(&apos;month&apos;,[Calculation_6628594990155673609]) = datetrunc(&apos;month&apos;,[Parameters].[Parameter 2]) then [Calculation_6628594990417399848] end)&#10;when &apos;weekly&apos; then  (if datetrunc(&apos;week&apos;,[c_monthly_date (copy)_6628594990192619540]) = datetrunc(&apos;week&apos;,[Parameters].[p_monthly_date (copy)_6628594990196457497]) then [Calculation_6628594990417399848] end)&#10;end' />
      </column>
      <column caption='c_monthly_date' datatype='date' name='[Calculation_6628594990155673609]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [std_dt] = {fixed : max([std_dt])}  then [std_dt]&#10;elseif {fixed : max([std_dt])} &gt; [monthend_dt] then [monthend_dt] end' />
      </column>
      <column caption='c_month_dt_t|f' datatype='boolean' name='[Calculation_6628594990156541962]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[std_dt] = [monthend_dt] or&#10;[std_dt] = {fixed : max([std_dt])}' />
      </column>
      <column caption='기준일자' datatype='date' name='[Calculation_6628594990161330188]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed : max([std_dt])}' />
      </column>
      <column caption='mom_wow' datatype='integer' name='[Calculation_6628594990168846350]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_6628594989822324743]) - sum([Calculation_6628594990171869201])' />
      </column>
      <column caption='c_last_month' datatype='boolean' name='[Calculation_6628594990171344912]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, dateadd(&apos;month&apos;,-1,[Parameters].[Parameter 2])) = DATETRUNC(&apos;month&apos;, [Calculation_6628594990155673609])' />
      </column>
      <column caption='c_last_total_value' datatype='integer' name='[Calculation_6628594990171869201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;monthly&apos; then (if [Calculation_6628594990171344912] then [Calculation_6628594990417399848] end)&#10;when &apos;weekly&apos; then (if [c_last_month (copy)_6628594990420033577] then [Calculation_6628594990417399848] end)&#10;end' />
      </column>
      <column caption='mom_wow %' datatype='real' name='[Calculation_6628594990175739923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if round([Calculation_6628594990168846350]/sum([Calculation_6628594990171869201]),5) = 0 then 0&#10;else [Calculation_6628594990168846350]/sum([Calculation_6628594990171869201]) end' />
      </column>
      <column caption='c_monthly_weekly_dt' datatype='date' name='[Calculation_6628594990193860630]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;monthly&apos; then (if isnull([total_plat_owner]) = false then [Calculation_6628594990155673609] end)&#10;when &apos;weekly&apos; then (if isnull([total_plat_owner]) = false then [c_monthly_date (copy)_6628594990192619540] end)&#10;end' />
      </column>
      <column caption='c_dt_t|f' datatype='boolean' name='[Calculation_6628594990194528280]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;monthly&apos; then [Calculation_6628594990156541962]&#10;when &apos;weekly&apos; then [c_month_dt_t|f (copy)_6628594990194081815]&#10;end' />
      </column>
      <column caption='c_axis_name' datatype='string' name='[Calculation_6628594990338150426]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;monthly&apos; then right(str(year([Calculation_6628594990193860630])),2) + &quot;년&quot; + str(month([Calculation_6628594990193860630])) + &quot;월&quot;&#10;when &apos;weekly&apos; then  right(str(year([Calculation_6628594990193860630])),2) + &quot;년&quot; + str(month([Calculation_6628594990193860630])) + &quot;월&quot; + str(week([Calculation_6628594990193860630])-week(datetrunc(&apos;month&apos;,[Calculation_6628594990193860630]))+1) + &quot;주&quot;&#10;end' />
      </column>
      <column caption='c_date_range' datatype='boolean' name='[Calculation_6628594990378020895]' role='measure' type='nominal'>
        <calculation class='tableau' formula='last() &lt; 12'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='지역' datatype='string' name='[Calculation_6628594990383980578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;total&apos;' />
      </column>
      <column caption='신규/재가입' datatype='string' name='[Calculation_6628594990385565731]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;신규/재가입&apos;' />
      </column>
      <column caption='c_value' datatype='integer' name='[Calculation_6628594990417399848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 3]&#10;when &apos;Total&apos; then [total_plat_owner]&#10;when &apos;신규/재가입&apos; then [new_re_plat_owner]&#10;when &apos;이탈&apos; then [exit_plat_owner]&#10;end' />
      </column>
      <column caption='c_new_re_plat_owner' datatype='integer' name='[Calculation_6628594990486364203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ZN(SUM([new_re_plat_owner])) - LOOKUP(ZN(SUM([new_re_plat_owner])), -1) &lt; 0 then&#10;    ZN(SUM([new_re_plat_owner])) - LOOKUP(ZN(SUM([new_re_plat_owner])), -1) +&#10;//    sum(if date(dateadd(&apos;day&apos;, -1, datetrunc(&apos;month&apos;,[c_monthly_weekly_dt]))) = [Std Dt]-1 then [New Re Plat Owner] end)&#10;    zn(sum({FIXED datetrunc(&apos;month&apos;, [Calculation_6628594990193860630]) : MAX( IF [std_dt] = date(DATEADD(&apos;day&apos;, -1, DATETRUNC(&apos;month&apos;, [Calculation_6628594990193860630]))) THEN [new_re_plat_owner] END)}))&#10;&#10;else ZN(SUM([new_re_plat_owner])) - LOOKUP(ZN(SUM([new_re_plat_owner])), -1)&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='test' datatype='integer' name='[Calculation_6628594990502641729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if date(dateadd(&apos;day&apos;, -1, datetrunc(&apos;month&apos;,[Calculation_6628594990193860630]))) = date([std_dt]) then [new_re_plat_owner] end)' />
      </column>
      <column caption='zn(sum({FIXED datetrunc(&apos;month&apos;, [c_monthly_weekly_dt]) : MAX...' datatype='integer' name='[Calculation_6628594990509158480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum({FIXED datetrunc(&apos;month&apos;, [Calculation_6628594990193860630]) : MAX( IF [std_dt]-1 = date(DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Calculation_6628594990193860630])))) THEN [new_re_plat_owner] END)}))' />
      </column>
      <column caption='c_new_re_max' datatype='integer' name='[Calculation_6628594990510653524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='max({fixed year([std_dt]), month([std_dt]) : sum(&#10;&#10;if [std_dt] = datetrunc(&apos;month&apos;,[std_dt])-1&#10;then [new_re_plat_owner]&#10;end&#10;&#10;)})' />
      </column>
      <column caption='No.' datatype='integer' name='[Calculation_6628594990690394211]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
