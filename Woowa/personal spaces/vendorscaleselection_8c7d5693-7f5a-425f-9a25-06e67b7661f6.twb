              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0af7azo078axjc15lckjk10we0x5'>
            <column caption='c_cpe_owner' datatype='integer' name='[Calculation_6628594990409166886]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [date_cd] : max({fixed [date_cd],[rgn_gubun] : sum([cpe_owner])})}' />
