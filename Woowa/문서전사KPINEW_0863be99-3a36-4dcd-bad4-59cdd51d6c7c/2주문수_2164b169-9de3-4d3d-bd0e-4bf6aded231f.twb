          <datasource-dependencies datasource='sqlproxy.0668mmh0b2e1eu10tl5s302epj2c'>
            <column caption='C_픽업 주문 비율' datatype='real' name='[C_당기 픽업 주문 비율(복사본)_323133308226899977]' role='measure' type='quantitative'>
