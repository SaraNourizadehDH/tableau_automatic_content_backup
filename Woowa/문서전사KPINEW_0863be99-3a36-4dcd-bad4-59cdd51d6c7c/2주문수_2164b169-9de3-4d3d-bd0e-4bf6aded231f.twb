      <column caption='C_헤더_전동기' datatype='string' name='[C_헤더_당기(복사본)_5759259516394946575]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &quot;월별&quot; THEN &quot;vs. 전월동기&quot;&#13;&#10;WHEN &quot;주별&quot; THEN &quot;vs. 전주동기&quot;&#13;&#10;WHEN &quot;일별&quot; THEN &quot;vs. 전주동기&quot;&#13;&#10;END' />
      </column>
      <column caption='rename_svc_type' datatype='string' name='[Calculation_1437492725092151318]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [svc_type]&#13;&#10;WHEN &apos;전사&apos;&#13;&#10;THEN &apos;전 서비스&apos;&#13;&#10;ELSE [svc_type] &#13;&#10;END' />
      </column>
      <column caption='C_Date_Label_전동기' datatype='string' name='[Calculation_1666613357224980480]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN &apos;전주동기&apos;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN &apos;전주동기&apos;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN &apos;전월동기&apos;&#13;&#10;END' />
      </column>
      <column caption='C_date' datatype='string' name='[Calculation_323133308176109568]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if &#13;&#10;[Parameters].[매개 변수 1] = &apos;일별&apos; THEN IF [C_당기(복사본)_5916885504130863113] then &apos;기준일&apos;&#13;&#10;                            ELSEIF  [C_전동기(복사본)_5916885504132362251] then &apos;전주동기&apos;&#13;&#10;                            ELSEIF  [C_전년동기(복사본)_5916885504131432458] then &apos;전년동기&apos;&#13;&#10;                            END&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;[Parameters].[매개 변수 1] = &apos;주별&apos; THEN IF [C_당기(복사본)_5916885504130863113] then &apos;이번주&apos;&#13;&#10;                            ELSEIF  [C_전동기(복사본)_5916885504132362251] then &apos;전주동기&apos;&#13;&#10;                            ELSEIF  [C_전년동기(복사본)_5916885504131432458] then &apos;전년동기&apos;&#13;&#10;                            END&#13;&#10;ELSEIF &#13;&#10;[Parameters].[매개 변수 1] = &apos;월별&apos; THEN IF [C_당기(복사본)_5916885504130863113] then &apos;이번달&apos;&#13;&#10;                            ELSEIF  [C_전동기(복사본)_5916885504132362251] then &apos;전월동기&apos;&#13;&#10;                            ELSEIF  [C_전년동기(복사본)_5916885504131432458] then &apos;전년동기&apos;&#13;&#10;                            END&#13;&#10;&#13;&#10;&#13;&#10;ELSE &apos;기타&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='F_조회기간' datatype='boolean' name='[Calculation_5219109035776319489]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &quot;월별&quot;&#13;&#10;THEN DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -12, [Parameters].[매개 변수 2 1])) &lt;= DATETRUNC(&apos;month&apos;, [base_dt])&#13;&#10;AND DATETRUNC(&apos;month&apos;, [base_dt]) &lt;= DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2 1])&#13;&#10;&#13;&#10;WHEN &quot;주별&quot;&#13;&#10;THEN DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;week&apos;, -11, [Parameters].[매개 변수 2 1])) &lt;= DATETRUNC(&apos;iso-week&apos;, [base_dt])&#13;&#10;AND DATETRUNC(&apos;iso-week&apos;, [base_dt]) &lt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2 1])&#13;&#10;&#13;&#10;WHEN &quot;일별&quot;&#13;&#10;THEN DATETRUNC(&apos;day&apos;, DATEADD(&apos;day&apos;, -13, [Parameters].[매개 변수 2 1])) &lt;= DATETRUNC(&apos;day&apos;, [base_dt])&#13;&#10;AND DATETRUNC(&apos;day&apos;, [base_dt]) &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2 1])&#13;&#10;&#13;&#10;END' />
