            <column caption='C_당기 픽업 주문수' datatype='integer' name='[C_당기 OD 주문수(복사본)_1437492725131485247]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [C_당기(복사본)_5916885504130863113] THEN [pickup_ord_cnt] END)' />
