              <calculation class='tableau' formula='([Calculation_491736810063462417] - [C_전동기 주문회원수(복사본)_491736810063638547]) / [C_전동기 주문회원수(복사본)_491736810063638547]' />
            </column>
            <column caption='C_기준일' datatype='date' name='[Calculation_1519401947912601601]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY()-1' />
            </column>
            <column caption='F_당기_조회기간' datatype='boolean' name='[Calculation_1519401947912773634]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR([Parameters].[매개 변수 2])&#13;&#10;    AND MONTH([base_dt]) = MONTH([Parameters].[매개 변수 2])&#13;&#10;    AND DAY([base_dt]) &lt;= DAY([Parameters].[매개 변수 2])&#13;&#10;    AND [base_dt_type] = &apos;M&apos;&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] &gt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])&#13;&#10;    AND [base_dt] &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])&#13;&#10;    AND [base_dt_type] = &apos;W&apos;&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = [Parameters].[매개 변수 2]&#13;&#10;    AND [base_dt_type] = &apos;D&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='F_전년동기_조회기간' datatype='boolean' name='[Calculation_1519401947912835075]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN DATETRUNC(&apos;month&apos;, [base_dt]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;year&apos;,-1, [Parameters].[매개 변수 2]))&#13;&#10;    AND [base_dt_type] = &apos;M&apos;&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN DATETRUNC(&apos;iso-week&apos;, [base_dt]) = DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;year&apos;,-1, [Parameters].[매개 변수 2]))&#13;&#10;    AND [base_dt_type] = &apos;W&apos;&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN DATETRUNC(&apos;day&apos;,[base_dt]) = DATETRUNC(&apos;day&apos;, DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND [base_dt_type] = &apos;D&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='F_전동기_조회기간' datatype='boolean' name='[Calculation_1519401947912871940]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN DATETRUNC(&apos;month&apos;, [base_dt]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;,-1, [Parameters].[매개 변수 2]))&#13;&#10;    AND [base_dt_type] = &apos;M&apos;&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN DATETRUNC(&apos;iso-week&apos;, [base_dt]) = DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;,-1, [Parameters].[매개 변수 2]))&#13;&#10;    AND [base_dt_type] = &apos;W&apos;&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN DATETRUNC(&apos;day&apos;,[base_dt]) = DATETRUNC(&apos;day&apos;, DATEADD(&apos;iso-week&apos;, -1, [Parameters].[매개 변수 2]))  &#13;&#10;END' />
            </column>
