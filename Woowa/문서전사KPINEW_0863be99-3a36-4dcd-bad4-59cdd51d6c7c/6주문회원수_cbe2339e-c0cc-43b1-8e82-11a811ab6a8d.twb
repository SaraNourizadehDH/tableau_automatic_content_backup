          <datasource-dependencies datasource='sqlproxy.1pdy2dh0pueky217iu5ph0243m9l'>
            <column caption='C_전동기 주문회원수' datatype='integer' name='[C_당기 주문회원수(복사본)_491736810063577106]' role='measure' type='quantitative'>
