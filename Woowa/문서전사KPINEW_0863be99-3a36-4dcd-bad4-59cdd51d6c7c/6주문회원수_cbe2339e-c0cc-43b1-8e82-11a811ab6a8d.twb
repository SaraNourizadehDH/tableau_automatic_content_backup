        <calculation class='tableau' formula='CASE [gubun]&#13;&#10;&#13;&#10;WHEN &apos;총계&apos;&#13;&#10;THEN &apos;주문 회원 수 총계&apos;&#13;&#10;&#13;&#10;WHEN &apos;푸드X커머스&apos;&#13;&#10;THEN &apos;푸드, 커머스 모두 이용&apos;&#13;&#10;&#13;&#10;WHEN &apos;푸드&apos;&#13;&#10;THEN &apos;푸드 &apos;&#13;&#10;WHEN &apos;커머스&apos;&#13;&#10;THEN &apos;커머스 &apos;&#13;&#10;&#13;&#10;WHEN &apos;배민&apos;&#13;&#10;THEN &apos;&apos;&#13;&#10;WHEN &apos;배민1&apos;&#13;&#10;THEN &apos;&apos;&#13;&#10;WHEN &apos;포장&apos;&#13;&#10;THEN &apos;&apos;&#13;&#10;&#13;&#10;WHEN &apos;B마트&apos;&#13;&#10;THEN &apos; &apos;&#13;&#10;WHEN &apos;배민스토어&apos;&#13;&#10;THEN &apos; &apos;&#13;&#10;WHEN &apos;배민상회&apos;&#13;&#10;THEN &apos; &apos;&#13;&#10;WHEN &apos;대용량특가&apos;&#13;&#10;THEN &apos; &apos;&#13;&#10;WHEN &apos;전국별미&apos;&#13;&#10;THEN &apos; &apos;&#13;&#10;WHEN &apos;배민쇼핑라이브&apos;&#13;&#10;THEN &apos; &apos;&#13;&#10;&#13;&#10;&#13;&#10;END' />
      </column>
