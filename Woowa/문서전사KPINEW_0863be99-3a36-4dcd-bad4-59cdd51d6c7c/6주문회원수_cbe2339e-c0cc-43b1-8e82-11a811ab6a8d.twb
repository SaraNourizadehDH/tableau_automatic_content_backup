            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[sqlproxy.1pdy2dh0pueky217iu5ph0243m9l].[Calculation_1519401947912601601]' _.fcp.RefreshableParameterRanges.true...source-field='[sqlproxy.1pdy2dh0pueky217iu5ph0243m9l].[C_base_dt]' caption='P_End_Date_Only' datatype='date' name='[매개 변수 2]' param-domain-type='range' role='measure' type='quantitative' value='#2024-07-01#'>
              <calculation class='tableau' formula='#2024-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.1pdy2dh0pueky217iu5ph0243m9l'>
            <column caption='C_주문전환율_분모(당기)' datatype='integer' name='[C_주문전환율_분모(복사본)_1158551030595108890]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [gubun] =&apos;앱주문&apos;&#13;&#10;THEN&#13;&#10;{FIXED : SUM(IF [gubun] = &apos;앱실행&apos; AND [Calculation_1519401947912773634] THEN [ord_mem_cnt(복사본)_491736810065772566] END)}&#13;&#10;ELSEIF [gubun] =&apos;앱실행&apos;&#13;&#10;THEN&#13;&#10;{FIXED : SUM(IF [gubun] = &apos;앱실행&apos; AND [Calculation_1519401947912773634] THEN [ord_mem_cnt(복사본)_491736810065772566] END)}&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='C_주문전환율_분자(당기)' datatype='integer' name='[Calculation_1158551030591057942]' role='measure' type='quantitative'>
