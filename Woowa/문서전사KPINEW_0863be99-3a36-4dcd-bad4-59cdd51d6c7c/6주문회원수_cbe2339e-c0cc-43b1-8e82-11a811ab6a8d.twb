              <calculation class='tableau' formula='CASE [gubun]&#13;&#10;WHEN &apos;앱실행&apos;&#13;&#10;THEN &apos;앱 실행 회원수&apos;&#13;&#10;WHEN &apos;앱주문&apos;&#13;&#10;THEN &apos;앱 주문 회원수&apos;&#13;&#10;END' />
