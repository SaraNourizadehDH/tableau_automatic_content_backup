      <column caption='F_전년동기_조회기간' datatype='boolean' name='[Calculation_1519401947912835075]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN DATETRUNC(&apos;month&apos;, [base_dt]) = DATETRUNC(&apos;month&apos;, DATEADD(&apos;year&apos;,-1, [Parameters].[매개 변수 2]))&#13;&#10;    AND [base_dt_type] = &apos;M&apos;&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN DATETRUNC(&apos;iso-week&apos;, [base_dt]) = DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;year&apos;,-1, [Parameters].[매개 변수 2]))&#13;&#10;    AND [base_dt_type] = &apos;W&apos;&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN DATETRUNC(&apos;day&apos;,[base_dt]) = DATETRUNC(&apos;day&apos;, DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND [base_dt_type] = &apos;D&apos;&#13;&#10;&#13;&#10;END' />
