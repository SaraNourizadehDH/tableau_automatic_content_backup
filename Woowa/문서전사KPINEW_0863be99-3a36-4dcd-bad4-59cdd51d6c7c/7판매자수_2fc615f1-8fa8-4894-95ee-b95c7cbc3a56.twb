      <column caption='C_Date_Label_vs. 전동기' datatype='string' name='[Calculation_1519401947913715718]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &quot;월별&quot; THEN &quot;vs. 전월&quot;&#13;&#10;WHEN &quot;주별&quot; THEN &quot;vs. 전주&quot;&#13;&#10;WHEN &quot;일별&quot; THEN &quot;vs. 전주동기&quot;&#13;&#10;END' />
