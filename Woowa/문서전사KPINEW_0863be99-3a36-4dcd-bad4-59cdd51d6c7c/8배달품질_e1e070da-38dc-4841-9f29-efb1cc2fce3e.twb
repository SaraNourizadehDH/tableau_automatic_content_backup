      <column caption='C_전년동기(-)' datatype='real' name='[Calculation_1502794926407659532]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [C_전동기대비(평균배달팁)(복사본)_1502794926407577611] &lt; 0 THEN [C_전동기(평균배달팁)(복사본)_1502794926407356425] END' />
      </column>
      <column caption='C_분모(ord_cnt)' datatype='integer' name='[Calculation_1502794926410489884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{SUM([ord_cnt])}' />
