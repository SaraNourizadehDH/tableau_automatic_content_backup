      <table>
        <view>
          <datasources>
            <datasource caption='8_전사KPI_NEW_배달품질(평균배달시간)' name='sqlproxy.1kn0zqt1s33bma1747bvb19rp8q5' />
            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='P_Date_Type' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;일별&quot;'>
              <calculation class='tableau' formula='&quot;일별&quot;' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[sqlproxy.1kn0zqt1s33bma1747bvb19rp8q5].[Calculation_1547830922024108038]' _.fcp.RefreshableParameterRanges.true...source-field='[sqlproxy.1kn0zqt1s33bma1747bvb19rp8q5].[base_dt]' caption='P_End_Date_Only' datatype='date' name='[매개 변수 2]' param-domain-type='range' role='measure' type='quantitative' value='#2024-07-01#'>
              <calculation class='tableau' formula='#2024-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.1kn0zqt1s33bma1747bvb19rp8q5'>
            <column caption='C_분모(dlvry_cnt)' datatype='integer' name='[C_[dlvry_time]](복사본)_1547830922034561058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{SUM([dlvry_cnt])}' />
            </column>
            <column caption='C_평균배달시간' datatype='real' name='[C_당기(OD평균배달시간)(복사본)_1547830922029719584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([dlvry_time])&#13;&#10;/&#13;&#10;SUM([dlvry_cnt])' />
            </column>
            <column caption='C_분자(OD평균배달시간)' datatype='real' name='[Calculation_1351361388578770944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({FIXED [svc_type]: [C_당기(OD평균배달시간)(복사본)_1547830922029719584]})' />
            </column>
            <column caption='C_배율(OD평균배달시간)' datatype='real' name='[Calculation_1351361388581576705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1351361388578770944]/[Calculation_1547830922034688035]' />
            </column>
            <column caption='C_기준일' datatype='date' name='[Calculation_1547830922024108038]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY()-1' />
            </column>
            <column caption='F_당기_조회기간' datatype='boolean' name='[Calculation_1547830922024464391]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR([Parameters].[매개 변수 2])&#13;&#10;    AND MONTH([base_dt]) = MONTH([Parameters].[매개 변수 2])&#13;&#10;    AND DAY([base_dt]) &lt;= DAY([Parameters].[매개 변수 2])&#13;&#10;    AND [base_dt_type] = &apos;M&apos;&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] &gt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])&#13;&#10;    AND [base_dt] &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])&#13;&#10;    AND [base_dt_type] = &apos;W&apos;&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = [Parameters].[매개 변수 2]&#13;&#10;    AND [base_dt_type] = &apos;D&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='C_분모(dlvry_time)' datatype='integer' name='[Calculation_1547830922032439329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{SUM([dlvry_time])}' />
            </column>
            <column caption='C_분모(OD평균배달시간)' datatype='real' name='[Calculation_1547830922034688035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1547830922032439329]) / SUM([C_[dlvry_time]](복사본)_1547830922034561058])' />
            </column>
            <column aggregation='Year' datatype='date' default-type='ordinal' layered='true' name='[base_dt]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[base_dt_type]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[dlvry_cnt]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column aggregation='Sum' datatype='integer' default-type='quantitative' layered='true' name='[dlvry_time]' pivot='key' role='measure' type='quantitative' user-datatype='integer' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[dlvry_type]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column-instance column='[Calculation_1547830922024464391]' derivation='None' name='[none:Calculation_1547830922024464391:nk]' pivot='key' type='nominal' />
            <column-instance column='[dlvry_type]' derivation='None' name='[none:dlvry_type:nk]' pivot='key' type='nominal' />
