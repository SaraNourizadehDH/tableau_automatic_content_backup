      <column caption='C_분모(dlvry_tip)' datatype='integer' name='[Calculation_1502794926410584093]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{SUM([dlvry_tip])}' />
      </column>
      <column caption='C_분모' datatype='real' name='[Calculation_1502794926410719262]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1502794926410584093]) / SUM([Calculation_1502794926410489884])' />
      </column>
      <column caption='C_분자' datatype='real' name='[Calculation_1502794926411149343]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({FIXED [svc_type]: [C_당기(평균배달팁)(복사본)_1502794926407147527]})' />
      </column>
      <column caption='C_배율' datatype='real' name='[Calculation_1502794926411304992]' role='measure' type='quantitative'>
