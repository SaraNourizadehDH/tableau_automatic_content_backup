      <column caption='C_알뜰배달 여부' datatype='string' name='[Calculation_1502794926405271552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [svc_nm] = &apos;배민1&apos; AND [is_stod] = 0 THEN &apos;배민1 한집&apos;&#13;&#10;ELSEIF [svc_nm] = &apos;배민1&apos; AND [is_stod] = 1 THEN &apos;배민1 알뜰&apos;&#13;&#10;ELSEIF [svc_nm] = &apos;배민&apos; THEN &apos;배민&apos;&#13;&#10;END' />
      </column>
      <column caption='C_rename_svc_nm' datatype='string' name='[Calculation_1502794926405369857]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [svc_nm] = &apos;배민1&apos; AND [is_stod] = 0 THEN &apos;배민1 한집&apos;&#13;&#10;ELSEIF [svc_nm] = &apos;배민1&apos; AND [is_stod] = 1 THEN &apos;배민1 알뜰&apos;&#13;&#10;ELSEIF [svc_nm] = &apos;배민&apos; THEN &apos;배민&apos;&#13;&#10;ELSEIF [svc_nm] = &apos;배민스토어&apos; THEN &apos;배민스토어&apos;&#13;&#10;ELSE &apos;B마트&apos;&#13;&#10;END' />
      </column>
      <column caption='C_당기' datatype='real' name='[Calculation_1502794926406393858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_1502794926406619140] THEN [dlvry_tip] END)&#13;&#10;/&#13;&#10;SUM(IF [Calculation_1502794926406619140] THEN [ord_cnt] END)' />
      </column>
      <column caption='C_기준일' datatype='date' name='[Calculation_1502794926406565891]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY()-1' />
      </column>
      <column caption='F_당기_조회기간' datatype='boolean' name='[Calculation_1502794926406619140]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR([Parameters].[매개 변수 2])&#13;&#10;    AND MONTH([base_dt]) = MONTH([Parameters].[매개 변수 2])&#13;&#10;    AND DAY([base_dt]) &lt;= DAY([Parameters].[매개 변수 2])&#13;&#10;    AND [base_dt_type] = &apos;M&apos;&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] &gt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])&#13;&#10;    AND [base_dt] &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])&#13;&#10;    AND [base_dt_type] = &apos;W&apos;&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = [Parameters].[매개 변수 2]&#13;&#10;    AND [base_dt_type] = &apos;D&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='F_전년동기_조회기간' datatype='boolean' name='[Calculation_1502794926406684677]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR(DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND MONTH([base_dt]) = MONTH(DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND DAY([base_dt]) &lt;= DAY([Parameters].[매개 변수 2])&#13;&#10;    AND [base_dt_type] = &apos;M&apos;&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] &gt;= DATETRUNC(&apos;day&apos;, DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2])))&#13;&#10;    AND [base_dt] &lt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND [base_dt_type] = &apos;W&apos;&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = DATETRUNC(&apos;day&apos;, DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND [base_dt_type] = &apos;D&apos;&#13;&#10;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='F_전동기_조회기간' datatype='boolean' name='[Calculation_1502794926406737926]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR(DATEADD(&apos;month&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND MONTH([base_dt]) = MONTH(DATEADD(&apos;month&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND DAY([base_dt]) &lt;= DAY([Parameters].[매개 변수 2])&#13;&#10;    AND [base_dt_type] = &apos;M&apos;&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;iso-week&apos;, -1, DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])))&#13;&#10;    AND [base_dt] &lt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;iso-week&apos;,-1, [Parameters].[매개 변수 2]))&#13;&#10;    AND [base_dt_type] = &apos;W&apos;&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = DATETRUNC(&apos;day&apos;, DATEADD(&apos;iso-week&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND [base_dt_type] = &apos;D&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='C_전동기대비' datatype='real' name='[Calculation_1502794926407426058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1502794926406393858]-[C_당기(평균배달팁)(복사본)_1502794926407282696])/[C_당기(평균배달팁)(복사본)_1502794926407282696]' />
