          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='P_Date_Type' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;일별&quot;'>
              <calculation class='tableau' formula='&quot;일별&quot;' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[sqlproxy.1wc106b13c3vd113dsxii0vup5n1].[Calculation_5219109035776581634]' _.fcp.RefreshableParameterRanges.true...source-field='[sqlproxy.1wc106b13c3vd113dsxii0vup5n1].[base_dt]' caption='P_End_Date_Only' datatype='date' name='[매개 변수 2 1]' param-domain-type='range' role='measure' type='quantitative' value='#2024-07-01#'>
              <calculation class='tableau' formula='#2024-07-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.1wc106b13c3vd113dsxii0vup5n1'>
            <column caption='C_pickup_gpv_ratio' datatype='real' name='[C_od_gpv_ratio(복사본)_2080944537832476686]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pickup_gpv])/SUM([gpv])' />
            </column>
            <column caption='F_당기_조회기간' datatype='boolean' name='[C_당기(복사본)_5916885504130863113]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR([Parameters].[매개 변수 2 1])&#13;&#10;    AND MONTH([base_dt]) = MONTH([Parameters].[매개 변수 2 1])&#13;&#10;    AND DAY([base_dt]) &lt;= DAY([Parameters].[매개 변수 2 1])&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] &gt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2 1])&#13;&#10;    AND [base_dt] &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2 1])&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = [Parameters].[매개 변수 2 1]&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='F_전년동기_조회기간' datatype='boolean' name='[C_전년동기(복사본)_5916885504131432458]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR(DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2 1]))&#13;&#10;    AND MONTH([base_dt]) = MONTH(DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2 1]))&#13;&#10;    AND DAY([base_dt]) &lt;= DAY([Parameters].[매개 변수 2 1])&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2 1])))&#13;&#10;    AND [base_dt] &lt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2 1]))&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = DATETRUNC(&apos;day&apos;, DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2 1]))&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='F_전동기_조회기간' datatype='boolean' name='[C_전동기(복사본)_5916885504132362251]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR(DATEADD(&apos;month&apos;, -1, [Parameters].[매개 변수 2 1]))&#13;&#10;    AND MONTH([base_dt]) = MONTH(DATEADD(&apos;month&apos;, -1, [Parameters].[매개 변수 2 1]))&#13;&#10;    AND DAY([base_dt]) &lt;= DAY([Parameters].[매개 변수 2 1])&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;iso-week&apos;, -1, DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2 1])))&#13;&#10;    AND [base_dt] &lt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;iso-week&apos;,-1, [Parameters].[매개 변수 2 1]))&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = DATETRUNC(&apos;day&apos;, DATEADD(&apos;iso-week&apos;, -1, [Parameters].[매개 변수 2 1]))&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='C_date' datatype='string' name='[Calculation_2080944537823186944]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if &#13;&#10;[Parameters].[매개 변수 1] = &apos;일별&apos; THEN IF [C_당기(복사본)_5916885504130863113] then &apos;기준일&apos;&#13;&#10;                            ELSEIF  [C_전동기(복사본)_5916885504132362251] then &apos;전주동기&apos;&#13;&#10;                            ELSEIF  [C_전년동기(복사본)_5916885504131432458] then &apos;전년동기&apos;&#13;&#10;                            END&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;[Parameters].[매개 변수 1] = &apos;주별&apos; THEN IF [C_당기(복사본)_5916885504130863113] then &apos;이번주&apos;&#13;&#10;                            ELSEIF  [C_전동기(복사본)_5916885504132362251] then &apos;전주동기&apos;&#13;&#10;                            ELSEIF  [C_전년동기(복사본)_5916885504131432458] then &apos;전년동기&apos;&#13;&#10;                            END&#13;&#10;ELSEIF &#13;&#10;[Parameters].[매개 변수 1] = &apos;월별&apos; THEN IF [C_당기(복사본)_5916885504130863113] then &apos;이번달&apos;&#13;&#10;                            ELSEIF  [C_전동기(복사본)_5916885504132362251] then &apos;전월동기&apos;&#13;&#10;                            ELSEIF  [C_전년동기(복사본)_5916885504131432458] then &apos;전년동기&apos;&#13;&#10;                            END&#13;&#10;&#13;&#10;&#13;&#10;ELSE &apos;기타&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='C_기준일' datatype='date' name='[Calculation_5219109035776581634]' role='dimension' type='ordinal'>
