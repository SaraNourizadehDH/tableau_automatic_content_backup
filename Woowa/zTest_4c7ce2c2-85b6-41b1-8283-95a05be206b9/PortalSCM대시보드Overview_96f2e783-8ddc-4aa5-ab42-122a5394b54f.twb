        <calculation class='tableau' formula='IF [Parameters].[매개 변수 2]=&apos;일별&apos;&#13;&#10;THEN LAST()&lt;=13&#13;&#10;ELSEIF [Parameters].[매개 변수 2]=&apos;주별&apos;&#13;&#10;THEN LAST()&lt;=7&#13;&#10;ELSEIF [Parameters].[매개 변수 2]=&apos;월별&apos;&#13;&#10;THEN LAST()&lt;=12&#13;&#10;END'>
