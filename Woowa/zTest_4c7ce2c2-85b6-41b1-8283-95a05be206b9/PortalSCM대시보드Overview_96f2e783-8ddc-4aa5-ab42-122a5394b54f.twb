        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#13;&#10;WHEN &apos;월별&apos; THEN &apos;`&apos; + right([year],2)+ &apos;.&apos;+ [month]&#13;&#10;WHEN &apos;주별&apos; THEN [week_seq]+&apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN [month]+ &apos;/&apos; + [day]&#13;&#10;END' />
      </column>
      <column caption='C_week' datatype='string' hidden='true' name='[C_month(복사본)_1392456715100700685]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF (DATEADD(&apos;week&apos;, -7, DATETRUNC(&apos;week&apos;,[Parameters].[C_End_Date 매개 변수],&apos;Monday&apos;))) &lt;= [Calculation_1419759843524526112] AND ([Calculation_1419759843524526112] &lt;= [Parameters].[C_End_Date 매개 변수])&#13;&#10;THEN [week_seq]+&apos;W&apos;&#13;&#10;END' />
      </column>
      <column caption='C_day' datatype='string' hidden='true' name='[C_week(복사본)_1392456715100774414]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEADD(&apos;day&apos;,-13,[Parameters].[C_End_Date 매개 변수])&lt;=[Calculation_1419759843524526112] AND DATEADD(&apos;day&apos;,-0,[Parameters].[C_End_Date 매개 변수])&gt;=[Calculation_1419759843524526112]&#13;&#10;THEN REPLACE(RIGHT(STR([Calculation_1419759843524526112]),5),&apos;-&apos;,&apos;/&apos;)&#13;&#10;END' />
      </column>
      <column caption='C_month' datatype='string' hidden='true' name='[Calculation_1392456715100667916]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEADD(&apos;month&apos;,-11,[Parameters].[C_End_Date 매개 변수])&lt;=[Calculation_1419759843524526112]  &#13;&#10;THEN RIGHT([year],2)+&apos;/&apos;+[month]&#13;&#10;END' />
      </column>
      <column caption='F_Date_Type' datatype='boolean' name='[Calculation_1392456715101196303]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#13;&#10;WHEN &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-11,[Parameters].[C_End_Date 매개 변수])) &lt;= [Calculation_1419759843524526112] and [Calculation_1419759843524526112] &lt; DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Parameters].[C_End_Date 매개 변수]))&#13;&#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-7,[Parameters].[C_End_Date 매개 변수])) &lt;= [Calculation_1419759843524526112] and [Calculation_1419759843524526112] &lt; DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,1,[Parameters].[C_End_Date 매개 변수]))&#13;&#10;WHEN &apos;일별&apos; THEN DATEADD(&apos;day&apos;,-13,[Parameters].[C_End_Date 매개 변수])&lt;=[Calculation_1419759843524526112] AND DATEADD(&apos;day&apos;,-0,[Parameters].[C_End_Date 매개 변수])&gt;=[Calculation_1419759843524526112]&#13;&#10;END' />
