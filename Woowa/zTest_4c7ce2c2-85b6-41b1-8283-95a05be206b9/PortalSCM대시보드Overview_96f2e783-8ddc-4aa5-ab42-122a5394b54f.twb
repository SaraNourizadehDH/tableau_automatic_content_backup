      <column caption='DC결품률' datatype='real' name='[C_FC결품률(복사본)_4116571602382774310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if attr([standard]) == 2 then SUM([lack_cnt])/sum([prod_cnt]) end' />
