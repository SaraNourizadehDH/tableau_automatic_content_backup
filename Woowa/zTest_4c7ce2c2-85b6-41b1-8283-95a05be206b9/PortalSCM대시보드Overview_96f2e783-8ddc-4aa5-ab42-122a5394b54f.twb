        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#13;&#10;WHEN &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-12,[Parameters].[C_End_Date 매개 변수])) &lt;= [Calculation_1943584764563673107] and [Calculation_1943584764563673107] &lt; DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Parameters].[C_End_Date 매개 변수]))&#13;&#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-7,[Parameters].[C_End_Date 매개 변수])) &lt;= [Calculation_1943584764563673107] and [Calculation_1943584764563673107] &lt; DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,1,[Parameters].[C_End_Date 매개 변수]))&#13;&#10;WHEN &apos;일별&apos; THEN DATEADD(&apos;day&apos;, -13, [Parameters].[C_End_Date 매개 변수]) &lt;= [Calculation_1943584764563673107] and [Parameters].[C_End_Date 매개 변수]&gt;=[Calculation_1943584764563673107]&#13;&#10;END' />
