      <column caption='C_Sales_gpv(%)_(매출상세)' datatype='real' name='[Calculation_1847883277889159194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Parameters].[매개 변수 2]=&apos;일별&apos;&#13;&#10;THEN (ZN(SUM([gpv])) - LOOKUP(ZN(SUM([gpv])), -7)) / ABS(LOOKUP(ZN(SUM([gpv])), -7))&#13;&#10;ELSEIF [Parameters].[매개 변수 2]=&apos;주별&apos;&#13;&#10;THEN (ZN(SUM([gpv])) - LOOKUP(ZN(SUM([gpv])), -1)) / ABS(LOOKUP(ZN(SUM([gpv])), -1))&#13;&#10;ELSEIF [Parameters].[매개 변수 2]=&apos;월별&apos;&#13;&#10;THEN (ZN(SUM([gpv])) - LOOKUP(ZN(SUM([gpv])), -12)) / ABS(LOOKUP(ZN(SUM([gpv])), -12))&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
