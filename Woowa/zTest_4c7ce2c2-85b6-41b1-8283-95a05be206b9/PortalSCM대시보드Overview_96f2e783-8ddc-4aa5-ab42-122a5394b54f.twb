        <calculation class='tableau' formula='if (SUM([lack_cnt])/sum([prod_cnt]))*100 &gt;= MAX([Calculation_3010374887700340755]*0.9)&#13;&#10;and (SUM([lack_cnt])/sum([prod_cnt]))*100 &lt;=MAX([Calculation_3010374887700340755]*1.1) &#13;&#10; then SUM([lack_cnt])/sum([prod_cnt]) end' />
