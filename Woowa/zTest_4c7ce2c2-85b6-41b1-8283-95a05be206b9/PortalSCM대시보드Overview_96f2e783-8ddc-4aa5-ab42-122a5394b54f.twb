        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#13;&#10;WHEN &apos;일별&apos; THEN DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,0,[Parameters].[C_End_Date 매개 변수])) &lt;= [Calculation_1764285219974905859] and [Calculation_1764285219974905859] &lt; DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,1,[Parameters].[C_End_Date 매개 변수]))&#13;&#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,0,[Parameters].[C_End_Date 매개 변수])) &lt;= [Calculation_1764285219974905859] and [Calculation_1764285219974905859] &lt; DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Parameters].[C_End_Date 매개 변수]))&#13;&#10;WHEN &apos;월별&apos; THEN DATETRUNC(&apos;year&apos;,DATEADD(&apos;year&apos;,0,[Parameters].[C_End_Date 매개 변수])) &lt;= [Calculation_1764285219974905859] and [Calculation_1764285219974905859] &lt; DATETRUNC(&apos;year&apos;,DATEADD(&apos;year&apos;,1,[Parameters].[C_End_Date 매개 변수]))&#13;&#10;END' />
