      <column caption='F_Date_Type' datatype='boolean' name='[Calculation_1268889251993214977]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#13;&#10;WHEN &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-11,[Parameters].[C_End_Date 매개 변수])) &lt;= [Calculation_4116571602373656609] and [Calculation_4116571602373656609] &lt; DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Parameters].[C_End_Date 매개 변수]))&#13;&#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-7,[Parameters].[C_End_Date 매개 변수])) &lt;= [Calculation_4116571602373656609] and [Calculation_4116571602373656609] &lt; DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,1,[Parameters].[C_End_Date 매개 변수]))&#13;&#10;WHEN &apos;일별&apos; THEN [Calculation_4116571602373656609] &lt;= [Parameters].[C_End_Date 매개 변수] AND (DATEADD(&apos;day&apos;, -13, [Parameters].[C_End_Date 매개 변수]) &lt;= [Calculation_4116571602373656609])&#13;&#10;END' />
      </column>
      <column caption='c_day' datatype='string' hidden='true' name='[Calculation_1392456715134017561]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEADD(&apos;day&apos;,-13,[Parameters].[C_End_Date 매개 변수])&lt;=[Calculation_4116571602373656609] AND DATEADD(&apos;day&apos;,-0,[Parameters].[C_End_Date 매개 변수])&gt;=[Calculation_4116571602373656609]&#13;&#10;THEN REPLACE(RIGHT(STR([Calculation_4116571602373656609]),5),&apos;-&apos;,&apos;/&apos;)&#13;&#10;END' />
      </column>
      <column caption='c_month' datatype='string' hidden='true' name='[Calculation_1392456715134058522]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEADD(&apos;month&apos;,-11,[Parameters].[C_End_Date 매개 변수])&lt;=[Calculation_4116571602373656609]  &#13;&#10;THEN RIGHT([year],2)+&apos;/&apos;+[month]&#13;&#10;END' />
      </column>
      <column caption='c_week' datatype='string' hidden='true' name='[Calculation_1392456715134124059]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF (DATEADD(&apos;week&apos;, -7, DATETRUNC(&apos;week&apos;,[Parameters].[C_End_Date 매개 변수],&apos;Monday&apos;))) &lt;= [Calculation_4116571602373656609] AND ([Calculation_4116571602373656609] &lt;= [Parameters].[C_End_Date 매개 변수])&#13;&#10;THEN [week_seq]+&apos;W&apos;&#13;&#10;END' />
      </column>
      <column caption='F_Date_Type(결품요약)' datatype='boolean' name='[Calculation_2760143623112544261]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#13;&#10;WHEN &apos;일별&apos; THEN DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,0,[Parameters].[C_End_Date 매개 변수])) &lt;= [Calculation_4116571602373656609] and [Calculation_4116571602373656609] &lt; DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,1,[Parameters].[C_End_Date 매개 변수]))&#13;&#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,0,[Parameters].[C_End_Date 매개 변수])) &lt;= [Calculation_4116571602373656609] and [Calculation_4116571602373656609] &lt; DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Parameters].[C_End_Date 매개 변수]))&#13;&#10;WHEN &apos;월별&apos; THEN DATETRUNC(&apos;year&apos;,DATEADD(&apos;year&apos;,0,[Parameters].[C_End_Date 매개 변수])) &lt;= [Calculation_4116571602373656609] and [Calculation_4116571602373656609] &lt; DATETRUNC(&apos;year&apos;,DATEADD(&apos;year&apos;,1,[Parameters].[C_End_Date 매개 변수]))&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='C_목표치_17시결품률' datatype='real' name='[Calculation_3010374887700234258]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX(IIF([Parameters].[C_End_Date 매개 변수]=[Calculation_4116571602373656609],[Calculation_3449757316729536512],NULL))}' />
      </column>
      <column aggregation='Sum' caption='C_목표치_마감결품률' datatype='real' name='[Calculation_3010374887700340755]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX(IIF([Parameters].[C_End_Date 매개 변수]=[Calculation_4116571602373656609],[missing_rate_17_float(복사본)_3449757316730183681],NULL))}' />
      </column>
      <column aggregation='Sum' caption='missing_rate_17_float' datatype='real' name='[Calculation_3449757316729536512]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='FLOAT([missing_rate_17])*100' />
      </column>
      <column caption='C_게이지색상_마감' datatype='string' name='[Calculation_4116571534787248229]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF (SUM([lack_cnt])/sum([prod_cnt]))*100 &gt; MAX([Calculation_3010374887700340755]*1.1) then &quot;red&quot;&#13;&#10;ELSEIF (SUM([lack_cnt])/sum([prod_cnt]))*100 &gt;= MAX([Calculation_3010374887700340755]*0.9) then &quot;yellow&quot;&#13;&#10;ELSEIF(SUM([lack_cnt])/sum([prod_cnt]))*100 &lt; MAX([Calculation_3010374887700340755]*0.9) then &quot;blue&quot;&#13;&#10;end' />
      </column>
      <column caption='C_Date_Type' datatype='string' name='[Calculation_4116571602373529632]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#13;&#10;WHEN &apos;월별&apos; THEN &apos;`&apos; + right([year],2)+ &apos;.&apos;+ [month]&#13;&#10;WHEN &apos;주별&apos; THEN [week_seq]+&apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN [month]+ &apos;/&apos; + [day]&#13;&#10;END' />
      </column>
      <column caption='C_date' datatype='date' name='[Calculation_4116571602373656609]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(DATEPARSE(&apos;yyyy-MM-dd&apos;,[part_dt]))' />
      </column>
      <column caption='C_Weeklabel' datatype='string' hidden='true' name='[Calculation_4116571602375704611]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [week_seq]&lt;&gt;STR(WEEK([Parameters].[C_End_Date 매개 변수]))&#13;&#10;THEN [week_seq]&#13;&#10;ELSE [week_seq]&#13;&#10;END' />
      </column>
      <column caption='FC결품률' datatype='real' name='[Calculation_4116571602382278693]' role='measure' type='quantitative'>
