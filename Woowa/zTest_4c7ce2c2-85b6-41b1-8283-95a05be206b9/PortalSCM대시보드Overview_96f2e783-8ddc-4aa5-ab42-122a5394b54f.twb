        <calculation class='tableau' formula='(SUM(IF [Parameters].[매개 변수 2]=&apos;일별&apos; and DATEADD(&apos;week&apos;,-0,DATETRUNC(&apos;week&apos;,[Parameters].[C_End_Date 매개 변수], &apos;monday&apos;)) &lt;= [Calculation_1943584764563673107] and [Calculation_1943584764563673107] &lt;= [Parameters].[C_End_Date 매개 변수]&#13;&#10;THEN [ord_cnt]&#13;&#10;END)&#13;&#10;/&#13;&#10;SUM(IF [Parameters].[매개 변수 2]=&apos;일별&apos; and DATEADD(&apos;week&apos;,-0,DATETRUNC(&apos;week&apos;,[Parameters].[C_End_Date 매개 변수], &apos;monday&apos;))&lt;=[Calculation_1943584764563673107] and [Calculation_1943584764563673107] &lt;= [Parameters].[C_End_Date 매개 변수]&#13;&#10;THEN [fcst_ord_cnt]&#13;&#10;END))&#13;&#10;-&#13;&#10;(SUM(IF [Parameters].[매개 변수 2]=&apos;일별&apos; and DATEADD(&apos;week&apos;,-1,DATETRUNC(&apos;week&apos;,[Parameters].[C_End_Date 매개 변수], &apos;monday&apos;))&lt;=[Calculation_1943584764563673107] and [Calculation_1943584764563673107] &lt; DATEADD(&apos;week&apos;,-0,DATETRUNC(&apos;week&apos;,[Parameters].[C_End_Date 매개 변수], &apos;monday&apos;))&#13;&#10;THEN [ord_cnt]&#13;&#10;END)&#13;&#10;/SUM(IF [Parameters].[매개 변수 2]=&apos;일별&apos; and DATEADD(&apos;week&apos;,-1,DATETRUNC(&apos;week&apos;,[Parameters].[C_End_Date 매개 변수], &apos;monday&apos;))&lt;=[Calculation_1943584764563673107] and [Calculation_1943584764563673107] &lt; DATEADD(&apos;week&apos;,-0,DATETRUNC(&apos;week&apos;,[Parameters].[C_End_Date 매개 변수], &apos;monday&apos;))&#13;&#10;THEN [fcst_ord_cnt]&#13;&#10;END))' />
