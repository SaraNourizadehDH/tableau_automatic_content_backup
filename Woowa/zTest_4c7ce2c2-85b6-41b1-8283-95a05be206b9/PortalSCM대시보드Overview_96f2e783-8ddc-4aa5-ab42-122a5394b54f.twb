        <calculation class='tableau' formula='STR(MIN(IF [C_해당기간(복사본)_1029354050826133541]=TRUE&#13;&#10;THEN REPLACE(right([part_dt],8),&apos;-&apos;,&apos;.&apos;)&#13;&#10;END))&#13;&#10;+&#13;&#10;&apos;~&apos;&#13;&#10;+&#13;&#10;STR(MAX(IF [C_해당기간(복사본)_1029354050826133541]=TRUE&#13;&#10;THEN REPLACE(right([part_dt],8),&apos;-&apos;,&apos;.&apos;)&#13;&#10;END))' />
      </column>
      <column caption='C_Text_Date_Type' datatype='string' name='[Calculation_1029354050835787830]' role='dimension' type='nominal'>
