      </column>
      <column caption='F_주문Date(22/12-)' datatype='boolean' name='[Calculation_1392456715088838659]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1943584764563673107] &gt;= date(&quot;2022-12-01&quot;)' />
