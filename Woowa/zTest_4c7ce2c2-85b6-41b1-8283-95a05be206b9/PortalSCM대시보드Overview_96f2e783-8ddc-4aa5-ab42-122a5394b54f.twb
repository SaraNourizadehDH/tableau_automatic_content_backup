      <column caption='C_Fcst Acc%(정확도)' datatype='real' name='[Calculation_1943584764848357417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if sum(fcst_ord_cnt) = 0 then 0 else  sum([ord_cnt])/ sum([fcst_ord_cnt]) end' />
