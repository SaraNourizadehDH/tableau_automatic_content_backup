              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#13;&#10;WHEN &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-11,[Parameters].[C_End_Date 매개 변수])) &lt;= [Calculation_1764285219974905859] and [Calculation_1764285219974905859] &lt; DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Parameters].[C_End_Date 매개 변수]))&#13;&#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-7,[Parameters].[C_End_Date 매개 변수])) &lt;= [Calculation_1764285219974905859] and [Calculation_1764285219974905859] &lt; DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,1,[Parameters].[C_End_Date 매개 변수]))&#13;&#10;WHEN &apos;일별&apos; THEN [Calculation_1764285219974905859] &lt;= [Parameters].[C_End_Date 매개 변수] AND (DATEADD(&apos;day&apos;, -13, [Parameters].[C_End_Date 매개 변수]) &lt;= [Calculation_1764285219974905859])&#13;&#10;END' />
            </column>
            <column caption='C_Date_Type' datatype='string' name='[Calculation_1764285219974447105]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#13;&#10;WHEN &apos;월별&apos; THEN &apos;`&apos; + right([year],2)+ &apos;.&apos;+ [month]&#13;&#10;WHEN &apos;주별&apos; THEN [week_seq]+&apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN [month]+ &apos;/&apos; + [day]&#13;&#10;END' />
            </column>
            <column caption='C_date' datatype='date' default-format='*yyyy-mm-dd' name='[Calculation_1764285219974905859]' role='dimension' type='ordinal'>
