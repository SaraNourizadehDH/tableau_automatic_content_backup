      <column caption='C_게이지색상_17시' datatype='string' name='[C_게이지색상(복사본)_1157425105655853058]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if &#13;&#10;(SUM([lack_cnt])/sum([prod_cnt]))*100 &gt; MAX([Calculation_3010374887700234258]*1.1) then &quot;red&quot;&#13;&#10;ELSEIF (SUM([lack_cnt])/sum([prod_cnt]))*100 &gt;= MAX([Calculation_3010374887700234258]*0.9) then &quot;yellow&quot;&#13;&#10;elseif(SUM([lack_cnt])/sum([prod_cnt]))*100 &lt; MAX([Calculation_3010374887700234258]*0.9) then &quot;blue&quot;&#13;&#10;end' />
      </column>
      <column caption='C_결품률_red' datatype='real' name='[C_결품률_17시기준(복사본)_986006892604067844]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if (SUM([lack_cnt])/sum([prod_cnt]))*100 &gt; MAX([Calculation_3010374887700234258]*1.1) then SUM([lack_cnt])/sum([prod_cnt]) end' />
      </column>
      <column caption='C_결품률_yellow' datatype='real' name='[C_결품률_17시기준_red(복사본)_986006892604317701]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if (SUM([lack_cnt])/sum([prod_cnt]))*100 &gt;= MAX([Calculation_3010374887700234258]*0.9)&#13;&#10;and (SUM([lack_cnt])/sum([prod_cnt]))*100 &lt;=MAX([Calculation_3010374887700234258]*1.1) &#13;&#10; then SUM([lack_cnt])/sum([prod_cnt]) end' />
      </column>
      <column caption='C_결품률_blue' datatype='real' name='[C_결품률_17시기준_yellow(복사본)_986006892604424198]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if (SUM([lack_cnt])/sum([prod_cnt]))*100 &lt; MAX([Calculation_3010374887700234258]*0.9) then SUM([lack_cnt])/sum([prod_cnt]) end' />
      </column>
