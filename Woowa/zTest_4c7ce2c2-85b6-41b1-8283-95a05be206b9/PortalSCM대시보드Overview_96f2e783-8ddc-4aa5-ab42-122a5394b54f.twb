        <calculation class='tableau' formula='IF [Parameters].[매개 변수 2]=&apos;월별&apos; AND DATETRUNC(&apos;year&apos;,[Parameters].[C_End_Date 매개 변수])=DATETRUNC(&apos;year&apos;,[Calculation_1943584764563673107]) &#13;&#10;THEN &apos;TRUE&apos;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 2]=&apos;주별&apos; AND DATETRUNC(&apos;month&apos;,[Parameters].[C_End_Date 매개 변수])=DATETRUNC(&apos;month&apos;,[Calculation_1943584764563673107]) &#13;&#10;THEN &apos;TRUE&apos;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 2]=&apos;일별&apos; AND ISOWEEK([Parameters].[C_End_Date 매개 변수])=INT([week_seq])&#13;&#10;THEN &apos;TRUE&apos;&#13;&#10;&#13;&#10;ELSE &apos;FALSE&apos;&#13;&#10;END' />
