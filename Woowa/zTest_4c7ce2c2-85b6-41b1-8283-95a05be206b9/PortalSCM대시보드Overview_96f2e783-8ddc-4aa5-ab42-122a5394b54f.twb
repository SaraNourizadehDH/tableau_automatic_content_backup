      <column caption='C_결품률_17' datatype='real' name='[C_결품률(복사본)_1640154719052619779]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(fc_lack_cnt_17) / sum(fc_prod_cnt_17)' />
      </column>
      <column caption='기타등급 결품률' datatype='real' name='[C_결품률S(복사본)(복사본)_1764285220015071253]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if NOT([Calculation_3171378565054300160] = &quot;A&quot; and [Calculation_3171378565054300160] = &quot;S&quot;) then [fc_lack_cnt] end)&#13;&#10;/ sum(if NOT([Calculation_3171378565054300160] = &quot;A&quot; and [Calculation_3171378565054300160] = &quot;S&quot;) then [fc_prod_cnt] end)' />
      </column>
      <column caption='A등급 결품률' datatype='real' name='[C_결품률S(복사본)_1764285220015067156]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [Calculation_3171378565054300160] = &quot;A&quot; then [fc_lack_cnt] end)&#13;&#10;/ sum(if [Calculation_3171378565054300160] = &quot;A&quot; then [fc_prod_cnt] end)' />
      </column>
      <column caption='C_결품요약_해당기간' datatype='string' name='[Calculation_1029354050829402160]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(MIN(IF [Calculation_4116571534474793037]=TRUE&#13;&#10;THEN REPLACE(right([part_dt],8),&apos;-&apos;,&apos;.&apos;)&#13;&#10;END))&#13;&#10;+&#13;&#10;&apos;~&apos;&#13;&#10;+&#13;&#10;STR(MAX(IF [Calculation_4116571534474793037]=TRUE&#13;&#10;THEN REPLACE(right([part_dt],8),&apos;-&apos;,&apos;.&apos;)&#13;&#10;END))' />
      </column>
      <column caption='C_text_Date_Type' datatype='string' name='[Calculation_1029354050836656184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#13;&#10;WHEN &apos;월별&apos; THEN &apos;`&apos; + right(STR(YEAR([Parameters].[C_End_Date 매개 변수])),2)+ &apos;.&apos;+ MID(str([Parameters].[C_End_Date 매개 변수]),6,2)&#13;&#10;WHEN &apos;주별&apos; THEN STR(ISOWEEK([Parameters].[C_End_Date 매개 변수])) + &apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN REPLACE(MID(str([Parameters].[C_End_Date 매개 변수]),6,5),&apos;-&apos;,&apos;/&apos;)&#13;&#10;END' />
      </column>
      <column caption='C_해당기간' datatype='string' hidden='true' name='[Calculation_1029354050841989179]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 2]=&apos;월별&apos; AND YEAR([Parameters].[C_End_Date 매개 변수])=INT([year])&#13;&#10;THEN [year]+&apos;년&apos;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 2]=&apos;주별&apos;AND DATEADD(&apos;month&apos;,0,DATETRUNC(&apos;month&apos;,[Parameters].[C_End_Date 매개 변수]))&lt;=[Calculation_1764285220011937806]&#13;&#10;THEN [month]+&apos;월&apos;&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF [Parameters].[매개 변수 2]=&apos;일별&apos; AND str(DATETRUNC(&apos;iso-week&apos;,[Parameters].[C_End_Date 매개 변수]))=[week_seq]&#13;&#10;then [week_seq]+&apos;W&apos;&#13;&#10;END&#13;&#10;&#13;&#10;//F_Date_Type(결품요약)의 이유모를 오류로 수저 전 C_해당기간 필드로 대체' />
      </column>
      <column caption='F_Date_Type' datatype='boolean' name='[Calculation_1268889251990450176]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#13;&#10;WHEN &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-11,[Parameters].[C_End_Date 매개 변수])) &lt;= [Calculation_1764285220011937806] and [Calculation_1764285220011937806] &lt; DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Parameters].[C_End_Date 매개 변수]))&#13;&#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-7,[Parameters].[C_End_Date 매개 변수])) &lt;= [Calculation_1764285220011937806] and [Calculation_1764285220011937806] &lt; DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,1,[Parameters].[C_End_Date 매개 변수]))&#13;&#10;WHEN &apos;일별&apos; THEN DATEADD(&apos;day&apos;,-13,[Parameters].[C_End_Date 매개 변수])&lt;=[Calculation_1764285220011937806] and [Calculation_1764285220011937806]&lt;=[Parameters].[C_End_Date 매개 변수]&#13;&#10;END' />
      </column>
      <column caption='C_day' datatype='string' hidden='true' name='[Calculation_1392456715134681117]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEADD(&apos;day&apos;,-13,[Parameters].[C_End_Date 매개 변수])&lt;=[Calculation_1764285220011937806] AND DATEADD(&apos;day&apos;,-0,[Parameters].[C_End_Date 매개 변수])&gt;=[Calculation_1764285220011937806]&#13;&#10;THEN REPLACE(RIGHT(STR([Calculation_1764285220011937806]),5),&apos;-&apos;,&apos;/&apos;)&#13;&#10;END' />
      </column>
      <column caption='C_month' datatype='string' hidden='true' name='[Calculation_1392456715134763038]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEADD(&apos;month&apos;,-11,[Parameters].[C_End_Date 매개 변수])&lt;=[Calculation_1764285220011937806]  &#13;&#10;THEN RIGHT([year],2)+&apos;/&apos;+[month]&#13;&#10;END' />
      </column>
      <column caption='C_week' datatype='string' hidden='true' name='[Calculation_1392456715134824479]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF (DATEADD(&apos;week&apos;, -7, DATETRUNC(&apos;week&apos;,[Parameters].[C_End_Date 매개 변수],&apos;Monday&apos;))) &lt;= [Calculation_1764285220011937806] AND ([Calculation_1764285220011937806] &lt;= [Parameters].[C_End_Date 매개 변수])&#13;&#10;THEN [week_seq]+&apos;W&apos;&#13;&#10;END' />
      </column>
      <column caption='C_Date_Type' datatype='string' name='[Calculation_1764285220011704332]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 2]&#13;&#10;WHEN &apos;월별&apos; THEN &apos;`&apos; + right([year],2)+ &apos;.&apos;+ [month]&#13;&#10;WHEN &apos;주별&apos; THEN [week_seq]+&apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN [month]+ &apos;/&apos; + [day]&#13;&#10;END' />
      </column>
      <column caption='C_date' datatype='date' name='[Calculation_1764285220011937806]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEPARSE(&apos;yyyy-MM-dd&apos;,[part_dt]))' />
      </column>
      <column caption='S등급 결품률' datatype='real' name='[Calculation_1764285220014043155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [Calculation_3171378565054300160] = &quot;S&quot; then [fc_lack_cnt] end)&#13;&#10;/ sum(if [Calculation_3171378565054300160] = &quot;S&quot; then [fc_prod_cnt] end)' />
      </column>
      <column caption='C_결품률' datatype='real' name='[Calculation_1764285220328456229]' role='measure' type='quantitative'>
