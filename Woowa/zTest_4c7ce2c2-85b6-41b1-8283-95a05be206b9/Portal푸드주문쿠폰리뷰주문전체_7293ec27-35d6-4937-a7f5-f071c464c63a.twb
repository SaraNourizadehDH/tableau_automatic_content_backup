              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3]&#13;&#10;&#13;&#10;WHEN &apos;연도별&apos; THEN [std_cd] = &apos;D&apos;&#13;&#10;AND DATETRUNC(&apos;year&apos;, [Calculation_913386307967610882]) &gt;= DATETRUNC(&apos;year&apos;, [Parameters].[매개 변수 2])&#13;&#10;AND DATETRUNC(&apos;year&apos;, [Calculation_913386307967610882]) &lt;= DATETRUNC(&apos;year&apos;, [Parameters].[P_Start_Date(복사본)_1160239857846845440])&#13;&#10;&#13;&#10;WHEN &apos;분기별&apos; THEN [std_cd] = &apos;D&apos;&#13;&#10;AND DATETRUNC(&apos;quarter&apos;, [Calculation_913386307967610882]) &gt;= DATETRUNC(&apos;quarter&apos;, [Parameters].[매개 변수 2])&#13;&#10;AND DATETRUNC(&apos;quarter&apos;, [Calculation_913386307967610882]) &lt;= DATETRUNC(&apos;quarter&apos;, [Parameters].[P_Start_Date(복사본)_1160239857846845440])&#13;&#10;&#13;&#10;WHEN &apos;월별&apos; THEN [std_cd] = &apos;M&apos; &#13;&#10;AND DATETRUNC(&apos;month&apos;, [Calculation_913386307967610882]) &gt;= DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2])&#13;&#10;AND DATETRUNC(&apos;month&apos;, [Calculation_913386307967610882]) &lt;= DATETRUNC(&apos;month&apos;, [Parameters].[P_Start_Date(복사본)_1160239857846845440])&#13;&#10;&#13;&#10;WHEN &apos;주별&apos; THEN [std_cd] = &apos;W&apos;&#13;&#10;AND DATETRUNC(&apos;iso-week&apos;, [Calculation_913386307967610882]) &gt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])&#13;&#10;AND DATETRUNC(&apos;iso-week&apos;, [Calculation_913386307967610882]) &lt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[P_Start_Date(복사본)_1160239857846845440])&#13;&#10;&#13;&#10;WHEN &apos;일별&apos; THEN [std_cd] = &apos;D&apos;&#13;&#10;AND DATETRUNC(&apos;day&apos;, [Calculation_913386307967610882]) &gt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])&#13;&#10;AND DATETRUNC(&apos;day&apos;, [Calculation_913386307967610882]) &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[P_Start_Date(복사본)_1160239857846845440])&#13;&#10;&#13;&#10;END' />
