  <column caption='F_Date_현기간' datatype='boolean' name='[Calculation_1029354007451627522]' role='dimension' type='nominal'>
    <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;when &apos;일별&apos; then&#10;[base_dur_cd] = &apos;D&apos; //AND DATETRUNC(&apos;day&apos;, [base_dt]) = DATETRUNC(&apos;day&apos;, TODAY()-1)&#10;and&#10;[base_dt(복사본)_65020761998073886] = [Parameters].[매개 변수 2 1 1]&#10;&#10;when &apos;주별&apos; then&#10;[base_dur_cd] = &apos;W&apos;&#10;and&#10;[base_dt(복사본)_65020761998073886] = DATETRUNC(&apos;iso-week&apos;,[Parameters].[매개 변수 2 1 1])&#10;&#10;when &apos;월별&apos; then&#10;[base_dur_cd] = &apos;M&apos;&#10;and&#10;[base_dt(복사본)_65020761998073886] = DATETRUNC(&apos;month&apos;,[Parameters].[매개 변수 2 1 1])&#10;&#10;end' />
