        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;    THEN &#13;&#10;        IF [Calculation_827536469355294720] &gt;= DATEADD(&apos;month&apos;,-11,[Parameters].[C_End_Date 매개 변수])&#13;&#10;        THEN&#13;&#10;            IF YEAR([Calculation_827536469355294720]) = YEAR([Parameters].[C_End_Date 매개 변수]) AND MONTH([Calculation_827536469355294720]) = MONTH([Parameters].[C_End_Date 매개 변수])&#13;&#10;            THEN [Calculation_827536469355294720] = [Parameters].[C_End_Date 매개 변수]&#13;&#10;            ELSEIF ([Calculation_827536469355294720]) &lt; [Parameters].[C_End_Date 매개 변수]&#13;&#10;            THEN &#13;&#10;            [Calculation_827536469355294720] = {FIXED YEAR([Calculation_827536469355294720]),MONTH([Calculation_827536469355294720]):MAX([Calculation_827536469355294720])}&#13;&#10;            END&#13;&#10;        END&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;    THEN &#13;&#10;        IF [Calculation_827536469355294720] &gt;= DATEADD(&apos;iso-week&apos;,-12,[Parameters].[C_End_Date 매개 변수])&#13;&#10;        THEN&#13;&#10;            IF MONTH([Calculation_827536469355294720]) = MONTH([Parameters].[C_End_Date 매개 변수]) and WEEK([Calculation_827536469355294720]) = WEEK([Parameters].[C_End_Date 매개 변수])&#13;&#10;            THEN [Calculation_827536469355294720] = [Parameters].[C_End_Date 매개 변수]&#13;&#10;            ELSEIF ([Calculation_827536469355294720]) &lt; DATEADD(&apos;iso-week&apos;,-1,[Parameters].[C_End_Date 매개 변수]) and ISOWEEKDAY([Calculation_827536469355294720]) = 1&#13;&#10;            THEN TRUE&#13;&#10;            END&#13;&#10;        END&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;    THEN [Calculation_827536469355294720] &gt;= DATEADD(&apos;day&apos;,-13,[Parameters].[C_End_Date 매개 변수])&#13;&#10;    AND [Calculation_827536469355294720] &lt; DATEADD(&apos;day&apos;,1,[Parameters].[C_End_Date 매개 변수])&#13;&#10;&#13;&#10;END' />
