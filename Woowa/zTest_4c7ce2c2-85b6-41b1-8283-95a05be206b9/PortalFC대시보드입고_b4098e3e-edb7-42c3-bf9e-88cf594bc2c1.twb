            <column caption='C_FC/FC그룹' datatype='string' name='[Calculation_1095500645520523280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 8]=&apos;FC&apos;&#13;&#10;THEN  [centr_nm] //[C_FC_Label]&#13;&#10;ELSEIF  [Parameters].[매개 변수 8]=&apos;FC그룹&apos;&#13;&#10;THEN [centr_grp_nm]&#13;&#10;END' />
