            </column>
            <column caption='C_보관유형' datatype='string' name='[Calculation_1701797749180727312]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [storage_type]&#13;&#10;WHEN &apos;COLD&apos; THEN &apos;냉장&apos;&#13;&#10;WHEN &apos;REFRIGERATION&apos; THEN &apos;냉동&apos;&#13;&#10;WHEN &apos;NORMAL&apos; THEN &apos;상온&apos;&#13;&#10;END' />
            </column>
            <column caption='실제입고수량(Unit)' datatype='real' name='[Calculation_1701797749189558297]' role='measure' type='quantitative' user:unnamed='00.다운로드용시트(기간)'>
              <calculation class='tableau' formula='//실제입고수량(Unit)&#13;&#10;sum([whousing_qty])*1' />
            </column>
            <column caption='보관유형' datatype='string' name='[Calculation_1701797749189849114]' role='dimension' type='nominal' user:unnamed='00.다운로드용시트(기간)'>
              <calculation class='tableau' formula='//보관유형&#13;&#10;[Calculation_1701797749180727312]' />
            </column>
            <column caption='입고단위' datatype='string' name='[Calculation_1701797749190049819]' role='dimension' type='nominal' user:unnamed='00.다운로드용시트(기간)'>
              <calculation class='tableau' formula='//입고단위&#13;&#10;[whousing_unit]' />
            </column>
            <column caption='실제입고수량(SKU)' datatype='integer' name='[Calculation_1701797749194330141]' role='measure' type='quantitative' user:unnamed='00.다운로드용시트(기간)'>
