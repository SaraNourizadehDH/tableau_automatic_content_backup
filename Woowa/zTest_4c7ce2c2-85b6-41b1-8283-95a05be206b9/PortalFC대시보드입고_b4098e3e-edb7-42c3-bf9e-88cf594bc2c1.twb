      <column caption='C_Date_Type_Label(휴일포함)' datatype='string' name='[C_Date_Type(복사본)_1042583351014109226]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; THEN &quot;`&quot;+ right(year,2)+&quot;.&quot;+[month]&#13;&#10;WHEN &apos;주별&apos; THEN [week_seq]+&apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN [month]+&apos;/&apos; +[day]&#13;&#10;                 +CHAR(10)+&#13;&#10;                 &apos;(&apos;+[weekday_nm]+&apos;)&apos;&#13;&#10;                 +CHAR(10)+&#13;&#10;                 IF NOT ISNULL([holiday_desc])&#13;&#10;                 THEN LEFT([holiday_desc],2)&#13;&#10;                 END +CHAR(10)&#13;&#10;END' />
      </column>
      <column caption='C_Date_Type_Label_2일간격(O)(선택)' datatype='string' name='[C_Date_Type_Label_2일간격(O)(복사본)_1740641295584231466]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos; and [Parameters].[매개 변수 11]=[Calculation_456270971915874314]&#13;&#10;AND DATEDIFF(&apos;day&apos;,[Parameters].[매개 변수 3],[Parameters].[매개 변수 2]) &gt;= 21&#13;&#10;AND int([Calculation_1407093442170208259])%2 = 0&#13;&#10;THEN [month] +&apos;/&apos; + [day]&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='C_Date_Type_Label_2일간격(X)(선택)' datatype='string' name='[C_Date_Type_Label_2일간격(O)(복사본)_456270971932626959]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos; and [Parameters].[매개 변수 11]=[Calculation_456270971915874314]&#13;&#10;AND DATEDIFF(&apos;day&apos;,[Parameters].[매개 변수 3],[Parameters].[매개 변수 2]) &lt; 21&#13;&#10;THEN [month] +&apos;/&apos; + [day]&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='C_Date_Type_Label_2일간격(X)' datatype='string' name='[C_Date_Type_Label_2일간격(X)(선택)(복사본)_1740641295584952363]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;AND DATEDIFF(&apos;day&apos;,[Parameters].[매개 변수 3],[Parameters].[매개 변수 2]) &lt; 14&#13;&#10;THEN [month] +&apos;/&apos; + [day]&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
