            <column caption='C_평균입고소요시간(SKU)_전주비+전월비' datatype='real' name='[C_평균입고소요시간(Unit)_전주비+전월비(복사본)_1701797750309756993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN([C_Unit당_평균_소요시간(분)(복사본)_1701797748875026433]) - LOOKUP(ZN([C_Unit당_평균_소요시간(분)(복사본)_1701797748875026433]), -1)) / ABS(LOOKUP([C_Unit당_평균_소요시간(분)(복사본)_1701797748875026433], -1))'>
