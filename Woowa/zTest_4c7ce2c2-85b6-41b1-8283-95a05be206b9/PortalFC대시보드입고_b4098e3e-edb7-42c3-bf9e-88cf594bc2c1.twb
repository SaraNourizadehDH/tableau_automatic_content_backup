              <calculation class='tableau' formula='0' />
            </column>
            <column caption='실제입고수량' datatype='real' name='[Calculation_1701797748883021836]' role='measure' type='quantitative' user:unnamed='3.1.FC별_Unit_예상/실제입고수량'>
              <calculation class='tableau' formula='//실제입고수량&#13;&#10;SUM([whousing_qty])*1' />
            </column>
            <column caption='C_입고수량_정확도(Unit)' datatype='real' name='[Calculation_1701797748883558413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([whousing_qty])/SUM([Calculation_2000161228378484750])' />
            </column>
            <column caption='F_select_FC그룹orFC' datatype='boolean' name='[Calculation_1701797750336614482]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 10] = &apos;전체&apos; THEN TRUE&#13;&#10;ELSE [Parameters].[매개 변수 10] = [Calculation_1095500645520523280]&#13;&#10;END' />
            </column>
            <column caption='예상입고수량' datatype='real' name='[Calculation_2000161228378484750]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE [base_dt],[centr_nm] : max([fcst_whousing_qty])}&#13;&#10;&#13;&#10;/* 예상입고수량은 보관유형/입고단위를 고려하지 않고 대표값으로 가져옴*/' />
            </column>
            <column caption='default_MAX(C_date)' datatype='date' hidden='true' name='[Calculation_429530863025303558]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{MAX([Calculation_1407093442170208259])}' />
            </column>
            <column caption='default_MAX(C_date)-7' datatype='date' hidden='true' name='[Calculation_429530863025340423]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{DATE(DATEADD(&apos;day&apos;, -6,MAX([Calculation_1407093442170208259])))}' />
            </column>
            <column caption='C_Date_Type' datatype='string' name='[Calculation_456270971915874314]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; THEN  &apos;`&apos; + right([year],2)+ &apos;.&apos;+ [month]&#13;&#10;WHEN &apos;주별&apos; THEN [week_seq]+&apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN [month]+&apos;/&apos;+[day]&#13;&#10;END' />
            </column>
            <column caption='F_team_null제거' datatype='boolean' name='[F_FC그룹orFC_null제거(복사본)_1042583350994526249]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[team_nm] &lt;&gt; &apos;Null&apos;' />
            </column>
