            </column>
            <column caption='월' datatype='string' name='[Calculation_1042583350875807750]' role='dimension' type='nominal' user:unnamed='5.상세(기간)'>
              <calculation class='tableau' formula='//월&#13;&#10;[month]' />
            </column>
            <column caption='일' datatype='string' name='[Calculation_1042583350876438536]' role='dimension' type='nominal' user:unnamed='5.상세(기간)'>
              <calculation class='tableau' formula='//일&#13;&#10;[day]' />
            </column>
            <column caption='주차' datatype='string' name='[Calculation_1042583350876602377]' role='dimension' type='nominal' user:unnamed='5.상세(기간)'>
              <calculation class='tableau' formula='//주차&#13;&#10;[week_seq]' />
            </column>
            <column caption='C_런칭날짜' datatype='date' name='[Calculation_1042583350992400421]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([cntr_open_dt])' />
            </column>
            <column caption='C_FC/FC그룹' datatype='string' name='[Calculation_1095500645520523280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 8]=&apos;FC&apos;&#13;&#10;THEN  [centr_nm] //[C_FC_Label]&#13;&#10;ELSEIF  [Parameters].[매개 변수 8]=&apos;FC그룹&apos;&#13;&#10;THEN [centr_grp_nm]&#13;&#10;END' />
            </column>
            <column caption='F_최소주문적용' datatype='boolean' name='[Calculation_1095500645572923464]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[매개 변수 7]=&apos;on&apos; then [prev_mm_avg_ord_cnt]&gt;=([Parameters].[매개 변수 6])&#13;&#10;ELSEIF [Parameters].[매개 변수 7]=&apos;off&apos; then TRUE&#13;&#10;end' />
            </column>
            <column caption='F_시작일/종료일' datatype='boolean' name='[Calculation_1335035853081903132]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[매개 변수 3]&lt;=[Calculation_1407093442170208259]&#13;&#10;AND &#13;&#10;[Parameters].[매개 변수 2]&gt;=[Calculation_1407093442170208259]' />
            </column>
            <column caption='팀' datatype='string' name='[Calculation_136796875144253609]' role='dimension' type='nominal' user:unnamed='5.상세(기간)'>
              <calculation class='tableau' formula='//팀&#13;&#10;[team_nm]' />
