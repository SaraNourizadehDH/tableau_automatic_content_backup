      <column caption='C_실제입고수량(SKU)_지표' datatype='real' name='[Calculation_1172906276867797006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1]!=&apos;일별&apos;&#13;&#10;THEN AVG({INCLUDE [base_dt],[centr_nm] : SUM([whousing_product_cnt])})&#13;&#10;ELSE AVG({INCLUDE [base_dt],[centr_nm] : SUM([whousing_product_cnt])})&#13;&#10;END' />
      </column>
      <column caption='F_시작일/종료일' datatype='boolean' name='[Calculation_1335035853081903132]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[매개 변수 3]&lt;=[Calculation_1407093442170208259]&#13;&#10;AND &#13;&#10;[Parameters].[매개 변수 2]&gt;=[Calculation_1407093442170208259]' />
      </column>
      <column caption='C_전주비/전월비' datatype='string' name='[Calculation_1335035853089620026]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1]=&apos;주별&apos;&#13;&#10;THEN &apos;전주비&apos;&#13;&#10;ELSEIF [Parameters].[매개 변수 1]=&apos;월별&apos;&#13;&#10;THEN &apos;전월비&apos;&#13;&#10;END' />
      </column>
      <column caption='C_예상입고수량(Unit)_전주비+전월비' datatype='real' name='[Calculation_136796874945282063]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(sum([fcst_whousing_qty])) - LOOKUP(ZN(sum([fcst_whousing_qty])), -1)) / ABS(LOOKUP(ZN(sum([fcst_whousing_qty])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='F_Show_일별' datatype='boolean' name='[Calculation_136796875115425953]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[매개 변수 1]=&apos;일별&apos;' />
      </column>
      <column caption='F_FC그룹orFC_null제거' datatype='boolean' name='[Calculation_136796875174957227]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([Calculation_1095500645520523280])' />
      </column>
      <column caption='F_LAST' datatype='boolean' name='[Calculation_136796875293229242]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST() = 0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='C_date' datatype='date' name='[Calculation_1407093442170208259]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([base_dt])' />
      </column>
      <column caption='F_Date_Type' datatype='boolean' name='[Calculation_1407093442171359237]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-11,[Parameters].[매개 변수 2])) &lt;= [Calculation_1407093442170208259] and [Calculation_1407093442170208259] &lt; DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Parameters].[매개 변수 2]))&#13;&#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-7,[Parameters].[매개 변수 2])) &lt;= [Calculation_1407093442170208259] and [Calculation_1407093442170208259] &lt; DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,1,[Parameters].[매개 변수 2]))&#13;&#10;WHEN &apos;일별&apos; THEN [Parameters].[매개 변수 3]&lt;=[Calculation_1407093442170208259] and [Calculation_1407093442170208259] &lt;= [Parameters].[매개 변수 2] AND (DATEADD(&apos;day&apos;, -30, [Parameters].[매개 변수 2]) &lt;= [Calculation_1407093442170208259])&#13;&#10;END' />
      </column>
      <column caption='default_select_Date_Type_Label' datatype='string' hidden='true' name='[Calculation_1543045870818566144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{REPLACE(MID(str(MAX([Calculation_1407093442170208259])),6,5),&apos;-&apos;,&apos;/&apos;)}' />
      </column>
      <column caption='default_Date_Type' datatype='string' hidden='true' name='[Calculation_1543045870866513929]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{MIN(&apos;일별&apos;)}' />
      </column>
      <column caption='C_Unit당_평균_소요시간(분)' datatype='real' name='[Calculation_1701797748873351168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg(tot_whousing_lt_in_min/[whousing_qty])' />
      </column>
      <column caption='C_입고수량_정확도(Unit)' datatype='real' name='[Calculation_1701797748883558413]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([whousing_qty])/SUM([Calculation_2000161228378484750])' />
      </column>
      <column caption='C_Unut/SKU실제입고수량(FC별)' datatype='real' name='[Calculation_1701797749170409487]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 4]=&apos;Unit&apos;&#13;&#10;THEN SUM([whousing_qty])&#13;&#10;ELSEIF [Parameters].[매개 변수 4]=&apos;SKU&apos;&#13;&#10;THEN SUM([whousing_product_cnt])&#13;&#10;END' />
      </column>
      <column caption='C_보관유형' datatype='string' name='[Calculation_1701797749180727312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [storage_type]&#13;&#10;WHEN &apos;COLD&apos; THEN &apos;냉장&apos;&#13;&#10;WHEN &apos;REFRIGERATION&apos; THEN &apos;냉동&apos;&#13;&#10;WHEN &apos;NORMAL&apos; THEN &apos;상온&apos;&#13;&#10;END' />
      </column>
      <column caption='C_보관유형_상온_입고수량(Unit)' datatype='real' name='[Calculation_1701797749203386413]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_1701797749180727312]=&apos;상온&apos;&#13;&#10;THEN [whousing_qty]&#13;&#10;END)' />
      </column>
      <column caption='실제입고수량(SKU)' datatype='integer' name='[Calculation_1701797749213417529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//실제입고수량(SKU)&#13;&#10;SUM([whousing_product_cnt])*1' />
      </column>
      <column caption='C_select_FC그룹orFC' datatype='string' name='[Calculation_1701797750325436496]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 10]=[Calculation_1095500645520523280] THEN &apos;전체&apos;&#13;&#10;ELSE [Calculation_1095500645520523280]&#13;&#10;END' />
      </column>
      <column caption='F_select_FC그룹orFC' datatype='boolean' name='[Calculation_1701797750336614482]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 10] = &apos;전체&apos; THEN TRUE&#13;&#10;ELSE [Parameters].[매개 변수 10] = [Calculation_1095500645520523280]&#13;&#10;END' />
      </column>
      <column caption='F_select_Date' datatype='boolean' name='[Calculation_1701797750337036371]' role='dimension' type='nominal'>
