            </column>
            <column caption='C_FC/FC그룹' datatype='string' name='[Calculation_1095500645520523280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 8]=&apos;FC&apos;&#13;&#10;THEN  [centr_nm] //[C_FC_Label]&#13;&#10;ELSEIF  [Parameters].[매개 변수 8]=&apos;FC그룹&apos;&#13;&#10;THEN [centr_grp_nm]&#13;&#10;END' />
            </column>
            <column caption='F_최소주문적용' datatype='boolean' name='[Calculation_1095500645572923464]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[매개 변수 7]=&apos;on&apos; then [prev_mm_avg_ord_cnt]&gt;=([Parameters].[매개 변수 6])&#13;&#10;ELSEIF [Parameters].[매개 변수 7]=&apos;off&apos; then TRUE&#13;&#10;end' />
            </column>
            <column caption='C_정시입고율' datatype='real' name='[Calculation_1289436912582291456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([whousing_qty_09])/sum([Calculation_535646925243752457])' />
            </column>
            <column caption='9시 이전 입고수량' datatype='real' name='[Calculation_1289436912587706375]' role='measure' type='quantitative' user:unnamed='Tolltip__FC별_정시입고FC수'>
              <calculation class='tableau' formula='//9시 이전 입고수량&#13;&#10;SUM([whousing_qty_09])*1' />
            </column>
            <column caption='Color_정시입고율_색상(&gt;=95%)' datatype='boolean' name='[Calculation_1289436912589668362]' role='measure' type='nominal'>
              <calculation class='tableau' formula='sum([whousing_qty_09])/sum([Calculation_535646925243752457]) &gt;= 0.95' />
            </column>
            <column caption='F_FC그룹orFC_null제거' datatype='boolean' name='[Calculation_136796875174957227]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([Calculation_1095500645520523280])' />
            </column>
            <column caption='C_date' datatype='date' name='[Calculation_1407093442170208259]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE([base_dt])' />
            </column>
            <column caption='F_Date_Type' datatype='boolean' name='[Calculation_1407093442171359237]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-11,[Parameters].[매개 변수 2])) &lt;= [Calculation_1407093442170208259] and [Calculation_1407093442170208259] &lt; DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Parameters].[매개 변수 2]))&#13;&#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-7,[Parameters].[매개 변수 2])) &lt;= [Calculation_1407093442170208259] and [Calculation_1407093442170208259] &lt; DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,1,[Parameters].[매개 변수 2]))&#13;&#10;WHEN &apos;일별&apos; THEN [Parameters].[매개 변수 3]&lt;=[Calculation_1407093442170208259] and [Calculation_1407093442170208259] &lt;= [Parameters].[매개 변수 2] AND (DATEADD(&apos;day&apos;, -30, [Parameters].[매개 변수 2]) &lt;= [Calculation_1407093442170208259])&#13;&#10;END' />
            </column>
            <column caption='&apos;정시입고율&apos;' datatype='string' name='[Calculation_2000161228022722564]' role='dimension' type='nominal' user:unnamed='Tolltip__FC별_정시입고FC수'>
              <calculation class='tableau' formula='&apos;정시입고율&apos;' />
            </column>
            <column caption='C_Date_Type_Label' datatype='string' name='[Calculation_395472388608012310]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; THEN &apos;`&apos; + right([year],2)+ &apos;.&apos;+ [month]&#13;&#10;WHEN &apos;주별&apos; THEN [week_seq]+&apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN [month]+ &apos;/&apos; + [day]&#13;&#10;END' />
            </column>
            <column caption='C_Date_Type' datatype='string' name='[Calculation_456270971915874314]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; THEN RIGHT([year],2)+&apos;/&apos;+[month]&#13;&#10;WHEN &apos;주별&apos; THEN [week_seq]+&apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN [month]+&apos;/&apos;+[day]&#13;&#10;END' />
            </column>
            <column caption='C_입고총수량' datatype='real' name='[Calculation_535646925243752457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF [recv_on_time_yn]=0&#13;&#10;THEN [whousing_qty]&#13;&#10;ELSE [whousing_qty_info]&#13;&#10;END)' />
            </column>
            <column caption='ㅤ' datatype='integer' name='[Calculation_535646925248155661]' role='measure' type='quantitative' user:unnamed='Tolltip__FC별_정시입고FC수'>
