            <column caption='C_입고총수량(원본)' datatype='real' name='[C_입고총수량(복사본)_1946399507952521240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [whousing_cmplt_hhmm_kst]&gt;&apos;09:00&apos;&#13;&#10;THEN [whousing_qty]/1&#13;&#10;ELSE [whousing_qty_info]/6&#13;&#10;END)&#13;&#10;&#13;&#10;/*&#13;&#10;bmart_fc_warehousing_display_dd_fact 테이블의 &#13;&#10;whousing_cmplt_hhmm_kst이 09시 이전이면 bmart_fc_warehousing_display_dd_info 테이블 whousing_qty사용&#13;&#10;bmart_fc_warehousing_display_dd_fact 테이블의 &#13;&#10;whousing_cmplt_hhmm_kst이 09시 이후이면 bmart_fc_warehousing_dd_fact 테이블 whousing_qty 사용&#13;&#10;*/' />
            </column>
            <column caption='F_스크롤' datatype='boolean' name='[Calculation_1042583350904778768]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1]=&apos;일별&apos; and DATEDIFF(&apos;day&apos;, [Parameters].[매개 변수 3], [Parameters].[매개 변수 2]) &gt;= 14&#13;&#10;THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
