            <column caption='C_보관유형_냉동_입고수량(Unit)' datatype='real' name='[C_보관유형_냉장_입고수량(Unit)(복사본)_1701797749203783727]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_1701797749180727312]=&apos;냉동&apos;&#13;&#10;THEN [whousing_qty]&#13;&#10;END)' />
            </column>
            <column caption='C_입고단위_낱개_입고수량(Unit)' datatype='real' name='[C_보관유형_냉장_입고수량(Unit)(복사본)_1701797749204086832]' role='measure' type='quantitative'>
