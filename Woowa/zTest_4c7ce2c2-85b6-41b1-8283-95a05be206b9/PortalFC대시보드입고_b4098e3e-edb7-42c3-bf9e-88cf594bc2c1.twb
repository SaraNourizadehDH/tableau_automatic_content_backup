      <column caption='Text_Date_Type' datatype='string' hidden='true' name='[Calculation_395472388438351891]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_1407093442265821245]&#13;&#10;WHEN &apos;월별&apos; THEN &apos;`&apos; + right(STR(YEAR([Parameters].[매개 변수 2])),2)+ &apos;.&apos;+ MID(str([Parameters].[매개 변수 2]),6,2)&#13;&#10;WHEN &apos;주별&apos; THEN STR(ISOWEEK([Parameters].[매개 변수 2])) + &apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN REPLACE(MID(str([Parameters].[매개 변수 2]),6,5),&apos;-&apos;,&apos;/&apos;)&#13;&#10;END' />
      </column>
      <column caption='C_Start_date(일별)' datatype='date' hidden='true' name='[Calculation_395472388438741012]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='ATTR(DATE(IF [Calculation_1407093442265821245] = &apos;일별&apos; THEN DATEADD(&apos;day&apos;, -6, [Parameters].[매개 변수 2]) ELSE [Parameters].[매개 변수 3] END))' />
