              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1]=&apos;일별&apos; and DATEDIFF(&apos;day&apos;, [Parameters].[매개 변수 3], [Parameters].[매개 변수 2]) &gt;= 14&#13;&#10;THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
