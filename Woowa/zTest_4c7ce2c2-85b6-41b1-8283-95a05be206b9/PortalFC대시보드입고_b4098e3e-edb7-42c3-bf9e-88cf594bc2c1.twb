            <column caption='F_select_Date' datatype='boolean' name='[Calculation_1701797750337036371]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 11] = &apos;전체&apos; THEN TRUE&#13;&#10;ELSE [Parameters].[매개 변수 11]  = [Calculation_395472388422397958]&#13;&#10;END' />
            </column>
            <column caption='예상입고수량' datatype='real' name='[Calculation_2000161228378484750]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{INCLUDE [base_dt],[centr_nm] : max([fcst_whousing_qty])}&#13;&#10;&#13;&#10;/* 예상입고수량은 보관유형/입고단위를 고려하지 않고 대표값으로 가져옴*/' />
            </column>
            <column caption='C_Date_Type_Label' datatype='string' name='[Calculation_395472388422397958]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; THEN &apos;`&apos; + right([year],2)+ &apos;.&apos;+ [month]&#13;&#10;WHEN &apos;주별&apos; THEN [week_seq]+&apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN [month]+ &apos;/&apos; + [day]&#13;&#10;END' />
