            <column caption='C_Date_Type_Label(휴일포함)' datatype='string' name='[C_Date_Type(복사본)_1042583351014109226]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; THEN &quot;`&quot;+ right(year,2)+&quot;.&quot;+[month]&#13;&#10;WHEN &apos;주별&apos; THEN [week_seq]+&apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN [month]+&apos;/&apos; +[day]&#13;&#10;                 +CHAR(10)+&#13;&#10;                 &apos;(&apos;+[weekday_nm]+&apos;)&apos;&#13;&#10;                 +CHAR(10)+&#13;&#10;                 IF NOT ISNULL([holiday_desc])&#13;&#10;                 THEN LEFT([holiday_desc],2)&#13;&#10;                 END +CHAR(10)&#13;&#10;END' />
            </column>
            <column caption='C_SKU당_평균_소요시간(분)' datatype='real' name='[C_Unit당_평균_소요시간(분)(복사본)_1701797748875026433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='avg(tot_whousing_lt_in_min/[whousing_product_cnt])' />
