            <column caption='입고총수량' datatype='real' name='[Calculation_535646925248675854]' role='measure' type='quantitative' user:unnamed='Tolltip__FC별_정시입고FC수'>
              <calculation class='tableau' formula='//입고총수량&#13;&#10;SUM([Calculation_535646925243752457])*1' />
            </column>
