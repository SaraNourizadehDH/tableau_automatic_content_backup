            <column caption='예상입고수량 (Unit)' datatype='real' name='[Calculation_1543045870860918790]' role='measure' type='quantitative' user:unnamed='0.다운로드용시트(기간)'>
              <calculation class='tableau' formula='//예상입고수량 (Unit)&#13;&#10;[Calculation_2000161228378484750]*1' />
            </column>
            <column caption='C_Unit당_평균_소요시간(분)' datatype='real' name='[Calculation_1701797748873351168]' role='measure' type='quantitative'>
