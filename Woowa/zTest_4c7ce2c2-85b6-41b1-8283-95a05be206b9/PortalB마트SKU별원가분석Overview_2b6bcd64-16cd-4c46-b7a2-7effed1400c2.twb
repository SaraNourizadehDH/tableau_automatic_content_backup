      <column caption='C_Date_Type_NoButton' datatype='string' name='[C_Date_Type(복사본)_2364108342590750724]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Number]&#13;&#10;WHEN 1 THEN &apos;월&apos;&#13;&#10;WHEN 2 THEN &apos;주&apos;&#13;&#10;WHEN 3 THEN &apos;일&apos;&#13;&#10;END' />
      </column>
      <column caption='S_GPVor판매수량' datatype='boolean' name='[C_GPVor판매수량(복사본)_839921348242522138]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 3]=[Calculation_839921348242325529] THEN TRUE ELSE FALSE END' />
      </column>
      <column caption='C_날짜_일별_경고문구 (&gt;30)' datatype='string' name='[C_날짜적용범위 (&lt;=30)(복사본)_1292533150780383235]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1 1 1] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[매개 변수 1 4], [Parameters].[매개 변수 2 1]) &gt; 30&#13;&#10;    THEN &apos;※ 기간을 31일 이내로 입력하세요&apos;&#13;&#10;    ELSEIF [Parameters].[매개 변수 1 4] &gt; [Parameters].[매개 변수 2 1]&#13;&#10;    THEN &apos;※ 시작일이 종료일보다 큽니다.&apos;&#13;&#10;    ELSE &apos;&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='C_Date_Type' datatype='string' name='[Calculation_1063975417060003868]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Number]&#13;&#10;WHEN 1 THEN &apos;월별&apos;&#13;&#10;WHEN 2 THEN &apos;주별&apos;&#13;&#10;WHEN 3 THEN &apos;일별&apos;&#13;&#10;END' />
      </column>
      <column caption='C_Date_Type_Label' datatype='string' name='[Calculation_1063975417060605981]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_1063975417060003868]&#13;&#10;WHEN &apos;월별&apos; THEN &apos;`&apos; + right(STR(YEAR([Parameters].[매개 변수 2])),2)+ &apos;.&apos;+ MID(str([Parameters].[매개 변수 2]),6,2)&#13;&#10;WHEN &apos;주별&apos; THEN STR(ISOWEEK([Parameters].[매개 변수 2])) + &apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN REPLACE(MID(str([Parameters].[매개 변수 2]),6,5),&apos;-&apos;,&apos;/&apos;)&#13;&#10;END' />
      </column>
      <column caption='F_Date_Type' datatype='boolean' name='[Calculation_1063975417061576734]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[매개 변수 1 1 1]=[Calculation_1063975417060003868]' />
      </column>
      <column caption='F_시작일가리기' datatype='boolean' name='[Calculation_1094937713191313417]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[매개 변수 1 1 1]!=&apos;일별&apos;' />
      </column>
      <column caption='C_종료일/기준일' datatype='string' name='[Calculation_1763722270652309506]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1063975417060003868]= &apos;일별&apos;&#13;&#10;THEN &apos;종료일&apos;&#13;&#10;ELSE &apos;기준일&apos;&#13;&#10;END' />
      </column>
      <column caption='C_URL' datatype='string' name='[Calculation_2120069540269494295]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#10;WHEN 1 THEN &quot;https://cloud.wiki.woowa.in/wiki/spaces/DATAGVNC/pages/88312810/B+Overview&quot; //대시보드 정의서 &gt; Overview&#10;WHEN 2 THEN &quot;https://cloud.wiki.woowa.in/wiki/spaces/DATAGVNC/pages/88312812/B+FC&quot; //FC별 마진율&#10;WHEN 3 THEN &quot;https://cloud.wiki.woowa.in/wiki/spaces/DATAGVNC/pages/88312814/B&quot; //상품마진 상세&#10;WHEN 4 THEN &quot;https://cloud.wiki.woowa.in/wiki/spaces/DATAGVNC/pages/88312816/B&quot; //평균매입단가 상세&#10;END' />
      </column>
      <column caption='C_FC상세버튼' datatype='integer' name='[Calculation_2364108342894247961]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Number]&#13;&#10;WHEN 1 THEN 1&#13;&#10;WHEN 0 THEN 0&#13;&#10;END' />
      </column>
      <column caption='S_FC상세적용버튼' datatype='boolean' name='[Calculation_2364108342894510106]' role='dimension' type='nominal'>
