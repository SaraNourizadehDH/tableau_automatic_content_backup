      <column caption='Date_Text_Label_NEW_Member' datatype='string' name='[Date_Text_Label_NEW (copy)_2063211643068055578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [c_button (copy)_2063211643066900503]&#13;&#10;when &apos;일별&apos;&#13;&#10;then if len(str(DATEPART(&apos;month&apos;,[Parameters].[매개 변수 2]))) = 1&#13;&#10;     then MID(STR([Parameters].[매개 변수 2]),7,1)+&quot;월 &quot;&#13;&#10;&#13;&#10;     else MID(STR([Parameters].[매개 변수 2]),6,2)+&quot;월 &quot;&#13;&#10;     end&#13;&#10;     +&#13;&#10;     if len(str(DATEPART(&apos;day&apos;,[Parameters].[매개 변수 2]))) = 1&#13;&#10;     then MID(STR([Parameters].[매개 변수 2]),10,1)+&quot;일&quot;&#13;&#10;&#13;&#10;     else MID(STR([Parameters].[매개 변수 2]),9,2)+&quot;일&quot;&#13;&#10;     end&#13;&#10;     &#13;&#10;when &apos;주별&apos;&#13;&#10;then [week_nm]&#13;&#10;when &apos;월별&apos;&#13;&#10;then  &#13;&#10;IF len(str(DATEPART(&apos;month&apos;,[Parameters].[매개 변수 2]))) = 2&#13;&#10;then MID(STR([Parameters].[매개 변수 2]),3,2)+&quot;년 &quot;+MID(STR([Parameters].[매개 변수 2]),6,2) + &apos;월&apos;&#13;&#10;ELSE MID(STR([Parameters].[매개 변수 2]),3,2)+&quot;년 &quot;+MID(STR([Parameters].[매개 변수 2]),7,1) + &apos;월&apos;&#13;&#10;&#13;&#10;END&#13;&#10;END' />
      </column>
      <column caption='F_Button_Date_Member' datatype='boolean' name='[F_Button_Date (copy)_2063211643067461657]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[p_Date_Type (copy)_2063211643064430614]=[c_button (copy)_2063211643066900503]' />
      </column>
