            <column _.fcp.ParameterDefaultValues.true...default-value-field='[sqlproxy.0plehck0gb1la1109gdm7102vr0n].[Calculation_931400745007603720]' caption='p_Date' datatype='date' default-format='*yyyy-mm-dd' name='[매개 변수 2]' param-domain-type='any' role='measure' type='quantitative' value='#2024-02-04#'>
