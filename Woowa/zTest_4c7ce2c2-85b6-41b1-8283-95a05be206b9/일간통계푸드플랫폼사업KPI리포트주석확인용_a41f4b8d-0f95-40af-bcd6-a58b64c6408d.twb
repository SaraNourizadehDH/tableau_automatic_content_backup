            <column caption='net_increase_seller_cnt_NEW' datatype='integer' name='[Calculation_1947525423410929678]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[new_seller_cnt]+[rejoin_seller_cnt]-[leave_seller_cnt]' />
