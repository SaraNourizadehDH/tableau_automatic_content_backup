      <column caption='C_%diff_Label' datatype='string' name='[Calculation_1047368442541572099]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN &apos;전월 대비&apos;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN &apos;전주 대비&apos;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN &apos;전주 대비&apos;&#13;&#10;END' />
      </column>
      <column caption='C_Date_Label' datatype='string' name='[Calculation_1047368442541617156]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[매개 변수 1]&#13;&#10;when &apos;일별&apos;&#13;&#10;then if len(str(DATEPART(&apos;month&apos;,[Calculation_1047368442541178880]))) = 1&#13;&#10;     then MID(STR([Calculation_1047368442541178880]),7,1)+&quot;월 &quot;&#13;&#10;&#13;&#10;     else MID(STR([Calculation_1047368442541178880]),6,2)+&quot;월 &quot;&#13;&#10;     end&#13;&#10;     +&#13;&#10;     if len(str(DATEPART(&apos;day&apos;,[Calculation_1047368442541178880]))) = 1&#13;&#10;     then MID(STR([Calculation_1047368442541178880]),10,1)+&quot;일&quot;&#13;&#10;&#13;&#10;     else MID(STR([Calculation_1047368442541178880]),9,2)+&quot;일&quot;&#13;&#10;     end&#13;&#10;    &#13;&#10;when &apos;주별&apos;&#13;&#10;then [week_nm]&#13;&#10;&#13;&#10;when &apos;월별&apos;&#13;&#10;then  &#13;&#10;IF len(str(DATEPART(&apos;month&apos;,[Calculation_1047368442541178880]))) = 2&#13;&#10;then MID(STR([Calculation_1047368442541178880]),3,2)+&quot;년 &quot;+MID(STR([Calculation_1047368442541178880]),6,2) + &apos;월&apos;&#13;&#10;ELSE MID(STR([Calculation_1047368442541178880]),3,2)+&quot;년 &quot;+MID(STR([Calculation_1047368442541178880]),7,1) + &apos;월&apos;&#13;&#10;&#13;&#10;END&#13;&#10;END' />
      </column>
      <column caption='C_Trend_Label_Short' datatype='string' name='[Calculation_1047368442541666309]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[매개 변수 1]&#13;&#10;when &apos;일별&apos;&#13;&#10;then &apos;최근 8일 트렌드&apos;&#13;&#10;when &apos;주별&apos;&#13;&#10;then &apos;최근 6주 트렌드&apos;&#13;&#10;when &apos;월별&apos;&#13;&#10;then &apos;최근 6개월 트렌드&apos;&#13;&#10;END' />
