      <column caption='C_%diff_Label' datatype='string' name='[Calculation_891431294477701125]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN &apos;전월 대비&apos;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN &apos;전주 대비&apos;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN &apos;전주 대비&apos;&#13;&#10;END' />
      </column>
      <column caption='Date_Text_Label' datatype='string' name='[Calculation_909164218359459840]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_488922077100130304]&#13;&#10;WHEN &apos;월별&apos; THEN REPLACE(MID(str([Parameters].[매개 변수 2]),3,5),&apos;-&apos;,&apos;/&apos;)&#13;&#10;WHEN &apos;주별&apos; &#13;&#10;THEN&#13;&#10;IF DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2]) = DATETRUNC(&apos;iso-week&apos;,[Calculation_488922077102366723])&#13;&#10;THEN [week_nm] END&#13;&#10;WHEN &apos;일별&apos; THEN REPLACE(MID(str([Parameters].[매개 변수 2]),6,5),&apos;-&apos;,&apos;/&apos;)&#13;&#10;END' />
      </column>
      <column caption='C_Visit_Label' datatype='string' name='[Calculation_909164218379632642]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN &apos;DAU&apos;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN &apos;WAU&apos;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN &apos;MAU&apos;&#13;&#10;END' />
      </column>
      <column caption='default_MAX(C_date)' datatype='date' name='[Calculation_931400745007603720]' role='dimension' type='ordinal'>
