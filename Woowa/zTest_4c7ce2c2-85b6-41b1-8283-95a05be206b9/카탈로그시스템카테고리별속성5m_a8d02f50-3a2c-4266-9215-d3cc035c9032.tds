    <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.0n0snki0blibit1fp3w0k1ezgehe' name='사용자 지정 SQL 쿼리' type='text'>--카탈로그시스템 카테고리별속성상세&#13;
  with aa01 as (&#13;
  select  svc_nm&#13;
         ,svc_det_nm&#13;
         ,seller_id&#13;
         ,seller_nm&#13;
         ,is_new_item&#13;
         ,is_product_use&#13;
         ,is_catalog_excld_cate&#13;
         ,item_mgmt_cate_id&#13;
         ,item_mgmt_cate_nm&#13;
         ,item_mgmt_cate_lv1_nm&#13;
         ,item_mgmt_cate_lv2_nm&#13;
         ,item_mgmt_cate_lv3_nm&#13;
         ,item_mgmt_cate_lv4_nm&#13;
         ,item_mgmt_cate_lv5_nm&#13;
         ,item_mgmt_cate_lv6_nm&#13;
         ,count(distinct item_id) as item_cnt&#13;
         ,count(distinct case when (is_product_attr_reg = 1 or brand_id is not null or mnfc_id is not null) then item_id else null end) as opt_reg_item_cnt&#13;
         ,count(distinct case when is_product_attr_reg = 1 then item_id else null end) as attr_reg_item_cnt&#13;
         ,count(distinct case when is_product_attr_reg = 0 then item_id else null end) as attr_noreg_item_cnt&#13;
         ,count(distinct case when brand_id is null then null else item_id end) as brand_id_reg_item_cnt&#13;
         ,count(distinct case when mnfc_id is null then null else item_id end) as mnfc_id_reg_item_cnt&#13;
         ,count(distinct case when brand_id is null and brand_nm is not null then item_id else null end) as brand_nm_direct_reg_item_cnt&#13;
         ,count(distinct case when brand_id is null and brand_nm is null then item_id else null end) as brand_info_noreg_item_cnt&#13;
         ,count(distinct case when mnfc_id is null and mnfc_nm is not null then item_id else null end) as mnfc_nm_direct_reg_item_cnt&#13;
         ,count(distinct case when mnfc_id is null and mnfc_nm is null then item_id else null end) as mnfc_info_noreg_item_cnt&#13;
         ,sum(product_attr_cnt) as reg_attr_cnt&#13;
         ,max(cate_product_attr_cnt) as cate_mapping_attr_cnt&#13;
         ,sum(sale_qty) as sale_qty&#13;
         ,part_date&#13;
    from  cl_bis.cq_catalog_item_info&#13;
   where  part_date &gt;&gt;= cast(date_add(&apos;month&apos;, -5, date_trunc(&apos;month&apos;, current_date)) as varchar)&#13;
group by  svc_nm&#13;
         ,svc_det_nm&#13;
         ,seller_id&#13;
         ,seller_nm&#13;
         ,is_new_item&#13;
         ,is_product_use&#13;
         ,is_catalog_excld_cate&#13;
         ,item_mgmt_cate_id&#13;
         ,item_mgmt_cate_nm&#13;
         ,item_mgmt_cate_lv1_nm&#13;
         ,item_mgmt_cate_lv2_nm&#13;
         ,item_mgmt_cate_lv3_nm&#13;
         ,item_mgmt_cate_lv4_nm&#13;
         ,item_mgmt_cate_lv5_nm&#13;
         ,item_mgmt_cate_lv6_nm&#13;
         ,part_date&#13;
  )&#13;
&#13;
  select  svc_nm as &quot;서비스구분&quot;&#13;
         ,svc_det_nm as &quot;서비스상세구분&quot;&#13;
         ,seller_id as &quot;셀러ID&quot;&#13;
         ,seller_nm as &quot;셀러명&quot;&#13;
         ,is_new_item as &quot;신규아이템여부&quot;&#13;
         ,is_product_use as &quot;아이템사용여부&quot;&#13;
         ,is_catalog_excld_cate as &quot;카탈로그제외대상카테고리여부&quot;&#13;
         ,item_mgmt_cate_id as &quot;카테고리ID&quot;&#13;
         ,item_mgmt_cate_nm as &quot;카테고리명&quot;&#13;
         ,item_mgmt_cate_lv1_nm as &quot;카테고리1레벨&quot;&#13;
         ,item_mgmt_cate_lv2_nm as &quot;카테고리2레벨&quot;&#13;
         ,item_mgmt_cate_lv3_nm as &quot;카테고리3레벨&quot;&#13;
         ,item_mgmt_cate_lv4_nm as &quot;카테고리4레벨&quot;&#13;
         ,item_mgmt_cate_lv5_nm as &quot;카테고리5레벨&quot;&#13;
         ,item_mgmt_cate_lv6_nm as &quot;카테고리6레벨&quot;&#13;
         ,item_cnt as &quot;아이템수&quot;&#13;
         ,opt_reg_item_cnt as &quot;속성Coverage아이템수&quot;&#13;
         ,case when item_cnt = 0 then 0 else opt_reg_item_cnt * 100 / item_cnt end as &quot;속성Coverage&quot;&#13;
         ,attr_reg_item_cnt as &quot;속성입력아이템수&quot;&#13;
         ,attr_noreg_item_cnt as &quot;속성미입력아이템수&quot;&#13;
         ,brand_id_reg_item_cnt as &quot;브랜드ID입력아이템수&quot;&#13;
         ,mnfc_id_reg_item_cnt as &quot;제조사ID입력아이템수&quot;&#13;
         ,brand_nm_direct_reg_item_cnt as &quot;브랜드직접입력아이템수&quot;&#13;
         ,brand_info_noreg_item_cnt as &quot;브랜드미입력아이템수&quot;&#13;
         ,mnfc_nm_direct_reg_item_cnt as &quot;제조사직접입력아이템수&quot;&#13;
         ,mnfc_info_noreg_item_cnt as &quot;제조사미입력아이템수&quot;&#13;
         ,cate_mapping_attr_cnt as &quot;맵핑속성항목수&quot;&#13;
         ,reg_attr_cnt as &quot;속성입력항목수&quot;&#13;
         ,case when item_cnt = 0 or cate_mapping_attr_cnt = 0 then 0 else (reg_attr_cnt * 100) / (item_cnt * cate_mapping_attr_cnt) end as &quot;속성완성률&quot;&#13;
         ,case when item_cnt = 0 then 0 else reg_attr_cnt / item_cnt end as &quot;평균속성입력수&quot;&#13;
         ,sale_qty as &quot;판매수량&quot;&#13;
         ,part_date as &quot;기준일자&quot;&#13;
    from  aa01</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
    <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='athena.0n0snki0blibit1fp3w0k1ezgehe' name='사용자 지정 SQL 쿼리' type='text'>--카탈로그시스템 카테고리별속성상세&#13;
