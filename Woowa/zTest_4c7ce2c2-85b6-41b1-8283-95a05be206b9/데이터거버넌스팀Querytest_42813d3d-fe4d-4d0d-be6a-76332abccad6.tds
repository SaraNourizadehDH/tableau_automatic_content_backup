    <relation connection='athena.0vhkxm40k892hl1gy8zwp09f9kk4' name='Custom SQL Query' type='text'>-- 주문별 배대사 ID 매핑&#10;    with ord_agency as&#10;    (&#10;        select&#10;            distinct&#10;            order_sheet_no&#10;            , quick_unit_no&#10;            , agency_code &#10;        from &#10;            cmplf_delivery.quick_unit_tracking&#10;        where 1=1&#10;            and part_date &gt;&gt;= &apos;2022-07-05&apos;&#10;            and part_date &lt;&lt;= &apos;2023-07-04&apos;&#10;         &#10;    )&#10;     &#10;    -- 주문데이터&#10;    , ord_tb as&#10;    (&#10;            select&#10;                a.*&#10;                , d.seller_master_no&#10;                , c.headequarter_category_nm&#10;                , c.headequarter_category_cd&#10;                , cast(b.receiver_lat as double) as receiver_lat&#10;                , cast(b.receiver_lng as double) as receiver_lng&#10;                , case WHEN c.is_normal = 1 then &apos;99999990&apos;&#10;                       when a.headquarter_id = &apos;10887&apos; then &apos;99999991&apos;                       &#10;                       when c.is_normal = 0 then &apos;99999992&apos; end as stype1_id&#10;                , case WHEN c.is_normal = 1 then &apos;일반셀러&apos;&#10;                       when a.headquarter_id = &apos;10887&apos; then &apos;건기식&apos;                       &#10;                       when c.is_normal = 0 then &apos;브랜드셀러&apos; end as stype1_nm&#10;                , case WHEN c.is_normal = 1 then &apos;99999990&apos;&#10;                       when a.headquarter_id = &apos;10887&apos; then &apos;99999991&apos;                       &#10;                       when c.is_normal = 0 then a.headquarter_id end as stype2_id&#10;                , case WHEN c.is_normal = 1 then &apos;일반셀러&apos;&#10;                       when a.headquarter_id = &apos;10887&apos; then &apos;건기식&apos;                       &#10;                       when c.is_normal = 0 then a.headquarter_nm end as stype2_nm                              &#10; &#10;            from&#10;                dsdw.commerce_order_master a&#10;            inner join&#10;                cmplf_order_hidden.order_address b&#10;            on 1=1&#10;                and a.ord_sheet_no = b.order_sheet_no&#10;            inner join&#10;                dsdw.commerce_seller_master c&#10;                on a.branch_id = c.branch_id&#10;                and a.part_date &gt;&gt;= &apos;2022-07-05&apos;&#10;                and a.part_date &lt;&lt;= &apos;2023-07-04&apos;               &#10;                and ((c.is_test != 1) or (a.headquarter_id = &apos;10887&apos; and a.order_dttm + interval &apos;9&apos; hour &gt;&gt;= cast(&apos;2023-05-02 09:00:00.000&apos; as timestamp(3))))&#10;                and a.part_svc = &apos;BAEMIN_STORE&apos;&#10;            inner join&#10;                cmplf_seller.seller d&#10;                on a.branch_id = d.id&#10;    )&#10;     &#10;     &#10;     &#10;    -- 우형부담/셀러부담 쿠폰금액 및 배민페이 쿠폰 판별&#10;    , seller_cpn_actual as&#10;    (&#10;        SELECT&#10;            a.order_no&#10;            , b.mgmt_name&#10;            , b.name&#10;            , b.erp_code_platform&#10;            , b.baemin_coupon_group_id&#10;            , case when json_array_contains(json_extract(b.baeminpay_policy, &apos;$.limitPayMethod&apos;), &apos;BAEMINPAY_CARD&apos;) = True then 1 else 0 end as is_bpcpn&#10;            , b.allotment_seller_amount&#10;            , b.allotment_platform_amount&#10;        FROM&#10;        (&#10;            SELECT&#10;                DISTINCT order_no&#10;                , payment_group_ref&#10;            FROM&#10;                cmplf_order.order_product_pay&#10;            WHERE 1=1&#10;                and payment_group_ref &lt;&lt;&gt;&gt; &apos;NONE&apos;&#10;                and part_date &gt;&gt;= &apos;2022-07-05&apos;&#10;                and part_date &lt;&lt;= &apos;2023-07-04&apos;&#10;        ) a&#10;        LEFT JOIN&#10;            cmplf_incentive.coupon_config b&#10;            ON a.payment_group_ref = b.baemin_coupon_group_id       &#10;    )&#10;     &#10;    -- 주문별 좌표 정보 변환&#10;     &#10;    , ord_xy as&#10;    (&#10;        select&#10;            t.ord_sheet_no&#10;            , t.branch_id&#10;            , round(&#10;            c.clon1 * t.receiver_lng +&#10;            c.clon2 * t.receiver_lat +&#10;            c.clon3 * power(t.receiver_lng,2) +&#10;            c.clon4 * t.receiver_lng * t.receiver_lat +&#10;            c.clon5 * power(t.receiver_lat, 2) +&#10;            c.clon6 * power(t.receiver_lng, 3) +&#10;            c.clon7 * power(t.receiver_lng, 2) * t.receiver_lat +&#10;            c.clon8 * t.receiver_lng * power(t.receiver_lat, 2) +&#10;            c.clon9 * power(t.receiver_lat, 3) +&#10;            c.clon10 * power(t.receiver_lng, 4) +&#10;            c.clon11 * power(t.receiver_lng, 3) * t.receiver_lat +&#10;            c.clon12 * power(t.receiver_lng, 2) * power(t.receiver_lat, 2) +&#10;            c.clon13 * t.receiver_lng * power(t.receiver_lat,3) +&#10;            c.clon14 * power(t.receiver_lat,4) +&#10;            c.clon15,0) as x_axis_utmk&#10;            ,&#10;            round(&#10;            c.clat1 * t.receiver_lng +&#10;            c.clat2 * t.receiver_lat +&#10;            c.clat3 * power(t.receiver_lng,2) +&#10;            c.clat4 * t.receiver_lng * t.receiver_lat +&#10;            c.clat5 * power(t.receiver_lat, 2) +&#10;            c.clat6 * power(t.receiver_lng, 3) +&#10;            c.clat7 * power(t.receiver_lng, 2) * t.receiver_lat +&#10;            c.clat8 * t.receiver_lng * power(t.receiver_lat, 2) +&#10;            c.clat9 * power(t.receiver_lat, 3) +&#10;            c.clat10 * power(t.receiver_lng, 4) +&#10;            c.clat11 * power(t.receiver_lng, 3) * t.receiver_lat +&#10;            c.clat12 * power(t.receiver_lng, 2) * power(t.receiver_lat, 2) +&#10;            c.clat13 * t.receiver_lng * power(t.receiver_lat,3) +&#10;            c.clat14 * power(t.receiver_lat,4) +&#10;            c.clat15,0) as y_axis_utmk&#10;        from&#10;            ord_tb t&#10;            , temp.bms_wgs2utmk_coeff c&#10;        where 1=1&#10;            and t.receiver_lng != 0&#10;            and t.receiver_lat != 0&#10;             &#10; &#10;    ) &#10;     &#10;     &#10;    -- 지점별 좌표 변환&#10;     &#10;    , branch_xy as&#10;    (&#10;        with seller_xy as&#10;        (&#10;            select&#10;                branch_id&#10;                , cast(shipping_longitude as double) as seller_lng&#10;                , cast(shipping_latitude as double) as seller_lat&#10;            from&#10;                cmplf_seller.basic&#10;        )&#10;         &#10;        select&#10;            t.branch_id&#10;            , round(&#10;            c.clon1 * t.seller_lng +&#10;            c.clon2 * t.seller_lat +&#10;            c.clon3 * power(t.seller_lng,2) +&#10;            c.clon4 * t.seller_lng * t.seller_lat +&#10;            c.clon5 * power(t.seller_lat, 2) +&#10;            c.clon6 * power(t.seller_lng, 3) +&#10;            c.clon7 * power(t.seller_lng, 2) * t.seller_lat +&#10;            c.clon8 * t.seller_lng * power(t.seller_lat, 2) +&#10;            c.clon9 * power(t.seller_lat, 3) +&#10;            c.clon10 * power(t.seller_lng, 4) +&#10;            c.clon11 * power(t.seller_lng, 3) * t.seller_lat +&#10;            c.clon12 * power(t.seller_lng, 2) * power(t.seller_lat, 2) +&#10;            c.clon13 * t.seller_lng * power(t.seller_lat,3) +&#10;            c.clon14 * power(t.seller_lat,4) +&#10;            c.clon15,0) as x_axis_utmk&#10;            ,&#10;            round(&#10;            c.clat1 * t.seller_lng +&#10;            c.clat2 * t.seller_lat +&#10;            c.clat3 * power(t.seller_lng,2) +&#10;            c.clat4 * t.seller_lng * t.seller_lat +&#10;            c.clat5 * power(t.seller_lat, 2) +&#10;            c.clat6 * power(t.seller_lng, 3) +&#10;            c.clat7 * power(t.seller_lng, 2) * t.seller_lat +&#10;            c.clat8 * t.seller_lng * power(t.seller_lat, 2) +&#10;            c.clat9 * power(t.seller_lat, 3) +&#10;            c.clat10 * power(t.seller_lng, 4) +&#10;            c.clat11 * power(t.seller_lng, 3) * t.seller_lat +&#10;            c.clat12 * power(t.seller_lng, 2) * power(t.seller_lat, 2) +&#10;            c.clat13 * t.seller_lng * power(t.seller_lat,3) +&#10;            c.clat14 * power(t.seller_lat,4) +&#10;            c.clat15,0) as y_axis_utmk&#10;        from seller_xy t , temp.bms_wgs2utmk_coeff c&#10; &#10;    ) &#10;     &#10;     &#10;    -- 주문별 지점과의 거리 계산&#10;    , ord_dist as&#10;    (&#10;        select&#10;            distinct&#10;            a.ord_sheet_no&#10;            , a.x_axis_utmk&#10;            , a.y_axis_utmk&#10;            , power(power(a.x_axis_utmk - b.x_axis_utmk,2) + power(a.y_axis_utmk - b.y_axis_utmk,2),0.5) as dlvry_dist&#10;        from&#10;            ord_xy a&#10;        inner join&#10;            branch_xy b&#10;            on a.branch_id = b.branch_id&#10;             &#10;    )&#10;     &#10;         &#10;    -- 주문별 수수료 계산&#10;     &#10;    -- 브랜드셀러&#10;    , fcseller_commission as&#10;    (&#10;        select&#10;            distinct&#10;            a.ord_no&#10;            , b.mediation_commission&#10;        from&#10;            ord_tb a&#10;        inner join&#10;            cmplf_order.order_product b&#10;            on a.ord_no = b.order_no&#10;            and b.part_date &gt;&gt;= &apos;2022-07-05&apos;&#10;            and b.part_date &lt;&lt;= &apos;2023-07-04&apos;&#10;            and a.stype1_nm = &apos;브랜드셀러&apos;&#10;    )&#10;     &#10;    -- 일반셀러&#10;    -- 기간별 상품카테고리별 수수료&#10;     &#10;    , rnk1 as&#10;    (&#10;        select&#10;            id&#10;            , part_date&#10;            , lead( part_date) OVER( ORDER BY part_date) AS part_date_lead&#10;        from&#10;        (  &#10;            select&#10;                id&#10;                , date_format(start_at + interval &apos;9&apos; hour, &apos;%%Y-%%m-%%d&apos;) as part_date&#10;                , row_number() over(partition by start_at order by id desc) as rnk&#10;            from&#10;                cmplf_product.category_version&#10;        )&#10;        where 1=1&#10;            and rnk = 1&#10;    )&#10;     &#10;     &#10;    -- 주문데이터 일자와 조인하기 위해 part_date, part_date_lead 데이터 생성&#10;    -- 가장 마지막 버전은 종료일을 9999-12-31로 세팅&#10;    -- 기간별 버전 정보 및 수수료 데이터 생성&#10;    , cat_com as&#10;    (&#10;        select&#10;            a.category_id&#10;            , a.commission&#10;            , b.part_date&#10;            , case when b.part_date_lead is null then &apos;9999-12-31&apos; else b.part_date_lead end as part_date_lead&#10;        from   &#10;            cmplf_product.category_snapshot a&#10;        inner join&#10;            rnk1 b&#10;            on a.version_id = b.id&#10;    )&#10;     &#10;    -- 나중에 product_audit 테이블 반영 필요 - 현재는 상품별 카테고리아이디는 최신것으로 조인&#10;    -- product_id, category_id 매칭 정보를 주문시간에 맞춰 반영 필요&#10;    , ord_normal_mcf as&#10;    (&#10;        select&#10;            a.order_no&#10;            , sum((a.amount - a.seller_allotment_amount)*e.commission*0.01) as mediation_commission_fee_normal&#10;        from&#10;            cmplf_order.order_product_pay  a&#10;        inner join&#10;            cmplf_order.order_product b&#10;            on a.item_ref = b.order_product_no&#10;            and a.item_type = &apos;PRODUCT&apos;&#10;            --and a.part_date &gt;&gt;= &apos;2023-04-26&apos;&#10;            and a.part_date between &apos;2022-07-05&apos; and &apos;2023-07-04&apos;&#10;            and b.part_date between &apos;2022-07-05&apos; and &apos;2023-07-04&apos;&#10;        inner join&#10;            ord_tb c&#10;            on a.order_no  = c.ord_no&#10;            and c.stype1_nm = &apos;일반셀러&apos;&#10;        inner join&#10;            cmplf_product.product d&#10;            on b.product_id = d.id&#10;        inner join&#10;            cat_com e&#10;            on d.category_id = e.category_id&#10;            and a.part_date &gt;&gt;= e.part_date&#10;            and a.part_date &lt;&lt; e.part_date_lead&#10;         &#10;         &#10;        group by 1&#10;    )&#10;     &#10;     &#10;    -- 건기식 수수료&#10;     &#10;     &#10;    , ggs_normal_mcf as&#10;    (&#10;        select&#10;            a.order_no&#10;            , sum((a.amount - a.seller_allotment_amount)*0.25) as ggs_commission_fee&#10;        from&#10;            cmplf_order.order_product_pay  a&#10;        inner join&#10;            cmplf_order.order_product b&#10;            on a.item_ref = b.order_product_no&#10;            and a.item_type = &apos;PRODUCT&apos;&#10;            and a.part_date &gt;&gt;= &apos;2023-05-02&apos;&#10;            and a.part_date between &apos;2022-07-05&apos; and &apos;2023-07-04&apos;&#10;            and b.part_date between &apos;2022-07-05&apos; and &apos;2023-07-04&apos;&#10;        inner join&#10;            ord_tb c&#10;            on a.order_no  = c.ord_no&#10;            and c.stype1_nm = &apos;건기식&apos;&#10;             &#10;        group by 1&#10;    )&#10;     &#10;    -- 배달비매출액 - 일반셀러 기간별 셀러별 건당배달비&#10;    /*   &#10;    , normal_dpromo as&#10;    (&#10;     &#10;        select&#10;            a.seller_id&#10;            , date_format(date_trunc(&apos;day&apos;, a.promotion_end_at + interval &apos;9&apos; hour), &apos;%%Y-%%m-%%d&apos;) as ed_date&#10;            , date_format(date_trunc(&apos;day&apos;, a.promotion_end_at + interval &apos;9&apos; hour - interval &apos;29&apos; day), &apos;%%Y-%%m-%%d&apos;) as st_date&#10;            , b.promotion_own_delivery_commission&#10;        from&#10;            cmplf_seller.active_rate_plan a&#10;        inner join&#10;            cmplf_seller.base_rate_plan b&#10;            on a.base_rate_plan_id = b.id&#10;     &#10;    )&#10;    */&#10;     &#10;    -- 주문별 셀러청구배달건(OD) 데이터 생성&#10;    -- 브랜드셀러 / 일반셀러 조인조건이 다름&#10;     &#10;    , ord_dlvry as&#10;    (&#10;        select&#10;            a.ord_no&#10;            , count(distinct c.dlvry_id) as od_dlvry_cnt&#10;        from &#10;            ord_tb a&#10;        inner join&#10;            cmplf_delivery.quick_unit b&#10;            on a.ord_sheet_no = b.order_sheet_no&#10;        inner join&#10;            sbtasty.dlvry2 c&#10;            on b.quick_unit_no = c.ord_no&#10;        inner join&#10;            sbtasty.applied_rider_fee d&#10;            on c.dlvry_id = d.business_day||&apos;_&apos;||d.sn&#10;            and b.part_date &gt;&gt;= &apos;2022-07-05&apos;&#10;            and b.part_date &lt;&lt;= &apos;2023-07-04&apos;&#10;            and c.business_day &gt;&gt;= &apos;2022-07-05&apos;&#10;            and c.business_day &lt;&lt;= cast(cast(&apos;2023-07-04&apos; as timestamp) + interval &apos;7&apos; day as varchar)&#10;            and c.dlvry_status = &apos;COMPLETED_DELIVERY&apos;&#10;            and d.part_date &gt;&gt;= &apos;2022-07-05&apos;&#10;            and d.part_date &lt;&lt;= &apos;2023-07-04&apos;&#10;            and d.&quot;type&quot;= &apos;BASE&apos;&#10;            and d.applied = 1&#10;            and a.stype1_nm != &apos;일반셀러&apos;&#10;        group by 1&#10;         &#10;        union all&#10;         &#10;         &#10;        select&#10;            a.ord_no&#10;            , count(distinct c.dlvry_id) as od_dlvry_cnt&#10;        from &#10;            ord_tb a&#10;        inner join&#10;            cmplf_delivery.quick_unit b&#10;            on a.ord_sheet_no = b.order_sheet_no&#10;        inner join&#10;            sbtasty.dlvry2 c&#10;            on b.order_sheet_no = c.ord_no&#10;        inner join&#10;            sbtasty.applied_rider_fee d&#10;            on c.dlvry_id = d.business_day||&apos;_&apos;||d.sn&#10;            and b.part_date &gt;&gt;= &apos;2022-07-05&apos;&#10;            and b.part_date &lt;&lt;= &apos;2023-07-04&apos;&#10;            and c.business_day &gt;&gt;= &apos;2022-07-05&apos;&#10;            and c.business_day &lt;&lt;= cast(cast(&apos;2023-07-04&apos; as timestamp) + interval &apos;7&apos; day as varchar)&#10;            and c.dlvry_status = &apos;COMPLETED_DELIVERY&apos;&#10;            and d.part_date &gt;&gt;= &apos;2022-07-05&apos;&#10;            and d.part_date &lt;&lt;= &apos;2023-07-04&apos;&#10;            and d.&quot;type&quot;= &apos;BASE&apos;&#10;            and d.applied = 1&#10;            and a.stype1_nm = &apos;일반셀러&apos;&#10;        group by 1&#10;         &#10;         &#10;    )  &#10;     &#10;    -- 주문별 건당배달비&#10;     &#10;    , dlvry_commission as&#10;    (&#10;        select&#10;            distinct&#10;            a.ord_no&#10;            , b.delivery_commission_amount&#10;            , b.expected_preparation_minute&#10;        from&#10;            ord_tb a&#10;        inner join       &#10;            cmplf_order.order_delivery b&#10;            on a.ord_no = b.order_no&#10;            and b.part_date &gt;&gt;= &apos;2022-07-05&apos;&#10;            and b.part_date &lt;&lt;= &apos;2023-07-04&apos;&#10;             &#10;    )   &#10;    -- OD 배달 제외하면 모두 0원&#10;    &#10;    --배달부문&#10;     &#10;    , dlv_noti as&#10;    (&#10;        select&#10;            ord_sheet_no&#10;            , customer_notification_time&#10;            , customer_notification_at&#10;        from&#10;        (&#10;            select&#10;                a.ord_sheet_no&#10;                , b.quick_unit_no&#10;                , b.agency_code&#10;                , b.customer_notification_at + interval &apos;9&apos; hour as customer_notification_at&#10;                , b.customer_notification_time              &#10;                 &#10;                , row_number() over (partition by b.order_sheet_no order by updated_at asc) as rnk&#10;            from&#10;                dsdw.commerce_order_master a&#10;            inner join&#10;                cmplf_delivery.quick_unit_tracking b&#10;                on a.ord_sheet_no = b.order_sheet_no&#10;                and a.part_date &gt;&gt;= &apos;2022-07-05&apos;&#10;                and a.part_date &lt;&lt;= &apos;2023-07-04&apos;&#10;                and b.part_date &gt;&gt;= &apos;2022-07-05&apos;&#10;                and agency_code is not null&#10;                and customer_notification_at is not null&#10;             &#10;        )&#10;        where 1=1&#10;            and rnk = 1&#10;    )&#10;  &#10;  &#10;     &#10;    , dlv_expt as&#10;    (&#10;        select&#10;            ord_sheet_no&#10;            , expected_delivery_time&#10;            , expected_delivery_at&#10;        from&#10;        (&#10;            select&#10;                a.ord_sheet_no&#10;                , b.quick_unit_no&#10;                , b.agency_code&#10;                , b.expected_delivery_at + interval &apos;9&apos; hour as expected_delivery_at&#10;                , b.expected_delivery_time&#10;                , row_number() over (partition by b.order_sheet_no order by updated_at asc) as rnk&#10;            from&#10;                dsdw.commerce_order_master a&#10;            inner join&#10;                cmplf_delivery.quick_unit_tracking b&#10;                on a.ord_sheet_no = b.order_sheet_no&#10;                and a.part_date &gt;&gt;= &apos;2022-07-05&apos;&#10;                and a.part_date &lt;&lt;= &apos;2023-07-04&apos;&#10;                and b.part_date &gt;&gt;= &apos;2022-07-05&apos;&#10;                and agency_code is not null&#10;                and b.expected_delivery_at is not null&#10;             &#10;        )&#10;        where 1=1&#10;            and rnk = 1&#10;    )   &#10;     &#10;     &#10;     &#10;    -- 배달구간별 시간&#10;    , dlv_time as&#10;    (&#10;        select&#10;            ord_sheet_no&#10;            , reg_at&#10;            , acc_at&#10;            , pck_at&#10;            , com_at&#10;            , date_diff(&apos;second&apos;, reg_at, acc_at)/60.00   AS reg_acc_time&#10;            , date_diff(&apos;second&apos;, acc_at, pck_at)/60.00   AS acc_pck_time&#10;            , date_diff(&apos;second&apos;, pck_at, com_at)/60.00   AS pck_com_time&#10;            , date_diff(&apos;second&apos;, reg_at, com_at)/60.00   AS reg_com_time&#10;            , date_format(reg_at, &apos;%%H&apos;) as reg_hh&#10;            , date_format(acc_at, &apos;%%H&apos;) as acc_hh&#10;            , date_format(pck_at, &apos;%%H&apos;) as pck_hh&#10;            , date_format(com_at, &apos;%%H&apos;) as com_hh&#10;        from&#10;        (&#10;            select&#10;                a.ord_sheet_no&#10;                , max(case when order_sheet_status = &apos;COMPLETED&apos; then status_changed_time + interval &apos;9&apos; hour end ) as reg_at&#10;                , max(case when order_sheet_status = &apos;PREPARING&apos; then status_changed_time + interval &apos;9&apos; hour end ) as acc_at&#10;                , max(case when order_sheet_status = &apos;DELIVERING&apos; then status_changed_time + interval &apos;9&apos; hour end ) as pck_at&#10;                , max(case when order_sheet_status = &apos;DELIVERED&apos; then status_changed_time + interval &apos;9&apos; hour end ) as com_at&#10;            from&#10;                dsdw.commerce_order_master a&#10;            inner join&#10;                cmplf_order.order_sheet_status_history  b&#10;                on a.ord_sheet_no = b.order_sheet_no&#10;                and A.part_date &gt;&gt;= &apos;2022-07-05&apos;&#10;                and A.part_date &lt;&lt;= &apos;2023-07-04&apos;&#10;                and b.part_date &gt;&gt;= &apos;2022-07-05&apos;&#10;            group by 1&#10;        )&#10;    )&#10;     &#10;    , dlv_tb as&#10;    (&#10;        select&#10;            b.*&#10;            , c.customer_notification_at&#10;            , c.customer_notification_time&#10;            , d.expected_delivery_at&#10;            , d.expected_delivery_time&#10;            , case when date_diff(&apos;second&apos;,  c.customer_notification_at,  b.com_at ) &lt;&lt;= 0  then 1&#10;                   else 0 end as is_intime&#10;            , case when date_diff(&apos;second&apos;,  c.customer_notification_at, b.com_at) &gt;&gt; 3600 then 1 else 0 end as is_over60m&#10;            , case when date_diff(&apos;second&apos;,  c.customer_notification_at, b.com_at) &gt;&gt; 7200 then 1 else 0 end as is_over120m&#10;        from&#10;            ord_tb a&#10;        left join&#10;            dlv_time b&#10;            on a.ord_sheet_no = b.ord_sheet_no&#10;        left join&#10;            dlv_noti c&#10;            on a.ord_sheet_no  = c.ord_sheet_no&#10;        left join&#10;            dlv_expt d&#10;            on a.ord_sheet_no  = d.ord_sheet_no&#10;         where 1=1&#10;             and a.ord_no is not null&#10;     )  &#10;     &#10;     &#10;    --마스터 합체&#10;     &#10;        select&#10;            distinct&#10;            a.ord_no&#10;            , a.ord_sheet_no&#10;            , a.order_dttm + interval &apos;9&apos; hour as order_dttm&#10;            , a.order_hour_cd&#10;            , a.headquarter_id as hd_id&#10;            , a.headquarter_nm as hd_nm&#10;            , a.branch_id&#10;            , a.branch_nm&#10;            , a.seller_master_no&#10;            , a.seller_id as seller_master_id&#10;            , a.headequarter_category_cd as headquarter_category_cd&#10;            , a.headequarter_category_nm as headquarter_category_nm&#10;            , cat.new_category_nm&#10;            , a.stype1_id&#10;            , a.stype1_nm&#10;            , a.stype2_id&#10;            , a.stype2_nm          &#10;            , case when a.is_return = 1 then 0 else a.order_amount end as order_amount              &#10;            , a.mem_no&#10;            , a.device_id           &#10;            , a.gender&#10;            , a.age&#10;            , a.grade_cd&#10;            , i.rgn1_cd as member_rgn1_cd&#10;            , i.rgn1_nm as member_rgn1_nm&#10;            , i.rgn2_cd as member_rgn2_cd&#10;            , i.rgn2_nm as member_rgn2_nm&#10;            , a.member_rgn3_cd&#10;            , i.rgn3_nm as member_rgn3_nm&#10;            , j.rgn1_cd as branch_rgn1_cd&#10;            , j.rgn1_nm as branch_rgn1_nm&#10;            , j.rgn2_cd as branch_rgn2_cd&#10;            , j.rgn2_nm as branch_rgn2_nm           &#10;            , a.branch_rgn3_cd&#10;            , j.rgn3_nm as branch_rgn3_nm&#10;            , a.delivery_type&#10;            , a.order_status&#10;            , a.order_cancel_reason&#10;            , a.is_closed&#10;            , a.is_return&#10;            , a.is_baemin_pay  -- 배민페이 지불 여부(쿠폰 아님)           &#10;          &#10;            , case when a.is_return = 1 then a.order_amount else a.order_delivery_amount end as order_delivery_amount&#10;            , case when a.order_delivery_amount &gt;&gt;0 then 1 else 0 end as is_dlvryfee&#10;            --고객부담반품배달비는 order_delivery_amount=0 이므로 dlvryfee_yn값이 자동으로 0&#10;            , a.order_envelope_amount&#10;            , a.discount_coupon_amount&#10;            , a.discount_point_amount&#10;            , case when a.discount_coupon_amount &gt;&gt; 0 then 1 else 0 end as is_paid&#10;            , case when c.is_bpcpn is null then 0 else c.is_bpcpn end as is_bpcpn&#10;            , c.name as coupon_name         &#10;            , c.baemin_coupon_group_id&#10;            , a.seller_divided_coupon_discount_amount&#10;            , coalesce(c.allotment_seller_amount, 0) as allotment_seller_amount&#10;            , case when a.discount_coupon_amount = 0 then 0&#10;                   when a.discount_coupon_amount &gt;&gt; 0 and c.allotment_seller_amount &gt;&gt;= 1 then c.allotment_seller_amount&#10;                   when a.discount_coupon_amount &gt;&gt; 0 and c.allotment_seller_amount &lt;&lt; 1  then c.allotment_seller_amount*a.discount_coupon_amount                  &#10;                   else 0 end  as seller_divided_actual&#10;            , case when a.discount_coupon_amount = 0 then 0&#10;                   when a.discount_coupon_amount &gt;&gt; 0 and c.is_bpcpn =0 and c.allotment_platform_amount &gt;&gt;= 1 then c.allotment_platform_amount&#10;                   when a.discount_coupon_amount &gt;&gt; 0 and c.is_bpcpn =0 and c.allotment_platform_amount &lt;&lt; 1  then c.allotment_platform_amount*a.discount_coupon_amount&#10;                   else 0 end  as woowa_divided_actual&#10;            , case when a.discount_coupon_amount = 0 then 0&#10;                   when a.discount_coupon_amount &gt;&gt; 0 and c.is_bpcpn =1 and c.allotment_platform_amount &gt;&gt;= 1 then c.allotment_platform_amount&#10;                   when a.discount_coupon_amount &gt;&gt; 0 and c.is_bpcpn =1 and c.allotment_platform_amount &lt;&lt; 1  then c.allotment_platform_amount*a.discount_coupon_amount&#10;                   else 0 end  as woowa_bpcpn_actual                  &#10; &#10;            , f1.mediation_commission&#10;            , coalesce(f4.delivery_commission_amount, 0) as delivery_commission_amount&#10;            , d.agency_code&#10;            , d.quick_unit_no as quick_unit_no_orig&#10;            , case when a.stype1_nm = &apos;일반셀러&apos; then a.ord_sheet_no else d.quick_unit_no end as quick_unit_no&#10;            , f4.expected_preparation_minute as expected_preparation_time&#10;            , coalesce(e.od_dlvry_cnt, 0) as od_dlvry_cnt&#10;            , case when a.is_return = 1 then 0&#10;                   when a.stype1_nm = &apos;건기식&apos; then 0&#10;                   when a.stype1_nm = &apos;일반셀러&apos; then f2.mediation_commission_fee_normal&#10;                   else (a.order_amount - a.seller_divided_coupon_discount_amount)*f1.mediation_commission*0.01&#10;                   end as mediation_commission_fee&#10;            , case when a.stype1_nm = &apos;건기식&apos; then 0&#10;                   else (a.order_amount - a.seller_divided_coupon_discount_amount + a.order_delivery_amount + a.order_envelope_amount)*0.03 end as payment_commission_fee -- 결제정산수수료는 고객부담반품배달도 포함되고 GPV, 배달팁 모두 + 이므로, 고객부담반품배달을 별도 구분할 필요 없음&#10;            , case when a.is_return = 1 then 0&#10;                   when a.stype1_nm = &apos;건기식&apos; then f3.ggs_commission_fee&#10;                   else 0 end as ggs_commission_fee&#10;            , case when a.stype1_nm = &apos;건기식&apos; and a.is_return = 1 then a.order_amount&#10;                   when a.stype1_nm = &apos;건기식&apos; and a.is_return =0 then a.order_delivery_amount                   &#10;                   else e.od_dlvry_cnt * f4.delivery_commission_amount end as dlvry_slr_fee&#10;                    &#10;                    &#10;            , dlv.reg_at&#10;            , dlv.acc_at&#10;            , dlv.pck_at&#10;            , dlv.com_at&#10;            , dlv.reg_acc_time&#10;            , dlv.acc_pck_time&#10;            , dlv.pck_com_time&#10;            , dlv.reg_com_time&#10;            , dlv.reg_hh&#10;            , dlv.acc_hh&#10;            , dlv.pck_hh&#10;            , dlv.com_hh      &#10;            , dlv.customer_notification_at&#10;            , dlv.customer_notification_time&#10;            , dlv.expected_delivery_at&#10;            , dlv.expected_delivery_time&#10;            , dlv.is_intime&#10;            , dlv.is_over60m&#10;            , dlv.is_over120m&#10;                    &#10;            , a.receiver_lat&#10;            , a.receiver_lng&#10;            , k.x_axis_utmk&#10;            , k.y_axis_utmk&#10;            , k.dlvry_dist&#10;            , a.part_date&#10;            , h.weekstart_dt&#10;            , h.yyyymm&#10;            , h.week_nb&#10;            , h.week_nm&#10;            , h.day_nm&#10;            , h.date_day&#10;             &#10;        from&#10;            ord_tb a&#10;        left join&#10;            seller_cpn_actual c&#10;            on a.ord_no = c.order_no&#10;        left join&#10;            ord_agency d&#10;            on a.ord_sheet_no = d.order_sheet_no&#10;        left join&#10;            ord_dlvry e&#10;            on a.ord_no = e.ord_no&#10;        left join&#10;            fcseller_commission f1&#10;            on a.ord_no = f1.ord_no           &#10;        left join&#10;            ord_normal_mcf f2&#10;            on a.ord_no = f2.order_no&#10;        left join&#10;           ggs_normal_mcf f3&#10;           on a.ord_no =  f3.order_no&#10;         left join&#10;           dlvry_commission f4&#10;           on a.ord_no =  f4.ord_no         &#10;            &#10;        left join&#10;            temp.bms_date_tb h&#10;            on a.part_date = h.date_cd&#10;        left join&#10;            sbbi.dim_rgn_cd i&#10;            on substr(a.member_rgn3_cd,1,8) = i.rgn3_cd&#10;        left join&#10;            sbbi.dim_rgn_cd j&#10;            on substr(a.branch_rgn3_cd,1,8) = j.rgn3_cd&#10;        left join&#10;            ord_dist k&#10;            on a.ord_sheet_no = k.ord_sheet_no&#10;        left join&#10;            dlv_tb dlv&#10;            on a.ord_sheet_no = dlv.ord_sheet_no&#10;        left join&#10;            temp.bms_seller_category cat&#10;            on a.headequarter_category_nm = cat.internal_category_dep2_nm</relation>
