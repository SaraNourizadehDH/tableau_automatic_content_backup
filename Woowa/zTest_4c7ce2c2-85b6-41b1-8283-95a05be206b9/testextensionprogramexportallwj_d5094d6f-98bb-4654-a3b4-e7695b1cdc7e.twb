        <calculation class='tableau' formula='sum([[KPI]]선물하기 발행금액(전체) 실적(복사본)_1459025593353293849])&#10;/&#10;sum([sqlproxy.1cn6xe909leg4y1efvafk04b2gk9].[target_b2c_issue_amt])' />
