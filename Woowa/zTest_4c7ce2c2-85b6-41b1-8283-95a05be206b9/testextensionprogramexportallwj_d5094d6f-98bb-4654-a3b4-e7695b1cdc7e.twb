      <column caption='상품당 판매수량(발행)' datatype='real' name='[Calculation_1459025593288949775]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_5380816454034059267])/&#10;([Calculation_1459025593345916945] &#10; +[Calculation_1459025593347342357]&#10;)' />
      </column>
      <column caption='인당 판매수량' datatype='real' name='[Calculation_1459025593292423184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[발행금액 실적 (할인미차감)(복사본)_428897546637881346]/[Calculation_428897546651983879]' />
      </column>
      <column caption='[상품구성]배민통합상품권 - 정액권' datatype='integer' name='[Calculation_1459025593345916945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='max(&#10;if [giftcard_type_cd]=&apos;BAEMIN_GIFT&apos;&#10;then [giftcard_cnt] end&#10;)' />
      </column>
      <column caption='[상품구성]브랜드상품권수 - 전체' datatype='integer' name='[Calculation_1459025593347342357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[배민통합상품권 - 정액권(복사본)_1459025593346519058]&#10;+&#10;[[상품구성]]브랜드상품권수 - 정액권(복사본)_1459025593346990100]' />
      </column>
      <column caption='net_issue_faceval' datatype='integer' name='[Calculation_1864842127933546496]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='sum([issue_faceval]-[issue_cancel_faceval])' />
      </column>
      <column caption='발행금액 실적 (할인미차감)' datatype='integer' name='[Calculation_2074963204066914370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[issue_faceval]-[issue_cancel_faceval]' />
      </column>
      <column caption='[KPI]선물하기 발행금액(전체) 달성률' datatype='real' name='[Calculation_2074963204071571524]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([발행금액 실적 (할인미차감)(복사본)_1459025593352843287])&#10;/&#10;sum([sqlproxy.1cn6xe909leg4y1efvafk04b2gk9].[target_issue_amt])' />
      </column>
      <column caption='누적 사용금액(필터에따라)' datatype='integer' name='[Calculation_2342786658506502172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(SUM([net_use_amt]), 0, LAST())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column aggregation='Sum' caption='연도' datatype='integer' name='[Calculation_2342786658514427937]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='year([part_date])' />
      </column>
      <column caption='발행금액 전월비 실적' datatype='real' name='[Calculation_428897546641874948]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([발행금액 실적 (할인미차감)(복사본)_1459025593352843287])) &#10;- ZN(LOOKUP(SUM([발행금액 실적 (할인미차감)(복사본)_1459025593352843287]), 1))) &#10;/ ABS(ZN(LOOKUP(SUM([발행금액 실적 (할인미차감)(복사본)_1459025593352843287]), 1)))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='구매자 수' datatype='integer' name='[Calculation_428897546651983879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [giftcard_contract_type_cd]=&quot;B2C&quot; and [giftcard_sale_ch_cd]=&quot;TOTAL&quot; and [giftcard_type_cd]=&quot;TOTAL&quot;&#10;then [issue_mem_cnt] end' />
      </column>
      <column caption='[KPI]선물하기 이용자 수 - 달성률' datatype='real' name='[Calculation_428897546658537481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5380816454029156354])&#10;/&#10;SUM([sqlproxy.1cn6xe909leg4y1efvafk04b2gk9].[target_user_cnt])' />
      </column>
      <column caption='누적금액' datatype='integer' name='[Calculation_428897546680201229]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed [giftcard_contract_type_cd],[giftcard_type_cd],[giftcard_sale_ch_cd]:&#10;sum([reg_faceval])&#10;}' />
      </column>
      <column caption='등록금액율(%) 누적총계' datatype='real' name='[Calculation_460000539318169622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[누적 등록금액(전체기간)(복사본)_460000539314941971]/[누적 등록금액 (전체기간총계)(복사본)_460000539317923861]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='[KPI]선물하기 이용자수 - 실적' datatype='integer' name='[Calculation_5380816454029156354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [giftcard_contract_type_cd]=&apos;TOTAL&apos; and [giftcard_type_cd]=&apos;TOTAL&apos; and [giftcard_sale_ch_cd]=&apos;TOTAL&apos;&#10;then &#10;[use_exprc_mem_cnt]&#10;end' />
      </column>
      <column caption='전체 발행수량' datatype='integer' name='[Calculation_5380816454034059267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [giftcard_contract_type_cd]=&apos;TOTAL&apos; and [giftcard_type_cd]=&apos;TOTAL&apos; and [giftcard_sale_ch_cd]=&apos;TOTAL&apos;&#10;then&#10;[발행금액 실적 (할인미차감)(복사본)_428897546637881346]&#10;end' />
      </column>
      <column caption='경험고객수' datatype='integer' name='[Calculation_5380816454040707080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [giftcard_contract_type_cd]=&quot;TOTAL&quot; and [giftcard_sale_ch_cd]=&quot;TOTAL&quot; and [giftcard_type_cd]=&quot;TOTAL&quot;&#10;then &#10;[exprc_mem_cnt]&#10;end' />
      </column>
      <column caption='재구매자 B2C' datatype='integer' name='[Calculation_5564127032706875402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_428897546651983879])&#10;-&#10;SUM([sqlproxy.0k5h5ex1fqeg5z104dcza0uggbnj].[Calculation_5564127032706367496])' />
      </column>
      <column caption='신규구매자 비중%' datatype='real' name='[Calculation_5564127032708034571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sqlproxy.0k5h5ex1fqeg5z104dcza0uggbnj].[Calculation_5564127032706367496])&#10;/&#10;sum([구매자 수(복사본)_1459025593357144091])' />
