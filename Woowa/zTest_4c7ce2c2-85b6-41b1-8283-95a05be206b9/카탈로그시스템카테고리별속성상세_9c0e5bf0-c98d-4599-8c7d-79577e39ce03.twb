      <aliases enabled='yes' />
      <column caption='KPI info' datatype='string' name='[Calculation_1002613922327965697]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Number]&#13;&#10;WHEN 1 THEN &apos;카탈로그 매칭 Coverage&apos;&#13;&#10;WHEN 2 THEN &apos;카탈로그 미매칭 상품 카테고리 Top&apos;&#13;&#10;WHEN 3 THEN &apos;카탈로그 미매칭 상품 매핑 카테고리 Top&apos;&#13;&#10;WHEN 4 THEN &apos;속성 Coverage&apos;&#13;&#10;WHEN 5 THEN &apos;속성 미입력 상품 카테고리 Top&apos;&#13;&#10;WHEN 6 THEN &apos;속성 미입력 상품 매핑 카테고리 Top&apos;&#13;&#10;WHEN 7 THEN &apos;아이템수 - 카탈로그수&apos;&#13;&#10;WHEN 8 THEN &apos;속성 미입력 아이템 Top&apos;&#13;&#10;END' />
      </column>
      <column caption='Dashboard info' datatype='string' name='[Calculation_1002613922332123142]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Number]&#13;&#10;WHEN 1 THEN &apos;커머스 아이템의 카탈로그/속성 Coverage와 품질을 모니터링하기 위한 대시보드입니다.&apos;&#13;&#10;END' />
      </column>
      <column datatype='integer' name='[Number]' role='dimension' type='ordinal' />
      <_.fcp.ObjectModelTableType.true...column caption='Clipboard_20240828T004038' datatype='table' name='[__tableau_internal_object_id__].[Clipboard_20240828T004038]' role='measure' type='quantitative' />
      <column caption='desc' datatype='string' name='[info(복사본)_1002613922328645635]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Number]&#13;&#10;WHEN 1 THEN &apos;사용 아이템 대비 카탈로그에 매칭된 아이템 비율&apos;&#13;&#10;WHEN 2 THEN &apos;카탈로그가 매칭되지 않은 사용 아이템 수가 많은 상품 카테고리 (카테고리 레벨별 비교)&apos;&#13;&#10;WHEN 3 THEN &apos;카탈로그가 매칭되지 않은 사용아이템수가 많은 상품 매핑 카테고리(leaf카테고리별 비교)&apos;&#13;&#10;WHEN 4 THEN &apos;사용 아이템 대비 속성이 1개 이상 입력된 아이템 비율&apos;&#13;&#10;WHEN 5 THEN &apos;속성이 입력되지 않은 사용 아이템 수가 많은 상품 카테고리 (카테고리 레벨별 비교)&apos;&#13;&#10;WHEN 6 THEN &apos;속성이 입력되지 않은 사용 아이템수가 많은 상품 매핑 카테고리(leaf카테고리별 비교)&apos;&#13;&#10;WHEN 7 THEN &apos;사용 아이템수 대비 카탈로그수 Gap이 높은 상품 카테고리 (카테고리 레벨별 비교)&apos;&#13;&#10;WHEN 8 THEN &apos;속성값이 입력되지 않은 사용 아이템 중 판매량 높은 아이템 (판매량 높은순)&apos;&#13;&#10;END' />
      </column>
