      <column caption='C_Cat_Lv_트리' datatype='string' name='[C_Cat_Lv(복사본)_370984066770747415]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3]&#13;&#10;WHEN 1 THEN [카테고리1레벨]&#13;&#10;WHEN 2 THEN [카테고리1레벨]+&apos; &gt; &apos;+[카테고리2레벨]&#13;&#10;WHEN 3 THEN [카테고리1레벨]+&apos; &gt; &apos;+[카테고리2레벨]+&apos; &gt; &apos;+[카테고리3레벨]&#13;&#10;WHEN 4 THEN [카테고리1레벨]+&apos; &gt; &apos;+[카테고리2레벨]+&apos; &gt; &apos;+[카테고리3레벨]+&apos; &gt; &apos;+[카테고리4레벨]&#13;&#10;WHEN 5 THEN [카테고리1레벨]+&apos; &gt; &apos;+[카테고리2레벨]+&apos; &gt; &apos;+[카테고리3레벨]+&apos; &gt; &apos;+[카테고리4레벨]+&apos; &gt; &apos;+[카테고리5레벨]&#13;&#10;WHEN 6 THEN [카테고리1레벨]+&apos; &gt; &apos;+[카테고리2레벨]+&apos; &gt; &apos;+[카테고리3레벨]+&apos; &gt; &apos;+[카테고리4레벨]+&apos; &gt; &apos;+[카테고리5레벨]+&apos; &gt; &apos;+[카테고리6레벨]&#13;&#10;END' />
      </column>
      <column caption='C_KPI 명' datatype='string' name='[C_KPI (복사본)_2096425672868102158]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[매개 변수 4]&#13;&#10;when 1 then null&#13;&#10;when 2 then &apos;속성 Coverage 아이템수&apos;&#13;&#10;when 3 then &apos;속성 입력 아이템수&apos;&#13;&#10;when 4 then &apos;브랜드 ID입력 아이템수&apos;&#13;&#10;when 5 then &apos;제조사 ID입력 아이템수&apos;&#13;&#10;end' />
