  <object-graph>
    <objects>
      <object caption='사용자 지정 SQL 쿼리' id='_19C290AC7DCC49FCBEA2FA7469253912'>
        <properties context=''>
          <relation connection='athena.19khd0b04wj27h1618bmc1n1mfj1' name='사용자 지정 SQL 쿼리' type='text'>WITH   &#10;  menu_summary_base&#10;    AS (&#10;    select menu_id&#10;         , shop_no&#10;         , shop_service_type&#10;         , replace(replace(shop_category, &apos;RIDERS_&apos;, &apos;&apos;), &apos;BAEMIN_1_&apos;, &apos;&apos;) AS shop_category&#10;         , menu_info_id&#10;         , menu_name_clean as menu_name&#10;         , menu_group_name&#10;         , CAST(regexp_like(lower(replace(menu_group_name, &apos;.&apos;, &apos;&apos;)), &apos;사이드|옵션|추가|스낵|주류|사리|소스|기타|side|option|add|snack|alcohol|source|etc&apos;) AS INT) AS is_side &#10;         , is_franchise_shop as is_shop_franchise&#10;         , is_franchise_menupan as is_menupan_franchise&#10;         , is_representative&#10;         , is_popular&#10;         , is_solo &#10;         , is_alcohol as is_alchohol&#10;         , is_vegetarian &#10;         , is_image as use_image&#10;         , created_dttm as menu_created_at&#10;         , modified_dttm as menu_modified_at&#10;    from dsdw.menu_master) , &#10;  menu_category&#10;    AS (&#10;        select menu_info_id&#10;             , concat_ws(&apos;,&apos;, array_agg(distinct(split_part(category_full, &apos;|&apos;, 1)))) AS category_1 &#10;             , concat_ws(&apos;,&apos;, array_agg(distinct(split_part(category_full, &apos;|&apos;, 2)))) AS category_2&#10;             , concat_ws(&apos;,&apos;, array_agg(distinct(split_part(category_full, &apos;|&apos;, 3)))) AS category_3 &#10;        from&#10;        (&#10;            select mc.menu_info_id, mc.category_id, c.name as category, c.full_name as category_full &#10;                 , rank() over(partition by mc.menu_info_id order by date(mc.created_at) desc) as rn&#10;            from sbmenu.menu_category mc&#10;                join sbmenu.category c on c.category_id = mc.category_id&#10;        )&#10;        where rn = 1&#10;        group by 1&#10;    ) ,&#10;  menu_tag&#10;    AS (&#10;    select menu_info_id&#10;         , concat_ws(&apos;,&apos;, array_agg(distinct(tag))) as tag&#10;    from&#10;    (&#10;        select mt.menu_info_id, mt.tag_id, t.tag_name as tag&#10;             , rank() over(partition by mt.menu_info_id order by date(mt.created_at) desc) as rn&#10;        from sbmenu.menu_tag mt&#10;            join sbmenu.tag t on t.tag_id = mt.tag_id&#10;    )&#10;    where rn = 1&#10;    group by 1&#10;    ) ,&#10;  menu_summary&#10;    AS (&#10;    select ms.*&#10;         , concat_ws(&apos;,&apos;, if(is_representative = 1, &apos;대표&apos;), if(is_popular = 1, &apos;인기&apos;), if(is_solo = 1, &apos;1인분&apos;), if(is_alchohol = 1, &apos;주류&apos;), if(is_vegetarian = 1, &apos;채식&apos;), if(is_side = 1, &apos;사이드&apos;), if(use_image = 1, &apos;이미지&apos;)) as menu_option &#10;         , mc.category_1&#10;         , mc.category_2&#10;         , mc.category_3&#10;         , mt.tag&#10;    from menu_summary_base ms&#10;    left join menu_category mc&#10;    on ms.menu_info_id = mc.menu_info_id&#10;    left join menu_tag mt&#10;    on ms.menu_info_id = mt.menu_info_id&#10;    ) ,&#10;  member_info &#10;    AS (&#10;    SELECT mem_no &#10;         , (CAST(replace(CAST(&lt;[Parameters].[매개 변수 1]&gt; AS VARCHAR),&apos;-&apos;,&apos;&apos;) AS INTEGER) - CAST(birth AS INTEGER)) / 10000 AS age &#10;         , CASE WHEN (CAST(replace(CAST(&lt;[Parameters].[매개 변수 1]&gt; AS VARCHAR),&apos;-&apos;,&apos;&apos;) AS INTEGER) - CAST(birth AS INTEGER)) / 10000 &lt;&lt; 10 THEN &apos;10세미만&apos;&#10;                WHEN (CAST(replace(CAST(&lt;[Parameters].[매개 변수 1]&gt; AS VARCHAR),&apos;-&apos;,&apos;&apos;) AS INTEGER) - CAST(birth AS INTEGER)) / 10000 &lt;&lt; 20 THEN &apos;10대&apos;&#10;                WHEN (CAST(replace(CAST(&lt;[Parameters].[매개 변수 1]&gt; AS VARCHAR),&apos;-&apos;,&apos;&apos;) AS INTEGER) - CAST(birth AS INTEGER)) / 10000 &lt;&lt; 30 THEN &apos;20대&apos;&#10;                WHEN (CAST(replace(CAST(&lt;[Parameters].[매개 변수 1]&gt; AS VARCHAR),&apos;-&apos;,&apos;&apos;) AS INTEGER) - CAST(birth AS INTEGER)) / 10000 &lt;&lt; 40 THEN &apos;30대&apos;&#10;                WHEN (CAST(replace(CAST(&lt;[Parameters].[매개 변수 1]&gt; AS VARCHAR),&apos;-&apos;,&apos;&apos;) AS INTEGER) - CAST(birth AS INTEGER)) / 10000 &lt;&lt; 50 THEN &apos;40대&apos;&#10;                WHEN (CAST(replace(CAST(&lt;[Parameters].[매개 변수 1]&gt; AS VARCHAR),&apos;-&apos;,&apos;&apos;) AS INTEGER) - CAST(birth AS INTEGER)) / 10000 &lt;&lt; 60 THEN &apos;50대&apos;&#10;                ELSE &apos;60세이상&apos; END AS age_group &#10;         , gender&#10;    FROM   auth.auth_additional&#10;    WHERE  birth IS NOT NULL) , &#10;  ord_base &#10;    AS (&#10;    SELECT mem_no &#10;         , ord_no &#10;         , shop_no &#10;         , service_type &#10;         , delivery_type &#10;         , replace(replace(shop_category, &apos;RIDERS_&apos;, &apos;&apos;), &apos;BAEMIN_1_&apos;, &apos;&apos;) AS shop_category &#10;         , ord_price &#10;         , delivery_tip &#10;         , hour(order_date + interval &apos;9&apos; hour) AS hour &#10;         , part_date&#10;    FROM   sborder_mart.order_master&#10;    WHERE part_date &gt;&gt;= cast(date(&lt;[Parameters].[매개 변수 1]&gt;) - interval &apos;1&apos; month as varchar)&#10;    AND part_date &lt;&lt;= cast(&lt;[Parameters].[매개 변수 1]&gt; as varchar)&#10;    AND    is_test = 0&#10;    AND    is_closed = 1) , &#10;  menu_ord &#10;    AS (&#10;    SELECT a.ord_no &#10;         , a.mem_no &#10;         , c.age &#10;         , c.age_group &#10;         , c.gender &#10;         , a.shop_no &#10;         , a.shop_category &#10;         , a.service_type &#10;         , a.delivery_type &#10;         , a.ord_price &#10;         , a.delivery_tip &#10;         , b.item_mapping_id &#10;         , b.item_name &#10;         , b.item_price &#10;         , b.item_quantity &#10;         , a.hour &#10;         , a.part_date&#10;    FROM   ord_base a&#10;           JOIN &#10;                (&#10;                SELECT * FROM sbsvc.ord_item&#10;                WHERE part_date &gt;&gt;= cast(date(&lt;[Parameters].[매개 변수 1]&gt;) - interval &apos;1&apos; month as varchar)&#10;                AND part_date &lt;&lt;= cast(&lt;[Parameters].[매개 변수 1]&gt; as varchar)&#10;                ) b&#10;           ON a.ord_no = b.ord_no&#10;           JOIN member_info c&#10;           ON a.mem_no = c.mem_no&#10;    )&#10;    , menu_ord_mart as&#10;    (&#10;    SELECT a.mem_no &#10;         , a.age &#10;         , a.age_group &#10;         , a.gender &#10;         , a.ord_no &#10;         , case when a.delivery_type = &apos;DELIVERY&apos; then&#10;                case when a.service_type = &apos;BAEMIN&apos; then &apos;배달&apos;&#10;                     when a.service_type = &apos;BAERA&apos; then &apos;배민1&apos;&#10;                     end&#10;                when a.delivery_type = &apos;TAKEOUT&apos; then &apos;포장&apos;&#10;                when a.delivery_type = &apos;EAT_IN&apos; then &apos;매장&apos;&#10;                end as service_type&#10;         , a.shop_no &#10;         , b.shop_category &#10;         , a.ord_price &#10;         , a.delivery_tip &#10;         , coalesce(a.item_name, b.menu_name) as menu_name&#10;         , b.menu_group_name &#10;         , b.is_side &#10;         , a.item_mapping_id &#10;         , a.item_price &#10;         , a.item_quantity &#10;         , b.is_representative &#10;         , b.is_popular &#10;         , b.is_solo &#10;         , b.is_alchohol &#10;         , b.is_vegetarian &#10;         , b.use_image &#10;         , b.menu_option&#10;         , b.category_1&#10;         , b.category_2&#10;         , b.category_3&#10;         , b.tag&#10;         , a.hour &#10;         , a.part_date&#10;    FROM   menu_ord a&#10;           LEFT JOIN menu_summary b&#10;           ON a.item_mapping_id = b.menu_id&#10;&#10;    )&#10;&#10;&#10;    select part_date&#10;         , age_group&#10;         , gender&#10;         , service_type&#10;         , shop_category&#10;         , hour&#10;         , menu_name&#10;         , item_mapping_id&#10;         , menu_option&#10;         , category_1&#10;         , category_2&#10;         , category_3&#10;         , tag         &#10;         , sum(item_quantity) as tot_quantity&#10;         , count(distinct ord_no) as ord_cnt&#10;    from menu_ord_mart&#10;    group by part_date&#10;         , age_group&#10;         , gender&#10;         , service_type&#10;         , shop_category&#10;         , hour&#10;         , menu_name&#10;         , item_mapping_id&#10;         , menu_option&#10;         , category_1&#10;         , category_2&#10;         , category_3&#10;         , tag</relation>
        </properties>
      </object>
    </objects>
  </object-graph>
</datasource>
