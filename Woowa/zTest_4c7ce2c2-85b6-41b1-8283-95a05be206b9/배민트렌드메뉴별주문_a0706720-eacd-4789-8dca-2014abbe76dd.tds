  <datasource-dependencies datasource='Parameters'>
    <column caption='기준일' datatype='date' name='[매개 변수 1]' param-domain-type='any' role='measure' type='quantitative' value='#2022-06-14#'>
      <calculation class='tableau' formula='#2022-06-14#' />
