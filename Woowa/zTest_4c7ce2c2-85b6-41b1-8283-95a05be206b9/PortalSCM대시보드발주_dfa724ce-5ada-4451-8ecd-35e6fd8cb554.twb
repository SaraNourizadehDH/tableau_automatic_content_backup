        <calculation class='tableau' formula='IF [Parameters].[매개 변수 7]=&apos;DC&apos;&#13;&#10;THEN [rciv_fcst_qty]&#13;&#10;ELSEIF [Parameters].[매개 변수 7]=&apos;FC&apos;&#13;&#10;THEN [rciv_fcst_qty]&#13;&#10;END' />
