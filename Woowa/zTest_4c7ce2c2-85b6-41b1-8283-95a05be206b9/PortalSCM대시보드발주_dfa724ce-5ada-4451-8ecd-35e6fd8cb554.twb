              <calculation class='tableau' formula='CASE [Parameters].[P_KPI_Type(복사본)_17170034660561001]&#13;&#10;WHEN &apos;예상 입고 수량&apos; THEN SUM([rciv_fcst_qty]) &#13;&#10;WHEN &apos;실입고 수량&apos; THEN SUM([rciv_qty])&#13;&#10;WHEN &apos;정확도&apos; THEN sum(rciv_qty) / sum(rciv_fcst_qty)&#13;&#10;END' />
