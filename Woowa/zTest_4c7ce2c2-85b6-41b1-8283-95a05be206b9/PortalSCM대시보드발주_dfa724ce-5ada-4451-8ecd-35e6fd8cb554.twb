              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; THEN STR([C_day(복사본)_17170034559860751])&#13;&#10;WHEN &apos;주별&apos; THEN STR([Calculation_153966862634762240]) + &apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN IF [weekday_nm] IN (&apos;토&apos;,&apos;일&apos;) THEN STR([Calculation_17170034559803406]) + char(10)&#13;&#10;                                                    + IF [holiday_yn]=&apos;1&apos; THEN &apos;(&apos;+[weekday_nm]+&apos;)&apos; + char(10) + [Calculation_1478869595292553228]&#13;&#10;                                                      ELSE &apos;(&apos;+[weekday_nm]+&apos;)&apos; + char(10)&#13;&#10;                                                      END + char(10)&#13;&#10;                ELSE STR([Calculation_17170034559803406]) + char(10) +&#13;&#10;                     IF [holiday_yn]=&apos;1&apos; THEN &apos;(&apos;+[weekday_nm]+&apos;)&apos; + char(10) + [Calculation_1478869595292553228]&#13;&#10;                                                      ELSE char(10)&#13;&#10;                                                      END + char(10)&#13;&#10;                END&#13;&#10;END&#13;&#10;&#13;&#10;/*&#13;&#10;IF [P_Date_Type]=&apos;월별&apos;&#13;&#10;THEN STR([C_month]) + &apos;월&apos;&#13;&#10;ELSEIF [P_Date_Type]=&apos;주별&apos;&#13;&#10;THEN STR([C_week]) + &apos;W&apos;&#13;&#10;ELSEIF [P_Date_Type]=&apos;일별&apos; AND DATEDIFF(&apos;day&apos;,[P_Start_Date],[P_End_Date])&lt;=30&#13;&#10;THEN STR([C_month]) + &apos;/&apos; + STR([C_day])&#13;&#10;END&#13;&#10;*/' />
            </column>
            <column caption='C_KPI_Type_DC(%)' datatype='real' name='[C_KPI_Type(복사본)_17170034606178366]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 4 1]=&apos;권고대비 입고율&apos;&#13;&#10;THEN ZN([권고대비 입고율(수량)(복사본)_17170034578296866])&#13;&#10;ELSEIF [Parameters].[매개 변수 4 1]=&apos;발주대비 입고율&apos;&#13;&#10;THEN zn([Calculation_17170034593480761])&#13;&#10;END' />
