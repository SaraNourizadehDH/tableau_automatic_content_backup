      <column caption='C_W-8' datatype='string' name='[C_W-7(복사본)_827255009766772847]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;(&apos;&#13;&#10;+STR(MONTH(DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -8, [Parameters].[매개 변수 2]), &apos;Monday&apos;)))&#13;&#10;+ &apos;/&apos;&#13;&#10;+ STR(DAY(DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -8, [Parameters].[매개 변수 2]), &apos;Monday&apos;)))&#13;&#10;+ &apos;-&apos;&#13;&#10;+&apos;&#13;&#10;&apos;+ STR(MONTH(DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -7, [Parameters].[매개 변수 2]), &apos;Monday&apos;)-1))&#13;&#10;+ &apos;/&apos;&#13;&#10;+ STR(DAY(DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -7, [Parameters].[매개 변수 2]), &apos;Monday&apos;)-1))&#13;&#10;+&apos;)&apos;' />
      </column>
      <column caption='C_날짜_주별' datatype='string' hidden='true' name='[C_날짜_월별(복사본)_612208132127977486]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;주별&apos;&#13;&#10;THEN &apos;현재 적용 기간 : &apos;&#13;&#10;+ str(ISOWEEK(DATEADD(&apos;week&apos;,-7,[Parameters].[매개 변수 2])))+&apos;W&apos;&#13;&#10;+&apos; ~ &apos;+ str(ISOWEEK(DATEADD(&apos;week&apos;,0,[Parameters].[매개 변수 2])))+&apos;W&apos;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='C_날짜_일별_적용범위 (&lt;=30)' datatype='string' name='[C_날짜_일별_적용범위 (&gt;30)(복사본)_612208132138332180]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[P_End_Date(복사본)_827255009348214784], [Parameters].[매개 변수 2]) &lt;= 30&#13;&#10;    THEN &apos;현재 적용 기간 : &apos;+ STR([Parameters].[P_End_Date(복사본)_827255009348214784]) +&apos; ~ &apos; + STR([Parameters].[매개 변수 2])&#13;&#10;    ELSE &apos;&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='C_날짜_주별(상세)' datatype='string' name='[C_날짜_주별(복사본)_2000724203169603597]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;주별&apos;&#13;&#10;THEN &apos;현재 적용 기간 : &apos;&#13;&#10;+  str(ISOWEEK(DATEADD(&apos;week&apos;,-8,[Parameters].[매개 변수 2])))+&apos;W&apos;&#13;&#10;+&apos; ~ &apos;+  str(ISOWEEK(DATEADD(&apos;week&apos;,0,[Parameters].[매개 변수 2])))+&apos;W&apos;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='C_날짜_일별_경고문구 (&gt;30)' datatype='string' name='[C_날짜적용범위 (&lt;=30)(복사본)_1292533150780383235]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[P_End_Date(복사본)_827255009348214784], [Parameters].[매개 변수 2]) &gt; 30&#13;&#10;    THEN &apos;※ 기간을 31일 이내로 입력하세요.&apos;&#13;&#10;    ELSEIF [Parameters].[P_End_Date(복사본)_827255009348214784] &gt; [Parameters].[매개 변수 2]&#13;&#10;    THEN &apos;※ 시작일이 종료일보다 큽니다.&apos;&#13;&#10;    ELSE &apos;&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='C_단위(금액/수량)' datatype='string' name='[C_단위(FC)(복사본)_2289799003515899907]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 5 1]&#13;&#10;WHEN &apos;금액&apos; THEN &apos;%, 원&apos;&#13;&#10;WHEN &apos;수량&apos; THEN &apos;%, 개&apos;&#13;&#10;END' />
      </column>
      <column caption='C_단위(FC)' datatype='string' name='[C_단위(복사본)_1540512608165490706]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[P_KPI_Type(복사본)_17170034660561001]&#13;&#10;WHEN &apos;예상 입고 수량&apos; THEN &apos;개&apos;&#13;&#10;WHEN &apos;실입고 수량&apos; THEN &apos;개&apos;&#13;&#10;WHEN &apos;정확도&apos; THEN &apos;%&apos;&#13;&#10;END' />
      </column>
      <column caption='C_종료일' datatype='string' name='[C_시작일(일별)(복사본)_771241503685345280]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[P_End_Date(복사본)_827255009348214784], [Parameters].[매개 변수 2]) &lt;= 30&#13;&#10;    THEN &apos;종료일 :&apos;&#13;&#10;    ELSE &apos;종료일 :&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;기준일 :&apos;&#13;&#10;END' />
      </column>
      <column caption='C_시작일(일별)' datatype='string' name='[C_시작일(일별)_경고(복사본)_612208132136902675]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[P_End_Date(복사본)_827255009348214784], [Parameters].[매개 변수 2]) &lt;= 30&#13;&#10;    THEN &apos;시작일 :&apos;&#13;&#10;    ELSE &apos;&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='T/F_Date_Type' datatype='boolean' name='[Calculation_1123366682689613825]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = [Date Type]&#13;&#10;THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
      </column>
      <column caption='TRUE' datatype='boolean' name='[Calculation_1123366682691923976]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRUE' />
      </column>
      <column caption='FALSE' datatype='boolean' name='[Calculation_1123366682691952649]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='FALSE' />
      </column>
      <column caption='Text_Date_Type' datatype='string' name='[Calculation_1123366682711617552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Date Type]&#13;&#10;WHEN &apos;월별&apos; THEN &apos;`&apos; + right(STR(YEAR([Parameters].[매개 변수 2])),2)+ &apos;.&apos;+ MID(str([Parameters].[매개 변수 2]),6,2)&#13;&#10;WHEN &apos;주별&apos; THEN STR(ISOWEEK([Parameters].[매개 변수 2])) + &apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN REPLACE(MID(str([Parameters].[매개 변수 2]),6,5),&apos;-&apos;,&apos;/&apos;)&#13;&#10;END' />
      </column>
      <column caption='C_날짜_일별_적용범위 (&gt;30)' datatype='string' name='[Calculation_1292533150779940866]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[P_End_Date(복사본)_827255009348214784], [Parameters].[매개 변수 2]) &gt; 30&#13;&#10;    THEN &apos;현재 적용 기간 : &apos;+ STR(DATEADD(&apos;day&apos;, -30, [Parameters].[매개 변수 2])) +&apos; ~ &apos; + STR([Parameters].[매개 변수 2])&#13;&#10;    ELSE &apos;&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='C_날짜범위경고' datatype='boolean' hidden='true' name='[Calculation_1292533150781136900]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[매개 변수 1] = &apos;일별&apos; AND DATEDIFF(&apos;day&apos;, [Parameters].[P_End_Date(복사본)_827255009348214784], [Parameters].[매개 변수 2]) &gt; 30&#13;&#10;OR &#13;&#10;[Parameters].[매개 변수 1] = &apos;일별&apos; AND [Parameters].[P_End_Date(복사본)_827255009348214784] &gt;[Parameters].[매개 변수 2]' />
      </column>
      <column caption='C_KPI_(DC)금액/수량' datatype='string' name='[Calculation_1437211293808099328]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Number]&#13;&#10;WHEN 1 THEN &apos;수량&apos;&#13;&#10;WHEN 2 THEN &apos;금액&apos;&#13;&#10;END' />
      </column>
      <column caption='F_Map_Level_1' datatype='boolean' name='[Calculation_1478869595263643650]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[매개 변수 9]=&apos;1&apos;' />
      </column>
      <column caption='C_공급업체' datatype='string' hidden='true' name='[Calculation_1478869595302101007]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;공급업체&apos;' />
      </column>
      <column caption='F_시작일가리기' datatype='boolean' hidden='true' name='[Calculation_1527846228049731591]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] &lt;&gt; &apos;일별&apos; THEN TRUE  END' />
      </column>
      <column caption='C_종료일/기준일' datatype='string' name='[Calculation_1527846228051501071]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Date Type]=&apos;일별&apos;&#13;&#10;THEN &apos;종료일&apos;&#13;&#10;ELSE &apos;기준일&apos;&#13;&#10;END' />
      </column>
      <column caption='C_Start_date(일별)' datatype='date' hidden='true' name='[Calculation_1527846228085997585]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='ATTR(DATE(IF [Date Type] = &apos;일별&apos; THEN DATEADD(&apos;day&apos;, -13, [Parameters].[매개 변수 2]) ELSE [Parameters].[P_End_Date(복사본)_827255009348214784] END))' />
      </column>
      <column caption='Text_Date_Type(select)' datatype='string' name='[Calculation_1527846228134809636]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Date Type]&#13;&#10;WHEN &apos;월별&apos; THEN &apos;`&apos; + right(STR(YEAR([Parameters].[매개 변수 2])),2)+ &apos;.&apos;+ MID(str([Parameters].[매개 변수 2]),6,2)&#13;&#10;WHEN &apos;주별&apos; THEN STR(ISOWEEK([Parameters].[매개 변수 2])) + &apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN REPLACE(MID(str([Parameters].[매개 변수 2]),6,5),&apos;-&apos;,&apos;/&apos;)&#13;&#10;END' />
      </column>
      <column caption='default_Date_Type' datatype='string' hidden='true' name='[Calculation_1527846228426338343]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;일별&apos;' />
      </column>
      <column caption='C_DC/FC구분' datatype='string' name='[Calculation_1625236518389825538]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Number]&#13;&#10;WHEN 1 then &apos;DC&apos;&#13;&#10;WHEN 2 then &apos;FC&apos;&#13;&#10;END' />
      </column>
      <column caption='KPI(DC)_Type' datatype='string' name='[Calculation_1714182669845094404]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Number]&#13;&#10;WHEN 1 then &apos;권고대비 입고율&apos;&#13;&#10;WHEN 2 then &apos;발주대비 입고율&apos;&#13;&#10;WHEN 3 then &apos;권고&apos;&#13;&#10;WHEN 4 then &apos;실발주&apos;&#13;&#10;WHEN 5 then &apos;실입고&apos;&#13;&#10;END' />
      </column>
      <column caption='C_단위(DC)' datatype='string' name='[Calculation_599260285649629200]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[매개 변수 4 1]=&apos;권고&apos; and [Parameters].[매개 변수 5 1]=&apos;금액&apos;&#13;&#10;then &apos;백만원&apos;&#13;&#10;ELSEIF [Parameters].[매개 변수 4 1]=&apos;권고&apos; and [Parameters].[매개 변수 5 1]=&apos;수량&apos;&#13;&#10;then  &apos;개&apos;&#13;&#10;ELSEIF [Parameters].[매개 변수 4 1]=&apos;실발주&apos; and [Parameters].[매개 변수 5 1]=&apos;금액&apos;&#13;&#10;then  &apos;백만원&apos;&#13;&#10;ELSEIF [Parameters].[매개 변수 4 1]=&apos;실발주&apos; and [Parameters].[매개 변수 5 1]=&apos;수량&apos;&#13;&#10;then  &apos;개&apos;&#13;&#10;ELSEIF [Parameters].[매개 변수 4 1]=&apos;실입고&apos; and [Parameters].[매개 변수 5 1]=&apos;금액&apos;&#13;&#10;then  &apos;백만원&apos;&#13;&#10;ELSEIF [Parameters].[매개 변수 4 1]=&apos;실입고&apos; and [Parameters].[매개 변수 5 1]=&apos;수량&apos;&#13;&#10;then  &apos;개&apos;&#13;&#10;ELSEIF [Parameters].[매개 변수 4 1]=&apos;권고대비 입고율&apos; &#13;&#10;then  &apos;%&apos;&#13;&#10;ELSEIF [Parameters].[매개 변수 4 1]=&apos;발주대비 입고율&apos; &#13;&#10;then  &apos;%&apos;&#13;&#10;end' />
      </column>
      <column caption='C_날짜_월별' datatype='string' name='[Calculation_612208132127105037]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;월별&apos;&#13;&#10;THEN &apos;현재 적용 기간 : &apos;&#13;&#10;+ STR(YEAR(DATEADD(&apos;month&apos;,-11,[Parameters].[매개 변수 2]))) + &apos;/&apos; + MID(STR((DATEADD(&apos;month&apos;,-11,[Parameters].[매개 변수 2]))),6,2)&#13;&#10;+&apos; ~ &apos;+ STR(YEAR([Parameters].[매개 변수 2])) + &apos;/&apos; + MID(STR([Parameters].[매개 변수 2]),6,2)&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
