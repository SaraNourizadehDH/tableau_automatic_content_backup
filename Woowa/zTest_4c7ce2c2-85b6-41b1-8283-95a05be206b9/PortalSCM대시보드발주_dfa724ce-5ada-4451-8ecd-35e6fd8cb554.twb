            <column caption='C_KPI_Type(DC)(bar)' datatype='string' name='[C_KPI_Type(DC)(복사본)_1466484629064724483]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 4 1]=&apos;권고대비 입고율&apos;&#13;&#10;THEN &apos;권고대비 입고율&apos;&#13;&#10;ELSEIF [Parameters].[매개 변수 4 1]=&apos;발주대비 입고율&apos;&#13;&#10;THEN &apos;발주대비 입고율&apos;&#13;&#10;ELSEIF [Parameters].[매개 변수 4 1]=&apos;권고&apos;&#13;&#10;THEN &apos;권고&apos;&#13;&#10;ELSEIF [Parameters].[매개 변수 4 1]=&apos;실발주&apos;&#13;&#10;THEN &apos;실발주&apos;&#13;&#10;ELSEIF [Parameters].[매개 변수 4 1]=&apos;실입고&apos;&#13;&#10;THEN &apos;실입고&apos;&#13;&#10;END' />
            </column>
            <column caption='C_month' datatype='string' name='[C_day(복사본)_17170034559860751]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;`&apos; + right([year],2)+ &apos;.&apos;+ [month]' />
