            <column caption='Text_Date_Type' datatype='string' name='[Calculation_1123366682711617552]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Date Type]&#13;&#10;WHEN &apos;월별&apos; THEN &apos;`&apos; + right(STR(YEAR([Parameters].[매개 변수 2])),2)+ &apos;.&apos;+ MID(str([Parameters].[매개 변수 2]),6,2)&#13;&#10;WHEN &apos;주별&apos; THEN STR(ISOWEEK([Parameters].[매개 변수 2])) + &apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN REPLACE(MID(str([Parameters].[매개 변수 2]),6,5),&apos;-&apos;,&apos;/&apos;)&#13;&#10;END' />
            </column>
            <column caption='C_날짜_일별_적용범위 (&gt;30)' datatype='string' name='[Calculation_1292533150779940866]' role='dimension' type='nominal'>
