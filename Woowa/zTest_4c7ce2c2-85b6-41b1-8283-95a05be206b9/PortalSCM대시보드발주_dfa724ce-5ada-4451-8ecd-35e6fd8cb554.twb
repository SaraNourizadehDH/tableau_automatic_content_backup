        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; THEN STR([Calculation_17170034617389126])&#13;&#10;WHEN &apos;주별&apos; THEN STR([Calculation_17170034617450567])&#13;&#10;END' />
      </column>
      <column caption='C_day(2일 O)' datatype='string' name='[Calculation_17170034653593691]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;AND DATEDIFF(&apos;day&apos;,[Parameters].[P_End_Date(복사본)_827255009348214784],[Parameters].[매개 변수 2]) &gt;= 21&#13;&#10;AND int([Calculation_153966862635016193])%2 = 0&#13;&#10;THEN[Calculation_17170034653053016]&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
