            <column caption='F_W' datatype='integer' name='[Calculation_150870589685022731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ISOWEEK(DATEADD(&apos;week&apos;,-0,[Parameters].[매개 변수 2]))' />
