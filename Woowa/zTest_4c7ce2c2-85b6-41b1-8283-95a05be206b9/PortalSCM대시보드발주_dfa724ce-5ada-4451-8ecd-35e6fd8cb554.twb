            <column caption='C_날짜_일별_적용범위 (&lt;=30)' datatype='string' name='[C_날짜_일별_적용범위 (&gt;30)(복사본)_612208132138332180]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[P_End_Date(복사본)_827255009348214784], [Parameters].[매개 변수 2]) &lt;= 30&#13;&#10;    THEN &apos;현재 적용 기간 : &apos;+ STR([Parameters].[P_End_Date(복사본)_827255009348214784]) +&apos; ~ &apos; + STR([Parameters].[매개 변수 2])&#13;&#10;    ELSE &apos;&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='C_날짜_주별(상세)' datatype='string' name='[C_날짜_주별(복사본)_2000724203169603597]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;주별&apos;&#13;&#10;THEN &apos;현재 적용 기간 : &apos;&#13;&#10;+  str(ISOWEEK(DATEADD(&apos;week&apos;,-8,[Parameters].[매개 변수 2])))+&apos;W&apos;&#13;&#10;+&apos; ~ &apos;+  str(ISOWEEK(DATEADD(&apos;week&apos;,0,[Parameters].[매개 변수 2])))+&apos;W&apos;&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='C_날짜_일별_경고문구 (&gt;30)' datatype='string' name='[C_날짜적용범위 (&lt;=30)(복사본)_1292533150780383235]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[P_End_Date(복사본)_827255009348214784], [Parameters].[매개 변수 2]) &gt; 30&#13;&#10;    THEN &apos;※ 기간을 31일 이내로 입력하세요.&apos;&#13;&#10;    ELSEIF [Parameters].[P_End_Date(복사본)_827255009348214784] &gt; [Parameters].[매개 변수 2]&#13;&#10;    THEN &apos;※ 시작일이 종료일보다 큽니다.&apos;&#13;&#10;    ELSE &apos;&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='C_종료일' datatype='string' name='[C_시작일(일별)(복사본)_771241503685345280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[P_End_Date(복사본)_827255009348214784], [Parameters].[매개 변수 2]) &lt;= 30&#13;&#10;    THEN &apos;종료일 :&apos;&#13;&#10;    ELSE &apos;종료일 :&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;기준일 :&apos;&#13;&#10;END' />
            </column>
