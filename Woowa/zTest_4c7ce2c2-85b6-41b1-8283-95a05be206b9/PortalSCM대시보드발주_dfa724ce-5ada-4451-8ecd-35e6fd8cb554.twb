              <calculation class='tableau' formula='IF [Parameters].[매개 변수 4 1]=&apos;권고&apos; and [Parameters].[매개 변수 5 1]=&apos;금액&apos;&#13;&#10;THEN ZN(SUM([rcmd_ord_amt]))&#13;&#10;ELSEIF[Parameters].[매개 변수 4 1]=&apos;실발주&apos; and [Parameters].[매개 변수 5 1]=&apos;금액&apos;&#13;&#10;THEN ZN(SUM([ord_cret_amt]))&#13;&#10;ELSEIF [Parameters].[매개 변수 4 1]=&apos;실입고&apos; and [Parameters].[매개 변수 5 1]=&apos;금액&apos;&#13;&#10;THEN ZN(SUM([dc_rciv_amt]))&#13;&#10;END&#13;&#10;&#13;&#10;/*IF [P_KPI_Type(DC)]=&apos;권고&apos; and [P_Qty/Amt]=&apos;금액&apos;&#13;&#10;THEN (&#13;&#10;        IF LEN(SPLIT( STR(SUM([ord_cret_amt]/1000000)), &apos;.&apos;, 1 ) )=1&#13;&#10;        THEN NULL&#13;&#10;        ELSE (SUM([rcmd_ord_amt]/1000000))&#13;&#10;        END&#13;&#10;     )&#13;&#10;ELSEIF[P_KPI_Type(DC)]=&apos;실발주&apos; and [P_Qty/Amt]=&apos;금액&apos;&#13;&#10;THEN (&#13;&#10;        IF LEN(SPLIT( STR(SUM([ord_cret_amt]/1000000)), &apos;.&apos;, 1 ) )=1&#13;&#10;        THEN NULL&#13;&#10;        ELSE (SUM([ord_cret_amt]/1000000))&#13;&#10;        END&#13;&#10;     )&#13;&#10;ELSEIF [P_KPI_Type(DC)]=&apos;실입고&apos; and [P_Qty/Amt]=&apos;금액&apos;&#13;&#10;THEN (&#13;&#10;        IF LEN(SPLIT( STR(SUM([ord_cret_amt]/1000000)), &apos;.&apos;, 1 ) )=1&#13;&#10;        THEN NULL&#13;&#10;        ELSE ZN(SUM([dc_rciv_amt]/1000000))&#13;&#10;        END&#13;&#10;     )&#13;&#10;ELSEIF  [P_KPI_Type(DC)]=&apos;권고&apos; and [P_Qty/Amt]=&apos;수량&apos;&#13;&#10;THEN ZN(SUM([rcmd_ord_qty]))&#13;&#10;ELSEIF[P_KPI_Type(DC)]=&apos;실발주&apos; and [P_Qty/Amt]=&apos;수량&apos;&#13;&#10;THEN ZN(SUM([ord_cret_qty]))&#13;&#10;ELSEIF [P_KPI_Type(DC)]=&apos;실입고&apos; and [P_Qty/Amt]=&apos;수량&apos;&#13;&#10;THEN ZN(SUM([dc_rciv_qty]))&#13;&#10;END&#13;&#10;*/' />
