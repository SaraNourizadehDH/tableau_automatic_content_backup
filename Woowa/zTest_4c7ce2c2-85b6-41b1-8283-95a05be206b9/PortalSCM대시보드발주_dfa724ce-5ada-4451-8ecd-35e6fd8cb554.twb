            <column caption='F_Category_Lv2(Top10_bar)' datatype='string' name='[Calculation_1015843191030464514]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 6 1]=[cat2_nm]&#13;&#10;THEN [cat2_nm]&#13;&#10;ELSEIF [Parameters].[매개 변수 6 1]=&apos;전체&apos;&#13;&#10;THEN [cat2_nm]&#13;&#10;END' />
