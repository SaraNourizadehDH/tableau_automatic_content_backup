              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[P_End_Date(복사본)_827255009348214784], [Parameters].[매개 변수 2]) &lt;= 30&#13;&#10;    THEN &apos;종료일 :&apos;&#13;&#10;    ELSE &apos;종료일 :&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;기준일 :&apos;&#13;&#10;END' />
