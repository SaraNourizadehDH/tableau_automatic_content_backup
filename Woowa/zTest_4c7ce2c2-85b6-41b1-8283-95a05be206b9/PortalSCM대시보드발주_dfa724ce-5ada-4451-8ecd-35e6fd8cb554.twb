              <calculation class='tableau' formula='CASE [sido_nm]&#13;&#10;WHEN &apos;서울특별시&apos; THEN &apos;서울&apos;&#13;&#10;WHEN &apos;인천광역시&apos; THEN &apos;인천&apos;&#13;&#10;WHEN &apos;대전광역시&apos; THEN &apos;대전&apos;&#13;&#10;WHEN &apos;울산광역시&apos; THEN &apos;울산&apos;&#13;&#10;WHEN &apos;대구광역시&apos; THEN &apos;대구&apos;&#13;&#10;WHEN &apos;부산광역시&apos; THEN &apos;부산&apos;&#13;&#10;WHEN &apos;광주광역시&apos; THEN &apos;광주&apos;&#13;&#10;WHEN &apos;경기도&apos; THEN &apos;경기&apos;&#13;&#10;WHEN &apos;강원도&apos; THEN &apos;강원&apos;&#13;&#10;WHEN &apos;충청남도&apos; THEN &apos;충남&apos;&#13;&#10;WHEN &apos;충청북도&apos; THEN &apos;충북&apos;&#13;&#10;WHEN &apos;경상남도&apos; THEN &apos;경남&apos;&#13;&#10;WHEN &apos;경상북도&apos; THEN &apos;경북&apos;&#13;&#10;WHEN &apos;전라남도&apos; THEN &apos;전남&apos;&#13;&#10;WHEN &apos;전라북도&apos; THEN &apos;전북&apos;&#13;&#10;WHEN &apos;제주특별자치도&apos; THEN &apos;제주&apos;&#13;&#10;WHEN &apos;세종특별자치시&apos; THEN &apos;세종&apos;&#13;&#10;WHEN NULL then IF [cntr_cd] = &apos;GP001&apos; THEN &apos;인천&apos; END&#13;&#10;END' />
            </column>
            <column caption='C_구군' datatype='string' name='[Calculation_1487876783373987848]' role='dimension' semantic-role='[County].[Name]' type='nominal'>
              <calculation class='tableau' formula='IF [cntr_cd] = &apos;GP001&apos; THEN &apos;남동구&apos; &#13;&#10;ELSE [gugun_nm]&#13;&#10;END' />
            </column>
            <column caption='C_date' datatype='date' datatype-customized='true' name='[Calculation_153966862635016193]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEPARSE(&apos;yyyy-MM-dd&apos;, [part_dt]))' />
            </column>
            <column caption='C_day' datatype='string' default-format='*mm/dd' name='[Calculation_17170034617045060]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[month]+ &apos;/&apos; + [day]' />
            </column>
            <column caption='C_month' datatype='string' name='[Calculation_17170034617389126]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;`&apos; + right([year],2)+ &apos;.&apos;+ [month]' />
            </column>
            <column caption='C_week' datatype='string' name='[Calculation_17170034617450567]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[week_seq]+&apos;W&apos;' />
            </column>
            <column caption='입고율' datatype='real' name='[Calculation_17170034652053590]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([rciv_qty])/SUM([rciv_fcst_qty])' />
            </column>
            <column caption='C_Date_Type' datatype='string' name='[Calculation_17170034653053016]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; THEN [Calculation_17170034617389126]&#13;&#10;WHEN &apos;주별&apos; THEN [Calculation_17170034617450567]&#13;&#10;WHEN &apos;일별&apos; THEN [Calculation_17170034617045060]&#13;&#10;END' />
            </column>
            <column caption='F_Date_Type(Null제거)' datatype='boolean' name='[Calculation_17170034653188185]' role='dimension' type='nominal'>
