              <calculation class='tableau' formula='str(ISOWEEK(DATEADD(&apos;week&apos;,-7,[Parameters].[매개 변수 2])))+&apos;W&apos;&#13;&#10;+&apos; &#13;&#10;&apos;+&#13;&#10;&apos;(&apos;&#13;&#10;+STR(MONTH(DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -7, [Parameters].[매개 변수 2]), &apos;Monday&apos;)))&#13;&#10;+ &apos;/&apos;&#13;&#10;+ STR(DAY(DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -7, [Parameters].[매개 변수 2]), &apos;Monday&apos;)))&#13;&#10;+ &apos;-&apos;&#13;&#10;+&apos;&#13;&#10;&apos;+ STR(MONTH(DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -6, [Parameters].[매개 변수 2]), &apos;Monday&apos;)-1))&#13;&#10;+ &apos;/&apos;&#13;&#10;+ STR(DAY(DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -6, [Parameters].[매개 변수 2]), &apos;Monday&apos;)-1))&#13;&#10;+&apos;)&apos;' />
