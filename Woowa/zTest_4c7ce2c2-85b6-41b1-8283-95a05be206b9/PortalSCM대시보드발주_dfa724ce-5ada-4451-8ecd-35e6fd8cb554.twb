              <calculation class='tableau' formula='if [Parameters].[매개 변수 4 1]=&apos;권고&apos; and [Parameters].[매개 변수 5 1]=&apos;금액&apos;&#13;&#10;then &apos;백만원&apos;&#13;&#10;ELSEIF [Parameters].[매개 변수 4 1]=&apos;권고&apos; and [Parameters].[매개 변수 5 1]=&apos;수량&apos;&#13;&#10;then  &apos;개&apos;&#13;&#10;ELSEIF [Parameters].[매개 변수 4 1]=&apos;실발주&apos; and [Parameters].[매개 변수 5 1]=&apos;금액&apos;&#13;&#10;then  &apos;백만원&apos;&#13;&#10;ELSEIF [Parameters].[매개 변수 4 1]=&apos;실발주&apos; and [Parameters].[매개 변수 5 1]=&apos;수량&apos;&#13;&#10;then  &apos;개&apos;&#13;&#10;ELSEIF [Parameters].[매개 변수 4 1]=&apos;실입고&apos; and [Parameters].[매개 변수 5 1]=&apos;금액&apos;&#13;&#10;then  &apos;백만원&apos;&#13;&#10;ELSEIF [Parameters].[매개 변수 4 1]=&apos;실입고&apos; and [Parameters].[매개 변수 5 1]=&apos;수량&apos;&#13;&#10;then  &apos;개&apos;&#13;&#10;ELSEIF [Parameters].[매개 변수 4 1]=&apos;권고대비 입고율&apos; &#13;&#10;then  &apos;%&apos;&#13;&#10;ELSEIF [Parameters].[매개 변수 4 1]=&apos;발주대비 입고율&apos; &#13;&#10;then  &apos;%&apos;&#13;&#10;end' />
