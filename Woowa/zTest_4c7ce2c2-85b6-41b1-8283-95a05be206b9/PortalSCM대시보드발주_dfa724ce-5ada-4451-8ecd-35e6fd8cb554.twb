            <column caption='C_시도_1' datatype='string' name='[Calculation_17170034659524711]' role='dimension' semantic-role='[State].[Name]' type='nominal'>
              <calculation class='tableau' formula='CASE [sido_nm]&#13;&#10;WHEN &apos;서울특별시&apos; THEN &apos;서울&apos;&#13;&#10;WHEN &apos;인천광역시&apos; THEN &apos;인천&apos;&#13;&#10;WHEN &apos;대전광역시&apos; THEN &apos;대전&apos;&#13;&#10;WHEN &apos;울산광역시&apos; THEN &apos;울산&apos;&#13;&#10;WHEN &apos;대구광역시&apos; THEN &apos;대구&apos;&#13;&#10;WHEN &apos;부산광역시&apos; THEN &apos;부산&apos;&#13;&#10;WHEN &apos;광주광역시&apos; THEN &apos;광주&apos;&#13;&#10;WHEN &apos;경기도&apos; THEN &apos;경기&apos;&#13;&#10;WHEN &apos;강원도&apos; THEN &apos;강원&apos;&#13;&#10;WHEN &apos;충청남도&apos; THEN &apos;충남&apos;&#13;&#10;WHEN &apos;충청북도&apos; THEN &apos;충북&apos;&#13;&#10;WHEN &apos;경상남도&apos; THEN &apos;경남&apos;&#13;&#10;WHEN &apos;경상북도&apos; THEN &apos;경북&apos;&#13;&#10;WHEN &apos;전라남도&apos; THEN &apos;전남&apos;&#13;&#10;WHEN &apos;전라북도&apos; THEN &apos;전북&apos;&#13;&#10;WHEN &apos;제주특별자치도&apos; THEN &apos;제주&apos;&#13;&#10;WHEN &apos;세종특별자치시&apos; THEN &apos;세종&apos;&#13;&#10;WHEN NULL then IF [cntr_cd] = &apos;GP001&apos; THEN &apos;인천&apos; &#13;&#10;               ELSEIF [cntr_cd] = &apos;DC003&apos; THEN &apos;경북&apos;&#13;&#10;               END&#13;&#10;END' />
            </column>
            <column caption='C_구군_1' datatype='string' name='[Calculation_17170034663522413]' role='dimension' semantic-role='[County].[Name]' type='nominal'>
              <calculation class='tableau' formula='IF [cntr_cd] = &apos;GP001&apos; THEN &apos;남동구&apos; &#13;&#10;ELSEIF [cntr_cd] = &apos;DC003&apos; THEN &apos;칠곡군&apos;&#13;&#10;ELSE [gugun_nm]&#13;&#10;END' />
              <semantic-values semantic-role='[County].[Name]'>
                <semantic-value key='&quot;강서구&quot;' value='&quot;강서구&quot;' />
              </semantic-values>
            </column>
            <column caption='FC_1' datatype='string' name='[Calculation_17170034665332846]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF RIGHT(cntr_nm,1) = &apos;점&apos;&#13;&#10;THEN LEFT([cntr_nm], LEN([cntr_nm])-1)&#13;&#10;ELSE [cntr_nm]&#13;&#10;END' />
            </column>
