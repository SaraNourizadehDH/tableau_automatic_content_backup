            <column caption='C_KPI_Type(%)' datatype='real' name='[C_KPI_Type(not%)(복사본)_17170034661486699]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[P_KPI_Type(복사본)_17170034660561001]=&apos;정확도&apos;&#13;&#10;THEN zn([Calculation_17170034652053590])&#13;&#10;END' />
