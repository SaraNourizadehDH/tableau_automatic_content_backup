            <datasource caption='매개 변수' name='Parameters' />
            <datasource caption='05_데이터거버넌스팀_SCM대시보드_발주_01 | 프로젝트 : [데이터] 물류' name='sqlproxy.0evmln50pulm3e1crzwg60xvtclu' />
          </datasources>
          <datasource-dependencies datasource='Clipboard_20230210T122530'>
            <column caption='C_날짜_일별_경고문구 (&gt;30)' datatype='string' name='[C_날짜적용범위 (&lt;=30)(복사본)_1292533150780383235]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[P_End_Date(복사본)_827255009348214784], [Parameters].[매개 변수 2]) &gt; 30&#13;&#10;    THEN &apos;※ 기간을 31일 이내로 입력하세요.&apos;&#13;&#10;    ELSEIF [Parameters].[P_End_Date(복사본)_827255009348214784] &gt; [Parameters].[매개 변수 2]&#13;&#10;    THEN &apos;※ 시작일이 종료일보다 큽니다.&apos;&#13;&#10;    ELSE &apos;&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='C_단위(FC)' datatype='string' name='[C_단위(복사본)_1540512608165490706]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[P_KPI_Type(복사본)_17170034660561001]&#13;&#10;WHEN &apos;예상 입고 수량&apos; THEN &apos;개&apos;&#13;&#10;WHEN &apos;실입고 수량&apos; THEN &apos;개&apos;&#13;&#10;WHEN &apos;정확도&apos; THEN &apos;%&apos;&#13;&#10;END' />
            </column>
            <column caption='C_종료일' datatype='string' name='[C_시작일(일별)(복사본)_771241503685345280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[P_End_Date(복사본)_827255009348214784], [Parameters].[매개 변수 2]) &lt;= 30&#13;&#10;    THEN &apos;종료일 :&apos;&#13;&#10;    ELSE &apos;종료일 :&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;기준일 :&apos;&#13;&#10;END' />
            </column>
            <column caption='C_시작일(일별)' datatype='string' name='[C_시작일(일별)_경고(복사본)_612208132136902675]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[P_End_Date(복사본)_827255009348214784], [Parameters].[매개 변수 2]) &lt;= 30&#13;&#10;    THEN &apos;시작일 :&apos;&#13;&#10;    ELSE &apos;&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='T/F_Date_Type' datatype='boolean' name='[Calculation_1123366682689613825]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = [Date Type]&#13;&#10;THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
            </column>
            <column caption='TRUE' datatype='boolean' name='[Calculation_1123366682691923976]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='TRUE' />
