      <column caption='C_W-6' datatype='string' name='[C_W-5(복사본)_827255009766666349]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;(&apos;&#13;&#10;+STR(MONTH(DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -6, [Parameters].[매개 변수 2]), &apos;Monday&apos;)))&#13;&#10;+ &apos;/&apos;&#13;&#10;+ STR(DAY(DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -6, [Parameters].[매개 변수 2]), &apos;Monday&apos;)))&#13;&#10;+ &apos;-&apos;&#13;&#10;+&apos;&#13;&#10;&apos;+ STR(MONTH(DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -5, [Parameters].[매개 변수 2]), &apos;Monday&apos;)-1))&#13;&#10;+ &apos;/&apos;&#13;&#10;+ STR(DAY(DATETRUNC(&apos;week&apos;, DATEADD(&apos;week&apos;, -5, [Parameters].[매개 변수 2]), &apos;Monday&apos;)-1))&#13;&#10;+&apos;)&apos;' />
