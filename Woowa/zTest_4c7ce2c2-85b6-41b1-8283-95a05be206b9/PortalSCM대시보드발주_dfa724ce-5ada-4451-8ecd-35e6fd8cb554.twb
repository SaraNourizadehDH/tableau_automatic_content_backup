              <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[P_End_Date(복사본)_827255009348214784], [Parameters].[매개 변수 2]) &lt;= 30&#13;&#10;    THEN &apos;시작일&apos;&#13;&#10;    ELSE &apos;&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
            </column>
            <column caption='C_KPI_Type(FC)' datatype='real' name='[Calculation_105271703890702394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[P_KPI_Type(복사본)_17170034660561001]&#13;&#10;WHEN &apos;예상 입고 수량&apos; THEN SUM([rciv_fcst_qty]) &#13;&#10;WHEN &apos;실입고 수량&apos; THEN SUM([rciv_qty])&#13;&#10;WHEN &apos;정확도&apos; THEN sum(rciv_qty) / sum(rciv_fcst_qty)&#13;&#10;END' />
            </column>
            <column caption='FC' datatype='string' name='[Calculation_1292533150771916800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF RIGHT(cntr_nm,1) = &apos;점&apos;&#13;&#10;THEN LEFT([cntr_nm], LEN([cntr_nm])-1)&#13;&#10;ELSE [cntr_nm]&#13;&#10;END' />
