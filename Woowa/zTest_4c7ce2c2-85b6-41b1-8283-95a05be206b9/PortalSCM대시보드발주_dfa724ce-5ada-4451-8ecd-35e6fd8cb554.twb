              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; THEN STR([Calculation_17170034617389126]) + &apos;월&apos;&#13;&#10;WHEN &apos;주별&apos; THEN STR([Calculation_17170034617450567]) + &apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN IF [weekday_nm] IN (&apos;토&apos;,&apos;일&apos;) THEN STR([Calculation_17170034617045060]) + char(10)&#13;&#10;                                                  + IF [holiday_yn]=&apos;1&apos; THEN &apos;(&apos;+[weekday_nm]+&apos;)&apos; + char(10) + [Calculation_1478869595296309261]&#13;&#10;                                                      ELSE &apos;(&apos;+[weekday_nm]+&apos;)&apos; + char(10)&#13;&#10;                                                      END + char(10)&#13;&#10;                ELSE STR([Calculation_17170034617045060]) + char(10) +&#13;&#10;                     IF [holiday_yn]=&apos;1&apos; THEN &apos;(&apos;+[weekday_nm]+&apos;)&apos; + char(10) + [Calculation_1478869595296309261]&#13;&#10;                                                      ELSE char(10)&#13;&#10;                                                      END + char(10)&#13;&#10;&#13;&#10;END &#13;&#10;END&#13;&#10;/*&#13;&#10;IF [P_Date_Type]=&apos;월별&apos;&#13;&#10;THEN STR([C_month]) + &apos;월&apos;&#13;&#10;ELSEIF [P_Date_Type]=&apos;주별&apos;&#13;&#10;THEN STR([C_week]) + &apos;W&apos;&#13;&#10;ELSEIF [P_Date_Type]=&apos;일별&apos; AND DATEDIFF(&apos;day&apos;,[P_Start_Date],[P_End_Date])&lt;=30&#13;&#10;THEN STR([C_month]) + &apos;/&apos; + STR([C_day])&#13;&#10;END&#13;&#10;*/' />
