        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[P_End_Date(복사본)_827255009348214784], [Parameters].[매개 변수 2]) &lt;= 30&#13;&#10;    THEN &apos;현재 적용 기간 : &apos;+ STR([Parameters].[P_End_Date(복사본)_827255009348214784]) +&apos; ~ &apos; + STR([Parameters].[매개 변수 2])&#13;&#10;    ELSE &apos;&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='C_날짜_일별_경고문구 (&gt;30)' datatype='string' name='[C_날짜적용범위 (&lt;=30)(복사본)_1292533150780383235]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[P_End_Date(복사본)_827255009348214784], [Parameters].[매개 변수 2]) &gt; 30&#13;&#10;    THEN &apos;날짜 범위를 31일 이내로 입력하세요&apos;&#13;&#10;    ELSEIF [Parameters].[P_End_Date(복사본)_827255009348214784] &gt; [Parameters].[매개 변수 2]&#13;&#10;    THEN &apos;시작일이 종료일보다 큽니다.&apos;&#13;&#10;    ELSE &apos;&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='C_시작일(월별,주별)' datatype='string' name='[C_시작일(일별)(복사본)_612208132131541009]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] IN (&apos;월별&apos;,&apos;주별&apos;) THEN &apos;시작일&apos; ELSE &apos;&apos; END' />
      </column>
      <column caption='C_시작일(일별)' datatype='string' name='[C_시작일(일별)_경고(복사본)_612208132136902675]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[P_End_Date(복사본)_827255009348214784], [Parameters].[매개 변수 2]) &lt;= 30&#13;&#10;    THEN &apos;시작일&apos;&#13;&#10;    ELSE &apos;&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='C_전주비(정확도)' datatype='real' name='[C_전주비(복사본)_1015843191184101395]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([W-1(복사본)_1530942451180216376]-[W-2(복사본)_1530942451180175415])' />
      </column>
      <column caption='C_4주평균' datatype='real' name='[C_전주비(복사본)_1530942451234775184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([W-2(복사본)_1530942451180175415]) + ZN([W-3(복사본)_1530942451180113974]) + ZN([W-4(복사본)_1530942451179986997]) + ZN([W-5(복사본)_1530942451179872308])) / 4' />
      </column>
      <column caption='F_4주평균필터' datatype='boolean' name='[Calculation_1015843191184850967]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATEPART(&apos;week&apos;, [Parameters].[매개 변수 2], &apos;Monday&apos;)-2 &gt;= INT([Calculation_17170034617450567]) AND &#13;&#10;INT([Calculation_17170034617450567])  &gt;=(DATEPART(&apos;week&apos;, [Parameters].[매개 변수 2], &apos;Monday&apos;)-5)' />
      </column>
      <column caption='C_KPI_Type(FC)' datatype='real' name='[Calculation_105271703890702394]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[P_KPI_Type(복사본)_17170034660561001]&#13;&#10;WHEN &apos;예상 입고 수량&apos; THEN SUM([rciv_fcst_qty]) &#13;&#10;WHEN &apos;실입고 수량&apos; THEN SUM([rciv_qty])&#13;&#10;WHEN &apos;정확도&apos; THEN sum(rciv_qty) / sum(rciv_fcst_qty)&#13;&#10;END' />
      </column>
      <column caption='F_KPI(FC)정확도' datatype='boolean' name='[Calculation_105271703899816009]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[P_KPI_Type(복사본)_17170034660561001]=&apos;정확도&apos;' />
      </column>
      <column caption='FC' datatype='string' name='[Calculation_1292533150771916800]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF RIGHT(cntr_nm,1) = &apos;점&apos;&#13;&#10;THEN LEFT([cntr_nm], LEN([cntr_nm])-1)&#13;&#10;ELSE [cntr_nm]&#13;&#10;END' />
      </column>
      <column caption='C_날짜_일별_적용범위 (&gt;30)' datatype='string' hidden='true' name='[Calculation_1292533150779940866]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;일별&apos;&#13;&#10;THEN&#13;&#10;    IF DATEDIFF(&apos;day&apos;, [Parameters].[P_End_Date(복사본)_827255009348214784], [Parameters].[매개 변수 2]) &gt; 30&#13;&#10;    THEN &apos;현재 적용 기간 : &apos;+ STR(DATEADD(&apos;day&apos;, -30, [Parameters].[매개 변수 2])) +&apos; ~ &apos; + STR([Parameters].[매개 변수 2])&#13;&#10;    ELSE &apos;&apos;&#13;&#10;    END&#13;&#10;ELSE &apos;&apos;&#13;&#10;END' />
      </column>
      <column caption='C_날짜범위경고' datatype='boolean' hidden='true' name='[Calculation_1292533150781136900]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[매개 변수 1] = &apos;일별&apos; AND DATEDIFF(&apos;day&apos;, [Parameters].[P_End_Date(복사본)_827255009348214784], [Parameters].[매개 변수 2]) &gt; 30&#13;&#10;OR &#13;&#10;[Parameters].[매개 변수 1] = &apos;일별&apos; AND [Parameters].[P_End_Date(복사본)_827255009348214784]&gt;[Parameters].[매개 변수 2]' />
      </column>
      <column caption='F_Map_Lv1' datatype='boolean' name='[Calculation_1437211293817020421]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[매개 변수 9]=&apos;1&apos;' />
      </column>
      <column caption='C_holiday_desc(ch3)' datatype='string' name='[Calculation_1478869595296309261]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [holiday_yn] = &apos;1&apos; THEN&#13;&#10;    LEFT([holiday_desc],2)&#13;&#10;ELSE&#13;&#10;    &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='F_Date_Type' datatype='boolean' name='[Calculation_1478869595374043164]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; THEN DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,-11,[Parameters].[매개 변수 2])) &lt;= [Calculation_153966862635016193] and [Calculation_153966862635016193] &lt; DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Parameters].[매개 변수 2]))&#13;&#10;WHEN &apos;주별&apos; THEN DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,-7,[Parameters].[매개 변수 2])) &lt;= [Calculation_153966862635016193] and [Calculation_153966862635016193] &lt; DATETRUNC(&apos;iso-week&apos;,DATEADD(&apos;week&apos;,1,[Parameters].[매개 변수 2]))&#13;&#10;WHEN &apos;일별&apos; THEN [Parameters].[P_End_Date(복사본)_827255009348214784]&lt;=[Calculation_153966862635016193] and [Calculation_153966862635016193] &lt;= [Parameters].[매개 변수 2] AND (DATEADD(&apos;day&apos;, -30, [Parameters].[매개 변수 2]) &lt;= [Calculation_153966862635016193])&#13;&#10;END' />
      </column>
      <column caption='C_시도' datatype='string' name='[Calculation_1487876783373905927]' role='dimension' semantic-role='[State].[Name]' type='nominal'>
        <calculation class='tableau' formula='CASE [sido_nm]&#13;&#10;WHEN &apos;서울특별시&apos; THEN &apos;서울&apos;&#13;&#10;WHEN &apos;인천광역시&apos; THEN &apos;인천&apos;&#13;&#10;WHEN &apos;대전광역시&apos; THEN &apos;대전&apos;&#13;&#10;WHEN &apos;울산광역시&apos; THEN &apos;울산&apos;&#13;&#10;WHEN &apos;대구광역시&apos; THEN &apos;대구&apos;&#13;&#10;WHEN &apos;부산광역시&apos; THEN &apos;부산&apos;&#13;&#10;WHEN &apos;광주광역시&apos; THEN &apos;광주&apos;&#13;&#10;WHEN &apos;경기도&apos; THEN &apos;경기&apos;&#13;&#10;WHEN &apos;강원도&apos; THEN &apos;강원&apos;&#13;&#10;WHEN &apos;충청남도&apos; THEN &apos;충남&apos;&#13;&#10;WHEN &apos;충청북도&apos; THEN &apos;충북&apos;&#13;&#10;WHEN &apos;경상남도&apos; THEN &apos;경남&apos;&#13;&#10;WHEN &apos;경상북도&apos; THEN &apos;경북&apos;&#13;&#10;WHEN &apos;전라남도&apos; THEN &apos;전남&apos;&#13;&#10;WHEN &apos;전라북도&apos; THEN &apos;전북&apos;&#13;&#10;WHEN &apos;제주특별자치도&apos; THEN &apos;제주&apos;&#13;&#10;WHEN &apos;세종특별자치시&apos; THEN &apos;세종&apos;&#13;&#10;WHEN NULL then IF [cntr_cd] = &apos;GP001&apos; THEN &apos;인천&apos; END&#13;&#10;END' />
      </column>
      <column caption='C_구군' datatype='string' name='[Calculation_1487876783373987848]' role='dimension' semantic-role='[County].[Name]' type='nominal'>
        <calculation class='tableau' formula='IF [cntr_cd] = &apos;GP001&apos; THEN &apos;남동구&apos; &#13;&#10;ELSE [gugun_nm]&#13;&#10;END' />
