              <calculation class='tableau' formula='IF [holiday_yn] = &apos;1&apos; THEN&#13;&#10;    LEFT([holiday_desc],2)&#13;&#10;ELSE&#13;&#10;    &quot;&quot;&#13;&#10;END' />
