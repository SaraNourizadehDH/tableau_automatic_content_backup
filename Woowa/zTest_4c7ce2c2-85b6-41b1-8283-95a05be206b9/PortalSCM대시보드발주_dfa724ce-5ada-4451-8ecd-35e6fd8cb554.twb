      <column caption='F_select_Date_Type_Label' datatype='boolean' name='[Calculation_1527846228141162534]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[매개 변수 6] = [Calculation_17170034653053016]' />
      </column>
      <column caption='Reset_select_Date_Type_Label' datatype='string' name='[Calculation_1527846228430143530]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;WHEN &apos;월별&apos; THEN &apos;`&apos; + right(STR(YEAR([Parameters].[매개 변수 2])),2)+ &apos;.&apos;+ MID(str([Parameters].[매개 변수 2]),6,2)&#13;&#10;WHEN &apos;주별&apos; THEN STR(ISOWEEK([Parameters].[매개 변수 2])) + &apos;W&apos;&#13;&#10;WHEN &apos;일별&apos; THEN REPLACE(MID(str([Parameters].[매개 변수 2]),6,5),&apos;-&apos;,&apos;/&apos;)&#13;&#10;END' />
      </column>
      <column caption='C_W-8' datatype='real' name='[Calculation_1530942451161866254]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[P_KPI_Type(복사본)_17170034660561001]&#13;&#10;WHEN &apos;예상 입고 수량&apos; THEN SUM(IF INT([week_seq]) = [F_W-7(복사본)_150870589686046739] THEN [rciv_fcst_qty] END)&#13;&#10;WHEN &apos;실입고 수량&apos; THEN SUM(IF INT([week_seq]) = [F_W-7(복사본)_150870589686046739] THEN [rciv_qty] END)&#13;&#10;WHEN &apos;정확도&apos; THEN if sum(IF INT([week_seq]) = [F_W-7(복사본)_150870589686046739] THEN [rciv_fcst_qty] END) = 0&#13;&#10;                  then 0&#13;&#10;                  else sum(IF INT([week_seq]) = [F_W-7(복사본)_150870589686046739] THEN [rciv_qty] END)&#13;&#10;                       / sum(IF INT([week_seq])= [F_W-7(복사본)_150870589686046739] THEN [rciv_fcst_qty] END)&#13;&#10;                  end&#13;&#10;END' />
      </column>
