      <column caption='F_조회기간' datatype='boolean' name='[Calculation_4181310797027196929]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &quot;월별&quot;&#13;&#10;THEN DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -12, [Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;month&apos;, [base_dt])&#13;&#10;AND DATETRUNC(&apos;month&apos;, [base_dt]) &lt;= DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &quot;주별&quot;&#13;&#10;THEN DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;week&apos;, -11, [Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;iso-week&apos;, [base_dt])&#13;&#10;AND DATETRUNC(&apos;iso-week&apos;, [base_dt]) &lt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;WHEN &quot;일별&quot;&#13;&#10;THEN DATETRUNC(&apos;day&apos;, DATEADD(&apos;day&apos;, -13, [Parameters].[매개 변수 2])) &lt;= DATETRUNC(&apos;day&apos;, [base_dt])&#13;&#10;AND DATETRUNC(&apos;day&apos;, [base_dt]) &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;END' />
      </column>
