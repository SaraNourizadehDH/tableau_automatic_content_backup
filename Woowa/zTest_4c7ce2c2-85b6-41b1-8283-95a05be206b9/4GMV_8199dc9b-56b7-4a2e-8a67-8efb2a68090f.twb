            <column caption='rename_svc_nm' datatype='string' name='[Calculation_4495718347095076865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [svc_nm]=&apos;배민&apos; THEN &apos;가게배달&apos;&#13;&#10;ELSEIF [svc_nm]=&apos;배민1&apos; THEN &apos;배민배달&apos;&#13;&#10;ELSEIF [svc_nm]=&apos;포장&apos; THEN &apos;포장방문&apos;&#13;&#10;ELSEIF [svc_nm]=&apos;전사&apos; THEN &apos;전 서비스&apos;&#13;&#10;ELSE [svc_nm]&#13;&#10;END' />
            </column>
            <column caption='rename_svc_type' datatype='string' name='[Calculation_4495718347095269378]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [svc_type]=&apos;전사&apos;&#13;&#10;THEN &apos;전 서비스&apos;&#13;&#10;ELSE [svc_type]&#13;&#10;END' />
            </column>
            <column caption='F_당기_조회기간' datatype='boolean' name='[Calculation_4495718347096858627]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR([Parameters].[매개 변수 2])&#13;&#10;    AND MONTH([base_dt]) = MONTH([Parameters].[매개 변수 2])&#13;&#10;    AND DAY([base_dt]) &lt;= DAY([Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] &gt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])&#13;&#10;    AND [base_dt] &lt;= DATETRUNC(&apos;day&apos;, [Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = [Parameters].[매개 변수 2]&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='F_전년동기_조회기간' datatype='boolean' name='[Calculation_4495718347096903684]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR(DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND MONTH([base_dt]) = MONTH(DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND DAY([base_dt]) &lt;= DAY([Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;year&apos;, -1, DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])))&#13;&#10;    AND [base_dt] &lt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = DATETRUNC(&apos;day&apos;, DATEADD(&apos;year&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='F_전동기_조회기간' datatype='boolean' name='[Calculation_4495718347096940549]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 1]&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN YEAR([base_dt]) = YEAR(DATEADD(&apos;month&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND MONTH([base_dt]) = MONTH(DATEADD(&apos;month&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;    AND DAY([base_dt]) &lt;= DAY([Parameters].[매개 변수 2])&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN [base_dt] &gt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;iso-week&apos;, -1, DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])))&#13;&#10;    AND [base_dt] &lt;= DATETRUNC(&apos;day&apos;, DATEADD(&apos;iso-week&apos;,-1, [Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;&#13;&#10;WHEN &apos;일별&apos;&#13;&#10;THEN [base_dt] = DATETRUNC(&apos;day&apos;, DATEADD(&apos;day&apos;, -1, [Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
