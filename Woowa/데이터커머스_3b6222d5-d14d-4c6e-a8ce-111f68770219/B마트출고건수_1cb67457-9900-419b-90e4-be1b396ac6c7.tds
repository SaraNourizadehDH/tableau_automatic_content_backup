  <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
  <semantic-values>
    <semantic-value key='[Country].[Name]' value='&quot;대한민국&quot;' />
  </semantic-values>
  <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    <objects>
      <object caption='사용자 지정 SQL 쿼리' id='_EDAE21DB6ABD41A2B7E38987DD9ABC1C'>
        <properties context=''>
          <relation connection='athena.068v5px1kcgnpo1giiedp171mpep' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[WITH 

-- 노출 센터수 
display_center_count AS (
SELECT
    count(distinct snapshot.center_code) as "center_count",
    snapshot.product_line_item_id as "item_id",
    snapshot.display_date - interval '1' day as "display_date"
FROM
 market.pt_product_display_snapshot snapshot
 WHERE snapshot.display_date = NOW() - INTERVAL '179' DAY
    AND snapshot.display_date = NOW()
      AND display = 1
GROUP BY snapshot.product_line_item_id, snapshot.display_date
),

-- 아이템별 평균 판매금액 
avg_sale_price AS (
SELECT
    bi.item_id as item_id, 
    DATE(bos.ordered_date_time + interval '9' hour) AS ordered_date,
    SUM(bi.unit_price * quantity) / SUM(quantity) as avg_sale_price
FROM market.bm_ordered_item bi
INNER JOIN market.bm_order_summary bos ON bos.order_id = bi.order_id 
AND bos.status NOT IN ('ORDERED', 'ORDERED_EXPIRATION', 'CANCELLED')
WHERE cast(bos.ordered_date_time + interval '9' hour as date) >>= date(now() - interval '180' day)
AND cast(bos.ordered_date_time + interval '9' hour as date) <<= date(now() - interval '1' day)
GROUP BY bi.item_id, DATE(bos.ordered_date_time + interval '9' hour) 
), 

-- 판매 정보 
sale_info AS (
 SELECT 
    ois.item_id AS item_id,
    CAST(ois.part_date AS DATE) AS part_date,
    SUM(ois.quantity) AS sale_count,
    SUM(ois.quantity_price) AS sales_price 
 FROM market.bm_ordered_item_summary ois 
 JOIN market.bm_order_summary os ON ois.order_summary_id = os.order_summary_id
 WHERE ois.part_date >>=  DATE_FORMAT(NOW() - INTERVAL '180' DAY, '%Y-%m-%d')
   AND ois.part_date <<= DATE_FORMAT(NOW() - INTERVAL '1' DAY, '%Y-%m-%d')
   AND os.status = 'COMPLETED'
 GROUP BY ois.item_id, ois.part_date
),



-- 카테고리 정보 (파트) 
categories AS (
    SELECT * FROM (
        VALUES
            ('4',	'신선파트','채소'),
            ('9',	'신선파트','쌀/잡곡/견과'),
            ('12',  '신선파트','우유/유제품'),
            ('13',  '신선파트','정육/수산/계란'),
            ('862', '신선파트','과일'),
            ('3',	'가공파트','건강/다이어트'),
            ('6',	'가공파트','라면/면/즉석밥'),
            ('7',	'가공파트','빵/떡/잼'),
            ('8',	'가공파트','생수/음료/커피/차'),
            ('11',  '가공파트','요리/안주/반찬'),
            ('14',  '가공파트','조미료/소스/통조림'),
            ('764', '가공파트','과자/사탕/초콜릿'),
            ('803', '가공파트','시리얼'),
            ('10',  '가공파트','아이스크림/얼음'),
            ('15',  '생활파트','남성뷰티'),
            ('17',  '생활파트','반려동물'),
            ('19',  '생활파트','뷰티/클렌징/선케어'),
            ('20',  '생활파트','생활잡화/의료/전기용품'),
            ('21',  '생활파트','세제/섬유유연제'),
            ('22',  '생활파트','유아/아동'),
            ('23',  '생활파트','주방/일회용품'),
            ('24',  '생활파트','청소/욕실/세탁용품'),
            ('25',  '생활파트','헤어/바디/세안/구강'),
            ('26',  '생활파트','화장지/생리대'),
            ('1014','생활파트','방향/탈취/살충/제습'), 
            ('1056','생활파트','문구/완구/취미용품'),
            ('1069','생활파트','차량/스포츠/레저용품'),
            ('1086','생활파트','홈인테리어')
    ) AS categories (category_id, part_name, category_name)
)

SELECT 
    ordered_date AS "날짜",
    item_id AS "아이템번호",
    sku_code AS "SKU ID",
    sku_name AS "SKU명",
    depth1 AS "1depth",
    depth2 AS "2depth",
    depth3 AS "3depth",
    depth4 AS "4depth",
    sale_count AS "판매수량"
FROM (
    SELECT 
        sp.ordered_date AS ordered_date,
        sku.id AS sku_id,
        sku.code AS sku_code, 
        sku.name AS sku_name,
        sku.market_item_id AS item_id,

        COALESCE(si.sale_count, 0) AS sale_count,

        COALESCE(cat1.name, '') AS depth1,
        COALESCE(cat2.name, '') AS depth2,
        COALESCE(cat3.name, '') AS depth3,
        COALESCE(cat4.name, '') AS depth4

    FROM marketwms.sku sku
    LEFT OUTER JOIN avg_sale_price sp ON sp.item_id = sku.market_item_id
    LEFT OUTER JOIN sale_info si ON si.item_id = sku.market_item_id AND si.part_date = sp.ordered_date
    LEFT OUTER JOIN display_center_count dcc ON dcc.item_id = sku.market_item_id
    LEFT OUTER JOIN market.pt_product_line_item item ON item.product_line_item_id = sku.market_item_id 
    LEFT OUTER JOIN marketwms.new_category cat4 ON cat4.id = sku.category_id
    LEFT OUTER JOIN marketwms.new_category cat3 ON cat3.id = cat4.parent_id
    LEFT OUTER JOIN marketwms.new_category cat2 ON cat2.id = cat3.parent_id
    LEFT OUTER JOIN marketwms.new_category cat1 ON cat1.id = cat2.parent_id
    LEFT OUTER JOIN categories cat ON cat.category_id = cat2.id  
    -- INNER JOIN bmmart.vendor supplier ON sku.supplier_id = supplier.id
)
WHERE 1=1
AND ordered_date IS NOT NULL
ORDER BY ordered_date desc]]></relation>
        </properties>
        <properties context='extract'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </properties>
      </object>
    </objects>
  </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
</datasource>
