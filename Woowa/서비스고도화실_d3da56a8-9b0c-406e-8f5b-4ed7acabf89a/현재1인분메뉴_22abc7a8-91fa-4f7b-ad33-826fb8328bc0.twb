             , CASE WHEN shop_category LIKE '%BAEMIN_1%' THEN SUBSTR(shop_category, 10, 20)
                    WHEN shop_category LIKE '%RIDERS%' THEN SUBSTR(shop_category, 8, 20)
                    ELSE shop_category END AS cate
             , (menu_price_min + menu_price_max) / 2 AS menu_price
        from dsdw.menu_master_daily mmd
        where 1=1
          and mmd.part_date = (select end_date from dt)
          and mmd.is_menu_displayed = 1
          and mmd.is_menu_deleted = 0
        --and mmd.is_solo = 1 -- MFO
    )
select case when sasoi.shop_ad_div_nm like 'mp%' then 'MP'
            when sasoi.shop_ad_div_nm like 'od%' then
                case when shop_od_div_nm = 'nstod' then '한집배달'
                     when shop_od_div_nm = 'stod' then '알뜰배달'
                     when shop_od_div_nm = 'nstod+stod' then '한집+알뜰'
                     when shop_od_div_nm = 'plus' then '플러스'
                    end end as "광고 구분"
    , menu.*
from cl_food.shop_ad_shop_owner_info sasoi
    left join menu on menu.part_date = sasoi.part_date and menu.shop_no = sasoi.shop_no
where 1=1
  and sasoi.part_date = (select end_date from dt)
  and sasoi.shop_ad_div_nm <<>> 'cpc' and sasoi.shop_ad_div_nm <<>> 'to'
and menu.is_solo = 1]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
