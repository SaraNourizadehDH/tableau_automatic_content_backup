      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='사용자 지정 SQL 쿼리' id='_C5605EABECD54517B10AF6A2F8A19441'>
            <properties context=''>
              <relation connection='presto.0pger8519ghds91bmuzi300a88r1' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[with
    dt as
        (
            select '2024-11-01' as start_date, '2024-11-30' as end_date
                 , timestamp '2024-11-01 00:00:00' as start_ts, timestamp '2024-11-30 00:00:00' as end_ts
        )
   , ad_theme as
    (
        select part_date, shop_no, max(is_theme) as is_theme
        from sbadcenter_hist.ad_campaign_master as ad
        where 1 = 1
          and ad.part_date = (select end_date from dt)
          and ad.is_ongoing = 1
          and ad.is_ad_active = 1
          and ad.is_ad_paused = 0
          and ad.ad_inventory_id in ('1','3','4','10','12','14', '6', '11', '15')       -- 광고 종류 필터
          and ad.is_ad_deleted = 0
          and ad.is_test = 0
          and ad.is_theme = 1
        group by 1,2
    )
   , menu as
    (
        select *
             , CASE
                   WHEN menu_name_clean LIKE '%도시락%' THEN '도시락'
                   WHEN REGEXP_LIKE(menu_name_clean, '국|국밥|탕|육개장|닭개장|닭계장|육계장|순두부|수제비') THEN '국밥/국/탕류'
                   WHEN menu_name_clean LIKE '%리조또%' THEN '리조또'
                   WHEN menu_name_clean LIKE '%필라프%' THEN '필라프'
                   WHEN menu_name_clean LIKE '%볶음밥%' THEN '볶음밥'
                   WHEN REGEXP_LIKE(menu_name_clean, '샐러드|셀러드|포케|포캐|부리또') THEN '샐러드'
                   WHEN REGEXP_LIKE(menu_name_clean, '돈까스|돈카츠|카츠|까스|가스|까츠') THEN '카츠류'
                   WHEN REGEXP_LIKE(menu_name_clean, '파스타|알리오올리오|봉골레|스파게티|까르보나라') THEN '파스타'
                   WHEN REGEXP_LIKE(menu_name_clean, '우동|소바|라면|라멘|냉면|쌀국수|쫄면|비빔면|물냉|비냉|밀면') THEN '면류(중식x)'
                   WHEN REGEXP_LIKE(menu_name_clean, '짬뽕|짜장|자장|짬짜|탕짜|탕볶|탕짬|짬탕') THEN '면류(중식)'
                   WHEN menu_name_clean LIKE '%만두%' THEN '만두'
                   WHEN REGEXP_LIKE(menu_name_clean, '커리|카레') THEN '커리'
                   WHEN REGEXP_LIKE(menu_name_clean, '찌개|찌게') THEN '찌개'
                   WHEN REGEXP_LIKE(menu_name_clean, '찜') THEN '찜'
                   WHEN REGEXP_LIKE(menu_name_clean, '덮밥|비빔밥|가츠동|규동|사케동|짜글|오므라이스|부타동|오믈렛') THEN '덮밥/비빔밥'
                   WHEN REGEXP_LIKE(menu_name_clean, '떡볶이') THEN '떡볶이'
                   WHEN REGEXP_LIKE(menu_name_clean, '김밥') THEN '김밥'
                   WHEN REGEXP_LIKE(menu_name_clean, '백반|제육|불고기|죽|불백|쌈밥|두루치기|뚝배기') THEN '백반/죽'
                   WHEN REGEXP_LIKE(menu_name_clean, '초밥|스시') THEN '초밥'
                   WHEN REGEXP_LIKE(menu_name_clean, '솥밥') THEN '솥밥'
                   WHEN REGEXP_LIKE(menu_name_clean, '버거') THEN '버거'
                   WHEN REGEXP_LIKE(menu_name_clean, '고등어구이|삼치구이|갈치구이') THEN '생선구이'
                   ELSE 'TT' END AS menu_cate
             , CASE WHEN shop_category LIKE '%BAEMIN_1%' THEN SUBSTR(shop_category, 10, 20)
                    WHEN shop_category LIKE '%RIDERS%' THEN SUBSTR(shop_category, 8, 20)
                    ELSE shop_category END AS cate
             , (menu_price_min + menu_price_max) / 2 AS menu_price
        from dsdw.menu_master_daily mmd
        where 1=1
          and mmd.part_date = (select end_date from dt)
          and mmd.is_menu_displayed = 1
          and mmd.is_menu_deleted = 0
        --and mmd.is_solo = 1 -- MFO
    )
select case when sasoi.shop_ad_div_nm like 'mp%' then 'MP'
            when sasoi.shop_ad_div_nm like 'od%' then
                case when shop_od_div_nm = 'nstod' then '한집배달'
                     when shop_od_div_nm = 'stod' then '알뜰배달'
                     when shop_od_div_nm = 'nstod+stod' then '한집+알뜰'
                     when shop_od_div_nm = 'plus' then '플러스'
                    end end as "광고 구분"
    , menu.*
from cl_food.shop_ad_shop_owner_info sasoi
    left join menu on menu.part_date = sasoi.part_date and menu.shop_no = sasoi.shop_no
where 1=1
  and sasoi.part_date = (select end_date from dt)
  and sasoi.shop_ad_div_nm <<>> 'cpc' and sasoi.shop_ad_div_nm <<>> 'to'
and menu.is_solo = 1]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
