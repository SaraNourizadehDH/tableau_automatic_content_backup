        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='presto.1j8omrc1a885f1118x8az1lvozxc' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[WITH
dt AS
(
    SELECT '2025-07-14' AS start_date, '2025-07-28' AS end_date
)
, merge_result AS
(
    SELECT DISTINCT
        primary_shop_no
        , merged_shop_no
        , DATE_FORMAT(registered, '%Y-%m-%d') AS merged_date
    FROM sbstore.shop_mapping
    WHERE
        1=1
        AND registered <<= DATE((SELECT end_date FROM dt))
        AND registered >>= DATE((SELECT start_date FROM dt))
)
, bmclub_shop AS
(
    SELECT
        part_date
        , shop_number AS shop_no
        , MAX(IF(ad_kind_group = 'OPEN_LIST' AND JSON_EXTRACT_SCALAR(ad_campaign_data, '$.baeminClub.active') = 'true', 1, 0)) AS is_bmclub_mp
        , MAX(IF(ad_kind_group = 'BAEMIN_1_PLUS' AND JSON_EXTRACT_SCALAR(ad_campaign_data, '$.baeminClub.active') = 'true', 1, 0)) AS is_bmclub_od
    FROM sbadcenter.listinginventory_ongoing
    WHERE
        1=1
        -- start_date 기준
        AND part_date >>= (SELECT start_date FROM dt)
        -- end_date 기준
        AND part_date <<= (SELECT end_date FROM dt)
    GROUP BY 1,2
)
, shop_deliverytip AS
(
    SELECT
        b.part_date
        , b.shop_no
        , MAX(CASE
            WHEN rnum = 1 THEN order_price
            ELSE NULL END) AS order_price1
        , MAX(CASE
            WHEN rnum = 2 THEN order_price
            ELSE NULL END) AS order_price2
        , MAX(CASE
            when rnum = 3 THEN order_price
            ELSE NULL END) AS order_price3
        , MAX(CASE
            WHEN rnum = 1 THEN delivery_fee
            ELSE NULL END) AS delivery_fee1
        , MAX(CASE
            WHEN rnum = 2 THEN delivery_fee
            ELSE NULL END) AS delivery_fee2
        , MAX(CASE
            WHEN rnum = 3 THEN delivery_fee
            ELSE NULL END) AS delivery_fee3
    FROM
    (
        SELECT
            part_date
            , om.shop_no
            , order_price
            , delivery_fee
            , ROW_NUMBER() OVER (PARTITION BY om.shop_no, part_date ORDER BY order_price) AS rnum
        FROM sbstore.delivery_rule om
        WHERE
            1 = 1
            AND om.deleted = 0
            --and is_mp = 1
            AND om.delivery_type = 'AGENCY_DELIVERY'
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) b
    GROUP BY 1,2
)
, ord_raw AS
(
    SELECT
        om.*
        -- 공통 적용
        , DATE_FORMAT(DATE_ADD('day', 1 - DAY_OF_WEEK(DATE(om.part_date)), DATE(om.part_date)), '%Y-%m-%d') AS part_week
        , DATE_FORMAT(DATE_TRUNC('month', DATE(om.part_date)), '%Y-%m-%d') AS part_month
        , CASE
            WHEN om.delivery_type != 'DELIVERY' THEN 'TO'
            WHEN om.service_type NOT IN ('BAEMIN', 'BAERA') THEN 'TO'
            --WHEN om.is_stod = 1 THEN 'STOD'
            WHEN om.is_stod = 1 THEN 'OD'
            WHEN om.service_type = 'BAEMIN' THEN 'MP'
            WHEN om.service_type = 'BAERA' THEN 'OD'
            END AS service_type_dash
        , sm.shop_owner_no
        , COALESCE(mr.primary_shop_no, om.shop_no) AS shop_no_merged

         -- B2C
        -- 가게혜택(쿠폰)
        , IF(cdi.cpn_cnt_b2c >> 0, 1, 0) AS is_shop_coupon_discount_b2c
        , IF(cdi.cpn_cnt_download_single >> 0 OR cdi.cpn_cnt_download_common >> 0 OR cdi.cpn_cnt_first_single >> 0 OR cdi.cpn_cnt_first_common >> 0 OR cdi.cpn_cnt_regular_single >> 0 OR cdi.cpn_cnt_regular_common >> 0
            , 1, 0) AS is_shop_coupon_discount_b2c_od
        , IF(cdi.cpn_cnt_download_single >> 0 OR cdi.cpn_cnt_download_common >> 0
            , 1, 0) AS is_shop_coupon_discount_b2c_od_all
        , IF(cdi.cpn_cnt_first_single >> 0 OR cdi.cpn_cnt_first_common >> 0
            , 1, 0) AS is_shop_coupon_discount_b2c_od_first
        , IF(cdi.cpn_cnt_download_agency >> 0 OR cdi.cpn_cnt_first_agency >> 0 OR cdi.cpn_cnt_regular_agency >> 0
            , 1, 0) AS is_shop_coupon_discount_b2c_mp
        , IF(cdi.cpn_cnt_download_agency >> 0
            , 1, 0) AS is_shop_coupon_discount_b2c_mp_all
        , IF(cdi.cpn_cnt_first_agency >> 0
            , 1, 0) AS is_shop_coupon_discount_b2c_mp_first
        , IF(cdi.cpn_cnt_download_pickup >> 0 OR cdi.cpn_cnt_first_pickup >> 0 OR cdi.cpn_cnt_regular_pickup >> 0
            , 1, 0) AS is_shop_coupon_discount_b2c_to
        , IF(cdi.cpn_cnt_download_pickup >> 0
            , 1, 0) AS is_shop_coupon_discount_b2c_to_all
        , IF(cdi.cpn_cnt_first_pickup >> 0
            , 1, 0) AS is_shop_coupon_discount_b2c_to_first
        , IF(cdi.cpn_cnt_b2b >> 0, 1, 0) AS is_shop_coupon_discount_b2b
        , IF(cdi.cpn_cnt_b2b_single >> 0 OR cdi.cpn_cnt_b2b_common >> 0, 1, 0) AS is_shop_coupon_discount_b2b_od
        , IF(cdi.cpn_cnt_b2b_agency >> 0, 1, 0) AS is_shop_coupon_discount_b2b_mp
        , IF(cdi.cpn_cnt_b2b_pickup >> 0, 1, 0) AS is_shop_coupon_discount_b2b_to
        , b2c.coupon_discount_total, b2c.coupon_discount_b2c, b2c.coupon_discount_all, b2c.coupon_discount_first, b2c.coupon_discount_re, b2c.coupon_discount_b2b, b2c.coupon_discount_3p
        -- 포장할인
        , IF(pdi.discount_value >> 0, 1, 0) AS is_shop_pickup_discount
        , b2c.pickup_discount
        -- 메뉴할인
        , IF(mdi.is_franchise_menu = 0 AND mdi.discount_menu_cnt_total >> 0, 1, 0) AS is_shop_menu_discount_b2c
        , b2c.menu_discount, b2c.menu_discount_b2c, b2c.menu_discount_b2c_mfo_day, b2c.menu_discount_b2c_mfo_time, b2c.menu_discount_b2c_normal_day, b2c.menu_discount_b2c_normal_time
        , IF(mdi.is_franchise_menu = 1 AND mdi.discount_menu_cnt_total >> 0, 1, 0) AS is_shop_menu_discount_b2b
        , b2c.menu_discount_b2b, b2c.menu_discount_b2b_mfo_day, b2c.menu_discount_b2b_mfo_time, b2c.menu_discount_b2b_normal_day, b2c.menu_discount_b2b_normal_time
        -- 통합할인
        , IF((sa.shop_od_div_nm LIKE '%stod%' AND ddi.stod_discount_value >> 0) OR (sa.shop_od_div_nm LIKE '%plus%' AND ddi.plus_discount_value >> 0), 1, 0) AS is_shop_deliverytip_discount
        , b2c.deliverytip_discount, b2c.deliverytip_discount_order, b2c.deliverytip_discount_deliverytip
        -- 배민클럽
        , IF((om.service_type = 'BAEMIN' AND bs.is_bmclub_mp = 1) --OR (om.service_type = 'BAERA' AND bs.is_bmclub_od = 1)
            , 1, 0) AS is_shop_bmclub_discount
        , b2c.is_bmclub_order, b2c.bmclub_benefit_amt AS b2c_bmclub_benefit_amt
        -- 즉시할인 (2025. 7. 22 ~)
        , IF(idi.is_ord_all_single >> 0 OR idi.is_ord_all_common >> 0 OR idi.is_ord_all_agency >> 0 OR idi.is_ord_all_pickup >> 0 OR idi.is_ord_first >> 0
            OR idi.is_dlvy_free_single >> 0 OR idi.is_dlvy_free_common >> 0 OR idi.is_dlvy_amt_single >> 0 OR idi.is_dlvy_amt_common >> 0, 1, 0) AS is_shop_instant_discount
        , IF(idi.is_ord_all_single >> 0 OR idi.is_ord_all_common >> 0 OR idi.is_ord_all_agency >> 0 OR idi.is_ord_all_pickup >> 0 OR idi.is_ord_first >> 0, 1, 0) AS is_shop_instant_discount_ord
        , IF(idi.is_ord_all_single >> 0 OR idi.is_ord_all_common >> 0 OR idi.is_ord_first >> 0, 1, 0) AS is_shop_instant_discount_ord_od
        , IF(idi.is_ord_all_single >> 0 OR idi.is_ord_all_common >> 0, 1, 0) AS is_shop_instant_discount_ord_od_all
        , IF(idi.is_ord_first >> 0, 1, 0) AS is_shop_instant_discount_ord_od_first
        , IF(idi.is_ord_all_agency >> 0 OR idi.is_ord_first >> 0, 1, 0) AS is_shop_instant_discount_ord_mp
        , IF(idi.is_ord_all_agency >> 0, 1, 0) AS is_shop_instant_discount_ord_mp_all
        , IF(idi.is_ord_first >> 0, 1, 0) AS is_shop_instant_discount_ord_mp_first
        , IF(idi.is_ord_all_pickup >> 0 OR idi.is_ord_first >> 0, 1, 0) AS is_shop_instant_discount_ord_to
        , IF(idi.is_ord_all_pickup >> 0, 1, 0) AS is_shop_instant_discount_ord_to_all
        , IF(idi.is_ord_first >> 0, 1, 0) AS is_shop_instant_discount_ord_to_first
        , IF(idi.is_dlvy_free_single >> 0 OR idi.is_dlvy_free_common >> 0 OR idi.is_dlvy_amt_single >> 0 OR idi.is_dlvy_amt_common >> 0, 1, 0) AS is_shop_instant_discount_dlvy
        , IF(idi.is_cofunding_without_bmclub >> 0, 1, 0) AS is_shop_cofunding
        , COALESCE(b2c.instant_discount, 0) - COALESCE(b2c.instant_discount_bmclub_order, 0) - COALESCE(b2c.instant_discount_bmclub_deliverytip, 0) AS instant_discount
        , COALESCE(b2c.instant_discount_order, 0) - COALESCE(b2c.instant_discount_bmclub_order, 0) AS instant_discount_order
        , COALESCE(b2c.instant_discount_deliverytip, 0) - COALESCE(b2c.instant_discount_bmclub_deliverytip, 0) AS instant_discount_deliverytip
        -- 주문금액
        , b2c.instant_discount_all_order, b2c.instant_discount_first_order, b2c.instant_discount_re_order, b2c.instant_discount_bmclub_order
        -- 배달팁
        , b2c.instant_discount_bmclub_deliverytip, b2c.instant_discount_free_deliverytip, b2c.instant_discount_amount_deliverytip
        -- WFD (코펀딩)
        , COALESCE(b2c.instant_discount_woowa, 0) - COALESCE(b2c.instant_discount_bmclub_order_woowa, 0) - COALESCE(b2c.instant_discount_bmclub_deliverytip_woowa, 0) AS instant_discount_woowa
        , COALESCE(b2c.instant_discount_order_woowa, 0) - COALESCE(b2c.instant_discount_bmclub_order_woowa, 0) AS instant_discount_order_woowa
        , COALESCE(b2c.instant_discount_deliverytip_woowa, 0) - COALESCE(b2c.instant_discount_bmclub_deliverytip_woowa, 0) AS instant_discount_deliverytip_woowa
        , b2c.instant_discount_all_order_woowa, b2c.instant_discount_first_order_woowa, b2c.instant_discount_re_order_woowa, b2c.instant_discount_bmclub_order_woowa
        , b2c.instant_discount_bmclub_deliverytip_woowa, b2c.instant_discount_free_deliverytip_woowa, b2c.instant_discount_amount_deliverytip_woowa

        -- 브랜드제휴(B2B), 기업제휴(3P)
        -- 기프트카드
        , b2b.giftcard_amount, b2b.giftcard_amount_b2b, b2b.giftcard_amount_3p
        -- 포인트
        , b2b.point_vfd_3p
        -- 통합할인
        , b2b.delivery_discount_amt_b2b

        -- MP무료배달
        , IF(sd.delivery_fee1 = 0, 1, 0) AS is_shop_mp_free_deliverytip
        , mfd.mp_free_delivery_total, mfd.mp_free_delivery_whole, mfd.mp_free_delivery_base, mfd.deliverytip_discount AS mp_free_deliverytip_discount

        -- 집계
        , COALESCE(b2c.coupon_discount_total, 0) + COALESCE(b2c.pickup_discount, 0) + COALESCE(b2c.menu_discount, 0) + COALESCE(b2c.deliverytip_discount, 0) + COALESCE(mfd.deliverytip_discount, 0) + COALESCE(b2c.bmclub_benefit_amt, 0)
            + COALESCE(b2c.instant_discount, 0) - COALESCE(b2c.instant_discount_bmclub_order, 0) - COALESCE(b2c.instant_discount_bmclub_deliverytip, 0) -- 즉시할인에서 배민클럽 할인 제외
            + COALESCE(b2b.giftcard_amount, 0) + COALESCE(b2b.point_vfd_3p, 0) + COALESCE(b2b.delivery_discount_amt_b2b, 0) AS vfd_amt
        , COALESCE(b2c.coupon_discount_b2c, 0) + COALESCE(b2c.pickup_discount, 0) + COALESCE(b2c.menu_discount_b2c, 0) + COALESCE(b2c.deliverytip_discount, 0) + COALESCE(mfd.deliverytip_discount, 0)
            + COALESCE(b2c.instant_discount, 0) - COALESCE(b2c.instant_discount_bmclub_order, 0) - COALESCE(b2c.instant_discount_bmclub_deliverytip, 0) -- 즉시할인에서 배민클럽 할인 제외
            + COALESCE(b2c.bmclub_benefit_amt, 0) AS b2c_vfd_amt
        , COALESCE(b2c.coupon_discount_b2b, 0) + COALESCE(b2c.menu_discount_b2b, 0) + COALESCE(b2b.giftcard_amount_b2b, 0) + COALESCE(b2b.delivery_discount_amt_b2b, 0) AS b2b_vfd_amt
        , COALESCE(b2c.coupon_discount_3p, 0) + COALESCE(b2b.giftcard_amount_3p, 0) + COALESCE(b2b.point_vfd_3p, 0) AS vfd_amt_3p

    FROM sborder_mart.order_master om
    LEFT JOIN
    (
        SELECT
            *
        FROM vl_food.vfd_b2c_fact_daily
        WHERE
            1=1
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) AS b2c ON om.ord_no = b2c.ord_no AND om.part_date = b2c.part_date
    LEFT JOIN
    (
        SELECT
            *
        FROM vl_food.vfd_b2b_fact_daily
        WHERE
            1=1
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) AS b2b ON om.ord_no = b2b.ord_no AND om.part_date = b2b.part_date
    LEFT JOIN
    (
        SELECT
            *
        FROM vl_food.vfd_b2c_mp_free_deliverytip_fact_daily
        WHERE
            1=1
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) AS mfd ON om.ord_no = mfd.ord_no AND om.part_date = mfd.part_date
    LEFT JOIN
    (
        SELECT
            *
        FROM vl_food.vfd_coupon_discount_info
        WHERE
            1=1
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) AS cdi ON om.shop_no = cdi.shop_no AND om.part_date = cdi.part_date
    LEFT JOIN
    (
        SELECT
            *
        FROM vl_food.vfd_deliverytip_discount_info
        WHERE
            1=1
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) AS ddi ON om.shop_no = ddi.shop_no AND om.part_date = ddi.part_date
    LEFT JOIN
    (
        SELECT
            *
        FROM vl_food.vfd_menu_discount_info
        WHERE
            1=1
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) AS mdi ON om.shop_no = mdi.shop_no AND om.part_date = mdi.part_date
    LEFT JOIN
    (
        SELECT
            *
        FROM vl_food.vfd_pickup_discount_info
        WHERE
            1=1
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) AS pdi ON om.shop_no = pdi.shop_no AND om.part_date = pdi.part_date
    LEFT JOIN
    (
        SELECT
            *
        FROM vl_food.vfd_instant_discount_info
        WHERE
            1=1
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) AS idi ON om.shop_no = idi.shop_no AND om.part_date = idi.part_date
    LEFT JOIN
    (
        SELECT
            *
        FROM sbstore_hist.shop_master
        WHERE
            1=1
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) AS sm ON om.shop_no = sm.shop_no AND om.part_date = sm.part_date
    LEFT JOIN
    (
        SELECT
            *
        FROM cl_food.shop_ad_shop_owner_info
        WHERE
            1=1
            AND shop_ad_div_nm <<>> 'cpc'
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) AS sa ON om.shop_no = sa.shop_no AND om.part_date = sa.part_date
    LEFT JOIN bmclub_shop bs ON om.shop_no = bs.shop_no AND om.part_date = bs.part_date
    LEFT JOIN shop_deliverytip sd ON om.shop_no = sd.shop_no AND om.part_date = sd.part_date
    LEFT JOIN merge_result mr ON om.shop_no = mr.merged_shop_no AND om.part_date <<= mr.merged_date
    WHERE
        1=1
        -- start_date 기준
        AND om.part_date >>= (SELECT start_date FROM dt)
        -- end_date 기준
        AND om.part_date <<= (SELECT end_date FROM dt)
        AND om.is_closed = 1
        AND om.is_test = 0
)

SELECT
    part_date
    , service_type_dash AS service_type
    -- VFD Vendor Count
    , COUNT(DISTINCT IF(
        -- coupon
        (service_type_dash = 'OD' AND is_shop_coupon_discount_b2c_od = 1) OR (service_type_dash = 'MP' AND is_shop_coupon_discount_b2c_mp = 1) OR (service_type_dash = 'TO' AND is_shop_coupon_discount_b2c_to = 1)
        OR (service_type_dash = 'OD' AND is_shop_coupon_discount_b2b_od = 1) OR (service_type_dash = 'MP' AND is_shop_coupon_discount_b2b_mp = 1) OR (service_type_dash = 'TO' AND is_shop_coupon_discount_b2b_to = 1)
        -- ETC
        OR is_shop_menu_discount_b2c = 1 OR is_shop_menu_discount_b2b = 1
        -- pickup
        OR (service_type_dash = 'TO' AND is_shop_pickup_discount = 1)
        -- deliverytip
        OR (service_type_dash = 'OD' AND is_shop_deliverytip_discount = 1)
        -- MP bmclub
        OR (service_type_dash = 'MP' AND is_shop_bmclub_discount = 1)
        -- instant
        OR (service_type_dash = 'OD' AND (is_shop_instant_discount_ord_od = 1 OR is_shop_instant_discount_dlvy = 1)) OR (service_type_dash = 'MP' AND is_shop_instant_discount_ord_mp = 1) OR (service_type_dash = 'TO' AND is_shop_instant_discount_ord_to = 1)
        -- mp free dlvy
        OR (service_type_dash = 'MP' AND is_shop_mp_free_deliverytip = 1)
        , shop_no_merged, NULL)) AS shop_cnt_vfd
    , COUNT(DISTINCT IF(
        -- coupon
        (service_type_dash = 'OD' AND is_shop_coupon_discount_b2c_od = 1) OR (service_type_dash = 'MP' AND is_shop_coupon_discount_b2c_mp = 1) OR (service_type_dash = 'TO' AND is_shop_coupon_discount_b2c_to = 1)
        -- ETC
        OR is_shop_menu_discount_b2c = 1
        -- pickup
        OR (service_type_dash = 'TO' AND is_shop_pickup_discount = 1)
        -- deliverytip
        OR (service_type_dash = 'OD' AND is_shop_deliverytip_discount = 1)
        -- MP bmclub
        OR (service_type_dash = 'MP' AND is_shop_bmclub_discount = 1)
        -- instant
        OR (service_type_dash = 'OD' AND (is_shop_instant_discount_ord_od = 1 OR is_shop_instant_discount_dlvy = 1)) OR (service_type_dash = 'MP' AND is_shop_instant_discount_ord_mp = 1) OR (service_type_dash = 'TO' AND is_shop_instant_discount_ord_to = 1)
        -- mp free dlvy
        OR (service_type_dash = 'MP' AND is_shop_mp_free_deliverytip = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_vfd
    , COUNT(DISTINCT IF(
        -- instant
        (service_type_dash = 'OD' AND is_shop_instant_discount_ord_od = 1) OR (service_type_dash = 'MP' AND is_shop_instant_discount_ord_mp = 1) OR (service_type_dash = 'TO' AND is_shop_instant_discount_ord_to = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_instant_disc_ord
    , COUNT(DISTINCT IF(
        -- instant
        (service_type_dash = 'OD' AND is_shop_instant_discount_ord_od_all = 1) OR (service_type_dash = 'MP' AND is_shop_instant_discount_ord_mp_all = 1) OR (service_type_dash = 'TO' AND is_shop_instant_discount_ord_to_all = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_instant_disc_ord_all
    , COUNT(DISTINCT IF(
        -- instant
        (service_type_dash = 'OD' AND is_shop_instant_discount_ord_od_first = 1) OR (service_type_dash = 'MP' AND is_shop_instant_discount_ord_mp_first = 1) OR (service_type_dash = 'TO' AND is_shop_instant_discount_ord_to_first = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_instant_disc_ord_first
    , COUNT(DISTINCT IF(
        -- instant
        (service_type_dash = 'OD' AND is_shop_instant_discount_dlvy = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_instant_disc_dlvy
    , COUNT(DISTINCT IF(
        is_shop_menu_discount_b2c = 1
        , shop_no_merged, NULL)) AS b2c_shop_cnt_menu_disc
    , COUNT(DISTINCT IF(
        -- coupon
        (service_type_dash = 'OD' AND is_shop_coupon_discount_b2c_od = 1) OR (service_type_dash = 'MP' AND is_shop_coupon_discount_b2c_mp = 1) OR (service_type_dash = 'TO' AND is_shop_coupon_discount_b2c_to = 1)
        -- pickup
        OR (service_type_dash = 'TO' AND is_shop_pickup_discount = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_couponpickup_disc
    , COUNT(DISTINCT IF(
        -- coupon
        (service_type_dash = 'OD' AND is_shop_coupon_discount_b2c_od = 1) OR (service_type_dash = 'MP' AND is_shop_coupon_discount_b2c_mp = 1) OR (service_type_dash = 'TO' AND is_shop_coupon_discount_b2c_to = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_coupon_disc
    , COUNT(DISTINCT IF(
        -- coupon
        (service_type_dash = 'OD' AND is_shop_coupon_discount_b2c_od_all = 1) OR (service_type_dash = 'MP' AND is_shop_coupon_discount_b2c_mp_all = 1) OR (service_type_dash = 'TO' AND is_shop_coupon_discount_b2c_to_all = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_coupon_disc_all
    , COUNT(DISTINCT IF(
        -- coupon
        (service_type_dash = 'OD' AND is_shop_coupon_discount_b2c_od_first = 1) OR (service_type_dash = 'MP' AND is_shop_coupon_discount_b2c_mp_first = 1) OR (service_type_dash = 'TO' AND is_shop_coupon_discount_b2c_to_first = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_coupon_disc_first
    , COUNT(DISTINCT IF(
        -- pickup
        (service_type_dash = 'TO' AND is_shop_pickup_discount = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_pickup_disc
    , COUNT(DISTINCT IF(
        -- MP bmclub
        (service_type_dash = 'MP' AND is_shop_bmclub_discount = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_bmclub_disc
    , COUNT(DISTINCT IF(
        -- mp free dlvy
        (service_type_dash = 'MP' AND is_shop_mp_free_deliverytip = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_mp_free_dlvy
    , COUNT(DISTINCT IF(
        -- deliverytip
        (service_type_dash = 'OD' AND is_shop_deliverytip_discount = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_deliverytip_disc
    -- 추가
    , COUNT(DISTINCT IF(
        -- coupon
        (service_type_dash = 'OD' AND is_shop_coupon_discount_b2c_od_first = 1 AND is_shop_coupon_discount_b2c_od_all = 0)
        OR (service_type_dash = 'MP' AND is_shop_coupon_discount_b2c_mp_first = 1 AND is_shop_coupon_discount_b2c_mp_all = 0)
        OR (service_type_dash = 'TO' AND is_shop_coupon_discount_b2c_to_first = 1 AND is_shop_coupon_discount_b2c_to_all = 0)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_coupon_disc_first_woall
    , COUNT(DISTINCT IF(
        -- instant
        (service_type_dash = 'OD' AND is_shop_instant_discount_ord_od_first = 1 AND is_shop_instant_discount_ord_od_all = 0)
        OR (service_type_dash = 'MP' AND is_shop_instant_discount_ord_mp_first = 1 AND is_shop_instant_discount_ord_mp_all = 0)
        OR (service_type_dash = 'TO' AND is_shop_instant_discount_ord_to_first = 1 AND is_shop_instant_discount_ord_to_all = 0)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_instant_disc_ord_first_woall

FROM ord_raw
WHERE
    1=1
    -- start_date 기준
    AND part_date >>= (SELECT start_date FROM dt) AND part_date <<= (SELECT end_date FROM dt)
GROUP BY 1,2]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='presto.1j8omrc1a885f1118x8az1lvozxc' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[WITH
dt AS
(
    SELECT '2025-07-14' AS start_date, '2025-07-28' AS end_date
)
, merge_result AS
(
    SELECT DISTINCT
        primary_shop_no
        , merged_shop_no
        , DATE_FORMAT(registered, '%Y-%m-%d') AS merged_date
    FROM sbstore.shop_mapping
    WHERE
        1=1
        AND registered <<= DATE((SELECT end_date FROM dt))
        AND registered >>= DATE((SELECT start_date FROM dt))
)
, bmclub_shop AS
(
    SELECT
        part_date
        , shop_number AS shop_no
        , MAX(IF(ad_kind_group = 'OPEN_LIST' AND JSON_EXTRACT_SCALAR(ad_campaign_data, '$.baeminClub.active') = 'true', 1, 0)) AS is_bmclub_mp
        , MAX(IF(ad_kind_group = 'BAEMIN_1_PLUS' AND JSON_EXTRACT_SCALAR(ad_campaign_data, '$.baeminClub.active') = 'true', 1, 0)) AS is_bmclub_od
    FROM sbadcenter.listinginventory_ongoing
    WHERE
        1=1
        -- start_date 기준
        AND part_date >>= (SELECT start_date FROM dt)
        -- end_date 기준
        AND part_date <<= (SELECT end_date FROM dt)
    GROUP BY 1,2
)
, shop_deliverytip AS
(
    SELECT
        b.part_date
        , b.shop_no
        , MAX(CASE
            WHEN rnum = 1 THEN order_price
            ELSE NULL END) AS order_price1
        , MAX(CASE
            WHEN rnum = 2 THEN order_price
            ELSE NULL END) AS order_price2
        , MAX(CASE
            when rnum = 3 THEN order_price
            ELSE NULL END) AS order_price3
        , MAX(CASE
            WHEN rnum = 1 THEN delivery_fee
            ELSE NULL END) AS delivery_fee1
        , MAX(CASE
            WHEN rnum = 2 THEN delivery_fee
            ELSE NULL END) AS delivery_fee2
        , MAX(CASE
            WHEN rnum = 3 THEN delivery_fee
            ELSE NULL END) AS delivery_fee3
    FROM
    (
        SELECT
            part_date
            , om.shop_no
            , order_price
            , delivery_fee
            , ROW_NUMBER() OVER (PARTITION BY om.shop_no, part_date ORDER BY order_price) AS rnum
        FROM sbstore.delivery_rule om
        WHERE
            1 = 1
            AND om.deleted = 0
            --and is_mp = 1
            AND om.delivery_type = 'AGENCY_DELIVERY'
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) b
    GROUP BY 1,2
)
, ord_raw AS
(
    SELECT
        om.*
        -- 공통 적용
        , DATE_FORMAT(DATE_ADD('day', 1 - DAY_OF_WEEK(DATE(om.part_date)), DATE(om.part_date)), '%Y-%m-%d') AS part_week
        , DATE_FORMAT(DATE_TRUNC('month', DATE(om.part_date)), '%Y-%m-%d') AS part_month
        , CASE
            WHEN om.delivery_type != 'DELIVERY' THEN 'TO'
            WHEN om.service_type NOT IN ('BAEMIN', 'BAERA') THEN 'TO'
            --WHEN om.is_stod = 1 THEN 'STOD'
            WHEN om.is_stod = 1 THEN 'OD'
            WHEN om.service_type = 'BAEMIN' THEN 'MP'
            WHEN om.service_type = 'BAERA' THEN 'OD'
            END AS service_type_dash
        , sm.shop_owner_no
        , COALESCE(mr.primary_shop_no, om.shop_no) AS shop_no_merged

         -- B2C
        -- 가게혜택(쿠폰)
        , IF(cdi.cpn_cnt_b2c >> 0, 1, 0) AS is_shop_coupon_discount_b2c
        , IF(cdi.cpn_cnt_download_single >> 0 OR cdi.cpn_cnt_download_common >> 0 OR cdi.cpn_cnt_first_single >> 0 OR cdi.cpn_cnt_first_common >> 0 OR cdi.cpn_cnt_regular_single >> 0 OR cdi.cpn_cnt_regular_common >> 0
            , 1, 0) AS is_shop_coupon_discount_b2c_od
        , IF(cdi.cpn_cnt_download_single >> 0 OR cdi.cpn_cnt_download_common >> 0
            , 1, 0) AS is_shop_coupon_discount_b2c_od_all
        , IF(cdi.cpn_cnt_first_single >> 0 OR cdi.cpn_cnt_first_common >> 0
            , 1, 0) AS is_shop_coupon_discount_b2c_od_first
        , IF(cdi.cpn_cnt_download_agency >> 0 OR cdi.cpn_cnt_first_agency >> 0 OR cdi.cpn_cnt_regular_agency >> 0
            , 1, 0) AS is_shop_coupon_discount_b2c_mp
        , IF(cdi.cpn_cnt_download_agency >> 0
            , 1, 0) AS is_shop_coupon_discount_b2c_mp_all
        , IF(cdi.cpn_cnt_first_agency >> 0
            , 1, 0) AS is_shop_coupon_discount_b2c_mp_first
        , IF(cdi.cpn_cnt_download_pickup >> 0 OR cdi.cpn_cnt_first_pickup >> 0 OR cdi.cpn_cnt_regular_pickup >> 0
            , 1, 0) AS is_shop_coupon_discount_b2c_to
        , IF(cdi.cpn_cnt_download_pickup >> 0
            , 1, 0) AS is_shop_coupon_discount_b2c_to_all
        , IF(cdi.cpn_cnt_first_pickup >> 0
            , 1, 0) AS is_shop_coupon_discount_b2c_to_first
        , IF(cdi.cpn_cnt_b2b >> 0, 1, 0) AS is_shop_coupon_discount_b2b
        , IF(cdi.cpn_cnt_b2b_single >> 0 OR cdi.cpn_cnt_b2b_common >> 0, 1, 0) AS is_shop_coupon_discount_b2b_od
        , IF(cdi.cpn_cnt_b2b_agency >> 0, 1, 0) AS is_shop_coupon_discount_b2b_mp
        , IF(cdi.cpn_cnt_b2b_pickup >> 0, 1, 0) AS is_shop_coupon_discount_b2b_to
        , b2c.coupon_discount_total, b2c.coupon_discount_b2c, b2c.coupon_discount_all, b2c.coupon_discount_first, b2c.coupon_discount_re, b2c.coupon_discount_b2b, b2c.coupon_discount_3p
        -- 포장할인
        , IF(pdi.discount_value >> 0, 1, 0) AS is_shop_pickup_discount
        , b2c.pickup_discount
        -- 메뉴할인
        , IF(mdi.is_franchise_menu = 0 AND mdi.discount_menu_cnt_total >> 0, 1, 0) AS is_shop_menu_discount_b2c
        , b2c.menu_discount, b2c.menu_discount_b2c, b2c.menu_discount_b2c_mfo_day, b2c.menu_discount_b2c_mfo_time, b2c.menu_discount_b2c_normal_day, b2c.menu_discount_b2c_normal_time
        , IF(mdi.is_franchise_menu = 1 AND mdi.discount_menu_cnt_total >> 0, 1, 0) AS is_shop_menu_discount_b2b
        , b2c.menu_discount_b2b, b2c.menu_discount_b2b_mfo_day, b2c.menu_discount_b2b_mfo_time, b2c.menu_discount_b2b_normal_day, b2c.menu_discount_b2b_normal_time
        -- 통합할인
        , IF((sa.shop_od_div_nm LIKE '%stod%' AND ddi.stod_discount_value >> 0) OR (sa.shop_od_div_nm LIKE '%plus%' AND ddi.plus_discount_value >> 0), 1, 0) AS is_shop_deliverytip_discount
        , b2c.deliverytip_discount, b2c.deliverytip_discount_order, b2c.deliverytip_discount_deliverytip
        -- 배민클럽
        , IF((om.service_type = 'BAEMIN' AND bs.is_bmclub_mp = 1) --OR (om.service_type = 'BAERA' AND bs.is_bmclub_od = 1)
            , 1, 0) AS is_shop_bmclub_discount
        , b2c.is_bmclub_order, b2c.bmclub_benefit_amt AS b2c_bmclub_benefit_amt
        -- 즉시할인 (2025. 7. 22 ~)
        , IF(idi.is_ord_all_single >> 0 OR idi.is_ord_all_common >> 0 OR idi.is_ord_all_agency >> 0 OR idi.is_ord_all_pickup >> 0 OR idi.is_ord_first >> 0
            OR idi.is_dlvy_free_single >> 0 OR idi.is_dlvy_free_common >> 0 OR idi.is_dlvy_amt_single >> 0 OR idi.is_dlvy_amt_common >> 0, 1, 0) AS is_shop_instant_discount
        , IF(idi.is_ord_all_single >> 0 OR idi.is_ord_all_common >> 0 OR idi.is_ord_all_agency >> 0 OR idi.is_ord_all_pickup >> 0 OR idi.is_ord_first >> 0, 1, 0) AS is_shop_instant_discount_ord
        , IF(idi.is_ord_all_single >> 0 OR idi.is_ord_all_common >> 0 OR idi.is_ord_first >> 0, 1, 0) AS is_shop_instant_discount_ord_od
        , IF(idi.is_ord_all_single >> 0 OR idi.is_ord_all_common >> 0, 1, 0) AS is_shop_instant_discount_ord_od_all
        , IF(idi.is_ord_first >> 0, 1, 0) AS is_shop_instant_discount_ord_od_first
        , IF(idi.is_ord_all_agency >> 0 OR idi.is_ord_first >> 0, 1, 0) AS is_shop_instant_discount_ord_mp
        , IF(idi.is_ord_all_agency >> 0, 1, 0) AS is_shop_instant_discount_ord_mp_all
        , IF(idi.is_ord_first >> 0, 1, 0) AS is_shop_instant_discount_ord_mp_first
        , IF(idi.is_ord_all_pickup >> 0 OR idi.is_ord_first >> 0, 1, 0) AS is_shop_instant_discount_ord_to
        , IF(idi.is_ord_all_pickup >> 0, 1, 0) AS is_shop_instant_discount_ord_to_all
        , IF(idi.is_ord_first >> 0, 1, 0) AS is_shop_instant_discount_ord_to_first
        , IF(idi.is_dlvy_free_single >> 0 OR idi.is_dlvy_free_common >> 0 OR idi.is_dlvy_amt_single >> 0 OR idi.is_dlvy_amt_common >> 0, 1, 0) AS is_shop_instant_discount_dlvy
        , IF(idi.is_cofunding_without_bmclub >> 0, 1, 0) AS is_shop_cofunding
        , COALESCE(b2c.instant_discount, 0) - COALESCE(b2c.instant_discount_bmclub_order, 0) - COALESCE(b2c.instant_discount_bmclub_deliverytip, 0) AS instant_discount
        , COALESCE(b2c.instant_discount_order, 0) - COALESCE(b2c.instant_discount_bmclub_order, 0) AS instant_discount_order
        , COALESCE(b2c.instant_discount_deliverytip, 0) - COALESCE(b2c.instant_discount_bmclub_deliverytip, 0) AS instant_discount_deliverytip
        -- 주문금액
        , b2c.instant_discount_all_order, b2c.instant_discount_first_order, b2c.instant_discount_re_order, b2c.instant_discount_bmclub_order
        -- 배달팁
        , b2c.instant_discount_bmclub_deliverytip, b2c.instant_discount_free_deliverytip, b2c.instant_discount_amount_deliverytip
        -- WFD (코펀딩)
        , COALESCE(b2c.instant_discount_woowa, 0) - COALESCE(b2c.instant_discount_bmclub_order_woowa, 0) - COALESCE(b2c.instant_discount_bmclub_deliverytip_woowa, 0) AS instant_discount_woowa
        , COALESCE(b2c.instant_discount_order_woowa, 0) - COALESCE(b2c.instant_discount_bmclub_order_woowa, 0) AS instant_discount_order_woowa
        , COALESCE(b2c.instant_discount_deliverytip_woowa, 0) - COALESCE(b2c.instant_discount_bmclub_deliverytip_woowa, 0) AS instant_discount_deliverytip_woowa
        , b2c.instant_discount_all_order_woowa, b2c.instant_discount_first_order_woowa, b2c.instant_discount_re_order_woowa, b2c.instant_discount_bmclub_order_woowa
        , b2c.instant_discount_bmclub_deliverytip_woowa, b2c.instant_discount_free_deliverytip_woowa, b2c.instant_discount_amount_deliverytip_woowa

        -- 브랜드제휴(B2B), 기업제휴(3P)
        -- 기프트카드
        , b2b.giftcard_amount, b2b.giftcard_amount_b2b, b2b.giftcard_amount_3p
        -- 포인트
        , b2b.point_vfd_3p
        -- 통합할인
        , b2b.delivery_discount_amt_b2b

        -- MP무료배달
        , IF(sd.delivery_fee1 = 0, 1, 0) AS is_shop_mp_free_deliverytip
        , mfd.mp_free_delivery_total, mfd.mp_free_delivery_whole, mfd.mp_free_delivery_base, mfd.deliverytip_discount AS mp_free_deliverytip_discount

        -- 집계
        , COALESCE(b2c.coupon_discount_total, 0) + COALESCE(b2c.pickup_discount, 0) + COALESCE(b2c.menu_discount, 0) + COALESCE(b2c.deliverytip_discount, 0) + COALESCE(mfd.deliverytip_discount, 0) + COALESCE(b2c.bmclub_benefit_amt, 0)
            + COALESCE(b2c.instant_discount, 0) - COALESCE(b2c.instant_discount_bmclub_order, 0) - COALESCE(b2c.instant_discount_bmclub_deliverytip, 0) -- 즉시할인에서 배민클럽 할인 제외
            + COALESCE(b2b.giftcard_amount, 0) + COALESCE(b2b.point_vfd_3p, 0) + COALESCE(b2b.delivery_discount_amt_b2b, 0) AS vfd_amt
        , COALESCE(b2c.coupon_discount_b2c, 0) + COALESCE(b2c.pickup_discount, 0) + COALESCE(b2c.menu_discount_b2c, 0) + COALESCE(b2c.deliverytip_discount, 0) + COALESCE(mfd.deliverytip_discount, 0)
            + COALESCE(b2c.instant_discount, 0) - COALESCE(b2c.instant_discount_bmclub_order, 0) - COALESCE(b2c.instant_discount_bmclub_deliverytip, 0) -- 즉시할인에서 배민클럽 할인 제외
            + COALESCE(b2c.bmclub_benefit_amt, 0) AS b2c_vfd_amt
        , COALESCE(b2c.coupon_discount_b2b, 0) + COALESCE(b2c.menu_discount_b2b, 0) + COALESCE(b2b.giftcard_amount_b2b, 0) + COALESCE(b2b.delivery_discount_amt_b2b, 0) AS b2b_vfd_amt
        , COALESCE(b2c.coupon_discount_3p, 0) + COALESCE(b2b.giftcard_amount_3p, 0) + COALESCE(b2b.point_vfd_3p, 0) AS vfd_amt_3p

    FROM sborder_mart.order_master om
    LEFT JOIN
    (
        SELECT
            *
        FROM vl_food.vfd_b2c_fact_daily
        WHERE
            1=1
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) AS b2c ON om.ord_no = b2c.ord_no AND om.part_date = b2c.part_date
    LEFT JOIN
    (
        SELECT
            *
        FROM vl_food.vfd_b2b_fact_daily
        WHERE
            1=1
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) AS b2b ON om.ord_no = b2b.ord_no AND om.part_date = b2b.part_date
    LEFT JOIN
    (
        SELECT
            *
        FROM vl_food.vfd_b2c_mp_free_deliverytip_fact_daily
        WHERE
            1=1
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) AS mfd ON om.ord_no = mfd.ord_no AND om.part_date = mfd.part_date
    LEFT JOIN
    (
        SELECT
            *
        FROM vl_food.vfd_coupon_discount_info
        WHERE
            1=1
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) AS cdi ON om.shop_no = cdi.shop_no AND om.part_date = cdi.part_date
    LEFT JOIN
    (
        SELECT
            *
        FROM vl_food.vfd_deliverytip_discount_info
        WHERE
            1=1
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) AS ddi ON om.shop_no = ddi.shop_no AND om.part_date = ddi.part_date
    LEFT JOIN
    (
        SELECT
            *
        FROM vl_food.vfd_menu_discount_info
        WHERE
            1=1
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) AS mdi ON om.shop_no = mdi.shop_no AND om.part_date = mdi.part_date
    LEFT JOIN
    (
        SELECT
            *
        FROM vl_food.vfd_pickup_discount_info
        WHERE
            1=1
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) AS pdi ON om.shop_no = pdi.shop_no AND om.part_date = pdi.part_date
    LEFT JOIN
    (
        SELECT
            *
        FROM vl_food.vfd_instant_discount_info
        WHERE
            1=1
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) AS idi ON om.shop_no = idi.shop_no AND om.part_date = idi.part_date
    LEFT JOIN
    (
        SELECT
            *
        FROM sbstore_hist.shop_master
        WHERE
            1=1
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) AS sm ON om.shop_no = sm.shop_no AND om.part_date = sm.part_date
    LEFT JOIN
    (
        SELECT
            *
        FROM cl_food.shop_ad_shop_owner_info
        WHERE
            1=1
            AND shop_ad_div_nm <<>> 'cpc'
            -- start_date 기준
            AND part_date >>= (SELECT start_date FROM dt)
            -- end_date 기준
            AND part_date <<= (SELECT end_date FROM dt)
    ) AS sa ON om.shop_no = sa.shop_no AND om.part_date = sa.part_date
    LEFT JOIN bmclub_shop bs ON om.shop_no = bs.shop_no AND om.part_date = bs.part_date
    LEFT JOIN shop_deliverytip sd ON om.shop_no = sd.shop_no AND om.part_date = sd.part_date
    LEFT JOIN merge_result mr ON om.shop_no = mr.merged_shop_no AND om.part_date <<= mr.merged_date
    WHERE
        1=1
        -- start_date 기준
        AND om.part_date >>= (SELECT start_date FROM dt)
        -- end_date 기준
        AND om.part_date <<= (SELECT end_date FROM dt)
        AND om.is_closed = 1
        AND om.is_test = 0
)

SELECT
    part_date
    , service_type_dash AS service_type
    -- VFD Vendor Count
    , COUNT(DISTINCT IF(
        -- coupon
        (service_type_dash = 'OD' AND is_shop_coupon_discount_b2c_od = 1) OR (service_type_dash = 'MP' AND is_shop_coupon_discount_b2c_mp = 1) OR (service_type_dash = 'TO' AND is_shop_coupon_discount_b2c_to = 1)
        OR (service_type_dash = 'OD' AND is_shop_coupon_discount_b2b_od = 1) OR (service_type_dash = 'MP' AND is_shop_coupon_discount_b2b_mp = 1) OR (service_type_dash = 'TO' AND is_shop_coupon_discount_b2b_to = 1)
        -- ETC
        OR is_shop_menu_discount_b2c = 1 OR is_shop_menu_discount_b2b = 1
        -- pickup
        OR (service_type_dash = 'TO' AND is_shop_pickup_discount = 1)
        -- deliverytip
        OR (service_type_dash = 'OD' AND is_shop_deliverytip_discount = 1)
        -- MP bmclub
        OR (service_type_dash = 'MP' AND is_shop_bmclub_discount = 1)
        -- instant
        OR (service_type_dash = 'OD' AND (is_shop_instant_discount_ord_od = 1 OR is_shop_instant_discount_dlvy = 1)) OR (service_type_dash = 'MP' AND is_shop_instant_discount_ord_mp = 1) OR (service_type_dash = 'TO' AND is_shop_instant_discount_ord_to = 1)
        -- mp free dlvy
        OR (service_type_dash = 'MP' AND is_shop_mp_free_deliverytip = 1)
        , shop_no_merged, NULL)) AS shop_cnt_vfd
    , COUNT(DISTINCT IF(
        -- coupon
        (service_type_dash = 'OD' AND is_shop_coupon_discount_b2c_od = 1) OR (service_type_dash = 'MP' AND is_shop_coupon_discount_b2c_mp = 1) OR (service_type_dash = 'TO' AND is_shop_coupon_discount_b2c_to = 1)
        -- ETC
        OR is_shop_menu_discount_b2c = 1
        -- pickup
        OR (service_type_dash = 'TO' AND is_shop_pickup_discount = 1)
        -- deliverytip
        OR (service_type_dash = 'OD' AND is_shop_deliverytip_discount = 1)
        -- MP bmclub
        OR (service_type_dash = 'MP' AND is_shop_bmclub_discount = 1)
        -- instant
        OR (service_type_dash = 'OD' AND (is_shop_instant_discount_ord_od = 1 OR is_shop_instant_discount_dlvy = 1)) OR (service_type_dash = 'MP' AND is_shop_instant_discount_ord_mp = 1) OR (service_type_dash = 'TO' AND is_shop_instant_discount_ord_to = 1)
        -- mp free dlvy
        OR (service_type_dash = 'MP' AND is_shop_mp_free_deliverytip = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_vfd
    , COUNT(DISTINCT IF(
        -- instant
        (service_type_dash = 'OD' AND is_shop_instant_discount_ord_od = 1) OR (service_type_dash = 'MP' AND is_shop_instant_discount_ord_mp = 1) OR (service_type_dash = 'TO' AND is_shop_instant_discount_ord_to = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_instant_disc_ord
    , COUNT(DISTINCT IF(
        -- instant
        (service_type_dash = 'OD' AND is_shop_instant_discount_ord_od_all = 1) OR (service_type_dash = 'MP' AND is_shop_instant_discount_ord_mp_all = 1) OR (service_type_dash = 'TO' AND is_shop_instant_discount_ord_to_all = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_instant_disc_ord_all
    , COUNT(DISTINCT IF(
        -- instant
        (service_type_dash = 'OD' AND is_shop_instant_discount_ord_od_first = 1) OR (service_type_dash = 'MP' AND is_shop_instant_discount_ord_mp_first = 1) OR (service_type_dash = 'TO' AND is_shop_instant_discount_ord_to_first = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_instant_disc_ord_first
    , COUNT(DISTINCT IF(
        -- instant
        (service_type_dash = 'OD' AND is_shop_instant_discount_dlvy = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_instant_disc_dlvy
    , COUNT(DISTINCT IF(
        is_shop_menu_discount_b2c = 1
        , shop_no_merged, NULL)) AS b2c_shop_cnt_menu_disc
    , COUNT(DISTINCT IF(
        -- coupon
        (service_type_dash = 'OD' AND is_shop_coupon_discount_b2c_od = 1) OR (service_type_dash = 'MP' AND is_shop_coupon_discount_b2c_mp = 1) OR (service_type_dash = 'TO' AND is_shop_coupon_discount_b2c_to = 1)
        -- pickup
        OR (service_type_dash = 'TO' AND is_shop_pickup_discount = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_couponpickup_disc
    , COUNT(DISTINCT IF(
        -- coupon
        (service_type_dash = 'OD' AND is_shop_coupon_discount_b2c_od = 1) OR (service_type_dash = 'MP' AND is_shop_coupon_discount_b2c_mp = 1) OR (service_type_dash = 'TO' AND is_shop_coupon_discount_b2c_to = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_coupon_disc
    , COUNT(DISTINCT IF(
        -- coupon
        (service_type_dash = 'OD' AND is_shop_coupon_discount_b2c_od_all = 1) OR (service_type_dash = 'MP' AND is_shop_coupon_discount_b2c_mp_all = 1) OR (service_type_dash = 'TO' AND is_shop_coupon_discount_b2c_to_all = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_coupon_disc_all
    , COUNT(DISTINCT IF(
        -- coupon
        (service_type_dash = 'OD' AND is_shop_coupon_discount_b2c_od_first = 1) OR (service_type_dash = 'MP' AND is_shop_coupon_discount_b2c_mp_first = 1) OR (service_type_dash = 'TO' AND is_shop_coupon_discount_b2c_to_first = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_coupon_disc_first
    , COUNT(DISTINCT IF(
        -- pickup
        (service_type_dash = 'TO' AND is_shop_pickup_discount = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_pickup_disc
    , COUNT(DISTINCT IF(
        -- MP bmclub
        (service_type_dash = 'MP' AND is_shop_bmclub_discount = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_bmclub_disc
    , COUNT(DISTINCT IF(
        -- mp free dlvy
        (service_type_dash = 'MP' AND is_shop_mp_free_deliverytip = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_mp_free_dlvy
    , COUNT(DISTINCT IF(
        -- deliverytip
        (service_type_dash = 'OD' AND is_shop_deliverytip_discount = 1)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_deliverytip_disc
    -- 추가
    , COUNT(DISTINCT IF(
        -- coupon
        (service_type_dash = 'OD' AND is_shop_coupon_discount_b2c_od_first = 1 AND is_shop_coupon_discount_b2c_od_all = 0)
        OR (service_type_dash = 'MP' AND is_shop_coupon_discount_b2c_mp_first = 1 AND is_shop_coupon_discount_b2c_mp_all = 0)
        OR (service_type_dash = 'TO' AND is_shop_coupon_discount_b2c_to_first = 1 AND is_shop_coupon_discount_b2c_to_all = 0)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_coupon_disc_first_woall
    , COUNT(DISTINCT IF(
        -- instant
        (service_type_dash = 'OD' AND is_shop_instant_discount_ord_od_first = 1 AND is_shop_instant_discount_ord_od_all = 0)
        OR (service_type_dash = 'MP' AND is_shop_instant_discount_ord_mp_first = 1 AND is_shop_instant_discount_ord_mp_all = 0)
        OR (service_type_dash = 'TO' AND is_shop_instant_discount_ord_to_first = 1 AND is_shop_instant_discount_ord_to_all = 0)
        , shop_no_merged, NULL)) AS b2c_shop_cnt_instant_disc_ord_first_woall

FROM ord_raw
WHERE
    1=1
    -- start_date 기준
    AND part_date >>= (SELECT start_date FROM dt) AND part_date <<= (SELECT end_date FROM dt)
GROUP BY 1,2]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
