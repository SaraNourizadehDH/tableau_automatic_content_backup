              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1g3y0dl1fnii4z19knm990nwbgxw].[sum:b2c_shop_cnt_coupon_disc_all:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1g3y0dl1fnii4z19knm990nwbgxw].[sum:b2c_shop_cnt_coupon_disc_first:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1g3y0dl1fnii4z19knm990nwbgxw].[sum:b2c_shop_cnt_pickup_disc:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1g3y0dl1fnii4z19knm990nwbgxw].[sum:b2c_shop_cnt_deliverytip_disc:qk]&quot;' />
