      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;대한민국&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='사용자 지정 SQL 쿼리' id='_1170F7A7305E4488B223A2AA34E5455D'>
            <properties context=''>
              <relation connection='presto.12dwbta0ukssfw1frdxvz0d0opch' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[with
dt as (select '2025-03-01' as start_date, date_format(current_timestamp + interval '9' hour, '%Y-%m-%d') as end_date)
, int_discount AS
(
    SELECT a.ord_no
        , seller_discount
        , seller_discount_base_deliv_tip
        , seller_discount_extra_deliv_tip
        , seller_discount_order_amount
    FROM sbtasty.baemin_one_delivery_tip_detail a
    WHERE 1=1
        and part_date <<= (select end_date from dt)
        and part_date >>= (select start_date from dt) -- period start
)
, dbdf as
(
    select *
    from temp.dbdf_test_group_info
    where 1=1
        and part_date >>= (select start_date from dt)
        and part_date <<= (select end_date from dt)
)
    select om.part_date
         , dbdf.rgn1_nm, dbdf.rgn2_nm, dbdf.test_group_nm
         , count(distinct om.ord_no) as od_ord_cnt
         , count(distinct
           case when (om.part_date >>= '2024-07-30' and id.seller_discount >> 0) then om.ord_no end
           ) as ddr_ord_cnt
         , sum(om.ord_price) as od_ord_amt
         , sum(
           case when (om.part_date >>= '2024-07-30' and id.seller_discount >> 0) then om.ord_price end
           ) as ddr_ord_amt
         , sum(
            case when om.part_date << '2024-07-30' THEN seller_charge_amount - seller_charge_coupon_discount
                 when om.part_date >>= '2024-07-30' THEN id.seller_discount ELSE 0 END
           ) AS deliverytip_discount_amt
    FROM sborder_mart.order_master om
        left join int_discount id on om.ord_no = id.ord_no
        left join dbdf on om.rgn2_cd = dbdf.rgn2_cd and om.part_date = dbdf.part_date
    WHERE 1=1
        and om.part_date <<= (select end_date from dt)
        and om.part_date >>= (select start_date from dt) -- period start
        AND is_closed = 1
        AND is_test = 0
        and service_type = 'BAERA'  -- OD 주문만
        --and ((om.part_date >>= '2024-07-30' and id.seller_discount >> 0)
                 --or (om.part_date << '2024-07-30' and (seller_charge_amount - seller_charge_coupon_discount) >> 0))
    group by 1,2,3,4]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
