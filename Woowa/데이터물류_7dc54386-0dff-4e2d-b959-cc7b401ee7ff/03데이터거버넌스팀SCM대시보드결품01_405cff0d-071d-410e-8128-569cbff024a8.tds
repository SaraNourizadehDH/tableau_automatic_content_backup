    <relation connection='athena.0ihbd970nngzxr1eliqaz199x6r1' name='사용자 지정 SQL 쿼리' type='text'>select d1.year&#13;&#10;     , d1.month&#13;&#10;     , d1.day&#13;&#10;     , d1.weekday_nm&#13;&#10;     , d1.holiday_yn&#13;&#10;     , d1.holiday_desc&#13;&#10;     , d1.week_seq&#13;&#10;     , t1.part_dt&#13;&#10;     , t1.cntr_cd&#13;&#10;     , d2.cntr_nm&#13;&#10;     , d2.cntr_lttd&#13;&#10;     , d2.cntr_lgtd&#13;&#10;     , d2.sido_nm&#13;&#10;     , d2.gugun_nm&#13;&#10;     , d2.dong_nm&#13;&#10;--     , t1.prod_cd&#13;&#10;--     , d3.prod_nm&#13;&#10;     , t1.cat_id&#13;&#10;     , d4.cat1_nm  &#13;&#10;     , d4.cat2_nm &#13;&#10;     , d4.cat3_nm&#13;&#10;     , d4.cat4_nm&#13;&#10;     , d3.prod_sal_gd&#13;&#10;     , t1.base_tz&#13;&#10;     , count(*)                          as fc_prod_cnt   --FC 운영상품수&#13;&#10;     , sum(lack_yn)                      as fc_lack_cnt   --FC 결품상품수&#13;&#10;     , sum(lack_yn) * 1.000 / count(*)   as fc_lack_accr  --FC 결품률&#13;&#10;     , min(t3.missing_rate)              as missing_rate_17  -- 일별 마감결품률&#13;&#10;from cl_logis.scm_bmart_fc_lack_hh_fact t1 &#13;&#10;join cl_common.date_master    d1 on t1.part_dt = d1.date_cd &#13;&#10;join marketfulfillment.s3_missing_rate_at_17  t3 on t1.part_dt = t3.target_date&#13;&#10;join cl_logis.cntr_dd_master  d2 on t1.part_dt = d2.part_dt and t1.cntr_cd = d2.cntr_cd&#13;&#10;join cl_logis.prod_dd_master  d3 on t1.part_dt = d3.part_dt and t1.prod_cd = d3.prod_cd&#13;&#10;join cl_logis.prod_cat_master d4 on t1.cat_id = d4.cat_id&#13;&#10;where CAST(t1.part_dt AS DATE) &gt;&gt;= DATE_ADD(&apos;month&apos;, -3, CURRENT_DATE)&#13;&#10;  and t1.prod_stts = &apos;ON_SALE&apos;&#13;&#10;  and t1.prod_hndl_yn = 1&#13;&#10;  and t1.prod_dspl_yn = 1&#13;&#10;  and t1.base_tz in (&apos;09&apos;,&apos;13&apos;,&apos;17&apos;,&apos;18&apos;,&apos;19&apos;,&apos;20&apos;,&apos;21&apos;,&apos;22&apos;,&apos;24&apos;)&#13;&#10;group by d1.year&#13;&#10;     , d1.month&#13;&#10;     , d1.day&#13;&#10;     , d1.weekday_nm&#13;&#10;     , d1.holiday_yn&#13;&#10;     , d1.holiday_desc&#13;&#10;     , d1.week_seq&#13;&#10;     , t1.part_dt&#13;&#10;     , t1.cntr_cd&#13;&#10;     , d2.cntr_nm&#13;&#10;     , d2.cntr_lttd&#13;&#10;     , d2.cntr_lgtd&#13;&#10;     , d2.sido_nm&#13;&#10;     , d2.gugun_nm&#13;&#10;     , d2.dong_nm&#13;&#10;--     , t1.prod_cd&#13;&#10;--     , d3.prod_nm&#13;&#10;     , t1.cat_id&#13;&#10;     , d4.cat1_nm&#13;&#10;     , d4.cat2_nm&#13;&#10;     , d4.cat3_nm&#13;&#10;     , d4.cat4_nm&#13;&#10;     , d3.prod_sal_gd&#13;&#10;     , t1.base_tz</relation>
