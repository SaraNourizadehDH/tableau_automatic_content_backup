      <object caption='사용자 지정 SQL 쿼리' id='_ED5894FD84DA4D609AA30ECF3E397AA1'>
        <properties context=''>
          <relation connection='athena.1qmc9vh1cgojvv19o4fad002guhu' name='사용자 지정 SQL 쿼리' type='text'>select d1.year&#13;&#10;     , d1.month&#13;&#10;     , d1.day&#13;&#10;     , d1.week_seq&#13;&#10;     , t1.part_dt&#13;&#10;     , t1.cntr_cd&#13;&#10;     , d2.cntr_nm&#13;&#10;     , d2.cntr_lttd&#13;&#10;     , d2.cntr_lgtd&#13;&#10;     , d2.sido_nm&#13;&#10;     , d2.gugun_nm&#13;&#10;     , d2.dong_nm&#13;&#10;     -- , t1.prod_cd&#13;&#10;     -- , d3.prod_nm&#13;&#10;     , d3.cat_id&#13;&#10;     , coalesce(case when d3.prod_sal_gd in (&apos;A&apos;,&apos;B&apos;,&apos;C&apos;,&apos;D&apos;,&apos;N&apos;,&apos;S&apos;,&apos;Z&apos;) then d3.prod_sal_gd end,&apos;&apos;) as prod_sal_gd&#13;&#10;     , d4.cat1_nm&#13;&#10;     , d4.cat2_nm&#13;&#10;     , d4.cat3_nm&#13;&#10;     , d4.cat4_nm&#13;&#10;     , d1.holiday_yn&#13;&#10;     , d1.holiday_desc&#13;&#10;     , d1.weekday_nm&#13;&#10;     , sum(sal_amt)                  as gpv          --판매금액&#13;&#10;     , sum(sal_amt_excl_tax)         as gmv          --판매금액&#13;&#10;     , sum(sal_qty)                  as sal_qty      --판매수량&#13;&#10;     , sum(fcst_sal_qty)             as fcst_sal_qty --FCST&#13;&#10;from (  select part_dt&#13;&#10;             , cntr_cd&#13;&#10;             , prod_cd&#13;&#10;             , sal_amt                          as sal_amt       &#13;&#10;             , sal_amt_excl_tax                 as sal_amt_excl_tax      &#13;&#10;             , sal_qty                          as sal_qty    &#13;&#10;             , 0                                as fcst_sal_qty &#13;&#10;          from cl_logis.scm_bmart_prod_sal_dd_fact&#13;&#10;         where part_dt &gt;&gt;= &apos;2022-01-01&apos;&#13;&#10;     union all&#13;&#10;        select part_dt&#13;&#10;             , cntr_cd&#13;&#10;             , prod_cd&#13;&#10;             , 0                            as sal_amt        &#13;&#10;             , 0                            as sal_amt_excl_tax         &#13;&#10;             , 0                            as sal_qty      &#13;&#10;             , fcst_sal_qty                 as fcst_sal_qty&#13;&#10;          from cl_logis.scm_bmart_prod_fcst_sal_dd_info     &#13;&#10;         where part_dt &gt;&gt;= &apos;2022-01-01&apos;&#13;&#10;      ) t1&#13;&#10;join cl_common.date_master      d1 on t1.part_dt = d1.date_cd&#13;&#10;join cl_logis.cntr_dd_master       d2 on t1.part_dt = d2.part_dt and t1.cntr_cd = d2.cntr_cd&#13;&#10;join cl_logis.prod_dd_master      d3 on t1.part_dt = d3.part_dt and t1.prod_cd = d3.prod_cd&#13;&#10;join cl_logis.prod_cat_master     d4 on d3.cat_id = d4.cat_id&#13;&#10;where t1.part_dt &gt;&gt;= &apos;2022-01-01&apos;&#13;&#10;group by d1.year&#13;&#10;     , d1.month&#13;&#10;     , d1.day&#13;&#10;     , d1.week_seq&#13;&#10;     , t1.part_dt&#13;&#10;     , t1.cntr_cd&#13;&#10;     , d2.cntr_nm&#13;&#10;     , d2.cntr_lttd&#13;&#10;     , d2.cntr_lgtd&#13;&#10;     , d2.sido_nm&#13;&#10;     , d2.gugun_nm&#13;&#10;     , d2.dong_nm&#13;&#10;     -- , t1.prod_cd&#13;&#10;     -- , d3.prod_nm&#13;&#10;     , d3.cat_id&#13;&#10;     , d3.prod_sal_gd&#13;&#10;     , d4.cat1_nm&#13;&#10;     , d4.cat2_nm&#13;&#10;     , d4.cat3_nm&#13;&#10;     , d4.cat4_nm&#13;&#10;     , d1.holiday_yn&#13;&#10;     , d1.holiday_desc&#13;&#10;     , d1.weekday_nm</relation>
        </properties>
