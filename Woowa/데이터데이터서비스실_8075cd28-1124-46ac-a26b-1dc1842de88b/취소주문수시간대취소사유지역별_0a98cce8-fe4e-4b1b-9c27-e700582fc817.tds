  <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    <objects>
      <object caption='사용자 지정 SQL 쿼리' id='_0C272EFA40AF4693A6D83A1D40D22F15'>
        <properties context=''>
          <relation connection='athena.1cpsvyl1xk3jqa10csnd717e5kl0(복사본)(2 복사본)' name='사용자 지정 SQL 쿼리' type='text'>SELECT t1.part_date,&#13;
HOUR(t1.order_date + interval &apos;9&apos; hour) AS &quot;시간대&quot;,&#13;
case when t2.reason_cd_num = &apos;00&apos; then &apos;고객요청&apos;&#13;
when t2.reason_cd_num = &apos;01&apos; then &apos;배달불가지역&apos;&#13;
when t2.reason_cd_num IN (&apos;04&apos;,&apos;30&apos;) then &apos;배달지연&apos;&#13;
when t2.reason_cd_num = &apos;05&apos; then &apos;고객정보부정확&apos;&#13;
when t2.reason_cd_num IN (&apos;06&apos;,&apos;15&apos;,&apos;18&apos;,&apos;23&apos;,&apos;24&apos;,&apos;28&apos;,&apos;29&apos;) then &apos;업소사정&apos;&#13;
when t2.reason_cd_num IN (&apos;07&apos;,&apos;14&apos;) then &apos;고객요청&apos;&#13;
when t2.reason_cd_num IN (&apos;09&apos;,&apos;25&apos;) then &apos;배달불가&apos;&#13;
when t2.reason_cd_num IN (&apos;17&apos;,&apos;31&apos;) then &apos;고객직접취소&apos;&#13;
when t2.reason_cd_num = &apos;19&apos; then &apos;메뉴및업소정보다름&apos;&#13;
when t2.reason_cd_num IN (&apos;20&apos;,&apos;22&apos;,&apos;26&apos;) then &apos;재료소진&apos;&#13;
when t2.reason_cd_num = &apos;27&apos; then &apos;조리지연&apos;&#13;
when t2.reason_cd_num = &apos;32&apos; then &apos;기상악화&apos;&#13;
when t2.reason_cd_num IN (&apos;33&apos;,&apos;34&apos;) then &apos;시스템점검&apos;&#13;
when t2.reason_cd_num = &apos;35&apos; then &apos;셀러요청&apos;&#13;
when t2.reason_cd_num = &apos;36&apos; then &apos;부분취소&apos;&#13;
when t2.reason_cd_num = &apos;37&apos; then &apos;반품&apos;&#13;
END as reason_nm&#13;
,case when t2.reason_cd_num IN (&apos;00&apos;,&apos;07&apos;,&apos;14&apos;,&apos;17&apos;,&apos;31&apos;,&apos;36&apos;,&apos;37&apos;) then &apos;고객요청&apos;&#13;
when t2.reason_cd_num IN (&apos;01&apos;,&apos;04&apos;,&apos;30&apos;,&apos;09&apos;,&apos;25&apos;) then &apos;배달사유&apos;&#13;
when t2.reason_cd_num IN (&apos;05&apos;,&apos;19&apos;) then &apos;정보오류&apos;&#13;
when t2.reason_cd_num IN (&apos;06&apos;,&apos;15&apos;,&apos;18&apos;,&apos;23&apos;,&apos;24&apos;,&apos;28&apos;,&apos;29&apos;,&apos;20&apos;,&apos;22&apos;,&apos;26&apos;,&apos;27&apos;,&apos;35&apos;) then &apos;업소사정&apos;&#13;
when t2.reason_cd_num = &apos;32&apos; then &apos;기상상황&apos;&#13;
when t2.reason_cd_num IN (&apos;33&apos;,&apos;34&apos;) then &apos;시스템점검&apos;&#13;
END as reason_grp_nm&#13;
,t1.is_stod&#13;
		,t2.rgn_area_cat &#13;
	 , t3.rgn1_nm&#13;
     , t3.rgn2_nm&#13;
     , COUNT(DISTINCT CASE WHEN t1.order_status = &apos;CANCELLED&apos; THEN ord_no END) AS &quot;취소주문수&quot;&#13;
	 , COUNT(DISTINCT ord_no) AS &quot;시도주문수&quot;&#13;
&#13;
FROM   sborder_mart.order_master t1&#13;
       LEFT JOIN dsdw.dim_cancel_reason_cd t2&#13;
       ON t1.reason_code = t2.reason_cd_num&#13;
       AND t2.part_svc = &apos;BAEMIN&apos;&#13;
	   LEFT JOIN cl_epm.region_area_dim t2&#13;
       ON t1.rgn1_cd = t2.rgn1_cd&#13;
       LEFT JOIN sbbi.dim_rgn_cd t3&#13;
       ON t1.rgn3_cd = t3.rgn3_cd&#13;
       &#13;
WHERE  t1.part_date &gt;&gt;= cast(date_add(&apos;month&apos;, -2, date_trunc(&apos;month&apos;, current_date)) as varchar)&#13;
AND    t1.service_type = &apos;BAERA&apos;&#13;
AND    t1.delivery_type = &apos;DELIVERY&apos;&#13;
AND    t1.is_test = 0&#13;
GROUP BY 1,2,3,4,5,6,7,8</relation>
        </properties>
        <properties context='extract'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </properties>
      </object>
    </objects>
  </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
</datasource>
