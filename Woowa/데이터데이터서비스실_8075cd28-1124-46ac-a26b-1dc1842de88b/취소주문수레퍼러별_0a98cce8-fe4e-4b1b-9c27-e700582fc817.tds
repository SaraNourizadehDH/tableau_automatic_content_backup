    <relation connection='athena.1cpsvyl1xk3jqa10csnd717e5kl0(복사본)(복사본)(복사본)' name='사용자 지정 SQL 쿼리' type='text'>SELECT t1.part_date &#13;&#10;     , t2.reason_referrer &#13;&#10;     , CASE WHEN t2.reason_cd_num = &apos;00&apos; THEN &apos;고객요청&apos;&#13;&#10;            WHEN t2.reason_cd_num = &apos;01&apos; THEN &apos;배달불가지역&apos;&#13;&#10;            WHEN t2.reason_cd_num IN (&apos;04&apos;,&apos;30&apos;) THEN &apos;배달지연&apos;&#13;&#10;            WHEN t2.reason_cd_num = &apos;05&apos; THEN &apos;고객정보부정확&apos;&#13;&#10;            WHEN t2.reason_cd_num IN (&apos;06&apos;,&apos;15&apos;,&apos;18&apos;,&apos;23&apos;,&apos;24&apos;,&apos;28&apos;,&apos;29&apos;) THEN &apos;업소사정&apos;&#13;&#10;            WHEN t2.reason_cd_num IN (&apos;07&apos;,&apos;14&apos;) THEN &apos;고객요청&apos;&#13;&#10;            WHEN t2.reason_cd_num IN (&apos;09&apos;,&apos;25&apos;) THEN &apos;배달불가&apos;&#13;&#10;            WHEN t2.reason_cd_num IN (&apos;17&apos;,&apos;31&apos;) THEN &apos;고객직접취소&apos;&#13;&#10;            WHEN t2.reason_cd_num = &apos;19&apos; THEN &apos;메뉴및업소정보다름&apos;&#13;&#10;            WHEN t2.reason_cd_num IN (&apos;20&apos;,&apos;22&apos;,&apos;26&apos;) THEN &apos;재료소진&apos;&#13;&#10;            WHEN t2.reason_cd_num = &apos;27&apos; THEN &apos;조리지연&apos;&#13;&#10;            WHEN t2.reason_cd_num = &apos;32&apos; THEN &apos;기상악화&apos;&#13;&#10;            WHEN t2.reason_cd_num IN (&apos;33&apos;,&apos;34&apos;) THEN &apos;시스템점검&apos;&#13;&#10;            WHEN t2.reason_cd_num = &apos;35&apos; THEN &apos;셀러요청&apos;&#13;&#10;            WHEN t2.reason_cd_num = &apos;36&apos; THEN &apos;부분취소&apos;&#13;&#10;            WHEN t2.reason_cd_num = &apos;37&apos; THEN &apos;반품&apos; END AS reason_nm &#13;&#10;     , CASE WHEN t2.reason_cd_num IN (&apos;00&apos;,&apos;07&apos;,&apos;14&apos;,&apos;17&apos;,&apos;31&apos;,&apos;36&apos;,&apos;37&apos;) THEN &apos;고객요청&apos;&#13;&#10;            WHEN t2.reason_cd_num IN (&apos;01&apos;,&apos;04&apos;,&apos;30&apos;,&apos;09&apos;,&apos;25&apos;) THEN &apos;배달사유&apos;&#13;&#10;            WHEN t2.reason_cd_num IN (&apos;05&apos;,&apos;19&apos;) THEN &apos;정보오류&apos;&#13;&#10;            WHEN t2.reason_cd_num IN (&apos;06&apos;,&apos;15&apos;,&apos;18&apos;,&apos;23&apos;,&apos;24&apos;,&apos;28&apos;,&apos;29&apos;,&apos;20&apos;,&apos;22&apos;,&apos;26&apos;,&apos;27&apos;,&apos;35&apos;) THEN &apos;업소사정&apos;&#13;&#10;            WHEN t2.reason_cd_num = &apos;32&apos; THEN &apos;기상상황&apos;&#13;&#10;            WHEN t2.reason_cd_num IN (&apos;33&apos;,&apos;34&apos;) THEN &apos;시스템점검&apos; END AS reason_grp_nm &#13;&#10;     , t1.is_stod &#13;&#10;     , t2.rgn_area_cat &#13;&#10;     , t3.rgn1_nm &#13;&#10;     , t3.rgn2_nm &#13;&#10;     , COUNT(DISTINCT ord_no) AS &quot;취소주문수&quot;&#13;&#10;FROM   sborder_mart.order_master t1&#13;&#10;       LEFT JOIN dsdw.dim_cancel_reason_cd t2&#13;&#10;       ON t1.reason_code = t2.reason_cd_num&#13;&#10;       AND t2.part_svc = &apos;BAEMIN&apos;&#13;&#10;       LEFT JOIN cl_epm.region_area_dim t2&#13;&#10;       ON t1.rgn1_cd = t2.rgn1_cd&#13;&#10;       LEFT JOIN sbbi.dim_rgn_cd t3&#13;&#10;       ON t1.rgn3_cd = t3.rgn3_cd&#13;&#10;WHERE  t1.part_date &gt;&gt;= CAST(DATE_ADD(&apos;month&apos;, -2, DATE_TRUNC(&apos;month&apos;, CURRENT_DATE)) AS VARCHAR)&#13;&#10;AND    t1.service_type = &apos;BAERA&apos;&#13;&#10;AND    t1.delivery_type = &apos;DELIVERY&apos;&#13;&#10;AND    t1.order_status = &apos;CANCELLED&apos;&#13;&#10;AND    t1.is_test = 0&#13;&#10;GROUP BY 1, 2, 3, 4, 5, 6, 7, 8</relation>
