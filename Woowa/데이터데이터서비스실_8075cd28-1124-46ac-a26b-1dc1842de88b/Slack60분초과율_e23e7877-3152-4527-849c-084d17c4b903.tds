    <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='athena.14rbz5g1rv7lq01a93x7n05642f5' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[WITH
  svc_dlvrytype_dim
    AS (
    SELECT *
    FROM  (
          VALUES
          ('bm1_cm', 'FDOD', 'COMMON'),
          ('bm1_sg', 'FDOD', 'SINGLE'),
          ('bmt_cm', 'CMBM', 'COMMON'),
          ('bmt_sg', 'CMBM', 'SINGLE'),
          ('bms_cm', 'CMBS', 'COMMON'),
          ('bms_sg', 'CMBS', 'SINGLE')                
          ) AS t (svc_origin, svc_cd, od_dlvry_type_cd) 
    ),

  dlv_thres
    AS (
    SELECT pickup_rgn2_nm
         , AVG(cnt_dlv) AS cnt_dlv
    FROM  (
            SELECT t1.part_date
                 , t1.pickup_rgn2_nm
                 , SUM(t1.cnt_dlv) AS cnt_dlv
            FROM   deliverydata.strategy_base_agg_daily t1
                   LEFT OUTER JOIN svc_dlvrytype_dim t2 ON t1.svc = t2.svc_origin    
            WHERE  t1.part_date >>= CAST(DATE_TRUNC('week', DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') - interval '2' day) AS VARCHAR)
            AND    t1.part_date  << CAST(DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') AS VARCHAR)    
            GROUP BY t1.part_date, t1.pickup_rgn2_nm
           )
    GROUP BY pickup_rgn2_nm
    HAVING AVG(cnt_dlv) >>= 700           
    ),

  avg_value_by_rgn 
    AS (
    SELECT CAST(DATE_TRUNC('week', DATE(t1.part_date)) AS VARCHAR) AS part_date
         , COALESCE(t1.pickup_rgn2_nm,   '전체')                   AS pickup_rgn2_nm
         , COALESCE(t2.od_dlvry_type_cd, '전체')                   AS od_dlvry_type_cd
         , 1e0 * SUM(t1.dlv_time_over_60min) / NULLIF(SUM(t1.cnt_dlv), 0) AS value
    FROM   deliverydata.strategy_base_agg_daily t1
           LEFT OUTER JOIN svc_dlvrytype_dim t2 ON t1.svc = t2.svc_origin
    WHERE t1.part_date >>= CAST(DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') - interval '105' day AS VARCHAR)
    AND   t1.part_date <<  CAST(DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') AS VARCHAR)
    AND   t2.svc_cd = 'FDOD'
    GROUP BY 1, ROLLUP(t2.od_dlvry_type_cd, t1.pickup_rgn2_nm)
    ),

  ranked_rgn 
    AS (
    SELECT t1.*
         , ROW_NUMBER() OVER (PARTITION BY t1.od_dlvry_type_cd ORDER BY t1.value ASC)  AS top_rn
         , ROW_NUMBER() OVER (PARTITION BY t1.od_dlvry_type_cd ORDER BY t1.value DESC) AS bottom_rn
    FROM   avg_value_by_rgn t1
           INNER JOIN dlv_thres t3 ON t1.pickup_rgn2_nm = t3.pickup_rgn2_nm
    WHERE  t1.pickup_rgn2_nm != '전체' 
    AND    t1.od_dlvry_type_cd != '전체'
    AND    t1.part_date >>= CAST(DATE_TRUNC('week', DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') - interval '2' day) AS VARCHAR)
    AND    t1.part_date  << CAST(DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') AS VARCHAR)
    ),
    
  top5_rgn 
    AS (
    SELECT od_dlvry_type_cd, pickup_rgn2_nm, value
    FROM ranked_rgn
    WHERE top_rn <<= 5
    ),

  bottom5_rgn 
    AS (
    SELECT od_dlvry_type_cd, pickup_rgn2_nm, value
    FROM ranked_rgn
    WHERE bottom_rn <<= 5
    ),

  daily_base 
    AS (
    SELECT t1.part_date
         , 'TOP5' AS category
         , t1.od_dlvry_type_cd
         , t1.pickup_rgn2_nm
         , t1.value AS value
    FROM   avg_value_by_rgn t1 
           JOIN top5_rgn t2 ON t1.pickup_rgn2_nm = t2.pickup_rgn2_nm AND t1.od_dlvry_type_cd = t2.od_dlvry_type_cd

    UNION ALL
    SELECT t1.part_date
         , 'BOTTOM5' AS category
         , t1.od_dlvry_type_cd
         , t1.pickup_rgn2_nm
         , t1.value AS value
    FROM   avg_value_by_rgn t1 
           JOIN bottom5_rgn t2 ON t1.pickup_rgn2_nm = t2.pickup_rgn2_nm AND t1.od_dlvry_type_cd = t2.od_dlvry_type_cd
    
    UNION ALL
    SELECT t1.part_date
         , '전체' AS category
         , t1.od_dlvry_type_cd
         , t1.pickup_rgn2_nm
         , t1.value AS value
    FROM   avg_value_by_rgn t1
    WHERE  pickup_rgn2_nm = '전체' OR od_dlvry_type_cd = '전체'
    )
    
SELECT *
FROM daily_base
WHERE category != '기타']]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
    <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='athena.14rbz5g1rv7lq01a93x7n05642f5' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[WITH
  svc_dlvrytype_dim
    AS (
    SELECT *
    FROM  (
          VALUES
          ('bm1_cm', 'FDOD', 'COMMON'),
          ('bm1_sg', 'FDOD', 'SINGLE'),
          ('bmt_cm', 'CMBM', 'COMMON'),
          ('bmt_sg', 'CMBM', 'SINGLE'),
          ('bms_cm', 'CMBS', 'COMMON'),
          ('bms_sg', 'CMBS', 'SINGLE')                
          ) AS t (svc_origin, svc_cd, od_dlvry_type_cd) 
    ),

  dlv_thres
    AS (
    SELECT pickup_rgn2_nm
         , AVG(cnt_dlv) AS cnt_dlv
    FROM  (
            SELECT t1.part_date
                 , t1.pickup_rgn2_nm
                 , SUM(t1.cnt_dlv) AS cnt_dlv
            FROM   deliverydata.strategy_base_agg_daily t1
                   LEFT OUTER JOIN svc_dlvrytype_dim t2 ON t1.svc = t2.svc_origin    
            WHERE  t1.part_date >>= CAST(DATE_TRUNC('week', DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') - interval '2' day) AS VARCHAR)
            AND    t1.part_date  << CAST(DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') AS VARCHAR)    
            GROUP BY t1.part_date, t1.pickup_rgn2_nm
           )
    GROUP BY pickup_rgn2_nm
    HAVING AVG(cnt_dlv) >>= 700           
    ),

  avg_value_by_rgn 
    AS (
    SELECT CAST(DATE_TRUNC('week', DATE(t1.part_date)) AS VARCHAR) AS part_date
         , COALESCE(t1.pickup_rgn2_nm,   '전체')                   AS pickup_rgn2_nm
         , COALESCE(t2.od_dlvry_type_cd, '전체')                   AS od_dlvry_type_cd
         , 1e0 * SUM(t1.dlv_time_over_60min) / NULLIF(SUM(t1.cnt_dlv), 0) AS value
    FROM   deliverydata.strategy_base_agg_daily t1
           LEFT OUTER JOIN svc_dlvrytype_dim t2 ON t1.svc = t2.svc_origin
    WHERE t1.part_date >>= CAST(DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') - interval '105' day AS VARCHAR)
    AND   t1.part_date <<  CAST(DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') AS VARCHAR)
    AND   t2.svc_cd = 'FDOD'
    GROUP BY 1, ROLLUP(t2.od_dlvry_type_cd, t1.pickup_rgn2_nm)
    ),

  ranked_rgn 
    AS (
    SELECT t1.*
         , ROW_NUMBER() OVER (PARTITION BY t1.od_dlvry_type_cd ORDER BY t1.value ASC)  AS top_rn
         , ROW_NUMBER() OVER (PARTITION BY t1.od_dlvry_type_cd ORDER BY t1.value DESC) AS bottom_rn
    FROM   avg_value_by_rgn t1
           INNER JOIN dlv_thres t3 ON t1.pickup_rgn2_nm = t3.pickup_rgn2_nm
    WHERE  t1.pickup_rgn2_nm != '전체' 
    AND    t1.od_dlvry_type_cd != '전체'
    AND    t1.part_date >>= CAST(DATE_TRUNC('week', DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') - interval '2' day) AS VARCHAR)
    AND    t1.part_date  << CAST(DATE((current_timestamp AT TIME ZONE 'UTC') AT TIME ZONE 'Asia/Seoul') AS VARCHAR)
    ),
    
  top5_rgn 
    AS (
    SELECT od_dlvry_type_cd, pickup_rgn2_nm, value
    FROM ranked_rgn
    WHERE top_rn <<= 5
    ),

  bottom5_rgn 
    AS (
    SELECT od_dlvry_type_cd, pickup_rgn2_nm, value
    FROM ranked_rgn
    WHERE bottom_rn <<= 5
    ),

  daily_base 
    AS (
    SELECT t1.part_date
         , 'TOP5' AS category
         , t1.od_dlvry_type_cd
         , t1.pickup_rgn2_nm
         , t1.value AS value
    FROM   avg_value_by_rgn t1 
           JOIN top5_rgn t2 ON t1.pickup_rgn2_nm = t2.pickup_rgn2_nm AND t1.od_dlvry_type_cd = t2.od_dlvry_type_cd

    UNION ALL
    SELECT t1.part_date
         , 'BOTTOM5' AS category
         , t1.od_dlvry_type_cd
         , t1.pickup_rgn2_nm
         , t1.value AS value
    FROM   avg_value_by_rgn t1 
           JOIN bottom5_rgn t2 ON t1.pickup_rgn2_nm = t2.pickup_rgn2_nm AND t1.od_dlvry_type_cd = t2.od_dlvry_type_cd
    
    UNION ALL
    SELECT t1.part_date
         , '전체' AS category
         , t1.od_dlvry_type_cd
         , t1.pickup_rgn2_nm
         , t1.value AS value
    FROM   avg_value_by_rgn t1
    WHERE  pickup_rgn2_nm = '전체' OR od_dlvry_type_cd = '전체'
    )
    
SELECT *
FROM daily_base
WHERE category != '기타']]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
