      <column caption='(계산)구매자당 구매횟수' datatype='integer' name='[Calculation_1011058159393701888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [buyer]:COUNT([giftcard_number])}' />
      </column>
      <column caption='(계산)구매자당 수신자' datatype='integer' name='[Calculation_1011058159393865729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [buyer]: COUNTD([owner])}' />
      </column>
      <column caption='선물여부' datatype='string' name='[Calculation_1011058159397560322]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([buyer]=[owner],&apos;자기구매&apos;,&apos;선물&apos;)' />
      </column>
      <column caption='(계산)first_order_date' datatype='date' name='[Calculation_1158832522091515910]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date([first_ord_date])' />
      </column>
      <column caption='(계산)첫구매' datatype='string' name='[Calculation_1158832522092470279]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([date_cd]=[Calculation_1158832522091515910],&quot;NEW&quot;,&quot;-&quot;)' />
      </column>
      <column caption='(계산)브랜드명' datatype='real' name='[Calculation_1158832522118955021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [brand]=2 THEN &apos;뚜레쥬르&apos;&#13;&#10;ELSE END' />
      </column>
      <column caption='(계산)RANK판매액' datatype='integer' name='[Calculation_1158832522144780303]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(sum([g_face_value]),&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='발행액' datatype='integer' name='[Calculation_839921368157859841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([g_face_value])-SUM([sqlproxy.1ichz4a09v02fr1cmxrva0m58o7t].[g_face_value])' />
      </column>
      <column caption='(계산)사용자수' datatype='integer' name='[Calculation_839921368190681090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([owner])' />
      </column>
      <column caption='구매자수' datatype='integer' name='[Calculation_839921368190832643]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([buyer])' />
      </column>
      <column caption='(계산)last_ord_date' datatype='date' name='[Calculation_839921368231391246]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [buyer]:MAX([date_cd])}' />
      </column>
      <column caption='(계산)repeat purchace' datatype='date' name='[Calculation_839921368231583759]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IIF([date_cd]&gt;[Calculation_1158832522091515910],[date_cd],null)' />
      </column>
      <column caption='(계산)first_repeat_purchase' datatype='date' name='[Calculation_839921368232943632]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [buyer]:min([Calculation_839921368231583759])}' />
      </column>
      <column caption='(계산)month to repeat purchase' datatype='integer' name='[Calculation_839921368233193489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[Calculation_839921368243023892],[Calculation_839921368231391246],&apos;monday&apos;)' />
      </column>
      <column caption='(계산)before_purchase' datatype='date' name='[Calculation_839921368243023892]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='iif([Calculation_839921368231391246]&gt;[date_cd],[date_cd],NULL,NULL)' />
      </column>
      <column caption='(계산)판매량' datatype='integer' name='[Calculation_839921368284393496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd([giftcard_number])' />
      </column>
      <column aggregation='Sum' caption='(계산)금액권' datatype='integer' name='[Calculation_839921368284672025]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [giftcard_number]:sum([g_face_value])}' />
      </column>
      <column caption='(계산)카드종수' datatype='integer' name='[Calculation_839921368285384731]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([card_id])' />
      </column>
