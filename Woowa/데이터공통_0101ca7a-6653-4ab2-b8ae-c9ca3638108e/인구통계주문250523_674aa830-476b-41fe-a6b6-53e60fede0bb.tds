  <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
  <semantic-values>
    <semantic-value key='[Country].[Name]' value='&quot;대한민국&quot;' />
  </semantic-values>
  <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    <objects>
      <object caption='사용자 지정 SQL 쿼리' id='_C92C2C43653F471BAFCF776FF617DD73'>
        <properties context=''>
          <relation connection='athena.0wkollo0adyoil0zineqv1ba3jsf(복사본)(복사본)(복사본)(복사본)(복사본)' name='사용자 지정 SQL 쿼리' type='text'><![CDATA[WITH   
  member_info AS (
    SELECT 
        mem_no,
        CASE 
            WHEN age << 10 THEN '10세미만'
            WHEN age << 15 THEN '10-14'
            WHEN age << 20 THEN '15-19'
            WHEN age << 25 THEN '20-24'
            WHEN age << 30 THEN '25-29'
            WHEN age << 35 THEN '30-34'
            WHEN age << 40 THEN '35-39'
            WHEN age << 45 THEN '40-44'
            WHEN age << 50 THEN '45-49'
            WHEN age << 55 THEN '50-54'
            WHEN age << 60 THEN '55-59'
            ELSE '60세이상'
        END AS age_group,
        SUBSTR(gender, 1, 1) AS gender
    FROM dsdw.member_master
    WHERE age IS NOT NULL
  ),

  ord_base AS (
    SELECT 
        month_dt,
        svc_cd,
        shop_category,
        auth.gender,
        auth.age_group,
        ord_no,
        dvc_id,
        ALL.mem_no,
        ord_price
    FROM analytics.fact_order_all_svc_tableau ALL
    JOIN member_info auth 
    ON ALL.mem_no = auth.mem_no
    WHERE month_dt >>= CAST(DATE_ADD('month', -2, DATE_TRUNC('month', CURRENT_DATE)) AS VARCHAR)
    AND month_dt << CAST(DATE_ADD('month', -0, DATE_TRUNC('month', CURRENT_DATE)) AS VARCHAR)
  ),

  ord AS (
    SELECT 
        month_dt,
        svc_cd,
        'ALL' AS shop_category,
        gender,
        age_group,
        COUNT(DISTINCT ord_no) AS ord_cnt,
        COUNT(DISTINCT dvc_id) AS dvc_cnt,
        COUNT(DISTINCT mem_no) AS mem_cnt,
        SUM(CAST(ord_price AS INT)) AS sum_ord_price
    FROM ord_base
    GROUP BY month_dt, svc_cd, gender, age_group

    UNION ALL

    SELECT 
        month_dt,
        svc_cd,
        shop_category,
        gender,
        age_group,
        COUNT(DISTINCT ord_no) AS ord_cnt,
        COUNT(DISTINCT dvc_id) AS dvc_cnt,
        COUNT(DISTINCT mem_no) AS mem_cnt,
        SUM(CAST(ord_price AS INT)) AS sum_ord_price
    FROM ord_base
    WHERE svc_cd IN ('BAEMIN', 'BAERA', 'TAKEOUT')
    GROUP BY month_dt, svc_cd, shop_category, gender, age_group
  )

SELECT *
FROM ord]]></relation>
        </properties>
        <properties context='extract'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </properties>
      </object>
    </objects>
  </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
</datasource>
