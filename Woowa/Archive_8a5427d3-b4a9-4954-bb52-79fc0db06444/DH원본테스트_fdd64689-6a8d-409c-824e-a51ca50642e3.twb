    <datasource caption='사용자 지정 SQL 쿼리(cl_logis)_윤상DH테스트' inline='true' name='federated.199d2p31xh3duh1c3qox11tzcm6b' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0dujwi91jefs6r112c12w1nu4j78'>
            <connection CATALOG='dataservice-poc' EXECCATALOG='dataservice-poc' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='DataService-PoC' schema='cl_logis' server-oauth='' username='petrucci@woowahan.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0dujwi91jefs6r112c12w1nu4j78' name='사용자 지정 SQL 쿼리' type='text'>select 
      t1.base_dt
     , t1.cntr_cd
     , d2.cntr_nm
     , d2.cntr_lttd
     , d2.cntr_lgtd
     , d2.sido_nm
     , d2.gugun_nm
     , d2.dong_nm
     , t1.cat_id
     , d4.cat1_nm 
     , d4.cat2_nm
     , d4.cat3_nm
     , d4.cat4_nm
     , coalesce(case when d3.prod_sal_gd in (&apos;A&apos;,&apos;B&apos;,&apos;C&apos;,&apos;D&apos;,&apos;N&apos;,&apos;S&apos;,&apos;Z&apos;) then d3.prod_sal_gd end,&apos;&apos;) as prod_sal_gd
     , t1.base_tz
     , count(*)                          as fc_prod_cnt   --FC 운영상품수
     , sum(lack_yn)                      as fc_lack_cnt   --FC 결품상품수
     , sum(lack_yn) * 1.000 / count(*)   as fc_lack_accr  --FC 결품률
from dataservice-poc.cl_logis.scm_bmart_fc_lack_hh_fact t1
--join marketfulfillment.s3_missing_rate_at_17  t3 on t1.part_dt = t3.target_date
join dataservice-poc.cl_logis.cntr_dd_master  d2 on t1.base_dt = d2.base_dt and t1.cntr_cd = d2.cntr_cd
join dataservice-poc.cl_logis.prod_dd_master  d3 on t1.base_dt = d3.base_dt and t1.prod_cd = d3.prod_cd
join dataservice-poc.cl_logis.prod_cat_master d4 on t1.cat_id = d4.cat_id
where DATE(t1._PARTITIONTIME) &gt;&gt;= &quot;2023-02-01&quot; 
  and DATE(d2._PARTITIONTIME) &gt;&gt;= &quot;2023-02-01&quot; 
  and DATE(d3._PARTITIONTIME) &gt;&gt;= &quot;2023-02-01&quot; 
  and t1.base_dt between &apos;2023-04-25&apos; and &apos;2023-05-03&apos;
  and t1.prod_stts = &apos;ON_SALE&apos;
  and t1.prod_hndl_yn = 1
  and t1.prod_dspl_yn = 1
  and t1.base_tz in (&apos;09&apos;,&apos;13&apos;,&apos;17&apos;,&apos;18&apos;,&apos;19&apos;,&apos;20&apos;,&apos;21&apos;,&apos;22&apos;,&apos;24&apos;)
group by t1.base_dt
     , t1.cntr_cd
     , d2.cntr_nm
     , d2.cntr_lttd
     , d2.cntr_lgtd
     , d2.sido_nm
     , d2.gugun_nm
     , d2.dong_nm
     , t1.cat_id
     , d4.cat1_nm
     , d4.cat2_nm
     , d4.cat3_nm
     , d4.cat4_nm
     , d3.prod_sal_gd
     , t1.base_tz</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0dujwi91jefs6r112c12w1nu4j78' name='사용자 지정 SQL 쿼리' type='text'>select 
      t1.base_dt
     , t1.cntr_cd
     , d2.cntr_nm
     , d2.cntr_lttd
     , d2.cntr_lgtd
     , d2.sido_nm
     , d2.gugun_nm
     , d2.dong_nm
     , t1.cat_id
     , d4.cat1_nm 
     , d4.cat2_nm
     , d4.cat3_nm
     , d4.cat4_nm
     , coalesce(case when d3.prod_sal_gd in (&apos;A&apos;,&apos;B&apos;,&apos;C&apos;,&apos;D&apos;,&apos;N&apos;,&apos;S&apos;,&apos;Z&apos;) then d3.prod_sal_gd end,&apos;&apos;) as prod_sal_gd
     , t1.base_tz
     , count(*)                          as fc_prod_cnt   --FC 운영상품수
     , sum(lack_yn)                      as fc_lack_cnt   --FC 결품상품수
     , sum(lack_yn) * 1.000 / count(*)   as fc_lack_accr  --FC 결품률
from dataservice-poc.cl_logis.scm_bmart_fc_lack_hh_fact t1
--join marketfulfillment.s3_missing_rate_at_17  t3 on t1.part_dt = t3.target_date
join dataservice-poc.cl_logis.cntr_dd_master  d2 on t1.base_dt = d2.base_dt and t1.cntr_cd = d2.cntr_cd
join dataservice-poc.cl_logis.prod_dd_master  d3 on t1.base_dt = d3.base_dt and t1.prod_cd = d3.prod_cd
join dataservice-poc.cl_logis.prod_cat_master d4 on t1.cat_id = d4.cat_id
where DATE(t1._PARTITIONTIME) &gt;&gt;= &quot;2023-02-01&quot; 
  and DATE(d2._PARTITIONTIME) &gt;&gt;= &quot;2023-02-01&quot; 
  and DATE(d3._PARTITIONTIME) &gt;&gt;= &quot;2023-02-01&quot; 
  and t1.base_dt between &apos;2023-04-25&apos; and &apos;2023-05-03&apos;
  and t1.prod_stts = &apos;ON_SALE&apos;
  and t1.prod_hndl_yn = 1
  and t1.prod_dspl_yn = 1
  and t1.base_tz in (&apos;09&apos;,&apos;13&apos;,&apos;17&apos;,&apos;18&apos;,&apos;19&apos;,&apos;20&apos;,&apos;21&apos;,&apos;22&apos;,&apos;24&apos;)
group by t1.base_dt
     , t1.cntr_cd
     , d2.cntr_nm
     , d2.cntr_lttd
     , d2.cntr_lgtd
     , d2.sido_nm
     , d2.gugun_nm
     , d2.dong_nm
     , t1.cat_id
     , d4.cat1_nm
     , d4.cat2_nm
     , d4.cat3_nm
     , d4.cat4_nm
     , d3.prod_sal_gd
     , t1.base_tz</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
