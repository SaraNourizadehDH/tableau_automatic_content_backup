      </extract>
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;대한민국&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='사용자 지정 SQL 쿼리' id='_A4916C7F285242ABA409A7E3EBD98D91'>
            <properties context=''>
              <relation connection='athena.0cagv4a0kudg5t11wxed10czv925' name='사용자 지정 SQL 쿼리' type='text'>WITH dlvry_agency_info AS -- 배대사 중계 DB
(
  SELECT
         auth_id
        ,order_no
        ,max(modified_at) AS complete_time
    FROM relaydlvry.orders
   WHERE part_date &gt;&gt;= cast(current_date - interval &apos;760&apos; day as varchar)
     AND last_delivery_status = &apos;DELIVERY_COMPLETED&apos;
   GROUP BY 1,2
)
,ord_base AS
(
  SELECT
         a.part_date
        ,a.order_date
        ,CASE WHEN b.order_no IS NULL THEN &apos;가게배달&apos; ELSE &apos;배대사배달&apos; END AS dlvry_agency_type
        ,b.complete_time
        ,a.notified_time_minutes
    FROM sborder_mart.order_master a
    LEFT JOIN dlvry_agency_info b
           ON a.ord_no = b.order_no
   WHERE 1=1
     AND a.part_date &gt;&gt;= cast(current_date - interval &apos;760&apos; day as varchar)
     AND a.service_type = &apos;BAEMIN&apos;
     AND a.delivery_type = &apos;DELIVERY&apos;
     AND a.is_test = 0
     AND a.is_closed = 1
)

  SELECT
         weekstart_dt AS std_dt
        ,&apos;W&apos; AS std_cd
        ,dlvry_agency_type
        ,CAST(AVG(DATE_DIFF(&apos;SECOND&apos;,order_date,complete_time)) AS DOUBLE) / 60  AS dlvry_time
        ,avg(notified_time_minutes) AS noti_time
    FROM ord_base a
    JOIN sbbi.dim_date_cd b
      ON a.part_date = b.date_Cd
   WHERE part_date &gt;&gt;= (select cast(weekstart_dt as varchar) from sbbi.dim_date_cd where date_cd = cast(current_date - interval &apos;731&apos; day as varchar))
   GROUP BY 1,3

   UNION ALL
  SELECT
         monthstart_dt AS std_dt
        ,&apos;M&apos; AS std_cd
        ,dlvry_agency_type
        ,CAST(AVG(DATE_DIFF(&apos;SECOND&apos;,order_date,complete_time)) AS DOUBLE) / 60  AS dlvry_time
        ,avg(notified_time_minutes) AS noti_time
    FROM ord_base a
    JOIN sbbi.dim_date_cd b
      ON a.part_date = b.date_Cd
   WHERE part_date &gt;&gt;= (select cast(monthstart_dt as varchar) from sbbi.dim_date_cd where date_cd = cast(current_date - interval &apos;731&apos; day as varchar))
   GROUP BY 1,3</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
