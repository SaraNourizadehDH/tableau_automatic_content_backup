            <column caption='c_button' datatype='string' name='[Calculation_821625503114539009]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [std_cd]&#13;&#10;when  &apos;D&apos; then &apos;일별&apos;&#13;&#10;when &apos;W&apos; then &apos;주별&apos;&#13;&#10;when &apos;M&apos; then &apos;월별&apos;&#13;&#10;END' />
            </column>
            <column caption='Date_Text_Label_NEW_Member' datatype='string' name='[Date_Text_Label_NEW (copy)_2063211643068731419]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Calculation_821625503114539009]&#13;&#10;when &apos;일별&apos;&#13;&#10;then if len(str(DATEPART(&apos;month&apos;,[Parameters].[매개 변수 2]))) = 1&#13;&#10;     then MID(STR([Parameters].[매개 변수 2]),7,1)+&quot;월 &quot;&#13;&#10;&#13;&#10;     else MID(STR([Parameters].[매개 변수 2]),6,2)+&quot;월 &quot;&#13;&#10;     end&#13;&#10;     +&#13;&#10;     if len(str(DATEPART(&apos;day&apos;,[Parameters].[매개 변수 2]))) = 1&#13;&#10;     then MID(STR([Parameters].[매개 변수 2]),10,1)+&quot;일&quot;&#13;&#10;&#13;&#10;     else MID(STR([Parameters].[매개 변수 2]),9,2)+&quot;일&quot;&#13;&#10;     end&#13;&#10;     &#13;&#10;when &apos;주별&apos;&#13;&#10;then [week_nm]&#13;&#10;when &apos;월별&apos;&#13;&#10;then  &#13;&#10;IF len(str(DATEPART(&apos;month&apos;,[Parameters].[매개 변수 2]))) = 2&#13;&#10;then MID(STR([Parameters].[매개 변수 2]),3,2)+&quot;년 &quot;+MID(STR([Parameters].[매개 변수 2]),6,2) + &apos;월&apos;&#13;&#10;ELSE MID(STR([Parameters].[매개 변수 2]),3,2)+&quot;년 &quot;+MID(STR([Parameters].[매개 변수 2]),7,1) + &apos;월&apos;&#13;&#10;&#13;&#10;END&#13;&#10;END' />
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[base_dt]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column-instance column='[Calculation_190277139104415759]' derivation='None' name='[none:Calculation_190277139104415759:nk]' pivot='key' type='nominal' />
            <column-instance column='[Date_Text_Label_NEW (copy)_2063211643068731419]' derivation='None' name='[none:Date_Text_Label_NEW (copy)_2063211643068731419:nk]' pivot='key' type='nominal' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[std_cd]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[week_nm]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
          </datasource-dependencies>
