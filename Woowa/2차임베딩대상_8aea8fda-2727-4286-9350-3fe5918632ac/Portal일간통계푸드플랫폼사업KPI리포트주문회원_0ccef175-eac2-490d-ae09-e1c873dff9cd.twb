              <calculation class='tableau' formula='CASE [Parameters].[매개 변수 3]&#13;&#10;&#13;&#10;WHEN &apos;주별&apos;&#13;&#10;THEN &#13;&#10;[std_cd] = &apos;W&apos; &#13;&#10;AND DATETRUNC(&apos;iso-week&apos;,[Calculation_488922077102366723]) &lt;= DATETRUNC(&apos;iso-week&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;iso-week&apos;, [Calculation_488922077102366723]) &gt;= DATETRUNC(&apos;iso-week&apos;, DATEADD(&apos;iso-week&apos;, -11,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;WHEN &apos;월별&apos;&#13;&#10;THEN [std_cd] = &apos;M&apos;&#13;&#10;AND DATETRUNC(&apos;month&apos;,[Calculation_488922077102366723]) &lt;= DATETRUNC(&apos;month&apos;, [Parameters].[매개 변수 2])  &#13;&#10;AND DATETRUNC(&apos;month&apos;, [Calculation_488922077102366723]) &gt;= DATETRUNC(&apos;month&apos;, DATEADD(&apos;month&apos;, -12,[Parameters].[매개 변수 2]))&#13;&#10;&#13;&#10;END' />
            </column>
