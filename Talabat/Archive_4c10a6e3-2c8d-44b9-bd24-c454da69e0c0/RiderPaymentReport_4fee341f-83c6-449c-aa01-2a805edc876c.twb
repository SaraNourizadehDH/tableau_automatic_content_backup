    <worksheet name='info included failed order payment categories'>
      <table>
        <view>
          <datasources>
            <datasource caption='fct_logistics_payment_delivery_shift_mapping (data_platform_logistics)' name='federated.0plgb561g2ujg613vvgdg1vyopl6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Use BOA status for Talabat orders' datatype='boolean' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0plgb561g2ujg613vvgdg1vyopl6'>
            <column caption='Is Successful' datatype='boolean' name='[Calculation_2724466718059667456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 3]&#10;&#10;when True then [delivery_status]=&apos;completed&apos; and IFNULL([boa_is_successful], [order_status]=&apos;completed&apos;)&#10;&#10;when False then [delivery_status]=&apos;completed&apos; and [order_status]=&apos;completed&apos;&#10;&#10;end' />
            </column>
            <column caption='Included Failed order payments by Payment Categories' datatype='string' name='[Calculation_2724466718068285441]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if not [Calculation_2724466718059667456] then [payment_category] end' />
            </column>
            <column caption='null' datatype='boolean' name='[Calculation_3196429842039885825]' role='dimension' type='nominal' user:unnamed='Sheet 13'>
              <calculation class='tableau' formula='null' />
            </column>
            <column caption='Multiple Contracts Paid ' datatype='boolean' name='[Calculation_676243638540058641]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='contracts_paid_count&gt;1' />
            </column>
            <column caption='Unpaid Delivery Flag' datatype='boolean' name='[Calculation_676243638540611603]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(not [payment_record_count]&gt;0 and [delivery_status]=&apos;completed&apos; and [order_status]=&apos;completed&apos;&#10;and (not [Parameters].[Parameter 3] or IFNULL([boa_is_successful],TRUE))&#10;&#10;and not [is_returning] )' />
            </column>
            <column caption='Contract Unpaid Delivery Flag' datatype='boolean' name='[Calculation_676243638540914708]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[hidden_payment_record_count]=0 and [delivery_related] and [payment_record_count]&gt;0 and not [Calculation_676243638540611603] and [order_status]=&apos;completed&apos; and [delivery_status]=&apos;completed&apos;' />
            </column>
            <column caption='exclude yesterday' datatype='boolean' name='[Calculation_676243638564614170]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_date]&lt;DATEADD(&apos;day&apos;,0,TODAY())' />
            </column>
            <column caption='Included Failed order payments by Payment Rule Sub Type' datatype='string' name='[Failed order payment category (copy)_3035285470656765952]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if not [Calculation_2724466718059667456] then [rule_sub_type] end' />
            </column>
            <column caption='Included Failed Dropoffs payments by Payment Categories' datatype='string' name='[Included Failed Pickups payments by Payment Categories (copy)_5160984484694597632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if not [Is Pickup Successful (copy)_5305944097105797124] and [rule_sub_type]=&quot;COMPLETED_DELIVERIES&quot; then [payment_category] end' />
            </column>
            <column caption='Included Failed Pickups payments by Payment Categories' datatype='string' name='[Included Failed order payments by Payment Categories (copy)_5305944097697746949]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if not [Is Successful (copy)_5305944096310714369] and [rule_sub_type]=&quot;PICKEDUP_DELIVERIES&quot; then [payment_category] end' />
            </column>
            <column caption='Is Dropoff Successful' datatype='boolean' name='[Is Pickup Successful (copy)_5305944097105797124]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [dropoff_id]: max(&#10;case [Parameters].[Parameter 3]&#10;&#10;when True then [delivery_status]=&apos;completed&apos; and IFNULL([boa_is_successful], [order_status]=&apos;completed&apos;)&#10;&#10;when False then [delivery_status]=&apos;completed&apos; and [order_status]=&apos;completed&apos;&#10;&#10;end )}' />
            </column>
            <column caption='Is Pickup Successful' datatype='boolean' name='[Is Successful (copy)_5305944096310714369]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [pickup_id]: max(&#10;case [Parameters].[Parameter 3]&#10;&#10;when True then [delivery_status]=&apos;completed&apos; and IFNULL([boa_is_successful], [order_status]=&apos;completed&apos;)&#10;&#10;when False then [delivery_status]=&apos;completed&apos; and [order_status]=&apos;completed&apos;&#10;&#10;end )}' />
            </column>
            <column caption='Boa Fail Reason' datatype='string' name='[boa_fail_reason]' role='dimension' type='nominal' />
            <column caption='Boa Fail Sub Reason' datatype='string' name='[boa_fail_sub_reason]' role='dimension' type='nominal' />
            <column caption='Boa Is Successful' datatype='boolean' name='[boa_is_successful]' role='dimension' type='nominal' />
            <column caption='Payments City Name' datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Contract Name' datatype='string' name='[contract_name]' role='dimension' type='nominal' />
            <column caption='Contracts Paid Count' datatype='integer' name='[contracts_paid_count]' role='measure' type='quantitative' />
