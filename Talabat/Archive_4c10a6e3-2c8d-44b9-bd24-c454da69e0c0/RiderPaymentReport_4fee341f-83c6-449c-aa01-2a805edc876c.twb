      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/RiderPaymentReport/PaymentReportRiderViewDaily?rev=' id='PaymentReportRiderViewDaily' path='/t/Talabat/workbooks/RiderPaymentReport' revision='' site='Talabat' />
      <style />
      <size maxheight='1300' maxwidth='1900' minheight='1300' minwidth='1900' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
