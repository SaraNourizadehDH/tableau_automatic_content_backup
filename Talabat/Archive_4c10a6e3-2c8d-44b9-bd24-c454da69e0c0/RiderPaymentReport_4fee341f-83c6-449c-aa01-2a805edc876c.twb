      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='fct_logistics_delivery_payment_mapping' id='fct_logistics_delivery_payment_mapping_04DE09F3BD8E4361B332F62F73E9D307'>
            <properties context=''>
              <relation connection='bigquery.1i96kmg1flg04l139t2w80f99s1u' name='Custom SQL Query' type='text'><![CDATA[with vars as (
  select 
  date(<[Parameters].[Parameter 6]>) as start_date,
  date(<[Parameters].[Parameter 7]>) as end_date,
  <[Parameters].[Parameter 8]> as country_code_,
),

deliveries as (
select country_code, delivery_id, city_id, city_name, 
sum(pickup_distance_manhattan+dropoff_distance_manhattan)/1000 as distance_manhattan,
sum(actual_pickup_distance+actual_dropoff_distance)/1000 as distance_gps
from vars, `tlb-data-prod.data_platform.fct_logistics_delivery` 
left join `tlb-data-prod.data_platform.dim_logistics_city` using(country_code, city_id)
where created_date between vars.start_date-1 and vars.end_date+1
group by all
),
t1 as (
SELECT 
--m.* except(rule_id,timezone, payment_id, goal_id, goal_type, vendor_code, delivery_location_id, dwh_entry_timestamp, dwh_updated_timestamp), 
 m.created_date, delivery_id, m.country_code, rider_id, rider_name, contract_name, m.city_id, c.city_name, contract_start_at, contract_end_at, m.payment_category, payment_type, r.rule_name as payment_rule_name, total, m.amount, rule_type, rule_sub_type, entity_id, order_status, delivery_status, hurrier_is_successful, boa_is_successful, order_code, pickup_id,  pickup_rank, dropoff_id, vehicle_name, vehicle_type, boa_fail_reason, boa_fail_sub_reason, boa_fail_stage, boa_fail_owner, boa_fail_source, is_stacked_intravendor, evaluated_hours, mismatch_status_1, mismatch_status_2, is_primary,
batch, rider_dropped_off_at, rider_picked_up_at,
hidden_payment_record_count, delivery_related, payment_record_count, is_returning,contracts_paid_count, order_id,
d.city_name as logistics_city_name,shift_id, m.status,

row_number() over(partition by m.country_code, delivery_id order by total) as rn, 
case 
  when vertical_class ='food' then 'food'
  when vertical_class='non-food' and sub_vertical='darkstore' then 'tmart'
  when vertical_class='non-food' and sub_vertical!='darkstore' then 'NFV'
  when m.entity_id like "ODR_%" then 'LAAS'
  else null
end as vertical

FROM vars, `tlb-data-prod.data_platform.fct_logistics_delivery_payment_mapping` m
left join `tlb-data-prod.data_platform.dim_logistics_city` c using(country_code, city_id)
left join deliveries d using(country_code, delivery_id)
left join `tlb-data-prod.data_platform.dim_logistics_rider_payment_rule` r using(rule_id)
left join `tlb-data-prod.data_platform.dim_vertical` v using(vertical_id)
where true
and m.created_date between vars.start_date and vars.end_date
and m.country_code=vars.country_code_
)

select t1.*, 
d.distance_manhattan, d.distance_gps,
from t1 
left join deliveries d on d.country_code=t1.country_code and d.delivery_id=t1.delivery_id and t1.rn=1
order by country_code, delivery_id]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <shared-views>
    <shared-view name='federated.0plgb561g2ujg613vvgdg1vyopl6'>
