            <customized-tooltip>
              <formatted-text>
                <run bold='true'>This filter is used to determine how to classify order status. It will impact which deliveries are considered failed and subsequently will impact completed order/delivery counts and payment totals.</run>
                <run>Æ&#10;&#10;</run>
                <run bold='true'>When True, uses BOA status for Talabat orders.</run>
                <run>Æ&#10;</run>
                <run bold='true'>When False, uses Hurrier status for Talabat orders.</run>
                <run>Æ&#10;</run>
                <run bold='true'>Non-Talabat entity order are not impacted.</run>
              </formatted-text>
            </customized-tooltip>
