    <worksheet name='Rider Level Report '>
      <table>
        <view>
          <datasources>
            <datasource caption='fct_logistics_payment_delivery_shift_mapping (data_platform_logistics)' name='federated.0plgb561g2ujg613vvgdg1vyopl6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[Parameters].[Parameter 5]' caption='Custom Dimension 2' datatype='string' name='[Custom Dimension 1 (copy)_1655283975798218756]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
              <calculation class='tableau' formula='&quot;None&quot;' />
            </column>
            <column caption='Include Failed Order Payments' datatype='boolean' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column caption='Use BOA status for Talabat orders' datatype='boolean' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='true'>
              <calculation class='tableau' formula='true' />
            </column>
            <column _.fcp.ParameterDefaultValues.true...default-value-field='[Parameters].[Parameter 5]' caption='Custom Dimension 1' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
              <calculation class='tableau' formula='&quot;None&quot;' />
            </column>
            <column caption='None Parameter' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
              <calculation class='tableau' formula='&quot;None&quot;' />
            </column>
            <column caption='Country Code' datatype='string' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;om&quot;'>
              <calculation class='tableau' formula='&quot;om&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0plgb561g2ujg613vvgdg1vyopl6'>
            <column caption='EPH (exc. hidden basic) (LC)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[CPO (copy)_676243638532128776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum( &#10;&#10;if (not CONTAINS([payment_category],&apos;hidden&apos;) ) then&#10;[total] &#10;end&#10;)/ sum([evaluated_hours]&#10;&#10;)' />
            </column>
            <column caption='Custom Dimension 1' datatype='string' name='[Calculation_1655283975052951553]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 4]&#10;when &quot;Entity ID&quot; then [entity_id]&#10;when &quot;Batch No.&quot; then str([batch])&#10;when &quot;Vehicle type&quot; then [vehicle_type]&#10;when &quot;Vehicle name&quot; then [vehicle_name]&#10;when &quot;Rule Name&quot; then [payment_rule_name]&#10;when &quot;Rule Type&quot; then [rule_type]&#10;when &quot;Rule Sub Type&quot; then [rule_sub_type]&#10;else NULL&#10;end' />
            </column>
            <column caption='Is Successful' datatype='boolean' name='[Calculation_2724466718059667456]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 3]&#10;&#10;when True then [delivery_status]=&apos;completed&apos; and IFNULL([boa_is_successful], [order_status]=&apos;completed&apos;)&#10;&#10;when False then [delivery_status]=&apos;completed&apos; and [order_status]=&apos;completed&apos;&#10;&#10;end' />
            </column>
            <column caption='Included Failed order payments by Payment Categories' datatype='string' name='[Calculation_2724466718068285441]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if not [Calculation_2724466718059667456] then [payment_category] end' />
            </column>
            <column caption='Include Failed Order Payments filter' datatype='boolean' name='[Calculation_3649534238918066176]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_2724466718059667456]  or [Parameters].[Parameter 2]' />
            </column>
            <column caption='Mismatch Status 1 Deliveries' datatype='integer' name='[Calculation_3904761621473382401]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [created_date], [country_code],[rider_id],[rider_name],[contract_name],[contract_start_at],[contract_end_at],[Calculation_1655283975052951553],[Custom Dimension 1 (copy)_1655283975797977091], [vertical], [Calculation_4709287526195564544]:&#10;countd(if [mismatch_status_1] then str([delivery_id])+[order_code] end)&#10;&#10;}' />
            </column>
            <column caption='rider id null filter' datatype='boolean' name='[Calculation_3904761621478952963]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='not ISNULL([rider_id])' />
            </column>
            <column caption='Rider Payment (LC)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3906380135697653760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([total])&#10;- [Calculation_3906380135698415617]' />
            </column>
            <column caption='Contractor Payment (LC)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3906380135698415617]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL([Rider Basic Payments - Deliveries (LC)  (copy)_3531948014811615234],0)&#10;+IFNULL([Rider Basic Payments - Distance (LC) (copy)_3531948014811627523],0)&#10;+IFNULL([Rider Basic Payments - Hours (LC) (copy)_3531948014811635716],0)&#10;+IFNULL([Rider Basic Payments - Monthly (LC) (copy)_3531948014811648005],0)' />
            </column>
            <column caption='City' datatype='string' name='[Calculation_4709287526195564544]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([logistics_city_name], [city_name])' />
            </column>
            <column caption='Dropoff cancellations' datatype='integer' name='[Calculation_516928842379075586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [created_date], [country_code],[rider_id],[rider_name],[contract_name],[contract_start_at],[contract_end_at],[Calculation_1655283975052951553],[Custom Dimension 1 (copy)_1655283975797977091], [vertical], [Calculation_4709287526195564544]:&#10;COUNTD(&#10;if not [Is Pickup Successful (copy)_5305944097105797124]&#10;and not isnull([rider_dropped_off_at]) &#10;then [order_code]+STR([delivery_id])  &#10;end)&#10;}' />
            </column>
            <column caption='Net Pickups Count' datatype='integer' name='[Calculation_5305944096682868738]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Pickups Count (copy)_4327677814475509760] - [Post pickup delivery cancellations (copy)_4327677814476398593]' />
            </column>
            <column caption='Net Dropoffs Count' datatype='integer' name='[Calculation_5305944096683122691]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Pickups Count (copy)_516928842378489857] -[Calculation_516928842379075586]' />
            </column>
            <column caption='selected country' datatype='boolean' name='[Calculation_5725271402158092289]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[country_code]= [Parameters].[Parameter 8]' />
            </column>
            <column caption='Total Orders' datatype='integer' name='[Calculation_676243638181961728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [created_date], [country_code],[rider_id],[rider_name],[contract_name],[contract_start_at],[contract_end_at],[Calculation_1655283975052951553],[Custom Dimension 1 (copy)_1655283975797977091], [vertical], [Calculation_4709287526195564544]:&#10;countd(if([is_primary]) then [order_code] end)&#10;}' />
            </column>
            <column caption='Total Deliveries' datatype='integer' name='[Calculation_676243638182100993]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [created_date], [country_code],[rider_id],[rider_name],[contract_name],[contract_start_at],[contract_end_at],[Calculation_1655283975052951553],[Custom Dimension 1 (copy)_1655283975797977091], [vertical], [Calculation_4709287526195564544]:&#10;COUNTD([order_code]+STR([delivery_id]))&#10;}' />
            </column>
            <column caption='CPO1 (LC)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_676243638531317764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [payment_category] !=&apos;tips&apos; then [total] end)/ sum([Total Orders (copy)_676243638182424578])' />
            </column>
            <column caption='UTR' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_676243638537637902]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Total Orders (copy)_676243638182424578])/sum([evaluated_hours])' />
            </column>
            <column caption='Unpaid Deliveries' datatype='integer' name='[Calculation_676243638538051599]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [created_date], [country_code],[rider_id],[rider_name],[contract_name],[contract_start_at],[contract_end_at],[Calculation_1655283975052951553],[Custom Dimension 1 (copy)_1655283975797977091], [vertical], [Calculation_4709287526195564544]:&#10;&#10;countd( if ([Calculation_676243638540611603]) then ([order_code] + str([delivery_id])) end)&#10;&#10;}' />
            </column>
            <column caption='Multiple Contracts Paid ' datatype='boolean' name='[Calculation_676243638540058641]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='contracts_paid_count&gt;1' />
            </column>
            <column caption='Multiple Contracts Paid Deliveries' datatype='integer' name='[Calculation_676243638540214290]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if([Calculation_676243638540058641]) then [order_code]+str([delivery_id]) end)' />
            </column>
            <column caption='Unpaid Delivery Flag' datatype='boolean' name='[Calculation_676243638540611603]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(not [payment_record_count]&gt;0 and [delivery_status]=&apos;completed&apos; and [order_status]=&apos;completed&apos;&#10;and (not [Parameters].[Parameter 3] or IFNULL([boa_is_successful],TRUE))&#10;&#10;and not [is_returning] )' />
            </column>
            <column caption='Contract Unpaid Delivery Flag' datatype='boolean' name='[Calculation_676243638540914708]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[hidden_payment_record_count]=0 and [delivery_related] and [payment_record_count]&gt;0 and not [Calculation_676243638540611603] and [order_status]=&apos;completed&apos; and [delivery_status]=&apos;completed&apos;' />
            </column>
            <column caption='Rider Paid Hours (Hr)' datatype='real' name='[Calculation_676243638541127701]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum( IFNULL(if not contains([payment_category],&apos;hidden&apos;) and [rule_type]=&apos;PER_HOUR&apos; then [amount] end,0))' />
            </column>
            <column caption='Worked Shifts' datatype='integer' name='[Calculation_676243638544699416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd([shift_id])' />
            </column>
            <column caption='exclude yesterday' datatype='boolean' name='[Calculation_676243638564614170]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[created_date]&lt;DATEADD(&apos;day&apos;,0,TODAY())' />
            </column>
            <column caption='Rider Referral Payments (LC)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Contract Basic Payments (LC)  (copy)_676243638585704480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if([payment_category]=&apos;referral_payments&apos;) then [total] end)' />
            </column>
            <column caption='Custom Dimension 2' datatype='string' name='[Custom Dimension 1 (copy)_1655283975797977091]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Parameters].[Custom Dimension 1 (copy)_1655283975798218756]&#10;when &quot;Entity ID&quot; then [entity_id]&#10;when &quot;Batch No.&quot; then str([batch])&#10;when &quot;Vehicle type&quot; then [vehicle_type]&#10;when &quot;Vehicle name&quot; then [vehicle_name]&#10;when &quot;Rule Name&quot; then [payment_rule_name]&#10;when &quot;Rule Type&quot; then [rule_type]&#10;when &quot;Rule Sub Type&quot; then [rule_sub_type]&#10;else NULL&#10;end' />
            </column>
            <column caption='Included Failed order payments by Payment Rule Sub Type' datatype='string' name='[Failed order payment category (copy)_3035285470656765952]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if not [Calculation_2724466718059667456] then [rule_sub_type] end' />
            </column>
            <column caption='Included Failed Dropoffs payments by Payment Categories' datatype='string' name='[Included Failed Pickups payments by Payment Categories (copy)_5160984484694597632]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if not [Is Pickup Successful (copy)_5305944097105797124] and [rule_sub_type]=&quot;COMPLETED_DELIVERIES&quot; then [payment_category] end' />
            </column>
            <column caption='Included Failed Pickups payments by Payment Categories' datatype='string' name='[Included Failed order payments by Payment Categories (copy)_5305944097697746949]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if not [Is Successful (copy)_5305944096310714369] and [rule_sub_type]=&quot;PICKEDUP_DELIVERIES&quot; then [payment_category] end' />
            </column>
            <column caption='Is Dropoff Successful' datatype='boolean' name='[Is Pickup Successful (copy)_5305944097105797124]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [dropoff_id]: max(&#10;case [Parameters].[Parameter 3]&#10;&#10;when True then [delivery_status]=&apos;completed&apos; and IFNULL([boa_is_successful], [order_status]=&apos;completed&apos;)&#10;&#10;when False then [delivery_status]=&apos;completed&apos; and [order_status]=&apos;completed&apos;&#10;&#10;end )}' />
            </column>
            <column caption='Is Pickup Successful' datatype='boolean' name='[Is Successful (copy)_5305944096310714369]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{ FIXED [pickup_id]: max(&#10;case [Parameters].[Parameter 3]&#10;&#10;when True then [delivery_status]=&apos;completed&apos; and IFNULL([boa_is_successful], [order_status]=&apos;completed&apos;)&#10;&#10;when False then [delivery_status]=&apos;completed&apos; and [order_status]=&apos;completed&apos;&#10;&#10;end )}' />
