    <datasource caption='Frequency Buckets' inline='true' name='federated.1xx3w5s0a2c50i1aifgvm02ifr3a' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0hawgyc1axny5s1dcr2lv04m0f48'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform' server-oauth='' username='hari.vellamelli@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0hawgyc1axny5s1dcr2lv04m0f48' name='Custom SQL Query' type='text'>WITH order_data AS&#13;
  (SELECT DATE_TRUNC(order_date,MONTH) AS order_month,&#13;
          c.analytical_customer_id,&#13;
          chain_id,&#13;
          chain_name,&#13;
          CASE&#13;
              WHEN t.analytical_customer_id IS NOT NULL THEN &apos;Yes&apos;&#13;
              ELSE &apos;No&apos;&#13;
          END AS is_tpro,&#13;
          COUNT(DISTINCT order_id) AS orders_count,&#13;
          SUM(sales) AS sales,&#13;
          SUM(sales_eur) AS sales_eur,&#13;
          AVG (days_to_reorder) AS days_to_reorder&#13;
   FROM&#13;
     (SELECT l.order_date,&#13;
             l.order_id,&#13;
             l.analytical_customer_id,&#13;
             DATE_DIFF(l.order_date, LAG(l.order_date) OVER (PARTITION BY l.analytical_customer_id,DATE_TRUNC(l.order_date,MONTH)&#13;
                                                             ORDER BY l.order_date),DAY) AS days_to_reorder,&#13;
             c.chain_id,&#13;
             c.chain_name,&#13;
             basket_amount_lc AS sales,&#13;
             basket_amount_eur AS sales_eur&#13;
      FROM `tlb-data-prod.data_platform.fct_order_info` l&#13;
      LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c ON l.chain_id = c.chain_id&#13;
      WHERE L.chain_id IN (1865,&#13;
                           13050,&#13;
                           633401,&#13;
                           8581,&#13;
                           603153,&#13;
                           659775,&#13;
                           10584,&#13;
