    <worksheet name='EDR Frequency Bucketing'>
      <table>
        <view>
          <datasources>
            <datasource caption='Frequency Buckets' name='federated.1xx3w5s0a2c50i1aifgvm02ifr3a' />
          </datasources>
          <datasource-dependencies datasource='federated.1xx3w5s0a2c50i1aifgvm02ifr3a'>
            <column caption='Total Coffee Segment Customers' datatype='integer' name='[Calculation_620370873491111936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed[order_month],[chain_name],[analytical_customer_id]:SUM([orders_count])}' />
            </column>
            <column caption='Frequency Buckets' datatype='string' name='[Calculation_620370873491537922]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_620370873491111936] = 1 THEN &apos;1 Order&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_620370873491111936] &lt; 4 THEN &apos;2-3 Orders&apos;&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF [Calculation_620370873491111936] &lt; 6 THEN &apos;4-5 Orders&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_620370873491111936] &lt; 8 THEN &apos;6-7 Orders&apos;&#13;&#10;&#13;&#10;ELSE &apos;8+ Orders&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Total Customers' datatype='integer' name='[Calculation_620370873491943427]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([analytical_customer_id])' />
            </column>
            <column caption='Chain Grouping' datatype='string' name='[Calculation_620370873493577732]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS(LOWER(chain_name),&apos;starbuck&apos;) THEN &apos;Starbucks&apos;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER(chain_name),&apos;costa&apos;) THEN &apos;Costa&apos;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER(chain_name),&apos;horton&apos;) THEN &apos;Tim Hortons&apos;&#13;&#10;&#13;&#10;ELSEIF CONTAINS(LOWER(chain_name),&apos;everyday&apos;) AND CONTAINS(LOWER(chain_name),&apos;roastery&apos;) THEN &apos;EDR&apos;&#13;&#10;&#13;&#10;ELSE &apos;Others&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[analytical_customer_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_620370873491537922]' derivation='None' name='[none:Calculation_620370873491537922:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_620370873493577732]' derivation='None' name='[none:Calculation_620370873493577732:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_month]' derivation='None' name='[none:order_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[order_month]' derivation='None' name='[none:order_month:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[order_month]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[orders_count]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_620370873491943427]' derivation='User' name='[pcto:usr:Calculation_620370873491943427:qk:2]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
