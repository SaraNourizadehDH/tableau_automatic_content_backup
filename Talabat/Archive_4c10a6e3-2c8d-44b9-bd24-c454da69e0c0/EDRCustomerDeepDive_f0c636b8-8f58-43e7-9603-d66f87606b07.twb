              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;&#13;&#10;WHEN &apos;Orders&apos; THEN [Calculation_1140536616323358725]&#13;&#10; &#13;&#10;WHEN &apos;GMV&apos; THEN [Coffee Orders (copy)_1140536616323682310]&#13;&#10;&#13;&#10;WHEN &apos;Customers&apos; THEN SUM([Calculation_1140536616321863682])&#13;&#10;&#13;&#10;END' />
