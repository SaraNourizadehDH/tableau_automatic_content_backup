      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1t3kah50qccrsy1dhcjar1d9ru7p].[sum:cust_inquiry_request_contacts:qk]&quot;' value='Inquiry' />
