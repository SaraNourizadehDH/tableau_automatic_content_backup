    <worksheet name='Segment Share of Platform'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontsize='14' italic='true'>Platform Share</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Aggregated Data' name='federated.0isktwk0a8rvmw14vbvxf0f5xxey' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Agg' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Month&quot;'>
              <calculation class='tableau' formula='&quot;Month&quot;' />
            </column>
            <column caption='Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Customers&quot;'>
              <calculation class='tableau' formula='&quot;Customers&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0isktwk0a8rvmw14vbvxf0f5xxey'>
            <column caption='Chain Metrics' datatype='real' name='[Calculation_1140536616321728513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;&#13;&#10;WHEN &apos;Orders&apos; THEN [Calculation_1140536616323358725]&#13;&#10; &#13;&#10;WHEN &apos;GMV&apos; THEN [Coffee Orders (copy)_1140536616323682310]&#13;&#10;&#13;&#10;WHEN &apos;Customers&apos; THEN SUM([Calculation_1140536616321863682])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Chain Customer Count' datatype='integer' name='[Calculation_1140536616321863682]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &apos;Day&apos; THEN [chain_daily_customers]&#13;&#10;&#13;&#10;WHEN &apos;Week&apos; THEN [chain_weekly_customers]&#13;&#10;&#13;&#10;WHEN &apos;Month&apos; THEN [chain_monthly_customers]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Date Aggregation' datatype='date' name='[Calculation_1140536616322367491]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &apos;Day&apos; THEN [order_date]&#13;&#10;&#13;&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;,[order_date])&#13;&#10;&#13;&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[order_date])&#13;&#10;&#13;&#10;END)' />
            </column>
            <column caption='Coffee Orders' datatype='integer' name='[Calculation_1140536616323358725]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF NOT ISNULL([chain_grouping]) THEN [total_orders] END)' />
            </column>
            <column caption='Segment Share of Platform' datatype='real' name='[Calculation_1140536616325828621]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1140536616321728513]/[Metric to Plot (copy)_1140536616325435403]' />
            </column>
            <column caption='Platform Customer Count' datatype='integer' name='[Chain Customer Count (copy)_1140536616325632012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &apos;Day&apos; THEN [platform_customers]&#13;&#10;&#13;&#10;WHEN &apos;Week&apos; THEN [platform_weekly_customers]&#13;&#10;&#13;&#10;WHEN &apos;Month&apos; THEN [platform_monthly_customers]&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Coffee GMV' datatype='real' name='[Coffee Orders (copy)_1140536616323682310]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF NOT ISNULL([chain_grouping]) THEN [gmv_eur] END)' />
            </column>
            <column caption='Platform Metrics' datatype='real' name='[Metric to Plot (copy)_1140536616325435403]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;&#13;&#10;WHEN &apos;Orders&apos; THEN sum([total_orders])&#13;&#10; &#13;&#10;WHEN &apos;GMV&apos; THEN sum([gmv_eur])&#13;&#10;&#13;&#10;WHEN &apos;Customers&apos; THEN sum([Chain Customer Count (copy)_1140536616325632012])&#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='integer' name='[chain_daily_customers]' role='measure' type='quantitative' />
            <column datatype='string' name='[chain_grouping]' role='dimension' type='nominal' />
            <column datatype='integer' name='[chain_monthly_customers]' role='measure' type='quantitative' />
            <column datatype='integer' name='[chain_weekly_customers]' role='measure' type='quantitative' />
            <column datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1140536616322367491]' derivation='None' name='[none:Calculation_1140536616322367491:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1140536616322367491]' derivation='None' name='[none:Calculation_1140536616322367491:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[platform_customers]' role='measure' type='quantitative' />
            <column datatype='integer' name='[platform_monthly_customers]' role='measure' type='quantitative' />
            <column datatype='integer' name='[platform_weekly_customers]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1140536616325828621]' derivation='User' name='[usr:Calculation_1140536616325828621:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
