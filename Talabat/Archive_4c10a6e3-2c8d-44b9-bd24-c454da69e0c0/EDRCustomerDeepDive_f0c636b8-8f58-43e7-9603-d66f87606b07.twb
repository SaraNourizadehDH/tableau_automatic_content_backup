      </column>
      <column caption='Post Acq Total Orders' datatype='integer' name='[Calculation_1094656211742121984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[post_acq_costa_orders] + [post_acq_edr_orders] + [post_acq_others_orders] + [post_acq_starbucks_orders] + [post_acq_th_orders]' />
      </column>
      <column caption='Coffee Churn' datatype='boolean' name='[Calculation_1094656211766300676]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1094656211742121984] = 0' />
      </column>
      <column caption='Pre EDR Acquisition Segmentation' datatype='string' name='[Calculation_1140536616330518544]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Post Acq Total Orders (copy)_1094656212076445711] = 0 THEN &apos;Coffee Segment Acquisition&apos;&#13;&#10;&#13;&#10;ELSEIF [Post Acq Total Orders (copy)_1094656212076445711] &gt; 0 THEN &apos;EDR Only Acquisition&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Segmentation' datatype='string' name='[Calculation_1150669705880387597]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
      </column>
      <column caption='Customer Count' datatype='integer' name='[Calculation_1150669772146819075]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([analytical_customer_id])' />
      </column>
      <column caption='Customer Segments' datatype='string' name='[Calculation_1150669772151685125]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1094656211766300676] THEN &apos;Coffee Churn&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1150669772185575433] = &apos;Y&apos; THEN &apos;EDR Churn Only&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1150669772185575433] = &apos;N&apos; AND ([Calculation_1094656211742121984] = [post_acq_edr_orders]) THEN &apos;EDR Only&apos;&#13;&#10;&#13;&#10;ELSE &apos;EDR + Other Coffee Chains&apos; &#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='EDR Churn Segmentation' datatype='string' name='[Calculation_1150669772154679302]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1150669772151685125] = &apos;Active Other Chains&apos; AND [post_acq_other_orders] = 0 AND [post_acq_starbucks_orders] = 0 AND [post_acq_th_orders] = 0 THEN &apos;Costa Only&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1150669772151685125] = &apos;Active Other Chains&apos; AND [post_acq_other_orders] = 0 AND [post_acq_starbucks_orders] = 0 AND [post_acq_costa_orders] = 0 THEN &apos;Tim Hortons Only&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1150669772151685125] = &apos;Active Other Chains&apos; AND [post_acq_th_orders] = 0 AND [post_acq_starbucks_orders] = 0 AND [post_acq_costa_orders] = 0 THEN &apos;Others Only&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1150669772151685125] = &apos;Active Other Chains&apos; AND [post_acq_th_orders] = 0 AND [post_acq_other_orders] = 0 AND [post_acq_costa_orders] = 0 THEN &apos;Starbucks Only&apos;&#13;&#10;&#13;&#10;ELSE &apos;Active Multiple Chains&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='EDR Churn' datatype='string' name='[Calculation_1150669772185575433]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT([Calculation_1094656211766300676]) AND [post_acq_edr_orders] = 0 THEN &apos;Y&apos; ELSE &apos;N&apos; END' />
      </column>
      <column caption='Total Contacts' datatype='integer' name='[Calculation_83879571072475136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[cust_inquiry_request_contacts] + [delay_late_contacts] + [other_cust_contacts] + [quality_contacts] + [wrong_item_contacts]+[missing_item_order_contacts]' />
      </column>
      <column caption='Share of Orders with Contact' datatype='real' name='[Calculation_83879571072634881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_83879571072475136])/[Calculation_1150669772146819075]' />
      </column>
      <column caption='Vendor Delay' datatype='integer' name='[Calculation_83879571093372931]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF[vendor_delay] &gt; 300 THEN [analytical_customer_id] END)' />
      </column>
      <column caption='Stacked Orders ' datatype='integer' name='[Calculation_83879571099017221]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [is_stacked] = &apos;Y&apos; then [analytical_customer_id] end)' />
      </column>
      <column caption='Pre EDR Segment' datatype='string' name='[Calculation_83879573575368711]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Post Acq Total Orders (copy)_1094656212076445711] = 0 THEN &apos;Coffee Segment Acquisition&apos;&#13;&#10;&#13;&#10;ELSEIF [Post Acq Total Orders (copy)_1094656212076445711] = [pre_acq_starbucks_orders]  THEN &apos;Starbucks Only&apos;&#13;&#10;&#13;&#10;ELSEIF [Post Acq Total Orders (copy)_1094656212076445711] = [pre_acq_th_orders]  THEN &apos;Tim Hortons Only&apos;&#13;&#10;&#13;&#10;ELSEIF [Post Acq Total Orders (copy)_1094656212076445711] = [pre_acq_costa_orders]  THEN &apos;Costa Only&apos;&#13;&#10;&#13;&#10;ELSEIF [Post Acq Total Orders (copy)_1094656212076445711] = [pre_acq_others_orders]  THEN &apos;Others Only&apos;&#13;&#10;&#13;&#10;ELSE &apos;Multiple Coffee Chains&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Acq Date Aggregation' datatype='date' datatype-customized='true' name='[Date Aggregation (copy)_1140536616321458176]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &apos;Day&apos; THEN [edr_acq_date]&#13;&#10;&#13;&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;,[edr_acq_date])&#13;&#10;&#13;&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[edr_acq_date])&#13;&#10;&#13;&#10;END)' />
      </column>
      <column caption='EDR Multiple Active Segmentation' datatype='string' name='[EDR Churn Segmentation (copy)_1150669772157595655]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1150669772151685125] = &apos;EDR &amp; Other Chains&apos; AND [post_acq_edr_orders] &gt; 0 AND [post_acq_other_orders] &gt; 0 AND [post_acq_starbucks_orders] = 0 AND [post_acq_th_orders] = 0 AND [post_acq_costa_orders] = 0 THEN &apos;EDR + Others Only&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1150669772151685125] = &apos;EDR &amp; Other Chains&apos; AND [post_acq_edr_orders] &gt; 0 AND [post_acq_starbucks_orders] &gt; 0 AND [post_acq_other_orders] = 0 AND [post_acq_th_orders] = 0 AND [post_acq_costa_orders] = 0 THEN &apos;EDR + Starbucks Only&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1150669772151685125] = &apos;EDR &amp; Other Chains&apos; AND [post_acq_edr_orders] &gt; 0 AND [post_acq_th_orders] &gt; 0  AND [post_acq_other_orders] = 0 AND [post_acq_starbucks_orders] = 0 AND [post_acq_costa_orders] = 0 THEN &apos;EDR + Tim Hortons Only&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1150669772151685125] = &apos;EDR &amp; Other Chains&apos; AND [post_acq_edr_orders] &gt; 0 AND [post_acq_costa_orders] &gt; 0 AND [post_acq_other_orders] = 0 AND [post_acq_starbucks_orders] = 0  AND [post_acq_th_orders] = 0 THEN &apos;EDR + Costa Only&apos;&#13;&#10;&#13;&#10;ELSE &apos;EDR and 2+ Other Chains&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Pre Acq Total Orders' datatype='integer' name='[Post Acq Total Orders (copy)_1094656212076445711]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[pre_acq_costa_orders] + [pre_acq_others_orders] + [pre_acq_starbucks_orders] + [pre_acq_th_orders]' />
      </column>
      <column caption='Stacked Orders  Rider Delay' datatype='integer' name='[Stacked Orders  (copy)_83879571099422726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(if [is_stacked] = &apos;Y&apos; and [rider_delay] &gt; 0 then [analytical_customer_id] end)' />
      </column>
      <column caption='Rider Delay' datatype='integer' name='[Vendor Delay (copy)_83879571093692420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF[rider_delay] &gt; 0 THEN [analytical_customer_id] END)' />
      </column>
