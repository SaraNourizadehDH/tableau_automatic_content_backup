          <alias key='&quot;[federated.1t3kah50qccrsy1dhcjar1d9ru7p].[sum:quality_contacts:qk]&quot;' value='Food Quality' />
          <alias key='&quot;[federated.1t3kah50qccrsy1dhcjar1d9ru7p].[sum:wrong_item_contacts:qk]&quot;' value='Wrong Items' />
