                  <zone forceUpdate='true' h='2719' id='58' type-v2='text' w='99112' x='444' y='65703'>
                    <formatted-text>
                      <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='14'>How do EDR&apos;s customers behave after placing their first order with EDR? </run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone forceUpdate='true' h='8083' id='93' type-v2='text' w='99112' x='444' y='39917'>
                    <formatted-text>
                      <run fontcolor='#000000' fontsize='11'>The two visuals below describe the</run>
                      <run bold='true' fontcolor='#000000' fontsize='11'> ordering behaviour of first time EDR customers only.</run>
                      <run>Æ&#10;&#10;</run>
                      <run fontcolor='#000000' fontsize='11'> x-axis: </run>
                      <run bold='true' fontcolor='#000000' fontsize='11'>time period in which a customer placed their first order with EDR. </run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#000000' fontsize='11'> Visual 1 (Pre Acquisition Segmentation): </run>
                      <run fontcolor='#000000' fontsize='11'>what chains have customers transacted before being acquired by EDR (lifetime)</run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#000000' fontsize='11'>Visual 2 (Post Acquisition Segmentation):</run>
                      <run fontcolor='#000000' fontsize='11'>what chains have customers transacted after being acquired by EDR (lifetime)</run>
                      <run>Æ&#10;&#10;&#10;</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='solid' />
                      <format attr='border-width' value='2' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone h='4226' id='165' name='Segment Share of Platform' w='99112' x='444' y='7902'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone h='25776' id='266' name='Post Acq Incentivized Customer Behaviour' w='41011' x='58545' y='73957'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone forceUpdate='true' h='24271' id='267' type-v2='text' w='16182' x='444' y='75462'>
                    <formatted-text>
                      <run fontcolor='#000000' fontsize='10'>Definitions of Customer Behaviour Post EDR Acquisition: </run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#000000'>Coffee Churn:</run>
                      <run fontcolor='#000000'> Customers that do not place orders with any coffee vendors on Talabat. </run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#000000'>EDR Churn Only:</run>
                      <run fontcolor='#000000'> Customers do not place orders with EDR but continue to engage with other coffee vendors. </run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#000000'>EDR Only: </run>
                      <run fontcolor='#000000'>Customers that transact with EDR only as opposed to other coffee vendors. </run>
                      <run>Æ&#10;&#10;</run>
                      <run bold='true' fontcolor='#000000'>EDR + Other Chains:</run>
                      <run fontcolor='#000000'> Customers transact at least once with EDR </run>
                      <run bold='true' fontcolor='#000000' fontsize='12' underline='true'>and</run>
                      <run fontcolor='#000000' fontsize='10'> other coffee vendors. </run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
