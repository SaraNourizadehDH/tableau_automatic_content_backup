    <worksheet name='Delay'>
      <table>
        <view>
          <datasources>
            <datasource caption='EDR Deep Dive' name='federated.1t3kah50qccrsy1dhcjar1d9ru7p' />
          </datasources>
          <datasource-dependencies datasource='federated.1t3kah50qccrsy1dhcjar1d9ru7p'>
            <column caption='Post Acq Total Orders' datatype='integer' name='[Calculation_1094656211742121984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[post_acq_costa_orders] + [post_acq_edr_orders] + [post_acq_others_orders] + [post_acq_starbucks_orders] + [post_acq_th_orders]' />
            </column>
            <column caption='Coffee Churn' datatype='boolean' name='[Calculation_1094656211766300676]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1094656211742121984] = 0' />
            </column>
            <column caption='Customer Segments' datatype='string' name='[Calculation_1150669772151685125]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1094656211766300676] THEN &apos;Coffee Churn&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1150669772185575433] = &apos;Y&apos; THEN &apos;EDR Churn Only&apos;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1150669772185575433] = &apos;N&apos; AND ([Calculation_1094656211742121984] = [post_acq_edr_orders]) THEN &apos;EDR Only&apos;&#13;&#10;&#13;&#10;ELSE &apos;EDR + Other Coffee Chains&apos; &#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='EDR Churn' datatype='string' name='[Calculation_1150669772185575433]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT([Calculation_1094656211766300676]) AND [post_acq_edr_orders] = 0 THEN &apos;Y&apos; ELSE &apos;N&apos; END' />
            </column>
            <column caption='Vendor Delay' datatype='integer' name='[Calculation_83879571093372931]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF[vendor_delay] &gt; 300 THEN [analytical_customer_id] END)' />
            </column>
            <column caption='Stacked Orders ' datatype='integer' name='[Calculation_83879571099017221]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(if [is_stacked] = &apos;Y&apos; then [analytical_customer_id] end)' />
            </column>
            <column caption='Rider Delay' datatype='integer' name='[Vendor Delay (copy)_83879571093692420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF[rider_delay] &gt; 0 THEN [analytical_customer_id] END)' />
            </column>
            <column datatype='string' name='[analytical_customer_id]' role='dimension' type='nominal' />
            <column datatype='integer' name='[delay_late_contacts]' role='measure' type='quantitative' />
            <column datatype='date' name='[edr_acq_date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[is_stacked]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1150669772151685125]' derivation='None' name='[none:Calculation_1150669772151685125:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[post_acq_costa_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[post_acq_edr_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[post_acq_others_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[post_acq_starbucks_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[post_acq_th_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[rider_delay]' role='measure' type='quantitative' />
            <column-instance column='[delay_late_contacts]' derivation='Sum' name='[sum:delay_late_contacts:qk]' pivot='key' type='quantitative' />
            <column-instance column='[edr_acq_date]' derivation='Month-Trunc' name='[tmn:edr_acq_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_83879571093372931]' derivation='User' name='[usr:Calculation_83879571093372931:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_83879571099017221]' derivation='User' name='[usr:Calculation_83879571099017221:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Vendor Delay (copy)_83879571093692420]' derivation='User' name='[usr:Vendor Delay (copy)_83879571093692420:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[vendor_delay]' role='measure' type='quantitative' />
          </datasource-dependencies>
