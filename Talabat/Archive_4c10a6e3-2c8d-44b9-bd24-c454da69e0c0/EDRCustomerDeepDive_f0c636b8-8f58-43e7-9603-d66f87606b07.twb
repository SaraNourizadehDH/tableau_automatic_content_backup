                           657870,&#13;
                           637977,&#13;
                           637948,&#13;
                           643153,&#13;
                           659730,&#13;
                           670444)&#13;
        AND date_trunc(l.order_date,MONTH) BETWEEN date_add(DATE_TRUNC(CURRENT_DATE,MONTH), interval -12 MONTH) AND DATE_TRUNC(CURRENT_DATE,MONTH)&#13;
        AND analytical_customer_id IS NOT NULL) c&#13;
   LEFT JOIN&#13;
     (SELECT analytical_customer_id,&#13;
             DATE_TRUNC(date_field,MONTH) AS MONTH&#13;
      FROM `tlb-data-prod.data_platform.agg_customer_profile` ,&#13;
           UNNEST(active_tpro_months_list) AS date_field&#13;
      WHERE date_field IS NOT NULL) t ON c.analytical_customer_id = t.analytical_customer_id&#13;
   AND DATE_TRUNC(c.order_date,MONTH) = t.MONTH&#13;
   GROUP BY 1,&#13;
            2,&#13;
            3,&#13;
            4,&#13;
            5)&#13;
SELECT *&#13;
FROM order_data</relation>
