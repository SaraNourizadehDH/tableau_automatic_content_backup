            <column-instance column='[cust_inquiry_request_contacts]' derivation='Sum' name='[sum:cust_inquiry_request_contacts:qk]' pivot='key' type='quantitative' />
            <column-instance column='[delay_late_contacts]' derivation='Sum' name='[sum:delay_late_contacts:qk]' pivot='key' type='quantitative' />
            <column-instance column='[missing_item_order_contacts]' derivation='Sum' name='[sum:missing_item_order_contacts:qk]' pivot='key' type='quantitative' />
