            </column>
            <column caption='Date Aggregation' datatype='date' name='[Calculation_1140536616322367491]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &apos;Day&apos; THEN [order_date]&#13;&#10;&#13;&#10;WHEN &apos;Week&apos; THEN DATETRUNC(&apos;week&apos;,[order_date])&#13;&#10;&#13;&#10;WHEN &apos;Month&apos; THEN DATETRUNC(&apos;month&apos;,[order_date])&#13;&#10;&#13;&#10;END)' />
            </column>
            <column caption='Coffee Orders' datatype='integer' name='[Calculation_1140536616323358725]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF NOT ISNULL([chain_grouping]) THEN [total_orders] END)' />
