        <objects>
          <object caption='Custom SQL Query' id='_765D33B68B6F43C6BCA75028364F31D1'>
            <properties context=''>
              <relation connection='bigquery.1ildeh600jwrpw0zoxd031c6wwwt' name='Custom SQL Query' type='text'>WITH coffee_vendors AS&#13;
  (SELECT vendor_id,&#13;
          location_id,&#13;
          dc.*,&#13;
          dv.vendor_name&#13;
   FROM `tlb-data-prod.data_platform.dim_vendor_info` AS dv&#13;
   LEFT JOIN&#13;
     (SELECT chain_id,&#13;
             chain_name&#13;
      FROM `tlb-data-prod.data_platform.dim_chain`) AS dc ON (dv.chain_id = dc.chain_id)&#13;
   WHERE 1=1&#13;
     AND dv.chain_id IN (1865,&#13;
