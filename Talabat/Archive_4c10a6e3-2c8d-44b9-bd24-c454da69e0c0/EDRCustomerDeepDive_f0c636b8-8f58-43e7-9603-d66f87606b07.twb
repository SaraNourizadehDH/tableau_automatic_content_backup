            <column caption='Platform Customer Count' datatype='integer' name='[Chain Customer Count (copy)_1140536616325632012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &apos;Day&apos; THEN [platform_customers]&#13;&#10;&#13;&#10;WHEN &apos;Week&apos; THEN [platform_weekly_customers]&#13;&#10;&#13;&#10;WHEN &apos;Month&apos; THEN [platform_monthly_customers]&#13;&#10;&#13;&#10;END' />
