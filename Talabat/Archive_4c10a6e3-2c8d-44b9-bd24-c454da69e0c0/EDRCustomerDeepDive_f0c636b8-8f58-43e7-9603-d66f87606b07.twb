              <relation connection='bigquery.1rkg92l0y1b1j410xx16w0yhilzu' name='Custom SQL Query' type='text'><![CDATA[WITH coffee_vendors AS
  (SELECT vendor_id,
          location_id,
          dc.*,
          dv.vendor_name
   FROM `tlb-data-prod.data_platform.dim_vendor_info` AS dv
   LEFT JOIN
     (SELECT chain_id,
             chain_name
      FROM `tlb-data-prod.data_platform.dim_chain`) AS dc ON (dv.chain_id = dc.chain_id)
   WHERE 1=1
     AND dv.chain_id IN (1865,
                         13050,
                         633401,
                         8581,
                         603153,
                         659775,
                         10584,
                         10406,
                         9503,
                         630090,
                         648546,
                         635985,
                         23857,
                         644259,
                         21116,
                         642512,
                         28039,
                         27984,
                         27678,
