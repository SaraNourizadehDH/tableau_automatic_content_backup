      <column caption='Coffee GMV' datatype='real' name='[Coffee Orders (copy)_1140536616323682310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF NOT ISNULL([chain_grouping]) THEN [gmv_eur] END)' />
