                         640802,&#13;
                         643158,&#13;
                         637932,&#13;
                         637979,&#13;
                         637980,&#13;
                         637911,&#13;
                         637929,&#13;
                         637993,&#13;
                         637983,&#13;
                         637961,&#13;
                         650728,&#13;
                         637955,&#13;
                         637920,&#13;
                         637907,&#13;
                         650725,&#13;
                         637947,&#13;
                         637906,&#13;
                         641710,&#13;
                         637999,&#13;
                         637930,&#13;
                         641709,&#13;
                         645083,&#13;
                         650724,&#13;
                         643156,&#13;
                         647004,&#13;
                         637942,&#13;
                         638010,&#13;
                         637992,&#13;
                         637936,&#13;
                         643151,&#13;
                         637924,&#13;
                         645176,&#13;
                         637909,&#13;
                         637917,&#13;
                         643154,&#13;
                         647002,&#13;
                         659729,&#13;
                         645079,&#13;
                         637928,&#13;
                         670444,&#13;
                         637899,&#13;
                         657870,&#13;
                         637977,&#13;
                         637948,&#13;
                         643153,&#13;
                         659730)),&#13;
     order_data_master_set AS&#13;
  (SELECT ord.*,&#13;
          ven.chain_grouping&#13;
   FROM&#13;
     (SELECT order_date,&#13;
             vendor_id,&#13;
             order_id,&#13;
             analytical_customer_id,&#13;
             gmv_amount_eur&#13;
      FROM `tlb-data-prod.data_platform.fct_order_info`&#13;
      WHERE 1=1&#13;
        AND order_date &gt;&gt;= date_add(date_trunc(CURRENT_DATE,MONTH), interval -12 MONTH)&#13;
        AND is_successful&#13;
        AND NOT is_test&#13;
        AND country_code = &apos;AE&apos;&#13;
        AND NOT(is_non_food)) AS ord&#13;
   LEFT JOIN&#13;
     (SELECT vendor_id,&#13;
             CASE WHEN lower(trim(chain_name)) LIKE &apos;%starbuck%&apos; THEN &apos;Starbucks&apos; WHEN lower(trim(chain_name)) LIKE &apos;%horton%&apos; THEN &apos;Tim Hortons&apos; WHEN lower(trim(chain_name)) LIKE &apos;%everyday%&apos;&#13;
      AND lower(trim(chain_name)) LIKE &apos;%roastery%&apos; THEN &apos;EDR&apos; WHEN lower(trim(chain_name)) LIKE &apos;%costa%&apos; THEN &apos;Costa&apos; ELSE &apos;Other&apos; END AS chain_grouping&#13;
      FROM coffee_vendors&#13;
      GROUP BY 1,&#13;
               2) AS ven ON (ord.vendor_id = ven.vendor_id))&#13;
SELECT daily.*,&#13;
       CASE&#13;
           WHEN daily.chain_grouping = &apos;EDR&apos; THEN edr_weekly_customers&#13;
           WHEN daily.chain_grouping = &apos;Starbucks&apos; THEN starbucks_weekly_customers&#13;
           WHEN daily.chain_grouping = &apos;Tim Hortons&apos; THEN th_weekly_customers&#13;
           WHEN daily.chain_grouping = &apos;Costa&apos; THEN costa_weekly_customers&#13;
           WHEN daily.chain_grouping = &apos;Other&apos; THEN others_weekly_customers&#13;
       END AS chain_weekly_customers,&#13;
       CASE&#13;
           WHEN daily.chain_grouping = &apos;EDR&apos; THEN coffee_weekly_customers&#13;
       END AS coffee_weekly_customers,&#13;
       CASE&#13;
           WHEN daily.chain_grouping = &apos;EDR&apos; THEN platform_weekly_customers&#13;
       END AS platform_weekly_customers,&#13;
       CASE&#13;
           WHEN daily.chain_grouping = &apos;EDR&apos; THEN edr_monthly_customers&#13;
           WHEN daily.chain_grouping = &apos;Starbucks&apos; THEN starbucks_monthly_customers&#13;
           WHEN daily.chain_grouping = &apos;Tim Hortons&apos; THEN th_monthly_customers&#13;
           WHEN daily.chain_grouping = &apos;Costa&apos; THEN costa_monthly_customers&#13;
           WHEN daily.chain_grouping = &apos;Other&apos; THEN others_monthly_customers&#13;
       END AS chain_monthly_customers,&#13;
       CASE&#13;
           WHEN daily.chain_grouping = &apos;EDR&apos; THEN coffee_monthly_customers&#13;
       END AS coffee_monthly_customers,&#13;
       CASE&#13;
           WHEN daily.chain_grouping = &apos;EDR&apos; THEN platform_monthly_customers&#13;
       END AS platform_monthly_customers,&#13;
FROM&#13;
  (SELECT DISTINCT order_date,&#13;
                   chain_grouping,&#13;
                   count(DISTINCT order_id) over(partition BY order_date, chain_grouping) AS total_orders,&#13;
                                            sum(gmv_amount_eur) over(partition BY order_date, chain_grouping) AS gmv_eur,&#13;
                                                                COUNT(DISTINCT analytical_customer_id) over(partition BY order_date, chain_grouping) AS chain_daily_customers,&#13;
                                                                                                       COUNT(DISTINCT CASE WHEN chain_grouping IS NOT NULL THEN analytical_customer_id END) over(partition BY order_date) AS coffee_customers,&#13;
                                                                                                                                                                                            COUNT(DISTINCT analytical_customer_id) over(partition BY order_date) AS platform_customers,&#13;
FROM order_data_master_set) AS daily&#13;
LEFT JOIN&#13;
(SELECT date_trunc(order_date,WEEK(MONDAY)) AS week,&#13;
        COUNT(DISTINCT analytical_customer_id) AS platform_weekly_customers,&#13;
        count(DISTINCT CASE WHEN chain_grouping IS NULL THEN analytical_customer_id END) AS coffee_weekly_customers,&#13;
        count(DISTINCT CASE WHEN chain_grouping = &apos;EDR&apos; THEN analytical_customer_id END) AS edr_weekly_customers,&#13;
        count(DISTINCT CASE WHEN chain_grouping = &apos;Starbucks&apos; THEN analytical_customer_id END) AS starbucks_weekly_customers,&#13;
        count(DISTINCT CASE WHEN chain_grouping = &apos;Costa&apos; THEN analytical_customer_id END) AS costa_weekly_customers,&#13;
        count(DISTINCT CASE WHEN chain_grouping = &apos;Tim Hortons&apos; THEN analytical_customer_id END) AS th_weekly_customers,&#13;
        count(DISTINCT CASE WHEN chain_grouping = &apos;Other&apos; THEN analytical_customer_id END) AS others_weekly_customers,&#13;
 FROM order_data_master_set&#13;
 GROUP BY 1) AS weekly ON order_date = week&#13;
LEFT JOIN&#13;
(SELECT date_trunc(order_date,MONTH) AS MONTH,&#13;
        COUNT(DISTINCT analytical_customer_id) AS platform_monthly_customers,&#13;
        count(DISTINCT CASE WHEN chain_grouping IS NULL THEN analytical_customer_id END) AS coffee_monthly_customers,&#13;
        count(DISTINCT CASE WHEN chain_grouping = &apos;EDR&apos; THEN analytical_customer_id END) AS edr_monthly_customers,&#13;
        count(DISTINCT CASE WHEN chain_grouping = &apos;Starbucks&apos; THEN analytical_customer_id END) AS starbucks_monthly_customers,&#13;
        count(DISTINCT CASE WHEN chain_grouping = &apos;Costa&apos; THEN analytical_customer_id END) AS costa_monthly_customers,&#13;
        count(DISTINCT CASE WHEN chain_grouping = &apos;Tim Hortons&apos; THEN analytical_customer_id END) AS th_monthly_customers,&#13;
        count(DISTINCT CASE WHEN chain_grouping = &apos;Other&apos; THEN analytical_customer_id END) AS others_monthly_customers,&#13;
 FROM order_data_master_set&#13;
 GROUP BY 1) AS monthly ON order_date = MONTH</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
