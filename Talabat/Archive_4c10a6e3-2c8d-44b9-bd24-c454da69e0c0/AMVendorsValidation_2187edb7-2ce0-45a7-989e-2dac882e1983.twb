          <datasource-dependencies datasource='Parameters'>
            <column caption='View By' datatype='string' name='[Parameter 14]' param-domain-type='list' role='measure' type='nominal' value='&quot;Account Manager&quot;'>
              <calculation class='tableau' formula='&quot;Account Manager&quot;' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.19mynq502xmryk146grri1yt8it3].[Calculation_1183602299462262794]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.19mynq502xmryk146grri1yt8it3].[report_date]' caption='End Date' datatype='date' name='[Parameter 2 1]' param-domain-type='range' role='measure' type='quantitative' value='#2024-05-21#'>
