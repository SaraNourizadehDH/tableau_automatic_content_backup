      <column caption='Select KPI' datatype='integer' name='[Calculation_1183602299431665667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 13]&#10;WHEN &apos;Validated Vendors&apos; then [Talabat Vendors Count (copy)_2293176692463628289]&#10;when &apos;Vendors that changed the price&apos; then [Contacted Vendors Count (copy)_2293176692466360324]&#10;when &apos;Vendors that disagreed to changed the price&apos; then [Price Changed (copy)_2293176692466774021]&#10;end' />
      </column>
      <column caption='View by' datatype='string' name='[Calculation_1183602299435851784]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 14] = &apos;Account Manager&apos; then [account_manager_name] else [country] end' />
      </column>
      <column caption='Start Date default' datatype='date' datatype-customized='true' name='[Calculation_1183602299461992457]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;,-30,today()))' />
      </column>
      <column caption='end date default' datatype='date' name='[Calculation_1183602299462262794]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY()-1' />
      </column>
      <column caption='Status' datatype='string' name='[Calculation_161848155972431873]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF isnull(ATTR([federated.1dencqb0bxep1u18rxl0d11w510b].[Timestamp])) then &apos;&apos; ELSE &apos;Contacted&apos; END' />
      </column>
      <column caption='Competition Vendors' datatype='integer' name='[Calculation_1697505217780572160]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([competitor_vendor_id])' />
      </column>
      <column caption='Validated Vendors %' datatype='real' default-format='p0.00%' name='[Calculation_2293176692464713731]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Talabat Vendors Count (copy)_2293176692463628289]/[Calculation_703476343104458754]' />
      </column>
      <column caption='rank' datatype='integer' name='[Calculation_2317172381760778240]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='RANK(max(zn([no_of_orders_last_30_days])), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Reason ' datatype='string' name='[Calculation_2550304078252093440]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([what_was_the_reason], &quot;Commission&quot;) THEN &quot;Commission&quot;&#10;ELSEIF CONTAINS([what_was_the_reason], &quot;Discount on items&quot;) THEN &quot;Discount on items&quot;&#10;ELSEIF CONTAINS([what_was_the_reason], &quot;Vendor refused to talk&quot;) THEN &quot;Vendor refused to talk&quot;&#10;ELSEIF CONTAINS([what_was_the_reason], &quot;Vendor refused - No reason given&quot;) THEN &quot;Vendor refused - No reason given&quot;&#10;ELSEIF CONTAINS([what_was_the_reason], &quot;Vendor refused - Not the right POC to discuss price changes&quot;) THEN &quot;Vendor refused - Not the right POC to discuss price changes&quot;&#10;ELSEIF CONTAINS([what_was_the_reason], &quot;Vendor refused price change - VAT Inclusive in Talabat&quot;) THEN &quot;Vendor refused price change - VAT Inclusive in Talabat&quot;&#10;ELSEIF CONTAINS([what_was_the_reason], &quot;Vendor will reach AM to update prices&quot;) THEN &quot;Vendor will reach AM to update prices&quot;&#10;ELSEIF CONTAINS([what_was_the_reason], &quot;Vendor to update price on TLB&quot;) THEN &quot;Vendor to update price on TLB&quot;&#10;ELSEIF CONTAINS([what_was_the_reason], &quot;Vendor to update price on comp&quot;) THEN &quot;Vendor to update price on comp&quot;&#10;ELSE &quot;Other&quot;&#10;END' />
      </column>
      <column caption='Reason  ' datatype='string' name='[Calculation_2677530772996509696]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 15]&#10;when &apos;What is the reason for not contacting the vendor?&apos; then [what_is_the_reason_for_not_contacting_the_vendor]&#10;when &apos;Why did the vendor not answer?&apos; then [why_did_the_vendor_not_answer]&#10;when &apos;Why did the vendor disagree to price changes?&apos; then [what_was_the_reason]&#10;end' />
      </column>
      <column caption='No. of responses' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_2677530772997472258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 15]&#10;when &apos;What is the reason for not contacting the vendor?&apos; then [Contacted Vendors (copy)_2677530772997746691]&#10;when &apos;Why did the vendor not answer?&apos; then [Vendors that Answered (copy)_2677530772997840900]&#10;when &apos;Why did the vendor disagree to price changes?&apos; then [Price Changed (copy)_2293176692466774021]&#10;end' />
      </column>
      <column caption='Disagreement %' datatype='real' default-format='p0%' name='[Calculation_271552991620603904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Price Changed (copy)_2293176692466774021]/[Talabat Vendors Count (copy)_2293176692463628289]' />
      </column>
      <column caption='Error %' datatype='real' default-format='p0%' name='[Calculation_271552991621423105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Vendor Disagreed to Change Price (copy)_1303299569865580544]/[Talabat Vendors Count (copy)_2293176692463628289]' />
      </column>
      <column caption='Filter (Percent of Diff)' datatype='boolean' name='[Calculation_2892929446686253057]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_2892929446685126656] &gt; 0' />
      </column>
      <column caption='Hide Null' datatype='boolean' name='[Calculation_3103683835760709633]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX()!=1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='checking data' datatype='integer' name='[Calculation_3405565766266728450]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Contacted Vendors Count (copy)_2293176692466360324] + [Price Changed (copy)_2293176692466774021] + [Vendor Disagreed to Change Price (copy)_1303299569865580544]' />
      </column>
      <column caption='Contacted Vendors' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_5801269692981075968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;if [did_you_contact_the_vendor] = &apos;Yes&apos; then &#10;[talabat_vendor_id] END)' />
      </column>
      <column caption='Did the vendor agree to change price?' datatype='string' name='[Calculation_6153605995088601091]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if  ISNULL([did_the_vendor_agree_to_price_changes_2]) then [did_the_vendor_agree_to_price_changes] end' />
