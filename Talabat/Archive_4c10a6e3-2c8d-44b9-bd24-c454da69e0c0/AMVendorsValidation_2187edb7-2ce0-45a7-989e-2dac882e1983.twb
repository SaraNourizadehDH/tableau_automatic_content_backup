            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.19mynq502xmryk146grri1yt8it3].[Calculation_1183602299461992457]' _.fcp.RefreshableParameterRanges.true...source-field='[federated.19mynq502xmryk146grri1yt8it3].[report_date]' caption='Start Date' datatype='date' name='[Start Date (copy)_2116410361341648896]' param-domain-type='range' role='measure' type='quantitative' value='#2024-05-21#'>
              <calculation class='tableau' formula='#2024-05-21#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.19mynq502xmryk146grri1yt8it3'>
            <column caption='View by' datatype='string' name='[Calculation_1183602299435851784]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 14] = &apos;Account Manager&apos; then [account_manager_name] else [country] end' />
            </column>
            <column caption='Start Date default' datatype='date' datatype-customized='true' name='[Calculation_1183602299461992457]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;,-30,today()))' />
            </column>
            <column caption='end date default' datatype='date' name='[Calculation_1183602299462262794]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY()-1' />
            </column>
            <column caption='Reason ' datatype='string' name='[Calculation_2550304078252093440]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([what_was_the_reason], &quot;Commission&quot;) THEN &quot;Commission&quot;&#10;ELSEIF CONTAINS([what_was_the_reason], &quot;Discount on items&quot;) THEN &quot;Discount on items&quot;&#10;ELSEIF CONTAINS([what_was_the_reason], &quot;Vendor refused to talk&quot;) THEN &quot;Vendor refused to talk&quot;&#10;ELSEIF CONTAINS([what_was_the_reason], &quot;Vendor refused - No reason given&quot;) THEN &quot;Vendor refused - No reason given&quot;&#10;ELSEIF CONTAINS([what_was_the_reason], &quot;Vendor refused - Not the right POC to discuss price changes&quot;) THEN &quot;Vendor refused - Not the right POC to discuss price changes&quot;&#10;ELSEIF CONTAINS([what_was_the_reason], &quot;Vendor refused price change - VAT Inclusive in Talabat&quot;) THEN &quot;Vendor refused price change - VAT Inclusive in Talabat&quot;&#10;ELSEIF CONTAINS([what_was_the_reason], &quot;Vendor will reach AM to update prices&quot;) THEN &quot;Vendor will reach AM to update prices&quot;&#10;ELSEIF CONTAINS([what_was_the_reason], &quot;Vendor to update price on TLB&quot;) THEN &quot;Vendor to update price on TLB&quot;&#10;ELSEIF CONTAINS([what_was_the_reason], &quot;Vendor to update price on comp&quot;) THEN &quot;Vendor to update price on comp&quot;&#10;ELSE &quot;Other&quot;&#10;END' />
            </column>
            <column caption='Disagreement %' datatype='real' default-format='p0%' name='[Calculation_271552991620603904]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Price Changed (copy)_2293176692466774021]/[Talabat Vendors Count (copy)_2293176692463628289]' />
            </column>
            <column caption='Error %' datatype='real' default-format='p0%' name='[Calculation_271552991621423105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Vendor Disagreed to Change Price (copy)_1303299569865580544]/[Talabat Vendors Count (copy)_2293176692463628289]' />
            </column>
            <column caption='Contacted Vendors' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_5801269692981075968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;if [did_you_contact_the_vendor] = &apos;Yes&apos; then &#10;[talabat_vendor_id] END)' />
            </column>
            <column caption='Talabat Vendors Count' datatype='integer' name='[Calculation_703476343104458754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([talabat_vendor_id])' />
            </column>
            <column caption='Vendors that Answered' datatype='integer' default-format='n#,##0;-#,##0' name='[Contacted Vendor (copy)_6153605995085041664]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;if [did_the_vendor_answer] = &apos;Yes&apos; then &#10;[talabat_vendor_id] END)' />
            </column>
            <column caption='Price Changed' datatype='integer' name='[Contacted Vendors Count (copy)_2293176692466360324]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;if [did_the_vendor_agree_to_price_changes] = &apos;Yes&apos; then &#10;[talabat_vendor_id] END)' />
            </column>
            <column caption='Date Range' datatype='string' name='[Date (copy)_57139472113504261]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [report_date] &gt;= [Parameters].[Start Date (copy)_2116410361341648896] and [report_date] &lt;= [Parameters].[Parameter 2 1]&#10;then &apos;Selected Period&apos;  &#10;&#10;&#10;&#10;ELSE &apos;Remaining Days&apos;&#10;end' />
            </column>
            <column caption='Disagreed to Change Price' datatype='integer' name='[Price Changed (copy)_2293176692466774021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;if [did_the_vendor_agree_to_price_changes] = &apos;No&apos; then [talabat_vendor_id]&#10;ELSEIF [did_the_vendor_agree_to_price_changes_2]  = &apos;No&apos; then &#10;[talabat_vendor_id] &#10;&#10;END)' />
            </column>
            <column caption='Validated Vendors Count' datatype='integer' name='[Talabat Vendors Count (copy)_2293176692463628289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;if ISNULL([is_price_imparity_present_for_this_vendor]) then null else&#10;[talabat_vendor_id] END)' />
            </column>
            <column caption='Price Change %' datatype='real' default-format='p0%' name='[Validated Vendors % (copy)_1303299569866051585]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Contacted Vendors Count (copy)_2293176692466360324]/[Talabat Vendors Count (copy)_2293176692463628289]' />
            </column>
            <column caption='Total Form Entries' datatype='integer' default-format='n#,##0;-#,##0' name='[Validated Vendors Count (copy) (copy)_3405565766258995201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(&#10;[talabat_vendor_id] )' />
            </column>
            <column caption='Imparity Not Present' datatype='integer' name='[Vendor Disagreed to Change Price (copy)_1303299569865580544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;if [is_price_imparity_present_for_this_vendor] = &apos;No&apos; then &#10;[talabat_vendor_id] END)' />
            </column>
