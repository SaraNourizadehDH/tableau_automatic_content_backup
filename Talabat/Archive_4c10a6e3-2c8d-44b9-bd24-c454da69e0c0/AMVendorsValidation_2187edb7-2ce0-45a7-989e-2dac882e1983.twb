      <column caption='Conversion - Competiton Vendors to Matched Vendors' datatype='real' default-format='p0.0%' name='[Calculation_71213173101961219]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Competition Vendor Count (copy)_1697505217781608450] / [Calculation_1697505217780572160]' />
