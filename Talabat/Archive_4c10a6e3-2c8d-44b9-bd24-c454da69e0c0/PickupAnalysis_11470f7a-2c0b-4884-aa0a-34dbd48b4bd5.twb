      <aliases enabled='yes' />
      <column caption='Avg. Daily Orders' datatype='real' name='[Calculation_1333909971241140224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) /&#13;&#10;SUM(&#13;&#10;{ FIXED [month]:&#13;&#10;MIN(&#13;&#10;IF MONTH([month]) = MONTH(TODAY()) and YEAR([month])=YEAR(TODAY()) THEN&#13;&#10;(DAY(TODAY()) - 1)&#13;&#10;//DAY([max_date])&#13;&#10;&#13;&#10;ELSE&#13;&#10;DAY(DATEADD(&apos;day&apos;, -1,DATEADD(&apos;month&apos;, 1,DATETRUNC(&apos;month&apos;, [month]))))&#13;&#10;END&#13;&#10;)&#13;&#10;}&#13;&#10;)' />
      </column>
      <column caption='Frequency' datatype='real' name='[Calculation_958140877295210497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([orders]) / SUM([maus])' />
      </column>
      <column caption='AFV' datatype='real' name='[Calculation_958140877295747074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([basket_amount]) / SUM([orders])' />
      </column>
      <column caption='retnetion calc' datatype='real' name='[Calculation_958140877298077699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[retained_customers] / [maus]' />
      </column>
      <column caption='Calculation1' datatype='datetime' name='[Calculation_958140877299388420]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;month&apos;, 1, [month])' />
      </column>
