      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_547F18AF28714B55BB16B1CC21BB4463'>
            <properties context=''>
              <relation connection='bigquery.17iqwpn11oah8210i9dnj1bhuuiq' name='Custom SQL Query' type='text'>with users as &#13;
(&#13;
  select &#13;
  distinct date_trunc(order_date, month) month, delivery_arrangement, country_iso, analytical_customer_id, &#13;
  count(*) as orders,&#13;
  sum(basket_amount_lc) basket_amount_lc,&#13;
&#13;
  from `tlb-data-prod.data_platform.fct_order_info`&#13;
&#13;
  where order_date&gt;&gt;=&apos;2024-01-01&apos; and is_successful and not is_test &#13;
  and not is_darkstore and not is_nfv --and country_id=9&#13;
  group by 1,2,3,4&#13;
)&#13;
&#13;
select *,&#13;
&#13;
lag(retention_old,1) over(partition by delivery_arrangement, country_iso order by month) as retention,&#13;
&#13;
from&#13;
(&#13;
select &#13;
p.month,&#13;
p.delivery_arrangement,&#13;
p.country_iso,&#13;
&#13;
-- sum(p.orders) / count(distinct p.analytical_customer_id) as freq,&#13;
count(distinct c.analytical_customer_id) / count(distinct(p.analytical_customer_id)) * 100 as retention_old,&#13;
-- sum(p.basket_amount_lc) / sum(p.orders) as AFV,&#13;
&#13;
count(distinct(p.analytical_customer_id)) as maus,&#13;
sum(p.basket_amount_lc) as basket_amount,&#13;
sum(p.orders) as orders,&#13;
count(distinct c.analytical_customer_id) as retained_customers,&#13;
&#13;
from users as p&#13;
left join users as c &#13;
  on p.analytical_customer_id=c.analytical_customer_id and p.month=date_sub(c.month, INTERVAL 1 MONTH) and p.delivery_arrangement=c.delivery_arrangement and p.country_iso=c.country_iso&#13;
&#13;
group by p.month,2,3&#13;
order by p.month,2,3&#13;
)&#13;
order by 1,2,3</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
