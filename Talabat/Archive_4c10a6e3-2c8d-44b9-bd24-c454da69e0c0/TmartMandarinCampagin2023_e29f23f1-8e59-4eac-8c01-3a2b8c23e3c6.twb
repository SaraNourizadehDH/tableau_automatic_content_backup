      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1rj093o1hpki7a13tg9vk13ydeoh].[pcto:sum:saving (copy)_1194790912130088970:qk]&quot;' value='% of total saving' />
          <alias key='&quot;[federated.1rj093o1hpki7a13tg9vk13ydeoh].[pcto:usr:Calculation_1194790912073809920:qk]&quot;' value='% of total fraud' />
          <alias key='&quot;[federated.1rj093o1hpki7a13tg9vk13ydeoh].[sum:Calculation_1194790912088481798:qk]&quot;' value='saving_lc' />
        </aliases>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1194790912088481798]) / TOTAL(SUM([Calculation_1194790912088481798]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='fraud_request_count' datatype='integer' name='[Calculation_1194790912073809920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD (if [is_actionable] and [is_tmr_rule]  then [reference_id] END)' />
      </column>
      <column caption='request_count' datatype='integer' name='[Calculation_1194790912075255809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([reference_id])' />
      </column>
      <column caption='customer_count' datatype='integer' name='[Calculation_1194790912083718146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_id])' />
      </column>
      <column caption='fraud_customer_count' datatype='integer' name='[Calculation_1194790912083841027]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD (if [is_actionable] and [is_tmr_rule] then [customer_id] END)' />
      </column>
      <column caption='fraud_rate' datatype='real' name='[Calculation_1194790912084168708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1194790912073809920]/[Calculation_1194790912075255809]' />
      </column>
      <column caption='saving' datatype='real' name='[Calculation_1194790912088481798]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [reference_id] : MAX(IF [is_actionable] and [is_tmr_rule]  THEN [saving_amt_lc] ELSE 0 END)}' />
      </column>
      <column caption='Time' datatype='datetime' name='[Calculation_1194790912509841419]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [country_id] WHEN 4 then DATEADD(&apos;hour&apos;,4,[ingestion_time_utc]) &#10;else DATEADD(&apos;hour&apos;,2,[ingestion_time_utc])  end' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_4DDE3158A6834C0099CC315A2FF8214A]' role='measure' type='quantitative' />
