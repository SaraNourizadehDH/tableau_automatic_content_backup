  <datasources>
    <datasource caption='Custom SQL Query (data_platform_work_tables)' inline='true' name='federated.1rj093o1hpki7a13tg9vk13ydeoh' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0zr5no0130h8ae1clzvre1izbyh4'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform_work_tables' server-oauth='' username='mrehim@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0zr5no0130h8ae1clzvre1izbyh4' name='Custom SQL Query' type='text'>with exchange_rate as (SELECT c.exchange_rate_date,
                              c.exchange_rate_to_eur,
                              n.Id as country_id
                       FROM `tlb-data-prod`.data_platform.fct_currency_conversion c
                                inner join `tlb-data-prod`.data_platform_maindb.mwq_Country n
                                           on c.country_iso = n.Code),

     orders as (select distinct req.ingestion_time_utc,
                                req.reference_id,
                                req.is_fraud,
                                req.is_actionable,
                                customer_id,
                                actionable_rule_list,
                                cast(JSON_EXTRACT_SCALAR(request_body,
                                                         &quot;$.TalabatCountry.Id&quot;) as int64)                                                                       country_id,
                                JSON_EXTRACT_SCALAR(request_body,
                                                    &quot;$.TalabatCountry.Code&quot;)                                                                                    country,
                                cast(JSON_EXTRACT_SCALAR(request_body,
                                                         &quot;$.order.Vendor.ChainId&quot;) as int64)                                                                    chain_id,
                                cast(JSON_EXTRACT_SCALAR(request_body,
                                                         &quot;$.order.Vendor.Id&quot;) as int64)                                                                         vendor_id,
                                JSON_EXTRACT_SCALAR(request_body,
                                                    &quot;$.order.Customer.Delivery.Address.AreaId&quot;)                                                                 area_id,
                                JSON_EXTRACT_SCALAR(request_body,
                                                    &quot;$.order.Customer.Delivery.Address.Area&quot;)                                                                   area_name,
                                case
                                    when req.is_actionable then cast(JSON_EXTRACT_SCALAR(request_body,
                                                                                         &quot;$.order.AdditionalInfo.PricingMetadata.CalculateRequest.MenuDiscount&quot;) as float64)
                                    else 0 end                                                                                                                  saving_amt_lc,
                                round(safe_divide(cast(JSON_EXTRACT_SCALAR(request_body,
                                                                           &quot;$.order.AdditionalInfo.PricingMetadata.CalculateRequest.MenuDiscount&quot;) as float64),
                                                  cast(JSON_EXTRACT_SCALAR(request_body,
                                                                           &quot;$.order.AdditionalInfo.PricingMetadata.CalculateRequest.Subtotal&quot;) as float64)),
                                      2) as                                                                                                                     discount_percentage,
                                ROW_NUMBER() over (partition by DATE_TRUNC(ingestion_time_utc, MINUTE), customer_id, is_actionable order by ingestion_time_utc) actionable_attempt_rank
                from `tlb-data-prod`.data_platform_work_tables.fct_shield_request_log req
                where date(req.ingestion_time_utc) between &apos;2023-03-15&apos; and &apos;2023-03-21&apos;
                  and req.workflow = &apos;NexusOrderValidation&apos;
                  and cast(JSON_EXTRACT_SCALAR(request_body,
                                               &quot;$.order.AdditionalInfo.PricingMetadata.CalculateRequest.MenuDiscount&quot;) as float64) &gt;&gt;
                      0
                order by req.ingestion_time_utc desc)

select o.ingestion_time_utc,
       o.reference_id,
       o.is_fraud,
       o.is_actionable,
       o.customer_id,
       o.actionable_rule_list,
       o.country_id,
       o.country,
       o.chain_id,
       o.vendor_id,
       o.area_id,
       o.area_name,
       o.discount_percentage,
       o.actionable_attempt_rank,
       case when actionable_attempt_rank = 1 then saving_amt_lc else 0 end    as saving_amt_lc,
       case
           when actionable_attempt_rank = 1 then cast((saving_amt_lc / er.exchange_rate_to_eur) as float64)
           else 0 end                                                         as
                                                                                 saving_amt_eur,
       case when actionable_rule_list like &apos;%_tmr_%&apos; then true else false end as is_tmr_rule
from orders o
         left join exchange_rate er
                   on er.country_id = o.country_id and er.exchange_rate_date = date(o.ingestion_time_utc)
where chain_id in (25065, 607445)
  and discount_percentage &gt;&gt;= 0.5</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
