  <worksheets>
    <worksheet name='Master'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Pro bulk sales - daily user subscribed successful count</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run>* This is not the SOURCE OF TRUTH. It&apos;s using FrontEnd&apos;s data &amp; it is known the FE data has slight discrepanyc with Backend data
* Please reach out to tPro Engineer for the exact source of truth data
* This numbers here only serve as a directional guidance on Pro Bulk Sales subscription completed events.
* It is the COUNT DISTINCT of users who subscribed successfully through Bulk Sales
* It also consider same user who subscribed multiple voucher code </run>
            <run bold='true'>= 1</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.0ad9isn07n4na1123j27102nr8le' />
          </datasources>
          <datasource-dependencies datasource='federated.0ad9isn07n4na1123j27102nr8le'>
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column-instance column='[date]' derivation='Day' name='[dy:date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[date]' derivation='Month' name='[mn:date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[user_count]' derivation='Sum' name='[sum:user_count:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[user_count]' role='measure' type='quantitative' />
            <column-instance column='[date]' derivation='Year' name='[yr:date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.0ad9isn07n4na1123j27102nr8le].[sum:user_count:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows total='true'>([federated.0ad9isn07n4na1123j27102nr8le].[yr:date:ok] / ([federated.0ad9isn07n4na1123j27102nr8le].[mn:date:ok] / [federated.0ad9isn07n4na1123j27102nr8le].[dy:date:ok]))</rows>
        <cols />
      </table>
      <simple-id uuid='{41BA8A16-A0A2-43B3-8CB6-449851941568}' />
    </worksheet>
