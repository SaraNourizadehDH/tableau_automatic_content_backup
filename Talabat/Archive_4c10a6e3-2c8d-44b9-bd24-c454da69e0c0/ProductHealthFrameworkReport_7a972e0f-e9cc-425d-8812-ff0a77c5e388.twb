    <datasource caption='Product health framework' inline='true' name='federated.05rsr5q0jrv3gj1f4ltbd1aucpe9' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0gorr4q0rdnl5v1fdkaas1plpdfg'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_playground_finding' server-oauth='' username='mvastare@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0gorr4q0rdnl5v1fdkaas1plpdfg' name='Custom SQL Query' type='text'><![CDATA[with a as (select * ,
date_sub(date,INTERVAL 1 month) as lm_date,
from `tlb-data-prod.data_platform.agg_product_health_framework_kpi_daily` 
where all_customers_rolling30 <<>> 0),
b as (
  select *
from `tlb-data-prod.data_platform.agg_product_health_framework_kpi_daily` 
where all_customers_rolling30 <<>> 0
),
lm as (
select a.*,
b.all_customers_mtd as lm_all_customers_mtd,
b.offering_interacted_customers_lifetime_mtd lm_offering_interacted_customers_lifetime_mtd,
b.offering_converted_customers_lifetime_mtd lm_offering_converted_customers_lifetime_mtd,
b.offering_clicked_customers_lifetime_mtd lm_offering_clicked_customers_lifetime_mtd,
b.offering_interacted_customers_mtd lm_offering_interacted_customers_mtd,
b.offering_converted_customers_mtd lm_offering_converted_customers_mtd,
b.offering_clicked_customers_mtd lm_offering_clicked_customers_mtd,
b.offerings_acquired_user_mtd lm_offerings_acquired_user_mtd,
b.offerings_retained_user_mtd lm_offerings_retained_user_mtd,
from a left join b 
on a.lm_date = b.date
and a.country = b.country
and a.offering_type = b.offering_type
)

select * from lm]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0gorr4q0rdnl5v1fdkaas1plpdfg' name='Custom SQL Query' type='text'><![CDATA[with a as (select * ,
date_sub(date,INTERVAL 1 month) as lm_date,
from `tlb-data-prod.data_platform.agg_product_health_framework_kpi_daily` 
where all_customers_rolling30 <<>> 0),
b as (
  select *
from `tlb-data-prod.data_platform.agg_product_health_framework_kpi_daily` 
where all_customers_rolling30 <<>> 0
),
lm as (
select a.*,
b.all_customers_mtd as lm_all_customers_mtd,
b.offering_interacted_customers_lifetime_mtd lm_offering_interacted_customers_lifetime_mtd,
b.offering_converted_customers_lifetime_mtd lm_offering_converted_customers_lifetime_mtd,
b.offering_clicked_customers_lifetime_mtd lm_offering_clicked_customers_lifetime_mtd,
b.offering_interacted_customers_mtd lm_offering_interacted_customers_mtd,
b.offering_converted_customers_mtd lm_offering_converted_customers_mtd,
b.offering_clicked_customers_mtd lm_offering_clicked_customers_mtd,
b.offerings_acquired_user_mtd lm_offerings_acquired_user_mtd,
b.offerings_retained_user_mtd lm_offerings_retained_user_mtd,
from a left join b 
on a.lm_date = b.date
and a.country = b.country
and a.offering_type = b.offering_type
)

select * from lm]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
