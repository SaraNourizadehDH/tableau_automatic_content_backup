            </column>
            <column caption='Select Metric (MTD)' datatype='integer' name='[Calculation_1816639535255629840]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1] &#10;WHEN &apos;Active Customers&apos; THEN sum([all_customers_mtd])&#10;//WHEN &apos;Lifetime Clicked Rate&apos; THEN [Lifetime Clicked Rate MTD]&#10;//WHEN &apos;Lifetime Interaction Rate&apos; THEN [Lifetime Interaction Rate MTD]&#10;//WHEN &apos;Lifetime Conversion Rate&apos; THEN [Lifetime Conversion Rate MTD]&#10;//WHEN &apos;Monthly Interaction Rate&apos; THEN [Monthly Interaction Rate MTD]&#10;//WHEN &apos;Monthly Conversion Rate&apos; THEN [Monthly Conversion Rate MTD]&#10;//WHEN &apos;Monthly Acquisition Rate&apos; THEN [Monthly Acquisition Rate MTD]&#10;//WHEN &apos;Monthly Retention Rate&apos; THEN [Monthly Retention Rate MTD]&#10;//WHEN &apos;% Customers yet to be acquired&apos; THEN [% Customers yet to be acquired MTD]&#10;END' />
            </column>
            <column caption='Last day of the month filter' datatype='integer' name='[Calculation_1816639535300874265]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='LAST()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Lifetime Interaction Rate MTD' datatype='real' default-format='p0.00%' name='[Calculation_1970324871097565184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offering_interacted_customers_lifetime_mtd])&#10;/sum([all_customers_mtd])' />
            </column>
            <column caption='Lifetime Clicked Rate MTD' datatype='real' default-format='p0.00%' name='[Calculation_1970324871177891841]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offering_clicked_customers_lifetime_mtd])/sum([all_customers_mtd])' />
            </column>
            <column caption='Lifetime Conversion Rate MTD' datatype='real' default-format='p0.00%' name='[Calculation_1970324871178207234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offering_converted_customers_lifetime_mtd])/&#10;sum([all_customers_mtd])' />
            </column>
            <column caption='Monthly Interaction Rate MTD' datatype='real' default-format='p0.00%' name='[Calculation_1970324872226476035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offering_interacted_customers_mtd])/&#10;sum([all_customers_mtd])' />
            </column>
            <column caption='Monthly Conversion Rate MTD' datatype='real' default-format='p0.00%' name='[Calculation_1970324872226856964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offering_converted_customers_mtd])/&#10;sum([all_customers_mtd])' />
