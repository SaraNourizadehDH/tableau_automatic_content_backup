            <column caption='Monthly Acquisition Rate MTD' datatype='real' default-format='p0.00%' name='[Calculation_1970324872227217413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offerings_acquired_user_mtd])/sum([all_customers_mtd])' />
            </column>
            <column caption='Monthly Return Rate MTD' datatype='real' default-format='p0.00%' name='[Calculation_1970324872227336198]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offerings_retained_user_mtd])/sum([all_customers_mtd])' />
            </column>
            <column caption='Customers yet to be acquired to offering MTD' datatype='integer' name='[Calculation_1970324872227536903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([all_customers_mtd]) - &#10;&#10;sum([offering_converted_customers_lifetime_mtd])&#10;&#10;&#10;//(sum([offerings_acquired_user_mtd])+sum([offering_converted_customers_lifetime_mtd]))' />
