      <table>
        <view>
          <datasources>
            <datasource caption='Product health framework' name='federated.05rsr5q0jrv3gj1f4ltbd1aucpe9' />
          </datasources>
          <datasource-dependencies datasource='federated.05rsr5q0jrv3gj1f4ltbd1aucpe9'>
            <column caption='Date filter 3' datatype='boolean' name='[Calculation_1816639535252963338]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[date] = &#10;DATEADD(&apos;day&apos;, -1, &#10;DATEADD(&apos;month&apos;, -1, DATETRUNC(&apos;month&apos;, {MAX(date)}))&#10;)' />
            </column>
            <column caption='% Customers yet to be acquired MTD' datatype='real' default-format='p0.00%' name='[Calculation_1816639535254441998]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1970324872227536903]/&#10;sum([all_customers_mtd])' />
            </column>
            <column caption='Lifetime Interaction Rate MTD' datatype='real' default-format='p0.00%' name='[Calculation_1970324871097565184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offering_interacted_customers_lifetime_mtd])&#10;/sum([all_customers_mtd])' />
            </column>
            <column caption='Lifetime Conversion Rate MTD' datatype='real' default-format='p0.00%' name='[Calculation_1970324871178207234]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offering_converted_customers_lifetime_mtd])/&#10;sum([all_customers_mtd])' />
            </column>
            <column caption='Monthly Interaction Rate MTD' datatype='real' default-format='p0.00%' name='[Calculation_1970324872226476035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offering_interacted_customers_mtd])/&#10;sum([all_customers_mtd])' />
            </column>
            <column caption='Monthly Conversion Rate MTD' datatype='real' default-format='p0.00%' name='[Calculation_1970324872226856964]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offering_converted_customers_mtd])/&#10;sum([all_customers_mtd])' />
            </column>
            <column caption='Monthly Acquisition Rate MTD' datatype='real' default-format='p0.00%' name='[Calculation_1970324872227217413]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offerings_acquired_user_mtd])/sum([all_customers_mtd])' />
            </column>
            <column caption='Monthly Return Rate MTD' datatype='real' default-format='p0.00%' name='[Calculation_1970324872227336198]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offerings_retained_user_mtd])/sum([all_customers_mtd])' />
            </column>
            <column caption='Customers yet to be acquired to offering MTD' datatype='integer' name='[Calculation_1970324872227536903]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([all_customers_mtd]) - &#10;&#10;sum([offering_converted_customers_lifetime_mtd])&#10;&#10;&#10;//(sum([offerings_acquired_user_mtd])+sum([offering_converted_customers_lifetime_mtd]))' />
            </column>
            <column caption='Lifetime Clicked Rate Rolling30' datatype='real' default-format='p0.00%' name='[Lifetime Clicked Rate MTD (copy)_1816639535246868480]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([offering_clicked_customers_lifetime_rolling30])&#10;/sum([all_customers_rolling30])' />
            </column>
