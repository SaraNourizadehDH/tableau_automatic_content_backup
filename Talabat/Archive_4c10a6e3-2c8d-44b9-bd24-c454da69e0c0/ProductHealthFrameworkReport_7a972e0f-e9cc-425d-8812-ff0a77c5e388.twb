    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Metric Definitions Tab'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/ProductHealthFrameworkReport/MetricDefinitionsTab?rev=' id='MetricDefinitionsTab' path='/t/Talabat/workbooks/ProductHealthFrameworkReport' revision='' site='Talabat' />
      <style>
        <style-rule element='dash-text'>
          <format attr='vertical-align' id='dash-text_5' value='top' />
        </style-rule>
      </style>
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='91625' id='5' type-v2='text' w='98400' x='800' y='7375'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontsize='14'>Our vision:</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000'>We aim to increase customer awareness for our various verticals and ecosystem products, namely our Non food verticals, tPro and Pickup. Increased awareness has the potential to increase orders, subscriptions from the ecosystem offerings, ultimately increasing customer stickiness to the platform</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000' fontsize='14'>Metric Definitions:</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>Active Customers: </run>
              <run fontcolor='#000000'>No. of customers with atleast one order in the given time period</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>Lifetime Interaction Rate: </run>
              <run fontcolor='#000000'>#Active customers in the given time period that have interacted with </run>
              <run fontcolor='#000000' italic='true'>(in form of clicks to different entry points on app)</run>
              <run fontcolor='#000000'> or converted to the vertical or ecosystem product in their lifetime / #Active customers in the same period</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>Lifetime Conversion Rate: </run>
              <run fontcolor='#000000'>#Active customers in the given time period that have converted to the vertical or ecosystem product in their lifetime / #Active customers in the same period</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>Monthly Interaction Rate: </run>
              <run fontcolor='#000000'>#Active customers in the given time period that have interacted with </run>
              <run fontcolor='#000000' italic='true'>(in form of clicks to different entry points on app) </run>
              <run fontcolor='#000000'>or converted to the vertical or ecosystem product in the given month / #Active customers in the same period</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>Monthly Conversion Rate: </run>
              <run fontcolor='#000000'>#Active customers in the given time period that have converted to the vertical or ecosystem product in the given month / #Active customers in the same period</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' italic='true'>In case of tPro - tPro subscriptions in a given month / #Active customers in the same period</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>Monthly Acquisition Rate: </run>
              <run fontcolor='#000000'>#Active customers in the given time period that have been acquired to the vertical or ecosystem product in the given month (Converted or subscribed for the first time) / #Active customers in the same period</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>Monthly Return Rate: </run>
              <run fontcolor='#000000'>#Active customers in the given time period that are returning customers (not acquisitions) to the vertical or ecosystem product in the given month / #Active customers in the same period</run>
              <run>Æ&#10;&#10;</run>
              <run bold='true' fontcolor='#000000'>%Customers yet to be acquired: </run>
              <run fontcolor='#000000'>#Active customers in the given time period that have not been acquired to OR are have not converted in their lifetime to the vertical or ecosystem product in the given month / #Active customers in the same period</run>
              <run>Æ&#10;&#10;&#10;&#10;&#10;&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='6375' id='6' type-v2='text' w='98400' x='800' y='1000'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='15'>Product Health Framework KPI Dashboard</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#ff5a00ce' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
