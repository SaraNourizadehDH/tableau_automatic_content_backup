      <table>
        <view>
          <datasources>
            <datasource caption='Product health framework' name='federated.05rsr5q0jrv3gj1f4ltbd1aucpe9' />
          </datasources>
          <datasource-dependencies datasource='federated.05rsr5q0jrv3gj1f4ltbd1aucpe9'>
            <column caption='% LM Customers yet to be acquired MTD' datatype='real' default-format='p0.00%' name='[% Customers yet to be acquired MTD (copy)_1816639535644999735]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Customers yet to be acquired to offering MTD (copy)_1816639535645069368]/&#10;sum([lm_all_customers_mtd])' />
            </column>
            <column caption='% Customers yet to be acquired MTD' datatype='real' default-format='p0.00%' name='[Calculation_1816639535254441998]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1970324872227536903]/&#10;sum([all_customers_mtd])' />
            </column>
            <column caption='Active Customers MoM' datatype='real' name='[Calculation_1816639535580405810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([all_customers_mtd])/sum([lm_all_customers_mtd]))&#10;- 1' />
            </column>
            <column caption='LM Monthly Interaction Rate MTD' datatype='real' name='[Calculation_1816639535644282931]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([lm_offering_interacted_customers_mtd])/&#10;sum([lm_all_customers_mtd])' />
            </column>
            <column caption='Monthly Interaction Rate MoM' datatype='real' name='[Calculation_1816639535660073020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1970324872226476035] / &#10;[Calculation_1816639535644282931]) -1' />
            </column>
            <column caption='Monthly Conversion Rate MoM' datatype='real' name='[Calculation_1816639535660257341]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1970324872226856964]/[Monthly Conversion Rate MTD (copy)_1816639535644643381]) - 1' />
            </column>
            <column caption='Monthly Acquisition Rate MoM' datatype='real' name='[Calculation_1816639535660408894]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1970324872227217413]/[Monthly Acquisition Rate MTD (copy)_1816639535644405812]) - 1' />
