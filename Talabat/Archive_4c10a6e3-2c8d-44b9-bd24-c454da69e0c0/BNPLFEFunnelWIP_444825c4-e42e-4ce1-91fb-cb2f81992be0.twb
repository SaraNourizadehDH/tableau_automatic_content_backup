    <worksheet name='BNPL Checkout Main KPIs'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.0jcc7mc0kl1rg113oes7e08b1tds' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;BNPL Conversion Rate After Choosing&quot;'>
              <calculation class='tableau' formula='&quot;BNPL Conversion Rate After Choosing&quot;' />
            </column>
            <column caption='Start Date' datatype='date' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2024-04-04#'>
              <calculation class='tableau' formula='#2024-04-04#' />
            </column>
            <column caption='End Date' datatype='date' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='#2024-04-04#'>
              <calculation class='tableau' formula='#2024-04-04#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0jcc7mc0kl1rg113oes7e08b1tds'>
            <column caption='BNPL Max Amount&amp; Limit Validation Rate' datatype='real' default-format='p0.0%' name='[BNPL Bottom sheet loaded rate (copy)_1768436944290148352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(case [Bnpl_validation_error] &#10;when &apos;Max Balance&apos; then&#10;[bnpl_validation_shown] &#10;when &apos;Max Limit&apos; then&#10;[bnpl_validation_shown] &#10;when &apos;Balance&lt;Order&apos; then&#10;[bnpl_validation_shown] &#10;when &apos;Balance&lt;Order &amp; Order&gt;Limit&apos; then&#10;[bnpl_validation_shown] &#10;when &apos;Balance&lt;Order &amp; Order&lt;Limit&apos; then&#10;[bnpl_validation_shown] end)/sum([bnpl_chosen])' />
            </column>
            <column caption='BNPL Conversion Rate After Choosing' datatype='real' default-format='p0.00%' name='[BNPL Conversion Rate (copy)_692358124638728192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([bnpl_success])/sum([bnpl_chosen])' />
            </column>
            <column caption='BNPL Min Amount Validation Rate' datatype='real' default-format='p0.0%' name='[BNPL Max Amount&amp; Limit Validation Rate (copy)_1768436944292392962]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(case [Bnpl_validation_error] when &apos;Min Amount&apos; then&#10;[bnpl_validation_shown] when &apos;Balance&lt;Min Amount&apos; then&#10;[bnpl_validation_shown] &#10; end)/sum([bnpl_chosen])' />
            </column>
            <column caption='BNPL Overdue Payment Validation Rate' datatype='real' default-format='p0.0%' name='[BNPL Min Amount Validation Rate (copy)_1768436944293040132]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(case [Bnpl_validation_error] when &apos;Overdue Payment&apos; then&#10;[bnpl_validation_shown] &#10; end)/sum([bnpl_chosen])' />
            </column>
            <column caption='BNPL place order failed rate' datatype='real' default-format='p0.0%' name='[BNPL order placed successfully rate (copy)_1436648309132972034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([bnpl_failed])/sum([bnpl_attempted_place_order])' />
            </column>
            <column caption='BNPL Conversion Rate' datatype='real' default-format='p0.00%' name='[BNPL order placed successfully rate (copy)_45950822513897472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([bnpl_success])/sum([bnpl_eligible])' />
            </column>
            <column datatype='string' name='[Bnpl_validation_error]' role='dimension' type='nominal' />
            <column caption='Date Period' datatype='string' name='[Calculation_1436648309108174848]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [date]&gt;=[Parameters].[Parameter 3] &#10;and [date]&lt;=[Parameters].[Parameter 4] then &apos;Selected Period&apos;&#10;ELSEIF [date]&gt;=[Parameters].[Parameter 3]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 3], [Parameters].[Parameter 4])+1)&#10;and [date]&lt;=[Parameters].[Parameter 4]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 3], [Parameters].[Parameter 4])+1)&#10;then &apos;Comparison Period&apos;&#10;ELSE &apos;Remaining days&apos;&#10;end' />
            </column>
            <column caption='BNPL eligible rate' datatype='real' default-format='p0.0%' name='[Calculation_3420061729311842304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([bnpl_eligible])/sum([checkout_loaded])' />
            </column>
            <column caption='BNPL choosing rate' datatype='real' default-format='p0.0%' name='[Calculation_3420061729311985665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([bnpl_chosen])/sum([bnpl_eligible])' />
            </column>
            <column caption='BNPL bottom sheet loaded' datatype='integer' name='[Calculation_3420061729314242563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[bnpl_chosen]-[bnpl_validation_shown]' />
            </column>
            <column caption='BNPL Bottom sheet loaded rate' datatype='real' default-format='p0.0%' name='[Calculation_3420061729314869252]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_3420061729314242563])/sum([bnpl_chosen])' />
            </column>
            <column caption='BNPL attempt place order rate' datatype='real' default-format='p0.0%' name='[Calculation_3420061729340911622]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([bnpl_attempted_place_order])/sum([Calculation_3420061729314242563])' />
            </column>
            <column caption='BNPL order placed rate' datatype='real' default-format='p0.0%' name='[Calculation_3420061729341214727]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([bnpl_success])/sum([bnpl_attempted_place_order])' />
            </column>
            <column caption='Metric' datatype='real' default-format='p0.00%' name='[Calculation_3420061729342898184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2]=&apos;Eligible Rate&apos; then [Calculation_3420061729311842304]&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Choosing Rate&apos; then [Calculation_3420061729311985665]&#10;ELSEIF  [Parameters].[Parameter 2]=&apos;Bottom Sheet Loaded Rate&apos; then [Calculation_3420061729314869252]&#10;ELSEIF  [Parameters].[Parameter 2]=&apos;Attempt Rate&apos; then [Calculation_3420061729340911622]&#10;elseif [Parameters].[Parameter 2]=&apos;Success Rate&apos; then [Calculation_3420061729341214727]&#10;elseif [Parameters].[Parameter 2]=&apos;Conversion Rate&apos; then [BNPL order placed successfully rate (copy)_45950822513897472]&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Max Balance&amp;Limit Validation Rate&apos; then [BNPL Bottom sheet loaded rate (copy)_1768436944290148352]&#10;&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Min Amount Validation Rate&apos; then [BNPL Max Amount&amp; Limit Validation Rate (copy)_1768436944292392962]&#10;&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Overdue Payment Validation Rate&apos; then [BNPL Min Amount Validation Rate (copy)_1768436944293040132]&#10;ELSEIF [Parameters].[Parameter 2]=&apos;Failure Rate&apos; then [BNPL order placed successfully rate (copy)_1436648309132972034]&#10;elseif [Parameters].[Parameter 2]=&apos;BNPL Conversion Rate After Choosing&apos; then [BNPL Conversion Rate (copy)_692358124638728192]&#10;end' />
            </column>
            <_.fcp.ObjectModelTableType.false...column caption='Custom SQL Query' datatype='integer' name='[__tableau_internal_object_id__].[_002030DDA9874E0F852FC31BFD258479]' role='measure' type='quantitative' />
            <column caption='place order out of choosing' datatype='real' default-format='p0.00%' name='[Calculation_3420061729361223689]' role='measure' type='quantitative'>
