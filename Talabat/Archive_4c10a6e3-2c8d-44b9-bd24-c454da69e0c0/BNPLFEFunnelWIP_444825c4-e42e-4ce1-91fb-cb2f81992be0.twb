          <datasource-dependencies datasource='Parameters'>
            <column alias='Daily' caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;daily&quot;'>
              <calculation class='tableau' formula='&quot;daily&quot;' />
              <aliases>
