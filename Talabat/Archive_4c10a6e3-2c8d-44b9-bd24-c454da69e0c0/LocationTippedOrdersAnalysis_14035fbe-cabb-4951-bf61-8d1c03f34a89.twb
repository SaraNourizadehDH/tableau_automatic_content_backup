      <aliases enabled='yes' />
      <column caption='% of Tipped from Eligible Orders' datatype='real' default-format='p0.00%' name='[% of Eligible Orders (copy)_78531575052419077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([tipped_elig_orders])/SUM([eligible_orders])' />
      </column>
      <column caption='% of Tipped from Tipped Orders (Buckets)' datatype='real' default-format='p0.00%' name='[% of Tipped from Eligible Orders (copy)_289074857710391296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([tipped_elig_orders])/SUM({Fixed [Calculation_78531575049531392]: SUM([tipped_elig_orders])})' />
      </column>
      <column caption='% of Tipped from TGO Orders' datatype='real' default-format='p0.00%' name='[% of Tipped from Eligible Orders (copy)_289074857714184193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([tipped_elig_orders])/SUM([orders])' />
      </column>
      <column caption='Avg. Eligible Orders' datatype='real' name='[Avg. Daily Orders (copy)_78531575050801154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([eligible_orders])/90' />
      </column>
      <column caption='Avg. Tipped Orders' datatype='real' name='[Avg. Eligible Orders (copy)_78531575050928131]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([tipped_elig_orders])/90' />
      </column>
      <column caption='Avg. Tip per TGO Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg. Tip (copy)_289074857714618370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([tips])/SUM([orders]))' />
      </column>
      <column caption='Avg. Tip per Tipped Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Avg. Tip per Eligible Order (copy)_289074857729028099]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([tips])/SUM([tipped_elig_orders]))' />
      </column>
      <column caption='x-axis' datatype='real' name='[Calculation_1281555626583265283]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;Avg. TGO Orders&apos; THEN ROUND([Calculation_78531575050678273], 2)&#13;&#10;WHEN &apos;Avg. Tipped Orders&apos; THEN ROUND([Avg. Eligible Orders (copy)_78531575050928131], 2)&#13;&#10;WHEN &apos;% Eligible from TGO Orders&apos; THEN ROUND([Calculation_78531575051456516]*100, 2)&#13;&#10;WHEN &apos;% Tipped from TGO Orders&apos; THEN ROUND([% of Tipped from Eligible Orders (copy)_289074857714184193]*100, 2)&#13;&#10;WHEN &apos;% Tipped from Eligible Orders&apos; THEN ROUND([% of Eligible Orders (copy)_78531575052419077]*100, 2)&#13;&#10;WHEN &apos;AFV TGO&apos; THEN ROUND([Calculation_78531575053213702], 2)&#13;&#10;WHEN &apos;AFV Tipped&apos; THEN ROUND([Calculation_78531575053418503], 2)&#13;&#10;WHEN &apos;Avg. Tip per TGO Order&apos; THEN ROUND([Avg. Tip (copy)_289074857714618370], 2)&#13;&#10;WHEN &apos;Avg. Tip per Eligible Order&apos; THEN ROUND([Tipped AFV (copy)_78531575055847433], 2)&#13;&#10;WHEN &apos;Avg. Tip per Tipped Order&apos; THEN ROUND([Avg. Tip per Eligible Order (copy)_289074857729028099], 2)&#13;&#10;WHEN &apos;Tip% of AFV of Tipped&apos; THEN ROUND([Calculation_78531575055065096]*100, 2)&#13;&#10;END' />
      </column>
      <column caption='Loc Dim' datatype='string' name='[Calculation_78531575049531392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;City&apos; THEN [city_name]&#13;&#10;WHEN &apos;Zone&apos; THEN [zone_name_final]&#13;&#10;END' />
      </column>
      <column caption='Avg. TGO Orders' datatype='real' name='[Calculation_78531575050678273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([orders])/90' />
      </column>
      <column caption='% of Eligible Orders from TGO Orders' datatype='real' default-format='p0.00%' name='[Calculation_78531575051456516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([eligible_orders])/SUM([orders])' />
      </column>
      <column caption='AFV TGO' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_78531575053213702]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gfv])/SUM([orders])' />
      </column>
      <column caption='AFV Tipped' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_78531575053418503]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([tipped_gfv])/SUM([tipped_elig_orders])' />
      </column>
      <column caption='Tip % of AFV of Tipped Orders' datatype='real' default-format='p0.00%' name='[Calculation_78531575055065096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([tips])/SUM([tipped_gfv])' />
      </column>
      <column caption='MC Tip 1' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_78531575067525130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;City&apos; THEN&#13;&#10;MIN(IF [rn_city]=1 THEN ([tip_amt]) END)&#13;&#10;WHEN &apos;Zone&apos; THEN&#13;&#10;MIN(IF [rn_zone]=1 THEN ([tip_amt]) END)&#13;&#10;END' />
      </column>
      <column caption='rn filter' datatype='boolean' name='[Calculation_78531575076532240]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#13;&#10;when &apos;City&apos; then [rn_city]&gt;0 and [rn_city]&lt;=5&#13;&#10;when &apos;Zone&apos; then [rn_zone]&gt;0 and [rn_zone]&lt;=5&#13;&#10;end' />
      </column>
      <column caption='Tip Buckets' datatype='string' name='[Calculation_78531575083515921]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tip_amt]&gt;0 AND [tip_amt]&lt;5 then &apos;&lt;5&apos;&#13;&#10;ELSEIF [tip_amt]&gt;=5 AND [tip_amt]&lt;10 then &apos;5-9&apos;&#13;&#10;ELSEIF [tip_amt]&gt;=10 AND [tip_amt]&lt;15 then &apos;10-14&apos;&#13;&#10;//ELSEIF [tip_amt]&gt;=15 AND [tip_amt]&lt;20 then &apos;15-19&apos;&#13;&#10;//ELSEIF [tip_amt]&gt;=20 AND [tip_amt]&lt;25 then &apos;20-24&apos;&#13;&#10;//ELSEIF [tip_amt]&gt;=25 AND [tip_amt]&lt;30 then &apos;25-29&apos;&#13;&#10;ELSEIF [tip_amt]&gt;=15 AND [tip_amt]&lt;30 then &apos;15-29&apos;&#13;&#10;//ELSEIF [tip_amt]&gt;=30 AND [tip_amt]&lt;40 then &apos;30-39&apos;&#13;&#10;ELSEIF [tip_amt]&gt;=30 AND [tip_amt]&lt;50 then &apos;30-49&apos;&#13;&#10;ELSEIF [tip_amt]&gt;=50 THEN &apos;50+&apos;&#13;&#10;END' />
      </column>
      <column caption='MC Tip 4' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[MC Tip 1 (copy) (copy) (copy)_78531575070531597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;City&apos; THEN&#13;&#10;MIN(IF [rn_city]=4 THEN ([tip_amt]) END)&#13;&#10;WHEN &apos;Zone&apos; THEN&#13;&#10;MIN(IF [rn_zone]=4 THEN ([tip_amt]) END)&#13;&#10;END' />
      </column>
      <column caption='MC Tip 3' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[MC Tip 1 (copy) (copy)_78531575070519308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;City&apos; THEN&#13;&#10;MIN(IF [rn_city]=3 THEN ([tip_amt]) END)&#13;&#10;WHEN &apos;Zone&apos; THEN&#13;&#10;MIN(IF [rn_zone]=3 THEN ([tip_amt]) END)&#13;&#10;END' />
      </column>
      <column caption='MC Tip 2' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[MC Tip 1 (copy)_78531575070502923]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;City&apos; THEN&#13;&#10;MIN(IF [rn_city]=2 THEN ([tip_amt]) END)&#13;&#10;WHEN &apos;Zone&apos; THEN&#13;&#10;MIN(IF [rn_zone]=2 THEN ([tip_amt]) END)&#13;&#10;END' />
      </column>
      <column caption='MC Tip 5' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[MC Tip 4 (copy)_78531575070822414]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;City&apos; THEN&#13;&#10;MIN(IF [rn_city]=5 THEN ([tip_amt]) END)&#13;&#10;WHEN &apos;Zone&apos; THEN&#13;&#10;MIN(IF [rn_zone]=5 THEN ([tip_amt]) END)&#13;&#10;END' />
      </column>
      <column caption='Avg. Tip per Eligible Order' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Tipped AFV (copy)_78531575055847433]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([tips])/SUM([eligible_orders]))' />
      </column>
