      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_7691C19ABFF844E4B2CA3AE8858DC0AD'>
            <properties context=''>
              <relation connection='bigquery.13uxcpw1df20eo1f3pepm1n0cqqq' name='Custom SQL Query' type='text'><![CDATA[with main as (
  select city_name, zone_name_final, 
    rider_tip_amount_lc tip_amt,
    count(distinct order_id) orders, 
    count(distinct case when is_online_payment then order_id end) eligible_orders,
    count(distinct case when is_online_payment and rider_tip_amount_lc>>0 then order_id end) tipped_elig_orders,
    sum(basket_amount_lc) gfv,
    sum(case when is_online_payment then basket_amount_lc else 0 end) eligible_gfv,
    sum(case when is_online_payment and rider_tip_amount_lc>>0 then basket_amount_lc else 0 end) tipped_gfv,
    sum(rider_tip_amount_lc) tips,
  from `tlb-data-prod.data_platform.fct_order_info` o
  left join `tlb-data-prod.data_platform.sq_dim_location_eg` loc on o.delivery_location_id = loc.location_id 
  where country_id=9 and not is_test and is_successful and is_tgo
    and order_date between '2024-12-01' and '2025-02-28'
  group by 1,2,3)

,com_tip_city as(
  select *, row_number() over(partition by city_name order by tipped_elig_orders desc) rn_city,
  from (
    select city_name, tip_amt, sum(tipped_elig_orders) tipped_elig_orders
    from main
    group by 1,2)
  qualify rn_city<<=5
)

,com_tip_zone as(
  select *, row_number() over(partition by zone_name_final order by tipped_elig_orders desc) rn_zone,
  from main
  qualify rn_zone<<=5
)

select m.*, rn_city, rn_zone
from main m
left join com_tip_city c on m.city_name=c.city_name and m.tip_amt=c.tip_amt
left join com_tip_zone z on m.zone_name_final=z.zone_name_final and m.tip_amt=z.tip_amt]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
