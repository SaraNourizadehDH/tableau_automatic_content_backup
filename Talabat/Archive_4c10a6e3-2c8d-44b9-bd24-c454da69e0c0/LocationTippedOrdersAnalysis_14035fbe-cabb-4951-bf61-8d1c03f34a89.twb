              <calculation class='tableau' formula='SUM([tips])/SUM([df])' />
            </column>
            <column caption='Tip % of EF' datatype='real' default-format='p0.00%' name='[Tip % of DF (copy)_173107169359679491]' role='measure' type='quantitative'>
