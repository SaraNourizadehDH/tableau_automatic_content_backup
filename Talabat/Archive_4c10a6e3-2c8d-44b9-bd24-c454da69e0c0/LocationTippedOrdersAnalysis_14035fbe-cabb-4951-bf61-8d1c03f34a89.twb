      <column caption='Tipped AFV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_78531575053418503]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([tipped_gfv])/SUM([tipped_elig_orders])' />
