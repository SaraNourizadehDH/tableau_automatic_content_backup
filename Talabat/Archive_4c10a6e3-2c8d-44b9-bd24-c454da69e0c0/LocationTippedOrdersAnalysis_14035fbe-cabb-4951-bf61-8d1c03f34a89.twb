  <worksheets>
    <worksheet name='Buckets'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ff5a00' fontsize='12'>Tip Buckets % of Tipped</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Tip Analysis Dec-Feb' name='federated.0i5jzqz1e88pt514jaguo1nlfqcz' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Location Dim' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;City&quot;'>
              <calculation class='tableau' formula='&quot;City&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0i5jzqz1e88pt514jaguo1nlfqcz'>
            <column caption='% of Tipped from Tipped Orders (Buckets)' datatype='real' default-format='p0.00%' name='[% of Tipped from Eligible Orders (copy)_289074857710391296]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tipped_elig_orders])/SUM({Fixed [Calculation_78531575049531392]: SUM([tipped_elig_orders])})' />
            </column>
            <column caption='Loc Dim' datatype='string' name='[Calculation_78531575049531392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &apos;City&apos; THEN [city_name]&#13;&#10;WHEN &apos;Zone&apos; THEN [zone_name_final]&#13;&#10;END' />
            </column>
            <column caption='Avg. TGO Orders' datatype='real' name='[Calculation_78531575050678273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([orders])/90' />
            </column>
            <column caption='Tip Buckets' datatype='string' name='[Calculation_78531575083515921]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [tip_amt]&gt;0 AND [tip_amt]&lt;5 then &apos;&lt;5&apos;&#13;&#10;ELSEIF [tip_amt]&gt;=5 AND [tip_amt]&lt;10 then &apos;5-9&apos;&#13;&#10;ELSEIF [tip_amt]&gt;=10 AND [tip_amt]&lt;15 then &apos;10-14&apos;&#13;&#10;//ELSEIF [tip_amt]&gt;=15 AND [tip_amt]&lt;20 then &apos;15-19&apos;&#13;&#10;//ELSEIF [tip_amt]&gt;=20 AND [tip_amt]&lt;25 then &apos;20-24&apos;&#13;&#10;//ELSEIF [tip_amt]&gt;=25 AND [tip_amt]&lt;30 then &apos;25-29&apos;&#13;&#10;ELSEIF [tip_amt]&gt;=15 AND [tip_amt]&lt;30 then &apos;15-29&apos;&#13;&#10;//ELSEIF [tip_amt]&gt;=30 AND [tip_amt]&lt;40 then &apos;30-39&apos;&#13;&#10;ELSEIF [tip_amt]&gt;=30 AND [tip_amt]&lt;50 then &apos;30-49&apos;&#13;&#10;ELSEIF [tip_amt]&gt;=50 THEN &apos;50+&apos;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[city_name]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column-instance column='[Calculation_78531575049531392]' derivation='None' name='[none:Calculation_78531575049531392:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_78531575083515921]' derivation='None' name='[none:Calculation_78531575083515921:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[orders]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='real' name='[tip_amt]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[tipped_elig_orders]' role='measure' type='quantitative' />
            <column-instance column='[% of Tipped from Eligible Orders (copy)_289074857710391296]' derivation='User' name='[usr:% of Tipped from Eligible Orders (copy)_289074857710391296:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_78531575050678273]' derivation='User' name='[usr:Calculation_78531575050678273:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[zone_name_final]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0i5jzqz1e88pt514jaguo1nlfqcz].[none:Calculation_78531575083515921:nk]'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:Calculation_78531575083515921:nk]' />
              <groupfilter function='member' level='[none:Calculation_78531575083515921:nk]' member='%null%' />
            </groupfilter>
          </filter>
          <manual-sort column='[federated.0i5jzqz1e88pt514jaguo1nlfqcz].[none:Calculation_78531575083515921:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Less than 5 EGP&quot;</bucket>
              <bucket>&quot;5-9.9 EGP&quot;</bucket>
              <bucket>&quot;10-14.9 EGP&quot;</bucket>
              <bucket>&quot;15-19.9 EGP&quot;</bucket>
              <bucket>&quot;20-24.9 EGP&quot;</bucket>
