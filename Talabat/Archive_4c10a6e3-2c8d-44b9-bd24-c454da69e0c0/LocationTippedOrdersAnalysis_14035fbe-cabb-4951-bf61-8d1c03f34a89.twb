      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_F3BDD000DD79443FA016D5B8B5F5F959'>
            <properties context=''>
              <relation connection='bigquery.0yvpxwl16ueqaq1cuacmz0nd59uw' name='Custom SQL Query' type='text'>select date_trunc(o.order_date, month) date_month,&#13;
    -- rider_tip_amount_lc tip_amt,&#13;
    count(distinct o.order_id) orders, &#13;
    count(distinct case when is_online_payment then o.order_id end) eligible_orders,&#13;
    count(distinct case when is_online_payment and rider_tip_amount_lc&gt;&gt;0 then o.order_id end) tipped_elig_orders,&#13;
    sum(basket_amount_lc) gfv,&#13;
    sum(case when is_online_payment then basket_amount_lc else 0 end) eligible_gfv,&#13;
    sum(case when is_online_payment and rider_tip_amount_lc&gt;&gt;0 then basket_amount_lc else 0 end) tipped_gfv,&#13;
    sum(rider_tip_amount_lc) tips,&#13;
    sum(delivery_fee_amount_lc) df,&#13;
    sum(delivery_fee_amount_lc)+sum(service_fee_amount_lc)+sum(rev_small_order_sf) effective_fees,&#13;
    sum(f.cost_cpo_1) cpo1&#13;
  from `tlb-data-prod.data_platform.fct_order_info` o&#13;
  left join `tlb-data-dev.performance_management_egypt.cv_fct_order_financials_eg` f on o.order_id = f.order_id &#13;
  where country_id=9 and not is_test and o.is_successful and o.is_tgo&#13;
    and o.order_date&gt;&gt;=&apos;2023-01-01&apos;&#13;
  group by 1</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
