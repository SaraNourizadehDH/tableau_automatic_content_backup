        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.15qur8510ckn5a12sjrho02niyvw' name='Custom SQL Query1' type='text'><![CDATA[WITH
    dates AS (
      SELECT *
      FROM UNNEST(GENERATE_DATE_ARRAY('2021-01-01', DATE_ADD(CURRENT_DATE(), INTERVAL -1 DAY), INTERVAL 1 DAY)) AS date
    ),

    kvl AS (
      SELECT DISTINCT official_kitchen_name,updated_opening_date as kitchen_opening_date,
      FROM `fulfillment-dwh-production.curated_data_shared_gfs.kitchen_vendors_looker`
    ),

    kv AS (
    SELECT 
    kv.*,
    kvl.kitchen_opening_date,
    FROM `fulfillment-dwh-production.curated_data_shared_gfs.kitchen_vendors` kv
    LEFT JOIN  kvl on kvl.official_kitchen_name = kv.official_kitchen_name
    ),

  kk AS (
        SELECT DISTINCT kitchen_id,kitchen_opening_date FROM kv
    ),

    occupany_daily AS 
    (
      SELECT * FROM `fulfillment-dwh-production.curated_data_shared_gfs.occupancy_daily` o
      WHERE report_day <<= current_date()-1
    ),

    kitchens AS -- occupancy for incubator
      (
        SELECT 
        DISTINCT kitchen_id    
        FROM occupany_daily so
      ),


  stalls_per_vendor AS (
     SELECT
       d.date as report_date,
       kv.vendor_id,
       kv.global_entity_id,
       COUNT(DISTINCT CONCAT(kv.stall_number, COALESCE(kv.official_kitchen_name, kv.kitchen_short_name))) as stalls_per_vendor
     FROM
        dates d
      CROSS JOIN
        kv
     WHERE LEAST(kv.onboarding_date) <<= d.date AND (kv.offboarding_date IS NULL OR kv.offboarding_date >>= d.date)
           AND kv.stall_number IS NOT NULL
     GROUP BY 1,2,3
    ),

pre_base AS 
    (
     SELECT
        1 as prio, 
        d.date,
        d.date                           as report_date,
        CASE
          WHEN (LEAST(kv.onboarding_date) <<= d.date AND kv.vendor_id IS NOT NULL)
            AND (kv.offboarding_date IS NULL OR kv.offboarding_date >>= d.date)
            THEN TRUE
          ELSE FALSE
        END                              as is_active,
        CASE
          WHEN (LEAST(kv.onboarding_date) <<= d.date AND kv.vendor_id IS NOT NULL)
            AND (kv.offboarding_date IS NULL OR kv.offboarding_date >> d.date)
            THEN FALSE
          ELSE TRUE
        END                              as is_churned,
        LEAST(kv.onboarding_date) AS onboarding_date,
        CASE WHEN d.date = LEAST(kv.onboarding_date)
          THEN 1 ELSE 0 END              as onboarding_count,
        kv.offboarding_date,
        CASE WHEN d.date = kv.offboarding_date
          THEN 1 ELSE 0 END              as offboarding_count,
        kv.global_entity_id,
        INITCAP(v.location.city)                  as city,
        kv.vendor_id,
        kv.kitchen_id,
        CONCAT(kv.vendor_id, kv.global_entity_id, COALESCE(kv.official_kitchen_name, kv.kitchen_short_name), COALESCE(kv.stall_number, 'N/A')) AS uid,
        kv.vendor_name,
        kv.kitchen_short_name,
        kv.official_kitchen_name,
        COALESCE(kv.stall_number, 'N/A') AS stall_number,
        kv.partner_name,
        kv.total_stalls,
        COALESCE(stalls_per_vendor, 1) as stalls_per_vendor,
        kv.brand_name,
        kv.stall_id,
        v.country_code,
        kv.partner_id,
    FROM
        dates d
      CROSS JOIN
      kv
      LEFT JOIN `fulfillment-dwh-production.curated_data_shared_gfs.vendors` v ON v.vendor_id = kv.vendor_id AND v.global_entity_id = kv.global_entity_id
      LEFT JOIN stalls_per_vendor sv ON sv.vendor_id = kv.vendor_id AND sv.global_entity_id = kv.global_entity_id AND d.date = sv.report_date
      WHERE LEAST(kv.onboarding_date) <<= d.date AND (kv.offboarding_date IS NULL OR kv.offboarding_date >>= d.date)
    ), 
    
    base AS (
      SELECT * EXCEPT(prio)FROM pre_base
      QUALIFY  RANK() OVER (PARTITION BY report_date, vendor_id, global_entity_id ORDER BY prio ASC)  = 1
      ),

    base_vendors AS   
      (SELECT 
                  date,
                  b.kitchen_id,
                  stall_id,
                  vendor_id,
                  vendor_name,
                  partner_name,
                  brand_name,
                  kitchen_short_name,
                  official_kitchen_name,
                  country_code,
                  is_active,
                  is_churned,
                  onboarding_date,
                  offboarding_date,
                  stalls_per_vendor,
                  stall_number,
                  partner_id,
      FROM base b
      ),

    pre_final AS   
      (
        SELECT 
        COALESCE (o.report_day,v.date) as date,
        COALESCE (o.kitchen_id,v.kitchen_id) as kitchen_id,
        COALESCE (o.partner_id,v.partner_id) as partner_id,
        COALESCE (o.stall_number,v.stall_number,"Insulator") as stall_number,
        COALESCE (o.occupied_by_partner,v.partner_name) as partner_name,
        COALESCE (o.kitchen_short_name,v.kitchen_short_name) as kitchen_short_name,
        COALESCE (o.countryCode,v.country_code) as country_code,
        COALESCE (o.occupation,true) as occupation,
        -- o.type,
        COALESCE(o.is_half_stall,false) as is_half_stall,
        v.* EXCEPT(date,partner_id,kitchen_id,stall_number,partner_name,kitchen_short_name,country_code),
        FROM base_vendors v
        FULL OUTER JOIN occupany_daily o on o.report_day = v.date AND CONCAT(o.kitchen_id,o.stall_number) = CONCAT(v.kitchen_id,v.stall_number) AND o.partner_id = v.partner_id
      ),

    final_stall AS 
    (SELECT 
    pf.*,
    CASE WHEN date = CURRENT_DATE() THEN true ELSE false END as latest_occupany,
    CASE WHEN stall_number = "Insulator" then true else false end as insulator_vendor,
    kk.kitchen_opening_date
    FROM pre_final pf
    LEFT JOIN kk on kk.kitchen_id = pf.kitchen_id),

    metrics AS 
    (SELECT 
    *
    FROM `gfs-data-reporting.gfs_tlb_prod.talabat_gfs_aggregate_kpis_daily`),
    
      final AS
      (Select 
      bt.*,
      successful_orders/stalls_per_vendor AS  successful_orders,
      at_vendor_time_cleaned_sum/stalls_per_vendor AS  at_vendor_time_cleaned_sum,
      at_vendor_time_cleaned_count/stalls_per_vendor AS  at_vendor_time_cleaned_count,
      at_vendor_time_cleaned_v2_sum/stalls_per_vendor AS  at_vendor_time_cleaned_v2_sum,
      at_vendor_time_cleaned_v2_count/stalls_per_vendor AS  at_vendor_time_cleaned_v2_count,
      avg_ept_avtc_1/stalls_per_vendor AS  avg_ept_avtc_1,
      from final_stall bt
      LEFT JOIN metrics m on bt.vendor_id = CAST(m.vendor_id AS STRING) and m.dates = bt.date)
  
      SELECT 
      DATE_TRUNC(date,MONTH) as month,
      MAX(EXTRACT(DAY FROM date)) as no_of_days,
      SUM(successful_orders) as successful_orders,
      SUM(at_vendor_time_cleaned_sum) AS at_vendor_time_cleaned_sum,
      SUM(at_vendor_time_cleaned_count) AS at_vendor_time_cleaned_count,
      SUM(at_vendor_time_cleaned_v2_sum) AS at_vendor_time_cleaned_v2_sum,
      SUM(at_vendor_time_cleaned_v2_count) AS at_vendor_time_cleaned_v2_count,
      SUM(avg_ept_avtc_1) AS avg_ept_avtc_1,
      SUM(CASE WHEN country_code = "KW" THEN successful_orders END ) as kw_orders,
      SUM(CASE WHEN country_code = "BH" THEN successful_orders END ) as bh_orders,
      SUM(CASE WHEN country_code = "QA" THEN successful_orders END ) as qa_orders,
      SUM(CASE WHEN country_code = "AE" THEN successful_orders END ) as ae_orders,
      FROM final 
      WHERE DATE_TRUNC(date,YEAR) = "2025-01-01"
      GROUP BY 1]]></relation>
          <relation connection='cloudfile:googledrive-excel-direct.1l5dvjo17ir9r8166bhog0pk47cd' name='2025_kpis_BAUs' table='[&apos;2025_kpis_BAUs$&apos;]' type='table'>
            <columns gridOrigin='A1:L13:no:A1:L13:0' header='yes' outcome='6'>
              <column datatype='date' name='month' ordinal='0' />
              <column datatype='real' name='stall_occupancy_%' ordinal='1' />
              <column datatype='integer' name='ados' ordinal='2' />
              <column datatype='real' name='gold_silver %' ordinal='3' />
              <column datatype='real' name='churn_%' ordinal='4' />
              <column datatype='real' name='uae_dhk_penetration' ordinal='5' />
              <column datatype='real' name='kw_dhk_penetration' ordinal='6' />
              <column datatype='real' name='qa_dhk_penetration' ordinal='7' />
              <column datatype='real' name='bh_dhk_penetration' ordinal='8' />
              <column datatype='real' name='edr_share' ordinal='9' />
              <column datatype='integer' name='tincubator_orders' ordinal='10' />
              <column datatype='real' name='avtc_v2' ordinal='11' />
            </columns>
          </relation>
          <relation connection='bigquery.15qur8510ckn5a12sjrho02niyvw' name='Custom SQL Query2' type='text'><![CDATA[WITH coffee_chains AS
  (SELECT 
  chain_id,
  chain_name,
  CASE WHEN chain_id IN (676327,670444,659775,603153) THEN true else false end is_edr,
  country_code,
  true as is_coffee_chain
  FROM `tlb-data-prod.data_platform.dim_chain` dim_chain
  WHERE 
    ((UPPER(( dim_chain.chain_name  )) = UPPER('Starbucks') OR UPPER(( dim_chain.chain_name  )) = UPPER('Everyday Roastery Coffee') OR UPPER(( dim_chain.chain_name  )) = UPPER('Tim Hortons') OR UPPER(( dim_chain.chain_name  )) = UPPER('% Arabica') OR UPPER(( dim_chain.chain_name  )) = UPPER('POFA cafe') OR UPPER(( dim_chain.chain_name  )) = UPPER('Caribou Coffee') OR UPPER(( dim_chain.chain_name  )) = UPPER('Costa') OR UPPER(( dim_chain.chain_name  )) = UPPER('Cafe Bateel') OR UPPER(( dim_chain.chain_name  )) = UPPER('B Coffee') OR UPPER(( dim_chain.chain_name  )) = UPPER('Gorat Qahwah Cafe') OR UPPER(( dim_chain.chain_name  )) = UPPER('Rue 8 Cafe') OR UPPER(( dim_chain.chain_name  )) = UPPER('White') OR UPPER(( dim_chain.chain_name  )) = UPPER('Dot\'s Cafe') OR UPPER(( dim_chain.chain_name  )) = UPPER('Absolute Zero') OR UPPER(( dim_chain.chain_name  )) = UPPER('Shaghf') OR UPPER(( dim_chain.chain_name  )) = UPPER('Caffe Nero') OR UPPER(( dim_chain.chain_name  )) = UPPER('Crema') OR UPPER(( dim_chain.chain_name  )) = UPPER('Press Speciality Coffee') OR UPPER(( dim_chain.chain_name  )) = UPPER('Hoof Cafe') OR UPPER(( dim_chain.chain_name  )) = UPPER('Tru Boutique Cafe') OR UPPER(( dim_chain.chain_name  )) = UPPER('Street 27 Cafe') OR UPPER(( dim_chain.chain_name  )) = UPPER('Arabica') OR UPPER(( dim_chain.chain_name  )) = UPPER('Bebax Coffee')))
    AND country_code = "AE")


    -- SELECT * FROM coffee_chains


SELECT 
  DATE_TRUNC(date,month) as month,
  SUM(CASE WHEN c.country_code = "KW" AND c.vertical = "food" THEN tgo_orders END) as KW_successful_orders,
  SUM(CASE WHEN c.country_code = "BH" AND c.vertical = "food" THEN tgo_orders END) as BH_successful_orders,
  SUM(CASE WHEN c.country_code = "QA" AND c.vertical = "food" THEN tgo_orders END) as QA_successful_orders,
  SUM(CASE WHEN c.country_code = "AE" AND c.vertical = "food" THEN tgo_orders END) as AE_successful_orders,
  SUM(CASE WHEN c.country_code = "AE" AND c.vertical = "food" AND is_coffee_chain THEN successful_order_count END) as AE_coffee_orders,
  SUM(CASE WHEN c.country_code = "AE" AND is_edr THEN successful_order_count END) as edr_orders,
  FROM `tlb-data-prod.data_platform.agg_vendor_performance_daily` a
  LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v on CAST(v.vendor_id AS STRING) = CAST(a.vendor_id AS STRING)
  LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c on c.chain_id = v.chain_id
  LEFT JOIN coffee_chains cc on cc.chain_id = c.chain_id
  WHERE DATE_TRUNC(date,month) >>= "2025-01-01"
  AND c.vertical = "food"
  AND c.country_code IN ("BH","QA","KW","AE")
  AND city_name <<>> "all"
  AND area_name <<>> "all"
  GROUP BY 1]]></relation>
          <relation connection='bigquery.15qur8510ckn5a12sjrho02niyvw' name='Custom SQL Query3' type='text'>WITH base AS
  (
    SELECT 
    DATE_TRUNC(dates,MONTH) as incubator_order_month,
    MAX(dates) as max_date,
    SUM(successful_orders) as incubator_orders,
    FROM `gfs-data-reporting.gfs_tlb_prod.talabat_gfs_aggregate_kpis_daily` o
    LEFT JOIN `gfs-data-reporting.gfs_tlb_prod.talabat_dim_vendor_info` v on v.vendor_id = o.vendor_id
    WHERE 
    DATE_TRUNC(dates,MONTH) &gt;&gt;= &quot;2025-01-01&quot;
    AND virtual_brand_group IN (&quot;T-Incubator (DH)&quot;,&quot;Concepts (DH)&quot;)
    GROUP BY 1
  )

  SELECT 
  incubator_order_month,
  LAST_DAY(incubator_order_month) as last_day_of_month,
  max_date,
  incubator_orders,
  FROM base</relation>
          <relation connection='bigquery.15qur8510ckn5a12sjrho02niyvw' name='Custom SQL Query' type='text'><![CDATA[with oc_base AS
        (SELECT
        *,
        CONCAT(kitchen_short_name,"-",stall_number) as unique_stall_id,

        -- CASE 
        --     WHEN report_day = DATE_TRUNC(report_day,month)  then true 
        --     WHEN report_day = LAST_DAY(DATE_TRUNC(report_day,month)) then true 
        --     WHEN report_day = CURRENT_DATE() - 1 THEN true 
        -- ELSE false end as last_and_current_day,
        CASE
            WHEN report_day = LAST_DAY(DATE_TRUNC(report_day,month)) then true 
            WHEN report_day = CURRENT_DATE() - 1 THEN true 
        else false end as last_and_current_day,
        CASE WHEN occupation THEN ROW_NUMBER() OVER(PARTITION BY report_day,kitchen_short_name,stall_number) END as row_number_old_logic,
        CASE WHEN occupation THEN ROW_NUMBER() OVER(PARTITION BY report_day,kitchen_short_name,stall_number,partner_id) END as row_number_new_logic,
        FROM `fulfillment-dwh-production.curated_data_shared_gfs.occupancy_daily`
        WHERE 
        report_day >>= "2025-01-01"
        AND report_day <<= CURRENT_DATE()-1
        -- AND report_day <<= "2025-04-30"
        -- DATE_TRUNC(report_day,MONTH) = "2025-02-01"
        ),

        base2 AS 
        (
            SELECT 
            *,
            CASE WHEN (COUNT(is_half_stall) OVER(PARTITION BY unique_stall_id)) >> 1 then true else false end as is_shared_stall,
            CASE WHEN (COUNT(is_half_stall) OVER(PARTITION BY unique_stall_id)) >> 1 then 0.5 else 1 end as half_occupany
            FROM oc_base   
        ),

        pre_final AS
   (SELECT
        report_day,
        countryCode,
        kitchen_short_name,
        COUNT(DISTINCT unique_stall_id) as no_of_stalls,
        SUM(
            CASE 
                WHEN occupation is true AND is_half_stall AND row_number_old_logic = 1 THEN 0.5
                WHEN occupation is true AND NOT is_half_stall AND row_number_old_logic = 1 THEN 1 END
        ) as occupied_stalls,
        SUM(
            CASE 
                WHEN occupation is true AND is_half_stall AND row_number_old_logic = 1 THEN 0.5
                WHEN occupation is true AND NOT is_half_stall AND row_number_new_logic = 1 THEN 1 END
        ) as occupied_stalls_new_logic,

        COUNT(DISTINCT unique_stall_id) - 
        SUM(
            CASE 
                WHEN occupation is true AND is_half_stall AND row_number_old_logic = 1 THEN 0.5
                WHEN occupation is true AND NOT is_half_stall AND row_number_old_logic = 1 THEN 1 END
        ) as empty_stalls,

        COUNT(DISTINCT unique_stall_id) - 
        SUM(
            CASE 
                WHEN occupation is true AND is_half_stall AND row_number_old_logic = 1 THEN 0.5
                WHEN occupation is true AND NOT is_half_stall AND row_number_new_logic = 1 THEN 1 END
        ) as empty_stalls_new_logic,

        SUM(
            CASE WHEN occupation is true AND is_half_stall  AND row_number_old_logic = 1 THEN 0.5 ELSE 0 END
        ) as shared_stalls,
        SUM(
            CASE WHEN occupation is true AND is_half_stall THEN 0.5 ELSE 0 END
        ) as occupied_shared_stalls,
        FROM base2
        WHERE  last_and_current_day
        GROUP BY ALL)
        

    SELECT
    DATE_TRUNC(report_day,month) report_day,
    countryCode as country,
    SUM(no_of_stalls) as no_of_stalls,
    SUM(occupied_stalls) as occupied_stalls,
    SUM(occupied_stalls_new_logic) as occupied_stalls_new_logic,
    SUM(empty_stalls) as empty_stalls,
    SUM(empty_stalls_new_logic) as empty_stalls_new_logic
    FROM pre_final
    GROUP BY ALL]]></relation>
          <relation connection='bigquery.15qur8510ckn5a12sjrho02niyvw' name='Custom SQL Query5' type='text'>SELECT
        report_month,
        SUM( CASE WHEN churn_date IS NOT NULL THEN stall_count END) as no_of_churns,
        FROM `fulfillment-dwh-production.curated_data_shared_gfs.tableau_kitchen_stall_churn`
        WHERE report_month &gt;&gt;= &quot;2025-01-01&quot;
        GROUP BY 1</relation>
          <relation connection='bigquery.15qur8510ckn5a12sjrho02niyvw' name='Custom SQL Query4' type='text'>SELECT 
report_month,
COUNT(DISTINCT CASE WHEN stall_category IN (&quot;Gold&quot;,&quot;Silver&quot;) THEN (CONCAT(kitchen_name,partner_name,stall_number)) END) as gold_and_silver_partners,
COUNT(DISTINCT CASE WHEN stall_category = &quot;Bronze&quot; THEN (CONCAT(kitchen_name,partner_name,stall_number)) END) as bronze_partners,
COUNT(DISTINCT (CONCAT(kitchen_name,partner_name,stall_number))) as total_partners,
FROM `fulfillment-dwh-production.curated_data_shared_gfs.kitchen_vendor_stall_category`
WHERE NOT is_churned
AND report_month &gt;&gt;= &quot;2025-01-01&quot;
GROUP BY 1</relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
        <cols>
          <map key='[AE_coffee_orders]' value='[Custom SQL Query2].[AE_coffee_orders]' />
          <map key='[AE_successful_orders]' value='[Custom SQL Query2].[AE_successful_orders]' />
          <map key='[BH_successful_orders]' value='[Custom SQL Query2].[BH_successful_orders]' />
          <map key='[KW_successful_orders]' value='[Custom SQL Query2].[KW_successful_orders]' />
          <map key='[QA_successful_orders]' value='[Custom SQL Query2].[QA_successful_orders]' />
          <map key='[ados]' value='[2025_kpis_BAUs].[ados]' />
