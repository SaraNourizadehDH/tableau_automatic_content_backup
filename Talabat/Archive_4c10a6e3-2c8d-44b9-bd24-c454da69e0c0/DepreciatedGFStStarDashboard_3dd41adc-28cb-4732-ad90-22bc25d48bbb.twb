      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='tstar_mtd_gfs_kitchens' id='_D4C4A5C1FDC84D6F82AFBA240182B612'>
            <properties context=''>
              <relation connection='bigquery.0koti310r2dn0319xqq7p1csd4bf' name='Custom SQL Query' type='text'><![CDATA[WITH mtd_tiers as
(  
with dh_daily_table as 
(
select 
substr(entity_id,-2) as country_iso,
vendor_code as vendor_id,
end_date as date_local,
vendor_delay_rate/100 as order_delay_rate,
customer_contact_rate/100 as inaccurate_orders_rate,
ratings as rating,
vendor_fail_rate/100 as rejection_rate,
price_parity,
orders,
case when orders>>= 30 and current_tier = 'NONE' then 'd'
when current_tier = "STARTER" then "c"
when current_tier = "EXPERT" then "a"
when current_tier = "ADVANCED" then "b" 
else 'not_eligible' end as Overall_tier
from `fulfillment-dwh-production.curated_data_shared_vendor.growth_tiered_rewards_progress` t
LEFT JOIN `gfs-data-reporting.gfs_tlb_prod.talabat_dim_vendor_info` v on CAST(v.vendor_id AS STRING) = t.vendor_code
where entity_id in ('TB_AE','TB_QA','TB_BH','TB_KW')
AND v.gfs_brands_tlb
order by vendor_code , end_date
),

ranked_tiers_rating AS (
  SELECT
  vendor_metrics.date_local,
    vendor_metrics.vendor_id,
    vendor_thresholds.tier,
    RANK() OVER (PARTITION BY vendor_metrics.country_iso,vendor_metrics.vendor_id, vendor_metrics.date_local ORDER BY vendor_thresholds.tier ASC) AS rank_rating
  FROM
    dh_daily_table vendor_metrics
  JOIN `tlb-data-prod.data_platform_google_sheet.tstar_vendor_metric_thresholds` vendor_thresholds
  ON vendor_metrics.country_iso = vendor_thresholds.country_iso
  WHERE
    vendor_metrics.rating >>= cast(vendor_thresholds.rating as float64)
),
ranked_tiers_orders as (
  SELECT
  vendor_metrics.date_local,
    vendor_metrics.vendor_id,
    vendor_thresholds.tier,
    vendor_thresholds.orders,
    vendor_metrics.orders,
    RANK() OVER (PARTITION BY vendor_metrics.country_iso,vendor_metrics.vendor_id, vendor_metrics.date_local ORDER BY vendor_thresholds.tier ASC) AS rank_orders
  FROM
    dh_daily_table  vendor_metrics
  JOIN `tlb-data-prod.data_platform_google_sheet.tstar_vendor_metric_thresholds` vendor_thresholds
  ON vendor_metrics.country_iso = vendor_thresholds.country_iso
  WHERE
    vendor_metrics.orders >>= cast(vendor_thresholds.orders as float64)
),
    ranked_tiers_vcr as (
  SELECT
  vendor_metrics.date_local,
    vendor_metrics.vendor_id,
    vendor_thresholds.tier,
    RANK() OVER (PARTITION BY vendor_metrics.country_iso,vendor_metrics.vendor_id, vendor_metrics.date_local ORDER BY vendor_thresholds.tier ASC) AS rank_vcr
  FROM
    dh_daily_table  vendor_metrics
  JOIN `tlb-data-prod.data_platform_google_sheet.tstar_vendor_metric_thresholds` vendor_thresholds
  ON vendor_metrics.country_iso = vendor_thresholds.country_iso
  WHERE
    vendor_metrics.inaccurate_orders_rate <<= cast(vendor_thresholds.cr as float64)
),
    ranked_tiers_vfr as (
  SELECT
  vendor_metrics.date_local,
    vendor_metrics.vendor_id,
    vendor_thresholds.tier,
    RANK() OVER (PARTITION BY vendor_metrics.country_iso,vendor_metrics.vendor_id, vendor_metrics.date_local ORDER BY vendor_thresholds.tier ASC) AS rank_vfr
  FROM
    dh_daily_table  vendor_metrics
  JOIN `tlb-data-prod.data_platform_google_sheet.tstar_vendor_metric_thresholds` vendor_thresholds
  ON vendor_metrics.country_iso = vendor_thresholds.country_iso
  WHERE
    vendor_metrics.rejection_rate <<= cast(vendor_thresholds.vfr as float64)
),
    ranked_tiers_adjusted_delay_rate as (
  SELECT
  vendor_metrics.date_local,
    vendor_metrics.vendor_id,
    vendor_thresholds.tier,
    RANK() OVER (PARTITION BY vendor_metrics.country_iso,vendor_metrics.vendor_id, vendor_metrics.date_local ORDER BY vendor_thresholds.tier ASC) AS rank_adjusted_delay_rate
  FROM
    dh_daily_table  vendor_metrics
  JOIN `tlb-data-prod.data_platform_google_sheet.tstar_vendor_metric_thresholds` vendor_thresholds
  ON vendor_metrics.country_iso = vendor_thresholds.country_iso
  WHERE
    vendor_metrics.order_delay_rate <<= cast(vendor_thresholds.adjusted_delay_rate as float64)
),
full_tiers as
(
  SELECT
  v.date_local,
  v.vendor_id,
  v.country_iso,
  v.rating,
  coalesce(A.tier, "d") AS rating_tier,
  v.orders,
  B.tier AS orders_tier,
  v.inaccurate_orders_rate,
  coalesce(C.tier, "d") AS inaccurate_orders_rate_tier,
  v.rejection_rate,
  coalesce(D.tier, "d") AS rejection_rate_tier,
  v.order_delay_rate,
  coalesce(E.tier, "d") AS order_delay_rate_tier,
  case when v.orders >>= 30 then GREATEST(coalesce(A.tier, "d"), B.tier, coalesce(C.tier, "d"), coalesce(D.tier, "d"), coalesce(E.tier, "d"))
  else "not_eligible" end as overall_tier
FROM
  (SELECT * FROM dh_daily_table ) v
LEFT JOIN (SELECT * FROM ranked_tiers_rating where rank_rating = 1) A
    ON v.vendor_id = A.vendor_id and v.date_local = A.date_local
LEFT JOIN (SELECT * FROM ranked_tiers_orders where rank_orders = 1) B
    ON v.vendor_id = B.vendor_id AND v.date_local = B.date_local
LEFT JOIN (SELECT * FROM ranked_tiers_vcr where rank_vcr = 1) C
    ON v.vendor_id = C.vendor_id AND v.date_local = C.date_local
LEFT JOIN (SELECT * FROM ranked_tiers_vfr where rank_vfr = 1) D
    ON v.vendor_id = D.vendor_id AND v.date_local = D.date_local
LEFT JOIN (SELECT * FROM ranked_tiers_adjusted_delay_rate where rank_adjusted_delay_rate = 1) E
    ON v.vendor_id = E.vendor_id AND v.date_local = E.date_local

),

dh_full_tiers as 
(
select * from full_tiers
order by vendor_id , date_local
),

ranked_tiers_rating_1 AS (
  SELECT
  vendor_metrics.date_local,
    vendor_metrics.vendor_id,
    vendor_thresholds.tier,
    RANK() OVER (PARTITION BY vendor_metrics.country_iso,vendor_metrics.vendor_id, vendor_metrics.date_local ORDER BY vendor_thresholds.tier ASC) AS rank_rating
  FROM
    `tlb-data-prod.data_platform.sq_agg_tstar_mtd_daily`  vendor_metrics
  JOIN `tlb-data-prod.data_platform_google_sheet.tstar_vendor_metric_thresholds` vendor_thresholds
  ON vendor_metrics.country_iso = vendor_thresholds.country_iso
  WHERE
    vendor_metrics.rating >>= cast(vendor_thresholds.rating as float64)
),
ranked_tiers_orders_1 as (
  SELECT
  vendor_metrics.date_local,
    vendor_metrics.vendor_id,
    vendor_thresholds.tier,
    vendor_thresholds.orders,
    vendor_metrics.orders,
    RANK() OVER (PARTITION BY vendor_metrics.country_iso,vendor_metrics.vendor_id, vendor_metrics.date_local ORDER BY vendor_thresholds.tier ASC) AS rank_orders
  FROM
    `tlb-data-prod.data_platform.sq_agg_tstar_mtd_daily`  vendor_metrics
  JOIN `tlb-data-prod.data_platform_google_sheet.tstar_vendor_metric_thresholds` vendor_thresholds
  ON vendor_metrics.country_iso = vendor_thresholds.country_iso
  WHERE
    vendor_metrics.orders >>= cast(vendor_thresholds.orders as float64)
),
    ranked_tiers_vcr_1 as (
  SELECT
  vendor_metrics.date_local,
    vendor_metrics.vendor_id,
    vendor_thresholds.tier,
    RANK() OVER (PARTITION BY vendor_metrics.country_iso,vendor_metrics.vendor_id, vendor_metrics.date_local ORDER BY vendor_thresholds.tier ASC) AS rank_vcr
  FROM
    `tlb-data-prod.data_platform.sq_agg_tstar_mtd_daily`  vendor_metrics
  JOIN `tlb-data-prod.data_platform_google_sheet.tstar_vendor_metric_thresholds` vendor_thresholds
  ON vendor_metrics.country_iso = vendor_thresholds.country_iso
  WHERE
    vendor_metrics.inaccurate_orders_rate <<= cast(vendor_thresholds.cr as float64)
),
    ranked_tiers_vfr_1 as (
  SELECT
  vendor_metrics.date_local,
    vendor_metrics.vendor_id,
    vendor_thresholds.tier,
    RANK() OVER (PARTITION BY vendor_metrics.country_iso,vendor_metrics.vendor_id, vendor_metrics.date_local ORDER BY vendor_thresholds.tier ASC) AS rank_vfr
  FROM
    `tlb-data-prod.data_platform.sq_agg_tstar_mtd_daily`  vendor_metrics
  JOIN `tlb-data-prod.data_platform_google_sheet.tstar_vendor_metric_thresholds` vendor_thresholds
  ON vendor_metrics.country_iso = vendor_thresholds.country_iso
  WHERE
    vendor_metrics.rejection_rate <<= cast(vendor_thresholds.vfr as float64)
),
    ranked_tiers_adjusted_delay_rate_1 as (
  SELECT
  vendor_metrics.date_local,
    vendor_metrics.vendor_id,
    vendor_thresholds.tier,
    RANK() OVER (PARTITION BY vendor_metrics.country_iso,vendor_metrics.vendor_id, vendor_metrics.date_local ORDER BY vendor_thresholds.tier ASC) AS rank_adjusted_delay_rate
  FROM
    `tlb-data-prod.data_platform.sq_agg_tstar_mtd_daily`  vendor_metrics
  JOIN `tlb-data-prod.data_platform_google_sheet.tstar_vendor_metric_thresholds` vendor_thresholds
  ON vendor_metrics.country_iso = vendor_thresholds.country_iso
  WHERE
    vendor_metrics.order_delay_rate <<= cast(vendor_thresholds.adjusted_delay_rate as float64)
),
full_tiers_1 as
(SELECT
  v.date_local,
  v.vendor_id,
  v.country_iso,
  v.rating,
  coalesce(A.tier, "d") AS rating_tier,
  v.orders,
  B.tier AS orders_tier,
  v.inaccurate_orders_rate,
  coalesce(C.tier, "d") AS inaccurate_orders_rate_tier,
  v.rejection_rate,
  coalesce(D.tier, "d") AS rejection_rate_tier,
  v.order_delay_rate,
  coalesce(E.tier, "d") AS order_delay_rate_tier,
  case when v.orders >>= 30 then GREATEST(coalesce(A.tier, "d"), B.tier, coalesce(C.tier, "d"), coalesce(D.tier, "d"), coalesce(E.tier, "d"))
    else "not_eligible" end as overall_tier
FROM
  (SELECT * FROM `tlb-data-prod.data_platform.sq_agg_tstar_mtd_daily` ) v
LEFT JOIN (SELECT * FROM ranked_tiers_rating_1 where rank_rating = 1) A
    ON v.vendor_id = A.vendor_id and v.date_local = A.date_local
LEFT JOIN (SELECT * FROM ranked_tiers_orders_1 where rank_orders = 1) B
    ON v.vendor_id = B.vendor_id AND v.date_local = B.date_local
LEFT JOIN (SELECT * FROM ranked_tiers_vcr_1 where rank_vcr = 1) C
    ON v.vendor_id = C.vendor_id AND v.date_local = C.date_local
LEFT JOIN (SELECT * FROM ranked_tiers_vfr_1 where rank_vfr = 1) D
    ON v.vendor_id = D.vendor_id AND v.date_local = D.date_local
LEFT JOIN (SELECT * FROM ranked_tiers_adjusted_delay_rate_1 where rank_adjusted_delay_rate = 1) E
    ON v.vendor_id = E.vendor_id AND v.date_local = E.date_local
),

tb_fulltiers as
(
select * from full_tiers_1
where date_local<< '2024-03-14'
ORDER BY vendor_id,date_local
),

final_full_tiers as 
(
  select * from tb_fulltiers
  union all
  select * from dh_full_tiers
),

markup as
(
  with
parity_score as
(
  select
  scrape_date,
    -- CONCAT(LPAD(CAST(EXTRACT(MONTH FROM scrape_date) AS STRING), 2, '0'), '-', CAST(EXTRACT(YEAR FROM scrape_date) AS STRING)) AS month_year,
    talabat_vendor_id as vendor_id
    , competitor_platform as source_platform
    , if(scaled_price_parity_score_weighted >>0, true, false) as is_markup
  from
    `tlb-data-prod.data_platform.agg_comp_intel_vendor_affordability`
    -- scrape_date between date_trunc(current_date, month) and current_date
  qualify row_number() over(partition by extract(year from scrape_date),extract(month from scrape_date),talabat_vendor_id order by scaled_price_parity_score_weighted desc, confidence_score desc, competitor_platform asc)=1
),
markup_flag as
(
  select
    scrape_date,
    vendor_id
    , source_platform
    , max(is_markup) as is_marked_up_mtd
  from
    parity_score
    group by 1,2,3
)
select
  CONCAT(LPAD(CAST(EXTRACT(MONTH FROM scrape_date) AS STRING), 2, '0'), '-', CAST(EXTRACT(YEAR FROM scrape_date) AS STRING)) AS month_year,
   ps.vendor_id
  , ps.source_platform
  , ps.is_marked_up_mtd
from
  markup_flag as ps
order by 1, 2
)
select *,
case when price_parity is true  and overall_tier!= 'not_eligible' then 'd' else overall_tier end as updated_tier from
(
select
f.*
,
is_marked_up_mtd AS price_parity
 from final_full_tiers f
left join
markup m on cast(m.vendor_id as string) = f.vendor_id and month_year = CONCAT(LPAD(CAST(EXTRACT(MONTH FROM date_local) AS STRING), 2, '0'), '-', CAST(EXTRACT(YEAR FROM date_local) AS STRING))
order by 1
))
,
cm AS (
  SELECT
    vendor_id,
    country_iso,
    CASE WHEN price_parity = TRUE THEN "d"
    WHEN overall_tier = "a" and price_parity != TRUE THEN "a"
    ELSE overall_tier
    END as overall_tier,
    price_parity,
    date_local AS date,
    CASE
      WHEN overall_tier = 'a' THEN 'On-Track'
      WHEN overall_tier IN ('b', 'c', 'd') THEN 'Off_Track'
    END AS vendor_status
  FROM mtd_tiers t
  WHERE overall_tier != 'not_eligible'
    AND date_local = DATE_SUB(DATE_TRUNC(CURRENT_DATE(), MONTH), INTERVAL 1 DAY)
),
lm AS (
  SELECT
    date_local,
    vendor_id,
    price_parity,
    CASE WHEN price_parity = TRUE THEN "d"
    WHEN overall_tier = "a" and price_parity != TRUE THEN "a"
    ELSE overall_tier
    END as overall_tier
  FROM mtd_tiers t
  WHERE overall_tier != 'not_eligible'
    AND date_local = DATE_SUB(DATE_TRUNC(DATE_SUB(CURRENT_DATE(), INTERVAL 1 MONTH), MONTH), INTERVAL 1 DAY)
),
nm AS (
  SELECT
  date_local,
    vendor_id,
    rating_tier,
    rating,
    orders_tier,
    price_parity,
    CASE WHEN price_parity = TRUE THEN "d"
    WHEN overall_tier = "a" and price_parity != TRUE THEN "a"
    ELSE overall_tier
    END as overall_tier,
    orders,
    inaccurate_orders_rate_tier AS vcr_tier,
    inaccurate_orders_rate AS vcr,
    rejection_rate_tier AS vfr_tier,
    rejection_rate AS vfr,
    order_delay_rate_tier AS delay_tier,
    order_delay_rate AS delay
  FROM mtd_tiers t
  WHERE overall_tier != 'not_eligible'
    AND date_local = CURRENT_DATE()-2
),
vendor_info AS (
  SELECT
    vendor_id,
    t.account_manager_name AS am,
    vendor_name AS name,
    t.chain_id,
    d.chain_name AS chain_name,
    is_dh_kitchen,
    is_exclusive as is_kpp,
    main_cuisine as cuisine
  FROM `tlb-data-prod.data_platform.dim_vendor_info` t
  LEFT JOIN `tlb-data-prod.data_platform.dim_chain` d
  ON t.chain_id=d.chain_id
),
final AS (
  SELECT
    cm.country_iso,
    cm.vendor_id,
    vi.am,
    vi.name,
    vi.chain_name,
    lm.overall_tier AS last_month_tier,
    cm.overall_tier AS current_month_tier,
    nm.overall_tier AS next_month_tier,
    lm.price_parity AS last_month_price_parity,
    cm.price_parity AS current_month_price_parity,
    nm.price_parity AS next_month_price_parity,
    vi.is_dh_kitchen,
    vi.is_kpp,
    vi.cuisine,
    nm.rating_tier,
    nm.rating,
    nm.orders_tier,
    nm.orders,
    nm.vcr_tier,
    nm.vcr,
    nm.vfr_tier,
    nm.vfr,
    nm.delay_tier,
    nm.delay,
      CONCAT(
    CASE WHEN rating_tier != 'a' THEN 'Rating  ' ELSE '' END,
    CASE WHEN orders_tier != 'a' THEN 'Orders  ' ELSE '' END,
    CASE WHEN vcr_tier != 'a' THEN 'Contact Rate  ' ELSE '' END,
    CASE WHEN vfr_tier != 'a' THEN 'Rejection Rate  ' ELSE '' END,
    CASE WHEN delay_tier != 'a' THEN 'Delay Rate  ' ELSE '' END,
    CASE WHEN nm.price_parity  != FALSE THEN 'Price Parity  ' ELSE '' END
  ) AS rejection_metrics,
    CASE
      WHEN cm.overall_tier = 'a' AND nm.overall_tier = 'a' THEN 'Goal Reached'
      WHEN cm.overall_tier = 'a' AND nm.overall_tier IN ('b', 'c', 'd') THEN 'Churned'
      WHEN cm.overall_tier IN ('b', 'c', 'd') AND nm.overall_tier = 'a' THEN 'Goal Reached'
      WHEN cm.overall_tier = 'c' AND nm.overall_tier = 'b' THEN 'Improving'
      WHEN cm.overall_tier = 'd' AND nm.overall_tier = 'c' THEN 'Improving'
      WHEN cm.overall_tier = 'b' AND nm.overall_tier IN ('c', 'd') THEN 'Declining'
      WHEN cm.overall_tier = 'c' AND nm.overall_tier = 'd' THEN 'Declining'
      WHEN cm.overall_tier = nm.overall_tier THEN 'No Change'
    END AS vendor_status
  FROM cm
  LEFT JOIN vendor_info vi ON SAFE_CAST(cm.vendor_id AS INT64) = vi.vendor_id
  LEFT JOIN lm ON cm.vendor_id = lm.vendor_id
  LEFT JOIN nm ON cm.vendor_id = nm.vendor_id
),
final_2 AS (
  SELECT
    f.*,
    t.tier AS threshold_tier_name,
    t.order AS order_threshold,
    t.rating AS rating_threshold,
    t.delay_rate AS delay_rate_threshold,
    t.vcr AS vcr_threshold,
    t.vfr AS vfr_threshold
  FROM final f
  LEFT JOIN `tlb-data-dev.data_playground_partner_growth.vendor_quality_thresholds` t
  ON f.current_month_tier = t.tier
),
final_3 AS (
  SELECT
    f2.*,
    k.type
  FROM final_2 f2
  LEFT JOIN (
    SELECT
      DISTINCT v.vendor_id,
      IF(key_account_sub_category__c IS NULL, 'Non KA', key_account_sub_category__c) AS type
    FROM `tlb-data-prod.data_platform.dim_vendor_info` v
    LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
    ON v.salesforce_id = a.grid__c
      AND (LEFT(a.global_entity_id,3) ='TB_')
  ) k ON SAFE_CAST(f2.vendor_id AS INT64) = k.vendor_id
)
SELECT f.*
FROM final_3 f 
LEFT JOIN `gfs-data-reporting.gfs_tlb_prod.talabat_dim_vendor_info` v on CAST(v.vendor_id AS STRING) = f.vendor_id
WHERE am IS NOT NULL
AND v.gfs_brands_tlb]]></relation>
            </properties>
