            <column caption='AOV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AOV (EUR) (copy)_1761188984219619331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[GMV_Type_Selector (copy)_663436574674120710] &#13;&#10;WHEN &quot;EUR&quot; THEN AVG([Calculation_1869556813800005632]*[EUR]/1.0)&#13;&#10;WHEN &quot;AED&quot; THEN AVG([Calculation_1869556813800005632]*[AED]/1.0)&#13;&#10;WHEN &quot;BHD&quot; THEN AVG([Calculation_1869556813800005632]*[BHD]/1.0)&#13;&#10;WHEN &quot;EGP&quot; THEN AVG([Calculation_1869556813800005632]*[EGP]/1.0)&#13;&#10;WHEN &quot;JOD&quot; THEN AVG([Calculation_1869556813800005632]*[JOD]/1.0)&#13;&#10;WHEN &quot;KWD&quot; THEN AVG([Calculation_1869556813800005632]*[KWD]/1.0)&#13;&#10;WHEN &quot;OMR&quot; THEN AVG([Calculation_1869556813800005632]*[OMR]/1.0)&#13;&#10;WHEN &quot;QAR&quot; THEN AVG([Calculation_1869556813800005632]*[QAR]/1.0)&#13;&#10;WHEN &quot;SAR&quot; THEN AVG([Calculation_1869556813800005632]*[SAR]/1.0)&#13;&#10;END' />
            </column>
            <column datatype='string' datatype-customized='true' default-role='measure' default-type='quantitative' name='[Account_ID]' role='dimension' type='nominal' />
            <column datatype='real' name='[BHD]' role='measure' type='quantitative' />
            <column datatype='real' name='[Basket_Amount_LC]' role='measure' type='quantitative' />
            <column caption='AOF' datatype='real' name='[Calculation_1761188984197636096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_663436574689521676]/COUNTD([Calculation_1798343644685225984])' />
            </column>
            <column caption='Unique Customers' datatype='integer' name='[Calculation_1761188984213704705]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_1798343644685225984])' />
            </column>
            <column caption='B2B Measure' datatype='real' name='[Calculation_1761188984220119044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[GMV_Type_Selector (copy)_1761188984219283458]&#13;&#10;WHEN &quot;AOV&quot; THEN [AOV (EUR) (copy)_1761188984219619331]&#13;&#10;WHEN &quot;Acquisitions&quot; THEN [Calculation_55732100024193025]&#13;&#10;WHEN &quot;Orders&quot; THEN [Calculation_663436574689521676]&#13;&#10;WHEN &quot;Customers&quot; THEN [Calculation_1761188984213704705]&#13;&#10;ELSE [Calculation_1761188984197636096]&#13;&#10;END' />
