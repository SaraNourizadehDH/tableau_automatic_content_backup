          <calculation class='tableau' formula='&quot;Orders&quot;' />
        </column>
        <column alias='EUR' caption='Currency_Selector' datatype='string' name='[GMV_Type_Selector (copy)_663436574674120710]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
          <calculation class='tableau' formula='&quot;EUR&quot;' />
          <aliases>
            <alias key='&quot;AED&quot;' value='AED' />
            <alias key='&quot;EUR&quot;' value='EUR' />
