          <relation connection='bigquery.16n6tc508afacj13ojyh31bei0lv' name='Currency Converter 1' type='text'>WITH&#13;
  long_data AS (&#13;
  SELECT&#13;
    EXTRACT(YEAR FROM exc.exchange_rate_date) AS Year,&#13;
    FORMAT_DATE( &quot;%b&quot;, exc.exchange_rate_date) AS Month,&#13;
    exc.currency_code,&#13;
    AVG(exchange_rate_value) AS conversion_factor&#13;
  FROM&#13;
    `tlb-data-prod.data_platform.dim_exchange_rate` exc&#13;
  WHERE&#13;
    exc.country_code IN (&apos;AE&apos;,&#13;
      &apos;BH&apos;,&#13;
      &apos;EG&apos;,&#13;
      &apos;JO&apos;,&#13;
      &apos;KW&apos;,&#13;
      &apos;OM&apos;,&#13;
      &apos;QA&apos;,&#13;
      &apos;SA&apos;)&#13;
    AND exc.exchange_rate_base = &apos;EUR&apos;&#13;
    AND exc.exchange_rate_date &gt;&gt;= &apos;2023-01-01&apos;&#13;
  GROUP BY&#13;
    1,&#13;
    2,&#13;
    3 ),&#13;
  wide_data AS (&#13;
  SELECT&#13;
    *&#13;
  FROM&#13;
    long_data PIVOT(SUM(conversion_factor) FOR currency_code IN (&apos;AED&apos;,&#13;
        &apos;BHD&apos;,&#13;
        &apos;EGP&apos;,&#13;
        &apos;JOD&apos;,&#13;
        &apos;KWD&apos;,&#13;
        &apos;OMR&apos;,&#13;
        &apos;QAR&apos;,&#13;
        &apos;SAR&apos;)) )&#13;
SELECT&#13;
  *&#13;
FROM&#13;
  wide_data</relation>
          <relation connection='bigquery.16n6tc508afacj13ojyh31bei0lv' name='Currency Converter' type='text'><![CDATA[with all_currencies as (
SELECT exc.exchange_rate_date, exc.country_code, exc.currency_code as currency_from, exc2.currency_code as currency_to, exc2.exchange_rate_value/exc.exchange_rate_value AS conversion_factor
FROM `tlb-data-prod.data_platform.dim_exchange_rate` exc
LEFT JOIN `tlb-data-prod.data_platform.dim_exchange_rate` exc2 ON exc.exchange_rate_date = exc2.exchange_rate_date
WHERE 
exc.exchange_rate_date >>='2022-01-01' 
AND exc.exchange_rate_base = 'EUR' 
AND exc.country_code IN
(
  'AE','BH','EG','JO','KW','OM','QA','SA'
)
AND
exc2.country_code IN ('AE','BH','EG','JO','KW','OM','QA','SA') AND exc2.exchange_rate_base = 'EUR'
AND exc.country_code <<>> exc2.country_code
)
,
eur as (
  select exc.exchange_rate_date, exc.country_code, exc.currency_code as currency_from, exc.exchange_rate_base as currency_to, 1.0/exc.exchange_rate_value as conversion_factor from `tlb-data-prod.data_platform.dim_exchange_rate` exc
  where exc.exchange_rate_date >>= '2022-01-01' AND exc.exchange_rate_base = 'EUR' AND exc.country_code in (  'AE','BH','EG','JO','KW','OM','QA','SA'
) 
)

,
long_data as (
select * from all_currencies
union all
select * from eur
)
,
wide_data as (
SELECT * from long_data
PIVOT(SUM(conversion_factor) for currency_to in ('AED','BHD','EGP','JOD','KWD','OMR','QAR','SAR','EUR'))
)

select exchange_rate_date, country_code, currency_from, IFNULL(AED,1) as AED,IFNULL(BHD,1) AS BHD,IFNULL(EGP,1) AS EGP,IFNULL(JOD,1) AS JOD,IFNULL(KWD,1) AS KWD,IFNULL(OMR,1) AS OMR,IFNULL(QAR,1) AS QAR,IFNULL(SAR,1) AS SAR,IFNULL(EUR,1) AS EUR
FROM wide_data]]></relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
