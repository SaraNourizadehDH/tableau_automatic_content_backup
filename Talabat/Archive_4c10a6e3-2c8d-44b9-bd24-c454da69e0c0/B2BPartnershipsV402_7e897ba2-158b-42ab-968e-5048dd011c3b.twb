,'37fd02b7-8030-4103-88d5-f9e242ee0baa'
,'3e6f056d-df76-4fae-b1da-b7e96deb9b24'
,'52f78eaf-4fb4-4c17-8a08-201c37666c90'
,'68141c05-beef-4117-9440-e1bac99c0f2f'
,'30ad7852-511c-42cc-a904-d173b855d8da'
,'0ce39208-f9e8-4cea-a157-2af11932fc96'
,'cd4189fa-b6ee-4eb0-93d3-254d8c7c5efa'
,'6e9b654f-41ad-4600-9863-4fdc810aaa07'
,'c4546fa0-7be7-4d32-9d55-6fc0bd6ebe45'
,'8c337354-0581-4f5c-83bc-68680aff7256'
)
)
) AND NOT (LOWER(name) like '%vendor%'OR LOWER(name) LIKE '%fleyfley%' OR LOWER(name) LIKE '%dominos%' OR LOWER(name) LIKE '%kloudc%' OR name LIKE '%duplicate%'OR name LIKE '%test%')
AND foi.order_date >>= '2022-01-01'
)
,
all_redemptions AS (
    SELECT 1 as Redemption_Key, country_Code AS Redemption_Market, IF
  (name LIKE 'other%', SPLIT(name, '_')[ORDINAL(4)],
  IF
    (LOGICAL_AND(SPLIT(SPLIT(name,'_')[ORDINAL(6)],'-')[ORDINAL(1)] IS NULL
        OR SAFE_CAST(SPLIT(SPLIT(name,'_')[ORDINAL(6)],'-')[ORDINAL(1)] AS NUMERIC) IS NOT NULL
        OR SPLIT(name,'_')[ORDINAL(6)] ='100%'), SPLIT(NAME,'_')[ORDINAL(5)],
    IF
      (SPLIT(NAME,'_')[ORDINAL(6)]='uc', SPLIT(name,'_')[ORDINAL(4)], SPLIT(name,'_')[ORDINAL(6)]))) AS Redemption_Partner,
    order_date AS Redemption_Order_Date, loyality_discount_lc AS Redemption_Incentive_Amount_LC, CAST(Order_ID AS STRING) AS Redemption_Order_ID, "Redemption" AS Redemption_Model, name AS Redemption_Campaign_Name, id AS Redemption_Campaign_ID, NULL AS Redemption_Acquisition_Flag, 'Redemption' AS Redemption_Code, 'Voucher' AS Redemption_Type, "Incentive" AS Redemption_GMV_Type, delivery_location_id FROM t
    GROUP BY 1,2,4,5,6,7,8,9,14
)
,
aura_details AS (
select 
  "QA" as country_code,
  vd.campaign_reference_id,
  foi.order_id, order_date, vd.order_discount_lc, foi.delivery_location_id
from `tlb-data-prod.data_platform.dim_incentives_voucher_details` vd
left join `tlb-data-prod.data_platform.dim_incentives_voucher` div ON vd.campaign_reference_id = div.campaign_id
left join `tlb-data-prod.data_platform.dim_country_info` country ON country.country_id = div.country_id
left join `tlb-data-prod.data_platform.fct_order_info` foi ON CAST(foi.order_id AS STRING) = vd.order_id AND foi.order_date >>= '2023-05-01' AND foi.order_date << '2024-01-01'
where lower(campaign_reference_id) like lower('%qa_partnership_B2B%aura%') and created_on_date >>= '2023-05-01' and foi.order_id IS NOT NULL AND foi.is_successful
),
aura_redemptions AS (
SELECT 1 AS Redemption_Key, country_code AS Redemption_Market, 'Aura Hospitality' AS Redemption_Partner, order_date AS Redemption_Order_Date, order_discount_lc AS Redemption_Incentive_Amount_LC, CAST(order_id AS STRING) AS Redemption_Order_ID, 'Redemption' AS Redemption_Model, campaign_reference_id AS Redemption_Campaign_Name, 'aura_campaign_05_2023' AS Redemption_Campaign_ID, null as Redemption_Acquisition_Flag, 'AURA_EMPLOYEE_DISCOUNT' AS Redemption_Code, 'Voucher' AS Redemption_Type, 'Incentive' AS Redemption_GMV_Type,delivery_location_id 
FROM aura_details
),

all_data as (
SELECT * FROM aura_redemptions
UNION ALL
SELECT * FROM all_redemptions
)

SELECT *
FROM all_data]]></relation>
            </relation>
