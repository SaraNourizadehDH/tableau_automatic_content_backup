              <calculation class='tableau' formula='CASE [Parameters].[GMV_Type_Selector (copy)_663436574674120710] &#13;&#10;WHEN &quot;EUR&quot; THEN [Budget Amount (EUR)]&#13;&#10;WHEN &quot;AED&quot; THEN [Budget Amount (EUR)]*[AED (Custom SQL Query)]&#13;&#10;WHEN &quot;BHD&quot; THEN [Budget Amount (EUR)]*[BHD (Custom SQL Query)]&#13;&#10;WHEN &quot;EGP&quot; THEN [Budget Amount (EUR)]*[EGP (Custom SQL Query)]&#13;&#10;WHEN &quot;JOD&quot; THEN [Budget Amount (EUR)]*[JOD (Custom SQL Query)]&#13;&#10;WHEN &quot;KWD&quot; THEN [Budget Amount (EUR)]*[KWD (Custom SQL Query)]&#13;&#10;WHEN &quot;OMR&quot; THEN [Budget Amount (EUR)]*[OMR (Custom SQL Query)]&#13;&#10;WHEN &quot;QAR&quot; THEN [Budget Amount (EUR)]*[QAR (Custom SQL Query)]&#13;&#10;WHEN &quot;SAR&quot; THEN [Budget Amount (EUR)]*[SAR (Custom SQL Query)]&#13;&#10;END' />
