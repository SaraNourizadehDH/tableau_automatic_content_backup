            <column caption='Measure_' datatype='string' name='[B2B Measure (copy)_1094093291197362178]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[GMV_Type_Selector (copy)_1761188984219283458] &#13;&#10;WHEN  &quot;AOV&quot; THEN &quot;AOV&quot;&#13;&#10;WHEN &quot;Acquisitions&quot; THEN &quot;Acquisitions&quot;&#13;&#10;WHEN &quot;Orders&quot; THEN &quot;Orders&quot;&#13;&#10;WHEN &quot;Customers&quot; THEN &quot;Customers&quot;&#13;&#10;ELSE &quot;AOF&quot;&#13;&#10;END' />
            </column>
