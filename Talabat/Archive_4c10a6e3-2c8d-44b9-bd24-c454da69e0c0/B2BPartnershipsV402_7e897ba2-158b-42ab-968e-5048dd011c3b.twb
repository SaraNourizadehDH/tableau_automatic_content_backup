    <datasource caption='B2B Partnerships' inline='true' name='federated.1jtxrin06qgxrt1gvpqtp0stsb2e' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.16n6tc508afacj13ojyh31bei0lv'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-nondatateam-analysis-9264' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform' server-oauth='' username='zehra.saifuddin@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
          <named-connection caption='Partners &amp; Sales + Credit Incentive' name='cloudfile:googledrive-excel-direct.0iid07x1c0u8yv10edsky1i2iqsv'>
            <connection class='cloudfile:googledrive-excel-direct' cleaning='no' cloudFileExtension='xlsx' cloudFileId='1WTt7AX_U3yIo7IujfdE3bN8epbOpMOO2P5V07Shc6lM' cloudFileMetadata_-_folder='root' cloudFileName='Syncing Data from B2B Tracker 2023.xlsx' cloudFileProvider='googledrive' cloudFileRequestURL='https://www.googleapis.com/drive/v3/files/1WTt7AX_U3yIo7IujfdE3bN8epbOpMOO2P5V07Shc6lM/export?mimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' compat='no' dataRefreshTime='' filename='Syncing Data from B2B Tracker 2023.xlsx' interpretationMode='0' server='' server-oauth='server-custom' username='zehra.saifuddin@talabat.com' validate='no' workgroup-auth-mode='prompt' />
