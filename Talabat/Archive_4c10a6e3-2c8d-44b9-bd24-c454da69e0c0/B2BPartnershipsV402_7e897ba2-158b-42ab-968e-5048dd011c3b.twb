              <relation name='Budget Figures_B882370FBFEF4A5B8E0D4B690725EC64' table='[Extract].[Budget Figures_B882370FBFEF4A5B8E0D4B690725EC64]' type='table' />
            </properties>
          </object>
          <object caption='Partners' id='Partners_7AA7600C4660436EBFACBC8DD3D43069'>
            <properties context=''>
              <relation connection='cloudfile:googledrive-excel-direct.0iid07x1c0u8yv10edsky1i2iqsv' name='Partners' table='[Partners$]' type='table'>
                <columns gridOrigin='A1:D470:no:A1:D470:0' header='yes' outcome='2'>
                  <column datatype='string' name='Country' ordinal='0' />
