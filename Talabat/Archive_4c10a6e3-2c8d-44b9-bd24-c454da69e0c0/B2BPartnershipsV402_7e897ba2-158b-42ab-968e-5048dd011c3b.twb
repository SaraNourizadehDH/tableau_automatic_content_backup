            <column caption='GMV_Type_Calculator' datatype='real' name='[Calculation_663436574670409730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Total&quot; THEN [Incentive_GMV_EUR (copy)_663436574672142341]&#13;&#10;WHEN &quot;Incentive&quot; THEN [Incremental_GMV_EUR (copy)_663436574671728644]&#13;&#10;WHEN &quot;Incremental&quot; THEN [Calculation_663436574671052803]&#13;&#10;END' />
            </column>
            <column caption='Incremental_GMV' datatype='real' name='[Calculation_663436574671052803]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[GMV_Type_Selector (copy)_663436574674120710] &#13;&#10;WHEN &quot;EUR&quot; THEN [Incremental_GMV_Amount_LC]*[EUR]&#13;&#10;WHEN &quot;AED&quot; THEN [Incremental_GMV_Amount_LC]*[AED]&#13;&#10;WHEN &quot;BHD&quot; THEN [Incremental_GMV_Amount_LC]*[BHD]&#13;&#10;WHEN &quot;EGP&quot; THEN [Incremental_GMV_Amount_LC]*[EGP]&#13;&#10;WHEN &quot;JOD&quot; THEN [Incremental_GMV_Amount_LC]*[JOD]&#13;&#10;WHEN &quot;KWD&quot; THEN [Incremental_GMV_Amount_LC]*[KWD]&#13;&#10;WHEN &quot;OMR&quot; THEN [Incremental_GMV_Amount_LC]*[OMR]&#13;&#10;WHEN &quot;QAR&quot; THEN [Incremental_GMV_Amount_LC]*[QAR]&#13;&#10;WHEN &quot;SAR&quot; THEN [Incremental_GMV_Amount_LC]*[SAR]&#13;&#10;END' />
            </column>
            <column caption='YTD_Filter' datatype='string' name='[Calculation_81909225682784256]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEDIFF(&apos;year&apos;,[Calculation_938719101622747142],TODAY())=0 AND [Calculation_938719101622747142] &lt; TODAY()&#13;&#10;THEN &apos;Year to Date&apos;&#13;&#10;&#13;&#10;ELSEIF DATEDIFF(&apos;year&apos;,[Calculation_938719101622747142],TODAY())=1 AND [Calculation_938719101622747142] &lt; DATEADD(&apos;year&apos;,-1,TODAY())&#13;&#10;THEN &apos;Last Year to Date&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='(ZN(SUM([GMV_Type_Calculator])) - LOOKUP(ZN(SUM([GMV_Type_Cal...' datatype='real' name='[Calculation_81909225696698373]' role='measure' type='quantitative' user:unnamed='YTD Comparison GMV (Table)'>
              <calculation class='tableau' formula='(ZN(SUM([Calculation_663436574670409730])) - LOOKUP(ZN(SUM([Calculation_663436574670409730])), -1)) / ABS(LOOKUP(ZN(SUM([Calculation_663436574670409730])), -1))'>
