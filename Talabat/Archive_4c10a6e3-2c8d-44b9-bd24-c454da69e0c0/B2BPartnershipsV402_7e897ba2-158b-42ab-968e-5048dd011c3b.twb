              <calculation class='tableau' formula='CASE [Parameters].[GMV_Type_Selector (copy)_663436574674120710] &#13;&#10;WHEN &quot;EUR&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales_Credit_Incentive_GMV_Amount_LC],0))*[EUR]&#13;&#10;WHEN &quot;AED&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales_Credit_Incentive_GMV_Amount_LC],0))*[AED] &#13;&#10;WHEN &quot;BHD&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales_Credit_Incentive_GMV_Amount_LC],0))*[BHD]&#13;&#10;WHEN &quot;EGP&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales_Credit_Incentive_GMV_Amount_LC],0))*[EGP]&#13;&#10;WHEN &quot;JOD&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales_Credit_Incentive_GMV_Amount_LC],0))*[JOD]&#13;&#10;WHEN &quot;KWD&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales_Credit_Incentive_GMV_Amount_LC],0))*[KWD]&#13;&#10;WHEN &quot;OMR&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales_Credit_Incentive_GMV_Amount_LC],0))*[OMR]&#13;&#10;WHEN &quot;QAR&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales_Credit_Incentive_GMV_Amount_LC],0))*[QAR]&#13;&#10;WHEN &quot;SAR&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales_Credit_Incentive_GMV_Amount_LC],0)