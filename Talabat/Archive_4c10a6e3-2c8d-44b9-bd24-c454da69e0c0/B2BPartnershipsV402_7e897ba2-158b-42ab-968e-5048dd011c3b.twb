) 
--2022 campaigns without the correct naming convention
OR vo.id IN (
 'c716d828-e22c-4c12-91f8-5d9ab5a41fd2'
,'cb997fc4-ef50-4519-8069-9aa06607827b'
,'efa88edf-8736-4114-b178-7541eebe9d79'
