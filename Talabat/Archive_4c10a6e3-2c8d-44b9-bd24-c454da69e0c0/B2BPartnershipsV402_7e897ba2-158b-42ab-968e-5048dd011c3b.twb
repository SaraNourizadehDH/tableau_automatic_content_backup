          <datasource-dependencies datasource='federated.1jtxrin06qgxrt1gvpqtp0stsb2e'>
            <column datatype='real' name='[AED]' role='measure' type='quantitative' />
            <column caption='AOV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AOV (EUR) (copy)_1761188984219619331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[GMV_Type_Selector (copy)_663436574674120710] &#13;&#10;WHEN &quot;EUR&quot; THEN AVG([Calculation_1869556813800005632]*[EUR]/1.0)&#13;&#10;WHEN &quot;AED&quot; THEN AVG([Calculation_1869556813800005632]*[AED]/1.0)&#13;&#10;WHEN &quot;BHD&quot; THEN AVG([Calculation_1869556813800005632]*[BHD]/1.0)&#13;&#10;WHEN &quot;EGP&quot; THEN AVG([Calculation_1869556813800005632]*[EGP]/1.0)&#13;&#10;WHEN &quot;JOD&quot; THEN AVG([Calculation_1869556813800005632]*[JOD]/1.0)&#13;&#10;WHEN &quot;KWD&quot; THEN AVG([Calculation_1869556813800005632]*[KWD]/1.0)&#13;&#10;WHEN &quot;OMR&quot; THEN AVG([Calculation_1869556813800005632]*[OMR]/1.0)&#13;&#10;WHEN &quot;QAR&quot; THEN AVG([Calculation_1869556813800005632]*[QAR]/1.0)&#13;&#10;WHEN &quot;SAR&quot; THEN AVG([Calculation_1869556813800005632]*[SAR]/1.0)&#13;&#10;END' />
            </column>
