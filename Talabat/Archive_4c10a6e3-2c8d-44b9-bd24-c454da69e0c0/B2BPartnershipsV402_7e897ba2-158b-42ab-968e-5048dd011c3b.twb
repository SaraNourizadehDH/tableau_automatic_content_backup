          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1jtxrin06qgxrt1gvpqtp0stsb2e'>
            <column datatype='real' name='[AED]' role='measure' type='quantitative' />
            <column datatype='real' name='[BHD]' role='measure' type='quantitative' />
            <column caption='GMV_Type_Calculator' datatype='real' name='[Calculation_663436574670409730]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Total&quot; THEN [Incentive_GMV_EUR (copy)_663436574672142341]&#13;&#10;WHEN &quot;Incentive&quot; THEN [Incremental_GMV_EUR (copy)_663436574671728644]&#13;&#10;WHEN &quot;Incremental&quot; THEN [Calculation_663436574671052803]&#13;&#10;END' />
            </column>
            <column caption='Incremental_GMV' datatype='real' name='[Calculation_663436574671052803]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[GMV_Type_Selector (copy)_663436574674120710] &#13;&#10;WHEN &quot;EUR&quot; THEN [Incremental_GMV_Amount_LC]*[EUR]&#13;&#10;WHEN &quot;AED&quot; THEN [Incremental_GMV_Amount_LC]*[AED]&#13;&#10;WHEN &quot;BHD&quot; THEN [Incremental_GMV_Amount_LC]*[BHD]&#13;&#10;WHEN &quot;EGP&quot; THEN [Incremental_GMV_Amount_LC]*[EGP]&#13;&#10;WHEN &quot;JOD&quot; THEN [Incremental_GMV_Amount_LC]*[JOD]&#13;&#10;WHEN &quot;KWD&quot; THEN [Incremental_GMV_Amount_LC]*[KWD]&#13;&#10;WHEN &quot;OMR&quot; THEN [Incremental_GMV_Amount_LC]*[OMR]&#13;&#10;WHEN &quot;QAR&quot; THEN [Incremental_GMV_Amount_LC]*[QAR]&#13;&#10;WHEN &quot;SAR&quot; THEN [Incremental_GMV_Amount_LC]*[SAR]&#13;&#10;END' />
            </column>
            <column caption='Order_Date' datatype='date' name='[Calculation_938719101622747142]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IFNULL([Full_Order_Date], IFNULL([Redemption_Order_Date], IFNULL([Sales_Credit_Order_Date], [Incremental_Order_Date])))&#13;&#10;//IFNULL(IFNULL([Full_Order_Date], IFNULL([Redemption_Order_Date], IFNULL([Sales Credit Order Date], [Incremental_Order_Date]))),[Etihad Order Date])' />
            </column>
            <column caption='Model' datatype='string' name='[Calculation_938719101625524233]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([Full_Model], IFNULL([Redemption_Model], IFNULL([Sales_Credit_Model], [Incremental_Model])))&#13;&#10;//IFNULL(IFNULL([Full_Model], IFNULL([Redemption_Model], IFNULL([Sales Credit Model], [Incremental_Model]))),[Etihad Model])' />
            </column>
            <column caption='Type' datatype='string' name='[Calculation_938719101629603854]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IFNULL([Full_Type], IFNULL([Redemption_Type], IFNULL([Sales_Credit_Type], [Incremental_Type])))&#13;&#10;//IFNULL(IFNULL([Full_Type], IFNULL([Redemption_Type], IFNULL([Sales Credit Type], [Incremental_Type]))), [Etihad Type])' />
            </column>
            <column caption='Market_' datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[EGP]' role='measure' type='quantitative' />
            <column datatype='real' name='[EUR]' role='measure' type='quantitative' />
            <column datatype='real' name='[Full_Incentive_Amount_LC]' role='measure' type='quantitative' />
            <column datatype='string' name='[Full_Model]' role='dimension' type='nominal' />
            <column datatype='date' name='[Full_Order_Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Full_Type]' role='dimension' type='nominal' />
            <column caption='Total_GMV' datatype='real' name='[Incentive_GMV_EUR (copy)_663436574672142341]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[GMV_Type_Selector (copy)_663436574674120710] &#13;&#10;WHEN &quot;EUR&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales_Credit_Incentive_GMV_Amount_LC],0))*[EUR]&#13;&#10;WHEN &quot;AED&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales_Credit_Incentive_GMV_Amount_LC],0))*[AED] &#13;&#10;WHEN &quot;BHD&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales_Credit_Incentive_GMV_Amount_LC],0))*[BHD]&#13;&#10;WHEN &quot;EGP&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales_Credit_Incentive_GMV_Amount_LC],0))*[EGP]&#13;&#10;WHEN &quot;JOD&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales_Credit_Incentive_GMV_Amount_LC],0))*[JOD]&#13;&#10;WHEN &quot;KWD&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales_Credit_Incentive_GMV_Amount_LC],0))*[KWD]&#13;&#10;WHEN &quot;OMR&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales_Credit_Incentive_GMV_Amount_LC],0))*[OMR]&#13;&#10;WHEN &quot;QAR&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales_Credit_Incentive_GMV_Amount_LC],0))*[QAR]&#13;&#10;WHEN &quot;SAR&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales_Credit_Incentive_GMV_Amount_LC],0))*[SAR]&#13;&#10;END&#13;&#10;//CASE [Currency_Selector] &#13;&#10;//WHEN &quot;EUR&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales Credit Incentive GMV Amount LC],0)+IFNULL([Etihad Incentive GMV LC],0))*[EUR]&#13;&#10;//WHEN &quot;AED&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales Credit Incentive GMV Amount LC],0)+IFNULL([Etihad Incentive GMV LC],0))*[AED] &#13;&#10;//WHEN &quot;BHD&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales Credit Incentive GMV Amount LC],0)+IFNULL([Etihad Incentive GMV LC],0))*[BHD]&#13;&#10;//WHEN &quot;EGP&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales Credit Incentive GMV Amount LC],0)+IFNULL([Etihad Incentive GMV LC],0))*[EGP]&#13;&#10;//WHEN &quot;JOD&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales Credit Incentive GMV Amount LC],0)+IFNULL([Etihad Incentive GMV LC],0))*[JOD]&#13;&#10;//WHEN &quot;KWD&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales Credit Incentive GMV Amount LC],0)+IFNULL([Etihad Incentive GMV LC],0))*[KWD]&#13;&#10;//WHEN &quot;OMR&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales Credit Incentive GMV Amount LC],0)+IFNULL([Etihad Incentive GMV LC],0))*[OMR]&#13;&#10;//WHEN &quot;QAR&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales Credit Incentive GMV Amount LC],0)+IFNULL([Etihad Incentive GMV LC],0))*[QAR]&#13;&#10;//WHEN &quot;SAR&quot; THEN (IFNULL([Incremental_GMV_Amount_LC],0)+IFNULL([Full_Incentive_Amount_LC],0)+IFNULL([Redemption_Incentive_Amount_LC],0)+IFNULL([Sales Credit Incentive GMV Amount LC],0)+IFNULL([Etihad Incentive GMV LC],0))*[SAR]&#13;&#10;//END' />
            </column>
            <column datatype='real' name='[Incremental_GMV_Amount_LC]' role='measure' type='quantitative' />
