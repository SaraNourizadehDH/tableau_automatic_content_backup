    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='GMV Comparisons'>
      <repository-location id='GMVComparisons' path='/t/Talabat/workbooks/B2B_Partnerships_V4_0_2' revision='' site='Talabat' />
      <style />
      <size maxheight='2500' maxwidth='1600' minheight='2500' minwidth='1600' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='B2B Partnerships' name='federated.1jtxrin06qgxrt1gvpqtp0stsb2e' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column alias='EUR' caption='Currency_Selector' datatype='string' name='[GMV_Type_Selector (copy)_663436574674120710]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
          <calculation class='tableau' formula='&quot;EUR&quot;' />
          <aliases>
            <alias key='&quot;AED&quot;' value='AED' />
            <alias key='&quot;EUR&quot;' value='EUR' />
          </aliases>
          <members>
            <member alias='EUR' value='&quot;EUR&quot;' />
            <member alias='AED' value='&quot;AED&quot;' />
            <member value='&quot;BHD&quot;' />
            <member value='&quot;EGP&quot;' />
            <member value='&quot;JOD&quot;' />
            <member value='&quot;KWD&quot;' />
            <member value='&quot;OMR&quot;' />
            <member value='&quot;QAR&quot;' />
            <member value='&quot;SAR&quot;' />
          </members>
        </column>
        <column alias='Total GMV' caption='GMV_Type_Selector' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Total&quot;'>
          <calculation class='tableau' formula='&quot;Total&quot;' />
          <aliases>
            <alias key='&quot;Incentive&quot;' value='Incentive GMV' />
            <alias key='&quot;Incremental&quot;' value='Incremental GMV' />
            <alias key='&quot;Total&quot;' value='Total GMV' />
          </aliases>
          <members>
            <member alias='Total GMV' value='&quot;Total&quot;' />
            <member alias='Incentive GMV' value='&quot;Incentive&quot;' />
            <member alias='Incremental GMV' value='&quot;Incremental&quot;' />
          </members>
        </column>
        <column caption='Top and Bottom N' datatype='integer' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='5'>
          <calculation class='tableau' formula='5' />
          <members>
            <member value='1' />
            <member value='2' />
            <member value='3' />
            <member value='4' />
            <member value='5' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1jtxrin06qgxrt1gvpqtp0stsb2e'>
        <column caption='Top 5/Bottom 5' datatype='string' name='[Calculation_738308871410565120]' role='measure' type='nominal'>
          <calculation class='tableau' formula='IF RANK(SUM([Calculation_663436574670409730])) &lt;= [Parameters].[Parameter 2]&#13;&#10;THEN &quot;Top N&quot;&#13;&#10;ELSEIF&#13;&#10;WINDOW_MAX(RANK(SUM([Calculation_663436574670409730]))) - RANK(SUM([Calculation_663436574670409730])) &lt; [Parameters].[Parameter 2]&#13;&#10;THEN &quot;Bottom N&quot;&#13;&#10;ELSE &quot;Others&quot;&#13;&#10;END'>
            <table-calc ordering-field='[federated.1jtxrin06qgxrt1gvpqtp0stsb2e].[Partner (Partners)]' ordering-type='Field' />
          </calculation>
        </column>
        <column caption='Order_Date' datatype='date' name='[Calculation_938719101622747142]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='IFNULL([Full_Order_Date], IFNULL([Redemption_Order_Date], IFNULL([Sales_Credit_Order_Date], [Incremental_Order_Date])))&#13;&#10;//IFNULL(IFNULL([Full_Order_Date], IFNULL([Redemption_Order_Date], IFNULL([Sales Credit Order Date], [Incremental_Order_Date]))),[Etihad Order Date])' />
        </column>
        <column caption='Model' datatype='string' name='[Calculation_938719101625524233]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IFNULL([Full_Model], IFNULL([Redemption_Model], IFNULL([Sales_Credit_Model], [Incremental_Model])))&#13;&#10;//IFNULL(IFNULL([Full_Model], IFNULL([Redemption_Model], IFNULL([Sales Credit Model], [Incremental_Model]))),[Etihad Model])' />
        </column>
        <column caption='Type' datatype='string' name='[Calculation_938719101629603854]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='IFNULL([Full_Type], IFNULL([Redemption_Type], IFNULL([Sales_Credit_Type], [Incremental_Type])))&#13;&#10;//IFNULL(IFNULL([Full_Type], IFNULL([Redemption_Type], IFNULL([Sales Credit Type], [Incremental_Type]))), [Etihad Type])' />
