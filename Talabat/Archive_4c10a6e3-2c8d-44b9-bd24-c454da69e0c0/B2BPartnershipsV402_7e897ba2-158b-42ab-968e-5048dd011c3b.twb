            <connection class='cloudfile:googledrive-excel-direct' cleaning='no' cloudFileExtension='xlsx' cloudFileId='1WTt7AX_U3yIo7IujfdE3bN8epbOpMOO2P5V07Shc6lM' cloudFileMetadata_-_folder='root' cloudFileName='Syncing Data from B2B Trackers (2022+2023+2024).xlsx' cloudFileProvider='googledrive' cloudFileRequestURL='https://www.googleapis.com/drive/v3/files/1WTt7AX_U3yIo7IujfdE3bN8epbOpMOO2P5V07Shc6lM/export?mimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' compat='no' dataRefreshTime='' filename='Syncing Data from B2B Trackers (2022+2023+2024).xlsx' interpretationMode='0' server='' server-oauth='server-custom' username='zehra.saifuddin@talabat.com' validate='no' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='cloudfile:googledrive-excel-direct.0uhwvzk1b2fc4k1b7m3db0x9kpia' name='Budget Figures' table='[&apos;Budget Figures$&apos;]' type='table'>
          <columns gridOrigin='A1:F181:no:A1:F181:0' header='yes' outcome='6'>
            <column datatype='string' name='Market' ordinal='0' />
            <column datatype='string' name='Budget Type' ordinal='1' />
            <column datatype='string' name='Month' ordinal='2' />
            <column datatype='integer' name='Year' ordinal='3' />
            <column datatype='integer' name='Budget Amount (EUR)' ordinal='4' />
            <column datatype='date' name='Date' ordinal='5' />
          </columns>
        </_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='cloudfile:googledrive-excel-direct.0iid07x1c0u8yv10edsky1i2iqsv' name='Partners' table='[Partners$]' type='table'>
            <columns gridOrigin='A1:D470:no:A1:D470:0' header='yes' outcome='2'>
              <column datatype='string' name='Country' ordinal='0' />
              <column datatype='string' name='DB Partner Name' ordinal='1' />
              <column datatype='string' name='Partner' ordinal='2' />
              <column datatype='string' name='Offering' ordinal='3' />
            </columns>
          </relation>
          <relation join='full' type='join'>
            <clause type='join'>
              <expression op='='>
                <expression op='[Incentive + Incrementals].[Key]' />
                <expression op='[PRE DISCOUNT Sales + Credit Inc].[Sales_Credit_Key]' />
              </expression>
            </clause>
            <relation join='full' type='join'>
              <clause type='join'>
                <expression op='='>
                  <expression op='[Incentive + Incrementals].[Key]' />
                  <expression op='[Redemption Incentive].[Redemption_Key]' />
                </expression>
              </clause>
              <relation join='full' type='join'>
                <clause type='join'>
                  <expression op='='>
                    <expression op='[Incentive + Incrementals].[Key]' />
                    <expression op='[Full Incentive].[Full_Key]' />
                  </expression>
                </clause>
                <relation join='full' type='join'>
                  <clause type='join'>
                    <expression op='='>
                      <expression op='[Incentive + Incrementals].[Key]' />
                      <expression op='[All Incrementals].[Incremental_Key]' />
                    </expression>
                  </clause>
                  <relation connection='cloudfile:googledrive-excel-direct.0iid07x1c0u8yv10edsky1i2iqsv' name='Incentive + Incrementals' table='[Scaffold$]' type='table'>
                    <columns gridOrigin='A1:A5:no:A1:A5:0' header='yes' outcome='6'>
                      <column datatype='integer' name='Key' ordinal='0' />
                    </columns>
                  </relation>
                  <relation connection='bigquery.16n6tc508afacj13ojyh31bei0lv' name='All Incrementals' type='text'><![CDATA[-- INCREMENTAL TABLEAU
with earn_dates AS (
select country_code, partner, account_id, min(CAST(created_time_lc as date)) AS first_earn_date, max(expiry_date) AS last_expiry_date, SUM(amount_lc) as earned_amount_lc, sum(ifnull(expired_amount_lc,0)) as expired_amount_lc
from (select t.*,
             sum(case when prev_enddate >>= date_add(cast(created_time_lc as date),INTERVAL -1 DAY ) then 0 else 1 end) over 
                 (partition by account_id order by created_time_lc) as grp
      from (select wlt.*, (CASE 
WHEN LOWER(wlt.description) LIKE '%roche%' THEN 'Roche' 
WHEN (LOWER(wlt.description) LIKE '%nielsen%' AND wlt.expiry_days <<= 30) THEN 'Nielsen' 
WHEN (LOWER(wlt.description) LIKE '%nielsen%' AND wlt.expiry_days = 365) THEN 'Nielsen (July Agreement)'     
WHEN LOWER(wlt.description) LIKE '%\\_mondelez\\_%' THEN 'Mondelez'
WHEN LOWER(wlt.description) LIKE '%siemens\\_%' THEN 'Siemens'
WHEN LOWER(wlt.description) LIKE '%\\_sigmaegp\\_%' THEN 'Sigma'
WHEN LOWER(wlt.description) LIKE '%\\_ego\\_%' THEN 'EGO'
WHEN LOWER(wlt.description) LIKE '%\\_bms(egypt)\\_%' THEN 'BMS'
WHEN LOWER(wlt.description) LIKE '%\\_audiomob\\_%' THEN 'AudioMob'
WHEN LOWER(wlt.description) LIKE '%\\_dnatatravel\\_%' THEN 'dnata Travel'
WHEN LOWER(wlt.description) LIKE '%enbd\\_%' THEN 'ENBD'
WHEN LOWER(wlt.description) LIKE '%\\_ooredoo%' THEN 'Ooredoo'
WHEN LOWER(wlt.description) LIKE '%\\_nbkghatawi\\_%' THEN 'NBK'
WHEN LOWER(wlt.description) LIKE '%\\_abk(kuwait)\\_%' THEN 'ABK'
WHEN (LOWER(wlt.description) LIKE '%\\_aub%' AND LOWER(wlt.description) LIKE '%new campaign%') THEN 'Ahli United Bank (New Agreement)'
WHEN LOWER(wlt.description) LIKE '%\\_aub%' THEN 'Ahli United Bank'
WHEN LOWER(wlt.description) LIKE '%f\\_and\\_g\\_trade%' THEN 'F&G Trade'
WHEN LOWER(wlt.description) LIKE '%\\_omantelmakasib\\_%' THEN 'Omantel'
WHEN LOWER(wlt.description) LIKE '%\\_fifa\\_%' THEN 'FIFA'
WHEN LOWER(wlt.description) LIKE '%\\_kib\\_%' THEN 'KIB'
WHEN LOWER(wlt.description) LIKE '%\\_cbk(kuwait)\\_%' THEN 'CBK'
WHEN LOWER(wlt.description) LIKE '%\\_techne\\_%' THEN 'Techne Summit (KDGP)' 
WHEN LOWER(wlt.description) LIKE '%\\_arabiaweather\\_%' THEN 'Arabia Weather' --ADD NEW PARTNERS HERE
END
) as partner ,
            lag(wlt.expiry_date) over (partition by account_id order by created_time_lc) as prev_enddate
            from `tlb-data-prod.data_platform.fct_wallet_transaction` wlt
            where wlt.is_bulk_gift --AND wlt.description LIKE '%Roche%'
            
AND (
(LOWER(wlt.description) LIKE '%roche%' AND wlt.country_code = 'EG') OR
(LOWER(wlt.description) LIKE '%nielsen%' AND wlt.country_code = 'EG') OR    
(LOWER(wlt.description) LIKE '%\\_mondelez\\_%' AND wlt.country_code = 'EG')OR
(LOWER(wlt.description) LIKE '%siemens\\_%' AND wlt.country_code = 'EG') OR
(LOWER(wlt.description) LIKE '%\\_sigmaegp\\_%'  AND wlt.country_code = 'EG')OR
(LOWER(wlt.description) LIKE '%\\_ego\\_%' AND wlt.country_code = 'EG') OR
(LOWER(wlt.description) LIKE '%\\_bms(egypt)\\_%' AND wlt.country_code = 'EG') OR 
(LOWER(wlt.description) LIKE '%\\_audiomob\\_%' AND wlt.country_code = 'AE') OR
(LOWER(wlt.description) LIKE '%\\_dnatatravel\\_%' AND wlt.country_code = 'AE') OR 
(LOWER(wlt.description) LIKE '%enbd\\_%'  AND wlt.country_code = 'AE')OR
(LOWER(wlt.description) LIKE '%\\_ooredoo%'AND wlt.country_code = 'KW') OR
(LOWER(wlt.description) LIKE '%\\_nbkghatawi\\_%' AND wlt.country_code = 'KW') OR
(LOWER(wlt.description) LIKE '%\\_abk(kuwait)\\_%'  AND wlt.country_code = 'KW') OR
(LOWER(wlt.description) LIKE '%\\_aub%' AND wlt.country_code = 'BH') OR
(LOWER(wlt.description) LIKE '%f\\_and\\_g\\_trade%' AND wlt.country_code = 'EG') OR
(LOWER(wlt.description) LIKE '%\\_omantelmakasib\\_%' AND wlt.country_code = 'OM') OR
(LOWER(wlt.description) LIKE '%\\_fifa\\_%' AND wlt.country_code = 'QA') OR
(LOWER(wlt.description) LIKE '%\\_kib\\_%' AND wlt.country_code = 'KW') OR
(LOWER(wlt.description) LIKE '%\\_cbk(kuwait)\\_%' AND wlt.country_code = 'KW') OR
(LOWER(wlt.description) LIKE '%\\_techne\\_%' AND wlt.description LIKE '%B2B%' AND wlt.country_code = 'EG') OR
(LOWER(wlt.description) LIKE '%\\_arabiaweather\\_%' AND wlt.country_code = 'JO')
)

           ) t
     ) t
group by country_code, partner, account_id, grp
order by 1,2,3,4
),

burns AS (
      SELECT wlt.country_code, wlt.account_id, wlt.amount_lc, wlt.order_id, cast(wlt.created_time_lc as date) as order_date, IFNULL(foi.paid_by_talabat_fee_amount_lc,0) as paid_by_talabat_fee_amount_lc, IFNULL(foi.paid_by_cc_fee_amount_lc,0)+ IFNULL(foi.paid_by_cash_fee_amount_lc,0)+ IFNULL(foi.paid_by_knet_fee_amount_lc,0) AS paid_by_other, wlt.description as burn_description, wlt.payment_method_id, if(foi.is_acquisition, 1, 0) as acquisition_flag, foi.basket_amount_lc, foi.delivery_location_id FROM `tlb-data-prod.data_platform.fct_wallet_transaction` wlt
      LEFT JOIN `tlb-data-prod.data_platform.fct_order_info` foi ON wlt.order_id = foi.order_id
      WHERE wlt.account_id IN (
      SELECT DISTINCT account_id from earn_dates
      ) 
      AND (wlt.description IS NULL OR wlt.description =  "") and wlt.amount_lc << 0 AND wlt.action_type = 'Burn'
      AND foi.is_successful 
      AND NOT (foi.is_duplicated_order OR foi.is_test) 
      AND wlt.payment_method_id = 45 AND foi.order_date >>= '2022-01-01'
),

refunds AS (
  SELECT wlt.account_id, wlt.order_id, max(cast(wlt.created_time_lc as date)) as refund_date, sum(ifnull(wlt.amount_lc,0)) as amount_refunded_lc FROM `tlb-data-prod.data_platform.fct_wallet_transaction` wlt WHERE wlt.account_id IN (
    select distinct account_id from earn_dates
  )
  AND wlt.amount_lc >> 0 AND not wlt.is_bulk_gift
  group by 1,2
),

details as (
SELECT earn_dates.*, burns.order_date AS burn_date, burns.order_id AS burn_order_id, -burns.amount_lc AS burn_amount_lc, paid_by_talabat_fee_amount_lc, paid_by_other as other_payment, burn_description, refunds.refund_date, refunds.amount_refunded_lc, burns.payment_method_id, burns.acquisition_flag, burns.basket_amount_lc, burns.delivery_location_id
FROM earn_dates
LEFT JOIN burns ON (earn_dates.account_id = burns.account_id) AND (burns.order_date>>=earn_dates.first_earn_date) AND (burns.order_date<<=earn_dates.last_expiry_date) AND (earn_dates.country_code = burns.country_code)
LEFT JOIN refunds ON (burns.order_id = refunds.order_id) AND (refunds.account_id = burns.account_id)
WHERE burns.order_id IS NOT NULL
AND burns.order_id <<>> 0
),

filtered_details as (
SELECT country_code, partner, account_id, burn_date, burn_order_id, --burn_amount_lc, -- CAUSING DUPLICATES BECAUSE OF NOT MATCHING WITH paid_by_talabat_fee_amount_lc
paid_by_talabat_fee_amount_lc, other_payment, refund_date, amount_refunded_lc, GREATEST((other_payment - IFNULL(amount_refunded_lc,0)),0)  AS incremental_gmv_lc, acquisition_flag, basket_amount_lc,delivery_location_id
FROM details
WHERE burn_order_id IS NOT NULL
AND burn_order_id <<>> 0
AND burn_date >>= '2022-01-01'
AND payment_method_id = 45
)

,
credits AS (
select DISTINCT country_code, partner, burn_date, burn_order_id, incremental_gmv_lc, acquisition_flag,
(CASE WHEN LOWER(partner) LIKE '%roche%' OR LOWER(partner) LIKE '%nielsen%' THEN 'Redemption' ELSE 'Full' END) AS Model, 'Credit' AS campaign_name, 'Credit' AS campaign_id, 'Talabat Wallet Credit' AS code, basket_amount_lc, account_id,delivery_location_id
from filtered_details
)


-- VOUCHERS
,t1 as (
  select
    country_iso,
    vo.name,
    cv.voucher_option_id,
    upper(vc.code) as Voucher_Code,
    vo.discount_value,
    foi.order_id,
    cast(order_date as date) order_date, 
    vo.discount_type, 
    vo.deeplink, 
    vo.notes,
  basket_amount_lc, basket_amount_lc - foi.mod_change_gmv_amount_lc AS with_change_lc, foi.gmv_amount_lc,
  
  basket_amount_eur, basket_amount_eur - foi.mod_change_gmv_amount_eur AS with_change_eur, foi.gmv_amount_eur,

  (CASE WHEN vo.discount_type = 'DELIVERY_PERCENTAGE' THEN delivery_fee_amount_lc - (vo.discount_value*delivery_fee_amount_lc/100)
  ELSE delivery_fee_amount_lc END) AS delivery_fee_amount_lc,

  (CASE WHEN vo.discount_type = 'DELIVERY_PERCENTAGE' THEN delivery_fee_amount_eur - (vo.discount_value*delivery_fee_amount_eur/100)
  ELSE delivery_fee_amount_eur END) AS delivery_fee_amount_eur,
  
  service_fee_amount_lc, service_fee_amount_eur,
  
  loyality_discount_lc,loyality_discount_eur, foi.is_acquisition, foi.account_id, foi.delivery_location_id
FROM `tlb-data-prod.data_platform_loyalty.customer_vouchers` cv
left join `tlb-data-prod.data_platform_loyalty.voucher_codes` vc on cv.voucher_code_id=vc.id
left join `tlb-data-prod.data_platform_loyalty.voucher_options` vo on vc.voucher_option_id = vo.id
left join `tlb-data-prod.data_platform.fct_order_info` foi on cast(foi.order_id as string) = cv.external_reference_id AND foi.country_id = vo.country
LEFT JOIN `tlb-data-prod.data_platform.fct_repayment` AS fct_repayment ON fct_repayment.order_id = foi.order_id
WHERE
is_successful and (not(is_duplicated_order or is_test))
AND foi.order_date >>= '2022-01-01'
and cv.voucher_option_id in (
SELECT id FROM `tlb-data-prod.data_platform_loyalty.voucher_options`
WHERE ((LOWER(name) LIKE '%redemption%' OR LOWER(pos_reference_id) = 'redemption' OR LOWER(name) LIKE '%sales%' OR lower(pos_reference_id) = 'sales' OR LOWER(name) LIKE '%full%' OR lower(pos_reference_id) = 'full' ) AND name LIKE '%B2B%' AND 
NOT (
  name in (  'coop_eg_partnership_B2B_100%_CIB_220403-220503_gn_50%x30EGP_Redemption_0%discount_all_one_op'
,'coop_jo_partnership_B2B_100%_Uwallet_220318-220630_gn_50%x2JOD_Redemption_0%discount_all_one_op'
