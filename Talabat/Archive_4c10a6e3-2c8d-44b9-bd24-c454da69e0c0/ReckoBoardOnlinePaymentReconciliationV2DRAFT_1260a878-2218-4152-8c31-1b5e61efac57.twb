    <worksheet name='Successful Reconciled Amount'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Bold' fontsize='9'>Reconciled Amount</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='agg_daily_order_reconciliation' name='federated.0kdd63j0wjqfrt154yvbo00ve1u2' />
          </datasources>
          <datasource-dependencies datasource='federated.0kdd63j0wjqfrt154yvbo00ve1u2'>
            <column caption='Online / Offline' datatype='string' name='[Calculation_858780189372989471]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [reconciliation_source] =&apos;Cash&apos; then &apos;Offline&apos;&#10;elseif isnull([reconciliation_source]) then null&#10;else &apos;Online&apos;&#10;end' />
            </column>
            <column caption='Reconciled Amount' datatype='real' name='[Calculation_858780189719662628]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [is_reconciled] then [net_expected_amount_lc] end)' />
            </column>
            <column-instance column='[country_code]' derivation='Attribute' name='[attr:country_code:nk]' pivot='key' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Filtration Date' datatype='date' default-format='*DD-MMM-YYYY' name='[filtration_date]' role='dimension' type='ordinal' />
