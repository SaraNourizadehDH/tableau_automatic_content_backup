      <column caption='Last Day of Week' datatype='datetime' name='[Last Day of Month (copy)_858780190834511936]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;day&apos;,-1,DATEADD(&apos;week&apos;,1,DATETRUNC(&apos;week&apos;,[date])))' />
      </column>
      <column caption='Last Day of Quarter' datatype='datetime' name='[Last Day of Week (copy)_858780190834593857]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEADD(&apos;day&apos;,-1,DATEADD(&apos;quarter&apos;,1,DATETRUNC(&apos;quarter&apos;,[date])))' />
