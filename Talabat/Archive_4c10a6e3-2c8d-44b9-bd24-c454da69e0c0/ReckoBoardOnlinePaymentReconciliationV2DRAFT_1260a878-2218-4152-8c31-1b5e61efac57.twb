    <datasource caption='Sales KPI Analysis Dataset' inline='true' name='federated.1da1ext05pbryr0zsvgvx0li7i50' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1b6ot6s1dz6vw11905kf61evjcoy'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='manjunath.lonikar@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1b6ot6s1dz6vw11905kf61evjcoy' name='Custom SQL Query' type='text'><![CDATA[with agg_reco_dm as
(select 
  country_code
  ,filtration_date
  ,case when trim(lower(reconciliation_source)) = 'cash' then false else true end as is_online
  -- ,reconciliation_source
  ,(sum(net_expected_amount_lc)
    -sum(rider_tip_checkout_amount_lc)
    +sum(voucher_discount_amount_lc)
    ) as successful_gmv_amount_lc

  ,sum(tgo_modification_gmv_added_amount_lc) as successful_tgo_gmv_amount_lc
  ,sum(tmp_modification_gmv_added_amount_lc) as successful_tmp_gmv_amount_lc

from `tlb-data-prod.data_platform.agg_daily_order_reconciliation`
where 
  filtration_date >>= '2022-01-01'
  and trim(lower(order_status)) = 'successful'
  and is_reconciled

group by 1,2,3--,4
)


,agg_order_data as
(select
  t1.country_code
  ,t1.order_date
  ,case when trim(lower(t2.payment_method)) = 'cash' then false else true end as is_online
  ,count(t1.order_id) as fct_order_successful_order_count
  ,count(case when t1.delivery_arrangement = 'TGO' then t1.order_id end) as fct_order_successful_tgo_order_count
  ,count(case when t1.delivery_arrangement = 'TMP' then t1.order_id end) as fct_order_successful_tmp_order_count
  ,sum(t1.gmv_amount_lc) as fct_order_successful_gmv_amount_lc
  ,sum(case when t1.delivery_arrangement = 'TGO' then t1.gmv_amount_lc end) fct_order_successful_tgo_gmv_amount_lc
  ,sum(case when t1.delivery_arrangement <<>> 'TGO' then t1.gmv_amount_lc end) fct_order_successful_tmp_gmv_amount_lc
  ,sum(t1.basket_amount_lc) as fct_order_successful_basket_amount_lc
  ,sum(t1.delivery_fee_amount_lc) as fct_order_successful_delivery_fee_amount_lc
  ,sum(t1.service_fee_amount_lc) as fct_order_successful_service_fee_amount_lc
  ,sum(t3.vendor_paid_incentive_amount_lc) as billing_vendor_paid_incentive_amount_lc
  ,sum(t3.talabat_paid_incentive_amount_lc) as billing_talabat_paid_incentive_amount_lc

from `tlb-data-prod.data_platform.fct_order_info` t1
left join `tlb-data-prod.data_platform.dim_payment_method` t2
  on t1.payment_method_id = t2.payment_method_id

left join `tlb-data-prod.data_platform.fct_billing` t3
  on t1.order_id = t3.order_id
  and t3.billing_date >>= '2022-01-01'

where 
  t1.order_date >>='2022-01-01'
  and t1.is_successful

group by 1,2,3

)


----,data as
(select 

  t1.country_code
  ,t1.filtration_date as date
  ,t1.is_online
  ,t1.successful_gmv_amount_lc
  ,t1.successful_tgo_gmv_amount_lc
  ,t1.successful_tmp_gmv_amount_lc
  ,t2.fct_order_successful_order_count
  ,t2.fct_order_successful_tgo_order_count
  ,t2.fct_order_successful_tmp_order_count
  ,t2.fct_order_successful_gmv_amount_lc
  ,t2.fct_order_successful_tgo_gmv_amount_lc
  ,t2.fct_order_successful_tmp_gmv_amount_lc
  ,t2.fct_order_successful_basket_amount_lc
  ,t2.fct_order_successful_delivery_fee_amount_lc
  ,t2.fct_order_successful_service_fee_amount_lc
  ,t2.billing_vendor_paid_incentive_amount_lc
  ,t2.billing_talabat_paid_incentive_amount_lc

from agg_reco_dm t1
left join agg_order_data t2
  on t1.country_code = t2.country_code
  and t1.filtration_date = t2.order_date
  and t1.is_online = t2.is_online
)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1b6ot6s1dz6vw11905kf61evjcoy' name='Custom SQL Query' type='text'><![CDATA[with agg_reco_dm as
(select 
  country_code
  ,filtration_date
  ,case when trim(lower(reconciliation_source)) = 'cash' then false else true end as is_online
  -- ,reconciliation_source
  ,(sum(net_expected_amount_lc)
    -sum(rider_tip_checkout_amount_lc)
    +sum(voucher_discount_amount_lc)
    ) as successful_gmv_amount_lc

  ,sum(tgo_modification_gmv_added_amount_lc) as successful_tgo_gmv_amount_lc
  ,sum(tmp_modification_gmv_added_amount_lc) as successful_tmp_gmv_amount_lc

from `tlb-data-prod.data_platform.agg_daily_order_reconciliation`
where 
  filtration_date >>= '2022-01-01'
  and trim(lower(order_status)) = 'successful'
  and is_reconciled

group by 1,2,3--,4
)


,agg_order_data as
(select
  t1.country_code
  ,t1.order_date
  ,case when trim(lower(t2.payment_method)) = 'cash' then false else true end as is_online
  ,count(t1.order_id) as fct_order_successful_order_count
  ,count(case when t1.delivery_arrangement = 'TGO' then t1.order_id end) as fct_order_successful_tgo_order_count
  ,count(case when t1.delivery_arrangement = 'TMP' then t1.order_id end) as fct_order_successful_tmp_order_count
  ,sum(t1.gmv_amount_lc) as fct_order_successful_gmv_amount_lc
  ,sum(case when t1.delivery_arrangement = 'TGO' then t1.gmv_amount_lc end) fct_order_successful_tgo_gmv_amount_lc
  ,sum(case when t1.delivery_arrangement <<>> 'TGO' then t1.gmv_amount_lc end) fct_order_successful_tmp_gmv_amount_lc
  ,sum(t1.basket_amount_lc) as fct_order_successful_basket_amount_lc
  ,sum(t1.delivery_fee_amount_lc) as fct_order_successful_delivery_fee_amount_lc
  ,sum(t1.service_fee_amount_lc) as fct_order_successful_service_fee_amount_lc
  ,sum(t3.vendor_paid_incentive_amount_lc) as billing_vendor_paid_incentive_amount_lc
  ,sum(t3.talabat_paid_incentive_amount_lc) as billing_talabat_paid_incentive_amount_lc

from `tlb-data-prod.data_platform.fct_order_info` t1
left join `tlb-data-prod.data_platform.dim_payment_method` t2
  on t1.payment_method_id = t2.payment_method_id

left join `tlb-data-prod.data_platform.fct_billing` t3
  on t1.order_id = t3.order_id
  and t3.billing_date >>= '2022-01-01'

where 
  t1.order_date >>='2022-01-01'
  and t1.is_successful

group by 1,2,3

)


----,data as
(select 

  t1.country_code
  ,t1.filtration_date as date
  ,t1.is_online
  ,t1.successful_gmv_amount_lc
  ,t1.successful_tgo_gmv_amount_lc
  ,t1.successful_tmp_gmv_amount_lc
  ,t2.fct_order_successful_order_count
  ,t2.fct_order_successful_tgo_order_count
  ,t2.fct_order_successful_tmp_order_count
  ,t2.fct_order_successful_gmv_amount_lc
  ,t2.fct_order_successful_tgo_gmv_amount_lc
  ,t2.fct_order_successful_tmp_gmv_amount_lc
  ,t2.fct_order_successful_basket_amount_lc
  ,t2.fct_order_successful_delivery_fee_amount_lc
  ,t2.fct_order_successful_service_fee_amount_lc
  ,t2.billing_vendor_paid_incentive_amount_lc
  ,t2.billing_talabat_paid_incentive_amount_lc

from agg_reco_dm t1
left join agg_order_data t2
  on t1.country_code = t2.country_code
  and t1.filtration_date = t2.order_date
  and t1.is_online = t2.is_online
)]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
