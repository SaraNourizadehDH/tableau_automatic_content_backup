    <worksheet name='Sales KPIs Trends'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='16'>Æ </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales KPI Analysis Dataset' name='federated.1da1ext05pbryr0zsvgvx0li7i50' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Date Granularity' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Day&quot;'>
              <calculation class='tableau' formula='&quot;Day&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1da1ext05pbryr0zsvgvx0li7i50'>
            <column caption='Avg Basket Value' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AOV (copy)_858780191223255129]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Successful GMV (LC) (copy)_858780190828580918] / [Calculation_858780190827229230]' />
            </column>
            <column caption='Reporting Date' datatype='date' default-format='*DD-MMM-YYYY' name='[Calculation_858780190826725421]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 1]&#10;when &apos;Day&apos; then [Day]&#10;when &apos;Week&apos; then [Week]&#10;when &apos;Month&apos; then [Month]&#10;when &apos;Quarter&apos; then [Quarter]&#10;end' />
            </column>
            <column caption='Successful Orders' datatype='integer' name='[Calculation_858780190827229230]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fct_order_successful_order_count])' />
            </column>
            <column caption='TGO GMV %' datatype='real' default-format='p0.00%' name='[Calculation_858780190830518331]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Successful TGO Orders (copy)_858780190827978802]/[Successful Orders (copy)_858780190827978801]' />
            </column>
            <column caption='Base for Daily Avg' datatype='integer' name='[Calculation_858780190831804478]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Max(IF [Parameters].[Parameter 1] = &apos;Day&apos; then 1&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; then &#10;    (if datetrunc(&apos;week&apos;,[date],&apos;Sunday&apos;) &lt; [Calculation_858780190865166402] then 7 &#10;     elseif datetrunc(&apos;week&apos;,[date],&apos;Sunday&apos;) = [Calculation_858780190865166402] then [Weekday Number (copy)_858780190868754502] end)&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos; then &#10;    (if datetrunc(&apos;month&apos;,[date]) &lt; [Max Available Week (copy)_858780190866051139] then day([Calculation_858780190834466879])&#10;     elseif datetrunc(&apos;month&apos;,[date]) = [Max Available Week (copy)_858780190866051139] then day({max([date])})end)&#10;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Quarter&apos; then &#10;    (if datetrunc(&apos;quarter&apos;,[date]) &lt; [Max Available Month (copy)_858780190866128964] then datediff(&apos;day&apos;,datetrunc(&apos;quarter&apos;,[date]),[Last Day of Week (copy)_858780190834593857])+1&#10;     elseif datetrunc(&apos;quarter&apos;,[date]) = [Max Available Month (copy)_858780190866128964] then (DATEDIFF(&apos;day&apos;,datetrunc(&apos;quarter&apos;,[date]),date({max([date])})))+1&#10;&#10;end)&#10;&#10;END)' />
            </column>
            <column caption='Last Day of Month' datatype='datetime' name='[Calculation_858780190834466879]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,DATETRUNC(&apos;month&apos;,[date])))' />
            </column>
            <column caption='Max Available Week' datatype='datetime' name='[Calculation_858780190865166402]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;,{max(date)},&apos;Sunday&apos;)' />
            </column>
            <column caption='Daily Avg Orders' datatype='real' name='[Calculation_858780190874058823]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_858780190827229230] / ([Calculation_858780190831804478])' />
            </column>
            <column caption='Sales KPI Trend Blank Label' datatype='string' name='[Calculation_858780191156318289]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot; &quot;' />
            </column>
            <column caption='Avg Order Value (AOV)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_858780191223169112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Successful Orders (copy)_858780190827978801] / [Calculation_858780190827229230]' />
            </column>
            <column caption='Daily Avg GMV' datatype='real' name='[Daily Avg Orders (copy)_858780190874148936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Successful Orders (copy)_858780190827978801] / ([Calculation_858780190831804478])' />
            </column>
            <column datatype='date' name='[Day]' role='dimension' type='quantitative' user:agg-type='Day-Trunc' user:base-field='date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;day&apos;, [date]))' />
            </column>
            <column caption='Service Fee (LC) [VAT inclusive]' datatype='real' name='[Delivery Fee (LC) [VAT inclusive]] (copy)_858780190828478517]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fct_order_successful_service_fee_amount_lc])' />
            </column>
            <column caption='Last Day of Quarter' datatype='datetime' name='[Last Day of Week (copy)_858780190834593857]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEADD(&apos;day&apos;,-1,DATEADD(&apos;quarter&apos;,1,DATETRUNC(&apos;quarter&apos;,[date])))' />
            </column>
            <column caption='Max Available Quarter' datatype='datetime' name='[Max Available Month (copy)_858780190866128964]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;quarter&apos;,{max(date)})' />
            </column>
            <column caption='Max Available Month' datatype='datetime' name='[Max Available Week (copy)_858780190866051139]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,{max(date)})' />
            </column>
            <column datatype='date' name='[Month]' role='dimension' type='quantitative' user:agg-type='Month-Trunc' user:base-field='date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [date]))' />
            </column>
            <column datatype='date' name='[Quarter]' role='dimension' type='quantitative' user:agg-type='Quarter-Trunc' user:base-field='date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;quarter&apos;, [date]))' />
            </column>
            <column caption='Successful Basket Amount (LC)' datatype='real' name='[Successful GMV (LC) (copy)_858780190828580918]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fct_order_successful_basket_amount_lc])' />
            </column>
            <column caption='Vendor Paid Incentive Amount (LC)' datatype='real' name='[Successful GMV (LC) (copy)_858780190828728375]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([billing_vendor_paid_incentive_amount_lc])' />
            </column>
            <column caption='Successful TGO Orders' datatype='integer' name='[Successful Orders (copy)_858780190827274287]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fct_order_successful_tgo_order_count])' />
            </column>
            <column caption='Successful GMV (LC)' datatype='real' name='[Successful Orders (copy)_858780190827978801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fct_order_successful_gmv_amount_lc])' />
            </column>
            <column caption='Delivery Fee (LC) [VAT inclusive]' datatype='real' name='[Successful Orders (copy)_858780190828183604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fct_order_successful_delivery_fee_amount_lc])' />
            </column>
            <column caption='Successful TMP Orders' datatype='integer' name='[Successful TGO Orders (copy)_858780190827905072]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fct_order_successful_tmp_order_count])' />
            </column>
            <column caption='Successful TGO GMV (LC)' datatype='real' name='[Successful TGO Orders (copy)_858780190827978802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fct_order_successful_tgo_gmv_amount_lc])' />
            </column>
            <column caption='Successful TMP GMV (LC)' datatype='real' name='[Successful TMP Orders (copy)_858780190827978803]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([fct_order_successful_tmp_gmv_amount_lc])' />
            </column>
            <column caption='TMP GMV %' datatype='real' default-format='p0.00%' name='[TGO GMV % (copy)_858780190830612540]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Successful TMP Orders (copy)_858780190827978803]/[Successful Orders (copy)_858780190827978801]' />
            </column>
            <column caption='Talabat Paid Incentive Amount (LC)' datatype='real' name='[Vendor Paid Incentive Amount (LC) (copy)_858780190828826680]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([billing_talabat_paid_incentive_amount_lc])' />
            </column>
            <column datatype='date' name='[Week]' role='dimension' type='quantitative' user:agg-type='Week-Trunc' user:base-field='date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [date]))' />
