      <column caption='Net Discrepancy Excluding Capture Fail' datatype='real' name='[Calculation_1236941826991706112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([net_discrepancy_excluding_capture_fail_amount_lc]))' />
      </column>
      <column caption='Backend Transaction Count (Transactions using PSP only)' datatype='integer' name='[Calculation_4341258961626509312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF not [reconciliation_source]  in (&apos;talabat Pay&apos;, &apos;Cash&apos;, &apos;BNPL&apos;) THEN [backend_transactions_count] else 0 END' />
      </column>
      <column caption='Net Discrepancy - Over Collection' datatype='real' name='[Calculation_4587056998090428417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([net_discrepancy_over_collection_amount_lc]))' />
      </column>
      <column caption='Final Sales Amount LC' datatype='real' name='[Calculation_47639665343782912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[original_gmv_amount_lc]&#10;+[tgo_modification_gmv_added_amount_lc]&#10;+[tmp_modification_gmv_added_amount_lc]&#10;+[modification_gmv_removed_amount_lc]' />
      </column>
      <column caption='Net Discrepancy ' datatype='real' name='[Calculation_5679179908031864834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([net_discrepancy]))' />
      </column>
      <column caption='Net Discrepancy Rounded' datatype='real' name='[Calculation_6169861138480865280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [is_reconciled] then 0 else  [net_discrepancy] end' />
      </column>
      <column caption='Report Date' datatype='date' default-format='*DD-MMM-YYYY' name='[Calculation_858780189023506435]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &apos;Day&apos; then [Day]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Week&apos; then [Day (copy)_858780189023318016]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Month&apos; then [Week (copy)_858780189023395841]&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Quarter&apos; then [Month (copy)_858780189023440898]&#10;END' />
      </column>
      <column caption='Year&gt;2022  Filter' datatype='boolean' name='[Calculation_858780189023973380]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&quot;year&quot;,[filtration_date]) &gt;= date(&apos;2022-01-01&apos;)' />
      </column>
      <column caption='Country - Exclude' datatype='boolean' name='[Calculation_858780189025374213]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[country_code] &lt;&gt; &apos;20&apos;&#10;or [country_code] &lt;&gt; &apos;971&apos;' />
      </column>
      <column caption='Net Sales' datatype='real' name='[Calculation_858780189056888849]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[net_expected_amount_lc]&#10;-[rider_tip_checkout_amount_lc]&#10;+[voucher_discount_amount_lc]' />
      </column>
      <column caption='Total Credit Card Amount' datatype='real' name='[Calculation_858780189057646610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[paid_by_cc_fee_amount_lc]&#10;+[paid_by_knet_fee_amount_lc]' />
      </column>
      <column caption='Wallet Refund Amount' datatype='real' name='[Calculation_858780189068632084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([refund_bucket_amount]&#10;+&#10;[reversed_amount])&#10;*(-1)' />
      </column>
      <column caption='Measure' datatype='real' name='[Calculation_858780189072543765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 2] &#10;when &apos;Count Backend Transactions&apos; then [backend_transactions_count]&#10;when &apos;PSP Transactions Count&apos; then [upm_transactions_count]&#10;when &apos;Total Original GMV Amount LC&apos; then [original_gmv_amount_lc]&#10;when &apos;TGO Added Modification GMV Amount LC&apos; then [tgo_modification_gmv_added_amount_lc]&#10;when &apos;TMP Added Modification GMV Amount LC&apos; then [tmp_modification_gmv_added_amount_lc]&#10;when &apos;Modification GMV Removed Amount LC&apos; then [modification_gmv_removed_amount_lc]&#10;when &apos;Final Sales Amount LC&apos; then [Calculation_47639665343782912]&#10;when &apos;Voucher Discount Amount LC&apos; then [Calculation_858780189779578919]&#10;&#10;when &apos;Net Sales&apos; then [Calculation_858780189056888849]&#10;when &apos;Rider Tip Checkout Amount LC&apos; then [rider_tip_checkout_amount_lc]&#10;when &apos;Net Expected Amount LC&apos; then [net_expected_amount_lc]&#10;when &apos;Net Collected Amount LC&apos; then [net_collected_amount_lc]&#10;when &apos;Total Credit Card Amount&apos; then [Calculation_858780189057646610]&#10;when &apos;Paid By Talabat Fee Amount Lc&apos; then [paid_by_talabat_fee_amount_lc]&#10;when &apos;Paid By Cash Fee Amount Lc&apos; then [paid_by_cash_fee_amount_lc]&#10;when &apos;Psp Authorisation Approved Amount LC&apos; then [psp_authorisation_approved_amount_lc]&#10;when &apos;Psp Capture Amount LC&apos; then [psp_capture_amount_lc]&#10;when &apos;Psp Refund Amount LC&apos; then [Calculation_858780189780643882]&#10;when &apos;Psp Void Authorisation Amount LC&apos; then [psp_void_authorisation_amount_lc]&#10;when &apos;Wallet Captured TCredit Amount LC&apos; then [wallet_captured_tcredit_amount_lc]&#10;when &apos;Total Wallet Refund Amount&apos; then [Calculation_858780189068632084]&#10;when &apos;Net Discrepancy&apos; then [net_discrepancy]&#10;&#10;when &apos;None&apos; then null&#10;&#10;END' />
      </column>
      <column caption='Measure TY' datatype='real' name='[Calculation_858780189077041174]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF &#10;DATETRUNC(&apos;year&apos;,[filtration_date]) = DATETRUNC(&apos;year&apos;,today()-1)&#10;&#10;then [Calculation_858780189072543765]&#10;end)' />
      </column>
      <column aggregation='Sum' caption='Report Date Metrics' datatype='integer' name='[Calculation_858780189079588888]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Day&apos; then [Week Number]&#10;elseif [Parameters].[Parameter 1] = &apos;Week&apos; then [Week Number]&#10;elseif [Parameters].[Parameter 1] = &apos;Month&apos; then [Month Name]&#10;elseif [Parameters].[Parameter 1] = &apos;Quarter&apos; then [Quarter Name]&#10;END' />
      </column>
      <column caption='Calendar Month' datatype='string' name='[Calculation_858780189083590682]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 1] = &apos;Month&apos; then datename(&apos;month&apos;,[filtration_date]) else &quot; &quot; end' />
      </column>
      <column caption='Label - Blank' datatype='string' name='[Calculation_858780189356695581]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot; &quot;' />
      </column>
      <column caption='Trend Label' datatype='string' name='[Calculation_858780189363384350]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2]' />
      </column>
      <column caption='Online / Offline' datatype='string' name='[Calculation_858780189372989471]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [reconciliation_source] =&apos;Cash&apos; then &apos;Offline&apos;&#10;elseif isnull([reconciliation_source]) then null&#10;else &apos;Online&apos;&#10;end' />
      </column>
      <column caption='Last 12 months Filter' datatype='boolean' name='[Calculation_858780189401800736]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Week (copy)_858780189023395841]&gt;= DATEADD(&apos;month&apos;,-11,DATETRUNC(&apos;month&apos;,today()-1))' />
      </column>
      <column caption='Added Modification GMV Amount LC' datatype='real' name='[Calculation_858780189403717665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[tgo_modification_gmv_added_amount_lc]+[tmp_modification_gmv_added_amount_lc]' />
      </column>
      <column caption='Cnt' datatype='integer' name='[Calculation_858780189404405795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Count(1)' />
      </column>
      <column caption='Reconciled Amount' datatype='real' name='[Calculation_858780189719662628]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [is_reconciled] then [net_expected_amount_lc] end)' />
      </column>
      <column caption='Health Score' datatype='real' default-format='p0.00%' name='[Calculation_858780189769486374]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-&#10;(sum([net_discrepancy])/sum([net_expected_amount_lc]))' />
      </column>
      <column caption='Voucher Discount Amount LC' datatype='real' name='[Calculation_858780189779578919]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[voucher_discount_amount_lc] * (-1)' />
      </column>
      <column caption='Psp Refund Amount LC' datatype='real' name='[Calculation_858780189780643882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[psp_refund_amount_lc] * (-1)' />
      </column>
      <column caption='D-W-M-Q Label' datatype='string' name='[Calculation_858780189795549227]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='Case [Parameters].[Parameter 1]&#10;when &apos;Day&apos; then &apos;DoD&apos;&#10;when &apos;Week&apos; then &apos;WoW&apos;&#10;when &apos;Month&apos; then &apos;MoM&apos;&#10;when &apos;Quarter&apos; then &apos;QoQ&apos;&#10;else &apos; &apos;&#10;END' />
      </column>
      <column caption='Size' datatype='integer' name='[Calculation_858780189797613612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Week' datatype='date' name='[Day (copy)_858780189023318016]' role='dimension' type='quantitative' user:agg-type='Week-Trunc' user:base-field='filtration_date' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;week&apos;, [filtration_date]))' scope-isolation='false' />
      </column>
      <column aggregation='Sum' datatype='integer' name='[Day Number]' role='dimension' type='ordinal' user:agg-type='Day' user:base-field='filtration_date' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='DATEPART(&apos;day&apos;, [filtration_date])' />
      </column>
      <column datatype='date' default-format='*dd-mmm-yy' name='[Day]' role='dimension' type='quantitative' user:agg-type='None' user:base-field='filtration_date' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='[filtration_date]' />
      </column>
      <column caption='% Net Discrepancy' datatype='real' default-format='p0.00%' name='[Health Score (copy)_4587056998083010560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='zn(sum([net_discrepancy])/sum([net_expected_amount_lc]))' />
      </column>
      <column caption='Label - Blank (copy)' datatype='string' name='[Label - Blank (copy)_858780189404282914]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot; &quot;' />
      </column>
      <column caption='Measure LY' datatype='real' name='[Measure TY (copy)_858780189077106711]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF &#10;DATETRUNC(&apos;year&apos;,[filtration_date]) = dateadd(&apos;year&apos;,-1, DATETRUNC(&apos;year&apos;,today()-1))&#10;&#10;then [Calculation_858780189072543765]&#10;end)' />
      </column>
      <column caption='Quarter' datatype='date' name='[Month (copy)_858780189023440898]' role='dimension' type='quantitative' user:agg-type='Quarter-Trunc' user:base-field='filtration_date' user:ui-builder='date-bin-builder'>
