      <column caption='Daily Avg GMV' datatype='real' name='[Daily Avg Orders (copy)_858780190874148936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Successful Orders (copy)_858780190827978801] / ([Calculation_858780190831804478])' />
      </column>
      <column caption='Daily Avg Orders per Month' datatype='real' name='[Daily Avg Orders (copy)_858780191225000027]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_858780190827229230] / max((if datetrunc(&apos;month&apos;,[date]) &lt; [Max Available Week (copy)_858780190866051139] then day([Calculation_858780190834466879])&#10;     elseif datetrunc(&apos;month&apos;,[date]) = [Max Available Week (copy)_858780190866051139] then day({max([date])})end))' />
      </column>
      <column caption='Daily Avg Orders - Main KPI' datatype='real' name='[Daily Avg Orders (copy)_858780191226101852]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_858780190827229230] /&#10; (if [Parameters].[Parameter 1] = &apos;Day&apos; then max({COUNTD([date])}) &#10;&#10;elseif [Parameters].[Parameter 1] = &apos;Week&apos; then max({COUNTD(DATETRUNC(&apos;week&apos;,[date]))})  &#10;elseif [Parameters].[Parameter 1] = &apos;Month&apos; then max({COUNTD(DATETRUNC(&apos;month&apos;,[date]))})  &#10;elseif [Parameters].[Parameter 1] = &apos;Quarter&apos; then max({COUNTD(DATETRUNC(&apos;quarter&apos;,[date]))})  &#10;end)' />
      </column>
