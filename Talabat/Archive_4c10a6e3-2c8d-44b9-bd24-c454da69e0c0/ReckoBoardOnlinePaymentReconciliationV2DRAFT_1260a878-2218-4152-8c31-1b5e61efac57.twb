      <column caption='Measure I Graph Label' datatype='string' name='[Calculation_858780191166570578]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
      </column>
      <column caption='12 Months Filter' datatype='boolean' name='[Calculation_858780191218016342]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Month]&gt;= DATEADD(&apos;month&apos;,-11,DATETRUNC(&apos;month&apos;,today()-1))' />
      </column>
      <column caption='Size - Trend Charts' datatype='integer' name='[Calculation_858780191218077783]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
