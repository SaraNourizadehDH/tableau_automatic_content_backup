            <column caption='Month' datatype='date' default-format='*MMM-YY' name='[Week (copy)_858780189023395841]' role='dimension' type='quantitative' user:agg-type='Month-Trunc' user:base-field='filtration_date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [filtration_date]))' scope-isolation='false' />
