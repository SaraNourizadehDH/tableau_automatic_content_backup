          <named-connection caption='BigQuery' name='bigquery.0ui1jph10l2v7919k4jke05xiuld'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='hari.vellamelli@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0ui1jph10l2v7919k4jke05xiuld' name='Custom SQL Query' type='text'><![CDATA[WITH mall_flag AS 
(
SELECT DISTINCT 
       v2.vendor_id,
       CAST(ST_DISTANCE(
            ST_GEOGPOINT(v1.long, v1.lat), 
            ST_GEOGPOINT(v2.location.longitude, v2.location.latitude)) as int64) AS distance_meter
 FROM `gfs-tech.gfs_bi.talabat_shopping_malls` v1

 CROSS JOIN 
 `fulfillment-dwh-production.curated_data_shared_central_dwh.vendors` v2 
 WHERE v1.entity=v2.global_entity_id
)
SELECT 
DISTINCT
dwhv.global_entity_id,
dwhv.vendor_id as vendor_id_dwh,
v.vendor_id as vendor_id_vt,
dwhv.vendor_name as vendor_name_dwh,
v.vendor_name as vendor_name_vt,
CASE WHEN mf.distance_meter<<=150 THEN TRUE ELSE FALSE END AS shopping_mall,
dwhv.chain_id,
dwhv.chain_name,
dwhv.location.city,
dwhv.location.street,
dwhv.location.area,
dwhv.location.latitude,
dwhv.location.longitude,
v.vendor_address,
sfa.legal_name__c,
formatted_billing_address__c,
formatted_restaurant_address__c,
formatted_shipping_address__c,
FROM `fulfillment-dwh-production.curated_data_shared_central_dwh.vendors` dwhv
INNER JOIN `tlb-data-prod.data_platform.dim_vendor_info` v on CAST(v.vendor_id AS STRING) = dwhv.vendor_id
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` sfa on sfa.grid__c = v.salesforce_id
LEFT JOIN mall_flag mf ON mf.vendor_id=dwhv.vendor_id
WHERE dwhv.global_entity_id IN('TB_AE','TB_KW','TB_BH','TB_QA')
AND v.is_active
AND dwhv.vertical_parent = 'Food']]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0ui1jph10l2v7919k4jke05xiuld' name='Custom SQL Query' type='text'><![CDATA[WITH mall_flag AS 
