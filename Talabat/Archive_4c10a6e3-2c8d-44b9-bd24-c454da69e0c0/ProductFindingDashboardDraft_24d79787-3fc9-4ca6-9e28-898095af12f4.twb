    <datasource caption='Organic List' inline='true' name='federated.0rssqde1ld50z715eww7s1hkmc2j' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0gg9lpr0wgasvv1dok1ih0dpcc0o'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server='' server-oauth='server-custom' username='antariksh.mishra@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0gg9lpr0wgasvv1dok1ih0dpcc0o' name='Custom SQL Query' type='text'>with organic_list as (
  SELECT
    date,
    (case when user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;) then &quot;UAE&quot; else user_selected_country end) as country,
    chain_name,
    count(distinct case when clicked_vendor_id is not null and  found_via_feature=&quot;organic_list&quot; then session_id end) as clicked_sessions,
    count(distinct case when added_to_cart and  found_via_feature=&quot;organic_list&quot; then session_id end) as add_cart_sessions,
    count(distinct case when placed_order   and found_via_feature=&quot;organic_list&quot; then session_id end) as placed_order_sessions
  FROM
  `tlb-data-prod.data_platform.fct_sub_session_vendor_list` a 
  left join `tlb-data-prod.data_platform.dim_vendor_info` b on safe_cast(a.clicked_vendor_id as int64)=b.vendor_id
  left join `tlb-data-prod.data_platform.dim_chain` c on b.chain_id=c.chain_id
  WHERE date between &quot;2024-07-01&quot; and current_date()-1
  and a.vertical=&quot;grocery&quot;
  AND user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;,&apos;Kuwait&apos;,&apos;Bahrain&apos;,&apos;Egypt&apos;,&apos;Iraq&apos;,&apos;Jordan&apos;,&apos;KSA&apos;,&apos;Oman&apos;,&apos;Qatar&apos;,&apos;Saudi Arabia&apos;)
GROUP BY ALL),

ghome_sessions as (
  SELECT
    date,
    (case when user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;) then &quot;UAE&quot; else user_selected_country end) as country,
    count(distinct session_id) as viewed_sessions
  FROM `tlb-data-prod.data_platform.fct_sub_session_vendor_list`
  WHERE date between &quot;2024-07-01&quot; and current_date()-1
  and user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;,&apos;Kuwait&apos;,&apos;Bahrain&apos;,&apos;Egypt&apos;,&apos;Iraq&apos;,&apos;Jordan&apos;,&apos;KSA&apos;,&apos;Oman&apos;,&apos;Qatar&apos;,&apos;Saudi Arabia&apos;)
  and vertical=&quot;grocery&quot;
  group by 1,2
  )

SELECT
  o.date,
  o.country,
  o.chain_name,
  sum(viewed_sessions) as viewed_sessions,
  sum(clicked_sessions) as clicked_sessions,
  sum(add_cart_sessions) as add_cart_sessions,
  sum(placed_order_sessions) as placed_order_sessions
from
organic_list o
left join 
ghome_sessions g
on o.date=g.date
and o.country=g.country
group by 1,2,3</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0gg9lpr0wgasvv1dok1ih0dpcc0o' name='Custom SQL Query' type='text'>with organic_list as (
  SELECT
