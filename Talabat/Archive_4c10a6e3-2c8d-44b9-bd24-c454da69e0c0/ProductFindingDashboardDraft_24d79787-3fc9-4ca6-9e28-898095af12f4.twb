      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_7EF5C0BD28034408B7D1591D3E35B66E'>
            <properties context=''>
              <relation connection='bigquery.0csrllj12mgyt614lq3bt1bk5dt6' name='Custom SQL Query' type='text'>with qc_widget as (
  SELECT
    date,
    (case when user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;) then &quot;UAE&quot; else user_selected_country end) as country,
    chain_name,
    count(distinct case when a.vendor_id is not null and found_via_feature=&quot;qc_widget&quot; then session_id end) as clicked_sessions,
    count(distinct case when added_to_cart and found_via_feature=&quot;qc_widget&quot; then session_id end) as add_cart_sessions,
    count(distinct case when placed_order  and found_via_feature=&quot;qc_widget&quot; then session_id end) as placed_order_sessions
  FROM `tlb-data-prod.data_platform.fct_sub_session_homepage` a 
  left join `tlb-data-prod.data_platform.dim_vendor_info` b 
  on safe_cast(a.vendor_id as int64)=b.vendor_id
  left join `tlb-data-prod.data_platform.dim_chain` c on b.chain_id=c.chain_id
  WHERE date between &quot;2024-07-01&quot; and current_date()-1
  AND user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;,&apos;Kuwait&apos;,&apos;Bahrain&apos;,&apos;Egypt&apos;,&apos;Iraq&apos;,&apos;Jordan&apos;,&apos;KSA&apos;,&apos;Oman&apos;,&apos;Qatar&apos;,&apos;Saudi Arabia&apos;)
  GROUP BY ALL
  having clicked_sessions&gt;&gt;0)
  
, thome_sessions as (
  SELECT
    date,
    (case when user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;) then &quot;UAE&quot; else user_selected_country end) as country,
    count(distinct session_id) as viewed_sessions
  FROM
  `tlb-data-prod.data_platform.fct_sub_session_homepage`
  WHERE date between &quot;2024-07-01&quot; and current_date()-1
  AND user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;,&apos;Kuwait&apos;,&apos;Bahrain&apos;,&apos;Egypt&apos;,&apos;Iraq&apos;,&apos;Jordan&apos;,&apos;KSA&apos;,&apos;Oman&apos;,&apos;Qatar&apos;,&apos;Saudi Arabia&apos;)
  GROUP BY ALL
)
SELECT
  q.date,
  q.country,
  chain_name,
  sum(viewed_sessions) as viewed_sessions,
  sum(clicked_sessions) as clicked_sessions,
  sum(add_cart_sessions) as add_cart_sessions,
  sum(placed_order_sessions) as placed_order_sessions
from
qc_widget q
left join thome_sessions g
on q.date=g.date
and q.country=g.country
GROUP BY ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Banner performance' inline='true' name='federated.13w35r012ri7bg17djsgq0pt25wp' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0208jmh0qv2y8318ri9dn1o32jhm'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server='' server-oauth='server-custom' username='antariksh.mishra@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0208jmh0qv2y8318ri9dn1o32jhm' name='Banner performance' type='text'>SELECT
  date,
  (case when user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;) then &quot;UAE&quot; else user_selected_country end) as country,
  banner_position,
  banner_detail AS banner_name,
  COUNT(DISTINCT CASE WHEN is_banner_loaded THEN session_id END) as viewed_sessions,
  COUNT(DISTINCT CASE WHEN is_banner_clicked THEN session_id END) AS clicked_sessions,
  COUNT(DISTINCT CASE WHEN added_to_cart THEN session_id END) AS add_cart_sessions,
  COUNT(DISTINCT CASE WHEN placed_order THEN session_id END) AS placed_order_sessions
FROM
  `tlb-data-prod.data_platform.fct_sub_session_banner`
WHERE
  banner_category=&apos;hero_banner&apos;
  AND user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;,&apos;Kuwait&apos;,&apos;Bahrain&apos;,&apos;Egypt&apos;,&apos;Iraq&apos;,&apos;Jordan&apos;,&apos;KSA&apos;,&apos;Oman&apos;,&apos;Qatar&apos;,&apos;Saudi Arabia&apos;)
  AND date between &quot;2024-07-01&quot; and current_date()-1
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0208jmh0qv2y8318ri9dn1o32jhm' name='Banner performance' type='text'>SELECT
