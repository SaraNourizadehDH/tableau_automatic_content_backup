      <aliases enabled='yes' />
      <column caption='CTR %' datatype='real' default-format='p0.00%' name='[Calculation_2506253254959194112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([shop_click_sessions])/SUM([viewed_menu_sessions])' />
      </column>
      <column caption='Add to Cart Rate %' datatype='real' default-format='p0.00%' name='[Calculation_2506253254959300609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([add_cart_sessions])/SUM([viewed_menu_sessions])' />
      </column>
      <column caption='CVR %' datatype='real' default-format='p0.00%' name='[Calculation_2506253254959460354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([placed_order_sessions])/SUM([viewed_menu_sessions])' />
      </column>
