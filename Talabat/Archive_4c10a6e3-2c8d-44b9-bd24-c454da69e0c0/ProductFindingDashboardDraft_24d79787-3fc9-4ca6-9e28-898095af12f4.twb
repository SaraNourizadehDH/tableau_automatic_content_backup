      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_77DBDCD16A89432E92A5EE6B636AF3A3'>
            <properties context=''>
              <relation connection='bigquery.0208jmh0qv2y8318ri9dn1o32jhm' name='Banner performance' type='text'>SELECT
  date,
  (case when user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;) then &quot;UAE&quot; else user_selected_country end) as country,
  banner_position,
  banner_detail AS banner_name,
  COUNT(DISTINCT CASE WHEN is_banner_loaded THEN session_id END) as viewed_sessions,
  COUNT(DISTINCT CASE WHEN is_banner_clicked THEN session_id END) AS clicked_sessions,
  COUNT(DISTINCT CASE WHEN added_to_cart THEN session_id END) AS add_cart_sessions,
  COUNT(DISTINCT CASE WHEN placed_order THEN session_id END) AS placed_order_sessions
FROM
  `tlb-data-prod.data_platform.fct_sub_session_banner`
WHERE
  banner_category=&apos;hero_banner&apos;
  AND user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;,&apos;Kuwait&apos;,&apos;Bahrain&apos;,&apos;Egypt&apos;,&apos;Iraq&apos;,&apos;Jordan&apos;,&apos;KSA&apos;,&apos;Oman&apos;,&apos;Qatar&apos;,&apos;Saudi Arabia&apos;)
  AND date between &quot;2024-07-01&quot; and current_date()-1
GROUP BY ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Popular stores' inline='true' name='federated.0vg09qj13uwxkh108fo130cocev0' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1kxynu31izugjg164o61f0192iq6'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server='' server-oauth='server-custom' username='antariksh.mishra@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1kxynu31izugjg164o61f0192iq6' name='Custom SQL Query' type='text'>WITH popular_stores AS (
  SELECT
    date,
    (CASE WHEN user_selected_country IN (&apos;UAE&apos;,&apos;United Arab Emirates&apos;) THEN &quot;UAE&quot; ELSE user_selected_country END) AS country,
    CASE WHEN chain_name=&quot;Talabat Mart&quot; then &quot;talabat mart&quot; else LOWER(chain_name) end AS chain_name,
    COUNT(DISTINCT CASE WHEN found_via_feature_detail=&quot;Popular Stores&quot; THEN session_id END) AS clicked_sessions,
    COUNT(DISTINCT CASE WHEN added_to_cart AND found_via_feature_detail=&quot;Popular Stores&quot; THEN session_id END) AS add_cart_sessions,
    COUNT(DISTINCT CASE WHEN placed_order AND found_via_feature_detail=&quot;Popular Stores&quot; THEN session_id END) AS placed_order_sessions
  FROM `tlb-data-prod.data_platform.fct_sub_session_vendor_list` a 
  LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` b 
  ON SAFE_CAST(a.clicked_vendor_id as int64)=b.vendor_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c 
  ON b.chain_id=c.chain_id
  WHERE date between &quot;2024-07-01&quot; AND CURRENT_DATE()-1
  AND a.vertical=&quot;grocery&quot;
  AND user_selected_country IN (&apos;UAE&apos;,&apos;United Arab Emirates&apos;,&apos;Kuwait&apos;,&apos;Bahrain&apos;,&apos;Egypt&apos;,&apos;Iraq&apos;,&apos;Jordan&apos;,&apos;KSA&apos;,&apos;Oman&apos;,&apos;Qatar&apos;,&apos;Saudi Arabia&apos;)
  GROUP BY ALL
)

, ghome_sessions as (
  SELECT
    date,
    (CASE WHEN user_selected_country IN (&apos;UAE&apos;,&apos;United Arab Emirates&apos;) THEN &quot;UAE&quot; ELSE user_selected_country END) AS country,
    COUNT(DISTINCT session_id) AS viewed_sessions
  FROM `tlb-data-prod.data_platform.fct_sub_session_vendor_list`
  WHERE date between &quot;2024-07-01&quot; AND CURRENT_DATE()-1
  AND user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;,&apos;Kuwait&apos;,&apos;Bahrain&apos;,&apos;Egypt&apos;,&apos;Iraq&apos;,&apos;Jordan&apos;,&apos;KSA&apos;,&apos;Oman&apos;,&apos;Qatar&apos;,&apos;Saudi Arabia&apos;)
  and vertical=&quot;grocery&quot;
  GROUP BY ALL
)
SELECT
  p.date,
  p.country,
  p.chain_name,
  sum(viewed_sessions) as viewed_sessions,
  sum(clicked_sessions) as clicked_sessions,
  sum(add_cart_sessions) as add_cart_sessions,
  sum(placed_order_sessions) as placed_order_sessions
from
popular_stores p
left join ghome_sessions g
ON p.date=g.date
AND p.country=g.country
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1kxynu31izugjg164o61f0192iq6' name='Custom SQL Query' type='text'>WITH popular_stores AS (
  SELECT
    date,
    (CASE WHEN user_selected_country IN (&apos;UAE&apos;,&apos;United Arab Emirates&apos;) THEN &quot;UAE&quot; ELSE user_selected_country END) AS country,
    CASE WHEN chain_name=&quot;Talabat Mart&quot; then &quot;talabat mart&quot; else LOWER(chain_name) end AS chain_name,
    COUNT(DISTINCT CASE WHEN found_via_feature_detail=&quot;Popular Stores&quot; THEN session_id END) AS clicked_sessions,
    COUNT(DISTINCT CASE WHEN added_to_cart AND found_via_feature_detail=&quot;Popular Stores&quot; THEN session_id END) AS add_cart_sessions,
    COUNT(DISTINCT CASE WHEN placed_order AND found_via_feature_detail=&quot;Popular Stores&quot; THEN session_id END) AS placed_order_sessions
  FROM `tlb-data-prod.data_platform.fct_sub_session_vendor_list` a 
  LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` b 
  ON SAFE_CAST(a.clicked_vendor_id as int64)=b.vendor_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c 
  ON b.chain_id=c.chain_id
  WHERE date between &quot;2024-07-01&quot; AND CURRENT_DATE()-1
  AND a.vertical=&quot;grocery&quot;
  AND user_selected_country IN (&apos;UAE&apos;,&apos;United Arab Emirates&apos;,&apos;Kuwait&apos;,&apos;Bahrain&apos;,&apos;Egypt&apos;,&apos;Iraq&apos;,&apos;Jordan&apos;,&apos;KSA&apos;,&apos;Oman&apos;,&apos;Qatar&apos;,&apos;Saudi Arabia&apos;)
  GROUP BY ALL
)

, ghome_sessions as (
  SELECT
    date,
    (CASE WHEN user_selected_country IN (&apos;UAE&apos;,&apos;United Arab Emirates&apos;) THEN &quot;UAE&quot; ELSE user_selected_country END) AS country,
    COUNT(DISTINCT session_id) AS viewed_sessions
  FROM `tlb-data-prod.data_platform.fct_sub_session_vendor_list`
  WHERE date between &quot;2024-07-01&quot; AND CURRENT_DATE()-1
  AND user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;,&apos;Kuwait&apos;,&apos;Bahrain&apos;,&apos;Egypt&apos;,&apos;Iraq&apos;,&apos;Jordan&apos;,&apos;KSA&apos;,&apos;Oman&apos;,&apos;Qatar&apos;,&apos;Saudi Arabia&apos;)
  and vertical=&quot;grocery&quot;
  GROUP BY ALL
)
SELECT
  p.date,
  p.country,
  p.chain_name,
  sum(viewed_sessions) as viewed_sessions,
  sum(clicked_sessions) as clicked_sessions,
  sum(add_cart_sessions) as add_cart_sessions,
  sum(placed_order_sessions) as placed_order_sessions
from
popular_stores p
left join ghome_sessions g
ON p.date=g.date
AND p.country=g.country
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
