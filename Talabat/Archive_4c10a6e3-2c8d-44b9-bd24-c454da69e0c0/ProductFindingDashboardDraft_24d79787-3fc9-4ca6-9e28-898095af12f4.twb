      <date-options start-of-week='saturday' />
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_1DA8AD86B02D4CA998F1371BB04F8AFE'>
            <properties context=''>
              <relation connection='bigquery.0jxn6kj035mqqx1bcou771698six' name='Custom SQL Query' type='text'><![CDATA[with vc as (
  select 
    *,
    ROW_NUMBER() OVER (PARTITION BY session_id, clicked_vendor_id ORDER BY sub_session_start_time desc) as rn 
  FROM `tlb-data-prod.data_platform.fct_sub_session_click_vendor` 
  WHERE date>>='2024-12-01'

)

SELECT
  DISTINCT
    c.date,
    c.operating_system,
    c.user_selected_country,
    c.app_version,
    v.vertical as vertical,
    v.sub_vertical as shopType,
    CASE
      WHEN
        darkstore_previously_ordered = 'has_prior_orders' AND
        marketplace_previously_ordered = 'has_prior_orders'
      THEN 'marketplace_repeat_darkstore_repeat'
      WHEN
        darkstore_previously_ordered = 'no_prior_orders' AND
        marketplace_previously_ordered = 'has_prior_orders'
      THEN 'marketplace_repeat_darkstore_new'
      WHEN
        darkstore_previously_ordered = 'has_prior_orders' AND
        marketplace_previously_ordered = 'no_prior_orders'
        THEN 'darkstore_repeat_marketplace_new'
    ELSE 'marketplace_new_darkstore_new'
    END AS userType,
    CASE
      WHEN c.found_via='home' THEN 'Talabat Home'
      WHEN c.found_via='vendor_list' THEN 'Grocery Home'
      WHEN c.found_via='order_confirmation' THEN 'POE'
      ELSE 'unmapped' 
    END AS found_via,
    c.found_via_feature,
    c.found_via_feature_detail,
    COUNT (DISTINCT c.session_id) AS shop_click_sessions,
    COUNT ( DISTINCT CASE WHEN c.viewed_menu=TRUE THEN c.session_id ELSE NULL END) AS viewed_menu_sessions,
    COUNT (DISTINCT CASE WHEN c.added_to_cart=TRUE THEN c.session_id ELSE NULL END) AS add_cart_sessions,
    COUNT (DISTINCT CASE WHEN c.started_checkout=TRUE THEN c.session_id ELSE NULL END) AS checkout_sessions,
    COUNT (DISTINCT CASE WHEN c.placed_order=TRUE THEN c.session_id ELSE NULL END) AS placed_order_sessions
FROM (
  select 
    * 
  from vc 
  where rn=1
  #QUALIFY ROW_NUMBER() OVER (PARTITION BY session_id ORDER BY sub_session_start_time desc) =1
) as c
LEFT JOIN
  `tlb-data-prod.data_platform.dim_vendor`v
ON c.clicked_vendor_id=v.vendor_id
LEFT JOIN
  `tlb-data-prod.data_platform.fct_session_grocery` o
ON c.session_id=o.session_id
AND c.date=o.date
WHERE c.date>>='2024-12-01'
AND v.vertical <<>> 'food'
AND lower(c.operating_system) IN ('ios','android')
GROUP BY ALL]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
