    chain_name,
    count(distinct case when clicked_vendor_id is not null and  found_via_feature=&quot;organic_list&quot; then session_id end) as clicked_sessions,
    count(distinct case when added_to_cart and  found_via_feature=&quot;organic_list&quot; then session_id end) as add_cart_sessions,
    count(distinct case when placed_order   and found_via_feature=&quot;organic_list&quot; then session_id end) as placed_order_sessions
  FROM
