        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0eqapm61cizehz1ejox9y0e3gtre' name='Custom SQL Query' type='text'>WITH item_collections as (
  SELECT
    date,
    (case when user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;) then &quot;UAE&quot; else user_selected_country end) as country,
    found_via_feature_position as banner_position,
    count(distinct case when found_via_feature=&quot;ghome_item_collection&quot; and clicked_vendor_id is not null then session_id end) as clicked_sessions,
    count(distinct case when found_via_feature=&quot;ghome_item_collection&quot; and added_to_cart then session_id end) as add_cart_sessions,
    count(distinct case when found_via_feature=&quot;ghome_item_collection&quot; and placed_order then session_id end) as placed_order_sessions
  FROM `tlb-data-prod.data_platform.fct_sub_session_vendor_list`
  WHERE date between &quot;2024-07-01&quot; and current_date()-1
  AND vertical=&quot;grocery&quot;
  AND user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;,&apos;Kuwait&apos;,&apos;Bahrain&apos;,&apos;Egypt&apos;,&apos;Iraq&apos;,&apos;Jordan&apos;,&apos;KSA&apos;,&apos;Oman&apos;,&apos;Qatar&apos;,&apos;Saudi Arabia&apos;)
  GROUP BY ALL
)
, ghome_sessions as (
  SELECT
    date,
    (case when user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;) then &quot;UAE&quot; else user_selected_country end) as country,
    count(distinct session_id) as viewed_sessions
  FROM `tlb-data-prod.data_platform.fct_sub_session_vendor_list`
  WHERE date between &quot;2024-07-01&quot; and current_date()-1
  AND user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;,&apos;Kuwait&apos;,&apos;Bahrain&apos;,&apos;Egypt&apos;,&apos;Iraq&apos;,&apos;Jordan&apos;,&apos;KSA&apos;,&apos;Oman&apos;,&apos;Qatar&apos;,&apos;Saudi Arabia&apos;)
  AND vertical=&quot;grocery&quot;
  GROUP BY ALL
)
SELECT
  i.date,
  i.country,
  i.banner_position,
  sum(viewed_sessions) as viewed_sessions,
  sum(clicked_sessions) as clicked_sessions,
  sum(add_cart_sessions) as add_cart_sessions,
  sum(placed_order_sessions) as placed_order_sessions
FROM
item_collections i
LEFT JOIN ghome_sessions g
ON i.date=g.date
AND i.country=g.country
GROUP BY ALL</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
