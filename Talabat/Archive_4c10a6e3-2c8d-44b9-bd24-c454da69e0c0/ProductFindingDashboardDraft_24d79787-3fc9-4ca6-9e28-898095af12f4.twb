      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_872CE23816FB41D0B01E7773DEBF493A'>
            <properties context=''>
              <relation connection='bigquery.0eqapm61cizehz1ejox9y0e3gtre' name='Custom SQL Query' type='text'>WITH item_collections as (
  SELECT
    date,
    (case when user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;) then &quot;UAE&quot; else user_selected_country end) as country,
    found_via_feature_position as banner_position,
    count(distinct case when found_via_feature=&quot;ghome_item_collection&quot; and clicked_vendor_id is not null then session_id end) as clicked_sessions,
    count(distinct case when found_via_feature=&quot;ghome_item_collection&quot; and added_to_cart then session_id end) as add_cart_sessions,
    count(distinct case when found_via_feature=&quot;ghome_item_collection&quot; and placed_order then session_id end) as placed_order_sessions
  FROM `tlb-data-prod.data_platform.fct_sub_session_vendor_list`
  WHERE date between &quot;2024-07-01&quot; and current_date()-1
  AND vertical=&quot;grocery&quot;
  AND user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;,&apos;Kuwait&apos;,&apos;Bahrain&apos;,&apos;Egypt&apos;,&apos;Iraq&apos;,&apos;Jordan&apos;,&apos;KSA&apos;,&apos;Oman&apos;,&apos;Qatar&apos;,&apos;Saudi Arabia&apos;)
  GROUP BY ALL
)
, ghome_sessions as (
  SELECT
    date,
    (case when user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;) then &quot;UAE&quot; else user_selected_country end) as country,
    count(distinct session_id) as viewed_sessions
  FROM `tlb-data-prod.data_platform.fct_sub_session_vendor_list`
  WHERE date between &quot;2024-07-01&quot; and current_date()-1
  AND user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;,&apos;Kuwait&apos;,&apos;Bahrain&apos;,&apos;Egypt&apos;,&apos;Iraq&apos;,&apos;Jordan&apos;,&apos;KSA&apos;,&apos;Oman&apos;,&apos;Qatar&apos;,&apos;Saudi Arabia&apos;)
  AND vertical=&quot;grocery&quot;
  GROUP BY ALL
)
SELECT
  i.date,
  i.country,
  i.banner_position,
  sum(viewed_sessions) as viewed_sessions,
  sum(clicked_sessions) as clicked_sessions,
  sum(add_cart_sessions) as add_cart_sessions,
  sum(placed_order_sessions) as placed_order_sessions
FROM
item_collections i
LEFT JOIN ghome_sessions g
ON i.date=g.date
AND i.country=g.country
GROUP BY ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='Entry points' inline='true' name='federated.0yf2wqq16oingn16kv96d1jjss77' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0jxn6kj035mqqx1bcou771698six'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server='' server-oauth='server-custom' username='antariksh.mishra@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0jxn6kj035mqqx1bcou771698six' name='Custom SQL Query' type='text'><![CDATA[with vc as (
  select 
    *,
    ROW_NUMBER() OVER (PARTITION BY session_id, clicked_vendor_id ORDER BY sub_session_start_time desc) as rn 
  FROM `tlb-data-prod.data_platform.fct_sub_session_click_vendor` 
  WHERE date>>='2024-12-01'

)

SELECT
  DISTINCT
    c.date,
    c.operating_system,
    c.user_selected_country,
    c.app_version,
    v.vertical as vertical,
    v.sub_vertical as shopType,
    CASE
      WHEN
        darkstore_previously_ordered = 'has_prior_orders' AND
        marketplace_previously_ordered = 'has_prior_orders'
      THEN 'marketplace_repeat_darkstore_repeat'
      WHEN
        darkstore_previously_ordered = 'no_prior_orders' AND
        marketplace_previously_ordered = 'has_prior_orders'
      THEN 'marketplace_repeat_darkstore_new'
      WHEN
        darkstore_previously_ordered = 'has_prior_orders' AND
        marketplace_previously_ordered = 'no_prior_orders'
        THEN 'darkstore_repeat_marketplace_new'
    ELSE 'marketplace_new_darkstore_new'
    END AS userType,
    CASE
      WHEN c.found_via='home' THEN 'Talabat Home'
      WHEN c.found_via='vendor_list' THEN 'Grocery Home'
      WHEN c.found_via='order_confirmation' THEN 'POE'
      ELSE 'unmapped' 
    END AS found_via,
    c.found_via_feature,
    c.found_via_feature_detail,
    COUNT (DISTINCT c.session_id) AS shop_click_sessions,
    COUNT ( DISTINCT CASE WHEN c.viewed_menu=TRUE THEN c.session_id ELSE NULL END) AS viewed_menu_sessions,
    COUNT (DISTINCT CASE WHEN c.added_to_cart=TRUE THEN c.session_id ELSE NULL END) AS add_cart_sessions,
    COUNT (DISTINCT CASE WHEN c.started_checkout=TRUE THEN c.session_id ELSE NULL END) AS checkout_sessions,
    COUNT (DISTINCT CASE WHEN c.placed_order=TRUE THEN c.session_id ELSE NULL END) AS placed_order_sessions
FROM (
  select 
    * 
  from vc 
  where rn=1
  #QUALIFY ROW_NUMBER() OVER (PARTITION BY session_id ORDER BY sub_session_start_time desc) =1
) as c
LEFT JOIN
  `tlb-data-prod.data_platform.dim_vendor`v
ON c.clicked_vendor_id=v.vendor_id
LEFT JOIN
  `tlb-data-prod.data_platform.fct_session_grocery` o
ON c.session_id=o.session_id
AND c.date=o.date
WHERE c.date>>='2024-12-01'
AND v.vertical <<>> 'food'
AND lower(c.operating_system) IN ('ios','android')
GROUP BY ALL]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0jxn6kj035mqqx1bcou771698six' name='Custom SQL Query' type='text'><![CDATA[with vc as (
  select 
    *,
    ROW_NUMBER() OVER (PARTITION BY session_id, clicked_vendor_id ORDER BY sub_session_start_time desc) as rn 
  FROM `tlb-data-prod.data_platform.fct_sub_session_click_vendor` 
  WHERE date>>='2024-12-01'

)

SELECT
  DISTINCT
    c.date,
    c.operating_system,
    c.user_selected_country,
    c.app_version,
    v.vertical as vertical,
    v.sub_vertical as shopType,
    CASE
      WHEN
        darkstore_previously_ordered = 'has_prior_orders' AND
        marketplace_previously_ordered = 'has_prior_orders'
      THEN 'marketplace_repeat_darkstore_repeat'
      WHEN
        darkstore_previously_ordered = 'no_prior_orders' AND
        marketplace_previously_ordered = 'has_prior_orders'
      THEN 'marketplace_repeat_darkstore_new'
      WHEN
        darkstore_previously_ordered = 'has_prior_orders' AND
        marketplace_previously_ordered = 'no_prior_orders'
        THEN 'darkstore_repeat_marketplace_new'
    ELSE 'marketplace_new_darkstore_new'
    END AS userType,
    CASE
      WHEN c.found_via='home' THEN 'Talabat Home'
      WHEN c.found_via='vendor_list' THEN 'Grocery Home'
      WHEN c.found_via='order_confirmation' THEN 'POE'
      ELSE 'unmapped' 
    END AS found_via,
    c.found_via_feature,
    c.found_via_feature_detail,
    COUNT (DISTINCT c.session_id) AS shop_click_sessions,
    COUNT ( DISTINCT CASE WHEN c.viewed_menu=TRUE THEN c.session_id ELSE NULL END) AS viewed_menu_sessions,
    COUNT (DISTINCT CASE WHEN c.added_to_cart=TRUE THEN c.session_id ELSE NULL END) AS add_cart_sessions,
    COUNT (DISTINCT CASE WHEN c.started_checkout=TRUE THEN c.session_id ELSE NULL END) AS checkout_sessions,
    COUNT (DISTINCT CASE WHEN c.placed_order=TRUE THEN c.session_id ELSE NULL END) AS placed_order_sessions
FROM (
  select 
    * 
  from vc 
  where rn=1
  #QUALIFY ROW_NUMBER() OVER (PARTITION BY session_id ORDER BY sub_session_start_time desc) =1
) as c
LEFT JOIN
  `tlb-data-prod.data_platform.dim_vendor`v
ON c.clicked_vendor_id=v.vendor_id
LEFT JOIN
  `tlb-data-prod.data_platform.fct_session_grocery` o
ON c.session_id=o.session_id
AND c.date=o.date
WHERE c.date>>='2024-12-01'
AND v.vertical <<>> 'food'
AND lower(c.operating_system) IN ('ios','android')
GROUP BY ALL]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
