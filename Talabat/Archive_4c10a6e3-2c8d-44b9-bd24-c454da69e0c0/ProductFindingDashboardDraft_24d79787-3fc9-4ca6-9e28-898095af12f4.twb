      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_A1F22E8490C84494A9C5DECA06E5F57D'>
            <properties context=''>
              <relation connection='bigquery.10v3ig81q239l31f9mgy10555oqi' name='Custom SQL Query' type='text'>with more_vl as (
  SELECT
    date,
    chain_name,
    (case when user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;) then &quot;UAE&quot; else user_selected_country end) as country,
    COUNT(DISTINCT session_id) AS clicked_sessions,
    COUNT(DISTINCT case when added_to_cart then session_id end) AS add_cart_sessions,
    COUNT(DISTINCT transaction_id) AS placed_order_sessions
  FROM
    `tlb-data-prod.data_platform.fct_sub_session_vendor_list` a
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_vendor_info` b
  ON
    SAFE_CAST(a.clicked_vendor_id AS int64)=b.vendor_id
  LEFT JOIN
    `tlb-data-prod.data_platform.dim_chain` c
  ON
    b.chain_id=c.chain_id
  WHERE date BETWEEN &quot;2024-07-01&quot; AND CURRENT_DATE()-1
  AND a.vertical=&quot;more&quot;
  AND user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;,&apos;Kuwait&apos;,&apos;Bahrain&apos;,&apos;Egypt&apos;,&apos;Iraq&apos;,&apos;Jordan&apos;,&apos;KSA&apos;,&apos;Oman&apos;,&apos;Qatar&apos;,&apos;Saudi Arabia&apos;)
  GROUP BY ALL)
  
, thome_sessions as (
  SELECT
    date,
    (case when user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;) then &quot;UAE&quot; else user_selected_country end) as country,
    count(distinct session_id) as viewed_sessions
  FROM `tlb-data-prod.data_platform.fct_sub_session_homepage`
  WHERE date BETWEEN &quot;2024-07-01&quot; AND CURRENT_DATE()-1
  AND user_selected_country in (&apos;UAE&apos;,&apos;United Arab Emirates&apos;,&apos;Kuwait&apos;,&apos;Bahrain&apos;,&apos;Egypt&apos;,&apos;Iraq&apos;,&apos;Jordan&apos;,&apos;KSA&apos;,&apos;Oman&apos;,&apos;Qatar&apos;,&apos;Saudi Arabia&apos;)
  group by 1,2
)

SELECT
  vl.date,
  vl.country,
  chain_name,
  sum(viewed_sessions) as thome_sessions,
  sum(clicked_sessions) as clicked_sessions,
  sum(add_cart_sessions) as add_cart_sessions,
  sum(placed_order_sessions) as placed_order_sessions
from
more_vl vl
left join 
thome_sessions g
on vl.date=g.date
and vl.country=g.country
group by ALL</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
