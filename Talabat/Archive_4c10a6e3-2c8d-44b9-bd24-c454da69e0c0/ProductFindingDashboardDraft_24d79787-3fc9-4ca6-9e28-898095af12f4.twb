    <datasource caption='Store type tiles' inline='true' name='federated.0so9qx90yt4jxd1g3msy50nd8ygm' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.04z01mz0c56agz1dr8iz20js0qnf'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server='' server-oauth='server-custom' username='antariksh.mishra@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.04z01mz0c56agz1dr8iz20js0qnf' name='Custom SQL Query' type='text'>##Store type tiles
SELECT
  date,
  country,
  found_via_feature_detail,
  max(viewed_sessions) as viewed_sessions,
  sum(clicked_sessions) as clicked_sessions,
  sum(add_cart_sessions) as add_cart_sessions,
  sum(placed_order_sessions) as placed_order_sessions
from (
  SELECT
    date,
    user_selected_country as country,
    found_via_feature_detail,
    count(distinct session_id) over (partition by date,user_selected_country) as viewed_sessions,
    count(distinct case when clicked_vendor_id is not null   and found_via_feature=&quot;ghome_store_type_tiles&quot; then session_id end) as clicked_sessions,
    count(distinct case when added_to_cart and found_via_feature=&quot;ghome_store_type_tiles&quot; then session_id end) as add_cart_sessions,
    count(distinct case when placed_order and found_via_feature=&quot;ghome_store_type_tiles&quot; then session_id end) as placed_order_sessions
  FROM
    `tlb-data-prod.data_platform.fct_sub_session_vendor_list` 
  WHERE
    date between &quot;2024-07-01&quot; and current_date()-1
  and vertical=&quot;grocery&quot;
  GROUP BY 1, 2, 3, session_id
)
group by 1, 2, 3</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.04z01mz0c56agz1dr8iz20js0qnf' name='Custom SQL Query' type='text'>##Store type tiles
