  sum(clicked_sessions) as clicked_sessions,
  sum(add_cart_sessions) as add_cart_sessions,
  sum(placed_order_sessions) as placed_order_sessions
from (
  SELECT
    date,
    user_selected_country as country,
    found_via_feature_detail,
    count(distinct session_id) over (partition by date,user_selected_country) as viewed_sessions,
    count(distinct case when clicked_vendor_id is not null   and found_via_feature=&quot;ghome_store_type_tiles&quot; then session_id end) as clicked_sessions,
    count(distinct case when added_to_cart and found_via_feature=&quot;ghome_store_type_tiles&quot; then session_id end) as add_cart_sessions,
    count(distinct case when placed_order and found_via_feature=&quot;ghome_store_type_tiles&quot; then session_id end) as placed_order_sessions
  FROM
    `tlb-data-prod.data_platform.fct_sub_session_vendor_list` 
  WHERE
    date between &quot;2024-07-01&quot; and current_date()-1
  and vertical=&quot;grocery&quot;
  GROUP BY 1, 2, 3, session_id
)
group by 1, 2, 3</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
