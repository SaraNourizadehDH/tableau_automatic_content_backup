        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.0qwfeju0l9sc0n18091gr1pyryql'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform_logistics' server-oauth='' username='ezeftawy@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0qwfeju0l9sc0n18091gr1pyryql' name='Custom SQL Query' type='text'>SELECT 
r.country_code,
ci.name as city_name,
rider_id,
(SELECT name FROM UNNEST(contracts) WHERE status = &apos;VALID&apos; ORDER BY end_at DESC LIMIT 1) AS contract_name,
batch_number,
IFNULL((SELECT logical_or(id is not null) FROM UNNEST(contracts) WHERE status = &apos;VALID&apos;  and end_at&gt;&gt;CURRENT_TIMESTAMP() ),FALSE) AS is_active,
--f.user_id,
hr.order_id,
f.created_at,
date(f.created_at) as created_date,
f.reason,
f.comment

FROM `fulfillment-dwh-production.curated_data_shared.riders` r
join unnest (rider_feedbacks) f
join  `fulfillment-dwh-production.curated_data_shared.countries` c using(country_code)
left join `tlb-data-prod.data_platform.fct_logistics_order` hr on r.country_code =hr.country_code and f.order_id = hr.hurrier_order_id
join unnest(cities) ci on ci.id=  (SELECT city_id FROM UNNEST(contracts) WHERE status = &apos;VALID&apos;  ORDER BY end_at DESC LIMIT 1) and ci.is_Active 
where date(f.created_at)&gt;&gt;= &apos;2023-01-01&apos;</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0qwfeju0l9sc0n18091gr1pyryql' name='Custom SQL Query' type='text'>SELECT 
r.country_code,
ci.name as city_name,
