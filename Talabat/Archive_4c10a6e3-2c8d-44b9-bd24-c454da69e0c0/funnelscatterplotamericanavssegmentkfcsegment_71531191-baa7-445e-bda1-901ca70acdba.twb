SELECT
     rka.clean_chain_name,
     rka.group_name,
     rka.main_cuisine,
     dim_country_info.country,
     -- date_trunc(agg_vendor_performance_summarised_daily.date,MONTH) as month,
     
     COALESCE(SUM(agg_vendor_performance_summarised_daily.viewed_menu_session_count ), 0) AS menu_sessions,
     COALESCE(SUM(agg_vendor_performance_summarised_daily.viewed_cart_session_count ), 0) AS cart_sessions,
     COALESCE(SUM(agg_vendor_performance_summarised_daily.placed_order_session_count ), 0) AS order_sessions

FROM `tlb-data-prod.data_platform.agg_vendor_performance_summarised_daily` AS agg_vendor_performance_summarised_daily
INNER JOIN `tlb-data-prod.data_platform.dim_vendor_info` AS dim_vendor_info ON agg_vendor_performance_summarised_daily.vendor_id = (CAST(dim_vendor_info.vendor_id AS STRING))
LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` AS dim_vendor_location ON dim_vendor_location.location_id = dim_vendor_info.location_id
INNER JOIN `tlb-data-prod.data_platform.dim_chain` AS dim_chain ON dim_chain.chain_id = dim_vendor_info.chain_id
INNER JOIN `tlb-data-prod.data_platform.dim_country_info` AS dim_country_info ON dim_country_info.country_id = dim_chain.country_id

inner join RKA_universe as rka on rka.chain_id = dim_chain.chain_id

WHERE agg_vendor_performance_summarised_daily.date between &apos;2024-05-01&apos; and &apos;2024-05-31&apos;

GROUP BY 1,2,3,4</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
