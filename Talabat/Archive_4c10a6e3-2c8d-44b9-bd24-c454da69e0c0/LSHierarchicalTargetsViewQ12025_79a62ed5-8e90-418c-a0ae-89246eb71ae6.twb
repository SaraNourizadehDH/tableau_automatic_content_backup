      </column>
      <column caption='AVG 3M GMV (copy)' datatype='real' name='[AVG 3M GMV (copy)_1386967948851023872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([gmv])/3' />
      </column>
      <column caption='AVG 3M IND' datatype='real' name='[AVG 3M OPS (copy 2)_5065845961362571268]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ISNULL(&#10;&#10;sum(if [Vertical] in (&apos;grocery&apos;, &apos;pharmacy&apos;) then ([partially_fulfilled_orders_removed_items] + [vendor_oos_failed_items]) end) /&#10;sum(if [Vertical] in (&apos;grocery&apos;, &apos;pharmacy&apos;)then [net_qty_ordered] end)) then 0&#10;ELSE&#10;&#10;sum(if [Vertical] in (&apos;grocery&apos;, &apos;pharmacy&apos;) then ([partially_fulfilled_orders_removed_items] + [vendor_oos_failed_items])  end) /&#10;sum(if [Vertical] in (&apos;grocery&apos;, &apos;pharmacy&apos;) then [net_qty_ordered] end)&#10;END' />
      </column>
      <column caption='AVG 3M VNFR' datatype='real' name='[AVG 3M OPS (copy 2)_5065845961362784261]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ISNULL(&#10;&#10;sum(if [Vertical] in (&apos;cosmetics&apos;,&apos;electronics&apos;,&apos;flowers&apos;,&apos;pet shop&apos;,&apos;Speciality Stores&apos;,&apos;pharmacy&apos;) then [failed_orders_due_to_vendor] end) /&#10;sum(if [Vertical] in (&apos;cosmetics&apos;,&apos;electronics&apos;,&apos;flowers&apos;,&apos;pet shop&apos;,&apos;Speciality Stores&apos;,&apos;pharmacy&apos;) then [net_orders] end)) then 0&#10;ELSE&#10;&#10;sum(if [Vertical] in (&apos;cosmetics&apos;,&apos;electronics&apos;,&apos;flowers&apos;,&apos;pet shop&apos;,&apos;Speciality Stores&apos;, &apos;pharmacy&apos;) then [failed_orders_due_to_vendor] end) /&#10;sum(if [Vertical] in (&apos;cosmetics&apos;,&apos;electronics&apos;,&apos;flowers&apos;,&apos;pet shop&apos;,&apos;Speciality Stores&apos;, &apos;pharmacy&apos;) then [net_orders] end)&#10;END' />
      </column>
      <column caption='AVG 3M OPS (copy)' datatype='real' name='[AVG 3M OPS (copy)_5065845961320886273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ISNULL(&#10;&#10;sum(if [Target GMV (copy)_5065845961321287682]&gt;.50 then ([partially_fulfilled_orders_removed_items] + [vendor_oos_failed_items]) else [failed_orders_due_to_vendor] end) /&#10;sum(if [Target GMV (copy)_5065845961321287682]&gt;.50 then [net_qty_ordered] else [net_orders] end)) then 0&#10;ELSE&#10;&#10;sum(if [Target GMV (copy)_5065845961321287682]&gt;.50 then ([partially_fulfilled_orders_removed_items] + [vendor_oos_failed_items]) else [failed_orders_due_to_vendor] end) /&#10;sum(if [Target GMV (copy)_5065845961321287682]&gt;.50 then [net_qty_ordered] else [net_orders] end)&#10;END' />
      </column>
      <column caption='AVG 3M Order OOS % &amp; Vendor Failed (copy)' datatype='real' name='[AVG 3M Order OOS % &amp; Vendor Failed (copy)_7034200448295555072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([atleast_1_item_removed]) + SUM([vendor_oos_failed_orders]))/(3 * [Calculation_5508465327804284933])' />
      </column>
      <column caption='AVG Vertical NCR' datatype='real' name='[AVG GMV (copy)_6786713565568114697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [ncr_potential_category] = &apos;High&apos; and [Current GMV (copy)_6585458957199040512]=0 then&#10;&#10;((({FIXED [date],[country_code], [vertical]: SUM([ncr_lc])}) / ({FIXED [date],[country_code], [vertical]: SUM([gmv])})) * ({FIXED [date],[country_code], [vertical], [chain_category], [chain_name]: SUM([gmv])/3})) * 0.50&#10;&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Vertical OPS' datatype='real' name='[AVG OPS (copy)_3530540665091325964]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [date],[country_code], [vertical] : ([Calculation_6260355353773420548])}' />
      </column>
      <column caption='Bucket1' datatype='string' name='[Bucket]' role='dimension' type='nominal' />
      <column caption='index' datatype='integer' name='[Calculation_1237856613610090497]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Adjusted Target GMV' datatype='real' name='[Calculation_1884193529137491969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Chain GMV% (copy)_1718545501197000709]' />
      </column>
      <column caption='Adjusted Target OPS' datatype='real' name='[Calculation_1884193529137664002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3530540665095090192] + ((if (([Calculation_6260355353773420548] * [Calculation_3530540665092309006]) + [Calculation_6260355353773420548]) &gt;=1 then 1 else (([Calculation_6260355353773420548] * [Calculation_3530540665092309006]) + [Calculation_6260355353773420548]) END) * MAX([Adjusted OPS% (Adjusted%1)]))' />
      </column>
      <column caption='Current GMV' datatype='real' name='[Calculation_3500704321106735106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([cuurent_gmv]) / DAY(TODAY()-1)) * max([Calculation_3500704321113612291])' />
      </column>
      <column caption='Numbers of days' datatype='integer' name='[Calculation_3500704321113612291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [date (Custom SQL Query)], DATEADD(&apos;month&apos;, 1, [date (Custom SQL Query)]))' />
      </column>
      <column caption='OPS%' datatype='real' name='[Calculation_3530540665092309006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(MAX([OPS Targets (Inputs.vertical1)]) - MAX([AVG OPS (copy)_3530540665091325964])) / MAX([AVG OPS (copy)_3530540665091325964])' />
      </column>
      <column caption='Target OPS' datatype='real' name='[Calculation_3530540665095090192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if (([Calculation_6260355353773420548] * [Calculation_3530540665092309006]) + [Calculation_6260355353773420548]) &gt;=1 then 1 else (([Calculation_6260355353773420548] * [Calculation_3530540665092309006]) + [Calculation_6260355353773420548]) END' />
      </column>
      <column caption='Order OOS % &amp; Vendor Failed ' datatype='real' name='[Calculation_3834674383825772544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([failed_orders_due_to_vendor]) + SUM([atleast_1_item_removed]))/([Calculation_5508465327804284933])' />
      </column>
      <column caption='failed_orders_due_to_vendor_vertical_filter_applied' datatype='integer' name='[Calculation_5508465327440494593]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [vertical (Inputs.vertical)] IN (&apos;pharmacy&apos;) THEN 0&#10;ELSE [failed_orders_due_to_vendor] END' />
      </column>
      <column caption='Calculation2' datatype='real' name='[Calculation_5508465327441522690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_5508465327440494593]) /SUM([net_orders])' />
      </column>
      <column caption='Orders OOS' datatype='integer' name='[Calculation_5508465327804030979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([partially_fulfilled_orders]) + SUM([vendor_oos_failed_orders])' />
      </column>
      <column caption='Successful Orders' datatype='integer' name='[Calculation_5508465327804207108]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Date], [country_code] : SUM([successful_orders])}' />
      </column>
      <column caption='Net Orders' datatype='integer' name='[Calculation_5508465327804284933]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([net_orders])' />
      </column>
      <column caption='OOS Orders Successfully Replaced' datatype='integer' name='[Calculation_5508465327804375046]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([partially_item_replaced_orders])' />
      </column>
      <column caption='New Metric' datatype='real' name='[Calculation_5508465327804518407]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_5508465327804207108]-SUM(([partially_fulfilled_orders] + [vendor_oos_failed_orders]) - ([partially_item_replaced_orders])))/([Calculation_5508465327804284933])' />
      </column>
      <column caption='% of Orders without Items not delivered' datatype='real' name='[Calculation_5508465327811305480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-(sum([partially_item_not_replaced_orders]) + sum([failed_orders_due_to_vendor])/sum([net_orders]))' />
      </column>
      <column caption='AVG 3M Unhealthy Orders' datatype='real' name='[Calculation_5508465328146878473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if ISNULL(&#10;&#10;(sum(if [Vertical] in (&apos;grocery&apos;, &apos;pharmacy&apos;) then [localshops_unhealthy_order_count] end) /&#10;sum(if [Vertical] in (&apos;grocery&apos;, &apos;pharmacy&apos;)then ([successful_orders] + [okr_failed_order_count]) end))) then 0&#10;ELSE&#10;&#10;(sum(if [Vertical] in (&apos;grocery&apos;, &apos;pharmacy&apos;) then [localshops_unhealthy_order_count]  end) /&#10;sum(if [Vertical] in (&apos;grocery&apos;, &apos;pharmacy&apos;) then ([successful_orders] + [okr_failed_order_count]) end))&#10;END' />
      </column>
      <column caption='Target Orders without Items not delivered' datatype='real' name='[Calculation_5508465328157282314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if (([Calculation_5508465328146878473] * [OPS% (copy)_5065845961363656712]) + [Calculation_5508465328146878473]) &gt;=1 then 1 else (([Calculation_5508465328146878473] * [OPS% (copy)_5065845961363656712]) + [Calculation_5508465328146878473]) END' />
      </column>
      <column caption='AVG 3M Orders' datatype='real' name='[Calculation_5508465328188698636]' role='measure' type='quantitative'>
