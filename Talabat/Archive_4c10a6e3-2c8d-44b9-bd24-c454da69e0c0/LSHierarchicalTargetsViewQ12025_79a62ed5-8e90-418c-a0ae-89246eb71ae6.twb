  -- case when lead_data_origin = 'PP' THEN 'Grocery - AAA' else 'Grocery - Non-AAA' end
  -- ELSE vertical end as vertical
    "Speciality Stores" as vertical
FROM `tlb-data-prod.data_platform.dim_chain`
left join `tlb-data-prod.data_platform.dim_vendor_info` v using(chain_id)
left join `tlb-data-prod.data_platform.fct_order_info` o using(vendor_id)
where (lead_data_origin <<>> 'SS' or lead_data_origin is null)
and v.is_non_food
and not v.is_darkstore
and order_date >>='2021-01-01'),

countries AS (
  SELECT DISTINCT country_code
  FROM `tlb-data-prod.data_platform.dim_chain` c
  WHERE country_code IN ('AE', 'BH', 'EG', 'IQ', 'JO', 'KW', 'OM', 'QA', 'SA')
),

pre_final AS (
SELECT
  DATE_TRUNC(o.order_date, MONTH) AS order_date,
  -- o.order_date,
  c.country_code,
  -- case when vertical = 'grocery' then 
  -- case when lead_data_origin = 'PP' THEN 'Grocery - AAA' else 'Grocery - Non-AAA' end
  -- ELSE vertical end as vertical,
  vertical,
  -- vs.vertical,
  sum(CASE WHEN o.is_successful then gmv_amount_eur ELSE 0 END) AS delivered_gmv,
  sum(CASE WHEN o.is_successful then gmv_amount_lc ELSE 0 END) AS delivered_lc,
  COUNT(DISTINCT order_id) AS num_orders,
  -- COALESCE(SUM(case when o.order_date BETWEEN '2024-04-01' and '2024-04-30' then net_orders end), 0) as net_orders,
FROM `tlb-data-prod.data_platform.dim_chain` c
left join `tlb-data-prod.data_platform.dim_vendor_info` v using(chain_id)
left join `tlb-data-prod.data_platform.fct_order_info` o using(vendor_id)
-- CROSS JOIN verticals vs
where (lead_data_origin <<>> 'SS' or lead_data_origin is null)
and v.is_non_food
and not v.is_darkstore
-- AND c.country_code = 'AE'
-- AND vertical IN ('pet shop', 'pharmacy')
and order_date >>='2021-01-01'
group by 1,2,3

union all

SELECT 
DATE_TRUNC(o.order_date, MONTH) AS order_date,
  -- o.order_date,
  c.country_code,
  "Speciality Stores" as vertical,
    -- vs.vertical,
  sum(CASE WHEN o.is_successful then gmv_amount_eur ELSE 0 END) AS delivered_gmv,
  sum(CASE WHEN o.is_successful then gmv_amount_lc ELSE 0 END) AS delivered_lc,
  -- COALESCE(SUM(case when a.date BETWEEN '2024-04-01' and '2024-04-30' then net_orders end), 0) as net_orders,
  COUNT(DISTINCT order_id) AS num_orders,
FROM `tlb-data-prod.data_platform.dim_chain` c
left join `tlb-data-prod.data_platform.dim_vendor_info` v using(chain_id)
left join `tlb-data-prod.data_platform.fct_order_info` o using(vendor_id)
-- CROSS JOIN verticals vs
where lead_data_origin = 'SS'
and v.is_non_food
and not v.is_darkstore
and order_date >>='2021-01-01'
group by 1,2,3),

pre_final2 AS (
SELECT *
FROM verticals vs 
CROSS JOIN countries)

SELECT order_date,
vertical,
country_code,
COALESCE(delivered_gmv, 0) AS delivered_gmv,
COALESCE(delivered_lc, 0) AS delivered_lc,
COALESCE(num_orders, 0) AS num_orders
FROM pre_final2 
LEFT JOIN pre_final USING(order_date, vertical, country_code)
-- WHERE country_code = 'AE'
ORDER BY 2,1]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='NCR vertical' inline='true' name='federated.1xbsot712mcqzu1belzu11nyhc4y' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1neiyhj0izf40f1gj5b9h1pmu74n'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='sharad.jain@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1neiyhj0izf40f1gj5b9h1pmu74n' name='Custom SQL Query' type='text'><![CDATA[with 
date_data as (
SELECT
    distinct
    date_trunc(date, month) AS date  
    FROM
      `tlb-data-prod.data_platform.dim_date`
    WHERE
      date BETWEEN '2024-01-01' AND '2024-03-31'),
gmv_data as (
WITH chain_gmv AS (
    SELECT
        date_trunc(a.date, month) AS date ,
        c.country_code,
        vertical,
        CASE 
            WHEN lead_data_origin = 'PP' THEN 'PP'
            ELSE 'LB'
        END AS chain_category,
        -- vertical AS chain_category,
        c.chain_name,
        MAX(c.account_manager_name) as account_manager_name,
        MAX(CASE WHEN order_flow_type = 'Grocery' and is_migrated_to_dh_menu then true else false end) as is_migrated,
        COALESCE(SUM(delivered_lc), 0) AS gmv,
        COALESCE(SUM(delivered_gmv), 0) AS gmv_eur,
        COALESCE(SUM(total_spu_discount),0) as total_spu_discount,
        COALESCE(SUM(total_spu_gmv_eur),0) as total_spu_gmv_eur,
        COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else pc.revenue_lc end),0) + COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else suggested_price_lc end),0) as ncr_lc,
        COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else pc.revenue_eur end),0) + COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else suggested_price_eur end),0) as ncr_eur,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then net_qty_ordered end), 0) as net_qty_ordered,        
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then vendor_oos_total_failed_items end), 0) as vendor_oos_failed_items,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then partially_fulfilled_orders_removed_items end), 0) as partially_fulfilled_orders_removed_items,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then failed_orders_due_to_vendor end), 0) as failed_orders_due_to_vendor,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then net_orders end), 0) as net_orders,
        SUM(COALESCE(SUM(ordered_gmv_elc), 0)) OVER (PARTITION BY c.country_code ORDER BY SUM(ordered_gmv_elc) DESC, c.chain_name) AS country_cumulative_gmv,
        CASE when COALESCE(SUM(successful_orders),0)>>0 and COALESCE(SUM(delivered_lc),0)>>0 and COALESCE(SUM(transaction_sessions),0)>>0 and COALESCE(SUM(menu_sessions), 0) >>0 then
        PERCENT_RANK() OVER (PARTITION BY c.country_code, vertical ORDER BY ( CASE when COALESCE(SUM(successful_orders),0)>>0 and COALESCE(SUM(delivered_lc),0)>>0 and COALESCE(SUM(transaction_sessions),0)>>0 and COALESCE(SUM(menu_sessions), 0) >>0 then (COALESCE(SUM(delivered_lc),0) / COALESCE(SUM(successful_orders),0)) * (COALESCE(SUM(transaction_sessions), 0)/COALESCE(SUM(menu_sessions), 0))else 1 end) DESC) else 1 END 
         AS ncr_potential_percentile

    FROM
        (select c.country_code, 
--         case when vertical = 'grocery' then 
--   case when lead_data_origin = 'PP' THEN 'Grocery - AAA' else 'Grocery - Non-AAA' end
--   ELSE vertical end as vertical, 
vertical,
  chain_name, vendor_id, is_non_food, is_darkstore, lead_data_origin,v.account_manager_name,order_flow_type,is_migrated_to_dh_menu from `tlb-data-prod.data_platform.dim_chain` c
        LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v USING (chain_id) ) c
        LEFT JOIN `tlb-data-dev.data_playground_grocery.qc_vendor_performance` a USING (vendor_id)
        LEFT JOIN `tlb-data-prod.data_platform.fct_adex_booking_cpc_performance_monthly` pc on a.vendor_id = pc.vendor_id and a.date = pc.date
        LEFT JOIN `tlb-data-prod.data_platform.fct_adex_booking_cpp_performance_monthly` pp on a.vendor_id = pp.vendor_id and a.date = pp.date
    WHERE
        a.date BETWEEN '2024-01-01' AND '2024-03-31'
        AND is_non_food
        AND NOT is_darkstore
        AND vertical = 'grocery'
        AND (lead_data_origin <<>> 'SS' or lead_data_origin is null)
    GROUP BY 1, 2, 3,4,5
)
SELECT
    date,
    country_code,
    vertical,
    CASE 
      WHEN chain_category = 'PP' THEN 'PP'
      WHEN chain_category = 'LB' THEN
        CASE
          WHEN country_code = 'AE' AND country_cumulative_gmv <<= 0.850 * (SELECT SUM(gmv) FROM chain_gmv cg WHERE cg.country_code = 'AE') THEN 'LB'
          WHEN country_code = 'BH' AND country_cumulative_gmv <<= 0.944 * (SELECT SUM(gmv) FROM chain_gmv cg WHERE cg.country_code = 'BH') THEN 'LB'
          WHEN country_code = 'EG' AND country_cumulative_gmv <<= 0.866 * (SELECT SUM(gmv) FROM chain_gmv cg WHERE cg.country_code = 'EG') THEN 'LB'
          WHEN country_code = 'JO' AND country_cumulative_gmv <<= 0.929 * (SELECT SUM(gmv) FROM chain_gmv cg WHERE cg.country_code = 'JO') THEN 'LB'
          WHEN country_code = 'KW' AND country_cumulative_gmv <<= 0.953 * (SELECT SUM(gmv) FROM chain_gmv cg WHERE cg.country_code = 'KW') THEN 'LB'
          WHEN country_code = 'OM' AND country_cumulative_gmv <<= 0.932 * (SELECT SUM(gmv) FROM chain_gmv cg WHERE cg.country_code = 'OM') THEN 'LB'
          WHEN country_code = 'QA' AND country_cumulative_gmv <<= 0.900 * (SELECT SUM(gmv) FROM chain_gmv cg WHERE cg.country_code = 'QA') THEN 'LB'
          ELSE 'LT'
        END
      ELSE 'LT'
    END AS chain_category,
    -- vertical AS chain_category,
    chain_name,
    account_manager_name,    
    is_migrated,
    gmv,
    gmv_eur,
    total_spu_discount,
    total_spu_gmv_eur,
    ncr_lc,
    ncr_eur,
    net_qty_ordered,        
    vendor_oos_failed_items,
    partially_fulfilled_orders_removed_items,
    failed_orders_due_to_vendor,
    net_orders,
    ncr_potential_percentile,
    CASE
        WHEN ncr_potential_percentile <<= 0.30 THEN 'High'
        WHEN ncr_potential_percentile <<= 0.70 THEN 'Medium'
        ELSE 'Low'
    END AS ncr_potential_category,

FROM
    chain_gmv

union all

select a.*, CASE
        WHEN ncr_potential_percentile <<= 0.30 THEN 'High'
        WHEN ncr_potential_percentile <<= 0.70 THEN 'Medium'
        ELSE 'Low'
    END AS ncr_potential_category from (
SELECT
        date_trunc(a.date, month) AS date ,
        c.country_code,
        vertical,
        vertical AS chain_category,
        c.chain_name,
        MAX(c.account_manager_name) as account_manager_name,
        MAX(CASE WHEN order_flow_type = 'Grocery' and is_migrated_to_dh_menu then true else false end) as is_migrated,
        COALESCE(SUM(delivered_lc), 0) AS gmv,
        COALESCE(SUM(delivered_gmv), 0) AS gmv_eur,
        COALESCE(SUM(total_spu_discount),0) as total_spu_discount,
        COALESCE(SUM(total_spu_gmv_eur),0) as total_spu_gmv_eur,
        COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else pc.revenue_lc end),0) + COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else suggested_price_lc end),0) as ncr_lc,
        COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else pc.revenue_eur end),0) + COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else suggested_price_eur end),0) as ncr_eur,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then net_qty_ordered end), 0) as net_qty_ordered,        
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then vendor_oos_total_failed_items end), 0) as vendor_oos_failed_items,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then partially_fulfilled_orders_removed_items end), 0) as partially_fulfilled_orders_removed_items,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then failed_orders_due_to_vendor end), 0) as failed_orders_due_to_vendor,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then net_orders end), 0) as net_orders,
        CASE when COALESCE(SUM(successful_orders),0)>>0 and COALESCE(SUM(delivered_lc),0)>>0 and COALESCE(SUM(transaction_sessions),0)>>0 and COALESCE(SUM(menu_sessions), 0) >>0 then
        PERCENT_RANK() OVER (PARTITION BY c.country_code, vertical ORDER BY ( CASE when COALESCE(SUM(successful_orders),0)>>0 and COALESCE(SUM(delivered_lc),0)>>0 and COALESCE(SUM(transaction_sessions),0)>>0 and COALESCE(SUM(menu_sessions), 0) >>0 then (COALESCE(SUM(delivered_lc),0) / COALESCE(SUM(successful_orders),0)) * (COALESCE(SUM(transaction_sessions), 0)/COALESCE(SUM(menu_sessions), 0))else 1 end) DESC) else 1 END 
         AS ncr_potential_percentile

FROM
        (select c.country_code, 
--         case when vertical = 'grocery' then 
--   case when lead_data_origin = 'PP' THEN 'Grocery - AAA' else 'Grocery - Non-AAA' end
--   ELSE vertical end as vertical, 
vertical,
  chain_name, vendor_id, is_non_food, is_darkstore, lead_data_origin,v.account_manager_name,order_flow_type,is_migrated_to_dh_menu from `tlb-data-prod.data_platform.dim_chain` c
        LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v USING (chain_id) ) c
        LEFT JOIN `tlb-data-dev.data_playground_grocery.qc_vendor_performance` a USING (vendor_id)
        LEFT JOIN `tlb-data-prod.data_platform.fct_adex_booking_cpc_performance_monthly` pc on a.vendor_id = pc.vendor_id and a.date = pc.date
        LEFT JOIN `tlb-data-prod.data_platform.fct_adex_booking_cpp_performance_monthly` pp on a.vendor_id = pp.vendor_id and a.date = pp.date
    WHERE
        a.date BETWEEN '2024-01-01' AND '2024-03-31'
        AND is_non_food
        AND NOT is_darkstore
        AND vertical <<>> 'grocery'
        group by 1,2,3,4,5) a


union all
select a.*, CASE
        WHEN ncr_potential_percentile <<= 0.30 THEN 'High'
        WHEN ncr_potential_percentile <<= 0.70 THEN 'Medium'
        ELSE 'Low'
    END AS ncr_potential_category from (
SELECT
        date_trunc(a.date, month) AS date ,
        c.country_code,
        "specialty stores" as vertical,
        vertical AS chain_category,
        c.chain_name,
        MAX(c.account_manager_name) as account_manager_name,
        MAX(CASE WHEN order_flow_type = 'Grocery' and is_migrated_to_dh_menu then true else false end) as is_migrated,
        COALESCE(SUM(delivered_lc), 0) AS gmv,
        COALESCE(SUM(delivered_gmv), 0) AS gmv_eur,
        COALESCE(SUM(total_spu_discount),0) as total_spu_discount,
        COALESCE(SUM(total_spu_gmv_eur),0) as total_spu_gmv_eur,
        COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else pc.revenue_lc end),0) + COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else suggested_price_lc end),0) as ncr_lc,
        COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else pc.revenue_eur end),0) + COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else suggested_price_eur end),0) as ncr_eur,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then net_qty_ordered end), 0) as net_qty_ordered,        
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then vendor_oos_total_failed_items end), 0) as vendor_oos_failed_items,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then partially_fulfilled_orders_removed_items end), 0) as partially_fulfilled_orders_removed_items,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then failed_orders_due_to_vendor end), 0) as failed_orders_due_to_vendor,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then net_orders end), 0) as net_orders,
        CASE when COALESCE(SUM(successful_orders),0)>>0 and COALESCE(SUM(delivered_lc),0)>>0 and COALESCE(SUM(transaction_sessions),0)>>0 and COALESCE(SUM(menu_sessions), 0) >>0 then
        PERCENT_RANK() OVER (PARTITION BY c.country_code, vertical ORDER BY ( CASE when COALESCE(SUM(successful_orders),0)>>0 and COALESCE(SUM(delivered_lc),0)>>0 and COALESCE(SUM(transaction_sessions),0)>>0 and COALESCE(SUM(menu_sessions), 0) >>0 then (COALESCE(SUM(delivered_lc),0) / COALESCE(SUM(successful_orders),0)) * (COALESCE(SUM(transaction_sessions), 0)/COALESCE(SUM(menu_sessions), 0))else 1 end) DESC) else 1 END 
         AS ncr_potential_percentile

FROM
        (select c.country_code, 
--         case when vertical = 'grocery' then 
--   case when lead_data_origin = 'PP' THEN 'Grocery - AAA' else 'Grocery - Non-AAA' end
--   ELSE vertical end as vertical, 
vertical,
  chain_name, vendor_id, is_non_food, is_darkstore, lead_data_origin,v.account_manager_name,order_flow_type,is_migrated_to_dh_menu from `tlb-data-prod.data_platform.dim_chain` c
        LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v USING (chain_id) ) c
        LEFT JOIN `tlb-data-dev.data_playground_grocery.qc_vendor_performance` a USING (vendor_id)
        LEFT JOIN `tlb-data-prod.data_platform.fct_adex_booking_cpc_performance_monthly` pc on a.vendor_id = pc.vendor_id and a.date = pc.date
        LEFT JOIN `tlb-data-prod.data_platform.fct_adex_booking_cpp_performance_monthly` pp on a.vendor_id = pp.vendor_id and a.date = pp.date
    WHERE
        a.date BETWEEN '2024-01-01' AND '2024-03-31'
        AND is_non_food
        AND NOT is_darkstore
        AND lead_data_origin = 'SS'
        group by 1,2,3,4,5) a)

select 
  d.date, 
  g.* except (date)
from date_data d
left join gmv_data g on d.date = g.date]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1neiyhj0izf40f1gj5b9h1pmu74n' name='Custom SQL Query' type='text'><![CDATA[with 
date_data as (
SELECT
    distinct
    date_trunc(date, month) AS date  
    FROM
      `tlb-data-prod.data_platform.dim_date`
    WHERE
      date BETWEEN '2024-01-01' AND '2024-03-31'),
gmv_data as (
WITH chain_gmv AS (
    SELECT
        date_trunc(a.date, month) AS date ,
        c.country_code,
        vertical,
        CASE 
            WHEN lead_data_origin = 'PP' THEN 'PP'
            ELSE 'LB'
        END AS chain_category,
        -- vertical AS chain_category,
        c.chain_name,
        MAX(c.account_manager_name) as account_manager_name,
        MAX(CASE WHEN order_flow_type = 'Grocery' and is_migrated_to_dh_menu then true else false end) as is_migrated,
        COALESCE(SUM(delivered_lc), 0) AS gmv,
        COALESCE(SUM(delivered_gmv), 0) AS gmv_eur,
        COALESCE(SUM(total_spu_discount),0) as total_spu_discount,
        COALESCE(SUM(total_spu_gmv_eur),0) as total_spu_gmv_eur,
        COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else pc.revenue_lc end),0) + COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else suggested_price_lc end),0) as ncr_lc,
        COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else pc.revenue_eur end),0) + COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else suggested_price_eur end),0) as ncr_eur,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then net_qty_ordered end), 0) as net_qty_ordered,        
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then vendor_oos_total_failed_items end), 0) as vendor_oos_failed_items,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then partially_fulfilled_orders_removed_items end), 0) as partially_fulfilled_orders_removed_items,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then failed_orders_due_to_vendor end), 0) as failed_orders_due_to_vendor,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then net_orders end), 0) as net_orders,
        SUM(COALESCE(SUM(ordered_gmv_elc), 0)) OVER (PARTITION BY c.country_code ORDER BY SUM(ordered_gmv_elc) DESC, c.chain_name) AS country_cumulative_gmv,
        CASE when COALESCE(SUM(successful_orders),0)>>0 and COALESCE(SUM(delivered_lc),0)>>0 and COALESCE(SUM(transaction_sessions),0)>>0 and COALESCE(SUM(menu_sessions), 0) >>0 then
        PERCENT_RANK() OVER (PARTITION BY c.country_code, vertical ORDER BY ( CASE when COALESCE(SUM(successful_orders),0)>>0 and COALESCE(SUM(delivered_lc),0)>>0 and COALESCE(SUM(transaction_sessions),0)>>0 and COALESCE(SUM(menu_sessions), 0) >>0 then (COALESCE(SUM(delivered_lc),0) / COALESCE(SUM(successful_orders),0)) * (COALESCE(SUM(transaction_sessions), 0)/COALESCE(SUM(menu_sessions), 0))else 1 end) DESC) else 1 END 
         AS ncr_potential_percentile

    FROM
        (select c.country_code, 
--         case when vertical = 'grocery' then 
--   case when lead_data_origin = 'PP' THEN 'Grocery - AAA' else 'Grocery - Non-AAA' end
--   ELSE vertical end as vertical, 
vertical,
  chain_name, vendor_id, is_non_food, is_darkstore, lead_data_origin,v.account_manager_name,order_flow_type,is_migrated_to_dh_menu from `tlb-data-prod.data_platform.dim_chain` c
        LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v USING (chain_id) ) c
        LEFT JOIN `tlb-data-dev.data_playground_grocery.qc_vendor_performance` a USING (vendor_id)
        LEFT JOIN `tlb-data-prod.data_platform.fct_adex_booking_cpc_performance_monthly` pc on a.vendor_id = pc.vendor_id and a.date = pc.date
        LEFT JOIN `tlb-data-prod.data_platform.fct_adex_booking_cpp_performance_monthly` pp on a.vendor_id = pp.vendor_id and a.date = pp.date
    WHERE
        a.date BETWEEN '2024-01-01' AND '2024-03-31'
        AND is_non_food
        AND NOT is_darkstore
        AND vertical = 'grocery'
        AND (lead_data_origin <<>> 'SS' or lead_data_origin is null)
    GROUP BY 1, 2, 3,4,5
)
SELECT
    date,
    country_code,
    vertical,
    CASE 
      WHEN chain_category = 'PP' THEN 'PP'
      WHEN chain_category = 'LB' THEN
        CASE
          WHEN country_code = 'AE' AND country_cumulative_gmv <<= 0.850 * (SELECT SUM(gmv) FROM chain_gmv cg WHERE cg.country_code = 'AE') THEN 'LB'
          WHEN country_code = 'BH' AND country_cumulative_gmv <<= 0.944 * (SELECT SUM(gmv) FROM chain_gmv cg WHERE cg.country_code = 'BH') THEN 'LB'
          WHEN country_code = 'EG' AND country_cumulative_gmv <<= 0.866 * (SELECT SUM(gmv) FROM chain_gmv cg WHERE cg.country_code = 'EG') THEN 'LB'
          WHEN country_code = 'JO' AND country_cumulative_gmv <<= 0.929 * (SELECT SUM(gmv) FROM chain_gmv cg WHERE cg.country_code = 'JO') THEN 'LB'
          WHEN country_code = 'KW' AND country_cumulative_gmv <<= 0.953 * (SELECT SUM(gmv) FROM chain_gmv cg WHERE cg.country_code = 'KW') THEN 'LB'
          WHEN country_code = 'OM' AND country_cumulative_gmv <<= 0.932 * (SELECT SUM(gmv) FROM chain_gmv cg WHERE cg.country_code = 'OM') THEN 'LB'
          WHEN country_code = 'QA' AND country_cumulative_gmv <<= 0.900 * (SELECT SUM(gmv) FROM chain_gmv cg WHERE cg.country_code = 'QA') THEN 'LB'
          ELSE 'LT'
        END
      ELSE 'LT'
    END AS chain_category,
    -- vertical AS chain_category,
    chain_name,
    account_manager_name,    
    is_migrated,
    gmv,
    gmv_eur,
    total_spu_discount,
    total_spu_gmv_eur,
    ncr_lc,
    ncr_eur,
    net_qty_ordered,        
    vendor_oos_failed_items,
    partially_fulfilled_orders_removed_items,
    failed_orders_due_to_vendor,
    net_orders,
    ncr_potential_percentile,
    CASE
        WHEN ncr_potential_percentile <<= 0.30 THEN 'High'
        WHEN ncr_potential_percentile <<= 0.70 THEN 'Medium'
        ELSE 'Low'
    END AS ncr_potential_category,

FROM
    chain_gmv

union all

select a.*, CASE
        WHEN ncr_potential_percentile <<= 0.30 THEN 'High'
        WHEN ncr_potential_percentile <<= 0.70 THEN 'Medium'
        ELSE 'Low'
    END AS ncr_potential_category from (
SELECT
        date_trunc(a.date, month) AS date ,
        c.country_code,
        vertical,
        vertical AS chain_category,
        c.chain_name,
        MAX(c.account_manager_name) as account_manager_name,
        MAX(CASE WHEN order_flow_type = 'Grocery' and is_migrated_to_dh_menu then true else false end) as is_migrated,
        COALESCE(SUM(delivered_lc), 0) AS gmv,
        COALESCE(SUM(delivered_gmv), 0) AS gmv_eur,
        COALESCE(SUM(total_spu_discount),0) as total_spu_discount,
        COALESCE(SUM(total_spu_gmv_eur),0) as total_spu_gmv_eur,
        COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else pc.revenue_lc end),0) + COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else suggested_price_lc end),0) as ncr_lc,
        COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else pc.revenue_eur end),0) + COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else suggested_price_eur end),0) as ncr_eur,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then net_qty_ordered end), 0) as net_qty_ordered,        
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then vendor_oos_total_failed_items end), 0) as vendor_oos_failed_items,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then partially_fulfilled_orders_removed_items end), 0) as partially_fulfilled_orders_removed_items,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then failed_orders_due_to_vendor end), 0) as failed_orders_due_to_vendor,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then net_orders end), 0) as net_orders,
        CASE when COALESCE(SUM(successful_orders),0)>>0 and COALESCE(SUM(delivered_lc),0)>>0 and COALESCE(SUM(transaction_sessions),0)>>0 and COALESCE(SUM(menu_sessions), 0) >>0 then
        PERCENT_RANK() OVER (PARTITION BY c.country_code, vertical ORDER BY ( CASE when COALESCE(SUM(successful_orders),0)>>0 and COALESCE(SUM(delivered_lc),0)>>0 and COALESCE(SUM(transaction_sessions),0)>>0 and COALESCE(SUM(menu_sessions), 0) >>0 then (COALESCE(SUM(delivered_lc),0) / COALESCE(SUM(successful_orders),0)) * (COALESCE(SUM(transaction_sessions), 0)/COALESCE(SUM(menu_sessions), 0))else 1 end) DESC) else 1 END 
         AS ncr_potential_percentile

FROM
        (select c.country_code, 
--         case when vertical = 'grocery' then 
--   case when lead_data_origin = 'PP' THEN 'Grocery - AAA' else 'Grocery - Non-AAA' end
--   ELSE vertical end as vertical, 
vertical,
  chain_name, vendor_id, is_non_food, is_darkstore, lead_data_origin,v.account_manager_name,order_flow_type,is_migrated_to_dh_menu from `tlb-data-prod.data_platform.dim_chain` c
        LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v USING (chain_id) ) c
        LEFT JOIN `tlb-data-dev.data_playground_grocery.qc_vendor_performance` a USING (vendor_id)
        LEFT JOIN `tlb-data-prod.data_platform.fct_adex_booking_cpc_performance_monthly` pc on a.vendor_id = pc.vendor_id and a.date = pc.date
        LEFT JOIN `tlb-data-prod.data_platform.fct_adex_booking_cpp_performance_monthly` pp on a.vendor_id = pp.vendor_id and a.date = pp.date
    WHERE
        a.date BETWEEN '2024-01-01' AND '2024-03-31'
        AND is_non_food
        AND NOT is_darkstore
        AND vertical <<>> 'grocery'
        group by 1,2,3,4,5) a


union all
select a.*, CASE
        WHEN ncr_potential_percentile <<= 0.30 THEN 'High'
        WHEN ncr_potential_percentile <<= 0.70 THEN 'Medium'
        ELSE 'Low'
    END AS ncr_potential_category from (
SELECT
        date_trunc(a.date, month) AS date ,
        c.country_code,
        "specialty stores" as vertical,
        vertical AS chain_category,
        c.chain_name,
        MAX(c.account_manager_name) as account_manager_name,
        MAX(CASE WHEN order_flow_type = 'Grocery' and is_migrated_to_dh_menu then true else false end) as is_migrated,
        COALESCE(SUM(delivered_lc), 0) AS gmv,
        COALESCE(SUM(delivered_gmv), 0) AS gmv_eur,
        COALESCE(SUM(total_spu_discount),0) as total_spu_discount,
        COALESCE(SUM(total_spu_gmv_eur),0) as total_spu_gmv_eur,
        COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else pc.revenue_lc end),0) + COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else suggested_price_lc end),0) as ncr_lc,
        COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else pc.revenue_eur end),0) + COALESCE(SUM(case when lead_data_origin = 'PP' then 0 else suggested_price_eur end),0) as ncr_eur,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then net_qty_ordered end), 0) as net_qty_ordered,        
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then vendor_oos_total_failed_items end), 0) as vendor_oos_failed_items,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then partially_fulfilled_orders_removed_items end), 0) as partially_fulfilled_orders_removed_items,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then failed_orders_due_to_vendor end), 0) as failed_orders_due_to_vendor,
        COALESCE(SUM(case when a.date BETWEEN '2024-10-01' AND '2024-10-31' then net_orders end), 0) as net_orders,
        CASE when COALESCE(SUM(successful_orders),0)>>0 and COALESCE(SUM(delivered_lc),0)>>0 and COALESCE(SUM(transaction_sessions),0)>>0 and COALESCE(SUM(menu_sessions), 0) >>0 then
        PERCENT_RANK() OVER (PARTITION BY c.country_code, vertical ORDER BY ( CASE when COALESCE(SUM(successful_orders),0)>>0 and COALESCE(SUM(delivered_lc),0)>>0 and COALESCE(SUM(transaction_sessions),0)>>0 and COALESCE(SUM(menu_sessions), 0) >>0 then (COALESCE(SUM(delivered_lc),0) / COALESCE(SUM(successful_orders),0)) * (COALESCE(SUM(transaction_sessions), 0)/COALESCE(SUM(menu_sessions), 0))else 1 end) DESC) else 1 END 
         AS ncr_potential_percentile

FROM
        (select c.country_code, 
--         case when vertical = 'grocery' then 
--   case when lead_data_origin = 'PP' THEN 'Grocery - AAA' else 'Grocery - Non-AAA' end
--   ELSE vertical end as vertical, 
vertical,
  chain_name, vendor_id, is_non_food, is_darkstore, lead_data_origin,v.account_manager_name,order_flow_type,is_migrated_to_dh_menu from `tlb-data-prod.data_platform.dim_chain` c
        LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v USING (chain_id) ) c
        LEFT JOIN `tlb-data-dev.data_playground_grocery.qc_vendor_performance` a USING (vendor_id)
        LEFT JOIN `tlb-data-prod.data_platform.fct_adex_booking_cpc_performance_monthly` pc on a.vendor_id = pc.vendor_id and a.date = pc.date
        LEFT JOIN `tlb-data-prod.data_platform.fct_adex_booking_cpp_performance_monthly` pp on a.vendor_id = pp.vendor_id and a.date = pp.date
    WHERE
        a.date BETWEEN '2024-01-01' AND '2024-03-31'
        AND is_non_food
        AND NOT is_darkstore
        AND lead_data_origin = 'SS'
        group by 1,2,3,4,5) a)

select 
  d.date, 
  g.* except (date)
from date_data d
left join gmv_data g on d.date = g.date]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
