      </column>
      <column caption='Category_new' datatype='string' name='[Calculation_6064730259423223808]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [chain_category] IN (&apos;LB&apos;, &apos;LT&apos;, &apos;PP&apos;) THEN &apos;grocery&apos; ELSE [chain_category] END' />
