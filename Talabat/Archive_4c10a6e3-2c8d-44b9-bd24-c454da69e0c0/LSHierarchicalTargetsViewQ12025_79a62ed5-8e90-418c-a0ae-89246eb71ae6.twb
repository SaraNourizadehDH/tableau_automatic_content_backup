        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='cloudfile:googledrive-excel-direct.11558g60ddgihr1891wxw059p5fc' name='Inputs.vertical' table='[Inputs#vertical$]' type='table'>
          <columns gridOrigin='A1:Q169:no:A1:Q169:0' header='yes' outcome='2'>
