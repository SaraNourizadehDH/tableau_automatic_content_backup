            <column caption='Offenders' datatype='integer' name='[Calculation_4121356632415145989]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF {FIXED [city_name], [zone_name], [day],[rider_id]: sum([UTR])&gt;[Parameters].[Parameter 1]}&#10;and {FIXED [city_name], [zone_name], [day],[rider_id]: [Calculation_6778761887476150282]&lt;[Parameters].[Parameter 2]} &#10;and {FIXED [city_name], [zone_name], [day],[rider_id]: sum([wh])&gt;[Parameters].[Parameter 3]}&#10;and {FIXED [city_name], [zone_name], [day],[rider_id]: sum([breaks_intitated])&gt;[Parameters].[Parameter 4]}&#10;&#10;THEN [rider_id] end)' />
            </column>
            <column caption='% Offenders' datatype='real' name='[Calculation_4121356632417775622]' role='measure' type='quantitative'>
