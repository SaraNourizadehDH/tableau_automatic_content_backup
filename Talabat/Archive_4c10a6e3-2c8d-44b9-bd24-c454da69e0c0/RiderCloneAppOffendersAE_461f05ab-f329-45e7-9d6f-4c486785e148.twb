      <datasource-dependencies datasource='Parameters'>
        <column caption='UTR  Greater Than' datatype='real' datatype-customized='true' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='1.7'>
          <calculation class='tableau' formula='1.7' />
        </column>
        <column caption='DO  Lower Than' datatype='real' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='3.'>
          <calculation class='tableau' formula='3.' />
        </column>
        <column caption='WH  Greater Than' datatype='real' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='4.'>
          <calculation class='tableau' formula='4.' />
        </column>
        <column caption='#Break Greater Than' datatype='real' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='4.'>
          <calculation class='tableau' formula='4.' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_31EF2F1EF5EC4C8FADDECA368950A5DB'>
            <properties context=''>
              <relation connection='bigquery.0dy1xob02zcncw1f9m83g0nksd77' name='Custom SQL Query' type='text'><![CDATA[with riders as 
(
    select city_name, day, 
    rider_id,
    rider_name,
    last_contract_name,
    zone_id,
    zone_name,
    sum(wh) as wh from
(
    SELECT
    s.rider_id  AS rider_id,
    r.rider_name  AS rider_name,
    r.last_contract_name  AS last_contract_name,
    c.city_name  AS city_name,
    sp.sp_name  AS sp_name,
    s.zone_id,
    zone_name,
    date(s.shift_start_at, "Asia/Dubai") AS day,
    (CASE WHEN r.is_active  THEN 'Yes' ELSE 'No' END) AS is_active,
    -- SUM(s.actual_working_time/60) AS actual_working_time_hrs,
    datetime_diff(datetime(s.actual_end_at,"Asia/Dubai") ,datetime(s.actual_start_at,"Asia/Dubai"),minute)/60 as wh
FROM `tlb-data-prod.data_platform.fct_logistics_rider_shift` AS s
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_city` AS c ON s.country_code = c.country_code and s.city_id = c.city_id
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_rider`  AS r ON s.country_code = r.country_code and s.rider_id = r.rider_id
LEFT JOIN `tlb-data-prod.data_platform.dim_logistics_starting_point` AS sp ON s.country_code = sp.country_code and s.sp_id = sp.sp_id
left join (select zone_id, zone_name from `tlb-data-prod.data_platform.dim_logistics_zone` where country_code = 'ae') z on z.zone_id = s.zone_id 
-- inner join report_dates dt on datetime(s.shift_start_at, "Asia/Dubai") << dt.end_datetime and dt.start_datetime << datetime(s.shift_end_at, "Asia/Dubai") 
WHERE  date(s.shift_start_at, "Asia/Dubai") >>= current_date-60
and  date(s.shift_start_at, "Asia/Dubai") << current_date
AND upper(s.country_code) = 'AE'
and s.shift_state = 'EVALUATED'
-- and c.city_name = 'Dubai'
and r.is_active
-- and s.rider_id = 1913576

) group by 1,2,3,4,5,6,7
),


orders as 
(
    select 
city_name
,primary_rider_id as rider_id
,o.zone_id
,date(o.created_at, o.timezone) as day
,count(distinct case when order_status = 'completed' then order_code end) as orders
,sum(primary_dropoff_distance_manhattan/1000) as dropp_off
,count(distinct case when primary_dropoff_distance_manhattan/1000 is not null then order_code end) as dropp_off_orders
,sum(primary_pickup_distance_manhattan/1000) as pickup
,count(distinct case when primary_pickup_distance_manhattan/1000 is not null then order_code end) as pickup_orders
from `tlb-data-prod.data_platform.fct_logistics_order` o
inner join `tlb-data-prod.data_platform.dim_logistics_city` c on c.city_id = o.city_id and c.country_code=o.country_code
inner join (select zone_id, zone_name from `tlb-data-prod.data_platform.dim_logistics_zone` where country_code = 'ae') z on z.zone_id = o.zone_id 
where is_rider_order
and date(o.created_at, o.timezone) >>= current_date-60
-- and o.city_id = 1
group by 1,2,3,4
),

breaks as 
(
  select date(break_start_at,timezone) as day
    ,rider_id
    ,zone_id
    ,sum(case when break_duration is not null then 1 else 0 end) as breaks_intitated
    ,round(sum(break_duration/60),3) as break_mins
  from tlb-data-prod.data_platform.fct_logistics_rider_break
  where country_code = 'ae'
  and date(break_start_at,timezone) >>= current_date-60
  -- and rider_id = 825432
  group by 1,2,3


)


select r.city_name
,r.day
,r.rider_id
,rider_name
,last_contract_name
,zone_name
,wh
,breaks_intitated
,break_mins
,orders
,dropp_off
,dropp_off_orders
,pickup
,pickup_orders
,safe_divide(orders,wh) as UTR
from riders r
left join orders o on r.rider_id = o.rider_id and o.day=r.day and r.zone_id=o.zone_id
left join breaks b on b.day=r.day and r.zone_id=b.zone_id and r.rider_id = b.rider_id]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='3PL Wise Offenders'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1gdbsfc1c0reb51dijyb412pxxlj' />
