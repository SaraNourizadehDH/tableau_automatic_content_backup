FROM `tlb-data-dev.vendor_analytics`.`qualtrics_vsat_export_data` `qualtrics_vsat_export_data` 
)

 select distinct 
  account_manager_name,
  m.manager_full_name__c,
  m.manager_email__c, 
e.*,
 
from base e
LEFT JOIN
  `tlb-data-prod.data_platform.dim_vendor_info` i
ON
  TRIM(e.combined_am_name) = i.account_manager_name
  --and e.country_code=i.country_code
LEFT JOIN
  `fulfillment-dwh-production.curated_data_shared_salesforce.user` u
ON
  u.id = i.account_manager_id and u.isactive
LEFT JOIN
  `fulfillment-dwh-production.curated_data_shared_salesforce.user` m
ON
  m.id = u.managerid and u.isactive
WHERE
 combined_am_name IS NOT null
  --and combined_am_name = &apos;Eman Abedi&apos;</relation>
