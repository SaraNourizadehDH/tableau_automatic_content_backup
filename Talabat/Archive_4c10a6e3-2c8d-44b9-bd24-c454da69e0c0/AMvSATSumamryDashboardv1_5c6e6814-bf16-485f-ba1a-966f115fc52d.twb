      <aliases enabled='yes' />
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1368249927221915648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='Default Start Date' datatype='date' name='[Calculation_141159753770070017]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY() - 100' />
      </column>
      <column caption='Default End Date' datatype='date' name='[Calculation_141159753770139650]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY() - 1' />
      </column>
      <column caption='Date Range' datatype='string' name='[Calculation_141159753770352643]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  &#10;[Order Date] &gt;= [Parameters].[Parameter 3]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 3], [Parameters].[Parameter 4])+1)&#10;and [Order Date] &lt;= [Parameters].[Parameter 4]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 3], [Parameters].[Parameter 4])+1)&#10;then &quot;Comparison Period&quot; &#10;&#10;ELSEIF &#10;[Order Date] &gt;= [Parameters].[Parameter 3] and [Order Date] &lt;= [Parameters].[Parameter 4]&#10;then &apos;Selected Period&apos; &#10;&#10;ELSE &apos;Remaining Days&apos;&#10;&#10;END' />
      </column>
      <column caption='Hide Null Column' datatype='boolean' name='[Calculation_141159753770430468]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX() != 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Selected Metric' datatype='real' name='[Calculation_141159753786257414]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#10;WHEN &apos;Orders&apos; THEN COUNT([__tableau_internal_object_id__].[Orders_ECFCA1FB690A41FE803BC071773BA862])&#10;WHEN &apos;Quantity&apos; THEN SUM([Quantity])&#10;WHEN &apos;Sales&apos; THEN SUM([Sales])&#10;WHEN &apos;Profit&apos; THEN SUM([Profit])&#10;WHEN &apos;Discount&apos; THEN SUM([Discount])&#10;END' />
      </column>
      <column caption='Select Dimension' datatype='string' name='[Calculation_141159753789267975]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#10;WHEN &apos;Sub Category&apos; THEN [Sub-Category]&#10;WHEN &apos;Segment&apos; THEN [Segment]&#10;WHEN &apos;Region&apos; THEN [Region]&#10;END' />
      </column>
      <column caption='Profit Ratio (Remaining)' datatype='real' name='[Calculation_141159753792593929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [Calculation_1368249927221915648]' />
      </column>
      <column caption='Show Profit Ratio?' datatype='real' name='[Calculation_141159753796579341]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 7] = TRUE then [Calculation_1368249927221915648] ELSE NULL end' />
      </column>
