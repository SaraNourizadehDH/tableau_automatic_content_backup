    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Dashboard 1'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/DashboardTemplate/Dashboard1?rev=' id='Dashboard1' path='/t/Talabat/workbooks/DashboardTemplate' revision='' site='Talabat' />
      <style>
        <style-rule element='dash-subtitle'>
          <format attr='font-size' value='12' />
          <format attr='font-weight' value='bold' />
          <format attr='background-color' value='#e6e6e6' />
        </style-rule>
      </style>
      <size maxheight='1300' maxwidth='1900' minheight='1300' minwidth='1900' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource name='Sample - Superstore' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Start Date' datatype='date' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2023-12-01#'>
          <calculation class='tableau' formula='#2023-12-01#' />
        </column>
        <column caption='End Date' datatype='date' name='[Parameter 4]' param-domain-type='any' role='measure' type='quantitative' value='#2023-12-31#'>
          <calculation class='tableau' formula='#2023-12-31#' />
        </column>
        <column alias='# of meetings' caption='Select Metric' datatype='string' name='[Parameter 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;meetings&quot;'>
          <calculation class='tableau' formula='&quot;meetings&quot;' />
          <aliases>
            <alias key='&quot;accessible&quot;' value='Accessability' />
            <alias key='&quot;aware&quot;' value='Awareness' />
            <alias key='&quot;grow&quot;' value='Growth' />
            <alias key='&quot;meetings&quot;' value='# of meetings' />
            <alias key='&quot;Overall_score&quot;' value='Overall Score' />
            <alias key='&quot;vsat&quot;' value='AmVsat' />
          </aliases>
          <members>
            <member alias='Accessability' value='&quot;accessible&quot;' />
            <member alias='Awareness' value='&quot;aware&quot;' />
            <member alias='Growth' value='&quot;grow&quot;' />
            <member alias='# of meetings' value='&quot;meetings&quot;' />
            <member alias='AmVsat' value='&quot;vsat&quot;' />
            <member alias='Overall Score' value='&quot;Overall_score&quot;' />
          </members>
        </column>
        <column caption='Change Dimension' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Region&quot;'>
          <calculation class='tableau' formula='&quot;Region&quot;' />
          <members>
            <member value='&quot;Sub Category&quot;' />
            <member value='&quot;Segment&quot;' />
            <member value='&quot;Region&quot;' />
          </members>
        </column>
        <column caption='Show Profit Ratio' datatype='boolean' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='false'>
          <calculation class='tableau' formula='false' />
          <members>
            <member value='true' />
            <member value='false' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='Sample - Superstore'>
        <column datatype='string' name='[Country/Region]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
        <column aggregate-role-from='[State/Province]' datatype='string' name='[Region]' role='dimension' type='nominal' />
        <column datatype='string' name='[Segment]' role='dimension' type='nominal' />
        <column-instance column='[Country/Region]' derivation='None' name='[none:Country/Region:nk]' pivot='key' type='nominal' />
        <column-instance column='[Region]' derivation='None' name='[none:Region:nk]' pivot='key' type='nominal' />
        <column-instance column='[Segment]' derivation='None' name='[none:Segment:nk]' pivot='key' type='nominal' />
