    <worksheet name='AM'>
      <table>
        <view>
          <datasources>
            <datasource caption='qualtrics_vsat_export_data (vendor_analytics)' name='federated.1n1h2ck1eercsi13655bq12m55th' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Validitiy Threshold' datatype='integer' name='[Parameter 2 1]' param-domain-type='range' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <range granularity='1' min='0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1n1h2ck1eercsi13655bq12m55th'>
            <column caption='Validity' datatype='boolean' name='[Calculation_2014305318248054784]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_4335066501064548353] &gt;= [Parameters].[Parameter 2 1] then TRUE ELSE FALSE END' />
            </column>
            <column caption='overall_score' datatype='real' name='[Calculation_2014305318268403713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(AVG([aware_score])+&#10;AVG([amvsat_cleaned])+&#10;AVG([accessible_cleaned])+&#10;AVG([grow_cleaned])+&#10;AVG([meetings_cleaned]))&#10;/5' />
            </column>
            <column caption='#Survey Responses' datatype='integer' default-format='N' name='[Calculation_4335066501064548353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF  [is_complete_aware_survery] then [Response_ID] END)' />
            </column>
            <column caption='Response Rate' datatype='real' default-format='p0.00%' name='[Calculation_4335066501069230082]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4335066501064548353]/SUM([am_target_brands (input_list_master_data_am_target)])' />
            </column>
            <column caption='Survey Name' datatype='string' name='[Calculation_6226648720045682689]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&apos;April Survey&apos;' />
            </column>
            <column caption='Country' datatype='string' name='[Country_of_the_account]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Response ID' datatype='string' name='[Response_ID]' role='dimension' type='nominal' />
            <column aggregation='Avg' datatype='integer' datatype-customized='true' name='[accessible_cleaned]' role='measure' type='quantitative' />
            <column caption='Am Target Brands (Input List Master Data Am Target)' datatype='integer' default-format='N' name='[am_target_brands (input_list_master_data_am_target)]' role='measure' type='quantitative' />
            <column datatype='integer' datatype-customized='true' name='[amvsat_cleaned]' role='measure' type='quantitative' />
            <column-instance column='[accessible_cleaned]' derivation='Avg' name='[avg:accessible_cleaned:qk]' pivot='key' type='quantitative' />
            <column-instance column='[amvsat_cleaned]' derivation='Avg' name='[avg:amvsat_cleaned:qk]' pivot='key' type='quantitative' />
            <column-instance column='[aware_score]' derivation='Avg' name='[avg:aware_score:qk]' pivot='key' type='quantitative' />
            <column-instance column='[grow_cleaned]' derivation='Avg' name='[avg:grow_cleaned:qk]' pivot='key' type='quantitative' />
            <column-instance column='[meetings_cleaned]' derivation='Avg' name='[avg:meetings_cleaned:qk]' pivot='key' type='quantitative' />
