    <worksheet name='Sheet 4'>
      <table>
        <view>
          <datasources>
            <datasource caption='qualtrics_vsat_export_data (vendor_analytics)' name='federated.1n1h2ck1eercsi13655bq12m55th' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Share of Surveys' caption='View By' datatype='string' name='[Parameter 1 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;2&quot;'>
              <calculation class='tableau' formula='&quot;2&quot;' />
              <aliases>
                <alias key='&quot;0&quot;' value='Response Rate' />
                <alias key='&quot;2&quot;' value='Share of Surveys' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1n1h2ck1eercsi13655bq12m55th'>
            <column caption='#Surveys' datatype='integer' default-format='N' name='[Calculation_4335066501057482752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Response_ID])' />
            </column>
            <column caption='#Survey Responses' datatype='integer' default-format='N' name='[Calculation_4335066501064548353]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF  [is_complete_aware_survery] then [Response_ID] END)' />
            </column>
            <column caption='Response Rate' datatype='real' default-format='p0.00%' name='[Calculation_4335066501069230082]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4335066501064548353]/SUM([am_target_brands (input_list_master_data_am_target)])' />
            </column>
            <column caption='#AMs' datatype='integer' name='[Calculation_4335066501072445444]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([combined_am_name])' />
            </column>
            <column caption='Viable AMs' datatype='integer' default-format='N' name='[Calculation_4335066501125963782]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countD(IF [is_complete_amvsat_survery] then [combined_am_name] END)' />
            </column>
            <column caption='AM Coverage Rate' datatype='real' default-format='p0.00%' name='[Calculation_4335066501138038794]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4335066501125963782]/[Calculation_4335066501072445444]' />
            </column>
            <column caption='View By' datatype='real' default-format='p0.00%' name='[Calculation_4335066501139922955]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1 1] = &apos;0&apos; THEN [Calculation_4335066501069230082] &#10;ELSEIF [Parameters].[Parameter 1 1] = &apos;1&apos; THEN [Calculation_4335066501138038794]&#10;ELSEIF [Parameters].[Parameter 1 1] = &apos;2&apos; THEN [Calculation_4335066501146009612]&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='%Share of Survey' datatype='real' default-format='p0.00%' name='[Calculation_4335066501146009612]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_4335066501057482752] / TOTAL([Calculation_4335066501057482752])'>
                <table-calc ordering-type='Rows' />
