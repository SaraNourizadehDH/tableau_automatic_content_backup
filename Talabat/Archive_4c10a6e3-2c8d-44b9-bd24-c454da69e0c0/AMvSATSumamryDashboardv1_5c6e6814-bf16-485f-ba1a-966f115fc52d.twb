    <worksheet name='Vendors Ratings segmentation ( meetings )'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='10'>Chains Ratings on</run>
            <run fontcolor='#f28e2b' fontsize='10'> Meetings </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='AM portflio' name='federated.1ojezp51dh5wps16ypguq1dxsggv' />
          </datasources>
          <datasource-dependencies datasource='federated.1ojezp51dh5wps16ypguq1dxsggv'>
            <column caption='Meetings 1 to 2 ' datatype='integer' name='[Calculation_6950743094022369293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( if ([meetings]) &gt;= 1 and [meetings] &lt; 2 then [chain_name] end)' />
            </column>
            <column caption='Vendors denom' datatype='integer' name='[Calculation_6950743094022549518]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{fixed [country_code]:COUNTD([chain_name])}' />
            </column>
            <column caption='Meeting 1 to 2 percent' datatype='real' name='[Calculation_6950743094022864912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6950743094022369293]/sum([Calculation_6950743094022549518])' />
            </column>
            <column caption='Meetings 2 to 3 ' datatype='integer' name='[Calculation_6950743094025543697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( if ([meetings]) &gt;=2 and [meetings] &lt; 3 then [chain_name] end)' />
            </column>
            <column caption='meetings 3 to 4 ' datatype='integer' name='[Calculation_6950743094025658386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( if ([meetings]) &gt;=3 and [meetings] &lt; 4 then [chain_name] end)' />
            </column>
            <column caption='meetings &gt; 4 ' datatype='integer' name='[Calculation_6950743094025773075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([chain_name])-[Calculation_6950743094022369293]-[Calculation_6950743094025543697]-[Calculation_6950743094025658386]' />
            </column>
            <column caption='Meeting 2 to 3 percent' datatype='real' name='[Calculation_6950743094027419675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6950743094025543697]/ sum([Calculation_6950743094022549518])' />
            </column>
            <column caption='Meeting 3 to 4 percent' datatype='real' name='[Calculation_6950743094027530268]' role='measure' type='quantitative'>
