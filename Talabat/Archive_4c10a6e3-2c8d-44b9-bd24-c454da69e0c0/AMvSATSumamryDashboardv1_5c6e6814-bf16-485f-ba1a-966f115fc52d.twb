      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column alias='Overall Score' caption='select metric' datatype='string' name='[Change Dimension (copy)]' param-domain-type='list' role='measure' type='nominal' value='&quot;overall_score&quot;'>
          <calculation class='tableau' formula='&quot;overall_score&quot;' />
          <aliases>
            <alias key='&quot;accessible_cleaned&quot;' value='Accessability' />
            <alias key='&quot;aware_score&quot;' value='Awareness' />
            <alias key='&quot;grow_cleaned&quot;' value='Growth' />
            <alias key='&quot;meetings_cleaned&quot;' value='Meetings' />
            <alias key='&quot;overall_score&quot;' value='Overall Score' />
          </aliases>
          <members>
            <member alias='Awareness' value='&quot;aware_score&quot;' />
            <member alias='Accessability' value='&quot;accessible_cleaned&quot;' />
            <member alias='Growth' value='&quot;grow_cleaned&quot;' />
            <member alias='Meetings' value='&quot;meetings_cleaned&quot;' />
            <member alias='Overall Score' value='&quot;overall_score&quot;' />
          </members>
        </column>
        <column caption='Top N AMs' datatype='integer' name='[Parameter 12]' param-domain-type='range' role='measure' type='quantitative' value='10'>
          <calculation class='tableau' formula='10' />
          <range max='100' min='1' />
        </column>
        <column caption='Bottom N AMs' datatype='integer' name='[Parameter 13]' param-domain-type='range' role='measure' type='quantitative' value='10'>
          <calculation class='tableau' formula='10' />
          <range max='100' min='1' />
