            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='ali.anees@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0rvr99l0lp5s7j1g0ic0i07g43qv' name='Custom SQL Query' type='text'>WITH DATA AS (
  SELECT
    DISTINCT
    -- *,
    combined_am_name,
    Account_Details___Chain_ID,
    Account_Details___Vendor_ID,
    vendor_id,
    vsat_cleaned,
    amvsat_cleaned,
    aware_score,
    accessible_cleaned,
    grow_cleaned,
    meetings_cleaned,
    is_complete_amvsat_survery,
    response_id
  FROM
    `tlb-data-dev.vendor_analytics.qualtrics_vsat_export_data`,
    UNNEST(SPLIT( Account_Details___Vendor_ID)) vendor_id
  -- WHERE
    -- combined_am_name = &apos;Kavya R&apos;
    where is_complete_amvsat_survery

    -- GROUP BY
    --   1,
    --   2,
    --   3
    )
 


, measures as (
SELECT
 c.chain_Name as chain_name,
   d.combined_am_name,
i.country_code,
  -- i.vendor_id,
  -- i.chain_id,
  -- i2.chain_id,
  count(distinct response_id) as responses,
  AVG(CAST(amvsat_cleaned AS int64)) vsat,
  AVG(CAST(vsat_cleaned AS int64)) vsat_talabat,
  AVG(aware_score) aware,
  AVG(CAST(accessible_cleaned AS int64)) accessible,
  AVG(CAST(grow_cleaned AS int64)) grow,
  AVG(CAST(meetings_cleaned AS int64)) meetings,

  (AVG(CAST(amvsat_cleaned AS int64)) +
  AVG(CAST(accessible_cleaned AS int64)) +
  AVG(CAST(grow_cleaned AS int64)) +
  AVG(aware_score)+
  AVG(CAST(meetings_cleaned AS int64)))/5 as Overall_score,
FROM
  DATA d
LEFT JOIN
  `tlb-data-prod.data_platform.dim_vendor_info` i
ON
  TRIM(d.vendor_id) = CAST(i.vendor_id AS string)
LEFT JOIN
  `tlb-data-prod.data_platform.dim_chain` c
ON
  c.chain_id = i.chain_id

GROUP BY
  1,
  2 ,
  3
) 


, rank_am_level as (
 -- rank am on country level based on overall score 
  select 
distinct *,
dense_rank() over (partition by country_code order by general_overall_score desc ) as rank_overall_per_country,
 dense_rank () over(order by  general_overall_score desc) as rank_overall,
count(distinct combined_am_name) over (partition by country_code) as total_am_numbers_per_country,
count(distinct combined_am_name) over () as total_am_numbers_overall
from
(
select combined_am_name
,country_code,
sum(responses) as responses,
AVG(overall_score) as General_overall_score,
AVG(vsat) vsat,
  AVG(vsat_talabat) vsat_talabt,
  AVG(aware) aware,
  AVG(accessible) accessible,
  AVG(grow) grow,
  AVG(meetings) meetings
   from measures m
  where combined_am_name is not  null
  group by 1,2 
)a 

) 

,

  AM_Details as (

  select  distinct i.account_manager_id,
  account_manager_name,
  u.managerid,
  m.manager_full_name__c,
  m.manager_email__c, 
  e.*  from rank_am_level e
 

LEFT JOIN
  `tlb-data-prod.data_platform.dim_vendor_info` i
ON
  TRIM(e.combined_am_name) = i.account_manager_name
  --and e.country_code=i.country_code
LEFT JOIN
  `fulfillment-dwh-production.curated_data_shared_salesforce.user` u
ON
  u.id = i.account_manager_id
LEFT JOIN
  `fulfillment-dwh-production.curated_data_shared_salesforce.user` m
ON
  m.id = u.managerid
WHERE
  combined_am_name IS NOT null
  --and combined_am_name = &apos;Eman Abedi&apos;
 and is_active
  )  --select * from am_details



 ,chain_level as (
select distinct l.* except(combined_am_name,country_code,vsat,vsat_talabt,aware,accessible,grow,meetings)
 , m.* except (responses)
 from AM_Details l 
  join measures m on l.combined_am_name=m.combined_am_name
  and l.country_code=m.country_code
     -- where l.combined_am_name = &apos;Eman Abedi&apos;


 )



 , chain_orders as (
      select chain_name, 
      coalesce(count(distinct order_id),0) as orders 
      from `tlb-data-prod.data_platform.fct_order_info` f 
      left join `tlb-data-dev.data_platform.dim_vendor_info` v on f.vendor_id=v.vendor_id
      left join `tlb-data-prod.data_platform.dim_chain` ch 
      on v.chain_id=ch.chain_id 

      where f.order_date &gt;&gt;= current_date - interval &apos;6&apos; month

     -- and chain_name=&apos;Sd Go3ak&apos;
      group by 1
      --having orders &gt;&gt;0
      )
 
,
input_list 
as (
SELECT `input_list_master_data_am_target`.`account_manager_name` AS `account_manager_name`,
  `input_list_master_data_am_target`.`am_target_brands` AS `am_target_brands__input_list_master_data_am_target_`
FROM `tlb-data-dev.vendor_analytics`.`input_list_master_data_am_target` `input_list_master_data_am_target`
--where account_manager_name=&apos;Abdallah Hamdan&apos;

)
 
 select distinct ch.*,
  o.orders,
  l.`am_target_brands__input_list_master_data_am_target_`,
  rank() over(partition by combined_am_name, country_code order by ch.chain_name  ) as rank
   from chain_level ch 
 left join chain_orders o on ch.chain_name = o.chain_name
 left join input_list l on l.account_manager_name=ch.combined_am_name 
--where  o.orders is not null</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
