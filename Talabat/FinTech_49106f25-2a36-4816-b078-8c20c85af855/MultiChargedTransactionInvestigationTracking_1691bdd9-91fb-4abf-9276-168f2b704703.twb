        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.00ozy2202fc2da1g1fg0k1fyrpcj' name='Custom SQL Query' type='text'><![CDATA[-- 1. get all the orders where we have more than 1 capture
-- 2. check transactions having same capture amount
-- 3. exclude the orders where 2nd capture = upward modification >>>>>> quantification of issue for tech team
-- 4. Successful / Non Successful
-- 5. Number of additional captures
-- 6. take orders where we had net_discrepancy (only -ve) >>= capture amount


-- create or replace table `tlb-data-dev.data_playground_finance.temp_multi_charge_investigation_data_31oct2024`
-- as 
with psp_multiple_captures as
(select 
  backend_reference
  ,count(distinct payment_id) 
from `tlb-data-prod.data_platform.fct_payment_gateway_transaction`
where is_psp_data
and date(payment_time_utc) >>='2023-01-01'
and has_approved_authorisation
and has_approved_capture
and coalesce(capture_amount,0)>>0
group by all having count(distinct payment_id)>>1
order by 2 desc)

,distinct_payment_id as
(
select 
t1.*
,row_number() over(partition by payment_id,capture_amount order by payment_time_utc,transaction_type) as rnk_payment_id
from `tlb-data-prod.data_platform.fct_payment_gateway_transaction`t1
where 
date(payment_time_utc) >>='2023-01-01'
-- and date(payment_time_utc) <<='2024-08-31'
and backend_reference in (select distinct backend_reference from psp_multiple_captures)
and coalesce(capture_amount,0)>>0
and has_approved_authorisation
and is_psp_data
-- and coalesce(capture_amount,0) <<>> coalesce(refund_amount,0)
-- backend_reference in ('1472969478')
)


,psp as
(
select 
  date_trunc(date(payment_time_utc),month) as month
  ,country_code
  ,transaction_type
  ,backend_reference as reference
  ,payment_id
  ,payment_time_utc
  ,capture_amount
  ,source_name
-- ,lead(capture_amount) over(partition by backend_reference,capture_amount order by payment_time_utc) capture_n
,row_number() over(partition by backend_reference,capture_amount order by is_backend_data desc,payment_time_utc) as payment_number_per_order

from distinct_payment_id
where rnk_payment_id = 1
-- and backend_reference in ('1445572535')
-- and backend_reference in ('1472969478')
-- and backend_reference in ('f39e39f6-6c7b-475b-9121-ee1927338ce2')
-- and backend_reference in ('1467792048')

-- group by all 
order by capture_amount, payment_number_per_order

)


,final_data as
(
select 
t1.* 
-- ,case when t1.payment_number_per_order = 1 then false else true end as refund_needed
-- ,t2.country_code
," >>>> reco columns >>>> " as reco_columns
,t2.order_id
,t2.transaction_id
,t2.account_id
,t2.filtration_date
,t2.order_status
,t2.is_apple_pay
,t2.is_modified_after_delivery
,t2.is_cancelled_after_delivery
,t2.payment_method
,t2.reconciliation_source
-- ,t2.source_name
,t2.gmv_amount_lc
,t2.original_gmv_amount_lc
,t2.modification_original_gmv_amount_lc
,t2.tgo_modification_gmv_added_amount_lc
,t2.tmp_modification_gmv_added_amount_lc
,t2.modification_gmv_removed_amount_lc
,t2.rider_tip_checkout_amount_lc
,t2.paid_by_cc_fee_amount_lc
,t2.paid_by_knet_fee_amount_lc
,t2.paid_by_cash_fee_amount_lc
,t2.paid_by_talabat_fee_amount_lc
,t2.wallet_captured_tcredit_count
,t2.wallet_captured_tcredit_amount_lc
,t2.net_expected_amount_lc
,t2.refund_bucket_amount
,t2.partial_refund_bucket_amount
,t2.vendor_related_comp_bucket_amount
,t2.marketing_comp_bucket_amount
,t2.compensation_bucket_amount
,t2.reversed_amount
,t2.earn_non_refund_bucket
,t2.count_wallet_refunds
,t2.psp_authorised_amount_lc
,t2.psp_authorisation_approved_amount_lc
,t2.psp_void_authorisation_amount_lc
,t2.psp_capture_amount_lc
,t2.psp_capture_fail_amount_lc
,t2.psp_refund_amount_lc
,t2.psp_order_net_amount_lc
,t2.psp_modification_authorised_amount_lc
,t2.psp_modification_authorisation_approved_amount_lc
,t2.psp_modification_void_authorisation_amount_lc
,t2.psp_modification_capture_amount_lc
,t2.psp_modification_capture_fail_amount_lc
,t2.psp_modification_refund_amount_lc
,t2.psp_modification_net_amount_lc
,t2.psp_net_amount_lc
,t2.psp_last_response_message
,t2.net_collected_amount_lc
,t2.net_discrepancy
,t2.net_discrepancy_over_collection_amount_lc
,t2.net_discrepancy_under_collection_amount_lc
,t2.net_discrepancy_excluding_capture_fail_amount_lc
,t2.net_discrepancy_under_collection_excluding_capture_fail_amount_lc
,t2.reconciliation_status
,t2.is_reconciled
,t2.avg_fx_rate

from psp t1
left join `tlb-data-prod.data_platform.fct_reconciliation_order`  t2
  on t1.reference = t2.order_id
  and trim(lower(t2.reconciliation_source)) not in ('bnpl','cash')

-- where (reconciliation_status is null or is_reconciled is false)

-- order by reference,capture_amount,payment_time_utc,payment_number_per_order
)

-- select * from final_data

,fix_auth_flag as
(select 
  backend_reference as reference
  ,max(case when authorization_type = 'Recurring'  then true 
            when authorization_type is null then false 
        else false end ) as authorization_type
  ,max(threed_secure_payment) as threed_secure_payment
from distinct_payment_id
group by all
)

,data_for_investigation as
(select 
  
  t1.month
  ,t1.country_code
  ,t1.transaction_type
  ,t1.reference
  ,t1.payment_id
  ,t1.payment_time_utc
  ,date(t1.payment_time_utc) as payment_date
  ,t1.capture_amount
  ,t1.payment_number_per_order
  ,t1.transaction_id
  ,t1.account_id
  ,date(t1.filtration_date) filtration_date
  ,t1.order_status
  ,t1.is_apple_pay
  ,t1.is_modified_after_delivery
  ,t1.is_cancelled_after_delivery
  ,t1.payment_method
  ,t1.source_name

  ,t1.reconciliation_status
  ,t1.is_reconciled


  ,t5.authorization_type
  ,coalesce(card_wallet_type,'not digital wallet') as card_wallet_type
  ,t5.threed_secure_payment
  ,t2.is_international_card
  ,t2.card_type
  ,("card - " || coalesce(card_type,"UNKNOWN") || " - " || 
    (case when t5.authorization_type is true then 'Saved Card' else 'Regular Card' end)
    ||
    " - " || coalesce(card_wallet_type,'not digital wallet')
    || " - " || (case when coalesce(t5.threed_secure_payment,FALSE) then "3D Secure" else "No 3D Secure" end)
  ) as payment_method_detailed
  
  ,t2.card_network
  ,t2.processor
  ,t3.app_version
  ,t4.device_group
  ,t4.device
  ,t4.os as operating_system
  ,t4.is_mobile


from final_data t1
left join distinct_payment_id t2
  on t1.payment_id = t2.payment_id

left join `tlb-data-prod.data_platform.fct_order_info` t3
  on t1.order_id = cast(t3.order_id as string)
  and t3.order_date >>='2023-01-01'

left join `tlb-data-prod.data_platform.dim_platform` t4
  on t3.platform_id = t4.platform_id

left join fix_auth_flag t5
  using(reference)

where 
  t1.reference in (select distinct reference from final_data where payment_number_per_order>>1)
)


-- select * from data_for_investigation
-- order by reference , payment_number_per_order


select 
  -- date(order_date) as order_date
  date(payment_time_utc) as payment_date
  ,t1.country_code
  ,source_name
  ,order_status
  -- ,authorization_type
  -- ,card_wallet_type
  -- ,threed_secure_payment
  -- ,is_international_card
  -- ,card_type
  ,("card - " || coalesce(card_type,"UNKNOWN") || " - " || 
    (case when authorization_type is true then 'Saved Card' else 'Regular Card' end)
    ||
    " - " || coalesce(card_wallet_type,'not digital wallet')
    || " - " || (case when coalesce(threed_secure_payment,FALSE) then "3D Secure" else "No 3D Secure" end)
  ) as payment_method_detailed

  -- ,card_network
  -- ,processor
  ,app_version
  ,device_group
  ,device
  ,operating_system
  ,count(distinct reference) as transaction_count
  ,count(distinct payment_id) as total_payment_id_count
  ,count(distinct case when payment_number_per_order>>1 then payment_id end) as additional_payment_id_count
  ,sum(capture_amount) total_capture_amount_lc
  ,sum(case when payment_number_per_order>>1 then capture_amount end) additional_capture_amount_lc
  ,safe_divide(sum(capture_amount),max(exchange_rate_value))total_capture_amount_eur
  ,safe_divide(sum(case when payment_number_per_order>>1 then capture_amount end),max(exchange_rate_value)) additional_capture_amount_eur

from data_for_investigation  t1
left join `tlb-data-prod.data_platform.dim_exchange_rate` t2
  on t1. payment_date = t2.exchange_rate_date
  and t1.country_code = t2.country_code
  and t2.exchange_rate_base = 'EUR'
-- where payment_date>>='2024-01-01'
group by all
order by total_payment_id_count]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.00ozy2202fc2da1g1fg0k1fyrpcj' name='Custom SQL Query' type='text'><![CDATA[-- 1. get all the orders where we have more than 1 capture
-- 2. check transactions having same capture amount
-- 3. exclude the orders where 2nd capture = upward modification >>>>>> quantification of issue for tech team
-- 4. Successful / Non Successful
-- 5. Number of additional captures
-- 6. take orders where we had net_discrepancy (only -ve) >>= capture amount


-- create or replace table `tlb-data-dev.data_playground_finance.temp_multi_charge_investigation_data_31oct2024`
-- as 
with psp_multiple_captures as
(select 
  backend_reference
  ,count(distinct payment_id) 
from `tlb-data-prod.data_platform.fct_payment_gateway_transaction`
where is_psp_data
and date(payment_time_utc) >>='2023-01-01'
and has_approved_authorisation
and has_approved_capture
and coalesce(capture_amount,0)>>0
group by all having count(distinct payment_id)>>1
order by 2 desc)

,distinct_payment_id as
(
select 
t1.*
,row_number() over(partition by payment_id,capture_amount order by payment_time_utc,transaction_type) as rnk_payment_id
from `tlb-data-prod.data_platform.fct_payment_gateway_transaction`t1
where 
date(payment_time_utc) >>='2023-01-01'
-- and date(payment_time_utc) <<='2024-08-31'
and backend_reference in (select distinct backend_reference from psp_multiple_captures)
and coalesce(capture_amount,0)>>0
and has_approved_authorisation
and is_psp_data
-- and coalesce(capture_amount,0) <<>> coalesce(refund_amount,0)
-- backend_reference in ('1472969478')
)


,psp as
(
select 
  date_trunc(date(payment_time_utc),month) as month
  ,country_code
  ,transaction_type
  ,backend_reference as reference
  ,payment_id
  ,payment_time_utc
  ,capture_amount
  ,source_name
-- ,lead(capture_amount) over(partition by backend_reference,capture_amount order by payment_time_utc) capture_n
,row_number() over(partition by backend_reference,capture_amount order by is_backend_data desc,payment_time_utc) as payment_number_per_order

from distinct_payment_id
where rnk_payment_id = 1
-- and backend_reference in ('1445572535')
-- and backend_reference in ('1472969478')
-- and backend_reference in ('f39e39f6-6c7b-475b-9121-ee1927338ce2')
-- and backend_reference in ('1467792048')

-- group by all 
order by capture_amount, payment_number_per_order

)


,final_data as
(
select 
t1.* 
-- ,case when t1.payment_number_per_order = 1 then false else true end as refund_needed
-- ,t2.country_code
," >>>> reco columns >>>> " as reco_columns
,t2.order_id
,t2.transaction_id
,t2.account_id
,t2.filtration_date
,t2.order_status
,t2.is_apple_pay
,t2.is_modified_after_delivery
,t2.is_cancelled_after_delivery
,t2.payment_method
,t2.reconciliation_source
-- ,t2.source_name
,t2.gmv_amount_lc
,t2.original_gmv_amount_lc
,t2.modification_original_gmv_amount_lc
,t2.tgo_modification_gmv_added_amount_lc
,t2.tmp_modification_gmv_added_amount_lc
,t2.modification_gmv_removed_amount_lc
,t2.rider_tip_checkout_amount_lc
,t2.paid_by_cc_fee_amount_lc
,t2.paid_by_knet_fee_amount_lc
,t2.paid_by_cash_fee_amount_lc
,t2.paid_by_talabat_fee_amount_lc
,t2.wallet_captured_tcredit_count
,t2.wallet_captured_tcredit_amount_lc
,t2.net_expected_amount_lc
,t2.refund_bucket_amount
,t2.partial_refund_bucket_amount
,t2.vendor_related_comp_bucket_amount
,t2.marketing_comp_bucket_amount
,t2.compensation_bucket_amount
,t2.reversed_amount
,t2.earn_non_refund_bucket
,t2.count_wallet_refunds
,t2.psp_authorised_amount_lc
,t2.psp_authorisation_approved_amount_lc
,t2.psp_void_authorisation_amount_lc
,t2.psp_capture_amount_lc
,t2.psp_capture_fail_amount_lc
,t2.psp_refund_amount_lc
,t2.psp_order_net_amount_lc
,t2.psp_modification_authorised_amount_lc
,t2.psp_modification_authorisation_approved_amount_lc
,t2.psp_modification_void_authorisation_amount_lc
,t2.psp_modification_capture_amount_lc
,t2.psp_modification_capture_fail_amount_lc
,t2.psp_modification_refund_amount_lc
,t2.psp_modification_net_amount_lc
,t2.psp_net_amount_lc
,t2.psp_last_response_message
,t2.net_collected_amount_lc
,t2.net_discrepancy
,t2.net_discrepancy_over_collection_amount_lc
,t2.net_discrepancy_under_collection_amount_lc
,t2.net_discrepancy_excluding_capture_fail_amount_lc
,t2.net_discrepancy_under_collection_excluding_capture_fail_amount_lc
,t2.reconciliation_status
,t2.is_reconciled
,t2.avg_fx_rate

from psp t1
left join `tlb-data-prod.data_platform.fct_reconciliation_order`  t2
  on t1.reference = t2.order_id
  and trim(lower(t2.reconciliation_source)) not in ('bnpl','cash')

-- where (reconciliation_status is null or is_reconciled is false)

-- order by reference,capture_amount,payment_time_utc,payment_number_per_order
)

-- select * from final_data

,fix_auth_flag as
(select 
  backend_reference as reference
  ,max(case when authorization_type = 'Recurring'  then true 
            when authorization_type is null then false 
        else false end ) as authorization_type
  ,max(threed_secure_payment) as threed_secure_payment
from distinct_payment_id
group by all
)

,data_for_investigation as
(select 
  
  t1.month
  ,t1.country_code
  ,t1.transaction_type
  ,t1.reference
  ,t1.payment_id
  ,t1.payment_time_utc
  ,date(t1.payment_time_utc) as payment_date
  ,t1.capture_amount
  ,t1.payment_number_per_order
  ,t1.transaction_id
  ,t1.account_id
  ,date(t1.filtration_date) filtration_date
  ,t1.order_status
  ,t1.is_apple_pay
  ,t1.is_modified_after_delivery
  ,t1.is_cancelled_after_delivery
  ,t1.payment_method
  ,t1.source_name

  ,t1.reconciliation_status
  ,t1.is_reconciled


  ,t5.authorization_type
  ,coalesce(card_wallet_type,'not digital wallet') as card_wallet_type
  ,t5.threed_secure_payment
  ,t2.is_international_card
  ,t2.card_type
  ,("card - " || coalesce(card_type,"UNKNOWN") || " - " || 
    (case when t5.authorization_type is true then 'Saved Card' else 'Regular Card' end)
    ||
    " - " || coalesce(card_wallet_type,'not digital wallet')
    || " - " || (case when coalesce(t5.threed_secure_payment,FALSE) then "3D Secure" else "No 3D Secure" end)
  ) as payment_method_detailed
  
  ,t2.card_network
  ,t2.processor
  ,t3.app_version
  ,t4.device_group
  ,t4.device
  ,t4.os as operating_system
  ,t4.is_mobile


from final_data t1
left join distinct_payment_id t2
  on t1.payment_id = t2.payment_id

left join `tlb-data-prod.data_platform.fct_order_info` t3
  on t1.order_id = cast(t3.order_id as string)
  and t3.order_date >>='2023-01-01'

left join `tlb-data-prod.data_platform.dim_platform` t4
  on t3.platform_id = t4.platform_id

left join fix_auth_flag t5
  using(reference)

where 
  t1.reference in (select distinct reference from final_data where payment_number_per_order>>1)
)


-- select * from data_for_investigation
-- order by reference , payment_number_per_order


select 
  -- date(order_date) as order_date
  date(payment_time_utc) as payment_date
  ,t1.country_code
  ,source_name
  ,order_status
  -- ,authorization_type
  -- ,card_wallet_type
  -- ,threed_secure_payment
  -- ,is_international_card
  -- ,card_type
  ,("card - " || coalesce(card_type,"UNKNOWN") || " - " || 
    (case when authorization_type is true then 'Saved Card' else 'Regular Card' end)
    ||
    " - " || coalesce(card_wallet_type,'not digital wallet')
    || " - " || (case when coalesce(threed_secure_payment,FALSE) then "3D Secure" else "No 3D Secure" end)
  ) as payment_method_detailed

  -- ,card_network
  -- ,processor
  ,app_version
  ,device_group
  ,device
  ,operating_system
  ,count(distinct reference) as transaction_count
  ,count(distinct payment_id) as total_payment_id_count
  ,count(distinct case when payment_number_per_order>>1 then payment_id end) as additional_payment_id_count
  ,sum(capture_amount) total_capture_amount_lc
  ,sum(case when payment_number_per_order>>1 then capture_amount end) additional_capture_amount_lc
  ,safe_divide(sum(capture_amount),max(exchange_rate_value))total_capture_amount_eur
  ,safe_divide(sum(case when payment_number_per_order>>1 then capture_amount end),max(exchange_rate_value)) additional_capture_amount_eur

from data_for_investigation  t1
left join `tlb-data-prod.data_platform.dim_exchange_rate` t2
  on t1. payment_date = t2.exchange_rate_date
  and t1.country_code = t2.country_code
  and t2.exchange_rate_base = 'EUR'
-- where payment_date>>='2024-01-01'
group by all
order by total_payment_id_count]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>payment_date</remote-name>
            <remote-type>7</remote-type>
            <local-name>[payment_date]</local-name>
            <parent-name>[Custom SQL Query]</parent-name>
