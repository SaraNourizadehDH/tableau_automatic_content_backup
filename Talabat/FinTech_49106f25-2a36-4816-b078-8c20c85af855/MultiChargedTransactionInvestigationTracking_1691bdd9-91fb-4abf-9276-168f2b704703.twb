    <datasource caption='Multi Charging - Investigation' inline='true' name='federated.1ni4jtb1szttzk1gza8oc196zsfp' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.00ozy2202fc2da1g1fg0k1fyrpcj'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-datateam-analysis-6343' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='manjunath.lonikar@talabat.com' workgroup-auth-mode='prompt' />
