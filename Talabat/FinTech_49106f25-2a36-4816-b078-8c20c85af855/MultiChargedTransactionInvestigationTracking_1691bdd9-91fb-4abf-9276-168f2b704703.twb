            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Measure' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Transaction Count&quot;'>
              <calculation class='tableau' formula='&quot;Transaction Count&quot;' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ni4jtb1szttzk1gza8oc196zsfp'>
            <column caption='Total Capture Amount' datatype='real' name='[Additional Capture Amount (copy)_1077697329438941186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#10;if [Parameters].[Parameter 2] = &apos;EUR&apos; then [total_capture_amount_eur]&#10;else [total_capture_amount_lc]&#10;end)' />
            </column>
            <column caption='Additional Capture Amount' datatype='real' name='[Calculation_1077697329438789633]' role='measure' type='quantitative'>
