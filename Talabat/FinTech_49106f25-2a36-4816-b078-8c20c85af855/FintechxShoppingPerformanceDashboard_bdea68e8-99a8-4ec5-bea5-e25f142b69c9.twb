            <column caption='Start Date' datatype='date' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='#2024-10-29#'>
              <calculation class='tableau' formula='#2024-10-29#' />
              <range max='#2024-12-31#' min='#2024-10-01#' />
            </column>
            <column caption='Rolling Metric' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;30 rolling days&quot;'>
              <calculation class='tableau' formula='&quot;30 rolling days&quot;' />
            </column>
            <column _.fcp.RefreshableParameterRanges.true...default-value-field='[federated.0f2dq6c1hymed51cxupe50m6ogcw].[Calculation_6568640805536030722]' caption='End Date' datatype='date' name='[Start Date (copy)_6568640805537030149]' param-domain-type='range' role='measure' type='quantitative' value='#2024-11-17#'>
              <calculation class='tableau' formula='#2024-11-17#' />
              <range max='#2024-12-31#' min='#2024-11-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0f2dq6c1hymed51cxupe50m6ogcw'>
            <column caption='Rolling Metric Filter' datatype='boolean' name='[Calculation_274649220100407304]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;&#10;    WHEN &apos;7 rolling days&apos; THEN [rolling_metrics] =&apos;7 rolling days&apos;&#10;    WHEN &apos;14 rolling days&apos; THEN [rolling_metrics] =&apos;14 rolling days&apos;&#10;    WHEN &apos;30 rolling days&apos; THEN [rolling_metrics] =&apos;30 rolling days&apos;&#10;END' />
            </column>
            <column caption=' PostPaid Shopping Shared OKR' datatype='real' name='[Calculation_6568640805519298560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[bnpl_order_count]/[app_visit_count]' />
            </column>
            <column caption='End Date - Default' datatype='date' name='[Calculation_6568640805536030722]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='TODAY() - 1' />
            </column>
            <column caption='Date Range' datatype='string' name='[Calculation_6568640805537738760]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF  &#10;[date] &gt;= [Parameters].[Parameter 1]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Start Date (copy)_6568640805537030149])+1)&#10;and [date] &lt;= [Parameters].[Start Date (copy)_6568640805537030149]-(DATEDIFF(&apos;day&apos;,[Parameters].[Parameter 1], [Parameters].[Start Date (copy)_6568640805537030149])+1)&#10;then &quot;Comparison Period&quot; &#10;&#10;ELSEIF &#10;[date] &gt;= [Parameters].[Parameter 1] and [date] &lt;= [Parameters].[Start Date (copy)_6568640805537030149]&#10;then &apos;Selected Period&apos; &#10;&#10;ELSE &apos;Remaining Days&apos;&#10;&#10;END' />
            </column>
            <column datatype='integer' name='[app_visit_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[bnpl_order_count]' role='measure' type='quantitative' />
            <column datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
