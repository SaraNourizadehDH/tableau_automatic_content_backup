      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1p2kj6n1n657ff1h8kucm1f2ao80].[sum:Ret_M1:qk]&quot;' value='M1 Retention' />
        </aliases>
      </column>
      <column caption='rM1' datatype='real' name='[Calculation_4112912376501579777]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ZN(SUM([Ret_M1]))/ZN(sum([total_users]))=0 THEN NULL ELSE ZN(SUM([Ret_M1]))/ZN(sum([total_users])) END' />
      </column>
      <column caption='fM0' datatype='real' name='[Calculation_4112912376530235407]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Freq_M0])/sum([total_users])' />
      </column>
      <column caption='aM0' datatype='real' name='[Calculation_4112912376531595280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([GMV_M0])/sum([Freq_M0])' />
      </column>
      <column caption='count month' datatype='integer' name='[Calculation_4112912376931360812]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([month])' />
      </column>
      <column caption='Avg Monthly Users' datatype='real' name='[Calculation_4112912376931495981]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_users]) / [Calculation_4112912376931360812]' />
      </column>
      <column caption='__KAM_Country_Filter__' datatype='boolean' name='[Calculation_4112912376933818414]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;ISMEMBEROF(&apos;market_regional&apos;) THEN TRUE&#10;ELSEIF ISMEMBEROF(&apos;market_uae&apos;) THEN [country_code]= &apos;AE&apos;&#10;ELSEIF ISMEMBEROF(&apos;market_qatar&apos;) THEN [country_code]= &apos;QA&apos;&#10;ELSEIF ISMEMBEROF(&apos;market_kuwait&apos;) THEN [country_code]= &apos;KW&apos;&#10;ELSEIF ISMEMBEROF(&apos;market_oman&apos;) THEN [country_code]= &apos;OM&apos;&#10;ELSEIF ISMEMBEROF(&apos;market_bahrain&apos;) THEN [country_code]= &apos;BH&apos;&#10;ELSEIF ISMEMBEROF(&apos;market_egypt&apos;) THEN [country_code]= &apos;EG&apos;&#10;ELSEIF ISMEMBEROF(&apos;market_jordan&apos;) THEN [country_code]= &apos;JO&apos;&#10;ELSEIF ISMEMBEROF(&apos;market_iraq&apos;) THEN [country_code]= &apos;IQ&apos;&#10;END' />
      </column>
      <column caption='__AM_Filter__' datatype='boolean' name='[Calculation_4112912376934166575]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#10;ISMEMBEROF(&apos;Talabat General Access&apos;) THEN TRUE&#10;ELSEIF ISMEMBEROF(&apos;account_managers&apos;) THEN USERNAME() = [account_manager_email] &#10;ELSEIF ISMEMBEROF(&apos;account_managers_full_team&apos;) THEN [team_leader_email] = {MIN(IF USERNAME() = [account_manager_email] THEN [team_leader_email] ELSE NULL END)}&#10;ELSEIF ISMEMBEROF(&apos;account_managers_team_leaders&apos;) THEN USERNAME() = [team_leader_email] OR USERNAME() = [account_manager_email]&#10;END' />
      </column>
      <column datatype='integer' name='[Ret_M1]' role='measure' type='quantitative' />
