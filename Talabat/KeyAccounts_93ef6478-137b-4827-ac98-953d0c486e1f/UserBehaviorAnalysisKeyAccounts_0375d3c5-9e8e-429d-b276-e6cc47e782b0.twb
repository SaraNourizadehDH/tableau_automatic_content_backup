            <column caption='Frequency' datatype='real' name='[fM0 (copy)_4112912376935862321]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Freq_M0])/sum([total_users])' />
            </column>
            <column datatype='string' name='[group_name]' role='dimension' type='nominal' />
            <column caption='Month' datatype='date' default-format='*YYYY-MMM' name='[month]' role='dimension' type='ordinal' />
