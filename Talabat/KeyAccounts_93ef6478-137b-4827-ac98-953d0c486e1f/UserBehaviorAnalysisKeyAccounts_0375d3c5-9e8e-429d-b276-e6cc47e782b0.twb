      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='tl/am email' id='_658F4A9A2A3A44C5BE136B2EA7036398'>
            <properties context=''>
              <relation connection='bigquery.0fe6ug104jf44f1defecu1v1nnrh' name='Custom SQL Query1' type='text'>select 
        
        dim_vendor_info.account_manager_email,
        dim_vendor_info.team_leader_email,
        
        case 
            when ((lower(dim_chain.chain_name) LIKE lower(&quot;PF Chang%&quot;)) OR (lower(dim_chain.chain_name) LIKE lower(&quot;P.F Chang%&quot;)) OR (lower(dim_chain.chain_name) LIKE lower(&quot;P.F. Chang%&quot;)) ) then &apos;P.F Chang&apos; 
            when (lower(dim_chain.chain_name) LIKE lower(&quot;Blaze Pizza&quot;)) then &apos;Blaze Pizza&apos;
            when (lower(dim_chain.chain_name) LIKE lower(&quot;Raising Cane%&quot;)) then &apos;Raising Cane&apos;
            when (lower(dim_chain.chain_name) LIKE lower(&quot;Pinkberry%&quot;)) then &apos;Pinkberry&apos;
            when (lower(dim_chain.chain_name) LIKE lower(&quot;The Cheesecake Fac%&quot;)) then &apos;The Cheesecake Factory&apos;
            when (lower(dim_chain.chain_name) LIKE lower(&quot;Shake Shack%&quot;)) then &apos;Shake Shack&apos;
            when (lower(dim_chain.chain_name) LIKE lower(&quot;Texas Roadhouse&quot;)) then &apos;Texas Roadhouse&apos;
            when (lower(dim_chain.chain_name) LIKE lower(&quot;Asha&apos;s&quot;)) then &quot;Asha&apos;s&quot;
            when (lower(dim_chain.chain_name) LIKE lower(&quot;%Le Pain Quotidien%&quot;)) then &apos;Le Pain Quotidien&apos;
            when (lower(dim_chain.chain_name) LIKE lower(&quot;Amiti Noura%&quot;)) then &apos;Amiti Noura&apos;
            when (lower(dim_chain.chain_name) LIKE lower(&quot;%Dean &amp; Deluca%&quot;)) then &apos;Dean &amp; Deluca&apos;
            when (lower(dim_chain.chain_name) LIKE lower(&quot;Bitza&quot;)) then &apos;Bitza&apos;
            when (lower(dim_chain.chain_name) LIKE lower(&quot;Pizza Express%&quot;)) then &apos;Pizza Express&apos;
            when (lower(dim_chain.chain_name) LIKE lower(&quot;Bouchon Bakery%&quot;)) then &apos;Bouchon Bakery&apos;
            when (lower(dim_chain.chain_name) LIKE lower(&quot;Bu Burger%&quot;)) then &apos;Bu Burger&apos;
            when ((lower(dim_chain.chain_name) LIKE lower(&quot;Babel&quot;)) OR (lower(dim_chain.chain_name) LIKE lower(&quot;BeBabel&quot;))) then &apos;BeBabel&apos;
            when (lower(dim_chain.chain_name) LIKE lower(&quot;Ahwet Zeitouna%&quot;)) then &apos;Ahwet Zeitouna&apos;
            when (lower(dim_chain.chain_name) LIKE lower(&quot;%DIYAY%&quot;)) then &apos;DIYAY&apos;

            when lower(dim_chain.chain_name) like lower(&apos;starbuck%&apos;) then &apos;Starbucks&apos;

            when lower(dim_chain.chain_name) like lower(&apos;Baskin Robbins%&apos;) then &apos;Baskin Robbins&apos;
            when lower(dim_chain.chain_name) like lower(&apos;Chicken Tikka%&apos;) then &apos;Chicken Tikka&apos;
            when lower(dim_chain.chain_name) like lower(&apos;Costa Coffee%&apos;) then &apos;Costa Coffee&apos;
            when lower(dim_chain.chain_name) like lower(&apos;Grand Cafe%&apos;) then &apos;Grand Cafe&apos;
            when lower(dim_chain.chain_name) like lower(&apos;Hardee%&apos;) then &apos;Hardees&apos;
            when lower(dim_chain.chain_name) like lower(&apos;KFC%&apos;) then &apos;KFC&apos;
            when lower(dim_chain.chain_name) like lower(&apos;%Krispy Kreme%&apos;) then &apos;Krispy Kreme&apos;
            when lower(dim_chain.chain_name) like lower(&apos;Pizza Hut%&apos;) then &apos;Pizza Hut&apos;
            when lower(dim_chain.chain_name) like lower(&apos;TGI Friday%&apos;) then &apos;TGI Friday&apos;
            when lower(dim_chain.chain_name) like lower(&apos;%Wimpy%&apos;) then &apos;Wimpy&apos;

            when (lower(dim_chain.chain_name) LIKE lower(&quot;Mcd%&quot;) and dim_chain.chain_name != &apos;Mcdon Hot&apos;) then &apos;Mcd&apos;
            when (lower(dim_chain.chain_name) like lower(&apos;aseer time%&apos;) OR lower(dim_chain.chain_name) like lower(&apos;asseer time%&apos;) OR lower(dim_chain.chain_name) like lower(&apos;juice time%&apos;) OR lower(dim_chain.chain_name) like lower(&apos;express%aseer time%&apos;)) then &apos;Aseer Time&apos;
            when (dim_chain.chain_name like (&quot;% Arabica%&quot;) OR lower(dim_chain.chain_name) like lower(&quot;arabica&quot;) OR (lower(dim_chain.chain_name) like lower(&quot;arabica %&quot;))) then &apos;% Arabica&apos;
            when ((lower(dim_chain.chain_name) LIKE lower(&quot;Burger King%&quot;) and ((lower(dim_chain.chain_name) NOT LIKE lower(&quot;%kingdom%&quot;) )) ) OR (lower(dim_chain.chain_name) like lower(&quot;%Burger King%&quot;) AND lower(dim_chain.chain_name) like lower(&apos;%express%&apos;))) then &apos;Burger King&apos;
            when (lower(dim_chain.chain_name) LIKE lower(&quot;Domino%&quot;) and ((lower(dim_chain.chain_name) NOT LIKE lower(&quot;Domino&quot;) and (lower(dim_chain.chain_name) NOT LIKE lower(&quot;Domino %&quot;)) and (lower(dim_chain.chain_name) NOT LIKE lower(&quot;Domino`z%&quot;)) )) ) then &apos;Dominos&apos;
            when (lower(dim_chain.chain_name) LIKE lower(&quot;Subway%&quot;) and (dim_country_info.country_code NOT IN (&apos;IQ&apos;) ) ) then &apos;Subway&apos;
            when (lower(dim_chain.chain_name) like lower(&apos;b laban&apos;) OR lower(dim_chain.chain_name) like lower(&apos;b. laban&apos;) OR lower(dim_chain.chain_name) like lower(&apos;blaban&apos;) OR lower(dim_chain.chain_name) like lower(&apos;b.laban&apos;)) then &apos;B.Laban&apos;
            when (lower(dim_chain.chain_name) like lower(&apos;farooj abo al%&apos;) OR lower(dim_chain.chain_name) like lower(&apos;farooj abu al%&apos;) OR lower(dim_chain.chain_name) like lower(&apos;farouj abo al%&apos;) OR lower(dim_chain.chain_name) like lower(&apos;farouj abu al%&apos;)) then &quot;Farooj Abu Al Abed&quot;

        else dim_chain.chain_name end as chain_name,


        case 
            when (dim_chain.is_regional_key_account) then dim_chain.group_name 
            when (
                (lower(dim_chain.chain_name) LIKE lower(&quot;Mcd%&quot;) and dim_chain.chain_name != &apos;Mcdon Hot&apos;) or
                ((dim_chain.chain_name) LIKE (&quot;KFC%&quot;)) or
                (lower(dim_chain.chain_name) LIKE lower(&quot;pizza hut%&quot;)) or
                (lower(dim_chain.chain_name) LIKE lower(&quot;hardee%&quot;)) or
                (lower(dim_chain.chain_name) LIKE lower(&quot;Burger King%&quot;) and ((lower(dim_chain.chain_name) NOT LIKE lower(&quot;%kingdom%&quot;) )) ) or
                (lower(dim_chain.chain_name) LIKE lower(&quot;starbuck%&quot;)) or
                (lower(dim_chain.chain_name) LIKE lower(&quot;Papa John%&quot;)) or
                (lower(dim_chain.chain_name) LIKE lower(&quot;Subway%&quot;) and (dim_country_info.country_code NOT IN (&apos;IQ&apos;) ) ) or
                (lower(dim_chain.chain_name) LIKE lower(&quot;Domino%&quot;) and ((lower(dim_chain.chain_name) NOT LIKE lower(&quot;Domino&quot;) and (lower(dim_chain.chain_name) NOT LIKE lower(&quot;Domino %&quot;)) and (lower(dim_chain.chain_name) NOT LIKE lower(&quot;Domino`z%&quot;)) )) ) or
                (lower(dim_chain.chain_name) LIKE lower(&quot;dunkin%&quot;)) or
                (lower(dim_chain.chain_name) LIKE lower(&quot;baskin robbin%&quot;)) or
                (lower(dim_chain.chain_name) LIKE lower(&quot;Krispy Kreme%&quot;)) or
                (lower(dim_chain.chain_name) LIKE lower(&quot;Wendy%&quot;)) or
                (lower(dim_chain.chain_name) LIKE lower(&quot;papa murphy%&quot;)) OR
                (lower(dim_chain.chain_name) LIKE lower(&quot;shake shack%&quot;)) OR
                lower(dim_chain.chain_name) like lower(&apos;five Guy%&apos;)
            ) then &apos;Other American Brands&apos;
            else &apos;Key Accounts&apos; end as group_name,

        dim_country_info.country_code


    from `tlb-data-prod.data_platform.dim_chain` as dim_chain
    left join `tlb-data-prod.data_platform_google_sheet.regional_key_account` as regional_key_account on regional_key_account.chain_id = cast(dim_chain.chain_id as string)
    inner join `tlb-data-prod.data_platform.dim_country_info` as dim_country_info on dim_country_info.country_id = dim_chain.country_id
    inner join `tlb-data-dev.data_platform.dim_vendor_info` as dim_vendor_info on dim_vendor_info.chain_id = dim_chain.chain_id

    where 
    (
        (dim_chain.is_regional_key_account)

        OR 

        (
        (lower(dim_chain.chain_name) LIKE lower(&quot;Mcd%&quot;) and dim_chain.chain_name != &apos;Mcdon Hot&apos;) or
        ((dim_chain.chain_name) LIKE (&quot;KFC%&quot;)) or
        (lower(dim_chain.chain_name) LIKE lower(&quot;pizza hut%&quot;)) or
        (lower(dim_chain.chain_name) LIKE lower(&quot;hardee%&quot;)) or
        (lower(dim_chain.chain_name) LIKE lower(&quot;Burger King%&quot;) and ((lower(dim_chain.chain_name) NOT LIKE lower(&quot;%kingdom%&quot;) )) ) or
        (lower(dim_chain.chain_name) LIKE lower(&quot;starbuck%&quot;)) or
        (lower(dim_chain.chain_name) LIKE lower(&quot;Papa John%&quot;)) or
        (lower(dim_chain.chain_name) LIKE lower(&quot;Subway%&quot;) and (dim_country_info.country_code NOT IN (&apos;IQ&apos;) ) ) or
        (lower(dim_chain.chain_name) LIKE lower(&quot;Domino%&quot;) and ((lower(dim_chain.chain_name) NOT LIKE lower(&quot;Domino&quot;) and (lower(dim_chain.chain_name) NOT LIKE lower(&quot;Domino %&quot;)) and (lower(dim_chain.chain_name) NOT LIKE lower(&quot;Domino`z%&quot;)) )) ) or
        (lower(dim_chain.chain_name) LIKE lower(&quot;dunkin%&quot;)) or
        (lower(dim_chain.chain_name) LIKE lower(&quot;baskin robbin%&quot;)) or
        (lower(dim_chain.chain_name) LIKE lower(&quot;Krispy Kreme%&quot;)) or
        (lower(dim_chain.chain_name) LIKE lower(&quot;Wendy%&quot;)) or
        (lower(dim_chain.chain_name) LIKE lower(&quot;papa murphy%&quot;)) OR
        (lower(dim_chain.chain_name) LIKE lower(&quot;shake shack%&quot;)) OR
        lower(dim_chain.chain_name) like lower(&apos;five Guy%&apos;)
        )

        OR
        (
            (regional_key_account.chain_id IS NOT NULL)
        )
        
    )

    group by 1,2,3,4,5</relation>
            </properties>
