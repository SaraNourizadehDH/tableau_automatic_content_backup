            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[group_name]' derivation='None' name='[none:group_name:nk]' pivot='key' type='nominal' />
            <column caption='Avg M1 Retention' datatype='real' name='[rM1 (copy)_4112912376936427571]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ZN(SUM([Ret_M1]))/ZN(sum([total_users]))=0 THEN NULL ELSE ZN(SUM([Ret_M1]))/ZN(sum([total_users])) END' />
            </column>
            <column caption='rM6' datatype='real' name='[rM5 (copy)_4112912376502181894]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ZN(SUM([Ret_M6]))/ZN(sum([total_users]))=0 THEN NULL ELSE ZN(SUM([Ret_M6]))/ZN(sum([total_users])) END' />
