    <worksheet name='Revised Delivery Cost'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1awz3eo17rrpxr147d61v0ei292h' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select % for 3.5-4.5' datatype='real' name='[Parameter 11]' param-domain-type='range' role='measure' type='quantitative' value='0.1'>
              <calculation class='tableau' formula='0.1' />
              <range min='0.01' />
            </column>
            <column caption='Select % for 4.5-6' datatype='real' name='[Parameter 12]' param-domain-type='range' role='measure' type='quantitative' value='0.1'>
              <calculation class='tableau' formula='0.1' />
              <range min='0.01' />
            </column>
            <column caption='Select % for 6-8' datatype='real' name='[Parameter 13]' param-domain-type='range' role='measure' type='quantitative' value='0.1'>
              <calculation class='tableau' formula='0.1' />
              <range min='0.01' />
            </column>
            <column caption='Select % for 8-10' datatype='real' name='[Parameter 14]' param-domain-type='range' role='measure' type='quantitative' value='0.1'>
              <calculation class='tableau' formula='0.1' />
              <range min='0.01' />
            </column>
            <column caption='Select % for 10+' datatype='real' name='[Parameter 15]' param-domain-type='range' role='measure' type='quantitative' value='0.1'>
              <calculation class='tableau' formula='0.1' />
              <range min='0.01' />
            </column>
            <column caption='Select Capped Charge' datatype='real' name='[Parameter 16]' param-domain-type='range' role='measure' type='quantitative' value='1.'>
              <calculation class='tableau' formula='1.' />
              <range granularity='0.1' max='1.0' min='0.4' />
            </column>
            <column caption='Double Discounting' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Covered&quot;'>
              <calculation class='tableau' formula='&quot;Covered&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1awz3eo17rrpxr147d61v0ei292h'>
            <column caption='pro_orders_with_funding' datatype='integer' name='[Calculation_414894155214249985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[tgo_pro_orders] - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN [double_discounted_tgo_orders]&#13;&#10;ELSE 0 END)' />
            </column>
            <column caption='Revised Delivery Cost ' datatype='real' name='[Revised Delivery Cost (copy)_1477462192815042563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;case [chain_name] when &apos;talabat mart&apos; THEN 0 &#13;&#10;ELSE&#13;&#10;case [tiers]&#13;&#10;WHEN &apos;0-3.5&apos; THEN ZN([Calculation_414894155214249985])*0&#13;&#10;WHEN &apos;3.5-4.5&apos; THEN ZN([Calculation_414894155214249985])*(IF [Parameters].[Parameter 11]*ROUND(ZN(afv),2) &gt; [Parameters].[Parameter 16] THEN [Parameters].[Parameter 16] ELSE [Parameters].[Parameter 11]*ROUND(ZN(afv),2) END) + ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END)&#13;&#10;WHEN &apos;4.5-6&apos; THEN ZN([Calculation_414894155214249985])*(IF [Parameters].[Parameter 12]*ROUND(ZN(afv),2) &gt; [Parameters].[Parameter 16] THEN [Parameters].[Parameter 16] ELSE [Parameters].[Parameter 12]*ROUND(ZN(afv),2) END) + ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END)&#13;&#10;WHEN &apos;6-8&apos; THEN ZN([Calculation_414894155214249985])*(IF [Parameters].[Parameter 13]*ROUND(ZN(afv),2) &gt; [Parameters].[Parameter 16] THEN [Parameters].[Parameter 16] ELSE [Parameters].[Parameter 13]*ROUND(ZN(afv),2) END) + ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END)&#13;&#10;WHEN &apos;8-10&apos; THEN ZN([Calculation_414894155214249985])*(IF [Parameters].[Parameter 14]*ROUND(ZN(afv),2) &gt; [Parameters].[Parameter 16] THEN [Parameters].[Parameter 16] ELSE [Parameters].[Parameter 14]*ROUND(ZN(afv),2) END) + ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END)&#13;&#10;WHEN &apos;10+&apos; THEN ZN([Calculation_414894155214249985])*(IF [Parameters].[Parameter 15]*ROUND(ZN(afv),2) &gt; [Parameters].[Parameter 16] THEN [Parameters].[Parameter 16] ELSE [Parameters].[Parameter 15]*ROUND(ZN(afv),2) END) + ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END)&#13;&#10;END END)' />
            </column>
            <column datatype='real' name='[afv]' role='measure' type='quantitative' />
            <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[double_discounted_tgo_orders]' role='measure' type='quantitative' />
            <column-instance column='[chain_name]' derivation='None' name='[none:chain_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column datatype='real' name='[talabat_df_funding]' role='measure' type='quantitative' />
            <column datatype='integer' name='[tgo_pro_orders]' role='measure' type='quantitative' />
            <column datatype='string' name='[tiers]' role='dimension' type='nominal' />
            <column datatype='real' name='[tmp_delivery_cost]' role='measure' type='quantitative' />
            <column-instance column='[Revised Delivery Cost (copy)_1477462192815042563]' derivation='User' name='[usr:Revised Delivery Cost (copy)_1477462192815042563:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
