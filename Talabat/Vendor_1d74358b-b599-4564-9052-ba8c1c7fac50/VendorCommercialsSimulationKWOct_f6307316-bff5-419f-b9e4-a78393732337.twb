        </column>
        <column caption='10+' datatype='real' datatype-customized='true' name='[Parameter 5]' param-domain-type='list' role='measure' type='quantitative' value='0.7'>
          <calculation class='tableau' formula='0.7' />
        </column>
        <column caption='Double Discounting' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Covered&quot;'>
          <calculation class='tableau' formula='&quot;Covered&quot;' />
        </column>
        <column caption='Commission Cap' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
          <calculation class='tableau' formula='&quot;None&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_C1B5ECDEBCD548FEB29681F39855C1A5'>
            <properties context=''>
              <relation connection='bigquery.1tcmm540naziip12kqbnf1ahx0xw' name='Custom SQL Query' type='text'><![CDATA[with billing as (
  select
    a.country,
    b.order_id,
    c.chain_name,
    originalcalculations,
    calculatedcommissionablegmv,
    bd.calculatedcommission,
    bd.platformdeliveryfund,
    case when TRIM(SUBSTRING(split(originalcalculations, ',') [OFFSET(0) ],25,10)) = 'null' then 0
         when TRIM(SUBSTRING(split(originalcalculations, ',') [OFFSET(0) ],25,10)) = 'None' then 0
         else CAST(TRIM(SUBSTRING(split(originalcalculations, ',') [OFFSET(0) ],25,10)) AS numeric) END as org_commission,
    case when case when TRIM(SUBSTRING(split(originalcalculations, ',') [OFFSET(0) ],25,10)) = 'null' then 0
         when TRIM(SUBSTRING(split(originalcalculations, ',') [OFFSET(0) ],25,10)) = 'None' then 0
         else CAST(TRIM(SUBSTRING(split(originalcalculations, ',') [OFFSET(0) ],25,10)) AS numeric) END - calculatedcommission >> 0 then 1 else 0 END capped,
    b.gmv_amount_lc - b.delivery_fee_amount_lc - coalesce(b.service_fee_amount_lc,0) as gfv,
    originalcalculations,
    case when TRIM(SUBSTRING(split(originalcalculations, ',') [OFFSET(2) ],32,10)) = 'null' then 0
         when TRIM(SUBSTRING(split(originalcalculations, ',') [OFFSET(2) ],32,10)) = 'None' then 0
         else CAST(TRIM(SUBSTRING(split(originalcalculations, ',') [OFFSET(2) ],32,10)) AS numeric) END as org_commissionable_gmv,
    ROUND(SAFE_DIVIDE(bd.calculatedcommission,bd.calculatedcommissionablegmv),4) as comm_perc,
    bd.coupondiscountamount, 
    bd.gemdiscount,
    calculatedtprocommission
  from
    `tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as a
    left join `tlb-data-prod.data_platform.fct_order_info` as b on a.account_id = b.account_id
    and a.iso_date = b.order_date
    and (b.order_time between a.start_date and a.end_date)
    and a.country = b.country_iso
    left join `tlb-data-prod.data_platform.dim_chain` as c on b.chain_id = c.chain_id 
    and b.country_iso = c.country_code
    left join `tlb-data-prod.data_platform.dim_vendor_info` as d
    on b.vendor_id = d.vendor_id
    left join `tlb-data-prod.data_platform_billing.billingdata` as bd on b.order_id = bd.orderid
    and b.transaction_id = bd.transactionid
  where
    date_trunc(b.order_date, MONTH) = '2023-10-01'
    and b.is_tpro_order
    and b.is_successful
),

updated_data as 
(
select tp.*,date_add(cast(cohort_month as date),interval period month) as perf_month
from `tlb-data-dev.data_platform.tmp_slh_agg_pro_vendor_performance_monthly_automated_v1` tp 
inner join (select chain_name,max(creation_datetime) as cd
        from  `tlb-data-dev.data_platform.tmp_slh_agg_pro_vendor_performance_monthly_automated_v1`
        where run_month = '2023-10-01'
        and country = 'KW'
        group by 1) bc 
on  tp.chain_name = bc.chain_name 
and  tp.creation_datetime = bc.cd
where run_month = '2023-10-01' and country = 'KW'
),

pro_months as 
(
select chain_name,date_trunc(order_date,month) as order_month
from `tlb-data-prod.data_platform.fct_order_info` fi 
inner join `tlb-data-prod.data_platform.dim_chain` dc 
on  fi.chain_id = dc.chain_id 
and is_successful
and is_tpro_order
and  country_iso = 'KW'
group by 1,2
),

incremental_monthly as 
(
select ab.cohort_month
        ,ab.chain_name
        ,avg(case when feature = 'post_profit_0' then test-control end) as month_0_icr
        ,avg(case when feature = 'post_profit_1' then test-control end ) as month_1_icr
        ,avg(case when feature = 'post_profit_2' then test-control end ) as month_2_icr
        ,avg(case when feature = 'post_profit_3' then test-control end) as month_3_icr
        ,avg(case when feature = 'post_profit_4' then test-control end ) as month_4_icr
        ,avg(case when feature = 'post_profit_5' then test-control end ) as month_5_icr
        ,avg(case when feature = 'post_profit_6' then test-control end) as month_6_icr
        ,avg(case when feature = 'post_profit_7' then test-control end) as month_7_icr
        ,avg(case when feature = 'post_profit_8' then test-control end ) as month_8_icr
        ,avg(case when feature = 'post_profit_9' then test-control end ) as month_9_icr
        ,avg(case when feature = 'post_profit_10' then test-control end) as month_10_icr
        ,avg(case when feature = 'post_profit_11' then test-control end) as month_11_icr

from    updated_data ab 
inner join pro_months  cu 
on  ab.perf_month = cu.order_month 
and  ab.chain_name = cu.chain_name
where test+control <<>> 0 and perf_month <<='2023-10-01'
group by 1,2
),

m0 as 
(
select chain_name
      ,cohort_month 
      , month_0_icr 
from incremental_monthly 
group by 1,2,3
),

notm0 as 
(
select chain_name 
        ,avg(case when month_1_icr is not null then month_1_icr end) as month_1_icr
        ,avg(case when month_2_icr is not null then month_2_icr end) as month_2_icr
,avg(case when month_3_icr is not null then month_3_icr end) as month_3_icr
,avg(case when month_4_icr is not null then month_4_icr end) as month_4_icr
,avg(case when month_5_icr is not null then month_5_icr end) as month_5_icr
,avg(case when month_6_icr is not null then month_6_icr end) as month_6_icr
,avg(case when month_7_icr is not null then month_7_icr end) as month_7_icr
,avg(case when month_8_icr is not null then month_8_icr end) as month_8_icr
,avg(case when month_9_icr is not null then month_9_icr end) as month_9_icr
,avg(case when month_10_icr is not null then month_10_icr end) as month_10_icr
,avg(case when month_11_icr is not null then month_11_icr end) as month_11_icr
from incremental_monthly
group by 1
),

icr_pm as 
(select m0.chain_name
      ,cast(m0.cohort_month  as date) as cohort_month
      , month_0_icr 
      ,nm.month_1_icr
,nm.month_2_icr
,nm.month_3_icr
,nm.month_4_icr
,nm.month_5_icr
,nm.month_6_icr
,nm.month_7_icr
,nm.month_8_icr
,nm.month_9_icr
,nm.month_10_icr
,nm.month_11_icr
from m0
left join notm0 nm
on    m0.chain_name = nm.chain_name
where cast(m0.cohort_month  as date) = '2023-10-01'),

chain_profit as 
(select 
CAST('KW' as STRING) as country, 
a.chain_name,
ROUND(sum(case when a.months = 1 then month_0_icr*users 
                when a.months = 2 then month_1_icr*users 
                when a.months = 3 then month_2_icr*users 
                when a.months = 4 then month_3_icr*users 
                when a.months = 5 then month_4_icr*users 
                when a.months = 6 then month_5_icr*users 
                when a.months = 7 then month_6_icr*users 
                when a.months = 8 then month_7_icr*users 
                when a.months = 9 then month_8_icr*users 
                when a.months = 10 then month_9_icr*users   
                when a.months = 11 then month_10_icr*users
                when a.months = 12 then month_11_icr*users END)/3.0607631038,2) as profit
from data_playground.pro_cost_components_all_kw_oct as a
inner join icr_pm as b 
on a.chain_name = b.chain_name
where a.order_month = '2023-10-01'
group by 1,2),

chain_kpis as 
(select 
a.country, 
c.chain_name, 
case when b.gmv_amount_lc - b.delivery_fee_amount_lc - coalesce(b.service_fee_amount_lc,0) << 3.5 then '0-3.5'
     when b.gmv_amount_lc - b.delivery_fee_amount_lc - coalesce(b.service_fee_amount_lc,0) << 4.5 then '3.5-4.5'
     when b.gmv_amount_lc - b.delivery_fee_amount_lc - coalesce(b.service_fee_amount_lc,0) << 6 then '4.5-6'
     when b.gmv_amount_lc - b.delivery_fee_amount_lc - coalesce(b.service_fee_amount_lc,0) << 8 then '6-8'
     when b.gmv_amount_lc - b.delivery_fee_amount_lc - coalesce(b.service_fee_amount_lc,0) << 10 then '8-10'
     else '10+' END as tiers,
count(distinct b.order_id) as pro_orders,
count(distinct case when b.is_tgo then b.order_id END) as tgo_pro_orders,
count(distinct case when b.is_tgo = FALSE then b.order_id END) as tmp_pro_orders,
sum(case when b.is_tgo then b.gmv_amount_lc - b.delivery_fee_amount_lc - coalesce(b.service_fee_amount_lc,0) END) as gfv_tgo,
ROUND(sum(case when b.is_tgo then b.gmv_amount_lc - b.delivery_fee_amount_lc - coalesce(b.service_fee_amount_lc,0) END)/
count(distinct case when b.is_tgo then b.order_id END),2) as afv,
count(distinct case when b.is_tgo and (bd.coupondiscountamount >> 0 or bd.gemdiscount >> 0) then b.order_id END) as double_discounted_tgo_orders,
sum(calculatedtprocommission) as df_commission,
sum(case when b.is_tgo = FALSE then tpro_discount_lc END) as tmp_delivery_cost,
sum(case when b.is_tgo = FALSE then platformdeliveryfund END) as talabat_df_funding,
count(distinct case when org_commissionable_gmv >> 8 then b.order_id END) as capped_orders_with_8,
count(distinct case when org_commissionable_gmv >> 10 then b.order_id END) as capped_orders_with_10,
sum(case when org_commissionable_gmv >> 8 and b.is_tgo then (org_commission - 8*comm_perc) END) as commission_capping_savings_with_8,
sum(case when org_commissionable_gmv >> 10 and b.is_tgo then (org_commission - 10*comm_perc) END) as commission_capping_savings_with_10,
sum(count(distinct b.order_id)) OVER(PARTITION BY a.country, c.chain_name) as total_pro_orders,
ROUND(count(distinct b.order_id)/sum(count(distinct b.order_id)) OVER(PARTITION BY a.country, c.chain_name),4) as order_contri
from 
`tlb-data-prod.data_platform.fct_tpro_subscriber_daily` as a
inner join `tlb-data-prod.data_platform.fct_order_info` as b on a.account_id = b.account_id 
and a.iso_date = DATE(b.order_date) 
and (b.order_time between a.start_date and a.end_date) 
and a.country = b.country_iso 
inner join `tlb-data-prod.data_platform.dim_chain` as c 
on b.country_iso = c.country_code and b.chain_id = c.chain_id 
inner join `tlb-data-prod.data_platform.dim_vendor_info` as d 
on b.vendor_id = d.vendor_id 
inner join `tlb-data-prod.data_platform.dim_vertical` v on b.vertical_id = v.vertical_id 
left join billing as bd on b.order_id = bd.order_id
where date_trunc(b.order_date, MONTH) = '2023-10-01'
and a.country = 'KW' and b.is_successful and b.is_tpro_order
and v.vertical_class = 'food'
group by 1,2,3)

select a.*,
ROUND(b.profit*order_contri,2) as proft_ps
from chain_kpis as a 
left join chain_profit as b 
on a.chain_name = b.chain_name and a.country = b.country]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
