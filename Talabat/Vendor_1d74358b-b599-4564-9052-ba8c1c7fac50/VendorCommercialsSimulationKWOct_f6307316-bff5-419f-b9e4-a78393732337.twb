        </aliases>
      </column>
      <column caption='Revised Profit ' datatype='real' name='[Calculation_113152993817866240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1207527693872181257]) - [Revised tPro Net Cost (copy)_1140536649588908034])' />
      </column>
      <column caption='Revised ROI Category' datatype='string' name='[Calculation_113152993820057602]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1207527693873238027] &gt; 1 AND ((SUM([Calculation_1207527693872181257]) - [Calculation_1207527693864366083]) &gt; 0 and [Calculation_1207527693864366083] &lt;= 0) then &apos;Super Green&apos;&#13;&#10;ELSEIF [Calculation_1207527693873238027] &gt; 1 THEN &apos;Green&apos;&#13;&#10;ELSEIF [Calculation_1207527693873238027] &gt; 0 and [Calculation_1207527693873238027] &lt;=1 then &apos;Amber&apos;&#13;&#10;ELSEIF [Calculation_1207527693873238027] &lt;=0 and ([Calculation_1207527693864366083]&gt;0 and (SUM([Calculation_1207527693872181257]) - [Calculation_1207527693864366083])&lt;0) then &apos;Super Red&apos;&#13;&#10;ELSEIF [Calculation_1207527693873238027] &lt;=0 then &apos;Red&apos; END' />
      </column>
      <column caption='Revised ROI Category ' datatype='string' name='[Calculation_113152993820172291]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Revised ROI (copy)_1140536649589137411] &gt; 1 AND ((SUM([Calculation_1207527693872181257]) - [Revised tPro Net Cost (copy)_1140536649588908034]) &gt; 0 and [Revised tPro Net Cost (copy)_1140536649588908034] &lt;= 0) then &apos;Super Green&apos;&#13;&#10;ELSEIF [Revised ROI (copy)_1140536649589137411] &gt; 1 THEN &apos;Green&apos;&#13;&#10;ELSEIF [Revised ROI (copy)_1140536649589137411] &gt; 0 and [Revised ROI (copy)_1140536649589137411] &lt;=1 then &apos;Amber&apos;&#13;&#10;ELSEIF [Revised ROI (copy)_1140536649589137411] &lt;=0 and ([Revised tPro Net Cost (copy)_1140536649588908034]&gt;0 and (SUM([Calculation_1207527693872181257]) - [Revised tPro Net Cost (copy)_1140536649588908034])&lt;0) then &apos;Super Red&apos;&#13;&#10;ELSEIF [Revised ROI (copy)_1140536649589137411] &lt;=0 then &apos;Red&apos; END' />
      </column>
      <column caption='Current Delivery Cost' datatype='real' name='[Calculation_1207527693859401728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([df_commission]) + ZN([tmp_delivery_cost]) - ZN([talabat_df_funding])' />
      </column>
      <column caption='Current tPro Net Cost' datatype='real' name='[Calculation_1207527693864140802]' role='measure' type='quantitative'>
