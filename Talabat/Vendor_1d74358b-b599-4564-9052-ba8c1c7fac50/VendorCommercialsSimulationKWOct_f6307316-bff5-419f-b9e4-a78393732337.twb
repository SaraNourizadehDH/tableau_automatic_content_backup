          <datasource-dependencies datasource='federated.1awz3eo17rrpxr147d61v0ei292h'>
            <column caption='Revised ROI Category' datatype='string' name='[Calculation_113152993820057602]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1207527693873238027] &gt; 1 AND ((SUM([Calculation_1207527693872181257]) - [Calculation_1207527693864366083]) &gt; 0 and [Calculation_1207527693864366083] &lt;= 0) then &apos;Super Green&apos;&#13;&#10;ELSEIF [Calculation_1207527693873238027] &gt; 1 THEN &apos;Green&apos;&#13;&#10;ELSEIF [Calculation_1207527693873238027] &gt; 0 and [Calculation_1207527693873238027] &lt;=1 then &apos;Amber&apos;&#13;&#10;ELSEIF [Calculation_1207527693873238027] &lt;=0 and ([Calculation_1207527693864366083]&gt;0 and (SUM([Calculation_1207527693872181257]) - [Calculation_1207527693864366083])&lt;0) then &apos;Super Red&apos;&#13;&#10;ELSEIF [Calculation_1207527693873238027] &lt;=0 then &apos;Red&apos; END' />
            </column>
            <column caption='Current Delivery Cost' datatype='real' name='[Calculation_1207527693859401728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([df_commission]) + ZN([tmp_delivery_cost]) - ZN([talabat_df_funding])' />
            </column>
            <column caption='Current tPro Net Cost' datatype='real' name='[Calculation_1207527693864140802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1207527693859401728] - 0' />
            </column>
            <column caption='Revised tPro Net Cost' datatype='real' name='[Calculation_1207527693864366083]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_414894155213025280] - [Calculation_414894155214909442]' />
            </column>
            <column caption='Double Discounting Savings' datatype='real' name='[Calculation_1207527693865996293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;case [chain_name] when &apos;talabat mart&apos; THEN 0 &#13;&#10;ELSE&#13;&#10;case [tiers]&#13;&#10;WHEN &apos;0-3.5&apos; THEN [double_discounted_tgo_orders]*0 + ZN([talabat_df_funding])&#13;&#10;WHEN &apos;3.5-4.5&apos; THEN [double_discounted_tgo_orders]*[Parameters].[Parameter 1] + ZN([talabat_df_funding])&#13;&#10;WHEN &apos;4.5-6&apos; THEN [double_discounted_tgo_orders]*[Parameters].[Parameter 2] + ZN([talabat_df_funding])&#13;&#10;WHEN &apos;6-8&apos; THEN [double_discounted_tgo_orders]*[Parameters].[Parameter 3] + ZN([talabat_df_funding])&#13;&#10;WHEN &apos;8-10&apos; THEN [double_discounted_tgo_orders]*[Parameters].[Parameter 4] + ZN([talabat_df_funding])&#13;&#10;WHEN &apos;10+&apos; THEN [double_discounted_tgo_orders]*[Parameters].[Parameter 5] + ZN([talabat_df_funding]) END END)' />
            </column>
            <column caption='Current ROI' datatype='real' name='[Calculation_1207527693868830728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([proft_ps])/SUM([Calculation_1207527693859401728])' />
            </column>
            <column caption='Incremental Revenue' datatype='real' name='[Calculation_1207527693872181257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[proft_ps] + [Calculation_1207527693859401728] - 0' />
            </column>
            <column caption='Revised ROI' datatype='real' name='[Calculation_1207527693873238027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_1207527693872181257]) - [Calculation_1207527693864366083])/[Calculation_414894155213025280]' />
            </column>
            <column caption='Current Commission Capping Savings' datatype='integer' name='[Calculation_124130509041901568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Current ROI Category' datatype='string' name='[Calculation_124130509056589826]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1207527693868830728] &gt; 1 AND (SUM([proft_ps]) &gt; 0 and SUM([Calculation_1207527693864140802]) &lt;= 0) then &apos;Super Green&apos;&#13;&#10;ELSEIF [Calculation_1207527693868830728] &gt; 1 THEN &apos;Green&apos;&#13;&#10;ELSEIF [Calculation_1207527693868830728] &gt; 0 and [Calculation_1207527693868830728] &lt;=1 then &apos;Amber&apos;&#13;&#10;ELSEIF [Calculation_1207527693868830728] &lt;=0 and (SUM([Calculation_1207527693864140802])&gt;0 and SUM([proft_ps])&lt;0) then &apos;Super Red&apos;&#13;&#10;ELSEIF [Calculation_1207527693868830728] &lt;=0 then &apos;Red&apos; END' />
            </column>
            <column caption='Revised Profit' datatype='real' name='[Calculation_340866241904459776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_1207527693872181257]) - [Calculation_1207527693864366083])' />
            </column>
            <column caption='Revised Delivery Cost' datatype='real' name='[Calculation_414894155213025280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;case [chain_name] when &apos;talabat mart&apos; THEN 0 &#13;&#10;ELSE&#13;&#10;case [tiers]&#13;&#10;WHEN &apos;0-3.5&apos; THEN [Calculation_414894155214249985]*0&#13;&#10;WHEN &apos;3.5-4.5&apos; THEN ([Calculation_414894155214249985]*[Parameters].[Parameter 1] + ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END))&#13;&#10;WHEN &apos;4.5-6&apos; THEN ([Calculation_414894155214249985]*[Parameters].[Parameter 2] + ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END))&#13;&#10;WHEN &apos;6-8&apos; THEN ([Calculation_414894155214249985]*[Parameters].[Parameter 3] + ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END))&#13;&#10;WHEN &apos;8-10&apos; THEN ([Calculation_414894155214249985]*[Parameters].[Parameter 4] + ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END))&#13;&#10;WHEN &apos;10+&apos; THEN ([Calculation_414894155214249985]*[Parameters].[Parameter 5] + ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END)) END END)' />
            </column>
            <column caption='pro_orders_with_funding' datatype='integer' name='[Calculation_414894155214249985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[tgo_pro_orders] - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN [double_discounted_tgo_orders]&#13;&#10;ELSE 0 END)' />
            </column>
            <column caption='Commission Capping Savings' datatype='real' name='[Calculation_414894155214909442]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#13;&#10;WHEN &apos;None&apos; THEN 0 &#13;&#10;WHEN &apos;8&apos; THEN &#13;&#10;SUM(commission_capping_savings_with_8) &#13;&#10;WHEN &apos;10&apos; THEN &#13;&#10;SUM([commission_capping_savings_with_10])&#13;&#10;END' />
            </column>
            <column caption='Current TGO Delivery Cost' datatype='real' name='[Current Delivery Cost (copy)_856528413358215168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([df_commission])' />
            </column>
            <column caption='Current TMP Delivery Cost' datatype='real' name='[Current TGO Delivery Cost (copy)_856528413358329857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([tmp_delivery_cost]) - ZN([talabat_df_funding])' />
            </column>
            <column caption='Current tPro Net Cost TGO' datatype='real' name='[Current tPro Net Cost (copy)_856528413358940164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Current Delivery Cost (copy)_856528413358215168] - 0' />
            </column>
            <column caption='Current tPro Net Cost TMP' datatype='real' name='[Current tPro Net Cost TGO (copy)_856528413359022085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Current TGO Delivery Cost (copy)_856528413358329857] - 0' />
            </column>
            <column caption='Revised Delivery Cost TGO' datatype='real' name='[Revised Delivery Cost (copy)_856528413359378438]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;case [chain_name] when &apos;talabat mart&apos; THEN 0 &#13;&#10;ELSE&#13;&#10;case [tiers]&#13;&#10;WHEN &apos;0-3.5&apos; THEN [Calculation_414894155214249985]*0&#13;&#10;WHEN &apos;3.5-4.5&apos; THEN ([Calculation_414894155214249985]*[Parameters].[Parameter 1])&#13;&#10;WHEN &apos;4.5-6&apos; THEN ([Calculation_414894155214249985]*[Parameters].[Parameter 2])&#13;&#10;WHEN &apos;6-8&apos; THEN ([Calculation_414894155214249985]*[Parameters].[Parameter 3])&#13;&#10;WHEN &apos;8-10&apos; THEN ([Calculation_414894155214249985]*[Parameters].[Parameter 4])&#13;&#10;WHEN &apos;10+&apos; THEN ([Calculation_414894155214249985]*[Parameters].[Parameter 5]) END END)' />
            </column>
            <column caption='Revised Delivery Cost TMP' datatype='real' name='[Revised Delivery Cost (copy)_856528413360525319]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;case [chain_name] when &apos;talabat mart&apos; THEN 0 &#13;&#10;ELSE&#13;&#10;case [tiers]&#13;&#10;WHEN &apos;0-3.5&apos; THEN [Calculation_414894155214249985]*0&#13;&#10;WHEN &apos;3.5-4.5&apos; THEN (ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END))&#13;&#10;WHEN &apos;4.5-6&apos; THEN (ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END))&#13;&#10;WHEN &apos;6-8&apos; THEN (ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END))&#13;&#10;WHEN &apos;8-10&apos; THEN (ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END))&#13;&#10;WHEN &apos;10+&apos; THEN (ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END)) END END)' />
            </column>
            <column caption='Revised tPro Net Cost TGO' datatype='real' name='[Revised tPro Net Cost (copy)_856528413362335752]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Revised Delivery Cost (copy)_856528413359378438] - [Calculation_414894155214909442]' />
