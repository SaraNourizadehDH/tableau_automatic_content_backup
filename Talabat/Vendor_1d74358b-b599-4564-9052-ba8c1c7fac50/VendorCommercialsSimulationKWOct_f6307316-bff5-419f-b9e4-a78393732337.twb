      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1awz3eo17rrpxr147d61v0ei292h' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select % for 3.5-4.5' datatype='real' name='[Parameter 11]' param-domain-type='range' role='measure' type='quantitative' value='0.1'>
              <calculation class='tableau' formula='0.1' />
              <range min='0.01' />
            </column>
            <column caption='Select % for 4.5-6' datatype='real' name='[Parameter 12]' param-domain-type='range' role='measure' type='quantitative' value='0.1'>
              <calculation class='tableau' formula='0.1' />
              <range min='0.01' />
            </column>
            <column caption='Select % for 6-8' datatype='real' name='[Parameter 13]' param-domain-type='range' role='measure' type='quantitative' value='0.1'>
              <calculation class='tableau' formula='0.1' />
              <range min='0.01' />
            </column>
            <column caption='Select % for 8-10' datatype='real' name='[Parameter 14]' param-domain-type='range' role='measure' type='quantitative' value='0.1'>
              <calculation class='tableau' formula='0.1' />
              <range min='0.01' />
            </column>
            <column caption='Select % for 10+' datatype='real' name='[Parameter 15]' param-domain-type='range' role='measure' type='quantitative' value='0.1'>
              <calculation class='tableau' formula='0.1' />
              <range min='0.01' />
            </column>
            <column caption='Select Capped Charge' datatype='real' name='[Parameter 16]' param-domain-type='range' role='measure' type='quantitative' value='1.'>
              <calculation class='tableau' formula='1.' />
              <range granularity='0.1' max='1.0' min='0.4' />
            </column>
            <column caption='Double Discounting' datatype='string' name='[Parameter 6]' param-domain-type='list' role='measure' type='nominal' value='&quot;Covered&quot;'>
              <calculation class='tableau' formula='&quot;Covered&quot;' />
            </column>
            <column caption='Commission Cap' datatype='string' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='&quot;None&quot;'>
              <calculation class='tableau' formula='&quot;None&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1awz3eo17rrpxr147d61v0ei292h'>
            <column caption='Revised Profit ' datatype='real' name='[Calculation_113152993817866240]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_1207527693872181257]) - [Revised tPro Net Cost (copy)_1140536649588908034])' />
            </column>
            <column caption='Revised ROI Category ' datatype='string' name='[Calculation_113152993820172291]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Revised ROI (copy)_1140536649589137411] &gt; 1 AND ((SUM([Calculation_1207527693872181257]) - [Revised tPro Net Cost (copy)_1140536649588908034]) &gt; 0 and [Revised tPro Net Cost (copy)_1140536649588908034] &lt;= 0) then &apos;Super Green&apos;&#13;&#10;ELSEIF [Revised ROI (copy)_1140536649589137411] &gt; 1 THEN &apos;Green&apos;&#13;&#10;ELSEIF [Revised ROI (copy)_1140536649589137411] &gt; 0 and [Revised ROI (copy)_1140536649589137411] &lt;=1 then &apos;Amber&apos;&#13;&#10;ELSEIF [Revised ROI (copy)_1140536649589137411] &lt;=0 and ([Revised tPro Net Cost (copy)_1140536649588908034]&gt;0 and (SUM([Calculation_1207527693872181257]) - [Revised tPro Net Cost (copy)_1140536649588908034])&lt;0) then &apos;Super Red&apos;&#13;&#10;ELSEIF [Revised ROI (copy)_1140536649589137411] &lt;=0 then &apos;Red&apos; END' />
            </column>
            <column caption='Current Delivery Cost' datatype='real' name='[Calculation_1207527693859401728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([df_commission]) + ZN([tmp_delivery_cost]) - ZN([talabat_df_funding])' />
            </column>
            <column caption='Current tPro Net Cost' datatype='real' name='[Calculation_1207527693864140802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1207527693859401728] - 0' />
            </column>
            <column caption='Current ROI' datatype='real' name='[Calculation_1207527693868830728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([proft_ps])/SUM([Calculation_1207527693859401728])' />
            </column>
            <column caption='Incremental Revenue' datatype='real' name='[Calculation_1207527693872181257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[proft_ps] + [Calculation_1207527693859401728] - 0' />
            </column>
            <column caption='Current Commission Capping Savings' datatype='integer' name='[Calculation_124130509041901568]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Current ROI Category' datatype='string' name='[Calculation_124130509056589826]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1207527693868830728] &gt; 1 AND (SUM([proft_ps]) &gt; 0 and SUM([Calculation_1207527693864140802]) &lt;= 0) then &apos;Super Green&apos;&#13;&#10;ELSEIF [Calculation_1207527693868830728] &gt; 1 THEN &apos;Green&apos;&#13;&#10;ELSEIF [Calculation_1207527693868830728] &gt; 0 and [Calculation_1207527693868830728] &lt;=1 then &apos;Amber&apos;&#13;&#10;ELSEIF [Calculation_1207527693868830728] &lt;=0 and (SUM([Calculation_1207527693864140802])&gt;0 and SUM([proft_ps])&lt;0) then &apos;Super Red&apos;&#13;&#10;ELSEIF [Calculation_1207527693868830728] &lt;=0 then &apos;Red&apos; END' />
            </column>
            <column caption='pro_orders_with_funding' datatype='integer' name='[Calculation_414894155214249985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[tgo_pro_orders] - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN [double_discounted_tgo_orders]&#13;&#10;ELSE 0 END)' />
            </column>
            <column caption='Commission Capping Savings' datatype='real' name='[Calculation_414894155214909442]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 7]&#13;&#10;WHEN &apos;None&apos; THEN 0 &#13;&#10;WHEN &apos;8&apos; THEN &#13;&#10;SUM(commission_capping_savings_with_8) &#13;&#10;WHEN &apos;10&apos; THEN &#13;&#10;SUM([commission_capping_savings_with_10])&#13;&#10;END' />
            </column>
            <column caption='Current TGO Delivery Cost' datatype='real' name='[Current Delivery Cost (copy)_856528413358215168]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([df_commission])' />
            </column>
            <column caption='Current TMP Delivery Cost' datatype='real' name='[Current TGO Delivery Cost (copy)_856528413358329857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN([tmp_delivery_cost]) - ZN([talabat_df_funding])' />
            </column>
            <column caption='Current tPro Net Cost TGO' datatype='real' name='[Current tPro Net Cost (copy)_856528413358940164]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Current Delivery Cost (copy)_856528413358215168] - 0' />
            </column>
            <column caption='Current tPro Net Cost TMP' datatype='real' name='[Current tPro Net Cost TGO (copy)_856528413359022085]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Current TGO Delivery Cost (copy)_856528413358329857] - 0' />
            </column>
            <column caption='Double Discounting Savings ' datatype='real' name='[Double Discounting Savings (copy)_1140536649586982912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;case [chain_name] when &apos;talabat mart&apos; THEN 0 &#13;&#10;ELSE&#13;&#10;case [tiers]&#13;&#10;WHEN &apos;0-3.5&apos; THEN [double_discounted_tgo_orders]*0 + ZN([talabat_df_funding])&#13;&#10;WHEN &apos;3.5-4.5&apos; THEN [double_discounted_tgo_orders]*(IF [Parameters].[Parameter 11]*ROUND(afv,2) &gt; [Parameters].[Parameter 16] THEN [Parameters].[Parameter 16] ELSE [Parameters].[Parameter 11]*ROUND(afv,2) END) + ZN([talabat_df_funding])&#13;&#10;WHEN &apos;4.5-6&apos; THEN [double_discounted_tgo_orders]*(IF [Parameters].[Parameter 12]*ROUND(afv,2) &gt; [Parameters].[Parameter 16] THEN [Parameters].[Parameter 16] ELSE [Parameters].[Parameter 12]*ROUND(afv,2) END) + ZN([talabat_df_funding])&#13;&#10;WHEN &apos;6-8&apos; THEN [double_discounted_tgo_orders]*(IF [Parameters].[Parameter 13]*ROUND(afv,2) &gt; [Parameters].[Parameter 16] THEN [Parameters].[Parameter 16] ELSE [Parameters].[Parameter 13]*ROUND(afv,2) END) + ZN([talabat_df_funding])&#13;&#10;WHEN &apos;8-10&apos; THEN [double_discounted_tgo_orders]*(IF [Parameters].[Parameter 14]*ROUND(afv,2) &gt; [Parameters].[Parameter 16] THEN [Parameters].[Parameter 16] ELSE [Parameters].[Parameter 14]*ROUND(afv,2) END) + ZN([talabat_df_funding])&#13;&#10;WHEN &apos;10+&apos; THEN [double_discounted_tgo_orders]*(IF [Parameters].[Parameter 15]*ROUND(afv,2) &gt; [Parameters].[Parameter 16] THEN [Parameters].[Parameter 16] ELSE [Parameters].[Parameter 15]*ROUND(afv,2) END) + ZN([talabat_df_funding]) END END)' />
            </column>
            <column caption='Revised Delivery Cost TGO ' datatype='real' name='[Revised Delivery Cost  (copy)_856528413364113419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;case [chain_name] when &apos;talabat mart&apos; THEN 0 &#13;&#10;ELSE&#13;&#10;case [tiers]&#13;&#10;WHEN &apos;0-3.5&apos; THEN ZN([Calculation_414894155214249985])*0&#13;&#10;WHEN &apos;3.5-4.5&apos; THEN ZN([Calculation_414894155214249985])*(IF [Parameters].[Parameter 11]*ROUND(ZN(afv),2) &gt; [Parameters].[Parameter 16] THEN [Parameters].[Parameter 16] ELSE [Parameters].[Parameter 11]*ROUND(ZN(afv),2) END)&#13;&#10;WHEN &apos;4.5-6&apos; THEN ZN([Calculation_414894155214249985])*(IF [Parameters].[Parameter 12]*ROUND(ZN(afv),2) &gt; [Parameters].[Parameter 16] THEN [Parameters].[Parameter 16] ELSE [Parameters].[Parameter 12]*ROUND(ZN(afv),2) END)&#13;&#10;WHEN &apos;6-8&apos; THEN ZN([Calculation_414894155214249985])*(IF [Parameters].[Parameter 13]*ROUND(ZN(afv),2) &gt; [Parameters].[Parameter 16] THEN [Parameters].[Parameter 16] ELSE [Parameters].[Parameter 13]*ROUND(ZN(afv),2) END)&#13;&#10;WHEN &apos;8-10&apos; THEN ZN([Calculation_414894155214249985])*(IF [Parameters].[Parameter 14]*ROUND(ZN(afv),2) &gt; [Parameters].[Parameter 16] THEN [Parameters].[Parameter 16] ELSE [Parameters].[Parameter 14]*ROUND(ZN(afv),2) END)&#13;&#10;WHEN &apos;10+&apos; THEN ZN([Calculation_414894155214249985])*(IF [Parameters].[Parameter 15]*ROUND(ZN(afv),2) &gt; [Parameters].[Parameter 16] THEN [Parameters].[Parameter 16] ELSE [Parameters].[Parameter 15]*ROUND(ZN(afv),2) END)&#13;&#10;END END)' />
            </column>
            <column caption='Revised Delivery Cost ' datatype='real' name='[Revised Delivery Cost (copy)_1477462192815042563]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;case [chain_name] when &apos;talabat mart&apos; THEN 0 &#13;&#10;ELSE&#13;&#10;case [tiers]&#13;&#10;WHEN &apos;0-3.5&apos; THEN ZN([Calculation_414894155214249985])*0&#13;&#10;WHEN &apos;3.5-4.5&apos; THEN ZN([Calculation_414894155214249985])*(IF [Parameters].[Parameter 11]*ROUND(ZN(afv),2) &gt; [Parameters].[Parameter 16] THEN [Parameters].[Parameter 16] ELSE [Parameters].[Parameter 11]*ROUND(ZN(afv),2) END) + ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END)&#13;&#10;WHEN &apos;4.5-6&apos; THEN ZN([Calculation_414894155214249985])*(IF [Parameters].[Parameter 12]*ROUND(ZN(afv),2) &gt; [Parameters].[Parameter 16] THEN [Parameters].[Parameter 16] ELSE [Parameters].[Parameter 12]*ROUND(ZN(afv),2) END) + ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END)&#13;&#10;WHEN &apos;6-8&apos; THEN ZN([Calculation_414894155214249985])*(IF [Parameters].[Parameter 13]*ROUND(ZN(afv),2) &gt; [Parameters].[Parameter 16] THEN [Parameters].[Parameter 16] ELSE [Parameters].[Parameter 13]*ROUND(ZN(afv),2) END) + ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END)&#13;&#10;WHEN &apos;8-10&apos; THEN ZN([Calculation_414894155214249985])*(IF [Parameters].[Parameter 14]*ROUND(ZN(afv),2) &gt; [Parameters].[Parameter 16] THEN [Parameters].[Parameter 16] ELSE [Parameters].[Parameter 14]*ROUND(ZN(afv),2) END) + ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END)&#13;&#10;WHEN &apos;10+&apos; THEN ZN([Calculation_414894155214249985])*(IF [Parameters].[Parameter 15]*ROUND(ZN(afv),2) &gt; [Parameters].[Parameter 16] THEN [Parameters].[Parameter 16] ELSE [Parameters].[Parameter 15]*ROUND(ZN(afv),2) END) + ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END)&#13;&#10;END END)' />
            </column>
            <column caption='Revised Delivery Cost TMP' datatype='real' name='[Revised Delivery Cost (copy)_856528413360525319]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;case [chain_name] when &apos;talabat mart&apos; THEN 0 &#13;&#10;ELSE&#13;&#10;case [tiers]&#13;&#10;WHEN &apos;0-3.5&apos; THEN [Calculation_414894155214249985]*0&#13;&#10;WHEN &apos;3.5-4.5&apos; THEN (ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END))&#13;&#10;WHEN &apos;4.5-6&apos; THEN (ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END))&#13;&#10;WHEN &apos;6-8&apos; THEN (ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END))&#13;&#10;WHEN &apos;8-10&apos; THEN (ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END))&#13;&#10;WHEN &apos;10+&apos; THEN (ZN([tmp_delivery_cost]) - &#13;&#10;(CASE [Parameters].[Parameter 6] WHEN &apos;Covered&apos; THEN ZN([talabat_df_funding])&#13;&#10;ELSE 0 END)) END END)' />
            </column>
            <column caption='Revised ROI ' datatype='real' name='[Revised ROI (copy)_1140536649589137411]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_1207527693872181257]) - [Revised tPro Net Cost (copy)_1140536649588908034])/[Revised Delivery Cost (copy)_1477462192815042563]' />
            </column>
            <column caption='Revised tPro Net Cost TGO ' datatype='real' name='[Revised tPro Net Cost  (copy)_856528413364731917]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Revised Delivery Cost  (copy)_856528413364113419] - [Calculation_414894155214909442]' />
            </column>
