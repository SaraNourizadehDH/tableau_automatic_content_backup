      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1awz3eo17rrpxr147d61v0ei292h].[sum:commission_capping_savings_with_80:qk]&quot;' value='Current Commission Capping Savings' />
          <alias key='&quot;[federated.1awz3eo17rrpxr147d61v0ei292h].[sum:double_discounted_tgo_orders:qk]&quot;' value='Double Discounted Orders' />
