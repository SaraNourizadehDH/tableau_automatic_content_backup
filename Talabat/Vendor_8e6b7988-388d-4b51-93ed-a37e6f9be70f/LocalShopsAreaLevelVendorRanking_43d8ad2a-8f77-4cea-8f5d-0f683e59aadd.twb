        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1wvhrwv0e249251bh7o3e0sht2x9' name='Custom SQL Query' type='text'>WITH cte AS (
SELECT DISTINCT a.vendor_id, a.delivery_location_id, COUNT(DISTINCT CASE WHEN a.is_successful THEN a.order_id END) AS delivery_location_successful_order_count,
SUM(cpc_eur) AS cpc_eur
FROM `tlb-data-prod.data_platform.fct_order_info` a 
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` b ON a.vendor_id = b.vendor_id 
LEFT JOIN `tlb-data-prod.data_platform.sq_ls_non_commercial_revenue` c ON a.vendor_id = c.vendor_id AND a.order_date = c.date
WHERE a.order_date BETWEEN CURRENT_DATE() - 30 AND CURRENT_DATE() - 1
AND b.is_non_food 
AND NOT b.is_darkstore
GROUP BY ALL),

base AS (
  SELECT
    a.vendor_id,
    SAFE_CAST(a.is_tpro AS INT64) AS is_tpro,
    a.country_iso,
    c.area_name,
    c.area_lat,
    c.area_long,
    c.area_polygon,
    c.area_polygon_center,
    c.candidate_coordinates_lat,
    c.candidate_coordinates_lon,
    a.chain_id,
    a.chain_name_en,
    a.vertical,
    b.account_classification_segment,
    CASE WHEN cte.cpc_eur &gt;&gt; 0 THEN TRUE ELSE FALSE END AS is_cpc,
    a.name_en AS vendor_name,
    a.is_recent,
    a.is_loved_brand,
    a.is_specialty_store,
    a.is_on_pelican,
    a.is_on_catalog,
    a.is_tgo,
    a.net_not_failed_order_rate_last_30_days,
    a.net_failed_order_rate_last_30_days,
    a.net_chain_reorder_rate_last_30_days,
    a.successful_order_count_last_30_days,
    a.successful_orders_in_stock_rate_last_30_days,
    a.mean_sku_count_last_30_days,
    a.session_conversion_rate_last_30_days,
    a.average_basket_value_eur_last_30_days,
    a.total_gmv_eur_last_30_days,
    a.items_not_delivered_percentage_last_30_days,
    a.savings_per_gmv_percentage_last_30_days,
    cte.delivery_location_successful_order_count,
    1 - a.net_failed_order_rate_last_30_days AS inv_net_failed_rate,
    1 - a.items_not_delivered_percentage_last_30_days AS inv_items_not_delivered
  FROM cte 
  LEFT JOIN `tlb-data-prod.data_platform.agg_grocery_vendor_attributes_snapshot` a
  ON cte.vendor_id = a.vendor_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` b ON a.vendor_id = b.vendor_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` c ON cte.delivery_location_id = c.location_id
  WHERE b.is_non_food
    AND NOT b.is_darkstore
),

norm_area_level AS (
  SELECT *,
    -- Topline
    COALESCE((successful_order_count_last_30_days - MIN(successful_order_count_last_30_days) OVER (PARTITION BY country_iso, area_name, vertical)) /
    NULLIF(MAX(successful_order_count_last_30_days) OVER (PARTITION BY country_iso, area_name, vertical) - MIN(successful_order_count_last_30_days) OVER (PARTITION BY country_iso, area_name, vertical), 0),0)
    AS norm_orders,

    COALESCE((total_gmv_eur_last_30_days - MIN(total_gmv_eur_last_30_days) OVER (PARTITION BY country_iso, area_name, vertical)) /
    NULLIF(MAX(total_gmv_eur_last_30_days) OVER (PARTITION BY country_iso, area_name, vertical) - MIN(total_gmv_eur_last_30_days) OVER (PARTITION BY country_iso, area_name, vertical), 0),0)
    AS norm_gmv,

    -- Operations
    COALESCE((successful_orders_in_stock_rate_last_30_days - MIN(successful_orders_in_stock_rate_last_30_days) OVER (PARTITION BY country_iso, area_name, vertical)) /
    NULLIF(MAX(successful_orders_in_stock_rate_last_30_days) OVER (PARTITION BY country_iso, area_name, vertical) - MIN(successful_orders_in_stock_rate_last_30_days) OVER (PARTITION BY country_iso, area_name, vertical), 0),0)
    AS norm_stock,

    COALESCE((inv_net_failed_rate - MIN(inv_net_failed_rate) OVER (PARTITION BY country_iso, area_name, vertical)) /
    NULLIF(MAX(inv_net_failed_rate) OVER (PARTITION BY country_iso, area_name, vertical) - MIN(inv_net_failed_rate) OVER (PARTITION BY country_iso, area_name, vertical), 0),0)
    AS norm_netfail,

    COALESCE((inv_items_not_delivered - MIN(inv_items_not_delivered) OVER (PARTITION BY country_iso, area_name, vertical)) /
    NULLIF(MAX(inv_items_not_delivered) OVER (PARTITION BY country_iso, area_name, vertical) - MIN(inv_items_not_delivered) OVER (PARTITION BY country_iso, area_name, vertical), 0),0)
    AS norm_notdelivered,

    -- Choice
    COALESCE((mean_sku_count_last_30_days - MIN(mean_sku_count_last_30_days) OVER (PARTITION BY country_iso, area_name, vertical)) /
    NULLIF(MAX(mean_sku_count_last_30_days) OVER (PARTITION BY country_iso, area_name, vertical) - MIN(mean_sku_count_last_30_days) OVER (PARTITION BY country_iso, area_name, vertical), 0),0)
    AS norm_sku,

    -- Affordability
    COALESCE((savings_per_gmv_percentage_last_30_days - MIN(savings_per_gmv_percentage_last_30_days) OVER (PARTITION BY country_iso, area_name, vertical)) /
    NULLIF(MAX(savings_per_gmv_percentage_last_30_days) OVER (PARTITION BY country_iso, area_name, vertical) - MIN(savings_per_gmv_percentage_last_30_days) OVER (PARTITION BY country_iso, area_name, vertical), 0),0)
    AS norm_savings
  FROM base
),

scored_area_level AS (
  SELECT *,
    ROUND((
      -- Topline
      CASE country_iso WHEN &apos;AE&apos; THEN 0.20 WHEN &apos;BH&apos; THEN 0.20 WHEN &apos;EG&apos; THEN 0.20 WHEN &apos;JO&apos; THEN 0.25 WHEN &apos;KW&apos; THEN 0.20 WHEN &apos;OM&apos; THEN 0.25 WHEN &apos;QA&apos; THEN 0.20 ELSE 0 END * norm_orders +
      CASE country_iso WHEN &apos;AE&apos; THEN 0.20 WHEN &apos;BH&apos; THEN 0.20 WHEN &apos;EG&apos; THEN 0.20 WHEN &apos;JO&apos; THEN 0.20 WHEN &apos;KW&apos; THEN 0.25 WHEN &apos;OM&apos; THEN 0.20 WHEN &apos;QA&apos; THEN 0.25 ELSE 0 END * norm_gmv +

      -- Operations
      CASE country_iso WHEN &apos;AE&apos; THEN 0.10 WHEN &apos;BH&apos; THEN 0.10 WHEN &apos;EG&apos; THEN 0.10 WHEN &apos;JO&apos; THEN 0.10 WHEN &apos;KW&apos; THEN 0.15 WHEN &apos;OM&apos; THEN 0.05 WHEN &apos;QA&apos; THEN 0.20 ELSE 0 END * norm_stock +
      CASE country_iso WHEN &apos;AE&apos; THEN 0.20 WHEN &apos;BH&apos; THEN 0.10 WHEN &apos;EG&apos; THEN 0.10 WHEN &apos;JO&apos; THEN 0.10 WHEN &apos;KW&apos; THEN 0.10 WHEN &apos;OM&apos; THEN 0.10 WHEN &apos;QA&apos; THEN 0.05 ELSE 0 END * norm_netfail +
      CASE country_iso WHEN &apos;AE&apos; THEN 0.10 WHEN &apos;BH&apos; THEN 0.05 WHEN &apos;EG&apos; THEN 0.10 WHEN &apos;JO&apos; THEN 0.10 WHEN &apos;KW&apos; THEN 0.15 WHEN &apos;OM&apos; THEN 0.20 WHEN &apos;QA&apos; THEN 0.00 ELSE 0 END * norm_notdelivered +

      -- Choice
      CASE country_iso WHEN &apos;AE&apos; THEN 0.20 WHEN &apos;BH&apos; THEN 0.20 WHEN &apos;EG&apos; THEN 0.20 WHEN &apos;JO&apos; THEN 0.25 WHEN &apos;KW&apos; THEN 0.00 WHEN &apos;OM&apos; THEN 0.05 WHEN &apos;QA&apos; THEN 0.20 ELSE 0 END * norm_sku +

      -- Affordability
      CASE country_iso WHEN &apos;AE&apos; THEN 0.10 WHEN &apos;BH&apos; THEN 0.10 WHEN &apos;EG&apos; THEN 0.10 WHEN &apos;JO&apos; THEN 0.10 WHEN &apos;KW&apos; THEN 0.05 WHEN &apos;OM&apos; THEN 0.10 WHEN &apos;QA&apos; THEN 0.05 ELSE 0 END * norm_savings +
      CASE country_iso WHEN &apos;KW&apos; THEN 0.10 WHEN &apos;OM&apos; THEN 0.05 WHEN &apos;QA&apos; THEN 0.05 ELSE 0 END * is_tpro
    ), 4) AS ranking_score_area_level
  FROM norm_area_level
),

scored_segment_level AS (
  SELECT *,
    RANK() OVER (PARTITION BY country_iso, area_name, vertical ORDER BY ranking_score_area_level DESC) AS rank_in_area_level,

    -- Additional normalization per segment group
    RANK() OVER (
      PARTITION BY country_iso, area_name, vertical, account_classification_segment
      ORDER BY ranking_score_area_level DESC
    ) AS rank_in_segment_level,

    -- Optional: use same ranking score for segment rank or duplicate normalization again here if needed
    ranking_score_area_level AS ranking_score_segment_level
  FROM scored_area_level
)

, chain_ranked AS (
  SELECT
    country_iso,
    area_name,
    vertical,
    account_classification_segment,
    chain_name_en,

    AVG(rank_in_area_level) AS chain_avg_area_rank, -- Changed from MIN to AVG
    AVG(rank_in_segment_level) AS chain_avg_segment_rank, -- Changed from MIN to AVG

    RANK() OVER (
      PARTITION BY country_iso, area_name, vertical
      ORDER BY AVG(rank_in_area_level), AVG(ranking_score_area_level) -- Changed from MIN to AVG
    ) AS rank_chain_in_area_level,

    RANK() OVER (
      PARTITION BY country_iso, area_name, vertical, account_classification_segment
      ORDER BY AVG(rank_in_segment_level), AVG(ranking_score_segment_level) -- Changed from MIN to AVG
    ) AS rank_chain_in_segment_level

  FROM scored_segment_level
  GROUP BY country_iso, area_name, vertical, account_classification_segment, chain_name_en
)

-- SELECT DISTINCT *
-- FROM scored_segment_level
-- WHERE area_name = &apos;Downtown Burj Khalifa&apos;
-- ORDER BY country_iso, area_name, vertical, rank_in_area_level;

SELECT
  DISTINCT
  s.*,
  cr.rank_chain_in_area_level,
  cr.rank_chain_in_segment_level
FROM scored_segment_level s
LEFT JOIN chain_ranked cr
  ON s.country_iso = cr.country_iso
  AND s.area_name = cr.area_name
  AND s.vertical = cr.vertical
  AND s.account_classification_segment = cr.account_classification_segment
  AND s.chain_name_en = cr.chain_name_en
--   WHERE s.country_iso = &apos;AE&apos;
-- AND s.area_name = &apos;Downtown Burj Khalifa&apos;
ORDER BY s.country_iso, s.area_name, s.vertical, s.rank_in_area_level</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1wvhrwv0e249251bh7o3e0sht2x9' name='Custom SQL Query' type='text'>WITH cte AS (
