        <column-instance column='[account_classification_segment]' derivation='None' name='[none:account_classification_segment:nk]' pivot='key' type='nominal' />
        <column-instance column='[area_name]' derivation='None' name='[none:area_name:nk]' pivot='key' type='nominal' />
