      </extract>
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <date-options start-of-week='saturday' />
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Full Wallet Shate Query' id='_384FB76D40544306B11C78BA634C3F27'>
            <properties context=''>
              <relation connection='bigquery.14c0vff1rgjiah16wzjom1ixv0i2' name='Custom SQL Query' type='text'><![CDATA[WITH Chains_Base AS 
(
SELECT 
Order_Month,
BASE.country_code,
BASE.chain_name,
--BASE.chain_id,
BASE.is_nfv_preferred_partner,
CASE WHEN is_nfv_preferred_partner ='Yes' THEN 'AAA' ELSE 'Others' END AAA_Category,
account_manager_name,
-----------KPIs will Impact Investement Share --------------
COALESCE (successful_orders_count , 0) Successful_Orders_Count,
COALESCE (commission_rate , 0) commission_rate,
COALESCE (avg_delivery_fee_amount_v2_eur , 0) avg_delivery_fee_amount_v2_eur,
COALESCE (service_fee_amount_eur , 0) service_fee_amount_eur,
COALESCE (successful_commissionable_gmv_amount_eur , 0) successful_commissionable_gmv_amount_eur,
COALESCE (tpro_orders , 0) tpro_orders,
COALESCE (successful_tpro_commission_eur , 0) successful_tpro_commission_eur,
COALESCE (tpro_commission_fee_vat_eur , 0) tpro_commission_fee_vat_eur,
COALESCE (commission_amount_eur , 0) commission_amount_eur,
COALESCE (tgo_amount_eur , 0) tgo_amount_eur,
COALESCE (commission_amount_eur,0) + COALESCE (tgo_amount_eur,0) AS CR_Revenue,
COALESCE (vendor_incentive_cost_eur , 0) vendor_incentive_cost_eur,
COALESCE (Card_Handling_Fees,0) AS Card_Handling_Fees,
--------------Manual Grouping--------

CASE WHEN account_classification_segment  IN ('Darkstores','kiosks','Groceries','mini_market','hypermarket','supermarket','convenience' )
     THEN 'Grocery multi-category'
     WHEN account_classification_segment IN ('cosmetics','mother_and_baby' , 'optics','Beauty','health_and_wellness','Prescription Pharmacy','Pharmacy') 
     THEN 'Health & Beauty'
     WHEN account_classification_segment IN ('fishery','Drinks','frozen_food' ,'butchery','gourmet' , 'fruits_and_vegetables' , 'specialty_coffee_and_tea' , 'nuts_and_dried_fruits' ,              'specialty_and_ethnic' ,'Bakery' ,'snacks_and_sweets','dairy_products') THEN 'Specialty'
     WHEN account_classification_segment IN( 'Regular Restaurant','street_food')  THEN 'Food'
     WHEN account_classification_segment IN ('tobacco', 'Home Based Kitchen','Party Supplies','fashion','sports_and_lifestyle', 'Home & Gifts' ) THEN 'GM & Other'
     WHEN account_classification_segment = 'flowers_and_plants'  THEN 'Flowers'
     WHEN account_classification_segment IN('services' , 'games' ,'charity' ,'stationery_and_books', 'Electronics')  THEN 'GM & Other'
     WHEN account_classification_segment IN( 'pet_services' , 'Pets')  THEN 'Pet care'
     ELSE 'Others'
     END AS Classification_Group,
FROM
(
SELECT
Date_Trunc(foi.order_date,Month) AS Order_Month,
dci.country_code AS country_code,
dc.chain_name AS chain_name,
--dc.chain_id AS chain_id,
CASE 
    WHEN dvi.is_non_food 
    AND NOT dvi.is_darkstore 
    AND dvi.lead_data_origin = 'PP' THEN 'Yes' 
    ELSE 'No' 
END AS is_nfv_preferred_partner,
dc.account_manager_name AS account_manager_name,

-- Metrics calculations
COUNT(DISTINCT CASE WHEN foi.is_successful THEN foi.order_id END) AS successful_orders_count,

SAFE_DIVIDE(
    SUM(CASE WHEN fb.is_successful THEN COALESCE (fb.commission_amount_eur,0.00)  + COALESCE (fb.tgo_amount_eur,0.00) END),
    SUM(CASE WHEN fb.is_successful THEN fb.commissionable_gmv_amount_eur END))
AS commission_rate,

AVG(CASE WHEN foi.is_successful THEN foi.basket_amount_eur END) AS avg_basket_amount_eur,
AVG(CASE WHEN foi.is_successful THEN foi.delivery_fee_amount_eur END) AS avg_delivery_fee_amount_eur,
AVG(CASE 
        WHEN foi.is_successful 
        AND NOT (foi.dps_vendor_price_scheme_type = 'Campaign' AND foi.delivery_fee_amount_lc = 0.00) 
        THEN foi.delivery_fee_amount_eur 
    END) AS avg_delivery_fee_amount_v2_eur,

AVG(CASE WHEN foi.is_successful THEN foi.gmv_amount_eur END) AS avg_gmv_amount_eur,
SUM(foi.service_fee_amount_eur) AS service_fee_amount_eur,

SUM(CASE WHEN fb.is_successful THEN fb.commissionable_gmv_amount_eur END) AS successful_commissionable_gmv_amount_eur,

COUNT(DISTINCT CASE WHEN foi.is_tpro_order AND foi.is_successful THEN foi.order_id END) AS tpro_orders,
SUM(CASE WHEN fb.is_successful THEN fb.tpro_commission_eur END) AS successful_tpro_commission_eur,
SUM(fb.tpro_commission_fee_vat_eur) AS tpro_commission_fee_vat_eur,
SUM(fb.commission_amount_eur) AS commission_amount_eur,
SUM(fb.tgo_amount_eur) AS tgo_amount_eur,
COALESCE(SUM(fiod.vendor_incentive_cost_eur), 0) AS vendor_incentive_cost_eur,
SUM (COALESCE (debit_card_handling_fee_eur,0)) + SUM (COALESCE (credit_card_handling_fee_eur,0)) AS Card_Handling_Fees, 
----------------CHAIN CLASSIFICATION-----------------
MAX(dvi.account_classification_segment) account_classification_segment

FROM `tlb-data-prod.data_platform.fct_order_info` AS foi

INNER JOIN `tlb-data-prod.data_platform.dim_vendor_info` AS dvi 
    ON dvi.vendor_id = foi.vendor_id

INNER JOIN `tlb-data-prod.data_platform.dim_chain` AS dc 
    ON dc.chain_id = foi.chain_id
    
INNER JOIN `tlb-data-prod.data_platform.dim_country_info` AS dci 
    ON dci.country_id = foi.country_id

LEFT JOIN `tlb-data-prod.data_platform.fct_incentive_order_detail` AS fiod 
    ON fiod.order_id = foi.order_id
    AND fiod.order_date BETWEEN '2024-11-01' AND current_date -1 
       
LEFT JOIN `tlb-data-prod.data_platform.fct_billing` AS fb 
    ON fb.order_id = foi.order_id
    AND fb.billing_date BETWEEN '2024-11-01' AND current_date -1 
    
WHERE foi.order_date BETWEEN '2024-11-01' AND current_date -1 
  AND NOT COALESCE (foi.is_darkstore , TRUE)
  AND foi.is_non_food
  AND foi.is_successful
  AND (foi.delivery_arrangement != 'TMP' OR foi.delivery_arrangement IS NULL)
  AND (UPPER(dci.country_code) NOT IN ('IQ', 'SA') OR dci.country_code IS NULL)
  -----------_FOR TESTING-------------
--   AND dc.chain_id IN (634298,679653)
GROUP BY ALL
)Base 

),
ADREV AS
(
SELECT
DATE_TRUNC(ADRev.DATE ,MONTH) ADREV_Month,
DC.chain_name,
DVI.country_code,
SUM(COALESCE (cpc_eur,0) + 
    COALESCE(display_eur,0)+
    COALESCE(gem_eur,0)+
    COALESCE(deal_targeting_eur,0)-
    COALESCE(cpc_credit_eur,0)
   ) AS Total_ADRev 
FROM `tlb-data-prod.data_platform.sq_ls_non_commercial_revenue` ADRev 
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` DVI on ADRev.vendor_id = DVI.vendor_id
LEFT JOIN `tlb-data-prod.data_platform.dim_chain` DC ON DVI.chain_id = DC.chain_id
WHERE Date BETWEEN '2024-11-01' AND  current_date -1 
-----------------_FOR TESTING-------------
-- AND DVI.chain_id IN (634298,679653)
GROUP BY ALL
),
Chain_Mapping_And_Calc AS
(
SELECT  
CB.*,
----------------KPIs will impact investment percentage for each chain------------
COALESCE (successful_tpro_commission_eur,0) + COALESCE (tpro_commission_fee_vat_eur,0) AS tpro_total_charge,
SAFE_DIVIDE ((COALESCE (successful_tpro_commission_eur,0)+ COALESCE (tpro_commission_fee_vat_eur,0)) ,COALESCE (tpro_orders,0)) AS tpro_actual_charge_per_order,

SAFE_DIVIDE((COALESCE (successful_tpro_commission_eur,0) + COALESCE (tpro_commission_fee_vat_eur,0)) , COALESCE (successful_commissionable_gmv_amount_eur,0)) AS tpro_percent_gmv,

SAFE_DIVIDE(CASE WHEN Total_ADRev >> 0 THEN COALESCE (Total_ADRev,0) ELSE 0 END, COALESCE (successful_commissionable_gmv_amount_eur,0)) AS AD_revenue,
COALESCE (Total_ADRev,0) AS AD_Revenue_amount,

SAFE_DIVIDE(COALESCE (vendor_incentive_cost_eur,0), COALESCE (successful_commissionable_gmv_amount_eur,0)) AS vendor_funded_vouchers,

CASE WHEN CB.AAA_Category ='AAA'  AND Classification_Group = 'Grocery multi-category' AND picker_pay_structure ='Vendor Funded' THEN Cost_per_Order_EUR_AAA*successful_orders_count
     WHEN CB.AAA_Category ='Others'  AND Classification_Group = 'Grocery multi-category' AND picker_pay_structure ='Vendor Funded' THEN Cost_per_Order_EUR_NON_AAA*successful_orders_count
     ELSE 0 END AS vendor_shopper_investment ,
 ABS(SAFE_DIVIDE (CASE WHEN CB.AAA_Category ='AAA'  AND Classification_Group = 'Grocery multi-category' AND picker_pay_structure ='Vendor Funded' THEN Cost_per_Order_EUR_AAA*successful_orders_count
     WHEN CB.AAA_Category ='Others'  AND Classification_Group = 'Grocery multi-category' AND picker_pay_structure ='Vendor Funded' THEN Cost_per_Order_EUR_NON_AAA*successful_orders_count
     ELSE 0 END , COALESCE (successful_commissionable_gmv_amount_eur,0))) AS vendor_shopper_investment_percent_gmv ,
--------------- Total Investment Share per each chain-----------------
------Commision Rate-------
COALESCE (commission_rate,0) + 
----------- TPRO COmmison rate--------
SAFE_DIVIDE((COALESCE (successful_tpro_commission_eur,0) + COALESCE (tpro_commission_fee_vat_eur,0)) , COALESCE (successful_commissionable_gmv_amount_eur,0)) 
+
------------ AD REVENUE Commision Rate ----------
SAFE_DIVIDE(COALESCE (Total_ADRev,0), COALESCE (successful_commissionable_gmv_amount_eur,0))
+
-------------Vendor Incentive Comission Rate ---------
SAFE_DIVIDE(COALESCE (vendor_incentive_cost_eur,0), COALESCE (successful_commissionable_gmv_amount_eur,0)) 
+
---------- Shopper investment rate ----------
 ABS
 (
     SAFE_DIVIDE (CASE WHEN CB.AAA_Category ='AAA'  AND Classification_Group = 'Grocery multi-category' AND picker_pay_structure ='Vendor Funded' THEN Cost_per_Order_EUR_AAA*successful_orders_count
     WHEN CB.AAA_Category ='Others'  AND Classification_Group = 'Grocery multi-category' AND picker_pay_structure ='Vendor Funded' THEN Cost_per_Order_EUR_AAA*successful_orders_count
      ELSE 0 END , COALESCE (successful_commissionable_gmv_amount_eur,0))

  )
+
SAFE_DIVIDE(COALESCE (Card_Handling_Fees ,0) , COALESCE (successful_commissionable_gmv_amount_eur,0)) 

  AS total_investment_as_percent_gmv,
-------------------Classification Categories Number-------------
CASE WHEN AAA_Category ='AAA' THEN '6'
     WHEN Classification_Group = 'Grocery multi-category' THEN '1'
     WHEN Classification_Group = 'Specialty' THEN '2' 
     WHEN Classification_Group = 'Health & Beauty' THEN '3'
     WHEN Classification_Group = 'Flowers'  THEN '4'
     WHEN Classification_Group = 'Others'  THEN '5'
     WHEN Classification_Group = 'Pet care' THEN '7'
     ELSE '0' END Category_number, 
--------------MANUAL TARGETS AND ASSUMED MARGINS FOR EACH CATEGORY FOR EACH MONTH--------
COALESCE (AMT.Assumed_margin,0.00)*100 AS Assumed_Margin,
COALESCE (AMT.Target,0.00)*100 AS Targets,
----------------------Shoppers Data Manual Sheet---------
COALESCE (PPS.picker_pay_structure , 'Vendor Funded') AS picker_pay_structure,
COALESCE (Cost_per_Order_EUR_AAA,0.00) AS Cost_per_Order_EUR_AAA,
COALESCE (Cost_per_Order_EUR_NON_AAA,0.00) AS Cost_per_Order_EUR_NON_AAA

FROM Chains_Base CB 
LEFT JOIN ADREV AD on CB.chain_name = AD.chain_name AND CB.country_code = AD.country_code AND CB.Order_Month = AD.ADREV_Month
LEFT JOIN `tlb-data-prod.data_platform_google_sheet.monthly_grocery_chains_pay_picker_structure`  PPS ON CB.chain_name = PPS.chain_name AND CB.country_code = PPS.country_code AND CB.order_Month = CAST(PPS.Month AS DATE)
LEFT JOIN `tlb-data-prod.data_platform_google_sheet.assumed_cost_per_order_for_shoppers` CPO_Shopper ON CB.country_code = CPO_Shopper.country_code
LEFT JOIN `tlb-data-prod.data_platform_google_sheet.monthly_grocery_assumed_margins_and_targets` AMT ON CB.country_code = AMT.country_code AND CB.Order_Month = CAST (AMT.Month AS DATE)
AND CASE WHEN AAA_Category ='AAA' THEN 6
         WHEN Classification_Group = 'Grocery multi-category' THEN 1
         WHEN Classification_Group = 'Specialty' THEN 2 
         WHEN Classification_Group = 'Health & Beauty' THEN 3
         WHEN Classification_Group = 'Flowers'  THEN 4
         WHEN Classification_Group = 'Others'  THEN 5
         WHEN Classification_Group = 'Pet care' THEN 7
         ELSE 0 END = AMT.Category_number 
--WHERE CB.country_code ='AE' 
---------FOR TESTING
-- AND CB.chain_id IN (634298,679653)

),

Percentile_data AS
(
SELECT
Order_Month,
Category_number,
Country_code,
APPROX_QUANTILES(commission_rate, 100)[OFFSET(25)] AS percentile_25,
APPROX_QUANTILES(commission_rate, 100)[OFFSET(50)] AS percentile_50,
APPROX_QUANTILES(commission_rate, 100)[OFFSET(75)] AS percentile_75,
APPROX_QUANTILES(commission_rate, 100)[OFFSET(90)] AS percentile_90
FROM Chain_Mapping_And_Calc
-------------_FOR TESTING-------
-- WHERE chain_id IN (634298,679653)
GROUP BY ALL
),

wallet_share AS
(
SELECT 
CMAC.*,
SAFE_DIVIDE(COALESCE (total_investment_as_percent_gmv , 0) * 100  , COALESCE (Assumed_Margin,0)) AS  est_wallet_share,
COALESCE (Targets,0) - (SAFE_DIVIDE(COALESCE (total_investment_as_percent_gmv , 0)*100 , COALESCE (Assumed_Margin,0))*100 ) AS target_vs_assumed_wallet_share,
CASE WHEN  COALESCE (Targets,0) - (SAFE_DIVIDE(COALESCE (total_investment_as_percent_gmv , 0) * 100 , COALESCE (Assumed_Margin,0)))*100 <<=3.00 THEN 'Low-No focus'
      WHEN COALESCE (Targets,0) - (SAFE_DIVIDE(COALESCE (total_investment_as_percent_gmv , 0) * 100 , COALESCE (Assumed_Margin,0)))*100 <<=15.00 THEN 'Medium'
      WHEN COALESCE (Targets,0) - (SAFE_DIVIDE(COALESCE (total_investment_as_percent_gmv , 0) * 100 , COALESCE (Assumed_Margin,0)))*100 >> 15.00 THEN 'High'
      END AS Opportunity_in_Wallet_share,
CASE WHEN COALESCE (tpro_percent_gmv,0)*100 = 0 THEN 'T-Pro'
     WHEN COALESCE (tpro_percent_gmv,0)*100 >> 0 AND COALESCE (commission_rate,0) * 100 << percentile_75 * 100 THEN 'CR'
     ELSE 'NCR' END AS first_Priority,
percentile_75 AS CR_Percentile 
FROM Chain_Mapping_And_Calc CMAC
LEFT JOIN Percentile_data PD ON CMAC.country_code = PD.country_code AND CMAC.category_number = PD.category_number AND CMAC.Order_Month = PD.Order_Month
--------------FOR TESTING--------------------
-- WHERE CMAC.chain_id IN (634298,679653)
),
vendor_size AS
(
-----------------To Calculate Vendor Sizing based on country,category  AND cohort ---------Results Should be one of Q1 , Q@ , Q3 AND Q4-------
SELECT
Order_Month,
Category_number,
Country_code,
--Opportunity_in_Wallet_share,
APPROX_QUANTILES(successful_commissionable_gmv_amount_eur, 4)[OFFSET(1)] AS Q1,
APPROX_QUANTILES(successful_commissionable_gmv_amount_eur, 4)[OFFSET(2)] AS Q2,
APPROX_QUANTILES(successful_commissionable_gmv_amount_eur, 4)[OFFSET(3)] AS Q3,
APPROX_QUANTILES(successful_commissionable_gmv_amount_eur, 4)[OFFSET(4)] AS Q4
FROM wallet_share
--------------FOR TESTING--------------------
-- WHERE chain_id IN (634298,679653)
GROUP BY ALL
)
SELECT 
WS.Order_Month,
WS.country_code,
-----------Removed as we have maulltiple IDs related to the same chain name 
--WS.chain_id,
----------
WS.chain_name,
WS.classification_group,
WS.picker_pay_structure,
WS.category_number,
-----Gonzalo feedback 26/5/2025
--CASE WHEN WS.AAA_Category = 'AAA' THEN 'AAA' ELSE CONCAT(WS.category_number ,'--', WS.classification_group) END AS Category_Details,
CASE WHEN WS.AAA_Category = 'AAA' THEN 'AAA' ELSE WS.classification_group  END AS Category_Details,
WS.AAA_Category,
WS.account_manager_name,
WS.Successful_Orders_Count AS successful_orders,
WS.successful_commissionable_gmv_amount_eur AS gmv_eur,
---------------------------IMPACT ON WALLET SHARE AMOUNTS --------
---Commission Data---
WS.commission_amount_eur AS commission_amount_eur,
WS.tgo_amount_eur AS tgo_amount_eur,
COALESCE (WS.commission_amount_eur,0) + COALESCE (tgo_amount_eur,0) AS CR_Revenue,
-----Tpro--
WS.tpro_orders AS tpro_orders,
WS.successful_tpro_commission_eur AS TPro_Commission_Amount,
WS.tpro_commission_fee_vat_eur AS TPro_Commission_Fee_VAT_Amount,
WS.tpro_total_charge,
-----AD Revenue---
COALESCE (WS.AD_Revenue_amount,0) AS AD_Revenue_Amount,
----------Vendor Vouchers----
COALESCE (WS.vendor_incentive_cost_eur,0) AS vendor_incentive_cost_eur,
COALESCE (WS.vendor_incentive_cost_eur,0) AS Vendor_Couchers_Amount,
-------Shoppers------
COALESCE (WS.vendor_shopper_investment,0) AS vendor_shopper_investment_Amount,
--------------Card Handling Fees
COALESCE (WS.Card_Handling_Fees,0) AS Card_Handling_Fees,
---------------------------IMPACT ON WALLET SHARE Percentages --------
WS.commission_rate AS commission_rate ,
WS.tpro_percent_gmv AS tpro_percent_gmv,
WS.AD_revenue AS ad_revenue_percent_gmv,
WS.vendor_funded_vouchers  AS vendor_funded_vouchers_percent_gmv,
WS.vendor_shopper_investment_percent_gmv AS vendor_shopper_investment_percent_gmv,
---------------SUM OF THE ABOVE-------- TOTAL INVESTMENT PERCENTAGE FROM GMV---------
CASE WHEN WS.total_investment_as_percent_gmv >> 1 THEN 1 ELSE  WS.total_investment_as_percent_gmv END AS total_investment_as_percent_gmv,
------------------TARGETS AND ASSUMED MARGINS-------
--------TARGETS PER Country , Category AND AAA FLAG ----------ASSUMED MARGIN BASED ON THE SAME -----
WS.Targets AS targets,
WS.assumed_margin AS fixed_assumed_margin,
--------------------- TOTAL INVESTMENT PERCENTAGE FROM GMV / ASSUMED MARGIN 
CASE WHEN WS.est_wallet_share * 100 >> 100.00 THEN 1 ELSE WS.est_wallet_share END AS estimated_wallet_share,
CASE WHEN vendor_shopper_investment_percent_gmv * 100 >>= 100.00 THEN 'Shopper investment is more than GMV for this month'
     WHEN WS.vendor_funded_vouchers *100 >>= 100.00 THEN 'Vendor Funded Vouchers investment is more than GMV for this month'
     WHEN WS.AD_revenue*100 >>= 100.00 THEN 'AD Revenue investment is more than GMV for this month'
     WHEN WS.tpro_percent_gmv*100 >>= 100.00 THEN 'T-Pro investment is more than GMV for this month'
     WHEN WS.est_wallet_share >> 100.00 THEN 'Sum of all Investment Factors  is more than assumed margin for this month' END AS Comment,
--------- Targets - estimated wallet share ----------
WS.target_vs_assumed_wallet_share,
-------------- Tiering based on target_vs_assumed_wallet_share---------
WS.Opportunity_in_Wallet_share,
-------------- what we should focus on for this chain to increase investment share -------
WS.first_Priority AS Prioritization,
------Vendor Sizing calculation ------------
CASE WHEN successful_commissionable_gmv_amount_eur <<= Q1 THEN 'Q1'
     WHEN successful_commissionable_gmv_amount_eur <<= Q2 THEN 'Q2'
     WHEN successful_commissionable_gmv_amount_eur <<= Q3 THEN 'Q3'
     WHEN successful_commissionable_gmv_amount_eur <<= Q4 THEN 'Q4' 
     ELSE 'Unknown' END vendor_size_within_cohort,
WS.CR_Percentile
FROM wallet_share WS
LEFT JOIN vendor_size VS ON WS.category_number = VS.category_number AND WS.country_code = VS.country_code  AND WS.Order_Month = VS.Order_Month
JOIN `tlb-data-prod.data_platform.dim_date` DD ON WS.order_month = DD.date AND current_date >> DD.month_end_date AND DD.date <<= Current_date]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
