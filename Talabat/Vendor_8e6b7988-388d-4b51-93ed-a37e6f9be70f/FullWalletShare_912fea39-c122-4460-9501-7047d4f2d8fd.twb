        <zone h='10500' id='11' is-centered='0' is-scaled='1' param='Image/Screenshot 2025-04-30 at 5.30.39 PM.png' type-v2='bitmap' w='11800' x='82000' y='56200' />
        <zone h='10200' id='12' is-centered='0' is-scaled='1' param='Image/Screenshot 2025-04-30 at 5.31.26 PM.png' type-v2='bitmap' w='11900' x='83700' y='68500' />
        <zone h='13500' id='15' is-centered='0' is-scaled='1' param='Image/Screenshot 2025-04-30 at 5.35.18 PM.png' type-v2='bitmap' w='9500' x='45300' y='79000' />
        <zone h='3100' id='74' is-centered='0' is-scaled='1' param='Image/Talabat-New-Brand-Logo-Colour-1 1 1.png' type-v2='bitmap' w='20000' x='78100' y='2700' />
