              <calculation class='tableau' formula='SUM([Card_Handling_Fees])/SUM([gmv_eur])' />
            </column>
            <column datatype='real' name='[CR_Revenue]' role='measure' type='quantitative' />
            <column caption='NCR_Driver' datatype='real' name='[Calculation_1538682967867633665]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([AD_Revenue_Amount])/SUM([gmv_eur])' />
            </column>
            <column caption='CR_Driver' datatype='real' name='[Calculation_1538682967868137474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([CR_Revenue])/SUM([gmv_eur])' />
            </column>
            <column caption='Tpro_Driver' datatype='real' name='[Calculation_1538682967868436483]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([tpro_total_charge])/SUM([gmv_eur])' />
            </column>
            <column caption='Shopper_Driver' datatype='real' name='[Calculation_1538682967868751876]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(ABS([vendor_shopper_investment_Amount]))/SUM([gmv_eur])' />
