    <dashboard _.fcp.AccessibleZoneTabOrder.true...enable-sort-zone-taborder='true' name='Defintions '>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ff5900'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='http://ip-172-31-0-197:8389/t/Talabat/workbooks/FullWalletShareWIP/Defintions?rev=' id='Defintions' path='/t/Talabat/workbooks/FullWalletShareWIP' revision='' site='Talabat' />
      <style />
      <size maxheight='1000' maxwidth='1000' minheight='1000' minwidth='1000' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98400' id='7' param='vert' type-v2='layout-flow' w='98400' x='800' y='800'>
            <zone fixed-size='52' h='6000' id='8' is-fixed='true' type-v2='title' w='98400' x='800' y='800'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='solid' />
                <format attr='border-width' value='1' />
                <format attr='margin' value='4' />
                <format attr='background-color' value='#411517' />
              </zone-style>
            </zone>
            <zone fixed-size='911' h='91100' id='3' is-fixed='true' param='horz' type-v2='layout-flow' w='98400' x='800' y='6800'>
              <zone forceUpdate='true' h='91100' id='5' type-v2='text' w='98400' x='800' y='6800'>
                <formatted-text>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>Dashboard Purpose</run>
                  <run bold='true' fontcolor='#404040' fontname='DeepSeek-CJK-patch'>: </run>
                  <run fontcolor='#411517' fontname='DeepSeek-CJK-patch'>The dashboard evaluates whether chains are investing sufficiently in Talabat by comparing each chain&apos;s investment against the assumed margin on a monthly basis.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>Date Frequency</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#411517' fontname='DeepSeek-CJK-patch'>The dashboard uses </run>
                  <run bold='true' fontcolor='#411517' fontname='DeepSeek-CJK-patch'>monthly</run>
                  <run fontcolor='#411517' fontname='DeepSeek-CJK-patch'> data for analysis.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>Manual File Path:</run>
                  <run fontcolor='#411517' fontname='DeepSeek-CJK-patch'>Æ </run>
                  <run auto-url='true' fontcolor='#411517' fontname='DeepSeek-CJK-patch' hyperlink='tabdoc:load-url url=&amp;quot;https://docs.google.com/spreadsheets/d/1yCEVUwAJjGhQlo6UrGMRlzkwZVXSpH_w6mxtsmRb6Vg/edit?gid=0#gid=0&amp;quot;'>https://docs.google.com/spreadsheets/d/1yCEVUwAJjGhQlo6UrGMRlzkwZVXSpH_w6mxtsmRb6Vg/edit?gid=0#gid=0</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>Column Definitions</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>1- Opportunity</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>Description</run>
                  <run fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>:</run>
                  <run fontcolor='#404040' fontname='DeepSeek-CJK-patch'>Æ </run>
                  <run fontcolor='#411517' fontname='DeepSeek-CJK-patch'>Indicates the investment gap relative to the assumed margin.</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>Values</run>
                  <run fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>:</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>A- Low Focus</run>
                  <run fontcolor='#404040' fontname='DeepSeek-CJK-patch'>: </run>
                  <run fontcolor='#411517' fontname='DeepSeek-CJK-patch'>If the difference is less than 3.</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>B- Medium</run>
                  <run fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>: </run>
                  <run fontcolor='#411517' fontname='DeepSeek-CJK-patch'>If the difference is between 3 and 15.</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>C- High</run>
                  <run fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>:</run>
                  <run fontcolor='#411517' fontname='DeepSeek-CJK-patch'> If the difference exceeds 15.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>Calculation</run>
                  <run fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#411517' fontname='Menlo'>(Targets - Total Investments) / Assumed Margin</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>A- Targets</run>
                  <run fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>:</run>
                  <run fontcolor='#404040' fontname='DeepSeek-CJK-patch'>Æ </run>
                  <run fontcolor='#411517' fontname='DeepSeek-CJK-patch'>Manually set per category and country.</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>B- Total Investments</run>
                  <run fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>:</run>
                  <run fontcolor='#404040' fontname='DeepSeek-CJK-patch'>Æ </run>
                  <run fontcolor='#411517' fontname='DeepSeek-CJK-patch'>Includes Commission Rate % , T-Pro %, Vendor Funded Vouchers %, Ad Revenue %, and Shopper %.</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>C- Assumed Margin</run>
                  <run fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>: </run>
                  <run fontcolor='#411517' fontname='DeepSeek-CJK-patch'>Fixed manually per category for the entire year.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>2- Prioritization</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>Description</run>
                  <run fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>: </run>
                  <run fontcolor='#411517' fontname='DeepSeek-CJK-patch'>Determines the priority level of each chain based on investment and commission rate.</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>Values</run>
                  <run fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>:</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>A- T-Pro</run>
                  <run fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>:</run>
                  <run fontcolor='#404040' fontname='DeepSeek-CJK-patch'>Æ </run>
                  <run fontcolor='#411517' fontname='DeepSeek-CJK-patch'>Assigned if the chain has </run>
                  <run bold='true' fontcolor='#411517' fontname='DeepSeek-CJK-patch'>zero</run>
                  <run fontcolor='#411517' fontname='DeepSeek-CJK-patch'> T-Pro investment.</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>B- CR (Commission Rate)</run>
                  <run fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>: </run>
                  <run fontcolor='#411517' fontname='DeepSeek-CJK-patch'>Assigned if the chain&apos;s commission rate is below the </run>
                  <run bold='true' fontcolor='#411517' fontname='DeepSeek-CJK-patch'>75th percentile</run>
                  <run fontcolor='#411517' fontname='DeepSeek-CJK-patch'> for its category.</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>C- NCR (Non-Commission Rate)</run>
                  <run fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>:</run>
                  <run fontcolor='#404040' fontname='DeepSeek-CJK-patch'>Æ </run>
                  <run fontcolor='#411517' fontname='DeepSeek-CJK-patch'>Default value for chains that do not meet the above criteria.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>3- Vendor Size</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>Description</run>
                  <run fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>: </run>
                  <run fontcolor='#411517' fontname='DeepSeek-CJK-patch'>Segments chains based on their GMV (Gross Merchandise Value) relative to category and opportunity benchmarks.</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>Values</run>
                  <run fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>: </run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>Q1, Q2, Q3, Q4</run>
                  <run fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>Æ </run>
                  <run fontcolor='#411517' fontname='DeepSeek-CJK-patch'>(representing the four quartiles of GMV distribution).</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>Assignment</run>
                  <run fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>:</run>
                  <run fontcolor='#404040' fontname='DeepSeek-CJK-patch'>Æ </run>
                  <run fontcolor='#411517' fontname='DeepSeek-CJK-patch'>Each chain is categorized into a quartile by comparing its GMV against the GMV distribution for its category and opportunity.</run>
                  <run>Æ&#10;&#10;</run>
                  <run bold='true' fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>4- Category</run>
                  <run fontcolor='#ff5900' fontname='DeepSeek-CJK-patch'>:</run>
                  <run fontcolor='#404040' fontname='DeepSeek-CJK-patch'>Æ </run>
                  <run fontcolor='#411517' fontname='DeepSeek-CJK-patch'>Manually mapped based on account classification segments.</run>
                  <run>Æ&#10;&#10;</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                  <format attr='background-color' value='#f5eee4' />
                </zone-style>
              </zone>
            </zone>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='background-color' value='#f5eee4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
