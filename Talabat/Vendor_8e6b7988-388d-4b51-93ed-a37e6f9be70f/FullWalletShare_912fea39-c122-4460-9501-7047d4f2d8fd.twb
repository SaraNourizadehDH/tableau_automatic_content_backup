      <table>
        <view>
          <datasources>
            <datasource caption='Full Wallet Share Query' name='federated.0gnkd0x1g6eawy1g3qs7r07f5dbi' />
          </datasources>
          <datasource-dependencies datasource='federated.0gnkd0x1g6eawy1g3qs7r07f5dbi'>
            <column datatype='string' name='[AAA_Category]' role='dimension' type='nominal' />
            <column caption='Card Handling Driver' datatype='real' name='[CR_Driver (copy)_3848888855828680704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Card_Handling_Fees])/SUM([gmv_eur])' />
            </column>
            <column caption='CAT Targets' datatype='real' name='[Calculation_5367094496580657155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[targets]/100' />
            </column>
            <column caption='MIN Month' datatype='date' name='[Calculation_5625418153654575107]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MIN([Order_Month])' />
            </column>
            <column datatype='real' name='[Card_Handling_Fees]' role='measure' type='quantitative' />
            <column caption='Category' datatype='string' name='[Category_Details]' role='dimension' type='nominal' />
            <column datatype='string' name='[Comment]' role='dimension' type='nominal' />
            <column caption='Gap (copy)' datatype='real' name='[Gap (copy)_3848888855833333761]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MAX([Calculation_5367094496580657155]) &gt;= SUM([estimated_wallet_share])&#10;THEN&#10;MAX([Calculation_5367094496580657155]) - SUM([estimated_wallet_share])&#10;ELSE 0.00&#10;END' />
            </column>
            <column caption='Opportunity' datatype='string' name='[Opportunity_in_Wallet_share]' role='dimension' type='nominal' />
            <column datatype='date' name='[Order_Month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Prioritization]' role='dimension' type='nominal' />
            <column caption='Account Manager Name' datatype='string' name='[account_manager_name]' role='dimension' type='nominal' />
            <column datatype='real' name='[ad_revenue_percent_gmv]' role='measure' type='quantitative' />
            <column datatype='string' name='[category_number]' role='dimension' type='nominal' />
            <column caption='Chain Name' datatype='string' name='[chain_name]' role='dimension' type='nominal' />
            <column caption='Vertical' datatype='string' name='[classification_group]' role='dimension' type='nominal' />
            <column datatype='real' name='[commission_rate]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[estimated_wallet_share]' role='measure' type='quantitative' />
            <column datatype='real' name='[fixed_assumed_margin]' role='measure' type='quantitative' />
            <column datatype='real' name='[gmv_eur]' role='measure' type='quantitative' />
            <column-instance column='[AAA_Category]' derivation='None' name='[none:AAA_Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Category_Details]' derivation='None' name='[none:Category_Details:nk]' pivot='key' type='nominal' />
            <column-instance column='[Comment]' derivation='None' name='[none:Comment:nk]' pivot='key' type='nominal' />
            <column-instance column='[Opportunity_in_Wallet_share]' derivation='None' name='[none:Opportunity_in_Wallet_share:nk]' pivot='key' type='nominal' />
            <column-instance column='[Order_Month]' derivation='None' name='[none:Order_Month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Order_Month]' derivation='None' name='[none:Order_Month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Prioritization]' derivation='None' name='[none:Prioritization:nk]' pivot='key' type='nominal' />
            <column-instance column='[account_manager_name]' derivation='None' name='[none:account_manager_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[category_number]' derivation='None' name='[none:category_number:nk]' pivot='key' type='nominal' />
            <column-instance column='[chain_name]' derivation='None' name='[none:chain_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[classification_group]' derivation='None' name='[none:classification_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_size_within_cohort]' derivation='None' name='[none:vendor_size_within_cohort:nk]' pivot='key' type='nominal' />
            <column-instance column='[ad_revenue_percent_gmv]' derivation='Sum' name='[sum:ad_revenue_percent_gmv:qk]' pivot='key' type='quantitative' />
