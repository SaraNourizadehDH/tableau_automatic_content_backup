      </column>
      <column caption='Order Modification Rate% %' datatype='real' name='[Order Modification Rate% (copy)_119626913846104065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if ([qty_delivered] &lt; [qty_ordered]) and [pelican_status]!=&apos;NOT_FOUND&apos; and [pelican_status]!=&apos;REPLACED&apos; then [order_id] end)/countd([order_id])' />
      </column>
      <column caption='QTY sold %' datatype='real' name='[QTY sold (copy)_951948435301502982]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qty_sold])' />
      </column>
      <column caption='Failed Orders ' datatype='integer' name='[Successful Orders (copy)_639511193781469188]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_failed] = True then [order_id] END)' />
      </column>
      <column caption='Successful Orders %' datatype='integer' name='[Successful Orders (copy)_639511193782390789]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_successful] = True then [order_id] END)' />
      </column>
      <column caption='GMV (LC)' datatype='real' name='[Successful Orders (copy)_639511193798557714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [is_successful] = True then [gmv_amount_lc] END)' />
      </column>
      <column caption='TMP Orders' datatype='integer' name='[TGO Orders (copy)_230809527876145153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_successful]= True and [is_tmp]= TRUE then [order_id] end)' />
      </column>
      <column caption='TGO Orders' datatype='integer' name='[TGO Share% (copy)_230809527875936256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_successful]= True and [is_tgo] = TRUE then [order_id] end)' />
      </column>
      <column caption='Lost GMV (LC) - Vendor' datatype='real' name='[Vendor Failed Orders (copy)_230809527886176264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [is_failed] = True and [owner]=&apos;VENDOR&apos; then [gmv_amount_lc] END)' />
      </column>
      <column caption='Vendor Failed Orders %' datatype='integer' name='[Vendor Failed Orders (copy)_230809527900241933]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_failed] = True and [owner]=&apos;VENDOR&apos; then [order_id] END)' />
      </column>
