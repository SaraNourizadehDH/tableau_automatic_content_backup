      <column caption='ABV (EUR) ' datatype='real' name='[ABV (LC) (copy)_1438055713255915520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(if [is_successful] = TRUE then [basket_amount_eur] END)' />
      </column>
      <column caption='AOV (EUR) %' datatype='real' name='[AOV (EUR) (copy)_951948435300524036]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [is_successful] = TRUE then [gmv_amount_eur] END)/ COUNTD(if [is_successful] = True then [order_id] END)' />
      </column>
      <column caption='AOV (EUR)' datatype='real' name='[AOV (LC) (copy)_1438055713256947714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [is_successful] = TRUE then [gmv_amount_eur] END)/ COUNTD(if [is_successful] = True then [order_id] END)' />
      </column>
      <column caption='ABV (LC)' datatype='real' name='[AOV (LC) (copy)_230809527890165770]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(if [is_successful] = TRUE then [basket_amount_lc] END)' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([TGO Orders (copy)_230809527876145153]) - LOOKUP(ZN([TGO Orders (copy)_230809527876145153]), -1)) / ABS(LOOKUP(ZN([TGO Orders (copy)_230809527876145153]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Calculation_230809527888072713]) - LOOKUP(ZN([Calculation_230809527888072713]), -1)) / ABS(LOOKUP(ZN([Calculation_230809527888072713]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Yesterday' datatype='boolean' name='[Calculation_1365998113985835008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[order_date] = TODAY()-1' />
      </column>
      <column caption='Sessions' datatype='integer' name='[Calculation_1997346499111346176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([viewed_menu_session_count])' />
      </column>
      <column caption='DF' datatype='real' name='[Calculation_230809527876960258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_successful] = TRUE then [delivery_fee_amount_lc] END' />
      </column>
      <column caption='ABS' datatype='real' name='[Calculation_230809527888072713]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [is_successful]=  True then [qty_delivered] END) / COUNTD(if [is_successful]= True then [order_id] END)' />
      </column>
      <column caption='Conversion %' datatype='real' name='[Calculation_230809527890661387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum( [placed_order_session_count])/sum([viewed_menu_session_count])' />
      </column>
      <column caption='Commissoin earning (LC)' datatype='real' name='[Calculation_230809527909687310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [is_successful]= True then [commission_amount_lc] END)' />
      </column>
      <column caption='Successful Orders' datatype='integer' name='[Calculation_639511193781186563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_successful] = True then [order_id] END)' />
      </column>
      <column caption='New Customers' datatype='integer' name='[Calculation_639511193787023369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_acquisition]= True then [analytical_customer_id] END)' />
      </column>
      <column caption='Order Modification Rate%' datatype='real' name='[Calculation_639511193788416010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if ([qty_delivered] &lt; [qty_ordered]) and [pelican_status]!=&apos;NOT_FOUND&apos; and [pelican_status]!=&apos;REPLACED&apos; then [order_id] end)/countd([order_id])' />
      </column>
      <column caption='Successful order with OOS items' datatype='integer' name='[Calculation_639511193788919819]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [has_item_qty_modified] or [has_item_replacement] then [order_id] END)' />
      </column>
      <column caption='Failed orders OOS' datatype='integer' name='[Calculation_639511193789292556]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_failed]= True and [is_net]= True and [reason] IN (&apos;ITEM_UNAVAILABLE&apos;,&apos;MENU_ACCOUNT_SETTINGS&apos;) then [order_id] END)' />
      </column>
      <column caption='OOS%' datatype='real' name='[Calculation_639511193789386765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_639511193788919819] + [Calculation_639511193789292556]) / COUNTD(if [is_net]= True then [order_id] end)' />
      </column>
      <column caption='Net Orders' datatype='integer' name='[Calculation_639511193796796431]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_net]= True then [order_id] END)' />
      </column>
      <column caption='Healthy orders%' datatype='real' name='[Calculation_639511193796878352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_639511193781186563] - [Calculation_639511193788919819])/ [Calculation_639511193796796431]' />
      </column>
      <column caption='Vendor NFR%' datatype='real' name='[Calculation_639511193797595153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [owner]=&apos;VENDOR&apos; then [order_id] end)/ COUNTD(if [is_failed_fraud_shield] = FALSE and [is_failed_customer_cancelled_before_vendor_accepted] = False and [is_failed_online_payment_incomplete] = False then [order_id] END)' />
      </column>
      <column caption='AOV (LC)' datatype='real' name='[Calculation_639511193798828051]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [is_successful] = TRUE then [gmv_amount_lc] END)/ COUNTD(if [is_successful] = True then [order_id] END)' />
      </column>
      <column caption='TGO Share%' datatype='real' name='[Calculation_639511193805525014]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [is_successful]= True and [is_tgo] = TRUE then [order_id] end)/ COUNTD( if [is_successful]= True then[order_id] END)' />
      </column>
