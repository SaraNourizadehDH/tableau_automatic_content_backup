    <worksheet name='Total Chain Performance'>
      <table>
        <view>
          <datasources>
            <datasource caption='Data source' name='federated.0f64cjo1ftiqkp1eueat51ou7oeh' />
          </datasources>
          <datasource-dependencies datasource='federated.0f64cjo1ftiqkp1eueat51ou7oeh'>
            <column caption='Successful orders' datatype='integer' name='[Calculation_1875467790199259136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [is_successful (Custom SQL Query)] = True then [order_id (Custom SQL Query)] END)' />
            </column>
            <column caption='NFR%' datatype='real' name='[Calculation_1875467790199844865]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [is_successful (Custom SQL Query)]= FALSE and [is_net (Custom SQL Query)]= TRUE then [order_id (Custom SQL Query)] end)/ COUNTD(if [is_net (Custom SQL Query)]= TRUE then [order_id (Custom SQL Query)] end)' />
            </column>
            <column caption='GMV Sales' datatype='real' name='[Calculation_1875467790201196546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [is_successful (Custom SQL Query)]= True then [gmv_amount_lc (Custom SQL Query)] END)' />
            </column>
            <column caption='Successful orders with OOS' datatype='integer' name='[Calculation_1875467790205837317]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [is_successful (Custom SQL Query)]= true and ([pelican_status] IN (&apos;NOT_FOUND&apos;,&apos;REPLACED&apos;) OR [qty_delivered]&lt;[qty_ordered]) then [order_id (Custom SQL Query)] END)' />
            </column>
            <column caption='Failed orders OOS' datatype='integer' name='[Calculation_1875467790205915142]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [is_successful (Custom SQL Query)]= FALSE and [is_net (Custom SQL Query)]= True and [reason (Custom SQL Query)] IN (&apos;ITEM_UNAVAILABLE&apos;,&apos;MENU_ACCOUNT_SETTINGS&apos;) then [order_id (Custom SQL Query)] END)' />
            </column>
            <column caption='OOS%' datatype='real' name='[Calculation_1875467790206099463]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1875467790205837317] + [Calculation_1875467790205915142]) / COUNTD(if [is_net (Custom SQL Query)]= True then [order_id (Custom SQL Query)] end)' />
            </column>
            <column caption='Prep Time' datatype='real' name='[Calculation_1875467790207733769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(if ISNULL([assumed_actual_preparation_time (Custom SQL Query)]) then [vendor_preparation_minutes (Custom SQL Query)] else ([assumed_actual_preparation_time (Custom SQL Query)]/60) END)' />
            </column>
            <column caption='Avg. busy Time' datatype='real' name='[Calculation_1875467790223015952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([offline_duration_in_seconds]/60)' />
            </column>
            <column caption='Healthy orders%' datatype='real' name='[Calculation_1875467790232096785]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1875467790199259136] - [Calculation_1875467790205837317])/ [Calculation_1875467790232313874]' />
            </column>
            <column caption='Net Orders' datatype='integer' name='[Calculation_1875467790232313874]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [is_net (Custom SQL Query)]= True then [order_id (Custom SQL Query)] end)' />
            </column>
            <column caption='Delivery delay' datatype='real' name='[Calculation_2525956462162235392]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(([order_delay]/60))' />
            </column>
            <column caption='Delivrey Time' datatype='real' name='[Calculation_2525956462162538497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(([actual_delivery_time]/60))' />
            </column>
            <column caption='GMV Loss' datatype='real' name='[GMV Sales (copy)_1875467790205317124]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [is_successful (Custom SQL Query)]= FALSE then [gmv_amount_lc (Custom SQL Query)] END)' />
            </column>
            <column caption='Basket Value' datatype='real' name='[GMV Sales(LC) (copy)_2361012127567421440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if [is_successful (Custom SQL Query)]= True then [basket_amount_lc] END)' />
            </column>
            <column caption='VNFR%' datatype='real' name='[NFR% (copy)_1032731739692142592]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [owner]=&apos;VENDOR&apos; then [order_id] end)/ COUNTD(if [is_failed_fraud_shield] = FALSE and [is_failed_customer_cancelled_before_vendor_accepted] = False and [is_failed_online_payment_incomplete] = False then [order_id] END)' />
            </column>
            <column datatype='integer' name='[actual_delivery_time]' role='measure' type='quantitative' />
            <column datatype='integer' name='[assumed_actual_preparation_time (Custom SQL Query)]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1875467790207733769]' derivation='Avg' name='[avg:Calculation_1875467790207733769:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[basket_amount_lc]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='id' datatype='integer' name='[chain_id]' role='dimension' type='ordinal' />
            <column datatype='real' name='[gmv_amount_lc (Custom SQL Query)]' role='measure' type='quantitative' />
