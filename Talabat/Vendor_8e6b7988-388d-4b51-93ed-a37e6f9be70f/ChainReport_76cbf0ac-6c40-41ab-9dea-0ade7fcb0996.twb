            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='yousef.awad@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.167d0wj1pv9dxe14x19im0ty1rux' name='Custom SQL Query2' type='text'>SELECT &#13;
    vendor_id,&#13;
    offline_due_to_busy_kitchen_duration as offline_duration_in_seconds,&#13;
FROM `tlb-data-prod.data_platform.agg_vendor_availability` availability&#13;
where availability.date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE -1, month), INTERVAL 1 MONTH) AND CURRENT_DATE</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.167d0wj1pv9dxe14x19im0ty1rux' name='dim_chain' type='text'>SELECT &#13;
    source_system_chain_id as chain_id,&#13;
    chain_name,&#13;
    vendor_name,&#13;
    source_system_vendor_id,&#13;
    is_active,&#13;
    orders.order_date,&#13;
    orders.order_id,&#13;
    orders.vendor_id,&#13;
    gmv_amount_lc,&#13;
    basket_amount_lc,&#13;
    is_successful,&#13;
    st.is_net or (order_status_code  = &apos;S&apos;  and not st.is_test) as is_net,&#13;
    st.is_canceled_by_fraud_shield  and not st.is_test                                                    is_failed_fraud_shield,&#13;
    st.is_customer_cancelled_before_vendor_accepted    and not st.is_test                                  is_failed_customer_cancelled_before_vendor_accepted,&#13;
    is_incomplete_online_payment  and not st.is_test                                                      is_failed_online_payment_incomplete,&#13;
    owner,&#13;
    reason,&#13;
    assumed_actual_preparation_time,&#13;
    vendor_preparation_minutes,&#13;
    actual_delivery_time,&#13;
    order_delay    &#13;
FROM `tlb-data-prod.data_platform.dim_chain` chains&#13;
left join `tlb-data-prod.data_platform.dim_vendor_info` vendors&#13;
on chains.source_system_chain_id = vendors.chain_id   	&#13;
 left join `tlb-data-prod.data_platform.fct_order_info` orders &#13;
 on vendors.source_system_vendor_id = orders.vendor_id and orders.order_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE -1, month), INTERVAL 1 MONTH) AND CURRENT_DATE&#13;
 left join `tlb-data-prod.data_platform.dim_order_status` st&#13;
 on orders.order_status_id = st.order_status_id&#13;
 left join `tlb-data-prod.data_platform.fct_order_detail_fail` fails&#13;
 on orders.order_id = fails.order_id and fails.order_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE -1, month), INTERVAL 1 MONTH) AND CURRENT_DATE&#13;
 left join `tlb-data-prod.data_platform.fct_logistics_order` logistics&#13;
 on orders.order_id = logistics.order_id and date(logistics.created_date) BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE -1, month), INTERVAL 1 MONTH) AND CURRENT_DATE&#13;
 where is_net</relation>
          <relation connection='bigquery.167d0wj1pv9dxe14x19im0ty1rux' name='Custom SQL Query2' type='text'>SELECT &#13;
    vendor_id,&#13;
    offline_due_to_busy_kitchen_duration as offline_duration_in_seconds,&#13;
FROM `tlb-data-prod.data_platform.agg_vendor_availability` availability&#13;
where availability.date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE -1, month), INTERVAL 1 MONTH) AND CURRENT_DATE</relation>
          <relation connection='bigquery.167d0wj1pv9dxe14x19im0ty1rux' name='Custom SQL Query1' type='text'>SELECT&#13;
    order_date,&#13;
    order_id,&#13;
    vendor_id,&#13;
    delivered_quantity qty_delivered,&#13;
    ordered_quantity as qty_ordered,&#13;
    returned_quantity as qty_returned,&#13;
    sold_quantity as qty_sold,&#13;
    pelican_status,&#13;
    item_id,&#13;
    brand_name,&#13;
    category_name_level_one as master_category_parent_english,&#13;
    category_name_level_two as master_category_english,&#13;
    item_name_en as product_name,&#13;
    product_sku as skus,&#13;
    barcodes&#13;
FROM `tlb-data-prod.data_platform.fct_order_item` i&#13;
left join `tlb-data-prod.data_platform.dim_item` d using(item_id)&#13;
where order_date BETWEEN DATE_SUB(DATE_TRUNC(CURRENT_DATE -1, month), INTERVAL 1 MONTH) AND CURRENT_DATE</relation>
        </_.fcp.ObjectModelEncapsulateLegacy.true...relation>
