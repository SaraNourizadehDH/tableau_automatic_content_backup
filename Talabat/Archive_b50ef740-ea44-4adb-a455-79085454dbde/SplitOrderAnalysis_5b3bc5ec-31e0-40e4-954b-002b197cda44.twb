    <worksheet name='Split Order Table'>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (dwh_il)' name='federated.1ftiv3w0fv78b6172yfmk10veyga' />
          </datasources>
          <datasource-dependencies datasource='federated.1ftiv3w0fv78b6172yfmk10veyga'>
            <column caption='Avg Split at Vendor Time' datatype='real' name='[Avg Split Delivery Time (copy)_1664572659056697345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Calculation_6454361982562758657] when &apos;True&apos; then [at_vendor_time] else null end' />
            </column>
            <column caption='Failed Orders from Split / Total Split Orders' datatype='real' default-format='p0.00%' name='[Calculation_1524327751866490880]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5760455781181468675] / [Split Rate (copy)_6454361982567157766]' />
            </column>
            <column caption='Contact Rate: Split Orders' datatype='real' default-format='p0.00%' name='[Calculation_1524327751868121090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Contact Orders (copy)_1524327751867109377] / [Split Rate (copy)_6454361982567157766]' />
            </column>
            <column caption='Avg Items per Split Order' datatype='real' name='[Calculation_1524327751883685891]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(case [Calculation_6454361982562758657] when &apos;True&apos; then [skus_no] else NULL end)&#10;/&#10;[Split Rate (copy)_6454361982567157766]' />
            </column>
            <column caption='ABV' datatype='real' name='[Calculation_1524327751888281604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(case [Calculation_6454361982562758657] when &apos;True&apos; THEN [basket_amount_lc] else null end)&#10;/ &#10;countd(case [Calculation_6454361982562758657] when &apos;True&apos; THEN [order_id] else null end)' />
            </column>
            <column caption='Avg Split Delivery Time' datatype='real' name='[Calculation_1664572659054182400]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Calculation_6454361982562758657] when &apos;True&apos; then [delivery_time] else null end' />
            </column>
            <column caption='Successful Orders' datatype='integer' name='[Calculation_5760455781180092416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(case [is_successful] when True then [order_id] else null end)' />
            </column>
            <column caption='% Split / Total Orders' datatype='real' default-format='p0.00%' name='[Calculation_5760455781180993537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Split Rate (copy)_6454361982567157766] / [Calculation_5760455781180092416]' />
            </column>
            <column caption='Failed Orders from Split' datatype='integer' name='[Calculation_5760455781181468675]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Countd(if [Calculation_6454361982562758657] = &apos;True&apos; &#10;and  [is_successful] = False&#10;then [order_id] end)' />
            </column>
            <column caption='Split Order' datatype='string' name='[Calculation_6454361982562758657]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [deliveries_count] &gt; 1 THEN &apos;True&apos;&#10;ELSE &apos;False&apos;&#10;END' />
            </column>
            <column caption='split + contacted' datatype='integer' name='[Contact Orders (copy)_1524327751867109377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(&#10;if [Split Order (copy)_4608589830430568450] = &apos;True&apos;&#10;and [Calculation_6454361982562758657] = &apos;True&apos;&#10;then [order_id]&#10;else null end&#10;)' />
            </column>
            <column caption='Contacted' datatype='string' name='[Split Order (copy)_4608589830430568450]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [customer_service_incoming_cases] &gt; 0 THEN &apos;True&apos;&#10;ELSE &apos;False&apos;&#10;END' />
            </column>
            <column caption='Contact Orders' datatype='integer' name='[Split Orders (copy)_4608589830432927748]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [Split Order (copy)_4608589830430568450]&#10;WHEN &apos;True&apos; THEN [order_id] ELSE NULL END)' />
            </column>
            <column caption='Split Orders' datatype='integer' name='[Split Rate (copy)_6454361982567157766]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(CASE [Calculation_6454361982562758657]&#10;WHEN &apos;True&apos; THEN [order_id] ELSE NULL END)' />
            </column>
            <column datatype='real' default-format='n#,##0.00;-#,##0.00' name='[at_vendor_time]' role='measure' type='quantitative' />
            <column-instance column='[Avg Split Delivery Time (copy)_1664572659056697345]' derivation='Avg' name='[avg:Avg Split Delivery Time (copy)_1664572659056697345:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1664572659054182400]' derivation='Avg' name='[avg:Calculation_1664572659054182400:qk]' pivot='key' type='quantitative' />
            <column datatype='real' name='[basket_amount_lc]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_iso]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[customer_service_incoming_cases]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[deliveries_count]' role='dimension' type='ordinal' />
            <column datatype='real' default-format='n#,##0.00;-#,##0.00' name='[delivery_time]' role='measure' type='quantitative' />
            <column datatype='boolean' name='[is_successful]' role='dimension' type='nominal' />
