at_vendor_time / 60 as at_vendor_time,
basket_amount_lc,
COALESCE(SUM(CASE WHEN (salesforce_tickets.channel LIKE 'Chat' OR salesforce_tickets.channel LIKE 'Email') THEN salesforce_tickets.incoming_chats else null end ),0) AS customer_service_incoming_cases,
count(distinct product_sku) as skus_no



FROM `tlb-data-prod.data_platform.fct_order_info` o 

inner join `tlb-data-prod.data_platform.fct_order_item` lines
on o.order_id = lines.order_id and o.order_date = lines.order_date

inner join `tlb-data-prod.data_platform.dim_item` i
on i.item_id = lines.item_id

left outer join `tlb-data-prod.data_platform.fct_order_rank` r on o.order_id = r.order_id and r.order_date = o.order_date

