      <aliases enabled='yes' />
      <column caption='Order Freq' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_191684500400467968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_count])/SUM([customer_count])' />
      </column>
      <column caption='Avg Spend' datatype='real' name='[Calculation_191684500400709633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_spend])/SUM([customer_count])' />
      </column>
      <column caption='Uplift % (Order Freq)' datatype='real' default-format='p0.0%' name='[Calculation_191684500401131522]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(// multi net increase&#10;(&#10;(SUM(IF [cohort_duration] = &apos;after_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [order_count] END)&#10;/&#10;SUM(IF [cohort_duration] = &apos;after_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [customer_count] END))&#10;&#10;-&#10;&#10;(SUM(IF [cohort_duration] = &apos;before_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [order_count] END)&#10;/&#10;SUM(IF [cohort_duration] = &apos;before_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [customer_count] END))&#10;)&#10;&#10;-&#10;&#10;// single net increase&#10;(&#10;(SUM({ FIXED [country_name], [city_name],[acquisition_order_vertical] : &#10;SUM(IF isnull([multi_vert_combination]) and [cohort_duration] = &apos;after_month_zero&apos;&#10;then [order_count] END)&#10;})&#10;/&#10;SUM({ FIXED [country_name], [city_name], [acquisition_order_vertical]: &#10;SUM(IF isnull([multi_vert_combination]) and [cohort_duration] = &apos;after_month_zero&apos;&#10;then [customer_count] END)&#10;}))&#10;-&#10;(&#10;SUM({ FIXED [country_name], [city_name], [acquisition_order_vertical] : &#10;SUM(IF isnull([multi_vert_combination]) and [cohort_duration] = &apos;before_month_zero&apos;&#10;then [order_count] END)&#10;})&#10;/&#10;SUM({ FIXED [country_name],[city_name], [acquisition_order_vertical]: &#10;SUM(IF isnull([multi_vert_combination]) and [cohort_duration] = &apos;before_month_zero&apos;&#10;then [customer_count] END)&#10;}))&#10;))&#10;&#10;// Uplift&#10;/&#10;(&#10;SUM(IF [cohort_duration] = &apos;before_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [order_count] END)&#10;/&#10;SUM(IF [cohort_duration] = &apos;before_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [customer_count] END)&#10;)' />
      </column>
      <column caption='Single/Multi Vertical' datatype='string' name='[Calculation_191684500402577411]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [cust_type] = &apos;still single_vertical&apos; then &apos;single_vertical&apos; else &apos;multi_vertical&apos; END' />
      </column>
      <column caption='before/multi' datatype='integer' name='[Calculation_191684500406194180]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [cohort_duration] = &apos;before_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [order_count] END)' />
      </column>
      <column caption='Second Vertical' datatype='string' name='[Calculation_191684500428169224]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='SPLIT([multi_vert_combination],&apos;-&apos;,1)' />
      </column>
      <column caption='Customer count filter' datatype='boolean' name='[Calculation_541839372227182592]' role='measure' type='nominal'>
        <calculation class='tableau' formula='sum(if [cohort_duration] = &apos;month_zero&apos; then [customer_count] END) &gt;= 1000' />
      </column>
      <column caption='multi_retention' datatype='real' name='[Calculation_541839372340613124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [cohort_duration] = &apos;before_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [customer_count] END) //customer count (after)&#10;/&#10;SUM(IF [cohort_duration] = &apos;month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [customer_count] END)) //customer count (zero)' />
      </column>
      <column caption='single_retention' datatype='real' name='[Calculation_541839372340776965]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum({ FIXED [country_name], [city_name], [acquisition_order_vertical]: &#10;SUM(IF isnull([multi_vert_combination]) and [cohort_duration] = &apos;before_month_zero&apos;&#10;then [customer_count] END)})&#10;/&#10;sum({ FIXED [country_name], [city_name], [acquisition_order_vertical]: &#10;SUM(IF isnull([multi_vert_combination]) and [cohort_duration] = &apos;month_zero&apos;&#10;then [customer_count] END)})' />
      </column>
      <column caption='multi customer count' datatype='integer' name='[Calculation_541839372341997574]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [cohort_duration] = &apos;after_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [customer_count] END)' />
      </column>
      <column caption='single customer count' datatype='integer' name='[Calculation_541839372342497287]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum({ FIXED [country_name], [city_name], [acquisition_order_vertical]: &#10;SUM(IF isnull([multi_vert_combination]) and [cohort_duration] = &apos;after_month_zero&apos;&#10;then [customer_count] END)})' />
      </column>
      <column caption='single month zero customer count' datatype='integer' name='[Calculation_541839372342755336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [country_name], [acquisition_order_vertical]: &#10;SUM(IF isnull([multi_vert_combination]) and [cohort_duration] = &apos;month_zero&apos;&#10;then [customer_count] END)}' />
      </column>
      <column caption='Uplift % (Spend)' datatype='real' default-format='p0.0%' name='[Uplift % (Order Freq) (copy)_191684500428664841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(// multi net increase&#10;(&#10;(SUM(IF [cohort_duration] = &apos;after_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [total_spend] END)&#10;/&#10;SUM(IF [cohort_duration] = &apos;after_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [customer_count] END))&#10;&#10;-&#10;&#10;(SUM(IF [cohort_duration] = &apos;before_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [total_spend] END)&#10;/&#10;SUM(IF [cohort_duration] = &apos;before_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [customer_count] END))&#10;)&#10;&#10;-&#10;&#10;// single net increase&#10;(&#10;(SUM({ FIXED [country_name], [city_name],[acquisition_order_vertical] : &#10;SUM(IF isnull([multi_vert_combination]) and [cohort_duration] = &apos;after_month_zero&apos;&#10;then [total_spend] END)&#10;})&#10;/&#10;SUM({ FIXED [country_name], [city_name], [acquisition_order_vertical]: &#10;SUM(IF isnull([multi_vert_combination]) and [cohort_duration] = &apos;after_month_zero&apos;&#10;then [customer_count] END)&#10;}))&#10;-&#10;(&#10;SUM({ FIXED [country_name], [city_name], [acquisition_order_vertical] : &#10;SUM(IF isnull([multi_vert_combination]) and [cohort_duration] = &apos;before_month_zero&apos;&#10;then [total_spend] END)&#10;})&#10;/&#10;SUM({ FIXED [country_name],[city_name], [acquisition_order_vertical]: &#10;SUM(IF isnull([multi_vert_combination]) and [cohort_duration] = &apos;before_month_zero&apos;&#10;then [customer_count] END)&#10;}))&#10;))&#10;&#10;// Uplift&#10;/&#10;(&#10;SUM(IF [cohort_duration] = &apos;before_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [total_spend] END)&#10;/&#10;SUM(IF [cohort_duration] = &apos;before_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [customer_count] END)&#10;)' />
      </column>
      <column caption='Retention' datatype='real' default-format='p0.0%' name='[Uplift % (Spend) (copy)_541839372327632897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [cohort_duration] = &apos;after_month_zero&apos;  then [customer_count] END)&#10;/&#10;SUM(IF [cohort_duration] = &apos;month_zero&apos; then [customer_count] END))' />
      </column>
      <column caption='Uplift % (Retention)' datatype='real' default-format='p0.0%' name='[Uplift % (Spend) (copy)_541839372336087043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// [Retention (Multi) - Retention (Single)] / Retention (Single)&#10;&#10;([Calculation_541839372340613124] - [Calculation_541839372340776965]) / ([Calculation_541839372340776965])' />
      </column>
      <column caption='Net Increase' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Uplift % (copy)_191684500420272135]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// multi net increase&#10;(&#10;(SUM(IF [cohort_duration] = &apos;after_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [order_count] END)&#10;/&#10;SUM(IF [cohort_duration] = &apos;after_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [customer_count] END))&#10;&#10;-&#10;&#10;(SUM(IF [cohort_duration] = &apos;before_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [order_count] END)&#10;/&#10;SUM(IF [cohort_duration] = &apos;before_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [customer_count] END))&#10;)&#10;&#10;-&#10;&#10;// single net increase&#10;(&#10;(SUM({ FIXED [country_name],[acquisition_order_vertical] : &#10;SUM(IF isnull([multi_vert_combination]) and [cohort_duration] = &apos;after_month_zero&apos;&#10;then [order_count] END)&#10;})&#10;/&#10;SUM({ FIXED [country_name],[acquisition_order_vertical]: &#10;SUM(IF isnull([multi_vert_combination]) and [cohort_duration] = &apos;after_month_zero&apos;&#10;then [customer_count] END)&#10;}))&#10;-&#10;(&#10;SUM({ FIXED [country_name],[acquisition_order_vertical] : &#10;SUM(IF isnull([multi_vert_combination]) and [cohort_duration] = &apos;before_month_zero&apos;&#10;then [order_count] END)&#10;})&#10;/&#10;SUM({ FIXED [country_name],[acquisition_order_vertical]: &#10;SUM(IF isnull([multi_vert_combination]) and [cohort_duration] = &apos;before_month_zero&apos;&#10;then [customer_count] END)&#10;}))&#10;)' />
      </column>
