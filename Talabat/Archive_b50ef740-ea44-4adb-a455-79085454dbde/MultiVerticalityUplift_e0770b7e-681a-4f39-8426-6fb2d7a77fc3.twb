            <column caption='Uplift % (Order Freq)' datatype='real' default-format='p0.0%' name='[Calculation_191684500401131522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(// multi net increase&#10;(&#10;(SUM(IF [cohort_duration] = &apos;after_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [order_count] END)&#10;/&#10;SUM(IF [cohort_duration] = &apos;after_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [customer_count] END))&#10;&#10;-&#10;&#10;(SUM(IF [cohort_duration] = &apos;before_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [order_count] END)&#10;/&#10;SUM(IF [cohort_duration] = &apos;before_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [customer_count] END))&#10;)&#10;&#10;-&#10;&#10;// single net increase&#10;(&#10;(SUM({ FIXED [country_name], [city_name],[acquisition_order_vertical] : &#10;SUM(IF isnull([multi_vert_combination]) and [cohort_duration] = &apos;after_month_zero&apos;&#10;then [order_count] END)&#10;})&#10;/&#10;SUM({ FIXED [country_name], [city_name], [acquisition_order_vertical]: &#10;SUM(IF isnull([multi_vert_combination]) and [cohort_duration] = &apos;after_month_zero&apos;&#10;then [customer_count] END)&#10;}))&#10;-&#10;(&#10;SUM({ FIXED [country_name], [city_name], [acquisition_order_vertical] : &#10;SUM(IF isnull([multi_vert_combination]) and [cohort_duration] = &apos;before_month_zero&apos;&#10;then [order_count] END)&#10;})&#10;/&#10;SUM({ FIXED [country_name],[city_name], [acquisition_order_vertical]: &#10;SUM(IF isnull([multi_vert_combination]) and [cohort_duration] = &apos;before_month_zero&apos;&#10;then [customer_count] END)&#10;}))&#10;))&#10;&#10;// Uplift&#10;/&#10;(&#10;SUM(IF [cohort_duration] = &apos;before_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [order_count] END)&#10;/&#10;SUM(IF [cohort_duration] = &apos;before_month_zero&apos; and [Calculation_191684500402577411] =&apos;multi_vertical&apos; then [customer_count] END)&#10;)' />
            </column>
            <column caption='Single/Multi Vertical' datatype='string' name='[Calculation_191684500402577411]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [cust_type] = &apos;still single_vertical&apos; then &apos;single_vertical&apos; else &apos;multi_vertical&apos; END' />
            </column>
            <column caption='Second Vertical' datatype='string' name='[Calculation_191684500428169224]' role='dimension' type='nominal'>
