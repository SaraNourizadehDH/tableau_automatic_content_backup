          <members>
            <member value='&quot;LC&quot;' />
            <member value='&quot;EUR&quot;' />
          </members>
        </column>
        <column caption='Category Type' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Customer Facing&quot;'>
          <calculation class='tableau' formula='&quot;Customer Facing&quot;' />
          <members>
            <member value='&quot;Customer Facing&quot;' />
            <member value='&quot;Master&quot;' />
          </members>
