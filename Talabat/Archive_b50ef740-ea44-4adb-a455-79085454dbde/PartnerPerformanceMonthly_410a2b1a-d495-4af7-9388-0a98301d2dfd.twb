item_values_lc.amt_delivered_lc AS amt_delivered_lc,
item_values_eur.amt_ordered_eur AS amt_ordered_eur,
item_values_eur.amt_delivered_eur AS amt_delivered_eur

FROM fulfillment-dwh-production.curated_data_shared_dmart.purchase_orders po, UNNEST(products_purchased) pp

WHERE ((( timestamp(pp.created_localtime_at)  ) >>= ((TIMESTAMP(DATETIME_ADD(DATETIME(TIMESTAMP_TRUNC(TIMESTAMP_TRUNC(CURRENT_TIMESTAMP(), DAY), MONTH)), INTERVAL -2 MONTH)))) AND ( timestamp(pp.created_localtime_at)  ) << ((TIMESTAMP(DATETIME_ADD(DATETIME(TIMESTAMP(DATETIME_ADD(DATETIME(TIMESTAMP_TRUNC(TIMESTAMP_TRUNC(CURRENT_TIMESTAMP(), DAY), MONTH)), INTERVAL -2 MONTH))), INTERVAL 2 MONTH))))))]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
