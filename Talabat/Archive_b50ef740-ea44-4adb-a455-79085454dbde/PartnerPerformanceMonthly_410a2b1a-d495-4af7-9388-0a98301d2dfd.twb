        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1fj8mxj0r6sfj910hb57w003ss01' name='Custom SQL Query' type='text'><![CDATA[SELECT 
DATE(pp.created_localtime_at) as date,
(FORMAT_TIMESTAMP('%F', TIMESTAMP_TRUNC(timestamp(pp.created_localtime_at) , WEEK(Sunday)))) AS week,
UPPER(country_code) AS country,
product.brand_name,
sku_id,
product_name,
supplier_name,
product.category_english,
product.category_parent_english,
pp.quantity_ordered AS quantity_ordered,
pp.quantity_delivered AS quantity_delivered,
item_values_lc.amt_ordered_lc AS amt_ordered_lc,
item_values_lc.amt_delivered_lc AS amt_delivered_lc,
item_values_eur.amt_ordered_eur AS amt_ordered_eur,
item_values_eur.amt_delivered_eur AS amt_delivered_eur

FROM fulfillment-dwh-production.curated_data_shared_dmart.purchase_orders po, UNNEST(products_purchased) pp

WHERE ((( timestamp(pp.created_localtime_at)  ) >>= ((TIMESTAMP(DATETIME_ADD(DATETIME(TIMESTAMP_TRUNC(TIMESTAMP_TRUNC(CURRENT_TIMESTAMP(), DAY), MONTH)), INTERVAL -2 MONTH)))) AND ( timestamp(pp.created_localtime_at)  ) << ((TIMESTAMP(DATETIME_ADD(DATETIME(TIMESTAMP(DATETIME_ADD(DATETIME(TIMESTAMP_TRUNC(TIMESTAMP_TRUNC(CURRENT_TIMESTAMP(), DAY), MONTH)), INTERVAL -2 MONTH))), INTERVAL 2 MONTH))))))]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1fj8mxj0r6sfj910hb57w003ss01' name='Custom SQL Query' type='text'><![CDATA[SELECT 
DATE(pp.created_localtime_at) as date,
(FORMAT_TIMESTAMP('%F', TIMESTAMP_TRUNC(timestamp(pp.created_localtime_at) , WEEK(Sunday)))) AS week,
