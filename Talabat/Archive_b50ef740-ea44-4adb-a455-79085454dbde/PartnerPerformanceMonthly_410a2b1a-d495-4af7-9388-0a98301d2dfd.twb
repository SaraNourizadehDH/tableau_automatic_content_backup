              <calculation class='tableau' formula='([Calculation_3174474831311695885] - LOOKUP(ZN([Calculation_3174474831311695885]), -1))/(LOOKUP(ZN([Calculation_3174474831311695885]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Category Growth (Sales)' datatype='real' default-format='p0.00%' name='[Calculation_3174474831296589831]' role='measure' type='quantitative'>
