      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.09mnfpk1jdup5i1at5usu0vhq2bn].[pcto:usr:Calculation_2582955184531329024:qk]&quot;' value='OOS % per Qty Ordered' />
          <alias key='&quot;[federated.09mnfpk1jdup5i1at5usu0vhq2bn].[usr:Calculation_2582955184531329024:qk]&quot;' value='Count OOS Instances' />
        </aliases>
      </column>
      <column caption='Count Unique SKUs' datatype='integer' name='[Calculation_1386334692238749696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([sku])' />
      </column>
      <column caption='Total Basket Size (items)' datatype='real' name='[Calculation_1386334692238860289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qty_ordered])' />
      </column>
      <column caption='Total Quantity Ordered' datatype='real' name='[Calculation_1386334692251942914]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qty_ordered])' />
      </column>
      <column caption='Count OOS' datatype='integer' name='[Calculation_2582955184531329024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Calculation_3602457550550831106])' />
      </column>
      <column caption='orders' datatype='integer' name='[Calculation_2582955184533057538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Category' datatype='string' name='[Calculation_2582955184563834885]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 1] when &apos;Customer Facing&apos; then [category_parent_english] WHEN &apos;Master Category&apos; then [level_one] end' />
      </column>
      <column caption='price listed' datatype='real' name='[Calculation_2582955184565743623]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 2] when &apos;EUR&apos; then [unit_price_listed_eur] when &apos;LC&apos; then [unit_price_listed_lc] end' />
      </column>
      <column caption='GMV Lost' datatype='real' name='[Calculation_2582955184565927944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Calculation_3602457550550831106] when &apos;yes&apos;&#10;THEN [Calculation_2582955184565743623] * ([qty_ordered]-[qty_delivered])&#10;end' />
      </column>
      <column caption='OOS' datatype='string' name='[Calculation_3602457550550831106]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  ([pelican_status] = &apos;NOT_FOUND&apos; OR [pelican_status] = &apos;REPLACED&apos;)&#10;OR ([reason (Custom SQL Query2)] = &apos;ITEM_UNAVAILABLE&apos; OR [reason (Custom SQL Query2)] = &apos;MENU_ACCOUNT_SETTINGS&apos;)&#10;then &apos;yes&apos;&#10;else &apos;no&apos; end' />
      </column>
      <column caption='Calculation1' datatype='integer' name='[Calculation_3602457550589997059]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='countd(CASE [Calculation_3602457550550831106] when &apos;yes&apos; then order_id end)' />
      </column>
      <column caption='Calculation2' datatype='real' name='[Calculation_4989214393531609092]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([Calculation_2582955184531329024] )/&#10;attr({ FIXED [Calculation_2582955184563834885],[qty_ordered (group)] : [Calculation_2582955184531329024]}))' />
      </column>
      <column caption='avg qty ordered' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4989214393788645383]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([qty_ordered])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_BEA265A247264E2D97FC4B57828A9118]' role='measure' type='quantitative' />
      <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Partially Fulfilled (is successful order)' datatype='boolean' name='[is_sent]' role='dimension' type='nominal' />
      <column aggregation='Sum' datatype='real' name='[qty_delivered]' role='dimension' type='ordinal' />
      <column aggregation='None' caption='Quantity Ordered Buckets' datatype='integer' name='[qty_ordered (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[qty_ordered]' peg='0' size='5' />
      </column>
