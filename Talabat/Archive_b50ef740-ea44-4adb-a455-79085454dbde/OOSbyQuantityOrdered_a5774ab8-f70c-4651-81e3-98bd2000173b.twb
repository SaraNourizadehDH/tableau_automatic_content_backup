            <column caption='Category Classification' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Master Category&quot;'>
              <calculation class='tableau' formula='&quot;Master Category&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.09mnfpk1jdup5i1at5usu0vhq2bn'>
