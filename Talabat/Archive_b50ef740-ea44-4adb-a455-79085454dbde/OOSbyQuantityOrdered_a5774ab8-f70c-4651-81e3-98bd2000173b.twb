        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation join='left' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[Custom SQL Query].[order_id]' />
              <expression op='[Custom SQL Query2].[order_id]' />
            </expression>
          </clause>
          <relation connection='bigquery.06kzawh0qrez5c11fqthg1i4bsjt' name='Custom SQL Query' type='text'><![CDATA[Select
date(date) as date,
right(o.global_entity_id,2) as country,
o.vendor_id,
vendor_name,
o.order_id,
category_parent_english,
master_category_names.level_one,
sku,
product_name,
o.qty_ordered,
o.qty_delivered,
total_price_paid_lc,
total_price_paid_eur,
unit_price_listed_lc,
unit_price_listed_eur,
pelican_status,
o.is_sent



from `tlb-data-prod.data_platform_dmart.fct_customer_order_lines` o

inner join `tlb-data-prod.data_platform_dmart.customer_orders` oo
on oo.order_id = o.order_id and oo.global_entity_id = o.global_entity_id

left join `tlb-data-prod.data_platform.dim_vendor_info` v
on cast(v.source_system_vendor_id as string) = o.vendor_id

left join `tlb-data-prod.data_platform.dim_chain` c
on c.source_system_chain_id = v.chain_id

left join `tlb-data-prod.data_platform_dmart.dim_product` p
on p.skus = o.sku and p.vendor_id = o.vendor_id



where vertical<<>>'food' and (sub_vertical='marketplace' or sub_vertical is null)
and date >>= '2022-01-01'
and order_flow_type = "Grocery"



order by 1]]></relation>
          <relation connection='bigquery.06kzawh0qrez5c11fqthg1i4bsjt' name='Custom SQL Query2' type='text'>select
cast(order_id as string) as order_id, 
reason
from `tlb-data-prod.data_platform.fct_order_detail_fail`
where order_date &gt;&gt;= &apos;2022-01-01&apos;</relation>
        </_.fcp.ObjectModelEncapsulateLegacy.false...relation>
