        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0twgadd1jx4lvj16p8orx06x84ue' name='Custom SQL Query' type='text'>with sessions as (SELECT &#13;
date&#13;
, count(user_id) user_sessions&#13;
,COUNT(session_id) sessions&#13;
,COUNTIF(viewed_menu is TRUE) viewed_menu_sessions&#13;
,COUNTIF(added_to_cart is TRUE) added_to_cart_sessions&#13;
,COUNTIF(started_checkout is TRUE) checkout_sessions&#13;
,COUNTIF(placed_order IS TRUE) placed_order_sessions&#13;
&#13;
FROM `tlb-data-prod.data_platform.fct_session`&#13;
WHERE user_selected_country=&apos;Egypt&apos; and user_selected_city IS NOT NULL and user_selected_area IS NOT NULL&#13;
      and  (date between &apos;2022-01-01&apos; and &apos;2022-01-31&apos; or date between &apos;2022-07-01&apos; and &apos;2022-07-31&apos; or date between &apos;2023-01-01&apos; and &apos;2023-01-31&apos;)&#13;
group by 1&#13;
order by 1)&#13;
&#13;
,fr as(&#13;
        select&#13;
        order_date&#13;
        ,count(*) as gross&#13;
        ,sum(case when O.is_successful = false then 1 else 0 end) as Failed&#13;
        ,sum(case when DOS.is_net then 1 else 0 end) as Net&#13;
        ,sum(case when DOS.is_net and O.is_successful = False then 1 else 0 end) as Net_Failed&#13;
&#13;
        from `tlb-data-prod.data_platform.fct_order_info` O &#13;
        left join `tlb-data-prod.data_platform.dim_order_status` DOS on O.order_status_id = DOS.order_status_id &#13;
&#13;
        where (order_date between &apos;2022-01-01&apos; and &apos;2022-01-31&apos; or order_date between &apos;2022-07-01&apos; and &apos;2022-07-31&apos; or order_date between &apos;2023-01-01&apos; and &apos;2023-01-31&apos;) and O.country_id=9 and not O.is_test&#13;
&#13;
        group by 1&#13;
        order by 1)&#13;
&#13;
Select * except(order_date)&#13;
from sessions&#13;
left join fr on date= order_date</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0twgadd1jx4lvj16p8orx06x84ue' name='Custom SQL Query' type='text'>with sessions as (SELECT &#13;
date&#13;
, count(user_id) user_sessions&#13;
,COUNT(session_id) sessions&#13;
,COUNTIF(viewed_menu is TRUE) viewed_menu_sessions&#13;
,COUNTIF(added_to_cart is TRUE) added_to_cart_sessions&#13;
,COUNTIF(started_checkout is TRUE) checkout_sessions&#13;
,COUNTIF(placed_order IS TRUE) placed_order_sessions&#13;
&#13;
FROM `tlb-data-prod.data_platform.fct_session`&#13;
WHERE user_selected_country=&apos;Egypt&apos; and user_selected_city IS NOT NULL and user_selected_area IS NOT NULL&#13;
      and  (date between &apos;2022-01-01&apos; and &apos;2022-01-31&apos; or date between &apos;2022-07-01&apos; and &apos;2022-07-31&apos; or date between &apos;2023-01-01&apos; and &apos;2023-01-31&apos;)&#13;
group by 1&#13;
order by 1)&#13;
&#13;
,fr as(&#13;
        select&#13;
        order_date&#13;
        ,count(*) as gross&#13;
        ,sum(case when O.is_successful = false then 1 else 0 end) as Failed&#13;
        ,sum(case when DOS.is_net then 1 else 0 end) as Net&#13;
        ,sum(case when DOS.is_net and O.is_successful = False then 1 else 0 end) as Net_Failed&#13;
&#13;
        from `tlb-data-prod.data_platform.fct_order_info` O &#13;
        left join `tlb-data-prod.data_platform.dim_order_status` DOS on O.order_status_id = DOS.order_status_id &#13;
&#13;
        where (order_date between &apos;2022-01-01&apos; and &apos;2022-01-31&apos; or order_date between &apos;2022-07-01&apos; and &apos;2022-07-31&apos; or order_date between &apos;2023-01-01&apos; and &apos;2023-01-31&apos;) and O.country_id=9 and not O.is_test&#13;
&#13;
        group by 1&#13;
        order by 1)&#13;
&#13;
Select * except(order_date)&#13;
from sessions&#13;
left join fr on date= order_date</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
