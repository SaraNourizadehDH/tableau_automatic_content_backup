      <aliases enabled='yes' />
      <column caption='Benchmark Datediff' datatype='integer' name='[Benchmark Datediff (copy)_1379227414034108420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [order_date] &gt;= [Parameters].[order_date Parameter 3] and [order_date]&lt;= [Parameters].[order_date Parameter 4] then 1 end)' />
      </column>
      <column caption='Benchmark Orders' datatype='integer' name='[Calculation_1056657130462687232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [order_date] &gt;= [Parameters].[order_date Parameter 3] and [order_date]&lt;= [Parameters].[order_date Parameter 4] then [Orders] end)' />
      </column>
      <column caption='Actual Orders' datatype='integer' name='[Calculation_1056657130462949377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_date] &gt;= [Parameters].[order_date Parameter] and [order_date]&lt;= [Parameters].[order_date Parameter 2] then [Orders] end)' />
      </column>
      <column caption='Actual Datediff' datatype='integer' name='[Calculation_1056657130463313922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [order_date] &gt;= [Calculation_1056657130467368965] and [order_date]&lt;= [Calculation_1056657130467266564] then 1 end)' />
      </column>
      <column caption='Actual to' datatype='date' default-format='*ddd, mmmm dd, yyyy' name='[Calculation_1056657130467266564]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([Parameters].[order_date Parameter 2])' />
      </column>
      <column caption='Actual from' datatype='date' default-format='*ddd, mmmm dd, yyyy' name='[Calculation_1056657130467368965]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date([Parameters].[order_date Parameter])' />
      </column>
      <column caption='Benchmark from' datatype='date' default-format='*ddd, mmmm dd, yyyy' name='[Calculation_1056657130468352006]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date([Parameters].[order_date Parameter 3])' />
      </column>
      <column caption='Benchmark to' datatype='date' default-format='*ddd, mmmm dd, yyyy' name='[Calculation_1056657130468524039]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date([Parameters].[order_date Parameter 4])' />
      </column>
      <column caption='Benchmark Datediff_' datatype='integer' name='[Calculation_1056657130468659208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if CONTAINS([Calculation_1379227414008074242],&quot; 201 &quot;) &#13;&#10;then{ FIXED :MIN( DATEDIFF(&apos;week&apos;,[Calculation_1056657130468352006],[Calculation_1056657130468524039]))+1}&#13;&#10;else { FIXED :MIN( DATEDIFF(&apos;day&apos;,[Calculation_1056657130468352006],[Calculation_1056657130468524039]))+1}&#13;&#10;end' />
      </column>
      <column caption='Actual (Daily)' datatype='real' name='[Calculation_1056657130469224457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1056657130462949377]/[Calculation_1056657130463313922]' />
      </column>
      <column caption='Benchmark (Daily)' datatype='real' name='[Calculation_1056657130469666826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1056657130462687232]/[Benchmark Datediff (copy)_1379227414034108420]' />
      </column>
      <column caption='Change (Daily)' datatype='real' name='[Calculation_1056657130470371339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1056657130469224457] - [Calculation_1056657130469666826]' />
      </column>
      <column caption='Change %' datatype='real' default-format='p0.0%' name='[Calculation_1056657130470711308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1056657130469224457]/[Calculation_1056657130469666826])-1' />
      </column>
      <column caption='Weekday' datatype='string' name='[Calculation_1379227414008074242]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[order_date])' />
      </column>
      <column caption='benchmark dates' datatype='integer' name='[Calculation_1379227414026207235]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_1056657130468524039])+COUNTD([Calculation_1056657130468352006])' />
      </column>
      <column caption='Calculation1' datatype='boolean' name='[Calculation_1379227414044684294]' role='measure' type='nominal'>
        <calculation class='tableau' formula='TOTAL( COUNTD( [order_date] ) ) = SUM( { FIXED : COUNTD( [order_date] ) } )'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_CE933BB649D648499CC256D885B50EF3]' role='measure' type='quantitative' />
