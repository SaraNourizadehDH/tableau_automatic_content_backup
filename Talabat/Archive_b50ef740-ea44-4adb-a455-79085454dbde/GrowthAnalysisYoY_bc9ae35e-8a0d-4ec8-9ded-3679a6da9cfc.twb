        WHEN fct_o.is_tgo and  fct_o.is_darkstore THEN 'TGO tMart' END as order_type
    ,CASE WHEN  is_talabat_funded and not is_vendor_funded THEN 'Talabat Funded'
        WHEN is_vendor_funded and not is_talabat_funded THEN 'Vendor Funded'
        WHEN is_vendor_funded and is_talabat_funded THEN 'Talabat and Vendor Funded'
        WHEN not is_vendor_funded and not is_talabat_funded THEN 'None' END as fund_source
    ,CASE WHEN CONTAINS_SUBSTR(payment_method, 'talabat') THEN 'Talabat Credit Used'
        WHEN CONTAINS_SUBSTR(payment_method, 'Credit') THEN 'Credit Card Used'
        WHEN CONTAINS_SUBSTR(payment_method, 'Cash') THEN  'Cash Used' END as payment
    , CASE WHEN CAST(EXTRACT(hour from fct_o.order_time) as INT64) BETWEEN 0 and 6 THEN 'Night Owl' 
        WHEN CAST(EXTRACT(hour from fct_o.order_time) as INT64) BETWEEN 6 and 12 THEN 'Breakfast'
        WHEN  CAST(EXTRACT(hour from fct_o.order_time) as INT64) BETWEEN 12 and 18 THEN 'Lunch'
        WHEN  CAST(EXTRACT(hour from fct_o.order_time) as INT64) BETWEEN 18 and 24 THEN 'Dinner' END as time_of_day
    --,dim_vert.vertical
    ,device_group
    ,dim_loc.city_name
    ,dim_loc.area_name
    ,zone_name_final
    --, main_cuisine
    , IF(dim_chain.chain_id IN (502320,50321,50349,50328,50299,64373,50424,50801,50385,50929), 'Americana', 'Not Americana') as chain_cat
    , chain_name
    , vendor_name
    , IF(voucher_discount_amount_lc>>0, 'Voucher','No Voucher') voucher_avail
    --,dim_vend.account_manager_name
    ,IF(fund_amt_lc_restaurant>>0,'Restaurant Discount', 'No Restaurant Discount') fund_rest
    ,IF(fund_amt_lc_item>>0,'Item Discount', 'No Item Discount') fund_item
    ,CASE WHEN fct_o.is_tgo THEN  'TGO'ELSE  'TMP'END as tgo_tmp
    ,CASE WHEN fct_o.is_on_gem THEN 'Gem'ELSE 'No Gem'END as gem
    ,CASE WHEN dim_vend.is_key_vip_account THEN  'KA'ELSE 'NKA'END as ka
    ,CASE WHEN fct_o.is_acquisition THEN  'New Customer' ELSE 'Existing Customer' END as acq
    ,CASE WHEN fct_o.is_non_food and not fct_o.is_darkstore then 'NFV excl tMart' when not fct_o.is_non_food then 'Food' when fct_o.is_darkstore then 'tMart' END order_split 
    -- , cluster_name

    FROM `tlb-data-prod.data_platform.fct_order_info` fct_o
    LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` dim_loc on delivery_location_id = location_id
    LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` dim_vend using(vendor_id)
