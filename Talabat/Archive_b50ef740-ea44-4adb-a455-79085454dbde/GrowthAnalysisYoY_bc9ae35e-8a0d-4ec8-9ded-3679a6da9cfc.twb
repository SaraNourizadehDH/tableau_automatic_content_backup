            <parent-name>[Custom SQL Query]</parent-name>
            <remote-alias>Orders</remote-alias>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
            <_.fcp.ObjectModelEncapsulateLegacy.true...object-id>[_1EBFA2D85074464A8A63684E865CFE9B]</_.fcp.ObjectModelEncapsulateLegacy.true...object-id>
          </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
      <column caption='Benchmark From (LLW)' datatype='date' name='[Actual From (LW) (copy)_1111826222983081989]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY() - 14' />
      </column>
      <column caption='Benchmark To (LLW)' datatype='date' name='[Actual To (LW) (copy)_1111826222982959108]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY() - 8' />
      </column>
      <column caption='Benchmark Orders' datatype='integer' name='[Calculation_1056657130462687232]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [order_date] &gt;= [Parameters].[order_date Parameter 3] and [order_date]&lt;= [Parameters].[order_date Parameter 4] then [Orders] end)' />
      </column>
      <column caption='Actual Orders' datatype='integer' name='[Calculation_1056657130462949377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_date] &gt;= [Parameters].[order_date Parameter] and [order_date]&lt;= [Parameters].[order_date Parameter 2] then [Orders] end)' />
      </column>
      <column caption='Actual Datediff' datatype='integer' name='[Calculation_1056657130463313922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [order_date] &gt;= [Calculation_1056657130467368965] and [order_date]&lt;= [Calculation_1056657130467266564] then 1 end)' />
      </column>
      <column caption='Actual to' datatype='date' name='[Calculation_1056657130467266564]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([Parameters].[order_date Parameter 2])' />
      </column>
      <column caption='Actual from' datatype='date' name='[Calculation_1056657130467368965]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date([Parameters].[order_date Parameter])' />
      </column>
      <column caption='Benchmark from' datatype='date' name='[Calculation_1056657130468352006]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date([Parameters].[order_date Parameter 3])' />
      </column>
      <column caption='Benchmark to' datatype='date' name='[Calculation_1056657130468524039]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date([Parameters].[order_date Parameter 4])' />
      </column>
      <column caption='Benchmark Datediff' datatype='integer' name='[Calculation_1056657130468659208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [order_date] &gt;= [Parameters].[order_date Parameter 3] and [order_date]&lt;= [Parameters].[order_date Parameter 4] then 1 end)' />
      </column>
      <column caption='Actual (Daily)' datatype='real' datatype-customized='true' name='[Calculation_1056657130469224457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(INT(IF[Calculation_1972576647263301632]&gt;0 then[Calculation_1056657130462949377] else 0 end)/[Calculation_1056657130463313922],0)' />
      </column>
      <column caption='Benchmark (Daily)' datatype='real' datatype-customized='true' name='[Calculation_1056657130469666826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(INT(IF[a.order_date_count (copy)_1972576647264415745]&gt;0 then[Calculation_1056657130462687232] else 0 end)/[Calculation_1056657130468659208],0)' />
      </column>
      <column caption='Change (Daily)' datatype='real' name='[Calculation_1056657130470371339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1056657130469224457] - [Calculation_1056657130469666826]' />
      </column>
      <column caption='Change %' datatype='real' default-format='p0.0%' name='[Calculation_1056657130470711308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1056657130469224457]/[Calculation_1056657130469666826])-1' />
