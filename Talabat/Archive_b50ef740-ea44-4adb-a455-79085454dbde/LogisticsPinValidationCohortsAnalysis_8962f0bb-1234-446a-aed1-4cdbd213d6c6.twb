              <calculation class='tableau' formula='IF { FIXED [account_id] : COUNTD([device_id]) } = 1 THEN &quot;1 Device&quot;&#10;ELSEIF { FIXED [account_id] : COUNTD([device_id]) } = 2 THEN &quot;2 Devices&quot;&#10;ELSEIF { FIXED [account_id] : COUNTD([device_id]) } = 3 THEN &quot;3 Devices&quot;&#10;ELSEIF { FIXED [account_id] : COUNTD([device_id]) } = 4 THEN &quot;4 Devices&quot;&#10;ELSEIF { FIXED [account_id] : COUNTD([device_id]) } = 5 THEN &quot;5 Devices&quot;&#10;ELSE &quot;6+&quot;&#10;END' />
