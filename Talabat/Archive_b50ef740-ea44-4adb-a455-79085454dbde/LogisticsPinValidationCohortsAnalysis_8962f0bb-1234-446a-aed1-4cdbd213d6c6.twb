    <worksheet name='marked_as_delivered_orders'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='11'>Marked as Delivered Orders - Overview by Cohort (not by month)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='pin_validation_data' name='federated.0fgoiyn1audxzy12zddjl07sx7yj' />
            <datasource caption='creation_date' name='federated.0tbz2qy13jocn414l2tkk026ph1t' />
          </datasources>
          <datasource-dependencies datasource='federated.0fgoiyn1audxzy12zddjl07sx7yj'>
            <column caption='device_id_split' datatype='string' name='[Calculation_1279163046536601603]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF { FIXED [account_id] : COUNTD([device_id]) } = 1 THEN &quot;1 Device&quot;&#10;ELSEIF { FIXED [account_id] : COUNTD([device_id]) } = 2 THEN &quot;2 Devices&quot;&#10;ELSEIF { FIXED [account_id] : COUNTD([device_id]) } = 3 THEN &quot;3 Devices&quot;&#10;ELSEIF { FIXED [account_id] : COUNTD([device_id]) } = 4 THEN &quot;4 Devices&quot;&#10;ELSEIF { FIXED [account_id] : COUNTD([device_id]) } = 5 THEN &quot;5 Devices&quot;&#10;ELSE &quot;6+&quot;&#10;END' />
            </column>
            <column caption='Marked_as_delivered_field' datatype='string' name='[Calculation_5431481901202513923]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [marked_as_delivered_contact_orders] &gt;= 1&#10;THEN &apos;Yes&apos;&#10;ELSE &apos;No&apos;&#10;END' />
            </column>
            <column caption='Avg. gmv loss by marked orders' datatype='real' name='[Calculation_5431481901204160516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([sum_gmv_amount_lc]) / SUM([marked_as_delivered_contact_orders])' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[account_id]' role='dimension' type='ordinal' />
            <column datatype='string' name='[cohort]' role='dimension' type='nominal' />
            <column datatype='real' name='[compensation_amount]' role='measure' type='quantitative' />
            <column datatype='integer' name='[completed_online_tgo_orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[completed_tgo_orders]' role='measure' type='quantitative' />
            <column datatype='string' name='[country_cohort]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[country_placed_order]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[account_id]' derivation='CountD' name='[ctd:account_id:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[device_id]' role='dimension' type='nominal' />
