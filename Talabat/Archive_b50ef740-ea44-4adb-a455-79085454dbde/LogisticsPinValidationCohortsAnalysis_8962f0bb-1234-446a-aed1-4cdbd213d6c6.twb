      </column>
      <column caption='device_id_split' datatype='string' name='[Calculation_1279163046536601603]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF { FIXED [account_id] : COUNTD([device_id]) } = 1 THEN &quot;1 Device&quot;&#10;ELSEIF { FIXED [account_id] : COUNTD([device_id]) } = 2 THEN &quot;2 Devices&quot;&#10;ELSEIF { FIXED [account_id] : COUNTD([device_id]) } = 3 THEN &quot;3 Devices&quot;&#10;ELSEIF { FIXED [account_id] : COUNTD([device_id]) } = 4 THEN &quot;4 Devices&quot;&#10;ELSEIF { FIXED [account_id] : COUNTD([device_id]) } = 5 THEN &quot;5 Devices&quot;&#10;ELSE &quot;6+&quot;&#10;END' />
      </column>
      <column caption='device_count' datatype='integer' name='[Calculation_1279163046539735044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([device_id])' />
      </column>
      <column caption='Cohort_start_date' datatype='string' name='[Calculation_5431481900929552384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [cohort] = STR(DATENAME(&apos;month&apos;, [first_order_date]))&#10;THEN &quot;yes&quot;&#10;ELSE &quot;no&quot;&#10;END' />
      </column>
      <column caption='Marked_as_delivered_field' datatype='string' name='[Calculation_5431481901202513923]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [marked_as_delivered_contact_orders] &gt;= 1&#10;THEN &apos;Yes&apos;&#10;ELSE &apos;No&apos;&#10;END' />
      </column>
      <column caption='Avg. gmv loss by marked orders' datatype='real' name='[Calculation_5431481901204160516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([sum_gmv_amount_lc]) / SUM([marked_as_delivered_contact_orders])' />
      </column>
      <column caption='account count' datatype='integer' name='[Calculation_5431481901656911880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(account_id)' />
      </column>
      <column caption='select chart' datatype='real' name='[Calculation_754915902081540098]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;  WHEN &apos;marked_as_delivered_contact_orders&apos; THEN [marked_as_delivered_contact_orders]&#10;  WHEN &apos;completed_online_tgo_orders&apos; THEN [completed_online_tgo_orders]&#10;  WHEN &apos;refund_amount&apos; THEN [refund_amount]&#10;  WHEN &apos;completed_tgo_orders&apos; THEN [completed_tgo_orders]&#10;  WHEN &apos;marked_as_delivered_contact_compensation_lc&apos; THEN [marked_as_delivered_contact_compensation_lc]&#10;  WHEN &apos;total_orders&apos; THEN [total_orders]&#10;  WHEN &apos;total_tgo_orders&apos; THEN [total_tgo_orders]&#10;  ELSE NULL&#10;END' />
      </column>
      <column caption='Cohort_start_date (copy)' datatype='real' name='[Cohort_start_date (copy)_5431481900932501506]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [cohort] &gt;= STR(DATENAME(&apos;month&apos;, [first_order_date]))&#10;THEN [marked_as_delivered_contact_compensation_lc]&#10;ELSE NULL&#10;END' />
      </column>
      <column caption='More than 2 orders' datatype='string' name='[Marked_as_delivered_field (copy)_5431481901219196934]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF sum([marked_as_delivered_contact_orders]) &gt;= 2&#10;THEN &apos;Yes&apos;&#10;ELSE &apos;No&apos;&#10;END' />
      </column>
