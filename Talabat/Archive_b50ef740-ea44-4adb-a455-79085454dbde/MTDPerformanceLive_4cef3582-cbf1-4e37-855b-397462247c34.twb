        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0im5xfb1i1e57f13ptovt1nbm31e' name='Custom SQL Query' type='text'><![CDATA[-- raw sql results do not include filled-in values for 'fct_order_info.order_date_date'


SELECT
    (fct_order_info.order_date ) AS fct_order_info_order_date_date,
    COALESCE(SUM(CASE WHEN fct_order_info.is_successful  THEN 1  ELSE NULL END), 0) AS fct_order_info_successful_orders_count,
    AVG(CASE WHEN fct_order_info.is_successful  THEN fct_order_info.delivery_fee_amount_lc  ELSE NULL END) AS fct_order_info_avg_delivery_fee_amount_lc,
    COALESCE(SUM(CASE WHEN fct_order_info.is_successful  THEN fct_order_info.gmv_amount_lc  ELSE NULL END), 0) AS fct_order_info_successful_gmv_amount_lc,
    AVG(CASE WHEN fct_order_info.is_successful  THEN fct_order_info.basket_amount_lc  ELSE NULL END) AS fct_order_info_avg_basket_amount_lc,
    COALESCE(SUM(CASE WHEN  dim_order_status_flags.is_net   AND NOT  fct_order_info.is_successful   THEN  1   ELSE 0 END ), 0) AS fct_order_info_net_failed_orders_count,
    COALESCE(SUM(CASE WHEN NOT COALESCE( fct_order_info.is_successful  , FALSE) THEN fct_order_info.gmv_amount_lc  ELSE NULL END), 0) AS fct_order_info_lost_gmv_amount_lc,
    SAFE_DIVIDE(COALESCE(SUM(CASE WHEN (( CASE WHEN fct_order_info.delivery_arrangement = 'TMP' THEN TRUE ELSE FALSE END  )) AND ( fct_order_info.is_successful ) THEN 1  ELSE NULL END), 0), COALESCE(SUM(CASE WHEN fct_order_info.is_successful  THEN 1  ELSE NULL END), 0)) AS fct_order_info_tmp_order_share,
    SAFE_DIVIDE(COALESCE(SUM(CASE WHEN ( fct_order_info.is_tgo  ) AND ( fct_order_info.is_successful ) THEN 1  ELSE NULL END), 0), COALESCE(SUM(CASE WHEN fct_order_info.is_successful  THEN 1  ELSE NULL END), 0)) AS fct_order_info_tgo_order_share,
    SAFE_DIVIDE(COALESCE(SUM(CASE WHEN fct_billing.is_successful  THEN fct_billing.commission_amount_eur  ELSE NULL END), 0), COALESCE(SUM(CASE WHEN fct_billing.is_successful  THEN fct_billing.commissionable_gmv_amount_eur  ELSE NULL END), 0)) AS fct_order_info_commission_rate,
    COALESCE(SUM(fct_order_info.service_fee_amount_lc ), 0) AS fct_order_info_service_fee_amount_lc,
    SAFE_DIVIDE(COALESCE(SUM(CASE WHEN  dim_order_status_flags.is_net   AND NOT  fct_order_info.is_successful   AND  dim_order_fail_reason.owner   = 'VENDOR' THEN  1   ELSE 0 END ), 0), COALESCE(SUM(CASE WHEN  dim_order_status_flags.is_net   THEN  1   ELSE 0 END ), 0)) AS fct_order_info_vendor_fail_rate
FROM `tlb-data-prod.data_platform.fct_order_info`
     AS fct_order_info
INNER JOIN `tlb-data-prod.data_platform.dim_order_status`
     AS dim_order_status_flags ON dim_order_status_flags.order_status_id = fct_order_info.order_status_id
LEFT JOIN `tlb-data-prod.data_platform.fct_billing`
     AS fct_billing ON fct_billing.order_id = fct_order_info.order_id
LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason`
     AS dim_order_fail_reason ON dim_order_fail_reason.order_fail_reason_id = fct_order_info.order_fail_reason_id
INNER JOIN `tlb-data-prod.data_platform.dim_chain`
     AS dim_chain ON dim_chain.chain_id = fct_order_info.chain_id
INNER JOIN `tlb-data-prod.data_platform.dim_location_info`
     AS delivery_location ON delivery_location.location_id = fct_order_info.delivery_location_id
WHERE (fct_order_info.order_date ) >>= (DATE('2022-02-01')) AND ((UPPER(( dim_chain.chain_name  )) NOT LIKE UPPER('%talabat mart%') AND UPPER(( dim_chain.chain_name  )) NOT LIKE UPPER('%Talabat mart%') OR ( dim_chain.chain_name  ) IS NULL)) AND ((UPPER(( dim_chain.vertical  )) <<>> UPPER('food') OR ( dim_chain.vertical  ) IS NULL)) AND ((UPPER(( delivery_location.city_name  )) = UPPER('Dubai') OR UPPER(( delivery_location.city_name  )) = UPPER('Abu Dhabi') OR UPPER(( delivery_location.city_name  )) = UPPER('Sharjah') OR UPPER(( delivery_location.city_name  )) = UPPER('Al Ain') OR UPPER(( delivery_location.city_name  )) = UPPER('Ajman') OR UPPER(( delivery_location.city_name  )) = UPPER('Fujairah') OR UPPER(( delivery_location.city_name  )) = UPPER('Ras Al Khaima') OR UPPER(( delivery_location.city_name  )) = UPPER('Umm Al-Quwain'))) AND (fct_order_info.order_date >>= DATE_ADD(DATE_TRUNC(DATE_ADD(CURRENT_DATE(), INTERVAL -180 DAY), YEAR), INTERVAL -2 YEAR)
  and fct_order_info.country_iso like case when 'no'='yes' then '%' else 'AE' end)
GROUP BY
    1
ORDER BY
    1 DESC]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.0im5xfb1i1e57f13ptovt1nbm31e' name='Custom SQL Query' type='text'><![CDATA[-- raw sql results do not include filled-in values for 'fct_order_info.order_date_date'


SELECT
    (fct_order_info.order_date ) AS fct_order_info_order_date_date,
    COALESCE(SUM(CASE WHEN fct_order_info.is_successful  THEN 1  ELSE NULL END), 0) AS fct_order_info_successful_orders_count,
    AVG(CASE WHEN fct_order_info.is_successful  THEN fct_order_info.delivery_fee_amount_lc  ELSE NULL END) AS fct_order_info_avg_delivery_fee_amount_lc,
    COALESCE(SUM(CASE WHEN fct_order_info.is_successful  THEN fct_order_info.gmv_amount_lc  ELSE NULL END), 0) AS fct_order_info_successful_gmv_amount_lc,
    AVG(CASE WHEN fct_order_info.is_successful  THEN fct_order_info.basket_amount_lc  ELSE NULL END) AS fct_order_info_avg_basket_amount_lc,
    COALESCE(SUM(CASE WHEN  dim_order_status_flags.is_net   AND NOT  fct_order_info.is_successful   THEN  1   ELSE 0 END ), 0) AS fct_order_info_net_failed_orders_count,
    COALESCE(SUM(CASE WHEN NOT COALESCE( fct_order_info.is_successful  , FALSE) THEN fct_order_info.gmv_amount_lc  ELSE NULL END), 0) AS fct_order_info_lost_gmv_amount_lc,
    SAFE_DIVIDE(COALESCE(SUM(CASE WHEN (( CASE WHEN fct_order_info.delivery_arrangement = 'TMP' THEN TRUE ELSE FALSE END  )) AND ( fct_order_info.is_successful ) THEN 1  ELSE NULL END), 0), COALESCE(SUM(CASE WHEN fct_order_info.is_successful  THEN 1  ELSE NULL END), 0)) AS fct_order_info_tmp_order_share,
    SAFE_DIVIDE(COALESCE(SUM(CASE WHEN ( fct_order_info.is_tgo  ) AND ( fct_order_info.is_successful ) THEN 1  ELSE NULL END), 0), COALESCE(SUM(CASE WHEN fct_order_info.is_successful  THEN 1  ELSE NULL END), 0)) AS fct_order_info_tgo_order_share,
    SAFE_DIVIDE(COALESCE(SUM(CASE WHEN fct_billing.is_successful  THEN fct_billing.commission_amount_eur  ELSE NULL END), 0), COALESCE(SUM(CASE WHEN fct_billing.is_successful  THEN fct_billing.commissionable_gmv_amount_eur  ELSE NULL END), 0)) AS fct_order_info_commission_rate,
    COALESCE(SUM(fct_order_info.service_fee_amount_lc ), 0) AS fct_order_info_service_fee_amount_lc,
    SAFE_DIVIDE(COALESCE(SUM(CASE WHEN  dim_order_status_flags.is_net   AND NOT  fct_order_info.is_successful   AND  dim_order_fail_reason.owner   = 'VENDOR' THEN  1   ELSE 0 END ), 0), COALESCE(SUM(CASE WHEN  dim_order_status_flags.is_net   THEN  1   ELSE 0 END ), 0)) AS fct_order_info_vendor_fail_rate
FROM `tlb-data-prod.data_platform.fct_order_info`
     AS fct_order_info
INNER JOIN `tlb-data-prod.data_platform.dim_order_status`
     AS dim_order_status_flags ON dim_order_status_flags.order_status_id = fct_order_info.order_status_id
LEFT JOIN `tlb-data-prod.data_platform.fct_billing`
     AS fct_billing ON fct_billing.order_id = fct_order_info.order_id
LEFT JOIN `tlb-data-prod.data_platform.dim_order_fail_reason`
     AS dim_order_fail_reason ON dim_order_fail_reason.order_fail_reason_id = fct_order_info.order_fail_reason_id
INNER JOIN `tlb-data-prod.data_platform.dim_chain`
     AS dim_chain ON dim_chain.chain_id = fct_order_info.chain_id
INNER JOIN `tlb-data-prod.data_platform.dim_location_info`
     AS delivery_location ON delivery_location.location_id = fct_order_info.delivery_location_id
WHERE (fct_order_info.order_date ) >>= (DATE('2022-02-01')) AND ((UPPER(( dim_chain.chain_name  )) NOT LIKE UPPER('%talabat mart%') AND UPPER(( dim_chain.chain_name  )) NOT LIKE UPPER('%Talabat mart%') OR ( dim_chain.chain_name  ) IS NULL)) AND ((UPPER(( dim_chain.vertical  )) <<>> UPPER('food') OR ( dim_chain.vertical  ) IS NULL)) AND ((UPPER(( delivery_location.city_name  )) = UPPER('Dubai') OR UPPER(( delivery_location.city_name  )) = UPPER('Abu Dhabi') OR UPPER(( delivery_location.city_name  )) = UPPER('Sharjah') OR UPPER(( delivery_location.city_name  )) = UPPER('Al Ain') OR UPPER(( delivery_location.city_name  )) = UPPER('Ajman') OR UPPER(( delivery_location.city_name  )) = UPPER('Fujairah') OR UPPER(( delivery_location.city_name  )) = UPPER('Ras Al Khaima') OR UPPER(( delivery_location.city_name  )) = UPPER('Umm Al-Quwain'))) AND (fct_order_info.order_date >>= DATE_ADD(DATE_TRUNC(DATE_ADD(CURRENT_DATE(), INTERVAL -180 DAY), YEAR), INTERVAL -2 YEAR)
  and fct_order_info.country_iso like case when 'no'='yes' then '%' else 'AE' end)
GROUP BY
    1
ORDER BY
    1 DESC]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
