        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0dn01b41mjsd4y1115t2e1souyys' name='Custom SQL Query' type='text'>SELECT
    (DATE(timestamp(dh_fct_customer_orders.date) )) AS dh_fct_customer_orders_order_placed_at_date,
    dh_fct_customer_order_lines.order_id,
    dim_grocery_product.master_category_parent_english  AS dim_grocery_product_master_category_parent_english,
    dim_vendor.country_iso  AS dim_vendor_country_iso,
    dim_grocery_product.master_category_english AS dim_grocery_product_master_category_english,
    dim_grocery_product.skus,
    dh_fct_customer_order_lines.total_price_paid_lc,
    dh_fct_customer_order_lines.total_price_paid_eur,
    dh_fct_customer_order_lines.qty_sold 
FROM `bta---talabat.data_platform_dmart.fct_customer_order_lines`
     AS dh_fct_customer_order_lines
INNER JOIN `bta---talabat.data_platform_dmart.fct_customer_orders`
     AS dh_fct_customer_orders ON dh_fct_customer_order_lines.order_id = dh_fct_customer_orders.order_id and dh_fct_customer_order_lines.global_entity_id = dh_fct_customer_orders.global_entity_id
LEFT JOIN `bta---talabat.data_platform.dim_vendor`
     AS dim_vendor ON cast(dim_vendor.vendor_id AS string) = dh_fct_customer_orders.vendor_id
LEFT JOIN `bta---talabat.data_platform_dmart.dim_product`
     AS dim_grocery_product ON dh_fct_customer_order_lines.global_product_id = dim_grocery_product.global_product_id and dh_fct_customer_order_lines.global_entity_id = dim_grocery_product.global_entity_id
WHERE (dim_vendor.is_grocery_darkstore )
AND dh_fct_customer_orders.date &gt;&gt;= &apos;2021-01-01&apos;</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
