      <aliases enabled='yes' />
      <column caption='daily_late_adhoc_payment_rate1' datatype='real' default-format='p0.00%' name='[Calculation_5702190486563438592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([completed_adhoc_late]+[completed_on_schedule])/&#10;sum([completed_adhoc_late]+[completed_on_schedule]+[late_until_now])' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_20522AC0B35D469EA48B6A628DF337E1]' role='measure' type='quantitative' />
      <column aggregation='Count' datatype='date' datatype-customized='true' name='[date]' role='dimension' type='ordinal' />
      <column datatype='string' name='[experiment_variant]' role='dimension' type='nominal' />
      <column-instance column='[experiment_variant]' derivation='None' name='[none:experiment_variant:nk]' pivot='key' type='nominal' />
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:experiment_variant:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;Control&quot;</bucket>
            </map>
            <map to='#76b7b2'>
              <bucket>&quot;None&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;Variation2 - banner&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;Variation1 - list tag&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_20522AC0B35D469EA48B6A628DF337E1'>
            <properties context=''>
              <relation connection='bigquery.0kkhpzw02clokw10rcd8813p59bo' name='Custom SQL Query' type='text'><![CDATA[select *, 
(completed_adhoc_late + completed_on_schedule )/
(completed_adhoc_late + completed_on_schedule+late_until_now) daily_late_adhoc_payment_rate
from
(with payment as
(select 
date, 
order_id,
created_timestamp,
installment_id,
row_number() OVER (PARTITION BY installment_id,order_id ORDER BY date DESC) as rn
from `tlb-data-prod.data_platform.fct_bnpl_payment`
where payment_status_id=3/*successful*/
), 
late_until_now as 
(
select distinct cast( a.installment_timestamp as date) date /*due date*/ ,
coalesce(fes.operating_system,'No experiment') operating_system, 
coalesce(fes.experiment_variant,'No experiment') experiment_variant,
fbo.order_id
from `tlb-data-prod.data_platform.fct_bnpl_installment` a/*one record per order right now*/
join `tlb-data-prod.data_platform.fct_bnpl_order` fbo on (a.bnpl_order_id=fbo.bnpl_order_id )
join `tlb-data-prod.data_platform.dim_account` account on (safe_cast(fbo.customer_id as integer)=account.account_id)
join `tlb-data-prod.data_platform.fct_session` fs on (account.user_id=fs.user_id and fs.date>>='2022-11-28')
join `tlb-data-prod.data_platform.fct_experiment_session` fes on (fs.session_id=fes.session_id and fs.date=fes.date 
and fs.date>>='2022-11-28' and experiment_id='exp_user_bnpl_ob_notifications')
where installment_state_id in (8)
),
late_until_now_agg as 
(
select date /*due date*/ ,
operating_system, 
experiment_variant,
sum(sum(1)) over (partition by operating_system,experiment_variant  order by date/*overdue date*/) as late_until_now
from late_until_now
group by 1,2,3
), 
paid_late as 
(
select b.date,
coalesce(fes.operating_system,'No experiment') operating_system, 
coalesce(fes.experiment_variant,'No experiment') experiment_variant,
count(distinct(case when installment_state_id=3 then fbo.order_id end)) as completed_adhoc_late ,
count(distinct(case when installment_state_id=5 and a.installment_timestamp/*due date*/<<b.created_timestamp then fbo.order_id end)) as completed_on_schedule 
from `tlb-data-prod.data_platform.fct_bnpl_installment` a/*one record per order right now*/
join payment b on (a.order_id=b.order_id and a.installment_id=b.installment_id )
join `tlb-data-prod.data_platform.fct_bnpl_order` fbo on (a.bnpl_order_id=fbo.bnpl_order_id)
join `tlb-data-prod.data_platform.dim_account` account on (safe_cast(fbo.customer_id as integer)=account.account_id)
join `tlb-data-prod.data_platform.fct_session` fs on (account.user_id=fs.user_id and fs.date>>='2022-11-28')
join `tlb-data-prod.data_platform.fct_experiment_session` fes on (fs.session_id=fes.session_id and fs.date=fes.date 
and fs.date>>='2022-11-28' and experiment_id='exp_user_bnpl_ob_notifications')
where b.date>>='2022-11-28'
group by 1,2,3
) 

select b.date,
a.operating_system, 
replace(replace(a.experiment_variant, 'Variation1','Variation1 - list tag'),'Variation2','Variation2 - banner') as experiment_variant,
completed_adhoc_late, 
completed_on_schedule, 
late_until_now
from late_until_now_agg a,
paid_late b 
where a.date=b.date 
and a.operating_system=b.operating_system
and a.experiment_variant=b.experiment_variant
)]]></relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
    <datasource caption='OB_experiment_participants' inline='true' name='federated.0ma9nxh0yz6a3n14cn6jl1imfywv' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1e9f5ly1fz6ffi153evro1bwugc5'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-prod' authentication='yes' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server='' server-oauth='' username='mariam.nufal@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1e9f5ly1fz6ffi153evro1bwugc5' name='Custom SQL Query' type='text'>with raw as 
(select 
fs.date, 
fes.operating_system,
fes.experiment_variant, 
fs.user_id, 
row_number() over(partition by fs.user_id order by fs.date, fs.session_id) as participation_number
from `tlb-data-prod.data_platform.fct_experiment_session` fes 
join `tlb-data-prod.data_platform.fct_session` fs on (fs.session_id=fes.session_id and fs.date=fes.date and fs.date&gt;&gt;=&apos;2022-11-28&apos;)
where fs.date&gt;&gt;=&apos;2022-11-21&apos; 
and experiment_id=&apos;exp_user_bnpl_ob_notifications&apos;)
select 
date, 
operating_system,
experiment_variant, 
sum (count(distinct (case when participation_number = 1 then user_id end)))
      over (partition by operating_system, experiment_variant order by date ) participants_count_till_date
from raw
group by 1,2,3
order by 1 desc</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1e9f5ly1fz6ffi153evro1bwugc5' name='Custom SQL Query' type='text'>with raw as 
