join `tlb-data-prod.data_platform.fct_bnpl_order` fbo on (a.bnpl_order_id=fbo.bnpl_order_id)
join `tlb-data-prod.data_platform.dim_account` account on (safe_cast(fbo.customer_id as integer)=account.account_id)
group by 1
) 
select b.date,
completed_adhoc_late, 
completed_on_schedule, 

late_until_now
from late_until_now_agg a,
paid_late b 
where a.date=b.date 
)
order by 1 desc]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
