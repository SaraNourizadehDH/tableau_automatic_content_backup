      <aliases enabled='yes' />
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_199565773398802432] / TOTAL([Calculation_199565773398802432])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_199565773398802432] / TOTAL([Calculation_199565773398802432])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Customers Count' datatype='integer' name='[Calculation_199565773398802432]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD([analytical_customer_id])' />
      </column>
      <column aggregation='Sum' caption='Months To Repeat' datatype='integer' name='[Calculation_199565773400563713]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[Calculation_199565773400682498],[date])' />
      </column>
      <column caption='First Order' datatype='date' name='[Calculation_199565773400682498]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [analytical_customer_id]:MIN([date])}' />
      </column>
      <column caption='Reorder Rate M0' datatype='real' default-format='p0.00%' name='[Calculation_199565773403688963]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(CASE [Calculation_199565773400563713] WHEN 0 THEN IF [date]&lt;&gt;[first_ds_order_date] THEN [analytical_customer_id] ELSE NULL END END)&#13;&#10;/ ATTR({ FIXED DATETRUNC(&apos;month&apos;,[first_ds_order_date]) : COUNTD([analytical_customer_id]) } )' />
      </column>
      <column caption='Reorder M0 Filter' datatype='boolean' name='[Calculation_199565773405515780]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_199565773403688963] WHEN 0 THEN FALSE ELSE TRUE END' />
      </column>
      <column caption='Orders' datatype='integer' name='[Calculation_199565773715124230]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_199565773715177479]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_199565773715124230] / [Calculation_199565773398802432]' />
      </column>
      <column caption='ABV' datatype='real' name='[Calculation_199565773717704713]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_199565773781286926] / [Calculation_199565773715124230]' />
      </column>
      <column aggregation='Sum' caption='dat dif' datatype='integer' name='[Calculation_199565773748699147]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,#December 1, 2021#,#December 1, 2022#)' />
      </column>
      <column caption='Sales' datatype='real' name='[Calculation_199565773781286926]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM({ FIXED [order_id],[global_entity_id]: MIN(&#13;&#10;CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;LC&quot; THEN [basket_amount_lc]&#13;&#10;WHEN &quot;EUR&quot; THEN [basket_amount_eur]&#13;&#10;END) })' />
      </column>
      <column caption='Spend / Customer' datatype='real' name='[Calculation_199565773783531535]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_199565773781286926] / [Calculation_199565773398802432]' />
      </column>
      <column aggregation='Sum' datatype='integer' name='[Month - Year]' role='dimension' type='ordinal' user:agg-type='MY' user:base-field='first_ds_order_date' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='(DATEPART(&apos;year&apos;, [first_ds_order_date])*100 + DATEPART(&apos;month&apos;, [first_ds_order_date]))' />
      </column>
      <_.fcp.ObjectModelTableType.true...column caption='Custom SQL Query' datatype='table' name='[__tableau_internal_object_id__].[_266571D1032F42CE99D9D2E07E8C4FDF]' role='measure' type='quantitative' />
      <column caption='First Category' datatype='string' name='[category1]' role='dimension' type='nominal' />
      <column caption='Category Re-ordered' datatype='string' name='[category2]' role='dimension' type='nominal' />
      <column caption='First Sub Category' datatype='string' name='[subcategory1]' role='dimension' type='nominal' />
      <column caption='Sub Category Re-ordered' datatype='string' name='[subcategory2]' role='dimension' type='nominal' />
      <column caption='Store Name' datatype='string' name='[warehouse_name]' role='dimension' type='nominal' />
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;LC&quot;'>
          <calculation class='tableau' formula='&quot;LC&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_266571D1032F42CE99D9D2E07E8C4FDF'>
            <properties context=''>
              <relation connection='bigquery.1ypfg4409916i91gf6qem0vir3qz' name='Custom SQL Query' type='text'><![CDATA[WITH ds AS

(
    SELECT * FROM(
SELECT
  l.global_entity_id,
  l.analytical_customer_id,
  DATE(l.date) AS first_ds_order_date,
  p.category_parent_english AS first_ds_category,
  p.category_english AS first_ds_subcategory,
  DENSE_RANK() OVER(PARTITION BY l.analytical_customer_id, l.global_entity_id ORDER BY date) AS first_order, 
  c.chain_name,
  v.vendor_name


FROM
  `tlb-data-prod.data_platform_dmart.fct_customer_order_lines` l
LEFT JOIN
  `tlb-data-prod.data_platform_dmart.dim_product` p
ON
  p.skus = l.sku 
  AND p.global_entity_id = l.global_entity_id
  AND p.vendor_id = l.vendor_id

LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v
  ON  CAST (v.vendor_id AS STRING) = l.vendor_id

LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c 
  ON   c.source_system_chain_id  = v.chain_id

WHERE 
l.is_sent 
AND vertical<<>>'food' 
AND (sub_vertical='marketplace' OR sub_vertical IS NULL)



ORDER BY analytical_customer_id, date(l.date)
    )

WHERE first_order = 1
)

SELECT 
l.global_entity_id,
warehouse_name,
l.analytical_customer_id,
l.order_id,
DATE(l.date) as date,
category_parent_english  as category2,
category_english as subcategory2,
ds.first_ds_order_date,
ds.first_ds_subcategory as subcategory1,
ds.first_ds_category as category1,
l.total_price_paid_eur,
l.total_price_paid_lc,
is_voucher,
c.chain_name,
c.vertical,
c.sub_vertical,
l.sku,
foi.basket_amount_lc,
foi.basket_amount_eur



FROM
  `tlb-data-prod.data_platform_dmart.fct_customer_order_lines` l

INNER JOIN ds ON ds.analytical_customer_id = l.analytical_customer_id AND ds.global_entity_id = l.global_entity_id
LEFT JOIN `tlb-data-prod.data_platform_dmart.dim_product` dp ON dp.global_product_id = l.global_product_id AND dp.global_entity_id = l.global_entity_id 
INNER JOIN `tlb-data-prod.data_platform_dmart.fct_customer_orders` co on co.order_id = l.order_id and co.global_entity_id = l.global_entity_id
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v
  ON  CAST (v.vendor_id AS STRING) = l.vendor_id

LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c 
  ON   c.source_system_chain_id  = v.chain_id


LEFT JOIN `tlb-data-prod.data_platform.fct_order_info` foi
ON CAST(foi.order_id AS STRING) = l.order_id

WHERE
l.is_sent
AND l.date>>=ds.first_ds_order_date
AND vertical<<>>'food' 
AND (sub_vertical='marketplace' OR sub_vertical IS NULL)]]></relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
