      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1s51ulb0rinfik1e74rpm1dfnp9f' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;LC&quot;'>
              <calculation class='tableau' formula='&quot;LC&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1s51ulb0rinfik1e74rpm1dfnp9f'>
            <column aggregation='Sum' caption='Months To Repeat' datatype='integer' name='[Calculation_199565773400563713]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;,[Calculation_199565773400682498],[date])' />
            </column>
            <column caption='First Order' datatype='date' name='[Calculation_199565773400682498]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [analytical_customer_id]:MIN([date])}' />
            </column>
            <column caption='Sales' datatype='real' name='[Calculation_199565773781286926]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM({ FIXED [order_id],[global_entity_id]: MIN(&#13;&#10;CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;LC&quot; THEN [basket_amount_lc]&#13;&#10;WHEN &quot;EUR&quot; THEN [basket_amount_eur]&#13;&#10;END) })' />
            </column>
            <column aggregation='Sum' datatype='integer' name='[Month - Year]' role='dimension' type='ordinal' user:agg-type='MY' user:base-field='first_ds_order_date' user:ui-builder='date-bin-builder'>
              <calculation class='tableau' formula='(DATEPART(&apos;year&apos;, [first_ds_order_date])*100 + DATEPART(&apos;month&apos;, [first_ds_order_date]))' />
            </column>
            <column datatype='string' name='[analytical_customer_id]' role='dimension' type='nominal' />
            <column datatype='real' name='[basket_amount_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[basket_amount_lc]' role='measure' type='quantitative' />
            <column caption='First Category' datatype='string' name='[category1]' role='dimension' type='nominal' />
            <column caption='Category Re-ordered' datatype='string' name='[category2]' role='dimension' type='nominal' />
