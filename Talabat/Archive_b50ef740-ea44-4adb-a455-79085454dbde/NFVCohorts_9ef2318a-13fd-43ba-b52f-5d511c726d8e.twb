          <named-connection caption='BigQuery' name='bigquery.1ypfg4409916i91gf6qem0vir3qz'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='eyad.elkhateeb@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.1ypfg4409916i91gf6qem0vir3qz' name='Custom SQL Query' type='text'><![CDATA[WITH ds AS

(
    SELECT * FROM(
SELECT
  l.global_entity_id,
  l.analytical_customer_id,
  DATE(l.date) AS first_ds_order_date,
  p.category_parent_english AS first_ds_category,
  p.category_english AS first_ds_subcategory,
  DENSE_RANK() OVER(PARTITION BY l.analytical_customer_id, l.global_entity_id ORDER BY date) AS first_order, 
  c.chain_name,
  v.vendor_name


FROM
  `tlb-data-prod.data_platform_dmart.fct_customer_order_lines` l
LEFT JOIN
  `tlb-data-prod.data_platform_dmart.dim_product` p
ON
  p.skus = l.sku 
  AND p.global_entity_id = l.global_entity_id
  AND p.vendor_id = l.vendor_id

LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v
  ON  CAST (v.vendor_id AS STRING) = l.vendor_id

LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c 
  ON   c.source_system_chain_id  = v.chain_id

WHERE 
l.is_sent 
AND vertical<<>>'food' 
AND (sub_vertical='marketplace' OR sub_vertical IS NULL)



ORDER BY analytical_customer_id, date(l.date)
    )

WHERE first_order = 1
)

SELECT 
l.global_entity_id,
warehouse_name,
l.analytical_customer_id,
l.order_id,
DATE(l.date) as date,
category_parent_english  as category2,
category_english as subcategory2,
ds.first_ds_order_date,
ds.first_ds_subcategory as subcategory1,
ds.first_ds_category as category1,
l.total_price_paid_eur,
l.total_price_paid_lc,
is_voucher,
c.chain_name,
c.vertical,
c.sub_vertical,
l.sku,
foi.basket_amount_lc,
foi.basket_amount_eur



FROM
  `tlb-data-prod.data_platform_dmart.fct_customer_order_lines` l

INNER JOIN ds ON ds.analytical_customer_id = l.analytical_customer_id AND ds.global_entity_id = l.global_entity_id
LEFT JOIN `tlb-data-prod.data_platform_dmart.dim_product` dp ON dp.global_product_id = l.global_product_id AND dp.global_entity_id = l.global_entity_id 
INNER JOIN `tlb-data-prod.data_platform_dmart.fct_customer_orders` co on co.order_id = l.order_id and co.global_entity_id = l.global_entity_id
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v
  ON  CAST (v.vendor_id AS STRING) = l.vendor_id

LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c 
  ON   c.source_system_chain_id  = v.chain_id


LEFT JOIN `tlb-data-prod.data_platform.fct_order_info` foi
ON CAST(foi.order_id AS STRING) = l.order_id

WHERE
l.is_sent
AND l.date>>=ds.first_ds_order_date
AND vertical<<>>'food' 
AND (sub_vertical='marketplace' OR sub_vertical IS NULL)]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.1ypfg4409916i91gf6qem0vir3qz' name='Custom SQL Query' type='text'><![CDATA[WITH ds AS

(
    SELECT * FROM(
SELECT
  l.global_entity_id,
  l.analytical_customer_id,
  DATE(l.date) AS first_ds_order_date,
  p.category_parent_english AS first_ds_category,
  p.category_english AS first_ds_subcategory,
  DENSE_RANK() OVER(PARTITION BY l.analytical_customer_id, l.global_entity_id ORDER BY date) AS first_order, 
  c.chain_name,
  v.vendor_name


FROM
  `tlb-data-prod.data_platform_dmart.fct_customer_order_lines` l
LEFT JOIN
  `tlb-data-prod.data_platform_dmart.dim_product` p
ON
  p.skus = l.sku 
  AND p.global_entity_id = l.global_entity_id
  AND p.vendor_id = l.vendor_id

LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v
  ON  CAST (v.vendor_id AS STRING) = l.vendor_id

LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c 
  ON   c.source_system_chain_id  = v.chain_id

WHERE 
l.is_sent 
AND vertical<<>>'food' 
AND (sub_vertical='marketplace' OR sub_vertical IS NULL)



ORDER BY analytical_customer_id, date(l.date)
    )

WHERE first_order = 1
)

SELECT 
l.global_entity_id,
warehouse_name,
l.analytical_customer_id,
l.order_id,
DATE(l.date) as date,
category_parent_english  as category2,
category_english as subcategory2,
ds.first_ds_order_date,
ds.first_ds_subcategory as subcategory1,
ds.first_ds_category as category1,
l.total_price_paid_eur,
l.total_price_paid_lc,
is_voucher,
c.chain_name,
c.vertical,
c.sub_vertical,
l.sku,
foi.basket_amount_lc,
foi.basket_amount_eur



FROM
  `tlb-data-prod.data_platform_dmart.fct_customer_order_lines` l

INNER JOIN ds ON ds.analytical_customer_id = l.analytical_customer_id AND ds.global_entity_id = l.global_entity_id
LEFT JOIN `tlb-data-prod.data_platform_dmart.dim_product` dp ON dp.global_product_id = l.global_product_id AND dp.global_entity_id = l.global_entity_id 
INNER JOIN `tlb-data-prod.data_platform_dmart.fct_customer_orders` co on co.order_id = l.order_id and co.global_entity_id = l.global_entity_id
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v
  ON  CAST (v.vendor_id AS STRING) = l.vendor_id

LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c 
  ON   c.source_system_chain_id  = v.chain_id


LEFT JOIN `tlb-data-prod.data_platform.fct_order_info` foi
ON CAST(foi.order_id AS STRING) = l.order_id

WHERE
l.is_sent
AND l.date>>=ds.first_ds_order_date
AND vertical<<>>'food' 
AND (sub_vertical='marketplace' OR sub_vertical IS NULL)]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
