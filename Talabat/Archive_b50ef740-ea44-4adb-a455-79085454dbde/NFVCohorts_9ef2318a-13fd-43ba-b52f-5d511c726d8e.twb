            <column caption='Sub Category Re-ordered' datatype='string' name='[subcategory2]' role='dimension' type='nominal' />
            <column-instance column='[first_ds_order_date]' derivation='Month-Trunc' name='[tmn:first_ds_order_date:ok]' pivot='key' type='ordinal' />
