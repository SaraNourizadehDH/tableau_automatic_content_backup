      <aliases enabled='yes' />
      <column caption='New / Repeat' datatype='string' name='[Calculation_1712564182652243968]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [customer_chain_rank] WHEN 1 THEN &quot;New&quot; ELSE &quot;Repeat&quot; END' />
      </column>
      <column caption='KPI' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4326833395084197891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN 1 THEN [Calculation_4326833395087368199]&#10;when 2 then [Calculation_4326833395087536136]&#10;when 3 then [Calculation_4326833395087634441]&#10;when 4 then [Calculation_4326833395087273990]&#10;when 5 then [Calculation_4326833395087163396]&#10;when 6 then [Calculation_4326833395087216645]&#10;when 7 then [Calculation_4326833395109421068]&#10;when 8 then [Calculation_4326833395109494797]&#10;END' />
      </column>
      <column caption='Total Customers' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_4326833395087163396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([analytical_customer_id])' />
      </column>
      <column caption='Total Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_4326833395087216645]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Spend per Customer' datatype='real' name='[Calculation_4326833395087273990]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4326833395107307531])/[Calculation_4326833395087163396]' />
      </column>
      <column caption='ABV' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_4326833395087368199]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([amt_basket_lc])/[Calculation_4326833395087216645]' />
      </column>
      <column caption='DF per Order' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_4326833395087536136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([delivery_fee_amount_lc])/[Calculation_4326833395087216645]' />
      </column>
      <column caption='Frequency' datatype='real' name='[Calculation_4326833395087634441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4326833395087216645]/[Calculation_4326833395087163396]' />
      </column>
      <column caption='amt_gfv_lc' datatype='real' name='[Calculation_4326833395107307531]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[gmv_amount_lc] - [delivery_fee_amount_lc]' />
      </column>
      <column caption='Total DF Revenue' datatype='real' name='[Calculation_4326833395109421068]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([delivery_fee_amount_lc])' />
      </column>
      <column caption='Total GFV' datatype='real' name='[Calculation_4326833395109494797]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_4326833395107307531])' />
      </column>
      <column caption='custom bins' datatype='integer' name='[Calculation_4326833395419447313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [amt_basket_lc] &gt;= 0 then INT([amt_basket_lc]/[Parameters].[Parameter 2])*[Parameters].[Parameter 2]&#10;else (INT([amt_basket_lc]/[Parameters].[Parameter 2])-1)*[Parameters].[Parameter 2]&#10;END' />
      </column>
      <column caption='Basket Size Buckets' datatype='string' name='[Calculation_4326833395421130771]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [upper limit] then STR([Parameters].[Parameter 3]) + &apos; - &apos; + STR({ FIXED : MAX([Calculation_4326833395419447313])})&#10;ELSE STR([Calculation_4326833395419447313]) END' />
      </column>
