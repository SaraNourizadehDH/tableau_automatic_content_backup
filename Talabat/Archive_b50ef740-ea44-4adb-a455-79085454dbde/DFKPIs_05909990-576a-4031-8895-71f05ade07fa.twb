        <objects>
          <object caption='Custom SQL Query' id='_7DE6F4AFEF984BB7B6E7F44C5C75494E'>
            <properties context=''>
              <relation connection='bigquery.1r71lf20ia4u8x1gqx7281s97by3' name='Custom SQL Query' type='text'>SELECT
    orders.country_iso  AS Country,
    orders.order_id  AS order_id,
    orders.order_time AS date,
    area_name AS area,
    orders.analytical_customer_id  AS analytical_customer_id,
    orders.customer_darsktore_order_index  AS customer_chain_rank,
    restaurants.name_en  AS restaurant_name,
    orders.basket_amount_lc  AS amt_basket_lc,
    delivery_fee_amount_lc,
    gmv_amount_lc
FROM `tlb-data-prod.data_platform.fct_order` AS orders
LEFT JOIN `tlb-data-prod.data_platform.dim_vendor`  AS restaurants ON orders.vendor_id =restaurants.vendor_id
LEFT JOIN `tlb-data-prod.data_platform.dim_location`  AS area ON area.location_id = orders.location_id


WHERE (orders.order_date ) &gt;&gt;=  &apos;2021-01-01&apos;
AND (restaurants.is_grocery_darkstore ) 
AND (is_successful)
and analytical_customer_id is not null</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
