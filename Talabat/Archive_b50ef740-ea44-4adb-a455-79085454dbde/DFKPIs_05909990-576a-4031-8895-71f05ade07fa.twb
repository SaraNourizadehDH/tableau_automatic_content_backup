            <column caption='New / Repeat' datatype='string' name='[Calculation_1712564182652243968]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [customer_chain_rank] WHEN 1 THEN &quot;New&quot; ELSE &quot;Repeat&quot; END' />
            </column>
