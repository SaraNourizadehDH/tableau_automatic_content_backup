          <datasource-dependencies datasource='federated.16tc7uc0v8d76r1aejhnb1n2n5s8'>
            <column caption='Basket Penetration (copy)' datatype='real' default-format='p0.00%' name='[Basket Penetration (copy)_1301962529874223104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1474647453170520064]/ sum({ FIXED [dh_fct_customer_orders_order_placed_at_date],[dim_vendor_country_iso]:[Calculation_1474647453170520064]})' />
            </column>
            <column caption='% of Total Sales Category' datatype='real' default-format='p0.00%' name='[Calculation_1301962529878470658]' role='measure' type='quantitative'>
