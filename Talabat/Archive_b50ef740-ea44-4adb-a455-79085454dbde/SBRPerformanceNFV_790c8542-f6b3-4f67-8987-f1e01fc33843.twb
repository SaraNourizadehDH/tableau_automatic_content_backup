            <column caption='OOS%' datatype='real' default-format='p0.00%' name='[Calculation_5245356604559331328]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [reason] IN (&apos;ITEM_UNAVAILABLE&apos;,&apos;MENU_ACCOUNT_SETTINGS&apos;) OR [qty_delivered] &lt; [qty_ordered] then [order_id] END)&#10;/&#10;COUNTD([order_id])' />
            </column>
            <column caption='Sales' datatype='real' name='[Calculation_5634284632868364288]' role='measure' type='quantitative'>
