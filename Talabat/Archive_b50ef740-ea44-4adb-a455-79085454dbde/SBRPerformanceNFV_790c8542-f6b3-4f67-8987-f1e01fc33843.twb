      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='co' id='_CB61B2424D11486EA71A28EEE153AFDF'>
            <properties context=''>
              <relation connection='bigquery.14644us1fa61iy1h094gi135fjnh' name='Custom SQL Query' type='text'><![CDATA[SELECT
    RIGHT(dh_fct_customer_order_lines.global_entity_id,2)  AS dim_vendor_country_iso,
    INITCAP(dim_grocery_product.brand_name)  AS dim_grocery_product_brand_name,
    category_english AS subcategory1,
    master_category_english AS subcategory2,
    category_parent_english AS category,
    master_category_names.level_three  AS master_category,
    (DATE(timestamp(dh_fct_customer_order_lines.date) )) AS dh_fct_customer_orders_order_placed_at_date,
    dh_fct_customer_order_lines.order_id,
    analytical_customer_id,
    dh_fct_customer_order_lines.total_price_paid_lc/(1 + dh_fct_customer_order_lines.product_vat_rate ) AS dh_fct_customer_order_lines_total_price_paid_lc_without_vat,
    dh_fct_customer_order_lines.total_price_paid_eur/(1+ dh_fct_customer_order_lines.product_vat_rate )AS dh_fct_customer_order_lines_total_price_paid_eur_without_vat,
    dh_fct_customer_order_lines.qty_sold ,
    dh_fct_customer_order_lines.qty_ordered,
    dh_fct_customer_order_lines.qty_delivered,
    dh_fct_customer_order_lines.total_price_paid_lc AS dh_fct_customer_order_lines_total_price_paid_lc_with_vat,
    dh_fct_customer_order_lines.total_price_paid_eur AS dh_fct_customer_order_lines_total_price_paid_eur_with_vat,
    vertical,
    vendor_name,
    is_sent,
    reason
      

FROM `tlb-data-prod.data_platform_dmart.fct_customer_order_lines`
     AS dh_fct_customer_order_lines

LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` 
     AS dim_vendor ON cast(dim_vendor.source_system_vendor_id AS string) = dh_fct_customer_order_lines.vendor_id

LEFT JOIN `tlb-data-prod.data_platform.dim_chain` c
  on c.source_system_chain_id = dim_vendor.chain_id

LEFT JOIN `tlb-data-prod.data_platform_dmart.dim_product`
     AS dim_grocery_product ON dh_fct_customer_order_lines.sku = dim_grocery_product.skus and dh_fct_customer_order_lines.vendor_id = dim_grocery_product.vendor_id
left join `tlb-data-prod.data_platform.fct_order_detail_fail` f
on cast(f.order_id as string) = dh_fct_customer_order_lines.order_id and date(dh_fct_customer_order_lines.date) = date(f.order_date)



WHERE (date BETWEEN <[Parameters].[Parameter 3]> AND <[Parameters].[Parameter 4]>)
and date >>= '2021-01-01'
and vertical<<>>'food' and (sub_vertical='marketplace' or sub_vertical is null)
and RIGHT(dh_fct_customer_order_lines.global_entity_id,2) <<>> 'SA']]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
