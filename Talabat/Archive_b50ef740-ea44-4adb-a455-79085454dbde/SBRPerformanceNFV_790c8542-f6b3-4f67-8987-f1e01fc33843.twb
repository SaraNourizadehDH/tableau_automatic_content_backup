            <column caption='Category' datatype='string' name='[Calculation_1301962529884901379]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Customer Facing&quot; THEN [category]&#10;WHEN &quot;Master&quot; THEN [master_category]&#10;END' />
            </column>
            <column caption='order_count' datatype='integer' name='[Calculation_1474647453170520064]' role='measure' type='quantitative'>
