              <calculation class='tableau' formula='&quot;Customer Facing&quot;' />
            </column>
            <column caption='VAT' datatype='string' name='[Currency (copy)_665547625179578368]' param-domain-type='list' role='measure' type='nominal' value='&quot;With&quot;'>
