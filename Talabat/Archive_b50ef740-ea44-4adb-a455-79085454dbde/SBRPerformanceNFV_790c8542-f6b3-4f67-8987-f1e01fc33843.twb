      <column caption='Basket Penetration (copy)' datatype='real' default-format='p0.00%' name='[Basket Penetration (copy)_1301962529874223104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1474647453170520064]/ sum({ FIXED [dh_fct_customer_orders_order_placed_at_date],[dim_vendor_country_iso]:[Calculation_1474647453170520064]})' />
      </column>
      <column caption='% of Total Sales Category' datatype='real' default-format='p0.00%' name='[Calculation_1301962529878470658]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5634284632868364288]/SUM([fixed sales (copy)_1301962529877495809])' />
      </column>
      <column caption='Category' datatype='string' name='[Calculation_1301962529884901379]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Customer Facing&quot; THEN [category]&#10;WHEN &quot;Master&quot; THEN [master_category]&#10;END' />
      </column>
      <column caption='order_count' datatype='integer' name='[Calculation_1474647453170520064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='OOS%' datatype='real' default-format='p0.00%' name='[Calculation_5245356604559331328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(if [reason] IN (&apos;ITEM_UNAVAILABLE&apos;,&apos;MENU_ACCOUNT_SETTINGS&apos;) OR [qty_delivered] &lt; [qty_ordered] then [order_id] END)&#10;/&#10;COUNTD([order_id])' />
      </column>
      <column caption='Sales' datatype='real' name='[Calculation_5634284632868364288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;EUR&quot; AND [Parameters].[Currency (copy)_665547625179578368] = &quot;With&quot; THEN SUM([dh_fct_customer_order_lines_total_price_paid_eur_with_vat])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;EUR&quot; AND [Parameters].[Currency (copy)_665547625179578368] = &quot;Without&quot; THEN SUM([dh_fct_customer_order_lines_total_price_paid_eur_without_vat])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;LC&quot; AND [Parameters].[Currency (copy)_665547625179578368] = &quot;With&quot; THEN SUM([dh_fct_customer_order_lines_total_price_paid_lc_with_vat])&#10;ELSEIF [Parameters].[Parameter 1] = &quot;LC&quot; AND [Parameters].[Currency (copy)_665547625179578368] = &quot;Without&quot; THEN SUM([dh_fct_customer_order_lines_total_price_paid_lc_without_vat])&#10;END' />
      </column>
      <column caption='Front Margin' datatype='real' default-format='p0.00%' name='[Calculation_5634284632898179075]' role='measure' type='quantitative'>
