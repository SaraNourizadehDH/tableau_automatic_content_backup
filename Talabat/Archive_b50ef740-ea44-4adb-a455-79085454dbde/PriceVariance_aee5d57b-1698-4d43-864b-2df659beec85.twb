            </map>
            <map to='#ffbe7d'>
              <bucket>&quot;Wheatfields Gourmet Grocer &amp; Cafe&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column caption='# of Unique Vendors' datatype='integer' name='[Parameter 1]' param-domain-type='any' role='measure' type='quantitative' value='1'>
          <calculation class='tableau' formula='1' />
        </column>
        <column caption='Week Start Date' datatype='date' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='#2022-05-01#'>
          <calculation class='tableau' formula='#2022-05-01#' />
        </column>
        <column caption='Week End Date' datatype='date' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2022-09-30#'>
          <calculation class='tableau' formula='#2022-09-30#' />
        </column>
        <column caption='Parameter Country' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;UAE&quot;'>
          <calculation class='tableau' formula='&quot;UAE&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_0AFCC57E0ECF48A5BCC21FA567C30E7F'>
            <properties context=''>
              <relation connection='bigquery.1y0lj3i0l3fbwu15c1jz41htkosv' name='Custom SQL Query' type='text'><![CDATA[Select
price_index_table.*,
product_metadata.product_name_english,
product_metadata.category_level_one,
product_metadata.category_level_two,
product_metadata.category_level_three,
product_metadata.brand_name,
vendor_info.name_en,
vendor_info.chain_name_en,
vendor_info2.name_en as cheapest_vendor_name_en,
area_name,
loc.country_name,
loc.city_name,
from
(
select
*
from `tlb-data-prod.data_platform.price_index`
where number_unique_vendors >> 1
and
max_number_of_orders >>= 10
and
week_start_date >>= '2022-06-01'
) as price_index_table
inner join
(
select
master_id,
vendor_id,
product_name_english,
master_category_names.level_one as category_level_one,
master_category_names.level_two as category_level_two,
master_category_names.level_three as category_level_three,
brand_name
from
`tlb-data-prod.data_platform_dmart.dim_product`
group by
master_id,
vendor_id,
product_name_english,
category_level_one,
category_level_two,
category_level_three,
brand_name
)
as product_metadata
on
price_index_table.master_id=product_metadata.master_id
and
price_index_table.vendor_id=product_metadata.vendor_id
inner join
`tlb-data-prod.data_platform.dim_vendor` as vendor_info
on
cast(vendor_info.vendor_id as string)=price_index_table.vendor_id
inner join
`tlb-data-prod.data_platform.dim_vendor` as vendor_info2
on
cast(vendor_info2.vendor_id as string)=price_index_table.cheapest_vendor_id
inner join
(
  select city_id, city_name, country_name, area_name
  FROM `tlb-data-prod.data_platform.dim_location_info`
  group by city_id, city_name, country_name, area_name
) as loc
on
price_index_table.city_id=loc.city_id


where number_unique_vendors >> <[Parameters].[Parameter 1]>
and (week_start_date BETWEEN <[Parameters].[Parameter 2]> and <[Parameters].[Parameter 3]>)
and country_name = <[Parameters].[Parameter 4]>]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
