          <named-connection caption='BigQuery' name='bigquery.1y0lj3i0l3fbwu15c1jz41htkosv'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform_dmart' server-oauth='' username='mustafa.hussain@talabat.com' workgroup-auth-mode='prompt' />
