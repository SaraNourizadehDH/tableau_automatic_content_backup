COALESCE(SUM(CASE WHEN (salesforce_tickets.channel LIKE &apos;Chat&apos; OR salesforce_tickets.channel LIKE &apos;Email&apos;) THEN salesforce_tickets.incoming_chats else null end ),0) AS customer_service_incoming_cases



FROM `tlb-data-prod.data_platform.fct_order_info` as o

left outer join data_platform.fct_order_rank r on o.order_id = r.order_id and r.order_date = o.order_date

left join `tlb-data-prod.data_platform.fct_logistics_order` l
