        </aliases>
      </column>
      <column caption='First Order Rank' datatype='integer' name='[Calculation_106960520505827330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [analytical_customer_id]: &#10;MIN(IF [Calculation_6454361982773096457] = [date]&#10;THEN [customer_order_rank] END)}' />
      </column>
      <column caption='rider_count' datatype='integer' name='[Calculation_567735062321467392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count([rider_id])' />
      </column>
      <column caption='90th Percentile' datatype='real' name='[Calculation_567735062331068419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='PERCENTILE([delivery_time],.9)' />
      </column>
      <column caption='Order Count' datatype='integer' name='[Calculation_6454361982562672640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Split Order' datatype='string' name='[Calculation_6454361982562758657]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [deliveries_count] &gt; 1 THEN &apos;True&apos;&#10;ELSE &apos;False&apos;&#10;END' />
      </column>
      <column caption='Failed Orders' datatype='integer' name='[Calculation_6454361982565453826]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD(CASE [is_failed]&#10;WHEN True THEN [order_id] ELSE NULL END)' />
      </column>
      <column caption='NFR' datatype='real' default-format='p0.00%' name='[Calculation_6454361982566080515]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6454361982565453826]/[Calculation_6454361982562672640]' />
      </column>
      <column caption='Customer Count' datatype='integer' name='[Calculation_6454361982568988679]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([analytical_customer_id])' />
      </column>
      <column caption='first order' datatype='date' name='[Calculation_6454361982773096457]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [analytical_customer_id]:MIN([date])}' />
      </column>
      <column caption='Weeks to Repeat' datatype='integer' name='[Calculation_6454361982773907467]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;week&apos;,[Calculation_6454361982773096457],[date])' />
      </column>
      <column caption='Split Rate' datatype='real' default-format='p0.00%' name='[Failed Orders (copy)_6454361982566887429]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD(CASE [Calculation_6454361982562758657]&#10;WHEN &apos;True&apos; THEN [order_id] ELSE NULL END)&#10;/&#10;[Calculation_6454361982562672640]' />
      </column>
      <column caption='Contacted' datatype='string' name='[Split Order (copy)_4608589830430568450]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [customer_service_incoming_cases] &gt; 0 THEN &apos;True&apos;&#10;ELSE &apos;False&apos;&#10;END' />
      </column>
      <column caption='Contact Orders' datatype='integer' name='[Split Orders (copy)_4608589830432927748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(CASE [Split Order (copy)_4608589830430568450]&#10;WHEN &apos;True&apos; THEN [order_id] ELSE NULL END)' />
      </column>
      <column caption='Contact Rate' datatype='real' default-format='p0.00%' name='[Split Rate (copy)_4608589830430879747]' role='measure' type='quantitative'>
