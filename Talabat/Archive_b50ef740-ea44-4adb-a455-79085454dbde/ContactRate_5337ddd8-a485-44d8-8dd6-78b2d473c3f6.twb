      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_40BC7C322DAF4036885E9CBDC8A65B45'>
            <properties context=''>
              <relation connection='bigquery.175fvif05u5xle11st5za1qcv1kb' name='Custom SQL Query' type='text'>SELECT
date(date) AS date,
country_code,
order_id,
analytical_customer_id,
sku,
product_name,
category_english,
category_parent_english,
master_category_english,
master_category_names.level_one


from 
`tlb-data-prod.data_platform_dmart.fct_customer_order_lines` as lines

LEFT JOIN `tlb-data-prod.data_platform_dmart.dim_product` AS dp
ON dp.global_product_id = lines.global_product_id
AND dp.global_entity_id = lines.global_entity_id


WHERE order_id IN
(SELECT 
 cast(orders.order_id as string) as order_id


FROM `tlb-data-prod.data_platform.fct_order_info` As orders



LEFT JOIN `tlb-data-prod.data_platform.fct_logistics_order` AS logistics_orders ON orders.order_id = logistics_orders.order_id 


where 1=1 
and is_darkstore 
and order_date &gt;&gt;= &apos;2021-07-01&apos; 
and deliveries_count &gt;&gt; 1

group by 1)</relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
