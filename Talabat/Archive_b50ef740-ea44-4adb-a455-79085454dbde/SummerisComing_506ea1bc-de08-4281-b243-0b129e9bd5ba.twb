               WHEN channel in ('Facebook', 'Twitter', 'Instagram') THEN 'Social Media'
               WHEN channel in ('Helpcenter', 'Web') THEN 'Form'
               ELSE 'Other' END             AS channel,
           stakeholder,
           contact_reason_l1    as ccr1,
           contact_reason_l2    as ccr2,
           contact_reason_l3    as ccr3,
           incoming_case_ind                    AS incoming_chats,
