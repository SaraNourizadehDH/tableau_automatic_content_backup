      <column caption='Category' datatype='string' name='[category_parent_english]' role='dimension' type='nominal' />
      <column caption='Contact Reason I3' datatype='string' name='[contact_reason_l3]' role='dimension' type='nominal' />
      <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
      <column caption='Delivery Time mins' datatype='real' name='[delivery_time_minutes]' role='measure' type='quantitative' />
      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
          <calculation class='tableau' formula='&quot;EUR&quot;' />
        </column>
        <column caption='Start Date' datatype='date' name='[Parameter 2]' param-domain-type='any' role='measure' type='quantitative' value='#2021-01-01#'>
          <calculation class='tableau' formula='#2021-01-01#' />
        </column>
        <column caption='End Date' datatype='date' name='[Parameter 3]' param-domain-type='any' role='measure' type='quantitative' value='#2022-04-08#'>
          <calculation class='tableau' formula='#2022-04-08#' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_A5BF7F19879D49A28B21CC1C787116B8'>
            <properties context=''>
              <relation connection='bigquery.0yb5bja1nevv84192mu5o0kpae88' name='Custom SQL Query' type='text'><![CDATA[WITH salesforce_tickets AS (select 
           right(global_entity_id,2) as country_iso,
           
           order_id                         AS order_id,
           CASE
               WHEN channel in ('Chat') then 'Chat'
               WHEN channel in ('Email') or channel is null THEN 'Email'
               WHEN channel in ('Facebook', 'Twitter', 'Instagram') THEN 'Social Media'
               WHEN channel in ('Helpcenter', 'Web') THEN 'Form'
               ELSE 'Other' END             AS channel,
           stakeholder,
           contact_reason_l1    as ccr1,
           contact_reason_l2    as ccr2,
           contact_reason_l3    as ccr3,
           incoming_case_ind                    AS incoming_chats,
           case_id
    from `bta---talabat.data_platform_gcc.salesforce_cases` sf
             
)




SELECT
DATE(o.date) as date,
right(o.global_entity_id,2) as country,
o.order_id,
o.analytical_customer_id,
vendor_name,
category_parent_english,
product_name,
sku,
CASE WHEN (salesforce_tickets.channel LIKE 'Chat' OR salesforce_tickets.channel LIKE 'Email') THEN 'Yes' else 'No' end AS contacted,
contact_reason_l3,
compensation_type,
compensation_amount_lc,
compensation_amount_eur,
is_grocery_darkstore,
is_grocery_marketplace,
delivery_time_minutes,
delivery_time_promised_minutes,
log.rider_late,
case when log.deliveries_count >> 1 then 'Split' else 'Unsplit' end as split_order,
CASE WHEN stacked_deliveries >> 0 THEN 'Stacked' else 'Unstacked' END AS is_stacked,
cast(nps_score as int) NPS



FROM `bta---talabat.data_platform_dmart.fct_customer_order_lines` o

inner join `bta---talabat.data_platform_dmart.customer_orders` co
on co.order_id = o.order_id and co.global_entity_id = o.global_entity_id

left join `bta---talabat.data_platform_redshift.fct_compensation` comp
on cast(comp.order_id as string) = cast(o.order_id as string)

left join `bta---talabat.data_platform.fct_logistics_order` as log
 on cast(o.order_id as string) = cast(log.order_id as string)

left join `bta---talabat.data_platform.dim_vendor_info` v
on cast(v.source_system_vendor_id as string) = cast(o.vendor_id as string)

left join `bta---talabat.data_platform_dmart.dim_product` p
on p.skus = o.sku and p.global_entity_id = o.global_entity_id and p.vendor_id = o.vendor_id

left join salesforce_tickets on
cast(o.order_id as string) = salesforce_tickets.order_id and salesforce_tickets.country_iso = right(o.global_entity_id,2)

left join `bta---talabat.data_platform_redshift_logistics.fct_hurrier_order` hur
on o.order_id = hur.order_id

left join `fulfillment-dwh-production.curated_data_shared_cx.nps_after_order_all_survey_responses` nps
on nps.order_id = o.order_id

left join (
select 
        order_id,
        contact_reason_l3
        FROM `bta---talabat.data_platform_gcc.salesforce_cases` as sf
        where right(global_entity_id,2) <<>> 'SA'
) m
on m.order_id = cast(o.order_id as string)

where (is_grocery_darkstore OR is_grocery_marketplace)
and o.is_sent
AND (o.date BETWEEN <[Parameters].[Parameter 2]> AND <[Parameters].[Parameter 3]>)]]></relation>
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='NFV Category'>
      <layout-options>
