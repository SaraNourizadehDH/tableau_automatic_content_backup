    <worksheet name='NFV Exclusive Category'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform_dmart)' name='federated.1r5qn0d1xz73cc1dyhwr00umj4rx' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;EUR&quot;'>
              <calculation class='tableau' formula='&quot;EUR&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1r5qn0d1xz73cc1dyhwr00umj4rx'>
            <column caption='Orders' datatype='integer' name='[Calculation_5950732872605753344]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([order_id])' />
            </column>
            <column caption='Contact Rate' datatype='real' default-format='p0.0%' name='[Calculation_5950732872611184641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [contacted] = &apos;Yes&apos; then [order_id] end)&#10;/ [Calculation_5950732872605753344]' />
            </column>
            <column caption='Refund Rate' datatype='real' default-format='p0.0%' name='[Calculation_5950732872612171778]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(&#10;CASE [compensation_type] &#10;WHEN &apos;Order Refund&apos; then [order_id]&#10;WHEN &apos;Partial Refund&apos; then [order_id]&#10; end)&#10;/&#10;[Calculation_5950732872605753344]' />
            </column>
            <column caption='Refund Amount' datatype='real' name='[Calculation_5950732872616239108]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [compensation_type] &#10;WHEN &apos;Order Refund&apos; then [Calculation_5950732872673067019]&#10;WHEN &apos;Partial Refund&apos; then [Calculation_5950732872673067019]&#10; end' />
            </column>
            <column caption='Split Rate' datatype='real' default-format='p0.0%' name='[Calculation_5950732872620056583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(case [split_order] when &apos;Split&apos; then [order_id] end)&#10;/[Calculation_5950732872605753344]' />
            </column>
            <column caption='% Delay &gt; 10 mins' datatype='real' default-format='p0.0%' name='[Calculation_5950732872627261449]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( if [rider_late] / 60 &gt; 10 then [order_id] end)&#10;/[Calculation_5950732872605753344]' />
            </column>
            <column caption='Compensation' datatype='real' name='[Calculation_5950732872673067019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#10;WHEN &apos;LC&apos; then [compensation_amount_lc]&#10;when &apos;EUR&apos; then [compensation_amount_eur]&#10;end' />
            </column>
            <column caption='Customers' datatype='integer' name='[Calculation_5950732872678379533]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([analytical_customer_id])' />
            </column>
            <column caption='Only Frozen' datatype='boolean' name='[Calculation_5950732872688607249]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[category_parent_english (group)]=&quot;Frozen&quot; AND {FIXED [order_id]:COUNTD([category_parent_english (group)])}=1' />
            </column>
            <column caption='Category Group 2' datatype='string' name='[Calculation_5950732872689700884]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_5950732872688607249] = TRUE then &apos;Exclusively Frozen&apos; &#10;ELSEIF [Only Frozen (copy)_5950732872689373202] = TRUE then &apos;Exclusively Not Frozen&apos;&#10;ELSEIF [Only Not Frozen (copy)_5950732872689545235] = TRUE then &apos;Frozen &amp; Not Frozen&apos; &#10;end' />
            </column>
            <column caption='Compensation Rate' datatype='real' default-format='p0.0%' name='[Compensation Amount (copy)_5950732872674512908]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(&#10;CASE [compensation_type] &#10;WHEN &apos;Order Related&apos; then [order_id]&#10;WHEN &apos;Non Order Related&apos; then [order_id]&#10;WHEN &apos;null&apos; then [order_id]&#10; end)&#10;/&#10;[Calculation_5950732872605753344]' />
            </column>
            <column datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[NPS]' role='measure' type='quantitative' />
            <column caption='Only Not Frozen' datatype='boolean' name='[Only Frozen (copy)_5950732872689373202]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[category_parent_english (group)]=&quot;Not Frozen&quot; AND {FIXED [order_id]:COUNTD([category_parent_english (group)])}=1' />
            </column>
            <column caption='Frozen + Not Frozen' datatype='boolean' name='[Only Not Frozen (copy)_5950732872689545235]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='([category_parent_english (group)]=&quot;Not Frozen&quot; OR [category_parent_english (group)]=&quot;Frozen&quot;)&#10;&#10;AND {FIXED [order_id]:COUNTD([category_parent_english (group)])}=2' />
            </column>
            <column caption='Compensation Amount' datatype='real' name='[Refund Amount (copy)_5950732872617299973]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [compensation_type] &#10;WHEN &apos;Order Related&apos; then [Calculation_5950732872673067019]&#10;WHEN &apos;Non Order Related&apos; then [Calculation_5950732872673067019]&#10;WHEN &apos;null&apos; then [Calculation_5950732872673067019]&#10;end' />
            </column>
            <column caption='Stack Rate' datatype='real' default-format='p0.0%' name='[Split Rate (copy)_5950732872626561032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='countd(case [is_stacked] when &apos;Stacked&apos; then [order_id] end)&#10;/[Calculation_5950732872605753344]' />
            </column>
            <column datatype='string' name='[analytical_customer_id]' role='dimension' type='nominal' />
            <column-instance column='[NPS]' derivation='Avg' name='[avg:NPS:qk]' pivot='key' type='quantitative' />
            <column-instance column='[delivery_time_minutes]' derivation='Avg' name='[avg:delivery_time_minutes:qk]' pivot='key' type='quantitative' />
            <column caption='Category Group' datatype='string' name='[category_parent_english (group)]' role='dimension' type='nominal'>
