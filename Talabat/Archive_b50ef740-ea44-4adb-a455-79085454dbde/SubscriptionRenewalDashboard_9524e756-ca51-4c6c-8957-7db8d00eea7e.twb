        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.00372k61oy68at1g9zami0ebssm1' name='Custom SQL Query' type='text'>SELECT *, &#13;
(CASE &#13;
WHEN product__c=&quot;Monthly Subscription Fee&quot; THEN  &quot;Monthly Subscription Fee&quot;&#13;
WHEN product__c=&quot;Monthly subscription fees&quot; THEN  &quot;Monthly Subscription Fee&quot;&#13;
WHEN product__c=&quot;Renewal Fees&quot; THEN  &quot;Renewal Fee&quot;&#13;
WHEN product__c=&quot;Renewal Fee&quot; THEN  &quot;Renewal Fee&quot; END) as Product&#13;
&#13;
&#13;
FROM (SELECT&#13;
DISTINCT v.vendor_id,&#13;
v.vendor_name,&#13;
v.chain_id,&#13;
cc.chain_name,&#13;
v.salesforce_id,&#13;
cc.country_code,&#13;
product__c,&#13;
status__c,&#13;
total_amount__c,&#13;
listed_price__c,&#13;
start_date__c,&#13;
closedate,&#13;
FROM `tlb-data-prod.data_platform.dim_vendor_info` v&#13;
LEFT JOIN `tlb-data-prod.data_platform.dim_chain` cc&#13;
on cc.chain_id = v.chain_id&#13;
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a&#13;
ON v.salesforce_id = a.grid__c&#13;
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce..contract` c&#13;
ON a.id = c.accountid&#13;
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o&#13;
ON  a.id =o.accountid&#13;
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.additional_charges__c`  ad&#13;
ON  a.id = ad.id_account__c&#13;
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.user` u&#13;
ON o.ownerid = u.id&#13;
WHERE&#13;
product__c IN (&apos;Renewal Fees&apos;,&apos;Monthly Subscription Fee&apos;,&apos;Renewal Fee&apos;,&apos;Monthly subscription fees&apos;)&#13;
AND o.business_type__c IN (&apos;New Business&apos;, &apos;Franchise Extension&apos;, &apos;Win Back&apos;)&#13;
AND o.stagename = &apos;Closed Won&apos;&#13;
AND status__c NOT IN (&apos;Terminated&apos;)&#13;
and a.account_status__c = &apos;Active&apos;&#13;
AND cc.country_code NOT IN (&apos;QA&apos;,&apos;SA&apos;)&#13;
&#13;
AND v.is_non_food = false)</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.00372k61oy68at1g9zami0ebssm1' name='Custom SQL Query' type='text'>SELECT *, &#13;
