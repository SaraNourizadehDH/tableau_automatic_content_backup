and a.account_status__c = &apos;Active&apos;&#13;
AND cc.country_code NOT IN (&apos;QA&apos;,&apos;SA&apos;)&#13;
&#13;
AND v.is_non_food = false)</_.fcp.ObjectModelEncapsulateLegacy.true...relation>
