        <calculation class='tableau' formula='IF  [Calculation_1050464644501860358] = &quot;Monthly Subscription Fee&quot; &#13;&#10;THEN [Calculation_1050464644503539721] ELSE [Calculation_1050464644504023050]&#13;&#10;END' />
