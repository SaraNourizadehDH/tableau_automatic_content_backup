    <dashboard name='Product Performance (City) &amp; Brand Penetration'>
      <repository-location derived-from='https://tableau.deliveryhero.net/t/Talabat/workbooks/PartnerPerformanceMonthly/ProductPerformanceCityBrandPenetration?rev=' id='ProductPerformanceCityBrandPenetration' path='/t/Talabat/workbooks/CategoryShareGrowthAllMonths' revision='' site='Talabat' />
      <style />
      <size maxheight='900' maxwidth='1500' minheight='900' minwidth='1500' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
        <datasource caption='BQ co' name='federated.1t1o8k81a3nr9g18d92ac0n0b6o4' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Currency' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;LC&quot;'>
          <calculation class='tableau' formula='&quot;LC&quot;' />
          <members>
            <member value='&quot;LC&quot;' />
            <member value='&quot;EUR&quot;' />
          </members>
        </column>
        <column caption='Category Type' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Customer Facing&quot;'>
          <calculation class='tableau' formula='&quot;Customer Facing&quot;' />
          <members>
            <member value='&quot;Customer Facing&quot;' />
            <member value='&quot;Master&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.1t1o8k81a3nr9g18d92ac0n0b6o4'>
        <column caption='Category' datatype='string' name='[Calculation_4487274131081277442]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Customer Facing&quot; THEN [category1]&#10;WHEN &quot;Master&quot; THEN [category2]&#10;END' />
        </column>
        <column caption='Subcategory' datatype='string' name='[Calculation_4487274131081474051]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &quot;Customer Facing&quot; THEN [subcategory1]&#10;WHEN &quot;Master&quot; THEN [subcategory2]&#10;END' />
        </column>
        <column caption='Month' datatype='datetime' name='[Calculation_5577285953343508480]' role='dimension' type='ordinal'>
          <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [date])' />
        </column>
        <column caption='Brand Name' datatype='string' name='[brand_name]' role='dimension' type='nominal' />
        <column datatype='string' name='[city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
        <column caption='Country' datatype='string' name='[country_iso]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
