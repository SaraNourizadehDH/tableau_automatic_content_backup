            </column>
            <column caption='CPO Flag' datatype='string' name='[Calculation_1899815377248792576]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='If&#10;[country_iso] = &apos;AE&apos; AND [delivery_fee_amount_lc] &lt; 2 THEN &quot;Free Delivery&quot; &#10;ELSEIF [country_iso] = &apos;AE&apos; AND [delivery_fee_amount_lc] &gt;= 2 AND [delivery_fee_amount_lc] &lt;= 3.5 THEN &quot;CPO&quot; &#10;ELSEIF [country_iso] = &apos;AE&apos; AND [delivery_fee_amount_lc] &gt; 3.5 THEN &quot;Non CPO&quot; &#10;ELSEIF [country_iso] = &apos;KW&apos; AND [delivery_fee_amount_lc] &lt; 0.2 THEN &quot;Free Delivery&quot; &#10;ELSEIF [country_iso] = &apos;KW&apos; AND [delivery_fee_amount_lc] &gt;= 0.2 AND [delivery_fee_amount_lc] &lt;= 0.4 THEN &quot;CPO&quot; &#10;ELSEIF [country_iso] = &apos;KW&apos; AND [delivery_fee_amount_lc] &gt; 0.4 THEN &quot;Non CPO&quot; &#10;END' />
            </column>
            <column caption='Kitchens' datatype='boolean' name='[Calculation_2055541413230891008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CONTAINS(LOWER([vendor_name]),&quot;dh kitchen&quot;)' />
            </column>
            <column caption='Total GMV LC' datatype='real' name='[Calculation_5262596925217218561]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([gmv_amount_lc])' />
            </column>
            <column caption='AOV' datatype='real' name='[Calculation_5262596925217484804]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5262596925217218561]/[Calculation_6001468737335107599]' />
            </column>
            <column caption='Total Delivery Fees' datatype='real' name='[Calculation_5262596925222404105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([delivery_fee_amount_lc])' />
            </column>
            <column caption='ADF' datatype='real' name='[Calculation_5262596925222518794]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5262596925222404105]/[Calculation_6001468737335107599]' />
            </column>
            <column caption='New Vs Old Customer' datatype='string' name='[Calculation_6001468737318354951]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [customer_vendor_order_index] = 1 then &apos;New Customer&apos;&#10;ELSEIF [customer_vendor_order_index] &gt;1 THEN &apos;Old Customer&apos; &#10;ELSEIF  ISNULL([customer_vendor_order_index]) THEN &apos;Not Definied&apos; END' />
            </column>
            <column caption='CPC or Non CPC' datatype='string' name='[Calculation_6001468737327255564]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [billing_type] = &apos;CPC&apos; then [billing_type]&#10;ELSE &apos;Other&apos; END' />
            </column>
            <column caption='Free Delivery' datatype='string' name='[Calculation_6001468737329647629]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [country_iso] = &apos;AE&apos; AND [delivery_fee_amount_lc] &lt;2 then &apos;Free Delivery&apos;&#10;ELSEIF [country_iso] = &apos;KW&apos; AND [delivery_fee_amount_lc] =0 then &apos;Free Delivery&apos;&#10;ELSE &apos;Paid Delivery&apos; END' />
            </column>
            <column caption='Order Count' datatype='integer' name='[Calculation_6001468737335107599]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([order_id])' />
            </column>
            <column caption='Order Status' datatype='string' name='[Calculation_6001468737349890064]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [is_successful] then &apos;Successful&apos;&#10;ELSE &apos;Failed&apos; END' />
            </column>
            <column caption='Successful Orders' datatype='integer' name='[Calculation_6001468737363337233]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [is_successful] then [order_id] END)' />
            </column>
