    <worksheet name='Vendor Avalability - Workbook'>
      <repository-location id='Vendor' path='/t/Talabat/workbooks/Latest-Item86' revision='' site='Talabat' />
      <table>
        <view>
          <datasources>
            <datasource caption='Vendor Availability' name='federated.161u03d1wco2yp12aog5m0s572yh' />
          </datasources>
          <datasource-dependencies datasource='federated.161u03d1wco2yp12aog5m0s572yh'>
            <column caption='Duration Mins' datatype='integer' name='[Calculation_1376553390149619712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IFNULL(DATEDIFF(&apos;minute&apos;,[requested_at],[request_ended_at]),0)' />
            </column>
            <column caption='Current Status' datatype='string' name='[Calculation_2511741975383613448]' role='dimension' type='nominal'>
