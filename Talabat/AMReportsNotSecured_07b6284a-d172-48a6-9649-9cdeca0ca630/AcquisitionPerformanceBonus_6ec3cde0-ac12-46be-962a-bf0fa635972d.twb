          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.18yjm090w2erea13jqkli0j9qfey'>
            <column caption='Include in productivity ' datatype='string' name='[Calculation_6414392512305717248]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sales_rep_validation] = 1 THEN &quot;True&quot; else &quot;False&quot; end' />
            </column>
            <column caption='# Sales Executives' datatype='integer' name='[Calculation_717690866559967235]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if  [Calculation_6414392512305717248] = &quot;False&quot; THEN [owner_name]&#10;else [rep_name] end )' />
            </column>
            <column caption='A + B Acquisition' datatype='integer' name='[Calculation_717690866900668432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( case [vendor_grade] when &apos;A&apos; then [vendor_id]&#10;when &apos;B&apos; then [vendor_id]&#10;else null&#10;end)' />
            </column>
            <column caption='A + B Productivity' datatype='real' name='[Calculation_717690866901094418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_717690866900668432]/[Calculation_717690866559967235]' />
            </column>
            <column datatype='date' name='[close_date]' role='dimension' type='ordinal' />
