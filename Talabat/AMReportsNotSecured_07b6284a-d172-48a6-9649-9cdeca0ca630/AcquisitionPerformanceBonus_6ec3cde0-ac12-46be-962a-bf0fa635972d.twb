      </column>
      <column caption='Backlog leads  All Time  ' datatype='integer' name='[Backlog All Time  (copy)_1465147634163417090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [tag] = &quot;leads&quot;&#10;        and [status] in (&quot;Contacted&quot;,&quot;Long-term follow-up&quot;,&quot;New&quot;,&quot;Open&quot;)&#10;        AND DATETRUNC(&apos;month&apos;, [Calculation_6414392512427786243]) &lt; DATETRUNC(&apos;month&apos;, TODAY())&#10;    THEN [id]&#10;    END&#10;)' />
      </column>
      <column caption='Backlog accounts  All Time   ' datatype='integer' name='[Backlog leads  All Time   (copy)_1465147634164641795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [tag] = &quot;accounts&quot;&#10;        and [Open leads status (copy)_1131810937066827777] = &quot;Open accounts&quot;&#10;        AND DATETRUNC(&apos;month&apos;, [Calculation_6414392512428232708]) &lt; DATETRUNC(&apos;month&apos;, TODAY())&#10;    THEN [id]&#10;    END&#10;)' />
      </column>
      <column caption='C Live vendors   (copy)' datatype='string' name='[C Live vendors   (copy)_3136968291837575172]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if tag = &quot;Live&quot; and lower([vendor_grade__c]) in (&quot;c&quot;)  and IFNULL([Calculation_1131810937084305415],date(&quot;1999-09-01&quot;)) &lt;&gt; date(&quot;1999-09-01&quot;) then [id] else  null end' />
      </column>
      <column caption='C Live vendors' datatype='integer' name='[C Vendors taken live  (copy)_3136968291837624325]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([C Live vendors   (copy)_3136968291837575172])' />
      </column>
      <column caption='Team' datatype='string' name='[Calculation_101401414238867471]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [title] in &#10;(&apos;Sales Executive&apos;,&apos;Sales Exeuctive&apos;,&#10;&apos;Sr. Sales Executive&apos;,&apos;Sr. Sales executive&apos;,&#10;&apos;Coordinator Riders&apos;,&apos;Sales Acquisition - IC1&apos;,&#10;&apos;Team Lead Acquisition&apos;,&apos;Manager Acquisition&apos;,&apos;Head Of Acquisitions &amp; Partnerships&apos;,&apos;Lead Generator&apos;,&#10;&apos;Lead Generator Support&apos;,&apos;Intern - Sales&apos;) then&#10;&apos;Field Sales&apos;&#10;ELSEIF  lower([opportunity_owner_name]) = &quot;talabat lead research team&quot; then  &apos;Field Sales&apos;&#10;ELSEIF  [title] in (&apos;Inside Sales Executive&apos;,&apos;Executive Inside Sales&apos;,&#10;&apos;Manager Content&apos;,&#10;&apos;Account Advisor - Content&apos;,&#10;&apos;Account Advisor - Restaurants’ Operations&apos;,&#10;&apos;Supervisor Operations&apos;&#10;)  then &apos;Tele Sales&apos;&#10;//elseif  (tag = &quot;leads&quot; and [lead_createdby_name] in ( &quot;Talabat SSU Site Guest User&quot;,&quot;SSU Vendor API user&quot;)) then &apos;Tele Sales&apos;&#10;&#10;elseif ([title])   in (&apos;Account Manager&apos;,&#10;&apos;Sr. Key Account Manager&apos;,&#10;&apos;Key Account Manager&apos;,&#10;&apos;Team Lead Account Management&apos;,&#10;&apos;Online Account Manager&apos;,&#10;&apos;Sr. Account Manager&apos;,&#10;&apos;Online Account Manager II&apos;,&#10;&apos;Team lead Online Account Management&apos;,&#10;&apos;Phone Account Manager&apos;,&#10;&apos;Coordinator Sales - Account Management&apos;)&#10;then &apos;Account Managers&apos;&#10;else &quot;Others&quot;&#10;end' />
      </column>
      <column caption='Conversion Test ' datatype='real' name='[Calculation_1066438339829293057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Open accounts status  (copy)_1131810937083924486])/[Calculation_1066438339832913922]' />
      </column>
      <column caption='All leads + Accounts + live + Lost' datatype='integer' name='[Calculation_1066438339832913922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total (copy)_1532772054134624256]+COUNTD([Open accounts status  (copy)_1131810937083924486])+ COUNTD([Calculation_4727794454702657557])' />
      </column>
      <column aggregation='Sum' caption='Days in the stage' datatype='integer' name='[Calculation_1083397195490721792]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[opp_hist_date],TODAY())' />
      </column>
      <column caption='ph' datatype='integer' name='[Calculation_1083397195621146625]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Open leads status' datatype='string' name='[Calculation_1131810937066078208]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if tag = &quot;leads&quot; and LOWER([status]) in (&quot;contacted&quot;,&quot;long-term follow-up&quot;,&quot;new&quot;,&quot;open&quot;)  then &quot;Open leads&quot; else null end' />
      </column>
      <column caption='Open leads' datatype='string' name='[Calculation_1131810937068638210]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_1131810937066078208] = &quot;Open leads&quot; then [id] else null end' />
      </column>
      <column caption='Live date' datatype='date' name='[Calculation_1131810937084305415]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [tag] = &quot;Live&quot; then [date] else null end' />
      </column>
      <column caption='total' datatype='integer' name='[Calculation_1131810937105043464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_1131810937068638210])+COUNTD([Open leads (copy)_1131810937070358532])+COUNTD([Open accounts status  (copy)_1131810937083924486])' />
      </column>
      <column caption='Has Open lead or accounts?' datatype='boolean' name='[Calculation_1131810937105211401]' role='measure' type='nominal'>
        <calculation class='tableau' formula='([total (copy)_1532772054134624256]) &gt; 0' />
      </column>
      <column caption='Account age' datatype='integer' name='[Calculation_129197082318671873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Calculation_6414392512428232708],TODAY())' />
