count(distinct m.salesforce_id) as vendors,
sum(meetings) as meetings
from  
 t2 left join meetings m on m.month = t2.months and lower(trim(t2.owner_name)) =  lower(trim(m.owner_name)) 
 and t2.months >>= "2023-01-01"
 where m.month is not null 
 group by 1,2,3,4,5,6,7]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
