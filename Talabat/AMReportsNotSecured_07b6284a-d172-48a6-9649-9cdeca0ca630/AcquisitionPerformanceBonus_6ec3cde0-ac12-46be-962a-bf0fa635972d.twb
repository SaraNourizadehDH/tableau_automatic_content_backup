          <datasources>
            <datasource caption='Funnel tracker' name='federated.1iz4blh190en3218f0zuw0pr6946' />
          </datasources>
          <datasource-dependencies datasource='federated.1iz4blh190en3218f0zuw0pr6946'>
            <column caption='Team' datatype='string' name='[Calculation_101401414238867471]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [title] in &#10;(&apos;Sales Executive&apos;,&apos;Sales Exeuctive&apos;,&#10;&apos;Sr. Sales Executive&apos;,&apos;Sr. Sales executive&apos;,&#10;&apos;Coordinator Riders&apos;,&apos;Sales Acquisition - IC1&apos;,&#10;&apos;Team Lead Acquisition&apos;,&apos;Manager Acquisition&apos;,&apos;Head Of Acquisitions &amp; Partnerships&apos;,&apos;Lead Generator&apos;,&#10;&apos;Lead Generator Support&apos;,&apos;Intern - Sales&apos;) then&#10;&apos;Field Sales&apos;&#10;ELSEIF  lower([opportunity_owner_name]) = &quot;talabat lead research team&quot; then  &apos;Field Sales&apos;&#10;ELSEIF  [title] in (&apos;Inside Sales Executive&apos;,&apos;Executive Inside Sales&apos;,&#10;&apos;Manager Content&apos;,&#10;&apos;Account Advisor - Content&apos;,&#10;&apos;Account Advisor - Restaurants’ Operations&apos;,&#10;&apos;Supervisor Operations&apos;&#10;)  then &apos;Tele Sales&apos;&#10;//elseif  (tag = &quot;leads&quot; and [lead_createdby_name] in ( &quot;Talabat SSU Site Guest User&quot;,&quot;SSU Vendor API user&quot;)) then &apos;Tele Sales&apos;&#10;&#10;elseif ([title])   in (&apos;Account Manager&apos;,&#10;&apos;Sr. Key Account Manager&apos;,&#10;&apos;Key Account Manager&apos;,&#10;&apos;Team Lead Account Management&apos;,&#10;&apos;Online Account Manager&apos;,&#10;&apos;Sr. Account Manager&apos;,&#10;&apos;Online Account Manager II&apos;,&#10;&apos;Team lead Online Account Management&apos;,&#10;&apos;Phone Account Manager&apos;,&#10;&apos;Coordinator Sales - Account Management&apos;)&#10;then &apos;Account Managers&apos;&#10;else &quot;Others&quot;&#10;end' />
            </column>
            <column caption='Open leads status' datatype='string' name='[Calculation_1131810937066078208]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;leads&quot; and LOWER([status]) in (&quot;contacted&quot;,&quot;long-term follow-up&quot;,&quot;new&quot;,&quot;open&quot;)  then &quot;Open leads&quot; else null end' />
            </column>
            <column caption='Open leads' datatype='string' name='[Calculation_1131810937068638210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1131810937066078208] = &quot;Open leads&quot; then [id] else null end' />
            </column>
            <column caption='Has Open lead or accounts?' datatype='boolean' name='[Calculation_1131810937105211401]' role='measure' type='nominal'>
              <calculation class='tableau' formula='([total (copy)_1532772054134624256]) &gt; 0' />
            </column>
            <column caption='Contact Established' datatype='string' name='[Calculation_1532772054134730753]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if (tag = &quot;accounts&quot; and lower([stagename]) = &quot;contact established&quot; ) or ( tag = &quot;leads&quot; and lower([status]) = &quot;contacted&quot; )&#10;then id else null end' />
            </column>
            <column caption='vertical seg' datatype='string' name='[Calculation_268597533436702720]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF  (vertical = &quot;Restaurant&quot;  or lower(vertical_segment) in (&quot;bakery&quot;,&quot;drinks&quot;,&quot;snacks_and_sweets&quot;,&quot;specialty_coffee_and_tea&quot;))&#10;//then &quot;Restaurant&quot; else &quot;Others&quot; end&#10;&#10;[vertical]' />
            </column>
            <column caption='Lead and accounts dineout flag ' datatype='boolean' name='[Calculation_3707729141229187073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ifnull([lead_dineout_flag],&quot;not dineout&quot;) = &quot;dineout&quot; then true &#10;else false end' />
            </column>
            <column caption='Potential closures' datatype='integer' name='[Calculation_6414392512306712577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNTD([Feedback Received (copy)_1532772054259945488])+ COUNTD([Quality Check Request (copy)_1532772054260138001])+COUNTD([Please Check (copy)_1532772054260305938])+ COUNTD([Promo and Logistics Queue (copy)_1532772054260518932])&#10;+ COUNTD([Editorial Queue (copy)_1532772054260674581])+ COUNTD([Delivery Pending (copy)_1532772054260920342])+COUNTD([Onboarding (copy)_1532772054261051415]))' />
            </column>
            <column caption='Closed lost' datatype='string' name='[Closed Won (copy)_1532772054261452826]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and lower([stagename]) = (&quot;closed lost&quot;) then id else null end' />
            </column>
            <column caption='New acc' datatype='string' name='[Contact Established (copy)_1532772054139199497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//if tag = &quot;accounts&quot; and lower([stagename]) in ( &quot;new&quot;,&quot;open&quot;) then id else null end&#10;&#10;if (tag = &quot;accounts&quot; and lower([stagename]) in ( &quot;new&quot;,&quot;open&quot;)) or (tag = &quot;leads&quot; and lower([status]) in ( &quot;new&quot;,&quot;open&quot;) )&#10; then id else null end' />
            </column>
            <column caption='Onboarding' datatype='string' name='[Delivery Pending (copy)_1532772054260920342]' role='dimension' type='nominal'>
