            <column-instance column='[vendor_grade__c]' derivation='None' name='[none:vendor_grade__c:nk]' pivot='key' type='nominal' />
            <column-instance column='[vendor_name]' derivation='None' name='[none:vendor_name:nk]' pivot='key' type='nominal' />
            <column caption='owner name' datatype='string' name='[opportunity_owner_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[pluto_validation_status]' role='dimension' type='nominal' />
            <column datatype='string' name='[right_competitor_flag]' role='dimension' type='nominal' />
            <column caption='salesforce id' datatype='string' name='[salesforce_id]' role='dimension' type='nominal' />
            <column datatype='string' name='[stagename]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Contact Established&quot;' value='Contacted' />
