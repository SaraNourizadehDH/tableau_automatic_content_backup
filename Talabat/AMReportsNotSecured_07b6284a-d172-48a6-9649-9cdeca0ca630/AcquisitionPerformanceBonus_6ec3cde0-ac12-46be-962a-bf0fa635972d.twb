    <worksheet name='Acq. regional performance'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Tableau Light' fontsize='12'>Regional Sales Executive - Performance</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='acquisition_bonus' name='federated.18yjm090w2erea13jqkli0j9qfey' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.18yjm090w2erea13jqkli0j9qfey'>
            <column caption='C Acquisition ' datatype='integer' name='[A + B Acquisition (copy)_6912532891441647624]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( case [vendor_grade] when &apos;C&apos; then [vendor_id]&#10;&#10;else null&#10;end)' />
            </column>
            <column caption='C Productivity ' datatype='real' name='[A + B Productivity (copy)_1290070233886617601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[A + B Acquisition (copy)_6912532891441647624]/[Calculation_717690866559967235]' />
            </column>
            <column caption='Include in productivity ' datatype='string' name='[Calculation_6414392512305717248]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sales_rep_validation] = 1 THEN &quot;True&quot; else &quot;False&quot; end' />
            </column>
            <column caption='# Vendors' datatype='integer' name='[Calculation_717690866528088064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([salesforce_id])' />
            </column>
            <column caption='# Sales Executives' datatype='integer' name='[Calculation_717690866559967235]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if  [Calculation_6414392512305717248] = &quot;False&quot; THEN [owner_name]&#10;else [rep_name] end )' />
            </column>
            <column caption='A + B Acquisition' datatype='integer' name='[Calculation_717690866900668432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD( case [vendor_grade] when &apos;A&apos; then [vendor_id]&#10;when &apos;B&apos; then [vendor_id]&#10;else null&#10;end)' />
            </column>
            <column caption='Productivity' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_717690866900967441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_717690866528088064]/[Calculation_717690866559967235]' />
            </column>
            <column caption='A + B Productivity' datatype='real' name='[Calculation_717690866901094418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_717690866900668432]/[Calculation_717690866559967235]' />
            </column>
            <column-instance column='[Calculation_6414392512305717248]' derivation='None' name='[none:Calculation_6414392512305717248:nk]' pivot='key' type='nominal' />
            <column-instance column='[rep_country_code2]' derivation='None' name='[none:rep_country_code2:nk]' pivot='key' type='nominal' />
            <column-instance column='[rep_month]' derivation='None' name='[none:rep_month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[verticals]' derivation='None' name='[none:verticals:nk]' pivot='key' type='nominal' />
            <column caption='Owner Name' datatype='string' name='[owner_name]' role='dimension' type='nominal' />
            <column caption='country code' datatype='string' name='[rep_country_code2]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[rep_month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[rep_name]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Include for productivity calculation' datatype='integer' name='[sales_rep_validation]' role='dimension' type='ordinal' />
            <column caption='Salesforce ID' datatype='string' name='[salesforce_id]' role='dimension' type='nominal' />
            <column-instance column='[rep_month]' derivation='Month-Trunc' name='[tmn:rep_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[A + B Acquisition (copy)_6912532891441647624]' derivation='User' name='[usr:A + B Acquisition (copy)_6912532891441647624:qk]' pivot='key' type='quantitative' />
