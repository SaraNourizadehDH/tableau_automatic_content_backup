    <datasource caption='acquisition_bonus' inline='true' name='federated.18yjm090w2erea13jqkli0j9qfey' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.01fbykw0wb3zzz1doz22v1csey2z'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='andria.sunny@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.01fbykw0wb3zzz1doz22v1csey2z' name='Custom SQL Query' type='text'><![CDATA[with t1 as (
SELECT
  DISTINCT 
  date_trunc(o.closedate,month)date_month,
  ch.country_code,
  v.salesforce_id,
  v.vendor_id,
  v.vendor_name,
  v.chain_id, 
  chain_name,
  is_tgo,
  is_dineout,
  is_dh_kitchen,
  is_non_food,
  IF(vendor_grade__c IS NULL,'Ungraded',vendor_grade__c) AS vendor_grade,
  CASE 
    when ch.country_code in ("JO","IQ") then 
      (case when IF(vendor_grade__c IS NULL,'Ungraded',vendor_grade__c) = 'A' then 10
            when IF(vendor_grade__c IS NULL,'Ungraded',vendor_grade__c) = 'B' then 5
            when IF(vendor_grade__c IS NULL,'Ungraded',vendor_grade__c) = 'C' then 3
            when IF(vendor_grade__c IS NULL,'Ungraded',vendor_grade__c) = 'D' then 1
            else 0
      end)
    when ch.country_code in ("AE","BH","EG","OM","QA","KW") then
      (case when IF(vendor_grade__c IS NULL,'Ungraded',vendor_grade__c) = 'A' then 10
            when IF(vendor_grade__c IS NULL,'Ungraded',vendor_grade__c) = 'B' then 5
            when IF(vendor_grade__c IS NULL,'Ungraded',vendor_grade__c) = 'C' then 1
            when IF(vendor_grade__c IS NULL,'Ungraded',vendor_grade__c) = 'D' then 1
            else 0
      end)
  END as vendor_grade_points,
  IF(key_account_sub_category__c IS NULL, 'Non KA', key_account_sub_category__c) AS key_account_sub_category,
  o.business_type__c as business_type,
   lower(CONCAT(firstname, ' ', lastname)) AS owner_name,
  v.team_leader_name,
  Title as title,
  a.vertical__c as verticals,
  IF(title IN ('Sales Executive','Sr. Sales Executive','Sr. Sales executive', 'Sales Exeuctive','Coordinator Riders','Sales Acquisition - IC1','Team Lead Acquisition'),'Field Sales',IF(title in ('Executive Inside Sales','Inside Sales Executive','Manager Content',
'Account Advisor - Content',
"Account Advisor - Restaurants’ Operations"),'Tele Sales', 'Account Managers')) AS sales_team2,
  case when type__c = 'Exclusivity' then true else false end as is_exclusive,
  o.closedate as close_date,
  Orders as orders,
  GMV as gmv_lc,
  GMV_eur as gmv_eur,
  reg_fee as registration_fee_lc,
  reg_fee_eur as registration_fee_eur,
  date(current_date) last_updated,
  
FROM `tlb-data-prod.data_platform.dim_vendor_info` v
LEFT JOIN `tlb-data-prod.data_platform.dim_chain` ch 
ON ch.chain_id = v.chain_id
-- LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l
-- ON l.location_id = v.location_id
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
ON v.salesforce_id = a.grid__c
LEFT JOIN  `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c
ON a.id = c.accountid
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o
ON a.id =o.accountid
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.user` u
ON o.ownerid = u.id 
LEFT JOIN
(
  SELECT
    DISTINCT v.vendor_id,
    commission__c/100 AS commission
  FROM `tlb-data-prod.data_platform.dim_vendor_info` v
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l
  ON l.location_id = v.location_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
  ON v.salesforce_id = a.grid__c
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c
  ON a.id = c.accountid
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o
  ON a.id =o.accountid
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.user` u

  ON o.ownerid = u.id --and date_trunc(o.closedate,month) = u.iso_month
  WHERE 1=1
  AND o.business_type__c IN ('New Business','Win Back','Franchise Extension') --
  AND o.stagename = 'Closed Won'
  AND date_trunc(o.closedate,month) >>=  "2023-01-01" -- date_sub(date_trunc(current_date, month), interval 4 month)
  AND c.name__c IN ('TGO Basic Commission','TMP Basic Commission','TGO Basic Commission SSU','TGO Basic Commision','OD Basic Commission','MP Basic Commission','TGO Basic Commission N','TGO Basic commission','S01- Growth Package TGO Commission','B01 - Basic Package TGO Commission', 'TGO Incremental Orders Commission','BH S01 - Growth Package TGO Commission','BH B01 - Standard Package TGO Commission','OD Basic Commission trial','OM B01 - Standard Package (Restaurant) Commission OD','OM S01 - Growth Package (Restaurant) Commission OD')
  AND c.status = 'Activated'
  AND c.end_date__c IS NULL
) FC
ON v.vendor_id = FC.vendor_id
LEFT JOIN
(
  SELECT
    DISTINCT v.vendor_id,
    commission_per_order__c AS CPO
  FROM `tlb-data-prod.data_platform.dim_vendor_info` v
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l
  ON l.location_id = v.location_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
  ON v.salesforce_id = a.grid__c
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c
  ON a.id = c.accountid
  LEFT JOIN`fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o
  ON a.id =o.accountid
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.user` u

  ON o.ownerid = u.id  --and date_trunc(o.closedate,month) = u.iso_month
  WHERE
  o.business_type__c IN ('New Business','Win Back','Franchise Extension') --
  AND o.stagename = 'Closed Won'
  AND date_trunc(o.closedate,month) >>=  "2023-01-01" -- date_sub(date_trunc(current_date, month), interval 4 month)
  AND c.name__c IN ('TGO Service Fee SSU','OD Service Fee','TGO Service Fee','Fixed amount Per Order','Fix Amount Per Order')
  AND c.status = 'Activated'
  AND c.end_date__c IS NULL
) CPO
ON v.vendor_id = CPO.vendor_id
LEFT JOIN
(
  SELECT
    DISTINCT vendor_id,
    vendor_name,
    salesforce_id,
    Closedate,
    country_code,
    business_type__c,
    name__c,
    COUNT(DISTINCT Orders) AS Orders,
    SUM(GMV) AS GMV,
    SUM(GMV_eur) AS GMV_eur,
    SUM(Flat_Comm_Rev) +SUM(CPO_Rev) AS Comm_Rev
  FROM
  (
    SELECT
      DISTINCT od.vendor_id,
      v.vendor_name,
      salesforce_id,
      Closedate,
      l.country_code,
      o.business_type__c,
      c.name__c,
      od.order_id Orders,
      Commissionable_gmv_amount_lc GMV,
      Commissionable_gmv_amount_eur GMV_eur,
      commission_amount_lc AS Flat_Comm_Rev,
      tgo_amount_lc AS  CPO_Rev
  FROM `tlb-data-prod.data_platform.fct_order_info` od
  LEFT JOIN `tlb-data-prod.data_platform.fct_billing` b
  ON od.order_id = b.order_id
  AND billing_date >>= '2023-06-01'
  LEFT JOIN `tlb-data-prod.data_platform.dim_order_status` ds
  ON od.order_status_id = ds.order_status_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v
  ON od.vendor_id = v.vendor_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l
  ON l.location_id = v.location_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
  ON v.salesforce_id = a.grid__c
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c
  ON a.id = c.accountid
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o
  ON a.id =o.accountid
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.user` u 
  
  ON o.ownerid = u.id --and date_trunc(o.closedate,month) = u.iso_month
  WHERE
  ds.is_commissionable = TRUE
  AND od.is_test =FALSE
  AND o.business_type__c IN ('New Business','Win Back','Franchise Extension') 
  AND o.stagename = 'Closed Won'
  AND c.name__c IN ('TGO Basic Commission','TMP Basic Commission','TGO Basic Commission SSU','TGO Basic Commision','OD Basic Commission','MP Basic Commission','TGO Basic Commission N','TGO Basic commission','S01- Growth Package TGO Commission','B01 - Basic Package TGO Commission', 'TGO Incremental Orders Commission','BH S01 - Growth Package TGO Commission','BH B01 - Standard Package TGO Commission','OD Basic Commission trial','OM B01 - Standard Package (Restaurant) Commission OD','OM S01 - Growth Package (Restaurant) Commission OD')
  AND date_trunc(closedate,month) >>= date_sub(date_trunc(current_date, month), interval 4 month)
  AND od.order_date >>= closedate
  AND od.order_date <<= DATE_ADD(closedate, INTERVAL 14 DAY)
  AND c.status = 'Activated'
  ORDER BY 3)
  GROUP BY 1, 2,3,4,5,6,7) aa
  ON aa.vendor_id= v.vendor_id
LEFT JOIN
(
  SELECT
    DISTINCT
    v.vendor_id,
    ad.type__c,
    ad.status__c,
    specifications__c,
  FROM `tlb-data-prod.data_platform.dim_vendor_info` v
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l
  ON l.location_id = v.location_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_chain` ch
  ON ch.chain_id = v.chain_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_sales_revenue.gsd_commission_floor_report` f
  ON CAST(f.vendor_id AS INT64) = v.vendor_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
  ON v.salesforce_id = a.grid__c
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.add_on_service__c` ad
  ON a.id = ad.account_name__c
  WHERE
  ad.type__c = 'Exclusivity'
  AND ad.status__c = 'Active'
)t
  ON t.vendor_id = v.vendor_id 
LEFT JOIN
(
  select
    upper(ad.country_code)as country_code,
    grid__c as salesforce_id,
    chain_id,
    start_date__c as start_date,
    total_amount__c as reg_fee,
    ROUND((total_amount__c/exchange_rate_value),2) reg_fee_eur,
    round(exchange_rate_value,4)exchange_rate_value
  from `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.additional_charges__c` ad
    on a.id = ad.id_account__c
  left join `tlb-data-prod.data_platform.dim_vendor_info` dv
    on a.grid__c = dv.salesforce_id
  left join `tlb-data-prod.data_platform.dim_exchange_rate`  exr 
    on date(start_date__c) = date(exchange_rate_date)
    and upper(ad.country_code) = exr.country_code
    and exchange_rate_base = 'EUR'
  where 1= 1
  and product__c =  'Registration Fee'
  and ad.status__c = 'Active'
) fee 
on fee.chain_id = v.chain_id
and fee.salesforce_id = v.salesforce_id

  WHERE 1=1
  AND date_trunc(o.closedate,month) >>= "2023-01-01" --date_sub(date_trunc(current_date, month), interval 4 month)
  AND o.business_type__c IN ('New Business','Win Back','Franchise Extension')
  AND o.stagename = 'Closed Won'
  AND Title IN
  ('Inside Sales Executive',
  'Sales Executive',
  'Sr. Sales Executive',
   'Sales Exeuctive',
  'Coordinator Riders','Sales Acquisition - IC1','Team Lead Acquisition','Sr. Sales executive','Online Account Manager','Coordinator Sales - Onboarding','Account Manager',
  'Online Account Manager - NFV','Sr. Sales Executive - NFV','Executive Inside Sales','Manager Content',
'Account Advisor - Content',
"Account Advisor - Restaurants’ Operations")
  --AND c.status = 'Activated'
) ,

t2 as (
  select 
  months,
  owner_name,
  if (sales_team = "Tele Sales" , "MENA" , rep_country_code  ) as rep_country_code,
  sf_country,
  type,
  sales_team,
  sales_rep_validation
   from 
  (
  select
  distinct  
   date_trunc(date,month) as months,
   CONCAT(firstname, ' ', lastname) as owner_name,
   trim(l.country_code) as rep_country_code,
   substring(countrycode__c,1,2) as sf_country,
   l.type,
   IF(u.title IN ('Sales Executive','Sr. Sales Executive','Sr. Sales executive','Coordinator Riders','Sales Acquisition - IC1','Team Lead Acquisition', 'Sales Exeuctive'),'Field Sales',IF(u.title in ('Manager Content',
'Account Advisor - Content',
"Account Advisor - Restaurants’ Operations",'Executive Inside Sales','Inside Sales Executive',
'Supervisor Operations'),'Tele Sales', 'Account Managers')) AS sales_team,
   if  ( lower(trim(l.owner_name)) =  lower(trim((CONCAT(firstname, ' ', lastname)))) and date(l.month) = date_trunc(date,month) , 1 , 0 )  sales_rep_validation
 
 from `tlb-data-prod.data_platform.dim_date`
 cross join  `fulfillment-dwh-production.curated_data_shared_salesforce.user` u 
 left join   `tlb-data-prod.data_platform_google_sheet.sales_executives` l  on date(l.month) = date_trunc(date,month) 
 and lower(trim(l.owner_name)) =  lower(trim((CONCAT(firstname, ' ', lastname))))
 where date_trunc(date,month) >>= "2023-01-01"
 and date_trunc(date,month) <<= date_trunc(current_date,month)

  AND Title IN
  ('Inside Sales Executive',
  'Sales Executive',
  'Sales Exeuctive',
  'Sr. Sales Executive',
  'Coordinator Riders','Sales Acquisition - IC1','Team Lead Acquisition','Sr. Sales executive','Online Account Manager','Coordinator Sales - Onboarding','Account Manager',
  'Online Account Manager - NFV','Sr. Sales Executive - NFV','Executive Inside Sales',
'Manager Content',
'Account Advisor - Content',
"Account Advisor - Restaurants’ Operations",
'Supervisor Operations'
)
)
)

select 
distinct
sf_country,
coalesce (t1.country_code,t2.rep_country_code,sf_country)  as rep_country_code2,
coalesce (t1.country_code,sf_country,t2.rep_country_code)  as rep_country_code,
coalesce(t2.months,date_trunc(close_Date,month) )  as rep_month,
trim(t2.owner_name) as rep_name,
t2.type as rep_type,
coalesce(sales_team2,t2.sales_team) as sales_team,
t1.*,
t2.sales_rep_validation

from  
 t2 left join t1 on date_trunc(close_Date,month) = t2.months and lower(trim(t2.owner_name)) =  lower(trim(t1.owner_name)) 

 where months >>= "2024-01-01"
 and  months <<= date_trunc(current_date,month)
 and  (
 sf_country in ('OM','AE','BH','KW','JO','QA','EG','IQ') or 
 t2.rep_country_code in ('OM','AE','BH','KW','JO','QA','EG','IQ','MENA')
 )
 --AND  trim(t2.owner_name)  = "Husain Ali"]]></_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation connection='bigquery.01fbykw0wb3zzz1doz22v1csey2z' name='Custom SQL Query' type='text'><![CDATA[with t1 as (
SELECT
  DISTINCT 
  date_trunc(o.closedate,month)date_month,
  ch.country_code,
  v.salesforce_id,
  v.vendor_id,
  v.vendor_name,
  v.chain_id, 
  chain_name,
  is_tgo,
  is_dineout,
  is_dh_kitchen,
  is_non_food,
  IF(vendor_grade__c IS NULL,'Ungraded',vendor_grade__c) AS vendor_grade,
  CASE 
    when ch.country_code in ("JO","IQ") then 
      (case when IF(vendor_grade__c IS NULL,'Ungraded',vendor_grade__c) = 'A' then 10
            when IF(vendor_grade__c IS NULL,'Ungraded',vendor_grade__c) = 'B' then 5
            when IF(vendor_grade__c IS NULL,'Ungraded',vendor_grade__c) = 'C' then 3
            when IF(vendor_grade__c IS NULL,'Ungraded',vendor_grade__c) = 'D' then 1
            else 0
      end)
    when ch.country_code in ("AE","BH","EG","OM","QA","KW") then
      (case when IF(vendor_grade__c IS NULL,'Ungraded',vendor_grade__c) = 'A' then 10
            when IF(vendor_grade__c IS NULL,'Ungraded',vendor_grade__c) = 'B' then 5
            when IF(vendor_grade__c IS NULL,'Ungraded',vendor_grade__c) = 'C' then 1
            when IF(vendor_grade__c IS NULL,'Ungraded',vendor_grade__c) = 'D' then 1
            else 0
      end)
  END as vendor_grade_points,
  IF(key_account_sub_category__c IS NULL, 'Non KA', key_account_sub_category__c) AS key_account_sub_category,
  o.business_type__c as business_type,
   lower(CONCAT(firstname, ' ', lastname)) AS owner_name,
  v.team_leader_name,
  Title as title,
  a.vertical__c as verticals,
  IF(title IN ('Sales Executive','Sr. Sales Executive','Sr. Sales executive', 'Sales Exeuctive','Coordinator Riders','Sales Acquisition - IC1','Team Lead Acquisition'),'Field Sales',IF(title in ('Executive Inside Sales','Inside Sales Executive','Manager Content',
'Account Advisor - Content',
"Account Advisor - Restaurants’ Operations"),'Tele Sales', 'Account Managers')) AS sales_team2,
  case when type__c = 'Exclusivity' then true else false end as is_exclusive,
  o.closedate as close_date,
  Orders as orders,
  GMV as gmv_lc,
  GMV_eur as gmv_eur,
  reg_fee as registration_fee_lc,
  reg_fee_eur as registration_fee_eur,
  date(current_date) last_updated,
  
FROM `tlb-data-prod.data_platform.dim_vendor_info` v
LEFT JOIN `tlb-data-prod.data_platform.dim_chain` ch 
ON ch.chain_id = v.chain_id
-- LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l
-- ON l.location_id = v.location_id
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
ON v.salesforce_id = a.grid__c
LEFT JOIN  `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c
ON a.id = c.accountid
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o
ON a.id =o.accountid
LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.user` u
ON o.ownerid = u.id 
LEFT JOIN
(
  SELECT
    DISTINCT v.vendor_id,
    commission__c/100 AS commission
  FROM `tlb-data-prod.data_platform.dim_vendor_info` v
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l
  ON l.location_id = v.location_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
  ON v.salesforce_id = a.grid__c
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c
  ON a.id = c.accountid
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o
  ON a.id =o.accountid
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.user` u

  ON o.ownerid = u.id --and date_trunc(o.closedate,month) = u.iso_month
  WHERE 1=1
  AND o.business_type__c IN ('New Business','Win Back','Franchise Extension') --
  AND o.stagename = 'Closed Won'
  AND date_trunc(o.closedate,month) >>=  "2023-01-01" -- date_sub(date_trunc(current_date, month), interval 4 month)
  AND c.name__c IN ('TGO Basic Commission','TMP Basic Commission','TGO Basic Commission SSU','TGO Basic Commision','OD Basic Commission','MP Basic Commission','TGO Basic Commission N','TGO Basic commission','S01- Growth Package TGO Commission','B01 - Basic Package TGO Commission', 'TGO Incremental Orders Commission','BH S01 - Growth Package TGO Commission','BH B01 - Standard Package TGO Commission','OD Basic Commission trial','OM B01 - Standard Package (Restaurant) Commission OD','OM S01 - Growth Package (Restaurant) Commission OD')
  AND c.status = 'Activated'
  AND c.end_date__c IS NULL
) FC
ON v.vendor_id = FC.vendor_id
LEFT JOIN
(
  SELECT
    DISTINCT v.vendor_id,
    commission_per_order__c AS CPO
  FROM `tlb-data-prod.data_platform.dim_vendor_info` v
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l
  ON l.location_id = v.location_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
  ON v.salesforce_id = a.grid__c
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c
  ON a.id = c.accountid
  LEFT JOIN`fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o
  ON a.id =o.accountid
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.user` u

  ON o.ownerid = u.id  --and date_trunc(o.closedate,month) = u.iso_month
  WHERE
  o.business_type__c IN ('New Business','Win Back','Franchise Extension') --
  AND o.stagename = 'Closed Won'
  AND date_trunc(o.closedate,month) >>=  "2023-01-01" -- date_sub(date_trunc(current_date, month), interval 4 month)
  AND c.name__c IN ('TGO Service Fee SSU','OD Service Fee','TGO Service Fee','Fixed amount Per Order','Fix Amount Per Order')
  AND c.status = 'Activated'
  AND c.end_date__c IS NULL
) CPO
ON v.vendor_id = CPO.vendor_id
LEFT JOIN
(
  SELECT
    DISTINCT vendor_id,
    vendor_name,
    salesforce_id,
    Closedate,
    country_code,
    business_type__c,
    name__c,
    COUNT(DISTINCT Orders) AS Orders,
    SUM(GMV) AS GMV,
    SUM(GMV_eur) AS GMV_eur,
    SUM(Flat_Comm_Rev) +SUM(CPO_Rev) AS Comm_Rev
  FROM
  (
    SELECT
      DISTINCT od.vendor_id,
      v.vendor_name,
      salesforce_id,
      Closedate,
      l.country_code,
      o.business_type__c,
      c.name__c,
      od.order_id Orders,
      Commissionable_gmv_amount_lc GMV,
      Commissionable_gmv_amount_eur GMV_eur,
      commission_amount_lc AS Flat_Comm_Rev,
      tgo_amount_lc AS  CPO_Rev
  FROM `tlb-data-prod.data_platform.fct_order_info` od
  LEFT JOIN `tlb-data-prod.data_platform.fct_billing` b
  ON od.order_id = b.order_id
  AND billing_date >>= '2023-06-01'
  LEFT JOIN `tlb-data-prod.data_platform.dim_order_status` ds
  ON od.order_status_id = ds.order_status_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` v
  ON od.vendor_id = v.vendor_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l
  ON l.location_id = v.location_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
  ON v.salesforce_id = a.grid__c
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.contract` c
  ON a.id = c.accountid
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o
  ON a.id =o.accountid
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.user` u 
  
  ON o.ownerid = u.id --and date_trunc(o.closedate,month) = u.iso_month
  WHERE
  ds.is_commissionable = TRUE
  AND od.is_test =FALSE
  AND o.business_type__c IN ('New Business','Win Back','Franchise Extension') 
  AND o.stagename = 'Closed Won'
  AND c.name__c IN ('TGO Basic Commission','TMP Basic Commission','TGO Basic Commission SSU','TGO Basic Commision','OD Basic Commission','MP Basic Commission','TGO Basic Commission N','TGO Basic commission','S01- Growth Package TGO Commission','B01 - Basic Package TGO Commission', 'TGO Incremental Orders Commission','BH S01 - Growth Package TGO Commission','BH B01 - Standard Package TGO Commission','OD Basic Commission trial','OM B01 - Standard Package (Restaurant) Commission OD','OM S01 - Growth Package (Restaurant) Commission OD')
  AND date_trunc(closedate,month) >>= date_sub(date_trunc(current_date, month), interval 4 month)
  AND od.order_date >>= closedate
  AND od.order_date <<= DATE_ADD(closedate, INTERVAL 14 DAY)
  AND c.status = 'Activated'
  ORDER BY 3)
  GROUP BY 1, 2,3,4,5,6,7) aa
  ON aa.vendor_id= v.vendor_id
LEFT JOIN
(
  SELECT
    DISTINCT
    v.vendor_id,
    ad.type__c,
    ad.status__c,
    specifications__c,
  FROM `tlb-data-prod.data_platform.dim_vendor_info` v
  LEFT JOIN `tlb-data-prod.data_platform.dim_location_info` l
  ON l.location_id = v.location_id
  LEFT JOIN `tlb-data-prod.data_platform.dim_chain` ch
  ON ch.chain_id = v.chain_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_sales_revenue.gsd_commission_floor_report` f
  ON CAST(f.vendor_id AS INT64) = v.vendor_id
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
  ON v.salesforce_id = a.grid__c
  LEFT JOIN `fulfillment-dwh-production.curated_data_shared_salesforce.add_on_service__c` ad
  ON a.id = ad.account_name__c
  WHERE
  ad.type__c = 'Exclusivity'
  AND ad.status__c = 'Active'
)t
  ON t.vendor_id = v.vendor_id 
LEFT JOIN
(
  select
    upper(ad.country_code)as country_code,
    grid__c as salesforce_id,
    chain_id,
    start_date__c as start_date,
    total_amount__c as reg_fee,
    ROUND((total_amount__c/exchange_rate_value),2) reg_fee_eur,
    round(exchange_rate_value,4)exchange_rate_value
  from `fulfillment-dwh-production.curated_data_shared_salesforce.account` a
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.additional_charges__c` ad
    on a.id = ad.id_account__c
  left join `tlb-data-prod.data_platform.dim_vendor_info` dv
    on a.grid__c = dv.salesforce_id
  left join `tlb-data-prod.data_platform.dim_exchange_rate`  exr 
    on date(start_date__c) = date(exchange_rate_date)
    and upper(ad.country_code) = exr.country_code
    and exchange_rate_base = 'EUR'
  where 1= 1
  and product__c =  'Registration Fee'
  and ad.status__c = 'Active'
) fee 
on fee.chain_id = v.chain_id
and fee.salesforce_id = v.salesforce_id

  WHERE 1=1
  AND date_trunc(o.closedate,month) >>= "2023-01-01" --date_sub(date_trunc(current_date, month), interval 4 month)
  AND o.business_type__c IN ('New Business','Win Back','Franchise Extension')
  AND o.stagename = 'Closed Won'
  AND Title IN
  ('Inside Sales Executive',
  'Sales Executive',
  'Sr. Sales Executive',
   'Sales Exeuctive',
  'Coordinator Riders','Sales Acquisition - IC1','Team Lead Acquisition','Sr. Sales executive','Online Account Manager','Coordinator Sales - Onboarding','Account Manager',
  'Online Account Manager - NFV','Sr. Sales Executive - NFV','Executive Inside Sales','Manager Content',
'Account Advisor - Content',
"Account Advisor - Restaurants’ Operations")
  --AND c.status = 'Activated'
) ,

t2 as (
  select 
  months,
  owner_name,
  if (sales_team = "Tele Sales" , "MENA" , rep_country_code  ) as rep_country_code,
  sf_country,
  type,
  sales_team,
  sales_rep_validation
   from 
  (
  select
  distinct  
   date_trunc(date,month) as months,
   CONCAT(firstname, ' ', lastname) as owner_name,
   trim(l.country_code) as rep_country_code,
   substring(countrycode__c,1,2) as sf_country,
   l.type,
   IF(u.title IN ('Sales Executive','Sr. Sales Executive','Sr. Sales executive','Coordinator Riders','Sales Acquisition - IC1','Team Lead Acquisition', 'Sales Exeuctive'),'Field Sales',IF(u.title in ('Manager Content',
'Account Advisor - Content',
"Account Advisor - Restaurants’ Operations",'Executive Inside Sales','Inside Sales Executive',
'Supervisor Operations'),'Tele Sales', 'Account Managers')) AS sales_team,
   if  ( lower(trim(l.owner_name)) =  lower(trim((CONCAT(firstname, ' ', lastname)))) and date(l.month) = date_trunc(date,month) , 1 , 0 )  sales_rep_validation
 
 from `tlb-data-prod.data_platform.dim_date`
 cross join  `fulfillment-dwh-production.curated_data_shared_salesforce.user` u 
 left join   `tlb-data-prod.data_platform_google_sheet.sales_executives` l  on date(l.month) = date_trunc(date,month) 
 and lower(trim(l.owner_name)) =  lower(trim((CONCAT(firstname, ' ', lastname))))
 where date_trunc(date,month) >>= "2023-01-01"
 and date_trunc(date,month) <<= date_trunc(current_date,month)

  AND Title IN
  ('Inside Sales Executive',
  'Sales Executive',
  'Sales Exeuctive',
  'Sr. Sales Executive',
  'Coordinator Riders','Sales Acquisition - IC1','Team Lead Acquisition','Sr. Sales executive','Online Account Manager','Coordinator Sales - Onboarding','Account Manager',
  'Online Account Manager - NFV','Sr. Sales Executive - NFV','Executive Inside Sales',
'Manager Content',
'Account Advisor - Content',
"Account Advisor - Restaurants’ Operations",
'Supervisor Operations'
)
)
)

select 
distinct
sf_country,
coalesce (t1.country_code,t2.rep_country_code,sf_country)  as rep_country_code2,
coalesce (t1.country_code,sf_country,t2.rep_country_code)  as rep_country_code,
coalesce(t2.months,date_trunc(close_Date,month) )  as rep_month,
trim(t2.owner_name) as rep_name,
t2.type as rep_type,
coalesce(sales_team2,t2.sales_team) as sales_team,
t1.*,
t2.sales_rep_validation

from  
 t2 left join t1 on date_trunc(close_Date,month) = t2.months and lower(trim(t2.owner_name)) =  lower(trim(t1.owner_name)) 

 where months >>= "2024-01-01"
 and  months <<= date_trunc(current_date,month)
 and  (
 sf_country in ('OM','AE','BH','KW','JO','QA','EG','IQ') or 
 t2.rep_country_code in ('OM','AE','BH','KW','JO','QA','EG','IQ','MENA')
 )
 --AND  trim(t2.owner_name)  = "Husain Ali"]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
