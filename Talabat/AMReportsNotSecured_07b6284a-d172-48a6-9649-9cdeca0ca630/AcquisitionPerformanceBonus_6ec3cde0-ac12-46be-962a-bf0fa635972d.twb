              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and lower([stagename]) = (&quot;please check&quot;) and [is_dh_kitchen] &lt;&gt; &quot;true&quot;  then id else null end' />
            </column>
            <column caption='Open  acc' datatype='string' name='[Quote sent (copy)_1532772054140547083]' role='dimension' type='nominal'>
