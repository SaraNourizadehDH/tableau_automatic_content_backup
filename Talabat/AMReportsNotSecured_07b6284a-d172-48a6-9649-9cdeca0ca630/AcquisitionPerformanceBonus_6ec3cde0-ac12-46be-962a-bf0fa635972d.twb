  <actions>
    <action caption='Filter1' name='[Action1_C85EC0D3F6994E9296509DF173E9480B]'>
      <source dashboard='Funnel tracker' type='sheet' worksheet='FT - opp stages' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='FT - open leads and accounts,FT - activity,FT - summary,FT - opp stages,FT - open leads list' />
