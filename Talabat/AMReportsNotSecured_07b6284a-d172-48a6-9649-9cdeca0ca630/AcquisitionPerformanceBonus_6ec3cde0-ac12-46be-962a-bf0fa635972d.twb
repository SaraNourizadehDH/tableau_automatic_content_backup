      <layout _.fcp.SchemaViewerObjectModel.false...dim-percentage='0.5' _.fcp.SchemaViewerObjectModel.false...measure-percentage='0.4' _.fcp.SchemaViewerObjectModel.true...common-percentage='0.571831' _.fcp.SchemaViewerObjectModel.true...user-set-layout-v2='true' dim-ordering='alphabetic' measure-ordering='alphabetic' parameter-percentage='0.428169' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <date-options start-of-week='saturday' />
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_96EE633116F948B296A3BBB9FEAE8A21'>
            <properties context=''>
              <relation connection='bigquery.1m1euyc1tkmiz41fb07dm0d1cizd' name='Custom SQL Query' type='text'><![CDATA[with
t2 as (
  select 
  months,
  owner_name,
  if (sales_team = "Tele Sales" , "MENA" , rep_country_code  ) as rep_country_code,
  sf_country,
  type,
  sales_team,
  sales_rep_validation
   from 
  (
  select
  distinct  
   date_trunc(date,month) as months,
   CONCAT(firstname, ' ', lastname) as owner_name,
   trim(l.country_code) as rep_country_code,
   substring(countrycode__c,1,2) as sf_country,
   l.type,
   IF(u.title IN ('Sales Executive','Sr. Sales Executive','Sr. Sales executive','Coordinator Riders','Sales Acquisition - IC1','Team Lead Acquisition'),'Field Sales',IF(u.title = 'Inside Sales Executive','Tele Sales', 'Account Managers')) AS sales_team,
   if  ( lower(trim(l.owner_name)) =  lower(trim((CONCAT(firstname, ' ', lastname)))) and date(l.month) = date_trunc(date,month) , 1 , 0 )  sales_rep_validation
 
 from `tlb-data-prod.data_platform.dim_date`
 cross join  `fulfillment-dwh-production.curated_data_shared_salesforce.user` u 
 left join   `tlb-data-prod.data_platform_google_sheet.sales_executives` l  on date(l.month) = date_trunc(date,month) 
 and lower(trim(l.owner_name)) =  lower(trim((CONCAT(firstname, ' ', lastname))))
 where date_trunc(date,month) >>= "2023-01-01"
 and date_trunc(date,month) <<= date_trunc(current_date,month)

  AND Title IN
  ('Inside Sales Executive',
  'Sales Executive',
  'Sr. Sales Executive',
  'Coordinator Riders','Sales Acquisition - IC1','Team Lead Acquisition','Sr. Sales executive','Online Account Manager','Coordinator Sales - Onboarding','Account Manager','Online Account Manager - NFV')
)
),
meetings as   
(
select
salesforce_id,
owner_name,
country_code,
date_trunc(event_date,month) as month,
count(salesforce_id) as meetings
from  
(
select
  distinct
  e.country_code,
  e.accountid,
  partition_date,
  e.ownerid,
  date(activitydate) as event_date,
  grid__c as salesforce_id,
  lower(e.type) as type,
  lower(e.subject) as subject,
  (CONCAT(firstname, ' ', lastname)) AS owner_name

  from  `fulfillment-dwh-production.curated_data_shared_salesforce.event`  e 
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.account` a on a.id = e.accountid
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.opportunity` o on e.whatid = o.id
  left join `fulfillment-dwh-production.curated_data_shared_salesforce.user`  us on us.id = e.ownerid 

  where lower(e.type) = ("meeting") and lower(e.subject) in ("new meeting","follow up","meeting")
  and partition_date >>= "2023-01-01"
  -- and e.country_code = "ae"
)
group by 1,2,3,4
)

select 
t2.*,
count(distinct m.salesforce_id) as vendors,
sum(meetings) as meetings
from  
 t2 left join meetings m on m.month = t2.months and lower(trim(t2.owner_name)) =  lower(trim(m.owner_name)) 
 and t2.months >>= "2023-01-01"
 where m.month is not null 
 group by 1,2,3,4,5,6,7]]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
  </datasources>
