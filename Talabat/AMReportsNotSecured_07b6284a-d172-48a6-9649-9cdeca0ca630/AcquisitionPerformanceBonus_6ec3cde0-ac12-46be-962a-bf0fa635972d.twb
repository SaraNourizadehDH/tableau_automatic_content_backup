            <column caption='Fill Rate ' datatype='integer' name='[Calculation_6467520917426921481]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [country_code] = &quot;ae&quot; then [Calculation_6467520917365944320]&#10;ELSEIF [country_code] = &quot;bh&quot; then [Calculation_6467520917368139777]&#10;ELSEIF [country_code] = &quot;eg&quot; then [Calculation_6467520917368238082]&#10;ELSEIF [country_code] = &quot;iq&quot; then [Calculation_6467520917368836103]&#10;ELSEIF [country_code] = &quot;jo&quot; then [Calculation_6467520917368336388]&#10;ELSEIF [country_code] = &quot;kw&quot; then [Calculation_6467520917368291331]&#10;ELSEIF [country_code] = &quot;om&quot; then [Calculation_6467520917368774662]&#10;ELSEIF [country_code] = &quot;qa&quot; then [Calculation_6467520917368721413]&#10;END' />
            </column>
            <column caption='Delta Fill Rate' datatype='integer' name='[Calculation_6467520917709525029]' role='measure' type='quantitative'>
