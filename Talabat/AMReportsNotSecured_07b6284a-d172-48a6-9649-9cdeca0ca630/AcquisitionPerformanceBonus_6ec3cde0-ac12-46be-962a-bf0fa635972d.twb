            </column>
            <column caption='Open leads status' datatype='string' name='[Calculation_1131810937066078208]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;leads&quot; and LOWER([status]) in (&quot;contacted&quot;,&quot;long-term follow-up&quot;,&quot;new&quot;,&quot;open&quot;)  then &quot;Open leads&quot; else null end' />
            </column>
            <column caption='Open leads' datatype='string' name='[Calculation_1131810937068638210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_1131810937066078208] = &quot;Open leads&quot; then [id] else null end' />
            </column>
            <column caption='Contact Established' datatype='string' name='[Calculation_1532772054134730753]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if (tag = &quot;accounts&quot; and lower([stagename]) = &quot;contact established&quot; ) or ( tag = &quot;leads&quot; and lower([status]) = &quot;contacted&quot; )&#10;then id else null end' />
            </column>
            <column caption='vertical seg' datatype='string' name='[Calculation_268597533436702720]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//IF  (vertical = &quot;Restaurant&quot;  or lower(vertical_segment) in (&quot;bakery&quot;,&quot;drinks&quot;,&quot;snacks_and_sweets&quot;,&quot;specialty_coffee_and_tea&quot;))&#10;//then &quot;Restaurant&quot; else &quot;Others&quot; end&#10;&#10;[vertical]' />
            </column>
            <column caption='Total Accounts ' datatype='integer' name='[Calculation_3392969753927720967]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Open leads (copy)_1131810937070358532])' />
            </column>
            <column caption='Total Leads' datatype='integer' name='[Calculation_3392969753928986632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Calculation_1131810937068638210])' />
            </column>
            <column caption='Lead and accounts dineout flag ' datatype='boolean' name='[Calculation_3707729141229187073]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ifnull([lead_dineout_flag],&quot;not dineout&quot;) = &quot;dineout&quot; then true &#10;else false end' />
            </column>
            <column caption='Quote Rejected' datatype='string' name='[Calculation_4727794454719492120]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and lower([stagename]) = &quot;quote rejected&quot; then id else null end' />
            </column>
            <column caption='Contract commission pending' datatype='string' name='[Calculation_4727794454719836185]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and lower([stagename]) in (&quot;approval pending&quot;,&quot;quote rejected&quot;)  then id else null end' />
            </column>
            <column caption='Potential closures' datatype='integer' name='[Calculation_6414392512306712577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNTD([Feedback Received (copy)_1532772054259945488])+ COUNTD([Quality Check Request (copy)_1532772054260138001])+COUNTD([Please Check (copy)_1532772054260305938])+ COUNTD([Promo and Logistics Queue (copy)_1532772054260518932])&#10;+ COUNTD([Editorial Queue (copy)_1532772054260674581])+ COUNTD([Delivery Pending (copy)_1532772054260920342])+COUNTD([Onboarding (copy)_1532772054261051415]))' />
            </column>
            <column caption='New acc' datatype='string' name='[Contact Established (copy)_1532772054139199497]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//if tag = &quot;accounts&quot; and lower([stagename]) in ( &quot;new&quot;,&quot;open&quot;) then id else null end&#10;&#10;if (tag = &quot;accounts&quot; and lower([stagename]) in ( &quot;new&quot;,&quot;open&quot;)) or (tag = &quot;leads&quot; and lower([status]) in ( &quot;new&quot;,&quot;open&quot;) )&#10; then id else null end' />
            </column>
            <column caption='Onboarding' datatype='string' name='[Delivery Pending (copy)_1532772054260920342]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and lower([stagename]) = (&quot;onboarding&quot;) and [is_dh_kitchen] &lt;&gt; &quot;true&quot;  then id else null end' />
            </column>
            <column caption='Delivery Pending' datatype='string' name='[Editorial Queue (copy)_1532772054260674581]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and lower([stagename]) = (&quot;delivery pending&quot;) and [is_dh_kitchen] &lt;&gt; &quot;true&quot;  then id else null end' />
            </column>
            <column caption='Quality Check Request' datatype='string' name='[Feedback Received (copy)_1532772054259945488]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and lower([stagename]) = (&quot;quality check request&quot;)  and [is_dh_kitchen] &lt;&gt; &quot;true&quot;  then id else null end' />
            </column>
            <column caption='Verbal agreement' datatype='string' name='[Negotiaiton (copy)_1532772054136688647]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and lower([stagename]) = &quot;verbal agreement&quot; then id else null end' />
            </column>
            <column caption='Onboarding Failed' datatype='string' name='[Onboarding (copy)_1532772054261051415]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and lower([stagename]) = (&quot;onboarding failed&quot;) and [is_dh_kitchen] &lt;&gt; &quot;true&quot;  then id else null end' />
            </column>
            <column caption='Open accounts' datatype='string' name='[Open leads (copy)_1131810937070358532]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [tag] = &quot;accounts&quot; and [Open leads status (copy)_1131810937066827777] = &quot;Open accounts&quot; then [id] else null end' />
            </column>
            <column caption='Open accounts status ' datatype='string' name='[Open leads status (copy)_1131810937066827777]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and [status] = &quot;Win Back failed&quot; then &quot;Other&quot;&#10;ELSEIF  [tag] = &quot;accounts&quot; and [status] = &quot;Terminated&quot; then &quot;Other&quot;&#10;ELSEIF  [tag] = &quot;accounts&quot; and [status] = &quot;Lost&quot; then &quot;Other&quot;&#10;ELSEIF  [tag] = &quot;accounts&quot; and [status] = &quot;Active&quot; then &quot;Other&quot;&#10;else &quot;Open accounts&quot; end' />
            </column>
            <column caption='Feedback Received' datatype='string' name='[Pending Quote (copy)_1532772054259548175]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and lower([stagename]) in (&quot;feedback received&quot;,&#10;&quot;positive feedback&quot;) then id else null end' />
            </column>
            <column caption='Promo and Logistics Queue' datatype='string' name='[Please Check (copy)_1532772054260305938]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if tag = &quot;accounts&quot; and lower([stagename]) = (&quot;promo and logistics queue&quot;) and [is_dh_kitchen] &lt;&gt; &quot;true&quot;  then id else null end' />
            </column>
            <column caption='Editorial Queue' datatype='string' name='[Promo and Logistics Queue (copy)_1532772054260518932]' role='dimension' type='nominal'>
