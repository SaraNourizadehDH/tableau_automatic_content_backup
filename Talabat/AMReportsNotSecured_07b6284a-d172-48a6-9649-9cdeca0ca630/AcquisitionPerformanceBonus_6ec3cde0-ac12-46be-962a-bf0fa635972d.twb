                <alias key='&quot;om&quot;' value='OM' />
                <alias key='&quot;qa&quot;' value='QA' />
              </aliases>
            </column>
            <column-instance column='[Calculation_5405797313072865283]' derivation='CountD' name='[ctd:Calculation_5405797313072865283:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Open accounts status  (copy)_1131810937083924486]' derivation='CountD' name='[ctd:Open accounts status  (copy)_1131810937083924486:qk]' pivot='key' type='quantitative' />
