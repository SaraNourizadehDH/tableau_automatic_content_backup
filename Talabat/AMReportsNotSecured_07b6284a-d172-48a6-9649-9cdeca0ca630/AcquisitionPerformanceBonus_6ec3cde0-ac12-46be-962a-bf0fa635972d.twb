                <alias key='&quot;om&quot;' value='OM' />
                <alias key='&quot;qa&quot;' value='QA' />
              </aliases>
            </column>
            <column-instance column='[Calls logged yesterday (copy)_844284200646664194]' derivation='CountD' name='[ctd:Calls logged yesterday (copy)_844284200646664194:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_101401414238867471]' derivation='None' name='[none:Calculation_101401414238867471:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
