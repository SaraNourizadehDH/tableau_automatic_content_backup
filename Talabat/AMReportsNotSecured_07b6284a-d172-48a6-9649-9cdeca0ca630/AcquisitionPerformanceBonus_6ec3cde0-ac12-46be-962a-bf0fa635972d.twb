      <column caption='C Live vendors  ' datatype='string' name='[AB Live vendors  (copy)_2824882908779544580]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if tag = &quot;Live&quot; and lower([vendor_grade__c]) in (&quot;c&quot;) and IFNULL([Calculation_1131810937084305415],date(&quot;1999-09-01&quot;)) &lt;&gt; date(&quot;1999-09-01&quot;) AND  DATETRUNC(&apos;month&apos;,[Calculation_1131810937084305415]) = DATETRUNC(&apos;month&apos;,date([yesterday])) then [id] else  null end' />
      </column>
      <column caption='AB Vendors taken live' datatype='integer' name='[AB Productivity  (copy)_2824882908779311107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Vendors taken live MTD  (copy)_2824882908778008577])' />
