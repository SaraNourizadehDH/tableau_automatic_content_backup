    <worksheet name='TOTAL PRODUCTIVTY'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Tableau Light' fontsize='12'>Productivity by sales teams</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='acquisition_bonus' name='federated.18yjm090w2erea13jqkli0j9qfey' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.18yjm090w2erea13jqkli0j9qfey'>
            <column caption='Include in productivity ' datatype='string' name='[Calculation_6414392512305717248]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [sales_rep_validation] = 1 THEN &quot;True&quot; else &quot;False&quot; end' />
            </column>
            <column caption='# Vendors' datatype='integer' name='[Calculation_717690866528088064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([salesforce_id])' />
            </column>
            <column caption='# Sales Executives' datatype='integer' name='[Calculation_717690866559967235]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if  [Calculation_6414392512305717248] = &quot;False&quot; THEN [owner_name]&#10;else [rep_name] end )' />
            </column>
            <column caption='Productivity' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_717690866900967441]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_717690866528088064]/[Calculation_717690866559967235]' />
            </column>
            <column datatype='date' name='[close_date]' role='dimension' type='ordinal' />
            <column-instance column='[close_date]' derivation='MY' name='[my:close_date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_6414392512305717248]' derivation='None' name='[none:Calculation_6414392512305717248:nk]' pivot='key' type='nominal' />
            <column-instance column='[rep_country_code2]' derivation='None' name='[none:rep_country_code2:nk]' pivot='key' type='nominal' />
            <column-instance column='[rep_month]' derivation='None' name='[none:rep_month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[rep_type]' derivation='None' name='[none:rep_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[verticals]' derivation='None' name='[none:verticals:nk]' pivot='key' type='nominal' />
