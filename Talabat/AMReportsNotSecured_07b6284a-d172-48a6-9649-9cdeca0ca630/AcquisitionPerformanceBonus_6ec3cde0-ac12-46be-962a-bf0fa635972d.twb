            <groupfilter function='member' level='[none:Calculation_6414392512305717248:nk]' member='&quot;True&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.18yjm090w2erea13jqkli0j9qfey].[none:rep_country_code2:nk]' filter-group='12'>
            <groupfilter function='level-members' level='[none:rep_country_code2:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='relative-date' column='[federated.18yjm090w2erea13jqkli0j9qfey].[none:rep_month:qk]' first-period='-12' include-future='true' include-null='false' last-period='0' period-type-v2='month' />
          <filter class='categorical' column='[federated.18yjm090w2erea13jqkli0j9qfey].[none:verticals:nk]' filter-group='9'>
