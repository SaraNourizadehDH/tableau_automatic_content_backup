        <calculation class='tableau' formula='max(0)' />
      </column>
      <column aggregation='CountD' caption='Total Meetings MTD' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_132504359031689216]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tag] = &quot;Meetings&quot; &#10;     AND LOWER([meeting_type]) = &quot;meeting&quot; &#10;     AND DATETRUNC(&apos;month&apos;, [date]) = DATETRUNC(&apos;month&apos;, TODAY())&#10;  THEN [salesforce_id] &#10;  END' />
      </column>
      <column caption='Right Competitors' datatype='string' name='[Calculation_145100357984358400]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if lower(ifnull(competitor__c,&quot;null&quot;)) in (&apos;bakawi&apos;,&#10;&apos;baqalo&apos;,&#10;&apos;chatfood&apos;,&#10;&apos;zomato &apos;,&#10;&apos;whatson&apos;,&#10;&apos;timeout&apos;,&#10;&apos;trip advisor&apos;,&#10;&apos;roundmenu&apos;,&#10;&apos;akly&apos;,&#10;&apos;carts&apos;,&#10;&apos;zomato&apos;,&#10;&apos;v-thru&apos;,&#10;&apos;carriage&apos;,&#10;&apos;carriage&apos;,&#10;&apos;jeeran&apos;,&#10;&apos;brsima&apos;,&#10;&apos;akeed&apos;,&#10;&apos;daleel101&apos;,&#10;&apos;geeb&apos;,&#10;&apos;rouman.com&apos;,&#10;&apos;akelni&apos;,&#10;&apos;glovo&apos;,&#10;&apos;ubereats&apos;,&#10;&apos;uber eats&apos;,&#10;&apos;zomato;carriage&apos;,&#10;&apos;carriage;zomato&apos;,&#10;&apos;zomato;uber eats&apos;,&#10;&apos;akeed;daleel1010;geeb;rouman.com&apos;,&#10;&apos;zomato;ubereats&apos;,&#10;&apos;ubereats;trip advisor&apos;,&#10;&apos;uber eats;trip advisor&apos;,&#10;&apos;trip advisor;ubereats&apos;,&#10;&apos;trip advisor;roundmenu&apos;,&#10;&apos;akeed;geeb&apos;,&#10;&apos;trip advisor;uber eats&apos;,&#10;&apos;zomato&apos;,&#10;&apos;tastio&apos;,&apos;none&apos;,&#10;&apos;roundmenu;daleel1010&apos;,&#10;&apos;roundmenu;g;daleel1010&apos;,&#10;&apos;ubereats;roundmenu&apos;,&#10;&apos;none&apos;,&#10;&apos;none;timeout&apos;,&#10;&apos;none;chatfood&apos;,&#10;&apos;none;daleel1010&apos;,&#10;&apos;none;glovo&apos;,&#10;&apos;none;baqalo&apos;,&#10;&apos;none;akelni&apos;,&#10;&apos;g;daleel1010&apos;,&#10;&apos;akeed;daleel1010&apos;,&#10;&apos;null&apos;,&#10;&apos;daleel1010&apos;&#10;&#10;) then &quot;No&quot; else &quot;Yes&quot; end' />
      </column>
      <column caption='New leads (this month)' datatype='integer' name='[Calculation_1465147634081902592]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='COUNTD(if [tag] in (&quot;leads&quot;,&quot;accounts&quot;) &#10;and [status] in (&quot;Contacted&quot;,&quot;Long-term follow-up&quot;,&quot;New&quot;,&quot;Open&quot;)  &#10;and DATETRUNC(&apos;month&apos;,[Calculation_6414392512427786243]) = DATETRUNC(&apos;month&apos;,TODAY())&#10;then id  else null end)' />
      </column>
      <column caption='Backlog All Time ' datatype='integer' name='[Calculation_1465147634131853313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [tag] IN (&quot;leads&quot;, &quot;accounts&quot;) &#10;        AND [status] &lt;&gt; &quot;Active&quot;&#10;        AND [status] &lt;&gt; &quot;Lost&quot;&#10;        AND [status] &lt;&gt; &quot;Terminated&quot;&#10;        AND DATETRUNC(&apos;month&apos;, [Calculation_6414392512427786243]) &lt;&gt; DATETRUNC(&apos;month&apos;, TODAY())&#10;    THEN [id]&#10;    END&#10;)' />
      </column>
      <column caption='Backlog Universe' datatype='integer' name='[Calculation_1465147634165903364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ifnull([Backlog leads  All Time   (copy)_1465147634164641795],0) + ifnull([Backlog All Time  (copy)_1465147634163417090],0)' />
      </column>
      <column caption='Contact Established' datatype='string' name='[Calculation_1532772054134730753]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if (tag = &quot;accounts&quot; and lower([stagename]) = &quot;contact established&quot; ) or ( tag = &quot;leads&quot; and lower([status]) = &quot;contacted&quot; )&#10;then id else null end' />
