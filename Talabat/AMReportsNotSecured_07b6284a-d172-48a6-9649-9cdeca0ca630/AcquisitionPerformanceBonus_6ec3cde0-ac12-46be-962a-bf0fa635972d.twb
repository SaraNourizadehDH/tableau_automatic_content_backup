              <calculation class='tableau' formula='if [tag] = &quot;Live&quot; then [date] else null end' />
            </column>
            <column caption='reps' datatype='integer' name='[Calculation_6204341844596166657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if [validated_agent] = 1 then [opportunity_owner_name] end)' />
            </column>
            <column caption='Country target acquisitions' datatype='integer' name='[Calculation_6204341844596420610]' role='measure' type='quantitative'>
