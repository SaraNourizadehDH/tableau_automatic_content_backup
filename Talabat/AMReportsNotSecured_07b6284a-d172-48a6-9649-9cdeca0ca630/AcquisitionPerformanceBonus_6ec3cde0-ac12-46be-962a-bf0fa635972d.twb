            <column-instance column='[rep_month]' derivation='None' name='[none:rep_month:qk]' pivot='key' type='quantitative' />
            <column-instance column='[rep_type]' derivation='None' name='[none:rep_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[verticals]' derivation='None' name='[none:verticals:nk]' pivot='key' type='nominal' />
            <column caption='Owner Name' datatype='string' name='[owner_name]' role='dimension' type='nominal' />
            <column caption='country code' datatype='string' name='[rep_country_code2]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[rep_month]' role='dimension' type='ordinal' />
            <column datatype='string' name='[rep_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[rep_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;telesales&quot;' value='Telesales' />
              </aliases>
            </column>
            <column aggregation='Sum' caption='Include for productivity calculation' datatype='integer' name='[sales_rep_validation]' role='dimension' type='ordinal' />
            <column-instance column='[rep_month]' derivation='Month-Trunc' name='[tmn:rep_month:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_717690866901094418]' derivation='User' name='[usr:Calculation_717690866901094418:qk]' pivot='key' type='quantitative' />
            <column caption='Vendor Grade' datatype='string' name='[vendor_grade]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Vendor ID' datatype='integer' name='[vendor_id]' role='dimension' type='ordinal' />
            <column datatype='string' name='[verticals]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.18yjm090w2erea13jqkli0j9qfey].[my:close_date:ok]'>
            <groupfilter function='level-members' level='[my:close_date:ok]' />
