      <column caption='DF / Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[SF / Order (copy)_2183401440772251719]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(CASE    [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN [delivery_fees]&#13;&#10;WHEN &apos;EUR&apos;&#13;&#10;THEN &#13;&#10;CASE [Parameters].[Parameter 3]&#13;&#10;WHEN &apos;Daily Exchange Rate&apos;&#13;&#10;THEN&#13;&#10;[delivery_fee_amount_eur]&#13;&#10;WHEN &apos;Budget Exchange Rate&apos;&#13;&#10;THEN  [delivery_fees] * [Exchange Rate]&#13;&#10;END&#13;&#10;END)&#13;&#10;/&#13;&#10;SUM([all_orders_count])' />
