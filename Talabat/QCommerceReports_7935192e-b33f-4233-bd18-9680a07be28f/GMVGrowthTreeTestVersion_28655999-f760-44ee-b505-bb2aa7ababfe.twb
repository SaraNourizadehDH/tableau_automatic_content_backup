            <column caption='ABS' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[ABV (copy)_2183401440770273345]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([qty_sold])/SUM([all_orders_count])' />
            </column>
            <column caption='ABV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AOV (copy)_2183401440766472246]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([GMV (copy)_2183401440768077885])/SUM([all_orders_count])' />
