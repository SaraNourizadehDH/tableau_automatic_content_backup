            </column>
            <column caption='Availability' datatype='real' default-format='p0.00%' name='[Calculation_2317946479704920074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [gmv total stores (copy)_2183401440062439461] = 1&#13;&#10;THEN&#13;&#10;AVG({ FIXED [Calculation_2183401438381543426],[country_code],[warehouse_id]:MAX([availability])})&#13;&#10;ELSE&#13;&#10;AVG({ FIXED [Calculation_2183401438381543426],[country_code]:MAX([country_availability])})&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Availability Growth' datatype='real' default-format='p0.0%' name='[Calculation_2317946479705284620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2317946479704920074]-LOOKUP([Calculation_2317946479704920074],-1)) / LOOKUP([Calculation_2317946479704920074],-1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Month Filter 2' datatype='boolean' name='[Month Filter 2 (copy)_2183401438586765323]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF { FIXED [country_code]:MAX([Calculation_2183401438381543426])} = [Parameters].[Parameter 1] &#13;&#10;AND DAY({FIXED [country_code]:MAX([order_date])}) &lt; DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,{ FIXED [country_code]:MAX([Calculation_2183401438381543426])})))&#13;&#10;THEN &#13;&#10;DAY([order_date]) &lt;= DAY({FIXED [country_code]:MAX([order_date])})&#13;&#10;ELSE [order_date] = [order_date]&#13;&#10;END' />
            </column>
