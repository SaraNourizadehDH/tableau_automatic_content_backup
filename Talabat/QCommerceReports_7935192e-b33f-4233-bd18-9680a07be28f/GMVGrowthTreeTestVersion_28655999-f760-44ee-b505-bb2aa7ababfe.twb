            <column datatype='real' name='[availability]' role='measure' type='quantitative' />
            <column datatype='real' name='[country_availability]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Total Stores' datatype='integer' name='[gmv total stores (copy)_2183401440062439461]' role='measure' type='quantitative'>
