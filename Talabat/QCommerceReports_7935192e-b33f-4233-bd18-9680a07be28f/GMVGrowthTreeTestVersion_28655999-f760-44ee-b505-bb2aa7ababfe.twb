            <column caption='Daily AVG GMV' datatype='real' name='[GMV (copy)_2183401438593454095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2183401438593138702])/[Calculation_2183401438383423495]' />
            </column>
            <column caption='Daily AVG Budgeted GMV' datatype='real' name='[GMV (copy)_2183401438601568274]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN [Budgeted GMV (LC)]&#13;&#10;WHEN &apos;EUR&apos;&#13;&#10;THEN [Budgeted GMV (EUR)]&#13;&#10;END)&#13;&#10;&#13;&#10; / [Days in a Month (Filtered) (copy)_2183401438601338896]' />
