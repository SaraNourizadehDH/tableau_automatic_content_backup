    <worksheet name='Customers Components'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (Multiple Connections)' name='federated.0qcoqyd1s29wiw1awdiqv0d74i70' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0qcoqyd1s29wiw1awdiqv0d74i70].[Calculation_2183401438381543426]' caption='Selected Month' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2024-01-01#'>
              <calculation class='tableau' formula='#2024-01-01#' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;LC&quot;'>
              <calculation class='tableau' formula='&quot;LC&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qcoqyd1s29wiw1awdiqv0d74i70'>
            <column caption='Customers #' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[AOV (copy)_2183401440064831530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [gmv total stores (copy)_2183401440062439461] = 1&#13;&#10;THEN&#13;&#10;IF MAX({ FIXED [country_code]:MAX([Calculation_2183401438381543426])}) = [Parameters].[Parameter 1]&#13;&#10;THEN  SUM({ FIXED [Calculation_2183401438381543426],[country_code],[warehouse_id]:MAX([store_to_date_customers])})&#13;&#10;ELSE SUM({ FIXED [Calculation_2183401438381543426],[country_code],[warehouse_id]:MAX([store_monthly_customers])})&#13;&#10;END&#13;&#10;ELSE&#13;&#10;IF MAX({ FIXED [country_code]:MAX([Calculation_2183401438381543426])}) = [Parameters].[Parameter 1]&#13;&#10;THEN  SUM({ FIXED [Calculation_2183401438381543426],[country_code]:MAX([to_date_customers])})&#13;&#10;ELSE SUM({ FIXED [Calculation_2183401438381543426],[country_code]:MAX([monthly_customers])})&#13;&#10;END&#13;&#10;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Order Month' datatype='date' default-format='*mmmm, yyyy' name='[Calculation_2183401438381543426]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[order_date]))' />
            </column>
            <column caption='Days in a Month (Filtered)' datatype='real' name='[Calculation_2183401438383423495]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DAY(MAX({FIXED [country_code]:MAX([order_date])})) = 31 &#13;&#10;THEN&#13;&#10;AVG(DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,[Calculation_2183401438381543426]))))&#13;&#10;ELSE&#13;&#10;IF MAX({FIXED [country_code]:MAX([Calculation_2183401438381543426])}) = MAX([Parameters].[Parameter 1])&#13;&#10;THEN AVG(DAY({FIXED [country_code]:MAX([order_date])}))&#13;&#10;ELSE&#13;&#10;AVG(DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,[Calculation_2183401438381543426]))))&#13;&#10;END&#13;&#10;END' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_2183401438593138702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN [gmv_lc]&#13;&#10;WHEN &apos;EUR&apos;&#13;&#10;THEN [gmv_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='AOV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2183401438616993821]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2183401438593138702])/SUM([all_orders_count])' />
            </column>
            <column caption='CVR' datatype='real' default-format='p0.0%' name='[Calculation_2317946479658127362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([placed_order_session_count]) / SUM([viewed_menu_session_count])' />
            </column>
            <column caption='Daily AVG Sessions' datatype='real' name='[Daily AVG Orders (copy 2)_2317946479699353609]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([viewed_menu_session_count])/[Calculation_2183401438383423495]' />
            </column>
            <column caption='Month Filter 2' datatype='boolean' name='[Month Filter 2 (copy)_2183401438586765323]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF { FIXED [country_code]:MAX([Calculation_2183401438381543426])} = [Parameters].[Parameter 1] &#13;&#10;AND DAY({FIXED [country_code]:MAX([order_date])}) &lt; DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,{ FIXED [country_code]:MAX([Calculation_2183401438381543426])})))&#13;&#10;THEN &#13;&#10;DAY([order_date]) &lt;= DAY({FIXED [country_code]:MAX([order_date])})&#13;&#10;ELSE [order_date] = [order_date]&#13;&#10;END' />
            </column>
            <column caption='Orders #' datatype='integer' name='[all_orders_count]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Total Stores' datatype='integer' name='[gmv total stores (copy)_2183401440062439461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='TOTAL(COUNTD([warehouse_id]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='real' name='[gmv_amount_eur]' role='measure' type='quantitative' />
            <column datatype='real' name='[gmv_lc]' role='measure' type='quantitative' />
            <column datatype='integer' name='[monthly_customers]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2183401438381543426]' derivation='None' name='[none:Calculation_2183401438381543426:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Month Filter 2 (copy)_2183401438586765323]' derivation='None' name='[none:Month Filter 2 (copy)_2183401438586765323:nk]' pivot='key' type='nominal' />
            <column-instance column='[country_code]' derivation='None' name='[none:country_code:nk]' pivot='key' type='nominal' />
            <column-instance column='[vertical]' derivation='None' name='[none:vertical:nk]' pivot='key' type='nominal' />
            <column-instance column='[warehouse_name]' derivation='None' name='[none:warehouse_name:nk]' pivot='key' type='nominal' />
            <column datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[placed_order_session_count]' role='measure' type='quantitative' />
            <column datatype='integer' name='[store_monthly_customers]' role='measure' type='quantitative' />
            <column datatype='integer' name='[store_to_date_customers]' role='measure' type='quantitative' />
