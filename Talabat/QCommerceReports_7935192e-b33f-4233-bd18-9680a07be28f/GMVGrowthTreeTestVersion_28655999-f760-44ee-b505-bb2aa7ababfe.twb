          </named-connection>
        </named-connections>
        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='cloudfile:googledrive-excel-direct.1fcvtzb03mer4w17bp05t0n2kg4e' name='Budgets by market' table='[&apos;Budgets by market$&apos;]' type='table'>
          <columns gridOrigin='A1:AB120:no:A1:AB120:0' header='yes' outcome='2'>
            <column datatype='string' name='vertical' ordinal='0' />
            <column datatype='date' name='Date' ordinal='1' />
            <column datatype='string' name='Country Iso' ordinal='2' />
            <column datatype='real' name='Budgeted Orders' ordinal='3' />
            <column datatype='real' name='Budgeted GMV (LC)' ordinal='4' />
            <column datatype='real' name='Budgeted DF Revenue (LC)' ordinal='5' />
            <column datatype='real' name='Budgeted SF Revenue (LC)' ordinal='6' />
            <column datatype='real' name='Budgeted DF+SF Revenue (LC)' ordinal='7' />
            <column datatype='real' name='Budgeted GFV (LC)' ordinal='8' />
            <column datatype='real' name='Budgeted ABV (LC)' ordinal='9' />
            <column datatype='real' name='Budgeted AOV (LC)' ordinal='10' />
            <column datatype='real' name='Budgeted DF/Order (LC)' ordinal='11' />
            <column datatype='real' name='Budgeted SF/Order (LC)' ordinal='12' />
            <column datatype='real' name='Budgeted AEF (LC)' ordinal='13' />
            <column datatype='integer' name='Budgeted GMV (EUR)' ordinal='14' />
            <column datatype='integer' name='Budgeted GFV (EUR)' ordinal='15' />
            <column datatype='string' name='Budgeted AOV (EUR)' ordinal='16' />
            <column datatype='string' name='Budgeted ABV (EUR)' ordinal='17' />
            <column datatype='integer' name='Budgeted DF Revenue (EUR)' ordinal='18' />
            <column datatype='integer' name='Budgeted SF Revenue (EUR)' ordinal='19' />
            <column datatype='integer' name='Budgeted DF+SF Revenue (EUR)' ordinal='20' />
            <column datatype='real' name='Budgeted DF/Order (EUR)' ordinal='21' />
            <column datatype='real' name='Budgeted SF/Order (EUR)' ordinal='22' />
            <column datatype='real' name='Budgeted AEF (EUR)' ordinal='23' />
            <column datatype='real' name='F25' ordinal='24' />
            <column datatype='real' name='F26' ordinal='25' />
            <column datatype='real' name='F27' ordinal='26' />
            <column datatype='string' name='Avg price/Item (EUR)' ordinal='27' />
          </columns>
        </_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.1mo2gjy1pbd24m11k6fg20z75uco' name='Custom SQL Query' type='text'><![CDATA[WITH


  conversion as (
    
  SELECT 
  country_code,
  CASE WHEN is_non_food AND is_darkstore = false THEN 'LS' ELSE v.vendor_warehouse_id END AS warehouse_id,
  date,
sum(viewed_menu_session_count) as viewed_menu_session_count ,
sum(added_to_cart_session_count) as added_to_cart_session_count,
sum(started_checkout_session_count) as started_checkout_session_count,
sum(placed_order_session_count) as placed_order_session_count,

 FROM `tlb-data-prod.data_platform.agg_vendor_conversion_funnel_daily`  c

 left join `tlb-data-prod.data_platform.dim_country_info` dci
  on dci.country=case when c.country ='UAE' then 'United Arab Emirates' else c.country end

left join `tlb-data-prod.data_platform.dim_vendor_info` v USING (vendor_id)

 WHERE
  date >>= '2022-01-01'      
 AND date <<>> current_date
 AND is_non_food
group by 1,2,3
),

  raw_data AS(
  SELECT
  order_date,
  order_id,
  order_status_id,
  country_code,
  CASE WHEN vendor.is_non_food AND vendor.is_darkstore = false THEN 'LS' 
  WHEN vendor.is_darkstore THEN 'tmart' END AS vertical,
  CASE WHEN vendor.is_non_food AND vendor.is_darkstore = false THEN 'LS' ELSE vendor_warehouse_id END AS warehouse_id,
  CASE WHEN vendor.is_non_food AND vendor.is_darkstore = false THEN 'LS' ELSE vendor_warehouse_name END AS warehouse_name,
  is_tpro_order,
  is_acquisition,
  analytical_customer_id,
  is_successful,
  foi.is_darkstore,
  is_darkstore_acquisition,
  is_nfv_acquisition,
  delivery_fee_amount_lc,
  service_fee_amount_lc,
  incentive_amount_lc,
  gmv_amount_lc,
  delivery_fee_amount_eur,
  service_fee_amount_eur,
  incentive_amount_eur,
  gmv_amount_eur

  FROM `tlb-data-prod.data_platform.fct_order_info` foi

  LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` AS vendor
      ON vendor.source_system_vendor_id = foi.vendor_id

  WHERE
  foi.order_date >>= '2023-01-01'
  AND vendor.is_non_food
  ),

  tmart AS(
  SELECT *
  FROM raw_data
    
  ),

    store_monthly_customers AS(
  SELECT
  DATE_TRUNC(order_date,month) AS month,
  country_code,
  tmart.warehouse_id,
  COUNT(DISTINCT analytical_customer_id) AS store_monthly_customers

  FROM tmart

  WHERE
  is_successful
  GROUP BY 1,2,3

  ),

  monthly_customers AS(
  SELECT
  DATE_TRUNC(order_date,month) AS month,
  country_code,
  COUNT(DISTINCT analytical_customer_id) AS monthly_customers

  FROM tmart

  WHERE
  is_successful
  GROUP BY 1,2

  ),

  to_date_customers AS(
  SELECT
  DATE_TRUNC(order_date,month) AS month,
  country_code,
  COUNT(DISTINCT analytical_customer_id) AS to_date_customers

  FROM tmart

  WHERE
  EXTRACT(day FROM order_date) << EXTRACT(day FROM CURRENT_DATE() )
  AND is_successful

  GROUP BY 1,2

  ),

    store_to_date_customers AS(
  SELECT
  DATE_TRUNC(order_date,month) AS month,
  country_code,
  tmart.warehouse_id,
  COUNT(DISTINCT analytical_customer_id) AS store_to_date_customers

  FROM tmart

  WHERE
  EXTRACT(day FROM order_date) << EXTRACT(day FROM CURRENT_DATE() )
  AND is_successful

  GROUP BY 1,2,3

  ),

  sales AS(
  SELECT
  tmart.order_date,
  tmart.country_code,
  tmart.vertical,
  tmart.warehouse_id ,
  tmart.warehouse_name,
  COUNT(DISTINCT( tmart.order_id )) as all_orders_count,
  COUNT(DISTINCT CASE WHEN is_tpro_order THEN tmart.order_id END) AS tpro_orders,
  COUNT(DISTINCT  tmart.analytical_customer_id ) AS customers_count,
  SUM( sales_inc_vat ) AS sales_inc_vat,
  SUM( sales_exc_vat ) AS sales_exc_vat,
  SUM( cogs_lc )  COGS,
  SUM( total_discount_amount_lc ) AS total_discount_amount_lc,
  SUM( qty_sold ) AS qty_sold,
  SUM( promo_sales ) AS promo_sales,
  SUM( net_Promo_Sales ) AS net_Promo_Sales,
  SUM( promo_cogs ) AS promo_cogs,
  SUM( promo_orders ) AS promo_orders,

  SUM(sales_inc_vat_eur) AS sales_inc_vat_eur,
  SUM(sales_exc_vat_eur) AS sales_exc_vat_eur,
  SUM(cogs_eur) AS cogs_eur,
  SUM(promo_sales_eur) AS promo_sales_eur,
  SUM(net_Promo_Sales_eur) AS net_Promo_Sales_eur,
  SUM(promo_cogs_eur) AS promo_cogs_eur,
  SUM(total_discount_amount_eur_eur) AS total_discount_amount_eur,
  SUM(promoted_items_original_price) AS promoted_items_original_price,
  SUM(promoted_items_original_price_eur) AS promoted_items_original_price_eur,

  SUM( picking_time_s / 60 ) as picking_time_m,
  SUM( actual_delivery_time/60 ) AS delivery_time_m,
  SUM( delivery_fee_amount_lc ) AS delivery_fees,
  SUM( tmart.service_fee_amount_lc  ) AS service_fee,
  SUM( gmv_amount_lc) AS gmv_lc,

  SUM( delivery_fee_amount_eur) AS delivery_fee_amount_eur,
  SUM( service_fee_amount_eur) AS service_fee_amount_eur,
  SUM( incentive_amount_eur) AS incentive_amount_eur,
  SUM( gmv_amount_eur) AS gmv_amount_eur,

  COUNT(DISTINCT(CASE WHEN applied_incentives_agg LIKE ('%Incentivized%') THEN tmart.order_id ELSE NULL END)) AS voucher_orders,
  SUM(CASE WHEN  applied_incentives_agg LIKE ('%Incentivized%') THEN vouchers_value ELSE NULL END) AS vouchers_value,
    SUM(CASE WHEN  applied_incentives_agg LIKE ('%Incentivized%')  THEN vouchers_value_eur ELSE NULL END) AS vouchers_value_eur,

  COUNT(DISTINCT(CASE WHEN is_darkstore_acquisition OR is_nfv_acquisition THEN tmart.analytical_customer_id ELSE NULL END)) AS chain_acquisitions,
  COUNT(DISTINCT(CASE WHEN  is_acquisition  THEN tmart.analytical_customer_id ELSE NULL END)) AS platform_acquisitions,

  FROM tmart tmart
  
  LEFT JOIN `tlb-data-prod.data_platform.fct_logistics_order` AS lo
  ON lo.order_id = tmart.order_id
  AND lo.is_talabat AND lo.is_rider_order
  AND lo.created_date >>= '2023-01-01'


  LEFT JOIN
  (
  SELECT
    order_id,
    order_date,
    SUM(order_item_price_lc * sold_quantity) AS sales_inc_vat,
    SUM(total_price_paid_net_lc) AS sales_exc_vat,
    SUM(cogs_lc) AS cogs_lc,
    SUM(sold_quantity) AS qty_sold,
    SUM(CASE WHEN item_discount_lc >> 0 THEN order_item_price_lc * sold_quantity ELSE 0 END) AS promo_sales,
    SUM(CASE WHEN item_discount_lc >> 0 THEN total_price_paid_net_lc ELSE 0 END) AS net_Promo_Sales,
    SUM(CASE WHEN item_discount_lc >> 0 THEN cogs_lc ELSE 0 END) AS promo_cogs,
    COUNT(DISTINCT(CASE WHEN item_discount_lc >> 0 THEN order_id ELSE NULL END)) AS promo_orders,
    SUM(item_discount_lc) AS total_discount_amount_lc,

    SUM(order_item_price_eur * sold_quantity) AS sales_inc_vat_eur,
    SUM(total_price_paid_net_eur) AS sales_exc_vat_eur,
    SUM(cogs_eur) AS cogs_eur,
    SUM(CASE WHEN item_discount_eur >> 0 THEN order_item_price_eur * sold_quantity ELSE 0 END) AS promo_sales_eur,
    SUM(CASE WHEN item_discount_eur >> 0 THEN total_price_paid_net_eur ELSE 0 END) AS net_Promo_Sales_eur,
    SUM(CASE WHEN item_discount_eur >> 0 THEN cogs_eur ELSE 0 END) AS promo_cogs_eur,
    SUM(item_discount_eur) AS total_discount_amount_eur_eur,
    SUM(CASE WHEN item_discount_lc >> 0 THEN original_item_price_lc*sold_quantity END) AS promoted_items_original_price,
     SUM(CASE WHEN item_discount_lc >> 0 THEN original_item_price_eur*sold_quantity END) AS promoted_items_original_price_eur,


  FROM `tlb-data-prod.data_platform.fct_order_item`


  WHERE
  order_date >>= '2023-01-01'


  GROUP BY 1,2


  ) fi
        ON fi.order_id = tmart.order_id and fi.order_date = tmart.order_date


  LEFT JOIN (
  SELECT
  order_id,
  STRING_AGG(distinct incentive_sub_type ORDER BY incentive_sub_type) AS applied_incentives,
  STRING_AGG(distinct incentive_sub_type_agg ORDER BY incentive_sub_type_agg) AS applied_incentives_agg,
  SUM(vouchers_value) AS vouchers_value,
  SUM(vouchers_value_eur) AS vouchers_value_eur,
  SUM(compensation_vouchers_value) AS compensation_vouchers_value,




  FROM(
  SELECT
  order_id,
  incentive_sub_type,
  case
  when incentive_sub_type IN ('voucher wallet','compensation','gem','free delivery','discounted delivery') then 'Incentivized'
  else 'Non-Incentivize'
  end as incentive_sub_type_agg,
  CASE WHEN incentive_sub_type IN('voucher wallet','compensation','gem','free delivery','discounted delivery') THEN incentive_amount_lc END as vouchers_value,
  CASE WHEN incentive_sub_type IN('voucher wallet','compensation','gem','free delivery','discounted delivery') THEN incentive_amount_eur END as vouchers_value_eur,
  CASE WHEN incentive_sub_type = 'compensation' THEN incentive_amount_lc END as compensation_vouchers_value,


  FROM `tlb-data-prod.data_platform.fct_incentive_order_detail` a
  WHERE order_date  >>= "2023-01-01"
  )
  GROUP BY
  1
  ) vo ON tmart.order_id = SAFE_CAST(vo.order_id AS INT64)


  LEFT JOIN
  (
  SELECT
    DISTINCT order_id_dwh,
    global_entity_id,
    p.rooster_employee_id,
    picking_time_s,


    FROM `fulfillment-dwh-production.curated_data_shared_dmart.picker` p,
    UNNEST(orders) o
  
  WHERE global_entity_id <<>> 'HS_SA'
  ) p
  ON p.order_id_dwh = CAST(tmart.order_id AS STRING)
  AND RIGHT(p.global_entity_id,2) = tmart.country_code


  WHERE
  tmart.is_successful






  GROUP BY 1,2,3,4,5


  ),


  failed_orders AS(
  SELECT
  order_date,
  country_code,
  warehouse_id,
  COUNT(DISTINCT(CASE WHEN is_successful = FALSE AND is_net = TRUE THEN tmart.order_id END)) AS failed_orders,
  COUNT(DISTINCT(CASE WHEN is_net = TRUE then tmart.order_id END)) failed_orders_divisor,


  FROM tmart


  LEFT JOIN `tlb-data-prod.data_platform.dim_order_status` s
  ON
    tmart.order_status_id =  s.order_status_id


  GROUP BY 1,2,3
  ),

      availability AS(SELECT avail.warehouse_id,
              avail.stock_date,
              avail.percent_hours_available_full_day AS availability_perc,
              avail.country_code,
              avail.sku,
              status,
              CASE WHEN is_stale_day THEN FALSE ELSE TRUE END AS is_stale_filter
        FROM `tlb-data-prod.data_platform.agg_grocery_stock_availability` avail
        LEFT JOIN `fulfillment-dwh-production.curated_data_shared_dmart.warehouses` w ON w.warehouse_id = avail.warehouse_id
        WHERE 1=1
          AND stock_date >>= date_add(date_trunc(CURRENT_DATE,MONTH), interval -11 MONTH)
          AND store_type = 'darkstores'
          AND lower(avail.brand_name) <<>> 'comboproduct brand'
          AND avail.warehouse_name NOT IN ('EG_DC_store',
                                          'Iraq_EBL_DS1',
                                          'Iraq_Erbil_DS900',
                                          'Iraq_EBL_DS3',
                                          'Darkstore - Salmiya2',
                                          'Oman_Sur_DS_9',
                                          'Oman_Buraimi_DS_8',
                                          'Oman_Barka_DS_6',
                                          'QLS -VS 3PL , 23-05-2023',
                                          'UAE_AD_01',
                                          'UAE_Dubai_DS_12 - JLT',
                                          'UAE_Dubai_DS_30 -International City',
                                          'UAE_Dubai_DS_31 -Dubai Expo',
                                          'UAE_FC_DC_01')),


      availability_agg AS
    (SELECT stock_date,
            country_code,
            warehouse_id,
            AVG(availability_perc) AS availability
    FROM    availability                                 
    WHERE 1=1
      AND status IN ('ACTIVE',
                      'BLOCKED',
                      'ON_HOLD')
      AND is_stale_filter = TRUE
    GROUP BY 1,
              2,
              3),

              
      country_availability_agg AS
    (SELECT stock_date,
            country_code,
            AVG(availability_perc) AS country_availability
    FROM    availability                                 
    WHERE 1=1
      AND status IN ('ACTIVE',
                      'BLOCKED',
                      'ON_HOLD')
      AND is_stale_filter = TRUE
    GROUP BY 1,
              2)




  SELECT
  sales.order_date,
  sales.country_code,
  vertical,
  sales.warehouse_id,
  sales.warehouse_name,
  all_orders_count,
  tpro_orders,
  chain_Acquisitions,
  platform_acquisitions,
  customers_count,
  sales_inc_vat,
  sales_exc_vat,
  cogs,
  qty_sold,
  total_discount_amount_lc,
  service_fee,
  gmv_lc,
  promo_sales,
  net_promo_sales,
  promoted_items_original_price,
  promoted_items_original_price_eur,
  promo_cogs,
  promo_orders,
  failed_orders,
  failed_orders_divisor,
  voucher_orders,
  vouchers_value,
  vouchers_value_eur,
  picking_time_m,
  delivery_time_m,
  delivery_fees,
viewed_menu_session_count ,
added_to_cart_session_count,
started_checkout_session_count,
placed_order_session_count,
  availability,
  country_availability,

  monthly_customers,
  to_date_customers,

  sm.store_monthly_customers,
  std.store_to_date_customers,


  sales_inc_vat_eur,
  sales_exc_vat_eur,
  cogs_eur,
  promo_sales_eur,
  net_Promo_Sales_eur,
  promo_cogs_eur,
  total_discount_amount_eur,
  delivery_fee_amount_eur,
  service_fee_amount_eur,
  incentive_amount_eur,
  gmv_amount_eur


  FROM sales


  left join conversion
      on conversion.warehouse_id = sales.warehouse_id
      AND conversion.date = sales.order_date
      AND conversion.country_code = sales.country_code


  left join failed_orders f
  ON sales.order_date = f.order_date
  AND sales.warehouse_id = f.warehouse_id
  AND sales.country_code = f.country_code

  LEFT JOIN availability_agg av
  ON av.stock_date = f.order_date
  AND av.warehouse_id = f.warehouse_id
  AND av.country_code = f.country_code

  LEFT JOIN country_availability_agg ca
  ON ca.stock_date = f.order_date
  AND ca.country_code = f.country_code

  LEFT JOIN monthly_customers mc
  ON DATE_TRUNC(sales.order_date,month) = mc.month
  AND sales.country_code = mc.country_code 

  LEFT JOIN to_date_customers tdc
  ON DATE_TRUNC(sales.order_date,month) = tdc.month
  AND sales.country_code = tdc.country_code

  
  LEFT JOIN store_monthly_customers sm
  ON DATE_TRUNC(sales.order_date,month) = sm.month
  AND sales.country_code = sm.country_code 
  AND sales.warehouse_id = sm.warehouse_id

  LEFT JOIN store_to_date_customers std
  ON DATE_TRUNC(sales.order_date,month) = std.month
  AND sales.country_code = std.country_code
  AND sales.warehouse_id = std.warehouse_id]]></relation>
