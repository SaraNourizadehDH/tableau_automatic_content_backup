            </column>
            <column caption='KPI' datatype='real' name='[Calculation_2317946480100872250]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 5]&#13;&#10;WHEN &apos;GMV&apos; THEN [GMV (copy)_2183401438593454095]&#13;&#10;WHEN &apos;Orders&apos; THEN [Daily AVG GMV (copy)_2183401438614847511]&#13;&#10;WHEN &apos;Customers&apos; THEN [Calculation_2317946480137519166]&#13;&#10;WHEN &apos;New Customers&apos; THEN [Daily AVG Customers (copy)_2183401440069894194]&#13;&#10;WHEN &apos;Existing Customers&apos; THEN [Existing Customers (copy)_2183401440071221300]&#13;&#10;WHEN &apos;Sessions&apos; THEN [Daily AVG Orders (copy 2)_2317946479699353609]&#13;&#10;WHEN &apos;CVR&apos; THEN [Calculation_2317946479658127362]*100&#13;&#10;WHEN &apos;AOV&apos; THEN [Calculation_2183401438616993821]&#13;&#10;WHEN &apos;Frequency&apos; THEN [Frequency (copy)_2317946480146550849]&#13;&#10;WHEN &apos;ABV&apos; THEN [AOV (copy)_2183401440766472246]&#13;&#10;WHEN &apos;ABS&apos; THEN [ABV (copy)_2183401440770273345]&#13;&#10;WHEN &apos;AVG Price / Item&apos; THEN [ABS (copy)_2183401440770568258]&#13;&#10;WHEN &apos;EF&apos; THEN [ABV (copy)_2183401440767508537]&#13;&#10;WHEN &apos;Incentives Value / Order&apos; THEN [ABV (copy)_2183401440770023488]&#13;&#10;WHEN &apos;Incentives as % of GMV&apos; THEN [Incentivized Orders (copy)_2317946479697977352]*100&#13;&#10;WHEN &apos;Availability&apos; THEN AVG([availability])*100&#13;&#10;WHEN &apos;Promo Sales Cont.&apos; THEN [Calculation_2317946479705624590]*100&#13;&#10;WHEN &apos;AVG Promo Discount %&apos; THEN [Calculation_2317946479718354961]*100&#13;&#10;WHEN &apos;Mcvr3&apos; THEN [CVR (copy)_2317946479658524675]*100&#13;&#10;WHEN &apos;Mcvr4&apos; THEN [Mcvr3 (copy)_2317946479658758148]*100&#13;&#10;WHEN &apos;Mcvr3-a&apos; THEN [Mcvr3 (copy)_2317946479667527685]*100&#13;&#10;WHEN &apos;Mcvr3-b&apos; THEN [Mcvr3-a (copy)_2317946479667798022]*100&#13;&#10;WHEN &apos;DF&apos; THEN [SF / Order (copy)_2183401440772251719]&#13;&#10;WHEN &apos;SF&apos; THEN [AOV (copy)_2183401440771608644]&#13;&#10;&#13;&#10;&#13;&#10;END'>
