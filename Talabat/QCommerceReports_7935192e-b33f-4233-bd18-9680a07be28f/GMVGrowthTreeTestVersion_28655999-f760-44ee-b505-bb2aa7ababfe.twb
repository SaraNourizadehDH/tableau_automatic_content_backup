            <column caption='GMV VS Budget' datatype='real' default-format='*▲ 0.00%; ▼ -0.00%; -' name='[Daily AVG GMV (copy)_2183401438601494545]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [gmv total stores (copy)_2183401440062439461] = 1  AND ATTR([vertical]) &lt;&gt; &apos;LS&apos;&#13;&#10;THEN&#13;&#10;0&#13;&#10;ELSE&#13;&#10;([GMV (copy)_2183401438593454095]-[GMV (copy)_2183401438601568274]) / [GMV (copy)_2183401438601568274]&#13;&#10;END'>
