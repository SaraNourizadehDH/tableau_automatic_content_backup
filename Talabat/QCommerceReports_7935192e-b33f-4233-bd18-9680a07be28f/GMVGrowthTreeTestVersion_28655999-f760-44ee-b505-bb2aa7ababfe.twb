      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (Multiple Connections)' name='federated.0qcoqyd1s29wiw1awdiqv0d74i70' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0qcoqyd1s29wiw1awdiqv0d74i70].[Calculation_2183401438381543426]' caption='Selected Month' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2024-01-01#'>
              <calculation class='tableau' formula='#2024-01-01#' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;LC&quot;'>
              <calculation class='tableau' formula='&quot;LC&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qcoqyd1s29wiw1awdiqv0d74i70'>
            <column caption='Order Month' datatype='date' default-format='*mmmm, yyyy' name='[Calculation_2183401438381543426]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[order_date]))' />
            </column>
            <column caption='Days in a Month (Filtered)' datatype='real' name='[Calculation_2183401438383423495]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF DAY(MAX({FIXED [country_code]:MAX([order_date])})) = 31 &#13;&#10;THEN&#13;&#10;AVG(DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,[Calculation_2183401438381543426]))))&#13;&#10;ELSE&#13;&#10;IF MAX({FIXED [country_code]:MAX([Calculation_2183401438381543426])}) = MAX([Parameters].[Parameter 1])&#13;&#10;THEN AVG(DAY({FIXED [country_code]:MAX([order_date])}))&#13;&#10;ELSE&#13;&#10;AVG(DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,[Calculation_2183401438381543426]))))&#13;&#10;END&#13;&#10;END' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_2183401438593138702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN [gmv_lc]&#13;&#10;WHEN &apos;EUR&apos;&#13;&#10;THEN [gmv_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='AOV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2183401438616993821]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2183401438593138702])/SUM([all_orders_count])' />
            </column>
            <column caption='Daily AVG Orders' datatype='real' name='[Daily AVG GMV (copy)_2183401438614847511]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([all_orders_count])/[Calculation_2183401438383423495]' />
            </column>
            <column caption='Daily AVG GMV' datatype='real' name='[GMV (copy)_2183401438593454095]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2183401438593138702])/[Calculation_2183401438383423495]' />
            </column>
            <column caption='GMV Prev. Color Coding' datatype='string' name='[GMV Color Coding (copy)_2317946479725182995]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [GMV (copy)_2183401438593454095] &lt; LOOKUP([GMV (copy)_2183401438593454095],-1)&#13;&#10;THEN &apos;Red&apos;&#13;&#10;ELSE &apos;Green&apos;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Orders Prev. Color Coding' datatype='string' name='[GMV Prev. Color Coding (copy)_2317946479975133228]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Daily AVG GMV (copy)_2183401438614847511] &lt; LOOKUP([Daily AVG GMV (copy)_2183401438614847511],-1)&#13;&#10;THEN &apos;Red&apos;&#13;&#10;ELSE &apos;Green&apos;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='AOV Prev. Color Coding' datatype='string' name='[GMV Prev. Color Coding (copy)_2317946479998214190]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2183401438616993821] &lt; LOOKUP([Calculation_2183401438616993821],-1)&#13;&#10;THEN &apos;Red&apos;&#13;&#10;ELSE &apos;Green&apos;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Month Filter 2' datatype='boolean' name='[Month Filter 2 (copy)_2183401438586765323]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF { FIXED [country_code]:MAX([Calculation_2183401438381543426])} = [Parameters].[Parameter 1] &#13;&#10;AND DAY({FIXED [country_code]:MAX([order_date])}) &lt; DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,{ FIXED [country_code]:MAX([Calculation_2183401438381543426])})))&#13;&#10;THEN &#13;&#10;DAY([order_date]) &lt;= DAY({FIXED [country_code]:MAX([order_date])})&#13;&#10;ELSE [order_date] = [order_date]&#13;&#10;END' />
            </column>
            <column caption='Orders #' datatype='integer' name='[all_orders_count]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
