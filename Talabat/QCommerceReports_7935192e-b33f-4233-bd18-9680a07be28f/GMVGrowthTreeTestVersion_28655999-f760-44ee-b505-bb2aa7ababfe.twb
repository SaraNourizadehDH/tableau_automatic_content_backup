    <datasource caption='Custom SQL Query+ (Multiple Connections)' inline='true' name='federated.0qcoqyd1s29wiw1awdiqv0d74i70' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1mo2gjy1pbd24m11k6fg20z75uco'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform_dmart' server-oauth='' username='eyad.elkhateeb@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
          <named-connection caption='tMart - Performance Framework' name='cloudfile:googledrive-excel-direct.1fcvtzb03mer4w17bp05t0n2kg4e'>
