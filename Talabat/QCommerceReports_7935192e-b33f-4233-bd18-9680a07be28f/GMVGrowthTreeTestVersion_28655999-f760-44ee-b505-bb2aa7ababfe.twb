            <column-instance column='[AOV (copy)_2183401440064831530]' derivation='User' name='[usr:AOV (copy)_2183401440064831530:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.0qcoqyd1s29wiw1awdiqv0d74i70].[gmv total stores (copy)_2183401440062439461]' ordering-type='Rows' />
