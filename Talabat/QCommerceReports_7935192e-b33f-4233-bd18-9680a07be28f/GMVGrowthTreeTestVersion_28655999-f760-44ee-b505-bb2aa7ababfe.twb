              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[order_date]))' />
            </column>
            <column caption='GMV' datatype='real' name='[Calculation_2183401438593138702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN [gmv_lc]&#13;&#10;WHEN &apos;EUR&apos;&#13;&#10;THEN [gmv_amount_eur]&#13;&#10;END' />
            </column>
            <column caption='AOV' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2183401438616993821]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2183401438593138702])/SUM([all_orders_count])' />
            </column>
            <column caption='Frequency' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2183401440067850288]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([all_orders_count]) / [AOV (copy)_2183401440064831530]'>
