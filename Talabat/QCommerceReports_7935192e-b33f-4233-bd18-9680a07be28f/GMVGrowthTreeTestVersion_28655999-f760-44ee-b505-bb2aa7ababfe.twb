      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query+ (Multiple Connections)' name='federated.0qcoqyd1s29wiw1awdiqv0d74i70' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column _.fcp.ParameterDefaultValues.true...source-field='[federated.0qcoqyd1s29wiw1awdiqv0d74i70].[Calculation_2183401438381543426]' caption='Selected Month' datatype='date' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='#2024-01-01#'>
              <calculation class='tableau' formula='#2024-01-01#' />
            </column>
            <column caption='Currency' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;LC&quot;'>
              <calculation class='tableau' formula='&quot;LC&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qcoqyd1s29wiw1awdiqv0d74i70'>
            <column caption='SF / Order' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[AOV (copy)_2183401440771608644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE    [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN [service_fee]&#13;&#10;WHEN &apos;EUR&apos;&#13;&#10;THEN [service_fee_amount_eur]&#13;&#10;END)&#13;&#10;/&#13;&#10;SUM([all_orders_count])' />
            </column>
            <column caption='SF VS Budget' datatype='real' default-format='*▲ 0.00%; ▼ -0.00%; -' name='[AOV VS Budget (copy)_2183401440771891269]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [gmv total stores (copy)_2183401440062439461] = 1  AND ATTR([vertical]) &lt;&gt; &apos;LS&apos;&#13;&#10;THEN&#13;&#10;0&#13;&#10;ELSE([AOV (copy)_2183401440771608644]-[Budgeted AOV (copy)_2183401440771321923]) / [Budgeted AOV (copy)_2183401440771321923]&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Budgeted SF / Order' datatype='real' name='[Budgeted AOV (copy)_2183401440771321923]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &apos;LC&apos;&#13;&#10;THEN [Budgeted SF Revenue (LC)]&#13;&#10;WHEN &apos;EUR&apos;&#13;&#10;THEN [Budgeted SF Revenue (EUR)]&#13;&#10;END)&#13;&#10;/ &#13;&#10;SUM([Budgeted Orders])' />
            </column>
            <column datatype='real' name='[Budgeted Orders]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Budgeted SF Revenue (EUR)]' role='measure' type='quantitative' />
            <column datatype='real' name='[Budgeted SF Revenue (LC)]' role='measure' type='quantitative' />
            <column caption='Order Month' datatype='date' default-format='*mmmm, yyyy' name='[Calculation_2183401438381543426]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;,[order_date]))' />
            </column>
            <column caption='Month Filter' datatype='boolean' name='[Calculation_2183401438382399491]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_2183401438381543426] = [Parameters].[Parameter 1]&#13;&#10;OR [Calculation_2183401438381543426] = DATEADD(&apos;month&apos;,-1,[Parameters].[Parameter 1])' />
            </column>
            <column caption='Index' datatype='integer' name='[Calculation_2183401438382940164]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Month Filter 2' datatype='boolean' name='[Month Filter 2 (copy)_2183401438586765323]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF { FIXED [country_code]:MAX([Calculation_2183401438381543426])} = [Parameters].[Parameter 1] &#13;&#10;AND DAY({FIXED [country_code]:MAX([order_date])}) &lt; DAY(DATEADD(&apos;day&apos;,-1,DATEADD(&apos;month&apos;,1,{ FIXED [country_code]:MAX([Calculation_2183401438381543426])})))&#13;&#10;THEN &#13;&#10;DAY([order_date]) &lt;= DAY({FIXED [country_code]:MAX([order_date])})&#13;&#10;ELSE [order_date] = [order_date]&#13;&#10;END' />
            </column>
            <column caption='Orders #' datatype='integer' name='[all_orders_count]' role='measure' type='quantitative' />
            <column caption='Country' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Total Stores' datatype='integer' name='[gmv total stores (copy)_2183401440062439461]' role='measure' type='quantitative'>
