              <calculation class='tableau' formula='IF [gmv total stores (copy)_2183401440062439461] = 1&#13;&#10;THEN&#13;&#10;IF MAX({ FIXED [country_code]:MAX([Calculation_2183401438381543426])}) = [Parameters].[Parameter 1]&#13;&#10;THEN  SUM({ FIXED [Calculation_2183401438381543426],[country_code],[warehouse_id]:MAX([store_to_date_customers])})&#13;&#10;ELSE SUM({ FIXED [Calculation_2183401438381543426],[country_code],[warehouse_id]:MAX([store_monthly_customers])})&#13;&#10;END&#13;&#10;ELSE&#13;&#10;IF MAX({ FIXED [country_code]:MAX([Calculation_2183401438381543426])}) = [Parameters].[Parameter 1]&#13;&#10;THEN  SUM({ FIXED [Calculation_2183401438381543426],[country_code]:MAX([to_date_customers])})&#13;&#10;ELSE SUM({ FIXED [Calculation_2183401438381543426],[country_code]:MAX([monthly_customers])})&#13;&#10;END&#13;&#10;&#13;&#10;END'>
