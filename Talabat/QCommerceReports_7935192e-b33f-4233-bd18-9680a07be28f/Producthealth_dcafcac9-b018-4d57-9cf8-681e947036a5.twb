                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Roboto' fontsize='22'>Definitions</run>
                    <run fontcolor='#000000' fontname='Roboto' fontsize='11'>:</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Roboto' fontsize='11'>Active Customers: </run>
                    <run fontcolor='#000000' fontname='Roboto' fontsize='11'>Number of users who place atleast one order in the given month.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Roboto' fontsize='11'>New Customers: </run>
                    <run fontcolor='#000000' fontname='Roboto' fontsize='11'>Number of customers who order for the first time.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Roboto' fontsize='11'>Resurrected Customers: </run>
                    <run fontcolor='#000000' fontname='Roboto' fontsize='11'>Number of churned customers (who were not active last month but have previously ordered) who are active in the given month.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Roboto' fontsize='11'>Retained Customers: </run>
                    <run fontcolor='#000000' fontname='Roboto' fontsize='11'>Number of active customers from last month who also ordered in the given month.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Roboto' fontsize='11'>Retention Rate:</run>
                    <run fontcolor='#000000' fontname='Roboto' fontsize='11'> Number of retained active customers in a month divided by total number of active customers in the previous month.</run>
                  </formatted-text>
