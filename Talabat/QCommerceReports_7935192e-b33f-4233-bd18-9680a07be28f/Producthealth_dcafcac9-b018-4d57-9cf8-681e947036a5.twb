        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.129bgs71rz2p4712edjce03rubqd' name='Custom SQL Query' type='text'>SELECT
snapshot_date,
co.country_code AS country_iso,
CASE WHEN(order_marketplace_count) =1 THEN &apos;1 order&apos;
WHEN(order_marketplace_count) =2 THEN &apos;2 orders&apos;
WHEN(order_marketplace_count) =3 THEN &apos;3 orders&apos;
WHEN(order_marketplace_count) =4 THEN &apos;4 orders&apos;
WHEN(order_marketplace_count) &gt;&gt;=5 THEN &apos;5+ orders&apos;
END AS grocery_marketplace_order_count,
--CASE WHEN(order_non_food_count-order_darkstore_count) =1 THEN &apos;1 order&apos;
--WHEN(order_non_food_count-order_darkstore_count) =2 THEN &apos;2 orders&apos;
--WHEN(order_non_food_count-order_darkstore_count) =3 THEN &apos;3 orders&apos;
--WHEN(order_non_food_count-order_darkstore_count) =4 THEN &apos;4 orders&apos;
--WHEN(order_non_food_count-order_darkstore_count) &gt;&gt;=5 THEN &apos;5+ orders&apos;
--END AS nfv_excl_tmart_order_count,
count(DISTINCT a.analytical_customer_id) AS customer_count
FROM `tlb-data-prod.data_platform.agg_customer_profile_monthly` a
LEFT JOIN `tlb-data-prod.data_platform.dim_customer_info` ci ON a.analytical_customer_id=ci.analytical_customer_id
LEFT JOIN `tlb-data-prod.data_platform.dim_country_info` co ON ci.country_id=co.country_id
WHERE snapshot_date&gt;&gt;=&apos;2022-01-01&apos;
AND order_marketplace_count&gt;&gt;0
GROUP BY 1,2,3</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
