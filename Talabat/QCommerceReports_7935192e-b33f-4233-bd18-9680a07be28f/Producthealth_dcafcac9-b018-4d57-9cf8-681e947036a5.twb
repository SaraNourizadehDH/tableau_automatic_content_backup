-- with monthly as (
-- select *,
-- LAG(month) OVER (PARTITION BY analytical_customer_id, country_code, vertical2 ORDER BY month) as last_order_month

-- from
-- (
--   SELECT
--   analytical_customer_id,
--   date_trunc(order_date,month) as month,
--   o.country_code,
--   case
--     when sub_vertical = 'marketplace' and not is_dsaas then 'grocery marketplace'
--     when sub_vertical = 'darkstore' and vertical = 'grocery' then 'grocery darkstore'
--     when sub_vertical = 'darkstore' and vertical = 'pharmacy' then 'pharmacy darkstore'
--     when sub_vertical is null and vertical = 'pharmacy' then 'pharmacy marketplace'
--     when is_dsaas then 'QCaaS'
--   else vertical end as vertical2,
--     is_nfv_acquisition,
--   count(distinct order_id) as orders,
--   sum(gmv_amount_lc) as gmv_lc,
--   sum(gmv_amount_eur) as gmv_eur

-- FROM `tlb-data-prod.data_platform.fct_order_info` o
-- inner join `tlb-data-prod.data_platform.dim_vendor_info` v using(vendor_id)
-- inner join `tlb-data-prod.data_platform.dim_chain` c on v.chain_id = c.chain_id
-- where is_successful
-- group by 1,2,3,4,5

-- )

-- )

-- select
-- country_code,
-- month,
-- vertical2,
-- 'total' as name,
-- count(DISTINCT CASE WHEN date_diff(month,last_order_month,month)>>1 THEN analytical_customer_id ELSE NULL END) AS resurrected_active_customer_count,
-- sum(CASE WHEN date_diff(month,last_order_month,month)>>1 THEN orders ELSE NULL END) AS resurrected_customer_order_count,
-- sum(CASE WHEN date_diff(month,last_order_month,month)>>1 THEN gmv_eur ELSE NULL END) AS resurrected_customer_gmv_eur,

-- count(DISTINCT CASE WHEN date_diff(month,last_order_month,month)=1 THEN analytical_customer_id ELSE NULL END) AS retained_active_customer_count,
-- sum(CASE WHEN date_diff(month,last_order_month,month)=1 THEN orders ELSE NULL END) AS retained_customer_order_count,
-- sum(CASE WHEN date_diff(month,last_order_month,month)=1 THEN gmv_eur ELSE NULL END) AS retained_customer_gmv_eur,

-- sum(CASE WHEN date_diff(month,last_order_month,month) is null THEN orders ELSE NULL END) AS acquired_customer_order_count,
-- sum(CASE WHEN date_diff(month,last_order_month,month) is null THEN gmv_eur ELSE NULL END) AS acquired_customer_gmv_eur,
-- count(DISTINCT CASE WHEN date_diff(month,last_order_month,month) is null THEN analytical_customer_id ELSE NULL END) AS acquired_active_customer_count,

-- sum(CASE WHEN is_nfv_acquisition THEN orders ELSE NULL END) AS acquired_nfv_customers_order_count,
-- sum(CASE WHEN is_nfv_acquisition THEN gmv_eur ELSE NULL END) AS acquired_nfv_customers_gmv_eur,
-- count(DISTINCT case when is_nfv_acquisition then analytical_customer_id else null end) as active_customers_nfv_acquired,

-- count(DISTINCT analytical_customer_id) as active_customers,

-- lag(count(distinct analytical_customer_id)) OVER (PARTITION BY country_code,vertical2 ORDER BY month) AS lag_mau,
-- sum(orders) as orders,
-- sum(gmv_lc) as gmv_lc,
-- sum(gmv_eur) as gmv_eur

-- from monthly
-- where month >>= '2022-01-01'
-- group by 1,2,3
-- order by 1,2,3
-- )


-- UNION ALL
-- --nfv

-- select *, 'total' as data_level from (

-- with monthly as (
-- select *,
-- LAG(month) OVER (PARTITION BY analytical_customer_id, country_code, vertical2 ORDER BY month) as last_order_month

-- from
-- (
--   SELECT
--   analytical_customer_id,
--   date_trunc(order_date,month) as month,
--   o.country_code,
--   case
--     when vertical <<>> 'food' and (sub_vertical = 'marketplace' or sub_vertical is null) and not is_dsaas then 'NFV'
--   else vertical end as vertical2,
--    is_nfv_acquisition,
--   count(distinct order_id) as orders,
--   sum(gmv_amount_lc) as gmv_lc,
--   sum(gmv_amount_eur) as gmv_eur

-- FROM `tlb-data-prod.data_platform.fct_order_info` o
-- inner join `tlb-data-prod.data_platform.dim_vendor_info` v using(vendor_id)
-- inner join `tlb-data-prod.data_platform.dim_chain` c on v.chain_id = c.chain_id
-- where is_successful
-- group by 1,2,3,4,5

-- )

-- )

-- select
-- country_code,
-- month,
-- vertical2,
-- 'total' as name,

-- count(DISTINCT CASE WHEN date_diff(month,last_order_month,month)>>1 THEN analytical_customer_id ELSE NULL END) AS resurrected_active_customer_count,
-- sum(CASE WHEN date_diff(month,last_order_month,month)>>1 THEN orders ELSE NULL END) AS resurrected_customer_order_count,
-- sum(CASE WHEN date_diff(month,last_order_month,month)>>1 THEN gmv_eur ELSE NULL END) AS resurrected_customer_gmv_eur,

-- count(DISTINCT CASE WHEN date_diff(month,last_order_month,month)=1 THEN analytical_customer_id ELSE NULL END) AS retained_active_customer_count,
-- sum(CASE WHEN date_diff(month,last_order_month,month)=1 THEN orders ELSE NULL END) AS retained_customer_order_count,
-- sum(CASE WHEN date_diff(month,last_order_month,month)=1 THEN gmv_eur ELSE NULL END) AS retained_customer_gmv_eur,

-- sum(CASE WHEN date_diff(month,last_order_month,month) is null THEN orders ELSE NULL END) AS acquired_customer_order_count,
-- sum(CASE WHEN date_diff(month,last_order_month,month) is null THEN gmv_eur ELSE NULL END) AS acquired_customer_gmv_eur,
-- count(DISTINCT CASE WHEN date_diff(month,last_order_month,month) is null THEN analytical_customer_id ELSE NULL END) AS acquired_active_customer_count,

-- -- sum(CASE WHEN date_diff(month,last_order_month,month) is null and is_nfv_acquisition THEN orders ELSE NULL END) AS acquired_nfv_customers_order_count,
-- -- sum(CASE WHEN date_diff(month,last_order_month,month) is null and is_nfv_acquisition THEN gmv_eur ELSE NULL END) AS acquired_nfv_customers_gmv_eur,
-- -- count(DISTINCT CASE WHEN date_diff(month,last_order_month,month) is null and is_nfv_acquisition THEN analytical_customer_id ELSE NULL END) AS acquired_nfv_customer_count,


-- count(DISTINCT analytical_customer_id) as active_customers,
-- count(DISTINCT case when is_nfv_acquisition then analytical_customer_id else null end) as customers_nfv_acquired,
-- sum(CASE WHEN is_nfv_acquisition THEN orders ELSE NULL END) AS acquired_nfv_customers_order_count,
-- sum(CASE WHEN is_nfv_acquisition THEN gmv_eur ELSE NULL END) AS acquired_nfv_customers_gmv_eur,

-- lag(count(distinct analytical_customer_id)) OVER (PARTITION BY country_code,vertical2 ORDER BY month) AS lag_mau,
-- sum(orders) as orders,
-- sum(gmv_lc) as gmv_lc,
-- sum(gmv_eur) as gmv_eur

-- from monthly
-- where month >>= '2022-01-01'
-- and vertical2 = 'NFV'
-- group by 1,2,3
-- order by 1,2,3

-- )]]></_.fcp.ObjectModelEncapsulateLegacy.true...relation>
