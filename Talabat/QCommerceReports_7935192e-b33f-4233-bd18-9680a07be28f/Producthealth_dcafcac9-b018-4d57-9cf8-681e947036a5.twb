        <named-connections>
          <named-connection caption='BigQuery' name='bigquery.1nldqv90mlmgzp1020hmm04c119o'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' bq-dataset-fetch-rows='' bq-fetch-rows='' bq-fetch-tasks='' bq-large-fetch-rows='' bq-project-fetch-rows='' bq-response-rows='' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='' username='aleeza.shakir@talabat.com' workgroup-auth-mode='prompt' />
          </named-connection>
