      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_3C0FACB6656543AB9CE1385BB5071D81'>
            <properties context=''>
              <relation connection='bigquery.1abinxj0q8g93o1b4fnjh0y3ddpk' name='Custom SQL Query' type='text'><![CDATA[select * from `tlb-data-dev.data_playground_grocery.product_health_temp_table`
-- CREATE TABLE `tlb-data-dev.data_playground_grocery.product_health_temp_table` as
-- select * from (
-- WITH monthly_numbers AS
--             (
--             SELECT a.*,'monthly' AS date_aggregation, 'total' as data_level,
--             safe_divide(grocery_customers,total_customers) AS grocery_share_of_total_customers,
--             safe_divide(gmp_customers,total_customers) AS gmp_share_of_total_customers,
--             safe_divide(tmart_customers,total_customers) AS tmart_share_of_total_customers,
--             safe_divide(grocery_orders,total_orders) AS grocery_share_of_total_orders,
--             safe_divide(gmp_orders,total_orders) AS gmp_share_of_total_orders,
--             safe_divide(tmart_orders,total_orders) AS tmart_share_of_total_orders,
--             safe_divide(grocery_sum_basket,grocery_customers) AS grocery_spend_per_customer,
--             safe_divide(grocery_sum_basket_usd,grocery_customers) AS grocery_spend_per_customer_usd,
--             safe_divide(tmart_sum_basket,tmart_customers) AS tmart_spend_per_customer,
--             safe_divide(tmart_sum_basket_usd,tmart_customers) AS tmart_spend_per_customer_usd,
--             safe_divide(gmp_sum_basket,gmp_customers) AS gmp_spend_per_customer,
--             safe_divide(gmp_sum_basket_usd,gmp_customers) AS gmp_spend_per_customer_usd,
--             safe_divide(grocery_orders,grocery_customers) AS grocery_order_per_customer,
--             safe_divide(gmp_orders,gmp_customers) AS gmp_order_per_customer,
--             safe_divide(pharmacy_orders,pharmacy_customers) AS pharmacy_order_per_customer,
--             safe_divide(non_food_excl_tmart_orders,non_food_excl_tmart_customers) AS non_food_excl_tmart_order_per_customer,
--             safe_divide(tmart_orders,tmart_customers) AS tmart_order_per_customer, 
--             FROM
--             (
--             SELECT date_trunc(o.order_date,month) AS date,
--             o.country_iso,
--             'total' as name, 'total' as vertical, 'total' as sub_vertical,
--             count(DISTINCT analytical_customer_id) AS total_customers,
--             count(DISTINCT CASE WHEN v.vertical='food' THEN analytical_customer_id ELSE NULL END) AS food_customers,
--             count(DISTINCT CASE WHEN customer_order_index=1 THEN analytical_customer_id ELSE NULL END) AS acquisitions,
--             count(DISTINCT CASE WHEN customer_non_food_order_index=1 THEN analytical_customer_id ELSE NULL END) AS nfv_acquisitions,
--             count(DISTINCT CASE WHEN customer_non_food_order_index=1 AND customer_darsktore_order_index is null THEN analytical_customer_id ELSE NULL END) AS nfv_excl_tmart_acquisitions,
--             count(DISTINCT CASE WHEN customer_darsktore_order_index=1 THEN analytical_customer_id ELSE NULL END) AS tmart_acquisitions,
--             count(DISTINCT CASE WHEN v.vertical!='food' THEN analytical_customer_id ELSE NULL END) AS non_food_customers,
--             count(DISTINCT CASE WHEN v.vertical='pharmacy' THEN analytical_customer_id ELSE NULL END) AS pharmacy_customers,
--             count(DISTINCT CASE WHEN v.vertical!='food' AND v.sub_vertical!='darkstore' THEN analytical_customer_id ELSE NULL END) AS non_food_excl_tmart_customers,
--             count(DISTINCT CASE WHEN v.vertical='grocery' THEN analytical_customer_id ELSE NULL END) AS grocery_customers,
--             count(DISTINCT CASE WHEN v.vertical='grocery' AND v.sub_vertical='marketplace' THEN analytical_customer_id ELSE NULL END) AS gmp_customers,
--             count(DISTINCT CASE WHEN v.vertical='grocery' AND v.sub_vertical='darkstore' THEN analytical_customer_id ELSE NULL END) AS tmart_customers,
--             count(DISTINCT o.order_id) AS total_orders,
--             count(DISTINCT CASE WHEN v.vertical='food' THEN o.order_id ELSE NULL END) AS food_orders,
--             count(DISTINCT CASE WHEN v.vertical='grocery' THEN o.order_id ELSE NULL END) AS grocery_orders,
--             count(DISTINCT CASE WHEN v.vertical='grocery' AND v.sub_vertical='marketplace' THEN o.order_id ELSE NULL END) AS gmp_orders,
--             count(DISTINCT CASE WHEN v.vertical='grocery' AND v.sub_vertical='darkstore' THEN o.order_id ELSE NULL END) AS tmart_orders,
--             count(DISTINCT CASE WHEN v.vertical!='food' THEN o.order_id ELSE NULL END) AS non_food_incl_tmart_orders,
--             count(DISTINCT CASE WHEN v.vertical!='food' AND v.sub_vertical!='darkstore' THEN o.order_id ELSE NULL END) AS non_food_excl_tmart_orders,
--             count(DISTINCT CASE WHEN v.vertical='pharmacy' THEN o.order_id ELSE NULL END) AS pharmacy_orders,
--             sum(CASE WHEN v.vertical='grocery' THEN basket_amount_eur ELSE 0 END) AS grocery_sum_basket,
--             sum(CASE WHEN v.vertical='grocery' AND v.sub_vertical='darkstore' THEN basket_amount_eur ELSE 0 END) AS tmart_sum_basket,
--             sum(CASE WHEN v.vertical='grocery' AND v.sub_vertical='marketplace' THEN basket_amount_eur ELSE 0 END) AS gmp_sum_basket,
--             sum(CASE WHEN v.vertical='grocery' THEN safe_divide(basket_amount_eur, exchange_rate_to_usd) ELSE 0 END) AS grocery_sum_basket_usd,
--             sum(CASE WHEN v.vertical='grocery' AND v.sub_vertical='darkstore' THEN safe_divide(basket_amount_lc, exchange_rate_to_usd) ELSE 0 END) AS tmart_sum_basket_usd,
--             sum(CASE WHEN v.vertical='grocery' AND v.sub_vertical='marketplace' THEN safe_divide(basket_amount_lc, exchange_rate_to_usd) ELSE 0 END) AS gmp_sum_basket_usd,
--             sum(CASE WHEN v.vertical='grocery' THEN gmv_amount_eur ELSE 0 END) AS grocery_gmv,
--             sum(CASE WHEN v.vertical='grocery' AND v.sub_vertical='darkstore' THEN gmv_amount_eur ELSE 0 END) AS tmart_gmv,
--             sum(CASE WHEN v.vertical='grocery' AND v.sub_vertical='marketplace' THEN gmv_amount_eur ELSE 0 END) AS gmp_gmv,
--             sum(CASE WHEN v.vertical='grocery' THEN safe_divide(gmv_amount_lc, exchange_rate_to_usd) ELSE 0 END) AS grocery_gmv_usd,
--             sum(CASE WHEN v.vertical='grocery' AND v.sub_vertical='darkstore' THEN safe_divide(gmv_amount_lc, exchange_rate_to_usd) ELSE 0 END) AS tmart_gmv_usd,
--             sum(CASE WHEN v.vertical='grocery' AND v.sub_vertical='marketplace' THEN safe_divide(gmv_amount_lc, exchange_rate_to_usd) ELSE 0 END) AS gmp_gmv_usd
--             FROM `tlb-data-prod.data_platform.fct_order_info` o
--             LEFT JOIN `tlb-data-prod.data_platform.dim_vendor_info` dv on dv.vendor_id = o.vendor_id
--             LEFT JOIN `tlb-data-prod.data_platform.dim_chain` dc on dv.chain_id = dc.chain_id
--             LEFT JOIN `tlb-data-prod.data_platform.fct_order_rank` r ON o.order_id=r.order_id
--             LEFT JOIN `tlb-data-prod.data_platform.dim_vertical` v ON o.vertical_id=v.vertical_id
--             LEFT JOIN `tlb-data-prod.data_platform.fct_currency_conversion` c
--             on date(o.order_date)= c.exchange_rate_date AND o.country_iso=c.country_iso
--             WHERE o.order_date>>='2023-01-01'
--             AND basket_amount_eur<<=10000
--             AND is_successful
--             GROUP BY 1,2
--             ) a
--             ),
--             weekly_numbers AS
--             (
--             SELECT b.*,'weekly' AS date_aggregation, 'total' as data_level,
--             safe_divide(grocery_customers,total_customers) AS grocery_share_of_total_customers,
--             safe_divide(gmp_customers,total_customers) AS gmp_share_of_total_customers,
--             safe_divide(tmart_customers,total_customers) AS tmart_share_of_total_customers,
--             safe_divide(grocery_orders,total_orders) AS grocery_share_of_total_orders,
--             safe_divide(gmp_orders,total_orders) AS gmp_share_of_total_orders,
--             safe_divide(tmart_orders,total_orders) AS tmart_share_of_total_orders,
--             safe_divide(grocery_sum_basket,grocery_customers) AS grocery_spend_per_customer,
--             safe_divide(grocery_sum_basket_usd,grocery_customers) AS grocery_spend_per_customer_usd,
--             safe_divide(tmart_sum_basket,tmart_customers) AS tmart_spend_per_customer,
--             safe_divide(tmart_sum_basket_usd,tmart_customers) AS tmart_spend_per_customer_usd,
--             safe_divide(gmp_sum_basket,gmp_customers) AS gmp_spend_per_customer,
--             safe_divide(gmp_sum_basket_usd,gmp_customers) AS gmp_spend_per_customer_usd,
--             safe_divide(grocery_orders,grocery_customers) AS grocery_order_per_customer,
