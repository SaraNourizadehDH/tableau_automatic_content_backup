      <aliases enabled='yes' />
      <column caption='Total Component Sales' datatype='real' name='[Calculation_3139571915728584704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [component_title] : SUM([basket_amount_eur])}' />
      </column>
      <column caption='Front Margin' datatype='real' name='[Calculation_3139571915756462082]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([basket_amount_eur])- SUM([cogs_eur]))/SUM([basket_amount_eur])' />
      </column>
