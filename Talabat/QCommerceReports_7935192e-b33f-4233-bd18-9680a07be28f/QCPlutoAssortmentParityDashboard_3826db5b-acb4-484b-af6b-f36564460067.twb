    <worksheet name='Bad Gap %'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#f28e2b'>&lt;Sheet Name&gt; </run>
            <run bold='true' fontalignment='1' fontcolor='#666666'>|</run>
