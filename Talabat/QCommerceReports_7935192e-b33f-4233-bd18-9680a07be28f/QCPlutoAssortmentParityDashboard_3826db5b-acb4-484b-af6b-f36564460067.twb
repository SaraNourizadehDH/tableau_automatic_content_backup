    <worksheet name='Vendor Assortment Details'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='pluto_mid_nfv_vendor_item_location_assortment_parity_dashboard' name='federated.0m5dyi81mlnt2l1ap0p7z0ye0hjp' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Category Role' caption='Dimension 1' datatype='string' name='[Aggregate On (copy)_3795760477368979507]' param-domain-type='list' role='measure' type='nominal' value='&quot;category_role&quot;'>
              <calculation class='tableau' formula='&quot;category_role&quot;' />
              <aliases>
                <alias key='&quot;category_role&quot;' value='Category Role' />
                <alias key='&quot;city&quot;' value='City' />
                <alias key='&quot;competitor_vendor&quot;' value='Competitor Vendor' />
                <alias key='&quot;item_role&quot;' value='Item Role' />
                <alias key='&quot;l1&quot;' value='Category L1' />
                <alias key='&quot;l2&quot;' value='Category L2' />
                <alias key='&quot;l3&quot;' value='Category L3' />
                <alias key='&quot;talabat_vendor&quot;' value='Talabat Vendor' />
              </aliases>
            </column>
            <column alias='Category L1' caption='Dimension 2' datatype='string' name='[Dimension 1 (copy)_3795760477369061428]' param-domain-type='list' role='measure' type='nominal' value='&quot;l1&quot;'>
              <calculation class='tableau' formula='&quot;l1&quot;' />
              <aliases>
                <alias key='&quot;category_role&quot;' value='Category Role' />
                <alias key='&quot;city&quot;' value='City' />
                <alias key='&quot;competitor_vendor&quot;' value='Competitor Vendor' />
                <alias key='&quot;item_role&quot;' value='Item Role' />
                <alias key='&quot;l1&quot;' value='Category L1' />
                <alias key='&quot;l2&quot;' value='Category L2' />
                <alias key='&quot;l3&quot;' value='Category L3' />
                <alias key='&quot;talabat_vendor&quot;' value='Talabat Vendor' />
              </aliases>
            </column>
            <column alias='Flat' caption='Weight Parity on' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;flat&quot;'>
              <calculation class='tableau' formula='&quot;flat&quot;' />
              <aliases>
                <alias key='&quot;category&quot;' value='Category Sales' />
                <alias key='&quot;flat&quot;' value='Flat' />
                <alias key='&quot;vendor_city&quot;' value='City Level Sales' />
                <alias key='&quot;vendor_country&quot;' value='Country Level Sales' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0m5dyi81mlnt2l1ap0p7z0ye0hjp'>
            <column caption='Good Gap %' datatype='real' default-format='p0.00%' name='[Calculation_3795760477069197315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([is_good_gap_count] * [Calculation_3795760477102596113]) / SUM([talabat_item_count]*[Calculation_3795760477102596113])' />
            </column>
            <column caption='Assortment Index' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3795760477072093190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([talabat_item_count]) / SUM([competitor_item_count])' />
            </column>
            <column caption='Assortment Parity' datatype='real' default-format='p0.00%' name='[Calculation_3795760477072216071]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([is_item_match_vendor_count]*[Calculation_3795760477102596113]) / SUM([competitor_item_count]*[Calculation_3795760477102596113])' />
            </column>
            <column caption='Parameterized Weight' datatype='real' name='[Calculation_3795760477102596113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] == &apos;vendor_city&apos; THEN [vendor_city_weight]&#10;ELSEIF [Parameters].[Parameter 1] == &apos;vendor_country&apos; THEN [vendor_country_weight]&#10;ELSEIF [Parameters].[Parameter 1] == &apos;category&apos; THEN [item_category_level_three_weight]&#10;ELSE 1&#10;END' />
            </column>
            <column caption='# Unmatched Talabat Items' datatype='integer' name='[Calculation_3795760477112537107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([talabat_item_count]) - SUM([is_good_gap_count])' />
            </column>
            <column caption='Chosen Dimension 1' datatype='string' name='[Calculation_3795760477125537815]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Aggregate On (copy)_3795760477368979507] == &quot;category_role&quot; THEN [category_role]&#10;ELSEIF [Parameters].[Aggregate On (copy)_3795760477368979507] == &quot;city&quot; THEN [vendor_city]&#10;ELSEIF [Parameters].[Aggregate On (copy)_3795760477368979507] == &quot;l1&quot; THEN [item_category_level_one]&#10;ELSEIF [Parameters].[Aggregate On (copy)_3795760477368979507] == &quot;l2&quot; THEN [item_category_level_two]&#10;ELSEIF [Parameters].[Aggregate On (copy)_3795760477368979507] == &quot;l3&quot; THEN [item_category_level_three]&#10;ELSEIF [Parameters].[Aggregate On (copy)_3795760477368979507] == &quot;talabat_vendor&quot; THEN [pluto_vendor_location_name_talabat]&#10;ELSEIF [Parameters].[Aggregate On (copy)_3795760477368979507] == &quot;competitor_vendor&quot; THEN [pluto_vendor_location_name_competitor]&#10;ELSE [category_role] &#10;END' />
            </column>
            <column caption='Chosen Dimension 2' datatype='string' name='[Chosen Dimension 1 (copy)_3795760477369249845]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Dimension 1 (copy)_3795760477369061428] == &quot;category_role&quot; THEN [category_role]&#10;ELSEIF [Parameters].[Dimension 1 (copy)_3795760477369061428] == &quot;city&quot; THEN [vendor_city]&#10;ELSEIF [Parameters].[Dimension 1 (copy)_3795760477369061428] == &quot;l1&quot; THEN [item_category_level_one]&#10;ELSEIF [Parameters].[Dimension 1 (copy)_3795760477369061428] == &quot;l2&quot; THEN [item_category_level_two]&#10;ELSEIF [Parameters].[Dimension 1 (copy)_3795760477369061428] == &quot;l3&quot; THEN [item_category_level_three]&#10;ELSEIF [Parameters].[Dimension 1 (copy)_3795760477369061428] == &quot;talabat_vendor&quot; THEN [pluto_vendor_location_name_talabat]&#10;ELSEIF [Parameters].[Dimension 1 (copy)_3795760477369061428] == &quot;competitor_vendor&quot; THEN [pluto_vendor_location_name_competitor]&#10;ELSE [category_role] &#10;END' />
