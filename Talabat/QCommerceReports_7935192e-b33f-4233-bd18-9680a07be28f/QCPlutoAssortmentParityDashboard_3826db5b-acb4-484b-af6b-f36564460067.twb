      <aliases enabled='yes' />
      <column caption='# Talabat Vendor Good Gap' datatype='real' name='[# Talabat Vendor Bad Gap (copy)_3795760477111635986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( { FIXED [platform_code_competitor],[platform_code_talabat],[pluto_vendor_location_id_competitor], [pluto_vendor_location_id_talabat]: SUM([is_good_gap_count]) * AVG([Calculation_3795760477102596113]) })' />
      </column>
      <column caption='# Unmatched Talabat Vendor Items' datatype='real' name='[# Unmatched Talabat Items (copy)_3795760477116018709]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [platform_code_competitor], [platform_code_talabat], [pluto_vendor_location_id_talabat], [pluto_vendor_location_id_competitor] : SUM([talabat_item_count] * [Calculation_3795760477102596113]) - SUM([is_good_gap_count] * [Calculation_3795760477102596113]) }' />
      </column>
      <column caption='Good Gap %' datatype='real' default-format='p0.00%' name='[Calculation_3795760477069197315]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_good_gap_count] * [Calculation_3795760477102596113]) / SUM([talabat_item_count]*[Calculation_3795760477102596113])' />
      </column>
      <column caption='Aggregation Weight' datatype='real' name='[Calculation_3795760477070278661]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='Assortment Index' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_3795760477072093190]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([talabat_item_count]) / SUM([competitor_item_count])' />
      </column>
      <column caption='Assortment Parity' datatype='real' default-format='p0.00%' name='[Calculation_3795760477072216071]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_item_match_vendor_count]*[Calculation_3795760477102596113]) / SUM([competitor_item_count]*[Calculation_3795760477102596113])' />
      </column>
      <column caption='MIN(1)' datatype='integer' name='[Calculation_3795760477086896136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(1)' />
      </column>
      <column caption='# Matched Items' datatype='integer' default-format='n#,##0,.00K;-#,##0,.00K' name='[Calculation_3795760477088047114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([competitor_item_count]) - SUM([is_bad_gap_count])' />
      </column>
      <column caption='# Talabat Vendor Bad Gap' datatype='real' name='[Calculation_3795760477093400588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( { FIXED [platform_code_competitor],[platform_code_talabat],[pluto_vendor_location_id_competitor], [pluto_vendor_location_id_talabat]: SUM([is_bad_gap_count]*[Calculation_3795760477102596113]) - SUM([is_vendor_item_gap_talabat_count]*[Calculation_3795760477102596113]) })' />
      </column>
      <column caption='# Talabat Vendor Match Items' datatype='real' name='[Calculation_3795760477096308749]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [platform_code_competitor], [platform_code_talabat], [pluto_vendor_location_id_talabat], [pluto_vendor_location_id_competitor] : SUM([is_item_match_vendor_count]) * AVG([Calculation_3795760477102596113]) }' />
      </column>
      <column caption='Vendor GFV (€)' datatype='real' name='[Calculation_3795760477096898576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [platform_code_competitor], [platform_code_talabat], [pluto_vendor_location_id_talabat], [pluto_vendor_location_id_competitor] : SUM([category_sales_eur_talabat]) }' />
      </column>
      <column caption='Parameterized Weight' datatype='real' name='[Calculation_3795760477102596113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] == &apos;vendor_city&apos; THEN [vendor_city_weight]&#10;ELSEIF [Parameters].[Parameter 1] == &apos;vendor_country&apos; THEN [vendor_country_weight]&#10;ELSEIF [Parameters].[Parameter 1] == &apos;category&apos; THEN [item_category_level_three_weight]&#10;ELSE 1&#10;END' />
      </column>
      <column caption='# Unmatched Talabat Items' datatype='integer' name='[Calculation_3795760477112537107]' role='measure' type='quantitative'>
