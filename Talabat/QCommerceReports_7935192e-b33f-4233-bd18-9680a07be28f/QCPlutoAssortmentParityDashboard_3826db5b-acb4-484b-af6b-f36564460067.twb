              <calculation class='tableau' formula='IF [Parameters].[Aggregate On (copy)_3795760477368979507] == &quot;category_role&quot; THEN [category_role]&#10;ELSEIF [Parameters].[Aggregate On (copy)_3795760477368979507] == &quot;city&quot; THEN [vendor_city]&#10;ELSEIF [Parameters].[Aggregate On (copy)_3795760477368979507] == &quot;l1&quot; THEN [item_category_level_one]&#10;ELSEIF [Parameters].[Aggregate On (copy)_3795760477368979507] == &quot;l2&quot; THEN [item_category_level_two]&#10;ELSEIF [Parameters].[Aggregate On (copy)_3795760477368979507] == &quot;l3&quot; THEN [item_category_level_three]&#10;ELSEIF [Parameters].[Aggregate On (copy)_3795760477368979507] == &quot;talabat_vendor&quot; THEN [pluto_vendor_location_name_talabat]&#10;ELSEIF [Parameters].[Aggregate On (copy)_3795760477368979507] == &quot;competitor_vendor&quot; THEN [pluto_vendor_location_name_competitor]&#10;ELSE [category_role] &#10;END' />
            </column>
            <column caption='Parameterized Assortment Index' datatype='real' name='[Calculation_3795760477279801376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] == &quot;city&quot; OR [Parameters].[Parameter 2] == &quot;vendor&quot; &#10;THEN AVG({ FIXED [pluto_vendor_location_id_competitor], [pluto_vendor_location_id_talabat]: SUM([talabat_item_count]*[vendor_country_weight]) / SUM([competitor_item_count]*[vendor_country_weight]) })&#10;ELSEIF [Parameters].[Parameter 2] == &quot;l1&quot;&#10;THEN AVG({ FIXED [pluto_vendor_location_id_competitor], [pluto_vendor_location_id_talabat], [item_category_level_one] : SUM([talabat_item_count]*[vendor_country_weight]) / SUM([competitor_item_count]*[vendor_country_weight]) })&#10;ELSEIF [Parameters].[Parameter 2] == &quot;l2&quot;&#10;THEN AVG({ FIXED [pluto_vendor_location_id_competitor], [pluto_vendor_location_id_talabat], [item_category_level_two] : SUM([talabat_item_count]*[vendor_country_weight]) / SUM([competitor_item_count]*[vendor_country_weight]) })&#10;ELSEIF [Parameters].[Parameter 2] == &quot;l3&quot;&#10;THEN AVG({ FIXED [pluto_vendor_location_id_competitor], [pluto_vendor_location_id_talabat], [item_category_level_three] : SUM([talabat_item_count]*[vendor_country_weight]) / SUM([competitor_item_count]*[vendor_country_weight]) })&#10;ELSEIF [Parameters].[Parameter 2] == &quot;category_role&quot;&#10;THEN AVG({ FIXED [pluto_vendor_location_id_competitor], [pluto_vendor_location_id_talabat], [category_role] : SUM([talabat_item_count]*[vendor_country_weight]) / SUM([competitor_item_count]*[vendor_country_weight]) })&#10;ELSE AVG({ FIXED [pluto_vendor_location_id_competitor], [pluto_vendor_location_id_talabat]: SUM([talabat_item_count]*[vendor_country_weight]) / SUM([competitor_item_count]*[vendor_country_weight]) }) END' />
