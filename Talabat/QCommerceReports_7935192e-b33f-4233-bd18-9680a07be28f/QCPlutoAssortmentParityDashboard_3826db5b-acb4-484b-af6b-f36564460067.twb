        <_.fcp.ObjectModelEncapsulateLegacy.false...relation connection='bigquery.0deip7k0ce3wog10u3xje0azoat2' name='Custom SQL Query1' type='text'>-- 1) Your base query, unchanged except we alias it as pairs
WITH week_date AS (
  SELECT
    date AS reporting_date,
    DATE_ADD(DATE_TRUNC(MAX(date) OVER (), WEEK), INTERVAL 6 DAY) AS week_end_date
  FROM `tlb-data-prod.data_platform.dim_date`
  WHERE date BETWEEN DATE &apos;2025-08-20&apos; - 6 AND DATE &apos;2025-08-20&apos;
),
tmart_gmv AS (
  SELECT
    foi.vendor_id,
    category_name_level_one AS item_category_level_one,
    category_name_level_two AS item_category_level_two,
    category_name_level_three AS item_category_level_three,
    SUM(foi.total_price_paid_net_eur) AS gfv_eur
  FROM `tlb-data-prod.data_platform.fct_order_item` foi
  INNER JOIN `tlb-data-prod.data_platform.fct_order_info` fo
    ON foi.order_id = fo.order_id
  INNER JOIN `tlb-data-prod.data_platform.dim_item` di
    ON foi.item_id = di.item_id
  WHERE
    foi.order_date BETWEEN DATE &apos;2025-08-20&apos; - 27 AND DATE &apos;2025-08-20&apos;
    AND fo.order_date BETWEEN DATE &apos;2025-08-20&apos; - 27 AND DATE &apos;2025-08-20&apos;
    AND fo.is_successful
    AND NOT is_test
    AND is_darkstore
    AND is_grocery
  GROUP BY ALL
),
pairs AS (
  SELECT 
    week_end_date,
    parity.country_code,
    parity.vendor_city,
    parity.platform_code_talabat,
    parity.platform_code_competitor,
    ROUND(parity.vendor_lat_talabat, 5)  AS vendor_lat_talabat,
    ROUND(parity.vendor_lon_talabat, 5)  AS vendor_lon_talabat,
    ROUND(parity.vendor_lat_competitor,5) AS vendor_lat_competitor,
    ROUND(parity.vendor_lon_competitor,5) AS vendor_lon_competitor,
    parity.pluto_vendor_location_name_talabat,
    parity.pluto_vendor_location_name_competitor,
    parity.pluto_vendor_id_talabat,
    parity.pluto_vendor_id_competitor,
    parity.item_category_level_one,
    parity.item_category_level_two,
    parity.item_category_level_three,
    cat_map.category_role,
    tmart_gmv.gfv_eur AS category_sales_eur_talabat,
    farm_fingerprint(
        parity.pluto_vendor_location_id_talabat
        || parity.pluto_vendor_location_id_competitor
        || CAST(round(parity.vendor_lat_talabat,5) AS STRING)
        || CAST(round(parity.vendor_lon_talabat,5) AS STRING)
        || CAST(round(parity.vendor_lat_competitor,5) AS STRING)
        || CAST(round(parity.vendor_lon_competitor,5) AS STRING)
    ) as pair_id,
    COUNT(pluto_item_id_competitor) AS competitor_item_count,
    COUNT(pluto_item_id_talabat)    AS talabat_item_count,
    SUM(IF(is_item_match_city, 1, 0))           AS is_item_match_city_count,
    SUM(IF(is_vendor_item_gap_talabat, 1, 0))   AS is_vendor_item_gap_talabat_count,
    SUM(IF(is_bad_item_gap, 1, 0))              AS is_bad_gap_count,
    SUM(IF(is_good_item_gap, 1, 0))             AS is_good_gap_count,

    -- Extras that are handy for tooltip/size
    ST_DISTANCE(
      ST_GEOGPOINT(parity.vendor_lon_competitor, parity.vendor_lat_competitor),
      ST_GEOGPOINT(parity.vendor_lon_talabat,     parity.vendor_lat_talabat)
    )/1000.0 AS pair_distance_km
  FROM week_date
  INNER JOIN `tlb-data-dev.data_platform_pluto_preparation.pluto_mid_nfv_vendor_location_item_parity` parity
    ON week_date.reporting_date = parity.observed_at_date
  LEFT JOIN `tlb-data-dev.data_platform_pluto_preparation.stage_pluto_mart_vendor_location_assortment_parity_category_role_mapping` cat_map
    ON cat_map.item_category_level_one = parity.item_category_level_one
   AND cat_map.item_category_level_two = parity.item_category_level_two
  LEFT JOIN tmart_gmv
    ON parity.source_platform_vendor_id_talabat = tmart_gmv.vendor_id
   AND parity.item_category_level_one = tmart_gmv.item_category_level_one
   AND parity.item_category_level_two = tmart_gmv.item_category_level_two
   AND parity.item_category_level_three = tmart_gmv.item_category_level_three
  WHERE platform_code_competitor IN (&apos;nn_minutes&apos;, &apos;sv_mart&apos;)
  GROUP BY ALL
)

-- 2) Long (points) table: two rows per pair_id with a path_order for Tableau’s Path shelf
SELECT
  week_end_date,
  country_code,
  vendor_city,
  platform_code_talabat,
  platform_code_competitor,
  pair_id,
  &apos;Competitor&apos; AS vendor_type,
  vendor_lat_competitor AS lat,
  vendor_lon_competitor AS lon,
  pluto_vendor_location_name_competitor AS vendor_location_name,
  pluto_vendor_id_competitor          AS pluto_vendor_id,
  1 AS path_order,
  pair_distance_km
FROM pairs

UNION ALL

SELECT
  week_end_date,
  country_code,
  vendor_city,
  platform_code_talabat,
  platform_code_competitor,
  pair_id,
  &apos;Talabat&apos; AS vendor_type,
  vendor_lat_talabat AS lat,
  vendor_lon_talabat AS lon,
  pluto_vendor_location_name_talabat AS vendor_location_name,
  pluto_vendor_id_talabat            AS pluto_vendor_id,
  2 AS path_order,
  pair_distance_km
FROM pairs</_.fcp.ObjectModelEncapsulateLegacy.false...relation>
        <_.fcp.ObjectModelEncapsulateLegacy.true...relation type='collection'>
          <relation connection='bigquery.076vbik13svw0s114sa7s12bvifb' name='Custom SQL Query' type='text'>with week_date as (
  -- change this for production run, only take week_end_date from dim_date
  select
    date as reporting_date,
    date_add(date_trunc(max(date) over (), week), interval 6 day) as week_end_date -- 14th to 20th is part of 2 different weeks
  from `tlb-data-prod.data_platform.dim_date`
  where date between &apos;2025-08-20&apos; - 6 and &apos;2025-08-20&apos;
)

, tmart_gmv as (
  select
    foi.vendor_id,
    category_name_level_one as item_category_level_one,
    category_name_level_two as item_category_level_two,
    category_name_level_three as item_category_level_three,
    sum(foi.total_price_paid_net_eur) as gfv_eur,
  from
    `tlb-data-prod.data_platform.fct_order_item` foi
  inner join `tlb-data-prod.data_platform.fct_order_info` fo
    on foi.order_id = fo.order_id
  inner join `tlb-data-prod.data_platform.dim_item` di
    on foi.item_id = di.item_id
  where 1=1
    and foi.order_date between &apos;2025-08-20&apos; - 27 and &apos;2025-08-20&apos;
    and fo.order_date between &apos;2025-08-20&apos; - 27 and &apos;2025-08-20&apos;
    and fo.is_successful
    and not is_test
    and is_darkstore
    and is_grocery
  group by all
)


select 
  week_end_date,
  observed_at_date,
  parity.country_code,
  parity.vendor_city,
  parity.platform_code_competitor,
  parity.platform_code_talabat,
  round(parity.vendor_lat_talabat,5) AS vendor_lat_talabat,
  round(parity.vendor_lon_talabat,5) AS vendor_lon_talabat,
  round(parity.vendor_lat_competitor,5) AS vendor_lat_competitor,
  round(parity.vendor_lon_competitor,5) AS vendor_lon_competitor,
  parity.pluto_vendor_location_name_talabat,
  parity.pluto_vendor_location_name_competitor,
  parity.pluto_vendor_id_talabat,
  parity.pluto_vendor_id_competitor,
  parity.pluto_vendor_location_id_talabat,
  parity.pluto_vendor_location_id_competitor,
  parity.item_category_level_one,
  parity.item_category_level_two,
  parity.item_category_level_three,
  cat_map.category_role,
  tmart_gmv.gfv_eur as category_sales_eur_talabat,

  safe_divide(
    tmart_gmv.gfv_eur 
    , sum(tmart_gmv.gfv_eur) over ( partition by parity.item_category_level_three, pluto_vendor_id_talabat, pluto_vendor_id_competitor )
    ) as item_category_level_three_weight,
  safe_divide(sum(tmart_gmv.gfv_eur) over ( partition by parity.pluto_vendor_location_id_talabat, parity.pluto_vendor_location_id_competitor, pluto_vendor_id_talabat, pluto_vendor_id_competitor ), sum(tmart_gmv.gfv_eur) over (partition by platform_code_competitor, platform_code_talabat, pluto_vendor_id_competitor, pluto_vendor_id_talabat)) as vendor_city_weight,
    safe_divide(sum(tmart_gmv.gfv_eur) over ( partition by parity.pluto_vendor_location_id_talabat, parity.pluto_vendor_location_id_competitor, pluto_vendor_id_talabat, pluto_vendor_id_competitor ), sum(tmart_gmv.gfv_eur) over (partition by platform_code_competitor, platform_code_talabat)) as vendor_country_weight,
  --category_vendor_weight, --sum of weights should be 1 over 1 vendor
  --vendor_weight, --sum of weights should be 1 over all vendors
  --
  farm_fingerprint(
    parity.pluto_vendor_location_id_talabat
    || parity.pluto_vendor_location_id_competitor
    || CAST(round(parity.vendor_lat_talabat,5) AS STRING)
    || CAST(round(parity.vendor_lon_talabat,5) AS STRING)
    || CAST(round(parity.vendor_lat_competitor,5) AS STRING)
    || CAST(round(parity.vendor_lon_competitor,5) AS STRING)
  ) as pair_id,
  COUNT(pluto_item_id_competitor) as competitor_item_count,
  COUNT(pluto_item_id_talabat) as talabat_item_count,
  SUM(IF(is_item_match_city, 1, 0)) as is_item_match_city_count,
  SUM(IF(is_item_match_city and not is_vendor_item_gap_talabat,1,0)) as is_item_match_vendor_count,
  SUM(IF(is_vendor_item_gap_talabat, 1, 0)) as is_vendor_item_gap_talabat_count,
  SUM(IF(is_bad_item_gap, 1, 0)) as is_bad_gap_count,
  SUM(IF(is_good_item_gap, 1, 0)) as is_good_gap_count,
from 
  week_date
inner join `tlb-data-dev.data_platform_pluto_preparation.pluto_mid_nfv_vendor_location_item_parity` parity
  on week_date.reporting_date = parity.observed_at_date
left join `tlb-data-dev.data_platform_pluto_preparation.stage_pluto_mart_vendor_location_assortment_parity_category_role_mapping` cat_map
  on cat_map.item_category_level_one = parity.item_category_level_one
  and cat_map.item_category_level_two = parity.item_category_level_two
left join tmart_gmv
  on parity.source_platform_vendor_id_talabat = tmart_gmv.vendor_id
  and parity.item_category_level_one = tmart_gmv.item_category_level_one
  and parity.item_category_level_two = tmart_gmv.item_category_level_two
  and parity.item_category_level_three = tmart_gmv.item_category_level_three
where true
and platform_code_competitor in (&apos;nn_minutes&apos;, &apos;sv_mart&apos;)
-- and parity.item_category_level_three = &apos;Cat&apos;
-- and item_category_level_one is null
-- and pluto_item_id_competitor not in (select pluto_item_id_competitor from `tlb-data-dev.data_platform_pluto_preparation.pluto_mid_nfv_vendor_location_item_matcher_lookup`)
-- and (matcher_pluto_item_id_talabat is not null or pluto_item_id_talabat is not null)
-- and observed_at_date = &apos;2025-08-15&apos;
group by all
qualify row_number() over (
  partition by 
    pluto_vendor_location_id_talabat
    , pluto_vendor_location_id_competitor
    , parity.item_category_level_one
    , parity.item_category_level_two
    , parity.item_category_level_three  
  order by observed_at_date desc
) = 1</relation>
          <relation connection='bigquery.0deip7k0ce3wog10u3xje0azoat2' name='Custom SQL Query1' type='text'>-- 1) Your base query, unchanged except we alias it as pairs
