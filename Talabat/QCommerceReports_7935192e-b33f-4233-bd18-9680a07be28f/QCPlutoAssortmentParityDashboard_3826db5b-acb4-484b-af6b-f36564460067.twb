    <datasource caption='pluto_mid_nfv_vendor_item_location_assortment_parity_dashboard' inline='true' name='federated.0m5dyi81mlnt2l1ap0p7z0ye0hjp' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='Main Table' name='bigquery.076vbik13svw0s114sa7s12bvifb'>
            <connection CATALOG='tlb-data-prod' EXECCATALOG='tlb-data-dev' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-prod' schema='data_platform' server-oauth='server-custom' username='aaryaman@talabat.com' workgroup-auth-mode='as-is' />
          </named-connection>
          <named-connection caption='Map' name='bigquery.0deip7k0ce3wog10u3xje0azoat2'>
            <connection CATALOG='tlb-data-dev' EXECCATALOG='tlb-data-dev' authentication='oauth' class='bigquery' connection-dialect='google-sql' project='tlb-data-dev' schema='data_platform' server-oauth='server-custom' username='aaryaman@talabat.com' workgroup-auth-mode='as-is' />
          </named-connection>
