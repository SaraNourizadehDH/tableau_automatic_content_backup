          <datasource-dependencies datasource='federated.0m5dyi81mlnt2l1ap0p7z0ye0hjp'>
            <column caption='Assortment Parity' datatype='real' default-format='p0.00%' name='[Calculation_3795760477072216071]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([is_item_match_vendor_count]*[Calculation_3795760477102596113]) / SUM([competitor_item_count]*[Calculation_3795760477102596113])' />
            </column>
            <column caption='MIN(1)' datatype='integer' name='[Calculation_3795760477086896136]' role='measure' type='quantitative'>
