      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#f28e2b'>&lt;Sheet Name&gt; </run>
            <run fontalignment='1' fontcolor='#666666'>| Items not on Competitor</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='pluto_mid_nfv_vendor_item_location_assortment_parity_dashboard' name='federated.0m5dyi81mlnt2l1ap0p7z0ye0hjp' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Flat' caption='Weight Parity on' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;flat&quot;'>
              <calculation class='tableau' formula='&quot;flat&quot;' />
              <aliases>
                <alias key='&quot;category&quot;' value='Category Sales' />
                <alias key='&quot;flat&quot;' value='Flat' />
                <alias key='&quot;vendor_city&quot;' value='City Level Sales' />
                <alias key='&quot;vendor_country&quot;' value='Country Level Sales' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0m5dyi81mlnt2l1ap0p7z0ye0hjp'>
            <column caption='# Talabat Vendor Good Gap' datatype='real' name='[# Talabat Vendor Bad Gap (copy)_3795760477111635986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( { FIXED [platform_code_competitor],[platform_code_talabat],[pluto_vendor_location_id_competitor], [pluto_vendor_location_id_talabat]: SUM([is_good_gap_count]) * AVG([Calculation_3795760477102596113]) })' />
            </column>
            <column caption='Good Gap %' datatype='real' default-format='p0.00%' name='[Calculation_3795760477069197315]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([is_good_gap_count] * [Calculation_3795760477102596113]) / SUM([talabat_item_count]*[Calculation_3795760477102596113])' />
            </column>
            <column caption='MIN(1)' datatype='integer' name='[Calculation_3795760477086896136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(1)' />
            </column>
            <column caption='Parameterized Weight' datatype='real' name='[Calculation_3795760477102596113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] == &apos;vendor_city&apos; THEN [vendor_city_weight]&#10;ELSEIF [Parameters].[Parameter 1] == &apos;vendor_country&apos; THEN [vendor_country_weight]&#10;ELSEIF [Parameters].[Parameter 1] == &apos;category&apos; THEN [item_category_level_three_weight]&#10;ELSE 1&#10;END' />
            </column>
            <column caption='(SUM([Talabat Item Count]) - SUM([is_item_match_city_count]) ...' datatype='real' name='[Calculation_3795760477355282474]' role='measure' type='quantitative' user:unnamed='Good Gap %'>
              <calculation class='tableau' formula='(SUM([talabat_item_count]) - SUM([is_item_match_city_count]) ) / COUNTD([pair_id])' />
            </column>
            <column caption='SUM([is_good_gap_count]) / COUNTD([pair_id])' datatype='real' name='[Calculation_3795760477355507756]' role='measure' type='quantitative' user:unnamed='Good Gap %'>
              <calculation class='tableau' formula='SUM([is_good_gap_count]) / COUNTD([pair_id])' />
            </column>
            <column caption='SUM([Talabat Item Count])/ COUNTD([pair_id]) - SUM([is_good_g...' datatype='real' name='[Calculation_3795760477359132722]' role='measure' type='quantitative' user:unnamed='Good Gap %'>
              <calculation class='tableau' formula='SUM([talabat_item_count])/ COUNTD([pair_id]) - SUM([is_good_gap_count])/ COUNTD([pair_id])' />
            </column>
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='integer' name='[is_good_gap_count]' role='measure' type='quantitative' />
