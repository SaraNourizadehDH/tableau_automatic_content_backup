            <run fontalignment='1' fontcolor='#555555'>Items not on Talabat</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='pluto_mid_nfv_vendor_item_location_assortment_parity_dashboard' name='federated.0m5dyi81mlnt2l1ap0p7z0ye0hjp' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Flat' caption='Weight Parity on' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;flat&quot;'>
              <calculation class='tableau' formula='&quot;flat&quot;' />
              <aliases>
                <alias key='&quot;category&quot;' value='Category Sales' />
                <alias key='&quot;flat&quot;' value='Flat' />
                <alias key='&quot;vendor_city&quot;' value='City Level Sales' />
                <alias key='&quot;vendor_country&quot;' value='Country Level Sales' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0m5dyi81mlnt2l1ap0p7z0ye0hjp'>
            <column caption='MIN(1)' datatype='integer' name='[Calculation_3795760477086896136]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(1)' />
            </column>
            <column caption='Parameterized Weight' datatype='real' name='[Calculation_3795760477102596113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1] == &apos;vendor_city&apos; THEN [vendor_city_weight]&#10;ELSEIF [Parameters].[Parameter 1] == &apos;vendor_country&apos; THEN [vendor_country_weight]&#10;ELSEIF [Parameters].[Parameter 1] == &apos;category&apos; THEN [item_category_level_three_weight]&#10;ELSE 1&#10;END' />
            </column>
            <column caption='Vendor Item Gap %' datatype='real' default-format='p0.00%' name='[Calculation_3795760477246939163]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([is_vendor_item_gap_talabat_count] * [Calculation_3795760477102596113]) / SUM([competitor_item_count]*[Calculation_3795760477102596113])' />
            </column>
            <column caption='# Vendor Gap / Unavailable Items' datatype='real' name='[Calculation_3795760477251039262]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [platform_code_competitor], [platform_code_talabat], [pluto_vendor_location_id_talabat], [pluto_vendor_location_id_competitor] : SUM([is_vendor_item_gap_talabat_count]) * AVG([Calculation_3795760477102596113]) }' />
            </column>
            <column caption='SUM([is_item_match_vendor_count]) / COUNTD(pair_id)' datatype='real' name='[Calculation_3795760477354250275]' role='measure' type='quantitative' user:unnamed='Bad Gap %'>
              <calculation class='tableau' formula='SUM([is_item_match_vendor_count]) / COUNTD(pair_id)' />
            </column>
            <column caption='SUM([# Talabat Bad Gaps]) / COUNTD(pair_id)' datatype='real' name='[Calculation_3795760477354348580]' role='measure' type='quantitative' user:unnamed='Bad Gap %'>
              <calculation class='tableau' formula='SUM([is_bad_gap_count]) / COUNTD(pair_id)' />
            </column>
            <column caption='SUM([is_vendor_item_gap_talabat_count]) / COUNTD(pair_id)' datatype='real' name='[Calculation_3795760477354487845]' role='measure' type='quantitative' user:unnamed='Bad Gap %'>
              <calculation class='tableau' formula='SUM([is_vendor_item_gap_talabat_count]) / COUNTD(pair_id)' />
            </column>
            <column caption='Bad Gap % ' datatype='real' default-format='p0.00%' name='[Good Gap % (copy)_3795760477069242372]' role='measure' type='quantitative'>
