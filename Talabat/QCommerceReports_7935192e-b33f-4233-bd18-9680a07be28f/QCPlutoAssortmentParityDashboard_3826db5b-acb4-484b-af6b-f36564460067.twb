            </column>
            <column caption='SUM([is_item_match_vendor_count]) / COUNTD(pair_id)' datatype='real' name='[Calculation_3795760477356322861]' role='measure' type='quantitative' user:unnamed='Assortment Parity %'>
              <calculation class='tableau' formula='SUM([is_item_match_vendor_count]) / COUNTD(pair_id)' />
            </column>
            <column caption='(SUM([Competitor Item Count]) - SUM([is_item_match_vendor_cou...' datatype='real' name='[Calculation_3795760477356843054]' role='measure' type='quantitative' user:unnamed='Assortment Parity %'>
              <calculation class='tableau' formula='(SUM([competitor_item_count]) - SUM([is_item_match_vendor_count]))/COUNTD(pair_id)' />
            </column>
