  <worksheets>
    <worksheet name='Active v/s Available SKUs'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ff6416' fontsize='20'>Active &amp; Available SKUs</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#555555' fontsize='14'>Available SKUs are ready to purchase on the app for customers of Talabat Mart</run>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1c49a7y0bfkt0y1cgmxbz00a57nq' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='9AM Availability' caption='Availability Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;is_available_am&quot;'>
              <calculation class='tableau' formula='&quot;is_available_am&quot;' />
              <aliases>
                <alias key='&quot;is_available_am&quot;' value='9AM Availability' />
                <alias key='&quot;is_available_eod&quot;' value='End of day availability' />
                <alias key='&quot;is_available_pm&quot;' value='3PM Availability' />
              </aliases>
            </column>
            <column caption='Date Aggregation' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c49a7y0bfkt0y1cgmxbz00a57nq'>
            <column caption='SKUs per Warehouse' datatype='real' name='[Calculation_2317242780352823308]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ INCLUDE [warehouse_id]: COUNTD([sku]) })' />
            </column>
            <column caption='[SKUs per Warehouse]/1000' datatype='real' name='[Calculation_2317242780356227086]' role='measure' type='quantitative' user:unnamed='Active v/s Available SKUs (2)'>
              <calculation class='tableau' formula='[Calculation_2317242780352823308]/1000' />
            </column>
            <column caption='[Available SKUs per Warehouse]/1000' datatype='real' name='[Calculation_2317242780356767760]' role='measure' type='quantitative' user:unnamed='Active v/s Available SKUs (2)'>
              <calculation class='tableau' formula='[SKUs per Warehouse (copy)_2317242780356296719]/1000' />
            </column>
            <column caption='Date Select' datatype='datetime' name='[Calculation_34621459044360192]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[stock_date])&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Weekly&apos; THEN  DATETRUNC(&apos;week&apos;,[stock_date])&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Daily&apos;  THEN [stock_date]&#10;&#10;&#10;END' />
            </column>
            <column caption='Available SKUs per Warehouse' datatype='real' name='[SKUs per Warehouse (copy)_2317242780356296719]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ INCLUDE [warehouse_id]: COUNTD(&#10;&#10;CASE [Parameters].[Parameter 3] &#10;WHEN &quot;is_available_am&quot; THEN IF [is_available_am] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_pm&quot; THEN IF [is_available_pm] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_eod&quot; THEN IF [stock_count_day] &gt; 0 THEN [sku] ELSE NULL END&#10;END&#10;&#10;&#10;) })' />
            </column>
