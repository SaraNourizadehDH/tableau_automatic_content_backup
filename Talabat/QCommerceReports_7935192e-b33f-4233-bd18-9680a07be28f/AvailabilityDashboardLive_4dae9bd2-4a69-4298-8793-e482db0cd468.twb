    <worksheet name='Availability Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ff6416' fontsize='20'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#555555' fontsize='16'>% of Active SKUs available for purchase on Talabat Mart</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1c49a7y0bfkt0y1cgmxbz00a57nq' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='9AM Availability' caption='Availability Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;is_available_am&quot;'>
              <calculation class='tableau' formula='&quot;is_available_am&quot;' />
              <aliases>
                <alias key='&quot;is_available_am&quot;' value='9AM Availability' />
                <alias key='&quot;is_available_eod&quot;' value='End of day availability' />
                <alias key='&quot;is_available_pm&quot;' value='3PM Availability' />
              </aliases>
            </column>
            <column caption='Date Aggregation' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c49a7y0bfkt0y1cgmxbz00a57nq'>
            <column aggregation='Avg' caption='Availability %' datatype='integer' default-format='p0.00%' name='[Calculation_2317242780218630144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;is_available_am&quot; THEN [is_available_am]&#10;WHEN &quot;is_available_pm&quot; THEN [is_available_pm]&#10;WHEN &quot;is_available_eod&quot; THEN IF [stock_count_day] &gt; 0 THEN 1 ELSE 0 END&#10;END' />
