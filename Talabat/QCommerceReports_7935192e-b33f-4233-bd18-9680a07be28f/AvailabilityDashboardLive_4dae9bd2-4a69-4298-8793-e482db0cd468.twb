            <column-instance column='[price_tier]' derivation='None' name='[none:price_tier:nk]' pivot='key' type='nominal' />
            <column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' />
            <column-instance column='[stock_date]' derivation='None' name='[none:stock_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[warehouse_name]' derivation='None' name='[none:warehouse_name:nk]' pivot='key' type='nominal' />
            <column caption='Price Tier' datatype='string' name='[price_tier]' role='dimension' type='nominal' />
            <column caption='SKU' datatype='string' name='[sku]' role='dimension' type='nominal' />
            <column caption='Status' datatype='string' name='[status]' role='dimension' type='nominal' />
            <column datatype='integer' name='[stock_count_day]' role='measure' type='quantitative' />
            <column caption='Date' datatype='date' name='[stock_date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_34621459044360192]' derivation='Day-Trunc' name='[tdy:Calculation_34621459044360192:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_2317242780352823308]' derivation='User' name='[usr:Calculation_2317242780352823308:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[warehouse_id]' role='dimension' type='nominal' />
            <column caption='Warehouse Name' datatype='string' name='[warehouse_name]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <slices>
