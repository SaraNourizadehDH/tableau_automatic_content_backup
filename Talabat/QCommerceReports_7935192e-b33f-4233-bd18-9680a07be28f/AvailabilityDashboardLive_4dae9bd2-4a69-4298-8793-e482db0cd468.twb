      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <datasource-dependencies datasource='Parameters'>
        <column alias='9AM Availability' caption='Availability Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;is_available_am&quot;'>
          <calculation class='tableau' formula='&quot;is_available_am&quot;' />
          <aliases>
            <alias key='&quot;is_available_am&quot;' value='9AM Availability' />
            <alias key='&quot;is_available_eod&quot;' value='End of day availability' />
            <alias key='&quot;is_available_pm&quot;' value='3PM Availability' />
          </aliases>
        </column>
        <column caption='Date Aggregation' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
          <calculation class='tableau' formula='&quot;Weekly&quot;' />
        </column>
      </datasource-dependencies>
      <_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
        <objects>
          <object caption='Custom SQL Query' id='_8A16FE97312B497E914A90EB72BC890B'>
            <properties context=''>
              <relation connection='bigquery.0vajo9h0kqv2tk10sx2zi017ypn5' name='Custom SQL Query' type='text'><![CDATA[SELECT 
	avail.warehouse_id,
	avail.warehouse_name,
	avail.supplier_name,
avail.stock_date as transaction_date,
	avail.stock_date,
	avail.stock_count_day,
	avail.product_age_bucket,
	avail.product_name,
	avail.category_english,
	avail.category_parent_english,
	avail.brand_name as brand,
	IF(avail.is_available_am,1,0) as is_available_am,
	IF(avail.is_available_pm,1,0) as is_available_pm,
	avail.is_active,
	avail.percent_hours_available_full_day as availability_perc,
	avail.city,
	avail.country_code,
	CASE WHEN tir.item_role is NULL THEN
		CASE WHEN stock_count_day = 0 THEN 'No stock - Unlisted' ELSE 'Available - Not tagged on sheet' END
	ELSE 
		CASE 
			WHEN lower(tir.item_role) like '%kv%' then 'KVI' 
			WHEN lower(tir.item_role) like '%ma%' then 'Mass'
			WHEN lower(tir.item_role) like '%lo%' then 'Long Tail'
		ELSE
		tir.item_role 
	END 
END as price_tier,



avail.sku,
	case 
		when is_stale_day then false 
		else true end 
	as is_stale_filter,
	status,
	case when IF(avail.is_available_am,1,0) = 1 THEN 'ACTIVE' ELSE status end as new_status,
	--case 
	--	when bs.sku is not null then true else false 
	--end as is_basket_starter,
	--basket_starter_rank,

from `tlb-data-prod.data_platform.agg_grocery_stock_availability` avail

--LEFT JOIN `tlb-data-dev.data_playground_grocery.tmart_item_role` tir
LEFT JOIN `tlb-data-prod.data_platform_google_sheet.tmart_item_role` tir
ON 
	tir.sku = avail.sku
	and tir.country_code = avail.country_code
left join `fulfillment-dwh-production.curated_data_shared_dmart.warehouses` w on w.warehouse_id = avail.warehouse_id


--LEFT JOIN 
--(
--select warehouse_id, skus as sku, basket_starter_rank from `tlb-data-dev.data_playground_grocery.basket_starter` bs
--left join `fulfillment-dwh-production.curated_data_shared_dmart.warehouses` w on w.platform_vendor_id = CAST(bs.vendor_id AS STRING)
--group by 1,2,3

--) bs on bs.warehouse_id = avail.warehouse_id and bs.sku = avail.sku 

where 
	1=1
	AND stock_date >>=  '2023-01-01'
	AND stock_date <<=  CURRENT_DATE()
--	AND avail.country_code = 'AE'
	AND store_type = 'darkstores'
	AND lower(avail.brand_name) <<>> 'comboproduct brand']]></relation>
            </properties>
            <properties context='extract'>
              <relation name='Extract' table='[Extract].[Extract]' type='table' />
            </properties>
          </object>
        </objects>
      </_.fcp.ObjectModelEncapsulateLegacy.true...object-graph>
    </datasource>
