    <worksheet name='Active v/s Available SKUs (OLD)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#898989' fontsize='20'>SKUs Active</run>
            <run bold='true' fontcolor='#555555' fontsize='20'>Æ </run>
            <run bold='true' fontcolor='#555555' fontsize='14'>&amp;</run>
            <run bold='true' fontcolor='#555555' fontsize='20'>Æ </run>
            <run bold='true' fontcolor='#ff6416' fontsize='20'>SKUs Available </run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#555555' fontsize='14'>Available SKUs are ready to purchase on the app for customers of Talabat Mart</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1c49a7y0bfkt0y1cgmxbz00a57nq' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='9AM Availability' caption='Availability Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;is_available_am&quot;'>
              <calculation class='tableau' formula='&quot;is_available_am&quot;' />
              <aliases>
                <alias key='&quot;is_available_am&quot;' value='9AM Availability' />
                <alias key='&quot;is_available_eod&quot;' value='End of day availability' />
                <alias key='&quot;is_available_pm&quot;' value='3PM Availability' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c49a7y0bfkt0y1cgmxbz00a57nq'>
            <column aggregation='CountD' caption='Available SKUs' datatype='string' default-role='measure' default-type='quantitative' name='[Availability % (copy)_2317242780222713859]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;is_available_am&quot; THEN IF [is_available_am] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_pm&quot; THEN IF [is_available_pm] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_eod&quot; THEN IF [stock_count_day] &gt; 0 THEN [sku] ELSE NULL END&#10;END' />
            </column>
            <column caption='Active SKUs' datatype='integer' name='[Calculation_2317242780222386177]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([sku])' />
            </column>
            <column caption='[Active SKUs]/1000' datatype='real' name='[Calculation_2317242780348035078]' role='measure' type='quantitative' user:unnamed='Active v/s Available SKUs'>
