      <column aggregation='CountD' caption='Available SKUs' datatype='string' default-role='measure' default-type='quantitative' name='[Availability % (copy)_2317242780222713859]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;is_available_am&quot; THEN IF [is_available_am] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_pm&quot; THEN IF [is_available_pm] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_eod&quot; THEN IF [stock_count_day] &gt; 0 THEN [sku] ELSE NULL END&#10;END' />
      </column>
      <column aggregation='CountD' caption='Available SKUs (copy)' datatype='string' default-role='measure' default-type='quantitative' name='[Available SKUs (copy)_2317242780231315461]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;is_available_am&quot; THEN IF [is_available_am] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_pm&quot; THEN IF [is_available_pm] = 1 THEN [sku] ELSE NULL END&#10;WHEN &quot;is_available_eod&quot; THEN IF [stock_count_day] &gt; 0 THEN [sku] ELSE NULL END&#10;END' />
      </column>
      <column aggregation='Avg' caption='Availability %' datatype='integer' default-format='p0.00%' name='[Calculation_2317242780218630144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;is_available_am&quot; THEN [is_available_am]&#10;WHEN &quot;is_available_pm&quot; THEN [is_available_pm]&#10;WHEN &quot;is_available_eod&quot; THEN IF [stock_count_day] &gt; 0 THEN 1 ELSE 0 END&#10;END' />
      </column>
      <column caption='Active SKUs' datatype='integer' name='[Calculation_2317242780222386177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([sku])' />
      </column>
      <column caption='SKUs per Warehouse' datatype='real' name='[Calculation_2317242780352823308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG({ INCLUDE [warehouse_id]: COUNTD([sku]) })' />
