    <worksheet name='Availability by Warehouse'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ff6416' fontsize='20'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#555555' fontsize='16'>% of active SKUs available for customers to shop by store &amp; week</run>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Custom SQL Query (data_platform)' name='federated.1c49a7y0bfkt0y1cgmxbz00a57nq' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='9AM Availability' caption='Availability Type' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;is_available_am&quot;'>
              <calculation class='tableau' formula='&quot;is_available_am&quot;' />
              <aliases>
                <alias key='&quot;is_available_am&quot;' value='9AM Availability' />
                <alias key='&quot;is_available_eod&quot;' value='End of day availability' />
                <alias key='&quot;is_available_pm&quot;' value='3PM Availability' />
              </aliases>
            </column>
            <column caption='Date Aggregation' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Weekly&quot;'>
              <calculation class='tableau' formula='&quot;Weekly&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c49a7y0bfkt0y1cgmxbz00a57nq'>
            <column aggregation='Avg' caption='Availability %' datatype='integer' default-format='p0.00%' name='[Calculation_2317242780218630144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 3] &#10;WHEN &quot;is_available_am&quot; THEN [is_available_am]&#10;WHEN &quot;is_available_pm&quot; THEN [is_available_pm]&#10;WHEN &quot;is_available_eod&quot; THEN IF [stock_count_day] &gt; 0 THEN 1 ELSE 0 END&#10;END' />
            </column>
            <column caption='SKUs per Warehouse' datatype='real' name='[Calculation_2317242780352823308]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ INCLUDE [warehouse_id]: COUNTD([sku]) })' />
            </column>
            <column caption='Date Select' datatype='datetime' name='[Calculation_34621459044360192]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &apos;Monthly&apos; THEN DATETRUNC(&apos;month&apos;,[stock_date])&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Weekly&apos; THEN  DATETRUNC(&apos;week&apos;,[stock_date])&#10;&#10;ELSEIF [Parameters].[Parameter 4] = &apos;Daily&apos;  THEN [stock_date]&#10;&#10;&#10;END' />
            </column>
            <column aggregation='Avg' datatype='real' name='[availability_perc]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2317242780218630144]' derivation='Avg' name='[avg:Calculation_2317242780218630144:qk]' pivot='key' type='quantitative' />
            <column-instance column='[availability_perc]' derivation='Avg' name='[avg:availability_perc:qk]' pivot='key' type='quantitative' />
            <column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' />
            <column caption='Sub-category' datatype='string' name='[category_english]' role='dimension' type='nominal' />
            <column caption='Category' datatype='string' name='[category_parent_english]' role='dimension' type='nominal' />
            <column caption='Country Code' datatype='string' name='[country_code]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column-instance column='[warehouse_name]' derivation='CountD' name='[ctd:warehouse_name:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[is_available_am]' role='measure' type='quantitative' />
            <column datatype='integer' name='[is_available_pm]' role='measure' type='quantitative' />
            <column caption='Is Stale SKU?' datatype='boolean' name='[is_stale_filter]' role='dimension' type='nominal' />
            <column-instance column='[brand]' derivation='None' name='[none:brand:nk]' pivot='key' type='nominal' />
            <column-instance column='[category_english]' derivation='None' name='[none:category_english:nk]' pivot='key' type='nominal' />
